inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

void create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer schmutzigen, eiskalten Hoehle" );
   SetProp(P_INT_LONG,  "Du stehst in einer kleinen Erdhoehle. Die Luft ist klirrend kalt "+
         "und ein Geruch von Erde steht im Raum. Der Boden und die Waende sind uneben und "+
         "ziemlich rauh. Kleine Haufen von Eis, Schutt und manchmal Schnee sammeln sich "+
         "in den Ecken des Raumes an. Der Tunnel verlaeuft in den Osten und Sueden.");
   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -3]));

   AddSmell(DEFAULT_SMELL,
    "Es riecht nach Erde.");
   AddSmell("erde",
    "Riecht ziemlich erdig.");
   
   AddDetail(({"erdhoehle","hoehle"}),
    "In der Hoehle ist kaum Schnee zu finden, dennoch ist es furchtbar kalt.");
   AddDetail("luft",
    "Du untersuchst Die Luft, findest aber nichts.");
   AddDetail("erde",
    "Du weisst nicht wo Du anfangen sollst, es ist einfach zu viel davon da.");
   AddDetail(({"boden","wand","waende"}),
    "Ziemlich uneben und rauh. Muss mit einem stumpfen Werkzeug gegraben "+
    "worden sein.");
   AddDetail("haufen",
    "Eis, Schutt und Schnee...");
   AddDetail("eis",
    "Ziemlich durchsichtig das Eis heute.");
   AddDetail("schutt",
    "Nichts Besonderes an dem Schutt zu finden.");
   AddDetail("besonderes",
    "Eben nichts Besonderes!");
   AddDetail("schnee",
    "Der Schnee ist heute wieder besonders warm.");
   AddDetail(({"eck","ecken"}),
    "Schutt, Schnee und Eis liegen in den Ecken herum.");
   AddDetail(({"raum","raeume"}),
    "Klirrend kalt hier.");
   AddDetail("tunnel",
    "Der Tunnel fuehrt in den Osten und den Sueden.");
   AddDetail("werkzeug",
    "Ja, sicher, aber es is keins da! ");
   AddDetail("decke",
    "Du findest nichts besonderes an einer einfachen Decke.");
   
   AddExit( "osten", "./19622" );
   AddExit( "sueden", "./19620" );


}
