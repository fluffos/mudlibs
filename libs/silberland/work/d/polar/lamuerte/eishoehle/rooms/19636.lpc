inherit "std/room";
#include <properties.h>
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer eisigen Hoehle" );
   SetProp(P_INT_LONG,  "Ein Geraeusch als ob sich jemand durch den Schnee schleppt "+
         "ist hier aus einiger Entfernung zu hoeren. Ausserdem hoerst Du auch noch "
         "ein leises Geheule und andere fuerchterliche Toene, aber das schleppende "+
         "Geraeusch kann man am deutlichsten hoeren. Ein angsteinfloessender Raum. "+
         "Hau besser schnell wieder ab von hier. Die Hoehle setzt sich im "+
         "Osten und Sueden fort.");
   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -13]));
   
   AddSound(DEFAULT_SOUND,
    "Du kannst nicht genau sagen was das ist. Es hoert sich nach einem "+
    "schleifenden Geraeusch an.");
   AddSound(({"schleif","schleifen"}),
    "Knirsch, schleif, knirsch.");
   AddSound(({"heulen","geheule"}),
    "Du hoerst ein leises Jauuuuuuuuuuuuuuuuuuuuuul!");
   AddSound("toene",
    "Sie sind unbeschreiblich, hau besser schnell ab.");
   AddSound("geraeusch",
    "Schleif, knirsch, schleif, knirsch ....");
   AddSound(({"knirsch","knirschen"}),
    "Du hoerst ein leises Knirrrrrrrrrrrrrsch.");
   AddDetail("schnee",
    "Brrrr.. ist der kalt.");
   AddDetail(({"raum","hoehle"}),
    "Ausser Eis ist hier nicht viel zu sehen. Die Geraeusche machen Dich "+
    "noch wahnsinnig.");
   AddDetail("eis",
    "Brrr.. Ist das kalt.");
   AddDetail("boden",
    "Der Boden ist voller Eis.");
   AddDetail(({"wand","waende"}), 
    "Die Waende bestehen aus reinstem Eis.");
   AddDetail("decke",
    "Die Decke ist zu dunkel um etwas genaueres zu entdecken.");
    
   AddExit( "osten", "./19637" );
   AddExit( "sueden", "./19633" );


}
