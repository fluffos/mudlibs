   
inherit "std/room";

#include <properties.h> 
#include <language.h> 
#include "files.h"

void lfunv();

create(){
   ::create();

    

   SetProp(P_INT_SHORT,  "In einer kleinen Erdhoehle" );
   SetProp(P_INT_LONG,  "Du befindest Dich in einer kleinen Hoehle im Inneren eines Berges, "+
         "weit entfernt von jeglicher Zivilisation. Du kannst von Innen heraus eine Stimme hoeren. "+
         "Ein kleiner Pfad fuehrt in suedlicher Richtung weg von der Hoehle. " );
   AddSound(DEFAULT_SOUND,
    "Du hoerst eine fuerchterliche Stimme.\n");
   AddSound(({"stimme","stimmen"}),
    "Du bekommst eine Gaensehaut beim genaueren Hinhoeren.\n");
   AddDetail("hoehle",
    "Dich umgeben Tonnen von Erde und Gestein.");
   AddDetail("eingang",
    "Der Eingang ist in die Erde gegraben.");
   AddSpecialDetail("licht",
    "lfunc");
   AddDetail("erde",
    "Die Erde fuehlt sich feucht und kalt an.");
   AddDetail("gestein",
    "Hmm.. Ziemlich hart.");
   AddDetail("berg",
    "Du stehst im Berg.");
   AddDetail("zivilisation",
    "Pfoa, kein normaler Mensch zu sehen. Weit und breit nicht.");
   AddDetail("mensch",
    "Hmm.. Keiner da, oder doch?");
   AddDetail("pfad",
    "Der Pfad ist ziemlich dreckig.");
   AddDetail("boden",
    "Ziemlich erdig, der Boden.");
   AddDetail("decke",
    "Das Licht reicht nicht aus um genaueres von der Decke zu erkennen.");
   AddDetail(({"wand","waende"}),
    "Besteht wohl auch aus Erde. Fuehlt sich zumindest so an.");
   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,1);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 2]));
   

   AddExit( "norden", "./19601" );
   AddExit( "sueden", "/d/polar/lamuerte/dorf/rooms/festland_3" );
  

}


lfunc()
{ //printf("%O\n",this_player());
  this_player()->SetProp(P_BLIND,
   ([BLIND_MSG:"Das Licht Deiner Fackel hat Dich geblendet. Du kannst nichts sehen.\n",
BLIND_TIME:30,
BLIND_END_MSG: "Der Schmerz in Deinen Augen laesst nach.\n"
       "Dustyseidank, Du kannst wieder sehen.\n"]) );
  return("Autsch, das Licht reicht jedoch sehr wohl aus um Dich zu blenden.\n");
}

