
/*
**    move kann "./<raumname>" nicht als Blueprint interpretieren
**    daher geaendert.
**    08.11.2018 -> Eros
*/

inherit "std/room";

#include <properties.h> 
#include <language.h> 
#include "files.h"
#include <moving.h>

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer eisigen Hoehle" );
   SetProp(P_INT_LONG,  "Viel Schnee und Eis hat sich in diesem Tunnel und in dem von hier aus "+
         "Noerdlichen angesammelt. Auf den Waenden bilden sich grosse Eisflaechen und so manche "+
         "Eiszapfen haengen von der Decke. Die Luft ist kalt und feucht, Es sieht so aus als wuerde "+
         "es in Norden noch um einiges kuehler sein. Im Norden und Sueden "+
         "gehts weiter." );
   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -5]));

   AddItem(NPC("snowman.lpc"), REFRESH_DESTRUCT);   
   
   AddDetail("lawine",
    "Keine zu sehen. Sei froh!");
   AddDetail("schnee",
    "Der Schnee ist hier etwas schmutziger als anderswo. Irgendwie sieht "+
    "er nicht sehr fest aus. Besser Du schreist hier drinnen nicht herum, "+
    "sonst loest Du noch eine Lawine aus.");
   AddDetail("eis",
    "Das Eis ist steinhart gefroren. Wahrscheinlich durch die grosse Kaelte.");
   AddDetail("kaelte",
    "Brrrrrrrrrrr... Kaaaaalllttt!");
   AddDetail(({"hoehle","tunnel"}),
    "Es gibt zwei Wege durch die Du von hier wegkommst. Norden und Sueden.");
   AddDetail(({"weg","wege"}),
    "Welchen Du wohl nehmen sollst?!");
   AddDetail("eisflaechen",
    "Du erkennst Dein Spiegelbild in einer der glatten Eisflaechen.");
   AddDetail(({"bild","spiegelbild"}),
    "Tjo, schaust nicht mehr ganz taufrisch aus heute.");
   AddDetail("schmutz",
    "Naja, es ist nicht uebermaessig schmutzig.");
   AddDetail("decke",
    "Einige Eiszapfen haengen von der Decke herunter.");
   AddDetail(({"zapfen","eiszapfen"}),
    "Sie sind lang, kalt und aus Eis.");  
   AddDetail("luft",
    "Du schaust in die Luft. Du siehst sie zwar nicht, aber fuehlst, dass "+
    "sie eiskalt ist.");
   AddDetail(({"wand","waende"}),
    "Du findest nichts ausser Eis an den Waenden.");
   AddDetail("boden",
    "Der Boden ist zugefroren.");
    
   AddExit( "norden", "./19627" );
   AddExit( "sueden", "./19625" );

   AddCmd(({"schrei","schreie"}),"sfunc");
}

sfunc()
{
  if (find_call_out("lawine")==-1)
    call_out("lawine",10);
  return 0;
}

lawine()
 {object *people;
 int i;

  people=filter_array(all_inventory(this_object()), #'interactive );

 for(i=sizeof(people)-1;i>=0;i--)
  { if (present(people[i]))
    {tell_object(people[i],"Ahhhhhhhhhhh! Eine kleine Lawine reisst Dich mit.");
     people[i]->move(ROOM("19612"), M_GO, "runter", "faellt hinunter", "faellt herein");
     people[i]->reduce_hit_point(20);
    }
   }

 }

