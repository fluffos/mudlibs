inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer eisig kalten Hoehle" );
   SetProp(P_INT_LONG,  "Der Tunnel endet hier in einem Raum in welchem viele "+
         "Eisbrocken herumliegen. Die Decke hier drinnen ist niedrig und mit "+
         "scharf aussehenden Eiszapfen uebersaeht. Die Luft ist kuehl und feucht. "+
         "Du findest wirklich nichts interessant an diesem Raum. Der einzige Ausgang "+
         "fuehrt nach Sueden." );
   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -8]));

   AddItem( NPC("bear_polar"), REFRESH_REMOVE );
   
   AddDetail("raum",
    "Der Raum ist mit vielen Eiszapfen gespickt.");
   AddDetail(({"eiszapfen","zapfen"}),
    "Es haengen verdammt viele herum. Doch was ist das? Einer scheint aus "+
    "Stein zu sein.");
   AddDetail("stein",
    "Tatsaechlich, es ist ein Steinzapfen!?");
   AddDetail("steinzapfen",
    "Hmm.. Sieht aus wie ein Eiszapfen, nur, dass er nicht aus Eis ist, sondern "+
    "aus Stein.");
   AddDetail("decke",
    "Die Decke ist voller Eiszapfen.");
   AddDetail("luft",
    "Eisig kalt die Luft hier drinnen.");
   AddDetail("ausgang",
    "Der Ausgang befindet sich im Sueden.");
   AddDetail(({"wand","waende"}),
    "Selbst die Waende bestehen aus Eis.");
   AddDetail("boden",
    "Da liegt ein Nichts auf dem Boden.");
   AddDetail("nichts",
    "Och, das arme Nichts ist erfroren.");
   AddDetail("tunnel",
    "Man kann diesen Raum hier durch einen Tunnel nach Sueden verlassen.");
   AddDetail(({"eis","eisbrocken"}),
    "Die Eisbrocken sind ziemlich gross. Sie bestehen aus Eis. Ohne Schmaeh!");
   AddDetail("schmaeh",
    "Was? Du weisst nicht was ein Schmaeh ist?! Frag doch Woody.");
              
 
   AddExit( "sueden", "./19627" );

   AddItem( "/d/gebirge/feyaria/drachen/obj/statue", REFRESH_REMOVE);
}
