inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer eisigen Hoehle" );
   SetProp(P_INT_LONG,  "Eine kleine Hoehle tief im Inneren des Berges. "+
         "Die Waende sind rauh und uneben. Eisplatten ueberziehen den Boden "+
         "und die Waende. Die Eisplatten sind mit lauter kleinen Eiskristallen "+
         "ueberzogen. Aus einiger Entfernung hoerst Du ein merkwuerdiges "+
         "Geraeusch. Die Hoehle setzt sich im Osten, Sueden und Westen weiter "+
         "fort.");

   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -5]));

   AddItem( NPC("bear_polar"), REFRESH_REMOVE );
   
   AddSound(DEFAULT_SOUND,
    "Du horst ein merkwuerdiges Knirschratterplumps Geraeusch.");
   AddSound("geraeusch",
    "Knirschratterplumps! Knirschratterplumps! Knirschratterplumps!");
   
   AddDetail(({"wand","waende"}),
    "Das Eis, welches die Waende ueberzieht, macht sie sehr glatt, obwohl "+
    "man die rauhe und unebene Struktur der eigentlichen Wand durch das Eis "+
    "gut erkennen kann.");
   AddDetail("eis",
    "Brrr.. ist das Eis kalt.");
   AddDetail("struktur",
    "Ziemlich uneben die Struktur.");
   AddDetail(({"eisplatten","platten"}),
    "Sie sind mit kleinen Kristallen besetzt, aber man kann trotzdem hindurchsehen.");
   AddDetail("kristalle",
    "Sie funkeln froehlich. *grins*");
   AddDetail("hoehle",
    "Es ist eisig kalt hier drinnen.");
   AddDetail("berg",
    "Du stehst in einer Hoehle des Berges.");
   AddDetail("boden",
    "Der Boden ist mit Eisplatten ueberzogen. Pass auf, sonst faellst Du.");
   AddDetail("decke",
    "Ein riesiger Eiszapfen haengt von der Decke herunter.");
   AddDetail("eiszapfen",
    "Das ist der groesste Eiszapfen den Du je gesehen hast.");
   AddDetail("entfernung",
    "Hmm? Keine Entfernung da? Hmm...");
   AddDetail("inneres",
    "Da gibts nix zum schaun.");
     
 
   AddExit( "osten", "./19620" );
   AddExit( "sueden", "./19615" );
   AddExit( "westen", "./19613" );

}
