inherit "std/room";
#include <properties.h> 
#include <language.h>
#include <moving.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer kalten Hoehle" );
   SetProp(P_INT_LONG,  "Du betrittst einen kleinen Raum welcher nur aus Eis und Schnee besteht. "+
         "Alles sieht hier ganz normal aus, doch irgendwie fuehlt es sich so an als "+
         "wuerde der schneebedeckte Boden nachgeben. Der einzig sichtbare Ausgang fuehrt "+
         "nach Westen." );
   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -7]));

   AddCmd(({"unt","untersuche","schau","schaue"}),"sfunc");
   
   AddExit( "westen", "./19627" );

}

sfunc()
 {write("Dafuer ist HIER wirklich keine Zeit!\n");
  return 1;
 }

init()
{::init();
 if ( find_call_out( "plumps" ) != -1 ) return ( 1 );
 call_out("plumps",5);
}

plumps()
{object *people;
 int i;

  people=filter_array(all_inventory(this_object()), #'interactive );
 
 for(i=sizeof(people)-1;i>=0;i--)
  { if (present(people[i]))
    {tell_object(people[i],"Ahhhhhhhhhhh! Eine kleine Lawine reisst Dich mit. Du faellst nach unten!\n");
     people[i]->move(ROOM("19630.lpc"), M_GO, "runter", "faellt hinunter", "faellt herein");
    }
   }
 
 }
