inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer schmutzigen, eiskalten Hoehle" );
   SetProp(P_INT_LONG,  "Du wanderst in diese eisig kalte, schmutzige Hoehle herein. "+
         "Die erdigen Waende der Hoehle sind tiefgefroren und teilweise mit duennen "+
         "Schichten aus Eis ueberzogen. Ueber Dir bilden sich viele kleine Kristalle "+
         "zu einer eiszapfenartigen Form. Diese Hoehle setzt sich im Norden und "+
         "Osten fort." );
   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -5]));

   AddItem( NPC("sloth_ice"), REFRESH_REMOVE );
   AddItem(NPC("snowman.lpc"), REFRESH_DESTRUCT);   
   AddDetail("hoehle",
    "Es ist nicht besonders gemuetlich hier drinnen. Vor allem die Kaelte "+
    "macht Dir zu schaffen.");
   AddDetail("kaelte",
    "Sehen kannst Du sie nicht, aber dafuer spuerst Du sie umso mehr.");
   AddDetail(({"wand","waende"}),
    "Durch eine duenne Eisschicht sind die Waende zu sehen. Scheint alles "+
    "tiefgefroren zu sein hier.");
   AddDetail(({"eis","eisschicht","schichten","schicht"}),
    "Durchsichtig und furchtbar kalt.");
   AddDetail(({"kristall","kristalle","eiskristalle","eiskristall"}),
    "Die Kristalle sind sternfoermig.");
   AddDetail("form",
    "Du meinst den Riesendoppeleiskristallzapfen? Ja, der haengt ueber Dir.");
   AddDetail("riesendoppeleiskristallzapfen",
    "Ein gewaltiger Koloss, geformt aus lauter kleinen Eiskristallen.");
   AddDetail("koloss",
    "Der Riesendoppeleiskristallzapfen ist wirklich ueberdimensional gross.");
   AddDetail("boden",
    "Der Boden ist steinhart gefroren.");
   AddDetail("decke",
    "Du siehst einen Riesendoppeleiskristallzapfen.");
    
   AddExit( "norden", "./19623" );
   AddExit( "osten", "./19625" );

  
}
