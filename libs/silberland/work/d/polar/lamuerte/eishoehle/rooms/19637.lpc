inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer eisigen Hoehle" );
   SetProp(P_INT_LONG,  "Ein Tunnel endet hier in einem kleinen Raum. Schnee und Eis "+
         "hat sich am Boden angesammelt. Der Schnee ist weich und flaumig und ein kurzer "+
         "Geschmackstest beweist Dir, dass der Schnee makellos rein ist. Es befinden sich "+
         "einige wenige Fussspuren auf dem Boden, so wenige, dass es Dich vermuten "+
         "laesst, als ob nicht unbedingt viele Kreaturen hier herkommen.");
         //scheiss beschreibung wah.. owa wos sois...
        //so is wenigstns a bissl bessa.. Muahhaha
     
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -4]));

   AddItem(NPC("snowman.lpc"), REFRESH_DESTRUCT);
   
   AddDetail( "tunnel",
    "Man gelangt durch einen Tunnel nach Westen.");
   AddDetail( "raum",
    "Der Raum ist nicht besonders gross. Beeindruckend ist aber der reine Schnee.");
   AddDetail("schnee",
    "Wie Dein Geschmackstest schon bewiesen hat, er ist ziemlich rein.");
   AddDetail(({"test","geschmackstest"}),
    "Du hast aber eine wirklich feinfuehlige Zunge heute.");
   AddDetail("schnee",
    "Der Schnee ist wunderbar weich hier.");
   AddDetail("eis",
    "Das Eis ist ziemlich hart und kalt.");
   AddDetail(({"spur","spuren","fussspuren"}),
    "Es sind wirklich nur sehr wenige. Scheint wohl nie wer hier zu sein. "+
    "Naja, wenigstens sind Deine auch dabei.");
   AddDetail(({"kreatur","kreaturen"}),
    "Na hoffentlich begegnet Dir keine.");
   AddDetail("boden",
    "Er ist voller Schnee und Eis. Eine festgefrorene Muenze liegt auch "+
    "hier herum. Sind hier etwa Fussspuren zu sehen?");
   AddDetail("muenze",
    "Probier erst gar nicht sie zu nehmen, denn sie ist viel zu fest "+
     "angefroren.");
   AddDetail(({"wand","waende"}),
    "Wie soll es anders sein, die Wand besteht aus purem Eis.");
   AddDetail("decke",
    "Du siehst ein Unmenge von Eiszapfen von der Decke haengen.");
   AddDetail(({"zapfen","eiszapfen"}),
    "Es muessen ueber hundert Zapfen sein.");
    
   
   AddExit( "westen", "./19636" );



}
