inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h> 
#include "files.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();       
  SetProp(P_SHORT, "Ein Eisbaer");
  SetProp(P_LONG, "Ein prachtvoller weisser Eisbaer. Er ist immer hungrig "+
  "und freut sich schon darauf Dich verspeisen zu koennen. Sein dickes, weisses "+
  "Fell schuetzt ihn vor jeglicher Kaelte.");
  SetProp(P_NAME, "Eisbaer");
  SetProp(P_GENDER, MALE);
  AddId(({"enpc", "eisbaer", "baer"}));
  create_default_npc(22);
  SetProp(P_ALIGN, -300);
  SetProp(P_HANDS, ({" mit seinen Pranken", 550, ({DT_RIP}) })); 
  SetProp(P_SIZE, 200);
  SetProp(P_RACE, "Baer");
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_COLD:-1, DT_FIRE:0.1, DT_POISON:0.1]) );
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-55,T_RANGE_MAX:20]) );  

  seteuid(getuid(this_object()));
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Eisbaer will @WEN eigentlich gar nicht.\n" }) );

  SetProp(P_DEFAULT_INFO, "brummt Dich laut und boese an.\n");

}
