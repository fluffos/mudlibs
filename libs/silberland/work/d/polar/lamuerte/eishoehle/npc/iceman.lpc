inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <new_skills.h>
#include "files.h"

object key;

create()
{
  if (!is_clone(this_object())) return;
  ::create();       
  SetProp(P_SHORT, "Ein Eismann");
  SetProp(P_LONG, 
  "Ein grosses Wesen, welches Dich teilweise an eine maennliche, menschliche "+
  "Gestalt erinnert. Doch es ist nicht zu uebersehen, dass dieses Wesen nicht "+
  "aus Fleisch und Blut besteht, sondern aus purem, hartem Eis.");
  SetProp(P_NAME, "Eismann");
  SetProp(P_GENDER, MALE);
  AddId(({"enpc","mann","eismann"}));
  create_default_npc(30);
  SetProp(P_ATTRIBUTES,(["int":25,"str":30,"con":25,"dex":25]));
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS,({" mit seinen eisigen Haenden",600, ({DT_COLD, DT_BLUDGEON}) }));
  SetProp(P_RACE, "Troll");
  SetProp(P_SIZE, 200+random(100) );
  SetProp(P_KILL_NAME, "Ein eisiges Ungetuem");
  SetProp(P_KILL_MSG, "hat seine Macht gezeigt.");
  SetProp (P_RESISTANCE_STRENGTHS, ([ DT_MAGIC:0.5, DT_FIRE:0.5, DT_COLD:-1]) );
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:0]) );
  SetProp(P_SPELLRATE,50);
  SetProp(P_MATERIAL, MAT_ICE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-55,T_RANGE_MAX:20]) );  

  // Ruestung
 
  seteuid(getuid(this_object()));

  if( random(3) )
    GIMME("eisstiefel");
  if( random(3) )
    GIMME("eisschienen");
  if( random(3) )
    GIMME("eishose");

  command("trage alles");

  GIMME("eislanze");
  command ("zuecke lanze");

  SetProp( P_REJECT,
    ({ REJECT_KEEP, "Der Eismann nimmt @WEN an sich.\n" }) );

  AddSpell(1,200+random(800),
    " Der Eismann haucht Dich mit seinem gefrorenen Atem an.\n",
    " Der Eismann gefriert @WEN ein.\n",
    DT_COLD, ([SP_SHOW_DAMAGE:1]) );

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file("/d/polar/lamuerte/eishoehle/log/eismann.log",ctime()+
             ": Der Eismann hat gerade "+
             player->QueryProp(P_NAME)+
             " umgebracht.\n");
}

