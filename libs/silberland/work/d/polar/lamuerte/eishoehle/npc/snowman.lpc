inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <mnpc.h>
#include "files.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();       /* WICHTIG!!! */
  SetProp(P_SHORT, "Ein Schneemann");
  SetProp(P_LONG, 
   "Ein halbwegs grosser Schneemann. Er besteht aus einer grossen und einer "
   "etwas kleineren Schneekugel. In der Mitte der kleinen Schneekugel steckt "
   "eine Karotte. Schraeg links und rechts davon stecken zwei Kohlestueckchen.");
  SetProp(P_NAME, "Schneemann");
  SetProp(P_GENDER, MALE);
  AddId(({"enpc","schneemann","mann"}));
  create_default_npc(random(8)+11);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit einem Schneeball",400, ({DT_BLUDGEON, DT_COLD}) })); 
  SetProp(P_SIZE, 165);
  SetProp(P_RACE, "Elementar");
  SetProp(P_MATERIAL, MAT_ICE);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_COLD:-1, DT_FIRE:0.3, DT_POISON:0.2]) );
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-55,T_RANGE_MAX:20]) );  

   SetProp( P_REJECT, REJECT_KEEP);

   SetProp (P_MNPC_AREA, ROOM(""));
   SetProp (P_MNPC_WAIT, ({30, 40, 60}));
   SetProp (P_MNPC_DEFAULTROOM, ROOM("19601.lpc"));
   SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);
   
}

