inherit "/p/std/dragons/dragon";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <moredef.h>
#include <defines.h>
#include <wizlevels.h>
create()
{
  int x,y;
  object ob;
  if (!is_clone(this_object())) return;
  ::create();    
  SetProp(P_NAME, "Glacimurofrostulzilaxxas");
  create_default_dragon(2,11,0,20+random(20));
  SetProp(P_SHORT, "Ein steinalter weiser weisser Drache names Glacimurofrostulzilaxxas");
  SetProp(P_ARTICLE, 0); 
  SetProp(P_AGGRESSIVE,1); 
  SetProp(P_KILL_NAME, "Glacimurofrostulzilaxxas der Eisdrache");
  AddId(({"eisdrache", "glacimurofrostulzilaxxas"}));
  set_living_name("eisdrache");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-55,T_RANGE_MAX:20]) );  

  seteuid(getuid(this_object()));
  
  if(objectp(ob=find_object(ITEMD)->GenerateUnique(
          "/d/ebene/lamuerte/turm/obj/golemlanze",1)))
  {
    ob->move(TO, M_NOCHECK);
  }
  else switch (random(3))
  {
    case 0: 
      CLONEME("/d/polar/lamuerte/eishoehle/obj/kreth"); 
      break;
    case 1: 
      CLONEME( "/d/ebene/lamuerte/turm/obj/golemspalter"); 
      break;
    case 2: 
      ob = clone_object("/gilden/druidenzirkel/obj/focus");
      ob->SetVariables("eis", 2+random(2)+random(2));
      ob->move(TO, M_NOCHECK);
      break;
  }
  for(x=0;x<=(5+random(3));x++) 
  {
    CLONEME( "/d/unterwelt/ronja/sternenwald/weapon/edorn");
  }
}


void die(int poisondeath)
{
  write_file("/d/polar/lamuerte/eishoehle/log/eisdrache",
    ctime()+": "+CAP(getuid(TP))+" killt den Eisdrachen.\n");
  if ( objectp(QueryProp(P_KILLER)) )
  {
    if ( present("\nzechpreller_quest_11", QueryProp(P_KILLER)) )
      present("\nzechpreller_quest_11", QueryProp(P_KILLER)) -> Mark();
  }
  if( !IS_LEARNER(TP) )
    domainshout(CAP(TP->query_real_name())+
        " hat den Eisdrachen bezwungen.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file("/d/polar/lamuerte/eishoehle/log/eisdrache",
  ctime()+": Der Eisdrache hat gerade "+CAP(getuid(player))+" umgebracht.\n");
  ::NotifyPlayerDeath(player, killer, lostexp);
}
