inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h> 
#include <moving.h> 
#include <new_skills.h>
#include "files.h"

create()
{ 
  int x;

  if (!is_clone(this_object())) return;
  ::create();       
  SetProp(P_SHORT, "Ein Eisriese");
  SetProp(P_LONG, "Ein ueberdimensional grosses Gebilde aus Schnee und Eis "+
  "steht vor Dir. Du spuehrst dass von diesem Monstrum eine gewaltige Kaelte "+
  "ausgeht. Er scheint im wahrsten Sinne des Wortes ein harter Brocken zu sein.");
  
  SetProp(P_NAME, "Eisriese");
  SetProp(P_GENDER, MALE);
  AddId(({"enpc","riese","eisriese"}));
  create_default_npc(28);
  SetProp(P_ATTRIBUTES,(["int":20,"str":20,"con":25,"dex":30]));
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS,({" mit seinen eisigen Haenden", 300, ({DT_COLD, DT_RIP}) }));
  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 270+random(20) );
  SetProp(P_KILL_NAME, "Ein Eisriese");
  SetProp(P_KILL_MSG, "hat seine Macht bewiesen.");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:0]) );
  SetProp(P_SPELLRATE,50);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_COLD:-1, DT_FIRE:0.2, DT_POISON:0.2]) );
  SetProp(P_MATERIAL, MAT_ICE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-55,T_RANGE_MAX:20]) );  

  seteuid(getuid(this_object()));

  SetProp(P_REJECT,
    ({ REJECT_KEEP, "Der Riese nimmt @WEN an.\n" }) );

  AddSpell(1,500+random(500),
    "  Der Eisriese wirft einen Eisbrocken nach Dir.\n",
    "  Der Eisriese wirft @WEN einen Eisbrocken nach.\n",
    DT_SLASH, ([SP_SHOW_DAMAGE:1]) );

   "obj/gemmaster"->DistributeGem(2,6,1,1,({"diamant","rubin","saphir", "smaragd", 
         "okatarin", "zirkon", "aquamarin", "opal", "jadeit", "amethyst", 
         "tigerauge", "opal", "topas", "granat", "onyx", "bernstein", 
         "lapislazuli", "turmalin", "bergkristall"}) );
   for(x=0;x<=random(2);x++) {
     clone_object("/d/unterwelt/ronja/sternenwald/weapon/edorn")->
       move(this_object(),M_NOCHECK);
   }
 
}


int Defend(int dam, mixed dam_type,mixed spell,object enemy)
{
  int dt;

  dt = -1;

  if (pointerp(dam_type)) 
    dt=member_array(DT_COLD,dam_type);
  else if (dam_type==DT_COLD) 
    dt=0;

  if(dt!=-1)
  {
    dam=dam/4; 
    if (random(100)>=40)
    {
      write("Der Eisriese heilt sich durch den Eisangriff!\n");
      heal_self(dam);
      dam = 0;
    }
  } 
  return ::Defend(dam,dam_type,spell,enemy);
}
