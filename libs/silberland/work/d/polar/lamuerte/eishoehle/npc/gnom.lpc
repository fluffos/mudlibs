inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <new_skills.h>
#include "files.h"

#define MENV environment(this_object())

void fpl();
int *gotit=({0,0,0,0,0,0});
int done=0;
int i=0;
int co=0;
object player;

create()
{
  if (!is_clone(this_object())) return;
  ::create();       
  SetProp(P_SHORT, "Ein Gnom");
  SetProp(P_LONG, 
  "Ein kleiner unscheinbarer Gnom. Sein Spezialgebiet sind die Fotomacher. "+
  "Er soll Dir helfen ein Foto von einem Yeti zu machen. ");
  SetProp(P_NAME, "Gnom");
  SetProp(P_GENDER, MALE);
  AddId(({"\ngno","gnom"}));
  create_default_npc(30);
  SetProp(P_ATTRIBUTES,(["int":25,"str":30,"con":25,"dex":25]));
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOATTACK, 1);
  SetProp(P_HANDS,({" mit seinen kleinen Haenden",400}));
  SetProp(P_RACE, "Gnom");
  SetProp(P_SIZE, 50+random(20) );
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-55,T_RANGE_MAX:30]) );  

  seteuid(getuid(this_object()));
 
  AddInfo(DEFAULT_INFO,
   ({ "kennt sich ueberhaupt nicht aus.\n",
      "zuckt ratlos mit den Schuldern.\n",
      "sagt: Was? Das glaubst ja selber nit, Du Seicherl.\n",
      "ignoriert Dich.\n",
      "sagt: Ja Du bist Deinem Ziel schon greifbar nah!\n",
      "sagt: Du wirst es wohl nie schaffen, frag nicht so bloed.\n",
      "zittert.\n",
      "sagt: Frag nicht so lang, gehen wir endlich!\n",
      "streckt Dir die Zunge raus.\n",
      "sagt: Red deidsch i vasteh nit wos Du meinen!\n",
      "sagt: Ja, die Frage stellen sich alle Verlierer.\n",
      "schuettelt den Kopf.\n",
      "nickt heftig auf Deine Frage hin.\n",
      "sagt: Hmmm, Eishoehlen vielleicht?",
      "sagt: Das ist doch nicht das Richtige!\n",
      "sieht Dich artig an, weiss aber nicht was Du meinst.\n",
      "sagt: Na Du hast Sorgen.\n",
      "sagt: Ach ja, davon hab ich gehoert.\n",
      "sagt: Ich glaube, diese Frage stellt sich fuer uns nicht.\n",
      "sagt: Du musst deutlicher reden, ich hab Deine Frage nicht verstnden.\n"
    }) ); 
  AddInfo(({"teil","teile","gegenstaende","gegenstand"}),"@@brauch@@"); 
  AddInfo(({"foto","fotos"}),"@@dofoto@@");
  AddInfo("yeti",
   "sagt: Reinhold hat mir gesagt er braucht ein Foto von ihm.\n");

  AddInfo("reinhold",
   "sagt: Du Hilfst ihm, dass ist gut! :)\n");

  AddInfo("fotomacher",
   "sagt: Ja, wenn Du mir alle Teile besorgst, kann ich einen\n"+
   "Der Gnom sagt: Fotomacher daraus basteln. Hab ich alles,\n"+
   "Der Gnom sagt: kannst Du mich nach Foto fragen, damit ich\n"+
   "Der Gnom sagt: ein Foto mache.\n"); 


}

void set_fpl(string wem)
{
 if (!player=find_player(lower_case(wem)))
 {
  this_object()->remove();
  return;

 }

 player->AddPursuer(this_object());
 SetProp(P_SHORT,"Der Gnom von "+this_player()->QueryProp(P_NAME)); 
 set_living_name(lower_case("gnomvon"+this_player()->QueryProp(P_NAME)));
} 

reset()
{
   ::reset();
 if(player && find_player (player && lower_case(player->QueryProp(P_NAME))) ) return;
  
    this_object()->remove();
 }

give_notify(obj)
{
 
  if (gotit[0]!=1 && member_array("qblatt",obj->QueryProp(P_IDS) ) != -1 )
    {write("Der Gnom sagt: Oh, danke fuer das Seerosenblatt!\n");
     gotit[0]=1;
     obj->remove();
     brauch(); 
     return 1; 
     }

  if (gotit[1]!=1 && member_array("qbrett",obj->QueryProp(P_IDS) ) != -1 )
    {write("Der Gnom sagt: Oh, danke fuer das Brett! Das brauch ich fuer meine Kiste!\n");
     gotit[1]=1;
     obj->remove();
     brauch(); 
     return 1; 
    }

  if (gotit[2]!=1 && member_array("qnagel",obj->QueryProp(P_IDS) ) != -1 )
    {write("Der Gnom sagt: Ein Nagel! Damit kann ich Holzbretter zusammennageln!\n");
     gotit[2]=1;
     obj->remove();
     brauch(); 
     return 1; 
    }

  if (gotit[3]!=1 && member_array("qhammer",obj->QueryProp(P_IDS) ) != -1 )
    {write("Der Gnom sagt: Ein Hammer! Danke, den brauch ich zum Naegel nageln :)!\n");
     gotit[3]=1;
     obj->remove();
     brauch(); 
     return 1; 
    }

 
  if (gotit[4]!=1 && member_array("qkohle",obj->QueryProp(P_IDS) ) != -1 )
    {write("Der Gnom sagt: Ah! Mit dem Stueck Kohle kann ich gut zeichnen!\n");
     gotit[4]=1;
     obj->remove();
     brauch(); 
     return 1; 
    }

  if (gotit[5]!=1 && member_array("qfutter",obj->QueryProp(P_IDS) ) != -1 )
    {write("Der Gnom sagt: Na, ohne Futter wuerd ich so und so nicht arbeiten!\n");
     gotit[5]=1;
     obj->remove();
     brauch(); 
     return 1; 
    }
  
  write("Der Gnom sagt: Nein, das brauch ich wirklich nicht mehr!\n");
  write("Der Gnom gibts Dir wieder zurueck.\n"); 
  obj->move(this_player(),M_NOCHECK); 
 
 }



brauch()
{int x;

 if (gotit[0]==1 && gotit[2]==1  && gotit[3]==1  && gotit[4]==1  && gotit[5]==1  && gotit[1]=1)

  {
 write("Der gnom sagt: Ich hab alles fuer meinen Fotomacher!\n"+ 
  "Frag ihn einfach nach dem Foto wenn Du einem Yeti begegnest und er wird\n"+
  "den Fotomacher aktivieren!\n");
   done=1;
   return ("Der Gnom freut sich.");
  } 

 write ("Der Gnom sagt: Ich brauch noch:\n"); 
 for (x=0;x<=5;x++)
 {if(gotit[x]!=1)
  {
    if (x==0) write("Der Gnom sagt: Ein Seerosenblatt.\n");
    if (x==1) write("Der Gnom sagt: Ein Brett.\n");
    if (x==2) write("Der Gnom sagt: Einen Nagel.\n");
    if (x==3) write("Der Gnom sagt: Einen Hammer.\n");
    if (x==4) write("Der Gnom sagt: Ein Kohlestueck.\n");
    if (x==5) write("Der Gnom sagt: Ein bisschen Futter.\n");
  }

  }
 
  return ("schaut Dich erwartungsvoll an.\n"); 

}

dofoto()
{
 object objyeti;

 if(done!=1)
 {
 return ("sagt: Nix da, ich hab ja nicht mal alle Teile fuer den Fotomacher!\n");
 }


 if ( objyeti=present("yeti",environment(this_object()))  )
 {
 co=0;
 do_foto();
 return("sagt: So lustig ist es zu arbeiten.\n");
 
}


return("sagt: Nein, ich bin Kuenstler, ich zeichne nicht alles was herumsteht!\n"+
 "Der gnom sagt: Zeig mir den echten Yeti und ich aktiviere den Fotomacher!\n"); 
}


check_yeti()
{
	object objyeti; 
	if (!(objyeti=present("yeti",environment(this_object())))  )
	{
		i=0;
        co=1;
        write("Der Gnom sagt: Neeee, alleine bleib ich da nicht drinnen! *fuercht*\n");
		return 1;
	}
	return 1;
}



do_foto()
{
 object ob;

 check_yeti();

 if (i==1) write("Der Gnom schraubt und werkt an seinem Fotomacher.\n");
 if (i==2) write("Der Gnom zimmert sich aus dem Brett, dem Nagel und dem Hammer eine kleine Kiste.\n");
 if (i==3) write("Der Gnom zieht das Seerosenblatt und ein kleines Kohlenstueck aus seiner Tasche.\n");
 if (i==4) write("Der Gnom klettert flink in die kleine Holzkiste.\n");
 if (i==5) write("Der Gnom zeichnet eifrig auf dem Blatt herum.\n");
 if (i==6) write("Der Gnom huepft aus seiner Holzkiste.\n"); 
 if (i==7) write("Der Gnom grinst.\n");
 if (i==8) { 
   write("Der Gnom sagt: Hier hast Du ein Foto vom Yeti, bring es bitte zu Reinold!\n"); 
   ob=clone_object("/d/polar/lamuerte/eishoehle/obj/qfoto.lpc");
   ob->set_owna(this_player()->QueryProp(P_NAME));
   ob->move(this_player(),M_NOCHECK);
   call_out("killgnome",1);
   } 

 i=i+1;
 
 if (co!=1) call_out("do_foto",8);
}

killgnome()
{
 write(
 "Der Gnom winkt Dir noch ein letztes mal zu und verschwindet.\n"); 
this_object()->remove();
}
