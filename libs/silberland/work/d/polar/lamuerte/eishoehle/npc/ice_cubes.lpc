inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <mnpc.h>
#include "files.h"

void create()
{ 
  if (!is_clone(this_object())) return;
  ::create();       /* WICHTIG!!! */
  
  SetProp(P_SHORT, "Ein Eiswuerfel");
  SetProp(P_LONG, 
   "Ein riesig grosser Eiswuerfel. Er schaut eigentlich aus wie diese kleinen "+
   "Dinger aus Deinem Gefrierfach, nur einfach gesagt ums hundertfache groesser. "+
   "Bei seinem Anblick wird Dir noch kaelter, als es Dir ohnehin schon ist.");
  SetProp(P_NAME, "Eiswuerfel");
  SetProp(P_GENDER, MALE);
  AddId(({"enpc","eiswuerfel","wuerfel"}));
  SetProp(P_SIZE, 200);
  SetProp(P_RACE, "Elementar");
  
  create_default_npc(random(4)+18);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 4); 
  SetProp(P_HANDS, ({" mit einem Eisklotz", 420, DT_COLD})); 
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_COLD:-1, DT_FIRE:1, DT_POISON:0.5]) );
  SetProp(P_MATERIAL, MAT_ICE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-55,T_RANGE_MAX:20]) );  

  SetProp( P_REJECT, REJECT_KEEP);
 
   SetProp (P_MNPC_AREA, ROOM(""));
   SetProp (P_MNPC_WAIT, ({30, 40, 60}));
   SetProp (P_MNPC_DEFAULTROOM, ROOM("19601.lpc"));
   SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);

   "obj/gemmaster"->DistributeGem(2,4,1,1,({"diamant","rubin","saphir", "smaragd", 
         "okatarin", "zirkon", "aquamarin", "opal", "jadeit", "amethyst", 
         "tigerauge", "opal", "topas", "granat", "onyx", "bernstein", 
         "lapislazuli", "turmalin", "bergkristall"}));
}

