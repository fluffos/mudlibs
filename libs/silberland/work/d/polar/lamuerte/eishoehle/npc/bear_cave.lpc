inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h> 
#include "files.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();       
  SetProp(P_SHORT, "Ein Hoehlenbaer");
  SetProp(P_LONG, "Ein blutruenstiger Hoehlenbaer. Er wartet nur darauf "+
  "jemanden zerfleischen zu koennen. Er hat ein dunkelbraunes Fell und riesige "+
  "Pranken mit denen er seine Gegner zerfleischt.");
  SetProp(P_NAME, "Hoehlenbaer");
  SetProp(P_GENDER, MALE);
  AddId(({"enpc", "hoehlenbaer", "baer"}));
  create_default_npc(25);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_ALIGN, -300);
  SetProp(P_HANDS, ({" mit seinen Pranken", 700, DT_RIP })); 
  SetProp(P_SIZE, 250);
  SetProp(P_RACE, "Baer"); 
  seteuid(getuid(this_object()));
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-55,T_RANGE_MAX:20]) );
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_COLD:-0.7]) );
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Ein Hoehlenbaer braucht @WEN nicht.\n" }) );

  SetProp(P_DEFAULT_INFO, "fletscht hungrig mit seinen Zaehnen.\n");

  GIMME("bear_tooth.lpc");
  GIMME("eiskey.lpc");
}
