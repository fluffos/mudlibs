inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h> 
#include "files.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();       
  SetProp(P_SHORT, "Ein Yeti");
  SetProp(P_LONG, "Ein original blutruenstiger, brutaler, allesfressender, gnadenloser "+
  "jeden zerfleischender, tollwuetiger original Yeti. Man unterschaetzt ihn einfach zu "+
  "leicht! Er wurde von Dante missbraucht.");
  SetProp(P_NAME, "Yeti");
  SetProp(P_GENDER, MALE);
  AddId(({"yeti","originalyeti"}));
  create_default_npc(30);
  SetProp(P_ALIGN, -10);
  SetProp(P_HANDS, ({" mit seinen Klauen", 500, DT_RIP })); 
  SetProp(P_SIZE, 380);
  SetProp(P_RACE, "Troll");
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_COLD:-0.9]) );
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-55,T_RANGE_MAX:20]) );  

  seteuid(getuid(this_object()));
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Ein Yeti will das nicht.\n" }) );

  SetProp(P_DEFAULT_INFO, "ist kurz davor Dich umzubringen.\n");

}
