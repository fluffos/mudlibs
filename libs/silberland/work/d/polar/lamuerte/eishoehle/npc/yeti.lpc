inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h> 
#include "files.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();       
  SetProp(P_SHORT, "Ein Yetii");
  SetProp(P_LONG, "Ein blutruenstiger, brutaler, allesfressender, gnadenloser "+
  "jeden zerfleischender, tollwuetiger Yetii. Man unterschaetzt ihn einfach zu "+
  "leicht!");
  SetProp(P_NAME, "Yetii");
  SetProp(P_GENDER, MALE);
  AddId(({"yetii"}));
  create_default_npc(10);
  SetProp(P_ALIGN, -10);
  SetProp(P_HANDS, ({" mit seinen Klauen", 100 })); 
  SetProp(P_SIZE, 280);
  SetProp(P_RACE, "Troll");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-55,T_RANGE_MAX:20]) );  

  seteuid(getuid(this_object()));
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Ein Yetii will das nicht.\n" }) );

  SetProp(P_DEFAULT_INFO, "ist kurz davor Dich umzubringen.\n");
  
  GIMME("yeti_fur");

}

varargs void die(int poisondeath)
{
  if ( objectp(QueryProp(P_KILLER)) )
  {
    if ( present("\nzechpreller_quest_11", QueryProp(P_KILLER)) )
      present("\nzechpreller_quest_11", QueryProp(P_KILLER)) -> Mark();
  }

  ::die(poisondeath);
}
