//Es war einmal:
// /d/dschungel/feyaria/schiff.c
// Schablone fuer Schiffe
// 27-10-96  Feyaria@SilberLand
//und wird bald ein Eisbrecher (lam)

inherit "std/transport";

#include <properties.h>
#include <language.h>
#include "./tra.h"


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Eisbrecher" );
  SetProp( P_SHORT, "Ein Eisbrecher" );
  SetProp( P_LONG, BS(
    "Du sihst einen riesigen Eisbrecher. Wird wohl in den Polar fahren.") );
  SetProp( P_NAME, "Eisbrecher" );
  AddId( ({ "schiff", "eisbrecher", "brecher" }) );
  SetProp( P_GENDER, NEUTER );
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT,1);

  SetProp( P_INT_LONG, BS(
    "Du Befindest Dich auf einem riesigen Eisbrecher. Es ist wohl "+
    "kein Schiff der neusten Generation mehr, doch tapfer leistet es "+
    "noch seine Dieste und bringt seine Fahrgaeste fast immer heil an "+
    "ihr Ziel. ") );
 
  AddDetail("eisbrecher",
    "Er ist zwar alt, doch fahren tut er immer noch.");
  AddDetail("schiff",
    "Es handelt sich hierbei um ein Schiff der Eisbrecherklasse.");
  AddDetail( ({"dienst","dienste" }),
    "Fahrgaeste befoerdern, was fuer ein aufregender Dienst.");
  AddDetail( "fahrgaeste",
    "Du bist doch auch einer von ihnen.");
  AddDetail( "ziel",
    "Hobbingen oder Polaris, dass ist hier die Frage."); 
  AddDetail("generation",
    "Alt, aelter, am aeltesten. Es ist eindeutig am aeltesten.");  

  SetProp( P_DEPARTMSG, ({
    "Der Eisbrecher legt ab.\n", 
    "Der Eisbrecher legt ab.\n"}) );
  SetProp( P_ARRIVEMSG, ({
    "Der Eisbrecher legt im Hafen von @@QueryArrived@@ an.\n",
    "Der Eisbrecher legt im Hafen an.\n"}) );
    
  SetProp( P_ENTERMSG, ({
    "besteigt den Eisbrecher",
    "kommt auf den Eisbrecher"}) );
  SetProp( P_ENTERFAIL, ({
    "Es passen nur 5 Passagiere auf das Schiff",
    "hat keinen Platz mehr auf dem Schiff"}) );
  SetProp( P_MAX_PASSENGERS, 5 );

  SetProp( P_LEAVEMSG, ({
    "verlaest den Eisbrecher",
    "kommt vom Eisbrecher herunter"}) );
  SetProp( P_LEAVEFAIL, ({
    "Der Eisbrecher befindet sich doch auf hoher See",
    "wollte den Eisbrecher auf hoher See verlassen"}) );

  /* Verben */
  AddCmd( ({ "betrete", "betritt" }), "rein" );
  AddCmd( ({ "verlasse", "verlass" }), "raus" );

  /* Kurs */
  AddRoute( "/d/huegelland/feyaria/weg/room/steg.c", 30, 20, "Hobbingen" );
  AddMsg( "Der Eisbrecher segelt in Richtung Polar.\n", 30 );
  AddMsg( "Einige Seemoeven segeln ueber dem Eisbrecher.\n", 30 ); 
  AddMsg( "Starke Stuerme machen das Vorwaertskommen schwer.\n", 50 ); 
  AddMsg( "Es wird merklich kuehler hier.\n", 20 ); 
  AddMsg( "Der Eisbrecher naehert sich einem Steg.\n", 20 );
  AddMsg( "Der Eisbrecher hat es bald bis zum Steg geschafft.\n", 20 );
  AddMsg( "Der Steg ist nun greifbar nahe.\n", 10 );
  AddRoute( "/d/polar/lamuerte/eishoehle/weg/room/steg.c", 30, 20, "Polaris" );
  AddMsg( "Der Eisbrecher segelt in Richtung Hobbitdorf.\n", 30 );
  AddMsg( "Die See ist rauh und stuermisch.\n", 15 );
  AddMsg( "Der Wellengang macht Deinem Magen zu schaffen.\n", 25 );
  AddMsg( "Langsam aber sicher wird es waermer.\n", 20 );
  AddMsg( "War da nicht eben schon das Hobbitdorf zu sehen?\n", 30 );
  AddMsg( "Hups! Da hat ist doch glatt eine Moeve vom Himmel gefallen.\n", 20 );
  AddMsg( "Der Eisbrecher naehert sich dem Hobbitdorf.\n", 10 );
 	
  Start();
}

rein(str)
{
  notify_fail("Was willst Du betreten?\n");
  if( str && id(str) )
    return Enter();
  return 0;
}

raus(str)
{
  notify_fail("Was willst Du verlassen?\n");
  if( str && id(str) )
    return Leave();
  return 0;
}

void init()
{
  ::init();
  // Sichergehen, dass alle Haefen auch geladen sind.
  if (interactive(this_player()))
  {
    catch(call_other( "/d/huegelland/feyaria/weg/room/steg.c", "???"));
    catch(call_other( "/d/polar/lamuerte/eishoehle/dorf/room/steg.c", "???"));
  }
}
