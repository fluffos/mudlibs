//01.28.98
//NeueTankstelle +50HP bei dex>20 und hp=maxhp-50

inherit "std/room";

#include <properties.h>
#include <language.h>

int i=1;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Vor einem Berg" );
  SetProp( P_INT_LONG, 
   "Kaum kast du das kleine Doerflein hinter Dir gelassen, siehst Du den "+
   "riesigen Berg vor Dir. Im Norden kannst Du einen kleinen Eingang in "+
   "eine Hoehle sehen, hinter Dir im Suedosten liegt das kleine, verlassene "+
   "Dorf Smoersky. Ausserdem steht noch ein Wegweiser etwas unmotiviert "
   "in der Gegend rum.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 2]) );
 
  AddDetail( "wegweiser",
      "Versuchs mal mit lesen ;)");
  AddDetail("eingang",
   "Von hier aus kann man nicht viel vom Eingang erkennen. Es sieht aber "+
   "so aus, als wuerde er in eine Hoehle fuehren.");
  AddDetail("hoehle",
   "Schau doch einfach mal hin was sich da so tut!?");
  AddDetail("boden",
   "Du stehst auf einem morastigen Untergrund.");
  AddDetail("Untergrund",
   "Jaja! Er is morastig!");
  AddDetail("himmel",
   "Strahlendes Blau. Ob es hier ueberhaut Wolken gibt?");
  AddDetail("wolken",
   "Weit und breit keine zu sehen.");
  AddDetail( ({"wand","waende"}),
   "Wenn Du Waende sehen willst, geh doch nach Smoersky"); 
  AddDetail( ({"dorf","doerflein"}),
   "Smoersky ist nur einen Katzensprung von hier entfernt. Es liegt im "+
   "suedosten.");
  AddDetail("berg",
   "Der Berg wirkt beeindruckend. Man muesste aber weiter entfernt stehen "+
   "um ihn in seiner ganzen Pracht zu sehen. Bist Du ein Bergsteiger?");
  AddDetail("pracht",
   "Hmmm.. Vom Steg aus sieht man mehr.");
  AddDetail("smoersky",
   "Pfa, irgendwie kannst Du Dich mit diesem Smoersky einfach nicht "+
   "anfreunden.");
  AddDetail("steg",
   "Der Steg liegt suedlich von Smoersky."); 
  AddDetail("katzensprung",
   "Ja, es ist wirklich nicht weit bis nach Smoersky. Es liegt gleich "+
   "im Suedosten von hier.");
  AddReadDetail( "wegweiser",
  "\n"
  "                           /\\     \n"
  "                         /    \\   \n"
  "                       /        \\ \n"
  "                      |          | \n"
  "                      |   EIS-   | \n"
  "                      |  HOEHLE  | \n"
  "                      |          | \n"
  "         ___________ /     |     | \n"
  "        /                  |     | \n"
  "      /     YIQANUC  ------|     | \n"
  "       \\                   |     |\n"
  "         \\__________       |     |\n"
  "                     \\     |     |\n"
  "                      |          | \n"
  "                      | SMOERSKY | \n"
  "                      |          | \n"
  "                       \\        / \n"
  "                         \\    /   \n"
  "                           \\/     \n"
   );
     
     
      
  AddCmd( ({"kletter", "klettere"}) , "raufklettern" ); 

  AddExit( "norden", "/d/polar/lamuerte/eishoehle/rooms/19600");
  AddExit( "suedosten", "./festland_2" );
  AddExit( "westen", "/d/polar/thor/weg/room/weg1.lpc");
}


raufklettern(str)
 {if (!str)
  {write("Was? Wohin?\n");
   return 1;
  }

 if ( str=="auf berg" || str=="berg" )
  {
  if (this_player()->QueryAttribute(A_DEX)<=20 || i!=1)
   { 
   write("Du versuchst auf den Berg zu klettern, schaffst es aber nicht.\n");  
   return 1;
   }
   else if (i==1) 
   {
   write("Du kletterst auf den Berg, Yodelst ne runde und huepfst froehlich "+
   "wieder\nvom Berg herunter. War das befreiend!\n" );
   if(this_player()->QueryProp(P_HP)<=this_player()->QueryProp(P_MAX_HP)-50)
     {this_player()->reduce_hit_point(-50);
     } 
   i=0;
   return 1; 
   } 
 }

  write("Wohin willst Du klettern?\n");
  return 1;

 }

reset()
{::reset();
 i=1;
}
