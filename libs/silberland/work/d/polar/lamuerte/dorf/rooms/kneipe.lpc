// Kneipe 
// 1997-09-26  Feyaria@SilberLand

inherit "std/pub";

#include <properties.h>
#include <language.h>
#include <pub.h>
#include "/gilden/bardengilde/barden_extern.h"


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Zum Walfaenger" );
  SetProp( P_INT_LONG, 
    "Das ist die Kneipe 'Zum Walfaenger', der einzige Ort in Smoersky, wo man "
    "die eisige Kaelte vergessen kann und seine Sorgen mit einem Rum oder "
    "Gluehwein hinunterspuelen kann. Dann noch ein saftiges Wal-Steak, und man "
    "ist rundherum zufrieden. Aus einem Kamin kommt wohlige Waerme." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 14, ENV_TERRAIN:TT_HOUSE]) );

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER );
  SetProp(P_PUBKEEPER_ID, "wirt");
  SetProp(P_PUBKEEPER_GENDER, MALE);
  SetProp(P_PUBKEEPER_NAME, "der Wirt");
  SetProp(P_PUBMSG_NOKEEPER, 
      "Der Wirt hat gerade Mittagspause!\n"); 
  SetProp(P_PUBMSG_NOENEMY, "Du glaubst doch nicht im Ernst, dass Dir der "
	+"Wirt jetzt noch etwas verkauft!\n"); 
  SetProp(P_PUBMSG_NOINVITE, "Der Wirt verkauft nichts an Ruhestoerer!\n"); 
  SetProp(P_PUBMSG_FIGHTING, "Der Wirt ist gerade ziemlich beschaeftig, wie "
	+"Du vielleicht sehen kannst!\n"); 
  


  AddDrink("Rum", ({"rum"}),
    91, 42, 13, 8,
    ({"Du trinkst ein Stamperl Rum und fuehlst Dich wie ein Seemann.",
      "&& trinkt ein Stamperl Rum."}));

  AddDrink("Gluehwein", ({"gluehwein", "wein"}),
    43, 14, 3, 3,
    ({"Du trinkst einen Becher Gluehwein und Dir wird gleich wieder warm.",
      "&& trinkt einen Becher Gluehwein."}));

  AddDrink("SchlingLine", ({"line", "schling", "schlingline"}),
    1049, 50, -10, 3, "line_trinken");


  AddFood ( "Walfisch-Steak", ({"wal", "walfisch", "walfisch-steak", 
            "walfischsteak", "walfisch steak", "steak"}),  187, 35, 15,
   ({"Das Walfischsteak ist riesengross und schmeckt Dir vorzueglich.", 
     "&& isst ein riesenhaftes Walfischsteak."}));
    
  
  AddDetail( ({ "boden", "decke", "wand", "waende", "holz", "stamm", "staemme",
                "holzstaemme", "holzstamm"}),
    "Boden, Decke und Waende bestehen aus grossen Holzstaemmen, die die "
    "eisige Kaelte draussen lassen.");
  AddDetail( ({"kalt", "kaelte", "warm", "waerme"}),
    "Draussen ist es kalt, aber hier in der Kneipe ist es wohlig warm. Die "
    "Waerme kommt wohl aus dem Kamin.");
  AddDetail( ({"kamin"}),
    "Der Kamin strahlt wohlige Waerme aus. Endlich kannst Du einmal die eisige "
    "Kaelte vergessen, die draussen herrscht.");
  AddDetail( ({"kneipe", "walfaenger", "zum walfaenger", "ort"}),
    "Das ist die Kneipe 'Zum Walfaenger'. Sie heisst wohl so, weil fast alle "
    "Bewohner von Smoersky Walfaenger sind.");
  AddDetail( ({"bewohner"}),
    "Die meisten Bewohner von Smoersky sind Walfaenger.");
  AddDetail( ({"smoersky", "ansiedlung"}),
    "Diese kleine Ansiedlung heisst Smoersky.");
  AddDetail( ({"rum", "wein", "gluehwein"}),
    "Das kannst Du hier zum Trinken kaufen.");
  AddDetail( ({"wal", "walfisch", "walfisch-steak", "walfischsteak", 
               "walfisch steak", "steak"}),
    "Das kannst Du hier zum Essen kaufen.");
  AddDetail( ({"essen", "trinken"}),
    "Tipp einfach 'menue'.");
  AddDetail( ({"sorgen", "sorge"}),
    "Vergiss Deine Sorgen und kaufe Dir einen Rum!");
  
  AddSound( DEFAULT_SOUND,
    "*mampf* *schluerf*");
    
  AddSmell( ({DEFAULT_SMELL, "wal"}),
    "Es riecht nach gebratenem Wal.");

  AddItem( "/d/polar/lamuerte/dorf/npc/wirt" , REFRESH_REMOVE);

  AddExit( "westen", "./festland_2" );
}

#define BS(x) break_string(x, 75)
#define TP this_player()

public void line_trinken() {
  object task;

  write(BS("Du trinkst ein glas koestliches Erdbeerschlingline. Mann das war viel."));
  say(BS(this_player()->Name(WER, 1)+" trinkt ein Glas koestliches SchlingLine."));

  if(objectp(task=present(BARD_ID_GS10_TASK, TP))) {
    task->MarkFood(12);
  }
}

