inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Festland" );
  SetProp( P_INT_LONG, 
   "Du betrittst das Festland. Ein ziemlich kleines Doerflein scheint "+
   "hier mal gewesen zu sein. Es sieht aber nicht so aus, als ob hier "+
   "noch jemand wohnen wuerde. Wen wunderts! Hier ist es ja schlimmer "+
   "als am Ende der Welt. Ein kleiner Pfad fuehrt weiter in den Norden. "+
   "Im Sueden liegt ein Steg." );


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 2]) );

  AddSound( DEFAULT_SOUND,
    "Wind pfeift Dir durch die Ohren.");
  AddSound( ( "wind" ),
    "Pfeiiiifffff.....");
  AddDetail("himmel",
    "Der Himmel ist eisblau.");
  AddDetail("festland",
   "Ahh! Endlich wieder festen Boden unter den Fuessen. ");
  AddDetail("boden",
   "Der Boden ist kahl. Es sieht aber so aus, als wuerde hier mal "+
   "eine Art Strasse, nein, Weg, aehm nein, Pfad gewesen sein, welcher "+
   "in Richtung Norden weiterfuehrt. ");
  AddDetail( ({"strasse","weg"}),
   "Nein, das ist eher ein Pfad.");
  AddDetail("pfad",
   "Der Pfad ist kaum noch zu sehen. Wahrscheinlich benutzt ihn "+
   "keiner mehr. Ein altes Schild haengt verlassen da.");
  AddDetail( ({"fuss","fuesse"}),
   "Einmal kurz in den Boden gestampft. Ja, Festland, ist ok.");
  AddDetail( ({"dorf","doerflein"}),
   "Es ist nicht viel uebriggeblieben von einem 'Dorf'. Kein Wunder, "+
   "in dem Kaff wuerdest Du auch nicht bleiben wollen.");
  AddDetail("schild",
   "Da steht ja was drauf!!");
  AddDetail("kaff",
   "Klein, abseits, verlassen... Kaff eben...");
  AddDetail("wunder",
   "Wunder geschehen. Aber bestimmt nicht hier.");
  AddDetail("steg",
   "Der Steg liegt weiter im Sueden.");
  AddDetail("ende",
   "Nein, schlimmer als das...");
  AddDetail("welt",
   "Heul! Das ist das Ende der Welt!");
  AddReadDetail("schild",
   "-------------------------\n"+
   "- Woelkoem toe Smoersky -\n"+
   "-                       -\n"+
   "-  Smoelstst Doerf in   -\n"+
   "-     goenz Poelar!     -\n"+
   "-                       -\n"+
   "------------------------\n"); 

  AddExit( "norden", "./festland_2" );
  AddExit( "sueden", "./steg" );
}

