// Laden 
// 1997-09-26 Feyaria@SilberLand

inherit "std/laden";

#include <properties.h>
#include <language.h>
#include <laden.h>


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Kramladen von Smoersky" );
  SetProp( P_INT_LONG, 
    "Du stehst im Kramladen von Smoersky. Hier wird alles verkauft, was die "
    "Fischer und Walfaenger so brauchen. An den Waenden sind Regale, die mit "
    "allen moeglichen Dingen vollgestopft sind. Auf der Verkaufstheke steht "
    "ein kleines Schild. Eine kleine, hoelzerne Tuer fuehrt in Richtung "
    "Nordosten ins Freie.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 11, ENV_TERRAIN:TT_HOUSE]) );

  SetStorageRoom ( "/d/polar/lamuerte/dorf/rooms/store");
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER+ SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "Kraemerin");
  SetProp(P_SHOPKEEPER_NAME, "die Kraemerin");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
            
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus Holzplanken.");
  AddDetail( ({"wand", "waende"}),
    "Die Wand fragt Dich: Warum starrst Du mich so an?");
  AddDetail( ({"decke"}),
    "Die Decke besteht aus Holzplanken.");
  AddDetail( ({"holz", "holzplanken", "holzplanke", "planken", "planke"}),
    "Boden, Waende und Decke bestehen aus Holzplanken.");
  AddDetail( ({"regal", "regale"}),
    "Die Regale sind mit allen moeglichen Dingen vollgestopft.");
  AddDetail( ({"dinge", "ding"}),
    "Falls Du Dich fuer die Dinge interessierst, probier einfach mal 'zeige'.");
  AddDetail( ({"fischer", "walfaenger", "kunden"}),
    "Die Fischer und Walfaenger gehoeren zu den besten Kunden des "
    "Kraemerladens.");
  AddDetail( ({"smoersky", "dorf"}),
    "Smoersky ist das Dorf, in dem Du Dich gerade befindest.");
  AddDetail( ({"laden", "kramladen", "kraemerladen"}),
    "Du stehst im Kramladen von Smoersky.");
  AddDetail( ({"kraemerin"}),
    "Die Kraemerin ist scheinbar nicht da. Wenn Du also etwas kaufen oder "
    "verkaufen willst, musst Du schon warten, bis sie wieder da ist.");
  AddDetail( ({"tuer", "nordosten", "freie"}),
    "Eine kleine, hoelzerne Tuer fuehrt in Richtung Nordosten ins Freie.");
  AddDetail( ({"theke", "verkaufstheke"}),
    "Auf der Verkaufstheke steht ein kleines Schild.");
  AddDetail( ({"schild"}),
    "Du kannst es lesen.");
  
  AddReadDetail( ({ "schild" }),
    "Umtausch nur vor Verkauf der Ware moeglich!");

  AddSound( ({DEFAULT_SOUND, "holzplanken"}),
    "Die Holzplanken knarren unter Deinen Schritten.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht modrig.");

  AddItem( "/d/polar/lamuerte/dorf/npc/kraemerin", REFRESH_DESTRUCT);

  AddExit( "nordosten", "./festland_2" );
}

