inherit "std/room";

#include <properties.h>
#include <language.h>
#include "/d/wasser/feyaria/schiffe.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "An einem kalten Steg" );
  SetProp( P_INT_LONG, 
   "Du befindest Dich auf einem kleinen Steg am Beginn des eisigen Polar. "+
   "Vor Dir ragt ein grosser Berg in den Himmel empor, welcher beinahe "+
   "komplett in Schnee und Eis eingehuellt ist. Nur hier herunten bist "+
   "Du noch vor den eisigen Schneemassen sicher. Der Steg fuehrt in "+
   "Richtung Norden auf das Festland. " );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 1]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein sanftes Blubbern.");
  AddSound( ( "blubbern" ),
    "Kleine Wellen im Wasser verursachen das Blubbern.");
  AddSmell( DEFAULT_SMELL,
    "Hier hat es einen typischen Hafengeruch.");
  AddSmell( ({"hafen", "hafengeruch", "geruch"}),
    "Dieser Hafen riecht wie jeder andere Hafen auch.");
  
  AddDetail("steg",
   "Der Steg ist aus vielen wackeligen Holzbalken zusammengezimmert. "+
   "Man kann nur hoffen, dass er nicht zusammenbricht. Ein kleines "+
   "Schild steht im Wasser.");
  AddDetail("polar",
   "Jo, Du befindest Dich am Anfang davon.");
  AddDetail("wasser",
   "Nass, viel und kalt. Vielleicht ein Meer?");
  AddDetail("meer",
   "Schmeckt salzig, ist ein Meer!");
  AddDetail("schild",
   "Probiers mal mit lesen...");
  AddReadDetail("schild",
   "-------------------------------------------\n"+
   "- Schiffsan ege telle zum eisi en Brecher -\n"+
   "-                                         -\n"+
   "-  Fah pl  : Mo-Fr 1 : 0 -  3:1           -\n"+
   "-            Sa+S   2:00 - 1 : 1          -\n"+
   "-                                         -\n"+
   "-------------------------------------------\n"); 
  AddDetail( ({ "balken", "holzbalken" }) ,
   "Die Balken sehen schon etwas morsch aus. Anscheinend kuemmert sich "+
   "kein Mensch mehr um diese Konstruktion.");
  AddDetail("konstruktion",
   "So richtig vertrauen tust Du ihr nicht.");
  AddDetail("beginn",
   "Ja, eindeutig, es handelt sich um den Beginn des Polars.");
  AddDetail("berg",
   "Der Berg ist ganz schoen hoch. Da kommt man wohl nicht rauf. Er "+
   "ist mit Schnee und Eis bedeckt.");
  AddDetail("schnee",
   "Weisser, glaenzender Schnee. Scheint Neuschnee zu sein.");
  AddDetail("neuschnee",
   "Du bist Dir zwar nicht ganz sicher, aber es sieht nach Neuschnee "+
   "aus. Schade, eine Seilbahn zum Skifahren gibt es nicht.");
  AddDetail("seilbahn",
   "Wenn Du genug Geld haettest, wuerdest Du genau hier eine bauen "+
   "lassen.");
  AddDetail("eis",
   "Das Eis ist dunkelblau. Es reflektiert das Sonnenlicht.");
  AddDetail( ({"licht","sonnenlicht"}),
   "Ein herrlicher Tag. Die Sonne laechelt Dir entgegen.");
  AddDetail("sonne",
   "Sie scheint planlos in der Gegend herum. Wie es halt so ist an "+
   "einem schoenen Tag.");
  AddDetail("tag",
   "Heute ist ein schoener Tag. *hick*");
  AddDetail( ({ "massen" , "schneemassen" }),
   "Schnee, Schnee und nochmal Schnee. Richtige Schneemassen eben.");
  AddDetail( ({ "land" , "festland" }),
   "So richtig festen Boden unter den Fuessen wirst Du erst weiter "+
   "im Norden haben.");
  AddDetail("boden",
   "Unter Dir siehst Du wackelige Holzbalken.");
  AddDetail("himmel",
   "Der Himmel ist wunderbar blau. Die Sonne laechelt Dir entgegen. "+
   "Was fuer ein herrlicher Tag fuer eine kleine Metzeltour.");
  AddDetail( ({ "tour", "metzeltour" , "sherlein" , "gemetzel" , "todesaexte" }),
   "Pack die Todesaexte ein, nimm ein zweites Seherlein und dann schnelle "+
   "ins lustige Gemetzel rein!");
  AddDetail( ({ "wand","waende"}),
   "Was? Hier im Freien? Dreh Dein Untersuchescript sofort ab!");  

  AddExit( "norden", "./festland_1" );

 AddItem( EISBRECHER, REFRESH_DESTRUCT, 1);
 AddItem( WALFAENGER, REFRESH_DESTRUCT, 1);
 AddItem( "/d/polar/lamuerte/dorf/npc/fischer.lpc", REFRESH_DESTRUCT);

  AddCmd( ({"angle", "angel", "angl"}), "angeln");
}

int angeln(string str)
{
  if(present("angel",this_player()))
    notify_fail("Leider faengst Du nichts.\n");
  return 0;
}

init()
{object me; 

 ::init();
    if (me=find_player("lamuerte"))
    {
    if (!interactive(this_player())) return ;
    tell_object(me,"[SMOERSKY] "+this_player()->QueryProp(P_NAME)+
    " treibt sich in Smoersky rum.\n");
    }
 return ;
}
