inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Dorfplatz" );
  SetProp( P_INT_LONG, 
   "Du betrittst den Dorfplatz von Smoersky. Im Osten siehst Du eine alte "+
   "Kneipe, im Nordosten ist eine verlassene Post zu sehen und im Suedwesten "+
   "kannst Du einen kleinen Laden ausmachen. Hier trafen frueher die "+
   "Einwohner zusammen um Waren und Erfahrungen zu tauschen.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 2]) );

  AddDetail( ({"wand","waende"}),
   "Die Wand sagt: Starr mich nicht so an.");
  AddDetail("himmel",
   "Keine einzige Wolke am blauen Himmel zu sehen.");
  AddDetail("wolke",
   "Ja wenn doch keine da ist, kann man sie doch nicht untersuchen.");
  AddDetail("sonne",
   "Natuerlich ist die Sonne auch da, und sie scheint sogar auf Dich "
   "herab.");
  AddDetail( ({"punkt","hoehepunkt"}),
   "Genau hier beschlossen einst die Einwohner den Bau von Smoersky.");
  AddDetail("bau",
   "Das war einmal....");
  AddDetail("boden",
   "Der Boden, auf dem Du stehst, war mal ein kultureller Hoehepunkt "+
   "hier in Smoersky.");
  AddDetail("laden",
   "Geh doch einfach hin und erkunde was sich dort noch so tut.");
  AddDetail("einwohner",
   "Besonders viele gibt es hier nicht mehr, es sieht alles so "+
   "aufgelassen aus.");
  AddDetail("post",
   "Also, ja, aehm, das WAR eine Post. Was es jetzt ist, kann man von hier "+
   "aus nicht genau feststellen.");
  AddDetail( ({"platz", "dorfplatz"}),
   "Der Dorfplatz, oder das was von ihm noch uebriggeblieben ist, "+
   "sieht absolut leer und verlassen aus. Angst steigt in Dir auf, "+
   "bei dieser unheimlichen Stille.");
  AddDetail("angst",
   "Du dachtest immer sowas kennst Du nicht, doch hier wird Dir doch "+
   "etwas schwummrig.");
  AddDetail("smoersky",
   "Smoersky ist nordisch und heisst bei uns so viel wie grosses Kaff.");
  AddDetail("kaff",
   "Na, Smoersky eben.. :-)");
  AddDetail("kneipe",
   "Du siehst Licht in der Kneipe, kann es sein, dass da noch wer drinnen "+
   "wohnt?!");
  AddDetail("licht",
   "Das Licht kommt von der Kneipe.");
  AddDetail( ({"erfahrung", "erfahrungen"}),
   "Leider, jetzt kann man keine mehr austauschen mit den Einwohnern.");
  AddDetail( "stille",
   "None, nada, nix...");
  AddDetail("waren",
   "Vorwiegend waren es Fische.");
  AddDetail("fische",
   "Keiner da. Leider."); 


  AddSound( DEFAULT_SOUND,
    "Du hoerst absolute Stille.");
  AddSound(  "stille" ,
    "*nichts*");

  AddItem( "/p/service/thor/postcards/obj/postkasten", REFRESH_DESTRUCT );
  
  AddExit( "sueden", "./festland_1" );
  AddExit( "nordwesten", "./festland_3" );
  AddExit( "nordosten", "./post" );
  AddExit( "suedwesten", "./laden" );
  AddExit( "osten", "./kneipe" );
}

