// Post 
// 1997-09-26  Feyaria@SilberLand

inherit "std/post";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine verlassene Poststation" );
  SetProp( P_INT_LONG, 
    "Diese Poststation ist ziemlich verwahrlost. Die gelbe Farbe blaettert "
    "von den Waenden ab, die Holzplanken der Decke sind morsch und alt, und "
    "auf dem Boden liegt viel Unrat herum. Scheinbar haben die Bewohner "
    "von Smoersky wenig Zeit, Briefe zu schreiben. Es ist ein Wunder, dass die "
    "Post trotzdem noch funktionstuechtig ist. Da die Tuer nicht mehr richtig "
    "schliesst, ist es hier sehr kalt und zugig.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 5, ENV_TERRAIN:TT_HOUSE]) );

  AddDetail( ({ "wand", "waende" }),
    "Von den Waenden blaettert die gelbe Farbe ab.");
  AddDetail( ({ "farbe", "gelb"}),
    "Die Farbe war mal das gleiche Postgelb, dass man aus allen Postaemtern "
    "kennt. Hier ist es aber schon sehr ausgebleicht.");
  AddDetail( ({ "decke"}),
    "Die Decke besteht aus alten, morschen Holzplanken.");
  AddDetail( ({"boden"}),
    "Der Boden besteht aus alten Holzplanken und ist voll mit Unrat.");
  AddDetail( ({"unrat"}),
    "Auf dem Boden liegt viel Unrat herum.");
  AddDetail( ({"holz", "planken", "holzplanken"}),
    "Die Holzplanken sind alt. Niemand macht sie die Muehe, hier mal etwas "
    "zu reparieren.");
  AddDetail( ({"muehe", "untersuchen", "details"}),
    "Das Untersuchen von Details ist manchmal schon sehr muehsam....");
  AddDetail( ({"tuer"}),
    "Die Tuer schliesst nicht mehr richtig, darum ist es hier sehr kalt und "
    "zugig.");
  AddDetail( ({"post", "poststation"}),
    "Das ist hier eine Poststation.");
  AddDetail( ({"briefe", "brief"}),
    "Tipp doch einfach mal 'post'.");
  AddDetail( ({"smoersky", "dorf", "fischerdorf", "fischerdoerfchen"}),
    "Das ist das kleine Fischerdoerfchen, in dem Du Dich gerade befindest.");
  AddDetail( ({ "wunder"}),
    "Manchmal passieren wirklich noch echte Wunder!");
  AddDetail( ({ "bewohner", "fischer"}),
    "Die meisten Bewohner von Smoersky sind Fischer.");
  
  AddSound( ({DEFAULT_SOUND, "wind", "pfeifen"}),
    "Der eiskalte Wind pfeift durch den Raum.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht kalt?");

  AddExit( "suedwesten", "./festland_2" );
}

