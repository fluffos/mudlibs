
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <mnpc.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();       
  SetProp(P_SHORT, "Eine Kraemerin");
  SetProp(P_LONG, 
      "Eine haessliche Kraemerin will Dir was andrehen.\n");
  SetProp(P_NAME, "Kraemerin");
  SetProp(P_GENDER, FEMALE);
  AddId(({"kraemerin","frau","Kraemerin"}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 150);
  create_default_npc(15);
  SetProp(P_ALIGN, 100);
  SetProp(P_XP,0);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_DEAF, -1);
  SetProp(P_HANDS, ({" mit ihren Haenden",130})); 
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-15,T_RANGE_MAX:25]) );

  SetProp( P_REJECT, REJECT_KEEP);

  AddInfo( DEFAULT_INFO,
    ({"fuchtelt mit ihren Haenden herum.\n",
      "deutet Dir unverstaendliche Zeichen.\n",
      "bildet Buchstaben mit ihren Haenden. Was sie wohl meint?\n",
      "schreibt Zeichen in die Luft. Leider verstehst Du nix.\n" }) );

}

int _query_deaf()
{
  return 1;
}
