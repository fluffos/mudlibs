
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <mnpc.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();      
  SetProp(P_SHORT, "Ein irrer Fischer");
  SetProp(P_LONG, "Ein Fischer. Er probiert nach wie vor sein Glueck in Smoersky.\n");
  SetProp(P_NAME, "Fischer");
  SetProp(P_GENDER, MALE);
  AddId(({"fischer"}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170);
  create_default_npc(17);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen Haenden",270})); 
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-15,T_RANGE_MAX:25]) );


  seteuid(getuid(this_object()));
  clone_object("/p/weapon/spear/angel")->move(this_object());
  clone_object("/d/ebene/lamuerte/fernglas/obj/qlinse.lpc")->move(this_object());
  command("zuecke angel");

  SetProp( P_REJECT, REJECT_KEEP);

  AddInfo( ({"smoersky","dorf","doerflein"}),
   "sagt: Ist es nicht wunderschoen hier in Smoersky? Leider sind schon \n"+
   "Der Fischer sagt: viele unserer Einwohner von hier weggezogen.\n");
  AddInfo ( "einwohner",
   "Ja, ich bin einer von den Uebriggebliebenen.","sagt: ");
  AddInfo ( "hoehle",
   "Hmm.. Du meinst die hinten beim Berg? Frag doch mal den Wirt. Er"+
   "kann Dir vielleicht mehr dazu sagen.","sagt: ");
  AddInfo( ({"fisch","fische"}),
   "Heute will wieder mal gar keiner anbeissen.","sagt: ");
  AddInfo( "angel",
   "Gefaellt sie Dir?","sagt: ");
  AddInfo( ({"drache","drachen"}),
   "Angeblich gibts einen in der Hoehle, frag den Wirt, vielleicht kann er "+ 
   "Dir weiterhelfen.","sagt: ");
  AddInfo( "steg",
   "Dem wuerde eine Renovierung auch nicht schlecht tun.","sagt: ");
  AddInfo( "renovierung",
   "Den Steg? Nein, freut mich nicht. ","sagt: ");
  AddInfo( "wirt",
   "Der plagt sich immer noch mit seinem Fett rum. Ich denke er wills aber "+
   "loswerden. Frag ihn halt.","sagt: ");
  AddInfo( "kraemerin",
   "Recht viel nimmt sie auch nicht mehr ein.","sagt: ");
  AddInfo( ({"linsen","glaslinsen","linse"}),
   "Das sind meine, die geb ich nur ueber meine Leiche her.","sagt: ");
  AddInfo( DEFAULT_INFO,
   ({"sagt: Sei endlich leise, Du vertreibst mir die Fische!\n",
     "stiert Dich entgeistert an.\n",
     "sagt: Pssssssst!\n",
     "sagt: Ach ja?\n",
     "sagt: Da kann ich Dir wirklich nicht weiterhelfen.\n",
     "sagt: Ruhe, Du vertreibst die Fische.\n",
     "sagt: Was willst Du wirklich?\n"}) );

}

