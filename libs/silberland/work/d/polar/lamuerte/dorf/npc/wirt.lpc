
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <mnpc.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();       
  SetProp(P_SHORT, "Ein fetter Wirt");
  SetProp(P_LONG, "Ein dicker, ungewaschener, stinkender Wirt starrt Dich fragend an.\n");
  SetProp(P_NAME, "Wirt");
  SetProp(P_GENDER, MALE);
  AddId(({"wirt"}));
  

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-15,T_RANGE_MAX:25]) );
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 179);
  create_default_npc(17);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen Pranken",330})); 
  SetProp(P_XP,0);
  SetProp( P_REJECT, REJECT_KEEP);
  SetProp(P_SMELL,
   "Der Wirt riecht nach abgekochten, alten, Walfischfett, in dem er "+
   "seine\nSchnitzerl und Pommes herausbaeckt.\n"); 

 AddInfo ( DEFAULT_INFO,({
   "sagt: Stell nicht so laestige Fragen.\n",
   "sagt: Jaja, ist schon gut, trink lieber mal was.\n",
   "sagt: Also, das versteh ich jetzt nicht.\n",
   "sagt: Hehe, hat Dir das der Fischer erzaehlt?\n",
   "sagt: Ja, davon hab ich auch schon gehoert.\n" }) );
 AddInfo( ({"smoersky","dorf","doerflein"}),
  "Tja, leider ist hier bei uns nicht mehr viel los.","sagt: ");
 AddInfo( "fischer",
  "Der Fischer redet einfach zu viel. Horch nicht auf ihn.","sagt: ");
 AddInfo( "kraemerin",
  "Die Kraemerin redet nicht sehr viel. Ich denke sie ist staubdumm, "+
  "aehhh taubstumm mein ich.","sagt: ");
 AddInfo("hoehle",
  "Von hier aus ist es gar nicht mehr weit bis zur Hoehle.","sagt: ");
 AddInfo("berg",
  "Der Berg ist hoch, schneebedeckt und steil. Man kann ihn nicht "+
  "erklimmen.");
 AddInfo( ({"drache","drachen"}),
  "Viele Helden kehrten schon bei mir ein, bevor sie sich auf die Suche "+
  "nach nach neuen Abenteuern machten.","sagt: " );
 AddInfo ( ({"held","helden"}),
  "Oh ja, viele sind reingegangen, aber nur wenige hab ich wiedergesehen. "+
  "Die Legende erzaehlt von einem magischen Schwert names Kreth. Der Drache "+
  "beschuetzt es wie seinen Augapfel.", "erzaehlt aufgeregt: " );
 AddInfo ( ({"waffe","legende", "schwert","kreth"}),
  "Das magische Schwert Kreth war die maechtigste Waffe der weissen "+
  "Drachenritter. Mit diesem Schwert schlugen sie viele ihrer Gegner "+
  "in den Tod. Es soll fuerchterliche magische Vernichtung anrichten. ", 
  "erzaehlt: ");
 AddInfo ( ({"ritter", "drachenritter"}),
  "Die Drachenritter waren einst grosse Kaempfer. Doch schon seit vielen "+
  "Jahren hat man keinen mehr von ihnen gesehen. Es war nie verstaendlich, "+
  "doch Kobolde waren ihre Erzfeinde.","erzaehlt: ");
 AddInfo ( ({"kobold","kobolde","feinde"}),
  "Tausende von Ihnen fanden den Tod durch die Drachenritter.","sagt: ");
 AddInfo( "vernichtung",
  "Mir ist nicht bekannt wie diese Waffe eine solch verherende Wirkung "+
  "hat. Kein Held hat sie jemals aus der Hoehle herausholen koennen.",
  "sagt: ");
 AddInfo("fett",
  "Mit SchlingLine haett ichs beinahe geschafft, doch jetzt bin ich um "+
  "fuenfzig Pfund schwerer als vor der Diaet.","sagt: ");
 AddInfo( "rum",
   "Gutes Gesoeff wuerd ich sagen.","sagt: ");
  AddInfo( "gluehwein",
   "Trink ihn halt mal, ich weiss nicht ob er Dir schmeckt.","sagt: ");
  AddInfo( ({"steak","walfisch-steak"}),
   "Ein kleiner Snack fuer zwischendurch.","sagt: ");
  AddInfo( "schlingline",
   "Hmmmmm! Lecker!\n","sagt: ");

}

