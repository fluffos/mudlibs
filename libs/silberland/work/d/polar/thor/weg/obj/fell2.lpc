#include "../weg.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Stueck Wolfsfell");
  SetProp(P_LONG,
      "Ein Stueck von einem Wolfsfell. Es ist zwar etwas steifgefroren, aber "
      "vielleicht kann es ja noch nuetzlich sein.");
  SetProp(P_NAME, "Wolfsfell");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"\nwolfsfell", "\nwolfsfell2", "fell", "wolfsfell", "stueck"}) );

  SetProp(P_MATERIAL, ([MAT_FUR:100]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 50);
  SetProp(P_NOBUY, 0);

}
