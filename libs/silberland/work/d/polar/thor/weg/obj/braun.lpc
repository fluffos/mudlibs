#include "../weg.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_INFO, 0);
  SetProp(P_NAME, "braeune");
  SetProp(P_GENDER, NEUTER);
  AddId( "\nbraeune" );

  SetProp(P_MATERIAL, ([MAT_MISC:100]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_NODROP, 1);

}

string extra_look()
{
  return capitalize(environment()->QueryPronoun())+
      " hat ein sonnengebraeuntes Gesicht.\n";
}

varargs int move(mixed dest, int method)
{
  if(objectp(dest) && !query_once_interactive(dest))
    call_out("weg", 0);
  return ::move(dest, method);
}

weg()
{
  remove();
}
