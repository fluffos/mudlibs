#include "../weg.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Astgabel");
  SetProp(P_LONG,
      "Eine ziemlich grosse, dicke, stabile Astgabel.");
  SetProp(P_NAME, "Astgabel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_INFO, BS("Mit dem richtigen Ueberzug koenntest Du Dir vielleicht "
      "einen Schneeschuh davon basteln."));
  AddId( ({"gabel", "astgabel", "ast"}) );

  SetProp(P_MATERIAL, ([MAT_WOOD:100]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);

  AddCmd( ({"bastel", "bastle"}), "do_it");
}

do_it( str )
{
  object ob, ob2;
  notify_fail("Was willst Du basteln?\n");
  if(str == "schneeschuhe" || str == "schneeschuh") {
    if(!present("\nwolfsfell", TP)) {
      write(BS("Du hast ja gar kein geeignetes Fell, um die Astgabel damit "
            "zu bespannen!"));
      return 1;
    }
    else if(!ob=present("\nwolfsfell2", TP)) {
      write(BS("Du versuchst, dass Wolfsfell ueber die Astgabel zu "
            "spannen, allerdings ist es viel zu gross dafuer. Vielleicht "
            "solltest Du es erst einmal entzwei schneiden?"));
      return 1;
    }
    else if(!ob2=present("\nschneeschuh", TP)) {
      write(BS("Du spannst das Stueckchen Wolfsfell ueber die Astgabel und "
            "befestigst es notduerftig. In Deinen Haenden haeltst Du nun "
            "einen zwar nicht allzu schoenen, aber zweckdienlichen "
            "Schneeschuh."));
      say(BS(CAP_TPN+" werkelt an einer Astgabel und einem Stueck Fell "
            "herum."));
      clone_object(ARMOUR("schneeschuh"))->move(TP, M_GET);
      ob->remove();
      remove();
      return 1;
    }
    else {
      write(BS("Du spannst das Stueckchen Wolfsfell ueber die Astgabel und "
            "bastelst Dir so einen zweiten Schneeschuh."));
      say(BS(CAP_TPN+" werkelt an einer Astgabel und einem Stueck Fell "
            "herum."));
      ob2->remove();
      clone_object(ARMOUR("schneeschuhe"))->move(TP, M_GET);
      ob->remove();
      remove();
      return 1;
    }
      
  }
    else
      return 0;
}
