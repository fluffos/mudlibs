#include "../weg.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Wolfsfell");
  SetProp(P_LONG,
      "Ein grosses Wolfsfell. Es ist zwar etwas steifgefroren, aber "
      "vielleicht kann es ja noch nuetzlich sein.");
  SetProp(P_NAME, "Wolfsfell");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fell", "wolfsfell", "\nwolfsfell"}) );

  SetProp(P_MATERIAL, ([MAT_FUR:100]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 0);

  AddCmd( ({"zerschneide", "zerschneid", "schneide", "schneid"}), "cut");
}

cut( str )
{
  notify_fail("Was willst Du (zer)schneiden?\n");
  if(id(str)||str=="fell zurecht"||str=="fell entzwei"||
     str=="fell in zwei teile"||str=="wolfsfell zurecht"||
     str=="wolfsfell entzwei"||str=="wolfsfell in zwei teile") {
    write("Du zerschneidest das Wolfsfell in zwei Teile.\n");
    say(CAP_TPN+" schneidet ein Fell entzwei.\n");
    clone_object(OBJ("fell2"))->move(TP, M_NOCHECK);
    clone_object(OBJ("fell2"))->move(TP, M_NOCHECK);
    call_out("weg", 0);
    return 1;
  }
  else
    return 0;
}

weg()
{
  remove();
}
        
    
