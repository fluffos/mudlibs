***********************************/


#include "../../weg.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

int full=0;

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Giesskanne");
  SetProp(P_LONG,
    "");
  SetProp(P_NAME, "Giesskanne");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kanne", "giesskanne"}) );

  SetProp(P_MATERIAL, ([MAT_IRON:100]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 0);
  
  AddCmd( ({"fuelle", "fuell"}), "fill_in");
  AddCmd( ({"schmelze", "schmelz"}), "melt"); 
  AddCmd( ({"stelle", "stell"}), "schneeschmelzen");
  AddCmd( ({"giesse", "giess"}), "giessen");
}

fill_in( str )
{
  notify_fail("Was willst Du in die Giesskanne fuellen?\n");

  if(full) {
    write("Aber die Giesskanne ist doch schon voll!\n");
    return 1;
  }

  if(str=="schnee in kanne"||str=="schnee in giesskanne"||
     str=="schnee in kanne hinein"||str=="schnee in giesskanne hinein"||
     str=="kanne mit schnee"||str=="giesskanne mit schnee")
    if(file_name(environment(TP))[0..<2]==ROOM("lichtung")) {
      write("Du schaufelst etwas Schnee in die Giesskanne hinien.\n");
      say(CAP_TPN+" schaufelt etwas Schnee in eine Giesskanne.\n");
      full=1;
      return 1;
    }
    else {
      write("Der Schnee hier ist nicht locker genug, um ihn in die "
          "Giesskanne zu fuellen.\n");
      return 1;
    }
  else
    return 0;
}

melt( str )
{
  if(full==1) {
    write(BS("Wenn Du den Schnee in der Kanne schmelzen willst, stell die "
          "Giesskanne einfach an ein sonniges Plaetzchen."));
    return 1;
  }
  else
    return 0;
}

schneeschmelzen( str )
{
  notify_fail("Was willst Du mit der Kanne machen? Abstellen?\n");

  if(str=="kanne ab"||str=="gieskanne ab"||str=="kanne in sonne"||
     str=="giesskanne in sonne") {
    if(!full) {
      write("Du hast ja gar nichts in Deiner Giesskanne, das Du schmelzen "
          "koenntest\n");
      return 1;
    }
    else if(full==2) {
      write("Der Schnee in Deiner Giesskanne ist doch schon geschmolzen!\n");
      return 1;
    }
    else if(file_name(environment(TP))==ROOM("weg21")) {
      write(BS("Du stellst Deine Giesskanne in die Sonne. Es dauert zwar "
            "eine Weile, doch langsam beginnt der Schnee in der Sonne zu "
            "schmelzen. Du wartest und wartest und wartest und schliesslich "
            "hast Du eine Giesskanne, die etwa halbvoll mit Wasser gefuellt "
            "ist."));
      full=2;
      return 1;
    }
    else {
      write(BS("Hier ist es wohl nicht warm genug, um den Schnee in der "
            "Kanne schmelzen zu lassen."));
      return 1;
    }
  }
  else
    return 0;
}

giessen( str )
{
  notify_fail("Was willst Du giessen?\n");
  if(file_name(environment(TP))==ROOM("lichtung4")) {
    if(str=="schnee") {
      write(BS("Du giesst den Schnee auf der Lichtung. Durch das Wasser "
            "wird er richtig schoen klebrig und ist jetzt wohl ideal, um "
            "damit einen Schneemann zu bauen."));
      say(CAP_TPN+" giesst den Schnee. Du gruebelst, warum wohl.\n");
      return 1;
    }
  else
    return 0;
  }
  else {
    write("Hier kannst Du nichts giessen.\n");
    return 1;
  }
}

varargs string long()
{
  if(!full)
    return "Eine grosse, metallene Giesskanne. Du kannst etwas "
      "in sie hineinfuellen.\n";
  else if(full==1)
    return "Eine grosse, metallene Giesskanne. Sie enthaelt:\n"
      "Etwas Schnee.\n";
  else if(full==2)
    return "Eine grosse, metallene Giesskanne. Sie enthaelt:\n"
      "Etwas Wasser.\n";
}
