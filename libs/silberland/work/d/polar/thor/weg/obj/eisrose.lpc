#include "../weg.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

void rose_verschenkt( object who );
string schenker;

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Eisrose");
  SetProp(P_LONG,
      "In Deinen Haenden haeltst Du eine wunderschoene, zerbrechliche "
      "Rose, welche vollkommen aus Eis besteht. Fasziniert betrachtest "
      "Du dieses einzigartige Werk der Natur. Selbst die Bluetenblaetter "
      "bestehen vollkommen aus hauchduennem Eis und Du hast Angst, dass "
      "sie bei dem geringstem Windhauch zerbrechen koennten.");
  SetProp(P_NAME, "Eisrose");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"rose", "eisrose"}) );
  SetProp(P_INFO, "Die Eisrose waere bestimmt ein wunderschoenes "
      "Geschenk fuer jemandem, der Dir sehr nahe steht.");
  
  AddDetail( ({"hand", "haende"}),
      "Sei vorsichtig mit Deinen tolpatschigen Haenden, damit Du die "
      "Rose nicht zerbrichst!");
  AddDetail( "eis",
      "Das Eis ist hauchduenn und aeusserst zerbrechlich. Seltsamerweise "
      "schmilzt es nicht in Deinen Haenden. Da muss wohl Magie mit im "
      "Spiel sein.");
  AddDetail( "magie",
      "Bei einem solchen Kunstwerk muss wohl Magie im Spiel sein.");
  AddDetail( ({"werk", "kunstwerk"}),
      "Fasziniert betrachtest Du die Eisrose.");
  AddDetail( ({"natur", "werk"}),
      "Du kannst nicht verstehen, wie die Natur ein solches Werk fertigbringen "
      "konnte.");
  AddDetail( ({"blaetter", "bluetenblaetter", "blatt", "bluetenblatt"}),
      "Die Bluetenblaetter sind so zart und duenn, wie die einer echten "
      "Rose, nur dass sie komplett aus hauchduennem Eis bestehen."); 
  
  SetProp(P_MATERIAL, ([MAT_ICE:90, MAT_MISC_MAGIC:10]) );
  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 50);
  SetProp(P_NOBUY, 0);

  AddCmd( ({"schenke", "schenk", "verschenke","verschenk"}), "verschenken");
}

verschenken( str )
{
  object wer;
  string wen;
  
  notify_fail("An wen willst Du die Rose verschenken?\n"
              "Syntax: verschenke rose an <wen>\n");
  
  if(!str)
    return 0;
  
  if( sscanf(str, "rose an %s", wen) !=1 )
    return 0;
  else if( !wer=find_player(wen) ) {
    write("Aber "+capitalize(wen)+" ist im Moment gar nicht im Spiel!\n");
    return 1;
  }
  else if(environment(TP)!=environment(wer)) {
    write(BS("Um "+capitalize(wen)+" die Eisrose schenken zu koennen, muss "
        +wer->QueryPronoun(WER)+" aber schon im selben Raum sein wie Du."));
    return 1;
  }
  else {
    write(BS("Laechelnd trittst Du einen Schritt naeher an "+capitalize(wen)
          +" heran und schenkst "+wer->QueryPronoun(WEM)+" die Eisrose."));
    tell_object(wer, BS(CAP_TPN+" kommt einen Schritt auf Dich zu und laechelt "
          "Dich an. In "+TPPP(FEMALE, WEM, PLURAL)+" Haenden haelt "
          +TPP(WER)+" eine zerbrechliche Rose, welche vollkommen aus Eis "
          "besteht und die "+TPP(WER)+" Dir schenkt."));
    tell_room(environment(TP), CAP_TPN+" schenkt "+wer->name()+" eine "
        "wunderschoene Eisrose.\n", ({TP, wer}));
    schenker=TPN;
    rose_verschenkt(wer);
    return 1;
  }
}

void rose_verschenkt( object who )
{
  SetProp(P_SHORT, "Eine Eisrose von "+TPN);
  RemoveCmd( ({"schenke", "schenk", "verschenke", "verschenk"}) );
  AddCmd( ({"brich", "zerbrich", "breche", "zerbreche"}), "breakup");
  SetProp(P_INFO, "Diese Eisrose wurde Dir von "+TPN+" als "
      "Zeichen "+TPPP(FEMALE, WESSEN, SINGULAR)+" Zuneignung geschenkt. "
      "Du solltest gut auf solch ein Geschenk aufpassen!");
  SetProp(P_NODROP, BS("Du kannst ein Geschenk nicht einfach so hergeben! Wenn "
      "Du die Rose wirklich loshaben willst, musst Du sie schon "
      "zerbrechen ..."));
  SetProp(P_NEVERDROP, 1);
  move(who, M_GET|M_SILENT);
}

breakup( str )
{
  notify_fail("Was willst Du zerbrechen?\n");
  if(id(str)) {
    write(BS("Bist Du sicher, dass Du die Eisrose zerbrechen willst und "
          "somit auch die Verbindung, die dadurch zwischen Dir und "
         +schenker+" entstanden ist, "
         "unterbrechen?"));
    input_to("yesno");
    return 1;
  }
  else
    return 0;
}

yesno( str )
{
  object ob;
  
  if( str == "n" || str == "nein" ) {
    write(BS("Gut, dass Du es Dir nochmal ueberlegt hast. Du haettest "
          +schenker+" bestimmt das Herz damit "
          "gebrochen."));
  }
  else if( str == "j" || str == "ja" ) {
    write(BS("Du brichst die Eisrose entzwei und sie zerfaellt sofort in "
          "viele kleine Splitter, die auf der Stelle in Deinen Haenden "
          "schmelzen. Du betrachtest Deine feuchten Haende und ueberlegst, "
          "ob Du wirklich das Richtige gemacht hast ..."));
    if(ob=find_player(lower_case(schenker))) {
      tell_object(ob, BS(CAP_TPN+" hat gerade Deine Eisrose zerbrochen, die "
        "Du "+TPP(WEM)+" geschenkt hast. Traurig denkst Du nach, was wohl "
        "der Grund dafuer gewesen sein mag ..."));
    }
    remove();
  }
  else {
    write("Bitte gib <ja> oder <nein> ein.\n");
    input_to("yesno");
  }
}
