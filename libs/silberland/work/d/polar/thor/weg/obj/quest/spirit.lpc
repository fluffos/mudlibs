/***************************************
*  Thor@SilberLand                     *
*  Ein magischer Eiszapfen - spirit.c  *
*  Questobjekt fuer die Quest          *
*  Schneemama sucht Schneepapa         *
*  1999-02-28                          *
***************************************/

#include "../../weg.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein magischer Eiszapfen");
  SetProp(P_LONG,
    "Dieser magische Eiszapfen beinhaltet die Seele des Schneepapas, den "
    "die Schneemama schon so sehr vermisst. Du solltest Dich sputen, einen "
    "wunderschoenen Schneemann fuer sie zu bauen und ihn dann mittels dieses "
    "Eiszapfens zum Leben erwecken." );
  SetProp(P_INFO, "Huete diesen Eiszapfen wie Deinen Augapfel! Er wurde "
      "Dir schliesslich von der Schneemama anvertraut, und sie zaehlt auf "
      "Dich.");
  SetProp(P_NAME, "Eiszapfen");
  SetProp(P_NAME_ADJ, "magisch");
  SetProp(P_GENDER, MALE);
  AddId( ({"eiszapfen", "zapfen", "magischer eiszapfen", "\nspirit"}) );

  SetProp(P_MATERIAL, ([MAT_ICE:80, MAT_MISC_MAGIC:20]) );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);
}
