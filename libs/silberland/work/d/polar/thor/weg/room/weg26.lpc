***********************************/

#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Der Weg fuehrt geradewegs von Sueden nach Norden. Weiter im "
           "Sueden siehst Du in einiger Entfernung die felsigen Auslaeufer "
           "der Berge von Kymora und links und rechts von Dir erstreckt "
           "sich nur eine weite, schneebedeckte Ebene. Weiter noerdlich "
           "scheint sich irgend etwas zu befinden, allerdings kannst Du "
           "noch nicht sagen, was es ist."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( "weg",
      "Der Weg ist eigentlich nur festgestampfter Schnee.");
  AddDetail( "schnee",
      "Links und rechts von Dir kannst Du ausser Schnee nichts sehen.");
  AddDetail( "auslaeufer",
      "Die Auslaeufer der Kymora-Berge erstrecken sich in einiger "
      "Entfernung kilometerweit Richtung Sueden.");
  AddDetail( ({"entfernung", "entfernungen"}),
      "Du tust Dir etwas schwer, die Entfernungen hier genau einzuschaetzen.");
  AddDetail( ({"berge", "berg", "kymora", "gebirge", "zug", "gebirgszug"}),
      "Die Berge von Kymora sind ein riesiger Gebirgszug, der den Sueden "
      "der Polarregion beherrscht, und fuer unbezwingbar gilt.");
  AddDetail( ({"polar", "region", "polarregion"}),
      "Du stehst gerade mitten drin.");
  AddDetail( "ebene",
      "Links und rechts von Dir siehst Du nur eintoenigen Schnee. Wie "
      "langweilig.");
  AddDetail( "boden",
      "Der Boden unter Deinen Fuessen besteht aus festgestampftem Schnee.");
  AddDetail( ({"fuss", "fuesse"}),
      "Du stehst mit beiden Beinen fest auf der Erde.");
  AddDetail( ({"beine", "bein"}),
      "Derer hast Du hoffentlich zwei.");
  AddDetail( "erde",
      "Erde findest Du erst, wenn Du Dich hier einige Meter durch die dicke "
      "Schneedecke nach unten durchgegraben hast.");
  AddDetail( ({"decke", "schneedecke"}),
      "Die Schneedecke ist hier ueberall meterdick.");
  AddDetail( "meter",
      "Ein Meter ist mein Meter ist dein Meter ...");
  AddDetail( "himmel",
      "Am Himmel strahlt die Sonne mit ihrem schoensten Laecheln.");
  AddDetail( "sonne",
      "Einige Sonnenstrahlen kitzeln Dir in der Nase.");
  AddDetail( ({"strahlen", "strahl", "sonnenstrahlen", "sonnenstrahl"}),
      "Beinahe musst Du niesen!");
  AddDetail( "nase",
      "Deine Nase fuehlt sich wohl in der Sonne, obwohl sie wegen der "
      "Sonnenstrahlen niesen muss.");
  AddDetail( "laecheln",
      "Leise laechelst Du in Dich hinein ob des schoenen Wetters willen.");
  AddDetail( ({"winterwetter", "wetter"}),
      "Das wunderschoenste Winterwetter, das man sich nur wuenschen kann.");
  AddDetail( "winter",
      "Hier ist immer Winter.");
  AddDetail( ({"irgendetwas", "etwas"}),
      "Du kannst leider noch nichts genaueres erkennen, dafuer bist Du "
      "einfach noch zu weit weg.");
  
  AddSound( DEFAULT_SOUND,
      "Ein leises Lueftchen fluestert Dir ins Ohr.");
  AddSound( "lueftchen",
      "Leider verstehst Du nicht, was es sagt.");
 
  AddExit( "norden", ROOM("weg27"));
  AddExit( "sueden", ROOM("weg25"));
  AddExit( "nordosten", "/d/polar/torian/tierladen/room/vorhof" );
}
