/***********************************
*  Thor@SilberLand                 *
*  Ein Weg durchs Polar - weg11.c  *
*  1999-02-10                      *
***********************************/

#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Der dichte Schneefall vom Pass oben laesst hier wieder nach. "
           "Bis auf ein paar Schneeflocken, die vereinzelt vom Himmel herunter "
           "fallen, ist die Sicht wieder klar. Die Felswaende westlich von "
           "Dir machen langsam wieder dem Meer Platz und Du kannst sogar "
           "wieder einen Weg am Boden erkennen. Oestlich vom Weg, gleich "
           "am Fusse der Felswand, siehst Du eine glatte Rinne, wo der "
           "Schnee fest zusammengedrueckt ist."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( "schneefall",
	    "Der Schneefall laesst hier deutlich nach.");
  AddDetail( "pass",
      "Du bist froh, den Pass hinter Dich gebracht zu haben.");
  AddDetail( ({"schneeflocken", "flocken"}),
      "Einige Schneeflocken tanzen Dir um die Nase herum.");
  AddDetail( "nase",
      "Vielleicht schaffst Du es ja, eine Schneeflocke einzufangen.");
  AddDetail( "himmel",
      "Der Himmel ist von einer dicken, weissen Wolkendecke bedeckt.");
  AddDetail( ({"wolken", "wolke", "decke", "wolkendecke"}),
      "Winterliche, weisse Wolken haengen am Himmel.");
  AddDetail( "winter",
      "Hier herrscht tiefster Winter.");
  AddDetail( "sicht",
      "Du siehst wieder wesentlich weiter als am Pass oben und vor Dir "
      "erstreckt sich ein schoener Ausblick zwischen den Felsen aufs Meer "
      "hinaus.");
  AddDetail( "ausblick",
      "Durch die Felsen kannst Du wieder das Meer sehen.");
  AddDetail( ({"felsen", "felswaende", "klippen", "fels", "waende", "wand",
               "felswand"}),
      "Die Felswaende im Westen weichen wieder den steilen Klippen, die zum "
      "Meer hinabfallen, und die Felswand im Osten weicht auch ein Stueck "
      "zurueck, um einem bequemen Weg Platz zu machen.");
  AddDetail( ({ "stueck" }),
      "Die Felswand im Osten weicht so weit zurueck, damit genug Platz fuer "
      "den Weg da ist." );
  AddDetail( ({"platz", "weg"}),
      "Der Weg ist hier wesentlich breiter, sodass Du keine Angst haben musst, "
      "durch einen falschen Schritt in den Abgrund zu stuerzen.");
  AddDetail( "angst",
      "Du kannst Dich wieder beruhigen.");
  AddDetail( ({"schritt", "schritte"}),
      "Hier darfst Du Dir wieder einige unvorsichtige Schritte erlauben, ohne "
      "gleich mit schlimmen Todesfolgen rechnen zu muessen.");
  AddDetail( ({"folgen,", "todesfolgen"}),
      "Hier im SilberLand gibt es ja gottseidank noch nicht allzu schlimme "
      "Todesfolgen.");
  AddDetail( ({"land", "silberland"}),
      "Du muesstest doch schon einiges kennen davon.");
  AddDetail( "abgrund",
      "Die Klippen fuehren senkrecht bis zum Meer hinab.");
  AddDetail( "meer",
      "Es wird langsam wieder sichtbar zwischen den hohen Felsen.");
  AddDetail( "boden",
      "Der Boden ist von einer dicken Schneeschicht bedeckt.");
  AddDetail( ({"schicht", "schneeschicht"}),
      "Die Schneeschicht hier ist nicht mehr so weich wie die am Pass oben, "
      "sodass Du keine Angst mehr haben musst, ohne Schneeschuhe einzusinken.");
  AddDetail( ({"schuhe", "schneeschuhe"}),
      "Deine Schneeschuhe solltest Du hier wieder gefahrlos ausziehen "
      "koennen.");
  AddDetail( ({"fuss", "fusse"}),
      "Am Fuss der oestlichen Felswand siehst Du eine glatte Rinne im Schnee.");
  AddDetail( "rinne",
      "Die Rinne scheint sehr rutschig zu sein. Du koenntest ja mal "
      "versuchen, Dich reinzusetzen.");
  AddDetail( "schnee",
      "Der Schnee in der Rinne ist fest zusammengepresst.");
  
  AddSound( DEFAULT_SOUND,
      "Ausser dem Heulen des Windes hoerst Du nichts.");
  AddSound( "heulen",
      "HEUUUUUUUUUUUUUL!");
  AddSound( "wind",
      "Der Wind pfeift Dir um die Ohren.");
  AddSound( "pfeifen",
      "Du hoerst nur ein Heulen, kein Pfeifen.");
  
  AddCmd( ({"fange", "fang"}), "flocke");
  AddCmd( ({"setze", "setz", "sitze", "sitz", "rutsche", "rutsch"}), "slide");
  
  AddExit( ({"nordwesten", "nordwestunten"}), ROOM("weg12"));
  AddExit( ({"suedostoben", "suedosten"}), 
      ([EX_TESTFUNC:"exit_so", EX_DEST: ROOM("weg10")]));
  SetProp( P_HIDE_EXITS, ({"nordwesten", "suedosten"}));
}

flocke( str )
{
  notify_fail("Was willst Du fangen?\n");
  if(str=="flocke"||str=="schneeflocke"||str=="schneeflocke ein"||
     str=="flocke ein") {
    write(BS("Geschickt versuchst Du eine der Schneeflocken einzufangen, "
          "die Dir um die Nase taenzeln. Du schaffst es sogar, eine zu "
          "erwischen, doch leider schmilzt sie sofort in Deinen Haenden."));
    say(CAP_TPN+" tanzt zwischen den Schneeflocken herum.\n");
    return 1;
  }
  else
    return 0;
}
  
exit_so()
{
  object ob;
  if(!ob=present("schneeschuhe", TP)) {
    write(BS("Wacker stapfst Du los Richtung Suedosten, jedoch wird der "
          "Schnee immer tiefer und tiefer, sodass Du auf dem steilen Weg "
          "nicht voran kommst. Der Verzweiflung nahe bleibst Du stehen und "
          "gruebelst eine Weile vor Dich hin. Vielleicht hast Du einfach "
          "nicht das passende Schuhwerk dabei?"));
    say(BS(CAP_TPN+" wendet sich nach Suedosten und versucht, den steilen "
          "Weg hinaufzustapfen, kommt aber gegen die riesigen Schneemassen "
          "nicht an gibt nach einer Weile gruebelnd auf."));
    return 0;
  }
  else if(!ob->QueryProp(P_WORN)) {
    write(BS("Du stapfst los Richtung Suedosten, den steilen Weg hinauf, "
          "kommst bei den gewaltigen Schneemassen aber leider nicht "
          "weiter. Vielleicht solltest Du mal Deine Schneeschuhe anziehen?"));
    say(BS(CAP_TPN+" wendet sich nach Suedosten und versucht, den steilen "
          "Weg hinaufzustapfen, kommt aber gegen die riesigen Schneemassen "
          "nicht an gibt nach einer Weile gruebelnd auf."));
    return 0;
  }
  else {
    write(BS("Wacker stapfst Du durch die Schneemassen los nach Nordosten "
          "auf den Pass zu."));
    return 1;
  }
}

slide( str )
{
  notify_fail("Wo willst Du Dich reinsetzen?\n");
  if(str=="in rinne"||str=="rinne"||str=="in schneerinne"||str=="schneerinne"){
    call_other(ROOM("weg12"), "???");
    call_other(ROOM("weg13"), "???");
    call_other(ROOM("weg14"), "???");
    write(BS("Du setzt Dich in die Schneerinne und rutscht los. Die Rinne "
          "ist aeusserst glatt, sodass Du schnell an Geschwindigkeit "
          "gewinnst."));
    if(find_object(ROOM("weg12"))) {
      tell_room(find_object(ROOM("weg12")), CAP_TPN+" rutscht auf dem Po "
          "vorbei.\n", ({}));
    }
    if(find_object(ROOM("weg13"))) {
      tell_room(find_object(ROOM("weg13")), CAP_TPN+" rutscht auf dem Po "
          "vorbei.\n", ({}));
    }
    TP->SetProp(P_PARALYZED, 
        ([PARALYZE_TIME: 8,
          PARALYZE_MSG: "Du rutscht gerade eine Schneerinne hinunter!\n",
          PARALYZE_MSG_OTHER: "",
          PARALYZE_END: "",
          PARALYZE_END_OTHER: ""]));
    call_out("seq1", 2);
    return 1;
  }
  else
    return 0;
}

seq1()
{
  if(!TP)
    return;
  if(environment(TP)!=TO)
    return;
  write("Immer schneller und schneller rutscht Du die Rinne hinunter.\n");
  call_out("seq2", 2);
}

seq2()
{
  if(!TP)
    return;
  if(environment(TP)!=TO)
    return;
  write(BS("In rasendem Tempo rutscht Du weiter und weiter. Nicht weit "
        "entfernt siehst Du den Rand einer Klippe, der sich Dir "
        "besorgniserregend schnell naehert ..."));
  call_out("seq3", 4);
}

seq3()
{
  if(!TP)
    return;
  if(environment(TP)!=TO)
      return;
  if(random(10) > 1) {
    write(BS("Mit voller Wucht landest Du in einer Schneemulde kurz von dem "
          "Rand der Klippen. Uffz, das war knapp. Tief aufatmend stehst Du "
          "wieder auf und klopfst Dir den Schnee aus Deiner Kleidung."));
    TP->move(ROOM("weg14"), M_NOCHECK|M_NO_SHOW, 0, 0, "rutscht auf "
        "dem Po herein");
    }
  else {
    write(BS("WUUUAAAAAH!!! Du bist zu schnell! Du rutscht durch eine "
          "weiche Schneemulde, die Deine Geschwindigkeit ein wenig bremst, "
          "jedoch nicht genug! Der Rand der Klippe kommt viel zu schnell "
          "auf Dich zu und ploetzlich spuerst Du keinen Boden mehr unter "
          "Dir. Du siehst die Wasseroberflaeche des Meeres beaengstigend "
          "schnell auf Dich zukommen und faellst und faellst und faellst ..."));
    tell_room(find_object(ROOM("weg14")), BS(CAP_TPN+" rutscht in "
          "atemberaubender Geschwindigkeit auf auf dem Po herein, schafft es "
          "nicht, vor dem Rand der Klippe noch abzubremsen und stuerzt ins "
          "eiskalte Meer."), ({}));
    call_other(ROOM("weg14"), "player_die");
  }
}
