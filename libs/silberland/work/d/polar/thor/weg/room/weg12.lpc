*  Thor@SilberLand                 *
*  Ein Weg durchs Polar - weg12.c  *
*  1999-02-10                      *
***********************************/

#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Der Weg fuehrt die Klippen entlang von Suedosten "
           "nach Nordwesten. Obwohl es nach Nordwesten hin steil bergab "
           "geht, ist er ohne Schwierigkeiten zu begehen und auch breit genug. "
           "Ein paar Schritte westlich von Dir fallen nun wieder die Klippen "
           "direkt zum Meer hinab. Oestlich von Dir ist immer noch eine steile "
           "Felswand, an deren Fuss eine breite Rinne im Schnee zu sehen "
           "ist."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( "weg",
	    "Der Weg ist bequem zu begehen und auch ausreichend breit.");
  AddDetail( ({"klippe", "klippen"}),
      "Die Felsen westlich von Dir sind verschwunden und Du siehst wieder "
      "nur mehr Klippen senkrecht ins Meer hinabfuehren.");
  AddDetail( ({"schwierigkeiten", "schwierigkeit"}),
      "Du hast keinerlei Schwierigkeiten, dem Weg zu folgen.");
  AddDetail( "schritte",
      "Der Rand der Klippen ist nicht weit entfernt, aber der Vorsprung, auf "
      "dem sich der Weg befindet, sollte breit genug sein, um Dir ein gewisses "
      "Mass an Sicherheit zu garantieren.");
  AddDetail( "sicherheit",
      "Sicherheit ist meist etwas sehr wichtiges fuer jeden.");
  AddDetail( "rand",
      "Lass es trotzdem lieber bleiben, zu nahe an den Rand der Klippen zu "
      "gehen.");
  AddDetail( "vorsprung",
      "Du befindest Dich ein einem breiten Vorsprung der Klippen.");
  AddDetail( "mass",
      "Auch bekannt als eine Einheit, um Bier in Litern zu messen.");
  AddDetail( "einheit",
      "Du bist nun eins mit Dir selbst.");
  AddDetail( "bier",
      "Gelbliches, sprudelndes Getraenk mit Schaum oben drauf.");
  AddDetail( ({"getraenk", "getraenke"}),
      "Getraenke sind meist fluessig.");
  AddDetail( "schaum",
      "Den Schaum kann man vom Bier herunterpusten.");
  AddDetail( "liter",
      "Ein Kubikdezimeter an Fluessigkeit.");
  AddDetail( ({"dezimeter", "kubikdezimeter"}),
      "Auch genannt ein Liter.");
  AddDetail( "fluessigkeit",
      "Sehr fluessig meist ...");
  AddDetail( ({"meer", "polarmeer"}),
      "Westlich von Dir erstreckt sich das kalte Polarmeer.");
  AddDetail( ({"felsen", "fels", "wand", "felswand", "waende",
               "felswaende"}),
      "Nur noch oestlich von Dir ragt eine hohe Felswand in den Himmel.");
  AddDetail( "himmel",
      "Die Wolken am Himmel lichten sich wieder etwas.");
  AddDetail( ({"wolken", "wolke", "wolkendecke", "decke"}),
      "Die Wolkendecke ist nicht mehr ganz so dick wie weiter im Sueden.");
  AddDetail( ({"fuss", "fusse"}),
      "Am Fuss der Felswand ist eine breite Rinne.");
  AddDetail( "rinne",
      "Die Rinne scheint die ganze Wand entlang nach unten zu fuehren.");
  AddDetail( "boden",
      "Ausser Schnee gibts nix am Boden.");
  AddDetail( "schnee",
      "Tonnen von Schnee.");
  AddDetail( ({"tonne", "tonnen"}),
      "Unpackbar viel.");
  
  AddSound( DEFAULT_SOUND,
      "Ausser dem Heulen des Windes hoerst Du nichts.");
  AddSound( "heulen",
      "HEUUUUUUUUUUUUUL!");
  AddSound( "wind",
      "Der Wind pfeift Dir um die Ohren.");
  AddSound( "pfeifen",
      "Du hoerst nur ein Heulen, kein Pfeifen.");
  
  AddCmd( ({"puste", "pust", "blase", "blas"}), "schaum");
  AddCmd( ({"setze", "setz", "sitze", "sitz", "rutsche", "rutsch"}), "slide");
   
  AddExit( ({"nordwestunten", "nordwesten"}), ROOM("weg13"));
  AddExit( ({"suedostoben", "suedosten"}), ROOM("weg11"));
  SetProp( P_HIDE_EXITS, ({"suedosten", "nordwesten"}));
}

schaum( str )
{
  write(BS("Das war doch nur ein Detail, Du Schwammerl! Wo siehst Du hier "
        "denn ein Glas Bier, von dem Du den Schaum pusten koenntest?"));
  return 1;
}

slide( str )
{
  notify_fail("Wo willst Du Dich reinsetzen?\n");
  if(str=="in rinne"||str=="rinne"||str=="in schneerinne"||str=="schneerinne"){
    call_other(ROOM("weg13"), "???");
    call_other(ROOM("weg14"), "???");
    write(BS("Du setzt Dich in die Schneerinne und rutscht los. Die Rinne "
          "ist aeusserst glatt, sodass Du schnell an Geschwindigkeit "
          "gewinnst."));
    if(find_object(ROOM("weg13"))) {
      tell_room(find_object(ROOM("weg13")), CAP_TPN+" rutscht auf dem Po "
          "vorbei.\n", ({}));
    }
    TP->SetProp(P_PARALYZED,
        ([PARALYZE_TIME: 4,
          PARALYZE_MSG: "Du rutscht gerade eine Schneerinne hinunter!\n",
          PARALYZE_MSG_OTHER: "",
          PARALYZE_END: "",
          PARALYZE_END_OTHER: ""]));
    call_out("seq1", 2);
    return 1;
  }
  else
    return 0;
}

seq1()
{
  if(!TP)
    return;
  if(environment(TP)!=TO)
    return;
  write("Immer schneller und schneller rutscht Du die Rinne hinunter.\n");
  call_out("seq2", 2);
}

seq2()
{
  if(!TP)
    return;
  if(environment(TP)!=TO)
    return;
  write(BS("In rasendem Tempo rutscht Du weiter und weiter. Nicht weit "
        "entfernt siehst Du den Rand einer Klippe, der sich Dir "
        "besorgniserregend schnell naehert ..."));
  call_out("seq3", 4);
}

seq3()
{
  if(!TP)
    return;
  if(environment(TP)!=TO)
      return;
  write(BS("Mit voller Wucht landest Du in einer Schneemulde kurz vor dem "
        "Rand der Klippen. Uffz, das war knapp. Tief aufatmend stehst Du "
        "wieder auf und klopfst Dir den Schnee aus Deiner Kleidung."));
  TP->move(ROOM("weg14"), M_NOCHECK|M_NO_SHOW, 0, 0, "rutscht auf "
      "dem Po herein");
}

