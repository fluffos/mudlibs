*  Ein Weg durchs Polar - weg5.c  *
*  1999-02-09                     *
**********************************/

#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Du wanderst den Weg entlang nach Westen durch die letzten "
           "schneebedeckten Huegel durch. Vor Dir eroeffnet sich ein "
           "wunderschoener Ausblick auf das Meer. Die Wolkendecke am "
           "Himmel laesst bei einigen Loechern noch Sonnenstrahlen durch, "
           "welche das Meer zum Funkeln und Glitzern bringen. Einen Moment "
           "lang stehst Du einfach da und betrachtest dieses Schauspiel von "
           "Wolken, Sonne und Wasser und ignorierst den kalten Wind, "
           "der Dir ins Gesicht blaest."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( "weg",
	    "Der Weg fuehrt von Osten nach Nordwesten.");
  AddDetail( "huegel",
      "Die Huegel liegen nun hinter Dir, vor Dir siehst Du nur noch das Meer.");
  AddDetail( "ausblick",
      "Der Ausblick ist wahrlich atemberaubend.");
  AddDetail( "meer",
      "Ein paar Meter vor Deinen Fuessen faellt eine Klippe steil hinab bis "
      "zum Meer. Die Wasseroberflaeche glitzert und funkelt durch die "
      "vereinzelten Sonnenstrahlen, die noch durch die Wolkendecke "
      "durchdringen.");
  AddDetail( "meter",
      "Ein Meter ist ein Meter ist ein Meter ...");
  AddDetail( ({"fuss", "fuesse"}),
      "Nicht weit entfernt von dem Platz, wo Du stehst, fallen die Klippen "
      "steil Richtung Meer hinab.");
  AddDetail( "platz",
      "Na das Fleckerl, wo Du stehst.");
  AddDetail( ({"fleck", "fleckerl"}),
      "Der Ort, wenn Dir das besser gefaellt.");
  AddDetail( "ort",
      "Das hier ist ein wunderschoener Ort, waere da nicht der eisig kalte "
      "Wind.");
  AddDetail( "wind", 
      "Du schaffst es, ihn fuer eine Weile zu ignorieren, um den Anblick, "
      "der sich Dir hier bietet, voll und ganz geniessen zu koennen.");
  AddDetail( "anblick",
      "Der ist wahrlich atemberaubend.");
  AddDetail( ({"klippe", "klippen"}),
      "Geh lieber nicht zu nahe ran, sonst stuerzt Du noch ab!");
  AddDetail( ({"wasser", "oberflaeche", "wasseroberflaeche"}),
      "Das Wasser des Meeres reflektiert das Sonnenlicht und bringt dadurch "
      "die Wasseroberflaeche zum Funkeln.");
  AddDetail( "sonne",
      "Die Sonne schafft es noch, an eine paar Stellen die Wolkendecke zu "
      "durchdringen.");
  AddDetail( ({"wolken", "wolke", "decke", "wolkendecke", "himmel"}),
      "Die Wolkendecke am Himmel laesst an einigen Stellen noch die Sonne "
      "durchscheinen.");
  AddDetail( ({"strahlen", "sonnenstrahlen", "licht", "sonnenlicht"}),
      "Die duennen Sonnenstrahlen, die durch die Wolkendecke noch "
      "durchscheinen, erscheinen fast wie die Finger Gottes ...");
  AddDetail( "gott",
      "Woody und Dusty natuerlich.");
  AddDetail( ({"woody", "dusty"}),
      "Ich hoffe, Du bist glaeubig.");
  AddDetail( "finger",
      "Lange, leuchtende Finger, die auf das Meer zeigen.");
  AddDetail( ({"loecher", "stellen"}),
      "An einigen Stellen ist die Wolkendecke noch nicht ganz so dicht und "
      "weist noch einige Loecher auf.");
  AddDetail( ({"funkeln", "glitzern"}),
      "Das Glitzern der Wasseroberflaeche blendet ein wenig in Deinen Augen.");
  AddDetail( ({"augen", "auge"}),
      "Deine Augen wollen sich nicht sattsehen am Anblick des unendlichen "
      "Meeres.");
  AddDetail( ({"schauspiel", "spiel"}),
      "Das Schauspiel der Natur ist unuebertrefflich.");
  AddDetail( "natur",
      "Auch diese unfreundliche Gegend hier ist ein Werk der Natur.");
  AddDetail( "gegend",
      "Sieh Dich ruhig etwas genauer um.");
  AddDetail( "werk",
      "Nichts anderes wuerde etwas derartiges fertigbringen.");
  AddDetail( "boden",
      "Der Boden ist von einer dicken Schneeschicht bedeckt.");
  AddDetail( ({"schnee", "schicht", "schneeschicht", "eis"}),
      "Schnee und Eis gibt es hier in rauhen Mengen.");
  AddDetail( ({"menge", "mengen"}),
      "Naja, reichlich davon halt.");
  AddDetail( "gesicht",
      "Im Augenblick ist Dir Dein kaltgefrorenes Gesicht egal.");
  AddDetail( ({"augenblick", "moment"}),
      "Du haeltst einen Moment inne ...");
  
  AddSound( DEFAULT_SOUND,
      "Ausser dem Heulen des Windes hoerst Du nichts.");
  AddSound( "heulen",
      "HEUUUUUUUUUUUUUL!");
  AddSound( "wind",
      "Der Wind pfeift Dir um die Ohren.");
  AddSound( "pfeifen",
      "Du hoerst nur ein Heulen, kein Pfeifen.");
  
  AddExit( "nordwesten", ROOM("weg6"));
  AddExit( "osten", ROOM("weg4"));
}
