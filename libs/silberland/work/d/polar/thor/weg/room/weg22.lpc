#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Der Weg geht hier leicht bergauf, auf eine etwas hoehere "
           "Huegelkuppe im Nordosten zu. Von dort oben hast Du sicher eine "
           "recht gute Aussicht ueber die umliegende Gegend und Du siehst "
           "vielleicht mal etwas mehr als nur die endlosen, schneebedeckten "
           "Huegel um Dich herum. Das kann ja wohl hoffentlich nicht ewig so "
           "langweilig weitergehen hier."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( "weg",
	    "Der Weg fuehrt von Suedwesten nach Nordosten. Richtung Nordosten "
      "fuehrt er leicht bergauf auf einen etwas groesseren Huegel.");
  AddDetail( "huegel",
      "Ueberall siehst Du nur Huegel, Huegel und nochmal Huegel. Vor Dir "
      "ist ein etwas groesserer Huegel, auf den der Weg hinauffuehrt.");
  AddDetail( "schnee",
      "Von den vielen Huegeln abgesehen siehst Du hier ausserdem noch "
      "Schnee, Schnee und nochmal Schnee.");
  AddDetail( ({"kuppe", "huegelkuppe"}),
      "Der Weg fuehrt direkt zu einer Huegelkuppe hinauf.");
  AddDetail( "aussicht",
      "Weiter oben muesste sie besser sein.");
  AddSpecialDetail( "gegend", "unt_gegend");
  AddSpecialDetail( ({"hobbit", "hobbits"}), "unt_hobbit");
  AddDetail( ({"kerle", "kerl"}),
      "Natuerlich sind auch Damen dabei.");
  AddDetail( ({"damen", "dame"}),
      "Na weibliche Hobbits halt.");
  AddDetail( ({"zuhause", "hause", "zu hause"}),
      "Tja, Dein Zuhause ist leider weit, weit weg.");
  AddDetail( "boden",
      "Der Boden besteht immer noch aus festgestampftem Schnee.");
  AddDetail( ({"himmel", "sonne"}),
      "Auch vom Himmel scheint nach wie vor freundlich die Sonne herab.");
        
  AddSound( DEFAULT_SOUND,
      "Ein sanftes Lueftchen fluestert Dir leise etwas ins Ohr.");
  AddSound( ({"fluestern", "lueftchen"}),
      "Leider verstehst Du nicht, was es sagt.");
  
  AddExit( ({"nordosten", "nordostoben"}), ROOM("weg23"));
  AddExit( "suedwesten", ROOM("weg21"));
  SetProp(P_HIDE_EXITS, ({"nordosten"}));
}

string unt_gegend()
{
  if(TP->QueryProp(P_RACE)=="Hobbit")
    return BS("Du fuehlst Dich so richtig wohl hier in dieser huegeligen "
        "Gegend.");
  else
    return BS("Hier muessten sich Hobbits ja fast wie zu Hause fuehlen bei den "
        "vielen Huegeln.");
}

string unt_hobbit()
{
  if(TP->QueryProp(P_RACE)=="Hobbit")
    return "Das bist Du!\n";
  else
    return "Nette Kerle, diese Hobbits ...\n";
}
