*******************************************/

#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine verschneite Lichtung" );
  SetProp( P_INT_LONG,
           "Du stehst auf einer kleinen Lichtung und steckst bis zu den "
           "Knien im tiefen Neuschnee. Auch die Nadelbaeume am Rand der "
           "Lichtung aechzen unter den Schneemassen. Obwohl die Sonne vom "
           "Himmel scheint ist die Lichtung ziemlich schattig wegen der "
           "grossen Baeume rundherum.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( "lichtung",
      "Die Lichtung wuerde einen richtig romantischen Eindruck machen, "
      "waere es bloss nicht so kalt.");
  AddDetail( "rand",
      "Der Rand der Lichtung ist durch Baeume gekennzeichnet, wie sollte "
      "es bei einer Lichtung auch anders sein?");
  AddDetail( "schatten",
      "Die grossen Baeume werfen lange Schatten.");
  AddDetail( ({"eindruck", "eindruecke"}),
      "Lass Dich bloss nicht zu oft von gewissen Eindruecken taeuschen.");
  AddDetail( "boden",
      "Der Boden ist mit einer dicken Decke Neuschnee bedeckt.");
  AddDetail( ({"schnee", "neuschnee", "decke", "schneedecke", "pulverschnee"}),
      "Frischer Neuschnee, der Dir durch die Finger rieselt, wenn Du ihn "
      "angreifst.");
  AddDetail( ({"massen", "schneemassen", "masse", "schneemasse"}),
      "Ja, hier liegt reichlich Schnee.");
  AddDetail( "finger",
      "Er ist kein bisschen klebrig, der Schnee.");
  AddDetail( ({"knie", "kniee"}),
      "Denen ist schon etwas kalt.");
  AddDetail( ({"baeume", "nadelbaeume"}),
      "Einige Tannen und Fichten wachsen hier.");
  AddDetail( ({"tannen", "fichten", "tanne", "fichte"}),
      "Diese Baeume ueberleben sogar im Polar.");
  AddDetail( "polar",
      "Du stehst mitten drin.");
  AddDetail( "last",
      "Die meisten Aeste haengen herab, wegen der grossen Last des Schnees.");
  AddDetail( "aeste",
      "Irgendwann wird es ihnen schon wieder gelingen, den Schnee "
      "abzuschuetteln.");
  AddDetail( "himmel",
      "Die Sonne laechelt vom Himmel.");
  AddDetail( "sonne",
      "Sie grinst Dich foermlich an.");
  
  AddSound( DEFAULT_SOUND,
      "Du hoerst ein leises Rascheln von den Baeumen her.");
  AddSound( "rascheln",
      "Vermutlich nur etwas Kleingetier.");
  AddSound( ({"getier", "kleingetier"}),
      "Es raschelt im Unterholz.");
  
  AddCmd( ({"greif", "greife", "beruehr", "beruehre"}), "schnee");
  
  AddExit( "sueden", ROOM("lichtung1"));
  AddExit( "osten", ROOM("lichtung4"));
  AddExit( "westen", ROOM("lichtung2"));
}

schnee( str )
{
  notify_fail("Was willst Du angreifen?\n");
  if(str=="in schnee"||str=="schnee"||str=="schnee an"||str=="in neuschnee"||
     str=="neuschnee"||str=="neuschnee an") {
    write(BS("Du greifst in den Neuschnee und laesst ihn Dir durch die Finger "
          "rieseln. Er ist kein bisschen, ein perfekter Pulverschnee."));
    say(CAP_TPN+" laesst sich etwas Schnee durch die Finger rieseln.\n");
    return 1;
  }
  else
    return 0;
}
