inherit "std/virtual/v_compiler";

#include "../weg.h"

#include <properties.h>
#include <v_compiler.h>
#include <wizlevels.h>

#define P_ROOMS "valid_name"

create()
{
  ::create();
  SetProp(P_COMPILER_PATH, ROOM("") );
  SetProp(P_STD_OBJECT, ROOM("lab"));
  SetProp(P_ROOMS, ({ "lab", "lab_monster" }) );
}

string Validate(string file)
{
  string path, name, who;

  file = ::Validate(file);
  if ((sscanf(file, "%s:%s", name, who) == 2) &&
      (member(QueryProp(P_ROOMS), name) != -1))
  {
    SetProp(P_STD_OBJECT, ROOM(name));
    return file;
  }
}

int CustomizeObject()
{
  string name,raum,who;

  if (!(name = ::CustomizeObject()) || sscanf(name,"%s:%s",raum,who)!=2)
    return 0;

  return 1;
}
