*  Thor@SilberLand                 *
*  Ein Weg durchs Polar - weg23.c  *
*  1999-02-21                      *
***********************************/

#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Du stehst auf der Kuppe von einem etwas hoeheren Huegel. Die "
           "Aussicht ist zwar nicht gerade ueberragend, aber man sieht doch "
           "deutlich mehr als von weiter unten. Nach Nordwesten hin kannst "
           "Du ausser einigen schneebedeckten Nadelbaeumen nicht viel "
           "erkennen, im Sueden siehst Du die felsigen Auslaeufer der Berge "
           "von Kymora und im Norden scheint eine Ansammlung kleiner Bauwerke "
           "zu sein. Richtung Osten hin erstrecken sich nur endlose Huegel.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( ({"kuppe", "huegelkuppe"}),
	    "Von der Huegelkuppe hier ist die Aussicht nichtmal so schlecht.");
  AddDetail( "huegel",
      "Den hast Du tapferst erklommen.");
  AddDetail( "aussicht",
      "Geniesse sie ruhig.");
  AddDetail( ({"baeume", "nadelbaeume", "baum", "nadelbaum"}),
      "Der Huegel hier ist leider nicht so hoch, dass Du ueber die Nadelbaeume "
      "drueber sehen koenntest, daher weisst Du nicht, was sich dahinter "
      "verbirgt.");
  AddDetail( ({"auslaeufer", "berge", "berg", "kymora", "gebirge",
               "gebirgszug", "gebirgsmassiv", "massiv", "zug"}),
      "Die Berge von Kymora sind ein maechtiges Gebirgsmassiv, welches "
      "den Sueden des Polars dominiert. Du kannst von hier aus einige "
      "der hohen Gipfel des Gebirgszuges erkennen.");
  AddDetail( "gipfel",
      "Die Gipfel der Berge von Kymora scheinen doch sehr hoch zu sein. "
      "Ehrfuerchtig betrachtest Du sie.");
  AddDetail( "polar",
      "Du bist hier mitten im Polar.");
  AddDetail( "ansammlung",
      "Man koennte auch sagen, ein Dorf.");
  AddDetail( "dorf",
      "Hm, ob das wirklich ein Dorf ist, hier in dieser kalten Einoede? Du "
      "bist Dir nicht ganz sicher, ob Dir da Deine Augen vielleicht einen "
      "Streich spielen.");
  AddDetail( "streich",
      "Das machen sie leider oefters ...");
  AddDetail( ({"auge", "aug", "augen"}),
      "Es waere nicht das erste mal, dass Dir Deine Augen einen Streich "
      "spielen.");
  AddDetail( ({"oede", "einoede"}),
      "Ja, eine sehr unwirtliche Gegend ist das hier.");
  AddDetail( "gegend",
      "Sieh Dich ruhig genauer um.");
  AddDetail( ({"bauwerke", "bauwerk", "werke", "werk"}),
      "Die Bauwerke sind alle ziemlich niedrig, rund, und scheinen aus "
      "Schnee oder Eis zu bestehen.");
  AddDetail( ({"schnee", "eis"}),
      "Davon gibt es hier ueberall reichlich.");
  AddDetail( "boden",
      "Der Boden besteht aus festgestampftem Schnee.");
  AddDetail( ({"himmel", "sonne"}),
      "Unermuedlich strahlt die Sonne vom Himmel.");
  AddSound( DEFAULT_SOUND,
      "Ein sanftes Lueftchen fluestert Dir etwas ins Ohr.");
  AddSound( ({"fluestern", "lueftchen"}),
      "Es ist nur ein ganz leises Wispern ...");
  AddSound( "wispern",
      "Vielleicht kannst Du etwas genaueres hoeren, wenn Du nur ganz "
      "angestrengt lauscht.");
  AddSound( ({"angestrengt", "ganz angestrengt"}),
      "Du meinst, das Fluestern einer menschlichen Stimme zu vernehmen.");
  AddSound( "stimme",
      "Beinahe glaubst Du, einige Worte zu hoeren.");
  AddSound( ({"worte", "woerter"}),
      "Kymora toetet wieder! Halte Dich von Kymora fern! Qualen, Verderben "
      "und Tod wird er ueber alle bringen! Kymora! Wer wird ihm Einhalt "
      "gebieten?");

  AddCmd( ({"geniesse", "geniess"}), "aussicht");
  
  AddExit( ({"osten", "ostunten"}), ROOM("weg24"));
  AddExit( ({"suedwesten", "suedwestunten"}), ROOM("weg22"));
  SetProp(P_HIDE_EXITS, ({"osten", "suedwesten"}));
}

aussicht( str )
{
  notify_fail("Was willst Du geniessen?\n");
  if(str=="aussicht") {
    write(BS("Du laesst Deinen Blick ueber die Landschaft schweifen und "
          "geniesst die Aussicht in vollen Zuegen. Trotz der Kaelte kannst "
          "Du nicht abstreiten, dass dies hier eine wunderschoene Gegend "
          "ist."));
    say(CAP_TPN+" geniesst die Aussicht.\n");
    return 1;
  }
  else
    return 0;
}
