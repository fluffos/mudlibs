#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Der Weg fuehrt weiter durch die eintoenige Landschaft "
           "von Suedosten nach Nordwesten. Der kalte Wind pfeift Dir "
           "um die Ohren und laesst dich schaudern, und am Himmel "
           "siehst Du vereinzelt einige dunkle Wolken."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: 0]) );

  AddDetail( ({"weg", "pfad"}),
	    "Der Weg fuehrt von Suedosten nach Nordwesten.");
  AddDetail( ({"landschaft", "gegend"}),
      "Die Gegend hier ist ziemlich unfreundlich. Kalt, windig, so richtig "
      "waeh.");
  AddDetail( "wind",
      "Der Wind blaest Dir heftig ins Gesicht und laesst Deine Ohren fast "
      "abfrieren.");
  AddDetail( "gesicht",
      "Dein Gesicht ist schon ganz blau gefroren.");
  AddDetail( ({"ohren", "ohr"}),
      "Vielleicht solltest Du Deine Ohren einmal etwas waermen, sonst fallen "
      "sie Dir am Ende wirklich noch ab.");
  AddDetail( "ende",
      "Dein Ende ist hoffentlich noch fern.");
  AddDetail( "himmel",
      "Am Himmel treiben einige dunkle Wolken dahin.");
  AddDetail( ({"wolken", "wolke"}),
      "Die sind bestimmt kein gutes Zeichen.");
  AddDetail( "zeichen",
      "Bist Du aberglaeubisch?");
  AddDetail( "boden",
      "Du stehst auf einer dicken Schneeschicht.");
  AddDetail( ({"schicht", "schneeschicht"}),
      "Kein gruenes Pflaenzchen zu entdecken.");
  AddDetail( ({"pflanze", "pflaenzchen"}),
      "Nichtmal ein braunes Pflaenzchen ist zu sehen.");
  AddDetail( "schnee",
      "Schneeweisser Schnee.");
  AddDetail( "eis",
      "Davon gibts hier oben reichlich.");
  
  AddSound( DEFAULT_SOUND,
      "Ausser dem Heulen des Windes hoerst Du nichts.");
  AddSound( "heulen",
      "HEUUUUUUUUUUUUUL!");
  AddSound( "wind",
      "Der Wind pfeift Dir um die Ohren.");
  AddSound( "pfeifen",
      "Du hoerst nur ein Heulen, kein Pfeifen.");
 
  AddCmd( ({"waerme", "waerm"}), "ears");
  
  AddExit( "nordwesten", ROOM("weg3"));
  AddExit( "suedosten", ROOM("weg1"));
}

ears( str )
{
  notify_fail("Was willst Du waermen?\n");
  if( str == "ohren" || str == "ohr" ) {
    write(BS("Du legst Deine Haende auf Deine Ohren und beginnst heftig "
          "zu rubbeln. Aaaaah, das tut gut."));
    say(BS(CAP_TPN+" legt "+TPPP(FEMALE, WEN, PLURAL)+" Haende auf "
          +TPPP(NEUTER, WEN, PLURAL)+" Ohren und "
          "beginnt heftig zu rubbeln. Erleichtert hoert "+TPP(WER)+" auf "
          "und schmunzelnd betrachtest Du "+TPPP(NEUTER, WEN, PLURAL)
          +" knallroten Ohren."));
    return 1;
  }
  if ( str == "gesicht" || str == "wange" || str == "wangen" ) {
    write(BS("Du legst Deine Haende auf Deine Wangen und rubbelst lange "
          "daran. Du fuehlst, wie Dich wieder ein bisschen Waerme "
          "erfuellt."));
    say(BS(CAP_TPN+" legt "+TPPP(FEMALE, WEN, PLURAL)+" Haende auf "
          +TPPP(FEMALE, WEN, PLURAL)+" Wangen und beginnt diese zu "
          "rubbeln. Als "+TPP(WER)+" damit aufhoert, siehst Du wie "
          +TPP(WER)+" knallrote Baeckchen hat."));
    return -1;
  }
  else
    return 0;
}
