***********************************/

#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Das Rauschen des Meeres westlich von Dir wird zunehmens leiser. "
           "Auch der Wind ist zu einem schwachen Lueftchen abgeflaut und "
           "am Himmel sind nur noch vereinzelt Wolken zu sehen. An der "
           "Felswand suedlich von Dir sind einige gefrorene Wasserrinnsale, "
           "die am Fuss der Wand auch den Weg etwas vereist haben."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( "rauschen",
	    "Versuchs lieber mal mit lauschen.");
  AddDetail( "meer",
      "Das Meer ist in einiger Entfernung in westlicher Richtung.");
  AddDetail( ({"entfernung", "entfernungen"}),
      "Entfernungen sind oft schwer abschaetzbar.");
  AddDetail( "wind",
      "Der beissend scharfe Wind, der auf den Klippen an Dir zehrte, hat "
      "hier nachgelassen.");
  AddDetail( ({"klippen", "klippe"}),
      "Du bist froh, die Klippen hinter Dich gebracht zu haben. Ausser Du "
      "gehst von Osten nach Westen, dann stehen sie Dir noch bevor.");
  AddDetail( ({"luft", "lueftchen"}),
      "Ein leichtes Lueftchen weht hier nur noch.");
  AddDetail( ({"himmel", "blau"}),
      "Das strahlende Blau des Himmels wird nur noch vereinzelt von einigen "
      "Wolken gestoert.");
  AddDetail( ({"wolken", "wolke"}),
      "Kaum eine Wolke mehr zu sehen.");
  AddDetail( ({"wand", "felswand"}),
      "Einige gefrorene Rinnsale laufen die Felswand entlang herunter.");
  AddDetail( ({"rinnsale", "rinnsal", "wasserrinnsale", "wasserrinnsal"}),
      "Die Rinnsale sind gefroren, allerdings scheint es hier nicht immer "
      "ganz so kalt zu sein, denn sonst waere hier wohl noch nie Wasser "
      "geflossen.");
  AddDetail( "wasser",
      "Alles Wasser, was Du hier siehst, ist zu Eis gefroren.");
  AddDetail( ({"eis", "boden"}),
      "Der Boden ist ziemlich vereist, also pass lieber auf, dass Du nicht "
      "hinfaellst.");
  AddDetail( "weg",
      "Der Weg ist ziemlich rutschig hier.");
  AddDetail( ({"fuss", "fusse"}),
      "Der Fuss der Felswand ist ziemlich vereist.");
  
  
  AddSound( DEFAULT_SOUND,
      "Du hoerst das ferne Rauschen des Meeres.");
  AddSound( ({"rauschen", "meeresrauschen"}),
      "Das Meeresrauschen wirkt irgendwie beruhigend.");
  
  AddExit( "osten", ROOM("weg17"));
  AddExit( "suedwesten", ROOM("weg15"));
}

