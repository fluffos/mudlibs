***********************************/

#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Die Huegel werden hier zunehmends flacher, mit Ausnahme des "
           "einen groesseren Huegels, auf den der Weg im Westen hinauf "
           "fuehrt. Die Auslaeufer der Berge von Kymora suedlich von Dir "
           "sind noch von einigen hohen Felsen durchsetzt, aber ansonsten "
           "truebt kein Fleck die glatte, weisse, schneebedeckte Ebene."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( "weg",
	    "Der Weg fuehrt nach Westen auf einen Huegel hinauf.");
  AddDetail( "huegel",
      "Westlich von Dir ist ein etwas groesserer Huegel, von dem man sicher "
      "eine ganz passable Aussicht hat.");
  AddDetail( "aussicht",
      "Dazu muesstest Du schon auf den Huegel raufgehen.");
  AddDetail( "ausnahme",
      "Bis auf den einen grossen Huegel im Westen siehst Du nur noch einige "
      "eher flache Erhebungen.");
  AddDetail( ({"erhebung", "erhebungen"}),
      "Huegelchen waere wohl treffender.");
  AddDetail( "huegelchen",
      "Wie gesagt, kleine Erhebungen.");
  AddDetail( ({"auslaeufer", "berge", "berg", "gebirge", "kymora"}),
      "Die Berge von Kymora erstrecken sich im Sueden der Polarregion.");
  AddDetail( ({"region", "polar", "polarregion"}),
      "Du stehst mitten drin.");
  AddDetail( ({"felsen", "fels"}),
      "Weiter im Sueden ist es noch ein wenig felsig, ansonsten siehst Du "
      "hier ueberall nur Schnee.");
  AddDetail( "fleck",
      "Kein einziger Fleck ist auf der blendend weissen Schneedecke zu sehen.");
  AddDetail( ({"decke", "schneedecke"}),
      "Eine dicke Schneedecke bedeckt das ganze Land.");
  AddDetail( "land",
      "Man koennte es auch das weisse Land nennen.");
  AddDetail( "ebene",
      "Ok, die Ebene ist noch von einigen Huegelchen durchsetzt.");
  AddDetail( "boden",
      "Der Boden besteht aus festgestampftem Schnee.");
  AddDetail( ({"himmel", "sonne"}),
      "Die Sonne lacht vom Himmel.");
  AddDetail( ({"eis", "schnee"}), 
      "Davon gibt es hier unendlich viel.");
  
  AddSound( DEFAULT_SOUND,
      "Ein sanftes Lueftchen fluestert Dir ins Ohr.");
  AddSound( ({"lueftchen", "fluestern"}),
      "Leider verstehst Du nicht, was es sagt.");
  
  AddExit( "nordosten", ROOM("weg25"));
  AddExit( ({"westen", "westoben"}), ROOM("weg23"));
  SetProp(P_HIDE_EXITS, ({"westen"}));
}

