*  Thor@SilberLand                 *
*  Ein Weg durchs Polar - weg26.c  *
*  1999-02-12                      *
***********************************/

#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Neugierig kuckst Du nach Norden, wo Du das Ende des Weges vor "
           "dem Eingangstor einer Palisade erkennen kannst. Hinter dem "
           "Tor siehst Du einige Bauwerke, die scheinbar aus Schnee oder "
           "Eis gebaut wurden. Weit entfernt im Sueden siehst Du nur noch "
           "andeutungshalber die Auslaeufer der Berge von Kymora und zu "
           "Deiner Linken und Rechten erstreckt sich eine elends weite, "
           "oede, schneebedeckte Ebene.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( "weg",
      "Der Weg scheint noerdlich von Dir endlich ein Ende zu haben.");
  AddDetail( "ende",
      "Du hast schon befuerchtet, das wuerde ueberhaupt nie kommen.");
  AddDetail( "schnee",
      "Links und rechts von Dir kannst Du ausser Schnee nichts sehen.");
  AddDetail( "auslaeufer",
      "Weit weg im Sueden erkennst Du die Auslaeufer der Berge von Kymora, "
      "welche sich kilometerweit Richtung Sueden erstrecken.");
  AddDetail( ({"berge", "berg", "kymora", "gebirge", "zug", "gebirgszug"}),
      "Die Berge von Kymora sind ein riesiger Gebirgszug, der den Sueden "
      "der Polarregion beherrscht, und fuer unbezwingbar gilt.");
  AddDetail( ({"polar", "region", "polarregion"}),
      "Du stehst gerade mitten drin.");
  AddDetail( "ebene",
      "Links und rechts von Dir siehst Du nur eintoenigen Schnee. Wie "
      "langweilig. Du gaehnst.");
  AddDetail( "boden",
      "Der Boden unter Deinen Fuessen besteht aus festgestampftem Schnee.");
  AddDetail( ({"fuss", "fuesse"}),
      "Du stehst mit beiden Beinen fest auf der Erde.");
  AddDetail( ({"beine", "bein"}),
      "Derer hast Du hoffentlich zwei.");
  AddDetail( "erde",
      "Die Erde versteckt sich hier unter einer meterdicken Schneedecke.");
  AddDetail( ({"decke", "schneedecke"}),
      "Die Schneedecke ist hier ueberall meterdick.");
  AddDetail( "meter",
      "Ein Meter ist mein Meter ist dein Meter ...");
  AddDetail( "himmel",
      "Am Himmel strahlt die Sonne mit ihrem schoensten Laecheln.");
  AddDetail( "sonne",
      "Einige Sonnenstrahlen kitzeln Dir in der Nase.");
  AddDetail( ({"strahlen", "strahl", "sonnenstrahlen", "sonnenstrahl"}),
      "Beinahe musst Du niesen!");
  AddDetail( "nase",
      "Du bist eine alte Neugiernase!");
  AddDetail( "neugiernase",
      "Sagte ich doch!");
  AddDetail( "laecheln",
      "Leise laechelst Du in Dich hinein ob des schoenen Wetters willen.");
  AddDetail( ({"winterwetter", "wetter"}),
      "Das wunderschoenste Winterwetter, das man sich nur wuenschen kann.");
  AddDetail( "winter",
      "Hier ist immer Winter.");
  AddDetail( ({"bauwerke", "bauwerk"}),
      "Die Bauwerke sind rund und kuppelfoermig und scheinen vollkommen aus "
      "Eis und Schnee zu bestehen.");
  AddDetail( "palisade",
      "Die Palisade erstreckt sich von Westen nach Osten.");
  AddDetail( ({"tor", "eingangstor"}),
      "Geh doch einfach einmal hin!");
  AddDetail( "eis",
      "An Eis mangelt es hier im hohen Norden bestimmt nicht.");
  AddDetail( "linke",
      "Fasziniert betrachtest Du Deine linke Hand.");
  AddDetail( "rechte",
      "Fasziniert betrachtest Du Deine rechte Hand.");
  AddDetail( ({"hand", "haende"}),
      "Du solltest zwei davon haben, ausser es hat Dir jemand eine "
      "abgehackt, weil Du Deine Haende immer in Sachen steckst, die Dich "
      "nichts angehen. Oh, hoppla, das ist ja normalerweise die Nase.");
  AddDetail( ({"sachen", "sache"}),
      "Na Sachen eben!");
  
  AddSound( DEFAULT_SOUND,
      "Ein leises Lueftchen fluestert Dir ins Ohr.");
  AddSound( "lueftchen",
      "Leider verstehst Du nicht, was es sagt.");
 
  AddExit( "norden", DORF("suedtor"));
  AddExit( "sueden", ROOM("weg27"));
}
