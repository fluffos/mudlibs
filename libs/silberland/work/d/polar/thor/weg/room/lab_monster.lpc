#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im verschneiten Unterholz" );
  SetProp( P_INT_LONG,
      "Du steckst bis zu den Knien im Schnee. Ausser dem dichten "
      "Unterholz um Dich herum kannst Du eigentlich gar nichts erkennen. "
      "Auf den ersten Blick entdeckst Du nicht die kleinste Luecke "
      "im Unterholz.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: -10]) );
  SetProp( P_NO_TPORT, NO_TPORT_OUT); 

  AddDetail( ({"knie", "kniee"}),
      "Deinen Knien ist schon ziemlich kalt.");
  AddDetail( ({"schnee", "neuschnee"}),
      "In selbigem steckst Du bist zu den Knien.");
  AddDetail( ({"holz", "unterholz"}),
      "Das Unterholz ist dicht verwachsen, Du kannst keinen Durchlass "
      "entdecken.");
  AddDetail( "blick",
      "Auch auf den zweiten Blick findest Du nichts.");
  AddDetail( ({"durchlass", "luecke", "loch"}),
      "Vielleicht solltest Du einfach auf gut Glueck versuchen, in eine "
      "Richtung zu gehen.");
  AddDetail( "glueck",
      "Hoffentlich ist es Dir hold.");
  AddDetail( "boden",
      "Der Boden ist mit reichlich Neuschnee bedeckt.");
  AddDetail( "himmel",
      "Das bisschen, was Du vom Himmel durch das Unterholz hindurch siehst, "
      "sind einige Wolken.");
  AddDetail( ({"wolken", "wolke"}),
      "Sehnsuechtig blickst Du gen Himmel.");

  AddSound( DEFAULT_SOUND,
     "Stille.");

  AddItem( NPC("schneegeist"), REFRESH_DESTRUCT);
  
  AddExit( ({"norden", "nordosten", "osten", "suedosten",
             "sueden", "suedwesten", "westen", "nordwesten"}),
           ([EX_FUNC:"raus_hier"]));
  SetProp(P_HIDE_EXITS, ({"norden", "nordosten", "osten", "suedosten",
                          "sueden", "suedwesten", "westen", "nordwesten"}));

  previous_object()->CustomizeObject();
}

