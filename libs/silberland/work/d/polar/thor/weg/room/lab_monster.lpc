mixed raus_hier(string wohin)
{
  if( (TP->QueryProp(P_NEXT_EXIT) >= sizeof(LABMASTER->CheckExits(getuid(TP))))
      && wohin=="sueden") {
    LABMASTER->DeleteExits(getuid(TP));
    return ROOM("lichtung2");
  }
    
  else if(
  (TP->QueryProp(P_NEXT_EXIT) < sizeof(LABMASTER->CheckExits(getuid(TP)))) &&
  (wohin==LABMASTER->CheckNextExit(getuid(TP), TP->QueryProp(P_NEXT_EXIT))) ) {
    TP->SetProp(P_NEXT_EXIT, TP->QueryProp(P_NEXT_EXIT)+1);
    return ROOM("lab:"+getuid(TP));
  }
   
  write(BS("Du wendest Dich Richtung "+capitalize(wohin)+", kommst jedoch "
        "nicht durch das Unterholz durch."));
  return 1;
}
