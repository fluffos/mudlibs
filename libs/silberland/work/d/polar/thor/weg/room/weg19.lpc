***********************************/

#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int zapfen=2+random(3);

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Der Weg macht hier einen leichten Knick von Westen nach "
           "Nordosten, weiter ins Landesinnere. Auch die Felswand wird "
           "niedriger und ist nicht mehr ganz so steil. Einige lange "
           "Eiszapfen wachsen noch daran herab, ansonsten ist es nur noch "
           "ein etwas groesserer Felsen."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( "weg",
      "Der fuehrt von Westen nach Nordosten.");
  AddDetail( "knick",
      "In etwa so:\n\n"
      "         /   \n"
      "        /    \n"
      "_______/     \n\n");
  AddDetail( ({"innere", "inneres", "landesinnere", "landesinneres"}),
      "Der Weg fuehrt weg von den Kymora Bergen, weiter ins Landesinnere im "
      "Norden.");
  AddDetail( ({"berge", "berg", "gebirge", "gebirgszug", "zug", "kymora"}),
      "Die Berge von Kymora beherrschen den Sueden der Polarregion.");
  AddDetail( ({"polar", "region", "polarregion"}),
      "Du stehst mitten drin.");
  AddDetail( ({"felswand", "wand"}),
      "Die Felswand ist nur noch ein groesserer Felsen.");
  AddDetail( ({"fels", "felsen"}),
      "Der Felsen sieht gar nicht mehr so gross, schroff und beeindruckend "
      "aus.");
  AddDetail( ({"zapfen", "eiszapfen"}),
      "Du kannst nichts Besonderes an den Eiszapfen erkennen.");
  AddDetail( "besonderes",
      "Hoppla, Moment! Einer der Eiszapfen sieht etwas abgenuckelt aus.");
  AddDetail( "moment",
      "Man sollte sich immer genuegend Zeit zum Untersuchen der Details "
      "nehmen ;)");
  AddDetail( "zeit",
      "Die wird Dir schon nicht davon laufen.");
  AddDetail( "untersuchen",
      "Ok, man kanns auch uebertreiben ...");
  AddDetail( ({"detail", "details"}),
      "Ja, ich muss sagen, Du bist sehr gruendlich.");
  AddDetail( "boden",
      "Ausser Schnee siehst Du nichts am Boden.");
  AddDetail( "schnee",
      "Davon gibts hier reichlich.");
  AddDetail( ({"himmel", "sonne"}),
      "Die Sonne lacht vom strahlend blauen Himmel herunter.");
  
  AddSound( DEFAULT_SOUND,
      "Ein sanftes Lueftchen fluestert Dir leise ins Ohr.");
  AddSound( "lueftchen",
      "Leider verstehst Du nicht, was es Dir sagt.");
  
  AddCmd( ({"nuckel", "nuckle", "lutsche", "lutsch"}), "eiszapfen");
  
  AddExit( "nordosten", ROOM("weg20"));
  AddExit( "westen", ROOM("weg18"));
}

reset()
{
  zapfen=2+random(3);
  ::reset();
}

eiszapfen( str )
{
  notify_fail("Woran willst Du lutschen?\n");
  if(str=="an eiszapfen"||str=="an zapfen"||str=="eiszapfen"||str=="zapfen") {
    if(zapfen) {
      write(BS("Als Du an dem Eiszapfen lutschst, durchfaehrt Dich ein "
            "eiskaltes Prickeln und Du fuehlst Dich sogleich viel "
            "besser!"));
      TP->AddHp(30+random(30));
      TP->AddSp(30+random(30));
      zapfen--;
      say(BS(CAP_TPN+" nuckelt an einem Eiszapfen herum."));
      return 1;
    }
    else {
      write(BS("Du lutscht an einem Eiszapfen herum, aber ausser einer kalten "
           "Zunge bekommst Du nichts."));
      say(BS(CAP_TPN+" nuckelt an einem Eiszapfen herum."));
      return 1;
    }
  }
  return 0;
}
