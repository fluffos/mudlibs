*  Thor@SilberLand                 *
*  Ein Weg durchs Polar - weg18.c  *
*  1999-02-17                      *
***********************************/

#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Du stehst im Schatten der hohen Felswand suedlich von "
           "Dir. Im Norden von Dir glitzern die schneebedeckten Huegel im "
           "Sonnenlicht, und Du meinst, dort auch ein kleines Waeldchen "
           "zu erkennen. Der Weg fuehrt geradewegs weiter von Westen nach "
           "Osten."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( "schatten",
	    "Die Felswand wirft einen langen Schatten.");
  AddDetail( ({"wand", "fels", "felswand", "felsen"}),
      "Die Felswand gehoert wohl zu den Auslaeufern der Kymora Berge, welche "
      "sich von hier aus nach Sueden erstrecken.");
  AddDetail( ({"berg", "berge", "gebirge", "kymora", "zug", "gebirgszug"}),
      "Die Berge von Kymora sind ein riesiger Gebirgszug, welcher den Sueden "
      "des Polars dominiert.");
  AddDetail( "auslaeufer",
      "Dies hier sind nur die Auslaeufer der Berge, ihre hohen Gipfel sind "
      "weiter im Sueden.");
  AddDetail( "gipfel",
      "Die kannst Du von hier aus nicht sehen.");
  AddDetail( "polar",
      "Du stehst gerade mitten drin.");
  AddDetail( "huegel",
      "Die Huegel sind von einer dicken Schneedecke bedeckt, welche das "
      "helle Sonnenlicht reflektiert und alles noch heller aussehen laesst.");
  AddDetail( ({"licht", "sonnenlicht", "sonne"}),
      "Die Sonne lacht strahlend hell vom Himmel.");
  AddDetail( "himmel",
      "Kein einziges Woelkchen truebt das Blau des Himmels.");
  AddDetail( "blau",
      "Eine schoene Farbe!");
  AddDetail( ({"farbe", "farben"}),
      "Genauso wie Rot, Gelb, Gruen, Violett, Rosa, Braun ....");
  AddDetail( ({"rot", "gelb", "gruen", "violett", "rosa", "braun"}),
      "Alles Farben, das muesstest Du doch wissen.");
  AddDetail( ({"wolke", "wolken", "woelkchen"}),
      "Keins zu sehen.");
  AddDetail( ({"schnee", "schneedecke", "decke"}),
      "Die ganze Landschaft ist von einer meterdicken Schneedecke bedeckt, "
      "welche hell im Sonnenlicht glitzert.");
  AddDetail( "landschaft",
      "Schoen ists hier, nicht wahr?");
  AddDetail( ({"waeldchen", "wald"}),
      "Eine kleine Anhaeufung von Baeumen.");
  AddDetail( "anhaeufung",
      "Ein Waeldchen koennte man auch als kleinere Anhaeufung von Baeumen "
      "bezeichnen.");
  AddDetail( ({"baum", "baeume"}),
      "Auch die Baeume sind mit reichlich Schnee bedeckt.");
  AddDetail( "weg",
      "Der Weg fuehrt von Westen nach Osten.");
  AddDetail( "boden",
      "Nichts ausser Schnee zu entdecken.");
  
  AddSound( DEFAULT_SOUND,
      "Ein sanftes Lueftchen fluestert Dir ins Ohr.");
  AddSound( "lueftchen",
      "Leider verstehst Du nicht, was es sagt.");
  
  AddExit( "osten", ROOM("weg19"));
  AddExit( "westen", ROOM("weg17"));
}

