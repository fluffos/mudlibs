#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Du stapfst weiter ueber den Pass. Das Schneetreiben ist auch "
           "hier so dicht, dass Du kaum etwas erkennen kannst, und am Boden "
           "liegt meterweise Neuschnee. Ausser an zwei Seiten ist der Pass von "
           "steilen Felswaenden umgeben, Du kannst also nur nach Sueden oder "
           "Nordwesten weiter gehen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -15]) );
  SetProp( P_NO_TPORT, NO_TPORT_OUT );
  SetProp( P_NOQUIT, 1);
  
  SetProp(P_STUCK, ({}));
  
  AddDetail( ({"hoehe", "pass", "passhoehe"}),
	    "Du hoffst, dass Du bald wieder den Abstieg von diesem Pass antreten "
      "kannst.");
  AddDetail( "abstieg",
      "Im Nordwesten gehts wieder runter.");
  AddDetail( ({"gestoeber", "schneegestoeber", "treiben", "schneetreiben"}),
      "Das Schneetreiben haelt unvermindert an.");
  AddDetail( "boden",
      "Am Boden liegt meterhoch Neuschnee.");
  AddDetail( ({"neuschnee", "schnee"}),
      "Wenn Du keine Schneeschuhe anhaettest, wuerdest Du vermutlich bis ueber "
      "die Hueften einsinken.");
  AddDetail( ({"schuhe", "schneeschuhe"}),
      "Es waere wohl besser, wenn Du diese anbehalten wuerdest.");
  AddDetail( ({"huefte", "hueften"}),
      "Wenn Du bis ueber die Hueften im Schnee steckst, muss vermutlich wer "
      "kommen um Dich auszubuddeln.");
  AddDetail( ({"seiten", "seite"}),
      "Ausser im Nordwesten und im Sueden bist Du von hohen Felswaenden "
      "eingezaeunt.");
  AddDetail( ({"menge", "mengen"}),
      "Unvorstellbare Mengen an Schnee gibt es hier.");
  AddDetail( ({"hand", "haende"}),
      "Deine Haende sind schon ganz kaltgefroren.");
  AddDetail( ({"auge", "augen"}),
      "Deine Augen versagen ihren Dienst bei einem solch dichtem "
      "Schneetreiben.");
  AddDetail( ({"dienst", "dienste"}),
      "Meist leisten Dir Deine Augen recht gute Dienste.");
  AddDetail( "weg",
      "Du kannst zwar beim besten Willen keinen Weg erkennen, aber die "
      "einzige Moeglichkeit um von hier vor zu kommen ist, entweder nach "
      "Sueden oder nach Nordwesten zu gehen.");
  AddDetail( ({"wille", "willen"}),
      "Dein Wille wird immer schwaecher ...");
  AddDetail( ({"moeglichkeit", "moeglichkeiten"}),
      "Wie bereits erwaehnt, so viele Moeglichkeiten gibt es hier nicht.");
  AddDetail( ({"fels", "felsen", "wand", "waende", "felswand", "felswaende"}),
      "Die Felswaende haben immerhin den Vorteil, dass sie den Wind etwas "
      "abhalten. An ein Erklimmen ist nicht zu denken.");
  AddDetail( "wind",
      "Das wuerde Dir grad noch fehlen, wuerde der Wind Dir hier auch noch "
      "heftig ins Gesicht blasen.");
  AddDetail( "gesicht",
      "Dein Gesicht ist so und so schon eiskalt, egal ob mit oder ohne "
      "Wind.");
  AddDetail( ({"vorteil", "vorteile"}),
      "Alles hat gewisse Vor- und Nachteile.");
  AddDetail( ({"nachteil", "nachteile"}),
      "Ein Nachteil hier ist zum Beispiel, dass Du Dich hier durch die "
      "hohen Felswaende nur in zwei Richtungen wenden kannst.");
  AddDetail( "beispiel",
      "Ich habe doch gerade eins angefuehrt.");
  AddDetail( "himmel",
      "Den Himmel erkennst Du nur als schmale, weisse Flaeche zwischen den "
      "Felsen ueber Dir.");
  AddDetail( "flaeche",
      "Einfach nur weiss.");
  AddDetail( "erklimmen",
      "Vergiss es! Dazu sind sie einfach zu steil und das Wetter viel zu "
      "schlecht.");
  AddDetail( "wetter",
      "Das hier ist so ziemlich das unfreundlichste Wetter, das Du je "
      "erlebt hast.");
   
  AddSound( DEFAULT_SOUND,
      "Ausser dem leisen Heulen des nachlassenden Windes hoerst Du nichts.");
  AddSound( "heulen",
      "HEUUUUUUUUUUUUUL!");
  AddSound( "wind",
      "Der Wind weht hier zwischen den Felsen nicht ganz so heftig.");

  AddCmd( ({"grabe", "grab", "buddel", "buddle"}), "dig" );
  
  AddSpecialExit( ({"nordwesten", "nordwestunten"}), "exit_nw");
  AddSpecialExit( ({"sueden", "sueden"}), "exit_s");
  SetProp(P_HIDE_EXITS, ({"nordwesten"}));

}

exit_nw()
{
  object ob;

  if( (!ob=present("schneeschuhe", TP)) || (ob && !ob->QueryProp(P_WORN))) {
    write(BS("Du versuchst Dich muehsam nach Nordwesten durch den Schnee, "
          "zu kaempfen, steckst jedoch bis zum Bauch in demselbigen fest. "
          "Tja, solange hier niemand ankommt um Dich auszubuddeln, liegt "
          "Deine Hauptbeschaeftigung wohl darin, nicht zu erfrieren."));
    say(BS(CAP_TPN+" versucht sich aus dem Schnee zu befreien, schafft "
          "es aber nicht."));
    if(member(QueryProp(P_STUCK), getuid(TP))==-1)
      SetProp(P_STUCK, QueryProp(P_STUCK)+({getuid(TP)}));
    return 1;
  }
  else {
    write(BS("Du wendest Dich Richtung Nordwesten und stapfst durch das "
          "dichte Schneegestoeber."));
    return TP->move(ROOM("weg11"), M_GO, "nach Nordwestenunten", "stapft", 
        "stapft herein");
  }
  

}

exit_s()
{
  object ob;

  if( (!ob=present("schneeschuhe", TP)) || (ob && !ob->QueryProp(P_WORN))) {
    write(BS("Du versuchst Dich muehsam nach Sueden durch den Schnee, "
          "zu kaempfen, steckst jedoch bis zum Bauch in demselbigen fest. "
          "Tja, solange hier niemand ankommt um Dich auszubuddeln, liegt "
          "Deine Hauptbeschaeftigung wohl darin, nicht zu erfrieren."));
    say(BS(CAP_TPN+" versucht sich aus dem Schnee zu befreien, schafft "
          "es aber nicht."));
    if(member(QueryProp(P_STUCK), getuid(TP))==-1)
      SetProp(P_STUCK, QueryProp(P_STUCK)+({getuid(TP)}));
    return 1;
  }
  else {
    write(BS("Du wendest Dich Richtung Sueden und stapfst durch das "
          "dichte Schneegestoeber."));
    return TP->move(ROOM("weg9"), M_GO, "nach Sueden", "stapft", 
        "stapft herein");
  }
  
}

dig( str )
{
  string *input, wer;
  notify_fail("Wen/was willst Du ausgraben?\n");

  if(!str)
    return 0;

  input=explode(str, " ");
  wer=input[0];

  if(!find_player(wer) || !present(wer) || member(QueryProp(P_STUCK),wer)==-1) {
    write("Du graebst unmotiviert im Schnee herum.\n");
    say(CAP_TPN+" graebt unmotiviert im Schnee herum.\n");
    return 1;
  }
 
  else if(wer==getuid(TP)) {
    write(BS("Du kannst Dich nicht selbst aus dem Schnee ausgraben! Du bist "
        "ja nicht Muenchhausen, der sich am eigenen Schopf aus dem Sumpf "
        "zieht."));
    return 1;
  }
      
  else if(member(QueryProp(P_STUCK), getuid(TP)) != -1) {
    write(BS("Aber Du steckst doch selbst bis zum Bauch im Schnee, wie willst "
        "Du da "+capitalize(wer)+" ausgraben?"));
    return 1;
  }
  
  else if(!present("schaufel", TP)) {
    write(BS("Du versuchtst, "+capitalize(wer)+" aus dem Schnee auszugraben, "
        "mit Deinen blossen Haenden geht da allerdings nicht viel weiter ... "
        "vielleicht solltest Du Dir lieber eine Schaufel besorgen?"));
    tell_object(find_player(wer), BS(CAP_TPN+" versucht Dich aus dem Schnee "
        "auszugraben, schafft es mit den blossen Haenden aber nicht. "
        "Vielleicht sollte "+TPP(WER)+" sich vorher besser eine Schaufel "
        "besorgen."));
    tell_room(environment(TP), BS(CAP_TPN+" versucht, "+capitalize(wer)+" aus "
        "dem Schnee auszugraben, hat mit den blossen Haenden aber nur wenig "
        "Aussicht auf Erfolg."), ({TP, find_player(wer)}));
    return 1;
  }
  
  else {
    write(BS("Du zueckst Deine Schaufel und faengst wacker an, "
             +capitalize(wer)+" aus dem Schnee auszugraben."));
    tell_object(find_player(wer), BS(CAP_TPN+" buddelt Dich aus dem Schnee "
        "heraus. Es ist wohl besser, wenn Du Dir gleich wieder Deine "
        "Schneeschuhe anziehst, und diese nicht mehr so schnell ausziehst."));
    tell_room(environment(TP), CAP_TPN+" buddelt "+capitalize(wer)+" aus dem "
        "Schnee heraus.\n", ({TP, find_player(wer)}));
    SetProp(P_STUCK, QueryProp(P_STUCK)-({wer}));
    return 1;
  }
}

    
