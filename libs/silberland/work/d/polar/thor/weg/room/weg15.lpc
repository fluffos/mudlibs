#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Der Weg fuehrt vom Meer im Westen weiter ins Landesinnere "
           "nach Osten. Suedlich von Dir ist nach wie vor alles felsig, "
           "dies stellt wohl die Grenze der Berge von Kymora dar. Nach "
           "Norden hin siehst Du nur einige schneebedeckte Huegel mit "
           "ein paar vereinzelten Baeumen dazwischen."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( "weg",
	    "Der fuehrt von Suedwesten nach Nordosten.");
  AddDetail( "meer",
      "Im Westen siehst Du das Meer im Sonnenlicht glitzern.");
  AddDetail( ({"licht", "sonnenlicht", "sonne"}),
      "Das schlechte Wetter hat sich jetzt gaenzlich verzogen und die Sonne "
      "lacht wieder vom Himmel.");
  AddDetail( "himmel",
      "Nur noch ein paar vereinzelte Wolken sind am Himmel zu sehen.");
  AddDetail( ({"wolke", "wolken"}),
      "Nur noch sehr wenige treiben am Himmel herum.");
  AddDetail( "wetter",
      "Du fuehlst Dich wieder wesentlich wohler hier.");
  AddDetail( ({"innere", "inneres", "landesinneres", "landesinnere"}),
      "Der Weg fuehrt weiter nach Osten ins Landesinnere.");
  AddDetail( ({"felsen", "fels", "felswaende", "felswand", "wand", "waende"}),
      "Die Felswand suedlich von Dir gehoert wohl zu den Bergen von Kymora. "
      "Der Weg von Smoersky bis hier her scheint wohl genau um die Berge "
      "herum zu fuehren.");
  AddDetail( "smoersky",
      "Das ist weiter suedlich von hier.");
  AddDetail( ({"berge", "berg", "kymora", "massiv", "gebirgsmassiv","gebirge"}),
      "Ausser einigen Felswaenden hast Du zwar noch nicht viel von den "
      "Bergen von Kymora gesehen, sie scheinen allerdings ein recht "
      "beeindruckendes Gebirgsmassiv zu sein.");
  AddDetail( "grenze",
      "Die Berge von Kymora erstrecken sich von hier aus Richtung Suedosten.");
  AddDetail( "huegel",
      "Die Schneedecke der Huegel funkelt im Sonnenlicht.");
  AddDetail( ({"schnee", "schneedecke"}),
      "Es scheint erst vor kurzem geschneit zu haben, denn der Schnee ist noch "
      "ganz pulvrig und frisch zu sein.");
  AddDetail( ({"baeume", "baum", "nadelbaeume", "nadelbaum"}),
      "Einige einsame, schneebedeckte Nadelbaeume wachsen zwischen "
      "den Huegeln.");
  AddDetail( "boden",
      "Die Schneedecke wurde hier zu einem Weg festgestampft.");
  
  AddSound( DEFAULT_SOUND,
      "Ausser dem Heulen des Windes hoerst Du nichts.");
  AddSound( "heulen",
      "HEUUUUUUUUUUUUUL!");
  AddSound( "wind",
      "Der Wind pfeift Dir um die Ohren.");
  AddSound( "pfeifen",
      "Du hoerst nur ein Heulen, kein Pfeifen.");
  
  AddExit( "nordosten", ROOM("weg16"));
  AddExit( "suedwesten", ROOM("weg14"));
}

