#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

string *arr;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Der Weg wird hier wesentlich steiler und felsiger. Die Klippen "
           "zu Deiner Linken werden immer schroffer und steiler und zu "
           "Deiner Rechten tut sich eine schroffe Felswand auf. Am Fusse "
           "der Felswand ist ein kleiner Ueberhang, hinter dem sich etwas "
           "zu verbergen scheint ..."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( "weg",
	    "Der Weg fuehrt von Suedosten nach Norden.");
  AddDetail( "klippen",
      "Immer steiler werden die Klippen, und dadurch auch der Weg, der an den "
      "Klippen entlang fuehrt.");
  AddDetail( "linke",
      "Du betrachtest Deine linke Hand.");
  AddDetail( "rechte",
      "Du betrachtest Deine rechte Hand.");
  AddDetail( ({"hand", "haende"}),
      "Derer hast Du zwei. Hoffe ich zumindest.");
  AddDetail( ({"wand", "felswand"}),
      "Die Felswand fuehrt steil nach oben und scheint weiter im Norden "
      "noch hoeher zu werden.");
  AddDetail( ({"fels", "felsen"}),
      "Der Fels ist durch den dauernden Wind schon stark erodiert.");
  AddDetail( "wind",
      "Der Wind blaest Dir nach wie vor kraeftig ins Gesicht.");
  AddDetail( ({"fuss", "fusse"}),
      "Am Fuss der Felswand ist ein kleiner Ueberhang.");
  AddDetail( ({"hang", "ueberhang"}),
      "Als Du den Ueberhang etwas genauer betrachtest, siehst Du den "
      "Kadaver eines riesigen Wolfes dort liegen.");
  AddDetail( "wolf",
      "Wer den wohl umgebracht hat?");
  AddSpecialDetail( "kadaver", "unt_kadaver");
  AddSpecialDetail( "fell", "unt_fell");
  AddDetail( "zustand",
      "Der Kadaver scheint noch nicht sehr lange hier zu liegen.");
  AddDetail( "boden",
      "Der Boden wird hier wesentlich felsiger und unwegsamer.");
  AddDetail( ({"schnee", "eis"}),
      "Schnee und Eis halten sich hier etwas zurueck und machen den "
      "Felsen platz.");
  AddDetail( ({"himmel", "wolken", "wolke", "wolkendecke", "decke"}),
      "Langsam verdichten sich auch die letzten Luecken in der Wolkendecke "
      "und lassen keine Sonne mehr durch.");
  AddDetail( ({"luecke", "luecken"}),
      "Es sind fast keine mehr vorhanden.");
  AddDetail( "sonne",
      "Die Sonne gibt langsam die letzten Versuche auf, die Wolkendecke "
      "zu durchdringen.");
  AddDetail( "versuche",
      "Manchmal ist es zwecklos ...");

  AddSound( DEFAULT_SOUND,
      "Ausser dem Heulen des Windes hoerst Du nichts.");
  AddSound( "heulen",
      "HEUUUUUUUUUUUUUL!");
  AddSound( "wind",
      "Der Wind pfeift Dir um die Ohren.");
  AddSound( "pfeifen",
      "Du hoerst nur ein Heulen, kein Pfeifen.");
 
  AddCmd( ({"ziehe", "zieh"}), "fell");
  
  AddExit( "nordoben", ROOM("weg7"));
  AddExit( "norden", ROOM("weg7"));
  AddExit( "suedosten", ROOM("weg5"));
 
  SetProp(P_HIDE_EXITS, ({"norden"})); 
  arr=({});
}

reset()
{
  arr=({});
  ::reset();
}

string unt_kadaver()
{
  if(member(arr, getuid(TP))==-1)
    return BS("Das Fell des Kadavers ist noch in einem guten Zustand. Allzu "
              "lange scheint er wohl noch nicht hier zu liegen.");
  else
    return BS("Dem Kadaver hat vor kurzem jemand das Fell abgezogen. Ein "
              "ekliger Anblick.");
}

string unt_fell()
{
  if(member(arr, getuid(TP))==-1)
    return "Vielleicht kannst Du es ja abziehen.\n";
  else
    return BS("Dieses hat jemand wohl abgezogen.");
}
  
fell( str )
{
  object ob;
  
  if(member(arr, getuid(TP))==-1) {
    if(str=="kadaver fell ab"||str=="fell ab"||str=="wolf fell ab") {
      write("Sorgfaeltig ziehst Du dem steifgefrorenen Kadaver das Fell "
            "ab.\n");
      say(CAP_TPN+" macht sich an irgend etwas bei der Felswand zu "
            "schaffen.\n");
      ob=clone_object(OBJ("fell"));
      if(ob->move(TP, M_GET)==ME_TOO_HEAVY) {
       write("Da Dir das Fell leider zu schwer ist, legst Du es auf den "
          "Boden.\n");
       ob->move(ME);
      }
      arr+=({getuid(TP)});
      return 1;
    }
  }
  else {
    write("Dem Kadaver hat schon jemand das Fell abgezogen.\n");
    return 1;
  }
}
