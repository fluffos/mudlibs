#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Immer naeher kommst Du dem Meer im Westen. Auch der Wind wird "
           "immer schaerfer und kaelter hier, weil er kaum mehr durch Huegel "
           "aufgehalten wird. Einige Schneekristalle werden vom Boden "
           "aufgewirbelt und wehen Dir ins Gesicht. Brrr, ist das kalt hier."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -5]) );

  AddDetail( ({"weg", "pfad"}),
	    "Der Weg geht von Osten nach Westen.");
  AddDetail( "meer",
      "Noch ein Stueckchen weiter nach Westen und Du stehst direkt an den "
      "Klippen, die steil in das Meer abfallen.");
  AddDetail( ({"stueck", "stueckchen"}),
      "Nicht mehr weit soll das heissen.");
  AddDetail( ({"klippe", "klippen"}),
      "Dort sei lieber etwas vorsichtiger, sonst stuerzt Du noch ab, Du "
      "Tolpatsch!");
  AddDetail( "tolpatsch",
      "Alle Mudder sind tolpatschig :)");
  AddDetail( "mudder",
      "Du bist ein Parade-Exemplar.");
  AddDetail( ({"exemplar", "paradeexemplar", "parade-exemplar"}),
      "Sieh Dich doch bloss mal an!");
  AddDetail( "wind",
      "Der Wind wird immer unfreundlicher und kaelter.");
  AddDetail( "huegel",
      "Es sind fast keine mehr zu sehen.");
  AddDetail( ({"schneekristalle", "kristalle", "kristall", "schneekristall"}),
      "Schmerzhaft pieksen sie Dir ins Gesicht.");
  AddDetail( "gesicht",
      "Dein Gesicht ist schon ganz blau vor Kaelte.");
  AddDetail( "kaelte",
      "Die Kaelte hier ist bestimmt nur ein sanfter Vorgeschmack davon, was "
      "Dich noch so alles erwartet.");
  AddDetail( ({"geschmack", "vorgeschmack"}),
      "Es wird sicher noch viel schlimmer, dass kann ich Dir garantieren.");
  AddDetail( "boden",
      "Hundert Prozent Schnee.");
  AddDetail( "prozent",
      "Du wirst wohl mit einer prozentuellen Angabe etwas anzufangen wissen, "
      "hoffe ich mal stark.");
  AddDetail( "angabe",
      "Ja, wir wissen eh alle, dass Du ein alter Angeber bist! ;) ");
  AddDetail( "angeber",
      "Stolz richtest Du Dich auf.");
  AddDetail( ({"schnee", "eis", "flaechen", "flaeche"}),
      "Weisse Flaechen, soweit das Auge reicht.");
  AddDetail( ({"auge", "augen"}),
      "Wenn Du Deine Augen zusammenkneifst, traenen sie sicher nicht mehr "
      "so stark vom kalten Wind.");
  AddDetail( "himmel",
      "Der Himmel sieht immer unfreundlicher aus.");
  AddDetail( ({"wolke", "wolken"}),
      "Wolken ueberziehen den Himmel.");
       

  AddSound( DEFAULT_SOUND,
      "Ausser dem Heulen des Windes hoerst Du nichts.");
  AddSound( "heulen",
      "HEUUUUUUUUUUUUUL!");
  AddSound( "wind",
      "Der Wind pfeift Dir um die Ohren.");
  AddSound( "pfeifen",
      "Du hoerst nur ein Heulen, kein Pfeifen.");
 
  AddCmd( ({"kneife", "kneif"}), "augen");
 
  AddItem( NPC("elch"), REFRESH_DESTRUCT);
  
  AddExit( "westen", ROOM("weg5"));
  AddExit( "osten", ROOM("weg3"));
}

augen( str )
{
  if( str == "augen zusammen"||str=="augen") {
    write(BS("Fest kneifst Du Deine Augen zusammen, um dem Wind zu trotzen. "
          "Viel hilft es nicht, aber immerhin ein bisschen."));
    say(BS(CAP_TPN+" kneift "+TPPP(NEUTER, WEN, PLURAL)+" Augen zusammen."));
    return 1;
  }
  else
    return 0;
}
