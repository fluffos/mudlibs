***********************************/

#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Der Weg fuehrt weiter von Suedwesten nach Osten. Richtung "
           "Nordwesten zweigt ein kleinerer Pfad ab, dort glaubst Du "
           "auch ein kleines Waeldchen zu erkennen. Die Gegend hier wird "
           "immer flacher und Du entfernst Dich langsam von den Bergen von "
           "Kymora."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( "weg",
	    "Der Weg geht von Suedwesten nach Osten, das sagte ich doch schon.");
  AddDetail( "pfad",
      "Nach Nordwesten zweigt ein schmaler Pfad ab. Wo der wohl hinfuehren "
      "mag?");
  AddDetail( ({"wald", "waeldchen"}),
      "Einige Baeume stehen im Nordwesten.");
  AddDetail( ({"baum", "baeume"}),
      "Wenn Du etwas genaueres wissen willst, dann sieh doch einfach mal hin.");
  AddDetail( "gegend",
      "Die Gegend hier ist nicht mehr so gebirgig und unfreundlich.");
  AddDetail( ({"berge", "berg", "gebirge", "kymora"}),
      "Langsam aber sicher gewinnst Du etwas Abstand von den schroffen "
      "Bergen.");
  AddDetail( "abstand",
      "Etwas Abstand kann in gewissen Situationen manchmal gut sein.");
  AddDetail( ({"situation", "situationen"}),
      "Kennst Du sowas?");
  AddDetail( "boden",
      "Der Boden unter Deinen Fuessen besteht aus festgetrampeltem Schnee.");
  AddDetail( ({"fuss", "fuesse"}),
      "Du stehst auf zweien davon.");
  AddDetail( "schnee",
      "Schnee soweit das Auge reicht.");
  AddDetail( ({"auge", "augen"}),
      "Deine Augen sind schon leicht geblendet von dem ganzen hellen Schnee.");
  AddDetail( ({"himmel", "sonne"}),
      "Die Sonne lacht vom strahlend blauem Himmel herunter.");

  AddSound( DEFAULT_SOUND,
            "Ein sanftes Lueftchen fluestert Dir leise ins Ohr.");
  AddSound( "lueftchen",
            "Leider verstehst Du nicht, was es Dir sagt.");
     
  
  AddExit( "osten", ROOM("weg21"));
  AddExit( "suedwesten", ROOM("weg19"));
  AddExit( "nordwesten", ROOM("lichtung1"));
}

