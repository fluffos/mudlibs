#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

string *sun;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Immer huegeliger wird die Gegend hier, nur etwas weiter suedlich "
           "siehst Du noch die felsigen Auslaeufer der Berge von Kymora. Die "
           "Sonne scheint vom Himmel herab und laesst die dicke Schneedecke, "
           "welche die Landschaft bedeckt, hell glitzern und funkeln, sodass "
           "Dich die Helligkeit schon fast die Augen blendet."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( "weg",
	    "Der Weg fuehrt von Westen nach Nordosten.");
  AddDetail( "huegel",
      "Zahlreiche Huegel erstrecken sich noerdlich von Dir.");
  AddDetail( "gegend",
      "Viel Schnee gibts hier in der Gegend.");
  AddDetail( ({"schneedecke", "decke", "schnee"}),
      "Der Schnee liegt hier meterdick.");
  AddDetail( "landschaft",
      "Soweit Dein Auge reicht, erkennst Du nur die sanften Rundungen der "
      "schneebedeckten Huegel.");
  AddDetail( ({"auge", "augen"}),
      "Du kneifst die Augen zusammen, um Dich ein wenig gegen die blendenden "
      "Reflexionen zu schuetzen.");
  AddDetail( ({"reflexion", "reflexionen"}),
      "Das Sonnenlicht wird vom Schnee zig mal reflektiert und verstaerkt. "
      "Das hier waere sicher der ideale Platz zum sonnen.");
  AddDetail( "platz",
      "Da, wo Du gerade stehst.");
  AddDetail( ({"licht", "sonnenlicht"}),
      "Es blendet in Deinen Augen.");
  AddSpecialDetail( ({"rundungen", "rundung"}), "unt_rundung");
  AddDetail( ({"auslaeufer", "berge", "kymora", "berg", "gebirge"}),
      "Weiter im Sueden siehst Du die felsigen Auslaeufer der Kymora Berge. "
      "Ihre volle Pracht und Wildheit erreicht das Gebirge jedoch noch weiter "
      "im Sueden.");
  AddDetail( "pracht",
      "Sofern man ein unfreundliches, hohes, verschneites Gebirge als "
      "prachtvoll bezeichnen kann ... ");
  AddDetail( "wildheit",
      "Glaubst Du, der Wildheit dieses Gebirges trotzen zu koennen? Das haben "
      "schon ganz andere versucht und sind dabei zugrunde gegangen.");
  AddDetail( ({"sonne", "himmel"}),
      "Die Sonne strahlt hell vom Himmel.");
  AddDetail( "helligkeit",
      "Ja, es ist sehr hell hier.");
  AddDetail( "boden",
      "Der Boden besteht aus festgestampftem Schnee.");
      
  AddCmd( "sonne", "sonnen");
  AddCmd( ({"stehe", "steh"}), "aufstehen");
  
  AddSound( DEFAULT_SOUND,
      "Ein sanftes Lueftchen fluestert Dir etwas ins Ohr.");
  AddSound( ({"lueftchen", "fluestern"}),
      "Leider verstehst Du nicht, was es sagt.");

  AddItem( NPC("rentier"), REFRESH_DESTRUCT);
  AddItem( NPC("rentier"), REFRESH_DESTRUCT);
  
  AddExit( "nordosten", ([ EX_DEST: ROOM("weg22"),
                           EX_TESTFUNC: "exitfunc"]) );
  AddExit( "westen", ([ EX_DEST: ROOM("weg20"),
                           EX_TESTFUNC: "exitfunc"]) );

  
  sun=({});
}

int exitfunc()
{
  if(member(sun, getuid(TP))==-1)
    return 1;
  else {
    write(BS("Aber Du liegst doch gerade in der Sonne! Vielleicht solltest Du "
        "vorher aufstehen?"));
    return 0;
  }
}

string unt_rundung()
{
  if(TP->QueryProp(P_GENDER) == MALE)
    return "Wirklich sexy, diese Rundungen hier.\n";
  else
    return "Hm, Deine Rundungen findest Du schoener.\n";
}

sonnen()
{
  if(member(sun, getuid(TP))==-1) {
    write(BS("Du laesst Dich in den Schnee fallen, schliesst die Augen und "
          "laesst Dir die Sonne ins Gesicht scheinen. Aaaah, das tut gut."));
    say(BS(CAP_TPN+" laesst sich in den Schnee fallen, schliesst die Augen und "
          "geniesst die Sonne."));
    call_out("seq1", 5);
    sun+=({getuid(TP)});
    return 1;
  }
  else {
    write("Aber Du liegst ja bereits in der Sonne!\n");
    return 1;
  }
}

aufstehen()
{
  if(member(sun, getuid(TP))==-1) {
    write("Wieso willst Du denn aufstehen? Du liegst ja gar nirgends.\n");
    return 1;
  }
  else if(present("\nbraeune", TP))
    write(BS("Traege erhebst Du Dich wieder aus dem Schnee. Schade, das war "
          "richtig angenehm hier."));
  else
    write(BS("Traege erhebst Du Dich wieder aus dem Schnee. Schade, das war "
          "richtig angenehm hier. Sehr viel Braeune hast Du waehrend dieser "
          "kurzen Zeit allerdings noch nicht bekommen ..."));

  sun-=({getuid(TP)});
  return 1;
}

seq1()
{
  if(!TP)
    return;
  if(environment(TP)!=TO || member(sun, getuid(TP))==-1)
    return;
  write(BS("Warm scheint Dir die Sonne in Dein Gesicht, die Kuehle des "
        "Schnees unter Dir spuerst Du gar nicht."));
  call_out("seq2", 5);
}

seq2()
{
  if(!TP)
    return;
  if(environment(TP)!=TO || member(sun, getuid(TP))==-1)
    return;
  write(BS("Warm scheint Dir die Sonne in Dein Gesicht, die Kuehle des "
        "Schnees unter Dir spuerst Du gar nicht."));
  call_out("seq3", 5);
}

seq3()
{
  if(!TP)
    return;
  if(environment(TP)!=TO || member(sun, getuid(TP))==-1)
    return;
  write(BS("Beinahe schlaefst Du ein in der warmen Sonne, so wohl fuehlst "
        "Du Dich hier."));
  call_out("seq4", 5);
}

seq4()
{
  if(!TP)
    return;
  if(environment(TP)!=TO || member(sun, getuid(TP))==-1)
    return;
  write(BS("Nun bist Du wirklich kurz eingedoest! Brr, jetzt wirds wirklich "
        "schoen langsam kalt hier im Schnee. Entspannt erhebst Du Dich mit "
        "Deinem frisch gebraeuntem Gesicht."));
  if(!present("\nbraeune", TP))
    clone_object(OBJ("braun"))->move(TP, M_NOCHECK);
  sun-=({getuid(TP)});
}
