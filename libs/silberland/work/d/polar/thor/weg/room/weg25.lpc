***********************************/

#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int htime;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Der Weg fuehrt weiter von Suedwesten nach Norden. Im Sueden "
           "siehst Du die teils huegeligen, teils felsigen Auslaeufer "
           "der Berge von Kymora und links und rechts von Dir erstreckt "
           "sich nur eine weite, schneebedeckte Ebene."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( "weg",
      "Der Weg ist eigentlich nur festgestampfter Schnee.");
  AddDetail( "schnee",
      "Links und rechts von Dir kannst Du ausser Schnee nichts sehen.");
  AddDetail( "auslaeufer",
      "Die Auslaeufer der Kymora-Berge erstrecken sich kilometerweit "
      "Richtung Sueden.");
  AddDetail( ({"berge", "berg", "kymora", "gebirge", "zug", "gebirgszug"}),
      "Die Berge von Kymora sind ein riesiger Gebirgszug, der den Sueden "
      "der Polarregion beherrscht, und als unbezwingbar gilt.");
  AddDetail( ({"polar", "region", "polarregion"}),
      "Du stehst gerade mitten drin.");
  AddDetail( "ebene",
      "Links und rechts von Dir siehst Du nur eintoenigen Schnee. Wie "
      "langweilig.");
  AddDetail( "boden",
      "Der Boden unter Deinen Fuessen besteht aus festgestampftem Schnee.");
  AddDetail( ({"fuss", "fuesse"}),
      "Du stehst mit beiden Beinen fest auf der Erde.");
  AddDetail( ({"beine", "bein"}),
      "Derer hast Du hoffentlich zwei.");
  AddDetail( "erde",
      "Erde findest Du erst, wenn Du Dich hier einige Meter durch die dicke "
      "Schneedecke nach unten durchgegraben hast.");
  AddDetail( ({"decke", "schneedecke"}),
      "Die Schneedecke ist hier ueberall meterdick.");
  AddDetail( "meter",
      "Ein Meter ist mein Meter ist dein Meter ...");
  AddDetail( "himmel",
      "Am Himmel strahlt die Sonne mit ihrem schoensten Laecheln.");
  AddDetail( "sonne",
      "Einige Sonnenstrahlen kitzeln Dir in der Nase.");
  AddSpecialDetail( ({"strahlen", "strahl", "sonnenstrahlen", "sonnenstrahl"}),
      "sun");
  AddDetail( "nase",
      "Deine Nase fuehlt sich wohl in der Sonne, obwohl sie wegen der "
      "Sonnenstrahlen niesen muss.");
  AddDetail( "laecheln",
      "Leise laechelst Du in Dich hinein ob des schoenen Wetters willen.");
  AddDetail( ({"winterwetter", "wetter"}),
      "Das wunderschoenste Winterwetter, das man sich nur wuenschen kann.");
  AddDetail( "winter",
      "Hier ist immer Winter.");
  
  AddSound( DEFAULT_SOUND,
      "Ein leises Lueftchen fluestert Dir ins Ohr.");
  AddSound( "lueftchen",
      "Leider verstehst Du nicht, was es sagt.");
 
  AddCmd( ({"grabe", "grab"}), "dig");
  
  AddExit( "norden", ROOM("weg26"));
  AddExit( "suedwesten", ROOM("weg24"));
  htime=0;
}

dig( str )
{
  notify_fail("Wo willst Du graben?\n");
  if(str=="in schnee"||str=="schnee"||str=="in schneedecke"||str=="in decke"||
     str=="schneedecke"||str=="decke") {
    if(!present("schaufel", TP)) {
      write(BS("Du graebst mit den blossen Haenden die festgestampfte "
            "Schneedecke auf. Weiter als einige Zentimeter tief kommst "
            "Du allerdings nicht und gibst daher schnell wieder auf, bevor "
            "Dir Deine Finger abfrieren."));
      say(BS(CAP_TPN+" graebt mit den blossen Fingern in der festgestampften "
            "Schneedecke herum, gibt aber bald wieder auf."));
      return 1;
    }
    else if(htime < time()) {
      write(BS("Du schnappst Dir Deine Schaufel und beginnst zu graben. "
            "Du graebst und graebst und graebst und graebst. Du haeltst "
            "kurz inne und betrachtest stolz Dein tiefes Loch, danach "
            "graebst Du wieder weiter und weiter und weiter. Ploetzlich "
            "stoesst Deine Schaufel auf etwas hartes! Du hast ein "
            "Flaeschchen entdeckt, welches Du schnell aufmachst und "
            "austrinkst. Aaaaaaah, das war richtig erfrischend nach dieser "
            "anstrengenden Arbeit. Da Du Deinen Schatz jetzt gefunden hast, "
            "graebst Du das Loch artig wieder zu, Du willst ja schliesslich "
            "nicht, dass sich hier jemand ein Bein bricht."));
      say(BS(CAP_TPN+" buddelt ein tiefes Loch, jubelt kurz auf und "
            "buddelt das Loch dann wieder zu. Komischer Kauz."));
      TP->AddHp(40+random(30));
      TP->AddSp(40+random(30));
      htime=time()+1000+random(500);
      return 1;
    }
    else {
      write(BS("Du schnappst Dir Deine Schaufel und beginnst zu graben. "
            "Du buddelst eine Weile vor Dich hin, gibst dann aber "
            "schliesslich erschoepft auf. Mit letzter Kraft schaufelst Du "
            "das Loch wieder zu, schliesslich willst Du nicht, dass sich "
            "jemand ein Bein bricht."));
      say(BS(CAP_TPN+" buddelt ein tiefes Loch, haelt dann kurz erschoepft "
            "inne und buddelt das Loch dann wieder zu. Komischer Kauz."));
      TP->do_exhaust(300);
      return 1;
    }
  }
  else
    return 0;
}

string sun()
{
  if(TP) TP->command_me("niese");
  return "";
}
