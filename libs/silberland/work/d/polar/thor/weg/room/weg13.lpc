***********************************/

#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Der Weg ist ziemlich langweilig. Er fuehrt stetig von "
           "Suedosten nach Nordwesten runter. Westlich von Dir das "
           "Meer und oestlich von Dir die Felswand, an der auch "
           "immer noch eine Rinne im Schnee nach unten fuehrt."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( "weg",
	    "Er fuehrt unveraendert von Suedostoben nach Nordwestunten.");
  AddDetail( ({"meer", "polarmeer"}),
      "Das kalte Polarmeer erstreckt sich westlich von Dir.");
  AddDetail( ({"wand", "waende", "felswand", "felswaende", "fels", "felsen"}),
      "Du hast den Eindruck, als sei die Felswand hier etwas niedriger "
      "und nicht mehr ganz so steil.");
  AddDetail( "eindruck",
      "Eindruecke koennen oft taeuschen.");
  AddDetail( "eindruecke",
      "Lass Dich bloss nicht von ihnen in die Irre fuehren.");
  AddDetail( "irre",
      "Also hier ists wohl ziemlich schwer, sich zu verirren.");
  AddDetail( "rinne",
      "Die Rinne im Schnee fuehrt neben dem Weg nach unten.");
  AddDetail( "boden",
      "Der Boden besteht aus zusammengetrampeltem Schnee.");
  AddDetail( "schnee",
      "Davon gibts hier reichlich.");
  AddDetail( "himmel",
      "Der Himmel lichtet sich zunehmends und an einigen Stellen scheint "
      "sogar fast die Sonne wieder durch die Wolken zu lugen.");
  AddDetail( ({"sonne", "stelle", "stellen"}),
      "Noch schafft die Sonne es nicht ganz, die Wolken zu besiegen.");
  AddDetail( ({"wolke", "wolken", "wolkendecke", "decke"}),
      "Die Wolken werden zunehmends duenner.");
  
  AddSound( DEFAULT_SOUND,
      "Ausser dem Heulen des Windes hoerst Du nichts.");
  AddSound( "heulen",
      "HEUUUUUUUUUUUUUL!");
  AddSound( "wind",
      "Der Wind pfeift Dir um die Ohren.");
  AddSound( "pfeifen",
      "Du hoerst nur ein Heulen, kein Pfeifen.");

  AddCmd( ({"setze", "setz", "sitze", "sitz", "rutsche", "rutsch"}), "slide");
  
  AddExit( ({"nordwesten", "nordwestunten"}), ROOM("weg14"));
  AddExit( ({"suedosten", "suedostoben"}), ROOM("weg12"));
  SetProp( P_HIDE_EXITS, ({"nordwesten", "suedosten"}));
}

slide( str )
{
  notify_fail("Wo willst Du Dich reinsetzen?\n");
  if(str=="in rinne"||str=="rinne"||str=="in schneerinne"||str=="schneerinne"){
    call_other(ROOM("weg14"), "???");
    write(BS("Du setzt Dich in die Schneerinne und rutscht los. Die Rinne "
          "ist aeusserst glatt, sodass Du schnell an Geschwindigkeit "
          "gewinnst."));
    TP->SetProp(P_PARALYZED,
        ([PARALYZE_TIME: 4,
          PARALYZE_MSG: "Du rutscht gerade eine Schneerinne hinunter!\n",
          PARALYZE_MSG_OTHER: "",
          PARALYZE_END: "",
          PARALYZE_END_OTHER: ""]));
    call_out("seq1", 2);
    return 1;
  }
  else
    return 0;
}

seq1()
{
  if(!TP)
    return;
  if(environment(TP)!=TO)
    return;
  write("Immer schneller und schneller rutscht Du die Rinne hinunter.\n");
  call_out("seq2", 2);
}

seq2()
{
  if(!TP)
    return;
  if(environment(TP)!=TO)
    return;
  write(BS("Och schade, die Rutschpartie scheint gleich aus zu sein, denn "
        "vor Dir siehst Du vor dem Rand einer Klippe eine grosse "
        "Bremsmulde."));
  call_out("seq3", 4);
}

seq3()
{
  if(!TP)
    return;
  if(environment(TP)!=TO)
      return;
  write(BS("Mit voller Wucht landest Du in einer Schneemulde kurz vor dem "
        "Rand der Klippen. Du stehst wieder auf und klopfst Dir den Schnee aus "
        "Deiner Kleidung. Fuer Deinen Geschmack war das viel zu kurz, "
        "vielleicht solltest Du es das naechste Mal von weiter oben "
        "versuchen?"));
  TP->move(ROOM("weg14"), M_NOCHECK|M_NO_SHOW, 0, 0, "rutscht auf "
      "dem Po herein");
}

