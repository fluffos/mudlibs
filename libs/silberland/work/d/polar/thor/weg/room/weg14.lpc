/***********************************
*  Thor@SilberLand                 *
*  Ein Weg durchs Polar - weg14.c  *
*  1999-02-10                      *
***********************************/

#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Der Weg macht hier einen Knick von Suedosten nach Nordosten "
           "und auch die Felswand fuehrt nur Richtung Osten weiter. "
           "Vor Dir eroeffnet sich nach Norden hin ein atemberaubender "
           "Ausblick, wo Du eine weite Flaeche vom Landesinneren "
           "ueberblicken kannst. Du stehst auf der Spitze einer "
           "Klippe, das Meer erstreckt sich suedlich und westlich von "
           "Dir und der Wind blaest Dir kraeftig ins Gesicht. An einigen "
           "Stellen scheint die Sonne nun durch die Wolken durch und "
           "laesst das Meer hell glitzern. Du fuehlst Dich in diesem "
           "Augenblick frei wie ein Falke im Wind."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( "weg",
	    "Der Weg knickt von Suedosten nach Nordosten ab.");
  AddDetail( "knick",
      "Ein Knick von neunzig Grad.");
  AddDetail( ({"grad", "temperatur"}),
      "Hier hat es minus viel Grad Celsius.");
  AddDetail( ({"celsius", "astronom"}),
      "Celsius, Anders, schwedischer Astronom, geboren 27.11.1701 in "
      "Uppsala, Schweden, gestorben 25.4.1744 auch dort. Direktor der "
      "Sternwarte Uppsala, beteiligte sich an der Erdvermessung in Lappland "
      "und Peru (1736/37), deren Ergebnis das Wissen von Kenntnis der "
      "Erdabplattung war. 1742 gab Celsius das zwischen Siede- und "
      "Gefrierpunkt des Wassers in 100 Grad eingeteilte "
      "Quecksilberthermometer an (Siedepunkt entspricht Null Grad). Erst "
      "Linie legte jedoch den Nullpunkt dieser Skala mit dem Gefrierpunkt "
      "des Wassers zusammen.");
  AddDetail( "linne",
      "Auch irgend so ein Physiker.");
  AddDetail( "physiker",
      "Davon gab/gibt es viele.");
  AddDetail( "uppsala",
      "Das ist irgendwo in Schweden ...");
  AddDetail( "schweden",
      "Das ist ein einer anderen Welt.");
  AddDetail( "schweden",
      "Das wirst Du im SilberLand nicht finden.");
  AddDetail( ({"felswand", "wand"}),
      "Auch die Felswand macht einen Knick von Sueden nach Osten.");
  AddDetail( ({"ausblick", "landschaft"}),
      "Dein Blick streift ueber die weite Landschaft noerdlich von Dir. "
      "Du kannst weitlaeufige Huegel und auch vereinzelt ein paar "
      "Baeume oder kleinere Waeldchen erkennen. Die ganze Landschaft ist "
      "mit Schnee bedeckt, der im Sonnenlicht funkelt. Weit im Norden "
      "meinst Du sogar eine sehr grosse Eisflaeche zu erkennen, dort "
      "scheint wohl das Meer zugefroren zu sein.");
  AddDetail( "blick",
      "Fasziniert laesst Du Deinen Blick ueber die Landschaft wandern.");
  AddDetail( "huegel",
      "Einige Huegel erstrecken sich nach Norden hin.");
  AddDetail( ({"nadelbaeume", "nadelbaum", "baeume", "waeldchen", "waelder",
               "wald", "baum"}),
      "Die Waeldchen bestehen aus widerstandsfaehigen Nadelbaeumen, "
      "die dem Winter trotzen.");
  AddDetail( "winter",
      "Hier oben herrscht ewiger Winter.");
  AddDetail( ({"decke", "schneedecke", "schnee"}),
      "Die Landschaft ist von einer meterdicken Schneedecke bedeckt.");
  AddDetail( ({"licht", "sonne", "sonnenlicht", "strahlen", 
               "sonnenstrahlen", "strahl", "sonnenstrahl"}),
      "Die Sonnenstrahlen bringen das Meer und den Schnee zum glitzern.");
  AddDetail( ({"meer", "wasser"}),
      "Das Meer erstreckt sich so weit das Auge reichen kann nach Westen.");
  AddDetail( ({"auge", "augen"}),
      "So sehr Du Deine Augen auch anstrengen magst, Du kannst kein Ende "
      "des Meeres sehen.");
  AddDetail( "ende",
      "Das Meer geht bis zum Ende des SilberLands.");
  AddDetail( "silberland",
      "Da bist Du.");
  AddDetail( "eisflaeche",
      "Die Eisflaeche ist sehr weit weg im Norden, sodass Du nichtmal sicher "
      "bist, dass es sich um eine handelt. Es koennte genauso gut ein grosses "
      "Schneefeld sein.");
  AddDetail( ({"feld", "schneefeld"}),
      "Schnee, Schnee und nochmal Schnee.");
  AddDetail( ({"flaeche", "landesinneres", "inneres", "land", 
               "landesinnere", "innere"}),    
      "Von hier aus kannst Du weit ins Landesinnere blicken.");
  AddDetail( ({"klippe", "klippen"}),
      "Die Klippen fallen senkrecht bis zum Meer hinab.");
  AddDetail( "spitze",
      "Die Klippe, auf der Du stehst, ist im Norden, Sueden und Westen mit "
      "Meer umgeben.");
  AddDetail( "wind",
      "Der Wind blaest Dir kalt ins Gesicht, aber in diesem Moment spuerst "
      "Du die beissende Kaelte nicht.");
  AddDetail( "gesicht",
      "Du bemerkst die beissende Kaelte in Deinem Gesicht gar nicht.");
  AddDetail( "kaelte",
      "Es ist verdammt kalt hier.");
  AddDetail( "sonne",
      "Langsam schafft es die Sonne, die Wolken zu besiegen.");
  AddDetail( ({"himmel", "wolke", "wolken"}),
      "Die Wolken lichten sich zusehends.");
  AddDetail( "augenblick",
      "Geniesse ihn in vollen Zuegen!");
  AddDetail( ({"zug", "zuege"}),
      "Nein, hier oben verkehren keine Zuege.");
  AddDetail( "falke",
      "Am liebsten wuerdest Du auf dem Wind davonreiten.");
  AddDetail( "boden",
      "Am Boden siehst Du eine Rinne von Suedosten herunter bis zu "
      "einer Mulde im Schnee fuehren. Allerdings sind auch einige "
      "Spuren zu sehen, die weiter ueber den Rand der Klippe hinweg "
      "fuehren.");
  AddDetail( "rinne",
      "Die Rinne scheint hier ein Ende zu haben.");
  AddDetail( "mulde",
      "Einfach nur eine Mulde im weichen Schnee.");
  AddDetail( ({"spuren", "spur"}),
      "Wer auch immer diese Spuren verursacht haben mag, hat es wohl "
      "nur mit Mueh und Not ueberlebt, wenn ueberhaupt.");
  AddDetail( ({"mueh", "muehe"}),
      "Du muehst Dich ab, hier alle Details zu untersuchen.");
  AddDetail( "detail",
      "Dies hier ist zum Beispiel eines.");
  AddDetail( "beispiel",
      "Nun uebertreibs mal nicht.");
  AddDetail( "not",
      "Was interessiert mich Deine Not?");
  AddDetail( ({"rand", "klippenrand"}),
      "Einigen wurde dieser Klippenrand wohl zum Verhaengnis.");
  AddDetail( "verhaengnis",
      "Dir wurde sicher auch schon dies oder das zum Verhaengnis.");
      
  AddSound( DEFAULT_SOUND,
      "Ausser dem Heulen des Windes hoerst Du nichts.");
  AddSound( "heulen",
      "HEUUUUUUUUUUUUUL!");
  AddSound( "wind",
      "Der Wind pfeift Dir um die Ohren.");
  AddSound( "pfeifen",
      "Du hoerst nur ein Heulen, kein Pfeifen.");
  
  AddCmd( ({"reite", "reit", "fliege", "flieg"}), "wind");
  
  AddExit( "nordosten", ROOM("weg15"));
  AddExit( ({"suedosten", "suedostoben"}), ROOM("weg13"));
  SetProp(P_HIDE_EXITS, ({"suedosten"}));
}

wind( str )
{
  notify_fail("Worauf willst Du reiten?\n");
  if(str=="wind"||str=="auf wind"||str=="auf wind davon") {
    write(BS("Du breitest Deine Arme aus und springst von der "
          "Klippe dem Wind entgegen. Du hast das Gefuehl, Dich in "
          "einen Vogel zu verwandeln und eins mit dem Wind zu sein. "
          "Doch ploetzlich bemerkst Du Deinen fatalen Fehler. Immer "
          "schneller rast die Wasseroberflaeche des Meeres auf Dich "
          "zu und Du stuerzt und stuerzt und stuerzt ..."));
    say(BS(CAP_TPN+" breitet "+TPP(WESSEN)+" Arme aus und springt von "
          "der Klippe."));
    TP->SetProp(P_PARALYZED,
        ([ PARALYZE_TIME: 3,
           PARALYZE_MSG:  "Du rast grad durch die Luft, der Wasseroberflaeche "
                          "entgegen.\n",
           PARALYZE_MSG_OTHER: "",
           PARALYZE_END: "",
           PARALYZE_END_OTHER: ""]));
    call_out("player_die", 4);
    return 1;
  }
  else
    return 0;
}

player_die()
{
  if(!TP)
    return;
  write(BS("Du spuerst einen harten Aufprall und fuer einen Moment fuehlst Du "
        "eisige Kaelte durch Deinen ganzen Koerper dringen. Ganz nebenbei "
        "bemerkst Du noch, wie Deine Ruestung durch das Salzwasser ziemlich "
        "in Mitleidenschaft gezogen wird. Aber das ist Dir jetzt eigentlich "
        "schon egal ..."));
  TP->SetProp(P_KILLER, TO);
  SetProp(P_KILL_NAME, "Ein Sturz ins eiskalte Polarmeer");
  SetProp(P_ENEMY_DEATH_SEQUENCE, WEG("seq/sequenz"));
  TP->SetProp(P_TMP_PRAY_ROOM, ROOM("strand"));
  TP->SetProp(P_GHOST, 1);
  TP->move("/room/death/death_room", M_NOCHECK|M_NO_SHOW);
  TP->SetProp(P_KILLER, 0);
  filter_objects(TP->QueryProp(P_ARMOURS)-({0})-TP->QueryArmours(AT_MISC), "TakeFlaw", 20+random(21));
}
