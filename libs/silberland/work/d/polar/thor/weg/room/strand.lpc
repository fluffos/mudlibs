*  Am Strand des Polarmeers - strand.c  *
*  1999-02-21                           *
****************************************/

#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Strand des Polarmeers" );
  SetProp( P_INT_LONG,
           "Ziemlich verschrocken und froestelnd liegst Du hier am Strand "
           "des Polarmeeres. So wie es aussieht, wurdest Du wohl hier "
           "angeschwemmt. Du denkst . o O (Uffz, nochmal mit heiler Haut "
           "davon gekommen) Nur allzu deutlich erinnerst Du Dich an Deine "
           "Begegnung mit Tod und Lars. Allerdings beginnst Du Dir jetzt "
           "langsam Gedanken ueber Deinen Rueckweg zu machen. Bis auf das "
           "Meer im Westen sind naemlich alle Richtungen mit dichtem, "
           "verschneitem Unterholz zugewachsen."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_NO_TPORT, NO_TPORT_OUT);
  SetProp( P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( ({"weg", "rueckweg"}),
      "Kein Weg zu sehen.");
  AddDetail( "strand",
      "Der Strand ist eigentlich nur eine winzige Bucht, die von dicht "
      "verwachsenem Unterholz umgeben ist.");
  AddDetail( "bucht",
      "Wo kein Unterholz waechst, rauscht das eiskalte Polarmeer.");
  AddDetail( ({"holz", "unterholz"}),
      "Du wunderst Dich, wie in einer solch kalten Gegend soviel Unterholz "
      "wachsen kann. Doch ... Moment ... bei genauerer Betrachtung siehst "
      "Du eine kleine Luecke im Unterholz.");
  AddDetail( "moment",
      "Nur nicht so hastig!");
  AddDetail( "gegend",
      "Saukalt ist es hier.");
  AddDetail( "betrachtung",
      "Es ist immer nuetzlich, sich gut umzusehen.");
  AddDetail( ({"luecke", "loch"}),
      "Die Luecke fuehrt nach Osten. Vielleicht kommst Du in dieser "
      "Richtung weiter.");
  AddDetail( ({"meer", "polarmeer"}),
      "Zitternd denkst Du an die kalten Fluten zurueck.");
  AddDetail( ({"fluten", "flut"}),
      "Keine hundert Forscherpunkte wuerden Dich in die eiskalten Fluten "
      "des Polarmeeres hineinbringen.");
  AddDetail( ({"forscherpunkt", "forscherpunkte"}),
      "Vergiss es!");
  AddDetail( "haut",
      "Besorgt tastest Du Dich von oben bis unten ab. Gottseidank, noch alles "
      "dran.");
  AddDetail( "begegnung",
      "Sie war nicht gerade erfreulich.");
  AddDetail( "tod",
      "Er war ziemlich unhoeflich.");
  AddDetail( "lars",
      "Lars hast Du richtig nett gefunden! Er hat sich aeusserst "
      "ruecksichtsvoll um Dich gekuemmert.");
  AddDetail( "gedanken",
      "Du denkst angestrengt nach.");
  AddDetail( "boden",
      "Unter den Schneemassen lugen vereinzelt einige Steine hervor.");
  AddDetail( ({"schneemassen", "schnee", "massen"}),
      "Hier liegt der Schnee in Massen.");
  AddDetail( ({"steine", "stein"}),
      "Hm, zu nichts zu gebrauchen.");
  AddDetail( "himmel",
      "Der Himmel ist bewoelkt, die Sonne scheint nicht durchzukommen.");
  AddDetail( ({"wolken", "wolke"}),
      "Wolken bedecken den Himmel.");
  AddDetail( "sonne",
      "Nichts von ihr zu sehen.");
  
  AddSound( DEFAULT_SOUND,
            "Der Wind pfeift Dir um die Ohren.");
  AddSound( ({"wind", "pfeifen"}),
            "Brrr, kalt.");
     
  AddCmd( ({"schwimme", "schwimm", "tauche", "tauch"}), "meer");
  
  AddSpecialExit( "osten", "exit_osten");
  SetProp(P_HIDE_EXITS, ({"osten"}));
}

exit_osten()
{
  return TP->move(ROOM("lab:"+getuid(TP)), M_GO, "nach Osten");
}
  
meer( str )
{
  notify_fail("Worin willst Du schwimmen?\n");
  if(str=="meer"||str=="polarmeer"||str=="in meer"||str=="in polarmeer") {
    write(BS("Du bist das letzte Mal schon so gut wie gestorben, ein "
          "zweites Mal ueberlebst Du das sicher nicht!"));
    return 1;
  }
  else
    return 0;
}

init()
{
  LABMASTER->CreateExits(TP);
  TP->SetProp(P_NEXT_EXIT, 0);
  TP->SetProp(P_MONSTER_ROOM, 
      random(sizeof(LABMASTER->CheckExits(getuid(TP)))-1));
  if(TP->QueryProp(P_GHOST))
    TP->SetProp(P_GHOST, 0);
  ::init();
}
