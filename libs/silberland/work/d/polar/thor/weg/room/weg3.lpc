#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

mapping map;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Der Weg macht hier einen leichten Knick nach Westen und scheint "
           "dort naeher an das Meer zu fuehren. Noerdlich und westlich von "
           "Dir erstrecken sich die Auslaeufer der maechtigen Berge von "
           "Kymora. Neben dem Weg steht hier ein einsamer, verdorrter Baum "
           "dessen kahle Aeste wie Finger in saemtliche Richtungen zeigen."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: 0]) );

  AddDetail( ({"weg", "pfad"}),
	    "Der Weg fuehrt von Suedosten nach Westen.");
  AddDetail( "knick",
      "Der Knick knickt um circa fuenfundvierzig Grad.");
  AddDetail( "grad",
      "Man koennte auch sagen 0.785398163 Rad, also Pi/4");
  AddDetail( "pi",
      "3.141592654uswusf");
  AddDetail( "rad",
      "Eine weitere Moeglichkeit, dies auszudruecken, sind 50 Neugrad.");
  AddDetail( "neugrad",
      "Eine kaum verwendete Masseinheit.");
  AddDetail( ({"einheit", "masseinheit"}),
      "Bloede Umrechnerei.");
  AddDetail( ({"rechnerei", "umrechnerei"}),
      "Voellig sinnlos.");
  AddDetail( ({"moeglichkeit", "moeglichkeiten"}),
      "Dir stehen alle Moeglichkeiten offen.");
  AddDetail( "meer",
      "Das Meer liegt nicht allzu weit entfernt im Westen.");
  AddDetail( ({"berge", "berg", "kymora", "auslaeufer", "massiv",
               "gebirgsmassiv", "gebirge"}),
      "Die Auslaeufer eines riesigen Gebirgsmassivs erstrecken sich im "
      "Norden und Westen. Selbst von hier sieht das Gebirge beeindruckend "
      "aus.");
  AddDetail( "baum",
      "Der Baum ist wohl schon seit langem voellig abgestorben, einige "
      "Aeste trotzen jedoch immer noch dem scharfen Wind.");
  AddDetail( "wind",
      "Der Wind blaest unaufhoerlich.");
  AddDetail( "finger",
      "Die kahlen Aeste des Baumes erinnern Dich an mahnende Finger, die "
      "daran erinnern sollen, dass hier oben wohl nur sehr wenig ueberleben "
      "kann.");
  AddDetail( "aeste",
      "Die Aeste sind alle schon duerr und abgestorben, es duerfte keine "
      "besonders grosse Herausforderung sein, den einen oder anderen "
      "abzubrechen.");
  AddDetail( ({"herausforderung", "forderung"}),
      "Bist Du nicht immer auf der Suche nach Herausforderungen?");
  AddDetail( "suche",
      "Ob Deine Suche wohl jemals ein Ende findet?");
  AddDetail( "ende",
      "Mach doch einfach mal ;)");
  AddDetail( "boden",
      "Schnee, Schnee und nochmal Schnee.");
  AddDetail( ({"eis", "schnee"}),
      "Davon gibt es hier reichlich.");
  AddDetail( "himmel",
      "Die Wolkendecke am Himmel wird immer dichter.");
  AddDetail( ({"wolken", "wolke", "decke", "wolkendecke"}),
      "Besorgt wendest Du Deinen Blick gen Himmel.");
  AddDetail( "blick",
      "Du blickst hoch.");
  
  AddSound( DEFAULT_SOUND,
      "Ausser dem Heulen des Windes hoerst Du nichts.");
  AddSound( "heulen",
      "HEUUUUUUUUUUUUUL!");
  AddSound( "wind",
      "Der Wind pfeift Dir um die Ohren.");
  AddSound( "pfeifen",
      "Du hoerst nur ein Heulen, kein Pfeifen.");
  
  AddCmd( ({"brich", "breche", "brech"}), "ast");
  
  AddExit( "westen", ROOM("weg4"));
  AddExit( "suedosten", ROOM("weg2"));

  map=([]);
}

reset()
{
  map=([]);
  ::reset();
}

ast( str )
{
  object ob;
  
  notify_fail("Was willst Du abbrechen?\n");

  if(map[getuid(TP)]>=2) {
    write(BS("Aber Du hast doch schon zwei Astgabeln abgebrochen! Wenn "
          "Du so weiter machst, ist von dem Baum bald nichts mehr uebrig."));
    return 1;
  }
  
  if(str=="ast ab"||str=="ast"||str=="aeste ab"||str=="aeste"||
     str=="astgabel ab"||str=="astgabel") {
    write("Du brichst Dir eine grosse, kraeftige Astgabel ab.\n");
    say(BS(CAP_TPN+" verunstaltet den hiesigen Baum noch mehr, als dieser "
          "ohnehin schon ist."));
    ob=clone_object(OBJ("astgabel"));
    if(ob->move(TP, M_GET)==ME_TOO_HEAVY) {
      write("Da Dir die Astgabel zu schwer ist, legst Du sie auf den "
          "Boden.\n");
      ob->move(ME);
    }
    map[getuid(TP)]++;
    return 1;
  }
  else
    return 0;
}
