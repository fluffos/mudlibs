**********************************/

#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

mapping map;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Ein schmaler Weg fuehrt hier weiter Richtung Nordwesten. "
           "Suedoestlich von Dir liegt Smoersky, westlich von Dir erstreckt "
           "sich hinter einigen Schneehuegeln das Meer und gleich noerdlich "
           "sind die weiten Auslaeufer der Berge von Kymora."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: 0]) );

  AddDetail( ({"weg", "pfad"}),
	    "Der Weg fuehrt schnurstracks weiter nach Nordwesten.");
  AddDetail( ({"dorf", "smoersky"}),
    "Das Dorf Smoersky (Kaff waere vielleicht treffender) liegt nur ein "
    "paar Schritte von hier entfernt im Suedosten.");
  AddDetail( "kaff",
    "Wenn ein Dorf diese Bezeichnung verdient, dann ist es Smoersky.");
  AddDetail( ({"bezeichnung", "bezeichnungen"}),
    "Bezeichnungen sind meist sehr bezeichnend.");
  AddSpecialDetail( ({"schritte", "schritt"}), "unt_schritt");
  AddDetail( ({"huegel", "schneehuegel"}),
    "Hinter ein paar niedrigen Huegeln erstreckt sich das eiskalte "
    "Polarmeer, dessen helles Glitzern Du auch noch von hier aus sehen "
    "kannst.");
  AddDetail( ({"meer", "polarmeer"}),
    "Hinter den Huegeln siehst Du es noch durchschimmern.");
  AddDetail( "glitzern",
    "Die Wasseroberflaeche spiegelt die weissen Schneekuppen der Kymora Berge "
    "wider.");
  AddDetail( ({"wasser", "oberflaeche", "flaeche", "wasseroberflaeche"}),
    "Im Wasser des Meeres spiegelt sich die weisse Landschaft wider.");
  AddDetail( "landschaft",
    "Die Landschaft hier wird von einem grossen Gebirgsmassiv im Norden "
    "dominiert.");
  AddDetail( ({"berg","massiv", "gebirge", "gebirgsmassiv", "berge", "kymora"}),
    "Die schroffen Berge von Kymora erstrecken sich Richtung Norden. Hier "
    "stehst Du nur in ihren Auslaeufern, die ganze Wildheit der Berge "
    "erstreckt sich erst weiter im Landesinneren.");
  AddDetail( "auslaeufer",
    "Das hier sind nur die Auslaeufer der Berge von Kymora.");
  AddDetail( "wildheit",
    "Die Berge entfalten erst weiter im Landesinneren ihre volle Pracht, "
    "Wildheit und auch ihre Gefahren.");
  AddDetail( ({"inneres", "landesinneres", "landesinnere", "innere"}),
    "Davon ist leider noch nicht sehr viel erschlossen.");
  AddDetail( "pracht",
    "Ein schroffes, gewaltiges Gebirgsmassiv ist immer wieder beeindruckend.");
  AddDetail( ({"gefahr", "gefahren"}),
    "Die Berge von Kymora bergen unzaehlige Gefahren in sich. Vielleicht wirst "
    "auch Du einigen davon eines Tages begegnen.");
  AddDetail( "tag",
    "Irgendwann ...");
  AddDetail( ({"kuppen", "schneekuppen", "kuppe", "schneekuppe"}),
    "Schneekuppen ist vielleicht untertrieben, eigentlich ist das ganze "
    "Gebirgsmassiv von Schnee und Eis ueberzogen.");
  AddDetail( "eis",
    "Davon gibt es hier reichlich.");
  AddDetail( "schnee",
    "Schnee soweit das Auge reicht ... ");
  AddDetail( "auge", 
    "Pass auf, dass es Dir nicht aus dem Kopf faellt.");
  AddDetail( "kopf",
    "Du stellst also in Frage, dass Dein Kopf vorhanden ist?");
  AddDetail( "frage",
    "Eine aeusserst dumme Aktion muss ich schon sagen.");
  AddDetail( "aktion",
    "Was wird wohl Deine naechste sein?");
  AddDetail( "boden",
    "Der Boden ist gottseidank unter Dir.");
  AddDetail( "himmel",
    "Der eisig-blaue Himmel ist ueber Dir, so wie es sich fuer einen "
    "ordentlichen Himmel auch gehoert.");
  
  AddSound( DEFAULT_SOUND,
      "Ausser dem Heulen des Windes hoerst Du nichts.");
  AddSound( "heulen",
      "HEUUUUUUUUUUUUUL!");
  AddSound( "wind",
      "Der Wind pfeift Dir um die Ohren.");
  AddSound( "pfeifen",
      "Du hoerst nur ein Heulen, kein Pfeifen.");
  
  AddExit( "nordwesten", ROOM("weg2"));
  AddExit( "osten", "/d/polar/lamuerte/dorf/rooms/festland_3");

  map=([]);
}

string unt_schritt()
{
  switch (map[getuid(TP)]) {
    case 0:   map[getuid(TP)]++;
              return "Du machst einen Schritt Richtung Osten.\n";
    case 1:   map[getuid(TP)]++;
              return "Du machst noch einen Schritt nach Osten.\n";
    case 2:   map[getuid(TP)]++;
              return "Du machst einen weitern Schritt nach Osten.\n";
    case 3:   map[getuid(TP)]++;
              return "Und noch ein Schritt nach Osten! Ganz schoen mutig von "
                     "Dir.\n";
    case 4:   call_out("raus", 0);
              map[getuid(TP)]=0;
              return "Du machst noch einen Schritt nach Osten und stolperst.\n";
  }
}

raus()
{ 
  if(!TP)
    return;
  TP->move("/d/polar/lamuerte/dorf/rooms/festland_3", M_GO);
}
