**********************************/

#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

string *sequenz;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Der Weg verdient hier an dieser Stelle schon eher die "
           "Bezeichnung Felssteig. An beiden Seiten des Weges sind "
           "steile Felswaende, im Osten fuehren sie senkrecht nach "
           "oben, im Westen senkrecht nach unten. Du fuehlst Dich reichlich "
           "unwohl auf dem schmalen, windigen Steig, der zu allem Ueberfluss "
           "auch noch ganz leicht vereist ist."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( ({"weg", "steig", "felssteig", "pfad"}),
	    "Der Weg wird immer unwegsamer und schwieriger zu begehen.");
  AddDetail( "stelle",
      "Das hier ist wohl eine ziemlich gefaehrliche Stelle.");
  AddDetail( ({"seite", "seiten"}),
      "Du fuehlst Dich etwas in die Enge getrieben.");
  AddDetail( "enge",
      "Es gibt nur zwei Moeglichkeiten ... Norden oder Sueden.");
  AddDetail( ({"moeglichkeiten", "moeglichkeit"}),
      "Du hast die Wahl ...");
  AddDetail( "wahl",
      "Kannst Du Dich etwa nicht entscheiden?");
  AddDetail( "bezeichnung",
      "Felssteig ist wohl treffender als Weg.");
  AddDetail( ({"waende", "wand", "felswaende", "felswand"}),
      "Du kannst entweder die Felswand im Osten raufklettern, oder Dich "
      "von den Klippen im Westen in die Tiefe stuerzen.");
  AddDetail( "tiefe",
      "Hier geht es seeehr tief runter.");
  AddDetail( ({"klippe", "klippen"}),
      "Die Klippen, auf deren schmalen Vorsprung Du da stehst, sind seeeehr "
      "tief.");
  AddDetail( "vorsprung",
      "Der Felssteig hier ist nur ein schmaler Vorsprung in den Klippen.");
  AddDetail( ({"ueberfluss", "fluss"}),
      "Zu allem Ueberfluss ist der Felssteig auch noch ziemlich eisig, sodass "
      "Du Acht geben musst, um nicht auszurutschen.");
  AddDetail( "acht",
      "Gib bloss Acht!");
  AddDetail( "boden",
      "Der Boden ist mit einer duennen Eisschicht bedeckt.");
  AddDetail( ({"eis", "schicht", "eisschicht"}),
      "Wenn Du unvorsichtig bist, koennte Dir diese Eisschicht Dein Leben "
      "kosten.");
  AddDetail( "leben",
      "Haengst Du sehr daran?");
  AddDetail( ({"wolken", "wolke", "himmel"}),
      "Am Himmel haengen drohend die Wolken.");

  AddSound( DEFAULT_SOUND,
      "Ausser dem Heulen des Windes hoerst Du nichts.");
  AddSound( "heulen",
      "HEUUUUUUUUUUUUUL!");
  AddSound( "wind",
      "Der Wind pfeift Dir um die Ohren.");
  AddSound( "pfeifen",
      "Du hoerst nur ein Heulen, kein Pfeifen.");
  
  AddCmd( ({"kletter", "klettere"}), "wand");
  AddCmd( ({"stuerze", "stuerz"}), "klippe");

  AddItem( NPC("wolf"), REFRESH_DESTRUCT );
  
  AddExit( "nordoben", ROOM("weg8"));
  AddExit( "norden", ROOM("weg8"));
  AddExit( "suedunten", ROOM("weg6"));
  AddExit( "sueden", ROOM("weg6"));
  SetProp(P_HIDE_EXITS, ({"norden", "sueden"}));

  sequenz=({});
}

wand( str )
{
  notify_fail("Wohin willst Du klettern?\n");
  if( str == "auf felswand" || str == "auf wand" || str == "wand" ||
      str == "felswand") {
    write(BS("Du versuchst die hohe Felswand zu erklimmen, findest aber "
          "leider viel zu wenig Halt. Mit zittrigen Beinen gibst Du Deine "
          "Versuche auf, schliesslich willst Du Dich hier ja nicht umbringen, "
          "oder?"));
    say(BS(CAP_TPN+" versucht klaeglich, die Felswand hochzuklettern, gibt "
          "nach einer Weile aber veraengstigt auf."));
    return 1;
  }
  else
    return 0;
}

klippe( str )
{
  if(member(sequenz, getuid(TP))!=-1)
    return 0;
  
  notify_fail("Wo willst Du Dich hinunterstuerzen?\n");
  if(str=="von klippe"||str=="von klippe hinunter"||str=="von klippen"||
     str=="von klippen hinunter") {
    write("Du trittst an den Rand der Klippe heran.\n");
    sequenz+=({getuid(TP)});
    say(CAP_TPN+" tritt an den Rand der Klippe heran. Hoffentlich macht "
        +TPP(WER)+" keinen Bloedsinn ...\n");
    call_out("seq1",4, getuid(TP));
    return 1;
  }
  else
    return 0;
}

seq1(string userid)
{
  if(!TP || environment(TP)!=TO) {
    sequenz-=({userid});
    return;
  }
  write("Du schliesst mit Deinem Leben ab ...\n");
  call_out("seq2",4);
}

seq2(userid)
{
  if(!TP || environment(TP)!=TO) {
    sequenz-=({userid});
    return;
  }
  write(BS("Melancholisch denkst Du noch mal an Deine ersten Tage hier "
      "zurueck, als Dir noch so einige unter die Arme gegriffen haben, "
      "um Dir zu helfen. Einige davon sind jetzt Deine besten Freunde. "
      "Sie werden Dich bestimmt vermissen."));
  call_out("seq3",8);
}

seq3(userid)
{
  if(!TP || environment(TP)!=TO) {
    sequenz-=({userid});
    return;
  }
  write(BS("Du befreist Deine Seele von all der Last, die sich mit der Zeit "
      "aufgestaut hat und schliesslich fasst Du Dir ein Herz und "
      "springst ...\n"));
  call_out("seq4",4);
}

seq4(userid)
{
  if(!TP || environment(TP)!=TO) {
    sequenz-=({userid});
    return;
  }
  write(BS("Genau in dem Augenblick, wo Du von der Klippe springen willst, "
      "erfasst Dich eine kraeftige Windboe und drueckt Dich an die Felswand "
      "hinter Dir. Puh, das war knapp. Na wenn das kein Zeichen war? "
      "Vielleicht solltest Du Dir das ganze doch nochmal ueberlegen ..."));
  say(BS(CAP_TPN+" wird von einer heftigen Windboe erfasst und an die "
        "Felswand gedrueckt. Ist wohl auch besser so, am Ende haette "
        +TPP(WER)+" vielleicht noch was aeusserst dummes angestellt."));
}
