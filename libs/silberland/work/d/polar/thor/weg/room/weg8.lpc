*  Ein Weg durchs Polar - weg8.c  *
*  1999-02-09                     *
**********************************/

#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Aus heiterem Himmel faengt es ploetzlich ziemlich stark an "
           "zu schneien. Oestlich von Dir ist immer noch die Dir nun "
           "alt bekannte Felswand und noerdlich von Dir tuermen sich die "
           "Klippen zu einem unueberwindbaren Hindernis auf. Im Nordosten "
           "kannst Du zwischen dem mittlerweile schon aeusserst dichten "
           "Schneegestoeber einen Pass erkennen, der durch die schroffen "
           "Felsen durchfuehrt."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( "himmel",
	    "Am Himmel haengen dicke Wolken, welche kraeftig Schnee ablassen.");
  AddDetail( ({"wolken", "wolke"}),
      "Die Wolken sehen ziemlich bedrohlich aus.");
  AddDetail( "schnee",
      "Der fallende Schnee macht den Weg noch rutschiger, als er ohnehin "
      "schon ist. Pass bloss auf!");
  AddDetail( "weg",
      "Den kannst Du kaum mehr erkennen.");
  AddDetail( ({"wand", "felswand", "waende", "felswaende"}),
      "Die Felswand ist immer noch genauso steil, schroff und unbezwingbar.");
  AddDetail( ({"klippe", "klippen"}),
      "Selbst ohne dem dichten Schneegestoeber waere es ein Ding der "
      "Unmoeglichkeit, diese Klippen zu ueberwinden.");
  AddDetail( "ding",
      "Einige Dinge sind einfach zu anspruchsvoll.");
  AddDetail( ({"unmoeglich", "unmoeglichkeit"}),
      "Glaub mir, Du wuerdest es nicht schaffen.");
  AddDetail( "hindernis",
      "Weisst Du, was ein Hindernis ist? Etwas, das Dich daran hindert, an "
      "einer gewissen Stelle weiterzukommen.");
  AddDetail( "stelle",
      "Diese Stelle ist hier.");
  AddDetail( ({"schneegestoeber", "gestoeber"}),
      "Das Schneegestoeber wird immer dichter und es ist muehsam, einige "
      "Einzelheiten genau zu erkennen.");
  AddDetail( ({"einzelheiten", "einzelheit"}),
      "Du erkennst keine genaueren ...");
  AddDetail( "felsen",
      "Rings um Dich herum ragen hohe, schroffe Felsen gen Himmel.");
  AddDetail( "pass",
      "Du meinst, einen Pass im Nordosten gesehen zu haben, jedoch ist "
      "der Weg dorthin aeusserst steil und von gewaltigen Schneemassen "
      "versperrt.");
  AddDetail( "schneemassen",
      "Mit normalem Schuhwerk wirst Du es wohl nicht schaffen, diesen "
      "Pass zu erreichen.");
  AddDetail( "boden",
      "Auf dem Boden liegen bereits um die zwanzig Zentimeter Neuschnee.");
  AddDetail( "neuschnee",
      "Du sinkst ein in dem weichen Neuschnee.");
  AddDetail( "zentimeter",
      "Circa zwei Handbreit.");
  AddDetail( "handbreit",
      "Genauer kann ich Dir das leider auch nicht verdeutlichen.");
  AddDetail( "schuhwerk",
      "Schneeschuhe waeren hier wohl das passende Schuhwerk.");
  AddDetail( ({"schneeschuhe", "schuhe"}),
      "Vielleicht hast Du ja etwas dabei, woraus Du Dir ein Paar Schneeschuhe "
      "basteln koenntest?");
  
  AddSound( DEFAULT_SOUND,
      "Ausser dem Heulen des Windes hoerst Du nichts.");
  AddSound( "heulen",
      "HEUUUUUUUUUUUUUL!");
  AddSound( "wind",
      "Der Wind pfeift Dir um die Ohren.");
  AddSound( "pfeifen",
      "Du hoerst nur ein Heulen, kein Pfeifen.");
  
  AddExit( "suedunten", ROOM("weg7"));
  AddExit( "sueden", ROOM("weg7"));
  AddExit( ({"nordosten", "nordostoben"}), ([
        EX_DEST: ROOM("weg9"),
        EX_TESTFUNC: "exit_no"]) );
  SetProp( P_HIDE_EXITS, ({"sueden", "nordosten"}));
}

int exit_no()
{
  object ob;
  
  if(!ob=present("schneeschuhe", TP)) {
    write(BS("Wacker stapfst Du los Richtung Nordosten, jedoch wird der "
          "Schnee immer tiefer und tiefer, sodass Du auf dem steilen Weg "
          "nicht voran kommst. Der Verzweiflung nahe bleibst Du stehen und "
          "gruebelst eine Weile vor Dich hin. Vielleicht hast Du einfach "
          "nicht das passende Schuhwerk dabei?"));
    say(BS(CAP_TPN+" wendet sich nach Nordosten und versucht, den steilen "
          "Weg hinaufzustapfen, kommt aber gegen die riesigen Schneemassen "
          "nicht an gibt nach einer Weile gruebelnd auf."));
    return 0;
  }
  else if(!ob->QueryProp(P_WORN)) {
    write(BS("Du stapfst los Richtung Nordosten, den steilen Weg hinauf, "
          "kommst bei den gewaltigen Schneemassen aber leider nicht "
          "weiter. Vielleicht solltest Du mal Deine Schneeschuhe anziehen?"));
    say(BS(CAP_TPN+" wendet sich nach Nordosten und versucht, den steilen "
          "Weg hinaufzustapfen, kommt aber gegen die riesigen Schneemassen "
          "nicht an gibt nach einer Weile gruebelnd auf."));
    return 0;
  }
  else {
    write(BS("Wacker stapfst Du durch die Schneemassen los nach Nordosten "
          "auf den Pass zu."));
    return 1;
  }
}
