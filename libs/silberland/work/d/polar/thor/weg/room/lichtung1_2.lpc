#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine verschneite Lichtung" );
  SetProp( P_INT_LONG,
           "Vor Dir erstreckt sich eine kleine Lichtung, die Richtung "
           "Norden hin breiter wird. Du stehst bis zu den Knien im Neuschnee "
           "und auch die Nadelbaeume, die die Lichtung umgeben, aechzen "
           "unter der Last des Schnees. Du wunderst Dich, hier ueberhaupt "
           "Baeume vorzufinden, scheinbar gibt es hier auch manchmal einige "
           "waermere Tage, in denen die Temperatur die Null-Grad-Grenze "
           "ueberschreitet."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( ({"pfad", "weg"}),
	    "Ein schmaler Pfad fuehrt nach Suedosten.");
  AddDetail( "lichtung",
      "Die Lichtung wird nach Norden hin groesser.");
  AddDetail( "boden",
      "Der Boden ist mit einer dicken Decke Neuschnee bedeckt.");
  AddDetail( ({"schnee", "neuschnee", "decke", "schneedecke", "pulverschnee"}),
      "Frischer Neuschnee, der Dir durch die Finger rieselt, wenn Du ihn "
      "angreifst.");
  AddDetail( "finger",
      "Er ist kein bisschen klebrig, der Schnee.");
  AddDetail( ({"knie", "kniee"}),
      "Denen ist schon etwas kalt.");
  AddDetail( ({"baeume", "nadelbaeume"}),
      "Einige Tannen und Fichten wachsen hier.");
  AddDetail( ({"tannen", "fichten", "tanne", "fichte"}),
      "Diese Baeume ueberleben sogar im Polar.");
  AddDetail( "polar",
      "Du stehst mitten drin.");
  AddDetail( "last",
      "Die meisten Aeste haengen herab, wegen der grossen Last des Schnees.");
  AddDetail( "aeste",
      "Irgendwann wird es ihnen schon wieder gelingen, den Schnee "
      "abzuschuetteln.");
  AddDetail( ({"tage", "tag"}),
      "An manchen Tagen, besonders wenn die Sonne hell vom Himmel scheint, "
      "kann es hier machmal richtig heiss werden! Angeblich hatte es hier "
      "schon mal ganze acht Grad plus!");
  AddDetail( "grad",
      "Unglaublich, findest Du nicht auch?");
  AddDetail( "temperatur",
      "Auch wenn gerade die Sonne scheint, kann man die Gegend hier nicht "
      "gerade warm nennen.");
  AddDetail( "gegend",
      "Sieh Dich ruhig um.");
  AddDetail( ({"grenze", "nullgradgrenze", "null-grad-grenze"}),
      "Selten, aber doch, wird sie ueberschritten.");
  AddDetail( "himmel",
      "Die Sonne laechelt vom Himmel.");
  AddDetail( "sonne",
      "Sie grinst Dich foermlich an.");
  
  AddSound( DEFAULT_SOUND,
      "Du hoerst ein leises Rascheln von den Baeumen her.");
  AddSound( "rascheln",
      "Vermutlich nur etwas Kleingetier.");
  AddSound( ({"getier", "kleingetier"}),
      "Es raschelt im Unterholz.");
  
  AddCmd( ({"greif", "greife", "beruehr", "beruehre"}), "schnee");
  
  AddExit( "nordosten", ROOM("lichtung4"));
  AddExit( "norden", ROOM("lichtung3"));
  AddExit( "nordwesten", ROOM("lichtung2"));
  AddExit( "suedosten", ROOM("weg20"));
}

schnee( str )
{
  notify_fail("Was willst Du angreifen?\n");
  if(str=="in schnee"||str=="schnee"||str=="schnee an"||str=="in neuschnee"||
     str=="neuschnee"||str=="neuschnee an") {
    write(BS("Du greifst in den Neuschnee und laesst ihn Dir durch die Finger "
          "rieseln. Er ist kein bisschen, ein perfekter Pulverschnee."));
    say(CAP_TPN+" laesst sich etwas Schnee durch die Finger rieseln.\n");
    return 1;
  }
  else
    return 0;
}
