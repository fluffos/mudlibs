#include "../weg.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int rose=1;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch Schnee und Eis" );
  SetProp( P_INT_LONG,
           "Die vereinzelten gefrorenen Rinnsale an der Felswand haben "
           "sich hier zu einem grossen, gefrorenen Wasserfall vergroessert. "
           "In den wenigen Tagen im Jahr, wo es hier taut, scheint hier "
           "eine Menge Schmelzwasser runterzufliessen. Am Rand des grossen "
           "Walles aus Eis siehst Du ausserdem noch einige obskure "
           "Gebilde aus Eis, welche die seltsamsten Formen haben."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( "weg",
	    "Der Weg fuehrt schnurstracks von Westen nach Osten.");
  AddDetail( "boden",
      "Der Boden ist aeusserst eisig.");
  AddDetail( "eis",
      "Gewaltige Mengen an Wasser sind hier an der Felswand zu glattem, "
      "weissem Eis gefroren.");
  AddDetail( "wasser",
      "Gefrorenes Wasser wird fuer gewoehnlich als Eis bezeichnet. Fuer "
      "Schnee gilt uebrigens dieselbe Definition.");
  AddDetail( "schnee",
      "Schnee gibt es hier in rauhen Mengen.");
  AddDetail( "definition",
      "Was willst Du denn definieren?");
  AddDetail( ({"menge", "mengen", "massen", "masse"}),
      "Riesige Mengen an Schnee sind hier ueberall zu sehen.");
  AddDetail( "himmel",
      "Der Himmel ist nun gaenzlich von Wolken befreit und die Sonne strahlt "
      "in ihrem schoensten Laecheln.");
  AddDetail( "laecheln",
      "Du laechelst.");
  AddDetail( ({"wolken", "wolke"}),
      "Keine mehr zu sehen.");
  AddDetail( "sonne",
      "Die Sonne laechelt vom Himmel.");
  AddDetail( ({"rinnsal", "rinnsale", "wasserrinnsal", "wasserrinnsale"}),
      "Die Rinnsale haben sich hier schon zu einem Wasserfall verbreitert.");
  AddDetail( ({"wand", "felswand", "fels", "felsen"}),
      "Von der Felswand ist nicht viel zu sehen, sie ist die ganze "
      "Breite von dem riesigen, erstarrtem Wasserfall verdeckt.");
  AddDetail( "breite",
      "Zumindest die ganze Breite, die Du von hier ueberblicken kannst.");
  AddDetail( ({"wall", "fall", "wasserfall"}),
      "Fasziniert betrachtest Du den riesigen Wasserfall, der in seiner "
      "ganzen Wildheit zu Eis erstarrt ist. Waere dies nicht der Fall, "
      "wuerdest Du hier wohl kaum so ruhig stehen koennen, sondern "
      "der ganze Weg hier waere ueberschwemmt.");
  AddDetail( "wildheit",
      "Der Wasserfall ist in seiner ganzen Wildheit hier erstarrt.");
  AddDetail( "fall",
      "Nein, hier kannst Du nirgends runterfallen.");
  AddDetail( ({"tage", "tag"}),
      "365 Tage hat das Jahr.");
  AddDetail( "jahr",
      "Ein Jahr hat 365 Tage.");
  AddDetail( "schmelzwasser",
      "Bei diesen Massen an Schnee hier ueberall verwundert es Dich nicht "
      "weiter, dass es auch dementsprechend viel Schmelzwasser gibt, sollte "
      "es hier mal um einige Grad waermer werden.");
  AddDetail( "grad",
      "Wenn die Sonne in den milderen Jahreszeiten mal auf ein Schneefeld "
      "scheint, kann es schon vorkommen, dass so einiges an Schnee schmilzt.");
  AddDetail( ({"jahreszeit", "jahreszeiten", "zeit", "zeiten"}),
      "Die meisten Jahreszeiten hier sind grimmig kalt.");
  AddDetail( ({"schneefeld", "feld"}),
      "Gelegentlich schafft es die Sonne, ein Schneefeld etwas aufzutauen.");
  AddDetail( "rand",
      "Am Rand des Wasserfalls wachsen einige fremdartig anmutende Gebilde "
      "aus dem Eis heraus.");
  AddDetail( "formen",
      "Die Formen der Gebilde sind einfach zu obskur, um irgend etwas "
      "hineininterpretieren zu koennen.");
  AddDetail( "vorsicht",
      "Alles immer schoen mit Vorsicht angehen!");
  AddSpecialDetail( "gebilde", "unt_gebilde");
  AddSpecialDetail( "form", "unt_form");
  AddSpecialDetail( "rose", "unt_rose");
      
  
  AddSound( DEFAULT_SOUND,
      "Ein leises Lueftchen wispert Dir ins Ohr.");
  AddSound( "lueftchen",
      "Leider verstehst Du nicht, was es Dir sagen will.");
 
  AddCmd( ({"pfluecke", "pflueck"}), "rose");
  AddCmd( ({"definiere", "definer"}), "definieren");
  
  AddExit( "osten", ROOM("weg18"));
  AddExit( "westen", ROOM("weg16"));
}

reset()
{
  rose=1;
  ::reset();
}

definieren( str )
{
  notify_fail("Was willst Du definieren?\n");
  if(!str)
    return 0;

  write("Du definierst "+str+".\n");
  say(CAP_TPN+" definiert "+str+".\n");
  return 1;
}

rose( str )
{
  object ob;
  
  notify_fail("Was willst Du pfluecken?\n");
  if(str=="rose"||str=="eisrose") {
    if(rose) {
      write("Mit groesster Vorsicht pflueckst Du die Eisrose.\n");
      say(CAP_TPN+" pflueckt vorsichtig eine Eisrose.\n");
      ob=clone_object(OBJ("eisrose"));
      if(ob->move(TP, M_GET|M_SILENT)==ME_TOO_HEAVY) {
        write("Da Dir die Rose zu schwer ist, legst Du sie auf den Boden.\n");
        ob->move(ME);
      }
      rose=0;
      return 1;
    }
    else {
      write("Hier sind gerade keine Eisrosen.\n");
      return 1;
    }
  }
  else
    return 0;
}

string unt_gebilde()
{
  if(rose)
    return BS("Die meisten Gebilde haben solch seltsame, verdrehte Formen, "
        "dass Du mit ihnen nicht wirklich etwas anfangen kannst. Eines "
        "jedoch scheint die Form einer Rose zu haben.");
  else
    return BS("Die meisten Gebilde haben solch seltsame, verdrehte Formen, "
        "dass Du mit ihnen nicht wirklich etwas anfangen kannst.");
}

string unt_form()
{
  if(rose)
    return "Ja, es scheint sich tatsaechlich um eine Rose zu handeln!\n";
  else
    return BS("Die Formen der Gebilde sind einfach zu obskur, um irgend "
        "etwas hineininterpretieren zu koennen.");
}

string unt_rose()
{
  if(rose)
    return BS("Sie wirkt aeusserst zerbrechlich, aber mit groesster "
        "Vorsicht koenntest Du sie vielleicht pfluecken.");
  else
    return "Hier ist gerade keine Rose.\n";
}
