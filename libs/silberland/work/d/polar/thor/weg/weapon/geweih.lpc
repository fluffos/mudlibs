// Elchgeweih
// Filename: geweih.c
// File by Rage, Jaenner 05

#include "../weg.h"
inherit "std/weapon";

#include <properties.h>
#include <language.h>
#include <combat.h>

int spannweite = 150+random(140);

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Elchgeweih");
  SetProp(P_LONG,
    "Elchgeweihe koennen im Einzelfall mehr als 2,5 Meter umspannen. "
    "Dieses hat eine Spannweite von "+spannweite+" Zentimter. Im "
    "Vergleich zu einem Hirschgeweih ist dieses ein gewaltiges "
    "Schaufelgeweih mit sehr grossen Schaufeln, welche am Rand mit "
    "kleinen Fortsaetzen bestueckt sind." );
  AddDetail( "spannweite",
    "Dieses Geweih hat eine von "+spannweite+" Zentimeter." );
  AddDetail( ({ "fortsatz","fortsaetze", }),
    "Am Rand des Geweihs sind mehrere kleine Fortsaetze, die recht "
    "spitz sind." );
  AddDetail( ({ "schaufel","schaufeln" }),
    "Die Bezeichnung ist zurecht, denn das Geweih erinnern Dich "
    "tatsaechlich an Schaufeln. Sie haben eine fast quadratische "
    "Form und sind leicht gewoelbt." );
  SetProp(P_NAME, "Elchgeweih");
  SetProp(P_GENDER, NEUTER);
  AddId(({"geweih", "elchgeweih"}));
  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_DAM_TYPE, ({DT_PIERCE,DT_BLUDGEON,DT_BLUDGEON,DT_BLUDGEON}) );
  SetProp(P_WC, 140);
  SetProp(P_WC_FIX, 25);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_HORN:100]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 10*spannweite);
  SetProp(P_WC_BONUS, (["elch": 100]) );
}

