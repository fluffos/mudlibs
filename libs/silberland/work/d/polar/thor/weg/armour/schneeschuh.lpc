inherit "std/armour";

#include "../weg.h"

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moving.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"schuh", "schneeschuh", "\nschneeschuh"}));
  SetProp (P_SHORT, "Ein einzelner Schneeschuh");
  SetProp (P_LONG, "Der Schneeschuh wurde ziemlich primitiv aus einer "
     "starken Astgabel und einem Wolfsfell zusammengebastelt, aber er "
     "erfuellt bestimmt seinen Zweck. Ein einzelner davon wird Dir aber "
     "leider nicht sehr viel helfen ...");
  SetProp (P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:0, T_HEAT_PROT:0]));
  SetProp (P_NAME, "Schneeschuh");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 150);
  SetProp (P_VALUE, 150);

  SetProp (P_MATERIAL, ([MAT_PELT:50, MAT_WOOD:50]));
  SetProp (P_ARMOUR_TYPE, AT_MISC);
  SetProp (P_AC, 0);

  SetProp (P_WEAR_FUNC, TO);
}

init()
{
  object ob, other;
  ::init();

  if ( !MENV ) return;
  if ( !interactive(MENV) ) return;
  other=0;
  ob=ME;
  while ((ob=next_inventory(ob)) && !other)
    if ( ob->id("\nschneeschuh") )
      other=ob;
  if (other)
    call_out ("basteln", 0, other, MENV);
  return;
}

basteln(object other, bastler)
{
  tell_object( bastler,BS(
    "Endlich hast Du einen zweiten Schneeschuh, womit Du mit einem Paar "
    "Schneeschuhe durch den Schnee stapfen kannst.") );
  tell_room( ENV(bastler),
    bastler->name()+" freut sich ueber ein Paar Schneeschuhe.\n",
    ({bastler}));
  clone_object(ARMOUR("schneeschuhe")) -> move(bastler, M_NOCHECK);
  other->remove();
  call_out ("remove", 0);
  return;
}

int WearFunc(object me)
{
  write(BS("Du befestigst den einzelnen Schneeschuh an Deinen Fuessen, kommst "
        "aber zu dem Schluss, dass er Dir allein nicht viel helfen wird, "
        "und ziehst ihn daher wieder aus."));
  say(BS(CAP_TPN+" zieht einen einzelnen Schneeschuh an und dann gleich "
        "wieder aus. Was "+TPP(WER)+" wohl damit bezwecken wollte?"));
  return 0;
}


