inherit "std/armour";

#include "../weg.h"

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

#define FEUER_ABWEHR 150

int count=100;

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"schild", "eisschild"}));
  SetProp (P_SHORT, "Ein Eisschild");
  SetProp (P_LONG,
      "In Deinen Haenden haeltst Du einen Schild aus spiegelblankem Eis. "
      "Er ist umgeben von einer magischen Aura und wohl nicht so "
      "zerbrechlich, wie er auf den ersten Blick aussehen mag.\n");
  SetProp (P_NAME, "Eisschild");
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:-4, T_HEAT_PROT:4 ]) );
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 1500);
  SetProp (P_VALUE, 6000);
  SetProp (P_INFO, "Der Schild schuetzt Dich sehr gut vor Feuer.\n");
  
  AddDetail( "eis",
      "Im blanken Eis kannst Du Dein Spiegelbild erkennen.");
  AddSpecialDetail( ({"bild", "spiegelbild"}), "unt_spiegelbild");
  AddDetail( "aura",
      "Sie verstaerkt den Schild wohl zusaetzlich und sorgt dafuer, dass "
      "er in waermeren Gegenden nicht schmilzt.");
  
  SetProp (P_MATERIAL, ([MAT_ICE:80, MAT_MISC_MAGIC:20]) );
  SetProp (P_ARMOUR_TYPE, AT_SHIELD);
  SetProp (P_AC, 29);
  SetProp (P_WEAR_RESTRICTIONS, ([A_STR:15, SR_SEER:1]) );
  SetProp (P_DEFEND_FUNC, TO);
}

string unt_spiegelbild()
{
  TP->command_me("unt "+getuid(TP));
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
{
  if (!objectp(QueryProp(P_WORN)))
    return 0;

  /*
  if (mappingp(spell))
    tell_object(QueryProp(P_WORN),
        sprintf("---dam: %d\n",spell[SI_SKILLDAMAGE]));
  */

  if(!count) {
    tell_object(QueryProp(P_WORN),
        "Der Eisschild zersplittert in tausend kleine Stueckchen und\n"
        "die Splitter fliegen Dir um die Ohren.\n");
    QueryProp(P_WORN)->AddHp(-20-random(21));
    call_out("weg", 0);
    return 0;
  }

  if( (sizeof(dtyp)==1) && (dtyp[0]==DT_FIRE) ) {
    tell_object(QueryProp(P_WORN),
        "Der Eisschild wehrt einen Teil des Angriffs ab.\n");
    count--;
    return FEUER_ABWEHR;
  }
  return 0;
}

weg()
{
  ME->remove();
}

