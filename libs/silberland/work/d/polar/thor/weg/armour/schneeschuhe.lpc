*******************************************/

inherit "std/armour";

#include "../weg.h"

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"schuhe", "schneeschuhe", "schuh", "schneeschuh"}));
  SetProp (P_SHORT, "Ein Paar Schneeschuhe");
  SetProp (P_LONG, "Die Schneeschuhe wurden ziemlich primitiv aus einer "
     "starken Astgabel und einem Wolfsfell zusammengebastelt, aber sie "
     "erfuellen bestimmt ihren Zweck.");
  SetProp (P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:0, T_HEAT_PROT:0]));
  SetProp (P_NAME, "Paar Schneeschuhe");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 300);
  SetProp (P_VALUE, 300);

  SetProp (P_MATERIAL, ([MAT_PELT:50, MAT_WOOD:50]));
  SetProp (P_ARMOUR_TYPE, AT_MISC);
  SetProp (P_AC, 0);

  SetProp (P_REMOVE_FUNC, TO);
  SetProp (P_WEAR_FUNC, TO);
}

int WearFunc(object me)
{
  object *ob;
  ob=({find_object(ROOM("weg9")), find_object(ROOM("weg10"))})-({0});
  if(!ob || member(ob, environment(TP))==-1) {
    TP->AddPursuer(ME);
    return 1;
  }
  else if(member(environment(TP)->QueryProp(P_STUCK), getuid(TP))==-1) {
    TP->AddPursuer(ME);
    return 1;
  }
  else {
    write(BS("Du steckst doch bis zum Bauch im Schnee, wie willst Du Dir "
        "da Deine Schneeschuhe anziehen?!"));
    return 0;
  }
}  

int RemoveFunc(object me)
{
  object *ob;
  ob=({find_object(ROOM("weg9")), find_object(ROOM("weg10"))})-({0});
  if(!ob || member(ob, environment(TP))==-1) {
    TP->RemovePursuer(ME);
    return 1;
  }
  else {
    write(BS("Du ziehst Dir Deine Schneeschuhe aus und im gleichen Moment "
          "sinkst Du bis ueber die Hueften in den tiefen Schneemassen ein. "
          "Tja, das war wohl keine so gute Idee ... Irgendjemand sollte Dich "
          "hier moeglichst schnell ausbuddeln."));
    if(member(environment(TP)->QueryProp(P_STUCK), getuid(TP))==-1) {
    environment(TP)->SetProp(P_STUCK, 
                     environment(TP)->QueryProp(P_STUCK)+({getuid(TP)}));
    }
    TP->RemovePursuer(ME);
    return 1;
  }
}

int PreventFollow( object dest ) 
{
  if (TP)
    if (ME->QueryWorn())
      TP->do_exhaust(50, 1);
    else
      TP->RemovePursuer(ME);
  return 1;
}
