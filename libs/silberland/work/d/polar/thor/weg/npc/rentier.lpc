inherit "std/mnpc";

#include "../weg.h"

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Rentier");
  SetProp(P_LONG,
    "Ein grosses Rentier, das quer durchs Polar rennt.");
  SetProp(P_NAME, "Rentier");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN: -20, T_RANGE_MAX: 10]));
  AddId( ({"rentier", "tier"}) );

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit seinen Hufen", 100, DT_BLUDGEON}));
//  SetProp(P_MAX_HP, );
//  SetProp(P_BODY, );
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_RACE, "Rentier");
  SetProp(P_SIZE, 180);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "trabt herein");
  SetProp(P_MSGOUT, "trabt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, ROOM("weg") );
  SetProp(P_MNPC_WAIT, ({ 10, 20, 10 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM("weg21"));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);


  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "kuckt Dich nur bloede an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Rentier kuckt Dich verwirrt an.\n" }) );
}
