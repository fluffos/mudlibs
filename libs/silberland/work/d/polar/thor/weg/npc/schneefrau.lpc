// StartReactions


void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  
  if (find_call_out("reaction") != -1) return;

  switch (gruppe) {

    case "aengstlich":
      call_out("reaction", 0, TP, 
        "verwuschelt Dir aufbauend Deine Haare.",
        "verwuschelt aufbauend "+TP->name(WESSEN)+" Haare.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "grummelt.",
        "grummelt.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "bricht vor Lachen zusammen.",
        "bricht vor Lachen zusammen.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "zieht Dir die Ohren lang.",
        "zieht "+TP->name(WEN)+" die Ohren lang.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "blickt Dich tadelnd an.",
        "blickt "+TP->name(WEN)+" tadelnd an.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "freut sich.", 
        "freut sich.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "erroetet und sagt: Nicht doch, wenn das mein Mann sieht!",
        "erroetet und sagt: Nicht doch, wenn das mein Mann sieht!");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "knuddelt Dich in Grund und Boden.",
        "knuddelt "+TP->name(WEN)+" in Grund und Boden.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "blickt Dich mit ihren grossen Kohlekulleraugen an.",
        "blickt "+TP->name(WEN)+" mit ihren grossen Kohlekulleraugen an.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        "troestet "+TP->name(WEN)+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
