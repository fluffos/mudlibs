*  Eine Schneefrau - schneefrau.c  *
*  Quest-NPC fuer die Quest        *
*  "Schneemama sucht Schneepapa    *
*  1999-02-27                      *
***********************************/


inherit "std/npc";

#include "../weg.h"

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Schneemama");
  SetProp(P_LONG,
    "Die Schneemama mustert Dich mit einem teils freundlichen, teils "
    "traurigen Blick. Sie sieht genau so aus, wie Du Dir immer eine "
    "Schneemama vorgestellt hast. Sie besteht hauptsaechlich aus drei "
    "perfekt geformten Schneekugeln, hat eine grosse, rote Karotte mitten "
    "im Gesicht und grosse, schwarze Kohlenkulleraugen, aus denen sie "
    "Dich mit einem solch fuersorglichen Blick ankuckt, wie es wohl nur "
    "eine Mama kann.");
  SetProp(P_NAME, "Schneemama");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-200,T_RANGE_MAX:5]));
  AddId(({"mama", "schneemama", "frau", "schneefrau", "\nsmama", "NOWIMPY"}));

  create_default_npc(18);
  SetProp(P_HANDS, ({" mit einigen Schneebaellen", 150, DT_COLD}));
  SetProp(P_RACE, "Schneemann");
  SetProp(P_SIZE, 170);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      1.0, DT_COLD:     -1.0, DT_WATER:  0.5, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kullert herein");
  SetProp(P_MSGOUT, "kullert");
  SetProp(P_MMSGIN, "erscheint in einer Lawine");
  SetProp(P_MMSGOUT, "faellt auseinander");

  SetProp(P_DIE_MSG,  " schmilzt dahin.\n");
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "Tut mir leid, da kann ich Dir nicht helfen.","sagt: ");

  AddInfo( ({"mann", "papa", "schneemann", "schneepapa"}),
      "Mein liebender und fuersorglicher Mann ist vor einigen Tagen "
      "geschmolzen, als die Sonne mal besonders stark hier auf die Lichtung "
      "schien. Ich vermisse ihn so sehr und haette ihn so furchtbar gern "
      "zurueck!", "schluchzt: ");
  AddInfo( "sonne",
      "Die Sonne kann auch hier manchmal recht stark werden.","seufzt: ");
  AddInfo( ({"haeufchen", "haufen"}),
      "wimmert: Das war einmal Mann! Wenn ich ihn nur wiederhaben\nDie "
      "Schneemama wimmert: koennte!\n"
      "Die Schneemama bricht in Traenen aus und weint bitterlich.\n"
      "Die Schneemama fragt verzweifelt: Kannst Du mir nicht irgendwie helfen? "
      "Bitte,\nDie Schneemama fragt verzweifelt: ich flehe Dich an! Er fehlt "
      "mir so!");
  AddInfo( ({"eiszapfen", "zapfen", "magischer eiszapfen", 
        "magischen eiszapfen"}),
      "Die Seelen von uns Schneemaennern und Schneefrauen sind in solch "
      "magischen Eiszaepfen enthalten. Du solltest gut auf so einen Eiszapfen "
      "acht geben, schliesslich haeltst Du die Seele eines Lebewesens in "
      "Deinen Haenden.", "erklaert: ");
  AddInfo( ({"bestandteile", "bestandteil", "teile", "dinge"}),
      "Also, ein Schneemann sollte auf jeden Fall mal aus folgenden Dingen "
      "bestehen:\nDu brauchst eine grosse, eine mittlere und eine kleine "
      "Kugel Schnee. Der Schnee muss dafuer ziemlich klebrig sein, damit "
      "die Kugeln auch einen ordentlichen Zusammenhalt haben. Danach brauchst "
      "Du noch eine schoene, grosse, rote Karotte, damit der Schneemann auch "
      "eine Nase hat und ausserdem noch einige Stuecke Kohle fuer Augen, Mund "
      "und Knoepfe. Und ausserdem brauchst Du dann noch einen schwarzen "
      "Hut und einen Schal, weisst Du, mein Schneepapa kriegt naemlich sehr "
      "leicht Halsweh, und da braucht er den Schal unbedingt. Ein Besen waere "
      "vielleicht auch nicht schlecht, damit er mir manchmal im Haushalt "
      "behilflich sein kann.", "sagt: ");
  AddInfo( "hut",
      "Hach, mein Schneepapa war so fesch mit seinem Hut! Ich glaube, sein "
      "alter muesste hier noch irgendwo auf der Lichtung rumliegen.", "sagt: ");
  AddInfo( "schal",
      "Mein Schneepapa ist ein sehr empfindlicher Mann. Hach, sind nicht alle "
      "Maenner empfindlich, was meinst Du da? Sein alter Schal wurde vom "
      "Wind hier verweht, vielleicht findest Du ihn ja noch irgendwo in der "
      "Naehe.", "sagt: ");
  AddInfo( "maenner",
      "Ich glaube, alle Maenner sind furchtbar empfindlich oder tun zumindest "
      "so ;)", "zwinkert Dir zu: ");
  AddInfo( "halsweh",
      "Ja, sehr anfaellig war er gegen Halsweh. Ich hab immer schon gesagt, "
      "er solle sich die Mandeln entfernen lassen, aber das wollte er immer "
      "nicht. Hat lieber jammernd vor sich hingelitten.");
  AddInfo( "mandeln",
      "Ich werde immer so traurig, wenn ich ueber ihn rede. Dann merke ichs "
      "nochmal so schlimm, wie sehr er mir fehlt.", "schluchzt: ");
  AddInfo( "besen",
      "Da fragst Du am besten den Dorfaeltesten der Xandim.", "sagt: ");
  AddInfo( ({"aeltester", "dorfaeltester"}),
      "Yrmalaru heisst er, glaub ich.", "sagt: ");
  AddInfo( "yrmalaru",
      "Ein sehr alter, weiser Mann.");
  AddInfo( "haushalt",
      "Der soll mir ruhig ein wenig unter die Arme greifen, der Faulpelz!",
      "sagt: ");
  AddInfo( "faulpelz",
      "Mein Mann war immer schon ein Faulpelz. Aber er war immer lieb und "
      "fuersorglich.", "seufzt: ");
  AddInfo( "kohle",
      "Ein Wanderer hat mir einmal erzaehlt, dass es hier bei einem "
      "Felsueberhang eine geschuetzte Lagerstelle gibt. Vielleicht findest "
      "Du dort ja noch etwas Kohle von einem Lagerfeuer.", "gruebelt: ");
  AddInfo( "wanderer",
      "Manchmal kommt mich der eine oder andere besuchen", "sagt: ");
  AddInfo( ({"ueberhang", "felsueberhang"}),
      "Er erzaehlte, dass man dafuer die Felswand hochklettern musste, um den "
      "Ueberhang zu erreichen. Dafuer war er schoen windstill.", "sagt: ");
  AddInfo( ({"wand", "felswand"}),
      "Ganz in der Naehe gibts glaub ich ne recht grosse.", "sagt: ");
  AddInfo( ({"lagerstelle", "lagerfeuer", "feuer", "plaetze", "lagerplaetze"}),
      "Hier gibt es nur sehr wenige windgeschuetzte Lagerplaetze, an denen "
      "man auch ein Lagerfeuer entzuenden kann.", "sagt: ");
  AddInfo( ({"augen", "auge", "mund", "knopf", "knoepfe"}),
      "Dafuer verwendest Du am besten Kohle.");
  AddInfo( "nase",
      "Als Nase nimmst Du am besten eine Karotte.", "raet Dir: ");
  AddInfo( ({"karotte", "lebensmittel"}),
      "Lebensmittel findest Du wohl am besten in einer Kneipe.", "sagt: ");
  AddInfo( "kneipe",
      "In Yiqanuc gibts bestimmt eine.", "sagt: ");
  AddInfo( ({"kugel", "kugeln", "schneekugel", "schneekugeln"}),
      "Es muss eine grosse, eine mittlere und eine kleine Kugel sein und "
      "sie muessen aus weissestem Schnee sein und eine perfekte Rundung "
      "haben.", "sagt: ");
  AddInfo( "schnee",
      "Der Schnee hier auf der Lichtung ist leider viel zu fein und pulverig. "
      "Man muesste ihn mit Wasser anfeuchten, damit er etwas klebriger wird. ",
      "sagt: ");
  AddInfo( "lichtung",
      "Die Lichtung hier ist meine Heimat.", "sagt: ");
  AddInfo( "wasser",
      "Hm, am besten Du besorgst Dir mal eine Giesskanne, fuellst sie hier "
      "mit Schnee und stellst sie dann an ein sonniges Plaetzchen, damit "
      "der Schnee drin schmelzen kann.", "empfiehlt: ");
  AddInfo( ({"kanne", "giesskanne"}),
      "Der Haendler bei den Xandim, ich denke Bagol war sein Name, hatte mal "
      "eine Giesskanne.", "sagt: ");
  AddInfo( "bagol", 
      "Das ist der Haender der Xandim.", "sagt: ");
  AddInfo( "xandim",
      "Die wohnen in Yiqanuc.", "sagt: ");
  AddInfo( "yiqanuc",
      "Yiqanuc findest Du etwas weiter im Nordosten von hier.", "sagt: ");
  AddInfo( ({"rundungen", "rundung"}),
      "Die Schneekugeln muessen richtig schoen rund sein. Also gib Dir "
      "Muehe!", "sagt: ");
  AddInfo( ({"plaetzchen", "platz"}),
      "Hier in der Naehe gibts es ein sehr schoenes, sonniges Plaetzchen, "
      "wo sich einige der Leute, die hier immer vorbeikommen, sogar sonnen, "
      "damit sie etwas mehr Farbe im Gesicht bekommen.", "sagt: ");
  AddInfo( "leute",
      "Meistens ist es sehr ruhig hier, nur manchmal besuchen uns einige "
      "Leute.", "sagt: ");
  AddInfo( ({"farbe", "gesicht"}),
      "Ich weiss auch nicht, wieso ihrs euch so sehr auf die Farbe in eurem "
      "Gesicht steht. Kannst Du mir das erklaeren?", "sagt: ");
  AddInfo( ({"zusammenhalt", "halt"}),
      "Natuerlich muss der Schnee ordentlich halten, sonst faellt mein "
      "Schneepapa ja wieder gleich auseinander!", "meint: ");

      
  
  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Die Schneemama sagt: Behalt Dir das lieber, vielleicht brauchst Du das "
    "ja noch\n"}) );

  AddCmd( ({"hilf", "helfe"}), "help");
  AddCmd( ({"erklaere", "erklaer"}), "explain");
  
  /*
  SetProp(P_SPELLRATE,0);
  AddSpell(1,0,
    ".\n",
    ".\n",
     DT_,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    ".\n"}) );
  SetAttackChats(10, ({
    ".\n"}) );

  SUID;
  CLONEME(WEAPON "" );
  command("zuecke waffe");
  CLONEME(ARMOUR "" );
  command("trage alles");*/
}

help( str )
{
  notify_fail("Wem willst Du helfen?\n");

  if( id(str) )
    if(!present("\nspirit", TP)) {
      write("Die Schneemama laechelt Dich gluecklich an.\nDie Schneemama "
          "fragt Dich: Du willst mir wirklich wieder meinen Schneepapa\n"
          "Die Schneemama fragt Dich: zurueckbringen?\nDie Schneemama huepft "
          "vor Freude um Dich herum.\n"+break_string(
          "Ach, Du wirst vermutlich wissen wollen, was "
          "Du nun tun sollst. Also, es ist eigentlich ganz einfach. Du musst "
          "hier neben mir auf der Lichtung den schoensten Schneemann Deines "
          "Lebens bauen. Mein Schneepapa war naemlich ein fescher Mann, musst "
          "Du wissen! Dafuer darfst Du natuerlich auch auf keines der "
          "wichtigen Bestandteile vergessen, die ein Schneemann so braucht. "
          "Wenn Du mit dem Schneemann dann fix und fertig bist, musst Du ihm "
          "an der Stelle, wo ihr Menschen euer Herz habt, diesen magischen "
          "Eiszapfen hier hineinstecken. Wir Schneemaenner/frauen sterben "
          "naemlich nicht gleich, sobald wir geschmolzen sind, sondern "
          "wir haben alle einen solchen Eiszapfen, der unsere Seele "
          "beinhaltet. Wenn Du ihm diesen Eiszapfen an der Stelle seines "
          "Herzens hineinsteckst, wird er wieder zum Leben erwachen.", 78, 
          "Die Schneemama sagt: ")+
          "Mit diesen Worten reicht Dir die Schneemama vorsichtig einen langen "
          "Eiszapfen.\n");
      say("Die Schneemama fluestert "+TP->name(WEM)+" erfreut etwas zu.\n", TP);
      clone_object(QOBJ("spirit"))->move(TP, M_NOCHECK);
      return 1;
    }
    else {
      write(break_string("Ich hab Dir den magischen Eiszapfen doch schon "
            "gegeben. Bist Du etwa schon fertig?", 78, "Die Schneemama "
            "sagt: "));
      say(CAP_TPN+" tuschelt mit der Schneemama.\n", TP);
      return 1;
    }
  else
    return 0;
}

explain( str )
{
  string *in;
  notify_fail("Wem willst Du was erklaeren?\n");
  if(!str) return 0;
  in=explode(str, " ");
  if(id(in[0])) {
    write("Du erklaerst der Schneefrau etwas.\nDie Schneefrau gibt ein "
        "verstehendes \"Ahaaaa!\" von sich und nickt dankend.\n");
    say(CAP_TPN+" erklaert der Schneefrau etwas, woraufhin diese verstehend "
        "nickt.\n", TP);
    return 1;
  }
  else
    return 0;
}
  
  
  
  
