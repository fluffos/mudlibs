/**********************
*  Thor@SilberLand    *
*  Ein Elch - elch.c  *
*  1999-02-21         *
**********************/

inherit "std/mnpc";

#include "../weg.h"

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Elch");
  SetProp(P_LONG,
    "Vor dir steht ein Exemplar der groessten Hirschart, naemlich ein "
    "grosser Elch. Sein Geweih ragt weit ueber seinen langgezogenen "
    "Kopf und vor seinen Nasenloechern siehst du die kalte Luft, die "
    "er ausstoesst. Er besitzt relativ lange Beine und einen kurzen Hals. "
    "Der Ruecken ist sehr ausgepraegt und daher aehneln Elche in ihrer "
    "Statur mehr den Pferden." );

  SetProp(P_NAME, "Elch");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN: -20, T_RANGE_MAX: 10]));
  AddId( "elch" );

  AddDetail( ({ "exemplar","hirschart" }),
    "Mit dem Elch steht vor Dir die groesste Hirschart, die Du kennst." );
  AddDetail( "fell",
    "Sein Fell ist dunkelbraun und ziemlich struppig, nur die Laeufe "
    "besitzen eine helle Faerbung.");
  AddDetail( ({ "laeufe","faerbung" }),
    "Die Laeufe sind heller als das restliche Fell des Elches." );
  AddDetail( "geweih",
    "Das Geweih des Elchs ist wahrlich riesig. Es hat von einem Ende bis "
    "zum anderen etwa eine Laenge von zwei Meter.");
  AddDetail( "kopf",
    "Der Kopf ist langgezogen und als Du ihn naeher betrachtest, faellt "
    "Dir auch die breite Oberlippe auf." );
  AddDetail( ({ "oberlippe","muffel" }),
    "Auffaellig ist die vergroeßerte, knorpelige Oberlippe, auch Muffel "
    "genannt, welche eine wichtige Hilfe beim Aesen ist. Insbesondere "
    "das Abbrechen von Zweigen und Abstreifen von Rinde wird durch die "
    "Muffel erleichtert." );
  AddDetail( ({ "bein","beine" }),
    "Die Beine sind recht lang und enden in breiten, spreizbaren Hufen, "
    "mit denen sich Moore durchwandern koennen." );
  AddDetail( ({ "nasenloch","nasenloecher" }),
    "Sie sind im Vergleich zu Deinen riesig und vor ihnen siehst Du die "
    "kalte Luft, die sie ausstossen." );
  AddDetail( ({ "luft","dampf" }),
    "Um genau zu sein, siehst Du den Dampf der kalten Luft." );
  AddDetail( "hals",
    "Der Hals verbindet den Kopf mit dem Rest vom Koerper, aber ausser "
    "dass er im Verhaelnis zu anderen Koerperteilen kurz ist, faellt "
    "Dir nichts auf." );
  AddDetail( ({ "statur","ruecken","koerper" }),
    "Der Ruecken ist recht breit und es waere fast genug Platz fuer "
    "Dich darauf, dass Du auf dem Elch reiten koenntest. Allerdings "
    "denke ich nicht, dass er das zulassen wuerde." );
  
  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinem Geweih", 150, DT_BLUDGEON}));
  SetProp(P_RACE, "Elch");
  SetProp(P_SIZE, 190);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "trabt herein");
  SetProp(P_MSGOUT, "trabt");
  SetProp(P_MMSGIN, "trabt herein");
  SetProp(P_MMSGOUT, "verschwindet hinter einer Schneewehe");
  SetProp(P_MNPC_AREA, ROOM("weg") );
  SetProp(P_MNPC_WAIT, ({ 10, 20, 10 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM("weg4"));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "kuckt Dich nur bloede an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Nicht doch, sonst kippt er noch um!\n" }) );

  SetProp( P_SPELLRATE, 20 );
  AddSpell( 1, 250,
    Name(WER,1)+" rammt Dich mit seinem breiten Geweih.\n",
    Name(WER,1)+" rammt @WEN mit seinem breiten Geweih.\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SUID;
  CLONEME(WEAPON("geweih"));
  command_me("zuecke geweih");
}
