inherit "std/mnpc";

#include "../weg.h"

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Eiswolf");
  SetProp(P_LONG,
    "Vor Dir steht ein ziemlich grosser Wolf. Er hat ein dickes, struppiges "
    "Fell, scheint darunter aber ziemlich abgemagert zu sein. Er blickt Dich "
    "aus hungrigen Augen an.");
  SetProp(P_NAME, "Eiswolf");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN: -30, T_RANGE_MAX: 10]));
  AddId( ({"wolf", "eiswolf"}) );

  AddDetail( "fell",
      "Der Wolf hat ein ziemlich dickes, struppiges Fell.");
  AddDetail( "augen",
      "Er scheint wohl nicht sehr viel zu fressen zu bekommen hier. Nimm Dich "
      "lieber in Acht!");
  
  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinem scharfen Gebiss", 150, DT_RIP}));
  SetProp(P_RACE, "Wolf");
  SetProp(P_SIZE, 140);
  SetProp(P_ALIGN, -50);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "hechelt herein");
  SetProp(P_MSGOUT, "hechelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, ROOM("weg") );
  SetProp(P_MNPC_WAIT, ({ 10, 10, 10 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM("weg7"));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "knurrt bedrohlich.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Wolf knurrt Dich bedrohlich an.\n" }) );

  SUID;
  CLONEME("/p/armour/cloak/wolfsfell");
  command_me("trage alles");
}
