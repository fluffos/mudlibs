#include "../weg.h"

int RAEUME = 10+random(6);
mapping AUSGAENGE = (["nordosten"  :"suedwesten",
                      "suedwesten" :"nordosten",
                      "suedosten"  :"nordwesten",
                      "sueden"     :"norden",
                      "osten"      :"westen"]);

int i;
mapping rueckweg=([]);

create()
{
  if (is_clone(this_object())) 
    {
    destruct(this_object());
    return 1;
    }
  seteuid(getuid(this_object()));
  rueckweg=([]);
}

query_prevent_shadow() { return 1; }

//map([thor:([woody:"text", bla:"text"]) ])
  
/* Exits generieren */

int CreateExits(object who)
{
  string *temp, raus;

  temp = m_indices(AUSGAENGE); 
  
  if(member(rueckweg, getuid(who)))
    return 0;
    
  rueckweg+=([getuid(who):({})]);
  
  for(i = 0; i <= RAEUME; i++) {
    raus=temp[random(sizeof(temp)-1)];
    rueckweg[getuid(who)]+=({raus});
    temp = m_indices(AUSGAENGE) - ({AUSGAENGE[raus]}) - ({raus});
  }
  return 1;
}

/* Ausgaenge abfragen */

varargs mixed CheckExits( string spieler )
{
  if(!spieler)
    return rueckweg;
  else if(member(rueckweg, spieler))
    return rueckweg[spieler];
  else
    return 0;
}

string CheckNextExit( string spieler, int e )
{
  if(!spieler || !member(rueckweg, spieler))
    return 0;
  
  return (rueckweg[spieler])[e];
}

int DeleteExits(string who)
{
 if(!who) return -1;
 if(!member(rueckweg, who))
   return 0;
 rueckweg=m_delete(rueckweg, who);
 return 1;
}
