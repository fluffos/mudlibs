#include "../xandim.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Kriegsaxt");
  SetProp(P_LONG, 
      "Eine riesige Kriegsaxt, welche so gross ist, dass sie wohl nur "
      "Xandim und groessere Rassen wirklich gut handhaben koennen. "
      "Das gewaltige, doppelbaertige Axtblatt schimmert matt im Licht "
      "und scheint schier nach Blut zu lechzen.");
  SetProp(P_INFO, "Die Kriegsaxt kann nur von sehr grossen, kraeftigen "
      "Leuten gefuehrt werden.");
  SetProp(P_NAME, "Kriegsaxt");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"axt", "kriegsaxt"}) );

  AddDetail( ({"blatt", "axtblatt"}),
      "Es schimmert matt im Licht.");
  
  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 160);
  SetProp(P_WC_FIX, 20);
  SetProp(P_WC_BONUS, (["\nxkrieger":100]));
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL:80, MAT_OAK:20]) );
  SetProp(P_WEIGHT, 3000);
  SetProp(P_VALUE, 1300);
  SetProp(P_NOBUY, 0);
  SetProp(P_HIT_FUNC, TO );
  SetProp (P_WIELD_RESTRICTIONS, ([A_STR: 15, A_DEX:11, P_SIZE:160]));
}

int HitFunc(object enemy)
{
  if(TP->QueryProp(P_SIZE) < 150)
    return -50;
  else if(TP->QueryProp(P_SIZE) < 200)
    return 0;
  else
    return 5+random(35);
}

