#include "../xandim.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Breitschwert");
  SetProp(P_LONG, 
    "Ein langes, staehlernes Breitschwert. Es liegt gut in der Hand und ist "
    "eine hervorragende Waffe. Der aus Elfenbein geschnitzte Griff verleiht "
    "ihm etwas majestaetisches.");
  SetProp(P_INFO, "Das Breitschwert funkelt kalt in Deinen Haenden.");
  SetProp(P_NAME, "Breitschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schwert", "breitschwert"}) );

  AddDetail( "griff",
	     "Der Griff ist aus Elfenbein und wunderschoen verziert.");
  AddDetail( "elfenbein",
	     "Es ist sehr sorgfaeltig bearbeitet.");

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 150);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL:80, MAT_IVORY:20]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 1500);
  SetProp(P_NOBUY, 0);
}

