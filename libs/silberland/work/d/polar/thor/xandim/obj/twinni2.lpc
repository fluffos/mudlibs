#include "../xandim.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

void set_color( string farbe );

string color;
int i=0;

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_NAME, "Twinnihaelfte");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"twinni", "eisschlecker", "schlecker", "eis", "haelfte", 
	   "twinnihaelfte"}) );

  SetProp(P_MATERIAL, ([MAT_ICE:98, MAT_WOOD:2]) );
  SetProp(P_WEIGHT, 25);
  SetProp(P_VALUE, 25);
  SetProp(P_NOBUY, 0);

  AddCmd( ({"schenke", "schenk"}), "herschenken");
  AddCmd( ({"schleck", "schlecke", "iss", "esse","lutsche","lutsch"}), "essen");
}

void set_color(string farbe)
{
  color=farbe+"e";
  SetProp(P_SHORT, "Eine "+color+" Twinnihaelfte");
  SetProp(P_LONG,
    "Die "+color+" Haelfte eines Twinnis. Es wurde in der Mitte auseinander "
   +"gebrochen, wobei scheinbar ein wenig von der Schokolade abgebroeckelt "
   +"ist. Du kannst die Twinnihaelfte jemanden schenken.");
  SetProp(P_NAME_ADJ, farbe);
  AddId( "\n"+farbe);
  AddAdjective( ({farbe+"e", farbe+"es"}) );
}


herschenken( str )
{
  object *env, ob;
  string was, welche, wem;
  int k;
  
  notify_fail(BS("Wem willst Du welche Twinnihaelfte schenken?"));
  
  if(!str)
    return 0;
  if(sscanf(str, "%s %s %s", wem, welche, was)==3 ||
     (sscanf(str, "%s %s %s", wem, welche, was)==2 && !welche) )
    {
      if(wem==getuid(TP))
        {
        write(BS("Es bringt wohl nicht allzu viel, wenn Du Dir das Twinni "
              +"selbst schenkst.\n"));
        return 1;
        }
      if( id(welche+" "+was) )
        {
        env=all_inventory(environment(TP))-({TP});
        if (!sizeof(env))
          {
          write(BS("Traurig stellst Du fest, dass hier niemand ist, dem Du "
                +"etwas schenken koenntest...\n"));
          return 1;
          }
        for(k=0; k<sizeof(env); k++)
          {
          ob=env[k];
          if(living(ob) && !ob->QueryProp(P_INVIS))
            {  
            if(ob->id(wem))
              {
              write(BS("Du schenkst "+ob->name(WEM)+" Deine "+color
                  +" Twinnihaelfte. "+ob->Name()
                  +" scheint sich sehr darueber zu freuen und strahlt "
                  +"gluecklich.\n"));
              tell_object(ob, BS(CAP_TPN+" schenkt Dir die "+color+" Haelfte "
                  +TP->QueryPossPronoun(NEUTER, WESSEN, SINGULAR)+" Twinnis. "
                  +"Du strahlst vor Freude und wuerdest "+TPN+" am liebsten "
                  +"ganz doll knuddeln.\n"));
              tell_room(environment(TP), BS(CAP_TPN+" schenkt "
                  +ob->name(WEM)+" eine Haelfte "
                  +TP->QueryPossPronoun(NEUTER, WESSEN, SINGULAR)
                  +" Twinnis. "+ob->Name()+" scheint "
                  +"sich sehr darueber zu freuen und strahlt uebers ganze "
                  +"Gesicht."), ({TP,ob}));
              TO->move(ob, M_NOCHECK);
              return 1;
              }
            }
          else
            {
            write(BS("Hier ist niemand, der "+capitalize(wem)+" heisst.\n"));
            return 1;
            }
          }
        }
    }
}


        
essen( str )
{
  notify_fail(BS("Woran willst Du schlecken?\n"));
  if(str=="twinni"||str=="an twinni"||str=="an twinnihaelfte"||
     str=="an haelfte"||str=="twinnihaelfte"||str=="haelfte")
    {
    write(BS("Du knabberst ein wenig von der Schokolade herunter und "
	    +"schleckst genuesslich an Deinem Twinni. Hmmm... koestlich, "
	    +"dieser fruchtige Geschmack.\n"));
    say(BS(CAP_TPN+" knabbert und schleckt genuesslich an einem Twinni herum. "
	    +"Du wirst ein wenig neidisch...\n"));
    i++;
    if(i>3)
      {
      write(BS("Ooooch... schade, das Twinni ist schon alle. Du haettest "
	      +"furchtbar gerne noch eines.\n"));
      TO->remove();
      }
    return 1;
    }
  else
    return 0;
}







