#include "../xandim.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Farbtopf");
  SetProp(P_LONG,
    "Der Farbtopf ist randvoll mit weisser Farbe gefuellt. Die Farbe "
   +"eignet sich sicher hervorragend zum Streichen einer Hausfassade.");
  SetProp(P_NAME, "Farbtopf");
  SetProp(P_GENDER, MALE);
  AddId( ({"topf", "farbtopf", "farbe", "\ncolor"}) );

  SetProp(P_MATERIAL, ([MAT_IRON:15, MAT_MISC_FLUID:85]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);

}
