/********************************************
*  Thor@SilberLand                          *
*  Ein Flaeschchen - flaeschchen.c          *
*  1998-06-05                               *
*                                           *
*  Bei erstmaligem Finden ein ZT,           *
*  ansonsten eine Heilung um 10+random(10)  *
********************************************/

  
#include "../xandim.h"

inherit "std/food";

#include <properties.h>
#include <food.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create( ({"trink", "trinke"}) );

  SetProp(P_SHORT, "Ein kleines Flaeschchen");
  SetProp(P_LONG,  
    "Ein kleines, gruenlich schimmerndes Flaeschchen. Du kannst es trinken.");
  SetProp(P_INFO,
      BS("Das Flaeschchen schimmert in einem geheimnisvollen Gruen. "
         "Du weisst nicht, ob es eine so gute Idee ist, es zu trinken..."));
  SetProp(P_NAME, "Flaeschchen");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"flasche", "flaeschchen"}) );

  SetProp(P_MATERIAL, ([MAT_GLASS:60, MAT_MISC_FLUID:30, MAT_MISC_MAGIC:10]) );
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 0);
  SetProp (P_FOOD_INFO, ([F_HEAL:10+random(11), F_DRINK:10, F_ALCOHOL:0,
                          F_POISON:0, F_VERB:"trinken"]));
}

BeimEssen()
{
  write(BS("Mutig setzt Du das Flaeschchen an den Mund, trinkst es in einem "
          +"Zug leer, und..."));
  say(BS(CAP_TPN+" trinkt ein seltsames, gruenes Flaeschchen aus."));
  if(!TP->FindPotion("\n        ...findest einen Zaubertrank!\n\n"))
    write("\n        ...fuehlst Dich deutlich erfrischt.\n\n");
}

