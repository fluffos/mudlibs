#include "../xandim.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Twinni");
  SetProp(P_LONG,
    "Ein leckerer Twinni-Eisschlecker. Die eine Haelfte ist gruen, die "
   +"andere orange. Das obere Drittel ist mit leckerer Schokolade "
   +"ueberzogen. Wenn Du moechtest, kannst Du das Twinni mit jemanden "
   +"teilen.");
  SetProp(P_NAME, "Twinni");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"twinni", "eisschlecker", "schlecker", "eis"}) );

  SetProp(P_MATERIAL, ([MAT_ICE:98, MAT_WOOD:2]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 12);
  SetProp(P_NOBUY, 0);

  AddCmd( ({"teil", "teile"}), "teilen");
  AddCmd( ({"brich", "breche"}), "haelfte");
  AddCmd( ({"iss", "esse", "schleck","schlecke","lutsche","lutsch"}), "essen");
}

int i=0;

teilen( str )
{
  notify_fail(BS("Was willst Du teilen?\n"));
  if(str=="twinni"||str=="eisschlecker"||str=="eis"||str=="schlecker")
    {
    write(BS("Du brauchst das Twinni nur auseinander zu brechen.\n"));
    return 1;
    }
  else
    return 0;
}

haelfte( str )
{
  object ob;
  notify_fail(BS("Was willst Du auseinanderbrechen?\n"));
  if(str=="twinni auseinander"||str=="twinni entzwei"||
     str=="twinni in zwei haelften")
    {
    write(BS("Du brichst das Twinni in zwei Haelften, in eine orange und "
	    +"eine gruene.\n"));
    say(BS(CAP_TPN+" bricht ein Twinni in zwei Haelften.\n"));
    ob=clone_object(OBJ("twinni2"));
    ob->set_color("gruen");
    ob->move(TP, M_NOCHECK);
    ob=clone_object(OBJ("twinni2"));
    ob->set_color("orangen");
    ob->move(TP, M_NOCHECK);
    TO->remove();
    return 1;
    }
  else
    return 0;
}

essen( str )
{
  notify_fail(BS("Woran willst Du schlecken?\n"));
  if(str=="twinni"||str=="an twinni")
    {
    write(BS("Du knabberst ein wenig von der Schokolade herunter und "
	    +"schleckst genuesslich an Deinem Twinni. Hmmm... koestlich, "
	    +"dieser fruchtige Geschmack.\n"));
    say(BS(CAP_TPN+" knabbert und schleckt genuesslich an einem Twinni herum. "
	    +"Du wirst ein wenig neidisch...\n"));
    i++;
    if(i>6)
      {
      write(BS("Ooooch... schade, das Twinni ist schon alle. Du haettest "
	      +"furchtbar gerne noch eines.\n"));
      TO->remove();
      }
    return 1;
    }
  else
    return 0;
}









