#include "../xandim.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Stangerl");
  SetProp(P_LONG,
    "Ein etwa zehn Zentimeter langes Stangerl aus Pappendeckel. So mancher, "
    "welcher in Besitz des dazugehoerigen Paipers ist, wuerde wohl ein Vermoegen "
    "fuer dieses Stangerl geben.");
  SetProp(P_NAME, "Stangerl");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"stangerl", "staebchen", "stab", "\npaiperstangerl"}) );
  AddDetail( "pappendeckel",
    "Man kann auch schlicht und einfach \"Pappe\" dazu sagen.");
  AddDetail( "pappe",
    "Ist das gleiche wie Pappendeckel, nur etwas \"deutscher\".");
  AddDetail( "deckel",
    "Nein, Pappendeckel hat trotz der aehnlichen Betonung nichts mit einem Deckel "
    "zu tun.");
  AddDetail( ({"besitz", "vermoegen", "paiper"}),
    "Ohne dieses Stangerl ist so ein Paiper ziemlich wertlos ...");

  SetProp(P_MATERIAL, ([MAT_CARTON:100]) );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);

}
