// Paiper von Ronja, adaptiert von
// Thor


inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../xandim.h"

int deckel;
int anzahl;
int eisda;
int stangerl;

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Paiper");
  SetProp(P_LONG,
    "Ja, ein echtes Paiper ! Genau wie frueher. Du kannst es gar nicht mehr "
    "erwarten, den Pappdeckel zu entfernen, das Eis am Stangerl herauszuschieben "
    "und Dein Paiper aufzuessen. Allein schon "
    "der Gedanke an das fruchtige Zitroneneis mit dem Himbeerstern laesst Dich "
    "alles andere vergessen. Du glaubst sogar, eine leise Stimme zu vernehmen, die "
    "'Iss mich, Iss mich' in Dein Ohr fluestert.");
  SetProp(P_INFO, "Du denkst nur noch: Schnell wegessen, bevor es Dir ein anderer "
                 +"abschwatzt!");
  SetProp(P_NAME, "Paiper");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"paiper", "eis"}) );

  SetProp(P_MATERIAL, ([MAT_CARTON:5, MAT_ICE:95]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 12);
  SetProp(P_NOBUY, 0);

  AddDetail( ({"stangerl"}) ,
    "Unten am Eis ist ein Stangerl angebracht, an dem Du das Eis herausschieben kannst."
  );

  AddCmd( ({"schiebe", "schieb"}), "schieben");
  AddCmd( ({"entfern", "entferne"}), "entfernen");
  AddCmd( ({"stecke", "steck"}), "stangerl");
  AddCmd( ({"iss", "esse", "schlecke", "schleck", "lutsch", "lutsche"}), "essen");

  anzahl = 4;
  deckel = 1;
  eisda  = 0;
  stangerl = 0;
}

stangerl( str )
{
  object ob;

  if(str!="stangerl in paiper" && str!="staebchen in paiper" && str!="stab in paiper")
    return 0;
  if (stangerl)
  {
    write(
      "Es ist ein Stangerl schon durchgesteckt worden.\n" );
    return -1;
  }
  if(ob=present("\npaiperstangerl", TP)) {
    write(BS("Mit einem leisen Quietschen steckst Du das Pappstangerl in das Paiper.\n"));
    say(BS(TP->Name()+" steckt mit einem leisen Quietschen ein Pappstangerl in ein "
          "Paiper.\n"));
    stangerl=1;
    ob->remove();
    return 1;
  }
  else {
    write("Du hast doch gar nichts, was Du in das Paiper hineinstecken koenntest!\n");
    return 1;
  }
}

entfernen( str )
{
  notify_fail("Was willst Du entfernen?\n");

  if(-1 == member(({"deckel"}),str))
  {
    return 0;
  }

  if(deckel)
  {
    write(BS("Mit einem hastigen Ruck reisst Du den Deckel herunter, darunter "
             "kannst Du schon das leckere Zitroneneis mit dem Himbeerstern sehen."
    ));
    say(BS(TPN+" reisst den Pappdeckel von "+TP->QueryPossPronoun(NEUTER, WEM, SINGULAR)+" Paiper herunter."));
  }
  else
  {
    write(BS("Aber Du hast den Deckel doch schon entfernt!"));
  }
  deckel = 0;
  return 1;
}

schieben( str )
{
  notify_fail("Was willst Du heraus schieben?\n");

  if(-1 == member(({"stangerl","stangerl heraus","eis","eis heraus","eis hoch","stangerl hoch",
                    "paiper heraus","paiper hoch"}),str))
  {
    return 0;
  }

  if(deckel)
  {
    write(BS("Du solltest zuerst den Deckel entfernen, bevor Du das Eis "
             "hochschiebst."
    ));
    say(BS(TPN+" stellt sich mit "+TP->QueryPossPronoun(NEUTER, WEM, SINGULAR)+" Paiper ziemlich ungeschickt an."));
    return 1;
  }
  if(!stangerl)
  {
    write(BS("Du musst vorher noch ein Stangerl in das Paiper stecken, bevor Du es "
          "herausschieben kannst.\n"));
    return 1;
  }

  if(eisda)
  {
    write(BS("Wenn Du das Eis noch mehr herausschiebst, faellt es Dir am Ende heraus!"));
    return 1;
  }

  write(BS("Du schiebst das Eis etwas heraus. Zufrieden bemerkst Du das dabei auftretende "
           "Quietschen. Wie das Zitroneneis mit dem Himbeerstern Dich anlacht!"));
  say(BS(TPN+ " schiebt an dem Stangerl "+TP->QueryPossPronoun(NEUTER, WER, SINGULAR)+
        " Eis etwas heraus und lauscht zufrieden dem dabei auftretendem Quietschen. Dein "
        "Verlangen nach einem Paiper wird unbaendig, als Du das siehst. Du willst auch so "
        "ein Paiper haben!"));
  eisda=1;
  return 1;
}

essen( str )
{
  notify_fail(BS("Woran willst Du schlecken?\n"));

  if(-1 == member(({"paiper","an paiper","eis","an eis"}),str))
  {
    return 0;
  }

  if(deckel)
  {
    write(BS("Da ist doch noch der Deckel drauf! Den solltest Du zuerst entfernen."));
    return 1;
  }
  if(!stangerl)
  {
    write(BS("Du musst vorher noch ein Stangerl in das Paiper stecken, bevor Du es "
             "herausschieben kannst.\n"));
    return 1;
  } 

  if(!eisda)
  {
    write(BS("Du musst das Eis schon ein bisschen herausschieben, sonnst kommst du ja nicht dran."));
    return 1;
  }

  write(BS("Du schleckst genuesslich an Deinem Paiper. Hmmm... so "
          +"richtig schoen lecker-fruchtig nach Zitrone. Eigentlich "
          +"willst Du Dir die Eiscreme so richtig langsam auf der Zunge "
          +"zergehen lassen, aber Du bist viel zu gierig und isst "
          +"eifrig weiter. :)\n"));
  say(BS(CAP_TPN+" schleckt an "
        +(TP->QueryPossPronoun(NEUTER, WEM, SINGULAR))+" Paiper und "
        +"macht dabei einen "
        +"furchtbar zufriedenen und begeisterten Eindruck. Buhuu... Du "
        +"willst auch so ein Paiper haben."));

  anzahl--;
  eisda = 0;
  if(anzahl==0)
  {
    write(BS("Du schleckst ein letztes Mal an Deinem Paiper ... schade, "
		+"es war schon viel zu frueh alle.\n"));
    TO->remove();
  }

  return 1;
}



