#include "../xandim.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Nogger");
  SetProp(P_LONG,
      "Ein Nogger mit dunkelbraunem Schokoladen-Ueberzug und knusprigen "
      "Crisps in der Schokolade. Am liebsten wuerdest Du gleich reinbeissen.");
  SetProp(P_NAME, "Nogger");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"nogger", "eisschlecker", "schlecker", "eis"}) );

  AddDetail( ({"schokolade", "ueberzug", "schokoladen-ueberzug"}),
        "Dunkle, suesse Schokolade ... Kalorien pur :)");
  AddDetail( "kalorien",
        "Die sollten Dich hier im SilberLand nicht so kuemmern.");
  AddDetail( "silberland",
        "Du stehst mitten drin.");
  AddDetail( ({"crisp", "crisps"}),
        "Die machen die Schokolade erst so richtig knusprig.");
  
  SetProp(P_MATERIAL, ([MAT_ICE:98, MAT_WOOD:2]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 13);
  SetProp(P_NOBUY, 0);

  AddCmd( ({"iss", "esse", "schleck","schlecke","lutsche","lutsch"}), "essen");
}

int i=0;

essen( str )
{
  notify_fail(BS("Woran willst Du schlecken?\n"));
  if(str=="nogger"||str=="an nogger")
    {
    write(BS("Du knabberst an Deinem Nogger herum. Mist, jetzt ist Dir ein "
	           "Stueckchen Schokolade runtergefallen!\n"));
    say(BS(CAP_TPN+" knabbert an einem Nogger herum und verliert dabei "
             "einiges von seiner Schokolade. So ein Tolpatsch!\n"));
    i++;
    if(i>6)
      {
      write(BS("Och schade, der Nogger ist schon alle ...\n"));
      TO->remove();
      }
    return 1;
    }
  else
    return 0;
}
