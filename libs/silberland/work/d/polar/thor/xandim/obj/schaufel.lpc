#include "../xandim.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Schneeschaufel");
  SetProp(P_LONG,
    "Eine stinknormale Schneeschaufel zum schneeschaufeln.");
  SetProp(P_NAME, "Schneeschaufel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"schaufel", "schneeschaufel"}) );

  SetProp(P_MATERIAL, ([MAT_WOOD:20, MAT_PLUTONIUM:80]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 50);
  SetProp(P_NOBUY, 1);

}
