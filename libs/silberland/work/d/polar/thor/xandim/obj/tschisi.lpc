#include "../xandim.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Tschisi");
  SetProp(P_LONG,
      "Ein gelbes Tschisi mit vielen kaesigen Loechern.\nDu denkst . o O "
      "(So ein Betrug, da sind ja mehr Loecher als Eiscreme!)\nOb es wohl "
      "auch so sehr nach Kaese schmeckt wie es aussieht?");
  SetProp(P_NAME, "Tschisi");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"tschisi", "eisschlecker", "schlecker", "eis"}) );

  AddDetail( ({"loch", "loecher"}),
      "Mehr Loecher als Eis ist hier dran, so ne Frechheit!");
  AddDetail( ({"eis", "eiscreme", "creme"}),
      "Ob die Eiscreme wirklich nach Kaese schmeckt?");
  AddDetail( "kaese",
      "Du stellst Dir das sonderbar vor ...");
  
  SetProp(P_MATERIAL, ([MAT_ICE:98, MAT_WOOD:2]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 0);

  AddCmd( ({"iss", "esse", "schleck","schlecke","lutsche","lutsch"}), "essen");
}

int i=0;

essen( str )
{
  notify_fail(BS("Woran willst Du schlecken?\n"));
  if(str=="tschisi"||str=="an tschisi")
    {
    write(BS("Du schleckst genuesslich an Deinem Tschisi. Ieks, das "
	    +"schmeckt ja wirklich nach Kaese!\n"));
    say(BS(CAP_TPN+" schleckt etwas lustlos an einem Tschisi.\n"));
    i++;
    if(i>6)
      {
      write(BS("Gottseidank ist dieses Tschisi endlich alle!\n"));
      TO->remove();
      }
    return 1;
    }
  else
    return 0;
}
