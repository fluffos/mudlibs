#include "../xandim.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein kleiner Eisenschluessel");
  SetProp(P_LONG,
    "Ein kleiner Eisenschluessel, der aussieht, als wuerde er zu einem "
   +"Vorhaengeschloss passen.");
  SetProp(P_NAME, "Eisenschluessel");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_GENDER, MALE);
  AddId( ({"\nftkey", "schluessel", "eisenschluessel"}) );

  SetProp(P_MATERIAL, ([MAT_IRON:100]) );
  SetProp(P_WEIGHT, 80);
  SetProp(P_VALUE, 70);
  SetProp(P_NOBUY, 0);

}

string QueryDoorKey()
{
  return DORF("kerker")+":"+DORF("wachturm1");
}
