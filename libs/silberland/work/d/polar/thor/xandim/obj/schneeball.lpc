inherit "std/thing";

#include "../xandim.h"
#include <properties.h>
#include <language.h>

create()
{
  ::create();
  SetProp(P_SHORT, "Ein Schneeball");
  SetProp(P_LONG, "Ein grosser, runder, weisser Schneeball, der gerade "
	         +"danach schreit, nach jemanden geworfen zu werden.");
  AddId( ({"ball", "schneeball"}) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 0);
  SetProp(P_NAME, "Schneeball");
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, ([MAT_ICE:100]));
  AddCmd( ({"wirf", "werfe"}), "werfen");

}

varargs int move(mixed dest, int method)
{
  ::move(dest, method);
  if(!previous_object())
    return 1;
  else
    {
    previous_object()->RemovePursuer(TO);
    environment(TO)->AddPursuer(TO);
    return 1;
    }
//  write(BS(sprintf("%O", environment(TO)))+"\n");
//  write(BS(sprintf("%O", previous_object()))+"\n");
//  return 1;
}



int PreventFollow(object dest)
{
  object *allenv;

  allenv=all_environment(TO);
  if( (allenv[sizeof(allenv)-1]->QueryProp(P_ENVIRONMENT)[ENV_TEMPERATURE])>7 )
    {
    tell_object( ENV(TO), BS("Der Schneeball schmilzt in der Waerme.\n"));
    call_out("weg", 0);
    return 2;
    }
  else
    return 1;

}

weg()
{
  TO->remove();
}

werfen( str )
{
  int treffer;
  string werfer_name;
  string victim_string,werfer_string;
  string was,at,wen;
  int fehler;
  object victim;

  if (!str) return 0;
  fehler = 0;
  if (sscanf(str,"%s %s %s",was,at,wen) != 3)
    fehler = 1;
  if (!id(was) || at != "nach")
    fehler = 1;
  if (fehler)
  { 
     notify_fail("Gib einfach ein: wirf schneeball nach <spielername>.\n");
     return 0;
  }
  victim = present(wen,environment(this_player()));
  if (!victim)
  { 
     write("Der ist ja gar nicht hier!\n");                                
     return 1;                                                                 
  }                                                                           
  werfer_name = this_player()->name();
  treffer = random(5);
  write("Du holst weit aus und wirfst einen Schneeball nach " 
	+ victim->name(WEM) +".\n");
  tell_object(victim, werfer_name + " holt weit aus und wirft einen "
  +"Schneeball nach Dir.\n");
  tell_room(ENV(TP), CAP_TPN+" holt weit aus und wirft einen Schneeball nach "
  +victim->name(WEM)+".\n", ({TP, victim}));

  if (treffer==0)
  {
    werfer_string = "Der Schneeball fliegt weit an " + victim->name(WEM)
      + " vorbei.\n";
    victim_string = (victim, werfer_name + " schiesst weit an Dir vorbei.\n");
  }
  if (treffer==1)
  {
    werfer_string =  victim->name(WER)+ " kann den Schneeball gerade noch "
 +"abfangen, bekommt dafuer einigen Schnee in den Aermel.\n";
    victim_string = "Du kannst den Schneeball gerade noch mit dem Arm "
 +"abfangen, bekommst dafuer aber eine gehoerige Ladung Schnee in den "
 +"Aermel.\n";
  }
  if (treffer==2)
  {
    werfer_string = "Der Schneeball trifft " + victim->name(WEN) + " am "
 +"Hinterkopf und jede Menge Schnee rieselt in "
 +victim->QueryPossPronoun(NEUTER,WEN)+" Genick.\n";
    victim_string = "Der Schneeball trifft Dich am Hinterkopf und jede Menge "
 +"Schnee rieselt in Dein Genick und schmilzt langsam. Igitt, ist das kalt!\n";
  }
  if (treffer==3)
  {
    werfer_string = "KLATSCH! Der Schneeball trifft " + victim->name(WEN)
 +" mitten ins Gesicht.\n";
    victim_string = "KLATSCH! Der Schneeball trifft Dich mitten ist "
 +"Gesicht.\n";
  }
  if (treffer==4)
  {
    werfer_string = "Der Schneeball trifft "+victim->name(WEN)+" mitten "
 +"am Bauch. "+CAP(victim->name(WER))+" ist schon ganz durchnaesst.\n";
    victim_string = "Der Schneeball trifft Dich mitten am Bauch. Du bist "
 +"schon ganz durchnaesst.\n";
  }
  tell_room(ENV(TP),werfer_string,({victim}));
  tell_object(victim,victim_string);
  TO->remove();
  return 1;
}
















