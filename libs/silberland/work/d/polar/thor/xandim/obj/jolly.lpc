#include "../xandim.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Jolly");
  SetProp(P_LONG,
      "Du haeltst ein Jolly in Deinen Haenden. Das untere Drittel besteht "
      "aus leckerem Erdbeer-Eis, das mittlere Drittel aus Orangen-Eis und "
      "das obere Drittel ist mit einer knackigen Schokoladen-Glasur "
      "ueberzogen.");
  SetProp(P_NAME, "Jolly");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"jolly", "eisschlecker", "schlecker", "eis"}) );

  AddDetail( ({"erdbeereis", "erdbeer", "erdbeer-eis", "erdbeer eis"}),
      "So rot wie das ist, kann es nur Erdbeer-Eis sein.");
  AddDetail( ({"orangeneis", "orangen-eis", "orange", "orangen eis"}),
      "Hmmmmm, das schmeckt bestimmt lecker!");
  AddDetail( ({"glasur", "schokolade", "schokoladen-glasur", 
               "schokoladenglasur", "schokoladen glasur"}),
      "Das Beste am ganzen Jolly!");
  AddDetail( ({"bestes", "beste"}),
      "Das ist die Schokoladen-Glasur, ohne Zweifel!");
  AddDetail( "zweifel",
      "Jegliche Zweifel sind beseitigt.");
  
  SetProp(P_MATERIAL, ([MAT_ICE:98, MAT_WOOD:2]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 0);

  AddCmd( ({"iss", "esse", "schleck","schlecke","lutsche","lutsch"}), "essen");
}

int i=0;

essen( str )
{
  notify_fail(BS("Woran willst Du schlecken?\n"));
  if(str=="jolly"||str=="an jolly")
    {
    write(BS("Du knabberst ein wenig von der Schokolade herunter und "
	    +"schleckst genuesslich an Deinem Jolly. Hmmm... koestlich, "
	    +"dieser fruchtige Geschmack.\n"));
    say(BS(CAP_TPN+" knabbert und schleckt genuesslich an einem Jolly herum. "
	    +"Du wirst ein wenig neidisch...\n"));
    i++;
    if(i>6)
      {
      write(BS("Ooooch... schade, das Jolly ist schon alle. Du haettest "
	      +"furchtbar gerne noch eines.\n"));
      TO->remove();
      }
    return 1;
    }
  else
    return 0;
}
