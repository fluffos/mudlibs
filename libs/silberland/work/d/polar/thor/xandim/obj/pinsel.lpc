#include "../xandim.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Pinsel");
  SetProp(P_LONG, 
    "Ein notduerftig zusammengebastelter Pinsel. Er sieht nicht gerade "
   +"schoen aus, aber er erfuellt bestimmt seinen Zweck.");
  SetProp(P_INFO, "Du kannst mit dem Pinsel bestimmt alles moegliche "
             +"bepinseln. Nur brauchst Du auch noch Farbe dazu.");
  SetProp(P_NAME, "Pinsel");
  SetProp(P_GENDER, MALE);
  AddId("pinsel");

  SetProp(P_MATERIAL, ([MAT_HAIR:30, MAT_WOOD:70]) );
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 50);
  SetProp(P_NOBUY, 0);
  AddCmd( ({"bepinsel", "bepinsle", "bemale", "bemal"}), "anmalen" );

}

anmalen( str )
{
  object ob;
 
  notify_fail(BS("Was oder wen willst Du bemalen?\n"));
  
  if(!str)
   return 0; 
  
  if(!present("farbtopf", TP))
    {
    write(BS("Aber Du hast ja gar keine Farbe dabei!\n"));
    return 1;
    }
  else if(ob=present(str, environment(TP)) || ob=present(str, TP))
    {
    write(BS("Du tauchst den Pinsel tief in den Farbtopf ein und bepinselst "
            +ob->QueryProp(P_ARTICLE) ? ob->QueryProp(P_GENDER)==FEMALE ? 
            "eine":"einen"+" "+ob->QueryProp(P_NAME): ""
           +" ueber und ueber mit weisser Farbe.\n"));
    if(query_once_interactive(ob))
      {
      write(BS(ob->QueryProp(P_NAME)+" bleibt aeusserst verdutzt stehen und "
            +"kuckt Dich fragend an.\n"));
      tell_object(ob, BS(CAP_TPN+" bepinselt Dich ueber und ueber mit weisser "
            +"Farbe. Du stehst nun doch etwas verdutzt da kuckst "+TPN
            +" fragend an.\n"));
      }
    tell_room(environment(TP), BS(CAP_TPN+" bepinselt "+ob->QueryProp(P_NAME)
            +" ueber und ueber mit weisser Farbe.\n"), ({ob, TP}) );
    if(query_once_interactive(ob))
      {
      tell_room(environment(TP), BS(ob->QueryProp(P_NAME)+" bleibt daraufhin "
           +"verdutzt stehen und kuckt "+TPN+" fragend an.\n"), ({ob, TP}));
      }
    return 1;
    }
  else
    {
    write(BS(capitalize(str)+" siehst Du hier nicht!\n"));
    return 1;
    }
  return 0;
}
