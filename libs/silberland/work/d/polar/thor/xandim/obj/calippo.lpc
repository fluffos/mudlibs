#include "../xandim.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Calippo");
  SetProp(P_LONG,
    "Ein langes, duennes Calippo. Es ist in eine knallig bunte, gruen-orange "
   +"Pappverpackung eingewickelt.");
  SetProp(P_INFO, "Dir laeuft das Wasser im Munde zusammen, wenn Du das "
	         +"Calippo so ansiehst.");
  SetProp(P_NAME, "Calippo");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"calippo", "eis"}) );

  SetProp(P_MATERIAL, ([MAT_CARTON:5, MAT_ICE:95]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 12);
  SetProp(P_NOBUY, 0);
  
  AddCmd( ({"reiss", "reisse"}), "deckel");
  AddCmd( ({"waerm", "waerme"}), "anwaermen");
  AddCmd( ({"drueck", "druecke", "quetsch", "quetsche"}), "raus");
  AddCmd( ({"iss", "esse", "schlecke", "schleck", "lutsch", "lutsche"}), "essen");

}

int deckel=0, warm=0, draussen=0, i=0;

deckel( str )
{
  notify_fail(BS("Was willst Du aufreissen?\n"));
  if(str=="deckel auf"||str=="deckel ab"||str=="calippo auf")
    {
    if(deckel==1)
      {
      write(BS("Du hast den Deckel doch schon aufgerissen.\n"));
      return 1;
      }
    else
      {
      write(BS("Du reisst mit einer kurzen Handbewegung den Deckel von dem "
	      +"Calippo auf.\n"));
      say(BS(CAP_TPN+" reisst den Deckel von einem Calippo auf.\n"));
      deckel=1;
      return 1;
      }
    }
  else
    return 0;
}

anwaermen( str )
{
  notify_fail(BS("Was willst Du anwaermen?\n"));
  if(str=="calippo an"|| str=="eis an"||str=="calippo")
    {
    if(deckel==0)
      {
      write(BS("Du musst zuerst noch den Deckel aufreissen.\n"));
      return 1;
      }
    else if(warm==1)
      {
      write(BS("Du hast das Calippo schon angewaermt. Fuer ein zweites Mal "
	      +"ist Dir noch viel zu kalt in Deinen Fingern.\n"));
      return 1;
      }
    else
      {
      write(BS("Du nimmst das Calippo in Deine Haende und rubbelst und "
	      +"drueckst daran herum. Brrrr ... Du hast schon ganz kalte "
	      +"Finger davon.\n"));
      say(BS(CAP_TPN+" rubbelt und drueckt an einem Calippo herum.\n"));
      warm=1;      
      return 1;
      }
    }
  else
    return 0;
}

raus( str )
{
  notify_fail(BS("Was willst Du herausquetschen?\n"));
  if(str=="calippo heraus"||str=="calippo raus"||str=="calippo"||
     str=="calippo aus verpackung heraus"||str=="calippo aus verpackung raus"
     ||str=="calippo aus verpackung")
    {
    if(deckel==0)
      {
      write(BS("Du solltest erstmal den Deckel aufreissen.\n"));
      return 1;
      }
    else if(warm==0)
      {
      write(BS("Du musst das Calippo erstmal anwaermen, sonst ist es an der "
	      +"Verpackung festgefroren und laesst sich nicht "
	      +"herausquetschen.\n"));
      return 1;
      }
    else if(draussen==1)
      {
      write(BS("Du drueckst nochmal kraeftig zusammen, doch... Hoppla! Das "
	      +"war zuviel. Jetzt ist Dir das Calippo vollends aus der "
	      +"Verpackung herausgeflutscht.\n"));
      say(BS(CAP_TPN+" drueckt nochmal an "
	      +(TP->QueryPossPronoun(NEUTER, WEM, SINGULAR))+" Calippo herum, "
	      +"bis es aus der Verpackung "
	      +"herausflutscht und zu Boden faellt. Du bist ein wenig sauer "
	      +"auf "+TPN+". Bevor "
	      +TP->QueryPronoun()+" es zu Boden wirft, haette "
	      +TP->QueryPronoun()+" es ruhig Dir geben koennen... "
	      +"*schmoll*\n"));
      TP->command_me("weine");
      TO->remove();
      return 1;
      }
    else
      {
      write(BS("Du drueckst ein wenig zusammen und das Calippo flutscht ein "
	      +"Stueck aus der Verpackung heraus.\n"));
      say(BS(CAP_TPN+" quetscht an dem Calippo herum bis es schliesslich "
	      +"ein Stueckchen aus der Verpackung herausflutscht. Du "
	      +"beginnst, "+TPN+" um "
	      +(TP->QueryPossPronoun(NEUTER, WER, SINGULAR))+" Calippo zu beneiden.\n"));
      draussen=1;
      return 1;
      }
    }
  else
    return 0;
}

essen( str )
{ 
  notify_fail(BS("Woran willst Du schlecken?\n"));
  if(str=="an calippo"||str=="calippo")
    {
    if(deckel==0)
      {
      write(BS("Du musst zuerst den Deckel aufreissen.\n"));
      return 1;
      }
    else if(warm==0)
      {
      write(BS("Du musst das Calippo zuerst anwaermen, ansonsten kannst Du "
	      +"es nicht aus der Verpackung herausdruecken.\n"));
      return 1;
      }
    else if(draussen==0)
      {
      write(BS("Du musst das Calippo aus der Verpackung herausquetschen, "
	      +"sonst kommst Du so schlecht ran beim schlecken."));
      return 1;
      }
    else
      {
      write(BS("Du schleckst genuesslich an Deinem Calippo. Hmmm... so "
	      +"richtig schoen lecker-fruchtig. Du laesst Dir die "
	      +"Eiscreme langsam auf der Zunge zergehen und geniesst "
	      +"den Augenblick so richtig.\n"));
      say(BS(CAP_TPN+" schleckt an "
	      +(TP->QueryPossPronoun(NEUTER, WEM, SINGULAR))+" Calippo und "
	      +"macht dabei einen "
	      +"furchtbar zufriedenen und begeisterten Eindruck. Buhuu... Du "
	      +"willst auch so ein Calippo haben."));
      i++;
      if(i>3)
	{
	write(BS("Du schleckst ein letztes Mal an Deinem Calippo ... schade, "
		+"es war schon viel zu frueh alle.\n"));
	TO->remove();
	}
      return 1;
      }
    }
  else
    return 0;
}
	


