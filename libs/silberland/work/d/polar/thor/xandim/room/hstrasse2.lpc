#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hauptstrasse" );
  SetProp( P_INT_LONG,
    "Die Hauptstrasse fuehrt von Sueden nach Norden. Links und rechts von "
   +"Dir erheben sich die Iglus der Xandim. Bei einigen siehst Du von "
   +"kleinen Oeffnungen im Dach etwas Rauch aufsteigen. Du fragst Dich, wie "
   +"man in solchen Behausungen aus Eis wohl Feuer machen kann, ohne dass "
   +"alles schmilzt. Nun, irgendwie scheint es wohl zu funktionieren.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -10]) );

  AddDetail( ({"hauptstrasse", "strasse"}),
	     "Die Hauptstrasse fuehrt von Sueden nach Norden quer durch "
            +"Yiqanuc.");
  AddDetail( "yiqanuc",
	     "Da bist Du gerade. Hier wohnen die Xandim.");
  AddDetail( "xandim",
	     "Du bist gerade in deren Heimatdorf.");
  AddDetail( ({"dorf", "heimatdorf"}),
	     "Sieh Dich doch einfach etwas genauer um.");
  AddDetail( ({"iglus", "iglu"}),
	     "Links und rechts von Dir erheben sich zahlreiche Iglus.");
  AddDetail( ({"oeffnung", "oeffnungen"}),
	     "Die Iglus haben in ihren Daechern kleine Oeffnungen, durch "
            +"die der Rauch von innen abziehen kann.");
  AddDetail( ({"dach", "daecher"}),
	     "Die Daecher gehen zwar uebergangslos in die Waende der Iglus "
            +"ueber, aber man kann sie trotzdem als Daecher bezeichnen.");
  AddDetail( "waende",
	     "Waende und Daecher der Iglus sind alle rund und kuppelfoermig. "
            +"Daher tut man sich auch schwer mit dem Unterscheiden, wo nun "
            +"das eine anfaengt und das andere aufhoert.");
  AddDetail( "rauch",
	     "Auch wenn Iglus gut isolieren, ist es doch um einiges zu "
            +"kalt um sie ungeheizt zu lassen.");
  AddDetail( ({"behausung", "behausungen"}),
	     "Die Iglus scheinen trotz des Feuers innen nicht zu schmelzen. "
            +"Sie sind wohl innen bereits mit einer aeusserst dicken "
            +"Eisschicht ueberzogen.");
  AddDetail( "feuer",
	     "Das siehst Du von hier nicht.");
  AddDetail( ({"schicht", "eisschicht"}),
	     "Du kannst ja bei Gelegenheit mal in so ein Iglu hineingehen "
            +"und es Dir ankucken. Nur hier wird Dich wahrscheinlich niemand "
            +"einfach so hineinlassen. Versuch es besser in anderen Gegenden "
            +"des Dorfes.");
  AddDetail( "gelegenheit",
	     "Die Gelegenheit ein solches Iglu von innen zu betrachten, wird "
            +"sich Dir sicher noch bieten.");
  AddDetail( ({"gegend", "gegenden"}),
	     "Es gibt bestimmt auch noch andere Gegenden in dem Dorf als nur "
            +"das Wohnviertel.");
  AddDetail( ({"wohnviertel", "viertel"}),
	     "Hier bist Du wohl gerade.");
  AddDetail( "eis",
	     "Es scheint hier bauwerksmaessig alles aus Eis gemacht worden "
            +"zu sein.");
  AddDetail( "himmel",
	     "Ueber Dir strahlt ein wunderbar blauer Himmel.");
  AddDetail( "sonne",
	     "Ohne den Sonnenschein waere es hier vermutlich noch viel viel "
            +"kaelter.");
  AddDetail( "boden",
	     "Der Boden besteht aus blankem Eis und ist mit ein wenig Schnee "
            +"bedeckt.");
  AddDetail( "schnee",
	     "Am Boden liegt ein wenig Schnee.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein reges Treiben aus dem Norden.");
  AddSound("treiben",
    "Im Norden scheint etwas mehr los zu sein als hier.");
    
  AddExit( "norden", DORF("hstrasse3"));
  AddExit( "sueden", DORF("hstrasse1"));
}
