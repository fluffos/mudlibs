/***********************************
*  Thor@SilberLand                 *
*  Vorraum zu Zamorra's Seherhaus  *
*  2003-07-01                      *
***********************************/

#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem kleinen, dunklen Eisvorsprung" );
  SetProp( P_INT_LONG,
    "Verdutzt siehst Du Dich um. Ziemlich duester hier, aber langsam "
   +"gewoehnen sich Deine Augen an die Dunkelheit. Du stehst auf einem "
   +"schmalen Vorsprung aus Eis. Eigentlich ist hier alles aus Eis, der "
   +"Vorsprung und die Waende, die sich nach oben und in die gaehnende "
   +"Tiefe erstrecken. Oestlich von Dir ist ein grosser Spalt in der Wand.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -10]) );

  AddDetail( ({"augen", "auge"}),
             "Deine Augen passen sich langsam an die Dunkelheit an, sodass Du "
            +"mittlerweile schon einiges erkennen kannst.");
  AddDetail( ({"dunkel", "dunkelheit"}),
             "Mittlerweile wuerdest Du es maximal noch als duester beschreiben.");
  AddDetail( "vorsprung",
             "Da hast Du nochmal Glueck gehabt, dass Du Halt an diesem Vorsprung "
            +"gefunden hast. Hinter Dir geht es naemlich schier endlos in die "
            +"Tiefe.");
  AddDetail( "glueck",
             "Davon sollte man immer eine ordentliche Portion bei sich haben.");
  AddDetail( "portion",
             "Das ist bei Dir scheinbar der Fall.");
  AddDetail( "fall",
             "Denke an dieser Stelle lieber nicht ueber fallen nach ...");
  AddDetail( "stelle",
             "Nicht ganz ungefaehrlich sollte man meinen.");
  AddDetail( "halt",
             "Noch ist er relativ sicher."),
  AddDetail( "tiefe",
             "Schwarz und tief ... was soll man da noch mehr dazu sagen?");
  AddDetail( "eis",
             "Es handelt sich dabei nicht wirklich um Glatteis, eher um die "
             +"schroffe, zerklueftete Sorte von Eis.");
  AddDetail( "glatteis",
             "Glatteis ist meistens ziemlich glatt. Sei froh, dass es hier nicht"
            +"vorhanden ist, sonst wuerdest Du vermutlich nicht mehr hier stehen.");
  AddDetail( ({"sorte", "sorten", "variante"}),
             "Offensichtlich gibt es viele Sorten von Eis. Hier gibts eher die "
            +"schroffere Variante. Du koenntest es vielleicht wagen, an dem "
            +"zerkluefteten Eis hinaufzuklettern - sofern Du dies einem Tod durch "
            +"Erfrieren oder Verhungern vorziehst.");
  AddDetail( "tod",
             "WENDE DICH BESSER ANDEREN DETAILS ZU!");
  AddDetail( ({"detail", "details"}),
             "Ja, das ist eines.");
  AddDetail( "erfrieren",
             "Ist angeblich ein schoener Tod, es wird dann ganz warm und man schlaeft "
            +"einfach ein. Moechtest Dus ausprobieren?");
  AddDetail( "verhungern",
             "Sicher nicht so toll wie erfrieren, dauert wesentlich laenger. Aber siehs "
            +"positiv, man nimmt ab dabei. Ein paar Kilo weniger koennten Dir auch nicht "
            +"schaden ...");
  AddDetail( "kilo",
             "Du schleppst ganz schoen was rum mit Dir.");
  AddDetail( ({"wand", "waende","eiswand","eiswaende"}),
             "In der Wand vor Dir ist ein ziemlich grosser Spalt. Dahinter scheint "
            +"ein Hohlraum zu sein.");
  AddDetail( ({"spalt", "spalte"}),
             "Du passt locker durch.");
  AddDetail( "boden",
             "Eisig.");
  AddDetail( "decke",
             "Du blickst nach oben und siehst das die Falltuer hinter Dir wieder zugefallen "
            +"ist. Durch ein paar Ritzen faellt jedoch etwas Licht herein.");
  AddDetail( ({"tuer", "falltuer", "falltueren", "tueren"}),
             "Solche Falltueren werden Dir zusehends unsympathischer.");
  AddDetail( ({"ritzen", "ritze"}),
             "Dank denen gibts hier drin ein wenig Licht.");
  AddDetail( "licht",
             "Ohne selbiges waers hier stockdunkel und somit noch ungemuetlicher.");
  AddDetail( ({"raum","hohlraum"}),
             "Da musst Du wohl hingehen, wenn Du Dir den genauer anschauen willst.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst keinen Mucks.");
  AddSound( "mucks",
    "Nichts ...");

  AddCmd( ({"kletter","klettre","klettere"}), "klettern");

}

klettern( str )
{
  notify_fail(BS("Wohin willst Du klettern?\n"));
  if(member( ({"nach oben","oben","rauf","hinauf","hoch"}), str) == -1) {
    return 0;
  }
  else {
    write(BS("Muehsam versuchst Du Halt an der eisigen Wand zu finden, was "
             "Dir nach einigen Versuchen sogar gelingt. Langsam aber sicher "
             "kletterst Du nach oben, schlaegst die Falltuer auf und siehe "
             "da - die Sonne hat Dich wieder!"));
    say(BS(CAP_TPN+" klettert etwas tollpatschig, aber offensichtlich "
            +"effektiv, die Eiswand hoch."));
    TP->move(DORF("hstrasse4"), M_GO);
    return 1;
  }
}
