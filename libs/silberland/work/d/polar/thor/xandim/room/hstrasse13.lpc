#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hauptstrasse" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Hauptstrasse von Yiqanuc, die von Westen nach Osten "
   +"fuehrt. Im Westen schliesst direkt das oestliche Ende des Hauptplatzes "
   +"an. Geschaeftig siehst Du einige Xandim herumlaufen und Du vernimmst "
   +"froehliche Stimmen. Links und rechts vor Dir ist die Hauptstrasse mit "
   +"Iglus gesaeumt.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -10]) );

  AddDetail( ({"hauptstrasse", "strasse"}),
	     "Die Hauptstrasse erstreckt sich von Westen nach Osten.");
  AddDetail( ({"yiqanuc", "dorf", "xandimdorf"}),
	     "Du stehst im oestlichen Teil des Xandimdorfes Yiqanuc.");
  AddDetail( "xandim",
	     "Das ist das Volk, das hier wohnt.");
  AddDetail( "volk",
	     "Das Volk hier heisst Xandim.");
  AddDetail( ({"ende", "platz", "hauptplatz"}),
	     "Gleich im Westen schliesst der Hauptplatz an die Strasse an. "
            +"Der Hauptplatz ist auch etwas belebter, als die Strassen hier. "
	    +"Du siehst viele Xandim geschaeftig hin und her laufen und "
	    +"einige Gespraechsfetzen von angeregten Unterhaltungen dringen "
	    +"an Dein Ohr.");
  AddDetail( ({"gespraechsfetzen", "fetzen", "unterhaltungen"}),
	     "Genaueres kannst Du nicht hoeren, Du hoerst nur viele "
	    +"verschiedene Stimmen.");
  AddDetail( "stimmen",
	     "Lausche doch einfach mal.");
  AddDetail( ({"ohr", "ohren"}),
	     "Deine Ohren sind schon ganz rot vor Kaelte.");
  AddDetail( "kaelte",
	     "Es ist doch relativ kuehl hier, ja.");
  AddDetail( ({"iglu", "iglus"}),
	     "Die vielen Iglus sehen lustig aus. Sie erinnern Dich "
	    +"irgendwie ans Huegelland.");
  AddDetail( ({"land", "huegelland"}),
	     "Dort waere es ein wenig waermer.");
  AddDetail( "boden",
	     "Der Boden ist mit einer Schneeschicht bedeckt.");
  AddDetail( ({"schnee", "schneeschicht"}),
	     "Am Boden ist eine griffige Schneeschicht, auf der man nicht so "
	    +"leicht ausrutscht, wie auf Eis.");
  AddDetail( "eis",
	     "Hier besteht so ziemlich alles aus Eis.");
  AddDetail( "himmel",
             "Ueber Dir ist ein strahlend blauer Himmel.");
  AddDetail( "sonne",
             "Wenn die Sonne nicht scheinen wuerde, waere es wahrscheinlich "
            +"noch um vieles kaelter.");

  AddSound( DEFAULT_SOUND,
    "Westlich, vom Hauptplatz her, hoerst Du rege Unterhaltungen und "
   +"Stimmen.");
  AddSound( ({"stimmen", "unterhaltungen", "unterhaltung", "stimme", "fetzen", 
		"gespraechsfetzen"}),
    "Einige Gespraechsfetzen von Unterhaltungen dringen an Dein Ohr.");

  AddExit( "westen", DORF("hauptplatz4"));
  AddExit( "osten", DORF("hstrasse14"));
 
}
