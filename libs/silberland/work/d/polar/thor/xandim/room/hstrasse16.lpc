#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hauptstrasse" );
  SetProp( P_INT_LONG,
    "Du stehst am Ostende der Hauptstrasse von Yiqanuc. Oestlich von Dir "
   +"ragt das grosse Eingangstor des Dorfes in den Himmel, die Pforten sind "
   +"endlich offen. Die Hauptstrasse fuehrt weiter nach "
   +"Westen und Richtung Nordwesten und Suedwesten fuehrt der Wachweg "
   +"entlang einer Palisade rund um das Dorf herum.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -10]) );

  AddDetail( ({"ende", "ostende", "strasse", "hauptstrasse"}),
	     "Die Hauptstrasse ist hier vor dem Eingangstor zwar zu Ende, "
             "aber dafuer geht es hinter dem Tor wohl weiter.");
  AddDetail( ({"yiqanuc", "dorf", "xandimdorf"}),
	     "Du stehst im westlichen Teil des Xandimdorfes Yiqanuc.");
  AddDetail( "xandim",
	     "Das ist das Volk, das hier wohnt.");
  AddDetail( "volk",
	     "Das Volk hier heisst Xandim.");
  AddDetail( ({"tor", "eingangstor"}),
	     "Das Eingangstor vor Dir ragt hoch in den Himmel hinauf. Endlich "
            +"sind die Pforten geoeffnet worden.");
  AddDetail( ({"pforte", "pforten"}),
	     "Die Pforten des Eingangstores sind offen. Der Weg nach "
	    +"Osten steht Dir frei und Du kannst Dich dort umsehen.");
  AddDetail( "weg",
	     "Irgendwann wird es auch in die oestlichen Gebiete einen Weg "
	    +"geben.");
  AddDetail( "weg",
	     "Ueber den Weg nach Osten kommst Du auf den Ostplatz.");
  AddDetail( ({"ostplatz","platz"}),
	     "Oestlich von Dir, den Weg durch die Pforten durch, erstreckt "
	    +"sich der Ostplatz.");
  AddDetail( "wachweg",
	     "Der Wachweg fuehrt Richtung Nordwesten und Suedwesten rund um "
	    +"das Dorf herum.");
  AddDetail( ({"eispalisade", "palisade"}),
	     "Yiqanuc ist von einer schuetzenden Eispalisade umgeben.");
  AddDetail( "boden",
	     "Der Boden ist mit einer Schneeschicht bedeckt.");
  AddDetail( ({"schnee", "schneeschicht"}),
	     "Am Boden ist eine griffige Schneeschicht, auf der man nicht so "
	    +"leicht ausrutscht, wie auf Eis.");
  AddDetail( "eis",
	     "Hier besteht so ziemlich alles aus Eis.");
  AddDetail( "himmel",
             "Ueber Dir ist ein strahlend blauer Himmel.");
  AddDetail( "sonne",
             "Wenn die Sonne nicht scheinen wuerde, waere es wahrscheinlich "
            +"noch um vieles kaelter.");

  AddReadDetail( "schild",
		 "\n R A T H A U S \n\n");

  AddSound( DEFAULT_SOUND,
    "Weiter westlich, in der Dorfmitte, hoerst Du reges Treiben.");
  AddSound( "treiben",
    "Du hoerst leise Stimmen und einige Gespraechsfetzen an Dein Ohr "
   +"dringen.");

  AddExit( "westen", DORF("hstrasse15"));
  AddExit( "nordwesten", DORF("wachweg13"));
  AddExit( "suedwesten", DORF("wachweg8"));
 
  AddExit( "osten", "/d/polar/rage/ostplatz/room/ostplatz_b2" );
}
