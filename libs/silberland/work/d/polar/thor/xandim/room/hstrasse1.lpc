***********************************/

#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hauptstrasse" );
  SetProp( P_INT_LONG,
    "Du stehst am Anfang der Hauptstrasse von Yiqanuc, dem Xandimdorf. "
   +"Westlich und oestlich von Dir fuehren zwei Wege rund um die Palisade "
   +"des Dorfes herum. Hier in der suedlichen Haelfte des Dorfes ist noch "
   +"nicht allzuviel zu sehen, links und rechts von Dir stehen nur ein paar "
   +"kuppelfoermige Gebilde, die aus Eisbloecken gebaut wurden. Sie dienen als "
   +"Behausung der Xandim. Dies hier scheint wohl eher das Wohnviertel des "
   +"Dorfes zu sein.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -10]) );

  AddDetail( "anfang",
	     "Das hier ist der Anfang der Hauptstrasse, die quer durch "
            +"Yiqanuc fuehrt.");
  AddDetail( ({"strasse", "hauptstrasse"}),
	     "Die Strasse erstreckt sich von Sueden nach Norden.");
  AddDetail( ({"yiqanuc", "dorf", "xandimdorf"}),
	     "Da bist Du gerade.");
  AddDetail( ({"wege","weg"}),
	     "Richtung Nordwesten und Nordosten fuehren zwei Wege an der "
            +"Innenseite der Eispalisade um das Dorf herum.");
  AddDetail( ({"seite", "innenseite"}),
	     "Du bist an der Innenseite der Eispalisade, die um das Dorf "
            +"herumfuehrt.");
  AddDetail( ({"palisade", "eispalisade"}),
	     "Sie geht links und rechts von Dir weg.");
  AddDetail( "haelfte",
	     "Es gibt nicht allzu viel zu sehen, hier in der suedlichen "
            +"Haelfte des Dorfes. Weiter im Norden dringen aber mehrere "
            +"Geraeusche zu Dir.");
  AddDetail( "geraeusch", 
	     "Vielleicht solltest Du mal lauschen?");
  AddDetail( "gebilde",
	     "Man koennte die Gebilde eigentlich auch Iglus nennen. Nur sind "
            +"sie wesentlich hoeher als gewoehnliche Iglus, von der Form her "
            +"aber ziemlich gleich.");
  AddDetail( "form",
	     "Die kuppelfoermigen Gebilde sehen aus wie Iglus.");
  AddDetail( "boden",
	     "Der Boden besteht aus blankem Eis und ist mit ein wenig Schnee "
            +"bedeckt.");
  AddDetail( "schnee",
	     "Am Boden liegt ein wenig Schnee.");
  AddDetail( "eis",
             "Der Boden unter Dir besteht hauptsaechlich aus Eis.");
  AddDetail( ({"iglu", "iglus"}),
             "Die Iglus sind aus grossen Eisbloecken gefertigt, die danach "
            +"miteinander verschmolzen wurden, um ordentlich fixiert zu "
	    +"sein.");
  AddDetail( ({"bloecke", "eisbloecke"}),
	     "Die Eisbloecke wurden wohl irgendwo herausgehauen und dann hier "
            +"her transportiert.");
  AddDetail( "behausung",
	     "Die Iglus dienen als Behausung der Xandim.");
  AddDetail( "xandim",
	     "Das ist die Rasse, die hier beheimatet ist.");
  AddDetail( "rasse",
	     "Dies ist das Dorf der Xandim.");
  AddDetail( ({"viertel", "wohnviertel"}),
	     "Das scheint hier das Wohnviertel der Xandim zu sein. Weiter "
            +"noerdlich ist bestimmt mehr los.");
  AddDetail( "himmel",
	     "Ueber Dir ist ein strahlend blauer Himmel.");
  AddDetail( "sonne",
	     "Wenn die Sonne nicht scheinen wuerde, waere es wohl noch "
	    +"frostiger, als es sowieso schon ist.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst geschaeftiges Treiben weiter noerdlich.");
  AddSound( ({"treiben", "geraeusch", "geraeusche"}),
    "Du hoerst ein froehliches Treiben aus dem Norden des "
   +"Dorfes."); 

  AddExit( "norden", DORF("hstrasse2"));
  AddExit( "sueden", DORF("suedtor"));
  AddExit( "nordwesten", DORF("wachweg1"));
  AddExit( "nordosten", DORF("wachweg5"));
}

