#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hauptstrasse" );
  SetProp( P_INT_LONG,
    "Du bist am westlichen Ende von Yiqanuc angekommen. Die Hauptstrasse "
   +"fuehrt nach Osten weiter in das Dorf hinein, im Westen kannst Du das "
   +"Dorf durch ein grosses Tor verlassen. Links und rechts von Dir, nach "
   +"nordosten und suedosten kannst Du den Wachweg entlang der Eispalisade "
   +"rund um das Dorf herumgehen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -10]) );

  AddDetail( "ende",
	     "Du stehst hier am westlichen Ende von Yiqanuc.");
  AddDetail( "yiqanuc",
	     "Da bist Du gerade.");
  AddDetail( ({"strasse", "hauptstrasse"}),
	     "Die Hauptstrasse geht nach Osten weiter in das Dorf hinein.");
  AddDetail( ({"dorf", "xandimdorf"}),
	     "Du bist im Xandimdorf Yiqanuc.");
  AddDetail( "xandim",
	     "So heisst das Volk, das hier beheimatet ist.");
  AddDetail( ({"volk", "xandimvolk", "einwohner"}),
	     "Die Einwohner dieses Dorfes heissen Xandim.");
  AddDetail( "tor",
	     "Ein grosses Tor ist westlich von Dir. Dort kannst Du das Dorf "
	    +"verlassen.");
  AddDetail( ({"wachweg", "weg"}),
	     "Der Wachweg fuehrt im Nordosten und im Suedosten rund um das "
	    +"Dorf herum.");
  AddDetail( ({"palisade", "eispalisade"}),
	     "Die hohe Eispalisade umgibt das Dorf, um es vor Feinden zu "
	    +"schuetzen.");
  AddDetail( ({"feinde", "feind"}),
	     "Einige Ausgestossene wohnen etwas weiter weg von Yiqanuc und "
	    +"ueberfallen das Dorf machmal.");
  AddDetail( ({"ausgestossene", "abtruennige"}),
	     "Die Ausgestossenen sind Abtruennige des normalerweise "
	    +"friedlichen Xandimvolkes.");
  AddDetail( "himmel",
	     "Ueber Dir ist ein strahlend blauer Himmel.");
  AddDetail( "sonne",
	     "Wenn die Sonne nicht scheinen wuerde, waere es wahrscheinlich "
	    +"noch um vieles kaelter.");
  AddDetail( "boden",
	     "Der Boden besteht aus Eis und Schnee.");
  AddDetail( "eis",
	     "Alles ist hier aus Eis gemacht.");
  AddDetail( "schnee",
	     "Etwas Schnee liegt am Boden herum.");

  AddSound( DEFAULT_SOUND,
    "Weiter oestlich, in der Dorfmitte, hoerst Du reges Treiben.");
  AddSound( "treiben",
    "Es ist noch etwas weiter weg, aber Du hoerst es deutlich.");

  AddExit( "nordosten", DORF("wachweg9"));
  AddExit( "suedosten", DORF("wachweg4"));
  AddExit( "westen", DORF("westtor"));
  AddExit( "osten", DORF("hstrasse10"));
}



