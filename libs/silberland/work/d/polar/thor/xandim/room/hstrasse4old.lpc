#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hauptstrasse" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Hauptstrasse des Xandimdorfes Yiqanuc, die von Sueden "
   +"nach Norden fuehrt. Ein Stueckchen weiter noerdlich hoerst Du lautes, "
   +"froehliches Treiben, denn gleich vor Dir liegt der Hauptplatz des "
   +"Dorfes. Ausserdem erkennst Du links und rechts von Dir, auch ein "
   +"bisschen weiter noerdlich zwei groessere Gebaeude.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -10]) );

  AddDetail( ({"strasse", "hauptstrasse"}),
	     "Die Hauptstrasse fuehrt von Sueden nach Norden quer durch "
	    +"das Dorf.");
  AddDetail( ({"dorf", "xandimdorf", "yiqanuc"}),
	     "Du bist gerade in dem Dorf der Xandim, Yiqanuc.");
  AddDetail( "xandim",
	     "Die Xandim sind die Einwohner dieses Dorfes.");
  AddDetail( "einwohner",
	     "Einwohner wohnen gewoehnlich in ihren Doerfern ;)");
  AddDetail( "treiben",
	     "Ein bisschen weiter noerdlich scheint etwas mehr los zu sein "
	    +"als hier.");
  AddDetail( ({"platz", "hauptplatz"}),
	     "Gleich noerdlich von Dir ist der Hauptplatz des Dorfes.");
  AddDetail( "gebaeude",
	     "Nordwestlich und Nordoestlich kannst Du zwei groessere "
	    +"Gebaeude erkennen.");
  AddDetail( "himmel",
	     "Ueber Dir ist ein strahlend blauer Himmel.");
  AddDetail( "sonne",
	     "Ohne die Sonne waere es hier vermutlich noch viel, viel "
	    +"kaelter."); 
  AddDetail( "boden",
	     "Der Boden besteht aus blankem Eis und ist mit ein wenig Schnee "
            +"bedeckt.");
  AddDetail( "eis",
             "Das ist der Hauptbestandteil des Bodens.");
  AddDetail( ({"bestandteil", "hauptbestandteil"}),
             "Der Boden besteht aus Eis und Schnee.");
  AddDetail( "schnee",
	     "Am Boden liegt ein wenig Schnee.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst reges Treiben von dem Hauptplatz her.");
  AddSound( "treiben",
    "Du hoerst froehliche Stimmen und Unterhaltungen.");
  AddSound( ({"stimmen", "unterhaltungen"}),
    "Die Leute klingen aeusserst gutgelaunt.");
    
  AddExit( "norden", DORF("hauptplatz1"));
  AddExit( "sueden", DORF("hstrasse3"));
}
