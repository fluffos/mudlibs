#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hauptstrasse" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Hauptstrasse von Yiqanuc, die von Westen nach Osten "
   +"fuehrt. Suedlich von Dir siehst Du ein grosses Iglu, auf dessen oberer "
   +"Kuppel Du einige Verzierungen und ein Schild erkennen kannst. Das "
   +"Treiben im Osten wird nun auch zunehmend lauter.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -10]) );

  AddDetail( ({"hauptstrasse", "strasse"}),
	     "Die Hauptstrasse erstreckt sich von Westen nach Osten.");
  AddDetail( ({"yiqanuc", "dorf", "xandimdorf"}),
	     "Du stehst im westlichen Teil des Xandimdorfes Yiqanuc.");
  AddDetail( "xandim",
	     "Das ist das Volk, das hier wohnt.");
  AddDetail( "volk",
	     "Das Volk hier heisst Xandim.");
  AddDetail( "iglu",
	     "Das Iglu ist groesser als alle anderen und die Waende sind mit "
	    +"kunstvollen Eisschnitzereien verziert. Auf dem Dach siehst Du "
	    +"ein hoelzernes Schild.");
  AddDetail( ({"waende", "kuppel", "wand"}),
	     "Das Iglu ist ueber und ueber mit kunstvollen Eisschnitzereien "
	    +"ueberzogen.");
  AddDetail( ({"verzierung", "verzierungen"}),
	     "Es sind kunstvolle Eisschnitzereien.");
  AddDetail( ({"schnitzereien", "eisschnitzereien"}),
	     "In diesem Iglu scheint jemand wichtiger zu wohnen.");
  AddDetail( "dach",
	     "Auf dem Dach siehst Du ein grosses, hoelzernes Schild.");
  AddDetail( "schild",
	     "Du kannst es lesen.");
  AddDetail( "treiben",
	     "Lausche doch einfach mal.");
  AddDetail( "boden",
	     "Der Boden ist mit einer Schneeschicht bedeckt.");
  AddDetail( ({"schnee", "schneeschicht"}),
	     "Am Boden ist eine griffige Schneeschicht, auf der man nicht so "
	    +"leicht ausrutscht, wie auf Eis.");
  AddDetail( "eis",
	     "Hier besteht so ziemlich alles aus Eis.");
  AddDetail( "himmel",
             "Ueber Dir ist ein strahlend blauer Himmel.");
  AddDetail( "sonne",
             "Wenn die Sonne nicht scheinen wuerde, waere es wahrscheinlich "
            +"noch um vieles kaelter.");
  AddDetail( "rathaus",
             "Das Rathaus suedlich von Dir ist fuer Dich leider nicht "
            +"zugaenglich.");

  AddReadDetail( "schild",
		 "\n R A T H A U S \n\n");

  AddSound( DEFAULT_SOUND,
    "Weiter oestlich, in der Dorfmitte, hoerst Du reges Treiben.");
  AddSound( "treiben",
    "Du hoerst leise Stimmen und einige Gespraechsfetzen an Dein Ohr "
   +"dringen.");

  AddExit( "westen", DORF("hstrasse10"));
  AddExit( "osten", DORF("hstrasse12"));
  AddSpecialExit( "sueden", "go_south");
 
}

int go_south(string dir)
{
  write(BS("Das Rathaus ist wegen Umbauarbeiten geschlossen."));
  return 1;
}
