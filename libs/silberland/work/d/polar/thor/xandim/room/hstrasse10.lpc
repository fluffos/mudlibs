#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hauptstrasse" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Hauptstrasse von Yiqanuc. Die Strasse fuehrt von "
   +"Westen nach Osten und im Westen kannst Du noch das Eingangstor des "
   +"Dorfes erkennen. Links und rechts von Dir siehst Du zahlreiche Iglus, "
   +"die sich halbkugelfoermig erheben. Von Osten her hoerst Du das rege "
   +"Treiben des Hauptplatzes des Dorfes.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -10]) );

  AddDetail( ({"hauptstrasse", "strasse"}),
	     "Die Hauptstrasse erstreckt sich von Westen nach Osten.");
  AddDetail( ({"yiqanuc", "dorf", "xandimdorf"}),
	     "Du stehst am Westende des Xandimdorfes Yiqanuc.");
  AddDetail( ({"ende", "westende"}),
	     "Viel weiter nach Westen geht es nicht ;)");
  AddDetail( "xandim",
	     "Das ist das Volk, das hier wohnt.");
  AddDetail( "volk",
	     "Das Volk hier heisst Xandim.");
  AddDetail( ({"tor", "eingangstor"}),
	     "Im Westen siehst Du es noch.");
  AddDetail( ({"behausung", "behausungen", "iglu", "iglus"}),
	     "Die Iglus sind die Behausungen der Xandim.");
  AddDetail( "boden",
	     "Der Boden ist mit einer Schneeschicht bedeckt.");
  AddDetail( ({"schnee", "schneeschicht"}),
	     "Am Boden ist eine griffige Schneeschicht, auf der man nicht so "
	    +"leicht ausrutscht, wie auf Eis.");
  AddDetail( "eis",
	     "Hier besteht so ziemlich alles aus Eis.");
  AddDetail( "himmel",
             "Ueber Dir ist ein strahlend blauer Himmel.");
  AddDetail( "sonne",
             "Wenn die Sonne nicht scheinen wuerde, waere es wahrscheinlich "
            +"noch um vieles kaelter.");
  AddDetail( "treiben",
	     "Vielleicht solltest Du mal lauschen?");
  AddDetail( ({"platz", "hauptplatz"}),
	     "Der Hauptplatz liegt weiter oestlich von Dir.");

  AddSound( DEFAULT_SOUND,
    "Weiter oestlich, in der Dorfmitte, hoerst Du reges Treiben.");
  AddSound( "treiben",
    "Es ist noch etwas weiter weg, aber Du hoerst es deutlich.");

  AddExit( "westen", DORF("hstrasse9"));
  AddExit( "osten", DORF("hstrasse11"));

 
}
