*  Ein stinknormaler Laden - laden.c  *
*  1997-12-08                         *
**************************************/

#include "../xandim.h"

inherit "std/laden";

#include <properties.h>
#include <laden.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein stinknormaler Laden" );
  SetProp( P_INT_LONG, "\t"+BS(
    "Du stehst im Ladeniglu von Yiqanuc. Die Innenwaende des Iglus sind mit "
   +"einer Vielzahl von Regalen ausgezimmert, auf denen die verschiedensten "
   +"Waren herumliegen. An der linken Wand haengt ein grosses Schild und in "
   +"der Mitte des Iglus steht eine lange Verkaufstheke, auf der auch "
   +"diverses Zeug herumliegt.")+"@@haendler@@");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE: 5]) );
  SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp (P_SHOPKEEPER_ID, "bagol");
  SetProp (P_SHOPKEEPER_NAME, "Bagol");
  SetProp (P_SHOPKEEPER_GENDER, MALE);


  AddDetail( ({"laden", "iglu", "ladeniglu"}),
	     "Du stehst mitten drinnen.");
  AddDetail( "yiqanuc",
	     "Dies ist das Doerfchen hier.");
  AddDetail( ({"dorf", "doerfchen"}),
	     "Das Dorf hier heisst Yiqanuc.");
  AddDetail( ({"innenwaende", "waende"}),
	     "Du kannst nicht viel von den Waenden erkennen, da sie ueber und "
	    +"ueber mit Regalen ausgezimmert sind.");
  AddDetail( "wand",
	     "Ein grosses Schild haengt an der linken Wand.");
  AddDetail( ({"decke", "boden"}),
	     "Decke und Boden von dem Iglu bestehen aus Eis, wie das nun "
	    +"mal bei einem Iglu so ueblich ist.");
  AddDetail( "eis",
	     "Alles in dem Dorf scheint aus Eis zu bestehen.");
  AddDetail( ({"vielzahl", "menge"}),
	     "Jede Menge Regale sind an den Waenden.");
  AddDetail( ({"regale", "regal"}),
	     "Auf den Regalen siehst Du jede Menge Waren herumliegen.");
  AddDetail( "waren",
	     "Du kannst sie kaufen.");
  AddDetail( "schild",
	     "Vielleicht sollst Du es mal mit lesen versuchen?");
  AddDetail( ({"mitte", "theke", "verkaufstheke"}),
	     "Auf der Verkaufstheke liegen auch verschiedene Sachen herum, "
	    +"die der Haendler anscheinend noch nicht eingeraeumt hat.");
  AddDetail( ({"zeug", "sachen"}),
	     "Naja, Klumpert halt.");
  AddDetail( "klumpert",
	     "Klumpert heisst auch Ramsch.");
  AddDetail( "ramsch",
	     "Ramsch ist das gleiche wie Klumpert.");
  AddReadDetail( "schild", 
" ------------------------------------------------------------------------- \n"
"|                                                                         |\n"
"|                       K  O  M  M  A  N  D  O  S                         |\n"
"|                                                                         |\n"
" ------------------------------------------------------------------------- \n" 
"|                                                                         |\n"
"|  <zeige>           Uebersicht ueber das Angebot im Laden.               |\n"
"|  <unt> nummer      Beschreibung eines Gegenstands der Liste aus         |\n"
"|  <kaufe> nummer oder                                                    |\n"
"|  <kaufe> etwas     Du kaufst einen bestimmten Gegenstand.               |\n"
"|  <verkaufe> etwas  Du verkaufst einen Gegenstand, den Du bei Dir hast.  |\n"
"|  <versetze> etwas  Du verkaufst einen Gegenstand, egal wieviel der      |\n"
"|                    Haendler dafuer bezahlt.                             |\n"
"|  <schaetz> etwas   Der Haendler sagt Dir, wieviel ihm ein Gegenstand    |\n"
"|                    wert waere, wenn Du ihn verkaufen wuerdest.          |\n"
"|                                                                         |\n"
" ------------------------------------------------------------------------- \n"
);
  
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist kuehl und frisch.");
  AddSmell( "luft",
    "Die Luft hier drinnen ist sehr angenehm. Sie ist nicht ganz so kalt "
   +"wie draussen.");

  SetStorageRoom(DORF("lagerraum"));

//  AddItem("/d/ebene/obj/div/teddyautomat", REFRESH_REMOVE);
  AddItem(NPC("bagol"), REFRESH_DESTRUCT);

  AddExit( "osten", DORF("hauptplatz1"));
}

string haendler()
{
  if (present("bagol", TO))
    return BS("Hinter der Verkaufstheke steht ein alter Haendler, der Dich "
	     +"mit freundlichen Augen ansieht.");
  else
    return "";
}





