/*********************************
*  Thor@SilberLand               *
*  Die Xandim-Kneipe - kneipe.c  *
*  1998-06-28                    *
*********************************/

   
inherit "std/pub";

#include "../xandim.h"
#include <moving.h>
#include <player.h>
#include <properties.h>
#include <pub.h>

create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:10]));
  SetProp (P_INT_SHORT, "Kneipe 'Zum erfrorenen Pinguin'");
  SetProp (P_INT_LONG, "\t"+BS(
     "Du stehst mitten in einer rauchigen Kneipe. Trotz der stickigen Luft "
    +"durchstroemt ein leckerer Duft von Essen den Raum, der Dir das Wasser "
    +"im Mund zusammenlaufen laesst. Einige Tische mit Stuehlen drumherum "
    +"stehen kreuz und quer in der Kneipe. Die braunen Holzmoebel heben sich "
    +"drastisch von dem ansonsten absolut weissen Iglu ab. An der Suedwand "
    +"steht eine lange Theke mit einer Bar, die ein reiches Sortiment an "
    +"Getraenken bietet. Dort in der Wand ist auch eine Durchreiche, wo von "
    +"der Kueche die Speisen zum Verkauf durchgereicht werden. An der Ostwand "
    +"befindet sich ausserdem noch eine Tuer.")+"@@wirt@@");
  
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "zynra");
  SetProp(P_PUBKEEPER_NAME, "Zynra");
  SetProp(P_PUBMSG_NOKEEPER, "Tja, keine Wirtin da ... Zur Zeit wird hier "
                            +"wohl nichts serviert.\n");
  SetProp(P_PUBMSG_NOENEMY, "Zynra hat gerade alle Haende voll mit Dir zu "
                           +"tun.\n"); 
  SetProp(P_PUBMSG_NOINVITE, "Zynra spuckt Dir bloss ins Gesicht\n");
  SetProp(P_PUBMSG_FIGHTING, "Zynra bittet Dich, doch in ein paar Minuten "
                            +"nochmal vorbei zu schauen.\n");

  AddDetail( ({"kneipe", "raum"}),
             "Sieh Dich doch einfach mal um.");
  AddDetail( ({"luft", "geruch"}),
             "Versuchs mal mit riechen.");
  AddDetail( "essen",
             "Ja, in Kneipen gibts meistens auch was zu Essen. Mit \"menue\" "
            +"erfaehrst Du auch was.");
  AddDetail( ({"wasser", "mund"}),
             "Bei dem herrlichen Duft laeuft Dir das Wasser im Mund zusammen.");
  AddDetail( ({"tisch", "tische"}),
             "An den Tischen sitzen einige Leute, die sich mehr oder minder "
            +"geschaeftig unterhalten.");
  AddDetail( ({"stuhl", "stuehle"}),
             "Die Stuehle stehen rund um die Tische herum, damit sich die "
            +"Leute auch hinsetzen koennen.");
  AddDetail( ({"gesicht", "gesichter", "leute"}),
             "Du siehst viele verschiedene Gesichter. Es ueberwiegen Xandim, "
            +"aber es sind auch einige Elfen, Zwerge und Menschen zu sehen. "
            +"In einer Ecke sitzt sogar ein riesiger, furchteinfloessender "
            +"Troll.");
  AddDetail( "xandim",
             "Es ist nicht weiter verwunderlich, dass die meisten Besucher "
            +"dieser Kneipe Xandim sind.");
  AddDetail( "besucher",
             "Sowas bist Du auch gerade. Also benimm Dich gefaelligst!");
  AddDetail( ({"elfen", "zwerge", "menschen", "elf", "zwerg", "mensch"}),
             "Dick eingemummt sitzen sie an den Tischen und sind froh, "
            +"sich von der grausamen Kaelte draussen ein wenig erholen zu "
            +"koennen.");
  AddDetail( "kaelte",
             "Ja, draussen ist es grimmig kalt.");
  AddDetail( "troll",
             "Der Troll sitzt ganz allein an einem Tisch. Vermutlich hat "
            +"niemand den Mut, sich zu ihm dazuzusetzen.");
  AddSpecialDetail( "mut", "unt_mut" );
  AddDetail( ({"trolle", "ungetueme", "ungetuem"}),
             "Ja, Trolle sind meistens wahre Ungetueme.");
  AddDetail( ({"moebel", "holzmoebel"}),
             "Die Holzmoebel heben sich stark vom schneeweissen Iglu ab.");
  AddDetail( "iglu",
             "Dies ist das Kneipen-Iglu ;)");
  AddDetail( "suedwand",
             "Eine lange Theke steht an der Suedwand. Ausserdem ist eine "
            +"Durchreiche in der Wand.");
  AddDetail( "ostwand",
             "Dort ist eine Tuer.");
  AddDetail( "tuer",
             "Wo die wohl hinfuert?");
  AddDetail( "boden",
             "Der Boden besteht aus aufgerauhtem Eis, damit es nicht zu "
             "rutschig ist hier drinnen, und ist blitzeblank gefegt.");
  AddDetail( ({"westwand", "nordwand", "waende"}),
             "An den Waenden haengen einige Landschaftsbilder der Polarregion "
             "und einige Portraits von einstmals wichtigen Xandim.");
  AddDetail( ({"gegend", "gegenden", "bilder", "landschaftsbilder"}),
             "Nur die wenigsten Gegenden auf den Bildern kommen Dir bekannt "
             "vor. Es ist vermutlich erst ein geringer Teil der Polarregion "
             "erschlossen.");
  AddDetail( ({"polar", "polarregion", "region", "teil"}),
             "Es ist vermutlich erst ein kleiner Teil der Region frei "
             "zugaenglich.");
  AddDetail( ({"person", "personen", "portraits", "portrait"}),
             "Es scheinen wichtige Personen gewesen zu sein, denn alle "
             "strahlen eine gewisse Wuerde aus.");
  AddDetail( "wuerde",
             "Die wirst Du vermutlich nie kriegen :)");
  AddDetail( "wand",
             "Welche genau meinst Du denn?");
  AddDetail( "eis",
             "Das ganze Iglu besteht aus Eis.");
  AddDetail( "theke",
             "Das wichtigste an der Theke ist vermutlich die Bar, die ein "
             "grosses Sortiment an Getraenken bietet.");
  AddDetail( "bar",
             "Flaschen in allen Formen und Farben sind daran aufgestellt und "
             "Du haettest grosse Lust, Dich einmal quer durch zu kosten.");
  AddDetail( ({"flaschen", "flasche"}),
             "Alle nur erdenklichen Formen von Flaschen stehen an der Bar. "
             "Du Flasche gehoerst vermutlich zu den skurrilsten :)");
  AddDetail( ({"formen", "form"}),
             "Dick, duenn, rund, eckig, lang, kurz, bauchig und was es sonst "
             "noch so an Formen gibt.");
  AddDetail( ({"farbe", "farben"}),
             "Blau, rot, gruen, gelb, lila, rosa, violett, schwarz, weiss "
             "usw. usf. Ich glaube, Du weisst, was ich meine.");
  AddDetail( "lust",
             "Probiere doch einfach ein paar Getraenke hier.");
  AddDetail( ({"getraenk", "getraenke", "speise", "speisen", "angebot", 
               "uebersicht", "sortiment"}),
             "Mit \"menue\" bekommst Du eine Uebersicht ueber das Angebot "
             "hier.");
  AddDetail( ({"duft", "duefte"}),
             "Duefte kann man nur schwer untersuchen ...");
  AddDetail( "decke",
             "Diese ist Dir immer noch nicht auf den Kopf gefallen.");
  AddDetail( "kopf",
             "Besorgt tastest Du nach Deinem Kopf. Uffz, noch da.");
  AddDetail( ({"durchreiche", "reiche"}),
             "Hinter der Durchreiche ist die Kueche, von dort kommen die "
             "fertigen Speisen, die dann Dir serviert werden.");
  AddDetail( ({"ecke", "ecken"}),
             "Der Raum, der hat vier Ecken ...");
  AddDetail( "kueche",
             "Aus der Kueche zieht ein verlockender Duft in den Raum. Kein "
             "Wunder, denn dort werden auch die leckeren Speisen zubereitet.");
  AddDetail( "wunder",
             "Auf das wartest Du immer noch ...");
  AddDetail( "verkauf",
             "Hier wird hauptsaechlich Nahrung verkauft ...");
  AddDetail( "nahrung",
             "Mit \"menue\" siehst Du, was es so gibt.");
  
  AddSmell( DEFAULT_SMELL, "Es duftet herrlich nach allen moeglichen "
            "Speisen.");
  AddSmell( ({"duft", "duefte", "speise", "speisen"}),
            "Der Duft laesst Dir das Wasser im Munde zusammenlaufen.");
  AddDrink("Icebreaker", ({"icebreaker", "breaker"}),
           100, 15, 10, 5,
           ({ BS(
             "Zynra stellt Dir ein Glaeschen mit einer klaren, aeusserst "
             "scharf riechenden Fluessigkeit vor die Nase. Mutig kippst "
             "Du sie hinunter und hast den Eindruck, als wuerde "
             "Deinen Rachen in Flammen aufgehen."),
             "&& kippt einen Icebreaker hinunter und roechelt daraufhin "
             "laut."}));

  AddDrink("Whiskey on the Rocks", ({"whiskey", "whisky"}),
           150, 15, 20, 5,
           ({BS(
             "Zynra serviert Dir ein Glas, dessen Inhalt zu siebzig Prozent "
             "aus Eiswuerfel besteht ... Du ruempfst die Nase und vernichtest "
             "den Whiskey."),
             "&& trinkt naseruempfend ein Glas Whiskey."}));

  AddDrink("Brennendes Eiswasser", ({"wasser", "eiswasser"}),   // Name, IDs,
           400, 30, 0, 8,                       // Preis, LP, Alk, Saettigung,
           ({ BS(
             "Du bekommst ein Glaeschen glasklares Wasser serviert, welches "
             "jedoch lichterloh brennt. Etwas verwirrt stuerzt Du es hinunter "
             "und stellst fest, dass es hervorragend schmeckt!"),
             "&& bekommt ein Glas brennendes Wasser serviert."}));

  AddDrink("Xandim Spezial", ({"spezial", "xandim spezial"}),
           500, ({0,80}), 8, 25,
           ({ BS(
             "Zynra stellt Dir ein Glas vor die Nase, dessen Inhalt "
             "staendig seine Farbe aendert. Skeptisch kippst Du es "
             "hinunter und findest, dass es genauso vielfaeltig schmeckt, "
             "wie es aussah."),
             "&& kippt skeptisch ein Glas mit farbveraendernder Fluessigkeit "
             "hinunter."}));

  AddDrink("Heisser Kamillentee", ({"tee", "kamillentee"}),
           50, 10, 0, 10,
           ({ BS(
             "Du bekommst eine Tasse Tee und verschluckst Dich fast daran, "
             "weil er so heiss ist."),
             "&& verbrennt sich den Mund mit einer Tasse heissen Tee."}));

  AddDrink("Heisse Schokolade", ({"schokolade", "kakao"}),
           80, 15, 0, 15,
           ({ BS(
             "Zynra serviert Dir ein Haeferl heisse Schokolade mit etwas "
             "Schlagobers garniert. Es schmeckt einfach koestlich!"),
             "&& trinkt genuesslich ein Haeferl heisse Schokolade."}));
  AddFood ("Eiswuerfel", ({"eiswuerfel", "wuerfel"}),
           10, 5, 1,                  //Preis, LPs, Saettigung
          ({ BS(
            "Du bekommst einen Eiswuerfel in die Hand gedrueckt, den Du "
            "etwas verwirrt hinunterschluckst. Hm, nicht gerade "
            "ueberwaeltigend."),
            "Zynra drueckt && einen Eiswuerfel in die Hand, den &1 "
            "mit eher wenig Begeisterung hinunterschluckt."}));

  AddFood ("Hechtsuppe", ({"hechtsuppe", "suppe"}),
           100, 10, 15,                   
          ({ BS(
            "Du bekommst einen Teller voll Suppe und denkst Dir dabei nur "
            ". o O (Hier zieht es ja wie Hechtsuppe ...)"),
            
            "&& loeffelt einen Teller Hechtsuppe leer. Ploetzlich meinst Du, "
            "einen leichten Luftzug zu vernehmen ..."}));

  AddFood ("Pinguinflossen", ({"pinguinflossen", "flossen"}),
           200, 15, 10,                   
          ({ BS( 
            "Zynra serviert Dir einen wunderschoen garnierten Teller "
            "Pinguinflossen. Eine kulinarische Meisterleistung, diese "
            "Flossen."),
            "&& bekommt einen Teller voll mit kleinen, schwarzen Flossen."}));

  AddFood ("Eisbaerenbaellchen", ({"eisbaerenbaellchen", "baellchen"}),
           500, 25, 10,                   
          ({ BS(
            "Du bekommst eine Spezialitaet aus diesen Gefilden serviert, und "
            "zwar irgend ein Teil eines Eisbaeren, wobei Du nicht genauer "
            "eruieren willst, welcher Teil das denn nun genau ist."),
            "&& bekommt ein Schuesselchen voll kleiner, runder, fleischiger "
            "Dinger serviert."}));

  AddFood ("Haifischsteak", ({"haifischsteak", "steak"}),
           300, ({80,0}), 24,
          ({ BS(
            "Zynra serviert Dir ein zartes, filetiertes Haifischsteak, "
            "welches Du genuesslich verspeist."),
            "&& verspeist genuesslich ein zartes Haifischsteak."}));

  AddFood ("Der Kopf des Eisdrachen", ({"kopf", "drachenkopf"}),
           1500, 100, 60,                   
          ({ BS(
            "Zynra tischt Dir einen riesigen Drachenkopf auf, der so "
            "furchterregend aussieht, dass Du beinahe vom Sessel kippst. "
            "Du atmest einmal tief durch und machst Dich tapfer ans Werk, "
            "dieses Monstrum zu verspeisen."),
            "&& macht sich tapfer ans Werk, einen Drachenkopf zu "
            "verspeisen."}));

  AddCmd (({"kauf","kaufe","bestell","bestelle"}),"bestelle");
  AddCmd (({"spendier","spendiere"}),"spendiere");
//  AddCmd ("","able",1);

  AddItem(NPC("zynra"), REFRESH_DESTRUCT);
  AddItem( "/p/service/thor/postcards/npc/postman", REFRESH_DESTRUCT, 1);
  
  NewDoor("osten", DORF("kneipe2"),
          ({"tuer", "tuere"}),
          ({
            D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED,
            D_LONG, "Wo die wohl hinfuehrt?",
            D_GENDER, FEMALE,
            D_SHORT, "",
            D_NAME, "Tuer",
           }) );
  
  AddExit ("norden", DORF("hauptplatz4"));
}

string unt_mut()
{
  if(TP->QueryProp(P_RACE)=="Troll")
    {
    return BS("Du verstehst gar nicht, was so furchteinfloessend an dem "
             +"Troll sein soll. Er sieht eigentlich ganz nett aus.");
    }
  else
    {
    return BS("Kein Wunder, wuerdest Du Dich freiwillig zu so einem "
             +"Ungetuem an den Tisch setzen?");
    }
}

string wirt()
{
  if(present("zynra"))
    return BS("Hinter der Theke steht eine etwas mollige Xandim-Dame, die "
              "Dich mit freundlichen Augen anblickt.");
  else
    return "";
}
