#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

mapping snowball;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hauptstrasse" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Hauptstrasse von Yiqanuc, die von Osten nach Westen "
   +"fuehrt. Links und rechts von Dir siehst Du zahlreiche Iglus, "
   +"die sich halbkugelfoermig erheben. Neben einem Iglu liegt ein grosser "
   +"Schneehaufen. Von Westen her hoerst Du das rege "
   +"Treiben des Hauptplatzes des Dorfes.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -10]) );

  AddDetail( ({"hauptstrasse", "strasse"}),
	     "Die Hauptstrasse erstreckt sich von Osten nach Westen.");
  AddDetail( ({"yiqanuc", "dorf", "xandimdorf"}),
	     "Du stehst im Xandimdorf Yiqanuc.");
  AddDetail( "xandim",
	     "Das ist das Volk, das hier wohnt.");
  AddDetail( "volk",
	     "Das Volk hier heisst Xandim.");
  AddDetail( ({"behausung", "behausungen", "iglus"}),
	     "Die Iglus sind die Behausungen der Xandim.");
  AddDetail( "iglu",
	     "Neben einem Iglu siehst Du einen grossen Schneehaufen.");
  AddDetail( ({"haufen", "schneehaufen"}),
	     "Ein grosser Schneehaufen ist neben einem Iglu "
	    +"zusammengeschaufelt worden. Du haettest Lust, Dir ein paar "
	    +"Schneebaelle zu machen und eine Schneeballschlacht anzufangen.");
  AddDetail( ({"schneeball", "schneebaelle"}),
	     "Nur zu, mach ruhig ;)");
  AddDetail( ({"schlacht", "schneeballschlacht"}),
	     "Du hast das starke Beduerfnis, jemanden einen Schneeball ins "
	    +"Gesicht zu werfen.");
  AddDetail( "gesicht",
             "Muss nichtmal ein besonders haessliches sein.");
  AddDetail( ({"lust", "beduerfnis"}),
	     "Na los, such Dir ein Opfer! :)");
  AddDetail( "opfer",
	     "Egal wer!");
  AddDetail( "boden",
	     "Der Boden ist mit einer Schneeschicht bedeckt.");
  AddDetail( ({"schnee", "schneeschicht"}),
	     "Am Boden ist eine griffige Schneeschicht, auf der man nicht so "
	    +"leicht ausrutscht, wie auf Eis.");
  AddDetail( "eis",
	     "Hier besteht so ziemlich alles aus Eis.");
  AddDetail( "himmel",
             "Ueber Dir ist ein strahlend blauer Himmel.");
  AddDetail( "sonne",
             "Wenn die Sonne nicht scheinen wuerde, waere es wahrscheinlich "
            +"noch um vieles kaelter.");
  AddDetail( "treiben",
	     "Vielleicht solltest Du mal lauschen?");
  AddDetail( ({"platz", "hauptplatz"}),
	     "Der Hauptplatz liegt weiter westlich von Dir.");

  AddSound( DEFAULT_SOUND,
    "Weiter westlich, in der Dorfmitte, hoerst Du reges Treiben.");
  AddSound( "treiben",
    "Es ist noch etwas weiter weg, aber Du hoerst es deutlich.");

  AddCmd( ({"mache", "mach", "bastel", "bastle"}), "schneeball");

  AddExit( "westen", DORF("hstrasse13"));
  AddExit( "osten", DORF("hstrasse15"));
  
  snowball=([]);
}

reset()
{
  ::reset();
  snowball=([]);
}

schneeball( str )
{
//  object who;
//  who=TP;
  notify_fail(BS("Was willst Du machen?\n"));
  if( str!="schneeball" && str!="ball" )
    return 0;
  if (!member(snowball, getuid(TP)))
    snowball[getuid(TP)] = 3+random(3);
  if ( snowball[getuid(TP)] )
    {
    snowball[getuid(TP)]--;
    write(BS("Du nimmst ein Haeufchen Schnee in die Hand und formst daraus "
	    +"einen grossen, runden Schneeball.\n"));
    say(BS(CAP_TPN+" nimmt etwas Schnee in die Hand und formt daraus einen "
	    +"Schneeball.\n"));
    clone_object(OBJ("schneeball"))->move(TP, M_NOCHECK);
    return 1;
    }
  else
    {
    write(BS("Deine Haende sind noch furchtbar kalt von den vielen "
	    +"Schneebaellen. Du willst nicht schon wieder in den kalten "
	    +"Schnee hineingreifen.\n"));
    return 1;
    }
}

