#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hauptstrasse" );
  SetProp( P_INT_LONG,
     "Du gehst die Hauptstrasse quer durch Yiqanuc entlang. Links und rechts "
    +"von Dir siehst Du immer noch zahlreiche Iglus stehen. Der Boden unter "
    +"Deinen Fuessen besteht aus blankem Eis, welches ebengeschliffen "
    +"wurde. Man sollte meinen, dass es aeusserst glatt und rutschig ist, "
    +"aber durch die vielen kleinen Unregelmaessigkeiten, in denen sich "
    +"der Schnee eingenistet hat, ist der Boden aeusserst griffig. Du kannst "
    +"unzaehlige Spuren von grossen, bepelzten Fuessen erkennen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -10]) );

  AddDetail( ({"hauptstrasse", "strasse"}),
	     "Die Hauptstrasse fuehrt von Sueden nach Norden quer durch "
            +"Yiqanuc.");
  AddDetail( "yiqanuc",
	     "Da bist Du gerade. Hier wohnen die Xandim.");
  AddDetail( "xandim",
	     "Du bist gerade in deren Heimatdorf.");
  AddDetail( ({"dorf", "heimatdorf"}),
	     "Sieh Dich doch einfach etwas genauer um.");
  AddDetail( ({"iglus", "iglu"}),
	     "Links und rechts von Dir erheben sich zahlreiche Iglus.");
  AddDetail( "fuesse",
	     "Dir ist etwas kalt in Deinen Fuessen.");
  AddDetail( ({"unregelmaessigkeit", "unregelmaessigkeiten"}),
	     "Die Strasse hat ueber die Jahre hinweg doch schon viel "
            +"miterlebt und ist jetzt von vielen duennen Ritzen und Kerben "
            +"ueberzogen.");
  AddDetail( ({"ritzen", "kerben"}),
	     "In den Ritzen und Kerben des eisigen Bodens hat sich etwas "
            +"Schnee eingenistet, der die Strasse rauh und griffig macht.");
  AddDetail( "schnee",
	     "Da es hier ja haeufig schneit, liegt auch ueberall etwas Schnee "
            +"herum.");
  AddDetail( ({"spur", "spuren"}),
	     "Die Spuren stammen von grossen, stark bepelzten Fuessen, wie "
	    +"sie die Xandim haben.");
  AddDetail( ({"wohnviertel", "viertel"}),
	     "Hier bist Du wohl gerade.");
  AddDetail( "eis",
	     "Es scheint hier bauwerksmaessig alles aus Eis gemacht worden "
            +"zu sein.");
  AddDetail( "himmel",
	     "Ueber Dir strahlt ein wunderbar blauer Himmel.");
  AddDetail( "sonne",
	     "Ohne den Sonnenschein waere es hier vermutlich noch viel viel "
            +"kaelter.");
  AddDetail( "boden",
	     "Der Boden besteht aus blankem Eis und ist mit ein wenig Schnee "
            +"bedeckt.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein reges Treiben aus dem Norden.");
  AddSound("treiben",
    "Im Norden scheint etwas mehr los zu sein als hier.");
    
  AddExit( "norden", DORF("hstrasse4"));
  AddExit( "sueden", DORF("hstrasse2"));
}
