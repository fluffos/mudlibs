#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Hauptplatz" );
  SetProp( P_INT_LONG,
    "Du stehst am oestlichen Ende des Hauptplatzes von Yiqanuc. Ueberall "
   +"herrscht reges Treiben und wo Du nur hinblickst, siehst Du froehliche "
   +"Xandim. Im Norden kannst Du die kleine Kapelle der Xandim betreten, "
   +"einen Ort der Ruhe und des Friedens. Suedlich von Dir ist der "
   +"beliebteste Treffpunkt aller Xandim, die Kneipe \"Zum erfrorenen "
   +"Pinguin\". Ein angenehmer Bratenduft stroemt aus der Kneipe heraus. "
   +"Dir laeuft bereits das Wasser im Mund zusammen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -5]) );

  AddDetail( "ende",
	     "Du stehst am oestlichen Ende vom Hauptplatz.");
  AddDetail( ({"hauptplatz", "platz"}),
	     "Ueberall am Hauptplatz herrscht reges Treiben. Es macht Spass, "
	    +"einfach eine Weile den geschaeftigen Xandim zuzusehen.");
  AddDetail( "treiben",
	     "Die Xandim gehen ihren verschiedenen Geschaeften nach.");
  AddDetail( ({"geschaeft", "geschaefte"}),
	     "Die Xandim erledigen ihre taeglichen Geschaefte.");
  AddDetail( "spass",
	     "Es ist recht interressant, eine Weile in die Masse zu starren "
	    +"und das geschaeftige Treiben zu beobachten.");
  AddDetail( "weile",
	     "Du stehst einfach da und laesst die Atmosphaere auf Dich "
	    +"wirken.");
  AddDetail( "atmosphaere",
	     "Die Atmosphaere hier ist freundlich und einladend. Du kannst "
	    +"keine Spur von Feindseligkeit erkennen.");
  AddDetail( ({"spur", "feindseligkeit", "seligkeit"}),
	     "Nicht die geringste Spur von Feindseligkeit ist zu spueren.");
  AddDetail( "masse",
	     "Ueberall tummeln sich geschaeftige Xandim.");
  AddDetail( "xandim",
	     "Die Bewohner dieses Dorfes scheinen sehr freundlich zu sein.");
  AddDetail( "bewohner",
	     "Die Bewohner des Dorfes sind die Xandim. Das solltest Du "
	     +"mittlerweile eigentlich schon wissen.");
  AddDetail( ({"dorf", "Yiqanuc"}),
	     "Du bist im Dorf Yiqanuc.");
  AddDetail( "kapelle",
	     "Noerdlich von Dir ist die kleine Kapelle der Xandim.");
  AddDetail( "ort",
	     "Die Kapelle ist ein Ort der Ruhe und des Friedens.");
  AddDetail( ({"ruhe", "frieden"}),
	     "Wenn Du einige Zeit allein sein willst und ein wenig "
	    +"nachdenken moechtest, ist die Kapelle der richtige Ort fuer "
	    +"Dich. Sie strahlt eine beruhigende, angenehme Atmosphaere aus.");
  AddDetail( "zeit",
	     "Jeder tapfere Abenteurer braucht mal ein wenig Zeit fuer sich "
	    +"selbst.");
  AddDetail( "abenteurer",
	     "Du blickst etwas zweifelnd an Dir hinab.");
  AddDetail( ({"treffpunkt", "punkt"}),
	     "Suedlich von Dir ist die Kneipe \"Zum erfrorenen Pinguin\", "
	    +"der beliebteste Treffpunkt in ganz Yiqanuc.");
  AddDetail( "kneipe",
	     "Wirf doch einfach mal einen Blick hinein.");
  AddDetail( "blick",
	     "Nun sei nicht so neugierig, geh einfach rein in die Kneipe.");
  AddDetail( ({"pinguin", "pinguine"}),
	     "Du hast gar nicht gewusst, dass Pinguine erfrieren koennen.");
  AddDetail( ({"duft", "bratenduft"}),
	     "Rieche doch einfach mal.");
  AddDetail( "wasser",
	     "Dir laeuft das Wasser im Munde zusammen bei einem solch "
	    +"koestlichen Duft.");
  AddDetail( ({"mund", "munde"}),
	     "*sabber*");
  AddDetail( "himmel",
	     "Der Himmel ueber Dir ist strahlend blau.");
  AddDetail( "sonne",
	     "Wenn die Sonne nicht scheinen wuerde, waere es vermutlich noch "
	    +"um einiges kaelter.");
  AddDetail( "boden",
	     "Der Boden besteht aus Eis und festgestampften Schnee.");
  AddDetail( "eis",
	     "Hier ist so ziemlich alles aus Eis.");
  AddDetail( "schnee",
	     "Am Boden liegt ziemlich viel Schnee herum.");

  AddSound( DEFAULT_SOUND,
    "Du lauscht dem froehlichen Treiben der Xandim.");
  AddSound( "treiben",
    "Du hoerst das geschaeftige Treiben der Xandim.");
    
  AddSmell( DEFAULT_SMELL,
    "Ein leckerer Bratenduft stroemt aus der Kneipe.");
  AddSmell( ({"duft", "bratenduft"}),
    "Dir laeuft das Wasser im Munde zusammen.");

  AddExit( "norden", DORF("kapelle"));
  AddExit( "sueden", DORF("kneipe"));
  AddExit( "osten", DORF("hstrasse13"));
  AddExit( "westen", DORF("hauptplatz5"));
  AddExit( "nordwesten", DORF("hauptplatz3"));
  AddExit( "suedwesten", DORF("hauptplatz1"));
}
