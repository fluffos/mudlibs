#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Westtor des Xandimdorfes" );
  SetProp( P_INT_LONG,
    "Du stehst vor einem gewaltigen Torbogen, der vollstaendig aus Eis "
   +"gemeisselt ist. Es ist das westliche Tor des Xandimdorfes Yiqanuc. "
   +"Links und rechts von dem Torbogen fuehren zwei hohe "
   +"Eispalisaden weg, welche gute fuenf Meter hoch sind. Von jenseits des "
   +"Torbogens hoerst Du geschaeftiges Treiben und froehliche Stimmen. An "
   +"beiden Seiten neben dem Torbogen siehst Du zwei runde, ausgetretene "
   +"Stellen im Schnee. Dies scheint wohl der Posten zweier Waechter zu "
   +"sein, die das Dorf vor unliebsamen Eindringlingen beschuetzen. Gleich "
   +"rechts von Dir steht ausserdem noch ein kleiner Schneemann, der ein "
   +"Schild in die Hoehe haelt. Richtung Westen erstreckt sich eine flache, "
   +"karge Schneelandschaft, mitten auf dem Weg steht allerdings ein "
   +"Warnschild.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -10]) );

  AddDetail( ({"tor", "westtor"}),
	     "Du stehst vor dem gewaltigen Westtor des Xandimdorfes "
            +"Yiqanuc.");
  AddDetail( ({"bogen", "torbogen"}),
	     "Der Torbogen ist vollstaendig aus einem riesigen Eisbrocken "
            +"herausgemeisselt. Er hat keinerlei Verzierungen, er ist nur "
            +"vollstaendig glatt und blank und die Kanten sind scharf ohne "
            +"jeglichem Makel.");
  AddDetail( ({"eisbrocken", "brocken"}),
	     "Der Torbogen wurde aus einem einzigen, riesigen Eisbrocken "
            +"herausgemeisselt. Es ist Dir ein Raetsel, wie man soetwas hier "
            +"her transportieren konnte.");
  AddDetail( "raetsel",
             "Hoer auf zu gruebeln, Du hast besseres zu tun.");
  AddDetail( ({"verzierungen", "verzierung"}),
	     "Du siehst keine Verzierungen an dem Torbogen.");
  AddDetail( ({"kanten", "kante"}),
	     "An den Kanten sind keine Macken oder Unregelmaessigkeiten zu "
            +"sehen.");
  AddDetail( ({"unregelmaessigkeit", "unregelmaessigkeiten", "macken"}),
	     "Nichts zu sehen.");
  AddDetail( "makel",
	     "Der ganze Torbogen ist makellos glatt und blank.");
  AddDetail( "eis",
	     "Der Torbogen und die Palisaden sind aus dem Eis "
	    +"herausgemeisselt.");
  AddDetail( ({"palisade", "palisaden", "eispalisaden"}),
	     "Links und rechts vom Torbogen fuehren hohe Eispalisaden weg. "
            +"Sie fuehren wohl um das ganze Dorf herum, um es von "
            +"Eindringlingen zu beschuetzen.");
  AddDetail( "hoehe",
	     "Die Eispalisaden sind etwa fuenf Meter hoch.");
  AddDetail( "eindringlinge",
	     "Das Dorf wird manchmal von Ausgestossenen und auch fremden "
            +"Voelkern, die am fernen Hafen landen, angegriffen. Ausserdem "
            +"straeunen eine Vielzahl gefaehrlicher Tiere hier herum.");
  AddDetail( "ausgestossene",
	     "Der Buergermeister weiss bestimmt mehr ueber sie.");
  AddDetail( ({"buergermeister", "meister"}),
	     "Der wohnt wohl irgendwo im Dorf.");
  AddDetail( ({"dorf", "xandimdorf", "yiqanuc"}),
	     "Das Xandimdorf liegt hinter dem Torbogen.");
  AddDetail( ({"volk", "voelker"}),
	     "Manchmal landen fremde Voelker im Hafen von Smoersky, die bis "
            +"hier her vordringen und das Dorf ueberfallen.");
  AddDetail( ({"hafen", "smoersky"}),
	     "Smoersky ist ziemlich weit weg von hier.");
  AddDetail( ({"vielzahl", "tiere", "tier"}),
	     "Hier streunen viele gefaehrliche Tiere herum.");
  AddDetail( ({"treiben", "stimmen", "geraeusche"}),
	     "Viele verschiedene Geraeusche dringen von jenseits des "
	     +"Torbogens an Dich heran.");
  AddDetail( ({"seiten","seite", "schnee"}),
	     "Links und rechts vor dem Torbogen sind zwei ausgetretene "
            +"Stellen im Schnee.");
  AddDetail( ({"stellen", "stelle"}),
             "Dies hier ist wohl der Posten zweier Waechter, die das Dorf "
	    +"vor Eindringlingen schuetzen.");
  AddDetail( ({"posten", "waechter"}),
	     "Hier versehen immer zwei Waechter ihren Dienst.");
  AddDetail( "dienst",
	     "Du wuerdest es als nicht allzu angenehm empfinden, hier "
            +"stundenlang in der Kaelte herumzustehen.");
  AddDetail( "kaelte",
	     "Dir war zwar schon einmal wesentlich kaelter, aber Dich "
            +"froestelt immer noch.");
  AddDetail( ({"landschaft", "schneelandschaft"}),
	     "Westlich von Dir erstreckt sich eine flache, karge "
	    +"Schneelandschaft. Soweit Du nur siehst, Du erblickst nur "
            +"weiss.");
  AddDetail( "himmel",
	     "Ueber Dir ist ein strahlend blauer Himmel.");
  AddDetail( "sonne",
	     "Ohne die Sonne waere es hier vermutlich noch viel, viel "
	    +"kaelter.");
  AddDetail( "boden",
	     "Der Boden besteht aus blankem Eis und ist mit ein wenig Schnee "
            +"bedeckt.");
  AddDetail( "schnee",
	     "Am Boden liegt ein wenig Schnee.");
  AddDetail( ({"schneemann", "mann", "schild"}),
    "\n"
    "     ||::|:||   .--------,                   \n" 
    "     |:||:|:|   |_______ /        .-.        \n"    
    "     ||::|:|| .\"`  ___  `\".    {\\('v')/}     \n"    
    "     \\\\\\/\\///:  .'`   `'.  ;____`(   )'____  \n"      
    "      \\====/ './  o   o  \\|~     ^\" \"^   //  \n"     
    "       \\\\//   |   ())) .  |  Willkommen   \\  \n"     
    "        ||     \\ `.__.'  /|      in      //  \n"     
    "        ||   _{``-.___.-'\\|    YIQANUC    \\  \n"     
    "        || _.\" `-.____.-'`|    ___       //  \n"     
    "        ||`        __ \\   |___/   \\_______\\  \n"     
    "      .\"||        (__) \\    \|     /         \n"
    "      /   `\\/      __   vvvvv'\___/          \n"
    "      |     |     (__)       |             \n"  
    "       \\___/\\                /               \n"   
    "        ||  |     .___.     |                \n"     
    "        ||  |       |       |                \n"    
    "        ||.-'       |       '-.              \n"  
    "        ||          |          )             \n"  
    "        ||----------'---------'           \n"
    "\n");

  AddDetail( "warnschild",
      "Solche Schilder sind meist sehr wichtig, vielleicht solltest Du es "
      "lesen.");
  AddDetail( "weg",
      "Der Weg scheint zur Zeit noch gesperrt zu sein.");
  AddDetail( "zeit",
      "Vielleicht aendert sich das ja irgendwann mal.");
  AddReadDetail( ({"schild", "warnschild"}),
      "\n"
      "       ______________________________     \n"
      "      /                              \\   \n"
      "     |                                |   \n"
      "     |                                |   \n"
      "     |        A C H T U N G !!!       |   \n"
      "     |                                |   \n"
      "     |                                |   \n"
      "     |                                |   \n"
      "     |     Ungesichertes Gelaende,    |   \n"
      "     |                                |   \n"
      "     |       Betreten VERBOTEN!       |   \n"
      "     |                                |   \n"
      "     |                                |   \n"
      "     |                                |   \n"
      "     |           gez. Verwaltung fuer |   \n"
      "     |             Spielersicherheit, |   \n"
      "     |                   Region Polar |   \n"
      "     |                                |   \n"
      "      \\______________________________/   \n"
      "\n");
     
  AddSound( DEFAULT_SOUND,
    "Du hoerst eine Vielzahl von Geraeuschen von jenseits des Torbogens.");
  AddSound( "geraeusche",
    "Du hoerst viele Stimmen und ein geschaeftiges Treiben.");
  AddSound( ({"treiben", "stimmen"}),
    "Die Xandim scheinen ein froehliches Volk zu sein.");

  AddItem( NPC("waechter1"), REFRESH_DESTRUCT);
  AddItem( NPC("waechter1"), REFRESH_DESTRUCT);

  AddExit( "osten", DORF("hstrasse9"));
//  AddExit( "norden", MEER(""));
}
