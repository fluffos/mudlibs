***********************************/

inherit "std/laden";

#include "../xandim.h"
#include <properties.h>
#include <laden.h>

create()
{
  ::create();

  RemoveItem("/obj/entsorg");

  SetProp (P_INT_SHORT, "Auf dem Hauptplatz");
  SetProp (P_INT_LONG, 
    "Du stehst mitten am Hauptplatz von Yiqanuc. "
   +"Neben Dir tummelt sich eine grosse Schar "
   +"Xandimkinder um einen Eskimo-Eisstand, wo hin und wieder ein Kind "
   +"freudig mit einem Eisschlecker davonstuermt. Obwohl es relativ frisch "
   +"hier ist, bekommst Du grossen Appetit auf einen solch leckeren "
   +"Eisschlecker.");
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:-5]));

  SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp (P_SHOPKEEPER_ID, "eskimo");
  SetProp (P_SHOPKEEPER_NAME, "der Eskimo-Eisverkaeufer");
  SetProp (P_SHOPKEEPER_GENDER, MALE);
  
  AddDetail( ({"platz", "hauptplatz"}),
	     "Du stehst hier direkt in der Mitte des Hauptplatzes von "
	    +"Yiqanuc.");
  AddDetail( "yiqanuc",
	     "Da bist Du gerade.");
  AddDetail( "mitte",
	     "Dies hier ist die Mitte des Hauptplatzes.");
  AddDetail( "schar",
	     "Viele Xandimkinder scharen sich neben Dir um einen Eskimo-"
	    +"Eisstand.");
  AddDetail( ({"xandimkinder", "kinder"}),
	     "Die Kinder scharen sich gierig um einen Eskimo-Eisstand. "
	    +"Irgendwie bekommst Du auch etwas Appetit auf ein wenig "
	    +"Eiscreme.");
  AddDetail( ({"creme", "eiscreme"}),
	     "Die Eiscreme sieht wahrhaftig koestlich aus.");
  AddDetail( "appetit",
	     "Du bekommst maechtig Appetit auf einen leckeren Eisschlecker.");
  AddDetail( "kind",
	     "Immer wieder stuermt ein Kind mit einem aeusserst lecker "
	    +"aussehenden Eisschlecker an Dir vorbei.");
  AddDetail( ({"schlecker", "eisschlecker"}),
	     "Du hast auch schon ein ziemlich grossen Verlangen nach einem "
	    +"solch koestlich aussehenden Eisschlecker.");
  AddDetail( "verlangen",
	     "Du kannst Dich kaum noch zurueckhalten.");
  AddDetail( ({"fahnen", "fahne"}),
	     "Die blau-rot-weissen Fahnen von dem Eisstand flattern leicht im "
	    +"sanften Wind.");
  AddDetail( "wind",
	     "Es weht ein ganz leichter Wind ueber den Hauptplatz.");
  AddDetail( ({"schild", "schildchen", "schilder"}),
	     "Auf den Schildern sind die ganzen Eissorten abgebildet, die es "
	    +"hier zu kaufen gibt.");
  AddDetail( ({"sorte", "eissorte", "sorten", "eissorten","eis"}),
	     "Lies doch einfach einmal die Schilder.");
  AddDetail( "himmel",
	     "Der Himmel ueber Dir ist strahlend blau.");
  AddDetail( "sonne",
	     "Wuerde die Sonne nicht scheinen, waere es vermutlich noch um "
	    +"einiges kaelter.");
  AddDetail( "boden",
	     "Der Boden besteht aus Eis und ist mit einer duennen "
	    +"Schneeschicht bedeckt.");
  AddDetail( ({"schnee", "schneeschicht", "schicht"}),
	     "Am Boden liegt ein wenig Schnee herum.");
  AddSpecialDetail( ({"stand", "eisstand", "eskimo-eisstand", "eskimoeisstand"}), "unt_stand");
  AddReadDetail( ({"schild", "schildchen", "schilder"}),
      "Auf den Schildern steht:\n\n"
      "        Calippo                Jolly\n\n"
      "        Tschisi                Twinni\n");
  
  
  SetStorageRoom(DORF("eisvorrat"));

  AddItem(NPC("eskimo"), REFRESH_DESTRUCT);


  AddExit ("norden", DORF("hauptplatz3"));
  AddExit ("osten", DORF("hauptplatz4"));
  AddExit ("sueden", DORF("hauptplatz1"));
  AddExit ("westen", DORF("hauptplatz2"));
}

string unt_stand()
{
  if(present("eskimo", TO))
    {
    return BS("Mitten am Hauptplatz steht ein grosser, blau-rot-weisser "
	      +"Eskimo-Eisstand. Bunte Fahnen haengen von ihm weg und Du "
	      +"siehst viele Schildchen an dem Stand. Dahinter steht ein "
	      +"kleiner, dicker Eskimo mit einem blau-rot-weissem Eskimo-"
	      +"Kapperl.");
    }
  else
    {
    return BS("Mitten am Hauptplatz steht ein grosser, blau-rot-weisser "
	      +"Eskimo-Eisstand. Bunte Fahnen haengen von ihm weg und Du "
	      +"siehst viele Schildchen an dem Stand. Der Eisverkaeufer "
	      +"scheint allerdings gerade nicht da zu sein ... Du musst "
	      +"wohl noch ein bisschen auf Deinen Eislutscher warten.");
    }
}

sell()
{
  notify_fail("Tut mir leid, hier wird nichts gekauft!\n");
  return 0;
}
force_sell() { return sell(); }
evaluate() { return sell(); }

AddFixedObject()
{
}
