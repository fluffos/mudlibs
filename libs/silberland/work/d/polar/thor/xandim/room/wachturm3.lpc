#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Dach des Wachturms" );
  SetProp( P_INT_LONG, "\t"+BS(
    "Du stehst am Dach des Wachturms von Yiqanuc. Das flache Dach ist "
   +"begrenzt von massiven Stahlzinnen. Du kannst von hier aus weit ueber die "
   +"Landschaft blicken. Im Sueden siehst Du die hohen, schroffen Berge von "
   +"Kymora, im Westen erstreckt sich die ewige Flaeche des Eismeeres und im "
   +"Norden siehst Du sanfte Haenge. Nach Osten hin siehst Du nur eine "
   +"unwirtliche Gegend mit zackigen Felsen und riesigen Eisbrocken. Das sind "
   +"die Auslaeufer der Kymora Berge.")+"@@sschaufel@@");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -10]) );

  AddDetail( ({"dach", "wachturm", "turm"}),
	     "Das Dach des Wachturmes ist der hoechste Platz von Yiqanuc. "
	    +"Von hier hast Du eine hervorragende Aussicht.");
  AddDetail( "platz",
	     "Du stehst am hoechsten Platz von Yiqanuc.");
  AddDetail( ({"yiqanuc", "dorf"}),
	     "Das Dorf erstreckt sich unter Dir.");
  AddDetail( ({"aussicht", "ausblick"}),
	     "Die Aussicht ist wirklich atemberaubend. Die Berge Kymora im "
	    +"Sueden, deren Auslaeufer im Osten, sanfte Haenge im Norden und "
	    +"das grosse Eismeer im Westen.");
  AddDetail( ({"zinnen", "stahlzinnen"}),
	     "Das Dach ist von massiven Stahlzinnen begrenzt. Von hier oben "
	    +"kann man Feinde schon in weiter Ferne ausmachen.");
  AddDetail( "feinde",
	     "Man sieht hier einen Grossteil der naeheren Umgebung und kann "
	    +"daher Feinde schon auf weite Entfernungen hin erkennen.");
  AddDetail( ({"ferne", "entferung", "entfernungen"}),
	     "Der Ausblick reicht in weite Ferne.");
  AddDetail( ({"landschaft", "umgebung", "gegend"}),
	     "Die umliegende Landschaft sieht wahrlich atemberaubend aus.");
  AddDetail( ({"berge", "kymora"}),
	     "Suedlich vom Dorf liegen die Berge von Kymora. Erst ganz wenige "
	    +"haben sie bestiegen, denn die Gegend dort ist unwirtlich und "
	    +"eisig kalt. Viele haben dort schon ihr Leben gelassen.");
  AddDetail( "leben",
	     "In den Bergen von Kymora sind schon viele erfroren, weil sie "
	    +"keine geeignete Ausruestung bei sich hatten.");
  AddDetail( "ausruestung",
	     "Die einzige Chance, eine Ueberquerung der Kymora Berge zu "
	    +"ueberleben, ist, eine hervorragende Ausruestung bei sich zu "
	    +"haben.");
  AddDetail( ({"chance", "ueberquerung"}),
	     "Eine Ueberquerung der Kymora Berge sollte man sich vorher gut "
	    +"ueberlegen.");
  AddDetail( ({"eismeer", "meer"}),
	     "Westlich von Dir erstreckt sich das ewige Eismeer. Es ist eine "
	    +"weite, gefrorene Wasserflaeche, die endlos erscheint.");
  AddDetail( ({"flaeche", "wasserflaeche"}),
	     "Die weite Flaeche des Eismeeres erstreckt sich westlich von "
	    +"Dir.");
  AddDetail( ({"haenge", "hang", "schneehaenge", "schneehang"}),
	     "Noerdlich des Dorfes erstrecken sich sanfte Schneehaenge.");
  AddDetail( "auslaeufer",
	     "Oestlich des Dorfes siehst Du eine unwirtliche Gegend, ueber "
	    +"und ueber mit Felsen und Eisbrocken uebersaeht.");
  AddDetail( ({"felsen", "eisbrocken"}),
	     "Es scheint eine sehr unwegsame, duestere Gegend zu sein. Dir "
	    +"erscheint es, als seien dort einige Geheimnisse verborgen.");
  AddDetail( ({"geheimnis", "geheimnisse"}),
	     "Du kannst Dir nicht erklaeren, was es ist, aber ein seltsames "
	    +"Gefuehl beschleicht Dich, wenn Du Dir diese Gegend naeher "
	    +"ansiehst.");
  AddDetail( "gefuehl",
	     "Du weisst nicht genau, was es ist...");
  AddDetail( "ecke",
	     "In einer Ecke lehnt eine Schneeschaufel.");
  AddDetail( "himmel",
	     "Der Himmel ueber Dir ist strahlend blau.");
  AddDetail( "sonne",
	     "Wenn die Sonne nicht scheinen wuerde, waere es vermutlich "
	    +"noch kaelter, als es ohnehin schon ist.");
  AddDetail( ({"waende", "wand"}),
	     "Hier gibt es keine Waende, sondern nur Stahlzinnen.");
  AddDetail( "boden",
	     "Der Boden ist aus Holz.");
  AddDetail( "holz",
	     "Das Holz wurde wohl aus weit entlegenen Gegenden "
	    +"herangeschafft.");
  AddDetail( "gegenden",
    "Das sind eben Gegenden, die weiter weg liegen, und die Du nicht mitten "
   +"im oder auf dem Wachturm finden wirst.");	    
  AddDetail( ({"treppe", "wendeltreppe"}),
	     "Eine Wendeltreppe fuehrt wieder nach unten.");
  AddSpecialDetail( ({"schaufel", "schneeschaufel"}), "unt_schaufel");

  AddSound( DEFAULT_SOUND,
    "Du hoerst verschiedene Geraeusche von Dorf zu Dir herauf dringen.");
  AddSound( ({"geraeusch", "geraeusche"}),
    "Viele Geraeusche vom Dorf unter Dir dringen herauf.");

  AddCmd( "nimm", "nehmen");

  AddItem( NPC("waechter1"), REFRESH_DESTRUCT);
  AddItem( NPC("waechter1"), REFRESH_DESTRUCT);

  AddExit( "unten", DORF("wachturm2") );
}

int schaufel=1;

reset()
{
  ::reset();
  schaufel=1;
}

string sschaufel()
{
  if(schaufel==1)
    return BS("In einer Ecke des Wachturmes lehnt eine Schneeschaufel.");
  else
    return "";
}


string unt_schaufel()
{
  if(schaufel==1)
    return BS("Eine stinknormale Schneeschaufel zum Schneeschaufeln.\n");
  else
    return 0;
}

nehmen( str )
{
  object ob;
  
  if(!schaufel)
    return 0;

  if(str=="schaufel"||str=="schneeschaufel") 
    {
    if(schaufel==1)
      {
      write(BS("Du nimmst die Schneeschaufel.\n"));
      say(BS(CAP_TPN+" nimmt eine Schneeschaufel.\n"));
      ob=clone_object(OBJ("schneeschaufel"));
     
      if(ob->move(TP, M_GET) != 1) {
        write(BS("Leider kannst Du die Schneeschaufel nicht mehr tragen, "
              "daher legst Du sie auf den Boden."));
        ob->move(environment(TP), M_NOCHECK);
      }
      schaufel=0;
      return 1;
      }
    else
      {
      write(BS("Hier ist keine Schneeschaufel, die Du nehmen koenntest.\n"));
      return 1;
      }
    }
  else
    return 0;
}
