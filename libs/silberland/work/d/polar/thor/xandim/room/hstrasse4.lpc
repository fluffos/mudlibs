#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hauptstrasse" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Hauptstrasse des Xandimdorfes Yiqanuc, die von Sueden "
   +"nach Norden fuehrt. Ein Stueckchen weiter noerdlich hoerst Du lautes, "
   +"froehliches Treiben, denn gleich vor Dir liegt der Hauptplatz des "
   +"Dorfes. Ausserdem erkennst Du links und rechts von Dir, auch ein "
   +"bisschen weiter noerdlich zwei groessere Gebaeude. Am Boden fallen Dir "
   +"einige seltsame Ritzen auf.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -10]) );

  AddDetail( ({"strasse", "hauptstrasse"}),
	     "Die Hauptstrasse fuehrt von Sueden nach Norden quer durch "
	    +"das Dorf.");
  AddDetail( ({"dorf", "xandimdorf", "yiqanuc"}),
	     "Du bist gerade in dem Dorf der Xandim, Yiqanuc.");
  AddDetail( "xandim",
	     "Die Xandim sind die Einwohner dieses Dorfes.");
  AddDetail( "einwohner",
	     "Einwohner wohnen gewoehnlich in ihren Doerfern ;)");
  AddDetail( "treiben",
	     "Ein bisschen weiter noerdlich scheint etwas mehr los zu sein "
	    +"als hier.");
  AddDetail( ({"platz", "hauptplatz"}),
	     "Gleich noerdlich von Dir ist der Hauptplatz des Dorfes.");
  AddDetail( "gebaeude",
	     "Nordwestlich und Nordoestlich kannst Du zwei groessere "
	    +"Gebaeude erkennen.");
  AddDetail( "himmel",
	     "Ueber Dir ist ein strahlend blauer Himmel.");
  AddDetail( "sonne",
	     "Ohne die Sonne waere es hier vermutlich noch viel, viel "
	    +"kaelter."); 
  AddDetail( "boden",
	     "Der Boden besteht aus blankem Eis und ist mit ein wenig Schnee "
            +"bedeckt. Unter dem Schnee scheinen jedoch einige Ritzen verborgen "
            +"zu sein");
  AddDetail( ({"ritzen", "ritze"}),
             "Du verspuerst den unwiderstehlichen Drang, in den Ritzen herumfummeln "
            +"zu muessen.");
  AddDetail( "drang",
             "Du kaempfst dagegen an, weisst aus Erfahrungswerten allerdings schon, "
            +"das Du keine Chance hast ...");
  AddDetail( ({"erfahrungswerte","erfahrungswert"}),
             "Du konntest schon genuegend sammeln.");
  AddDetail( "chance",
             "Nicht die geringste ..."); 
  AddDetail( "eis",
             "Das ist der Hauptbestandteil des Bodens.");
  AddDetail( ({"bestandteil", "hauptbestandteil"}),
             "Der Boden besteht aus Eis und Schnee.");
  AddDetail( "schnee",
	     "Am Boden liegt ein wenig Schnee.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst reges Treiben von dem Hauptplatz her.");
  AddSound( "treiben",
    "Du hoerst froehliche Stimmen und Unterhaltungen.");
  AddSound( ({"stimmen", "unterhaltungen"}),
    "Die Leute klingen aeusserst gutgelaunt.");

  AddCmd( ({"fummel","fummle"}), "fummeln");
    
  AddExit( "norden", DORF("hauptplatz1"));
  AddExit( "sueden", DORF("hstrasse3"));
}

fummeln( str )
{
  notify_fail(BS("Wo willst Du herumfummeln?\n"));
  if(member( ({"in ritze","in ritze herum","ritze","ritzen"}), str) == -1) {
    return 0;
  }
  else {
    write(BS("In dem Augenblick, in dem Du die Ritze beruehrst, oeffnet sich "
             "direkt unter Dir eine Falltuer, und wie Falltueren das so an "
             "sich haben, faellst Du natuerlich prompt durch ... und faellst "
             "und faellst und faellst ... Unverhofft findest Du jedoch an einem "
             "kleinen Eisvorsprung Halt."));
    say(BS(CAP_TPN+" beruehrt den Boden, welcher sich ploetzlich unter "+TPP(WEM)
            +" oeffnet, und verschwindet in selbigem. Verdutzt bleibst Du stehen."));
    TP->move(DORF("underhstrasse4"), M_GO);
    return 1;
  }
}
