***********************************/

#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int i=1;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hauptstrasse" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Hauptstrasse des Xandimdorfes Yiqanuc, die von Sueden "
    "nach Norden fuehrt. Richtung Sueden fuehrt die Strasse zum Hauptplatz "
    "in der Mitte des Dorfes. Nach Suedwesten und Suedosten zweigen zwei "
    "Wege ab, die die Palisade entlang rund um das Dorf fuehren. Direkt vor "
    "Dir im Norden ist ein riesiges, fest verriegeltes Tor, vor dem ein "
    "grosser Schneehaufen liegt.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -10]) );

  AddDetail( ({"strasse", "hauptstrasse"}),
	     "Die Hauptstrasse fuehrt von Sueden nach Norden quer durch "
	    +"das Dorf.");
  AddDetail( ({"dorf", "xandimdorf", "yiqanuc"}),
	     "Du bist gerade in dem Dorf der Xandim, Yiqanuc.");
  AddDetail( "xandim",
	     "Die Xandim sind die Einwohner dieses Dorfes.");
  AddDetail( "einwohner",
	     "Einwohner wohnen gewoehnlich in ihren Doerfern ;)");
  AddDetail( ({"platz", "hauptplatz"}),
	     "Weiter suedlich von Dir ist der Hauptplatz des Dorfes.");
  AddDetail( "tor",
       "Das grosse Tor noerdlich von Dir ist fest verschlossen. Hier kommst "
       "Du (zumindest noch) nicht weiter.");
  AddDetail( ({"wachweg", "weg", "wege"}),
       "Der Wachweg fuehrt Richtung Nordwesten und Suedwesten rund um "
       "das Dorf herum.");
  AddDetail( ({"eispalisade", "palisade"}),
       "Yiqanuc ist von einer schuetzenden Eispalisade umgeben.");
  AddDetail( "himmel",
	     "Ueber Dir ist ein strahlend blauer Himmel.");
  AddDetail( "sonne",
	     "Ohne die Sonne waere es hier vermutlich noch viel, viel "
	    +"kaelter."); 
  AddDetail( "boden",
	     "Der Boden besteht aus blankem Eis und ist mit ein wenig Schnee "
            +"bedeckt.");
  AddDetail( ({"eis", "eisschicht", "schicht"}),
       "Unter dem verschneiten Boden ist eine harte Eisschicht.");
  AddDetail( "schnee",
	     "Am Boden liegt ein wenig Schnee.");
  AddDetail( ({"schneehaufen", "haufen"}),
      "Er besteht zu hundert Prozent aus Schnee und scheint schon laenger "
      "hier zu sein, denn der Schnee ist nicht mehr locker-flockig, sondern "
      "schon zu einer harten, zusammengedrueckten Masse erstarrt.");
  AddDetail( ({"masse", "schneemasse"}),
      "Der Schnee ist zu einer harten, eisigen Masse erstarrt.");
  AddSound( DEFAULT_SOUND,
    "Du hoerst leise den Wind durch die Strassen pfeifen.");
  AddSound( "wind",
    "Leise wispert er Dir ins Ohr.");
   
  AddCmd( ({"locker", "lockere", "lockre"}), "schnee");
  AddCmd( ({"grabe", "grab"}), "dig");
  
  AddExit( "suedwesten", DORF("wachweg12"));
  AddExit( "suedosten", DORF("wachweg16"));
  AddExit( "sueden", DORF("hstrasse7"));
}

reset()
{
  i=1;
  ::reset();
}

schnee( str )
{
  notify_fail("Was willst Du lockern?\n");
  if( str == "schnee" || str == "schneehaufen" || str == "haufen" ) {
    write(BS("Hm, das ist wohl nicht ganz das richtige. Versuchs mal mit "
          "was anderem."));
    say(BS(CAP_TPN+" macht sich an dem Schneehaufen zu schaffen."));
    return 1;
  }
  else
    return 0;
}

dig( str )
{ 
  notify_fail("Wo willst Du denn graben?\n");

  if(member( ({"in schnee", "in haufen", "in schneehaufen", "schnee", 
               "haufen", "schneehaufen"}), str) == -1)
    return 0;

  else if (!present("schneeschaufel", TP)) {
    write(BS("Du buddelst mit Deinen Haenden im Schnee rum, "
          "bis Dir Deine Finger fast abfrieren. Weit bist Du aber nicht "
          "gekommen, da der Schnee schon viel zu festgefroren ist, um "
          "mit den Haenden darin herumzugraben."));
    say(BS(CAP_TPN+" buddelt mit den blossen Haenden in dem Schneehaufen "
          "rum, bis diese ganz blau sind vor Kaelte. Resignierend wendet sich "
          +TPN+" wieder ab."));
    return 1;
  }
  
  else if(i){
    write(BS("Du zueckst Deine Schneeschaufel und faengst wie ein Wahnsinniger "
          "an, den Schneehaufen zu durchgraben. Nach einer Weile findest Du "
          "doch tatsaechlich einen alten Pinsel, den Du geschwind in Deinen "
          "Taschen verschwinden laesst."));
    say(BS(CAP_TPN+" durchgraebt wie ein Wahnsinniger den Schneehaufen. Ob "
          +TPP(WER)+" wohl etwas gefunden hat?"));

    if(clone_object(OBJ("pinsel"))->move(TP, M_GET) == ME_TOO_HEAVY)
      write(BS("Ups, Du kannst den Pinsel nicht mehr tragen!"));
    i=0;
    return 1;
  }
  else {
    write(BS("Du zueckst Deine Schneeschaufel und faengst wie ein Wahnsinniger "
          "an, den Schneehaufen zu durchgraben. Als Du nach einer Weile jedoch "
          "immer noch nichts gefunden hast, gibst Du enttaeuscht auf. "
          "Vielleicht solltest Du es spaeter noch einmal versuchen."));
    say(BS(CAP_TPN+" durchgraebt wie ein Wahnsinniger den Schneehaufen. Ob "
          +TPP(WER)+" wohl etwas gefunden hat?"));
    return 1;
  }
}
