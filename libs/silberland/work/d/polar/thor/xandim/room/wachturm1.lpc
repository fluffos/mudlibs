*******************************/

#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Wachturm" );
  SetProp( P_INT_LONG,
    "Der Wachturm ist das einzige Gebaeude von Yiqanuc, das nicht aus Eis, "
   +"sondern aus Holz besteht. Du stehst hier im Erdgeschoss des Wachturms, "
   +"im Bereitschaftsraum. Die Einrichtung ist eher karg, Du siehst nur einen "
   +"grossen Tisch mit sechs Sesseln in der Mitte des Raumes. An der Ost- und "
   +"Suedwand sind einige Haken angebracht, auf denen Waffen und Ruestungen "
   +"haengen. An der Nordwand fuehrt eine hoelzerne Treppe hinauf in den "
   +"ersten Stock des Wachturms. Im Boden siehst Du gleich rechts neben Dir "
   +"eine Falltuer.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE: 10]) );

  AddDetail( ({"turm", "wachturm", "gebaeude"}),
	     "Der Wachturm ist das hoechste Gebaeude in Yiqanuc und das "
	    +"einzige, das aus Holz gebaut ist.");
  AddDetail( "yiqanuc",
	     "Da bist Du gerade.");
  AddDetail( "holz",
	     "Der Wachturm ist nicht, wie alles andere hier, aus Eis sondern "
	    +"aus Holz.");
  AddDetail( "eis",
	     "Der Wachturm ist das einzige Gebaeude, das nicht aus Eis "
	    +"gemacht ist.");
  AddDetail( ({"geschoss", "erdgeschoss"}),
	     "Dies hier ist das Erdgeschoss des Wachturmes, welches als "
	    +"Bereitschaftsraum dient.");
  AddDetail( ({"raum", "bereitschaftsraum"}),
	     "Hier versehen einige der Xandimwaechter ihren Dienst.");
  AddDetail( "dienst",
	     "Die Xandimwaechter versehen hier ihren Bereitschaftsdienst, "
	    +"falls das Dorf angegriffen wird und sie rasch eingreifen "
	    +"muessen.");
  AddDetail( "dorf",
	     "Auch ein nicht allzugrosses Dorf wie Yiqanuc muss beschuetzt "
	    +"werden.");
  AddDetail( ({"waechter", "xandimwaechter"}),
	     "Die Xandimwaechter sind hervorragend ausgebildete Krieger.");
  AddDetail( ({"krieger", "kampf"}),
	     "Die Xandimwaechter sind perfekt fuer den Kampf ausgebildet.");
  AddDetail( "einrichtung",
	     "Die Einrichtung ist sehr karg, sie besteht eigentlich nur aus "
	    +"einem grossen Tisch und sechs Sesseln.");
  AddDetail( ({"tisch", "mitte"}),
	     "In der Mitte des Raumes steht ein grosser Tisch. Rundherum "
	    +"stehen sechs Sessel.");
  AddDetail( "sessel",
	     "Sechs Sessel stehen um den Tisch herum.");
  AddDetail( ({"wand", "waende"}),
	     "Welche Wand moechtest Du denn untersuchen?");
  AddDetail( "nordwand",
	     "An der Nordwand fuehrt eine breite Holztreppe in den ersten "
	    +"Stock des Wachturmes.");
  AddDetail( ({"westwand", "ausgang"}),
             "An der Westwand befindet sich der Ausgang aus dem Wachturm.");
  AddDetail( ({"treppe", "holztreppe"}),
	     "Die Treppe ist schon sehr ausgetreten und wenn man "
	    +"daraufsteigt, knarrt sie bestimmt.");
  AddDetail( "stock",
	     "Wenn Du schon so neugierig bist, was im ersten Stock ist, dann "
	    +"sieh doch einfach mal nach.");
  AddDetail( "ostwand",
	     "An der Ostwand sind viele Haken und Halterungen angebracht, an "
	    +"denen zahlreiche Waffen haengen.");
  AddDetail( ({"haken", "halterung", "halterungen"}),
	     "An einigen Haken und Halterungen haengen unzaehlige Waffen und "
	    +"Ruestungen. Du wirst ein wenig neidisch.");
  AddDetail( ({"waffen", "waffe", "ruestungen", "ruestung", "panzer"}),
	     "Die Waffen und Ruestungen sind in einem hervorragenden Zustand, "
	    +"sofern Du das beurteilen kannst.");
  AddDetail( "zustand",
	     "Der Zustand der Waffen und Ruestungen ist wirklich "
	    +"hervorragend.");
  AddDetail( "suedwand",
	     "An der Suedwand haengen einige Panzer an den Haken, die "
	     "an der Wand angebracht sind.");
  AddDetail( "boden",
	     "Der Boden besteht aus massiven Holzplanken. Gleich rechts neben "
	    +"Dir ist eine Falltuere eingelassen.");
  AddDetail( ({"planke","planken","holzplanke","holzplanken"}),
             "Der ganze Boden besteht aus massiven Holzplanken.");
  AddDetail( ({"tuere", "tuer", "falltuer", "falltuere"}),
	     "Der Falltuere ist mit einem schweren Vorhaengeschloss "
	    +"versperrt.");
  AddDetail( ({"schloss", "vorhaengeschloss"}),
	     "Das Vorhaengeschloss wirkt aeusserst stabil. Du wirst es wohl "
	    +"nicht einfach knacken koennen.");
  AddDetail( "decke",
	     "Die Decke ueber Dir ist aus Holz.");

  AddItem( NPC("waechter1"), REFRESH_DESTRUCT, ([P_XANDIM_KEYGUARD:1]));

  NewDoor("unten", DORF("kerker"),
	  ({"falltuer", "tuer", "tuere", "falltuere" }), 
	  ({
             D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY | DOOR_CLOSED,
             D_LONG, "Die Falltuer fuehrt offenbar nach unten.",
             D_GENDER, FEMALE,
             D_SHORT, "Eine %se Falltuer.",
             D_NAME, "Falltuer",
	  }) );

  AddExit( "westen", DORF("wachweg10"));
  AddExit( "oben", DORF("wachturm2"));
}




