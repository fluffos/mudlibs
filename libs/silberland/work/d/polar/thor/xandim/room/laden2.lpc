inherit "/std/laden";

#include "../xandim.h"
#include <properties.h>
#include <moving.h>
#include <laden.h>

int bottle;

create() {

  ::create();

SetProp(P_INT_SHORT, "Ein Laden mit Polarausruestung");
SetProp(P_INT_LONG, "\t"+BS(
    "Das Iglu macht von Innen einen noch seltsameren Eindruck als von aussen. "
   +"Die Waende sind voellig vereist und spiegelglatt und von der Decke "
   +"haengen unzaehlige Eiszapfen herab, in allen nur erdenklichen Groessen "
   +"und Formen. Einer ist sogar so lange, dass er unten bereits mit dem "
   +"Boden zusammengewachsen ist und so eine Saeule bildet. Die Eiszapfen "
   +"lassen das Iglu fast wie eine Hoehle wirken. Umso deplatzierter sehen die "
   +"Regale aus, die an den Waenden angebracht sind und auf denen alle "
   +"moeglichen Ausruestungsgegenstaende herumliegen.")+"@@xandim@@");
SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 0, ENV_TERRAIN: TT_HOUSE]));
SetProp( P_INDOORS, 1);
SetProp( P_LIGHT, 1);
SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
SetProp (P_SHOPKEEPER_ID, "yrmalaru");
SetProp (P_SHOPKEEPER_NAME, "Yrmalaru");
SetProp (P_SHOPKEEPER_GENDER, MALE);
        

AddDetail( "iglu",
           "Das Iglu ist wohl das aelteste im ganzen Dorf. Die Waende sind "
          +"voellig vereist vom erneuten Gefrieren des Eises nach waermeren "
          +"Jahreszeiten.");
AddDetail( "dorf",
           "Du stehst im aeltesten Iglu des Dorfes.");
AddDetail( ({"jahreszeiten", "zeiten"}),
           "Es gab auch waermere Zeiten hier, wo das Eis ansatzhalber zu "
          +"schmelzen begonnen hat.");
AddDetail( "gefrieren",
           "So nennt man einen chemischen Vorgang, in dem z.B. H2O von seiner "
          +"urspruenglichen Form in einen anderen Aggregatzustand uebergeht, "
          +"naemlich in den eines festen Koerpers.");
AddDetail( ({"aggregatzustand", "zustand"}),
           "Wegen genaueren Informationen fragen Sie bitte einen Chemiker "
          +"Ihres Vertrauens.");
AddDetail( "koerper",
           "Du begutachtest Deinen Koerper und verliebst Dich in Dich selbst.");
AddDetail( "vertrauen",
           "Vertraue prinzipiell niemanden!!!");
AddDetail( "chemiker",
           "Du kannst es ja mal beim Alchemisten in Derlim versuchen.");
AddDetail( "alchemist",
           "Der ist sehr weit weg ... ");
AddDetail( ({"derlim", "hobbits", "hobbit"}),
           "Derlim ist die Heimat der Hobbits, dort ist es auch ein wenig "
          +"waermer als hier.");
AddDetail( "heimat", 
           ([ 0:        "Sehnsuechtig denkst Du zurueck an Deine Heimat.",
           "zwerg":     "Sehnsuechtig denkst Du zurueck an Felonia.",
           "elf":       "Sehnsuechtig denkst Du zurueck an Elessar.",
           "mensch":    "Sehnsuechtig denkst Du zurueck an Midas.",
           "hobbit":    "Sehnsuechtig denkst Du zurueck an Derlim.",
           "dunkelelf": "Sehnsuechtig denkst Du zurueck an Dhrkion.",
           "troll":      "Sehnsuechtig denkst Du zurueck ans Trollager.",
           "fee":       "Sehnsuechtig denkst Du zurueck ans Feenschloss.",
           "oger":      "Sehnsuechtig denkst Du zurueck an die Ogerhoehle."]));
AddDetail( "eis",
           "Das Eis an den Waenden ist spiegelglatt, so spiegelglatt, dass "
          +"sich sogar Deine Umrisse darin spiegeln.");
AddDetail( ({"umriss", "umrisse"}),
           "Fasziniert betrachtest Du die vagen Umrisse Deines Spiegelbildes.");
AddDetail( ({"spiegelbild", "bild"}),
           "Du stehst da und starrst Dein Spiegelbild an ... und Dein "
          +"Spiegelbild starrt Dich an. Doch da faellt Dir etwas Sonderbares "
          +"an Deinem Spiegelbild auf, etwas, was da normalerweise nicht "
          +"hingehoert.");
AddDetail( ({"sonderbares", "sonderbar"}),
           "Es ist wohl nur eine optische Taeuschung vom Eis, aber es sieht "
          +"fast so aus, als ob Dein Spiegelbild ein kleines Flaeschchen in "
          +"der Hand haelt.");
AddDetail( "hand",
           "Durch die seltsamen Spiegelungen im Eis erscheint es Dir so, als "
          +"ob Dein Spiegelbild ein kleines Flaeschchen in der Hand haelt.");
AddDetail( "flaeschchen",
           "Es ist zwar nur eine Spiegelung, aber Du bist schon beinahe "
          +"verleitet, danach zu greifen.");
AddDetail( ({"spiegelung", "spiegelungen"}),
           "Vermutlich war es nur eine Taeuschung...");
AddDetail( ({"taeuschung", "taeuschungen"}),
           "Vermutlich faellt das Licht gerade so sonderbar ein, dass es "
          +"Deinen Augen solche Streiche spielt.");
AddDetail( ({"auge", "augen"}),
           "Die Augen koennen einen oft taeuschen ...");
AddDetail( "licht",
           "Das Licht wird von den spiegelnden Eiswaenden reflektiert.");
AddDetail( ({"streich", "streiche"}),
           "Du schuettelst den Kopf und beschliesst, nicht naeher ueber die "
          +"Taeuschung nachzudenken.");
AddDetail( "kopf",
           "Besorgt betastest Du Deinen Kopf und hoffst, dass solche "
          +"Taeuschungen nicht oefter auftreten.");
AddDetail( "innen",
           "Sieh Dich doch etwas genauer um.");
AddDetail( "eindruck",
           "Das Iglu erweckt einen seltsamen Eindruck.");
AddDetail( ({"wand", "waende", "eiswand", "eiswaende"}),
           "Die Waende sind vollkommen vereist und dadurch spiegelglatt. "
          +"An der hinteren Wand haengen einige Regale, auf denen sich "
          +"die verschiedensten Waren stapeln.");
AddDetail( ({"regale", "regal"}),
           "Die Regale, die an den Waenden haengen, passen irgendwie nicht "
          +"so recht in das sonstige Bild von dem Iglu.");
AddDetail( "bild",
           "So alt und geheimnisvoll das Iglu wirkt, so deplatziert sehen "
          +"die relativ neuen Regale mit den modernen Waren darauf aus.");
AddDetail( ({"ausruestungsgegenstaende", "gegenstaende",
             "ware", "waren", "angebot", "warenangebot"}),
           "Das Warenangebot kannst Du Dir mit <zeige> anzeigen lassen.");
AddDetail( "decke",
           "Die Decke ist vollkommen vereist und es haengen Eiszapfen in allen "
          +"Groessen und Formen daran herunter. Irgendwie erinnert Dich das "
          +"Iglu dadurch an eine Hoehle.");
AddDetail( "hoehle",
           "Du fuehlst Dich leicht erinnert an die Eishoehle.");
AddDetail( "eishoehle",
           "Hier ist es viel gemuetlicher und friedlicher als in der "
          +"Eishoehle.");
AddDetail( (({"zapfen", "eiszapfen"})),
           "Viele Eiszapfen haengen von der Decke herunter. Einer ist sogar so "
          +"gross, dass er unten wieder mit dem Boden zusammengewachsen ist "
          +"und dadurch eine Art Saeule bildet.");
AddDetail( "saeule",
           "Ein Eiszapfen geht von der Decke bis zum Boden runter und bildet "
          +"dadurch eine Saeule.");
AddDetail( ({"formen", "form", "groesse", "groessen"}),
           "Die Eiszapfen haben alle moeglichen Formen und Groessen. Der "
          +"groesste geht bis zum Boden hinunter.");
AddDetail( "boden",
           "Der Boden ist das einzige im Iglu, was nicht aus spiegelglattem "
          +"Eis besteht, sondern aus festgestampften Schnee.");
AddDetail( "schnee",
           "Der Schnee am Boden ist griffig und fest, sodass keine Gefahr fuer "
          +"Dich besteht, dass Du ausrutscht.");
AddDetail( "gefahr",
           "Sei nicht immer gleich so aengstlich! Dir wird schon nichts "
          +"passieren.");
AddDetail( ({"theke", "verkaufstheke"}),
           "Hinter der einfachen, holzgezimmerten Theke steht ein uralter "
          +"Xandim, der Dich genau mustert.");

AddSound( DEFAULT_SOUND,
          "Hier herrscht eine seltsame Stille.");
AddSound( "stille",
          "Die Stille hier ist schon beinahe andaechtig und erinnert an eine "
         +"Kapelle.");
AddSmell( DEFAULT_SMELL,
          "Die Luft ist kuehl und angenehm erfrischend.");

SetStorageRoom(DORF("equip"));

AddItem( NPC("yrmalaru"), REFRESH_DESTRUCT);

AddCmd( ({"greife", "greif"}), "flasche");

AddExit( "osten", DORF("hstrasse6"));

bottle=1;
}

reset()
{
  ::reset();
  bottle=1;
}

string xandim()
{
  if(present("yrmalaru", TO))
    return BS("Hinter einer uralten Verkaufstheke steht ein noch aelterer "
              "Xandim und blickt Dich erwartungsvoll aus scheinbar "
              "unendlich tiefen, blauen Augen an.");
  else
    return "";
}

flasche( str )
{
  object ob;
  notify_fail(BS("Wonach willst Du greifen?"));
  if( str=="nach flasche" || str=="nach flaeschchen")
    {
    if(bottle==1)
      {
      write(BS("Du greifst nach dem Flaeschchen und entgegen allen Gesetzen "
              +"der Physik bekommst Du es zu fassen und haeltst es nun "
              +"verbluefft in Deinen Haenden."));
      say(BS(CAP_TPN+" fummelt an der Wand von dem Iglu herum."));
      ob=clone_object(OBJ("flaeschchen"));
      if(ob->move(TP, M_GET)<0)
        {
        write(BS("Leider ist es Dir aber zu schwer und Du laesst es wieder "
                +"fallen, wobei es zerbricht."));
        ob->remove();
        }
      bottle=0;
      return 1;
      }
    else
      {
      write(BS("Du versuchst nach dem Flaeschchen zu greifen, tappst aber nur "
              +"auf die kalte Eiswand."));
      say(BS(CAP_TPN+" fummelt an der Wand von dem Iglu herum."));
      return 1;
      }
    }
    else
      return 0;
}
