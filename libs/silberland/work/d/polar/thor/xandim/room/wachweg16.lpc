#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Wachweg" );
  SetProp( P_INT_LONG,
    "Du stehst am dem Wachweg, der rund um Yiqanuc herumfuehrt. Er "
   +"fuehrt schnurstracks nach Nordwesten weiter. Im Suedosten kommst Du "
   +"wieder auf die Hauptstrasse zurueck. Links von Dir reiht sich ein "
   +"Iglu nach dem anderen, allerdings kannst Du nichts naeheres erkennen, "
   +"weil Du ueberall nur die Rueckwaende siehst. Rechts von Dir geht die "
   +"hohe Eispalisade am Weg entlang.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -10]) );

  AddDetail( ({"weg", "wachweg"}),
	     "Da bist Du gerade.");
  AddDetail( "yiqanuc",
	     "So heisst das Dorf, wo Du gerade bist.");
  AddDetail( "dorf",
	     "Ja, das hier ist ein Dorf. Es heisst Yiqanuc.");
  AddDetail( ({"strasse", "hauptstrasse"}),
	     "Im Suedosten kommst Du wieder auf die Hauptstrasse zurueck.");
  AddDetail( ({"iglu", "iglus"}),
	     "Links von Dir siehst Du einige Iglus, die Behausungen "
	    +"der Xandim.");
  AddDetail( "xandim",
	     "Das sind die Bewohner dieses Dorfes.");
  AddDetail( "bewohner",
	     "Die Bewohner dieses Dorfes heissen Xandim. Du wirst bestimmt "
	    +"noch einige von ihnen kennenlernen.");
  AddDetail( ({"behausung", "behausungen"}),
	     "Die Xandim wohnen in Iglus.");
  AddDetail( ({"waende", "rueckwaende"}),
	     "Du siehst nur die Rueckwaende der Iglus, die Eingaenge sind "
	    +"natuerlich auf der Vorderseite.");
  AddDetail( "eingaenge",
	     "Die Eingaenge der Iglus liegen auf deren Vorderseite.");
  AddDetail( "vorderseite",
	     "Die Vorderseite der Iglus ist bei der Hauptstrasse.");
  AddDetail( ({"eispalisade", "palisade"}),
	     "Die Eispalisade beschuetzt das Dorf vor feindlichen "
	    +"Eindringlingen.");
  AddDetail( ({"eindringlinge", "eindringling"}),
	     "Es gibt viele wilde Tiere und Banditen, die das "
	    +"Dorf manchmal ueberfallen.");
  AddDetail( "banditen",
	     "Nicht allzuweit vom Dorf entfernt leben ein paar Ausgestossene, "
	    +"die immer wieder das Dorf ueberfallen.");
  AddDetail( "ausgestossene",
	     "Sie haben gegen die Gesetze der Xandim verstossen.");
  AddDetail( ({"gesetze", "gesetz", "verstoss", "verstoesse"}),
	     "Bei schweren Verstoessen gegen das Gesetz der Xandim wird "
	    +"man aus dem Dorf verstossen.");
  AddDetail( ({"tiere", "tier"}),
	     "Hier in der eisigen Wildnis leben viele wilde Tiere.");
  AddDetail( "wildnis",
	     "Rund um das Dorf ist nur Wildnis.");
  AddDetail( "boden",
	     "Der Boden ist aus Eis und es liegt ein wenig Schnee darauf "
	    +"herum.");
  AddDetail( "eis",
	     "Alles ist hier aus Eis gemacht.");
  AddDetail( "schnee",
	     "Am Boden liegt etwas Schnee.");
  AddDetail( "himmel",
	     "Ueber Dir ist der strahlend blaue Himmel.");
  AddDetail( "sonne",
	     "Wenn die Sonne nicht scheinen wuerde, waere es wahrscheinlich "
	    +"noch viel kaelter.");

  AddSound( DEFAULT_SOUND,
    "Von der Ferne hoerst Du geschaeftiges Treiben.");
  AddSound( "treiben",
    "Es ist doch ein Stueckchen weit weg.");
  
  AddExit( "nordwesten", DORF("hstrasse8"));
  AddExit( "suedosten", DORF("wachweg15"));
}
