*  Thor@SilberLand               *
*  Eine Damentoilette - damen.c  *
*  1999-01-25                    *
*********************************/

#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

string *done=({});

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Damentoilette" );
  SetProp( P_INT_LONG,
           "Du stehst in einem kleinen Raum, der eine Damentoilette "
           "darstellen soll. In der suedlichen Wand ist in einer Hoehe "
           "von etwa sechzig Zentimeter eine Nische aus Eis angebracht. "
           "Auf der Nische liegt ein sauberes, fein gehobeltes Holzbrett, "
           "in dessen Mitte ein grosses Loch ist. Dies sollte wohl die "
           "Toilette darstellen. Seltsamerweise stinkt es in dem Raum gar "
           "nicht, wie es ansonsten bei Plumpsklos so der Fall ist. Ausserdem "
           "fliesst in einer Ecke noch etwas Wasser aus einem Loch heraus "
           "und versickert in einem weiteren Loch im Boden wieder. In der "
           "Westwand fuehrt die Tuer wieder auf den Flur zurueck."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE: 10]) );

  AddDetail( ({"raum", "damentoilette", "toilette", "wc"}),
	    "Der kleine Raum hier ist die Damentoilette der Kneipe \"Zum "
      "Erfrorenen Pinguin\" in Yiqanuc.");
  AddDetail( "flur",
      "In den kommst Du wieder durch die Tuer.");
  AddDetail( ({"kneipe", "pinguin"}),
      "Du stehst in der Toilette der Kneipe.");
  AddDetail( "yiqanuc",
      "Das solltest Du schoen langsam wissen, was das ist.");
  AddDetail( ({"wand", "suedwand"}),
      "An der Suedwand ist eine Nische mit Holzbrett, welche zum draufsetzen "
      "gedacht ist.");
  AddDetail( "westwand",
      "Dort ist die Tuer zum Flur.");
  AddDetail( "nische",
      "Auf der Nische liegt ein saeuberlich gezimmertes, gehobeltes und "
      "poliertes Holzbrett.");
  AddDetail( ({"brett", "holzbrett"}),
      "Es ist blitzeblank sauber und in der Mitte ist ein grosses Loch.");
  AddDetail( "mitte",
      "In der Mitte des Holzbretts ist ein grosses Loch.");
  AddDetail( "loch",
      "Du starrst in das Loch hinunter, kannst allerdings ausser gaehnender "
      "Schwaerze nichts erkennen. Vielleicht ist das auch besser so.");
  AddDetail( ({"schwaerze", "schwarz"}),
      "Schwaerzer als die Nacht ...");
  AddDetail( "nacht", 
      "Gibt es auf dieser Seite des SilberLands nicht.");
  AddDetail( ({"seite", "seiten"}),
      "Alles hat zwei Seiten.");
  AddDetail( ({"land", "silberland"}),
      "Davon solltest Du schon einiges kennen.");
  AddDetail( "hoehe",
      "Sechzig Zentimeter in etwa.");
  AddDetail( "zentimeter",
      "Ein Hundertstel von einem Meter.");
  AddDetail( "hundertstel",
      "Ein kleiner Teil halt ...");
  AddDetail( "teil",
      "Ein Teil des Ganzen.");
  AddDetail( ({"alles", "ganzes", "ganz", "ganzen"}),
      "Alles.");
  AddDetail( "meter",
      "Ein Meter ist ein Meter ist ein Meter ...");
  AddDetail( ({"klo", "klos", "plumpsklo", "plumpsklos"}),
      "Dort stinkt es meist fuerchterlich.");
  AddDetail( "fall",
      "Welcher denn?");
  AddDetail( ({"ecke", "eck"}),
      "Aus einer Ecke fliesst ein wenig Wasser aus einem Loch. Dies ist wohl "
      "zum Haendewaschen gedacht, nach verrichtetem Geschaeft.");
  AddDetail( "geschaeft",
      "Tu Dir nur keinen Zwang an.");
  AddDetail( "zwang",
      "Zwingen tut Dich hier niemand.");
  AddDetail( ({"waschen", "haendewaschen"}),
      "Na Du bist ja wohl kein Ferkel, oder?");
  AddDetail( "ferkel",
      "Andererseits ... wenn man Dich so ansieht ...");
  AddDetail( "wasser",
      "Das leise Plaetschern des Wassers regt so richtig dazu an, wozu dieser "
      "Raum geschaffen wurde.");
  AddDetail( "plaetschern",
      "Leise plaetschert das Wasser ...");
  AddDetail( "boden",
      "Der Boden ist genauso sauber wie die restliche Kneipe.");
  AddDetail( "waende",
      "Die Waende sind glatt und eisig und kahl. Kein einziger Klospruch "
      "verunstaltet sie.");
  AddDetail( ({"spruch", "klospruch"}),
      "Du willst wohl nicht als erste anfangen, hier herumzuschmieren, oder?");
  AddDetail( "decke",
      "Rund und krumm ober Dir.");
  AddDetail( "eis",
      "Die ganze Kneipe besteht aus Eis.");
  
  
  AddSound( DEFAULT_SOUND,
      "Das Wasser in der Ecke plaetschert leise vor sich hin.");
  AddSound( ({"wasser", "plaetschern"}),
      "Sehr anregend an diesem Ort hier.");
  AddSmell( DEFAULT_SMELL,
      "Seltsamerweise stinkt es hier kein bisschen.");
  AddSmell( "gestank",
      "Der Gestank scheint auf magische Weise unterdrueckt zu werden.");

  NewDoor("westen", DORF("kneipe2"),
         ({"tuer", "tuere"}),
           ({
           D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED,
           D_LONG, "Die Tuer fuehrt wieder auf den Flur zurueck.",
           D_GENDER, FEMALE,
           D_SHORT, "",
           D_NAME, "Tuer",
           D_TESTFUNC, "doorfunc"
           }));

  AddCmd( ({"pinkel", "pinkle", "verrichte", "verricht", "pisse", "piss",
            "setze", "sitze", "setz", "sitz"}), "doit");
  AddCmd( ({"wasche", "putze", "reinige", "wasch"}), "washfunc");
}

reset()
{
  done=({});
  ::reset();
}

int doorfunc()
{
  write(BS("Du gehst aus der Toilette und schliesst die Tuer hinter Dir "
           "wieder."));
  DOORMASTER->SetDoorStatus(DORF("kneipe2"), D_STATUS_CLOSED);
  return 0;
}

doit()
{
  object ob;

  if (member(done, getuid(TP)) == -1) {
    write(BS("Du laesst die Hosen runter und setzt Dich auf das Holzbrett. "
             "Entspannt lauscht Du dem Plaetschern des Wassers in der Ecke "
             "und verrichtest Dein Geschaeft. Merklich erleichtert stehst "
             "Du wieder auf und ziehst Dich an."));
    TP->SetProp(P_DRINK, TP->QueryProp(P_DRINK)-(5+random(15)) );
    done+=({getuid(TP)});
    if(ob=present("\nharndrang", TP)) {
      ob->remove();
      write(BS("Aaaah, das war ja hoechste Zeit. Noch eine Sekunde spaeter, "
               "und Du haettest Dich in die Hose gemacht."));
    } 
    return 1;
  }
  else {
    write(BS("So schnell ist Deine Verdauung nicht, warte lieber noch ne "
             "Weile und versuchs danach nochmal."));
    return 1;
  }
}

washfunc( str )
{
  notify_fail(BS("Was willst Du denn waschen?"));
  if( str == "haende" || str == "hand" ) {
    write(BS("Sorgfaeltig waescht Du Dir die Haende in dem Wasser, das aus "
             "der Ecke heraussprudelt. Brrrrrr, ist das kalt!"));
    return 1;
  }
  else if( str == "gesicht" || str == "kopf" ) {
    write(BS("Du waescht Dir Dein Gesicht mit dem eiskalten Wasser. "
             "Ein Schauer jagt Dir den Ruecken hinunter und Deine Lippen "
             "laufen blau an, aber wenigstens ist Dein Gesicht jetzt sauber. "
             "Immer noch zitternd wendest Du Dich von dem kleinen Wasserstrom "
             "ab."));
    return 1;
  }
  else
    return 0;
}
