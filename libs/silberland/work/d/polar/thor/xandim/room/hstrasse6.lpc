#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hauptstrasse" );
  SetProp( P_INT_LONG,
      "Dies hier ist der noerdliche Teil des Dorfes. Die Hauptstrasse fuehrt "
     +"weiter zum Nordtor des Dorfes, weiter suedlich ist der Hauptplatz. "
     +"Im Westen kannst Du einen kleinen, unscheinbaren Laden betreten. Es "
     +"scheint eines der aeltesten Iglus hier zu sein denn die Eisbloecke sind "
     +"nicht mehr zu erkennen sondern schon miteinander verschmolzen und "
     +"zusammengewachsen. Ausserdem hat das Iglu bereits eine dunkle Faerbung "
     +"vom Schmutz. Ueber der Eingangstuer kannst Du ein Schild erkennen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -10]) );

  AddDetail( ({"teil", "dorf"}),
        "Dies hier ist der Norden von Yiqanuc. Das ist genau die "
       +"entgegengesetzte Richtung von Sueden, weisst Du?");
  AddDetail( "richtung",
        "Nun ja ... das Gegenteil von Norden ist Sueden und dann gibt es "
       +"da ausserdem auch noch Westen und Osten. Lass Dir das doch mal von "
       +"einem Magier erklaeren, die kennen sich da meistens recht gut aus.");
  AddDetail( "gegenteil",
        "Hmm ... immer noch nicht so gut erklaert, was?");
  AddDetail( "magier",
        "Naja, die glauben immer, sie wuessten alles.");
  AddDetail( ({"strasse", "hauptstrasse"}),
        "Die Hauptstrasse fuehrt von Sueden nach Norden und dann gibt es auch "
       +"noch eine zweite von Westen nach Osten. In der Mitte des Dorfes "
       +"kreuzen sie sich, dort ist der Hauptplatz.");
  AddDetail( ({"platz", "hauptplatz"}),
        "Der Hauptplatz liegt weiter suedlich von Dir.");
  AddDetail( ({"tor", "nordtor"}),
        "Durch das Nordtor kannst Du das Dorf nach Norden hin verlassen. ");
  AddDetail( ({"laden", "iglu", "ladeniglu"}),
        "Das Iglu scheint sehr alt zu sein. Das Eis ist schon ziemlich "
       +"schmutzig und unfoermig.");
  AddDetail( ({"bloecke", "eisbloecke"}),
        "Die Eisbloecke des Iglus sind alle durch die gelegentliche milde "
       +"Waerme zusammengewachsen.");
  AddDetail( ({"faerbung", "schmutz"}),
        "Tja, Eis kann man nur schwierig wieder reinwaschen. Und die Fassade "
       +"neu zu streichen ist vermutlich auch keine so gute Idee.");
  AddDetail( "fassade",
        "Denkst Du wirklich, dass es viel bringt, die Fassade eines Iglus zu "
       +"streichen?");
  AddDetail( "idee",
        "Naja, Du kannst es ja gerne trotzdem einmal versuchen.");
  AddDetail( ({"tuer", "eingangstuer"}),
        "Ueber der Tuer haengt ein Schild.");
  AddDetail( "schild",
        "Du kannst es lesen.");
  AddDetail( "himmel",
	     "Ueber Dir ist ein strahlend blauer Himmel.");
  AddDetail( "sonne",
	     "Ohne die Sonne waere es hier vermutlich noch viel, viel "
	    +"kaelter."); 
  AddDetail( "boden",
	     "Der Boden besteht aus blankem Eis und ist mit ein wenig Schnee "
            +"bedeckt.");
  AddDetail( ({"eis", "eisschicht", "schicht"}),
       "Unter dem verschneiten Boden ist eine harte Eisschicht.");
  AddDetail( "schnee",
	     "Am Boden liegt ein wenig Schnee.");
  AddReadDetail( "schild",
       "\n"
      +"                   ______________________________________           \n"
      +"          ________|                                      |_______   \n"
      +"          \\       |       S I L B E R L A N D ' S        |      /   \n"
      +"           \\      |          SPORT - FACHHANDEL          |     /    \n"
      +"           /      |______________________________________|     \\    \n"
      +"          /__________)                                (_________\\   \n"
      +"\n");
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst reges Treiben von dem Hauptplatz her.");
  AddSound( "treiben",
    "Du hoerst froehliche Stimmen und Unterhaltungen.");
  AddSound( ({"stimmen", "unterhaltungen"}),
    "Die Leute klingen aeusserst gutgelaunt.");
  
  AddCmd( ({"streiche", "streich"}), "fassade");
  
  AddExit( "norden", DORF("hstrasse7"));
  AddExit( "westen", DORF("laden2"));
  AddExit( "sueden", DORF("hstrasse5"));
}

fassade( str )
{
  object ob; /* by Muaddib */

  notify_fail(BS("Was willst du streichen?\n"));
  if(str=="iglu" || str=="fassade")
    if(!present("\ncolor", TP))
      {
      write(BS("Du hast ja gar keine Farbe! Wie willst Du denn da was "
              +"streichen?\n"));
      return 1;
      }
    else if(!present("pinsel", TP))
      {
      write(BS("Ohne Pinsel wird es wohl etwas schwierig werden, die "
              +"Fassade zu streichen.\n"));
      return 1;
      }
    else if(!IS_SEER(TP))
      {
      write(BS("Du tauchst den Pinsel in den Farbtopf ein und beginnst, "
              "die schmutzige Fassade des Iglus zu streichen. Die frische "
              "weisse Farbe sieht etwas sonderbar aus auf dem Eis, aber Du "
              "pinselst unentwegt weiter. Schliesslich betrachtest Du "
              "stolz und zufrieden Dein Werk, waehrend sich der Pinsel und "
              "der Farbtopf aufloesen.\n"));
      say(BS(CAP_TPN+" beginnt, das Iglu mit weisser Farbe anzumalen. "
              +"Interessiert siehst Du zu, verstehst aber nicht ganz, was "
              +"das alles bringen soll...\n"));
      if(ob=present("pinsel", TP))
        ob->remove();
      if(ob=present("\ncolor", TP))
        ob->remove();
      return 1;
      }
    else if("/obj/sehertormaster"->DoorIsKnown())
      {
      write(BS("Froehlich pinselst Du die Fassade des Iglus an und "
              +"betrachtest darauf stolz Dein Werk.\n"));
      say(BS(CAP_TPN+" pinselt froehlich die Fassade des Iglus an und "
              +"betrachtet dann zufrieden "
              +TP->QueryPossPronoun(NEUTER, WEN, SINGULAR)+" Werk.\n"));
      return 1;
      }
    else
      {
      write(BS("Du tauchst den Pinsel in den Farbtopf ein und beginnst, "
              +"die schmutzige Fassade des Iglus zu streichen. Die frische "
              +"weisse Farbe sieht etwas sonderbar aus auf dem Eis, aber Du "
              +"pinselst unentwegt weiter.\n"));
      say(BS(CAP_TPN+" beginnt, das Iglu mit weisser Farbe anzumalen. "
              +"Interessiert siehst Du zu, verstehst aber nicht ganz, was "
              +"das alles bringen soll...\n"));
      call_out("seq1", 5);
      return 1;
      }
  else
    return 0;
}

seq1()
{
  object ob;
  
  if(!TP||environment(TP)!=TO)
    return;
  else
    {
    write("Ploetzlich kommt ein alter Xandim aus dem Iglu heraus und "
            "sieht Dich mit strahlenden Augen an.\n"
            "Der Xandim sagt: Nun sag noch einer, dass die Jugend von "
            "heute nicht mehr\nDer Xandim sagt: hilfsbereit sei ... Du hast "
            "guten Willen bewiesen, nun seist\nDer Xandim sagt: Du auch "
            "belohnt dafuer! Deine Augen seien nun geoeffnet fuer\nDer Xandim "
            "sagt: die Magie ...\n\nMit diesen Worten nimmt er Dir den "
            "Farbtopf und den Pinsel ab und verschwindet wieder im Iglu.\n");
    say(BS("Ploetzlich kommt ein alter Xandim aus dem Iglu heraus, "
            +"sieht "+TPN+" mit strahlenden Augen an und fluestert "+
            TP->QueryPronoun(WEM)+" etwas zu.\n"));
    "obj/sehertormaster"->DiscoverDoor("/d/polar/thor/xandim/room/hauptplatz1");
    write_file("/d/polar/thor/xandim/log/sehertor",
               dtime(time())+": "+CAP(getuid(TP))+" findet das Sehertor.\n");
    
    if(ob=present("pinsel", TP))
      ob->remove();
    if(ob=present("\ncolor", TP))
      ob->remove();
    }
}
