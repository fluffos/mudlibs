*  Die Xandimpost - post.c  *
*  1998-01-31               *
****************************/

inherit "/std/post";

#include <properties.h>
#include "../xandim.h"

create()
{
  ::create();

  SetProp (P_INT_SHORT, "In der Xandim-Post");
  SetProp (P_INT_LONG,
    "Du stehst in der Postfiliale von Yiqanuc. Die Post ist ein grosses, "
   +"geraeumiges Iglu, an den Waenden siehst Du zwei Kabinen, in denen "
   +"Du ungestoert Deine Post durchsehen kannst. Mit \"post\" kannst Du "
   +"Dir Deine Briefe ansehen und auch welche schreiben. Eine gelbe "
   +"Holztuer fuehrt im Osten wieder auf die Hauptstrasse zurueck.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:10]) );

  AddDetail( ({"post", "postfiliale", "filiale", "raum"}),
	     "Du stehst mitten in der Post von Yiqanuc. Sieh Dich doch "
	    +"einfach mal ein wenig um.");
  AddDetail( "yiqanuc",
	     "Ja, da bist Du gerade.");
  AddDetail( "iglu",
	     "Das Iglu ist aeusserst geraeumig. Besonders auffaellig sind "
	    +"die beiden Kabinen an der Wand.");
  AddDetail( ({"briefe", "brief"}),
	     "Tippe doch einfach mal \"post\", dann siehst Du, ob Dir "
	    +"jemand einen Brief geschickt hat.");
  AddDetail( ({"tuer", "holztuer"}),
	     "Die Holztuer ist gelb bemalt und fuehrt wieder zur "
	    +"Hauptstrasse zurueck.");
  AddDetail( ({"strasse", "hauptstrasse"}),
	     "Nach Osten hin durch die gelbe Tuer kommst Du wieder auf die "
	    +"Hauptstrasse zurueck.");
  AddDetail( "boden",
	     "Der Boden ist mit Holz ausgezimmert.");
  AddDetail( ({"waende", "wand"}),
	     "An den Waenden stehen zwei Ein-Personen-Kabinen.");
  AddDetail( "decke",
	     "Die Decke ist aus Schnee, wie nicht anders zu erwarten in "
	    +"einem Iglu.");
  AddDetail( "holz",
	     "Der Boden und die Tuer sind aus Holz gezimmert.");
  AddDetail( "schnee",
	     "Wie nicht anders zu erwarten ist das Iglu aus Schnee "
	    +"gebaut.");
  AddDetail( ({"kabinen", "postkabinen"}),
             "Du kannst sie betreten um dort in Ruhe Deine Post "
             "durchzusehen.");
  AddDetail( "ruhe",
             "Die hast Du in den Kabinen ganz bestimmt.");

  AddSound (DEFAULT_SOUND, 
	    "Du hoerst von draussen her die Geraeusche vom "
	   +"Marktplatz gedaempft hereindringen.");
  AddSound( ({"geraeusche", "geraeusch"}),
	    "Geh doch raus, dann hoerst Du mehr.");

  AddExit("osten", DORF("hauptplatz3"));
}
