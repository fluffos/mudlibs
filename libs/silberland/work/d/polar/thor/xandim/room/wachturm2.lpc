#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <living.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Wachturm" );
  SetProp( P_INT_LONG,
    "Du stehst im ersten Stock des Wachturmes von Yiqanuc. Dies hier ist der "
   +"Aufenthaltsraum der Wache von Yiqanuc, daher sieht es hier auch etwas "
   +"gemuetlicher aus als im Bereitschaftsraum einen Stock tiefer. Auch hier "
   +"steht in der Mitte ein Tisch mit einigen Sesseln rundherum. Auf dem "
   +"liegen ein Stapel Karten und einige Wuerfel herum. An der Westwand steht "
   +"ein Kamin um den Raum ein wenig zu waermen. Einige Buecher stehen auf "
   +"dem Kaminsims, die allerdings schon ziemlich verstaubt aussehen. Neben "
   +"dem Kamin steht ein gemuetlicher Polstersessel, der sehr einladend "
   +"aussieht. An der Nordwand fuehrt eine steile Wendeltreppe auf das Dach "
   +"des Wachturms und eine weitere Treppe wieder nach unten in den "
   +"Bereitschaftsraum.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: 15]) );

  AddDetail( ({"turm", "wachturm", "stock", "raum", "aufenthaltsraum"}),
	     "Du bist hier im ersten Stock des Wachturmes, im Aufenthaltsraum "
            +"der Wachen. Einen Stock tiefer ist der Bereitschaftsraum.");
  AddDetail( "bereitschaftsraum",
	     "Der ist einen Stock tiefer.");
  AddDetail( "yiqanuc",
	     "So heisst das Dorf hier.");
  AddDetail( ({"dorf", "xandimdorf"}),
	     "Du bist im Xandimdorf Yiqanuc.");
  AddDetail( ({"wache", "wachen", "waechter"}),
	     "Hier im Aufenthaltsraum verbringen die Wachen ihre Pausen und "
            +"von Zeit zu Zeit gibt es hier auch manchmal ein gemuetliches "
	    +"Beisammensein der Waechter.");
  AddDetail( ({"pausen", "pause", "anspruch"}),
	     "Auch Wachen haben einen Anspruch auf Pausen.");
  AddDetail( "beisammensein",
	     "Die Waechter bleiben oft bis nach Dienstschluss noch lange "
	    +"sitzen und trinken einen miteinander.");
  AddDetail( ({"schluss", "dienstschluss", "schichten", "schicht"}),
	     "Die Waechter arbeiten in Schichten rund um die Uhr.");
  AddDetail( "mitte",
	     "In der Mitte des Raumes steht ein Tisch.");
  AddDetail( "tisch",
	     "Auf dem Tisch liegt ein Kartenspiel verstreut herum und "
	    +"ausserdem noch ein paar Wuerfel.");
  AddDetail( ({"spiel", "kartenspiel", "karten"}),
	     "Damit vergnuegen sich die Waechter oefters in der Freizeit.");
  AddDetail( ({"freizeit", "zeit"}),
	     "Auch die Wachen haben etwas Freizeit, ja.");
  AddDetail( ({"wuerfel", "wuerfelspielen"}),
	     "Auch mit Wuerfelspielen kann man sich die Zeit vertreiben.");
  AddDetail( "stapel",
	     "Ein Stapel Karten liegt auf dem Tisch.");
  AddDetail( "sessel",
	     "Rund um den Tisch stehen einige Sessel herum.");
  AddDetail( "westwand",
	     "An der Westwand steht ein grosser Kamin.");
  AddDetail( "kamin",
	     "Der Kamin scheint eingeheizt zu sein, denn er strahlt eine "
	    +"wohlige Waerme aus.");
  AddDetail( "feuer",
             "Nachdem eingeheizt worden ist, ist es nicht verwunderlich, "
            +"dass Du im Kamin ein Feuer sehen kannst.");	    
  AddDetail( "waerme",
	     "Hier ist es richtig angenehm.");
  AddDetail( ({"sims", "kaminsims"}),
	     "Es stehen einige Buecher auf dem Kaminsims herum, die "
	    +"anscheinend allerdings schon lange von keinem mehr angeruehrt "
	    +"wurden.");
  AddDetail( "buecher",
	     "Einige Buecher ueber Waffen, Ruestungen und Kriegskunst stehen "
	    +"auf dem Kaminsims herum. Sie sind allerdings schon sehr "
	    +"verstaubt, es sieht so aus, als haette sie schon lange "
	    +"niemand mehr gelesen.");
  AddDetail( ({"titel", "waffen", "ruestungen", "kunst", "kriegskunst"}),
	     "Die Titel sind nur mehr sehr schwierig zu entziffern hinter "
	    +"der dicken Staubschicht. Die Buecher stehen wohl nur noch als "
	    +"Zierde da.");
  AddDetail( ({"staub", "staubschicht", "schicht"}),
	     "Am Kaminsims ist eine dicke Staubschicht.");
  AddDetail( "zierde",
	     "Nun ja ... hinter so dickem Staub kann man wohl nichtmal mehr "
	    +"von Zierde reden.");
  AddSpecialDetail( "polstersessel", "unt_polstersessel");
  AddDetail( "polster",
             "Der Polster des Polstersessels sieht wunderbar flauschig-weich "
             "aus. Du wuerdest Dich am liebsten gleich darauf niederlassen.");
  AddSpecialDetail( "xandimwaechter", "unt_waechter");
  AddDetail( "ruhe",
	     "Lass ihm doch seine Ruhe.");
  AddDetail( "nordwand",
	     "An der Nordwand fuehrt eine Wendeltreppe auf das Dach und "
	    +"eine andere Treppe wieder in den Bereitschaftsraum hinunter.");
  AddDetail( "wendeltreppe",
	     "Die Wendeltreppe fuehrt auf das Dach des Wachturms hinauf.");
  AddDetail( "dach",
	     "Von da oben hat man bestimmt eine tolle Aussicht.");
  AddDetail( ({"aussicht", "sicht"}),
	     "Geh doch einfach mal rauf und sieh nach.");
  AddDetail( "treppe",
	     "Ueber die zweite Treppe kommst Du wieder in den "
	    +"Bereitschaftsraum runter.");
  AddDetail( ({"waende", "wand"}),
	     "Die Waende sind aus Holz.");
  AddDetail( "holz",
	     "Wo sie hier in dieser unfreundlichen Gegend wohl Holz "
	    +"herbekommen haben?");
  AddDetail( "gegend",
	     "Nun ja, einen Wald hast Du hier noch nirgends gesehen.");
  AddDetail( "wald",
	     "Du hast noch keinen Wald gesehen.");
  AddDetail( ({"boden", "decke"}),
	     "Der Boden und die Decke sind aus Holz.");
	     
  AddSound( DEFAULT_SOUND,
    "Manchmal hoerst Du ein leises Knacken aus dem Kamin.");
  AddSound( "knacken",
    "Du hoerst, wie das Holz im Kamin knackt.");
    
  AddCmd( ({"wecke", "weck"}), "waechter");
  AddCmd( ({"sitze", "setze", "sitz"}), "sit_down");

  AddExit( "oben", DORF("wachturm3"));
  AddExit( "unten", DORF("wachturm1"));
}

int sessel=1;

reset()
{
  ::reset();
  sessel=1;
}

waechter( str )
{
  object ob;
  notify_fail(BS("Wen willst Du wecken?\n"));
  if(str=="waechter"||str=="wache"||str=="xandim"||str=="xandimwaechter")
    {
    if(sessel==1)
      {
      write(BS("Du ruettelst den Xandimwaechter vorsichtig wach. Dieser "
	    +"springt erschrocken auf, sieht Dich, glaubt sofort, Du bist ein "
	    +"Eindringling und er stuermt sogleich auf Dich los.\n"));
      say(BS(CAP_TPN+" weckt den Xandimwaechter, der in seiner "
	    +"Schlaftrunkenheit denkt, "+TPN+" sei ein Eindringling und dann "
	    +"auch sogleich auf ihn losstuermt.\n"));
      ob=clone_object(NPC("waechter1"));
      ob->move(environment(TP), M_NOCHECK|M_SILENT);
      ob->Kill(TP);
      sessel=0;
      return 1;
      }
    else
      {
      write(BS("Hier kannst Du niemanden wecken.\n"));
      return 1;
      }
    }
  else
    return 0;
}

sit_down( str )
{
  notify_fail(BS("Wo willst Du Dich hinsetzen?\n"));
  if(str=="auf sessel"||str=="auf polstersessel"||str=="in sessel"||
     str=="in polstersessel")
    {
    if(sessel==0)
       {
       write(BS("Du setzt Dich kurz auf den Polstersessel, findest aber "
	    +"nicht, dass dies allzu konstruktiv ist und stehst daher gleich "
	    +"wieder auf.\n"));
       say(BS(CAP_TPN+" setzt sich auf einen Polstersessel, steht dann aber "
	  +"auch sogleich wieder auf.\n"));
       return 1;
       }
    else
      {
      write(BS("Du kannst Dich nicht in den Sessel setzen, da schlaeft doch "
	      +"der Xandimwaechter drinnen.\n"));
      return 1;
      }
    }
  else
    return 0;
}

string unt_polstersessel()
{
  if(sessel)
    return BS("Der Polstersessel sieht sehr gemuetlich aus. Allerdings "
              "schlaeft darin gerade ein Xandimwaechter.");
  else
    return "Der Polstersessel sieht sehr gemuetlich aus.\n";
}

string unt_waechter()
{
  if(sessel)
    return BS("Der Xandimwaechter in dem Polstersessel schlaeft tief und fest. "
	      "Du sollst ihn besser nicht wecken, auch er hat seine Ruhe "
	      "verdient.");
  else
    return "Sowas siehst Du da nicht!\n";
}
