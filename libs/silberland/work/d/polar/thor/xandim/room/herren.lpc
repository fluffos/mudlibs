*  Thor@SilberLand                *
*  Eine Herrentoilette - herren.c *
*  1999-01-25                     *
**********************************/

#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

string *done=({});

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Herrentoilette" );
  SetProp( P_INT_LONG,
           "Du stehst in einem kleinen Raum, der eine Herrentoilette "
           "darstellen soll. In der suedlichen Wand ist eine Rille im "
           "Eis, die einen leicht gelblichen Farbstich hat. Dies sollte wohl "
           "die Toilette darstellen. Seltsamerweise stinkt es in dem Raum "
           "keineswegs, was bei solchen Oertlichkeiten ja nicht gerade "
           "selbstverstaendlich ist. Ausserdem fliesst in einer Ecke noch "
           "etwas Wasser aus einem Loch heraus und versickert in einem "
           "weiteren Loch im Boden wieder. In der Nordwand fuehrt die Tuer "
           "wieder auf den Flur zurueck."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE: 10]) );

  AddDetail( ({"raum", "herrentoilette", "toilette", "wc"}),
	    "Der kleine Raum hier ist die Herrentoilette der Kneipe \"Zum "
      "Erfrorenen Pinguin\" in Yiqanuc.");
  AddDetail( "flur",
      "In den kommst Du wieder durch die Tuer.");
  AddDetail( ({"kneipe", "pinguin"}),
      "Du stehst in der Toilette der Kneipe.");
  AddDetail( "yiqanuc",
      "Das solltest Du schoen langsam wissen, was das ist.");
  AddDetail( ({"wand", "suedwand"}),
      "An der Suedwand ist eine etwas tiefere Rille im Eis, welche zum - "
      "naja, Du weisst schon - gedacht ist.");
  AddDetail( "nordwand",
      "Dort ist die Tuer zum Flur.");
  AddDetail( "rille",
      "Das Eis in der Rille hat einen etwas gelblichen Farbstich, was Du aber "
      "nicht genauer eruieren moechtest.");
  AddDetail( ({"farbe", "farbstich", "stich", "gelb"}),
      "Pissgelb, wenn Du es schon so genau wissen willst!");
  AddDetail( ({"oertlichkeiten", "oertlichkeit"}),
      "Diese Oertlichkeit ist sehr sauber gehalten und ist auch absolut keine "
      "Beleidigung fuer die Nase.");
  AddDetail( ({"beleidigung", "nase"}),
      "Deine Nase ist sehr leicht beleidigt!");
  AddDetail( ({"loch", "ecke", "eck"}),
      "Aus einer Ecke fliesst ein wenig Wasser aus einem Loch. Dies ist wohl "
      "zum Haendewaschen gedacht, nach verrichtetem Geschaeft.");
  AddDetail( "geschaeft",
      "Tu Dir nur keinen Zwang an.");
  AddDetail( "zwang",
      "Zwingen tut Dich hier niemand.");
  AddDetail( ({"waschen", "haendewaschen"}),
      "Na Du bist ja wohl kein Ferkel, oder?");
  AddDetail( "ferkel",
      "Andererseits ... wenn man Dich so ansieht ...");
  AddDetail( "wasser",
      "Das leise Plaetschern des Wassers regt so richtig dazu an, wozu dieser "
      "Raum geschaffen wurde.");
  AddDetail( "plaetschern",
      "Leise plaetschert das Wasser ...");
  AddDetail( "boden",
      "Der Boden ist genauso sauber wie die restliche Kneipe.");
  AddDetail( "waende",
      "Die Waende sind glatt und eisig und kahl. Kein einziger Klospruch "
      "verunstaltet sie.");
  AddDetail( ({"spruch", "klospruch"}),
      "Du willst wohl nicht als erster anfangen, hier herumzuschmieren, oder?");
  AddDetail( "decke",
      "Rund und krumm ober Dir.");
  AddDetail( "eis",
      "Die ganze Kneipe besteht aus Eis, wieso nicht auch die Toilette?");
  
  
  AddSound( DEFAULT_SOUND,
      "Das Wasser in der Ecke plaetschert leise vor sich hin.");
  AddSound( ({"wasser", "plaetschern"}),
      "Sehr anregend an diesem Ort hier.");
  AddSmell( DEFAULT_SMELL,
      "Seltsamerweise stinkt es hier kein bisschen.");
  AddSmell( "gestank",
      "Der Gestank scheint auf magische Weise unterdrueckt zu werden.");

  NewDoor("norden", DORF("kneipe2"),
         ({"tuer", "tuere"}),
           ({
           D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED,
           D_LONG, "Die Tuer fuehrt wieder auf den Flur zurueck.",
           D_GENDER, FEMALE,
           D_SHORT, "",
           D_NAME, "Tuer",
           D_TESTFUNC, "doorfunc"
           }));

  AddCmd( ({"pisse", "piss", "pinkel", "pinkle", "verrichte", "verricht"}), 
            "doit");
  AddCmd( ({"wasche", "putze", "reinige", "wasch"}), "washfunc");
}

reset()
{
  done=({});
  ::reset();
}

int doorfunc()
{
  write(BS("Du gehst aus der Toilette und schliesst die Tuer hinter Dir "
           "wieder."));
  DOORMASTER->SetDoorStatus(DORF("kneipe2"), D_STATUS_CLOSED);
  return 0;
}

doit()
{
  object ob;

  if (member(done, getuid(TP)) == -1) {
    write(BS("Breitbeinig stellst Du Dich hin und knoepfst Deine Hosen auf. "
             "Entspannt lauscht Du dem Plaetschern des Wassers in der Ecke "
             "und verrichtest Dein Geschaeft. Merklich erleichtert packst "
             "Du alles wieder ein und knoepfst Dir Deine Hosen wieder zu."));
    TP->SetProp(P_DRINK, TP->QueryProp(P_DRINK)-(5+random(15)) );
    done+=({getuid(TP)});
    if(ob=present("\nharndrang", TP)) {
      ob->remove();
      write(BS("Aaaah, das war ja hoechste Zeit. Noch eine Sekunde spaeter, "
               "und Du haettest Dich in die Hose gemacht."));
    }
    return 1;
  }
  else {
    write(BS("So schnell ist Deine Verdauung nicht, warte lieber noch ne "
             "Weile und versuchs danach nochmal."));
    return 1;
  }
}

washfunc( str )
{
  notify_fail(BS("Was willst Du denn waschen?"));
  if( str == "haende" || str == "hand" ) {
    write(BS("Sorgfaeltig waeschst Du Dir die Haende in dem Wasser, das aus "
             "der Ecke heraussprudelt. Brrrrrr, ist das kalt!"));
    return 1;
  }
  else if( str == "gesicht" || str == "kopf" ) {
    write(BS("Du waescht Dir Dein Gesicht mit dem eiskalten Wasser. "
             "Ein Schauer jagt Dir den Ruecken hinunter und Deine Lippen "
             "laufen blau an, aber wenigstens ist Dein Gesicht jetzt sauber. "
             "Immer noch zitternd wendest Du Dich von dem kleinen Wasserstrom "
             "ab."));
    return 1;
  }
  else
    return 0;
}
