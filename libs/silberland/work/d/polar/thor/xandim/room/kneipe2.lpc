/********************************
*  Thor@SilberLand              *
*  In einer Kneipe - kneipe2.c  *
*  1999-01-25                   *
********************************/

#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int topf=1;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein schmaler Flur" );
  SetProp( P_INT_LONG, "\t"+BS(
           "Du stehst in einem schmalen, ziemlich kurzem Flur. Nach Westen "
           "hin fuehrt er wieder in die Kneipe zurueck, im Osten endet "
           "er an einer Tuer und suedlich von Dir siehst Du noch eine weitere "
           "Tuer. Ansonsten ist der Flur ziemlich kahl.")+"@@topf@@");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE: 10]) );

  AddDetail( ({"flur", "raum", "iglu"}),
	    "Du stehst in einem schmalen, kurzen Flur, der von Westen nach Osten "
      "fuehrt.");
  AddDetail( "kneipe",
      "Nach Westen kommst Du wieder in die Kneipe zurueck.");
  AddDetail( "boden",
      "Der Boden sieht gleich aus wie in der Kneipe, sauber gefegt mit leicht "
      "aufgerauhtem Eis.");
  AddDetail( "eis",
      "Das ganze Iglu besteht aus Eis.");
  AddDetail( ({"waende", "wand"}),
      "Die Waende sind kahl. Einfach nur kahl. Du kannst nichts Interessantes "
      "erkennen.");
  AddDetail( "decke",
      "Die Decke woelbt sich ueber Dir und verschmilzt auf halber Hoehe mit "
      "den Waenden.");
  AddSpecialDetail( ({"farbe", "farbtopf", "topf"}),"detailTopf" );
  AddSpecialDetail( ({"ecke","ecken" }), "detailEcke" );

  AddSound( DEFAULT_SOUND,
      "Die angeregten Gespraeche aus der Kneipe dringen nur noch als leises "
      "Murmeln an Dein Ohr.");
  AddSound( ({"gespraeche", "gespraech", "murmeln"}),
      "Ausser einem Murmeln kannst Du nichts verstehen.");
  
  AddCmd( "nimm", "take" );
  
  NewDoor("osten", DORF("damen"),
         ({"osttuer", "oestliche tuer", "tuer", /*"tuer 1", "tuere 1",*/ "tuere"}),
           ({
           D_MSGS, "nach Osten und schliesst die Tuer hinter sich", 
           D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED,
           D_LONG, "Auf der Tuer im Osten steht in grossen Lettern "
                   "geschrieben: \"DAMEN\"",
           D_GENDER, FEMALE,
           D_SHORT, "",
           D_NAME, "Tuer",
           D_TESTFUNC, "girls",
           D_OPENTESTFUNC, "enter_girls"
           }) );
  NewDoor("sueden", DORF("herren"),
         ({"suedtuer", "suedliche tuer", /*"tuer 2",*/ "tuer", "tuere"}),
           ({
           D_MSGS, "nach Sueden und schliesst die Tuer hinter sich", 
           D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED,
           D_LONG, "Auf der Tuer im Sueden steht in grossen Lettern "
                   "geschrieben: \"HERREN\"",
           D_GENDER, FEMALE,
           D_SHORT, "",
           D_NAME, "Tuer",
           D_TESTFUNC, "boys",
           D_OPENTESTFUNC, "enter_boys"
           }) );
  NewDoor("westen", DORF("kneipe"),
         ({"westtuer", "westliche tuer", /*"tuer 3",*/ "tuer", "tuere"}),
           ({
           D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED,
           D_LONG, "Die Tuer im Westen fuehrt in die Kneipe zurueck.",
           D_GENDER, FEMALE,
           D_SHORT, "",
           D_NAME, "Tuer",
           }) );
}

reset()
{
  topf=1;
  ::reset();
}

string detailTopf()
{
  if(topf)
    return
      "Ein grosser Topf mit weisser Farbe.\n";
  else
    return "Sowas siehst Du da nicht!\n";
}

string detailEcke()
{
  if(topf)
    return
      "In einer Ecke steht ein grosser Topf mit weisser Farbe.\n";
  else
    return "Alle Ecken schauen fuer Dich gleich aus.\n";	
}

string topf()
{
  if(topf)
    return BS("Dir faellt ausserdem noch auf, dass in einer Ecke ein Farbtopf "
              "herumsteht.");
  else
    return "";
}

int girls()
{
  if(TP->QueryProp(P_GENDER) == MALE) {
    write(BS("Du gehst durch die oestliche Tuer in die Damentoilette. "
             "Wuetend kommt Dir ploetzlich eine aeltere Frau mit Krueckstock "
             "entgegengestuermt, mit welchem sie auch sofort anfaengt, "
             "auf Dich einzupruegeln. Peinlich beruehrt ziehst Du Dich wieder "
             "zurueck und schliesst die Tuer wieder sorgfaeltig."));
    say(BS(TP->Name()+" geht in die Damentoilette, kommt aber nach einigen "
             "Sekunden mit hochrotem Kopf wieder raus."));
    DOORMASTER->SetDoorStatus(DORF("damen"), D_STATUS_CLOSED);
    return 1;
  }
  else {
    write(BS("Du betrittst die Damentoilette und sperrst die Tuer hinter "
             "Dir ab."));
    DOORMASTER->SetDoorStatus(DORF("damen"), D_STATUS_LOCKED);
    return 0;
  }
}

int boys()
{
  if(TP->QueryProp(P_GENDER) == FEMALE) {
    write(BS("Du gehst durch die suedliche Tuer in die Herrentoilette. "
             "Etwas zu spaet bemerkst Du Deinen Irrtum und starrst einen "
             "Troll an. Ein wahrhaft riesiger Bursche. In seinem Gesicht "
             "erblickst Du zuerst Erstaunen, dann Entsetzen. Langsam senkt "
             "sich Dein Kopf, als Du ploetzlich IHN siehst. Entsetzt haeltst "
             "Du inne, schliesst die Augen, stammelst leise irgendetwas "
             "Unverstaendliches vor Dich hin, drehst Dich mit hochrotem Kopf "
             "um und verlaesst auf kuerzestem Weg die Herrentoilette. Hastig "
             "schliesst Du die Tuer wieder hinter Dir."));
    say(BS(TP->Name()+" geht in die Herrentoilette, kommt aber nach einigen "
             "Sekunden mit hochrotem Kopf und staunenden Augen wieder raus."));
    DOORMASTER->SetDoorStatus(DORF("herren"), D_STATUS_CLOSED);
    return 1;
  }
  else {
    write(BS("Du betrittst die Herrentoilette und sperrst die Tuer hinter "
             "Dir ab."));
    DOORMASTER->SetDoorStatus(DORF("herren"), D_STATUS_LOCKED);
    return 0;
  }
}

int enter_girls()
{
  int i;
  object *in, ob;
  if(ob=find_object(DORF("damen"))) {
    in=all_inventory(find_object(DORF("damen")));
    for(i=0; i < sizeof(in); i++) {
      if(query_once_interactive(in[i])) {
        write(BS("Die Toilette ist gerade besetzt! Du solltest wohl besser "
              "warten, bis sie wieder frei ist."));
        tell_room(ob, BS("Draussen ruettelt jemand an der Tuer, bekommt "
              "sie aber nicht auf."), ({}));
        return 1;
      }
      else
        return 0;
    }
  }
}

int enter_boys()
{
  int i;
  object *in, ob;
  if(ob=find_object(DORF("herren"))) {
    in=all_inventory(find_object(DORF("herren")));
    for(i=0; i < sizeof(in); i++) {
      if(query_once_interactive(in[i])) {
        write(BS("Die Toilette ist gerade besetzt! Du solltest wohl besser "
              "warten, bis sie wieder frei ist."));
        tell_room(ob, BS("Draussen ruettelt jemand an der Tuer, bekommt "
              "sie aber nicht auf."), ({}));
        return 1;
      }
      else
        return 0;
    }
  }
}

take( str )
{
  if(str == "topf" || str == "farbtopf" || str == "farbe") {
    if(!topf) {
      write("Siehst Du hier irgendwo einen Farbtopf rumstehen? Ich nicht.\n");
      return 1;
    }
    else if(find_object(DORF("kneipe")) && 
       present("zynra", find_object(DORF("kneipe")))) {
      write("Zynra kommt herein und verpasst Dir eine schallende "
            "Ohrfeige.\nWuetend schreit sie: Lass gefaelligst Deine "
            "schmutzigen Finger von meinen\nWuetend schreit sie: Sachen!\n"
            "Damit wendet sie sich "
            "wieder ab und geht in den Schankraum zurueck.\n");
      say(BS("Zynra kommt herein, verpasst "+TPN+" eine schallende "
            "Ohrfeige und schreit "+TPP(WEN)+" an. Dann wendet sie sich "
            "wieder ab und stapft wuetend in den Schankraum zurueck."));
      TP->reduce_hit_point(10);
      return 1;
    }
    else if(clone_object(OBJ("farbtopf"))->move(TP, M_GET) == ME_TOO_HEAVY) {
      write(BS("Du kannst den Farbtopf nicht mehr tragen."));
      return 1;
    }
    write(BS("Du nimmst den Farbtopf."));
    topf=0;
    return 1;
  }
  return 0;
}
