/*****************************
*  Thor@SilberLand           *
*  Eine Kapelle - kapelle.c  *
*  1997-10-20                *
*****************************/

#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Kapelle" );
  SetProp( P_INT_LONG,
    "Du bist hier in der Kapelle der Xandim. Es herrscht eine "
   +"ehrfurchtgebietende Stille. Die Waende und auch die Decke sind mit "
   +"wunderschoenen Eisskulpturen verziert. In einigen schmalen  Nischen "
   +"stehen sonderbare Kerzen, die in einem kuehlen, blauen Licht brennen. "
   +"Sie verleihen der sonst etwas duester wirkenden Kapelle einen Hauch "
   +"von Uebersinnlichkeit und Magie. Du stehst einfach nur da und geniesst "
   +"die sonderbare, fremdartige Atmosphaere der Kapelle.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -10]) );

  AddDetail( "kapelle",
	     "Du stehst voller Ehrfurcht in der kleinen Kapelle der "
	    +"Xandim.");
  AddDetail( "ehrfurcht",
	     "Die Atmosphaere hier ist auf eine seltsame Art und Weise "
	    +"ehrfurchteinfloessend.");
  AddDetail( ({"art", "weise"}),
	     "Auf irgendeine Art und Weise ist eine ehrfurchtgebietende "
	    +"Atmosphaere hier in der Kapelle.");
  AddDetail( "xandim",
	     "Dieses Volk wohnt hier in diesem Dorf.");
  AddDetail( ({"dorf", "yiqanuc"}),
	     "Du bist in Yiqanuc.");
  AddDetail( ({"volk", "heimat"}),
	     "Dies ist die Heimat der Xandim.");
  AddDetail( "stille",
	     "Man koennte hier eine Stecknadel in den Schnee fallen hoeren.");
  AddDetail( ({"nadel", "stecknadel"}),
	     "Leider hast Du keine bei Dir.");
  AddDetail( ({"schnee", "boden"}),
	     "Der Boden besteht aus festgestampfen Schnee.");
  AddDetail( ({"wand", "waende", "decke"}),
	     "An den Waenden und an der Decke siehst Du wunderschoene "
	    +"Skulpturen, die aus grossen Eisbloecken herausgeschnitzt "
	    +"wurden.");
  AddDetail( ({"eis", "eisbloecke"}),
	     "Das Eis, aus dem die Skulpturen geschnitzt sind, ist glasklar.");
  AddDetail( ({"skulpturen", "eisskulpturen", "skulptur"}),
	     "Die Eisskulpturen sind in sorgfaeltigster Handarbeit "
	    +"entstanden, das ist deutlich an den peinlich genauen "
	    +"Einzelheiten zu erkennen. Sie stellen die Heiligen der Xandim "
	    +"dar und die Goetter des SilberLandes.");
  AddDetail( "heiligen",
             "Die Heiligen der Xandim werden durch die verschiedenen "
            +"Eisskulpturen dargestellt.");	    
  AddDetail( ({"arbeit", "handarbeit"}),
	     "Die Skulpturen wurden wohl in muehsamer Kleinarbeit gefertigt, "
	    +"es sind naemlich sogar die kleinsten Details genau zu "
	    +"erkennen.");
  AddDetail( ({"kleinarbeit", "muehe"}),
	     "Es hat wohl viel Muehe gekostet, diese wunderschoenen "
	    +"Eisskulpturen zu schnitzen.");
  AddDetail( ({"einzelheiten", "detail", "details"}),
	     "Selbst die kleinsten Details sind genauestens "
	    +"herausgearbeitet.");
  AddDetail( ({"heilige", "heiliger"}),
	     "Die meisten Skulpturen stellen Heilige der Xandim dar, die sie "
	    +"vor schlechten Zeiten bewahren sollen.");
  AddDetail( "zeiten",
	     "Das Volk der Xandim erlebte schon viele harte Pruefungen. "
	    +"Immer wieder wurde ihr Dorf ueberfallen und alle paar Jahre von "
	    +"eine ewig wirkenden Kaelteperiode heimgesucht, die viele "
	    +"alte und schwache Xandim dahinraffte.");
  AddDetail( ({"pruefung", "pruefungen", "leben"}),
	     "Die Xandim haben kein leichtes Leben."); 
  AddDetail( ({"periode", "kaelteperiode", "kaelteperioden", "perioden"}),
	     "Alle fuenf bis sechs Jahre wird die Umgebung hier von einer "
	    +"schrecklichen Kaelteperiode heimgesucht. Die Xandim waren "
	    +"zu Beginn noch voellig unvorbereitet darauf und so "
	    +"forderte die Kaelte viele Todesopfer.");
  AddDetail( "umgebung",
	     "Das Dorf und die naehere Umgebung wird immer wieder von "
	    +"eisigen Kaelteperioden heimgesucht.");
  AddDetail( "jahre",
	     "Alle paar Jahre bricht eine schreckliche Kaelteperiode ueber "
	    +"das Dorf herein.");
  AddDetail( "beginn",
	     "Zu Beginn waren die Xandim voellig ueberrascht und daher auch "
	    +"unvorbereitet und dadurch wurden viele von der langen, "
	    +"eisigen Kaelte dahingerafft.");
  AddDetail( "kaelte",
	     "Waehrend der Kaelteperiode ist es etwa vier mal so kalt wie "
	    +"normal.");
  AddDetail( ({"opfer", "todesopfer"}),
	     "In fruehen Jahren wurden viele Xandim Opfer der grausamen "
	    +"Kaelte. Jetzt werden allerdings immer Vorkehrungen getroffen, "
	    +"da die Kaelteperiode immer in den selben Zeitabstaenden "
	    +"hereinbricht.");
  AddDetail( ({"zeitabstaende", "abstaende", "phaenomen", "naturphaenomen"}),
	     "Es ist eben ein unerklaerliches Naturphaenomen."); 
  AddDetail( ({"vorkehrungen", "vorkehrung", "familie", "xandimfamilie"}),
	     "Die Xandim beginnen jetzt schon rechtzeitig Vorraete zu sammeln "
	    +"und versorgen sich mit allerlei waermenden Decken und "
	    +"dergleichen.");
  AddDetail( ({"vorrat", "vorraete", "mittel", "lebensmittel"}),
	     "Jede Xandimfamilie legt einen grossen Vorrat an Lebensmittel "
	    +"an, bevor die Kaelte hereinbricht. Waehrend dieser Zeit ist "
	    +"an eine Jagd naemlich nicht zu denken.");
  AddDetail( "jagd",
	     "Man wuerde dabei wohl erfrieren.");
  AddDetail( ({"decken", "berge", "familien"}),
	     "Es werden immer Berge von Decken angehaeuft, um ganze "
	    +"Familien zu waermen.");
  AddDetail( "goetter",
	     "Die zwei groessten Skulpturen stellen die Goetter des "
	    +"SilberLandes, Woody und Dusty, dar.");
  AddDetail( "woody",
	     "Sonderbar ... irgendwie hast Du ihn Dir immer anders "
	    +"vorgestellt.");
  AddDetail( "dusty",
	     "Sonderbar ... irgendwie hast Du sie Dir immer anders "
	    +"vorgestellt.");
  AddDetail( ({"land", "silberland"}),
	     "Du bist wohl gerade in der kaeltesten Gegend des SilberLandes.");
  AddDetail( "gegend",
	     "Ja, es ist ziemlich kuehl hier.");
  AddDetail( ({"nische", "nischen"}),
	     "In schmalen Nischen stehen sonderbare Kerzen mit einer "
	    +"blaeulichen Flamme, um denen zu gedenken, die von uns "
	    +"gegangen sind.");
  AddDetail( ({"kerzen", "kerze"}),
	     "Die Kerzen brennen nicht so, wie wir es normalerweise "
	    +"gewohnt sind, sondern in einem seltsamen, blauen Licht. "
	    +"Die Flamme scheint auch keinerlei Hitze abzustrahlen.");
  AddDetail( "licht",
	     "Das blaeuliche Licht der Kerzen huellt die Kapelle in eine "
	    +"maerchenhafte Aura.");
  AddDetail( "aura",
	     "Du fuehlst Dich sehr wohl hier.");
  AddDetail( "flamme",
	     "Die Flamme der Kerzen ist ganz blau und strahlt keinerlei "
	    +"Waerme ab.");
  AddDetail( ({"waerme", "hitze"}),
	     "Die Flamme ist absolut kuehl.");
  AddDetail( "hauch",
	     "Das seltsame Licht taucht die Kapelle in eine uebersinnliche, "
	    +"magische Aura.");
  AddDetail( ({"uebersinnlichkeit", "sinnlichkeit", "magie"}),
	     "Es ist nicht nur das Licht, das der Kapelle eine solch magische "
	    +"Aura verleiht. Die ganze Atmosphaere, die Stille ... dies "
	    +"ist mit einem Wort ein Ort des Friedens und der Ruhe.");
  AddDetail( "ort",
	     "Du stehst einfach nur da, und laesst die Atmosphaere auf "
	    +"Dich wirken.");
  AddDetail( "atmosphaere",
	     "In der Kapelle herrscht eine wunderbar friedliche Atmosphaere.");
  AddDetail( ({"frieden", "ruhe"}),
	     "Du bist tief beeindruckt von dem Frieden und der Stille, die an "
	    +"diesem Ort herrschen.");

  AddSound( DEFAULT_SOUND,
    "Es herrschte eine ehrfuerchtige Stille.");
    
  AddSmell( DEFAULT_SMELL,
    "Du saugst die angenehme Aura tief in Dich ein.");

  AddCmd( ({"bete", "bet"}), "bete");

  AddExit( "sueden", DORF("hauptplatz4"));
}


bete() {
  write ("Du kniest nieder und haeltst eine kurze Andacht.\n");
  if (this_player()->QueryProp(P_GHOST))
  {
    say ("Der Geist von "+this_player()->name()+
        " kniet nieder und haelt eine kurze Andacht.\n");
    write ("Eine sehr starke Kraft saugt Dich auf und spuckt Dich wieder "+
      "aus.\nDu spuerst langsam wieder, wie Blut Deinen Koerper von neuem "+
      "durchstroemt.\n");
    say (this_player()->name()+" erscheint ploetzlich wieder in "+
      "koerperlicher Form.\n");
    this_player()->SetProp(P_GHOST,0);
//    this_player()->heal_self(250);
  }
  else
    say (this_player()->name()+" kniet nieder und haelt eine kurze Andacht.\n");
  return 1;
}


