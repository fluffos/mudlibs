*  Thor@SilberLand                 *
*  Der Hauptplatz - hauptplatz3.c  *
*  1998-01-30                      *
***********************************/

#include "../xandim.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Hauptplatz" );
  SetProp( P_INT_LONG,
    "Das ist das noerdliche Winkerl des Dorfhauptplatzes. Auch hier bist Du "
   +"umgeben von regem, froehlichem Treiben. Du siehst jede Menge Xandim "
   +"geschaeftig herumlaufen, die Kinder herumtollen und Erwachsene "
   +"miteinander plaudern. Ein lustiger Anblick irgendwie - diese vielen, "
   +"knuddelig aussehenden Xandim, die durch ihre enorme Groesse und Kraft "
   +"dann aber doch auch ein wenig abschreckend wirken. Links und rechts "
   +"vom Hauptplatz stehen zwei grosse Iglus. Das westliche Iglu kannst Du "
   +"durch eine gelbe Holztuer betreten, der Eingang zum oestlichen scheint "
   +"allerdings wo anders zu sein.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -10]) );

  AddDetail( ({"winkel", "winkerl", "teil", "hauptplatz", "platz", "dorfhauptplatz"}),
	     "Das hier ist das noerdliche Winkerl des Hauptplatzes."); 
  AddDetail( "treiben",
	     "Du siehst einige Xandim hektisch durch die Gegend laufen, "
            +"andere unterhalten sich gemuetlich in kleinen Gruppen und "
            +"es tollen einige Kinder herum. Der Anblick von so vielen "
            +"gutgelaunten Xandim laesst Dich auch gleich ein wenig "
            +"froehlicher werden.");
  AddDetail( "gegend",
	     "Ueberall siehst Du Xandim, die ihren Geschaeften nachgehen.");
  AddDetail( "geschaefte",
	     "Jeder hat irgendwas zu tun.");
  AddDetail( ({"gruppen", "erwachsene"}),
	     "Einige Xandim stehen beisammen und unterhalten sich "
	    +"angeregt.");
  AddDetail( ({"kinder", "xandimkinder"}),
	     "Die Xandimkinder sehen wirklich suess aus. Man koennte sie "
	    +"beinahe fuer grosse, lebendige Teddybaeren halten.");
  AddDetail( "xandim",
	     "Die Xandim sind zu Beginn vielleicht ein etwas seltsamer "
	     "Anblick fuer fremde Augen. Mit ihrem dichten Pelz sehen sie "
	    +"aus, wie knuddlige Wesen, nur durch ihre Groesse und Kraft "
            +"haelt man zu Beginn vielleicht doch etwas mehr Abstand von "
            +"ihnen.");
  AddDetail( ({"beginn","anfang"}),
	     "An den Anblick der Xandim muss man sich am Anfang noch ein "
	    +"wenig gewoehnen.");
  AddDetail( "pelz",
	     "Der dichte Pelz der Xandim gibt ihnen ein knuddeliges "
	    +"Aussehen.");
  AddDetail( "aussehen",
	     "Fuer fremde Augen haben die Xandim zu Beginn vielleicht ein "
	    +"etwas sonderbares Aussehen.");
  AddDetail( ({"groesse", "kraft"}),
	     "Die Xandim sind ein aeusserst grosses und kraeftiges Volk.");
  AddDetail( ({"volk", "dorf", "yiqanuc"}),
	     "Du bist hier in Yiqanuc, dem Dorf der Xandim.");
  AddDetail( ({"wesen", "staunen"}),
	     "Die Xandim sind ein beeindruckender Anblick.");
  AddDetail( "anblick",
	     "Du kannst Deine Augen kaum vom Hauptplatz abwenden.");
  AddDetail( "augen",
	     "Sie sind weit aufgerissen vor Staunen.");
  AddDetail( "abstand",
	     "Durch die enorme Groesse und Kraft der Xandim haelt man zu "
	    +"Beginn lieber etwas mehr Abstand von ihnen, bis man sie etwas "
	    +"naeher kennt.");
  AddDetail( ({"iglus", "iglu"}),
	     "Links und rechts ist der Hauptplatz durch zwei grosse "
	    +"Iglus begrenzt.");
  AddDetail( ({"tuer", "holztuer"}),
	     "Das westliche Iglu hat eine gelbe Holztuer mit einem grossen, "
	    +"schwarzen Posthorn oben. Es scheint sich also um die lokale "
	    +"Postfiliale des Dorfes zu handeln.");
  AddDetail( ({"horn", "posthorn"}),
	     "Das Posthorn auf der Tuer laesst darauf schliessen, das dies "
	    +"das Postgebaeude ist.");
  AddDetail( ({"post", "postfiliale", "gebaeude", "postgebaeude", "filiale"}),
	     "Du kannst die Post im Westen ungehindert betreten.");
  AddDetail( ({"eingang", "eingaeng"}),
	     "Die Eingaenge zum oestlichen Iglu befinden sich auf einer "
	    +"anderen Seite.");
  AddDetail( ({"seite", "seiten"}),
	     "Sieh Dich doch einfach noch ein wenig um.");
  AddDetail( "himmel",
	     "Ueber Dir ist ein strahlen blauer Himmel.");
  AddDetail( "sonne",
	     "Wenn die Sonne nicht scheinen wuerde, waere es wohl noch um "
	    +"vieles kaelter.");
  AddDetail( "boden",
	     "Der Boden ist aus Eis und mit etwas Schnee bedeckt.");
  AddDetail( "eis",
	     "Alles wurde hier aus Eis gemacht.");
  AddDetail( "schnee",
	     "Am Boden liegt ein wenig Schnee herum.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst geschaeftiges Treiben.");
  AddSound( "treiben",
    "Du hoerst geschaeftiges Treiben.");

  AddItem( "/p/service/thor/postcards/obj/postkasten");
  
  AddExit( "suedosten", DORF("hauptplatz4"));
  AddExit( "suedwesten", DORF("hauptplatz2"));
  AddExit( "sueden", DORF("hauptplatz5"));
  AddExit( "norden", DORF("hstrasse5"));
  AddExit( "westen", DORF("post"));
}
