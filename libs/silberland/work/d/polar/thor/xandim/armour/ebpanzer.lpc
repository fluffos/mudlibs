#include "../xandim.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Elfenbeinpanzer");
  SetProp(P_LONG, 
    "Der Elfenbeinpanzer hat ein mattes Weiss. Er ist innen noch mit einer "
    "starken Stahlplatte verstaerkt und ist ausserdem mit einem dicken "
    "Fell gefuettert.");
  SetProp(P_INFO, BS("Der Elfenbeinpanzer bietet sowohl guten Schutz gegen "
    "Hiebe und Schlaege, als auch gegen enorme Kaelte.") );
  SetProp(P_NAME, "Elfenbeinpanzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "elfenbeinpanzer"}) );

  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:10, T_HEAT_PROT:-10 ]) );
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 30);
  SetProp(P_MATERIAL, ([MAT_IVORY:71, MAT_STEEL:9, MAT_FUR:20]));
  SetProp(P_WEIGHT, 2200);
  SetProp(P_VALUE, 1800);
}

