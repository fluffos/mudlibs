inherit "std/armour";

#include "../xandim.h"
#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"muetze", "fellmuetze"}));
  SetProp (P_SHORT, "Eine Fellmuetze");
  SetProp (P_LONG,
    "Eine flauschige Fellmuetze. Sie haelt Deine Ohren bestimmt immer "
    "schoen warm.");
  SetProp (P_NAME, "Fellmuetze");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 200);
  SetProp (P_VALUE, 150);

  SetProp (P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:2, T_HEAT_PROT:-2]));
  SetProp (P_ARMOUR_TYPE, AT_HELMET); 
  SetProp (P_AC, 4);

  SetProp (P_MATERIAL, ([MAT_PELT:100]));
}
