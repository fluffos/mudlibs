*  Stahlverstaerkte Handschuhe - shandschuhe.c  *
*  1999-01-25                                   *
************************************************/

inherit "std/armour";

#include "../xandim.h"
#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"handschuhe", "stahlhandschuhe"}));
  SetProp (P_SHORT, "Stahlverstaerkte Handschuhe");
  SetProp (P_LONG, "Ein Paar Handschuhe aus dickem Pelz, die mit starken "
      "Stahlplatten verstaerkt sind. Sie scheinen einen auesserst guten "
      "Schutz zu bieten.");
  SetProp (P_NAME, "Handschuhe");
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME_ADJ, "stahlverstaerkt");
  SetProp (P_PLURAL, 1);
  SetProp (P_WEIGHT, 450);
  SetProp (P_VALUE, 900);
  SetProp (P_MATERIAL, ([MAT_PELT:60, MAT_STEEL:40]));
  SetProp (P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:5, T_HEAT_PROT:-5 ]) );
  SetProp (P_ARMOUR_TYPE, AT_GLOVE);
  SetProp (P_AC, 8);
}

