inherit "std/armour";

#include "../xandim.h"
#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"kapperl", "eskimo-kapperl"}));
  SetProp (P_SHORT, "Ein Eskimo-Kapperl");
  SetProp (P_LONG,
    "Ein blaues Eskimo-Kapperl mit der roten Eskimo Fahne (oder von manchen "
    "auch Langnese genannt) vorne drauf.");
  AddDetail( "fahne",
	     "Die rote Eskimo Fahne ist vorne auf dem Kapperl abgebildet. In "
            +"der Mitte siehst Du den blauen Eskimo-Schriftzug.");
  AddDetail( "schriftzug",
	     "In grossen, blauen Lettern steht da: ESKIMO");
  SetProp (P_NAME, "Eskimo-Kapperl");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 150);
  SetProp (P_VALUE, 150);

  SetProp (P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:1, T_HEAT_PROT:1]));
  SetProp (P_ARMOUR_TYPE, AT_HELMET); 
  SetProp (P_AC, 1);

  SetProp (P_MATERIAL, ([MAT_COTTON:100]));
}

string _query_info()
{
  string monat;
  monat=ctime()[4..6];
  if (member((["Dec","Jan","Feb"]),monat))
    return "So schmeckt der Winter.\n";
  else if (member((["Jun","Jul","Aug"]),monat))
    return "So schmeckt der Sommer.\n";
  else
    return 0;
}

