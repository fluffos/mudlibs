#include "../xandim.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Fellpanzer");
  SetProp(P_LONG,
      "Ein dicker Panzer, der nur aus weichem, warmen Fell zu bestehen "
      "scheint. Bei genauerer Betrachtung bemerkst Du allerdings Platten aus "
      "Elfenbein, die zur Verstaerkung zwischen den dicken Fellschichten "
      "angebracht wurden.");
  SetProp(P_NAME, "Fellpanzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "fellpanzer"}) );

  AddDetail( "fell",
      "Das Fell ist aeusserst dick und bietet bestimmt einen guten "
      "Schutz vor Kaelte.");
  AddDetail( ({"elfenbein", "bein", "platten", "elfenbeinplatten", "platte",
        "elfenbeinplatte"}),
      "Die Elfenbeinplatten dienen zur Verstaerkung des Panzers, damit er "
      "auch als Ruestung ein wenig taugt.");

  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:16, T_HEAT_PROT:-12 ]) );
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 25);
  SetProp(P_MATERIAL, ([MAT_PELT:70, MAT_IVORY:30]));
  SetProp(P_WEIGHT, 1800);
  SetProp(P_VALUE, 2000);
}

