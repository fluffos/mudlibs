*  Thor@SilberLand                     *
*  Ein Eskimo-Eisverkaeufer - eskimo.c *
*  1998-01-30                          *
***************************************/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../xandim.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Eskimo-Eisverkaeufer");
  SetProp(P_LONG,
    "Vor Dir steht ein kleiner, dicker Eskimo, der froehlich Eislutscher "
   +"verkauft. Er ist in eine dicke Pelzjacke eingepackt und traegt ein "
   +"Eskimo-Kapperl am Kopf.");
  SetProp(P_NAME, "Eskimo");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  AddId(({"verkaeufer", "eskimo", "eisverkaeufer", "eskimo-eisverkaeufer"}));
  set_living_name("eskimo");

  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-15, T_RANGE_MAX:20]) );
  create_default_npc(15);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit eiskalten Haenden", 80, DT_BLUDGEON}));
  SetProp(P_RACE, "Eskimo");
  SetProp(P_SIZE, 160);
  SetProp(P_ALIGN, 180);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
//  SetProp(P_RESISTANCE, ({ DT_ })); 
//  SetProp(P_VULNERABILITY, ({ DT_ }));
//  SetProp( P_RESISTANCE_STRENGTHS, ([DT_MAGIC:0, DT:FIRE:0, DT_SLASH:0]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "schlurft herein");
  SetProp(P_MSGOUT, "schlurft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, ({ "gruebelt vor sich hin.\n",
	                   "sagt: Frag besser die Wachen.\n",
 		           "meint: Tut mir leid, das weiss ich nicht.\n",
	                   "zuckt bedauernd mit den Schultern.\n" }) );

  AddLibrary(NPC("xandim.lib"), 1);
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Eskimo sagt: Nein danke, das brauch ich nicht.\n" }) );

  SetProp(P_SPELLRATE,5);
  AddSpell(2,100,
    "Der Eskimo wirft ein Cornetto nach Dir.\n",
    "Der Eskimo wirft ein Cornetto nach @WEN.\n",
     DT_COLD,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,200,
    "Der Eskimo beisst Dir in die Nase.\n",
    "Der Eskimo beisst @WEN in die Nase.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SUID;
  CLONEME("/p/armour/armour/pelzjacke.lpc");
  command("trage jacke");
  CLONEME(ARMOUR("kapperl"));
  command("trage kapperl");

}

