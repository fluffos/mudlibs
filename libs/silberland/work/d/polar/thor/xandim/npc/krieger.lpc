**********************************/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "../xandim.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Krieger der Xandim");
  SetProp(P_LONG,
      "Vor Dir steht ein wahrer Schrank von einem Xandim. Er wuerdigt Dich "
      "nicht einmal eines Blickes, trotzdem wirst Du das Gefuehl nicht los, "
      "dass ein Teil seiner Aufmerksamkeit Dir gilt. Moeglicherweise sieht "
      "er Dich als Bedrohung fuer die friedlichen Xandim hier im Dorf an. "
      "Es ist wohl besser, wenn Du keine Schwierigkeiten machst.");
  SetProp(P_NAME, "Krieger der Xandim");
  SetProp(P_GENDER, MALE);
  AddId(({"\nxkrieger", "krieger", "xandim", "xandimkrieger"}));

  create_default_npc(22);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit brutalen Faeusten", 150, DT_BLUDGEON}));
//  SetProp(P_MAX_HP, );
//  SetProp(P_BODY, );
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_RACE, "Xandim");
  SetProp(P_SIZE, 240);
  SetProp(P_ALIGN, 150);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
//  SetProp(P_RESISTANCE, ({ DT_ })); 
//  SetProp(P_VULNERABILITY, ({ DT_ }));
  SetProp( P_RESISTANCE_STRENGTHS, ([DT_COLD:-0.5]) );
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-15, T_RANGE_MAX:30]) );

  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT, "stampft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, "/d/polar/thor/xandim/room" );
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, DORF("wachweg14"));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);
        
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "blickt Dich nichteinmal an.\n");

  AddLibrary(NPC("xandim.lib"), 3);
  
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Krieger wuerdigt Dich keines Blickes.\n" }) );

  SetProp(P_SPELLRATE,20);
  AddSpell(5, 250,
    "Der Krieger laesst seine Axt auf Dich niedersausen.\n",
    "Der Krieger laesst seine Axt auf @WEN niedersausen.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(5, 350,
    "Der Krieger bricht Dir ein paar Knochen.\n",
    "Der Krieger bricht @WEN ein paar Knochen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SUID;
  CLONEME(WEAPON("kriegsaxt"));
  command("zuecke axt");
  CLONEME("/p/armour/boots/fellstiefel");
  CLONEME(ARMOUR("ebpanzer"));
  CLONEME("/p/armour/cloak/fellumhang");
  CLONEME(ARMOUR("shandschuhe"));
  command("trage alles");

}

init()
{
  ::init();
  if (TP && TP->id("xandim")) AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

