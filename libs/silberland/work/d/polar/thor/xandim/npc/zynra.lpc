*  Thor@SilberLand              *
*  Zynra, die Wirtin  - zynra.c *
*  1999-01-24                   *
********************************/

inherit "std/npc";
inherit "std/player/moneyhandler";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../xandim.h"

void create()
{
  object ob;
  
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Zynra, die Wirtin");
  SetProp(P_LONG,
      "Zynra ist eine etwas mollige, aeltere Xandim-Dame, deren Fell "
      "schon mit duennen, grauen Straehnen durchzogen ist. Sie blickt "
      "Dich mit einem freundlichen Laecheln an und durch ihre muetterliche "
      "Art wird Dir ganz warm ums Herz.");
  SetProp(P_NAME, "Zynra");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_FOOD, 0);
  SetProp(P_DRINK, 0);
  SetProp(P_ALCOHOL, 0);
  AddId(({"xandim-dame","zynra", "wirtin", "xandim" "NOWIMPY"}));

  AddDetail( "fell",
      "Das Fell der Wirtin ist schon mit einigen grauen Straehnen "
      "durchsetzt.");
  AddDetail( "straehnen",
      "Sie verleihen Zynra eine gewisse Wuerde, die wohl mit dem Alter zu "
      "tun hat.");
  AddDetail( "alter",
      "Zynra ist nicht mehr die Juengste.");
  AddDetail( "augen",
      "Zynra blickt Dich aus grossen, freundlichen Augen erwartungsvoll an.");
  
  create_default_npc(17);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit flinken Haenden", 100, DT_BLUDGEON}));
  SetProp(P_RACE, "Xandim");
  SetProp(P_MAX_HP, 400);
  SetProp(P_XP, QueryProp(P_XP)+100000);
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
//  SetProp(P_RESISTANCE, ({ DT_ })); 
//  SetProp(P_VULNERABILITY, ({ DT_ }));
  SetProp( P_RESISTANCE_STRENGTHS, ([DT_COLD:-0.5]) );
  SetProp(P_NOMAGIC,0);
  
  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo( DEFAULT_INFO, "Willst Du was saufen?", "fragt: ");
  AddLibrary(NPC("xandim.lib"), 1);
  AddInfo( "kneipe", "Gefaellt es Dir hier etwa nicht?", "fragt: ");
  AddInfo( ({"getraenk", "getraenke", "speise", "speisen", "angebot"}), 
      "Mit \"menue\" siehst Du das Angebot hier.", "sagt: ");
  AddInfo( ({"toilette","toiletten","klo","wc"}), "Die Toiletten sind "
      "nebenan.","sagt: ");
  AddInfo( ({"farbe", "topf", "farbtopf"}),
      "Meinst Du den von nebenan? Den bekommst Du nur ueber meine Leiche!",
      "sagt drohend: ");
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Zynra sagt freundlich: Nein danke, ich brauche das nicht, denke "
    "ich.\n" }) );

  SetProp(P_SPELLRATE, 40);

  AddSpell(2,200,
    "Zynra rammt Dir den Ellbogen in die Rippen.\n",
    "Zynra rammt @WEN den Ellbogen in die Rippen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,300,
    "Zynra knuddelt Dich mit dem Krachen brechender Knochen.\n",
    "Zynra knuddelt @WEN mit dem Krachen brechender Knochen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(5,100,
    "Zynra wird ploetzlich noch flinker!\n",
    "Zynra wird ploetzlich noch flinker!\n",
     DT_MAGIC, "spell_speed"); 
  AddSpell(5,250,
    "Zynra zerschmettert eine Flasche auf Deinem Kopf.\n",
    "Zynra zerschmettert eine Flasche auf @WESSEN Kopf.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddMoney(8000);     
}

void heart_beat()
{
  ::heart_beat();
  if(QueryProp(P_HP)<100 && this_object() && QueryMoney()>299) {
    if(QueryProp(P_DRINK)<92)
      command_me("kaufe eiswasser");
    else if(QueryProp(P_FOOD)<90)
      command_me("kaufe eisbaerenbaellchen");
  }
}

void spell_speed(object enemy, int damage, mixed dam_type)
{
   ModifySkillAttribute(ME, SA_SPEED, 100+random(300), 5+random(15));
}
