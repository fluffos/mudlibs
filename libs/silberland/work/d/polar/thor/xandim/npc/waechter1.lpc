inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../xandim.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Xandimwaechter");
  SetProp(P_LONG,
    "Vor Dir steht ein stolzer Xandimwaechter. Er ist selbst fuer einen "
   +"Xandim sehr gross und aeusserst muskuloes gebaut, sofern man das unter "
   +"seinem dichten Pelz und der Ruestung erkennen kann. Er steht reglos da, "
   +"seine Augen wandern jedoch wachsam hin und her. Er beschuetzt das Dorf "
   +"vor unliebsamen Eindringlingen.");
  SetProp(P_NAME, "Xandimwaechter");
  SetProp(P_GENDER, MALE);
  AddId(({"waechter", "xandim", "xandimwaechter"}));
  set_living_name("xandimwaechter");

  create_default_npc(19);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit starken Haenden", 150, DT_BLUDGEON}));
//  SetProp(P_MAX_HP, );
//  SetProp(P_BODY, );
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_RACE, "Xandim");
  SetProp(P_SIZE, 230);
  SetProp(P_ALIGN, 150);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
//  SetProp(P_RESISTANCE, ({ DT_ })); 
//  SetProp(P_VULNERABILITY, ({ DT_ }));
  SetProp( P_RESISTANCE_STRENGTHS, ([DT_MAGIC:0.5]) );
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-25, T_RANGE_MAX:25]) );

  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "blickt stur weiter gerade aus.\n");

  AddInfo( "kerker", "@@kerker@@");
  AddInfo( ({"tuere", "tuer", "falltuer"}), "@@tuer@@");
  AddInfo( "kuulan", "@@kuulan@@");
//  AddInfo( "schluessel", "@@key@@");
  AddInfo( "schluessel",  "@@key2@@");
 
  AddLibrary(NPC("xandim.lib"), 2);
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Xandimwaechter beachtet Dich gar nicht.\n" }) );

  SetProp(P_SPELLRATE,20);
  AddSpell(2, 250,
    "Der Xandimwaechter stuermt auf Dich los.\n",
    "Der Xandimwaechter stuermt auf @WEN los.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 350,
    "Der Xandimwaechter schwingt sein Schwert nach Deinem Kopf.\n",
    "Der Xandimwaechter schwingt sein Schwert nach @WESSEN Kopf.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(10, ({
  "Der Xandimwaechter durchbohrt Dich mit einem giftigen Blick.\n",
  "Der Xandimwaechter verteidigt sich verbissen.\n"}) );

  SUID;
  CLONEME(WEAPON("breitschwert"));
  command("zuecke schwert");
  CLONEME("/p/armour/boots/fellstiefel");
  CLONEME(ARMOUR("ebpanzer"));
  command("trage alles");

}

string kerker()
{
  if(QueryProp(P_XANDIM_KEYGUARD))
    return "sagt: Der Kerker ist hier im Keller.\n";
  else
    return "blickt stur weiter gerade aus.\n";
}

string tuer()
{
  if(QueryProp(P_XANDIM_KEYGUARD))
    return"sagt: Die fuehrt in den Kerker runter.\n";
  else
    return "blickt stur weiter gerade aus.\n";
}

string kuulan()
{
  if(QueryProp(P_XANDIM_KEYGUARD))
    return "sagt: Der sitzt unten, eingeschlossen im Kerker.\n";
  else
    return "blickt stur weiter gerade aus.\n";
}

string key2()
{
  if(QueryProp(P_XANDIM_KEYGUARD))
    return "sagt: Ich habe keinen.\n";
  else
    return "blickt stur weiter gerade aus.\n";
}

string key()
{
  if(!QueryProp(P_XANDIM_KEYGUARD))
    return "blickt stur weiter gerade aus.";

  if(present("\ngeschichte", TP))
    {
    if(!present("\nftkey", TP))
      {
      call_out("geben", 0);
      return "meint: Hier hast Du den Schluessel fuer die Falltuere.\n";
      }
    else
      return "meint: Du hast doch schon einen Schluessel!\n";
    }
  else
    return "meint: Der Schluessel geht Dich ueberhaupt nichts an.\n";
}

geben()
{
  command_me("gib schluessel an "+lower_case(TPN));
}

init()
{
  ::init();
  if (TP && TP->id("waechter")) AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}