*  Thor@SilberLand               *
*  Bagol, der Haendler - bagol.c *
*  1997-12-08                    *
*********************************/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../xandim.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Bagol, der Haendler");
  SetProp(P_LONG,
    "Bagol ist ein alter Xandim, der einen sehr freundlichen Eindruck macht. "
   +"Sein Gesicht ist von tiefen Falten zerfurcht, aus seinen Augen jedoch "
   +"strahlt immer noch eine grosse Lebenslust und eine enorme Weisheit. Er "
   +"ist schon viel herumgekommen in seinem Leben.");
  SetProp(P_NAME, "Bagol");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"bagol", "haendler", "xandim"}));
  set_living_name("bagol");

  create_default_npc(17);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit schwachen Haenden", 100, DT_BLUDGEON}));
  SetProp(P_RACE, "Xandim");
  SetProp(P_SIZE, 210);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_XP, 245000);        // Damit keine Erstkillerpunkte!!
//  SetProp(P_RESISTANCE, ({ DT_ })); 
//  SetProp(P_VULNERABILITY, ({ DT_ }));
//  SetProp( P_RESISTANCE_STRENGTHS, ([DT_MAGIC:0, DT:FIRE:0, DT_SLASH:0]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "humpelt herein");
  SetProp(P_MSGOUT, "humpelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, ({"gruebelt vor sich hin.\n",
	                "sagt: Frag den Buergermeister, der weiss alles.\n",
	                "meint: Tut mir leid, da kann ich Dir nicht helfen.\n",
	                "zuckt gleichgueltig mit den Schultern.\n"}));
  AddInfo(({"haendler", "bagol"}), "Das bin ich!", "sagt: ");
  AddInfo( "waren", "Willst Du was kaufen?", "fragt Dich: ");
  AddInfo( "laden", "Mein ganzer Stolz!", "meint: ");
  AddInfo( ({"regale", "regal"}), "deutet auf die Waende.", "");
  AddInfo( "angebot", "Lies doch einfach mal das Schild hier.", "sagt: ");
  AddInfo( "schild", "Das haengt hier einfach so an der Wand rum.", "sagt: ");
  
  AddLibrary(NPC("xandim.lib"), 1);
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Bagol sagt: Ich KAUFE nur Sachen.\n" }) );

  SetProp(P_SPELLRATE,5);
  AddSpell(2,200,
    "Bagol tritt Dir in den Bauch.\n",
    "Bagon tritt @WEN in den Bauch.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,200,
    "Bagol wirft einen Topf nach Dir.\n",
    "Bagon wirft einen Topf nach @WEN.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetChats(2, ({
  "Bagol fragt Dich: Moechtest Du etwas kaufen?\n",
  "Bagol bietet Dir seine Waren an.\n",
  "Bagol blickt Dich erwartungsvoll an.\n",
  "Bagol legt den Kopf schief.\n"}) );
  SetAttackChats(5, ({
  "Bagol ruft laut nach Hilfe.\n"}) );

}
