inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../xandim.h"

mapping kampf;

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Yrmalaru, der Dorfaelteste");
  SetProp(P_LONG,
      "Yrmalaru ist der Dorfaelteste von Yiqanuc, was eigentlich nicht "
      "schwer zu erraten ist. Der Xandim sieht wirklich uralt aus, sein "
      "Fell ist schneeweiss und er hat eine ziemlich gebueckte Haltung. "
      "Er stuetzt sich auf einen alten Krueckstock und blickt Dich aus weisen, "
      "dunkelblauen Augen an, die tiefer sind, als jeder Bergsee.");
  SetProp(P_NAME, "Yrmalaru");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_INFO, BS("Yrmalaru mag zwar alt und gebrechlich aussehen, in "
                     "einem Zweikampf ist er vermutlich aber noch fuer einige "
                     "Ueberraschungen gut."));
  AddId(({"NOWIMPY", "yrmalaru", "verkaeufer", "aeltester",
          "dorfaeltester", "xandim"}));

  AddDetail( "fell",
    "Durch sein hohes Alter ist sein Fell schneeweiss gefaerbt.");
  AddDetail( "alter",
    "Yrmalaru ist aelter, als Du Dir vermutlich vorstellen kannst.");
  AddDetail( "haltung",
    "Leicht gekruemmt steht er vor Dir.");
  AddDetail( "augen",
    "Yrmalarus Augen strahlen eine unendliche Weisheit und Wissen aus. "
    "Er hat bestimmt schon so einiges gesehen, von dem Du nichteinmal zu "
    "traeumen wagst.");
  
  create_default_npc(25);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit zittrigen Haenden", 170, DT_BLUDGEON}));
  SetAttribute( A_STR, 10);
  SetProp(P_XP, 1000000);
  SetProp(P_RACE, "Xandim");
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, 600);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
//  SetProp(P_RESISTANCE, ({ DT_ })); 
//  SetProp(P_VULNERABILITY, ({ DT_ }));
  SetProp( P_RESISTANCE_STRENGTHS, ([DT_MAGIC:-0.5, DT_FIRE:0.5, 
                                     DT_COLD:-0.5,  DT_HOLY:-0.5,
                                     DT_LIGHT:-0.5, DT_LIGHTNING:-0.5]) );
  SetProp(P_NOMAGIC,20);

  SetProp(P_MSGIN, "humpelt herein");
  SetProp(P_MSGOUT, "humpelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, ({"schuettelt bedauernd den Kopf.\n",
	                "blickt Dich nur traurig an.\n",
	                "sagt: Irgendwo gibt es auf alles eine Antwort.\n"}));

  AddInfo( ({"aeltester", "dorfaeltester","yrmalaru"}), "Das bin ich.", 
      "sagt: ");
  AddInfo( ({"trank", "zaubertrank"}), "Zaubertraenke gibt es an den "
      "verstecktesten und unmoeglichsten Orten.", "laechelt: ");
  AddInfo( ({"portal", "seherportal", "tor", "sehertor"}),
      "Angeblich soll es hier in Yiqanuc eines geben.", "sagt: ");
  AddInfo( "iglu",
      "Dies Iglu ist das aelteste hier im ganzen Dorf. Ich schaetze, daher "
      "passt es sehr gut zu mir.", "laechelt: ");
  AddInfo( ({"farbe", "farbtopf", "pinsel"}),
    "Es tut mir schrecklich leid, aber dabei kann ich Dir leider nicht "
    "helfen.", "meint bedauernd: ");
  AddInfo( ({"kaempfe", "kampf", "kaempfen"}), "Als ich noch jung war, war ich "
    "auch so wie Du und dachte, Kaempfen sei das einzige wahre. Doch auch "
    "Du wirst noch erfahren, dass es wesentlich wichtigere Dinge im Leben "
    "gibt, die sich nicht durch einen Kampf loesen lassen.", "spricht weise: ");
  AddInfo( "laden", "Hier habe ich mich zur Ruhe gesetzt.",
    "meint zufrieden: ");
  AddInfo( ({"ausruestung", "ausruestungsgegenstaende", "gegenstaende"}),
    "Ja, hier kannst Du einiges an Ausruestung kaufen. Du wirst es vielleicht "
    "noch brauchen!", "sagt: ");
  
  AddLibrary(NPC("xandim.lib"), 1);
  
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Yrmalaru sagt laechelnd: Nein danke, das brauche ich in meinem "
    "Alter nicht mehr.\n" }) );

  SetProp(P_SPELLRATE,50);
  AddSpell(3,350,
    "Yrmalaru huellt Dich in einen Schneesturm ein.\n",
    "Yrmalaru huellt @WEN in einen Schneesturm ein.\n",
     DT_COLD,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,300,
    "Yrmalaru blaest Dir einen eiskalten Wind ins Gesicht.\n",
    "Yrmalaru blaest @WEN einen eiskalten Wind ins Gesicht.\n",
     DT_COLD,([SP_SHOW_DAMAGE:1]));
  AddSpell(5,300,
    "Yrmalaru laesst einen Eiszapfen auf Dich niederkrachen.\n",
    "Yrmalaru laesst einen Eiszapfen auf @WEN niederkrachen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));


  SUID;
  CLONEME(ARMOUR("fellpanzer"));
  
  kampf=([]);
}

reset()
{
  kampf=([]);
  ::reset();
}

mixed _query_noattack()
{ 
  if(TP==ME)
    return 0;
  if(!member(kampf, getuid(TP))) {
    tell_room(environment(TP), BS("Yrmalaru murmelt "+TP->name()+
          " schmunzelnd ein paar Worte zu."), ({TP}));
    kampf[getuid(TP)] = 0;
    return ("sagt: Du moechtest wirklich mit mir "
          "kaempfen, Jungchen? Das solltest\nYrmalaru sagt: Du Dir vielleicht "
          "nochmal ueberlegen ... ich bin vielleicht\nYrmalaru sagt: nicht "
          "ganz so harmlos wie ich aussehe ;) ");
  }
  else if (!kampf[getuid(TP)]) {
    tell_object(TP, "Yrmalary ruft: Nun gut, Du wolltest "
          "es nicht anders!\nHinter Dir knallt ploetzlich die Tuer zu. "
          "Du bist gefangen! Jetzt geht es wohl auf Leben und Tod!\n");
    tell_room(environment(TP), "Yrmalary ruft: Nun gut, Du wolltest "
          "es nicht anders!\nDann knallt ploetzlich die Tuer hinter Dir zu.\n",
          ({TP}));
    kampf[getuid(TP)]=1;
  }
  
  if(member(environment(ME)->QueryProp(P_EXITS), "osten")!=-1)
    environment(ME)->RemoveExit("osten");
    
  return 0;
}

heart_beat()
{
  ::heart_beat();
  if(!InFight()) {
    if(!member(environment(ME)->QueryProp(P_EXITS), "osten"))
       environment(ME)->AddExit("osten", DORF("hstrasse6"));
  }
}

Defend(int dam, string dam_type, mixed spell, object enemy)
{
  int reflex, dam2;

  switch(random(40)) {

    case  9 .. 20 : tell_object(enemy, BS("Yrmalaru gelingt es, Deinem "
                        "Angriff zum Teil auszuweichen."));
                    tell_room(environment(enemy), BS("Yrmalaru gelingt es, "
                        "einem Teil von "+enemy->name(WESSEN)+" Angriff "
                        "auszuweichen."), ({enemy}));
                    dam = dam/2;
                    break;

    case 21 .. 29 : tell_object(enemy, BS("Yrmalaru gelingt es, Deinem "
                        "Angriff vollstaendig auszuweichen!"));
                    tell_room(environment(enemy), BS("Yrmalaru gelingt es, "
                        +enemy->name(WESSEN)+" Angriff vollstaendig "
                        "auszuweichen!"), ({enemy}));
                    dam = 0;
                    break;

    case 30 .. 39 : tell_object(enemy, "Yrmalaru schleudert einen Teil "
                        "Deines Angriffs auf Dich zurueck!\n");
                    tell_room(environment(enemy), BS("Yrmalaru schleudert "
                        "einen Teil von "+enemy->name(WESSEN)+" Angriff "
                        "auf "+enemy->QueryPronoun(WEN)+" zurueck."),
                        ({enemy}));
                    dam2 = dam/2 + random(dam/2);
                    enemy->Defend(dam2, dam_type, spell, TO);
                    dam = dam - dam2;
                    break;
    default:        // dam=dam;
  }
  

  if(enemy->QueryProp(P_HP) < 25+random(25) && !enemy->QueryProp(P_GHOST)) {
    ME->AddHp(100);
    tell_room(environment(enemy), BS("Yrmalaru ruft: Ich habe schon genug Blut "
                           "gesehen in meinem Leben! Verschwinde\n"
                           "Yrmalaru ruft: hier und komm "
                           "nie mehr wieder!"), ({}));
    enemy->move(DORF("hstrasse6"), M_GO, "raus", "fliegt in hohem Bogen", 
          "plumpst vor Dir auf den Boden");
    return 0;
  }

  return ::Defend(dam, dam_type, spell, enemy);

}


varargs void die(int poisondeath)
{
  write_file("/d/polar/thor/xandim/log/yrmalaru_kills",
         dtime(time())+": "+CAP(getuid(TP))+" toetet Yrmalaru.\n");
  if ( objectp(QueryProp(P_KILLER)) )
  {
    if ( present("\nzechpreller_quest_11", QueryProp(P_KILLER)) )
      present("\nzechpreller_quest_11", QueryProp(P_KILLER)) -> Mark();
  }
  if(!member(environment(ME)->QueryProp(P_EXITS), "osten"))
    environment(ME)->AddExit("osten", DORF("hstrasse6"));
    
  ::die(poisondeath);
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file("/d/polar/thor/xandim/log/yrmalaru_kills",
         sprintf( ctime()+": Yrmalaru hat gerade "+CAP(getuid(player))
                         +" umgebracht - %d EP!\n", lostexp));
  return ;
}
