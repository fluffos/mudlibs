/*****************************************
*  Thor@SilberLand                       *
*  Ein Weg durch die Berge - bergweg1.c  *
*  1999-05-03                            *
*****************************************/

#include "../berge.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch die Berge" );
  SetProp( P_INT_LONG,
           "Ein schmaler, kaum erkennbarer Pfad fuehrt zwischen den sanften "
           "Schneehuegeln von Nordwesten nach Suedosten. Etwas weiter "
           "entfernt im Suedosten siehst Du auch die ersten schroffen "
           "Felsspitzen der Berge von Kymora. Der Pfad scheint schnurstracks "
           "darauf zuzufuehren."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -10]) );

  AddDetail( ({"pfad", "weg"}),
	    "Der Pfad ist nur mehr als duenne, angedeutete Linie durch den Schnee "
      "erkennbar. Er scheint in letzter Zeit kaum mehr benutzt worden zu "
      "sein ...");
  AddDetail( "linie",
      "Die angedeutete Linie fuehrt geradewegs nach Suedosten, auf die "
      "Felszacken zu.");
  AddDetail( "zeit",
      "Der Hoehe der Neuschneemassen nach zu schliessen, muessen das sicher "
      "einige Wochen gewesen sein.");
  AddDetail( "hoehe",
      "Falls dieser Pfad mal deutlicher sichtbar war, wurde er in den letzten "
      "Wochen wohl kraeftig zugeschneit.");
  AddDetail( ({"woche", "wochen"}),
      "Eine Woche besteht fuer gewoehnlich aus sieben Tagen.");
  AddDetail( ({"tage", "tag"}),
      "Vorausgesetzt natuerlich, dass dies der Gott in Deiner Welt nicht "
      "anders definiert hat.");
  AddDetail( ({"gott", "goetter"}),
      "Wir glauben hier nur an zwei.");
  AddDetail( ({"welt", "welten"}),
      "Es gibt viele Welten ... mehr als Du Dir vorstellen kannst.");
  AddDetail( ({"schnee", "schneemassen", "neuschnee", "neuschneemassen", 
               "massen"}),
      "Soweit das Auge reicht nur Schnee, Schnee und nochmals Schnee.");
  AddDetail( ({"auge", "augen", "aeuglein"}),
      "Ohne Deine schoenen Aeuglein koenntest Du Dir solch wunderschoene "
      "Gegenden, wie dies hier eine ist, gar nicht ankucken.");
  AddDetail( ({"gegend", "gegenden"}),
      "Gefaellts Dir hier? Ja? Das ist schoen.");
  AddDetail( ({"huegel", "schneehuegel"}),
      "Ein Hobbit wuerde sich hier gewaltig wohlfuehlen, sofern ihm die Kaelte "
      "nichts ausmachen wuerde.");
  AddDetail( "kaelte",
      "Selbst die wuerde wohl nicht so schlimm sein, Hobbits haben ja "
      "bekanntlich einen dicken Pelz.");
  AddDetail( "pelz",
      "Du wuenscht Dir auch einen dicken Pelz fuer die Kaelte hier.");
  AddDetail( ({"hobbit", "hobbits"}),
      "Normalerweise haette hier ja ein rassenspezifisches Detail her gehoert, "
      "aber seit es so viele verschiedene Rassen gibt, bin ich zu faul "
      "dazu.");
  AddDetail( ({"detail", "details"}),
      "Gratulation! Du hast eines entdeckt!");
  AddDetail( "gratulation",
      "Jemand schuettelt Dir begeistert die Haende.");
  AddDetail( "jemand",
      "Ein \"Jemand\" ist immer ein Magier, der zu feig ist, um sich sichtbar "
      "zu zeigen, Dummerchen!");
  AddDetail( "magier",
      "Je besser ein Magier idlen kann, umso hoeher ist sein Level.");
  AddDetail( "level",
      "Bist Du etwas levelgeil?");
  AddDetail( ({"haende", "hand"}),
      "Etwas verwirrt betrachtest Du Deine Haende. Sind noch beide da. Gut.");
  AddDetail( "dummerchen",
      "Das hast Du aber schon gewusst, oder?");
  AddDetail( ({"rassen", "rasse"}),
      "Nein, die will ich jetzt nicht alle aufzaehlen. In einem Jahr wuerde "
      "das dann sowieso schon wieder nicht mehr stimmen.");
  AddDetail( "jahr",
      "Ein Jahr besteht im Allgemeinen aus 365 Tagen.");
  AddDetail( ({"allgemeines", "allgemein"}),
      "Jemand klopft Dir aufgrund untersuchens sinnloser Details auf die "
      "Finger.");
  AddDetail( "finger",
      "Du denkst . o O (AUA!)");
  AddDetail( ({"felsen", "fels", "spitzen", "zacken", "felsspitzen",
               "felszacken"}),
      "Dies scheinen wohl die ersten felsigen Auslaeufer der Berge von "
      "Kymora zu sein.");
  AddDetail( "auslaeufer",
      "Der Pfad scheint direkt in sie hinein zu fuehren.");
  AddDetail( "berge",
      "Bis jetzt ist ausser einigen felsigen Zacken und etlichen Gipfeln "
      "in weiter Ferne nichts zu sehen.");
  AddDetail( "gipfel",
      "Suedlich und westlich von Dir siehst zu zahlreiche schroffe Gipfel, "
      "welche selbst von hier unbezwingbar wirken.");
  AddDetail( "ferne",
      "Wozu in die Ferne schweifen, wenn das Gute doch so nah?");
  AddDetail( ({"gutes", "gut", "gute"}),
      "Bloedes Sprichwort ...");
  AddDetail( "sprichwort",
      "Na das eben.");
  AddDetail( "kymora",
      "Woher die Berge wohl diesen Namen haben?");
  AddDetail( "name",
      "Du gruebelst eine Weile vor Dich hin, kommst aber zu keinem "
      "stichhaltigem Schluss.");
  AddDetail( "weile",
      "Die Weile ist schon vorueber, genug gegruebelt. Schliesslich willst "
      "Du ja hier nicht festfrieren, oder?");
  AddDetail( ({"schluss", "ende"}),
      "Aus, Schluss, Ende!");
  AddDetail( "boden",
      "Ausser Schnee kannst Du eigentlich nichts erkennen am Boden.");
  AddDetail( "himmel",
      "Einstweilen scheint noch die Sonne vom Himmel, aber weiter im Sueden "
      "meinst Du, eine Wolkenfront zu erkennen.");
  AddDetail( "sonne",
      "Geniesse sie, solange Du noch kannst.");
  AddDetail( ({"wolken", "wolke", "front", "wolkenfront"}),
      "Die Wolken sehen ziemlich bedrohlich aus.");

  AddSound( DEFAULT_SOUND,
      "Der Wind frischt hier wieder etwas auf und pfeift Dir um die Ohren.");
  AddSound( ({"wind", "pfeifen"}),
      "Noch ist er nicht so schneidend kalt, aber lange kann das wohl nicht "
      "mehr auf sich warten lassen.");
 
  AddCmd( ({"friere", "frier"}), "freeze");
  
  AddExit( "nordwesten", "/d/polar/thor/weg/room/weg21");
  AddExit( "suedosten", ROOM("bergweg2"));
}

freeze( str )
{
  notify_fail("Was willst Du tun?\n");
  if(str=="fest") {
    write(BS("Das hast Du nun davon! Von Deiner ganzen Grueblerei und "
          "Untersucherei bist Du im Schnee festgefroren! Muehsam bueckst "
          "Du Dich zu Deinen Beinen hinunter und eist Dich wieder los."));
    say(CAP_TPN+" ist scheinbar festgefroren und eist sich nun wieder los.\n");
    return 1;
  }
  else
    return 0;
}
