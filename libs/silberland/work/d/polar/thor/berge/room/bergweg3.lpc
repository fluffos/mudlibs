*****************************************/

#include "../berge.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

mapping map;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein verschneiter Abhang" );
  SetProp( P_INT_LONG,
           "Keuchend haeltst Du einen Moment inne. Du haettest nie gedacht, "
           "das ein so unbedeutender Anstieg Dich dermassen erschoepfen "
           "koennte. Du hast wohl die Anstrengung, die man benoetigt, um sich "
           "durch diese tiefen Schneemassen zu kaempfen, voellig "
           "unterschaetzt. Immer noch schnaufend betrachtest Du Deine "
           "Umgebung, ausser einigen schroffen Felszacken kannst Du "
           "allerdings nichts besonderes erkennen."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -15]) );
  SetProp(P_NOREST, 1);
  
  AddDetail( "moment",
	    "Ausruhen! Nur einen Moment lang *keuch*");
  AddDetail( ({"anstieg", "abhang"}),
      "Der Anstieg waere nichtmal so steil, nur der tiefe Schnee saugt Dir "
      "foermlich die Kraft aus den Muskeln.");
  AddDetail( ({"schnee", "massen", "schneemassen"}),
      "Leicht verzweifelt betrachtest Du den immer noch huefthohen Schnee.");
  AddDetail( "kraft",
      "Wenn Du jetzt schon fast am Ende mit Deiner Kraft bist, wie willst Du "
      "den weiteren Weg dann erst noch schaffen?");
  AddDetail( "weg",
      "Du siehst nichts, was die Bezeichnung \"Weg\" verdienen wuerde.");
  AddDetail( "bezeichnung",
      "Das ist wieder bezeichnend fuer Dich, dass Du selbst sowas "
      "untersuchst!");
  AddDetail( "ende",
      "Nur ein bisschen ausrasten! Dann gehts schon wieder ... hoffentlich.");
  AddDetail( ({"muskeln", "muskel"}),
      "Sehr ausdauernd und kraeftig scheinen sie ja nicht zu sein.");
  AddDetail( "anstrengung",
      "Noch hast Du Dich nicht ueberanstrengt, aber das kann schon noch "
      "kommen.");
  AddDetail( ({"umgebung", "gegend"}),
      "Du laesst Deinen Blick durch die Gegend schweifen. Im Norden und "
      "Nordwesten erstrecken sich endlose Schneehuegel unter Dir, Richtung "
      "Sueden und Suedosten wird das Gelaende zunehmend felsiger und "
      "unwegsamer.");
  AddDetail( "blick",
      "Sieh Dich nur gut um.");
  AddDetail( ({"huegel", "schneehuegel"}),
      "Die Huegel sehen fast schon langweilig aus.");
  AddDetail( "gelaende",
      "Es wird zunehmends unfreundlicher.");
  AddDetail( ({"felsen", "fels", "zacken", "felszacken"}),
      "Wie mahnende Finger erheben sie sich gen Himmel.");
  AddDetail( "finger",
      "Ob sie Dich wohl vor etwas warnen wollen?");
  AddDetail( "himmel",
      "Der Himmel ist wolkenverhangen und Du befuerchtest, dass es wohl "
      "bald wieder zu schneien beginnt.");
  AddDetail( ({"wolken", "wolke"}),
      "Die Wolken sehen nicht sehr freundlich aus.");
  AddDetail( "boden",
      "Wie ueblich, voll mit Schnee.");
      
  AddSound( DEFAULT_SOUND,
      "Du hoerst den scharfen, kalten Wind durch die Felsen pfeifen.");
  AddSound( ({"wind", "pfeifen"}),
      "Du lauscht dem Pfeifen des Windes, allerdings wird Dir dadurch nur "
      "noch kaelter, als Dir ohnehin schon ist.");
  
  AddCmd( ({"ruhe", "ruh", "raste", "rast"}), "ruhe");
  
  AddExit( ({"nordwestunten", "nordwesten"}), ROOM("bergweg2"));
  AddExit( ({"osten", "ostoben"}), ROOM("bergweg4"));
  SetProp(P_HIDE_EXITS, ({"osten", "nordwesten"}));

  map=([]);
}

init()
{
  if(!member(map, getuid(TP)))
    map+=([getuid(TP):0;1]);
  map[getuid(TP), 0]=0;
  ::init();
}

reset()
{
  map=([]);
  ::reset();
}

ruhe( str )
{
  if(!str || str=="aus") {
    if(map[getuid(TP)]) {
      write("Du hast Dich doch schon wieder einigermassen erholt.\n");
      return 1;
    }
    write(BS("Erschoepft schliesst Du die Augen und rastest Dich kurz aus. "
          "Jetzt schaffst Du es hoffentlich, das naechste Wegstueck zu "
          "ueberleben."));
    say(CAP_TPN+" rastet sich erschoepft aus.\n");
    TP->do_exhaust( (-100/map[getuid(TP), 1]), 1);
    map[getuid(TP), 0]=1;

    if(map[getuid(TP), 1]>100)
      map[getuid(TP), 1]==100;
    else
      map[getuid(TP), 1]++;

    return 1;
  }
  else
    return 0;
}
