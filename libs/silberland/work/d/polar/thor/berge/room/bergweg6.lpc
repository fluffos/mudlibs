*****************************************/

#include "../berge.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durchs Polar" );
  SetProp( P_INT_LONG,
           "Weite Huegel erstrecken sich zu allen Seiten, welche mit einer "
           "dicken Schneedecke bedeckt sind und hell im Sonnenschein glitzern. "
           "Nur weiter im Sueden siehst Du etwas Abwechslung in der "
           "eintoenigen Landschaft, denn dort tuermt sich ein hohes "
           "Gebirgsmassiv auf, dessen Hoehe Du aber nicht genau bestimmen "
           "kannst, da die Gipfel von dunklen Wolken verhuellt sind."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( "weg",
	    "Der Weg ist zwar nicht wirklich gut erkennbar, aber er scheint von "
      "Sueden nach Nordwesten zu fuehren.");
  AddDetail( "polar",
      "Du stehst mitten drin.");
  AddDetail( ({"huegel", "schneehuegel"}),
      "Die Schneehuegel erstrecken sich soweit das Auge reicht.");
  AddDetail( ({"auge", "augen"}),
      "Du piekst Dir ins Auge, um es zu untersuchen. Aua!");
  AddDetail( ({"seite", "seiten"}),
      "Dazu faellt mir kein originelles Detail ein.");
  AddDetail( "detail",
      "Ich sagte doch, mir faellt keins ein.");
  AddDetail( ({"schnee", "decke", "schneedecke"}),
      "Die ganze Landschaft schlummert unter einer meterdicken Schneedecke.");
  AddDetail( "landschaft",
      "Du denkst . o O (Hoffentlich wird sie nicht erdrueckt von all dem "
      "Schnee)");
  AddDetail( ({"sonne", "sonnenschein", "schein"}),
      "Hier strahlt noch die Sonne vom Himmel, aber weiter im Sueden tuermen "
      "sich die Wolken ueber den Bergen auf.");
  AddDetail( "himmel",
      "Noch ist er schoen blau.");
  AddDetail( ({"wolke", "wolken"}),
      "Duester tuermen sich die Wolken entlang des suedlichen Horizontes auf. "
      "Es waere wohl eine schlechte Idee, die Berge jetzt zu besteigen.");
  AddDetail( "horizont",
      "Der suedliche Horizont ist wolkenverhangen und verheisst nichts gutes.");
  AddDetail( ({"idee", "ideen"}),
      "Du hast wohl nur selten gute Ideen ...");
  AddDetail( ({"berge", "massiv", "gebirgsmassiv", "gebirge"}),
      "Die Berge von Kymora erheben sich etwas weiter im Sueden gen Himmel. "
      "Ihre Gipfel sind von dunklen Wolken verhangen, was ihnen ein "
      "unheimliches und mystisches Aussehen verleiht.");
  AddDetail( "kymora",
      "Du ueberlegst, wieso die Berge wohl so heissen moegen ...");
  AddDetail( ({"gipfel", "hoehe"}),
      "Es ist unmoeglich zu sagen, wie hoch die Gipfel wohl sein moegen. "
      "Es erweckt fast den Eindruck, als wuerden sie den Himmel selbst "
      "beruehren.");
  AddDetail( "eindruck",
      "Verlass Dich nicht immer darauf, was Deine Augen Dir sagen.");
  AddDetail( "aussehen",
      "Erfuellt von Ehrfurcht betrachtest Du die Berge.");
  AddDetail( "ehrfurcht",
      "Manchmal sollte man etwas wie Ehrfurcht schon zeigen koennen.");
  AddDetail( "abwechslung",
      "Viel Abwechslung bietet die Landschaft hier nicht gerade, mal abgesehen "
      "von dem Gebirgsmassiv im Sueden.");
  AddDetail( "boden",
      "Nur Schnee ...");

  AddExit( "nordwesten", "/d/polar/thor/weg/weg25");
  AddExit( "sueden", ROOM("bergweg7"));
}
