*  Thor@SilberLand                       *
*  Ein Weg durch die Berge - bergweg2.c  *
*  1999-05-04                            *
*****************************************/

#include "../berge.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg durch die Berge" );
  SetProp( P_INT_LONG,
           "Muehsam stapfst Du weiter durch den tiefen Neuschnee und "
           "beobachtest, wie sich die kleinen Woelkchen Deines Atems langsam "
           "an der kalten Luft aufloesen. Die Schneehuegel enden hier und "
           "machen einem leichten Abhang Platz, der suedoestlich von Dir "
           "ansteigt. Auf halber Hoehe des Abhangs ragen auch schon die ersten "
           "schroffen Felsen aus dem Schnee heraus, um die Du den Wind pfeifen "
           "hoerst.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );

  AddDetail( ({"schnee", "neuschnee"}),
      "Wacker kaempfst Du Dich durch den huefthohen Neuschnee. Puh, ganz "
      "schoen anstrengend.");
  AddDetail( "woelkchen",
      "Dein heisser Atem verlaesst Deinen Mund in kleinen Woelkchen, welche "
      "sich dann an der kalten Luft aufloesen.");
  AddDetail( "atem",
      "Von der Anstrengung ist er ziemlich warm.");
  AddDetail( "anstrengung",
      "Gar nicht so ohne, sich durch den huefthohen Schnee hier zu kaempfen.");
  AddDetail( "mund",
      "Der ist zum Kuessen da ;)");
  AddDetail( "kuessen",
      "Such Dir doch jemanden, der Dir das zeigt :)");
  AddDetail( "luft",
      "Die Luft ist klar und kalt.");
  AddDetail( ({"huegel", "schneehuegel"}),
      "Die Schneehuegel erstrecken sich weit Richtung Norden und Nordwesten "
      "hin, im Suedosten befindet sich ein verschneiter Abhang.");
  AddDetail( "abhang",
      "Na das kann ja heiter werden, sich da hoch zu kaempfen.");
  AddDetail( "platz",
      "Du koenntest Dir ein gemuetlicheres Plaetzchen vorstellen, als "
      "das hier.");
  AddDetail( "plaetzchen",
      "Die Kneipe in Midas, nur so als Beispiel.");
  AddDetail( "kneipe",
      "Na die Rote Nase meine ich natuerlich.");
  AddDetail( ({"rote", "rot", "nase"}),
      "Deine Nase ist auch schon ganz rot, allerdings nicht vom Alkohol "
      "sondern eher von der Kaelte.");
  AddDetail( "alkohol",
      "Ja, etwas hochprozentiger Alkohol wuerde Dich auch etwas aufwaermen.");
  AddDetail( "kaelte",
      "Brrrrr, viel zu kalt zum untersuchen.");
  AddDetail( "midas",
      "Das ist viel zu weit weg zum untersuchen.");
  AddDetail( "beispiel",
      "Ich habe doch bereits eines angefuehrt.");
  AddDetail( "hoehe",
      "Noch hast Du keine schwindelerregenden Hoehen erreicht.");
  AddDetail( "hoehen",
      "Wenn Du Dich weiterhin Richtung Suedosten haeltst, wirst Du sie "
      "schon noch kennenlernen.");
  AddDetail( ({"felsen", "fels", "zacken", "felszacken"}),
      "Weiter oben im Abhang siehst Du die ersten schroffen Felszacken der "
      "Berge von Kymora in die Hoehe ragen.");
  AddDetail( "berge",
      "Ja, auch im Polar gibt es Berge.");
  AddDetail( "polar",
      "Du betrachtest den Schnee um Dich herum und stellst ueberzeugt fest: "
      "Ja, dies hier muss das Polar sein.");
  AddDetail( "kymora",
      "Du laesst Dir den Namen auf der Zunge zergehen ... er klingt so schoen "
      "geheimnisvoll.");
  AddDetail( "name",
      "Mal sehen, ob er Dir nach gewisser Zeit immer noch gefaellt.");
  AddDetail( "zeit",
      "Die Zeit rinnt Dir durch die Finger.");
  AddDetail( "finger",
      "Seltsam, ist Zeit denn fluessig?");
  AddDetail( "zunge",
      "Nein! Nicht mit Zunge! Das ist eklig und gehoert sich nicht!");
  AddDetail( "wind",
      "Der Wind frischt hier bereits kraeftig auf, und weiter oben am Abhang "
      "hoerst Du ihn laut zwischen den Felsen hindurch pfeifen.");
  AddDetail( "boden",
      "Nur Schnee, Schnee und nochmal Schnee.");
  AddDetail( "himmel",
      "Die Sonne beginnt schon wieder, sich hinter einzelnen Wolken zu "
      "verstecken.");
  AddDetail( "sonne",
      "Es ist kaum mehr etwas zu sehen von ihr.");
  AddDetail( ({"wolke", "wolken"}),
      "Die Wolken ziehen sich langsam ueber Deinem Kopf zusammen.");
  AddDetail( "kopf",
      "Pass auf, dass Dir nicht der Himmel auf den Kopf faellt.");
  
  AddSound( DEFAULT_SOUND,
      "Du hoerst das laute Pfeifen des Windes weiter im Suedosten.");
  AddSound( ({"wind", "pfeifen"}),
      "Du schauderst im Gedanken an den eiskalten, schneidenden Wind.");
  
  AddExit( "nordwesten", ROOM("bergweg1"));
  AddExit( ({"suedosten", "suedostoben"}), ROOM("bergweg3"));
  SetProp(P_HIDE_EXITS, ({"suedosten"}));
}
