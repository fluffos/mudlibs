#include "../berge.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein verschneiter Abhang" );
  SetProp( P_INT_LONG,
           "Diesmal hast Du Dir Deine Kraefte etwas besser eingeteilt und "
           "stehst nun noch etwas schnell atmend auf einem felsigen, "
           "verschneiten Hochplateau. Der Wind ist hier oben wesentlich "
           "staerker und kaelter, als weiter unten. Eiskalt schneidet er "
           "Dir ins Gesicht und scheint sogar noch durch Deine (hoffentlich) "
           "warme Kleidung durchzublasen."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -25]) );

  AddDetail( ({"kraefte", "kraft"}),
	    "Langsam lernst Du, Dir Deine Kraefte einzuteilen.");
  AddDetail( ({"plateau", "hochplateau"}),
      "Es scheint hier wieder etwas flacher zu werden, ganz sicher bist Du "
      "Dir da allerdings nicht, da sich hinter jedem Felsen schon wieder ein "
      "Anstieg befinden koennte.");
  AddDetail( "anstieg",
      "Theoretisch zumindest ...");
  AddDetail( ({"felsen", "fels"}),
      "Nach allen Seiten hin erheben sich hohe, schroffe Felsen, welche "
      "durch den ewigen Wind glattgeschliffen wurden. Keiner macht auch nur "
      "annaehernd den Eindruck, als koennte man daran hochklettern.");
  AddDetail( ({"seiten", "seite"}),
      "Norden, Osten, Sueden, Westen.");
  AddDetail( "wind",
      "Eiskalt blaest der Wind durch und durch, durch Deine Kleidung, durch "
      "Deine Haut, durch Deine Knochen. So erscheint es Dir jedenfalls, denn "
      "Du frierst erbaermlich.");
  AddDetail( "kleidung",
      "Du hoffst, dass sie warm genug ist, und Du hier oben nicht jaemmerlich "
      "erfrieren musst.");
  AddDetail( "haut",
      "An manchen Stellen ist sie bestimmt schon ganz blau.");
  AddDetail( ({"stellen", "stelle"}),
      "Schau besser nicht nach, sonst wird Deine Haut nur noch blauer, wenn "
      "sie direkt dem eiskalten Wind ausgesetzt ist.");
  AddDetail( "knochen",
      "Du hoffst innigst, dass Du keine schlimmen Erfrierungen davontragst.");
  AddDetail( ({"erfrierung", "erfrierungen"}),
      "Erfrierungen sind keine schoene Angelegenheit ...");
  AddDetail( "angelegenheit",
      "Misch Dich nie in fremde ein!");
  AddDetail( "eindruck",
      "Du bist Dir sicher, dass der Eindruck diesmal nicht taeuscht.");
  AddDetail( "gesicht",
      "Du sparst Dir das kontrollierende Abtasten Deines Gesichts, da Deine "
      "Finger sowieso schon taub sind vor lauter Kaelte.");
  AddDetail( "finger",
      "Die spuerst Du schon kaum mehr.");
  AddDetail( "kaelte",
      "Besorgt blickst Du an den schroffen Felszinnen, die man in einiger "
      "Entfernung sieht, hoch, und fragst Dich verzweifelt, wie kalt es dort "
      "oben wohl sein mag.");
  AddDetail( ({"zinnen", "felszinnen", "zinne", "felszinne", "gipfel"}),
      "Du bist Dir alles andere als sicher, ob Du da wirklich hinauf willst.");
  AddDetail( "entfernung",
      "Die hohen Gipfel der Berge von Kymora sind noch ein einiger Entfernung, "
      "doch Du betrachtest sie selbst von hier schon mit Ehrfurcht und vor "
      "allem Angst.");
  AddDetail( "angst",
      "Du versuchst, sie abzuschuetteln, es gelingt Dir jedoch nicht ganz.");
  AddDetail( "ehrfurcht",
      "Ein solch maechtiges Gebirge versetzt einen immer in eine gewisse "
      "Ehrfurcht.");
  AddDetail( ({"berge", "auslaeufer", "gebirge"}),
      "Dies hier sind erst einige Auslaeufer der Berge von Kymora. Wie werden "
      "die Bedingungen dann erst in den hoeher gelegenen Regionen sein? Du "
      "wagst gar nicht, daran zu denken.");
  AddDetail( ({"regionen", "region"}),
      "Eine sehr unfreundliche Region ist das hier.");
  AddDetail( "kymora",
      "Was ist wohl das Geheimnis dieser Berge?");
  AddDetail( "geheimnis",
      "Du bist Dir beinahe sicher, dass irgendwo hier ein Geheimnis "
      "verborgen ist.");
  AddDetail( ({"bedingung", "bedingungen"}),
      "Seufzend betrachtest Du die Schneemassen und Felsen um Dich herum.");
  AddDetail( ({"schnee", "massen", "schneemassen"}),
      "Immer noch geht Dir der Schnee bis zu den Hueften.");
  AddDetail( ({"hueften", "huefte"}),
      "Mann, sind die sexy ;)");
  AddDetail( "boden",
      "Wegen dem vielen Schnee kannst Du den Boden nicht erkennen.");
  AddDetail( "himmel",
      "Der Himmel ist ueber und ueber mit dunklen Wolken bedeckt, die "
      "nichts gutes verheissen.");
 AddDetail( ({"wolken", "wolke"}),
     "Misstrauisch kuckst Du zu ihnen hoch, allerdings wird sie das wohl auch "
     "nicht vertreiben.");
      
  AddSound( DEFAULT_SOUND,
      "Du hoerst das schrille Pfeifen des Windes um die Felsen.");
  AddSound( ({"wind", "pfeifen"}),
      "Kein sehr aufbauendes Geraeusch ...");
 
  AddCmd( ({"kletter", "klettere"}), "climb");
  
  AddExit( ({"westunten", "westen"}), ROOM("bergweg3"));
  AddExit( "osten", ROOM("bergweg5"));
  SetProp(P_HIDE_EXITS, ({"westen"}));
}

climb( str )
{
  notify_fail("Wo willst Du hochklettern?\n");
  if(str=="felsen hoch"||str=="felsen"||str=="felsen rauf") {
    write(BS("Du unterziehst die Felsen einem pruefenden Blick und kommst "
          "zu dem Schluss, dass Du Dir nur wehtun koenntest dabei."));
    say(BS(CAP_TPN+" sieht sich die Felsen etwas genauer an, gibt einen "
        "etwaigen Kletterversuch aber sogleich wieder auf."));
    return 1;
  }
  else
    return 0;
}
