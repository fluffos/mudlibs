*  Thor@SilberLand                           *
*  Eine verschneite Landschaft - bergweg7.c  *
*  1999-07-05                                *
*********************************************/

#include "../berge.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
 
  ::create();

  SetProp( P_INT_SHORT, "Eine verschneite Landschaft" );
  SetProp( P_INT_LONG, BS(
        "Wacker kaempfst Du Dich weiter durch die huefthohen Schneemassen. "
        "Dein Atem steigt in kleinen, weissen Dampfwoelkchen dem blauen Himmel "
        "entgegen, auf dem zunehmends mehr Wolken zu sehen sind. Die "
        "Berggipfel, welche sich suedlich von Dir auftuermen, sind in dichte "
        "Wolken gehuellt und lassen daher ihre tatsaechliche Hoehe nur "
        "erahnen. Es waere wohl ein aeusserst leichtsinniges Unterfangen, den "
        "Versuch zu wagen, die Berge von Kymora kurz vor einem drohenden "
        "Unwetter zu besteigen."));
  SetProp( P_LIGHT, 1 ); 
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_ARCTIC, ENV_TEMPERATURE: -10]) );
  
  
  AddDetail( ({"landschaft", "land"}),
      "Die Landschaft ist von einer dicken Schneedecke bedeckt.");
  AddDetail( ({"schnee", "schneedecke", "decke", "schneemassen", 
               "schneemasse"}),
      "Langsam beginnst Du den Schnee zu verfluchen. Durch ihn gestaltet sich "
      "Dein Vorwaertskommen naemlich erheblich muehsamer als auf "
      "herkoemmlichen Terrain.");
  AddDetail( "vorwaertskommen",
      "Unermuedlich stellst Du einen Fuss vor den anderen.");
  AddDetail( ({"fuss", "fuesse"}),
      "Deine Fuesse frieren ganz erbaermlich.");
  AddDetail( "terrain",
      "Sehr unwegsam isses hier, ja.");
  AddDetail( "atem",
      "Keuchend stapfst Du weiter durch den Schnee und Dein Atem gefriert, "
      "sobald er Deinen Mund verlassen hat.");
  AddDetail( "mund",
      "Deine Lippen nehmen langsam eine leicht blaeuliche Faerbung durch die "
      "vorherrschende Kaelte hier an.");
  AddDetail( ({"lippe", "lippen"}),
      "Sie bibbern.");
  AddDetail( "faerbung",
      "Rosig-Blau waer wohl die passenste Bezeichnung dafuer.");
  AddDetail( ({"rosigblau", "rosig-blau"}),
      "Fuer ein Dunkelblau reicht es leider noch nicht.");
  AddDetail( "dunkelblau",
      "Das kommt vermutlich schon noch, wenn Du weiter nach Sueden in die "
      "Berge gehst.");
  AddDetail( "bezeichnung",
      "Menno, musst Du denn wirklich alles untersuchen?");
  AddDetail( "menno",
      "Menno ist kein Hauptwort! Sowas untersucht man nicht!");
  AddDetail( ({"hauptwort", "wort", "hauptworte", "worte", "hauptwoerter",
               "woerter"}),
      "Ein braver Spieler untersucht nur Hauptworte. Dann hat der Magier nicht "
      "so viel Arbeit mit Details schreiben. Punkt.");
  AddDetail( "spieler",
      "Anscheinend bist Du kein braver Spieler ...");
  AddDetail( "magier",
      "Magier sind meistens ziemlich faul, weisst Du?");
  AddDetail( "arbeit",
      "Davon machst Du mir gerade ziemlich viel.");
  AddDetail( ({"details", "detail"}),
      "Stur untersuchst Du jedes einzelne davon.");
  AddDetail( "punkt",
      ".");
  AddDetail( "kaelte",
      "Brrr, ist das kalt hier.");
  AddDetail( ({"woelkchen", "dampfwoelkchen"}),
      "Langsam steigen sie gen Himmel und loesen sich nach einer Weile in der "
      "kalten Polarluft auf.");
  AddDetail( "weile",
      "Naja, so lange, wie ne Weile halt normalerweise dauert.");
  AddDetail( ({"luft", "polarluft"}),
      "Klar und kalt haengt sie ueber dem ganzen Land.");
  AddDetail( "himmel",
      "Einige Wolken schieben sich langsam vor den blauen Himmel.");
  AddDetail( ({"wolken", "wolke"}),
      "Noch sehen sie nicht bedrohlich aus, wenn Du allerdings weiter nach "
      "Sueden zu den sich auftuermenden Wolkenmassen blickst, scheint wohl ein "
      "Unwetter im Anmarsch zu sein.");
  AddDetail( ({"wolkenmassen", "wolkenmasse"}),
      "Die Wolkenmassen verhuellen die Gipfel der Berge von Kymora, welche "
      "sich suedlich von Dir gen Himmel recken.");
  AddDetail( "unwetter",
      "Bei einem drohenden Unwetter ist es nicht gerade ratsam, die Berge "
      "zu erklimmen.");
  AddDetail( ({"massen", "masse"}),
      "Welche Massen meinst Du denn? Die Schneemassen oder die Wolkenmassen?");
  AddDetail( "anmarsch",
      "Wenn hier ein Unwetter im Anmarsch ist, marschierst Du ihm wohl besser "
      "schnell davon.");
  AddDetail( ({"gipfel", "berggipfel"}),
      "Die Berggipfel sind in dichte Wolken gehuellt und verstaerken dadurch "
      "noch den Eindruck des Geheimnisvollen, der ueber den Bergen von "
      "Kymora haengt.");
  AddDetail( "eindruck",
      "Du wirst den Eindruck nicht los, dass sich hier in diesen Bergen ein "
      "Geheimnis verbirgt.");
  AddDetail( "geheimnis",
      "Du glaubst wirklich, dass Du es lueften kannst? Viel Glueck ...");
  AddDetail( "glueck",
      "Du wirst es brauchen.");
  AddDetail( ({"berge", "berg", "gebirge"}),
      "Still und starr tuermen sich die Berge von Kymora suedlich von Dir "
      "auf. Du wirst allerdings das Gefuehl nicht los, dass diese Stille nur "
      "die Ruhe vor dem Sturm ist.");
  AddDetail( "kymora",
      "Der Name ist Dir bis jetzt ein Raetsel geblieben.");
  AddDetail( "name",
      "Vielleicht findest Du einmal mehr ueber ihn heraus.");
  AddDetail( "gefuehl",
      "Wie eine Zecke sitzt es Dir im Nacken.");
  AddDetail( ({"zecke", "zecken"}),
      "Sehr anhaengliche Tierchen.");
  AddDetail( "tierchen",
      "Davon gibt es selbst hier einige.");
  AddDetail( ({"nacken", "nackenhaare"}),
      "Deine Nackenhaare straeuben sich. Und das nicht nur wegen der Kaelte.");
  AddDetail( "stille",
      "Unheimlich ...");
  AddDetail( "ruhe",
      "Noch ist es ruhig ...");
  AddDetail( "sturm",
      "Hm. Vermutlich bist Du nur etwas paranoid.");
  AddDetail( "raetsel",
      "Gruebel nicht zu viel daran herum, das macht nur graue Haare.");
  AddDetail( "haare",
      "Naja, aber immerhin wuerden sie Dir einen Touch von Weisheit geben :)");
  AddDetail( ({"touch", "weisheit"}),
      "Sowas kommt immer gut.");
  AddDetail( "hoehe",
      "Du hast keine Ahnung, wie hoch die Berge hier wohl sein moegen. Um das "
      "herauszufinden, musst Du sie schon besteigen.");
  AddDetail( "ahnung",
      "Wann hast Du denn ueberhaupt eine?");
  AddDetail( "unterfangen",
      "Lass es lieber bleiben.");
  AddDetail( "versuch",
      "Vermutlich wird er scheitern ...");
  AddDetail( "boden",
      "Der Boden ist unter diesen Schneemassen gewiss nicht mehr zu sehen.");
  
  AddCmd( ({"verfluche", "verfluch"}), "curse");

  AddExit( "norden", ROOM("bergweg6"));
  AddExit( "sueden", ROOM("bergweg8"));
}

curse( str )
{
  notify_fail("Was willst Du verfluchen?\n");
  if(str=="schnee") {
    write(BS("Laut schmetterst Du dem Schnee die schlimmsten Flueche entgegen, "
             "die Du jemals in Deinem Leben gehoert hast. Ja, jetzt fuehlst Du "
             "Dich besser."));
    say(BS(CAP_TPN+" schmettert dem Schnee die schlimmsten Flueche entgegen, "
             "die Du jemals gehoert hast, und die sogar Dich erroeten "
             "lassen."));
    return 1;
  }
  else
    return 0;
}
    
