// Christmas - Creations
// Kleidung
 

inherit "std/armour";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein hellblaues Kleidchen");
  SetProp(P_LONG, 
    "Ein huebsches, hellblaues Kleidchen. Es ist bodenlang und hat um die "
    "Taille eine huebsche weisse Schleife gebunden. Ausserdem hat es noch "
    "kleine Puffaermel und rueschige Saeume.");
  SetProp(P_NAME, "Kleidchen");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"kleidchen","kleid","hellblaues kleidchen"}) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 200);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]));
  SetProp(P_LIGHT, 0);
  SetProp(P_NAME_ADJ, "hellblau");
  SetProp(P_ARTICLE, 1);
  
}  
   
