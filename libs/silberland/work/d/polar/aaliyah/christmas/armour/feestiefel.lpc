inherit "std/armour";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Weisse Stiefel");
  SetProp(P_LONG, 
    "Weisse, hautenge Stiefelchen mit einem leichten Absatz.");
  SetProp(P_NAME, "Stiefel");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"stiefel","weisse stiefel","stiefelchen"}) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 700);
  SetProp(P_PLURAL, 1);
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]));
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]));
  SetProp(P_LIGHT, 0);
  SetProp(P_NAME_ADJ, "weiss");
  AddAdjective( ({"weiss", "weisse","weissen"}) );
    SetProp(P_ARTICLE, 1);
  
}  
   
