inherit "std/armour";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>

void create()

 {
 if (!is_clone(TO)) return;

 ::create ();

 SetProp(P_SHORT, "Ein dicker Wollpullover" );
 SetProp(P_LONG, "Ein dicker Wollpullover in allen moeglichen Blautoenen.");
 SetProp(P_INFO, "Der Wollpullover versetzt Dich in Kuschelstimmung.");
 SetProp(P_NAME, "Wollpullover");
 SetProp(P_GENDER, MALE);
 AddId( ({"wollpullover","pullover","pulli"}) );
 SetProp(P_WEIGHT, 500);
 SetProp(P_VALUE, 2500);
 SetProp(P_NOSELL, 0);
 SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
 SetProp(P_AC, 10);
 SetProp(P_MATERIAL, ([MAT_COTTON:100]));
 SetProp(P_NAME_ADJ, "dick");
 SetProp(P_ARTICLE, 1);
 SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:4, T_HEAT_PROT:0]));

}

