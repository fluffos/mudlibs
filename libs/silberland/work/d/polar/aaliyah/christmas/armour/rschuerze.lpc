inherit "std/armour";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>

void create()

{
if (!is_clone(TO)) return;

::create ();

SetProp(P_SHORT, "Ein weisse Rueschenschuerze" );
SetProp(P_LONG, "Eine weisse Schuerze, die mit vielen Stickereien verziert "
		"wurde. Sie hat an den Saeumen viele Rueschen.");
SetProp(P_INFO, "Die Rueschenschuerze macht Dich weiblich.");
SetProp(P_NAME, "Rueschenschuerze");
SetProp(P_GENDER, FEMALE);
AddId( ({"rueschenschuerze","schuerze","weisse schuerze"}));
SetProp(P_WEIGHT, 100);
SetProp(P_VALUE, 50);
SetProp(P_NOSELL, 0);
SetProp(P_ARMOUR_TYPE, AT_MISC);
SetProp(P_AC, 0);
SetProp(P_MATERIAL, ([MAT_COTTON:100]));
SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER:FEMALE]));
SetProp(P_NAME_ADJ, "weiss");
SetProp(P_ARTICLE, 1);

}


   
