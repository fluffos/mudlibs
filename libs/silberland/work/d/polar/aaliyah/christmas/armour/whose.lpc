inherit "std/armour";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>

void create()

{
if (!is_clone(TO)) return;

::create ();

SetProp(P_SHORT, "Eine rote Samthose" );
SetProp(P_LONG, "Eine einfache rote Samthose. An den Saeumen besteht sie aus "
	       "weissem, flauschigen Material.");
SetProp(P_INFO, "Die Samthose gehoert dem Weihnachtsmann.");
SetProp(P_NAME, "Samthose");
SetProp(P_GENDER, FEMALE);
AddId( ({"samthose","hose"}));
SetProp(P_WEIGHT, 800);
SetProp(P_VALUE, 100000);
SetProp(P_NOSELL, 1);
SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
SetProp(P_AC, 4);
SetProp(P_MATERIAL, ([MAT_VELVET:100]));
SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER:MALE]));
SetProp(P_NAME_ADJ, "rot");
SetProp(P_ARTICLE, 1);

}


   
