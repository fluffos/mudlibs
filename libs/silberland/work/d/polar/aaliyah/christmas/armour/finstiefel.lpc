// 26.10.2005
// 
// Christmas Kollektion

inherit "std/armour";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Weisse Stiefel");
  SetProp(P_LONG, 
    "Einfache kleine, weisse Lederstiefel. Sie reichen bis knapp ueber die "
    "Knie und sind sicher gut fuer den Wald. Schliesslich schuetzen sie "
    "aufgrund ihrer Hoehe vor laestigen Schlangenbissen oder stacheligen "
    "Pflanzen.");
  SetProp(P_NAME, "Stiefel");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"weisse stiefel","schuhe","stiefel"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 2200);
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  AddAdjective( ({"weiss", "weisse","weissen"}) );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + ([DT_POISON:3]) );
  SetProp(P_MAGIC, 2);
  SetProp(P_NAME_ADJ, "weiss");
  SetProp(P_PLURAL, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );

  
  
}  
   
