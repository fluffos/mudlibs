inherit "std/armour";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>

void create()

{
if (!is_clone(TO)) return;

::create ();

 SetProp(P_SHORT, "Eine Latzhose" );
 SetProp(P_LONG, "Eine bequeme Latzhose mit zwei Seitentaschen.");
 SetProp(P_INFO, "Die Latzhose laesst Dich schneller kaempfen.");
 SetProp(P_NAME, "Latzhose");
 SetProp(P_GENDER, FEMALE);
 AddId( ({"latzhose","hose"}));
 SetProp(P_WEIGHT, 1500);
 SetProp(P_VALUE, 5000);
 SetProp(P_NOSELL, 0);
 SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
 SetProp(P_AC, 6);
 SetProp(P_MATERIAL, ([MAT_COTTON:100]));
 SetProp(P_ARTICLE, 1);

 AddDetail( ({"seitentaschen","taschen"}),
     "Zwei Seitentaschen, die Stauraum fuer Kleinkram bieten.");



}


