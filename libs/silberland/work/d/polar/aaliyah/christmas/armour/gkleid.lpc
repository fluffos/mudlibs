// Kleidung
 

inherit "std/armour";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein gruenes Kleidchen");
  SetProp(P_LONG, 
    "Ein einfaches, gruenes Kleidchen mit Rueschen und Puffaermeln. Es "
    "reicht bis knapp ueber das Knie und sieht sehr putzig aus.");
  SetProp(P_NAME, "Kleidchen");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"kleidchen","kleid","gruenes kleidchen"}) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 7300);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_WEAR_RESTRICTIONS, ([P_RACE: "Fee"]));
  SetProp(P_LIGHT, 0);
  SetProp(P_NAME_ADJ, "gruen");
  SetProp(P_ARTICLE, 1);
  
}  
   
