// 
// Christmas Creations - Ein festliches Kleid

inherit "std/armour";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein festliches Kleid");
  SetProp(P_LONG, 
    "Dieses Kleid besteht fast voellig aus weinrotem Samt. Es ist bodenlang "
    "und hat ein Korsett zum Schnueren. Die langen Aermel sind glockenfoermig "
    "und haben an den Saeumen kleine Perlen aufgenaeht.");
  SetProp(P_NAME, "Kleid");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"kleid","festliches kleid"}) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 850);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 15);
  SetProp(P_NAME_ADJ, "festlich");
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, ([MAT_VELVET:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
}  
   
