inherit "std/armour";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>

void create()

{
if (!is_clone(TO)) return;

::create ();

SetProp(P_SHORT, "Ein dickes Paar Wollsocken" );
SetProp(P_LONG, "Ein dickes Paar Wollsocken. Sie wurden aus blaumelierter Wolle "
	       "gestrickt und sind im Winter sicher angenehm warm.");
SetProp(P_INFO, "Die Wollsocken waermen kalte Fuesse im nu.");
SetProp(P_NAME, "Paar Wollsocken");
SetProp(P_GENDER, NEUTER);
AddId( ({"socken","wollsocken"}) );
SetProp(P_WEIGHT, 50);
SetProp(P_VALUE, 100);
SetProp(P_NOSELL, 0);
SetProp(P_ARMOUR_TYPE, AT_MISC);
SetProp(P_AC, 0);
SetProp(P_MATERIAL, ([MAT_COTTON:100]));
SetProp(P_NAME_ADJ, "dick");
SetProp(P_ARTICLE, 1);
SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:2, T_HEAT_PROT:0]));

}

   
