inherit "std/armour";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine weisse Schleife");
  SetProp(P_LONG, 
    "Eine huebsche, weisse Haarschleife. Damit sieht ein Maedchen so "
    "richtig suess aus.");
  SetProp(P_NAME, "Schleife");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"weisse schleife","schleife"}) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 200);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]));
  SetProp(P_LIGHT, 0);
  SetProp(P_NAME_ADJ, "weiss");
  SetProp(P_ARTICLE, 1);
  
}  
   
