// Christmas - Kollektion

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein flauschiger Bademantel");
  SetProp(P_LONG, 
    "Flauschig weiss und sicherlich angenehm warm schaut dieser Bademantel "
    "aus. Er ist bodenlang und hat zwei Taschen an den Seiten.");
  SetProp(P_NAME, "Bademantel");
  SetProp(P_GENDER, MALE); 
  AddId( ({"bademantel","mantel"}) );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 2);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ, "flauschig");

  AddCmd( ({ "kuschel", "kuschle" }), "c_kuscheln");
 }
             int c_kuscheln(string str)
{
   notify_fail(BS("Worein magst Du Dich denn kuscheln?"));
   if( member( ({ "mich in mantel","mich in bademantel",
		  "in mantel" }),str) == -1)
   {
     return 0;
   }
   write(BS("Du kuschelst Dich gluecklich in den flauschigen Bademantel "
	    "und fuehlst Dich gluecklich. Er ist so wunderbar weich und "
	    "es ist total angenehm so etwas Weiches auf der Haut zu fuehlen."));
	  	  
   tell_room(ENV(TP), TPN+" kuschelt sich gluecklich in einen Bademantel.\n", ({TP}));
   
   return 1;
  }


   
