// Christmas Creations

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Neongelbe Turnschuhe");
  SetProp(P_LONG, 
    "Ein Paar neongelbe Turnschuhe. Sowas hast Du vorher noch nie gesehen. "
    "Sowas wuerdest Du auch niemals anziehen. Die Farbe ist einfach "
    "grauenvoll.");
  SetProp(P_INFO, "Die neongelben Turnschuhe zieht nur Martin an.");
  SetProp(P_NAME, "Turnschuhe");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"schuhe","turnschuhe"}) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 500);
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_NAME_ADJ, "neongelb");
  SetProp(P_PLURAL, 1);
  SetProp( P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:1, T_HEAT_PROT:1]) );
  SetProp(P_ARTICLE, 0);
}  
   
