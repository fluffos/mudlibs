inherit "std/armour";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>

void create()

{
if (!is_clone(TO)) return;

::create ();

SetProp(P_SHORT, "Ein roter Weihnachtsmantel" );
SetProp(P_LONG, "Ein roter Mantel aus weichem Samt. Die Saeume bestehen aus "
		"weissem, flauschigen Material und auch die Aermel sind an den "
		"Enden mit demselben benaeht.");
SetProp(P_INFO, "Der Weihnachtsmantel gehoert dem Weihnachtsmann.");
SetProp(P_NAME, "Weihnachtsmantel");
SetProp(P_GENDER, MALE);
AddId( ({"weihnachtsmantel","mantel"}));
SetProp(P_WEIGHT, 2500);
SetProp(P_VALUE, 50000);
SetProp(P_NOSELL, 1);
SetProp(P_ARMOUR_TYPE, AT_CLOAK);
SetProp(P_AC, 6);
SetProp(P_MATERIAL, ([MAT_VELVET:100]));
SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER:MALE]));
SetProp(P_NAME_ADJ, "rot");
SetProp(P_ARTICLE, 1);

}


   
