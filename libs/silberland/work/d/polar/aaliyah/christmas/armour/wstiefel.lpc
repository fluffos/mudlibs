// 5.10.2005
// 
// Christmas Kollektion

inherit "std/armour";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Die Stiefel des Weihnachtsmannes");
  SetProp(P_LONG, 
    "Die Stiefel gehoeren dem Weihnachtsmann. Sie bestehen aus feinem "
    "Leder und haben eine dicke Sohle. Innen sind sie mit Schafswolle "
    "gefuettert, sodass die Fuesse im Schnee nicht frieren muessen.");
  SetProp(P_NAME, "Stiefel des Weihnachtsmannes");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"stiefel des weihnachtsmannes","stiefel"}) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 1200);
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + ([DT_COLD:1]) );
  SetProp(P_MAGIC, 2);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: MALE]) );

  
  
}  
   
