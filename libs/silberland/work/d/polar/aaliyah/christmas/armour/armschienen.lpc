// 27.11.2005
// by Aaliyah
// 
// Mystische Armschienen
// 
inherit "std/armour";
#include "../def.h"
#include <combat.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Mystische Armschienen");
  SetProp(P_LONG, 
    "Diese Armschienen passen sich perfekt an Deinen Koerper an. Sie sind "
    "strahlend weiss. Ein Muster in Form einer Sternenkonstellation "
    "schimmert hellgelb.");
  SetProp(P_NAME, "Armschienen");
  SetProp(P_PLURAL, 1);
  SetProp(P_INFO, "Mystische Armschienen schuetzen vor Magie.\n"
		  "Mystische Armschienen erhoehen Deine Magie.\n"
		  "Mystische Armschienen erhoehen Deine Ausdauer.");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"armschienen","mystische armschienen"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 3000);
  SetProp(P_ARMOUR_TYPE, AT_BRACERS);
  SetProp(P_NAME_ADJ, "mystisch");
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, ([MAT_MAGIC:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_M_ATTR_MOD, ([A_STR:1]) );
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:2, T_HEAT_PROT:2]) );
  SetProp( P_WEAR_RESTRICTIONS, ( [P_LEVEL: 50 ]));
  SetProp(P_QUALITY_DECAY, 150 + random(50));
  SetProp(P_MAGIC, 5);
  SetProp(P_M_HEALTH_MOD, ([P_HP:10, P_SP:10]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + ([DT_MAGIC:1]) );

  AddDetail( ({"muster","form"}),
   "Das Muster hat die Form einer Sternenkonstellation.");

  AddDetail( ({"sternenkonstellation","konstellation"}),
   "Die Sternenkonstellation erinnert Dich an den grossen Anvar, die kleine "
   "Ayla, den kleinen Zechus, den grossen Kronang und den grossen Xarfai.");

  AddDetail( ({"zechus"}),
   "Ja! So ist die Sternenkonstellation halt. Der Silbermond steht hier im "
   "kleinen Zechus.");
   
  AddDetail( ({"ayla"}),
   "Die kleine Ayla steht hier direkt in der Venus.");

  AddDetail( ({"xarfai"}),
   "Der grosse Xarfai steht direkt im Mars. Auweia.");

  AddDetail( ({"anvar"}),
   "Der grosse Anvar steht im Saturn.");

  AddDetail( ({"kronang"}),
   "Der grosse Kronang steht im Neptun.");

  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void _set_autoloadobj(mixed data)
{
  SetProp(P_ITEMD_TMPMAGIC, data);
}

mixed _query_autoloadobj()
{
  return QueryProp(P_ITEMD_TMPMAGIC);


}  
   
