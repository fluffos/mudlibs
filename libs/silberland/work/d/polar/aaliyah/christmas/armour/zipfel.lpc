inherit "std/armour";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>

void create()

{
if (!is_clone(TO)) return;

::create ();

SetProp(P_SHORT, "Eine rote Zipfelmuetze" );
SetProp(P_LONG, "Eine rote Zipfelmuetze mit einem weissen, flauschigen Saum.");
SetProp(P_INFO, "Diese Zipfelmuetze steht jedem gut!");
SetProp(P_NAME, "Zipfelmuetze");
SetProp(P_GENDER, FEMALE);
AddId( ({"zipfelmuetze","muetze"}));
SetProp(P_WEIGHT, 100);
SetProp(P_VALUE, 5000);
SetProp(P_NOSELL, 1);
SetProp(P_ARMOUR_TYPE, AT_HELMET);
SetProp(P_AC, 2);
SetProp(P_MATERIAL, ([MAT_VELVET:100]));
SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER:MALE]));
SetProp(P_NAME_ADJ, "rot");
SetProp(P_ARTICLE, 1);

}


   
