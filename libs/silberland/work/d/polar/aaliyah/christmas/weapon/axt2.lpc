// von Aaliyah
// 13.5.2005
// 
// Mithrilaxt

inherit "std/weapon";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine Mithrilaxt");
  SetProp(P_LONG, 
    "Diese Axt besteht aus Mithril. Ihr scharfes Axtblatt bohrt sich leicht "
    "in das Fleisch der Gegner. Viele kleine Widerhaken befinden sich darauf "
    "und garantieren somit eine tiefe und schmerzhafte Verletzung des "
    "Gegenuebers. Der Axtgriff hat eine geschwungene Form und gewaehrleistet "
    "somit hohen Komfort beim Kampf.");
  SetProp(P_NAME, "Mithrilaxt");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"axt","mithrilaxt"}) );
  SetProp(P_WEIGHT, 3000);
  SetProp(P_VALUE, 4250);
  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_WC, 260);
  SetProp(P_WC_FIX, 20);
  SetProp(P_MATERIAL, ([MAT_MITHRIL:100]));
  SetProp(P_NR_HANDS, 2);
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 120);
  SetProp(P_QUALITY_DECAY, 250);
  SetProp(P_DAM_TYPE, ({DT_RIP, DT_BLUDGEON, DT_SLASH}));
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER:1, A_DEX:25, A_STR:30]) );
  SetProp(P_MAGIC, 0);
  SetProp(P_WC_BONUS, (["estefania": 45]) );
}  

 
