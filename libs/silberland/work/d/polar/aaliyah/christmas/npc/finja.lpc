inherit "std/mnpc";

#include "../def.h"

void init()
{ 
  ::init();


 if ( TP->name() == "Estefania"&& find_call_out("estefania")==-1)
   call_out("estefania", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);

 if ( TP->name() == "Arion"&& find_call_out("arion")==-1)
   call_out("arion", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);

 if ( TP->name() == "Der Weihnachtsmann"&& find_call_out("weihnachtsmann")==-1)
   call_out("weihnachtsmann", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);

  
 if ( TP->name() == "Aaliyah"&& find_call_out("aaliyah")==-1)
   call_out("aaliyah", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);
}
 void hallo()

{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&& !InFight())
    tell_room(MENV, "Finja sagt: Hallo! Ich bin Finja und wer bist Du?\n");
}
 




void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Finja, das kleine Feenmaedchen");
  SetProp(P_LONG, 
	"Finja ist ein kleines, suesses Feenkind. Sie ist acht Jahre alt und "
	"ist fuer ihr Alter schon sehr klug. Sie hat kinnlange, teichgruene "
	"Haare und veilchenblaue, grosse Augen. Sie ist ein sehr zartes "
	"Geschoepf und hat ein freundliches Gemuet. Sie ist etwa 30 cm gross "
	"und laechelt Dich freundlich an.");
  SetProp(P_NAME, "Finja");
  SetProp(P_GENDER, FEMALE); 
  AddId("finja");
  create_default_npc(4);
  SetProp(P_HANDS, ({"ihren kleinen Haenden ",30,DT_BLUDGEON}));
  SetProp(P_RACE, "Fee");
  SetProp(P_SIZE, 30);
  SetProp(P_WEIGHT, 9000);
  SetProp(P_MATERIAL, MAT_FLESH);
  SetProp(P_ALIGN, 1000);
  SetProp(P_ARTICLE, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_MSGIN, "flattert froehlich herein");
  SetProp(P_MSGOUT, "flattert froehlich davon");
  SetProp(P_MMSGIN, "flattert froehlich herein");
  SetProp(P_MMSGOUT, "flattert froehlich davon");
  SetProp(P_NOATTACK, "steht unter dem Schutz des Weihnachtsmannes.");
  SetProp(P_MNPC_AREA, ROOM  );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "werkstatt" );
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
  SetProp(P_MNPC_WAIT, ({ 30, 40, 50}) );
  SetChats(1, ({"Finja flattert um Dich herum.\n"}));
  SetProp(P_DIE_MSG, " bricht erbaermlich zusammen.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_MSG, "Tut mir leid, aber ich muss mich ja wehren!");
  SetProp(P_MURDER_MSG, "Hast Du denn ueberhaupt kein Herz?");  
  AddInfo(DEFAULT_INFO, "ist noch zu jung, um dass zu wissen.\n");

  SetProp( P_REJECT, ({REJECT_KEEP, "sagt: Danke Dir vielmals!\n" }));


  AddInfo( ({"mutter","mama","mami"}), 
    "Meine Mami ist Estefania.", "sagt laechelnd: ");

  AddInfo( ({"feenkoenigin"}), 
    "Die wollte mich nicht.", "seufzt: ");

  AddInfo( ({"weihnachtsmann","papi"}), 
    "Der Weihnachtsmann ist mein Papi.", "sagt stolz: ");

  AddInfo( ({"martin"}), 
    "Martin ist ein netter Zwerg. Er wohnt auch hier.", "sagt laechelnd: ");

  AddInfo( ({"arion"}), 
    "Arion finde ich total suess. Den werde ich heiraten, wenn ich einmal "
    "gross bin.", "kichert: ");

  AddInfo( ({"athenia","schwester"}), 
    "Athenia ist meine Schwester.", "sagt laechelnd: ");

  AddInfo( ({"elijah"}), 
    "Der Wichtel ist ja noch kleiner als ich! Hihi!", "sagt: ");

  AddInfo( ({"thalyah"}), 
    "Mit Thalyah spiele ich immer.", "sagt: ");

  AddInfo( ({"weihnachten","fest"}), 
    "Hach! Weihnachten ist das Fest der Liebe. Da kommt das Christkind und "
    "beschenkt uns.", "strahlt: ");
  
  
  AddInfo( ({"christkind"}), 
    "Das Christkind ist die Schwester des Weihnachtsmannes. Sie ist "
    "leider nicht immer hier, aber wenn sie hier ist, bringt sie uns immer "
    "was Schoenes mit.", "strahlt: ");

  
  AddInfo( ({"liebe","sex"}), 
    "Hey! Ich bin acht Jahre alt! Woher soll ich wissen, was das ist? "
    "Wieso fragst Du mich ueberhaupt sowas?", "sagt empoert: ");
  
  
   
 SUID;
    CLONEME(ARMOUR "finstiefel.lpc" );
    CLONEME(ARMOUR "gkleid.lpc" );
    CLONEME(ARMOUR "gschleife.lpc");
    command("trage alles");
    CLONEME( "/players/aaliyah/1001nacht/obj/puppe.lpc" );
  

}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react") != -1)
   return;

  switch(gruppe)
    {
   case "fies":
     call_out ("react", 0, "blickt Dich verunsichert an.",
	       "blickt "+TP->Name(WEN)+ "verunsichert an.");
     break;

   case "aergerlich":
     call_out("react", 0, "beisst Dir in den Arm.",
	      "beisst "+TP->Name(WEM)+" in den Arm.");
     break;

   case "frech":
     call_out("react", 0, "sagt: Lass mich, ich tu Dir nichts.",
	      "blickt "+TP->Name(WEN)+" scheu an.");
     break;
   
    default:
      call_out("react", 0, "weicht vor Dir zurueck.",
	       "weicht vor Dir zurueck.");
     break;
  }

}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));

    } 

 }
   void estefania()
{
  if (TP && MENV && present(TP, MENV))
  {
    write("Finja begruesst Dich.\n");
    tell_room(MENV, "Finja sagt: Hallo Mami! Ist das Essen schon fertig?\n",
		    ({TP}));
  }
}
      void arion()
{
  if (TP && MENV && present(TP, MENV))
  {
    write("Finja begruesst Dich.\n");
    tell_room(MENV, "Finja flattert auf Arions Schulter und kuesst seine "
		    "Wange.\n",
		    ({TP}));
  }
}
      void weihnachtsmann()
{
  if (TP && MENV && present(TP, MENV))
  {
    write("Finja begruesst Dich.\n");
    tell_room(MENV, "Finja begruesst den Weihnachtsmann froehlich.\n",
		    ({TP}));
  }
}

      void aaliyah()
{
  if (TP && MENV && present(TP, MENV))
  {
    write("Finja umarmt Dich liebevoll.\n");
    tell_room(MENV, "Finja umarmt Aaliyah liebevoll.\n",
		    ({TP}));
  }
}

   string* _query_chats()
{
  
  if (!environment())
    return 0;
  switch(explode(file_name(environment()),"/")[4])  // auf 5 aendern, wenn in region wasser
  {
    case "werkstatt":
      return ({ "Finja bemalt eine Puppe.\n",
                "Finja zieht einer Puppe ein Puppenkleid an.\n",
                "Finja klebt der Puppe Wimpern auf.\n",
                "Finja sagt: Athenia und ich sind fuer die Puppen zustaendig.\n",
                "Finja naeht Puppenhaare auf den Plastikkopf.\n",
		"Finja formt eine Puppenhand aus weichem Plastik.\n",
		"Finja sagt: Dieses Puppenmaterial gibt es nur hier.\n",
                }) + Query(P_CHATS);
    case "vorraum":
      return ({ "Finja flirrt vergnuegt durch Deine Beine.\n",
                "Finja zuendet eine Fackel an.\n",
                "Finja setzt sich kurz auf Deine Schulter.\n",
                 }) + Query(P_CHATS);
    case "bad":
      return ({ "Finja nimmt ein Bad im Waschbecken.\n",
                "Finja fragt: Hast Du schon gesehen, was im Kaestchen ist?\n",
                "Finja buerstet sich ihre teichgruenen Haare.\n",
                "Finja putzt sich die Zaehne.\n",
                "Finja sagt: Hygiene muss sein!\n",
                "Finja steckt sich eine Haarstraene hinter ihr Ohr.\n",
                "Finja laechelt Dich mit ihren blitzendweissen Zaehnen an.\n",
                "Finja pustet eine Haarstraene aus ihrem Gesicht.\n",
		"Finja guckt in den Spiegel.\n",
		"Finja sagt: Wenn ich mal gross bin, bin ich eine Prinzessin.\n",
                }) + Query(P_CHATS);
   
    case "wkueche":
      return ({ "Finja sagt: Hallo Mami, ich hab so Hunger!\n",
                "Finja nimmt sich ein Keks vom Teller.\n",
                "Finja nascht ein bisschen an der Suppe.\n",
                "Finja setzt sich auf den Tisch.\n",
                "Finja sagt: Ich mag vom Braten kosten!\n",
                "Finja setzt sich auf ein Regal.\n",
                "Finja knabbert hungrig an einem Keks.\n",
                "Finja zupft Dich am Bein.\n",
                "Finja kitzelt Dich am Kinn.\n",
                "Finja trinkt ein Glas Milch.\n"
                "Finja sagt: Ich bin so froh, dass ich hier wohne!\n",
                "Finja huepft froehlich um Dich herum.\n",
                "Finjas Magen knurrt.\n",
                }) + Query(P_CHATS);
    case "wzimmer":
      return ({ "Finja kuschelt sich auf das Sofa.\n",
                "Finja guckt das Buch an und runzelt die Stirn.\n",
                "Finja sagt: Der Weihnachtsmann kennt alle Bewohner.\n",
                "Finja kuschelt sich an den Weihnachtsmann.\n"
                "Finja setzt sich auf den Kaminsims.\n",
                "Finja huepft ueber ein paar Stufen hinauf.\n",
                "Finja begutachtet die Weihnachtsstruempfe.\n",
		"Finja sagt: Ha! Einer ist auch fuer mich dabei!.\n",
                }) + Query(P_CHATS);
    case "schlafz":
      return ({ "Finja legt sich auf ihr Bett und schliesst die Augen.\n",
                "Finja kuschelt sich in ihr Bett.\n",
                "Finja zieht sich etwas anderes an.\n",
                "Finja schreibt etwas in ihr Tagebuch.\n",
                "Finja guckt sich um, ob niemand hersieht.\n"
                "Finja versteckt schnell ihr Tagebuch.\n",
                "Finja pustet eine Haarstraene aus ihrem Gesicht.\n",
                }) + Query(P_CHATS);
    case "vorgarten":
      return ({ "Finja flattert zu den Rehen.\n",
                "Finja nimmt etwas Futter.\n",
                "Finja fuettert die Tiere.\n",
                "Finja flattert auf einen Baum und haengt etwas Futter hin.\n"
                "Finja sagt: Dieses Futter ist fuer die Voegel.\n",
                "Finja zittert am ganzen Koerper vor lauter Kaelte.\n",
                "Finja sagt: *Brrrrr* Kalt ist es hier!\n",
                "Finja fragt Dich: Gehen wir ins Haus hinein?\n",
                "Finja fragt Dich: Kannst Du die Tuer oeffnen bitte?\n",
                "Finjas Lippen sind vor Kaelte schon ganz blau.\n",
                "Finja spielt mit ein paar Schneeflocken.\n",
                "Finja wirft einen kleinen Schneeball nach Dir.\n",
                }) + Query(P_CHATS);
    default: return Query(P_CHATS);
  }
}
