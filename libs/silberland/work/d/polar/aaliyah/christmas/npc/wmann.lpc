// 21.10.2005
// Christmas - Creations
// by Aaliyah

//Santa Claus

inherit "std/mnpc";
#include "../def.h"
#include "/d/astral/lamuerte/brunnen/npc/sprachfluch.h"


void init()
{
  ::init();
  if (find_call_out("hallo") != -1)  
  call_out("hallo",0);
}

void hallo()
{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&& !InFight() &&
  !TP->QueryProp(P_INVIS)) 
    tell_room(MENV, "Der Weihnachtsmann sagt: Sei Willkommen!\n");
}
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Weihnachtsmann");
  SetProp(P_LONG,
    "Das ist der Weihnachtsmann! Tatsaechlich es gibt ihn wirklich. Es ist ein "
    "grosser, etwas dicklicher Mann mit langen, schlohweissen Haaren und "
    "grossen rehbraunen Augen. Er strahlt irgendwie Gemuetlichkeit, Guete und "
    "Froehlichkeit aus und scheint froh zu sein, dass Du da bist. Ein langer, "
    "weisser Bart umschmeichelt seine laechelnden Lippen.");
    
  SetProp(P_NAME, ({"Der Weihnachtsmann",
                  "Des Weihnachtsmannes", 
                  "Dem Weihnachtsmann",
                  "Den Weihnachtsmann"}));
                  
  SetProp(P_GENDER, MALE);
  AddId(({"weihnachtsmann", "mann"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("weihnachtsmann");

  create_default_npc(90, 1000000);
  SetProp(P_HANDS, ({" mit seinen alten Haenden",400,DT_LIGHTNING}));
  SetProp(P_RACE, "Weihnachtsmann");
  SetProp(P_SIZE, 190);
  SetProp(P_WEIGHT, 98000);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_MNPC_AREA, ROOM  );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "wzimmer" );
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
  SetProp(P_MNPC_WAIT, ({ 60, 45, 25}) );
  SetChats(1, ({"Der Weihnachtsmann laechelt Dich freundlich an.\n"}));
   
 
  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      -1.0, DT_WATER:  -1.0, DT_AIR:   -1.0, 
      DT_LIGHTNING: -1.0, DT_EXPLOSION: -1.0, DT_SOUND:  -1.0, DT_LIGHT:  -1.0,
      DT_ELECTRIC:  -1.0, DT_ACID:      -1.0, DT_POISON: -1.0, DT_TERROR: -1.0,
      DT_HOLY:      -1.0, DT_UNHOLY:    -1.0, DT_MAGIC:  -1.0, DT_MIND:   -1.0,
      DT_PIERCE: -1.0, DT_SLASH: -1.0,  DT_BLUDGEON: -1.0]) );

  SetProp(P_MSGIN, "betritt den Raum");
  SetProp(P_MSGOUT, "geht laechelnd");
  SetProp(P_MMSGIN, "entsteht aus goettlichem Licht");
  SetProp(P_MMSGOUT, "verschwindet in goettlichem Licht");
  SetProp(P_DIE_MSG,  " verschwindet vor Deinen Augen.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_NAME, "Der Weihnachtsmann");
  SetProp(P_KILL_MSG, "Hoooohohooooooo");
   SetProp(P_NOATTACK, "sagt: Hohohoo, fuer Dich gibt es heuer kein Geschenk.");

  AddInfo(DEFAULT_INFO, "sagt: Ich werde schon alt.");
  
  AddInfo( ({"yara"}), 
    "Yara ist ein suesses Magierfeechen das sehr gute Dienste leistet. Sie "
    "ist wirklich hilfsbereit und kann sehr gut erklaeren. Als ich geboren "
    "wurde, fuehlte ich mich von ihr leicht gestreichelt.","sagt laechelnd: ");
  
  AddInfo( ({"zidane"}),
    "Zidane ist ein junger Zwerg. Er kaempft sehr gerne im Brunnen und ist "
    "zu den Menschen, die er gerne hat sehr lieb. Er ist grosszuegig und "
    "hilfsbereit.","sagt: ");

  
  AddInfo( ({"rage"}), 
     "Der Sonnenscheingockel ist immer hoeflich und freundlich. Obwohl er "
     "staendig auf der Suche nach Koernern ist, schafft er es, trotzdem "
     "seine Arbeit zu erfuellen. Er ist wirklich ein netter Kerl und "
     "aber auch sehr genau.","sagt: ");
  
  
  AddInfo( ({"andronicus"}),
     "Andronicus ist ein gepfleger Zwergenmann. Er hilft vor allem gerne "
     "Frauen und da ist er auch sehr geduldig. Ausserdem soll er auch noch "
     "sehr witzig und orginell sein.","erzaehlt: ");
  
  AddInfo( ({"rambo"}),
     "Rambo ist ein Zwergenkaempfer. Fuer seine Freunde riskiert er schon "
     "mal sein Leben. Er wird von vielen gemocht und ist sehr lieb. Auch "
     "soll er noch sehr selbstbewusst sein.","sagt: ");
  
  AddInfo( ({"turgon"}),
     "Turgon ist ein sehr kluger Eisdruide. Er versucht immer zu helfen, "
     "wird nie unhoeflich und ist jedem freundlich gesinnt.","sagt: ");
  
  AddInfo( ({"zargyl"}),
     "Zargyl, der finstere Nekromant ist eigentlich nicht so finster wie "
     "man denken koennte. Er ist immerzu hoeflich und hilft gerne.","sagt: ");

  AddInfo( ({"woody"}),
     "Woody ist immer im Stress! Wenn er nicht gerade an wichtigen Dingen "
     "arbeitet, dann plaudert er gerne mit netten Menschen. Er ist ein "
     "lieber Kerl. Nein! Dem Woody fehlt nichts.","sagt: ");
  
  
  AddInfo( ({"lovetah"}), 
     "Lovetah ist ein netter Zwergenmann, der sich gerne duscht. Er ist "
     "immerzu freundlich und hat ein sehr sonniges Gemuet.","sagt: ");
  
  AddInfo( ({"sorcain"}), 
     "Sorcain ist ein suesser, kleiner Nachwuchsdruide, der stets hilft "
     "wenn Hilfe benoetigt wird. Er ist meistens im Besitz von "
     "Didoheschriftrollen, die er auch immer verschickt wenn jemand "
     "eine braucht.","sagt: ");

  AddInfo( ({"lilea"}), 
     "Lilea ist ein kleines Magiermaedchen mit einem sehr sehr grossem "
     "Herz aus Gold.","sagt: ");

  AddInfo( ({"aradia"}), 
     "Von Aradia darf ich Dir leider nichts erzaehlen. Aaliyah hat es mir "
     "strikt verboten.","sagt: ");

  AddInfo( ({"aaliyah"}), 
     "Ich werde doch nichts ueber meine Informantin verraten!","sagt: ");

  AddInfo( ({"protheg"}), 
     "Protheg hat nur gute Eigenschaften. Wenn ich Dir die anfange "
     "aufzuzaehlen, werde ich heute nicht mehr fertig. Aber soviel kann "
     "ich Dir sagen, er ist ruhig, cool und locker.","sagt: ");

  
  AddInfo( ({"norelle"}), 
     "Norelle ist eine liebe Elfin, die sich schwer tut den Seherstatus zu "
     "erreichen. Das kommt davon, weil sie dauernd plaudert anstatt sich "
     "in Kaempfen zu beweisen. Sie hat es aber auch schwer. Da sie so nett "
     "ist, reden gerne viele Leute mit ihr.","sagt: ");
  
  
  AddInfo( ({"humply"}),
     "Humply ist einer, der grossen Ogern. Er ist stets freundlich und "
     "verteidigt seine Freunde.","sagt: ");
  
  AddInfo( ({"feyaria"}),
     "Feyaria ist die Berserkermama. Sie ist sehr muetterlich und versucht "
     "den Silberlandbewohnern ein schoenes Land zu bieten. Sie hoert sich "
     "die Probleme der Leute an und versucht zu helfen, wo sie kann. Sie "
     "ist ausserdem das geduldigste Wesen im Silberland.","lacht: ");
  
  AddInfo( ({"hactar"}),
     "Hactar ist eine Elfee. Sowas gibts nur einmal im Silberland. Er ist "
     "sehr nett und hilft bis in die fruehen Morgenstunden, wenn er die Zeit "
     "dafuer hat. Er wird nie ungut und ist nie gemein.","sagt laechelnd: ");
  
  AddInfo( ({"geschenk","geschenke","weihnachtsgeschenke","weihnachtsgeschenk"}),
     "Wenn Du brav bist, bekommst Du zu Weihnachten auch ein Geschenk. "
     "Wenn Du nicht brav bist, dann gibt es vom Krampus Haue.","sagt: ");
  
  AddInfo( ({"krampus"}),
     "Der Krampus hat eine grosse Peitsche und verhaut die Leute gerne","sagt: ");
  
  AddInfo( ({"weihnachten","zeit der liebe"}),
     "Weihnachten ist die Zeit der Liebe. Alles wird bunt geschmueckt und "
     "viele Lichterketten zieren die Tannenbaeume.","sagt: ");
     
  AddInfo( ({"liebe"}),
     "Liebe bedeutet fuer jeden etwas anderes. Fuer mich persoenlich ist "
     "es natuerlich meine Frau.","sagt: ");
     
  AddInfo( ({"frau","estefania"}),
     "Estefania ist eine wunderbare Frau. Sie umsorgt mich und kocht einfach "
     "himmlisch. Ich habe sie an Weihnachten vor zwei Jahren kennen "
     "gelernt, und wir haben sofort geheiratet.","sagt: ");
  
  AddInfo( ({"arion","athenia","elfenkinder"}),
     "Arion und Athenia sind meine beiden Elfenkinder. Viele denken, sie seien "
     "Geschwister, aber sie sind es nicht. Ihre beider Eltern sind damals "
     "im Kampf gegen das BOESE gestorben und seitdem leben sie bei mir und "
     "meiner Frau.","sagt: ");
  
  AddInfo( ({"elijah","thaliyah","wichtel","wichtelkinder"}),
     "Elijah und Thalyah sind meine beiden Wichtelkinder. Sie leben seit "
     "zwei Jahren bei mir.","sagt: ");
  
  AddInfo( ({"finja","feenmaedchen"}),
     "Finja ist mein suesses Feenmaedchen. Sie wurde von der Feenkoenigin "
     "ausgesetzt, weil im Feenschloss kein Platz mehr war.","sagt: ");
  
  AddInfo( ({"martin","zwergenkind"}),
     "Martin ist mein Zwergenkind. Er ist sehr putzig und lieb, aber er "
     "waescht sich so selten. Meine Frau muss ihn immer zum Baden "
     "zwingen.","sagt: ");

  
  AddInfo( ({"buxtehude"}),
     "Buxtehude ist die partylustigste Trollfrau, die ich kenne!","sagt: ");

  AddInfo( ({"took"}),
     "Wenn Du was ueber Took wissen willst, frag mal meine Frau. Die kennt ihn "
     "weit besser als ich. Ja. Er ist nett. Aber wie gesagt, frag einfach "
     "meine Frau.","sagt: ");
 
  AddInfo( ({"chivas"}),
     "Chivas ist ein total netter Typ. Er ist stets guter Laune und man kann "
     "sehr gut mit ihm reden!","sagt: ");


   
  AddInfo( ({"aruna"}),
     "In manchen Augen ist Aruna das hilfsbereiteste Wesen aller Zeiten. Oft "
     "wird sie jedoch falsch verstanden weil sie einfach sehr emotional ist. "
     "Trotzdem sollte man dabei einfach nicht vergessen, das die Menschen "
     "einfach unterschiedlich sind und bei gewissen Dingen anders reagieren, "
     "wie eben andere Leute. Man sollte dann mit mehr Einfuehlungsvermoegen "
     "arbeiten und nicht mit Provokation noch mehr Unfrieden stiften.","sagt: ");

 
  AddInfo( ({"angrox"}),
     "Fuer den Einen hier ist Angrox ein toller Sponsor, fuer den anderen "
     "hier ist Angrox der wichtigste Mensch im Leben. Angrox ist vielfaeltig "
     "und sehr sehr ruhig.","sagt: ");

    
  AddInfo( ({"cadrim"}),
     "Cadrim ist ein Diener Anvars. Er uebte sich lange in den Faehigkeiten "
     "der Druiden um legendaer zu werden. Dieser kreative Druide beherrscht "
     "all seine Zauber absolut perfekt.","sagt: ");

 
  AddInfo( ({"canziora"}),
     "Canziora hat eine imense Ausdauer und dient Ayla so gut er kann. Und "
     "sie ist froh ihn als Page zu haben.","sagt: ");

  
   AddInfo( ({"clementine"}),
     "Clementine war einmal Vollmagierin hier. Irgendwann hat sie beschlossen "
     "das Silberland zu verlassen und sich in der weiten Welt umzusehen. "
     "Trotzdem darf man nie vergessen wie unterhaltungsfoerdernd sie doch "
     "einst war.","sagt: ");

   
    AddInfo( ({"hixtine"}),
     "Hixtine ist eine sehr sehr fleissige Paladinelfin. Sie kocht gerne "
     "fuer viele Leute und ist auch aeusserst nett. Ein Hoch auf Hixtine "
     "und auch grossen Dank fuer diese liebe Dame, die bei jedem grossen "
     "Einwohnertreffen so delikat fuer die gesamte Belegschaft gekocht hat.",
     "sagt: ");

    
    AddInfo( ({"darunia"}),
     "Daruna ist ein kleines Feelein, dass sehr sehr abenteuerlustig ist. "
     "Ausserdem soll sie schnell sein. Verdammt schnell!","sagt: ");

    
    AddInfo( ({"ildenar"}),
     "Ildenar ist ein Elfendruide, dessen Haende stets mit Blut besudelt sind. "
     "Er soll sehr trickreich sein sagt man ihm nach.","sagt: ");


    
    AddInfo( ({"hotaru"}),
     "Hotaru ist ein seltenes Wesen. Sie ist eine Dunkelelfin, die sich "
     "den Paladinen angeschlossen hat. Sie soll sehr treu und auch sehr "
     "einfallsreich sein.","sagt: ");
 
    
    AddInfo( ({"dinin"}),
     "Dinin ist sehr witzig, hab ich gehoert. Ausserdem ist er stets bereit, "
     "falls jemand seine Hilfe benoetigt.","sagt: ");

    
    AddInfo( ({"hauke"}),
     "Hauke ist ein Elfenprinz und auch ein guter Trickser.","sagt: ");

   
    AddInfo( ({"justavius"}),
     "Justavius ist einer der hoechsten Paladine hier im Land. Er ist "
     "aeusserst clever kaempft gerne auf Ebene 1 oder 2 im Brunnen.","sagt: ");

   
    AddInfo( ({"justus","malar"}),
     "Er ist sehr klug und sehr strebsam. Wirklich ein super Kerl!","sagt: ");

    
    AddInfo( ({"kailani"}),
     "Mit Kailani habe ich wenig zu tun gehabt. Trotzdem fand ich sie bei "
     "unseren Begegnungen sehr suess.","sagt: ");

    
    AddInfo( ({"karpfen"}),
     "Karpfen wohnt mit seiner Frau Calluna bei den boesen Hexen. Die Hexen "
     "tun ihm nichts, weil er doch eine Frau ihresgleichen zur Gattin "
     "genommen hat. Er ist immerzu optimistisch und wuenscht sich, einmal "
     "das Set des Kriegers Archon zu besitzen.","sagt: ");

    
    AddInfo( ({"katarok"}),
     "Katarok bleibt seinen Prinzipien immer treu. Sowas ist sehr selten "
     "und sollte deshalb besonders anerkannt werden.","sagt: ");

   
    AddInfo( ({"kia"}),
     "Och Kia. Mein suesses Flatterfeechen. Ich mag sie gerne. Sie ist so "
     "putzig und ihre Unternehmungslust steckt mich immer wieder an.","sagt: ");

   
    AddInfo( ({"libella"}),
     "Libella ist eine Menschenfrau, der Ayla ganz besonders wohlgesonnen "
     "ist. Das liegt gewiss an ihrer Gutmuetigkeit und auch daran, dass sie "
     "stets sehr nett ist.","sagt: ");

    
    AddInfo( ({"lilyth"}),
     "Lilyth ist eine huebsche Dunkelelfin. Bei Gott diese Augen! Schade "
     "dass sie verheiratet ist. Sie und ihr Gatte Torian sind die Anfuehrer "
     "der Waldlaeufer. Ausser ihrem aesthetischem Aussehen, ist sie noch "
     "extrem kreativ und hat eine imense Ausdauer.","sagt: ");

   
    AddInfo( ({"lim"}),
     "Lim ist ein sehr aufgeschlossener und witziger Kerl. Sooft er Zeit hat "
     "besucht er seinen besten Freund Lars. Man sagt ihm auch nach er sei "
     "umgebungsorientierend.","sagt: ");

    
    AddInfo( ({"link"}),
     "Link soll einen guten Kampfgeist besitzen.","sagt: ");

    
    AddInfo( ({"torian"}),
     "Ach Torian! Der hat mit seinem Charme meine Lilyth mir vor der Nase "
     "weggeschnappt! Wie dem auch sei. Er ist ein toller Magier, der stets "
     "hilfsbereit und freundlich ist. Ausserdem ist er seinen Kindern ein "
     "wirklich guter Vater.","sagt: ");

    
    AddInfo( ({"nemesis"}),
     "Nemesis ist eine sehr hyperaktive Fee. Sie hilft den schwaecheren "
     "Bewohnern des Silberlandes und liebt huebsche Dinge.","sagt: ");

   
    AddInfo( ({"dante"}),
     "Gerne renne ich durch die Landschaften, die Dante geschaffen hat. "
     "Sehr orginell ist der Kerl. Das ist mir schon unheimlich.","sagt: ");

   
    AddInfo( ({"wave"}),
     "Du fragst mich ob ich Wave kenne? Na klar kenne ich meine Wavie! "
     "Ich finde sie lustig und suess mit ihren flippigen Dreadlocks.","sagt: ");

   
    AddInfo( ({"telurion"}),
     "Telurion ist ein Menschenmann mit einer guten Grundeinstellung","sagt: ");

    
    AddInfo( ({"rikz"}),
     "Jaaaa! Rikz den Zwerg kenne ich auch. Der ist der Stimmungsmacher hier "
     "im Land. Immer wenn ich ihn treffe, ist er gut gelaunt.","sagt: ");

    
    AddInfo( ({"twinkle"}),
     "Twinkle? Putzig, suess oder niedlich! Das ist meine Twinkle.","sagt: ");
 
    
    AddInfo( ({"tessa"}),
     "Tessa habe ich schon laenger nicht mehr gesehen. Trotzdem vergesse ich "
     "ihre Hilfsbereitschaft nicht.","sagt: ");

    
    AddInfo( ({"nutella"}),
     "Nutella, der maechtige Paladin ist sehr konstant.","sagt: ");
 
    
    AddInfo( ({"priwinn"}),
     "Priwinn ist etwas neugierig.","sagt: ");

    
    AddInfo( ({"cirion"}),
     "Cirion ist einer unserer Erzmagier. Er ist unauffaellig, praezise "
     "und sehr korrekt.","sagt: ");

    
    AddInfo( ({"lamyra"}),
     "Lamyra! Meine kleine Lamyra. Sie wuenscht sich jedes Jahr von mir "
     "laengere Arme. Das wuerde aber gar nicht zu ihrem zarten Figuerchen "
     "passen. Nur wegen der Kekse solchen Aufwand. Sie ist zwar sehr taff "
     "aber sollte sich ihre Kekse doch einfach mit einem Stuhl herunter "
     "holen.","lacht: ");

    
    AddInfo( ({"iwo"}),
     "Iwo zaehlt auch zu dem Magierkreis. Er hat ein gutes Fachwissen und "
     "ist sehr innovativ in allen Bereichen.","sagt: ");

    
    AddInfo( ({"anatol"}),
     "Anatol geht meist unsichtbar durchs Land. Schade dass so fuer die "
     "meisten Leute sein Witz und seine Cleverness verborgen bleibt.","sagt: ");

   
    AddInfo( ({"drogo"}),
     "Drogo ist ein ruhiger, aber cleverer Kerl.","sagt: ");

    
    AddInfo( ({"zuni"}),
     "Zuni?! Loooooooooool! Zuni ist so lustig, dass wenn ich an ihn denke, "
     "ich schon wieder lachen muss.","lacht: ");

  
    AddInfo( ({"dejot"}),
      "Dejot ist ein huebscher Zwergenmann. Viele Frauen umschwaermen "
      "ihn, weil er nicht nur huebsch sondern auch noch lieb und stets "
      "hoeflich ist. Ausserdem ist er auch staendig gut drauf.","erzaehlt: ");

    AddInfo( ({"ramirez"}),
      "Ramirez, der dunkle Nekromant ist im Grunde seines dunklen Herzens ",
      "herzensgut und sehr sehr nett.","sagt: ");

    AddInfo( ({"aroobah"}),
      "Aroobah, die Hobbitdame hat eine sehr nette Ausstrahlung und ist "
      "immerzu freundlich. Sie ist hilfsbereit, und man kann ihr alles "
      "erzaehlen, sie sagt es nie weiter.","sagt: ");

  AddInfo( ({"trintrasil"}),
      "Trintrasil hat den goettlichsten Humor hier im Silberland. Wenn er "
      "zu erzaehlen beginnt, muss ich immerzu lachen. Er kann aber auch "
      "sehr ernst sein und ist ein guter Zuhoerer.","fragt: ");

    AddInfo( ({"gaya"}),
     "Gaya ist ein herzensliebes und schnuckeliges Elfenmaedchen. Ein "
     "gewisser Jemand hier im Silberland findet sie ausserdem sehr "
     "sexy.","sagt: ");

    AddInfo( ({"jemand"}),
     "Hey! Ich bin doch kein Plappermaul und verrate solche wichtigen "
     "Geheimnisse!","sagt empoert: ");

    AddInfo( ({"plappermaul"}),
     "Ich bin jedenfalls keines!","sagt: ");

    
    AddInfo( ({"bubu"}),
     "Bubu soll ein sehr lustiger Berserkerelf sein. Manche behaupten sogar "
     "man koenne mit ihm Pferde stehlen. Humply meint sogar, dass Bubu "
     "einer seiner besten Freunde sei.","sagt: ");
 
    
    AddInfo( ({"andor"}),
     "Andor ist netter Druidenelf. Ausserdem soll er noch sehr lustig "
     "und spontan sein.","sagt: ");

    
    AddInfo( ({"llyrell"}),
     "Llyrell ist ein Mensch und dient Ayla. Ausserdem bringen manche Leute "
     "die Worte 'suess' und 'herzig' mit ihm in Verbindung.","sagt: ");

   
    AddInfo( ({"macalla"}),
     "Macalla ist eine hohe Regentin unter den Dunkelelfen. Sie lebt in den "
     "Tiefen der Unterwelt. Sie hat eine grosse Vorliebe fuer edle Dinge und "
     "einen guten Sinn fuer Aesthetik. Wenn sie nicht gerade dabei ist, ihren "
     "Ehemann Tyron zu zuechtigen, arbeitet sie im Gremium.","sagt: ");

    
    AddInfo( ({"tyron"}),
     "Tyron ist der Gatte von Macalla. Obwohl er ihr stets dient und selten "
     "aufmuempfig zu ihr ist, ist er dennoch ein guter Gespraechspartner. "
     "Naja die Dunkelelfen verstehe ich sowieso nicht. Die Frauen regieren, "
     "die Maenner salutieren. Sowas wuerds bei mir nicht geben!","sagt: ");

   
    AddInfo( ({"delgo"}),
     "Die meisten hier sehen Delgo als einen aeusserst finsteren Dunkelelfen. "
     "Ich sehe in ihm jedoch einen freundlichen Kerl, der witzig und sehr "
     "hilfreich ist. Er steht mir sehr nahe. Ausserdem arbeitet er gerade "
     "an den Waldlaeufern und ich finde so eine starke Kreativitaet sollte "
     "gefoerdert werden.","sagt: ");

    AddInfo( ({"purpur"}),
     "Purpur ist ein sehr frecher Magier. Trotz seines vorlauten Mundwerks "
     "ist er aber ein aeusserst lieber Kerl und wird von seiner Mutter "
     "sehr geliebt.","sagt: ");

     AddInfo( ({"mutter"}),
     "Hach! Davon gibt es einfach zu viele als dass ich Dir eine Auskunft "
     "geben koennte!","sagt: ");



//----------Namen ohne Info, fuer spaeter zum nachtragen-----------------

   AddInfo( ({"larifari","leandra"}), 
    "Ueber Larifari und Leandra muss ich leider schweigen.","sagt laechelnd: ");
  
   AddInfo( ({"cherub","fangorn"}), 
    "Unser Engerl Cherub hat ein enormes Durchhaltevermoegen bei gewissen "
    "Dingen. Ausserdem hat er eine gute Einstellung.","sagt laechelnd: ");
 
   AddInfo( ({"anath","jlo","naru","ishizu","yulia","xandria","kyria"}), 
    "Ueber dieses Maedchen habe ich leider keine Information fuer Dich. "
    "Das was ich weiss, das behalte ich fuer mich.","sagt laechelnd: ");
  
   AddInfo( ({"satanius","trisand","eidan","nostromo","rikz","ron","dobob"}), 
    "Ueber diesen Mann habe ich keine Info fuer Dich.","sagt laechelnd: ");
  
  
   AddInfo( ({"balthasar"}),
     "Balthasar ist ein kleiner Hobbit, der Anvar dient. Er ist einer der "
     "Meisterforscher in diesem Land und kaempft gerne in den Astralebenen. "
     "Ausserdem soll er auch einer der hilfsbereitesten Leute hier sein und "
     "jedem mit Rat und Tat zur Seite stehen.","sagt: ");
   
 

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Der Weihnachtsmann sagt: Oh, ein Geschenk fuer mich! Dankeschoen!\n" }) );


      

  
  
  SUID;
    CLONEME(ARMOUR "wsocken.lpc" );
    CLONEME(ARMOUR "whose.lpc" );
    CLONEME(ARMOUR "wmantel.lpc" );
    CLONEME(ARMOUR "zipfel.lpc" );
    command("trage alles");
   
}
  

  void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
  case "fies":
      if( random(2) )
    call_out("react", 0, "schimpft: Aerger nicht den Weihnachtsmann!",
          "schimpft: "+TP->name(WER)+" aerger mich nicht!");
      else
   call_out("angriff",0);
      break;
  case "aergerlich":
    call_out("react", 0, "fragt: Du bekommst von mir kein Geschenk "+TPN+"!",0);
      break;
  case "traurig":
     call_out("react", 0, "sagt: Nicht traurig sein, alles wird gut "+TPN+".",0);
      break;
  case "albern":
     call_out("react", 0, "schmunzelt.",0);
       break;
  case "neutral":
     call_out("react", 0, "blickt Dich durchdringend an.", "blickt "
		     +TP->name(WEN)+" durchdringend an.");
      break;
  case "intim":
     call_out("react", 0, "droht Dir mit dem Zeigefinger. ",
	"droht "+TP->name(WEM)+" mit dem Zeigefinger.");
      break;
  case "froh":
     call_out("react", 0, "laechelt Dich zufrieden an.",
             "laechelt "+TP->name(WEN)+" zufrieden an.");
      break;
  case "aengstlich":
     call_out("react", 0, "streichelt Dir beruhigend durch die Haare.",
             "streichelt "+TP->name(WEM)+" durch die Haare.");
      break;
  case "frech":
     call_out("react", 0, "verpasst Dir einen Blitzschlag.", "verpasst "
		     +TP->name(WEM)+" einen Blitzschlag.");
      break;
  case "nett":
      call_out("react", 0, "nimmt Dich in seine Arme.", "nimmt "
		      +TP->name(WEN)+" in seine Arme.");
      break;
  }
}
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
	   {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}
  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
 tell_room(ENV(TO), Name(WER, 1)+" sagt: Wer nicht hoeren will muss fuehlen!\n");
    Kill(TP);
  }
}

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
	  return StartReaction(verb, gruppe, adverb, touch);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}
 	
 

string* _query_chats()
{
  
  if (!environment())
    return 0;
  switch(explode(file_name(environment()),"/")[4])  // auf 5 aendern, wenn in region wasser
  {
    case "wzimmer":
      return ({ "Der Weihnachtsmann setzt sich gemuetlich auf das Sofa.\n",
                "Der Weihnachtsmann schmoekert etwas in seinem Buch.\n",
                "Der Weihnachtsmann nascht ein Keks.\n",
                "Der Weihnachtsmann massiert seine Fuesse.\n",
                "Der Weihnachtsmann nickt ein wenig ein.\n",
		"Der Weihnachtsmann sagt: Estefania ist wirklich ein Schatz!\n",
		"Der Weihnachtsmann fragt: Freust Du Dich schon auf Weihnachten?\n",
		"Der Weihnachtsmann sagt: Fuer Dich hab ich auch ein Geschenk.\n",
		"Der Weihnachtsmann laechelt Dich an.\n",
		"Der Weihnachtsmann steht auf und legt etwas Holz im Kamin nach.\n",
		"Der Weihnachtsmann fragt Dich: Hast Du Hunger?\n",
		"Der Weihnachtsmann raucht gemuetlich eine Pfeife.\n",
		}) + Query(P_CHATS);
    case "bad":
      return ({ "Der Weihnachtsmann laesst sich ein Bad ein.\n",
                "Der Weihnachtsmann zieht sich aus und nimmt ein heisses Bad.\n",
                "Der Weihnachtsmann waescht sich die Haende.\n",
                "Der Weihnachtsmann putzt sich die Zaehne.\n",
                "Der Weihnachtsmann waescht sich die Haare-\n",
		"Der Weihnachtsmann schimpft: Schau mir nicht zu!\n",
                 }) + Query(P_CHATS);
    case "vorraum":
      return ({ "Der Weihnachtsmann begruesst Dich herzlich.\n",
                "Der Weihnachtsmann ruft: Esti! Wo ist meine Muetze?\n",
                "Der Weihnachtsmann putzt seine Schuhe.\n",
                "Der Weihnachtsmann geht durch den Vorraum.\n",
                "Der Weihnachtsmann sagt: Wenn Du Hunger hast, geh in die Kueche.\n",
                }) + Query(P_CHATS);
    
    case "werkstatt":
    return ({ "Der Weihnachtsmann kontrolliert das Gebastelte.\n",
              "Der Weihnachtsmann gibt den Helfern ein paar Tips.\n",
              "Der Weihnachtsmann sagt: Das habt ihr ganz toll gemacht!\n",
              "Der Weihnachtsmann lobt seine Arbeiter.\n",
              "Der Weihnachtsmann fuellt etwas Farbe nach.\n",
              "Der Weihnachtsmann nimmt eine Puppe und laechelt.\n",
              "Der Weihnachtsmann sagt: Bitte macht noch ein paar Zwerge.\n",
              "Der Weihnachtsmann sagt: Huebsch Huebsch sind die Puppen.\n",
                  }) +  Query(P_CHATS) ;
    case "szimmer":
      return ({ "Der Weihnachtsmann holt einen Pyjama aus dem Schrank.\n"
                "Der Weihnachtsmann zieht sich den Pyjama an.\n",
                "Der Weihnachtsmann legt sich ins Bett.\n",
                "Der Weihnachtsmann schlaeft friedlich ein.\n",
                "Der Weihnachtsmann laechelt im Schlaf.\n",
                "Der Weihnachtsmann seufzt leise im Schlaf.\n",
                "Der Weihnachtsmann zieht sich ein frisches Paar Socken an.\n",
                "Der Weihnachtsmann schimpft: Raus aus meinem Schlafzimmer!\n",
                 }) + Query(P_CHATS);
    case "schlafz":
      return ({ "Der Weihnachtsmann versteckt ein paar Geschenke.\n",
                "Der Weihnachtsmann bettet die Betten auf.\n",
                "Der Weihnachtsmann fragt Dich: Hast Du Finja gesehen?\n",
                 }) + Query(P_CHATS);
    case "wkueche":
      return ({ "Der Weihnachtsmann setzt sich auf einen Stuhl.\n",
                "Der Weihnachtsmann nimmt sich einen Teller.\n",
                "Der Weihnachtsmann isst ein saftiges Stueck Braten.\n",
                "Der Weihnachtsmann trinkt koestlichen Punsch.\n",
                "Der Weihnachtsmann umarmt Estefania.\n",
                "Der Weihnachtsmann sagt: Du bist so huebsch Liebling.\n",
                "Der Weihnachtsmann gibt Estefania einen Kuss.\n",
                }) + Query(P_CHATS);
    case "vorgarten":
      return ({ "Der Weihnachtsmann fuellt etwas Futter in den Futtertrog.\n",
                "Der Weihnachtsmann streichelt die Rehe.\n",
                "Der Weihnachtsmann sagt: Ich liebe Schneeflocken!\n",
                "Der Weihnachtsmann ruft: Rudolf! Bald wird es Zeit!\n",
                "Der Weihnachtsmann sagt: Oh ich habe gar keine Stiefel an.\n"
                "Der Weihnachtsmann kichert\n",
                "Der Weihnachtsmann formt einen Schneeball.\n"
                "Der Weihnachtsmann faengt eine Schneeflocke auf.\n",
                }) + Query(P_CHATS);
    default: return Query(P_CHATS);
  }
}
