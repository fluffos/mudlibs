   string* _query_chats()
{
  string *fn;
  
  if (!environment())
    return 0;
  fn = explode(file_name(environment()),"/");
  if (sizeof(fn) < 5)
    return  Query(P_CHATS);
  switch (fn[5])  // auf 5 aendern, wenn in region wasser
  {
    case "werkstatt":
      return ({ "Arion fragt: Seid ihr mit den Figuren schon fertig?\n",
                "Arion kontrolliert die Holzzwerge.\n",
                "Arion laechelt die Arbeiterinnen an.\n",
                "Arion fragt Dich: Na? Gefallen Dir unsere Sachen?\n",
                "Arion sagt: Die Tiere sind heute ganz schoen hungrig.\n",
		"Arion nimmt einen Sack mit Futter.\n",
		"Arion sagt: So! Ich muss wieder! Bis spaeter.\n",
                }) + Query(P_CHATS);
    case "vorraum":
      return ({ "Arion fragt: Hey! Was machst Du denn hier?\n",
                "Arion richtet eine Fackel gerade.\n",
                "Arion fragt Dich: Hast Du Rudolf gesehen?\n",
                 }) + Query(P_CHATS);
    case "bad":
      return ({ "Arion putzt sich die Zaehne.\n",
                "Arion flechtet einige Zoepfe in seine Haare.\n",
                "Arion buerstet sich die Haare.\n",
                "Arion waescht sich die Haare.\n",
                "Arion haelt seine kalten Haende unter das heisse Wasser.\n",
                "Arion sagt: Heute ist ganz schoen kalt draussen!\n",
                "Arion nimmt ein heisses Bad.\n",
                "Arion sprueht sich mit Parfum ein.\n",
		"Arion sagt: Frisch geduscht ist halb gewonnen.\n",
		"Arion sagt: Du koenntest auch mal wieder duschen.\n",
                }) + Query(P_CHATS);
   
    case "wkueche":
      return ({ "Arion nimmt sich einen Teller.\n",
                "Arion schoepft sich etwas Suppe in seinen Teller.\n",
                "Arion loeffelt zufrieden seine Suppe.\n",
                "Arion nimmt sich etwas frischen Braten.\n",
                "Arion isst genuesslich koestlichen Wildschweinbraten.\n",
                "Arion zuendet eine Duftkerze an.\n",
                "Arion fragt: Estefania? Bekomm ich bitte was zu trinken?\n",
                "Arion laechelt Estefania an.\n",
                "Arion trinkt heissen Apfelzimttee.\n",
                "Arion nascht ein Keks.\n"
                "Arion fragt Dich: Na? Wirst Du hier auch hungrig?\n",
                "Arion lobt Estefanias Kochkunst.\n",
                "Arion umarmt Estefania und bedankt sich fuer das Essen.\n",
                }) + Query(P_CHATS);
    case "wzimmer":
      return ({ "Arion waermt sich am Kamin auf.\n",
                "Arion nimmt das Buch und liest etwas ueber Dich.\n"
                "Arion grinst Dich an und fragt: So jemand bist Du also?\n",
                "Arion redet mit dem Weihnachtsmann.\n"
                "Arion reibt sich seine kalten Fuesse.\n",
                "Arion sagt: Der hellblaue Strumpf ist meiner.\n",
                "Arion setzt sich auf das Sofa.\n",
		"Arion sagt: Gemuetlich hier gell?\n",
                }) + Query(P_CHATS);
    case "schlafz":
      return ({ "Arion legt sich ins Bett und macht ein Nickerchen.\n",
                "Arion zieht sich frische Kleidung an.\n",
                "Arion zieht sich noch ein paar Wollsocken an.\n",
                "Arion sagt: Hier ist irgendwo Finjas Tagebuch.\n",
                "Arion sucht nach Finjas Tagebuch.\n"
                "Arion sagt: Ha! Ich hab Finjas Tagebuch gefunden!\n",
                "Arion liest in Finjas Tagebuch und erroetet.\n",
                }) + Query(P_CHATS);
    case "vorgarten":
      return ({ "Arion fuettert die Rehe.\n",
                "Arion fuellt den Futtertrog mit frischen Koernern und Heu.\n",
                "Arion streichelt seine Rehe.\n",
                "Arion sagt: Ich liebe Tiere!\n"
                "Arion sagt: Meine Aufgabe ist es, die Tiere zu versorgen.\n",
                "Arion nimmt ein Schneekaninchen und knuddelt es zaertlich.\n",
                "Arion reitet eine Runde auf einem Rentier.\n",
                "Arion fuettert ein Eichhoernchen mit einer Walnuss.\n",
                "Arion macht ein Lager fuer die Tiere.\n",
                "Arion sagt: Ich werde einen beheizten Stall bauen.\n",
                "Arion fuettert ein Rehkitz mit einer Milchflasche.\n",
                "Arion huellt die Hasenbabies in eine warme Decke.\n",
                }) + Query(P_CHATS);
    default: return Query(P_CHATS);
  }
}
