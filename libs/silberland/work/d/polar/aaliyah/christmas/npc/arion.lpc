inherit "p/std/npc/druid_npc";
#include <properties.h>
#include <combat.h>
#include <mnpc.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

void init()
{ 
  ::init();


 if ( TP->name() == "Martin"&& find_call_out("martin")==-1)
   call_out("martin", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);

 if ( TP->name() == "Estefania"&& find_call_out("estefania")==-1)
   call_out("estefania", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);

 if ( TP->name() == "Finja"&& find_call_out("finja")==-1)
   call_out("finja", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);

 if ( TP->name() == "Athenia"&& find_call_out("athenia")==-1)
   call_out("athenia", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);

 if ( TP->name() == "Elijah"&& find_call_out("elijah")==-1)
   call_out("elijah", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);

 if ( TP->name() == "Thalyah"&& find_call_out("thalyah")==-1)
   call_out("thalyah", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);

 if ( TP->name() == "wmann"&& find_call_out("wmann")==-1)
   call_out("wmann", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);

 if ( TP->name() == "Das Christkind"&& find_call_out("christkind")==-1)
   call_out("christkind", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);
 
 if ( TP->name() == "Aaliyah"&& find_call_out("aaliyah")==-1)
   call_out("aaliyah", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);
}
 void hallo()

{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&& !InFight())
    tell_room(MENV, "Arion sagt: Hallo! Willkommen bei uns!\n");
}
 




void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Arion, der mutige Elfenjunge");
  SetProp(P_LONG, 
	"Arion ist ein schlanker, junger Elf. Du schaetzt ihn auf etwa "
	"16 Jahre. Er hat lange, schwarze Haare und schoene smaragdgruene "
	"Augen. Er hat eine sehr freundliche Ausstrahlung und ein aeusserst "
	"apartes Aussehen.");

      
  SetProp(P_NAME, ({"Arion, der mutige Elfenjunge",
                  "Arion, des mutigen Elfenjungen", 
                  "Arion, dem mutigen Elfenjungen",
                  "Arion, den mutigen Elfenjungen"}));
  
  SetProp(P_NAME, "Arion");
  SetProp(P_GENDER, MALE); 
  AddId("arion");
  create_default_druid("eis", 40, 16, 3000);
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 170);
  SetProp(P_WEIGHT, 5400);
  SetProp(P_MATERIAL, MAT_FLESH);
  SetProp(P_ALIGN, 1000);
  SetProp(P_ARTICLE, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_MSGIN, "verneigt sich vor Dir");
  SetProp(P_MSGOUT, "geht laechelnd");
  SetProp(P_MMSGIN, "erscheint aus dem Nichts");
  SetProp(P_MMSGOUT, "verschwindet im Nichts");
  SetProp(P_MURDER_MSG, "Das wirst Du bitter bereuen %s!");
  SetProp(P_KILL_NAME, "Arion, der Hueter der Tiere");
  SetProp(P_KILL_MSG, "Lass mich und meine Tiere in Ruhe!");
  SetChats(3, ({"Arion laechelt Dich freundlich an.\n"}));
  SetProp(P_MNPC_AREA, ROOM  );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "vorgarten" );
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
  SetProp(P_MNPC_WAIT, ({ 40, 50, 50}) );
 
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      -1.0, DT_WATER:  -1.0, DT_AIR:   0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: -1.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.1, DT_MAGIC:  -1.0, DT_MIND:   0.0,
      DT_SLASH:     0.1, DT_BLUDGEON: 0.0, DT_PIERCE: 0.0]) );

  
  
 
 
  SetProp(P_DIE_MSG, " bricht erbaermlich zusammen.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_MSG, "Tut mir leid, aber ich muss mich ja wehren!");
  SetProp(P_MURDER_MSG, "Hast Du denn ueberhaupt kein Herz?");  
  AddInfo(DEFAULT_INFO, "ist noch zu jung, um dass zu wissen.\n");

  SetProp( P_REJECT, ({REJECT_KEEP, "sagt: Oh! Danke fuer das Geschenk!\n" }));


  AddInfo( ({"mutter","mama","mami"}), 
    "Meine Mutter ist vor Jahren gestorben. Der Weihnachtsmann hat mich "
   "gefunden und mich aufgenommen. Nun ist Estefania meine Ersatzmutter, "
   "aber ich liebe sie, als waere sie meine leibliche Mutter.", 
   "sagt laechelnd: ");

  AddInfo( ({"liebe"}), 
    "Ob ich verliebt bin? Ja! Schon ein bisschen. In Athenia, wenn Du es so "
    "genau wissen willst.", "fluestert Dir zu: ");

  AddInfo( ({"weihnachtsmann","papi"}), 
    "Der Weihnachtsmann ist mein Adoptivvater.", "sagt stolz: ");

  AddInfo( ({"martin"}), 
    "Martin ist ein netter Zwerg. Er wohnt auch hier.", "sagt laechelnd: ");

  AddInfo( ({"finja"}), 
    "Finja die kleine Fee! Die will mich mal heiraten! Aber wer nimmt das"
    "schon ernst?! Sie ist doch noch ein Kind.", "lacht: ");

  AddInfo( ({"athenia"}), 
    "Athenia ist das absolut huebscheste Elfenmaedchen, das ich kenne! Wenn "
    "ich volljaehrig bin, halte ich um ihre Hand an.", "sagt laechelnd: ");

  AddInfo( ({"elijah"}), 
    "Der Wichtel ist ganz schoen frech.", "sagt: ");

  AddInfo( ({"thalyah"}), 
    "Thalyah ist zu klein, um wahr zu sein.", "sagt grinsend: ");

  AddInfo( ({"weihnachten","fest"}), 
    "Hach! Weihnachten ist das Fest der Liebe. Da kommt das Christkind und "
    "beschenkt uns.", "strahlt: ");
  
  
  AddInfo( ({"christkind"}), 
    "Das Christkind ist die Schwester des Weihnachtsmannes. Sie ist "
    "leider nicht immer hier, aber wenn sie hier ist, bringt sie uns immer "
    "was Schoenes mit.", "strahlt: ");

  
  AddInfo( ({"sex"}), 
    "Naja, ich hatte noch nie welchen. Ich hebe mich fuer die Hochzeitsnacht "
    "auf. Fuer manche klingt das seltsam, aber ich finde es richtig so.",
    "erklaert: ");
  
  
   
 SUID;
    CLONEME( "/p/armour/boots/fellstiefel.lpc" );
    CLONEME( ARMOUR "wsocken.lpc");
    CLONEME( "/p/armour/trousers/fellhose");
    CLONEME( ARMOUR "pulli.lpc" );
    CLONEME( "/d/wasser/aaliyah/hexenstadt/armour/gottsturm.lpc");
    CLONEME( "/p/armour/cloak/fellumhang");
    CLONEME( "/p/armour/helm/wollmuetze");
    command("trage alles");
   
}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react") != -1)
   return;

  switch(gruppe)
    {
   case "fies":
     call_out ("react", 0, "blickt Dich verunsichert an.",
	       "blickt "+TP->Name(WEN)+ "verunsichert an.");
     break;

   case "aergerlich":
     call_out("react", 0, "verpasst Dir eine Ohrfeige.",
	      "verpasst "+TP->Name(WEM)+" eine Ohrfeige.");
     break;

   case "frech":
     call_out("react", 0, "sagt: Lass mich in Ruhe!",
	      "blickt "+TP->Name(WEN)+" veraergert.");
     break;
   
    default:
      call_out("react", 0, "schuettelt den Kopf ueber Dich.",
	       "weicht vor Dir zurueck.");
     break;
  }

}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));

     }
  
	
} 
 void martin()
{
  if (TP && MENV && present(TP, MENV))
  {
    write("Arion begruesst Dich.\n");
    tell_room(MENV, "Arion sagt: Hallo Zwerg! Na wie gehts?\n", ({TP}));
  }

 }
