// Christmas Creations - Estefania

inherit "p/std/npc/berserker_npc.lpc";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Estefania");
  SetProp(P_LONG, "Vor Dir steht eine schlanke Frau mittleren Alters. Sie "
		  "hat lange, mondweisse Haare, die sie zu einem Zopf "
		  "gebunden hat. Ihre grossen, fliederfarbenen Augen strahlen "
		  "grossen Sanftmut und Guete aus. Estefania ist die Frau des "
		  "Weihnachtsmannes und sieht vollends gluecklich aus.");
  SetProp(P_NAME, "Estefania");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"estefania"}) );
   create_default_berserker(40, 10, 3500);
  SetProp(P_HANDS, ({" mit ihren zarten Haenden",20,DT_BLUDGEON}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 170);
  SetProp(P_WEIGHT, 50000);
  SetProp(P_MATERIAL, MAT_FLESH);
  SetProp(P_ARTICLE, 0);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
    
  SetProp(P_MSGIN, "kommt zufrieden herein");
  SetProp(P_MSGOUT, "geht laechelnd");
  SetProp(P_MMSGIN, "erwacht");
  SetProp(P_MMSGOUT, "verschwindet");
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      -1.0, DT_WATER:  -1.0, DT_AIR:   0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: -1.0, DT_TERROR: 0.0,
      DT_HOLY:      -1.0, DT_UNHOLY:    0.0, DT_MAGIC:  -1.0, DT_MIND:   0.0,
      DT_SLASH:     -0.1, DT_BLUDGEON: -0.1, DT_PIERCE: -0.1]) );

  
  
 
 
  SetProp(P_DIE_MSG, " bricht weinend zusammen.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Estefania, die Heilige");
  SetProp(P_KILL_MSG, "Selber Schuld!");
  SetProp(P_MURDER_MSG, "Der Weihnachtsmann belebt mich wieder!");  
  
  

  AddInfo(DEFAULT_INFO, "lacht: Ach, das wirst Du doch wohl selber wissen!\n");
 

  SetProp( P_REJECT, ({REJECT_KEEP, "Estefania sagt: Oh das ist aber nett!\n" }));

  SetChats(1, ({"Estefania schneidet frisches Gemuese klein.\n",
		 "Estefania wuerzt die Suppe.\n",
                 "Estefania legt die fertigen Kekse in eine Keksdose.\n",
                 "Estefania rollt Teig aus.\n",
		 "Estefania giesst den Braten auf.\n",
		 "Estefania bereitet einen koestlichen Salat zu.\n",
		 "Estefania schaut, ob der Kuchen fertig ist.\n",
		 "Estefania brueht leckeren Apfeltee auf.\n",
		 "Estefania schaelt Kartoffeln.\n",
		 "Estefania fragt Dich: Hast Du Hunger?\n",
		 "Estefania sagt: Nimm Dir etwas, wenn Du Hunger hast.\n",
		 "Estefania sagt: Ich koche den ganzen Tag.\n",
		 "Estefania nimmt einen Besen und fegt die Kueche.\n",
		 "Estefania waescht das Geschirr ab.\n",
		 "Estefania wischt etwas Staub.\n",
		 "Estefania streicht sich eine Haarstraehne aus dem Gesicht.\n",
		 "Estefania sagt: Ich liebe Weihnachten!\n",
		 "Estefania ruehrt die Suppe um.\n",
		 "Estefania waescht frische Erdbeeren.\n",
		 "Estefania schlaegt Sahne steif.\n",
		 "Estefania macht eine koestliche Erdbeercreme.\n",
		 "Estefania waescht etwas Spargel.\n",
		 "Estefania drapiert einige Kekse auf einen Teller.\n",
		 "Estefania bestreut einen Kuchen mit Staubzucker.\n",
		 "Estefania fragt: Soll ich heute eine Bavarois machen?\n",
		 "Estefania baeckt einige Crepes.\n",
		 "Estefania sagt: Elijah liebt Crepes mit Heidelbeersauce.\n",
		 "Estefania sagt: Ich koche jedem, was er will.\n",
		 "Estefania gruebelt.\n",
		 "Estefania baeckt Eclairs au Vanille.\n",
		 "Estefania baeckt Tierkekse.\n",
		 "Estefania legt die Tierkekse in eine grosse Schuessel.\n",
		 "Estefania macht leckeres Rotweingelee.\n",
		 "Estefania baeckt frisches Gewuerzbrot.\n",
		 "Estefania zupft sich ihre Schuerze zurecht.\n",
		 "Estefania ruht sich kurz am Sessel aus.\n",
                 "Estefania knabbert an ihren Fingernaegeln.\n",
		 "Estefania trinkt ein Glas Apfelcidre.\n",
		 "Estefania gaehnt.\n",
		 "Estefania schneuzt sich ihre Nase.\n",
		 "Estefania waescht sich die Haende.\n",
		 "Estefania zerhackt eine Zwiebel klein.\n",
		 "Estefania trocknet sich die Haende in ihrer Schuerze ab.\n",
		 "Estefania bereitet das Futter fuer die Tiere vor.\n",
		 "Estefania nascht einen Keks.\n",
		 "Estefania probiert den Braten.\n",
		 "Estefania schmilzt Schokolade.\n",
		 "Estefania lies kurz in einem Kochbuch.\n",
		 "Estefania setzt Germteig an.\n",
                 "Estefania schiebt ein Blech mit Keksen ins Rohr.\n",
		 }));

  SUID;
    CLONEME(WEAPON "axt2.lpc");
    if(find_object("/p/daemon/itemd/itemd") && !random(3)) 
    find_object("/p/daemon/itemd/itemd")->identify(present("mithrilaxt"),
        -1, 100, 100, ({40,80,100,102,103}));
    
     command( "zuecke axt" );
    CLONEME(ARMOUR "wsocken.lpc" );
    CLONEME(ARMOUR "rschuerze.lpc" );
    CLONEME(ARMOUR "fkleid.lpc" );
    command("trage alles");
    CLONEME(OBJ "gelee.lpc");
    CLONEME(OBJ "creme.lpc");
   
//-----------AddInfos---------------------------------

 AddInfo( ({"mama","mutter","mami","aaliyah"}),
     "Meine Mutter heisst Aaliyah. Sie hat mich erschaffen.","sagt: ");

 AddInfo( ({"vater"}),
     "Ach, den hab ich ewig nicht mehr gesehen.","erzaehlt grinsend: ");

 AddInfo( ({"elijah"}),
     "Elijah ist unser Wichteljunge. Ein suesser Fratz! Aber sobald man ihn "
     "einmal schief anschaut, schmollt er schon. Wir gingen vor langer "
     "Zeit am Strand spazieren. Wir wollten in einer Bucht picknicken. Und "
     "als wir da so sassen und leckere Sandwiches assen, trieb ein kleiner "
     "Korb ans Ufer. Darin lag ein kleines Wichtelkind. Es war Elijah. Wir "
     "haben ihn sofort gefuettert und bei uns aufgenommen.","sagt: ");

 AddInfo( ({"crepes"}),
     "Elijah liebt heisse Crepes mit Erdbeermus und Vanillecreme.","sagt: ");

 AddInfo( ({"took"}),
     "Ohhh du kennst Took auch? Ja das nenn ich ja einen Zufall!. Took ist "
     "einer meiner liebsten Freunde. Er kommt oefters zu mir und wir kochen "
     "gemeinsam. Ich mag jetzt nicht sagen dass er besser kochen kann als ich, "
     "aber er kocht wirklich sehr sehr gut. Leider hat er in letzter Zeit "
     "soviel zu tun, dass er kaum Zeit hat um mit mir zu kochen.","sagt: ");

 AddInfo( ({"erdbeermus","vanillecreme"}),
     "Ich koche fuer mein Leben gerne.","schwaermt: ");

 AddInfo( ({"eclairs au vanille","eclairs","brandteigkrapfen"}),
     "Eclairs sind Brandteigkrapfen. Man fuellt sie meistens mit Sahne oder "
     "Schokolade, doch ich bevorzuge Vanille. Schliesslich hat Thalyah das "
     "so gerne, und ich mache ihr da gerne eine Freude.","sagt: ");

 AddInfo( ({"bavarois","creme"}),
     "Eine Bavarois ist ein Dessert. Man braucht dazu frische Milch, Zucker, "
     "etwas zum Festigen und Fruechte der Saison. Ich mache sie meistens mit "
     "Heidelbeeren. Das isst hier jeder gerne. Eine Bavarois ist einfach eine "
     "Creme mit Fruechten.","sagt: ");

 AddInfo( ({"rotweingelee"}),
     "Dazu brauchst Du erlesenen Rotwein eines guten Jahrgangs, viel Zucker "
     "und etwas Kardamom.","sagt: ");

 
 AddInfo( ({"gewuerzbrot"}),
     "Fuer das Gewuerzbrot setzt Du einfach einen Teig an und verfeinerst "
     "den mit Gewuerzen. Je nach Geschmack kannst Du variieren.","sagt: ");

 
 AddInfo( ({"thalyah"}),
     "Unser kleines Elfenmaedchen heisst Thalyah. Sie liebt Eclairs au Vanille "
     "und auch meinen Wildschweinbraten. Ich weiss noch ganz genau, wie wir "
     "sie gefunden haben. Ich war nahe des Fischerdorfes Blumen pfluecken. "
     "Ich pflueckte eine Rose, die ihre Blaetter noch geschlossen hielt. Als "
     "ich sie daheim ins Wasser stellte, oeffnete sie ihre Blaetter und "
     "Thalyah lag zusammengekauert in ihr. Als Baby! Ich habe ihre Eltern "
     "gesucht, aber da ich sie nicht fand, habe ich sie grossgezogen. "
     "Leider ist sie momentan verschwunden.","sagt: ");

 
 AddInfo( ({"wildschweinbraten"}),
     "Der Wildschweinbraten braucht noch ein bisschen. Er ist zwar aussen "
     "schon ganz knusprig, aber innen noch ein bisschen zuviel rosa.","sagt: ");

 
 AddInfo( ({"suppe"}),
     "Ach ich mache jeden Tag eine andere Suppe. Oft allerdings mach ich "
     "die Tomatencremesuppe. Die ist hier sehr beliebt.","sagt: ");

 
 AddInfo( ({"tomatencremesuppe"}),
     "Die Tomatencremesuppe ist schon fertig. Ich lasse sie nur noch etwas "
     "koecheln, damit sie schoen heiss ist, wenn ich sie serviere.","sagt: ");

 
 AddInfo( ({"weihnachtsmann"}),
     "Hach! Es kommt mir wie gestern vor. Aber in der Tat ist es schon "
     "zwoelf Jahre her, als er durch den Kamin meiner Mutter in Elessar "
     "kletterte und sich sein Bein brach. Ich habe ihn gesund gepflegt und "
     "mich sofort in ihn verliebt. Ein Jahr spaeter haben wir geheiratet und "
     "in unsere Hochzeitsnacht entstand unsere wundervolle Tochter. Es ist "
     "wie im Maerchen, ich liebe ihn von Tag zu Tag mehr. Ich sah ihn an "
     "und wusste, der ist es. Der und kein anderer!","sagt: ");

 
 AddInfo( ({"kind","christkind"}),
     "Ich habe eine leibliche Tochter. Sie heisst Christkind. Sie entstand "
     "in unserer Hochzeitsnacht. An Weihnachten wurde sie geboren, und es "
     "machte das Weihnachtsfest zu einem ganz besonderem Ereignis. Sie ist "
     "selten hier, da sie immerzu die Kinder des Landes besucht. Aber wenn "
     "sie da ist, freuen wir uns ganz besonders. Ausserdem habe ich noch "
     "viele Adoptivkinder. Wir haben ihnen verschwiegen, dass das Christkind "
     "unser leibliches Kind ist, um ihnen nicht das Gefuehl zu uebermitteln, "
     "dass sie anders sind als sie. Sie sollen wissen, dass wir sie alle "
     "gleich lieben.","sagt: ");
 
 AddInfo( ({"arion","elfenjunge"}),
     "Arion haben wir vor Jahren im Wald gefunden. Er war noch ganz klein. "
     "Ein Rudel Rehe hat sich seiner angenommen. Er wurde wohl von seiner "
     "Familie dort ausgesetzt. Er liebt Tiere ueber alles, darum darf er "
     "bei uns die Tiere des Waldes pflegen und versorgen.","sagt: ");
      
 AddInfo( ({"athenia"}),
     "Athenia haben wir in ihrem Haus gefunden. Es war Weihnachten, und sie "
     "sass ganz einsam und alleine am Fenster und blickte raus. Sie war da "
     "etwa zehn Jahre alt. So genau weiss ichs nicht mehr. Ihre Mutter ist "
     "damals in den Krieg gegen das Boese gezogen und nicht mehr zurueck "
     "gekommen. Monatelang hat sie darauf gewartet. Ihren Vater kannte sie "
     "damals noch nicht. Den haben wir ihr erst suchen muessen. Sie hatte die "
     "Wahl zu ihrem Vater zu gehen, als wir ihn fanden. Jedoch wollte sie "
     "lieber bei uns hier bleiben. Als Erinnerung an ihre Mutter koche ich "
     "ihr oefters mal Holundersuppe mit Griespudding. Die hat ihr Zafira "
     "immer gemacht.","sagt: ");

  AddInfo( ({"kinder"}),
     "Wir haben all unseren adoptierten Kindern gesagt, was mit ihren "
     "Eltern passiert ist. Jedoch wissen sie nicht, wie wir sie gefunden "
     "haben und dass das Christkind unser einziges leibliches Kind ist. Wir "
     "haben vor, es ihnen zu sagen, wenn sie alt genug sind. Darum bitte "
     "ich Dich, es auch nicht zu tun. Sie sind wirklich noch zu jung.","sagt: ");
  AddInfo( ({"martin","zwergenkind"}),
     "Vor einigen Jahren ging ich ins Bergwerk, um mir dort Edelsteine zu "
     "holen. Ich brauche sie zum Juwelieren. Ausserdem wollte ich meinen "
     "alten Freund, den Baecker besuchen. Jedenfalls schlendere ich so "
     "in Gedanken versunken durch die dunklen Stollen. Auf einmal funkeln mich "
     "aus einer Ecke zwei schoene gruene Edelsteine an. Ich habe mich gefreut "
     "und dachte, es sind gruene Amethyste. Als ich jedoch naeher kam, sah ich, "
     "dass ein schmutziges Buendel sich dorthin gekauert hat. Ich nahm es "
     "in meine Arme und eilte heim. Daheim wusch ich es und kleidete es "
     "sauber an. Es ass den halben Truthahnbraten auf. Aber als es so frei war "
     "von Schmutz, da sah ich was fuer ein huebsches Zwergenkind vor "
     "mir sass. Ich taufte das Zwergenkind mit dem Namen Martin, weil ich "
     "in jungen Jahren einen huebschen Juengling kannte, der denselben Namen "
     "hatte und dieselben wunderschoenen Augen.","sagt: ");
  

  
  AddInfo( ({"finja"}),
     "Ach meine kleine Fee. Wie lieb ich sie doch habe. Wie arm war sie, als "
     "sie damals von der Feenkoenigin verstossen wurde. Nicht weil sie "
     "etwa aufmuempfig oder dreist war, nein! Vielmehr war sie leider die "
     "kleinste und zarteste Fee im ganzen Schloss und konnte somit nicht "
     "als Verteidigung der Koenigin dienen. Und da es an Platz im Schloss "
     "mangelte, band ein Kammerdiener ihr ein kleines Filzsaeckchen gefuellt "
     "mit Brot und Kaese an ihre Taille und liess sie davonflattern. Damals "
     "herrschte hier ein arger Schneesturm. Es war brutal! Ich oeffnete das "
     "Fenster, um zu lueften und ein kleiner Schneeball flog direkt in meine "
     "Kueche. Der Schneeball schmolz und Finja lag in diesem Schneewasser, "
     "unterkuehlt und zitternd. Ich habe sie in ein heisses Bad gesteckt, "
     "sie in warme, flauschige Kleidung gehuellt und sie gesund gepflegt. "
     "Seitdem ist sie hier bei uns.","sagt: ");

   AddInfo( ({"wichtel"}),
     "Ich habe zwei Wichtelkinder. Elijah und Thalyah.","sagt: ");
  
   AddInfo( ({"elfenkinder"}),
     "Meine beiden Elfenkinder heissen Arion und Athenia.","sagt: ");

    
   AddInfo( ({"apfeltee","apfelcidre","apfelpunsch"}),
     "Magst Du auch ein Glas davon?","fragt: ");
  
 

}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react") != -1)
   return;

  switch(gruppe)
    {
   case "fies":
     call_out ("react", 0, "verpasst Dir eine schallende Ohrfeige",
	       "verpasst "+TP->name(WEM)+ "eine schallende Ohrfeige.");
     break;

   case "intim":
     call_out ("react", 0, "weist Dich nett aber bestimmt ab.",
	"weist "+TP->name(WEN)+ " ab.");

    break;

   case "aergerlich":
     call_out("react", 0, "schubst Dich veraergert von sich weg.",
	      "schubst "+TP->name(WEN)+" veraergert von sich weg.");
     break;

   case "frech":
     call_out("react", 0, "sagt: Hoer auf mit dem Bloedsinn!",
	      "schimpft mit "+TP->name(WEM)+".");
     break;
   
    default:
      call_out("react", 0, "laechelt Dich an.",
	       "laechelt.");
     break;
  }

}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));

     }
  
	
} 


  

