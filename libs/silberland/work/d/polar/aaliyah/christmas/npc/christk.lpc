// Christmas Creations - Das Christkind


inherit "std/npc";
inherit "std/npc/spells";
#include "../def.h"
#include "/d/astral/lamuerte/brunnen/npc/sprachfluch.h"

int schutz, verkaufen;

void init()
{
  ::init();
   if (find_call_out("hallo") != -1)  
  call_out("hallo",0);
}

void hallo()
{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&& !InFight())
    tell_room(MENV, "Das Christkind sagt: Sei willkommen!\n");
}
void create()
{
 
  if (IS_BLUE(ME)) return;
  ::create();

  SetProp(P_SHORT, "Das Christkind");
  SetProp(P_LONG,
    "Vor Dir steht das Christkind. Es ist ein huebsches Maedchen im Alter von "
    "elf Jahren. Es hat eine zierliche Figur und feine Gesichtszuege. Ihre "
    "grossen, hellblaue Augen und ihre niedliche Stupsnase bezaubern Dich "
    "sofort. Ihre blonden Locken wallen seidig um ihre Schultern. Trotz ihrer "
    "zarten Erscheinung sollte man sie nicht unterschaetzen. Sie ist die "
    "Tochter des Weihnachtsmannes und ist daher mit sehr grosser, magischer "
    "Energie und Kraft gesegnet.");
  SetProp(P_NAME, ({"Das Christkind",
                  "Des Christkindes", 
                  "Dem Christkind",
                  "Das Christkind"}));
                  
  SetProp(P_GENDER, FEMALE);
  AddId(({"christkind", "kind"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("christkind");
  create_default_npc(50,5000);
  SetProp(P_HANDS, ({" mit ihren zierlichen Haenden",500,DT_MAGIC}));
  SetProp(P_RACE, "Engel");
  SetProp(P_SIZE, 130);
  SetProp(P_WEIGHT, 20000);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_BODY, QueryProp(P_BODY) + 50);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      -1.0, DT_WATER:  0.0, DT_AIR:  -1.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: -1.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  -1.0, DT_ACID:      -1.0, DT_POISON: -1.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    -1.0, DT_MAGIC:  -1.0, DT_MIND:   0.0,
      DT_PIERCE: 0.0, DT_BLUDGEON: 0.0,  DT_SLASH:     0.0]) );

  SetProp(P_MSGIN, "kommt anmutig herein");
  SetProp(P_MSGOUT, "geht anmutig");
  SetProp(P_MMSGIN, "erscheint in einem grellen Licht");
  SetProp(P_MMSGOUT, "verschwindet in einem grellen Licht");
  SetProp(P_MNPC_DEFAULTROOM, ROOM "hex_04.lpc");
  SetProp(P_DIE_MSG,  " wird von Engeln in den Himmel getragen.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Du bist aber nicht sehr nett!");
  SetProp(P_KILL_NAME, "Die Magie des Christkindes");
  SetProp(P_KILL_MSG, "Fuer Dich faellt heuer Weihnachten wohl aus");
//  SetProp(P_NOATTACK, "sagt: In der Weihnachtszeit kaempfe ich nicht.");
  AddInfo(DEFAULT_INFO, "sagt: Ich hab heut keine Lust auf ein Gespraech.");
  
    
   SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Das Christkind bedankt sich bei Dir.\n" }) );


//******************Spells************************************************

   
  SetProp(P_SPELLRATE, 93);
  AddSpell(4,500,
    "Das Christkind beschwoert einen Regensturm.\n",
    "Das Christkind ueberflutet @WEN mit einem Regensturm.\n",
  DT_WATER,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,700,
  "Das Christkind laesst maechtige Flammen vom Boden empor zuengeln.\n",
  "Das Christkind verbrennt @WEN mit maechtigen Flammen.\n",
  DT_FIRE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(1,1000,		  
  "Das Christkind beschwoert grosse Hagelkoerner.\n",
  "Das Christkind laesst grosse Hagelkoerner ueber @WEN hageln.\n",
  DT_COLD,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(5,500,
  "Das Christkind laesst einen Wirbelsturm entstehen.\n",
  "Das Christkind verletzt @WEN mit Hilfe eines Wirbelsturmes.\n",
  DT_FIRE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(4,700,
  "Das Christkind veraetzt Dich und sagt: Ha! Saeure hab ich auch auf Lager!\n",
  "Das Christkind veraetzt @WEN mit giftigster Saeure.\n",
  DT_ACID,([SP_SHOW_DAMAGE:1]));

   AddSpell(5,500,
  "Das Christkind zueckt einen Schlangenzahn und vergiftet Dich.\n",
  "Das Christkind vergiftet @WEN mit einem Schlangenzahn.\n",
  DT_FIRE,([SP_SHOW_DAMAGE:1]));
  

  AddDefaultSpell(5, 300, DS_ANTIMAGIC);

  AddDefaultSpell(5, 300, DS_FROG);

  AddDefaultSpell(5, 300, DS_CURSE_WEAPON);

  AddDefaultSpell(5, 300, DS_BLIND);

  AddSpell(3,600,
  "Das Christkind laehmt Deine Zunge.\n",
  "Das Christkind laehmt die Zunge von @WEM.\n",
  DT_SLASH, "spell_sprachfluch",([SP_SHOW_DAMAGE:1]));

  
    
//*****************Spells Ende****************************************

 
  SetChats(5, ({"Das Christkind laechelt Dich verschmitzt an.\n",
		"Das Christkind schwebt engelsgleich durch den Raum.\n",
		"Das Christkind streicht sich eine Locke aus dem Gesicht.\n"}));
 
  
  SUID;
    CLONEME(ARMOUR "wschleife.lpc");
    CLONEME(ARMOUR "wkleidchen.lpc");
    CLONEME(ARMOUR "armschienen.lpc");
//    CLONEME(" /d/dschungel/feyaria/tijara/armour/zauberrobe.lpc");
    command ("trage alles");
   
}

  void Attack(object enemy) 
 
{
  ModifySkillAttribute(TO, SA_SPEED, ((random(4)+1)*100), 2);
  ::Attack(enemy);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}
void spell_zwing(object enemy, int damage, mixed dam_type)
{
  int i;

  object *ob;
  
  if( !interactive(enemy) )
  {
    enemy->StopHuntFor(ME);
    StopHuntFor(enemy);
    tell_room(MENV, enemy->Name(WER,2)+" kaempft jetzt fuer das Christkind.\n");
    if( sizeof(ob = PresentEnemies()))
      for(i=sizeof(ob)-1;i--;i>=0)
        enemy->Kill(ob[i]);
    return;
  }
  switch(random(6))
  {
    case 0: 
      domainshout( CAP(enemy->name())+ " ruft: Ich kaempfe gerade vergeblich "
        "mit dem Christkind!\n");
      break;
    case 1:
      domainshout( CAP(enemy->name())+ " ruft: Ich Seicherl schaff es nicht "
        "das Christkind zu toeten!\n");
      break;
    case 2:

      tell_object(enemy, "Du wirst alle Deine Sachen weg.\n");
      for(i=sizeof(ob=all_inventory(enemy));i>0;i--)
      {
        ob[i]->move(MENV, M_PUT);
      } 
      enemy->command_me("wirf alles weg");
      break;
    case 3:
      tell_object(enemy, "Du gibts Deine Waffe dem Christkind.\n");
      if( enemy->QueryProp(P_WEAPON) )
      {
        enemy->QueryProp(P_WEAPON)->move(TO, M_GIVE);
      }
      enemy->command_me("gib alle waffen an christkind");
      verkaufen=1;
      break;
    case 4:
      tell_object(enemy, "Das Christkind nimmt Dir Deine ganze Ausruestung.\n");
      for(i=sizeof(ob=enemy->QueryProp(P_ARMOURS))-1;i>0;i--)
      {
        ob[i]->move(TO, M_GIVE);
      }
      enemy->command_me("gib alle ruestungen an christkind");

      command("trage alles");
      verkaufen=1;
      break;
   
  }
}


