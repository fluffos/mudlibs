   string* _query_chats()
{
  
  if (!environment())
    return 0;
  switch(explode(file_name(environment()),"/")[4])  // auf 5 aendern, wenn in region wasser
  {
    case "werkstatt":
      return ({ "Athenia formt eine Puppe.\n",
                "Athenia naeht ein Puppenkleid.\n",
                "Athenia bastelt Puppenschuhe.\n",
                "Athenia zieht eine Puppe an.\n",
                "Athenia zeigt Dir ein Puppenkleid.\n"
		"Athenia fragt Dich: Gefaellt es Dir?\n",
		"Athenia gibt Finja drei Puppenkleider.\n",
                }) + Query(P_CHATS);
    case "vorraum":
      return ({ "Athenia geht anmutig an Dir vorbei.\n",
                 }) + Query(P_CHATS);
    case "bad":
      return ({ "Athenia kaemmt sich ihre Haare.\n",
                "Athenia geniesst ein heisses Bad.\n",
                "Athenia putzt sich die Zaehne.\n",
                "Athenia legt etwas Makeup auf.\n",
                "Athenia cremt sich mit Koerpercreme ein.\n",
                "Athenia steckt sich eine Haarstraene hinter ihr Ohr.\n",
                "Athenia waescht sich die Haare.\n",
                "Athenia fragt Dich: Passen meine Haare so?\n",
		"Athenia guckt in den Spiegel.\n",
		"Athenia richtet ihre Schleife zurecht.\n",
                }) + Query(P_CHATS);
   
    case "wkueche":
      return ({ "Athenia sagt: Ich helfe Dir Mutter!\n",
                "Athenia nimmt sich einen Teller Suppe.\n",
                "Athenia geniesst ihre Suppe.\n",
                "Athenia schoepft Suppe in acht Teller.\n",
                "Athenia sagt: Ich hol die Anderen dann zum Essen.\n",
                "Athenia deckt den Tisch fuer alle Mitbewohner.\n",
                "Athenia streicht ihr Kleid gerade.\n",
                "Athenia macht frischen Saft und fuellt ihn in Glaeser.\n",
                "Athenia beginnt Salat zu waschen.\n",
                "Athenia laechelt Estefania an.\n"
                "Athenia fragt: Heute so schweigsam Mutter?\n",
                "Athenia kitzelt Estefania am Kinn.\n",
                "Estefania sagt: Du bist eine tolle Tochter!\n",
                }) + Query(P_CHATS);
    case "wzimmer":
      return ({ "Athenia bringt dem Weihnachtsmann etwas zu essen.\n",
                "Athenia bringt dem Weihnachtsmann ein Glas Punsch.\n",
                "Der Weihnachtsmann sagt: Du bist so fleissig Athenia!\n",
                "Der Weihnachtsmann sagt: Mach mal eine Pause Athenia.\n"
                "Der Weihnachtsmann sagt: Setz Dich doch zu mir Athenia.\n",
                "Athenia setzt sich auf das Sofa.\n",
                 }) + Query(P_CHATS);
    case "schlafz":
      return ({ "Athenia zieht sich ein anderes Kleid an.\n",
                "Athenia legt sich ins Bett und schlaeft ein bisschen.\n",
                "Athenia sagt: Raus aus dem Schlafzimmer!\n",
                 }) + Query(P_CHATS);
    case "vorgarten":
      return ({ "Athenia bringt Arion einen heissen Apfeltee.\n",
                "Arion laechelt Athenia an.\n",
                "Athenia sagt: Komm rein ins Warme Schatz.\n",
                "Athenia streichelt ein Rentier.\n"
                "Athenia streckt ihren Arm aus.\n"
                "Ploetzlich kommen zwei Tauben und setzen sich auf ihren Arm.\n",
                "Athenia wickelt Arion in eine warme Decke.\n",
                "Athenia sagt: Komm, es gibt bald essen.\n",
                "Arion umarmt Athenia schuechtern.\n",
                "Athenia wirft einen Schneeball auf Arion.\n",
                "Athenia pflueckt eine Eisrose.\n",
                "Arion streichelt Athenia ueber die Wange.\n",
                }) + Query(P_CHATS);
    default: return Query(P_CHATS);
  }
}
