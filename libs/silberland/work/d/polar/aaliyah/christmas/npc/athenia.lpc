// Christmas Creations - Athenia
inherit "std/mnpc";

#include "../def.h"

void init()
{ 
  ::init();


 if ( TP->name() == "Martin"&& find_call_out("martin")==-1)
   call_out("martin", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);

 if ( TP->name() == "Estefania"&& find_call_out("estefania")==-1)
   call_out("estefania", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);

 if ( TP->name() == "Arion"&& find_call_out("arion")==-1)
   call_out("arion", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);

 if ( TP->name() == "Finja"&& find_call_out("finja")==-1)
   call_out("finja", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);

 if ( TP->name() == "Elijah"&& find_call_out("elijah")==-1)
   call_out("elijah", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);

 if ( TP->name() == "Thalyah"&& find_call_out("thalyah")==-1)
   call_out("thalyah", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);

 if ( TP->name() == "wmann"&& find_call_out("wmann")==-1)
   call_out("wmann", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);

 if ( TP->name() == "Das Christkind"&& find_call_out("christkind")==-1)
   call_out("christkind", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);
 
 if ( TP->name() == "Aaliyah"&& find_call_out("aaliyah")==-1)
   call_out("aaliyah", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);
}
 void hallo()

{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&& !InFight())
    tell_room(MENV, "Athenia sagt: Sei gegruesst " +TP->name()+".\n");
}
 




void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Athenia, das Elfenmaedchen");
  SetProp(P_LONG, 
	"Athenia ist ein huebsches, 15jaehriges Elfenmaedchen. Sie hat "
	"lange blonde Locken und huebsche veilchenblaue Augen, die mit langen, "
	"schwarzen Wimpern umrandet sind. Ihre schlanke Gestalt zeugt von "
	"einer grossen Anmut wie man es normalerweise bei Maedchen ihren "
	"Alters nicht erwartet. Aber der Weihnachtsmann und seine Frau haben "
	"sehr auf ihre Erziehung geachtet, damit sie spaeter mal bei den "
	"Hochelfen sehr angesehen ist.");
  SetProp(P_NAME, "Athenia");
  SetProp(P_GENDER, FEMALE); 
  AddId("athenia");
  create_default_npc(4);
  SetProp(P_HANDS, ({"ihren zarten Haenden ",30,DT_BLUDGEON}));
  SetProp(P_RACE, "Hochelfe");
  SetProp(P_SIZE, 168);
  SetProp(P_WEIGHT, 45000);
  SetProp(P_MATERIAL, MAT_FLESH);
  SetProp(P_ALIGN, 1000);
  SetProp(P_ARTICLE, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_MSGIN, "kommt anmutig herein");
  SetProp(P_MSGOUT, "geht anmutig");
  SetProp(P_MMSGIN, "erscheint aus einem Glitzerstrahl");
  SetProp(P_MMSGOUT, "rutscht einen Regenbogen hinunter");
  SetProp(P_NOATTACK, "steht unter dem Schutz des Weihnachtsmannes.");
  SetProp(P_MNPC_AREA, ROOM  );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "wkueche" );
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
  SetProp(P_MNPC_WAIT, ({ 30, 40, 50}) );
  SetChats(3, ({"Athenia laechelt Dich zuckersuess an.\n"}));
  
 
  SetProp(P_DIE_MSG, " bricht erbaermlich zusammen.\n");
  SetProp(P_NOCORPSE, 0);
  AddInfo(DEFAULT_INFO, "sagt: Ich weiss das leider nicht.\n");

  SetProp( P_REJECT, ({REJECT_KEEP, "sagt: Danke Dir vielmals!\n" }));


  AddInfo( ({"mutter","mama","mami"}), 
    "Meine ehrenwehrte Mutter hat vor einigen Jahren das Zeitliche "
    "gesegnet. Gott hab sie selig! Sie soll einmal eine legendaere Heldin "
    "gewesen sein und in den Tiefen des Brunnen vom Boesen brutal ermordet "
    "worden sein.", "sagt seufzend: ");

  AddInfo( ({"vater","papa","vati"}), 
    "Mein leiblicher Vater soll ein Elfenheld sein. Ich habe ihn nie "
    "kennengelernt. Aber ich brauche ihn nicht. Der Weihnachtsmann ist "
    "der viel bessere Papa, der kuemmert sich wenigstens um mich.", "seufzt: ");

  AddInfo( ({"weihnachtsmann","estefania","frau"}), 
    "Der Weihnachtsmann und seine Frau bemuehen sich, gute Eltern fuer mich "
    "zu sein.", "sagt stolz: ");

  AddInfo( ({"martin"}), 
    "Martin ist ein netter Zwerg. Er wohnt auch hier.", "sagt laechelnd: ");

  AddInfo( ({"arion"}), 
    "Ach Arion mag ich gerne. Er ist huebsch, suess und wirklich charmant. "
    "Ausserdem weiss er, wie man mit Frauen umgeht.", "kichert: ");

  AddInfo( ({"finja"}), 
    "Finja ist unsere kleine Kuschelfee. Sie ist wirklich ein total suesses "
    "und liebes Kind.", "sagt laechelnd: ");

  AddInfo( ({"elijah"}), 
    "Der Wichtel schmollt zu oft, finde ich.", "sagt: ");

  AddInfo( ({"thalyah"}), 
    "Thalyah ist auch sehr nett.", "sagt: ");

  AddInfo( ({"weihnachten","fest"}), 
    "Hach! Weihnachten ist das Fest der Liebe. Da kommt das Christkind und "
    "beschenkt uns.", "strahlt: ");
  
  
  AddInfo( ({"christkind"}), 
    "Das Christkind ist die Schwester des Weihnachtsmannes. Sie ist "
    "leider nicht immer hier, aber wenn sie hier ist, bringt sie uns immer "
    "was Schoenes mit.", "strahlt: ");

  
  AddInfo( ({"gilagas","elfenheld"}), 
    "Als ich noch klein war, hat mir meine Mutter viel von ihm erzaehlt. "
    "Ich wuerde mich freuen, wenn ich ihn mal wiedersehen koennte. Ich "
    "wuerde ihn so gerne fragen, wie meine Mutter war", "sagt seufzend: ");
   
  AddInfo( ({"zafira","heldin"}), 
    "Meine Mutter hiess Zafira. Sie war so wunderschoen. Das Boese hat sie "
    "brutal getoetet. Ich hab tagelang auf sie gewartet. Tagelang! Ich hab "
    "gebetet und gehofft, dass sie irgendwann wiederkehrt. Abend fuer Abend "
    "bin ich an unserem Talan gestanden und hab geguckt, ob sie nicht doch "
    "irgendwann heimkehrt. Irgendwann kam die Nachricht, dass sie tot sei. "
    "Ich habe tagelang geweint.", "sagt traurig: ");
  

  AddInfo( ({"sex"}), 
    "Ich hatte noch nie Sex. Ich hebe mich fuer den Richtigen auf. Also "
    "erst, wenn ich geheiratet habe mach ich sowas.", "erklaert: ");
  
  AddInfo( ({"liebe"}), 
    "Ich bin in Arion verliebt.", "fluestert Dir zu: ");
  

  AddInfo( ({"boese","boesen","tiefen","brunnen"}), 
    "Ich weiss nur, dass es sehr sehr boese ist und das man daran sterben kann. "
    "Es ist ein grosses Monster, das jeden toetet der sich in seine Naehe "
    "wagt.", "sagt zitternd: ");
  
  
   
 SUID;
    CLONEME(ARMOUR "ballerinas.lpc" );
    CLONEME(ARMOUR "hkleidchen.lpc" );
    CLONEME(ARMOUR "hschleife.lpc");
    command("trage alles");
   
  

}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react") != -1)
   return;

  switch(gruppe)
    {
   case "fies":
     call_out ("react", 0, "blickt Dich verunsichert an.",
	       "blickt "+TP->Name(WEN)+ "verunsichert an.");
     break;

   case "aergerlich":
     call_out("react", 0, "kneift Dir in den Arm.",
	      "kneift "+TP->Name(WEM)+" in den Arm.");
     break;

   case "frech":
     call_out("react", 0, "sagt: Hoer auf mit dem Mist!",
	      "grummelt "+TP->Name(WEN)+" an.");
     break;
   
    default:
      call_out("react", 0, "weicht vor Dir zurueck.",
	       "weicht vor Dir zurueck.");
     break;
  }

}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));

     }
  
	
} 
 void martin()
{
  if (TP && MENV && present(TP, MENV))
  {
    write("Athenia begruesst Dich.\n");
    tell_room(MENV, "Athenia drueckt Martin fest an sich.\n", ({TP}));
  }

 }
