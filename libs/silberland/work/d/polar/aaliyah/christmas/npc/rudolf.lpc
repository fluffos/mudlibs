// 7. November 2005
// by Aaliyah

// Christmas - Creations Rudolf das Rentier


inherit "std/npc";
inherit "std/npc/spells";
#include "../def.h"

 void create()
{
 
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Rudolf, das Rentier");
  SetProp(P_LONG,
    "Rudolf ist ein freundliches Rentier. Er gehoert dem Weihnachtsmann und "
    "fuehrt seinen Schlitten an. Er ist gross und hat gutmuetige braune "
    "Augen.");
  SetProp( P_REJECT, ({ REJECT_DROP,
                      "braucht das nicht!\n" }) );
  AddInfo(DEFAULT_INFO, "versteht Dich nicht.");
  SetProp(P_NAME, ({"Rudolf, das Rentier",
                   "Rudolf, des Rentieres", 
                   "Rudolf, dem Rentier",
                   "Rudolf, das Rentier"}));
                  
  SetProp(P_GENDER, NEUTER);
  AddId(({"rudolf", "rentier","tier","rudolf das rentier"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("rudolf");

  create_default_npc(30);
  SetProp(P_HANDS, ({" mit seinen Hufen",400,DT_BLUDGEON}));
  SetProp(P_RACE, "Rentier");
  SetProp(P_SIZE, 210);
  SetProp(P_WEIGHT, 90000);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      -1.0, DT_WATER:  0.0, DT_AIR:    -1.0, 
      DT_LIGHTNING: 0.1, DT_EXPLOSION: 0.1, DT_SOUND:  0.0, DT_LIGHT:  -1.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.2, DT_POISON: 0.3, DT_TERROR: -1.0,
      DT_HOLY:      0.2, DT_UNHOLY:    0.1, DT_MAGIC:  -1.0, DT_MIND:   0.2,
      DT_PIERCE: -1.0, DT_BLUDGEON: 0.0,  DT_SLASH:     0.0]) ); 
  
  SetProp(P_MSGIN, "trottet herein");
  SetProp(P_MSGOUT, "trottet");
  SetProp(P_MMSGIN, "huepft aus den Welten hervor");
  SetProp(P_MMSGOUT, "verschwindet");
  SetProp(P_MNPC_AREA, "hex_11.lpc" );
  SetProp(P_DIE_MSG,  " sinkt blutend in den Schnee.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Erklaer das mal dem Weihnachtsmann!");
  SetProp(P_KILL_NAME, "Rudolf, das Rentier");
  SetProp(P_KILL_MSG, "Yieeeeeeeeeeehaaa!");

    
  SetProp(P_SPELLRATE, 90);
  
  AddSpell(4,700,
    "Rudolf beisst Dir in den Arm.\n",
    "Rudolf beisst @WEM in den Arm.\n",
  DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(8,900,
  "Rudolf tritt Dich mit seinen Hufen.\n",
  "Rudolf tritt @WEN mit seinen Hufen.\n",
  DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddDefaultSpell(6,500,DS_BLIND);
  
  AddSpell(8,600,		  
  "Rudolf spiesst Dich mit seinem gewaltigen Geweih auf.\n",
  "Rudolf spiesst @WEN mit seinem Geweih auf.\n",
  DT_SLASH,([SP_SHOW_DAMAGE:1]));

   AddSpell(2,2000,		  
  "Rudolf laesst sich mit seinem ganzen Gewicht auf Dich fallen.\n",
  "Rudolf zerquetscht @WEN unter seinem Gewicht.\n",
  DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

  
  
   
}
