inherit "p/std/npc/paladin_npc.lpc";
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Wichtelkind Elijah");
  SetProp(P_LONG, "Vor Dir sitzt ein kleines, putziges Wichtelkind. Er "
		  "misst in etwa zehn Zentimeter. Es ist Elijah, der kleine "
		  "Wichteljunge. Er hat grosse, rehbraune Augen und blonde, "
		  "kurze Strubbelhaare. Seine zarte Gestalt wirkt beinahe "
		  "zerbrechlich, aber bei seinem suessen Anblick bekommst Du "
		  "grosse Lust, ihn mal ganz herzlich zu knuddeln. Er ist "
		  "etwa fuenf Jahre alt.");
  SetProp(P_NAME, "Elijah");
  SetProp(P_GENDER, MALE); 
  AddId( ({"elijah","wichtel","wichtelkind","wichtelkind elijah"}) );
   create_default_paladin(40, 10, 3500);
  SetProp(P_HANDS, ({" mit ihren zarten Haenden",20,DT_BLUDGEON}));
  SetProp(P_RACE, "Wichtel");
  SetProp(P_SIZE, 10);
  SetProp(P_GUILD, "paladine");
  SetProp(P_GUILD_LEVEL, 15);
  SetProp(P_WEIGHT, 8);
  SetProp(P_MATERIAL, MAT_FLESH);
  SetProp(P_ARTICLE, 0);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_MSGIN, "tapst herein");
  SetProp(P_MSGOUT, "tapst laechelnd");
  SetProp(P_MMSGIN, "erwacht");
  SetProp(P_MMSGOUT, "verschwindet");
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      -1.0, DT_WATER:  -1.0, DT_AIR:   0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: -1.0, DT_TERROR: 0.0,
      DT_HOLY:      -1.0, DT_UNHOLY:    0.0, DT_MAGIC:  -1.0, DT_MIND:   0.0,
      DT_SLASH:     -0.5, DT_BLUDGEON: -0.5, DT_PIERCE: -0.5]) );

  
  
 
 
  SetProp(P_DIE_MSG, " bricht weinend zusammen.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Elijah, das Wichtelkind");
  SetProp(P_KILL_MSG, "*Ups* Das tut mir jetzt aber leid");
  SetProp(P_MURDER_MSG, "Danke! Immer auf die Kleinen!");  
  AddInfo(DEFAULT_INFO, "ist noch zu jung, um dass zu wissen.\n");


  AddInfo(DEFAULT_INFO, "sagt schmollend: Wieso sollte ich grad Dir helfen?\n");
 

  SetProp( P_REJECT, ({REJECT_DESTRUCT, "Elijah sagt: Ups. Jetzt isses kaputt!\n" }));

  SetChats(1, ({"Elijah schnieft.\n",
		 "Elijah kuschelt sich ins Bett.\n",
                 "Elijah sagt: Niemand spielt mit mir!\n",
                 "Elijah holt ein Keks aus seiner Hosentasche.\n",
		 "Elijah nascht einen Keks.\n",
		 "Elijah sagt: Irgendwann bin auch ich gross!\n",
		 "Elijah spielt mit einer Plastikfigur.\n",
		 "Elijah zaehlt: EINS! ZWEI! DREI! VIER ! FUENF! SECHS!\n",
		 "Elijah sagt: Hunger hab ich auch schon.\n",
		 "Elijah bohrt in seiner Stupsnase.\n",
		 "Elijah huepft am Bett herum.\n",
		 "Elijah laechelt Dich verheult an.\n",
		 "Elijah zieht sich einen frischen Pulli an.\n",
		 "Elijah spielt mit seinem Plueschteddy.\n",
		 "Elijah setzt sich aufrecht aufs Bett.\n",
		 "Elijah wirft einen Wattebausch nach Dir.\n",
		 "Elijah macht einen Purzelbaum.\n",
		 "Elijah seufzt.\n",
		 "Elijah sagt: Ich moechte einmal ein Prinz werden!\n",
		 "Elijah setzt sich in Deine Hand.\n",
		 "Elijah zueckt eine Stecknadel und schreit: Ergebe Dich!\n",
                 "Elijah setzt sich eine Walnussschale auf den Kopf.\n",
		 }));

  SUID;
    CLONEME( "d/ebene/obj/waffe/mithrilschwert");
    command( "zuecke schwert" );
    CLONEME( "/p/armour/shield/mithrilschild");
    CLONEME(ARMOUR "wsocken.lpc" );
    CLONEME(ARMOUR "pulli.lpc" );
    CLONEME( "/players/aaliyah/wichtelstadt/armour/latzhose.lpc" );
    CLONEME( "/players/aaliyah/wichtelstadt/armour/muetze.lpc");
    command("trage alles");
   
   
//-----------AddInfos---------------------------------

 AddInfo( ({"aaliyah"}),
     "Aaliyah hat mich erschaffen.","sagt: ");

 AddInfo( ({"vater","papi"}),
     "Ach, das ist der Weihnachtsmann. Der ist lieb, der schenkt mir soviel "
     "schoene Sachen.","erzaehlt grinsend: ");

 AddInfo( ({"weihnachtsmann"}),
     "Das ist mein Papi. Dididi.. Ja meiner! Mein Papi.","kichert: ");

 AddInfo( ({"estefania","mami","mama"}),
     "Meine Mami heisst Estefania. Es ist die schoenste und beste Mami auf "
     "der ganzen Welt. Ich habe sie soooooooo sooooooo lieb.","sagt: ");

 AddInfo( ({"ayla","patentante"}),
     "Ayla ist meine Patentante. Sie ist die schoenste Frau auf der ganzen "
     "Welt. Sie hat so schoene lange Haare. Wenn ich einmal gross bin, werde "
     "ich sie heiraten.","schwaermt: ");

 AddInfo( ({"thalyah"}),
     "Thalyah ist meine beste Freundin. Ich habe sie sehr lieb. Sie borgt "
     "mir auch immer ihre Puppe zum Spielen.","sagt: ");

 AddInfo( ({"arion"}),
     "Hihi! Der laesst mich auf seinen Schneehasen reiten. Das finde ich total "
     "lustig. Einmal bin ich sogar im Geweih von Rudolf gesessen und auf dem "
     "geritten.","sagt: ");

 AddInfo( ({"rudolf"}),
     "Rudolf the Rednose Rendeer.....","singt: ");

 
 AddInfo( ({"athenia"}),
     "Athenia ist meine grosse Schwester. Die kennst Du sicher. Die mag ich "
     "gerne. Sie kitzelt mich immer bis ich lache.","strahlt: ");

 
 AddInfo( ({"martin"}),
     "Ach Martin. Was willst Du denn von dem? Der ist einfach nur ein kleiner "
     "Zwerg, der sich den Leuten anpasst, um cool zu sein. Anfangs habe ich "
     "ihn sehr gerne gehabt, aber Finja hat mir erzaehlt, dass er zur Zeit "
     "etwas pubertiert. Was auch immer das sein soll.","sagt: ");

 
 AddInfo( ({"pubertiert","pubertaet"}),
     "Was soll das sein? Pubertaet? Ist das was zum Spielen oder zum Essen? "
     "Sag Dus mir, ich weiss es ja nicht.","sagt: ");

 
 AddInfo( ({"finja"}),
     "Finja find ich auch toll. Ach ich weiss nicht, ob ich wenn ich gross bin "
     "Thalyah, Athenia, Ayla oder Finja heiraten soll. Alle haben mich gefragt "
     "ob ich sie heiraten will. Die wollen mich alle heiraten.","sagt: ");

 
 AddInfo( ({"essen"}),
     "Ach? Schickt Dich meine Mami? Ist das Essen schon fertig?","fragt: ");

 
 AddInfo( ({"sex"}),
     "Ich kenne viel mehr Zahlen als Du! Eins, Zwei, Drei, Vier, Fuenf, "
     "Sex, Sieben. Du musst zaehlen lernen.","sagt: ");

 
 AddInfo( ({"christkind"}),
     "Das Christkind beschenkt alle Kinder.","sagt: ");

 
 AddInfo( ({"weihnachten"}),
     "Weihnachten finde ich super! Soviele schoene Geschenke und so "
     "schoen dekoriertes Essen. Ausserdem sind dann hier alle gut gelaunt "
     "und feiern.","sagt: ");
 
     
 AddInfo( ({"baum","christbaum","tannenbaum","weihnachtsbaum"}),
     "Den stellen wir immer im Wohnzimmer auf und schmuecken ihn auch immer "
     "sehr schoen.","sagt: ");

  AddInfo( ({"christbaumschmuck","lametta","christbaumkugeln","kerzen"}),
     "Ein Christbaum ist nur schoen, wenn er auch toll geschmueckt ist. "
     "Ausserdem erhoeht das doch die Weihnachtsstimmung.","sagt: ");
  
 

}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react") != -1)
   return;

  switch(gruppe)
    {
   case "fies":
     call_out ("react", 0, "grummelt Dich beleidigt an",
	       "grummelt "+TP->name(WEN)+ " beleidigt an.");
     break;

   case "intim":
     call_out ("react", 0, "starrt Dich erschrocken an.",
	"starrt "+TP->name(WEN)+ " erschrocken an.");

    break;

   case "aergerlich":
     call_out("react", 0, "beisst Dir veraergert in den Finger.",
	      "beisst "+TP->name(WEM)+" in den Finger.");
     break;

   case "frech":
     call_out("react", 0, "sagt: Hey! Lass das bitte!",
	      "schimpft mit "+TP->name(WEN)+".");
     break;
   
    default:
      call_out("react", 0, "laechelt Dich an.",
	       "laechelt.");
     break;
  }

}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));

     }
  
	
} 


  

