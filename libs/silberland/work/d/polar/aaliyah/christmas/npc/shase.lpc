// von Aaliyah
// 6.10.2005
// Weihnachtshase
// Christmas - Creation

inherit "std/mnpc";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Schneehase");
  SetProp(P_LONG, "Ein suesser, weisser Weihnachtshase mit grossen, "
		  "haselnussbraunen Augen. ");
  SetProp(P_NAME, "Schneehase");
  SetProp(P_GENDER, MALE); 
  AddId( ({"weihnachtshase","hase","schneehase"}) );
  create_default_npc(2+random(4));
  SetProp(P_HANDS, ({" mit seinen kleinen Pfoten",30,DT_BLUDGEON}));
  SetProp(P_RACE, "Hase");
  SetProp(P_SIZE, 50);
  SetProp(P_WEIGHT, 8000);
  SetProp(P_MATERIAL, MAT_FLESH);
  SetProp(P_ALIGN, 40+random(1000));
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_MSGIN, "tapst herein");
  SetProp(P_MSGOUT, "tapst davon");
  SetProp(P_MMSGIN, "oeffnet seine Kulleraugen");
  SetProp(P_MMSGOUT, "tapst davon");
  SetProp(P_NOATTACK, "schlaegt einen Haken.");
  
  SetProp(P_MNPC_AREA, ({ ROOM "glasraum.lpc"}));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "glasraum.lpc");
  SetProp(P_MNPC_FLAGS, 0);  
  SetProp(P_DIE_MSG, " bricht erbaermlich zusammen.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_MSG, "Tut mir leid, aber ich muss mich ja wehren!");
  SetProp(P_MURDER_MSG, "Hast Du denn ueberhaupt kein Herz?");  
  AddInfo(DEFAULT_INFO, "putzt seine Pfoten.\n");

  SetProp( P_REJECT, ({REJECT_DROP, "Der Schneehase schuettelt den Kopf.\n" }));

  AddInfo( ({"hilfe"}), 
    "Ich kann Dir nicht helfen. Du wirst schon selbst draufkommen, wenn "
    "Du genuegend Geduld und Zeit investierst.", "sagt grinsend: ");

  AddInfo( ({"blase"}), 
    "Du kannst mich fragen, was Du willst, ich werde Dir nicht helfen. Ich "
    "wuerde zwar gerne, aber ich darf nicht.", "erklaert: ");
  
  
  
}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react") != -1)
   return;

  switch(gruppe)
    {
   case "fies":
     call_out ("react", 0, "blickt Dich verstoert an.",
	       "blickt "+TP->name(WEN)+ " verstoert an.");
     break;

   case "intim":
     call_out ("react", 0, "beginnt mit Dir zu spielen.",
	"beginnt mit "+TP->name(WEM)+ " zu spielen.");

    break;

   case "aergerlich":
     call_out("react", 0, "fluechtet vor Dir.",
	      "fluechtet vor "+TP->name(WEM)+".");
     break;

   case "frech":
     call_out("react", 0, "sagt: Lass mich, ich tu Dir nichts.",
	      "knurrt "+TP->name(WEN)+" scheu an.");
     break;
   
    default:
      call_out("react", 0, "schmiegt sich an Deine Beine.",
	       "blickt zufrieden drein.");
     break;
  }

}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));

     }
  
	
} 


   
