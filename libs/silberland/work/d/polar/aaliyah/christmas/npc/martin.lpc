   string* _query_chats()
{
  
  if (!environment())
    return 0;
  switch(explode(file_name(environment()),"/")[4])  // auf 5 aendern, wenn in region wasser
  {
    case "werkstatt":
      return ({ "Martin raeumt einige Regale ein.\n",
                "Martin sortiert einige Geschenke.\n",
                "Martin schnitzt eine Figur.\n",
                "Martin kehrt die Saegespaene zusammen.\n",
                "Martin sagt: Ich bastle total gerne!\n",
		"Martin fragt Dich: Brauchst Du Weihnachtsschmuck?\n",
		"Martin blaest einige Weihnachtskugeln.\n",
                }) + Query(P_CHATS);
    case "vorraum":
      return ({ "Martin lungert hier herum.\n",
                "Martin setzt sich auf den Boden und seufzt.\n",
                "Martin sagt: Hier kann ich nirgends allein sein.\n",
                 }) + Query(P_CHATS);
    case "bad":
      return ({ "Martin putzt sich die Zaehne.\n",
                "Martin stylt sich seine Haare mit viel zu viel Haargel.\n",
                "Martin buerstet sich die Haare.\n",
                "Martin waescht sich die Haare.\n",
                "Martin nimmt ein heisses Bad.\n",
                "Martin sagt: Ich bin ein gepflegter Zwerg!\n",
		"Martin duftet herrlich frischgeduscht.\n",
		"Martin sagt: Frisch geduscht, fuehl ich mich am wohlsten.\n",
                }) + Query(P_CHATS);
   
    case "wkueche":
      return ({ "Martin nimmt sich einen Teller Suppe.\n",
                "Martin sagt: Ich haette gerne Topfennockerln!\n",
                "Martin loeffelt zufrieden seine Suppe.\n",
                "Martin trinkt ein Glas frische Milch.\n",
                "Martin knuddelt Estefania.\n",
                "Martin macht schnell den Abwasch.\n",
                "Martin isst ein Stueck Haselnusskuchen.\n",
                "Martin fragt Dich: Kennst Du Woody?\n",
                "Martin setzt sich auf einen Stuhl.\n",
                "Martin zupft Estefania ungeduldig am Rockzipfel.\n"
                "Martin sagt: Lecker hast Du gekocht Mami!\n",
                "Martin gruebelt.\n",
                "Martin streift seine Aermel zurueck.\n",
                }) + Query(P_CHATS);
    case "wzimmer":
      return ({ "Martin setzt sich auf das Sofa.\n",
                "Martin sagt: Einer der Struempfe da gehoert mir.\n"
                "Martin fragt den Weihnachtsmann etwas.\n",
                "Martin plaudert mit dem Weihnachtsmann.\n"
                "Martin verpetzt Elijah.\n",
                "Martin laechelt Dich freundlich an.\n",
                "Martin versucht, einen Blick in seinen Strumpf zu erhaschen.\n",
		"Martin setzt sich vor den Kamin.\n",
                }) + Query(P_CHATS);
    case "schlafz":
      return ({ "Martin zieht sich einen Pyjama an.\n"
                "Martin legt sich ins Bett und schlaeft.\n",
                "Martin wacht auf und klettert aus dem Bett.\n",
                "Martin zieht sich frische Klamotten an.\n",
		"Martin fragt Dich: Kuschelst mit mir unter der Decke?\n",
                "Martin sagt: Finja hat hier irgendwo ihr Tagebuch.\n"
                "Martin sagt: Ich suche seit Tagen nach Finjas Tagebuch.\n",
                "Martin denkt . o O (Vielleicht schreibt Finja was ueber mich).\n",
                }) + Query(P_CHATS);
    case "vorgarten":
      return ({ "Martin bricht einen Ast vom Baum.\n",
                "Martin sagt: Ich suche frisches Holz fuer meine Figuren.\n",
                "Martin streichelt ein Rehkitz.\n"
                "Martin sagt: Suess bist!\n",
                "Martin nimmt etwas Schnee.\n",
                "Martin baut einen Schneemann.\n",
                "Martin sagt: Der Schneemann sieht Dir aehnlich!\n",
                "Martin plaudert mit Arion.\n",
                "Martin wirft einen Schneeball nach Arion.\n",
                "Martin blickt Dich mit seinen strahlend gruenen Augen an.\n",
                "Martin nimmt ein paar Steine.\n",
                "Martin fuettert die Hasen.\n",
                }) + Query(P_CHATS);
    default: return Query(P_CHATS);
  }
}
