inherit "std/npc";
#include "../def.h"


void init()
{ 
  ::init();


 if ( TP->name() == "Arion"&& find_call_out("arion")==-1)
   call_out("arion", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);

  if ( TP->name() == "Athenia"&& find_call_out("athenia")==-1)
   call_out("athenia", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);

 if ( TP->name() == "wmann"&& find_call_out("wmann")==-1)
   call_out("wmann", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);

 if ( TP->name() == "Das Christkind"&& find_call_out("christkind")==-1)
   call_out("christkind", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);
 
 if ( TP->name() == "Aaliyah"&& find_call_out("aaliyah")==-1)
   call_out("aaliyah", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);
}
 void hallo()

{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&& !InFight())
    tell_room(MENV, "Martin begruesst Dich freundlich.\n");
}
 



void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Martin, das Zwergenkind");
  SetProp(P_LONG,
    "Martin ist ein kleines Zwergenkind im Alter von etwa 10 Jahren. Er hat "
    "huebsche, gruene Augen und kurze, schwarzbraune Haare. Er ist fuer sein "
    "Alter aeusserst klug und ist sehr lieb und hilfsbereit. Obwohl er von "
    "sehr schlanker Statur ist, hat er eine enorme Kraft in seinen Armen. "
    "Er ist fuer einen Zwerg sehr sauber und reinlich und riecht auch immer "
    "frisch geduscht.");
    
  SetProp(P_NAME, ({"Martin, das Zwergenkind",
                    "Martin, des Zwergenkindes", 
                    "Martin, dem Zwergenkind",
                    "Martin, das Zwergenkind"}));
   
  SetProp(P_GENDER, MALE);
  AddId(({"martin","zwerg","zwergenkind","kind","martin das zwergenkind"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("martin");

  create_default_npc(2,300);
  SetProp(P_HANDS, ({" mit seinen magischen Haenden",300,DT_MAGIC}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 100);
  SetProp(P_WEIGHT, 7000);
  SetProp(P_ALIGN, 0);
  SetProp(P_SMELL, "Martin riecht herrlich frisch geduscht.\n");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 10);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetChats(1, ({"Martin kratzt sich am Kopf.\n"}));
   
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      -1.0, DT_WATER:  -1.0, DT_AIR:   0.0, 
      DT_LIGHTNING: -1.0, DT_EXPLOSION: 0.1, DT_SOUND:  0.2, DT_LIGHT:  0.0,
      DT_ELECTRIC:  -1.0, DT_ACID:      0.2, DT_POISON: 0.2, DT_TERROR: 0.1,
      DT_HOLY:      -1.0, DT_UNHOLY:    0.1, DT_MAGIC:  -1.0, DT_MIND:   0.2,
      DT_BLUDGEON:   0.1 ,DT_PIERCE: -1.0,   DT_SLASH:  0.1]) );

  SetProp(P_MSGIN, "rennt froehlich herein");
  SetProp(P_MSGOUT, "rennt kichernd");
  SetProp(P_MMSGIN, "kommt aus seinem Versteck hervor");
  SetProp(P_MMSGOUT, "versteckt sich");
  SetProp(P_NOATTACK, "steht unter dem Schutz des Weihnachtsmannes.");
 

  AddInfo(DEFAULT_INFO, "sagt: Hahaha! Woher soll ich das wissen?");

  AddInfo( ({"weihnachtsmann","papa","papi","vater"}),
     "Der Weihnachtsmann ist mein Papa. Ich helfe ihm beim Verkauf der "
     "Waren und auch manchmal bei der Herstellung, wobei mir das Verkaufen "
     "echt lieber ist.","sagt: ");
  
 
  
  AddInfo( ({"mama","mutter","estefania"}), 
    "Meine Mama heisst Estefania. Sie kocht sehr gut und strickt fuer mich "
    "immer meine warmen Pullis.", "sagt: ");
  
  AddInfo( ({"arion"}),
    "Arion zieht mich immerzu auf! Er nennt mich nie beim Namen und sagt "
    "immer nur Zwerg zu mir! Das geht mir ganz schoen auf die Nerven. Aber "
    "irgendwann bekommt er das zurueck! Der macht das doch nur, um den "
    "Frauen zu imponieren!","schimpft: ");
  
  AddInfo( ({"zwerg"}),
     "Ja! Ich bin ein Zwerg! Aber ich hab auch einen Namen!","schreit: ");
  
  AddInfo( ({"frauen","maedels"}),
     "Finja, Athenia und Thalyah sind unsere Maedels hier. Estefania zaehlt "
     "nicht, die ist nur meine Mami.","sagt grinsend: ");
  
  AddInfo( ({"athenia"}),
     "Athenia ist eine ganz Liebe. Sie verteidigt mich immer, wenn Arion mich "
     "aufzieht.","sagt: ");
  
  AddInfo( ({"thalyah"}),
     "Mit Thalyah spiele ich immer verstecken. Ich find sie halt nie, weil sie "
     "so klein ist, dass sie ueberall hineinkriechen kann.","sagt: ");
  
  AddInfo( ({"finja"}), 
     "Finja find ich toll! Ich liebe Feen. Sie haben so schoene Fluegel und "
     "sind einfach niedlich.","sagt: ");
  
  AddInfo( ({"feen"}),
     "Feen finde ich wirklich super!","sagt: ");
  
  AddInfo( ({"fluegel"}),
     "Ich haette auch gern welche.","sagt: ");

  AddInfo( ({"weihnachten","fest"}),
     "Weihnachten ist das Fest der Liebe sagt meine Mutter immer.","sagt: ");

  AddInfo( ({"liebe"}),
     "Ich liebe meine Schneehasen, meine Holzfiguren, meine Teddybaeren und "
     "auch ein bisschen Finja.","sagt: ");

  AddInfo( ({"schneehasen"}),
     "Die Schneehasen gehoeren mir! Die liebe ich ueber alles.","sagt: ");

  AddInfo( ({"teddybaeren","baeren","lieblingsteddy"}),
     "Meinen Lieblingsteddy liebe ich besonders.","sagt: ");

  AddInfo( ({"sex"}),
     "Ich bin erst 10!!! Woher soll ich das wissen? Wieso fragst Du ein "
     "Kind solche Dinge?!","sagt empoert: ");
  
   
  
  
  
  AddInfo( ({"elijah"}),
     "Ich glaub, der ist eifersuechtig auf mich, weil ich mich so gut mit "
     "Thalyah verstehe.","sagt laechelnd: ");
  
  AddInfo( ({"puppe","puppen"}),
     "Ja wir stellen hier Puppen her. Athenia formt sie aus Magie und naeht "
     "ihre Kleidung, und Finja bemalt sie und verpasst ihnen Haare und "
     "Wimpern. Das geht ganz gut, da sie so kleine Fingerchen hat.","sagt: ");
  
  AddInfo( ({"figuren","zwerge"}),
     "Ich schnitze die Figuren aus Holz. Elfen, Zwerge und noch vieles mehr. "
     "Ausserdem blase ich die Weihnachtskugeln.","sagt: ");
  
  AddInfo( ({"elfen"}),
     "Elfenfiguren sind eher was fuer Dunkelelfen. Ich schnitze jede von "
     "ihnen mit einem hochnaesigem Blick. Sollte ja so natuerlich wie "
     "moeglich aussehen.","sagt: ");
  
  AddInfo( ({"dunkelelfen"}),
     "Dunkelelfen mag ich nicht. Die sind immer so unfreundlich."," sagt: ");
     
  AddInfo( ({"weihnachtskugeln","weihnachtskugel"}),
     "Die Weihnachtskugeln werden aus Glas geblasen. Thalyah malt sie meistens "
     "mit Glitzerzeug an.","sagt: ");
 
    
  AddInfo( ({"tiere"}),
     "Tiere gibt es hier viele. Arion achtet darauf, dass es ihnen immerzu "
     "gut geht.","sagt: ");

  
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Martin sagt: Uiii! Jetzt hab ichs kaputt gemacht!\n" }) );

  
  SUID;
  CLONEME( "/d/ebene/obj/waffe/taschenmesser" );
  command("zuecke messer");
  CLONEME( ARMOUR "wsocken" );
  CLONEME( ARMOUR "turnschuhe" );
  CLONEME( ARMOUR "latz" );
  CLONEME( ARMOUR "pulli" );
  command("trage alles");

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
  case "fies":
      if( random(2) )
        call_out("react", 0, "sagt: Lass das, ich hass das!",
          "sagt: "+TP->name(WER)+" lass das, ich hass das!");
      else
        call_out("angriff",0);
      break;
  case "aergerlich":
      call_out("react", 0, "fragt: Gehts noch "+TPN+"?",0);
      break;
  case "traurig":
      call_out("react", 0, "nimmt Dich troestend in die Arme.",
             "troestet "+TP->name(WEN)+" sanft.");
      break;
  case "albern":
      call_out("react", 0, "laechelt.",0);
       break;
  case "neutral":
      call_out("react", 0, "ignoriert Dich.", "beachtet "+TP->name(WEN)+
		      " nicht.");
      break;
  case "intim":
      call_out("react", 0, "haut Dich.", "schlaegt "+TP->name(WEN)+" fest.");
      break;
  case "froh":
      call_out("react", 0, "laechelt Dich froehlich an.",
             "laechelt "+TP->name(WEN)+" froehlich an.");
      break;
    case "aengstlich":
      call_out("react", 0, "legt beschuetzend seine Arme um Dich.",
             "umarmt "+TP->name(WEN)+" beschuetzend.");
      break;
  case "frech":
      call_out("react", 0, "grummelt Dich an.", "grummelt "+TP->name(WEN)+" an.");
      break;
  case "nett":
	          call_out("react", 0, "knuddelt Dich.", "knuddelt "
				  +TP->name(WEN)+" lieb.");
      break;
  }
}
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}

  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
    tell_room(ENV(TO), Name(WER, 1)+" seufzt: Nun musst Du sterben.\n");
    Kill(TP);
  }
}

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}
 void arion()
{
  if (TP && MENV && present(TP, MENV))
  {
    write("Martin begruesst Dich.\n");
    tell_room(MENV, "Martin schreit Arion an: Ich hab auch einen Namen!\n", ({TP}));
  }

 }

