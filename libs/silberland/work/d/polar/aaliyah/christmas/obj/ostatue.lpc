inherit "std/thing";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine Ogerstatue");
  SetProp(P_LONG, 
    "Gross und plump wirkt diese Statue. Aber sie ist auch ein exaktes Abbild "
    "eines jungen Ogers. Sie wirkt lebensecht und in einem Wohnzimmer wuerde "
    "sie fuer gewisse Leute sicher eine schoene Zierde sein.");
  SetProp(P_NAME, "Ogerstatue");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 0); 
  AddId( ({"ogerstatue","statue"}) );
  SetProp(P_WEIGHT, 3000);
  SetProp(P_SIZE, 180);
  SetProp(P_VALUE, 12000);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, ([MAT_CRYSTAL:100]));
//  SetProp(P_NAME_ADJ, "suess");
 
   
}  
   
