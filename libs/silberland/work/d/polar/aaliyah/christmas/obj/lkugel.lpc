// 
// Christmas Creations - Christbaumschmuck

inherit "std/thing";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


   void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine zartlila Christbaumkugel");
  SetProp(P_LONG, 
    "Eine wunderschoene, zartlila Christbaumkugel. Sie wurde mit glitzernden "
    "Schnoerkeln verziert und ist sicher eine schoene Zierde fuer den "
    "Weihnachtsbaum. Ausserdem hat sie ein zartes Muster aus feinen "
    "violetten Blumen.");
  SetProp(P_NAME, "Christbaumkugel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 0); 
  AddId( ({"christbaumkugel","zartlila christbaumkugel","kugel"}) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 160);
  SetProp(P_NOSELL, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ, "zartlilan");
  SetProp(P_MATERIAL, ([MAT_GLASS:100]));
  	  
}  
   
