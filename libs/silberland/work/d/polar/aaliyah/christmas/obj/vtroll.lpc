inherit "std/food";
#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Ein Vanilletroll");
  SetProp(P_LONG, 
    "Ein superleckerer kleiner Troll, der vollkommen aus Bourbonvanille "
    "besteht.");
  SetProp(P_NAME, "Vanilletroll");
  SetProp(P_INFO, "Vanille und Troll, saettigt Dich voll.");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 150);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, MAT_FOOD);
  SetProp(P_SMELL, "Der Vanilletroll duftet nach Vanille.\n");
  AddId(({"vanilletroll","troll"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:2, F_SOAK:9, F_ALCOHOL: 0,
      F_MSG: "Du verspeist den Vanilletroll und fuehlst Dich satt.\n",
      F_MSG_ROOM: "verspeist einen Vanilletroll.\n" ]));

 }
  
 void init()
 {
  ::init();
  if (TP && interactive(TP) && query_decay() == -1)
    start_decay(172800, 31200);
 }            

	
