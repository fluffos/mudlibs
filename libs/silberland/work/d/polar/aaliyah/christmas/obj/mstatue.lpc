// Christmas Creations 

inherit "std/thing";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine Menschenstatue");
  SetProp(P_LONG, 
    "Ein Paerchen bildet diese Statue. Der Mann, schlank, athletisch und mit "
    "nur einem Schurz um die Lenden, haelt die Hand seiner Angebeteten, einer "
    "huebschen, schlanken Menschensfrau, und blickt verliebt in ihre Augen. "
    "Irgendwie aehnelt der Mann Justavius, aber so ganz sicher bist Du Dir "
    "da nicht. Fuer Romantikliebhaber ist diese Statue als Zierde sicher "
    "wie geschaffen, nur ist es halt nicht jedermanns Geschmack, sie in seinem "
    "Seherhaus aufzustellen.");
  SetProp(P_NAME, "Menschenstatue");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 0); 
  AddId( ({"menschenstatue","statue"}) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_SIZE, 185);
  SetProp(P_VALUE, 10000);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, ([MAT_CRYSTAL:100]));
//  SetProp(P_NAME_ADJ, "suess");
 
  AddDetail( ({"justavius","mann"}),
	"Ja! Der Mann sieht aus wie Justavius! Unglaublich diese Aehnlichkeit.");
   
}  
   
