// 
// Christmas Creations - Christbaumschmuck

inherit "std/thing";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


   void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine schoene Christbaumspitze");
  SetProp(P_LONG, 
    "Eine schoene Christbaumspitze. Sie dient dazu, die Spitze des Baumes "
    "zu schmuecken. Sie glitzert und funkelt in edlen Farben.");
  SetProp(P_NAME, "Christbaumspitze");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 0); 
  AddId( ({"christbaumspitze","spitze"}) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 500);
  SetProp(P_NOSELL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ, "schoen");
  SetProp(P_MATERIAL, ([MAT_CRYSTAL:100]));

  AddDetail( ({"farben"}),
	"Alle moeglichen Blautoene, Rottoene, Gruentoene, Gelbtoene. Die "
	"Farben sind so einzigartig, dass man sie nicht definieren kann.");
  	  
}  
   
