inherit "std/food";
#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Ein Geleeringerl");
  SetProp(P_LONG, 
    "Ein suesses, blaues Geleeringerl. Es besteht aus Gelee und wurde mit "
    "Kristallzucker bestreut.");
  SetProp(P_NAME, "Geleeringerl");
  SetProp(P_INFO, "Das Ringerl aus Gelee, schuetzt Dich vor einer Fee!");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 10);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, MAT_FOOD);
  SetProp(P_SMELL, "Das Geleeringerl sagt: Ich rieche nach gar nichts!\n");
  AddId(({"geleeringerl","ringerl"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:2, F_SOAK:1, F_ALCOHOL: 0,
      F_MSG: "Du isst das Geleeringerl und moechtest noch eines haben.\n",
      F_MSG_ROOM: "nascht ein Geleeringerl.\n" ]));

 }
  
 void init()
 {
  ::init();
  if (TP && interactive(TP) && query_decay() == -1)
    start_decay(172800, 31200);
 }            

	
