inherit "std/food";
#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Ein Mensch (glasiert)");
  SetProp(P_LONG, 
    "Ein kleiner Mensch aus Apfel mit einer rosaroten Glasur.");
  SetProp(P_NAME, "Mensch (glasiert)");
  SetProp(P_INFO, "Einen Menschen im Magen, kann man nichts mehr fragen.");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 50);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, MAT_FOOD);
  SetProp(P_SMELL, "Der Mensch duftet nach Apfel.\n");
  AddId(({"mensch(glasiert)","mensch"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:2, F_SOAK:1, F_ALCOHOL: 0,
      F_MSG: "Du knusperst genuesslich den Menschen.\n",
      F_MSG_ROOM: "knuspert einen glasierten Menschen.\n" ]));

 }
  
 void init()
 {
  ::init();
  if (TP && interactive(TP) && query_decay() == -1)
    start_decay(172800, 31200);
 }            

	
