// 8.11.2005
// by Aaliyah
// 
// Christmas Creations - Adventkranz

inherit "std/thing";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>

string kerzen = "";
string loesch = "";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein schoener Adventskranz");
  SetProp(P_LONG, 
      "Ein wunderschoener Adventskranz. Seine Tannennadeln wirken saftig gruen "
      "und wurden mit kleinen, goldenen Christbaumkugeln verziert. Ausserdem "
      "wird er noch von zartem, goldenem Engelshaar, einer grossen weinroten "
      "Schleife und einigen Zimtstangen verziert. Vier grosse, goldene Kerzen "
      "befinden sich darauf.");
  SetProp(P_NAME, "Adventskranz");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 0); 
  AddId( ({"adventskranz","kranz"}) );
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 1600);
  SetProp(P_NOSELL, 1);
  SetProp(P_SMELL, "Der Adventskranz duftet herrlich nach Wald und Zimt.\n");
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ, "schoen");
  SetProp(P_MATERIAL, ([MAT_MAGIC:100]));

  AddDetail( ({"tannennadeln","nadeln"}),
      "Die Tannennadeln des Kranzes sind gruen und saftig.");

  AddDetail( ({"christbaumkugeln","kugeln","kugel","christbaumkugel"}),
      "Die Christbaumkugel haben eine goldene Farbe und ein glitzerndes "
      "Muster.");

  AddDetail( ({"muster"}),
      "Das Muster stellt Eisblumen dar.");

  AddDetail( ({"eisblumen","blumen"}),
      "Schoene, glitzernde Eisblumen zieren die Christbaumkugeln.");

  AddDetail( ({"farbe"}),
      "Der Advendskranz ist gold, weinrot und natuerlich gruen.");

  AddDetail( ({"schleife"}),
      "Die Schleife ist weinrot und hat goldene Sprenkel.");

  AddDetail( ({"sprenkel"}),
      "Golden!");

  AddDetail( ({"engelshaar","engelhaar","haar"}),
      "Das Engelshaar ist goldig glaenzend und sehr sehr fein.");

  AddDetail( ({"zimtstangen","zimt","stangen"}),
      "Einfache Zimtstangen zieren den Kranz.");

  AddDetail( ({"kerzen"}),
      "Vier goldene Kerzen wurden am Kranz befestigt.");

  AddCmd(({"zuend", "zuende"}), "c_zuenden");
}  

string adventsonntag()
{
  string m;
  int d;

  d = to_int(dtime()[5..6]);
  m = dtime()[9..11];
  if ((m == "Nov" && d >= 27) || (m == "Dez" && d < 4))
  {
    kerzen = " Eine Kerze brennt.";
    loesch = "Die Kerze des Adventskranzes erlischt.\n";
    return "eine Kerze";
  }
  else if (m == "Dez")
  {
    if (d < 11)
    {
      kerzen = " Zwei Kerzen brennen.";
      loesch = "Die Kerzen des Adventskranzes erloeschen.\n";
      return "zwei Kerzen";
    }
    else if (d < 18)
    {
      kerzen = " Drei Kerzen brennen.";
      loesch = "Die Kerzen des Adventskranzes erloeschen.\n";
      return "drei Kerzen";
    }
    else if (d <= 24)
    {
      kerzen = " Vier Kerzen brennen.";
      loesch = "Die Kerzen des Adventskranzes erloeschen.\n";
      return "vier Kerzen";
    }
  }
  return "keine Kerze";
}

int c_zuenden(string str)
{
  string nr;
  notify_fail("Was willst Du anzuenden?\n");
  if (!str || member(({"kranz an", "adventskranz an", "kerze von adventskranz an",
          "kerzen von adventskranz an", "kerze des adventskranzes an", "kerze an",
          "kerzen des adventskranzes an"}), str) == -1)
    return 0;
  if (kerzen != "")
  {
    write("Aber die Kerzen brennen doch schon\n");
    return 1;
  }
  nr = adventsonntag();
  write("Du zuendest "+nr+" des Adventskranzes an.\n");
  say(TPN+ " zuendet "+nr+" des Adventskranzes an.\n");
  call_out("erloeschen", 1800);
  return 1;
}

string _query_long()
{
  return BS(
      "Ein wunderschoener Adventskranz. Seine Tannennadeln wirken saftig gruen "
      "und wurden mit kleinen, goldenen Christbaumkugeln verziert. Ausserdem "
      "wird er noch von zartem, goldenem Engelshaar, einer grossen weinroten "
      "Schleife und einigen Zimtstangen verziert. Vier grosse, goldene Kerzen "
      "befinden sich darauf." + kerzen );
}

void erloeschen()
{
  kerzen = "";
  if (!environment())
    return;
  if (interactive(environment()))
    tell_object(environment(), loesch);
  else
    tell_room(environment(), loesch);
}

