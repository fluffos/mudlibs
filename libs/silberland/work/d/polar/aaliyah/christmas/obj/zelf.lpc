inherit "std/food";
#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Ein Zuckerelf");
  SetProp(P_LONG, 
    "Ein leckerer kleiner Zuckerelf. Er besteht aus Zucker und hat eine "
    "Nougatfuellung.");
  SetProp(P_NAME, "Zuckerelf");
  SetProp(P_INFO, "Der Elf im Herz, bringt niemals Kummer und Schmerz.");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 350);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, MAT_FOOD);
  SetProp(P_SMELL, "Der Zuckerelf duftet herrlich blumig.\n");
  AddId(({"zuckerelf","elf"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:2, F_SOAK:1, F_ALCOHOL: 0,
      F_MSG: "Du verspeist genuesslich den Zuckerelf und ploetzlich wird Dir "
      "ganz warm ums Herz.\n",
      F_MSG_ROOM: "nascht genuesslich einen Zuckerelfen.\n" ]));

 }
  
 void init()
 {
  ::init();
  if (TP && interactive(TP) && query_decay() == -1)
    start_decay(172800, 31200);
 }            

	
