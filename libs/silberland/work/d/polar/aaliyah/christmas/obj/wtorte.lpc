// Christmas - Creations

inherit "std/food";
#include <properties.h>
#include <food.h>
#include "../def.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Stueck Waldbeerentorte");
  SetProp (P_LONG, "Ein grosses Stueck Waldbeerentorte. Es hat eine schoene "
	   "hellrosa Glasur mit einem Sahneklecks darauf. Einige Beeren "
	   "wurden zur Zierde hineingedrueckt. Inmitten des flaumigen Teiges "
	   "befindet sich eine Waldbeerencreme.");
     
  SetProp (P_NAME, "Stueck Waldbeerentorte");
  SetProp (P_GENDER, NEUTER);
  AddId (({"waldbeerentorte","stueck","tortenstueck","waldbeerentortenstueck"}));
  SetProp (P_INFO, ("Das Stueck Waldbeerentorte schmeckt sicher lecker."));

  SetProp (P_VALUE, 10);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL: 30, F_SOAK: 4, F_ALCOHOL: 0, F_POISON:0,
  F_MSG: "Du verspeist das Tortenstueck mit hoechstem Genuss.\n",
  F_MSG_ROOM: " verspeist ein Stueck Waldbeerentorte.\n"]));
 
}

