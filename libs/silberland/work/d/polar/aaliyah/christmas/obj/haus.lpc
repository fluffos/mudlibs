// Christmas Creations 

inherit "std/thing";
#include "../def.h"
#include <properties.h>
#include <combat.h>



create()
{
  if (!is_clone(ME)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein suesses Puppenhaus");
  SetProp(P_LONG, 
    "Ein schoenes, grosses Puppenhaus mit drei Zimmern. Ein kleines "
    "Schlafzimmer, ein kleines Wohnzimmer und ein kleines Badezimmer. "
    "Es ist nicht zum Spielen gedacht, sondern wurde vom Weihnachtsmann "
    "fuer seine Wichtel als Wohnraum geschaffen.");
  SetProp(P_NAME, "Puppenhaus");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"puppenhaus","haus"}) );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 2000);
  SetProp(P_MATERIAL, ([MAT_WOOD:100]));
  SetProp(P_NAME_ADJ, "suess");
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_SIZE, 100);
  SetProp(P_ARTICLE, 1);

  AddDetail( ({"zimmer"}),
	"Das suesse Puppenhaus hat drei davon. Ein Badezimmer, ein Wohnzimmer "
	"und ein Schlafzimmer.");

  AddDetail( ({"badezimmer","bad"}),
	"Ein kleines suesses Bad mit einer Miniaturtoilette und einer "
	"Miniaturbadewanne.");

  AddDetail( ({"wohnzimmer"}),
	"Ein kleines Wohnzimmer mit einer Miniaturcouch und einer "
	"Miniaturkommode.");

  AddDetail( ({"schlafzimmer"}),
	"Ein kleines Schlafzimmer mit einem Miniaturbett und einem "
	"Miniaturschrank.");
   
   
   
}  
   
