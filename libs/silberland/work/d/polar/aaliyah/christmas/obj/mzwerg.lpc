inherit "std/food";
#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Ein Marzipanzwerg");
  SetProp(P_LONG, 
    "Dieser kleine Marzipanzwerg sieht einfach suess aus. Er sieht Woody "
    "zum Verwechseln aehnlich und schmeckt sicherlich total lecker.");
  SetProp(P_NAME, "Marzipanzwerg");
  SetProp(P_INFO, "Woody am Baum, ist die schoenste Zierde im Raum!");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 100);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, MAT_FOOD);
  SetProp(P_SMELL, "Der Marzipanzwerg duftet herrlich nach Marzipan.\n");
  AddId(({"marzipanzwerg","zwerg"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:10, F_SOAK:1, F_ALCOHOL: 0,
      F_MSG: "Du isst den Marzipanzwerg und er schmeckt goettlich.\n",
      F_MSG_ROOM: "geniesst einen goettlichen Marzipanzwerg.\n" ]));

 }
  
 void init()
 {
  ::init();
  if (TP && interactive(TP) && query_decay() == -1)
    start_decay(172800, 31200);
 }            

	
