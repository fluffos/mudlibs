// Christmas - Creations


#include "../def.h"
#include <properties.h>
inherit "/std/container";



create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Weihnachtsstrumpf");
  SetProp(P_LONG, BS("Ein schoener, gestrickter Weihnachtsstrumpf. Ein "
	"huebsches Weihnachtsmuster wurde darauf gestickt. Ausserdem ist er "
	"mit zwei Goldbordueren verziert. Man kann kleine Geschenke in "
	"ihn hineinlegen."));
  AddId(({"weihnachtsstrumpf", "strumpf"}));
  SetProp(P_NAME, "Weihnachtsstrumpf");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 150);
  SetProp(P_MAX_WEIGHT, 1000);
  SetProp(P_VALUE, 780);
  SetProp(P_INFO, BS("Fuell diesen Strumpf mit kleinen Geschenken."));
  SetProp(P_MATERIAL, ([MAT_WOOL:100]));

  
}


