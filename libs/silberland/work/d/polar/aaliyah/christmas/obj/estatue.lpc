inherit "std/thing";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine Elfenstatue");
  SetProp(P_LONG, 
    "Eine grosse, schlanke und sehr huebsche Elfe wurde als Vorlage fuer diese "
    "Statue genommen. Die Statue wirkt fast lebensecht und ist gewiss eine "
    "schoene Zierde fuer jedes Seherhaus.");
  SetProp(P_NAME, "Elfenstatue");
  SetProp(P_SIZE, 190);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 0); 
  AddId( ({"elfenstatue","statue"}) );
  SetProp(P_WEIGHT, 2500);
  SetProp(P_VALUE, 10000);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, ([MAT_CRYSTAL:100]));
//  SetProp(P_NAME_ADJ, "suess");
 
   
}  
   
