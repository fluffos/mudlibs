inherit "std/food";
#include <properties.h>
#include <food.h>
#include "../def.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Dose mit Pilzragout");
  SetProp (P_LONG, "Eine Dose mit frisch zubereitetem Pilzragout und Knoedeln.");
     
  SetProp (P_NAME, "Dose mit Pilzragout");
  SetProp (P_GENDER, FEMALE);
  AddId (({"dose","pilzragout"}));
  SetProp (P_INFO, ("Das Pilzragout stammt aus dem Haus des Weihnachtsmannes."));

  SetProp (P_VALUE, 50);
  SetProp (P_WEIGHT, 300);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL: 40, F_SOAK: 6, F_ALCOHOL: 0, F_POISON:0,
  F_MSG: "Du oeffnest die Dose und geniesst das herrliche Pilzragout.\n",
  F_MSG_ROOM: " oeffnet eine Dose und isst Pilzragout daraus.\n"]));
 
}

