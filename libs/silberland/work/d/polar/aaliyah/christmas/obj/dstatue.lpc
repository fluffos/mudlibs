// Christmas Creations 

inherit "std/thing";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine Dunkelelfenstatue");
  SetProp(P_LONG, 
    "Duester, schlank und sehr lasziv raekelt sich diese huebsche Dunkelelfin "
    "auf einem Teppich aus purem Kristall. Ihre Blicke sind dermassen "
    "provokant, als haette sie mit dem Kuenstler, der diese Statue erschaffen "
    "hat, geliebaeugelt.");
  SetProp(P_NAME, "Dunkelelfenstatue");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SIZE, 170);
  SetProp(P_PLURAL, 0); 
  AddId( ({"dunkelelfenstatue","statue"}) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 10000);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, ([MAT_CRYSTAL:100]));
//  SetProp(P_NAME_ADJ, "suess");
 
   
}  
   
