inherit "std/food";
#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Eine Schokodrow");
  SetProp(P_LONG, 
    "Eine kleine Dunkelelfin aus Schokolade. Ihr Koerper besteht aus "
    "schwarzer Schokolade, lediglich ihr Kleid wurde aus weisser Schokolade "
    "gemacht.");
  SetProp(P_NAME, "Schokodrow");
  SetProp(P_INFO, "Drows im Magen, koennen nichts mehr sagen.");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 250);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, MAT_FOOD);
  SetProp(P_SMELL, "Die Schokodrow riecht schokoladig.\n");
  AddId(({"schokodrow","drow"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:2, F_SOAK:1, F_ALCOHOL: 0,
      F_MSG: "Du naschst gluecklich die leckere Schokodrow.\n",
      F_MSG_ROOM: "verspeist eine Schokodrow.\n" ]));

 }
  
 void init()
 {
  ::init();
  if (TP && interactive(TP) && query_decay() == -1)
    start_decay(172800, 31200);
 }            

	
