// Christmas Creations

inherit "std/lightsource";
#include "../def.h"
#include <properties.h>
#include <lightsource.h>


create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine Christbaumkerze");
  SetProp(P_LONG, 
    "Eine zarte, kleine, goldene Christbaumkerze. Du kannst sie anzuenden und "
    "auch wieder loeschen.");
  SetProp(P_NAME, "Christbaumkerze");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kerze","christbaumkerze"}) );
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 100);
  SetProp(P_NAME_ADJ, "golden");
  SetProp(P_MATERIAL, ([MAT_WAX:100]));
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 30);
  SetProp(P_FUEL, 1500);
  SetProp(P_ARTICLE, 1);
  SetProp(P_LIGHTDESC,
      ({ "glimmend","flackernd","leicht flackernd","brennend",
         "hell lodernd","frisch angezuendet" }) );
 
}  
   
