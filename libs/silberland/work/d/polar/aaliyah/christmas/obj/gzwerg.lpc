inherit "std/thing";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Gartenzwerg");
  SetProp(P_LONG, 
    "Ein kleiner Gartenzwerg mit einer roten Zipfelmuetze und einem dicken "
    "grauen Bart.");
  SetProp(P_NAME, "Gartenzwerg");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 0); 
  AddId( ({"gartenzwerg","zwerg"}) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 150);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, ([MAT_WOOD:100]));
//  SetProp(P_NAME_ADJ, "suess");
 
   
}  
   
