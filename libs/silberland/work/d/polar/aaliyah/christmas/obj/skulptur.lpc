inherit "std/thing";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine Glasskulptur");
  SetProp(P_LONG, 
    "Eine grosse Glasskulptur. Sie stellt eine nackte Elfin dar, die sich "
    "mit einem Palmenblatt das Noetigste verhuellt.");
  SetProp(P_NAME, "Glasskulptur");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 0); 
  AddId( ({"glasskulptur","skulptur"}) );
  SetProp(P_WEIGHT, 2500);
  SetProp(P_VALUE, 12000);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, ([MAT_GLASS:100]));
//  SetProp(P_NAME_ADJ, "suess");
 
   
}  
   
