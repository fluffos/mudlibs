// Christmas Creations - Nekromantenflasche

inherit "std/thing";
#include "../def.h"
#include <properties.h>


   void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine alte Urne");
  SetProp(P_LONG, 
    "Die Urne scheint schon ziemlich alt zu sein. Viele alte Schriftzeichen "
    "befinden sich auf ihr. Sie ist von einer dunklen Aura umgeben.");
  SetProp(P_INFO, "In diese Urne kann man Untote bannen.");
  SetProp(P_NAME, "Urne");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 0); 
  AddId( ({"alte urne","urne"}) );
  SetProp(P_NAME_ADJ, "alt");
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 20);
  SetProp(P_NOSELL, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, ([MAT_MAGIC:100]));
  	  
}  
   
