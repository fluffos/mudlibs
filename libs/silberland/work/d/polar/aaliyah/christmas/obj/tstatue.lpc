inherit "std/thing";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine Trollstatue");
  SetProp(P_LONG, 
    "Diese Trollstatue stellt eine grosse Trollfrau mit extrem weiblichen "
    "Rundungen dar. Ihre grosse Brust und ihre weibliche Taille wird von einer "
    "schoenen Toga verhuellt. Diese Figur scheint das exakte Abbild von "
    "Buxtehude zu sein. Vielleicht ist sie auch dafuer Model gestanden, das "
    "weiss nur der Kuenstler. Jedenfalls ist die Statue eine perfekte Zierde "
    "fuer den Liebhaber von Rubensdamen.");
  SetProp(P_NAME, "Trollstatue");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 0); 
  AddId( ({"trollstatue","statue"}) );
  SetProp(P_WEIGHT, 3000);
  SetProp(P_SIZE, 200);
  SetProp(P_VALUE, 12000);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, ([MAT_CRYSTAL:100]));
//  SetProp(P_NAME_ADJ, "suess");
 
   
}  
   
