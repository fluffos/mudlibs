inherit "std/food";
#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Windbaeckerei");
  SetProp(P_LONG, 
    "Die Windbaeckerei ist rosarot und hat die Form eines Ringes. Sie schmeckt "
    "sicher zuckersuess.");
  SetProp(P_NAME, "Windbaeckerei");
  SetProp(P_INFO, "Zucker im Bauch, ist besser als Lauch!");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 70);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, MAT_FOOD);
  SetProp(P_SMELL, "Die Windbaeckerei duftet nach Zucker.\n");
  AddId(({"windbaeckerei","baeckerei"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:2, F_SOAK:1, F_ALCOHOL: 0,
      F_MSG: "Du beisst in die Windbaeckerei und es knackst zwischen Deinen "
      "Zaehnen.\n",
      F_MSG_ROOM: "beisst in eine Windbaeckerei.\n" ]));

 }
  
 void init()
 {
  ::init();
  if (TP && interactive(TP) && query_decay() == -1)
    start_decay(172800, 31200);
 }            

	
