// Christmas Creations - Weihnachtsleckereien


inherit "std/food";
#include <food.h>
#include <properties.h>
#include "../def.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Schokobanane.");
  SetProp (P_LONG, "Eine leckere Schokobanane. Sie ist mit einem gelben "
		  "Bananengelee gefuellt und wurde mit Vollmilchschokolade "
		  "ueberzogen.");
     
  SetProp (P_NAME, "Schokobanane");
  SetProp (P_GENDER, FEMALE);
  AddId (({"schokobanane", "banane"}));
  SetProp (P_INFO, ("Die Schokobanane macht Dich dicker."));

  SetProp (P_VALUE, 40);
  SetProp (P_WEIGHT, 10);
  SetProp (P_NOBUY, 0);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL: 2, F_SOAK: 1, F_ALCOHOL: 0, F_POISON:0,
  F_MSG: "Du verspeist die Schokobanane mit grossem Genuss.\n",
  F_MSG_ROOM: " verspeist die Schokobanane mit grossem Genuss.\n"]));
 
}

