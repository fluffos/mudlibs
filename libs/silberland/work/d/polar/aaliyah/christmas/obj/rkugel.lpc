inherit "std/food";
#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Eine Rumkugel");
  SetProp(P_LONG, 
    "Die Rumkugel ist eine kleine Schokoladenkugel mit einer Rumfuellung, die "
    "in Kokosraspeln gewaelzt wurde.");
  SetProp(P_NAME, "Rumkugel");
  SetProp(P_INFO, "Zuviel Rum, macht Dich dumm!");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, MAT_FOOD);
  SetProp(P_SMELL, "Die Rumkugel riecht nach Rum.\n");
  AddId(({"rumkugel","kugel"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:1, F_SOAK:0, F_ALCOHOL: 2,
      F_MSG: "Du steckst Dir die Rumkugel in den Mund und fuehlst Dich etwas "
      "beschwipst.\n",
      F_MSG_ROOM: "isst eine Rumkugel.\n" ]));

 }
  
 void init()
 {
  ::init();
  if (TP && interactive(TP) && query_decay() == -1)
    start_decay(172800, 31200);
 }            

	
