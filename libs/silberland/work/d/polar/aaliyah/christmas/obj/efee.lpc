inherit "std/food";
#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Eine Erdbeerfee");
  SetProp(P_LONG, 
    "Eine kleine Erdbeerfee. Sie ist klein und besteht aus Erdbeergelee.");
  SetProp(P_NAME, "Erdbeerfee");
  SetProp(P_INFO, "Diese Erdbeerfee lebt in Deinem Magen weiter.");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 150);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, MAT_FOOD);
  SetProp(P_SMELL, "Die Erdbeerfee duftet herrlich fruchtig nach Erdbeeren.\n");
  AddId(({"erdbeerfee","fee"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:10, F_SOAK:1, F_ALCOHOL: 0,
      F_MSG: "Du isst die Erdbeerfee und ploetzlich spuerst Du in Deinem "
      "Magen ein flatterndes Gefuehl.\n",
      F_MSG_ROOM: "verschluckt eine Erdbeerfee.\n" ]));

 }
  
 void init()
 {
  ::init();
  if (TP && interactive(TP) && query_decay() == -1)
    start_decay(172800, 31200);
 }            

	
