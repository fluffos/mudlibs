// by Aaliyah
// 
// Christmas Creations - Rotweingelee


inherit "std/food";
#include <food.h>
#include <properties.h>
#include "../def.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Glas Rotweingelee");
  SetProp (P_LONG, "Das Rotweingelee wurde frisch von Estefania zubereitet. "
		  "Es schmeckt sicher vorzueglich. Dir laeuft schon das "
		  "Wasser im Mund zusammen.");
     
  SetProp (P_NAME, "Glas Rotweingelee");
  SetProp (P_GENDER, NEUTER);
  AddId (({"rotweingelee","glas", "glas rotweingelee","gelee"}));
  SetProp (P_INFO, ("Das Rotweingelee schmeckt sicher herrlich."));

  SetProp (P_VALUE, 40);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL: 30, F_SOAK: 2, F_ALCOHOL: 1, F_POISON:0,
  F_MSG: "Du oeffnest das Glas und schleckst das ganze Rotweingelee aus.\n"
         "Hmmmmmmmjamm! Das war jetzt aber koestlich.\n",
  F_MSG_ROOM: " schleckt ein Glas mit Rotweingelee aus.\n"]));
 
}

