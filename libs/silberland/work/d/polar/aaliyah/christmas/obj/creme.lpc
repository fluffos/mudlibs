// 1.11.2005
// by Aaliyah
// 
// Christmas Creations - Erdbeercreme

inherit "std/food";
#include <food.h>
#include <properties.h>
#include "../def.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Schuessel Erdbeercreme");
  SetProp (P_LONG, "Eine Kristallschuessel mit koestlicher Erdbeercreme. "
		  "Frische Erdbeeren wurden dafuer verwendet, und sie schmeckt "
		  "sicherlich wunderbar.");
     
  SetProp (P_NAME, "Schuessel Erdbeercreme");
  SetProp (P_GENDER, FEMALE);
  AddId (({"creme","erdbeercreme","schuessel","schuessel mit erdbeercreme"}));
  SetProp (P_INFO, ("Die Erdbeercreme mundet Dir gewiss."));

  SetProp (P_VALUE, 40);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL: 20, F_SOAK: 2, F_ALCOHOL: 1, F_POISON:0,
  F_MSG: "Du graebst Dich in die Erdbeercreme und isst sie genuesslich aus. "
         "So was Leckeres hast Du schon lang nicht mehr gegessen. Als die "
	 "Creme leer ist, faellt Dir bloederweise die Schuessel auf den "
	 "Boden und ist kaputt. Schade!\n",
  F_MSG_ROOM: " isst Erdbeercreme.\n"]));
 
}

