inherit "std/food";
#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Eine Zuckerstange");
  SetProp(P_LONG, 
    "Eine rotweissrote Zuckerstange, welche die Form eines Regenschirmstockes "
    "hat. Sie sieht so lecker aus, dass Du sie am liebsten sofort aufessen "
    "willst.");
  SetProp(P_NAME, "Zuckerstange");
  SetProp(P_INFO, "Wer Zucker isst, wird nie vermisst!");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 40);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, MAT_SUGAR);
  SetProp(P_SMELL, "Die Zuckerstange riecht nach Zucker.\n");
  AddId(({"zuckerstange","stange"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:2, F_SOAK:1,
      F_MSG: "Du lutschst andaechtig auf Deiner Zuckerstange herum.\n",
      F_MSG_ROOM: "lutscht an einer Zuckerstange herum.\n" ]));

 }
  
 void init()
 {
  ::init();
  if (TP && interactive(TP) && query_decay() == -1)
    start_decay(172800, 31200);
 }            

	
