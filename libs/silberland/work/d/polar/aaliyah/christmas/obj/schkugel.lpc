// 
// Christmas Creations - Christbaumschmuck

inherit "std/thing";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


   void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine schneeweisse Christbaumkugel");
  SetProp(P_LONG, 
    "Eine wunderschoene, schneeweisse Christbaumkugel. Kleine, silberne "
    "Glitzersterne zieren sie und funkeln im Kerzenlicht. Sie ist sicher "
    "eine schoene Zierde fuer den Weihnachtsbaum.");
  SetProp(P_NAME, "Christbaumkugel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 0); 
  AddId( ({"christbaumkugel","schneeweisse christbaumkugel","kugel"}) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 160);
  SetProp(P_NOSELL, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ, "schneeweiss");
  SetProp(P_MATERIAL, ([MAT_GLASS:100]));
  	  
}  
   
