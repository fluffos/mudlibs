inherit "std/thing";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine Zwergenstatue");
  SetProp(P_LONG, 
    "Sportlich und sehr maennlich muss der Zwerg gewesen sein, der fuer diese "
    "Statue posiert hat. Der Zwerg hat eine einfache Axt in der Hand und "
    "steht in Kampfstellung. Diese Statue ist gewiss eine huebsche Zierde fuer "
    "jedes Seherhaus.");
  SetProp(P_NAME, "Zwergenstatue");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 0); 
  AddId( ({"zwergenstatue","statue"}) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_SIZE, 128);
  SetProp(P_VALUE, 10000);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, ([MAT_CRYSTAL:100]));
//  SetProp(P_NAME_ADJ, "suess");
 
   
}  
   
