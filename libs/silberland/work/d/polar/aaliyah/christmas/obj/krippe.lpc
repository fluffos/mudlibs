// Christmas Creations - Christbaumschmuck

inherit "std/thing";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


   void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine schoene Krippe");
  SetProp(P_LONG, 
    "Eine liebevoll gebaute Krippe aus Holz. Sie hat zwei Seitenwaende und "
    "ein kleines Dach. Die Vorderseite ist offen, sodass man einen Blick "
    "ins Innere hat. Der Boden wurde mit Moos und Stroh ausgelegt. Weiters "
    "erkennst Du Josef und Maria mit dem kleinen Jesukind. Ein Esel und ein "
    "Ochse ist auch noch dabei. Und Kaspar, Melchior und Balthasar knien vor "
    "dem Jesuskind und haben milde Gaben in der Hand.");
  SetProp(P_NAME, "Krippe");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SIZE, 70);
  SetProp(P_PLURAL, 0); 
  AddId( ({"krippe","schoene krippe"}) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 15000);
  SetProp(P_NOSELL, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ, "schoen");
  SetProp(P_MATERIAL, ([MAT_WOOD:100]));

  AddDetail( ({"josef"}),
	"Josef steht neben Maria und haelt ihre Hand. Er hat eine dunkelblaue, "
	"lange Kutte an.");  	  

  
  AddDetail( ({"maria"}),
	"Maria hat ein langes, hellrosa Kleid an. Ihre Haare werden von einem "
	"hellrosa Schleier verhuellt. Liebevoll blickt sie das Kind an.");  	  
  
  AddDetail( ({"kind","jesuskind","jesus","jesukind"}),
	"Das kleine Jesukind liegt, in eine weisse Decke gehuellt, in einer "
	"kleinen, mit Stroh gefuellten Krippe.");  	  
  
  
  AddDetail( ({"esel"}),
	"Ein grauer Esel mit grossen Ohren. Er gehoert der Familie.");  	  
  
  AddDetail( ({"ochse"}),
	"Ein grosser Ochse der im hinteren Winkel der Krippe steht.");  	  
  
  AddDetail( ({"melchior"}),
	"Melchior hat ein schoenes blaugoldenes Gewand an. In seiner Hand "
	"haelt er etwas Weihrauch, als Geschenk fuer das Jesukind.");  	

 
  AddDetail( ({"balthasar"}),
	"Balthasar ist in schoene, weinrotgoldene Gewaender gehuellt. In seiner "
	"Hand haelt er etwas Mhyrre, als Geschenk fuer das Jesukind.");  	    
 
  AddDetail( ({"kaspar"}),
	"Kaspar ist in ein dunkelgruengoldenes Gewand gehuellt und haelt in "
	"seiner Hand etwas Gold, als Geschenk fuer das Jesukind.");  	  
  
}  
   
