// Christmas Creations - Tannennadeln

inherit "std/thing";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Einige abgefallene Tannennadeln");
  SetProp(P_LONG, 
    "Einige abgefallene Tannennadeln, die schon etwas braun sind.");
  SetProp(P_NAME, "Tannennadeln");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1); 
  AddId( ({"tannennadeln","abgefallene tannennadeln","nadeln"}) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ, "abgefallen");
  SetProp(P_MATERIAL, ([MAT_WOOD:100]));
  	  
}  
   
