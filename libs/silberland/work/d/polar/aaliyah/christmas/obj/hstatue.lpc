inherit "std/thing";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine Hobbitstatue");
  SetProp(P_LONG, 
    "Klein, pelzig und dennoch weiblich wirkt diese Statue einer suessen "
    "Hobbitdame. Lebensecht laechelt sie Dich an und sieht in ihrem "
    "Kleidchen und der netten Kochschuerze einfach hinreissend aus. Sie ist "
    "sicher eine nette Zierde fuer ein Seherhaus.");
  SetProp(P_NAME, "Hobbitstatue");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SIZE, 150);
  SetProp(P_PLURAL, 0); 
  AddId( ({"hobbitstatue","statue"}) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 10000);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, ([MAT_CRYSTAL:100]));
//  SetProp(P_NAME_ADJ, "suess");
 
   
}  
   
