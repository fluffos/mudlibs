// Christmas Creations - Christbaumschmuck

inherit "std/thing";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


   void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Strohstern");
  SetProp(P_LONG, 
    "Ein kleiner Stern, der voellig aus Stroh besteht. Die Wichtel des "
    "Weihnachtsmannes haben ihn gebastelt.");
  SetProp(P_NAME, "Strohstern");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 0); 
  AddId( ({"strohstern","stern"}) );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 20);
  SetProp(P_NOSELL, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, ([MAT_STRAW:100]));
  	  
}  
   
