// by Aaliyah
// 
// Christmas Creations - Christbaumschmuck

inherit "std/thing";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


   void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Kristallstern");
  SetProp(P_LONG, 
    "Ein kleiner Stern aus Kristall. Wenn sich die Sonne in ihm bricht, "
    "funkelt er in allen Spektralfarben.");
  SetProp(P_NAME, "Kristallstern");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 0); 
  AddId( ({"kristallstern","stern"}) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 2000);
  SetProp(P_NOSELL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, ([MAT_CRYSTAL:100]));

  AddDetail( ({"farben","spektralfarben"}),
     "Das sind die Farben eines Regenbogens.");  
}  
   
