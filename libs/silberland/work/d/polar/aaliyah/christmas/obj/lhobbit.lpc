inherit "std/food";
#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Ein Lebkuchenhobbit");
  SetProp(P_LONG, 
    "Ein kleiner Hobbit aus Lebkuchen. Er wurde mit Mandeln verziert.");
  SetProp(P_NAME, "Lebkuchenhobbit");
  SetProp(P_INFO, "Ein Lebkuchenhobbit in der Hand ist besser als ein Elf "
		  "auf dem Baum.");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 150);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, MAT_FOOD);
  SetProp(P_SMELL, "Der Lebkuchenhobbit duftet nach Zimt.\n");
  AddId(({"lebkuchenhobbit","hobbit"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:2, F_SOAK:1, F_ALCOHOL: 0,
      F_MSG: "Du verspeist den Lebkuchenhobbit und wirst mit Liebe erfuellt.\n",
      F_MSG_ROOM: "verspeist einen Lebkuchenhobbit.\n" ]));

 }
  
 void init()
 {
  ::init();
  if (TP && interactive(TP) && query_decay() == -1)
    start_decay(172800, 31200);
 }            

	
