inherit "std/thing";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine Feenstatue");
  SetProp(P_LONG, 
    "Zierlich klein und extrem suess muss die Fee gewesen sein, die fuer diese "
    "Statue Model gestanden ist. Die Statue wirkt lebensecht und ist sicher "
    "eine Zierde fuer jedes Seherhaus.");
  SetProp(P_NAME, "Elfenstatue");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SIZE, 140);
  SetProp(P_PLURAL, 0); 
  AddId( ({"feenstatue","statue"}) );
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 10000);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, ([MAT_CRYSTAL:100]));
//  SetProp(P_NAME_ADJ, "suess");
 
   
}  
   
