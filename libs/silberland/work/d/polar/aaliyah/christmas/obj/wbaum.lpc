// by Aaliyah
// 
// Christmas Creations - Tannenbaum

inherit "std/thing";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein praechtiger Tannenbaum");
  SetProp(P_LONG, 
    "Ein praechtiger Tannenbaum. Er ist sicher drei Meter hoch und seine "
    "weiten Aeste sind mit schoenen gruenen Tannennadeln bespickt. Waere er "
    "geschmueckt, waere er noch viel viel schoener.");
  SetProp(P_NAME, "Tannenbaum");
  SetProp(P_GENDER, MALE);
  SetProp(P_SIZE, 250);
  SetProp(P_PLURAL, 0); 
  AddId( ({"tannenbaum","baum","christbaum"}) );
  SetProp(P_WEIGHT, 5000);
  SetProp(P_VALUE, 4000);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ, "praechtig");
  SetProp(P_MATERIAL, ([MAT_WOOD:100]));
  SetProp(P_TRANSPARENT, 0);
  	 
  AddCmd( ({"schmueck", "schmuecke"}), "c_schmuecken");
  AddCmd( ({"nimm"}), "c_nehmen");
}  

int c_schmuecken(string str)
{
  string wen, was;
  object ob;

  notify_fail("Wen oder was willst Du schmuecken?\n");
  if (!str || strstr(str, "baum") == -1)
    return 0;

  notify_fail("Mit was willst Du den Tannenbaum schmuecken?\n");
  if (sscanf(str, "%s mit %s", wen, was) != 2)
    return 0;
  if (!id(wen))
    return 0;
  
  notify_fail("Aber Du hast ja gar kein "+CAP(was)+"!\n");
  if (!(ob = present(was, TP)))
    return 0;

  write("Du schmueckst den Tannenbaum mit "+ob->name(WEM)+".\n");
  say(TPN+" schmueckt den Tannenbaum mit "+ob->name(WEM)+".\n");
  ob->move(TO);
  return 1;
}

int c_nehmen(string str)
{
  string wen, was;
  object ob;

  if (!str || strstr(str,"baum") == -1) 
    return 0;

  notify_fail("Was willst Du vom Baum nehmen?\n");
  if (sscanf(str, "%s vom %s", was, wen) != 2 &&
      sscanf(str, "%s von %s", was, wen) != 2)
    return 0;
  if (!id(wen))
    return 0;
 
  if (!(ob = present(was)))
  {
    write("Aber da ist ja gar kein "+CAP(was)+" auf dem Baum.\n");
    return -1;
  }

  if (ob->move(TP, M_GET) < 0)
    write("Aber Du kannst "+ob->name(WEN)+" gar nicht mehr tragen!\n");
  else
  {
    write("Du nimmst "+ob->name(WEN)+" vom Tannenbaum.\n");
    say(TPN+" nimmt "+ob->name(WEN)+" vom Tannenbaum.\n");
  }
  return 1;
}

void nadel_faellt_runter()
{
  if (!random(10))
  {
    environment()->Message("Einige Nadeln fallen vom Tannenbaum.\n", 
        MSGFLAG_VISUAL);
    clone_object(OBJ "tnadeln")->move(environment(), M_NOCHECK);
  }
}

void reset()
{
  if (!is_clone(TO)) return;
  ::reset();

  nadel_faellt_runter();
  if (dtime()[5..11] == " 6. Jan")
    remove();
  if (!environment())
    remove();
} 

string liste(object* obs)
{
  string ret;
  int i;

  ret = "";
  for (i = sizeof(obs) - 1; i >= 0; i--)
  {
    ret += obs[i]->name(WEM);
    if (i == 0)
      ;
    else if (i == 1)
      ret += " und ";
    else
      ret += ", ";
  }
  return ret;
}

string _query_long()
{
  string ret, nadel, aussehen;

  ret = "Ein praechtiger Tannenbaum. Er ist sicher drei Meter hoch und seine "
        "weiten Aeste sind mit %s Tannennadeln bespickt. %s";
  if (dtime()[9..11] == "Jan")
    nadel = "schon leicht braeunlichen";
  else
    nadel = "schoenen gruenen";
  if (!sizeof(all_inventory()))
    aussehen = "Waere er geschmueckt, waere er noch viel viel schoener.";
  else
    aussehen = sprintf("Er ist mit %s geschmueckt.", liste(all_inventory()));   
 
  return BS(sprintf(ret, nadel, aussehen));
}
