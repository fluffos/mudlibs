// Christmas Creations - Christbaumschmuck

inherit "std/thing";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


   void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Engelshaar");
  SetProp(P_LONG, 
    "Schneeweisses Engelshaar, das sicher von einem wunderschoenen Engel "
    "stammt. Man kann es als Zierde fuer den Christbaum verwenden.");
  SetProp(P_NAME, "Engelshaar");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_PLURAL, 0); 
  AddId( ({"haar","engelshaar"}) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 50);
  SetProp(P_NOSELL, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ, "kostbar");
  SetProp(P_MATERIAL, ([MAT_HAIR:100]));
  	  
}  
   
