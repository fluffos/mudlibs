inherit "std/food";
#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Eine Schokopraline");
  SetProp(P_LONG, 
    "Eine Schokopraline mit der Form eines Herzens. Innen hat sie eine leckere "
    "Nougatfuellung und aussen wurde sie mit feiner Vollmilchschokolade "
    "umhuellt.");
  SetProp(P_NAME, "Schokopraline");
  SetProp(P_INFO, "Diese Praline laesst Dich dicker werden.");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 20);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_SMELL, "Die Schokolade duftet nach Kakao.\n");
  AddId(({"praline","schokopraline"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:10, F_SOAK:1,
      F_MSG: "Du steckst Dir die Schokopraline in den Mund und laesst sie "
      "auf Deiner Zunge zergehen. *Mmmmm* Wie lecker doch das Nougat ist.\n",
      F_MSG_ROOM: "steckt sich eine Schokopraline in den Mund.\n" ]));

 }
  
 void init()
 {
  ::init();
  if (TP && interactive(TP) && query_decay() == -1)
    start_decay(172800, 31200);
 }            

	
