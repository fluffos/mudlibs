inherit "std/thing";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


   void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Goldenes Lametta");
  SetProp(P_LONG, 
    "Goldenes, glaenzendes Lametta.");
  SetProp(P_NAME, "Lametta");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_PLURAL, 0); 
  AddId( ({"goldenes lametta","lametta"}) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 100);
  SetProp(P_NOSELL, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ, "golden");
  SetProp(P_MATERIAL, ([MAT_PLASTIC:100]));
  	  
}  
   
