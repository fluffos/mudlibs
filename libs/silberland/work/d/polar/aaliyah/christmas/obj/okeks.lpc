inherit "std/food";
#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Ein Ogerkeks");
  SetProp(P_LONG, 
    "Ein kleiner Keks mit der Form eines Ogers.");
  SetProp(P_NAME, "Ogerkeks");
  SetProp(P_INFO, "Ein Oger aus Teig, ist immerzu feig.");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 50);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, MAT_FOOD);
  SetProp(P_SMELL, "Der Ogerkeks duftet nach Mandeln.\n");
  AddId(({"ogerkeks","keks"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:2, F_SOAK:1, F_ALCOHOL: 0,
      F_MSG: "Du knusperst genuesslich den Ogerkeks.\n",
      F_MSG_ROOM: "knuspert einen Ogerkeks.\n" ]));

 }
  
 void init()
 {
  ::init();
  if (TP && interactive(TP) && query_decay() == -1)
    start_decay(172800, 31200);
 }            

	
