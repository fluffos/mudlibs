inherit "std/food";
#include <properties.h>
#include <food.h>
#include "../def.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Zimtstern");
  SetProp (P_LONG, "Ein leckerer Zimtstern mit einer Zuckerglasur.");
     
  SetProp (P_NAME, "Zimtstern");
  SetProp (P_GENDER, MALE);
  AddId (({"stern","keks","zimtstern"}));
  SetProp (P_INFO, ("Der Zimtstern mundet Dir gewiss."));

  SetProp (P_VALUE, 10);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL: 11, F_SOAK: 3, F_ALCOHOL: 0, F_POISON:0,
  F_MSG: "Du verschlingst den Zimtstern mit einem Haps.\n",
  F_MSG_ROOM: " knuspert an einem Zimtstern.\n"]));
 
}

