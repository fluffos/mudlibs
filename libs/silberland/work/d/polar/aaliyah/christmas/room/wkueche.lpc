inherit "std/room";
#include "../def.h"
#include <properties.h>
#include <moving.h>

void grundzustand();
int torte_da;
int zimtstern_da;
int ragout_da;
int braten_da;
int suppe_da;

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In der Kueche des Weihnachtsmannes");
  SetProp( P_INT_LONG,
	"Du stehst in einer kleinen, urigen Kueche. Ein grosser Tisch "
	"nimmt fast die ganze Nordwand ein. Um ihn herum wurden lauter "
	"gemuetliche Stuehle gestellt. An der Suedfront siehst Du einen "
	"alten Herd und einige Kuechenregale. Viele getrocknete Kraeuterbuendel "
	"haengen von der Decke herunter. Weiters erblickst Du einige "
	"Bilder und ein grosses Fenster, auf dessen Fensterbrett sich drei "
	"Blumentoepfe befinden.");       
 	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang--------------------------------------------------------

   AddDetail( ({"raum","raumes","kueche","blick"}), 
		   QueryProp(P_INT_LONG) );

  
  
  AddDetail( ({"boden"}),
	    "Der Boden besteht aus knarrigen Holzbrettern. So alt sie auch "
	    "sind, es wirkt schoen heimelig und gemuetlich.");

  AddDetail( ({"holzbrettern","bretter","holzbretter"}), 
            "Die Holzbretter sind alt aber sauber. Hier wird anscheinend immer "
	    "schoen fleissig geputzt.");
             

  AddDetail( ({"decke","holzbalken"}), 
            "Die Decke besteht aus alten Holzbalken.");
            
	 
  AddDetail( ({"tisch","nordwand"}),
	    "Ein schoenes Tischtuch wurde ueber den Tisch gebreitet. Darauf "
	    "liegt ein selbstgemachtes Blumengesteck. Ausserdem steht noch "
	    "ein Teller mit frischen Keksen darauf.");

  AddDetail( ({"tischtuch"}),
	    "Ein bluetenweisses gehaekeltes Tischtuch. Die Spitzen sind "
	    "eisblau und haben die Form von Eiszapfen.");

  AddDetail( ({"spitzen","form","eiszapfen"}),
	    "Die Spitzen haben die Form von Eiszapfen und sind eisblau.");

  AddDetail( ({"blumengesteck","gesteck"}),
	    "Die Frau des Weihnachtsmannes hat dieses Gesteck selbst "
	    "gemacht. Viele getrocknete Blumen, Orangenscheiben und "
	    "Zimtrollen wurden zu einem Gesteck gebunden. Eine grosse "
	    "goldene Schleife und einige Glasperlen sind auch noch "
	    "darin vorhanden.");

  AddDetail( ({"frau","dame","weihnachtsmann","weihnachtsmannes"}),
	    "Der Weihnachtsmann hatte das Alleinsein satt und hat sich vor "
	    "Jahren eine liebe, fleissige Dame zur Frau genommen.");

  AddDetail( ({"alleinsein","jahren","jahre"}),
	    "Niemand ist gerne solang allein.");
       

  AddDetail( ({"blumen","blume"}),
	    "Undefinierbare bunte Blumen. Sie sind zwar getrocknet aber "
	    "sehen trotzdem noch sehr huebsch aus.");
	    	  
  
  AddDetail( ({"orangenscheiben","zimtrollen"}),
	    "Getrocknete Orangenscheiben und Zimtrollen eignen sich "
	    "wirklich hervorragend fuer ein Gesteck.");
	 
  AddDetail( ({"glasperlen","perlen"}),
	    "Goldene kleine Glasperlen zieren das Gesteck.");
	  

  AddDetail( ({"schleife","saum"}),
	    "Eine goldene Schleife mit weinrotem Saum.");

  AddDetail( ({"stuehle","holzstuehle"}),
	    "Weisse Holzstuehle mit vielen exotischen Intarsien. Sie haben "
	    "eine dunkelblaue Polsterung und machen einen sehr gemuetlichen "
	    "Eindruck.");
          

  AddDetail( ({"intarsien","figuren"}),
	    "Exotische Figuren. Irgendwie erinnern sie Dich an Amun Ra, dem "
	    "Sonnengott.");

  AddDetail( ({"sonnengott","amun ra","amun","ra"}),
	    "Das ist der Sonnengott eines fernen Landes.");
  
  AddDetail( ({"land","landes"}),
	    "Du kennst das Land sicher nicht.");

 
  AddDetail( ({"polsterung","eindruck"}),
	    "Gemuetlich wirkt die dunkelblaue Polsterung der Stuehle.");

  AddDetail( ({"fensterbrett"}),
	    "Ein hoelzernes Fensterbrett mit drei Blumentoepfen darauf. Es "
	    "wurde vor kurzem geschliffen und gewachst und sieht nagelneu "
	    "aus.");
  
  AddDetail( ({"blumentoepfe","blumentoepfen","blumentopf"}),
	    "In einem Blumentopf wachsen frische Kraeuter, in dem zweiten "
	    "Blumentopf waechst eine weisse Rose und in dem dritten "
	    "Blumentopf waechst eine seltsame Pflanze.");
            

  AddDetail( ({"rose"}),
	    "Praechtig gedeiht diese weisse Rose am Fensterbrett. ");

  AddDetail( ({"pflanze"}),
	    "Das ist eine sehr seltsame Pflanze. Sie nennt sich 'Christianus " 
	    "Idiotalis'.");

  AddDetail( ({"christianus idiotalis","christianus","idiotalis"}),
	    "Irgendwie stinkt diese Pflanze sehr leicht.");

  AddDetail( ({"kraeuterbuendel","buendel"}),
	    "Viele Kraeuterbuendel mit getrockneten Kraeutern baumeln von "
	    "der Decke herunter.");
 
  AddDetail( ({"bilder","bild"}),
	    "Du siehst drei Bilder. Ein goldenes Bild, ein silbernes Bild und "
	    "ein weinrotes Bild.");

  AddDetail( ({"goldenes bild"}),
	    "Am goldenen Bild befinden sich Rambo, Fenris, Zidane, Lovetah, "
	    "Hactar und Trintrasil.");

  AddDetail( ({"silbernes bild"}),
	    "Am silbernen Bild befinden sich Turgon, Humply, Andronicus, Dejot, "
	    "Feyaria und Thranduil.");
  
  AddDetail( ({"weinrotes bild"}),
	    "Am weinroten Bild erkennt man die Frau des Weihnachtsmannes mit "
	    "Hobbit Took in einer Kueche.");
  
  AddDetail( ({"rambo","zidane","lovetah","hactar","trintrasil",
			  "besonderes"}),
	    "Frag Doch mal den Weihnachtsmann, der kann Dir darueber sicher "
	    "mehr erzaehlen. Aber es ist sicher wer ganz Besonderes.");

 
  AddDetail( ({"weihnachtsmann","weihnachtsmannes"}),
	    "Wenn er nicht hier ist, ist er woanders.");

  AddDetail( ({"turgon","humply","andronicus","dejot","feyaria","thranduil"}),
	    "Frag einfach den Weihnachtsmann, wenn Du mehr dazu wissen "
	    "moechtest.");


  AddDetail( ({"hobbit","took"}),
	    "Frag doch einfach die Frau des Weihnachtsmannes, wenn Du mehr "
	    "ueber Took erfahren moechtest.");

  AddDetail( ({"herd"}),
	    "Ein ziemlich rustikaler Herd mit einem grossen Backrohr und "
	    "vier Herdplatten.");

 
  AddDetail( ({"herdplatten","platten"}),
	    "Ein grosser Topf blubbert monoton am Herd. Ausserdem siehst Du "
	    "noch ein Backblech, welches auf zwei Herdplatten gelegt wurde.");

 
  AddDetail( ({"topf","topfes"}),
	    "Du gehst zum Herd und oeffnest den Deckel des Topfes. *Hmmm* "
	    "Leckere Tomatencremesuppe mit Croutons befindet sich in dem Topf. "
	    "Die Frau des Weihnachtsmannes hat sicher nichts dagegen, wenn "
	    "Du mal davon kostest.");

  AddDetail( ({"deckel"}),
	    "Jeder Topf hat einen Deckel. Auch Du wirst Deinen noch finden, "
	    "solltest Du ihn bis jetzt noch nicht gefunden haben.");

  AddDetail( ({"tomatencremesuppe","croutons","suppe"}),
	    "Die Tomatencremesuppe duftet lecker. Du solltest wirklich einmal "
	    "davon kosten.");

  AddDetail( ({"backblech","blech"}),
	    "Die Kekse auf dem Backblech wurden anscheinend gerade frisch "
	    "gebacken, denn sie dampfen heiss und duften wunderbar.");

  AddDetail( ({"teller"}),
	    "Der Teller ist gefuellt mit frischen Keksen aller Art. Nimm "
	    "doch einen Keks, wenn er Dich schon so anlacht.");

  AddDetail( ({"backrohr","rohr"}),
	    "Du schaust durch die Glasscheibe des Backrohres und siehst eine "
	    "Kasserolle mit Wildschweinbraten und Kartoffeln und eine "
	    "Kuchenform mit leckerem Haselnusskuchen.");

  AddDetail( ({"kasserolle","wildschweinbraten","braten","kartoffeln",
			 "kartoffel"}),
	    "*Mhhhhhhhhhhhmmmm* Lecker! Der Wildschweinbraten ist schoen "
	    "knusprig braun und auch die Kartoffeln lachen Dich so richtig "
	    "an. Schneide Dir doch einfach ein Stueck ab, wenn Du magst.");

  AddDetail( ({"stueck"}),
	    "Ein Stueck genuegt. Die anderen wollen schliesslich auch noch "
	    "etwas davon haben.");

  AddDetail( ({"kuchenform","haselnusskuchen"}),
	    "Leckerer Haselnusskuchen mit Schokoladestreusel. Der Duft des "
	    "Kuchens stroemt in Deine Nase und Dir laeuft das Wasser im "
	    "Munde zusammen.");

  AddDetail( ({"schokoladestreusel"}),
	    "Die Schokoladestreusel sind im heissen Backrohr geschmolzen, "
	    "aber das macht nichts. Wenn der Kuchen fertig ist, werden "
	    "sicher wieder welche daruebergestreut.");

  AddDetail( ({"haselnusskuchen","kuchens","kuchen"}),
	    "Flaumig weicher Haselnusskuchen. Wenn der fertig ist, "
	    "schmeckt der sicher lecker.");

  AddDetail( ({"nase","geruch","gerueche","duft","duefte","riechen"}),
	    "Deine Nase ist zum Riechen da.");

  AddDetail( ({"suedfront"}),
	    "Die Suedfront wird von einem rustikalen Herd und einigen "
	    "Kuechenregalen eingenommen.");
  
  AddDetail( ({"kuechenregale","regale","kuechenregalen"}),
	    "Die Kuechenregale sind mir allerlei Kram gefuellt. Du siehst "
	    "Frischhaltedosen, Keramikschalen, Keksdosen und eine leckere "
	    "Torte.");

   AddDetail( ({"dosen","frischhaltedosen"}),
	    "In den Frischhaltedosen sind die Reste der letzten Mahlzeit.");
 
   AddDetail( ({"reste","mahlzeit","truthahn","gemuese"}),
	    "Gebratener, gefuellter Truthahn mit Gemuese.");

   AddDetail( ({"keksdosen","dose"}),
	    "Die Keksdosen sind randvoll gefuellt mit Keksen.");

   AddDetail( ({"keramikschalen","schalen"}),
	    "Viele Gewuerze befinden sich in den Keramikschalen. Sie wurden "
	    "wohl von der Frau des Weihnachtsmannes selbst gezuechtet und "
	    "getrocknet.");

   AddDetail( ({"gewuerze","gewuerz"}),
	    "Waldkraeuter und Gartenkraeuter. Du kennst die meisten Kraeuter "
	    "gar nicht.");

   AddDetail( ({"gartenkraeuter","dill","petersilie","basilikum","schnittlauch"
			   }),
	    "Schnittlauch, Dill, Basilikum oder Petersilie.");

   AddDetail( ({"waldkraeuter","kraeuter"}),
	    "Tja wenn Du das wuesstest, waerst Du ein Waldexperte. Aber Du "
	    "kennst Dich ja nicht mal mit Pilzen aus.");
  
   AddDetail( ({"waldexperte","experte","doch"}),
	    "Ach Du bist kein Experte, Du bist eher ein Laberhans.");

   AddDetail( ({"fenris"}),
	    "Fenris ist ein Laberhans.");

   AddDetail( ({"laberhans"}),
	    "Frag mal Fenris, was das bedeutet.");

   AddDetail( ({"pilzen","pilze","pilzragout","knoedel"}),
	    "Jetzt siehst Du es erst! Eine volle Dose mit Pilzragout und "
	    "Knoedel. Du ueberlegst, ob Du sie stehlen solltest.");

   AddDetail( ({"kekse","keksen","kekserln","keks"}),
	    "Vanillekipferln, Zimtsterne, Mandelmakronen, Kokosbusserln, "
	    "Linzeraugen und Butterkekse.");

   AddDetail( ({"linzeraugen","linzerauge"}),
	    "Die Linzeraugen sehen irgendwie gruen aus.");

   AddDetail( ({"vanillekipferln","vanillekipferl"}),
	    "Du haettest gerne eines davon.");

   AddDetail( ({"backrohrglasscheibe","scheibe"}),
	    "Du bueckst Dich und irgendwie scheint es als wuerde Dir Justavius "
	    "aus dem Backrohr entgegenlachen.");

   AddDetail( ({"justavius","feuer","hintern"}),
	    "Bisserl Feuer unterm Hintern wuerde ihm nicht schaden.");

   AddDetail( ({"kokosbusserln","kokosbusserl","butterkeks","butterkekse",
			   "zimtsterne","zimtstern","mandelmakronen",
			   "mandelmakron"}),
	    "Wenn Du magst, nimm Dir nur ein Kekserl vom Teller.");

  AddDetail( ({"hunger"}),
	    "Bei soviel guten Sachen, ist es wirklich kein Wunder, dass "
	    "Du Hunger bekommst.");

  AddDetail( ({"wunder"}),
	    "Oder wunderst Du Dich doch?");

  AddDetail( ({"sachen","leckereien"}),
	    "Na Du bist doch umgeben von Leckereien!");

  AddDetail( ({"zimt","vanille","puderzucker"}),
	    "Es riecht einfach so himmlisch hier.");

  AddDetail( ({"mhhhhhhhhhhhmmmm","wasser","lecker","munde"}),
	    "Es riecht einfach so himmlisch hier.");

  AddDetail( ({"fenster","glasscheibe","scheibe"}),
	    "Haette das Fenster keine Glasscheibe, waere es hier sehr "
	    "kalt. Wenn Du Dich fuer die andere Glasscheibe interessierst, untersuch "
	    "doch die Backrohrglasscheibe.");

  AddDetail( ({"art","kram","wand","kekserl","gnom","waende"}),
	    "Ein Gnom kommt an und lenkt Dich ab.");




  AddDetail( ({"waldbeerentorte","torte"}),
	    "Oooohh! Eine leckere Waldbeerentorte. Sie hat eine feine "
	    "rosa Glasur und ist mit vielen Beeren dekoriert. Sie wurde "
	    "schon in Stuecke geteilt. Wenn Du magst, kannst Du ja eines "
	    "stibitzen.");

  AddDetail( ({"waldbeeren","beeren","heidelbeeren","erdbeeren","himbeeren",
			  "aroma"}),
	    "Heidelbeeren, Erdbeeren und Himbeeren.");

  AddDetail( ({"glasur"}),
	    "Die Glasur ist zartrosa und sehr sehr cremig.");

  AddDetail( ({"hauch"}),
	    "Ein sanfter Hauch.");

  AddDetail( ({"stuecke"}),
	    "Trau Dich! Stibitz doch eines davon!");

  AddDetail( ({"nebenzimmer","nebenraum","zimmer","geraeusche"}),
	    "Lauschen!");



   
  AddSmell(DEFAULT_SMELL, "Du saugst gierig den Duft von frischem Kuchen "
		  "und herrlichen Keksen in Dich auf. Lecker riecht es "
		  "hier. Du bekommst so richtig Hunger.");
                        
 
  AddSmell( ({"kuchen","haselnusskuchen"}),
	   "Der Kuchen riecht wuerzig und nussig.");
  
  AddSmell( ({"keks","kekse","keksen"}),
	    "Die Kekse duften herrlich nach Zimt, Vanille und Puderzucker.");

  AddSmell( ({"tomatencremesuppe","tomatensuppe","sahne","rispentomaten"}),
	    "Frische Rispentomaten mit frischer Sahne und Kraeutern duften "
	    "einfach dementsprechend lecker.");

  AddSmell( ({"wildschweinbraten"}),
	    "Wuerzig!");

  AddSmell( ({"torte","beeren","aroma"}),
	    "Du riechst an der Torte und das Aroma der Beeren entfaltet sich "
	    "direkt in Deiner Nase.");
	  
  
  AddSound(DEFAULT_SOUND, "Hier hoerst Du nur die Frau des Weihnachtsmannes "
		  "arbeiten.");

  AddSound( ({"weihnachtsmannes","frau"}),
	"Die Frau des Weihnachtsmannes arbeitet unentwegt.");

  AddRoomMessage( ({"Ein leichter Hauch von Zimt durchstroemt Deine Nase.\n",
                  "Die Suppe brodelt monoton am Herd.\n",
                  "Der Duft vom Kuchen macht Dich hungrig.\n",
                  "Du hoerst leise Geraeusche aus dem Nebenzimmer.\n"}), 80);
  

     
  

//-----Details Ende----------------------------------------------------------
  
//_________Kommandos_________________________________________________________

  
 AddExit("osten", ROOM "wzimmer.lpc");
 AddExit("westen", ROOM "vorraum.lpc");
 AddItem(NPC "athenia.lpc", REFRESH_DESTRUCT);
 AddItem(NPC "estefan.lpc", REFRESH_DESTRUCT);
 
 AddCmd( ({ "stibitze", "stibitz" }), "c_stibitzen");
 AddCmd( ({ "nehm", "nimm" }), "c_nehmen");
 AddCmd( ({ "koste", "kost" }), "c_kosten");
 AddCmd( ({ "schneid", "schneide" }), "c_abschneiden");
 AddCmd( ({ "stehle", "stehl" }), "c_stehlen");
 
 
 grundzustand();
}

reset()

{
   ::reset();
   grundzustand();
}

void grundzustand()
{
	ragout_da = 1;
	zimtstern_da = 1;
	torte_da = 1;
	braten_da = 1;
	suppe_da = 1;
}


   int c_stehlen(string str)
{
   notify_fail(BS("Was moechtest Du hier woraus stehlen?"));
   if(!((str == "dose aus regal") ||
	(str == "blechdose aus regal") ||
	(str == "pilzragout aus regal") ||
        (str == "ragout aus regal")))
   {
     return 0;
   }
   if(present("ragout", ENV(TP)) || (!ragout_da))
   {
     write(BS("Gerade als Du versuchst die Dose mit dem Ragout zu stehlen, "
	      "kommt der Weihnachtsmann und klopft Dir auf die Finger."));
	   

     return -1;
    }
    else
    {
      write(BS("Du schaust nach rechts und nach links. Keiner schaut her! "
	"Schnell klaust Du die Dose aus dem Regal und steckst sie ein."));
      tell_room(ENV(TP), TPN+" laechelt scheinheilig.\n", ({TP}));
      ragout_da = 0;
      CLONE ( OBJ "ragout.lpc", TP);
      return 1;
 
  }
   
}
  
    int c_abschneiden(string str)
{
     notify_fail(BS("Was moechtest Du hier wovon abschneiden?"));
   if(!((str == "stueck von braten ab") || (str == "stueck vom braten ab")))
   {
     return 0;
   }
   if(present("braten", ENV(TP)) || (!braten_da))
   {
     write(BS("Gerade als Du ein Stueck vom Braten abschneiden willst, macht "
	      "Dich Estefania darauf aufmerksam, dass vor Dir schon jemand "
	      "da war und sie den Rest des Bratens fuer ihre Familie braucht."));
	   

     return -1;
    }
    else
    {
      write(BS("Du schneidest ein leckeres Stueck vom Braten ab. *Hhhmmjamm* "
		"ist das lecker! Aussen knusprig und das Fleisch innen ist "
		"saftig weich."));
      tell_room(ENV(TP), TPN+" nascht sich durch die Kueche.\n", ({TP}));
      braten_da = 0;
      TP->AddHp(45);
      
      return 1;
 
  }
   
 }
   
   int c_nehmen(string str)
{
   notify_fail(BS("Was moechtest Du hier von wo nehmen?"));
   if(!((str == "keks von teller") ||
	(str == "kekserl von teller") ||
        (str == "kekse von teller")))
   {
     return 0;
   }
   if(present("zimtstern", ENV(TP)) || (!zimtstern_da))
   {
     write(BS("Leider sind die Kekse noch viel zu heiss zum Nehmen."));
	   

     return -1;
    }
    else
    {
      write(BS("Du nimmst Dir ein paar Kekse vom Teller. Das Vanillekipferl "
	       "isst Du gleich und den Zimtstern packst Du Dir fuer spaeter "
	       "ein."));
      tell_room(ENV(TP), TPN+" nimmt sich ein paar Kekse vom Teller.\n", ({TP}));
      zimtstern_da = 0;
      CLONE ( OBJ "zstern.lpc", TP);
      return 1;
 
  }
    
  
  }
   int c_stibitzen(string str)
{
   notify_fail(BS("Was moechtest Du hier stibitzen?"));
   if(!((str == "tortenstueck") || (str == "torte")))
   {
     return 0;
   }
   if(present("torte", ENV(TP)) || (!torte_da))
   {
     write(BS("Du denkst an Deine Speckroellchen an der Bauchgegend und "
              "laesst es doch lieber bleiben."));
	   

     return -1;
    }
    else
    {
      write(BS("Du nimmst ein Stueck Torte und freust Dich darueber."));
      tell_room(ENV(TP), TPN+" laechelt scheinheilig.\n", ({TP}));
      torte_da = 0;
      CLONE ( OBJ "wtorte.lpc", TP);
      return 1;
 
  }
  
}
   int c_kosten(string str)
{
   notify_fail(BS("Was moechtest Du denn gerne kosten?"));
   if(!((str == "tomatencremesuppe") || (str == "suppe")))
   {
     return 0;
   }
   if(present("suppe", ENV(TP)) || (!suppe_da))
   {
   
     write(BS("Du verbrennst Dir an der heissen Suppe ganz doll die Zunge."));
     TP->do_damage(30, TO);	   

     return -1;
    }
    else
    {
      write(BS("Du kostest die Suppe und sie schmeckt herrlich nach frischen "
		"Tomaten und Kraeutern."));
      tell_room(ENV(TP), TPN+" probiert etwas Tomatensuppe.\n", ({TP}));
      suppe_da = 0;
      TP->AddHp(15);
      return 1;
 
  }
  
 }


