inherit "std/room";
#include "../def.h"
#include <properties.h>
#include <moving.h>

void grundzustand();
int haus_da;
int schrank_offen;



void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Schlafzimmer des Weihnachtsmannes");
  SetProp( P_INT_LONG,
	"Die Treppe hat Dich direkt ins Schlafzimmer des Weihnachtsmannes "
	"gefuehrt. In der Mitte des Raumes befindet sich ein grosses, "
	"wolkenaehnliches Bett. Neben jeder Bettseite steht ein kleines "
	"Nachtkaestchen aus Holz. Weiters faellt Dir noch ein grosser Schrank "
	"auf. Der Boden ist wie im Rest des Hauses mit Baerenfellen bedeckt. "
	"Ansonsten faellt Dir nichts Besonderes hier auf.");       
 	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang--------------------------------------------------------

   AddDetail( ({"raum","raumes","zimmer","schlafzimmer","zimmers"}), 
		   QueryProp(P_INT_LONG) );

  
  
  AddDetail( ({"boden","baerenfelle","felle","fellen","fell","baerenfell"}), 
            "Viele weiche Baerenfelle wurden ueber den Boden gebreitet "
	    "und sorgen fuer warme Fuesse. Sie sind nicht nur bequem, der "
	    "Raum sieht dadurch auch richtig gemuetlich aus.");
             

  AddDetail( ({"fuesse"}), 
            "Fuesse sollten immer schoen gepflegt sein.");
            
	 
  AddDetail( ({"weihnachtsmannes","weihnachtsmann","mann"}),
	    "Wenn er nicht hier ist, ist er woanders.");
      

  AddDetail( ({"decke"}),
	    "Die Decke ist nicht sonderlich interessant.");

  AddDetail( ({"nase","geruch","duft","die","riechen"}),
	    "Die Nase ist zum Riechen da.");

	    	  
  
  AddDetail( ({"mitte","bett","wolkenbett"}),
	    "Das Bett erinnert Dich an eine grosse Wolke. Das hoelzerne "
	    "Bettgestell ist grossteils mit vielen weissen Kissen und zwei "
	    "wolkenaehnlichen Decken bedeckt.");
	 
  AddDetail( ({"wand","waende","waenden"}),
	    "Die Waende bestehen aus schlichten Holzbrettern.");
	  

  AddDetail( ({"holzbretter","holzbrettern","bretter","brettern"}),
	    "Einfache hoelzerne Bretter. Sie sind nicht weiter besonders.");
         

  AddDetail( ({"wolke","wolken"}),
	    "Die Decken und die Kissen sind irgendwie wolkenfoermig. Es "
	    "scheint, als wuerde der Weihnachtsmann einfach die Wolken vom "
	    "Himmel stehlen, um watteweich zu schlafen.");

 
  AddDetail( ({"kissen","daunenkissen"}),
	    "Dicke, grosse Daunenkissen mit einem weissgoldenen Ueberzug.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist jetzt schon wolkenleer, wie Du durch das kleine "
	    "Fenster erkennen kannst.");
  
  AddDetail( ({"treppe"}),
	    "Die Treppe besteht aus Kirschholz. Sie hat rechts und links ein "
	    "Gelaender und fuehrt ins Wohnzimmer.");
            

  AddDetail( ({"fenster"}),
	    "Das Fenster ist Dir zuerst gar nicht aufgefallen. Das liegt "
	    "gewiss daran, dass Du es als selbstverstaendlich siehst.");

 AddDetail( ({"haus","hauses"}),
	    "Du bist mittendrin statt nur dabei.");

 AddDetail( ({"gelaender","stufen","kirschholz","holz"}),
	    "Das Gelaender und die Stufen der Treppe bestehen aus Kirschholz.");
 
 AddDetail( ({"wohnzimmer"}),
	    "Wenn Du die Treppe hinunterkletterst, gelangst Du ins Wohnzimmer.");

 AddDetail( ({"bettgestell","gestell"}),
	    "Ein einfaches, hoelzernes Bettgestell.");

 AddDetail( ({"nachtkaestchen","kaestchen","nachttisch","bettseite"}),
	    "An jeder Bettseite befindet sich ein Nachtkaestchen. Meinst "
	    "Du das rechte oder das linke Nachtkaestchen?");

 AddDetail( ({"kerze"}),
	    "Eine kleine magische Kerze, die sich von selbst entzuendet und "
	    "auch von selbst erlischt.");
 
 AddDetail( ({"decken","bettdecke","bettzeug"}),
	    "Wolkenaehnliche Kissen und Decken, die in Dir das Verlangen "
	    "aufrufen, Dich unter die Decken zu legen und so richtig schoen "
	    "hineinzukuscheln.");

 AddDetail( ({"verlangen"}),
	    "Verlangen hat jeder.");

 AddDetail( ({"linkes nachtkaestchen"}),
	    "Das linke Nachtkaestchen gehoert Estefania. Ein zartrosa Buch "
	    "liegt darauf und auch noch eine schoene Statue.");
 
 
 AddDetail( ({"buch"}),
	    "Es gibt ein graues und ein zartrosa Buch.");

 AddDetail( ({"ueberzug"}),
	    "Frisch gewaschen was sonst?");

 AddDetail( ({"rechtes nachtkaestchen"}),
	    "Das rechte Nachtkaestchen gehoert dem Weihnachtsmann. Eine kleine "            "Kerze befindet sich darauf. Ausserdem liegt dort noch ein "
	    "kleines graues Buch.");

 
 AddDetail( ({"graues buch","titel"}),
	    "Der Titel heisst 'Woody im Bann der Daemonen'.");

 AddDetail( ({"bann","daemonen","woody"}),
	    "Das Buch enthaelt einen extremst schockierenden Psychothriller.");

 AddDetail( ({"zartrosa buch","name","buches"}),
	    "Der Name des Buches lautet 'Feyaria im 7. Himmel'.");


 AddDetail( ({"thriller","psychothriller"}),
	    "Der ist nichts fuer Dich.");

 AddDetail( ({"besonderes"}),
	    "Es ist einfach nichts, was so besonders toll ist.");

 AddDetail( ({"teelichter","lichter","kerzen","kerze"}),
	    "Die Teelichter flackern lichterloh.");

 
 AddDetail( ({"feuer","flammen"}),
	    "Hell lodernd!");

 AddDetail( ({"feuerfunke","funke"}),
	    "Der Funke ist schon wieder erloschen.");

 
 AddDetail( ({"feyaria","liebesgeschichte","geschichten"}),
	    "Es ist einfach die Liebesgeschichte zwischen Feyaria und "
	    "dem Gouverneur. Da Dich aber Liebesgeschichten generell "
	    "nicht interessieren, laesst Du das Buch dort wo es ist.");

 AddDetail( ({"zuhause"}),
	    "Dein Zuhause ist bei weitem nicht so stimmungsvoll.");

 
  AddDetail( ({"gouverneur","tijara"}),
	    "Der Gouverneur von Tijara ist damit gemeint.");

 AddDetail( ({"statue","schwan","schwans"}),
	    "Die Statue stellt einen kristallinen Schwan dar. Estefania "
	    "hat sie anscheinend von jemandem geschenkt bekommen, denn eine "
	    "kleine Schleife befindet sich noch um den Hals.");

  AddDetail( ({"schleife","hals"}),
	    "Eine schoene, tuerkise Schleife befindet sich am Hals des "
	    "Schwans.");

  AddDetail( ({"estefania","frau"}),
	    "Wenn Estefania nicht hier ist, ist sie woanders.");

  AddDetail( ({"kleidung"}),
	    "Die scheint nicht weiterhin interessant zu sein.");

   
  AddDetail( ({"haus"}),
	    "Der Weihnachtsmann hat fuer die Wichtel ein kleines Haus "
	    "gebaut. Aber mit dem werden sie erst zu Weihnachten ueberrascht.");

  AddDetail( ({"rest"}),
	    "Der Rest halt.");

  AddDetail( ({"waesche"}),
	    "Du siehst hier keine Waesche herumliegen.");

  AddSpecialDetail( "schrank", "d_schrank");


  
  AddDetail( ({"holz","baeumen"}),
	    "Hartes, braunes Holz von Baeumen ist damit gemeint.");


  AddRoomMessage( ({"Zarter Duft von frischgewaschener Waesche stroemt herein.\n",
                  "Hier duftet alles frischgewaschen.\n"}), 90);
  

  
  AddSmell(DEFAULT_SMELL, "Der feine Duft von frisch gewaschener Waesche "
		  "stroemt durch Deine Nase.");
                        
 
  AddSmell( ({"duft","waesche"}),
	   "Du siehst hier keine Waesche und trotzdem riecht es hier "
	   "danach. Vielleicht ist es auch das Bettzeug, das so duftet.");
  
    
  AddSound(DEFAULT_SOUND, "Stille.");

  AddSound( ({"stille"}),
	"Du hoerst hier nichts!");

//-----Details Ende-----
  
 AddExit("suedunten", "./wzimmer.lpc");
 AddCmd( ({ "oeffne" }), "c_oeffnen");
 AddCmd( ({ "nimm" }), "c_nehmen");
 AddCmd( ({ "kuschle", "kuschel" , "lieg" ,"leg" }), "c_liegen");
 

 grundzustand();
}  
 reset()

   {
   ::reset();
   grundzustand();
}

void grundzustand()
{
	schrank_offen = 0;
    tell_room(TO, "Der Schrank schliesst sich knarrend.\n");
}


     
  int c_oeffnen(string str)
{
    notify_fail(BS("Was moechtest Du hier denn oeffnen?"));
   if(!(str == "schrank"))
   {
     return 0;
   }
   if(schrank_offen) 
   {	   
   write("Aber der Schrank ist doch schon offen!\n");
    return -1;
   }
   else
   {
     write(BS("Du oeffnest den Schrank und erspaehst zwischen all der "
	      "vielen Kleidung auch ein kleines Puppenhaus."));
      tell_room(ENV(TP), TPN+" oeffnet den Schrank.\n", ({TP}));
      schrank_offen = 1;
      return 1;

     }
}
   int c_nehmen(string str)
{
   notify_fail(BS("Was moechtest Du denn hier nehmen?"));
   if(!((str == "haus aus schrank") || (str == "puppenhaus aus schrank"))) 
  {
    return 0;
  }

   if(schrank_offen) 
   {	   
 
  
   write(BS("Du nimmst das Puppenhaus aus dem Schrank und schon meldet sich "
	    "Dein schlechtes Gewissen. Aber das ist auch berechtigt. "
	    "Schliesslich klaust Du gerade das Geschenk vom Weihnachtsmann "
	    "an seine fleissigen Wichtel."));
      tell_room(ENV(TP), TPN+" klaut fremde Geschenke.\n", ({TP}));
      haus_da = 0;
      CLONE ( OBJ "haus.lpc", TP);
             
     return 1;
    }
    else
    {
      write(BS("Du willst das Puppenhaus stehlen, aber leider ist der "
	       "Schrank zu. Du brichst Dir schmerzhaft einen Fingernagel ab."));
      tell_room(ENV(TP), TPN+" bricht sich einen Fingernagel ab.\n", ({TP}));
      TP->AddHp(-5); 
       return -1;
      

    }
 
   }

  string d_schrank(string str)
  {
   string s;
   
   if(schrank_offen)
   {
    s = "Der Schrank besteht aus massivem Birkenholz. Er ist offen.";
   }
   else
   {
    s = "Der Schrank besteht aus massivem Birkenholz. Er ist geschlossen.";
   }
   return BS(s);
   } 

     int c_liegen(string str)
{
   notify_fail(BS("Wo willst Du liegen oder worein moechtest Du Dich kuscheln?"));
   if(!((str == "in bett") ||
	(str == "in decken") ||
        (str == "in decke") ||
        (str == "in bett hinein") ||
        (str == "in decke hinein") ||
        (str == "in decken hinein") ||	
        (str == "auf bett")))
   {
     return 0;
   }
    
   write(BS("Du schlaegst die Decke zurueck und legst Dich gemuetlich ins "
	    "Bett. Sehr angenehm und wohlduftend ist das Bett. So flauschig "
	    "weich, einfach herrlich. Du schliesst Deine Augen und geniesst "
	    "den Moment und wuenschst Dir eigentlich nur noch Jemand zu "
	    "Dir um dieses Wohlgefuehl nicht allein auskosten zu muessen."));
     tell_room(ENV(TP), TPN+" kuschelt sich ins Bett.\n", ({TP}));
     TP->command_me("raste");
      
     return 1;
    }
   

