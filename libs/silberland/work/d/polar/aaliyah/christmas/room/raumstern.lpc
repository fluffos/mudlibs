// Christmas Creations
 
inherit "std/room";
#include "../def.h"
#include <properties.h>
#include <moving.h>



void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Am Abendstern");
  SetProp( P_INT_LONG,
	"Du sitzt hier auf einem praechtigen Stern. Er strahlt und funkelt "
	"herrlich. Kein Wunder! Es ist auch der Abendstern.");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_AIR]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( ({"stern","abendstern"}), QueryProp(P_INT_LONG) );

  AddDetail( ({"boden"}), 
            "Der Boden befindet sich ganz weit unter Dir. Es grenzt schon "
	    "an ein Wunder, dass Du es hier herauf geschafft hast.");

  AddDetail( ({"himmel"}), 
            "Hier bist Du dem Himmel so nah, wie sonst nirgendwo. Unzaehlige "
	    "Sterne strahlen rund um Dich herum.");

  AddDetail( ({"sterne"}), 
            "Es sind zuviele um sie zu zaehlen.");

  AddDetail( ({"wunder"}), 
            "Es gibt durchaus noch Wunder. Man muss nur an sie glauben.");

  AddDetail( ({"sternschnuppe"}), 
            "Du schliesst Deine Augen und wuenschst Dir was.");

  AddDetail( ({"augen"}), 
            "Die hast Du schon wieder geoeffnet.");

  	 
  AddDetail( ({"schneeflocke","schneeflocken"}),
	    "Schoene, dicke, weisse Schneeflocken.");
      

  AddDetail( ({"luft"}),
	    "Die Luft ist hier sehr frisch.");
	  
  
  
  AddSmell(DEFAULT_SMELL, "Die Luft ist hier sehr klar und rein.");
                        
   
  AddSound(DEFAULT_SOUND, "Hier ist es still. Du bildest Dir aber trotzdem "
		  "ein, die Schneeflocken, die leise an Dir vorbeirieseln, "
		  "zu hoeren.");
	   

  AddSound( ({"schneeflocken","flocken","rieseln"}),
	   "Die Schneeflocken kann man nicht hoeren, Du bildest es Dir "
	   "nur ein weil es hier so still ist.");

  AddRoomMessage( ({"Einige Schneeflocken rieseln an Dir vorbei.\n",
	          "Rund um Dich strahlen und funkeln lauter Sterne.\n",
		  "Eine Sternschnuppe fliegt an Dir vorbei.\n",}), 90);        
  

//-----Details Ende-----
  
 AddExit("runter", "./vorgarten.lpc");
 AddItem(NPC "christk.lpc", REFRESH_DESTRUCT);

}


