#include "../def.h" 
#include <laden.h>
inherit "std/laden";


void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In der Werkstatt des Weihnachtsmannes");
  SetProp(P_INT_LONG,
	"Du befindest Dich hier in der Werkstatt des Weihnachtsmannes. "
	"Viele grosse Tische mit Werkzeug stehen hier im Raum. Einige "
	"Stuehle wurden rundherum aufgestellt. Ueberall stehen Toepfe mit "
	"Farben, Glitzerzeug und Glasperlen. Viele Pinsel liegen hier ueberall "
	"herum. Weiters siehst Du unzaehlige, halbfertige Holzfiguren und "
	"auch noch viel Papier und Stoffstuecke. Eine schmale Treppe fuehrt "
	"durch ein Loch in der Decke nach oben.");
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1 );
  SetStorageRoom(ROOM "wlager" );
  SetProp(P_SHOPKEEPER_ID, "martin");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_NAME, "Martin");

 SetProp(P_SPECIAL_SHOP, ([1:"Tut mir leid, wir kaufen nichts an!\n"]));
  

//--------------Details Anfang-------------------------------

  AddDetail( ({"raum","raumes","werkstatt"}), QueryProp(P_INT_LONG) );

  AddDetail( ({"boden","saegespaene","spaene","saegespaenen"}),
   "Der ganze Boden ist mit Saegespaenen bedeckt.");

  AddDetail( ({"decke","loch"}),
   "In der Decke befindet sich ein Loch, durch das man nach oben gelangen "
   "kann.");

  AddDetail( ({"treppe"}),
   "Eine schmale, hoelzerne Treppe fuehrt nach oben.");

  AddDetail( ({"weihnachtsmann","weihnachtsmannes"}),
   "Wenn er nicht hier ist, ist er woanders.");

  AddDetail( ({"tische","tischen"}),
   "Die Tische sind mit sehr viel Zeugs beladen.");

  AddDetail( ({"zeugs","kram"}),
   "Lauter Kram liegt auf den Tischen verstreut.");

  AddDetail( ({"werkzeug","dinge"}),
   "Hammer, Naegel, Leim und viele andere Dinge.");

  AddDetail( ({"tuer","holztuer"}),
   "Die Holztuer ist geoeffnet.");

  
  AddDetail( ({"hammer","naegel"}),
   "Mit dem Hammer kann man Naegel einschlagen.");

  
  AddDetail( ({"leim",}),
   "Mit dem Leim kannst man Dinge leimen.");

 
  AddDetail( ({"stuehle","stuhl","stuehlen"}),
   "Die Arbeiter setzen sich bei der Arbeit gelegentlich auch hin.");

  
  AddDetail( ({"arbeiter","arbeit"}),
   "Irgendwer muss die Arbeit ja erledigen.");

  
  AddDetail( ({"toepfen","toepfe","topf"}),
   "Viele Farben, Glitzerzeug und Glasperlen befinden in den Toepfen.");

  
  AddDetail( ({"farben","rot","blau","weiss","gelb","blau","gruen","mischen"}),
   "Rot, blau, gelb, gruen und weiss zum Mischen.");

  
  AddDetail( ({"glitzerzeug","glitter","zeug"}),
   "Glitzerstaub, Glitzersterne, Pailetten und vieles mehr.");

  AddDetail( ({"glitzerstaub","glitzersterne","pailletten"}),
   "Das Glitzerzeug schimmert und funkelt in allen Farben.");

  AddDetail( ({"glasperlen","groessen","formen"}),
   "Bunte Glasperlen in allen Formen und Groessen.");
 
  AddDetail( ({"haendler"}),
   "Hier gibt es keinen Haendler.");

   
  AddDetail( ({"pinsel","pinseln"}),
   "Mit den Pinseln werden die Dinge angemalt.");

  
  AddDetail( ({"pailetten","glitterdinger"}),
   "Pailetten sind so Glitterdinger fuer Frauenkleidung.");

  
   AddDetail( ({"frauenkleidung","kleidung","frauen"}),
   "Frauen brauchen auch Kleidung, obwohl sie manche Maenner lieber nackt "
   "haetten.");

   
   AddDetail( ({"maenner","glueck"}),
   "Zum Glueck sind nicht alle Maenner gleich.");

  
  AddDetail( ({"papier"}),
   "Buntes Papier mit dem man sicher Dinge gut verpacken kann. Oder aber auch "
   "etwas basteln. Je nachdem.");

   
  AddDetail( ({"stoffstuecke","stoff","stoffreste"}),
   "Aus dem Stoff werden huebsche Puppenkleider genaeht.");

  AddDetail( ({"puppenkleider","kleidung","kleider"}),
   "Nicht nur Puppenkleider sondern auch normale Kleidung.");
  
  AddDetail( ({"holzfiguren","figuren"}),
   "Manche der Figuren sind halbfertige Gartenzwerge, manche sind Holzpuppen "
   "und manche sind einfach Zierfiguren.");


  AddDetail( ({"wand","waende"}),
   "Ach, da gibt es nichts besonderes zu entdecken.");

  AddDetail( ({"holzpuppen"}),
   "Die Holzpuppen sind noch nicht sehr schoen. Sie muessen noch bemalt und "
   "angekleidet werden. Da sind die fertigen Puppen schon huebscher.");

   AddDetail( ({"puppen","rasse"}),
   "Es gibt Puppen jeder Rasse und alle sind sehr liebevoll gemacht und suess.");


  AddDetail( ({"zierfiguren"}),
   "Kleine Figuren fuer den Setzkasten oder grosse fuer den Garten.");

  AddDetail( ({"setzkasten","kasten","miniaturen"}),
   "Ein Setzkasten ist ein kleiner Kasten, wo man Miniaturen sammeln und "
   "aufbewahren kann.");

   AddDetail( ({"gartenzwerge","zierde"}),
   "Die sind als Zierde fuer den Garten gedacht. Einer sieht irgendwie aus "
   "wie Tower.");

    AddDetail( ({"garten"}),
   "Hast Du einen Garten?");

    AddDetail( ({"tower"}),
   "Ein anderer sieht aus wie Woody.");

   AddDetail( ({"woody"}),
   "Ein dritter sieht aus wie Rambo.");

   AddDetail( ({"rambo"}),
   "Ein vierter sieht aus wie Cherub.");

   AddDetail( ({"cherub"}),
   "Ein fuenfter sieht aus wie Lovetah.");

   AddDetail( ({"lovetah"}),
   "Ein sechster sieht aus wie Maquis.");

   AddDetail( ({"maquis"}),
   "Ein siebter sieht aus wie Willi.");

   AddDetail( ({"willi"}),
   "Ein achter sieht aus wie Eidan.");

   AddDetail( ({"eidan"}),
   "Eidan sieht irgendwie Schneewittchen aehnlich.");

   AddDetail( ({"schneewittchen"}),
   "Nein, irgendwie sieht er Angrox aehnlich.");

  AddDetail( ({"angrox"}),
   "Schneewittchen ist nicht so behaart wie Angrox.");

   AddSmell(DEFAULT_SMELL, "Hier riecht es nach Holz und nach Lacken.");
                        
 
  AddSmell( ({"holz"}),
	   "Holzig.");
  
  AddSmell( ({"lack","lacken","lacke"}),
	    "Die Lacke riechen alle sehr natuerlich.");
 

  AddExit("norden","./vorraum.lpc");
  AddExit("oben","./schlafz.lpc");
  AddItem(NPC "finja.lpc", REFRESH_DESTRUCT);
  AddItem(NPC "martin.lpc", REFRESH_DESTRUCT);
 

}
