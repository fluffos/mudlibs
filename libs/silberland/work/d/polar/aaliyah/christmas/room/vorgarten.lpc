inherit "std/room";
#include "../def.h"
#include <properties.h>
#include <moving.h>

void grundzustand();
int rudolf_da;

   create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Vorgarten des Weihnachtsmannes");
  SetProp( P_INT_LONG,
	"Zugeschneit und vertraeumt wirkt der Vorgarten, in dem Du Dich gerade "
	"befindest. Unmittelbar vor Dir befindet sich eine kleine, verschneite "
	"Huette. Heller Kerzenschein dringt aus den Fenstern und taucht den "
	"Schnee in ein gelbes Licht. Eine Futterstelle steht direkt neben dem "
	"Haus, um die sich einige hungrige Waldtiere tummeln. Weiters siehst "
	"Du einen grossen Tannenbaum in der Mitte des Gartens. Alles ist "
	"von einer dicken Schneeschicht ueberzogen. Selbst das dichte "
	"Gebuesch wird vom Schnee voellig verdeckt.");       
 	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: -10, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang--------------------------------------------------------

   AddDetail( ({"raum","vorgartens","gartens","garten","vorgarten"}), 
		   QueryProp(P_INT_LONG) );

  
  
  AddDetail( ({"boden"}), 
            "Der Boden ist mit Schnee bedeckt. Kein einziger Grashalm dringt "
	    "durch die dicke Schneeschicht.");
             

  AddDetail( ({"grashalm","gras","halm"}), 
            "Der Schnee verhindert, dass hier Gras wachsen kann.");
   
  AddDetail( ({"gebuesch","ecke"}), 
            "Dichte Buesche stehen in einer Ecke des Gartens. Einige "
	    "gefrorene Beeren befinden sich darauf.");

  AddDetail( ({"beeren"}), 
            "Die Beeren sind gefroren, also kann man sie wohl nicht mehr "
	    "essen. Hinter einer Beere schimmert etwas hindurch.");

  AddDetail( ({"beere"}), 
            "Irgendwas scheint hinter dieser Beere zu sein. Vielleicht ein "
	    "Versteck?");
  
  AddDetail( ({"irgendwas","etwas"}), 
            "Vielleicht solltest Du mal nachsehen und die verschneiten "
	    "Aeste auseinanderbiegen.");

  AddDetail( ({"aeste"}), 
            "Die Aeste sind verschneit.");
   
  AddDetail( ({"versteck"}), 
            "Das Versteck musst Du erst suchen.");
        
	 
  AddDetail( ({"weihnachtsmannes","weihnachtsmann","mann"}),
	    "Wenn er nicht hier ist, ist er woanders.");
      

  AddDetail( ({"schnee","schneedecke","schneeschicht"}),
	    "Alles ist hier zugeschneit. So romantisch es auch aussieht, so "
	    "kalt ist es dennoch.");

  AddDetail( ({"nase","geruch","duft","die","riechen"}),
	    "Die Nase ist zum Riechen da.");

	    	  
  
  AddDetail( ({"huette","haus"}),
	    "Die Huette besteht aus Backsteinen und hat ein Dach aus Holz. "
	    "Sie ist von einer dicken Schneeschicht bedeckt und sieht somit "
	    "richtig vertraeumt aus.");
	 
  AddDetail( ({"steine","backsteine","backsteinen"}),
	    "Die Huette wurde aus Backsteinen gebaut.");
	  

  AddDetail( ({"dach","holz"}),
	    "Das Dach besteht aus Holz. Eine dicke Schneeschicht bedeckt "
	    "das komplette Dach.");

  AddDetail( ({"futter","kauen","schmatz","laut"}),
	    "Das Futter schmeckt den Tieren. Sie schmatzen laut");

  AddDetail( ({"schneeflocken","himmel","flocken"}),
	    "Dicke Schneeflocken wirbeln vom Himmel herab. Ausserdem erstrahlt "
	    "am Himmel ein wunderschoener Stern.");

  
  AddDetail( ({"stern"}),
	    "Der Stern strahlt und funkelt. Es ist auch der Abendstern.");

    
  AddDetail( ({"buesche"}),
	    "Die Buesche sind schneebedeckt. Vielleicht koennte man die "
	    "Aeste auseinander biegen?");


  
  AddDetail( ({"abendstern"}),
	    "Ja! Tatsaechlich ist das der Abendstern. Irgendwie hast Du das "
	    "Beduerfnis zum Abendstern zu fliegen.");

  
  AddDetail( ({"beduerfnis"}),
	    "Das Beduerfnis hast Du schon, nur ob es auch funktioniert, "
	    "musst Du erst versuchen.");
         

  AddDetail( ({"kerzenschein","fenster","fenstern"}),
	    "Heller Kerzenschein dringt aus den Fenstern. Anscheinend wird "
	    "in der Huette viel Licht benoetigt.");

 
  AddDetail( ({"licht"}),
	    "Das Licht laesst den Schnee gelb wirken. Es sieht fast so aus, als "
	    "haetten unzaehlige Rentiere in den Schnee gepinkelt.");

  AddDetail( ({"schneeflocke","flocke"}),
	    "Jetzt ist sie weg.");
  
  AddDetail( ({"rentiere","rentieren","rentier"}),
	    "Bei der Futterstelle stehen einige Rentiere. Sie scheinen sehr "
	    "hungrig zu sein.");

  AddDetail( ({"keim","waldes","sinne","mitte"}),
	    "Eine Schneeflocke schmilzt.");

            

  AddDetail( ({"futterstelle","bau","futter"}),
	    "Taeglich werden Aepfel, Getreide, Heu und Nuesse in die "
	    "Futterstelle gelegt. Die Futterstelle ist ein einfacher Bau aus "
	    "Holz mit einem Dach darueber, damit das Futter nicht durch den "
	    "Schnee nass und eklig wird.");

 AddDetail( ({"getreide","nuesse","heu","aepfel"}),
	    "Das Futter ist frisch und wird hier taeglich in die Futterstelle "
	    "gefuellt.");

 AddDetail( ({"tiere","waldtiere","tieren"}),
	    "Zwischen den Rentieren befinden sich auch noch einige Rehe, "
	    "Hirsche, Schneehasen, Voegel und viele andere Tiere.");
 
 AddDetail( ({"schneehasen","hasen","kleintiere"}),
	    "Schneehasen sind kleine, putzige, schneeweisse Tiere. Sie haben "
	    "lange Ohren und sind so richtig kuschelig weich. Manch anderer "
	    "hat dafuer auch eine andere Bedeutung, aber hier sind wirklich "
	    "nur die Kleintiere gemeint.");

 AddDetail( ({"ohren"}),
	    "Einfach suess!");

 AddDetail( ({"dornen","hinsehen"}),
	    "Beim genaueren Hinsehern erkennst Du spitze Dornen unter der "
	    "Schneedecke am Busch.");

 AddDetail( ({"bedeutung","macho"}),
	    "Mancher Macho sagt zu Frauen 'Hasen' und zu skifahrenden Frauen "
	    "eben 'Schneehasen'.");

 AddDetail( ({"frauen","geschoepfe"}),
	    "Goettliche Geschoepfe!");
 
 AddDetail( ({"rehe","rehen","kitze"}),
	    "Unter den Rehen sind auch viele Kitze. Sie aesen gerade und sehen "
	    "sehr zufrieden aus.");

 AddDetail( ({"hirsche","silberland"}),
	    "Das Silberland hat viele Hirsche. Diese hier fressen gerade etwas "
	    "Heu aus der Futterstelle.");

 AddDetail( ({"voegel","koerner","koernern"}),
	    "Die Voegel knuspern an einigen Koernern herum.");
 
 
 AddDetail( ({"baum","tannenbaum"}),
	    "Ein reichlich geschmueckter Tannenbaum.");


  AddRoomMessage( ({"Die frische Waldluft reinigt Deine Sinne.\n",
		    "Viele Schneeflocken wirbeln vom Himmel herab.\n",
		    "Eine Schneeflocke zerschmilzt auf Deiner Nase.\n",
		    "Der Duft von Zimt und Keksen dringt an Deine Nase.\n",
		    "Leise tanzen die Schneeflocken um Dich herum.\n",
                    "Du hoerst das Kauen der Tiere.\n"}), 90);
  

  
  AddSmell(DEFAULT_SMELL, "Du riechst die frische Luft des Waldes. Sie "
		  "riecht nach Baum, Pilzen, Moos und nach eisigem Schnee.");
                        
 
  AddSmell( ({"baum","moos","baeume","geruch"}),
	   "Das Moos und die Baeume haben einen ganz eigenen Geruch. "
	   "Irgendwie wuerzig und harzig. Unerklaerlich.");
  
  AddSmell( ({"waldluft","luft"}),
	   "Die Waldluft ist gesund und frisch.");
  
  AddSmell( ({"pilzen","pilze"}),
	   "Du riechst hier ganz deutlich den Geruch von Pilzen. Obwohl Du "
	   "Dir sicher bist, dass hier ganz gewiss keine wachsen.");
  
  AddSmell( ({"schnee"}),
	   "Klirrend kalt.");

  
  AddSmell( ({"zimt","duft","kekse","keksen"}),
	   "Suesser Duft von frischgebackenen Keksen durchstroemt Deine "
	   "Nase. Anscheinend wurde in der Huette vor kurzem gebacken.");
   
   
   
    
  AddSound(DEFAULT_SOUND, "Hier herrscht eine erdrueckende Stille. Lediglich "
		  "ab und zu vernimmst Du die Geraeusche der Tiere.");

  AddSound( ({"stille"}),
	"Es ist deshalb so still, weil der Schnee jeden Laut im Keim erstickt.");
 
  AddSound( ({"geraeusche","tiere"}),
        "Die Tiere schmatzen, knabbern, niesen und prusten komische Laute.");

  AddSound( ({"schmatzen","knabbern","niesen","prusten","laute"}),
        "*Schmatz* *grgrgr* *haaaatschie* *pfrrrrr* *yieeeeeeeeeeeha*.");

	
//-----Details Ende-----

 AddCmd( ({ "such", "suche" }), "c_suchen");
 AddCmd( ({ "biege","bieg" }), "c_biegen");
 AddCmd( ({ "flieg", "fliege" }), "c_fliegen");
 AddItem( NPC "arion.lpc", REFRESH_DESTRUCT);
 AddExit("sueden", "/d/polar/thor/weg/room/lichtung6");

 
 NewDoor( ({"osten"}), ROOM "vorraum" , ({"tuer","eingangstuer"}) ,
   ({D_FLAGS,DOOR_CLOSED|DOOR_RESET_CL
     ,D_NAME, "Eingangstuer"
    ,D_GENDER, FEMALE
     ,D_SHORT, "Eine %se Eingangstuer."
     ,D_LONG, "Durch diese Tuer gelangst Du in die Huette."
     ,D_MSGS,    ({"geht in die warme Huette","kommt in die warme Huette herein"})
     ,D_OPENMSG, ({"Du oeffnest die Eingangstuer.",
                   "%s oeffnet die Eingangstuer.",
                  " wird knarrend von drinnen geoeffnet."})
     ,D_CLOSEMSG, ({"Du schliesst die Eingangstuer.",
                    "%s schliesst die Eingangstuer.",
                    " wird von drinnen geschlossen."})
     ,D_RESET_CLOSEMSG, " wird durch eine magische Kraft geschlossen."}));
  
  

   
 grundzustand();
}

void reset()
{
   ::reset();
   grundzustand();
}

void grundzustand()
{
	rudolf_da = 1;
}

int c_suchen(string str)
{
   notify_fail(BS("Was moechtest Du hier suchen?"));
   if(!(str == "versteck"))
   {
     return 0;
   }
   write(BS("Du suchst das Versteck und verletzt Dich an den Dornen "
	    "des Busches. *Argl* Die Dornen sind Dir vorher gar nicht "
	    "aufgefallen!"));
	  
   tell_room(ENV(TP), TPN+" verletzt sich am Busch.\n", ({TP}));
   TP->AddHp(-40);
   return 1;
}

int c_biegen(string str)
{
   notify_fail(BS("Was moechtest Du hier auseinander biegen?"));
   if(!(str == "aeste auseinander"))
   {
     return 0;
   }
   if(present("rudolf", ENV(TP)) || (!rudolf_da))
   {
     write(BS("Du biegst die Aeste auseinander und wirst patschnass. Leider "
	      "scheint das, was sich dahinter verborgen hat, nicht da zu "
	      "sein."));
	      
     return -1;
    }
    else
    {
      write(BS("Du biegst die Aeste auseinander und siehst ein kleines "
	       "Versteck. Rudolf hat es sich dahinter gemuetlich gemacht. "
	       "Als Du ihn so ansiehst, steht er auf und trottet aus den "
	       "Bueschen hervor."));
      tell_room(ENV(TP), TPN+" fummelt an dem Gebuesch herum.\n", ({TP}));
      rudolf_da = 0;
      CLONEME(NPC "rudolf.lpc");
      return 1;
    
     }
    }
  int c_fliegen(string str)
{
   notify_fail(BS("Wohin moechtest Du fliegen?"));
   if(!((str == "zu stern") || 
	(str == "zu abendstern") ||
        (str == "zum stern") ))
   {
     return 0;
   }
    
   write(BS("Du schliesst Deine Augen und streckst Deine Arme aus. Du "
	    "fuehlst Dich frei! Ploetzlich beginnst Du zu schweben. "
	    "Hoeher und immer hoeher schwebst Du! Du fliegst auf den "
	    "grossen Stern zu und landest wohlbehalten."));
   TP->move( ROOM "raumstern.lpc", M_GO);
     return 1;
    }

 
