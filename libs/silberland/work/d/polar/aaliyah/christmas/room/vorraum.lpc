inherit "std/room";
inherit "/gilden/bardengilde/obj/quest/reiselied_functions";

#include "../def.h"
#include <properties.h>
#include <moving.h>

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Haus des Weihnachtsmannes");
  SetProp( P_INT_LONG,
	"Du stehst in einem kleinen, gemuetlichen Vorzimmer. Der Boden "
	"wurde mit dicken, flauschigen Baerenfellen ausgelegt und laesst "
	"den Raum ziemlich gemuetlich wirken. An den Waenden haengen lauter "
	"lodernde Fackeln und tauchen den Raum in ein angenehm warmes Licht. "
	"Im Osten kannst Du eine grosse Kueche betreten, im Sueden gelangst Du "
	"zur Werkstatt, im Norden ist ein Badezimmer und im Westen ist die "
	"Tuer, die zum Wald zurueckfuehrt.");       
 	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang--------------------------------------------------------

   AddDetail( ({"raum","raumes","vorraum","vorraumes","vorzimmer"}), 
		   QueryProp(P_INT_LONG) );

  
  
  AddDetail( ({"boden","baerenfelle","baerenfellen","felle","fellen"}), 
            "Der Boden wurde mit weichen Baerenfellen ausgelegt. Das macht "
	    "den Raum so richtig gemuetlich. Verwunderlicherweise sind die "
	    "Felle sauber, obwohl sie direkt im Eingangsbereich der Huette "
	    "liegen und der Weihnachtsmann seine Stiefel garantiert nicht "
	    "immer auszieht.");
             

  AddDetail( ({"eingangsbereich","bereich","eingang","terrains","terrain"}), 
            "Der Eingangsbereich ist jener Bereich, der sich unmittelbar "
	    "um den Eingang eines Terrains befindet.");
            
	 
  AddDetail( ({"huette"}),
	    "Eine vertraeumte, verschneite Huette.");

  AddDetail( ({"vorgarten"}),
	    "Der Vorgarten befindet sich vor der Huette.");
      

  AddDetail( ({"stiefel"}),
	    "Wenn man von draussen kommt, sind die Stiefel meist matschig "
	    "und nass.");
	    	  
  
  AddDetail( ({"weihnachtsmann","weihnachtsmannes"}),
	    "Der rennt hier sicher wo herum.");
	 
  AddDetail( ({"wand","waende","waenden"}),
	    "Einige Fackeln befinden sich an den Waenden.");
	  

  AddDetail( ({"fackeln","licht","fackel"}),
	    "Die Fackeln lodern monoton vor sich hin und tauchen den "
	    "Raum in ein warmes Licht.");
         

  AddDetail( ({"decke"}),
	    "Die Decke ist nicht sonderlich interessant. Aber es ist wirklich "
	    "interessant, fuer was Du Dich so alles interessierst.");

  AddDetail( ({"osten","kueche"}),
	    "Durch die Kuechentuer kannst Du kaum was erkennen. Du solltest "
	    "einfach hinein gehen, wenn Du mehr sehen moechtest.");
  
  AddDetail( ({"sueden","werkstatt"}),
	    "Die Tuer zur Werkstatt ist angelehnt, aber der Schlitz ist "
	    "zu schmal, als dass Du viel sehen kannst.");

  AddDetail( ({"licht","waerme"}),
	    "Das Licht der Fackeln strahlt eine wohlige Waerme aus.");
  
  AddDetail( ({"schlitz","tuerschlitz"}),
	    "Aber rein gar nichts kannst Du durch den Tuerschlitz sehen.");
            

  AddDetail( ({"norden","badezimmer","badezimmertuer"}),
	    "Im Norden befindet sich eine leicht geoeffnete Badezimmertuer. ");

 AddDetail( ({"tuer"}),
	    "Es gibt eine Eingangstuer, eine Badezimmertuer, eine Tuer, die "
	    "zur Werkstatt fuehrt, eine Kuechentuer und eine Wohnzimmertuer.");

 AddDetail( ({"westen","wald"}),
	    "Durch die Eingangstuer im Westen gelangst Du wieder in den "
	    "klirrend kalten Wald zurueck.");

 AddDetail( ({"badezimmertuer"}),
	    "Die Badezimmertuer fuehrt ins Badezimmer.");
 
 AddDetail( ({"kuechentuer"}),
	    "Die Kuechentuer fuehrt in die Kueche.");

 AddDetail( ({"wohnzimmertuer"}),
	    "Die Wohnzimmertuer fuehrt ins Wohnzimmer.");

 AddDetail( ({"himmel"}),
	    "Den kannst Du draussen betrachten.");

 AddDetail( ({"leckereien"}),
	    "Allerlei Leckereien, die Dir gewiss munden wuerden.");


 AddDetail( ({"eingangstuer"}),
	    "Durch die Eingangstuer kannst Du hinaus oder herein gehen.");

 AddDetail( ({"werkstatttuer"}),
	    "Die Werkstatttuer fuehrt in die Werkstatt.");

 AddDetail( ({"nase","duft","zimt","bratapfel","kekse","keksen"}),
	    "Benutz Deine Nase und geniesse den herrlichen Duft.");

 
 AddDetail( ({"gesang","klappern","lieder","stimmen"}),
	    "Wie waere es mit lauschen?");

 
 AddDetail( ({"frau"}),
	    "Die Frau des Weihnachtsmannes soll sehr nett sein.");

 AddDetail( ({"wohnzimmer"}),
	    "Du hast Dich getaeuscht, Du siehst hier doch nur die Kuechentuer.");






   
  AddSmell(DEFAULT_SMELL, "Der suesse Duft von frisch gebackenen Keksen "
         "durchstroemt Deine Nase. Es riecht auch noch herrlich nach Zimt "
	 "und nach Bratapfel.");
                        
 
  AddSmell( ({"zimt","bratapfel","kekse","keksen"}),
	   "Die Frau des Weihnachtsmannes macht wohl gerade Leckereien.");
  
  AddSmell( ({"duft"}),
	    "Es duftet nach Zimt, Bratapfel und nach suessen Keksen.");
	  
  
  AddSound(DEFAULT_SOUND, "Aus der Kueche dringt ein leiser Gesang und aus "
		  "der Werkstatt hoerst Du viele Stimmen und ein Klappern.");

  AddSound( ({"gesang"}),
	"Die Frau des Weihnachtsmannes singt froehliche Lieder.");

  AddSound( ({"stimmen"}),
	"Viele zarte Stimmen dringen aus der Werkstatt.");

  AddSound( ({"klappern"}),
	"Anscheinend wird dort gerade gearbeitet.");
 
  AddSound( ({"lieder"}),
	"Es ist ein andaechtiger, weihnachtlicher Gesang.");

 
	
	   
  

//-----Details Ende-----
  
//AddExit("westen", "./platz2.lpc");
AddExit("norden", "./bad.lpc");
AddExit("osten", "./wkueche.lpc");
AddExit("sueden", "./werkstatt.lpc");

AddItem( ARMOUR "wstiefel.lpc", REFRESH_DESTRUCT);
 

 NewDoor( ({"westen"}), ROOM "vorgarten" , ({"tuer","eingangstuer"}) ,
   ({D_FLAGS,DOOR_CLOSED|DOOR_RESET_CL
     ,D_NAME, "Eingangstuer"
    ,D_GENDER, FEMALE
     ,D_SHORT, "Eine %se Eingangstuer."
     ,D_LONG, "Durch diese Tuer gelangst Du in den Vorgarten."
     ,D_MSGS,    ({"geht in die Kaelte hinaus","kommt aus der warmen Huette"})
     ,D_OPENMSG, ({"Du oeffnest die Eingangstuer.",
                   "%s oeffnet die Eingangstuer.",
                  " wird knarrend von draussen geoeffnet."})
     ,D_CLOSEMSG, ({"Du schliesst die Eingangstuer.",
                    "%s schliesst die Eingangstuer.",
                    " wird von draussen geschlossen."})
     ,D_RESET_CLOSEMSG, " wird durch eine magische Kraft geschlossen."}));
  
}

public void init() {
	::init();
  
	if(interactive(this_player())) {
	  check_bard_awf_quest(this_player());
	}
  }   
