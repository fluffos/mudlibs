// Christmas Creations
//     by Aaliyah


inherit "std/room";
#include "../def.h"
#include <properties.h>
#include <moving.h>



void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im einem kleinen Schlafgemach");
  SetProp( P_INT_LONG,
	"Du befindest Dich hier in einer kleinen Schlafkammer. Vier kleine "
	"Betten stehen direkt vor Dir. Weitere zwei Betten erkennst Du auf "
	"einer kleinen Kommode, die an der Westwand steht. Ausserdem siehst "
	"Du noch einen kleinen Tisch mit zwei Stuehlen davor und eine "
	"Truhe mit Spielzeug. Ein Kleiderstaender, der mit Kleidung "
	"ueberhaeuft wurde, steht auch noch im Raum herum. Eine schmale "
	"Treppe fuehrt nach unten in die Werkstatt.");       
      

	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----


 AddDetail( ({"raum","raumes","zimmer","schlafkammer","zimmers","kammer"}), 
                   QueryProp(P_INT_LONG) );

  
  
     
  
  AddDetail( ({"boden"}), 
            "Flauschige Felle wurden ueber den gesamten Boden gebreitet.");
             

  AddDetail( ({"felle","fell"}), 
            "Die Felle duerften von einem Schneetiger oder einem "
	    "Schneeloewen stammen.");
            
	 
  AddDetail( ({"tiger","schneeloewen","schneeloewe","schneetiger"}),
	    "Die Felle sind weiss und flauschig.");
      

  AddDetail( ({"decke"}),
	    "Du blickst zur Decke hinauf und ploetzlich wird Dir schwindelig. "
	    "Als Du wieder zu dir kommst, weisst Du nicht mehr, wer du bist.");
	    	  
  
  AddDetail( ({"waende","waenden","wand"}),
	    "Die Wand wurde blasslila ausgemalt. Viele Bilder und Poster "
	    "wurden an den Waenden befestigt. Lediglich die Westwand ist mit "
	    "einer grossen Kommode verstellt.");
	 
  AddDetail( ({"bilder","bild"}),
	    "Auf den Bildern befinden sich viele unterschiedliche Leute. "
	    "Anscheinend sind das die Familienangehoerigen derer, die hier "
	    "wohnen.");
	  

  AddDetail( ({"leute","familienangehoerigen","angehoerigen","familie",
	  "familien","leuten","angehoerige","familienangehoerige"}),
	    "Die Familien der Kinder, die hier arbeiten, sind leider "
	    "schon verstorben. Darum hat der nette Weihnachtsmann den Kindern "
	    "ein schoenes Heim gegeben. Die Kinder helfen ihm als Dank dafuer "
	    "bei der Herstellung der Weihnachtsgeschenke.");
         

  AddDetail( ({"weihnachtsmann","weihnachtsmannes"}),
	    "Der Weihnachtsmann kommt hier nur herauf, wenn er den Kindern "
	    "Kleidung oder Geschenke bringen moechte.");

  AddDetail( ({"heim","dank"}),
	    "Die Kinder sind dem Weihnachtsmann sehr dankbar, dass er sie "
	    "bei sich aufgenommen hat. Sie arbeiten auch sehr gerne fuer ihn.");
  
  AddDetail( ({"herstellung","geschenke","geschenken","weihnachtsgeschenke",
		  "weihnachtsgeschenken","geschenk","weihnachtsgeschenk"}),
	    "Die Weihnachtsgeschenke werden groesstenteils von den Kindern "
	    "hergestellt. Es macht ihnen sehr viel Spass, sich kreativ "
	    "betaetigen zu koennen und zu basteln.");

  AddDetail( ({"spass"}),
	    "Den Kindern macht es total viel Spass, hier zu arbeiten.");
  
  AddDetail( ({"kinder","kind","kindern"}),
	    "Der Weihnachtsmann und seine Frau haben es den Kindern "
	    "ermoeglicht, trotz ihrer schlimmen Erfahrungen noch eine schoene "
	    "Kindheit zu haben.");
            

  AddDetail( ({"frau","estefania"}),
	    "Estefania liebt Kinder ueber alles. Und da sie selbst keine "
	    "bekommen kann, freut sie sich ueber jedes Kind, das hier wohnt. "
	    "Sie behandelt alle Kinder hier, als waeren es ihre eigenen, und "
	    "liebt sie auch als waeren sie es. ");

 AddDetail( ({"erfahrungen","erfahrung"}),
	    "Wenn man mit Leuten zu tun hat, die schlechte Erfahrungen gemacht "
	    "haben, muss man eben ein gewisses Fingerspitzengefuehl fuer "
	    "sie aufbringen und ein bisschen auf sie eingehen.");

 AddDetail( ({"fingerspitzengefuehl","gefuehl"}),
	    "Hast Du sowas?");

 AddDetail( ({"kindheit"}),
	    "Hier beim Weihnachtsmann und seiner Frau duerfen die Kinder "
	    "ihre Kindheit voll und ganz ausleben.");
 
 AddDetail( ({"werkstatt","treppe"}),
	    "Die schmale, hoelzerne Treppe fuehrt direkt in die Werkstatt.");

 AddDetail( ({"truhe"}),
	    "Die grosse Truhe ist mit soviel Spielzeug vollgestopft, dass sie "
	    "sich nicht mehr schliessen laesst.");

 AddDetail( ({"spielzeug","autos","puppen","puppenkleider","plueschtiere",
			 "baukloetze","kloetze","dinge"}),
	    "Kleine bunte Autos, suesse Puppen und auch viele Puppenkleider, "
	    "unzaehlige Baukloetze und noch viele flauschige Plueschtiere "
	    "befinden sich in der Truhe.");

 AddDetail( ({"stuehlen","stuehle","stuhl"}),
	    "Kleine tuerkise Stuehle mit einer weichen Polsterung.");

 AddDetail( ({"polsterung"}),
	    "Die Polsterung ist cyan und ist wirklich gemuetlich weich.");

 AddDetail( ({"teller","kuchen","keksen","kekse","toertchen",
			 "erdbeersahnetoertchen"}),
	    "Leckerer Kuchen, viele Kekse und auch einige "
	    "Erdbeersahnetoertchen befinden sich auf dem Teller. Da sie "
	    "fuer jemand anderen bestimmt sind, laesst Du sie dort, wo sie "
	    "liegen.");

  AddDetail( ({"kerze","feuer"}),
	    "Dies ist eine magische Kerze. Sie brennt, wenn sie brennen moechte "
	    "und erlischt, wenn sie ihr Feuer loeschen moechte. Momentan "
	    "brennt sie.");

  AddDetail( ({"tisch"}),
	    "Ein kleiner tuerkiser Tisch mit einer Kerze und einem Teller "
	    "darauf.");
	   
	    

  AddDetail( ({"kleiderstaender"}),
	    "Der Kleiderstaender ist mit Kinderkleidung voellig ueberhaeuft.");
	  
  AddDetail( ({"kinderkleidung","kleidung"}),
	   "Huebsche Kleider, warme Jacken, bunte Hosen und auch viele "
	   "weiche Pullover und Blusen haengen dort.");
	 	
	 

  AddDetail( ({"kleider","jacken","hosen","pullover","blusen"}),
	   "Diese Dinge gehoeren nicht Dir, also stoeberst Du auch nicht "
	   "laenger herum.");
          

  AddDetail( ({"betten","bett"}),
	   "Es gibt ein hellblaues Bett, ein weisses Bett, ein zartrosa Bett, "
	   "ein fliederfarbenes Bett, ein sonnengelbes Bett und ein "
	   "mintgruenes Bett.");

  AddDetail( ({"groesse","schuhkartons","schuhkarton","karton","kartons"}),
	   "Zwei der Betten sind nicht groesser als ein Schuhkarton.");

  AddDetail( ({"kommode","ablageflaeche"}),
	   "Eine hellblaue Kommode steht an der Westwand. Sie hat zwei "
	   "Schubladen. Auf der Ablageflaeche stehen ein fliederfarbenes und "
	   "ein mintgruenes Bett.");

  AddDetail( ({"hellblaues bett","arion"}),
	   "Das hellblaue Bett gehoert Arion.");

  AddDetail( ({"zartrosa bett","athenia"}),
	    "Das zartrosa Bett gehoert Athenia.");
  
  AddDetail( ({"weisses bett","finja"}),
	    "Das weisse Bett gehoert Finja.");

  AddDetail( ({"fliederfarbenes bett","thalya"}),
	     "Das fliederfarbene Bett gehoert Thalya und hat etwa die "
	     "Groesse eines Schuhkartons.");

  AddDetail( ({"sonnengelbes bett","martin"}),
	     "Das sonnengelbe Bett gehoert Martin und ist etwa gleich "
	     "gross wie die Truhe.");
  
  AddDetail( ({"mintgruenes bett","elijah"}),
	     "Das mintgruene Bett gehoert Elijah und hat etwa die "
	     "Groesse eines Schuhkartons.");

  AddDetail( ({"schubladen","schublade"}),
	   "Die Schubladen sind geschlossen. Jede von ihnen hat ein "
	   "kleines Schluesselloch. Es gibt eine obere und eine untere "
	   "Schublade.");

  AddDetail( ({"schluesselloch"}),
	   "Ohne Schluessel laesst sich die Schublade wohl kaum oeffnen.");

  AddDetail( ({"schluessel"}),
	   "Die Schluessel befinden sich in einem geheimen Versteck.");

  AddDetail( ({"versteck"}),
	   "Haaaaaaahaha! So einfach geht das auch wieder nicht.");

  AddDetail( ({"poster","postern"}),
	   "Auf den Postern sind viele beruehmte Elfen, Zwerge und Feen.");

  AddDetail( ({"zwerge","andruil","dejot","drachen","drache","kampf"}),
	   "Eines der Poster zeigt Andruil und Dejot im Kampf mit einem "
	   "Drachen.");

  AddDetail( ({"elfen","elf","fenris"}),
	   "Eigentlich ist da nur ein Elf darauf. Es ist Fenris in allen "
	   "moeglichen Posen.");

  AddDetail( ({"feen","fee"}),
	   "Eine der Feen sieht irgendwie aus wie Lictor, die andere Fee "
	   "wie Vania und die dritte Fee wie Kia.");

  AddDetail( ({"kia","lictor","vania","silberland"}),
	   "Diese Feen sind auf dem Poster. Nur leider gibt es Vania nicht "
	   "mehr im Silberland.");

  AddDetail( ({"posen","poser","habakuk","trintrasil","lord","habakuks",
			  "posern"}),
	   "Mit Posern und Habakuks kennt sich Lord Trintrasil sehr gut "
	   "aus.");





  
  AddSmell(DEFAULT_SMELL, "Es duftet hier suess und erdbeerig.");
                        
 
  AddSmell( ({"suess","erdbeerig"}),
	   "Erdbeerig suess!");
  
    
  AddSound(DEFAULT_SOUND, "Hier ist es sehr still.");
	
	   
  

//-----Details Ende-----------------------------------------------------------

//-----Kommandos Anfang-------------------------------------------------------
  
AddExit("unten", "./werkstatt.lpc");
AddItem(NPC "elijah.lpc", REFRESH_DESTRUCT);
AddCmd( ({ "oeffne", "oeffne" }), "c_oeffnen");
 

}
   int c_oeffnen(string str)
{
   notify_fail(BS("Was moechtest Du hier oeffnen?"));
   if(!((str == "obere schublade") ||
        (str == "untere schublade")))
   {
     return 0;
   }
     write(BS("Du hast Doch gar keinen passenden Schluessel!"));
   	   
     return -1;
   

}
   
