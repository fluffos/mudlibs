// Christmas Creations 


inherit "std/room";
#include "../def.h"
#include <properties.h>
#include <moving.h>



void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Wohnzimmer des Weihnachtsmannes");
  SetProp( P_INT_LONG,
	"Gemuetlich wirkt das Wohnzimmer des Weihnachtsmannes. In der Mitte "
	"des Raumes befindet sich ein grosses, kuscheliges Sofa. Davor "
	"erspaehst Du einen Kamin, in dem ein helles Feuer lodert. Neben dem "
	"Sofa steht ein kleiner Beistelltisch. Weiters wurde der Boden mit "
	"unzaehligen Eisbaerenfellen ausgelegt, was dem Raum eine ganz "
	"besondere Atmosphaere verleiht. Nicht zu uebersehen ist noch die "
	"kleine Treppe, die hinauf ins Ungewisse fuehrt.");       
 	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang--------------------------------------------------------

   AddDetail( ({"raum","raumes","zimmer","wohnzimmer","zimmers"}), 
		   QueryProp(P_INT_LONG) );

  
  
  AddDetail( ({"boden","eisbaerenfelle","baerenfelle","eisbaerenfellen","felle",               "fellen"}), 
            "Viele weiche Eisbaerenfelle wurden ueber den Boden gebreitet "
	    "und sorgen fuer warme Fuesse. Sie sind nicht nur bequem, der "
	    "Raum sieht dadurch auch richtig edel aus.");
             

  AddDetail( ({"fuesse"}), 
            "Fuesse sollten immer schoen gepflegt sein.");


  AddDetail( ({"jacken","jacke","wollmuetzen","wollmuetze","masche","detail"}),
	    "Dieses Detail ist momentan zugeschneit.");
            
	 
  AddDetail( ({"weihnachtsmannes","weihnachtsmann","mann"}),
	    "Wenn er nicht hier ist, ist er woanders.");
      

  AddDetail( ({"decke"}),
	    "Die Decke ist nicht sonderlich interessant.");

  AddDetail( ({"nase","geruch","duft","die","riechen"}),
	    "Die Nase ist zum Riechen da.");

	    	  
  
  AddDetail( ({"mitte","sofa"}),
	    "Viele riesige Kissen liegen auf dem grossen, weissen Sofa. "
	    "Irgendwie sieht es so aus, als wuerde das Sofa aus Wolken "
	    "bestehen.");
	 
  AddDetail( ({"wand","waende","waenden"}),
	    "Einige Fackeln befinden sich an den Waenden.");
	  

  AddDetail( ({"fackeln","licht"}),
	    "Die Fackeln lodern monoton vor sich hin und tauchen den "
	    "Raum in ein warmes Licht.");
         

  AddDetail( ({"wolken","wolke"}),
	    "Als Du genauer hinsiehst, erkennst Du, dass es sich wirklich um "
	    "Wolken handelt. Ein Sofa aus Wolken! Du kannst es kaum glauben. "
	    "Umso groesser ist Deine Neugierde Dich auf das Sofa zu legen und "
	    "zu testen wie weich Wolken wirklich sind.");

  AddDetail( ({"neugierde"}),
	    "Leg Dich doch einfach hin, wenn Du es so gerne moechtest. Der "
	    "Weihnachtsmann ist sehr human, und hat bestimmt nichts dagegen.");
  
  AddDetail( ({"kissen","daunenkissen"}),
	    "Dicke, grosse Daunenkissen mit einem weissgoldenen Ueberzug.");

  AddDetail( ({"licht","waerme"}),
	    "Das Licht der Fackeln strahlt eine wohlige Waerme aus.");
  
  AddDetail( ({"treppe"}),
	    "Die Treppe besteht aus Kirschholz. Sie hat rechts und links ein "
	    "Gelaender, damit der Weihnachtsmann nicht von den Stufen kippt, "
	    "falls er einmal zuviel Punsch erwischt hat.");
            

  AddDetail( ({"punsch","apfelpunsch"}),
	    "Der Weihnachtsmann liebt frischen Apfelpunsch. Seine Frau macht "
	    "ihn mit Vanille und Zimt. ");

 AddDetail( ({"vanille","zimt","leckereien","art"}),
	    "Die Frau des Weihnachtsmannes bemueht sich stets ihren Mann mit "
	    "Leckereien aller Art zu verwoehnen.");

 AddDetail( ({"frau","estefania"}),
	    "Der Weihnachtsmann hat eine sehr fleissige und liebe Frau, die "
	    "stets freundlich, fleissig und zuvorkommend ist.");

 AddDetail( ({"gelaender","stufen","kirschholz","holz"}),
	    "Das Gelaender und die Stufen der Treppe bestehen aus Kirschholz.");
 
 AddDetail( ({"ueberzug","ueberzuege"}),
	    "Die Ueberzuege duften frisch gewaschen und haben goldene "
	    "Stickereien.");

 AddDetail( ({"wohnzimmertuer","kueche","tuer"}),
	    "Die Wohnzimmertuer fuehrt in die Kueche.");

 AddDetail( ({"beistelltisch"}),
	    "Ein kleiner hoelzerner Beistelltisch. Eine Kerze, ein Buch, ein "
	    "Teller und ein Glas stehen darauf.");

 AddDetail( ({"kerze"}),
	    "Die Kerze wurde erst vor kurzem angezuendet. Es ist eine "
	    "magische Kerze, die nicht geloescht werden kann, da sie selbst "
	    "erlischt.");
 
 AddDetail( ({"glas"}),
	    "Ein leeres Glas. Der Weihnachtsmann hat es vorhin gierig "
	    "leergetrunken.");

 AddDetail( ({"teller"}),
	    "Nur noch Kekskruemel befinden sich am Teller. Der Weihnachtsmann "
	    "hatte anscheinend grossen Appetit auf Kekse.");

 AddDetail( ({"kruemel","kekse","appetit","kekskruemel"}),
	    "Lediglich Kruemel befinden sich am Teller.");
 
 
 AddDetail( ({"buch","einband"}),
	    "Ein dickes, altes Buch mit einem goldenen Einband. Vorne steht "
	    "geschrieben 'Die Bewohner des Silberlandes'.");

 AddDetail( ({"bewohner","silberlandes","silberland"}),
	    "In diesem Buch sind viele Informationen ueber die Bewohner "
	    "des Silberlandes enthalten. Leider kann es nur vom Weihnachtsmann "
	    "gelesen werden. Aber dieser ist sicher bereit, Dir Auskunft "
	    "ueber den einen oder anderen Spieler hier zu geben.");

 
 AddDetail( ({"auskunft","spieler","information","spielernamen","namen"}),
	    "Frag den Weihnachtsmann einfach nach irgendeinem Spielernamen, "
	    "der Dich interessiert. Vielleicht sagt er Dir ja etwas dazu.");

 AddDetail( ({"stickereien","muster"}),
	    "Geschnoerkelte, goldene Muster.");

 AddDetail( ({"kamin"}),
	    "Ein grosser Kamin aus Backsteinen mit einem breiten Kaminsims. "
	    "Ein grosses Feuer wurde darin entfacht, das helllodernd "
	    "eine weihnachtliche Stimmung in Dir hervorruft. Ausserdem wurden "
	    "sechs kleine Weihnachtsstruempfe am Kaminsims befestigt.");


 AddDetail( ({"backsteine","steine","backsteinen"}),
	    "Der Kamin wurde aus vielen Backsteinen gemauert.");

 AddDetail( ({"sims","kaminsims"}),
	    "Einige Teelichter wurden am Kaminsims aufgestellt. Weit "
	    "interessanter scheinen da schon die Weihnachtsstruempfe, die "
	    "auch am Sims befestigt wurden.");

 AddDetail( ({"teelichter","lichter","kerzen","kerze"}),
	    "Die Teelichter flackern lichterloh.");

 
 AddDetail( ({"feuer","flammen"}),
	    "Hell lodernd!");

 AddDetail( ({"feuerfunke","funke"}),
	    "Der Funke ist schon wieder erloschen.");

 
 AddDetail( ({"stimmung"}),
	    "Es ist alles sehr stimmungsvoll hier. Du wuenschst Dir, dass "
	    "Du auch so ein gemuetliches Zuhause haettest.");

 AddDetail( ({"zuhause"}),
	    "Dein Zuhause ist bei weitem nicht so stimmungsvoll.");

 
  AddDetail( ({"struempfe","weihnachtsstruempfe","weihnachtsstrumpf"}),
	    "Ein roter, ein blauer, ein gelber, ein gruener, ein hellrosa "
	    "und ein hellblauer Weihnachtsstrumpf haengen am Kaminsims.");

 AddDetail( ({"blauer strumpf","blauer weihnachtsstrumpf"}),
	    "Am blauen Strumpf stehen in goldenen Buchstaben die Namen "
	    "'Elijah und Thalyah'. Dieser Strumpf gehoert wohl den kleinen "
	    "Wichtel, die hier arbeiten. Als Du hineinblickst, siehst Du "
	    "suesse kleine Moebel und etwas Kleidung.");

  AddDetail( ({"elijah","wichtel","wichteln"}),
	    "Elijah ist ein kleiner Wichtel, der hier arbeitet. Er hat auch "
	    "kein Haus, darum schlaeft er meistens hier.");

  AddDetail( ({"thalyah","wichtelmaedchen"}),
	    "Thalyah ist ein kleines Wichtelmaedchen und arbeitet hier beim "
	    "Weihnachtsmann. Sie hat kein Haus, darum schlaeft sie meistens "
	    "hier.");

  AddDetail( ({"haus"}),
	    "Der Weihnachtsmann hat fuer die Wichtel ein kleines Haus "
	    "gebaut. Aber mit dem werden sie erst zu Weihnachten ueberrascht.");

  AddDetail( ({"moebel"}),
	    "Zwei kleine Betten, ein Kasten und ein Tisch mit einem Stuhl.");

  AddDetail( ({"betten","bett","kasten","tisch","stuhl","miniformat"}),
	    "Alles im Miniformat passend fuer die Wichtel.");
  
  AddDetail( ({"kleidung"}),
	    "Ein kleines Kleidchen, zwei Hosen, zwei Pullover, zwei Paar "
	    "Socken, zwei dicke Jacken, zwei Wollmuetzen und zwei Paar "
	    "Handschuhe.");

  AddDetail( ({"kleidchen","hosen","pullover","paar","socken","jacken"
		"wollmuetzen","handschuhe"}),
	    "Das gehoert den kleinen Wichteln.");

  AddDetail( ({"hellrosa strumpf","hellrosa weihnachtsstrumpf"}),
	    "Am hellrosa Weihnachtsstrumpf steht in weissen Buchstaben der "
	    "Name 'Athenia'. Als Du hineinblickst, siehst Du ein huebsches, "
	    "hellblaues Elfenkleid..");

    AddDetail( ({"athenia","elfenmaedchen","waldelfe"}),
	    "Athenia ist eine kleine suesse Waldelfe, die hier arbeitet. Das "
	    "Elfenmaedchen hatte sich schon lange ein schoenes Kleid "
	    "gewuenscht.");


  AddDetail( ({"elfenkleid","kleid","schleife","spitzen","seidenkleid","taille"}),
	    "Ein zartes, hellblaues Seidenkleid mit einer grossen Masche um "
	    "die Taille und weissen Spitzen.");

  AddDetail( ({"hellblauer strumpf","hellblauer weihnachtsstrumpf"}),
	    "Am hellblauen Strumpf steht mit weissen Buchstaben der Name "
	    "'Arion'. Als Du hineinblickst, siehst Du eine einfache rote "
	    "Rose und ein Blatt Papier.");

  AddDetail( ({"rose","blatt","papier"}),
	    "Arion wuenschte sich eine Rose und ein Blatt Papier, um Athenia "
	    "zu Weihnachten eine Freude machen zu koennen.");

  AddDetail( ({"freude"}),
	    "Aus dem Blatt Papier moechte sich Arion eine Karte basteln, um "
	    "sie Athenia zu schenken.");

  AddDetail( ({"geheimnis"}),
	    "Weil es ein Geheimnis ist, wirst Du es nicht erfahren, es sei "
	    "denn, Du fragst Arion selbst.");


  AddDetail( ({"karte"}),
	    "Was auf der Karte steht, wird wohl Arions Geheimnis bleiben.");


  AddDetail( ({"arion","elfenjunge","waldelf","arions"}),
	    "Arion ist der Elfenjunge, der sich um die Rentiere kuemmert. "
	    "Er hat sich lediglich eine Rose und ein Blatt Papier vom "
	    "Weihnachtsmann gewuenscht.");


  AddDetail( ({"gruener strumpf","gruener weihnachsstrumpf"}),
	    "Am gruenen Strumpf steht in goldenen Buchstabe der Name "
	    "'Martin'. Dieser Strumpf gehoert dem kleinen Zwerg Martin, "
	    "der dem Weihnachtsmann Geschenke verpackt. Als Du hineinblickst, "
	    "siehst Du ein Superzwergkostuem.");
  
  AddDetail( ({"zwerg","martin","zwergenkind"}),
	    "Martin ist ein kleines Zwergenkind, das davon traeumt, einmal "
	    "ein Superzwerg zu werden, wenn es gross ist.");

  AddDetail( ({"superzwerg","superzwergkostuem","kostuem","kostuems"}),
	    "Das Superzwergkostuem wurde nur fuer Martin angefertigt. Es "
	    "hat einen kleinen, blauen Panzer und blaue Leggings und "
	    "einen goldenen Umhang.");

  AddDetail( ({"panzer","umhang","leggings","umhang","teile","teil"}),
	    "Das ist ein Teil des Kostuems.");


  AddDetail( ({"gelber strumpf","gelber weihnachsstrumpf"}),
	    "Am gelben Strumpf steht in dunkelblauen Buchstaben der Name "
	    "'Finja'. Dieser Strumpf gehoert der kleinen Waldfee, die beim "
	    "Weihnachtsmann fleissig arbeitet. Als Du hineinblickst, siehst "
	    "Du eine kleine, suesse Puppe.");

  AddDetail( ({"finja","waldfee"}),
	    "Finja, die kleine Waldfee arbeitet beim Weihnachtsmann und hilft "
	    "ihm die Geschenke herzustellen. Sie ist eigentlich ein Feenkind, "
	    "und das ist auch der Grund, wieso sie eine Puppe geschenkt "
	    "bekommt.");

  AddDetail( ({"feenkind","puppe","grund"}),
	    "Fuer ein Feenkind ist eine Puppe ein ganz tolles Geschenk.");


  AddDetail( ({"geschenke","weihnachten","werkstatt"}),
	    "In der Werkstatt des Weihnachtsmannes werden die Geschenke "
	    "fuer Weihnachten hergestellt.");



 AddDetail( ({"roter strumpf","roter weihnachsstrumpf"}),
	    "Am roten Strumpf steht in goldenen Buchstaben der Name "
	    "'Estefania'. Dieser Strumpf gehoert anscheinend der Frau des "
	    "Weihnachtsmannes. Als Du hineinblickst, siehst Du ein kleines "
	    "Diamantcollier.");


 AddDetail( ({"name","namen"}),
	    "An jedem Strumpf ist ein anderer Name aufgestickt.");


 AddDetail( ({"collier","diamantcollier"}),
	    "Das ist wohl das Geschenk vom Weihnachtsmann an seine geliebte "
	    "Frau.");


 AddDetail( ({"geschenk"}),
	    "In jedem Strumpf wurde ein anderes Geschenk hineingesteckt.");

 AddDetail( ({"huette"}),
	    "Dies ist die gemuetliche Huette des Weihnachtsmannes.");

 AddDetail( ({"buchstaben"}),
	    "Jeder Strumpf hat andersfarbige Buchstaben aufgestickt.");



 AddDetail( ({"ungewisse"}),
	    "Wohin diese Treppe fuehrt, kann man von hier nicht erkennen.");

 AddDetail( ({"atmosphaere"}),
	    "Du fuehlst Dich so richtig wohl hier.");

 
AddRoomMessage( ({"Das Feuer flackert im Kamin.\n",
                  "Das Feuer im Kamin knistert.\n",
		  "Die Flammen der Teelichter tanzen.\n",
                  "Ein Feuerfunke springt aus dem Kamin heraus.\n",
                  "Ein feiner Duft aus der Kueche stroemt herein.\n"}), 80);
  

  
 


   
  AddSmell(DEFAULT_SMELL, "Der suesse Duft von frisch gebackenen Keksen "
         "dringt aus der Kueche in Deine Nase.");
                        
 
  AddSmell( ({"zimt","bratapfel","kekse","keksen","backwaren","kueche"}),
	   "In der Kueche wurde wohl gerade gebacken. Somit riecht die "
	   "ganze Huette nach frischen Backwaren.");
  
    
  AddSound(DEFAULT_SOUND, "Du hoerst leise das Knistern des Feuers.");

  AddSound( ({"knistern","feuer","feuers"}),
	"Das Feuer knistert vor sich dahin.");

   
  

//-----Details Ende-----
  
AddExit("westen", "./wkueche.lpc");
AddExit("nordoben", "./szimmer.lpc");
AddCmd( ({ "lieg", "liege" }), "c_liegen");
AddItem(NPC "wmann.lpc", REFRESH_DESTRUCT);


}  
     int c_liegen(string str)
{
   notify_fail(BS("Worauf willst Du liegen?"));
   if(!((str == "auf sofa") || 
	(str == "auf wolke") ||
	(str == "auf wolken") ||
        (str == "auf couch")))
   {
     return 0;
   }
    
   write(BS("Du laesst Dich ins Sofa fallen und sinkst in das flauschig "
	    "weiche Wolkensofa. Es fuehlt sich herrlich an und Du weisst "
	    "Du bist noch nie so angenehm gelegen."));
     tell_room(ENV(TP), TPN+" legt sich gemuetlich aufs Sofa.\n", ({TP}));
     TP->command_me("raste");

         
     return 1;
    }
   
