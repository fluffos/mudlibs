// Christmas Creations


inherit "std/room";
#include "../def.h"
#include <properties.h>
#include <moving.h>



void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einer Glaskugel");
  SetProp( P_INT_LONG,
	"Du befindest Dich in einer Glaskugel.");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden"}), 
            "Den Boden kann man vor lauter Schnee nicht erkennen.");
             

  AddDetail( ({"schnee"}), 
            "Schnee, Schnee, Schnee... ueberall gibts Schnee.");
            
	 
  AddDetail( ({"wand","waenden","waende","glaswaende","glaswaenden","glaswand"}),
	    "Die Waende sind rund und bestehen voellig aus Glas.");
      

  AddDetail( ({"glaskugel","kugel","glas"}),
	    "Du befindest Dich in einer Glaskugel, wie sie Kinder oft "
	    "zum Spielen haben.");
	    	  
 
  AddDetail( ({"spielen"}),
	    "Jetzt erst bemerkst Du einige Schemen hinter den Glaswaenden.");
 
  AddDetail( ({"kinder","obhut","erwachsenen","erwachsene"}),
	    "Kinder unterliegen der Obhut von Erwachsenen.");
  

  AddDetail( ({"schemen"}),
	    "Zwei grosse, braune Kinderaugen blicken Dich neugierig durch die "
	    "Glaswand an.");
         

  AddDetail( ({"augen","kinderaugen"}),
	    "Ein suesses, riesiges Maedchen scheint ausserhalb der Kugel zu "
	    "sein.");

  AddDetail( ({"maedchen"}),
	    "Das Maedchen scheint riesig, oder es ist einfach nur deshalb so, "
	    "weil Du so klein bist.");
 
  AddDetail( ({"schneeflocken","schneeflocke"}),
	    "Die Schneeflocken wirbeln wild herum.");
  
  
  AddDetail( ({"idee"}),
	    "Es koennte etwas mit einem Reim zu tun haben.");

  AddDetail( ({"weihnachtsblase"}),
            "Er schrieb den Wunsch auf ein Papier, und gab es einem "
	    "grossen *.........*.");

  AddDetail( ({"reim","reimes"}),
	    "Es war einmal ein Weihnachtshase, der wuenschte sich eine "
	    "Weihnachts*.....*.");

   AddDetail( ({"rentier"}),
	    "Das Rentier war voll guter Dinge, und schenkte ihm "
	    "freundlich ein Paar *.....*.");

   AddDetail( ({"ringe"}),
	    "Der Hase freute sich darueber sehr, doch wuenschte er sich "
	    "die Weihnachtsblase *.....*.");

   AddDetail( ({"mehr"}),
	    "So eilte das Rentier schnell hinfort, zu einem schoenen, "
	    "fremden *.....*.");

   AddDetail( ({"ort"}),
	    "Es zeigte dem Weihnachtsmann den Wunsch, und der trank "
	    "erstmal genuesslich einen *.....*.");

   AddDetail( ({"punsch"}),
	    "Was sollte eine Weihnachtsblase sein? Es fiel ihm dazu "
	    "einfach keine Loesung *.....*.");

   AddDetail( ({"ein"}),
	    "Waehrenddessen Hase klug, fand etwas Seife in einem "
	    "*.....*.");
 
   AddDetail( ({"krug"}),
	    "In seinem geistigen Auge, kam ihm die Idee einer "
	    "*.....*.");

   AddDetail( ({"seifenlauge"}),
	    "Er blies die Lauge durch die Ringe mit seiner Nase, "
	    "und erziehlt freudestrahlend eine bunte *.....*.");

   AddDetail( ({"seifenblase"}),
	    "Eine Weihnachtsblase ist eine Seifenblase. Diese Information "
	    "solltest Du dem Hasen aufs Auge druecken.");
  
   AddDetail( ({"hase","lauge","auge","bestandteile","dinge","paar","blase"
		"seife","wunsch","loesung","papier","weihnachts",
		"weihnachtshase","hasen"}),
	    "Alles Bestandteile des Reimes.");
    
   AddDetail( ({"ohren","schnee","schneegestoeber","schneeflocken"
	        "himmel","schneeflocke","decke"}),
	    "Du hast keine Zeit fuer sowas.");

    AddRoomMessage( ({"Unzaehlige Schneeflocken flirren um Dich herum.\n",
	          "Wildes Schneegestoeber umhuellt Dich.\n",
		  "Eine Schneeflocke schmilzt auf Deiner Nase.\n",
		  "Leise rieselt der Schnee.\n"}), 80);
 
   AddDetail( ({"nase","zeit","information"}),
	   "Die brauchst Du hier vielleicht.");

  
  AddSmell(DEFAULT_SMELL, "Hier riecht es einfach nur nach Schnee.");
                        
 
  AddSmell( ({"schnee"}),
	   "Du riechst an dem Schnee und Dir kommt eine Idee.");

    
  AddSound(DEFAULT_SOUND, "Du hoerst lediglich das Schneegestoeber.");
	   
  AddSound( ({"schneegestoeber","wind"}),
	   "Der Wind pfeift Dir um die Ohren und wirbelt den ganzen Schnee "
           "rund um Dich auf.");	   
  

//-----Details Ende-----

 AddItem( NPC "shase.lpc", REFRESH_DESTRUCT);
  AddCmd( ({ "druecke", "drueck" }), "c_druecken");
 AddCmd( ({ "ruettel", "ruettle" }), "c_ruetteln");
 
}  
   
   int c_druecken(string str)
{
   notify_fail(BS("Was moechtest Du dem aufs Auge druecken?"));
   if(!((str == "information hase aufs auge") || (str == "hase information aufs auge")))
   {
     return 0;
   }
   write(BS("Du drueckst dem Hasen die Information aufs Auge, und er aergert sich.\n"
	    "Der Hase sagt:'Du Besserwisser! Mich belehren wollen, aber selbst\n "
	    "Der Hase sagt: nicht auf die Idee kommen, an der Kugel zu ruetteln'."));
	  	  
   tell_room(ENV(TP), TPN+ " fluestert etwas leises.\n", ({TP}));
   
   return 1;
  }
  
  
   int c_ruetteln(string str)
{
   notify_fail(BS("Was moechtest Du hier ruetteln?"));
   if(!((str == "kugel") || (str == "glaskugel")))
   {
     return 0;
      
    }	   
   write(BS("Du stemmst Dich heftig gegen die Glaskugel und ruettelst sie "
	    "mit Deinem Gewicht hin und her. Ploetzlich beginnt sie zu "
	    "rollen und landet mit einem lauten Klirren auf dem Boden. "
	    "Du bekommst Deine normale Gestalt wieder und schuettelst Dir die "
	    "Scherben von der Kleidung."));
              TP->move(ROOM "vorraum.lpc", M_GO);
     return 1;
    }
    
    
