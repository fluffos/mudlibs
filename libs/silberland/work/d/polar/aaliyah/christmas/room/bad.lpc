// Christmas Creations 


inherit "std/room";
#include "../def.h"
#include <properties.h>
#include <moving.h>

void grundzustand();
int bademantel_da;
int kaestchen_offen;

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Badezimmer des Weihnachtsmannes");
  SetProp( P_INT_LONG,
	"Schoener, weisser Marmor vertaefelt das gesamte Badezimmer. "
	"Die gesamte Nordwand wird von einer grossen Badewanne eingenommen. "
	"Ein kleines Waschbecken befindet sich an der Westwand. Darueber "
	"wurde ein kleines Kaestchen befestigt. Weiters erkennst Du noch "
	"ein schmales Regal. Mehr siehst Du auf den ersten Blick nicht.");       
 	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang--------------------------------------------------------

   AddDetail( ({"raum","raumes","bad","badezimmer","blick"}), 
		   QueryProp(P_INT_LONG) );

  
  
  AddDetail( ({"becher"}),
	    "Zwei bunte Zahnbuersten und eine Tube Zahnpasta stecken in dem "
	    "Becher drin.");

  AddDetail( ({"boden"}), 
            "Der ganze Boden besteht aus schoenem, weissen Marmor. Ein "
	    "kleines Waschbaerenfell liegt vor der Badewanne.");
             

  AddDetail( ({"marmor","decke"}), 
            "Der ganze Raum besteht aus Marmor. Der Boden, die Waende und auch "
	    "die Decke wurde damit vertaefelt.");
            
	 
  AddDetail( ({"fell","waschbaerenfell","baerenfell"}),
	    "Wenn man aus der Wanne klettert, ist es angenehm, nicht auf den "
	    "kalten Boden treten zu muessen. Darum wurde ein Baerenfell davor "
	    "gelegt.");

  AddDetail( ({"wege","schnee","eis"}),
	    "Viele Wege durch Schnee und Eis fuehrten Dich hierher.");

  
  AddDetail( ({"birkenholz","holz"}),
	    "Das Birkenholz ist ein ganz helles Holz.");

  AddDetail( ({"stoppel"}),
	    "Der Stoppel ist dafuer da, um das Duschgel zu schliessen.");

  AddDetail( ({"himmel"}),
	    "Geniess ein Bad und fuehl Dich wie im 7. Himmel.");

  AddDetail( ({"waende","wand"}),
	    "Davon gibt es hier vier.");

  AddDetail( ({"suedwand","tuer"}),
	    "Eine Tuer fuehrt durch die Suedwand nach draussen.");
       

  AddDetail( ({"badewanne","wanne","nordwand"}),
	    "Ein Schwamm und einige kleine Flaschen stehen am Badewannenrand. "
	    "Ansonsten ist die Badewanne auch nicht weiter aufregend, bis auf "
	    "das, dass sie wirklich peinlich sauber ist.");
	    	  
  
  AddDetail( ({"schwamm"}),
	    "Damit kann man sich den Dreck vom Koerper schrubben.");
	 
  AddDetail( ({"dreck","koerper"}),
	    "Bist Du auch schmutzig? Oder hast Du einfach nur schmutzige "
	    "Gedanken? Oder bist Du durch und durch rein?");
	  

  AddDetail( ({"gedanken","gedanke"}),
	    "Deine Gedanken gehoeren Dir allein.");

  AddDetail( ({"moment"}),
	    "Es ist klug, schoene Momente zu geniessen.");
          

  AddDetail( ({"badewannenrand"}),
	    "Ein Schwamm und einige Flaschen befinden sich am Badewannenrand.");

  AddDetail( ({"flaschen"}),
	    "Eine Flasche mit Shampoo und zwei Flaschen mit Duschgel.");
  
 
  AddDetail( ({"flasche","shampoo","violette flasche","violette","shampoos"}),
	    "Eine grosse, violette Flasche mit Shampoo. Ein kleines "
	    "Etikett befindet sich darauf.");

  AddDetail( ({"etikett"}),
	    "Da steht: Hergestellt aus Rosen, Waldbeeren und Orchideen von "
	    "den Elfen aus Elessar.");
  
  AddDetail( ({"rosen","waldbeeren","orchideen","inhaltsstoffe"}),
	    "Rosen, Waldbeeren und Orchideen sind die Inhaltsstoffe des "
	    "Shampoos.");
            

  AddDetail( ({"elfen","elessar"}),
	    "Die Elfen legen sehr viel Wert auf Hygiene. ");

  AddDetail( ({"wert","hygiene"}),
	    "Du solltest vielleicht auch etwas mehr Wert drauf legen.");

  AddDetail( ({"duschgel"}),
	    "Eine hellblaue Flasche mit Maennerduschgel und eine rosarote "
	    "Flasche mit Frauenduschgel.");

  AddDetail( ({"hellblaue flasche","maennerduschgel"}),
	    "Eine grosse hellblaue Flasche mit maennlich duftendem Duschgel.");
 
  AddDetail( ({"rosarote flasche","frauenduschgel"}),
	    "Eine schoene, rosarote Flasche mit Frauenduschgel. Riech mal dran.");

  AddDetail( ({"westwand"}),
	    "Ein kleines Waschbecken haengt an der Westwand. Darueber befindet "            "sich ein kleines Kaestchen.");

  AddSpecialDetail( "kaestchen", "d_kaestchen");

  AddDetail( ({"waschbecken"}),
	    "Ein kleiner Becher steht am Waschbecken.");
   
  AddDetail( ({"bad"}),
	    "Bade Dich doch, wenn Dir kalt ist!");

 
  AddDetail( ({"weihnachtsmann","weihnachtsmannes"}),
	    "Wenn er nicht hier ist, ist er woanders.");

  AddDetail( ({"guckloch","loch"}),
	    "Ein kleines Guckloch befindet sich in dem Kaestchen. Du "
	    "kannst ja mal durchs Guckloch gucken.");


  AddDetail( ({"zahnbuersten"}),
	    "Es sind zwei niegelnagelneue Zahnbuersten. Sie haben Dich nicht "
	    "weiter zu interessieren, da sie nicht Dir gehoeren.");

  AddDetail( ({"tube","zahnpasta","minzgeschmack","zahnpastatube"}),
	    "Zahnpasta mit Minzgeschmack. Es ist besser, Du laesst sie dort "
	    "wo sie ist, da sie ja nicht Dir gehoert.");

 
  AddDetail( ({"regal","holzregal"}),
	    "Ein kleines Holzregal, das mit vielen Handtuechern gefuellt ist, "
	    "steht an der Ostwand.");

 
  AddDetail( ({"handtuecher","handtuechern","handtuch"}),
	    "Flauschige, schneeweisse Handtuecher, in die man sich nach "
	    "einem heissen Bad so richtig hineinkuscheln kann.");

   AddDetail( ({"wohnzimmer"}),
	    "Du hast Dich getaeuscht, Du siehst hier doch nur die Kuechentuer.");

  AddDetail( ({"klecks","nasenspitze","nase"}),
	    "Huch! Du blickst in den Spiegel und begutachtest den grossen "
	    "Klecks auf Deiner Nasenspitze.");

 AddDetail( ({"putzmittel"}),
	    "So sehr Du auch herumstoeberst, Du findest hier kein einziges "
	    "Putzmittel.");

 AddDetail( ({"haare","haar"}),
	    "Deine Haare sind schon etwas straehnig. Kein Wunder so fett wie "
	    "die schon sind. Du solltest sie Dir mal wieder waschen.");

 AddDetail( ({"wunder"}),
	    "Du wunderst Dich? Sehr merkwuerdig. Es ist doch logisch, dass Du "
	    "fette Haare bekommst, wenn Du sie nie waeschst.");

 AddDetail( ({"ostwand","spiegel"}),
	    "Ein grosser Spiegel befindet sich auf der Ostwand. Blick doch "
	    "mal hinein. Neben ihm erkennst Du einen kleinen Haken.");

 AddDetail( ({"haken"}),
	    "Ein flauschiger Bademantel haengt an dem Haken.");

  AddDetail( ({"bademantel"}),
	    "Du bekommst so richtig Lust, Dich in den weichen Bademantel "
	    "zu kuscheln.");

  AddDetail( ({"lust"}),
	    "Du hast im Moment auch Lust Dich zu baden. Du bist sehr schmutzig "
	    "und verschwitzt von Deiner langen Wanderung.");

  AddDetail( ({"wanderung"}),
	    "Weite Wege durch Schnee und Eis hast Du zurueckgelegt, und so "
	    "ein heisses Bad waere schon sehr angenehm.");

  AddDetail( ({"scheppern","werkstatt","ohr"}),
	    "Ja! Dein Ohr vernimmt etwas.");

   AddDetail( ({"helfer","zwerge","wichtel","feen","haende","haenden"}),
	    "Zwerge, Wichtel und Feen gehoeren zu den Helfern des "
	    "Weihnachtsmannes. Sie eignen sich deshalb so gut dafuer, weil "
	    "sie kleine Haende haben, die einfach alles zusammenbauen koennen.");


   
  AddSmell(DEFAULT_SMELL, "Es riecht hier sehr stark nach Putzmittel und "
		  "den Dueften der Seifen.");
                        
 
  AddSmell( ({"putzmittel","geruch"}),
	   "Du kannst hier keine Putzmittel sehen. Aber es wird hier sehr "
	   "oft geputzt, denn der Geruch der Putzmittel haftet ueberall.");
  
  AddSmell( ({"duft","dueften","seifen","duefte"}),
	    "Eigentlich handelt es sich eher um den Duft der Duschgels.");

  AddSmell( ({"duschgels","duschgel"}),
	    "Jedes Duschgel duftet anders. Das Maennerduschgel ist irgendwie "
	    "herber als das Frauenduschgel.");

  AddSmell( ({"maennerduschgel"}),
	    "Das Maennerduschgel riecht maennlich, herb und einfach sehr "
	    "exotisch. Irgendwie erinnert es Dich an dasselbe, das Du "
	    "daheim hast.");

  AddSmell( ({"frauenduschgel","bluetenduft"}),
	    "Du oeffnest den Stoppel des Frauenduschgels und ein zarter "
	    "Bluetenduft durchstroemt Deine Nase.");

  AddSmell( ({"shampoo"}),
	    "Das Shampoo riecht irgendwie fruchtig und macht sicher "
	    "geschmeidige Haare.");


   AddSmell( ({"zahnpasta","zahnpaste"}),
	    "Du oeffnest die Zahnpastatube und riechst daran. Ohhh, jetzt hast "
	    "Du einen Klecks auf Deiner Nasenspitze.");
	  
  
  AddSound(DEFAULT_SOUND, "Hier ist es eigentlich sehr ruhig. Lediglich "
		  "das Scheppern der Werkstatt dringt leise an Dein Ohr.");

  AddSound( ({"scheppern","werkstatt"}),
	"Die fleissigen Helfer des Weihnachtsmannes arbeiten unentwegt.");

     
  

//-----Details Ende----------------------------------------------------------
  
//_________Kommandos_________________________________________________________

  
 AddExit("sueden", ROOM "vorraum.lpc");
 AddCmd( ({ "bade", "bad" }), "c_baden");
 AddCmd( ({ "wasche", "wasch" }), "c_waschen");
 AddCmd( ({ "nimm", "nimm" }), "c_nehmen");
 AddCmd( ({ "blick", "blicke" }), "c_blicken");
 AddCmd( ({ "kuschle", "kuschel" }), "c_kuscheln");
 AddCmd( ({ "oeffne", "oeffen" }), "c_oeffnen");
 AddCmd( ({ "gucke", "guck" }), "c_gucken");


 grundzustand();
}

reset()

{
   ::reset();
   grundzustand();
}

void grundzustand()
{
	bademantel_da = 1;
	kaestchen_offen = 0;
    tell_room(TO, "Das Kaestchen schliesst sich knarrend.\n");
}


int c_nehmen(string str)
{
   notify_fail(BS("Was moechtest Du hier nehmen?"));
   if(!((str == "mantel von haken") || (str == "bademantel von haken")))
   {
     return 0;
   }
   if(present("bademantel", ENV(TP)) || (!bademantel_da))
   {
     write(BS("Du willst den Bademantel vom Haken nehmen, aber haeltst dann "
	      "doch kurz inne. Du brauchst so einen Mantel eigentlich nicht."));
	   

     return -1;
    }
    else
    {
      write(BS("Du nimmst den Bademantel vom Haken und freust Dich auf "
	       "einen schoenen, gemuetlichen Abend daheim."));
      tell_room(ENV(TP), TPN+" klaut einen Bademantel.\n", ({TP}));
      bademantel_da = 0;
      CLONE ( ARMOUR "bmantel.lpc", TP);
      return 1;
 
  }
 } 
  
    int c_baden(string str)
{
   notify_fail(BS("Wen moechtest Du baden?"));
   if(!((str == "mich") || (str == "micht selbst")))
   {
     return 0;
   }
   write(BS("Du laesst heisses Wasser in die Wanne laufen. Waehrenddessen "
	    "ziehst Du Dich aus und legst Deine Kleider sauber auf das "
	    "Waschbecken. Langsam kletterst Du nun in die Wanne und beginnst "
	    "Deinen Koerper mit dem Duschgel einzuseifen. Hmmmmmm.. das ist "
	    "fein! Du lehnst Dich etwas zurueck und geniesst das heisse Bad. "
	    "Anschliessend duschst Du Dir die Seife vom Koerper, trocknest "
	    "Dich mit einem flauschigen Handtuch ab und ziehst Dich sauber "
	    "und zufrieden wieder an."));
	  	  
   tell_room(ENV(TP), TPN+" zieht sich splitternackt aus und nimmt ein Bad.\n", ({TP}));
   
   return 1;
  }
 
           int c_waschen(string str)
{
   notify_fail(BS("Was moechtest Du Dir waschen?"));
   if(!((str == "die haare") || (str == "mir die haare") || (str == "mir haare")))
   {
     return 0;
   }
   write(BS("Du beugst Dich ueber das Waschbecken und nimmst etwas von dem "
	    "Shampoo. Sorgfaeltig waescht Du Dir die Haare. Anschliessend "
	    "rubbelst Du sie mit einem Handtuch trocken. Wow. Wie seidig glatt "
	    "und duftend sie jetzt sind."));
	  	  
   tell_room(ENV(TP), TPN+ "waescht sich die Haare.\n", ({TP}));
   
   return 1;
  }
 
           int c_blicken(string str)
{
   notify_fail(BS("Wo rein moechtest Du gerne blicken?"));
   if(!((str == "in spiegel") || (str == "in spiegel hinein")))
   
   {
     return 0;
   }
   write(BS("Du schaust in den Spiegel und findest Dich hinreissend."));
	  	  
   tell_room(ENV(TP), TPN+" begutachtet sich im Spiegel.\n", ({TP}));
   
   return 1;
  }
 
           int c_kuscheln(string str)
{
   notify_fail(BS("Wo rein magst Du Dich denn kuscheln?"));
   if(!((str == "mich in mantel") || (str == "mich in bademantel") ||
		(str == "in mantel") || (str == "in bademantel")))
   {
     return 0;
   }
   write(BS("Sich in einen flauschigen Bademantel zu kuscheln ist schon fein."));
	  	  
   tell_room(ENV(TP), TPN+" denkt . o O (Kuschel mich!).\n", ({TP}));
   
   return 1;
  }
 
  int c_oeffnen(string str)
{
    notify_fail(BS("Was moechtest Du hier denn oeffnen?"));
   if(!((str == "kaestchen") || (str == "kasterl")))
   {
     return 0;
   }
   if(kaestchen_offen) 
   {	   
   write("Aber das Kaestchen ist doch schon offen.\n");
    return -1;
   }
   else
   {
     write(BS("Du oeffnest das Kaestchen und entdeckst ein kleines Guckloch. "
	      "Ansonsten scheint das Kaestchen leer zu sein."));
      tell_room(ENV(TP), TPN+" oeffnet das Kaestchen.\n", ({TP}));
      kaestchen_offen = 1;
      return 1;

     }
}

   int c_gucken(string str)
{
   notify_fail(BS("Wodurch moechtest Du denn hier gucken?"));
   if(!(str == "durch guckloch"))
   {
     return 0;
      
   }

   if(kaestchen_offen) 
   {	   
 
  
   write(BS("Du guckst ganz neugierig in das Guckloch. Ploetzlich schiesst ein "
	    "Lichtstrahl aus dem Loch und laesst Dich schrumpfen. Du "
	    "verlierst die Besinnung. Als Du wieder zu Dir kommst, findest "
	    "Du Dich an einem anderen Ort wieder."));
              TP->move(ROOM "glasraum.lpc", M_GO);
     return 1;
    }
    else
    {
      write(BS("Du versuchst durch das Guckloch zu gucken, aber die Tuer "
	       "des Kaestchens ist zu. Mit voller Wucht schlaegst Du gegen "
	       "das Kaestchen und tust Dir dabei sehr leicht weh."));
      tell_room(ENV(TP), TPN+" schlaegt " + TP->QPP(MALE,WEN) + " Kopf "          "gegen das Kaestchen.\n", ({TP}));
      TP->AddHp(-20); 
       return 1;
      

    }
 
   }

  string d_kaestchen(string str)
  {
   string s;
   
   if(kaestchen_offen)
   {
    s = "Das Kaestchen besteht aus massivem Birkenholz. Es ist geoeffnet.";
   }
   else
   {
    s = "Das Kaestchen besteht aus massivem Birkenholz. Es ist geschlossen.";
   }
   return BS(s);
   } 
