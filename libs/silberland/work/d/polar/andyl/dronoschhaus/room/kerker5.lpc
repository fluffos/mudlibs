#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int lebenswasser=4;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_NAME, "Eine tueckische Pfeilfalle");
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_ARCTIC]));
  SetProp (P_INT_SHORT, "In einem Gang");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du befindest Dich hier in einer kleinen Kammer. "
                       +"Diese Kammer unterscheidet sich stark von "
                       +"den vorhergehenden Raeumen. Die Waende, die Decke "
                       +"und der Boden sind saubere Steinmetzarbeit und in "
                       +"in die Nordwand ist sogar ein wunderschoen "
                       +"verziertes Wasserbecken eingelassen. Drei Gaenge " 
                       +"fuehren von hier weiter. Einer nach Westen, einer "
                       +"nach Suedwesten und einer nach Nordwesten.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START
  AddDetail(({"raeume", "bauten"}),
           "Die restlichen Raeume dieses Kerkerkomplexes sind alle "
           +"zusammen ziemlich haessliche Bauten, aber diese Kammer "
           +"ist echt schoen.\n");
  AddDetail(({"gaenge", "gang"}),
           "Von hier fuehren drei Gaenge weiter. Welchen davon willst Du "
           +"genauer untersuchen, den nordoestlichen, den suedoestlichen "
           +"oder den westlichen Gang?\n");
  AddDetail(({"gang im westen", "westlichen gang"}),
           "Der Gang ist wieder genauso haesslich wie der Rest des "
           +"Kerkerkomplexes. Auch glaubst du von dort Stimmen zu "
           +"vernehmen.\n");
  AddDetail(({"gang im nordosten", "nordoestlichen gang"}),
           "Du kannst nichts besonderes an dem nordoestlichen Gang "
           +"entdecken.\n");
  AddDetail(({"gang im suedosten", "suedoestlichen gang"}),
           "Dir fallen kreisfoermige Platten am Boden des suedoestlichen "
           +"Ganges auf.\n");
  AddDetail(({"nordwand"}),
           "In die Nordwand ist ein grosses Wasserbecken eingelassen "
           +"worden.\n");
  AddDetail(({"becken", "wasserbecken"}),
           "Das Wasserbecken ist schoen mit Mustern verziert und "
           +"das Abbild einer Frau ist am oberen Rand des Beckens "
           +"eingemeiselt. Ein gut riechendes Wasser befindet sich "
           +"in dem Becken.\n");
  AddDetail(("muster"),
           "Es sind einfache, aber dennoch sehr schoene Muster.\n");
  AddDetail(("rand"),
           "Am oberen Rand des Wasserbeckens ist das Abbild einer Frau "
           +"in den Stein gemeiselt worden.\n");
  AddDetail(({"abbild", "frau", "darstellung", "schluss"}),
           "Als Du das Abbild der Frau naeher untersucht hast, kommst "
           +"Du zu dem Schluss, dass es sich dabei um eine Darstellung "
           +"der Goettin Altrane handeln muss. Ob diese Kammer wohl ein "
           +"Heiligtum von ihr ist?\n");  
  AddDetail(("heiligtum"),
           "Vermutlich ist diese Kammer ein Heiligtum der Goettin Altrane.\n");
  AddDetail(({"altrane", "goettin", "kuenste", "schutzgoettin"}),
           "Altrane ist die Goettin der Kuenste und auch die "
           +"Schutzgoettin der Bardengilde.\n");
  AddDetail(("bardengilde"),
           "Die Bardengilde solltest Du mittleweile ja schon kennen, "
           +TPN+".\n");
  AddDetail(({"platten", "druckplatten"}),
           "Es scheint sich dabei um Druckplatten zu handeln. Direkt "
           +"ueber den Platten entdeckst du Loecher in der Wand.\n");
  AddDetail(({"loch", "loecher"}),
           "In den Loechern entdeckst Du ein metallisches Glitzern.\n");
  AddDetail(({"glitzern", "spitzen", "metallspitzen"}),
           "Das metallische Glitzern stammt ja von Pfeilspitzen! Das ist "
           +"ganz sicher eine Falle!\n");
  AddDetail(("falle"),
           "In die Falle willst Du ja wohl nicht tappen, oder?\n");
  AddDetail(("stimmen"),
           "Du kannst ihnen ja mal lauschen.\n");
  AddDetail(("decke"),
           "Wie auch die Waende und der Boden besteht die Decke aus einem "
           +"hellen Gestein. Schoen Ornamente sind in sie eingemeisselt.\n");
  AddDetail(("ornament"),
           "Sieht aus wie ein typisch elfisches Ornament. Obwohl sie mit "
           +"grosser Wahrscheinlichkeit von Zwergen in den Stein gemeiselt "
           +"worden sind. Alles in allem ist das ziemlich ungewoehnlich.\n");
  AddDetail(({"wahrscheinlichkeit", "prozent", "detail"}),
           "Die Wahrscheinlichkeit das du gerade ein unnoetiges Detail " 
           +"untersucht hast betraegt 100 Prozent.\n");
  AddDetail(({"waende", "wand"}),
           "Die Waende sind aus einem hellen Gestein und extrem glatt. "
           +"In die Nordwand ist zudem ein reichlich verziertes Wasserbecken "
           +"eingelassen worden.\n");
  AddDetail(({"gestein", "stein"}),
           "Ein helles Gestein welches dem Raum einen sehr freundlichen "
           +"Eindruck verleiht.\n");
  AddDetail(({"boden"}),
           "Der Boden ist glatt und aus einem hellen Gestein. "
           +"Interessanterweise ist hier auch kein Schmutz zu entdecken.\n");
  AddDetail(({"schmutz", "koernchen", "staubkoernchen", "staub"}),
           "Nicht mal ein Staubkoernchen ist am Boden zu entdecken. Hoechst "
           +"seltsam.\n");
  AddDetail(("eindruck"),
           "Das helle Gestein verleiht der Kammer einen ueberaus freundlichen "
           +"Eindruck.\n");
  AddDetail(({"kammer", "raum"}),
           "Diese Kammer ist sehr schoen gearbeitet, eine echt tolle "
           +"Steinmetzarbeit. Vermutlich ist sie sehr alt und der ganze "
           +"Kerkerkomplex ist um sie herumgebaut.\n");
  AddDetail(({"kerkerkomplex", "komplex"}),
           "Den haesslichen Kerkerkomplex den man um diese Kammer gebaut hat, "
           +"haette man sich von Dir aus durchaus sparen koennen.\n");
  AddDetail(({"steinmetzarbeit", "steinmetzarbeiten", "herkunft"}),
           "Solch feine Steinmetzarbeit ist fuer gewoehnlich immer "
           +"zwergischer Herkunft.\n");
  AddDetail(({"zwerg", "zwerge", "meister", "steinmetzkunst"}),
           "Zwerge sind wahre Meister der Steinmetzkunst.\n");
  AddDetail(({"nase", "ding", "mitte", "gesicht"}),
           "Die Nase ist das Ding in der Mitte deines Gesichtes.\n");
  AddDetail(({"richtung", "richtungen", "himmelsrichtungen", "hinrichtungen", "ausrichtungen", "einrichtungen"}),
           "Och, Richtungen gibt es viele: Himmelsrichtungen, Ausrichtungen, "
           +"Einrichtungen, Hinrichtungen und so weiter.\n");
  AddSpecialDetail(("wasser"), "wasser_schau");
  AddSound(({DEFAULT_SOUND}),
	   "Du hoerst Stimmen aus westlicher Richtung.\n");
  AddSound(("stimmen"),
           "Du kannst nicht verstehen was sie sagen, aber da ist "
           +"definitiv irgendjemand.\n");
  AddSmell( ({DEFAULT_SMELL, "becken"}),
	    "Aus dem Becken dringt ein belebender Duft an deine Nase.\n");
  AddSmell(({"duft", "geruch"}),
            "Riecht angenehm belebend. Dieser Geruch ist ja beinahe "
            +"schon heilend.\n");
  // DETAILS ENDE
  
  // EXITS START

  AddExit(("westen"), ROOM"kerker6");
  AddExit(("nordosten"), ROOM"kerker4");   
  AddSpecialExit(("suedosten"), "inderfalle");

  // EXITS END
  
  // COMMANDS START

  AddCmd(({"trink", "trinke"}), "trinke_was");

  // COMMANDS END

  // ITEMS START
  // ITEMS END
}

trinke_was(str)
{
  notify_fail(BS("Was willst Du trinken?\n"));
  if (!str) return 0;
  if ((str == "wasser" || str == "wasser aus becken" ||
       str == "wasser aus wasserbecken"))
        {
          if ((lebenswasser > 0))
            { 
               write(BS("Du trinkst etwas von dem belebenden Wasser und "
                        +"fuehlst Dich sogleich gestaerkt.\n"));
               TP->heal_self(100);
               --lebenswasser;
               return 1;
             }
          else
             {
               write(BS("Es ist leider nicht mehr genug von dem "
                        +"Wasser da.\n"));
               return 1;
             }
       }
   else return 0;
}

wasser_schau()
{
  switch(lebenswasser)
    {
      case 0:
        return(BS("Es ist praktsich nichts mehr von dem belebendem "
                  +"Wasser da.\n"));
        break;
      case 1:
        return(BS("Ein wenig ist noch von dem belebenden Wasser da.\n"));
        break;
      case 2:
        return(BS("Das Becken ist zu knapp einem Drittel mit dem "
                  +"belebenden Wasser gefuellt.\n"));
        break;
      case 3:
        return(BS("Das Becken ist in etwa zu zwei Drittel mit dem "
                  +"belebenden Wasser gefuellt.\n")); 
        break;
      case 4:
        return(BS("Das Becken ist randvoll mit dem Wasser. Es riecht "
                  +"ueberaus belebend. Vielleicht kann man es ja trinken?\n"));
        break;
      default:
        return(BS("Hier stimmt was nicht! Bitte Andyl verstaendigen."));
        break;
    }
  return(BS("Hier stimmt was nicht! Bitte Andyl verstaendigen."));
}


int inderfalle() 
{
  write(BS("Du gehst in den suedwestlichen Gang als Du ein leises "
           +"\*Klick\* unter Dir hoerst und von allen Seiten Pfeile "
           +"auf Dich hereinprasseln und Dir schmerzende Wunden zufuegen.\n"));
  TP->do_damage(50+(random(40)));
  return 1;
}


void reset()
{
  ::reset();
  lebenswasser=4;
}
