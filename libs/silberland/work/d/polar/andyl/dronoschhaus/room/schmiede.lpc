#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";


void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_ARCTIC]));
  SetProp (P_INT_SHORT, "Im Laden des Zwergenschmieds Dronosch");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du befindest Dich hier im Laden des Zwergenschmieds "
	   +"Dronosch. Der Raum ist so eingerichtet, wie es bei "
	   +"Zwergen oft ueblich ist. Die Waende bestehen aus fein "
	   +"gearbeiteten Felsbloecken. Solide Saeulen aus robustem Holz."
	   +"stuetzen die Decke. In die Westwand ist ein Kamin eingelassen in "
	   +"dem ein Feuer vor sich hinlodert. Weiters siehst Du noch eine "
	   +"Ladentheke an der eine kleine Tafel befestig ist, "
	   +"ein Regal voll mit kunstvoll gearbeiteten Aexten und "
	   +"einen maechtige Amboss samt Kohlebecken in der Mitte des Raumes. "
	   +"Durch eine dicke Holztuer im Osten kommst Du wieder nach draussen.\n");
  
  // ROOM DESCRIPTION END;
  
  // DETAILS START

  AddDetail(({"ladentheke", "form"}),
            "Die Ladentheke besteht aus Holz und hat eine schlichte, "
            +"aber zweckmaessige Form. Eine kleine Tafel ist an ihr angebracht.\n");
  AddDetail(("tafel"),
            "Du kannst sie lesen.\n");
  AddDetail(({"laden", "schmiede", "raum"}),
            "Du befindest Dich hier im Laden des Zwergenschmiedes Dronosch, "
            +"welcher auch gleichzeitig die Schmiede sein duerfte.\n");

  AddReadDetail(("tafel"),
		"+--------------------------------+\n"
		+"| Dronosch Laden                 |\n"
		+"|                                |\n"
		+"| Um hier eine Waffe reparieren  |\n"
		+"| zu lassen tippe:               |\n"  
		+"| reperatur <Waffe>              |\n"
		+"|                                |\n"
		+"+--------------------------------+\n");
  AddDetail(("regal"),
            "In dem Regal stehen ein paar ausgesprochen kunstvoll gearbeitete "
            +"Aexte. Wohl ein paar der Werke von Dronoschs Meisterhand.\n");
  AddDetail(({"becken", "kohlebecken"}),
            "Im Kohlebecken gluehen noch die Kohlen vor sich hin. Pass auf, sonst "
            +"verbrennst Du Dich vielleicht daran.\n");
  AddDetail(({"kohle", "kohlen"}),
            "Die Kohle glueht von dunkelrot bis hellweiss.\n");
  AddDetail(({"abzug", "rauch", "schmieden"}),
            "Durch den Abzug kann der Rauch der beim Schmieden entsteht entweichen.\n");
  AddDetail(("amboss"),
            "Auf diesem Amboss duerften wohl die Werke von Dronosch entstehen.\n"); 
  AddDetail(({"meisterhand", "hand", "meister", "fach"}),
            "Dronosch muss wahrlich ein Meister seines Fachs sein, wenn er solche "
            +"Aexte schmieden kann.\n");
  AddDetail(({"aexte", "werke"}),
            "Die Aexte sind peinlichst genau geschmiedet, kunstvoll verziert und "
            +"sorgfaeltig gepflegt. Dronosch muss wahrlich ein Meister seines "
            +"Fachs sein.\n");
  AddDetail(({"holzsaeulen", "saeulen"}),
            "Es sind solide schmucklose Holzsaeulen, welche die Decke stuetzen.\n");
  AddDetail(({"westwand", "kamin", "feuer"}),
            "In die Westwand wurde ein Kamin eingelassen in dem jetzt ein "
            +"waermendes Feuer vor sich hinlodert.\n");
  AddDetail(("holz"),
            "Ein dunkles, sehr robust wirkendes Holz.\n");            
  AddDetail(({"decke", "balken", "holzbalken"}),
	    "Die Decke besteht aus soliden Holzbalken. Ein metallener Abzug ist ueber dem "
            +"Kohlebecken in sie eingelassen.\n");
  AddDetail(({"tuer", "holztuer"}),
            "Durch die schwere Holztuer kommst Du wieder zurueck nach draussen.\n");
  AddDetail(("boden"),
            "Der Boden besteht aus sauber verlegten Steinplatten. Fuer eine Schmiede ist "
            +"der Boden sogar ziemlich sauber.\n");
  AddDetail(("steinplatten"),
            "Die Steinplatten, welche als Boden verlegt wurden, sind gut gearbeitet und "
            +"sauber verlegt. Was soll man bei einem handwerklich begabten Zwerg auch anderes "
            +"erwarten?\n");
  AddDetail(({"zwerg", "zwerge"}), 
            "Dronosch ist zum Beispiel ein Zwerg.\n");
  AddDetail(("beispiel"),
            "Das muss ja wohl nicht extra beschreiben sein, oder?\n");
  AddDetail(("dronosch"),
            "So wie es aussieht scheint Dronosch gerade nicht da zu sein.\n");
  AddDetail(({"zwergenschmied", "schmied", "steinmetz", "steinmetze"}), 
            "Wie allgemein bekannt sind Zwerge ausgezeichnete Schmiede, aber auch hervorragende "
            +"Steinmetze.\n");
  AddDetail(({"wand", "waende"}),
            "Die Waende sind aus grossen, fein gearbeiteten Felsbloecken. Fackeln sind an ein paar "
            +"Halterungen montiert. An der Nordwand faellt Dir etwas auf.\n");
  AddDetail(({"felsbloecke", "bloecke"}),
            "Die Felsbloecke sind ziemlich gross. Muss ziemlich anstrengend gewessen sein diese "
            +"hierher zu schaffen.\n");
  AddDetail(("halterungen"),
            "In den Halterungen stecken Fackeln.\n");
  AddDetail(("fackeln"),
            "Die Fackeln leuchten den Raum aus, damit er nicht so duester ist und Dronosch bei "
            +"seiner Arbeit genuegend sieht.\n");
  AddDetail(("arbeit"),
            "Was ist wohl die Arbeit eines Schmieds?\n");
  AddDetail(("nordwand"),
            "Da ist ein dunkler Fleck zu sehen.\n");
  AddDetail(({"fleck", "blutfleck"}),
            "Es scheint sich dabei um einen Blutfleck zu handeln. Er duerfte nicht allzu "
            +"alt sein. Ob das ein Grund zur Beunruhigung ist?\n");
  AddDetail(({"grund", "beunruhigung"}),
	    "Der Blutfleck an der Nordwand ist sicher ein Grund beunruhigt zu sein.\n");
  AddDetail(("mitte"),
            "In der Mitte des Raumes steht ein maechtiger Amboss.\n");
  

  AddSound(({DEFAULT_SOUND}),
	   "Du hoerst das leise Knistern des Feuers im Kamin.\n");
  AddSound(("knistern"),
           "Das Knistern wird vom Feuer im Kamin verursacht.\n");        
  AddSmell( ({DEFAULT_SMELL, "geruch", "metall", "feuer"}),
	    "Es riecht hier nach Kohle, Feuer und Metall, wie es in einer "
            +"Schmiede eben zu erwarten ist.\n");
  // DETAILS ENDE
  
  // EXITS START
  AddExit(("osten"), ROOM+"palast3");
  
  // EXITS END
  
  
  // COMMANDS START
  
  AddCmd(({"reparatur", "repariere"}), "repariere_was"); 
   
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

repariere_was(str)
{
  notify_fail("Was willst Du reparieren lassen?\n");
  if (!str) return 0; 
  else
    {

// REPARATUR EINBAUN NICHT VERGESSEN!

      write(BS("Derzeit kann noch nichts repariert werden.\n"));
      return 0;
    }
}



void reset()
{
  ::reset();
}
