#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int nischeda=0;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:5, ENV_TERRAIN:TT_ARCTIC]));
  SetProp (P_INT_SHORT, "In einem dunklen Kerker");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du befindest Dich hier in einem weiteren Teil des "
                       +"kalten dunklen Kerkers. Die Waende sind hier "
                       +"blutverschmiert und es riecht nach Verwesung. "
                       +"Dich beschleicht ein ueberaus schlechtes "
                       +"Gefuehl.\n");
   // ROOM DESCRIPTION END;
  
  // DETAILS START
   
  AddDetail(("verwesung"),
           "Riech mal, das ist echt ekelhaft.\n");
  AddDetail(({"gefuehle", "gefuehl"}),
           "Hoere auf Deine Gefuehle, "+TP->name()+"!\n");
  AddDetail(({"wand", "waende", "steinwaende", "steinwand"}),
           "Die Waende bestehen aus grob behauenen Felsbloecken. Die "
           +"Waende sind ueber und ueber mit Blut bedeckt.\n");
  AddDetail(({"bloecke", "felsbloecke"}),
           "Grob behauene, dunkle grosse Felsbloecke.\n");
  AddDetail(("blut"),
           "Als Du das Blut an der Wand untersuchst faellt Dir eine "
           +"seltsame Verkrustung des Blutes auf.\n");
  AddSpecialDetail(("verkrustung"), "verkrustung_schau");
  AddSpecialDetail(("nische"), "nischeschau");
  AddDetail(({"raum", "teil"}),
            "Dieser Raum ist ein weiterer Teil diesen unangenehmen, kalten "
            +"und dunklen Kerkers.\n");
  AddDetail(("kerker"),
            "Du bist hier in einem dunklen und kalten Kerker gefangen. "
            +"Hoffentlich kommt Dir bald eine gute Idee wie Du hier wieder "
            +"rauskommst.\n");
  AddDetail(({"idee", "sinn"}),
            "Eine gute Idee will Dir derzeit nicht in den Sinn kommen. Aber "
            +"eines weisst Du ganz genau: Du musst hier unbedingt raus, "
            +"und zwar lebend!\n");
  AddDetail(("decke"),
            "Die Decke besteht aus einer schlampigen Konstruktion aus "
            +"Holzbrettern. Da sind ja selbst manche Arbeiten von Trollen "
            +"genauer.\n");
  AddDetail(({"bretter", "holzbretter"}),
            "Die Holzbretter sind grob gearbeitet und bestehen aus "
            +"einem dunklen alten Holz.\n");
  AddDetail(({"holz", "farbe"}),
            "Das Holz hat eine dunkle Farbe und scheint alt zu sein.\n");
  AddDetail(("konstruktion"),
            "Ein ueberaus schlampige Konstruktion aus Holzbrettern. "
            +"Eigentlich erstaunlich, dass es trotz allem nicht in "
            +"sich zusammenbricht.\n");
  AddDetail(({"troll", "trolle"}),
            "Ach du weisst schon: Die sind gross, plump, kraeftig und "
            +"ungeschickt.\n");  
  AddDetail(({"arbeiten", "arbeit"}),
            "Wenn eine Arbeit mal schlechter als die eines Trolls ist, "
            +"dann will das was heissen und zwar sicher nichts postives.\n");
  AddDetail(({"boden", "steinboden"}),
            "Ein rauher, harter dunkler Steinboden. Altes Stroh ist hier "
            +"und dort verstreut. Dazwischen sind auch immer wieder "
            +"Blutflecken zu sehen.\n");
  AddDetail(({"flecken", "blutflecken"}),
            "Den Blutflecken nach zu urteilen duerfte hier jemand "
            +"ziemlich gewuetet haben.\n");
  AddDetail(("stroh"),
            "Das alte Stroh duerfte wohl als Schlafunterlage fuer "
            +"Gefangene gedacht gewesen sein.\n");
  AddDetail(({"gefangene", "gefangener", "lebende"}),
            "Derzeit sind keine Gefangenen hier. Zumindest keine Lebenden.\n");
  AddDetail(({"schlafunterlage", "unterlage", "unterlagen", "schlafunterlagen"}), 
            "Also Du kannst Dir bei weitem bessere Schlafunterlagen als "
            +"dieses alte Stroh vorstellen.\n"); 
  AddSound(({DEFAULT_SOUND}),
	   "Es ist totenstill hier drinnen.\n");       
  AddSmell( ({DEFAULT_SMELL}),
	    "Es stinkt hier intensiv nach Verwesung.\n");
  AddSmell( ({"verwesung"}),
            "Riecht leicht suesslich und einfach widerlich.\n");
  // DETAILS ENDE
  
  // EXITS START

   // EXITS MIT TUEREN UND SCHLOSS UND SO NOCH EINBAUN...

  AddExit(("norden"), ROOM"kerker1");
  
  // EXITS END
  
  
  // COMMANDS START
  
  AddCmd(({"breche", "brich", "brech"}), "breche_was");
  AddCmd(({"greif", "greife"}), "greife_in");
 
  // COMMANDS END
  
  // ITEMS START

  // LEICHE UND TRUHE NICHT VERGESSEN.

  // ITEMS END
}

greife_in(str)
{
  notify_fail("In was willst Du greifen?\n");
  if (!str) return 0;
  if ((str == "in nische" || str == "in nische rein"))
    {
      if ((nischeda==0))
       {
         write("Sowas siehst Du da nicht!\n");
         return 1;
       }
      else
       {
           // HIER DAS REINGREIFEN IN DIE NISCHE EINBAUN
           // SCHLUESSEL UND SO
           write(BS("Sorry, Andyl war bisher zu faul das zu proggen.\n"));
           return 1;
       }
    }
  else return 0;
}

nische_schau()
{
   if((nischeda==0))
     {
       return("Sowas siehst Du da nicht!\n");
     }
   else
     {
       return("In der Nische scheint etwas zu sein. Vielleicht "
              +"kannst Du da ja mal reingreifen.\n");
     }
}

verkrustung_schau()
{
  if ((nischeda==0))
    {
      return("Hinter der blutigen Verkrustung scheint "
             +"irgendetwas zu sein. Vielleicht kann man sie "
             +"ja wegbrechen?\n");
    }
  else
    {
      return("Da wo vorher Die Verkrustung war ist jetzt eine "
             +"Nische zu sehen.\n");
    }
}

breche_was(str)
{
  notify_fail("Was willst Du wegbrechen?\n");
  if (!str) return 0;
  if ((str=="verkrustung weg" || str=="blut weg" ||
       str=="verkrustung" || str == "blut"))
    {
      if ((nischeda==1))
        {
          write(BS("Das hast Du doch schon gemacht und "
                   +"damit ein Nische frei gelegt.\n"));
          return 1;
        }
      else
        {
          write(BS("Du brichst Die Verkrustung weg und "
                   +"entdeckst dahinter eine Nische.\n"));
          nischeda=1;
          return 1;
        }
    }
  else return 0;
}

void reset()
{
  ::reset();
  nischeda=0;
}
