#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int eiszapfen=1;
int eisweg=0;
int exitda=0;


void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:0, ENV_TERRAIN:TT_ARCTIC]));
  SetProp (P_INT_SHORT, "In einer kalten Kammer");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du stehst hier in einer kleinen, ueberaus kuehlen Kammer. "
	   +"Am oberen Rand der Waende sowie an der Decke haengen "
	   +"Eiszapfen herab. Eine etwas wackelig aussehende Holztreppe fuehrt zu "
           +"einer Falltuer in der Decke. Etwas Licht scheint durch die Ritzen "
           +"in der Falltuer, sodass Du Dich ohne zusaetzliche Lichtquelle hier "
           +"umsehen kannst. Hier scheint man nun endlich nach draussen kommen zu "
           +"koennen. Aber noch ist es nicht geschafft, also ran ans Werk.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START
   
  AddDetail(({"boden", "steinboden"}),
           "Der Boden hier drinnen ist aus dunklen Steinplatten die allesamt "
	    +"eiskalt sind.\n");
  AddDetail(({"platten", "steinplatten", "platte", "steinplatte"}),
           "Die Steinplatten sind grob aus einem dunkeln Stein gehauen und sind "
	    +"alle mitsammen eiskalt.\n");
  AddDetail(("stein"),
	    "Dunkler, kalter Stein.\n");
  AddDetail(("freiheit"),
            "Die moechtest Du moeglichst bald wieder zurueckgewinnen, oder?\n");
  AddDetail(({"licht", "ritzen"}),
           "Durch die Ritzen in der Falltuer faellt genug Licht, sodass Du hier ohne "
	    +"zusaetzliche Lichtquelle etwas sehen kannst.\n");
  AddDetail(("werk"),
	    "Was Du heute kannst besorgen, das verschiebe nicht auf morgen! Also los "+TPN+"!\n");
  AddDetail(({"lichtquelle"}),
	    "Naja, Fackeln, Lampen und so. Solltest Du zur Gattung der grossen "
            +"Leuchten zaehlen nur folgendes: Du bist hier nicht als Lichtquelle anerkannt.\n"); 
  AddDetail(({"fackeln", "lampen"}),
            "Lampen und Fackeln koennen an dunklen Orten durchaus hilfreich sein\n");
  AddDetail(({"orte", "ort"}),
            "Da es an manchen Orten finster ist, mit einer Lichtquelle Du im Vorteil "
            +"bist.\n");
  AddDetail(({"vorteil", "nachteil"}),
            "Vorteile sind Dir in der Regel eh lieber als Nachteile.\n");
  AddDetail(({"ausnahmen", "regel"}),
            "Ausnahmen bestaetigen natuerlich die Regel.\n");
  AddDetail(({"leuchte", "leuchten", "gattung"}),
            "Alle die sich hier zur Gattung der grossen Leuchten zaehlen werden hier trotz "
            +"allem nicht als Lichtquelle anerkannt.\n");
  AddDetail(({"waende", "wand", "rand"}),
	    "Die Waende bestehen aus grossen dunklen Felsbloecken die grob behauen wurden. "
	    +"Am oberen Rand der Waende haengen, wie auch an der Decke einige Eiszapfen herab. "
	    +"Ansonsten faellt Dir nichts besonderes an den Waenden auf.\n");
  AddDetail(({"bloecke", "felsbloecke", "block", "felsblock"}),
	    "Die Felsbloecke sind grob behauen und ziemlich gross, ansonsten "
            +"aber uninteressant.\n");
  AddDetail(({"decke"}),
            "An der Decke haengen wie auch vom oberen Rand der Waende Eiszapfen herab. "
            +"In die Decke ist ausserdem eine Falltuere eingelassen.\n");
  AddDetail(({"treppe", "holztreppe"}),
            "Die Holztreppe ist ziemlich wackelig und fuehrt hinauf zu der Falltuere in der "
            +"Decke.\n");
  AddDetail(({"eiszapfen"}),
	    "Da sind grosse Eiszapfen, kleine Eiszapfen, dicke Eiszapfen und duenne Eiszapfen. "
	    +"Ein kleines Eiszaepfchen faellt Dir besonders auf.\n");

  AddSpecialDetail(({"zaepfchen", "eiszaepfchen"}), "zaepfchen_schau");
  AddSpecialDetail(({"falltuer", "falltuere"}), "falltuer_schau");

  AddDetail(({"raum", "kammer"}),
            "Dieser Raum ist ein kleine, kalte unscheinbare Kammer. Sie "
            +"scheint allerdings auch der Weg in die Freiheit zu sein.\n");
  AddDetail(({"raeume", "geruch"}),
            "In den Raeumen die Du vorher \"besucht\" hast herrschte ja ein "
            +"ueberaus strenger Geruch.\n");             
  AddDetail(("weg"),
            "Diese Kammer ist Dein Weg in die Freiheit. Nur solltest Du den Weg "
            +"halt eben noch finden.\n");  
  AddDetail(({"gegensatz", "oger", "troll", "stueck", "fleisch", "interessen"}),
	    "Gegensatz koennte man wie folgt definieren: "
	    +"Wenn ein Oger und ein Troll ein und das selbe Stueck "
	    +"Fleisch wollen befinden sich ihre Interessen in direktem "
	    +"Gegensatz.\n");
          
  AddSound(({DEFAULT_SOUND}),
	   "Du hoerst ueber Dir ein Sausen und Pfeifen.\n");
  AddSound(({"sausen", "pfeifen", "schneesturm", "sturm"}),
	   "Das Sausen und Pfeifen scheint von einem Schneesturm zu stammen.\n");
  AddSmell(({DEFAULT_SMELL}),
           "Riecht ziemlich neutral hier drinnen, im Gegensatz zu den vorherigen "
           +"Raeumen.\n");

  // DETAILS ENDE
  
  // EXITS START


  // BEI VERLASSEN DER ANLAGE BRICHT DIE TREPPE ZUSAMMEN UND AUCH DER DAZUGEHOERIGE RAUM.
  // AddExit(("oben"), "raushalt"));

  // EXITS END
  
  // COMMANDS START
  
  AddCmd(({"brich", "brech", "breche"}), "breche_was");  
  AddCmd(({"oeffne"}), "oeffne_was");
  AddCmd(({"hacke", "hack"}), "hacke_was");

  // COMMANDS END

  // ITEMS START

  // DA MUSS NE EISENTUERE HER

  // ITEMS END
}

hacke_was(str)
{
  notify_fail("Was willst Du womit herunterhacken?\n");
  if (!str) return 0;
  if ((str=="eis herunter" || str=="eis von tuere" ||
       str=="eis von falltuer" || str=="eis von falltuere" ||
       str=="eis von tuer" || str=="eis von tuer herunter" ||
       str=="eis von tuere herunter" || str=="eis von falltuer herunter" ||
       str=="eis von falltuere herunter"))
    {
      write(BS("So schaffst Du das nicht. Du wirst ein geeignetes "
               +"Hilfsmittel brauchen um das Eis herunter zu hacken.\n"));
      return 1;
    }
  // HIER NOCH EINBAUN VON DER EISPICKELAKTION
  // CHECKEN OB EISPICKEL DA UND SO WEITER
  write(BS("daweil gehts no einfach. zum testen halt."));
  eisweg=1;
  return 1;
}

falltuer_schau()
{
  
  // GSCHEIT BESCHREIBEN MIT EIS/OHNE EIS + OFFEN/ZU!!!!
  return(BS("Fuers erste mal uninteressant.\n"));
}



oeffne_was(str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if (!str) return 0;
  if ((str == "falltuer" || str == "falltuere"))
    {
      if ((eisweg==1))
        {
          if ((exitda==1))   
	    {
              write(BS("Die Falltuer ist doch schon offen.\n"));
	      return 1;  
	    }
	  else 
	    {
	      write(BS("Mit aller Gewalt stemmst Du Dich gegen die "
                       +"Falltuere und schaffst es schliesslich sie "
                       +"zu oeffnen und den Weg nach draussen damit "
                       +"freizulegen.\n"));
              
              // HIER NOCH EXIT HINZUFUEGEN UND TESTEN !!!
              // AddExit(("oben", "raushalt"));
              exitda=1;
              return 1;
            }  
        }
      else
        {
          write(BS("Du stemmst Dich mit all Deiner Kraft gegen die "
                   +"Falltuere schaffst es aber nicht sie zu oeffnen "
                   +"da sich viel zu viel Eis an der Falltuer festgefroren "
                   +"hat. Vielleicht solltest Du versuchen das Eis vorher "
                   +"irgendwie runterzuhacken.\n"));           
          return 1;
        }
    }
  else return 0;
}

zaepfchen_schau()
{
  if (eiszapfen==1)
    {
      return(BS("Ein kleines Eiszaepfchen das seltsam schimmert, Dich "
                +"juckt es in den Fingern es einfach abzubrechen."));
    }
  else 
    {
      return(BS("Ohh, das Eiszaepfchen hast Du ja gerade vorher abgebrochen."));
    }
}

breche_was(str)
{
  notify_fail("Was willst Du abbrechen?\n");
  if (!str) return 0;
  if ((str == "zaepfchen ab" || str == "eiszaepfchen ab" ||
       str == "zaepfchen" || str == "eiszaepfchen"))
    {
      if ((eiszapfen==1))
        {
           write(BS("Du brichst das Eiszaepfchen ab und auf einmal "
                    +"faellt Dir ein darueber im Eis engefrorener "
                    +"Eispickel in die Haende.\n"));
           
           // HIER EISPICKEL FUER DEN SPIELER CLONEN

           eiszapfen=0;
           return 1;     
        }
      else 
        {
           write(BS("Das Eiszaepfchen hast Du wie es aussieht schon "
                    +"abgebrochen.\n"));     
           return 1;
        }
    }
  else return 0;
}

void reset()
{
  ::reset();
  eiszapfen=1;
  eisweg=0;
  exitda=0;
}
