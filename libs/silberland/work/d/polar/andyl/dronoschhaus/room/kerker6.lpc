#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int geldda=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_ARCTIC]));
  SetProp (P_INT_SHORT, "In der Unterkunft der Wachen");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du befindest Dich hier in der Unterkunft der "
                       +"Wachen. Vier Betten stehen hier sowie zwei Tische "
                       +"und vier Sessel. Sehr ordentlich ist es hier ja "
                       +"nicht gearade. Ueberall liegen Essensreste, dreckige "
                       +"Kleidung und jede Menge Schmutz. Eine schwere "
                       +"Eisentuer befindet sich im Suedwesten des Raumes.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START
 
  AddDetail(("bewohner"),
           "Die Wachen sind die Bewohner dieser Unterkunft.\n");
  AddDetail(({"tische", "holztische", "tisch", "holztisch"}),
           "Die wackeligen Holztische sind ueber und ueber mit Essensresten "
           +"bedeckt.\n"); 
  AddDetail(({"raum","unterkunft"}),
           "Dieser Raum scheint die Unterkunft der Wachen zu sein.\n");
  AddDetail(({"betten", "holzbetten"}),
           "Schmutzige Leintuecher liegen auf den wackeligen Holzbetten "
           +"wobei Dir ein Leintuch besonders auffaellt.\n");
  AddDetail(({"leintuecher", "tuecher"}),
           "Die Leintuecher sind extremst schmutzig und mueffeln auch schon "
           +"ziemlich. Ein Leintuch faellt Dir besonders auf.\n");
  AddDetail(({"tuch", "leintuch"}),
           "Da scheint etwas darunter zu sein. Ob Du mal unter das Leintuch "
           +"greifen solltest?\n");
  AddDetail(({"sessel", "holzsessel"}),
           "Vier haessliche ziemlich wackelige Holzsessel. Auf der Lehne "
           +"eines Sessels ist etwas eingraviert.\n");
  AddDetail(("lehne"),
           "In die Lehne ist ein Spruch eingraviert.\n");
  AddDetail(("spruch"),
           "Du kannst ihn lesen.\n");
  AddReadDetail(("spruch"),
           "Nur ein toter Barde ist ein guter Barde. Nieder mit dem "
           +"Bardenpack!\n");
  AddDetail(({"wachen", "personen"}),
           "Wachen sind die Personen die Dich aus diesem Kerker nicht "
           +"rauslassen wollen. Ob man sie mit schlagfertigen "
           +"Argumenten nicht doch umstimmen kann?\n");
  AddDetail(({"schmutz", "menge", "mengen", "arzt", "zustaende", "grausen", "augen" }),
           "Schmutz gibt es hier in rauhen Mengen. Also ein Arzt wuerde "
           +"ob solcher hygienischen Zustaende wohl mit Grausen die Augen "
           +"abwenden.\n");
  AddDetail(({"argument", "argumente"}),
           "Je schlagfertiger deiner Argumente desto besser.\n");
  AddDetail(("kerker"),
           "Du glaubst bereits genug von dem Kerker gesehen zu haben. "
           +"Es wird Zeit hier zu verschwinden.\n");
  AddDetail(("zeit"),
           "Es ist definitiv Zeit von hier zu verschwinden.\n");  
  AddDetail(({"essensreste", "reste"}),
           "Es duerfte sich dabei hauptsaechlich um Bohnen gehandelt "
           +"haben.\n");
  AddDetail(({"kleidung", "kleidungsstuecke", "stuecke"}),
           "Die herumliegenden Kleidungsstuecke sind extrem schmutzig "
           +"und quer ueber den Raum verteilt. Von Ordnung scheinen "
           +"die Bewohner wohl nur geruechteweise etwas gehoert zu haben.\n");
  AddDetail(({"ordnung"}),
           "Man koennte wenn man sich den Raum betrachtet durchaus von "
           +"negativer oder invertierter Ordnung sprechen.\n"); 
  AddDetail(({"decke"}),
           "Die Decke besteht aus irrsinnig unsauber gezimmerten "
           +"Holzbrettern.\n");
  AddDetail(({"bretter", "holzbretter", "arbeit"}),
           "Die Holzbretter sind aussergewohnlich unsauber gezimmert. " 
           "Eine wirklich miese Arbeit.\n");
  AddDetail(("boden"),
           "Der Boden besteht aus grobem dunklem Fels. Uberall auf ihm "
           +"sind dreckige Kleidung, Essensreste, Schmutz und Flecken "
           +"zu sehen.\n");
  AddDetail(("flecken"),
           "Die Flecken scheinen von verschuetteten alkoholischen "
           +"Getraenken zu stammen.\n");
  AddDetail(({"getraenke", "alkoholische getraenke"}),
           "Alkoholische Getraenke scheinen bei den Wachen recht beliebt "
           +"zu sein.\n");
  AddDetail(("decke"),
           "Die Decke besteht aus wuest zusammengezimmerten Holzbrettern. "
           +"Eine schmutzige Oellampe haengt von ihr herab und spendet etwas "
           +"Licht.\n");
  AddDetail(("licht"),
           "Das Licht wird von der Oellampe abgestrahlt.\n");
  AddDetail(({"lampe", "oellampe"}),
           "Eine schmutzige alte Oellampe die den Raum etwas ausleuchtet.\n");
  AddDetail(({"bretter", "holzbretter"}),
           "Wuha, die hat ja jemand ziemlich abenteuerlich "
           +"zusammengezimmert.\n");
  AddDetail(("fels"),
           "Dunkler harter Fels.\n");
  AddDetail(({"wand", "waende"}),
           "Die Waende bestehen aus grossen, grob gehauenen Felsbloecken.\n");
  AddDetail(({"bloecke", "felsbloecke"}),
           "Grosse grob behauene Felsbloecke aus einem dunklen Fels.\n");
  

  AddDetail(({"bohnen", "umfeld"}), 
           "Wer zuviel Bohnen gegessen hat verbreitet in seinem Umfeld "
           +"allzuhaeufig ein seltsames Aroma.\n");
  AddDetail(({"aroma"}),
           "Riech einfach mal.\n");
  AddSound(({DEFAULT_SOUND}),
	   "Es ist ziemlich still hier drinnen.\n");
  AddSmell(({DEFAULT_SMELL}),
           "Es riecht hier drinnen nach Essen, Alkohol und dicker Luft.\n");
  AddSmell(({"tuecher", "leintuecher"}),
           "Huihh, das Aroma haut ja fast jeden um. *hust* *keuch*\n"); 
  AddSmell(({"luft", "dicke luft", "aroma", "geruch"}),
           "Puhhh, da duerfte wohl jemand zuviel Bohnen gegessen haben.\n");
  AddSmell(("essen"),     
           "Dem Geruch nach duerfte es sich bei dem Essen hauptsaechlich um "
           +"Bohnen gehandelt haben.\n");
  AddSmell(("alkohol"),
           "Der duerfte hier vermutlich in Stroemen geflossen sein und zwar "
           +"hauptsaechlich daneben.\n");
  AddDetail(("stroeme"),
           "Sehr viel halt.\n");
  // DETAILS ENDE
  
  // EXITS START


  AddExit(("osten"), ROOM"kerker5");
  AddExit(("suedwesten"), ROOM"kerker7");   

  // EXITS END
  
  // COMMANDS START

  AddCmd(({"greif", "greife"}), "greife_was");  

  // COMMANDS END

  // ITEMS START

  // HIER MUESSEN NOCH WACHEN / WACHCHEF HER
  // UND EINE EISENTUERE MIT 4 SCHLUESSELN oder so

  // ITEMS END
}

greife_was(str)
{
  int geldmenge;
  notify_fail("Unter was willst Du greifen?\n");
  if (!str) return 0;
  if ((str == "unter tuch" || str == "unter leintuch"))
    {
      if ((geldda==1))
        {
           geldmenge=500+(random(1000));
           write(BS("Du greifst unter das Leintuch und siehe da "
                    +"Du findest "+geldmenge+" Muenzen.\n"));
           TP->AddMoney(geldmenge);
           geldda=0;
           return 1;     
        }
      else 
        {
           write(BS("Ausser jede Menge Schmutz findest Du leider "
                    "nichts unter dem Leintuch.\n"));     
           return 1;
        }
    }
  else return 0;
}

void reset()
{
  ::reset();
  geldda=1;
}
