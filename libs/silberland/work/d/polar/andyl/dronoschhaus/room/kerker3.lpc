#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_NAME, "Eine heimtueckische Pfeilfalle");
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:8, ENV_TERRAIN:TT_ARCTIC]));
  SetProp (P_INT_SHORT, "In einem dunklen Kerker");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "An dieser Stelle gabelt sich der Kerker "
                       +"in zwei Gaenge. Einer fuehrt nach Norden und "
                       +"einer nach Suedwesten. Du hast eine "
                       +"duestere Vorahnung, dass hier in der Naehe "
                       +"noch etwas Ungutes auf dich wartet. Im "
                       +"Nordosten kommst Du wieder in die Zellen "
                       +"zurueck aus denen Du Dich vorhin befreit hast.\n");
   // ROOM DESCRIPTION END;
  
  // DETAILS START

  AddDetail(("gaenge"),
            "Zwei Gaenge fuehren von hier weg. Einer nach Norden und "
            +"einer nach Suedwesten. Welchen davon willst Du naeher "
            +"untersuchen?\n");
  AddDetail(({"gang"}),
            "Willst Du den noerdlichen oder den suedwestlichen Gang "
            +"untersuchen?\n");
  AddDetail(({"noerdlichen gang", "gang im norden"}),
            "Bis auf das aus dieser Richtung ein leises Gebrabbel "
            +"zu hoeren ist, kannst Du nichts Auffaelliges an dem "
            +"noerdlichen Gang entdecken.\n");
  AddDetail(("auffaelliges"),
            "Nichts Auffaelliges am noerdlichen Gang zu entdecken, "
            +"aber das kann taeuschen.\n");
  AddDetail(({"suedwestlichen gang", "gang im suedwesten"}),
            "Der suedwestliche Gang wirkt etwas seltsam, da "
            +"sind kreisfoermige Platten am Boden zu sehen.\n");
  AddDetail(({"platten", "druckplatten"}),
            "Hmmm, das scheinen Druckplatten zu sein. Ueber den "
            +"Platten in der Wand kannst Du bei genauerem Hinsehen "
            +"auch ein paar Loecher entdecken.\n");
  AddDetail(("loecher"),
            "In einem der Loecher entdeckst Du ein metallisches "
            +"Glitzern.\n");
  AddDetail(({"glitzern"}),
            "Das Glitzern duerfte von einer Pfeilspitze stammen.\n");
  AddDetail(({"pfeilspitze", "pfeil"}),
            "Wo Pfeilspitzen sind da sind auch Pfeile. Vermutlich "
            +"ist der suedwestliche Gang ein Falle.\n");
  AddDetail(("falle"),
            "In diese Falle willst Du ja nicht so einfach laufen, oder?\n"); 
  AddDetail(({"hinsehen", "abenteurer"}),
            "Man sollte als erfahrener Abenteurer immer alles genau "
            +"untersuchen. Koennte einem das Leben retten.\n");
  AddDetail(("leben"),
            "Du haengst Doch an deinem Leben, oder?\n");  
  AddDetail(({"boden"}),
            "Der Boden besteht aus kalten, dunklen Stein.\n");
  AddDetail(("stein"),
            "Der Stein ist kalt und dunkel.\n");
  AddDetail(({"wand", "waende"}),
            "Die Waende bestehen aus grob gehauenen Felsbloecken.\n");
  AddDetail(({"felsbloecke", "bloecke", "felsblock", "block"}),
            "Es sind grosse grob bearbeitete Felsbloecke ohne besondere "
            +"Merkmale.\n");
  AddDetail(({"merkmal", "merkmale"}),
            "Du kannst keine besonderen Merkmale an den Felsbloecken "
            +"entdecken. Du kannst selbst entscheiden ob das nun "
            +"gut oder schlecht ist.\n");
  AddDetail(({"decke"}),
            "Die Decke besteht aus unsauber gearbeiteten Holzbrettern.\n");
  AddDetail(({"bretter", "holzbretter"}),
            "Die Holzbretter sind unsauber gearbeitet. Da war wohl der "
            +"Tischler gerade extrem faul.\n");
  AddDetail(("tischler"),
            "So einen Tischler wuerdest Du sicher nie fuer dich arbeiten "
            +"lassen und dafuer bezahlen\(ohne zu bezahlen vielleicht\)\n");
  AddDetail(({"richtung", "richtungen"}),
            "Hier geht es in die Richtungen Suedwesten, Norden und "
            +"Nordosten.\n");
  AddDetail(({"vorahnung", "vorahnungen"}),
            "Dummerweise hast Du mit Deinen Vorahnungen immer allzuoft "
            +"recht. Vor allem dann wenn es duestere Vorahnungen sind.\n");
  AddDetail(("naehe"),
            "Nicht allzuweit entfernt. Typisch, immer wenn man wo lieber weit "
            "weg sein will, ist man ganz nah.\n");
  AddDetail(("stelle"),
            "An dieser Stelle gabelt sich der Kerker in zwei Gaenge.\n");
  AddDetail(("kerker"),
            "Du befindest Dich hier in einem kalten, unfreundlichem "
            +"Kerker.\nDu denkst . o 0 \(Warum muss immer ausgerechnet "
            +"ich in sowas hineingeraten?\).\n"); 
  AddDetail(("ungutes"),
            "Etwas Gutes waer Dir jetzt sicher viel lieber, oder?\n");
  AddDetail(("gutes"),
            "Etwas Gutes scheint Dir hier unten aber nicht passieren "
           +"zu wollen.\n");
  AddDetail(("zellen"),
            "Du spuerst kein allzu grosses Verlangen in die Zellen "
            +"zurueckzukehren aus denen Du gerade geflohen bist.\n");
  AddDetail(("verlangen"),
            "Das Verlangen in die Zellen zurueckzukehren haelt sich "
            +"echt in Grenzen.\n");
  AddDetail(({"grenzen", "grenze"}),
            "In ausgesprochen kleinen Grenzen.\n");
   
  AddSound(({DEFAULT_SOUND}),
	   "Du hoerst ein leises Gebrabbel aus noerdlicher Richtung.\n");       
  AddSound(({"gebrabbel"}),
           "Hoert sich an als waere da jemand.\n");
  AddSmell( ({DEFAULT_SMELL}),
	    "Es ist stickig hier und im Suedosten riecht es nach "
            +"Verwesung.\n");
  AddSmell( ({"verwesung", "geruch"}),
            "Waehh, kein sehr angenehmer Geruch.\n");
  // DETAILS ENDE
  
  // EXITS START

   // EXITS MIT TUEREN UND SCHLOSS UND SO NOCH EINBAUN...

  AddExit(("norden"), ROOM"kerker4");

  // SPIELER VERLIERT 50 HP WENN ER NACH SUEDWESTEN GEHT

  AddSpecialExit(("suedwesten"), "inderfalle");   

  // EXITS END
  
  // COMMANDS START
  
  // COMMANDS END
  
  // ITEMS START

  // ITEMS END
}

int inderfalle()
{
  write(BS("Du gehst in den suedwestlichen Gang als Du ein leises "
           +"\*Klick\* unter Dir hoerst und von allen Seiten Pfeile "
           +"auf Dich hereinprasseln und Dir schmerzende Wunden zufuegen.\n"));
  TP->do_damage(50+(random(40)));
  return 1;
}
 
void reset()
{
  ::reset();
}
