#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int fackel=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_ARCTIC]));
  SetProp (P_INT_SHORT, "In einem kleinen Wachraum");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du stehts hier in einem kleinen Wachraum. "
                       +"In der Mitte des Raumes steht ein kleiner "
                       +"Tisch und zwei Hocker. Auf dem Tisch flackert "
                       +"eine Kerze vor sich hin und an den Waenden "
                       +"stecken in steinernen Halterungen Fackeln. "
                       +"Ein starker Geruch dringt auch an Deine Nase.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START
  AddDetail(({"wachraum", "raum"}),
            "Dieser Raum duerfte ein Wachraum sein, in dem sich die "
            +"Wachen fuer gewoehnlich aufhalten.\n");
  AddDetail(({"wache", "wachen"}),
            "Es scheint gerade keine Wache hier zu sein.\n");
  AddDetail(({"mitte"}),
            "In der Mitte des Raumes steht ein Tisch und zwei Hocker.\n");     
  AddDetail(({"tisch", "holztisch"}),
            "Ein alter, wacklig aussehender Holztisch. Auf ihm steht eine "
            +"flackernde Kerze.\n");
  AddDetail(("hocker"),
            "Ein paar wacklige alte Hocker, die schon viel mitgemacht haben "
            +"wenn Du ihren Zustand so begutachtest.\n");
  AddDetail(("zustand"),
            "Abgenutzt, wackelig, schmutzig und haesslich.\n");
  AddDetail(({"kerze", "gaenze"}),
            "Die Kerze ist schon zur Gaenze heruntergebrannt. In das "
            +"Wachs hat irgendwer etwas hineingeschrieben.\n");
  AddDetail(({"wachs"}),
            "Ein paar Worte sind in das Wachs geschrieben worden.\n");
  AddDetail(({"woerter", "worte"}),
            "Du kannst sie lesen.\n");
  AddReadDetail(({"woerter", "worte"}),
            "Da steht: Stirb Artyrian, stirb!\n");
  AddDetail(("geruch"),
           "Riech mal.\n");
  AddDetail(("nase"),
           "Benutze sie mal anstatt sie schielenderweise zu bewundern.\n");
  AddDetail(({"halterungen", "halterung"}),
           "Schlichte steinerne Halterungen die in die Waende eingelassen "
           +"sind.\n");
  AddDetail(({"wand", "waende", "steinwand", "steinwaende"}),
           "Schlichte dunkle Steinwaende aus grossen Felsbloecken, in welche "
           +"steinerne Halterungen eingelassem wurden.\n");
  AddDetail(({"block", "felsblock", "bloecke", "felsbloecke"}),
           "Es war sicher sehr schwierg so grosse Felsbloecke hierher "
           +"zu schaffen und zu einer Wand zu verarbeiten.\n");
  AddSpecialDetail(({"fackel", "fackeln"}), "fackeln_schau");
  AddDetail(("decke"),
           "Die Decke besteht aus unsauber gearbeitetetn Holzbrettern.\n");
  AddDetail(({"holzbretter", "bretter"}),
           "Die Holzbretter sind extrem unsauber verarbeitet worden. "
           +"Da wuerde sich ja sogar ein Ork dafuer schaemen.\n");
  AddDetail(({"ork", "orks"}),
           "Orks sind zwar schlampig, aber sooo schlampig auch wieder "
           +"nicht.\n");
  AddDetail(({"boden", "steinboden"}),
           "Ein holpriger kalter dunkler Steinboden mit vielen Flecken "
           +"darauf.\n");
  AddDetail(("flecken"),
           "Da duerfte jemand reichlich Alkoholisches verschuettet haben.\n");
  AddDetail(({"alkoholisches"}),
           "Du weisst schon, Wein, Bier Schnaps und so.\n");
  AddDetail(({"schnaps", "bier", "wein", "feinde", "bibel"}),
           "Wie heisst es so schoen:\n"
           +"Schnaps, Bier, Wein sollen deine Feindes sein,\n"
           +"doch in der Bibel steht geschrieben man solle seine "
           +"Feinde lieben!\n");
  AddSound(({DEFAULT_SOUND}),
	   "Im Suedwesten vernimmst Du ein leises Plaetschern.\n");
  AddSound(("plaetschern"),
           "Es kommt aus suedwestlicher Richtung. Ob das wohl "
           +"interessant sein koennte?\n");       
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht hier ziemlich intensiv nach Alkohol.\n");
  AddSmell(("alkohol"),
            "Hier riecht es ziemlich intensiv nach Alkohol. Da duerfte "
            +"sich wohl irgendwer ziemlich bedient und dabei einiges "
            +"verschuettet haben.\n");
  // DETAILS ENDE
  
  // EXITS START


  AddExit(("sueden"), ROOM"kerker3");
  AddExit(("suedwesten"), ROOM"kerker5");   

  // EXITS END
  
  // COMMANDS START
  
  AddCmd(({"ziehe", "zieh"}), "ziehe_was");

  // COMMANDS END

  // ITEMS START

  // DA MUSS NOCH EIN BESOFFENER WACHMANN HER !!!

  // ITEMS END
}

ziehe_was(str)
{
  notify_fail(BS("Was willst Du wo herausziehen?\n"));
  if (!str) return 0;
  if ((str=="fackel heraus" || str =="fackel aus halterung" ||
       str=="fackel aus halterung heraus" || str=="fackel raus" || 
       str=="fackel aus halterung raus"))
    {  
       if (fackel==0)      
         {
            write(BS("Das hast Du doch schon gemacht!\n"));           
            return 1;
         }    
       else 
         {
            write(BS("Du ziehst die Fackel aus der Halterung "
                     +"und steckst sie ein.\n"));
            
           CLONE(("d/ebene//obj/div/teerfackel"), (TP));
           fackel=0;
           return 1;
         }
    }
}

fackeln_schau()
{
   if ((fackel==1))
     {
        return("Vier Fackeln stecken in Halterungen an den Waenden. "
               +"Eine Fackel scheint recht locker in der Halterung zu "
               +"stecken. Vielleicht kann man sie ja aus der Halterung "
               +"herausziehen?\n");
     }
   else
     {
        return("Es stecken drei Fackeln fest in ihren Halterungen.\n"); 
     }  
}


void reset()
{
  ::reset();
  fackel=1;
}
