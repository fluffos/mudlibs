#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int tuerzu=1;
int kettenzu=1;
int bolzengedreht=0;
int versuch=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:5, ENV_TERRAIN:TT_ARCTIC]));
  SetProp (P_INT_SHORT, "In einem dunklen Kerker");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du befindest Dich hier in einem dunklem, kalten Kerker. "
	   +"Der Raum ist recht klein und bedrohlich."
	   +"@@details@@");
   // ROOM DESCRIPTION END;
  
  // DETAILS START
 
  AddDetail(({"raum", "kerker"}),
            "Dieser Raum ist offenbar ein unbequemer, kalter kleiner Kerker "
            +"in welchem Du jetzt gefangen bist.\n");
  AddDetail(({"decke", "stueck"}),
	    "Die Decke ist ein gutes Stueck ueber Dir. Sie besteht aus unsauber "
            +"verarbeiteten Holzbrettern. Ein paar Ritzen in quadratischer Form "
            +"sind an ihr zu sehen.\n");
  AddDetail(({"form", "ritzen"}),
	    "Die Ritzen in quadratischer Form in der Decke lassen darauf schliessen, "
	    +"dass da oben vermutlich ein Falltuer ist.\n");
  AddDetail(({"falltuer"}),
	    "Die Falltuer ist anhand der Ritzen an der Decke zu erkennen. "
	    +"Ungluecklicherweise wirst Du durch sie wohl nicht nach draussen "
	    +"gelangen koennen.\n");
  AddDetail(({"bretter", "holzbretter"}),
	    "Die Holzbretter sind unsauber verarbeitet worden. Vermutlich sind sie "
	    +"in der Eile zugeschnitten und verbaut worden.\n");
  AddDetail(({"eile", "weile"}),
	    "Wie heisst es doch schon so schoen:\n"
	    +"Eile mit Weile!\n");
  AddDetail(({"boden", "steinboden"}),
	    "Ein kalter schmuckloser Steinboden.\n");
  AddDetail(({"wand", "waende"}),
	    "Die Waende sind aus unsauber gearbeiteten Steinbloecken.\n");
  AddDetail(({"steinbloecke", "bloecke"}),
	    "Die Steinbloecke sind unsauber gearbeitet als waere das "
	    +"alles in einer ziemlichen Eile gebaut worden. Ein Steinblock "
	    +"faellt Dir besonders auf.\n");
  AddDetail(({"steinblock", "block"}),
            "In dem Steinblock ist ein kleines Loch zu sehen.\n");
  AddDetail(({"loch"}),
	    "Da scheint etwas drinnen zu sein, vielleicht kann man "
	    +"da ja mal reingreifen.\n");
  AddSpecialDetail(({"ketten", "kette"}), "kette_schau");
  AddSpecialDetail(({"bolzen", "metallbolzen"}), "bolzen_schau"); 
  AddSound(({DEFAULT_SOUND}),
	   "Es ist totenstill hier drinnen.\n");       
  AddSmell( ({DEFAULT_SMELL}),
	    "Es ist extrem stickig hier deinnen und es stinkt nach Verwesung.\n");
  AddSmell( ({"verwesung", "geruch", "verwesungsgeruch"}),
            "Der Verwesungsgeruch scheint von Sueden zu kommen.\n");
  // DETAILS ENDE
  
  // EXITS START

   // EXIT MIT TUER UND SCHLOSS UND SO NOCH EINBAUN...

  //  AddSpecialExit(("sueden"), ROOM"palast3");
  
  // EXITS END
  
  
  // COMMANDS START
  
  AddCmd(({"oeffne"}), "oeffne_was"); 
  AddCmd(({"greif", "greife"}), "greife_was");   
  AddCmd(({"zieh", "ziehe"}), "ziehe_was");
  AddCmd(({"dreh", "drehe", "verdreh", "verdrehe"}), "drehe_was");

  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

kette_schau()
{
  if ((kettenzu==1))
    {
      return(BS("Die Ketten sind schwer und rostig, aber ueberaus "
                +"stabil. Du bist mit ihnen an die Wand gekettet. "
                +"Ein kleiner Metallbolzen faellt Dir an der Kette "
                +"auf.\n"));
    }
  else
    {
      return(BS("Die Ketten haengen jetzt an der Wand herab. Du bist " 
                 +"ziemlich froh sie nicht mehr tragen zu muessen.\n"));
    }
}

bolzen_schau()
{
  if ((kettenzu==0))
    {
      return(BS("Der Bolzen wird wohl da an der Kette haengen.\n"));
    }
  if ((bolzengedreht==0))
    {
      return(BS("Der Bolzen haelt die Kette zusammen. Er scheint "
                +"jedoch etwas locker zu sein. Vielleicht kann man "
                +"den ja verdrehen?\n"));
    }
  if ((bolzengedreht==1))
    {
       return(BS("Der Metallolzen ist jetzt so verdreht, dass man versuchen "
                 +"koennte ihn herauszuzuiehen.\n"));
    }
}

drehe_was(str)
{
  notify_fail("Was willst Du drehen?\n");
  if (!str) return 0;
  if ((str == "bolzen" || str == "metallbolzen" ||
       str == "bolzen herum" || str == "metallbolzen herum"  ||
       str == "bolzen rum" || str == "metallbolzen rum"))
     {
       if ((kettenzu==0 || bolzengedreht==1))
         {
           write(BS("Das hast Du doch schon gemacht!\n"));
           return 1;
         }
       else
         {
           write(BS("Mit etwas Fingerspitzengefuehl schaffst Du es "
                    +"den Bolzen ein Stueck zu verdrehen.\n"));
           bolzengedreht=1;
           return 1;
         }
     }
  else return 0;   
}

ziehe_was(str)
{
  notify_fail(BS("Was willst Du herausziehen?\n"));
  if (!str) return 0;
  if (( str == "bolzen heraus" || str == "metallbolzen heraus" ||
        str == "bolzen" || str == "metallbolzen"))
    { 
      if ((kettenzu==0))
       {
         write(BS("Das hast Du doch bereits gemacht!\n"));
         return 1;
       }
      else
       {
         if((bolzengedreht==0))
           {
             write(BS("So wirst Du den Bolzen nicht "
                      +"herausziehen koenne.\n"));
             return 1;
           }
         else
           {
             if ((versuch < 6))
              {
               write(BS("Du rutscht leider ab und schaffst es "
                        +"nicht den Bolzen heraus zu ziehen. Aber nur "
                        +"nicht den Mut verlieren!\n"));            
               versuch++; 
               return 1;
              }
             else 
              { 
                write(BS("Endlich schaffst Du es den Bolzen heraus zu ziehen "
                         +"und kannst Dich somit von den Keten befreien.\n"));
                kettenzu=0;
              }
           }
       }
   }  
}

string details()
{

string detailstring;

detailstring=" ";

  if ((kettenzu==1))
    {	     
      detailstring+="Du bist mit mit einer dicken Kette an die Nordwand gekettet.";
    }
  else
    {
      detailstring+="Eine dicke Kette haengt an der Nordwand. ";
    }
  if ((tuerzu==1))
   {
       detailstring+=" Im Sueden befindet sich eine schwere geschlossene "
                +"Metalltuere.";
   }
  else
   {
      detailstring+=" Im Sueden befindet sich eine schwere geoeffnete "
            +"Metalltuere.";
   }
  return detailstring;
}


greife_was(str)
{
  notify_fail("In was willst Du greifen?\n");
  if (!str) return 0;
  else
    {
      if ((kettenzu==1))
        {
           write(BS("Du kommst nicht an das Loch heran, die "
		    +"Ketten die Dich binden sind zu kurz.\n"));
           return 1;
        }
      else
        {
          // HIER KRIEGT MAN DANN NEN DRAHT
	  write("Derzeit gibts hier no nix.\n");
	  return 1; 
        }
    }
  return 0;
}

oeffne_was(str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if (!str) return 0; 
  else
    {
      write(BS("Derzeit kannst Du noch nichts oeffnen.\n"));
      return 0;
    }
}


void reset()
{
  ::reset();
  versuch=1;
  tuerzu=1;
  kettenzu=1;
  bolzengedreht=0;
}
