inherit "/p/service/iwo/access/ac_client_fun.lpc";

varargs int access_rights(string name, string file, int readflag, int def, string fun)
{
  //Yara Zugriff auf Haustierverzeichnis
  if (name=="yara" && file[0..9]=="tierladen/")
    return 1;

  //Lesezugriff regeln, Lilyth, Delgo und Dinin duerfen lesen
  if (readflag)
  {
    if (name=="lilyth" || name=="delgo" || name=="dinin")
      return 1;
  }
  // Rest wie gehabt
  return ::access_rights(name, file, readflag, def, fun);
}
