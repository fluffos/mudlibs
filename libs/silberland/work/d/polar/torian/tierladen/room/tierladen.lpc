inherit "/p/service/angel/haustiere/std_petshop";

#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"
#include <laden.h>

void PreparePet();
string tafel(string key);
string strSound(string key);
string strWind(string key);
int tueroffen();

string name;

void create()
{
  ::create();

  name = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Khitans Haustierladen");
  SetProp(P_INT_LONG, "Fehler!");

//--Laden-Konstanten-------------------------------------------------------

  SetProp(P_SHOPKEEPER_NAME, "Khitan" );
  SetProp(P_SHOPKEEPER_GENDER, MALE );
  catch(call_other(ROOM "pet_store", "???"));
  SetStorageRoom(ROOM "pet_store");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]) );

//--Haustierkram---------------------------------------------------------------

  PreparePet();
  AddReadDetail ( ({ "tafel", "preistafel"}), #'tafel );

  SetProp ( P_PET_KONFIG_TOOL, OBJ "pet_eiskristall");

//--Details----------------------------------------------------------------

  AddDetail( ({ "verkaufsraum", "raum" }), QueryProp(P_INT_LONG) );
  AddDetail( ({ "waende" }),
    "Welche Wand meinst Du denn genau?"
  );
  AddDetail( ({ "wand", "nordwand", "hintere wand" }),
    "Die hintere Wand wird komplett von einer grossen Holztheke eingenommen."
  );
  AddDetail( ({ "ostwand", "kamin" }),
    "Die Ostwand wird von einem relativ grossen Kamin dominiert. Ein angenehm "
    "waermendes Feuer brennt in ihm. Vor dem Kamin liegt ein Eisbaerenfell und "
    "direkt daneben ein Stapel Holzscheite."
  );
  AddDetail( ({ "stapel", "holzscheite", "scheite" }),
    "Mit diesen Holzscheiten wird der Kamin beheizt."
  );
  AddDetail( ({ "westwand" }),
    "Die Westwand ist absolut kahl."
  );
  AddDetail( ({ "suedwand", "sueden" }),
    "In der Suedwand befindet sich die Tuer nach draussen, daneben ist ein Fenster "
    "mit Eisblumen zu erkennen."
  );
  AddDetail( ({ "holztheke", "theke" }),
    "Eine grosse stabile Holztheke. Schon viele Dinge haben ueber ihr ihren Besitzer "
    "gewechselt. Auf ihr steht eine alte Kasse und eine kleine Klingel. Ausserdem "
    "befindet sich auf ihr die Tafel mit den zur Zeit angebotenen Tieren."
  );
  AddDetail( ({ "kasse", "rechenhilfe", "hilfe" }),
    "So teuer wie einige hier angebotene Tiere sind, ist es kaum verwunderlich, dass "
    "Khitan eine Rechenhilfe benoetigt."
  );
  AddDetail( ({ "tiere", "tieren" }),
    "Wenn Du wissen willst, welche Tiere zur Zeit angeboten werden, solltest Du die "
    "Tafel auf der Theke lesen."
  );
  AddDetail( ({ "zeit", "angebot" }),
    "Das Angebot wechselt von Zeit zu Zeit."
  );
  AddDetail( ({ "klingel" }),
    "Mit der Klingel kann man nach dem Besitzer klingeln, wenn er mal nicht da ist."
  );
  AddDetail( ({ "feuer" }),
    "Ab und zu lodert das Feuer auf. Es waermt den gesamten Raum."
  );
  AddSpecialDetail( ({ "sessel" }), "strSessel" );
  AddDetail( ({ "tage", "jahren", "jahr", "tag" }),
    "Man koennte auch von Jahren reden. In solch einer Umgebung haelt sich "
    "vermutlich einiges laenger als anderswo."
  );
  AddDetail( ({ "umgebung" }),
    "Schau Dich um, wenn Du Deine Umgebung untersuchen willst."
  );
  AddDetail( ({ "kunden", "kundschaft", "kunde" }),
    "Bist Du auch ein Kunde? Wenn ja, mach es Dir doch gemuetlich."
  );
  AddDetail( ({ "ladenbesitzer", "besitzer" }),
    "Khitan ist der Besitzer dieses schmucken Ladens."
  );
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus dicken Holzbalken, in der Naehe des Kamins ist sie "
    "leicht russgeschwaerzt."
  );
  AddDetail( ({ "naehe", "russ" }),
    "In der Naehe des Kamins hat sich ein wenig Russ an der Decke gesammelt."
  );
  AddDetail( ({ "boden" }),
    "Auch der Boden besteht aus dicken Holzbalken. Er ist mit einigen weichen "
    "Fellen ausgelegt. Dir tut es fast leid, mit Deinem dreckigen Schuhwerk "
    "darauf zu stehen."
  );
  AddDetail( ({ "felle", "rentierfelle", "rentierfellen" }),
    "Der Boden ist mit Rentierfellen ausgelegt, nur direkt vor dem Kamin scheint "
    "das obligatorische Eisbaerenfell zu liegen."
  );
  AddDetail( ({ "eisbaerenfell", "baerenfell" }),
    "Sowas erwartet man doch vor einem Kamin, oder?"
  );
  AddSpecialDetail( ({ "schuhwerk" }), "strSchuhwerk"  );
  AddDetail( ({ "kaelte" }),
    "Ohne das Feuer im Kamin haetten die Tuer und das Fenster keine Chance, "
    "die Kaelte draussen zu halten."
  );
  AddDetail( ({ "holzbalken", "balken", "holz" }),
    "Woher das Holz kommt, kannst Du Dir nicht erklaeren. Irgendwo hier in der "
    "Naehe muss wohl ein Wald sein."
  );
  AddDetail( ({ "naehe", "wald", "wanderungen" }),
    "Hast Du auf Deinen Wanderungen hierher einen Wald gesehen?"
  );
  AddDetail( ({ "fenster" }),
    "Viel sehen von draussen kann man nicht. Die geringe Aussicht wird aber "
    "von den wunderschoenen Eisblumen mehr als wettgemacht."
  );
  AddDetail( ({ "aussicht" }),
    "Was gaebe es schon zu sehen? Schnee, Schnee und nochmals Schnee."
  );
  AddDetail( ({ "schnee" }),
    "Wenn Du Schnee sehen willst, solltest Du vor die Tuer gehen."
  );
  AddDetail( ({ "chance" }),
    "Ohne Feuer besteht keine Chance, dieser Kaelte draussen zu trotzen."
  );
  AddDetail( ({ "eisblumen", "eisblume" }),
    "Eisblumen haben sich auf den Fensterscheiben niedergelassen. Das Feuer im "
    "Kamin spiegelt sich in ihnen, was ihnen ein richtig lebendiges Aussehen "
    "verleiht."
  );
  AddDetail( ({ "aussehen", "flammen" }),
    "Mit den tanzenden Flammen sehen sie richtig lebendig aus."
  );
  AddDetail( ({ "fensterscheiben", "scheiben", "fensterscheibe", "scheibe" }),
    "Es muss verdammt kalt draussen sein, wenn sich sogar an den Scheiben eines "
    "geheizten Raumes Eisblumen festsetzen."
  );
  AddDetail( ({ "laden" }),
    "Dies ist der Laden von Khitan."
  );
  AddDetail( ({ "khitan" }),
    "Er ist wohl grade neue Tiere fangen."
  );
  AddDetail( ({ "dinge" }),
    "Hauptsaechlich Tiere und ihr Futter."
  );
  AddDetail( ({ "tafel" }),
    "Auf der Tafel steht das aktuelle Angebot. Lies sie doch mal."
  );
  AddDetail( ({ "futter", "futterangebot" }),
    "Wenn Du Dich ueber das Futterangebot informieren moechtest, gib einfach <zeige> "
    "ein."
  );

  AddSound( DEFAULT_SOUND, #'strSound);

  AddSound( ({ "feuer" }),
    "Ab und zu knackt das Feuer laut.");
  AddSound( ({ "wind" }), #'strWind);

  AddSmell( DEFAULT_SMELL,
    "Der durchdringende Geruch des Feuers und des Holzes ueberdeckt fast alles. "
    "Dennoch kannst Du ganz schwach einen weiteren Geruch wahrnehmen."
  );
  AddSmell( ({ "feuer" }),
    "Das Feuer im Kamin verbreitet einen angenehmen Geruch."
  );
  AddSmell( ({ "holz" }),
    "Das Holz riecht nach ... Holz."
  );
  AddSmell( ({ "geruch" }),
    "Ganz schwach kannst Du das Tierfutter wahrnehmen, welches hier verkauft wird."
  );
  AddSmell( ({ "tierfutter", "futter" }),
    "Genau einordnen kannst Du es leider nicht."
  );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "sitz", "sitze", "setz", "setze" }), "cmdsitzen" );
  AddCmd( ({ "steh", "stehe", "erheb", "erhebe" }), "cmdaufstehen" );
  AddCmd( ({ "klingl", "klingel", "klingle", "klingele" }), "cmdklingeln" );


//--Ausgaenge--------------------------------------------------------------

    NewDoor("raus", ROOM "vorhof" , ({"tuer", "holztuer"}) ,
    ({DOOR_CLOSED,
      DOOR_RESET_CL,
      D_SHORT, "Eine %se Holztuer.",
      D_LONG, "Die Tuer besteht aus dicken Holzbalken. Sie ist perfekt dafuer "
              "geeignet, die eisige Kaelte draussen zu halten.",
      D_NAME,  "Holztuer",
      D_GENDER,FEMALE,
      D_MSGS, "raus",
      D_TESTFUNC, "exit_test"
    })
  );

//--Items & NPCs-----------------------------------------------------------

  AddItem( NPC "khitan" , REFRESH_DESTRUCT);
}


//--Funktionen fuer Details------------------------------------------------

string strSchuhwerk(string str)
{
  object *inv;
  string s;
  // Liste der getragenen Sachen, AT_BOOT rausfiltern
  inv = filter_array(TP->QueryProp(P_ARMOURS),
          lambda( ({'x}), ({ #'==,
              ({ #'call_other, 'x, "QueryProp", P_ARMOUR_TYPE }),
              AT_BOOT }) ) );
  if(!sizeof(inv))
  {
    s = "Da Du nichts an den Fuessen traegst, besteht auch kein Grund, dass Dir etwas "
       +"leid tut.";
  }
  else
  {
    s = "Dir tut es aber auch nur fast leid.";
  }
  return BS(s);
}

string _query_int_long()
{
  string txt;

  txt = "Du stehst mitten in einem gemuetlichen Verkaufsraum. Die hintere "
       +"Wand wird von einer grossen stabilen Holztheke eingenommen. An der "
       +"Ostwand brennt ein Feuer im Kamin. Ein Sessel fuer die Kunden steht "
       +"davor. ";

  if(!present(QueryProp(P_SHOPKEEPER_ID)))
  {
    txt += "Leider scheint der Besitzer des Ladens gerade nicht "
          +"hier zu sein.";
  }
  else
  {
    txt += "Khitan, der Ladenbesitzer, "
          +"steht hinter der Theke und wartet auf Kundschaft.";
  }

  if (QueryProp(P_DOOR_INFOS))
    return BS(txt)+(string)call_other(DOOR_MASTER,"look_doors");

  return BS(txt);
}

void PreparePet()
{
  RemovePet("all");
  // Diese Haustiere immer
  AddPet( "schneemaus", NPC "pet_schneemaus" );
  AddPet( "schneehase", NPC "pet_schneehase" );

  // Rentier oder Elch
  if(random(2))
    AddPet( "rentier", NPC "pet_rentier" );
  else
    AddPet( "elch", NPC "pet_elch" );

  // Schneewolf oder Polarwolf
  if(random(2))
    AddPet( "schneewolf", NPC "pet_schneewolf" );
  else
    AddPet( "polarwolf", NPC "pet_polarwolf" );

  // Ein starkes zusaetzlich (oder keins)
  switch(1+random(100))
  {
    case 1..33:
      AddPet( "schneeleopard", NPC "pet_schneeleopard" );
      break;
    case 34..66:
      AddPet( "eisbaer", NPC "pet_eisbaer" );
      break;
    default: //67..100
   }
}

void reset()
{
  PreparePet();
  return ::reset();
}

string tafel(string key)
{
  return GetPriceList();
}

//--Funktionen fuer Kommandos----------------------------------------------

//auf Sessel sitzen:
int cmdsitzen(string str)
{
  notify_fail("Wo moechtest Du Dich hinsetzen?\n");

  if(!str || str == "") return 0;

  if(str == "auf sessel" || str == "in sessel")
  {
    if(name == getuid(TP))
    {
      write(BS("Aber Du sitzt doch schon im Sessel!"));
      return -1;
    }

    if(!name)
    {
      write(BS("Du machst es Dir in dem Sessel bequem."));
      Message(BS(TP->Name(WER)+" macht es sich in dem Sessel bequem.") ,MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      name = getuid(TP);
      return 1;
    }
    else
    {
      write(BS("Aber in dem Sessel sitzt schon "+capitalize(name)+"."));
      return -1;
    }
  }
  return 0;
}

//aufstehen:
int cmdaufstehen(string str)
{
  notify_fail("Von wo moechtest Du aufstehen?\n");

  if(!str || str == "") return 0;

  if(str == "von sessel auf" || str == "auf")
  {
    if(name == getuid(TP))
    {
      write(BS("Du stehst aus dem Sessel auf."));
      Message(BS(TP->Name(WER)+" steht aus dem Sessel auf."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      name = 0;
      return 1;
    }
    else
    {
      write(BS("Aber Du sitzt doch gar nicht im Sessel?"));
      return -1;
    }
  }
  return 0;
}

string strSessel(string key)
{
  string txt;
  txt= "Ein rustikaler, aber dennoch sehr bequem aussehender Sessel. Seine besten "
      +"Tage sind schon lange vorbei, dennoch ist er weit davon entfernt, schaebig "
      +"auszusehen. ";

  if(name == getuid(TP))
    txt += "Du hast es Dir in ihm bequem gemacht.";
  else if(name)
    txt += capitalize(name)+" hat es sich in ihm bequem gemacht.";

  return BS(txt);
}

//Test beim Verlassen des Raumes, ob man auf Sessel
int exit_test(string dir)
{
  if(name == getuid(TP))
  {
    write("Dazu solltest Du erstmal aufstehen.\n");
    return 1;
  }

  return 0;
}

//Mit der Klingel klingeln:
int cmdklingeln(string str)
{
  object obj;

  notify_fail("Womit moechtest Du klingeln?\n");

  if(!str || str == "") return 0;

  if(str == "klingel" || str == "mit klingel")
  {
    write(BS("Du klingelst laut mit der Klingel."));
    Message(BS(TP->Name(WER)+" klingelt laut mit der Klingel."), MSGFLAG_SOUND|MSGFLAG_NO_TP);

    obj = present("khitan");
    if(obj)
    {
      obj->sage(BS("Was soll das, "+TP->Name(WER)+"! Ich bin doch da."));
    }
    else
    {
      Message(BS("Scheint keiner Da zu sein."), MSGFLAG_SOUND|MSGFLAG_NO_TP);
    }
    return 1;
  }
  return 0;
}

string strSound(string key)
{
  string s;

  s = "Das Feuer knackt ab und zu. ";

  if (tueroffen())
  {
    s += "Durch die offene Tuer hoerst Du den Wind pfeifen.";
  }

  return BS(s);
}

string strWind(string key)
{
  string s;

  if (tueroffen())
  {
    s = "Durch die offene Tuer hoerst Du den Wind pfeifen. Vielleicht waere es eine "
       +"gute Idee, die Tuer zu schliessen?";
  }
  else
  {
    s = "Der Wind weht nur draussen.";
  }
  return BS(s);
}

int tueroffen()
{
  return (DOOR_MASTER->QueryDoorStatus(ROOM "vorhof")==D_STATUS_OPEN);
}