  AddExit( "westen", "nach Westen#" + "/d/polar/thor/weg/room/weg27" );
  AddExit( "suedwesten", "nach Suedwesten#" + "/d/polar/thor/weg/room/weg26" );

//--Items & NPCs-----------------------------------------------------------

  AddItem( "/d/polar/thor/xandim/npc/waechter1.lpc" , REFRESH_DESTRUCT);
  AddItem( "/d/polar/thor/xandim/npc/waechter1.lpc" , REFRESH_DESTRUCT);
