    "Es riecht durchdringend nach den diversen Abfaellen von Tieren."
  );

  AddSmell( ({ "abfaellen", "abfaelle" }),
    "So genau willst Du daran gar nicht riechen ..."
  );
  AddSmell( ({ "tiere", "tieren" }),
    "An welchem Tier willst Du genau riechen?"
  );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "bewunder", "bewundere" }), "cmd_bewundern" );
  AddCmd( ({ "loese", "loes" }), "cmd_loesen" );

//--Ausgaenge--------------------------------------------------------------

    NewDoor("huette", ROOM "tierladen" , ({"tuer", "holztuer"}),
    ({DOOR_CLOSED,
      DOOR_RESET_CL,
      D_SHORT, "Eine %se Holztuer.",
      D_LONG, "Die Tuer besteht aus dicken Holzbalken. Sie ist perfekt dafuer "
              "geeignet, die eisige Kaelte draussen zu halten.",
      D_NAME,  "Holztuer",
      D_GENDER,FEMALE,
      D_MSGS, "in die Huette"
