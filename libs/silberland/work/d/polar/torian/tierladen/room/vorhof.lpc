//--Funktionen fuer Kommandos----------------------------------------------

int cmd_bewundern(string str)
{
  notify_fail("Was willst Du bewundern?\n");

  if(!str || str == "") return 0;

  if(!(str == "landschaft" ||
       str == "schneelandschaft"     )) return 0;

  if(TP->CannotSee()) return -1;

  if(member(blinded,getuuid(TP)) != -1)
  {
    write("Nochmal willst Du Dich nicht blenden lassen.\n");
    return -1;
  }

  write("Du bewunderst ausgiebigst die weisse Schneelandschaft.\nDie "
          +"Sonne tut Deinen Augen weh!!!\n");
  TO->Message(TP->Name(WER, 1)+" bewundert die weisse Schneelandschaft.\n",
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  blinded += ({ getuuid(TP) });
  TP->SetProp(P_BLIND, 5+random(5));

  return 1;
}

// Tiere befreien
int cmd_loesen(string str)
{
  object waechter, laden;
  string *tiere;
  notify_fail("Was willst Du loesen?\n");

  if(!str || str == "") return 0;
  if(!(str == "riegel"  )) return 0;

  if(riegel == WEG)
  {
    write(BS("Aber die Riegel wurden schon alle geloest!"));
    return -1;
  }

  waechter = present("xandimwaechter");
  if(waechter)
  {
    Message(BS(TP->Name(WER, 1)+" versucht die Riegel zu loesen."),
    MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    waechter->sage("Finger weg, die Tiere sind gefaehrlich!");
    return -1;
  }
  else
  {
    write(BS("Du loest die Riegel! Ob das so klug war?"));
    Message(BS(TP->Name(WER, 1)+" loest die Riegel! Ob das so klug war??"),
    MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    riegel = WEG;
    call_other(ROOM "tierladen", "???");
    laden = find_object(ROOM "tierladen");

    if(laden)
      laden->RemovePet("all");

    call_out("befreien", 4);
    return 1;
  }

}
//--Funktionen fuer Details------------------------------------------------

string _query_int_long()
{
  string txt;
  string s;
  object *waechter;
  waechter = all_inventory(TO);
  waechter = filter_objects(waechter,"id","xandimwaechter");

  switch(sizeof(waechter))
  {
    case 0:
      s = "welche vollkommen unbewacht zu sein scheinen.";
    break;

    case 1:
      s = "welche von einem grimmig aussehenden Xandimwaechter "
          +"bewacht werden.";
    break;

    default:
      s = "welche von zwei grimmig aussehenden Xandimwaechtern "
          +"bewacht werden.";
    break;
  }

  txt = "Mitten in der schneebedeckten Ebene steht eine kleine Blockhuette. "
       +"Das Dach ist unter der dicken Schneedecke kaum auszumachen, lediglich "
       +"ein kleiner rauchender Schornstein ist deutlich zu erkennen. Vor der "
       +"Huette stehen einige Kaefige, "+s;

  if (QueryProp(P_DOOR_INFOS))
    return BS(txt+"\n"+(string)call_other(DOOR_MASTER,"look_doors"));

  return BS(txt);
}

string strKaefige(string str)
{
  string s;
  if(riegel == WEG)
  {
    s = "Die Kaefige sind leer. Irgendjemand muss die Riegel geloest und damit "
       +"die Tiere befreit haben.";
  }
  else
  {
    s = "In den Kaefigen befinden sich einige Tiere. Manchen von ihnen bist Du "
       +"auf dem Weg hierher sogar schon begegnet. Die Kaefige werden von stabilen "
       +"Riegeln verschlossen gehalten.";
  }

  return BS(s);
}
void reset()
{
  riegel = DA;
  blinded = ({});
  return ::reset();
}

string strTiere(string str)
{
  string s;
  string *inv;
  int i;

  inv = Tiere();

  for(i=0; i<sizeof(inv); i++)
  {
    inv[i] = capitalize(inv[i]);
  }

  switch(sizeof(inv))
  {
    case 0:
      s = "Nanu, Du musst Dich wohl getaeuscht haben, es ist gar kein Tier "
         +"mehr da.";
      break;
    case 1:
      s = "Du kannst lediglich "+inv[0]+" erkennen.";
      break;
    default:
      s = "Einige Tiere fristen in diesen trostlosen Kaefigen ihr dasein. Du "
         +"erkennst folgende Tiere:\n";
      s += implode( inv[0..<2], ", ")+" und "+inv[<1]+".\n";

      break;
  }

  return BS(s);
}

string strMaus(string str)
{
  string s;
  string *inv;

  inv = Tiere();

  if(member(inv, "schneemaus")!=-1)
  {
    s = "Eine kleine Schneemaus huscht in dem Kaefig hin und her. "
        +"Du hast sie wegen ihres weissen Felles nicht gleich erkannt. "
        +"Durch ihre schwarzen kleinen Kulleraugen blickt sie Dich "
        +"zutraulich an.";
  }
  else
  {
    s = "Leider kannst Du keine Schneemaus finden.";
  }
  return BS(s);
}

