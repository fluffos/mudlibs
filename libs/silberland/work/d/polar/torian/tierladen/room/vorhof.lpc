// hilfsfunktion fuers befreien
void befreien()
{
  Message(BS("Ploetzlich fluechten alle Tiere aus den Kaefigen!"),
  MSGFLAG_VISUAL);
  return;
}

// Hilfsfunktion fuer die Tier-Details
string *Tiere()
{
  object ob;

  call_other(ROOM "tierladen", "???", 0);
  ob = find_object(ROOM "tierladen");

  return ob->GetAvaliableRaces();
}