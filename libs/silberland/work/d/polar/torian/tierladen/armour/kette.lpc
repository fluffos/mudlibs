#include "../def.h"

inherit "std/armour";

//--Create-----------------------------------------------------------------

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Baerenzahnkette");
  SetProp(P_LONG,
    "Die Baerenzahnkette besteht aus vielen einzelnen, gefaehrlich "
    "aussehenden Baerenzaehnen, die in sorgfaeltiger Handarbeit auf ein "
    "schmales Lederband aufgezogen und mit kleinen Knoten befestigt "
    "wurden. Sie ist Khitans ganzer Stolz.");

  AddDetail( ({ "baerenzaehne", "baerenzahn", "zaehne", "zahn" }),
    "Eine ganze Reihe dieser gefaehrlich aussehenden, leicht gebogenen "
    "Baerenzaehne wurde an dem Lederband befestigt. Ob Khitan sie wohl alle "
    "selbst erbeutet hat?");

  AddDetail( ({ "reihe", "menge" }),
    "Du zaehlst genau siebenundzwanzig Baerenzaehne. Das ist eine ganz "
    "schoen stattliche Menge.");

  AddDetail( ({ "khitan" }),
    "Diese Kette gehoert Khitan. Sie ist sein ganzer Stolz.");

  AddDetail( ({ "stolz" }),
    "Auf solch eine Kette waerst Du sicherlich auch stolz.");

  AddDetail( ({ "handarbeit" }),
    "Khitan scheint sich sehr viel Muehe bei der Anfertigung dieser "
    "Kette gegeben zu haben.");

  AddDetail( ({ "muehe" }),
    "Jeder einzelne Zahn wurde auf das Lederband aufgereiht und mit "
    "einem kleinen Knoten gesichert.");

  AddDetail( ({ "lederband", "band" }),
    "Das duenne Band, auf das die Baerenzaehne aufgezogen wurden, "
    "besteht aus dunklem Leder. Es sieht schon ein wenig alt und "
    "rissig aus, scheint aber trotzdem noch gut zu halten.");

  AddDetail( ({ "leder" }),
    "Das Leder ist wohl schon ein wenig aelter und sieht etwas rissig aus, "
    "scheint aber dennoch zu halten.");

  AddDetail( ({ "knoten" }),
    "Jeder einzelne Zahn wurde mit einem kleinen Knoten sorgfaeltig "
    "gesichert.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Baerenzahnkette");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kette", "baerenzahnkette", "baerenkette"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_LEATHER: 60, MAT_IVORY: 40 ]));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_AMULET);
  SetProp(P_AC, 3);
  SetProp(P_QUALITY_DECAY, 100);

//--Create Ende------------------------------------------------------------

}
