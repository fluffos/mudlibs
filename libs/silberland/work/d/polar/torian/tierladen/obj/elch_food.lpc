inherit "/std/thing.lpc";

#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void create ()
{
  if (!is_clone(TO)) return;

  ::create();
  SetProp( P_SHORT, "Elchfutter" );
  SetProp( P_NAME, "Elchfutter" );
  SetProp(P_LONG,
    "Dieses Elchfutter besteht aus verschiedensten Graesern und "
    "Beeren. Wenn Du es nicht besser wuesstest, wuerdest Du denken, dass "
    "es sich um Rentierfutter handelt.");

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp( P_VALUE, 20 );
  SetProp( P_WEIGHT, 100 );
  SetProp(P_GENDER, NEUTER);

  AddDetail( ({ "graeser" }),
    "Verschiedene Graeser sind dem Rentierfutter enthalten.");
  AddDetail( ({ "beeren", "beere" }),
    "Du kannst die verschiedenen Sorten leider nicht genauer definieren.");
  AddDetail( ({ "sorte", "sorten" }),
    "Es sind verschiedene Sorten Beeren beigemengt worden.");
  AddDetail( ({ "rentier" }),
    "Wenn Dir eines ueber den Weg laeuft, kannst Du es ja hiermit "
    "fuettern.");
  AddDetail( ({ "elch" }),
    "Wenn Dir einer ueber den Weg laeuft, kannst Du ihn ja hiermit "
    "fuettern.");
  AddDetail( ({ "rentierfutter" }),
    "Es ist aber Elchfutter.");


  AddId( ({"elchfutter", "futter"}) );

}