inherit "/std/thing.lpc";

#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void create ()
{
  ::create();
  SetProp( P_SHORT, "Hasenfutter" );
  SetProp( P_NAME, "Hasenfutter" );
  SetProp( P_LONG, "Ein buendel Karotten vermischt mit Loewenzahn. Das mag "
                  +"jeder Hase." );

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp( P_VALUE, 15 );
  SetProp( P_WEIGHT, 100 );
  SetProp(P_GENDER, NEUTER);

  AddId( ({"hasenfutter", "futter"}) );

  AddDetail( ({ "karotten", "loewenzahn", "lieblingsspeise" }),
    "Karotten und Loewenzahn sind die Lieblingsspeise der Hasen.");
  AddDetail( ({ "hase" }),
    "Wenn Dir einer ueber den Weg laeuft, kannst Du ihn ja hiermit "
    "fuettern.");

}