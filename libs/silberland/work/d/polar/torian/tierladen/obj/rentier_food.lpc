inherit "/std/thing.lpc";

#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void create ()
{
  if (!is_clone(TO)) return;

  ::create();
  SetProp( P_SHORT, "Rentierfutter" );
  SetProp( P_NAME, "Rentierfutter" );
  SetProp(P_LONG,
    "Dieses Rentierfutter besteht aus verschiedensten Graesern und "
    "Beeren. Sehr waehlerisch sind Rentiere scheinbar nicht.");

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp( P_VALUE, 20 );
  SetProp( P_WEIGHT, 100 );
  SetProp(P_GENDER, NEUTER);

  AddDetail( ({ "graeser" }),
    "Verschiedene Graeser sind dem Rentierfutter enthalten.");
  AddDetail( ({ "beeren", "beere" }),
    "Du kannst die verschiedenen Sorten leider nicht genauer definieren.");
  AddDetail( ({ "sorte", "sorten" }),
    "Es sind verschiedene Sorten Beeren beigemengt worden.");
  AddDetail( ({ "rentier" }),
    "Wenn Dir eines ueber den Weg laeuft, kannst Du es ja hiermit "
    "fuettern.");

  AddId( ({"rentierfutter", "futter"}) );
}