inherit "/std/thing.lpc";

#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void create ()
{
  if (!is_clone(TO)) return;

  ::create();
  SetProp( P_SHORT, "Schneeleopardenfutter" );
  SetProp( P_NAME, "Schneeleopardenfutter" );
  SetProp( P_LONG, "Ein paar undefinierbare Fleischbrocken in einer Eishuelle. "
                  +"Wers mag... Schneeleoparden sicher." );

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp( P_VALUE, 40 );
  SetProp( P_WEIGHT, 100 );
  SetProp(P_GENDER, NEUTER);

  AddDetail( ({ "fleischbrocken", "brocken", "eishuelle", "huelle" }),
    "Du kannst beim besten Willen nicht erkennen, um was es sich genau handelt.");
  AddDetail( ({ "schneeleoparden" }),
    "Wenn Dir einer ueber den Weg laeuft, kannst Du ihn ja hiermit "
    "fuettern.");

  AddId( ({"leopardfutter", "futter"}) );
}