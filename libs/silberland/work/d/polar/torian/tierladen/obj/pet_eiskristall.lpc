inherit "/p/service/angel/haustiere/std_pet_item.lpc";

#include <properties.h>
#include <moving.h>
#include "/p/service/angel/haustiere/std_pet.h"

void _delay ( string dummy )
{
  ::BringPetBack(dummy);
}

int BringPetBack ( string args )
{
   if ( args == "kristall" || args == "eiskristall" )
   {	
     write ("Du reibst an Deinem Eiskristall.\n");
     tell_room (environment(this_player()), this_player()->Name(WER)+
                " reibt an "+this_player()->QueryPossPronoun(MALE, WEM, SINGULAR)
                +" Eiskristall.\n", ({this_player()}));
     call_out ("_delay", 2, args);
     return 1;
   }
   notify_fail ("An was moechtest Du reiben?\n");
   return 0;   
}

void create ()
{
   if (!is_clone(this_object())) return;
   ::create();

   SetProp (P_NAME, "Eiskristall");
   SetProp (P_SHORT, "Ein blauschimmernder Eiskristall");
   SetProp (P_LONG,  "Diesen blauschimmernden Eiskristall hast Du wohl bekommen, "
                    +"als Du Dir bei Khitan eines seiner Tiere ausgesucht hast.");

   SetProp (P_INFO, "Mit diesem Eiskristall kannst Du folgendes tun:\n"+
                    "----------------------------------------------\n"+
                    "reiben:    Damit kannst Du Dein Haustier wieder zurueckholen.\n"+
                    "pethelp:   Dieses Kommando zeigt Dir einen Hilfetext an.\n"+
                    "petconfig: Damit kannst Du Dein Haustier veraendern.\n"
                    "entlasse <haustiername> fuer immer:\n"
                    "!!! WARNUNG !!! kann man nicht rueckgaengig machen !!! WARNUNG !!!\n\n" );
   SetProp (P_WEIGHT, 1);
   SetProp (P_GENDER, NEUTER);

   seteuid(getuid(this_object()));

   AddId(({"kristall", "eiskristall"}));

   AddCmd ( ({"reib", "reibe"}) , "BringPetBack");
}