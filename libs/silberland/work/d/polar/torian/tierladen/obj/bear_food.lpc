inherit "/std/thing.lpc";

#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void create ()
{
  if (!is_clone(TO)) return;

  ::create();
  SetProp( P_SHORT, "Eisbaerenfutter" );
  SetProp( P_NAME, "Eisbaerenfutter" );
  SetProp( P_LONG, "Das Eisbaerenfutter besteht aus gefrorenem Fisch und "
                  +"etwas, das wie Robbenfleisch aussieht." );

  AddDetail( ({ "robbenfleisch", "fleisch", "fisch", "gedanken" }),
    "Dir wird schlecht bei dem Gedanken so etwas essen zu muessen. Aber "
    "Eisbaeren moegen sowas angeblich.");
  AddDetail( ({ "eisbaer", "eisbaeren" }),
    "Wenn Dir einer ueber den Weg laeuft, kannst Du ihn ja hiermit "
    "fuettern.");

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp( P_VALUE, 50 );
  SetProp( P_WEIGHT, 100 );
  SetProp(P_GENDER, NEUTER);

  AddId( ({"baerenfutter", "futter"}) );
}