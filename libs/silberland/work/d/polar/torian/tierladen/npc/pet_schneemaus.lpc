inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells ()
{
   SetProp (P_SPELLS, 0);

   SetProp(P_SPELLRATE, 30);

   AddSpell(1, 100,
     Name()+" beisst Dich!\n",
     Name()+" beisst @WEN!\n",
      ({ DT_RIP }),([SP_SHOW_DAMAGE:1]));

}

void create ()
{
  SetProp (P_PET_PRICE, 1000);
  SetProp (P_PET_LEVEL, 1);
  if (!is_clone(this_object())) return;
  ::create();


   SetProp (P_RACE, "Schneemaus");
   SetProp (P_NAME, "Schneemaus");
   SetProp (P_MSGIN, "trippelt herein");
   SetProp (P_MSGOUT, "trippelt");
   SetProp (P_MMSGIN, "springt herein");
   SetProp (P_MMSGOUT, "springt");
   SetProp (P_SIZE, 10 + random(10));
   SetProp (P_ALIGN, 0);
   SetProp (P_MAX_HANDS, 4);
   SetProp (P_GENDER, FEMALE);
   SetProp (P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:20]));
   
   SetProp (P_PET_ENEMIES, ({ }) );
   SetProp (P_PET_FOOD, ([ "kaese":3, "maeusefutter":1, "Nahrung":0 ]) );

   create_default_npc(1);

   SetProp( P_HANDS,({" mit seinen scharfen Klauen und Zaehnen"
                      ,QueryProp(P_HANDS)[1]
                      ,({ DT_PIERCE, DT_RIP })
                     }) );

   SetProp (P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:     -0.2, DT_WATER:      -0.2
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ]) );

  InitSpells ();

  AddId( ({"schneemaus", "maus", "FELL_WUSCHEL"}) );
}
