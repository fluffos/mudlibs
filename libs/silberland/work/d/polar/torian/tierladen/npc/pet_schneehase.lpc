inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells()
{
  SetProp(P_SPELLS, 0);

  SetProp(P_SPELLRATE, 30);

  AddSpell(1, 100,
	   Name()+" schlaegt Haken und greift Dich von hinten an!\n",
	   Name()+" schlaegt einen Haken und greift @WEN von hinten an!\n",
	   DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

}

void create()
{
  SetProp(P_PET_PRICE, 6000);
  SetProp(P_PET_LEVEL, 3);
  if (!is_clone(this_object())) return;
  ::create();


  SetProp(P_RACE, "Schneehase");
  SetProp(P_NAME, "Schneehase");
  SetProp(P_MSGIN, "hoppelt herein");
  SetProp(P_MSGOUT, "hoppelt");
  SetProp(P_MMSGIN, "springt herein");
  SetProp(P_MMSGOUT, "springt");
  SetProp(P_SIZE, 60);
  SetProp(P_ALIGN, -30);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 9243);
  SetProp (P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-15,T_RANGE_MAX:25]));

  SetProp(P_PET_ENEMIES, ({ }));
  SetProp(P_PET_FOOD,
	  (["karotte":3,"hasenfutter":1,"Nahrung":0]));
  
  create_default_npc(3);
  
  SetProp( P_HANDS,({" mit seinen Pfoten"
                     ,QueryProp(P_HANDS)[1]
                     ,DT_BLUDGEON }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
	  ([ DT_FIRE:      0.0, DT_COLD:      -0.2, DT_WATER:       -0.2
	     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
	     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
	     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
	     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
	     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
	     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
	     , DT_RIP:       0.0
	   ]));
  
  InitSpells();
  
  AddId(({"schneehase","hase", "FELL_WUSCHEL"}));
}
