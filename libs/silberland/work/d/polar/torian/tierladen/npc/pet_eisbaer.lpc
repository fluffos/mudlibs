inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells ()
{
   SetProp (P_SPELLS, 0);

   SetProp(P_SPELLRATE, 35);

   AddSpell(6, 150,
     Name()+" verpasst Dir mit seinen scharfen Klauen eine Ohrfeige! AUTSCH!!",
     Name()+" verpasst @WEM mit seinen scharfen Klauen eine Ohrfeige.\n",
      ({ DT_RIP }),([SP_SHOW_DAMAGE:1]));

   AddSpell(3, 250,
     Name()+" springt Dich an und beisst Dir ins Bein.",
     Name()+" springt @WEN an und beisst ins Bein.\n",
      ({ DT_PIERCE }),([SP_SHOW_DAMAGE:1]));

   AddSpell(1, 300,
     Name()+" schlaegt Dir seine spitzen Zaehne ins Fleisch.",
     Name()+" schlaegt @WEM seine Zaehne ins Fleisch.\n",
      ({ DT_PIERCE }),([SP_SHOW_DAMAGE:1]));
}

void create ()
{
  SetProp (P_PET_PRICE, 225000);
  SetProp (P_PET_LEVEL, 15);
  if (!is_clone(this_object())) return;
  ::create();


   SetProp (P_RACE, "Eisbaer");
   SetProp (P_NAME, "Eisbaer");
   SetProp (P_MSGIN, "stapft herein");
   SetProp (P_MSGOUT, "stapft");
   SetProp (P_MMSGIN, "stapft herein");
   SetProp (P_MMSGOUT, "stapft");
   SetProp (P_SIZE, 150 + random(50));
   SetProp (P_ALIGN, 0);
   SetProp (P_MAX_HANDS, 4);
   SetProp (P_GENDER, MALE);
   SetProp (P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:20]));

   SetProp (P_PET_ENEMIES, ({ "hase", "kaninchen", "rentier", "elch", "vogel" }) );
   SetProp (P_PET_FOOD, ([ "leiche":3, "fisch":2, "baerenfutter":1, "Nahrung":0 ]) );

   create_default_npc(15);

   SetProp( P_HANDS,({" mit seinen scharfen Klauen und Zaehnen"
                      ,QueryProp(P_HANDS)[1]
                      ,({ DT_PIERCE, DT_RIP })
                     }) );

   SetProp (P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.2, DT_COLD:     -0.2, DT_WATER:      -0.2
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.2, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.2, DT_POISON:    0.2, DT_TERROR:     -0.3
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:    -0.1, DT_BLUDGEON:   -0.1
     , DT_PIERCE:   -0.1, DT_SQUEEZE:  -0.1, DT_WHIP:       -0.1
     , DT_RIP:      -0.1
     ]) );

  InitSpells ();

  AddId( ({"eisbaer", "baer", "FELL_WUSCHEL"}) );
}
