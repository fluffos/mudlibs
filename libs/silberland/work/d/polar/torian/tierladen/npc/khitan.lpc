inherit "/p/service/angel/haustiere/std_petshop_vendor";
inherit "/std/npc/spells";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Khitan");
  SetProp(P_LONG,
    "Vor Dir steht Khitan, ein grosser Xandim. Sein wettergegerbtes Gesicht "
    "verleiht ihm ein altes und weises Aussehen. Nur seine blauen, "
    "unternehmungslustigen Augen strafen diesen Eindruck luegen. Um seinen Hals "
    "haengt eine Kette aus Baerenzaehnen.");

  SetProp(P_NAME, "Khitan");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-40,T_RANGE_MAX:40]));
  AddId(({"khitan", "haendler", "tierhaendler",
          "haustierhaendler", "NOWIMPY", "xandim",
          "NOCONTROL", "\npetshop_vendor"}));
  create_default_npc(20);
  SetProp(P_RACE, "Xandim");
  SetProp( P_BODY, 120 );
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,20);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  enable_commands();
  AddClass(CL_HUMAN);

  AddDetail(({"gesicht"}),
    "Sein wettergegerbtes Gesicht verleiht Khitan das Aussehen eines alten und "
    "weisen Mannes. Ein Blick in seine Augen verraet Dir aber, dass er gar nicht "
    "so alt sein kann.");
  AddDetail(({"aussehen", "bedingungen", "eindruck"}),
    "Er sieht ziemlich alt aus. Das muss aber an den rauhen Bedingungen hier "
    "liegen.");
  AddDetail(({"augen", "alter"}),
    "Seine Augen verraten sein wahres Alter.");
  AddDetail(({"blick"}),
    "Unternehmungslustig.");
  AddDetail(({"hals"}),
    "Um seinen Hals haengt eine Baerenzahnkette.");
  AddDetail(({"kette", "baerenzaehne", "baerenzaehnen", "baerenzahnkette"}),
    "Khitan funkelt Dich an. Scheinbar mag er es nicht, "
   "wenn Du der Kette zu nahe kommst.");

  AddLibrary("/d/polar/thor/xandim/npc/xandim.lib", 1);
  
  AddInfo(DEFAULT_INFO, ({"versteht nicht, was Du meinst.\n",
                          "beachtet Dich gar nicht.\n",
                          "hoert Dir nicht zu.\n"}));
  AddInfo("torian", "Torian kommt mich oft besuchen.","sagt: ");

  AddInfo( ({"huette","blockhuette"}),
    "Seit vielen Jahren schon lebe ich in dieser Huette und verkaufe Tiere.",
    "sagt: ");
  AddInfo( ({"alter"}),
    "Sowas fragt man nicht.",
    "sagt: ");
  AddInfo( ({"kasse", "registrierkasse", "abrechnen"}),
    "Die brauche ich zum Abrechnen der Tiere.",
    "sagt: ");
  AddInfo( ({"tiere", "angebot", "sortiment"}),
    "Ich habe die verschiedensten Tiere im Angebot. Schauen Sie doch einfach "
    "mal auf meiner Tafel nach.",
    "sagt: ");
  AddInfo( ({"tafel"}),
    "Die Tafel finden Sie direkt auf der Theke.",
    "sagt: ");
  AddInfo( ({"theke", "holztheke", "stueck"}),
    "Ein prachtvolles Stueck, finden Sie nicht auch?",
    "sagt: ");
  AddInfo( ({"sessel"}),
    "Der Sessel ist fuer unsere Kunden gedacht. Machen Sie es sich doch einfach "
    "darin bequem.",
    "sagt: ");
  AddInfo( ({"kunden", "kunde"}),
    "Jeder Kunde war bisher aeusserst zufrieden. Ich bin mir sicher, dass das bei "
    "Ihnen genauso sein wird.",
    "sagt: ");
  AddInfo( ({"waechter"}),
    "Die Waechter vor der Tuer bewachen die Tiere. Nicht was Sie jetzt vielleicht "
    "denken. Sie schuetzen unsere Kunden vor den Tieren. Solch ein Eisbaer oder "
    "Schneeleopard kann schon gefaehrlich werden.",
    "sagt: ");
  AddInfo( ({"tuer", "holztuer"}),
    "Immer wird sie offen gelassen.",
    "seufzt: ");
  AddInfo( ({"eisbaer"}),
    "Der Eisbaer ist das groesste und gefaehrlichste Tier, das ich verkaufe. "
    "Er eignet sich ausgezeichnet als Weggefaehrte auch auf gefaehrlicheren "
    "Wegen.",
    "sagt: ");
  AddInfo( ({"schneeleopard", "leopard"}),
    "Eines der elegantesten Tiere in meinem Sortiment. Mit diesem Tier an "
    "Ihrer Seite fallen Sie bei jeder Gelegenheit auf.",
    "sagt: ");
  AddInfo( ({"schneemaus", "katze", "geschlecht"}),
    "Die suesse Schneemaus ist besonders bei unseren jungen Kunden beliebt. "
    "Auch wenn man mit ihr keiner Katze begegnen sollte, verbessert sie das "
    "Ansehen besonders gegenueber dem weiblichen Geschlecht doch immens.",
    "sagt: ");
  AddInfo( ({"schneehase", "charme"}),
    "Der Schneehase ist aehnlich der Schneemaus eher unter den jungen Kunden "
    "verbreitet. Er verstroemt einen etwas herberen Charme, dem man sich dennoch "
    "nicht verschliessen kann.",
    "sagt: ");
  AddInfo( ({"elch"}),
    "Der treue Gefaehrte in kalten Wintertagen. Kann man sich etwas schoeneres "
    "wuenschen?",
    "sagt: ");
  AddInfo( ({"rentier"}),
    "Die beruehmten Rentiere. Ob es den Weihnachtsmann mit seinen Rentieren "
    "wirklich gibt, kann ich nicht beurteilen. Aber waere es nicht einfach "
    "traumhaft seinen eigenen Rudolph zu haben? Auf Wunsch koennen wir ihm auch "
    "gerne eine rote Nase verschaffen.",
    "sagt: ");
  AddInfo( ({"wunsch", "nase", "scherz"}),
    "Das war natuerlich nur ein Scherz! Wir wuerden nie den Tieren etwas "
    "zuleide tun.",
    "sagt: ");
  AddInfo( ({"polarwolf"}),
    "Der Polarwolf stammt aus den noerdlichen Polargebieten. Ihn kann wahrlich "
    "nichts mehr erschuettern. Er trotzt Kaelte und Hunger wie kein anderer.",
    "sagt: ");
  AddInfo( ({"schneewolf", "lieblinge", "sprungkraft", "eleganz"}),
    "Ah ... einer meiner persoenlichen Lieblinge. Er kommt in den weiter "
    "suedlich gelegenen Polargebieten vor. Seine Sprungkraft und Eleganz "
    "faszinieren mich immer wieder.",
    "sagt: ");
  AddInfo( ({"baerenzahnkette", "kette", "trophaeen"}),
    "Die Baerenzaehne sind meine Trophaeen und mein ganzer Stolz. Mein ganzes "
    "Leben lang hab ich die groessten und staerksten Baeren gejagt. ",
    "sagt: ");
  AddInfo( ({"weggefaehrte", "gefaehrte", "freude"}),
    "Jedes meiner Tiere wird Ihnen mit Freude auf jedem Ihrer Wege folgen.",
    "sagt: ");

  SetProp(P_LOG_INFO, "/torian/khitan");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER)+" sagt: Was soll ich damit?\n" }) );

  SetProp(P_SPELLRATE,30);
  
  AddSpell(6,400,
    Name(WER)+" rammt seine Faust in Deinen Magen!\n",
    Name(WER)+" rammt seine Faust in @WESSEN Magen!\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2,650,DS_SLOW,
    Name(WER)+" tritt Dir gegen Dein Knie! Du faengst an zu hinken!\n",
    Name(WER)+" tritt @WEN gegen sein Knie. @WER faengt an zu hinken!\n");

  AddSpell(1,850,
    Name(WER)+" stoesst Dich ins Feuer.\n",
    Name(WER)+" stoesst @WEN ins Feuer.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));


  SetChats(5, ({
    Name(WER)+" saeubert die Theke.\n",
    Name(WER)+" wirft ein Holzscheit ins Feuer.\n",
    Name(WER)+" fragt: Kann ich Ihnen helfen?\n"}) );
  SetAttackChats(10, ({
    Name(WER)+" verflucht Dich lautstark.\n",
    Name(WER)+" schreit Dich wuetend an.\n"}) );

  SUID;

  CLONEME("/p/armour/trousers/fellhose");
  CLONEME("/p/armour/armour/pelzjacke");
  CLONEME("/p/armour/boots/fellstiefel");
  CLONEME(ARMOUR "kette");
  command("trage alles");

}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt Khitan.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Khitan hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aergerlich":
    case "fies":
      call_out("reaction", 0, TP,
        "funkelt Dich boese an.",
        "funkelt "+TP->name(WEN)+" boese an.");
      break;
    default :
      call_out("reaction", 0, TP,
        "runzelt die Stirn.",
        "runzelt die Stirn.");
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

void init()
{
  ::init();

  if(!TP)              return;
  if(!interactive(TP)) return;

  if (find_call_out("tuercheck") != -1) return;
  
  call_out("tuercheck", 10+random(10));
}

void tuercheck()
{
  if (ENV(TO) && ENV(TO)->tueroffen())
  {
    sage("Wer hat denn schon wieder die Tuer offen gelassen!");
    command_me("schliesse tuer");
    return;
  }
  return;
}