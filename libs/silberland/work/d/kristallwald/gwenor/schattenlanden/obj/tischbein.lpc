
#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "");
  SetProp(P_LONG,
    ""
  );

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "");
  SetProp(P_NAME, "");
  SetProp(P_GENDER, MALE);
  AddId("");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

}