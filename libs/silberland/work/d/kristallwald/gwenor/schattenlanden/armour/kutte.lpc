#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Kutte");
  SetProp(P_NAME_ADJ, "weiss" );
  AddAdjective( ({ "weisse" }) );
  SetProp(P_LONG,
    "Diese weisse Kutte besteht aus einem Dir unbekannten Stoff. "
    "Typisch fuer Zauberer und Heiler.");
  SetProp(P_NAME, "Kutte");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kutte"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 14 );
  SetProp(P_MATERIAL, ([ MAT_CLOTH ]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 900);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 100);

}
