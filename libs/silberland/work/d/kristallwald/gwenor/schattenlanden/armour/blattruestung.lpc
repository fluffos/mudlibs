#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Blattruestung");
  SetProp(P_LONG,
    "Diese Ruestung besteht aus Blaettern, die fest miteinander verbunden sind. "
    "Da die Blaetter nicht schwer sind, ist auch die Ruestung ziemlich leicht "
    "und Du kannst Dich besser in ihr bewegen.");
  SetProp(P_NAME, "Blattruestung");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"ruestung", "blattruestung"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 20 );
  SetProp(P_MATERIAL, ([ MAT_MISC_HERBAL:80, MAT_SILK:20 ]) );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 100);
  AddProp(P_DAM_PROTECTION, ([DT_ACID:2]) );

}