inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Jaegerhandschuhe");
  SetProp(P_LONG, 
    "Ein Paar Jaegerhandschuhe aus Leder. Sie sind im Prinzip "
    "wie normale Lederhandschuhe, nur das die Zeige- und Mittelfinger "
    "frei bleiben, was das Spannen von Boegen erleichtert.\n");
  SetProp(P_NAME, "Jaegerhandschuhe");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"handschuhe","jaegerhandschuhe"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_GLOVE); 
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_LEATHER);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 800);

}
