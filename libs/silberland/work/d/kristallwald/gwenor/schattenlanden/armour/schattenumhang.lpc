#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if(!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Schattenumhang");
  SetProp(P_LONG,
    "Dieser Umhang ist etwas ganz Besonderes, er sieht aus wie "
    "Dein Schatten. Wenn Du ihn traegst bist Du sicher besser gegen "
    "Licht geschuetzt.\n"
    "So ein Umhang gehoert zum Standard-Inventar eines echten Waldlaeufers.\n");
  SetProp(P_NAME, "Schattenumhang");
  SetProp(P_GENDER, MALE);
  AddId( ({"umhang", "schattenumhang"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 6 );
  SetProp(P_MATERIAL, ([ MAT_SHADOW:100 ]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 100);
  AddProp(P_DAM_PROTECTION, ([DT_LIGHT:2]) );
  SetProp(P_WEAR_FUNC, this_object());
  SetProp(P_REMOVE_FUNC, this_object());
 

}

int WearFunc(object me, int silent) 
{
	if(!silent)
	write("Du huellst Dich in den Schatten.\n"
	
	);
	
  return 1;
}

int RemoveFunc(object me, int silent) 
{
	if(!silent)
	write("Du ziehst den Schatten aus und wunderst Dich ueber die Helligkeit.\n"
	
	);
	
  return 1;
}
