#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Stoffkapuze");
  SetProp(P_LONG,
    "Die Kapuze ist aus reinem Stoff gemacht. Sie huellt "
    "das Gesicht des Traegers in einen Schatten.\n"
    );
  SetProp(P_NAME, "Stoffkapuze");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kapuze", "stoffkapuze"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 8 );
  SetProp(P_MATERIAL, ([ MAT_CLOTH:100 ]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 400);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 100);

}