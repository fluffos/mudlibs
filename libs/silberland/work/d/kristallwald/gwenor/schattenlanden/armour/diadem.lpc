inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if(!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Diadem");
  SetProp(P_LONG, 
    "Ein wunderschoenes Diadem mit einem kleinen Rubin in der Mitte.");
  SetProp(P_NAME, "Diadem");
  SetProp(P_GENDER, NEUTER);
  AddId(({"diadem"}));

  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, MAT_MISC_METAL);
  SetProp(P_WEIGHT, 60);
  SetProp(P_VALUE, 1000);
}

