#include "../def.h"

inherit "std/npc";

inherit "/std/player/moneyhandler"; 

int heilung;            

string *spieler_frosch; 

void create()

{
  if (!is_clone(TO)) return;
  
  ::create();


  SetProp(P_SHORT, "Inshana, die Heilerin");
  SetProp(P_LONG,
    "Inshana, die Heilerin von Vilay-Bog. Jedoch heilt sie nicht nur, "
    "sie hat sich auch die Macht der Veraenderung angeeignet."
  );

  set_living_name("inshana");
  SetProp(P_NAME, "Inshana");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz weg");
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 175);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp( P_REJECT, ({ REJECT_DROP,
  Name(WER)+" will Deine Sachen nicht tragen.\n" }) );
  
  SetProp( P_NOATTACK, 1);
  
  AddId( ({"inshana", "heilerin"}) );
  AddClass(CL_ELF); 
  create_default_npc(18);

  AddInfo(DEFAULT_INFO, "Ich kann Dich heilen!","sagt: ");

  SetChats(3,
    ({
    	Name(WER,1)+" sagt: Soll ich Dich heilen?\n"
       ,Name(WER,1)+" pfeift munter vor sich hin.\n"
       ,Name(WER,1)+" sagt traurig: Warum will niemand von mir geheilt werden?\n"
     })
  );
  
  CLONEME (ARMOUR "kutte");
  
  CLONEME (ARMOUR "diadem");
  command ("trage alles");

  AddCmd( ({"heile","heil"})                , "cmd_heilen");
  AddCmd( ({"verfrosch","verfrosche"})      , "cmd_verfroschen");
  AddCmd( ({"entfrosch","entfrosche"})      , "cmd_entfroschen");

  heilung = 2; 

  spieler_frosch = ({ }); 
}

void init()
{
  ::init();


  if(TP && interactive(TP)) call_out("init_hallo",0,TP);
}

void init_hallo(object player)
{
  if(!player)                return;
  if(!interactive(player))   return;
  if(ENV(player) != ENV(TO)) return;

  tell_room(ENV(TO),break_string(
    "Hallo "+TP->name()+", falls Du hier bist, um Dich von mir "
    "heilen zu lassen, so sage \"heile mich\", auch entfroschen "
    "kann ich Dich, wenn Du sagst \"entfrosche mich\", allerdings "
    "kann ich Dich auch zum Frosch machen, wenn Du es wuenscht "
    "sag einfach \"verfrosche mich\"."
    
    ,78,Name(WER,1)+" sagt: ",1));
}

void reset()
{
  ::reset();

  heilung++;
  if(heilung > 2) heilung = 2; 

  spieler_frosch = ({ });
}



int cmd_heilen(string str)
{
  notify_fail("Zum Heilen \"heile mich\" eingeben!\n");

  if(!str || str == "") return 0;
  if(!(str == "mich"))  return 0;



  if(heilung <= 0)
  {
    tell_object(TP, "Inshana's heilenden Kraefte muessen sich erst "
                    "regenerieren.\n");

    return -1; 
  }


  if(TP->QueryProp(P_MAX_HP) == TP->QueryProp(P_HP))
  {
    tell_object(TP,"Du brauchst doch gar keine Heilung!\n");
    return -1;
  }

  tell_object(TP,"Inshana legt ihre heilenden Haende auf Deine Stirn und Deinen Bauch.\n");
  TP->AddHp(20);
  heilung--;
  
  tell_room(MENV, BS(TPN+ " sieht dank Inshana's Heilkunst viel besser aus.\n"), ({TP}));

  return 1;
}



int cmd_verfroschen(string str)

{
  notify_fail("Wen moechtest Du verfroschen?\n");

  if(!str || str == "") return 0;
  if(!(str == "mich" )) return 0;



  if(TP->QueryProp(P_FROG))
  {
    tell_object(TP,"Aber Du bist doch bereits ein Frosch!\n");
    return -1;
  }


  if(member(spieler_frosch,getuuid(TP)) != -1)
  
{
    tell_object(TP,"Du kannst Dich im Augenblick nicht verfroschen.\n");
    return -1;
    
}



  TP->SetProp(P_FROG, 1); 
  spieler_frosch += ({ getuuid(TP) }); 

  tell_object(TP,"Inshana sieht Dich grinsend an und sagt: Awao! "
                 "Du bist auf einmal ein Frosch!\n");
  tell_room(TO, BS("Inshana hat gerade @WEN in einen Frosch verwandelt.\n"), ({TP}));

  return 1;
  
}


int cmd_entfroschen(string str)

{
  notify_fail("Wen moechtest Du entfroschen?\n");

  if(!str || str == "") return 0;
  if(!(str == "mich" )) return 0;


  if(TP->QueryMoney() < 650) 
                             
                             
   return -1;


  TP->SetProp(P_FROG, 0);          
  TP->AddMoney(-650);               


  "p/daemon/zentralbank"->PayIn(650, 100);

  tell_object(TP,"Inshana sieht Dich an und sagt: San!\n"
                 "Endlich bist Du wieder Du selbst.\n");
  tell_room(TO, BS("Inshana hat gerade @WEN zurueckverwandelt."), ({TP}));
  return 1;
}
