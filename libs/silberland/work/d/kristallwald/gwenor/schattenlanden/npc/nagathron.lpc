
#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells.lpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Nagathron, der Magie-Lehrling");
  SetProp(P_LONG,
   "Du stehst vor Nagathron, dem Magie-Lehrling von Ratakron. Er ist ein "
   "ziemlich kleiner Mensch, was aber nicht bedeuten soll, dass er nicht "
   "kaempfen kann. Er sieht ziemlich hinterlistig aus.\n"
  );

  SetProp( P_NAME, "Nagathron" );
  set_living_name("nagahtron");
  SetProp( P_GENDER, MALE );
  SetProp( P_ARTICLE, 0);
  AddId( ({ "mensch","nagathron","lehrling","magie-lehrling", "Messerkaempfer" }) );

  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN: -5, T_RANGE_MAX:30]) );

  create_default_npc(13);

  SetProp( P_HANDS, ({ " mit seinen Haenden", 100 }) );

  SetProp( P_RACE, "Mensch" );
  AddClass( ({CL_HUMAN}) );

  SetProp(P_SIZE, 150+random(10) );
  SetProp(P_ALIGN, -400 );
  SetProp(P_MAX_HANDS, 2 );
  SetProp(P_SPELLRATE, 60);
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Nagathron interessiert sich nicht fuer @WEN.\n" }) );

  SetProp(P_MMSGIN, "kommt herein" );
  SetProp(P_MMSGOUT, "nimmt seinen Dolch und schneidet ein Portal in die Luft." );
  SetProp( P_DIE_MSG, " wird wohl nie Meister werden.\n" );
  SetProp( P_KILL_NAME, "Nagathron, der Lehrling" );

  AddInfo( DEFAULT_INFO,
    ({"beachtet Dich gar nicht.\n"
     ,"fuchtelt mit seinem Dolch herum.\n"
     ,"versucht sich im Zauber versagt aber.\n"}) );
     


   SUID;
   CLONEME( ARMOUR "kutte" );
   command("trage alles");
  
  if( !random(20))
  {
  	CLONEME( WEAPON "magiedolch");
  	command( "zuecke dolch" );
  }
  
  else
  {
  	   CLONEME("/p/weapon/knife/obsidiandolch");
           command_me("zuecke dolch");
  }

   
  AddDefaultSpell(1, 1, DS_FROG);
  AddSpell(6, 300, 
  "Nagathron schliesst die Augen und laesst einen Kreis aus Feuer um Dich entstehen.\n",
  "Nagathron schliesst die Augen und laesst einen Kreis aus Feuer um @WEN entstehen.\n",
  ({DT_FIRE,DT_MAGIC}), ([SP_SHOW_DAMAGE: 1]) );
  
  AddSpell(4,500,
  "Nagathron konzentriert sich und schleudert Dich gegen ein Buecherregal.\n",
  "Nagathron konzentrietz sich und schleudert @WEN gegen ein Buecherregal.\n",
  ({DT_MIND,DT_MAGIC}), ([SP_SHOW_DAMAGE: 1]) );
}

