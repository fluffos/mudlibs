
#include "../def.h"

inherit "std/npc";
inherit "std/npc/spells.lpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Ataron, der Anfuehrer von Vilay-Bog");
  SetProp(P_LONG,
   "Du stehst vor Ataron, dem Anfuehrer der Waldlaeufer.\n"
   "Er ist ein duerrer, recht grosser Mensch. Sein Gesicht ist von Narben und "
   "Wunden uebersaet. Er muss schon einige Kaempfe bestritten haben. "
   "Durch seine Kampferfahrung ist er sicher kein leichter Gegner."
  );

  AddDetail( ({ "gesicht", "narben", "wunden", "wunde", "narbe" }),
    "Sein Gesicht ist voll von Wunden und Narben. Wahrscheinlich hat er sie "
    "von schweren Schlachten davongetragen."
  );

  AddDetail( ({ "kampf", "kampferfahrung", "erfahrung" }),
    "Ataron muss schon sehr viele Kaempfe gewonnen haben und ist sicher "
    "ein schwerer Gegner fuer Dich."
  );

  SetProp( P_NAME, "Ataron" );
  SetProp( P_GENDER, MALE );
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN: -5, T_RANGE_MAX:30]) );
  AddId( ({ "ataron", "anfuehrer" }) );

  create_default_npc(35);

  SetProp( P_HANDS, ({ " mit der Kraft des Waldes", 300 }) );
  SetProp( P_RACE, "Mensch" );

  AddClass( ({CL_HUMAN}) );

  SetProp(P_SIZE, 185+random(30) );
  SetProp(P_ALIGN, 200 );
  SetProp(P_MAX_HANDS, 2 );
  SetProp(P_ARTICLE, 0);
  SetProp(P_SPELLRATE, 90);
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Ataron ist an @WEM nicht interessiert.\n" }) );
  SetProp(P_MMSGIN, "tritt aus einem Schatten herein" );
  SetProp(P_MMSGOUT, "verschwindet in die Schatten" );
  SetProp( P_DIE_MSG, " faellt tot zu Boden.\n" );
  SetProp( P_KILL_NAME, "Ataron" );

  AddInfo( DEFAULT_INFO,
    ({"beachtet Dich gar nicht.\n"
     ,"hat an Dir nicht das geringste Interesse.\n"
     ,"guckt Dich kurz mit einem dummen Blick an.\n"}));
     
  AddDefender("wache");

  SetChats( 3,
    ({"Ataron kuemmert sich um seine Kraeuter.\n"
     ,"Ataron beugt sich ueber die Karte.\n"
     ,"Ataron scheint zu meditieren.\n"
     })
  );

  SetAttackChats( 3,
    ({"Ataron taucht ploetzlich aus einem Schatten hinter Dir auf.\n"
     ,"Ataron schreit Dich voller Kampfeslust an.\n"
     })
  );
  
  SUID;
  CLONEME (ARMOUR "schattenumhang");
  
  if(random (2))
  CLONEME (ARMOUR "kapuze");
 
  CLONEME (ARMOUR "blattruestung");
  
  if(random (2))
  CLONEME ("/p/armour/boots/lederstiefel");
  
  if(random (1))
  CLONEME (ARMOUR "jaegerhandschuhe");
  
  CLONEME("/p/armour/trousers/lederbeinschienen");
  command ("trage alles");
  
  
  
  if( !random(10))
  {
   CLONEME( WEAPON "schattenruf");
   command("zuecke schwert");
  }
  {
        AddDefaultSpell(3, 1, DS_SLOW,
        "Ataron huellt Dich in Weihrauch.\n",
        "Ataron huellt @WEN in Weihrauch.\n");
        
        AddSpell(6, 100, 
        "Ataron schleudert einen grellen Blitz auf Dich zu.\n",
        "Ataron schleudert einen grellen Blitz auf @WEN.\n",
        ({DT_LIGHTNING,DT_MAGIC}), "blind", ([SP_SHOW_DAMAGE:1]));
        
        AddDefaultSpell(4, 1, DS_PARALYZE,
        "Ataron beruehrt den Boden. Ein paar Ranken halten Dich am Boden fest.\n",
        "Ataron beruehrt den Boden. Ein paar Ranken halten @WEN fest.\n");
        
        AddSpell(6, 500,
        "Ataron beschwoert die arktischen Winde um Dich.\n",
        "Ataron beschwoert die arktischen Winde um @WEN.\n",
        ({DT_COLD,DT_MAGIC}), ([SP_SHOW_DAMAGE:1]));
        
        AddSpell(8, 700,
        "Ataron laesst Dich die Kraefte des Waldes spueren.\n",
        "Ataron laesst @WEN die Krafte des Waldes spueren.\n",
        ({DT_MIND,DT_MAGIC}), ([SP_SHOW_DAMAGE:1]));
  }
}
        
  
void blind(object enemy, int damage, mixed dam_type) 
{
       enemy->SetProp(P_BLIND, 1+random(2));
}

     init()
     {
       ::init();
       if (TP && TP->id("waechter")) AddDefender(TP);
     }

     void InformDefend(object enemy)
     {
       Kill(enemy);
     }
      

