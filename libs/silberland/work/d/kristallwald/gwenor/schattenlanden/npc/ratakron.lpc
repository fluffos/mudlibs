
#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells.lpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Ratakron, der Wahrsager");
  SetProp(P_LONG,
   "Du stehst vor Ratakron, einem ziemlich schmaechtigen und alten "
   "Troll. In seiner Jugend war er ein Kraftprotz, aber als er aelter "
   "wurde, studierte er die Wahrsagerei und Zauberei. Jetzt ist er ein Meister "
   "seines Faches.\n"
  );

  SetProp( P_NAME, "Ratakron" );
  set_living_name("ratakron");
  SetProp( P_GENDER, MALE );
  SetProp( P_ARTICLE, 0);
  AddId( ({ "troll","ratakron","wahrsager", "Keulenmeister" }) );

  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN: -5, T_RANGE_MAX:30]) );

  create_default_npc(25);

  SetProp( P_HANDS, ({ " mit seinen Haenden", 200 }) );
  SetProp(P_SPELLRATE, 30);

  SetProp( P_RACE, "Troll" );
  AddClass( ({CL_TROLL}) );

  SetProp(P_SIZE, 290+random(40) );
  SetProp(P_ALIGN, 600 );
  SetProp(P_MAX_HANDS, 2 );
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Ratakron interessiert sich nicht fuer @WEN.\n" }) );

  SetProp(P_MMSGIN, "kommt herein" );
  SetProp(P_MMSGOUT, "oeffnet ein Tor der Zeit und geht hinein" );
  SetProp( P_DIE_MSG, " wird wohl doch nicht an Altersschwaeche sterben.\n" );
  SetProp( P_KILL_NAME, "Ratakron, der Weise" );

  AddInfo( DEFAULT_INFO,
    ({"beachtet Dich gar nicht.\n"
     ,"studiert einige Buecher.\n"
     ,"murmelt nur so in die Gegend.\n"}) );

  SetChats( 3,
    ({"Ratakron fluestert Dir zu: Hilf mir bitte. Mein Schueler will mich umbringen, glaube ich.\n"
     ,"Ratakron fluestert Dir zu: Du musst mir helfen.\n"}) );

  SetAttackChats( 3,
    ({"Ratakron stuetzt sich auf seinen Stab.\n"
     ,"Ratakron spricht einen Fluch auf Dich.\n"}) );
     
   CLONEME( ARMOUR "kutte" );
   command("trage alles");
  
   CLONEME("/p/weapon/club/wanderstab");
   command("zuecke stab");
   
  AddDefaultSpell(1, 1, DS_FROG);
  AddSpell(4, 500, 
  "Ratakron schliesst die Augen und laesst einen Kreis aus Feuer um Dich entstehen.\n",
  "Ratakron schliesst die Augen und laesst einen Kreis aus Feuer um @WEN entstehen.\n",
  ({DT_FIRE,DT_MAGIC}), ([SP_SHOW_DAMAGE: 1]) );
  
  AddSpell(2,700,
  "Ratakron konzentriert sich und schleudert Dich gegen ein Buecherregal.\n",
  "Ratakron konzentrietz sich und schleudert @WEN gegen ein Buecherregal.\n",
  ({DT_MIND,DT_MAGIC}), ([SP_SHOW_DAMAGE: 1]) );
}

