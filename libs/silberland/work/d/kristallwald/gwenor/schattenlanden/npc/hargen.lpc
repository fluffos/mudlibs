#include "../def.h"

inherit "std/npc";


void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Hargen, der Ladenbesitzer");
  SetProp(P_LONG,
    "Hargen ist der Ladenbesitzer hier in Vilay-Bog und auch wenn er "
    "kein Waldlaeufer ist wird er hier gerne gesehen. Bis jetzt hast "
    "Du auch sonst noch keinen Oger hier gesehen. Du fragst Dich warum "
    "er nicht wie die Anderen im Wald lebt oder als Berserker Abenteuer "
    "erlebt. Hargen ist immer bemueht, den Wuenschen seiner Kunden folge "
    "zu leisten.\n"
  );

  set_living_name("hargen");
  SetProp(P_NAME, "Hargen");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));

  AddId( ({"hargen","ladenbesitzer"}) );
  AddClass(CL_OGRE);

  create_default_npc(18);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Oger");
  SetProp(P_SIZE, 250);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz weg");

  AddInfo(DEFAULT_INFO, "Was darf es sein?","fragt Dich: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" will Deine Sachen nicht tragen.\n" }) );
    
  SetAttackChats(10,
    ({Name(WER,1)+" zuernt: Dich zerquetsch ich doch, Du Wurm!\n"
     })
  );
  
  CLONEME ("/p/armour/trousers/fellhose");
  
  if(random (2))
  CLONEME ("/p/armour/armour/seidenjacke");
  
  CLONEME ("/p/armour/boots/lederschuhe");
  
  CLONEME ("/p/armour/cloak/lederschuerze");
  command ("trage alles");
}
