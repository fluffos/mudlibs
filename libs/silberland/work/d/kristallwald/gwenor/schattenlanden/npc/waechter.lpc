
#include "../def.h"

inherit "std/npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Ein Waechter");
  SetProp(P_LONG,
   "Das ist die Leibgarde Ataron's. Sie wurden von Ataron "
   "persoenlich ausgewaehlt und ausgebildet. Sobald Ataron "
   "Hilfe braucht, werden sie zur Hilfe eilen. Sie stehen zwar "
   "jetzt noch still und sehen aus wie Statuen aber wenn "
   "Du versuchst Ataron zu atackieren werden sie zeigen was Ataron "
   "ihnen beigebracht hat. Also huete dich lieber."
  );
  
  set_living_name("ataronwaechter");
  SetProp( P_NAME, "Waechter" );
  SetProp( P_GENDER, MALE );
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN: -5, T_RANGE_MAX:30]) );
  SetProp( P_DEFENDERS, "ataron", "waechter");
  AddId( ({ "waechter","wache", "waldlaeufer" }) );

  create_default_npc(20);

  SetProp( P_HANDS, ({ " mit seinen Haenden", 100 }) );
  SetProp( P_RACE, "Elf" );
  AddClass( ({CL_ELF}) );

  SetProp(P_SIZE, 180+random(30) );
  SetProp(P_ALIGN, 700 );
  SetProp(P_MAX_HANDS, 2 );
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Waechter ist nur auf seinen Schuetzling konzentriert.\n" }) );

  SetProp(P_MMSGIN, "kommt herein" );
  SetProp(P_MMSGOUT, "geht" );
  SetProp( P_DIE_MSG, " hat versagt.\n" );
  SetProp( P_KILL_NAME, "Leibgarde Ataron's" );

  AddInfo( DEFAULT_INFO,
    ({"beachtet Dich gar nicht.\n"
     ,"konzentriert sich auf Ataron.\n"
     ,"ruehrt sich nicht.\n"}));
     



  SetAttackChats( 3,
    ({"Ich werde nicht versagen!.\n"
     ,"Der Waechter schmeisst sich vor Ataron.\n"
     })
  );
  
  SUID;
  CLONEME (ARMOUR "schattenumhang");
  
  CLONEME ("/d/kristallwald/muaddib/weg/armour/waldruestung");
  
  CLONEME (WEAPON "jaegerbogen");
  command ("zuecke bogen");
  
  CLONEME (ARMOUR "jaegerhandschuhe");
  command ("trage alles");
}

void init()
{
  ::init();
  if (TP && (TP->id("waechter") || TP->id("ataron"))) 
    AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}
