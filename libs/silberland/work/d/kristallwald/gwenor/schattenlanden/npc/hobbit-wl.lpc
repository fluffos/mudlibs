#include "../def.h"

inherit "std/mnpc"; 
                   

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Hobbit-Waldlaeufer");
  SetProp(P_LONG,
    "Du stehst vor einem ziemlich kleinen Hobbit. Er ist "
    "in einen Umhang gehuellt. Er gehört den Waldlaeufern an "
    "und lebt hier in Vilay-Bog.\n"
  );

  SetProp(P_NAME, "Hobbit-Waldlaeufer");
  set_living_name("hobbitwaldlaeufer");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-5, T_RANGE_MAX:30]) );

  AddId( ({ "waldlaeufer","hobbit", "hobbitwaldlaeufer" }) );
  set_living_name("hobbitwaldlaeufer");

  create_default_npc(18);
  SetProp(P_HANDS, ({ " mit seinen Haenden", 150, DT_BLUDGEON }) );
  SetProp(P_RACE, "Hobbit" );
  AddClass(CL_HOBBIT);
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Hobbit bedankt sich bei Dir mit einer anmutigen Verbeugung.\n" }) );
  SetProp(P_MSGIN, "kommt aus einem Schatten herein.");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "taucht aus einem Schatten hinter Dir auf");
  SetProp(P_MMSGOUT, "verschwindet in die Waelder");

  SetProp(P_MNPC_AREA, ({ ROOM "ws4", ROOM "ws5",
                          ROOM "ws8", ROOM "ws9",
                          ROOM "ws13", ROOM "ws14",  }) );

  SetProp(P_MNPC_WAIT, ({ 15, 20, 20 }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "ws9");
  SetProp(P_MNPC_FLAGS, MOV_BACKWARDS|MOV_MOVES|MOV_OUTDOORS);

  SetProp(P_DIE_MSG, " wird nie wieder durch den Wald laufen.\n");

  AddInfo(DEFAULT_INFO, " beachtet Dich gar nicht.\n" );

  AddInfo( ({ "ataron" }),
    "Ataron ist unser Anfuehrer. Leg Dich lieber nicht mit ihm an, er ist sehr maechtig.",
    "antwortet Dir: " );

  AddInfo( ({ "gwenor" }),
    "Gwenor hat mich erschaffen. Sie ist die Beste!",
    "antwortet Dir; ");

  SetChats( 2, ({
    "Der Hobbit-Waldlaeufer schaut sich hier ein wenig um.\n",}) );

  SetAttackChats( 4, ({
    "Der Hobbit-Waldlaeufer taucht aus einem Schatten hinter Dir auf.\n",}) );

    CLONEME(WEAPON "jaegerbogen");
    CLONEME(ARMOUR "schattenumhang");

  command("trage alles");
  command("zueck bogen");
}









