#include "../def.h"

inherit "std/mnpc"; 

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  switch(random(2))
  {
    case 0: 
      SetProp(P_NAME, "Waldlaeufer");
      SetProp(P_GENDER, MALE);
      AddId(({"waldlaeufer"}));
      SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-5, T_RANGE_MAX:30]) );
      
      create_default_npc(20);
      SetProp(P_HANDS, ({ " mit seinen Haenden", 150, DT_BLUDGEON }) );
      SetProp(P_ALIGN, -200);
      SetProp(P_MAX_HANDS, 2);
      SetProp(P_WIMPY, 0);
      SetProp(P_DIE_MSG, " wird nie wieder durch den Wald laufen.\n");
      
      AddInfo(DEFAULT_INFO, " beachtet Dich gar nicht.\n" );
      
      AddInfo( ({ "ataron" }),
      "Ataron ist unser Anfuehrer. Leg Dich lieber nicht mit ihm an, er ist sehr maechtig.",
      "antwortet Dir: " );

      AddInfo( ({ "gwenor" }),
      "Gwenor hat mich erschaffen. Sie ist die Beste!",
      "antwortet Dir; ");
    
      SetProp(P_MSGIN, "kommt aus einem Schatten herein.");
      SetProp(P_MSGOUT, "verschwindet");
      SetProp(P_MMSGIN, "taucht aus einem Schatten hinter Dir auf");
      SetProp(P_MMSGOUT, "verschwindet in die Waelder");
      
      SetChats( 2, ({
        Name(WER,1) + " schaut sich hier ein wenig um.\n",}) );

      SetAttackChats( 4, ({
        Name(WER,1) + " taucht aus einem Schatten hinter Dir auf.\n",}) );
      break;
    case 1: 
      SetProp(P_NAME, "Waldlaeuferin");
      SetProp(P_GENDER, FEMALE);
      AddId(({"waldlaeuferin"}));
      SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-5, T_RANGE_MAX:30]) );
      
      create_default_npc(18);
      SetProp(P_HANDS, ({ " mit ihren Haenden", 150, DT_BLUDGEON }) );
      SetProp(P_ALIGN, -200);
      SetProp(P_MAX_HANDS, 2);
      SetProp(P_WIMPY, 0);
      SetProp(P_DIE_MSG, " wird nie wieder durch den Wald laufen.\n");
      
      AddInfo(DEFAULT_INFO, " beachtet Dich gar nicht.\n" );
      
      AddInfo( ({ "ataron" }),
      "Ataron ist unser Anfuehrer. Leg Dich lieber nicht mit ihm an, er ist sehr maechtig.",
      "antwortet Dir: " );

      AddInfo( ({ "gwenor" }),
      "Gwenor hat mich erschaffen. Sie ist die Beste!",
      "antwortet Dir; ");
      
      SetProp(P_MSGIN, "kommt aus einem Schatten herein.");
      SetProp(P_MSGOUT, "verschwindet");
      SetProp(P_MMSGIN, "taucht aus einem Schatten hinter Dir auf");
      SetProp(P_MMSGOUT, "verschwindet in die Waelder");
      
      SetChats( 2, ({
        Name(WER,1) + " schaut sich hier ein wenig um.\n",}) );

      SetAttackChats( 4, ({
        Name(WER,1) + " taucht aus einem Schatten hinter Dir auf.\n",}) );
      break;
  }
  switch(random(100))
  {
    case 0..25:
      SetProp(P_RACE, "Elf" );
      SetProp(P_SIZE, 180 + random(30));
      SetProp(P_NAME_ADJ, "elfisch");
      AddId(({"", "elf", "elfe"})[QueryProp(P_GENDER)]);
      
      CLONEME(WEAPON "jaegerbogen");
      CLONEME(ARMOUR "schattenumhang");
      command("trage alles");
      command("zuecke bogen");
      break;
    case 26..45:
      SetProp(P_RACE, "Fee" );
      SetProp(P_SIZE, 60 + random(10));
      SetProp(P_NAME, "Feenwaldlaeuferin");
      SetProp(P_GENDER, FEMALE);
      AddId(({"fee", "waldlaeuferin", "feenwaldlaeuferin"}));
      
      CLONEME(WEAPON "jaegerbogen");
      CLONEME(ARMOUR "schattenumhang");
      command("trage alles");
      command("zuecke bogen");
      break;
    case 46..55:
      SetProp(P_RACE, "Hobbit" );
      SetProp(P_SIZE, 80 + random(20));
      //SetProp(P_NAME_ADJ, "hobbitig");
      if(QueryProp(P_GENDER)==FEMALE)
	SetProp(P_NAME, "Hobbitwaldlaeuferin");
      else
	SetProp(P_NAME, "Hobbitwaldlaeufer");

      AddId(({"hobbit", "waldlaeuferin", "hobbitwaldlaeuferin",
			      "hobbitwaldlaeufer" }) );
      
      CLONEME(WEAPON "jaegerbogen");
      CLONEME(ARMOUR "schattenumhang");
      command("trage alles");
      command("zuecke bogen");
      break;
    case 56..75:
      SetProp(P_RACE, "Mensch" );
      SetProp(P_SIZE, 160 + random(30));
      SetProp(P_NAME_ADJ, "menschlich");
      AddId("mensch");
      
      CLONEME(WEAPON "jaegerbogen");
      CLONEME(ARMOUR "schattenumhang");
      command("trage alles");
      command("zuecke bogen");
      break;
    case 76..85:
      SetProp(P_RACE, "Zwerg" );
      SetProp(P_SIZE, 120 + random(10));
      SetProp(P_NAME_ADJ, "zwergisch");
      AddId(({"", "zwerg", "zwergin"})[QueryProp(P_GENDER)]);
      
      CLONEME(WEAPON "jaegerbogen");
      CLONEME(ARMOUR "schattenumhang");
      command("trage alles");
      command("zuecke bogen");
      break;
    case 86..99:
      SetProp(P_RACE, "Dunkelelf" );
      SetProp(P_SIZE, 170 + random(30));
      SetProp(P_NAME_ADJ, "dunkelelfisch");
      AddId(({"", "dunkelelf", "dunkelelfe"})[QueryProp(P_GENDER)]);
      
      CLONEME(WEAPON "jaegerbogen");
      CLONEME(ARMOUR "schattenumhang");
      command("trage alles");
      command("zuecke bogen");
      break;
  }
  SetProp(P_SHORT, Name(WER,0) + " bewacht das Versteck");
  SetProp(P_LONG, 
      Name(WER,1) + " gehoert der Rasse " + QueryProp(P_RACE) + " an "
      "und bewacht das Versteck.");
}

public void init() {
  ::init();

  if(CHECK_WLTASK(TP) && !TP->QueryProp("ranger_quest_recognized")) {
    call_out("recognize", 0, TP);
  }
}

public void recognize(object who) {
  if(!present(TP, ENV(TO))) return; // spieler weg
  
  tell_object(who, BS("Du versuchst einen Blick unter die Kapuze des Waldlaeufers zu erhaschen."));
  if(random(4)) {
    tell_object(who, BS("Er kommt dir nicht bekannt vor. Das ist nicht das Narbengesicht, das du auf Hypros gesehen hast."));
    return;
  }

  tell_object(who, BS("Moment mal! Das ist doch das Narbengesicht, das du auf Hypros gesehen hast. Im selben Moment scheint "
                      "der Waldlaeufer dich auch zu erkennen und bekommt grosse Augen."));
  tell_room(ENV(TO), BS(who->Name(WER, 1)+" und der Waldaeufer scheinen sich zu erkennen."));
  call_out("flee", 2, who);
  return;
}

public void flee(object who) {
  if(!present(TP, ENV(TO))) return; // spieler weg
  tell_object(who, BS("Der Waldlaeufer ergreift die Flucht vor dir. Schnell! Ihm nach!"));
  tell_room(ENV(TO), BS("Der Waldlaeufer ergreift die Flucht vor "+who->name(WEM)));
  who->SetProp("ranger_quest_recognized", 1);
  remove(1);
  return;
}
