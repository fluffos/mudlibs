#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein vermummter Waldlaeufer");
  SetProp(P_LONG,
    "Die narbengesichtige Gestalt ist vollstaendig vermummt. Dieser Waldlaeufer "
    "ist ein Abtruenniger, der irgendwelche schaurigen Dinge plant!");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Waldlaeufer");
  SetProp(P_GENDER, MALE);
  AddId(({"waldlaeufer"}));
  AddClass( ({CL_HUMAN}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(20);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 175);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

    //--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Immerhin habe ich meinem Meister Zeit verschafft!");
  SetProp(P_KILL_MSG, "Niemand kann das Omegatherion aufhalten!");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 0);

  clone_object("/p/weapon/bow/langbogen")->move(TO);
    command("zuecke bogen");

  clone_object("/p/armour/cloak/umhang")->move(TO);
  command("zieh alles an");

  call_out("get_ready", 0);

  SetProp(P_SPELLRATE, 25);
  AddSpell(3, 300, 
    Name(WER) + " zielt mit einem raschen Schuss auf Dich.\n",
    Name(WER) + " zielt mit einem raschen Schuss auf @WEN.\n", 
    DT_PIERCE, ([SP_SHOW_DAMAGE: 1]));

  AddDefaultSpell(2, 250, DS_PARALYZE,
    Name(WER) + " tritt Dich kraeftig.\n",
    Name(WER) + " tritt @WEN kraeftig.\n", 
    DT_SQUEEZE, 1);
}

