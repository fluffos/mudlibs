#include "../def.h"

inherit "std/npc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Maraken, der Wirt");
  SetProp(P_LONG,
      "Maraken ist ein eher kleiner Ork, und deswegen wahrscheinlich "
      "auch nicht wie so viele andere Orks Krieger oder Gladiator, "
      "sondern Wirt. Auch wenn er nicht sehr gross ist, ist er sicher "
      "durch seine Wendigkeit und Schnelligkeit ein stattlicher Gegner.");

  set_living_name("maraken");
  SetProp(P_NAME, "Maraken");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));
  
  AddId( ({"maraken", "ork", "wirt"}) );
  AddClass(CL_ORC);

  create_default_npc(18);
  
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Ork");
  SetProp(P_SIZE, 170);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz weg");

  AddInfo(DEFAULT_INFO, "Was willst Du Kuemmerling? Ein Bier?","fragt Dich: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" will Deine Sachen nicht tragen.\n" }) );
  SetAttackChats(10,
     ({Name(WER,1)+" zuernt: Es kommt nicht auf die Groesse des Hammers an, "
                   "sondern wie man ihn schwingt!\n"
     })
  );
  
  CLONEME (WEAPON "krug" );
  command ("zuecke krug" );
  
}
