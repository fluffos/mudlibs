#include "../def.h"

inherit "std/npc";
inherit "std/npc/spells.lpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Ein Beerengeist");
  SetProp(P_LONG,
   "Du stehst zitternd vor dem kleinen rosa Geist und hoffst, dass er Dir nichts antut. "
   "Er ist fast durchsichtig und schimmert leicht Rosa. In seinen Augen siehst Du, dass "
   "er selbst keine Ahnung hat was er hier soll."
  );

  SetProp( P_NAME, "Beerengeist" );
  set_living_name("beerengeist");
  SetProp( P_GENDER, MALE );
  SetProp(P_ARTICLE, 1);
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN: -5, T_RANGE_MAX:30]) );
  AddId( ({ "beerengeist", "geist" }) );

  create_default_npc(5);

  SetProp( P_HANDS, ({ " mit seiner Dummheit", 100 }) );
  SetProp( P_RACE, "Geist" );

  AddClass( ({CL_UNDEAD}) );

  SetProp(P_SIZE, 100+random(10) );
  SetProp(P_ALIGN, 0 );
  SetProp(P_MAX_HANDS, 2 );

  SetProp(P_SPELLRATE, 90);
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Geist ist an @WEM nicht interessiert.\n" }) );
  SetProp(P_MMSGIN, "kommt dumm-schauend herein" );
  SetProp(P_MMSGOUT, "geht dumm-schauend weg" );
  SetProp( P_DIE_MSG, " geht zurueck in seine Beere.\n" );
  SetProp( P_KILL_NAME, "Ein Beerengeist" );

  AddInfo( DEFAULT_INFO,
    ({"beachtet Dich gar nicht.\n"
     ,"versteht Dich nicht.\n"
     ,"guckt Dich kurz mit einem dummen Blick an.\n"}));
     

  SetChats( 3,
    ({"Der Geist spuckt herum.\n"
     ,"Der Geist haut sich auf den Kopf.\n"
     ,"Der Geist schaut Dich unwissend an.\n"
     })
  );

  SetAttackChats( 3,
    ({"Der Geist faengt ploetzlich an zu weinen.\n"
     ,"Der Geist ist zu dumm, um Dich zu treffen, und schlaegt sich selbst.\n"
     })
  );

}


      

