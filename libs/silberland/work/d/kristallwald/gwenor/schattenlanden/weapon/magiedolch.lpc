#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein Magiedolch");
  SetProp(P_LONG,
    "Bis auf den Griff ist der Dolch aus Glas gefertigt. "
    "Im Inneren erkennst Du, wie sich kleine Magie-Funken entladen."
  );

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Magiedolch");
  AddId( ({"magiedolch", "dolch"}) );

  SetProp(P_ARTICLE, 1);

  SetProp(P_VALUE, 4000);
  SetProp(P_WEIGHT, 700);
  SetProp(P_MATERIAL, ([ MAT_GLASS:70, MAT_MISC_WOOD:20, MAT_MISC_MAGIC:10 ]) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE);

  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_MAGIC}) );
  SetProp(P_WC, 60);
  SetProp(P_WC_FIX, 60);
  SetProp(P_M_ATTR_MOD,([A_INT:1]));

  SetProp(P_WC_BONUS, (["\nnagathron": 70]) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER:1]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_MAGIC, 1);

  SetProp(P_WIELD_FUNC, this_object());
  SetProp(P_UNWIELD_FUNC, this_object());
}


int WieldFunc(object waffe, int silent)
{
  if( !silent )
    write("Du siehst wie die Funken im Dolch schneller werden.\n");
  return 1;
}


int UnwieldFunc(object waffe, int silent)
{
  if( !silent )
    tell_object(QueryProp(P_WIELDED),
        "Die Funken im Dolch werden wieder langsamer.\n");
  return 1;
}


