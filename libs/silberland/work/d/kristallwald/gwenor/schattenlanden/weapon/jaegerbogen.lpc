#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein Jaegerbogen");
  SetProp(P_LONG,
    "Ein wunderschoen verzierter Jaegerbogen. Wahrscheinlich die perfekte Jagdwaffe."
  );

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Jaegerbogen");
  AddId( ({"jaegerbogen", "bogen"}) );

  SetProp(P_ARTICLE, 1);

  SetProp(P_VALUE, 1500);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_MATERIAL, ([ MAT_TICTOC_WOOD:100 ]) );

  SetProp(P_WEAPON_TYPE, WT_BOW);

  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_PIERCE}) );
  SetProp(P_WC, 100);
  SetProp(P_WC_FIX, 70);
  SetProp(P_WC_BONUS, (["waldlaeufer": 100, "waldlaeuferin": 80]) );
  
  SetProp(P_NR_HANDS, 2);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER:0]) );


}


