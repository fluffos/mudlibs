
#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Tischbein");
  SetProp(P_LONG,
    "Dieses Tischbein kannst Du sicher gut als Knueppel verwenden. "
    "Damit kannst Du zwar niemanden toeten aber sicher verletzen."
    "Es besteht aus reinster Eiche."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Tischbein");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"tischbein", "bein"}) );


//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_OAK );
  SetProp(P_WEIGHT, 80000);
  SetProp(P_VALUE, 50);
  SetProp(P_NOBUY, 1);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 60);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);

//--Details----------------------------------------------------------------

  SetProp(P_INFO, BS("Dieses einfache Tischbein wird kaum Schaden anrichten. "
                     "Es besteht aus Eiche."));
}
