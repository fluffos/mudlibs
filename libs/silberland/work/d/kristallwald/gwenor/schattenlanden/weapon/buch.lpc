#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Buch");
  SetProp(P_LONG,
    "Du haelst ein Buch in den Haenden, auf dem Einband "
    "steht \"Der Weg zum Meister\". Wenn Du mehr als den "
    "Einband lesen willst, oeffne das Buch einfach." );
  SetProp(P_NAME, "Buch");
  SetProp(P_GENDER, NEUTER);
  AddId("buch");
  
  AddReadDetail( ({"buch"}),
    "Du liest einige Seiten aus dem Buch und Dir wird klar, dass es nur "
    "zwei Wege gibt, um ein Meister-Wahrsager zu werden. Entweder der "
    "Lehrling uebt fleissig und studiert Jahre lang unter seinem Meister "
    ",oder der Lehrling toetet seinen Meister mit einem magischen Artefakt. "
    "Leider fehlt die Seite, auf dem das Artefakt naeher beschrieben wird. "
    "Hoffentlich hat das der Lehrling von Ratakron nicht gelesen.");

  SetProp(P_MATERIAL, ([MAT_PAPER:70, MAT_CARTON:30]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);
  

}
