#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Schattenruf, Gaias Schmerz");
  SetProp(P_LONG,
    "Schattenruf besteht nur aus einem Schatten, der aus einem Holzgriff kommt."
  );

  SetProp(P_NAME, "Schattenruf");
  
  AddId( ({"schattenruf", "schwert"}) );

  SetProp(P_ARTICLE, 0);

  AddDetail( ({"schatten"}),
    "Der Schatten dieses Schwertes drueckt den Schmerz von Mutter Natur aus.");
    
  AddDetail( ({"griff", "holz", "holzgriff"}),
    "Der Griff, aus dem der Schatten kommt, besteht aus Holz."
    "Er ist sehr schoen verziert. Er sieht aus wie viele ineinander verdrehte Wurzeln.");

  SetProp(P_VALUE, 4000);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_MATERIAL, ([ MAT_SHADOW:80, MAT_WOOD:20 ]) );

  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC, 170);
  SetProp(P_WC_FIX, 60);
  SetProp(P_WC_BONUS, (["\Ataron": 200]) );

  SetProp(P_NR_HANDS, 1);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER:1,
                                  P_LEVEL:25]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_WIELD_FUNC, this_object());
  SetProp(P_UNWIELD_FUNC, this_object());
  SetProp(P_HIT_FUNC, this_object());
}


int WieldFunc(object waffe, int silent)
{
  if( !silent )
    write("Gaia macht Dich zu ihrem Ritter und das Holz des Griffes schlingt sich um Deine Hand!\n"
          "Du bist jetzt ein Ritter der Natur!\n");
  return 1;
}
int UnwieldFunc(object waffe, int silent)
{
  if( !silent )
    tell_object(QueryProp(P_WIELDED),
        "Gaia beschliesst, Dich aus ihrem Dienst zu entlassen.\n");
  return 1;
}

int HitFunc(object enemy)
{
  if( !random(60) ) 
  {
    tell_object(QueryProp(P_WIELDED),
        "Der Griff zerdrueckt Deine Hand.\n");
    QueryProp(P_WIELDED)->AddHp(-(random(10)));
  }


if (!random(5))
switch(random(100)) 
{

	  case 0 .. 22 : SetProp(P_DAM_TYPE, ({DT_SLASH, DT_FIRE}));tell_object(QueryProp(P_WIELDED), "Der Schatten hat sich in Flammen verwandelt!\n"); break;
	  case 23 .. 27 : SetProp(P_DAM_TYPE, ({DT_SLASH, DT_COLD}));tell_object(QueryProp(P_WIELDED), "Du spuerst eine kalte Brise die vom Schwert ausgeht!\n"); break;
	  case 28 .. 32 : SetProp(P_DAM_TYPE, ({DT_SLASH, DT_WATER}));tell_object(QueryProp(P_WIELDED), "Die Kraft des Wassers fliesst durch das Schwert!\n"); break;
	  case 33 .. 49 : SetProp(P_DAM_TYPE, ({DT_SLASH, DT_AIR}));tell_object(QueryProp(P_WIELDED), "Du spuerst, wie das Schwert, die Luft um sich herum anzieht!\n"); break;
	  case 50 .. 65 : SetProp(P_DAM_TYPE, ({DT_SLASH, DT_LIGHTNING}));tell_object(QueryProp(P_WIELDED), "Du bemerkst, wie ploetzlich Blitze aus dem Griff springen!\n"); break;
	  case 66 .. 70 : SetProp(P_DAM_TYPE, ({DT_SLASH, DT_ACID}));tell_object(QueryProp(P_WIELDED), "Der Schatten nimmt ploetzlich eine seltsame gruende Faerbung an!\n"); break;
	  case 71 .. 79 : SetProp(P_DAM_TYPE, ({DT_SLASH, DT_ELECTRIC}));tell_object(QueryProp(P_WIELDED), "Viele Funken springen vom Schwert weg!\n"); break;
	  case 80 .. 89 : SetProp(P_DAM_TYPE, ({DT_SLASH, DT_LIGHT}));tell_object(QueryProp(P_WIELDED), "Ploetzlich leuchtet das Schwert hell auf!\n"); break;
	  case 90 .. 99 : SetProp(P_DAM_TYPE, ({DT_SLASH, DT_LIGHT}));tell_object(QueryProp(P_WIELDED), "Ploetzlich leuchtet das Schwert hell auf!\n"); break;
	  default : SetProp(P_DAM_TYPE, ({DT_SLASH})); break;
	}
  return 0;
}