#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein Bierkrug");
  SetProp(P_LONG,
    "Ein einfacher massiver Bierkrug aus Ton. Tut bestimmt weh, wenn man den auf den Kopf bekommt."
  );

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Bierkrug");
  AddId( ({"bierkrug", "krug"}) );

  SetProp(P_ARTICLE, 1);

  SetProp(P_VALUE, 100);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_MATERIAL, ([ MAT_CERAMIC:100 ]) );
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON}) );
  SetProp(P_WC, 60);
  SetProp(P_WC_FIX, 10);
  SetProp(P_WC_BONUS, (["maraken": 110]) );
  SetProp(P_NR_HANDS, 1);



}

