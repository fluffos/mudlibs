#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Am Hauptplatz der Waldlaeufer" );
  SetProp( P_INT_LONG,
    "Du befindest Dich am noerdlichen Punkt des Hauptplatzes. "
    "Hier nimmst Du den Wald schon wieder mehr wahr als suedlich. "
    "Die Baeume werden haeufiger und das Blaetterdach wird dichter. "
    "Auch die Staende und Verkaeufer sind weniger geworden.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );
  
////----DETAILS-ANFANG------------------------------------------------------

  AddDetail( ({ "punkt" }),
    "Du stehst hier am noerdlichen Punkt des Hauptplatzes."); 

  AddDetail( ({ "hauptplatz" }),
    "Du stehst hier am Hauptplatz von Vilay-Bog. Ein paar Verkaeufer haben sich hierher "
    "verirrt, weil die besseren Plaetze im Sueden schon vergeben sind.");
  
  AddDetail( ({ "boden", "erde" }),
    "Der Boden besteht aus festgestampfter Erde und hin und wieder siehst Du ein paar "
    "Verkaeufer am Boden ihre Produkte anpreisen.");
    
  AddDetail( ({ "verkaeufer", "produkte", "produkt" }),
    "Die Verkaeufer sind sicher nicht freiwilig hier an diesem schlecht besuchten "
    "Ort. Vielmehr sind sie hier, weil sie zu langsam waren oder ihre Produkte "
    "uninteressant sind.");
  
  AddDetail( ({ "wald", "baeume", "baum" }),
    "Die Baeume werden mehr und das Blaetterdach wird auch immer dichter.");
    
  AddDetail( ({ "plaetze", "sueden", "ort", "waren" }),
    "Dies ist sicher nicht der beste Ort, um seine Waren anzupreisen. "
    "Die besseren Plaetze sind weiter im Sueden.");
  
  AddDetail( ({ "vilay", "bog", "vilay-bog" }),
    "So heisst das Versteck hier.");
    
  AddDetail( ({ "versteck" }),
    "Das Versteck heisst Vilay-Bog.");
 
  AddDetail( ({ "leute" }),
    "Fast alle Rassen des Silberlandes sind hier vertreten, um ihre Geschaefte anzupreisen "
    "oder etwas zu kaufen.");
    
  AddDetail( ({ "staende", "sachen", "stand" }),
    "Die Staende sind weniger geworden als im Sueden.");
        
  AddDetail( ({ "sonne", "blaetterdach", "dach", "strahlen" }),
    "Das Blaetterdach wird hier wieder dichter und man kann von der Sonne "
    "nur mehr ein paar Strahlen sehen.");
    
  AddDetail( ({ "himmel" }),
    "Vom Himmel siehst Du recht wenig durch das dichte Blaetterdach.");

  AddSound( DEFAULT_SOUND,
    "Nichts besonderes.");

  AddSmell( DEFAULT_SMELL,
   "Nichts zu riechen.");


    
///---DETAILS-ENDE-------------------------------------------------------------------    

  AddExit( "westen", ROOM "ws4" );
  AddExit( "sueden", ROOM "ws9" );
  AddExit( "suedwesten", ROOM "ws8" );
  
  AddItem(NPC "waldlaeufer.lpc" ,REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: ROOM "ws5",
          P_MNPC_AREA: ({ ROOM "ws4", ROOM "ws5",
                          ROOM "ws8", ROOM "ws9",
                          ROOM "ws13" ROOM "ws14" }),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES + MOV_BACKWARDS,
        ]) );

 
  
}
