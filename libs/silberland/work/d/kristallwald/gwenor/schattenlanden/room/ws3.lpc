#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Ein kleiner Waldpfad" );
  SetProp( P_INT_LONG,
    "Du gehst auf einem kleinen Waldpfad, der vom Hauptplatz zu einer grossen Eiche "
    "fuehrt. Neben dem Pfad wachsen die Baeume viele Meter hoch in den Himmel, den Du "
    "Dank des Blaetterdaches aber nur erschwert sehen kannst.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );
  
////----DETAILS-ANFANG------------------------------------------------------

  AddDetail( ({ "dank" }),
    "Dieses Blaetterdach stoert Dich wirklich.");

  AddDetail( ({ "pfad", "waldpfad", "boden" }),
    "Der kleine Pfad fuehrt zu einer riesengrossen Eiche.");
    
  AddDetail( ({ "eiche", "meter" }),
    "Die Eiche ist wirklich riesig. Ihr Blaetterdach verschwindet in den Wolken.");

  AddDetail( ({ "hauptplatz" }),
    "Der Hauptplatz liegt von hier aus im Sueden.");
    
  AddDetail( ({ "baeume" }),
    "Die Baeume wachsen hier sehr hoch und Du hast durch ihr dichtes Blaetterdach "
    "starke Schwierigkeiten den Himmel zu sehen. An einem Baum erkennst Du etwas.");
  
  AddDetail( ({ "baum" }),
    "An einem der Baeume hier haengt eine kleine Tafel, auf der steht: \"Zum Anfuehrer\"");
    
  AddDetail( ({ "tafel" }),
    "Auf der Tafel steht: \"Zum Anfuehrer\"");
    
  AddDetail( ({ "anfuehrer", "zum" }),
    "Wenn Du wissen willst wer, das ist, solltest du mal hin gehen.");
  
  AddDetail( ({ "vilay", "bog", "vilay-bog" }),
    "So heisst das Versteck hier.");
    
  AddDetail( ({ "versteck" }),
    "Das Versteck heisst Vilay-Bog.");
        
  AddDetail( ({ "sonne", "blaetterdach", "dach", "strahlen", "blaetterdaches" }),
    "Die Sonne laesst sich nur mehr wenig blicken, da das Blaetterdach so dicht ist.");
    
  AddDetail( ({ "schwierigkeiten", "schwierigkeit" }),
    "Die Sonne hat Schwierigkeiten durch das Blaetterdach zu scheinen.");
    
  AddDetail( ({ "himmel", "wolken" }),
    "Du kannst vom Himmel fast gar nichts mehr sehen.");

  AddSound( DEFAULT_SOUND,
    "Nichts zu hoeren.");

  AddSmell( DEFAULT_SMELL,
   "Nichts besonderes zu riechen.");


    
///---DETAILS-ENDE-------------------------------------------------------------------    

  AddExit( "nordosten", ROOM "ws2" );
  AddExit( "sueden", ROOM "ws4" );

 
  
}
