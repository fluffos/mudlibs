
// ueberarbeitet 12.07.2011 - cleme

#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Der Eingang von Vilay-Bog" );
  SetProp( P_INT_LONG,
    "Du stehst mitten in einem hohlen Baum. Wenn Du Dich umblickst, erkennst Du ausser "
    "viel Rinde nichts. Dein Gefuehl sagt Dir aber, dass hier mehr als nur Rinde ist. Du solltest "
    "Dich vielleicht ein wenig umsehen.\n");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );
  
////----DETAILS-ANFANG------------------------------------------------------

  AddDetail( ({ "boden", "wand", "decke", "holz", "waende" }),
    "Der Boden besteht aus Holz. Genauso wie die Wand und die Decke. Kaum "
    "wunderlich, da Du Dich ja in einem Baum befindest. Du glaubst, eine gluehende Stelle an "
    "der Wand zu erkennen.");
    
  AddDetail( ({ "baum" }),
    "Der Baum wurde ausgehoehlt. Es reicht gerade so, dass Du aufrecht stehen kannst. "
    "Irgendwie sieht die Wand interessant aus.");
  
  AddDetail( ({ "rinde"}),
    "Es wundert Dich kein bisschen soviel Rinde zu sehen, Du stehst ja in einem Baum.");
    
  AddDetail( ({ "gefuehl" }),
    "Du hast das Gefuehl, dass in diesem Baum einiges an Magie geflossen ist. "
    "Irgendwie fuehlst Du, dass es mehr als Rinde hier geben muss.");
 
  AddDetail( ({ "magie", "hohlraum", "Weise" }),
    "Dieser Hohlraum ist sicher nicht auf natuerliche Weise entstanden.");
    
  AddDetail( ({ "gluehen", "stelle" }),
    "Seltsam, die Stelle an der Wand scheint wirklich zu gluehen. "
    "Man sollte mal austesten, was passiert, wenn man die Stelle beruehrt.");
 
  AddSound( DEFAULT_SOUND,
    "Seltsam, Du kannst nichts hoeren.");
    
  AddSound( ({ "nichts" }),
    "Nichts, gar nichts, was daran merkwuerdig ist? "
    "Du kannst hier drinnen nicht einmal die ueblichen Waldgeraeusche hoeren.");

  AddSmell( DEFAULT_SMELL,
	    "Nichts besonderes zu riechen.");
  
  
  //---DETAILS-ENDE-------------------------------------------------------------------    
  
  //AddExit( "suedosten", "/d/kristallwald/sargola/wald/room/0502" );
  
  AddExit("raus", VILAYBOG_WALD);
  
  AddCmd( ({"beruehre","beruehr"}), "cmd_beruehr");
  AddCmd( ({"sag", "sage"}), "cmd_sag");
  
}

seq1() {
  if(TP && ENV(TP)!=ME) return;
  write("\nPloetzlich durchzuckt Dich ein Blitz und Du wirst ohnmaechtig.\n\n");
  call_out("seq2",7);
}
seq2() {
  if(TP && ENV(TP)!=ME) return;
  write("Alles wird schwarz um Dich. Du hoerst ein leises Fluestern.\n\n");
  call_out("seq3",6);
}
seq3() {
  if(TP && ENV(TP)!=ME) return;
  write("Das Fluestern wird immer lauter.\n\n");
  call_out("seq4",7);
}
seq4() {
  if(TP && ENV(TP)!=ME) return;
  write("Die Stimme wird immer deutlicher.\n\n");
  call_out("seq5",8);
}
seq5() {
  if(TP && ENV(TP)!=ME) return;
  write("Die Stimme spricht: \"Feinde hoeret den Willen Gaia's: \"Ihr\n"
  "die ihr Feinde seid, werdet nie in den Baumhirten-Sumpf kommen.\n"
  "Doch die, die ihr Freunde seid, sagt den Namen der Baumhirten in ihrer\n"
  "Sprache und ihr werdet eingelassen.\" \n\n");
  call_out("seq6",7);
}
seq6() {
  if(TP && ENV(TP)!=ME) return;
  write("Du erwachst aus Deiner Vision und weisst nicht, ob es\n"
  "vielleicht doch nur ein Traum war. Du blickst Dich um und\n"
  "statt des Gluehens an der Wand steht jetzt das Wort\n"
  "\"Vilay\" dort. Vielleicht ist es das ja, was die Stimme\n"
  "gemeint hat. Es waere einen Versuch wert.\n");
  TP->SetProp(P_PARALYZED, 0);
}

int cmd_beruehr(string str)
{
  notify_fail("Was moechtest Du beruehren?\n");
  if(!str || str == "") return 0;
  if(!(str == "stelle" ||
       str == "gluehen" ||
       str == "wand" )) return 0;

  TP->SetProp(P_PARALYZED, 60);
  write(BS("Du beruehrst die gluehende Stelle an der Wand.\n"));
  call_out("seq1",0);
  return 1;
}

int cmd_sag(string str)
{
  notify_fail("Was moechtest Du sagen?\n");
  if(!str || str == "") return 0;
  if(!(str == "vilay"  )) return 0;

  write("\nWieder hoerst Du die Stimme sprechen: \"Tritt ein Freund\". Ploetzlich umgibt Dich wieder ein "
  "Blitz.\n");
  say(this_player()->name()+" wird von einem Blitz umhuellt und ist verschwunden.\n");
  TP->move(ROOM "ws15",M_NOCHECK | M_SILENT);

  return 1;
}
