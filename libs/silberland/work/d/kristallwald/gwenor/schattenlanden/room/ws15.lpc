
// ueberarbeitet 12.07.2011 - cleme

#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Versteck" );
  SetProp( P_INT_LONG,
    "Du befindest Dich hier noch ziemlich am Anfang des Versteckes. "
    "Hier gibt es nicht viel zu sehen ausser jede Menge Baeume. "
    "Von Norden dringen wohl bekannte Geraeusche an Dein Ohr.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );
  
////----DETAILS-ANFANG------------------------------------------------------

  AddDetail( ({ "boden", "pfad" }),
    "Der Boden oder besser gesagt der Pfad ist ziemlich ausgetrampelt. "
    "Neben dem Pfad stehen die Baeume sehr dicht nebeneinander, so dass "
    "man den Pfad nicht verlassen kann.");
    
  AddDetail( ({ "baeume", "baum", "menge" }),
    "Die Baeume wachsen hier sehr hoch in den Himmel. "
    "Von einigen Baeumen kannst Du die Aeste gar nicht mehr erkennen.");
  
  AddDetail( ({ "aeste", "ast" }),
    "Einige Baeume wachsen so hoch, dass Du die Aeste nicht mehr sehen kannst.");
    
  AddDetail( ({ "himmel", "sonne", "wolken", "blick" }),
    "Den Himmel kannst Du nur noch sehr schwer erkennen, da Dir einfach, "
    "das Blaetterdach den Blick versperrt. Du kannst nur erkennen, dass die "
    "Sonne vom blauen Himmel brennt und nur wenige Wolken vorbeiziehen.");
 
  AddDetail( ({ "blaetter", "blaetterdach" }),
    "Das Blaetterdach ist teilweise so dicht, dass Du den Himmel nicht mehr sehen kannst.");
    
  AddDetail( ({ "anfang" }),
    "Ja das Versteck faengt hier erst an. Wenn Du mehr sehen willst, solltest Du weitergehen.");
    
  AddDetail( ({ "versteck", "ort", "schattenlanden" }),
    "Du befindest im Versteck der Waldlaeufer, auch Vilay-Bog oder Schattenlanden genannt.");
    
  AddDetail( ({ "waldlaeufer", "gemeinschaft" }),
    "Die Waldlaeufer sind eine sehr naturgebundene Gemeinschaft. "
    "Es wissen allerdings nur wenige Leute wirklich, dass es sie gibt. "
    "Du kannst Dich gluecklich schaetzen, diesen Ort gefunden zu haben.");
    
  AddDetail( ({ "leute" }),
    "Welche Leute das genau sind, kann man nicht sagen, denn alle behalten Stillschweigen.");
    
  AddDetail( ({ "vilay", "bog", "vilay-bog", "magie", "nexus", "spirituelen", "sprache", "sumpf", "waldelfen",}),
    "Vilay-Bog, so nannten die Waldelfen diesen Ort frueher. Vilay-Bog bedeutet in der Sprache "
    "der Waldelfen soviel wie \"Baumhirten-Sumpf\". Die Waldelfen hielten diesen Ort fuer einen "
    "spirituellen Nexus, sprich fuer einen Ort an dem Magie sich buendelte. Bis heute denken "
    "sie, dass es hier sogenannte \"Baumhirten\" oder \"Ents\" gibt und sie diesen Ort beschuetzen.");
    
  AddDetail( ({ "baumhirten", "ents", "volk", "schlag", "natur", "unterschied" }),
    "Die Ents sind ein sehr sehr altes Volk und beschuetzen die Natur mit allem was sie haben. "
    "Sie sehen aus wie Baeume jedoch mit dem Unterschied das ein Baum wenn man auch nur zum Schlag "
    "ansetzt mit einer Axt nicht auf einen tritt");
  
  AddDetail( ({ "axt", "ausholen" }), 
    "Du wuerdest nicht einmal zum Ausholen kommen, ehe Du platt bist.");
    
  AddDetail( ({ "ohr", "sehen" }),
    "Es dringen Dir wohlbekannte Geraeusche an Dein Ohr, nur leider kannst Du nicht SEHEN, woher sie kommen.");
 
  AddSound( DEFAULT_SOUND,
    "Dir dringen wohlbekannte Geraeusche an Dein Ohr. "
    "Sie scheinen aus Richtung Norden zu kommen.");
    
  AddSound( ({ "geraeusche", "geraeusch", "ohr", "norden", "stadt", "stadtgeraeusche" }),
    "Es sind typische Stadtgeraeusche nur, das hier keine Stadt ist.\n"
    "...Seltsam, Du solltest mal nachsehen, was dort los ist.");

  AddSmell( DEFAULT_SMELL,
   "Nichts besonderes zu riechen.");

    
///---DETAILS-ENDE-------------------------------------------------------------------    

  AddExit( "norden", ROOM "ws14" );
  AddExit( "nordwesten", ROOM "ws13" );
  AddExit( "suedosten", ROOM "ws16" );

}
