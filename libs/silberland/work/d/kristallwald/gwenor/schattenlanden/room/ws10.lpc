
// ueberarbeitet 12.07.2011 - cleme

inherit "std/pub";

#include "../def.h"

#include <pub.h>

int money_da;

void create()
{
  ::create();
  
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp(P_INT_SHORT,"In der Kneipe 'Zum schnellen Schatten'");
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "maraken");
  SetProp(P_PUBKEEPER_NAME, "Maraken");
  SetProp(P_PUBMSG_NOKEEPER, "Maraken ist leider nicht hier.\n");
  SetProp(P_PUBMSG_NOENEMY, 
  BS(
      "Du bist gerade in einem verbissenen Kampf mit Maraken. Kein Wunder, "
      "dass er Dich nicht bedient."
  ));
  
  SetProp(P_PUBMSG_NOINVITE, 
  (
      "Maraken kaempft. Da hat er wahrhaft andere Sorgen als Kunden.\n"
  ));
  
  SetProp(P_PUBMSG_FIGHTING, "Maraken kaempft gerade.\n");
  
  
/// DETAILS-ANFANG-------------------

  AddDetail( ({ "boden" }),
    "Der Boden besteht wie auch die Waende und die Decke aus Holzplanken.");
    
  AddDetail( ({ "waende", "wand" }),
    "Die Waende wurden mit einfach Holzplanken verkleidet.");
    
  AddDetail( ({ "decke" }),
    "Die Decke wurde wie soviel anderes hier mit Holzplanken verkleidet.");
    
  AddDetail( ({ "holzplanken", "holzplanke", "planke", "planken" }),
    "Die Holzplanken sind schon sehr alt wie man an einigen Ritzen und Rillen erkennen kann. "
    "Jedoch sind sie sehr sauber und noch gut erhalten.");
    
  AddDetail( ({ "kneipe", "versteck" }),
    "Diese Kneipe ist die einzige im ganzen Versteck.");
    
  AddDetail( ({ "ritzen", "rillen", "rille" }),
    "Die Ritzen und Rillen sind am Boden zahlreich. Aber eine faellt Dir besonders auf." );
    
  AddDetail( ({ "ritze" }),
    "Die Ritze ist auf jedenfall gross genug um mit Deiner Hand hinzufassen.");
    
  AddDetail( ({ "sessel", "tische", "tisch", "gaeste", "gast" }),
    "Die Tische sind fuer die Gaeste reserviert. Falls Du vorhast, Dich niederzusetzen, "
    "musst Du schon etwas bestellen.\n"
    "Wenn Du \"menue\" eintippst, siehst Du was Du bestellen kannst.");
    
  AddDetail( ({ "theke" }),
    "Die Theke ist sehr niedrig, wahrscheinlich damit der Wirt nicht ganz "
    "dahinter verschwindet. Hinter der Theke an der Wand haengt die Speisekarte.");
    
  AddDetail( ({ "speisekarte", "karte" }),
    "Um die Speisekarte zu lesen, musst Du \"menue\" eingeben.");

  AddSound( DEFAULT_SOUND,
    "Da derzeit keiner in der Kneipe ist, hoerst Du nur Maraken, der seine Speisen anpreist.");
    
  AddSound( ({ "maraken", "wirt", "angebote", "ork" }),
    "Wenn Du seine Angebote sehen willst, gib \"menue\" ein.");
    
  AddSmell( DEFAULT_SMELL,
   "Es riecht nach leckeren Speisen und harten Getraenken.");
   
  AddSmell( ({ "speisen", "getraenken", "speise", "getraenke", "bier", "keilersteak" }),
    "Es riecht nach Keilersteak und Bier.\n"
    "Wenn Du wissen willst, was der Wirt noch anbietet, gib \"menue\" ein.");
    
///---DETAIL-ENDE---------------------

/// MENÜ-ANFANG--------------------------------
/// DRINKS-------------------------------------

  AddDrink("Schatten-Bier", ({"bier", "schatten-bier"}),
           300, 40, 8, 5,
           ({"Maraken zapft Dir ein frisches, kuehles Schatten-Bier, das Du gleich austrinkst.\n",
             "&& trinkt ein Schatten-Bier.\n"}));

  AddDrink("Wurzelsaft", ({"wurzelsaft", "saft"}),
            100, 17, 0, 5,
           ({"Maraken bringt Dir ein Glas mit Wurzelsaft.\n",
             "&& trinkt genuesslich ein Glas Wurzelsaft.\n"}));

  AddDrink("Morgentau", ({"tau", "morgentau"}),
           150, 25, 0, 7,
           ({"Maraken stellt Dir ein leeres Glas hin.\n"
             "Ach nein das ist Morgentau, und der ist von so guter "
             "Qualitaet, das er durchsichtig ist.\n",
             "&& trinkt ein Glas Morgentau.\n"}));
  
  AddDrink("Eulenschleim", ({"eulenschleim", "schleim"}),
           800, 100, 16, 10,
           ({"Maraken bringt Dir ein Glas Eulenschleim. Ein recht seltsames Mix-Getraenk.\n",
             "&& trinkt Eulenschleim.\n"}));
             
/// FOOD---------------------------------------------------

  AddFood("Keilersteak", ({"steak", "keilersteak"}),
          2000, 180, 41,
          ({"Maraken bringt Dir ein duftendes, halbrohes Keilersteak!\n"
          +BS("Wahnsinn, das Steak ist so zart, dass der Keiler wahrscheinlich "
              "erst vor ein paar Stunden erlegt worden ist!"),
            "&& isst ein duftendes Keilersteak!\n"}));
  
  AddFood("Gemuese", ({"gemuese"}),
          80, 15, 5,
          ({"Maraken bringt Dir ein wenig gemischtes Gemuese.\n"
          +BS("Lecker, frisches Gemuese, gleich rein damit!"),
            "&& isst ein wenig Gemuese.\n"}));
            
/// MENÜ-ENDE----------------------------------------------
             
  AddExit("westen", ROOM "ws9");
  AddExit("norden", ROOM "ws6");
  
  AddCmd( ({ "fasse", "fass" }),	"cmd_fasse");

  AddItem(NPC "maraken", REFRESH_DESTRUCT);
  AddItem(NPC "inshana", REFRESH_DESTRUCT);
}

string _query_int_long()
{
  string txt;

  txt = "Du stehst mitten in einer kleinen Kneipe, ueberall stehen Sessel und Tische herum. "
        "Vor Dir steht eine ziemlich niedrige Theke, hinter der eine Speisekarte haengt, "
        "die Du mit \"menue\" lesen kannst. ";
    

  if(QueryProp(P_PUBKEEPER_ID))
  {
    if(!present(QueryProp(P_PUBKEEPER_ID)))
    {
      txt += "Scheinbar ist der Wirt gerade nicht da.";
    }
    else
    {
      txt += "Ein kleiner Ork steht hinter der Theke und freut sich darauf Dich "
             "zu bedienen.";
    }
  }

  return BS(txt);
}

void reset()
{
  ::reset(); 

  money_da = 1;
}




int cmd_fasse(string str){

  notify_fail("Wohinein moechtest Du fassen?\n");
  if(!str || str == "") return 0;
  if(!(str == "in ritze"    ||
        str == "in ritz" )) return 0;

  if(money_da != 1)
  {

    write(BS("Du greifst in das Loch, findest aber leider nichts."));
    say(TPN + " fasst in eine Ritze.\n");

    return -1;
  }

  TP->AddMoney(200);

  write(BS("Wow, Schwein gehabt. 200 Muenzen und das so einfach. "
      "Vielleicht solltest Du Dir etwas zu Essen oder zu trinken davon "
      "leisten."));
  say(TPN + " hat etwas gefunden.\n");


  money_da = 0;

  return 1;
}
