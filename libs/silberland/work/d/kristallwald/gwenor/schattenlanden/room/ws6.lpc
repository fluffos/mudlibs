#include "../def.h"

inherit "std/room";

#include <properties.h>

string *spieler = ({});

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Rumpelkammer" );
  SetProp( P_INT_LONG,
    "Du befindest Dich hier in einem kleinem Hinterraum der Kneipe. Hier gibt es eigentlich "
    "nichts aufregendes fuer Dich. Der Raum dient wahrscheinlich eher als Abstellraum fuer "
    "kaputte Sessel und Tische.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
  
////----DETAILS-ANFANG------------------------------------------------------

  AddDetail( ({ "hinterraum", "raum", "abstellraum" }),
    "Da befindest Du Dich gerade.");
    
  AddDetail( ({ "kneipe" }),
    "Die eigentliche Kneipe befindet sich hinter dir. Das hier ist nur ein Abstellraum.");
    
  AddDetail( ({ "sessel", "tische", "sesseln", "tisch" }),
    "Die haben wohl endgueltig ausgedient. Bei einigen Sesseln ist der Bezug der Sitzkissen "
    "zerrissen oder komplett weg. Den Tischen hier fehlt es an einigen Beinen, weil sie zum "
    "einen abgebrochen oder weg sind.");
    
  AddDetail( ({ "bezug", "bezuege", "kissen", "sitzkissen" }),
   "Die Bezuege die noch da sind, sehen wirklich ekelhaft aus. "
   "Teilweise sind sie schon so zerrissen, dass Du nur mehr ahnen kannst "
   "welche Form sie frueher einmal hatten. Du glaubst sogar aus einem der "
   "Bezuege einen Kaefer hervorkriechen zu sehen.");
   
  AddDetail( ({ "form" }),
    "Frueher waren es wahrscheinlich sehr schoene und bequeme, runde Sitzkissen. "
    "Jetzt sind die alle Muell.");
    
  AddDetail( ({ "muell" }),
    "Muell liegt hier einiger rum. Es ist kaum zu ertragen wieviel Muell hier rumliegt.");
    
  AddDetail( ({ "kaefer" }),
    "Pfui, das ist ja ekelig. Der Kaefer krabbelt seelenruhig die zerrissenen Kissen entlang. "
    "Sowas sollte man an das zustaendige Gesundheitsamt melden.");
    
  AddDetail( ({ "gesundheitsamt", "amt" }),
    "Welches Gesundheitsamt hier wohl bestochen wurde damit die Kneipe offen bleiben kann?");
    
  AddDetail( ({ "beine" }),
    "Die Beine der Tische sind alle kaputt oder weg. Alle bis auf eines.");
    
  AddDetail( ({ "bein" }),
    "Ein Bein ist noch da und komplett. Leider ist sogar dieses Bein "
    "etwas bruechig. Vielleicht solltest "
    "Du es der Vollstaendigkeit halber auch entfernen.");
    
  AddDetail( ({ "vollstaendig", "vollstaendigkeit" }),
    "Vollstaendig ist hier leider gar nichts mehr.");
    
  AddDetail( ({ "entfernen" }),
    "Na wie enfernt man ein BRUECHIGES Tischbein von einem Tisch?");
    
  AddDetail( ({ "boden", "staub" }),
    "Der Boden ist so wie alles hier total verstaubt und einfach nur eklig.");
    
  AddDetail( ({ "decke", "weben", "ecken" }),
    "Die Decke ist etwas undicht, und in den Ecken siehst Du sogar noch Spinnweben.");
    
  AddDetail( ({ "spinnweben", "weben", "netzen" "netz", "zuhause" }),
    "In den Ecken des Raumes haben sich Spinnen ihr Zuhause aufgebaut. "
    "Ein paar kleine Fliegen haben sich in den Netzen verfangen.");
    
  AddDetail( ({ "spinnen", "spinne", "viecher" }),
    "Kleine, eklige, krabelnde Viecher. Zum Glueck sieht Du keine.");
    
  AddDetail( ({ "fliegen", "fliege", "netzen", "netz",  }),
    "Sie haben sich in den Netzen der Spinnen verfangen und sind darin umgekommen. "
    "Allerdings scheint eine noch mit dem Leben zu kaempfen. Vieleicht kannst Du sie "
    "ja befreien.");
    
  AddDetail( ({ "leben" }),
    "Du bist noch am Leben aber die kleine, arme Fliege nichtmehr lange.");
    
  AddDetail( ({ "glueck" }),
    "Ja, zum Glueck siehst Du keine Spinnen.");
        
  AddDetail( ({ "wand", "waende" }),
    "Die Waende sind dreckig und eklig. Sie scheinen auch schon etwas zu schimmeln.");
    
  AddDetail( ({ "schimmel" }),
    "Der Schimmel breitet sich langsam ueber die ganze Wand aus. "
    "Schon sehr ekelhaft, wenn man bedenkt, dass hier eine Kneipe ist. "
    "Die Feuchtigkeit scheint von der Decke aus zu kommen.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst noch ganz dumpf, was sich in der Kneipe abspielt.");

  AddSmell( DEFAULT_SMELL,
   "Einfach nur ekelhaft.");


    
///---DETAILS-ENDE-------------------------------------------------------------------    

  AddExit( "sueden", ROOM "ws10" );
  
  AddCmd( ({"brich", "breche"}) 	, "cmd_brechen");
  AddCmd( ({"befreie", "befrei"})	, "cmd_befrei");
  
}

void reset()
{
  ::reset(); 

  spieler=({});
}

int cmd_brechen(string str)	
{
  object tischbein;

  notify_fail("Was moechtest du abbrechen?\n");
  if(!str || str == "") return 0;
  if(!(str == "tischbein"    || str == "tischbein ab" || str == "bein ab" || 
        str == "bein" )) return 0;

  if (member(spieler, getuid(this_player())) != -1)
  {

    write("Tja leider sind nicht mehr Tischbeine da.\n");
    say(TPN + " sucht verzweifelt ein Tischbein.\n");


    return -1;
  }

  tischbein = clone_object(WEAPON "tischbein");
  spieler += ({getuid(this_player())});

  if( ME_TOO_HEAVY == tischbein->move(TP,M_GET) )
  {

    tell_object(TP,BS("Du hast es zwar geschafft "
          "das Tischbein abzubrechen "
          "allerdings traegst Du zuviel "
          "bei Dir um ihn zu behalten."));

    say(TPN + " laesst ein Tischbein fallen.\n");

    tischbein -> move(TO, M_NOCHECK|M_SILENT);
  }
  else
  {

    write(BS("Mit einem Ruck hast Du auf einmal das Tischbein in der Hand."));
    say(TPN + " hat etwas gefunden.\n");

    return 1;
  }
}

int cmd_befrei(string str)
{
  notify_fail("Was willst Du befreien?\n");
  if(!str || str == "") return 0;
  if (str != "fliege" && str != "fliegen") return 0;
  tell_object(TP, BS("Du versucht, die Fliege zu befreien, aber ploetzlich "
        "erscheint eine Spinne aus ihrem Versteck und beisst Dich, noch bevor "
        "Du die Fliege erwischt."));
    tell_room(TO, BS(TPN + " versucht, eine Fliege zu befreien, wird aber von "
        "einer Spinnen gebissen.") , ({TP}));
  TP->AddPoison(1);
  TP->AddHp(-2);
  tell_object(TP, "Aua! Du fuehlst das Gift durch Deine Adern fliessen!\n");
  return 1;
}
