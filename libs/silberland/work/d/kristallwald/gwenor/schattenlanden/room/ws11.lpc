#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer verwahrlosten Huette" );
  SetProp( P_INT_LONG,
    "Du stehst inmitten einer kleinen verwahrlosten Huette. "
    "Um Dich herum siehst jede Menge Buecherregale mit vielen Buechern "
    "darin. Der Boden besteht aus festgestampfter Erde, die Waende "
    "aus Lehm und die Decke aus Holz.");
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  
////----DETAILS-ANFANG------------------------------------------------------

  AddDetail( ({ "mitten", "mitte", "huette" }),
    "Du stehst genau in der Mitte der Huette.");
    
  AddDetail( ({ "menge", "buecherregale", "buecher", "buecherregal", "regale", "regal",}),
    "Um Dich herum stehen massenhaft Buecherregale, die alle "
    "voll mit Buechern sind, die Du alle nicht verstehst. Doch "
    "in einem Regal steht ein Buch, bei dem Du zumindest den Text am "
    "Einband verstehst.");   

  AddDetail( ({ "buch" }),
    "Du koenntest versuchen, das Buch aus dem Regal zu nehmen.");

  AddDetail( ({ "text", "einband" }),
    "Du kannst den Text ja lesen.");
    
  AddReadDetail( ({ "text" }),
    "Da steht: Der Weg zum Meister.");
    
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus festgetrampelter Erde.");
   
  AddDetail( ({ "erde" }),
    "Braune, festgetrampelte Erde.");

  AddDetail( ({ "wand", "waende", "lehm" }),
  "Die Waende bestehen aus Lehm. An den Waenden stehen viele Buecherregale.");
    
  AddDetail( ({ "decke", "holz", "holzplatten", "platten", "platte", "holzplatte" }),
  "Die Decke besteht aus einfachen Holzplatten, die nicht sonderlich interessant sind.");

  AddSound( DEFAULT_SOUND,
   "Du kannst nichts Besonderes hoeren.");

  AddSmell( DEFAULT_SMELL,
    "Nichts Besonderes zu riechen.");
    
///---DETAILS-ENDE-------------------------------------------------------------------    

  AddExit( "osten", ROOM "ws12" );
  
  AddCmd( ({ "nimm", "nehme" }), "cmd_nimm");

  AddItem(NPC "ratakron", REFRESH_DESTRUCT );
  AddItem(NPC "nagathron", REFRESH_DESTRUCT);

}

int buch_da=1;
 
 
nosave int cmd_nimm (string str) {
  string was, was2;
  object ob;
  notify_fail("Was moechtest Du woraus nehmen?\n");
  if(!str) return 0;
  if(sscanf(str, "%s aus %s", was, was2)!=2) return 0;
  if(was !="buch" || was2!="regal") return 0;
  if(!buch_da) {write("Komisch, das Buch will momentan nicht genommen werden.\n");
    return -1;
  }
  ob=clone_object(OBJ "buch");
  if(ob->move(TP, M_GET) == ME_TOO_HEAVY) {
    write("Boah, das Buch kannst Du einfach nicht mehr tragen!\n");
    ob->remove();
    return -1;
  } 
  write("Du nimmst ein Buch aus dem Regal.\n");
  buch_da = 0;
  return 1;
} 
 
void reset() {
  ::reset();
  buch_da=1;
} 
 
public void init() {
  ::init();

  if(CHECK_WLTASK(TP) && TP->QueryProp(("ranger_quest_recognized"))) {
    call_out("ranger_quest", 0, TP, 0);
  }
}

public void ranger_quest(object who, int step) {
  object naga, rata;
  if(!objectp(who)) return;
  if(!present(who)) return;
  if(!objectp(naga=present("nagathron")) && step < 15) {
    naga = clone_object(NPC "nagathron");
    naga->move(TO, M_GO);
  }
  if(!objectp(rata=present("ratakron")) && step < 13) {
    rata = clone_object(NPC "ratakron");
    rata->move(TO, M_GO);
  }

  switch(step) {
    case 0: 
      tell_room(TO, BS("Hier ist der vermummte Waldlaeufer! Nervoes huepft er von einem Fuss auf den anderen."));
      break;
    case 1: tell_room(TO, BS("Der Waldlaeufer sagt: Nagathron, der Agent von Raziel, dem ich auf Hypros entkommen bin ist hier!")); break;
    case 2: tell_room(TO, BS("Nagathron heupft erschrocken auf.")); break;
    case 3: tell_room(TO, BS("Der Waldlaeufer sagt: Was tun wir jetzt? Was will der Meister von uns?")); break;
    case 4: naga->command_me("sag Wir muessen uns sputen, du Narr! Wenn sie die Larve in die Finger bekommen ist alles vorbei!"); break;
    case 5: tell_room(TO, BS("Ratakron horcht auf.")); rata->command_me("sag Was ist hier los?!"); break;
    case 6: naga->command_me("sag Deine Zeit ist vorbei, du greiser Troll! Jetzt hat meine Stunde geschlagen!!"); break;
    case 7: rata->command_me("sag Nagathron, du Narr! Mit welchen Maechten hast du dich eingelassen?!"); break;
    case 8: tell_room(TO, BS("Nagathron holt eine widerliche Larve, groesser als du sie auf Hypros gesehen hast, aus einer Kiste und wirft sie auf den alten Troll.")); break;
    case 9: tell_room(TO, BS("Ein saegezahnbewaertes Maul oeffnet sich und widerliche Tentakel bilden sich aus dem Koerper der Kreatur.")); break;
    case 10: naga->command_me("emote lacht widerwaertig."); naga->command_me("sag Sieh nur, du alter Narr! Das ist letzte Keatur! Das Omegatherion! Es ist noch jung, doch sieh seine Macht!!"); break;
    case 11: tell_room(TO, BS("Die Larve des Omegatherion stuerzt sich kreischend und zischend auf den alten Trollzauberer.")); break;
    case 12: tell_room(TO, BS("In sekundenschnelle verdaut sie Ratakron bei lebendigem Leib!")); rata->die(); break;
    case 13: tell_room(TO, BS("Der vermummte Waldlaeufer sagt: Bring die Larve fort von hier, Nagathron! Ich kuemmere mich um unseren ungebetenen Gast!")); break;
    case 14: tell_room(TO, BS("Nagathron wirft einen Feuerball auf "+who->name(WEN, 1)+" und laeuft davon."), ({who})); who->AddHp(-20);
             tell_object(who, BS("Nagathron wirft einen Feuerball auf dich und laeuft davon.")); naga->remove(1); break;
    default:
      rata = clone_object(NPC "ranger_quest_enemy");
      rata->move(TO, M_SILENT|M_NOCHECK);

      rata->command_me("sag Niemand wird uns aufhalten. Besonders nicht du, "+who->name(WER, 1));
      rata->Kill(who);
      call_other("/gilden/waldlaeufer/master/master", "SetTask",  getuid(TP), 6);
      who->SetProp("ranger_quest_recognized", 0);
      return;
      break;
}

  call_out("ranger_quest", 4, who, ++step);
}

