// ueberarbeitet 12.07.2011 - cleme

#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Am Hauptplatz der Waldlaeufer" );
  SetProp( P_INT_LONG,
    "Du befindest Dich mitten am Hauptplatz von Vilay-Bog. "
    "Hier ist es sehr laut, was wahrscheinlich an den vielen Leuten "
    "und Marktschreiern hier liegt. Ueberall stehen Staende mit verschiedensten "
    "Sachen. Es ist sehr hell hier. Man merkt von dem Wald, der um einen herum ist, "
    "nur sehr wenig. Westlich von Dir scheint der einzige feste Laden des Ortes zu sein. "
    "Das erkennst Du an der riesigen Tafel neben dir.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );
  
////----DETAILS-ANFANG------------------------------------------------------

  AddDetail( ({ "hauptplatz" }),
    "Du stehst hier am Hauptplatz von Vilay-Bog. Ueberall haben sich Marktschreier postiert, "
    "um Dich in ihre Geschaefte zu locken. Man hat das Blaetterdach groesstenteils weggeschnitten, "
    "um es hier wirklich hell und freundlich zu haben.");
    
  AddDetail( ({ "boden" }),
    "Auf dem Boden haben sich ein paar Marktschreier ihre Geschaefte aufgebaut.");
    
  AddDetail( ({ "sonderpreis", "preis", "normal" }),
    "Ein Preis der anders ist als Normal, nennt man Sonderpreis.");
    
  AddDetail( ({ "haendler", "marktschreier", "geschaefte", "zeug", "geschaeft" }),
    "Die Marktschreier legen sich maechtig ins Zeug, um die Leute hin zu ihren "
    "Geschaeften zu locken, die ueber den ganzen Hauptplatz verteilt sind. "
    "Hier werden hauptsaechlich exotische Fruechte, Gewuerze und Speisen angeboten.");
    
  AddDetail( ({ "fruechte", "frucht" }),
    "Die einzigen die Du erkennst sind Mangos und Melonen. Die anderen "
    "sind Dir vollkommen unbekannt.");
    
  AddDetail( ({ "mangos", "mango" }),
    "Die Mangos sehen sehr gut aus. Allerdings kosten sie sicher zuviel "
    "fuer Deine kleine Geldboerse.");
    
  AddDetail( ({ "geldboerse", "boerse", "muenzen" }),
    "Ja in Deiner Geldboerse sind wohl nicht genug Muenzen.");
    
  AddDetail( ({ "melonen", "melone" }),
    "Grosse, runde Melonen. Sie wurden von einem Haendler zu einem richtigen Turm "
    "aufgebaut.");
    
  AddDetail( ({ "turm", "gegend" }),
    "Der einzige Turm in der Gegend, ist der aus Melonen.");
    
  AddDetail( ({ "gewuerze", "gewuerz" }),
    "Du kannst nicht erkennen welche es genau sind. Aber Du koenntest versuchen "
    "es zu erschnueffeln.");
    
  AddDetail( ({ "speisen", "speise" }),
    "Die sehen alle seltsam aus. Aber Du erkennst da etwas was Dich interessieren "
    "koennte.");
    
  AddDetail( ({ "etwas" }),
    "Sieht extrem lecker aus. Ueber der Speise haengt ein Schild auf dem steht Lembas mit alles.");
    
  AddDetail( ({ "lembas", "lembasmitalles" }),
    "Sieht aus wie Fladenbrot mit Lammfleisch, Kraut, Zwiebeln, Tomaten und einer Sauce. "
    "Das wuerde Woody und Protheg sicher schmecken.");
  
  AddDetail( ({ "wald", "stadt" }),
    "Eigentlich koennte man meinen, man sei in einer grossen Stadt. "
    "Nur weniges laesst einen nicht vergessen, dass man sich in einem "
    "Wald befindet.");
    
  AddDetail( ({ "laden", "gebaeude", "schluss" }),
    "Westlich von Dir steht eine Tafel, die Dich zu dem Schluss kommen laesst, "
    "dass das Gebaeude der einzige feste Laden hier ist.");
    
  AddDetail( ({ "tafel" }),
    "Du koenntest versuchen die Tafel zu lesen.");
  
  AddDetail( ({ "vilay", "bog", "vilay-bog" }),
    "So heisst das Versteck hier.");
    
  AddDetail( ({ "versteck", "ort" }),
    "Das Versteck heisst Vilay-Bog.");
 
  AddDetail( ({ "leute", "rassen", "rasse" }),
    "Fast alle Rassen des Silberlandes sind hier vertreten, um ihre Geschaefte anzupreisen "
    "oder etwas zu kaufen.");
    
  AddDetail( ({ "silberlandes", "silberland" }),
    "Du befindest Dich hier im Silberland.");
    
  AddDetail( ({ "staende", "sachen", "platz", "stand", "sache" }),
    "Die Staende sind hier ueber den ganzen Platz verteilt, da aber nichts "
    "fuer Dich wertvolles dabei ist, interessierst Du Dich nicht weiter dafuer.");
        
  AddDetail( ({ "sonne", "blaetterdach", "dach", "strahlen" }),
    "Das Blaetterdach wurde fast komplett weggeschafft, damit die Sonne alles "
    "erstrahlen lassen kann.");
    
  AddDetail( ({ "blau", "himmels", "himmel" }),
    "Der Himmel ist schoen blau und fast wolkenlos.");
    
  AddDetail( ({ "haelfte" }),
    "Naja halt nicht ganz, sondern halb!");
    
  AddReadDetail( ({ "tafel" }),
    "+++++++++++++++++\n"
    "+ Hargens Laden +\n"
    "+++++++++++++++++\n");

  AddSound( DEFAULT_SOUND,
    "Die Marktschreier legen sich hier maechtig ins Zeug.");
    
  AddSound( ({ "marktschreier", "schreier", "markt" }),
    "Die Marktschreier geben wirklich alles, um Dich in ihre Geschaefte oder zu "
    "ihren Staenden zu lotsen.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach den verschiedensten Sachen.");
   
  AddSmell( ({"sachen", "gerueche", "geruechen", "geruch"}),
     "Du kannst die Gerueche kaum auseinander halten. Aber es riecht schon "
     "sehr stark nach Gewuerzen.");
     
   AddSmell( ({"gewuerze", "vielzahl"}),
     "Anis, Ingwer, Muskat, Vanille, Zimt und Pfeffer. Mehr kannst Du aus "
     "dieser Vielzahl von Geruechen nicht herausriechen.");
     
   AddSmell( "anis",
     "Anis ist sehr gut fuer den Magen. Aber da Du keine Magenschmerzen hast "
     "interessiert Dich das wahrscheinlich nicht sonderlich.");
     
   AddSmell( ({"ingwer", "apetitanreger", "hunger"}),
     "Ingwer ist ein sehr guter Appetitanreger. Aber Du hast ja sowieso immer "
     "Hunger.");
     
   AddSmell( ({"muskat", "weihnachtsstimmung", "zimt"}), 
     "Muskat und Zimt, von diesen Geruechen bekommst Du gleich Weihnachtsstimmung.");
     
   AddSmell( ({"vanille", "kipferl"}),
     "Du erinnerst Dich an Vanille-Kipferl... Mjamm... die waeren jetzt gut.");
     
   AddSmell( "pfeffer",
     "HATSCHIIII, das musste ja so kommen. Naja wenn Du auch unbedingt "
     "an allem und jedem riechen musst.");
     
   AddSmell( ({"allem", "alles"}),
     "War der Pfeffer nicht schon genug fuer Deine Nase?");
     
   AddSmell( "jedem",
     "Ich glaube nicht das die Besucher es so gut faenden wenn, "
     "Du an ihnen rumschnueffelst.");
   

    
///---DETAILS-ENDE-------------------------------------------------------------------    

  AddExit( "westen", ROOM "ws7" );
  AddExit( "norden", ROOM "ws4" );
  AddExit( "osten", ROOM "ws9" );
  AddExit( "sueden", ROOM "ws13" );
  AddExit( "nordosten", ROOM "ws5" );
  AddExit( "suedosten", ROOM "ws14" );
  
  AddRoomMessage( ({ "Heute zum Sonderpreis!\n",
                     "Alles nur die Haelfte!\n",
                     "Kauft bei mir! Bei den anderen schmeckt es nicht!\n",
                     "Kommt zu mir! Bei mir ist das guenstiger!\n" }),
                      30, "" );
}

 
  
