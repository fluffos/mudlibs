#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Beim Anfuehrer von Vilay-Bog" );
  SetProp( P_INT_LONG,
    "Du stehst inmitten einer riesigen, hohlen Eiche. Der Baum "
    "ist von innen mit seltsamen Zeichen verziert und macht auch "
    "einen recht guten Eindruck. Der Boden besteht aus festgestampfter "
    "Erde, nur an ein paar Stellen wachsen Graeser oder Kraeuter. "
    "An den Waenden haengen jede Menge Waffen und Ruestungen herum. "
    "Genau in der Mitte des Baumes steht ein grosser Tisch. Auf dem "
    "Tisch siehst Du eine Karte aufgebreitet liegen. In einer Ecke "
    "siehst Du so etwas wie einen Schlafplatz aus Blaettern und Aesten.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  
  //AddItem( NPC "ataron", REFRESH_DESTRUCT );
////----DETAILS-ANFANG------------------------------------------------------

  AddDetail( ({ "ecke", "eck" }),
    "In einer Ecke hat sich wohl Ataron so etwas wie einen Schlafplatz eingerichtet.");
    
  AddDetail( ({ "schlafplatz", "aesten", "blaettern", "gebilde" }),
    "Wahrscheinlich dient dieses Gebilde aus Aesten und Blaettern "
    "Ataron zum Schlafen. Du koenntest Dich ja auch mal reinlegen.");   

  AddDetail( ({ "waffen", "ruestungen", "waffe", "ruestung", "menge", "plunder" }),
    "Eigentlich siehst Du hier nichts Wertvolles oder Nuetzliches. "
    "Deswegen beschliesst Du den Plunder liegen zu lassen.");

  AddDetail( ({ "eindruck" }),
    "Zumindest ist er nicht schlecht.");
    
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus festgetrampelter Erde. "
    "Hier und da laesst sich ein Graeslein blicken.");
     
  AddDetail( ({ "erde" }),
    "Braune, festgetrampelte Erde.");
    
  AddDetail( ({ "gras", "graeslein", "graeser", "kraeuter", "stellen", "stelle" }),
    "An einigen Stellen blickt noch ein wenig Gras aus der Erde. "
    "Hier und da wachsen sogar noch Kraeuter.");
    
  AddDetail( ({ "mitte", "mitten" }),
    "In der Mitte der Eiche steht ein Tisch mit einer Karte darauf.");

  AddDetail( ({ "eiche", "baum", "art"}),
    "Die Eiche scheint schon einige Meter hoch zu sein, "
    "jedenfalls kannst Du die Decke nicht erkennen. " 
    "Der Hohlraum in dieser Eiche ist sicher nicht natuerlichen "
    "Ursprungs. Sie wurde wohl zu so einer Art Behausung umgebaut.");
    
  AddDetail( ({ "tisch" }),
    "In der Mitte des Baumes steht ein Tisch auf dem eine Karte liegt.");
    
  AddDetail( ({ "karte"}),
    "Die Karte zeigt ganz Vilay-Bog.\n"
    "Sie ist mit zwei Dolchen am Tisch festgemacht.");
    
  AddDetail( ({ "meter", "hoehe" }),
   "Die Eiche ist so hoch das Du ihr Ende nicht mehr erkennen kannst.");
   
  AddDetail( ({ "ende", "decke" }),
    "Die Decke kannst Du von hier unten schon gar nicht mehr erkennen.");
    
  AddDetail( ({ "hohlraum", "spiel" }),
    "Der Hohlraum in der Eiche ist sicher nicht natuerlich, da muss "
    "ein maechtiger Zauber mit im Spiel sein.");
    
  AddDetail( ({ "zauber", "lage" }),
    "Wer wohl in der Lage ist einen Baum auszuhoehlen?");
    
  AddDetail( ({ "wer", "zauberer" }),
    "Egal wer das war, er muss ein maechtiger Zauberer sein.");
    
  AddDetail( ({ "vilay-bog", "vilay", "bog", "versteck", "schattenlanden" }),
    "Das Versteck der Waldlaeufer wie es manche nennen, oder einfach nur "
    "Schattenlanden.");
    
  AddDetail( ({ "ursprungs", "ursprung" }),
    "Da muss ein Zauberer seine Finger drin haben, und zwar ein maechtiger Zauberer.");
    
  AddDetail( ({ "finger", "moment" }),
    "Eins, zwei, drei, vier, fuenf, sechs, sieben, acht, neun, zehn und elf\n"
    "Moment... Elf? Phu... Glueck gehabt Du hast Dich nur verzaehlt.");
    
  AddDetail( ({ "dolche", "dolch" }),
    "Ganz normale Dolche. Sie sind rostig, dreckig und nicht mehr "
    "wirklich zu gebrauchen. Deswegen laesst Du sie auch, wo sie sind.");
    
  AddDetail ( ({ "waldlaeufer", "schattenwanderer", "schatten" }),
    "Auch Schattenwanderer genannt, weil sie von den meisten Abenteurern "
    "nur als Schatten wahrgenommen werden.");
    
  AddDetail( ({ "abenteurern", "abenteurer", "glueck" }),
    "So einer wie Du. Nur Du hast das Glueck, das Versteck gefunden zu haben.");
    
  AddDetail( ({ "behausung", "anfuehrer", "ataron" }),
    "Wahrscheinlich dient dieser Baum als Behausung fuer "
    "den Anfuehrer der Waldlaeufer, Ataron.");
    
  AddDetail( ({ "zeichen" }),
    "Seltsame Zeichen schmuecken die Waende. "
    "Du koenntest versuchen sie zu lesen.");
    
  AddReadDetail( ({ "zeichen"}),
    "Du kannst die Zeichen nicht entziffern. "
    "Vielleicht kann es ein Zauberer oder ein Medium.");
    
  AddDetail( ({ "zauberer" }),
    "Einen Zauberer gibt es hier in Vilay-Bog nicht, "
    "aber es gibt ein Medium.");
    
  AddDetail( ({ "geruch" }),
    "Na mit was nimmt man einen Geruch wahr?");
    
  AddDetail( ({ "medium", "ratakron" }),
    "Das Medium hier in Vilay-Bog heisst Ratakron und ist ein ziemlich "
    "alter Troll. Jedoch ist er fuer sein Alter sehr "
    "weise. Vieleicht solltest Du mit ihm ueber die "
    "seltsamen Zeichen an der Wand sprechen.\n"
    "Er ist uebrigens auch der einzige Troll hier.");
    
  AddDetail( ({ "trolle", "troll"}),
    "Trolle leben bis auf Ratakron, das Medium, hier keine.\n"
    "Sie leben alle hoch im Gebirge.");
    
  AddDetail( ({ "gebirge"}),
    "Das Gebirge ist noch sehr weit weg von hier.");
    
  AddDetail( ({ "wand", "waende"}),
    "Die Waende sind mit seltsamen Zeichen geschmueckt. "
    "Das Gluehen, das von ihnen ausgeht erhellt den Raum "
    "so sehr, dass man nicht einmal eine Fackel braucht um hier "
    "sehen zu koennen.\n"
    "Ausserdem siehst Du noch ein paar Waffen und Ruestungen an den Waenden.");
    
  AddDetail( ({ "gluehen", "licht", "weise", "raum" }),
    "Auf unterklaerliche Weise gluehen die Zeichen sehr hell "
    "und tauchen den Raum in ein angenehmes gruenes Licht.");
    
  AddDetail( ({ "fackel" }),
    "Also eine Fackel braucht man hier wirklich nicht.");

  AddSound( DEFAULT_SOUND,
    "Ausser ein wenig Musik kannst Du nichts hoeren.");

  AddSound( ({ "musik" }),
    "Du findest diese Musik sehr entspannend, entspann Dich doch mal.");

  AddSmell( DEFAULT_SMELL,
    "Hier riecht es sehr stark nach Erde, aber da ist auch noch etwas anderes.");

  AddSmell( ({ "erde" }),
    "Die Erde ist hier zwar der deutlich herausstechende Geruch, aber es riecht "
    "noch nach etwas anderem.");

  AddSmell( ({ "etwas" }),
    "Ja, das ist es, das ist doch Weihrauch. So richtig schoen um ein wenig zu entspannen oder?.");
    
  AddSmell( ({ "weihrauch" }),
    "Es riecht wirklich stark nach Weihrauch.");
    
///---DETAILS-ENDE-------------------------------------------------------------------    

  AddExit( "westen", ROOM "ws2" );
  
  AddCmd( ({ "entspanne", "entspann" }), "cmd_entspanne");
  AddCmd( ({ "lege", "lieg" }), "cmd_lege");

  AddItem(NPC "ataron", REFRESH_DESTRUCT );
  AddItem(NPC "waechter", REFRESH_DESTRUCT);
  AddItem(NPC "waechter", REFRESH_DESTRUCT);
}


int cmd_entspanne() 
{
  tell_object(TP, BS("Du entspannst Dich und laesst den Weihrauch und die "
        "Musik auf Dich wirken."));
  tell_room(TO, BS(TPN+ " entspannt sich."), ({TP}));
  return 1;
}

int cmd_lege(string str) 
{
  notify_fail("Wo willst Du Dich hinlegen?\n");
  if(!str || str == "") 
    return 0;
  if(!(str == "in blaetter"    ||
       str == "in aeste"       ||
       str == "in schlafplatz" )) 
  
    return 0;

  tell_object(TP, BS("Du legst Dich auf den Schlafplatz."));
  tell_room(TO, BS(TPN+" legt sich auf den Schlafplatz."), ({TP}));
  return 1;
}
