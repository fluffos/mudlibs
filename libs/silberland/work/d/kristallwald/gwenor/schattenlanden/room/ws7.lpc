//-------------------------------------------------------------------------
// Fuer einen Laden, wo Gegenstaende verkauft und gekauft werden koennen,
// erben wir nicht den std/room, sondern den bereits auf die Funktion vor-
// bereiteten std/laden.
//-------------------------------------------------------------------------

// ueberarbeitet 12.07.2011 - cleme

inherit "std/laden";

#include "../def.h"
#include <laden.h>

void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  // SetProp(P_INT_LONG, "");
  SetProp(P_INT_SHORT,"In einem gar nicht so kleinen Laden");
  SetProp(P_SHOPKEEPER_ID, "hargen");
  SetProp(P_SHOPKEEPER_NAME, "Hargen");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);

  SetStorageRoom(ROOM "ws7lager" );
  
  AddItem(NPC "hargen", REFRESH_DESTRUCT );
  
///-DETAILS-ANFANG----------------------------------------------------------------

  AddDetail( ({"laden"}),
    "Da befindest Du Dich gerade.");
  
  AddDetail( ({"boden", "holz", "holzboden"}),
    "Dank Deiner langjaehrigen Studien ueber die Eigenheiten verschiedenster "
    "Holzarten kannst Du mit Sicherheit sagen, dass dieses Holz Eichenholz ist.");
    
  AddDetail( ({"studien", "studie"}),
    "Wenn Du nicht mal weisst, was das ist, dann musst Du wirklich ziemlich "
    "oft abgeschrieben haben! Schaemen sollst Du Dich!");
    
  AddDetail( ({"eigenheiten", "holzarten", "holzart", "eigenheit"}),
    "Ja, jede Holzart hat so ihre kleinen Feinheiten.");
    
  AddDetail( ({"feinheit", "feinheiten"}),
    "Hast Du das studiert oder ich?");
    
  AddDetail( ({"sicherheit", "erfahrung"}),
    "Ja, dank Deiner Erfahrung bist Du sicher, dass das Eichenholz ist.");
    
  AddDetail( ({"eichenholz"}),
    "Eichenholz ist ein sehr dunkles stabiles Holz, aber warum erzaehl ich das grad Dir?");
    
  AddDetail( ({"wand", "waende", "decke"}),
    "Die Waende und die Decke bestehen aus festem Stein. "
    "An den Waenden stehen unzaehlige Regale.\n");
    
  AddDetail( ({"stein", "steinart", "art", "bergarbeiter", "zwergen", "zwerg"}),
    "Um wirklich zu wissen, welche Steinart das ist, muesstest Du schon Zwergen-Bergarbeiter sein.");
    
  AddDetail( ({"regale", "regal", "winkel"}),
    "Die Regale sind wirklich bis auf den letzten kleinen Winkel voll geraeumt.");
    
  AddDetail( ({"theke", "verkaufstheke", "schluss", "besitzer", "ladenbesitzer"}),
    "Die Theke ist wirklich ziemlich hoch, der Ladenbesitzer muss riesig sein.");
    
  AddDetail( ({"grund", "finger", "sachen"}),
    "Du kannst Dir sicher vorstellen, was der Besitzer mit Dir macht, wenn Du die Sachen anruehrst.");
 
/////-DETAILS-ENDE--------------------------------------

  AddExit("osten", ROOM "ws8");

}

string _query_int_long()

{
  string txt;

  txt = "Du befindest Dich hier in einem kleinen Laden. Der Boden besteht aus Holz, "
        "die Waende und die Decke bestehen aus Stein. An den Waenden stehen unzaehlige Regale, "
        "wovon die meisten prall befuellt sind. Die Verkaufstheke ist ungewoehnlich hoch, "
        "was Dich zum Schluss kommen laesst, dass der Besitzer des Ladens hier sehr gross sein "
        "muss. Noch ein Grund mehr die Finger von den Sachen zu lassen.\n";



  if(QueryProp(P_SHOPKEEPER_ID))
  {
    if(!present(QueryProp(P_SHOPKEEPER_ID)))
    {
      txt += "Leider ist momentan gerade niemand hier.";
    }
  }

  return BS(txt);
}
