#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Eine schmale Seitengasse" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer schmalen Seitengasse. Du kannst gerade noch durchgehen, "
    "ohne die Angst haben zu muessen, dass Du stecken bleiben koenntest. "
    "Es ist gerade noch hell genug, um keine kuenstliche Lichtquelle zu brauchen. "
    "Am Ende der Gasse erkennst Du eine kleine sehr verwahrloste Huette, die von "
    "vielen Kletterpflanzen umwuchert ist.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );
  
////----DETAILS-ANFANG------------------------------------------------------

  AddDetail( ({ "boden", "erde" }),
    "Der Boden besteht aus festgetrampelter Erde.");

  AddDetail( ({ "seitengasse", "gasse" }),
    "Die Seitengasse ist sehr schmal und dunkel. Irgendwie unheimlich.");
    
  AddDetail( ({ "angst", "glueck" }),
    "Zum Glueck schaffst Du es gerade noch hier zu gehen, ohne Dich in der "
    "engen Seitengasse zu verkeilen.");
  
  AddDetail( ({ "lichtquelle" }),
    "Du brauchst hier keine. Die Sonne laesst sich zwar nur ein wenig "
    "blicken, aber es reicht, um sehen zu koennen.");
    
  AddDetail( ({ "ende" }),
    "Am Ende dieser unheimlichen Gasse siehst Du eine kleine Huette, die "
    "sehr verwahrlost aussieht. Sie wird durch ein paar Schlingpflanzen getragen. "
    "Wahrscheinlich ist das der Grund, warum sie noch nicht zusammengefallen ist.");
 
  AddDetail( ({ "huette" }),
    "Die kleine Huette am Ende der Gasse wirkt sehr verwahrlost und wenn im Inneren "
    "kein Licht brennen wuerde, wuerdest Du denken, sie sei verlassen. Sie wird "
    "wahrscheinlich nur durch die Kletterpflanzen gestuetzt.");
    
  AddDetail( ({ "inneren", "innen", "innenraum", "licht" }),
    "Im Inneren der Huette brennt Licht.");
        
  AddDetail( ({ "sonne", "blaetterdach", "dach", "strahlen" }),
    "Das Blaetterdach laesst nur wenige Strahlen durch. "
    "Es reicht allerdings, um hier sehen zu koennen.");
    
  AddDetail( ({ "blau", "himmels", "himmel" }),
    "Du kannst das Blau des Himmels nur schwer erkennen.");
  
  AddDetail( ({ "kletterpflanzen", "kletterpflanze", "schlingpflanze", "schlingpflanzen", "pflanzen", "pflanze", "grund" }),
    "Die Schlingpflanzen sind genau genommen Efeu, sie haben die Huette komplett umschlungen. "
    "Was wahrscheinlich der Grund ist, warum sie nicht zusammenkracht.");
    
  AddDetail( ({ "efeu" }),
    "Genau genommen ist das Hedera Helix.");
    
  AddDetail( ({ "hedera", "helix", "art", "obi" }),
    "So heisst diese Art von Efeu. Wenn Du mehr darueber wissen willst, geh doch "
    "zu einem Magier, oder zu OBI.");
    
  AddDetail( ({ "magier", "leute" }),
    "Das sind die lustigen Leute, die zuviel Zeit haben und so unnoetige Details schreiben.");
    
  AddDetail( ({ "zeit" }),
    "Ja Magier muessen echt zuviel davon haben, wenn sie so dumme Details schreiben.");
    
  AddDetail( ({ "details", "detail", "untersuchen" }),
    "Ich denke es reicht jetzt erstmal. Danke fuer das Untersuchen solcher unnoetigen Details.");
    

   AddSound( DEFAULT_SOUND,
    "Nichts zu hoeren.");

  AddSmell( DEFAULT_SMELL,
   "Nichts besonderes zu riechen hier.");


    
///---DETAILS-ENDE-------------------------------------------------------------------    

  AddExit( "westen", ROOM "ws11" );
  AddExit( "osten", ROOM "ws13" );
 
  
}
