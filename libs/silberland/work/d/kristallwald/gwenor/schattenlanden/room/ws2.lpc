// ueberarbeitet 12.07.2011 - beerengeist kommt jetzt auch wieder - cleme

#include "../def.h"

inherit "std/room";

#include <properties.h>

int geist_da;

void create() 
{
  ::create();
  
  geist_da = 1;
  SetProp( P_INT_SHORT, "Vor einer hohen Eiche" );
  SetProp( P_INT_LONG,
    "Du stehst vor einer wirklich grossen Eiche.\n"
    "Es scheint als wurde sie ausgehoehlt, um sie als Unterschlupf zu verwenden. "
    "Wer darin wohl hausen mag?\n"
    "Rund um die Eiche stehen Buesche, die den Weg saeumen. "
    "Sie sind noch sehr saftig gruen und es geht ein herrlicher Duft von ihnen aus.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );
  
////----DETAILS-ANFANG------------------------------------------------------

  AddDetail( ({ "boden", "pfad", "weg" }),
    "Der Pfad ist nicht sonderlich interessant. Ein paar Buesche stehen am links und "
    "rechts von dir.");

  AddDetail( ({ "eiche", "baum" }),
    "Die Eiche ist wirklich riesengross.\n"
    "Du solltest nicht einmal daran denken, da rauf zu klettern.");
    
  AddDetail( ({ "unterschlupf" }),
    "Die Eiche wurde wohl zu einem Unterschlupf umgebaut. "
    "Von hier draussen sieht sie aber ziemlich unbeeindruckend aus, "
    "Du koenntest ja mal rein gehen.");
  
  AddDetail( ({ "buesche", "busch" }),
    "Die Buesche strahlen hier noch in einem saftigen Gruen. "
    "Auf einem Busch siehst Du einige Beeren haengen. Der Duft, "
    "der von den Bueschen ausgeht, ist wirklich wunderbar.");
    
  AddDetail( ({ "gruen" }),
    "Gruen ist eine Farbe. Die Buesche strahlen genau in dieser Farbe.");
 
  AddDetail( ({ "farbe", "farben" }),
    "Zum Beispiel Rot, Gelb, Blau oder Gruen wie die Buesche.");
    
  AddDetail( ({ "rot", "rinde", "schimmer" }),
    "Nur die Rinde der Eiche hat einen leicht roetlichen Schimmer.");
    
  AddDetail( ({ "gelb", "beispiel" }),
    "Gelb ist zum Beispiel die Sonne.");
    
  AddDetail( ({ "sonne", "blaetterdach", "dach", "strahlen" }),
    "Das Blaetterdach laesst nur wenige Strahlen durch. "
    "Es reicht allerdings um hier sehen zu koennen.");
    
  AddDetail( ({ "blau", "himmels", "himmel" }),
    "Du kannst das Blau des Himmels nur schwer erkennen.");
    
  AddDetail( ({ "beeren", "ahnung" }),
    "Kleine rote Beeren wachsen auf einem der Buesche. "
    "Da Du keine Ahnung hast, ob die Beeren giftig sind, oder nicht "
    "laesst Du die Finger von ihnen.\n"
    "Eine Beere jedoch faellt Dir auf.");
    
  AddDetail( ({ "finger", "hand" }),
    "Schon mal versucht auf Deine Hand zu schauen? Da sind sie naemlich "
    "meistens.");
    
  AddDetail( ({ "beere" }),
    "Diese eine Beere ist viel groesser als die anderen und sticht "
    "deswegen sehr raus.");
    
  
 
  AddSound( DEFAULT_SOUND,
    "Nichts zu hoeren.");

  AddSmell( DEFAULT_SMELL,
   "Nur der Duft der Beeren sticht heraus.");

  AddSmell( ({ "duft" }),
    "Dieser Duft ist wirklich himmlisch.");

    
///---DETAILS-ENDE-------------------------------------------------------------------    

  AddExit( "osten", ROOM "ws1" );
  AddExit( "suedwesten", ROOM "ws3" );
 
  AddCmd( ({"pfluecke", "pflueck"}), "cmd_pfluecke");

}


void reset()
{
  ::reset(); 

  geist_da = 1;
}




int cmd_pfluecke(string str){

  notify_fail("Was moechtest Du pfluecken?\n");
  if(!str || str == "") return 0;
  if(!(str == "beere")) return 0;

  if(geist_da != 1)
  {

    write(BS("Leider sind keine Beeren da."));
    say(TPN + " sucht etwas aber findet nichts.\n");

    return -1;
  }

  CLONEME(NPC "beerengeist");


  write(BS("Du pflueckst die Beere, doch ploetzlich erscheint hinter Dir ein Geist aus der Beere."));
  say(TPN + " pflueckt eine Beere.\n");


  geist_da = 0;

  return 1;
}
