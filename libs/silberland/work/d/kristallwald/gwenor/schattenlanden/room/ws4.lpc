// ueberarbeitet 12.07.2011 - cleme

#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Am Hauptplatz der Waldlaeufer" );
  SetProp( P_INT_LONG,
    "Du stehst hier an einer wieder sehr ruhigen Ecke des Hauptplatzes. "
    "Hier sind nur mehr sehr wenige Staende, wahrscheinlich weil hier "
    "einfach zu schlechte Plaetze sind um etwas zu verkaufen. Langsam merkt man "
    "auch wieder das man mitten im Wald ist. Die Baeume stehen wieder naeher beieinander "
    "und das Blaetterdach wird auch wieder dichter. Nach Norden fuehrt ein kleiner Waldpfad "
    "zu einer riesigen Eiche.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );
  
////----DETAILS-ANFANG------------------------------------------------------

  AddDetail( ({ "norden", "pfad", "waldpfad", "boden" }),
    "Der kleine Pfad fuehrt zu einer riesengrossen Eiche. Er wird von ein paar Baeumen "
    "kleinen Bueschen umschlossen. Hier und da liegen ein paar kleine Steinchen rum.");
    
  AddDetail( ({ "steinchen" }),
   "Davon liegen ein paar am Pfad.");
    
  AddDetail( ({ "eiche" }),
    "Die Eiche ist wirklich riesig. Ihr Blaetterdach verschwindet in den Wolken.");

  AddDetail( ({ "hauptplatz", "ecke" }),
    "Du stehst hier am Hauptplatz von Vilay-Bog. Nur mehr sehr wenige Marktschreier "
    "stehen hier um Dir etwas zu verkaufen. ");
    
  AddDetail( ({ "marktschreier", "geschaefte", "zeug", "verkaufstaktik", "verkaufsplaetze", "plaetze", "verkaufplaetze" }),
    "Die Marktschreier sehen Dich irgendwie traurig an. Ob das vielleicht eine Verkaufstaktik "
    "ist, oder sind sie vielleicht wirklich traurig, weil sie nur so schlechte "
    "Verkaufsplaetze erwischt haben.");
  
  AddDetail( ({ "wald", "stadt", "baeume" }),
    "Endlich merkst man wieder das man mittem im tiefen Wald ist und nicht in einer Stadt. "
    "Die Baeume wachsen hier wieder hoeher und das Blaetterdach ist wieder dichter.");
  
  AddDetail( ({ "vilay", "bog", "vilay-bog" }),
    "So heisst das Versteck hier.");
    
  AddDetail( ({ "versteck" }),
    "Das Versteck heisst Vilay-Bog.");
 
  AddDetail( ({ "leute", "rassen" }),
    "Fast alle Rassen des Silberlandes sind hier vertreten um ihre Geschaefte anzupreisen "
    "oder etwas zu kaufen.");
    
  AddDetail( ({ "silberlandes", "silberland" }),
    "Du befindest Dich im Silberland.");
    
  AddDetail( ({ "staende", "sachen" }),
    "Die Staende sind wieder weniger geworden. Genauso wie die Leute die hier etwas kaufen.");
        
  AddDetail( ({ "sonne", "blaetterdach", "dach", "strahlen" }),
    "Die Sonne laesst sich nur mehr wenig blicken, da das Blaetterdach so dicht ist.");
    
  AddDetail( ({ "himmel", "wolken" }),
    "Du kannst vom Himmel fast gar nichts mehr sehen.");
    
  AddDetail( ({ "buesche" }),
    "Der Pfad zur Eiche wird von einigen kleinen Bueschen gesaeumt. Die meisten "
    "sind noch saftig Gruen, doch einer sieht so aus, als wuerde er kein Wasser bekommen." );
    
  AddDetail( ({ "gruen" }),
    "Gruen ist die Farbe der Hoffnung.");
    
  AddDetail( ({ "farbe" }),
    "Farben die in der Natur vorkommen entstehen meistens durch Photosynthese.");
    
  AddDetail( ({ "photosynthese" }),
    "Autotrophe Assimilation mit Licht als Energiequelle; Pflanzen und einige Bakterien.");
    
  AddDetail( ({ "autotrophe", "assimilation", "physik" }),
    "Tja, da hat wohl jemand nicht in Physik aufgepasst.");
    
  AddDetail( ({ "licht", "energiequelle" }),
    "Die Sonne ist die natuerlichste Energiequelle die es je gab.");
    
  AddDetail( ({ "pflanzen", "beispiel" }),
    "Die Buesche zum Beispiel, das sind auch Pflanzen.");
    
  AddDetail( ({ "bakterien" }),
    "Kleine ekelhafte Bakterien uebertragen Krankheiten.");
    
  AddDetail( ({ "krankheiten", "krankheit" }),
    "Zum Beispiel, die \"Ich-untersuche-erstmal-jeden-Schrott-bevor-ich-nachdenke\" Krankheit.");
    
  AddDetail( ({ "Ich-untersuche-erstmal-jeden-Schrott-bevor-ich-nachdenke", "ich", "schrott" }),
    "Du bist eindeutig damit infiziert.");
    
  AddDetail( ({ "hoffnung", "menge" }),
    "Du musst ja jede Menge davon haben, wenn Du denkst, hier noch ein "
    "sinnvolles Detail zu finden.");
    
  AddDetail( ({ "natur" }),
    "Alles um Dich herum ist Natur.");
    
  AddDetail( ({ "wasser" }),
    "Leider bekommen die Buesche davon viel zu wenig.");
    
  AddDetail( ({ "detail" }),
    "DAS ist ein Detail."),
    
  AddDetail( ({ "busch", "zustand" }),
    "Der Busch sieht irgendwie sehr eingetrocknet aus. Seltsam, und das, obwohl "
    "der Busch eigentlich genau unter einer Luecke im Blaetterdach steht.");
    
  AddDetail( ({ "luecke" }),
    "Genau unter dieser Luecke steht ein vertrockneter Busch. Aber das Blaetterdach kann "
    "nicht der Grund fuer den Zustand des Busches sein.");
    
  AddDetail( ({ "seltsam" }),
    "Als Du so nach unten schaust und ueberlegst warum den dieser Busch so vertrocknet ist "
    "bemerkst Du, dass die Wurzeln etwas Seltsam aussehen.");
    
  AddDetail( ({ "wurzeln", "wurzel" }),
    "Die Wurzeln des Busches wurden, allem Anschein nach, durchgebissen. "
    "Aber was war das fuer ein Tier? Oder war es kein Tier?");
    
  AddDetail( ({ "anschein", "tier" }),
    "Du suchst, und suchst, aber findest kein Tier das faehig waere die "
    "Wurzeln dieses Busches durchzubeissen.");

  AddSound( DEFAULT_SOUND,
    "Nichts zu hoeren.");

  AddSmell( DEFAULT_SMELL,
   "Nichts besonderes zu riechen.");


    
///---DETAILS-ENDE-------------------------------------------------------------------    

  AddExit( "osten", ROOM "ws5" );
  AddExit( "sueden", ROOM "ws8" );
  AddExit( "suedosten", ROOM "ws9" );
  AddExit( "norden", ROOM "ws3" );
 
  AddItem(NPC "waldlaeufer.lpc" ,REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: ROOM "ws4",
          P_MNPC_AREA: ({ ROOM "ws4", ROOM "ws5",
                          ROOM "ws8", ROOM "ws9",
                          ROOM "ws13" ROOM "ws14" }),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES + MOV_BACKWARDS,
        ]) );
  
}
