#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Beim Hauptplatz der Waldlaeufer" );
  SetProp( P_INT_LONG,
    "Du stehst hier am suedoestlichen Eck des Hauptplatzes. "
    "Hier ist es ziemlich ruhig, da sich das Meiste weiter im Norden "
    "abspielt. Wenn Du willst, kannst Du nach Norden gehen und Dir einen "
    "mehr besuchten Teil des Hauptplatzes ansehen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );
  
////----DETAILS-ANFANG------------------------------------------------------

  AddDetail( ({ "boden", "erde" }),
    "Der Boden besteht auf festgestampfter Erde.");

  AddDetail( ({ "eck", "baeumen", "ecke", "baum", "baeume"}),
    "Du stehst hier in einem nicht so haeufig besuchten Teil des Hauptplatzes. "
    "Hier gibt es eigentlich nur wenig zu sehen ausser den Baeumen oestlich "
    "und suedlich neben dir.");
    
  AddDetail( ({ "hauptplatz", "hauptplatzes", }),
    "Du befindest Dich derzeit am Hauptplatz von Vilay-Bog, auch wenn man es nicht "
    "wirklich merkt, da hier so wenig tut. Vielleicht solltest Du nach Norden gehen, "
    "da ist sicher mehr los.");
  
  AddDetail( ({ "vilay", "bog", "vilay-bog" }),
    "So heisst das Versteck hier.");
    
  AddDetail( ({ "versteck" }),
    "Das Versteck heisst Vilay-Bog.");
 
  AddDetail( ({ "norden", "westen", "wahl", "weg" }),
    "Der Weg fuehrt weiter nach Norden und Westen. Du hast die Wahl, wo Du hin willst.");
    
  AddDetail( ({ "Teil" }),
    "Ja, dieser Teil ist wirklich ruhig.");
        
  AddDetail( ({ "sonne", "blaetterdach", "dach", "strahlen" }),
    "Das Blaetterdach laesst nur wenige Strahlen durch. "
    "Es reicht allerdings, um hier sehen zu koennen.");
    
  AddDetail( ({ "blau", "himmels", "himmel" }),
    "Du kannst das Blau des Himmels nur schwer erkennen.");

   AddSound( DEFAULT_SOUND,
    "Nichts zu hoeren.");

  AddSmell( DEFAULT_SMELL,
   "Nichts besonderes zu riechen hier.");


    
///---DETAILS-ENDE-------------------------------------------------------------------    

  AddExit( "westen", ROOM "ws13" );
  AddExit( "norden", ROOM "ws9" );
  AddExit( "nordwesten", ROOM "ws8" );
  AddExit( "sueden", ROOM "ws15" );
 
  
}
