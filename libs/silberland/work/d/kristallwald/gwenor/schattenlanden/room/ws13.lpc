#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Beim Hauptplatz der Waldlaeufer" );
  SetProp( P_INT_LONG,
    "Du stehst hier am suedwestlichen Eck des Hauptplatzes. "
    "Hier bewegt sich relativ wenig, doch wenn Du weiter "
    "nach Norden gehst, erlebst Du vielleicht doch noch "
    "ein bisschen mehr. Westlich von Dir geht es in eine kleine "
    "Seitengasse.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );
  
////----DETAILS-ANFANG------------------------------------------------------

  AddDetail( ({ "eck", "ecke", "suedwestlichen"  }),
    "In dieser Ecke des Hauptplatzes ist wenig los. "
    "Du koenntest aber weiter nach Norden gehen, um "
    "zu sehen, ob dort mehr los ist.");
    
  AddDetail( ({ "hauptplatz", "hauptplatzes" }),
    "Da stehst Du gerade. Und zwar befindest Du Dich im "
    "suedwestlichen Eck.");
  
  AddDetail( ({ "norden" }),
    "Im Norden ist vielleicht mehr los als hier.");
    
  AddDetail( ({ "gasse", "seitengasse" }),
    "Die schmale Seitengasse ist sehr dunkel, Du kannst "
    "nicht erkennen, wohin sie fuehrt.");
 
  AddDetail( ({ "boden", "weg", "pfad", "erde", "stelle" }),
    "Der Boden besteht aus festgetretener Erde und Lehm. Ein schwerer Wagen "
    "wuerde hier nicht von der Stelle kommen.");
    
  AddDetail( ({ "lehm" }),
    "Ganz normaler Lehm wie Du ihn schon sehr oft gesehen hast.");
        
  AddDetail( ({ "wagen", "glueck", "meter" }),
    "Zum Glueck fahren hier solche Wagen nicht, sie wuerden keine 2 Meter weit "
    "kommen, ohne im Boden einzusacken.");
    
  AddDetail( ({ "blau", "himmels", "himmel" }),
    "Du kannst das Blau des Himmels nur schwer erkennen.");

   AddSound( DEFAULT_SOUND,
    "Nichts zu hoeren.");

  AddSmell( DEFAULT_SMELL,
   "Nichts besonderes zu riechen hier.");


    
///---DETAILS-ENDE-------------------------------------------------------------------    

  AddExit( "westen", ROOM "ws12" );
  AddExit( "norden", ROOM "ws8" );
  AddExit( "osten", ROOM "ws14" );
  AddExit( "nordosten", ROOM "ws9" );
  AddExit( "suedosten", ROOM "ws15" );
 
  
}
