#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Auf einer belebten Lichtung" );
  SetProp(P_INT_LONG,
	  "Du befindest Dich hier auf einer ziemlich belebten Lichtung.\n"
	  +"Hauptsaechlich Elfen, aber auch Hobbits, Menschen, Zwerge und "
	  +"sogar eine kleine Gruppe von Feen kannst Du entdecken. "
	  +"Wohin Du auch schaust wird eifrig gebaut. Im Norden siehst Du "
	  +"wie das Geruest eines Hauses aufgestellt wird, im Nordosten "
	  +"werden grosse Felsbloecke von Zwergen herangeschafft und im "
	  +"Westen kannst Du ein kristallenes Bauwerk entdecken. Direkt "
	  +"auf der Lichtung sind hauptsaechlich Gaertner zu sehen. "
	  +"Offensichtlich scheint man hier ob des Treibens nirgends weiter "
	  +"durchzukommen also kannst Du wohl nur wieder nach Suedwesten "
	  +"zurueck.\n");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:22, ENV_TERRAIN:TT_FOREST]));
  
  // DETAILS
  AddDetail(({"treiben", "weiterkommen"}),
	    "Das eifrige Treiben auf dieser Lichtung behindert leider jegliches "
	    +"Weiterkommen. Du kannst wohl nur nach Suedwesten zurueck.\n");
  AddDetail( ("lichtung"),
	     "Du befindest Dich hier auf einer ziemlich belebten Lichtung. "
	     +"Hier haben Gaertner kreisfoermig Baeume eingepflanzt und pflegen "
	     +"diese jetzt so gut sie koennen um deren Wachstum zu beguenstigen "
	     +"und zu lenken.\n");
  AddDetail(("wachstum"),
	    "Die Gaertner scheinen offenbar das Wachstum der Baeume beschleunigen "
	    +"und lenken zu wollen.\n");
  AddDetail(({"baeume"}),
	    "Baeume wurden um diese Lichtung herum kreisfoermig in den Boden gepflanzt.\n"); 
  AddDetail(({"fee", "feen", "gruppe"}),
	    "Die kleine Gruppe von Feen scheint an dem Bauwerk im Westen "
	    +"mitzuarbeiten.\n");
  AddDetail(("menschen"),
	    "Einige Menschen sind hier unterwegs, hauptsaechlich Handwerker "
	    "wie Du unschwer erkennen kannst.\n");
  AddDetail(("unkraut"),
	    "Das Unkraut scheinen die Gaertner schon groesstenteils entfernt zu haben.\n");
  AddDetail(("handwerker"),
	    "Die Handwerker scheinen hier ja reichlich Arbeit zu haben.\n");
  AddDetail(({"zwerg", "zwerge", "hammer", "meissel", "haemmer"}),
	    "Die Zwerge bearbeiten im Nordosten mit Haemmern und Meisseln durch wuchtige "
	    +"Schlaege die Felsbloecke welche sie dort aufgestellt haben.\n");
  AddDetail(({"schlaege", "glueck"}),
	    "Die Schlaege der Zwerge sind ziemlich wuchtig, aber zum Glueck nur auf "
	    +"die Felsbloecke gerichtet.\n");
  AddDetail(("arbeit"),
	    "Die Arbeit wird den Handwerkern hier wohl nicht so schnell ausgehen.\n");
  AddDetail(({"geruest", "holzhaus", "haus"}),
	    "Hobbits versuchen das Geruest eines Holzhauses im Norden aufzustellen.\n");
  AddDetail(("norden"),
	    "Im Norden stellen einige Hobbits gerade das Holzgeruest eines Hauses "
	    +"auf. Offensichtlich scheint da nicht alles so zu klappen wie es sollte, "
	    +"zumindest bekommt man diesen Eindruck wenn man die Kommandos des Hobbits "
	    +"mit dem breitkrempigem Hut hoert.\n");
  AddDetail(({"kommando", "kommandos"}),
	    "Du kannst ihnen lauschen.\n");
  AddDetail(({"nordosten", "felsbloecke", "bloecke", "fels"}),
	    "Im Nordosten bearbeiten Zwerge mit Hammer und Meissel einige der Felsbloecke "
	    +"welche sie vorher dort aufgestellt haben. Scheint so als wollten sie dort "
	    +"irgendwelche Skulpturen oder Statuen schaffen.\n");
  AddDetail(({"skulpturen", "skulptur", "statue", "statuen"}),
	    "Was die Skulpturen oder Statuen wohl darstellen werden?\n"); 
  AddDetail(({"westen", "bauwerk"}),
	    "Im Westen kannst Du ein kristallenes Bauwerk erkennen an welchem eine grosse "
	    +"Anzahl von Elfen und ein paar Feen arbeiten. Das scheint einmal ein echt "
	    +"beeindruckendes Gebaeude zu werden. Zwei Gestalten fallen Dir dabei auf.\n");
  AddDetail(({"anzahl", "elfen"}),
	    "Eine grosse Anzahl von Elfen arbeitet hier.\n");
  AddDetail(({"gebaeude"}),
	    "Das Bauwerk aus Kristall im Westen scheint mal ein echt beeindruckendes Gebaeude zu "
	    +"werden.\n");
  AddDetail(("hobbits"),
	    "Einige Hobbits versuchen im Norden das Geruest eines Holzhauses aufzustellen.");
  AddDetail(({"hut", "hobbit"}),
	    "Ein Hobbit hat einen seltsamen breitkrempigen Hut auf. Derselbe Hobbit gibt auch "
	    +"immer wieder Kommandos von sich.\n");
  AddDetail(("kristall"),
	    "Der typische Kristall des Kristallwaldes.\n");
  AddDetail(("gestalten"),
	    "Bei den zwei Gestalten handelt es sich um einen grossgewachsenen Elf und "
	    +"eine kleine Gestalt in einer schwarzen Robe. Sie scheinen in ein Gespraech "
	    +"vertieft zu sein.\n");
  AddDetail(({"robe"}),
	    "Eine schwarze Robe mit silbernen Runen darauf.\n");
  AddDetail(({"runen"}),
	    "Du kannst Die silbernen Runen von hier nicht genau erkennen.\n");
  AddDetail(("gestalt"),
	    "Wer die kleine Gestalt in der schwarzen Robe wohl sein mag?\n");
  AddDetail(({"elf", "grossgewachsenen elf"}),
	    "Ein schlanker, grossgewachsener Elf welcher eine seltsam schimmernde Kleidung "
	    +"traegt. Er unterhaelt sich mit einer kleinen Gestalt in einer schwarzen Robe.\n");
  AddDetail(("kleidung"),
	    "Du fragst Dich warum die Kleidung des Elfen so eigenartig schimmert.\n");
  AddDetail(("gespraech"),
	    "Du koenntest versuchen dem Gespraech zu lauschen.\n");
  AddDetail(({"himmel", "sonne"}),
	    "Die Sonne scheint froehlich am Himmel, umringt von einigen Woelkchen.\n");
  AddDetail(({"woelkchen", "wolken"}),
	    "Nur einige wenige Woelkchen sind am Himmel zu entdecken.\n");
  AddDetail(({"gaertner"}),
	    "Die Gaertner arbeiten hier fleissig daran, neue Baeume einzupflanzen und diese "
	    +"dann auch zu pflegen.\n");
  AddDetail(({"boden", "waldboden"}),
	    "Ein gewoehnlicher Waldboden an welchem die Gaertner jedoch "
	    +"bereits ihre Spuren hinterlassen haben.\n");
  AddDetail(("spuren"),
	    "Die Spuren der Gaertner sind unuebersehbar. Da wurden ein paar Baeume in den Boden gepflanzt, " 
	    +"dort wurde ein bisschen Unkraut gejaetet und so einiges mehr.\n"); 
  AddDetail(({"wald", "kristallwald"}),
	    "Du befindest Dich hier im Kristallwald, wie Du unschwer "
	    +"an den vielen Baeumen erkennen kannst.\n"); 
  AddSound(({"kommando", "kommandos"}),
	   "'Nein, nicht so! Laaaangsam, Laaangsaaaaam!\n"
	   +"Jetzt ein Spur nach rechts, ein Stueck nach unten...\n"
	   +"...Vorsicht, Vorsiiiiiccht!!!' *KRAAAACH*\n"
	   +"'ARGGHHH!!! Alinja steh mir bei, wieso muss auch der Baumeister "
	   +"gerade heute krank sein und ich darf alles selber "
	   +"machen? *seufz*\n"
	   +"Leute, ich schlage vor wir machen erst mal eine kleine Essenspause!'\n"
	   +"Scheint so als wuerde kein einziger Hobbit damit ein Problem haben.\n");
  AddDetail(("problem"),
	    "Scheint keines zu sein.\n");
  AddSound(({"gespraech"}),
	   "Elf: ...das wird wohl noch dauern, oder?\n"
	   +"Gestalt: Ja, das hast Du leider recht, Artyrian.\n"
	   +"Elf: Was macht eigentlich Brabo da drueben?\n"
	   +"Gestalt: Ich bin mir nicht sicher, aber ich wuerde sagen Mittagspause.\n"
	   +"Elf\(grinsend\): Sieht ihm wieder aehnlich, dem Vielfrass. Aber ich glaube "
	   +"heute hat er es sich ausnahmsweise verdient.\n"
	   +"Gestalt: Stimmt... ich werd dann mal schaun wie Irinja vorankommt...\n"
	   +"Elf: Ist gut, bis spaeter.\n");
  AddDetail(("artyrian"),
	    "Das scheint dieser grossgewachsene Elf zu sein.\n");
  AddDetail(({"vielfrass", "brabo"}),
	    "Damit scheint wohl der Hobbit mit dem breitkrempigen Hut gemeint zu sein.\n");
  AddDetail(("mittagspause"),
	    "Die Mittagspause scheint bei den Hobbits sehr beliebt zu sein.\n");
  AddDetail(({"irinja"}),
	    "Du hast keine Ahnung wer das sein soll.\n");
  AddDetail(("ahnung"),
	    "Tja, Du hast da absolut keine Ahnung.\n");
  AddSound( ({DEFAULT_SOUND, "menge"}),
            "Du hoerst Saegen, Haemmern, Klopfen und noch jede Menge weiterer Geraeusche.\n");
  AddSound( ({"geraeusche", "baustelle"}),
	    "Jede Menge Geraeusche welche auf einer Baustelle ueblich sind kannst Du "
	    +"vernehmen. Besonders die Kommandos eines Hobbits und ein Gespraech "
	    +"zwischen einer kleinen Gestalt und einem grossgewachsenem Elf ziehen "
	    +"Deine Aufmerksamkeit auf sich.\n");
  AddDetail(("baustelle"),
	    "Diese Lichtung ist zweifelsohne eine Baustelle.\n");
  AddDetail(("aufmerksamkeit"),
	    "Vielleicht solltest Du da mal genauer lauschen?\n");
  AddSound( ("saegen"),
	    "*ritscheratsche*\n");
  AddSound( ("haemmern"),
	    "*bongbongbongbong*\n");
  AddSound( ("klopfen"),
	    "*toktoktoktok*\n");  
  AddSound( ("pochen"),
	    "*pochpochpochpoch*\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"} ),
            "Es riecht hier eindeutig nach Wald aber auch nach Essen.\n");
  AddSmell(({"wald", "waldgeruch"}),
	   "Typischer Waldgeruch.\n");
  AddSmell(({"essensgeruch", "essen"}),
	   "Der Essensgeruch kommt aus den Jausenbeuteln der Hobbits.\n");
  AddSmell(({"jausenbeutel", "jausenbeuteln", "beutel", "beuteln"}),
	   "Mmmmm, riecht lecker.\n");
  AddDetail(({"jausenbeutel", "jausenbeuteln", "beutel", "beuteln"}),
	    "Die Jausenbeutel gehoeren den Hobbits.\n");
  AddDetail(({"bretter", "holzbretter"}),
	    "Die haben ein paar Menschen gerade vorbeigetragen.\n");
  AddDetail(("geschwindigkeit"),
	    "Echt schnell!\n");
  AddDetail(("nase"),
	    "Die ist zum Glueck dabei unbeschaedigt geblieben.\n");
  AddSound(({"stimme", "tiefe stimme"}),
	   "'HoooRuck, HoooRuck! Gleich haben wir es geschafft Leute!'");
  AddDetail(({"suedwesten", "stelle"}),
	    "Im Suedwesten kommst Du zu einer ziemlich dunklen Stelle des Kristallwaldes.\n");
  
  // ROOM MESSAGES
    
  AddRoomMessage( ({
   BS("Du hoerst ein lautes *RUMMS*. Da duerfte wohl irgendwo etwas heruntergefallen sein."),
     "Ein Hobbit meint: 'Und wann gibts was zu Essen?'\n",
     "Eine Fee schwirrt mit hoher Geschwindigkeit an Deiner Nase vorbei.\n",
     BS("Du hoerst einige Zwerge singen: ...Gold und Mithril das ist fein, "
	"davon darfs gleich nochmaaaal so viel sein...."),
     BS("Du hoerst eine tiefe Stimme: 'HoooRuck, HoooRuck! Gleich haben wir es "
	"geschafft Leute!'"),
     "Ein Gruppe Menschen traegt eine grosse Anzahl von Holzbrettern vorbei.\n",
     BS("Das Pochen der zwergischen Haemmer auf die Felsbloecke im Nordosten "
	"hat aufgehoert...................*POCH*, *POCH*, *POCH* ...und geht "
	"auch schon wieder weiter."),
     "*ritscheratsche*\n",
     "*bongbongbongbong*\n",
     "*toktoktoktok*\n",
     "*pochpochpochpoch*\n"}), 60);

  // EXITS  

  AddExit( "suedwesten", "/d/kristallwald/sargola/wald/room/0502.lpc"); 

  // ITEMS

  // Kinathias den Gaertner clonen.

  AddItem((NPC+"kinathias"), REFRESH_DESTRUCT);
  
  // COMMANDS 

}

void reset()
{
  ::reset();
}
