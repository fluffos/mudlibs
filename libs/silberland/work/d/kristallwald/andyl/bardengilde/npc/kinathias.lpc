inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <inpc.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

create()
{
  if (!is_clone(TO)) return;
  ::create(); 
  SetProp(P_SHORT, "Kinathias, der Gaertner");
  SetProp(P_LONG, "Kinathias ist ein grosser elfischer Gaertner mit kraeftigen Armen, "
	  +"langem, dunkelblondem Haar, gruenbraunen Augen und edlen Gesichtszuegen. "
	  +"Er scheint immer konzentriert bei der Arbeit zu sein, welche er "
	  +"offenbar sehr ernst nehmen duerfte.\n");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Kinathias");
  SetProp(P_ARTICLE, 0);
  AddId (({"kinathias", "elf", "gaertner", "Messermeister"}));
  SetProp(P_DIE_MSG, 
	  " bricht blutueberstroemt zusammen.\n");
  SetProp(P_MURDER_MSG, "Legt mir wenigstens Blumen auf mein Grab.\n");
  SetProp(P_KILL_MSG,"Du wirst mir nicht nochmal meine Arbeit verwuesten!\n");
  create_default_npc (38);
  SetProp(P_HANDS, ({" mit seinen kraeftigen Haenden", 120, DT_BLUDGEON}));
  SetProp(P_HEAL, 20);
  SetProp(P_RACE, "Elf");
  SetProp(P_ALIGN, 600);
  SetProp(P_SIZE, 190);
  SetProp(P_WEIGHT, 98000);
  SetProp( P_REJECT, ({ REJECT_DROP,
			  "Kinathias meint: Behalte das lieber.\n" }) );
  SetProp(P_RESISTANCE_STRENGTHS,
	  ([DT_HOLY: 0.1, DT_UNHOLY: 0.3]));
  
  set_living_name("kinathias");

  SetChats(1, ({
    "Kinathias summt leise eine Melodie.\n",
      "Kinathias ueberprueft gewissenhaft seine Arbeit.\n",
      "Kinathias beginnt etwas Unkraut zu jaeten.\n"
      "Kinathias brummt etwas ueber Zwergengesang.\n"}) );  

  AddInfo( DEFAULT_INFO,
	   ({ "starrt Dich etwas verwirrt an.\n",
		"meint: Das hat sicher nichts mit Pflanzen zu tun.\n",
		"zuckt mit den Schultern.\n",
		"meint: Keine Ahnung.\n",
		"kratzt sich gruebelnd am Kopf.\n"}) );
  AddInfo(("melodie"),
	  "Ach, das ist die Melodie eines alten Hobbitliedes.\n", "sagt: ");
  AddInfo(({"hobbitlied", "lied"}),
	  "Ein Lied mit einer huebschen Melodie, wie ich finde.\n", "sagt: ");
  AddInfo(("zwergengesang"),
	  "Zwergengesang moechte ich nicht naeher kommentieren.\n", "sagt: ");
  AddInfo(({"zwerge"}),
	  "Zwerge sind ja sehr geschickte Handwerker, aber ihr Zwergengesang...\n", "sagt: ");
  AddInfo(("handwerker"),
	  "Handwerker benoetigt man auf einer Baustelle wie dieser hier.\n", "sagt: ");
  AddInfo(({"lichtung", "baustelle"}),
	  "Diese Lichtung hier ist eine einzige Baustelle.\n", "sagt: ");
  AddInfo(({"gilde", "bardengilde", "barden"}),
	  "Hier soll einmal die Bardengilde stehen.\n", "sagt: "); 
  AddInfo(({"artyrian", "gildenmeister"}), 
	  "Artyrian ist der grossgewachsene Elf da drueben. " 
	     "Er ist der Gildenmeister der Bardengilde.\n", "sagt: " );
  AddInfo(({"brabo", "glasfuss", "brabo glasfuss"}), 
	  "Brabo Glasfuss? Das ist der Hobbit der da im Norden steht. Er ist ein "
	     "Instrumentenbauer aus Derlim.\n", "sagt: ");
  AddInfo(("irinja"), 
	  "Irinja ist eine bezaubernde Elfe. Sie ist Priesterin der Alinja und "
	  "eine ueberaus freundliche und weise Persoenlichkeit.\n", "sagt: ");
  AddInfo(({"bauwerk", "tempel"}),
	  "Irinja will dort zu Ehren der Goettin Alinja einen Tempel errichten lassen.\n", "sagt: ");
  AddInfo(({"alinja", "goettin", "schutzgoettin"}), 
	  "Alinja ist die Goettin der Kuenste und die Schutzgoettin der Bardengilde. "
	     "Sie wird besonders von einigen Elfen sehr verehrt.\n", "sagt: ");
  AddInfo(("gaertner"),
	  "Ich bin schon sehr lange ein Gaertner. Es ist meiner Meinung "
	     "nach der schoenste Beruf den es gibt.\n", "sagt: ");
  AddInfo(({"arbeit", "baum", "baeume", "pflanzen", "pflanze"}),
	  "Meine Arbeit ist die Pflege und Kultivierung der Baeume "
	     "und Pflanzen hier. Hier soll naemlich einmal die Bardengilde "
	     "entstehen und Artyrian bevorzugt eine lebendige Umgebung.\n", "sagt: ");
  AddInfo(({"blumen", "blume", "garten", "blumengarten"}),
	  "Blumen mag ich aussergewoehnlich gerne. Ich habe daheim einen "
	     "wunderschoenen Blumengarten angelegt. Vielleicht kannst Du ihn Dir "
	     "ja mal ansehen.\n", "sagt: ");
  AddInfo(("andyl"),
	  "Das ist der Magier der Artyrian beim Aufbau der Bardengilde hilft. "
	     "Eine ziemlich seltsame Gestalt wenn Du mich fragst. Ich glaube "
	     +"er ist eh irgendwo auf dieser Baustelle zu finden.\n", "sagt: ");
  AddInfo(("protheg"),
	  "Der schaut hier auch hin und wieder vorbei.\n", "sagt: ");
  AddInfo(({"feen", "fee"}),
	  "Einige Feen sind hier um Irinja bei ihrem Bauwerk zu helfen.\n", "sagt: ");
  AddInfo(({"hobbit", "hobbits"}),
	  "Hobbits arbeiten hier auch fleissig mit. Sie sind eigentlich sehr freundliche "
	     "Wesen nur neigen sie dazu sehr ausgedehnte Essenspausen dazwischen einzulegen.\n", "sagt: ");
  AddInfo(({"unkraut"}),
	  "Unkraut kann ueberaus zaeh sein.\n", "sagt: ");
  AddInfo(({"elfen", "elf"}),
	  "Wir Elfen sind hier im Kristallwald zuhause.\n", "sagt: ");
  AddInfo(({"kristallwald", "wald"}),
	  "Du befindest Dich hier im Kristallwald.\n", "sagt: ");
  AddInfo(({"oger", "trolle", "troll", "ork", "orks", "goblins", "goblin"}),
	  "Das sind wiederliche Kreaturen, die haben absolut nichts fuer Pflanzen ueber.\n", "sagt: ");
  AddInfo(("menschen"),
	  "Die menschlichen Handwerker die hier arbeiten sind ueberaus eifrig "
	     "bei der Sache. Man koennte fast meinen Korriax persoenlich wuerde "
	     "hier mit anpacken.\n", "sagt: ");
  AddInfo(({"woody", "silberlandgott"}),
	  "Woody ist der Silberlandgott.\n", "sagt: ");
  AddInfo(({"dusty", "silberlandgoettin"}),
	  "Dusty ist die Silberlandgoettin.\n", "sagt: ");
  AddInfo(({"magier", "erzmagier", "regionsmagier", "vollmagier", "neumagier"}),
	  "Magier sind so ein Kapitel fuer sich.\n", "sagt: ");
  AddInfo(("korriax"),
	  "Korriax war ein beruehmter Mensch. Er war einer der grossen Vier welche die "
	     "Bardengilde gegruendet haben.\n", "sagt: ");
  AddInfo(("sarrian"),
	  "Sarrian war ein beruehmter Hobbit. Er war einer der grossen Vier welche die "
	     "Bardengilde gegruendet haben.\n", "sagt: ");
  AddInfo(("tirena"),
	  "Tirena war eine beruehmte Elfe. Sie war eine der grossen Vier welche die "
	     "Bardengilde gegruendet haben.\n", "sagt: ");
  AddInfo(("alestra"),
	  "Alestra war eine beruehmte Fee. Sie war eine der grossen Vier welche die "
	     "Bardengilde gegruendet haben.\n", "sagt: ");
  AddInfo(({"vier", "gruender"}),
	  "Die grossen Vier, Alestra die Fee, Tirena die Elfe, Sarrian der Hobbit und "
	     "Korriax der Mensch waren die Gruender der Bardengilde.\n", "sagt: "); 
  AddInfo(({"elessar", "elfenstadt", "stadt"}),
	  "Elessar ist die Elfenstadt.\n", "sagt: ");
  AddInfo(({"serona"}),
	  "Serona kenne ich. Sie ist die Leiterin der Musikschule in Elessar.\n", "sagt: ");
  AddInfo(({"stirnreif", "reif", "familienerbstueck"}),
	  "Mein Stirnreif ist ein altes Familienerbstueck. Eine vorzuegliche "
	  "elfische Arbeit.\n", "sagt: ");
  AddInfo(({"kamille", "kamillenblueten", "kamillenbluete"}),
	  "Mit Kamillenblueten kann man so einige Verletzungen heilen.\n", "sagt: ");
  AddInfo(({"hose", "lederhose"}),
	  "Eine gewoehnliche Lederhose.\n", "sagt: ");
  AddInfo(({"stiefel", "lederstiefel"}),
	  "Gewoehnliche Lederstiefel.\n", "sagt: ");
  AddInfo(({"guertel", "lederguertel"}),
	  "Ein gewoehnlicher Lederguertel.\n", "sagt: ");
  AddInfo(({"dolch"}),
	  "Ein gewoehnlicher Dolch.\n", "sagt: ");
  AddInfo(({"hemd", "lederhemd"}),
	  "Das ist ein feines elfisches Lederhemd.\n", "sagt: ");
  

  SetProp(P_SPELLRATE,40);
  
  AddSpell(2,800,
	   "Kinathias murmelt ein paar Worte und ein Blitzstrahl faehrt auf Dich hernieder.\n",
	   "Kinathias murmelt ein paar Worte und ein Blitzstrahl faehrt auf @WEN hernieder.\n",
	   DT_LIGHTNING, ([SP_SHOW_DAMAGE:1]) );
  
  AddSpell(3,500,
	   "Kinathias schlaegt mit dem Dolch auf deinen Hals ein.\n",
	   "Kinathias schlaegt mit dem Dolch auf @WESSEN Hals ein.\n",
	   DT_SLASH, ([SP_SHOW_DAMAGE:1]) );
  
  AddSpell(5,400,
	   "Kinathias sticht mit seinem Dolch blitzschnell in Deine Richtung.\n",
	   "Kinathias sticht mit seinem Dolch blitzschnell in die die Richtung von @WEN.\n",
	   DT_PIERCE, ([SP_SHOW_DAMAGE:1]) );
  
  SetAttackChats(20, ({
    "Kinathias verteidigt sich verbissen.\n",
      "Kinathias wirbelt mit seinem Dolch herum.\n",
      "Kinathias sagt: Du wirst mich nicht lange von meiner Arbeit abhalten!\n"}) );
  
  CLONEME("/p/armour/belt/guertel");
  CLONEME("/p/armour/boots/lederstiefel");
  CLONEME("/p/armour/trousers/lederhose");
  CLONEME((ARMOUR+"stirnreif"));
  CLONEME((ARMOUR+"elederhemd"));
  CLONEME("/p/weapon/knife/dolch");
  CLONEME("/d/huegelland/andyl/soundquest/obj/kamille");
  CLONEME("/d/huegelland/andyl/soundquest/obj/kamille");
  CLONEME("/d/huegelland/andyl/soundquest/obj/kamille");
  CLONEME("/d/huegelland/andyl/soundquest/obj/kamille");
  command_me("trage alles");
  command_me("zuecke dolch");
}

// TANKEN

Defend(int dam, string dam_type, mixed spell, object enemy)
{
  int cur_hp;
  object ob;
  cur_hp=ME->QueryProp(P_HP);
  if((cur_hp <= 200))
    {
      if (ob=present(("kamille"),TO))
	{
	  command_me("iss kamille");
	  say(BS("Kinathias isst ein paar Kamillenblueten und sieht ploetzlich "
		 "wieder etwas besser aus.\n"));
	}
    }
  ::Defend(dam, dam_type, spell, enemy);
}


// REAKTIONEN

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
    {
    case "fies":
      call_out("react", 0, "sieht Dich veraergert an",
	       "sieht "+TP->name(WEN)+" veraergert an");
      break;
      
    case "aergerlich":
      call_out("react", 0, "grummelt etwas vor sich hin", "grummelt etwas vor sich hin");
      break;
      
    case "traurig":
      call_out("react", 0, "meint: So schlimm kann es ja wohl nicht sein, oder "+TP->name(WEN)+"?",
	       "meint: So schlimm kanns es ja wohl nicht sein, oder "+TP->name(WEN))+"?";
      break;
    case "albern":
      call_out("react", 0, "grinst belustigt",
	       "grinst belustigt");
      break;

    case "neutral":
      call_out("react", 0, "laesst sich von Dir nicht bei der Arbeit stoeren.", 
	       "laesst sich von "+TP->name(WEN)+" nicht bei der Arbeit stoeren");
      break;

    case "intim":
      if (TP->QueryProp(P_GENDER)==MALE)
	call_out("react", 0, "meint: Lass das, "+TP->name(WEN),
		 "meint: Lass das , "+TP->name(WEN));
      if (TP->QueryProp(P_GENDER)==FEMALE)
	call_out("react", 0, "meint: Schoen Dich kennenzulernen, "+TP->name(WEN),
		 "meint: Schoen Dich kennenzulernen, "+TP->name(WEN));
      break;
      
    case "froh":
      call_out("react", 0, "laechelt",
	       "laechelt");
      break;
      
    case "aengstlich":
      call_out("react", 0, "verwuschelt Dir die Haare",
	       "verwuschelt "+TP->name(WEN)+" die Haare");
      break;
      
    case "frech":
      call_out("react", 0, "grummelt etwas veraergert", 
	       "grummelt etwas veraergert");
      break;
      
    case "nett":
      call_out("react", 0, "grinst Dich an", 
	       "grinst "+TP->name(WEN)+" an");
     break;
    }
}

void react(string victim, string others)
{
 if (present(TP, ENV(TO))) 
  {
     tell_object(TP, BS(Name(WER, 1) + " "+victim+"."));
   tell_room(ENV(TO), BS(Name(WER, 1)+" "+others+"."), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
