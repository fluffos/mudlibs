inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein silberner Stirnreif");
  SetProp(P_LONG, 
	  "Ein silberner Stirnreif in dessen Metall etliche Verzierungen "
	  +"eingeritzt wurden. Es handelt sich dabei eindeutig um elfische "
	  +"Handwerkskunst.");
  SetProp(P_NAME, "Stirnreif");
  SetProp(P_INFO, 
	  "Dieser Stirnreif scheint etwas Schutz vor Magie zu bieten.");
  SetProp(P_GENDER, MALE);
  AddId( ({"stirnreif", "reif"}) );
  SetProp(P_MAGIC, 1);
  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_SILVER:100]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1200);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:1, T_HEAT_PROT:1 ]) );
  SetProp(P_DEFEND_FUNC, ME);
  SetProp(P_DAM_PROTECTION,
	  QueryProp(P_DAM_PROTECTION)+([DT_FIRE:1,DT_MAGIC:1,DT_MAGIC:1,DT_UNHOLY:1]) );
  
  AddDetail(({"verzierungen"}),
	    "Die Verzierungen am silbernen Stirnreif scheinen keine besondere "
	    "Bedeutung zu haben, aber sie sind in jedem Fall eine wunderschoene "
	    "Arbeit elfischer Herkunft.\n");
  AddDetail(({"metall", "silber"}),
	    "Reines Silber.\n");
  AddDetail(({"handwerkskunst"}),
	    "Eindeutig elfische Handwerkskunst.\n");
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  if(sizeof(dam_type & ({ DT_MAGIC, DT_FIRE, DT_WATER, DT_LIGHTNING })))
    {
      if( !random(4) )
	{
	  tell_object (QueryProp(P_WORN),
		       "Der silberne Stirnreif leuchtet ploetzlich kurz auf.\n");
	  tell_room(environment(this_player()), "Der Stirnreif von "
		    +(TO->QueryProp(P_WORN))->name(WER)+ " leuchtet kurz auf.\n");
	  return 2+random(8);
	}
      return 0;
    }
  return 0;
}
