#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein silberner Stirnreif");
  SetProp(P_LONG, 
	  "Ein silberner Stirnreif in dessen Metall etliche Verzierungen "
	  "eingeritzt wurden. Es handelt sich dabei eindeutig um elfische "
	  "Handwerkskunst.");
  SetProp(P_NAME, "Stirnreif");
  SetProp(P_INFO, 
	  "Dieser Stirnreif scheint etwas Schutz vor Magie zu bieten.");
  SetProp(P_GENDER, MALE);
  AddId(({"stirnreif", "reif"}));
  SetProp(P_MAGIC, 1);
  SetProp(P_ITEMD_NO_MAGIC, 1);
  
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_SILVER:100]));
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1200);
  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:0, T_HEAT_PROT:1]));
  SetProp(P_DEFEND_FUNC, ME);
  SetProp(P_DAM_PROTECTION,
	  QueryProp(P_DAM_PROTECTION)+([DT_MAGIC:1]));
  
  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:10, P_LEVEL:10, P_FROG:1]));
  
  AddDetail(({"verzierungen"}),
	    "Die Verzierungen am silbernen Stirnreif scheinen keine besondere "
	    "Bedeutung zu haben, aber sie sind in jedem Fall eine "
	    "wunderschoene Arbeit elfischer Herkunft.");
  AddDetail(({"metall", "silber"}),
	    "Reines Silber.");
  AddDetail(({"handwerkskunst"}),
	    "Eindeutig elfische Handwerkskunst.");
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  if(!pointerp(dam_type))
    dam_type=({dam_type});
  
  if((!random(4)) && (sizeof(dam_type & ({ DT_MAGIC }))))
    {
      tell_object(QueryProp(P_WORN),
		  BS("Dein silberner Stirnreif leuchtet kurz auf."));

      tell_room(ENV(QueryProp(P_WORN)), 
		BS("Der Stirnreif von "+(QueryProp(P_WORN))->name(WEM)+ 
		   " leuchtet kurz auf."));
      
      return 2+random(8);
    }
  
  return 0;
}
