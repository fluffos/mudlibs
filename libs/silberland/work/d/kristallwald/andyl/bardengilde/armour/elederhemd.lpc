inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  AddId (({"elfenhemd","hemd", "lederhemd"}));
  SetProp (P_SHORT, "Ein elfisches Lederhemd");
  SetProp (P_LONG,
	   "Ein schlichtes, hellbraunes elfisches Lederhemd. Es ist "
	   +"sehr sorgfaeltig gearbeitet und ziemlich kleidsam.\n");
  SetProp (P_NAME, "Lederhemd");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 500);
  SetProp (P_VALUE, 450);
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 11);
  SetProp (P_MATERIAL, ([MAT_LEATHER:95, MAT_COTTON:5]));
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:3, T_HEAT_PROT:1 ]) );
}










