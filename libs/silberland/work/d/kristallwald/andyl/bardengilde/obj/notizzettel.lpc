inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"
#include <defines.h>
#include <moredef.h>

nosave string begabung;

// Begabung kann "mies", "schlecht", "durchschnitt",
// "gut" und "super" sein.

void create()
{
  if (!is_clone(this_object())) return; 
  
  ::create();
  
  AddId(({"notizzettel", "zettel", "\nseronanotizzettel"}));
  SetProp(P_SHORT, "Ein Notizzettel");
  SetProp(P_LONG, "Dies ist der Notizzettel den Dir Serona mitgegeben hat. "
	  +"Du kannst ihn lesen.\n");
  SetProp(P_INFO, "Dieser Notizzettel ist zu 100\% aus Altpapier.\n");
  SetProp(P_NAME, "Notizzettel");
  SetProp(P_GENDER, MALE);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 10);
  SetProp(P_MATERIAL, ([MAT_PAPER:100]));
  AddCmd(({"lese", "lies"}), "lies_was");
}

lies_was(str)
{
  
  notify_fail(BS("Was willst Du lesen?\n"));
  if (!str) return 0;
  if (( str == "zettel" || str == "notiz" || str == "notizzettel"))
    {
      write("\nFolgendes sollst Du fuer mich besorgen "+TP->name(WER,0)+":\n"
	    +"Eine Mango aus dem Dschungel.\n"
	    +"Sie wird dringend zur Herstellung eines Pflegeoels benoetigt.\n"
	    +"Mangos sind angeblich auf einer Plantage irgendwo suedlich\n"
	    +"von Tijara zu finden. Bitte vergiss nicht darauf.\n"
	    +"Sobald ich sie habe bekommst Du natuerlich sofort\n"
	    +"Dein Empfehlungsschreiben.\n"
	    +"\n"
	    +"Danke, Serona\n");
      return 1;
    }
  else return 0;
}

SetBegabung(string str1)
{
  begabung=str1;
}

zettel2schreiben()
{
  object ob;
  if (!ob=present("\nbardenempfehlungsschreiben"),TP)
    {
      CLONE(OBJ+"empfehlungsschreiben",(TP));
      present("\nbardenempfehlungsschreiben", TP) -> SetBegabung(begabung);
    } 
  TO->remove();
}











