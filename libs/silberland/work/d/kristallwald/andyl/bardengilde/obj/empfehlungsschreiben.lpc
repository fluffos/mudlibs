inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"
#include <defines.h>
#include <moredef.h>

nosave string begabung;

// begabung kann "mies", "schlecht", "durchschnitt", 
// "gut" oder "super" sein

void create()
{
  if (!is_clone(this_object())) return; 
  
  ::create();
  
  AddId(({"schreiben", "empfehlungsschreiben", "\nbardenempfehlungsschreiben"}));
  SetProp(P_SHORT, "Ein Empfehlungsschreiben");
  SetProp(P_LONG, "Dies ist das Empfehlungsschreiben welches Dir Serona fuer "
	  +"Artyrian mitgegeben hat. Du kannst es lesen.\n");
  SetProp(P_INFO, "Ein Empfehlungsschreiben ohne besondere Merkmale.\n");
  SetProp(P_NAME, "Empfehlungsschreiben");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 10);
  SetProp(P_MATERIAL, ([MAT_PAPER:100]));
  AddCmd(({"lese", "lies"}), "lies_was");
}

SetBegabung(string str1)
{
  begabung=str1;
}

lies_was(str)
{
  
  notify_fail(BS("Was willst Du lesen?\n"));
  if (!str) return 0;
  if (( str == "schreiben" || str == "empfehlungsschreiben" ))
    {
      write("\nLieber Artyrian!\n"
	    +"\n"
	    +TP->name(WER,0)+" hat bei mir Musikstunden genommen um\n"
	    +"dieses Empfehlungsschreiben fuer die Bardengilde zu erhalten.\n"
	    +"Folgendes kann ich Dir nun ueber "+TP->name(WER,0)+" berichten:\n");
      if (begabung=="mies")
	{
	  if ((TP->QueryProp(P_GENDER))==MALE)
	    {
	      write(BS(TP->name(WER, 0)+" war ein miserabler Schueler aber\n"
		    +"wenigstens sehr ausdauernd. Ich hoffe mit deinem Geschick\n"
		    +"gelingt es Dir einen brauchbaren Barden aus ihm zu machen.\n")); 
	    }
	  else
	    {
	      write(BS(TP->name(WER, 0)+" war eine miserable Schuelerin aber\n"
		     +"wenigstens sehr ausdauernd. Ich hoffe mit deinem Geschick\n"
		    +"gelingt es Dir eine brauchbare Bardin aus ihr zu machen.\n")); 
	    }
	}
      if (begabung=="schlecht")
	{
	  if ((TP->QueryProp(P_GENDER))==MALE)
	    {
	      write(BS(TP->name(WER, 0)+" war kein besonders guter Schueler aber\n"
		    +"er hat sich bemueht. Ich hoffe mit deinem Geschick\n"
		    +"gelingt es Dir einen brauchbaren Barden aus ihm zu machen.\n")); 
	    }
	  else
	    {
	      write(BS(TP->name(WER, 0)+" war keine besonders gute Schuelerin aber\n"
		    +"sie hat sich bemueht. Ich hoffe mit deinem Geschick\n"
		    +"gelingt es Dir eine brauchbare Bardin aus ihr zu machen.\n")); 
	    }
	}
      if (begabung=="durchschnitt")
	{
	  if ((TP->QueryProp(P_GENDER))==MALE)
	    {
	      write(BS(TP->name(WER, 0)+" war ein durchschnittlicher Schueler aber\n"
		    +"mit deinem Geschick gelingt es Dir sicher einen guten\n"
		    +"Barden aus ihm zu machen.\n")); 
	    }
	  else
	    {
	      write(BS(TP->name(WER, 0)+" war eine durchschnittliche Schuelerin aber "
		    +"mit deinem Geschick gelingt es Dir eine gute\n"
		    +"Bardin aus ihr zu machen.\n")); 
	    } 
	}
      if (begabung=="gut")
	{
	   if ((TP->QueryProp(P_GENDER))==MALE)
	    {
	      write(BS(TP->name(WER, 0)+" war ein guter Schueler und\n"
		    +"ich bin ueberzeugt, dass er einen guter Barde werden wird.\n")); 
	    }
	  else
	    {
	      write(BS(TP->name(WER, 0)+" war eine gute Schuelerin und\n"
		    +"ich bin ueberzeugt, dass sie eine gute Bardin werden wird.\n"));
	    }
	}
      if (begabung=="super")
	{
	  if ((TP->QueryProp(P_GENDER))==MALE)
	      {
		write(BS(TP->name(WER, 0)+" war ein ausgezeichneter Schueler und\n"
		      +"ich bin ueberzeugt, dass Du Deine helle Freude mit ihm haben\n"
		      +"wirst und er ein sehr guter Barde werden wird.\n")); 
	      }
	  else
	    {
	      write(BS(TP->name(WER, 0)+" war eine ausgezeichnete Schuelerin und\n"
		    +"ich bin ueberzeugt, dass Du Deine helle Freude mit ihr haben\n"
		    +"wirst und sie eine sehr gute Bardin werden wird.\n"));
	    }
	  
	}
      write("\nLiebe Gruesse, Serona.\n");
      return 1;
    }
  else return 0;
}











