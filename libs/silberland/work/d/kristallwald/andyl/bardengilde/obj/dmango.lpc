/* eine gute mango dante 97 jaenner
**
** 
** 
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp (P_SHORT, "Eine Mango");
  SetProp (P_LONG, "Eine saftige Mango aus den Gaerten des Dschungels.\n");
     
  SetProp (P_NAME, "Mango");
  SetProp (P_GENDER, FEMALE);
  AddId (({"mango", "frucht","\nplantangenfrucht"}));
  SetProp (P_INFO, ("Die Mango ist eine besonders leckere Frucht."));
  SetProp (P_VALUE, 40);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 0);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL: 12, F_SOAK: 4, F_ALCOHOL: 0, F_POISON:0]));
}

