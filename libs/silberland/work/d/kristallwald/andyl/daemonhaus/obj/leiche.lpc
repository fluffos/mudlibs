inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
  if (!is_clone(this_object())) return; 
  
  ::create();
  
  AddId(({"leiche", "elf", "elfenleiche", "besitzer", "hausbesitzer"}));
  AddId(("\ndaemonhausobj"));
  SetProp(P_SHORT, "Die Leiche eines Elfen");
  SetProp(P_LONG, "Die grausam verstuemmelte Leiche eines Elfen. "
	  +"Das war wohl der unglueckliche Hausbesitzer. Sein Koerper wuerde "
	  +"von etwas regelrecht zerfleischt. Sein Blut klebt hier ueberall "
	  +"im Raum. Wahrscheinlich steckt ein boeser Daemon hinter dieser "
	  +"grausamen Tat.\n");
  SetProp(P_NAME, ({"Leiche"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOGET, 1);
  SetProp(P_WEIGHT, 40000);
  SetProp(P_MATERIAL, MAT_MISC_DEAD);
}











