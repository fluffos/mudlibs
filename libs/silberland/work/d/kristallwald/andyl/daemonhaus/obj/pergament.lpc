inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return; 
  
  ::create();
  
  AddId(({"pergament", "\npergament"}));
  AddId(("\ndaemonhausobj"));
  SetProp(P_SHORT, "Ein geheimnisvolles Pergament");
  SetProp(P_LONG, "Ein altes, geheimnissvolles Pergament. "
	  +"Es ist schon stark abgenutzt. Dennoch kannst Du "
	  +"einige Schriftzeichen darauf erkennen. Was fuer "
	  +"Geheimnisse die wohl in sich bergen?\n");
  SetProp(P_NAME, "Pergament");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 10);
  SetProp(P_MATERIAL, MAT_PERGAMENT);

  AddDetail(({"zeichen", "schriftzeichen"}),
	    "Du koenntest versuchen sie zu lesen.\n");
  AddCmd(({"lese", "lies"}), "lies_was");
}

lies_was(str)
{
  notify_fail("Was willst Du lesen?\n");
  if (!str) return 0;
  if ((str=="zeichen" || str=="schriftzeichen"))
    {
      write(BS("Hier steht spaeter mal was gaaaaanz "
	       +"wichtiges."));
      return 1;
    }
  else return 0;
}








