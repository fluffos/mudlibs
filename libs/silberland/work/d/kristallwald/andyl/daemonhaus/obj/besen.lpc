inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
  if (!is_clone(this_object())) return; 
  
  ::create();
  
  AddId(({"besen", "reisigbesen", "\nreisigbesen"}));
  AddId(("\ndaemonhausobj"));
  SetProp(P_SHORT, "Ein alter Reisigbesen");
  SetProp(P_LONG, "Ein alter Reisigbesen. "
	  +"Damit hat sicher schon lange keiner mehr gekehrt. "
	  +"Das koenntest Du ja vielleicht aendern...\n");
  SetProp(P_NAME, "Reisigbesen");
  SetProp(P_GENDER, MALE);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 10);
  SetProp(P_MATERIAL, MAT_MISC_HERBAL);
}











