#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int kasten=0; 
int besen=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:19, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Am Dachboden");
  SetProp (P_INT_LONG, "Das hier ist der Dachboden der Daemonenbehausung. "
	   +"Schwach dringt das Sonnenlicht durch ein paar Ritzen im Dach herein. "
	   +"Es riecht hier stark nach Verwesung und Tod, was aber auch nicht "
	   +"weiter verwunderlich ist, da hier in einer Ecke eine maennliche "
	   +"Elfenleiche liegt welche arg verstuemmelt wurde. Blut und "
	   +"andere Koerperfluessigkeiten dazu noch Koerperteile kleben an den Waenden "
	   +"und am Boden. Auch liegt hier so allerlei Geruempel herum. Auch "
	   +"einen alten Kasten kannst du entdecken. Ueber eine Leiter kommst "
	   +"Du wieder zurueck in den Wohnraum des Hauses.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START;
  AddDetail(({"boden", "holzboden"}),
	    "Der Holzboden ist mit Staub, Blut und anderen getrockneten "
	    +"Koerperfluessigkeiten bedeckt. Eine Luke ist in den Boden "
	    +"eingelassen.\n");
  AddDetail(({"dachboden", "raum"}),
	    "Du befindest Dich hier am Dachboden der Daemonenbehausung.\n");
  AddDetail(("haus"),
	    "Es ist ein altes baufaelliges Haus.\n");
  AddDetail(({"daemon", "frage"}),
	    "Hier ist sicher irgendwo ein Daemon. Die Frage ist nur wo.\n");
  AddDetail(({"ritzen", "ritze"}),
	    "Im Dach sind viele Ritzen durch welches das Sonnenlicht hereindringt.\n");
  AddDetail(({"sonnenlicht", "licht"}),
	    "Es scheint durch die Ritzen im Dach.\n");
  AddDetail(({"daemonenbehausung", "behausung"}),
	    "Hier duerfte die Behausung eines boesartigen Daemons sein. "
	    +"Zumindest spricht einiges dafuer.\n");
  AddDetail(({"luke", "leiter", "wohnraum"}),
	    "Durch die Luke, ueber die Leiter, kommst Du wieder in den "
	    +"Wohnraum des Hauses.\n");
  AddDetail(({"staub"}),
	    "Der Staub ist fast ueberall, an den Waenden, dem Boden und an "
	    +"der Decke. Meistens ist er auch noch mit getrocknetem Blut "
	    +"vermengt.\n");
  AddDetail(({"ecke", "eck"}),
	    "Im Eck liegt ein maennliche Elfenleiche.\n");
  AddDetail(({"tod", "skelett", "umhang", "sense", "besuch"}),
	    "Tod: Grosses schwarzes Skelett mit Umhang und scharfer "
	    +"Sense. Wahr hier wohl vor nicht allzu langer Zeit zu "
	    +"Besuch.\n");
  AddDetail(("zeit"),
	    "Deine Zeit wird auch noch kommen.\n");
  AddDetail(({"verwesung"}),
	    "Die Leiche hier macht das gerade. Der Verwesungsgeruch "
	    +"ist nicht zu ueberriechen.\n");
  AddDetail(({"verwesungsgeruch"}),
	    "Der ist nicht zu ueberriechen.\n");
  AddDetail(({"leiche", "elfenleiche", "elf"}),
	    "Eigentlich sollte die hier liegen.\n");  
  AddDetail(({"wand", "waende"}),
	    "Die Waende sind alle aus altem, morschen Holz. Sie sind zur "
	    +"Gaenze mit Blut und anderen Koerperfluessigkeiten bedeckt.\n");
  AddDetail(({"gaenze", "detail", "details"}),
	    "Solch unnuetze Details zu untersuchen schreit eigentlich "
	    +"nach einer Scriptfalle.\n");
  AddDetail(({"falle", "scriptfalle"}),
	    "Nein. Hier gibts keine, schon zufleiss nicht. So, das hast "
	    +"Du nun davon.\n");
  AddDetail(("blut"),
	    "Das klebt hier fast ueberall, an den Waenden, dem Boden und "
	    +"sogar an der Decke. Es duerfte zu der bedauernswerten Leiche "
	    +"gehoeren.\n");
  AddDetail(({"koerperfluessigkeiten", "fluessigkeiten", "koerperteile", "teile"}),
	    "Blut, und andere Koerperfluessigkeiten und Koerperteile kleben hier ueberall. "
	    +"Um Dir nicht den Appetit zu verderben wird das jetzt nich alles "
	    +"detailiert aufgelistet.\n");
  AddDetail(({"appetit"}),
	    "Den willst Du Dir doch nicht verderben? Wenn doch dann untersuche "
	    +"halt das geschmacklose Zeug.\n");
  AddDetail(({"zeug", "magensaefte", "saefte", "dreingabe", "niere", "gehirn",
		"sehnen", "muskeln", "leber", "milz", "herz", "herzens"}),
	    "Also gut. Du hast es nicht anders gewollt: Hier kleben Blut, diverse "
	    +"Magensaefte, Teile der Leber, der Niere, des Gehirns und ausserdem "
	    +"Teile von Sehnen und Muskeln. Dazu kommt noch einige Teile der Leber "
	    +"und der Milz. Als Dreingabe gibts auch noch einige Teile des Herzens. "
	    +"So, und jetzt beschwer Dich ja nicht wenn der schlecht wird.\n");
  AddDetail(("sonne"),
	    "Gross, rund, mehrere Millionen Grad heiss. Scheint mit ihrem "
	    +"Licht durch die zahlreichen Ritzen im Dach.\n");
  AddDetail(({"grad", "millionen"}),
	    "Mehrere Millionen Grad ist sehr heiss um nich zu dagen hoellisch heiss.\n");
  AddDetail(({"holz", "buchenholz"}),
	    "Ganz gewoehnliches Buchenholz.\n");
  AddDetail(("decke"),
	    "Das Dach des Hauses bildet hier die Decke.\n");
  AddDetail(({"dach", "stellen"}),
	    "Das Dach hat auch schon bessere Tage gesehen. An vielen Stellen "
	    +"ist es undicht. Durch zahlreiche Ritzen scheint das Sonnenlicht "
	    +"herein.\n");
  AddDetail(({"tage", "tag", "stunden", "stunde"}),
	    "Tage: Ein Tag sind 24 Stunden. Schon irgendwann mal gehoert, oder?\n");
  AddDetail(({"geruempel", "menge", "geruempel", "wichtiges"}),
	    "Hier liegt eine Menge Geruempel herum. Ob da wohl etwas Wichtiges "
	    +"dabei ist? Du solltest es vielleicht durchsuchen.\n"); 
  AddDetail(({"pergament"}),
	    "Es ist zwischen dem Geruempel eingeklemmt. Man koennte versuchen "
	    +"es herauszuziehen.\n"); 
  AddSpecialDetail(("kasten"), "kasten_schau");  
  AddSmell(("verwesungsgeruch"),
	   "Iehhh. Riecht schlicht und ergreifend ekelhaft.\n"); 
  AddSound( DEFAULT_SOUND,
	    "Totenstille. Im wahrsten Sinne des Wortes.\n");
  AddDetail(("wort"),
	    "Hmm, das soll ich jetzt wirklich erklaeren?\n");
  AddDetail(({"sinn", "sinne", "leben"}),
	    "Sinne gibt es viele. Doch was ist eigentlich der "
	    +"Sinn des Lebens?\n");  
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es stinkt fuerchterlich nach Verwesung. Du musst Dich "
	    +"eh schon zusammenreissen, dass Du Dich nicht uebergibst.\n");
 
  // COMMANDS START
  AddCmd(({"durchsuche", "durchsuch"}), "durchsuche_was");
  AddCmd(({"ziehe", "zieh"}), "ziehe_was");
  AddCmd(({"oeffne"}), "oeffne_was");
  AddCmd(({"nimm"}), "nimm_was");
  // COMMANDS END

  
  // EXITS START
  AddExit(("runter"), ROOM+"haus");
  // EXITS END

  
  // ITEMS START
  AddItem((OBJ+"leiche"), REFRESH_REMOVE);
  // ITEMS END
}

kasten_schau()
{
  if (kasten==1)
    {
      write(BS("Ein ganz gewoehnlicher Kasten. Er ist offen."));
      if (besen==1)
	{
	  return(BS("Ein Besen steht darin.\n"));
	}
      else return(BS("Es ist nichts drinnen.\n"));
    }
  else 
    {
      return(BS("Ein ganz gewoehnlicher Kasten. Er ist geschlossen.\n"));
    }
}

durchsuche_was(str)
{
  notify_fail("Was willst Du durchsuchen?\n");
  if ((str=="geruempel"))
     {
       write(BS("Bei genauerer Durchsuchung des Geruempels "
		+"faellt dir eine altes Pergament auf.\n"));
       return 1;
     }
  else return 0;
}

ziehe_was(str)
{
  object ob;
  notify_fail("Was willst Du herausziehen?\n");
  if ((str=="pergament" || str=="pergament heraus" || 
       str=="pergament aus geruempel" || str=="pergament aus geruempel heraus")) 
    {
      if (!ob=present(("\npergament"),TP))
	{
	  write(BS("Du ziehst das Pergament aus dem Geruempel und "
		   +"steckst es ein.\n"));
	  CLONE(OBJ+"pergament", (TP));
	  return 1;;
	}
      else
	{
	  write("Du hast das Pergament doch schon.\n");
	  return 1;
	}     
    }
  else return 0;
}

oeffne_was(str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if(str=="kasten")
    {
      if (kasten==1)
	{
	  write(BS("Der Kasten ist doch schon offen.\n"));
	  return 1;
	}
      else 
	{
	  write(BS("Du oeffnest den Kasten.\n"));
	  kasten=1;
	  return 1; 
	} 
    }
}


nimm_was(str)
{
  object ob;
  notify_fail("Was willst Du nehmen?.\n");
  if(str=="besen")
    {
      if (kasten==1)
	{
	  if (besen==1)
	    {        
	      if (!ob=present(("\nreisigbesen"),TP))
		{
		  write("Du nimmst einen Besen.\n");
		  CLONE(OBJ+"besen", (TP));
		  besen=0;
		  return 1;
		}
	      else
		{
		  write(BS("Du hast doch schon einen Besen.\n"));
		  return 1;
		}
	    }
	  else return 0;
	}
      else return 0;
    }
  else return 0;
}


reset()
{
  besen=1;
  kasten=0;
}






















