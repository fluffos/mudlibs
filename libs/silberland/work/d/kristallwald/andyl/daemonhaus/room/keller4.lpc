#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int kreide=1;
int rassel=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "In einer Werkstatt");
  SetProp (P_INT_LONG, "Du befindest Dich jetzt in einer eigenartig "
	   +"anmutenden Werkstatt. Eine grosse Werkbank fuellt einen grossen "
	   +"Teil des Raumes, neben der Du auch noch eine Tafel mit seltsamen "
	   +"Skizzen entdecken kannst. Die Werkbank ist mit allerlei Materialien "
	   +"uebersaet und die Anordnung derselben laesst kein System erkennen. "
	   +"Es gibt zwei Gaenge die jeweils nach Nordosten und Suedosten fuehren.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START;
  
  AddDetail(({"gang", "gaenge"}),
	    "Du siehst hier zwei Gaenge. Einer fuehrt nach Nordosten, der andere "
	    +"nach Suedosten.\n");
  AddDetail(("glueck"),
	    "Glueck kann man immer brauchen.\n");
  AddDetail(("boden"),
	    "Ein einfacher Boden aus Steinplatten, welcher in keinem gutem "
	    +"Zustand ist.\n");
  AddDetail(("zustand"),
	    "Der Zustand des Bodens ist nicht gerade ueberwaeltigend.\n");
  AddDetail(("decke"),
	    "Die Decke besteht aus grob gezimmerten Holzlatten, welche jedoch "
	    +"einen sehr soliden Eindruck auf Dich machen.\n");
  AddDetail(("eindruck"),
	    "Der erste Eindruck kann taeuschen, also traue ihm nicht.\n");
  AddDetail(({"latten", "holzlatten"}),
	    "Die Holzlatten sind zwar nur sehr grob gezimmert und scheinen "
	    +"zudem auch noch sehr alt zu sein, erwecken aber dennoch einen "
	    +"sehr robusten Eindruck.\n");
  AddDetail(({"steinplatten", "platten"}),
	    "Grob gehauene Steinplatten, keine sehr gute Steinmetzarbeit. Viele "
	    +"Platten sind bereits zerbrochen.\n");
  AddDetail(({"steinmetzarbeit", "steinmetzarbeiten"}),
	    "Tja, fuer Steinmetzarbeiten sollte man immmer einen faehigen "
	    +"Zwerg zu Rate ziehen.\n");
  AddDetail(({"zwerg", "zwerge"}),
	    "Klein, geldgierig, geschickt, sturkoepfig und relativ trinkfest. "
	    +"Zwerge eben.\n");
  AddDetail(({"rate", "rat"}),
	    "Guter Rat ist ja leider meistens teuer.\n");
  AddDetail(({"waende", "wand", "steinwand", "steinwaende"}),
	    "Simple Steinwaende ohne besonderen Merkmalen.\n");
  AddDetail(({"merkmale", "merkmal"}),
	    "Du kannst keine besondern Merkmale an den Waenden erkennen.\n");
  AddDetail(({"raum", "werkstatt"}),
	    "Dieser Raum scheint eindeutig eine Werkstatt darzustellen. Nur "
	    +"welchem Zweck sie dient muss man erst einmal herausfinden.\n");
  AddDetail(({"zweck", "mittel", "fall"}),
	    "Der Zweck heiligt die Mittel heisst es. Ob dies in diesem "
	    +"Fall stimmt? Du bezweifelst dies doch deutlich.\n");
  AddDetail(({"bank", "werkbank", "teil"}),
	    "Die Werkbank fuellt einen grossen Teil des Raumes aus. Sie "
	    +"besteht aus massivem Eisen und ist mit einer Unzahl von "
	    +"Materialien uebersaet.\n");
  AddDetail(("unzahl"),
	    "Ja, es sind wirklich viele.\n");
  AddDetail(({"eisen", "stellen"}),
	    "Das Eisen der Werkbank ist an vielen Stellen bereits verrostet.\n");
  AddDetail(({"anordnung", "system"}),
	    "Die Anordnung der Materialien laesst kein besonderes System erkennen. "
	    +"Es scheint sich hier eher um eine ziemliches Chaos zu handeln.\n");
  AddDetail(({"chaos", "zerstoerer", "ordnung"}),
	    "Chaos, Zerstoerer der Ordnung.\n");
  AddDetail(({"material", "materialien"}),
	    "Du siehst verschiedene Holzarten, einige Metalle und einige Steine.\n");
  AddDetail(({"holzarten", "holzart", "eiche", "buche", "fichte", 
		"kristallwaldholz", "art", "arten"}),
	    "Unter den Holzarten erkennst du Eiche, Buche, Fichte, Kristallwaldholz "
	    +"und einige Arten welche Du nicht kennst.\n");
  AddDetail(({"metalle", "metall"}),
	    "Du siehst viele verschiedene Metalle, wobei Dir bei einem Metall, " 
	    +"welches wie Zinn aussieht, etwas auffaellt.\n");
  AddSpecialDetail(({"zinn", "metall"}), "metall_schau");
  AddDetail(("steine"),
	    "Ganz gewoehnliche Steine. Manche davon sin klein, manche wieder "
	    +"groesser. Leider scheinen keine Edelsteine dabei zu sein.\n");
  AddDetail(("edelsteine"),
	    "Leider scheint es hier keine zu geben.\n");
  AddDetail(({"skizze", "skizzen"}),
	    "Die Skizzen scheinen allesamt Folterinstrumente darzustellen. "
	    +"Ein Glueck, dass sie nie verwirklicht wurden.\n");
  AddDetail(({"folterinstrument", "folterinstrumente", "tode", "unschuldige"}),
	    "Die Folterinstrumente wurden zum Glueck nie gebaut. "
	    +"Wer weiss wieviele Unschuldige an ihnen zu Tode gekommen "
	    +"waeren.\n");
  AddDetail(("tafel"),
	    "Eine schwarze Tafel, auf welche allerlei Skizzen gezeichnet wurden. "
	    +"An dem unteren Teil der Tafel kannst Du etwas Weisses entdecken.\n");
  AddSpecialDetail(({"weisses", "weiss"}), "weisses_schau");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Riecht zwar etwas muffig hier, aber ansonsten wurde Dir nichts "
	    +"naeher auffallen.\n");
  AddSound( DEFAULT_SOUND,
	    "Ein sehr leises Rasseln ist von Osten her zu hoeren.\n");
  AddSound(("rasseln"),
	   "Es ist kaum hoerbar.\n");
  // EXITS START
  AddExit ("nordosten", ROOM+"keller1");  
  AddExit ("suedosten", ROOM+"keller3");
  // EXITS END

  // COMMANDS START
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

weisses_schau()
{

  return(BS("hier gibts no nix bloed zum schaun"));
  
}

metall_schau()
{

  return(BS("hier gibts no nix bloed zum schaun"));
  
}



void reset()
{
  ::reset();
  kreide=1;
  rassel=1;
}





















