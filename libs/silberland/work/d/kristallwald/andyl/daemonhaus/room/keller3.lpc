#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "In einem Vorratskeller");
  SetProp (P_INT_LONG, "Du bedindest Dich jetzt in einem ungewoehnlichem "
	   +"Vorratskeller. Ueberall stehen Kaesten mit vielen Regalen, in "
	   +"welchen haufenweise Amphoren, Flaeschchen und Tiegel mit den "
	   +"eigenartigsten Substanzen herumstehen. Es riecht hier sehr "
	   +"streng aber es ist zum Glueck auszuhalten. Zwei Gaenge fuehren "
	   +"von hier fort, einer nach Nordosten, der andere nach Nordwesten. "
	   +"Ausserdem siehst Du noch eine Tuer im Norden.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START;
  AddDetail(({"gaenge", "gang"}),
	    "Du siehst hier zwei Gaenge. Einer fuehrt nach Nordosten, der "
	    +"andere nach Nordwesten.\n"); 
  AddDetail(({"glueck", "lebenslage"}),
	    "Glueck kann man immer gebrauchen, egal in welcher Lebenslage.\n");
  AddDetail(("decke"),
	    "Einfache Holzlatten bilden die Decke.\n");
  AddDetail(({"holzlatten", "latten"}),
	    "Solide alte Holzlatten. Gut fuer Dich, denn sonst "
	    +"wuerde die Decke wahrscheinlich jetzt auf Dich zubeschleunigen.\n");
  AddDetail(("boden"),
	    "Der Boden besteht aus grob behauenen Steinplatten. Keine sehr schoene "
	    +"Arbeit.\n");
  AddDetail(({"platten", "steinplatten"}),
	    "Grob behauene Steinplatten. Nichts aussergewoehnliches.\n");
  AddDetail(("arbeit"),
	    "Eine schoene Arbeit ist der Boden wirklich nicht. Da hat wohl irgendwer "
	    +"wieder einen Pfusch gemacht.\n");
  AddDetail(({"wand", "waende", "steinwaende", "steinwand"}),
	    "Schlichte Steinwaende.\n"); 
  AddDetail(("pfusch"),
	    "Du weisst schon. Sowas machen die Magier doch eh dauernd.\n");
  AddDetail(("magier"),
	    "Magier sind diejenigen, wegen denen nichts im Silberland funktioniert.\n");
  AddDetail(({"silberland", "detail"}),
	    "Juhu, Du hast soeben das ganze Silberland in nur einem Detail erforscht. "
	    +"Jetzt hast Du sicher alle Forscherpunkte die Dir noch fehlen bekommen.\n");
  AddDetail(("forscherpunkte"),
	    "Du hast jetzt alle moeglichen.\n");
  AddDetail(({"keller", "vorratskeller"}),
	    "Wie Du unschwer erkennen kannst, bist Du hier in einem Vorratskeller. "
	    +"Ueberall stehen Kaesten mit vielen Regalen herum.\n");
  AddDetail(("tuer"),
	    "Die Tuer fuehrt in einen Raum im Norden.\n");
  AddDetail(("raum"),
	    "In dem Raum im Norden scheinen seltsame Dinge vor sich zu gehen.\n");
  AddDetail(("dinge"),
	    "Dinge von denen du lieber nichts wissen willst.\n");
  AddDetail(({"kasten", "kaesten", "anzahl"}),
	    "Du siehst hier eine grosse Anzahl an Kaesten mit noch mehr Regalen darin.\n");
  AddDetail(({"regale", "regal"}),
	    "In den Regalen stehen verschiedenste Amphoren, Flaeschchen und Tiegel mit den "
	    +"eigenartigsten Substanzen darin.\n");
  AddDetail(({"amphoren", "kleine amphoren", "grosse amphoren", "zerbrochene amphoren"}),
	    "Du siehst kleine Amphoren, grosse Amphoren und einige zerbrochene Amphoren. "
	    +"Jede von ihnen enthaelt eigenartige Substanzen.\n");
  AddDetail(({"substanzen", "substanz", "menge"}),
	    "Es gibt hier eine Menge Substanzen die eines gemeinsam haben: Du "
	    +"moechtest nicht wissen aus sie eigentlich bestehen.\n");
  AddDetail(({"flaeschchen", "haufen", "form", "groesse"}),
	    "Es gibt hier einen Haufen an Flaeschchen verschiedener Form und Groesse. "
	    +"Alle enthalten merkwuerdige Substanzen.\n");
  AddDetail(("tiegel"),
	    "Die Tiegel sind allesamt mit den seltsamsten Substanzen gefuellt. Neben "
	    +"einem Tiegel faellt dir ein Beutel auf.\n");
  AddSpecialDetail(("beutel"), "beutel_schau");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst ein leises Rasseln von Norden.\n");
  AddSound(("rasseln"),
	   "Das Rasseln scheint von Norden zu kommen.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch", "gerueche"}),
	    "Es riecht hier seltsam. Es vermischen sich hier einfach zuviele "
	    +"Gerueche miteinander.\n");
 
  // COMMANDS START
  // COMMANDS END

  
  // EXITS START
  AddExit(("nordosten"), ROOM+"keller2");
  AddExit(("nordwesten"), ROOM+"keller4");
  AddExit(("norden"), ROOM+"keller5");
  // EXITS END

  
  // ITEMS START
  // ITEMS END
}

beutel_schau()
{
  return(BS("Da gibts no nix.\n"));
}



void reset()
{
  ::reset();
}






















