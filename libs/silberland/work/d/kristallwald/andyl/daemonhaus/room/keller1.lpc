#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int flasche=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Im Keller des Daemonenheims");
  SetProp (P_INT_LONG, "Du befindest Dich jetzt im Keller des Hauses. "
	   +"Es ist ziemlich duester hier unten. Du kannst hier keinerlei "
	   +"Einrichtungsgegenstaende oder Moebel entdecken. "
	   +"Zwei Gaenge fuehren nach Suedwesten und Suedosten. "
	   +"Ueber die Treppe kommst Du wieder zurueck in den Wohnraum des "
	   +"Hauses.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START;
  AddDetail(({"einrichtungsgegenstaende", "gegenstaende", "moebel"}),
	    "Du kannst hier weder Moebel noch sonstige Einrichtungsgegenstaende "
	    +"entdecken.\n");
  AddDetail(("wohnraum"),
	    "Den Wohnraum erreichst Du ueber die Treppe.\n");
  AddDetail(({"gang", "gaenge"}),
	    "Es gibt hier zwei Gaenge. Der eine fuehrt nach Suedwesten, der "
	    +"andere nach Suedosten.\n");
  AddDetail(({"suedwesten", "suedosten", "sueden", "osten", "westen", "norden"}),
	    "Das ist eine Richtung.\n");
  AddDetail(("richtung"),
	    "Naja, Sueden, Westen, Osten, Norden und so...\n");
  AddDetail(({"haus", "hauses"}),
	    "Du bist hier im Keller des Hauses.\n");
  AddDetail(("treppe"),
	    "Ueber diese Treppe bist Du in den Keller gekommen. "
	    +"Natuerlich kommst Du ueber sie auch wieder nach oben. "
	    +"Moment mal, war da nicht gerade ein seltsames Glaenzen "
	    +"unter der Treppe zu sehen?\n");
  AddDetail(("boden"),
	    "Der Boden besteht aus nebeneinander aufgeschichteten "
	    +"Steinplatten. Viel Muehe hat sich der dafuer verantwortliche "
	    +"Handwerker sicher nicht gemacht.\n");
  AddDetail(("muehe"),
	    "Viel Muehe kann sich der fuer den Boden verantwortliche "
	    +"Handwerker nicht gemacht haben.\n");
  AddDetail(("handwerker"),
	    "Hmmm, wahrscheinlich ein sehr fauler Handwerker.\n");
  AddDetail(({"steinplatten", "platten"}),
	    "Ganz normale Steinplatten, garantiert aus Stein.\n");
  AddDetail(("stein"),
	    "Hart, stabil, schwer, Stein eben.\n");
  AddDetail(({"raum", "keller"}),
	    "Du stehst jetzt im Keller des Hauses.\n");
  AddDetail(({"wand", "waende", "steinwand", "steinwaende"}),
	    "Es sind einfache kahle Steinwaende.\n");
  AddDetail(({"decke"}),
	    "Die Decke besteht aus Holzlatten. In ihr siehst Du eine "
	    +"eine geoeffnete Falltuer durch welche die Treppe fuehrt.\n");
  AddDetail(({"falltuer", "tuer"}),
	    "Durch diese Falltuer bist Du in den Keller gekommen.\n");
  AddDetail(({"holzlatten", "latten"}),
	    "Holzlatten, Latten aus Holz.\n");
  AddDetail(("holz"),
	    "Das scheint gutes Holz zu sein. Da ist ja noch nicht einmal "
	    +"der Wurm drinnen.\n");
  AddDetail(({"wurm", "wuermer"}),
	    "Bei dem Holz heisst es wohl fuer Wuermer: Wir muessen draussen "
	    +"bleiben!\n");
  
  AddSpecialDetail(("glaenzen"), "glaenzen_schau");

  AddSound(("rasseln"), "Das Rasseln scheint aus suedlicher Richtung zu "
	   +"kommen.\n");
  
  AddSound( DEFAULT_SOUND,
	    "Du kannst ein unheimliches Rasseln hoeren.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht muffig hier. Wahrscheinlich wurde hier laenger "
	    +"nicht mehr gelueftet.\n");
  


  // EXITS START
  AddExit ("oben", ROOM+"haus");
  AddExit ("suedosten", ROOM+"keller2");
  AddExit ("suedwesten", ROOM+"keller4");

  // EXITS END

  // COMMANDS START
  AddCmd(("nimm"), "nimm_was");
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

glaenzen_schau()
{
  if (flasche==1)
    {
      return(BS("Da steht eine Flasche unter der Treppe. Vielleicht "
		+"kann man die ja nehmen.\n"));
    }
  else return(BS("Da ist nichts. Musst Dich wohl geirrt haben.\n"));
}

nimm_was(str)
{
  notify_fail("Was willst Du nehmen?\n");
  if (!str) return 0;
  if (str == "flasche")
    {
      if (flasche==1)
	{
	  // CHECKEN OB SPIELER FLASCHE HAT
	  // FLASCHE CLONEN
	  write(BS("Du nimmst die Flasche und steckst sie ein.\n"));
	  flasche=0;
	  return 1;
	}
      else return 0;
    }
  else return 0;
}

reset()
{
flasche=1;
}























