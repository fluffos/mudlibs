#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int kasten=0;
int papyrus=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Im Keller des Daemonenheims.");
  SetProp (P_INT_LONG, "Das hier scheint ein Forschungszimmer zu "
	   +"sein. Alte Schriftrollen, seltsame Buecher, einige "
	   +"Steintafeln und Pergamente tuermen sich auf einem "
	   +"grossen Holztisch der mitten im Raum steht. An der "
	   +"Ostwand befindet sich ein schaebiger Kleiderschrank. "
	   +"Zwei Gaenge fuehren jeweils nach Nordwesten und "
	   +"Suedwesten.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START;
 
  AddDetail(("raum"),
	    "Dieser Raum sieht aus wie ein Forschungszimmer.\n");
  AddDetail(({"gang", "gaenge"}),
	    "Es gibt hier zwei Gaenge. Einer fuehrt nach Nordwesten, "
	    +"der andere nach Suedwesten.\n");
  AddDetail(({"keller"}),
	    "Du befindest Dich hier im Keller des Daemonenheims.\n");
  AddDetail(({"daemonenheim", "heim", "haus", "sicherheit"}),
	    "Dieses Haus wird mit Sicherheit von einem Daemonen "
	    +"heimgesucht.\n");
  AddDetail(({"ostwand", "wand"}),
	    "An der Ostwand steht ein schaebiger Kleiderschrank.\n");
  AddDetail(({"waende", "steinwaende"}),
	    "Einfache schmucklose Steinwaende.\n");
  AddDetail(("stein"),
	    "Harter Stein.\n");
  AddDetail(({"schrank", "kleiderschrank"}),
	    "Ein schaebiger alter Kleiderschrank. Ob da was "
	    +"wichtiges drinnen ist?\n");
  AddDetail(({"boden", "steinboden"}),
	    "Ein Steinboden bei dem die Steinplatten "
	    +"einfach nebeneinander gelegt wurden. Keine "
	    +"besondere Arbeit.\n");
  AddDetail(({"platten", "steinplatten"}),
	    "Ganz normale, schlecht bearbeitete Steinplatten.\n");
  AddDetail(({"arbeit"}),
	    "Eine besonder Arbeit ist dieser Steinboden nicht.\n");
  AddDetail(({"zimmer", "forschungszimmer"}),
	    "Alles deutet darauf hin, dass dies ein Forschungszimmer "
	    +"ist.\n");
  AddDetail(("decke"),
	    "Die Decke besteht aus alten dicken Holzlatten. Ein Lampe "
	    +"oder aehnliches kannst Du nirgends entdecken.\n");
  AddDetail(({"latten", "holzlatten"}),
	    "Einfache solide Holzlatten.\n");
  AddDetail(("lampe"),
	    "Ein Lampe ist hier nirgends zu finden.\n");
  AddDetail(({"rollen", "schriftrollen", "rolle", "schriftrolle"}),
	    "Auf dem Tisch liegen eine Unmenge an Schriftrollen. "
	    +"Die meisten davon scheinen sehr alt zu sein. "
	    +"Du koenntest versuchen einge davon zu lesen.\n");
  AddReadDetail(({"rollen", "schriftrollen", "rolle", "schriftrolle"}),
		"Du siehst Dir einige Schriftrollen genauer an und "
		+"siehst welche mit solchen Titeln wie:\n"
		+"'Die Zeit des Zaruls'\n"
		+"'Beschwoerung von Unterweltwesen'\n"
		+"'Zarul, Meister der Hinterlist'\n"
		+"So wie es aussieht hat sich der Hausbesitzer "
		+"eingehend mit Daemonologie befasst.\n");
  AddDetail(({"hausbesitzer", "besitzer"}),
	    "Der Hausbesitzer ist wahrscheinlich schon tot.\n");
  AddDetail(({"buecher", "buch"}),
	    "Es sind zumeist alte, abgegriffene Buecher. "
	    +"Du solltest Dich ein wenig in sie hineinlesen.\n");
  AddReadDetail(({"buch", "buecher"}),
		"Du schmoekerst in einigen der Buechern und "
		+"stoesst auf solche Werke wie:\n"
		+"'Das grosse Daemonicum'\n"
		+"'Das Eviltorium'\n"
		+"'Magica Nekronomika'\n"
		+"'Das Chimaerenlexica'\n"
		+"All diese Buecher gehoeren zu den wichtigsten "
		+"Hauptwerken der schwarzen Magie.\n");
  AddDetail(({"pergamente", "pergament"}),
	    "Die Pergamente sind alle in einer Sprache geschrieben "
	    +"die Du nicht verstehst.\n");
  AddDetail(("sprache"),
	    "Du verstehst diese Sprache nicht.\n");
  AddReadDetail(({"pergamente", "pergament"}),
		"Du verstehst die Sprache in der sie geschrieben sind nicht.\n");
  AddDetail(({"unmenge"}),
	    "Eine Unmenge an Schriftrollen liegt auf dem Tisch.\n");
  AddDetail(({"tafeln", "steintafeln"}),
	    "Es sind mehrere schwere Steintafeln mit seltsamen Runen "
	    +"darauf. An einer Steintafel faellt Dir etwas auf.\n");
  AddDetail(({"runen", "bedeutung"}),
	    "Du kannst die Bedeutung der Runen nicht herausfinden.\n");
  AddReadDetail(({"steintafeln", "tafeln", "runen"}),
		"Du kannst die Bedeutung der Runen nicht herausfinden.\n");
  AddSpecialDetail(({"steintafel", "tafel"}), "steintafel_schau");
  AddDetail(({"tisch", "holztisch"}),
	    "Ein einfacher Holztisch mit vier Beinen und einer "
	    +"soliden Tischplatte.\n");
  AddDetail(({"beine", "tischbeine"}),
	    "Als Du die Beine des Tisches untersuchst faellt Dir "
	    +"ein Bein besonders auf.\n");
  AddDetail(({"bein", "tischbein", "einbuchtung"}),
	    "In einem Tischbein scheint eine Einbuchtung zu sein. "
	    +"Vielleicht solltest Du da mal reingreifen.\n");
  AddDetail(({"platte", "tischplatte"}),
	    "Die Tischplatte ist aus einem grundsolidem Holz.\n");
  AddDetail(({"holz", "buchenholz"}),
	    "Es scheint sich dabei um Buchenholz zu handeln.\n");
  AddSound(("rasseln"),
	   "Das Rasseln scheint aus westlicher Richtung zu kommen.\n");
  AddSound( DEFAULT_SOUND,
	    "Du kannst ein unheimliches Rasseln hoeren.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht muffig hier. Wahrscheinlich wurde hier laenger "
	    +"nicht mehr gelueftet.\n");
  


  // EXITS START
  AddExit ("nordwesten", ROOM+"keller1");
  AddExit ("suedwesten", ROOM+"keller3");

  // EXITS END

  // COMMANDS START
  AddCmd(("oeffne"), "oeffne_was");
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}




oeffne_was(str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if (!str) return 0;
}


steintafel_schau()
{

}





reset()
{
  kasten=0;
  papyrus=1;
}























