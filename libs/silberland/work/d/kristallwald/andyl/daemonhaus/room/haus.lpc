#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int boden=0;
int dachluke=0;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:18, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Im heimgesuchten Haus");
  SetProp (P_INT_LONG, "Du stehst hier im Wohnraum des vom Daemon heimgesuchten "
	   +"Hauses. Obwohl die Fenster stark verschmutzt sind faellt doch etwas "
	   +"Licht durch sie herein. Es ist alles ziemlich verstaubt und von "
	   +"Spinnweben bedeckt. In der Mitte des Raumes steht ein kleines "
	   +"Tischchen und ein kaputter Hocker. An der Ostwand entdeckst du einen "
	   +"alten verrosteten Metallofen und an der Nordwand steht ein Regal "
	   +"in welchem allerlei Zeugs herumliegt. Eine morsche Holztuer fuehrt "
	   +"wieder zurueck vor das Haus.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START;
  AddDetail(("mitte"),
	    "In der Mitte des Raumes stehen ein Hocker und ein Tischchen.\n");
  AddDetail(({"staub", "staubschichten", "staubschicht"}),
	    "Hier ist wirklich viel zuviel Staub, hier sollte mal dringend "
	    +"jemand kehren.\n");
  AddDetail(({"wand", "waende", "westwand", "suedwand"}),
	    "Die Waende sind alle aus etwas morschem Holz. Hoffentlich stuerzt "
	    +"das Haus nicht in sich zusammen.\n");
  AddDetail(("holz"),
	    "Wer auf Holz klopft kann sich leicht einen Schiefer einziehen.\n");
  AddDetail(("schiefer"),
	    "Sowas kann ziemlich weh tun.\n");
  AddDetail(("ostwand"),
	    "Da steht ein alter verrosteter Metallofen.\n");
  AddDetail(("nordwand"),
	    "Da steht ein Regal welches mit allerlei Zeugs bepackt ist.\n");
  AddDetail(({"regal","holzregal"}),
	    "Es ist ein schlichtes Holzregal in dem allerlei Zeugs herumliegt.\n"); 
  AddDetail(({"zeugs", "zeug"}),
	    "Da ist so einiges an nutzlosem Zeug. Naja, vielleicht wuerde "
	    +"man ja doch etwas nuetzliches finden wen man es durchsuchen wuerde.\n");
  AddDetail(({"tuer", "holztuer"}),
	    "Die Tuer fuehrt wieder zurueck nach draussen.\n");
  AddDetail(({"spinnweben", "weben"}),
	    "Hier sind eine Unmenge an Spinnweben. Das Haus scheint schon "
	    +"laenger nicht mehr bewohnt zu sein, oder doch?\n");
  AddDetail(({"unmenge"}),
	    "Diese Unmenge an Spinnweben bedeutet wohl, dass hier schon lang "
	    +"nicht mehr geputzt wurde.\n");
  AddSpecialDetail(("boden"), "boden_schau");
  AddDetail(({"decke", "holzdecke"}),
	    "An der Holzdecke die relativ morsch zu sein scheint, haengt ein altes "
	    +"Mobile aus Metallstangen und ein interessant aussehender Haken.\n");
  AddDetail(("mobile"),
	    "Ein einfaches Mobile aus Metallstangen.\n");
  AddDetail(({"metallstange", "metallstangen"}),
	    "Die Metallstangen sind ueber und ueber mit magischen Schutzsymbolen "
	    +"bedeckt. Offensichtlich war der Hausbesitzer sehr aberglaeubisch.\n"); 
  AddDetail(({"symbol", "symbole", "schutzsymbol", "schutzsymbole"}),
	    "Die Schutzsymbole sind in die Metallstangen des Mobiles eingeritzt "
	    +"worden. Ob sie wohl etwas genuetzt haben?\n");
  AddDetail(({"besitzer", "hausbesitzer"}),
	    "Wo der jetzt wohl stecken mag?\n");  
  AddDetail(("sonne"),
	    "Obwohl die Fenster elendiglich verdreckt sind, scheint dennoch etwas "
	    +"Sonne durch sie hindurch.\n");
  AddDetail(("haken"),
	    "Ein seltsam geformter Haken aus bereits rostigem Eisen. Er hat "
	    +"eine Form von einer Schlaufe. Moeglicherweise koennte man ja "
	    +"versuchen an ihm zu ziehen?\n");
  AddDetail(("eisen"),
	    "Verdammt rostiges Eisen.\n");
  AddDetail(("form"),
	    "Die Form des Hakens ist die einer Schlaufe.\n");
  AddDetail(({"schlaufe"}),
	    "Der Haken hat die Form einer Schlaufe.\n");
  AddDetail(("hocker"),
	    "Der Hocker hat wohl auch schon bessere Tage gesehen. Ein Bein ist ab "
	    +"und die beiden anderen sehen auch nicht mehr sonderlich stabil "
	    +"aus. Die Sitzflaeche ist auch nur mehr zur Haelfte vorhanden.\n");
  AddDetail(({"tag", "tage"}),
	    "Du kannst nur hoffen, dass dies dein Tag ist.\n"); 
  AddDetail(("haelfte"),
	    "Von der Sitzflaeche des Hockers ist nur noch die Haelfte vorhanden.\n"); 
  AddDetail(("sitzflaeche"),
	    "Die Sitzflaeche des Hockers ist nur mehr zur Haelfte vorhanden. "
	    +"Da hat sich wohl jemand mit etwas zuviel Gewicht auf den Hocker "
	    +"gesetzt.\n");
  AddDetail(("gewicht"),
	    "Nein, Du brauchst Dir jetzt keine Sorgen ueber dein Gewicht zu machen.\n");
  AddDetail(({"sorgen", "person"}),
	    "Du brauchst der wirklich keine Sorgen zu machen. Oder bist Du so eine "
	    +"Person voller Komplexe?\n");
  AddDetail(({"komplexe", "komplex", "forscherkomplex"}),
	    "Aha, Du bist also jemand mit dem Forscherkomplex? Kann hier ja ganz "
	    +"nuetzlich sein :).\n");
  AddDetail(({"bein", "beine", "brennholz"}),
	    "Die Beine des Hockers sehen ziemlich mitgenommen aus. Die sind "
	    +"wahrscheinlich nur mehr als Brennholz zu gebrauchen.\n");
  AddDetail(({"raum", "wohnraum"}),
	    "Du befindest Dich hier im Wohnraum des vom Daemon heimgesuchten Haus. "
	    +"Schau Dich um, hier gibt es sicher einiges zu erforschen.\n");
  AddDetail(({"tisch", "tischchen"}),
	    "Das Tischchen scheint im Gegensatz zum dazugehoerigem Hocker noch "
	    +"heil geblieben zu sein. Trotzdem sieht die Tischplatte auch bereits "
	    +"etwas morsch aus.\n");
  AddDetail(({"gegensatz"}),
	    "Im Gegensatz zum Hocker ist die Tischplatte heil geblieben.\n");
  AddSpecialDetail(({"tischplatte", "platte"}), "tischplatten_schau");
  AddDetail(("bauart"),
	    "Scheint von recht robuster Bauart zu sein, diese Tischplatte.\n");
  AddDetail(({"kante", "tischkante"}),
	    "Als Du die Tischkante naeher untersuchst faellt Dir eine Lade "
	    +"auf die Du durch den vielen Staub fast uebersehen haettest.\n");
  AddDetail(("lade"),
	    "Hmm, eine kleine unscheinbare Lade die Du beinahe uebersehen "
	    +"haettest. Die kann man sich oeffnen.\n");
  AddDetail(({"fenster", "scheiben", "fensterscheiben"}),
	    "Die zwei Fenster sind stark verschmutzt. Dennoch kann ein "
	    +"bisschen Sonne durch sie scheinen.\n");
  AddDetail(("licht"),
	    "Das Licht kommt von der Sonne, die gerade noch genug Energie "
	    +"hat umd durch die verdreckten Fensterscheiben zu scheinen.\n");
  AddDetail(("energie"),
	    "Energie: E=mc^2. Ist es nicht so?.\n");
  AddDetail(("daemon"),
	    "Du kannst die Aura des Daemons hier direkt fuehlen.\n");
  AddDetail(({"aura", "fall"}),
	    "Was immer es auch ist, gut ist es in keinem Fall.\n");
  AddDetail(({"haus", "erkenntnis"}),
	    "Du stehst gerade in einem Haus. Oh, welche Erkenntnis.\n");  
  AddDetail(({"verwesung", "verwesungsgeruch"}),
	    "Riech mal!\n");  
  AddDetail(({"metallofen", "ofen"}),
	    "Der Metallofen ist voellig verrostet. Der ist nicht mehr zu "
	    +"reparieren. Du kannst es aber gerne versuchen.\n");
  AddSmell(({"verwesung", "verwesungsgeruch"}),
	   "Der Verwesungsgeruch scheint von oben zu kommen.\n");
  AddSound( DEFAULT_SOUND,
	    "Du kannst ein unheimliches Rasseln hoeren.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Hier riecht es irgendwie nach Verwesung. Angenehm riecht "
	    +"es in jedenfalls nicht.\n");
  AddSound(("rasseln"),
	   "Lausch mal!\n");
  AddSound(("rasseln"),
	   "Das Rasseln kommt definitiv von unten.\n");
  AddSpecialDetail(("treppe"), "treppe_schau");
  AddSpecialDetail(("luke"), "luke_schau");
  AddSpecialDetail(("leiter"), "leiter_schau");
  AddSpecialDetail(("falltuer"), "falltuer_schau");
  AddSpecialDetail(("keller"), "keller_schau");
  
  // EXITS START
  AddExit ("sueden", "/players/andyl/workroom.lpc");
  // EXITS END

  // COMMANDS START
  AddCmd(({"kehr", "kehre"}), "kehre_was");
  AddCmd(({"ziehe", "zieh"}), "ziehe_was");
  AddCmd(({"oeffne"}), "oeffne_was");
  AddCmd(({"reparier", "repariere"}), "repariere_was");
  AddCmd(({"durchsuch", "durchsuche"}), "durchsuche_was");
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

durchsuche_was(str)
{
  notify_fail("Was willst Du durchsuchen?\n");
  if ((str=="zeug" || str=="zeugs"))
    {
      
      // WENN HASENPFOTE VORHANDEN GIBTS NIX
      write(BS("Nach einer gruendlichen Durchsuchung des "
	       +"Zeugs findest du eine Hasenpfote die Du "
	       +"sofort einsteckst.\n"));
      //HASENPFOTE GIBTS
      return 1;
    }
  else return 0;
}

	

repariere_was(str)
{
  notify_fail("Was willst Du reparieren?\n");
  if ((str=="ofen" || str=="metallofen"))
    {
      write(BS("Ungeschickt wie Du bist tust Du "
	       +"Dir natuerlich weh und der Ofen ist immer "
	       +"noch kaputt. Ist ja wieder mal typisch.\n"));
      TP->reduce_hit_point(5);
      return 1;
    }
  else return 0;
}

kehre_was(str)
{
  notify_fail("Was willst Du kehren?\n");
  if ((str=="boden"))
    {
      if (boden==0)
	{

	  
	  //ueberpruefen ob besen da
	  write(BS("Du kehrst den Boden als du ploetzlich mit dem "
		   +"Besen irgendwo haengenbleibst und mit einem *KLACK* "
		   +"unter Dir ein Falltuer aufgeht und eine Treppe zum "
		   +"Vorschein kommt.\n"));
	  boden=1;
	  AddExit ("unten", ROOM+"keller1");	  
	  return 1;
	}
      else
	{
	  write(BS("Das brauchst Du nicht mehr zu machen.\n"));
	  return 1;
	}
    }
  else return 0;
}

ziehe_was(str)
{
  notify_fail("Woran willst Du ziehen?\n");
  if ((str=="haken" || str=="schleife" || str=="an haken" ||
       str=="an schleife")) 
    {
      if (dachluke==0)
	{
	  write(BS("Du ziehst an dem Haken und mit einem "
		   +"lauten *** RUMMS *** oeffnet sich ein Luke, aus der "
		   +"eine Leiter herabrumpelt. Nebenbei wirst Du "
		   +"noch schoen mit Staub ueberhaeuft. Man goennt "
		   +"sich ja sonst nichts. *hust* *keuch*\n"));
	  dachluke=1;
	  AddExit ("oben", ROOM+"dachboden");	
	  return 1;
	}
      else
	{
	  write("Das musst Du nicht mehr machen.\n");
	  return 1;
	}     
    }
  else return 0;
}

oeffne_was(str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if(str=="lade")
    {
      // SCHLUESSELUEBERAGBE
      write("geht no ned.\n");
      return 1;
      
    }
  else return 0;  
}

treppe_schau()
{
  if (boden==1) return(BS("Die Treppe fuehrt hinunter in den Keller.\n"));
}

keller_schau()
{
  if (boden==1) return(BS("Der Keller kann ueber die Treppe betreten werden.\n"));
}


luke_schau()
{
  if (dachluke==1) return(BS("Durch die Dachluke kommst Du auf den Dachboden.\n")); 
}

leiter_schau()
{
  if (dachluke==1) return(BS("Ueber die Leiter kommst Du auf den Dachboden.\n")); 
}

falltuer_schau()
{
  if (boden==1) return(BS("Durch die Falltuer kommst Du in den Keller.\n")); 
}

boden_schau()
{
  if (boden==1)
    {
      return(BS("Da ist eine geoeffnete Falltuer. Eine Treppe fuehrt hinunter "
		+"in den Keller.\n"));
    }
  else 
    {
      return(BS("Der Boden ist von dicken Staubschichten bedeckt. Hier hat "
		+"anscheinend laenger keiner mehr gewohnt. Oder etwa doch?\n"));
    }
}

tischplatten_schau()
{
  TP->reduce_hit_point(5);
  return(BS("Die Tischplatte ist stabiler als sie aussieht. Ist wohl von einer "
	    +"sehr robuste Bauart. Aua, da hast Du Dich jetzt tatsaechlich mit einer "
	    +"Tischkante gestochen.\n"));
}

reset()
{
  dachluke=0;
  boden=0;
  RemoveExit("oben");
  RemoveExit("unten");
}























