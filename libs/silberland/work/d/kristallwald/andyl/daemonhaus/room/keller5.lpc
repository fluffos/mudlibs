#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int flasche=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:5, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "In einem Beschwoerungsraum");
  SetProp (P_INT_LONG, "Dieser Raum ist ziemlich kahl und scheint dennoch "
	   +"nicht ganz uninteressant zu sein. Am Boden ist ein riesiges "
	   +"Oktagramm umgeben von mehrerern Hexagrammen. Fuer gewoehnlich "
	   +"wird so ein Ort fuer Beschwoerungen benutzt. Ob hier so etwas "
	   +"schon geschehen ist? Interessanterweise ist es hier auch um etliches "
	   +"kuehler, als in den vorhergehenden Kellerraeumen. Eine Tuer fuehrt "
	   +"nach Sueden zurueck.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START;
  AddDetail(({"tuer", "holztuer"}),
	    "Eine schlichte Holztuer. Sie fuehrt zurueck nach Sueden.\n");
  AddDetail(("kellerraeume"),
	    "In den vorhergehenden Kellerraeumen war es betraechtlich waermer "
	    +"als hier.\n");
  AddDetail(({"raum", "beschwoerungsraum"}),
	    "Dieser Raum scheint fuer diverse Beschwoerungen eingerichtet worden "
	    +"zu sein.\n");
  AddDetail(({"boden", "steinboden"}),
	    "Der Boden ist ein schlichter Steinboden, in den ein riesiges Oktagramm "
	    +"und mehrere kleine Hexagramme gemeiselt wurden.\n");
  AddDetail(({"wand", "waende"}),
	    "Die Waende sind aus Stein und absolut schmucklos.\n");
  AddDetail(({"stein", "stein"}),
	    "Steine sind schon etwas faszinierendes, nicht wahr?\n");
  AddDetail(({"ort", "beschwoerung", "beschwoerungen"}),
	    "Dieser Ort scheint extra fuer Beschwoerungen gemacht zu sein. "
	    +"Hier koennte man sicher gut etwas beschwoeren wenn man wollte.\n");
  AddDetail(({"decke"}),
	    "Die Decke besteht aus alten dicken Holzlatten. Ein kleiner gruener "
	    +"Fleck faellt Dir an ihr auf.\n");
  AddDetail(({"holzlatten"}),
	    "Die Holzlatten scheinen sehr alt zu sein, aber dafuer auch noch "
	    +"ziemlich robust.\n");
  AddDetail(("fleck"),
	    "Es ist eine verkrustete gruene Substanz die von irgendetwas Unnatuerlichem "
	    +"stammen muss.\n");
  AddDetail(({"unnatuerliches", "unnatuerlichem"}),
	    "So etwas unnatuerliches wie ein beschwoertes Wesen.\n");
  AddDetail(({"wesen"}),
	    "Du moechtest hier eigentlich keinem boesartigem Wesen begegnen, aber hast Du "
	    +"die Befuerchtung, dass dies sehr wahrscheinlich werden wird.\n");
  AddDetail(({"befuerchtung", "befuerchtungen"}),
	    "Du fuehlst, dass sich deine Befuerchtungen durchaus bewahrheiten koennten.\n");
  AddDetail(({"substanz", "fall", "anteile"}),
	    "Sieht aus als hat die Substanz auch Anteile von irgendeiner Saeure enthalten. "
	    +" Auf jeden Fall hat sie sich in eine der Holzlatten geaezt.\n"); 
  AddDetail(("saeure"),
	    "Das kennst Du sicher aus dem Chemieunterricht.\n");
  AddDetail(({"chemieunterricht", "chemie"}),
	    "Soviel kriegt man im Chemieunterricht schnell mit:\n "
	    +"Wenns nicht stinkt oder kracht, ist es nicht Chemie.\n");
  AddDetail(("holzlatte"),
	    "In diese Holzlatte hat sich eine gruene Substanz geaezt.\n");
  AddDetail(({"oktagramm", "hexagramm", "hexagramme", "pentagramme", "pentagramm", "erstellung"}),
	    "Oktagramme und Hexagramme werden oft, wie auch Pentagramme, "
	    +"zur Erstellung magischer Bannkreise benutzt.\n");
  AddDetail(({"bannkreis", "bannkreise"}),
	    "Einen Bannkreis benoetigt man um beschworene Wesen an einem Ort festzuhalten. "
	    +"Leider gelingt dies nicht immer so wie man es will.\n");
  AddSound( DEFAULT_SOUND,
	    "Du kannst ein unheimliches Rasseln hoeren.\n");
  AddSound(("rasseln"),
	   "Es scheint von allen Seiten zu kommen.\n");
  AddDetail(("seiten"),
	    "Von allen Seiten dringt ein unheimliches Rasseln auf Dich ein.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht hier leicht nach Schwefel.\n");
  AddSmell(("schwefel"),
	   "Er ist nur sehr, sehr schwach zu riechen.\n");

  // EXITS START
  AddExit ("sueden", ROOM+"keller3");  
  // EXITS END

  // COMMANDS START
  AddCmd(({"beschwoere", "beschwoer"}), "beschwoere_was");
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

beschwoere_was(str)
{
  notify_fail("Wen oder was willst Du beschwoeren.\n");
  if (!str) return 0;
  if (str == "daemon")
    {
      write(BS("Welchen Daemon willst Du denn beschwoeren?\n"));
      return 1;
    }
  if (str == "damonname")
    {
      write(BS("da gibts no nix"));
      return 1;
    }
  else return 0;
}





















