int access_rights(string name, string file, int readflag, int def)
{
  string *s;
  int n;

  // Lesezugriff regeln.
  if (readflag)
  {
  	s=explode(file,"/");
  	
  	if (name=="torian" || name=="lilyth" || name=="chivas")
    	return 1;
    if (name == "read_file") return 1;
    if (name == "hiri"      || 
        name == "gwenshara" || 
        name == "gwenor"    || 
        name == "malar")
    	return 0;
      
    return def;
	}

    name=lower_case(name);
    s=explode(file,"/");

    if (name=="torian")
      return 1;

    return 0;
}
