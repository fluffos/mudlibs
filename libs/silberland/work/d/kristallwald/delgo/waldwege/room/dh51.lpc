#include "../def.h"

inherit ROOM "std"; 

#include <properties.h>

void create()
{
  ::create();

  RemoveDetail( ({"himmel", "licht"}) );
  AddDetail( ({"himmel", "licht"}),
    "Den Himmel kannst Du nicht erkennen, aber einen Weg Richtung Nordosten. "
    "Ich wuerde ihm ja folgen ...");
  AddWaldExit("folg|folge&weg", "Was willst Du folgen?", 
              "nordosten", "dh60");
              

  RemoveDetail( ({"nadel", "nadeln"}) );
  AddDetail( ({"nadel", "nadeln"}),
    "An einer Stelle liegen keine Nadeln. Krieche mal ueber diese Stelle.");
  AddWaldExit("kriech|krieche&ueber&stelle", "Worueber willst Du kriechen?", 
              "suedwesten", "dh42");

}