#include "../def.h"

inherit ROOM "std"; 

#include <properties.h>

void create()
{
  ::create();

  RemoveDetail( ({"rinde", "holz"}) );
  AddDetail( ({"rinde", "holz"}),
    "Als Du Dir eine Rinde naeher ansiehst, bemerkst Du einen hellblaeulichen"
    " Schimmer.");
  AddDetail( ({"schimmer"}),
    "Ein Sonnenstrahl, der durch die Blaetter dringt.");
  AddDetail( ({"sonnenstrahl", "strahl", "ursprung"}),
    "Wenn Du neugierig bist, folge dem Ursprung.");
  AddWaldExit("folg|folge|verfolge&ursprung|strahl<sonnenstrahl", "Was "
              "willst Du verfolgen?", 
              "osten", "dh04");
              

  RemoveDetail( ({"boden", "untergrund"}) );
  AddDetail( ({"boden", "untergrund"}),
    "Der Boden scheint hier nicht allzu stabil zu sein. Eine Stelle scheint "
    "besonders weich zu sein.");
  AddDetail( ({"stelle"}),
    "Fast bist Du ausgerutscht, doch Du konntest Dich gerade noch abfangen. "
    "Allerdings geht es hier etwas bergab und Du kannst hier runter "
    "rutschen.");
  AddWaldExit("rutsch|rutsche&herunter|runter", "Wohin willst Du rutschen?", 
              "suedwesten", "ch85");

}