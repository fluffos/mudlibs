#include "../def.h"

inherit ROOM "std"; 

#include <properties.h>

void create()
{
  ::create();

  RemoveDetail( ({"wald", "waelder", "tethyr", "tal"}) );
  AddDetail( ({"wald", "waelder", "tethyr", "tal"}),
    "Als Du Dich noch einmal komplett umsiehst, bemerkst Du einen groesseren "
    "Abstand zwischen zwei Baeumen.");
  AddDetail( ({"abstand"}),
    "Die beiden Baeume sind absolut parallel gewachsen und bilden mit den "
    "Aesten schon fast ein Portal.");
  AddDetail( ({"portal", "koenig"}),
    "Schreite durch ein Portal und fuehl Dich nur einmal wie ein Koenig!");
  AddWaldExit("schreite&durch&portal", "Durch was willst Du schreiten?", 
              "westen", "ch94");
              

  RemoveDetail( ({"moos", "moose"}) );
  AddDetail( ({"moos", "moose"}),
    "Der moosige Untergrund bildet irgendeine Form, welche Dir bekannt "
    "vorkommt.");
  AddDetail( ({"form", "stufen", "treppe", "stufe"}),
    "Es sieht schon fast aus wie eine Treppe. Sie ist zwar sehr schief und "
    "die Stufen sind unregelmaessig hoch, doch man kann sie sicher "
    "runtersteigen.");
  AddWaldExit("steige|steig&treppe&runter", "Was willst Du runter steigen?", 
              "osten", "dh14");

}