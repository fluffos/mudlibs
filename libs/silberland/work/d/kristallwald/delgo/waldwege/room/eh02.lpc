#include "../def.h"

inherit ROOM "std"; 

#include <properties.h>

void create()
{
  ::create();

  RemoveDetail( ({"schatten"}) );
  AddDetail( ({"schatten"}),
    "Der Schatten ist ein kleiner Durchgang. Betrete einfach den Schatten.");
  AddWaldExit("betret|betrete&schatten", "Was willst Du betreten?", 
              "westen", "dh92");
              

  RemoveDetail( ({"blatt", "blaetter"}) );
  AddDetail( ({"blatt", "blaetter"}),
    "Die Blaetter verdecken etwas. Ob Du durch sie kriechen wirst?");
  AddWaldExit("kriech|krieche&durch&blaetter", "Durch was willst Du kriechen?", 
              "nordosten", "eh11");

}