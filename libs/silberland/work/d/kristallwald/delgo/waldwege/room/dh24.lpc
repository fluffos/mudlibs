#include "../def.h"

inherit ROOM "std"; 

#include <properties.h>

void create()
{
  ::create();

  RemoveDetail( ({"ast", "aeste", "geaest", "astwerk"}) );
  AddDetail( ({"ast", "aeste", "geaest", "astwerk"}),
    "Die Aeste bilde hier eine regelrechte Hecke.");
  AddDetail( ({"hecke"}),
    "Na, traust Du Dich darueber zu hechten?");
  AddWaldExit("hecht|hechte&ueber&hecke|aeste|astwerk", "Ueber was willst Du "
              "hechten?", 
              "nordosten", "dh33");
              

  RemoveDetail( ({"schatten","baum", "baeume"}) );
  AddDetail( ({"schatten","baum", "baeume"}),
    "Die Baeume werfen einen langen Schatten. Probier Dich mal als "
    "Schleicher.");
  AddDetail( ({"schleicher"}),
    "Schleicher schleichen nicht immer. Oft huschen sie auch nur.");
  AddWaldExit("husche&durch&schatten", "Wodurch willst Du huschen?", 
              "westen", "dh14");

}