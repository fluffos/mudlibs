#include "../def.h"

inherit ROOM "std"; 

#include <properties.h>

void create()
{
  ::create();

  RemoveDetail( ({"laub"}) );
  AddDetail( ({"laub"}),
    "Das Laub ist zu einem Haufen aufgeschuettet und wurde bisher nicht "
    "durch den Wind verweht.");
  AddDetail( ({"laubhaufen", "haufen"}),
    "Der Laubhaufen scheint stabil genug um ihn zu erklimmen.");
  AddWaldExit("erklimme|erklimm&haufen|laubhaufen", "Was moechtest Du "
              "erklimmen?", 
              "nordosten", "ch94");
              
  AddExit( "westen", WALD_GILDE);

}