#include "../def.h"
inherit "std/room";
mapping exits;
mixed normal_exits;


//-- Create() ----------------------------------------------------------------
void create()
{
  ::create();

  exits=([]);
  normal_exits=({});
  
  SetProp(P_INT_SHORT, "Der Wald von Tethyr");
  SetProp(P_INT_LONG,
    ""); //s. unten _query_int_long, damits bei jedem 'schau' anders aussieht

  AddDetail( ({ "wald", "waelder", "tethyr", "tal" }),
    "Dieser Wald befindet sich im Tal von Tethyr.");
    
  AddDetail( ({ "weg", "wege", "pfad", "pfade" }),
    "Es gibt hier keinen Weg. Der Wald ist noch nahezu unberuehrt. Auch im "
    "Laub bemerkst Du nichts. Nicht einmal Steine gibt es hier.");
    
  AddDetail( ({ "blatt", "blaetter" }),
    "Die Blaetter sind im ganzen Tal blau gefaerbt. Das kennzeichnet den "
    "Wald von Tethyr und macht ihn einzigartig.");
    
  AddDetail( ({ "nadel", "nadeln" }),
    "Die Nadeln im Wald sind genau wie die Blaetter blau eingefaerbt. Es "
    "laesst den Wald kaelter erscheinen.");
    
  AddDetail( ({ "laub" }),
    "Wenn von den Baeumen Blaetter fallen, sammelt sich natuerlich auch Laub "
    "an. Einige Zweige und Nadeln liegen dort verstreut. Ein Pfad ist nicht "
    "zu erkennen.");
    
  AddDetail( ({ "baum", "baeume" }),
    "Die meisten Baeume hier sehen gleich aus. Sie sind so gross und so alt, "
    "dass man auf ihrem Geaest herumlaufen kann. Die Rinde ist "
    "noch erstaunlich frisch.");
    
  AddDetail( ({ "ast", "aeste", "geaest", "astwerk" }),
    "Die Aeste bilden auch weiter oben derartig dickes Geaest, dass sich "
    "darauf Moose und Graeser ablagern. Wenn man auf diesem Astwerk geht, "
    "kann man nicht unterscheiden, ob das eine Wurzel oder ein Ast ist, und "
    "wie hoch oben man sich gerade befindet. Der Wald ist wirklich seltsam.");
    
  AddDetail( ({ "gras", "graeser" }),
    "Graeser wachsen neben dem Moos auch an einigen Baeumen herauf. Das Gras "
    "ist aber nicht so haeufig wie die Moose, ist aber auch blau gefaerbt.");
    
  AddDetail( ({ "moos", "moose" }),
    "Das blaue Moos waechst hier praktisch ueberall. Es bildet einen weichen "
    "Untergrund, und Du kannst nie sagen, ob Du auf festem Boden stehst oder "
    "gleich durch das Astwerk brichst.");
    
  AddDetail( ({ "boden", "untergrund" }),
    "Der Untergrund ist schwammig weich durch das Moos. Es sieht sehr "
    "gemuetlich aus.");
    
  AddDetail( ({ "himmel", "licht" }),
    "Die Baeume wachsen so dicht, dass Du kaum den Himmel erkennen kannst. "
    "Die Zweige verdecken viel und es dringt nur wenig Licht herein.");
    
  AddDetail( ({ "zweig", "zweige", "sicht" }),
    "Die Zweige verdecken deine Sicht und Du kannst nicht genau erkennen, wo "
    "Du bist. Ist das dort ein Astloch?");
    
  AddDetail( ({ "astloch", "astloecher", "loecher", "loch" }),
    "Es gibt hier einige Astloecher, aber Du kannst nichts damit anfangen.");
    
  AddDetail( ({ "stein", "steine" }),
    "Steine hast Du hier bisher noch keine gefunden.");
    
  AddDetail( ({ "wurzel", "wurzeln" }),
    "Teilweise sehen hier einige Aeste aus wie Wurzeln. Du weisst nicht, ob "
    "das tatsaechlich eine Wurzel ist. Die Natur ist schon seltsam.");
    
  AddDetail( ({ "natur" }),
    "Die Natur hat hier einen sehr seltsamen Wald geschaffen. Aber er "
    "gefaellt Dir.");
    
  AddDetail( ({ "schatten" }),
    "Die Baeume werfen grosse Schatten, doch wenn sich mal einer bewegt war "
    "das vermutlich ein Tier.");
    
  AddDetail( ({ "tier", "tiere" }),
    "Tiere gibt es hier natuerlich auch, Du wirst noch welche treffen.");
    
  AddDetail( ({ "rinde", "holz" }),
    "Das Holz der Baeume ist durch die Rinde geschuetzt.");
    
  AddSound( DEFAULT_SOUND,
    "Du hoerst nichts ausser dem Rauschen des Windes.");

  AddSound( ({ "rauschen", "wind", "windes" }),
    "Du hoerst nichts ausser dem Rauschen des Windes.");

  AddSmell( DEFAULT_SMELL,
    "Du atmest tief ein und geniesst die Waldluft.");

  AddSmell( ({ "waldluft", "luft" }),
    "Die Luft ist hier sehr sauber.");

  AddRoomMessage(
    ({"Der Wind rauscht in den Blaettern.\n",
      "Die Aeste wiegen sanft im Wind.\n",
      "Ein Schatten huscht durch die Baeume.\n",
      "Der Wald ist entspannend ruhig.\n",
      "Wo ging es gleich nochmal zurueck?\n",
      "Wie sollst Du Dich hier nur ohne Wege zurechtfinden?\n"}),60);

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_HIDE_EXITS, 1);
}

//-- StandardFunktionen ------------------------------------------------------
void reset()
{
  ::reset(); 
}
void init()
{
  ::init(); 
}
mixed get_exits() { return exits; }


//-- Testfunktion fuer die Privilegierten ------------------------------------
int IsRanger(object ob)
{
  return 1; //Bis zur Fertigstellung sollen es alle normal nutzen koennen
  if(!objectp(ob)) return 0;
  if(query_wiz_level(ob) > 21) {return 1;}//auch Magier sollen sich schnell 
                                         //zurechtfinden
  if(ob->QueryProp(P_GUILD) == "waldlaeufer") {return 1;} 
  ob->Message(BS("So einfach ist das hier nicht. Du musst Dich genauer "
                 "umsehen."), MSGFLAG_VISUAL); 
  return 0;
}
int IsRanger2() { return 1;} 
//{ return IsRanger(TP); }


//--AddExit fuer die einzelnen Raeume---------------------------------------
int AddWaldExit(string syntax, string fail, string richtung, string zielraum)
{
  int i;
  mixed m;
  
  //Normaler Ausgang
  AddExit(richtung, ([ EX_TESTFUNC  : "IsRanger2",
                       EX_DEST : ROOM+zielraum ]) );
  normal_exits-=({richtung});
  
  //Bewegungen
  AddCmd(syntax, "move_me", fail);
  
  m=explode(syntax, "&");
  exits+=([zielraum:m]);
  return 1; 
}
void AddExit(mixed cmd, mixed dest)
{
  
  if(stringp(cmd)) normal_exits+=({cmd});
  if(pointerp(cmd)) normal_exits+=cmd;
  
  ::AddExit(cmd, dest);
}


//-- Der Transport des Spielers ----------------------------------------------
int move_me()
{
  mixed syns, s, dest_list;
  string syn, actual_dest;
  int i,k, syns_size;
  
  if(!objectp(TP)) return 0;
  
  if(!stringp(s=query_verb())) return 0;
  syn=s;
  if(!stringp(s=TP->_unparsed_args())) return 0;
  syn+=" "+s;
  //DB(BS(syn));
  syns=explode(syn, " ");
  syns_size=sizeof(syns);

  dest_list=m_indices(exits);
  for(i=0;i<sizeof(dest_list);i++)
  {
    //DB(BS(to_string(i)));
    actual_dest=dest_list[i];
    s=exits[actual_dest];
    if(syns_size != sizeof(s) ) continue;
    //Nur wenn die Arrays gleich lang sind, ist auch die Anzahl der
    //Woerter gleich gross
    for(k=0;k<syns_size;k++)
    {
      //DB(BS(" ."+to_string(k)));
      if( strstr(s[k],syns[k],0) < 0 ) break;
      if(k==(syns_size-1)) //bis zum letzten Wort identisch
      {
        TP->move(ROOM+actual_dest, M_GO, "im Wald","verschwindet",
                                         "schleicht heran");
        TP->do_exhaust(5+random(4));
            //das kostet natuerlich mehr ausdauer als normales gehen auf der
           //strasse, zudem wird die Effiziens von Wegescripten verringert
        return 1;
      }
    }
  }
  return 0;
}


//-- Die LONG + Anzeige der Ausgaenge fuer Waldlaeufer und Magier ------------
string _query_int_long()
{
  string txt;
  object ob;
  mapping map;
  mixed *s;
  int i;
  
  if(!objectp(ob=TP)) return "";
  
  switch(1+random(4))
  {
    case 1:
      txt="Du befindest Dich im dichten Wald von Tethyr. Ohne Wege und "
          "Pfade musst Du hier versuchen, Dich zurecht zu finden. Die Natur "
          "ist hier nahezu unveraendert und zwischen all den Baeumen und "
          "Aesten dringt nur wenig Licht durch. Teilweise laeufst Du auf "
          "Aesten und weisst nicht einmal, wie weit du ueber dem Boden bist.";
    break;
   
    case 2:
      txt="Der blaue Wald, durch den Du gerade irrst, scheint unendlich "
          "gross zu sein. In den Waeldern, in denen Du bisher warst, "
          "hattest Du Dich leichter orientieren koennen. Vielleicht musst "
          "Du Dich erst an die blauen Blaetter und Nadeln gewoehnen. Stehst"
          " Du gerade auf festem Boden oder oben im Geaest?";
    break;

    case 3:
      txt="Vor Dir Baeume, hinter Dir Baeume, unter Dir Baeume. Wenn Du es "
          "nicht schon wuesstest, wuerdest Du sagen, Du stehst im Wald. Du "
          "weisst nicht so recht, wo Du bist, und findest auch nicht "
          "wirklich markante Baeume, an denen Du Dich orientieren kannst. Es "
          "sind einfach zu viele davon.";
    break;

    default:
      txt="Ohne Wege und Pfade findest Du vor lauter Baeumen nicht den Weg "
          "zurueck. Wenn Du Dich nicht genauer umsiehst, wirst Du die Aeste"
          " und Blaetter so schnell nicht los. Und Moos waechst hier "
          "ueberall an den Baeumen. Mal musst Du oben durch die Aeste "
          "klettern, mal auf dem Boden kriechen.";
    break;
  }

  if(IsRanger(ob))
  {
    txt+="\n";    
    map=QueryProp(P_EXITS);
    s=m_indices(map);
    i=sizeof(s);
    if(i > 0)
    {
      if(i == 1)
      {
        txt += "Dein geuebtes Auge erkennt einen Pfad: "+s[0];
      }
      if(i == 2)
      {
        txt += "Dein geuebtes Auge erkennt zwei Pfade: "+s[0]+" und "+s[1];
      }
      if(i > 2)
      {
        txt += "Dein geuebtes Auge erkennt einige Pfade: ";
        for (i=0; i<((sizeof(s))-1);i++)
        {
          txt += s[i]+", ";
        }
        i=((sizeof(s))-1);
        txt += s[i];
      }
      txt += ".";
    }
  }
  else
  {
    txt+="\n";    
    i=sizeof(normal_exits);
    if(i>0)
    {
      if(i == 1)
      {
        txt+="Du erkennst einen Trampelpfad: "+normal_exits[0];
      }
      else if(i == 2)
      {
        txt+="Du erkennst zwei Trampelpfade: "+normal_exits[0]+" und "
             +normal_exits[1];
      }
      else if(i > 2)
      {
        txt+="Du erkennst einige Trampelpfade: ";
        for(i=0;i<((sizeof(normal_exits))-1);i++)
        {
          txt+=normal_exits[i]+", ";
        }
        i=sizeof(normal_exits)-1;
        txt+=normal_exits[i];
      }
      txt += ".";
    }
  }
  
  if (QueryProp(P_DOOR_INFOS))
  {//Torian: Andernfalls sind evtl. Tueren nicht sichtbar
    return BS(txt)+(string)call_other(DOOR_MASTER,"look_doors");
  }
  
  return break_string(txt, 78,0,1);
}