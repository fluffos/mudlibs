#include "../def.h"

inherit ROOM "std"; 

#include <properties.h>

void create()
{
  ::create();

  RemoveDetail( ({"tiere", "tier"}) );
  AddDetail( ({"tiere", "tier"}),
    "Ein Tier hat eine Luecke im Dickicht hinterlassen. Willst Du "
    "durchkriechen?");
  AddWaldExit("kriech|krieche&durch&luecke", "Wo willst Du durchkriechen?", 
              "suedosten", "dh92");
              

  RemoveDetail( ({"natur"}) );
  AddDetail( ({"natur"}),
    "Die Natur zeigt Dir ein Loch im Boden. Du koenntest es schaffen darueber "
    "zu springen.");
  AddWaldExit("spring|springe&ueber&loch", "Ueber was willst Du springen?", 
              "nordwesten", "dh70");

}