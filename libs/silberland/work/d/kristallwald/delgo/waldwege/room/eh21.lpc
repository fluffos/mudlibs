#include "../def.h"

inherit ROOM "std"; 

#include <properties.h>

void create()
{
  ::create();

  RemoveDetail( ({"baum", "baeume"}) );
  AddDetail( ({"baum", "baeume"}),
    "Dir faellt ein Baum auf. Du kannst um ihn herumgehen. Oder zurueck nach "
    "Osten.");
  AddWaldExit("geh|gehe&um&baum&herum", "Um was moechtest Du herumgehen?", 
              "westen", "eh11");
              

  AddExit( "osten", WALD_PALAST_WACHWEG );
  

}