#include "../def.h"

inherit ROOM "std"; 

#include <properties.h>

void create()
{
  ::create();

  RemoveDetail( ({"weg", "wege", "pfad", "pfade"}) );
  AddDetail( ({"weg", "wege", "pfad", "pfade"}),
    "Ein kleiner Pfad fuehrt Richtung suedosten. Folge ihm besser.");
  AddWaldExit("folge|folg&pfad", "Was willst Du folgen?", 
              "suedosten", "dh81");
              

  RemoveDetail( ({"gras", "graeser"}) );
  AddDetail( ({"gras", "graeser"}),
    "Die Graeser stehen hier besonders hoch? Magst Du in die Graeser hechten?");
  AddWaldExit("hechte|hecht&in&graeser", "In was willst Du hechten?", 
              "westen", "dh60");

}