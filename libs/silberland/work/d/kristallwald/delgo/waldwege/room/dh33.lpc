#include "../def.h"

inherit ROOM "std"; 

#include <properties.h>

void create()
{
  ::create();

  RemoveDetail( ({ "weg", "wege", "pfad", "pfade" }) );

  AddDetail( ({ "weg", "wege", "pfad", "pfade" }),
    "Es gibt hier keinen Weg. Der Wald ist noch nahezu unberuehrt. "
    "Auch im Laub bemerkst Du nichts. Nicht einmal Steine gibt es hier. "
    "Im Westen lichtet sich der Wald jedoch ein wenig. Dir faellt ein "
    "weisses Tor auf, hinter dem sich ein grosser, offener Platz zu "
    "erstrecken scheint.");

  AddDetail( ({ "tor" }),
    "Ein weisses Tor fuehrt weiter nach Westen. Seine beiden "
    "Torfluegel sind weit geoeffnet.");

  AddDetail( ({ "torfluegel", "fluegel" }),
    "Sie sind geoeffnet und lassen Dich ungehindert passieren.");

  AddDetail( ({ "westen", "platz" }),
    "Im Westen erstreckt sich ein grosser, offener Platz, den Du durch "
    "ein weisses Tor betreten kannst.");

  AddExit( "nordosten", ROOM"dh42");
  AddExit( "westen", WALD_PALAST );
  AddExit( "suedwesten", ([ EX_DEST:     ROOM"dh24",
                            EX_TESTFUNC: "exit_test" ]) );

}

int exit_test(string dir)
{
  if(!TP||!interactive(TP)) return 1;
  
  if(!TP->QueryProp(P_TESTPLAYER) && !IS_LEARNER(TP) )
  {
    TP->Message(BS("Du darfst diesen Teil des Waldes noch nicht betreten!"));
    return 0;
  }
  return 1;
}
