#include "../def.h"

inherit ROOM "std"; 

#include <properties.h>

void create()
{
  ::create();

  RemoveDetail( ({"wurzel", "wurzeln"}) );
  AddDetail( ({"wurzel", "wurzeln"}),
    "Eine Wurzel zeigt auf eine Luecke. Schlag Dich durch!");
  AddWaldExit("schlag|schlage&durch&luecke", 
              "Durch was willst Du dich schlagen?", 
              "osten", "dh70");
              

  RemoveDetail( ({"rinde", "holz"}) );
  AddDetail( ({"rinde", "holz"}),
    "Als Du die Rinde betrachtest, bemerkst Du einen Durchschlupf. Wie kommst "
    "Du da durch?");
  AddWaldExit("schluepf|schluepfe&durch&durchschlupf", 
    "Wodurch willst Du schluepfen?", 
              "suedwesten", "dh51");

}