#include "../def.h"

inherit ROOM "std"; 

#include <properties.h>

void create()
{
  ::create();

  RemoveDetail( ({"boden", "untergrund"}) );
  AddDetail( ({"boden", "untergrund"}),
    "Eine Spur fuehrt Richtung Osten. Folge ihr!");
  AddWaldExit("folg|folge&spur", "Was willst Du folgen?", 
              "osten", "eh02");
              

  RemoveDetail( ({"moos", "moose"}) );
  AddDetail( ({"moos", "moose"}),
    "Hier waechst viel Moos. Umgehe das Moos!");
  AddWaldExit("umgeh|umgehe&moos", "Was willst Du umgehen?", 
              "nordwesten", "dh81");

}