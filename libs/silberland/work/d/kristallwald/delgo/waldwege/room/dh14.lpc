#include "../def.h"

inherit ROOM "std"; 

#include <properties.h>

void create()
{
  ::create();

  RemoveDetail( ({"himmel", "licht"}) );
  AddDetail( ({"himmel", "licht"}),
    "Du kannst den Himmel hier zwar nicht erkennen, aber dafuer bilden "
    "einige Aeste ein pfeilartiges Gebilde.");
  AddDetail( ({"gebilde", "pfeil"}),
    "Ja es ist ein Pfeil. Ob Du einfach seiner Richtung folgen solltest?");
  AddDetail( ({"richtung"}),
    "Du kannst die Richtung nicht naeher bestimmen.");
  AddWaldExit("folge&richtung|pfeil", "Wem oder Was willst Du folgen?", 
              "osten", "dh24");
              

  RemoveDetail( ({"moos", "moose"}) );
  AddDetail( ({"moos", "moose"}),
    "Der moosige Untergrund bildet irgendeine Form, welche Dir bekannt "
    "vorkommt.");
  AddDetail( ({"form", "stufen", "treppe", "stufe"}),
    "Es sieht schon fast aus wie eine Treppe. Das Moos auf den einzelnen "
    "Stufen ist trocken genug, um die Stufen zu ersteigen.");
  AddWaldExit("ersteige|ersteig&stufen|treppe", "Was willst Du ersteigen?", 
              "westen", "dh04");

}