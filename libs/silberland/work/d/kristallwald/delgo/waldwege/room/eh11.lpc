#include "../def.h"

inherit ROOM "std"; 

#include <properties.h>

void create()
{
  ::create();

  RemoveDetail( ({"stein", "steine"}) );
  AddDetail( ({"stein", "steine"}),
    "Da liegt ein groesserer Stein. Ob Du ueber ihn springen kannst?");
  AddWaldExit("spring|springe&ueber&stein", "Ueber was willst Du springen?", 
              "osten", "eh21");
              

  RemoveDetail( ({"zweig", "zweige", "sicht"}) );
  AddDetail( ({"zweig", "zweige", "sicht"}),
    "Einige Zweige behindern deine Sicht. Geh durch.");
  AddWaldExit("geh|gehe&durch&zweige", "Wodurch willst Du gehen?", 
              "suedwesten", "eh02");

}