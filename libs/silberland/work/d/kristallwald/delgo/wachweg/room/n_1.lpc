
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Die Strasse nach Norden" );
  SetProp( P_INT_LONG,
    "Du befindest Dich auf der Strasse nach Norden. Die Strasse ist breit "
    "genug fuer drei Kutschen und die Pflastersteine wurden alle sauber "
    "verlegt. Am Strassenrand stehen vor dem Beginn des Waldes in "
    "regelmaessigen Abstaenden Laternen, "
    "welche die Strasse bei Nacht beleuchten. Im Norden naeherst Du Dich "
    " einer groesseren Schlucht und im Sueden erkennst du einen grossen "
    "Felsen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "strasse" }),
    "Sie heisst so, da sie von Avir nach Norden fuehrt. Mir ist schon klar, "
    "dass sie auch gleichzeitig nach Sueden fuehrt.");
    
  AddDetail( ({ "avir", "fels", "felsen", "stadt" }),
    "Auf dem Felsen ruht die Stadt Avir.");
    
  AddDetail( ({ "kutschen", "kutsche" }),
    "Du kannst gerade keine sehen.");
    
  AddDetail( ({ "pflastersteine", "pflasterstein", "steine", "stein" }),
    "Sie wurden sauber verlegt und Dir faellt nichts an ihnen auf.");
    
  AddDetail( ({ "strassenrand", "rand" }),
    "Er ist gerade und gleichmaessig.");
    
  AddDetail( ({ "begin" }),
    "Der Wald von Tethyr beginnt am Strassenrand.");
    
  AddDetail( ({ "tethyr", "wald"}),
    "Der Wald von Tethyr liegt links und rechts neben der Strasse und ist "
    "gekennzeichnet durch die blaue Faerbung der Blaetter und Nadeln.");
    
  AddDetail( ({ "faerbung", "blau" }),
    "Blau.");
   
  AddDetail( ({ "blaetter", "blatt", "nadeln", "nadel" }),
    "Sie sind blaeulich eingefaerbt."); 
    
  AddDetail( ({ "baeume", "baum", "nadel-", "laubbaeume", "laubbaum", 
                "nadelbaeume", "nadelbaum" }),
    "Es sind Nadel- und Laubbaeume vorhanden, doch besteht der Wald "
    "hauptsaechlich aus Nadelbaeumen.");
    
  AddDetail( ({ "abstaende", "abstand", "meter" }),
    "Alle fuenf Meter.");
    
  AddDetail( ({ "strassenlaterne", "laterne", "strassenlaternen", 
                "laternen" }),
    "Sie beleuchten die Strasse bei Nacht.");
    
  AddDetail( ({ "nacht" }),
    "Nachts wird die Strasse beleuchtet.");
  
  AddDetail( ({ "boden" }),
    "Pflastersteine.");
    
  AddDetail( ({ "himmel" }),
    "Nix besonderes los.");

  AddDetail( ({ "schlucht" }),
    "Die Strasse fuehrt gerade darauf zu. Wenn du weiter nach Norden gehst, "
    "wirst Du sie erreichen.");
    
  AddDetail( ({ "norden" }),
    "Weit im Norden befindet sich eine Schlucht. Sie ist der Ausgang aus "
    "diesem Tal.");
    
  AddDetail( ({ "tal" }),
    "Du befindest Dich im Tal von Tethyr.");
    
  AddDetail( ({ "sueden" }),
    "Wenn Du auf den Felsen im Sueden willst, musst du den Wachweg "
    "benutzen.");
    
  AddDetail( ({ "wachweg", "weg" }),
    "Er fuehrt hoch zur Stadt.");
    
  AddDetail( ({ "ausgang" }),
    "Die Schlucht ist der Durchgang zu Khorinis. Dort kannst Du mit einem "
    "Schiff das Tal verlassen.");
    
  AddDetail( ({ "schiff" }),
    "Bist Du nicht so hergekommen?");
    
  AddDetail( ({ "durchgang", "gang" }),
    "Er fuehrt nach Khorinis.");
    
  AddDetail( ({ "khorinis", "hafenstadt" }),
    "Die Hafenstadt Khorinis.");
    
  AddDetail( ({"beginn", "anfang"}),
    "Der Beginn ist erst der Anfang ;-)");
    
  AddExit( "norden", ROOM "n_2" );
  AddExit( "sueden", ROOM "sn_4" );

}
