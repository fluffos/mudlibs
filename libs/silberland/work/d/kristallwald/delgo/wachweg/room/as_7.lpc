
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

SetProp( P_INT_SHORT, "Ein Vorposten" );
  SetProp( P_INT_LONG,
    "Ueber Bruecken gelangst Du von einem Vorposten zum Naechsten. Die "
    "Wachpunkte sind aufgrund der hohen Lage nicht anders zu erreichen und "
    "dementsprechend ist der Wachweg sicher. Aber in einem guten Zustand ist" 
    " der Weg nach Avir nicht gerade."
    );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail( ({ "boden" }),
    "Der besteht aus Stein und Fels.");
    
  AddDetail( ({ "stein", "fels" }),
    "Hart und alt.");
    
  AddDetail( ({ "himmel" }),
    "Einige Wolken haengen am Himmel, doch man kann die Sonne noch sehen.");
    
  AddDetail( ({ "wolken", "wolke" }),
    "Unauffaellig.");
    
  AddDetail( ({ "sonne" }),
    "An ihr wird sich wohl nie was aendern. Genau so wenig wie am Mond.");
    
  AddDetail( ({ "bruecken", "bruecke" }),
    "An ihnen ist nichts auszusetzen. Ganz normale Bruecken.");
    
  AddDetail( ({ "stadt", "avir" }),
    "Man nennt sie Avir.");
    
  AddDetail( ({ "posten", "vorposten" }),
    "Punkte an denen Wachen stehen, welche den Wachweg vor Feinden "
    "schuetzen.");
    
  AddDetail( ({ "punkte", "punkt", "wachpunkt", "wachpunkte" }),
    "Strategisch gut gewaehlt.");
    
  AddDetail( ({ "wachen", "wache" }),
    "Normale Soeldner wie in der Stadt.");
    
  AddDetail( ({ "lage" }),
    "Oben auf den Felszylindern.");
    
  AddDetail( ({ "felszylinder", "zylinder" }),
    "Sie umgeben das Felsplateau auf dem Avir ruht.");
    
  AddDetail( ({ "felsplateau", "plateau" }),
    "Beeindruckend.");
    
  AddDetail( ({ "wachweg", "weg" }),
    "So wird dieser Weg hier genannt.");
    
  AddDetail( ({ "zustand", "jemand" }),
    "Es wirkt alles sehr alt. Jemand sollte sich mal darum kuemmern.");

  AddDetail( ({ "feind", "feinde", "soeldner" }),
    "Die Soeldner halten die Feinde auf.");
  
  AddDetail( ({ "mond"}), 
    "Obwohl der schon eher wandlungsfaehig ist. Die Sonne kann nur rot "
    "werden, der Mond dagegen noch einige Farben mehr annehmen.");
    
  AddDetail( ({ "farben", "farben", "weiss", "gelb", "schwarz", "rot"}), 
    "Weiss bis Gelb ist normal. Schwarz bei Mondfinsternis. Rot bei "
    "einschlaegigen Ritualen und nicht zu vergessen der Silbermond.");
    
  AddDetail( ({ "rituale", "mondfinsternis", "finsternis", "ritual"}), 
    "Was passiert wenn so ein Ritual bei Mondfinsternis abgehalten wird, ist"
    " nicht dokumentiert.");
    
  AddDetail( ({ "silbermond", "silber"}), 
    "Irgendwie musst Du an gute Musik denken.");
    
  AddDetail( ({ "musik"}), 
    "Du summst leise vor Dich hin.");
    
  AddSound( ({"musik", "toene"}), "Du glaubst einige Toene zu vernehmen, doch"
                                  " Du irrst dich bestimmt.");

  AddExit("westoben", ([EX_TESTFUNC : "func",
                       EX_DEST     : ROOM "as_6"]) );
  AddExit("ostunten", ([EX_TESTFUNC : "func",
                       EX_DEST     : ROOM "as_8"]) );

  SetProp(P_HIDE_EXITS, ({"osten", "westen"}) );
  AddExit("westen", ([EX_TESTFUNC : "func",
                      EX_DEST     : ROOM "as_6"]) );
  AddExit("osten", ([EX_TESTFUNC : "func",
                     EX_DEST     : ROOM "as_8"]) );
                       
  AddItem(NPC "fathania" , REFRESH_DESTRUCT);
}

int func()
{
  object ob;
  
  ob=present("\nbarriere", TO);
  if(ob)
  {
    TP->Message(BS("Du kannst nicht abhauen, die Wand haelt Dich auf!")
                , MSGFLAG_VISUAL);
    return 0;
  }
  return 1; 
}

void reset()
{
  object ob;
  
  ob=present("\nbarriere", TO);
  if(ob)
  {
    ob->remove();
  }
  ::reset();
}
