
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

SetProp( P_INT_SHORT, "Ein Vorposten" );
  SetProp( P_INT_LONG,
    "Ueber Bruecken gelangst Du von einem Vorposten zum Naechsten. Die "
    "Wachpunkte sind aufgrund der hohen Lage nicht anders zu erreichen und "
    "dementsprechend ist der Wachweg sicher. Aber in einem guten Zustand ist" 
    " der Weg nach Avir nicht gerade."
    );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail( ({ "boden" }),
    "Der besteht aus Stein und Fels.");
    
  AddDetail( ({ "stein", "fels" }),
    "Hart und alt.");
    
  AddDetail( ({ "himmel" }),
    "Einige Wolken haengen am Himmel, doch man kann die Sonne noch sehen.");
    
  AddDetail( ({ "wolken", "wolke" }),
    "Unauffaellig.");
    
  AddDetail( ({ "sonne" }),
    "An ihr wird sich wohl nie was aendern.");
    
  AddDetail( ({ "bruecken", "bruecke", "holzbruecke", "holzbruecken" }),
    "An ihnen ist nichts auszusetzen. Ganz normale Bruecken aus Holz.");
    
  AddDetail( ({ "stadt", "avir" }),
    "Man nennt sie Avir.");
    
  AddDetail( ({ "posten", "vorposten" }),
    "Punkte an denen Wachen stehen, welche den Wachweg vor Feinden "
    "schuetzen.");
    
  AddDetail( ({ "punkte", "punkt", "wachpunkt", "wachpunkte" }),
    "Strategisch gut gewaehlt.");
    
  AddDetail( ({ "wachen", "wache" }),
    "Normale Soeldner wie in der Stadt.");
    
  AddDetail( ({ "lage" }),
    "Oben auf den Felszylindern.");
    
  AddDetail( ({ "felszylinder", "zylinder" }),
    "Sie umgeben das Felsplateau auf dem Avir ruht.");
    
  AddDetail( ({ "felsplateau", "plateau" }),
    "Beeindruckend.");
    
  AddDetail( ({ "wachweg", "weg" }),
    "So wird dieser Weg hier genannt.");
    
  AddDetail( ({ "zustand", "jemand" }),
    "Es wirkt alles sehr alt. Jemand sollte sich mal darum kuemmern.");

  AddDetail( ({ "feind", "feinde", "soeldner" }),
    "Die Soeldner halten die Feinde auf.");
    
  AddDetail( ({ "holz"}), 
    "Sowas siehst Du da nicht!\n "
    "...\n"
    "Kleiner Scherz. Natuerlich ist das Holz da.");
    
  AddDetail( ({ "scherz"}), 
    "Also ich koennte noch lachen, wenn das Holz im naechsten Augenblick weg"
    "waere, Du auch?");
    
  AddDetail( ({ "augenblick", "blick"}), 
    "Eine Holzbruecke verschwindet einfach *puff*.\n"
    "Doch da Du Gravitation in der Schule noch nicht hattest, passiert Dir "
    "nichts.");
    
  AddDetail( ({ "gravitation"}), 
    "Zu schwer fuer Dich. Du bleibst lieber hier stehen. Das ist einfach und"
    " man kann sich nicht weh tun.");
    
  AddDetail( ({ "schule"}), 
    "Damals ...\n"
    "Du erinnerst Dich an die 6. Klasse und die kleine Bruenette auf dem "
    "Parkplatz mit ihrem Top ... \n"
    "Du erinnerst Dich an die 7. Klasse und die kleine Bruenette auf dem "
    "Parkplatz ohne ihr Top ...\n"
    "Du schuettelst Dich. Nicht deine Vergangenheit.");
    
  AddDetail( ({ "klasse", "bruenette", "parkplatz", "platz", "top", 
                "vergangenheit", "magier", "erinnerung"}), 
    "Der zustaendige Magier scheint diese Erinnerung hier vergessen zu "
    "haben.");

  AddExit("suedostunten", ROOM "as_6");
  AddExit("suedoben", ROOM "as_4");
  
  SetProp(P_HIDE_EXITS, ({"suedosten", "sueden"}) );
  AddExit("suedosten", ROOM "as_6");
  AddExit("sueden", ROOM "as_4");
  
  AddItem(NPC "soeldner" , REFRESH_DESTRUCT);
}
