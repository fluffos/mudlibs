
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

SetProp( P_INT_SHORT, "Ein Vorposten" );
  SetProp( P_INT_LONG,
    "Ueber Bruecken gelangst Du von einem Vorposten zum Naechsten. Die "
    "Wachpunkte sind aufgrund der hohen Lage nicht anders zu erreichen und "
    "dementsprechend ist der Wachweg sicher. Aber in einem guten Zustand ist" 
    " der Weg nach Avir nicht gerade."
    );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail( ({ "boden" }),
    "Der besteht aus Stein und Fels.");
    
  AddDetail( ({ "stein", "fels" }),
    "Hart und alt.");
    
  AddDetail( ({ "himmel" }),
    "Einige Wolken haengen am Himmel, doch man kann die Sonne noch sehen.");
    
  AddDetail( ({ "wolken", "wolke" }),
    "Unauffaellig.");
    
  AddDetail( ({ "sonne" }),
    "An ihr wird sich wohl nie was aendern.");
    
  AddDetail( ({ "bruecken", "bruecke" }),
    "An ihnen ist nichts auszusetzen. Ganz normale Bruecken.");
    
  AddDetail( ({ "stadt", "avir" }),
    "Man nennt sie Avir.");
    
  AddDetail( ({ "posten", "vorposten" }),
    "Punkte an denen Wachen stehen, welche den Wachweg vor Feinden "
    "schuetzen.");
    
  AddDetail( ({ "punkte", "punkt", "wachpunkt", "wachpunkte" }),
    "Strategisch gut gewaehlt.");
    
  AddDetail( ({ "wachen", "wache" }),
    "Normale Soeldner wie in der Stadt.");
    
  AddDetail( ({ "lage" }),
    "Oben auf den Felszylindern.");
    
  AddDetail( ({ "felszylinder", "zylinder" }),
    "Sie umgeben das Felsplateau auf dem Avir ruht. Eine seltsame "
    "Erscheinung der Natur.");
    
  AddDetail( ({ "felsplateau", "plateau" }),
    "Beeindruckend.");
    
  AddDetail( ({ "wachweg", "weg" }),
    "So wird dieser Weg hier genannt.");
    
  AddDetail( ({ "zustand", "jemand" }),
    "Es wirkt alles sehr alt. Jemand sollte sich mal darum kuemmern.");

  AddDetail( ({ "feind", "feinde", "soeldner" }),
    "Die Soeldner halten die Feinde auf.");

  AddDetail( ({ "erscheinung"}), 
    "Es ist einfach zu optimal. Solch eine geniale Lage kann unmoeglich ohne"
    " Einwirken von Menschenhand entstanden sein. ");
    
  AddDetail( ({ "natur"}), 
    "Sie gibt uns oft Raetsel auf, wie diese Felszylinder und auch Du "
    "bleibst mir ein Raetsel.");

  AddDetail( ({ "raetsel", "loesung", "sicht"}), 
    "Keine Loesung in Sicht.");
    
  AddDetail( ({ "einwirken", "wirken"}), 
    "Wenn Menschen sich in etwas einmischen, z.B. einen Zustand "
    "veraendern.");
    
  AddDetail( ({ "menschenhand", "hand", "menschen"}), 
    "Naja, was man mit seiner Hand noch kann lasse ich hier aus, womit wir "
    "wieder beim Einwirken waeren.");
    
  AddDetail( ({ "zustand", "zustaende"}), 
    "Da gibt es viele.");

  AddExit("ostunten", ROOM "as_7");
  AddExit("nordwestoben", ROOM "as_5");
  
  SetProp(P_HIDE_EXITS, ({"osten", "nordwesten"}) );
  AddExit("osten", ROOM "as_7");
  AddExit("nordwesten", ROOM "as_5");

}