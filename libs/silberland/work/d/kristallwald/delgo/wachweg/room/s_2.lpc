
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Die Strasse nach Sueden" );
  SetProp( P_INT_LONG,
    "Du befindest Dich auf der Strasse nach Sueden. Die Strasse ist breit "
    "genug fuer drei Kutschen und die Pflastersteine wurden alle sauber "
    "verlegt. Am Strassenrand stehen vor dem Beginn des Waldes in "
    "regelmaessigen Abstaenden Laternen, "
    "welche die Strasse bei Nacht beleuchten. Im Sueden naeherst Du Dich der"
    " grossen Felswand und im Norden erkennst du einen grossen Felsen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "strasse" }),
    "Sie heisst so, da sie von Avir nach Sueden fuehrt. Mir ist schon klar, "
    "dass sie auch gleichzeitig nach Norden fuehrt.");
    
  AddDetail( ({ "avir", "fels", "felsen", "stadt" }),
    "Auf dem Felsen ruht die Stadt Avir.");
    
  AddDetail( ({ "kutschen", "kutsche" }),
    "Du kannst gerade keine sehen.");
    
  AddDetail( ({ "pflastersteine", "pflasterstein", "steine", "stein" }),
    "Sie wurden sauber verlegt und Dir faellt nichts an ihnen auf.");
    
  AddDetail( ({ "strassenrand", "rand" }),
    "Er ist gerade und gleichmaessig.");
    
  AddDetail( ({ "begin" }),
    "Der Wald von Tethyr beginnt am Strassenrand.");
    
  AddDetail( ({ "tethyr", "wald"}),
    "Der Wald von Tethyr liegt links und rechts neben der Strasse und ist "
    "gekennzeichnet durch die blaue Faerbung der Blaetter und Nadeln.");
    
  AddDetail( ({ "faerbung", "blau" }),
    "Blau.");
   
  AddDetail( ({ "blaetter", "blatt", "nadeln", "nadel" }),
    "Sie sind blaeulich eingefaerbt."); 
    
  AddDetail( ({ "baeume", "baum", "nadel-", "laubbaeume", "laubbaum", 
                "nadelbaeume", "nadelbaum" }),
    "Es sind Nadel- und Laubbaeume vorhanden, doch besteht der Wald "
    "hauptsaechlich aus Nadelbaeumen.");
    
  AddDetail( ({ "abstaende", "abstand", "meter" }),
    "Alle fuenf Meter.");
    
  AddDetail( ({ "strassenlaterne", "laterne", "strassenlaternen", 
                "laternen" }),
    "Sie beleuchten die Strasse bei Nacht.");
    
  AddDetail( ({ "nacht" }),
    "Nachts wird die Strasse beleuchtet.");
    
  AddDetail( ({ "felswand", "felswaende", "waende", "wand", "tal" }),
    "Die Felswaende umschliessen das Tal von Tethyr.");
    
  AddDetail( ({ "norden" }),
    "Ein grosser Felsen. Geh doch hin.");
    
  AddDetail( ({ "sueden", "hoehle" }),
    "Du glaubst im Sueden eine Hoehle zu erkennen, doch sicher bist Du Dir "
    "nicht. Geh einfach naeher ran.");
    
  AddDetail( ({ "boden" }),
    "Pflastersteine.");
    
  AddDetail( ({ "himmel" }),
    "Nix besonderes los.");
    
  AddDetail( ({"beginn", "anfang"}),
    "Der Beginn ist erst der Anfang ;-)");
    
  AddExit( "norden", ROOM "s_1" );
  AddExit( "sueden", ROOM "s_3" );

 
}