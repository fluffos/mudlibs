
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Bergpass" );
  SetProp( P_INT_LONG,
    "Der Bergpass verlaeuft recht schmal, es wuerden gerade so zwei Kutschen"
    " aneinander vorbeipassen. Die Strasse ist jedoch in gutem Zustand, "
    "scheinbar wird sie regelmaessig gepflegt. Die Felswaende ragen hoch "
    "neben Dir auf geben den Weg ganz klar vor. Du kannst nach Norden in "
    "die Stadt oder nach Sueden ins Tal." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 17, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail( ({ "bergpass", "pass" }),
    "So nennt man diesen Weg hier.");
    
  AddDetail( ({ "weg" }),
    "Es ist schon eher eine Strasse.");
    
  AddDetail( ({ "strasse" }),
    "Sie ist recht schmal, im Vergleich zu der Strasse nach Norden im Sueden"
    " (Achtung Wortspiel), doch gibt die Schlucht einfach nicht mehr her. "
    "Der Strassenrand schliesst mit der Felswand ab. Die Strasse selbst "
    "besteht aus Pflastersteinen.");
  
  AddDetail( ({ "kutschen", "kutsche" }),
    "Du kannst gerade keine sehen");
    
  AddDetail( ({ "pflastersteine", "pflasterstein", "steine", "stein" }),
    "Sie wurden sauber verlegt und Dir faellt nichts an ihnen auf.");

  AddDetail( ({ "boden" }),
    "Er besteht aus einer Strasse.");
    
  AddDetail( ({ "himmel" }),
    "Das was Du zwischen den Felswaenden sehen kannst ist wolkenlos.");
    
  AddDetail( ({ "vergleich" }),
    "Der bietet sich an.");
    
  AddDetail( ({ "norden" }),
    "Du kannst schon die ersten Huetten erkennen.");
    
  AddDetail( ({ "huetten", "huette" }),
    "Einzelheiten sind noch nicht zu erkennen, dazu bist Du zu weit weg.");

  AddDetail( ({ "einzelheiten" }),
    "In der Stadt selbst gibt es garantiert mehr zu sehen.");
    
  AddDetail( ({ "stadt", "khorinis" }),
    "Die Stadt heisst Khorinis.");
    
  AddDetail( ({ "achtung", "wortspiel", "sueden", "name", "namen" }),
    "Nicht durcheinander kommen. Im Sueden befindet sich die Strasse mit dem"
    " Namen 'Strasse nach Norden'. ");
    
  AddDetail( ({ "schlucht" }),
    "Die Felswaende der Schlucht sind glatt und fast ueberall senkrecht. Du "
    "ueberlegst ob die Bewohner von Khorinis eventuell Bogenschuetzen "
    "oben auf Kanten positioniert haben.");
    
  AddDetail( ({ "bewohner" }),
    "Findest Du im Norden.");
    
  AddDetail( ({ "bogenschuetzen", "schuetzen" }),
    "Es waere eine gute Verteidigung.");
    
  AddDetail( ({ "verteidigung" }),
    "Sie koennten sich so gegen Tiere aus dem Tal wehren.");
    
  AddDetail( ({ "tiere" }),
    "Du weist nicht ob es so ist, doch Du haelst die Augen auf.");
    
  AddDetail( ({ "augen", "waffenkauf" }),
    "Augen auf beim Waffenkauf!");
    
  AddDetail( ({ "tal" }),
    "Du gelangst zum Tal wenn Du nach Sueden gehst.");
    
  AddDetail( ({ "felswaende", "felswand", "waende", "wand", "kanten", "kante" }),
    "Du ueberlegst, ob Du da hochklettern kannst aber verwirfst den Gedanken"
    " wieder.");
    
  AddDetail( ({ "gedanken", "gedanke", "meter" }),
    "Das waere zu gefaehrlich, die Waende sind mindestens 70 Meter hoch.");
    
  AddDetail( ({ "strassenrand", "rand" }),
    "Er endet direkt an der Felswand.");
    
  AddDetail( ({ "zustand" }),
    "Kaum beschwerdefaehig.");
   


  AddExit( "norden", ROOM "p_3" );
  AddExit( "sueden", ROOM "p_1" );
}

