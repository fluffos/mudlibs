inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein leichter Kompositbogen");
  SetProp(P_LONG, 
    "Ein Kompositbogen ist ein spezieller, aus mehreren verschiedenen "
    "Materialien bestehender Bogen, mit dennoch hoher Spannkraft. Aufgrund "
    "der guten Handhabbarkeit eignet er sich gut fuer Reiter und Wildhueter."
    );
  SetProp(P_NAME, "Kompositbogen");
  SetProp(P_GENDER, MALE);
  AddId( ({"bogen", "kompositbogen"}) );
  
  AddDetail( ({"materialien","material","horn","holz","fell"}),
    "Der Bogen besteht aus Holz und Horn, teilweise ueberzogen mit Fell.");
    
  AddDetail( ({"handhabbarkeit","spannkraft"}),
    "Du verstehst zu wenig davon, um die Bauweise naeher zu untersuchen.");

  AddDetail( ({"wildhueter"}),
    "Wildhueter halten Besitztuemer von Adligen frei von Raubtieren.");

  SetProp(P_WEAPON_TYPE, WT_BOW);
  SetProp(P_WC, 130); 
  SetProp(P_WC_FIX, 30);
  SetProp(P_WC_BONUS,
    (["Bogenkaempfer":50, "Bogenexperte":120, "Bogenmeister":160]) );
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_HORN:25, MAT_WOOD:65, MAT_PELT:10]) );
  SetProp(P_WEIGHT, 1450);
  SetProp(P_VALUE, 550);
  SetProp(P_SIZE, 112);
  SetProp(P_QUALITY_DECAY, 150);
  
  SetProp(P_WIELD_RESTRICTIONS, ([P_LEVEL: 20]) );

}

