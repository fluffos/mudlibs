inherit "std/weapon";
#include "../def.h"

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Katana");
  SetProp(P_LONG,  
    "Dieses edle Langschwert stammt aus einer fern gelegenen Region des Silber"
    "landes. Der Griff ist edel verziert und die Klinge ist optimal geschaerft."
    " Die Klinge ist leicht gebogen und wenn du das Schwert durch die Luft "
    "sausen laesst kommt ein singendes Geraeusch. Das ist mit Abstand eine der "
    "schaerfsten Klingen, die Du gesehen hast." );
    
  AddDetail( ({"langschwert", "schwert"}), 
     "Es gehoert zu den Langschwertern.");
     
  AddDetail( ({"region", "silberland"}), 
     "Heute weis niemand mehr woher diese seltenen Schwerter kommen.");
     
  AddDetail( ({"griff"}), 
     "Auf den kleinen Stoffstreifen, welche den eigentlichen Griff umschliessen"
     " sind Zeichen einenaeht.");
     
  AddDetail( ({"zeichen", "stoffstreifen", "streifen", "seide", "stoff"}), 
     "Mit roter Seide wurde auf dem schwarzen Stoff Fathania eingenaeht.");
  
  AddDetail( ({"klinge"}), 
     "Sauscharf. Damit kann man alles schneiden, diese Klinge wird die "
     "haertsten Ruestungen durchdringen, du glaubst sogar fast Stein koennte "
     "dieses Schmiedewerk zerschneiden.");
     
  AddDetail( ({"schmiedewerk", "werk"}), 
     "Solche Schwerter wurden frueher bis zu 100 mal gefalten.");
     
  AddDetail( ({"fathania"}), 
     "Ihr scheinte diese Klinge zu gehoeren. Sie hat sie wohl nie oder sehr "
     "schlecht verwendet.");
  
  SetProp(P_NAME, "Katana");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARTICLE, 1);
  AddId( ({"katana", "schwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 240);
  SetProp(P_WC_FIX, 45);
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL :95, MAT_LEATHER:5]) );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 5000);
  SetProp(P_SIZE, 120);
  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1,
                                  A_DEX:  25 ]) ); 
  
}

