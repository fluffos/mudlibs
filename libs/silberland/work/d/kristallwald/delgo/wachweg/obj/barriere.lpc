#include "../def.h"

inherit "std/thing";



void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Wand aus Metall");
  SetProp(P_LONG,
    "Eine Metallwand, welche Dich einschliesst. Scheinbar kann man von der "
    "anderen seite ungehindert durchgehen. Da muss Magie im Spiel sein. Was "
    "fuer eine boesartige Falle."
  );
  SetProp(P_INFO, "Diese Wand faellt erst mit dem Tod ihres Erbauers.");
  SetProp(P_NAME, "Metallwand");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"wand", "metallwand", "\nbarriere", "NODESTRUCT", 
           "SKILL_NOLEARN"}) );
  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_WEIGHT, 200000);
  SetProp(P_SIZE, 500);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOGET, "Die Wand kannst Du nicht einreissen."); 
  
  call_out("remove", 120);
  
}

void remove()
{
  if(ENV(TO)) ENV(TO)->Message(BS("Die Metallwand zerfaellt."));
  ::remove();
}

