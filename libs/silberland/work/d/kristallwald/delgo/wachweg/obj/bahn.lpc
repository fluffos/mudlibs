inherit "std/transport";
#include "../def.h"
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Kabine" );
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich in der Kabine einer Seilbahn.") );
  SetProp( P_SHORT, "Eine Seilbahn" );
  SetProp( P_LONG, BS(
    "Du siehst eine Seilbahn.") );
  SetProp( P_NAME, "Seilbahn" );
  AddId( ({ "seilbahn", "bahn" }) );
  SetProp( P_GENDER, FEMALE );
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT,1);

  AddDetail( "kabine", BS(
    "Die kleine Kabine besitzt keine Besonderheiten. Zwei Sitzbaenke und "
    "eine Tuer. Durch die Fenster kannst Du nach draussen sehen.") );
  
  AddDetail( ({ "besonderheiten" }), 
    "Keine da.");
    
  AddDetail( ({ "sitzbaenke", "baenke" }), 
    "Es passen je zwei Personen darauf. Nummer Fuenf muss stehen.");
    
  AddDetail( ({ "personen", "nummer", "fuenf" }), 
    "Es passen nur fuenf Personen in diese Kabine. Trolle muessen sich "
    "buecken.");
    
  AddDetail( ({ "trolle", "troll", "bueckdichtrolle" }), 
    "Die sogenannten Bueckdichtrolle!");
    
  AddDetail( ({ "tuer" }), 
    "Sie oeffnet automatisch.");
    
  AddDetail( ({ "fenster" }), 
    "Du kannst rausschauen, Du musst nicht.");
  
  AddDetail( ({ "boden", "himmel", "seilbahn", "decke", "waende", "wand" }), 
    "Alles noch da. (Zum Glueck)");
  
  AddDetail( ({"glueck", "element", "leben", "lebens"}),
    "Glueck ist ein sehr wichtiges Element des Lebens.");
  
  SetProp( P_DEPARTMSG, ({
    "Die Seilbahn faehrt ab.\n", 
    "Die Seilbahn faehrt ab.\n"}) );
  SetProp( P_ARRIVEMSG, ({
    "Die Seilbahn erreicht das Plateau von @@QueryArrived@@.\n",
    "Die Seilbahn faehrt heran.\n"}) );
    
  SetProp( P_ENTERMSG, ({
    "besteigt die Seilbahn",
    "kommt herein"}) );
  SetProp( P_ENTERFAIL, ({
    "Es passen nur 5 Passagiere in die Kabine",
    "hat keinen Platz mehr in der Kabine"}) );
  SetProp( P_MAX_PASSENGERS, 5 );

  SetProp( P_LEAVEMSG, ({
    "verlaest die Seilbahn",
    "kommt aus der Seilbahn"}) );
  SetProp( P_LEAVEFAIL, ({
    "Die Seilbahn ist noch unterwegs"}) );

  AddCmd( ({ "betrete", "betritt" }), "rein" );
  AddCmd( ({ "verlasse", "verlass" }), "raus" );

  AddRoute( ROOM "as_8", 30, 20, 
         "Avir", ({"avir", "stadt", "plateau"}),
         "zu dem Plateau von Avir" );
  AddMsg( "Die Seilbahn faehrt abwaerts.\n", 10 );
  AddMsg( "Die Seilbahn naehert sich dem Plateau.\n", 10 );
  AddRoute( ROOM "sb", 30, 20, 
         "Tal", ({"tal", "wald"}),
         "ins Tal" );
  AddMsg( "Die Seilbahn faehrt aufwaerts.\n", 10 );
  AddMsg( "Die Seilbahn naehert sich dem Plateau.\n", 10 );
 	
  Start();
}

rein(str)
{
  notify_fail("Was willst Du betreten?\n");
  if( str && id(str) )
    return Enter();
  return 0;
}

raus(str)
{
  notify_fail("Was willst Du verlassen?\n");
  if(!(QueryArrived())) 
  {
    TP->Message(BS("Das solltest Du nicht waehrend der Fahrt versuchen!"));
    return 1;
  }
  if( str && id(str) )
    return Leave();
  return 0;
}

void init()
{
  ::init();
  // Sichergehen, dass alle Haefen auch geladen sind.
  if (interactive(this_player()))
  {
    catch(call_other( ROOM "as_8", "refresh", 0));
    catch(call_other( ROOM "sb", "refresh", 0));
  }
}
void refresh()
{
	//Juhu! Leerlauf!
}