#include "../def.h"

inherit "std/thing";



void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Paar Bleifesseln (um die Handgelenke gefesselt)");
  SetProp(P_LONG,
    "Bleifesseln wurden um deine Handgelenke gefesselt und selbst mit ganzer "
    "Kraft gelingt es Dir nicht Deine Arme zu heben, so kannst Du unmoeglich "
    "kaempfen. Die Fesseln sind einfach zu schwer." 
  );
  SetProp(P_INFO, "Die Bleifesseln sind magisch aufgeladen, solange sie nicht"
    " zerfallen, wirst Du sie nicht ablegen koennen. Durch das extrem hohe "
    "Gewicht, kannst Du Deine Arme nicht mehr heben und somit nicht kaempfen. "
    "Zaubern sollte noch gehen.");
  SetProp(P_NAME, "Bleifesseln");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"bleifesseln", "fesseln", "blei", "\nblei"}) );
  SetProp(P_MATERIAL, MAT_LEAD );
  SetProp(P_WEIGHT, 200000);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, "Du wirst die Bleifesseln nicht los.\n");
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, "Du wirst die Bleifesseln nicht los.\n");
  
  call_out("reset", 120);
  
}

int spell()
{
  object pl;

  if(!( objectp(ENV(TO)) && file_name(ENV(TO)) ) ) 
  {
    TO->remove();
    return 1;
  }
  
  pl=ENV(TO);
  pl->SetProp(P_DISABLE_ATTACK, 999);
  pl->Message(BS("Du kannst deine Arme nichtmehr heben!"), MSGFLAG_SENSE);
  call_out("reset", 60);               
  return 1;
}

void reset()
{
  object pl;
  
  if (!is_clone(this_object())) return;
  
  if(!( objectp(ENV(TO)) && file_name(ENV(TO)) ) ) 
  {
    TO->remove();
    return;
  }

  ::reset();
  
  if(pl=ENV(TO))
  {
    if(!interactive(pl)) 
    {
      TO->remove();
      return;
    }
    pl->SetProp(P_DISABLE_ATTACK, 1);
    pl->Message(BS("Die Fesseln zerfallen und langsam bekommst Du wieder "
                   "Gefuehl in den Armen."), MSGFLAG_SENSE);
  }
  TO->remove();
  return;
}