#include "../def.h"

inherit "std/thing";



void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Eisenring (Um den Hals getragen)");
  SetProp(P_LONG,
    "Ein Eisenring, den Dir ein Metallmagier wie einen Fluch um den "
    "Hals gelegt hat. Er is extrem schwer."
  );
  SetProp(P_INFO, "Der Eisenring ist magisch aufgeladen, solange er nicht"
    " zerfaellt, wirst Du ihn nicht ablegen koennen. Er hindert Dich "
    "irgendwie am Zaubern.");
  SetProp(P_NAME, "Eisenring");
  SetProp(P_GENDER, MALE);
  AddId( ({"eisenring", "ring", "eisen", "\neisen"}) );
  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_SIZE, 20);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, "Du wirst den Eisering nicht los.\n");
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, "Du wirst den Eisenring nicht los.\n");
  
  call_out("reset", 120);
  
}

int spell()
{
  object pl;
  
  if(!( objectp(ENV(TO)) && file_name(ENV(TO)) ) ) 
  {
    TO->remove();
    return 1;
  }
  pl=ENV(TO);
  pl->SetProp(P_DISABLE_SPELLS, 999);
  pl->Message(BS("Die hohe Konzentration des Eisenrings behindert deine "
                 "Konzentration."), MSGFLAG_SENSE);
  call_out("reset", 60);               
  return 1;
}

void reset()
{
  object pl;
  
  if (!is_clone(this_object())) return;
  
  if(!( objectp(ENV(TO)) && file_name(ENV(TO)) ) ) 
  {
    TO->remove();
    return;
  }

  ::reset();
  
  if(pl=ENV(TO))
  {
    if(!interactive(pl)) 
    {
      TO->remove();
      return;
    }
    pl->SetProp(P_DISABLE_SPELLS, 1);
    pl->Message(BS("Der Eisenring zerfaellt, du erlangst deine Konzentration "
                   "langsam wieder."), MSGFLAG_SENSE);
  }
  TO->remove();
  return;
}
