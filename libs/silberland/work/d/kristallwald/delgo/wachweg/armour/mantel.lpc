inherit "std/armour";
#include "../def.h"

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein metallener Mantel");
  SetProp(P_LONG, 
    "Ein langer, schwarzer Mantel, in den Eisenschuppen eingeflochten wurden. "
    "Scheinbar bestehen sogar die Fasern aus Eisen. Durch den hohen Anteil an "
    "Eisen ist er sehr schwer, schuetzt aber auch besser.");
  SetProp(P_NAME, "Metallmantel");
  SetProp(P_GENDER, MALE);
  AddId( ({"mantel" , "metallmantel"}));
  SetProp(P_ARMOUR_TYPE, AT_CLOAK); 
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ({MAT_IRON, MAT_CLOTH}) );
  SetProp(P_WEIGHT, 6000);
  SetProp(P_VALUE, 5000);
  SetProp(P_QUALITY_DECAY, 100 );
  
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
}

