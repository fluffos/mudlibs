//Der Weapon NPC, fast 80&% uebernommen von Torian, wollten gerade das selbe
//schreiben ;-), sein original war einfach nur genial, also habe ichs 
//uebernommen

inherit "std/npc";

#include <npcmaster.h>

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"


void create() {
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Feindruestung");
  SetProp(P_LONG,
    "Du siehst einen Fehler im Raum-Zeit-Gefuege.");

  SetProp(P_NAME, "Feindruestung");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-30,T_RANGE_MAX:30]));
  AddId(({"\narmour_npc"}));
  create_default_npc(25);
  
  SetProp(P_NO_SCORE, 1);
  
  SetProp(P_SIZE, 130);
  SetProp(P_WEIGHT, 50000);
  SetProp(P_ALIGN, 650);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,0);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_MSGIN, "schwebt heran");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "schwebt heran");
  SetProp(P_MMSGOUT, "verschwindet");
  SetProp(P_DIE_MSG,  " wird von der Seele verlassen.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_NAME, "Die groesste Macht der eisernen Gilde");
  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name()+" kann nichts tragen.\n" }) );
  SUID;
 
}

void customize(object armour)
{
  int level,hp, speed;
  string hands;

  level = (armour->QueryProp(P_AC));
  if(level > 30) level = 30;
  hp = (10*level+level*level);

  SetProp(P_SHORT, ""+armour->QueryProp(P_SHORT)+" (beseelt)");
  SetProp(P_LONG, armour->QueryProp(P_LONG));
  SetProp(P_NAME, armour->QueryProp(P_NAME));
  AddId(armour->QueryProp(P_IDS));
  SetProp(P_GENDER, armour->QueryProp(P_GENDER));
  create_default_npc(level, hp);
  SetProp(P_HANDS, ({" mit ganzer Kraft", (level*4), DT_BLUDGEON}) );

}
