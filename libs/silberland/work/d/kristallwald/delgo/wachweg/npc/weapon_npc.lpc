//Der Weapon NPC, fast 80&% uebernommen von Torian, wollten gerade das selbe
//schreiben ;-)

inherit "std/npc";

#include <npcmaster.h>

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Feindwaffe");
  SetProp(P_LONG,
    "Du siehst einen Fehler im Raum-Zeit-Gefuege.");

  SetProp(P_NAME, "Feindwaffe");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-30,T_RANGE_MAX:30]));
  AddId(({"\nweapon_npc"}));
  create_default_npc(25);
  
  SetProp(P_NO_SCORE, 1);
  
  SetProp(P_SIZE, 130);
  SetProp(P_WEIGHT, 50000);
  SetProp(P_ALIGN, 650);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,0);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_MSGIN, "schwebt heran");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "schwebt heran");
  SetProp(P_MMSGOUT, "verschwindet");
  SetProp(P_DIE_MSG,  " wird von der Seele verlassen.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_NAME, "Die groesste Macht der eisernen Gilde");
  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name()+" kann nichts tragen.\n" }) );
  SUID;
 
}

void customize(object weapon)
{
  int level, hp, speed;
  string *dtype;

  if(!objectp(weapon)) remove();
  
  dtype = weapon->QueryProp(P_DAM_TYPE);
  
  if (!pointerp(dtype))
    dtype = ({ dtype });

  SetProp(P_SHORT, weapon->QueryProp(P_SHORT)+" (beseelt)");
  SetProp(P_LONG, weapon->QueryProp(P_LONG));
  SetProp(P_NAME, weapon->QueryProp(P_NAME));
  AddId(weapon->QueryProp(P_IDS));
  SetProp(P_GENDER, weapon->QueryProp(P_GENDER));


  level = (weapon->QueryProp(P_WC)/10) + random(10);
  if(level > 30) level = 30;
  hp = (10*level+level*level)*(95+random(11))/100;
  
  create_default_npc(level, hp);
// Schadensarten uebernehmen, magische Waffen bekommen einen Bonus (max 60)
  SetProp(P_HANDS, ({" jetzt",
                   QueryProp(P_HANDS)[1]+weapon->QueryProp(P_MAGIC)*5,
                   dtype}));
// Einhaender haben nicht soviel WC, bekommen daher einen Speed bonus
// Sonst waeren Mithrilschwerter sehr leicht und Streiaexte sehr schwere Gegner.
  if(weapon->QueryProp(P_WC_FIX) > 40+random(20))
  {
    speed = weapon->QueryProp(P_WC_FIX)*(level/5);
    if(speed > 200) speed = 200;
    TO->ModifySkillAttribute(TO, SA_SPEED, 100+speed, 10);
  }
}