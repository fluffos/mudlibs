/*****************************************************************************
TestNPC fuer std_ranger
*****************************************************************************/
//** INCLUDE + INHERIT + DEFINE ********************************************//
#include "../def.h"
#include "/secure/npcmaster.h"
inherit "/p/std/npc/default_ranger_npc.lpc";
//-- Vars --------------------------------------------------------------------

//-- Prototypes --------------------------------------------------------------

//**************************************************************************//



//** Standardfunktionen ****************************************************//
//-- Create ------------------------------------------------------------------
void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Hyn'gias, ein Waldlaeufer");
  SetProp(P_LONG,
    "Wenn Du etwas von diesem Elfen erkennen kannst, ist es seine Jugend. Er "
    "scheint noch recht unerfahren zu sein, doch wenn ihn die Waldlaeufer "
    "allein losgeschickt haben, wird er wohl kein Schueler mehr sein. Da "
    "er fast seinen ganzen Koerper mit seiner einfachen Jagdkleidung "
    "verhuellt, laesst sich nicht mehr erkennen.");

  SetProp(P_NAME, "Hyn'gias");
  SetProp(P_GENDER, MALE);
  AddId(({"hyn'gias'", "hyngias", "hyn", "waldlaeufer"}));
  AddClass( ({CL_ELF}) );
  SetProp(P_ARTICLE, 0);

  create_default_npc(20);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 192);
  SetProp(P_WEIGHT, 72000);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 15);
  SetProp(P_NOMAGIC, 20);
  SetProp(P_NO_SCORE, 1);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+"sagt: Das kann ich nicht gebrauchen.\n" }) );

  SetProp(P_MSGIN, "kommt heran");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "tritt aus einem Schatten hervor");
  SetProp(P_MMSGOUT, "verschwindet einfach");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Ein Waldlaeufer");

  AddInfo(DEFAULT_INFO, ({
    "schweigt.\n",
    "gruebelt etwas.\n",
    "hat Dich scheinbar nicht gehoert.\n",
    "sagt: Stoer mich bitte nicht, ich habe einen Auftrag.\n"}) );

  AddInfo( ({"auftrag","waldlaeufer"}),
    "Darueber darf ich nicht sprechen. Ich muss das alleine schaffen!",
    "sagt: ");
    
  SetProp(P_SPELLRATE, 20);

  SetChats(1,
  ({Name(WESSEN, 1)+" Umhang weht kurz im Wind.\n",
    Name(WER, 1)+" murmelt etwas von 'Auftrag'.\n",
   }) );

  SUID;

  create_default_ranger(20,6,({}) );
  
  SetProp(P_WIMPY, 15);

  CLONEME(WEAPON"bogen_mittel");
  command("zuecke bogen");
  
  CLONEME("/p/armour/armour/lederruestung");
  CLONEME("/p/armour/cloak/umhang");
  CLONEME("/p/armour/boots/lederstiefel");
  command("trage alles");

}

//-- Der Tod -----------------------------------------------------------------
void die(int poisondeath)
{
  write_file(LOG "npc.deads",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt den "+name(WEN,1)+".\n");
  ::die(poisondeath);
}

//-- Spielertode -------------------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
    write_file(LOG "npc.kills",
      ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+" "
      "umgebracht.\n");
}
//**************************************************************************//



//** Reaktionen ************************************************************//
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "versucht Dich nicht einzuschuechtern.",
        "schaut "+TP->name(WEN, 1)+" unglaeubig an.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "sagt: Beruhige Dich!",
        "sagt: Beruhige Dich "+TP->name(WER)+"!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "laechelt Dich an.",
        "laechelt "+TP->name(WEN, 1)+".");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "sagt aergerlich: Lass das!",
        "sagt aergerlich: Lass das "+TP->name(WER)+"!");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "sagt aergerlich: Lass das!",
        "sagt aergerlich: Lass das "+TP->name(WER)+"!");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "hebt fragend eine Augenbraue.",
        "hebt fragend eine Augenbraue.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "hebt fragend eine Augenbraue.",
        "hebt fragend eine Augenbraue.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "laechelt Dich an.",
        "laechelt "+TP->name(WEN, 1)+" an.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "beachtet Dich nicht weiter.",
        "beachtet "+TP->name(WEN, 1)+" nicht weiter.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "versucht Dich zu troesten.",
        "versucht "+TP->name(WEN, 1)+" zu troesten.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
//**************************************************************************//