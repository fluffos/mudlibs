inherit "std/npc";
inherit "std/player/soul";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Metallmagier");
  SetProp(P_LONG,
    "Du schluckst trocken. Was hat den ein Mitglied der alten Gilde der "
    "Metallmagier hier verloren? Du hast schon viel von ihren Maechten "
    "gehoert. Angeblich wird ihre Macht durch Metall verstaerkt und sie "
    "koennen es kontrollieren. Du hoffst vor Dir steht ein nicht ganz so "
    "gut ausgebildeter Magus. Die hagere Gestalt hat ihr Gesicht unter "
    "einer Kapuze verborgen.");
  SetProp(P_NAME, "Metallmagier");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"metallmagier", "magier", "magus", "mmagier"}));
  create_default_npc(25);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 190);
  SetProp(P_WEIGHT, 70000);
  SetProp(P_ALIGN, -600);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0); 
  SetProp(P_NOMAGIC,  25); //grosser Schutz durch den Mantel, den sie mit 
                           //astralenergie durchfluten

  SetProp(P_MSGIN, "wandelt herein");
  SetProp(P_MSGOUT, "wandelt");
  SetProp(P_MMSGIN, "wandlet herein");
  SetProp(P_MMSGOUT, "sagt: Ich muss weg.");

  SetProp(P_DIE_MSG,  " zerfaellt zu Eisenspaenen, die vom Wind verweht "
    "werden.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_NAME, "Die Macht des Metalls");

  AddDetail( ({"haare","frisur"}),
    "Die Haare sind schwarzbraun und fast kinnlang.");

  AddDetail( ({"ohren","ohr"}),
    "Die Ohren werden von den Haaren verdeckt.");
  
  AddDetail( ({"nase"}),
    "Du bemerkst nichts an der Nase.");
    
  AddDetail( ({"gesicht"}),
    "Der Mann versucht deinen Blicken auszuweichen.");
        
  AddDetail( ({"augen","auge", "pupillen"}),
    "Kleine Augen schauen sich regelmaessig um.");
    
  AddDetail( ({"haut"}),
    "Die Haut eher hell, der Mann ist wohl nicht oft in der Sonne.");
    
  AddDetail( ({"lippen", "mund", "lippe"}),
    "Er presst angestrengt die Lippen aufeinander.");
    
  AddDetail( ({"koerper"}),
    "Der Mann laeuft leicht uebergebeugt und versucht unauffaellig zu "
    "wirken.");
    
  AddDetail( ({"kleidung"}),
    "Er traegt eher dunkle Kleidung.");
  
  AddInfo(DEFAULT_INFO, 
    ({"ignoriert Dich gekonnt.\n",
      "murmelt etwas Unverstaendliches.\n" }) );
  AddInfo("delgo", "Ich habe schon von ihm gehoert.","sagt: ");
  
  AddInfo( ({"arbeit","handwerk"}) , "Das geht Dich nichts an."
    ,"sagt: ");
    
  AddInfo( ({"leben","alter"}) ,"Ich lebe lang genug um zu wissen, dass "
     "ich nicht antworten muss."
    ,"sagt: ");
    
  AddInfo( ({"gebiet","hilfe", "wachweg"}) , "Wir bewachen den Wachweg."
    ,"sagt: ");


  SetProp( P_REJECT, ({ REJECT_DROP,
    " braucht Dein Geruempel nicht.\n" }) );

  SetProp(P_SPELLRATE, 28);
  AddSpell(1,1,
    "Der Magier konzentriert sich auf Deinen Oberkoerper...\n",
    "Der Magier konzentriert such auf @WEN.\n",
     DT_BLUDGEON, "wurf" ,([SP_SHOW_DAMAGE:1]));
     
  add_soul_commands();

  SetChats(3, ({
    "Der Magier murmelt leise.\n"}) );
  SetAttackChats(10, ({
    "Der Magus lacht leise.\n"}) );

  SUID;
  CLONEME(ARMOUR "mantel" );
  command("trage alles");
}

void wurf(object enemy)
{
  object *armour;
  object ob, eisen;

  eisen=present("\neisen", enemy);
  if(!enemy) return;
  if(!eisen)
  {
    armour=enemy->QueryArmours(AT_ARMOUR);
    if(!sizeof(armour))
    {
      call_out("eisenring",0, enemy);
      return;
    }
    if(!(armour[0]->QueryMaterialGroup(MATGROUP_METAL)))
    {
      call_out("eisenring",0, enemy);
      return;
    }
  }
  enemy->SetProp(P_DISABLE_ATTACK, 1);
  enemy->SetProp(P_DISABLE_SPELLS, 1);
  TO->SetProp(P_DISABLE_ATTACK, 1);
  TO->SetProp(P_DISABLE_SPELLS, 3);
  enemy->SetProp(P_TMP_MOVE_HOOK, ({ time()+4, TO,"hold"}) );
  ENV(TO)->Message( BS("Der Magier laechelt kurz kalt, als die Ruestung von "
    ""+enemy->QueryProp(P_NAME)+" kurz aufleuchtet und "
    +enemy->QueryProp(P_NAME)+" einige Meter nach oeben schwebt und "
    "hilflos herumzappelt.\n")
    , MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({enemy}) ]) );
  enemy->Message(BS("Auf einmal faengst Du an nach oben zu schweben. Hilflos"
    " zappelst Du in der Luft herum waerend Dich der Magier angrinst.\n")
    , MSGFLAG_VISUAL);
  call_out("komet", 4, enemy);
  return;
}
void komet(object enemy)
{
  int hp, dam;
  
  hp=enemy->QueryProp(P_HP);
  dam=(50)+random(50);
  ENV(TO)->Message(BS("Der Magier reisst seine Haende blitzartig nach unten "
    "und "+enemy->QueryProp(P_NAME)+" rast auf den Boden zu um dort zu "
    "zerschellen!\n"), MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({enemy}) ]) );
  enemy->Message(BS("Der Magier macht eine Handbewegung Du und faellst "
  "extrem schnell zurueck auf den Boden.\n Du zerschellst auf dem Boden.\n")
    , MSGFLAG_VISUAL);
  if(hp < dam) enemy->SetProp(P_TMP_MOVE_HOOK, ({ 0, TO,"hold"}) );
  enemy->do_damage(dam);
  return;
}
string hold()
{ 
  return "Die Macht des Magiers haelt Dich noch fest!\n"; 
}

void eisenring(object enemy)
{
  object ob, eisen;
  
  eisen=present("\neisen", enemy);
  if(eisen) {return;}
  
  command_me("sag Dass Du keine Metallrestung traegst, nuetzt Dir auch nichts "
             ""+enemy->QueryProp(P_NAME)+"!\n");
  enemy->Message(BS("Der Magier murmelt eine kurze Formel und ein "
    "Sklavenring aus Eisen legt sich um deinen Hals!\n"), MSGFLAG_VISUAL);
  ob=clone_object(OBJ "eisen");
  ob->move(enemy, M_GET | M_SILENT);
  ob->spell();
  return;
  
}

//____________________________ Reactions _________________________________//

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;
  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "lacht Dich aus.",
        "lacht @WEN aus.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "brummt: Verschwinde!",
        "brummt: Verschwinde!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "schuettelt nur den Kopf.",
        "schuettelt nur den Kopf.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "lacht Dich nur aus.",
        "lacht @WEN nur aus.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "grummelt: Lenk mich nicht ab!",
        "grummelt: Lenk mich nicht ab @WER!");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Geh woanders spielen und lass die Erwachsenen arbeiten.",
        "sagt zu @WEM: Geh woanders spielen und lass die Erwachsenen "
        "arbeiten.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "lacht ueber Dich.",
        "lacht ueber @WEN.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
void angriff(object pl)
{
  if(!ENV(TO))           return;
  if(!ENV(pl))           return;
  if(!interactive(pl))   return;
  if(ENV(TO) != ENV(pl)) return;
  Kill(pl);
  return;
}

void init()
{
  ::init();
  if(!TP)                               return;
  if(!interactive(TP))                  return;
  if(TP->QueryProp(P_GHOST))            return;
  if(!WACHMASTER->IsMagicanEnemy(TP))   return;
  call_out("angriff", 0, TP);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  WACHMASTER->AddMagicanEnemy(enemy);
  AVIRMASTER->AddEnemy(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}
