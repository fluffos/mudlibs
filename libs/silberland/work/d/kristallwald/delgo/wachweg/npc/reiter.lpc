inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Reiter");
  SetProp(P_LONG,
    "Diese gut ausgebildeten Soeldner ueberwachen die Strassen im Tal. "
    "Um ihrer Aufgabe gerecht zu werden und solche lange Strecken "
    "kontrollieren zu koennen, haben sie gelernt auf dem Pferd zu kaempfen."
    "Doch auch ohne ihr Reittier sind sie gute Gegner.");
  SetProp(P_NAME, "Reiter");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"reiter", "soeldner", "schwertexperte"}));
  create_default_npc(20);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 79000);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 5);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 20);
  SetProp(P_NOMAGIC, 5);

  SetProp(P_MSGIN, "springt von seinem Pferd");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "springt von seinem Pferd");
  SetProp(P_MMSGOUT, "springt in Deckung");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Soeldner");

  AddDetail( ({"haare","frisur"}),
    "Die Haare sind militaerisch kurz geschnitten. Die Haarfarbe ist braun.");

  AddDetail( ({"ohren","ohr"}),
    "Er lauscht nebenbei mit seinen Ohren in alle Richtungen.");
  
  AddDetail( ({"nase"}),
    "Dir faellt an der Nase nichts auf.");
    
  AddDetail( ({"gesicht"}),
    "Das Gesicht hat schon einiges miterlebt.");
        
  AddDetail( ({"augen","auge", "pupillen"}),
    "Die Augen ueberwachen aufmerksam die Umgebung.");
    
  AddDetail( ({"haut"}),
    "Die Haut ist braungebrannt, er hat scheinbar viel Dienst draussen.");
    
  AddDetail( ({"lippen", "mund", "lippe"}),
    "Der Mann murmelt leise vor sich hin.");
    
  AddDetail( ({"koerper"}),
    "Der Mann haelt sich fit, wie Du an dem durchtrainierten Koerper siehst.");
    
  AddDetail( ({"kleidung"}),
    "Die Unterkleidung waermt den Mann, bei seinem Dienst.");
    
  AddInfo(DEFAULT_INFO, 
    ({"weiss leider keine Antwort.\n",
      "kann Dir da nicht weiterhelfen.\n" }) );
  AddInfo("delgo", "Er ist bei uns bekannt.","sagt: ");
  
  AddInfo( ({"waffe","waffen"}) , "Ich habe den Umgang mit Waffen recht gut "
     "erlernt."
    ,"sagt: ");
    
  AddInfo( ({"ausbildung","vergangenheit"}) ,"Das war hart, aber ich moechte "
     "nicht darueber reden.."
    ,"sagt: ");
    
  AddInfo( ({"auftrag","aufgabe"}) , "Das wechselt taeglich."
    ,"sagt: ");
    
  AddInfo( ({"arbeit","leben"}) , "Sicher gibt es sichere Arbeit aber naja, "
     "was soll man machen?"
    ,"sagt: ");
    
  AddInfo( ({"tod","sterben"}) ,"Wenn es sein muss."
    ,"sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Reiter brauch Dein Geruempel nicht.\n" }) );
  SetChats(3,
  ({Name()+" grummelt: Wo ist mein Pferd?\n" }) );
  SetAttackChats(10,
  ({Name()+" bruellt: Rache fuer mein Pferd!\n"}));
  SUID;
  CLONEME( "/p/weapon/sword/krummsaebel" );
  command("zuecke saebel");
  CLONEME( "/p/armour/armour/messingruestung" );
  CLONEME( "/p/armour/boots/kampfstiefel" );
  CLONEME( "/p/armour/trousers/bronzebeinschienen" );
  command("trage alles");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;
  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "lacht Dich aus.",
        "lacht @WEN aus.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "brummt: Verschwinde!",
        "brummt: Verschwinde!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "schuettelt nur den Kopf.",
        "schuettelt nur den Kopf.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "lacht Dich nur aus.",
        "lacht @WEN nur aus.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "grummelt: Lenk mich nicht ab!",
        "grummelt: Lenk mich nicht ab @WER!");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Geh woanders spielen und lass die Erwachsenen arbeiten.",
        "sagt zu @WEM: Geh woanders spielen und lass die Erwachsenen "
        "arbeiten.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "lacht ueber Dich.",
        "lacht ueber @WEN.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

void angriff(object pl)
{
  string shouter;
  if(!ENV(TO))           return;
  if(!ENV(pl))           return;
  if(!interactive(pl))   return;
  if(ENV(TO) != ENV(pl)) return;
  Kill(pl);
  return;
}

void init()
{
  ::init();
  if(!TP)                        return;
  if(!interactive(TP))           return;
  if(TP->QueryProp(P_GHOST))     return;
  if(!WACHMASTER->IsEnemy(TP))   return;
  call_out("angriff", 0, TP);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  WACHMASTER->AddEnemy(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

void reset()
{
  ME->deep_remove(1);
  //Der Reiter wird ja nicht wie bei AddItem REFRESH_DESTRUCTed*/
  ::reset();
}
