inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"


void create() {
  if (!is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Ein Pferd");
  SetProp(P_LONG,
    "Auf dem kraftvollen Pferd sitzt ein bewaffneter Reiter. Er hat einen "
    "Krummsaebel gezueckt und schaut Dich missmutig an. Scheinbar "
    "kontrollieren die Soeldner sogar diese Strasse.");

  AddDetail( ({"gesicht", "augen"}),
    "Das pferd hat langes Gesicht. Treue Augen scheun Dich an.");
    
  AddDetail( ({"reiter","soeldner"}),
    "So nah kommst Du an das Pferd nicht heran. Der Soeldner reagiert "
    "auch nicht auf deine Fragen. Naja, Service darfst Du hier nicht "
    "erwarten.");
    
  SetProp(P_NAME, "Pferd");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"pferd"}));
  create_default_npc(19);
  SetProp(P_HANDS, ({" mit seinen Hufen"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_SQUEEZE})
                    }));
  SetProp(P_RACE, "Pferd");
  SetProp(P_SIZE, 210);
  SetProp(P_WEIGHT, 89000);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 30);
  SetProp(P_NOMAGIC, 0);

  SetProp(P_MSGIN, "galoppiert heran");
  SetProp(P_MSGOUT, "galoppiert");
  SetProp(P_MMSGIN, "galoppiert herein");
  SetProp(P_MMSGOUT, "springt in den Wald");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Avirisches Recht");

  AddInfo(DEFAULT_INFO, "versteht deine Sprache nicht.\n");
  AddInfo("Delgo", ".","wiehert");


  SetProp( P_REJECT, ({ REJECT_DROP,
    " Das Pferd kann nichts tragen.\n" }) );

  SetProp(P_SPELLRATE, 50);
  
  SetProp(P_MNPC_AREA, ({ ROOM "n_" }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "n_3");
  SetProp(P_MNPC_WAIT, ({ 10, 10, 0 }));
  SetProp(P_MNPC_FLAGS, 
        MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INFIGHT);
  AddSpell(2,1400,
    "Der Reiter trifft Dich mit seinem Saebel aus vollem Gallop.\n",
    "Der Reiter trifft @WEN mit seinem Saebel aus vollem Gallop.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,900,
    "Das Pferd rammt Dich und trampelt ueber Dich hinweg!\n",
    "Das Pferd rammt @WEN und trampelt ueber @WEN hinweg.\n",
    DT_SQUEEZE, "fall", ([SP_SHOW_DAMAGE:1]) );



}

void die(int poisondeath) 
{
  object ob;
  ob=clone_object(NPC "reiter");
  ob->move(ENV(ME), M_TPORT);
  ::die(poisondeath);
}



// Reactions

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;
 {
   call_out("reaction", 0, TP,
        "wiehert.",
        "wiehert.");
 }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
void angriff(object pl)
{
  string shouter;

  if(!ENV(TO))           return;
  if(!ENV(pl))           return;
  if(!interactive(pl))   return;
  if(ENV(TO) != ENV(pl)) return;
  Kill(pl);
  return;
}

void init()
{
  int i;
  
  ::init();
  i=WACHMASTER->IsSpeedmode();
  if(i=1) {SetProp(P_MNPC_WAIT, ({ 1, 1, 0 }));}
  if(i=0) {SetProp(P_MNPC_WAIT, ({ 10, 10, 0 }));}
  if(!TP)                        return;
  if(!interactive(TP))           return;
  if(TP->QueryProp(P_GHOST))     return;
  if(!WACHMASTER->IsEnemy(TP))   return;
  call_out("angriff", 0, TP);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  SetProp(P_MNPC_WAIT, ({ 1, 1, 0 }));
  WACHMASTER->AddEnemy(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

void reset()
{
  SetProp(P_MNPC_WAIT, ({ 10, 10, 0 }));
  ::reset();
}

void fall(object enemy, int damage, mixed dam_type) 
{
  enemy->SetProp(P_PARALYZED, ([PARALYZE_TIME: 1+random(3), 
							PARALYZE_MSG: "Du faellst hin!\n", 
							PARALYZE_MSG_OTHER: "%s faellt hin.\n", 
							PARALYZE_END: "Du rappelst Dich wieder auf!\n",
							PARALYZE_END_OTHER: "%s rappelt sich wieder auf.\n"]));
	return;
}