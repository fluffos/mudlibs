inherit "std/npc";
inherit "std/player/soul";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Fathania die oberste Metallmagierin");
  SetProp(P_LONG,
    "Du kannst nicht wirklich glauben, dass diese junge Frau zu der Gilde "
    "der gefuerchteten Metallmagier gehoert. So unfassbarer scheint Dir der "
    "Gedanke sie koennte hier die oberste der Magier sein, doch ihre Robe "
    "weist sie eindeutig als solche aus. Du solltest ihr huebsches "
    "Aeusseres nicht unterschaetzen. Die Macht die sie besitzt muss "
    "gigantisch sein.");
  SetProp(P_NAME, "Fathania");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-30,T_RANGE_MAX:60]));
  AddId(({"metallmagierin", "magierin", "magae", "fathania"}));
  create_default_npc(35, 1600);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 168);
  SetProp(P_WEIGHT, 60000);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 5);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0); 
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,  29); //grosser Schutz durch den Mantel, den sie mit 
                           //astralenergie durchfluten
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_SLASH: 0.5]) );
          
  SetProp(P_MSGIN, "wandelt herein");
  SetProp(P_MSGOUT, "wandelt");
  SetProp(P_MMSGIN, "wandlet herein");
  SetProp(P_MMSGOUT, "sagt: Ich muss weg.");

  SetProp(P_DIE_MSG,  " zerfaellt zu Eisenspaenen, die vom Wind verweht "
    "werden.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_NAME, "Die groesste Macht der eisernen Gilde");

  AddDetail( ({"haare","frisur"}),
    "Die rotblonden Haare sind gut gepflegt und reichen bis zur Schulter.");

  AddDetail( ({"ohren","ohr"}),
    "Die Ohren sind durch die Haare verdeckt.");
  
  AddDetail( ({"nase"}),
    "Die kleine Nase sitzt mitten im Gesicht.");
    
  AddDetail( ({"gesicht"}),
    "Es ist recht huebsch anzusehen. Hoffentlich bleibt das auch so.");
        
  AddDetail( ({"augen","auge", "pupillen"}),
    "Die Augen sind stahlgrau und schauen Dich herausfordernd an.");
    
  AddDetail( ({"haut"}),
    "Die Haut ist etwas bleich und gut gepflegt.");
    
  AddDetail( ({"lippen", "mund", "lippe"}),
    "Die Lippen sind schwarz geschminkt.");
    
  AddDetail( ({"koerper"}),
    "An dem Koerper ist nichts auszusetzen, die Frau scheint Sport zu "
    "machen.");
    
  AddDetail( ({"kleidung"}),
    "Dir faellt da nichts auf.");
  
  AddInfo(DEFAULT_INFO, 
    ({"hat Dich gar nicht gehoert.\n",
      "zuckt unwissend mit den Schultern.\n" }) );
  AddInfo("delgo", "Den Namen habe ich schonmal gehoert.","sagt: ");
  
  AddInfo( ({"arbeit"}) , "Ich bewache zusammen mit den anderen Magiern "
     "den Wachweg."
    ,"sagt: ");
    
  AddInfo( ({"leben","alter"}) ,"Das geht dich nichts an ;-)"
    ,"kichert: ");
    
  AddInfo( ({"umgebung","stadt"}) , "Es ist meine Arbeit, mehr nicht." 
    ,"sagt: ");
    
  AddInfo( ({"gebiet","hilfe"}) , "Du stehst auf dem Wachweg."
    ,"sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    " brauch dein Geruempel nicht.\n" }) );

  SetProp(P_SPELLRATE, 100);
  AddSpell(2,1,
    "Fathania konzentriert sich auf deinen Oberkoerper...\n",
    "Fathania konzentriert sich.\n",
     DT_BLUDGEON, "wurf" ,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,1,
    "",
    "",
     DT_BLUDGEON, "fessel" ,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,1,
    "",
    "",
     DT_BLUDGEON, "wand" ,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,1,
    "",
    "",
     DT_BLUDGEON, "weapon" ,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,1,
    "",
    "",
     DT_BLUDGEON, "armour" ,([SP_SHOW_DAMAGE:1]));
     
  add_soul_commands();

  SetAttackChats(10, ({
    "Fathania konzentriert sich auf den Kampf.\n"}) );

  SUID;
  CLONEME(WEAPON "katana" );
  //nur als belohnung dabei, mit gezuecktem katana kanns net zaubern
  CLONEME(ARMOUR "mantel" );
  command("trage alles");
}

void armour(object enemy)
{
  object *armour;
  object armour_npc;
 
  if(!enemy) return;
  if(!(armour=enemy->QueryArmours(AT_ARMOUR))) return;
  if(!objectp(armour[0])) return;
  if(armour[0]->QueryProp(P_CURSED)) return;
  if(armour[0]->QueryProp(P_NODROP)) return;
  armour_npc=clone_object(NPC "armour_npc");
  armour_npc->customize(armour[0]);
  if(!armour_npc) return;
  armour_npc->move(ENV(TO),M_GO|M_SILENT);
  armour[0]->move(armour_npc, M_NOCHECK|M_SILENT);
  enemy->Message(BS("Fathania haucht Deiner Ruestung Leben ein.")
    , MSGFLAG_VISUAL);
  enemy->Message(BS("Fathania macht irgendetwas mit der Ruestung von "
    +enemy->QueryProp(P_NAME)+". Die Ruestung wird lebendig und greift an.")
    , MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({enemy})]));
  armour_npc->Kill(enemy);
  return; 
}

void weapon(object enemy)
{
  object weapon, weapon_npc;
  
  if(!enemy) return;
  if(!(weapon=enemy->QueryProp(P_WEAPON))) return;
  if(!objectp(weapon)) return;
  if(weapon->QueryProp(P_CURSED)) return;
  if(weapon->QueryProp(P_NODROP)) return;
  weapon_npc=clone_object(NPC "weapon_npc");
  weapon_npc->customize(weapon);
  if(!weapon_npc) return;
  weapon_npc->move(ENV(TO),M_GO|M_SILENT);
  weapon->move(weapon_npc, M_NOCHECK|M_SILENT);
  enemy->Message(BS("Fathania haucht Deiner Waffe Leben ein.")
    , MSGFLAG_VISUAL);
  enemy->Message(BS("Fathania macht irgendetwas mit der Waffe von "
    +enemy->QueryProp(P_NAME)+". Die Waffe wird lebendig und greift an.")
    , MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({enemy})]));
  weapon_npc->Kill(enemy);
  return;
}

void wand(object enemy)
{
  object wand, ob;
  
  wand=present("\nbarriere", ENV(TO));
  if(wand) return;
  ob=clone_object(OBJ "barriere");
  ob->move(file_name(ENV(TO)), M_SILENT | M_NOCHECK);
  ENV(TO)->Message(BS("Fathania errichtet eine Wand aus Metal.")
    , MSGFLAG_VISUAL);
  return;
}

void fessel(object enemy)
{
  object ob, blei;
  
  blei=present("\nblei", enemy);
  if(!enemy) return;
  if(blei) return;
  if(!(enemy->QueryProp(P_GUILD)== "berserker")) return;
  enemy->Message(BS("Fathania spricht einen zauber und Bleifesseln legen "
  "sich um deine Handgelenke."), MSGFLAG_SENSE);
  ENV(TO)->Message(BS("Fathania spricht einen Zauber auf  "
  ""+enemy->name(WEN, 2)+" und Bleifesseln legen sich um die Handgelenke "
  "von "+enemy->name(WEM, 2)+"!")
  , MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({enemy})]));
  ob=clone_object(OBJ "blei");
  ob->move(enemy, M_NOCHECK | M_GET | M_SILENT);
  ob->spell();
  return;  
}

void wurf(object enemy)
{
  object *armour;
  object ob, eisen;

  eisen=present("\neisen", enemy);
  if(!enemy) return;
  if(!eisen)
  {
    armour=enemy->QueryArmours(AT_ARMOUR);
    if(!sizeof(armour))
    {
      call_out("eisenring",0, enemy);
      return;
    }
    if(!(armour[0]->QueryMaterialGroup(MATGROUP_METAL)))
    {
      call_out("eisenring",0, enemy);
      return;
    }
  }
  enemy->SetProp(P_DISABLE_ATTACK, 1);
  enemy->SetProp(P_DISABLE_SPELLS, 1);
  TO->SetProp(P_DISABLE_ATTACK, 1);
  TO->SetProp(P_DISABLE_SPELLS, 3);
  enemy->SetProp(P_TMP_MOVE_HOOK, ({ time()+4, TO,"hold"}) );
  ENV(TO)->Message( BS("Fathania laechelt kurz kalt, als die Ruestung von "
    ""+enemy->name(WEM, 2)+" kurz aufleuchtet und "
    +enemy->name(WER, 2)+" einige Meter nach oeben schwebt und "
    "hilflos herumzappelt.\n")
    , MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({enemy}) ]) );
  enemy->Message(BS("Auf einmal faengst Du an nach oben zu schweben. Hilflos"
    " zappelst Du in der Luft herum waerend Dich Fathania angrinst.\n")
    , MSGFLAG_VISUAL);
  call_out("komet", 4, enemy);
  return;
}
void komet(object enemy)
{
  int hp, dam;
  
  hp=enemy->QueryProp(P_HP);
  dam=(55)+random(25);
  ENV(TO)->Message(BS("Fathania reisst ihre Haende blitzartig nach unten "
    "und "+enemy->name(WER, 2)+" rast auf den Boden zu um dort zu "
    "zerschellen!\n"), MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({enemy}) ]) );
  enemy->Message("Fathania macht eine Handbewegung Du und faellst "
  "extrem schnell zurueck auf den Boden.\n Du zerschellst auf dem Boden.\n"
    , MSGFLAG_VISUAL);
  if(hp < dam) enemy->SetProp(P_TMP_MOVE_HOOK, ({ 0, TO,"hold"}) );
  enemy->do_damage(dam);
  return;
}
string hold()
{ 
  return "Die Macht Fathanias haelt Dich noch fest!\n"; 
}

void eisenring(object enemy)
{
  object ob, eisen;
  
  eisen=present("\neisen", enemy);
  if(eisen) {return;}
  
  command_me("sag Dass Du keine Metallrestung traegst, nuetzt Dir auch "
             "nichts "+enemy->name(RAW)+"!\n");
  enemy->Message(BS("Fathania murmelt eine kurze Formel und ein "
    "Sklavenring aus Eisen legt sich um deinen Hals!\n"), MSGFLAG_VISUAL);
  ob=clone_object(OBJ "eisen");
  ob->move(enemy, M_GET | M_SILENT);
  ob->spell();
  return;
  
}
void die(int poisondeath) 
{
  object wand;
  object ob;
  if(objectp(ob=present("\nbarden_hero_killquest", QueryProp(P_KILLER)))) {
    ob->Mark();
  }
  
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" "
    "killt Fathania.\n");
  WACHMASTER->Msg(TPN+" hat gerade Fathania besiegt", 2);
  wand=present("\nbarriere", ENV(TO));
  if(wand)
  {
    wand->remove(); 
  }
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Fathania hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}



//____________________________ Reactions _________________________________//

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;
  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "ignoriert Dich.",
        "ignoriert Feinde.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "brummt: Verschwinde!",
        "brummt: Verschwinde!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "schuettelt nur den Kopf.",
        "schuettelt nur den Kopf.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "lacht Dich nur aus.",
        "lacht.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "grummelt: Lenk mich nicht ab!",
        "grummelt: Lenk mich nicht ab!");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "laechelt kurz.",
        "laechelt kurz.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "faucht: Besieg mich im Kampf und dann nimm die Leiche, aber lebend "
        "faesst Du mich nicht an!\n",
        "faucht: Besieg mich im Kampf und dann nimm die Leiche, aber lebend "
        "faesst Du mich nicht an!\n");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "laechelt kurz.",
        "laechelt kurz.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "laechelt kurz.",
        "laechelt kurz.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "lacht ueber Dich.",
        "lacht.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
void angriff(object pl)
{
  if(!ENV(TO))           return;
  if(!ENV(pl))           return;
  if(!interactive(pl))   return;
  if(ENV(TO) != ENV(pl)) return;
  Kill(pl);
  return;
}

void init()
{
  ::init();
  if(!TP)                               return;
  if(!interactive(TP))                  return;
  if(TP->QueryProp(P_GHOST))            return;
  if(!WACHMASTER->IsMagicanEnemy(TP))   return;
  call_out("angriff", 0, TP);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  WACHMASTER->AddMagicanEnemy(enemy);
  AVIRMASTER->AddEnemy(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}
