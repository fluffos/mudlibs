#include "../def.h"
#include "/gilden/waldlaeufer/ranger_tasks.h"
#include <npcmaster.h>
inherit "std/npc";
inherit "/std/npc/spells";

object ranger;

string *baerMsg = ({
  "Der Schwarzbaer faengt einen Angriff ab.",
  "Der Schwarzbaer schlaegt ein Eiselementar sehr hart.",
  "Der Schwarzbaer rammt ein Eiselementar mit der Schulter.",
  "Der Schwarzbaer bruellt das Eiselementar an.\nDer Schwarzbaer trifft ein Eiselementar extrem laut.",
  "Der Schwarzbaer trifft ein Eiselementar leicht.",
  "Der Schwarzbaer schlaegt ein Eiselementar.",
  "Der Schwarzbaer verfehlt ein Eiselementar."
});

string *horkMsg = ({
  "Hork weicht aus.",
  "Hork verfehlt ein Eiselementar.",
  "Hork sticht ein Eiselementar leicht.",
  "Hork zielt rasch mit seiner Armbrust und schiesst.\nHork massakriert ein Eiselementar mit einem gewaltigen Stich.",
  "Hork sticht ein Eiselementar hart",
  "Hork sticht ein Eiselementar.",
  "Hork duckt sich unter einem Angriff weg.\nEin Eiselementar verfehlt Hork.",
  "Hork trifft ein Eiselementar.\nHork verpasst dem Eiselementar einen kraeftigen Fusstritt.\nHork zerquetscht ein Eiselementar."
});

string *elementalMsg = ({
  "Ein Eiselementar zerschmettert Hork mit eisiger Kaelte.",
  "Ein Eiselementar trifft einen Schwarzbaeren hart.",
  "Ein Eiselementar trifft einen Schwarzbaeren unglaublich hart.",
  "Ein Eiselementar trifft einen Schwarzbaeren aussergewoehnlich hart.",
  "Ein Eiselementar trifft Hork unglaublich hart.",
  "Ein Eiselementar trifft Hork.",
  "Ein Eiselementar trifft Hork sehr hart.",
  "Ein Eiselementar trifft einen Schwarzbaeren extrem hart.",
  "Ein Eiselementar pulverisiert einen Schwarzbaeren mit eisiger Kaelte.",
});

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein gigantisches Eiselementar");
  SetProp(P_LONG,
    "Vor dir erhebt sich eine gigantische Gestalt aus Eis, die der Druide Sarl auf "
    "dich gehetzt hat.");

  SetProp(P_NAME, "Eiselementar");
  SetProp(P_GENDER, NEUTER);
  AddId(({"elementar", "eiselementar"}));
  SetProp(P_ARTICLE, 1);
  create_default_npc(40);
  SetProp(P_HANDS, ({" mit seinen kalten Faeusten",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON, DT_COLD})
                    }) ); // eh egal
  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 400);
  SetProp(P_WEIGHT, 450000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 50);
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will lieber kaempfen." }) );
  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_DIE_MSG,  " schmilzt davon.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_NO_SCORE, 1);

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.");
  AddInfo("sarl", "Sarl hat mich beschworen.","sagt: ");

  SUID;

}

public void SetRanger(object ob) {
  ranger = ob;
}

public void Attack(object enemy) {
  
  if(enemy == ranger && enemy->QueryProp(P_HP) > 20 && !random(5)) {
    enemy->Defend(100+random(100), DT_COLD, ([SP_SHOW_DAMAGE:1]), TO);
  } else {
    tell_room(ENV(TO), break_string(elementalMsg[random(sizeof(elementalMsg))], 78, 2, BS_LEAVE_MY_LFS));
  }

  tell_room(ENV(TO), break_string(horkMsg[random(sizeof(horkMsg))], 78, 2, BS_LEAVE_MY_LFS));
  tell_room(ENV(TO), break_string(baerMsg[random(sizeof(baerMsg))], 78, 2, BS_LEAVE_MY_LFS));

  if(enemy != ranger) ::Attack(enemy); // alles nur eine simulation
  return;
}

public int Defend(int dam, string *dam_type_list, mixed spell, object enemy) {
  if(enemy == ranger) {
    dam *= 2;
  }

  return ::Defend(dam, dam_type_list, spell, enemy);
}

public void die(int pd) {
  ENV(TO)->EndSequence(ranger);
  ::die(pd);
  return;
}
