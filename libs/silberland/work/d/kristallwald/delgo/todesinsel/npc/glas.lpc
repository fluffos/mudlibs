inherit "std/npc";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>


void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein glaesernes Skelett");
  SetProp(P_LONG,
    "Ein Skelett komplett aus Glas. Du fragst Dich woher es wohl kommt. "
    "Es scheint im Gegensatz zu den anderen Skelette die Du kennst "
    "auch in keinster Weise aggressiv. Sehr seltsam.");

  SetProp(P_NAME, "Glasskelett");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:100]));
  SetProp(P_ARTICLE, 1);
  AddId(({"skelett", "glasskelett", "\nglas_skelett", "NOWIMPY", "NODESTRUCT", 
          "NOCONTROL"}));
  create_default_npc(15); 
  SetProp(P_HANDS, ({" mit glaesernen Haenden",QueryProp(P_HANDS)[1],DT_RIP}));
  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 10400);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 100);
  SetProp(P_NOATTACK, "laesst sich nicht angreifen.");

  SetProp(P_MSGIN, "klappert herein");
  SetProp(P_MSGOUT, "klappert");
  SetProp(P_MMSGIN, "klappert herein");
  SetProp(P_MMSGOUT, "klappert");

  SetProp(P_DIE_MSG,  " faellt zusammen und zerbricht.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_NAME, "Ein Skelett aus Glas");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("delgo", "M-m-m-ma-ma--magier!","klappert: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Skelett kann Deine Sachen nicht tragen.\n" }) );

  SUID;

}


// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
 if(find_call_out("reaction") != -1) return;
 {
   call_out("reaction", 0, TP,
        "klappert vor sich hin.",
        "klappert.");
 }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
void reset()
{
  if(ENV(TO))
  {
    ENV(TO)->Message(BS("Das Skelett zerfaellt auf einmal und zerbricht.\n")
                    , MSGFLAG_VISUAL);
  }
  TO->remove();
  return; 
}
