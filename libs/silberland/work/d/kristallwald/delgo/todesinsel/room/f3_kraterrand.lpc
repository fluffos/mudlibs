#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  ::create();
  
   SetProp(P_INT_SHORT, "Beim oestlichen Monolithen");
   SetProp(P_INT_LONG,
     "Vor Dir ragt ein verdrehter Monolith in die Hoehe, aehnlich einem "
     "duerren Finger einer verkrampften Hand. Er biegt sich Richtung Westen, "
     "wo er mit anderen Monolithen eine Art Kuppel ueber den Krater bildet. "
     "Wenn Du nach Westen schaust, siehst Du in das Innere des Kraters hinein. "
     "Die Hoehlendecke hier ueber Dir kommt einem noch duesterer vor als "
     "sonstwo. Du fuehlst ein Pulsieren in Dir, so als wuerde Dich eine "
     "unendliche Macht durchstroemen.");
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 35, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"hoehlendecke"}),
     "Dunkel und verhangen ist die Decke ueber Dir und auch kein bisschen "
     "naeher als vorher.");

   AddDetail( ({"boden"}),
     "Der besteht wie ueberall hier aus diesem seltsamen schwarzen Gestein.");

   AddDetail( ({"gestein", "steine"}),
     "Dunkelschwarz. Du hast noch nie ein aehnliches Gestein gesehen. Es sieht "
     "extrem hart und wiederstandsfaehig aus.");

   AddDetail( ({"rand"}),
     "Wie mit einem Zirkel gezogen, zieht er sich rund um das ganze Plateau.");

   AddDetail( ({"zirkel"}),
     "Ein mathematisches Instrument.");

   AddDetail( ({"instrument"}),
     "Mit ihm kann man Kreise zeichnen.");

   AddDetail( ({"kreise","kreis"}),
     "Man sieht aber immer nur den Rand.");

   AddDetail( ({"plateau"}),
     "Du denkst Dir . o O (Hier siehts doch ueberall gleich aus.)\n\n"
     "Aber als Du genauer hinsiehst, bemerkst Du einen Weg der oestlich von "
     "hier nach unten wegfuehrt.");

   AddDetail( ({"weg"}),
     "Also eigentlich ist es ein, im Vergleich zu den Klippen, nicht so "
     "steiler Abhang mit Geroell zu einer kleineren Klippe unter Dir. Du "
     "kannst ja versuchen dort mal runter zu gehen.");

   AddDetail( ({"klippe", "klippen"}),
     "Hui, da gehts ja wirklich steil runter. An Deiner Stelle wuerde ich da "
     "nicht zu nahe zum Rand gehen.");

   AddDetail( ({"stelle"}),
     "Da ich nicht an Deiner Stelle bin, musst Du das schon selbst wissen.");

   AddDetail( ({"abhang"}),
     "Na, der Weg.");

   AddDetail( ({"geroell"}),
     "Lose Steine.");

   AddDetail( ({"finger","hand"}),
     "Nur ein bildlicher Vergleich. Du hast doch sicher noch nirgends eine "
     "Hand mit acht Fingern gesehen oder?");

   AddDetail( ({"vergleich"}),
     "Wenn Du etwas vergleichen willst, geh zum einem Waffenexperten.");

   AddDetail( ({"waffenexperte"}),
     "Gibts hier nicht.");

   AddDetail( ({"art","kuppel"}),
     "Naja, keine wirklich Kuppel, nur die Andeutung einer solchen.");

   AddDetail( ({"andeutung"}),
     "Willst Du hier irgendwas andeuten?");

   AddDetail( ({"monolith"}),
     "Verdreht und verwittert, dennoch ungebeugt ragt dieser Monolith Richtung "
     "Decke. Auf einer Seite ist eine Rune in den Stein eingelassen.");

   AddDetail( ({"decke"}),
     "Immer noch da oben, egal wie oft Du es auch untersuchst.");

   AddDetail( ({"hoehe"}),
     "Ist immer oben.");

   AddDetail( ({"richtung","richtungen","norden", "westen"}),
     "Ueber Richtungen haben sich schon zu viele ausgelassen, darum hier keine "
     "Diskussion mehr darueber.");

   AddDetail( ({"diskussion"}),
     "Nein.");

   AddDetail( ({"seite"}),
     "Die Seite, die Dir zugewandt ist, traegt die Rune.");

   AddDetail( ({"rune"}),
     "Die Rune stellt ein Dreieck dar. Dein Gefuehl sagt Dir sie koennte fuer "
     "Feuer stehen."),
 
   AddDetail( ({"dreieck"}),
     "Das Symbol wurde hier seltsam verunstaltet. Du siehst noch einmal genauer"
     " hin und bemerkst ploetzlich das der Boden und der Monolith leicht "
     "gluehen. Ein Wunder das Du dich noch nicht verbrannt hast. Die sengende "
     "Hitze macht Dir auf jeden Fall schwer zu schaffen.");

   AddDetail( ({"wunder"}),
     "Wunder gibt es immer wieder ... Ups, tja JETZT hats Dich auch erwischt.");

   AddDetail( ({"hitze","fall"}),
     "Dir rinnt schon der Schweiss aus allen Poren.");

   AddDetail( ({"schweiss"}),
     "Riech doch mal.");

   AddDetail( ({"poren"}),
     "Die 'Luftloecher' der Haut.");

   AddDetail( ({"luftloch","luftloecher"}),
     "Natuerlich keine wirklichen, aber sie funktionieren genauso. Der Schweiss"
     " kommt uebrigens auch da raus.");

   AddDetail( ({"haut"}),
     "Das haut Dich um ... was? :-)");

   AddDetail( ({"gefuehl"}),
     "Du bist Dir nun sehr sicher dass das hier so eine Art negativen "
     "Druidenzirkel darstellen soll."),

   AddDetail( ({"druidenzirkel"}),
     "Anvar steht dort herum und erzaehlt jedem von den Elementen.");

   AddDetail( ({"elemente","anvar"}),
     "Geh zu ihm und lass sie Dir von ihm erklaeren.");

   AddDetail( ({"symbol","feuer"}),
     "Das Dreieck.");

   AddDetail( ({"pulsieren","macht","kraft"}),
     "Du spuerst foermlich wie Dein Koerper unter dem Ansturm dieser Kraft "
     "zittert.");

   AddDetail( ({"koerper"}),
     "Er erbebt foermlich.");

   AddDetail( ({"ansturm"}),
     "Du kannst Dich kaum noch aufrecht halten.");

   AddDetail( ({"krater"}),
     "Du befindest Dich auf einem schmalen Weg der rund um den Krater an "
     "dessen Rand herumfuehrt.");

   AddDetail( ({"innere","inneren", "inneres"}),
     "Du siehst einen aktiven Lavasee im Inneren des Kraters. Hin und wieder "
     "werden auf unerklaerliche Weise Lavastroeme an den Waenden hochgedrueckt "
     "und fliessen anscheinend durch die Kraterwaende. "
     "Beug Dich nicht zu weit nach unten, sonst faellst Du noch runter.");

   AddDetail( ({"lavasee","see","lavastroeme","lava"}),
     "Die ist sicher verdammt heiss.");

   AddDetail( ({"weise"}),
     "Unerklaerlich. Nicht mal mir ist etwas eingefallen ;) ");

   AddDetail( ({"kraterwaende","waende"}),
     "Das sind die Waende des Kraters, oder hast Du etwas anderes erwartet?");

//Geraeusche:
   AddSound(DEFAULT_SOUND,
     "Neben dem Knistern der Blitze und dem hier staerker werdenden dumpfen "
     "Klopfen kannst Du aus Richtung des Monolithen staendig leise Stimmen, "
     "die mal drohender mal flehender werden wahrnehmen.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander reiben "
     "wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","pulsieren","leuchten"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"klopfen"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren des Leuchtens im Berg zu"
     " hoeren. Es duerfte irgendwo hier oben seinen Ursprung haben.");

   AddSound( ({"berg"}),
     "Auch wenn Du es nicht wahrhaben willst, der Berg scheint dich noch immer "
     "in anzuziehen.");

   AddSound( ({"richtung"}),
     "Richtungen kann man doch nicht hoeren.");

   AddSound( ({"monolith"}),
     "Er vibriert leise.");

   AddSound( ({"stimmen","sprache"}),
     "Die Stimmen sprechen in einer Dir unbekannten Sprache, daher verstehst "
     "Du auch nicht was sie sagen.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Eigentlich kannst Du hier gar nichts riechen ausser angesengtem "
     "Nasenhaar und Deinem Schweiss, denn die Luft hat sich hier ziemlich "
     "erwaermt.");

   AddSmell( ({"luft"}),
     "Riecht nach leicht angesengten Nasenhaaren und Schweiss.");

   AddSmell( ({"nasenhaar","nasenhaaren","schweiss"}),
     "Buah riecht das grauslich.");
     
   AddDetail( ({"hier", "jetzt", "monotlithen", "o", "stein", "ursprung", 
                "wand"}),
     "Forsche weniger!");

//Die Exits:

   AddExit("norden", ROOM "f2_kraterrand");
   AddExit("sueden", ROOM "f4_kraterrand");
   AddExit("ostunten", ROOM "g3_geroellhang");
   
   SetProp(P_HIDE_EXITS, ({"osten"}) );
   AddExit("osten", ROOM "g3_geroellhang");
}