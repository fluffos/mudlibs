#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  
  object ob;
  
  ::create();
  
   SetProp(P_INT_SHORT, "An einem Steg");
   SetProp(P_INT_LONG,
     "Du stehst hier auf dem Steg, auf dem Dich der Faehrmann abgesetzt hat. "
     "Die ganze Gegend wirkt nicht sehr vertrauenserweckend auf Dich, "
     "angefangen von den Wellen, die gefaehrlich hoch an den Steg prallen, bis "
     "hin zu dem unheimlichen, kommenden und verschwindenden Leuchten, welches "
     "den Berg im Sueden nur noch bedrohender erscheinen laesst. Ueber Dir "
     "zucken farbige Blitze durch die Schwaden, und Du meinst einen Weg im "
     "Sueden zu entdeckt zu haben, der steil auf das obere Ende des Berges "
     "zufuehrt.");
   SetProp(P_LIGHT, 1);
   SetProp(P_INDOORS, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

//Detailbaum Steg:
   AddDetail( ({"steg","boden"}),
     "Hier hat man Dich also abgesetzt. Einsam und verlassen stehst Du nun hier"
     " herum, und faengst Dich schoen langsam an zu wundern aus welchem "
     "Material der Steg, der sich solide und fest unter Dir befindet, denn "
     "ueberhaupt besteht, dass er so lange den gefraessigen Wellen des Sees "
     "hat standhalten koennen und noch immer so glatt und beschaedigungslos "
     "sein kann.");

   AddDetail( ({"material"}),
     "Holz kann es keines sein, genausowenig wie Metall, beides wuerde hier "
     "naemlich sofort vom heissen Wasser zerfressen werden. Eigentlich kann "
     "dieses Material nur magischen Ursprungs sein, da Dir sonst keine andere "
     "Erklaerung einfaellt.");

   AddDetail( ({"holz", "metall"}),
     "Aus denen besteht der Steg nun mal nicht, egal wie oft Du den Steg auch "
     "noch untersuchst.");

   AddDetail( ({"wasser","tropfen"}),
     "Aus heissem, stinkenden Wasser besteht die See oder hast Du etwa Milch "
     "erwartet?");

   AddDetail( ({"milch","honig"}),
     "Die warme Milch mit Honig gibts nur daheim bei deiner Mami.");

   AddDetail( ({"mami"}),
     "Bei ihr waerst Du jetzt viel lieber, als an diesem unheimlichen und boese"
     " wirkenden Ort.");

   AddDetail( ({"wellen"}),
     "Die klatschen mit unverminderter Wucht gegen den Steg.");

   AddDetail( ({"wucht"}),
     "RUUUUUUUUMMMMMMMMMMMMSSSSSS. RRRRRRAAAAAAAUUUUUUUUSSSSSSCCCCCCCCHHHHHH.");

   AddDetail( ({"see"}),
     "Ueberall um Dich herum, ausgenommen im Sueden, kannst Du nur Wasser "
     "erkennen, das in heftigen Wellen gegen den Steg klatscht.");

   AddDetail( ({"erklaerung"}),
     "Du findest keine andere.");

   AddDetail( ({"ursprung", "magie"}),
     "Wo die Magie ihren Ursprung hat wissen nur die wohl nur die Goetter.");

   AddDetail( ({"goetter"}),
     "Das waeren dann also Woody und Dusty, aber ob die in DIESER Gegend einen"
     " magischen Einfluss haben, ist doch sehr zu bezweifeln."); 

   AddDetail( ({"woody","dusty"}), "Goetter.");
   
   AddDetail( ({"einfluss"}),
     "Hier scheinen nicht die Goetter, sondern irgendeine andere Macht die "
     "Kontrolle uebernommen zu haben.");

   AddDetail( ({"macht", "kontrolle"}),
     "Das musst Du schon selbst herausfinden wer das ist.");

//Detailbaum Faehrmann:
   //entnommen fuer Faehre

//Detailbaum Gegend:
   AddDetail( ({"gegend", "ort"}),
     "Eine, von Wellen umtoste, Insel mit einem unheimlich leuchtenden Berg "
     "mitten in einem See.");

   AddDetail( ({"insel"}),
     "Naja wie soll man diese Insel am besten beschreiben: Umgeben von heissem "
     "Wasser, einsam und verlassen, und ohne Ausweg, stehst Du nun am Fusse "
     "eines hohen Berges der irgendwie Aehnlichkeit mit einem Vulkan hat.");

   AddDetail( ({"fusse"}),
     "Der Berg hat einen, Du hast zwei davon.");

   AddDetail( ({"ausweg"}),
     "Zumindest so lange nicht, bis der Faehrmann mit seinem unheimlichen Boot "
     "wieder da ist.");

   AddDetail( ({"aehnlichkeit","vulkan","ueberreste"}),
     "Nun ja, vielleicht war das hier frueher wirklich ein unterirdischer "
     "Vulkan, denn das wuerde vielleicht auch das rote Leuchten, wie von "
     "geschmolzenem Gestein, erklaeren.");

   AddDetail( ({"geschmolzenes gestein"}),
     "Lava oder auch Magma genannt.");

   AddDetail( ({"lava","magma"}),
     "Geschmolzenes Gestein.");

   AddDetail( ({"sueden"}),
     "Die einzige Hoell... aeh Himmelsrichtung, in die Du weitergehen kannst.");

   AddDetail( ({"himmelsrichtung","richtung"}),
     "Da gibt es vier Haupthimmelsrichtungen und etlich kleine Abstufungen "
     "dazwischen.");

   AddDetail( ({"haupthimmeslrichtung","haupthimmelsrichtungen"}),
     "Norden, Sueden, Osten, Westen.");

   AddDetail( ({"norden","osten","westen","nordosten","nordwesten","suedosten"
               ,"suedwesten"}),
     "Da siehst Du nur den Saeuresee.");

   AddDetail( ({"abstufung","abstufungen"}),
     "Nordwesten, Suedwesten, Suedosten, Nordosten und noch viel kleinere "
     "Abstufungen.");

//Detailbaum Leuchten:
   AddDetail( ({"leuchten","pulsieren"}),
     "Ein pulsierendes rotes Licht wie von einem schlagenden Herzen. Echt "
     "unheimlich.");

   AddDetail( ({"licht"}),
     "Blutrot und doch von einer Kaelte wie sie nur der Tod verbreiten kann.");

   AddDetail( ({"Kaelte"}),
     "Physisch kannst Du sie nicht spueren, aber Dein Gefuehl sagt Dir das es "
     "keine normale Kaelte ist.");

   AddDetail( ({"gefuehl"}),
     "Das kannst Du nicht untersuchen, das hast Du nur.");

   AddDetail( ({"tod"}),
     "Den lernst Du hier sicher noch kennen.");

   AddDetail( ({"herz","herzen"}),
     "Wie auch ein lebendes Organ hat auch dieses hier einen bestimmten "
     "Rhythmus mit dem es schlaegt.");

   AddDetail( ({"organ"}),
     "Das Herz. Oder vergisst Du so schnell um was es hier geht?");

   AddDetail( ({"rhythmus"}),
     "Bumm ... BummBumm ... Bumm ... BummBumm ........");

//Detailbaum Blitze:
   AddDetail( ({"blitz","blitze"}),
     "Wie bei einem Gewitter zucken Blitze in allen Farben durch die Schweden "
     "die da am 'Himmel' ueber Dir haengen. Seltsamerweise gehen sie alle in "
     "die Richtung des Zentrum des Berges.");

   AddDetail( ({"schweden"}),
     "Ist sicher ein Typo, soll Schwaden heissen.");

   AddDetail( ({"typo"}),
     "So nennt man etwas falsch geschriebenes. (siehe: hilfe typo)");

   AddDetail( ({"himmel"}),
     "Nein, SO kannst Du DAS, was sich da ueber Dir zusammenbraut wird, sicher "
     "nicht nennen.");

   AddDetail( ({"gewitter","donner","regen","gewitterwolken"}),
     "Da es hier ja kein Gewitter geben kann, siehst Du hier weder Regen, der "
     "durch seine Tropfen sicher toedlich fuer Dich waere, noch hoerst Du "
     "Donner, wie angestrengt Du auch noch lauschst.");

   AddDetail( ({"farben","farbe"}),
     "In allen moeglichen Farben zucken die Blitze durch die Schwaden, manchmal"
     " wechseln sie sogar mitten im Blitz die Farbe.");

   AddDetail( ({"schwaden"}),
     "Sie sehen aus wie normale Gewitterwolken, nur sie sind es nicht. Wo "
     "sollten die auch herkommen, soweit unter der Erdoberflaeche?");

   AddDetail( ({"erdoberflaeche","oberflaeche","erde"}),
     "Die ist, wie der Begriff schon sagt, oben.");

   AddDetail( ({"begriff"}),
     "Erdoberflaeche: zusammengesetzt aus Erde und Oberflaeche.");

//Detailbaum Weg:
   AddDetail( ({"weg"}),
     "Den siehst Du im Rhythmus des Leuchtens und manchmal auch wenn ein Blitz "
     "blitzt. Er fuehrt nach Sueden immer hoeher hinauf bis auf den hoechsten "
     "Punkt des Berges.");

   AddDetail( ({"punkt","oberes ende","zentrum"}),
     "Im allgemeinen auch Gipfel genannt. Obwohl man hier doch eher von einem "
     "Hochplateau sprechen kann.");

   AddDetail( ({"gipfel"}),
     "Der hoechste Punkt eines Berges.");

   AddDetail( ({"hochplateau"}),
     "Ist hoch oben und flach.");

   AddDetail( ({"berg"}),
     "Normalerweise nennt man so eine Anhaeufung von Gestein, entweder "
     "entstanden durch Verwerfungen in der Erdkruste, oder als Ueberreste "
     "eines ehemals aktiven Vulkans.");

   AddDetail( ({"gestein"}),
     "Hier war es vermutlich ein Vulkan der Lava, oder auch Magma genannt, "
     "gespuckt hat.");

   AddDetail( ({"anhaeufung"}),
     "Berg.");

   AddDetail( ({"verwerfungen","erdkruste","kruste"}),
     "Da das hier nicht zu einer Geologiestunde ausarten soll, schlaegst Du "
     "das bitte selber in einem Lexikon nach.");

   AddDetail( ({"geologiestunde"}),
     "Es ist keine.");

   AddDetail( ({"lexikon"}),
     "Sollte man immer griffbereit haben.");

//Geraeusche:
   AddSound(DEFAULT_SOUND,
     "Neben dem Tosen der Wellen und dem Knistern der Blitze kannst Du auch ein"
     " dumpfes Bumpern wahrnehmen.");

   AddSound( ({"donnern","donner","gewitter","regen"}),
     "Wie gesagt, so sehr Du Dich auch anstrengst, Du hoerst das nicht.");

   AddSound( ({"tosen","wellen"}),
     "Es ist so laut, das man fast nicht einmal ein gesprochenes Wort hoeren "
     "wuerde.");

   AddSound( ({"wort"}),
     "Du hoerst es nicht.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander reiben "
     "wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","pulsieren","leuchten"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"bumpern"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren des Leuchtens im Berg zu"
     " hoeren.");

   AddSound( ({"berg"}),
     "Der Berg scheint dich in irgendeiner Weise anzuziehen.");

   AddSound( ({"weise"}),
     "Eine unheimliche Weise.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Egal in welche Richtung Du auch riechst, es riecht nach stinkendem "
     "Wasser.");

   AddSmell( ({"richtung"}),
     "Die kannst Du nicht riechen, nur untersuchen.");

   AddSmell( ({"wasser"}),
     "Zieh Dir nicht zu viel davon ein, es koennte schaedlich fuer Deine "
     "Gesundheit sein.");

   AddSmell( ({"gesundheit"}),
     "Wer nicht hoert und riecht, muss fuehlen.");
     
   AddDetail( ({"das", "dieser", "decke", "ende", "hoell", "nasenloecher",
                "saeuresee", "schrecken", "sie", "so", "waende", "wand"}), 
     "Du forschst zu gruendlich.");
     
   AddDetail( ({"faehrmann", "boot", "khorinis"}), 
     "Der Faehrmann steuert das Boot. Du kannst von hier aus nach Khorinis "
     "reisen.");


//Die Exits:

   AddExit("sueden", ROOM "e-1_steg");
   AddItem(NPC "druid", REFRESH_DESTRUCT);
   ob=present("\ndruidenzirkel_npc", TO);
   if(ob) ob->customize("untren");
   
   call_other( FAEHRE , "refresh", 0);
}
void refresh()
{
  //leerlauf
}
void reset()
{
  object ob;
  
  ::reset();
  
  ob=present("\ndruidenzirkel_npc", TO);
  if(ob) {ob->customize("untren");}
}