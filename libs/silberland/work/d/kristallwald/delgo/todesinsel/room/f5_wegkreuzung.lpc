#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  ::create();
  
   SetProp(P_INT_SHORT, "Eine Kreuzung");
   SetProp(P_INT_LONG,
     "Du stehst nun auf einem groesseren und flacheren Teil einer Klippe. Von "
     "hier aus gehen vier Wege zu verschiedenen Teilen der Insel. Du kannst "
     "nach Nordwesten durch einen Nischenweg hinauf zu einer oberen Klippe oder"
     " nach Westen gehen, wo Du grosses Getoese hoerst und wo Dir die Sicht, "
     "auf alles was da hinter liegt, vernebelt ist. Natuerlich kannst Du auch "
     "weiter nach Nordosten gehen oder nach Suedosten wieder Richtung See "
     "hinunter. Die Hoehlendecke hier kommt einem ziemlich duester vor. Es ist "
     "sogar ein kleiner, umrankter, Wegweiser hier angebracht worden, der in "
     "die verschiedenen Richtungen zeigt.");
   SetProp(P_LIGHT, 0);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"hoehlendecke","decke"}),
     "Die Hoehlendecke ist soweit oben und so verhangen, dass Du sie gar nicht "
     "siehst.");

   AddDetail( ({"boden"}),
     "Da liegen ueberall Felsen und Steine herum.");

   AddDetail( ({"felsen","steine","gestein","fels"}),
     "Es ist ein nachtschwarzes Material, das entfernt an Basalt oder Obsidian "
     "erinnert.");

   AddDetail( ({"material","materialien","basalt","obsidian"}),
     "Das sieht eben wie Vulkangestein aus.");

   AddDetail( ({"vulkangestein"}),
     "Wird von einem Vulkan ausgespuckt.");

   AddDetail( ({"vulkan"}),
     "Der spuckt Vulkangestein aus.");

   AddDetail( ({"nordwesten","westen","nordosten","suedosten"}),
     "Da kannst Du hingehen.");

   AddDetail( ({"teil","teile"}),
     "Ein Stueck vom Gesamten.");

   AddDetail( ({"stueck"}),
     "Ein Teil des Gesamten.");

   AddDetail( ({"gesamten","gesamtes","gesamt"}),
     "Besteht aus Teilen und Stuecken; DAS hast Du wohl jetzt nicht erwartet, "
     "oder?");

   AddDetail( ({"klippe"}),
     "Hoch ragt sie vor Dir auf, dementsprechend tief duerfte es von dort auch "
     "nach unten gehn.");

   AddDetail( ({"insel"}),
     "Es ist immer noch dieselbe Insel wie vorhin.");

   AddDetail( ({"wege","weg","weges"}),
     "Alle Wege fuehren irgendwohin. Einige fuehren Dich auch ins Verderben.");

   AddDetail( ({"verderben"}),
     "Pass auf das es nicht so weit kommt.");

   AddDetail( ({"nischenweg"}),
     "Das soll heissen, dass man ihn aus dem Fels kuenstlich herausgehauen hat,"
     " da es sonst keine Moeglichkeit gaebe, den Lavafall, der von hohen Klippe"
     " ueber Dir Richtung Suedwesten abfliesst, gefahrlos zu ueberqueren bzw. "
     "zu 'unterqueren'.");

   AddDetail( ({"moeglichkeit"}),
     "Die gibt es sonst nicht.");

   AddDetail( ({"suedwesten"}),
     "Der Lavafall kommt von Dir aus gesehen im Westen runter, von der oberen, "
     "noerdlich gelegenen, Klippe aus gesehen waere es Suedwesten.");

   AddDetail( ({"richtung","richtungen"}),
     "Es werden fuenf Richtungen beschrieben: Nordwesten, Westen, Nordosten,"
     " Suedosten und Suedwesten.");

   AddDetail( ({"lavafall","lavafaelle"}),
     "Von Dir aus gesehen kommen hier zwei Lavafaelle von der noerdlichen "
     "Klippe gestuerzt: einer faellt im Westen herunter und der andere im "
     "Nordosten. Die beiden sind sicher auch welche von diesen seltsamen "
     "'Adern', die Du von weitem wahrgenommen hast.");

   AddDetail( ({"ader","adern"}),
     "Na die Lavafaelle, was denn sonst?");

   AddDetail( ({"getoese"}),
     "Sehen kannst Du das nicht.");

   AddDetail( ({"sicht"}),
     "Du hast ueberall freie Sicht bis auf den Westen, da wird sie von "
     "Nebelwolken blockiert.");

   AddDetail( ({"nebelwolken","nebel","nebelschwaden","schwaden"}),
     "Die versperren Dir im Westen jegliche Sicht. Das haengt sicher mit dem "
     "Lavafall zusammen, der dort runterkommt.");

   AddDetail( ({"wolken"}),
     "Wolken siehst Du hier nur am 'Himmel' ueber Dir. Du meinst sicher die "
     "Nebelschwaden im Westen.");

   AddDetail( ({"himmel"}),
     "Der ist eigentlich eine Hoehlendecke.");

   AddDetail( ({"see"}),
     "Der liegt suedlich unterhalb des Weges.");

   AddDetail( ({"wegweiser","weiser"}),
     "Als Du ihn naeher untersuchst bemerkst Du das die Ranken gar keinen "
     "herkoemmlichen Wegweiser umklammern, sondern eine tote Fee, deren "
     "Gliedmassen unnatuerlich in die einzelnen Richtungen verdreht wurden.");

   AddDetail( ({"fee","koerper"}),
     "Es scheint fast so als wuerde sie dem Druidenzirkel angehoert haben, da "
     "die Druiden ja bekanntlich keine metallische Ausruestung tragen duerfen. "
     "Sie koennen auch Ranken beschwoeren, so wie es diese Fee wahrscheinlich "
     "gegen einen Gegner versucht hat.");

   AddDetail( ({"gegner"}),
     "Er duerfte maechtiger als sie gewesen sein, da sich die Ranken gegen die "
     "Fee wandten.");

   AddDetail( ({"druiden","druidenzirkel"}),
     "Wo man die Druiden findet, wissen nur die wenigsten, aber Anvar steht "
     "dort herum und erzaehlt jedem, der etwas davon wissen will, von den "
     "Elementen und den Kraeften der Natur.");

   AddDetail( ({"elemente","anvar"}),
     "Anvar ist das Gildenoberhaupt der Druiden. Geh zu ihm und lass sie Dir "
     "von ihm erklaeren.");

   AddDetail( ({"gildenoberhaupt","oberhaupt"}),
     "Er fuehrt sie an.");

   AddDetail( ({"kraefte","natur"}),
     "Die Kraefte der Natur koennen einerseits aufbauend und hilfreich sein, "
     "andererseits aber auch zerstoererisch und unberechenbar sein.");

   AddDetail( ({"gliedmassen","massen"}),
     "Der Kopf zeigt nach Nordwesten, der rechte Fuss nach Nordosten, der "
     "linke Arm nach Westen und der rechte Arm nach Suedosten. Den linken Fuss "
     "kannst Du nirgends sehen.");

   AddDetail( ({"ranken"}),
     "Man kann durch die Ranken auf den toten Koerper der Fee sehen und es "
     "sind nur noch einige wenige nichtmetallische Bekleidungsfetzen daneben "
     "auszumachen.");

   AddDetail( ({"bekleidungsfetzen","bekleidung","fetzen","ausruestung"}),
     "Die Ausruestung der toten Fee bestand bzw. besteht aus einem zerrissenen "
     "Lederstiefel, einer Eishose die leise vor sich hinschmilzt, einem nur "
     "mehr glimmendem Feuerumhang, einem halb zerbroeckelten Elementaramulett "
     "und Scherben eines ehemals funkelnden Kristallpanzers.");

   AddDetail( ({"lederstiefel","stiefel","eishose","hose","feuerumhang",
                "umhang","kristallpanzer","panzer"}),
     "Gehoert meistens zur Ausruestung eines Druiden.");

   AddDetail( ({"kopf","anzeichen"}),
     "Die Augen sind total verdreht, die Zunge haengt schief ueber den "
     "Mundwinkel hinaus, das Gesicht total blau angelaufen. Scheinbar hat die "
     "Ranke der Fee die Luft am Hals abgedrueckt. Ausserdem ist der Kopf der "
     "'Wegweiser' zu der hoeher gelegenen Klippe. ");

   AddDetail( ({"gesicht","luft"}),
     "So sieht man aus wenn man zu tode gewuergt wird.");

   AddDetail( ({"zunge","mundwinkel","auge","augen"}),
     "Das sind auch alles Anzeichen dafuer das die Fee erstickt ist.");

   AddDetail( ({"hals","zeichen"}),
     "Um den Hals haengt noch das kaputte Elementaramulett.");

   AddDetail( ({"elementaramulett","amulett"}),
     "Das Zeichen der Druiden.");

   AddDetail( ({"arm"}),
     "Meinst Du jetzt den rechten oder linken Arm?");

   AddDetail( ({"rechter arm","rechten arm"}),
     "Der zeigt nach Suedosten Richtung See. Ausserdem siehst Du noch ein paar "
     "Ringe an den Fingern.");

   AddDetail( ({"linker arm","linken arm"}),
     "Der zeigt nach Westen zu der Nebelwolke. Ausserdem siehst Du noch ein "
     "paar Ringe an den Fingern.");

   AddDetail( ({"ringe"}),
     "Ihr lebhafter Glanz ist ermattet.");

   AddDetail( ({"glanz"}),
     "Der ist schon lange verschwunden.");

   AddDetail( ({"fuss"}),
     "Meinst Du jetzt den rechten oder linken Fuss?");

   AddDetail( ({"linker fuss","linken fuss"}),
     "Den siehst Du nicht.");

   AddDetail( ({"rechter fuss","rechten fuss"}),
     "Der zeigt den Weg weiter entlang nach Nordosten. Ausserdem siehst Du an "
     "ihm noch ein kleines Fusskettchen haengen.");

   AddDetail( ({"fusskettchen","kettchen"}),
     "Auf ihm ist ein Name eingraviert.");

   AddDetail( ({"name", "yeza"}),
     "Yeza.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Hier riecht es eigentlich nur nach fortgeschrittener Verwesung oder "
     "fauliger Erde. Andere Gerueche kann man hier nicht wahrnehmen.");

   AddSmell( ({"gerueche"}),
     "Nimmst Du nicht wahr.");

   AddSmell( ({"verwesung","erde"}),
     "Wie man sie sonst nur am Friedhof oder auf einem Komposthaufen findet.");

   AddSmell( ({"friedhof","komposthaufen"}),
     "Da riecht es auch genauso wie hier.");

//Geraeusche:
    AddSound(DEFAULT_SOUND,
     "Aus dem Westen hoerst Du noch das Getoese, das entsteht, wenn die Lava "
     "auf das Wasser trifft und verdampft. Ansonsten hoerst Du hier noch das "
     "Knistern der Blitze und ein dumpfes Klopfen wahrnehmen.");

   AddSound( ({"getoese"}),
     "Ziemlich laut, selbst hier noch.");

   AddSound( ({"wasser","lava"}),
     "Es wuerde Deiner Gesundheit nicht sehr gut tun daran zu lauschen, "
     "allerdings kannst Du das sowieso, weil sie hier im Raum nicht vorhanden "
     "ist.");

   AddSound( ({"gesundheit"}),
     "Je laenger Du Dich hier auf der Insel aufhaeltst, desto lauter sagt Deine"
     " Gesundheit: 'Auf Wiedersehen'.");

   AddSound( ({"insel"}),
     "Du lauschst an der Insel, hoerst aber nichts besonderes.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander reiben "
     "wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","pulsieren","leuchten"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"klopfen"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren und Leuchten im Berg zu"
     " hoeren.");

   AddSound( ({"berg"}),
     "Auch wenn Du es nicht wahrhaben willst, der Berg scheint dich noch immer "
     "in irgendeiner Weise anzuziehen.");

   AddSound( ({"weise"}),
     "Eine unheimliche Weise.");
     
   AddDetail( ({"das", "fingern", "nebelwolke", "ranke", "raum", "scherben", 
                "waende", "wand", "wiedersehen", "finger"}),
     "Forsche nicht zu viel.");

//Die Exits:

   AddExit("nordwestoben", ROOM "e4_kraterrand");
   AddExit("nordosten", ROOM "g4_lavafall_mit_riss");
   AddExit("westen", ROOM "e5_klippe_am_see");
   AddExit("suedostunten", ROOM "g6_spitzkehre");
   
   SetProp(P_HIDE_EXITS, ({"nordwesten" , "suedosten"}) );
   AddExit("nordwesten", ROOM "e4_kraterrand");
   AddExit("suedosten", ROOM "g6_spitzkehre");
}