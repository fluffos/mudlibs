#include "../def.h"

inherit "std/room";

#include <properties.h>

void create()
{
  ::create();
  
   SetProp(P_INT_SHORT, "Am Abhang");
   SetProp(P_INT_LONG,
     "Du stehst nun am Abhang zum See rund um die Insel. Ueberall liegen "
     "Felsen herum, auch kleine Steinchen sind zu sehen. Alles besteht hier "
     "aus einem schwarzen Gestein, wobei hier nicht einmal die verkrueppelten "
     "Buesche und Baeume wachsen, wie andernorts. Die Hoehlendecke hier ueber "
     "Dir kannst Du eigentlich auch nur erahnen. Ueberall tanzen die Schatten "
     "und Du meinst einige befinden sich gar nicht mehr auf einer festen "
     "Oberflaeche sondern scheinen sich Dir irgendwie zu naehern. Weiter "
     "entfernt im Osten siehst Du den oberen Rand einer sehr hohen Klippe. "
     "Ausserdem kannst Du von hier auf eine kleinere Anhoehe im Osten gehen. "
     "Im Sueden siehst Du eine etwas hoehere, unterspuelte, Klippe.");
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"oberflaeche","flaeche"}),
     "Auf ihr tanzen die Schatten herum. Allerdings scheinen sich einige "
     "davon loesen zu wollen und strecken sich Dir mit verzerrten Gesichtern "
     "entgegen.");

   AddDetail( ({"gesichter"}),
     "Zerrbilder des Schreckens.");

   AddDetail( ({"zerrbilder","bilder"}),
     "Verzerrt. Abnormal. Schrecklich.");

   AddDetail( ({"schrecken","schreckens"}),
     "      .----------.\n"
     "     /  .-.  .-.  \\\n"
     "    /   |0|  |0|   \\\n"
     "    \\   `-'°°`-'   /\n"
     "     \\  .------.  /\n"
     "      | |\\/\\/\\/| |\n"
     "      | `------´ |\n"
     "      `----------´\n"); 

   AddDetail( ({"hoehlendecke"}),
     "Die Decke siehst Du vor lauter Schwaden nicht wirklich.");

   AddDetail( ({"schwaden"}),
     "Die siehst Du, die Decke darueber nicht.");

   AddDetail( ({"boden"}),
     "Da liegen ueberall Felsen und Steine herum.");

   AddDetail( ({"hang","abhang"}),
     "Naja, Abhang kann man das hier eigentlich nicht nennen, eigentlich waere "
     "hier Felskueste passender.");

   AddDetail( ({"felskueste","kueste"}),
     "So nennt sich eine Kueste aus Felsen. Sie ragt weiter im Osten hoch vor "
     "Dir auf.");

   AddDetail( ({"insel"}),
     "Es ist immer noch die selbe Insel wie vorhin.");

   AddDetail( ({"felsen","fels","steine","gestein"}),
     "Es ist ein nachtschwarzes Material, das entfernt an Basalt oder Obsidian"
     " erinnert.");

   AddDetail( ({"material","materialien","basalt","obsidian"}),
     "Das sieht eben wie Vulkangestein aus.");

   AddDetail( ({"vulkangestein"}),
     "Wird von einem Vulkan ausgespuckt.");

   AddDetail( ({"vulkan"}),
     "Der spuckt Vulkangestein aus.");

   AddDetail( ({"steinchen"}),
     "Hier solltest Du besonders aufpassen das Du nicht auf Ihnen ausrutschst. "
     "Es sind hier einige besonders spitze Stellen vorhanden.");

   AddDetail( ({"baeume","baum","baeumen","busch","buesche"}),
     "Die wachsen hier nicht. Liegt vermutlich an dem grossen, rundlichen Riss "
     "hier.");

   AddDetail( ({"riss"}),
     "Hier fliesst der kleinen Lavafluss, welcher von der oestlichen Anhoehe "
     "kommt, schwefelig riecht, kleine Blasen wirft und maechtig Hitze abgibt, "
     "hinein. Nebenbei bemerkst Du, dass es hier etwas ebener als sonst ist, "
     "sonst wuerde Dir die Lava vermutlich nicht sehr gut tun in ihrem "
     "Fliessverhalten.");

   AddDetail( ({"lava"}),
     "Geschmolzenes Gestein.");

   AddDetail( ({"lavafluss","fluss","lavafluesse","fliessverhalten"}),
     "Fliesst wie jeder andere Fluss auch bergab.");

   AddDetail( ({"anhoehe"}),
     "Die ist im Osten. Geh hin.");

   AddDetail( ({"blasen","blase"}),
     "BLUUUUUUUBBBBB.");

   AddDetail( ({"hitze"}),
     "Boah, ist das heiss hier.");

   AddDetail( ({"osten","sueden"}),
     "Das kann man nicht untersuchen, sondern nur dort hin gehen.");

   AddDetail( ({"rand"}),
     "Mehr siehst Du von hier aus nicht. Vielleicht hast Du von woanders eine"
     " bessere Sicht.");

   AddDetail( ({"klippe"}),
     "Die oestliche Klippe siehst Du von hier nicht ein, und die im Sueden "
     "sieht auch nicht gerade vertrauenserweckend aus.");

   AddDetail( ({"sicht"}),
     "Woanders hab ich gesagt... .");

   AddDetail( ({"decke"}),
     "Verhangen und duester ist sie ueber Dir.");

   AddDetail( ({"pulsieren","leuchten"}),
     "Erst jetzt faellt Dir auf das das von den kleinen Lavafluessen rund um "
     "die Insel stammen koennte.");

   AddDetail( ({"see"}),
     "Er besteht aus heissem, stinkenden Wasser oder hast Du etwa Milch "
     "erwartet?");

   AddDetail( ({"milch","honig"}),
     "Die warme Milch mit Honig gibts nur daheim bei deiner Mami.");

   AddDetail( ({"mami"}),
     "Bei ihr waerst Du jetzt viel lieber, als hier.");

   AddDetail( ({"wasser"}),
     "Das kann Dir hier nichts anhaben.");

//Geraeusche:
   AddSound(DEFAULT_SOUND,
     "Neben dem leisen Klatschen der Wellen und dem Knistern der Blitze "
     "kannst Du auch ein dumpfes Klopfen und ein leises Gluckern wahrnehmen.");

   AddSound( ({"gluckern"}),
     "Das kommt wohl vom Lavafluss.");

   AddSound( ({"klatschen","wellen"}),
     "Man hoert sie sanft an den Hang klatschen.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander reiben "
     "wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","hang","pulsieren","leuchten","lavafluss"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"klopfen"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren und Leuchten im Berg zu"
     " hoeren.");

   AddSound( ({"berg"}),
     "Auch wenn Du es nicht wahrhaben willst, der Berg scheint dich noch immer "
     "in irgendeiner Weise anzuziehen.");

   AddSound( ({"weise"}),
     "Eine unheimliche Weise.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Du riechst auch noch etwas Schwefel.");

   AddSmell( ({"schwefel"}),
     "Riecht wie halbverfaulte Eier."); 

   AddSmell( ({"eier"}),
     "Das ist nur eine Redewendung.");

   AddSmell( ({"redewendung"}),
     "Du willst SOWAS riechen?");
     
   AddDetail( ({"ihnen", "sowas", "stellen", "schatten", "wand", "waende" }),
     "Uninteressant fuer Dich.");

//Die Exits:

   AddExit("ostoben", ROOM "c3_anhoehe");
   AddExit("suedoben", ROOM "b4_bruecken");
   
   SetProp(P_HIDE_EXITS, ({"osten", "sueden"}) );
   AddExit("osten", ROOM "c3_anhoehe");
   AddExit("sueden", ROOM "b4_bruecken");
}