#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  ::create();
   SetProp(P_INT_SHORT, "Auf einem hellen Weg");

   SetProp(P_INT_LONG,
     "Hier ist es deutlich zu sehen, dass die Natur immer einen Weg findet sich"
     " ihr Gebiet zurueckzuholen. Man sieht nur mehr Kristallgruppierungen an "
     "manchen Stellen und die sind auch nicht mehr allzu gross. "
     "Begrenzt wird der Weg zwar hier auch noch durch Dornenhecken und Baeume. "
     "Im Osten kannst Du im Hintergrund die Berge sehen. "
     "Lichtreflektionen sieht man nicht nur mehr dort wo es auf die Kristalle "
     "faellt sondern auch auf einigen Tautropfen, die bis um diese Tageszeit "
     "durchgehalten haben.");
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_FOREST]) );
   SetProp(P_INDOORS, 0);

   AddDetail( ({"osten", "hintergrund", "berge"}),
     "Majestaetisch ragen sie in der Ferne mit ihren schneebedeckten Gipfeln in"
     "den Himmel.");

   AddDetail( ({"ferne"}),
     "Die Ferne ist sehr weit entfernt. :)");

   AddDetail( ({"gipfel"}),
     "Die sind vom Schnee bedeckt, welcher im Sonnenlicht, das im Gegensatz zu "
     "hier durch keine Wolke aufgehalten wird, funkelt und glitzert.");

   AddDetail( ({"gegensatz"}),
     "Schau doch nach oben in den Himmel.");

   AddDetail( ({"schnee", "flocken"}),
     "Das sind die weissen Flocken die im Winter vom Himmel faellen.");

   AddDetail( ({"winter", "fruehling", "sommer", "herbst"}),
     "Ist eine der Jahreszeiten: Fruehling, Sommer, Herbst und Winter.");

   AddDetail( ({"jahreszeit", "jahreszeiten"}),
     "Davon gibt es vier."); 
   AddDetail( ({"tautropfen", "tageszeit", "zeit", "fruehmorgens"}),
     "Obwohl es hier laengst nicht mehr Fruehmorgens ist, siehst Du noch einige"
     " wenige Tautropfen schimmern.");

   AddDetail( ({"natur", "stellen"}),
     "Hier ist es deutlich zu sehen, dass die Natur immer einen Weg findet sich"
     " ihr Gebiet zurueckzuholen. Man sieht nur mehr Kristallgruppierungen an "
     "manchen Stellen und die sind auch nicht mehr allzu gross.");

   AddDetail( ({"gebiet"}),
     "Das ist hier der (frueher kristalline) Kristallwald.");

   AddDetail( ({"weg", "waldweg", "boden"}),
     "Der Boden ist hier mit einer Schicht ueberzogen die sich im Allgemeinen "
     "Erde nennt. Nur bei genauerem Hinsehen ragen noch kleine Kristalle aus "
     "ihr heraus");

   AddDetail( ({"hinsehen"}),
     "Du untersuchst aber auch alles.");

   AddDetail( ({"allgemein", "allgemeinen"}),
     "Naja was im Allgemeinen heisst, wirst Du doch nicht im Detail wissen "
     "wollen?");

   AddDetail( ({"detail"}),
     "Das untersuchst Du gerade.");

   AddDetail( ({"schicht", "erde"}),
     "Broeselig und braun, so wie Erde nun mal ist.");

   AddDetail( ({"kristall", "kristalle", "kristallen", "gruppierung", 
                "kristallgruppierungen", "gruppierungen"}),
     "Wenn es nicht Kristall waere, waere hier doch nicht der Kristallwald, "
     "oder?");

   AddDetail( ({"wald", "kristallwald"}),
     "Er besteht hier aus vielen Dornenhecken und Baeumen.");

   AddDetail( ({"licht", "sonnenlicht"}),
     "Auch hier wird das Sonnenlicht von den Kristallen reflektiert und "
     "verstaerkt, aber laengst nicht in der Farbenpracht des westlichen Teils "
     "dieses Wegs.");

   AddDetail( ({"teil", "westen"}),
     "Geh zurueck und sieh es Dir doch an.");

   AddDetail( ({"farben", "pracht", "farbenpracht", "regenbogen"}),
     "Du siehst saemtlich Farben des Regenbogens.");

   AddDetail( ({"dornenhecken", "dornenhecke", "hecke", "hecken"}),
     "Es ist eine teilweise mit Kristallen ueberzogene, verfilzte Hecke mit "
     "vielen spitzen Dornen auf ihren Zweigen. Im Sueden, Suedosten und "
     "Suedwesten waechst sie bedrohlich hoch zwischen den Baeumen.");

   AddDetail( ({"sueden", "suedosten", "suedwesten"}),
     "Da waechst die Hecke besonders hoch.");

   AddDetail( ({"dornen"}),
     "Die sind ganz schoen spitz. Pass lieber auf und greif sie nicht an.");

   AddDetail( ({"zweige"}),
     "Die kannst Du sicher biegen wie Du willst, abbrechen werden die hier "
     "nicht mehr.");

   AddDetail( ({"beruehrungen", "art", "biegen"}),
     "Naja, Biegen und so halt. Probiers doch aus");

   AddDetail( ({"baeume"}),
     "Sie sehen gar nicht mehr aus wie alle anderen Baeume im Kristallwald, "
     "sie haben naemlich nur mehr eine hauchduenne Kristallschicht die sie von "
     "unten bis oben ueberzieht, vom Stamm bis zu den kleinsten Blaettern. Im "
     "letzten Moment siehst Du einen Baum der ganz und gar frei von Kristallen "
     "ist.");

   AddDetail( ({"baum", "besonderes"}),
     "Er scheint etwas Besonderes zu sein, da Du keinerlei Kristalle an ihm "
     "entdecken kannst. Bei genauerem hinsehen entdeckst Du am Stamm kleine, "
     "symmetrisch angeordnete, Einkerbungen.");

   AddDetail( ({"einkerbungen"}),
     "Fuer was koennten die wohl gut sein?");

   AddDetail( ({"moment"}),
     "Der ist schon wieder vorbei.");

   AddDetail( ({"stamm"}),
     "Der ist so dick den koenntest nicht mal Du umfassen.");

   AddDetail( ({"blaetter"}),
     "Sind nur mehr von einer hauchduennen, durchsichtigen Kristallschicht "
     "ueberzogen.");

   AddDetail( ({"himmel"}),
     "Oha. Da scheint sich etwas am Himmel zusammenzubrauen. Schau dir nur die "
     "vielen dunklen Wolken an. Auch die Sonne kann da nicht mehr "
     "durchdringen.");

   AddDetail( ({"wolken"}),
     "Sehen aus wie Regenwolken. Leider hast Du hier keine Moeglichkeit Dich "
     "irgendwo unterzustellen.");

   AddDetail( ({"moeglichkeit"}),
     "Die findest du anderswo.");

   AddDetail( ({"sonne"}),
     "Ist hinter den Wolken versteckt.");

//Hier jetzt Gerueche und Geraeusche:
   AddSound( ({DEFAULT_SOUND, "baeume", "unterholz"}),
     "Hier wird es immer lauter. Man hoert mehr und mehr Voegel irgendwo aus "
     "den Baeumen heraus zwitschern oder Insekten durchs Unterholz rascheln.");

   AddDetail( ({"voegel", "vogel"}),
     "Siehst Du hier nicht, aber hoeren kann man das Gezwitscher.");

   AddDetail( ({"unterholz"}),
     "Das liegt unter den Hecken und Baeumen. Ansonsten waers ja kein "
     "Unterholz.");

   AddSound( ({"gezwitscher", "vogel", "voegel"}),
     "Zwitsch, Zwitsch, Tirili, Tirila ...");

   AddDetail( ({"insekt", "insekten"}),
     "Siehst Du hier nicht, aber hoeren kann man es.");

   AddSound( ({"krabbeln", "insekt", "insekten"}),
     "Kribbel, krabbel, kratz, kratz, schab, schab ...");

   AddSmell( ({DEFAULT_SMELL,"natur","luft"}), 
     "Du holst tief Luft und riechst die Natur. Naja riecht ein bisschen "
     "staubig.");

   AddSmell( ({"staub"}),
     "Riecht staubig.");
     
   AddDetail( ({"kristallschicht", "tirila", "tirili", "zwitsch", 
                "wolke", "regenwolken"}),
     "Wer untersucht das?");


//Die Exits:

   AddExit("westen", ROOM "raum17");
   AddExit("osten",  ROOM "raum15");
   
}