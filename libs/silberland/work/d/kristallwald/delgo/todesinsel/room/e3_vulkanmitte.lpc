#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  
  object ob;
  
  ::create();
  
   SetProp(P_INT_SHORT, "In der Mitte des Vulkans");
   SetProp(P_INT_LONG,
     "Du traust Deinen Augen kaum, nachdem Du ueber die Bruecke spaziert "
     "bist. Die vor Dir liegende 'Felsnadel' entpuppt sich als einigermassen "
     "grosse Flaeche auf der sogar ein Steinhaus leicht Platz gefunden hat, "
     "in dessen Inneres Du sofort hineingehst. Es fuehrt hier eine Treppe "
     "nach oben.");

   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"augen"}),
     "Davon hast Du (hoffentlich) zwei.");

   AddDetail( ({"bruecke"}),
     "Die siehst Du durch die Tuere hindurch auf die andere Seite des Vulkans"
     " verschwinden.");

   AddDetail( ({"tuere"}),
     "Sie wuerde so gross gemacht, dass sogar ein Troll durchkommt.");

   AddDetail( ({"troll"}),
     "... und die sind maechtig gross.");

   AddDetail( ({"seite"}),
     "Alles hat ein Ende, nur ... aehm nein, falscher Reim.");

   AddDetail( ({"ende"}),
     "Hoffentlich geht es hier mit Dir nicht zu ende.");

   AddDetail( ({"reim"}),
     "Zu Seite faellt mir jetzt kein Reim ein.");

   AddDetail( ({"vulkan"}),
     "Du befindest Dich in seiner Mitte.");

   AddDetail( ({"mitte"}),
     "Das ist das Zentrum.");

   AddDetail( ({"zentrum"}),
     "... welches immer in der Mitte liegt. So; hier waeren wir wieder.");

   AddDetail( ({"felsnadel","nadel"}),
     "Eigentlich ist es ja keine Nadel sondern eher eine Flaeche aus Fels.");

   AddDetail( ({"flaeche"}),
     "Gerade gross genug damit das Haus darauf passt und Du sorglos rundherum"
     " gehen kannst.");

   AddDetail( ({"steinhaus","haus"}),
     "Es wurde anscheinend aus einem einzigen grossen Steinblock herausgehauen"
     " und hat alles was ein Haus haben muss: Boden und Waende, Fenster und"
     " Tuere. Nur die Decke fehlt."
     " Weiters siehst Du ein Bett, einen Tisch und einen Sessel herumstehen."
     " Wer hier wohl wohnen mag?");

   AddDetail( ({"boden"}),
     "Der wurde fein saeuberlich bearbeitet und glatt poliert. Pass auf das Du"
     " darauf nicht ausrutscht.");

   AddDetail( ({"waende"}),
     "An ihnen sieht man noch an einzelnen Stellen die Bearbeitungsspuren.");

   AddDetail( ({"stellen","bearbeitungsspuren","spuren"}),
     "Das bemerkt man aber nur wenn man ganz genau hin schaut. Ansonsten sind"
     " sie genau so glatt wie der Boden.");
   
   AddDetail( ({"fenster"}),
     "Zwei gibt es davon. Allerdings ist die Aussicht recht beschraenkt.");

   AddDetail( ({"aussicht"}),
     "Das einzige was Du siehst ist der Vulkan.");

   AddDetail( ({"bett"}),
     "Sehr simpel und schlicht. Nicht mal eine Bettdecke gibts hier.");

   AddDetail( ({"bettdecke"}),
     "Kein Wunder so warm wie es hier ist.");

   AddDetail( ({"wunder"}),
     "Wunder gibt es immer wieder. *traeller*");

   AddDetail( ({"tisch"}),
     "Schlicht und einfach mit vier Beinen. Genau wie der Sessel.");

   AddDetail( ({"beine"}),
     "Du hast zwei, der Tisch hat vier. Aber erst jetzt siehst Du, dass"
     " auch die Einrichtungsgegenstaende aus dem Fels herausgeschlagen "
     "wurden.");

   AddDetail( ({"fels","stein","steinblock","block"}),
     "Das alles wurde aus einem Stueck heraus gearbeitet.");

   AddDetail( ({"stueck"}),
     "Das muss ein grosser Felsblock gewesen sein, wenn Du Dir das Haus so "
     "ansiehst.");

   AddDetail( ({"sessel"}),
     "Offenbar ist man hier nicht auf Besuch eingerichtet.");

   AddDetail( ({"besuch"}),
     "Dich z.B.");

   AddDetail( ({"decke"}),
     "Meinst Du jetzt die Bettdecke, die Hoehlendecke oder die Hausdecke?");

   AddDetail( ({"hoehlendecke"}),
     "Die ist hier tiefer als draussen. Du glaubst eine Oeffnung zu erkennen.");

   AddDetail( ({"hausdecke"}),
     "Die gibt es nicht. Dafuer siehst Du von hier aus wie sich die sieben "
     "Monolithen gegen die Mitte des Vulkans neigen.");

   AddDetail( ({"monolithen"}),
     "Du siehst allerdings nur ihre Spitzen.");

   AddDetail( ({"spitze","spitzen"}),
     "Sehen aus wie jede andere Spitze auch. Spitz eben.");

   AddDetail( ({"platz"}),
     "Von dem ist genug da.");

   AddDetail( ({"inneres","inneren"}),
     "Da befindest Du Dich gerade.");

//Geraeusche:
  AddSound(DEFAULT_SOUND,
    "Im Gegensatz zu den anderen Orten am Vulkan hoerst Du hier eigentlich nur "
    "hin und wieder das Blubbern der Lava rund um das Haus.");

  AddSound( ({"gegensatz","orte","haus"}),
    "Wie willst Du sowas hoeren?");

  AddSound( ({"blubbern"}),
    "BLLLLUUUUUUUUBBBBB.");

  AddSound( ({"vulkan","lava"}),
    "Das wuerde Dir sicher gut tun ... ");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Es riecht hier eigentlich nach gar nichts.");
     
   AddDetail( ({"felsblock", "einrichtungsgegenstaende", "wand"}), 
     "Gut geforscht!");
     
   AddDetail( ({"oeffnung"}),
     "Es scheint tatsaechlich eine kleine Oeffnung zu sein. Die Treppe fuehrt "
     "genau darauf zu.");
     
   
   AddDetail( ({"treppe", "wendeltreppe"}),
     "Diese Wendeltreppe ist wie alles hier aus Stein. Sie fuehrt hoch bis "
     "zur Decke und scheint dort zu verschwinden, solltest Du sie ersteigen "
     "wollen?");
     
   AddCmd( ({"steige", "ersteige", "steig"}), "up");

//Exits:
   AddExit("westen", ROOM "d3_kraterrand");
   AddItem(NPC "druid", REFRESH_DESTRUCT);
   ob=present("\ndruidenzirkel_npc", TO);
   if(ob) ob->customize("myra");
}
void reset()
{
  object ob;
  
  ::reset();
  
   ob=present("\ndruidenzirkel_npc", TO);
   if(ob) ob->customize("myra");
}
int up(string str)
{
  notify_fail("Was willst Du tun?\n");

  if (!str || str == "") return 0;

  if (str != "treppe" && str != "treppe hinauf") 
    return 0;
  tell_object(TP, "Du kletterst die zahlreichen Stufen nach oben ...\n");
  TP->SetProp(P_PARALYZED, ([PARALYZE_TIME: 6, 
							PARALYZE_MSG: "Du konzentrierst Dich voll aufs Treppensteigen!\n"
						 ,PARALYZE_MSG_OTHER: "%s steigt die Stufen hinauf.\n", 
							PARALYZE_END: "Du hast das Ende der Treppe erreicht und kommst "
							"mitten im Wald raus.\n",
							PARALYZE_END_OTHER: "%s verschwindet nach und nach.\n"]));
  Message(TP->Name(WER, 1)+" ersteigt die Treppe.\n"
        , MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  call_out("stair1", 3, TP);
  return 1;
}
int stair1(object pl)
{
  pl->Message(BS("Du laesst das Haus unter Dir und bekommst einen kleinen "
                 "Ueberblick ueber die unterirdische "
                 "Insel.\n"), MSGFLAG_VISUAL);
  call_out("stair2", 3, pl); 
}
int stair2(object pl)
{
  pl->Message(BS("Du naeherst Dich der Decke, ist das da Tageslicht, was "
                 "durch die Oeffnung scheint?\n"), MSGFLAG_VISUAL);
  call_out("stair3", 3, pl); 
}
int stair3(object pl)
{
  pl->Message(BS("Tatsaechlich, scheinbar fuehrt diese Treppe zur Oberflaeche, "
                 "lang genug ist sie ja.\n"), MSGFLAG_VISUAL);
  call_out("stair4", 2, pl); 
}
int stair4(object pl)
{
  string room;
  
  room = ROOM"raum11";
  pl->Message(BS("Schnaufend ueberwindest Du die letzten Stufen, Du riechst "
  "schon die frische Luft.\n"), MSGFLAG_VISUAL);
  pl->move(ROOM "raum11", M_SILENT | M_TPORT);
  room->Message(BS(TP->Name(WER, 1)+" klettert herauf.\n"), MSGFLAG_VISUAL, 
                ([ MSGFLAG_EXCLUDE: ({pl})]));
}
