#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  
  object ob;
  
  ::create();
   SetProp(P_INT_SHORT, "Eine teilweise unterspuelte Klippe");
   SetProp(P_INT_LONG,
     "Du hast die unterspuelte Bruecke im Nordwesten nun hinter Dir gelassen "
     "und kannst nur nach vorne oder zurueckgehen, denn rechts und links neben "
     "Dir sind die hohe Klippe bzw. die See. Ueberall liegen Felsen und Steine "
     "aus diesem schwarzen Gestein herum, wobei hier wieder die verkrueppelten "
     "Buesche und Baeume wachsen. Die Hoehlendecke hier beachtest Du kaum. "
     "Irgendwie wirkt hier alles so schummrig, ueberall scheinen die Schatten "
     "zu tanzen und Du meinst einige befinden sich gar nicht mehr auf einer "
     "festen Oberflaeche sondern scheinen sich Dir irgendwie zu naehern.");
   SetProp(P_LIGHT, -1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"see"}),
     "Er besteht aus heissem, stinkenden Wasser.");

   AddDetail( ({"saeure"}),
     "Das kann Dir hier (hoffentlich) nichts anhaben.");

   AddDetail( ({"felsen","steine","gestein"}),
     "Es ist ein nachtschwarzes Material, das entfernt an Basalt oder Obsidian"
     " erinnert.");

   AddDetail( ({"material","materialien","basalt","obsidian"}),
     "Das sieht eben wie Vulkangestein aus.");

   AddDetail( ({"vulkangestein"}),
     "Wird von einem Vulkan ausgespuckt.");

   AddDetail( ({"vulkan"}),
     "Der spuckt Vulkangestein aus.");

   AddDetail( ({"klippe"}),
     "Du weisst nicht genau was da oben ist, da Du das von hier aus nicht "
     "siehst.");

   AddDetail( ({"oberflaeche","flaeche"}),
     "Hier tanzen mehr Schatten als sonst wo herum. Sie scheinen sich aber "
     "auch hier davon loesen zu wollen und strecken sich Dir mit verzerrten "
     "Gesichtern entgegen.");

   AddDetail( ({"gesichter"}),
     "Zerrbilder des Schreckens.");

   AddDetail( ({"zerrbilder","bilder"}),
     "Verzerrt. Abnormal. Schrecklich.");

   AddDetail( ({"schrecken","schreckens"}),
     "        .      .      \n"
     "       /|      |\\     \n"
     "      ( (      ) )    \n"
     "       \\ \\    / /     \n"
     "      .-' '--' '-.    \n"
     "     /  .-.  .-.  \\   \n"
     "    /   |.|  |°|   \\  \n"
     "    \\   `-'°°`-'   /  \n"
     "     \\  .------.  /   \n"
     "      | `\\/--\\/´ |    \n"
     "      `----------´    \n"); 

   AddDetail( ({"hoehlendecke","decke"}),
     "Die Hoehlendecke ist soweit oben und so verhangen, dass Du sie gar nicht "
     "siehst. Ausserdem solltest Du lieber auf anderes achten.");

   AddDetail( ({"boden"}),
     "Da liegen ueberall Felsen und Steine herum.");

   AddDetail( ({"nordwesten"}),
     "Da ist die Bruecke.");

   AddDetail( ({"bruecke"}),
     "Sieht sehr schmal und wackelig aus. Ohne Gelaender zum festhalten musst "
     "Du sehr vorsichtig sein beim hinuebergehen.");

   AddDetail( ({"gelaender"}),
     "Siehst Du hier irgendwo eines?");

   AddDetail( ({"baeume","baum","busch","buesche"}),
     "Sie klammern sich mit ihren kargen Wurzeln an den Felsen fest, und es "
     "sieht fast so aus als wuerden sie sich Dir entgegenstrecken.");
/*hier haett ich einen idee, wo man random die baeume (ich verteil sie eh 
ueberall), wirklich nach einem greifen laesst oder eventuell ein baummonster 
entstehen lassen koennte das sich mit dem spieler (bzw. er mit dem monster :) )
befasst.*/
//erstmal dagegen

   AddDetail( ({"wurzeln"}),
     "Die finden hier auf diesem unwirtlichen Fleck des Silberlands kaum "
     "Naehrstoffe.");

   AddDetail( ({"fleck"}),
     "Die Insel, was sonst?");

   AddDetail( ({"silberland"}),
     "Wenn Du bist jetzt noch nicht weist, dass Du im Silberland, weist Du es "
     "jetzt.");

   AddDetail( ({"stoff","stoffe"}),
     "Stoff? Wo siehst Du hier Stoff?");

   AddDetail( ({"naehrstoffe","naehrstoff"}),
     "Die finden sich auf diesen leblosen Felsen kaum, sodass hier kaum etwas "
     "waechst.");

   AddDetail( ({"insel"}),
     "Egal wie oft Du 'Insel' noch untersuchst, aendern wird sich an ihrem "
     "Aussehen trotzdem nichts.");

   AddDetail( ({"aussehen"}),
     "Das muesstest Du jetzt doch schon eigentlich kennen, oder?");

   AddDetail( ({"schatten"}),
     "Hier kommt Dir alles viel duesterer und dunkler vor, als auf der "
     "uebrigen Insel. Es haengt vermutlich mit der schwarzen Stelle zwischen "
     "den Felsen zusammen.");

   AddDetail( ({"stelle"}),
     "Als Du naeher hingehst bemerkst Du die schemenhaften Umrisse einer "
     "Person dort.");

   AddSpecialDetail( ({"umrisse","umrissen"}), "damage");
     
/* hier bitte irgendwo wieder ganz fies (aber erst nach dem entdecken der dunkellanze) den spieler damit "abschiessen" :*/

   AddDetail( ({"person"}),
     "Sie ist fast zur Gaenze in einen Umhang der Dunkelheit gehuellt.");

   AddDetail( ({"gaenze"}),
     "Bis auf die Umrisse eben.");

   AddDetail( ({"dunkelheit"}),
     "Sie konzentriert sich um diese Person.");

   AddDetail( ({"lanze","umhang"}),
     "Du bist der Meinung es koennte sich um einen der geheimnisvollen "
     "Dunkelelfen handeln.");

   AddDetail( ({"meinung"}),
     "Auch Deine Meinung ist gefragt.");

   AddDetail( ({"dunkelelf","dunkelelfen"}),
     "Sie leben in der dunklen und duesteren Stadt Dhrkion mitten in der "
     "Unterwelt, zusammen mit den ganzen anderen grossen Schrecken und "
     "Gefahren des Silberlandes.");

   AddDetail( ({"stadt","dhrkion"}),
     "In ihr beten sie ihre Goettin Lloth im dunklen Tempel an.");

   AddDetail( ({"goettin","lloth"}),
     "Sie verlangt immer Blutopfer.");

   AddDetail( ({"tempel","blutopfer","opfer"}),
     "Im Tempel werden der Goettin die Opfer dargebracht.");

   AddDetail( ({"unterwelt"}),
     "Die Unterwelt ist ein sehr gefaehrlicher Teil dieser Welt.");

   AddDetail( ({"teil"}),
     "Die Unterwelt. Als Du genauer darueber nachdenkst wird Dir klar, dass "
     "das hier auch eine Art Unterwelt ist.");

   AddDetail( ({"art"}),
     "Naja, nicht DIE Unterwelt, sondern nur ein Teil von ihr.");

   AddDetail( ({"welt","silberland"}),
     "Diese Welt heisst Silberland.");

   AddDetail( ({"gefahren"}),
     "Nur Wenige trauen sich da runter (ausser sie wurden da unten schon als "
     "Dunkelelf geboren).");

   AddDetail( ({"wenige"}),
     "Nicht viele.");

//Geräusche:
   AddSound(DEFAULT_SOUND,
     "Neben den leiser werdenden Wellen und dem Knistern der Blitze kannst Du "
     "auch ein dumpfes Klopfen wahrnehmen.");

   AddSound( ({"wellen"}),
     "Man hoert sie kaum noch hinter den hohen Felsen hier.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander reiben "
     "wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","pulsieren","leuchten"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"klopfen"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren des Leuchtens im Berg zu"
     " hoeren.");

   AddSound( ({"berg"}),
     "Auch wenn Du es nicht wahrhaben willst, der Berg scheint dich noch immer "
     "in irgendeiner Weise anzuziehen.");

   AddSound( ({"weise"}),
     "Eine unheimliche Weise.");

//Geraeusche:
  AddSmell(DEFAULT_SMELL,
     "Das stinkende Wasser ist hier schon wieder staerker wahrzunehmen. Dafuer "
     "laesst der Geruch hingegen im Westen und Nordwesten wieder nach.");

   AddSmell( ({"geruch"}),
     "Du kannst nicht genau eruieren, warum das Wasser so stinkt.");

   AddSmell( ({"westen","nordwesten"}),
     "Das kannst Du nicht riechen, nur untersuchen.");
     
   AddDetail( ({"die", "waende", "wand", "wasser"}),
     "Findest Du so nicht.");

//Die Exits:
   AddExit("nordwesten", ROOM "b4_bruecken");
   AddExit("osten", ROOM "d5_klippe_am_see");
   AddItem(NPC "druid", REFRESH_DESTRUCT);
   ob=present("\ndruidenzirkel_npc", TO);
   if(ob) ob->customize("tuldalon");
}
void reset()
{
  object ob;
  
  ::reset();
  
   ob=present("\ndruidenzirkel_npc", TO);
   if(ob) ob->customize("tuldalon");
}
string damage()
{
  string s;
  s = "Recht viel mehr ausser den ungenauen Umrissen und einer dunklen Lanze\n"
     "kannst Du nicht erkennen.\nAusser, dass sie sich auf Dich zubewegt...\n"
     "Die Dunkellanze streift Dich nur leicht. Verschwinde lieber schnell von\n"
     "hier!\n";
  TP->AddHp(-15);
  return s; 
}