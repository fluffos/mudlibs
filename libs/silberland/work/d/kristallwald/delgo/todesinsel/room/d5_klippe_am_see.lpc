#include "../def.h"
#include <properties.h>

inherit "std/room";

int i;

void create()
{
  ::create();
  
  i=1;
  
   SetProp(P_INT_SHORT, "Auf einer Klippe");
   SetProp(P_INT_LONG,
     "Du stehst nun auf einer mittleren Klippe der Insel. Ueberall liegen "
     "Felsen herum, auch kleine Steinchen sind zu sehen. Alles besteht hier "
     "aus einem schwarzen Gestein, hier wachsen wieder ein paar dieser "
     "verkrueppelten Buesche und Baeume. Du kannst hier nach Osten oder "
     "Westen, also nur nach vorne oder zurueckgehen, denn rechts und links "
     "neben Dir sind die hohe Klippe bzw. die See. Die Hoehlendecke ist hier "
     "nur sporadisch zu sehen.");
   SetProp(P_LIGHT, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"hoehlendecke"}),
     "An der Decke zucken die Blitze durch die Nebelschwaden.");

   AddDetail( ({"blitze","blitz"}),
     "Pass bloss auf das dich keiner trifft.");

   AddDetail( ({"nebelschwaden","nebel","schwaden"}),
     "Die sind so dicht, dass Du nicht siehst was sich darueber verbirgt.");

   AddDetail( ({"boden"}),
     "Da liegen ueberall Felsen und Steine herum.");

   AddDetail( ({"klippe"}),
     "Ziemlich hoch ragt sie wie eine Wand im Norden vor Dir auf. Du siehst "
     "gerade mal den Rand.");

   AddDetail( ({"wand","felswand"}),
     "Die Felswand besteht aus felsigem Gestein.");

   AddDetail( ({"see"}),
     "Er liegt im Sueden und besteht (natuerlich) aus heissem, stinkenden "
     "Wasser. Du koenntest versuchen ueber den kleinen Abhang nach Suedwesten "
     "zu dem Inselchen zu gehen das Du vorher schon wahrgenommen hast.");

   AddDetail( ({"abhang","hang"}),
     "Wenn Du vorsichtig runtergehst, wird Dir auf diesem steilen Hang "
     "(hoffentlich) nichts passieren, so voll mit Steinchen wie der ist.");

   AddDetail( ({"inselchen"}),
     "Das hast sicher schon aus der Ferne gesehen.");

   AddDetail( ({"ferne"}),
     "Die ist weit weg.");

   AddDetail( ({"wasser"}),
     "Das kann Dir hier (hoffentlich) nichts anhaben.");

   AddDetail( ({"norden","sueden"}),
     "Dort sind die Klippe bzw. die See.");

   AddDetail( ({"insel"}),
     "Es ist immer noch die selbe Insel wie vorhin.");

   AddDetail( ({"felsen","fels","steine","gestein"}),
     "Es ist ein nachtschwarzes Material, das entfernt an Basalt oder Obsidian"
     " erinnert.");

   AddDetail( ({"material","materialien","basalt","obsidian"}),
     "Das sieht eben wie Vulkangestein aus.");

   AddDetail( ({"vulkangestein"}),
     "Wird von einem Vulkan ausgespuckt.");

   AddDetail( ({"vulkan"}),
     "Der spuckt Vulkangestein aus.");

   AddDetail( ({"steinchen"}),
     "Hier solltest Du besonders aufpassen, dass Du nicht auf Ihnen "
     "ausrutschst. Es sind hier einige besonders spitze Stellen vorhanden. "
     "Du glaubst einen besonderen Stein zu sehen.");

   AddSpecialDetail( ({"stein"}), "glas");
     /*"Dieser Stein sieht aus wie ein kleiner, in Glas gegossener, Rumpf. ");
/*hier haett ich die idee, auf der ganzen insel so kleine glastotenteile zu 
verteilen mit denen man sich irgendwie a bisserl gegen die wirkung der insel 
schuetzen kann (wahrscheinlich werdens einige am anfang brauchen wenns dort f
orschen oder ekros werden wollen und sich net auskennen noch dort ... anderen 
koennts natuerlich auch helfen, ma muss halt nur alle 7 teilen finden.*/

   AddDetail( ({"glas"}),
     "Sehr durchsichtig und oft schnell kaputt.");

   AddDetail( ({"rumpf"}),
     "Man sieht den Brustkorb und die Schulterknochen.");

   AddDetail( ({"brustkorb","korb"}),
     "Du siehst die Rippen und das Brustbein, aber die Wirbelsaeule fehlt hier "
     "anscheinend.");

   AddDetail( ({"wirbelsaeule"}),
     "Die siehst Du an dem Rumpf nicht.");

   AddDetail( ({"rippen","brustbein"}),
     "Die kannst Du vor lauter Muskeln nicht erspueren.");

   AddDetail( ({"muskel","muskeln"}),
     "Davon hast Du viel zu viele.");

   AddDetail( ({"bein"}),
     "Bein? Wo siehst Du hier ein Bein?");

   AddDetail( ({"brust"}),
     "Wir haben alles hier!");

   AddDetail( ({"schulterknochen","schulter"}),
     "Bestehend aus den Schluesselbeinen, den Schulterblaettern und den "
     "Gelenkspfannen fuer die Oberarmknochen.");

   AddDetail( ({"schluesselbein","schluesselbeine","gelenkspfanne",
                "gelenkspfannen","oberarm","arm"}),
     "Hast Du sicher auch in deinem Arm, aber die kann man von aussen nicht "
     "erfuehlen.");

   AddDetail( ({"beine"}),
     "Davon hast Du zwei.");

   AddDetail( ({"blaetter","blatt"}),
     "Sowas siehst Du hoechstens an den Baeumen und Bueschen hier, aber nicht "
     "Deine eigenen Schulterblaetter.");

   AddDetail( ({"stellen"}),
     "Greif lieber nicht hin, Du koenntest Dich verletzen.");

   AddDetail( ({"baeume","baum","busch","buesche"}),
     "Sie klammern sich mit ihren kargen Wurzeln an den Felsen fest, und es "
     "sieht fast so aus als wuerden sie sich Dir entgegenstrecken.");
/*hier haett ich einen idee, wo man random die baeume (ich verteil sie eh 
ueberall), wirklich nach einem greifen laesst oder eventuell ein baummonster 
entstehen lassen koennte das sich mit dem spieler (bzw. er mit dem monster :) )
befasst.*/

   AddDetail( ({"wurzeln"}),
     "Die finden hier auf diesem unwirtlichen Fleck des Silberlands kaum "
     "Naehrstoffe.");

   AddDetail( ({"fleck"}),
     "Die Insel, was sonst?");

   AddDetail( ({"silberland"}),
     "Wenn Du bist jetzt noch nicht weisst, dass Du im Silberland bist, weisst Du "
     "es jetzt.");

   AddDetail( ({"stoff","stoffe"}),
     "Stoff? Wo siehst Du hier Stoff?");

   AddDetail( ({"naehrstoffe","naehrstoff"}),
     "Die finden sich auf diesen leblosen Felsen kaum, sodass hier kaum etwas "
     "waechst.");

   AddDetail( ({"osten","norden","westen","suedwesten"}),
     "Das kann man nicht untersuchen.");

   AddDetail( ({"rand"}),
     "Du siehst von hier aus kaum ueber den Rand der Klippe hinaus, aber es "
     "duerfte sich etwas Wichtiges da oben befinden.");

   AddDetail( ({"wichtiges"}),
     "Geh woanders rauf und schaue es Dir an. Von hier aus geht das nicht.");

   AddDetail( ({"decke"}),
     "Verhangen und duester ist sie ueber Dir.");

   AddDetail( ({"pulsieren","leuchten"}),
     "Erst jetzt faellt Dir auf das das von den kleinen Lavafluessen rund um "
     "die Insel stammen koennte.");

//Geraeusche:
   AddSound(DEFAULT_SOUND,
     "Neben dem leisen Klatschen der Wellen und dem Knistern der Blitze kannst "
     "Du auch ein dumpfes Klopfen wahrnehmen.");

   AddSound( ({"klatschen","wellen"}),
     "Man hoert sie sanft an den Hang klatschen.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander reiben "
     "wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","hang","pulsieren","leuchten","lavafluss"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"klopfen"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren und Leuchten im Berg zu"
     " hoeren.");

   AddSound( ({"berg"}),
     "Auch wenn Du es nicht wahrhaben willst, der Berg scheint dich noch immer "
     "in irgendeiner Weise anzuziehen.");

   AddSound( ({"weise"}),
     "Eine unheimliche Weise.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Es gibt nichts weiter zu riechen, als das ueberall praesente, heisse und "
     "stinkende Wasser.");

   AddSmell( ({"wasser"}),
     "Du willst erst gar nicht wissen, warum dieser Geruch so stinkend ist.");

   AddSmell( ({"geruch"}),
     "Der ist hier sicher nicht mehr schaedlich fuer Deine Gesundheit.");

   AddSmell( ({"gesundheit"}),
     "Bist Du gesund?");
     
   AddDetail( ({"ihnen", "lavafluessen", "oberarmknochen", "schulterblaetter", 
               "schluterblaettern", "waende"}), 
     "Ruhe Dich mal aus und forsche weniger.");

//Die Exits:

   AddExit("osten", ROOM "e5_klippe_am_see");
   AddExit("westen", ROOM "c5_klippe_am_see");
   AddExit("suedwestunten", ROOM "c6_inselchen");
   
   SetProp(P_HIDE_EXITS, ({"suedwesten"}) );
   AddExit("suedwesten", ROOM "c6_inselchen");
}
string glas()
{
  string s;
  object ob;
  
  if(i)
  { 
    s = "Dieser Stein sieht aus wie ein kleiner, in Glas gegossener, Rumpf. "
        "Seltsam, dass er Dir nicht vorher aufgefallen ist. Er liegt offen da.";
    ob=clone_object(OBJ "rumpf");
    ob->move(TO, M_NOCHECK | M_SILENT);
    i=0;
    return BS(s); 
  }
  s = "Seltsam. Du bist felsenfest davon ueberzeugt hier sollte ein Glasrumpf "
      "liegen.";
  return BS(s); 
}
void reset()
{
  if(!present("\nglas_rumpf")) {i=1;}
  ::reset();
}