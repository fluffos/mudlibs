#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  ::create();
  
   SetProp(P_INT_SHORT, "Am Ostende des Wegs");

   SetProp(P_INT_LONG,
     "Hier ist auf einmal alles radikal anders. Man sieht keinerlei "
     "Kristalle mehr und es gruent nur so um einen herum. Die Dornenhecke "
     "und Baeume gibt es im Westen allerdings immer noch. Nach Osten hast Du "
     "freien Blick auf die im Hintergrund gelegenen Berge. Lichtreflektionen "
     "siehst Du hier keine mehr, dafuer wirst Du aber mit der Herrlichkeit "
     "dieser Gegend auch reichlich entschaedigt.");
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_FOREST]) );
   SetProp(P_INDOORS, 0);

   AddDetail( ({"blick", "osten"}),
     "Da sieht man die Berge aufragen.");

   AddDetail( ({"hintergrund", "berge"}),
     "Majestaetisch ragen sie in der Ferne mit ihren schneebedeckten Gipfeln "
     "in den Himmel.");

   AddDetail( ({"ferne"}),
     "Die Ferne ist sehr weit entfernt. :)");

   AddDetail( ({"gipfel"}),
     "Die sind vom Schnee bedeckt, welche im Sonnenlicht funkeln und "
     "glitzern.");

   AddDetail( ({"schnee", "flocken"}),
     "Das sind die weissen Flocken die im Winter vom Himmel faellen.");

   AddDetail( ({"winter", "fruehling", "sommer", "herbst"}),
     "Ist eine der Jahreszeiten: Fruehling, Sommer, Herbst und Winter.");

   AddDetail( ({"jahreszeit", "jahreszeiten"}),
     "Davon gibt es vier."); 

   AddDetail( ({"natur", "stellen"}),
     "Hier ist es deutlich zu sehen, dass die Natur immer einen Weg findet sich"
     " ihr Gebiet zurueckzuholen. Man sieht nur mehr Kristallgruppierungen an "
     "manchen Stellen und die sind auch nicht mehr allzu gross.");

   AddDetail( ({"gebiet"}),
     "Das ist hier der (frueher kristalline) Kristallwald.");

   AddDetail( ({"weg", "waldweg", "boden"}),
     "Der Boden ist hier mit einer Schicht ueberzogen die sich im Allgemeinen "
     "Erde nennt.");

   AddDetail( ({"hinsehen"}),
     "Du untersuchst aber auch alles.");

   AddDetail( ({"allgemein", "allgemeinen"}),
     "Naja was im Allgemeinen heisst, wirst Du doch nicht im Detail wissen "
     "wollen?");

   AddDetail( ({"detail"}),
     "Das untersuchst Du gerade.");

   AddDetail( ({"erde", "schicht"}),
     "Broeselig und braun, so wie Erde nun mal ist.");

   AddDetail( ({"kristall", "kristalle", "kristallen"}),
     "Gibt es hier nicht mehr, auch wenn die Gegend immer noch Kristallwald "
     "heisst.");

   AddDetail( ({"wald", "kristallwald"}),
     "Er besteht im Westen immer noch aus Dornenhecken und Baeumen, aber im "
     "Osten sind keine mehr zu sehen.");

   AddDetail( ({"dornenhecken", "dornenhecke", "hecke", "hecken"}),
     "Es ist eine verfilzte Hecke mit "
     "vielen spitzen Dornen auf ihren Zweigen. Im Westen waechst sie "
     "bedrohlich hoch zwischen den Baeumen.");

   AddDetail( ({"suedweste", "westen", "nordwesten", "norden"}),
     "Da waechst die Hecke besonders hoch.");

   AddDetail( ({"dornen"}),
     "Die sind ganz schoen spitz. Pass lieber auf und greif sie nicht an.");

   AddDetail( ({"zweige"}),
     "Die kannst Du sicher biegen wie Du willst, abbrechen werden die hier "
     "nicht mehr.");

   AddDetail( ({"beruehrungen", "art", "biegen"}),
     "Naja, Biegen und so halt.");

   AddDetail( ({"baeume"}),
     "Sie sehen aus wie ganz normale Baeume, und man entdeckt kein bisschen "
     "Kristall mehr ihnen, weder am Stamm, den Aesten oder den Blaettern.");

   AddDetail( ({"stamm"}),
     "Der ist so dick, den koenntest nicht mal Du umfassen.");

   AddDetail( ({"blaetter", "ast", "aeste"}),
     "Sie sind hier ganz und gar ohne Kristallschicht.");

   AddDetail( ({"himmel"}),
     "Es strahlt wieder die Sonne herunter.");

   AddDetail( ({"sonne"}),
     "Wie fast ueberall sonst auch, scheint sie dir froehlich vom Himmel "
     "entgegen und waermt dich.");

   AddDetail( ({"waerme"}),
     "Die kannst Du auf Deiner Haut sogar richtig spueren.");

   AddDetail( ({"haut"}),
     "Da spuerst Du die Waerme. (Oder hast Du hier etwas anderes erwartet?) "
     ":)");

//Hier jetzt Gerueche und Geraeusche:
   AddSound( ({DEFAULT_SOUND, "baeume", "unterholz"}), 
     "Hier wird es immer lauter. Man hoert mehr und mehr Voegel irgendwo aus "
     "den Baeumen heraus zwitschern oder Insekten durchs Unterholz rascheln.");

   AddDetail( ({"voegel", "vogel"}),
     "Siehst Du hier nicht, aber hoeren kann man das Gezwitscher.");

   AddDetail( ({"unterholz"}),
     "Das liegt unter den Hecken und Baeumen. Ansonsten waers ja kein "
     "Unterholz.");

   AddSound( ({"gezwitscher", "vogel", "voegel"}),
     "Zwitsch, Zwitsch, Tirili, Tirila ...");

   AddDetail( ({"insekt", "insekten"}),
     "Siehst Du hier nicht, aber hoeren kann man es.");

   AddSound( ({"krabbeln", "insekt", "insekten"}),
     "Kribbel, krabbel, kratz, kratz, schab, schab ...");

   AddSmell( ({DEFAULT_SMELL,"natur","luft"}), 
     "Du holst tief Luft und riechst die Natur. Naja riecht ein bisschen "
     "staubig.");

   AddSmell( ({"staub", "natur"}),
     "Riecht staubig.");
     
   AddDetail( ({"gegend", "herrlichkeit", "tirila", "tirili", "zwitsch", 
                "sonnenlicht", "kristallschicht", "kristallgruppierungen"}),
     "Wer untersucht das?");


//Die Exits:

   AddExit("nordwesten", ROOM "raum15");
   AddExit("suedwesten", ROOM "raum13");
   
}