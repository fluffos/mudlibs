#include "../def.h"

inherit "std/room";

#include <properties.h>

int i;

void create()
{
  ::create();
  
  i=1;
  
   SetProp(P_INT_SHORT, "Auf einer unterspuelten Klippe");
   SetProp(P_INT_LONG,
     "Hier hat die See dem Berg schon sehr zugesetzt. Gar zwei grosse "
     "Unterspuelungen hat das heisse Wasser hier aus dem Fels herausgefressen, "
     "sodass auf der Ostseite auch ein kleiner Tuempel brodelt. "
     "Deswegen liegen hier auch fast keine Steinchen und Felsen herum, weil "
     "schon alles lockere Material weggepurzelt ist. Du siehst im Suedwesten "
     "und Suedosten nur mehr schmale brueckenaehnliche Verbindungswege zu den "
     "naechsten Abenteuern. Die Hoehlendecke ist auch hier kaum sichtbar.");
   SetProp(P_LIGHT, 0);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"hoehlendecke"}),
     "An der Decke zucken Blitze durch die Schwaden wie bei einem schweren "
     "Gewitter.");

   AddDetail( ({"gewitter"}),
     "Es ist keines.");

   AddDetail( ({"blitze","schwaden"}),
     "Die befinden sich oben an der Hoehlendecke.");

   AddDetail( ({"decke"}),
     "Verhangen und duester ist sie ueber Dir.");

   AddDetail( ({"boden"}),
     "Da liegen ueberall Felsen und Steine herum.");

   AddDetail( ({"see","tuempel"}),
     "Er besteht aus heissem, stinkenden Wasser.");

   AddDetail( ({"wasser"}),
     "Das kann Dir hier (hoffentlich) nichts anhaben.");

   AddDetail( ({"berg"}),
     "Diese Klippe war sicher auch einmal Teil des Berges, aber mittlerweile "
     "gibts es nur mehr die Fusswege ueber die Bruecken oder den Weg zurueck "
     "nach Norden hinunter.");

   AddDetail( ({"norden"}),
     "Da gehts zurueck auf den 'sicheren' Teil der Insel.");

   AddDetail( ({"ostseite"}),
     "Da gehts runter zu einem genauso gefaehrlichen kleinen See, bevor die "
     "Klippe steil nach oben ragt.");

   AddDetail( ({"klippe"}),
     "Du weisst nicht genau was da oben ist, da Du das von hier aus nicht "
     "siehst.");

   AddDetail( ({"insel","teil"}),
     "Absolut sicher kannst Du hier natuerlich nirgends wirklich sein, aber "
     "es ist ja auch nur eine Redewendung.");

   AddDetail( ({"redewendung"}),
     "Pass auf das sich nichts gegen Dich wendet.");

   AddDetail( ({"unterspuelungen","unterspuelung"}),
     "Die sind in der Form von 'Rundboegen' vorhanden.");

   AddDetail( ({"form","rundbogen","rundboegen","bogen","bogen"}),
     "   .--.\n"
     " /´    `\\\n"
     "|        |\n"
     " ~~~~~~~~ \n");

   AddDetail( ({"fels","felsen","steine","gestein"}),
     "Es ist ein nachtschwarzes Material, das entfernt an Basalt oder "
     "Obsidian erinnert.");

   AddDetail( ({"material","materialien","basalt","obsidian"}),
     "Das sieht eben wie Vulkangestein aus.");

   AddDetail( ({"vulkangestein"}),
     "Wird von einem Vulkan ausgespuckt.");

   AddDetail( ({"vulkan"}),
     "Der spuckt Vulkangestein aus.");

   AddDetail( ({"steinchen"}),
     "Wenn Du hier auf denen ausrutschst wird das schmerzhaft enden und Du "
     "wirst danach ziemlich 'aufgeloest' sein. Aber Du siehst auf den ersten "
     "Blick das hier etwas Besonderes liegt.");

   AddSpecialDetail( ({"blick", "besonderes"}), "glas");
     /*
     "Nicht auf den zweiten und dritten, auch nicht auf den vierten; NEIN auf "
     "den ersten Blick siehst Du ein Steinchen der aussieht wie ein kleiner, "
     "in Glas gegossener, linker Fuss. Leider ist er zerbrochen, so dass Du "
     "ihn nicht nehmen kannst.");

/*hier haett ich die idee, auf der ganzen insel so kleine glastotenteile zu 
verteilen mit denen man sich irgendwie a bisserl gegen die wirkung der insel 
schuetzen kann (wahrscheinlich werdens einige am anfang brauchen wenns dort 
forschen oder nekros werden wollen und sich net auskennen noch dort ... 
anderen koennts natuerlich auch helfen, ma muss halt nur alle 7 teilen 
finden.*/
//Vorerst auf Eis gelegt
   AddDetail( ({"glas"}),
     "Sehr durchsichtig und oft schnell kaputt.");

   AddDetail( ({"fuss"}),
     "Man sieht den Oberschenkelknochen, Schienbein, Wadenbein und die "
     "Zehenknochen. Sogar die Kniescheibe kannst Du erkennen.");

   AddDetail( ({"oberschenkelknochen","schienbein","wadenbein","zehenknochen"
               ,"knochen","kniescheibe"}),
     "Hast Du sicher auch in deinem Fuss, aber versuch bloss nicht jeden bei "
     "Dir fuehlen zu wollen.");

   AddDetail( ({"suedwesten","suedosten"}),
     "Da sind die Bruecken.");

   AddDetail( ({"bruecke","bruecken","verbindungswege"}),
     "Sehen sehr schmal und wackelig aus. Ohne Gelaender zum festhalten musst "
     "Du sehr vorsichtig sein beim hinuebergehen.");

   AddDetail( ({"gelaender"}),
     "Siehst Du hier irgendwo eines?");

   AddDetail( ({"abenteuern","abenteuer"}),
     "Wer weiss, was Dich hinter den Bruecken noch alles erwartet.");
 
//Geraeusche:
   AddSound(DEFAULT_SOUND,
     "Neben dem Klatschen der Wellen an die unterspuelten Felsen, hoerst Du "
     "nur hin und wieder einen Stein oder ein Steinchen in die Fluten "
     "plumpsen.\nAusserdem hoerst Du noch das Knistern der Blitze und ein "
     "dumpfes Klopfen.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander "
     "reiben wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","pulsieren","leuchten"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"klopfen"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren des Leuchtens im Berg zu"
     " hoeren.");

   AddSound( ({"berg"}),
     "Auch wenn Du es nicht wahrhaben willst, der Berg scheint dich noch "
     "immer in irgendeiner Weise anzuziehen.");

   AddSound( ({"weise"}),
     "Eine unheimliche Weise.");

   AddSound( ({"klatschen","wellen","fluten"}),
     "Sanft und doch zerstoererisch nagen sie am Felsen.");

   AddSound( ({"felsen","felsgestein","fels","gestein"}),
     "Du lauschst am Felsgestein, hoerst aber nichts besonderes.");

   AddSound( ({"steinchen","stein"}),
     "Pluuuuuuuuuuumps. Plaaaaatsch.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Du riechst neben dem stinkenden Wasser nur aufgeloeste Felsen und "
     "Deinen Angstschweiss.");

   AddSmell( ({"wasser"}),
     "Du kannst nicht definieren, warum es so stinkt.");

   AddSmell( ({"felsen"}),
     "Tja wie riechen aufgeloeste Felsen eigentlich... . Nachdem Du das auch"
     " nicht wirklich weist, kannst Du nur spekulieren, dass sie so riechen, "
     "wie sie hier eben riechen.");

   AddSmell( ({"angstschweiss","angst","schweiss"}),
     "Ein nicht allzu unbekannter Geruch fuer Dich, da er Dir doch bei jeder "
     "Kleinigkeit ausbricht.");

   AddSmell( ({"geruch"}),
     "Dein Angstschweiss ist hier gemeint.");

   AddSmell( ({"kleinigkeit"}),
     "Die kann man nicht riechen. Dafuer ist sie zu klein. *G*");
     
   AddDetail( ({"fusswege","wege","waende","wand","nein", "weg", "fussweg", "kleiner see"}),
     "Nichts zu erkennen.");

//Die Exits:

   AddExit("nordunten", ROOM "b3_lavatuempel");
   AddExit("suedosten", ROOM "c5_klippe_am_see");
   AddExit("suedwestunten", ROOM "a5_brueckennaehe");
   
   SetProp(P_HIDE_EXITS, ({"suedwesten", "norden"}) );
   AddExit("suedwesten", ROOM "a5_brueckennaehe");
   AddExit("norden", ROOM "b3_lavatuempel");
}
string glas()
{
  string s;
  object ob;
  
  if(i)
  { 
    s = "Nicht auf den zweiten und dritten, auch nicht auf den vierten; NEIN "
     "auf den ersten Blick siehst Du ein Steinchen der aussieht wie ein "
     "kleiner, in Glas gegossener, linker Fuss. "
     "Seltsam, dass er Dir nicht vorher aufgefallen ist. Er liegt offen da.";
    ob=clone_object(OBJ "fuss_links");
    ob->move(TO, M_NOCHECK | M_SILENT);
    i=0;
    return BS(s); 
  }
  s = "Wirf den Blick spaeter nocheinmal.";
  return BS(s); 
}
void reset()
{
  if(!present("\nglas_fuss_links"))  {i=1;}
  ::reset();
}