#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  ::create();
   SetProp(P_INT_SHORT, "Ein Geroellhang unterhalb des Plateaus");
   SetProp(P_INT_LONG,
     "Du bist nun ungefaehr auf der halben Hoehe des Weges angelangt der zu der"
     " obersten Klippe hinauf bzw. zurueck zu den kleineren Klippen runter "
     "fuehrt. Ueberall liegen Felsen und Steine locker herum, die jederzeit "
     "abrutschen und Dich in einer Geroelllawine mitreissen koennten. Die "
     "wenigen verkrueppelten Baeume und Buesche die hier noch wachsen, sehen "
     "so arg mitgenommen aus, dass sie wahrscheinlich keinen weiteren "
     "Steinschlag mehr ueberstehen werden. Die Hoehlendecke ist wieder nur "
     "sporadisch zu sehen. Du kannst nach Sueden bergab gehen und nach Westen "
     "kommst Du nur ueber den Geroellhang hoch.");
   SetProp(P_LIGHT, 0);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"hoehlendecke","decke"}),
     "Die Hoehlendecke ist soweit oben und so verhangen, dass Du sie gar nicht "
     "siehst.");

   AddDetail( ({"boden"}),
     "Da liegen ueberall Felsen und Steine herum.");

   AddDetail( ({"felsen","steine","gestein","fels"}),
     "Es ist ein nachtschwarzes Material, das entfernt an Basalt oder Obsidian "
     "erinnert.");

   AddDetail( ({"material","materialien","basalt","obsidian"}),
     "Das sieht eben wie Vulkangestein aus.");

   AddDetail( ({"vulkangestein"}),
     "Wird von einem Vulkan ausgespuckt.");

   AddDetail( ({"vulkan"}),
     "Der spuckt Vulkangestein aus.");

   AddDetail( ({"hoehe"}),
     "Du bist schon sehr weit gekommen, trotzdem dauert es sicher noch etwas "
     "bis Du ganz oben bist.");

   AddDetail( ({"weg"}),
     "Du hast hier nur die Moeglichkeit nach Westen oder Sueden zu gehen, alle "
     "anderen Richtungen sind unbegehbar.");

   AddDetail( ({"sueden","westen"}),
     "Nach Sueden gehts bergab und nach Westen bergauf.");

   AddDetail( ({"nordwesten","suedwesten"}),
     "Da kannst Du von hier aus nicht hin.");
 
   AddDetail( ({"richtung","richtungen"}),
     "Es werden vier Richtungen beschrieben: Westen und Sueden, Nordwesten und "
     "Suedwesten.");

   AddDetail( ({"klippe","klippen"}),
     "Hoch ragt sie vor Dir auf, dementsprechend tief duerfte es von dort auch "
     "nach unten gehn. Im Nordwesten und Suedwesten siehst Du Lavafaelle von "
     "den Klippen hinunterstuerzen.");

   AddDetail( ({"lavafaelle","lavafall"}),
     "Der im Nordenwesten faellt runter bis auf die untersten Haenge der "
     "Insel, der im Sueden verschwindet in einer Spalte.");

   AddDetail( ({"spalte"}),
     "Siehst Du von hier aus nicht genau.");

   AddDetail( ({"insel"}),
     "Egal wie oft Du sie auch noch untersuchst, sie wird sich deswegen auch "
     "nicht veraendern.");

   AddDetail( ({"haenge","hang","geroellhang"}),
     "Ueberall liegen die Felsen und Steine lose herum, um schon beim "
     "kleinsten Fehltritt in die Tiefe zu poltern und alles rund um sich mit "
     "zu reissen.");

   AddDetail( ({"fehltritt"}),
     "Den darfst Du Dir hier nicht erlauben.");

   AddDetail( ({"tiefe"}),
     "In der Tiefe da unten liegen noch die letzten Reste der letzten "
     "Steinlawinen in dem Waeldchen, dass sich an dieser gefaehrlichen Stelle "
     "noch immer behaupten kann.");

   AddDetail( ({"stelle"}),
     "Dort unten faellt einem der Himmel oefter auf den Kopf, als es "
     "vertraeglich ist.");

   AddDetail( ({"himmel"}),
     "Den gibts hier eigentlich nicht, das war ja auch nur als Sprichwort "
     "gedacht.");

   AddDetail( ({"sprichwort"}),
     "'Der Himmel faellt uns auf den Kopf.'");

   AddDetail( ({"kopf"}),
     "Der Himmel kann Dir auch hier noch in der Form von Steinen auf den Kopf "
     "fallen, Du befindest Dich ja auch noch mitten in dem Geroellhang.");

   AddDetail( ({"form"}),
     "Die ist bei jedem Stein anders. Mal rund, mal eckig, mal oval, etc.");

   AddDetail( ({"waeldchen"}),
     "Es ist voll von diesen verkrueppelten und verdrehten Baeumen und "
     "Bueschen.");

   AddDetail( ({"baeume","baum","buesche","busch"}),
     "Genaueres kannst Du von hier aus leider nicht erkennen.");

   AddDetail( ({"reste"}),
     "Einzelne Steine und auch ein paar groessere Brocken, die sich in den "
     "Baeumen und Bueschen dort unten verspiesst haben.");

   AddDetail( ({"geroelllawine","lawine","steinschlag","lawinen",
                "steinlawinen"}),
     "Es sieht so aus, als ob das hier recht oft passieren wuerde.");

   AddDetail( ({"geroell"}),
     "Inmitten der Felsen und Steine auf dem Hang siehst Du, nicht all zu weit "
     "von Dir entfernt, jemanden stehen.");

   AddDetail( ({"jemand","jemanden"}),
     "Es scheint so, als wollte diese Person gerade den Hang hinaufgehen.");

   AddDetail( ({"person"}),
     "Du siehst die Person nur von hinten, aber Du kannst trotzdem einiges "
     "erkennen, wie die staehlern glaenzenden Arm- und Beinschienen und den "
     "Helm. Auch ein riesiges Schwert und ein Schild kannst Du von hier aus "
     "erkennen, sowie den umgehaengten Wappenrock.");

   AddDetail( ({"armschienen","beinschienen","schienen"}),
     "Sie wurden aus dem besten Stahl gefertigt und sind somit sicher sehr "
     "robust.");

   AddDetail( ({"helm"}),
     "Ein gesichtsfreier Helm der aus dem besten Stahl gefertigt wurde.");

   AddDetail( ({"stahl"}),
     "Stahl ist Eisen, das in einem speziellen Verfahren geschmiedet wurde.");

   AddDetail( ({"verfahren"}),
     "Das zu erklaeren wuerde viel zu lang dauern.");

   AddDetail( ({"eisen"}),
     "Eisen ist zwar nicht so widerstandsfaehig wie Stahl, haelt aber auch "
     "einiges aus.");

   AddDetail( ({"schwert","schwerter"}),
     "Das ist wirklich eines der groessten Schwerter, dass Du jemals gesehen "
     "hast: der Griff kann sowohl mit einer, als auch mit zwei Haende gehalten "
     "werden, die Klinge ist mindestens eineinhalb Meter lang und sicher "
     "zwanzig Zentimeter breit und die Blutrille ist mindestens daumendick. "
     "Dort wo sich Griff und Klinge treffen sind auch noch zwei ueber zehn "
     "Zentimeter lange Parierstangen zu sehen. Es ist aus einem Dir unbekannten"
     " Material angefertigt und sieht ungefaehr so aus:\n"
     "                                                           \n"
     "           /)                                              \n"
     "          //                                               \n"
     "         //__________________________________________      \n"
     "  /-----||___________________________________________\\    \n"
     "  \\-----|| __________________________________________/    \n"
     "         \\\\                                              \n"
     "          \\\\                                             \n"
     "           \\)                                             \n");

   AddDetail( ({"griff"}),
     "Sorgsam ist er mit rutschfestem Leder umwickelt worden und der Knauf am "
     "Ende ist ein kleiner Edelstein.");

   AddDetail( ({"material"}),
     "Es ist Dir, wie gesagt, unbekannt.");

   AddDetail( ({"leder"}),
     "Man sieht keinerlei Unebenheiten.");

   AddDetail( ({"unebenheiten"}),
     "Keine.");

   AddDetail( ({"knauf","edelstein"}),
     "Der sitzt so fest, den kann man nicht herunterbrechen.");

   AddDetail( ({"ende"}),
     "Das untere Ende des Griffs ist hier gemeint.");

   AddDetail( ({"haende"}),
     "Du brauchst sicher zwei davon um den Griff dieses Schwertes umklammern "
     "zu koennen. Die Person da vor Dir muss unheimlich stark sein und kann "
     "das auch mit einer. Ploetzlich ist die Person verschwunden. War das "
     "nur eine Illusion?");

   AddDetail( ({"klinge"}),
     "Die Klingen von Schwertern sind meist ziemlich scharf. Diese hier ist "
     "schaerfer. Pass bloss auf das Du nie von so etwas getroffen wirst.");

   AddDetail( ({"meter","zentimeter"}),
     "Ein Meter hat immer hundert Zentimeter, sogar hier.");

   AddDetail( ({"blutrille","rille"}),
     "Die ist dazu da, dass das Blut wieder vom Schwert herunterfliesst und "
     "nicht klebenbleibt.");

   AddDetail( ({"blut"}),
     "Die Klinge hier ist sauber, Blut kannst Du auf ihr nicht entdecken.");

   AddDetail( ({"parierstangen","parierstange","stange","stangen"}),
     "Parierstangen sind dazu da, damit die gegnerische Klinge sich verhakt "
     "und nicht ueber den Griff rutscht und einen trifft.");

   AddDetail( ({"schild","rundschild"}),
     "Ein Rundschild der mit zwei Schlaufen an einem Arm befestigt wird und "
     "auf dem ein Drache aufgemalt ist.");

   AddDetail( ({"schlaufe","schlaufen"}),
     "Durch sie wird der Unterarm gesteckt, damit man das Schild halten kann.");

   AddDetail( ({"arm","unterarm"}),
     "Um so einen Schild lange halten zu koennen, muss der schon kraeftig "
     "sein, nicht so mickrig wie der Deine.");

   AddDetail( ({"drache"}),
     "Sieht furchterregend aus.");

   AddDetail( ({"wappenrock","mantel"}),
     "Er ist sehr schlicht gehalten, ein einfacher roter Mantel mit einem "
     "Kreuz darauf. Er weist seinen Traeger als Mitglied der Paladingilde "
     "aus.");

   AddDetail( ({"kreuz"}),
     "  \\----/       \n"
     "|\\ \\__/ /|    \n"
     "| >|__|< |      \n"
     "|/ /  \\ \\|    \n"
     "  /----\\       \n");

   AddDetail( ({"mitglied"}),
     "Naja, manchmal auch ohne ... ;)");

   AddDetail( ({"traeger"}),
     "Die Person da vor Dir beispielsweise.");

   AddDetail( ({"paladin","paladingilde","gilde","paladine"}),
     "Hoch im Gebirge fuehren sie von ihrer Burg, gefuehrt von ihrem "
     "Gildenoberhaupt, aus den Kampf gegen das Boese.");

   AddDetail( ({"gildenoberhaupt","oberhaupt"}),
     "Ayla von Schattengrund. Sie erklaert Dir sicher einiges ueber Gut und "
     "Boese.");

   AddDetail( ({"ayla","schattengrund"}),
     "Sie fuehrt die Paladine an.");

   AddDetail( ({"gebirge"}),
     "Das ist ziemlich weit weg von hier.");

   AddDetail( ({"burg","zentrum"}),
     "Sie ist das Zentrum des Guten hier in dieser Welt.");

   AddDetail( ({"gut","gutes","guten"}),
     "Die Paladine sind die Guten, so einfach ist das.");

   AddDetail( ({"kampf","boese","boeses"}),
     "Die Paladine werden hier auf der Insel wohl viel Boeses zu bekaempfen "
     "haben.");

   AddDetail( ({"baeume","buesche"}),
     "Sie sind schon derart verkrueppelt und geknickt, das sie sich teilweise "
     "nicht mal mehr mit dem Wurzeln halten koennen und schon mitten im Kippen "
     "begriffen sind.");

   AddDetail( ({"wurzeln"}),
     "Die finden hier auf diesem unwirtlichen Fleck des Silberlands kaum "
     "Naehrstoffe.");

   AddDetail( ({"fleck"}),
     "Die Insel, was sonst?");

   AddDetail( ({"silberland","welt"}),
     "Wenn Du bist jetzt noch nicht weist, dass Du im Silberland, weist Du es "
     "jetzt.");

   AddDetail( ({"stoff","stoffe"}),
     "Stoff? Wo siehst Du hier Stoff?");

   AddDetail( ({"naehrstoffe","naehrstoff"}),
     "Die finden sich auf diesen leblosen Felsen kaum, sodass hier kaum etwas "
     "waechst.");

//Geraeusche:
   AddSound(DEFAULT_SOUND,
     "Ausser dem Herabfallen einiger Steine und dem darauffolgenden dumpfen "
     "Aufschlag in der Tiefe, ist hier kaum etwas zu hoeren.");

   AddSound( ({"geraeusch"}),
     "*Holterdipolter*Roll*Kuller*Huepf*");

   AddSound( ({"aufschlag"}),
     "*AAAAAAAAH*PLUUUUMPS*KRACH*");

   AddSound( ({"tiefe"}),
     "Sie ist zu weit unten, um an ihr zu lauschen.");

   AddSound( ({"stein","steine"}),
    "Die Steine kullern zu schnell an Dir vorbei, so dass Du nicht wirklich "
    "daran lauschen kannst.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Eigentlich riechst Du hier nichts ausser Deinem eigenen Geruch.");

   AddSmell( ({"geruch"}),
     "Du solltest Dich schleunigst wieder mal waschen, so wie Du stinkst.");
     
   AddDetail( ({"aaaaaaaah", "brocken", "herabfallen", "holterdipolter", 
                "huepf", "krach", "kuller", "moeglichkeit", "nordenwesten", 
                "pluuuumps", "roll", "waende", "wand"}),
     "Sehr fleissig, immer schoen forschen :-)");
   
   AddDetail( ({"illusion"}),
     "Hast Du Dich auch nicht getauescht? Schnell hinterher!");


//Die Exits:
   AddExit("sueden", ROOM "g4_lavafall_mit_riss");
   AddExit("westoben", ROOM "f3_kraterrand");
   
   SetProp(P_HIDE_EXITS, ({"westen"}) );
   AddExit("westen", ROOM "f3_kraterrand");
}