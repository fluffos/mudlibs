#include "../def.h"

inherit "std/room";

#include <properties.h>

string damage(string str);

void create()
{
  ::create();
   SetProp(P_INT_SHORT, "Bergab Richtung See");
   SetProp(P_INT_LONG,
     "Der Hang fuehrt hier weiter bergab (oder bergauf, je nach Sichtweise) "
     "Richtung See bzw. Insel. Du kannst von hier aus auch die flache, dem "
     "See schon gefaehrlich nahe kommende, Halbinsel im Osten erkennen. "
     "Ausser den beiden Statuen gibt es hier auch eigentlich nicht viel zu "
     "sehen.");
   SetProp(P_LIGHT, 0);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"sichtweise"}),
     "Jeder hat eine andere.");

   AddDetail( ({"hoehlendecke"}),
     "Die Decke ist so verhangen das Du sie von hier gar nicht siehst. "
     "Ausserdem solltest Du nicht nach oben schauen, sondern lieber auf den "
     "Boden und den See da vor Dir achten.");

   AddDetail( ({"decke"}),
     "Hoch ueber Dir.");

   AddDetail( ({"boden"}),
     "Da liegen ueberall Felsen und Steine herum.");

   AddDetail( ({"hang"}),
     "Mehr als diesen Hang siehst Du im Moment nicht vor Dir, die Insel ist "
     "schon ein Stueck weiter weg. Aber Du wirst sie von hier aus nicht "
     "erreichen, da sie durch einen kleinen Kanal im Osten von hier "
     "abgeschnitten ist. Da musst Du Dir wohl einen anderen Weg suchen.");

   AddDetail( ({"kanal"}),
     "Der ist ganz schoen breit, Du kannst da sicher nicht hinueber "
     "springen." );

   AddDetail( ({"moment"}),
     "Schon vorbei.");

   AddDetail( ({"insel"}),
     "Es ist immer noch die selbe Insel wie vorhin.");

   AddDetail( ({"felsen","fels","steine","gestein"}),
     "Es ist ein nachtschwarzes Material, das entfernt an Basalt oder Obsidian"
     " erinnert.");

   AddDetail( ({"material","materialien","basalt","obsidian"}),
     "Das sieht eben wie Vulkangestein aus.");

   AddDetail( ({"vulkangestein"}),
     "Wird von einem Vulkan ausgespuckt.");

   AddDetail( ({"vulkan"}),
     "Der spuckt Vulkangestein aus.");

   AddDetail( ({"richtung"}),
     "Hier gehts nur nach Nordwesten zurueck. Nach Osten kommst Du sicher nicht"
     " trockenen und unverletzten Fusses.");

   AddDetail( ({"fuss","fusses"}),
     "Davon hast Du zwei.");

   AddDetail( ({"osten","nordwesten"}),
     "In eine Richtung wuerde es zu der umspuelten Halbinsel gehen, wenn da der"
     " Kanal nicht waere, in die andere zurueck zur grossen Insel.");

   AddDetail( ({"halbinsel"}),
     "Geh doch mal hin und sieh sie Dir an wenn Du Dich traust.");

   AddDetail( ({"see"}),
     "Voll mit heissem, stinkenden Wasser.");

   AddDetail( ({"wasser"}),
     "Das kann Dir hier noch nichts anhaben.");

   AddDetail( ({"ende","weg"}),
     "Jedes Ende ist auch ein neuer Anfang. Hier hoert der Weg auf bzw. "
     "faengt an. Je nach Sichtweise.");

   AddDetail( ({"anfang"}),
     "Das kommt immer auf die Sichtweise an.");

   AddDetail( ({"sichtweise"}),
     "Die ist bei jedem anders.");

   AddDetail( ({"statuen"}),
     "Ein Zwerg und ein Hobbit (anscheinend zwei gute Saufkumpanen) stehen "
     "hier, an den Ellenbogen in einander eingehakt, je einen Bierkrug durch "
     "die Luft schwenkend.");
/*hier hab ich 2 rassen genommen da sich das ganze mit den rassen+gilden sonst 
nimmer ausgegangen waere (hoffentlich sinds  die 2 am ehesten passenden :) )*/

   AddDetail( ({"zwerg"}),
     "Da steht er in seiner zwergischen Kampfausruestung, die Augen und Nase "
     "selbst in diesem Zustand noch rot vor lauter Allohool. Sieht so aus als "
     "wolle er gerade wieder ein Trinklied anstimmen. *hicks*");

   AddDetail( ({"zustand"}),
     "Der Zwerg und Hobbit sind betrunkene Statuen.");

   AddDetail( ({"kampfausruestung","ausruestung"}),
     "Kettenzeugs, Kettenhemd, Lederstiefel, zwergische Hose und Kampfaxt, "
     "alles natuerlich rostfrei aus dem besten Zwergenstahl von den besten "
     "Zwergenschmieden hergestellt bzw. das Leder von den besten Naehern "
     "vernaeht und Schustern verschustert.");

   AddDetail( ({"kettenzeugs","zeugs","kettenhemd","hemd","hose","kampfaxt"
               ,"axt"}),
     "Findet man alles in und um Felonia herum.");

   AddDetail( ({"stiefel","lederstiefel"}),
     "Findet man in jedem Laden.");

   AddDetail( ({"laden"}),
     "Gibts in jeder Stadt.");

   AddDetail( ({"stadt","staedte"}),
     "Kyranda, Felonia und Derlim sind Staedte.");

   AddDetail( ({"zwergenstahl","stahl"}),
     "Wird im Bergwerk abgebaut.");

   AddDetail( ({"leder"}),
     "Das kommt sicher von einer Kuhhaut.");

   AddDetail( ({"kuhhaut","haut"}),
     "Die geht auf keine Kuh mehr. ;) ");

   AddDetail( ({"schmiede","zwergenschmiede"}),
     "Da findest Du sicher einige davon im Gebirge.");

   AddDetail( ({"schuster"}),
     "Jetzt wo Du Dich dafuer interessierst, bemerkst Du auf einmal, dass Du "
     "noch nie irgendwo einen Schuster gesehen hast.");

   AddDetail( ({"felonia","gebirge","zwerge"}),
     "In Felonia ist die zwergische Heimat.");

   AddDetail( ({"heimat"}),
     "Sie liegt in der Naehe des Bergwerks.");

   AddDetail( ({"naehe"}),
     "Nicht weit weg davon.");

   AddDetail( ({"bergwerk"}),
     "Das liegt im Gebirge.");

   AddDetail( ({"nase","augen","auge"}),
     "Feuerrot leuchten sie Dir entgegen.");

   AddDetail( ({"allohool"}),
     "'Allohool macht Bierne hohl, wenn Pirne hohl, dann mehr Platsss fuer "
     "Allohool.' PROSCHT. <Hicks>!");

   AddDetail( ({"trinklied"}),
     "'Es wiiiiiiiiird der Wein sein, und wir werd'n nimmer sein...'; "
     "wie wahr, wie wahr.");

   AddDetail( ({"hobbit"}),
     "Da steht er in seiner Hobbitruestung, und er sieht um keinen Deut "
     "besser aus als sein Kumpan, der Zwerg.");

   AddDetail( ({"deut"}),
     "Anders gesagt: genauso besoffen.");

   AddDetail( ({"hobbitruestung"}),
     "Bei ihm ist fast alles aus Messing angefangen vom Helm, Ruestung, "
     "Armschienen, Beinschienen bis hin zum Schild. Nur der Kampfstab und die "
     "Stiefel sind aus anderem Materialien.");

   AddDetail( ({"messing"}),
     "Messing ist das Metall das die Hobbits am liebsten tragen.");

   AddDetail( ({"metall"}),
     "Metall bekommt man hier nur von den Zwergen.");

   AddDetail( ({"hobbits"}),
     "Sie leben in Derlim.");

   AddDetail( ({"kampfstab","stab"}),
     "Der ist aus Holz.");

   AddDetail( ({"holz"}),
     "Das waechst auf Baeumen.");

   AddDetail( ({"baeume"}),
     "Die bestehen aus Holz. Hier siehst Du aber keine.");

   AddDetail( ({"materialien","material"}),
     "Die Stiefel sind aus Leder und der Kampfstab aus Holz.");

   AddDetail( ({"helm","ruestung","armschienen","beinschienen","schild"}),
     "Anscheinend gerade bequem genug fuer Hobbits.");

   AddDetail( ({"saufkumpane","kumpane","saufkumpanen","kumpan"}),
     "Sie duerften, unabhaengig von ihrer normalen Betrunkenheit, wohl zu "
     "den Zechprellern gehoeren.");

   AddDetail( ({"betrunkenheit"}),
     "Da Du ja Antialkoholiker bist, weisst Du natuerlich nicht was das fuer "
     "ein Zustand ist.");

   AddDetail( ({"antialkoholiker"}),
     "Du brauchst doch nur die Luft hier zu riechen, um zu wissen, das die "
     "zwei nicht zu diesen gehoeren.");

   AddDetail( ({"zechpreller"}),
     "Das sind keine Antialkoholiker, sondern echte Schluckspechte und "
     "Trinker.");

   AddDetail( ({"schluckspechte","trinker"}),
     "Sie haben ihr Hauptquartier bei Zechus Prellus in der Stadt Kyranda.");

   AddDetail( ({"hauptquartier","quartier"}),
     "Da saufen sie alle anderen unter den Tisch.");

   AddDetail( ({"tisch"}),
     "Mehr als einer steht dort eh nicht rum.");

   AddDetail( ({"zechus","prellus"}),
     "Der vernichtet ein ganze Fass Rum auf einmal.");

   AddDetail( ({"fass","rum"}),
     "Sieh Dich ein bisschen bei ihm um, dann wirst Du schon welche dort "
     "liegen sehn.");

   AddDetail( ({"ellenbogen"}),
     "Wie ein verliebtes Paar kommen die beiden daher.");

   AddDetail( ({"paar"}),
     "Was sie natuerlich nicht sind.");

   AddDetail( ({"bierkrug","krug", "bier"}),
     "Der vom Zwerg ist sogar noch halbvoll, der vom Hobbit leider schon "
     "halbleer.");

   AddDetail( ({"luft"}),
     "Sie ist nicht sichtbar und daher schlecht zu untersuchen.");

/*hier bitte auch irgendwo was fieses einbauen, eventuell ein alkoholangriff 
oder sowas :)*/
//Erledigt

//Gerueche:

   AddSmell(DEFAULT_SMELL,
     "Boah, selbst jetzt sondern die beiden noch eine Fahne aus ihren "
     "Muendern ab die Dich fast aus den Socken haut. Du wirst fast benebelt "
     "von diesem Geruch. Da Alkohol ja sterilisiert riechst Du trotz der "
     "Naehe zum See nichts mehr.");

   AddSmell( ({"fahne","geruch","alkoholfahne"}),
     "Die Fahne weht Dir fast unertraeglich entgegen.");

   AddSmell( ({"socken"}), #'damage);

   AddSmell( ({"alkohol"}),
     "Du riechst nur hochprozentiges wie Schnaps, Rum und "
     "Desinfektionsalkohol.");

   AddSmell( ({"schnaps","rum"}),
     "Waeh.");

   AddSmell( ({"desinfektionsalkohol"}),
     "Dein Geruchssinn hat sich soeben schlafen gelegt.");
 
   AddSmell( ({"geruchssinn","sinn"}),
     "Du riechst nichts mehr.");

   AddSmell( ({"muender","mund","naehe"}),
     "Nein, naeher willst Du da nicht hingehn und riechen.");

//Geraeusche:

   AddSound(DEFAULT_SOUND,
     "Viel kannst Du hier nicht hoeren: das Plaetschern des Sees, ein leises "
     "Gluckern und hin und wieder ein leises Ruelpsen. Weiter nimmst Du ein "
     "Knistern der Blitze und wahr.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander reiben "
     "wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","pulsieren","leuchten"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"klopfen"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren des Leuchtens im "
     "Berg zu hoeren.");

   AddSound( ({"berg"}),
     "Auch wenn Du es nicht wahrhaben willst, der Berg scheint dich noch "
     "immer in irgendeiner Weise anzuziehen.");

   AddSound( ({"weise"}),
     "Eine unheimliche Weise.");

   AddSound( ({"plaetschern","see"}),
     "Plitsch, Platsch.");

   AddSound( ({"gluckern"}),
     "Es kommt aus der Richtung der beiden Bierkruege.");

   AddSound( ({"richtung"}),
     "Du lauscht in jede Richtung und hoerst nur das Plaetschern, das "
     "Gluckern und das Ruelpsen.");

   AddSound( ({"bierkruege","kruege"}),
     "Tatsaechlich ist da noch etwas Bier drinnen.");

   AddSound( ({"bier"}),
     "Es gluckert leise vor sich hin.");

   AddSound( ({"ruelpsen"}),
     "*booooooooooeeeerp*");
     
   AddDetail( ({"bierne", "derlim", "kuh", "kyranda", "naehern", "pirne", 
                "platsch", "platsss", "stueck", "waende", "wand", "wein",
                "naeher"}),
     "Findest Du hier nirgends.");

//Die Exits:

   AddExit("nordwesten", ROOM "a5_brueckennaehe");
}

damage(string str)
{
  string s;
  s = "Du riechst an Deinen Socken und wenn Dich die Alkoholfahne noch nicht "
     "umgehauen hat, dann das jetzt.";
  TP->AddHp(-5);
  return BS(s);
}