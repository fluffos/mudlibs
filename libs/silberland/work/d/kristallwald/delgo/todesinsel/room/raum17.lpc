#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  ::create();
   SetProp(P_INT_SHORT, "Auf einem hellen Weg");

   SetProp(P_INT_LONG,
     "Das Funkeln und Glitzern des Weges auf dem du dich gerade befindest, "
     "laesst merklich nach je weiter Du in die oestliche bzw. es wird immer "
     "staerker je weiter Du in westliche Richtung gehst. Hier ist es gruener "
     "als im Westen und trotzdem noch kristalliner als im Osten. Auch hier "
     "begrenzen noch viele Dornenhecken und Baeume den Weg. Ausserdem siehst "
     "Du hier mehr Pflanzen als sonst irgendwo in dieser Gegend. Von den "
     "meisten Seiten wird das Licht noch einigermassen reflektiert und es "
     "entsteht, wenn du im richtigen Winkel hinsiehst, ein zwar nicht mehr "
     "beeindruckendes, aber doch schoenes Farbenspiel.");
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_FOREST]) );
   SetProp(P_INDOORS, 0);

   AddDetail( ({"weg", "waldweg", "boden"}),
     "Der Boden ist hier ziemlich ungleichmaessig mit einer duennen "
     "Kristallschicht und Erde ueberzogen.");

   AddDetail( ({"erde"}),
     "Broeselig und braun, so wie Erde nun mal ist.");

   AddDetail( ({"schicht", "kristallschicht", "kristall", "kristalle", 
                "kristallen"}),
     "Wenn es nicht Kristall waere, waere hier doch nicht der Kristallwald, "
     "oder?");

   AddDetail( ({"wald", "kristallwald"}),
     "Er besteht hier aus vielen Dornenhecken, Baeumen und unheimlich vielen "
     "sonstigen Pflanzen.");

   AddDetail( ({"pflanzen"}),
     "Sehr stark konzentrieren sich die Pflanzen hier auf den noerdlichen "
     "Teil. Du siehst auch nicht so viele Hecken und Baeume dort. Als Du sie "
     "eine Weile genauer betrachtest faellt Dir auf das sie eigentlich einen "
     "Begrenzungswall aus Erde verstecken sollen.");

   AddDetail( ({"teil", "teile", "teilen"}),
     "Ein Teil ist ein Stueck eines Ganzen.");

   AddDetail( ({"stueck", "stuecke", "stuecken"}),
     "Ein Stueck ist ein Teil eines Ganzen.");

   AddDetail( ({"ganzen", "ganzes", "ganz"}),
     "Ein Ganzes besteht aus vielen Stuecken und Teilen.");

   AddDetail( ({"wall", "begrenzung", "begrenzungswall", "huegel"}),
     "Ein kleiner, mit Erde aufgeschuetteter Huegel.");

   AddDetail( ({"funkeln", "glitzern"}),
     "Die Kristallschicht erzeugt das.");

   AddDetail( ({"licht", "sonnenlicht"}),
     "Auch hier wird das Sonnenlicht von den Kristallen reflektiert und "
     "verstaerkt, aber laengst nicht in den Ausmassen des westlichen Teils "
     "dieses Wegs.");

   AddDetail( ({"westen"}),
     "Geh zurueck und sieh es Dir doch an.");

   AddDetail( ({"winkel"}),
     "Du weisst ja mittlerweile wie man sich hinstellen muss und auf einmal "
     "kannst du das Farbenspiel in seiner ganzen Pracht erkennen, die aber im "
     "westlichen Teil noch um einiges schoener gewirkt hat.");

   AddDetail( ({"farben", "farbenspiel", "pracht", "regenbogen"}),
     "Du siehst saemtlich Farben des Regenbogens.");

   AddDetail( ({"dornenhecken", "dornenhecke", "hecke", "hecken"}),
     "Es ist eine teilweise mit Kristallen ueberzogene, verfilzte Hecke mit "
     "vielen spitzen Dornen auf ihren Zweigen. Im Sueden, Suedwesten und "
     "Suedosten waechst sie bedrohlich hoch zwischen den Baeumen.");

   AddDetail( ({"sueden", "suedosten", "suedwesten"}),
     "Da waechst die Hecke besonders hoch.");

   AddDetail( ({"dornen"}),
     "Die sind ganz schoen spitz. Pass lieber auf und greif sie nicht an.");

   AddDetail( ({"zweige"}),
     "Frueher waren die sicher einmal sehr leicht zu biegen, und diese hier "
     "halten das sogar aus, auch wenn sie trotzdem noch ziemlich zerbrechlich "
     "aussehen.");

   AddDetail( ({"beruehrungen", "art", "biegen"}),
     "Naja, Biegen und so halt.");

   AddDetail( ({"baeume"}),
     "Sie sehen aus wie alle anderen Baeume im Kristallwald, naemlich "
     "kristallin. Alles ist von einer Kristallschicht ueberzogen: der Stamm "
     "mit der Rinde, die Aeste und auch die Blaetter.");

   AddDetail( ({"stamm"}),
     "Der ist so dick den koenntest nicht mal Du umfassen.");

   AddDetail( ({"rinde", "aeste", "blaetter"}),
     "Kristallin, aber nur mehr zur Haelfte.");

   AddDetail( ({"Haelfte"}),
     "Hast wohl in Mathematik nicht aufgepasst, was das ist.");

   AddDetail( ({"mathematik"}),
     "Da haettest Du besser aufpassen sollen, dann wuesstest Du jetzt was eine"
     " Haelfte ist.");

   AddDetail( ({"blick", "himmel"}),
     "Du hast hier ziemlich freien Blick auf den Himmel, wo Dir ein paar Wolken"
     " und die Sonne erwaermend entgegenstrahlen.");

   AddDetail( ({"wolke", "wolken"}),
     "Sehen aus wie Schaefchenwolken.");

   AddDetail( ({"schaefchenwolken", "schafe"}),
     "Wie Schafe aussehen wirst Du doch wohl wissen.");

   AddDetail( ({"sonne"}),
     "Wie fast ueberall sonst auch, scheint sie dir froehlich vom Himmel "
     "entgegen und waermt dich.");

   AddDetail( ({"waerme"}),
     "Die kannst Du auf Deiner Haut sogar richtig spueren.");

   AddDetail( ({"haut"}),
     "Da spuerst Du die Waerme. (Oder hast Du hier etwas anderes erwartet?)"
     " :)");

//Hier jetzt Gerueche und Geraeusche:
   AddSound( ({DEFAULT_SOUND, "baeume", "unterholz"}),
     "Hier wird es immer lauter. Man hoert mehr und mehr Voegel irgendwo aus "
     "den Baeumen heraus zwitschern oder Insekten durchs Unterholz rascheln.");

   AddDetail( ({"voegel", "vogel"}),
     "Siehst Du hier nicht, aber hoeren kann man das Gezwitscher.");

   AddDetail( ({"unterholz"}),
     "Das liegt unter den Hecken und Baeumen. Ansonsten waers ja kein "
     "Unterholz.");

   AddSound( ({"gezwitscher", "vogel", "voegel"}),
     "Zwitsch, Zwitsch, Tirili, Tirila ...");

   AddDetail( ({"insekt", "insekten"}),
     "Siehst Du hier nicht, aber hoeren kann man es.");

   AddSound( ({"krabbeln", "insekt", "insekten"}),
     "Kribbel, krabbel, kratz, kratz, schab, schab ...");

   AddSmell( ({DEFAULT_SMELL,"natur","luft"}), 
     "Du holst durch Deine Nase tief Luft, und kannst schon mehr Natur riechen "
     "neben dem Geruch der Kristalle hier.");

   AddDetail( ({"nase"}),
     "Das ist das Ding im Gesicht das man nur sieht wenn man schielt.");

   AddDetail( ({"gesicht"}),
     "Das siehst Du nur im Spiegel.");

   AddDetail( ({"spiegel"}),
     "Den gibts hier nicht.");

   AddSmell( ({"kristall", "kristalle","kristallstaub"}),
     "Da es hier genau soviel Kristallstaub wie normalen Staub gibt, kannst Du"
     " gefahrlos durchatmen.");

   AddSmell( ({"staub"}),
     "Riecht staubig.");
   
   AddDetail( ({"ding", "seiten", "sie", "tirila", "tirili", "zwitsch", 
                "weile", "ausmassen", "gegend"}),
     "Wer untersucht das?");


//Die Exits:

   AddExit("westen", ROOM "raum18");
   AddExit("osten",  ROOM "raum16");
}