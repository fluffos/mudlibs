#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  ::create();
  
   SetProp(P_INT_SHORT, "Am Ende des Stegs");
   SetProp(P_INT_LONG,
     "Du stehst jetzt am Ende des Stegs und je naeher Du dem Berg kommst, desto "
     "duesterer wirkt die ganze Gegend auf Dich. Die Wellen schlagen noch immer"
     " unvermindert stark an den Steg und auch das unheimliche Leuchten laesst "
     "den Berg nur noch bedrohender erscheinen. "
     "Ueber Dir an der Hoehlendecke zucken weiter Blitze durch die "
     "Dampfschwaden, und Du siehst den Weg nun genau, der steil auf das obere "
     "Ende des Berges zufuehrt.");
   SetProp(P_LIGHT, 0);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"hoehlendecke","decke"}),
     "Die Decke ist dunkel und verhangen weit ueber Dir.");

   AddDetail( ({"ende","anfang"}),
     "Jedes Ende ist ein Anfang, sowie jeder Anfang auch ein Ende sein kann. "
     "Vielleicht lauert ja Dein Ende hier oder sollte es doch ein neuer Anfang "
     "sein?");

   AddDetail( ({"steg","boden"}),
     "Noch immer fragst Du Dich aus welchem Material der Steg denn ueberhaupt "
     "besteht, aber das wirst Du vermutlich in diesem Leben nicht mehr "
     "herausfinden. Etwas weiter im Sueden siehst Du einen Hang aus "
     "Felsbloecken und kleineren Steinen.");

   AddDetail( ({"material"}),
     "Das findest auch jetzt nicht heraus.");

   AddDetail( ({"leben"}),
     "Sei vorsichtig, es koennte hier schnell enden.");

   AddDetail( ({"sueden","hang"}),
     "Den siehst Du Dir am besten gleich naeher an.");

   AddDetail( ({"felsbloecke","fels","steine"}),
     "Die sind sicher von den Klippen runtergefallen die sich am Berg im Laufe "
     "der Zeit gebildet haben.");

   AddDetail( ({"klippen","klippe"}),
     "Hoch ragen sie hinauf, dementsprechend tief duerfte es von dort auch "
     "nach unten gehn.");

   AddDetail( ({"berg"}),
     "So nennt man diese Anhaeufung von Gestein normalerweise.");

   AddDetail( ({"gestein"}),
     "Hier war es vermutlich ein Vulkan der Lava, oder auch Magma genannt, "
     "gespuckt hat.");

   AddDetail( ({"anhaeufung"}),
     "Berg.");

   AddDetail( ({"vulkan"}),
     "Nun ja, vielleicht war das hier frueher wirklich ein unterirdischer "
     "Vulkan, denn das wuerde vielleicht auch das rote Leuchten, wie von "
     "geschmolzenem Gestein, erklaeren.");

   AddDetail( ({"gestein"}),
     "Lava oder auch Magma genannt.");

   AddDetail( ({"lava","magma"}),
     "Geschmolzenes Gestein.");

   AddDetail( ({"gegend"}),
     "Eine von See umschlossene Insel mit einem unheimlich leuchtenden Berg.");

   AddDetail( ({"insel"}),
     "Insel: Eine, von einem Gewaesser vollkommen umschlossene, Formation.");

   AddDetail( ({"gewaesser"}),
     "Das ist hier die See.");

   AddDetail( ({"see"}),
     "Den siehst Du von hier aus nicht.");

   AddDetail( ({"formation"}),
     "Die Insel.");

   AddDetail( ({"aehnlichkeit","vulkan","ueberreste"}),
     "Nun ja, vielleicht war das hier frueher wirklich ein unterirdischer "
     "Vulkan, denn das wuerde vielleicht auch das rote Leuchten, wie von "
     "geschmolzenem Gestein, erklaeren.");

   AddDetail( ({"wellen"}),
     "Die klatschen unvermindert stark gegen den Steg.");

   AddDetail( ({"blitz","blitze"}),
     "Es zucken Blitze in allen Farben durch die Dampfschwaden die da ueber Dir"
     " haengen. Seltsamerweise zucken sie alle zum Berg.");

   AddDetail( ({"farben","farbe"}),
     "In allen moeglichen Farben zucken die Blitze durch die Schwaden, manchmal"
     " wechseln sie sogar mitten im Blitz die Farbe.");

   AddDetail( ({"dampfschwaden","schwaden", "neblig"}),
     "Sie sehen aus wie Schwaden eben aussehen: Neblig und in diesem Fall "
     "ziemlich toedlich.");

   AddDetail( ({"weg"}),
     "Den siehst im Rhythmus des Leuchtens und manchmal auch wenn ein Blitz "
     "blitzt. Er fuehrt nach Sueden immer hoeher hinauf bis auf den hoechsten "
     "Punkt des Berges.");

   AddDetail( ({"punkt"}),
     "Im allgemeinen auch Gipfel genannt. Obwohl man hier doch eher von einem "
     "Hochplateau sprechen kann.");

   AddDetail( ({"gipfel"}),
     "Der hoechste Punkt eines Berges.");

   AddDetail( ({"hochplateau"}),
     "Ist hoch oben und flach.");

   AddDetail( ({"leuchten"}),
     "Ein pulsierendes rotes Licht wie von einem schlagenden Herzen. Echt "
     "unheimlich, Du kannst sogar einige rote 'Adern' sehen, die sich den Berg "
     "herunterwinden.");

   AddDetail( ({"licht"}),
     "Blutrot und doch von einer Kaelte wie sie nur der Tod verbreiten kann.");

   AddDetail( ({"kaelte"}),
     "Physisch kannst Du sie nicht spueren, aber Dein Gefuehl sagt Dir das es "
     "keine normale Kaelte ist.");

   AddDetail( ({"gefuehl"}),
     "Das kannst Du nicht untersuchen, das hast Du nur.");

   AddDetail( ({"tod"}),
     "Den lernst Du hier sicher noch kennen.");

   AddDetail( ({"herz","herzen"}),
     "Wie auch ein lebendes Organ hat auch dieses hier einen bestimmten "
     "Rhythmus mit dem es schlaegt.");

   AddDetail( ({"organ"}),
     "Das Herz. Oder vergisst Du so schnell um was es hier geht?");

   AddDetail( ({"rhythmus"}),
     "Bumm ... BummBumm ... Bumm ... BummBumm ........");

//Geraeusche:
   AddSound(DEFAULT_SOUND,
     "Neben den Wellen und dem Knistern der Blitze kannst Du auch ein "
     "dumpfes Bumpern wahrnehmen.");

   AddSound( ({"wellen"}),
     "Ziemlich laut, aber man kann sich hier schon verstaendigen.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander reiben "
     "wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","pulsieren","leuchten"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"bumpern"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren des Leuchtens im Berg "
     "zu hoeren.");

   AddSound( ({"berg"}),
     "Der Berg scheint dich in irgendeiner Weise anzuziehen.");

   AddSound( ({"weise"}),
     "Eine unheimliche Weise.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "In fast allen Richtungen, ausser im Sueden, riecht es nach eigentlich "
     "nach nichts.");

   AddSmell( ({"richtung","sueden"}),
     "Das kannst Du nicht riechen, nur untersuchen.");
     
   AddDetail( ({"adern", "laufe", "waende", "wand", "zeit", "fall"}), 
     "Uninteressant.");
   

//Die Exits:

   AddExit("norden", ROOM "e-2_steg");
   AddExit("sueden", ROOM "e0_bergfuss");
}
