#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  ::create();
  
   SetProp(P_INT_SHORT, "Am See entlang");

   SetProp(P_INT_LONG,
     "Du stehst nun am nordwestlichen Teil auf einem Hang der Insel. Ueberall "
     "liegen grosse und weniger grosse Felsen herum, auch kleine Steinchen sind"
     " zu sehen. Alles besteht hier aus einem schwarzen Gestein, wo ausser ein "
     "paar verkrueppelten Bueschen und Baeumen nichts zu wachsen scheint. Aber "
     "etwas ist hier anders. Im Sueden, hoch ueber Dir, siehst Du den oberen "
     "Rand einer sehr hohen Klippe. Die Hoehlendecke hier sieht eigentlich wie "
     "ueberall auf der Insel aus. Auch hat sich ueber Dir nichts veraendert, "
     "die 'Decke' sieht immer noch gleich aus.");

   SetProp(P_LIGHT, 0);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

  AddDetail( ({"teil"}),
     "Ein Stueck vom Gesamten.");

   AddDetail( ({"stueck"}),
     "Ein Teil des Gesamten.");

   AddDetail( ({"gesamten","gesamtes","gesamt", "stuecke" ,"teile"}),
     "Besteht aus Teilen und Stuecken; DAS hast Du wohl jetzt nicht erwartet, "
     "oder?");

   AddDetail( ({"hoehlendecke"}),
     "Die Decke ist so verhangen, das Du sie gar nicht sehen kannst.");

   AddDetail( ({"boden"}),
     "Da liegen ueberall Felsen und Steine herum.");

   AddDetail( ({"felswand","wand"}),
     "Ziemlich hoch.");

   AddDetail( ({"hang","abhang"}),
     "Naja, Abhang kann man das hier eigentlich nicht nennen, eigentlich waere "
     "hier Felskueste passender.");

   AddDetail( ({"felskueste","kueste"}),
     "So nennt sich eine Kueste aus Felsen. Sie ragt wie eine Wand im Sueden "
     "vor Dir auf.");

   AddDetail( ({"insel"}),
     "Es ist immer noch die selbe Insel wie vorhin.");

   AddDetail( ({"felsen","fels","steine","gestein"}),
     "Es ist ein nachtschwarzes Material, das entfernt an Basalt oder Obsidian"
     " erinnert.");

   AddDetail( ({"material","materialien","basalt","obsidian"}),
     "Das sieht eben wie Vulkangestein aus.");

   AddDetail( ({"vulkangestein"}),
     "Wird von einem Vulkan ausgespuckt.");

   AddDetail( ({"vulkan"}),
     "Der spuckt Vulkangestein aus.");

   AddDetail( ({"steinchen"}),
     "Hier solltest Du besonders aufpassen das Du nicht auf Ihnen ausrutschst. "
     "Es sind hier einige besonders spitze Stellen vorhanden.");

   AddDetail( ({"stellen"}),
     "Greif lieber nicht hin, Du koenntest Dich verletzen.");
/*eventuelle ne greif- oder sonstige funktion die einen sich selbst verletzen 
laesst?*/

   AddDetail( ({"baeume","baum","baeumen","busch","buesche"}),
     "Sie klammern sich mit ihren kargen Wurzeln an den Felsen fest, und es "
     "sieht fast so aus als wuerden sie sich Dir entgegenstrecken. Doch halt! "
     "Da ist Etwas zwischen den Baeumen.");
/*hier haett ich einen idee, wo man random die baeume (ich verteil sie eh 
ueberall), wirklich nach einem greifen laesst oder eventuell ein baummonster 
entstehen lassen koennte das sich mit dem spieler (bzw. er mit dem monster :) )
befasst.*/

   AddDetail( ({"wurzeln"}),
     "Die sind wirklich alt und ausgetrocknet.");

   AddDetail( ({"silberland"}),
     "Wenn Du bist jetzt noch nicht weist, dass Du im Silberland, weist Du es "
     "jetzt.");

   AddDetail( ({"etwas"}),
     "Bei genauerem Hinsehen erkennst Du das es sich um eine Statue handelt.");

   AddDetail( ({"hinsehen"}),
     "Sowas untersucht man nicht, dass tut man. Also sieh Dir jetzt "
     "gefaelligst die Statue an.");

   AddDetail( ({"statue","werk"}),
     "Das ist die Statue eines heldenmutigen menschlichen Abenteurers, der "
     "sich zuweit vorwagte und durch die Macht des Boesen hier in ein ewiges "
     "'Denkmal' verwandelt wurde. Man sieht sogar noch einen kleinen Feuerball "
     "ueber seiner Hand schweben.");

   AddDetail( ({"feuerball"}),
     "Wurde auch statuisiert, schwebt aber trotzdem noch.");
/*wieder ne fiese idee ... wenn sich der feuerball wieder materialisieren 
taete und den spieler treffen koennt?*/

   AddDetail( ({"hand"}),
     "Du weisst schon ... das Ding am Ende deines Armes, mit den fuenf "
     "Wuersteln dran."); 

   AddDetail( ({"ding","arm"}),
     "Das werde ich Dir jetzt nicht weiter beschreiben.");

   AddDetail( ({"wuerstel","wurst","ende"}),
     "Alles hat ein Ende nur die Wurst hat ... aeh nein ... Deine haben auch "
     "bloss eins.");

   AddDetail( ({"abenteurer"}),
     "Abenteurer kommen nicht generell nur aus der Abenteuergilde, sie heissen "
     "nur so (die Abenteurer) weil sie sich gerne in ferne Gebiete und grosse "
     "Abenteuer stuerzen.");

   AddDetail( ({"abenteuergilde"}),
     "Die Hauptabenteuergilde ist in Midas, ihr Oberhaupt ist der "
     "Landstreicher.");

   AddDetail( ({"midas"}),
     "Weit weg von hier.");

   AddDetail( ({"oberhaupt","landstreicher"}),
     "Der steht im Anfaengerpark.");

   AddDetail( ({"anfaengerpark","park"}),
     "Der ist bei Midas (zumindest der menschliche).");

   AddDetail( ({"hauptabenteuergilde"}),
     "Sie war die allererste. Inzwischen sind auch andernorts Abenteuergilden "
     "entstanden.");

   AddDetail( ({"gebiet","gebiete"}),
     "Bist Du nicht sehr weit Deinem Heimatgebiet weg?");

   AddDetail( ({"heimatgebiet","heimat"}),
     "Da wo Du zuhause bist.");

   AddDetail( ({"macht"}),
     "Die Nekromanten sollen unter anderem sehr maechtig sein, was das "
     "Wiederbeleben von Toten betrifft. Solch ein Werk wie diese 'Statue' kann "
     "aber auch nur ein maechtiger Anfuehrer 'erschaffen' haben.");

   AddDetail( ({"anfuehrer"}),
     "Xarfai zum Beispiel.");

   AddDetail( ({"beispiel"}),
     "Xarfai ist so eins.");

   AddDetail( ({"xarfai"}),
     "Der Anfuehrer der Nekromanten.");

   AddDetail( ({"kunst"}),
     "Eine schreckliche und geheime Kunst.");

   AddDetail( ({"wiederbeleben"}),
     "Wo glaubst Du, dass denn die ganzen Untoten im Silberland herkommen?");

   AddDetail( ({"untote","untoten"}),
     "Skelette, Mumien, Zombies, Vampire, Werwoelfe, Vampirwoelfe, Ghule etc.");

   AddDetail( ({"skelette","mumien","zombies","vampire","werwoelfe",
                "Vampirwoelfe","Ghule"}),
     "Untot.");

   AddDetail( ({"boese"}),
     "Das haust angeblich auf dieser Insel.");

   AddDetail( ({"denkmal"}),
     "Denk mal ...");

   AddDetail( ({"sueden"}),
     "Da kannst Du von hier aus nicht hingehen.");

   AddDetail( ({"rand","klippe"}),
     "Du siehst von hier aus kaum ueber den Rand der Klippe hinaus, aber es "
     "duerfte sich etwas Wichtiges da oben befinden.");

   AddDetail( ({"wichtiges"}),
     "Geh woanders rauf und schaue es Dir an.");

   AddDetail( ({"decke"}),
     "Verhangen und duester ist sie ueber Dir.");

   AddDetail( ({"pulsieren","leuchten"}),
     "Kannst anscheinend nicht lesen oder? Nicht da, nada, njet, nope.");

//Geraeusche:
   AddSound(DEFAULT_SOUND,
     "Neben dem leisen Klatschen der Wellen und dem Knistern der Blitze kannst "
     "Du auch ein dumpfes Klopfen wahrnehmen.");

   AddSound( ({"klatschen","wellen"}),
     "Man hoert sie sanft an den Hang klatschen.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander reiben "
     "wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","hang","pulsieren","leuchten"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"klopfen"}),
     "Seltsamerweise ist es synchron mit dem hier NICHT sichtbaren Pulsieren "
     "und Leuchten im Berg zu hoeren.");

   AddSound( ({"berg"}),
     "Auch wenn Du es nicht wahrhaben willst, der Berg scheint dich noch immer "
     "in irgendeiner Weise anzuziehen.");

   AddSound( ({"weise"}),
     "Eine unheimliche Weise.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Eigentlich riechst Du bis auf das heisse, stinkende Wasser gar nichts.");

   AddSmell( ({"wasser"}),
     "Das willst Du gar nicht so genau riechen.");
     
   AddDetail( ({"waende","ihnen","abenteuer","das","nekromanten","nicht","toten"}),
    "Findest Du so nicht.");

//Die Exits:

   AddExit("nordosten", ROOM "e0_bergfuss");
   AddExit("suedwesten", ROOM "c2_lavatuempel");
}