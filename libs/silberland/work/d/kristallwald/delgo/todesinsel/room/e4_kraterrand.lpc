#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  ::create();
   SetProp(P_INT_SHORT, "Beim suedlichen Monolithen");
   SetProp(P_INT_LONG,
     "Auch hier bildet ein verdrehter Monolith einen weiteren Teil dieses "
     "unheiligen Kreises, wie ein Finger einer sieben-fingrigen Hand. Er biegt "
     "sich Richtung Norden, wo er mit den anderen Monolithen eine Art Kuppel "
     "bildet. Du fuehlst ein Pulsieren in Dir, so als wuerde Dich eine "
     "unendliche Macht durchstroemen. Aber irgendwie kommt Dir hier alles "
     "irgendwie seltsam vor und Du meinst, dass Etwas hier nicht stimmt.");
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 0, ENV_TERRAIN: TT_CAVE]) );
// deshalb so kalt, weils eine aetherische kaelte ist.
   SetProp(P_INDOORS, 1);

   AddDetail( ({"hoehlendecke"}),
     "Dunkel und verhangen ist die Decke ueber Dir und auch kein bisschen "
     "naeher als vorher.");

   AddDetail( ({"teil"}),
     "Ein Stueck vom Gesamten.");

   AddDetail( ({"stueck"}),
     "Ein Teil des Gesamten.");

   AddDetail( ({"gesamten","gesamtes","gesamt"}),
     "Besteht aus Teilen und Stuecken; DAS hast Du wohl jetzt nicht erwartet, "
     "oder?");

   AddDetail( ({"boden"}),
     "Der besteht wie ueberall hier aus diesem seltsamen schwarzen Gestein.");

   AddDetail( ({"gestein"}),
     "Dunkelschwarz. Du hast noch nie ein aehnliches Gestein gesehen. Es sieht"
     " extrem hart und wiederstandsfaehig aus.");

   AddDetail( ({"felswand","klippe"}),
     "Hui, da gehts zwar immer noch runter, aber nicht so steil wie an den "
     "Stellen wo keine kleineren Klippen darunter sind. An Deiner Stelle "
     "wuerde ich trotzdem da nicht zu nahe zum Rand gehen.");

   AddDetail( ({"stelle","stellen"}),
     "Da ich nicht an Deiner Stelle bin musst Du das schon selbst wissen.");

   AddDetail( ({"rand"}),
     "Wie mit einem Zirkel gezogen, zieht er sich rund um das ganze Plateau."); 

   AddDetail( ({"plateau"}),
     "Das ist hier oben, da unten ist eine kleine Klippe und wenn Du da "
     "runterfaellst, tust Du Dir sicher sehr weh.");

   AddDetail( ({"zirkel","kreis"}),
     "Da ist natuerlich keiner, das ist nur so dahin gesagt.");

   AddDetail( ({"monolith"}),
     "Verdreht und verwittert, dennoch ungebeugt ragt dieser Monolith Richtung "
     "Decke. Auf einer Seite ist eine Rune in den Stein eingelassen.");

   AddDetail( ({"decke"}),
     "Immer noch da oben, egal wie oft Du es auch untersuchst.");

   AddDetail( ({"etwas"}),
     "Du weisst nicht wie Du es beschreiben sollst, aber irgendwie scheint "
     "hier alles so unscharf und leicht durchsichtig zu sein.");

   AddDetail( ({"richtung","richtungen","nordwesten"}),
     "Ueber Richtungen haben sich schon zu viele ausgelassen, darum hier keine "
     "Diskussion mehr darueber.");

   AddDetail( ({"diskussion"}),
     "Nein.");

   AddDetail( ({"seite"}),
     "Die Seite, die Dir zugewandt ist, traegt die Rune.");

   AddDetail( ({"rune"}),
     "Jetzt bist Du Dir auf einmal doch nicht mehr sicher. Vor einem Moment "
     "war doch da noch etwas zu sehen und nun ist es weg. Irgendwie hast Du "
     "das Beduerfnis den Monolithen trotz eines Gefuehls beruehren zu wollen.");

   AddDetail( ({"beduerfnis"}),
     "Du hast Dich getaeuscht.");

   AddDetail( ({"moment"}),
     "Der ist jetzt schon wieder vorbei.");

   AddDetail( ({"gefuehl"}),
     "Du wirst Dir immer sicherer, dass das Ganze eine Perversion der "
     "natuerlichen Elemente sein soll."),

   AddDetail( ({"stein"}),
     "Hmm ... Du weisst nicht, welche Steinart das ist.");

   AddDetail( ({"pulsieren","macht","kraft"}),
     "Du spuerst foermlich wie Dein Koerper unter dem Ansturm dieser Kraft "
     "zittert.");

   AddDetail( ({"koerper"}),
     "Er erbebt foermlich.");

   AddDetail( ({"ansturm"}),
     "Du kannst Dich kaum noch aufrecht halten.");

   AddDetail( ({"finger","hand"}),
     "Nur ein bildlicher Vergleich. Du hast doch sicher noch nirgends eine "
     "Hand mit acht Fingern gesehen oder?");

   AddDetail( ({"vergleich","waffenexperten"}),
     "Wenn Du etwas vergleichen willst, geh zum einem Waffenexperten.");

   AddDetail( ({"art","kuppel"}),
     "Naja, keine wirklich Kuppel, nur die Andeutung einer solchen.");

   AddDetail( ({"andeutung"}),
     "Willst Du hier irgendwas andeuten?");

//Geraeusche:
   AddSound(DEFAULT_SOUND,
     "Neben dem Knistern der Blitze und dem hier staerker werdenden dumpfen "
     "Klopfen kannst Du aus Richtung des Monolithen staendig leise Stimmen, "
     "die mal drohender mal flehender werden wahrnehmen.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander reiben "
     "wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","pulsieren","leuchten"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"klopfen"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren des Leuchtens im Berg zu"
     " hoeren. Es duerfte irgendwo hier oben seinen Ursprung haben.");

   AddSound( ({"berg"}),
     "Auch wenn Du es nicht wahrhaben willst, der Berg scheint dich noch immer "
     "in anzuziehen.");

   AddSound( ({"richtung"}),
     "Richtungen kann man doch nicht hoeren.");

   AddSound( ({"monolith"}),
     "Er vibriert leise.");

   AddSound( ({"stimmen","sprache"}),
     "Die Stimmen sprechen in einer Dir unbekannten Sprache, daher verstehst "
     "Du auch nicht was sie sagen.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Du riechst eigentlich nur die Gase die aus der Oeffnung mit der Lava "
     "austreten.");

   AddSmell( ({"gase","schwefel"}),
     "Igitt ... riecht wie verfaulte Eier.");

   AddSmell( ({"eier"}),
     "Du riechst an der Oeffnung und kommst zum darauf das es nur Schwefel "
     "sein kann der hier so bestialisch riecht.");

   AddSmell( ({"oeffnung","lava"}),
     "Noch naeher und Deine Nasenfluegel, sind mit dem Rest Deines Gesichts "
     "nur noch Geschichte.");

   AddSmell( ({"nasenfluegel","rest","gesicht","geschichte"}),
     "Nein, das kannst Du nicht riechen und schon gar nicht untersuchen.");

   AddDetail( ({"nasenfluegel","rest","gesicht","geschichte" , "das", "deines", 
                "elemente", "ganze", "nicht", "perversion", "steinart", 
                "ursprung", "waende", "wand" }),
     "Wie gesagt ... DAS kannst Du NICHT untersuchen.");

//Die Exits:
   AddExit("westen", ROOM "d4_kraterrand");
   AddExit("osten", ROOM "f4_kraterrand");
   AddExit("suedostunten", ROOM "f5_wegkreuzung");
   
   SetProp(P_HIDE_EXITS, ({"suedosten"}) );
   AddExit("suedosten", ROOM "f5_wegkreuzung");
}