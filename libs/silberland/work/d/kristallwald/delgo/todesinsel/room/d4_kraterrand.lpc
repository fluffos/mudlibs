#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  ::create();
  
   SetProp(P_INT_SHORT, "Beim suedwestlichen Monolithen");
   SetProp(P_INT_LONG,
     "Wieder ragt ein verdrehter Monolith vor Dir in die Hoehe. Er biegt sich"
     " Richtung Nordosten, wo er mit anderen Monolithen eine Art Kuppel bildet."
     " Hinter dem Monolithen geht die steile Felswand der Klippe runter bis zu"
     " einem kleinen Nebenkrater. Die Hoehlendecke hier ueber Dir kommt einem "
     "noch duesterer vor als sonstwo. Du fuehlst ein Pulsieren in Dir, so als "
     "wuerde Dich unendliche Macht durchstroemen.");
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"hoehlendecke"}),
     "Dunkel und verhangen ist die Decke ueber Dir und trotzdem ist sie hier "
     "auch kein bisschen naeher als vorher.");

   AddDetail( ({"boden"}),
     "Der besteht wie ueberall hier aus diesem seltsamen schwarzen Gestein.");

   AddDetail( ({"gestein"}),
     "Dunkelschwarz. Du hast noch nie ein aehnliches Gestein gesehen. Es sieht"
     " extrem hart und wiederstandsfaehig aus.");

   AddDetail( ({"felswand","klippe"}),
     "Hui, da gehts ja wirklich steil runter. An Deiner Stelle wuerde ich da "
     "nicht zu nahe zum Rand gehen.");

   AddDetail( ({"stelle"}),
     "Da ich nicht an Deiner Stelle bin musst Du das schon selbst wissen.");

   AddDetail( ({"rand"}),
     "Wie mit einem Zirkel gezogen, zieht er sich rund um das ganze Plateau."); 

   AddDetail( ({"plateau"}),
     "Das ist hier oben, da unten ist ein kleiner Nebenkrater mit Minisee und"
     " wenn Du da runterfaellst, landest Du ganz sicher in kochendem Wasser.");

   AddDetail( ({"nebenkrater","krater"}),
     "Das Wasser hat sich am Westrand des kleinen Kraters schon durchgefressen "
     "und so ist ein kleiner Rundbogen zum See entstanden, durch den stetig "
     "heisses Wasser fliesst.");

   AddDetail( ({"westrand","rundbogen","bruecke"}),
     "Das Wasser hat aus dem Gestein schon eine richtige Bruecke bei der "
     "Klippe da unten geformt.");

   AddDetail( ({"minisee","see"}),
     "Glaubst Du den, dass dieses kleine Bisschen da unten ungefaehrlicher ist "
     "als der grosse See?");

   AddDetail( ({"bisschen"}),
     "Viel ist es wirklich nicht, aber trotzdem noch immer sehr gefaehrlich.");

   AddDetail( ({"bad"}),
     "Ein Bad da unten duerfte Deiner Gesundheit nicht gerade zutraeglich "
     "sein.");

   AddDetail( ({"gesundheit"}),
     "Du koenntest in deiner Ausruestung gekocht werden, Dosenfutter quasi.");

   AddDetail( ({"dosenfutter"}),
     "Ohne 'Dosenoeffner' koenntest Du da schnell sterben.");

   AddDetail( ({"dosenoeffner"}),
     "Den gibts nur in Yiqanuc.");

   AddDetail( ({"yiqanuc", "hauptstadt"}),
     "Das ist die Hauptstadt der Xandims.");

   AddDetail( ({"xandims"}),
     "Die leben in der Region Polar.");

   AddDetail( ({"region","polar"}),
     "Geh doch hin und siehs Dir selber an. Ich mag Dir hier nicht die ganze "
     "Region erzaehlen.");

   AddDetail( ({"ausruestung"}),
     "Hast Du keine?");

   AddDetail( ({"zirkel"}),
     "Da ist natuerlich keiner, das ist nur so dahin gesagt.");

   AddDetail( ({"monolith"}),
     "Verdreht und verwittert, dennoch ungebeugt ragt dieser Monolith Richtung "
     "Decke. Auf einer Seite ist eine Rune in den Stein eingelassen.");

   AddDetail( ({"decke"}),
     "Immer noch da oben, egal wie oft Du es auch untersuchst.");

   AddDetail( ({"hoehe"}),
     "Ist immer oben.");

   AddDetail( ({"richtung","richtungen","nordosten"}),
     "Ueber Richtungen haben sich schon zu viele ausgelassen, darum hier keine "
     "Diskussion mehr darueber.");

   AddDetail( ({"diskussion"}),
     "Nein.");

   AddDetail( ({"seite"}),
     "Die Seite, die Dir zugewandt ist, traegt die Rune.");

   AddDetail( ({"rune"}),
     "Die Rune stellt eine Spirallinie dar. Mittlerweile bist Du dir "
     "einigermassen sicher das Ganze schon mal wo gesehen zu haben. Ganz "
     "nebenbei bemerkst Du das es hier bei diesem Monolithen auch etwas Wind "
     "weht."),

   AddDetail( ({"ganze","ganz"}),
     "Du weist nur nicht woher.");
 
   AddDetail( ({"spirallinie","spirale","linie"}),
     "Offenbar ein Symbol fuer Luft. Hier wurde es aber seltsam verunstaltet.");

   AddDetail( ({"symbol","luft"}),
     "Die Spirale.");

   AddDetail( ({"wind"}),
     "Hm ... angenehm kuehl, der Wind. Nur schade das mit ihr nicht nur Gutes "
     "in deine Richtung geweht wird. Du solltest aufpassen das er Dich nicht "
     "die Klippe hinunterweht.");

   AddDetail( ({"gut","gutes"}),
     "Hast Du den schon vergessen wo Du hier bist?");

   AddDetail( ({"stein","steinart"}),
     "Hmm ... Du weisst nicht, welche Steinart das ist.");

   AddDetail( ({"pulsieren","macht","kraft"}),
     "Du spuerst foermlich wie Dein Koerper, neben dem Wind, auch unter diesem"
     " Ansturm dieser Kraft erbebt.");

   AddDetail( ({"koerper"}),
     "Er erbebt foermlich.");

   AddDetail( ({"ansturm"}),
     "Du kannst Dich kaum noch aufrecht halten.");

   AddDetail( ({"art","kuppel"}),
     "Naja, keine wirklich Kuppel, nur die Andeutung einer solchen.");

   AddDetail( ({"andeutung"}),
     "Willst Du hier irgendwas andeuten?");

//Geraeusche
   AddSound(DEFAULT_SOUND,
     "Aus Richtung des Monolithen vernimmst staendig leise Stimmen, die mal"
     " drohender mal flehender werden. Aber auch sie werden durch den Wind so"
     " verweht, dass man sie kaum hoeren kann.");

   AddSound( ({"wind"}),
     "Er pfeift Dir um die Ohren und Du verstehst kaum noch etwas.");

   AddSound( ({"ohren","ohr"}),
     "Wie willst Du daran bitte lauschen?");

   AddSound( ({"richtung"}),
     "Richtungen kann man doch nicht hoeren.");

   AddSound( ({"monolith"}),
     "Er vibriert leise.");

   AddSound( ({"stimmen","sprache"}),
     "Die Stimmen sprechen in einer Dir unbekannten Sprache, daher verstehst "
     "Du auch nicht was sie sagen.");

//Gerueche
   AddSmell(DEFAULT_SMELL,
     "Eigentlich riechst Du hier auf Grund des Windes gar nichts.");

   AddSmell( ({"grund","boden"}),
     "Du riechst am Boden ... nichts.");

   AddSmell( ({"wind"}),
     "Da der Wind selbst geruchslos ist, riechst Du gar nichts.");
     
   AddDetail( ({"wand", "waende", "wasser"}),
     "Du forschst zu viel!");

//Die Exits:

   AddExit("norden", ROOM "d3_kraterrand");
   AddExit("osten", ROOM "e4_kraterrand");
}