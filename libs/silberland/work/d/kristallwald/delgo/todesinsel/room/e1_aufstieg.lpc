#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  ::create();
  
   SetProp(P_INT_SHORT, "Ein steiles Stueck");
   SetProp(P_INT_LONG,
     "Puh, hier gehts ganz schoen steil rauf, Du bist schon ganz erschoepft. "
     "Aber da hier ueberall so komische kleine sechseckige Saeulen in der "
     "Gegend rumstehen, die praktischerweise einen kleinen Weg nach oben "
     "bilden, duerfte der Aufstieg zwar einigermassen beschwerlich, aber doch "
     "nicht unmoeglich sein. Die Hoehlendecke scheint sich trotzdem nicht "
     "anzunaehern. Was Dir allerdings Angst macht, ist, das es ausser den "
     "jeweils ueber Dir liegenden Saeulen oberhalb nichts zum festhalten gibt "
     "und Du auch einen etwas groesseren, nicht ganz ungefaehrlich aussehenden "
     "Riss noch vor Dir hast, aus dem staendig heisse Gase aufsteigen.");
   SetProp(P_LIGHT, 0);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 26, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"boden"}),
     "Hier gibt es nur die kleinen Saeulen zum klettern und keinen richtigen "
     "Boden, also huete Dich davor herunter zu fallen.");

   AddDetail( ({"hoehlendecke","decke"}),
     "Dunkel und verhangen ist sie ueber Dir, und egal wie hoch Du auch noch "
     "kletterst, Du scheinst kein bisschen naeher hin zu kommen.");

   AddDetail( ({"saeulen","saeule"}),
     "Jede Saeule ein perfektes Sechseck von ca. 30 cm Basalt. Du fragst Dich"
     " wie das kommen mag.");

   AddDetail( ({"sechseck"}),
     "Das kommt vermutlich daher, weil Basalt meist eine sechseckige "
     "Kristallinstruktur hat.");

   AddDetail( ({"basalt"}),
     "Vulkanisches (nein nicht vom Planeten Vulkan) Auswurfgestein, das "
     "schnell abkuehlt.");

   AddDetail( ({"kristallinstruktur"}),
     "Haettest Du damals in Chemie und Geologie besser aufgepasst, wuesstest "
     "Du wovon hier die Rede ist.");

   AddDetail( ({"chemie","geologie","rede"}),
     "Da Du frueher gerade immer zu dieser Zeit geschlafen hast, weisst Du es "
     "natuerlich nicht."),

   AddDetail( ({"zeit"}), "Tipps ein.");

   AddDetail( ({"auswurfgestein"}),
     "Logischerweise von einem feuerspeienden Berg ausgeworfen.");

   AddDetail( ({"planet","planeten","vulkan"}),
     "Den findest Du moeglicherweise in einem Sci-Fi-Mud.");

   AddDetail( ({"sci-fi-mud"}),
     "Das hier ist keines.");

   AddDetail( ({"berg"}),
     "So wie der hier?");

   AddDetail( ({"gegend"}),
     "Eigentlich nur ein schmaler Streifen am untersten Hang bis ganz oben zum"
     " Plateau. Seitlich nur glatter Fels an dem Du dich nicht festhalten "
     "kannst.");

   AddDetail( ({"hang","plateau"}),
     "Dieser Hang ist unten, das Plateau oben, mehr gibts da nicht zu sagen. "
     "Und je weiter nach oben Du gehst, desto weiter kannst Du runterfallen.");

   AddDetail( ({"streifen"}),
     "Wirklich nicht sehr breit. Nie mehr als maximal zehn Saeulen "
     "nebeneinander.");

   AddDetail( ({"fels"}),
     "Aus dem selben Material wie ueberall hier.");

   AddDetail( ({"material"}),
     "Schwarz, unergruendlich, geheimnisvoll und ziemlich robust.");

   AddDetail( ({"weg","aufstieg"}),
     "Der duerfte Dir keine Probleme bereiten.");

   AddDetail( ({"angst","probleme"}),
     "Angst hast Du nur davor in den Riss da oben zu fallen, wenn Du ein "
     "Problem mit dem festhalten dort hast, da auf jeder Seite nur 2 Saeulen "
     "sind.");

   AddDetail( ({"seiten"}),
     "Links und rechts. Was dachtest Du den?");

   AddDetail( ({"riss"}),
     "Der ovalfoermige Riss sieht ganz schoen gross aus, da er an seiner "
     "groessten Stelle mindestens sechs Saeulen lang nach oben geht.");

   AddDetail( ({"stelle"}),
     "Umgerechnet also ca. 180 cm.");

   AddDetail( ({"gase"}),
     "Man sieht die Luft richtig flimmern.");

   AddDetail( ({"luft", "flimmern"}),
     "Ist ziemlich heiss und riecht scheusslich."); 

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Du riechst eigentlich nur die Gase die aus dem Riss austreten.");

   AddSmell( ({"gase","schwefel"}),
     "Igitt ... riecht wie verfaulte Eier.");

   AddSmell( ({"eier"}),
     "Du riechst an dem Riss und kommst zum darauf das es nur Schwefel "
     "sein kann der hier so bestialisch riecht.");

   AddSmell( ({"riss"}),
     "Da willst Du gar nicht naeher ran.");

//Geraeusche
   AddSound(DEFAULT_SOUND,
     "Eigentlich hoerst Du nur die schnell und laut entweichende Luft aus dem "
     "Riss. Um die restlichen Geraeusche zu hoeren, muesstest Du woanders "
     "hingehen wo es ruhiger ist.");

   AddSound( ({"luft","riss"}),
     "*ZISCH* *FFFFFFT* *RAUSCH* *BLAS*");

   AddSound( ({"geraeusche"}),
     "Die hoerst Du, wie gesagt, nicht mehr.");
     
   AddDetail( ({"seite", "waende", "wand", "zisch", "fffffft", "blas", "mud", 
                "fi", "problem", "rausch", "schwefelsein", "sci", "stueck"}),
     "Uebertreibs nicht!");

//Die Exits:
   AddExit("suedoben", ROOM "e2_kraterrand");
   AddExit("nordunten", ROOM "e0_bergfuss");
   
   SetProp(P_HIDE_EXITS, ({"sueden" , "norden"}) );
   AddExit("sueden", ROOM "e2_kraterrand");
   AddExit("norden", ROOM "e0_bergfuss");
}