#include "../def.h"
#include "/gilden/waldlaeufer/ranger_tasks.h"
inherit "/std/room";

public void create() {
    ::create();

    SetProp(P_INT_SHORT, "Auf einem Felsvorsprung am Vulkan der Todesinsel");
    SetProp(P_INT_LONG, "Du stehst hier auf einem Felsvorsprung, der ueber die Lava "
                        "des Vulkans auf der Todesinsel hinausragt. Von unten hoerst "
                        "du das Blubbern der Lava und ueber dir strahlt der blaue Himmel, "
                        "immer wieder durchzogen von grauen Rauchsaeulen, die aus dem "
                        "Vulkan emporsteigen. Weit und breit ist niemand zu sehen. Der "
                        "perfekte Ort, um ungesehen und ungehoert zu bleiben.");
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );
    SetProp(P_INDOORS, 0);
}

public void StartSequence(object pl) {
    pl->SetProp(P_PARALYZED, ([
        PARALYZE_TIME: -1,
        PARALYZE_MSG: "Du bist gerade beschaeftigt.\n"
    ]));

    tell_room(TO, BS("Sarl fuehrt dich hier her."));
    call_out("sequence", 4, pl, 0);
    return;
}

public void clone_elemental_and_combat(object pl) {
    object ob;

    ob = clone_object(NPC "ranger_quest_elemental");
    ob->move(TO, M_SILENT|M_NOCHECK);
    ob->SetRanger(pl);

    pl->Kill(ob);
    ob->Kill(pl);
    return;
}

public void sequence(object pl, int step) {
    string msg;
    int pause;

    if(!objectp(pl)) return; // ups, spieler weg?

    switch(step) {
        case 0: msg = "Sarl sagt: Also gut. Hier sollte uns niemand stoeren."; pause = 4; break;
        case 1: msg = "Sarl sagt: Ich habe Wissen ueber das, was hier vor sich geht, das nur fuer deine Ohren bestimmt ist!"; pause = 4; break;
        case 2: msg = "Der Druide macht ein paar Schritte in Richtung des Rands des Vorsprungs und deutet nach unten."; pause = 4; break;
        case 3: msg = "Sarl sagt: Komm her und sieh dir das dort an!"; pause = 4; break;
        case 4: msg = "Du machst ein paar Schritte nach vorne und blickst nach unten."; pause = 6; break;
        case 5: msg = "Du kannst nichts besonderes erkennen. Nur blubbernde Lava."; pause = 6; break;
        case 6: msg = "Sarl sagt von hinter dir: Da! Du musst ganz genau hinsehen."; pause = 4; break;
        case 7: msg = "Du sagst: Ich kann nichts besonderes sehen.\nGerade willst du dich umwenden..."; pause = 4; break;
        case 8: msg = "... und siehst wie Sarl seine Faeuste vor der Brust zusammenschlagt und auf dich deutet!"; pause = 2; break;
        case 9: msg = "Eine unglaubliche Kaelte durchstroemt dich. Nach und nach wirst du von Eis ueberzogen!"; pause = 4; break;
        case 10: msg = "Du machst einen, dann einen zweiten schweren Schritt nach vorne. Doch schon hat dich das Eis gefangen."; pause = 4; break;
        case 11: msg = "Durch das Eis erkennst du verschwommen, wie Sarl die Schultern haengen laesst."; pause = 4; break;
        case 12: msg = "Sarl sagt: Verzeih mir, "+pl->name(WER)+". Es ist nichts persoenliches."; pause = 2; break;
        case 13: msg = "Sarl sagt: Du bist nur ein Bauernopfer in diesem Spiel. Doch nichts darf den Plan des Meisters aufhalten!"; pause = 4; break;
        case 14: msg = "Sarl geht nervoes vor dir auf und ab."; pause = 4; break;
        case 15: msg = "Sarl sagt: Wir werden die Welt neu ordnen! Die Elemente, die Kraefte - ja, sogar die Goetter!"; pause = 4; break;
        case 16: msg = "Sarl seufzt."; pause = 2; break;
        case 17: msg = "Sarl sagt: Du warst einfach zur falschen Zeit am falschen Ort."; pause = 4; break;
        case 18: msg = "Waehrend Sarl vor sich hin schwadroniert faellt dir ein Schatten auf, der ueber euch kreist."; pause = 4; break;
        case 19: msg = "Du versuchst nach oben zu blicken, bist aber im Eis gefangen."; pause = 4; break;
        case 20: msg = "Sarl erzaehlt: Wir werden das Omegatherion beschwoeren. Die letzte Kreatur, die das Silberland verschlingt!"; pause = 4; break;
        case 21: msg = "Du denkst . o O ( Und wie genau will er das selbst ueberleben? Klingt undurchdacht... )"; pause = 4; break;
        case 22: msg = "Ploetzlich merkst du, dass du deinen kleinen Finger bewegen kannst. Die Hitze des Vulkans scheint das Eis zu schmelzen."; pause = 4; break;
        case 23: msg = "Sarl ruft: Und wenn dies geschen ist, dann wird der Meister die Welt neu erschaffen!"; pause = 4; break;
        case 24: msg = "Der Schatten, der ueber euch kreist wird offenbar groesser. Doch Sarl scheint nichts zu bemerken."; pause = 6; break;
        case 25: msg = "Hork der Zwergenwaldlaeufer teilt Dir mit: Mach dich bereit!"; pause = 4; break;
        case 26: msg = "Ploetzlich stuerzt ein riesiger Adler aus dem Himmel. Sarl stolpert zurueck."; pause = 2; break;
        case 27: msg = "Hork der Zwergenwaldlaeufer springt von dem Adler und verpasst Sarl einen Fusstritt und der geht zu Boden."; pause = 4; break;
        case 28: msg = "Hork schiesst mit seiner Armbrust auf den Eisblock, in dem du gefangen bist."; pause = 2; break;
        case 29: msg = "  Hork zerschmettert den Eisblock mit einem gewaltigen Stich.\nDu bist frei!"; pause = 4; break;
        case 30: msg = "Sarl steht wieder auf und ruft: IHR WERDET UNS NICHT AUFHALTEN!\n"; pause = 4; break;
        case 31: msg = "Hork zwinkert dir zu.\nHork sagt: Hast du gedacht, Raziel laesst dich ohne Rueckendeckung?"; pause = 4; break;
        case 32: msg = "Sarl hebt die Haende und spricht Worte der Beschwoerung."; pause = 4; break;
        case 33: msg = "Hork sagt: Mach dich bereit, Kleine"+(pl->QueryProp(P_GENDER)==MALE?"r":"")+"!"; pause = 2; break;
        case 34: msg = "Hork konzentriert sich kurz und ein Schwarzbaer erscheint."; pause = 4; break;
        case 35: msg = "Sarl schlaegt die Haende auf den Boden und kalter Raureif breitet sich aus!"; pause = 4; break;
        case 36: msg = "Hork laedt seine Armbrust nach."; pause = 4; break;
        case 37: msg = "Aus dem Raureif erhebt sich ein gigantisches Eiselementar!"; pause = 2; break;
        case 38: msg = "Hork wirft einen Farbbeutel auf das Eiselementar und markiert es als Ziel."; pause = 2; break;
        case 39: msg = "Sarl ruft: Elementar, vernichte unsere Feinde!\nEin Luftelementar erscheint und traegt Sarl davon."; pause = 4; break;
        case 40: msg = "Hork greift das gigantische Eiselementar mit seiner Armbrust an.\nDer Schwarzbaer greift das Eiselementar mit seinen Pranken an.\n"; pause = 4; break;
        case 42: msg = "Hork teilt Dir mit: Wir lenken das Elementar ab und du vernichtest es!\nHork teilt Dir mit: Zeig was du drauf hast!";
        default:
            clone_elemental_and_combat(pl);
            pl->SetProp(P_PARALYZED, 0);
            return;
            break;
    }

    tell_object(pl, break_string(msg, 78, 0, BS_LEAVE_MY_LFS));
    call_out("sequence", pause, pl, ++step);
    return;
}

public void BecomesNetDead(object spieler) {
    spieler->move(ROOM "raum07", M_NOCHECK); // tja wer ausloggt muss nochmal ran
    return;
}

public void EndSequence(object pl) {
    pl->SetProp(P_PARALYZED, -1);

    tell_object(pl, BS("Hork klopft dir auf die Schulter."));
    call_out("end_sequence", 4, pl, 0);
}

public void end_sequence(object pl, int step) {
    string msg;
    int pause;

    if(!objectp(pl)) return; // ups, spieler weg?

    switch(step) {
        case 0: msg = "Hork sagt: Das war ein guter Kampf!"; pause = 4; break;
        case 1: msg = "Hork jubelt dir zu."; pause = 4; break;
        case 2: msg = "Hork gruebelt."; pause = 4; break;
        case 3: msg = "Hork meint: Nur zu dumm, dass uns dieser Schuft entkommen ist."; pause = 4; break;
        case 4: msg = "Hork untersucht den Boden."; pause = 2; break;
        case 5: msg = "Hork sagt: Nagut. Ich leihe dir meinen Adler um zu Raziel zu fliegen.\nHork sagt: Und ich suche hier nach weiteren Spuren!"; pause = 4; break;
        case 6: msg = "Du nickst."; pause = 4; break;
        case 7: msg = "Du kletterst auf den Ruecken eines Riesenadlers."; pause = 4; break;
        case 8: msg = "Mit einem kraeftigen Satz erhebt sich der Riesenadler in den Himmel und fliegt los."; pause = 4; break;
        case 9: msg = "Unter dir wird die Todesinsel immer kleiner."; pause = 4; break;
        case 10: msg = "Der Adler dreht eine Schleife ueber dem Meer und wendet sich nach Suedwesten."; pause = 6; break;
        case 11: msg = "Unter dir zieht die Hafenstadt Khorinis vorbei."; pause = 6; break;
        case 12: msg = "Ihr ueberfliegt einen Fjord und dann ist auch schon der Tethyrwald unter dir zu sehen."; pause = 4; break;
        case 13: msg = "Du erkennst schon den riesigen Baum, in dem ihr Waldlaeufer euer Hauptquartier habt."; pause = 4; break;
        case 14: msg = "Der Riesenadler geht in einen Sinkflug ueber und setzt dich auf dem Baum ab."; pause = 2; break;
        default:
            pl->SetProp(P_PARALYZED, 0);
            pl->move("/gilden/waldlaeufer/room/d2", M_GO|M_NOCHECK);
            RANGER_SET_TASK(pl, 9);
            return;
            break;
    }

    tell_object(pl, break_string(msg, 78, 0, BS_LEAVE_MY_LFS));
    call_out("end_sequence", pause, pl, ++step);
    return;
}