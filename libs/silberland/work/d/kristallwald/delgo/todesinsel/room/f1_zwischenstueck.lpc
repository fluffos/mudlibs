#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Ein ruhiges Ufer");  
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf dem Weg zwischen dem Bootsanlegesteg und einem "
    "kleinen Waeldchen, dessen Auslaeufer Du hier noch ein bisschen ausmachen "
    "kannst. Der brodelnde See ist auch hier allgegenwaertig. Suedwestlich "
    "neben Dir ragt noch eine Klippe hoch. Trotzdem hat es hier irgendwas "
    "Idyllisches."),
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({"weg"}),
    "Er fuehrt, je nachdem von wo man kommt, von Nordwesten nach Suedosten oder"
    " umgekehrt.");

  AddDetail( ({"nordwesten","suedosten"}),
    "Zwei Richtungen, in die Du weitergehen kannst.");

  AddDetail( ({"suedwesten"}),
    "Da kannst Du nicht hingehen, da ist eine Klippe.");

  AddDetail( ({"klippe"}),
    "Da kommst Du von hier aus nicht rauf.");

  AddDetail( ({"richtungen"}),
    "In die kann man meistens, sofern man es will, gehen.");

  AddDetail( ({"bootsanlegesteg"}),
    "Da legt das Boot an, das Dich hier hergebracht hat.");

  AddDetail( ({"boot"}),
    "... und es bringt Dich auch wieder von hier weg.");

  AddDetail( ({"waeldchen"}),
    "Das siehst Du von hier nicht, gerade mal die Reste seines Auslaeufers.");

  AddDetail( ({"auslaeufer"}),
    "Nicht mal die siehst Du von hier genau, da musst Du schon naeher ran "
    "gehen.");

  AddDetail( ({"reste"}),
    "Ja, es sind gerade mal die letzten kuemmerlichen Reste, die Du von hier"
    " erspaehen kannst.");

  AddDetail( ({"see"}),
    "Der plaetschert hier ausnahmsweise mal etwas ruhiger ans Ufer als an "
    "anderen Stellen der Insel.");

  AddDetail( ({"ufer"}),
    "Auch wenn er hier etwas ruhiger wirkt, ungefaehrlicher ist er deswegen "
    "wahrscheinlich trotzdem nicht.");

  AddDetail( ({"stellen"}),
    "Nicht hier.");

  AddDetail( ({"insel"}),
    "Auf der befindest Du dich gerade.");

  AddDetail( ({"idylle"}),
    "Man koennte hier fast von Straenden in der Suedsee zu traeumen anfangen, "
    "so angenehm ruhig ist es hier.");

  AddDetail( ({"straende", "strand"}),
    "Da hat es meistens schoenen weissen Sand.");

  AddDetail( ({"sand"}),
    "Den gibts hier nicht.");

  AddDetail( ({"suedsee"}),
    "Die ist woanders.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Hier riecht es eigentlich nach Nichts.");

   AddSmell( ({"nichts"}),
     "Das Nichts riecht ... nach Nichts! Oh Wunder.");

   AddSmell( ({"wunder"}),
     "Das ist gerade blau.");

//Geraeusche:
   AddSound(DEFAULT_SOUND,
     "Du hoerst nur sanft das Wasser ans Ufer rollen.");

   AddSound( ({"wasser"}),
     "*Roll*Rausch*Plaetscher*");

   AddSound( ({"ufer"}),
     "Das hoert man nicht, dass sieht man.");
     
   AddDetail( ({"boden", "decke", "roll", "waende", "wand", "rausch", 
                "plaetscher"}),
     "Das interessiert Dich auf einmal nicht mehr.");

//Exits:
   AddExit("nordwesten", ROOM "e0_bergfuss");
   AddExit("suedosten", ROOM "g2_lavafall_am_see");
}