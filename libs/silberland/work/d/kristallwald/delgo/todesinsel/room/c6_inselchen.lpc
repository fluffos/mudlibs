#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  ::create();
  
   SetProp(P_INT_SHORT, "Auf einer umspuelten Halbinsel");
   SetProp(P_INT_LONG,
     "Du befindest Dich hier auf einem kleinem Abhang, aber auch die "
     "Bezeichnung Halbinsel wuerde hier nicht zutreffen, da hier bis auf "
     "einen kleinen Verbindungsweg im Nordosten, zum Hauptteil der Insel, "
     "rundherum in jeder Richtung nichts anderes als kochendes Wasser ist. "
     "Im Norden und Nordosten siehst Du zudem noch den Berg in die Hoehe "
     "ragen. Hier kannst Du die Hoehlendecke endlich einmal wirklich durch "
     "die Schwaden sehen. Pass bloss auf das hier keine grossen Wellen auf "
     "Dich zuschwappen, das koennte sehr, SEHR boese fuer Dich ausgehen.");
   SetProp(P_LIGHT, 0);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"hoehlendecke"}),
     "Obwohl hier gerade ein Loch in den Schwaden ist, siehst Du nur Schwaerze "
     "dahinter.");

   AddDetail( ({"loch","schwaden"}),
     "Schon ist es wieder gestopft worden.");

   AddDetail( ({"schwaerze"}),
     "Ist normalerweise ziemlich dunkel.");

   AddDetail( ({"decke"}),
     "Verhangen und duester ist sie ueber Dir.");

   AddDetail( ({"westen","nordosten","norden"}),
     "Richtungen lassen sich ueberall schwer untersuchen. Und Du wirst es nicht"
     " glauben: Hier auch.");

   AddDetail( ({"richtung","richtungen"}),
     "Hier gibts in jeder Richtung etwas zu sehen ... in dem meisten allerdings"
     " nur Wasser.");

   AddDetail( ({"stueck"}),
     "Stueck ist hier sogar noch uebertrieben, ein kleiner Fleck passt eher.");

   AddDetail( ({"halbinsel"}),
     "Wird hier nur per Definition so genannt.");

   AddDetail( ({"definition"}),
     "Was das bedeutet, schlag doch bitte in einem Lexikon nach.");

   AddDetail( ({"lexikon"}),
     "Du hast sicher eines rumstehen.");

   AddDetail( ({"fleck"}),
     "Ja, mehr ist es nicht.");

   AddDetail( ({"boden","abhang"}),
     "Da liegen ueberall nur mehr kieselgrosse Steine herum.");

   AddDetail( ({"felswand","wand"}),
     "Keine da, sie wird also auch nicht auf Dich fallen.");

   AddDetail( ({"hauptteil"}),
     "... auf dem bist Du ja jetzt logischerweise nicht.");

   AddDetail( ({"insel"}),
     "Es ist immer noch die selbe Insel wie vorhin.");

   AddDetail( ({"steine"}),
     "Hier solltest Du besonders aufpassen, dass Du nicht auf ihnen "
     "ausrutschst. Es ist hier nirgends eine Felswand zum Anhalten vorhanden.");

   AddDetail( ({"verbindungsweg","verbindung","weg"}),
     "Der ist wirklich nur sehr schmal.");

   AddDetail( ({"richtungen"}),
     "Bis auf den Westen ist da nichts als heisses Wasser um Dich."),

   AddDetail( ({"wasser"}),
     "Das ist auch hier nicht ungefaehrlicher, als anderswo auf der Insel "
     "hier.");

   AddDetail( ({"berg"}),
     "Imposant ragt er vor Dir in die Hoehe. Von hier kannst Du auch nur "
     "teilweise sehen wie gross er ist.");

   AddDetail( ({"hoehe"}),
     "In den meisten Faellen ist die Hoehe immer weit oben.");

   AddDetail( ({"faelle"}),
     "Wie auch in diesem Fall.");

   AddDetail( ({"fall"}),
     "Ein Fall aus grosser Hoehe kann sehr schmerzhaft sein.");

   AddDetail( ({"wellen","welle"}),
     "Die koennen hier sehr gefaehrlich werden, da sie dich hier auf dem "
     "flachen Stueck erwischen.");
/*fiese idee:
  lassen wir doch einfach mal ein paar wellen ueber die fuesse rollen :) *FG**/
//die fiesen toedlichen sachen lasse ich weg, immerhin haben die druiden ja die
//insel bereinigt :-)

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Du riechst nichts anderes mehr als heisses, stinkendes Wasser rund um "
     "Dich.");

   AddSmell( ({"wasser"}),
     "Das ist hier sicher sehr schaedlich fuer Deine Gesundheit.");

   AddSmell( ({"gesundheit"}),
     "Tja ... wer die Nase zu voll nimmt muss eben mit Konsequenzen rechnen.");
/*hier sollts einem eventuell wieda was abziehn*/

   AddSmell( ({"nase"}),
     "Ja ... versuch bitte an Deiner Nase zu riechen.");

   AddSmell( ({"konsequenzen"}),
     "Riech doch bitte noch einmal an 'Gesundheit', dann weisst Du es.");

//Geraeusche:
   AddSound(DEFAULT_SOUND,
     "Du kannst hier ausser den rauschenden Wellen nichts anderes hoeren.");

   AddSound( ({"wellen"}),
     ". o O (Was hast Du gesagt? Man hoert es nicht.)");
     
   AddDetail( ({"bezeichnung", "ihnen", "o", "saeure", "sehr", "waende", 
                "was"}), "Findest Du so nicht hier.");

//Die Exits:

   AddExit("nordostoben", ROOM "d5_klippe_am_see");
   
   SetProp(P_HIDE_EXITS, ({"nordosten"}) );
   AddExit("nordosten", ROOM "d5_klippe_am_see");
}