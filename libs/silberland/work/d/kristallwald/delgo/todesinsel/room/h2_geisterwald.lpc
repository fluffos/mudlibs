#include "../def.h"
#include <properties.h>

inherit "std/room";

int i;

void create()
{
  
  object ob;
  
  ::create();
  
  i=1;
  
   SetProp(P_INT_SHORT, "Bei einem kleinen Waeldchen");
   SetProp(P_INT_LONG,
     "Du haeltst es nicht fuer moeglich, aber dass die karge Felslandschaft "
     "etwas zurueckweicht und von einem kleinen, wenn auch nicht unbedingt "
     "recht imposanten, Waeldchen, das sich Richtung Sueden und Suedosten "
     "ausbreitet, abgeloest wird, haettest Du auf dieser Insel nicht erwartet. "
     "Die Felsen und Steine sind nicht mehr ganz so gross im Westen und sind "
     "im Sueden schon so geschrumpft, dass sie zwischen den Baeumen und "
     "Bueschen nur mehr selten hervorragen, nur etwas weiter im Suedosten "
     "siehst Du noch einen riesigen Felsklotz stehen. Das Unterholz und einige "
     "groessere Felsen versperren Dir den Weg im Sueden, so dass Du nur mehr "
     "auf einen kaum begehbaren Pfad Richtung Suedosten ausweichen kannst, "
     "waehrend im Westen der Weg, trotz des Lavafalls dort, wieder freier "
     "begehbar ist. Die Hoehlendecke kannst Du durch die Aeste auch nur mehr "
     "eingeschraenkt wahrnehmen.");
   SetProp(P_LIGHT, 0);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 24, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"decke","hoehlendecke"}),
     "Du siehst sie nur mehr stellenweise durch die Aeste der Baeume, aber da "
     "sie sich sowieso kaum veraendert macht Dir das auch nichts aus.");

   AddDetail( ({"boden"}),
     "Da liegen ueberall Steine herum.");

   AddDetail( ({"felsen","steine","gestein","fels","geroell"}),
     "Ein nachtschwarzes Material, das entfernt an Basalt oder Obsidian "
     "erinnert.");

   AddDetail( ({"material","materialien","basalt","obsidian"}),
     "Das sieht wie Vulkangestein aus.");

   AddDetail( ({"vulkangestein"}),
     "Wird von einem Vulkan ausgespuckt.");

   AddDetail( ({"vulkan"}),
     "Der spuckt Vulkangestein aus.");

   AddDetail( ({"insel"}),
     "Egal wie oft Du die Insel noch untersuchst, es ist immer noch dieselbe "
     "wie vorher.");

   AddDetail( ({"felslandschaft","landschaft"}),
     "Du hast ausser Felsen ja schliesslich hier noch nicht recht viel "
     "gesehen.");

   AddDetail( ({"waeldchen","wald", "unterwelt", "angst"}),
     ([ 0:
     "Der Begriff Waeldchen ist doch noch etwas zu verniedlichend, es ist "
     "eigentlich ein eher unheimlicher Wald, wie Du ihn aus den Geschichten "
     "und Erzaehlungen Deiner Jugend kennst, wo die Fratzen an den Baeumen "
     "grauslich grinsen und die Aeste nach Dir zu greifen scheinen.",
     "dunkelelf":
     "Der Begriff Waeldchen ist doch noch etwas zu verniedlichend, es ist "
     "eigentlich ein eher dunkler Wald, wie Du ihn aus den Geschichten "
     "und Erzaehlungen Deiner Jugend kennst, wo die Fratzen an den Baeumen "
     "grauslich grinsen und die Aeste nach Dir zu greifen scheinen. Doch du "
     "verspuerst keine Angst, die Unterwelt ist unheimlicher."
     ]) );

   AddDetail( ({"begriff"}),
     "Begreif es doch endlich ... zu viel Forschen schadet der Gesundheit.");

   AddDetail( ({"forschen"}),
     "Was tust Du da wohl gerade?");

   AddDetail( ({"gesundheit"}),
     "Vor allem hier auf der Insel.");

   AddDetail( ({"fratzen"}),
     "Zerrbilder des Schreckens.");

   AddDetail( ({"baum","baeume"}),
     "Hier ueberwiegen die Baeume, aber sie stehen mit den Bueschen so dicht "
     "zusammen, dass sie Dich zwingen, den Weg nach Suedosten zu nehmen, wenn "
     "Du durch den Wald willst. Sie strecken Dir aus allen Richtungen ihre "
     "Aeste und Wurzeln entgegen und Du kannst erkennen, dass, je naeher sie "
     "an der Felswand im Suedwesten stehen, sie sich wieder etwas lichten, "
     "aber nicht weil der Wuchs nachlaesst, sondern weil sich hin und wieder "
     "von der Klippe dort oben Geroell loest und auf die Pflanzen "
     "aufschlaegt.");

   AddDetail( ({"felswand","wand"}),
     "Genauere kannst Du von hier aus nicht erkennen, aber Du siehst hin und "
     "wieder etwas Geroell herunter purzeln.");

   AddDetail( ({"pflanzen"}),
     "Die Baeume und Buesche.");

   AddDetail( ({"wurzeln"}),
     "Das sind ja richtige Stolperfallen. So ausgepraegt wie die hier sind, "
     "finden sie anscheinend etwas mehr Naehrstoffe als sonst wo auf der "
     "Insel.");

   AddDetail( ({"stolperfalle","stolperfallen"}),
     "Du versuchst ihnen auszuweichen, aber manchmal stehen sie so dicht "
     "zusammen, dass Du doch mal stolperst."); 

   AddDetail( ({"stoff","stoffe"}),
     "Stoff? Wo siehst Du hier Stoff?");

   AddDetail( ({"wuchs","naehrstoffe"}),
     "Pflanzen wachsen normalerweise nur dann wenn sie Naehrstoffe haben.");

   AddDetail( ({"zerrbilder","bilder"}),
     "Verzerrt. Abnormal. Schrecklich.");

   AddDetail( ({"schrecken","schreckens"}),
"                                _      ____                         \n"
"                             ,-'_`--.-',--.`.                       \n"
"                        _,-.',-* '-.  *    `'_                      \n"
"                    ,--'    Y       )  ) ,-*' `.__,--._     ,.      \n"
"                  ,'    _    `-.  ,'  /_;    ___   __  `._,'(_      \n"
"           _.---.'  _,-/ /.     \\ :         '--.`-'  `.   __  `.    \n"
"   ,--._,-'   __   /   \\:  :    :  \\        _   \\     /,-'  `.  \\   \n"
" ,'.-.   _,.-'  ) :     `   \\    `.;     ,-' `.  \\   ((       `. \\  \n"
"((    `*'   ,-.; ,'         :           :      \\ :    `         ) ) \n"
" `'        /,.__;   _.-...__|           ;      './              `-` \n"
"           `      ,'  ...__     @   @   (     _,=-._                \n"
"                 I   ',    `.    /\\/\\/\\  `-,-'_,--, '-._            \n"
"                 /     \\     `. |      |   ,-'    /     \\           \n"
"                //\\ /\\ /D     |  \\/\\/\\/   /      C\\ /\\ /\\\\         \n"
"               (( (( ((       |          :         )) )) ))         \n"
"                `  `  `       |          |         '  '  '          \n"
"                              |          :                          \n"
"                              :           `.                        \n" 
"                             /              \\                       \n"
"                          _,'                '.                     \n"
"                      _,-'_'. .^'.    _.~'-._  '.                   \n"
"                       `'    Y    )  (       `~.~`.                 \n"
"                             '   /_.~                               \n"
"                                '                                   \n");

   AddDetail( ({"geschichten","erzaehlungen"}),
     "Du erinnerst Dich, wie Du frueher immer Albtraeume davon bekommen hast.");

   AddDetail( ({"albtraeume","albtraum"}),
     "Hier werden Albtraeume schnell lebendig.");

   AddDetail( ({"jugend"}),
     "Lang, lang ist's her.");

   AddDetail( ({"aeste", "weiterkommen"}),
     "Staendig verhaken sich die Spitzen der Zweige an Deiner Ruestung und "
     "behindern Dich so am Weiterkommen.");

   AddDetail( ({"spitzen","spitze","zweige","zweig"}),
     "Dauernd musst Du sie entfernen, damit nichts kaputt geht, aber die "
     "Zweige zerkratzen Dich und Deine Ruestung schon etwas.");

   AddDetail( ({"ruestung"}), "Keine da?");

   AddDetail( ({"richtung","richtungen"}),
     "Nein, die solltest Du mittlerweile schon auswendig kennen, da wird jetzt"
     " nichts mehr erklaert.");

   AddDetail( ({"westen","sueden","suedosten","suedwesten"}),
     "Richtungen.");

   AddDetail( ({"buesche"}),
     "Zusammen mit dem Unterholz verwehren sie Dir, einen Weg nach Sueden zu "
     "finden und Du bist auch der Meinung hier ist irgendwas in einem Busch.");

   AddDetail( ({"unterholz"}),
     "Hier ist es so dicht, wie Du es kaum wo sonst gesehen hast. Da ist kein "
     "Durchkommen.");

   AddDetail( ({"durchkommen"}),
     "Keines.");

   AddDetail( ({"keines"}),
     "Du Boeses Kleines Script.");

   AddDetail( ({"Du","boeses","kleines","script"}),
     "[Tod:Lars] Scripten hat gerade Justavius umgebracht.\n"
     "[Tod:Ein boeses, boeses Script] Ich bin eben lebensgefaehrlich "
     "gruendlich.\nEinen hats schon, bist Du auch bald soweit?\n");

   AddDetail( ({"meinung"}),
     "Du kannst Dir was auf Deine Meinung einbilden.");

   AddSpecialDetail( ({"busch"}), "glas");
     /*"Da ist tatsaechlich was im Busch. Nachdem Du ein bisschen im Unterholz "
     "gestoebert hast, siehst Du einen Stein der aussieht wie ein kleiner, in "
     "Glas gegossener, linker Arm. Du kannst ihn leider nicht nehmen, da er "
     "zerbrochen ist.");
/*hier haett ich die idee, auf der ganzen insel so kleine glastotenteile zu 
verteilen mit denen man sich irgendwie a bisserl gegen die wirkung der insel 
schuetzen kann (wahrscheinlich werdens einige am anfang brauchen wenns dort 
forschen oder nekros werden wollen und sich net auskennen noch dort ... anderen koennts natuerlich auch helfen, ma muss halt nur alle 7 teilen finden.*/

   AddDetail( ({"glas"}),
     "Sehr durchsichtig und oft schnell kaputt.");

   AddDetail( ({"arm","stein"}),
     "Man sieht den Oberarmknochen, Elle, Speiche und die Fingerknochen.");

   AddDetail( ({"oberarmknochen","elle","speiche","fingerknochen","knochen"}),
     "Hast Du sicher auch in deinem Arm, aber versuch bloss nicht jeden bei Dir"
     " fuehlen zu wollen.");

   AddDetail( ({"felsklotz","klotz", "einiges"}),
     "Du kannst von hier aus nur sehen, dass er alle Baeume rundherum um "
     "Einiges ueberragt. Wenn Du mehr wissen willst, musst Du naeher "
     "hingehen.");

   AddDetail( ({"weg","pfad"}),
     "Der Weg fuehrt Dich entweder nach Westen in Richtung des Lavafalls oder "
     "nach Suedosten in Richtung des grossen Felsklotzes.");

   AddDetail( ({"lavafall"}),
     "Er stuerzt vom Rand der obersten Klippe hinunter bis auf den Boden "
     "hinuntern, wo er dann zu verschwinden scheint.");

   AddDetail( ({"klippe"}),
     "Die kannst Du aus dieser Entfernung auch nur mehr ungenau ausmachen. "
     "Wenn Du sie genau sehen willst, musst Du wohl oder uebel naeher hin"
     "gehen.");

   AddDetail( ({"entfernung"}),
     "Du bist ja auch schon einigermassen weit weg davon.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Neben dem heissen Wasser aus dem See riechst Du hier ziemlich stark "
     "einen modrigen Geruch, wie nach fortgeschrittener Verwesung oder "
     "fauliger Erde.");

   AddSmell( ({"wasser"}),
     "Zieh Dir nicht zu viel davon rein, es koennte schaedlich fuer Dich "
     "sein.");

   AddSmell( ({"see"}),
     "Riecht nach Wasser. Hast Du was anderes erwartet?");

   AddSmell( ({"geruch"}),
     "Er scheint hier von ueberall auszugehen, von den Baeumen, aus dem Boden, "
     "einfach aus allem.");

   AddSmell( ({"erde","baeume","boden"}),
     "Riecht wie stinkende, verrottende Erde, wie sie sonst nur am Friedhof "
     "oder auf einem Komposthaufen zu finden ist.");

   AddSmell( ({"friedhof","komposthaufen"}),
     "Da riecht es auch genauso wie hier.");

//Geraeusche:
   AddSound(DEFAULT_SOUND,
     "Neben dem Klatschen der Wellen kannst Du hier noch das Knistern der "
     "Blitze, ein dumpfes Klopfen und das Knarren der Baeume und Buesche "
     "wahrnehmen.");

   AddSound( ({"knarren","baeume","buesche"}),
     "Knniiiiiiiiiirz, knaaaaarrrrrsch, krrraaaaaaach.");

   AddSound( ({"wellen","klatschen"}),
     "Stetig und unermuedlich rollen sie an und klatschen dabei an der Insel "
     "auf.");

   AddSound( ({"insel"}),
     "Du lauschst an der Insel, hoerst aber nichts besonderes.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander reiben "
     "wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","pulsieren","leuchten"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"klopfen"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren und Leuchten im Berg zu "
     "hoeren.");

   AddSound( ({"berg"}),
     "Auch wenn Du es nicht wahrhaben willst, der Berg scheint dich noch immer "
     "in irgendeiner Weise anzuziehen.");

   AddSound( ({"weise"}),
     "Eine unheimliche Weise.");
     
   AddDetail( ({"detail", "scriptfalle", "justavius", "c", "ich", "rand", "tod",
                "verwesung", "waende"}), 
     "Das naechste Detail, das Du untersuchst loest eine Scriptfalle aus.");

//Exits:
   AddExit("suedosten", ROOM "i3_am_grossen_felsen");
   AddExit("westen", ROOM "g2_lavafall_am_see");
   AddItem(NPC "druid", REFRESH_DESTRUCT);
   ob=present("\ndruidenzirkel_npc", TO);
   if(ob) ob->customize("semerra");
}
string glas()
{
  string s;
  object ob;
  
  if(i)
  { 
    s = "Da ist tatsaechlich was im Busch. Nachdem Du ein bisschen im "
        "Unterholz gestoebert hast, siehst Du einen Stein der aussieht wie ein "
        "kleiner, in Glas gegossener, linker Arm. ";
    ob=clone_object(OBJ "arm_links");
    ob->move(TO, M_NOCHECK | M_SILENT);
    i=0;
    return BS(s); 
  }
  s = "Da ist tatsaechlich nichts im Busch. Nachdem Du ein bisschen im "
      "Unterholz gestoebert hast, ziehst Du deinen Arm enttaeuscht wieder "
      "herraus. Vielleicht spaeter nocheinmal?";
  return BS(s); 
}
void reset()
{
  object ob;
  
  if(!present("\nglas_arm_links")) {i=1;}
  
  ::reset();
  
   ob=present("\ndruidenzirkel_npc", TO);
   if(ob) ob->customize("semerra");
}
