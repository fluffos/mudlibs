#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  ::create();
  
   SetProp(P_INT_SHORT, "An einem Lavafall");
   SetProp(P_INT_LONG,
     "Du stehst hier auf einer der hoeheren Klippen der Insel. Felsen liegen "
     "hier ueberall herum, und auch einige kleinere Steine sind zu sehen. "
     "Alles besteht hier aus einem schwarzen Gestein, und auch die "
     "verkrueppelten Buesche und Baeume wachsen hier nicht. Die Hoehlendecke "
     "hier ueber Dir kommt einem auch noch recht duester vor. Im Westen, "
     "weiter ueber Dir, siehst Du den oberen Rand einer der hoechsten "
     "Klippen.");
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"insel"}),
     "Egal wie oft Du 'Insel' noch untersuchst, aendern wird sich an ihrem "
     "Aussehen trotzdem nichts.");

   AddDetail( ({"westen"}),
     "Da ragt eine Klippe hoch auf. Von hier aus kommst Du aber nicht direkt "
     "hinauf.");

   AddDetail( ({"rand"}),
     "Du siehst leider nicht ueber ihn hinaus.");

   AddDetail( ({"aussehen"}),
     "Das muesstest Du jetzt doch schon eigentlich kennen, oder?");

   AddDetail( ({"hoehlendecke","decke"}),
     "Die Decke ist hier so verhangen, dass Du sie gar nicht wirklich sehen "
     "kannst.");

   AddDetail( ({"boden"}),
     "Da liegen Felsen und einige Steine herum.");

   AddDetail( ({"klippe","klippen"}),
     "Eigentlich gibts hier kaum etwas zu sehen bis auf den Lavafall, der die "
     "Felswand herunterstuerzt.");

   AddDetail( ({"felswand"}),
     "So koennte man die Klippe auch nennen.");

   AddDetail( ({"lavafall"}),
     "Er faellt von oben ziemlich senkrecht herunter, streift ein paar Felsen, "
     "wobei ein paar Lavaspritzer entstehen und verschwindet in einem Riss im "
     "Boden. Das wird wohl eine der seltsamen 'Adern' sein die Du von weitem "
     "wahrgenommen hast. Wegen dem Licht und der Dunkelheit tanzen hier die "
     "Schatten etwas und Du meinst einige befinden sich gar nicht mehr auf "
     "einer festen Oberflaeche sondern scheinen sich Dir irgendwie "
     "zu naehern.");

   AddDetail( ({"oberflaeche","flaeche"}),
     "Hier tanzen mehr Schatten als sonst wo herum. Sie scheinen sich aber "
     "auch hier davon loesen zu wollen und strecken sich Dir mit verzerrten "
     "Gesichtern entgegen.");

   AddDetail( ({"gesichter"}),
     "Zerrbilder des Schreckens.");

   AddDetail( ({"zerrbilder","bilder"}),
     "Verzerrt. Abnormal. Schrecklich.");

   AddDetail( ({"schrecken","schreckens"}),
     "    _  .-'-'--'-'-.  _      \n"
     "   | \\/  .-.  .-.  \\/ |   \n"
     "   |_/   |0|  |!|   \\_|    \n"
     "   | \\   `-'°°`-'   / |    \n"
     "   |_/\\  .--/\\--.  /\\_|  \n"
     "       | `\\/--\\/´ |       \n"
     "       `----------´         \n"); 

   AddDetail( ({"licht"}),
     "Das kommt von der gluehenden Lava.");

   AddDetail( ({"dunkelheit","schatten"}),
     "Die Schatten entstehen aus der Dunkelheit heraus.");

   AddDetail( ({"lavaspritzer","spritzer"}),
     "Da solltest Du lieber ganz schoen vorsichtig sein, damit Dich keiner "
     "erwischt.");

   AddDetail( ({"riss","risses"}),
     "Wie Du sicher schon mehrmals hier auf der Insel gesehen hast, "
     "verschwindet die Lava ganz einfach wieder in den Untergrund ohne viele "
     "Spuren zu hinterlassen.");

   AddDetail( ({"spuren"}),
     "Das einzige was hier an sie erinnert ist der Geruch und die Lavaspritzer "
     "die seitlich des Risses landen.");

   AddDetail( ({"untergrund"}),
     "Zurueck unter die Insel vermutlich, vielleicht ist ja unter dem See ein "
     "noch gefaehrlicherer Lavasee.");

   AddDetail( ({"see"}),
     "Welchen See meinst Du jetzt?");

   AddDetail( ({"lavasee"}),
     "Sehen kannst Du ihn nicht, aber Du weisst das die Lava doch schliesslich "
     "von irgendwo auch herkommen muss.");

   AddDetail( ({"geruch"}),
     "Den willst Du sehen?");

   AddDetail( ({"baeume","buesche","baum","busch"}),
     "Die siehst Du hier nirgends.");

   AddDetail( ({"ader","adern"}),
     "Na der Lavafall, was denn sonst?");

   AddDetail( ({"lava"}),
     "Geschmolzenes Gestein.");

   AddDetail( ({"felsen","fels","steine","gestein"}),
     "Es ist ein nachtschwarzes Material, das entfernt an Basalt oder Obsidian "
     "erinnert.");

   AddDetail( ({"material","materialien","basalt","obsidian"}),
     "Das sieht eben wie Vulkangestein aus.");

   AddDetail( ({"vulkangestein"}),
     "Wird von einem Vulkan ausgespuckt.");

   AddDetail( ({"vulkan"}),
     "Der spuckt Vulkangestein aus.");

//Geraeusche:
    AddSound(DEFAULT_SOUND,
     "Neben dem Aufklatschen der Lavatropfen kannst Du hier noch das Knistern "
     "der Blitze und ein dumpfes Klopfen wahrnehmen.");

   AddSound( ({"lavatropfen","tropfen"}),
     "Es wuerde Deiner Gesundheit nicht sehr gut tun daran zu lauschen.");

   AddSound( ({"gesundheit"}),
     "Je laenger Du Dich hier auf der Insel aufhaeltst, desto lauter sagt Deine"
     " Gesundheit: 'Auf Wiedersehen'.");

   AddSound( ({"insel"}),
     "Du lauschst an der Insel, hoerst aber nichts besonderes.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander reiben "
     "wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","pulsieren","leuchten"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"klopfen"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren und Leuchten im Berg zu "
     "hoeren.");

   AddSound( ({"berg"}),
     "Auch wenn Du es nicht wahrhaben willst, der Berg scheint dich noch immer "
     "in irgendeiner Weise anzuziehen.");

   AddSound( ({"weise"}),
     "Eine unheimliche Weise.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Du riechst etwas Schwefel und viel heisse Luft.");

   AddSmell( ({"luft"}),
     "Riecht nach leicht angesengten Nasenhaaren.");

   AddSmell( ({"nasenhaar","nasenhaaren", "nasenhaare"}),
     "Buah riecht das grauslich.");

   AddSmell( ({"schwefel"}),
     "Riecht wie halbverfaulte Eier."); 

   AddSmell( ({"eier"}),
     "Das ist nur eine Redewendung.");

   AddSmell( ({"redewendung"}),
     "Du willst SOWAS riechen?");
     
   AddDetail( ({"aufklatschen", "waende", "wand", "sowas", "wiedersehen"}),
     "Uebertreibe es ja nicht!");

//Die Exits:

   AddExit("norden", ROOM "g3_geroellhang");
   AddExit("suedwesten", ROOM "f5_wegkreuzung");
}