#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  
  object ob;
  
  ::create();
   SetProp(P_INT_SHORT, "Ein gefaehrliches Eck");
   SetProp(P_INT_LONG,
     "Hui, wo bist Du da jetzt schon wieder gelandet? Die Bruecke hast Du schon"
     " hinter Dir gelassen, dafuer geht es hier wieder leicht bergab. Links und"
     " rechts, unterhalb des breiter werdenden Wegs, brodelt weiter das heisse"
     " Wasser. Nicht weit vor Dir durchzieht ein schmaler, langgezogener Riss "
     "den Boden. Die Hoehlendecke ist auch hier kaum sichtbar.");
   SetProp(P_LIGHT, 0);
/*kann man das hier so einbauen, dass wenn die stichflamme kommt es hell wird 
(wenns dunkel war) und wieder dunkel sobald sie verschwindet?*/
//Erledigt
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"hoehlendecke"}),
     "Die Decke hier ist so verhangen und von Blitzen umzuckt, dass Du sie "
     "nicht wahr nehmen kannst.");

   AddDetail( ({"blitz","blitze"}),
     "Die zucken durch die Schwaden.");

   AddDetail( ({"schwaden"}),
     "Die sind an der Decke.");

   AddDetail( ({"boden"}),
     "Da liegen ueberall Felsen und Steine herum.");

   AddDetail( ({"decke"}),
     "Verhangen und duester ist sie ueber Dir.");

   AddDetail( ({"felsen","fels","steine","gestein","geroell"}),
     "Es ist ein nachtschwarzes Material, das entfernt an Basalt oder Obsidian"
     " erinnert.");

   AddDetail( ({"material","materialien","basalt","obsidian"}),
     "Das sieht eben wie Vulkangestein aus.");

   AddDetail( ({"vulkangestein"}),
     "Wird von einem Vulkan ausgespuckt.");

   AddDetail( ({"vulkan"}),
     "Der spuckt Vulkangestein aus.");

   AddDetail( ({"bruecke"}),
     "Die liegt im Norden hinter Dir und Du siehst von hier einen Teil des "
     "unter spuelten Brueckenbogens.");

   AddDetail( ({"norden"}),
     "Da ist die Bruecke.");

   AddDetail( ({"teil"}),
     "Sozusagen das letzte Eck der Nordseite des Bogens."),

   AddDetail( ({"eck"}),
     "Das ist nur so dahin gesagt.");

   AddDetail( ({"nordseite","seite"}),
     "Die Seite die nach Norden gerichtet ist.");

   AddDetail( ({"bogen","brueckenbogen"}),
     "Viel ist da nicht zu sehen.");

   AddDetail( ({"weg"}),
     "Nenn es Weg, nenn es Abhang, nenn es wie Du willst, auf jeden Fall "
     "kommst Du hier in zwei Richtungen weiter.");

   AddDetail( ({"fall"}),
     "Pass auf das Du nicht ausrutschst und hinfaellst.");

   AddDetail( ({"norden","nordosten","suedosten"}),
     "Eine Richtungsangabe.");

   AddDetail( ({"richtung","richtungsangabe", "richtungen"}),
     "Nordosten und Suedosten.");

   AddDetail( ({"abhang"}),
     "Es geht abwaerts, Geroell liegt herum, also kann man auch getrost "
     "Abhang dazu sagen.");

   AddDetail( ({"wasser"}),
     "Das kann Dir hier nichts anhaben.");

   AddDetail( ({"riss"}),
     "Du koenntest locker ueber den Riss steigen, denn er ist nicht recht "
     "breit. Du zoegerst dennoch, weil von Zeit zu Zeit eine riesige "
     "Stichflamme aus dem Riss herausschiesst.");

   AddDetail( ({"zeit"}),
     "So ca. alle 30 Sekunden.");

   AddDetail( ({"sekunde","sekunden"}),
     "60 Sekunden hat die Minute.");

   AddDetail( ({"minute"}),
     "60 Minuten hat die Stunde.");

   AddDetail( ({"stunde"}),
     "Du rechnest nach und kommst zu dem Schluss: 120 mal schiesst eine "
     "Stichflamme in der Stunde aus dem Riss.");

   AddDetail( ({"schluss"}),
     "Aus.");

   AddDetail( ({"stichflamme"}),
     "Heiss und feurig schiesst sie einige Meter hoch.");

   AddDetail( ({"meter"}),
     "Eine Masseinheit.");

   AddDetail( ({"masseinheit","einheit","mass"}),
     "Ein Meter.");

//Geraeusche:
   AddSound(DEFAULT_SOUND,
     "Neben dem Fauchen der Flammen hoerst Du die Wellen sanft aber "
     "bestaendig an den Felsen nagen. Es uebertoent auch das Knistern und das"
     " Klopfen das man hier sonst ueberall hoeren kann.");

   AddSound( ({"knistern","klopfen"}),
     "Kannst Du zwar nicht hoeren, aber Du bist Dir sicher, dass es da ist.");

   AddSound( ({"fauchen","flammen"}),
     "Stell Dir einen Hochofen vor aus dem das gluehende Metall heraus "
     "schiesst. So ungefaehr hoert sich das an.");

   AddSound( ({"hochofen"}),
     "Hier ist keiner.");

   AddSound( ({"metall"}),
     "Da hier kein Hochofen ist, ist hier logischerweise auch kein Metall.");

   AddSound( ({"wellen"}),
     "Wenn Du Wellen so weitermachen wird in vielen hunderttausend Jahren die "
     "Insel voellig vom Wasser zerfressen sein.");

   AddSound( ({"jahren","jahre"}),
     "Du hoerst die Jahre an Dir vorbeirauschen. *PLOPP* Ploetzlich bist Du "
     "120 Jahre alt.");

   AddSound( ({"insel","felsen"}),
     "Du lauschst angestrengt daran, hoerst aber nichts.");

   AddSound( ({"saeure"}),
     "Die wirst Du bestimmt nicht erlauschen koennen.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Du riechst nur heisse Luft.");

   AddSmell( ({"luft"}),
     "Heisse Luft produzierst Du auch oft genug. Daher weisst Du genau wie "
     "das riecht.");
     
   AddDetail( ({"waende", "wand", "ploetzlich", "genaues"}),
     "Du kannst nichts Genaues erkennen. Sie sind zu weit weg.");

//Die Exits:

   AddExit("nordostoben", ROOM "b4_bruecken");
   AddExit("suedosten", ROOM "b6_weg_zum_inselchen");
   AddItem(NPC "druid", REFRESH_DESTRUCT);
   ob=present("\ndruidenzirkel_npc", TO);
   if(ob) ob->customize("drakith");
   
   AddRoomMessage( ({BS("Eine Stichflamme faucht empor.\n")}), 30, "light");
   
}
void reset()
{
  object ob;
  
  ::reset();
  
  ob=present("\ndruidenzirkel_npc", TO);
  if(ob) ob->customize("drakith");
}

light (int msg)
{
  SetProp(P_LIGHT, 1);
  call_out("dark", 2);
}

void dark()
{
  SetProp(P_LIGHT, 0);
  return; 
}