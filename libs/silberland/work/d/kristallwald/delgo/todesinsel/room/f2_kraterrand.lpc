#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  
  object ob;
  
  ::create();

   SetProp(P_INT_SHORT, "Beim nordoestlichen Monolithen");
   SetProp(P_INT_LONG,
     "Vor Dir ragt ein verdrehter Monolith in die Hoehe, aehnlich einem "
     "duerren Finger einer verkrampften Hand. Er biegt sich Richtung "
     "Suedwesten, wo er mit anderen Monotlithen eine Art Kuppel ueber den "
     "Krater bildet. Du fuehlst ein Pulsieren in Dir, so als wuerde Dich "
     "unendliche Macht durchstroemen. Die Hoehlendecke hier ueber Dir kommt "
     "einem noch duesterer vor als sonstwo. Hinter dem Monolithen fliesst Lava "
     "die steile Felswand bis zu einer tiefergelegenen Klippe runter.");
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"hoehlendecke"}),
     "Dunkel und verhangen ist die Decke ueber Dir und auch kein bisschen "
     "naeher als vorher.");

   AddDetail( ({"lava"}),
     "Sie fliesst knapp unterhalb des Monolithen aus einer Oeffnung in einem "
     "kleinen Lavafall auf die darunterliegende Klippe.");

   AddDetail( ({"oeffnung"}),
     "Ja, BITTE ... steck doch >einmal< Deinen Kopf da rein damit Du siehst "
     "wie es da drinnen aussieht. Ausser ein paar Edelsteinen, Metallen und "
     "Lava ist da aber auch nicht viel zu sehen.");

   AddDetail( ({"kopf"}),
     "Glaubst Du, das der danach noch dran ist, wenn Du mit Lava "
     "shampoonierst?");

   AddDetail( ({"lavafall"}),
     "Ein nie enden wollender Strom von Lava kommt da raus. Koennten das "
     "eventuell die pulsierenden Adern sein, die Du vorher von unten gesehen "
     "hast?");

   AddDetail( ({"strom","fluss"}),
     "So kannst Du den Lavafluss auch nennen.");

   AddDetail( ({"lavafluss","lavastrom","lavastroeme"}),
     "Ein nie enden wollender Fluss.");

   AddDetail( ({"adern"}),
     "Die Lava kommt immer synchron mit dem Pulsieren der Macht hier aus der "
     "Oeffnung geflossen. Das erklaert einiges.");

   AddDetail( ({"boden"}),
     "Der besteht wie ueberall hier aus diesem seltsamen schwarzen Gestein.");

   AddDetail( ({"gestein"}),
     "Dunkelschwarz. Du hast noch nie ein aehnliches Gestein gesehen. Es sieht "
     "extrem hart und wiederstandsfaehig aus.");

   AddDetail( ({"felswand","klippe", "klippen"}),
     "Hui, da gehts zwar immer noch runter, aber nicht so steil wie an den "
     "Stellen wo keine kleineren Klippen darunter sind. An Deiner Stelle wuerde"
     " ich trotzdem da nicht zu nahe zum Rand gehen.");

   AddDetail( ({"stelle","stellen"}),
     "Da ich nicht an Deiner Stelle bin musst Du das schon selbst wissen.");

   AddDetail( ({"rand"}),
     "Wie mit einem Zirkel gezogen, zieht er sich rund um das ganze Plateau."); 

   AddDetail( ({"plateau"}),
     "Das ist hier oben, da unten ist eine kleine Klippe und wenn Du da "
     "runterfaellst, tust Du Dir sicher sehr weh.");

   AddDetail( ({"zirkel"}),
     "Da ist natuerlich keiner, das ist nur so dahin gesagt.");

   AddDetail( ({"decke"}),
     "Immer noch da oben, egal wie oft Du es auch untersuchst.");

   AddDetail( ({"hoehe"}),
     "Ist immer oben.");

   AddDetail( ({"richtung","richtungen","suedosten"}),
     "Ueber Richtungen haben sich schon zu viele ausgelassen, darum hier keine "
     "Diskussion mehr darueber.");

   AddDetail( ({"diskussion"}),
     "Nein.");

   AddDetail( ({"monolith"}),
     "Verdreht und verwittert, dennoch ungebeugt ragt dieser Monolith Richtung "
     "Decke. Auf einer Seite ist eine Rune in den Stein eingelassen.");
  
  AddDetail( ({"seite"}),
     "Die Seite, die Dir zugewandt ist, traegt die Rune.");

  AddDetail( ({"rune"}),
     "Die Rune stellt Viereck dar."),
 
   AddDetail( ({"viereck"}),
     "Offenbar ein Symbol fuer Erz und Metall. Hier wurde es aber seltsam "
     "verunstaltet.");

   AddDetail( ({"symbol"}),
     "Das Viereck.");

   AddDetail( ({"erz","metall"}),
     "Das wuerde auch die Ablagerungen der seltenen Metalle und Edelsteine an "
     "der Oeffnung erklaeren. Dich beschleicht ein ungutes Gefuehl hier.");

   AddDetail( ({"edelsteine","edelstein","ablagerung", "ablagerungen"}),
     "Sie entstehen sicher aus der erkalteten Lava.");

   AddDetail( ({"gefuehl"}),
     "Du bist Dir nun sehr sicher dass das hier so eine Art negativen "
     "Druidenzirkel darstellen soll, sozusagen ein Gegenstueck zu den "
     "neutralen Kraeften der Druiden, quasi chaotisch und unberechenbar, "
     "wie auch die Natur manchmal auftritt."),

  AddDetail( ({"druidenzirkel"}),
     "Anvar steht dort herum und erzaehlt jedem von den Elementen und den "
     "Kraeften der Natur. Ob er von diesem Ort hier weis?");

   AddDetail( ({"elemente","anvar","ordnung"}),
     "Geh zu ihm und lass sie Dir von ihm erklaeren.");

   AddDetail( ({"kraefte","natur"}),
     "Die Kraefte der Natur koennen einerseits aufbauend und hilfreich sein, "
     "andererseits aber auch zerstoererisch und unberechenbar sein.");

   AddDetail( ({"ort"}),
     "Das ist zu bezweifeln ... und selbst wenn er es wuesste wuerde er hier "
     "nichts ausrichten koennen, den dies hier ist der Ort wo das Gegengewicht "
     "zum Gleichgewicht der Elemente ist, das Chaos sozusagen.");

   AddDetail( ({"gleichgewicht"}),
     "Pass auf das Du Deines hier nicht verlierst und hinunter purzelst.");

   AddDetail( ({"gegengewicht"}),
     "ALLES hat ein Gegengewicht; auch die natuerliche Ordnung.");

   AddDetail( ({"chaos"}),
     "Hier siehts ungefaehr so unordentlich aus wie in deinem Zimmer.");

   AddDetail( ({"zimmer"}),
     "Los, aufraeumen, aber zackzack."),

   AddDetail( ({"pulsieren","macht","kraft"}),
     "Du spuerst foermlich wie Dein Koerper unter dem Ansturm dieser Kraft "
     "zittert.");

   AddDetail( ({"koerper"}),
     "Er erbebt foermlich.");

   AddDetail( ({"ansturm"}),
     "Du kannst Dich kaum noch aufrecht halten.");

   AddDetail( ({"finger","hand"}),
     "Nur ein bildlicher Vergleich. Du hast doch sicher noch nirgends eine "
     "Hand mit acht Fingern gesehen oder?");

   AddDetail( ({"vergleich","waffenexperte"}),
     "Wenn Du etwas vergleichen willst, geh zum einem Waffenexperten.");

   AddDetail( ({"art","kuppel"}),
     "Naja, keine wirklich Kuppel, nur die Andeutung einer solchen.");

   AddDetail( ({"andeutung"}),
     "Willst Du hier irgendwas andeuten?");

   AddDetail( ({"krater"}),
     "Du befindest Dich auf einem schmalen Weg der rund um den Krater an "
     "dessen Rand herumfuehrt.");

   AddDetail( ({"innere","inneren"}),
     "Du siehst einen aktiven Lavasee im Inneren des Kraters. Hin und wieder "
     "werden auf unerklaerliche Weise Lavastroeme an den Waenden hochgedrueckt "
     "und fliessen anscheinend durch die Kraterwaende."
     "Beug Dich nicht zu weit nach unten, sonst faellst Du noch runter.");

   AddDetail( ({"lavasee","see"}),
     "Die ist sicher verdammt heiss.");

   AddDetail( ({"weise"}),
     "Unerklaerlich. Nicht mal mir ist etwas eingefallen ;) ");

   AddDetail( ({"kraterwaende","waende"}),
     "Hier wird die Lava durch die Oeffnung nach aussen gedrueckt.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Du riechst eigentlich nur die Gase die aus der Oeffnung mit der Lava "
     "austreten.");

   AddSmell( ({"gase","schwefel"}),
     "Igitt ... riecht wie verfaulte Eier.");

   AddSmell( ({"eier"}),
     "Du riechst an der Oeffnung und kommst zum darauf das es nur Schwefel sein"
     " kann der hier so bestialisch riecht.");

   AddSmell( ({"oeffnung","lava"}),
     "Noch naeher und Deine Nasenfluegel, sind mit dem Rest Deines Gesichts "
     "nur noch Geschichte.");

   AddSmell( ({"nasenfluegel","rest","gesicht","geschichte"}),
     "Nein, das kannst Du nicht riechen und schon gar nicht untersuchen.");

   AddDetail( ({"nasenfluegel","rest","gesicht","geschichte"}),
     "Wie gesagt ... DAS kannst Du NICHT untersuchen.");

//Geraeusche:
   AddSound(DEFAULT_SOUND,
     "Neben dem Knistern der Blitze und dem hier staerker werdenden dumpfen "
     "Klopfen kannst Du aus Richtung des Monolithen staendig leise Stimmen, "
     "die mal drohender mal flehender werden wahrnehmen.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander reiben "
     "wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","pulsieren","leuchten"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"klopfen"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren des Leuchtens im Berg zu"
     " hoeren. Es duerfte irgendwo hier oben seinen Ursprung haben.");

   AddSound( ({"berg"}),
     "Auch wenn Du es nicht wahrhaben willst, der Berg scheint dich noch immer "
     "in anzuziehen.");

   AddSound( ({"richtung"}),
     "Richtungen kann man doch nicht hoeren.");

   AddSound( ({"monolith"}),
     "Er vibriert leise.");

   AddSound( ({"stimmen","sprache"}),
     "Die Stimmen sprechen in einer Dir unbekannten Sprache, daher verstehst "
     "Du auch nicht was sie sagen.");
     
   AddDetail( ({"bitte", "deines", "druiden", "gegenstueck", "monotlithen", 
                "nicht", "stein", "ursprung", "waende", "wand", "weg"}),
     "Nicht uebertreiben!");

//Die Exits:

   AddExit("sueden", ROOM "f3_kraterrand");
   AddExit("westen", ROOM "e2_kraterrand");
   AddItem(NPC "druid", REFRESH_DESTRUCT);
   ob=present("\ndruidenzirkel_npc", TO);
   if(ob) ob->customize("leldor");
}
void reset()
{
  object ob;
  
  ::reset();
  
   ob=present("\ndruidenzirkel_npc", TO);
   if(ob) ob->customize("leldor");
}