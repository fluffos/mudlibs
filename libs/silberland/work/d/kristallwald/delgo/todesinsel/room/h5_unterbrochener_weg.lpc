#include "../def.h"
#include <properties.h>

inherit "std/room";


void create()
{
  ::create();
  
   SetProp(P_INT_SHORT, "Der unterbrochene Weg");
   SetProp(P_INT_LONG,
     "Wo bist Du nun schon wieder gelandet? Hier scheint es nicht weiter zu "
     "gehen, denn vor Dir tut sich ein mindestens zwei Meter breiter Riss im "
     "Boden auf, der Dich entweder dazu zwingt, dahin umzukehren wo Du her "
     "gekommen bist, oder zu versuchen eine andere Moeglichkeit zu finden, um "
     "irgendwie auf die andere Seite zu kommen. Durch den Riss fliesst zu "
     "allem Ueberfluss auch noch das heisse Wasser vom See in ein kleines "
     "Becken nebem dem Weg. Die Hoehlendecke ist, wie ueberall hier, ziemlich "
     "turbulent und aufgewuehlt.");
   SetProp(P_LIGHT, 0);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"hoehlendecke","decke"}),
     "Die Hoehlendecke ist soweit oben und so verhangen, dass Du sie gar nicht "
     "wirklich siehst.");

   AddDetail( ({"boden"}),
     "Da liegen ueberall Felsen und Steine herum.");

   AddDetail( ({"felsen","steine","gestein","fels"}),
     "Es ist ein nachtschwarzes Material, das entfernt an Basalt oder Obsidian "
     "erinnert.");

   AddDetail( ({"material","materialien","basalt","obsidian"}),
     "Das sieht eben wie Vulkangestein aus.");

   AddDetail( ({"vulkangestein"}),
     "Wird von einem Vulkan ausgespuckt.");

   AddDetail( ({"vulkan"}),
     "Der spuckt Vulkangestein aus.");

   AddDetail( ({"insel"}),
     "Egal wie oft Du die Insel noch untersuchst, es aendert sich deswegen "
     "auch nichts an ihr.");

   AddDetail( ({"meter"}),
     "Eine Masseinheit. Der Meter hat immer hundert Zentimeter, sogar hier.");

   AddDetail( ({"masseinheit","einheit","mass"}),
     "Ein Meter. Ein Zentimeter. Ein Millimeter. Alles Masseinheiten.");

   AddDetail( ({"zentimeter"}),
     "Ein Zentimeter besteht aus zehn Millimetern.");

   AddDetail( ({"millimeter"}),
     "Tausend Millimeter sind ein Meter.");

   AddDetail( ({"riss"}),
     "Eigentlich ist es ja kein wirklicher Riss, sondern nur eine Stelle wo "
     "sich das Wasser schon laengst durch das Gestein gefressen hat, aber man "
     "kann es ruhigen Gewissens auch einen Riss nennen, wenn man will, denn es "
     "geht hier auch sicher noch einen Meter in die Tiefe bevor man auf das "
     "kochende Wasser trifft.");

   AddDetail( ({"gewissen"}),
     "Dein Gewissen raet Dir, diese Insel so schnell wie moeglich zu "
     "verlassen.");

   AddDetail( ({"tiefe"}),
     "Hier, genau unter Dir.");

   AddDetail( ({"stelle"}),
     "Hier, genau vor Dir.");

   AddDetail( ({"wasser"}),
     "Du siehst es im See und in dem kleinen Becken unterhalb der Felswand, "
     "das durch den Riss gespeist wird. Und mit jedem weiteren Schwall, der "
     "durch den Zufluss stroemt, glaubst Du zu bemerken, dass sich der Riss um "
     "ein paar Millimeter erweitert hat.");

   AddDetail( ({"felswand","wand"}),
     "Die ragt etwas weiter im Westen und Nordwesten vor Dir auf.");

   AddDetail( ({"see"}),
     "Hier kann er Dir wieder besonders gefaehrlich werden, denn wenn Du "
     "versuchst den Riss zu ueberqueren und scheiterst, wirst Du wohl oder "
     "uebel mit dem Wasser Bekanntschaft machen.");

   AddDetail( ({"bekanntschaft"}),
     "Eine echt aufloesende Lebensgefaehrtin.");

   AddDetail( ({"lebensgefaehrtin"}),
     "Die Mehrzahl von Lebensgefahr.");

   AddDetail( ({"mehrzahl"}),
     "Wenn etwas oefter als einmal vorhanden ist.");

   AddDetail( ({"lebensgefahr"}),
     "Hier auf der Insel bist Du stets in Lebensgefahr.");

   AddDetail( ({"becken", "schwimmen"}),
     "Zum Schwimmen ist das sicher nicht geeignet.");

   AddDetail( ({"schwall"}),
     "Jeder Schwall aetzt ein kleines bisschen vom Fels weg.");

   AddDetail( ({"bisschen"}),
     "Gaaanz, gaaanz wenig.");

   AddDetail( ({"zufluss"}),
     "Der Riss!");

   AddDetail( ({"moeglichkeit"}),
     "Nun ja, Du koenntest ja entweder direkt hindurch waten, oder eventuell "
     "mit einem beherzten Satz darueber springen. Beides birgt aber je ein "
     "Risiko.");

   AddDetail( ({"risiko"}),
     "Deine Stiefel koennten sich aufloesen oder Du erreichst den anderen Rand "
     "nicht, prallst ab und stuerzt kopfueber in das Wasser hinein und wirst "
     "gekocht.");

   AddDetail( ({"stiefel"}),
     "Ohne Stiefel waere, durch den Riss zu waten, glatter Selbstmord fuer "
     "Deine Fuesse.");

   AddDetail( ({"selbstmord","fuesse"}),
     "Die waeren dann vollkommen verbrueht.");

   AddDetail( ({"rand"}),
     "Der ist auf der anderen Seite.");

   AddDetail( ({"seite","seiten"}),
     "Alles hat zwei Seiten.");

   AddDetail( ({"ueberfluss"}),
     "Das kochende Wasser fliesst hier ueber in das kleine Becken.");

   AddDetail( ({"weg"}),
     "Der Weg endet hier bzw. er faengt hier an. Kommt immer auf die "
     "Sichtweise an. Auf jeden Fall geht es hier entweder nach Norden oder "
     "Suedwesten weiter.");

   AddDetail( ({"fall"}),
     "Der freie Fall kann hier toedlich sein.");

   AddDetail( ({"norden","suedwesten"}),
     "Nach Suedwesten kommst Du auf die Spitzkehre und im Norden weiter rund "
     "um die Insel.");

   AddDetail( ({"spitzkehre","kehre"}),
     "Die ist nicht hier sondern im Suedwesten.");

   AddDetail( ({"westen","nordwesten"}),
     "Da kannst Du je eine Felswand einer hoeheren Klippe bewundern.");

   AddDetail( ({"klippe"}),
     "Derzeit befindest Du Dich auf keiner.");

   AddDetail( ({"sichtweise"}),
     "Jeder hat eine andere.");

//Geraeusche:
   AddSound(DEFAULT_SOUND,
     "Neben dem Klatschen der Wellen kannst Du hier noch das Knistern der "
     "Blitze und ein dumpfes Klopfen wahrnehmen.");

   AddSound( ({"wellen","klatschen"}),
     "Stetig und unermuedlich rollen sie an und klatschen dabei an der Insel "
     "auf. Dort wo sich der Riss gebildet hat, rollen sie noch weiter bis zur "
     "Felswand.");

   AddSound( ({"insel"}),
     "Du lauschst an der Insel, hoerst aber nichts besonderes.");

   AddSound( ({"felswand"}),
     "Zu der kommst Du von hier aus gar nicht hin ... ausser Du willst in das "
     "Becken steigen und hinwaten.");

   AddSound( ({"becken"}),
     "Gluckert und zischt recht gefaehrlich.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander reiben "
     "wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","pulsieren","leuchten"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"klopfen"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren und Leuchten im Berg zu "
     "hoeren.");

   AddSound( ({"berg"}),
     "Auch wenn Du es nicht wahrhaben willst, der Berg scheint dich noch immer "
     "in irgendeiner Weise anzuziehen.");

   AddSound( ({"weise"}),
     "Eine unheimliche Weise.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Neben dem heissen Wasser aus dem See riechst Du nur die aufgeloesten "
     "Felsen und Deinen Angstschweiss.");

   AddSmell( ({"wasser"}),
     "Zieh Dir nicht zu viel davon rein, es koennte schaedlich fuer Dich sein.");

   AddSmell( ({"see"}),
     "Riecht nach Wasser. Hast Du was anderes erwartet?");

   AddSmell( ({"felsen"}),
     "Tja wie riechen aufgeloeste Felsen eigentlich... . Nachdem Du das auch "
     "nicht wirklich weisst, kannst Du nur spekulieren, dass sie so riechen, "
     "wie sie hier eben riechen.");

   AddSmell( ({"angstschweiss","angst","schweiss"}),
     "Ein nicht allzu unbekannter Geruch fuer Dich, da er Dir doch bei jeder "
     "Kleinigkeit ausbricht.");

   AddSmell( ({"geruch"}),
     "Dein Angstschweiss ist hier gemeint.");

   AddSmell( ({"kleinigkeit"}),
     "Die kann man nicht riechen. Dafuer ist sie zu klein. *G*");
     
   AddDetail( ({"saeuresee", "satz", "waende"}),
     "...");
  

//Exits:
   AddExit("norden", ROOM "h4_geisterwald");
   AddExit("suedwesten",ROOM "g6_spitzkehre");
}