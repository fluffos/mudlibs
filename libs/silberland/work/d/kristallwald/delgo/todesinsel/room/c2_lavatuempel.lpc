#include "../def.h"

inherit "std/room";

#include <properties.h>

int i;

void create()
{
  ::create();
  
  i=1; 
   
   SetProp(P_INT_SHORT, "Am Steinhang");
   SetProp(P_INT_LONG,
     "Du stehst nun an einem Hang etwas ueber dem See. Ueberall liegen Felsen"       " herum, auch kleine Steinchen sind zu sehen. Alles besteht hier aus "
     "einem schwarzen Gestein, wobei hier nicht einmal die verkrueppelten "
     "Buesche und Baeume wachsen, wie andernorts. Die Hoehlendecke scheint "
     "auch hier besonders turbulent zu sein. Im Osten, hoch ueber Dir, siehst "
     "Du den oberen Rand einer sehr hohen Klippe. Ausserdem kannst Du von hier "
     "nur noch auf eine Anhoehe im Sueden gehen.");
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"hoehlendecke"}),
     "An der Decke zucken die Blitze durch die Nebelschwaden.");

   AddDetail( ({"blitze","blitz"}),
     "Pass bloss auf das dich keiner trifft.");
/*kleine fiese idee, leute mit zuviel metallzeugs ziehen hin und wieder einen 
blitz an*/
//gute Idee, aber bissi zu aufwendig a. fuer spiecher und b. fuer den effekt :)

   AddDetail( ({"nebelschwaden","nebel","schwaden"}),
     "Die sind so dicht, dass Du nicht siehst was sich darueber verbirgt.");

   AddDetail( ({"boden"}),
     "Da liegen ueberall Felsen und Steine herum.");

   AddDetail( ({"felswand","wand"}),
     "Ziemlich hoch.");

   AddDetail( ({"hang","abhang"}),
     "Naja, Abhang kann man das hier eigentlich nicht nennen, eigentlich waere "
     "hier Felskueste passender.");

   AddDetail( ({"felskueste","kueste"}),
     "So nennt sich eine Kueste aus Felsen. Sie ragt wie eine Wand im Osten "
     "vor Dir auf.");

   AddDetail( ({"insel"}),
     "Es ist immer noch die selbe Insel wie vorhin.");

   AddDetail( ({"felsen","fels","steine","gestein"}),
     "Es ist ein nachtschwarzes Material, das entfernt an Basalt oder Obsidian"
     " erinnert.");

   AddDetail( ({"material","materialien","basalt","obsidian"}),
     "Das sieht eben wie Vulkangestein aus.");

   AddDetail( ({"vulkangestein"}),
     "Wird von einem Vulkan ausgespuckt.");

   AddDetail( ({"vulkan"}),
     "Der spuckt Vulkangestein aus.");

   AddDetail( ({"steinchen"}),
     "Hier solltest Du besonders aufpassen das Du nicht auf Ihnen ausrutschst"
     ". Es sind hier einige besonders spitze Stellen vorhanden. Du glaubst "
     "einen besonderen Stein zu sehen.");

   AddSpecialDetail( ({"stein"}), "glas");
     /*
     "Dieser Stein sieht aus wie ein kleiner, in Glas gegossener, rechter Arm. "
     "Du kannst ihn leider nicht nehmen weil er zerbrochen ist.");
/*hier haett ich die idee, auf der ganzen insel so kleine glastotenteile zu 
verteilen mit denen man sich irgendwie a bisserl gegen die wirkung der insel 
schuetzen kann (wahrscheinlich werdens einige am anfang brauchen wenns dort 
forschen oder nekros werden wollen und sich net auskennen noch dort ... anderen
koennts natuerlich auch helfen, ma muss halt nur alle 7 teilen finden.*/

   AddDetail( ({"glas"}),
     "Sehr durchsichtig und oft schnell kaputt.");

   AddDetail( ({"arm"}),
     "Man sieht den Oberarmknochen, Elle, Speiche und die Fingerknochen.");

   AddDetail( ({"oberarmknochen","elle","speiche","fingerknochen","knochen"}),
     "Hast Du sicher auch in deinem Arm, aber versuch bloss nicht jeden bei Dir"
     " fuehlen zu wollen.");

   AddDetail( ({"stellen"}),
     "Greif lieber nicht hin, Du koenntest Dich verletzen.");
/*eventuelle ne greif- oder sonstige funktion die einen sich selbst verletzen 
laesst?*/

   AddDetail( ({"baeume","baum","baeumen","busch","buesche"}),
     "Die wachsen hier nicht. Liegt vermutlich an dem kleinen Lavatuempel "
     "hier.");

   AddDetail( ({"lavatuempel","tuempel"}),
     "Der wird von einem kleinen Lavafluss, welcher von der suedlichen Anhoehe "
     "kommt, gespeist, riecht schwefelig, wirft kleine Blasen und gibt "
     "maechtig Hitze ab. Nebenbei bemerkst Du, dass es hier etwas ebener als "
     "sonst ist, sonst wuerde Dir die Lava vermutlich nicht sehr gut tun in "
     "ihrem Fliessverhalten.");

   AddDetail( ({"lava"}),
     "Geschmolzenes Gestein.");

   AddDetail( ({"lavafluss","fluss","lavafluesse","fliessverhalten"}),
     "Fliesst wie jeder andere Fluss auch bergab.");

   AddDetail( ({"anhoehe"}),
     "Die ist im Sueden. Geh hin.");

   AddDetail( ({"blasen","blase"}),
     "BLUUUUUUUBBBBB.");

   AddDetail( ({"hitze"}),
     "Boah, ist das heiss hier.");

   AddDetail( ({"osten","sueden"}),
     "Das kann man nicht untersuchen, sondern nur dort hin gehen.");

   AddDetail( ({"rand","klippe"}),
     "Du siehst von hier aus kaum ueber den Rand der Klippe hinaus, aber es "
     "duerfte sich etwas Wichtiges da oben befinden.");

   AddDetail( ({"wichtiges"}),
     "Geh woanders rauf und schaue es Dir an. Von hier aus geht das nicht.");

   AddDetail( ({"decke"}),
     "Verhangen und duester ist sie ueber Dir.");

   AddDetail( ({"pulsieren","leuchten"}),
     "Erst jetzt faellt Dir auf das das von den kleinen Lavafluessen rund um "
     "die Insel stammen koennte.");

//Geraeusche:
   AddSound(DEFAULT_SOUND,
     "Neben dem leisen Klatschen der Wellen und dem Knistern der Blitze "
     "kannst Du auch ein dumpfes Klopfen und ein leises Gluckern wahrnehmen.");

   AddSound( ({"gluckern"}),
     "Das kommt wohl vom Lavafluss.");

   AddSound( ({"klatschen","wellen"}),
     "Man hoert sie sanft an den Hang klatschen.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander reiben "
     "wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","hang","pulsieren","leuchten","lavafluss"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"klopfen"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren und Leuchten im Berg zu"
     " hoeren.");

   AddSound( ({"berg"}),
     "Auch wenn Du es nicht wahrhaben willst, der Berg scheint dich noch immer"
     " in irgendeiner Weise anzuziehen.");

   AddSound( ({"weise"}),
     "Eine unheimliche Weise.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Du riechst etwas Schwefel.");

   AddSmell( ({"schwefel"}),
     "Riecht wie halbverfaulte Eier."); 

   AddSmell( ({"eier"}),
     "Das ist nur eine Redewendung.");

   AddSmell( ({"redewendung"}),
     "Du willst SOWAS riechen?");
     
   AddDetail( ({"ihnen", "sowas", "waende", "see"}),
     "Uninteressant fuer Dich.");
     
   AddCmd( ({"greif", "greife"}), "damage");

//Die Exits:

   AddExit("nordosten", ROOM "d1_ufernaehe");
   AddExit("suedoben", ROOM "c3_anhoehe");
   
   SetProp(P_HIDE_EXITS, ({"sueden"}) );
   AddExit("sueden", ROOM "c3_anhoehe");
}
int damage(string str)
{
  notify_fail("Was willst Du tun?\n");
  if (!str || str == "") return 0;
  if ( str != "stelle" && str != "stellen" && str != "auf stelle" 
    && str != "auf stellen" && str != "in stelle" 
    && str != "in stellen") return 0;
  TP->Message(BS("Du schneidest Dich!\n"), MSGFLAG_VISUAL);
  TP->AddHp(-10);
  Message(TP->Name(WER, 1)+"tut gerdae etwas Dummes.\n", 
          MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}
string glas()
{
  string s;
  object ob;
  
  if(i)
  { 
    s = "Dieser Stein sieht aus wie ein kleiner, in Glas gegossener, rechter "
        "Arm. Seltsam, dass er Dir nicht vorher aufgefallen ist. Er liegt "
        "offen da.";
    ob=clone_object(OBJ "arm_rechts");
    ob->move(TO, M_NOCHECK | M_SILENT);
    i=0;
    return BS(s); 
  }
  s = "Nix besonderes, jedenfalls noch nicht. Untersuch doch ein wenig deinen "
      "Arm *ablenk*";
  return BS(s); 
}
void reset()
{
  if(!present("\nglas_arm_rechts")) {i=1;}
  ::reset();
}