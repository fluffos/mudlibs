#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  ::create();
  
   SetProp(P_INT_SHORT, "Am See unterhalb einer Klippe");
   SetProp(P_INT_LONG,
     "Du beginnst Dich langsam weiter auf die Insel vorzuwagen, und entfernst "
     "Dich somit immer weiter von der, wenngleich dort auch nur geringfuegig "
     "groesseren, Sicherheit des Landungssteges. Vor Dir stuerzt "
     "sich ein imposanter Lavafall von einer Klippe im Westen in die Tiefe und "
     "verschwindet teils im See, teils in einem Riss der sich am Boden "
     "befindet. Ansonsten siehst Du hier eigentlich auch nur mehr ein bisschen "
     "Dampf der an der Stelle aufsteigt, wo sich Lava und Wasser vermengen. "
     "Die Hoehlendecke ist auch hier ziemlich turbulent und aufgewuehlt.");
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"dampf"}),
     "Der steigt langsam auf, bis hinauf an die Hoehlendecke. Sehr gesund "
     "sieht er allerdings nicht aus.");

   AddDetail( ({"riss"}),
     "Wie Du sicher schon mehrmals hier auf der Insel gesehen hast, "
     "verschwindet die Lava ganz einfach wieder in den Untergrund, ohne viele "
     "Spuren zu hinterlassen.");

   AddDetail( ({"spuren", "einzige"}),
     "Das Einzige, was hier an sie erinnert ist der Geruch und die Lavaspritzer, "
     "die seitlich des Risses landen.");

   AddDetail( ({"untergrund"}),
     "Zurueck unter die Insel vermutlich, vielleicht ist ja unter dem See ein "
     "noch gefaehrlicherer Lavasee.");

   AddDetail( ({"see"}),
     "Welchen See meinst Du jetzt?");

   AddDetail( ({"lavasee"}),
     "Sehen kannst Du ihn nicht, aber Du weisst, dass die Lava doch "
     "schliesslich von irgendwo auch herkommen muss.");

   AddDetail( ({"hoehlendecke","decke"}),
     "Die Hoehlendecke ist soweit oben und so verhangen, dass Du sie gar nicht "
     "wirklich siehst.");

   AddDetail( ({"boden"}),
     "Da liegen ueberall Felsen und Steine herum. Du siehst zu Deiner "
     "Ueberraschung auch ein paar Brocken, bei denen eingeschlossenen "
     "Edelsteine herausragen, herumliegen.");

   AddDetail( ({"ueberraschung","ueberraschungen"}),
     "Pass auf, das Du hier bloss keine boesen Ueberraschungen erlebst.");

   AddDetail( ({"edelstein","edelsteine"}),
     "Die sind zu fest verankert, um sie herauszubrechen.");

   AddDetail( ({"brocken"}),
     "Die sind sicher von oben heruntergefallen.");

   AddDetail( ({"felsen","steine","gestein","fels"}),
     "Es ist ein nachtschwarzes Material, das entfernt an Basalt oder Obsidian "
     "erinnert.");

   AddDetail( ({"material","materialien","basalt","obsidian"}),
     "Das sieht eben wie Vulkangestein aus.");

   AddDetail( ({"vulkangestein"}),
     "Wird von einem Vulkan ausgespuckt.");

   AddDetail( ({"vulkan"}),
     "Der spuckt Vulkangestein aus.");

   AddDetail( ({"insel"}),
     "Egal wie oft Du die Insel noch untersuchst, es aendert sich deswegen "
     "auch nichts an ihr.");

   AddDetail( ({"sicherheit"}),
     "Sicher bist Du auf dieser Insel eigentlich nirgendwo.");

   AddDetail( ({"landungssteg","steg"}),
     "Den hast Du schon vor einiger Zeit hinter Dir gelassen.");

   AddDetail( ({"zeit"}), "Keine da.");

   AddDetail( ({"lavafall","fall"}),
     "Eigentlich rinnt er ja eher zaehfluessig die Felswand herunter, um dann "
     "in dem Riss vor Dir, wieder in den Boden zu verschwinden.");

   AddDetail( ({"felswand","klippe"}),
     "Hoch ragt sie im Westen vor Dir auf. Du kannst leider von hier aus nicht "
     "ueber den Rand sehen.");

   AddDetail( ({"rand"}),
     "Du siehst von hier aus nicht ueber den Rand der Klippe hinaus, aber es "
     "duerfte sich etwas Wichtiges da oben befinden.");

   AddDetail( ({"wichtiges"}),
     "Geh woanders rauf und schaue es Dir an. Von hier aus geht das nicht.");

   AddDetail( ({"westen"}),
     "Da kannst Du von hier aus nicht hin.");

   AddDetail( ({"tiefe"}),
     "Nun ja, hier ist die Tiefe eigentlich nicht tief, weil Du ja schon ganz "
     "unten bist. Aber von oben duerfte es ganz schoen tief runtergehn.");

   AddDetail( ({"see"}),
     "Du bist zwar jetzt schon etwas oberhalb des Sees, aber deswegen ist er "
     "noch lange nicht weniger gefaehrlich als vorher, denn es schaffen "
     "trotzdem immer noch einige Tropfen, aus der Gischt bis hierher zu "
     "tropfen.");

   AddDetail( ({"tropfen","gischt"}),
     "Das wird Dir ganz sicher nicht gut tun, wenn Du es zu genau "
     "untersuchst.");

   AddDetail( ({"lava"}),
     "Die brennt sich ueberall ihren Weg durch ... auch durch Dich, wenn es "
     "sein muss.");

   AddDetail( ({"weg"}),
     "Der Weg fuehrt hier nach Nordwesten und Osten.");

   AddDetail( ({"nordwesten","osten"}),
     "Da kannst Du hingehen.");

   AddDetail( ({"stelle"}),
     "Die Stelle selber siehst Du nicht, weil sie von Dampf umgeben ist.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Du riechst etwas Schwefel und viel heisse Luft.");

   AddSmell( ({"luft"}),
     "Riecht nach leicht angesengten Nasenhaaren.");

   AddSmell( ({"nasenhaar","nasenhaaren"}),
     "Buah riecht das grauslich.");

   AddSmell( ({"schwefel"}),
     "Riecht wie halbverfaulte Eier."); 

   AddSmell( ({"eier"}),
     "Das ist nur eine Redewendung.");

   AddSmell( ({"redewendung"}),
     "Du willst SOWAS riechen?");

//Geraeusche:
   AddSound(DEFAULT_SOUND,
     "Neben dem Aufklatschen der Lavatropfen und dem Klatschen der Wellen "
     "kannst Du hier noch das Knistern der Blitze und ein dumpfes Klopfen "
     "wahrnehmen.");

   AddSound( ({"wellen","klatschen"}),
     "Stetig und unermuedlich rollen sie an und klatschen dabei an der Insel "
     "auf. Wenn sie so weitermachen wird in ein paar tausend Jahren die Insel "
     "verschwunden sein.");

   AddSound( ({"jahre","jahren"}),
     "Du hoerst die Jahre an Dir vorbeirauschen. *PLOPP* Ploetzlich bist Du "
     "200 Jahre alt.");
   
   AddSound( ({"lavatropfen","tropfen"}),
     "Es wuerde Deiner Gesundheit nicht sehr gut tun daran zu lauschen.");

   AddSound( ({"gesundheit"}),
     "Je laenger Du Dich hier auf der Insel aufhaeltst, desto lauter sagt "
     "Deine Gesundheit: 'Auf Wiedersehen'.");

   AddSound( ({"insel"}),
     "Du lauschst an der Insel, hoerst aber nichts besonderes.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander reiben "
     "wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","pulsieren","leuchten"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"klopfen"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren und Leuchten im Berg zu"
     " hoeren.");

   AddSound( ({"berg"}),
     "Auch wenn Du es nicht wahrhaben willst, der Berg scheint dich noch immer "
     "in irgendeiner Weise anzuziehen.");

   AddSound( ({"weise"}),
     "Eine unheimliche Weise.");
     
   AddDetail( ({"aufklatschen", "geruch", "lavaspritzer", "ploetzlich", "sowas",
                "waende", "wand", "wasser", "wiedersehen"}), 
     "Forsche weniger! *aufhetz*");

//Die Exits:

   AddExit("nordwesten", ROOM "f1_zwischenstueck");
   AddExit("osten", ROOM "h2_geisterwald");
}