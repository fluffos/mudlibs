#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  ::create();
   SetProp(P_INT_SHORT, "Auf einer Klippe");

   SetProp(P_INT_LONG,
     "Vor Dir tut sich eine tiefe Kluft im Boden auf, die bis hinunter zum See "
     "reicht. In sie stuerzt von oben von einer nordoestlichen gelegenen Klippe"
     " ein beeindruckender Lavafall hinein, der sich dann tief unten mit dem, "
     "in die Kluft stroemenden, Wasser unter lautem Zischen und Brodeln in "
     "einen heissen Nebel verwandelt. "
     "Alles was Du zur Zeit willst ist, schnell von hier weg zu kommen, "
     "entweder zurueck wo Du hergekommen bist oder in die andere Richtung, "
     "irgendwie am Lavafall vorbei, der Dir hier anscheinend den Weg versperrt."
     " Egal wo Du bist, die Hoehlendecke ist immer duester ueber Dir.");
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"klippe"}),
     "Hoch ragt sie hinauf, dementsprechend tief duerfte es von dort auch nach "
     "unten gehn.");

   AddDetail( ({"hoehlendecke","decke"}),
     "Die Hoehlendecke ist soweit oben und so verhangen, dass Du sie gar nicht "
     "siehst.");

   AddDetail( ({"boden"}),
     "Da liegen ueberall Felsen und Steine herum.");

   AddDetail( ({"felsen","steine","gestein"}),
     "Es ist ein nachtschwarzes Material, das entfernt an Basalt oder Obsidian"
     " erinnert.");

   AddDetail( ({"material","materialien","basalt","obsidian"}),
     "Das sieht eben wie Vulkangestein aus.");

   AddDetail( ({"vulkangestein"}),
     "Wird von einem Vulkan ausgespuckt.");

   AddDetail( ({"vulkan"}),
     "Der spuckt Vulkangestein aus.");

   AddDetail( ({"kluft"}),
     "Sie fuehrt bis hinunter zum See und noch tiefer, und Du kannst ihre "
     "tiefste Stelle nicht sehen, weil von unten lauter Dampf aufsteigt.");

   AddDetail( ({"see"}),
     "Er besteht aus heissem, stinkendem Wasser, das hier hinunter in die "
     "Kluft rauscht, wo es sich mit der Lava aus dem Lavafall "
     "vermengt und heissen Dampf produziert.");

   AddDetail( ({"Wasser"}),
     "Das kann Dir hier (hoffentlich) nichts anhaben.");

   AddDetail( ({"stelle","tiefe","tiefen"}),
     "Die siehst Du nicht.");

   AddDetail( ({"lava"}),
     "Die stuerzt von der Klippe in einen grandiosen Lavafall herunter.");

   AddDetail( ({"lavafall","fall"}),
     "Jetzt wo Du genauer hinsiehst, bemerkst Du, dass Dir der Lavafall "
     "keineswegs den Weg versperrt, denn es gibt eine Aushoehlung dahinter "
     "in der Felswand, die gerade gross genug ist, um unbeschadet "
     "weiterzugehen. Auch er ist sicher eine dieser seltsamen 'Adern' sein "
     "die Du von weitem wahrgenommen hast.");

   AddDetail( ({"ader","adern"}),
     "Na der Lavafall, was denn sonst?");

   AddDetail( ({"aushoehlung"}),
     "Die wird wohl im Laufe der Zeit entstanden sein als sich der Lavafall "
     "nach unten durchgefressen hat, auf weicheres Gestein traf und es "
     "erodierte. Durch sie kannst Du sicher gefahrlos hinter dem Lavafall "
     "vorbeigehen.");

   AddDetail( ({"felswand"}),
     "Ziemlich hoch. Und es kommt ein Lava von dort herunter. Pass auf das "
     "Dich kein heisser Tropfen am Hirn erwischt, wenn Du so nach oben "
     "schaust.");

   AddDetail( ({"tropfen","hirn"}),
     "Dann macht es Zissssssssssssssch ... und Du brauchst Dir nie wieder ueber"
     " irgendwas Gedanken zu machen."),

   AddDetail( ({"gedanken"}),
     "An was denkst Du gerade?");

   AddDetail( ({"weg"}),
     "Dein Weg wird immer von Gefahren gesaeumt.");

   AddDetail( ({"gefahren","gefahr"}),
     "Wie die Kluft, der Lavafall und die See hier.");

   AddDetail( ({"zischen","brodeln"}),
     "Das kannst Du nicht sehen. Aber Du weisst, dass es da ist.");

   AddDetail( ({"nebel","dampf"}),
     "Der steigt aus den Tiefen der Kluft auf und vernebelt Dir die Sicht nach "
     "unten. Ausserdem scheint er nicht gerade zutraeglich fuer Dich und Deine "
     "Gesundheit zu sein.");

   AddDetail( ({"gesundheit"}),
     "Atme nicht zuviel von dem Dampf ein.");

   AddDetail( ({"sicht"}),
     "Da ist keine.");

   AddDetail( ({"zeit","laufe"}),
     "Den Lauf der Zeit koennen wir nicht beeinflussen.");

   AddDetail( ({"richtung"}),
     "Du kannst hier nach Osten oder Westen gehen, aber je nachdem wo Du "
     "herkommst oder hingehst musst Du mit Sicherheit am Lavafall vorbei.");

//Geraeusche:
   AddSound(DEFAULT_SOUND,
     "Neben dem Tosen des Wassers, das in die Kluft stroemt hoerst Du nur "
     "noch das Brodeln und Zischen wenn sich Lava und Wasser vermengen.");

   AddSound( ({"tosen"}),
     "Das Wasser stroemt unaufhoerlich in die Kluft hinein.");

   AddSound( ({"kluft"}),
     "Die Kluft selber kannst Du natuerlich nicht hoeren.");

   AddSound( ({"wasser","lava"}),
     "Es wuerde Deiner Gesundheit nicht sehr gut tun daran zu lauschen, "
     "allerdings kannst Du hier eh nicht nahe genug ran um es zu tun.");

   AddSound( ({"gesundheit"}),
     "Je laenger Du Dich hier aufhaeltst, desto lauter sagt Deine Gesundheit: "
     "'Auf Wiedersehen'.");

   AddSound( ({"brodeln","zischen"}),
     "Es uebertoent fast alles hier.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Hier ist der Geruch von Nebel besonders stark. Ansonsten riechst Du nur "
     "heisse Luft. Du gruebelst .oO(Wie riecht denn Nebel eigentlich?)");

   AddSmell( ({"geruch","nebel"}),
     "Hier wird selbst ein normaler Atemzug zur Qual.");

   AddSmell( ({"luft"}),
     "Riecht luftig und heiss.");

   AddSmell( ({"atemzug"}),
     "Halt besser die Luft an sonst koennte es Dir hier schlecht ergehen.");

   AddSmell( ({"qual"}),
     "Die Qual quaelt Dich sehr.");
     
   AddDetail( ({"zissssssssssssssch","neben","sicherheit","waende",
               "wand", "wie", "wiedersehen", "lauf"}),
     "Sparsamer forschen!");

//Die Exits:

   AddExit("westen", ROOM "d5_klippe_am_see");
   AddExit("osten", ROOM "f5_wegkreuzung");
}