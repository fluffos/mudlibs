#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  
  object ob;
  
  ::create();
  
   SetProp(P_INT_SHORT, "Eine funkelnde Wegbiegung");

   SetProp(P_INT_LONG,
     "Der Weg auf dem du dich gerade befindest, macht hier eine Biegung, er "
     "funkelt und glitzert im Sonnenlicht, aber Du merkst das es hier schon "
     "wieder kleine Anzeichen gibt, das die Natur hier versucht wieder an "
     "Boden zurueckzugewinnen. Hier ist zwar auch immer noch eine Unzahl "
     "kristalliner Dornenhecken und Baeume aber hier sind es deutlich weniger "
     "als sonst wo. Von den meisten Seiten wird das Licht reflektiert und es "
     "entsteht, wenn du im richtigen Winkel hinsiehst, ein beeindruckendes "
     "Farbenspiel. Der Blick auf den Himmel wird durch nichts getruebt.");
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_FOREST]) );
   SetProp(P_INDOORS, 0);

   AddDetail( ({"weg", "waldweg", "boden"}),
     "Der Boden ist hier mit einer duennen Kristallschicht ueberzogen, aber "
     "man sieht auch schon kleine braune Flecken Erde.");

   AddDetail( ({"flecken", "erde"}),
     "Broeselig und braun, so wie Erde nun mal ist.");

   AddDetail( ({"schicht", "kristallschicht", "kristall", "kristalle", 
     "kristallen"}),
     "Wenn es nicht Kristall waere, waere hier doch nicht der Kristallwald, "
     "oder?");

   AddDetail( ({"wald", "kristallwald"}),
     "Er besteht immer noch aus einer Unzahl kristalliner Dornenhecken und "
     "Baeume.");

   AddDetail( ({"natur", "anzeichen"}),
     "Die Natur versucht hier Boden zurueckzugewinnen.");

   AddDetail( ({"unzahl"}),
     "Eins, zwei, drei, ... ach es sind zu viele. Du willst gar nicht "
     "weiterzaehlen.");

   AddDetail( ({"funkeln", "glitzern"}),
     "Die Kristallschicht erzeugt das.");

   AddDetail( ({"licht", "sonnenlicht"}),
     "Es wird von den Kristallen reflektiert und verstaerkt. Du solltest nicht "
     "zu lange hineinsehen sonst riskierst du noch eine Verletzung deiner "
     "Sehnerven.");

   AddDetail(  ({"verletzung"}),
     "Hoerst du nie auf das was man dir raet?");

   AddDetail( ({"sehnerven"}),
     "Du verdrehst deine Augaepfel, deine Haende werden zu Klauen und du "
     "faengst ploetzlich an, mit einer daemonisch-dunklen Stimme zu sprechen.");

   AddDetail( ({"augaepfel", "haende", "klauen", "stimme"}),
     "Das koennen wir doch mittlerweile schon auswendig, ist es Dir nicht zu "
     "bloed das immer wieder zu untersuchen?");

   AddSound( ({"stimme" }),
     "Das koennen wir doch mittlerweile schon auswendig, ist es Dir nicht zu "
     "bloed, das immer wieder zu untersuchen?");

   AddDetail( ({"winkel"}),
     "Du weisst ja mittlerweile wie man sich hinstellen muss und auf einmal "
     "kannst du das Farbenspiel in seiner ganzen Pracht erkennen.");

   AddDetail( ({"farben", "farbenspiel", "pracht", "regenbogen"}),
     "Du siehst saemtlich Farben des Regenbogens.");

   AddDetail( ({"dornenhecken", "dornenhecke", "hecke", "hecken"}),
     "Es ist eine mit Kristallen ueberzogene, verfilzte Hecke mit vielen "
     "spitzen Dornen auf ihren Zweigen. An einer Stelle scheint sie nicht ganz "
     "so dicht zu sein und im Osten waechst sie bedrohlich hoch zwischen den "
     "Baeumen.");

   AddDetail( ({"osten"}),
     "Da waechst die Hecke besonders hoch.");

   AddDetail( ({"stelle"}),
     "Da scheint die Hecke nicht ganz so dicht zu sein. Vielleicht solltest Du "
     "versuchen dir einen Weg zu bahnen. Obwohl... ploetzlich magst Du "
     "nicht mehr!");
     
   AddDetail( ({"dornen"}),
     "Die sind ganz schoen spitz. Pass lieber auf und greif sie nicht an.");

   AddDetail( ({"zweige"}),
     "Frueher waren die sicher einmal sehr biegsam, nur jetzt duerften Sie "
     "keine Beruehrungen dieser Art mehr aushalten, auch wenn die Natur hier "
     "wieder durchzudringen versucht.");

   AddDetail( ({"beruehrungen", "art", "biegen"}),
     "Naja, Biegen und so halt.");

   AddDetail( ({"baeume"}),
     "Sie sehen aus wie alle anderen Baeume im Kristallwald, naemlich "
     "kristallin. Alles ist von einer Kristallschicht ueberzogen: der Stamm "
     "mit der Rinde, die Aeste und auch die Blaetter.");

   AddDetail( ({"stamm"}),
     "Der ist so dick den koenntest nicht mal Du umfassen.");

   AddDetail( ({"rinde", "aeste", "blaetter"}),
     "Kristallin. Aber man sieht das die Natur nie aufgibt.");

   AddDetail( ({"blick", "himmel"}),
     "Du hast hier ziemlich freien Blick auf den Himmel, der Dir wolkenlos und "
     "mit erwaermender Sonne entgegenstrahlt.");

   AddDetail( ({"wolke", "wolken"}),
     "So sehr Du Dich auch umsiehst, Du kannst keine erkennen.");

   AddDetail( ({"sonne"}),
     "Wie fast ueberall sonst auch, scheint sie dir froehlich vom Himmel "
     "entgegen und waermt dich.");

   AddDetail( ({"waerme"}),
     "Die kannst Du auf Deiner Haut sogar richtig spueren.");

   AddDetail( ({"haut"}),
     "Da spuerst Du die Waerme. (Oder hast Du hier etwas anderes erwartet?) "
     ":)");

//Hier jetzt Gerueche und Geraeusche:
   AddSound(DEFAULT_SOUND, 
     "Hier ist es auch noch ziemlich still. Aber man hoert schon oefters einen "
     "Vogel irgendwo aus den Baeumen heraus zwitschern oder ein Insekt durchs "
     "kristalline Unterholz krabbeln. Aus dem Suedwesten glaubst Du leisen "
     "Gesang zu hoeren.");

   AddDetail( ({"gesang", "suedwesten"}),
     "Lausch doch.");

   AddSound( ({"gesang", "person", "waldelfe", "suedwesten"}),
     "Hoert sich nach einer weiblichen Person an, vermutlich eine der "
     "legendaeren Waldelfen.");

   AddDetail( ({"voegel", "vogel"}),
     "Siehst Du hier nicht, aber hoeren kann man das Gezwitscher.");

   AddDetail( ({"unterholz"}),
     "Das liegt unter den Hecken und Baeumen. Ansonsten waers ja kein "
     "Unterholz.");

   AddSound( ({"gezwitscher", "vogel", "voegel"}),
     "Zwitsch, Zwitsch, Tirili, Tirila ...");

   AddDetail( ({"insekt", "insekten"}),
     "Siehst Du hier nicht, aber hoeren kann man es.");

   AddSound( ({"krabbeln", "insekt", "insekten"}),
     "Kribbel, krabbel, kratz, kratz, schab, schab ...");

   AddSmell(DEFAULT_SMELL, 
     "Du holst durch Deine Nase tief Luft, und kannst schon etwas mehr Natur "
     "riechen neben dem Kristallgeruch hier. Du glaubst auch einen schwachen "
     "Blumenduft von hinter der Hecke wahrzunehmen.");

   AddDetail( ({"blumenduft"}),
     "Den kann man nicht sehen. Nur riechen.");

   AddSmell( ({"blumenduft"}),
     "Es riecht hier zwar sehr kristallin, aber Du glaubst, Dich nicht "
     "getaeuscht zu haben.");

   AddDetail( ({"nase"}),
     "Das ist das Ding im Gesicht das man nur sieht wenn man schielt.");

   AddDetail( ({"gesicht"}),
     "Das siehst Du nur im Spiegel.");

   AddDetail( ({"spiegel"}),
     "Den gibts hier nicht. Aber Du koenntest Dein Spiegelbild in den "
     "Kristallen betrachten.");

   AddDetail( ({"spiegelbild", "bild"}),
     "Ja, das bist eindeutig Du.");

   AddSmell( ({"kristall", "kristalle","kristallstaub"}),
     "Da es hier einigen Kristallstaub gibt, den Du jetzt natuerlich durch "
     "die Nase einziehen musstest, niest Du.\n Haaaaaa-tschi! Gesundheit!");
     
   AddDetail( ({"biegung", "ding", "seiten", "sie", "tirila", "tirili", 
                "zwitsch"}),
     "Du wirst abgelenkt.");

   AddExit("norden", ROOM "raum06");
   AddExit("suedosten", ROOM "raum08");
   
   AddItem(NPC "druid", REFRESH_DESTRUCT);
   ob=present("\ndruidenzirkel_npc", TO);
   if(ob) ob->customize("sarl");
}
void reset()
{
  object ob;
  
  ::reset();
  
  ob=present("\ndruidenzirkel_npc", TO);
  if(ob) ob->customize("sarl");
}