#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  ::create();
   SetProp(P_INT_SHORT, "Bei einem grossen Felsklotz");
   SetProp(P_INT_LONG,
     "Du befindest Dich hier mitten auf einer etwas groesseren Lichtung "
     "innerhalb des dichten Baum- und Buschwerks und vor Dir ragt ein mehrere "
     "Meter hoher Felsblock in die Hoehe. Rund um ihn waechst kaum etwas, der "
     "Boden dort sieht irgendwie verbrannt und verbraucht aus, wie wenn der "
     "Fels saemtliche Naehrstoffe aus dem Boden gezogen hat. So waechst im "
     "Umkreis von einigen Metern nichts, wie auch hinter dem Felsen, wo es "
     "nach paar ein Schritten auch schon hinunter in den See geht. Aber selbst "
     "das Baum- und Buschwerk, welches hier, bis weit nach hinten an die "
     "Klippen, waechst, sieht nicht besonders gesund und munter aus. Es ist "
     "aber immerhin dicht genug gewachsen, dass Du nur drei Wege waehlen "
     "kannst. Du siehst, dadurch das in einer Lichtung normalerweise keine "
     "Baeume stehen, auch wieder etwas mehr von der ewig verhangenen "
     "Hoehlendecke.");
   SetProp(P_LIGHT, 0);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"hoehlendecke","decke"}),
     "Sie ist, soweit Du sie erblicken kannst, von blitzdurchzogenen Schwaden "
     "bis auf einige kleinere Stellen verhuellt.");

   AddDetail( ({"schwaden"}),
     "Die bestehen vermutlich aus heissen Wasserdampf vom See.");

   AddDetail( ({"stellen"}),
     "Dahinter siehst Du auch nicht viel mehr als tiefe Schwaerze.");

   AddDetail( ({"schwaerze"}),
     "Ist logischerweise schwarz.");

   AddDetail( ({"boden"}),
     "Hier besteht er, im Vergleich zum Rest der Insel, nicht nur aus Felsen "
     "und Steinen, sondern zu einem grossen Teil aus alter und verbraucht "
     "aussehender Erde.");

   AddDetail( ({"felsen","steine","gestein"}),
     "Ein nachtschwarzes Material, das entfernt an Basalt oder Obsidian "
     "erinnert.");

   AddDetail( ({"material","materialien","basalt","obsidian"}),
     "Das sieht wie Vulkangestein aus.");

   AddDetail( ({"vulkangestein"}),
     "Wird von einem Vulkan ausgespuckt.");

   AddDetail( ({"vulkan"}),
     "Der spuckt Vulkangestein aus.");

   AddDetail( ({"vergleich"}),
     "Wenn Du den Rest der Insel erforscht hast, wird Dir der Vergleich "
     "leichter fallen.");

   AddDetail( ({"rest"}),
     "Der Rest der Insel ist definitiv nicht hier, sondern wo anders.");

   AddDetail( ({"insel"}),
     "Egal wie oft Du die Insel noch untersuchst, es ist immer noch die selbe "
     "wie vorher.");

   AddDetail( ({"teil"}),
     "Soll heissen, dass es hier mehr Erde als Felsen und Steine gibt.");

   AddDetail( ({"erde"}),
     "Du nimmst etwas von ihr, laesst sie wieder zurueck auf den Boden rieseln "
     "und sie fuehlt sich wirklich alt und verbraucht an.");

   AddDetail( ({"lichtung"}),
     "So nennt man einen von Pflanzen ausgesparten Platz innerhalb eines "
     "Waldes. Ob sie nun natuerlich oder unnatuerlich entstanden ist, kannst "
     "Du nicht bestimmen.");

   AddDetail( ({"pflanzen"}),
     "In diesem Fall sind das nur gespensterhaft aussehende Baeume und "
     "Buesche, wie sie zu der Insel nicht besser passen koennten.");

   AddDetail( ({"platz"}),
     "Die Lichtung.");

   AddDetail( ({"rand"}),
     "Das ist der Umkreis der Lichtung.");

   AddDetail( ({"umkreis"}),
     "So bezeichnet man einen Kreis um etwas, in diesem Fall der Felsblock.");

   AddDetail( ({"kreis"}),
     "Ein Kreis ist rund und ueberall gleich gross.");

   AddDetail( ({"fall"}),
     "Wenn der Felsblock auf Dich drauffaellt bist Du platt. Da bist Du platt, "
     "was?");

   AddDetail( ({"baeume","baum","buesche","busch","baumwerk","buschwerk"}),
     "Die Baeume und Buesche stehen am Rand der Lichtung so dicht zusammen, "
     "dass sie Dich gerade dazu zwingen, einen der Wege nach Sued- oder "
     "Nordwesten zu nehmen oder hinter dem Felsblock nach Osten direkt zum See "
     "zu gehen, wenn Du wieder aus dem Wald hinaus willst. Sie strecken Dir aus"
     " allen Richtungen ihre Aeste und Wurzeln entgegen und Du kannst erkennen,"
     " dass, je naeher sie an der Felswand im Westen stehen, sie sich wieder "
     "etwas lichten, aber nicht warum dies so ist.");

   AddDetail( ({"aeste","ast"}),
     "Die koennen sich hier auf der Lichtung, woodyseidank, nicht mehr "
     "wirklich in Deiner Ausruestung verhaken.");

   AddDetail( ({"wurzeln"}),
     "Das sind ja richtige Stolperfallen. So ausgepraegt wie die hier sind, "
     "finden sie anscheinend etwas mehr Naehrstoffe als sonst wo auf der Insel,"
     " auch wenn hier die Erde schon total verbraucht ist.");

   AddDetail( ({"stolperfalle","stolperfallen"}),
     "Hier auf der Lichtung brauchst Du keine Angst zu haben, dass Du stolpern "
     "wirst, denn so weit reichen die Wurzeln hier nicht."); 

   AddDetail( ({"angst","angstgefuehl"}),
     "Seit Du hier auf der Insel bist, hast Du ein so ein leises Angstgefuehl "
     "in Dir, welches immer staerker wird, je weiter Du vordringst.");

   AddDetail( ({"stoff","stoffe"}),
     "Stoff? Wo siehst Du hier Stoff?");

   AddDetail( ({"naehrstoffe","naehrstoff"}),
     "Pflanzen wachsen normalerweise nur dann wenn sie Naehrstoffe haben.");

   AddDetail( ({"ruestung"}), "Keine an?");

   AddDetail( ({"felsblock"}),
     "Je genauer Du ihn untersuchst, desto mehr Einzelheiten kannst Du an ihm "
     "erkennen.");

   AddDetail( ({"einzelheiten"}),
     "Da waeren z.B. die kleinen Flechten, die ihn fast ueberall wie eine Art "
     "Pelz ueberziehen, oder die seltsam lebendige Ausstrahlung die der "
     "Felsblock von sich gibt. Auch seine oberen Regionen erinneren Dich eher "
     "an den Oberkoerper eines Lebewesens, als an einen Felsen. Der Rest "
     "erinnert Dich eher an eine grob aus dem Fels gehauene Statue.");

   AddDetail( ({"ausstrahlung"}),
     "Lausch doch z.B. mal an dem Felsen.");

   AddDetail( ({"flechten"}),
     "Sie ueberziehen den Fels von oben bis unten und nur wenige Stellen sind "
     "von ihnen ausgespart worden. Bei einem Lebewesen wuerdest Du die Flechten"
     " vermutlich Haare nennen.");

   AddDetail( ({"regionen","region","oberkoerper"}),
     "Wo bei etwas lebendigem Schultern und Kopf sitzen.");

   AddDetail( ({"kopf"}),
     "Du siehst ganz oben etwas auf dem Felsen liegen.");

   AddDetail( ({"schulter","schultern"}),
     "An diesen 'Schultern' siehst Du eigentlich nur einige versteinerte "
     "Fetzen haengen.");

   AddDetail( ({"etwas"}),
     "Nach einer kleinen Klettertour auf den Felsen haeltst Du eine "
     "versteinerte Schaedelmaske in Deinen Haenden. Du legst sie wieder "
     "zurueck.");

   AddDetail( ({"stellen"}),
     "Das sind so wenige, dass Du sie an Deinen Fingern abzaehlen koenntest.");

   AddDetail( ({"finger","haende","hand"}),
     "Du hast an jeder Hand fuenf Finger.");

   AddDetail( ({"lebewesen"}),
     "Sei froh das der Felsblock keines ist.");

   AddDetail( ({"pelz","haare","art"}),
     "Das einzige Lebewesen, das Dir als so gross und haarig bekannt ist, "
     "waere ein Troll.");

   AddDetail( ({"statue","rest"}),
     "Wenn Du es nicht besser wuesstest, wuerdest Du sie wirklich fuer ein "
     "Lebewesen halten. Den spitzen Zacken in (Troll-)Armhoehe koennte man "
     "sogar fuer einen Dolch halten.");

   AddDetail( ({"zacken","dolch","klinge","schwert","langdolch"}),
     "Ein Langdolch.");

   AddDetail( ({"trollarmhoehe","armhoehe"}),
     "Die ist weit oben.");

   AddDetail( ({"klettertour"}),
     "Die hast Du gerade hinter Dir.");

   AddDetail( ({"schaedelmaske"}),
     "So was tragen normalerweise nur die Nekromanten.");

   AddDetail( ({"troll","trolle"}),
     "Die leben normalerweise weit weg von hier, mitten im Gebirge in ihrem "
     "Lager.");

   AddDetail( ({"gebirge", "berg"}),
     "Das einzige was hier einem Gebirge im entferntesten Sinne aehneln "
     "koennte, ist der Berg hier.");

   AddDetail( ({"sinne","sinn"}),
     "Muss alles immer einen Sinn fuer Dich ergeben?");

   AddDetail( ({"lager"}),
     "Viele sind schon dorthin gegangen und laut Geruechten nicht mehr "
     "zurueckgekommen.");

   AddDetail( ({"geruecht"}),
     "Es geht das Geruecht um, dass die Fremde dort ganz schnell aufgefressen "
     "werden.");

   AddDetail( ({"fremde"}),
     "Alle die keine Trolle sind.");

   AddDetail( ({"nekromanten"}),
     "Die sollen doch angeblich auf einer aehnlich unheimlichen Insel "
     "beheimatet sein. Vielleicht findest Du sie ja ... oder sie Dich, wer "
     "weiss?");

   AddDetail( ({"wald"}),
     "Es ist ein eher unheimlicher Wald, wie Du ihn aus den Geschichten und "
     "Erzaehlungen Deiner Jugend kennst, wo die Fratzen an den Baeumen "
     "grauslich grinsen und die Aeste nach Dir zu greifen scheinen.");
 
   AddDetail( ({"fratzen","fratze"}),
     "Zerrbilder des Schreckens.");

   AddDetail( ({"zerrbilder","bilder"}),
     "Verzerrt. Abnormal. Schrecklich.");

   AddDetail( ({"schrecken","schreckens"}),
"                                _      ____                         \n"
"                             ,-'_`--.-',--.`.                       \n"
"                        _,-.',-* '-.  *    `'_                      \n"
"                    ,--'    Y       )  ) ,-*' `.__,--._     ,.      \n"
"                  ,'    _    `-.  ,'  /_;    ___   __  `._,'(_      \n"
"           _.---.'  _,-/ /.     \\ :         '--.`-'  `.   __  `.    \n"
"   ,--._,-'   __   /   \\:  :    :  \\        _   \\     /,-'  `.  \\   \n"
" ,'.-.   _,.-'  ) :     `   \\    `.;     ,-' `.  \\   ((       `. \\  \n"
"((    `*'   ,-.; ,'         :           :      \\ :    `         ) ) \n"
" `'        /,.__;   _.-...__|           ;      './              `-` \n"
"           `      ,'  ...__     @   @   (     _,=-._                \n"
"                 I   ',    `.    /\\/\\/\\  `-,-'_,--, '-._            \n"
"                 /     \\     `. |      |   ,-'    /     \\           \n"
"                //\\ /\\ /D     |  \\/\\/\\/   /      C\\ /\\ /\\\\         \n"
"               (( (( ((       |          :         )) )) ))         \n"
"                `  `  `       |          |         '  '  '          \n"
"                              |          :                          \n"
"                              :           `.                        \n" 
"                             /              \\                       \n"
"                          _,'                '.                     \n"
"                      _,-'_'. .^'.    _.~'-._  '.                   \n"
"                       `'    Y    )  (       `~.~`.                 \n"
"                             '   /_.~                               \n"
"                                '                                   \n");

   AddDetail( ({"geschichten","erzaehlungen"}),
     "Du erinnerst Dich wie Du frueher immer Alptraeume davon bekommen hast.");

   AddDetail( ({"alptraeume","alptraum"}),
     "Hier werden Alptraeume schnell lebendig.");

   AddDetail( ({"jugend"}),
     "Lang, lang ist's her.");

   AddDetail( ({"meter"}),
     "Eine Masseinheit.");

   AddDetail( ({"masseinheit","einheit","mass"}),
     "Ein Meter.");

   AddDetail( ({"hoehe"}),
     "Soll heissen, der Felsblock ist nach oben ausgerichtet.");

   AddDetail( ({"schritte","schritt"}),
     "Immer schoen einen nach dem anderen machen, dann passiert Dir hier auch "
     "(hoffentlich) nichts.");

   AddDetail( ({"see"}),
     "Seine Wellen rollen unvermindert stark an das ufernahe Gestein und das "
     "kochend heisse Wasser frisst sich ganz langsam aber sicher immer weiter "
     "durch.");

   AddDetail( ({"wasser"}),
     "Du haeltst einen abgebrochen Ast hinein und ehe Du Dich versiehst ist er "
     "schon halb verkokelt. *HUCH* ");

   AddDetail( ({"wellen","welle"}),
     "Die koennen Dir hier nicht unbedingt gefaehrlich werden, aber zu nahe "
     "zum See solltest Du besser auch nicht gehen.");

   AddDetail( ({"klippe","klippen","felswand"}),
     "Die siehst Du etwas weiter im Westen, aber genaueres kannst Du von hier "
     "aus nicht erkennen.");

   AddDetail( ({"weg","wege"}),
     "Einer geht nach Sued-, einer nach Nordwesten und Du kannst auch noch "
     "nach Osten einige Schritte auf den See zu gehen.");

   AddDetail( ({"suedwesten","nordwesten","westen","osten"}),
     "Richtungen.");

   AddDetail( ({"richtung","richtungen"}),
     "Nein, die solltest Du mittlerweile schon auswendig kennen, da wird jetzt "
     "nichts mehr erklaert.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Neben Wasserdampf aus dem See riechst Du hier ziemlich stark einen "
     "modrigen Geruch, wie nach fortgeschrittener Verwesung oder fauliger "
     "Erde.");

   AddSmell( ({"see","wasser"}),
     "Zieh Dir nicht zu viel davon rein, es koennte schaedlich fuer Dich "
     "sein.");

   AddSmell( ({"geruch"}),
     "Er scheint hier am staerksten von ueberall auszugehen, von den Baeumen, "
     "aus dem Boden, einfach aus allem.");

   AddSmell( ({"erde","baeume","boden"}),
     "Riecht wie stinkende, verrottende Erde, wie sie sonst nur am Friedhof "
     "oder auf einem Komposthaufen zu finden ist.");

   AddSmell( ({"friedhof","komposthaufen"}),
     "Da riecht es auch genauso wie hier.");

//Geraeusche:
   AddSound(DEFAULT_SOUND,
     "Neben dem Klatschen der Wellen kannst Du hier noch das Knistern der "
     "Blitze, ein dumpfes Klopfen und das Knarren der Baeume und Buesche "
     "wahrnehmen.");

   AddSound( ({"knarren","baeume","buesche"}),
     "Knniiiiiiiiiirz, knaaaaarrrrrsch, krrraaaaaaach.");

   AddSound( ({"wellen","klatschen"}),
     "Stetig und unermuedlich rollen sie hinter dem Felsen an und klatschen "
     "dabei an der Insel auf.");

   AddSound( ({"insel"}),
     "Du lauschst an der Insel, hoerst aber nichts besonderes.");

   AddSound( ({"fels","felsen"}),
     "Du lauschst an dem Felsen und meinst, auch in ihm ein Klopfen zu "
     "hoeren.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander reiben "
     "wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","pulsieren","leuchten"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"klopfen"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren und Leuchten im Berg zu "
     "hoeren.");

   AddSound( ({"berg"}),
     "Auch wenn Du es nicht wahrhaben willst, der Berg scheint dich noch immer "
     "in irgendeiner Weise anzuziehen.");

   AddSound( ({"weise"}),
     "Eine unheimliche Weise.");
     
   AddDetail( ({"ausruestung", "c", "fetzen", "verwesung", "waende", "wand", 
                "wasserdampf", "fels"}), 
     "Falsch geforscht wuerde ich sagen!");

//Die Exits:
   AddExit("suedwesten", ROOM "h4_geisterwald");
   AddExit("nordwesten", ROOM "h2_geisterwald");
}