#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  ::create();
  
   SetProp(P_INT_SHORT, "Beim westlichen Monolithen");
   SetProp(P_INT_LONG,
     "Auch hier ragt ein verdrehter Monolith vor Dir in die Hoehe, wie ein "
     "Finger einer sieben-fingrigen Hand. Er biegt sich Richtung Osten, wo er "
     "mit den anderen Monolithen eine Art Kuppel bildet. Du fuehlst ein "
     "Pulsieren in Dir, so als wuerde Dich eine unendliche Macht durchstroemen."
     " Die Hoehlendecke hier ueber Dir kommt einem noch duesterer vor als "
     "sonstwo. Hinter dem Monolithen fliesst Lava die steile Felswand bis zu "
     "einer tiefergelegenen Klippe runter.");
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"hoehlendecke"}),
     "Dunkel und verhangen ist die Decke ueber Dir und auch kein bisschen "
     "naeher als vorher.");

   AddDetail( ({"lava"}),
     "Sie fliesst knapp unterhalb des Monolithen aus einer Oeffnung in einem "
     "kleinen Lavafall auf die darunterliegende Klippe.");

   AddDetail( ({"oeffnung"}),
     "Ja, bitte ... steck doch >einmal< Deinen Kopf da rein damit Du siehst "
     "wie es da drinnen aussieht.");

   AddDetail( ({"kopf"}),
     "Glaubst Du das der danach noch dran ist, wenn Du mit Lava shamponierst?");

   AddDetail( ({"lavafall"}),
     "Ein nie enden wollender Strom von Lava kommt da raus. Koennten das "
     "eventuell die pulsierenden Adern sein, die Du vorher von unten gesehen "
     "hast?");

   AddDetail( ({"strom","fluss"}),
     "So kannst Du den Lavafluss auch nennen.");

   AddDetail( ({"lavafluss"}),
     "Ein nie enden wollender Fluss.");

   AddDetail( ({"adern"}),
     "Die Lava kommt immer synchron mit dem Pulsieren der Macht hier aus der"
     " Oeffnung geflossen. Das erklaert einiges.");

   AddDetail( ({"boden"}),
     "Der besteht wie ueberall hier aus diesem seltsamen schwarzen Gestein.");

   AddDetail( ({"gestein"}),
     "Dunkelschwarz. Du hast noch nie ein aehnliches Gestein gesehen. Es sieht"
     " extrem hart und wiederstandsfaehig aus.");

   AddDetail( ({"felswand","klippe"}),
     "Hui, da gehts zwar immer noch runter, aber nicht so steil wie an den "
     "Stellen wo keine kleineren Klippen darunter sind. An Deiner Stelle wuerde"
     " ich trotzdem da nicht zu nahe zum Rand gehen.");

   AddDetail( ({"stelle","stellen"}),
     "Da ich nicht an Deiner Stelle bin musst Du das schon selbst wissen.");

   AddDetail( ({"rand"}),
     "Wie mit einem Zirkel gezogen, zieht er sich rund um das ganze Plateau."); 

   AddDetail( ({"plateau"}),
     "Das ist hier oben, da unten ist eine kleine Klippe und wenn Du da "
     "runterfaellst, tust Du Dir sicher sehr weh.");

   AddDetail( ({"zirkel"}),
     "Da ist natuerlich keiner, das ist nur so dahin gesagt.");

   AddDetail( ({"monolith"}),
     "Verdreht und verwittert, dennoch ungebeugt ragt dieser Monolith "
     "Richtung Osten. Auf einer Seite ist eine Rune in den Stein eingelassen.");

   AddDetail( ({"decke"}),
     "Immer noch da oben, egal wie oft Du es auch untersuchst.");

   AddDetail( ({"osten"}),
     "Als Du nach Osten blickst, bemerkst Du, dass da eine kleine Bruecke "
     "ist.");

   AddDetail( ({"bruecke"}),
     "Sie fuehrt zu einer Felsnadel die mitten aus dem Krater aufragt.");

   AddDetail( ({"krater","ort"}),
     "Das ist der Ort wo die Lava herkommt.");

   AddDetail( ({"felsnadel"}),
     "Du musst schon hinuebergehen um sie zu erforschen.");

   AddDetail( ({"hoehe"}),
     "Ist immer oben.");

   AddDetail( ({"richtung","richtungen"}),
     "Ueber Richtungen haben sich schon zu viele ausgelassen, darum hier keine "
     "Diskussion mehr darueber.");

   AddDetail( ({"diskussion"}),
     "Nein.");

   AddDetail( ({"seite"}),
     "Die Seite, die Dir zugewandt ist, traegt die Rune.");

   AddDetail( ({"rune"}),
     "Die Rune stellen mehrere waagrecht liegende Wellenlinien dar. Eigentlich "
     "kommt Dir das Ganze doch irgendwie seltsam vertraut vor. Du bist Dir "
     "sicher das schon mal irgendwo gesehen zu haben."),

   AddDetail( ({"wellenlinien"}),
     "Offenbar ein Symbol fuer Wasser. Hier wurde es aber seltsam "
     "verunstaltet.");

   AddDetail( ({"symbol"}),
     "Die Wellenlinien.");

   AddDetail( ({"ganze","ganz"}),
     "Du weist nur nicht woher.");
 
   AddDetail( ({"wasser"}),
     "In den meisten Faellen fluessig, in manchen gasfoermig, manchmal Eis und"
     " ganz selten in ueberfluessiger Form.");

   AddDetail( ({"eis"}),
     "Gefrorenes Wasser.");

   AddDetail( ({"faelle"}),
     "Ja, meistens.");

   AddDetail( ({"form"}),
     "Z.B. wenn Du gerade wo ertrinkst. *G*");

   AddDetail( ({"stein"}),
     "Hmm ... Du weisst nicht, welche Steinart das ist.");

   AddDetail( ({"pulsieren","macht","kraft"}),
     "Du spuerst foermlich wie Dein Koerper unter dem Ansturm dieser Kraft "
     "erbebt.");

   AddDetail( ({"koerper"}),
     "Er erbebt foermlich.");

   AddDetail( ({"ansturm"}),
     "Du kannst Dich kaum noch aufrecht halten.");

   AddDetail( ({"finger","hand"}),
     "Nur ein bildlicher Vergleich. Du hast doch sicher noch nirgends eine "
     "Hand mit sieben Fingern gesehen oder?");

   AddDetail( ({"vergleich","waffenexperte"}),
     "Wenn Du etwas vergleichen willst, geh zum einem Waffenexperten.");

   AddDetail( ({"art","kuppel"}),
     "Naja, keine wirklich Kuppel, nur die Andeutung einer solchen.");

   AddDetail( ({"andeutung"}),
     "Willst Du hier irgendwas andeuten?");

//Geraeusche:
  AddSound(DEFAULT_SOUND,
     "Neben dem Knistern der Blitze und dem hier staerker werdenden dumpfen "
     "Klopfen kannst Du aus Richtung des Monolithen staendig leise Stimmen, die"
     " mal drohender mal flehender werden wahrnehmen.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander reiben "
     "wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","pulsieren","leuchten"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"klopfen"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren des Leuchtens im Berg zu"
     " hoeren. Es duerfte irgendwo hier oben seinen Ursprung haben.");

   AddSound( ({"berg"}),
     "Auch wenn Du es nicht wahrhaben willst, der Berg scheint dich noch immer "
     "in anzuziehen.");

   AddSound( ({"richtung"}),
     "Richtungen kann man doch nicht hoeren.");

   AddSound( ({"monolith"}),
     "Er vibriert leise.");

   AddSound( ({"stimmen","sprache"}),
     "Die Stimmen sprechen in einer Dir unbekannten Sprache, daher verstehst "
     "Du auch nicht was sie sagen.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Du riechst eigentlich nur die Gase die aus der Oeffnung mit der Lava "
     "austreten.");

   AddSmell( ({"gase","schwefel"}),
     "Igitt ... riecht wie verfaulte Eier.");

   AddSmell( ({"eier"}),
     "Du riechst an der Oeffnung und kommst zum darauf das es nur Schwefel "
     "sein kann der hier so bestialisch riecht.");

   AddSmell( ({"oeffnung","lava"}),
     "Noch naeher und Deine Nasenfluegel, sind mit dem Rest Deines Gesichts "
     "nur noch Geschichte.");

   AddSmell( ({"nasenfluegel","rest","gesicht","geschichte"}),
     "Nein, das kannst Du nicht riechen und schon gar nicht untersuchen.");

   AddDetail( ({"nasenfluegel","rest","gesicht","geschichte"}),
     "Wie gesagt ... DAS kannst Du NICHT untersuchen.");
     
   AddDetail( ({"deines", "nicht", "steinart", "ursprung", "waende", "wand"}),
     "Findest Du so nicht.");

//Die Exits:
   AddExit("osten", ROOM "e3_vulkanmitte");
   AddExit("norden", ROOM "d2_kraterrand");
   AddExit("sueden", ROOM "d4_kraterrand");
}