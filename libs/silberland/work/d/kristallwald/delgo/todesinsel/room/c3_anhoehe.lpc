#include "../def.h"

inherit "std/room";

#include <properties.h>


void create()
{
  ::create();
  
   SetProp(P_INT_SHORT, "Auf einer Anhoehe");
   SetProp(P_INT_LONG,
     "Du stehst hier auf einer der hoeheren Klippen der Insel. Felsen liegen "
     "hier kaum welche herum, lediglich einige kleine Steinchen sind zu sehen. "
     "Alles besteht hier aus einem schwarzen Gestein, auch hier wachsen die "
     "verkrueppelten Buesche und Baeume nicht, wie andernorts. "
     "Die Hoehlendecke ist auch weiterhin recht duester ueber Dir. "
     "Im Osten, weiter ueber Dir, siehst Du den oberen Rand einer sehr hohen "
     "Klippe.");
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"hoehlendecke","decke"}),
     "Die Decke ist hier so verhangen, dass Du sie gar nicht wirklich sehen "
     "kannst.");

   AddDetail( ({"boden"}),
     "Da liegen einige Steine herum.");

   AddDetail( ({"rand"}),
     "Mehr siehst Du von hier aus nicht. Vielleicht hast Du von woanders eine"
     " bessere Sicht.");

   AddDetail( ({"sicht"}),
     "Woanders hab ich gesagt... .");

   AddDetail( ({"klippe", "klippen"}),
     "Eigentlich gibts es hier kaum etwas zu sehen bis auf den Lavafall, der, "
     "nachdem er die Felswand herunterstuerzt, sich auf eigenartige Weise "
     "aufteilt.");

   AddDetail( ({"lavafall"}),
     "Er faellt von oben auf einen eigenartigen Felsen herab, der den Fluss "
     "der Lava in zwei verschiedene Richtungen 'aufspaltet'. Das wird wohl e"
     "ine der seltsamen 'Adern' sein die Du von weitem wahrgenommen hast.");

   AddDetail( ({"ader","adern"}),
     "Na der Lavafall, was denn sonst?");

   AddDetail( ({"lava"}),
     "Geschmolzenes Gestein.");

   AddDetail( ({"felsen","fels","steine","gestein"}),
     "Es ist ein nachtschwarzes Material, das entfernt an Basalt oder Obsidian"
     " erinnert.");

   AddDetail( ({"material","materialien","basalt","obsidian"}),
     "Das sieht eben wie Vulkangestein aus.");

   AddDetail( ({"vulkangestein"}),
     "Wird von einem Vulkan ausgespuckt.");

   AddDetail( ({"vulkan"}),
     "Der spuckt Vulkangestein aus.");

   AddDetail( ({"lavafluss","fluss","lavastrom","strom"}),
     "Fliesst wie jeder andere Fluss auch weiter bergab. Hier fliesst er nach "
     "unten in den Norden und Westen weiter.");

   AddDetail( ({"norden","westen","richtung","richtungen"}),
     "Ueber Richtungen haben sich schon zu viele ausgelassen, darum hier keine "
     "Diskussion mehr darueber.");

   AddDetail( ({"diskussion"}),
     "Nein.");

   AddDetail( ({"weise"}),
     "Wie mit einer scharfen Klinge geteilt."); 

   AddDetail( ({"felsen"}),
     "Als Du genauer hinsiehst, bemerkst Du dass es kein Felsen, sondern eine "
     "Statue ist, die hier steht.");

   AddSpecialDetail( ({"statue"}), "damage1");
/*hier bitte sowas wie 
"in einem unbeobachteten Moment dreht die statue die axt ein bisschen und lenkt
die lava auf dich zu"*/

   AddDetail( ({"berserker"}),
     "Sie stapfen mit ihren gewaltigen Muskeln, den riesigen Aexten, den "
     "schweren Helmen und Stiefeln durch die Gegend und spalten oder bruellen "
     "alles nieder was sich ihnen in den Weg stellt und nicht ausweicht.");

   AddDetail( ({"muskeln"}),
     "Nur Stiere haben mehr.");

   AddDetail( ({"stiere","stier"}),
     "Wenn Du's nicht glaubst geh auf die Weide in Derlim und sieh ihn Dir "
     "den Stier dort an.");

   AddDetail( ({"weide"}),
     "Dort ist der Stier.");

   AddDetail( ({"derlim","hobbit","hobbits"}),
     "In Derlim sind die Hobbits beheimatet.");

   AddDetail( ({"aexte","axt"}),
     "Sie haben meistens lange Stiele und grosse Axtblaetter mit geschaerften "
     "Klingen. Auch dieser Berserker hat seine Axt gezueckt. Damit wird "
     "vermutlich auch der Lavastrom geteilt."),

   AddDetail( ({"stiele","stiel"}),
     "Meistens sind sie von den vielen Kerben der getoeteten Gegner schon "
     "einigermassen zerschlissen, aber dieser hier sieht noch ziemlich "
     "ungebraucht aus.");

/*hier bitte entweder nach geloester/nicht geloester runenquest antwort 
ausgeben*/
   AddSpecialDetail( ({"kerben", "kerbholz", "holz"}), "kerb");
   
   AddDetail( ({"runenquest"}),
     "Frag Molkine danach.");

   AddDetail( ({"molkine"}),
     "Sie ist ein Hobbit.");

   AddDetail( ({"gegner"}),
     "Von denen lebt logischerweise keiner mehr.");

   AddDetail( ({"axtblatt","axtblaetter"}),
     "Von denen ist ein jedes mindestens so gross wie Dein Kopf.");

   AddDetail( ({"kopf"}),
     "Maechtig gross.");

   AddDetail( ({"klinge"}),
     "Ziemlich scharf. Die wuerde sogar fuer Haarspaltereien reichen.");

   AddDetail( ({"haarspaltereien","haarspalterei"}),
     "Jetzt hoer aber damit auf.");

   AddDetail( ({"helme","helm"}),
     "Dieser Berserker hat maechtige grosse Stierhoerner auf seinem Helm "
     "befestigt.");

   AddDetail( ({"hoerner","stierhoerner"}),
     "Freiwillig hat der Stier die sicher nicht hergegeben.");

   AddDetail( ({"stiefel","powerstiefel","steigeisen"}),
     "Schuhgroesse 52, mit Metallbeschlaegen rundherum und vielen kleinen "
     "Zacken auf der Sohle.");

   AddDetail( ({"schuhgroesse"}),
     "Viel groesser als die Deinen.");

   AddDetail( ({"metall","beschlaege","metallbeschlaege"}),
     "Sehen sehr schwer aus.");

   AddSpecialDetail( ({"zacken","sohle"}), "damage2");

   AddDetail( ({"tritt","hintern"}),
     "Das muss verdammt weh tun.");

   AddDetail( ({"gegend","weg"}),
     "Das wird der Berserker hier wohl nie wieder koennen.");

   AddDetail( ({"felswand"}),
     "Ziemlich hoch. Und es kommt ein Lava von dort herunter. Pass auf das "
     "Dich kein heisser Tropfen am Hirn erwischt, wenn Du so nach oben "
     "schaust.");

   AddDetail( ({"tropfen","hirn"}),
     "Dann macht es Zissssssssssssssch ... und Du brauchst Dir nie wieder "
     "ueber irgendwas Gedanken zu machen."),

   AddDetail( ({"gedanken"}),
     "An was denkst Du gerade?");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Du riechst etwas Schwefel.");

   AddSmell( ({"schwefel"}),
     "Riecht wie halbverfaulte Eier."); 

   AddSmell( ({"eier"}),
     "Das ist nur eine Redewendung.");

   AddSmell( ({"redewendung"}),
     "Du willst SOWAS riechen?");

//Geraeusche:
  AddSound(DEFAULT_SOUND,
     "Neben dem Knistern der Blitze kannst Du auch ein dumpfes Klopfen und ein "
     "leises Gluckern wahrnehmen.");

   AddSound( ({"gluckern"}),
     "Das kommt wohl vom Lavafluss.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander reiben "
     "wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","pulsieren","leuchten","lavafluss"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"klopfen"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren und Leuchten im Berg zu"
     " hoeren.");

   AddSound( ({"berg"}),
     "Auch wenn Du es nicht wahrhaben willst, der Berg scheint dich noch immer "
     "in irgendeiner Weise anzuziehen.");

   AddSound( ({"weise"}),
     "Eine unheimliche Weise.");
     
   AddDetail( ({"baeume","buesche","Du's","insel","sowas","steinchen","waende",
                "wand","zissssssssssssssch", "osten"}),
     "Uninteressant fuer Dich.");

//Die Exits:

   AddExit("nordunten", ROOM "c2_lavatuempel");
   AddExit("westunten", ROOM "b3_lavatuempel");
   
   SetProp(P_HIDE_EXITS, ({"norden", "westen"}) );
   AddExit("norden", ROOM "c2_lavatuempel");
   AddExit("westen", ROOM "b3_lavatuempel");
}
string damage1()
{
 string s;
 s = "Es ist (war) ein ogrischer Berserker, aber anscheinend leider wenig\n"
     "schlauer, (weil er sich hat erwischen lassen). Geh nicht zu nahe ran,\n"
     "nicht dass Du Dich an der Lava noch verbrennst.\n"
     "In einem unbeobachteten Moment dreht die Statue die Axt ein bisschen\n"
     "und lenkt die Lava auf Dich zu.\nDu kannst noch zurueckspringen,\n"
     "aber verbrennst Dich leicht.\n";
 TP->AddHp(-15);
 return s; 
}
string damage2()
{
 string s;
 s = "Das ist sicher einer der beruechtigten Powerstiefel mit befestigtem\n"
     "Steigeisen. Damit moechtest Du keinen Tritt in den Hintern bekommen.\n"
     "Als Du Dich gerade umdrehen willst bekommst Du einen Tritt in den Hintern"     "!\n";
 TP->AddHp(-5);
 return s; 
}
string kerb()
{
 string s;
 if(TP->QueryQuest("Runen der Priesterin"))
 {
   s = "Du hast schon so einiges auf dem Kerbholz.\n";
 }
 else
 {
   s = "WAS? Du hast die Runenquest noch nicht geloest?. Schaem Dich. Das wird "
       "jetzt aber sofort erledigt.\n";
 }
 return BS(s); 
}