#include "../def.h"
#include <properties.h>

inherit "std/room";



void create()
{
  ::create();
  
   SetProp(P_INT_SHORT, "Beim nordwestlichen Monolithen");
   SetProp(P_INT_LONG,
     "Vor Dir ragt ein verdrehter Monolith in die Hoehe, aehnlich einem "
     "duerren Finger einer verkrampften Hand. Er biegt sich Richtung "
     "Suedosten, wo er mit anderen Monolithen eine Art Kuppel bildet. Du "
     "fuehlst ein Pulsieren in Dir, so als wuerde Dich unendliche Macht "
     "durchstroemen. Die Hoehlendecke hier ueber Dir kommt einem noch "
     "duesterer vor als sonstwo. Hinter dem Monolithen geht die steile "
     "Felswand der Klippe runter bis zum See.");
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]));
   SetProp(P_INDOORS, 1);

   AddDetail( ({"hoehlendecke"}),
     "Dunkel und verhangen ist die Decke ueber Dir und auch kein bisschen "
     "naeher als vorher.");

   AddDetail( ({"boden"}),
     "Der besteht wie ueberall hier aus diesem seltsamen schwarzen Gestein.");

   AddDetail( ({"gestein"}),
     "Dunkelschwarz. Du hast noch nie ein aehnliches Gestein gesehen. Es sieht"
     " extrem hart und wiederstandsfaehig aus.");

   AddDetail( ({"felswand","klippe"}),
     "Hui, da gehts ja wirklich moerderisch steil runter. An Deiner Stelle "
     "wuerde ich da nicht zu nahe zum Rand gehen.");

   AddDetail( ({"stelle"}),
     "Da ich nicht an Deiner Stelle bin, musst Du das schon selbst "
     "entscheiden.");

   AddDetail( ({"rand"}),
     "Wie mit einem Zirkel gezogen, zieht er sich rund um das ganze Plateau."); 

   AddDetail( ({"plateau"}),
     "Das ist hier oben, da unten ist der Hang und wenn Du da runterfliegst,"
     " koenntest Du sogar im See landen, statt auf dem kleinen Hangstueck.");

   AddDetail( ({"hang","hangstueck","stueckchen"}),
     "Das ist auch wirklich nur ein kleines Stueckchen.");

   AddDetail( ({"see"}),
     "Der sieht von hier oben sogar noch imposanter, wenn auch weniger g"
     "efaehrlicher als von unten aus. Du glaubst in der Ferne eine kleine "
     "Insel zu sehen.");

   AddDetail( ({"zirkel"}),
     "Da ist natuerlich keiner, das ist nur so dahin gesagt.");

   AddDetail( ({"ferne","insel"}),
     "Vielleicht hast Du Dich auch getaeuscht.");

   AddDetail( ({"monolith"}),
     "Verdreht und verwittert, dennoch ungebeugt ragt dieser Monolith Richtung "
     "Decke. Auf einer Seite ist eine Rune in den Stein eingelassen.");

   AddDetail( ({"decke"}),
     "Immer noch da oben, egal wie oft Du es auch untersuchst.");

   AddDetail( ({"hoehe"}),
     "Ist immer oben.");

   AddDetail( ({"richtung","richtungen","suedosten"}),
     "Ueber Richtungen haben sich schon zu viele ausgelassen, darum hier keine "
     "Diskussion mehr darueber.");

   AddDetail( ({"diskussion"}),
     "Nein.");

   AddDetail( ({"seite"}),
     "Die Seite, die Dir zugewandt ist, traegt die Rune.");

   AddDetail( ({"rune"}),
     "Die Rune stellt zwei Kreise dar. Eigentlich kommt Dir das Ganze doch "
     "irgendwie seltsam vertraut vor."),

   AddDetail( ({"ganze","ganz"}),
     "Du weist nur nicht woher.");
 
   AddDetail( ({"kreise"}),
     "Offenbar ein Symbol fuer Humus. Hier wurde es aber seltsam verunstaltet.");

   AddDetail( ({"symbol"}),
     "Die Kreise.");

   AddDetail( ({"humus"}),
     "Im allgemeinen frische, mineral- und naehrstoffreiche Erde.");

   AddDetail( ({"erde"}),
     "Nein, die findest Du hier nicht.");

   AddDetail( ({"stein"}),
     "Hmm ... Du weisst nicht, welche Steinart das ist.");

   AddDetail( ({"pulsieren","macht","kraft"}),
     "Du spuerst foermlich wie Dein Koerper unter dem Ansturm dieser Kraft "
     "erbebt.");

   AddDetail( ({"koerper"}),
     "Er erbebt foermlich.");

   AddDetail( ({"ansturm"}),
     "Du kannst Dich kaum noch aufrecht halten.");

   AddDetail( ({"finger","hand"}),
     "Nur ein bildlicher Vergleich.");

   AddDetail( ({"vergleich","waffenexperten"}),
     "Wenn Du etwas vergleichen willst, geh zum einem Waffenexperten.");

   AddDetail( ({"art","kuppel"}),
     "Naja, keine wirklich Kuppel, nur die Andeutung einer solchen.");

   AddDetail( ({"andeutung"}),
     "Willst Du hier irgendwas andeuten?");

//Geraeusche:
   AddSound(DEFAULT_SOUND,
     "Neben dem Knistern der Blitze und dem hier staerker werdenden dumpfen "
     "Klopfen kannst Du aus Richtung des Monolithen staendig leise Stimmen, "
     "die mal drohender mal flehender werden wahrnehmen.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander reiben "
     "wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","pulsieren","leuchten"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"klopfen"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren des Leuchtens im Berg zu"
     " hoeren. Es duerfte irgendwo hier oben seinen Ursprung haben.");

   AddSound( ({"berg"}),
     "Auch wenn Du es nicht wahrhaben willst, der Berg scheint dich noch immer "
     "in anzuziehen.");

   AddSound( ({"richtung"}),
     "Richtungen kann man doch nicht hoeren.");

   AddSound( ({"monolith"}),
     "Er vibriert leise.");

   AddSound( ({"stimmen","sprache"}),
     "Die Stimmen sprechen in einer Dir unbekannten Sprache, daher verstehst "
     "Du auch nicht was sie sagen.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Eigentlich kannst Du hier oben nur einen ganz schwachen Geruch von "
     "verfaulender Erde wahrnehmen.");

   AddSmell( ({"geruch","erde"}),
     "Jawohl ... stinkende, verrottende Erde, wie sie sonst nur am Friedhof "
     "oder auf einem Komposthaufen zu finden ist.");

   AddSmell( ({"friedhof","komposthaufen"}),
     "Da riecht es auch genauso wie hier.");
     
   AddDetail( ({"steinart", "waende", "ursprung", "wand"}),
     "Findest Du so nicht.");

//Die Exits:

   AddExit("sueden", ROOM "d3_kraterrand");
   AddExit("osten", ROOM "e2_kraterrand");
}