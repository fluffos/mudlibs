#include "../def.h"
#include <properties.h>

inherit "std/room";

int i;

void create()
{
  ::create();
  
   i=1;
  
   SetProp(P_INT_SHORT, "Am Fusse des Berges");
   SetProp(P_INT_LONG,
     "Du stehst nun am noerdlichsten Hang der Insel. Ueberall liegen grosse "
     "und weniger grosse Felsen herum, auch kleine Steinchen sind zu sehen. "
     "Alles besteht hier aus einem schwarzen Gestein, wo ausser ein paar "
     "verkrueppelten Bueschen und Baeumen nichts zu wachsen scheint. Ueberall "
     "tanzen die Schatten und Du meinst einige befinden sich gar nicht mehr "
     "auf einer festen Oberflaeche sondern scheinen sich Dir irgendwie zu "
     "naehern. Auch hat sich ueber Dir nichts veraendert, die Blitze zucken "
     "weiterhin durch die Schwaden an der Hoehlendecke.");
   SetProp(P_LIGHT, 0);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS, 1);

   AddDetail( ({"boden"}),
     "Er besteht aus einem nachtschwarzen Material.");

   AddDetail( ({"teil"}),
     "Stueck eines Ganzen.");

   AddDetail( ({"stueck"}),
     "Teil eines Ganzen.");

   AddDetail( ({"ganzes","ganzen","ganz"}),
     "Besteht aus Stuecken und Teilen :-) .");

   AddDetail( ({"hang","abhang"}),
     "Naja, Abhang kann man das hier eigentlich nicht nennen, eigentlich waere "
     "der Begriff Felskueste passender.");

   AddDetail( ({"begriff"}),
     "Den hast Du nicht begriffen.");

   AddDetail( ({"felskueste","kueste"}),
     "So nennt sich eine Kueste aus Felsen. Du stehst an ihrem Fusse.");

   AddDetail( ({"fuss","fusse"}),
     "Die Klippe hat einen, Du hast zwei davon.");

   AddDetail( ({"klippe"}),
     "Man koennte sie auch Felskueste nennen.");

   AddDetail( ({"insel" , "norden"}),
     "Egal wie oft Du 'Insel' noch untersuchst, aendern wird sich an ihrem "
     "Aussehen trotzdem nichts.");

   AddDetail( ({"aussehen"}),
     "Das muesstest Du jetzt doch schon eigentlich kennen, oder?");

   AddDetail( ({"felsen","fels","steine","gestein"}),
     "Es ist ein nachtschwarzes Material, das entfernt an Basalt oder Obsidian"
     " erinnert. Du glaubst einen besonderen Stein zu sehen.");

   AddDetail( ({"material","materialien","basalt","obsidian"}),
     "Solche Materialien sind in der Naehe von Vulkanen nicht unueblich.");

   AddDetail( ({"naehe"}),
     "Nicht weit weg. Nicht sehr weit entfernt. Nahe halt.");

   AddDetail( ({"vulkan","vulkane"}),
     "Ein feuerspuckender Berg.");

   AddDetail( ({"berg"}),
     "Das riesige Dings da vor Dir.");

   AddDetail( ({"dings"}),
     "Wenn Du mehr ueber Dings wissen willst, frag einfach Amnenion.");

   AddDetail( ({"amnenion"}), "Wirst ihn kennenlernen.");

   AddSpecialDetail( ({"stein"}), "glas");
     /*"Dieser Stein sieht aus wie ein kleiner, in Glas gegossener, "
     "Totenschaedel.");
/*hier haett ich die idee, auf der ganzen insel so kleine glastotenteile zu 
verteilen mit denen man sich irgendwie a bisserl gegen die wirkung der insel 
schuetzen kann (wahrscheinlich werdens einige am anfang brauchen wenns dort 
forschen oder nekros werden wollen und sich net auskennen noch dort ... 
anderen koennts natuerlich auch helfen, ma muss halt nur alle 7 teilen finden.*/

   AddDetail( ({"glas"}),
     "Sehr durchsichtig und oft schnell kaputt.");

   AddDetail( ({"totenschaedel","schaedel"}),
     "Zwei Augenhoehlen, zwei Nasenloecher, ein Mund mit Zaehnen, eine "
     "Schaedeldecke und ein bisschen Rueckgrat.");

   AddDetail( ({"augenhoehle","augenhoehlen","nasenloch","mund","zaehne"}),
     "Du tastest an Dir herum und bemerkst: Das hast Du.");     

   AddDetail( ({"decke"}),
     "Meinst Du jetzt die Schaedeldecke oder die 'Hoehlendecke' hier?");

   AddDetail( ({"schaedeldecke"}),
     "Da hast Du noch Haare.");

   AddDetail( ({"rueckgrat"}),
     "Davon braeuchtest Du auch mehr.");

   AddDetail( ({"haare", "kopf", "rikz", "levitikus"}),
     "Noch. Ausser eventuell Rikz und Levitikus. (Zumindest auf dem Kopf)");

   AddDetail( ({"hoehlendecke"}),
     "Die Hoehlendecke ist soweit oben und so verhangen, dass Du sie gar nicht "
     "siehst.");

   AddDetail( ({"baeume","baum","busch","buesche"}),
     "Sie klammern sich mit ihren kargen Wurzeln an den Felsen fest, und es "
     "sieht fast so aus als wuerden sie sich Dir entgegenstrecken.");
/*hier haett ich einen idee, wo man random die baeume (ich verteil sie eh 
ueberall), wirklich nach einem greifen laesst oder eventuell ein baummonster 
entstehen lassen koennte das sich mit dem spieler (bzw. er mit dem monster :) )
befasst.*/

   AddDetail( ({"wurzeln"}),
     "Die finden hier auf diesem unwirtlichen Fleck des Silberlands kaum "
     "Naehrstoffe.");

   AddDetail( ({"fleck"}),
     "Die Insel, was sonst?");

   AddDetail( ({"silberland"}),
     "Wenn Du bist jetzt noch nicht weisst, dass Du im Silberland, weisst Du "
     "es jetzt.");

   AddDetail( ({"stoff","stoffe"}),
     "Stoff? Wo siehst Du hier Stoff?");

   AddDetail( ({"naehrstoffe","naehrstoff"}),
     "Die finden sich auf diesen leblosen Felsen kaum, sodass hier kaum "
     "etwas waechst.");

   AddDetail( ({"schatten"}),
     "Sie fuehren einen makabren Tanz auf.");

   AddDetail( ({"tanz"}),
     "Vielleicht ist es Dein Totentanz.");

   AddDetail( ({"totentanz"}),
     "Fordere Dein Glueck nicht zu sehr heraus.");

   AddDetail( ({"glueck"}),
     "Bald wird es Dich verlassen.");

   AddDetail( ({"oberflaeche","flaeche"}),
     "Auf ihr tanzen die Schatten herum. Allerdings scheinen sich einige davon "
     "loesen zu wollen und strecken sich Dir mit verzerrten Gesichtern "
     "entgegen.");

   AddDetail( ({"gesichter"}),
     "Zerrbilder des Schreckens.");

   AddDetail( ({"zerrbilder","bilder"}),
     "Verzerrt. Abnormal. Schrecklich.");

   AddDetail( ({"schrecken","schreckens"}),
     "      .----------.        \n"
     "     /  .-.  .-.  \\      \n"
     "    /   |o|  |o|   \\     \n"
     "    \\   `-'°°`-'  _/     \n"
     "    /\     .--.  / |      \n"
     "    \\ |   /  /  / /      \n"
     "    / |  `--'  /\\ \\     \n"
     "     /`-------'  \\ \\    \n"); 

   AddDetail( ({"blitze"}),
     "Huch da haette Dich doch fast einer getroffen, der nicht Richtung Berg "
     "zuckte.");

   AddDetail( ({"schwaden"}),
     "Das was da an der Decke den Nebel verursacht.");

   AddDetail( ({"nebel"}),
     "Sieh nach oben.");
     
   AddDetail( ({"leuchten"}),
     "Du hast Dich wohl getaeuscht.");

//Geraeusche
   AddSound(DEFAULT_SOUND,
     "Neben den leiser werdenden Wellen und dem Knistern der Blitze kannst Du "
     "auch ein dumpfes Klopfen wahrnehmen.");

   AddSound( ({"wellen"}),
     "Man hoert sie kaum noch hinter den hohen Felsen hier.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander reiben "
     "wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","pulsieren","leuchten"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"klopfen"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren des Leuchtens im Berg zu"
     " hoeren.");

   AddSound( ({"berg"}),
     "Auch wenn Du es nicht wahrhaben willst, der Berg scheint dich noch immer "
     "in irgendeiner Weise anzuziehen.");

   AddSound( ({"weise"}),
     "Eine unheimliche Weise.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Der Geruch ist eigentlich nur mehr ganz wenig wahrzunehmen. Im Norden "
     "hingegen wird er sicher staerker sein als hier.");

   AddSmell( ({"norden"}),
     "Das kannst Du nicht riechen, nur untersuchen.");

   AddSmell( ({"Geruch"}),
     "Der ist hier sicher nicht mehr schaedlich fuer Deine Gesundheit.");

   AddSmell( ({"gesundheit"}),
     "Bist Du gesund?");
     
   AddDetail( ({"ihn", "nasenloecher", "steinchen", "wand", "waende"}),
     "Du wirst abgelenkt.");

//Die Exits:

   AddExit("norden", ROOM "e-1_steg");
   AddExit("suedoben", ROOM "e1_aufstieg");
   AddExit("suedosten",ROOM "f1_zwischenstueck");
   AddExit("suedwesten", ROOM "d1_ufernaehe");
   
   SetProp(P_HIDE_EXITS, ({"sueden"}) );
   AddExit("sueden", ROOM "e1_aufstieg");
}
string glas()
{
  string s;
  object ob;
  
  if(i)
  { 
    s = "Dieser Stein sieht aus wie ein kleiner, in Glas gegossener, "
        "Totenschaedel. Seltsam, dass Du ihn nicht gleich gesehen hast. "
        "Er liegt regelrecht offen herum.";
    ob=clone_object(OBJ "schaedel");
    ob->move(TO, M_NOCHECK | M_SILENT);
    i=0;
    return BS(s); 
  }
  s = "Du hast Dich getaeuscht, da liegt im Moment nichts.";
  return BS(s); 
}
void reset()
{
  if(!present("\nglas_schaedel")) {i=1;}
  ::reset();
}