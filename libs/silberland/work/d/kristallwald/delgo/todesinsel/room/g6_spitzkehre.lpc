#include "../def.h"
#include <properties.h>

inherit "std/room";

int i;

void create()
{
  ::create();
  
  i=1; 
   
   SetProp(P_INT_SHORT, "Ein Spitzkehre");
   SetProp(P_INT_LONG,
     "Du stehst hier auf einem der gefaehrlichsten Abhaenge der Insel, denn "
     "wenn Du hier abrutschst und runterkullerst gibt es kein flaches Stueck "
     "mehr auf dem Du ausrollen kannst. Hier ist in fast jeder Richtung, bis "
     "auf den Weg im Nordosten und Nordwesten, um Dich herum nur die See. Weit "
     "im Westen siehst Du einen hoffnungslos ueberspuelten Teil der Insel. "
     "Zwischen den ganzen Steinen und felsenaehnlichen Brocken siehst Du auch "
     "wieder einmal ein paar dieser verkrueppelten Buesche und Baeume wachsen. "
     "Die Hoehlendecke ist auch hier ziemlich turbulent und aufgewuehlt.");
   SetProp(P_LIGHT, 0);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_CAVE]) );
   SetProp(P_INDOORS,1);

   AddDetail( ({"hoehlendecke","decke"}),
     "Die Hoehlendecke ist soweit oben und so verhangen, dass Du sie gar nicht "
     "wirklich siehst.");

   AddDetail( ({"boden"}),
     "Da liegen ueberall Felsen und Steine herum. Hier liegt allerdings auch "
     "viel Schotter herum, sodass Du bei jedem Schritt aufpassen solltest, "
     "nicht auszurutschen. Ausserdem siehst Du ein Glitzern zwischen den "
     "Steinen.");

   AddDetail( ({"felsen","steine","gestein","fels","schotter","brocken"}),
     "Es ist ein nachtschwarzes Material, das entfernt an Basalt oder Obsidian "
     "erinnert.");

   AddDetail( ({"material","materialien","basalt","obsidian"}),
     "Das sieht eben wie Vulkangestein aus.");

   AddDetail( ({"vulkangestein"}),
     "Wird von einem Vulkan ausgespuckt.");

   AddDetail( ({"vulkan"}),
     "Der spuckt Vulkangestein aus.");

   AddDetail( ({"insel"}),
     "Egal wie oft Du die Insel noch untersuchst, es aendert sich deswegen "
     "auch nichts an ihr.");

   AddDetail( ({"schritt"}),
     "Sobald Du hier den ersten falschen getan hast, wird es vermutlich Dein "
     "letzter auf dieser Insel gewesen sein.");

   AddDetail( ({"abhang","abhaenge"}),
     "Dieser Abhang hier ist deswegen so gefaehrlich, weil er einen Knick "
     "mitten drinnen hat, ueber den man tunlichst nicht fallen sollte, ausser "
     "man ist scharf auf ein Bad in dem kochend heissen Wasser.");

   AddDetail( ({"knick"}),
     "Du fuehlst Dich einfach einmal so geknickt.");

   AddDetail( ({"Bad"}),
     "Loest unter Garantie alle Verspannungen in Deinen Muskeln auf.");

   AddDetail( ({"garantie"}),
     "Die einzige Garantie die Du hier bekommst, ist die auf einen langsamen "
     "und qualvollen Tod.");

   AddDetail( ({"tod"}),
     "Eine Stimme hinter Dir sagt: 'LARS UND ICH VERMISSEN DICH SCHON.'");

   AddDetail( ({"stimme","lars"}),
     "Du drehst Dich um, aber da steht niemand.");

   AddDetail( ({"muskeln"}),
     "Bloed ist nur, dass sich die Muskeln dann auch gleich aufloesen.");

   AddDetail( ({"verspannungen"}),
     "Auf einmal spuerst Du sie wieder ueberall an Dir. Eine Massage waere "
     "jetzt genau das Richtige.");

   AddDetail( ({"massage"}),
     "Tja, leider wirst Du hier nirgends die Moeglichkeit dazu haben.");

   AddDetail( ({"moeglichkeit"}),
     "Die hast Du hier nirgends.");

   AddDetail( ({"richtig","richtige","sachen"}),
     "Solche sinnlosen Sachen untersuchst Du?");

   AddDetail( ({"stueck"}),
     "Das fehlt hier, darum wirst Du auch ungebremst ueber den Knick "
     "hinaussausen.");

   AddDetail( ({"richtung","richtungen"}),
     "Die einzig begehbaren Richtungen hier sind Nordwesten und Nordosten, "
     "ansonsten kannst Du nirgend wo hin.");

   AddDetail( ({"weg"}),
     "Nenn es Weg, nenn es Abhang, nenn es wie Du willst, auf jeden Fall "
     "kommst Du hier in zwei Richtungen weiter.");

   AddDetail( ({"fall"}),
     "Pass auf das Du nicht ausrutschst und hinfaellst.");

   AddDetail( ({"nordosten","nordwesten","westen"}),
     "Im Nordwesten gehts rauf, im Nordosten runter und nach Westen kannst Du "
     "von hier aus nicht.");

   AddDetail( ({"saeuresee","see"}),
     "Du bist zwar jetzt schon etwas oberhalb des Sees, aber deswegen ist er "
     "noch lange nicht weniger gefaehrlich als vorher, den es schaffen trotzdem"
     " immer noch einige heisse Tropfen aus der Gischt bis hierher zu "
     "tropfen.");

   AddDetail( ({"wasser","tropfen","gischt"}),
     "Das wird Dir ganz sicher nicht gut tun, wenn Du es zu genau "
     "untersuchst.");

   AddDetail( ({"teil"}),
     "Dort ist schon ein Grossteil des Gesteins weggefressen. Wer weiss "
     "was dort einmal gestanden hat.");

   AddDetail( ({"grossteil"}),
     "Ein Grossteil ist ein grosser Teil.");

  AddDetail( ({"baeume","baum","busch","buesche"}),
     "Sie klammern sich mit ihren kargen Wurzeln an den Felsen fest, und es "
     "sieht fast so aus als wuerden sie sich Dir entgegenstrecken.");
/*hier haett ich einen idee, wo man random die baeume (ich verteil sie eh 
ueberall), wirklich nach einem greifen laesst oder eventuell ein baummonster 
entstehen lassen koennte das sich mit dem spieler (bzw. er mit dem monster :) )
befasst.*/

   AddDetail( ({"wurzeln"}),
     "Die finden hier auf diesem unwirtlichen Fleck des Silberlands kaum "
     "Naehrstoffe.");

   AddDetail( ({"fleck"}),
     "Die Insel, was sonst?");

   AddDetail( ({"silberland"}),
     "Wenn Du bist jetzt noch nicht weist, dass Du im Silberland, weist Du es "
     "jetzt.");

   AddDetail( ({"stoff","stoffe"}),
     "Stoff? Wo siehst Du hier Stoff?");

   AddDetail( ({"naehrstoffe","naehrstoff"}),
     "Die finden sich auf diesen leblosen Felsen kaum, sodass hier kaum etwas "
     "waechst.");

   AddSpecialDetail( ({"glitzern"}), "glas");
     /*"Als Du es Dir naeher betrachtest, bemerkst Du das es eine glaeserne "
     "Nachbildung einer Wirbelsaeule samt Becken ist. Du kannst sie nehmen wenn"
     " Du willst.");
/*hier haett ich die idee, auf der ganzen insel so kleine glastotenteile zu 
verteilen mit denen man sich irgendwie a bisserl gegen die wirkung der insel 
schuetzen kann (wahrscheinlich werdens einige am anfang brauchen wenns dort 
forschen oder nekros werden wollen und sich net auskennen noch dort ... anderen
koennts natuerlich auch helfen, ma muss halt nur alle 7 teilen finden.*/

   AddDetail( ({"bildung"}),
     "Die Einbildung ist noch immer Deine groesste Bildung.");

   AddDetail( ({"einbildung"}),
     "Bild Dir bloss nichts darauf ein.");

   AddDetail( ({"nachbildung"}),
     "Eine Nachbildung nennt man so, weil sie nicht echt ist, ein Duplikat "
     "sozusagen.");

   AddDetail( ({"duplikat"}),
     "Etwas, das von was anderem kopiert wurde.");

   AddDetail( ({"wirbelsaeule","saeule"}),
     "Man sieht jedes Detail fein herausgearbeitet, von den Wirbeln "
     "angefangen, bis hin zu den Bandscheiben und dem Rueckenmark.");

   AddDetail( ({"detail"}),
     "Auch das Wort Detail ist hier ein Detail.");

   AddDetail( ({"wort"}),
     "Das ist auch ein Detail.");

   AddDetail( ({"wirbel"}),
     "Wenn Du einigermassen gelenkig bist, kannst Du sie auch bei Dir ertasten.");

   AddDetail( ({"bandscheiben","scheiben"}),
     "Die Bandscheiben sind zwischen den Wirbeln gelagert und dazu da, dass "
     "sich die Wirbeln nicht aneinander reiben und abnuetzen. So passieren "
     "Bandscheibenvorfaelle naemlich.");

   AddDetail( ({"bandscheibenvorfall","vorfall","bandscheibenvorfaelle",
                "vorfaelle"}),
     "Die passieren wenn die Bandscheiben abgenutzt sind.");

   AddDetail( ({"becken"}),
     "Tja irgendwie schwer zu beschreiben, aber wenn Du schon mal irgendwo ein "
     "Skelett hast herumlaufen sehen, weisst Du ja bestimmt wie sowas "
     "aussieht.");

   AddDetail( ({"skelett"}),
     "Sowas laeuft hier doch an allen Ecken und Enden mal herum.");

   AddDetail( ({"ecken","ecke"}),
     "Pass auf das Du bei der naechsten Ecke nicht in eines hineinlaeufst.");

   AddDetail( ({"enden","ende"}),
     "Schluss. Aus. Das war das letzte Detail hier.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Bis auf den Geruch des heiss-stinkenden Wasser, der vom See her "
     "aufsteigt, ist es hier eigentlich ziemlich oede.");

   AddSmell( ({"geruch"}),
     "Ein scharfer und beissender Geruch, der Dir die Nase veraetzen wird, "
     "wenn Du Dich mit riechen nicht etwas am Riemen reisst.");

   AddSmell( ({"nase"}),
     "Das hat bisher noch niemand geschafft.");

   AddSmell( ({"riemen"}),
     "Das es hier keinen gibt, kannst Du ihn auch nicht riechen.");

   AddSmell( ({"see"}),
     "Den See kannst Du nicht riechen, nur die das heiss-stinkende Wasser.");

//Geraeusche:
   AddSound(DEFAULT_SOUND,
     "Neben dem Klatschen der Wellen kannst Du hier noch das Knistern der "
     "Blitze und ein dumpfes Klopfen wahrnehmen und hin und wieder ein "
     "Steinchen in die Wellen plumpsen hoeren.");

   AddSound( ({"steinchen"}),
     "Die kullern ueber die Kante der Kehre nach unten.");

   AddSound( ({"kehre","kante"}),
     "Du horchst an der Kante der Kehre und schneidest Dich ins Ohr, so scharf "
     "wie die ist.");

   AddSound( ({"ohr"}),
     "Daran kannst Du gaaaanz sicher nicht lauschen, und ausserdem blutet es "
     "gerade.");

   AddSound( ({"wellen","klatschen"}),
     "Stetig und unermuedlich rollen sie an und klatschen dabei an der Insel "
     "auf. Wenn sie so weitermachen wird die Insel spaeter irgendwann einmal "
     "verschwunden sein.");

   AddSound( ({"insel"}),
     "Du lauschst an der Insel, hoerst aber nichts besonderes.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an, wie wenn hunderte kleiner Fluegel aneinander reiben "
     "wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","pulsieren","leuchten"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"klopfen"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren und Leuchten im Berg zu "
     "hoeren.");

   AddSound( ({"berg"}),
     "Auch wenn Du es nicht wahrhaben willst, der Berg scheint dich noch immer "
     "in irgendeiner Weise anzuziehen.");

   AddSound( ({"weise"}),
     "Eine unheimliche Weise.");
     
   AddDetail( ({"ich", "r", "und", "schon", "vermissen", "waende", "wand", "kante", "kehre"}), 
     "Dieses Detail wurde an ein Skelett vermietet.");
   AddDetail( ({"steinchen"}),
     "Die Steinchen sind weg.");

//Die Exits:
   AddExit("nordosten", ROOM "h5_unterbrochener_weg");
   AddExit("nordwestoben", ROOM "f5_wegkreuzung");
   
   SetProp(P_HIDE_EXITS, ({"nordwesten"}) );
   AddExit("nordwesten", ROOM "f5_wegkreuzung");
}
string glas()
{
  string s;
  object ob;
  
  if(i)
  { 
    s = "Als Du es Dir naeher betrachtest, bemerkst Du das es eine glaeserne "
        "Nachbildung einer Wirbelsaeule samt Becken ist. "
        "Seltsam, dass sie Dir nicht vorher aufgefallen ist. Sie liegt offen "
        "da.";
    ob=clone_object(OBJ "wirbelsaeule");
    ob->move(TO, M_NOCHECK | M_SILENT);
    i=0;
    return BS(s); 
  }
  s = "Seltsam. Du bist felsenfest davon ueberzeugt hier sollte eine " 
      "Nachbildung einer glaeserne Wirbelsaeule liegen. Oder doch die "
      "glaeserne Nachbildung? *gruebel*";
  return BS(s); 
}
void reset()
{
  if(!present("\nglas_wirbelsaeule")) {i=1;}
  ::reset();
}