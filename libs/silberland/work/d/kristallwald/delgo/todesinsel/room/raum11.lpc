#include "../def.h"
#include <properties.h>

inherit "std/room";

void create()
{
  ::create();
  
   SetProp(P_INT_SHORT, "Auf einem hellen Weg");

   SetProp(P_INT_LONG,
     "Hier ist es deutlich zu sehen, dass die Natur immer einen Weg findet "
     "sich ihr Gebiet zurueckzuholen. Man sieht nur mehr "
     "Kristallgruppierungen an manchen Stellen und die sind auch nicht mehr "
     "allzu gross. Begrenzt wird der Weg zwar hier auch noch durch "
     "Dornenhecken und Baeume,"
     "aber hier ist Etwas anders. Im Osten kannst Du im Hintergrund Berge "
     "sehen. Lichtreflektionen sieht man nicht nur mehr dort wo es auf die "
     "Kristalle faellt sondern auch auf einigen Tautropfen die bis um diese "
     "Tageszeit durchgehalten haben. Am Boden ist eine Oeffnung.");
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_FOREST]) );
   SetProp(P_INDOORS, 0);

   AddDetail( ({"osten", "hintergrund", "berge"}),
     "Majestaetisch ragen sie in der Ferne mit ihren schneebedeckten Gipfeln "
     "in den Himmel.");

   AddDetail( ({"ferne"}),
     "Die Ferne ist sehr weit entfernt. :)");

   AddDetail( ({"gipfel"}),
     "Die sind vom Schnee bedeckt, welcher im Sonnenlicht, das im Gegensatz "
     "zu hier durch keine Wolke aufgehalten wird, funkelt und glitzert.");

   AddDetail( ({"gegensatz"}),
     "Schau doch nach oben in den Himmel.");

   AddDetail( ({"schnee", "flocken"}),
     "Das sind die weissen Flocken die im Winter vom Himmel faellen.");

   AddDetail( ({"winter", "fruehling", "sommer", "herbst"}),
     "Ist eine der Jahreszeiten: Fruehling, Sommer, Herbst und Winter.");

   AddDetail( ({"jahreszeit", "jahreszeiten"}),
     "Davon gibt es vier."); 

   AddDetail( ({"tautropfen", "tageszeit", "zeit", "fruehmorgens"}),
     "Obwohl es hier laengst nicht mehr Fruehmorgens ist, siehst Du noch "
     "einige wenige Tautropfen schimmern.");

   AddDetail( ({"natur", "stellen"}),
     "Hier ist es deutlich zu sehen, dass die Natur immer einen Weg findet "
     "sich ihr Gebiet zurueckzuholen. Man sieht nur mehr "
     "Kristallgruppierungen an manchen Stellen und die sind auch nicht mehr "
     "allzu gross.");

   AddDetail( ({"gebiet"}),
     "Das ist hier der (frueher kristalline) Kristallwald.");

   AddDetail( ({"weg", "waldweg", "boden"}),
     "Der Boden ist hier mit einer Schicht ueberzogen die sich im Allgemeinen "
     "Erde nennt. Nur bei genauerem Hinsehen ragen noch kleine Kristalle aus "
     "ihr heraus. Du siehst eine Oeffnung.");

   AddDetail( ({"hinsehen"}),
     "Du untersuchst aber auch alles.");

   AddDetail( ({"allgemein", "allgemeinen"}),
     "Naja was im Allgemeinen heisst, wirst Du doch nicht im Detail wissen "
     "wollen?");

   AddDetail( ({"detail"}),
     "Das untersuchst Du gerade.");

   AddDetail( ({"schicht", "erde"}),
     "Broeselig und braun, so wie Erde nun mal ist.");

   AddDetail( ({"kristall", "kristalle", "kristallen", "gruppierung", 
                "kristallgruppierungen", "gruppierungen"}),
     "Wenn es nicht Kristall waere, waere hier doch nicht der Kristallwald, "
     "oder?");

   AddDetail( ({"wald", "kristallwald"}),
     "Er besteht hier aus vielen Dornenhecken und Baeumen, aber Etwas ist hier "
     "anders.");

   AddDetail( ({"licht", "sonnenlicht"}),
     "Auch hier wird das Sonnenlicht von den Kristallen reflektiert und "
     "verstaerkt, aber laengst nicht in der Farbenpracht des westlichen Teils "
     "dieses Wegs.");

   AddDetail( ({"teil", "westen"}),
     "Geh zurueck und sieh es Dir doch an.");

   AddDetail( ({"farben", "pracht", "farbenpracht", "regenbogen"}),
     "Du siehst saemtlich Farben des Regenbogens.");

   AddDetail( ({"dornenhecken", "dornenhecke", "hecke", "hecken"}),
     "Es ist eine teilweise mit Kristallen ueberzogene, verfilzte Hecke mit "
     "vielen spitzen Dornen auf ihren Zweigen. Im Norden waechst sie "
     "bedrohlich hoch zwischen den Baeumen. Aber Du siehst im Sueden Etwas das "
     "Deine Aufmerksamkeit auf sich zieht.");

   AddDetail( ({"sueden", "etwas", "aufmerksamkeit"}),
     "Da ist eine Nische in der Hecke, eigentlich eher ein ueberdachter "
     "Rastplatz.");

   AddDetail( ({"rastplatz"}),
     "Da ist ein Haufen Blaetter und eine mit Steinen eingegrenzte "
     "Feuerstelle. Auf Grund der vielen Spuren wagst Du die Annahme zu machen, "
     "dass die Nische haeufig von jemandem benutzt wird, vermutlich "
     "irgendeinem Wanderer.");

   AddDetail( ({"spuren", "wanderer"}),
     "Der Wanderer kommt anscheinend des oefteren hier vorbei und hinterlaesst "
     "hier seine Spuren.");

   AddDetail( ({"haufen", "blaetter"}),
     "Ein Haufen zusammengesammelter Blaetter der vermutlich zum Schlafen "
     "und/oder Ausrasten dient. Koenntest Du ja mal versuchen.");

   AddDetail( ({"steine"}),
     "Die umgeben die Feuerstelle, damit, fallst Du mal beim Feuer "
     "einschlaefst, sich kein Feuer ausbreiten kann.");

   AddDetail( ({"feuerstelle"}),
     "Eine mit Steinen eingegrenzte Feuerstelle, wo man sich waermen oder auch "
     "etwas zu Essen machen kann.");

   AddDetail( ({"norden"}),
     "Da waechst die Hecke besonders hoch.");

   AddDetail( ({"dornen"}),
     "Die sind ganz schoen spitz. Du beschliesst sie nicht anzugreifen.");

   AddDetail( ({"zweige"}),
     "Die kannst Du sicher biegen wie Du willst, abbrechen werden die hier "
     "nicht mehr.");

   AddDetail( ({"beruehrungen", "art", "biegen"}),
     "Naja, Biegen und so halt. Lass es einfach *wuschel*");

   AddDetail( ({"baeume"}),
     "Sie sehen gar nicht mehr aus wie alle anderen Baeume im Kristallwald, "
     "sie haben naemlich nur mehr eine hauchduenne Kristallschicht die sie von "
     "unten bis oben ueberzieht, vom Stamm bis zu den kleinsten Blaettern.");

   AddDetail( ({"stamm"}),
     "Der ist so dick den koenntest nicht mal Du umfassen.");

   AddDetail( ({"blaetter", "blaettern"}),
     "Sind nur mehr von einer hauchduennen, durchsichtigen Kristallschicht "
     "ueberzogen.");

   AddDetail( ({"himmel"}),
     "Oha. Da scheint sich etwas am Himmel zusammenzubrauen. Schau dir nur die "
     "vielen dunklen Wolken an. Auch die Sonne kann da nicht mehr "
     "durchdringen.");

   AddDetail( ({"wolken"}),
     "Sehen aus wie Regenwolken. Such Dir am besten etwas zum unterstellen.");

   AddDetail( ({"sonne"}),
     "Ist hinter den Wolken versteckt.");

//Hier jetzt Gerueche und Geraeusche:
   AddSound( ({DEFAULT_SOUND, "baeume", "unterholz"}),
     "Hier wird es immer lauter. Man hoert mehr und mehr Voegel irgendwo "
     "aus den Baeumen heraus zwitschern oder Insekten durchs Unterholz "
     "rascheln.");

   AddDetail( ({"voegel", "vogel"}),
     "Siehst Du hier nicht, aber hoeren kann man das Gezwitscher.");

   AddDetail( ({"unterholz"}),
     "Das liegt unter den Hecken und Baeumen. Ansonsten waers ja kein "
     "Unterholz.");

   AddSound( ({"gezwitscher", "vogel", "voegel"}),
     "Zwitsch, Zwitsch, Tirili, Tirila ...");

   AddDetail( ({"insekt", "insekten"}),
     "Siehst Du hier nicht, aber hoeren kann man es.");

   AddSound( ({"krabbeln", "insekt", "insekten"}),
     "Kribbel, krabbel, kratz, kratz, schab, schab ...");

   AddSmell( ({DEFAULT_SMELL,"natur","luft"}), 
     "Du holst tief Luft und riechst die Natur. Naja riecht ein bisschen "
     "staubig.");

   AddSmell( ({"staub"}),
     "Riecht staubig.");
     
   AddDetail( ({"annahme" , "ausrasten", "essen", "feuer", "grund", 
                "kristallschicht", "nische", "regenwolken", "schlafen", 
                "tirila", "tirili", "wolke", "zwitsch", "forschen"}),
      "Konzentriere Dich nicht zu sehr auf das Forschen.");
   
   AddDetail( ({"oeffnung"}),
     "Sie ist recht gross und bei genauerem Hinsehen entdeckst Du eine "
     "Wendeltreppe.");
     
   AddDetail( ({ "treppe", "wendeltreppe"}), 
     "Sie scheint weit nach unten zu fuehren, ob Du sie hinuntersteigen "
     "kannst?");

//Die Exits:

   AddCmd( ({"steig", "steige"}), "down");

   AddExit("nordwesten", ROOM "raum10");
   AddExit("nordosten",  ROOM "raum12");
}
int down(string str)
{
  notify_fail("Was willst Du tun?\n");

  if (!str || str == "") return 0;

  if (str != "treppe runter" && str != "treppe hinunter" && str != "runter") 
    return 0;
  tell_object(TP, "Du steigst die zahlreichen Stufen nach unten ...\n");
  TP->SetProp(P_PARALYZED, ([PARALYZE_TIME: 6, 
							PARALYZE_MSG: "Du konzentrierst Dich voll aufs Treppensteigen!\n"
						 ,PARALYZE_MSG_OTHER: "%s steigt die Stufen hinab.\n", 
							PARALYZE_END: "Du hast das Ende der Treppe erreicht und kommst "
							"mitten in einem Steinhaus heraus.\n",
							PARALYZE_END_OTHER: "%s verschwindet nach und nach.\n"]));
  Message(TP->Name(WER, 1)+" steigt eine Treppe hinab.\n"
        , MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  call_out("stair1", 3, TP);
  return 1;
}
int stair1(object pl)
{
  pl->Message(BS("Du laesst den Wald ueber Dir und dringst immer tiefer ins "
                 "Erdreich ein, voller Spannung was Dich dort erwartet.\n")
                 , MSGFLAG_VISUAL);
  call_out("stair2", 3, pl); 
}
int stair2(object pl)
{
  pl->Message(BS("Dir stockt der Atem als Du eine riesige unterirdische Insel "
                 "erblickst. Die Treppe geht weiter nach unten und Du folgst "
                 "ihr.\n"), MSGFLAG_VISUAL);
  call_out("stair3", 3, pl); 
}
int stair3(object pl)
{
  pl->Message(BS("Du hast das Ende der Treppe bald erreicht, unter Dir "
                 "erkennst Du ein kleines Steinhaus. Die Treppe fuehrt genau "
                 "dort hinein.\n"), MSGFLAG_VISUAL);
  call_out("stair4", 2, pl); 
}
int stair4(object pl)
{
  string room;
  
  room = ROOM"e3_vulkanmitte";
  pl->Message(BS("Schnaufend nimmst Du die letzten Stufen ...\n"), 
                 MSGFLAG_VISUAL);
  pl->move(ROOM "e3_vulkanmitte", M_SILENT | M_TPORT);
  room->Message(BS(TP->Name(WER, 1)+" kommt herunter.\n"), MSGFLAG_VISUAL, 
                ([ MSGFLAG_EXCLUDE: ({pl})]));
}