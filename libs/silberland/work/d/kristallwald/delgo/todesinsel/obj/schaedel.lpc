/*
7 Glasteile, mit deren Hilfe man ein Skelett erhaelt
 - linker Fuss (b4)
 - rechter arm (c2)
 - Rumpf (d5)
 - Schaedel (e0)
 - wirbelsaeule (g6)
 - linker arm (h2)
 - rechter fuss (h4)
Wollte sie als ein Object machen, brauche aber untersch. IDs
*/

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();


  SetProp(P_SHORT, "Ein Glasschaedel");
  SetProp(P_LONG,
    "Ein Glasschaedel wie von einem Skelett. Was man damit wohl anfangen kann?"
    " Du willst mehr ueber die Strukturen dieses Schaedels erfahren.");

  SetProp(P_INFO, "Seltsam, irgendetwas passiert wenn man den Schaedel reibt.");
  SetProp(P_NAME, "Glasschaedel");
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, MALE);
  AddId( ({"schaedel", "glasschaedel", "\nglas_schaedel", "totenschaedel"}) );

  SetProp(P_MATERIAL, MAT_GLASS );
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
 
  AddCmd( ({"reib", "reibe"}), "reanimate");

}
int reanimate(string str)
{
  object fl, fr, ar, al, ru, ws, ob;
  
  notify_fail("Was willst Du reiben?\n");

  if (!str || str == "") return 0;

  if (str != "schaedel" 
   && str != "glasschaedel" 
   && str != "an schaedel" 
   && str != "an glasschaedel") 
    return 0;

  tell_object(TP, "Du reibst an dem Schaedel.\n");
  if(!(interactive(ENV(TO))))
  {
    tell_object(TP, "Nichts passiert.\n");
    ENV(TP)->Message(BS(TP->Name()+" reibt an einem Glasschaedel.\n")
                 , MSGFLAG_VISUAL | MSGFLAG_NO_TP);
    return 0;
  }
  fl=present("\nglas_fuss_links", ENV(TO));
  fr=present("\nglas_fuss_rechts", ENV(TO));
  al=present("\nglas_arm_links", ENV(TO));
  ar=present("\nglas_arm_rechts", ENV(TO));
  ru=present("\nglas_rumpf", ENV(TO));
  ws=present("\nglas_wirbelsaeule", ENV(TO));
  if( (!fl) || (!fr) || (!al) || (!ar) || (!ru) || (!ws))
  { 
    tell_object(TP, "Nichts passiert. Brauchst Du noch mehr Reagenzien?\n");
    ENV(TP)->Message(BS(TP->Name()+" reibt an einem Glasschaedel.\n")
                 , MSGFLAG_VISUAL | MSGFLAG_NO_TP);
    return 1;
  }
  ob=clone_object(NPC "glas");
  ob->move(ENV(TP), M_SILENT | M_GO);
  TP->AddPursuer(ob);
  ENV(TP)->Message(BS(TP->Name()+" reibt an einem Glasschaedel.\n")
                 , MSGFLAG_VISUAL | MSGFLAG_NO_TP);
  ENV(TP)->Message(BS("Die leeren Augenhoehlen des Totenschaedels scheinen auf "
                   "einmal zu gluehen und vor deinen Augen setzen sich die "
                   "Glasteile zu einem Skelett zusammen.\n")
                 , MSGFLAG_VISUAL);
  TP->Message(BS("Das Skelett scheint Dich zu verfolgen.\n"), MSGFLAG_VISUAL);
  fl->remove(1);
  fr->remove(1);
  al->remove(1);
  ar->remove(1);
  ru->remove(1);
  ws->remove(1);
  TO->remove(1);
  return 1;
}
