/*
7 Glasteile, mit deren Hilfe man ein Skelett erhaelt
 - linker Fuss (b4)
 - rechter arm (c2)
 - Rumpf (d5)
 - Schaedel (e0)
 - wirbelsaeule (g6)
 - linker arm (h2)
 - rechter fuss (h4)
Wollte sie als ein Object machen, brauche aber untersch. IDs
*/

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();


  SetProp(P_SHORT, "Ein glaeserner Rumpf");
  SetProp(P_LONG,
    "Ein Rumpf aus Glas, wie von einem Skelett. Was man damit wohl anfangen "
    "kann?");

  SetProp(P_NAME, "Rumpf");
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, MALE);
  AddId( ({"rumpf", "glasrumpf", "\nglas_rumpf"}) );

  SetProp(P_MATERIAL, MAT_GLASS );
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE, 50);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
 

}