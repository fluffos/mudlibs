inherit "std/transport";
#include "../def.h"
#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Faehre" );
  SetProp( P_INT_LONG, BS(
     "Als Du Dir das Boot ansiehst, geht Dir ein kalter Schauer "
     "ueber den Ruecken. Vollkommen aus Knochen erbaut, schwebt es einige "
     "Zentimeter ueber den tosenden Wellen."));
  SetProp( P_SHORT, "Eine Faehre" );
  SetProp( P_LONG, BS(
    "Eine gruselige Faehre.") );
  SetProp( P_NAME, "Faehre" );
  AddId( ({ "faehre", "boot" }) );
  SetProp( P_GENDER, FEMALE );
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT,1);

  AddDetail( ({"faehrmann"}),
     "Irgendwie erinnert er Dich mit seinem Boot an eine Gestalt aus der "
     "griechischen Mythologie.");

   AddDetail( ({"boot"}),
     "Als Du Dich an das Boot zurueck erinnerst, geht Dir ein kalter Schauer "
     "ueber den Ruecken. Vollkommen aus Knochen erbaut, schwebt es einige "
     "Zentimeter ueber den tosenden Wellen.");

   AddDetail( ({"schauer", "ruecken"}),
     "Es fuehlt sich wie trockenes Eis und kaltes Feuer zugleich an.");

   AddDetail( ({"eis","feuer"}),
     "Eigentlich zwei vollkommen gegensaetzliche Dinge, aber hier scheinen Sie "
     "doch seltsam verbunden.");

   AddDetail( ({"dinge"}),
     "Eigentlich muessten sich die beiden gegenseitig ausloeschen.");

   AddDetail( ({"knochen"}),
     "Es scheint aus nahtlos aneinander gefuegten Rippen zu bestehen, die sich "
     "zu den Spanten hin verjuengen und auf derer beiden Spitzen je ein "
     "Totenkopf gruselig in die Gegend grinst.");

   AddDetail( ({"spanten"}),
     "So nennt man die Enden wo sich das Boot wieder spitz zusamenfuegt.");

   AddDetail( ({"enden"}),
     "Davon hat das Boot zwei, den Bug und das Heck.");

   AddDetail( ({"bug"}),
     "Nein das ist kein BUG sondern der Bug, und der ist vorne.");

   AddDetail( ({"heck"}),
     "Das ist hinten.");

   AddDetail( ({"spitze","spitzen"}),
     "Da grinsen Dir an Heck und Bug je ein Totenkopf entgegen.");

   AddDetail( ({"totenkopf","kopf"}),
     "Zwei Augenhoehlen, zwei Nasenloecher, ein Mund mit Zaehnen, eine "
     "Schaedeldecke.");

   AddDetail( ({"augenhoehle","augenhoehlen","nasenloch","mund","zaehne"}),
     "Du tastest an Dir herum und bemerkst: Das hast Du.");

   AddDetail( ({"schaedeldecke","schaedel"}),
     "Da hast Du noch Haare ... ausser Du kratzt Dich zu oft auf selbigem.");

   AddDetail( ({"haare"}),
     "Hast Du noch genug?");


   AddDetail( ({"rippen","rippe"}),
     "Gibts normalerweise sonst nur in Brustkoerben.");

   AddDetail( ({"brustkorb","brustkoerbe","brustkoerben"}),
     "Da kommen die Rippen her.");

   AddDetail( ({"zentimeter"}),
     "Es wirkt beaengstigend, ja schon beinahe gespenstisch, wie lautlos das "
     "Boot ueber den See gleitet, ohne auch nur einmal einen Spritzer heissen "
     "Wassers abzubekommen oder die Wellen zu beruehren.");

   AddDetail( ({"spritzer"}),
     "Hin und wieder wirbeln Tropfen hoch, wenn mehrere Wellen "
     "zusammenprallen.");

   AddDetail( ({"gestalt"}),
     "Genau ... jetzt faellt es Dir wieder ein. Charon (nicht zu verwechseln "
     "mit dem gleichnamigen Magier hier), der griechische Faehrmann der Toten, "
     "der die Seelen der Verstorbenen ueber den Styx in Hades' Unterwelt "
     "uebersetzte.");

   AddDetail( ({"magier"}),
     "Wenn Du etwas ueber ihn wissen willst -> finger charon.");

   AddDetail( ({"tote","toten","seele","seelen","verstorbene","verstorbenen"}),
     "Versucht Dir hier das Schicksal einen Wink mit dem Zaunpfahl zu geben "
     "oder bildest Du Dir das etwa nur ein?");

   AddDetail( ({"schicksal","form"}),
     "Jeden ereilt irgendwann sein Schicksal. Wie und in welcher Form kann man "
     "meist nie vorhersehen.");

   AddDetail( ({"wink" ,"zaunpfahl","zaun","pfahl"}),
     "Da hast Du doch tatsaechlich etwas gespuert ... Woher kommt den "
     "ploetzlich die Beule auf Deinem Kopf?");

   AddDetail( ({"beule"}),
     "Vorsichtig betastet Du sie und zuckst zusammen, weil sie hoellisch "
     "schmerzt.");

   AddDetail( ({"mythologie"}),
     "Die war bei den Griechen sehr vielschichtig und geheimnissvoll.");

   AddDetail( ({"griechen","grieche"}),
     "Da kommen auch der Styx, Hades und die Unterwelt (nicht die unsere) "
     "vor.");

   AddDetail( ({"styx","hades"}),
     "Die kommen in der griechischen Mythologie vor.");

   AddDetail( ({"unterwelt"}),
     "Die gibts bei uns auch, aber leider nicht in der selben Form wie in der "
     "griechischen Mythologie. Dort wurde in der Unterwelt zwischen Gut und "
     "Boese unterschieden, hier gibt es in der Unterwelt nur boese Schrecken.");

   AddDetail( ({"form"}),
     "Anders halt.");

   AddDetail( ({"gut", "boese"}),
     "Den Unterschied zwischen Gut und Boese laesst Du dir am besten von einem "
     "Paladin und/oder von einem Nekromanten erklaeren.");

   AddDetail( ({"unterschied"}),
     "Wie sich Gut und Boese halt unterscheiden.");

   AddDetail( ({"paladin","nekromant", "nekromanten"}),
     "Die Paladine leben weit weg von hier tief im Gebirge, wogegen erzaehlt "
     "wird, das die Nekromanten irgendwo ihr Hauptquartier tief unter der "
     "Zombieinsel haben.");

   AddDetail( ({"gebirge"}),
     "Das ist weit weg von hier.");

   AddDetail( ({"hauptquartier", "quartier"}),
     "Das befindet sich ganz woanders, hier ist ja nicht die Zombieinsel.");

   AddDetail( ({"naehe"}),
     "Nicht weit weg. Nicht sehr weit entfernt. Nahe halt.");

   AddDetail( ({"zombieinsel"}),
     "Die ist weit weg.");
     
   AddDetail( ({"boden", "gegend", "himmel", "nasenloecher", "schrecken", 
                "see", "sie", "tropfen", "wassers", "wellen", "wasser"}),
     "Alles da.");

  
  SetProp( P_DEPARTMSG, ({
    "Die Faehre legt ab.\n", 
    "Die Faehre legt ab.\n"}) );
  SetProp( P_ARRIVEMSG, ({
    "Die Faehre erreicht @@QueryArrived@@.\n",
    "Die Faehre legt an.\n"}) );
    
  SetProp( P_ENTERMSG, ({
    "besteigt die Faehre",
    "kommt herein"}) );
  SetProp( P_ENTERFAIL, ({
    "Es passen nur 5 Passagiere auf die Faehre",
    "hat keinen Platz mehr auf der Faehre"}) );
  SetProp( P_MAX_PASSENGERS, 5 );

  SetProp( P_LEAVEMSG, ({
    "verlaest die Faehre",
    "kommt von der Faehre runter"}) );
  SetProp( P_LEAVEFAIL, ({
    "Die Faehre ist noch unterwegs"}) );

  AddCmd( ({ "betrete", "betritt" }), "rein" );
  AddCmd( ({ "verlasse", "verlass" }), "raus" );

  AddRoute( KHORINIS_TODESINSEL, 30, 20, 
         "die Todesinsel", ({"todesinsel", "insel"}),
         "zur Todesinsel" );
  AddMsg( BS("Die Faehre segelt in die Dunkelheit und laesst die unheilvolle "
    "Insel hinter sich verschwinden.\n"), 10 );
  AddMsg( BS("Die Faehre verlaesst nun die riesige Hoehle und Du siehst wieder "
    "Tageslicht.\n"), 10 );
  AddMsg( BS("Die Faehre umrundet die Insel und faehrt nach Sueden.\n"), 10 );
  AddMsg( BS("Als die Faehre ueber das offene Meer segelt, blickst Du "
    "nocheinmal zurueck zu den Waeldern auf der Insel. Von der schrecklichen "
    "Insel darunter ist nichtsmehr zu sehen.\n"), 10 );
  AddMsg( BS("Die Faehre naehert sich dem Hafen von Khorinis.\n"), 10 );
  AddRoute( TODESINSEL_KHORINIS, 30, 20, 
         "Khorinis", ({"khorinis", "stadt"}),
         "nach Khorinis" );
  AddMsg( BS("Die Faehre verlaesst die Bucht von Khorinis.\n"), 10 );
  AddMsg( BS("Die Faehre faehrt auf eine gruen bewachsene Insel zu.\n"), 10 );
  AddMsg( BS("Die Insel wird einmal umrundet und der Faehrmann steuert eine "
    "Grotte auf der Nordseite der Insel an.\n"), 10 );
  AddMsg( BS("Der Faehrmann ist schweigsam wie immer, als er zielsicher in die "
    "dunkle Grotte einfaehrt.\n"), 10 );
  AddMsg( BS("Die Faehre naehert sich einem Steg ...\n"), 10 );
 	
  Start();
}

rein(str)
{
  notify_fail("Was willst Du betreten?\n");
  if( str && id(str) )
    return Enter();
  return 0;
}

raus(str)
{
  notify_fail("Was willst Du verlassen?\n");
  if(!(QueryArrived())) 
  {
    TP->Message(BS("Das solltest Du nicht waehrend der Fahrt versuchen!"));
    return 1;
  }
  if( str && id(str) )
    return Leave();
  return 0;
}

void init()
{
  ::init();
  // Sichergehen, dass alle Haefen auch geladen sind.
  if (interactive(this_player()))
  {
    catch(call_other( KHORINIS_TODESINSEL, "refresh", 0));
    catch(call_other( TODESINSEL_KHORINIS, "refresh", 0));
  }
}
void refresh()
{
	//Juhu! Leerlauf!
}