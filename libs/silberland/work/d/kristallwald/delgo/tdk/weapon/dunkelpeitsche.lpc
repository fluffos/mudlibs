/*  - Nette peitsche, Gegenteil der Lichtkeule
    -> HitFunc auf gesinnungen ueber 0
    -> DT_UNHOLY, DT_TERROR
    - aus /p/weapon/whip/peitsche gebastelt
    - blendet allerdings nicht :-) */


inherit "std/weapon";
#include "../def.h"
#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Eine Dunkelpeitsche");
  SetProp(P_LONG,  
    "Du scheinst die Peitsche in Deinen Haenden kaum greifen zu koennen. "
    "Sie scheint staendig in Bewegung zu sein, und das Schwarz ist so "
    "unheimlich intensiv, es scheint als waere sie ein einziger Schatten."
    );
  AddDetail( ({"bewegung"}), "Sie wirken unheimlich, Du hast ein mulmiges "
    "Gefuehl dabei.");
  AddDetail( ({"schwarz", "schatten"}), "Du traust Dich und tatsaechlich, "
    "Du kannst durch Die Peitsche hindurchgreifen. Du zitterst.");
  SetProp(P_NAME, "Dunkelpeitsche");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"peitsche", "dunkelpeitsche"}) );

  SetProp(P_WEAPON_TYPE, WT_WHIP );
  SetProp(P_WC, 160); 
  SetProp(P_WC_FIX, 25);
  SetProp(P_WC_BONUS, (["Peitschenkaempfer":50, "Peitschenexperte":150, 
      "Peitschenmeister":250]) );
  SetProp(P_DAM_TYPE, ({DT_UNHOLY, DT_WHIP}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_LEATHER:20, MAT_SHADOW:80 ]) );
  SetProp(P_WEIGHT, 350); 
  SetProp(P_VALUE, 1600);
  SetProp(P_SIZE, 230);
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_NOBUY, 1);
  SetProp(P_INFO, BS(
    "Diese Peitsche scheint von einem Dunkelelfen zu stammen. Der "
    "unheimliche Schatten, aus dem diese Peitsche besteht, scheint gute "
    "Wesen besonders hart zu treffen."));
  SetProp(P_WIELD_RESTRICTIONS, ([SR_GOOD: -200]) ); //nur boesartige duerfen 
  SetProp(P_HIT_FUNC, TO);
}

int HitFunc(object enemy)
{
  int dam;
  
  dam=enemy->QueryProp(P_ALIGN);
  if( dam > 0 )
  {
    if( dam > 999 ) return 30+random(15);
    if( dam > 799 ) return 30+random(10);
    if( dam > 599 ) return 25+random(10);
    if( dam > 399 ) return 15+random(10);
    if( dam > 199 ) return 15;
    return 5;
  }
  return 0;
}
