{
  color="hell";
  desc="Du weist nicht, wo Du diese Farbe schonmal gesehn hast.";
  weight=800;
  material=([MAT_STEEL:50, MAT_MAGIC:50]);
  wc=185;
  damage=({DT_MIND});
  pl->Message(BS("Das Schwert leuchtet kurz "+color+" auf und der Geist "
              "laesst Dich und Deinen Koerper frei."), MSGFLAG_VISUAL);
