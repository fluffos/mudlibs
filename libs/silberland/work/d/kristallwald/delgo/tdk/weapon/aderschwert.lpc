int end()
{
  SetProp(P_SHORT, "Ein "+color+"es Aderschwert");
  SetProp(P_LONG, 
    "Du haelst ein "+color+"es Aderschwert in den Haenden. Die Adern, welche" 
    " die feine Stahlklinge durchziehen, leuchten "+color+". Der "
    "Griff scheint recht gewoehnlich."
    );
  AddDetail( ({"klinge", "stahlklinge"}), 
    "Sie wird von feinen Adern durchzogen.");
  AddDetail( ({"adern"}), 
    "Sie leuchten "+color+". "+desc+"");
  AddDetail( ({"griff"}), 
    "Er besteht wie die Klinge aus Stahl. Du erkennst acht Runen.");
  AddDetail( ({"runen"}), 
    "Sie heissen: Licht, Schatten, Feuer, Eis, Humus, Wasser, Luft, Erz und "
    "Geist.");
  SetProp(P_MATERIAL, material );
  SetProp(P_WEIGHT, weight);
  SetProp(P_WC, wc);
  SetProp(P_DAM_TYPE, ({DT_SLASH}) + damage);
  ritual=0;
}
