/* Ein Axt auf dem element Feuer aufbauend, fuer Bersis halt 
Wegen lamus Lavaaxt in eine Phoenixaxt geaendert - federleicht, streitischaden
Falls zu stark gesinnungsabhaenngig machen*/
inherit "std/weapon";
#include "../def.h"
#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Phoenixaxt");
  SetProp(P_LONG,  
    "Die Axtblaetter dieser riesigen Axt haben die Form von Fluegeln. "
    "Die gesamte Axt  schimmert leicht blaeulich doch am erstaunlichsten "
    "ist ihr Gewicht. Sie scheint fast gar nichts zu wiegen.");
  AddDetail( ({"griff"}), 
    "Er ist schlicht und einfach gehalten.");
  AddDetail( ({"axtblaetter", "blaetter"}), 
    "Sie sehen tatsaechlich aus wie Fluegel oder Schwingen, doch ihre Klingen "
    "sind messerscharf.");
  AddDetail( ({"fluegel", "schwinge", "schwingen"}), 
    "Du glaubst sogar Federn zu erkennen.");
  AddDetail( ({"federn", "feder"}), 
    "Sogar die einzelnen Federn haben klingen. Diese Axt ist gefaehrlich.");
  AddDetail( ({"klinge", "klingen"}), 
    "Sie scheinen sehr scharf zu sein.");
  SetProp(P_NAME, "Phoenixaxt");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"axt", "phoenixaxt"}) );
  SetProp(P_INFO, 
    "Durch die Fluegel scheint die Axt viel kraeftiger und schneller zu "
    "schwingen. Ob man sie dadurch leichter handhaben kann?\n");
  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 269);
  SetProp(P_WC_FIX, 25); 
  SetProp(P_WC_BONUS,(["Axtkaempfer":60, 
                       "Axtexperte":130, 
                       "Axtmeister":250]));
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL,([MAT_MISC_STONE:5, MAT_MITHRIL:60, MAT_AIR:35]));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 7000);
  SetProp(P_SIZE, 160);
  SetProp(P_MAGIC, 1);
  SetProp(P_QUALITY_DECAY, 45);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:25, SR_SEER: 1, P_XP:6000000]) );  
}

