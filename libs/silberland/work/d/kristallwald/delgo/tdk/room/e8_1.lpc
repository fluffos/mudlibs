#include "../def.h"
inherit ROOM "std_turm";

void create()
{
  ::create();

  AddDetail( ({ "decke" }),
    "Ganz normal."
  );
  AddDetail( ({ "boden" }),
    "Ganz normal."
  );
  
  AddExit( "unten", ROOM "e7_3" );
  AddItem(NPC "miiralth", REFRESH_DESTRUCT);

}

int QueryDoor()
{
  if(!present("miiralth", TO)) {return 0;}
  return 1;
}