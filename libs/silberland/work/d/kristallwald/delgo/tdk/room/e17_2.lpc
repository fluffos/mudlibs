#include "../def.h"
inherit ROOM "std_turm";

int schwert;

void create()
{
  ::create();

  AddDetail( ({ "decke" }),
    "Es gib hier keine Decke mehr. Du befindest dich am Ende des Turmes."
  );
  AddDetail( ({ "ende" }),
    "Hier stehen einfach nur die vier Saeulen, ueber Dir der strahlend "
    "blaue Himmel und weit unter Dir das Wolkenmeer."
  );
  AddDetail( ({ "himmel" }),
    "Die Sonne scheint froehlich auf Dich herab. Du atmest tief ein."
  );
  AddDetail( ({ "sonne" }),
    "Unschuldig haengt sie da oben.."
  );
  AddDetail( ({ "boden", "boeden" }),
    "Er unterscheidet sich wesentlich von den andere Boeden, die du bisher "
    "gesehen hast. Er besteht vollkommen aus Glas und weist Gravuren auf."
  );
  AddDetail( ({ "glas" }),
    "Du schaust hindurch, und erblickst die alte Bibliothek in ihrer "
    "ganzen Pracht."
  );
  AddDetail( ({ "bibliothek" }),
    "Damals, konnte man hier das gesammelte Wissen vieler Voelker finden."
  );
  AddDetail( ({ "wissen" }),
    "Sehr wertvoll."
  );
  AddDetail( ({ "voelker" }),
    "Aus allen Teilen des Silberlandes."
  );
  AddDetail( ({ "teil", "teile", "silberland", "land" }),
    "Du befindest Dich in einem Teil des Silberlandes."
  );
  AddDetail( ({ "gravuren", "gravur" }),
    "Sie sind alle sehr sauber graviert worden, und verlaufen in Richtung "
    "Mitte."
  );
  AddDetail( ({ "richtung", "mitte" }),
    "Im Zentrum der Gravuren befindet sich etwas."
  );
  AddDetail( ({ "zentrum" }),
    "Da steckt etwas im Glas."
  );
  AddDetail( ({ "etwas" }),
    "Ein Griff?"
  );
  AddDetail( ({ "griff", "schwertgriff" }),
    "Tatsaechlich, ein schmuckloser Schwertgriff."
  );
  AddDetail( ({ "schwert" }),
    "Den Rest kannst Du nich erblicken. Seltsam."
  );
  AddDetail( ({ "rest" }),
    "Klinge."
  );
  AddDetail( ({ "klinge" }),
    "Ob Du die findest, wenn du am Griff ziehst?"
  );
  AddDetail( ({"pracht"}) , "Frueher war es das mal.");
  AddDetail( ({"wolkenmeer", "meer", "wolken", "wolke"}) , 
    "Es sieht so friedlich aus."
  );
  
  AddCmd( ({"zieh", "ziehe"}), "cmd_ziehen");
  
  AddItem(NPC "mdrache", REFRESH_DESTRUCT);
  
  AddExit( "suedunten", ROOM "e16_2" );
  
  SetProp(P_HIDE_EXITS, ({"sueden"}) );
  AddExit( "sueden", ROOM "e16_2" );

  schwert=1;
  
}

void reset()
{
  ::reset();
  
  RemoveDetail( ({"etwas"}));
  AddDetail( ({ "etwas" }),
    "Ein Griff?"
  );
  AddDetail( ({ "griff", "schwertgriff" }),
    "Tatsaechlich, ein schmuckloser Schwertgriff."
  );
  AddDetail( ({ "schwert" }),
    "Den Rest kannst Du nich erblicken. Seltsam."
  );
  AddDetail( ({ "rest" }),
    "Klinge."
  );
  AddDetail( ({ "klinge" }),
    "Ob Du die findest, wenn du am Griff ziehst?"
  );
  schwert=1;
}

int cmd_ziehen(string str)
{
  object drache, sword;
  drache = present("drache", TO);
  
  notify_fail("Was genau willst Du tun?\n");
  if(!str || str == "") {return 0;}
  if(str == "an griff"          ||
     str == "an schwert"        ||
     str == "schwert aus boden" ||
     str == "schwert aus loch"  ||
     str == "griff"             ||
     str == "schwert"           ||
     str == "klinge aus boden")
  {
    if(!schwert)
    {
      TP->Message(BS("Aber da ist doch gar kein Schwert!"), MSGFLAG_VISUAL);
      return -1;
    }
    if(drache)
    {
      TP->Message(BS("Der Drache schubst Dich weg!"), MSGFLAG_VISUAL);
      return -1;
    }
    sword = clone_object(WEAPON "aderschwert");
    if(sword->move(TP, M_GET)==ME_TOO_HEAVY)
    {
      TP->Message(BS("Du kannst Das Schwert nichtmehr tragen, und  laesst "
                  "es fallen!"), MSGFLAG_VISUAL);
      sword->move(TO, M_PUT);
      return 1;
    }
    TP->Message(BS("Du ziehst das Aderschwert aus dem Boden")
                , MSGFLAG_VISUAL);
    sword->move(TP, M_GET);     schwert=0;     RemoveDetail( ({"etwas", "griff", "schwertgriff", "schwert" , "rest"
                    , "klinge"}) );
    AddDetail( ({"etwas"}) , "Du hast Dich getaeuscht.");   }
  return 1;   
}

int my_filter_func(object ob) 
{
  if(ob->id("drache")) return 0;//er selbst bleibt natuerlich da                                 
  if(ob->QueryProp(P_GHOST)) return 0; //Das waere unlogisch :)
  if(IS_LEARNER(ob)) return 0;
  if(!living(ob)) return 0;
  return 1;
}

int fly()
{
	
	int n, o;

	mixed enemies; //array mit den opfern - feindliste
	string room; 
	room = ROOM "e17_2";
  enemies = filter_array(all_inventory(TO), "my_filter_func"); //listet alle
    //objete von TO (dieser Raum) auf, my_filter_func testet jedes object
    //einzeln, ob es in die feind-liste aufgenommen wird
	n=sizeof(enemies);
	if(n < 1) {return 0;}
	o=random(n); //Feind wird ausgewaehlt
	//o++;
	TO->Message(BS("Tshurghaeyrkleijh breitet seine Schwingen aus und "
	               "schlaegt sie blitzartig wieder zusammen. Der Wind "
	               "erfasst Dich.")
	               , MSGFLAG_VISUAL);
	enemies[o]->move(ROOM "air", M_GO, "", "wird weggeblasen"
	                 , "faellt vorbei" );
	enemies[o]->Message(BS("Du kannst Dich nirgendwo festhalten, und wirst "
	                    "vom Turm geblasen.")
	                    , MSGFLAG_VISUAL);
	
	return 1;	
}