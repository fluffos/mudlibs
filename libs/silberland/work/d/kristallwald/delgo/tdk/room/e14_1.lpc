#include "../def.h"
inherit ROOM "std_turm";

void create()
{
  ::create();

  AddDetail( ({ "decke" }),
    "Ganz normal."
  );
  AddDetail( ({ "boden" }),
    "Ganz normal."
  );
  
  AddItem(NPC "khaurune", REFRESH_DESTRUCT);
  AddItem(NPC "nekro", REFRESH_DESTRUCT);
  
  AddExit( "unten", ROOM "e13_1" );


}

int ntod()
{
 object ob;
 string room;
 
 room = ROOM "e14_1";
 
  room->Message(BS("Durch das Buendnis mit Khaurune, muss nun auch Celsezal "
            "sterben. Celsezal zerfaellt endgueltig." 
            ), MSGFLAG_VISUAL);
 ob=present("celsezal", TO);
 if(!ob) return 0;
 if(ob) 
 {
   ob->remove();
   return 1;
 }
}

int ktod()
{
 object ob;
 
 TO->Message(BS("Durch das Buendnis mit Celsezal, muss nun auch Khaurune "
            "sterben. Khaurune zerfaellt endgueltig." 
            ), MSGFLAG_VISUAL);
 ob=present("khaurune", TO);
 if(!ob) return 0;
 if(ob) 
 {
   ob->remove();
   return 1;
 }
}

int QueryDoor()
{
  if(!present("celsezal", TO)) {return 0;}
  if(!present("khaurune", TO)) {return 0;}
  return 1;
}