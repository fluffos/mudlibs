  SetProp(P_HIDE_EXITS, ({"nordosten", "westen"}) );  
  AddExit( "nordosten", ROOM "e14_2" );
  AddExit( "westen", ROOM "e16_1" ); 
  
  AddItem(NPC "feuermargyl" , REFRESH_DESTRUCT);
  AddItem(NPC "feuermargyl" , REFRESH_DESTRUCT);
  AddItem(NPC "feuermargyl" , REFRESH_DESTRUCT);

}
