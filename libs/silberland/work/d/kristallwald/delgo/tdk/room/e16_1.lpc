#include "../def.h"
inherit ROOM "std_turm";

void create()
{
  ::create();

  AddDetail( ({ "decke" }),
    "Ganz normal."
  );
  AddDetail( ({ "boden" }),
    "Ganz normal."
  );
  
  AddExit( "oben", ROOM "e17_1" );
  AddExit( "ostunten", ROOM "e15" );
  AddExit( "norden", ([EX_TESTFUNC : "func",
                       EX_DEST     : ROOM "e16_2"]) );
                       
  SetProp(P_HIDE_EXITS, ({"osten"}) );
  AddExit( "osten", ROOM "e15" );
  
  AddItem(NPC "feuermargyl" , REFRESH_DESTRUCT);
  AddItem(NPC "feuermargyl" , REFRESH_DESTRUCT);
  AddItem(NPC "feuermargyl" , REFRESH_DESTRUCT);


}
int func()
{
  string room;
  room = ROOM "e17_1";
  if(room->QueryDoor())
  {
    TP->Message(BS("Vergewissere Dich lieber, ob ueber Dir nicht noch "
                   "Monster sind, die Dir in den Ruecken fallen koennen.")    
                   , MSGFLAG_VISUAL);
    return 0;
  }
  else
  {
    return 1;
  }
}