#include "../def.h"
inherit ROOM "std_bruecke";

void create()
{
  ::create();

  AddExit( "nordunten", ROOM "e13_1" );
  AddExit( "suedwestoben", ROOM "e15" );

  SetProp(P_HIDE_EXITS, ({"norden", "suedwesten"}) );  
  AddExit( "norden", ROOM "e13_1" );
  AddExit( "suedwesten", ROOM "e15" );
  
  AddItem(NPC "feuermargyl" , REFRESH_DESTRUCT);
  AddItem(NPC "feuermargyl" , REFRESH_DESTRUCT);
  AddItem(NPC "feuermargyl" , REFRESH_DESTRUCT);

}
