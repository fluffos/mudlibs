#include "../def.h"
inherit ROOM "std_turm";

void create()
{
  ::create();

  AddDetail( ({ "decke" }),
    "Sie ist hier offen und du kannst somit den ganzen Turm nach oben "
    "einsehen. Erstaunlich, der gesamte Hauptturm muss frueher mal eine "
    "gigantische Bibliothek gewesen sein."
  );
  AddDetail( ({ "hauptturm" }),
    "Du befindest Dich in ihm, allerdings kommst Du von hier aus nicht nach "
    "oben. Die Treppen wurden alle zerstoert."
  );
  AddDetail( ({ "treppen" }),
    "Zerstoert."
  );
  AddDetail( ({ "bibliothek" }),
    "An die Buecher kommt keiner mehr ran. Entweder sind sie zerstoert, "
    "oder die ganzen Gargoyles, die in dem Turm nisten, zerreissen Dich."
  );
  AddDetail( ({ "buch", "buecher" }),
    "Verloren. Schade um das Wissen."
  );
  AddDetail( ({ "wissen" }),
    "Das koenntest Du gut gebrauchen."
  );
  AddDetail( ({ "gargoyles", "gargoyle" }),
    "Zu Dutzenden sitzen sie da oben und warten ..."
  );
  AddDetail( ({ "dutzend", "dutzende" }),
    "Du schluckst trocken."
  );
  AddDetail( ({ "boden" }),
    "Ganz normal. Doch halt, da hast du etwas uebershen."
  );
  AddDetail( ({ "etwas" }),
    "Du trittst naeher heran, und tatsaechlich. Hier steht ein Brunnen."
  );
  AddDetail( ({ "brunnen" }),
    "Was macht hier ein Brunnen? Du beugst Dich ueber ihn und stellst "
    "erstmal fest er fuehrt kein Wasser. Was koennte man noch mit diesem "
    "Brunnen anfangen? *gruebel*"
  );
  AddDetail( ({ "wasser" }),
    "Keines drin. Aber dann hast Du eine Idee, was man mit dem Brunnen "
    "anfangen koennte."
  );
  AddDetail( ({ "idee" }),
    "Du koennest ihn stehen lassen."
  );
  //Heilquelle deaktiviert
  
  AddExit( "westen", ROOM "e7_2" );

    NewDoor( ({"tuer"}), ROOM "magier" , ({"tuer"}) ,
    ({D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL|DOOR_NEEDKEY
     ,D_NAME, "Tuer"
     ,D_SHORT, "Eine %se Tuer."
     ,D_LONG, "Eine einfache Tuer."
     ,D_GENDER, FEMALE
     ,D_MSGS,    ({"durch die Tuer"
                  ,"geht"
                  ,"kommt herein" 
                  })
     ,D_OPENMSG, ({"Die Tuer wird geoeffnet.",
                   "Die Tuer wird geoeffnet.",
                  " wird geoeffnet."})
     ,D_CLOSEMSG, ({"Die Tuer wird geschlossen.",
                    "Die Tuer wird geschlossen.",
                    " wird geschlossen."})
     ,D_UNLOCKMSG, ({"Die Tuer wird aufgeschlossen.",
                   "Die Tuer wird aufgeschlossen.",
                  " wird aufgeschlossen."})
     ,D_LOCKMSG, ({"Die Tuer wird abgeschlossen.",
                    "Die Tuer wird abgeschlossen.",
                    " wird abgeschlossen."})
     ,D_RESET_CLOSEMSG, " faellt zu."
     })
  );

  AddItem(NPC "esoeldner" , REFRESH_DESTRUCT);
  AddItem(NPC "esoeldner" , REFRESH_DESTRUCT);
  AddItem(NPC "esoeldner" , REFRESH_DESTRUCT);
  AddItem(NPC "gargoyle" , REFRESH_DESTRUCT);
  AddItem(NPC "gargoyle" , REFRESH_DESTRUCT);
  AddItem(NPC "gargoyle" , REFRESH_DESTRUCT);

}

