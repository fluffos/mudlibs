#include "../def.h"
inherit ROOM "std_turmzimmer";

void create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du stehst in einem runden Turmzimmer. Alles hier ist aus Stein und "
    "bis auf die Treppe an der Wand und den beiden Fenstern, kannst auch "
    "nichts besonderes erkennen. Du fragst Dich, warum dieser Turm wohl "
    "frueher so bekannt war, Du kannst noch durch eine <Tuer> gehen."
  );
  AddExit( "unten" , TDK_AVIR );
  AddExit( "oben", ROOM "ketten");

  AddCmd("tuer", "osten");
              
  AddItem(NPC "benran" , REFRESH_DESTRUCT);

}

int osten()
{
  object ob;

  notify_fail("Du darfst den Raum nicht betreten.\n");
  ob=present("\nwaffen_quest", TP);
  if(!ob) { return 0; }
  TP->move(ROOM "arena:"+getuid(TP), M_GO|M_SILENT);
  return 1;
}

