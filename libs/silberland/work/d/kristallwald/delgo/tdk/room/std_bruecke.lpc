#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Bruecke ueber den Wolken");
  SetProp(P_INT_LONG,
    "Um Dich herum siehst Du nichts als Wolken. Du stehst auf einer  "
    "steinernen Bruecke irgendwo ueber Avir, weit ueber Avir. Der Wind "
    "pfeift um Deine Ohren und zerrt an Deinem Koerper. Waeren die "
    "mannshohen Mauern nicht so ein guter Windschutz, wuerdest Du bestimmt "
    "schon auf dem Weg nach unten sein."
  );
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "wolken" }),
    "Sie liegen ruhig unter Dir und reichen weit bis zum Horizont. Was "
    "fuer ein friedlicher Anblick."
  );
  AddDetail( ({ "horizont" }),
    "Der ist relativ weit weg. Du kneifst die Augen etwas zusammen, kannst "
    "aber nichts Aufregendes erkennen."
  );
  AddDetail( ({ "aufregendes" }),
    "Woody bei seinem Spaziergang zum Beispiel."
  );
  AddDetail( ({ "woody" }),
    "Ob er auf dieser Hoehe wohnt?"
  );
  AddDetail( ({ "hoehe" }),
    "Wohl eher noch hoeher."
  );
  AddDetail( ({ "spaziergang" }),
    "Woody weiss was Goetter sollen!"
  );
  AddDetail( ({ "goetter", "dusty" }),
    "Dusty und Woody sind Goetter."
  );
  AddDetail( ({ "beispiel" }),
    "Eines von vielen."
  );
  AddDetail( ({ "anblick" }),
    "Balsam fuer die Seele."
  );
  AddDetail( ({ "balsam" }),
    "Das wuerde jetzt wirklich gut tun!"
  );
  AddDetail( ({ "seele" }),
    "Nur wenn Du mit ganzer Seele dabei bist, koenntest Du hier ueberleben."
  );
  AddDetail( ({ "bruecke" }),
    "Sie besteht aus Stein, und weist keinerlei Besonderheiten auf."
  );
  AddDetail( ({ "stein" }),
    "Der Boden besteht natuerlich auch aus Stein."
  );
  AddDetail( ({ "boden" }),
    "Er ist genau so normal wie der Himmel."
  );
  AddDetail( ({ "himmel" }),
    "Der Himmel hier weist heute keine Besonderheiten auf."
  );
  AddDetail( ({ "besonderheiten" }),
    "Muss das den immer sein?"
  );
  AddDetail( ({ "avir" }),
    "Ganz weit unten."
  );
  AddDetail( ({ "wind" }),
    "Durch die Mauern bist Du relativ geschuetzt."
  );
  AddDetail( ({ "ohren", "ohr" }),
    "Halt sie gut fest!"
  );
  AddDetail( ({ "mauern", "mauer" }),
    "Sie sind an fuer sich nicht auffallend."
  );
  AddDetail( ({ "windschutz" }),
    "Du bist recht froh darueber."
  );
  AddDetail( ({ "weg" }),
    "Das ist einer, den ich nicht beschreiten will."
  );
  AddDetail( ({ "augen", "auge", "koerper" }),
    "Alles weg!"
  );
  AddRoomMessage( 
    ({"Der Wind pfeift um Deine Ohren.\n",
    "Der Wind zerrt an Deinem Koerper.\n"}),32);
  AddSound( DEFAULT_SOUND,
    "Wenn der Wind nicht zu heftig weht, ist es absolut still. Beaengstigend.");
  AddSmell( DEFAULT_SMELL,
    "Du kannst nicht erkennen wonach es hier riecht.");
}

