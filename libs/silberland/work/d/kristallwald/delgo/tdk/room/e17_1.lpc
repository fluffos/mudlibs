#include "../def.h"
inherit ROOM "std_turm";

void create()
{
  ::create();

  AddDetail( ({ "decke" }),
    "Ganz normal."
  );
  AddDetail( ({ "boden" }),
    "Ganz normal."
  );
  
  AddItem(NPC "fuldigor", REFRESH_DESTRUCT);
  
  AddExit( "unten", ROOM "e16_1" );


}

int QueryDoor()
{
  if(!present("fuldigor", TO)) {return 0;}
  return 1;
}