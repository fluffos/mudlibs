#include "../def.h"
inherit ROOM "std_bruecke";

void create()
{
  ::create();

  AddExit( "nordostoben", ROOM "e9" );
  AddExit( "suedunten", ROOM "e7_3" );
  
  SetProp(P_HIDE_EXITS, ({"nordosten", "sueden"}) );
  AddExit( "nordosten", ROOM "e9" );
  AddExit( "sueden", ROOM "e7_3" );
  
  AddItem(NPC "margyl" , REFRESH_DESTRUCT);
  AddItem(NPC "margyl" , REFRESH_DESTRUCT);
  AddItem(NPC "margyl" , REFRESH_DESTRUCT);
  

}
