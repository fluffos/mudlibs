#include "../def.h"
inherit ROOM "std_turm";

void create()
{
  ::create();
  AddDetail( ({ "decke" }),
    "Ganz normal.");
  AddDetail( ({ "boden" }),  
    "Ganz normal.");
    
  AddExit( "osten", ROOM "e7_2" );
  AddExit( "nordoben", ([EX_TESTFUNC : "func",
                         EX_DEST     : ROOM "e8_2"]) );
  AddExit( "oben", ROOM "e8_1" );
  
  SetProp(P_HIDE_EXITS, ({"norden"}) );
  AddExit( "norden", ([EX_TESTFUNC : "func",
                       EX_DEST     : ROOM "e8_2"]) );
                       
  AddItem(NPC "esoeldner" , REFRESH_DESTRUCT);
  AddItem(NPC "gargoyle" , REFRESH_DESTRUCT);
  AddItem(NPC "gargoyle" , REFRESH_DESTRUCT);
  AddItem(NPC "gargoyle" , REFRESH_DESTRUCT);

}

int func()
{
  string room;
  room = ROOM "e8_1";
  if(room->QueryDoor())
  {
    TP->Message(BS("Vergewissere Dich lieber, ob ueber Dir nicht noch "
                   "Monster sind, die Dir in den Ruecken fallen koennen.")
                   , MSGFLAG_VISUAL);
    return 0;
  }
  else
  {
    return 1;
  }
}