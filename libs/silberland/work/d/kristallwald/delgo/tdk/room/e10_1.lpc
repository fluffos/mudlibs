#include "../def.h"
inherit ROOM "std_turm";

void create()
{
  ::create();

  AddDetail( ({ "decke" }),
    "Ganz normal."
  );
  AddDetail( ({ "boden" }),
    "Ganz normal."
  );
  
  AddExit( "ostoben", ([EX_TESTFUNC : "func",
                         EX_DEST     : ROOM "e11_2"]) );
  AddExit( "sueden", ROOM "e10_2" );
  AddExit( "oben", ROOM "e11_1" );
  AddExit( "westunten", ROOM "e9" );
  
  SetProp(P_HIDE_EXITS, ({"osten", "westen"}) );
  AddExit( "osten", ([EX_TESTFUNC : "func",
                      EX_DEST     : ROOM "e11_2"]) );
  AddExit( "westen", ROOM "e9" );  
  
  AddItem(NPC "margyl" , REFRESH_DESTRUCT);
  AddItem(NPC "margyl" , REFRESH_DESTRUCT);
  AddItem(NPC "margyl" , REFRESH_DESTRUCT);
  AddItem(NPC "margyl" , REFRESH_DESTRUCT);
  AddItem(NPC "margyl" , REFRESH_DESTRUCT);

}
int func()
{
  string room;
  room = ROOM "e11_1";
  if(room->QueryDoor())
  {
    TP->Message(BS("Vergewissere Dich lieber, ob ueber Dir nicht noch "
                   "Monster sind, die Dir in den Ruecken fallen koennen.")    
                   , MSGFLAG_VISUAL);
    return 0;
  }
  else
  {
    return 1;
  }
}