#include "../def.h"
inherit ROOM "std_turmzimmer";  



void create()
{
  ::create();

  AddExit( "unten", ROOM "bogen");
  NewDoor( ({"tuer"}), ROOM "e7_1" , ({"tuer"}) ,
    ({D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL|DOOR_NEEDKEY
     ,D_NAME, "Tuer"
     ,D_SHORT, "Eine %se Tuer."
     ,D_LONG, "Eine einfache Tuer."
     ,D_GENDER, FEMALE
     ,D_TESTFUNC, "QueryOpen"
     ,D_MSGS,    ({"durch die Tuer"
                  ,"geht"
                  ,"kommt herein" 
                  })
     ,D_OPENMSG, ({"Die Tuer wird geoeffnet.",
                   "Die Tuer wird geoeffnet.",
                  " wird geoeffnet."})
     ,D_CLOSEMSG, ({"Die Tuer wird geschlossen.",
                    "Die Tuer wird geschlossen.",
                    " wird geschlossen."})
     ,D_UNLOCKMSG, ({"Die Tuer wird aufgeschlossen.",
                   "Die Tuer wird aufgeschlossen.",
                  " wird aufgeschlossen."})
     ,D_LOCKMSG, ({"Die Tuer wird abgeschlossen.",
                    "Die Tuer wird abgeschlossen.",
                    " wird abgeschlossen."})
     ,D_RESET_CLOSEMSG, " faellt zu."
     })
  );
  AddItem(NPC "aulin" , REFRESH_DESTRUCT);
}


int QueryOpen()
{
  if(present("\nwaffen_quest", TP))
  {
    TP->Message(BS("Du solltest erst die Pruefung zum Waffenmeister "
                "ablegen. Die Kaempfer warten nicht gerne.")
                , MSGFLAG_VISUAL);
    return 1;
  }
  return 0;
}