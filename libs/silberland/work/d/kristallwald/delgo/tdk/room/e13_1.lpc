#include "../def.h"
inherit ROOM "std_turm";

void create()
{
  ::create();

  AddDetail( ({ "decke" }),
    "Ganz normal."
  );
  AddDetail( ({ "boden" }),
    "Ganz normal."
  );
  
  AddExit( "nordunten", ROOM "e12" );
  AddExit( "oben", ROOM "e14_1" );
  AddExit( "westen", ROOM "e13_2" );
  AddExit( "suedoben", ([EX_TESTFUNC : "func",
                         EX_DEST     : ROOM "e14_2"]) );
                         
  SetProp(P_HIDE_EXITS, ({"norden", "sueden"}) ); 
  AddExit( "norden", ROOM "e12" );
  AddExit( "sueden", ([EX_TESTFUNC : "func",
                       EX_DEST     : ROOM "e14_2"]) );                        
  
  AddItem(NPC "skelettmargyl" , REFRESH_DESTRUCT);
  AddItem(NPC "skelettmargyl" , REFRESH_DESTRUCT);
  AddItem(NPC "skelettmargyl" , REFRESH_DESTRUCT);
  AddItem(NPC "skelettmargyl" , REFRESH_DESTRUCT);

}

int func()
{
  string room;
  room = ROOM "e14_1";
  if(room->QueryDoor())
  {
    TP->Message(BS("Vergewissere Dich lieber, ob ueber Dir nicht noch "
                   "Monster sind, die Dir in den Ruecken fallen koennen.")    
                   , MSGFLAG_VISUAL);
    return 0;
  }
  else
  {
    return 1;
  }
}