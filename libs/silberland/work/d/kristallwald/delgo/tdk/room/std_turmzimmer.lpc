#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Turmzimmer");
  SetProp(P_INT_LONG,
    "Du stehst in einem runden Turmzimmer. Alles hier ist aus Stein und "
    "bis auf die Treppe an der Wand und den beiden Fenstern, kannst auch "
    "nichts besonderes erkennen. Du fragst Dich, warum dieser Turm wohl "
    "frueher so bekannt war, Du erkennst hier nichts Faszinierendes."
  );
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "decke" }),
    "Sie besteht, wie auch der gesamte Rest der Einrichtung, aus Stein."
  );
    AddDetail( ({ "rest", "faszinierendes" }),
    "Na das ganze Zeug was hier so rumsteht!"
  );
    AddDetail( ({ "zeug" }),
    "Die Einrichtung eben."
  );
    AddDetail( ({ "einrichtung" }),
    "Na siehst Du nicht die ... oh. Hier ist ja wirklich gar nichts! Nicht "
    "zu fassen. Beschwere dich sofort bei der Wurst, die das verzapft hat!"
  );
    AddDetail( ({ "wurst" }),
    "Delgo. Los beschwere dich sofort ueber ihn!"
  );
    AddDetail( ({ "stein" }),
    "Diese harte Substanz, die so unheimlich weh tut."
  );
    AddDetail( ({ "substanz" }),
    "Es koennte Granit sein..."
  );
    AddDetail( ({ "granit" }),
    "... aber was waere das fuer ein Turm, wenn hier billiger Granit "
    "verwendet worden waere. Das ist bestimmt sowas Edles wie Tinarg."
  );
    AddDetail( ({ "tinarg", "edles" }),
    "Sieht aus wie Granit, riecht wie Granit, schmeckt wie Granit und "
    "is wesentlich kostenintensiver als Granit. Aber mein Haendler luegt "
    "mich nie an."
  );
    AddDetail( ({ "haendler" }),
    "Eine ehrliche Haut."
  );
    AddDetail( ({ "haut" }),
    "Deine ist noch da!"
  );
    AddDetail( ({ "turm" }),
    "Du befindest Dich hier im Turm der Kuenste."
  );
    AddDetail( ({ "kuenste" }),
    "Was beherrschst Du fuer eine Kunst?"
  );
    AddDetail( ({ "kunst" }),
    "Na Forschen sicher nicht!"
  );
    AddDetail( ({ "forschen" }),
    "Das nennst Du Forschen? Jaemmerlicher Anfaenger!"
  );
    AddDetail( ({ "anfaenger" }),
    "Jeder der dieses Detail untersucht hat, ist ein Anfaenger!"
  );
    AddDetail( ({ "detail" }),
    "Das ist ein Detail. Ein sinnloses Detail, aber es ist ein Detail."
  );
    AddDetail( ({ "waende" }),
    "Genaugenommen ist es nur eine Wand."
  );
    AddDetail( ({ "wand" }),
    "Sie besteht aus Stein und weist keine Besonderheiten auf. Sie wird nur "
    "durch die beiden Fenster unterbrochen."
  );
    AddDetail( ({ "besonderheiten", "besonderes" }),
    "Davon kannst Du nichts entdecken."
  );
    AddDetail( ({ "fenster" }),
    "Fenster waere zuviel gesagt. Zwei alte Schiessscharten beleuchten den "
    "Raum."
  );
    AddDetail( ({ "schiessscharten", "scharten" }),
    "Sie wurden schon lange nicht mehr benutzt."
  );
    AddDetail( ({ "raum", "zimmer", "turmzimmer" }),
    "Tippe: 'schau'."
  );
    AddDetail( ({ "boden" }),
    "Die Wand ist viel spannender!"
  );
    AddDetail( ({ "treppe" }),
    "Sie fuehrt in zwei Richtungen."
  );
    AddDetail( ({ "richtungen" }),
    "Nach unten geht es runter, und nach oben geht es in die naechste "
    "Etage."
  );
  AddDetail( ({ "etage" }),
    "Schau doch nach!"
  );
  AddSound( DEFAULT_SOUND,
    "Wenn der Wind draussen nicht zu heftig weht, ist es absolut still. Beaengstigend.");
  AddSmell( DEFAULT_SMELL,
    "Du kannst nicht erkennen wonach es hier riecht.");

}




