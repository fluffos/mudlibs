/* Nettes Schild fuer nekros */
inherit "std/armour";
#include "/gilden/nekromanten/nekro_properties.h"
#include "../def.h"
#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Seelenschild");
  SetProp(P_LONG,  
    "Der Seelenschild ist ein einfaches kleines Schild, etwa in der Groesse "
    "eines kleinen Rundschildes. Der hier ist nachtschwarz, spiegelglatt "
    "und weist die Form eines Pentagramms auf.");
  AddDetail( ({"form", "pentagramm"}), 
    "Du betrachtest den Schild genauer, leise Stimmen fangen an in Deinem "
    "Kopf zu wispern.");
  SetProp(P_SOUND, "Stimmen in Deinen Kopf werden laut. Du kannst sie "
    "nicht erfassen oder ihre Bedeutung erraten. Du schliesst die Augen "
    "und konzentrierst Dich. Als Du sie wieder oeffnest, sind die Stimmen "
    "verschwunden und der Schild liegt ruhig vor Dir. Unheimlich.");
  SetProp(P_NAME, "Seelenschild");
  SetProp(P_GENDER, MALE);
  AddId( ({"schild", "seelenschild"}) );

  SetProp(P_ARMOUR_TYPE, AT_SHIELD );
  SetProp(P_AC, 20);
  SetProp(P_MATERIAL, ([MAT_OPAL:100]) );
  SetProp(P_WEIGHT, 2100);
  SetProp(P_VALUE, 3100);
  SetProp(P_QUALITY_DECAY, 95);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_GOOD: -400,
                                 SR_SEER: 1]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+
         ([DT_LIGHT:1, DT_FIRE:1, DT_HOLY:1]) );
  SetProp(P_NEKRO_SPELLCOST, 5); 

  SetProp(P_INFO, BS("Es scheint als wuerden die gefangen Seelen in dem "
    "Schild Dich nicht vor Waffen schuetzen. Doch Licht und Feuer scheinen "
    "sie regelrecht zu absorbieren. Ob sie einem Nekromanten zusaetzliche "
    "Energie verleihen?"));
}

