#include "../def.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Ein Paar Drachenschwingen");
  SetProp(P_LONG,
    "Du haelst ein graues Paar Drachenschwingen in den Haenden. Du kannst "
    "sie wie einen Umhang tragen, aber das wars auch schon. Du fragst Dich, "
    "wozu die gut sind."
  );
  SetProp(P_NAME, "Drachenschwingen");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"drachenschwingen", "schwingen", "fluegel"}) );
  SetProp(P_MATERIAL, ([MAT_MISC:20, MAT_SILK:80]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_SIZE, 300);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 5);
  SetProp(P_QUALITY_DECAY, 20);

}


