inherit "std/armour";
#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"
#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Ein Paar Skelettklauen");
  SetProp(P_LONG,
    "Ein Paar Skelettklauen liegt in deinen Haenden. Sie bestehen "
    "vollstaendig aus Knochen und scheine frueher einem grossen Tier gehoert"
    " zu haben. An den einzelnen Fingerknochen entdeckst du etwas. "
  );
  AddDetail( ({"knochen"}), 
    "Scheint echt zu sein.");
  AddDetail( ({"fingerknochen"}), 
    "Sind das Schlaufen?");
  AddDetail( ({"schlaufen"}), 
    "Tatsaechlich. Es sieht so aus, als ob die diese Klauen anziehen "
    "kannst. Was fuer eine abartige Vorstellung. ");
  SetProp(P_NAME, "Skelettklauen");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"klauen","skelettklauen" }));
  
  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_BONE:100]));
  SetProp(P_WEIGHT, 300);  
  SetProp(P_VALUE, 1900); 
  SetProp(P_NOBUY, 1);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1]) );
  SetProp(P_DRUID_ADD_HAND_DAMAGE, 15);
  SetProp(P_INFO, BS("Wenn man mit diesen Klauen an den Haenden zuschlaegt, "
                  "werden bestimmt einige Kratzer entstehen."));
}

