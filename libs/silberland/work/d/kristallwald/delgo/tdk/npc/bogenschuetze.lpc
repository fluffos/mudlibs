//Soll man in einem duell besiegen koennen -> also Seicherl

#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Bogenschuetze");
  SetProp(P_LONG,
    "Dies ist ein Soeldner aus Avir. Er wurde auf den Umgang mit dem Bogen "
    "trainiert. Er steht an der Schiesscharte und schaut nach draussen. Wenn "
    "noetig, wird er Feinde von Omar auf einen Befehl hin sofort angreifen. "
    "Den Pfeil hat er schon eingelegt."    
  );
  SetProp(P_NAME, "Bogenschuetze");
  SetProp(P_GENDER, MALE);
  AddId(({"bogenschuetze", "soeldner", "schuetze"}));
  SetProp(P_ARTICLE, 1);
  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinen Haenden"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })
  );
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170);
  SetProp(P_WEIGHT, 62000);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 50);
  SetProp(P_NOMAGIC, 0);
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" braucht nichts von Dir.\n" }) );
  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein avirischer Pfeil");

  AddDetail( ({"umgang","bogen"}),
    "Er steht sicher nicht umsonst hier.");

  AddDetail( ({"haare","frisur"}),
    "Die haar sind militaerisch kurz geschnitten. Die Haarfarbe ist dunkel.");

  AddDetail( ({"ohren","ohr"}),
    "Er lauscht nebenbei mit seinen Ohren in alle Richtungen.");
  
  AddDetail( ({"nase"}),
    "Dir faellt an der Nase nichts auf.");
    
  AddDetail( ({"gesicht"}),
    "Das gesicht hat schon einiges miterlebt.");
        
  AddDetail( ({"augen","auge", "pupillen"}),
    "Die Augen ueberwachen aufmerksam die Umgebung.");
    
  AddDetail( ({"haut"}),
    "Die Haut ist braungebrannt, er hat scheinbar viel Dienst draussen.");
    
  AddDetail( ({"lippen", "mund", "lippe"}),
    "Der Mann murmelt leise vor sich hin.");
    
  AddDetail( ({"koerper"}),
    "Der Mann haelt sich fit, wie Du an dem durchtrainierten Koerper siehst.");
    
  AddDetail( ({"kleidung"}),
    "Die Unterkleidung waermt den Mann, bei seinem Dienst.");
    
  AddInfo(DEFAULT_INFO, 
    ({"weiss leider keine Antwort.\n",
      "kann Dir da nicht weiterhelfen.\n" }) );
  AddInfo("delgo", "Er ist bei uns bekannt.","sagt: ");
  
  AddInfo( ({"waffe","waffen"}) , "Ich habe den Umgang mit Waffen recht gut "
     "erlernt."
    ,"sagt: ");
    
  AddInfo( ({"ausbildung","vergangenheit"}) ,"Das war hart, aber ich moechte "
     "nicht darueber reden.."
    ,"sagt: ");
    
  AddInfo( ({"auftrag","aufgabe"}) , "Das wechselt taeglich."
    ,"sagt: ");
    
  AddInfo( ({"arbeit","leben"}) , "Sicher gibt es sichere Arbeit aber naja, "
     "was soll man machen?"
    ,"sagt: ");
    
  AddInfo( ({"tod","sterben"}) ,"Wenn es sein muss."
    ,"sagt: ");
    
  AddInfo( ({"gebiet","hilfe", "avir", "turm", "kuenste"})
    , "Du bist auf dem alten Turm der Kuenste."
    ,"sagt: ");
    
  AddInfo("bogen", "Den benutze ich recht gerne.","sagt: ");
  AddInfo("bogenschuetze", "Ich kenne nur mich und meine Soeldner, und "
  	"  jetzt lass mich arbeiten!","sagt: ");
  SetProp(P_SPELLRATE, 0);
  SUID;
  CLONEME(WEAPON "bogen_mittel" );
  command("zuecke bogen");

  CLONEME( "/p/armour/armour/lederpanzer" );
  command("trage alles");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
      +" killt " + name(WEN, 1) + ".\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        ctime()+": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player))
        +" umgebracht.\n");
  }
}

