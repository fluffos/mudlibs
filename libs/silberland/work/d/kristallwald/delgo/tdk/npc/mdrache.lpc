#include "../def.h"

inherit "/p/std/dragons/dragon";
inherit "/std/npc/spells.lpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Tshurghaeyrkleijh der Mithrildrache");
  SetProp(P_LONG,
    "Du traust Deinen Augen nicht, als Du diesen Lindwurm vor Dir aufragen "
    "siehst. Tshurghaeyrkleijh wird auch der Sturmdrache genannt, da er "
    "mit seinen drei Koepfen das Eis, den Wind und den Blitz symbolisiert. "
    "Sein Ruecken wird von funkelnden Mithrilschuppen bedeckt und verleihen "
    "ihm eine hervorragenden Schutz. Es kaeme einem Wahn gleich, sich mit "
    "dieser Macht anzulegen."
  );
  SetProp(P_NAME, "Tshurghaeyrkleijh");
  SetProp(P_GENDER, MALE);
  AddId(({"tshurghaeyrkleijh", "drache", "mithrildrache", "sturmdrache"}));
  AddClass( ({ "drache", "flying"}) );
  create_default_dragon(0, 12, 2, 30); 
  SetProp(P_ARTICLE, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" braucht nichts von Dir.\n" }) );
  SetProp(P_MSGIN, "schaut Dich aus ruhigen Augen an");
  SetProp(P_MSGOUT, "richtet einen seiner Koepfe");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_DIE_MSG,  " faellt zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Tshurghaeyrkleijh der Mithrildrache");
  AddInfo(DEFAULT_INFO, "versteht Dich nicht.\n");
  AddInfo("delgo", "Delgo gab mir die Macht.","sagt: ");
  
  AddSpell(2,1,
    "Tshurghaeyrkleijh fliegt ueber Dich hinweg.\n",
    "Tshurghaeyrkleijh fliegt ueber @WEN hinweg.\n",
    DT_AIR, "blow", ([SP_SHOW_DAMAGE:1]) ); //Luft

  AddSpell(3,1750, 
    "Tshurghaeyrkleijh huellt Dich mit seinem Eisatem ein.\n",
    "Tshurghaeyrkleijh huellt @WEN mit seinem Eisatem ein.\n", 
    DT_COLD); //Eis

 AddSpell(4,1250,
    "Tshurghaeyrkleijh beschwoert einen Blitz vom Himmel.\n",
    "Tshurghaeyrkleijh beschwoert einen Blitz vom Himmel.\n",
    DT_LIGHTNING, ([SP_SHOW_DAMAGE:1]) ); //Blitz
  
  AddSpell(1,1,
    "Tshurghaeyrkleijh greift mit allen Koepfen gleichzeitig an.\n",
    "Tshurghaeyrkleijh greift mit allen Koepfen gleichzeitig an.\n",
    DT_AIR, "speed", ([SP_SHOW_DAMAGE:1]) );

  
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
      +" killt " + name(WEN, 1) + ".\n");
  TDKMASTER->Msg(""+TPN+" hat gerade den Mithrildrachen besiegt", 2);
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        ctime()+": " + Name(WER, 1) + " hat gerade " + CAP(getuid(player))
        +" umgebracht.\n");
  }
  ::NotifyPlayerDeath();
}

void blow()
{
  call_other(ROOM "e17_2", "fly"); 
}

void speed()
{
  this_object()->ModifySkillAttribute(this_object(),SA_SPEED,300,4);
}
