#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Feuermargyl");
  SetProp(P_LONG,
    "Dies ist kein feuriger Todesengel vor Deinen Augen, sondern ein "
    "Feuermargyl. Eine schreckliche Feuerkreatur mit flammenden "
    "Schwingen. Seine Augen leuchten Dich gelb an."
  );
  SetProp(P_NAME, ({"Feuermargyl", "Feuermargyls",
                    "Feuermargyl", "Feuermargyl"}));
  SetProp(P_GENDER, MALE);
  AddId(({"feuermargyl", "NOWIMPY", "margyl"}));
  AddClass( ({CL_FLYING }) );
  SetProp(P_ARTICLE, 1);
  create_default_npc(26);
  SetProp(P_HANDS, ({" mit seinen Feuerschwingen"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_FIRE})
                    })
  );
  SetProp(P_RACE, "Margyl");
  SetProp(P_SIZE, 260);
  SetProp(P_WEIGHT, 85195);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 15);
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann sowas nicht.\n" }) );
  SetProp(P_MSGIN, "feuert heran");
  SetProp(P_MSGOUT, "feuert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_DIE_MSG,  " verpufft.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Feuermargyl");
  SetProp(P_RESISTANCE_STRENGTHS,
      ([ DT_FIRE:-0.6, DT_WATER: 0.7, DT_COLD: 0.5]) );

  AddInfo(DEFAULT_INFO, "spricht sicherlich nicht Deine Sprache.\n");
  AddInfo("delgo", " kreischt.");
  SetChats(3,
  ({Name(WER, 1)+" flattert.\n"
   ,Name(WER, 1)+" kreischt ohrenbetaeubend.\n"
   })
  );

  SetAttackChats(10,
  ({Name(WER, 1)+" kratzt Dich!\n"
   ,Name(WER, 1)+" beisst Dich!\n"
   })
  );

}