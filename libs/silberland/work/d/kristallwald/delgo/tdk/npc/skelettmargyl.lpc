#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Skelettmargyl");
  SetProp(P_LONG,
    "Vor Dir steht eine Abart aus Skelett und Margyl. Durch pure schwarze "
    "Magie, gelingt es diesem Ungeheuer sich mit seinen Knochenfluegeln "
    "in der Luft zu halten. Seine Augen leuchten Dich violett an."
  );
  SetProp(P_NAME, ({"Skelettmargyl", "Skelettmargyls",
                    "Skelettmargyl", "Skelettmargyl"}));
  SetProp(P_GENDER, MALE);
  AddId(({"skelettmargyl", "NOWIMPY", "margyl"}));
  AddClass( ({"skelett", "untoter", "flying" }) );
  SetProp(P_ARTICLE, 1);
  create_default_npc(23);
  SetProp(P_HANDS, ({" mit seinen knoechernen Krallen"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })
  );
  SetProp(P_RACE, "Margyl");
  SetProp(P_SIZE, 240);
  SetProp(P_WEIGHT, 105195);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 10);
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann sowas nicht.\n" }) );
  SetProp(P_MSGIN, "flattert heran");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_DIE_MSG,  " zerfaellt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Skelettmargyl");
  AddInfo(DEFAULT_INFO, "spricht sicherlich nicht Deine Sprache.\n");
  AddInfo("delgo", " kreischt."," ");
  SetChats(3,
  ({Name(WER, 1)+" flattert.\n"
   ,Name(WER, 1)+" kreischt ohrenbetaeubend.\n"
   })
  );

  SetAttackChats(10,
  ({Name(WER, 1)+" kratzt Dich!\n"
   ,Name(WER, 1)+" beisst Dich!\n"
   })
  );

}