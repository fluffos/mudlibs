#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Miiralth, der Herr der Gargoyles");
  SetProp(P_LONG,
    "Dieser riesige Gargoyle ist einfach nur beeindruckend gross. Er ist "
    "nicht sonderlich schnell und beweglich, aber die steinernen "
    "Muskelpakete jagen Dir genug Angst ein."
  );
  SetProp(P_NAME, "Miiralth");
  SetProp(P_GENDER, MALE);
  AddId(({"gargoyle", "NOWIMPY", "miiralth"}));
  AddClass( ({"flying" }) );
  SetProp(P_ARTICLE, 0);
  create_default_npc(30, 1600);
  SetProp(P_HANDS, ({" mit seinen steinernen Krallen"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })
  );
  SetProp(P_BODY, 200); //steinhaut eben :)
  SetProp(P_RACE, "Gargoyle");
  SetProp(P_SIZE, 500); //Aufschaun!
  SetProp(P_WEIGHT, 1035000); //ne Tonne mindestens
  SetProp(P_ALIGN, -400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 15);
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann sowas nicht.\n" }) );
  SetProp(P_MSGIN, "flattert heran");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_DIE_MSG,  " ist besiegt.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_NAME, "Miiralth");
  AddInfo(DEFAULT_INFO, "spricht sicherlich nicht Deine Sprache.\n");
  AddInfo("delgo", " kreischt."," ");
  SetChats(3,
  ({Name(WER, 1)+" schaut Dich durch seine steinernen Augen an.\n"
   ,Name(WER, 1)+" kreischt ohrenbetaeubend.\n"
   })
  );

  SetAttackChats(10,
  ({Name(WER, 1)+" ist Durch seine Steinhaut kaum zu verwunden!\n"
   ,Name(WER, 1)+" fliegt ueber Dir hinweg!\n"
   })
  );
  SetProp(P_SPELLRATE, 9);
  AddSpell(1,950,
    Name()+" zerquetscht Dich!\n",
    Name()+" zerquetscht @WEN einfach!\n",
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
  SUID;
  CLONEME(ARMOUR "schwingen");
  CLONEME(OBJ "zfackel");
  

}

void Attack(object enemey)
{
  object ob;
  
  ::Attack(enemey);
  
  ob=ENV(TO);
  if(TO->QueryProp(P_HP) < 300 && TO->QueryProp(P_HP) > 200)
  {
   ob->Message(BS("Die Haut von Miiralth bekommt Risse."), MSGFLAG_VISUAL);
  }
  if(TO->QueryProp(P_HP) < 200)
  {
   ob->Message(BS("Die Risse auf Miiralths Haut werden immer groesser.")
              , MSGFLAG_VISUAL);
  }  
}

int my_filter_func(object ob) 
{
  if(ob->id("miiralth")) return 0;                                
  if(ob->QueryProp(P_GHOST)) return 0; 
  if(!interactive(ob)) return 0;
  return 1;
}

void die(int poisondeath)
{
	int n, i;
	mixed enemies; 
	string room; 
	object ob;
	
	//_______________LOG____________________//
  write_file(LOG "npc.kills", 
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt Miiralth.\n");
  //______________LOG_ENDE_______________// 
  
  
  
  ob=ENV(TP);
	room = ROOM "e8_1";
	enemies = filter_array(all_inventory(ob), "my_filter_func"); 
	n=sizeof(enemies);
	room->Message(BS("Aus den Rissen auf Mirralths Haut, tritt gleissendes "
	            "Licht aus und er explodiert auf einmal!"
	            ), MSGFLAG_VISUAL);
	for (i=0; i<sizeof(enemies);i++)
	  {
	    enemies[i]->do_damage(50+(random(30))); 
	  }	
	                    
	::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads", 
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))+
      " umgebracht.\n");
  }
}
