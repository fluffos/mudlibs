/*
Delomant scheint in Gedanken versunken zu sein und grinst dabei haemisch.
Delomant verzieht sein Gesicht zu einer Grimasse.
Aus dem Koerper von Delomant loest sich ein Schatten und schwebt auf Drew zu.
Der Schatten verschmilzt mit ihr und sie sieht ploetzlich gesuender aus!
*/
#include "../def.h"

inherit "/p/std/npc/necromancer_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Celsezal der Lichdrachen");
  SetProp(P_LONG,
    "Celsezal war einst ein maechtiger Lich, ein Nekromant, der die Grenzen "
    "der schwarzen Macht ueberschritten hat. Vor lange Zeit ging er ein "
    "Buendnis mit einem Skelettdrachen ein und nun ist er nur noch "
    "maechtiger geworden. Es ist wohl besser, dass sein Koerper unter "
    "dem langen schwarzen Mantel verborgen ist ..."
  );
  SetProp(P_NAME, "Celsezal");
  SetProp(P_GENDER, MALE);
  AddId(({"celsezal", "lich", "lichdrache", "nekromant", "/ndrachenlich"}));
  AddClass( ({ "untoter", "drache" , "nightvision" , "fluch"}) );
  SetProp(P_ARTICLE, 0);
  create_necromancer_npc(35, 7, 7, 1);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_SPELLRATE, 20);
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" braucht nichts von Dir.\n" }) );
  SetProp(P_MSGIN, "schlurft herein");
  SetProp(P_MSGOUT, "schlurft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_DIE_MSG,  " zerfaellt endgueltig.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_NAME, "Celsezal, die lebende Grenze der schwarzen Macht");
  AddInfo(DEFAULT_INFO, "spricht nicht mit einem Opfer.\n");
  AddInfo("delgo", "Delgo gab mir die Macht.","sagt: ");
  SUID;
  CLONEME(ARMOUR "schwingen");
  CLONEME(ARMOUR "seelenschild");
  
}

void die(int poisondeath)
{
  TDKMASTER->Msg(""+TPN+" hat gerade Celsezal umgebracht", 2);
  call_other(ROOM "e14_1", "ktod");
  if (TP)
  {
  write_file(LOG "npc.kills",
      ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
      +" killt " + name(WEN, 1) + ".\n");
  }
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        ctime()+": " + Name(WER, 1) + " hat gerade " + CAP(getuid(player))
        +" umgebracht.\n");
  }
}

void Attack(object enemy)
{
  object ob;
  int hp;
  
  ob=present("/nlichdrache", ENV(TO));
  if(ob)
  {
    switch(1+random(2))
    {
      case 1:  
        hp=ob->QueryProp(P_HP);
        if(hp < 390)
        {
          ob->AddHp((75)+(random(25)));
          tell_room(ENV(TO), "Celsezal scheint in Gedanken versunken zu sein "
                             "und grinst dabei haemisch.\n");
          tell_room(ENV(TO), "Celsezal verzieht sein Gesicht zu einer "
                             "Grimasse.\n");
          tell_room(ENV(TO), "Aus dem Koerper von Celsezal loest sich ein "
                             "Schatten und schwebt auf Khaurune zu.\n");
          tell_room(ENV(TO), "Der Schatten verschmilzt mit Khaurune und er "
                             "sieht ploetzlich gesuender aus!\n");
     }
      break;
      default:  
        hp=ob->QueryProp(P_HP);
        if(hp < 390)
        {
          tell_room(ENV(TO), "Celsezal beobachtet Khaurune.\n");
        }
      break;
    }
  }
  ::Attack();
  return;
}
