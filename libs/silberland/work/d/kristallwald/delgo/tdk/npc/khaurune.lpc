#include "../def.h"

inherit "/p/std/dragons/dragon";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Khaurune der Lichdrachen");
  SetProp(P_LONG,
    "Khaurune. Lang verbreitete dieser Name Angst und Schrecken bis er "
    "eines Tages aus dem Tal verschwand. Und jetzt steht er vor Dir. "
    "Durch sein Buendnis noch viel maechtiger als zuvor und noch viel "
    "gefaehrlicher. Von einem Drachen kannst Du an ihm kaum noch etwas "
    "erkennen ..."
  );
  SetProp(P_NAME, "Khaurune");
  SetProp(P_GENDER, MALE);
  AddId(({"khaurune", "lich", "lichdrache", "drache", "/nlichdrache"}));
  AddClass( ({ "untoter", "drache" , "nightvision" , "fluch", "flying"}) );
  create_default_dragon(1, 2, 0, 5); 
  SetProp(P_ARTICLE, 0);
  SetProp(P_AGGRESSIVE, 1);
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" braucht nichts von Dir.\n" }) );
  SetProp(P_MSGIN, "klappert herein");
  SetProp(P_MSGOUT, "klappert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_DIE_MSG,  " zerfaellt endgueltig.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_NAME, "Khaurune");
  AddInfo(DEFAULT_INFO, "spricht nicht mit einem Opfer.\n");
  AddInfo("delgo", "Delgo gab mir die Macht.","sagt: ");
  SUID;
  CLONEME(ARMOUR "schwingen");
  CLONEME(ARMOUR "klauen");
}

void die(int poisondeath)
{
  TDKMASTER->Msg(""+TPN+" hat gerade Khaurune umgebracht", 2);
  call_other(ROOM "e14_1", "ntod");
  if (TP)
  {
  write_file(LOG "npc.kills",
      ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
      +" killt " + name(WEN, 1) + ".\n");
  }
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        ctime()+": " + Name(WER, 1) + " hat gerade " + CAP(getuid(player))
        +" umgebracht.\n");
  }
  ::NotifyPlayerDeath();
}

void Attack(object enemy)
{
  object ob;
  int hp;
  
  ob=present("/ndrachenlich", ENV(TO));
  if(ob)
  {
    hp=ob->QueryProp(P_HP);
    if(hp < 321)
    {
      ob->AddDefender(TO);
    }
    if(hp > 350) { ob->RemoveDefender(TO); }
  }
  ::Attack(enemy);
  return;
}

mixed DefendOther(int dam,mixed dam_type,mixed spell,object enemy)
{ 
  int my_dam;
  
  tell_room( ENV(TO), "Khaurune faengt den Grossteil des Schadens fuer "
                      "Celsezal ab.\n");
  my_dam  = dam/3;
  dam     = my_dam;
  return({dam,dam_type,spell});
}
