/* Die AvirSoeldner in EliteForm*/
#include "../def.h"
inherit "std/npc";
inherit "/std/npc/spells";

int sort_func(object ob);

void create()
{
int 		level, spellrate, spellrate_1, spellrate_2, spellrate_3, spellpower;
int    	weight, size;
string 	weapon, weapon_z;
  
  if (!is_clone(this_object())) return;
  ::create();
  
  switch(1+random(5))
  {
    case 1: 
      level = 25;
      weight = 70000+random(20000);
      size = 180+random(30);
      spellrate = 15;
      spellpower = 40;
      AddId( ({"Schwertkaempfer"}) );
      spellrate_1 = 2;
      spellrate_2 = 1;
      spellrate_3 = 0;
      weapon = "/p/weapon/sword/breitschwert";
      weapon_z = "zuecke schwert";
      break;

    case 2:  
      level = 25;
      weight = 75000+random(25000);
      size = 185+random(35);
      spellrate = 20;
      spellpower = 65;
      spellrate_1 = 2;
      spellrate_2 = 1;
      spellrate_3 = 0;
      AddId( ({"Axtkaempfer"}) );
      weapon = "/p/weapon/axe/kriegsbeil";
      weapon_z = "zuecke beil";
      break;

    case 3:  
      level = 25;
      weight = 70000+random(18000);
      size = 180+random(10);
      spellrate = 30; //machen schon sehr viele Tricks mit Kettenwaffen!
      spellpower = 80; //mit schwung haun die richtig rein!
      spellrate_1 = 3;
      spellrate_2 = 2;
      spellrate_3 = 1;
      AddId( ({"Kettenkaempfer"}) );
      weapon_z = "zuecke kriegsflegel";
      weapon = "/p/weapon/chain/kriegsflegel";
      break;

    case 4: 
      level = 27;
      weight = 65000+random(25000);
      size = 195+random(25);
      spellrate = 25;
      spellpower = 100;
      spellrate_1 = 3;
      spellrate_2 = 2;
      spellrate_3 = 1;
      AddId( ({"Speerexperte"}) );
      weapon_z = "zuecke hellebarde";
      weapon = "/p/weapon/spear/hellebarde";
      break;

    default:
      level = 30; 
      weight = 100000+random(30000);
      size = 200+random(15);
      spellrate = 20;
      spellpower = 160;
      spellrate_1 = 4;
      spellrate_2 = 3;
      spellrate_3 = 2;
      AddId( ({"keulenexperte"}) );
      weapon_z = "zuecke hammer";
      weapon = "/p/weapon/club/kriegshammer";
      break;

}

  SetProp(P_SHORT, "Ein Elitesoldat");
  SetProp(P_LONG, "Vor Dir steht ein Elitesoldat der avirischen Soeldner."
    "Er ist gross, kraeftig und ungemein furchteinfloessend. Es scheint, "
    "als wuerde er Dich schon mit seinen blossen Haenden zerreissen "
    "koennen. Ihn sollte man nicht so leichtfertig behandeln wie das Pack "
    "in Avir."
  );
  SetProp(P_NAME, "Elitesoldat");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  AddId( ({"soeldner", "NOWIMPY", "soldat", "elitesoldat"}) );
  create_default_npc(level);
  SetProp(P_HANDS, ({" mit blossen Haenden ",QueryProp(P_HANDS)[1],
                     DT_BLUDGEON}));
  SetProp(P_ALIGN, 200 - random(500) ); 
  SetProp(P_RACE, "Mensch");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_WEIGHT, weight);
  SetProp(P_SIZE, size);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC, 35);
  SetProp(P_REJECT, ({ REJECT_DROP,
    "Der Soldat hat keine Zeit dafuer.\n" }) );
  SetChats(3,
  ({Name(WER, 10)+" murmelt leise etwas vor sich hin.\n"
   ,Name(WER, 1)+" gruebelt.\n"
   ,Name(WER, 15)+" beobachtet aufmerksam die Umgebung.\n"
   })
  );
  SetProp(P_MSGIN, "kommt heran");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht woanders hin");
  SetProp(P_DIE_MSG,  " stuerzt mit einem Schmerzensschrei zu Boden.\n");

  AddDetail( ({"haare","frisur"}),
    "Die Haare sind militaerisch kurz geschnitten. Die Haarfarbe ist schwarz.");

  AddDetail( ({"ohren","ohr"}),
    "Er lauscht nebenbei mit seinen Ohren in alle Richtungen.");
  
  AddDetail( ({"nase"}),
    "Dir faellt an der Nase nichts auf.");
    
  AddDetail( ({"gesicht"}),
    "Das Gesicht hat schon einiges miterlebt.");
        
  AddDetail( ({"augen","auge", "pupillen"}),
    "Die Augen ueberwachen aufmerksam die Umgebung.");
    
  AddDetail( ({"haut"}),
    "Die Haut ist braungebrannt, er hat scheinbar viel Dienst draussen.");
    
  AddDetail( ({"lippen", "mund", "lippe"}),
    "Der Mann murmelt leise vor sich hin.");
    
  AddDetail( ({"koerper"}),
    "Der Mann haelt sich fit, wie Du an dem durchtrainierten Koerper siehst.");
    
  AddDetail( ({"kleidung"}),
    "Die Unterkleidung waermt den Mann, bei seinem Dienst.");
    
  AddInfo(DEFAULT_INFO, 
    ({"weiss leider keine Antwort.\n",
      "kann Dir da nicht weiterhelfen.\n" }) );
  AddInfo("delgo", "Er ist bei uns bekannt.","sagt: ");
  
  AddInfo( ({"waffe","waffen"}) , "Ich habe den Umgang mit Waffen recht gut "
     "erlernt."
    ,"sagt: ");
    
  AddInfo( ({"ausbildung","vergangenheit"}) ,"Das war hart, aber ich moechte "
     "nicht darueber reden.."
    ,"sagt: ");
    
  AddInfo( ({"auftrag","aufgabe"}) , "Das wechselt taeglich."
    ,"sagt: ");
    
  AddInfo( ({"arbeit","leben"}) , "Sicher gibt es sichere Arbeit aber naja, "
     "was soll man machen?"
    ,"sagt: ");
    
  AddInfo( ({"tod","sterben"}) ,"Wenn es sein muss."
    ,"sagt: ");
    
  AddInfo( ({"gebiet","hilfe", "turm"}) , "Du bist auf dem Turm der Kuenste."
    ,"sagt: ");
  SetProp(P_SPELLRATE,spellrate);
  AddSpell(spellrate_1,250+spellpower,
    Name()+" taeuscht Dich mit einer Finte!\n",
    Name()+" taeuscht @WEN mit einer Finte!\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));
  AddSpell(spellrate_2,350+spellpower,
    Name()+" schleudert Dich mit einem Rueckhandhieb zu Boden!\n",
    Name()+" schleudert @WEN mit einem Rueckhandhieb zu Boden!\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));
  AddSpell(spellrate_3,500+spellpower,
    "Der Soeldner springt hoch und vernichtet Dich mit einem gewaltigen "
    "Hieb!\n",
    "Der Soeldner springt hoch und vernichtet @WEN mit einem gewaltigen "
    "Hieb!\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));

  SUID;
  CLONEME( weapon );
  CLONEME( "/p/armour/armour/kettenpanzer");
  CLONEME( "/p/armour/helm/titanhelm" );
  command("trage alles");
  command( weapon_z );

}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt einen Soldaten.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer == ME)
  {
    write_file(LOG "npc.deads",
      ctime()+": Ein Soldat hat gerade "+CAP(getuid(player))+
      " umgebracht.\n");
  }
}


void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;
  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "lacht Dich aus.",
        "lacht @WEN aus.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "brummt: Verschwinde!",
        "brummt: Verschwinde!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "schuettelt nur den Kopf.",
        "schuettelt nur den Kopf.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "lacht Dich nur aus.",
        "lacht @WEN nur aus.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "grummelt: Lenk mich nicht ab!",
        "grummelt: Lenk mich nicht ab @WER!");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Geh woanders spielen und lass die Erwachsenen arbeiten.",
        "sagt zu @WEM: Geh woanders spielen und lass die Erwachsenen "
        "arbeiten.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "lacht ueber Dich.",
        "lacht ueber @WEN.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;
  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}


void angriff(object pl)
{
  string shouter;
  if(!ENV(TO))           return;
  if(!ENV(pl))           return;
  if(!interactive(pl))   return;
  if(ENV(TO) != ENV(pl)) return;
  Kill(pl);
  return;
}

int sort_func(object ob)
{
  if(member(ob->QueryProp(P_IDS), "\nmargyl") > -1) {return 1;}
  return 0; 
}

void init()
{
  object *ob;
  int i;
  
  ob=filter_array(all_inventory(ENV(TO)), "sort_func");
  if(ob)
  { for(i=0; i<=sizeof(ob)-1; i++)
    { Kill(ob[i]); } }
    
  ::init();
    
  if(!TP)                        return;
  if(!interactive(TP))           return;
  if(TP->QueryProp(P_GHOST))     return;
  if(!TDKMASTER->IsEnemy(TP))   return;
  call_out("angriff", 0, TP);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  TDKMASTER->AddEnemy(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}
