#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Mirrodin -  Der Herr der Margyls");
  SetProp(P_LONG,
    "Vor Dir hockt eine erstaunlich kleine Gestalt. Mirrodin sieht den "
    "anderen Margyls kaum aehnlich. Er ist kleiner, duenner und wesentlich "
    "flinker. Zudem ist er geschuppt und die Steinschuppen rascheln bei "
    "jeder Bewegung."
  );
  SetProp(P_NAME, "Mirrodin");
  SetProp(P_GENDER, MALE);
  AddId(({"margyl", "NOWIMPY", "mirrodin"}));
  AddClass( ({"flying"}) );
  SetProp(P_ARTICLE, 1);
  create_default_npc(30, 1100);
  SetProp(P_HANDS, ({" mit seinen steinernen Krallen"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })
  );
  SetProp(P_RACE, "Margyl");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 128000);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 25);
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann sowas nicht.\n" }) );
  SetProp(P_MSGIN, "flattert heran");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_DIE_MSG,  " zerbroeckelt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Mirrodin");
  AddInfo(DEFAULT_INFO, "spricht sicherlich nicht Deine Sprache.\n");
  AddInfo("delgo", " kreischt."," ");
  SetChats(3,
  ({Name(WER, 1)+" raschelt.\n"
   ,Name(WER, 1)+" kreischt ohrenbetaeubend.\n"
   })
  );

  SetAttackChats(10,
  ({Name(WER, 1)+" kratzt Dich!\n"
   ,Name(WER, 1)+" beisst Dich!\n"
   })
  );
  SetProp(P_SPELLRATE, 50);
  AddDefaultSpell(1, 1, DS_BLIND,
    "Mirrodin springt Dich an und zerkratzt Dein Gesicht!\n",
    "Mirrodin springt @WEN an!\n" );
  AddDefaultSpell(1, 1, DS_DISARM,
    "Mirrodin beisst Dir in die Hand!\n",
    "Mirrodin beisst @WEM in die Hand!\n" );
  AddDefaultSpell(1, 1, DS_MASS_DEAF,
    "Mirrodin kreischt fuerchterlich laut.\n",
    "Mirrodin kreischt fuerchterlich laut.\n" );
  AddDefaultSpell(1, 1, DS_PARALYZE,
    "Mirrodin fegt Dich mit eine schnellen Bewegung. Du faellst zu Boden.\n",
    "Mirrodin bringt @WEN zu Fall!\n", 2 );
    
  SUID;
  CLONEME(ARMOUR "schwingen");
  CLONEME(WEAPON "dunkelpeitsche");

}


void die(int poisondeath) 
{
  write_file(LOG "npc.kills", 
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt Mirrodin.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads", 
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))+
      " umgebracht.\n");
  }
}
