//Soll man in einem duell besiegen koennen -> also Seicherl

#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";
inherit "std/player/soul";

string func()
{
  object ob,qo;
  
  ob=present("\nwaffen_quest", TP);
  
  if(TO->InFight() != 0)
  {
    return BS("Ich kann jetzt nicht."); 
  }
  if(ob)
  {
    return BS("Du versuchst Dich doch schon als Waffenmeister. "
           "Verschwende nicht meine Zeit.");
  }
  TDKMASTER->Msg(""+TPN+" beginnt die SubQuest 'Waffenmeister von Avir'", 1);
  command_me("muster "+TPN+"");
  qo=clone_object(OBJ "waffenquest");
  qo->move(TP, M_GET);
  ob=present("\nwaffen_quest", TP);
  SetProp(P_NOATTACK, "unterhaelt sich gerade.");
  TP->SetProp(P_PARALYZED, ([PARALYZE_TIME: 12, 
							PARALYZE_MSG: "Du lauschst den Ausfuehrungen von Aulin.\n", 
							PARALYZE_MSG_OTHER: "%s hoert gebannt zu.\n", 
							PARALYZE_END: "Du solltest anfangen!\n",
							PARALYZE_END_OTHER: "%s schuettelt sich kurz.\n"]));
	ob->Set0();	
	SetProp(P_NOATTACK, "unterhaelt sich gerade.");
	call_out("aseq1", 5);
  return "Mhh ...";
}

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Aulin der Jungmagier");
  SetProp(P_LONG,
    "Aulin ist einer der Soeldner aus Avir. Er ist der einzige Magier der "
    "Truppe, aber noch relativ gruen hinter den Ohren. Das soll aber nicht "
    "heissen, dass seine Macht gering ist. Den einen oder anderen Trick wird "
    "er schon fuer Dich bereithalten."
  );
  SetProp(P_NAME, "Aulin");
  SetProp(P_GENDER, MALE);
  AddId(({"aulin", "soeldner", "magier", "jungmagier", "NOWIMPY"}));
  SetProp(P_ARTICLE, 0);
  create_default_npc(15, 300);
  SetProp(P_HANDS, ({" mit seinen Haenden"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })
  );
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 165);
  SetProp(P_WEIGHT, 59000);
  SetProp(P_ALIGN, -600);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 60);
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" braucht nichts von Dir.\n" }) );
  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_DIE_MSG,  " sagt: Gut, Du hast gewonnen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_NOATTACK, 1);
  SetProp(P_KILL_NAME, "Aulin");
  AddDetail( ({"haare","frisur"}),
    "Die Haare sind schwarz und fast kinnlang.");

  AddDetail( ({"ohren","ohr"}),
    "Die Ohren werden von den Haaren verdeckt.");
  
  AddDetail( ({"nase"}),
    "Du bemerkst nichts an der Nase.");
    
  AddDetail( ({"gesicht"}),
    "Der Mann versucht deinen Blicken auszuweichen.");
        
  AddDetail( ({"augen","auge", "pupillen"}),
    "Kleine Augen schauen sich regelmaessig um.");
    
  AddDetail( ({"haut"}),
    "Die Haut eher hell, der Mann ist wohl nicht oft in der Sonne.");
    
  AddDetail( ({"lippen", "mund", "lippe"}),
    "Er presst angestrengt die Lippen aufeinander.");
    
  AddDetail( ({"koerper"}),
    "Der Mann laeuft leicht uebergebeugt und versucht unauffaellig zu "
    "wirken.");
    
  AddDetail( ({"kleidung"}),
    "Er traegt eher dunkle Kleidung.");
  
  AddInfo(DEFAULT_INFO, 
    ({"ignoriert Dich gekonnt.\n",
      "murmelt etwas Unverstaendliches.\n" }) );
  AddInfo("delgo", "Ich habe schon von ihm gehoert.","sagt: ");
  
  AddInfo( ({"arbeit","handwerk"}) , "Das geht Dich nichts an."
    ,"sagt: ");
    
  AddInfo( ({"leben","alter"}) ,"Ich lebe lang genug um zu wissen, dass "
     "ich nicht antworten muss."
    ,"sagt: ");
    
  AddInfo( ({"soeldner","magier"}) ,"Ich bin der Magier der Soeldner."
    ,"sagt: ");
    
  AddInfo( ({"gebiet","hilfe"}) , "Du befindest Dich auf dem Turm der Kuenste."
    ,"sagt: ");
  AddInfo(({"schluessel","tuer"}), "Omar hat den Schluessel.","sagt: ");
  AddInfo( ({"waffenmeister"}), #'func, "sagt: ");
  //startet die subquest
  add_soul_commands();
  SetAttackChats(10,
  ({Name(WER, 1)+" sagt: Na los, streng Dich an!\n",
    Name(WER, 1)+" freut sich ueber das Duell.\n",
   }) );
  SetProp(P_SPELLRATE, 50);
  AddSpell(5,200,
    "Aulin greift Dich mit einem kleinen Feuerball an.\n",
    "Aulin greift @WEN mit einem kleinen Feuerball an.\n",
    ({DT_FIRE,DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );
  AddSpell(5,200,
    "Aulin greift Dich mit einem kleinen Eisball an.\n",
    "Aulin greift @WEN mit einem kleinen Eisball an.\n",
    ({DT_COLD,DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );  
  SUID;
  CLONEME( "/p/armour/cloak/robe" );
  command("trage alles");
}

void die(int poisondeath)
{
  object ob, *i;
  int k;
  
  i=deep_inventory(TO);
  for(k=0;k<=sizeof(i)-1;k++)
  {i[k]->remove(1);}

  ob=present("\nwaffen_quest", TP);
  if(ob) {ob->Set5();}
  //SPAETER WIRD DER AUFTRAGSGEBER DAS QUESTOBJEKT REMOVEN, BIS DAHIN HIER
  TDKMASTER->Msg(""+TPN+" loest die SubQuest 'Waffenmeister von Avir' ", 1);
  TP->Message(BS("GRATS, Du Bist Waffenmeister von Avir!"), MSGFLAG_VISUAL);
  ob->remove(1);
  write_file(LOG "npc.kills",
      ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
      +" killt " + name(WEN, 1) + ".\n");
  TO->move(ROOM "std_turmzimmer", M_GO|M_SILENT);
  TP->Message(BS("Aulin geht wieder zurueck.\n"));
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        ctime()+": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player))
        +" umgebracht.\n");
  }
}

int aseq1()
{
  command_me("grummel");
  command_me("murmel /Von mir aus. Ich weiss zwar nicht, wer Dir von dieser "
             "alten Pruefung erzaehlt hat, aber mir ist es auch egal. Man "
             "kann sie noch ablegen");
  command_me("starr "+TPN+"");
  call_out("aseq2", 5); 
}
int aseq2()
{
  command_me("sag Also. Du musst 5 Kaempfer besiegen. Benran, Urstam, Junth"
             ", Erthal und ...");
  command_me("laechel /kalt");
  command_me("sag ... Mich. In dieser Reihenfolge.");
  call_out("aseq3", 5);
}
int aseq3()
{
  command_me("sag Doch denk daran! Das sind Duelle. Du darfst nicht mitten "
             "im Kampf abhaun. Und du musst sie alleine besiegen. Sie "
             "werden es Dir nicht ganz so schwer machen, aber bleib "
             "trotzdem fair! Du beginnst, indem Du sie herausforderst. "
             "Die Herausforderung dabei: Den letzten Schlag musst Du selbst "
             "fuehren. Viel Glueck. (syntax: <fordere name>)");
  call_out("aseq4", 5);
}
int aseq4()
{
  command_me("murmel /Sonst wird Omar nochmal kurz gegen Dich antreten. "
             "Ganz kurz nur ...");
  command_me("grins /fies");
  call_out("aseq5", 2);
}
int aseq5()
{
  command_me("sag Und jetzt Verschwinde schon!"); 
  SetProp(P_NOATTACK, 0);
}