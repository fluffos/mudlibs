#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Margyl");
  SetProp(P_LONG,
    "Die Mischung eines Gargoyles und eines Drachen. Ein Margyl ist "
    "wesentlich groesser und gefaehrlicher als ein Gargoyle. Seine Augen "
    "leuchten Dich blau an."
  );
  SetProp(P_NAME, ({"Margyl", "Margyls", "Margyl", "Margyl"}));
  SetProp(P_GENDER, MALE);
  AddId(({"margyl", "NOWIMPY", "\nmargyl"}));
  AddClass( ({"flying"}) );
  SetProp(P_ARTICLE, 1);
  create_default_npc(19);
  SetProp(P_HANDS, ({" mit seinen steinernen Krallen"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })
  );
  SetProp(P_RACE, "Margyl");
  SetProp(P_SIZE, 250);
  SetProp(P_WEIGHT, 285763);
  SetProp(P_ALIGN, 400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 5);
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann sowas nicht.\n" }) );
  SetProp(P_MSGIN, "flattert heran");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_DIE_MSG,  " zerbroeckelt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Margyl");
  AddInfo(DEFAULT_INFO, "spricht sicherlich nicht Deine Sprache.\n");
  AddInfo("delgo", " kreischt."," ");
  SetChats(3,
  ({Name(WER, 1)+" flattert.\n"
   ,Name(WER, 1)+" kreischt ohrenbetaeubend.\n"
   })
  );

  SetAttackChats(10,
  ({Name(WER, 1)+" kratzt Dich!\n"
   ,Name(WER, 1)+" beisst Dich!\n"
   })
  );

}
