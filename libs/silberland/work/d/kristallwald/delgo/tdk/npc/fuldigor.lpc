#include "../def.h"

inherit "/p/std/dragons/dragon";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Fuldigor der Feuerdrache");
  SetProp(P_LONG,
    "Fuldigor der legendaere Feuerdrache, der sich aus der Lava erhob "
    "und das Feuer beherrscht. Seine schwarze Haut ist durchsetzt mit "
    "blutroten Adern. Aus seinem Maul kommen in regelmaessigen Abstaenden "
    "Feuerwolken und seine gluehenden Augen beobachten alles hier im Raum. "
  );
  SetProp(P_NAME, "Fuldigor");
  SetProp(P_GENDER, MALE);
  AddId(({"fuldigor", "drache", "feuerdrache"}));
  AddClass( ({ "drache", "flying"}) );
  create_default_dragon(4, 4, 2, 20); 
  SetProp(P_ARTICLE, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" braucht nichts von Dir.\n" }) );
  SetProp(P_MSGIN, "schnaubt aergerlich");
  SetProp(P_MSGOUT, "blaesst eine Feuerwolke");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_DIE_MSG,  " faellt zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Fuldigor");
  AddInfo(DEFAULT_INFO, "versteht Dich nicht.\n");
  AddInfo("delgo", "Delgo gab mir die Macht.","sagt: ");
  SUID;
  CLONEME(ARMOUR "schwingen");
  //CLONEME(WEAPON "lavaaxt"); - Balance hats rausgeworfen
  
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
      +" killt " + name(WEN, 1) + ".\n");
  TDKMASTER->Msg(""+TPN+" hat gerade Fuldigor umgebracht", 2);
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        ctime()+": " + Name(WER, 1) + " hat gerade " + CAP(getuid(player))
        +" umgebracht.\n");
  }
  ::NotifyPlayerDeath();
}

