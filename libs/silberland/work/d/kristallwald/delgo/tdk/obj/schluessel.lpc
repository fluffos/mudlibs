#include "../def.h"
inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Mithrilschluessel");
  SetProp(P_LONG,
    "Ein einfacher Schluessel aus Mithril. Omar aus Avir hat ihn mit seinem "
    "Leben bewacht."
  );
  SetProp(P_NAME, "Mithrilschluessel");
  SetProp(P_GENDER, MALE);
  AddId(({"mithrilschluessel", "schluessel"}));
  SetProp(P_MATERIAL, MAT_MITHRIL );
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE, 20);
  SetProp(P_VALUE, 800);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  
}

string QueryDoorKey()
{
       return ROOM"e7_1:"ROOM"magier";
}
