#include "../def.h"
inherit "std/thing";
#include "/secure/config.h"
#include <language.h>

int fs;

/*fortschritt: (da chronologisch vorgeschrieben mit einer var machbar)
0: Quest begonnen 
1: Benran besiegt
2: Urstam besiegt
3: Junth besiget
4: Eralth besiegt
5: Magier besiegt*/

create() {
  if (!is_clone(TO)) return;
  
  ::create();
  
  SetProp(P_SHORT, 0 );
  SetProp(P_LONG,  0 );
  SetProp(P_NAME, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( "\nwaffen_quest" );
  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  fs=0;
  AddCmd( ({"forder", "fordere"}), "fordern");
}
int fordern(string cmd)
{
  object ob;
  string *s;
  
  notify_fail("Wenn willst Du herausfordern?\n");
  //if(cmd="") return 0;
  //"/d/kristallwald/delgo/tdk/room/axt"
  //  0    1           2    3   4    5 
  s=explode(file_name(ENV(TP)), "/");
  if(cmd=="benran" && s[5]=="axt")
  {
    if(fs!=0){TP->Message("Das ist nicht dein naechster Gegner.\n"); return 1;}
    
    TP->Message(BS("Benran nimmt die Herausforderung an und ihr geht "
                   "in den Arenaraum.\n"));
    TP->move(ROOM "arena:"+getuid(TP), M_GO|M_SILENT);
    ob=clone_object(NPC "benran");
    ob->move(ROOM "arena:"+getuid(TP), M_GO);
    ob->SetProp(P_NOATTACK, 0);
    ob->Kill(TP);
    return 1;
  }
  if(cmd=="urstam" && s[5]=="ketten")
  {
    if(fs!=1){TP->Message("Das ist nicht dein naechster Gegner.\n"); return 1;}
    
    TP->Message(BS("Urstam nimmt die Herausforderung an und ihr geht "
                   "in den Arenaraum.\n"));
    TP->move(ROOM "arena:"+getuid(TP), M_GO|M_SILENT);
    ob=clone_object(NPC "urstam");
    ob->move(ROOM "arena:"+getuid(TP), M_GO);
    ob->SetProp(P_NOATTACK, 0);
    ob->Kill(TP);
    return 1;
  }
  if(cmd=="junth" && s[5]=="hellebarde")
  {
    if(fs!=2){TP->Message("Das ist nicht dein naechster Gegner.\n"); return 1;}
    
    TP->Message(BS("Junth nimmt die Herausforderung an und ihr geht "
                   "in den Arenaraum.\n"));
    TP->move(ROOM "arena:"+getuid(TP), M_GO|M_SILENT);  
    ob=clone_object(NPC "junth");
    ob->move(ROOM "arena:"+getuid(TP), M_GO);
    ob->SetProp(P_NOATTACK, 0);
    ob->Kill(TP);
    return 1;
  }
  if(cmd=="erthal" && s[5]=="hammer")
  {
    if(fs!=3){TP->Message("Das ist nicht dein naechster Gegner.\n"); return 1;}
    
    TP->Message(BS("Erthal nimmt die Herausforderung an und ihr geht "
                   "in den Arenaraum.\n"));
    TP->move(ROOM "arena:"+getuid(TP), M_GO|M_SILENT);
    ob=clone_object(NPC "erthal");
    ob->move(ROOM "arena:"+getuid(TP), M_GO);
    ob->SetProp(P_NOATTACK, 0);
    ob->Kill(TP);
    return 1;
  }
  if(cmd=="aulin" && s[5]=="magier")
  {
    if(fs!=4){TP->Message("Das ist nicht dein naechster Gegner.\n"); return 1;}
    
    TP->Message(BS("Aulin nimmt die Herausforderung an und ihr geht "
                   "in den Arenaraum.\n"));
    TP->move(ROOM "arena:"+getuid(TP), M_GO|M_SILENT);
    ob=clone_object(NPC "aulin");
    ob->move(ROOM "arena:"+getuid(TP), M_GO);
    ob->SetProp(P_NOATTACK, 0);
    ob->Kill(TP);
    return 1;
  }
  return 0;
}
int QueryFs()
{return fs;}

void Set0()
{fs=0; return;}

void Set1()
{fs=1; return;}

void Set2()
{fs=2; return;}

void Set3()
{fs=3; return;}

void Set4()
{fs=4; return;}

void Set5()
{fs=5; return;}