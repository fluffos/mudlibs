/*
 * Blaue Fackel
 * Delo@SL
 * Altes FUEL von 2000 und durch id "\nzechpreller_anhauch_fackel" 
 * erhoehter Schaden fuer Zechis.
 */

inherit "/std/lightsource";
#include "../def.h"
#include <properties.h>
#include <lightsource.h>
#include <language.h>

void create()
{
  if(!is_clone(this_object()))
    return;

  ::create();
  AddId("fackel", "\nzechpreller_anhauch_fackel");
  //mit Gildenmagier Zechpreller abgesprochen, er stellt es bei sich in die 
  //Balance
  SetProp(P_NAME,"Fackel");
  SetProp(P_GENDER,FEMALE);
  SetProp(P_SHORT,"Eine blaue Fackel");
  SetProp(P_LONG,
      "Du siehst vor Dir eine Fackel. Ihr Holz weist eine blaue Faerbung "
      "auf. Man kann sie anzuenden und wieder loeschen.\n");
  SetProp(P_VALUE, 50);
  SetProp(P_WEIGHT, 1200);
  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_ARTICLE, 1);
  SetProp(P_FUEL, 2000);
  SetProp(P_LIGHTDESC,
      ({ "glimmend","flackernd","leicht flackernd","brennend",
         "hell lodernd","frisch angezuendet" }) );
  SetProp(P_INFO,
    "Diese Feuer dieser Fackel macht bei richtiger Anwendung mehr Schaden. "
    "Nuetzlich fuer Zechpreller?");
}

