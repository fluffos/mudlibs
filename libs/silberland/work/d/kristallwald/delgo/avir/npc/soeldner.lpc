/*
5 verschieden SoelnderTypen, den eine Soeldner Armee ist nie so gleich ausgestattet, ausgebildet und trainiert wie ein Heer
*/
#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
int 		level, spellrate, spellrate_1, spellrate_2, spellrate_3, spellpower;
int    	weight, size;
string 	weapon, armour, helm, weapon_z;
  
  if (!is_clone(this_object())) return;
  ::create();
  
  switch(1+random(5))
  {
    case 1: //Der nromale SchwertSoeldner, oft zu treffen! Deswegen schwach.
      level = 15;
      weight = 70000+random(20000);
      size = 170+random(30);
      spellrate = 15;
      spellpower = 40;
      AddId( ({"Schwertkaempfer"}) );
      spellrate_1 = 2;
      spellrate_2 = 1;
      spellrate_3 = 0;
      weapon = "/p/weapon/sword/langschwert";
      weapon_z = "zuecke schwert";
      armour = "/p/armour/armour/eisenpanzer";
      helm = "/p/armour/helm/lederhelm";
      break;

    case 2:  //Ein rauher AxtSoeldner, haeufig! Deswegen maessig.
      level = 18;
      weight = 75000+random(25000);
      size = 175+random(35);
      spellrate = 20;
      spellpower = 65;
      spellrate_1 = 2;
      spellrate_2 = 1;
      spellrate_3 = 0;
      AddId( ({"Axtkaempfer"}) );
      weapon = "/p/weapon/axe/kriegsbeil";
      weapon_z = "zuecke beil";
      armour = "/p/armour/armour/eisenpanzer";
      helm = "/p/armour/helm/lederhelm";
      break;

    case 3:  //Ein KettenSoeldner, schon nicht so oft! Deswegen 
    				//durchschnittlich.
      level = 21;
      weight = 70000+random(18000);
      size = 180+random(10);
      spellrate = 30; //machen schon sehr viele Tricks mit Kettenwaffen!
      spellpower = 80; //mit schwung haun die richtig rein!
      spellrate_1 = 3;
      spellrate_2 = 2;
      spellrate_3 = 1;
      AddId( ({"Kettenkaempfer"}) );
      weapon_z = "zuecke dreschflegel";
      weapon = "/p/weapon/chain/dreschflegel";
      armour = "/p/armour/armour/kettenhemd";
      helm = "/p/armour/helm/kettenhaube";
      break;

    case 4: //HellebardenSoeldner sind gesucht! Deswegen stark.
      level = 24;
      weight = 65000+random(25000);
      size = 195+random(25);// Die sind lang :)
      spellrate = 25;
      spellpower = 100;
      spellrate_1 = 3;
      spellrate_2 = 2;
      spellrate_3 = 1;
      AddId( ({"Speerexperte"}) );
      weapon_z = "zuecke hellebarde";
      weapon = "/p/weapon/spear/hellebarde";
      armour = "/p/armour/armour/kettenhemd";
      helm = "/p/armour/helm/kettenhaube";
      break;

    default:
      level = 25; // Ein HammerSoeldner ist sehr selten! Deswegen sehr stark.
      weight = 10000+random(30000);
      size = 185+random(15);
      spellrate = 20;
      spellpower = 160;
      spellrate_1 = 4;
      spellrate_2 = 3;
      spellrate_3 = 2;
      AddId( ({"keulenexperte"}) );
      weapon_z = "zuecke hammer";
      weapon = "/p/weapon/club/kriegshammer";
      armour = "/p/armour/armour/titanpanzer";
      helm = "/p/armour/helm/kettenhaube";
      break;

}

  SetProp(P_SHORT, "Ein avirischer Soeldner");
  SetProp(P_LONG, "Vor Dir steht ein ungepflegter und unrasierter Soeldner "
  	"von Avir. Dieses Soeldnerpack ist laut, ungehobelt und absolut "
  	"goldgierig. Man vermutet sie eher in einer Hafenkneipe, aber der "
  	"Buergermeister wird schon wissen was er tut...");
  SetProp(P_NAME, "Soeldner");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  AddId( ({"soeldner", "NOWIMPY"}) );
  create_default_npc(level);
  SetProp(P_HANDS, ({" mit blossen Haenden ",QueryProp(P_HANDS)[1],
                     DT_BLUDGEON}));
  SetProp(P_ALIGN, -200 - random(500) ); //Kein soeldner ist wirklich gut :)
  SetProp(P_RACE, "Mensch");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_WEIGHT, weight);
  SetProp(P_SIZE, size);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC, 30);
  SetProp(P_REJECT, ({ REJECT_DROP,
    "Der Soeldner laesst sich nicht von Dir ablenken.\n" }) );
  SetChats(3,
  ({Name(WER, 10)+" lacht ueber einen dreckigen Witz.\n"
   ,Name(WER, 1)+" spuckt auf den Boden.\n"
   ,Name(WER, 15)+" groehlt herum.\n"
   })
  );
  SetProp(P_MSGIN, "kommt heran");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht woanders hin");
  SetProp(P_DIE_MSG,  " stuerzt mit einem Schmerzensschrei zu Boden.\n");

  AddDetail( ({"haare","frisur"}),
    "Die Haare sind militaerisch kurz geschnitten. Die Haarfarbe ist dunkel.");

  AddDetail( ({"ohren","ohr"}),
    "Er lauscht nebenbei mit seinen Ohren in alle Richtungen.");
  
  AddDetail( ({"nase"}),
    "Dir faellt an der Nase nichts auf.");
    
  AddDetail( ({"gesicht"}),
    "Das Gesicht hat schon einiges miterlebt.");
        
  AddDetail( ({"augen","auge", "pupillen"}),
    "Die Augen ueberwachen aufmerksam die Umgebung.");
    
  AddDetail( ({"haut"}),
    "Die Haut ist braungebrannt, er hat scheinbar viel Dienst draussen.");
    
  AddDetail( ({"lippen", "mund", "lippe"}),
    "Der Mann murmelt leise vor sich hin.");
    
  AddDetail( ({"koerper"}),
    "Der Mann haelt sich fit, wie Du an dem durchtrainierten Koerper siehst.");
    
  AddDetail( ({"kleidung"}),
    "Die Unterkleidung waermt den Mann, bei seinem Dienst.");
    
  AddInfo(DEFAULT_INFO, 
    ({"weiss leider keine Antwort.\n",
      "kann Dir da nicht weiterhelfen.\n" }) );
  AddInfo("delgo", "Er ist bei uns bekannt.","sagt: ");
  
  AddInfo( ({"waffe","waffen"}) , "Ich habe den Umgang mit Waffen recht gut "
     "erlernt."
    ,"sagt: ");
    
  AddInfo( ({"ausbildung","vergangenheit"}) ,"Das war hart, aber ich moechte "
     "nicht darueber reden.."
    ,"sagt: ");
    
  AddInfo( ({"auftrag","aufgabe"}) , "Das wechselt taeglich."
    ,"sagt: ");
    
  AddInfo( ({"arbeit","leben"}) , "Sicher gibt es sichere Arbeit aber naja, "
     "was soll man machen?"
    ,"sagt: ");
    
  AddInfo( ({"tod","sterben"}) ,"Wenn es sein muss."
    ,"sagt: ");

  SetProp(P_SPELLRATE,spellrate);
  
  AddSpell(spellrate_1,150+spellpower,
    Name()+" taeuscht Dich mit einer Finte!\n",
    Name()+" taeuscht @WEN mit einer Finte!\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));
  AddSpell(spellrate_2,300+spellpower,
    Name()+" schleudert Dich mit einem Rueckhandhieb zu Boden!\n",
    Name()+" schleudert @WEN mit einem Rueckhandhieb zu Boden!\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));
  AddSpell(spellrate_3,450+spellpower,
    "Der Soeldner springt hoch und vernichtet Dich mit einem gewaltigen "
    "Hieb!\n",
    "Der Soeldner springt hoch und vernichtet @WEN mit einem gewaltigen "
    "Hieb!\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));

  SUID;
  CLONEME( weapon );
  CLONEME( armour );
  CLONEME( helm );
  command("trage alles");
  command( weapon_z );

}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt einen Soeldner.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Ein Soeldner hat gerade "+CAP(getuid(player))+
      " umgebracht.\n");
}

void angriff(object pl)
{
  string shouter;

  if(!ENV(TO))           return;
  if(!ENV(pl))           return;
  if(!interactive(pl))   return;
  if(ENV(TO) != ENV(pl)) return;
  Kill(pl);

  return;
}

void init()
{
  ::init();

  if(!TP)                        return;
  if(!interactive(TP))           return;
  if(TP->QueryProp(P_GHOST))     return;
  if(!AVIRMASTER->IsEnemy(TP))   return;

  call_out("angriff", 0, TP);
}

int filter(object ob)
{
  if(ob == TO) return 0;
  if(!(ob->id("soeldner"))) return 0;
  return 1;
}
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  object *ob;
  int i;
  
  if(!InFight())
  {
    if(objectp(ENV(TO)))
    {
      //DBR("passt");
      AVIRMASTER->AddEnemy(enemy);
      ob=filter_array(all_inventory(ENV(TO)), "filter");
      if(sizeof(ob)>0)
      { for(i=0;i<sizeof(ob);i++) { ob[i]->Kill(enemy); } }
      call_other( ROOM "e1-c3-tor", "close_gate", 0);
    }
  }
  return ::Defend(dam, dam_type, spell, enemy);
}
