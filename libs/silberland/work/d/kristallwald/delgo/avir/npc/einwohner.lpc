  SetProp(P_SHORT, name_short);
  SetProp(P_LONG, des_long);
  SetProp(P_NAME, name);
  SetProp(P_GENDER, gender);
  SetProp(P_ARTICLE, 1);
  AddId( ({gender_id}) );
  create_default_npc(level);
  SetProp(P_HANDS, ({" mit blossen Haenden ",QueryProp(P_HANDS)[1],
                     DT_BLUDGEON}));
  SetProp(P_ALIGN, 250 + random(750) );
  SetProp(P_RACE, "Mensch");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_WEIGHT, weight);
  SetProp(P_SIZE, size);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 30);
  SetProp(P_NOMAGIC, 2);
  SetProp(P_REJECT, ({ REJECT_DROP,
    "Warum drehst Du den Leuten sowas an?.\n" }) );
  SetChats(3,
  ({Name(WER, 10)+""+chat_1+"\n"
   ,Name(WER, 1)+""+chat_2+"\n"
   ,Name(WER, 15)+""+chat_3+"\n"
   })
  );

  SetProp(P_MSGIN, in);
  SetProp(P_MSGOUT, out);
  SetProp(P_MMSGIN, in);
  SetProp(P_MMSGOUT, out);
  SetProp(P_DIE_MSG,  " stuerzt mit einem Schrei zu Boden.\n");
  AddInfo("delgo", "Delgo ist mein "+delgo+".","sagt ehrfuerchtig: ");
  AddLibrary(NPC "penner.lib", 1);
  AddLibrary(NPC "avir.lib", 1);
  
  SetProp(P_MNPC_AREA, ({  ROOM "e1"}) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "e1-e3-park");
  SetProp(P_MNPC_WAIT, ({ 45, 35, 15 }));
  SetProp(P_MNPC_FLAGS, 
  				MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);
 

  SUID;
  CLONEME( weapon );
  command(weapon_z);
  
}

void die(int poisondeath) {
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer == ME)
    write_file(LOG "npc.deads",
    	ctime()+": Ein Einwohner hat gerade "+CAP(getuid(player))+
    	"umgebracht.\n");
}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;
  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "beachtet Dich nicht.",
        "beachtet @WEN nicht.");
    break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "brummt: Verschwinde!",
        "brummt: Verschwinde!");
    break;

    case "albern":
      call_out("reaction", 0, TP,
        "schuettelt nur den Kopf.",
        "schuettelt nur den Kopf.");
    break;

    case "fies":
      call_out("reaction", 0, TP,
        "murmelt etwas.",
        "murmelt etwas.");
    break;

    case "frech":
      call_out("reaction", 0, TP,
        "grummelt: Lass mich in Ruhe!",
        "grummelt: Lass mich in Ruhe @WER!");
    break;

    case "froh":
      call_out("reaction", 0, TP,
        "laechelt.",
        "laechelt.");
    break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Geh woanders spielen und lass die Erwachsenen arbeiten.",
        "sagt zu @WEM: Geh woanders spielen und lass die Erwachsenen "
        "arbeiten.");
    break;

    case "nett":
      call_out("reaction", 0, TP,
        "laechelt.",
        "laechelt.");
    break;

    case "neutral":
      call_out("reaction", 0, TP,
        "summt eine Melodie.",
        "summt eine Melodie.");
    break;

    case "traurig":
      call_out("reaction", 0, TP,
        "bemitleidet Dich.",
        "bemitleidet Dich.");
    break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;
  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}