#include "../def.h"


inherit "std/mnpc";
inherit "/std/npc/spells";


void create()
{
int level, weight, size;
mixed weapon, weapon_z, gender, gender_id, name, name_short, delgo, in, out;
mixed des_long, chat_1, chat_2, chat_3;
  
  if (!is_clone(this_object())) return;
  ::create();
  
  switch(1+random(3))
  {
    case 1: 
      level = 9;
      weight = 60000+random(20000);
      size = 150+random(30);
      weapon = "/p/weapon/sword/kurzschwert";
      weapon_z = "zuecke schwert";
      gender = MALE;
      gender_id = "einwohner";
      name = "Einwohner";
      name_short = "Ein Einwohner Avirs";
      delgo = "Vater";
      in = "spaziert herein";
      out = "spaziert";
      des_long = "Vor Dir steht ein ganz typischer Einwohner von Avir. Er " 		
      "hat die Ruhe weg und nimmt sich Zeit fuer seine Geschaefte. Fuer ihn " 
      "ist Avir ein ruhiges Fleckchen Erde.";
      chat_1 = " gruebelt ueber etwas nach.";
      chat_2 = " laechelt Dich an.";
      chat_3 = " laesst sich Zeit.";

  AddDetail( ({"ruhe","zeit", "geschaefte"}),
    "Frag ihn doch danach.");
    
  AddDetail( ({"fleckchen","erde"}),
    "Also seine Kleidung ist sauber.");

  AddDetail( ({"haare","frisur"}),
    "Die Haare sind kurz geschnitten und von dunkelblonder Faerbung.");

  AddDetail( ({"ohren","ohr"}),
    "Die Ohren sind typische Menschenohren.");
  
  AddDetail( ({"nase"}),
    "Die Nase sitzt bei dem Mann mitten im Gesicht.");
    
  AddDetail( ({"gesicht"}),
    "Ein Allerweltsgesicht, der Mann beachtet Dich kaum.");
        
  AddDetail( ({"augen","auge", "pupillen"}),
    "Ruhige und guetige Augen schauen Dich kurz an.");
    
  AddDetail( ({"haut"}),
    "Die Haut ist leicht braungebrannt von der Sonnne.");
    
  AddDetail( ({"lippen", "mund", "lippe"}),
    "Der mann laechelt Dich kurz an.");
    
  AddDetail( ({"koerper"}),
    "Der Mann geht aufrecht und Du kannst keine besonderen Merkmale "
    "entdecken.");
    
  AddDetail( ({"kleidung"}),
    "Dir faellt an der Kleidung des Mannes nichts besonderes auf.");
  
  AddInfo(DEFAULT_INFO, 
    ({"laechelt Dich nur nett an.\n",
      "wird Dir darueber nichts sagen.\n" }) );
  
  AddInfo( ({"leben", "lauf"}) , "Das Leben nimmt halt so seinen Lauf."
    ,"sagt: ");
    
  AddInfo( ({"alter"}) , "Das geht Dich nichts an."
    ,"sagt laechelnd: ");
    
  AddInfo( ({"arbeit"}) , "Ja, ich arbeite hier in der Gegend."
    ,"sagt: ");
    
  AddInfo( ({"gegend","stadt"}) , "Hier zu Leben und zu arbeiten ist ganz "
    "angenehm."
    ,"sagt: ");
    
  AddInfo( ({"gebiet","hilfe", "avir"}) ,  "Du bist hier in Avir."
    ,"sagt: ");

  AddInfo( ({"geschaefte"}) , "Hier in Avir gibt es zwei groessere "
    "Geschaefte."
    ,"sagt: ");    
    
  AddInfo( ({"ruhe", "zeit"}) , "Ich habe es heute nicht so eilig."
    ,"sagt: ");

      break;

    case 2:  
      level = 11;
      weight = 65000+random(25000);
      size = 150+random(30);
      weapon = "/p/weapon/sword/florett";
      weapon_z = "zuecke florett";
      gender = MALE;
      gender_id = "einwohner";
      name = "Einwohner";
      name_short = "Ein Einwohner Avirs";
      delgo = "Vater";
      in = "eilt herein";
      out = "eilt";
      des_long = "Vor Dir steht ein ganz typischer Einwohner von Avir. Er "
      "hat anscheinen gerade etwas zu tun. Fuer ihn ist Avir seine Heimat und"
      " Herkunft.";
      chat_1 = " rechnet etwas nach.";
      chat_2 = " sucht einen Kraeuterladen.";
      chat_3 = " freut sich seines Lebens.";

  AddDetail( ({"heimat","herkunft"}),
    "Diese Stadt ist sein Zuhause.");
      
  AddDetail( ({"haare","frisur"}),
    "Die Haare sind kurz geschnitten und von dunkelblonder Faerbung.");

  AddDetail( ({"ohren","ohr"}),
    "Die Ohren sind typische Menschenohren.");
  
  AddDetail( ({"nase"}),
    "Die Nase sitzt bei dem Mann mitten im Gesicht.");
    
  AddDetail( ({"gesicht"}),
    "Ein allerweltsgesicht, der Mann beachtet Dich kaum.");
        
  AddDetail( ({"augen","auge", "pupillen"}),
    "Ruhige und guetige Augen schauen Dich kurz an.");
    
  AddDetail( ({"haut"}),
    "Die Haut ist leicht braungebrannt von der Sonnne.");
    
  AddDetail( ({"lippen", "mund", "lippe"}),
    "Der mann laechelt Dich kurz an.");
    
  AddDetail( ({"koerper"}),
    "Der Mann geht aufrecht und Du kannst keine besonderen Merkmale "
    "entdecken.");
    
  AddDetail( ({"kleidung"}),
    "Dir faellt an der Kleidung des Mannes nichts besonderes auf.");
  
  AddInfo(DEFAULT_INFO, 
    ({"laechelt Dich nur nett an.\n",
      "wird Dir darueber nichts sagen.\n" }) );
  
  AddInfo( ({"leben", "lauf"}) , "Das Leben nimmt halt so seinen Lauf."
    ,"sagt: ");
    
  AddInfo( ({"alter"}) , "Das geht Dich nichts an."
    ,"sagt laechelnd: ");
    
  AddInfo( ({"arbeit"}) , "Ich habe heute gut zu tun."
    ,"sagt: ");
    
  AddInfo( ({"gegend","stadt"}) , "Hier zu Leben und zu arbeiten ist ganz "
     "angenehm."
    ,"sagt: ");
    
  AddInfo( ({"gebiet","hilfe", "avir"}) , "Du bist hier in Avir."
    ,"sagt: ");  
    
  AddInfo( ({"heimat", "herkunft"}) , "Du hast Recht, ich wohne und arbeite "
     "hier."
    ,"sagt: ");     
      
      break;

    default:
      level = 10; 
      weight = 45000+random(30000);
      size = 155+random(15);
      weapon = "/p/weapon/sword/degen";
      weapon_z = "zuecke degen";
      gender = FEMALE;
      gender_id = "einwohnerin";
      name = "Einwohnerin";
      name_short = "Eine Einwohnerin Avirs";
      in = "schlendert herein";
      out = "schlendert";
      delgo = "Mann";
      des_long = "Die gutaussehende Frau vor Dir ist eine huebsche "
      "Einwohnerin von Avir. Sie schlendert ganz in Ruhe durch die Strassen"
      ", um ihre Einkaeufe zu erledigen. Die Leute scheinen gern in Avir zu "
      "wohnen.";
      chat_1 = " singt ein froehliches Lied.";
      chat_2 = " taenzelt ein paar Schritte.";
      chat_3 = " schwingt ihren Rock hin und her.";
  AddDetail( ({"ruhe","einkaeufe"}),
    "Sie hat die Ruhe weg. Beeindruckend.");
  AddDetail( ({"haare","frisur"}),
    "Die rotblonden Haare sind gut gepflegt und reichen bis zur Schulter.");

  AddDetail( ({"ohren","ohr"}),
    "Die Ohren sind durch die Haare verdeckt.");
  
  AddDetail( ({"nase"}),
    "Die kleine Nase sitzt mitten im Gesicht.");
    
  AddDetail( ({"gesicht"}),
    "Es ist recht huebsch anzusehen. Hoffentlich bleibt das auch so.");
        
  AddDetail( ({"augen","auge", "pupillen"}),
    "Die Augen sind gruen und schauen dich frech an.");
    
  AddDetail( ({"haut"}),
    "Die Haut ist etwas bleich und gut gepflegt.");
    
  AddDetail( ({"lippen", "mund", "lippe"}),
    "Die Lippen sind roetlich geschminkt und singen eine leise Melodie.");
    
  AddDetail( ({"koerper"}),
    "An dem Koerper ist nichts auszusetzen, die Frau scheint Sport zu "
    "machen.");
    
  AddDetail( ({"kleidung"}),
    "Dir faellt da nichts auf.");
  
  AddInfo(DEFAULT_INFO, 
    ({"hat Dich gar nicht gehoert.\n",
      "zuckt unwissend mit den Schultern.\n" }) );
  
  AddInfo( ({"arbeit"}) , "Ich arbeite hier in der Naehe."
    ,"sagt: ");
    
  AddInfo( ({"leben","alter"}) ,"Das geht dich nichts an ;-)"
    ,"kichert: ");
    
  AddInfo( ({"umgebung","stadt"}) , "ich wohne hier, aber ich verrate Dir "
    "nicht wo." ,"sagt: ");
    
  AddInfo( ({"ruhe","einkaeufe"}) ,"Hetzen macht da keinen Sinn."
    ,"sagt: ");
    
  AddInfo( ({"gebiet","hilfe"}) , "Du bist hier in Avir."
    ,"sagt: ");
   AddInfo(DEFAULT_INFO, 
    ({"laechelt Dich nur nett an.\n",
      "wird Dir darueber nichts sagen.\n" }) );
      break;
