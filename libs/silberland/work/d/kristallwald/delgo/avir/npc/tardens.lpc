
#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create(); 


  SetProp(P_SHORT, "Tardens, der Meister der Waffen");
  SetProp(P_LONG,
    "Vor Dir steht Tardens, der Meister aller Waffen. Man munkelt, dieser "
    "Mensch habe es geschafft, alle Waffen zu meistern. Wundern wuerde es "
    "Dich nicht, bei diesem Huehnen. Aber wenn er tatsaechlich Eigentuemer "
    "dieses Ladens ist, hatte er wohl wirklich viel Zeit, mit den Waffen zu "
    "trainieren. Er macht zwar einen freundlichen Eindruck, aber angreifen "
    "wuerde ich ihn trotzdem nicht."
  );
  SetProp(P_NAME, "Tardens");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"Axtmeister", "axtmeister", "haendler", "tardens"}));
  SetProp(P_ARTICLE, 0);
	create_default_npc(30);
	SetProp(P_HANDS, ({" mit blossen Haenden", 1, DT_BLUDGEON }));
	SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 210);
  SetProp(P_WEIGHT, 95345);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" braucht nichts von Dir.\n" }) );
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      -0.5, DT_COLD:      0.1, DT_SOUND:     -0.3
     , DT_HOLY:      -0.3, DT_UNHOLY:    0.2]));
  SetProp(P_MSGIN, "will Dir etwas verkaufen");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Tardens");
  SetProp(P_KILL_MSG, "Haettest Du mal lieber eine Waffe gekauft!");
  
  AddDetail( ({"haare","frisur"}),
    "Die Haare sind kurz geschnitten und von dunkelblonder Faerbung.");

  AddDetail( ({"ohren","ohr"}),
    "Die Ohren sind typische Menschenohren.");
  
  AddDetail( ({"nase"}),
    "Die Nase sitzt bei Tardens mitten im Gesicht.");
    
  AddDetail( ({"gesicht"}),
    "Tardens Gesicht ist eigentlich recht freundlich.");
        
  AddDetail( ({"augen","auge", "pupillen"}),
    "Ruhige und guetige Augen schauen Dich kurz an.");
    
  AddDetail( ({"haut"}),
    "Die Haut ist leicht braungebrannt von der Sonnne.");
    
  AddDetail( ({"lippen", "mund", "lippe"}),
    "Tardens laechelt Dich kurz an.");
    
  AddDetail( ({"koerper", "huehne"}),
    "Tardens ist eine Huehne.");
    
  AddDetail( ({"kleidung"}),
    "Dir faellt an der Kleidung Tardens' nichts besonderes auf.");
  
  AddInfo(DEFAULT_INFO, 
    ({"laechelt Dich nur nett an.\n",
      "wird Dir darueber nichts sagen.\n" }) );
  AddInfo("delgo", "Den Namen habe ich schonmal gehoert.","sagt: ");
  
  AddInfo( ({"leben", "lauf"}) , "Das Leben nimmt halt so seinen Lauf."
    ,"sagt: ");
    
  AddInfo( ({"alter"}) , "Das geht Dich nichts an."
    ,"sagt laechelnd: ");
    
  AddInfo( ({"arbeit"}) , "Du kannst hier Waffen kaufen."
    ,"sagt: ");
    
  AddInfo( ({"gegend","stadt"}) ,"Hier zu Leben und zu arbeiten ist ganz "
    "angenehm."
    ,"sagt: ");
    
  AddInfo( ({"waffen"}),
    "Meine Soehne und ich verkaufen alle Arten von Waffen.",
    "sagt: ");
 	AddInfo( ({"soehne"}),
    "Sie helfen mir in der Woche beim Verkauf, waehrend ich neue Waffen "
    "besorge. Sie reparieren auch kaputte Waffen.",
    "sagt stolz: ");
 	AddInfo("soeldner", "Da muesst Ihr den Buergermeister fragen.", "sagt: ");
 	AddLibrary(NPC "penner.lib", 1);
  AddLibrary(NPC "avir.lib", 1);
  SetChats(3,
  ({Name(WER, 10)+" sagt: Wir haben hier alle Waffen.\n"
   ,Name(WER, 1)+" laechelt dich an.\n"
   ,Name(WER, 15)+" fragt: Willst Du nicht eine Waffe kaufen?\n"
   })
  );
  SetAttackChats(10,
  ({Name(WER, 1)+" sagt: Verschwinde so lange es noch geht!\n"
   ,Name(WER, 1)+" sagt: Gleich habe ich Dich, Du Wurm!\n"
   })
  );
  SUID;
  CLONEME("/p/weapon/axe/kriegsbeil" );
  command("zuecke beil");
  CLONEME("/p/armour/armour/kettenhemd" );
  CLONEME("/p/armour/boots/kampfstiefel" );
  command("trage alles");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt Tardens.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))+
      " umgebracht.\n");
  }
}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;
  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "lacht Dich aus.",
        "lacht @WEN aus.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "brummt: Verschwinde!",
        "brummt: Verschwinde!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "schuettelt nur den Kopf.",
        "schuettelt nur den Kopf.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "lacht Dich nur aus.",
        "lacht @WEN nur aus.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "grummelt: Lenk mich nicht ab!",
        "grummelt: Lenk mich nicht ab @WER!");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich freundlich an.",
        "laechelt @WEN freundlich an.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Geh woanders spielen und lass die Erwachsenen arbeiten.",
        "sagt zu @WEM: Geh woanders spielen und lass die Erwachsenen "
        "arbeiten.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "fragt freundlich: Was wollt Ihr?",
        "fragt freundlich: Was wollt Ihr?");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        "(t)roestet @WEN.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;
  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}