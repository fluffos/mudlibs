
#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create(); 

  SetProp(P_SHORT, "Torrenz, Sohn des Tardens'");
  SetProp(P_LONG,
    "Der juengste von Tardens Soehnen ist nicht ganz so froehlich wie sein "
    "Vater. Du schaffst es nicht, aus ihm irgendwas raus zu bekommen, und "
    "ueberhaupt hat die zierliche Gestalt hinter der Theke keine "
    "Aehnlichkeiten mit seinem Vater."
  );
  SetProp(P_NAME, "Torrenz");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"peitschenkaempfer", "Peitschenkaempfer", "haendler", "torrenz"}));
  SetProp(P_ARTICLE, 0);
	create_default_npc(15);
  SetProp(P_HANDS, ({" mit blossen Haenden", 1, DT_BLUDGEON }));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 155);
  SetProp(P_WEIGHT, 65804);
  SetProp(P_ALIGN, -400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,3);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 45);
  SetProp(P_NOMAGIC,0);
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" braucht nichts von Dir.\n" }) );
	SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_COLD:      -0.1, DT_WATER:       0.2, DT_LIGHT:      0.3
     , DT_HOLY:       0.1, DT_UNHOLY:     -0.2, ]));

  SetProp(P_MSGIN, "grummelt herein");
  SetProp(P_MSGOUT, "vergrummelt sich");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_DIE_MSG,  " kippt tot um.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Torrenz");

  AddDetail( ({"haare","frisur"}),
    "Die Haare sind pechschwarz und mehr oder weniger kurz.");

  AddDetail( ({"ohren","ohr"}),
    "Die Ohren werden von den haaren verdeckt.");
  
  AddDetail( ({"nase"}),
    "Du bemerkst nichts an der Nase.");
    
  AddDetail( ({"gesicht"}),
    "Torrenz versucht deinen Blicken auszuweichen.");
        
  AddDetail( ({"augen","auge", "pupillen"}),
    "Kleine Augen schauen sich regelmaessig um.");
    
  AddDetail( ({"haut"}),
    "Die Haut eher hell, Torrenz ist wohl nicht oft in der Sonne.");
    
  AddDetail( ({"lippen", "mund", "lippe"}),
    "Er presst angestrengt die Lippen aufeinander.");
    
  AddDetail( ({"koerper"}),
    "Torrenz laeuft leicht uebergebeugt und versucht unauffaellig zu "
    "wirken. Er ist sehr schmaechtig.");
    
  AddDetail( ({"kleidung"}),
    "Er traegt eher dunkle Kleidung.");
  
  AddInfo(DEFAULT_INFO, 
    ({"ignoriert Dich gekonnt.\n",
      "murmelt etwas Unverstaendliches.\n" }) );
  AddInfo("delgo", "Ich habe schon von ihm gehoert.","sagt: ");
  
  AddInfo( ({"arbeit","handwerk"}) , "Das geht Dich nichts an."
    ,"sagt: ");
    
  AddInfo( ({"leben","alter"}) ,"Ich lebe lang genug um zu wissen, dass "
     "ich nicht antworten muss."
    ,"sagt: ");
    
  AddInfo( ({"geschaeft","waffen"}) ,"Kauf was oder hau ab."
    ,"murmelt: ");
    
  AddInfo( ({"vater","bruder"}) ,"Komm einfach morgen wieder, dann habe ich"
     " frei."
    ,"sagt: ");
    
  AddInfo( ({"gebiet","hilfe", "avir"}) , "Du bist in Avir gelandet."
    ,"sagt: ");

  AddInfo("soeldner", "da muesst ihr den Buergermeister fragen.", "sagt: ");
  AddLibrary(NPC "penner.lib", 1);
  AddLibrary(NPC "avir.lib", 1);

  SetAttackChats(10,
  ({Name(WER, 1)+" sagt: Stoer mich nie wieder in meiner Ruhe!!\n"
   ,Name(WER, 1)+" sagt: Warum bin ich heute aufgestanden?\n"
   })
  );
  SUID;
  CLONEME("/p/weapon/whip/peitsche" );
  command("zuecke peitsche");

  CLONEME("/p/armour/cloak/umhang" );
  CLONEME("/p/armour/gloves/lederhandschuhe" );
  CLONEME("/p/armour/boots/lederstiefel" );
  command("trage alles");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;
  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "starrt nur apathisch vor sich hin.",
        "starrt nur apathisch vor sich hin.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "starrt nur apathisch vor sich hin",
        "starrt nur apathisch vor sich hin");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "starrt nur apathisch vor sich hin.",
        "starrt nur apathisch vor sich hin.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "starrt nur apathisch vor sich hin.",
        "starrt nur apathisch vor sich hin.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "starrt nur apathisch vor sich hin",
        "starrt nur apathisch vor sich hin");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "starrt nur apathisch vor sich hin.",
        "starrt nur apathisch vor sich hin.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Geh woanders spielen und lass die Erwachsenen arbeiten.",
        "sagt zu @WEM: Geh woanders spielen und lass die Erwachsenen "
        "arbeiten.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "starrt nur apathisch vor sich hin.",
        "starrt nur apathisch vor sich hin.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "starrt nur apathisch vor sich hin.",
        "starrt nur apathisch vor sich hin.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "starrt nur apathisch vor sich hin.",
        "starrt nur apathisch vor sich hin.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;
  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}