#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void
create()
{
  if( !is_clone(this_object()) ) return;
  ::create(); 

	SetProp(P_SHORT, "Der Buergermeister von Avir");
  SetProp(P_LONG,
    "Du siehst einen kleinen freundlichen Menschen vor Dir stehen. Nicht zu "
    "glauben, dass ein so unauffaelliger Mann die Geschicke Avirs steuert. " 
    "Das macht natuerlich haufenweise Arbeit, und so wuselt er zwischen den " 
    "Buechern hin und her. Warum sein Schreibtisch also so leer ist, "
    "verstehst Du nicht. Aber dafuer ist er ja auch der Buergermeister."
  );
  SetProp(P_NAME, "Buergermeister");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:100])); 
  //er  soll ja unkillbar sein, also darf er au net wegen nem ele frieren ^^
  AddId(({"buergermeister", "NOWIMPY", "nowimpy"}));
  SetProp(P_ARTICLE, 1);
  create_default_npc(30);
  SetProp(P_HANDS, ({" mit blossen Haenden", 1, DT_BLUDGEON }));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 145);
  SetProp(P_WEIGHT, 89211);
  SetProp(P_ALIGN, 800);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,8);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
 	SetProp(P_NOMAGIC,0);
  SetProp(P_NOATTACK, "hat schlicht und ergreifend keine Zeit fuer sowas.");
  SetProp( P_REJECT, ({ REJECT_DROP,
   	Name(WER,1)+" kann sich alles kaufen.\n" }) );
  SetProp(P_MSGIN, "war nur mal kurz weg");
 	SetProp(P_MSGOUT, "hat noch was zu tun");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_NOCORPSE, 0 );
  AddDetail( ({"haare","frisur"}),
    "Die Haare sind kurz geschnitten und von brauner Faerbung.");

  AddDetail( ({"ohren","ohr"}),
    "Die Ohren sind typische Menschenohren.");

  AddDetail( ({"nase"}),
    "Die Nase sitzt bei dem Mann mitten im Gesicht.");

  AddDetail( ({"gesicht"}),
    "Ein rundes Gesicht, der Mann beachtet Dich kaum.");

  AddDetail( ({"augen","auge", "pupillen"}),
    "Ruhige und guetige Augen schauen Dich kurz an.");

  AddDetail( ({"haut"}),
    "Die Haut ist leicht blaesslich.");

  AddDetail( ({"lippen", "mund", "lippe"}),
    "Der Mann laechelt Dich kurz an.");

  AddDetail( ({"koerper"}),
    "Der Mann geht aufrecht und Du kannst keine besonderen Merkmale "
    "entdecken.");

  AddDetail( ({"kleidung"}),
    "Dir faellt an der Kleidung des Mannes nichts besonderes auf.");

  AddInfo( ({"leben", "lauf"}) , "Das Leben nimmt halt so seinen Lauf."
    ,"sagt: ");

  AddInfo( ({"alter"}) , "Das geht Dich nichts an."
    ,"sagt laechelnd: ");

  AddInfo( ({"arbeit"}) ,"Ja, ich arbeite hier, ich bin der Buergermeister."
    ,"sagt: ");

  AddInfo( ({"gegend","stadt"}) ,"Hier zu Leben und zu arbeiten ist ganz "
    "angenehm."
    ,"sagt: ");

  AddInfo( ({"gebiet",}) , "Du bist hier in Avir."
    ,"sagt: ");      

  AddInfo( ({"aufgabe","hilfe", "portal", "sehertor", "vertrauen"}) , 
    "Du musst fuer mich eine kleine Aufgabe loesen. Wir haben ein Problem "
    "auf der Todesinsel."
    ,"sagt: "); 

  AddInfo( ({"problem","insel", "todesinsel"}) , 
     "Dort haust ein Daemon mit Namen Tharess. Ich weis es ist viel verlangt,"
     " aber vertreibe ihn von dort. Du kannst die Druiden dort ausfragen. "
     "Die werden Dir sicher helfen."
    ,"sagt: "); 

  AddInfo( ({"daemon","tharess"}) , 
     "Wenn Du ihn toetest erlangst Du das Vertrauen der Stadt."
    ,"sagt: "); 

  AddInfo(DEFAULT_INFO, "hat keine Zeit fuer Deine belanglosen Dinge.\n");
 	AddInfo("delgo", "Delgo hat mich erschaffen.","sagt ehrfuerchtig: ");
	AddLibrary(NPC "penner.lib", 1);
  AddLibrary(NPC "avir.lib", 1);
 	AddLibrary(NPC "soeldner.lib", 1);
	SetChats(3,
  ({Name(WER, 1)+" blaettert eine Seite um.\n"
   ,Name(WER, 1)+" sucht ein Buch aus dem Regal.\n"
   ,Name(WER, 1)+" fragt Dich: Magst Du Dir das Vertrauen von Avir "
                 "verdienen?\n"
   }));
}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
	if(find_call_out("reaction") != -1) return;
  switch (gruppe)
  {
  	case "aengstlich":
      call_out("reaction", 0, TP,
        "hat keine Zeit fuer Mitleid.",
        "hat keine Zeit fuer Mitleid.");
    break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "brummt: Verschwinde!",
        "brummt: Verschwinde!");
    break;

    case "albern":
      call_out("reaction", 0, TP,
        "wird nicht fuers Lachen bezahlt.",
        "wird nicht fuers Lachen bezahlt.");
    break;

   	case "fies":
      call_out("reaction", 0, TP,
        "lacht Dich nur aus.",
				"lacht @WEN nur aus.");
    break;

    case "frech":
    	call_out("reaction", 0, TP,
      	"grummelt: Lenk mich nicht ab!",
       	"grummelt: Lenk mich nicht ab @WER!");
    break;

    case "froh":
    	call_out("reaction", 0, TP,
        "nimmt keine Notiz von Dir.",
      	"nimmt keine Notiz von @WEM.");
    break;

    case "intim":
    call_out("reaction", 0, TP,
        "sagt: Geh woanders spielen und lass die Erwachsenen arbeiten.",
        "sagt zu @WEM: Geh woanders spielen und lass die Erwachsenen "
        "arbeiten.");
    break;

    case "nett":
    	call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
    break;

   case "neutral":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
   break;

   case "traurig":
   	call_out("reaction", 0, TP,
    	"troestet Dich.",
      "troestet @WEN.");
   break;
  }
}
void
StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
 	return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;
  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
