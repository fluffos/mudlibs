
#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create(); 

  SetProp(P_SHORT, "Tiberion, Sohn von Tardens");
  SetProp(P_LONG,
    "Vor Dir steht Tardens' Aeltester. Die Aehnlichkeiten mit seinem Vater "
    "sind verblueffend. Er scheint dem Vater in allen Dingen nacheifern zu "
    "wollen, deswegen ist er auch gerade in sein Lehrbuch vertieft."
  );
  SetProp(P_NAME, "Tiberion");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"Axtmeister", "axtmeister", "haendler", "tiberion"}));
  SetProp(P_ARTICLE, 0);
	create_default_npc(22);
	SetProp(P_HANDS, ({" mit blossen Haenden", 1, DT_BLUDGEON }));
	SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 202);
  SetProp(P_WEIGHT, 89227);
  SetProp(P_ALIGN, 700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 4);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 5);
  SetProp(P_NOMAGIC,0);
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" braucht nichts von Dir.\n" }) );
	SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      -0.4, DT_COLD:      0.2, DT_SOUND:     -0.2 
     , DT_HOLY:      -0.4, DT_UNHOLY:    0.1, DT_MAGIC:      0.4]));

  SetProp(P_MSGIN, "schlaegt sein Lehrbuch auf");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Tiberion");

  AddDetail( ({"haare","frisur"}),
    "Die Haare sind kurz geschnitten und von brauner Faerbung.");

  AddDetail( ({"ohren","ohr"}),
    "Die Ohren sind typische Menschenohren.");
  
  AddDetail( ({"nase"}),
    "Die Nase sitzt bei Tiberion mitten im Gesicht.");
    
  AddDetail( ({"gesicht"}),
    "Ein allerweltsgesicht, Tiberion beachtet Dich kaum.");
        
  AddDetail( ({"augen","auge", "pupillen"}),
    "Ruhige und guetige Augen schauen Dich kurz an.");
    
  AddDetail( ({"haut"}),
    "Die Haut ist leicht braungebrannt von der Sonnne.");
    
  AddDetail( ({"lippen", "mund", "lippe"}),
    "Tiberion laechelt Dich kurz an.");
    
  AddDetail( ({"koerper"}),
    "Der Mann geht aufrecht und Du kannst keine besonderen Merkmale "
    "entdecken.");
    
  AddDetail( ({"kleidung"}),
    "Dir faellt an der Kleidung Tiberions nichts besonderes auf.");
  
  AddInfo(DEFAULT_INFO, 
    ({"laechelt Dich nur nett an.\n",
      "wird Dir darueber nichts sagen.\n" }) );
  AddInfo("delgo", "Den Namen habe ich schonmal gehoert.","sagt: ");
  
  AddInfo( ({"leben", "lauf"}) , "Das Leben nimmt halt so seinen Lauf."
    ,"sagt: ");
    
  AddInfo( ({"alter"}) , "Das geht Dich nichts an."
    ,"sagt laechelnd: ");
    
  AddInfo( ({"arbeit"}) ,"JMoechtest Du eine Waffe kaufen, ja?"
    ,"sagt: ");
    
  AddInfo( ({"gegend","stadt"}) ,"Hier zu Leben und zu arbeiten ist ganz "
    "angenehm."
    ,"sagt: ");
    
  AddInfo( ({"waffen"}),
    "Meine Familie und ich verkaufen alle Arten von Waffen.",
    "sagt begeistert: ");
 	AddInfo( ({"familie"}),
    "Mein Vater und Torrenz. ",
    "sagt stolz: ");
  AddInfo( ({"torrenz"}), 
    "Mein kleiner Bruder! Aber Torrenz scheint sich nicht fuer Waffen zu "
    "interessieren.",
    "murmelt: ");
  AddInfo("soeldner", "Da muesst Ihr den Buergermeister fragen.", "sagt: ");
  AddLibrary(NPC "penner.lib", 1);
  AddLibrary(NPC "avir.lib", 1);
	SetChats(3,
  ({Name(WER, 10)+" blaettert eine Seite um.\n"
   ,Name(WER, 1)+" scheint zu lernen.\n"
   ,Name(WER, 15)+" murmelt Merksaetze vor sich hin.\n"
   })
  );

  SetAttackChats(10,
  ({Name(WER, 1)+" sagt: Ich warne Dich, mein Vater hat mir einiges "
  	"beigebracht!\n"
   ,Name(WER, 1)+" keucht.\n"
   })
  );
  SUID;
  CLONEME("/p/weapon/axe/steinaxt" );
  command("zuecke axt");
  CLONEME("/p/armour/armour/kettenhemd" );
  CLONEME("/p/armour/boots/lederstiefel" );
  command("trage alles");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;
  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "lacht Dich aus.",
        "lacht @WEN aus.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "brummt: Verschwinde hier!",
        "brummt: Verschwinde hier!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "schuettelt nur den Kopf.",
        "schuettelt nur den Kopf.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "lacht Dich nur aus.",
        "lacht @WEN nur aus.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "grummelt: Lenk mich nicht ab! Ich muss lernen.",
        "grummelt: Lenk mich nicht ab @WER! Ich muss lernen.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Geh woanders spielen und lass die Erwachsenen arbeiten.",
        "sagt zu @WEM: Geh woanders spielen und lass die Erwachsenen "
        "arbeiten.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "trainiert weiter.",
        "trainiert weiter.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "sieht Dich gar nicht.",
        "sieht @WEN gar nicht.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;
  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}