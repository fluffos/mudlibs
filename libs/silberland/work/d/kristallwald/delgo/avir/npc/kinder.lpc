/*
2 unterschiedlich grosse Kinder.
*/
#include "../def.h"

inherit "std/mnpc";
inherit "/std/npc/spells";

void create()
{

int level, weight, size;

  if (!is_clone(this_object())) return;
  ::create();
  switch(1+random(2))
  {
    case 1: 
      level = 5;
      weight = 40000+random(20000);
      size = 125+random(30);
    break;

    default:
      level = 6; 
      weight = 35000+random(30000);
      size = 155+random(15);
    break;
  }

  SetProp(P_SHORT, "Ein Kind");
  SetProp(P_LONG, "Was soll man zu solchen Rotzloeffeln sagen? Frech wie "
  	"Oskar und doch irgendwie suess. Es rennt spielend umher und freut sich "
  	"seines Lebens.");
  SetProp(P_NAME, "Kind");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARTICLE, 1);
  AddId( ({"kind"}) );
  create_default_npc(level);
  SetProp(P_HANDS, ({" mit blossen Haenden ",QueryProp(P_HANDS)[1],
                     DT_BLUDGEON}));
  SetProp(P_ALIGN, -250 + random(750) );
  SetProp(P_RACE, "Mensch");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_WEIGHT, weight);
  SetProp(P_SIZE, size);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 40);
  SetProp(P_REJECT, ({ REJECT_DROP,
    "Warum drehst Du den Leuten sowas an?.\n" }) );
  SetChats(3,
  ({Name(WER, 10)+" spielt vergnuegt.\n"
   ,Name(WER, 1)+" lacht ueber Deine Ruestung.\nDu denkst . o O "
   "(Rotzloeffel!)\n"
   ,Name(WER, 15)+" stuerzt zu Boden.\nDu grinst.\n"
   })
  );
  SetProp(P_MSGIN, "rennt herein");
  SetProp(P_MSGOUT, "rennt");
  SetProp(P_MMSGIN, "faellt herein");
  SetProp(P_MMSGOUT, "faellt woanders hin");
  SetProp(P_DIE_MSG,  " rennt weinend nach Hause.\n");

  AddDetail( ({"haare","frisur"}),
    "Die Haare sind wild verwuschelt worden.");

  AddDetail( ({"ohren","ohr"}),
    "Die grossen Ohren stehen leicht vom kopf ab.");
  
  AddDetail( ({"nase"}),
    "Die Nase ist noch von Sommersprossen verziert.");
    
  AddDetail( ({"gesicht"}),
    "Ein kugelrundes Gesicht strahlt Dich an.");
        
  AddDetail( ({"augen","auge", "pupillen"}),
    "Die Augen suchen nach neuen Streichen.");
    
  AddDetail( ({"haut"}),
    "Sie ist leicht schmutzig.");
    
  AddDetail( ({"lippen", "mund", "lippe"}),
    "Aus dem Mund kommen ab und zu kleine Lieder.");
    
  AddDetail( ({"koerper"}),
    "Du schaetzt der Junge ist noch keine sechs Jahre alt.");
    
  AddDetail( ({"kleidung"}),
    "Sie ist leicht zerrissen, das gibt Aerger.");
  
  AddInfo(DEFAULT_INFO, 
    ({"spielt einfach weiter.\n",
      "schaut nur zu dir auf und lacht.\n" }) );
  AddInfo("delgo", "Boeser Onkel!","sagt: ");
  
  AddInfo( ({"spiele","spiel"}) , "Ich mag Spiele sehr gerne, fast so sehr "
     "wie Streiche."
    ,"sagt: ");
    
  AddInfo( ({"streiche","streich"}) ,"Ich spiele allen leuten Streiche!"
    ,"grinst: ");
    
  AddInfo( ({"eltern","vater", "mutter"}) , "Meine Eltern wohnen hier."
    ,"sagt: ");
    
  AddInfo( ({"alter","leben", "heimat"}) , "Ich wurde vor sieben Jahren "
     "geboren." ,"sagt: ");
    
  AddInfo( ({"gebiet","hilfe", "avir"}) , "Das hier ist Avir."
    ,"sagt: ");

  AddInfo("spruch", "Im Osten geht die Sonne auf, im Sueden nimmt sie ihren "
  	"Lauf, im Westen muss sie untergehen, im Norden ist sie nie zu "
  	"sehen.","singt froehlich: "); 
  	//hier sollten ein paar FP hin! Wer das macht hats verdient!
  AddLibrary(NPC "avir.lib", 1);
  SetProp(P_MNPC_AREA, ({  ROOM "e1"}) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "e1-e3-park");
  SetProp(P_MNPC_WAIT, ({ 25, 24, 5 }));
  SetProp(P_MNPC_FLAGS, 
  				MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);
}

void die(int poisondeath) {
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Ein Kind hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;
  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "lacht Dich aus.",
        "lacht @WEN aus.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "lacht nur.",
        "lacht nur.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "schaut Dich erstaunt an.",
        "schaut @WEN erstaunt an.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "lacht Dich nur aus.",
        "lacht @WEN nur aus.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "rennt wild umher.",
        "rennt wild umher.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "lacht herzhaft.",
        "lacht herzhaft.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "weint: Du bist ja paedophil!",
        "weint: @WER ist ja paedophil!");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "laechelt.",
        "laechelt.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "kichert.",
        "kichert.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "lacht ueber Dich.",
        "lacht ueber @WEN.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;
  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
