#include "../def.h"

inherit "std/npc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Maxim, der Ausschenker");
  SetProp(P_LONG,
  	"Auch wenn es alle denken: Maxim hat nix mit Max zu tun. Das sieht man "
  	"schon daran, dass Maxim ein Zwerg ist. Maxim ist nicht gerade "
  	"unschmaechtig, kein Wunder, wenn man andauernd Weinfaesser schleppt. "
  	"Zum Reden hat er scheinbar keine Zeit. Ob das wohl daran liegt, dass "
  	"er und vier Kellnerinnen fast zweihundert Gaeste bedienen muessen?");
  SetProp(P_NAME, "Maxim");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:70]));
  AddId( ({"maxim","wirt"}) );
  AddClass(CL_DWARF); 
  create_default_npc(24);
  SetProp(P_HANDS, ({" mit seinen Haenden", 			
  									 QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 135);
  SetProp(P_ALIGN, 650);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_MSGIN, "schenkt (her)ein");
  SetProp(P_MSGOUT, "schenkt (her)aus");
  SetProp(P_MMSGIN, "kommt aus dem Lager");
  SetProp(P_MMSGOUT, "geht mal eben ins Lager");
  AddDetail( ({"haare","frisur"}),
    "Die Haare sind zu einem Zopf geflechtet.");

  AddDetail( ({"ohren","ohr"}),
    "Die Ohren sind typisch zwergisch.");
  
  AddDetail( ({"nase"}),
    "Die Nase sitzt bei dem Zwerg mitten im Gesicht.");
    
  AddDetail( ({"gesicht"}),
    "Wenn Du Maxim wenigstens lang genug sehen wuerdest um das Gesicht mal "
    "anzusehen.");
        
  AddDetail( ({"augen","auge", "pupillen"}),
    "Hastig suchen die Augen Bestellungen.");
    
  AddDetail( ({"haut"}),
    "Die Haut ist leicht braungebrannt von der Sonnne.");
    
  AddDetail( ({"lippen", "mund", "lippe"}),
    "Der Zwerg laechelt Dich kurz an.");
    
  AddDetail( ({"koerper"}),
    "Der Zwerg mag scheinbar gutes Essen.");
    
  AddDetail( ({"kleidung"}),
    "Dir faellt an der Kleidung des Zwerges nichts besonderes auf.");
  AddInfo(DEFAULT_INFO, "Keine Zeit! Bestell einfach was!","sagt eilig: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" hat sowas selber.\n" }) );
  SetAttackChats(10,
    ({Name(WER,1)+" sagt: Ich hab jetzt keine Zeit fuer Deine Spielereien!\n"
     })
  );
  AddInfo("delgo", "Delgo hat mich erschaffen.","sagt ehrfuerchtig: ");
  AddInfo("soeldner", "Da muesst Ihr den Buergermeister fragen.", "sagt: ");
  AddLibrary(NPC "penner.lib", 1);
  AddLibrary(NPC "avir.lib", 1);
  SetProp(P_NOATTACK , "ist zu beschaeftigt, um mit Dir zu spielen.");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;
  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "lacht Dich aus.",
        "lacht @WEN aus.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "brummt: Verschwinde besser!",
        "brummt: Verschwinde besser!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "schuettelt nur den Kopf.",
        "schuettelt nur den Kopf.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "lacht Dich nur aus.",
        "lacht @WEN nur aus.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "grummelt: Lenk mich nicht ab!",
        "grummelt: Lenk mich nicht ab @WER!");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Geh woanders spielen und lass die Erwachsenen arbeiten.",
        "sagt zu @WEM: Geh woanders spielen und lass die Erwachsenen "
        "arbeiten.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "kellnert lieber.",
        "kellnert lieber.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        "troestet @WEN.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;
  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}