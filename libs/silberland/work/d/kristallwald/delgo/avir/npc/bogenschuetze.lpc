#include "../def.h"
inherit "std/npc";
inherit "/std/npc/spells";

void
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  

  SetProp(P_SHORT, "Ein avirischer Bogenschuetze");
  SetProp(P_LONG, "Einer der Soeldner Avirs, er wurde allerdings auf den "
  								"Umgang mit dem Bogen spezialisiert, deswegen ist er recht"
  								" hager und macht keinen gefaehrlichen Eindruck. Aber von "
  								"hier aus kann er den Wachweg gut bewachen.");
	SetProp(P_NAME, "Bogenschuetze");
  SetProp(P_GENDER, MALE);
 	SetProp(P_ARTICLE, 1);
  AddId( ({"soeldner", "bogenschuetze", "schuetze"}) );
 	create_default_npc(12);
  SetProp(P_HANDS, ({" mit blossen Haenden",
  										QueryProp(P_HANDS)[1],
  										DT_BLUDGEON}));
 	SetProp(P_ALIGN, 100 - random(500) ); //Kein soeldner ist wirklich gut :)
 	SetProp(P_RACE, "Mensch");
 	SetProp(P_NOCORPSE, 0);
 	SetProp(P_WEIGHT, 65000);
 	SetProp(P_SIZE, 180+random(20));
 	SetProp(P_MAX_HANDS, 2);
 	SetProp(P_WIMPY, 20);
 	SetProp(P_ARTICLE, 1);
 	SetProp(P_NOMAGIC, 10);
 	SetProp(P_REJECT, ({ REJECT_DROP,
  "Der Bogenschuetze laesst den Wachweg nicht aus den Augen.\n" }) );
 	SetChats(3,
  ({Name(WER, 10)+" konzentriert sich auf den Wachweg.\n"
   ,Name(WER, 1)+" ruehrt sich nicht.\n"
   ,Name(WER, 15)+" laesst seine Adleraugen ueber den Wachweg schweifen.\n"})
  );
 	SetProp(P_MSGIN, "kommt heran");
 	SetProp(P_MSGOUT, "geht");
 	SetProp(P_MMSGIN, "kommt herein");
 	SetProp(P_MMSGOUT, "geht woanders hin");
  SetProp(P_DIE_MSG,  " stuerzt mit einem Schmerzensschrei zu Boden.\n");

  AddDetail( ({"umgang","bogen"}),
    "Er steht sicher nicht umsonst hier.");

  AddDetail( ({"haare","frisur"}),
    "Die Haare sind militaerisch kurz geschnitten. Die Haarfarbe ist dunkel.");

  AddDetail( ({"ohren","ohr"}),
    "Er lauscht nebenbei mit seinen Ohren in alle Richtungen.");
  
  AddDetail( ({"nase"}),
    "Dir faellt an der Nase nichts auf.");
    
  AddDetail( ({"gesicht"}),
    "Das gesicht hat schon einiges miterlebt.");
        
  AddDetail( ({"augen","auge", "pupillen"}),
    "Die Augen ueberwachen aufmerksam die Umgebung.");
    
  AddDetail( ({"haut"}),
    "Die Haut ist braungebrannt, er hat scheinbar viel Dienst draussen.");
    
  AddDetail( ({"lippen", "mund", "lippe"}),
    "Der Mann murmelt leise vor sich hin.");
    
  AddDetail( ({"koerper"}),
    "Der Mann haelt sich fit, wie Du an dem durchtrainierten Koerper siehst.");
    
  AddDetail( ({"kleidung"}),
    "Die Unterkleidung waermt den Mann, bei seinem Dienst.");
    
  AddInfo(DEFAULT_INFO, 
    ({"weiss leider keine Antwort.\n",
      "kann Dir da nicht weiterhelfen.\n" }) );
  AddInfo("delgo", "Er ist bei uns bekannt.","sagt: ");
  
  AddInfo( ({"waffe","waffen"}) , "Ich habe den Umgang mit Waffen recht gut "
     "erlernt."
    ,"sagt: ");
    
  AddInfo( ({"ausbildung","vergangenheit"}) ,"Das war hart, aber ich moechte "
     "nicht darueber reden.."
    ,"sagt: ");
    
  AddInfo( ({"auftrag","aufgabe"}) , "Das wechselt taeglich."
    ,"sagt: ");
    
  AddInfo( ({"arbeit","leben"}) , "Sicher gibt es sichere Arbeit aber naja, "
     "was soll man machen?"
    ,"sagt: ");
    
  AddInfo( ({"tod","sterben"}) ,"Wenn es sein muss."
    ,"sagt: ");
    
  AddInfo( ({"gebiet","hilfe", "avir"}) , "Du bist auf dem Wehrgang von Avir."
    ,"sagt: ");
    
  AddInfo("wachweg", "Den bewache ich.","sagt: ");
  AddInfo("bogen", "Den benutze ich recht gerne.","sagt: ");
  AddInfo("bogenschuetze", "Ich kenne nur mich und meine Soeldner, und "
  	"  jetzt lass mich arbeiten!","sagt: ");
  SetProp(P_SPELLRATE,20);
  AddSpell(2,150,
    Name()+" rammt Dir einfach einen Pfeil in den Arm!\n",
    Name()+" sticht @WEN mit einem Pfeil!\n",
    DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,210,
    Name()+" schubst Dich!\n",
    Name()+" schubst @WEN!\n",
    DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  SetProp(P_RESISTANCE_STRENGTHS ,
   ([DT_FIRE:      0.1]) );
  SUID;
 	CLONEME( "/p/armour/armour/kettenhemd");
  command("trage alles");
 	CLONEME( WEAPON "bogen_leicht");
 	command("zuecke bogen" );
}

void die(int poisondeath)
{
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer == ME)
  {
  	write_file(LOG "npc.deads",
      ctime()+": Ein Bogenschuetze hat gerade "+CAP(getuid(player))+
      " umgebracht.\n");
	}
}


void angriff(object pl)
{
  string shouter;
  if(!ENV(TO))           return;
  if(!ENV(pl))           return;
  if(!interactive(pl))   return;
  if(ENV(TO) != ENV(pl)) return;
  Kill(pl);
  return;
}

void init()
{
  ::init();
  if(!TP)                        return;
  if(!interactive(TP))           return;
  if(TP->QueryProp(P_GHOST))     return;
  if(!AVIRMASTER->IsEnemy(TP))   return;
  call_out("angriff", 0, TP);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  AVIRMASTER->AddEnemy(enemy);
  call_other( ROOM "e1-c3-tor", "close_gate",1);
  return ::Defend(dam, dam_type, spell, enemy);
}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{

if(find_call_out("reaction") != -1) return;
  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "lacht Dich aus.",
     		"lacht @WEN aus.");
    break;
   
    case "aergerlich":
   		call_out("reaction", 0, TP,
        "brummt: Verschwinde!",
        "brummt: Verschwinde!");
    break;
    
    case "albern":
      call_out("reaction", 0, TP,
        "schuettelt nur den Kopf.",
        "schuettelt nur den Kopf.");
    break;
   
    case "fies":
      call_out("reaction", 0, TP,
 				"lacht Dich nur aus.",
        "lacht @WEN nur aus.");
    break;
   
    case "frech":
      call_out("reaction", 0, TP,
        "grummelt: Lenk mich nicht ab!",
        "grummelt: Lenk mich nicht ab @WER!");
    break;

    case "froh":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
   	break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Geh woanders spielen und lass die Erwachsenen arbeiten.",
        "sagt zu @WEM: Geh woanders spielen und lass die Erwachsenen "
        "arbeiten.");
    break;

    case "nett":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
    break;

    case "neutral":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
    break;

    case "traurig":
   		call_out("reaction", 0, TP,
        "lacht ueber Dich.",
        "lacht ueber @WEN.");
    break;
  }
}

void StartReactionAll(string verb, string gruppe,
string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
	if(!ENV(TO))           return;
  if(!objectp(pl))       return;
	if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;
  
  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}