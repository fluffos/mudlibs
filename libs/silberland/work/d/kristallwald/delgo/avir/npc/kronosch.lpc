
#include "../def.h"
#include "/gilden/waldlaeufer/ranger_tasks.h"

inherit "std/repair";
inherit "/std/npc/spells";

void create()
{
 
string    arm1, arm2, arm3;
 
  if( !is_clone(this_object()) ) return;
  ::create(); 

  /*CLONEME("/p/armour/armour/kettenhemd" );
  CLONEME("/p/armour/gloves/kettenhandschuhe" );
  CLONEME("/p/armour/helm/kettenhaube" );
  CLONEME("/p/armour/bracers/kettenzeug" );
  CLONEME("/p/armour/trousers/kettenhose" );*/

  switch(1+random(3))
  {
   case 1:
   arm1 = "/p/armour/armour/kettenhemd";
   arm2 = "/p/armour/gloves/kettenhandschuhe";
   arm3 = "/p/armour/helm/kettenhaube";
   break;
   
   case 2:
   arm1 = "/p/armour/bracers/kettenzeug";
   arm2 = "/p/armour/trousers/kettenhose";
   arm3 = "/p/armour/armour/kettenhemd";
   break;
   
   default:
   arm1 = "/p/armour/gloves/kettenhandschuhe";
   arm2 = "/p/armour/helm/kettenhaube";
   arm3 = "/p/armour/bracers/kettenzeug";
   break;  
  }
  SetProp(P_SHORT, "Kronosch der Ruestungsbauer");
  SetProp(P_LONG,
    "Wie beschreibt man Kronosch am besten? Alt, geizig, schlecht gelaunt, "
    "redet nicht mit Dir - der perfekte Zwerg. Kronosch scheint schon viele "
    "Tage gesehen zu haben, auf jeden Fall scheint er sich auf sein "
    "Handwerk zu verstehen. "
  );
  SetProp(P_NAME, "Kronosch");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"Kettenmeister", "kettenmeister", "haendler", "kronosch"}));
  SetProp(P_ARTICLE, 0);
  create_default_npc(25);
  SetProp(P_HANDS, ({" mit blossen Haenden", 1, DT_BLUDGEON }));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 98);
  SetProp(P_WEIGHT, 61094);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,8);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" braucht nichts von Dir.\n" }) );
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      -0.5, DT_COLD:       0.1, DT_WATER:       0.1
     , DT_SOUND:     -0.3, DT_HOLY:      -0.1, DT_MAGIC:       0.1]));

  SetProp(P_MSGIN, "schlurft herein");
  SetProp(P_MSGOUT, "vergrault sich");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
	SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
 	SetProp(P_KILL_NAME, "Kronosch");
  AddDetail( ({"haare","frisur"}),
    "Die Haare sind schwarzbraun und gehen im bis zu den Knien.");

  AddDetail( ({"ohren","ohr"}),
    "Die Ohren werden von den haaren verdeckt.");
  
  AddDetail( ({"nase"}),
    "Die knollige Nase ist zwergisch gross.");
    
  AddDetail( ({"gesicht"}),
    "Der Zwerg versucht deinen Blicken auszuweichen.");
        
  AddDetail( ({"augen","auge", "pupillen"}),
    "Kleine Augen schauen sich regelmaessig um.");
    
  AddDetail( ({"haut"}),
    "Die Haut eher dreckig, da siehst Du nicht viel.");
    
  AddDetail( ({"lippen", "mund", "lippe"}),
    "Er presst angestrengt die Lippen aufeinander.");
    
  AddDetail( ({"koerper"}),
    "Der Zwerg laeuft schlurft eher gelangweilt durch die Gegend.");
    
  AddDetail( ({"kleidung"}),
    "Er traegt eher dunkle Kleidung.");
  
  AddInfo(DEFAULT_INFO, 
    ({"ignoriert Dich gekonnt.\n",
      "murmelt etwas Unverstaendliches.\n" }) );
  AddInfo("delgo", "Ich habe schon von ihm gehoert.","sagt: ");
  
  AddInfo( ({"arbeit","handwerk"}) , "Du kannst bei mir Ruestungen erwerben "
     "oder verkaufen."
    ,"sagt: ");
    
  AddInfo( ({"leben","alter"}) ,"Ich lebe lang genug um zu wissen, dass "
     "ich nicht antworten muss."
    ,"sagt: ");
    
  AddInfo( ({"gebiet","hilfe", "avir"}) , "Du bist in Avir."
    ,"sagt: ");
  AddInfo("soeldner", "Da muesst Ihr den Buergermeister fragen.", "sagt: ");
  AddLibrary(NPC "penner.lib", 1);
  AddLibrary(NPC "avir.lib", 1);
  RemoveInfo( ({"reparatur", "reparieren", "repariere"}));  
  AddInfo( ({"reparatur", "reparieren", "repariere"}),
    "Wenn Du willst, kann ich Deine Ruestungen reparieren. Gib "
    "dazu einfach 'repariere <name>' ein. Leider muss ich aber einiges an "
    "Geld dafuer verlangen.", "grummelt: ");

  AddInfo( ({"waffen"}),
    "Ich sammle Waffen! Besonderes interessante Exemplare nehme ich dir gern "
    "fuer meine Sammlung ab.", "sagt: ");

  SetProp(P_SPELLRATE, 33); 
  AddSpell(35,300,
    Name()+" schleudert Dich mit einem Rueckhandhieb zu Boden!\n",
    Name()+" schleudert @WEN mit einem Rueckhandhieb zu Boden!\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
  AddSpell(25,900,
    "Kronosch springt hoch und vernichtet Dich mit einem gewaltigen "
    "Hieb!\n",
    "Kronosch springt hoch und vernichtet @WEN mit einem gewaltigen "
    "Hieb!\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
  
	SetChats(1,
  ({Name(WER)+" legt scheinbar keinen Wert auf Kunden, jedenfalls "
  	"beachtet er Dich nicht.\n"
   ,Name(WER)+" murmelt etwas unverstaendliches in seinen Bart.\n"
   ,Name(WER)+" seufzt.\n"
   })
  );

  SetAttackChats(1,
  ({Name(WER, 1)+" holt weit aus...\n"
   ,Name(WER, 1)+" trifft Dich unglaublich hart.\n"
   })
  );
	SUID;
  CLONEME("/p/weapon/chain/doppelstern" );
  command("zuecke doppelstern");
  CLONEME(arm1);
  CLONEME(arm2);
  CLONEME(arm3);
  command("trage alles");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt Kronosch.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))+
      " umgebracht.\n");
  }
}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;
  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "lacht Dich aus.",
        "lacht @WEN aus.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "brummt: Verschwinde!",
        "brummt: Verschwinde!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "schuettelt nur den Kopf.",
        "schuettelt nur den Kopf.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "lacht Dich nur aus.",
        "lacht @WEN nur aus.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "grummelt: Lenk mich nicht ab!",
        "grummelt: Lenk mich nicht ab @WER!");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Geh woanders spielen und lass die Erwachsenen arbeiten.",
        "sagt zu @WEM: Geh woanders spielen und lass die Erwachsenen "
        "arbeiten.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "sagt: Raus aus meinem Laden!",
        "sagt: Raus aus meinem laden @WER!");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "lacht ueber Dich.",
        "lacht ueber @WEN.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;
  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

int rep_auswahl(object ob)
{
  if( ob->QueryProp(P_ARMOUR_TYPE))
  {
    return 1;
  }
  else
  {
    write(BS("Als Ruestungsbauer kann Kronosch nur Ruestungen reparieren!"));
    return 0;
  }
}

public void give_notify(object ob) {
  object task;
  string wt;
  int wc;

  if(objectp(task=present(RANGER_TASK_WEAPON_GATHER, TP)) && stringp((wt=ob->QueryProp(P_WEAPON_TYPE)))) {
    if(task->QueryGiven(wt)) {
      command_me("sag Du hast mir schon so eine Waffe gebracht!");
      ob->move(TP, M_NOCHECK);
      return;
    }

    wc = ob->QueryProp(P_WC);
    if(ob->QueryProp(P_MAGIC) || ob->QueryProp(P_INFO) || ob->QueryProp(P_VALUE) > 5000 ||
       wt == WT_KNIFE && wc > 110 || wt == WT_SWORD && wc > 170 ||
       wt == WT_AXE && wc > 200 || wt == WT_SPEAR && wc > 200 || 
       wt == WT_BOW && wc > 200 || wt == WT_CLUB && wc > 200) {
        task->Accept(wt);
        command_me("sag Wunderbar! So etwas hat meiner Sammlung noch gefehlt!");
        ob->remove(1);
    } else {
      command_me("sag Also das ist doch reinster Ramsch! Bring mir eine interessante Waffe, die besser, "
                 "wertvoller oder vielleicht sogar magisch ist!");
      tell_room(ENV(TO), BS("Kronosch wirft "+ob->name(WEN)+" achtlos auf den Boden."));
      ob->move(ENV(TO), M_NOCHECK);
    }

    if(task->Complete()) {
      command_me("sag Also gut. Nachdem du mir so viele tolle Waffen gebracht hast, "
                 "werde ich euch Waldlaeufern helfen! Richte Raziel meinen Gruss aus.");
    }
  }

  if(objectp(task=present(RANGER_TASK_MAGIC_WEAPONS, TP))) {
    //chattenschwet -> klamm, feuerpeitsche -> balrog, luftschwert -> friedhof, Lichtkeuel -> Bergwerk, Silberschwert -> Offizier, blauschwert -> magier
    if(task->QueryGiven(ob)) {
      command_me("sag Das hast du mir schon gebracht, du Hohlbirne!");
      ob->move(TP, M_NOCHECK);
      return;
    }

    if(task->Accept(ob)) {
      command_me("sag Wunderbar! Das hat uns noch gefehlt!");
      ob->remove(1);
    }

    if(task->Complete()) {
      command_me("sag Also gut, "+TPN+". Jetzt habe ich alles was ich brauche. Sag Raziel, dass ich mich "
                 "an die Arbeit mache.");
    }
  }

  if(objectp(task=present(RANGER_TASK_SCALE_GATHERER, TP))) {
    if(ob->id("drachenschuppe") && ob->QueryProp(P_AMOUNT) > 0) {
      command_me("sag Ahja! Perfekte Drachenschuppen. Genau danach habe ich gesucht!");
      task->AcceptScales(ob->QueryProp(P_AMOUNT));
      ob->remove(1);
    } else if(ob->id("\nwasserfrag") && ob->QueryProp(P_AMOUNT) > 0) {
      command_me("sag Wunderbar! Reine elementare Wasserfragmente! Exakt das, was wir brauchen!");
      task->AcceptFragments(ob->QueryProp(P_AMOUNT));
      ob->remove(1);
    }

    if(task->Complete()) {
      command_me("sag Absolut Perfekt! Das war gute Arbeit, "+TPN+". Du kannst Raziel berichten, "
                  "dass es gut voran geht. Es fehlt nicht mehr viel.");
    }
  }

  return;
}

public void init() {
  ::init();

  if(TP->QueryProp(P_GUILD) == "waldlaeufer") {
    call_out("greet_waldi", 0, TP);
  }
}

public void greet_waldi(object pl) {
  if(pl->QueryProp(P_GUILD_LEVEL) == 6 && !RANGER_CHECK_TASK(pl, 7)) {
    command_me("sag He, "+pl->Name(WER)+"! Hab mich schon gefragt wann du auftauchst. Raziel will wohl "
               "versuchen mich zu bestechen? Na dann zeig mal, ob du was interessantes hast.");
    return;
  }

  if(pl->QueryProp(P_GUILD_LEVEL) == 7 && !RANGER_CHECK_TASK(pl, 8)) {
    command_me("sag Gut, dass du da bsit, "+pl->Name(WER)+". Ich brauche eine Flammenpeitsche, einen Eisdorn, "
               "ein blaues Schwert, ein Silberschwert, eine Lichtkeule, ein Luftschwert und ein Schattenschwert. "
               "Hast du mir etwas davon mitgebracht?");
    return;
  }

  if(pl->QueryProp(P_GUILD_LEVEL) == 9 && !RANGER_CHECK_TASK(pl, 10)) {
    command_me("sag Hallo, "+pl->Name(WER)+". Ich komme gut mit meiner Arbeit voran. Dennoch benoetige ich "
               "ein paar wichtige Gegenstaende fuer den Feinschliff. Ich benoetige 10 Drachenschuppen und "
               "10 Wasserfragmente. Hast du vielleicht etwas davon fuer mich dabei?");
    return;
  }
}
