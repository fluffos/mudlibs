
#include "../def.h"

inherit "std/mnpc";
inherit "/std/npc/spells";


void create()
{
  if( !is_clone(this_object()) ) return;
  ::create(); 


  SetProp(P_SHORT, "Ein alter Penner");
  SetProp(P_LONG,
    "Vor Dir steht eine erbaermliche Gestalt. Unter der alten Kutte "
    "erkennst Du ein zerfallenes Gesicht, das schon viel Boeses miterlebt "
    "hat. Ein Mann, vom Schicksal gezeichnet. Dennoch verspuerst Du kein so "
    "grosses Mitleid, wie Du eigentlich solltest. Als Du siehst, dass ihm "
    "eine Hand fehlt, ahnst Du auch warum..."
  );
  AddDetail( ({"haare","frisur"}),
    "Die Haare sind blond, verdreckt und fast schulterlang.");

  AddDetail( ({"ohren","ohr"}),
    "Die Ohren werden von den Haaren verdeckt.");
  
  AddDetail( ({"nase"}),
    "Du bemerkst nichts an der Nase.");
    
  AddDetail( ({"gesicht"}),
    "Der Mann versucht deinen Blicken auszuweichen.");
        
  AddDetail( ({"augen","auge", "pupillen"}),
    "Kleine Augen schauen sich regelmaessig um.");
    
  AddDetail( ({"haut"}),
    "Die Haut eher dunkel, der Mann ist wohl oft an der Sonne.");
    
  AddDetail( ({"lippen", "mund", "lippe"}),
    "Er presst angestrengt die Lippen aufeinander.");
    
  AddDetail( ({"koerper"}),
    "Der Mann ist total verkuemmert.");
    
  AddDetail( ({"kleidung", "kutte"}),
    "Die Kutte ist alt und zerfallen.");
    
  SetProp(P_NAME, "Penner");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"penner"}));
  SetProp(P_ARTICLE, 1);
  create_default_npc(8);
  SetProp(P_HANDS, ({" mit seiner Hand", 1, DT_BLUDGEON }));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 175);
  SetProp(P_WEIGHT, 55345); //abgemagert
  SetProp(P_ALIGN, 0); //ihm is alles egal
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0); //keine angst vorm tod
  SetProp(P_NOMAGIC,0);
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" schubst dich nur weg.\n" }) );
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.1])
  );

  SetProp(P_MSGIN, "schlurft herein");
  SetProp(P_MSGOUT, "schlurft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, ({  ROOM "e1"}) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "e1-e3-park");
  SetProp(P_MNPC_WAIT, ({ 60, 70, 10 }));
  SetProp(P_MNPC_FLAGS, 
  				MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  AddInfo(DEFAULT_INFO, "hat selber Probleme.\n");
  AddInfo("delgo", "Delgo hat mir das angetan.","sagt zornig: ");
  AddInfo( ({"hand", "problem", "probleme"}), 
    "Frueher war ich in eine Frau verliebt. Sie nicht in "
  	"mich. Aber ich wollte unbedingt, naja... . Man hackte mir erst die "
  	"Hand ab, damit ich langsam in einer Zelle verbluten sollte.",
  	"murmelt: ");
  AddInfo("zelle", "Ich konnte fliehen, aber das ist kein Leben.",
  	"murmelt: ");
  AddInfo("leben", "DAS NENNST DU LEBEN?","schreit Dich an: ");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt den Penner.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))+
      " umgebracht.\n");
  }
}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;
  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "sagt: Du bist seltsam.",
        "sagt zu @WEM: Du bist seltsam.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "brummt: Lasst mich einfach alle in Frieden!",
        "brummt: Lasst mich einfach alle in Frieden!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "schuettelt nur den Kopf.",
        "schuettelt nur den Kopf.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "sagt: Du bist herzlos.",
        "sagt: @WER, Du bist herzlos.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "grummelt: Lenk mich nicht ab!",
        "grummelt: Lenk mich nicht ab @WER!");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "hat keine Freuden mehr im Leben.",
        "hat keine Freuden mehr im Leben.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Geh woanders spielen und lass die Erwachsenen arbeiten.",
        "sagt zu @WEM: Geh woanders spielen und lass die Erwachsenen "
        "arbeiten.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "bedankt sich stillschweigend bei Dir.",
        "bedankt sich stillschweigend bei @WEM.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "lacht ueber Dich.",
        "lacht ueber @WEN.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;
  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}