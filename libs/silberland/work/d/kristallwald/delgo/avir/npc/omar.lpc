void die(int poisondeath)
{
  write_file(LOG "omar.kills", 
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt Omar.\n");
  AVIRMASTER->Msg(""+TPN+" hat gerade Omar umgebracht", 2);
  ::die(poisondeath);
  
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "omar.deads", 
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))+
      " umgebracht.\n");
    command("nimm alles aus leiche");
  }
}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;
  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "bruellt Dich an: Verschwinde aus meiner Stadt!",
        "bruellt "+TPN+" an: Verschwinde aus meiner Stadt!");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "legt seine Hand auf sein Schwert.",
        "legt seine Hand auf sein Schwert.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "laesst Blutdurst durch die Luft schwingen und laechelt Dich "
        "eiskalt an.",
        "laesst Blutdurst durch die Luft schwingen und laechelt "+TPN+
        " eiskalt an.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "lacht Dich nur aus.",
        "lacht "+TPN+" nur aus.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "grummelt: Lenk mich nicht ab!",
        "grummelt: Lenk mich nicht ab "+TPN+"!");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Geh woanders spielen und lass die Erwachsenen arbeiten.",
        "sagt zu "+TPN+": Geh woanders spielen und lass die Erwachsenen "
        "arbeiten.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "lacht ueber Dich.",
        "lacht ueber "+TPN+".");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;
  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
void Attack(object enemy)
{
  int lp;
  lp = this_object()->QueryProp(P_HP);
  //command("sag "+lp+""); //Testzwecke
  if ( (lp > 499) && (lp < 800) )
  // Ab ca. 500 kommt der 1. Rausch, da wuerden die 
  //Pfeile (rein von der Logik her) auch ihn treffen
  {
    call_other( ROOM "e5" , "pfeile", 1); //EASYATTACK
  }
  if (  (lp < 500) && (lp > 399) ) 
  {
    if ( rausch == "1" || rausch == "2")
    {
      write("");// bleibt fuer testzwecke und ausblancieren
    }
    else
    {
      call_out("rausch_m", 0);  //MEDIUMATTACK
      rausch = "1";
    }
  }
  if (lp < 400)
  {
    if ( rausch == "2")
    {
      write("");
    }
    else
    {
      call_out("rausch_h", 0);  //HARDCOREAATACK
      rausch = "2"; 
     }
  }
  ::Attack(enemy);
  return;
}

void rausch_m()  
{
  say("\n");
  say("     Omar steigert langsam seine Wut, er wird\n        "
      "schneller und kraeftiger...\n");
  say("\n");
  this_object()->ModifySkillAttribute(this_object(),SA_SPEED,300,60);
  this_object()->SetProp(P_ATTRIBUTES, 
  											([A_STR:45,A_INT:35,A_CON:35,A_DEX:35]));
  SetProp(P_SPELLRATE,0); //Waehrend dem Brauch lieber keine Spells und 
                         //danach, 'ruht' er sich ja aus
                        //und bereitet sich schon auf naechsten rausch vor -
                       //> also keine Spells mehr ab dem ersten rausch
}
void rausch_h()
{
  say("\n");
  say("   Omar wird rasend vor Wut! Er steigert seine\n "
      "Geschwindigkeit und seine Kraft ins Unermessliche!\n");
  say("\n");
  this_object()->ModifySkillAttribute(this_object(),SA_SPEED,450,45);
  this_object()->SetProp(P_ATTRIBUTES, 
  											([A_STR:60,A_INT:35,A_CON:35,A_DEX:35]));
  call_out("normal", 56); //11 sekunden pause .)
  SetProp(P_SPELLRATE,0); //sicherheitshalber falls kein 1. rausch :)
}
void normal()
{
	say("\n");
	say(BS("Omar beruhigt sich wieder...\n"));
	say("\n");
	this_object()->SetProp(P_ATTRIBUTES,
												([A_STR:30,A_INT:35,A_CON:35,A_DEX:35]));
	SetProp(P_SPELLRATE, 18);
	rausch = "1"; //ansonsten warten spieler einfach bis der rausch vorbei ist 
               //und kommen dann wieder :)

}
void heal()
{
	say(BS("Blutdurst heilt Omar leicht.\n"));
	this_object()->AddHp(10+random(20));
	return;
}

// by Gwenshara - Bardenlernquest 
public void give_notify(object ob) {
  if(ob->id("kreuzschwert")) {
      call_out("sword_given_seq", 0, 0, ob->QueryProp(P_POISON), TP);
      ob->remove(1);
  }
}

public int isEligibleToLearn(object ob) {
  return ob->QueryProp(P_GUILD) == "bardengilde" && ob->QuerySkill("tanz der saebel") == 0;
}

public void sword_given_seq(int step, int poison, object who) {
  int i;
  object *inv;

  switch(step) {
    case 0:
      command_me("emote haelt das Schwert begutachtend in die Hoehe.");
      break;
    case 1:
      command_me("emote fuehrt ein paar pruefende Haue damit durch.");
      break;
    case 2:
      if(poison > 0) {
        command_me("emote erstarrt ploetzlich und haelt sich die Hand an die Brust.");
      } else {
        command_me("emote nickt zustimmen.");
        command_me("sag Damit hast du bewiesen, dass du wuerdig bist!");
      }
      break;
    case 3:
      if(poison > 0) {
        command_me("emote wird blass und bricht keuchend zusammen.");
      } else {
        command_me("emote vollfuehrt einen wilden Tanz aus Hauen, Hieben und Stichen mit dem Schwert.");
      }
      break;
    case 4:
      inv = filter_array(all_inventory(ENV(TO)), "isEligibleToLearn");
      for(i=0; i<sizeof(inv); ++i) {
        LearnBardSpell(inv[i], "tanz der saebel", "spiele 'tanz der saebel' auf <waffe>",
                       "Dieses wilde Lied erweckt eine Waffe zum Leben, die dann fuer dich kaempft "
                       "ohne, dass du sie zuecken musst!");
      }
      EPMASTER->GiveExplorationPoint("omar_klinge", EP_MISC);
      if(poison > 0) {
        die(1);
      }
      return;
      break;
  }

  call_out("sword_given_seq", 4, ++step, poison, who);
}
