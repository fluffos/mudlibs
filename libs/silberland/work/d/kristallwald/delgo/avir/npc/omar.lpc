    ,"sagt: ");
    
  AddInfo( ({"tod","sterben"}) ,"Wenn es sein muss."
    ,"sagt: ");
    
  AddInfo( ({"gebiet","hilfe", "avir"}) , "Du befindest Dich ueber Avir, vor "
