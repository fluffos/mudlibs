/*
Pfeile um der Pfeilattacke von Omar sauber zu machen.
*/

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  //SetProp(P_INVIS, );
  SetProp(P_ARTICLE, 0);
  SetProp(P_LONG,
    "");

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "");
  SetProp(P_NAME, "Ein Pfeil");
  SetProp(P_GENDER, MALE);
  AddId("\npfeil");
  SetProp(P_KILL_NAME, "Ein Pfeilhagel");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOGET, "Das geht nicht!\n");
}
