inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein leichter Bogen");
  SetProp(P_LONG, 
    "Dies ist ein leichter Bogen wie ihn die Soeldner aus Avir benutzen. "
    "Da Du aber nie den Umgang mit dem Bogen richtig erlernt hast, wirst "
    "Du ihn kaum richtig benutzen koennen. Und selbst wenn, macht er erst "
    "auf Distanz groesseren Schaden.");
  SetProp(P_NAME, "Bogen");
  SetProp(P_GENDER, MALE);
  AddId( ({"bogen", "leichter bogen"}) );

  SetProp(P_WEAPON_TYPE, WT_BOW);
  SetProp(P_WC, 65); // Im Nahkampf ohne Kenntinisse der Waldlaeufer kaum zu 	
  									//verwenden
  SetProp(P_WC_FIX, 35); // Aber wers versuchen will, bitte
  SetProp(P_WC_BONUS,
    (["Bogenkaempfer":50, "Bogenexperte":120, "Bogenmeister":160]) );
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL:5, MAT_WOOD:95]) );
  SetProp(P_WEIGHT, 360);
  SetProp(P_VALUE, 550);
  SetProp(P_SIZE, 65);
  SetProp(P_QUALITY_DECAY, 150);
}

