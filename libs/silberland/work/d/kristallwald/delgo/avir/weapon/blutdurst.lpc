// Aus Feys Flamberge erstellt...
inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Blutdurst der Vernichter - Die Rache der Schwerter");
  SetProp(P_LONG, 
    "Dieses Schwert ist der gewaltigste Flamberge, den Du je gesehen hast. "
    "Man erkennt die Flamberge an der schmalen, stark gewellten Klinge. "
    "Angeblich soll durch diese Wellung "
    "die Schneidwirkung verstaerkt werden, was sich vor allem bei stark "
    "geruesteten Gegnern bemerkbar macht. In dem Griff ist ein Name "
    "eingraviert. "
    );
  SetProp(P_NAME, "Blutdurst");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  AddId( ({"flamberge", "schwert", "zweihaender", "blutdurst"}) );
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 240);
  SetProp(P_WC_FIX, 40);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":60, "Schwertexperte":120, "Schwertmeister":260]));
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL:97, MAT_PELT:3]) );
  SetProp(P_WEIGHT, 3500);
  SetProp(P_VALUE, 3000);
  SetProp(P_SIZE, 175); //HARHAR
  SetProp(P_QUALITY_DECAY, 130);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:19, P_SIZE:155]) );  
  AddDetail( ({"name"}), "OMAR");
  AddDetail( ({"klinge"}), 
    "Sie ist ca. 1,5 Meter lang und stark gewellt. Sie zerschneidet "
    "garantiert alles, was sich ihr in den Weg stellt. Leg Dich nie mit "
    "ihr an!");
  AddDetail( ({"griff"}), "Realtiv kurz, ist das Schwert somit nur fuer "
    "wahre Meister gedacht. Griffel weg!");
  SetProp(P_WIELD_FUNC, this_object()); //Nur fuer Omar
  SetProp(P_INFO, break_string("Diese Waffe scheint das Blut der Gegner zu "
  	"trinken und den Traeger zu heilen. Allerdings kann sie nur von Omar "
  	"getragen werden."));
  
}

int WieldFunc(object waffe)
{
	if (this_player()->QueryProp(P_NAME) == "Omar")
	{
		return 1;
	}
	else
	{
		write("Diese Waffe wurde Omar geweiht, Du kannst sie nicht zuecken!\n");
		return 0;
	}
}