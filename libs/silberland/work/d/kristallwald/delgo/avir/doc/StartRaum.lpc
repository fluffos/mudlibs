
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "" );
  SetProp( P_INT_LONG,
    "Du gehst durch das Stadttor." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "" }),
    "");



  AddDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");

  /*AddRoomMessage(
    ({""}),30,"func");*/

  //AddCmd( ({ "" }), "" );



  //AddItem( "item" , REFRESH_DESTRUCT);
}
