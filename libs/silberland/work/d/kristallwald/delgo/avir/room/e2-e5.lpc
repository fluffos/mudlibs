
#include "../def.h"

inherit ROOM "std_mauer";  

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Der Suedturm" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Stadtmauer von Avir. Die Zinnen rechts und links von "
    "Dir begrenzen den Weg der Soeldner. Von hier oben hast Du eine gute "
    "Aussicht auf Tethyr und die Stadt. Du bleibst einen Moment stehen und "
    "laesst das alles auf Dich einwirken. Du kannst rauf in den Turm oder "
    "weiter auf der Mauer entlanglaufen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"aussicht"}), "Durch den Turm versperrt.");
  AddDetail( ({ "turm" }),
    "Du kannst ihn durch eine Treppe nach oben betreten.");
    
  AddDetail( ({ "treppe" }),
    "Sie wurde auch aus Stein gebaut. Nur keine Stufen da.");
    
  AddDetail( ({"stufen", "stufe"}),
     "Man koennte es als Rampe bezeichnen.");
     
  AddDetail( ({"rampe"}),
     "Tolles Wort?");
     
  AddDetail( ({"wort"}),
     "Rambo ist auch ein Wort, und zugleich ein Film.");
     
  AddDetail( ({"rambo"}),
     "Nur Teil I ist wirklich gut.");
     
  AddDetail( ({"teil", "teil i", "i"}),
     "Der Rest is Schmarrn.");
     
  AddDetail( ({"rest"}),
     "Erbaermlich.");
     
  AddDetail( ({"schmarrn"}),
     "Du glaubst nicht, wieviel Spass es macht, Spielern bei den "
     "jaemmerlichen Versuchen, Forscherpunkte zu finden, zu beobachten.\nDu "
     "spuerst, wie dieser Ort beobachtet wird.");
     
  AddDetail( ({"film"}),
     ".. ab!");
     
  AddDetail( ({"spass"}),
     "Die Magier lachen Dich aus.");
     
  AddDetail( ({"spieler"}),
     "Die lustigste Rasse ueberhaupt.");
     
  AddDetail( ({"rasse"}),
     "Putzig, putzig. Ich leg mir auch bald welche zu :)");
     
  AddDetail( ({"versuche", "versuch"}),
     "Das grade war einer.");
     
  AddDetail( ({"forscherpunkte", "forscherpunkt"}),
     "Da rennt er! Verfolge ihn!");
  
  
     
  AddDetail( ({"ort"}),
     "...");
  
  AddExit( "westen", ROOM "e2-d5");
  AddExit( "osten", ROOM "e2-f5");
  AddExit( "oben", ROOM "e3-e5");
  
  AddCmd( ({"verfolge", "verfolg"}), "fp");
  
  AddItem( NPC "soeldner_m" 
          , REFRESH_DESTRUCT
          ,([ P_MNPC_AREA : ({  ROOM "e2"}) ])
          );
}
int fp(string str)
{
	if (str == "forscherpunkt")
	{
		write(BS("Schade! Entwischt!"));
		return 1;
	}
	else
	{
		write(BS("Was willst Du verfolgen?"));
		return -1;
	}
}