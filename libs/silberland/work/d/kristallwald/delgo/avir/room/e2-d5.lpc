
#include "../def.h"

inherit ROOM "std_mauer";  

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Die Stadtmauer" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Stadtmauer von Avir. Die Zinnen rechts und links von "
    "Dir begrenzen den Weg der Soeldner. Von hier oben hast Du eine gute "
    "Aussicht auf Tethyr und die Stadt. Du bleibst einen Moment stehen und "
    "laesst das alles auf Dich einwirken. Im Osten siehst Du einen Turm." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"turm"}), 
     "Nein! Wirklich?");
     
  AddDetail( ({"aussicht"}), 
     "Im Sueden kannst Du an der Felswand etwas erkennen.");
     
  AddDetail( ({"sueden"}), 
     "Jemand zeigt mit dem Finger nach Sueden.\nJemand sagt: Da ist "
     "Sueden.");
     
  AddDetail( ({"jemand"}), 
     "*seufz*");
     
  AddDetail( ({"finger"}), 
     "Kleiner Tipp: finger jemand funktioniert nicht.");
     
  AddDetail( ({"tipp"}), 
     "Ein 'p' mehr kann nie schaden.");
     
  AddDetail( ({"felswand"}), 
     "Koennte ein Loch sein.");
     
  AddDetail( ({"loch"}), 
     "Wohl eher eine Oeffnung.");
     
  AddDetail( ({"oeffnung"}), 
     "Sieht aus wie ein Eingang...");
     
  AddDetail( ({"eingang"}), 
     "... zu einer Hoehle.");
     
  AddDetail( ({"hoehle"}), 
     "Wer weiss, wo die hinfuehrt.");
  AddExit( "osten", ROOM "e2-e5");
  AddExit( "westen", ROOM "e2-c5");

}
