
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Der Ostturm" );
  SetProp( P_INT_LONG,
    "Du hast die letzten Meter ueberwunden und stehst nun auf der Spitze "
    "des Turmes. Von hier aus hast Du den Osten des Tales gut im Blick und "
    "da die Felswand auch etwas naeher ist, kannst Du auch einige "
    "Einzelheiten erkennen. Der Wachweg scheint sich etwas veraendert zu "
    "haben.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "himmel" }),
    "Da oben.");
    
  AddDetail( ({ "boden" }),
    "Normaler Steinboden.");
    
  AddDetail( ({ "steinboden" }),
    "Er wird von Normalitaet gepraegt.");
    
  AddDetail( ({ "normalitaet" }),
    "Normalitaet zeichnet sich Durch Abwesenheit von Besonderheiten aus.");
    
  AddDetail( ({ "abwesenheit" }),
    "Sie sind also nicht da.");
    
  AddDetail( ({ "besonderheiten", "besonderheit" }),
    "Wie die Zeichnung auf dem Boden.");
    
  AddDetail( ({ "zeichnung" }),
    "Also gut: So normal ist der Boden auch nicht. Du betrachtest das "
    "Gebilde genauer.");
    
  AddDetail( ({ "gebilde" }),
    "Befolgst Du eigentlich jeden Befehl, den man Dir gibt?");
    
  AddDetail( ({ "befehl" }),
    "Bell mal.\n"
    "Du bellst wie ein Hund.\n"
    "Jemand lacht Dich aus.");
    
  AddDetail( ({ "jemand" }),
    "Jaja, kriegst ja Deine Belohnung.");
    
  AddDetail( ({ "belohnung" }),
    "Das Gebilde stellt einen Pfeil dar.");
    
  AddDetail( ({ "pfeil" }),
    "Er zeigt auf .. na sowas! Ist Dir doch glatt die einzigste kaputte "
    "Zinne auf dem Turm nicht aufgefallen.");
    
  AddDetail( ({ "turm" }),
    "Du stehst drauf? (Wer steht schon auf Tuerme?)");
    
  AddDetail( ({ "tuerme" }),
    "Fast abartig.");
  
  AddDetail( ({ "zinne", "zinnen" }),
    "Eine Zinne scheint in der Mitte abgebrochen zu sein, wer weiss, welche "
    "Kraft dort gewirkt haben muss.");
    
  AddDetail( ({ "mitte" }),
    "Grob gesehen halt.");
    
  AddDetail( ({ "kraft" }),
    "Vermutlich irgendein Geschoss oder eine Kreatur, die im Nebel geflogen "
    "ist.");
    
  AddDetail( ({ "nebel" }),
    "Jemand fragt: Nebel? In 300 Metern Hoehe?\nJemand haut Jemand.\n"
    "Jemand jammert.\nJemand fragt: Aber Paps?\nJemand schleift Jemand an "
    "den Ohren nach Hause.");
    
  AddDetail( ({ "kreatur" }),
    "Naja, die Variante ist wohl unwahrscheinlich.");
    
  AddDetail( ({ "variante" }),
    "Aber moeglich.");
    
  AddDetail( ({ "zensiert", "jemand", "metern", "meter", "hoehe", "paps", 
  	"ohren", "hause", "zinnen" }),
    "ZENSIERT");
    
  AddDetail( ({ "geschoss" }),
    "Vermutlich von einem Katapult.");
    
  AddDetail( ({ "katapult" }),
    "Die Wucht muss die Zinne einfach weggerissen haben.");
    
  AddDetail( ({ "wucht" }),
    "Dir faellt etwas an der Oberflaeche auf.");
    
  AddDetail( ({ "oberflaeche" }),
    "Einige feine Adern fallen Dir auf.");
    
  AddDetail( ({ "adern" }),
    "Dunkles blau.. Avirmithril!");
    
  AddDetail( ({ "avirmithril", "mithril" }),
    "Deswegen sind die Mauern so stabil, sogar dieses Gestein ist von "
    "Mithril durchdrungen. ");
    
  AddDetail( ({ "gestein" }),
    "Wirklich erstaunlich.");
    
  AddDetail( ({ "mauern", "mauer", "stadtmauer" }),
    "Die Stadtmauer von Avir.");
    
  AddDetail( ({ "avir" , "stadt" }),
    "Diese Stadt heisst Avir.");
    
  AddDetail( ({ "spitze" }),
    "Der hoechste Punkt des Turmes.");
    
  AddDetail( ({ "punkt" }),
    ".");
    
  AddDetail( ({ "osten" }),
    "Weg isses.");
    
  AddDetail( ({ "tal" }),
    "Das liegt weit unter Dir.");
    
  AddDetail( ({ "blick" }),
    "Na Deiner! Wessen Blick denn sonst?");
    
  AddDetail( ({ "felswand" }),
    "Sie ist hier etwas naeher als auf der Westseite.");
    
  AddDetail( ({ "westseite" }),
    "Die ist im Westen.");
    
  AddDetail( ({ "westen" }),
    "Schwer zu sehen.");
    
  AddDetail( ({ "einzelheiten" }),
    "Ist da ein Gebaeude am Rand der Felswand?");
    
  AddDetail( ({ "rand" }),
    "Der ist sehr hoch, mindestens 400 Meter.");
    
  AddDetail( ({ "gebaeude" }),
    "Du bist Dir nicht sicher.");
    
  AddDetail( ({ "wachweg" }),
    "Seltsam, scheint sich um eine Seilbahn zu handeln.");
    
  AddDetail( ({ "seilbahn" }),
    "Schau doch einfach nach.");
  AddDetail( ({"durch", "hund", "wer", "zeigt"}), "Nicht so pingelig!");

  AddExit( "unten", ROOM "e3-g3");
	AddItem( NPC "bogenschuetze" , REFRESH_DESTRUCT);
}