
#include "../def.h"

inherit ROOM "std_mauer";  

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Der Die Stadtmauer" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Stadtmauer von Avir. Die Zinnen rechts und links von "
    "Dir begrenzen den Weg der Soeldner. Von hier oben hast Du eine gute "
    "Aussicht auf Tethyr und die Stadt. Du bleibst einen Moment stehen und "
    "laesst das alles auf Dich einwirken. Im Osten siehst Du einen Turm." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"turm", "osten"}), 
     "Der ist nicht gerade klein.");
     
  AddDetail( ({"aussicht"}), 
     "Du kannst hier erstaunlich weit sehen. Bis in den weiten Norden des "
     "Tals.");
     
  AddDetail( ({"norden"}), 
     "Das muss an der klaren Luft liegen, dass Du bis zum Ende des Tals "
     "gucken kannst.");
     
  AddDetail( ({"luft"}), 
     "Du atmest tief ein.");
     
  AddDetail( ({"ende"}), 
     "Du kannst einen Bergpass erkennen.");
     
  AddDetail( ({"bergpass", "pass"}), 
     "Er scheint ueber einen Gletscher zu fuehren...");
     
  AddDetail( ({"gletscher"}), 
     "Wenn man da drueber ist, hat man es fast geschafft und ist am Meer.");
     
  AddDetail( ({"meer"}), 
     "Also das kannst Du von hier aus nicht betrachten. Aber hingehen "
     "kannst Du spaeter allemal noch. Dann kannst Du den Hafen "
     "besichtigen.");
     
  AddDetail( ({"hafen"}), 
     "Von ihm aus kannst Du an das andere Ende des Silberlandes fahren.");
     
  AddDetail( ({"silberland"}), 
     "Damit ist der warme Sueden gemeint.");
     
  AddDetail( ({"sueden", "drum", "dran"}), 
     "Mit Wueste und allem Drum und Dran.");
     
  AddDetail( ({"wueste"}), 
     "Hier ist es schoener.");

  AddExit( "westen", ROOM "e2-c1");
  AddExit( "osten", ROOM "e2-e1");

}
