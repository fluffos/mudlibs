
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Bruecke in den Wolken" );
  SetProp( P_INT_LONG,
    "Du bleibst kurz stehen und laesst Deinen Blick schweifen. Du erkennst "
    "im Norden einen gewaltigen Turm auf einer Plattform. Im Sueden "
    "erblickst Du die Turmspitze eines Wachturmes. Ansonsten gibt es bis "
    "auf die Wolken nicht viel zu sehen."
    );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "himmel" }),
    "Was hast Du jetzt erwartet? An jedem freien Ort in Avir kannst Du den "
    "Himmel sehen. Und jetzt auf einmal soll er weg sein? Natuerlich ist er "
    "noch da, wo er immer war! *grmpf*");
    
  AddDetail( ({ "avir" }),
    "So heisst die Stadt unter Dir.");
    
  AddDetail( ({ "stadt" }),
    "... weit unter Dir.");
    
  AddDetail( ({ "ort" }),
    "Jeder Ort im Freien waere eventuell passender.");
    
  AddDetail( ({ "freien" }),
    "Damit ist das Gegenteil von geschlossenen Raeumen gemeint.");
    
  AddDetail( ({ "raeume", "raeumen", "raum" }),
    "Dies ist keiner.");
    
  AddDetail( ({ "gegenteil" }),
    "Reiz mich bloss nicht weiter und stell Dich nicht so an.");
    
  AddDetail( ({ "boden" }),
    "Dies ist ein Steinboden, wie Du ihn auf jeder normalen Steinbruecke "
    "findest: Er besteht aus kaltem, grauem und hartem Stein.");
    
  AddDetail( ({ "stein" }),
    "Er weist ein Muster auf.");
    
  AddDetail( ({ "muster" }),
    "Mhhh... koennte es ein Schriftzug sein?");
    
  AddDetail( ({ "schriftzug" }),
    "Tatsaechlich! Lies!");
    
  AddReadDetail( ({ "schriftzug" }),
    "Viele Gruesse von Mama!");
    
  AddDetail( ({ "gruesse", "mama" }),
    "Och, das ist aber lieb von Deiner Mama!");
    
  AddDetail( ({ "steinboden", "steinbruecke" }),
    "Kennst Du den: Was haben eine Steinbruecke und ein Steinboden an "
    "Gemeinsamkeiten?");
    
  AddDetail( ({ "gemeinsamkeiten" }),
    "Es gibt nur eine!");
    
  AddDetail( ({ "Gemeinsamkeit" }),
    "Sie sind aus Stein!");
    
  AddDetail( ({ "blick" }),
    "Das machst Du automatisch, wenn Du die Augen offen hast.");
    
  AddDetail( ({ "augen", "auge" }),
    "Du hast sie jetzt offen, sonst wuerdest Du dieses Detail hier nicht "
    "untersuchen koennen.");
    
  AddDetail( ({ "Detail" }),
    "'Detail' ist ein dummes Detail.");
    
  AddDetail( ({ "norden" }),
    "Geh unbedingt hin!");
    
  AddDetail( ({ "sueden" }),
    "Schau doch mal rein!");
    
  AddDetail( ({ "turm" }),
    "Der Turm ruht scheinbar auf einer Plattform. Du kannst immer mehr die "
    "gewaltige Hoehe des Turmes erahnen.");

  AddDetail( ({ "hoehe" }),
    "Er reicht wirklich weit hinauf. Bis in die naechste Schicht aus "
    "Wolken. Dein Gefuehl sagt Dir, er hoert auch danach nicht auf.");
    
  AddDetail( ({ "schicht" }),
    "Der Turm verschwindet ohne absehbares Ende in hoeheren Wolken.");
    
  AddDetail( ({ "wolken", "wolke" }),
    "So nah warst Du bis jetzt kaum an Wolken wie hier oben ueber Avir.");

  AddDetail( ({ "ende" }),
    "Wie das wohl aussieht?");
    
  AddDetail( ({ "gefuehl" }),
    "Du wirst langsam echt neugierig!");
    
  AddDetail( ({ "plattform" }),
    "Wenn Du der Bruecke nach Norden folgst, kommst Du auf eine scheinbar "
    "kreisrunde Plattform. Auch sie wird wie die Bruecke von Zinnen "
    "umgeben.");
    
  AddDetail( ({ "zinnen", "zinne" }),
    "Sie verringern die moegliche Gefahr eines Sturzes um vieles.");
    
  AddDetail( ({ "bruecke" }),
    "Eine Steinbruecke eben.");    
    
  AddDetail( ({ "gefahr" }),
    "Gerade in einem Kampf kann das schnell passieren.");
    
  AddDetail( ({ "kampf" }),
    "Was gehen mich Deine Kaempfe an, kannst doch kaempfen, mit wem Du "
    "willst.");
    
  AddDetail( ({ "kaempfe" }),
    "Langweilig.");
    
  AddDetail( ({ "sturz" }),
    "Der waere hier wahrlich fatal. Denk doch an den schlimmen Aufprall.");
    
  AddDetail( ({ "aufprall" }),
    "Man muesste Stunden schrubben (lassen), um die Reste zu beseitigen.");
    
  AddDetail( ({ "reste" }),
    "Oder abkratzen.");
    
  AddDetail( ({ "stunden" }),
    "Tu das den Reinigungskraeften bitte nicht an.");
    
  AddDetail( ({ "reinigungskraefte" }),
    "Die muessen schon genug schuften.");
    
  AddDetail( ({ "turmspitze" }),
    "Sie scheint nicht wirklich interessant zu sein.");
    
  AddDetail( ({ "wachturm" }),
    "Etwas an der Wand erregt Deine Aufmerksamkeit.");
    
  AddDetail( ({ "aufmerksamkeit" }),
    "Schau Dir die Wand genau an.");
    
  AddDetail( ({ "wand" }),
    "Da scheint Jemand etwas gemalt zu haben.");
    
  AddDetail( ({ "jemand" }),
    "Ist es ein Buchstabe?");
    
  AddDetail( ({ "buchstabe" }),
    "'S'");
    
  AddDetail( ({ "s" }),
    "S? Mh... Da das hier ein jugendfreies MUD ist, heisst es "
    "wahrscheinlich Sueden.");

  AddDetail( ({ "mud" }),
    "MultiUserDungeon.");
    
  AddDetail( ({ "mulituserdungeon" }),
    "MUD.");
    
  AddDetail( ({"decke", "waende"}), "Jaja.");
 
  AddExit( "suedunten", ROOM "e3-e5");
  AddExit( "nordoben", ROOM "e5");

  SetProp(P_HIDE_EXITS, ({"norden", "sueden"}) ); 
  AddExit( "sueden", ROOM "e3-e5");
  AddExit( "norden", ROOM "e5");
  
}