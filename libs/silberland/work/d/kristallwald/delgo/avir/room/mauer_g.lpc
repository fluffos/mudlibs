  AddDetail( ({ "strassen" }),
    "Die Strassen kennst Du schon.");
    
  AddDetail( ({ "gassen" }),
    "Sie fuehren alle zu den Wohnvierteln.");
    
  AddDetail( ({ "wohnviertel", "wohnhaeuser" }),
