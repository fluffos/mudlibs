  Set(P_TRANSPARENT,0);
  Set(P_ADJECTIVES,({}));
  // Set(P_IDS,({}));
  Set(P_WEIGHT,PROTECTED,F_MODE);
  Set(P_TOTAL_WEIGHT,PROTECTED,F_MODE);
  Set(" clean counter ",2);
