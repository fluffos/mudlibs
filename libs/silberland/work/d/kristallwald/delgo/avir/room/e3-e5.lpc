
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Der Suedturm" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in der Mitte des Turmes und kannst nun im Norden "
    "eine Bruecke betreten. Bis auf diese Bruecke gibt es hier ansonsten "
    "nicht viel zu sehen und auch die Aussicht laesst zu wuenschen uebrig. "
    "Wenn Du die Rampe nach oben gehst, kommst Du auf die Turmspitze. "
    );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "waende", "wand" }),
    "Die Waende wurden alles in allem sauber gemauert. In den Fugen siehst "
    "Du keine Kratzer oder Unebenheiten.");

  AddDetail( ({ "fugen", "fuge" }),
    "Mit welcher Masse wurden sie doch gleich gefuellt?");
    
  AddDetail( ({ "masse" }),
    "Dieses Zeug in den Fugen von Mauern.");
    
  AddDetail( ({ "mauer", "stadtmauer" }),
    "Die Stadtmauer von Avir befindet sich unter Dir.");
    
  AddDetail( ({ "stadt", "avir" }),
    "Diese Stadt traegt den stolzen Namen Avir.");
    
  AddDetail( ({ "namen", "name" }),
    "Auf diesen Namen koennen die Bewohner wirklich stolz sein, er hatte "
    "frueher eine erstaunliche Wirkung.");
    
  AddDetail( ({ "bewohner" }),
    "Sie leben gluecklich unten in der Stadt.");
    
  AddDetail( ({ "wirkung" }),
    "Avir war vor langer Zeit beruehmt wegen seiner guten Verteidigung und "
    "seinen Mithrilwaren. Die Stadt war in aller Munde.");
    
  AddDetail( ({ "munde", "mund" }),
    "Verschluck Dich nicht!");
    
  AddDetail( ({ "zeit" }),
    "Die Zeit konnte Avir nicht besiegen.");
    
  AddDetail( ({ "mithrilwaren", "waren" }),
    "Sie waren in aller Lande sehr begehrt.");
    
  AddDetail( ({ "lande", "land" }),
    "So begehrt, dass Neid aufkam.");
    
  AddDetail( ({ "neid" }),
    "Irgendwann fingen dann die Ueberfaelle an.");
    
  AddDetail( ({ "ueberfaelle", "ueberfall" }),
    "Kein einziger noch so grosser Ansturm brachte die Stadt zu Fall.");
    
  AddDetail( ({ "fall" }),
    "Sie steht noch, oder?");
    
  AddDetail( ({ "ansturm" }),
    "Die Verteidigung hielt allen Angriffen stand.");
    
  AddDetail( ({ "angriffe", "angriff", "untergang" }),
    "Das ist lange her, nur noch in alten Buechern findet man etwas "
    "darueber.");
    
  AddDetail( ({ "buecher", "bibliothek" }),
    "Du koenntest ja mal die Bibliothek besuchen.");
    
  AddDetail( ({ "verteidigung" }),
    "Der Wachweg, die Haengebruecke, das Stadttor, die Stadtmauer und "
    "viele gute Kaempfer hielten alles auf.");
    
  AddDetail( ({ "wachweg", "haengebruecke", "stadttor" }),
    "Musst Du Dir ansehen.");
    
  AddDetail( ({ "kaempfer" }),
    "Irgendwann verschwanden sie, die Priester einer vergessenen Gottheit.");
    
  AddDetail( ({ "priester" }),
    "Sie beherrschten die Zauberkunst und den Kampf sehr gut, sie waren "
    "ueberall gefuerchtet.");
    
  AddDetail( ({ "zauberkunst", "kampf" }),
    "Diese Geheimnisse sind mit ihrem Untergang verschwunden.");
    
  AddDetail( ({ "geheimnisse", "geheimnis" }),
    "Netter Versuch :-)");
    
  AddDetail( ({ "versuch" }),
    "Versuch mach kluch.");
    
  AddDetail( ({ "gottheit" }),
    "Es ist unklar, ob nur der Name oder die Gottheit selbst vergessen "
    "ward.");
    
  AddDetail( ({ "name" }),
    "Er wurde vor langer Zeit vergessen.");
    
  AddDetail( ({ "zeug" }),
    "Fing doch mit M an, oder?");
    
  AddDetail( ({ "m" }),
    "M ...m ... MOERTEL!");
    
  AddDetail( ({ "kratzer" }),
    "Keine da.");
    
  AddDetail( ({ "unebenheiten" }),
    "Du schaust noch mal genauer hin und stellst fest, dass da doch ... "
    "nein. Es sind wirklich keine da.");
    
  AddDetail( ({ "moertel" }),
    "An manchen Stellen stimmt etwas nicht mit ihm.");
    
  AddDetail( ({ "stellen", "stelle" }),
    "Sie wirken teilweise heller als andere. Du machst ein paar Schritte "
    "zurueck.");
    
  AddDetail( ({ "schritte", "schritt" }),
    "Du stehst an der gegenueberliegenden Seite und erkennst jetzt ein "
    "Zeichen.");
    
  AddDetail( ({ "seite" }),
    "Da drueben halt.");
    
  AddDetail( ({ "zeichen" }),
    "S");
    
  AddDetail( ({ "s" }),
    "Sueden! Du befindest Dich also im Suedturm.");
    
  AddDetail( ({ "sueden", "suedturm", "turm" }),
    "Du bist drin, Boris!");
    
  AddDetail( ({ "boris" }),
    "Und da sage noch jemand 'Du kommst hier nit rein!'.");

  AddDetail( ({ "boden" }),
    "Ganz normaler Steinboden, wie es in solchen Bauwerken ueblich ist.");
    
  AddDetail( ({ "steinboden" }),
    "Stein.");
    
  AddDetail( ({ "stein" }),
    "Grau, schwer, hart, tut hoellisch weh, wenn Du hinfaellst - Stein!");
    
  AddDetail( ({ "bauwerke", "bauwerk" }),
    "Du hast schon viele gesehen.");
    
  AddDetail( ({ "decke" }),
    "Irgendwo ueber Dir.");
    
  AddDetail( ({ "mitte" }),
    "Das kommt ungefaehr hin.");
    
  AddDetail( ({ "norden", "bruecke" }),
    "Du musst schon rausgehen, wenn Du mehr sehen willst.");
    
  AddDetail( ({ "aussicht" }),
    "Die Aussicht in einem fast geschlossenem Raum ist ... gelinde gesagt "
    "besch...eiden.");
    
  AddDetail( ({ "raum" }),
    "Wo?");
    
  AddDetail( ({ "turmspitze", "spitze" }),
    "Du musst nur die Rampe weiter nach oben.");
    
  AddDetail( ({ "rampe" }),
    "Sie ist eine geniale Konstruktion.");
    
  AddDetail( ({ "konstruktion" }),
    "Sicher und leicht zu begehen. Endlich mal was Anderes.");
    
  AddDetail( ({ "anderes" }),
    "Nicht immer diese langweiligen Treppen.");
    
  AddDetail( ({ "treppen" }),
    "Da tut das Rutschen immer so weh!");
    
  AddDetail( ({ "rutschen" }),
    "... hab ich mir sagen lassen. *huestel*");

  AddExit( "unten", ROOM "e2-e5");
  AddExit( "oben", ROOM "e4-e5");
  AddExit( "nordoben", ROOM "e4-e4");
  
  SetProp(P_HIDE_EXITS, ({"norden"}) );
  AddExit( "norden", ROOM "e4-e4");
  
}
