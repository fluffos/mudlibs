
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Der Westturm" );
  SetProp( P_INT_LONG,
    "Du erwartest dasselbe wie bei den letzten Metern Rampensteigen. Doch "
    "auf einmal bemerkst Du eine Oeffnung im Osten, die zu einer Bruecke "
    "zu fuehren scheint. Der kleine hoelzerne Vorsprung im Sueden kann sich "
    "Deiner Aufmerksamkeit ebensowenig entziehen."
    );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "decke" }),
    "Sie ist noch weit ueber Dir.");
    
  AddDetail( ({ "waende" }),
    "Naja, da der Turm rund ist, ist es nur eine Wand.");
    
  AddDetail( ({ "wand" }),
    "Wird wohl nichts mit den eigenen vier Waenden.");
    
  AddDetail( ({ "boden" }),
    "Er besteht wie die Rampe aus Felsbloecken.");
    
  AddDetail( ({ "stadt" , "avir" }),
    "Diese Stadt heisst Avir.");
    
  AddDetail( ({ "westturm" , "turm" }),
    "Wenn Du Dich genau umschaust, findest Du ihn auch.");
    
  AddDetail( ({ "rampe" }),
    "Die Felsbloecke haben hier alle die gleiche Farbe.");
    
  AddDetail( ({ "felsbloecke", "bloecke", "felsblock", "block" }),
    "Sie haben alle den gleichen Farbton.");
    
  AddDetail( ({ "farbton" }),
    "Gleich.");
    
  AddDetail( ({ "farbe" }),
    "Auch wenn Dir einige dunkler erscheinen, alle sind grau.");
    
  AddDetail( ({ "grau" }),
    "Obwohl man einige schon als anthrazitfarbene Felsbloecke bezeichnen "
    "moechte.");
    
  AddDetail( ({ "anthrazitfarbene felsbloecke" }),
    "Dir faellt eine Form auf.");
    
  AddDetail( ({ "form" }),
    "Mehrere Zacken.");
    
  AddDetail( ({ "zacken" }),
    "Sie scheinen einen Buchstaben zu ergeben.");
    
  AddDetail( ({ "buchstaben" }),
    "\n  /\\  /\\\n"
    " /  \\/  \\\n"
    "M?"
    );

  AddDetail( ({ "m" }),
    "Unwahrscheinlich. Du kannst es ja mal von Rechts versuchen.");

  AddDetail( ({ "rechts" }),
    "\n \\  /\\  /\n"
    "  \\/  \\/\n"
    "Ahh, es ist ein W."
    );

  AddDetail( ({ "w" }),
    "Das steht bestimmt fuer Westen. Ein M wuerde da wirklich keinen Sinn "
    "machen.");
    
  AddDetail( ({ "sinn" }),
    "Mesten?");
    
  AddDetail( ({ "mesten" }),
    "Nein, nun wirklich nicht. Sonst wuerde es ja auch heissen 'Im Mesten "
    "nichts Neues'.");
    
  AddDetail( ({ "neues" }),
    "Lassen wir das.");
    
  AddDetail( ({ "westen" }),
    "Du bist im Westturm.");
    
  AddDetail( ({ "selbe" }),
    "Naja, Mauer und Rampe eben.");
    
  AddDetail( ({ "mauer" }),
    "Meinst Du die Stadtmauer?");
    
  AddDetail( ({ "stadtmauer" }),
    "Sie gehoert zu Avir.");
    
  AddDetail( ({ "meter" }),
    "Eine Laengenangabe.");
    
  AddDetail( ({ "laengenangabe" }),
    "Ohne waeren viele Dinge sehr schwer.");
    
  AddDetail( ({ "dinge" }),
    "Damit ist nicht das Gewicht gemeint.");
    
  AddDetail( ({ "gewicht" }),
    "Damit ist NICHT das Gewicht gemeint.");
    
  AddDetail( ({ "nicht" }),
    "Du bringst mich noch zur Verzweiflung.");
    
  AddDetail( ({ "verzweiflung" }),
    "...");
    
  AddDetail( ({ "rampe" }),
    "Du stehst auf ihr.");
    
  AddDetail( ({ "rampensteigen" }),
    "Es heisst ja auch Treppensteigen.");
    
  AddDetail( ({ "treppensteigen" }),
    "Als man aus der Rampe eine Treppe machte (warum auch immer), entstand "
    "dieser Begriff.");
    
  AddDetail( ({ "begriff" }),
    "'Treppensteigen' klingt komisch, leitet sich aber nun eimal aus seinem "
    "Ursprung her.");
    
  AddDetail( ({ "ursprung" }),
    "Rampensteigen.");
    
  AddDetail( ({ "treppe" }),
    "Sie wurde aus der Rampe entwickelt.");
    
  AddDetail( ({ "oeffnung", "osten", "bruecke" }),
    "Geh doch einfach hin, dann erkennst Du mehr.");
    
  AddDetail( ({ "sueden" }),
    "Na dort! *fingerzeig*");
    
  AddDetail( ({ "aufmerksamkeit" }),
    "Fein gemacht.");
    
  AddDetail( ({ "vorsprung" }),
    "Er wurde mit Leim an der Wand befestigt. Es scheint sich um eine "
    "Ablage zu handeln.");
    
  AddDetail( ({ "leim" }),
    "Holzleim natuerlich.");
    
  AddDetail( ({ "holzleim" }),
    "Fuer das Holz.");
    
  AddDetail( ({ "holz" }),
    "Die Ablage ist aus Holz.");
    
  AddDetail( ({ "ablage" }),
    "Sie ist ca. einen halben Meter lang und breit. Einige Abdruecke "
    "erklaeren, wozu sie dient.");
    
  AddDetail( ({ "abdruecke", "abdruck" }),
    "Sie sind kreisrund, scheinen von Flaschen zu kommen.");
    
  AddDetail( ({ "flaschen", "flasche" }),
    "Scheint, als wuerden die Soeldner oefters mal einen kippen.");
    
  AddDetail( ({ "soeldner", "saeufer" }),
    "Solche Saeufer.");
  
  AddDetail( ({"ahh", "im"}), "Nicht so pingelig!");
 
  AddExit( "unten", ROOM "e2-c3");
  AddExit( "oben", ROOM "e4-c3");
  AddExit( "ostoben", ROOM "e4-d3");
  
  SetProp(P_HIDE_EXITS, ({"osten"}) );
  AddExit( "osten", ROOM "e4-d3");

}
