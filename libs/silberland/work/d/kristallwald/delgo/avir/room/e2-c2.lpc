
#include "../def.h"

inherit ROOM "std_mauer";  

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Die Stadtmauer" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Stadtmauer von Avir. Die Zinnen rechts und links von "
    "Dir begrenzen den Weg der Soeldner. Von hier oben hast Du eine gute "
    "Aussicht auf Tethyr und die Stadt. Du bleibst einen Moment stehen und "
    "laesst das alles auf Dich einwirken. Im Sueden kannst Du einen Turm "
    "sehen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"turm"}), 
     "Er ist extrem hoch und geht recht in die Breite.");
     
  AddDetail( ({"breite"}),
     "Warum ist er nur so gross?");
  
  AddDetail( ({"aussicht"}),
     "Du kannst hier gut nach Westen schauen.");
     
  AddDetail( ({"westen"}),
     "Die dichte Decke der Baumkronen verwehrt Dir einen genaueren Einblick "
     "auf das Geschehen im Wald. Aber auch, wenn es dort ruhig ist, lauert "
     "die Gefahr besonders im Wald.");
  
  AddDetail( ({"decke"}),
     "Die Baeume scheinen alle fast gleich hoch zu sein.");
     
  AddDetail( ({"baeume", "baum"}),
     "Nur ab und an ist einer mal 2 Meter hoeher.");
     
  AddDetail( ({"meter"}),
     "Oder auch tiefer.");
     
  AddDetail( ({"baumkronen", "baumkrone", "kornen", "krone"}),
     "Das ist ein Nadelwald, da von Baumkronen zu sprechen ist wirklich ... "
     "sinnfrei.");
     
  AddDetail( ({"nadelwald"}),
     "Kennst Du nicht das Sprichwort: Wie die Nadel im Tethyrwald?");
     
  AddDetail( ({"sprichwort", "tethyrwald", "copyright", "delgo", "nadel"}),
     "Copyright by Delgo.");
     
  AddDetail( ({"einblick"}),
     "*nix einblix*");
     
  AddDetail( ({"geschehen"}),
     "Wie sollst Du das herausfinden, wenn Du nie runter gehst?");
     
  AddDetail( ({"gefahr"}),
     "Gefaehrliche Kreaturen.");
     
  AddDetail( ({"kreaturen", "kreatur"}),
     "Du bist ihnen noch nicht begegnet? Dann hattest Du Glueck...");
     
  AddDetail( ({"glueck"}),
     "Dein Glueck...");

  
  AddExit( "sueden", ROOM "e2-c3");
  AddExit( "norden", ROOM "e2-c1");

}
