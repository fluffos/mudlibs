
#include "../def.h"

inherit "std/room";

#include <properties.h>


void create() 
{
  ::create();

  AddDetail( ({ "avir" }),
    "Diese Stadt heisst Avir.");
    
  AddDetail( ({ "stadtmauer", "mauer" }),
    "Sie ist wirklich beeindruckend hoch und von hier aus betrachtet, "
    "gewinnt sie nochmals einiges an Hoehe.");
    
  AddDetail( ({ "hoehe" }),
    "Die Mauer ist sage und schreibe 20 Meter hoch.");
    
  AddDetail( ({ "meter" }),
    "Wenn man die 200 von dem Plateau dazunimmt...");
    
  AddDetail( ({ "plateau" }),
    "Oh oh... Du befindest Dich hier 220 Meter ueber dem Erdboden.");
    
  AddDetail( ({ "erdboden" }),
    "Man koennte auch sagen, Waldboden.");
    
  AddDetail( ({ "waldboden" }),
    "Das ganze Tal ist ein einziger, grosser Wald.");
    
  AddDetail( ({ "tal" }),
    "Wie alt es wohl sein mag?");
    
  AddDetail( ({ "wald" }),
    "Wirklich einer der schoensten Waelder, die Du je gesehen hast.");
    
  AddDetail( ({ "waelder" }),
    "Du kennst viele, aber keiner ist vergleichbar mit diesem Wald hier.");
    
  AddDetail( ({ "zinnen", "zinne" }),
    "Sie sehen etwa so aus:\n"
    "____      ____      ____\n"
    "    |    |    |    |\n"
    "    |____|    |____|   \n");
    
  AddDetail( ({ "weg" }),
    "Der Weg ist durch die Zinnen relativ sicher zu begehen. Er besteht wie "
    "die ganze Mauer aus Stein.");
    
  AddDetail( ({ "stein" }),
    "Besser gesagt: Steinbloecke.");
    
  AddDetail( ({ "steinbloecke", "bloecke", "steinblock", "block" }),
    "Man koennte auch sagen, Steinquader.");
    
  AddDetail( ({ "steinquader", "quader" }),
    "Die ganze Mauer wurde sauber aus riesigen Steinquadern "
    "zusammengesetzt. Ein Bauwerk fuer die Ewigkeit bestimmt.");
    
  AddDetail( ({ "ewigkeit" }),
    "Und noch viel weiter!");
    
  AddDetail( ({ "bauwerk" }),
    "Und zum wiederholten Male staunst Du ueber die geniale Architektur "
    "Avirs.");
    
  AddDetail( ({ "male", "mal" }),
    "Wenn Du es wissen willst: Es ist das "+random(20)+"te Mal.");
    
  AddDetail( ({ "architektur" }),
    "Wenn eine Stadt so lange existiert wie Avir, wird sie wohl gut "
    "durchdacht sein.");
    
  AddDetail( ({ "himmel" }),
    "Auch Avir hat einen.");
    
  AddDetail( ({ "boden" }),
    "Kein Boden, aber besser: ein Weg!");
    
  AddDetail( ({ "soeldner" }),
    "Du hast bestimmt schon welche getroffen.");
    
  AddDetail( ({ "stadt" }),
    "Die Aussicht auf die Stadt ist Wahnsinn. Du erkennst die Strassen und "
    "vielen Gassen. Auch die Wohnhaeuser kann man gut erkennen.");
    
  AddDetail( ({ "wahnsinn" }),
    "Jeder Magier wird irgendwann mal... anders *kicher*");
    
  AddDetail( ({ "magier" }),
    "Die Evolution bringt unweigerlich welche hervor.");
    
  AddDetail( ({ "evolution" }),
    "Spieler -> Seher -> Erzseher -> Magier\n"
    "                 \\           /\n"
    "                  `   --->  \´\n");
    
  AddDetail( ({ "spieler", "seher", "erzseher" }),
    "Da huelle ich mich gekonnt in Schweigen...");
    
  AddDetail( ({ "ich" }),
    "Jemand huellt sich in Schweigen.");
    
  AddDetail( ({ "jemand" }),
    "Jemand sagt: Ich nix da.");
    
  AddDetail( ({ "schweigen" }),
    "\n");
    
  AddDetail( ({ "strassen" }),
    "Die Strassen kennst Du schon.");
    
  AddDetail( ({ "gassen", "gasse" }),
    "Sie fuehren alle zu den Wohnvierteln.");
    
  AddDetail( ({ "wohnviertel", "wohnhaeuser", "haeuser", "haus", "viertel",
    "wohnhaus" }),
    "Sie lohnen einen Besuch nicht.");
    
  AddDetail( ({ "besuch" }),
    "Sie sind langweilig, weil sie alle gleich sind. Ausserdem sind sie "
    "Privateigentum.");
    
  AddDetail( ({ "privateigentum" }),
    "Der Bewohner natuerlich!");
    
  AddDetail( ({ "bewohner" }),
    "Du bist keiner.");
    
  AddDetail( ({ "moment" }),
    "Die frische Luft, die Aussicht und die Ruhe.");
    
  AddDetail( ({ "tethyr" }),
    "Geniess die Aussicht!");
    
  AddDetail( ({ "luft" }),
    "Frisch.");
    
  AddDetail( ({ "ruhe" }),
    "Ruhig.");
	AddDetail( ({"das","gesicht","gleichgewicht","windboee"}), "...");
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst gedaempft den Laerm der Stadt.");

  AddSound( ({ "laerm", "stadt" }),
    "Von hier oben hoert sich das alles so fremdartig an. Das liegt "
    "wahrscheinlich daran, dass es hier sehr ruhig ist. Das Stadtgeschehen "
    "wirkt so weit weg...");

  AddSound( ({ "stadtgeschehen" }),
    "Wenn Du es geniessen willst, musst Du wieder runter.");

  AddSmell( DEFAULT_SMELL,
    "Nur vereinzelte Gerueche erreichen hier oben Deine Nase.");

  AddSmell( ({ "nase" }),
    "Das wuerde ich gerne sehen.");
    
  AddDetail( ({ "gerueche" }),
    "Du kannst keinen genau definieren, zu schnell traegt sie der Wind "
    "wieder fort.");
    
  AddDetail( ({ "wind" }),
    "Bist Du Dir sicher, dass DAS geht?");
    
    
  AddRoomMessage( 
  ({
  	"Eine Windboee bringt Dich etwas aus dem Gleichgewicht.\n",
  	"Der Wind streift kalt um Dein Gesicht.\n",
  	"Alles ruhig hier oben.\n",
  }), 60);

}
