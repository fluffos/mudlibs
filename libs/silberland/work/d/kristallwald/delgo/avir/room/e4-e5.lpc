
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Der Suedturm" );
  SetProp( P_INT_LONG,
    "Du bist endlich oben auf dem Turm. Im Norden siehst Du die Bruecke aus "
    "den Wolken ragen. Sie scheint zu einem groesseren Bauwerk zu fuehren. "
    "Im Sueden kannst Du den Wald betrachten, welcher ruhig unter Dir "
    "liegt. Die Zinnen verhindern, dass Du Dich dem Wald zu schnell "
    "naeherst.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "himmel" }),
    "Untersuch doch lieber den Boden.");
    
  AddDetail( ({ "boden" }),
    "Untersuch doch lieber den Himmel.");
    
  AddDetail( ({ "turm" }),
    "Du bist ganz oben. Man koennte sagen, Du bist auf dem Hoehepunkt.");
    
  AddDetail( ({ "hoehepunkt" }),
    "Und wem hast Du das zu verdanken? Genau, MIR! (der tapfere Magier "
    "hinter diesen Raeumen)");
    
  AddDetail( ({ "magier" }),
    "Auch wenn Du sie nicht leiden kannst, ohne sie kannst Du nicht "
    "mudden.");
    
  AddDetail( ({ "mir" }),
    "Wer koennte sie jemals vergessen, die russische Raumstation.");
    
  AddDetail( ({ "raumstation" }),
    "Ein Agent kommt an.\nEin Agent kommt an.\nEin Agent: Woher wissen sie "
    "davon?");
    
  AddDetail( ({ "agent" }),
    "Ein zweiter Agent: Er hat uns bemerkt, wir muessen sein Gedaechtnis "
    "loeschen.");
    
  AddDetail( ({ "gedaechtnis" }),
    "Die Agenten laecheln Dich an und kommen langsam auf Dich zu.");
    
  AddDetail( ({ "agenten" }),
    "Du wachst auf und weisst nichts mehr von Agenten oder weisst, was "
    "'Raumstation' bedeutet.");
    
  AddDetail( ({ "raeume" }),
    "Sie sind relativ ... . (Spieler: Ihr duerft eine Bewertung einfuegen. "
    "Philosophen: Bitte frei lassen.)");
    
  AddDetail( ({ "spieler" }),
    "Die stinken so.");
    
  AddDetail( ({ "bewertung" }),
    "Sch...");
    
  AddDetail( ({ "philosophen", "philosoph" }),
    "Die reden wirres Zeug.");
    
  AddDetail( ({ "zeug" }),
    "Oder untersuchen jeden Muell, den sie finden.");
    
  AddDetail( ({ "muell" }),
    "In Avir gibts keinen!");
    
  AddDetail( ({ "avir", "stadt" }),
    "Avir heisst diese Stadt.");

  AddDetail( ({ "norden" }),
    "Du laesst Deinen Blick nach Norden schweifen und findest einen der "
    "praechtigsten Anblicke ueberhaupt: Wie im Maerchen siehst Du, wie eine "
    "Bruecke aus den Wolken ragt.");
    
  AddDetail( ({ "blick" }),
    "Guckst Du weita!");
    
  AddDetail( ({ "anblicke", "anblick" }),
    "Du musst zugeben, es hat etwas unheimlich romantisches, dies bei einem "
    "Sonnenuntergang zu geniessen...");
    
  AddDetail( ({ "sonnenuntergang" }),
    "Da kriegst Du jede ru... *huestel* menge Glueckshormone.");
    
  AddDetail( ({ "glueckshormone", "menge" }),
    "Themenwechsel.");
    
  AddDetail( ({ "themenwechsel" }),
    "Untersuch doch lieber Boden und Himmel.");
    
  AddDetail( ({ "maerchen" }),
    "Mir faellt jetzt keines ein, aber dieser Anblick wuerde super in "
    "eines passen.");
    
  AddDetail( ({ "bruecke" }),
    "Du bist erstaunt, wie dieses Bauwerk haelt.");
    
  AddDetail( ({ "bauwerk" }),
    "Langsam beschleicht Dich der Verdacht, dass hier Magie ihre Finger "
    "im Spiel hatte.");
    
  AddDetail( ({ "verdacht" }),
    "Wie sonst sollten solche phantastischen Bauten entstehen.");
    
  AddDetail( ({ "bauten" }),
    "Die Bruecke, der Turm im Norden...");
    
  AddDetail( ({ "magie" }),
    "Sie wurde frueher sehr oft verwendet.");
    
  AddDetail( ({ "finger" }),
    "...");
    
  AddDetail( ({ "spiel" }),
    "Das war doch nicht woertlich gemeint.");
    
  AddDetail( ({ "bauwerk", "turm im norden" }),
    "Es ist tatsaechlich ein Turm! Jetzt bist Du wirklich neugierig, was "
    "Dich dort erwartet.");
    
  AddDetail( ({ "wolken", "wolke" }),
    "Die Wolkendecke ist einige Meter unter Dir.");
    
  AddDetail( ({ "meter" }),
    "Es sind einige.");
    
  AddDetail( ({ "wolkendecke" }),
    "Sie ist sehr dicht, und Du kannst nur an einigen Stellen durch sie "
    "durchblicken.");
    
  AddDetail( ({ "stellen", "stelle" }),
    "Ueber Avir gibt es solche kaum. Aber den Wald kannst Du recht gut "
    "erkennen.");
    
  AddDetail( ({ "sueden" }),
    "Dort befindet sich der Wald.");
    
  AddDetail( ({ "wald" }),
    "Durch seine blaue Faerbung geht eine seltsame und kalte Aura von ihm "
    "aus.");
    
  AddDetail( ({ "faerbung", "aura" }),
    "Es sieht so aus, als wuerde der ganze Wald von Eiskristallen "
    "ueberzogen sein. Ein mystisches Blau.");
    
  AddDetail( ({ "eiskristalle", "kristalle", "eiskristall", "kristall" }),
    "Die Vorstellung erscheint Dir seit einiger Zeit nicht mehr sehr "
    "laecherlich.");
    
  AddDetail( ({ "zeit" }),
    "Du hast ja schon einiges gesehen. Ein eingefrorener Wald koennte in "
    "Dein Weltbild passen.");
    
  AddDetail( ({ "weltbild" }),
    "Wird es nur von Phantasie beherrscht?");
    
  AddDetail( ({ "phantasie" }),
    "Sie ist sehr wichtig, aber zuviel ist schaedlich. Dann wird man "
    "Magier.");
    
  AddDetail( ({ "vorstellung" }),
    "Ein ganzer Wald? Ueberzogen von Eis?");
    
  AddDetail( ({ "eis" }),
    "Du bist Dir nicht sicher.. ach, so ein Unsinn. Der Wald ist einfach "
    "nur blau.");
    
  AddDetail( ({ "unsinn" }),
    "Der Wald ist nicht gefroren.");
    
  
  
    
  AddDetail( ({ "blau" }),
    "Eine schoene Farbe.");
    
  AddDetail( ({ "farbe" }),
    "Du weisst nicht, wo Du sie zuordnen sollst: Dem Eis, dem Meer, dem "
    "Himmel ... So eines hast Du noch nie gesehen.");
    
  AddDetail( ({ "meer" }),
    "Nicht hier.");
    
  AddDetail( ({ "zinnen", "zinne" }),
    "Sie halten Dich von irgendwelchen unbeabsichtigten selbstmoerderischen "
    "Unternehmen ab.");
    
  AddDetail( ({ "unternehmen" }),
    "Oder ist es gar kein Selbstmord, wenn Du unabsichtlich hier stuerzt?");
    
  AddDetail( ({ "selbstmord" }),
    "Da runter zu fallen, waere eindeutig toedlich.");
    
  AddExit( "unten", ROOM "e3-e5");

  AddItem( NPC "bogenschuetze" , REFRESH_DESTRUCT);
}
