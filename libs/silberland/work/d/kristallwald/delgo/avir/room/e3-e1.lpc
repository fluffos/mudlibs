
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Der Nordturm" );
  SetProp( P_INT_LONG,
    "Nach einigen Stufen bist Du fast am oberen Ende des Turmes angelangt. "
    "Allerdings faellt Dir hier etwas auf, was Du bis jetzt kaum in einem "
    "anderen Turm gesehen hast. Im Sueden gibt es eine Oeffnung, durch die "
    "man eine Bruecke betreten kann. Nach oben fuehren die letzten Meter "
    "zur Turmspitze."
    );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "boden" }),
    "Er besteht wie ueberall auf der Mauer aus Steinbloecken.");
    
  AddDetail( ({ "mauer", "stadtmauer" }),
    "Damit ist die Stadtmauer von Avir gemeint. Sie umgibt die komplette "
    "Stadt und Du befindest Dich hier im Nordturm.");
    
  AddDetail( ({ "steinbloecke" }),
    "Seltsam. Einige Steinbloecke sind heller als die anderen.");
    
  AddDetail( ({ "helle steinbloecke" }),
    "Sie bilden ein Muster.");
    
  AddDetail( ({ "muster" }),
    "Sieht aus wie ein Buchstabe.");
    
  AddDetail( ({ "buchstabe" }),
    "Z");
    
  AddDetail( ({ "z" }),
    "Was soll denn hier ein Z im Boden? Ein X haettest Du ja noch "
    "verstanden. Eventuell solltest Du das aus einem anderen Winkel "
    "betrachten.");
    
  AddDetail( ({ "x" }),
    "Hier graben fuer Schatz!");
    
  AddDetail( ({ "schatz" }),
    "Grab!");
    
  AddDetail( ({ "grab" }),
    "Deines?");
 
  AddDetail( ({ "winkel" }),
    "90 Grad?");
    
  AddDetail( ({ "grad" }),
    "Was kommt da wohl raus?");
    
  AddDetail( ({ "n" }),
    "Stimmt, das N steht bestimmt fuer Norden. Du scheinst Dich im Nordturm "
    "zu befinden.");
    
  AddDetail( ({ "stadt", "avir" }),
    "Diese Stadt heisst Avir.");
  
  AddDetail( ({ "norden", "nordturm", "turm" }),
    "Du stehst mittendrin.");
    
  AddDetail( ({ "waende" }),
    "Im Grunde genommen ist es nur eine Wand, denn der Turm ist ja rund.");
    
  AddDetail( ({ "grunde", "grund" }),
    "Das solltest Du ergruenden.");
    
  AddDetail( ({ "wand" }),
    "Sie wurde sehr exakt gemauert und Du erkennst keine Fehler an ihr.");
    
  AddDetail( ({ "fehler" }),
    "iN diehser maur sint, apsolud geine fehler.");
    
  AddDetail( ({ "decke" }),
    "Diese befindet sich unter Dir. Da, wo sie schon immer war, ist und "
    "sein wird. UNTEN!");
    
  AddDetail( ({ "unten" }),
    "Natuerlich ist sie unten, wenn Du einen Handstand machst.");
    
  AddDetail( ({ "handstand" }),
    "Es sieht langsam laecherlich aus.");
    
  AddDetail( ({ "stufen" }),
    "Ach, Du wirst Dich nie daran gewoehnen. Es ist ja eine Rampe, die hat "
    "folglich keine Stufen.");
    
  AddDetail( ({ "rampe" }),
    "Eine Wendelrampe genau genommen.");
    
  AddDetail( ({ "wendelrampe" }),
    "Sie fuehrt aehnlich wie eine Spirale im Inneren des Turmes nach oben "
    "und unten.");
    
  AddDetail( ({ "spirale" }),
    "Das kennst Du bestimmt. Man verwendet sie um ... naja. Oehm ... "
    "*huestel* ... *schaem* so mit Fluessigkeit, aufhalten... sowas wie ne "
    "Wasserrutsche.");
    
  AddDetail( ({ "wasserrutsche" }),
    "Nur eben ohne Wasser und Rutsche.");
    
  AddDetail( ({ "wasser", "fluessigkeit" }),
    "Nass.");
    
  AddDetail( ({ "rutsche" }),
    "Sag mal, wie alt bist Du eigentlich?");
    
  AddDetail( ({ "inneres", "innere" }),
    "Sie aussen entlang zu bauen, waere eine tolle Variante, aber bei "
    "Regen ...");
    
  AddDetail( ({ "regen" }),
    "Womit wir wieder bei der Wasserrutsche waeren.");
    
  AddDetail( ({ "variante" }),
    "Merk sie Dir fuer spaeter.");
    
  AddDetail( ({ "ende", "tuerme" }),
    "Irgendwann endet alles einmal, auch die Tuerme von Avir.");
    
  AddDetail( ({ "sueden" }),
    "Eine Oeffnung.");
    
  AddDetail( ({ "oeffnung" }),
    "Sie fuehrt nach draussen auf eine Bruecke, welche steil nach Suedoben "
    "fuehrt.");
    
  AddDetail( ({ "suedoben" }),
    "Sie scheint sich ueber ganz Avir zu spannen.");
    
  AddDetail( ({ "bruecke" }),
    "Du musst schon rausgehen, um mehr zu erkennen.");
    
  AddDetail( ({ "meter" }),
    "Du siehst schon die Decke.");
    
  AddDetail( ({ "turmspitze" }),
    "Du bist gespannt, welche Aussicht man von da hat.");
    
  AddDetail( ({ "aussicht" }),
    "Hier ist sie nicht sehr ueberwaeltigend. Die einzige Oeffnung im "
    "Sueden laesst gerade genug Licht herein, um etwas zu erkennen.");
    
  AddDetail( ({ "licht" }),
    "Deswegen kannst Du nicht so gut sehen.");
    
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen des Windes.");

  AddSound( ({ "rauschen", "wind" }),
    "*rausch*");

  AddExit( "unten", ROOM "e2-e1");
  AddExit( "suedoben", ROOM "e4-e2");
  AddExit( "oben", ROOM "e4-e1");

  SetProp(P_HIDE_EXITS, ({"sueden"}) );
  AddExit( "sueden", ROOM "e4-e2");
  
  AddCmd( ({"grab", "graben", "grabe"}), "schatz");
  
}

int schatz()
{
	write("Du graebst ein Grab.\n");
  say( TPN+" graebt ein Grab.\n");
  return 1;
}
