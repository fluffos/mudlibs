
#include "../def.h"

inherit "std/laden";
#include <laden.h>

#include <properties.h>




void create() 
{
  string datum, dat;
  
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp(P_INT_SHORT,"In einem Waffenladen.");
	SetStorageRoom(ROOM "lagerraum_w" );
	SetProp(P_SPECIAL_SHOP,
    ([P_WC: "Schau Dich mal um, das ist ein Waffenladen! Wir kaufen nur "
    "Wafffen!\n"]) );
  AddDetail( ({ "tafel" }),
    "Lies sie doch mal!");
  AddDetail( ({ "boden" }),
    "Aus Stein.");
  AddDetail( ({ "stein", "steine" }),
    "Viele Pflastersteine nebeneinander.");
  AddDetail( ({ "pflastersteine", "pflasterstein", "stein", "steine" }),
    "Sie wurden sauber verfugt.");
  AddDetail( ({ "fugen", "fuge" }),
    "Ha! Doch nicht so sauber! In einer Fuge erkennst Du einen Spalt.");
  AddDetail( ({ "spalt" }),
    "Was mag da wohl lauern? Ein Zaubertrank? Ein magisches Schwert? Greif "
    "einfach mal rein...");
  AddSpecialDetail( ({ "zaubertrank"}), "zt");
    
  AddDetail( ({ "schwert" }),
    "Excalibur ist wieder Dein!");
    
  AddDetail( ({ "excalibur" }),
    "Excalibur sagt: Hey Arti! Schoen, dass Du mich endlich gefunden hast "
    "*freu*\n"
    "Excalibur sagt: Als naechstes muessen wir... oh.. Du bist ja gar net "
    "Arti!\n"
    "Excalibur streckt Dir die Zunge raus.\n"
    "Excalibur verschwindet mit Knall und Schwefelduft.\n");
    
  AddDetail( ({ "arti" }),
    "Wie bereits gesagt, Du bist es nicht.");
    
  AddDetail( ({ "zunge" }),
    "Stellt sich natuerlich die Frage, ob ein Schwert seine Zunge "
    "ueberhaupt einziehen kann.");
    
  AddDetail( ({ "frage", "antwort" }),
    "Antwort: Nur im Theater.");
    
  AddDetail( ({ "theater" }),
    "Na diese Attrappen, wo die Klinge bei geringem Druck im Griff "
    "verschwindet.");
    
  AddDetail( ({ "attrappen", "attrappe" }),
    "Ich wuerde sie Dir ja zeigen, habe aber im Moment leider nur echte "
    "Schwerter.");
    
  AddDetail( ({ "moment" }),
    "Du hoerst Jemanden in der Ferne diabolisch lachen.");
    
  AddDetail( ({ "jemanden", "jemand" }),
    "Glaub mir, das willst Du nicht wissen.");
  
  AddDetail( ({ "ferne" }),
    "Jemand tippt Dir auf die Schulter.");
    
  AddDetail( ({ "schulter" }),
    "Wow! Was fuer eine Schulter! Einfach unbeschreiblich.");
    
  AddDetail( ({ "klinge" }),
    "Mit viel Phantasie kann man sie auch als Zunge sehen.");
    
  AddDetail( ({ "phantasie" }),
    "Du bist hier in nem Rollenspiel! Streng Dich gefaelligst an!");
    
  AddDetail( ({ "rollenspiel" }),
    "Ich moechte mir jetzt jegliche perverse Anspielung verbieten!");
    
  AddDetail( ({ "anspielung" }),
    "SHERRIF!");
    
  AddDetail( ({ "sheriff" }),
    "Kommt glei...");
    
  AddDetail( ({ "druck" }),
    "Der entsteht, wenn man die falsche Klinge irgendwo gegen drueckt.");
    
  AddDetail( ({ "griff" }),
    "Muss dann natuerlich laenger sein als die Zunge.");
    
  AddDetail( ({ "waende", "decke", "wand" }),
    "Was soll man sagen, ueberall Waffen.");
    
  AddDetail( ({ "waffen", "waffen" }),
    "Einfach alles, was das (nichtdruidische) Herz begehrt!");
    
  AddDetail( ({ "herz" }),
    "Herzzerreissend, der Anblick!");
    
  AddDetail( ({ "anblick" }),
    "Du vergiesst eine Traene.");
    
  AddDetail( ({ "traene" }),
    "Weichei.");
    
  AddDetail( ({ "weichei" }),
    "Ich hab meine lieber hartgekocht, aber das kann ja jeder halten, wie "
    "er will.(Fruehstueckseier, wohl gemerkt!)");
    
  AddDetail( ({ "fruehstueckseier" }),
    "Das hab ich fuer solche wie Dich gesagt!");
    
  AddDetail( ({ "theke" }),
    "Sie ist wie alles hier (ausser den Waffen) aus Stein. Ueber diese "
    "Theke sind bestimmt schon viele Waffen gegangen, manchmal auch ein "
    "paar magische...");
    
  AddDetail( ({ "schwerter" }),
    "Solltest Du kennen.");
    
  AddDetail( ({ "knall" }),
    "*KNALL*");
    
  AddDetail( ({ "schwefelduft" }),
    "Sieht gut aus!");
 
  AddDetail( ({ "nichts" }),
    "Gar nichts!");
    
  AddDetail( ({ "langsamen" }),
    "                                        O\n"
    "                                       o\n"
    "Du faengst an zu denken.              .\n"
    "Riesige Rauchwoelkchen steigen auf... \n");
  AddDetail( ({ "waffenladen", "laden" }), "Schwer zu finden, ich weiss.");
    
  AddDetail( ({ "Du" }),
    "..bist zu neugierig!");
    
  AddDetail( ({ "rauchwoelkchen" }),
    "Ich wuerde mich ja nicht so beleidigen lassen und zurueckschlagen!\n");
    
  AddDetail( ({"attribute", "ausdauer", "familie", "fingernagel", 
  	"flaeschchen", "geschicklichkeit", "gib", "gold", "intelligenz", "kraft", 
  	"moeglichkeiten", "pracht", "schleifen", "schluck", "stadt", "was", 
  	"zahl"}), "*hust*");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Geraeusch eines Schleifsteins.");

  AddSound( ({ "geraeusch", "schleifstein" }),
    "*schleif*schleif**schleif**schleifstein**schleif*");
        
  AddSound( ({"jemand", "jemanden", "lachen"}),
    "*schauder*");
    
  AddSound( ({"knall"}), "*KNALL*");

  AddSmell( DEFAULT_SMELL,
    "Nichts Besonderes.");

  AddSmell( ({ "besonderes" }),
    "Ich wiederhole fuer den ganz Langsamen: Nichts!");
  
  AddRoomMessage( 
    ({
    "Bis auf das gelegentliche Schleifen ist es ruhig hier.\n",
    BS("Wahnsinn, Du ueberlegst, wie lange man wohl braucht, um so viele "
    "Waffen zu sammeln."),
    "Du bist beeindruckt von all diesen maechtigen Waffen.\n",
    "Damit koennte man eine ganze Stadt ausruesten.\n",
    "Hier wurde bestimmt schon viel Gold gelassen.\n",
    "Wie lange die Familie diesen Laden wohl schon besitzt?\n",
    "Was fuer eine Pracht, diese glaenzenden Waffen!\n",
    }),40);
    
  AddCmd( ({ "greif", "greife" }),
    "spalte");
  AddCmd( ({"schlag" , "schlage"}), "schlag");
  AddCmd( ({"1" , "2" , "3" , "4"}), "zt_fake"); //ZT net, aber FP?
	
	AddExit( "osten", ROOM "e1-e2-platz" );
  
  datum = dtime();
	dat = extract(datum,0,2);
	call_other(ROOM "lagerraum_w", "refresh", 0);
	if( dat == "Sam" || dat == "Mit")
	{
		call_out("samstag", 0);
		
		//call_other(ROOM "lagerraum_w", "samstag", 0);
		return ;
	}
	if( dat == "Son" || dat = "Die" || dat == "Don")
	{
		call_out("sonntag", 0);
    
		//call_other(ROOM "lagerraum_w", "sonntag", 0);
		return ;
	}
	if( dat == "Mon" || dat == "Fre")
	{
		call_out("montag", 0);
    //call_other(ROOM "lagerraum_w", "montag", 0);
		return ;
	}
	else
	{
		say("Etwas stimmt nicht\n");
		return ;
	}

}

void reset()
{ 
	string datum, dat,room;
	
	::reset();
	room = ROOM"lagerraum_w";
	datum = dtime();
	dat = extract(datum,0,2);
	room->destruct(); //Die alten Objekte besietigen
	call_other(room, "refresh", 0); //die neuen laden
	if( dat == "Sam" || dat == "Mit")
	{
		call_out("samstag", 0);
		//call_other(ROOM "lagerraum_w", "samstag", 0);
		return ;
	}
	if( dat == "Son" || dat = "Die" || dat == "Don")
	{
		call_out("sonntag", 0);
		//call_other(ROOM "lagerraum_w", "sonntag", 0);
		return ;
	}
	if( dat == "Mon" || dat == "Fre")
	{
		call_out("montag", 0);
		//call_other(ROOM "lagerraum_w", "montag", 0);
		return ;
	}
	else
	{
		say("Etwas stimmt nicht\n");
		return ;
	}

}

int spalte(string str)
{
  if( str == "in spalt" )
  {
    write("NIX!\n");
    say( TPN+" fingert im Boden rum.\n");
   return 1; 
  }
  else
  {
  write ("Wohin willst Du greifen?\n");
  return -1;
  }
}
int schlag(string str)
{
  //notify_fail("Wohin willst Du greifen?\n" );
  if( str == "zurueck" )
  {
    write("*DING!DING* Der Kampf moege beginnen...\n"
    "\n"
    	  "Du kaempfst jetzt gegen Deinen Schatten!\n"
    	  "  Du greifst den Schatten mit blossen Haenden an.\n"
    	  "  Du **VERNICHTEST** den Schatten mit gewaltiger Macht.\n"
    	  "Der Schatten springt wieder an die Wand.\n"
    	  );
    say(BS( TPN+"kaempft gegen seinen Schatten... "));
    
    return 1;
  }
  else
  {
  write ("Wohin willst Du schlagen?\n");
  return -1;
  }
}


string _query_int_long()
{
  string txt;

  txt = "Du stehst in einem wahnsinnig grossen Waffenladen! Alles ist hier "
  "vollgehaengt mit Waffen. Bis auf den Boden und die Theke mit der Tafel "
  "kannst Du nichts anderes als Waffen erkennen.";
  return BS(txt);
}
int zt_fake()
{
	write(BS("Oh! War doch kein echter Trank!\n"));
	return 1;
}

int samstag()
{
	RemoveReadDetail( ({"tafel"}) );
  RemoveItem(NPC "tardens");
	RemoveItem(NPC "torrenz");
	RemoveItem(NPC "tiberion");
	// Beseitigung der alten
  AddReadDetail( ({ "tafel" }),
    "\n"
    "									    \n"
    "	      Willkommen im Familienbetrieb der Weapontrades!		    \n"
    "	Wir verkaufen alle Arten von Waffen, die es zur Zeit gibt!	    \n"
    "	Unsere hervorragende Qualitaet bringt natuerlich auch einen 	    \n"
    "	entsprechenden Preis mit sich! Da sich das allerdings kaum jemand	    "
    "\n"
    "	leisten kann, hatten wir eine besondere Idee: Wir verkaufen	    \n"
    "	jeden Tag 2-3 Waffenarten zum Sonderpreis!			    \n"
    "									    \n"
    "									    \n"
    "		HEUTE VERKAUFEN WIR:			        	    \n"
    "				Schwerter und Aexte!			    \n"
    "									    \n"
    "\n"
    );
    
    AddItem(NPC "tardens", REFRESH_DESTRUCT);
    
    SetProp(P_SHOPKEEPER_NAME, "Tardens");
    SetProp(P_SHOPKEEPER_GENDER, MALE);
    SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
}
int sonntag()
{
	RemoveReadDetail( ({"tafel"}) ); 
	RemoveItem(NPC "tardens");
	RemoveItem(NPC "torrenz");
	RemoveItem(NPC "tiberion");
	
  AddReadDetail( ({ "tafel" }),
    "\n"
    "									    \n"
    "	      Willkommen im Familienbetrieb der Weapontrades!		    \n"
    "	Wir verkaufen alle Arten von Waffen, die es zur Zeit gibt!	    \n"
    "	Unsere herrvoragende Qualitaet bringt natuerlich auch einen 	    \n"
    "	entsprechenden Preis mit sich! Da sich das allerdings kaum jemand	    "
    "\n"
    "	leisten kann, hatten wir eine besondere Idee: Wir verkaufen	    \n"
    "	jeden Tag 2-3 Waffenarten zum Sonderpreis!			    \n"
    "									    \n"
    "									    \n"
    "		HEUTE VERKAUFEN WIR:			        	    \n"
    "				Messer, Dolche und Kettenwaffen.	    \n"
    "									    \n"
    "\n"
    );
    
    AddItem(NPC "torrenz", REFRESH_DESTRUCT);		
    
    SetProp(P_SHOPKEEPER_NAME, "Torrenz");
    SetProp(P_SHOPKEEPER_GENDER, MALE);
    SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
}
