{
	RemoveReadDetail( ({"tafel"}) );
  RemoveItem(NPC "tardens");
	RemoveItem(NPC "torrenz");
	RemoveItem(NPC "tiberion");
	
  AddReadDetail( ({ "tafel" }),
    "\n"
    "									    \n"
    "	      Willkommen im Familienbetrieb der Weapontrades!		    \n"
    "	Wir verkaufen alle Arten von Waffen, die es zur Zeit gibt!	    \n"
    "	Unsere herrvoragende Qualitaet bringt natuerlich auch einen 	    \n"
