
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Ein grosses Tor" );
  SetProp( P_INT_LONG,
    "Du stehst vor dem Rathaus der Stadt Avir. Es ist beeindruckend gross "
    "und das Tor ist mindestens 12 Schritt hoch. Ansonsten weist es keine "
    "Besonderheiten auf. Weder an den Waenden, am Glockenturm oder am Tor. "
    "Wenn Du dieses langweilige Rathaus betreten willst, musst Du einfach "
    "nach Sueden gehen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_KILL_NAME , "Ein nicht vorhandener Falke");

  AddDetail( ({ "himmel" }),
    "Nichts Besonderes heute.");
     
  AddDetail( ({ "besonderes", "besonderheiten", "nada", "nothing", "flug" }),
    "Nix, Nada, Nothing, ...");
    
  AddDetail( ({ "boden" }),
    "Ueberhaupt nicht auffaellig.");
    
  AddDetail( ({ "probleme", "problem" }),
    "Leute, die zu viel forschen!");
    
  AddDetail( ({ "leute" }),
    "Du!");
    
  AddDetail( ({ "rathaus" }),
    "So nennt man es, weil der Rat der Stadt hier die Probleme der Stadt "
    "loest.");
    
  AddDetail( ({ "rat" }),
    "Zur Zeit besteht er aus dem Buergermeister und... Ja!");
    
  AddDetail( ({ "zeit" }),
    "Zeit ist Gold.");
    
  AddDetail( ({ "gold" }),
    "Gold ist Reichtum.");
    
  AddDetail( ({ "reichtum" }),
    "Reichtum ist Luxus.");
    
  AddDetail( ({ "luxus" }),
    "Kannst Du Dir noch nicht leisten...");
    
  AddDetail( ({ "buergermeister" }),
    "Der gesamte weise Rat der Stadt!");
    
  AddDetail( ({ "stadt", "avir" }),
    "Avir nennt Mann eine Stadt.");
    
  AddDetail( ({ "mann" }),
    "Frau auch.");
    
  AddDetail( ({ "frau" }),
    "Du glaubst doch nicht, dass sich dieses Thema, an dem sich schon "
    "hunderte von Wissenschaftlern versucht haben, jetzt und hier klaeren "
    "laesst?");
    
  AddDetail( ({ "thema" }),
    "Da bist Du aber naiv!");
    
  AddDetail( ({ "wissenschaftler" }),
    "Alle sind daran zugrunde gegangen.");
    
  AddDetail( ({ "alle" }),
    "Auch Du wirst es bald...");
    
  AddDetail( ({ "schritt" }),
    "Dies ist nur ein kleiner Schritt fuer einen Troll, aber ein verdammt "
    "langer Flug fuer eine Fee.");
    
  AddDetail( ({ "troll" }),
    "Diese kleinen weiblichen Wesen mit Fluegeln.");
    
  AddDetail( ({ "fee" }),
    "Diese grossen haesslichen und barbarischen Viecher aus den Bergen.");
    
  AddDetail( ({ "viecher", "wesen" }),
    "Nein nein, Du verwechselst da etwas.");
    
  AddDetail( ({ "berge", "berg" }),
    "Puh! Schwer zu umschreiben: gross, schwer und sehr ... bergig.");
    
  AddDetail( ({ "fluegel", "fluegeln" }),
    "Suess!");

  AddDetail( ({ "sueden" }),
    "Auch noch da.");
    
  AddDetail( ({ "tor" }),
    "Da ist nichts Besonderes. Nicht einmal eine Tafel oder so.");
    
  AddDetail( ({ "tafel" }),
    "Da sie nicht da ist, stehen auch keine Schriftzeichen drauf.");
    
  AddDetail( ({ "schriftzeichen" }),
    "Du siehst da keinen Sinn drin.");
    
  AddDetail( ({ "sinn" }),
    "Es macht also ueberhaupt keinen Sinn, die Tafel zu lesen.");
    
  AddDetail( ({ "waende" }),
    "Du siehst nichts Auffaelliges.");
    
  AddDetail( ({ "auffaelliges" }),
    "Kein kleines Loch in den Waenden oder so.");    
    
  AddDetail( ({ "loch" }),
    "In dem Loch ist auch kein Hebel oder etwas Vergleichbares.");
    
  AddDetail( ({ "hebel" }),
    "Wo siehst Du bitte sowas?");
    
  AddDetail( ({ "vergleichbares" }),
    "Ein Knopf zum Beispiel.");
    
  AddDetail( ({ "beispiel" }),
    "Jetzt hab ich doch glatt den Faden verloren!");
    
  AddDetail( ({ "faden" }),
    "Gib mir sofort meinen Faden wieder!");
    
  AddDetail( ({ "wand" }),
    "Einzahl von Waende.");
    
  AddDetail( ({ "einzahl" }),
    "Singular.");
    
  AddDetail( ({ "singular" }),
    "Man lernt doch nie aus!");
    
  AddDetail( ({ "knopf" }),
    "Zum druecken.");
    
  AddDetail( ({ "glockenturm" }),
    "Dir faellt weder am Turm noch an der Glocke etwas auf.");
    
  AddDetail( ({ "turm" }),
    "Da sitzt kein Falke oben drauf.");
    
  AddDetail( ({ "falke" }),
    "Da keiner da ist, kannst Du beruhigt einen Stein auf ihn schleudern.");
    
  AddDetail( ({ "stein" }),
    "Wuerde mich doch interessieren, wo Du den her hast. Du cheatest doch!");
    
  AddDetail( ({ "glocke" }),
    "Sie hat keinen Riss.");
    
  AddDetail( ({ "riss" }),
    "Man koennte diesen Riss nicht als Spalt bezeichnen.");
    
  AddDetail( ({ "spalt", "reingreifen" }),
    "Er ist viel zu hoch zum Reingreifen.");
    
    
  AddReadDetail( ({ "tafel" }),
    "Tritt ein, bring Steuern herein!");

  AddCmd( ({ "greif", "greife" }), "spalt" );
  AddCmd( ({"drueck", "druecke"}), "knopf");
  AddCmd( ({ "schleuder", "schleudere" }), "falke"); 
  
  AddExit( "norden", ROOM "e1-e3-park" );
  AddExit( "sueden", ROOM "e1-e5-rh" );
 
  AddItem( NPC "soeldner" , REFRESH_DESTRUCT);
  AddItem( NPC "soeldner" , REFRESH_DESTRUCT);
}

int knopf(string str )
{
  notify_fail( "Was willst Du druecken?\n" );
  if( str == "knopf" )
  {
    write(BS("Es passiert nichts, Du bemerkst auch keine neue Oeffnung "
    	"neben Dir."));
    say(BS( TPN+" macht nichts an den Waenden."));
    
    
    AddDetail( ({ "oeffnung" }),
       "In ihr ist nichtmal ein Hebel!");
    RemoveDetail( ({"hebel"}));   
    
    AddDetail( ({ "hebel", "ziehen" }),
       "Keiner da zum Ziehen.");
    AddCmd( ({"zieh", "ziehe"}), "hebel");   
       
    return 1;
  }
}
int hebel(string str )
{
  notify_fail( "Was willst Du ziehen?\n" );
  if( str == "hebel" )
  {
    write(BS("Du bemerkst keinen Schalter der ploetzlich neben Dir aus der "
    	"Wand kommt..."));
   
    AddDetail( ({ "schalter" }),
       "Waere einer da, wuerdest Du ihn so gerne betaetigen.");
   
    AddCmd( ({"betaetige"}), "schalter");   
       
    return 1;
  }
}
int schalter(string str )
{
  notify_fail( "Was willst Du betaetigen?\n" );
  if( str == "schalter" )
  {
    write(BS("WOW! Du bist erstaunt... wer haette gedacht, dass ... "
    "NICHTS, aber auch GAR NICHTS passiert?"));
   
    RemoveDetail( ({"hebel", "schalter", "oeffnung", "ziehen"}));   
    
  AddDetail( ({ "hebel" }),
    "Wo siehst Du bitte sowas?");  
    return 1;
  }
}
int falke(string str )
{
  notify_fail( "Was willst auf Wen schleudern?\n" );
  if( str == "stein auf falke" )
  {
    write(BS("Seltsam, der Stein prallt an ihm ab und trifft Dich, obwohl "
    	"er doch eigentlich nicht da ist!"));
    this_player()->do_damage(5, this_object());
    return 1;
  }
}
int spalt(string str )
{
  notify_fail( "Wohin willst Du greifen?\n" );
  if( str == "in spalt" )
  {
    write(BS("Was hast Du jetzt bitte erwartet? Dir waechst ein Gummiarm "
    	"und Du findest etwas in einem nicht vorhandenem Spalt?"));
    return 1;
  }
}