
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Strasse" );
  SetProp( P_INT_LONG,
    "Du stehst auf einer ganz normalen Strasse in Avir. Vor Dir jedoch "
    "erhebt sich eine Rampe, die hinauf zu einem Turm auf der Stadtmauer "
    "fuehrt. Ansonsten gibt es nichts Erwaehnenswertes in dieser Strasse." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "strasse" }),
    "Links und rechts stehen die sauberen Wohnhaeuser Avirs und dazwischen "
    "fuehren einzelne Gassen zu anderen Wohnungen.");
    
  AddDetail( ({ "links", "rechts" }),
    "Das sind Richtungsangaben.");
    
  AddDetail( ({ "richtungsangaben" }),
    "Du (Richtungs)angeber!");
    
  AddDetail( ({ "angeber", "richtungsangeber" }),
    "Erspar Dir jetzt bitte jeden Kommentar.");

  AddDetail( ({ "kommentar" }),
    "Schreibs halt in die Zeitung, wenn Du so wichtig bist.");
    
  AddDetail( ({ "zeitung" }),
    "Sag ich doch! Angeber. :-)");
    
  AddDetail( ({ "wohnhaeuser", "haeuser" }),
    "Sie wurden schoen hergerichtet und somit ist das Gesamtbild der Stadt "
    "ein schoenes.");
    
  AddDetail( ({ "stadt", "avir" }),
    "Diese Stadt heisst Avir.");
    
  AddDetail( ({ "gesamtbild" }),
    "Da nicht ein Haus irgendwie heruntergekommen ist, ergibt die Stadt "
    "einen sehr schoenen Anblick.");
    
  AddDetail( ({ "anblick" }),
    "Hach! Wenn man ihn doch von einem hohen Punkt aus geniessen koennte.");
    
  AddDetail( ({ "punkt" }),
    ". - Nicht sehr hoch aber schonmal ein Anfang.\n");
    
  AddDetail( ({ "anfang" }),
    "Eine Stimme schallt in Deinem Kopf: \"Und in Avir wird es enden, in "
    "Avir wird alles enden! Finde den grossen Baum!\"");
    
  AddDetail( ({ "stimme" }),
    "Sie ist gerade die Strasse runter gerannt!");
    
  AddDetail( ({ "baum" }),
    "Mhh. Was damit wohl gemeint war? Ob in der Bibliothek etwas darueber "
    "steht?");
    
  AddDetail( ({ "bibliothek" }),
    "Du solltest da oefter hingehen. (Und nicht dauernd im Internet "
    "spielen!)");
    
  AddDetail( ({ "internet" }),
    "Jaja, jetzt wissen wir wieder nicht, was das ist.");
    
  AddDetail( ({ "kopf" }),
    "Der is ja noch da!");
    
  AddDetail( ({ "gassen", "gasse" }),
    "Sie befinden sich zwischen den Haeusern.");
    
  AddDetail( ({ "wohnungen", "wohnung" }),
    "Sie sind fuer Dich uninteressant. Du bleibst lieber in dem Teil der "
    "Stadt.");
    
  AddDetail( ({ "teil" }),
    "Hier ist was los!\n"
    "Jemand ruft: PARTYTIME!\n");
    
  AddDetail( ({ "partytime" }),
    "HarHar! Mein Element!");
    
  AddDetail( ({ "element" }),
    "Anvar wird ueber dieses Element nix wissen. *fg*");
    
  AddDetail( ({ "anvar" }),
    "Du kennst... verschwinde!");
    
  AddDetail( ({ "himmel" }),
    "Blau, Wolken und ein Schatten.");
    
  AddDetail( ({ "blau" }),
    "Blauer Himmel! Wo kommen wir denn da hin?");
    
  AddDetail( ({ "wolken", "wolke" }),
    "Mhhh, warum ist da ein Schatten auf den Wolken?");
    
  AddDetail( ({ "schatten" }),
    "Irgendetwas ist da oben, ueber den Wolken. Du musst schlucken.");
    
  AddDetail( ({ "irgendetwas" }),
    "Es bewegt sich nicht und hat rechteckige Formen.");
    
  AddDetail( ({ "formen", "form" }),
    "Wie die einer Turmzinne...");
    
  AddDetail( ({ "turmzinne", "zinne" }),
    "Du wirst kreidebleich.\n"
    "Sollte dort oben ueber Avir ein Bauwerk stehen?\n");
    
  AddDetail( ({ "bauwerk" }),
    "Welch Wahnsinn ergriff die Architekten, solch ein Risiko einzugehen?");
    
  AddDetail( ({ "wahnsinn" }),
    "Oder was haben sie getrunken? ^^");
    
  AddDetail( ({ "architekten", "architekt" }),
    "Sie sind bestimmt laengst tot.");
    
  AddDetail( ({ "risiko" }),
    "Hoffentlich haelt dieses Bauwerk.");
    
  AddDetail( ({ "boden" }),
    "Kopfsteinpflaster.");
    
  AddDetail( ({ "kopfsteinpflaster" }),
    "Avirisches Kopfsteinpflaster :-)");
    
  AddDetail( ({ "erwaehnenswertes" }),
    "Nichts.");
    
  AddDetail( ({ "nichts" }),
    "Kennzeichnet sich durch jegliches Fehlen von Materie.");
    
  AddDetail( ({ "fehlen" }),
    "Nix da sein.");
    
  AddDetail( ({ "nix" }),
    "Nichts eben.");
    
  AddDetail( ({ "materie" }),
    "Na, uebertreib mal nicht glei!");
    
  AddDetail( ({ "rampe" }),
    "Warum fuehrt nicht einfach eine Treppe hoch zur Mauer wie in jeder "
    "Stadt?");
    
  AddDetail( ({ "treppe" }),
    "Avir ist nun einmal nicht wie jede andere Stadt. Avir ist alt und hat "
    "viel erlebt. Die Konstruktionen in Avir machen alle Sinn.");
    
  AddDetail( ({ "sinn" }),
    "Noch verstehst Du ihn nicht.");          
    //spaeter einmal berittene Einheiten- > sie sollen fuer einen angriff auf 
    //den Turm hoch reiten koenen. Oder schnmal ein pfer ne treppe steigen 
    //sehen?

  AddDetail( ({ "konstruktionen", "konstruktion" }),
    "Noch hast Du nicht alle gesehen.");
    
  AddDetail( ({ "mauer", "stadtmauer" }),
    "Du kannst sie betreten und auf ihr herumlaufen.");
    
  AddDetail( ({ "turm" }),
    "Auch ihn darf man betreten. Was das wohl fuer eine Aussicht gibt?");

  AddDetail( ({ "aussicht" }),
    "Ueberleg mal! Wie ist die Aussicht auf ein Tal von der Spitze eines "
    "Turmes, der auf einem hohen Plateau steht?");
    
  AddDetail( ({ "tal" }),
    "Es sieht bestimmt phantastisch aus.");
    
  AddDetail( ({ "spitze" }),
    "Oben.");
    
  AddDetail( ({ "plateau" }),
    "Doch, Du bist sehr weit ueber dem Boden.");

  AddSound( DEFAULT_SOUND,
    "Der typische Laerm einer Stadt.");

  AddSound( ({ "laerm", "stadt" }),
    "Langsam solltest Du ihn kennen.");

  AddSmell( DEFAULT_SMELL,
    "Bist Du sicher, dass das nicht verboten ist?");
  
  AddDetail( ({"alarm", "haus", "leben", "lippen", "nicht", "richtungs", 
  	"und"}), "Sowas!");

  AddRoomMessage( 
    ({
    	BS("Irgendetwas stimmt hier nicht, etwas stimmt hier ganz und gar "
    		"nicht..."),
    	"Du bist unruhig.\n",
    	"Etwas macht Dich nervoes.\n",
    	BS("Eine Stimme in Dir, welche Dir schon oft das Leben rettete, sagt "
    		"Dir, Du solltest weg von hier..."),
    	"Nervoes starrst Du zum Himmel.\n",
    	"Du leckst Dir ueber die Lippen.\n",
    	"Dein innerer Alarm schlaegt seit Du hier bist.\n",
    	"Was ist nur los mit Dir?\n",
    	"Was macht Dich nur so nervoes?\n"
    }),27);

  AddExit( "westen", ROOM "e1-e3-park" );
  AddExit( "ostoben", ROOM "e2-g3" );

  SetProp(P_HIDE_EXITS, ({"osten"}) );  
  AddExit( "osten", ROOM "e2-g3" );

  AddItem( NPC "einwohner" , REFRESH_DESTRUCT);
  AddItem( NPC "penner" , REFRESH_DESTRUCT);

}
