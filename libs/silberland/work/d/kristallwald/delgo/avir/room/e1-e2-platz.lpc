
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Der Stadtplatz" );
  SetProp( P_INT_LONG,
    "Das hier scheint der Stadtplatz zu sein. Hier treffen sich die "
    "Bewohner unter freiem Himmel zum Tratschen, Einkaufen oder einfach nur "
    "zum Essen. In der Mitte steht eine riesige Buehne, die Du Dir mal "
    "genauer anschauen solltest!" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "himmel" }),
    "So ein Glueck, er ist noch da! Aber keine Waende!");
    
  AddDetail( ({ "glueck" }),
    "Ausserhalb Avirs wird es Dir versagt bleiben.");
    
  AddDetail( ({ "avir" }),
    "In Avir bist Du relativ sicher, wenn Du Dich nicht mit den Soeldnern "
    "anlegst.");
    
  AddDetail( ({ "soeldner" }),
    "Frag mal den Buergermeister danach!");
    
  AddDetail( ({ "buergermeister" }),
    "Na, wo befindet sich wohl der Buergermeister, Mh?");
    
  AddDetail( ({ "waende" }),
    "FORSCHERSCRIPT!");
    
  AddDetail( ({ "forscherscript" }),
    "Na, ein normaler Forscher wuerde doch nicht draussen Waende "
    "untersuchen, wo keine sind, oder?");
    
  AddDetail( ({ "forscher" }),
    "Die Leute in den weissen Kitteln.");
    
  AddDetail( ({ "kittel", "kitteln" }),
    "Weiss.");
    
  AddDetail( ({ "leute" }),
    "Na.. hab ich mich doch ablenken lassen! SCRIPTER!");
    
  AddDetail( ({ "scripter" }),
    "Der ultimative Test, um zu ueberpruefen, ob Du scriptest: Wenn Du "
    "'schau' oder 'aus' eintippst, wirst Du registriert und fuer immer aus "
    "dieser Stadt verbannt!");
    
  AddDetail( ({ "stadt" }),
    "Diese alte und legendaere Stadt heisst Avir.");
    
  AddDetail( ({ "test" }),
    "Is natuerlich nur ein Spass gewesen.\n"
    "...\n"
    "Die richtige Falle ist versteckt.");
    
  AddSpecialDetail( ({ "falle" }), "script");
   
  AddDetail( ({ "delgo" }),
    "finger delgo");
    
  AddDetail( ({ "boden" }),
    "Festgetrampelte Erde.");
    
  AddDetail( ({ "erde" }),
    "Koennte auch Lehm sein.");
    
  AddDetail( ({ "lehm" }),
    "Nein, Erde.");
    
  AddDetail( ({ "stadtplatz", "platz" }),
    "So nennt man das hier. Hier treffen sich die Bewohner fuer gemeinsame "
    "Aktivitaeten.");
    
  AddDetail( ({ "aktivitaeten", "aktivitaet" }),
    "Ich koennte mir vorstellen, dass DU jetzt wieder denkst, es sei ein "
    "Orgienplatz. Aber es sind andere Beschaeftigungen gemeint.");
    
  AddDetail( ({ "Du" }),
    "Du bist wirklich ein Ferkelchen!");
    
  AddDetail( ({ "orgienplatz" }),
    "Wie kommst Du nur immer auf sowas? Du hast ne echt kranke Phantasie.");
    
  AddDetail( ({ "phantasie" }),
    "Geh mal zum Arzt.");
    
  AddDetail( ({ "arzt" }),
    "Was weiss ich wo einer ist, geh zu den Palas.");
    
  AddDetail( ({ "palas" }),
    "Die Paladine sind gute Heiler.");
    
  AddDetail( ({ "heiler" }),
    "Ob sie auch Dir helfen koennen, mag ich zu bezweifeln, aber man soll die "
    "Hoffnung ja nie aufgeben!");
    
  AddDetail( ({ "paladine" }),
    "Die Scroller Nr. 1!");
    
  AddDetail( ({ "hoffnung" }),
    "Man sagt, Gruen sei die Farbe der Hoffnung.");
    
  AddDetail( ({ "gruen", "farbe" }),
    "Da der Wald blau ist, solltest Du Dir Gedanken machen...");
    
  AddDetail( ({ "gedanken", "gedanke" }),
    "Du erzeugst: Ein Paar Gedanken.");
    
  AddDetail( ({ "paar" }),
    "Na also, Du kannst es doch!");
    
  AddDetail( ({ "wald", "blau" }),
    "Gibt es eventuell gar keine Hoffnung fuer Dich?");
    
  AddDetail( ({ "scroller" }),
    "Stell Dich mal fuenf Minuten in die Burg!");
    
  AddDetail( ({ "minuten" }),
    "Hach, nimm doch net alles so woertlich!");
    
  AddDetail( ({ "burg", "sturmfels" }),
    "Die Burg heisst Sturmfels.");
    
  AddDetail( ({ "bewohner", "beschaeftigungen" }),
    "Einkaufen, Tratschen, Essen.");
    
  AddDetail( ({ "einkaufen" }),
    "Du siehst viele Geschaefte, doch fuer Dich machen nur die beiden im "
    "Osten und Westen was her.");
    
  AddDetail( ({ "geschaefte", "geschaeft" }),
    "Laeden.");
    
  AddDetail( ({ "laeden" }),
    "Wichtig! Nicht die Laden, sondern die Laeden!");
    
  AddDetail( ({ "laden" }),
    "Falsch!");

  AddDetail( ({ "osten" }),
    "Ein Ruestungsladen.");
    
  AddDetail( ({ "westen" }),
    "Ein Waffenladen.");
    
  AddDetail( ({ "ruestungsladen", "waffenladen" }),
    "Geh doch mal hin!");    
    
  AddDetail( ({ "tratschen" }),
    "-a+");
    
  AddDetail( ({ "essen" }),
    "Im Norden ist eine Kneipe.");
    
  AddDetail( ({ "norden" }),
    "Ja, die Kneipe ist noch immer da!");
    
  AddDetail( ({ "kneipe" }),
    "Warum soll sie auf einmal weg sein? Sie ist im Norden. Nicht "
    "untersuchen, sondern reingehen!");
    
  AddDetail( ({ "mitte" }),
    "Naja, die Buehne steht fast mittig!");

  AddDetail( ({ "buehne" }),
    "Hier scheinen an Festtagen Musiker aufzutreten, aber auch "
    "Hinrichtungen kannst Du Dir vorstellen.");
    
  AddSpecialDetail( ({ "hinrichtungen", "hinrichtung" }),
    "vision");
    
  AddDetail( ({ "festtage" }),
    "In naechster Zeit ist keiner in Aussicht. Schade eigentlich. Aber sowas "
    "wird ja in der Zeitung angekuendigt.");

  AddDetail( ({ "zeit" }),
    "Bald ist auch Deine gekommen...");
    
  AddDetail( ({ "aussicht" }),
    "Na, von hier siehst Du nix von dem Wald. Du musst schon auf die "
    "Mauern!");
    
  AddDetail( ({ "mauern", "mauer" }),
    "Sie umgeben die Stadt.");
    
  AddDetail( ({ "zeitung" }),
    "Wo ist meine eigentlich hin? *kram*");
    
  AddDetail( ({ "musiker" }),
    "In Extremo war neulich hier!");
    
  AddDetail( ({ "in extremo", "extremo" }),
    "Das war ein Fest!");
    
  AddDetail( ({ "fest" }),
    "Das wird die Stadt nie vergessen!(Also jene Bewohner, die nicht zu "
    "viel Alkohol.... *gruebel* ... wahrscheinlich habens alle vergessen :( "
    ")");

  AddSound( DEFAULT_SOUND,
    "Du hoerst eigentlich nichts Interessantes.");

  AddSound( ({ "interessantes" }),
    "Nichts.");
    
  AddSound( ({ "nichts" }),
    "Na gut, weil Du es bist: Du hoerst ein Fluestern.");

  AddSound( ({ "fluestern" }),
    "Eine Maennerstimme.");
    
  AddSound( ({ "maennerstimme", "stimme", "dienste" }),
    "\"...*tuschel* unter 'Avirs Stolz'.. *murmel* ... Red Inn... "
    "*fluester*... spezielle Dienste...*leise*... musst ihn nach 'dienste' "
    "fragen...\"");

   AddRoomMessage( 
    ({
    	"\".. der alte Ruestungsbauer mag keine Kundschaft...\"\n",
    	"\"... der Auftritt war absolut genial...\"\n",
    	BS("\"Welcher Auftritt? *laber*.. ich haette net soviel trinken "
    		"sollen...\""),
    	"WUFF, WUFF!\n",
    	"MIAU, MIAU?\n",
    	"*KNURRR!*\n",
    	"*schluck*\n",
    	"Du siehst wie eine Katze von einem Koeter gejagt wird.\n",
    	"\"... eine tolle Geschichte...\"\n",
    	"\"Habe ich auch gehoert! Dann muss es stimmen...\"\n",
    }),28);

  AddExit( "westen", ROOM "e1-d2-wladen" );
  AddExit( "sueden", ROOM "e1-e3-park" );
  AddExit( "norden", ROOM "e1-e1-kneipe" );
  AddExit( "osten",  ROOM "e1-f2-rladen" );
  
  AddDetail( ({"Alkohol", "Also", "Auftritt", "Ferkelchen", "Geschichte", 
  	"Habe", "Inn", "Katze", "Knurrr", "Koeter", "Kundschaft", "Mh", "Miau", 
  	"Nr", "Ruestungsbauer", "Spass", "Stolz", "Welcher", "Wuff"}) , 
  	"Du kannst Dich nicht darauf konzentrieren."); 

  AddItem( NPC "soeldner_m" , REFRESH_DESTRUCT);
  AddItem( NPC "soeldner_m" , REFRESH_DESTRUCT);
  AddItem( NPC "einwohner" , REFRESH_DESTRUCT);
}

string script()
{
	write(BS("Ich gratuliere, Du hast sie gefunden!\n"));
	write(BS("[Tod:Lars] Scripten hat gerade "+TPN+" umgebracht.\n"));
	write(BS("[Tod:Sripten ist nicht ehrlich!]\n"));
	TP->SetProp(P_PARALYZED, ([PARALYZE_TIME: 12, 
							PARALYZE_MSG: "Du bist tot!\n", 
							PARALYZE_MSG_OTHER: "%s ist ganz starr.\n", 
							PARALYZE_END: "Du bist froh, dass das nur ein Trick war!\n",
							PARALYZE_END_OTHER: "%s erwacht aus der Starre.\n"]));
	while (remove_call_out("s1") != -1 );
	call_out("s1", 3);
	return "";
}
void s1()
{
	write(" \n");
	write(" \n");
	write("Der Tod sagt: WIR ...\n");
	while (remove_call_out("s2") != -1 );
	call_out("s2", 3);
	
}

void s2()
{
	write(" \n");
	write(" \n");
	write("... HABEN DICH ...");
	write(" \n");
	while (remove_call_out("s3") != -1 );
	call_out("s3", 3);
	
}	

void s3()
{
	write(" \n");
	write("... REINGELEGT!\n");
	write(" \n");
	while (remove_call_out("s4") != -1 );
	call_out("s4", 4);
	
}	       
       
void s4()
{
       write(" \n");
       write("Delgo drueckt dem Tod grinsend 50 Euro in die Hand.\n");
       write(" \n");
}

string vision()
{
	write(BS("\n"));
	write(BS("Vor Deinem geistigem Auge ziehen dunkle Wolken heran...\n"));
	write(BS("... es faengt an zu regnen...\n"));
	TP->SetProp(P_PARALYZED, ([PARALYZE_TIME: 12, 
							PARALYZE_MSG: BS("Du hast eine Vision! Du bist zu "
								"konzentriert um was anderes zu tun!"), 
							PARALYZE_MSG_OTHER: "%s ist ganz starr.\n", 
							PARALYZE_END: BS("Ein versehentlicher Schubser reisst Dich "
								"aus der Vision."), 
							PARALYZE_END_OTHER: "%s erwacht aus der Starre.\n"]));
	while (remove_call_out("v1") != -1 );
	call_out("v1", 3);
	return "";
}

void v1()
{
	write(" \n");
	write(" \n");
	write("Du siehst Henker mit Masken...\n");
	while (remove_call_out("v2") != -1 );
	call_out("v2", 3);

}

void v2()
{
	write(" \n");
	write(" \n");
	write("... brennende Hexen...");
	write(" \n");
	while (remove_call_out("v3") != -1 );
	call_out("v3", 3);

}	

void v3()
{
	write(" \n");
	write("...enthauptete Menschen, abgetrennte Torsi und Extremitaeten...\n");
	write(" \n");
	while (remove_call_out("v4") != -1 );
	call_out("v4", 4);
	
}	       
       
void v4()
{
  write(" \n");
  write(BS("... und Du stehst daneben mit blutbesudelten Haenden und "
    "lachst infernalisch..."));
  write(" \n");
}