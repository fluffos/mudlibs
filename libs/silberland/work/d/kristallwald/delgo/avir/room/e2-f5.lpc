
#include "../def.h"

inherit ROOM "std_mauer";  

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Die Stadtmauer" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Stadtmauer von Avir. Die Zinnen rechts und links von "
    "Dir begrenzen den Weg der Soeldner. Von hier oben hast Du eine gute "
    "Aussicht auf Tethyr und die Stadt. Du bleibst einen Moment stehen und "
    "laesst das alles auf Dich einwirken. Im Westen siehst Du einen Turm." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"turm"}), 
     "Da drueben.");
     
  AddDetail( ({"aussicht"}), 
     "Sehr viel kannst Du dem suedlichen Wald nicht abgewinnen. Es scheint "
     "nichts Besonderes zu geben.");
     
  AddDetail( ({"besonderes"}), 
     "Du kannst Dir kaum vorstellen, dass dort Nichts los sein sollte.");
     
  AddDetail( ({"nichts", "nicht"}), 
     "Doch, jetzt faellts Dir auf: nichts! Es ist viel zu ruhig fuer Deinen "
     "Geschmack.");
     
  AddDetail( ({"geschmack"}), 
     "Wenn sogar die Tiere des Waldes so ruhig sin.. ach nein. Jetzt hoerst "
     "Du sie wieder. War wohl nur ein kurzer Blackout.");
     
  AddDetail( ({"blackout"}), 
     "Besser als ein Whitein.");
     
  AddDetail( ({"whitein"}), 
     "Hab gehoert, die sind sooo gross und irre gefaehrlich.");
     
  AddDetail( ({"tiere", "tier"}), 
     "Sie leben da unten im Wald. Und wenn sie nicht gestorben, gejagt, "
     "geschlachtet, ausgeweidet, kastriert, gefangen, gebaendigt, "
     "verbrannt, gestuerzt, verkrault, vernichtet, ausgerottet wurden, "
     "dann leben sie noch heute.");

  AddExit( "osten", ROOM "e2-g5");
  AddExit( "westen", ROOM "e2-e5");

}

