
#include "../def.h"

inherit ROOM "std_mauer";  

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Die Stadtmauer" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Stadtmauer von Avir. Die Zinnen rechts und links von "
    "Dir begrenzen den Weg der Soeldner. Von hier oben hast Du eine gute "
    "Aussicht auf Tethyr und die Stadt. Du bleibst einen Moment stehen und "
    "laesst das alles auf Dich einwirken. Im Westen siehst Du einen Turm." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"turm", "westen"}), 
     "Da drueben!");
     
  AddDetail( ({"aussicht"}), 
     "Von hier aus hast Du die Strasse nach Norden im Blickfeld.");
     
  AddDetail( ({"norden"}), 
     "Ja, man koennte auch sagen, sie fuehrt ebenso nach Sueden, aber.. "
     "naja.");
     
  AddDetail( ({"sueden"}), 
     "Wie klingt das denn: Die Strasse nach Norden, die aber auch nach "
     "Sueden fuehrt. Wir sind hier im Silberland.");
     
  AddDetail( ({"silberland"}), 
     "Wir habens hier nicht so mit der Realitaet.");
     
  AddDetail( ({"realitaet"}), 
     "Hauptsache, die Namen klingen cool.");
     
  AddDetail( ({"namen", "name"}), 
     "Deiner!");
     
  AddDetail( ({"strasse"}), 
     "Sie ist breit, sie ist gerade und gut bewacht, wie Du an den Reitern "
     "siehst.");
     
  AddDetail( ({"reiter"}), 
     "Sie patroullieren auf der Strasse nach Norden.");
     
  AddDetail( ({"blickfeld"}), 
     "Die Strasse fuehrt von Avir zum Bergpass.");
     
  AddDetail( ({"bergpass", "pass"}), 
     "Ueber diesen gelangt ihr ans Meer.");
     
  AddDetail( ({"meer", "wenn"}), 
     "*wuschel* Wenn Du mal gross bist.");
     
  AddExit( "westen", ROOM "e2-e1");
  AddExit( "osten", ROOM "e2-g1");

}
