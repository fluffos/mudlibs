
#include "../def.h"

inherit ROOM "std_mauer";  

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Die Stadtmauer" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Stadtmauer von Avir. Die Zinnen rechts und links von "
    "Dir begrenzen den Weg der Soeldner. Von hier oben hast Du eine gute "
    "Aussicht auf Tethyr und die Stadt. Du bleibst einen Moment stehen und "
    "laesst das alles auf Dich einwirken. Das scheint der nordoestliche "
    "Teil der Stadt zu sein." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"teil"}), 
     "Das ist nur ein Teil vom Ganzen.");
     
  AddDetail( ({"ganzen", "ganzes"}), 
     "Die Stadtmauer eben.");
     
  AddDetail( ({"nordoestlichen", "nordoestlich"}), 
     "...");
     
  AddDetail( ({"aussicht"}), 
     "Der Nordosten des Waldes erschreckt Dich.");
     
  AddDetail( ({"nordosten"}), 
     "Die Farbe der Blaetter weicht ins Dunkelblau und das wirkt irgendwie "
     "... bedrohlich.");
     
  AddDetail( ({"dunkelblau"}), 
     "Teilweise ist es schon fast Schwarz.");
     
  AddDetail( ({"schwarz"}), 
     "Du bekommst Angst vor diesem Teil des Waldes. Du bist Dir sicher, er "
     "ist vom Boesen verseucht.");
     
  AddDetail( ({"angst"}), 
     "Was auch immer dort lauert, es ist boese. Sehr boese und es wartet "
     "auf jemanden...");
     
  AddDetail( ({"boese"}), 
     "Eventuell wartet es ja auf DICH?");
     
  AddDetail( ({"Dich"}), 
     "Geh hin, wenn Du tapfer und stark bist, bleibe hier, wenn Du noch "
     "viel lernen musst, junger Padawan.");
     
  AddDetail( ({"padawan"}), 
     "Ich Dich hoffentlich viel gelernt haben ueber Forschen.");
     
  AddDetail( ({"forschen"}), 
     "Forsche nie aus Habgier, das ist der Pfad der dunklen Seite der "
     "Forscher.");
     
  AddDetail( ({"habgier"}), 
     "Nein!");
     
  AddDetail( ({"pfad"}), 
     "Du willst nur weg von hier.");
     
  AddDetail( ({"seite"}), 
     "Du blaetterst um. Ah, die Seite der Metzler.");
     
  AddDetail( ({"forscher"}), 
     "Forscher & Co. - Wir suchen sie gerne!");
     
  AddDetail( ({"wir", "co", "metzler"}), 
     "Wir und die anderen eben.");
     
  AddDetail( ({"metzler"}), 
     "Metzler und Sohn - Wir toeten sie auch zweimal.");
     
  AddDetail( ({"sohn"}), 
     "Ich bin der Sohn des Angrox.");
     
  AddDetail( ({"angrox"}), 
     "(Todes)engel, Druidenpappa und Oberzechi!");
     
  AddDetail( ({"todesengel", "engel" , "druidenpappa", "oberzechi"}), 
     "Angrox.");

	AddDetail( ({"blaetter", "farbe", "nordoestliche", "todes"}), 
	"Nicht so pingelig!");

  AddExit( "westen", ROOM "e2-f1");
  AddExit( "sueden", ROOM "e2-g2");

}
