
#include "../def.h"

inherit ROOM "std_mauer";  

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Die Stadtmauer" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Stadtmauer von Avir. Die Zinnen rechts und links von "
    "Dir begrenzen den Weg der Soeldner. Von hier oben hast Du eine gute "
    "Aussicht auf Tethyr und die Stadt. Du bleibst einen Moment stehen und "
    "laesst das alles auf Dich einwirken. Im Sueden steht ein Turm." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"turm"}), 
     "Weg isser.");

  AddDetail( ({"aussicht"}), 
     "Der Anblick ist fast der selbe wie im Nordosten.");
     
  AddDetail( ({"anblick"}), 
     "Schrecklich.");
     
  AddDetail( ({"nordosten"}), 
     "Geh mal nach Norden und schau es Dir einfach an!");
     
  AddDetail( ({"norden"}), 
     "^\n|");


  AddExit( "norden", ROOM "e2-g1");
  AddExit( "sueden", ROOM "e2-g3");

}
