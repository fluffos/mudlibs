
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Bruecke in den Wolken" );
  SetProp( P_INT_LONG,
    "Du stehst auf einer Steinbruecke mitten in den Wolken. Um Dich herum "
    "kannst Du nicht viel erkennen, denn die Wolken versperren Dir die "
    "Aussicht. Wenn Du der Bruecke nach Sueden folgst, kommst Du zu einem "
    "Turm, gehst Du nach Norden, verschwindest Du in den Wolken."
    );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "himmel" }),
    "Er ist noch immer ueber Dir.");

  AddDetail( ({ "boden" }),
    "Der Boden besteht wie bei einer normalen Bruecke aus Steinbloecken.");
    
  AddDetail( ({ "steinbloecke", "steinblock"}),
    "Wenn es eine Steinbruecke ist, sind es natuerlich Bloecke aus Stein.");
    
  AddDetail( ({ "stein" }),
    "Waerst Du ein Geologe, koenntest Du sagen, um was fuer einen Stein es "
    "sich hier handelt.");
    
  AddDetail( ({ "geologe" }),
    "Ein Geologe kommt an.\nEin Geologe sagt: Es ist Granit!\nEin Geologe "
    "geht nach Nordunten.");
    
  AddDetail( ({ "nordunten" }),
    "Trau Dich!");
    
  AddDetail( ({ "granit" }),
    "Es ist also Granit!");
    
  AddDetail( ({ "bloecke", "block" }),
    "Sie wurden hier sehr eben verlegt und bilden einen geraden "
    "Untergrund.");
    
  AddDetail( ({ "untergrund" }),
    "Er ist so flach, dass die Woelbung am Rand kaum auffaellt.");
    
  AddDetail( ({ "rand" }),
    "Da fangen die Zinnen an.");
    
  AddDetail( ({ "zinnen", "zinne" }),
    "Natuerlich Zinnen! Sonst wuerdest Du beim naechsten Windstoss "
    "runterfallen.");
    
  AddDetail( ({ "windstoss" }),
    "Das waere zu gefaehrlich.");
    
  AddDetail( ({ "woelbung" }),
    "Es ist eine Einwoelbung.");
    
  AddDetail( ({ "einwoelbung" }),
    "Dir faellt auf, dass sie die ganze Bruecke entlang fuehrt. Welchen "
    "Zweck koennte sie nur erfuellen?");
    
  AddDetail( ({ "zweck" }),
    "Du beugst Dich etwas ueber sie und kannst etwas Moder erkennen.");
    
  AddDetail( ({ "moder" }),
    "Der entsteht doch nur bei Feuchtigkeit, oder?");
    
  AddDetail( ({ "feuchtigkeit" }),
    "Bedingt durch Regen?");
    
  AddDetail( ({ "regen" }),
    "Genau! Es ist eine Regenrinne!");
    
  AddDetail( ({ "regenrinne", "rinne" }),
    "Erstaunlich, an was damals alles gedacht wurde.");

  AddDetail( ({ "steinbruecke", "bruecke" }),
    "Welche Materialien haette man denn sonst nehmen sollen?");
    
  AddDetail( ({ "materialien", "material" }),
    "Mach mal ein paar Vorschlaege!");
    
  AddDetail( ({ "vorschlaege", "vorschlag"}),
    "Du denkst . o O ( Holz, Gold, Metall)");
    
  AddDetail( ({ "holz" }),
    "Holz? Und was machst Du, wenn mal ne Fackel auf den Boden faellt?");
    
  AddDetail( ({ "fackel" }),
    "Mitdenken!");
    
  AddDetail( ({ "gold" }),
    "Du scheinst viel davon zu haben. Zuviel *haendereib*");
    
  AddDetail( ({ "metall" }),
    "Nu genau! Und Metall ist ja auch kein bisschen schwer. Tolle Idee.");
    
  AddDetail( ({ "idee" }),
    "Du strahlst wie ein Honigkuchenpferd.");
    
  AddDetail( ({ "honigkuchenpferd" }),
    "Kannst aber auch stolz auf Dich sein!");
    
  AddDetail( ({ "wolken", "wolke" }),
    "Sie sehen sehr leicht aus. Es ist ein friedlicher Anblick, wie sie so "
    "im Wind dahingleiten.");
    
  AddDetail( ({ "anblick" }),
    "Dir wird ganz warm ums Herz.");
    
  AddDetail( ({ "wind" }),
    "Es ist eine herrliche Luft heute.");
    
  AddDetail( ({ "luft" }),
    "So sauber und klar.");
    
  AddDetail( ({ "aussicht" }),
    "Sie ist durch die Wolken leider sehr stark eingeschraenkt. Du kannst "
    "kein Loch ausmachen.");
    
  AddDetail( ({ "sueden", "turm" }),
    "Der Turm im Sueden erregt Deine Aufmerksamkeit.");
    
  AddDetail( ({ "aufmerksamkeit" }),
    "Du kannst es kaum erwarten, dorthin zu gelangen.");
    
  AddDetail( ({ "norden" }),
    "Du musst schlucken, wenn Du siehst, wie die Bruecke einfach so im "
    "Nichts verschwindet.");
    
  AddDetail( ({ "nichts" }),
    "So scheint es Dir.");
    
  AddDetail( ({ "loch" }),
    "Du kannst nicht durch die Wolken durchschauen und das einzige Loch "
    "befindet sich im Sueden. Seltsam, der Wind scheint den Standort des "
    "Loches nicht zu verschieben.");
    
  AddDetail( ({ "standort" }),
    "Du betrachtest das Loch noch eine Weile und tatsaechlich: Es bleibt "
    "immer an der selben Stelle.");
    
  AddDetail( ({ "weile" }),
    "Nur einige Minuten.");
    
  AddDetail( ({ "minuten" }),
    "Du hast ja nicht ewig Zeit.");
    
  AddDetail( ({ "zeit" }),
    "Sie ist kostbar, vergeude sie nicht fuer Unsinn.");
    
  AddDetail( ({ "unsinn" }),
    "Langsam fange ich an, welchen zu schreiben. Hilfe!");
    
  AddDetail( ({ "hilfe" }),
    "Ich bin ein Magier! Holt mich hier raus!");
    
  AddDetail( ({ "magier" }),
    "Ich!");
    
  AddDetail( ({ "stelle" }),
    "Ob Du im Sueden mehr erkennen kannst?");
    
  AddDetail( ({"pause", "bruecke", "wand", "herz", "decke", "waende", "o"}), 
  						 "Mach mal ne Pause!");

  AddExit( "nordunten", ROOM "e3-e1");
  AddExit( "suedoben", ROOM "e5");
  
  SetProp(P_HIDE_EXITS, ({"norden", "sueden"}) );
  AddExit( "norden", ROOM "e3-e1");
  AddExit( "sueden", ROOM "e5");
  
}