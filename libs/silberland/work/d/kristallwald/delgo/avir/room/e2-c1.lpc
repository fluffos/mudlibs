
#include "../def.h"

inherit ROOM "std_mauer"; 

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Die Stadtmauer" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Stadtmauer von Avir. Die Zinnen rechts und links von "
    "Dir begrenzen den Weg der Soeldner. Von hier oben hast Du eine gute "
    "Aussicht auf Tethyr und die Stadt. Du bleibst einen Moment stehen und "
    "laesst das alles auf Dich einwirken. Du befindest Dich in der "
    "nordwestlichen Ecke der Mauer." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"nordwestlichen"}), 
     "Was untersuchst Du denn?");

  AddDetail( ({"ecke"}), 
     "Naja, die Mauer macht hier einen Knick.");
     
  AddDetail( ({"knick"}), 
     "... in der Optik?");
     
  AddDetail( ({"optik"}), 
     "Deine Optik ist .. na lassen wir das.");
     
  AddDetail( ({"wir", "Du"}), 
     "Herst! Was denn nu noch?");
     
  AddDetail( ({"aussicht"}), 
     "Du kannst von hier aus den Nordwesten des Waldes gut einsehen.");
     
  AddDetail( ({"nordwesten"}), 
     "Du siehst an der Felswand einen Wasserfall.");
     
  AddDetail( ({"felswand"}), 
     "Ob man da rauf kann?");
     
  AddDetail( ({"wasserfall"}), 
     "Wirklich ein toller Anblick. Der Wasserfall ergiesst sich in einem "
     "See.");
     
  AddDetail( ({"anblick"}), 
     "Das muss ein toller Ort sein.");
     
  AddDetail( ({"ort"}), 
     "Du glaubst ein paar Gebaeude zu erkennen.");
     
  AddDetail( ({"gebaeude"}), 
     "Bei genauerer Betrachtung stellst Du fest, dass es ein grosses "
     "Gebaeude, fast schon eine kleine Stadt, ist.");
     
  AddDetail( ({"betrachtung"}), 
     "Sieht aus wie ein Palast...");
     
  AddDetail( ({"palast"}), 
     "Er ist recht hoch, er wird nur durch die hohen Baeume so gut "
     "verborgen.");
     
  AddDetail( ({"baeume", "baum"}), 
     "Sie sind wirklich hoch.");
     
  AddDetail( ({"see"}), 
     "Das Wasser ist bestimmt herrlich...");
     
  AddDetail( ({"wasser"}), 
     "Du musst unwillkuerlich an ein Bad denken. Ja. Ein Bad wuerde Dir "
     "jetzt gut tun.");
     
  AddDetail( ({"bad"}), 
     "Na hier bestimmt nicht!");

  AddExit( "sueden", ROOM "e2-c2");
  AddExit( "osten", ROOM "e2-d1");

}
