
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Hangebruecke" );
  SetProp( P_INT_LONG,
    "Jetzt, da Du Dich links und rechts an einem Seil festhaeltst und "
    "langsam auf den Brettern weitergehst, erinnerst Du Dich wieder "
    "schlagartig an Deine Hoehenangst. Nervoes laechelnd machst Du einen "
    "Schritt nach dem anderen und hast endlich die Mitte erreicht. Die "
    "beiden Wachen grinsen sich dumm an, lassen Dich aber passieren. Nach "
    "Osten kannst Du in die Stadt gehen und nach Westen gehts zum Felsen."
    );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );

 AddDetail( ({ "himmel" }),
    "Ja, genau, schau nach oben, lenk Dich ab ... bleib locker .. mach ein "
    "paar Atemuebungen. Nicht an den Boden denken.");
    
  AddDetail( ({ "atemuebungen", "atemuebungen", "uebung", "uebungen" }),
    "Du schliesst die Augen und atmest tief ein und aus.");
    
  AddDetail( ({ "augen", "auge" }),
    "Als Du sie wieder oeffnest, hast Du schon fast vergessen, dass Du hier "
    "200 METER UEBER DEM VERDAMMTEN BODEN BIST! PANIK!");
    
  AddDetail( ({ "boden" }),
    "Der ist bestimmt da, irgendwo da unten. Mach Dir um den keine Sorgen.");
    
  AddDetail( ({ "sorgen", "sorge" }),
    "Der kann nicht wie Du in die Tiefe stuerzen.");
    
  AddDetail( ({ "panik" }),
    "Die ist hier durchaus angebracht.");
    
  AddDetail( ({ "tiefe" }),
    "199 Meter zu tief fuer Deinen Geschmack.");
    
  AddDetail( ({ "meter" }),
    "Du kommst echt auf bloede Ideen in solchen Situationen.");
    
  AddDetail( ({ "geschmack" }),
    "Mmhhhh... Fallschirm.");
    
  AddDetail( ({ "fallschirm" }),
    "Ja genau. Sowas haettest Du jetzt echt gerne.");
    
  AddDetail( ({ "ideen", "idee" }),
    "'Meter' untersuchen.. also wirklich *kopfschuettel*");
    
  AddDetail( ({ "situationen" , "situation"}),
    "Toll, jetzt hast Du es geschafft! Ich weiss nichts mehr. Zufrieden?");
    
 AddDetail( ({ "seil", "seile" }),
    "Du denkst . o O (Die koennten ruhig dicker sein.)");
    
  AddDetail( ({ "bretter", "brett" }),
    "Aus Holz.");
    
  AddDetail( ({ "holz" }),
    "Ist doch nun echt egal, aus welchem Material sie sind, Hauptsache sie "
    "halten.");
  
  AddDetail( ({"hauptsache"}),
     "Nicht zu verwechseln mit der schoensten Nebensache der Welt.");
  
  AddDetail( ({ "nebensache", "welt" }) , 
     "...");
  
  AddDetail( ({ "material" }),
    "Warum musst Du ausgerechnet jetzt an morsche Aeste und verfaulte "
    "Baumstuempfe denken?");
    
  AddDetail( ({ "aeste", "baumstuempfe", "ast", "stumpf", "baumstumpf",
   "stuempfe" }),
    "Spring und sie werden Dich fangen.");
    
 	AddDetail( ({ "hoehenangst" }),
    "Angst vor der Hoehe.");
    
  AddDetail( ({ "angst" }),
    "Sie kann hier Dein groesster Feind werden.");
    
  AddDetail( ({ "feind" }),
    "Gleich nach mir, versteht sich.");
    
  AddDetail( ({ "hoehe" }),
    "Obwohl die Tiefe auch beeindruckend ist. *nervoes*");
    
 	AddDetail( ({ "schritt" }),
    "Deinen Schritt untersuchen solltest Du alleine tun, Du Ferkel!");
    
  AddDetail( ({ "ferkel" }),
    "Ja Du!");
    
 	AddDetail( ({ "mitte" }),
    "Hier stehen nochmals zwei Wachen. Sie sind die Hoehe gewohnt und fuer "
    "sie sieht es bestimmt komisch aus, wie Du hier um Dein Leben "
    "kaempfst.");
    
  AddDetail( ({ "wachen" }),
    "Wenn man sich das ueberlegt, ist das eine gute Sicherung. Zwei gute "
    "Kaempfer koennen so eine Armee lange hinhalten.");
    
  AddDetail( ({ "leben" }),
    "Gehoert bald mir.");
    
  AddDetail( ({ "sicherung", "kaempfer", "armee" }),
    "Bis zur Mitte hin ist die Bruecke so schmal, dass man nur alleine dort "
    "entlanggehen  kann. Hier ist es etwas breiter, damit die Wachen "
    "ungehindert kaempfen koennen und man die Leute, die einem "
    "entgegenkommen, vorbeilassen kann.");
    
  AddDetail( ({ "leute" }),
    "Solche wie Du, die unbedingt testen muessen, wieviel die Bruecke "
    "aushaelt.");
    
  AddDetail( ({ "bruecke", "hanegebreucke", "zwei" }),
    "Sowas siehst Du da nicht!\n"
    "<kleiner Scherz>\n"
    "Sie wird hauptsaechlich durch vier Seile getragen. Zwei unten, "
    "auf denen die Bretter befestigt sind, und zwei oben. Von denen gehen "
    "alle fuenfzig Zentimeter einzelne Streben ab.");
    
  AddDetail( ({ "strebe", "streben" }),
    "Sie fixieren die Bretter. Ein Meter ueber den Brettern wurde ein Strick "
    "dazwischen gebunden. Er dient als Gelaender.");
    
  AddDetail( ({ "festhalten", "gelaender" }),
    "Zum Festhalten.");
    
  AddDetail( ({ "strick" }),
    "Den solltest Du Dir nicht nehmen. Hahaha *waelz*  - Warte noch "
    "einer:\n"
    "Den zu nehmen waere extrem hochmuetig von Dir!\n"
    "Du hoerst wie Jemand fuenf Muenzen in die Witz&Wortspielkasse legt.");
    
 AddDetail( ({"muenze", "muenzen"}),
    "Die sind jetzt in der Witz&Wortspielkasse."
    );
    
  AddDetail( ({ "witz&wortspielkasse" }),
    "Die.. hahaha... nein, ich kann nicht vor Lachen. Tut mir leid. "
    "Untersuch was anderes *traenenabwischend*");
    
  AddDetail( ({ "lachen" }),
    "Du brichst vor Lachen zusammen.");
    
  AddDetail( ({ "osten", "stadt", "westen" , "felsen" }),
    "Die Haelfte hast Du geschafft.");
  
  AddDetail( ({ "fels" }), "Recht weich heute.!");
      
  AddDetail( ({ "haelfte" }),
    "Die andere liegt noch vor Dir.");
  
  AddDetail( ({ "bist", "dem", "die", "jemand", "knack", "knapp", "knarr", 	
  	"la", "lala", "o", "oh", "schaukeln", "scherz", "schwalbe", "sie", 
  	"ueber", "verdammten", "warte", "witz", "wortspielkasse", "wind", "ein"}), 
    "Nicht uebertreiben!"); 
    //keine fehlende Substantive, aber yat mags trotzdem net wenn sie da sind
    

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen des Windes.");

  AddSound( ({ "rauschen", "wind" }),
    "Schoen. Du ueberhoerst ganz bewusst das Knarren und Knacken der "
    "Bretter.");
    
  AddSound( ({ "knarren", "knacken", "bretter" }),
    "LA-LALA-LA-LA!");
 

  AddRoomMessage( 
  	({BS("Du schliesst die Augen und geniesst die frische Luft.\n"),
      "*Knarr*\n", 
      "*Knack*\n", 
      "Ein starker Wind bringt die Bruecke zum Schaukeln.\nDu denkst . o O "
      "(Oh Oh ...)\n", 
      "Eine freche Schwalbe segelt ploetzlich extrem knapp an Deinem "
      "Gesicht vorbei.\nDu stolperst erschrocken ein paar Schritte "
      "zurueck.\n"}),
      40);
                    
 AddDetail( ({"gesicht", "ansichtssache"}),
    "Das ist Dein Problem."
    );
    
 AddDetail( ({"problem", "zentimeter"}),
    "Ansichtssache."
    );
    
 AddDetail( ({"Luft"}),
    "Fast haettest Du vergessen zu atmen!"
    );
    

  AddCmd( ({ "springe", "spring" }), "sprung" );

  AddExit( "westen", ROOM "e1-a3-haengebruecke" );
  AddExit( "osten", ROOM "e1-c3-tor" );

  AddItem( NPC "soeldner" , REFRESH_DESTRUCT);
  AddItem( NPC "soeldner" , REFRESH_DESTRUCT);
}

int sprung(string str)
{
  notify_fail( "Was willst Du tun?\n" );
  if( str == "runter" )
  {
    write("Das kannst Du Dir doch gar nicht leisten!\n");
    return 1;
  }
  return 0;
}