
#include "../def.h"

inherit ROOM "std_mauer";  

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Die Stadtmauer" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Stadtmauer von Avir. Die Zinnen rechts und links von "
    "Dir begrenzen den Weg der Soeldner. Von hier oben hast Du eine gute "
    "Aussicht auf Tethyr und die Stadt. Du bleibst einen Moment stehen und "
    "laesst das alles auf Dich einwirken. Im Norden steht ein Turm." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"turm", "was"}), 
     "Da kommst Du her.");
     
  AddDetail( ({"aussicht"}), 
     "Der Wald liegt ruhig im Osten.");
     
  AddDetail( ({"osten"}), 
     "Die Felswand ist dort nur etwas schroffer und flacher als in anderen "
     "Teilen des Tals.");
     
  AddDetail( ({"teile", "teil"}), 
     "Die anderen eben.");
     
  AddDetail( ({"felswand"}), 
     "Du glaubst es kaum, aber fuehrt da tatsaechlich eine Treppe hinauf?");
     
  AddDetail( ({"treppe"}), 
     "Du kneifst die Augen zusammen.");
     
  AddDetail( ({"augen", "auge"}), 
     "Da ist wirklich eine Treppe und sie scheint zu einer Festung zu "
     "fuehren.");
     
  AddDetail( ({"festung"}), 
     "Bestimmt verlassen, Teile der Treppe fehlen ja schon und Du siehst "
     "auch so keine Lebenszeichen.");
     
  AddDetail( ({"lebenszeichen"}), 
     "Wie auch, auf die Entfernung.");
     
  AddDetail( ({"entfernung"}), 
     "Bestimmt eine Meile weg.");
     
  AddDetail( ({"meile"}), 
     "<Regie: 1 Meile = 1 Kilometer> *kursiv*");

  AddDetail( ({"kilometer"}), 
     "Oehm ... *regieanfunkel* Was bedeutet das? *huestel*"); 
     
  AddDetail( ({"regie"}), 
     "<Regie: <- nicht da> *kursiv*");    
  AddExit( "norden", ROOM "e2-g3");
  AddExit( "sueden", ROOM "e2-g5");

}
