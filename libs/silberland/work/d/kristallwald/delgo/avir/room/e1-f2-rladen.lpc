
#include "../def.h"

inherit "std/laden";
#include <laden.h>

#include <properties.h>
#define CON random(26)
#define STR random(26)
#define DEX random(26)
#define INE random(26)



void create() 
{
  string datum, dat;
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));

  SetProp(P_INT_SHORT,"In einem Ruestungsladen.");
  SetProp(P_SHOPKEEPER_ID, "kronosch");

  SetProp(P_SHOPKEEPER_NAME, "Kronosch");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetStorageRoom(ROOM "lagerraum_r" );
  AddItem(NPC "kronosch", REFRESH_DESTRUCT);
  
  AddDetail( ({ "tafel" }),
    "Lies sie doch mal!");
    
  AddDetail( ({ "decke" }),
    "Ein paar Holzbalken dienen als Decke.");
    
  AddDetail( ({ "holzbalken" }),
    "Aus Holz eben.");
    
  AddDetail( ({ "holz" }),
    "War das nicht dieses durchsichtige Material, aus dem Fenster gemacht "
    "werden?");
    
  AddDetail( ({ "fenster" }),
    "Hier sind keine, man koennte hoechstens die Oeffnung als eines sehen.");
    
  AddDetail( ({ "material" }),
    "Ich kenne jetzt leider nicht die chemische Zusammensetzung, aber ich "
    "bin mir sicher, das war es.");
    
  AddDetail( ({ "zusammensetzung" }),
    "Na, die Formel.");
    
  AddDetail( ({ "formel" }),
    "Ich hab doch gesagt: 'Ich habe keine Ahnung!'"); 
    
    
  AddDetail( ({ "ahnung", "wort" }), 
    "Du weisst, wie das Zeug heisst, aus dem Fenster sind? Na, dann schiess "
    "los. <Einfach das wort untersuchen>");
    
  AddDetail( ({ "zeug" }),
    "Weisst Du es nun oder nicht?");
  
  AddDetail( ({"glas"}), "Stimmt ja!");  
  
  AddDetail( ({ "waende", "wand" }),
    "Aus groben Steinbloecken zusammengesetzt. Mann, ist der Besitzer "
    "geizig!");
    
  AddDetail( ({ "besitzer" }),
    "Kronosch ist sein Name.");
    
  AddDetail( ({ "name" }),
    "Deiner ist "+TPN+".");
    
  AddDetail( ({ "steinbloecke", "block", "blocke", "steinblock" }),
    "Das gibt es doch nicht! Keine unsauberen Fugen, kein rissiger Moertel, "
    "keine Muster und keine Loecher! An diesen Waenden gibt es keine "
    "Besonderheiten! Das nenne ich Geiz!");
    
  AddDetail( ({ "fugen", "moertel", "muster", "loecher", "besonderheiten" }),
    "Keine da!");
    
  AddDetail( ({ "geiz" }),
    "*gruebel*. Naja, diese extrem ausgepraegte Art von Geiz koennte man "
    "schon als Besonderheit bezeichnen. Du gehts ueber Los und kannst "
    "weiterforschen: unt Himmel.");
    
  AddDetail( ({ "himmel" }),
    "Du bekommst den Forscherpunkt des Jahres!");
    
  AddDetail( ({ "forscherpunkt" }),
    "Aus!");
    
  AddDetail( ({ "jahr" }),
    "Wie schreiben das Jahr... aehm... *fluesternd* ... welches Jahr? "
    "...*lauter* mit gross J, klein a, h und r .");
   
  AddDetail( ({ "besonderheit" }),
    "Jetzt bist Du wieder gluecklich, das kann ich mir denken.");
    
  AddDetail( ({ "art", "beste" }),
    "Deine ist nicht die Beste!"); 
    
  AddDetail( ({ "los" }),
    "Fehlstart!");
    
  AddDetail( ({ "fehlstart" }),
    "Alle Augen sind auf Dich gerichtet!");
    
  AddDetail( ({ "augen", "auge" }),
    "Da gibts auch welche aus diesem komischen Material.");
    
  AddDetail( ({ "boden" }),
    "Kronosch's Geiz kennt keine Grenzen: Nicht mal einen Boden hat er sich "
    "geleistet!");
    
  AddDetail( ({ "grenzen" }),
    "Du kannst Dich auf ein paar gesalzene Preise vorbereiten.");
    
  AddDetail( ({ "preise", "preis" }),
    "Die sind happig!");
    
  AddDetail( ({ "eingangsbereich", "raum" }),
    "Schlicht waere eine Untertreibung, wenn Du den Eingangsbereich "
    "beschreiben wuerdest: Ein zwei mal zwei Schritt grosser Raum, in dem es"
    " nur die Tuer und eine Oeffnung gibt. Die Oeffnung ist in der Ostwand "
    "und dient gleichzeitig als Theke, auf ihr wurde eine Tafel "
    "aufgestellt. Dahinter scheint sich das Lager zu befinden.");

  AddDetail( ({ "untertreibung" }),
    "Zu sagen, Delgo waere ein Genie, ist eine.");
    
  AddDetail( ({ "genie" }),
    "finger delgo");
    
  AddDetail( ({ "delgo" }),
    "Ein arroganter, groessenwahnsinniger und diabolischer Blutmagier.");
    
  AddDetail( ({ "blutmagier" }),
    "Zum Glueck ist er nicht hier.");
    
  AddDetail( ({ "glueck" }),
    "DEIN Glueck.");
    
  AddDetail( ({ "Dein" }),
    "Stellen wir uns heute besonders geschickt an? Lies Deinen Namen. "
    "Wahrscheinlich bist Du auf den Namen auch noch stolz.");
    
  AddDetail( ({ "schritt" }),
    "1...2... *konzentriert*.... *RUMS*\n"
    "Dein Kopf tut jetzt zwar weh, aber der Raum ist wirklich so 'gross'.");
    
  AddDetail( ({ "kopf" }),
    "Ich koennte stundenlang darueber herziehen, was man daran verbessern "
    "koennte, aber was gehts mich an.");
    
  AddDetail( ({ "ostwand" }),
    "So ein Zufall! Die Waende sind genau nach den Himmelsrichtungen "
    "ausgerichtet, das ist im Silberland garantiert einzigartig!");
    
  AddDetail( ({ "himmelsrichtungen", "richtungen", "richtung", 
    "himmelsrichtung" }),
    "Vier wuerde man auf Anhieb sagen, aber gibts mehr?");
    
  AddDetail( ({ "anhieb" }),
    "Natuerlich gibt es mehr!");
    
  AddDetail( ({ "silberland" }),
    "In seiner wunderbaren Gesamtheit koennen es nur Dusty und Woody "
    "betrachten!");
    
  AddDetail( ({ "gesamtheit" }),
    "Alles zusammen eben.");
    
  AddDetail( ({ "dusty" }),
    "*ehrfuerchtige Stille*");
    
  AddDetail( ({ "woody", "urgrossvater" }),
    "Urgrossvater!");
    
  AddDetail( ({ "zufall" }),
    "Es muss Zufall sein, kein Architekt kann sowas!");
    
  AddDetail( ({ "architekt" }),
    "Sieh Dir doch Friedensreich Hundertwasser an, nicht einen geraden "
    "Raum hat der hinbekommen.");
    
  AddDetail( ({ "friedensreich", "hundertwasser" }),
    "Du kennst Friedensreich Hundertwasser nicht *blass* ... *RAUS AUS "
    "MEINER STADT!*");
    
  AddDetail( ({ "stadt", "town" }),
    "There is a new Mag in town... *sing*");
    
  AddDetail( ({ "mag" }),
    "Wer hat das hier wohl verzapft?");
    
  AddDetail( ({ "tuer", "holztuer" }),
    "Wenigstens hat sich Kronosch fuer die Holztuer noch einen Griff "
    "geleistet!");
    
  AddDetail( ({ "griff", "klinke"}),
    "Auf Zwergenhoehe.");
    
  AddDetail( ({ "zwergenhoehe" }),
    "Seufz *bueckend* (Boeses dem, der Schlechtes denkt!)");
    
  AddDetail( ({ "schlechtes" }),
    "Wenn sich ein Elf z.B. eine Elfe vorstellt, wie sie die Klinke "
    "benutzen will...");
    
  AddDetail( ({ "elf", "elfe" }),
    "^^");
    
  AddDetail( ({ "boeses" }),
    "...");
    
  AddDetail( ({ "oeffnung", "loch" }),
    "Ein rechteckiges Loch in der Ostwand.");
    
  AddDetail( ({ "theke" }),
    "Theke ist fuer das (wahrscheinlich extrem teure) Holzbrett, welches "
    "auf der unteren Kante der Oeffnung angebracht wurde, etwas "
    "uebertrieben.");
    
  AddDetail( ({ "holzbrett", "brett" }),
    "Eine Tafel wurde darauf aufgestellt.");
    
  AddDetail( ({ "kante" }),
    "Ein guter Schriftsteller, der alte Immanuel...");
    
  AddDetail( ({ "schriftsteller", "immanuel" }),
    "Hast Du gar kein Allgemeinwissen?");
    
  AddDetail( ({ "allgemeinwissen" }),
    "Das stellen wir ab: -a+");
 
    
  AddDetail( ({ "lager" }),
    "Viel kannst Du nicht erkennen, denn es ist stockdunkel da drinnen. Kein"
    " Wunder, das einzige Licht hier kommt durch die Tuer.");
    
  AddDetail( ({ "wunder" }),
    "Es ist keines.");
    
  AddDetail( ({ "licht" }),
    "Da!");
  
  AddDetail( ({"detail", "aus", "avirs", "ecken", "guete", "j", "kronosch", 
  	"laden", "luft", "mann", "mauer", "meiner", "raus", "rums", "wand"}), 
  	"Warum fehlt das Detail?");


  AddSound( DEFAULT_SOUND,
    "*Stille*");

  AddSound( ({ "stille" }),
    "Oh man... *seufz*");

  AddSmell( DEFAULT_SMELL,
    "Es riecht ... naja... eben nach Zwerg!");

  AddSmell( ({ "zwerg" }),
    "Kronosch sollte mal lueften!");
    
  AddRoomMessage( 
    ({
    "Wie kann Kronosch den Laden hier nur halten, wenn er so unfreundlich "
    "ist?\n",
    "Es ist ziemlich schlechte Luft hier drinnen!\n",
    "Kronosch raeumt etwas im Lager um.\n",
    "Das schwache Licht scheint den Zwergen nicht zu stoeren.\n",
    "Wirklich einer der ruhigsten Ecken Avirs.\n",
    "Meine Guete, auf der Mauer ist ja mehr los!\n",
    }),49);

  AddExit( "westen", ROOM "e1-e2-platz" );
  
  datum = dtime();
	dat = extract(datum,0,2);
	call_other(ROOM "lagerraum_r", "refresh", 0);
	if( dat == "Sam" || dat == "Mit" || dat == "Son")
	{
		call_out("samstag", 0);
		//call_other(ROOM "lagerraum_r", "samstag", 0);
		return ;
	}
	if( dat == "Die" || dat == "Fre")
	{
		call_out("sonntag", 0);
		//call_other(ROOM "lagerraum_r", "sonntag", 0);
		return ;
	}
	if(dat == "Mon" || dat == "Don")
	{
		call_out("montag", 0);
		//call_other(ROOM "lagerraum_r", "montag", 0);
		return ;
	}
	else
	{
		write("Etwas stimmt nicht\n");
		return ;
	}

 
}

string _query_int_long()
{
  string txt;

  txt = "Schlicht waere eine Untertreibung, wenn Du den Eingangsbereich "
  	"beschreiben wuerdest: Ein zwei mal zwei Schritt grosser Raum, in dem "
  	"es nur die Tuer und eine Oeffnung gibt. Die Oeffnung ist in der "
  	"Ostwand und dient gleichzeitig als Theke, auf ihr wurde eine Tafel "
  	"aufgestellt. Dahinter scheint sich das Lager zu befinden. ";

  if(QueryProp(P_SHOPKEEPER_ID))
  {
    if(!present(QueryProp(P_SHOPKEEPER_ID)))
    {
      txt += "Seltsam, Kronosch ist nicht da.";
    }
    else
    {
      txt += "Kronosch steht wie gewohnt hinter der Theke.";
    }
  }

  return BS(txt);
}
int samstag()
{
	RemoveReadDetail( ({"tafel"}) );
  AddReadDetail( ({ "tafel" }),
    "\n"
    "\n"
    "	HEUTE: Tag des Torsos, alles fuer Rumpf und Kopf!\n"
    "\n"
    "\n"
    );
   
}
int sonntag()
{
	RemoveReadDetail( ({"tafel"}) );
  AddReadDetail( ({ "tafel" }),
    "\n"
    "\n"
    "	HEUTE: Tag der Extremitaeten, alles fuer Arme und Beine!\n"
    "\n"
    "\n"
    );
 
}
int montag()
{
	RemoveReadDetail( ({"tafel"}) );
  AddReadDetail( ({ "tafel" }),
    "\n"
    "\n"
    "	HEUTE: Tag der Feiglinge: Schilde und Umhaenge!\n"
    "\n"
    "\n"
    );
   
}

void reset()
{
	string datum, dat, room;
	
	::reset();
	datum = dtime();
	dat = extract(datum,0,2);
	room = ROOM"lagerraum_r";
	room->destruct();
	if( dat == "Sam" || dat == "Mit" || dat == "Son")
	{
		call_out("samstag", 0);
		//call_other(ROOM "lagerraum_r", "samstag", 0);
		return ;
	}
	if( dat == "Die" || dat == "Fre")
	{
		call_out("sonntag", 0);
		//call_other(ROOM "lagerraum_r", "sonntag", 0);
		return ;
	}
	if(dat == "Mon" || dat == "Don")
	{
		call_out("montag", 0);
		//call_other(ROOM "lagerraum_r", "montag", 0);
		return ;
	}
	else
	{
		write("Etwas stimmt nicht\n");
		return ;
	}
}