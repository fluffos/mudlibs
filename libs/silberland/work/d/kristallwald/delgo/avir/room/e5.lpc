
#include "../def.h"

inherit "std/room";

#include <properties.h>

string pfeil;

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Plattform" );
  SetProp( P_INT_LONG,
    "Du betrittst die Plattform und bleibst ploetzlich stehen. Unter Dir "
    "ist kein normaler Steinboden, sondern Nichts! Eine Sekunde des "
    "Schreckens spaeter erkennst Du, dass es sich um einen Fussboden aus "
    "Glas handelt. Du atmest erleichtert auf. Im Nordosten siehst Du nun "
    "auch den grossen Turm, welchen Du bereits von der Bruecke aus "
    "gesehen hast. "
    );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_KILL_NAME, "Ein Pfeilhagel");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "himmel" }),
    "Er liegt jetzt genau ueber Dir. Doch wenn Du erwartet hast, das Ende "
    "des Turmes zu sehen, wirst Du enttaeuscht, denn dieser verschwindet "
    "weit oben in weiteren Wolken.");
    
  AddDetail( ({ "ende" }),
    "Ob Du es jemals erreichen wirst?");
    
  AddDetail( ({ "wolken", "wolke" }),
    "Diese liegen ruhig ueber und auch unter Dir. Allerdings befindet sich "
    "genau unter dem Glas ein Loch, sodass man auf die Stadt sehen kann.");
    
  AddDetail( ({ "loch" }),
    "Es scheint auf magischem Wege erzeugt zu werden, wie, kannst Du aber "
    "nicht sofort feststellen.");
    
  AddDetail( ({ "wege", "wege" }),
    "Du schaust Dich nochmals genau um und stellst erneut fest: Der "
    "Mechanismus ist nicht hier oben.");
    
  AddDetail( ({ "mechanismus" }),
    "Wie auch immer er aussieht, er muss sich an der Unterseite der "
    "Plattform befinden.");
    
  AddDetail( ({ "unterseite" }),
    "Da willst Du lieber nicht hin, so eilig hast Du es mit diesem "
    "Forscherpunkt auch nicht.");
    
  AddDetail( ({ "forscherpunkt" }),
    "Ach lass ihn da wo er ist.");
    
  AddDetail( ({ "plattform" }),
    "Sie ist kreisrund und vollkommen flach. Der Radius betraegt circa zehn "
    "Meter und von der Mitte aus bis zwei Meter vor dem Rand wurde ein "
    "Glasfussboden eingesetzt. Weiterhin ist die Plattform von Zinnen "
    "umrandet, welche nur von den Brueckenaufgaengen und dem Eingang zum "
    "Turm unterbrochen werden.");
    
  AddDetail( ({ "turm" }),
    "Er wurde auf dem nordoestlichen Teil der Plattform erbaut und steht "
    "sogar etwas ueber. Kein Wunder, denn er ist relativ breit.");

  AddDetail( ({ "teil" }),
    "Im Nordosten.");
    
  AddDetail( ({ "nordosten" }),
    " __\n"
    "  /|\n"
    " /");
    
  AddDetail( ({ "wunder" }),
    "Der Turm ist ein solches, denn Dir scheint es unerklaerlich, wie er "
    "auf dieser Plattform halten kann. Denn bis auf die Bruecken hat er "
    "keinerlei Stuetzpfeiler.");
    
  AddDetail( ({ "meter", "die" }),
    "jaja...");
    
  AddDetail( ({ "bruecken", "bruecke" }),
    "Aber brauchen die nicht auch irgendwelche Stuetzpfeiler?");
    
  AddDetail( ({ "stuetzpfeiler", "pfeiler" }),
    "Schluss! Aus! Solche Gedanken sind es, die solche Wunder zum Einsturz "
    "bringen, und nicht das Fehlen jeglicher Stuetzpfeiler.");
    
  AddDetail( ({ "schluss" }),
    "Hoer auf!");
    
  AddDetail( ({ "gedanken" }),
    "Was ich nicht weiss, macht mich nicht heiss.");
    
  AddDetail( ({ "einsturz" }),
    "Nein, dieser Turm wird halten!");
    
  AddDetail( ({ "fehlen" }),
    "Ich hoer Dich nicht *lalalala*");
    
  AddDetail( ({ "eingang" }),
    "Eine offene Tuer.");
    
  AddDetail( ({ "tuer" }),
    "Sie besteht aus Holz und ist geoeffnet. Da sie allerdings angelehnt ist, "
    "kannst Du nicht nach Innen schauen.");
    
  AddDetail( ({ "innen" }),
    "Du bist gut! Willst Du etwa durchs Holz gucken?");
    
  AddDetail( ({ "holz" }),
    "Genau, das Detail is besser ... \nDie Tuer besteht aus Holz. Es "
    "besitzt eine relativ dunkle Maserung und sieht sehr stabil aus. Die "
    "Klinke ist natuerlich aus Metall.");
    
  AddDetail( ({ "maserung" }),
    "Sieht so aus, als waere sie aus dem Holz der Steineiche gebaut.");
 
  AddDetail( ({ "steineiche" }),
    "Also hier waechst garantiert keine!");
    
  AddDetail( ({ "klinke" }),
    "Sie besteht aus Metall und ist recht einfach gefertigt.");
    
  AddDetail( ({ "metall" }),
    "Schlichtes Eisen vermutest Du.");
  AddDetail( ({ "eisen" }),
    "Es ist schon relativ alt, Rost ist zu sehen.");
    
  AddDetail( ({ "rost" }),
    "Sei mal nicht so pingelig. Die Tuer ist in einem tadellosen Zustand "
    "und haelt jeden Angriff stand.");
    
  AddDetail( ({ "zustand" }),
    "Sagen wir ausreichend.");
    
  AddDetail( ({ "angriff" }),
    "Da kommst Du auch nicht mit Gewalt durch.");
    
  AddDetail( ({ "gewalt" }),
    "Die ist bei dieser Tuer sinnlos.");
    
  AddDetail( ({ "detail" }),
    "Ich seh hier kein einziges!");
    
  AddDetail( ({ "brueckenaufgaenge", "brueckenaufgang", "aufgaenge"
                , "aufgang" }),
    "Ueber sie kannst Du die Plattform betreten und verlassen. Sie fuehren "
    "in vier Richtungen.");
    
  AddDetail( ({ "richtungen", "richtung" }),
    "Na ist doch logisch: wenn auf dem Kreuzungspunkt zweier Bruecken eine "
    "Plattform errichtet wird, gibt es vier moegliche Richtungen.");
    
  AddDetail( ({ "kreuzungspunkt" }),
    "Der Mittelpunkt der Glasscheibe.");
    
  AddDetail( ({ "mittelpunkt" }),
    "Du stellst Dich aber auch zu dumm an!");
    
  AddDetail( ({ "zinnen", "zinne" }),
    "Sie wurden sauber gemauert und sehen sehr stabil aus. Das Mauerwerk "
    "muss ja auch einiges aushalten.");
    
  AddDetail( ({ "mauerwerk" }),
    "Das Mauerwerk der Zinnen sieht nicht besonders aus, aber etwas weiter "
    "oben an der Mauer des Turmes faellt Dir etwas auf.");
    
  AddDetail( ({ "mauer" }),
    "Du siehst einige Spalten.");
    
  AddDetail( ({ "spalten", "spalte" }),
    "Sie haben alle die gleiche Laenge und den selben Abstand, fast als "
    "seien sie Absicht.");
    
  AddDetail( ({ "absicht" }),
    "Wozu sollte man Spalten in einen Turm ... spalten?");
    
  AddDetail( ({ "abstand" }),
    "Du kannst vier Spalten zaehlen, die anderen kannst Du von hier aus "
    "nicht sehen, aber Du bist Dir sicher auch sie haben den selben "
    "Abstand. Seltsam.");
    
  AddDetail( ({ "laenge" }),
    "Du bemerkst, dass sie etwas breiter sind als urspruenglich vermutet. "
    "Du hast einen Verdacht ...");
  AddDetail( ({ "verdacht" }),
    "Sollten das Schiessscharten fuer Bogenschuetzen sein?");
    
  AddDetail( ({ "schiessscharten", "schiessscharte", "scharten", 
                "scharte" }),
    "Wenn das welche sind, gibt es auch Bogenschuetzen da drinnen.");
    
  AddDetail( ({ "bogenschuetzen" }),
    "Sie koennen die Plattform damit relativ gut absichern. Nicht "
    "schlecht.");
    
  AddDetail( ({ "radius" }),
    "Der Radius ist der halbe Durchmesser.");
    
  AddDetail( ({ "durchmesser" }),
    "Du zueckst einen Durchmesser.\nSpass beiseite: Die Breite an der "
    "breitesten Stelle der Plattform.");
    
  AddDetail( ({ "breite" }),
    "Das nennt man dan Durchmesser.");
    
  AddDetail( ({ "Stelle" }),
    "Immer in der Mitte.");
    
  AddDetail( ({ "mitte" }),
    "Diese ist durch den Mittelpunkt gekennzeichnet.");
    
  AddDetail( ({ "rand" }),
    "An ihm beginnen die Zinnen.");
    
  AddDetail( ({ "glasfussboden", "glasboden", "boden" }),
    "Die Glasscheibe fasziniert Dich.");
    
  AddDetail( ({ "glasscheibe", "scheibe" }),
    "Du kannst Dich nicht mehr halten und schaust durch die Glasscheibe und "
    "zu Deinem Erstaunen erkennst Du die Stadt.");
    
  AddDetail( ({ "erstaunen" }),
    "Das unter dem Glas ja ein Loch in den Wolken ist und Du die Stadt "
    "sehen kannst, erstaunt Dich nicht sonderlich, mehr ... die Groesse der "
    "Stadt.");
    
  AddDetail( ({ "stadt", "avir" }),
    "Diese Stadt heisst Avir.");
    
  AddDetail( ({ "groesse" }),
    "Du kannst die Strassen, Haeuser und Bewohner erkennen, als wuerdest Du "
    "aus maximal zwei Metern Hoehe herabschauen! Das ist eine Lupe!");

  AddDetail( ({ "hoehe" }),
    "Dabei bist Du fast 500 Meter hoch!");
    
  AddDetail( ({ "lupe" }),
    "Unglaublich! Du neigst Deinen Kopf etwas zur Seite und erkennst Die "
    "naechste Strasse.");
    
  AddDetail( ({ "kopf" }),
    "Deinen Kopf!");
    
  AddDetail( ({ "seite" }),
    "Du bist verbluefft! Dank diesem Meisterwerk der Optik kann man ganz "
    "Avir von hier oben aus ueberwachen. Wirklich eine tolle Erfindung.");
    
  AddDetail( ({ "meisterwerk" }),
    "Sie ist bestimmt uralt, denn Dir ist nicht bekannt, dass so etwas "
    "heute noch gebaut wird.");
    
  AddDetail( ({ "optik" }),
    "Die Linse so zu schleifen, muss sehr lange gedauert haben und nur "
    "Optiker koennen so etwas.");
    
  AddDetail( ({ "optiker" }),
    "Dein Respekt fuer diese Leute waechst etwas.");
    
  AddDetail( ({ "respekt" }),
    "Ehrgefuehl.");
    
  AddDetail( ({ "ehrgefuehl" }),
    "Respekt.");
    
  AddDetail( ({ "leute" }),
    "Du hast sie unterschaetzt.");
    
  AddDetail( ({ "linse" }),
    "Und diese Schaerfe! Von 500 Metern aus! Dir wird leicht schwindelig.");
    
  AddDetail( ({ "schaerfe" }),
    "Man kann sogar mit etwas Muehe Taschendiebe beobachten.");
    
  AddDetail( ({ "taschendiebe", "taschendieb", "diebe", "dieb" }),
    "Lass das lieber Profis machen.");
    
  AddDetail( ({ "profis", "profi" }),
    "Die Soeldner.");
    
  AddDetail( ({ "muehe" }),
    "Mit diesem Werkzeug koennen die Soeldner die Stadt ueberwachen und "
    "jedes Verbrechen erkennen.");
    
  AddDetail( ({ "werkzeug" }),
    "Omar ueberwacht diese Lupe normalerweise.");
    
  AddDetail( ({ "omar" }),
    "Ist nicht da.");
    
  AddDetail( ({ "verbrechen" }),
    "Deswegen sind sie in Avir alle so ruhig. Du bist erstaunt.");
    
  AddDetail( ({ "soeldner" }),
    "Durch diese Lupe wird die Arbeit der Soeldner erheblich vereinfacht.");
    
  AddDetail( ({ "arbeit" }),
    "Die Stadt wird dadurch wesentlich sicherer.");
    
  AddDetail( ({ "strassen", "strasse" }),
    "Du erkennst auch die kleinen Gassen.");
    
  AddDetail( ({ "gassen", "gasse" }),
    "Das ist wie ein Stadtplan!");
    
  AddDetail( ({ "stadtplan" }),
    "Mach Dir selber einen! Ich bin jetzt zu faul *fg*.");
    
  AddDetail( ({ "haeuser" }),
    "Naja, doch mehr die Daecher.");
    
  AddDetail( ({ "daecher", "dach" }),
    "Die sind fuer gewoehnlich oben, oder? Wie auch immer: Durch die "
    "einheitliche Farbe sieht die Stadt sehr harmonisch aus.");
    
  AddDetail( ({ "farbe" }),
    "Ein Rotbraun.");
    
  AddDetail( ({ "rotbraun" }),
    "Sieht sehr schoen aus.");
    
  AddDetail( ({ "bewohner" }),
    "Hihi, damit kann man sie auch bei privaten Unternehmen beobachten.");
    
  AddDetail( ({ "unternehmen" }),
    "So etwas macht Omar natuerlich nicht.");
    
  AddDetail( ({ "steinboden" , "fussboden"}),
    "Nur am Rand besteht er aus Stein, ansonsten aus Glas.");
    
  AddDetail( ({ "glas" }),
    "Natuerlich ist die Lupe aus Glas! Was sonst?");
    
  AddDetail( ({ "stein" }),
    "Du vermutest Granit, bist Dir aber nicht ganz sicher.");
    
  AddDetail( ({ "nichts" }),
    "Das war jetzt uebertrieben.");
    
  AddDetail( ({ "sekunde" }),
    "Es hat schon etwas gedauert, bis Du begriffen hast.");
    
  AddDetail( ({ "schrecken" }),
    "Die Vorstellung, gleich 500 Meter in die Tiefe zu stuerzen, ist schon "
    "nicht ganz so harmlos.");
    
  AddDetail( ({ "vorstellung" }),
    "Du haettest Dein Gesicht sehen sollen *prust*");
    
  AddDetail( ({ "gesicht" }),
    "Hoer auf! Ich kann nicht mehr... *waelz* .. ach.. Du guckst immer so?");
    
  AddDetail( ({ "tiefe" }),
    "Das gibt haessliche Flecken auf dem Fussweg.");
    
  AddDetail( ({ "flecken", "fussweg" }),
    "Hoffentlich faellt hier nie ein Troll oder ein Oger runter.");
    
  AddDetail( ({ "troll" }),
    "Die sind ja so schrecklich gross. Der Fleck erst... ich moechte es mir "
    "nicht vorstellen.");
    
  AddDetail( ({ "fleck" }),
    "Ich denk lieber an eine Fee.");
    
  AddDetail( ({ "fee" }),
    "Die sind schoen (handlich) klein.");
    
  AddDetail( ({ "oger" }),
    "Die sind so fett, danach muesste man ein ganzes Haus neu streichen.");
    
  AddDetail( ({ "haus" }),
    "Die Kosten, die Kosten ...");
    
  AddDetail( ({ "kosten" }),
    "Unbezahlbar.");
    
  AddDetail( ({ "erfindung" }),
    "Wirklich genial!");
    
  AddDetail( ({ "granit" }),
    "Stein eben.");

  AddExit( "nordunten", ROOM "e4-e2");
  AddExit( "suedunten", ROOM "e4-e4");
  AddExit( "westunten", ROOM "e4-d3");
  AddExit( "ostunten", ROOM "e4-f3");
  
  SetProp(P_HIDE_EXITS, ({"osten", "sueden", "norden", "westen"}) );
  AddExit( "norden", ROOM "e4-e2");
  AddExit( "sueden", ROOM "e4-e4");
  AddExit( "westen", ROOM "e4-d3");
  AddExit( "osten", ROOM "e4-f3");
  
  AddExit( "turm", "in den Turm#"AVIR_TDK);
  AddItem( NPC "omar" , REFRESH_DESTRUCT);
}
int my_filter_func(object ob) 
{
  if(ob->id("omar")) return 0;                                 
  return 1;   
}



int pfeile()
{
  
  int i,k, dam;
  mixed enemies;
  string room, pr;
  object omar;
  
  if(!(omar=present("omar", TO)))
    {
      return 0;
    }

  room=ROOM "e5";
  pr="/d/kristallwald/delgo/tdk/room/bogen";
  call_other(pr, "???", 0);
  if(!objectp(find_object(pr)) || pr->QueryPfeile() != 1) {return 0;}
  if(pfeil == "ja")
    {
      room->Message("Du siehst einen Pfeilhagel auf Dich zukommen.\n", 
		    MSGFLAG_VISUAL);
      room->Message("Die Pfeile prasseln nieder!\n", MSGFLAG_VISUAL);
    }
  else
    {
      room->Message("Omar donnert mit gewaltiger Stimme: Setzt die Boegen "
		    "ein!\n", MSGFLAG_VISUAL);
      room->Message("Du siehst einen Pfeilhagel auf Dich zukommen.\n", 
		    MSGFLAG_VISUAL);
      room->Message("Die Pfeile prasseln nieder!\n", MSGFLAG_VISUAL);
      pfeil = "ja";
    }
  enemies = filter_array(all_inventory(TO), "my_filter_func");
  //if(sizeof(enemies) == 1) { write(enemies[0]->name());}	
  //else write("Keine Feinde!\n"); - Testzwecke
  for (i=0; i<sizeof(enemies);i++)
    {
      k=sizeof(enemies);
      //enemies[i]->do_damage(200/(k+1)); 
      //alte Variante bis Defend() gewuenscht wurde
      if(objectp(enemies[i])){
	dam=enemies[i]->Defend((2100/k+1), DT_PIERCE, 0, omar);
      }
      //extra dafuer ein objekt (invis) Pfeil erschaffen -> 
      //hervorragende Treffermeldung 
      //enemies[i]->do_damage(dam);
      //4 Bogenschuetzen machen ca. 200 schadenzusammen, das wird natuerlich 
      //auf die gegner aufgeteilt. wenn jetzt jemand sagt: ab der 5ten person 
      //kriegt keiner mehr was ab sage ich die bogenschuetzen legen 
      //selbststaendig mehr pfeile in einen schuss :)
    }	
  return 1;	
}


