#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Haengebruecke" );
  SetProp( P_INT_LONG,
    "Du stehst auf einem hohen und schmalen Felsen. Wenn Du nach Westen "
    "schaust Du aus einer grossen Hoehe auf die schoenen Baeumen des "
    "Tethyrwaldes. Im Norden siehst Du auf einem weiteren Felsen einen "
    "kleinen Wachposten und nach Osten hin fuehrt eine grosse "
    "Haengebruecke in eine Stadt hinein."
    );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );
  
  SetProp(P_KILL_NAME , "Dummheit");

 AddDetail( ({ "fels", "felsen" }),
    "Die Felsen sind zylinderfoermig, und wie Dir jetzt auffaellt, EXTREM "
    "hoch und schmal. Stolpern waere fatal!"
    );
    
  AddDetail( ({ "gelaender" }),
    "War ja nochmal knapp! Wirklich eine tolle Erfindung."
    );
    
  AddDetail( ({ "erfindung" }),
    "Da war jemand schneller als Du."
    );

  AddDetail( ({ "stolpern" }),
    "Tu's nicht!"
    );
    
  AddDetail( ({ "anblick" }),
    "Wenn die Sonne langsam hinter den Wipfeln verschwindet, gibt das "
    "bestimmt ein praechtiges Bild."
    );
    
 AddDetail( ({ "westen", "wald", "tethyrwald"}),
    "Ein herrlicher Anblick!"
    );
    
  AddDetail( ({ "sonne" }),
    "Geht die ueberhaupt im Westen unter? Da gabs doch mal so einen "
    "Spruch..."
    );
    
  AddDetail( ({ "spruch" }),
    "Du ueberlegst und ueberlegst, aber kommst nicht drauf. Dabei hat ihn "
    "jeder schonmal in seiner Kindheit gehoert."
    );       //noch einbauen: man kann die Kinder nach dem spruch fragen und 
    				//die antworten dann (FP?)
    
  AddDetail( ({ "kindheit" }),
    "Das solltest Du nicht hier, sondern auf einer roten Couch untersuchen "
    "(lassen?)."
    );
    
  AddDetail( ({ "couch" }),
    "Sofa."
    );
    
  AddDetail( ({ "sofa" }),
    "Couch."
    );
    
  AddDetail( ({ "wipfel", "wipfeln" }),
    "Die Spitzen der Baeume."
    );
    
  AddDetail( ({ "bild" }),
    "*seufz* ich bin ja echt fuer einen iq - test, wenn man hier einen "
    "neuen charakter anlegt. (Du brauchst die substantive nicht zu "
    "untersuchen)"
    );
    
  AddDetail( ({ "iq", "test","substantive","charakter", "gross" }),
    "Das war doch gar nicht gross geschrieben! Du kannst echt nicht "
    "forschen... *kopfschuettel*"
    );
    
  AddDetail( ({ "spitze", "spitzen" }),
    "Gegenueber von den Wurzeln."
    );
    
  AddDetail( ({ "wurzel", "wurzeln" }),
    "Gegenueber von den ... na, aufgepasst?"
    );
    
 AddSpecialDetail( ({ "hoehe" }), "hoehe");
        
  AddDetail( ({ "meter", "typo" }),
    "Ich habe 'meter' extra klein geschrieben, damit Du es nicht "
    "untersuchst, aber nein - Du willst ja forschen *grmpf*"
    );
    
 AddDetail( ({ "baum", "baeume" }),
    "Du wirst Dich wohl nie an die blauen Blaetter des Tethyrwaldes "
    "gewoehnen. Trotzdem sehen sie schoen aus.");
 
 AddDetail( ({"blatt", "blaetter"}),
    "Sie sehen echt schoen aus."
    );
    
 AddDetail( ({"boden"}),
    "Felsen."
    );
    
 AddDetail( ({"punkt"}),
    "."
    );
    
 AddDetail( ({"extrem"}),
    "Man darf doch wohl noch ein wenig betonen duerfen, oder?"
    );
    
 AddDetail( ({ "wachposten", "norden" }),
    "Der Wachweg vom Wald hier hoch geht ueber einzelne kleine Posten "
    "mittels Bruecken von einem Punkt zum naechsten.");
    
  AddDetail( ({ "wachweg" }),
    "Die letzte Bruecke hier gibt's leider nur in 2 Teilen.");
        
  AddDetail( ({ "teil", "teile" }),
    "Das eine liegt unten und das andere ... oehm Ja!");
    
  AddDetail( ({ "bruecken", "bruecke" }),
    "Faellt Dir was besseres ein, das nicht sofort einfaellt?");
    
  AddDetail( ({ "punkte", "posten" }),
    "Die einzelnen Punkte sind Vorspruenge oder kleine separate Felsen wie "
    "der hier.");
    
  AddDetail( ({ "vorsprung", "vorspruenge" }),
    "Auf diesen sind dann ab und an kleine Wachposten eingerichtet. Das "
    "schuetzt gegen Feinde und Monster.");
    
  AddDetail( ({ "feind", "feinde" }),
    "Auch Du hast welche. Oder? (Ja/Nein)");
    
  AddDetail( ({ "ja" }),
    "Ich weiss eben alles.");
    
  AddSpecialDetail( ({ "nein" }), "feind");
        
  AddDetail( ({ "monster" }),
    "Davon gibts im Wald genug.");
    
 AddDetail( ({ "osten", "stadt" }),
    "Wenn Du nicht dumm sterben willst, solltest Du hingehen.\n"
    "Lars laechelt Dich aus der Ferne an.\n"
    );
    
 AddDetail( ({"ferne", "lars"}),
    "Noch."
    );
    
  AddDetail( ({ "haengebruecke" }),
    "Die haelt Dich bestimmt. Die im Norden hatte bestimmt ... sagen wir 3 "
    "Tage gehalten!");
    
  AddDetail( ({ "tag", "tage" }),
    "Recht lange, wenn man bedenkt, dass es Praktikanten gemacht haben.");
    
  AddDetail( ({ "praktikant", "praktikanten" }),
    "Praktikantinnen *huestel*");
    
  AddDetail( ({ "praktikantin", "praktikantinnen" }),
    "Ich hab hart dafuer gearbeitet bis ich .. ach was rechtfertige ich "
    "mich hier eigentlich. Ich koennte doch lieber Forscherfallen " 
    "einbauen.");
    
  AddDetail( ({ "forscherfallen" }),
    "*haendereib*");
    
  AddDetail( ({ "himmel" }),
    "Noch da.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst die ganz normalen Waldgeraeusche.");

  AddSound( ({ "waldgeraeusche", "geraeusche", "wald" }),
    "Ich bin mir sicher, Du warst schon einmal in einem Wald. ... Na also.");
    
  AddSmell( DEFAULT_SMELL,
    "Waldluft, frische herrliche Waldluft!");
    
 AddDetail( ({"zeit"}),
    "Da laeuft sie! Hinterher!"
    );

  AddSmell( ({ "waldluft", "luft" }),
    "Tust Du doch schon die ganze Zeit!");

  AddCmd( ({ "stolper", "stolpere" }), "stolpern" );

  AddExit( "osten", ROOM "e1-b3-haengebruecke");
  AddExit( "nordunten", "/d/kristallwald/delgo/wachweg/room/as_1");
  
  //SetProp(P_HIDE_EXITS, ({"norden"}) );
  //AddExit( "norden", "/d/kristallwald/delgo/wachweg/room/as_1");

}

int stolpern()
{
  write(BS("Zu spaet! Du stolperst und knallst genau gegen das unsichtbare "
  	"Gelaender.*Boing*"));
  this_player()->do_damage(5 + random(6), this_object());
  say(BS( "Autsch! "+TPN+" knallt mit dem Kopf gegen irgendwas. Du kannst "
  	"nicht sagen was es ist, aber es scheint weh zu tun."));
  return 1;
}
string hoehe()
{
 	while (remove_call_out("typo") != -1 );
 	call_out("typo", 4);
 	return BS(
 	  "Die Baeume sind erstaunlich gross, wenn man bedenkt, dass es bis hier "
 		"hoch bestimmt 200 meter sind.");
}

void typo()
{
	object ob;
  ob=present(TP);
  if(ob)
  {
  	write(BS("Jemand sagt: War da grade ein Typo?"));
	}
}

void feind()
{
  remove_call_out("feind1");
	while (remove_call_out("feind1") != -1);
	call_out("feind1", 2);
}

void feind1()
{
  object ob;

	remove_call_out("feind1");
	while (remove_call_out("feind1") != -1);
	ob=present(TP);
  if(ob)
  {
    write(BS("Delgo kommt an."));
    while (remove_call_out("feind2") != -1 );
    call_out("feind2", 2);
  }
}

void feind2()
{
	object ob;
        ob=present(TP);
        if(ob)
        {
        	write(BS("Delgo schlaegt sein Notizbuch auf, traegt '"+TPN+"' ein "
        		"und laechelt Dich kalt an."));
        	while (remove_call_out("feind3") != -1 );
        	call_out("feind3", 2);
        }
}

void feind3()
{
	object ob;
        ob=present(TP);
        if(ob)
        {
        	write(BS("Delgo verschwindet."));
        }
}