
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Der Westturm" );
  SetProp( P_INT_LONG,
    "Ein frischer und starker Wind weht um Deine Ohren, als Du die "
    "Turmspitze erreichst. Von hier oben aus hast Du eine erstaunliche "
    "Aussicht. Du kannst den kompletten Westen des Waldes ueberblicken und "
    "auch den Wachweg erkennen. Die Zinnen jedoch bilden nur einen "
    "maessigen Schutz gegen den Wind.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "himmel" }),
    "Jetzt, da Du soweit oben bist, scheint er etwas naeher zu sein. Waere "
    "jetzt Nacht, koenntest Du nach den Sternen greifen.");
    
  AddDetail( ({ "nacht" }),
    "Das Gegenteil von Tag.");
    
  AddDetail( ({ "tag" }),
    "Das Gegenteil von Nacht.");
    
  AddDetail( ({ "gegenteil" }),
    "Ein gutes Beispiel fuer ein Gegenteil waere Tag und Nacht.");
    
  AddDetail( ({ "beispiel" }),
    "Tag und Nacht ist ein gutes Beispiel fuer die Erklaerung von "
    "'Gegenteil'.");
    
  AddDetail( ({ "erklaerung" }),
    "Eine Erklaerung ist eine Definition.");
    
  AddDetail( ({ "definition", "definitionen" }),
    "Definitionen sind noetig, um Begriffe zu erklaeren.");
    
  AddDetail( ({ "begriffe", "begriff" }),
    "Begriffe wie Scriptfalle.");
    
  AddDetail( ({ "sterne", "stern" }),
    "Greif sie Dir!");
    
  AddDetail( ({ "depp" }),
    "Jemand lacht Dich aus.\n");
    
  AddDetail( ({ "jemand" }),
    "Hier groessenwahnsinnig zu werden, kann Dich ganz schnell das Leben "
    "kosten.");
    
  AddDetail( ({ "leben" }),
    "Ueberschaetze Dich nie.");
    
  AddDetail( ({ "boden" }),
    "Normaler Steinboden.");
    
  AddDetail( ({ "steinboden", "stein" }),
    "Normaler Boden.");
    
  AddDetail( ({ "wind" }),
    "Du bist hier fast 300 Meter ueber dem Erdboden, da ist der Wind schon "
    "etwas staerker.");
    
  AddDetail( ({ "meter" }),
    "Was soll das?");
    
  AddDetail( ({ "erdboden" }),
    "Naja, Waldboden trifft es wohl eher.");
    
  AddDetail( ({ "waldboden" }),
    "So nennt man den Untergrund im Wald.");
    
  AddDetail( ({ "untergrund" }),
    "Du hast zwar von hier aus eine gute Sicht, aber den Untergrund des "
    "Waldes erkennst Du nun wirklich nicht.");
    
  AddDetail( ({ "wald", "tethyrwald" }),
    "Vor Dir liegt der sagenumwobene Tethyrwald.");
    
  AddDetail( ({ "sagen", "sage" }),
    "In der Bibliothek wirst Du sicher einiges darueber finden.");
    
  AddDetail( ({ "bibliothek" }),
    "Du kannst doch lesen, oder?");
    
  AddDetail( ({ "sicht", "aussicht" }),
    "Waerst Du noch ein paar Meter hoeher, koenntest Du erkennen, was sich "
    "hinter dem Rand der Felswaende verbirgt.");
    
  AddDetail( ({ "felswaende" }),
    "Sie umgeben das ganze Tal.");
    
  AddDetail( ({ "tal" }),
    "Der Tethyrwald liegt in diesem grossen Tal. Avir liegt in der Mitte "
    "des Tales.");
    
  AddDetail( ({ "avir", "stadt" }),
    "Diese Stadt heisst Avir.");
    
  AddDetail( ({ "mitte" }),
    "Der Mittelpunkt des Tales.");
    
  AddDetail( ({ "mittelpunkt" }),
    "Hier laufen alle Strassen zusammen.");
    
  AddDetail( ({ "strassen", "strasse" }),
    "Alle Strassen fuehren nach Avir.");
    
  AddDetail( ({ "rand" }),
    "Wirst Du es jemals schaffen, ihn zu erklimmen? Es heisst, Niemand "
    "haette es bisher geschafft.");
    
  AddDetail( ({ "niemand", "niemanden" }),
    "Du siehst Niemanden auf dem Rand. Er winkt Dir.");

  AddDetail( ({ "ohren", "ohr" }),
    "Halte sie gut fest, sonst fliegen sie weg.");
    
  AddDetail( ({ "westen" }),
    "Wenn Du schon auf dem Westturm stehst, ist es doch nur logisch, dass "
    "Du auch den Westen des Tales einsehen kannst, oder?");

  AddDetail( ({ "wachweg" }),
    "Er liegt fast 100 Meter unter Dir. Erstaunlich, wie hoch die "
    "Stadtmauer und die Tuerme sind.");
    
  AddDetail( ({ "stadtmauer", "mauer" }),
    "Schwer zu uebersehen.");
    
  AddDetail( ({ "tuerme" }),
    "Gab es da nicht ein Buch, 'Die vier Tuerme'?");
    
  AddDetail( ({ "buch" }),
    "Nein, Du musst Dich taeuschen. Vier waren es nicht."); 
    
  AddDetail( ({ "vier" }),
    "Wieviel waren es nur?");
    
  AddDetail( ({ "2", "zwei", "zwo" }),
    "Ja genau! Wer hat das nur geschrieben?");
    
  AddDetail( ({ "tolkien", "john ronald reuel tolkien" }),
    "Du kennst diesen Namen? Ich bin begeistert.");
    
  AddDetail( ({ "namen", "name" }),
    "Unvergesslich fuer jeden Leser des Buches.");
    
  AddDetail( ({ "leser" }),
    "Lies es!");
  
  AddDetail( ({ "schutz" }),
    "Da sie nur einen halben bis einen Meter hoch sind, helfen sie nicht "
    "einmal einer Fee.");
    
  AddDetail( ({ "fee", "feen" }),
    "Viele Leute moegen Feen.");
    
  AddDetail( ({ "leute" }),
    "Das liegt an ihren schoenen, genialen, grossen... Fluegeln.");
    
  AddDetail( ({ "fluegel" }),
    "Sind das Beste an einer Fee. *hust*");
    
  AddDetail( ({ "beste" }),
    "Drows sagen das auch.");
    
  AddDetail( ({ "drows", "drow" }),
    "Naja, ueber Geschmack laesst sich bekanntlich streiten.");
    
  AddDetail( ({ "geschmack" }),
    "Ob man(n) die Fee nun essen oder vernaschen moechte, ist die eigene "
    "Entscheidung.");
    
  AddDetail( ({ "entscheidung" }),
    "Wer die Wahl hat, hat die Qual.");
    
  AddDetail( ({ "wahl", "qual" }),
    "Deswegen habe ich immer zwei.");
    
  AddDetail( ({ "zinnen", "turmzinnen", "zinne", "turmzinne" }),
    "Sie wurden aus massiven Felsbloecken errichtet.");
    
  AddDetail( ({ "felsbloecke", "felsblock", "bloecke", "block" }),
    "Sie bilden die Turmzinnen.");
    
  AddDetail( ({ "turm", "westturm" }),
    "Du stehst auf seiner Spitze.");
    
  AddDetail( ({ "spitze", "die", "turmspitze" }),
    "Das finden wir ... SPITZE!");
    
  AddExit( "unten", ROOM "e3-c3");

  AddSpecialDetail( ({ "scriptfalle" }),
    "scriptfalle");
  AddCmd( ({"greif", "greife"}), "sterne");
  
  AddItem( NPC "bogenschuetze" , REFRESH_DESTRUCT);
}
string scriptfalle()
{
	AddCmd( ({ "unt", "untersuche", "untersuche", "schau"}), "disco");
	return BS("achtung! dies ist eine scriptfalle: Du musst jetzt 'unsinn' "
		"untersuchen, sonst wird Deine verbindung getrennt!");
}
int disco(string str)
{
  if( str == "unsinn" )
  {
  	write("Delgo zwingt Dich zu: schlaf ein.\n");
  	write(BS("Dieser Befehl beendet Deine Verbindung mit dem Silberland. "
  	         "Du behaeltst Deine Sachen, aber Vorsicht: Wenn das Silberland "
  	         "abstuerzt, waehrend Du weg bist, verlierst Du sie doch, "
  	         "genauso, als wenn Du Deine Verbindung mit \"ende\" beendet "
  	         "haettest (allerdings bekommst Du dann eine finanzielle "
  	         "Entschaedigung). ABER: BENUTZUNG AUF EIGENE GEFAHR !!!"));
  	write("Closing down.\n");
  	return 1;
  }
  else
  {
  	write("Disconnectet by Delgo.\nClosing down.\n");
  	RemoveCmd( ({ "unt", "untersuche", "untersuch", "schau"}));
	  return 1;
	}
}

int sterne(string str)
{
	notify_fail("Was oder wonach willst Du greifen?\n");
	if ( str == "sterne"  || str == "nach sterne" ||
	     str == "sternen" || str == "nach sternen")
	{
		write("Es ist nicht Nacht! Depp.\n");
		return 1;
	}
	return 0;
}