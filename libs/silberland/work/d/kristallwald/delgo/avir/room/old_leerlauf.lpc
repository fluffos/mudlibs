
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "" );
  SetProp( P_INT_LONG,
    "Du gehst durch das Stadttor." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_HIDE_EXITS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
}
int markt()
{
	string datum;
	string dat;
	datum = dtime();
	dat = extract(datum,0,2);
	if( dat == "Sam" || dat == "Mit")
	{
		this_player()->move( ROOM "e1-d3-strasse_m", M_GO);
		return 1;
	}
	else
	{
		this_player()->move( ROOM "e1-d3-strasse", M_GO);
		return 1;
	}

}