
#include "../def.h"

inherit ROOM "std_mauer";                       

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Der Ostturm" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Stadtmauer von Avir. Die Zinnen rechts und links von "
    "Dir begrenzen den Weg der Soeldner. Von hier oben hast Du eine gute "
    "Aussicht auf Tethyr und die Stadt. Du bleibst einen Moment stehen und "
    "laesst das alles auf Dich einwirken. Du kannst rauf in den Turm, "
    "runter in die Stadt oder weiter auf der Mauer entlanglaufen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "turm" }),
    "Du kannst ihn durch eine Treppe nach oben betreten.");
    
  AddDetail( ({ "treppe" }),
    "Sie wurde auch aus Stein gebaut. Nur keine Stufen da...");
    
  AddDetail( ({"stufen", "stufe"}), 
     "Das scheint eine Rampe zu sein.");
    
  AddDetail( ({"aussicht"}), 
     "Nach Osten: Nichts, gar nichts zu sehen.");
     
  AddDetail( ({"osten"}), 
     "An der Ostwand kannst Du eigentlich nichts Besonderes erkennen.");
     
  AddDetail( ({"besonderes"}), 
     "\n");
     
  AddDetail( ({"ostwand"}), 
     "Mh, warum auch immer: Der Untergrund der Rampe faellt Dir erst jetzt "
     "auf.");
    
  AddDetail( ({"rampe"}), 
     "Und was fuer eine...");
     
  AddDetail( ({"untergrund"}), 
     "Du siehst seltsame Abdruecke in Erdresten.");
    
  AddDetail( ({"erdreste", "reste"}), 
     "Irgendwer, der es eilig hatte, muss wohl recht schnell hier hoch "
     "gekommen sein.");
     
  AddDetail( ({"abdruecke", "abdruck"}), 
     "Wie Hufe...");
     
  AddDetail( ({"hufe", "huf"}), 
     "Was machen nur Pferde hier oben?");
     
  AddDetail( ({"pferde", "pferd"}), 
     "Du hast noch keine Erklaerung dafuer.");
     
  AddDetail( ({"erklaerung"}), 
     "Du hast keine im Inventar.");
     
  AddDetail( ({"inventar"}), 
     "'i'");
    
  AddExit( "westunten", ROOM "e1-f3-auf");
  AddExit( "norden", ROOM "e2-g2");
  AddExit( "sueden", ROOM "e2-g4");
  AddExit( "oben", ROOM "e3-g3");
  
  SetProp(P_HIDE_EXITS, ({"westen"}) ); 
  AddExit( "westen", ROOM "e1-f3-auf");
  
  AddItem( NPC "soeldner_m" 
          , REFRESH_DESTRUCT
          , ([ P_MNPC_AREA : ({  ROOM "e2"})])
          );
}
