
#include "../def.h"

inherit ROOM "std_mauer";  

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Die Stadtmauer" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Stadtmauer von Avir. Die Zinnen rechts und links von "
    "Dir begrenzen den Weg der Soeldner. Von hier oben hast Du eine gute "
    "Aussicht auf Tethyr und die Stadt. Du bleibst einen Moment stehen und "
    "laesst das alles auf Dich einwirken. Du bist im suedwestlichen Teil "
    "der Stadt." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"teil"}), 
     "Dolles Deil!");
     
  AddDetail( ({"deil"}), 
     "So eine Verteidigungsanlage haettest Du auch gerne in Deinem Garten!");
     
  AddDetail( ({"garten"}), 
     "Den Wald als meinen Garten zu bezeichnen ist evtl. etwas ... "
     "vermessen.");
     
  AddDetail( ({"verteidigungsanlage"}), 
     "Oder doch lieber den Binford-2005-Turbo-Grill?");
     
  AddDetail( ({"binford-2005-turbo-grill", "binford", "turbo", "grill"}), 
     "\"Das wuerde ich an Deiner Stelle nicht tun, Tim!\"");
     
  AddDetail( ({"stelle", "tim"}), 
     "Kennst Du denn gar nichts?");
     
  AddDetail( ({"aussicht"}), 
     "Du kannst den Suedwesten des Waldes einsehen.");
     
  AddDetail( ({"suedwesten"}), 
     "Eine seltsame Atmosphaere geht von dem Wald im Suedwesten aus.");
     
  AddDetail( ({"atmosphaere"}), 
     "Er wirkt irgendwie unheimlich, zwar nicht bedrohlich doch irgendetwas "
     "dort jagt Dir einen Schauer ueber den Ruecken.");
     
  AddDetail( ({"ruecken"}), 
     "Du kannst ihn nicht sehen, aber er ist noch da. Etwas Vertrauen "
     "bitte...");
     
  AddDetail( ({"vertrauen"}), 
     "Jemand lacht boese.");
     
  AddDetail( ({"schauer"}), 
     "Du spuerst schon hier, wie unheimlich es dort ist.");
     
  AddDetail( ({"irgendetwas", "geh"}), 
     "Natuerlich: Geh in einem raum und untersuch irgendetwas! Damit "
     "kriegst garantiert keine fp!");
     
  AddDetail( ({"raum", "fp"}), 
     "Was glaubst, warum ich das KLEIN geschrieben habe?");
     
  AddDetail( ({"klein"}), 
     "Zurueck zum Suedwesten: Was auch immer es ist, Du solltest Dich in "
     "Acht nehmen.");
     
  AddDetail( ({"acht", "8"}), 
     "8");
     
  AddExit( "osten", ROOM "e2-d5");
  AddExit( "norden", ROOM "e2-c4");

}
