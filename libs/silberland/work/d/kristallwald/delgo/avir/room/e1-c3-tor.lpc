#include "../def.h"

inherit "std/room";

#include <properties.h>


void create() 
{
	
  ::create();
	


  SetProp( P_INT_SHORT, "Das Stadttor" );
  SetProp( P_INT_LONG,
    "Die Haengebruecke hast Du hinter Dir gelassen und bist endlich an dem "
    "Tor angelangt. Von der Stadtmauer erkennst Du nicht viel, da sie fast "
    "buendig mit dem Rand des Plateaus abschliesst. Macht nix - Das Tor " 
    "ist beeindruckend genug. Durch das Tor kannst Du bereits das rege "
    "Treiben der Stadt wahrnehmen. Dafuer hat sich der Weg hier hoch doch "
    "gelohnt." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

 AddDetail( ({ "haengebruecke", "bruecke" }),
    "Da haengt sie! Die Seile verschwinden hinter kleinen Oeffnungen in das "
    "Innere der Mauer. Seltsam.");

  AddDetail( ({ "seil", "seile" }),
    "Sie sorgen dafuer, dass die Konstruktion haelt. Dazu muessen sie "
    "natuerlich sehr stabil sein.");
    
  AddDetail( ({ "konstruktion" }),
    "Wenn man bedenkt, dass die Bruecke Praktikanten entworfen haben, ist "
    "sie erstaunlich selten eingestuerzt.");
    
  AddDetail( ({ "praktikant", "praktikanten" }),
    "Weisst Du, wer sonst noch kostenlos arbeiten wuerde? (Schick mir die "
    "Adresse, Qualitaet ist mir egal :])");
    
  AddDetail( ({ "addresse" }),
    "Ich warte.");
    
  AddDetail( ({ "qualitaet" }),
    "...hat ihren Preis.");
    
  AddDetail( ({ "preis" }),
    "Tja! Nichts im Leben ist umsonst. Ausser der Tod - und der kostet das "
    "Leben.");
    
  AddDetail( ({ "leben", "tod" }),
    "Oft nah beieinander.");
    
  AddDetail( ({ "oeffnung", "oeffnungen" }),
    "Die Loecher sind gerade gross genug, damit die Seile durchpassen.");
    
  AddDetail( ({ "loecher", "loch" }),
    "Unterschiedlich grosse, meist kreisrunde Oeffnungen in einer Flaeche "
    "oder in einem Koerper.");
    
  AddDetail( ({ "flaeche" }),
    "Es gibt natuerlich keine Flaeche, nur Koerper.");
    
  AddDetail( ({ "koerper" }),
    "Also, wo die Loecher am Koerper sind, solltest Du in Biologie gelernt "
    "haben!");
    
  AddDetail( ({ "biologie" }),
    "Nein, ich bring Dir das nicht bei.");
    
  AddDetail( ({ "innere", "inneres" }),
    "Die Mauer wird zwar nicht hohl sein, aber wahrscheinlich fuehren die "
    "Seile hoch in den Turm. ");
    
 AddDetail( ({ "mauer", "stadtmauer" }),
    "Du staunst. Die Mauer ist nicht schlecht gearbeitet. Kein kaputter "
    "Stein, keine Unebenheit und saubere Fugen. Die Mauer ist so glatt, "
    "daran kann niemand hochklettern.");
    
  AddDetail( ({ "stein" }),
    "Muss eine Art Granit sein. Er scheint sehr hart und widerstandsfaehig "
    "zu sein.");
    
  AddDetail( ({ "art", "granit" }),
    "Ja, Granit.");
    
  AddDetail( ({ "unebenheit" }),
    "Wer von uns beiden hat den Raum geschrieben, mh? Wenn ich sage, hier "
    "ist keine Unebenheit, dann ist da keine!");
    
  AddDetail( ({ "raum" }),
    "Ich ich ich!");
    
  AddDetail( ({ "fugen" }),
    "Du pfeifst anerkennend. Du bist zwar kein Experte, aber hier waren "
    "wirklich Leute vom Fach am Werk. Jede ist perfekt.");
  
  AddDetail( ({ "fuge" }), //na ma schaun wer nicht nur mit der maus forscht
    "Na gut, Du kontrollierst nochmal alle, die Du sehen kannst, und "
    "tatsaechlich: Aus einer Fuge broeckelt etwas Moertel heraus.");  
  
  AddDetail( ({ "moertel" }),
    "Er ist wirklich relativ locker.");
    
  AddDetail( ({ "experte", "leute" }),
    "Die verstehen mehr von Mauern als Du.");
    
  AddDetail( ({ "fach" }),
    "Hab ich das tatsaechlich geschrieben?");
        
  AddDetail( ({ "werk" }),
    "Wirklich gut gelungen.");
    

    
 AddDetail( ({ "rand", "plateau" }),
    "Tatsaechlich steht die ganze Stadt auf diesem Plateau.");
    
  AddDetail( ({ "tor" }),
    "Momentan ist es geoeffnet, deswegen kannst Du die Gitterstaebe nur "
    "oben an der Decke sehen. Darueber erkennst Du eine Tafel.");
    
  AddDetail( ({ "tafel" }),
    "Endlich erfaehrst Du den Namen der Stadt:\n"
    "       _    __        __   _    ____\n"
    "      / \\   \\ \\      / /  | |  |  __ \\ \n"
    "     / ^ \\   \\ \\    / /   | |  | |_/ /  \n"
    "    / /_\\ \\   \\ \\  / /    | |  |   _/  \n"
    "   / _____ \\   \\ \\/ /     | |  | |\\ \\      \n"
    "  /_/     \\_\\   \\__/      |_|  |_| \\_\\         \n"
    );
    
  AddDetail( ({ "boden" }),
    "Da sind kleine Loecher im Boden. Vermutlich fallen da die Gitterstaebe "
    "rein, wenn das Tor geschlossen wird.");
    
  AddDetail( ({ "himmel" }),
    "Noch da.");
    
  AddDetail( ({ "gitterstab", "stab", "staebe", "gitterstaebe" }),
    "Gutes altes Eisen. So stabil, wie das aussieht, haben das Zwerge "
    "geschmiedet. Sie sind in die Wand eingelassen.");
  
  AddDetail( ({"wand","waende"}), 
    "Die Waende sehen normal aus.");
    
  AddDetail( ({ "eisen", "fe" }),
    "Fe.");
    
  AddDetail( ({ "zwerge", "zwerg" }),
    "Zwerge sind gute Schmiede.");
    
  AddDetail( ({ "schmiede", "schmied" }),
    "Zwerge zum Beispiel.");
    
  AddDetail( ({ "beispiel" }),
    "War nur eins.");
    
  AddDetail( ({ "decke" }),
    "Die Decke des Tores ist der Boden des Turms.");
    
  AddDetail( ({ "turm" }),
    "Du kannst von hier aus zu wenig davon erkennen. Aber eins steht fest: "
    "Er ist hoch.");
    
 AddDetail( ({ "weg" }),
    "Der Weg war wirklich recht beschwerlich. Du wirst ja auch nicht grade "
    "juenger.");
    
  AddDetail( ({ "stadt", "treiben", "avir" }),
    "Herrlich, diese Atmosphaere. Nichts wie rein!");
    
    
  AddDetail( ({ "atmosphaere" }),
    "Nicht forschen, rein gehen.");
    
  AddDetail( ({ "wildschweinbraten", "braten" }),
    "Ich bin nicht dick, nur dick angezogen.");

  AddSound( DEFAULT_SOUND,
    "Ganz typisch fuer eine Stadt wie diese. Du hoerst die Marktschreier "
    "und den ganzen Trubel.");

  AddSound( ({ "marktschreier" }),
    "Melonen! Frische und saftige Melonen ... Mein Herr...");
    
  AddSound( ({ "trubel" }),
    "Los, stuerz Dich rein!");
    
  AddSound( ({"geraeusche", "geraeusch", "lachen", "kinder", "menschen", 
    "treiben"}), 
    "Es sind zu viele Geraeusche.");

  AddSmell( DEFAULT_SMELL,
    "Du riechst schon das Essen aus einer Kneipe.");

  AddSmell( ({ "essen" }),
    "Mmmhhhh. Dein Magenknurren reisst Dich aus Deinen Gedanken.");
  
  AddSmell( ({"wildschweinbraten", "braten"}),
    "Lecker!");
  
  AddDetail( ({"das", "duft", "gedanken", "herr", "kinder", "kneipe", 
    	"lachen", "magenknurren", "melonen", "menschen", "namen", "nase", 
    	"schick", "strasse"}), "Du hast vergessen was Du tun wolltest.");

  AddRoomMessage( 
    ({"Ein lautes Lachen ist in der Stadt zu vernehmen.\n",
    "Der Duft von Wildschweinbraten steigt Dir in die Nase.\n",
    "Du hoerst, wie ein paar Kinder froehlich lachen.\n",
    "Du kannst es kaum erwarten die Stadt zu betreten.\n",
    BS("Auf der Strasse im Osten draengen sich viele Menschen. Was es da "
    "wohl zu sehen gibt?"),
    "Das bunte Treiben im Osten macht Dich ganz kribbelig.\n",
    }),
    32);

  AddExit( "westen", ROOM "e1-b3-haengebruecke" );
  
  AddReadDetail( ({ "tafel" }),
    "Endlich erfaehrst Du den Namen der Stadt:\n"
    "       _    __        __    _    ____\n"
    "      / \\   \\ \\      / /   | |  |  __ \\ \n"
    "     / ^ \\   \\ \\    / /    | |  | |_/ /  \n"
    "    / /_\\ \\   \\ \\  / /     | |  |   _/  \n"
    "   / _____ \\   \\ \\/ /      | |  | |\\ \\      \n"
    "  /_/     \\_\\   \\__/       |_|  |_| \\_\\         \n"
    );
  
  AddCmd( ({ "kratz", "kratze" }),
    "moertel");
    
  NewDoor( ({"osten"}), "./e1-d3-strasse" , ({"\n_tor"}) ,
    ({D_FLAGS, DOOR_OPEN|DOOR_RESET_OP|DOOR_CLOSEKEY
     ,D_FUNC2, "markt" //testet ob Markttag oder nicht
     ,D_NAME, "Tor"
     ,D_SHORT, "Ein %ses Tor."
     ,D_LONG, "Durch das Tor kannst Du die Stadt betreten."
     ,D_GENDER, NEUTER
     ,D_MSGS,    ({"die Stadt"
                  ,"betritt"
                  ,"kommt herein" 
                  })
     ,D_OPENMSG, ({"Das Tor oeffnet sich.",
                   "Das Tor wird geoeffnet.",
                  " wird geoeffnet."})
     ,D_CLOSEMSG, ({"Das Tor schliesst sich.",
                    "Das Tor wird geschlosssen.",
                    " wird geschlossen."})
     ,D_RESET_OPENMSG, " wird geoeffnet."
     })
  );

}

int gate_cmd()
{
  if( DOOR_MASTER->QueryDoorStatus(ROOM"e1-d3-strasse") == 	D_STATUS_OPEN)
  {
  	DOOR_MASTER->SetDoorStatus(ROOM"e1-d3-strasse",	D_STATUS_CLOSED);
  	say(BS("Das Tor schliesst sich."));
  	write(BS("Das Tor schliesst sich."));
  	RemoveDetail( ({"tor"}) );
		AddDetail( ({ "tor" }),
    	"Die Gitterstaebe sind unten!");
  	call_other( ROOM "e1-d3-strasse", "close_gate", 1);
  	return 1;
  }
  if( DOOR_MASTER->QueryDoorStatus(ROOM"e1-d3-strasse") == 	D_STATUS_CLOSED)
  {
  	DOOR_MASTER->SetDoorStatus(ROOM"e1-d3-strasse",	D_STATUS_OPEN);
  	say(BS("Das Tor oeffnet sich."));
  	write(BS("Das Tor oeffnet sich."));
  	RemoveDetail( ({"tor"}));
  	AddDetail( ({ "tor" }),
      "Momentan ist es geoeffnet, deswegen kannst Du die Gitterstaebe nur "
      "oben an der Decke sehen. Darueber erkennst Du eine Tafel.");
  	call_other( ROOM "e1-d3-strasse", "open_gate", 1);
  	return 1;
  }
}

void close_gate()
{
	DOOR_MASTER->SetDoorStatus(ROOM"e1-d3-strasse",	D_STATUS_CLOSED);
	RemoveDetail( ({"tor"}) );
	AddDetail( ({ "tor" }),
         	   "Die Gitterstaebe sind unten!");
  call_other( ROOM"e1-d3-strasse", "close_gate", 0);
  return;
}

void reset()
{  
 	::reset();
 	RemoveDetail( ({ "spalte" }));
    
  RemoveCmd( ({ "greif", "greife" }),
    "spalte");
  RemoveDetail( ({"tor"}));
  AddDetail( ({ "tor" }),
 	"Momentan ist es geoeffnet, deswegen kannst Du die Gitterstaebe nur oben "
 	"an der Decke sehen. Darueber erkennst Du eine Tafel.");
 	call_other( ROOM "e1-d3-strasse", "open_gate", 1);

}

int moertel(string str )
{
  notify_fail( "Was willst Du wo rauskratzen?\n" );
  if( str == "moertel aus fuge" )
  {
    write(BS("Du kratzt und kratzt und immer mehr Moertel faellt heraus. Da "
    	"ist jetzt eine richtige Spalte."));
    say(BS( TPN+" macht irgendwas an der Mauer."));
  
    AddDetail( ({ "spalte" }),
    "Da hast Du ja was schoenes angerichtet!");
    
    AddCmd( ({ "greif", "greife" }),
    "spalte");
    
    return 1;
  }
  return 0;
}

int spalte(string str )
{
  notify_fail( "Wohin willst Du greifen?\n" );
  if( str == "in spalte" )
  {
    write(BS("Du kannst Dich ueberwinden und greifst in die Spalte. Als Du "
    	"irgendwas Schleimiges beruehrst springst Du erschrocken zureuck. "
    	"Was auch immer da drin ist, lass es da..."));
    say(BS( TPN+" springt erschrocken von der Mauer zurueck und schuettelt "
    	"sich."));
    return 1;
  }
  return 0;
}
