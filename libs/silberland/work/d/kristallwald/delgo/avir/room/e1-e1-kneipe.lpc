inherit "std/pub";

#include "../def.h"
#include <pub.h>


void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:24]));
  SetProp(P_INT_SHORT,"'Avirs Treff'");
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "maxim");
  SetProp(P_PUBKEEPER_NAME, "Maxim");
  SetProp(P_PUBMSG_NOKEEPER, "Wo zum Geier is Maxim? Du hast Durst!\n");
  SetProp(P_PUBMSG_NOENEMY, BS(
      "P_NOATTACK ;-)"));
  SetProp(P_PUBMSG_NOINVITE, BS(
      "P_NOATTACK ;-)"));
  SetProp(P_PUBMSG_FIGHTING, "BUG!\n");

  AddDrink("Bier", ({"bier"}), 
           199, 25, 6, 4,
           ({"Die Rothaarige bringt Dir einen Humpen Bier.\n",
             "&& trinkt einen Humpen Bier.\n"}));

  AddDrink("Whisky", ({"whisky"}), 
            219, 28, 10, 1,
           ({"Maxim nimmt sich die Zeit und bringt Dir ein Glas Whisky!\n",
             "&& trinkt genuesslich einen Whisky.\n"}));
  
  AddDrink("Avirs Bester!", ({"bester", "avirs bester"}), 
            599,50, 0, 9,
           ({"Eine blonde Bedienung bringt Dir den Saft!\n",
             "&& geniesst einen Becher Avirs Bester!\n"}));

  AddFood("Schnitzel Menue", ({"schnitzel", "schnitzel menue"}), 400, 55, 18, 
           ({BS("Man bringt Dir einen riesigen Teller mit 2 deftigen "
           	"Schnitzeln und leckeren Bratkartoffeln!\n"),
             "&& laesst sich ein Schnitzel munden.\n"}));
  AddFood("Das Kartoffel Menue", ({"kartoffeln", "kartoffel menue"}), 555, 		
  				75, 28, ({BS("Wahnsinn was man Dir da auftischt: Kartoffelsuppe, "
  				"Kartoffeln, Bratkartoffeln, Kroketten, Pommes, Kartoffel Salat "
  				"und zum Schluss: Kartoffeleis. MMMHHHJAM!\n"), "&& scheint viel "
  				"Geld zu haben, wenn er das Kartoffelmenue verschlingt.\n"}));
  
  AddDetail( ({ "boden" }),
     "Der ist noch unter Dir, und wenn Du Dich nicht taeuschst, ist es "
     "sogar ein Parkettboden.");
     
  AddDetail( ({ "parkettboden", "parkett" }),
     "Scheint sehr robust zu sein. Na, das muss er ja auch bei so vielen "
     "Gaesten.");
     
  AddDetail( ({ "gaeste" }),
     "Verdammt viel. Du fragst Dich warum, um diese Zeit so viele Leute da "
     "sind.");
     
  AddDetail( ({ "zeit" }),
     ""+dtime()+"");
     
  AddDetail( ({ "leute" }),
     "Alle moeglichen: Soeldner, Haendler, Arbeiter und und und ...");
     
  AddDetail( ({ "soeldner" }),
     "Was machen denn all die Soeldner hier in Avir? Am besten, Du "
     "erkundigst Dich mal beim Buergermeister danach.");
     
  AddDetail( ({ "buergermeister" }),
     "Der ist im Rathaus zu treffen.");
     
  AddDetail( ({ "rathaus" , "gebaeude"}),
     "Nicht zu uebersehen, ein grosses Gebaeude suedlich des Parks.");
     
  AddDetail( ({ "park" }),
     "Du muesstest ihn bereits durchquert haben. Schoen, oder?");
     
  AddDetail( ({ "haendler", "arbeiter" }),
     "Auch die brauchen Essen und Trinken!");
     
  AddDetail( ({ "essen" }),
     "Du brauchst keins? Ja sicher ... *taetschel*");
     
  AddDetail( ({ "trinken" }),
     "Du denkst. o O ( Ich bin schon verdammt lange nuechtern!)");
     
  AddDetail( ({ "waende", "wand" }),
     "Die kannst Du nicht mehr erkennen, denn die Massen haben Dich bereits "
     "verschluckt.");
     
  AddDetail( ({ "massen" }),
     "*SCHLUCK*");
     
  AddDetail( ({ "decke" }),
     "Es haengen zahlreiche Lampen an der Holzdecke.");
     
  AddDetail( ({ "holzdecke" }),
     "Wer haette es gedacht: Sie besteht aus Holz! Echtes Holz! Das muss "
     "Dein Glueckstag sein, sowas noch zu erleben.");
     
  AddDetail( ({ "holz" }),
     "Ein vollkommen wertloses Material. Oder kannst Du was damit "
     "anfangen?");
     
  AddDetail( ({ "Du" }),
     "Dachte ich mir *abwink*");

  AddDetail( ({ "material" }),
     "Vollkommen unnuetz!");
     
  AddDetail( ({ "glueckstag" }),
     "Mach Dir am besten ein Kreuz in Deinen Kalender!");
     
  AddDetail( ({ "kreuz" }),
     "Heute - [X]");
     
  AddDetail( ({ "kalender" }),
     "Ich bin mir sicher, Du hast schon einen aus diversen Magazinen.");
     
  AddDetail( ({ "magazine", "magazin" }),
     "\"Verschossen! -  Nachladen verdammt, ich brauche Munition!\"");
     
  AddDetail( ({ "munition" }),
     "Was war das fuer ein merkwuerdiger Traum?");
     
  AddDetail( ({ "traum" }),
     "Du schuettelst Dich.");
     
  AddDetail( ({ "saal" }),
     "Er ist gefuellt mit Menschen. Irgendwo unter ihnen sind noch Stuehle "
     "und Baenke zu finden.");
     
  AddDetail( ({ "menschen" }),
     "Erst beim zweiten Blick entdeckst Du, dass noch mehr Rassen vertreten "
     "sind.");
     
  AddDetail( ({ "rassen" }),
     "hilfe rassen");
     
  AddDetail( ({ "blick", "blicke" }),
     "Fein gemacht!");
     
  AddDetail( ({ "stuehle", "stuhl" }),
     "Muss ich wirklich sagen, unter was die begraben sind?");
     
  AddDetail( ({ "baenke" }),
     "Hahaha! Hast Du echt gedacht, es ist noch eine frei? Du Traeumer!");
     
  AddDetail( ({ "traeumer" }),
     "Eine freie Bank in Avirs Treff, also wirklich... *lachend*");
     
  AddDetail( ({ "bank" }),
     "Die naechste ist in Midas!");

  AddDetail( ({ "midas" }),
     "Oh, das ist ein langer Weg.");
     
  AddDetail( ({ "weg" }),
     "Irgendwo im Sueden, frag mal im Hafen nach.");  
     
  AddDetail( ({ "hafen" }),
     "Weit im Norden.");
     
  AddDetail( ({ "norden", "sueden", "himmelsrichtungen" }),
     "Norden und Sueden sind Himmelsrichtungen!");
     
  AddDetail( ({ "avir", "stadt" }),
     "Wie gefaellt Dir die Stadt?");
     
  AddDetail( ({ "treff" }),
     "Wirklich ein treffender Name! *Muhahahahaha*");
     
  AddDetail( ({ "name" }),
     "Nicht komisch? Na gut, lassen wir das *beleidigt*");
     
  AddDetail( ({ "grund" }),
     "Wo siehst Du hier bitte ein Gewaesser, das einen Grund haben koennte? "
     "Hae - also. Man man man.");
     
  AddDetail( ({ "gewaesser" }),
     "Jemand verpasst Dir eine schallende Ohrfeige.\n"
     "Jemand sagt: Werd ja nicht frech!");
  
  AddDetail( ({ "kneipe" }),
     "Ist das voll hier! In dem Saal befinden sich bestimmt 200 Menschen. "
     "Der Name 'Avirs Treff' hat seinen Grund, hier scheinen sich die halbe "
     "Bevoelkerung zum Essen und Trinken zu treffen. Als einzige Kneipe am "
     "Platz ist sie damit natuerlich immer gut besucht. Du versuchst Dich "
     "zur Theke durchzuschlagen.");
  
  AddDetail( ({ "bevoelkerung" }),
     "Alles, was in Avir lebt und arbeitet.");
     
  AddDetail( ({ "platz" }),
     "Ja, nicht platzen! Das gibt eine Sauerei ohne Ende!");
     
  AddDetail( ({ "ende" }),
     "Ist grade raus. Wieder verpasst. Mist!");
     
  AddDetail( ({ "mist" }),
     "Wie sagte einst ein grosser Mann?!: \"Scheisse!\"");
     
  AddDetail( ({ "mann" }),
     "Na so 2,10 Meter war er schon gross.");
     
  AddDetail( ({ "meter" }),
     "Was soll das?");
     
  AddDetail( ({ "scheisse" }),
     "Sowas schreibt man doch nicht!");
     
  AddDetail( ({ "sauerei" }),
     "Das muessen nur wieder die Kellnerinnen weg machen. Dabei koennten "
     "sie andere Sachen machen...");
     
  AddDetail( ({ "kellnerinnen", "kellnerin" }),
     "Maxim hat fuer einen Zwerg einen guten Geschmack.");
     
  AddDetail( ({ "zwerg" }),
     "Maxim zwergt Dich an.");
     
  AddDetail( ({ "geschmack" }),
     "Keine hat einen Bart!");
     
  AddDetail( ({ "bart" }),
     "*huepf*");
     
  AddDetail( ({ "sachen" }),
     "Dich bedien... also bin ich doch wieder drauf reingefallen! Altes "
     "Ferkelchen!");
     
  AddDetail( ({ "ferkelchen" }),
     "In Zukunft passiert mir das nicht wieder!");
     
  AddDetail( ({ "zukunft" }),
     "Bin gespannt, wie Du dort hinkommen willst!");
     
  AddDetail( ({ "theke" }),
     "Aus Holz gezimmert. Eine gute Arbeit!");
     
  AddDetail( ({ "arbeit" }),
     "Wirklich nicht schlecht!");
  
  AddSound( DEFAULT_SOUND,
    "Ein ganz typischer Kneipenlaerm.");

  AddSound( ({ "Kneipenlaerm", "laerm" }),
    "Auf Dich dringen Gespraechsfetzen, Stimmenwirrwarr und Bestellungen "
    "ein.");
  
  AddSound( ({"gespraechsfetzen", "stimmenwirrwarr", "bestellungen"}) ,
     "Du kannst Dich nicht darauf konzentrieren. Dafuer ist es einfach zu "
     "laut!");

  AddSmell( DEFAULT_SMELL,
    "Soviele Gerueche kannst Du nicht sortieren!");

  AddSmell( ({ "gerueche", "essen", "getraenke" }),
    "Du kannst gerade so Essen und Getraenke unterscheiden...");

  AddRoomMessage( 
    ({
    	"\"..das glaub ich nicht Tim!...\"\n",
    	"Bier her, Bier her oder ich fall um! *groehlend*\n",
    	"BEDIENUNG!\n",
    	BS("Eine Kellnerin stolpert aber kann sich und - wichtig - das "
    		"Whiskyglas noch abfangen!"),
    	BS("Du denkst . o O (Die Kellnerinnen haben ganz schoen kurze Roecke "
    		"(an))"),
    	"Du denkst . o O (...verdammt kurze Roecke)\n",
    	"Du denkst. o O (Das sind keine Roecke, das sind breite Guertel!)\n",
    	BS("Du denkst . o O (Die Roeck...) *RUMS* schon bist Du vom Stuhl "
    		"gefallen."),
    	BS("Ob die Roecke was mit dem Red Inn zu tun haben? Hey, pass auf Du "
    		"sabberst!"),
    	"Du hast Kohldampf! Iss was!\n",
    	"Deine Kehle ist recht trocken...\n",
    	BS("Mit den meisten Besuchern verhaelt es sich wie mit der Kneipe: "
    		"voll."),
    	"Wie die Kneipe, sind auch die Kellnerinnen gut ausgestattet!\n",
    	BS("Bevor Du Maxim getroffen hast, haettest Du nie gedacht, dass "
    		"Jemand an zwei Orten gleichzeitig sein kann..."),
    	"mhhh, das riecht koestlich...\n",
    	"*magenknurr*\n",
    	"Dein Magen sagt: Alkohol! Ich brauch Alk!\n",
    	"HarHarHar!\n",
    	"\"...und neulich, im Ferienlager...\"\n",
    	"\"... musst Du gesehen haben!..\"\n",
    	"Die Luft is relativ dick hier drinnen...\n",
    }),18);
  
 
  AddExit("sueden", ROOM "e1-e2-platz");
  
  AddDetail( ({"gedraenge","alk", "besuchern", "bier", "das", "die", 
  	"ferienlager", "guertel", "ich", "inn", "jemand", "kehle", "kellnerin", 
  	"kohldampf", "lampen", "luft", "magen", "maxim", "muhahahahaha", 
  	"nachladen", "o", "ohrfeige", "orten", "red", "roeck", "roecke", "rums", 
  	"schluck", "stuehel", "stuhl", "tim", "verschossen" , "wand" , 
  	"whiskyglas", "x"}), "Mehr kannst Du im Gedraenge nicht erkennen.");
  
  AddItem(NPC "maxim", REFRESH_DESTRUCT);
}

string _query_int_long()
{
  string txt;
  txt = "Ist das voll hier! In dem Saal befinden sich bestimmt 200 "
  "Menschen. Der Name 'Avirs Treff' hat seinen Grund, hier scheint sich die "
  "halbe Bevoelkerung zum Essen und Trinken zu treffen. Als einzige Kneipe "
  "am Platz ist sie damit natuerlich immer gut besucht. Du versuchst Dich "
  "zur Theke durchzuschlagen.";

 if(QueryProp(P_PUBKEEPER_ID))
  {
    if(!present(QueryProp(P_PUBKEEPER_ID)))
    {
      txt += " Wo ist die Bedienung? ";
    }
    else
    {
      txt +=  " Maxim und seine Kellnerinnen rennen umher, um die Leute zu "
      				"bedienen.";
    }
  }

  return BS(txt);
}
