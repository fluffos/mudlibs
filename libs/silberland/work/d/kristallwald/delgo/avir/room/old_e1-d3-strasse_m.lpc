
#include "../def.h"

inherit "std/room";

#include <properties.h>

int markt;

void create() 
{
  ::create();
  
  markt=0;
  
  call_out("trade_day", 0);

  AddExit( "osten", ROOM "e1-e3-park" );
  
	NewDoor( ({"westen"}), ROOM "e1-c3-tor" , ({"tor"}) ,
    ({D_FLAGS,DOOR_OPEN|DOOR_RESET_OP
     ,D_NAME, "Tor"
     ,D_GENDER, FEMALE
     ,D_SHORT, "Ein %ses Tor."
     ,D_LONG, "Durch das Tor kannst Du die Stadt verlassen."
     ,D_GENDER, NEUTER
     ,D_MSGS,    ({"die Stadt"
                  ,"verlaesst"
                  ,"kommt durch das Tor" 
                  })
     ,D_OPENMSG, ({"Das Tor oeffnet sich.",
                   "Das Tor wird geoeffnet.",
                  " wird geoeffnet."})
     ,D_CLOSEMSG, ({"Das Tor schliesst sich.",
                    "Das Tor wird geschlosssen.",
                    " wird geschlossen."})
     ,D_RESET_OPENMSG, " wird geoeffnet."
     })
  );
  
}

string _query_int_long()
{
  string txt;

  if(markt)
  {
    txt="Was fuer ein Gedraengel. Avir hat wirklich extrem viele Einwohner "
    "und "
    "da heute auch noch Markttag ist, kommen noch Besucher aus anderen "
    "Teilen des Silberlandes. Vor den Fassaden der schoenen Wohnhaeuser "
    "haben Haendler ihre Staende aufgebaut und jetzt draengen Dutzende "
    "Besucher durch die Strassen Avirs.\n"
    "Es gibt zwei sichtbare Ausgaenge: westen und osten.\n"
    "Ein Adliger.            Ein Kraeuterweib.\n"
    "Orin, der Naeher.       Ein Einwohner.\n"
    "Eine junge Frau.        Der Waffenhaendler.\n"
    "Eine alte Frau.         Ein Obststand.\n";
  }
  else
  {
    txt="Es ist relativ ruhig auf dieser Strasse. Die meisten Bewohner sind in "
      "ihren Haeusern und verhalten sich ruhig. Nur einige Passanten gehen "
      "spazieren und ab und an hoerst Du einen Hund bellen. Das Leben "
      "scheint sich mehr im Nordosten abzuspielen, dort hoerst Du jetzt viel "
      "deutlicher den Laerm der Stadt, den Du bereits vor dem Tor gehoert "
      "hast. Ansonsten gibt es bis auf die Wohnhaeuser hier nichts zu sehen. "
      "Nach Westen kannst Du die Stadt wieder verlassen und nach Osten geht's "
      "in den Park.";
  }

  return break_string(txt, 78, 0, 1);
}


int boerse(string str)
{
  notify_fail( "Auf was willst Du achten?\n" );
  if( str == "auf boerse" )
  {
    write(BS("Glaub mir, ist besser so! Guck: da rennt schon wieder jemand "
    "einem Gauner hinterher. Das haettest auch Du sein koenen!"));
    return 1;
  }
  return 1;
}
int deutlich(string str)
{
  notify_fail( "Wie willst Du sprechen?\n" );
  if( str == "deutlich")
  {
    write(BS("So ist es schon besser!"));
    return 1;
  }
  if( str == "deutlicher")
  {
    write(BS("So ist es schon besser!"));
    return 1;
  }
  return 0;
}

int kill(string str)
{
  //notify_fail( "Du wirst doch nicht die schoene Stimmung zerstoeren wollen oder?\n" );
  if( str == "delgo" )
  {
    write("Das merke ich mir, Freundchen!\n");
    return 1;
  }
  else
  {
  	write(BS("Du wirst doch nicht die schoene Stimmung zerstoeren wollen, "
  		"oder?"));
  }
  return 1;
}

int hund(string str)
{
  
  notify_fail("Was genau willst Du tun?");
  if(markt) return 0;
  if( str == "hund" )
  {
    write(BS("Er fliegt mindestens zwei Meter, ahh - das tat gut!"));
    return 1;
  }
  else
  {
  	write(BS("Wen willst Du treten?"));
  }
  return -1;
}

int close_gate()
{
	RemoveDetail( ({"tor"}));
  AddDetail( ({ "tor" }),
 	"Die Gitterstaebe sind unten!");
 	DOOR_MASTER->SetDoorStatus(ROOM "e1-c3-tor",	D_STATUS_CLOSED);
 	SetProp(P_INT_LONG, 
    "Was fuer ein Gedraengel. Avir hat wirklich extrem viele Einwohner "
    "und "
    "da heute auch noch Markttag ist, kommen noch Besucher aus anderen "
    "Teilen des Silberlandes. Vor den Fassaden der schoenen Wohnhaeuser "
    "haben Haendler ihre Staende aufgebaut und jetzt draengen Dutzende "
    "Besucher durch die Strassen Avirs.\n"
    "Es gibt einen sichtbaren Ausgang: osten.\n"
    "Ein Adliger.            Ein Kraeuterweib.\n"
    "Orin, der Naeher.       Ein Einwohner.\n"
    "Eine junge Frau.        Der Waffenhaendler.\n"
    "Eine alte Frau.         Ein Obststand.\n");
	return 1;
}

int open_gate()
{
	RemoveDetail( ({"tor"}));
  AddDetail( ({ "tor" }),
 	"Momentan ist es geoeffnet, deswegen kannst Du die Gitterstaebe nur oben "
 	"an der Decke sehen.");
 	DOOR_MASTER->SetDoorStatus(ROOM "e1-c3-tor",	D_STATUS_OPEN);
 	SetProp(P_INT_LONG, 
    "Was fuer ein Gedraengel. Avir hat wirklich extrem viele Einwohner "
    "und "
    "da heute auch noch Markttag ist, kommen noch Besucher aus anderen "
    "Teilen des Silberlandes. Vor den Fassaden der schoenen Wohnhaeuser "
    "haben Haendler ihre Staende aufgebaut und jetzt draengen Dutzende "
    "Besucher durch die Strassen Avirs.\n"
    "Es gibt zwei sichtbare Ausgaenge: westen und osten.\n"
    "Ein Adliger.            Ein Kraeuterweib.\n"
    "Orin, der Naeher.       Ein Einwohner.\n"
    "Eine junge Frau.        Der Waffenhaendler.\n"
    "Eine alte Frau.         Ein Obststand.\n");
	return 1;
}

int trade_day()
{
  string datum;
	string dat;
	
	//Markttag?
	datum = dtime();
	dat = extract(datum,0,2);
	if(dat == "Sam" || dat == "Mit")
	{
	  RemoveDetail(0);
	  RemoveCmd(0);
	  RemoveSmell(0);
	  RemoveSound(0);
	  //markteroeffnung
    SetProp( P_INT_SHORT, "Eine Strasse" );
    SetProp(P_INT_LONG, 
    "Was fuer ein Gedraengel. Avir hat wirklich extrem viele Einwohner "
    "und "
    "da heute auch noch Markttag ist, kommen noch Besucher aus anderen "
    "Teilen des Silberlandes. Vor den Fassaden der schoenen Wohnhaeuser "
    "haben Haendler ihre Staende aufgebaut und jetzt draengen Dutzende "
    "Besucher durch die Strassen Avirs.\n"
    "Es gibt zwei sichtbare Ausgaenge: westen und osten.\n"
    "Ein Adliger.            Ein Kraeuterweib.\n"
    "Orin, der Naeher.       Ein Einwohner.\n"
    "Eine junge Frau.        Der Waffenhaendler.\n"
    "Eine alte Frau.         Ein Obststand.\n");
    SetProp( P_LIGHT, 1 );
    SetProp( P_INDOORS, 0 );
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );
    SetProp(P_HIDE_EXITS, 1 ); 
    
    AddDetail( ({ "adliger" }),
      "Der Elf mit silberner Haarpracht ist Dir sofort aufgefallen, geht er "
      "doch wesentlich langsamer vor als die meisten. Warum soll er auch nach "
      "Sonderangeboten hetzen - er hat Zeit und Geld.\n"
      "Er ist absolut fit.\n"
      "Er traegt bei sich:\n"
      "Eine Seidenjacke (getragen).\n"
      "Eine Seidenhose (getragen).\n"
      "Ein Umhang (umgehaengt).\n");
    
    AddDetail( ({ "orin", "naeher" }),
      "Der relativ dicke Mann mittleren Alters bietet hier viele Stoffe zum "
      "Kauf an. Fuer wesentlich mehr Geld wuerde er Dir auch Kleidungsstuecke "
      "naehen, aber was ein echter Held ist, braucht mehr Ruestungen, und "
      "damit kann er leider nicht dienen.\n"
      "Er ist absolut fit.\n"
      "Er traegt bei sich:\n"
      "Ein Hemd (getragen).\n"
      "Eine Hose (getragen).\n"
      );
    
    AddDetail( ({ "junge frau", "tochter" }),
      "Die junge Einwohnerin Avirs schlendert gemuetlich mit einem Korb durch "
      "die Strasse. Was auch immer sie sucht, sie laesst sich dabei Zeit. Die "
      "aeltere Frau daneben scheint ihre Mutter zu sein.\n"
      "Sie ist absolut fit.\n"
      "Sie traegt bei sich:\n"
      "Eine Bluse (getragen).\n"
      "Ein Rock (getragen).\n"
      );
    
    AddDetail( ({ "alte frau", "mutter" }),
      "Die alte Frau schaut muerrisch in die Gegend. Scheinbar ist sie von "
      "dem Gedraenge nicht so angetan wie ihre Tochter. Mit einem Korb in der "
      "Hand geht sie von einem Stand zum naechsten. "
      "Sie ist absolut fit.\n"
      "Sie traegt bei sich:\n"
      "Ein altes Kleid (getragen).\n"
      "Einen Korb.\n"
      );
   
    AddDetail( ({ "kraeuterweib" , "weib"}),
      "Von den vielen Gruenzeugs, das die alte Frau anbietet, erkennst Du "
      "grade mal das... *gruebel*. Nein, Du hast Dich getaeuscht. Du erkennst "
      "nichts davon. Als Du die Frau danach fragst, erklaert sie Dir zwar "
      "alles, leider in einer anderen Sprache. Deswegen ist der Stand hier so "
      "leer.\n"
      "Sie ist absolut fit.\n"
      "Sie traegt bei sich:\n"
      "Eine Hose (getragen).\n"
      "Eine Bluse (getragen).\n"
      );    
    
    
    AddDetail( ({ "waffenhaendler" }),
      "Was der junge Hobbit als 'Waffen' darbietet, entpuppt sich als "
      "Kuechenwerkzeuge. Ganz toll. Mit einem Seufzer wendest Du Dich wieder "
      "ab und schaust aus sicherer Entfernung zu, wie der Hobbit sein Zeug "
      "unter die Leute bringt.\n"
      "Er ist absolut fit.\n"
      "Er traegt bei sich:\n"
      "Eine Hose (getragen).\n"
      );
    
    AddDetail( ({ "obststand" }),
      "Naja, sehr exotisch ist das Angebot nicht, Aepfel und Birnen sind "
      "wahrlich nicht so selten."
      );
    
    AddDetail( ({ "frau" }),
      "Welche denn?");
    
    AddDetail( ({ "aepfel", "birnen", "apfel", "birne" }),
      "Scheinbar habe ich mich getaeuscht, wenn Du nicht mal das kennst.");
    
    AddDetail( ({ "gedraengel" }),
      "Wie wuerdest Du ca. 60 Leute auf einer Strasse umschreiben?");
    
    AddDetail( ({ "leute", "einwohner","dutzende" }),
      "Am Markttag ist hier immer viel los. Da sind die Strassen gerammelt "
      "voll. Was fuer eine Atmosphaere.");
    
    AddDetail( ({ "strassen", "strasse" }),
      "Avir hat keine Markthalle, deswegen muessen die Haendler ihre Staende "
      "hier aufbauen.");
    
    AddDetail( ({ "atmosphaere" }),
      "Du wuerdest am liebsten sofort etwas kaufen. Aber Du bemerkst schnell, "
      "dass hier nur alltaegliche Dinge verkauft werden.");
    
    AddDetail( ({ "dinge", "ding" }),
      "Schau Dich nur um!");
    
    AddDetail( ({ "markttag" }),
      "Zweimal in der Woche ist es in Avir soweit, dann stroemen Besucher und "
      "Haendler aus allen Teilen des Silberlandes in die Stadt. Das ist "
      "Samstag und Mittwoch.");
    
    AddDetail( ({ "woche", "samstag", "mittwoch" }),
      "Da ist Markttag.");
    
    AddDetail( ({ "besucher" }),
      "Sie kommen von ueberall her, um den Markttag zu erleben.");
    
    AddDetail( ({ "teile", "teil" }),
      "Du bist doch auch hier.");
  
    AddDetail( ({"tor"}), "Momentan ist es geoeffnet, deswegen kannst Du die "
  	  "Gitterstaebe nur oben an der Decke sehen.\n");
    
    AddDetail( ({ "silberland" }),
      "Wenn Du das nicht kennst, frage ich mich, wie Du es hierher geschafft "
      "hast.");
    
    AddDetail( ({ "avir" }),
      "Avir ist wirklich eine schoene und atemberaubende Stadt. Wenn Du Dich "
      "weiter umschaust, wirst Du schnell bemerken, warum.");
    
    AddDetail( ({ "stadt" }),
      "Avir.");
    
    AddDetail( ({ "markthalle" }),
      "Leider wurde damals keine mitgebaut, ansonsten koennten die Haendler "
      "dort rein.");   
    
    AddDetail( ({ "haendler" }),
      "Sie verkaufen nur alltaegliche Dinge. Nichts, was Du wirklich "
      "gebrauchen kannst. Wenn Du einen guten Laden suchst, schau Dich im "
      "Norden der Stadt um.");
    
    AddDetail( ({ "laden" }),
      "Es soll einer im Norden sein.");
    
    AddDetail( ({ "norden" }),
      "Du kannst durch die Haeuser schauen? *staun*");
       
    AddDetail( ({ "staende", "stand" }),
      "Einge sind so ueberlaufen, dass Du sie kaum erreichst.");
    
    AddDetail( ({ "diebe", "dieb" }),
      "Sind noch alle Muenzen da?");
    
    AddDetail( ({ "muenzen", "muenze" }),
      "Achte trotzdem besser auf Deine Boerse.");
    
    AddDetail( ({ "boerse" }),
      "Musst es nicht gleich uebertreiben.");
    
    AddDetail( ({ "haeuser", "fassaden" }),
      "Du kannst Dich nicht auf sie konzentrieren, dafuer ist hier zu viel "
      "los.");
      
    AddDetail( ({"gedraenge", "altes", "angebot", "ausgaenge", "beste", 
  	  "blonde", "bluse", "boden", "dafuer", "die", "dukaten", "einwohnerin", 
  	  "elf", "ellenbogen", "entfernung", "fuss", "gedraenge", "gegend", "geld", 
  	  "geldbeutel", "gruenzeugs", "ha", "haarpracht", "hand", "haueser", 
  	  "held", "hemd", "hey", "himmel", "hobbit", "hose", "huelf", "ich", 
  	  "ichhabsdicke", "inn", "jacke", "jemand", "kinder", "kleid", "kleider", 
  	  "kleidungsstuecke", "kopf", "korb", "kuechenwerkzeuge", "lord","maenner", 
  	  "mann", "massen", "mutter", "namen", "nieren", "nur", "red", "rock", 
  	  "ruestungen", "schritte", "seidenhose", "seidenjacke", "seufzer", "sire", 
  	  "sonderangeboten", "sprache", "stand", "starrst", "stoffe", "suesser", 
  	  "tat", "tochter", "umhang", "verdammt", "verzeiht", "vollidiot", 
  	  "waffen", "was", "wohnhaeuser", "wort", "zeit", "zeug",
  	  "gitterstaebe", "staebe", "gitterstab", "stab",
  	  "alters", "euch", "eure", "haende", "ihr", "kauf", "sie" }), 
  	  "Mehr kannst Du in dem Gedraenge wahrlich nicht erkennen!");
    
    AddSound( DEFAULT_SOUND,
      "Du kannst Dein eigenes Wort kaum verstehen, so laut geht es hier zu. "
      "Stimmengewirr, Gespraechsfetzen und das Klimpern von Muenzen sind am "
      "meisten zu hoeren.");

    AddSound( ({ "stimmengewirr", "stimmen", "gewirr", "stimme" }),
      "Da war eine!");
    
    AddSound( ({ "gespraechsfetzen" }),
      "*murmelmurmel* *grummel* toeten *fluester*\n" 
      "Du wirst kreidebleich, doch dann grinsen Dich die beiden an und weisen "
      "Dich 'freundlich' darauf hin, sie doch nicht zu belauschen.\n"
      "Mit hochrotem Kopf machst Du ein paar Schritte zurueck. Sowas macht "
      "man aber auch nicht!" );
    
    AddSound( ({ "klimpern", "muenzen" }),
      "Als Du Dich darauf konzentrierst, stellst Du fest, dass es in der Tat "
      "recht oft zu hoeren ist. Dann faellt Dir ein, dass das einige Diebe "
      "anlocken koennte.");

    AddSmell( DEFAULT_SMELL,
      "Es stroemen so viele Duefte auf Dich ein, das Du gar nicht alle "
      "erkennst.");

    AddSmell( ({ "duefte" }),
      "Aber die meissten riechen wirklich gut. Mhhhh.");
        
    AddRoomMessage(  //das pure Leben! 
      ({
      "Eine (leider sehr schwere) Frau tritt Dir auf den Fuss.\n",
      "Ein paar froehlich lachende Kinder springen umher.\n",
      "Die kleine Blonde da drueben hat Dir gerade zugezwinkert.\n",
      BS("\"Die feinsten Kleider! Nur hier bei mir... kommen Sie... "
    	  "Preise...\""),
      "\"*kicher*..., ach das hast Du auch gehoert?\"\n",
      BS("\"Verdammt! Wenn ich sage 10 Dukaten, meine ich 10 Dukaten und wenn "
    	  "ihr noch einmal...hey... STEHENBLEIBEN! WACHE!\""),
      "Irgendwer massiert unabsichtlich Deine Nieren mit seinem Ellenbogen.\n",
      "Ein Gedraenge!... Herrlich! \n",
      "Du wirst von den ganzen Massen hin und her geschubst.\n",
      BS("\"...Melonen, sag ich euch, HA! Davon haetten auch Maenner gerne "
      "zwei!\""),
      BS("\"Verzeiht Sire, Ich glaube, Eure Hand hat sich soeben... nein, das "
    	  "ist mein Geldbeutel!\nZU HUELF!\""),
      BS("\"Hey Suesser, kennst Du schon das Red Inn? Wir koennen Dich "
    	"bestimmt verwoehnen ...\""),
      "\".. bin mir ganz sicher, dass das meine Jacke ist!\"\n",
      "Du willst nicht wissen, in was Du gerade getreten bist!\n",
      "\"Starrst Du etwa mich an? Hae? Hey Vollidiot - Ich rede mit Dir!\"\n",
      BS("Wenn Du nicht auf einmal drei Haende bekommen hast, muss es wohl "
    	  "eine fremde sein, die in deine Boerse greift... "),
      "\"Was habt ihr denn gedacht?\"\n",
      BS("\"Nur das Beste fuer Euch, Lord Ichhabsdicke, wollt Ihr nicht "
    	  "einmal...\""),
      "\"Dafuer stehe ich mit meinem Namen!\"\n",
      }),
      21);
  
    AddCmd( ({ "achte" }),
      "boerse");
    AddCmd( ({ "toete" }) , "kill");

    if(markt != 1) 
    {
      TO->Message(BS("Es ist Markttag! Auf einmal werden ueberall Staende "
	                   "aufgebaut und bevor Du Dich versiehst, stehst Du mitten "
	                   "im Getuemmel."), MSGFLAG_VISUAL);
	  }    
	  markt=1;
	}
  else
	{
	  RemoveDetail(0);
	  RemoveCmd(0);
	  RemoveSmell(0);
	  RemoveSound(0);
	  //marktschliessung
	    
    SetProp( P_INT_SHORT, "Eine Strasse" );
    SetProp( P_INT_LONG,
      "Es ist relativ ruhig auf dieser Strasse. Die meisten Bewohner sind in "
      "ihren Haeusern und verhalten sich ruhig. Nur einige Passanten gehen "
      "spazieren und ab und an hoerst Du einen Hund bellen. Das Leben "
      "scheint sich mehr im Nordosten abzuspielen, dort hoerst Du jetzt viel "
      "deutlicher den Laerm der Stadt, den Du bereits vor dem Tor gehoert "
      "hast. Ansonsten gibt es bis auf die Wohnhaeuser hier nichts zu sehen. "
      "Nach Westen kannst Du die Stadt wieder verlassen und nach Osten geht's "
      "in den Park."
      );
    SetProp( P_LIGHT, 1 );
    SetProp( P_INDOORS, 0 );
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );
    SetProp(P_HIDE_EXITS, 0 ); 

    AddDetail( ({ "strasse" }),
      "Die Strasse ist zur Zeit eher ruhig. Aber wenn es Markttag wird, geht "
      "der Trubel richtig los.");
    
    AddDetail( ({ "zeit" }),
      "Es ist "+dtime()+".");
    
    AddDetail( ({ "markttag", "markt" }),
      "Zwo Mal in der Woche geht es hier hoch her.");
    
    AddDetail( ({ "woche" }),
      "Besteht aus sieben Tagen.");
    
    AddDetail( ({ "tage", "tag", "stunden", "stunde" }),
      "24 stunden sind ein Tag.");
    
    AddDetail( ({ "trubel" }),
      "Du wirst es schon erleben.");
      
    AddDetail( ({ "bewohner" }),
      "Wer heute seine Einkaeufe machen will, hat leider Pech, der Markt ist "
      "zur Zeit nicht da.");
    
    AddDetail( ({ "einkauf", "einkaeufe" }),
      "Na, was man zum Leben braucht: Essen, Getraenke, Kleidung und so "
      "weiter.");
    
    AddDetail( ({ "essen" }),
      "Da faellt mir ein, ich habe Hunger...");
    
    AddDetail( ({ "getraenke" }),
      "Da faellt mir ein, ich habe Durst...");
    
    AddDetail( ({ "hunger" }),
      "Nicht so schlimm wie Durst!");
    
    AddDetail( ({ "durst" }),
      "Nicht so schlimm wie Hunger.");
    
    AddDetail( ({ "kleidung" }),
      "Sag bloss, Du hast keine? Hau ja ab, Du Perversling!");
    
    AddDetail( ({ "perversling" }),
      "Wie wuerdest Du es nennen, wenn jemand nackt in Deine Stadt kommt?");
  
    AddDetail( ({ "stadt", "avir" }),
      "Avir ist wirklich eine tolle Stadt.");
    
    AddDetail( ({ "pech" }),
      "Deins, nicht meins!");
    
    AddDetail( ({ "haeusern", "wohnhaeusern" }),
      "Sei nicht so faul, tipp mal wieder!");
    
    AddDetail( ({ "haeuser", "wohnhaeuser" }),
      "Wirklich schoene restaurierte Fachwerkbauten.");
    
    AddDetail( ({ "fachwerkbauten" }),
      "Zwischen den weissen Fassaden tauchen immer wieder gut erhaltene "
      "Holzbalken auf. Jedes Haus in der Stadt ist so gut erhalten. Wahrlich, "
      "Avir ist eine der schoensten Menschenstaedte, die Du je erblickt "
      "hast!");
    
    AddDetail( ({ "wohnhaus", "haus" }),
      "In ihnen leben die Bewohner von Avir.");
    
    AddDetail( ({ "menschenstaedte", "staedte" }),
      "Midas, Kyranda, Tijara - um nur ein paar Beispiele zu nennen.");
    
    AddDetail( ({ "beispiele" }),
      "Aeh.. *gruebel* Fussball ist ein Ballspiel, aber... ach, Beispiele! "
      "Sprich bitte deutlicher.");
      
    AddDetail( ({ "fussball" }),
      "Sinnlos und primitiv.");
    
    AddDetail( ({ "ballspiel" }),
      "Volleyball ist viel besser als Fussball!");
    
    AddDetail( ({ "volleyball" }),
      "Ja, dafuer muss man seinen Koerper im Griff haben!");
    
    AddDetail( ({ "koerper" }),
      "Jemand betrachtet Dich und bricht in schallendes Gelaechter aus.");
    
    AddDetail( ({ "gelaechter" }),
      "HAHA!");
    
    AddDetail( ({ "griff" }),
      "Was Du nur wieder denkst, Dein EIGENER Koerper!");
    
    AddDetail( ({ "midas", "kyranda", "tijara" }),
      "Sicher beeindruckende Staedte, aber so etwas wie Avir hast Du noch "
