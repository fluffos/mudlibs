    AddRoomMessage( 
      ({
    	  "Jemand bereitet grade eine Mahlzeit zu, es riecht koestlich.\n",
    	  "Voellig unerwartet fliegt eine Pfanne aus einem der Fenster.\n",
    	  "Da scheint sich ein Ehepaar zu streiten, es geht laut daher.\n",
    	  BS("Diesmal konnte der Mann wohl nicht mehr ausweichen, Du hoerst ein "
    	  "Klirren, einen triumphierenden Aufschrei sowie einen "
    	  "Schmerzensschrei. Armer Kerl."),
    	  "Der Hund rennt wie verrueckt hin und her...\n",
    	  BS("*RUMMS* Ist das bloede Vieh doch tatsaechlich gegen eine Mauer "
    	  "gerannt."),
      }),
      35);
  
   AddCmd( ({"sprich"}), "deutlich");
   AddCmd( ({ "trete", "tritt" }), "hund");

	 if(markt)
	 {
	  TO->Message(BS("Der Markttag ist beendet und so schnell die Staende "
	                 "aufgebaut waren, so schnell sind sie auch wieder "
	                 "verschwunden."), MSGFLAG_VISUAL);
	 }	
	 markt=0;
	}
  
}

void reset()
{
  
  //Markttag?
  remove_call_out("trade_day");
	while (remove_call_out("trade_day") != -1);
  call_out("trade_day", 0);
  
  //Tuer und Tor
  RemoveDetail( ({"tor"}));
  AddDetail( ({ "tor" }),
 	"Momentan ist es geoeffnet, deswegen kannst Du die Gitterstaebe nur oben "
 	"an der Decke sehen.");
 	DOOR_MASTER->SetDoorStatus(ROOM "e1-c3-tor",	D_STATUS_OPEN);
 	SetProp(P_INT_LONG, 
    "Was fuer ein Gedraengel. Avir hat wirklich extrem viele Einwohner "
    "und "
    "da heute auch noch Markttag ist, kommen noch Besucher aus anderen "
    "Teilen des Silberlandes. Vor den Fassaden der schoenen Wohnhaeuser "
    "haben Haendler ihre Staende aufgebaut und jetzt draengen Dutzende "
    "Besucher durch die Strassen Avirs.\n"
    "Es gibt zwei sichtbare Ausgaenge: westen und osten.\n"
    "Ein Adliger.            Ein Kraeuterweib.\n"
    "Orin, der Naeher.       Ein Einwohner.\n"
    "Eine junge Frau.        Der Waffenhaendler.\n"
    "Eine alte Frau.         Ein Obststand.\n");
 	
 	::reset();
 	return;
}

