
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Bruecke in den Wolken" );
  SetProp( P_INT_LONG,
    "Du stehst auf einer Bruecke. Waeren um Dich herum nicht irgendwelche "
    "Wolken und wuerdest Du nicht genau wissen, dass weit unter Dir eine "
    "Stadt liegt, waere das auch ganz normal. Die Bruecke steigt hier "
    "weiter an und fuehrt Dich immer hoeher und hoeher."
    );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "himmel" }),
    "Den kannst Du im Moment sehr gut erkennen.");
    
  AddDetail( ({ "moment" }),
    "Fast 400 Meter Hoehe wuerde ich schon als guten Moment bezeichnen, um "
    "den Himmel zu betrachten.");
    
  AddDetail( ({ "meter" }),
    "Ein Meter ist soooo lang.");
    
  AddDetail( ({ "hoehe" }),
    "Ich hoffe instaendigst, Du bist schwindelfrei?");
    
  AddDetail( ({ "boden" }),
    "Er gleicht dem einer normalen Bruecke.");
    
  AddDetail( ({ "bruecke" }),
    "So nennt man dieses Gebilde.");
    
  AddDetail( ({ "gebilde" }),
    "Du stehst darauf.");
    
  AddDetail( ({ "wolken", "wolke" }),
    "Es ist ein herrlicher Anblick.");
    
  AddDetail( ({ "anblick" }),
    "Ein paar Meter unter Dir hat sich eine dichte Wolkendecke gebildet, "
    "die durch die tiefstehende Sonne in ein helles Rot getaucht wird.");
    
  AddDetail( ({ "wolkendecke" }),
    "Du kannst kaum durch sie hindurchsehen, so dicht sind die Wolken "
    "aneinander gereiht.");
    
  AddDetail( ({ "sonne" }),
    "Wenn Du nach Westen schaust, kannst Du sie gar nicht verfehlen.");
    
  AddDetail( ({ "westen" }),
    "Gross und hell setzt die Sonne gerade auf dem Rand der Felswand auf "
    "und faerbt sich langsam in ein helles Rot.");
    
  AddDetail( ({ "rand" }),
    "Sie wird wohl gerade untergehen, deswegen auch die Faerbung.");
    
  AddDetail( ({ "faerbung" }),
    "Warum sie auf einmal Rot wird, ist ein recht interessanter Vorgang.");
    
  AddDetail( ({ "vorgang" }),
    "Es hat was mit der Neigung der .. Oehmmm. So ein Bloedsinn!");
    
  AddDetail( ({ "neigung" }),
    "Wie kommst Du nur auf diesen Bloedsinn?");
    
  AddDetail( ({ "bloedsinn" }),
    "Natuerlich ist einzig und allein Woody dafuer verantwortlich.");
    
  AddDetail( ({ "woody" }),
    "Er faerbt die Sonne rot. Damit soll man bemerken, wann sie untergeht.");
    
  AddDetail( ({ "felswand" }),
    "Weit im Westen.");
    
  AddDetail( ({ "rot" }),
    "Wirklich ein romantisches Bild.");
    
  AddDetail( ({ "bild" }),
    "Du auf einer Bruecke, welche aus einer roten Wolkendecke herausragt "
    "... *schmacht*");
    
  AddDetail( ({ "stadt" }),
    "Die Stadt Avir liegt unter Dir.");
    
  AddDetail( ({ "avir" }),
    "Dir wird langsam klar, welch architektonische Meisterleistung Avir in "
    "der Geschichte des Silberlandes darstellt.");
    
  AddDetail( ({ "meisterleistung" }),
    "Du kannst Dich jetzt nicht an eine andere Stadt erinnern, die "
    "aehnliche faszinierende Bauweisen aufzuweisen hat.");
    
  AddDetail( ({ "bauweisen", "bauweise" }),
    "Es sind ja auch gewagte Bauten: Sollten diese Bruecken und der Turm "
    "einstuerzen, waere die Stadt zerstoert.");
    
  AddDetail( ({ "bauten" }),
    "Man ging ein grosses Risiko ein, als man diese errichtete.");
    
  AddDetail( ({ "risiko" }),
    "Wenn ueberhaupt etwas ueberliefert wurde, so findest Du es in der "
    "Bibliothek.");
    
  AddDetail( ({ "bibliothek" }),
    "Da unten.");
    
  AddDetail( ({ "bruecken" }),
    "Es sind zwei, welche sich quer ueber die Stadt spannen.");
    
  AddDetail( ({ "turm" }),
    "Dort oben, im Osten kannst Du ihn bereits erahnen.");
    
  AddDetail( ({ "osten", "oben" }),
    "Geh hin!");
    
  AddDetail( ({ "geschichte" }),
    "Die Geschichte des Silberlandes ist wahrlich faszinierend und "
    "lehrreich. Sie wurde gepraegt von Goettern, DEM BOESEN, Helden und "
    "Koenigen.");
    
  AddDetail( ({ "goetter" }),
    "Sie erschufen das Silberland.");
    
  AddDetail( ({ "das boese", "boese", "dem boesen", "boesen" }),
    "Es bedroht das Silberland mit seinen dunklen Machenschaften.");
    
  AddDetail( ({ "machenschaften" }),
    "Allerdings unterscheidet sich Gut und Boese immer vom Standpunkt aus.");
    
  AddDetail( ({ "standpunkt" }),
    "Dieser kann durchaus gegenteilig sein.");
    
  AddDetail( ({ "gute" }),
    "Da das Gute immer das Boese vernichten will, kann man durchaus sagen, "
    "es ist boese (vom Boesen aus gesehen). Denn auch die boesen Kreaturen "
    "DES BOESEN werden durch das - damit boese - Gute bekaempft und "
    "vernichtet ... *KNIRSCH*");
    
  AddDetail( ({ "*knirsch*", "knirsch" }),
    "Jetzt habe ich mir die Zunge gebrochen!");
    
  AddDetail( ({ "zunge" }),
    "Ja, lach Du nur!");
    
  AddDetail( ({ "helden", "held" }),
    "Sie kaempfen fuer das Gute und sind durch Heldentaten beruehmt "
    "geworden.");
    
  AddDetail( ({ "heldentaten" }),
    "Sie machen einen Helden zum Helden.");
    
  AddDetail( ({ "koenige", "koenig" }),
    "Sie sind eher fuer die weltlichen Dinge zustaendig.");
    
  AddDetail( ({ "dinge", "beispiel" }),
    "Dienstmaedchen zum Beispiel.");
    
  AddDetail( ({ "dienstmaedchen" }),
    "Sie eben so richtig ordentlich und nach allen Regeln der Kunst "
    "beaufsichtigen.");
    
  AddDetail( ({ "regeln", "kunst" }),
    "*sabber*");
    
  AddDetail( ({"decke","pause", "dem", "des", "gut", "kreaturen", "waende", 
  	"wand"}), "Mach mal ne Pause!");

  AddDetail( ({ "silberland" }),
    "Es ist ueberall.");

  AddExit( "westunten", ROOM "e3-c3");
  AddExit( "ostoben", ROOM "e5");
  
  SetProp(P_HIDE_EXITS, ({"osten", "westen"}) );
  AddExit( "westen", ROOM "e3-c3");
  AddExit( "osten", ROOM "e5");
  
}