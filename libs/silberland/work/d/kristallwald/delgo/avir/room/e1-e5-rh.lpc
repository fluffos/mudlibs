
#include "../def.h"
#include <properties.h>
inherit "std/room";

#define P_SEERDOOR_DISCOVER "rw_sehertor_disc"

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Bibliothek" );
  SetProp( P_INT_LONG,
    "Du stehst in der gewaltigen Bibliothek von Avir. Dieser Raum fungiert "
