  AddDetail( ({ "wand" }),
    "Welche meinst Du?");
    
  AddDetail( ({ "einblick" }),
    "ACCESS DENIED!*blinkend*");
    
  AddDetail( ({ "fenster" }),
    "Die Sonne scheint durch die sauberen Scheiben.");    
    
  AddDetail( ({ "sonne" }),
    "Die ist draussen.");
    
  AddDetail( ({ "scheibe", "scheiben" }),
    "Sauber!");
    
  AddDetail( ({ "boden" }),
    "Ein schoener violetter Teppich schont den Boden.");
    
  AddDetail( ({ "teppich", "teppichmuster" }),
    "Keine Teppichmuster oder aehnliches, einfach nur violett.");
    
  AddDetail( ({ "avir", "stadt" }),
    "Diese Stadt heisst Avir.");
    
  AddDetail( ({ "arbeitsraum" }),
    "Eine Bibliothek bietet sich dafuer an.");
    
  AddDetail( ({ "bibliothek" }),
    "Der Buergermeister kann stolz darauf sein!");
    
  AddDetail( ({ "buergermeister" }),
    "Der arbeitet hier.");
    
  AddDetail( ({ "mitte" }),
    "Da steht die grosse Tafel.");
    
  AddDetail( ({ "tafel" }),
    "Hier koennen Besucher Buecher ungestoert lesen.");
    
  AddDetail( ({ "besucher" }),
     "Du gehoerst dazu!");
  
  AddDetail( ({ "schreibtisch" }),
    "Erstaunlich... leer! Viel hat der Buergermeister ja nicht zu tun!");    

  AddDetail( ({ "schubladen", "schublade" }),
    "Wag es nicht sie zu oeffnen! Sie gehoeren dem Buergermeister.");

  AddReadDetail( ({ "schild" }),   
  //Spaeter werden hier Kurzgeschichten von mir und anderen magier lesbar 
  //sein, ich hoffe dafuer Angrox' Buch nutzen zu duerfen.
    " ________________________________________________\n"  
  // Vorwiegen werden aber Hinweise ueber die waldlaeufer und fuer Mitglieder 
  //die Story erzaehlt
    "|                                                |\n"
    "|    Buecher fuer Besucher:                      |\n"
    "|    **********************                      |\n"
    "|                                                |\n"
    "|     1  Das Tal von Tethyr                      |\n"
    "|     2  Der Turm der Kuenste                    |\n"
    "|     3  Der Palast im Wald                      |\n"
    //"|     4  Die Bergfestung der alten Wacht         |\n"
    "|     5  Die Todesinsel                          |\n"
    //"|     6  Zwergenfeste, der Fluch das Tals        |\n"
    //"|     7  Der verseuchte Wald                     |\n"        
    "|                                                |\n"
    "|    Buecher ueber Waldlaeufer:                  |\n"
    "|    **************************                  |\n"
    "|                                                |\n"
    "|    11  Schlain der Jaeger                      |\n"
    "|    12  Ru'arion der Firnelf                    |\n"
    "|    13  Shin'nil die Dunkelelfe                 |\n"
    //"|    14                                          |\n"
    //"|    19  Die Rueckkehr der Waldlaeufer           |\n"                
    "|                                                |\n"
    "|    Geschichte der Waldlaeufer:                 |\n"
    "|    ***************************                 |\n"
    "|                                                |\n"
    "|    21  Buch 1 (Prolog, Kap. 1-3)               |\n"
    "|    22  Buch 2 (Kap. 4)                         |\n"
    "|    23  Buch 3 (Kap. 5-7)                       |\n"
    "|    24  Buch 4 (Kap. 8-9)                       |\n"
    "|    25  Buch 5 (Kap. 10-11)                     |\n"
    "|    26  Buch 6 (Kap. 12-13)                     |\n"
    "|    27  Buch 7 (Kap. 14-15)                     |\n"
    "|    28  Buch 8 (Kap. 16, Epilog)                |\n"
    "|                                                |\n"
    "|   ________________________________________     |\n"
    "|                                                |\n"
    "|   Syntax: 'buch <nr>'                          |\n"
    "|                                                |\n"
    "|   Leider muessen noch sehr viele Buecher       |\n"
    "|   aus dem Altavirischem uebersetzt werden      |\n"
    "|   und da ich diese Arbeiten alleine er-        |\n"
    "|   ledigen muss, kommen immer wieder            |\n"
    "|   einzelne Exemplare nach. Ich bitte dies      |\n"
    "|   zu dulden und entschuldigen.                 |\n"
    "|                                                |\n"
    "|       ogleD, Uebersetzer                       |\n"
    "|________________________________________________|\n"
    );

  AddSound( DEFAULT_SOUND,
    "Wie es sich gehoert: Nichts.");

  AddSound( ({ "nichts" }),
    "Reiz mich nicht :-)");

  AddSmell( DEFAULT_SMELL,
    "Staub, Buecher und Zeit...");

  AddSmell( ({ "staub" }),
    "Mach Du mal so einen grossen Raum regelmaessig sauber!");

  AddSmell( ({ "buecher", "buch" }),
    "Du atmest tief ein und geniesst den Duft von alten Buechern.");
    
  AddSmell( ({ "duft" }),
    "Umgeblaetterte Seiten...");
    
  AddSmell( ({ "seiten", "seite" }),
    "Ein herrlicher Raum!");
    
  AddSmell( ({ "zeit" }),
    "Viel Zeit, dieser Raum ist alt. Uralt.");
  
  AddRoomMessage( 
    ({
    	"Wie es sich fuer eine Bibliothek ziemt, ist hier nichts los!\n",
    	"Du wuerdest gerne in einigen Buechern stoebern.\n",
    	"Diese Stille ist atemberaubend.\n",
    	"Hier kann man viel Zeit verbringen...\n",
    	"Dieser Raum hat die Geschichte von Avir miterlebt!\n",
    	"Du spuerst foermlich die knisternde Atmosphaere in diesem Raum.\n",
    	"Die Regale sind wirklich extrem hoch...\n",
    }),35);
  SetProp( P_HIDE_EXITS, ({ "oben" }) );

  AddExit( "norden", ROOM "e1-e4-rhe" );
  AddDetail( ({"beispiel", "buchern", "denied", "ende", "geschichte", 
  	"kannst", "lesen", "lichterspiel", "stille"}), "Du wirst abgelenkt.");
  	
  AddCmd( ({"buch"}), "book");
 
  SUID;
  
  //Sehertor:
  AddItem("/obj/sehertor", REFRESH_REMOVE, ([P_SEERDOOR_DISCOVER: 0]) );
  SetProp(P_TPORT_COST_IN, 1);
  SetProp(P_TPORT_COST_OUT, 1);
    
  AddItem( NPC "buergermeister" , REFRESH_DESTRUCT);
}
int ranger_book_test(object ob, int i)
{
  if(ob->QueryProp(P_GUILD) != "waldlaeufer")
  { ob->Message(BS("Das darfst Du nur als Waldlaeufer.")); return 1;}
  if((ob->QueryProp(P_GUILD_LEVEL)) < ((i*2)-1) )
  { ob->Message(BS("Dieses Buch darfst Du erst ab Gildenstufe "
                   +to_string((i*2)-1)+" lesen.")); return 1;}
  ob->More(read_file(HISTORY+"buch_"+to_string(i)+".TXT"));  
  return 1;
}

int book(string str)
{
  string s;
  
  notify_fail("Welches Buch willst Du lesen? 'buch <nr>'\n");

  if (!str || str == "") return 0;

  switch (to_int(str))
  {
    case 1: TP->More(read_file(STORYS+"tethyrtal"));    break;
    case 2: TP->More(read_file(STORYS+"tdk"));          break;
    case 3: TP->More(read_file(STORYS+"palast_short")); break;
    //case 4: TP->More(read_file(STORYS+"bergfestung"));
    //break;
    case 5: TP->More(read_file(STORYS+"todesinsel"));   break;
    //case 6: TP->More(read_file(STORYS+"zwergenfestung"));
    //break;
    //case 7: TP->More(read_file(STORYS+"verswald"));
    //break;    
     
    case 11: TP->More(read_file(STORYS+"wl_div1"));
    break;
    case 12: TP->More(read_file(STORYS+"wl_div2"));
    break;
    case 13: TP->More(read_file(STORYS+"wl_div3"));
    break;
    case 14: TP->More(read_file(STORYS+"wl_div4"));
    break;
    //case 19: TP->More(read_file(STORYS+"einleitung"));
    //break; //Ankuendigungstext fuer die Zeitung
       
    case 21: call_out("ranger_book_test", 0, TP, 1);
    break;
    case 22: call_out("ranger_book_test", 0, TP, 2);
    break;
    case 23: call_out("ranger_book_test", 0, TP, 3);
    break;
    case 24: call_out("ranger_book_test", 0, TP, 4);
    break;
    case 25: call_out("ranger_book_test", 0, TP, 5);
    break; 
    case 26: call_out("ranger_book_test", 0, TP, 6);
    break;
    case 27: call_out("ranger_book_test", 0, TP, 7);
    break;
    case 28: call_out("ranger_book_test", 0, TP, 8);
    break;
                                 
    default: return 0;
  }
  return 1;
}
