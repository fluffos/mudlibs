  AddDetail( ({ "eindruck", "unheimliches" }),
    "Dir kommt es so vor, als wuerden auch die Buecher etwas Unheimliches "
    "ausstrahlen. Ob einige wohl magischer Natur sind?");
    
  AddDetail( ({ "natur" }),
    "Das wirst Du so nicht herausfinden.");
    
  AddDetail( ({ "buecher" }),
    "Gebannt willst Du eines aufschlagen und lesen, doch... alles in "
    "altavirisch geschrieben. Enttaeuscht klappst Du das Buch wieder zu.");
    
  AddDetail( ({ "buch" }),
    "Na, Du bist einer. Welches denn?");
    
  AddDetail( ({ "figuren", "figur" }),
    "Meist irgendwelche Drachen.");
    
  AddDetail( ({ "drachen", "drache" }),
    "Davon gibt es viele im Silberland.");
    
  AddDetail( ({ "silberland" }),
    "...");
    
  AddDetail( ({ "maserung" }),
    "Du glaubst ein Tuzakmesser zu erkennen...");
    
  AddDetail( ({ "tuzakmesser" }),
    "Wie aus einer anderen Welt....");
    
  AddDetail( ({ "welt" }),
    "Du kommst leider nicht auf den Namen...");
    
  AddDetail( ({ "namen", "name" }),
    "Vielleicht steht in den Buechern etwas darueber?");
    
  AddDetail( ({ "Bilder", "bild" }),
    "Viele Kaempfe sind darauf zu sehen.");
    
  AddDetail( ({ "kaempfe", "kampf" }),
    "Helden vs. Daemonen.");
    
  AddDetail( ({ "helden", "held" }),
    "Die gewinnen natuerlich immer!");
    
  AddDetail( ({ "daemonen", "daemon" }),
    "Wann wirst Du wohl das erste Mal gegen so eine Kreatur kaempfen?");
    
  AddDetail( ({ "mal" }),
    "Ich weiss es nicht.");
    
  AddDetail( ({ "kreatur" }),
    "Du zitterst vor Angst.");
    
  AddDetail( ({ "angst" }),
    "Die ist berechtigt.");
    
  AddDetail( ({ "raum" }),
    "Er ist extrem gross und Du brauchst eine Leiter, um an die obersten "
