  AddDetail( ({ "muster" }),
    "Kunstvolle Motive wie alte Runen wurden in dem Holz verewigt.");
    
  AddDetail( ({ "motive", "motiv" }),
    "Die Runen sind ein gutes Beispiel.");
    
  AddDetail( ({ "runen", "rune" }),
    "Sie sehen so geheimnisvoll aus und geben dem Raum eine mystische "
