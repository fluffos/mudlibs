
#include "../def.h"

inherit ROOM "std_mauer";  

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Der Nordturm" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Stadtmauer von Avir. Die Zinnen rechts und links von "
    "Dir begrenzen den Weg der Soeldner. Von hier oben hast Du eine gute "
    "Aussicht auf Tethyr und die Stadt. Du bleibst einen Moment stehen und "
    "laesst das alles auf Dich einwirken. Du kannst rauf in den Turm oder "
    "weiter auf der Mauer entlanglaufen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"knack", "sehr", "und"}), "...");
  
  AddDetail( ({ "turm" }),
    "Du kannst ihn durch eine Treppe nach oben betreten.");
    
  AddDetail( ({ "treppe" }),
    "Sie wurde auch aus Stein gebaut. Nur die Stufen fehlen...");
    
  AddDetail( ({"stufen", "stufe"}), 
     "Das ist keine Treppe, das ist eine Rampe.");
     
  AddDetail( ({"rampe"}), 
     "Warum nur?");
  
  AddDetail( ({"aussicht"}), 
     "Tja, waere der Turm aus Glas, koenntest Du sie geniessen.");
     
  AddDetail( ({"glas"}), 
     "Er ist aber nicht aus Glas. Ganz im Gegenteil.");
     
  AddDetail( ({"gegenteil"}), 
     "Na, was ist wohl das Gegenteil von Glas? ... Naja, des kann man so "
     "net sagen. Der Turm ist jedenfalls aus Felsbloecken gebaut.");
     
  AddDetail( ({"felsbloecke", "bloecke", "felsblock", "block"}), 
     "Es war bestimmt nicht leicht, mit solchen grossen Teilen ein solches "
     "Bauwerk zu errichten.");
     
  AddDetail( ({"teile", "teil"}), 
     "Dass Du auch nur einen hochkriegst, bezweifle ich ernsthaft. (Und "
     "ich meinte jetzt die Steine!)");
     
  AddDetail( ({"bauwerk"}), 
     "Wenn Du noch ein klein wenig weiter nach oben schaust und evtl. ein "
     "bisschen den Hals ausrenkst...");
     
  AddDetail( ({"hals"}), 
     "*KNACK*\nSehr schoen! Jetzt siehst Du, wie unglaublich hoch der Turm "
     "ist, er verschwindet fast in den Wolken.");
     
  AddDetail( ({"wolken", "wolke"}), 
     "Erstaunlich, aber die Wolken sind hier recht tief.");

  AddExit( "westen", ROOM "e2-d1");
  AddExit( "osten", ROOM "e2-f1");
  AddExit( "oben", ROOM "e3-e1");
  
  AddItem( NPC "soeldner_m" 
          , REFRESH_DESTRUCT
          , ([ P_MNPC_AREA : ({  ROOM "e2"})])
          );
}
