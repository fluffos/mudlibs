
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Der Ostturm" );
  SetProp( P_INT_LONG,
    "Du folgst der Rampe und gelangst an eine Oeffnung im Westen. Von ihr "
    "scheint eine Bruecke weiter nach Westen zu fuehren. Ansonsten "
    "entdeckst Du in diesem Turm nichts Aussergewoehnliches. Eben ein ganz "
    "normaler Wendelrampenturm.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "decke" }),
    "Sie besteht wie alles hier aus Steinziegeln.");
    
  AddDetail( ({ "steinziegel", "ziegel" }),
    "Sie wurden gleichmaessig eingearbeitet. Doch solltest Du Dir die Decke "
    "nochmals genau anschauen.");

  AddDetail( ({ "decke genau", "decke genauer" }),
    "Du glaubst, Unebenheiten zu entdecken.");
    
  AddDetail( ({ "unebenheiten" }),
    "Irgendwie sehen sie beabsichtigt aus und scheinen ein primitives "
    "Relief zu bilden.");
    
  AddDetail( ({ "relief" }),
    "Du bist zu nah dran, um es zu erkennen. Wie koenntest Du Dich nur mehr "
    "dem Boden naehern?");
    
  AddDetail( ({ "boden", "steinboden" }),
    "Du entdeckst keine Besonderheiten bei dem Steinboden.");
    
  AddDetail( ({ "besonderheiten", "besonderes" }),
    "Ausser, dass dieser Steinboden bequemer aussieht als normale "
    "Fussboeden, entdeckst Du nichts Besonderes.");
    
  AddDetail( ({ "fussboeden" }),
    "Du wuerdest Dich nie auf einen fallen lassen.");
    
  
  
  AddDetail( ({ "rune" }),
    "Nein, es ist nur ein 'O'.");
    
  AddDetail( ({ "o" }),
    "Das muss Osten bedeuten. Du befindest Dich im Ostturm!");
    
  AddDetail( ({ "waende" }),
    "Genau genommen ist es nur eine Wand, der Turm ist ja rund.");

  AddDetail( ({ "osten", "turm" , "ostturm" }),
    "Player inside!");
    
  AddDetail( ({ "player" }),
    "Du.");
    
  AddSpecialDetail( ({ "wand" }),
    "wand");
    
  AddDetail( ({ "rampe" }),
    "Rampe, nicht Treppe.");
    
  AddDetail( ({ "treppe" }),
    "Das ist ein wichtiger Unterschied.");
    
  AddDetail( ({ "unterschied" }),
    "Der sollte Dir aufgefallen sein: Die Rampe sieht einfach viel besser "
    "aus.");
    
  AddDetail( ({ "oeffnung" }),
    "Eine Arkade wurde kunstvoll eingearbeitet. Sie umrandet die "
    "Oeffnung.");
    
  AddDetail( ({ "arkade" }),
    "Du meinst, eine Verzierung zu erkennen.");
    
  AddDetail( ({ "verzierung" }),
    "Oder doch ein Abbild?");
    
  AddDetail( ({ "abbild" }),
    "Nein, es scheint sich um eine Zeichnung zu handeln.");
    
  AddDetail( ({ "zeichnung" }),
    "Sie zeigt ein vollkommen phantastisches Gebilde.");
    
  AddDetail( ({ "gebilde", "tuerme", "aussergewoehnliches" }),
    "Du erkennnst einen riesigen Turm. Aussen fuehrt eine breite Rampe "
    "spiralfoermig nach oben. Ringsrum von diesem gigantischen Turm sind "
    "weitere kleine Tuerme gebaut, die mit steigender Rampe ebenfalls an "
    "Hoehe gewinnen.");
    
  AddDetail( ({ "aussen", "hoehe", "riesiger turm", "hoehen" }),
    "Dieses Wunderwerk der Architektur scheint sich in riesigen Hoehen zu "
    "befinden.");
    
  AddDetail( ({ "wunderwerk" , "architektur" }),
    "Du erkennst daneben eine kleine Inschrift.");
    
  AddDetail( ({ "inschrift" }),
    "Schon einmal mit lesen probiert?");

  AddDetail( ({ "kuenste", "turm der kuenste" }),
    "Sollte sich dieses Prachtwerk frueher in Avir befunden haben?");

  AddDetail( ({ "prachtwerk" }),
    "Vielleicht findest Du in der Bibliothek etwas darueber.");
    
  AddDetail( ({ "bibliothek" }),
    "Darueber muss doch etwas zu finden sein.");

  AddDetail( ({ "westen", "bruecke" }),
    "Du kannst nur wenig erkennen, Wolken versperren Dir die Aussicht.");
    
  AddDetail( ({ "wolken" }),
    "Wolken? Sie erinnern Dich daran, wie weit oben Du eigentlich gerade "
    "befindest.");
    
  AddDetail( ({ "aussicht" }),
    "Naja, Wolken eben. Wenn Du mehr sehen willst, musst Du entweder "
    "hoeher oder tiefer.");
    
  AddDetail( ({ "wendelrampenturm" }),
    "Du siehst so etwas bestimmt jeden Tag.");
    
  AddDetail( ({ "tag" }),
    "Nicht? Dann geh gefaelligst mehr forschen! Sonst bringst Du es nie zu "
    "etwas. Und ein Held wirst Du schon gar nicht.");
    
  AddDetail( ({ "held" }),
    "Du bist noch keiner, aber wenn Du schoen weiter forschst und viele "
    "Gegner besiegst, wirst Du irgendwann mal einer.");
    
  AddDetail( ({ "gegner" }),
    "Fang mit was leichtem an, wie dem Balrog.");
    
  AddDetail( ({ "balrog" }),
    "Deine zweite Kerbe sollte ein Drache sein.");
    
  AddDetail( ({ "drache" }),
    "Schoen alt natuerlich.");
    
  AddDetail( ({ "kerbe" }),
    "Nach und nach steigerst Du Dich dann, bis Du eine Legende bist.");
    
  AddDetail( ({ "legende", "legenden" }),
    "Legenden sind in Avir immer willkommen. Hier waren schon lang keine "
    "mehr.");
    
  AddDetail( ({ "avir" , "stadt" }),
    "Diese Stadt heisst Avir.");

  AddReadDetail( ({ "inschrift" }),
    "'Avirs Turm der Kuenste'");
    
  AddCmd( ({"fall", "falle"}), "decke");

  AddExit( "unten", ROOM "e2-g3");
  AddExit( "oben", ROOM "e4-g3");
  AddExit( "westoben", ROOM "e4-f3");
  
  SetProp(P_HIDE_EXITS, ({"westen"}) );
  AddExit( "westen", ROOM "e4-f3");

}
int decke(string str)
{
	notify_fail(BS("Was wills du tun?\n"));
	if( str == "" || str == "nach hinten" || str == "um" 
	    || str == "nach hinten") 
	{ 
	  say( TPN+" kippt laaangsam nach hinten um.\n");
	  write (BS("Du laesst Dich einfach nach hinten fallen und landest "
		"ueberraschenderweise relativ sanft. Du betrachtest nun das Relief "
		"naeher und erkennst eine Rune."));
		return 1;
	}
  return 0;
}

string wand()
{
	say( TPN+" nimmt eine Wand ernst.\n");
	return BS("Du nimmst eine Wand. (sogar relativ genau)");
}