
#include "../def.h"

inherit ROOM "std_mauer";  

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Die Stadtmauer" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Stadtmauer von Avir. Die Zinnen rechts und links von "
    "Dir begrenzen den Weg der Soeldner. Von hier oben hast Du eine gute "
    "Aussicht auf Tethyr und die Stadt. Du bleibst einen Moment stehen und "
    "laesst das alles auf Dich einwirken. Das ist die suedoestliche Ecke "
    "der Mauer." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"ecke"}), 
     "Kann man knicken, muss man aber nicht.");
      
  AddDetail( ({"suedoestliche", "suedoestliche ecke"}),
     "*seufz* Untersuche lieber die Aussicht.");
     
  AddDetail( ({"aussicht"}),
     "Gleich null wegen des Nebels.");
     
  AddDetail( ({"nebel"}),
     "    .:*~*:._.:*~*:._.:*~*:.\n"
     "-_-.:~ *_ .:*~*:._.:*~*:._.:*~*:.\n"
     "	Dieser Effekt wurde uns von den Machern der Matrix bereitgestellt.");
     
  AddDetail( ({"matrix", "geschichte"}),
		 "Das ist eine andere Geschichte.");
     
  AddDetail( ({"effekt", "macher"}),
     "Jaja...");

  AddExit( "norden", ROOM "e2-g4");
  AddExit( "westen", ROOM "e2-f5");

}
