
#include "../def.h"

inherit "std/room";

#include <properties.h>
//----Von hot und kolmey:----//
#define HOCKER(wer) (member(hocker, capitalize(getuid(wer)))!=-1)
#define MyCountUp(arg) (sizeof(arg) > 1 ? \
        implode(arg[0..<2], ", ") + " und " + arg[<1] : \
        (sizeof(arg) == 0 ? "niemand" : arg[0]) )

string *hocker=({});
//____///

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Park" );
  SetProp( P_INT_LONG,
    "Du bist im wunderschoenen blauen Stadtpark. Hier kannst Du Dich "
    "entspannen und ausruhen. Auf den Wiesen liegen Leute, die lesen, "
    "picknicken oder schlafen. Einige sitzen auch auf den Baenken vor dem "
    "Brunnen. Was fuer ein schoener Ort mitten in der Stadt." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "stadtpark", "park" }),
    "So nennt man Gruenanlagen innerhalb einer Stadt.");
    
  AddDetail( ({ "anlagen", "anlage", "gruenanlage", "gruenanlagen" }),
    "Naja, in diesem Fall eine Blauanlage.");
    
  AddDetail( ({ "stadt", "avir" }),
    "Diese Stadt heisst Avir.");
    
  AddDetail( ({ "blauanlage" }),
    "Wie auch im Wald haben hier alle Pflanzen blaue Blaetter.");
    
  AddDetail( ({ "blaetter", "pflanzen", "blatt", "pflanze" }),
    "Tatsaechlich blau. An dieses Wunder des Tethyrwaldes haben sich die "
    "Bewohner hier schon lange gewoehnt.");
    
  AddDetail( ({ "wald", "tethyrwald" }),
    "Ihn findest Du ausserhalb der Stadt, wenn Du das Plateau ueber den "
    "Wachweg verlaesst.");
    
  AddDetail( ({ "plateau" }),
    "Die ganze Stadt wurde auf einem Plateau errichtet.");
    
  AddDetail( ({ "wachweg" }),
    "Der Wachweg fuehrt an dem Plateau nach unten.");
    
  AddDetail( ({ "wunder" }),
    "Man nennt es auch 'Das blaue Wunder'. Mhhh... irgendwoher kennst Du "
    "diesen Namen noch.");
    
  AddDetail( ({ "namen", "name" }),
    "Warum musst Du unwillkuerlich an eine grosse Bruecke denken?");
    
  AddDetail( ({ "bruecke" }),
    "Hoer lieber auf diese Gedanken weiter zu verfolgen, wer weiss, wo das "
    "hin fuehrt.");
    
  AddDetail( ({ "gedanken" }),
    "Ich habe gesagt hoer auf!");
    
  AddDetail( ({ "ich" }),
    ".. gebs auf.");

  AddDetail( ({ "bewohner" }),
    "Eben alles, was in Avir so kreucht und fleucht.");
    
  AddDetail( ({ "alles" }),
    "Ist so ein Sprichwort.");
    
  AddDetail( ({ "sprichwort" }),
    "Kennst Du welche?");
    
  AddDetail( ({ "wiesen", "wiese"}),
    "Sicher ist es ungewohnt, aber die blaue Wiese sieht wirklich toll aus. "
    "Soweit Du das beurteilen kannst, ist sie gut gepflegt.");
    
  AddDetail( ({ "leute" }),
    "Sie lesen Buecher, machen ein Picknick oder goennen sich eine Dosis "
    "Schlaf.");
    
  AddDetail( ({ "buecher", "buch" }),
    "Du findest viele in der Bibliothek im Rathaus.");
    
  AddDetail( ({ "rathaus" }),
    "Das ist im Sueden.");
    
  AddDetail( ({ "sueden" }),
    "Na dort.");
    
  AddDetail( ({ "bibliothek" }),
    "Also, wenn ich Dir das erklaeren muss, ist wirklich alles zu spaet.");

  AddDetail( ({ "picknick" }),
    "Ein weiss-rot-kariertes Tuch, einen Korb und eine Bilderbuchfamilie.");

  AddDetail( ({ "tuch" }),
    "Sowas braucht man fuer ein Picknick.");
    
  AddSpecialDetail( ({ "korb" }),
    "korb");
    
  AddDetail( ({ "frau", "mann" }),
    "Was hast Du erwartet? So wie Du aussiehst?");
    
  AddDetail( ({ "bilderbuchfamilie", "familie" }),
    "Schoen, den Trollen zu zu schaun.");

  AddDetail( ({ "trolle", "troll" }),
    "Die leben auch hier!");
    
  AddDetail( ({ "dosis" }),
    "Wenn man danach auf -T erscheint, wars ne Ueberdosis *muhahahaha*");
    
  AddDetail( ({ "ueberdosis" }),
    "Ueberdosis Schlaf = Tod? Verstanden? *Muhahaha...ha.......ha...h* "
    "Nicht komisch?");
    
  AddDetail( ({ "schlaf" }),
    "ALLEINE!");
    
  AddDetail( ({ "ort" }),
    "Und so friedfertig!");
    
  AddDetail( ({ "brunnen" }),
    "Ein aus schwarzem Marmor gefertigtes Becken, in dem kristallklares "
    "Wasser fliesst.");
    
  AddDetail( ({ "marmor" }),
    "Die weissen Adern geben dem Brunnen ein mystisches Erscheinungsbild.");
    
  AddDetail( ({ "erscheinungsbild" }),
    "Deines ist laengst nicht so toll!");

  AddDetail( ({ "becken" }),
    "Eine gelungene Arbeit. Du wuerdest Dich am liebsten setzen und ein "
    "wenig vertraeumt ins Wasser starren.");
    
  AddDetail( ({ "wasser" }),
    "Blau wie der Himmel.");
    
  AddDetail( ({ "himmel" }),
    "Natuerlich ist das Wasser hier blau, es spiegelt ja den blauen Himmel. "
    "Aber eigentlich ist es durchsichtig.");
    
  AddDetail( ({ "boden" }),
    "Der sollte dringend mal wieder untersucht werden! Gut gemacht!");
    
  AddDetail( ({ "arbeit" }),
    "Meine Arbeit ist gut gelungen, mh?");
    
  AddDetail( ({"adern", "baeume", "breucke", "das", "erscheinugsbild", 
  	"fall", "gegenteil", "muhahaha", "nicht", "rauschen", "ruhe", "t", "tod", 
  	"vogel", "wind"}), "...");

  AddSound( DEFAULT_SOUND,
    "Diese wunderbare Ruhe und das Plaetschern des Wassers...");

  AddSound( ({ "plaetschern", "wasser" }),
    "Sehr entspannend.");

  AddSmell( DEFAULT_SMELL,
    "Frische Luft wie sonst nirgends in der Stadt.");

  AddSmell( ({ "luft" }),
    "Herrlich frisch.");

  AddRoomMessage( 
    ({
    	"Du hoerst einen Vogel traellern.\n",
    	BS("Herrlich diese Ruhe. Dieser Park ist das Gegenteil der restlichen "
    	"Stadt."),
    	"Du hoerst das Rauschen einiger Baeume im Wind.\n",
    	"Avir hat diesen Park dringend noetig!\n",
    	"Du moechtest Dich einfach nur hinsetzen und ruhen...\n",
    	"Vielleicht kann man sich hier ja in Avir zur Ruhe setzen?\n",
    	"Es ist ein so schoener Ort.\n",
    }),39);

  
   AddSpecialDetail( ({ "bank", "baenke" }), "hocker");
   AddCmd( ({ "setze", "setz", "sitze", "sitz" }), "cmd_sitdown");
   AddCmd( ({ "stehe", "steh" }), "cmd_getup");

  AddExit( "norden",
               ([ EX_DEST: "./e1-e2-platz",
                  EX_TESTFUNC: "test_firststandup" ]) );
  AddExit( "sueden",
               ([ EX_DEST: "./e1-e4-rhe",
                  EX_TESTFUNC: "test_firststandup" ]) );
  AddExit( "osten",
               ([ EX_DEST: "./e1-f3-auf",
                  EX_TESTFUNC: "test_firststandup" ]) );
  AddExit( "westen",
               ([ EX_DEST: "./e1-d3-strasse",
                  EX_TESTFUNC: "test_firststandup" ]) );                  

  AddItem( NPC "kinder" , REFRESH_DESTRUCT);
  AddItem( NPC "kinder" , REFRESH_DESTRUCT);
  AddItem( NPC "einwohner" , REFRESH_DESTRUCT);
}

string korb()
{
  //notify_fail( "\n" );
  int gender;
  gender = TP->QueryProp(P_GENDER);
  if (gender == 1) //MALE
  {
    return BS("Eine Frau kommt an und gibt Dir einen Korb.");
  }
  if (gender == 2) //FEMALE
  {
    return BS("Ein Mann kommt an und gibt Dir einen Korb.");
  }
  
}

int test_firststandup()
{
  if(HOCKER(TP))
  {
    TP->Message(BS("Du musst zuerst aufstehen!"));
    return 0;
  }
  else return 1;  
}

///---HOTARU und KOLMEY (grundidee)---//
int cmd_sitdown(string str)
{
   notify_fail(BS("Wohin moechtest Du Dich setzen?"));
   if(!(str == "auf bank" || str == "auf bank hin"))
   {
     return 0;
   }
   if(HOCKER(TP))
   {
   write(BS("Aber Du sitzt doch schon auf einer Bank!"));
   return -1;
   }
   if(sizeof(hocker)>=5)
   {
   write(BS("Leider sind schon alle Baenke besetzt."));
   return -1;
   }
   write (BS("Du setzt Dich auf eine der Baenke vor dem Brunnen.\n"));
   tell_room(ENV(TP), TPN+" setzt sich auf eine Bank.\n", ({TP}));
   hocker += ({ capitalize(getuid(TP)) });
   return 1;
}

int cmd_firststandup(string str)
{
  if(HOCKER(TP))
  {
     write("Du solltest vorher besser aufstehen!\n");
     return 1;
  }
}


int cmd_getup(string str)
{
   notify_fail(BS("Willst Du etwa aufstehen?"));
   if(str == "auf")
   {
   if(HOCKER(TP))
   {
     write(BS("Du stehst von der Bank auf."));
     tell_room(ENV(TP), TPN+" steht von einer Bank auf.\n", ({TP}));	 
     hocker -= ({ capitalize(getuid(TP)) });
     return 1;
     }
  }      
  else 0;
}

void BecomesNetDead(object spieler)
{
  if(HOCKER(spieler))
  hocker -= ({ capitalize(getuid(spieler)) });
}

string hocker()
{
  string hockerinfo;
  if(HOCKER(TP))
  {
     hockerinfo =
     "Du sitzt auf einer der Baenke. "+
     "Direkt vor Dir befindet sich der Brunnen.";
  }
  else
  {
     hockerinfo =
     "Insgesamt wurden 5 Baenke vor dem Brunnen aufgestellt. "
     "Du koenntest Dich auch auf eine von ihnen setzen.";
  if(sizeof(hocker)==1 )
     hockerinfo += " Im Moment sitzt " + hocker[0] + " auf einer der "
     		   "Baenke.";
    
  if(sizeof(hocker)>1 )
     hockerinfo += " Im Moment sitzen " + MyCountUp(hocker) + " auf den "
     		   "Baenken.";
  }
  return break_string(hockerinfo, 78);
}
