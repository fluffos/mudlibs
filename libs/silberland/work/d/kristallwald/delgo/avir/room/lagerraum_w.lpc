

inherit "std/store";

#include "../def.h"

string datum, dat;

create()
{
  ::create();
  AddItem("/obj/fackel");
  AddItem("/obj/fackel");
  AddItem("/obj/fackel");
  datum = dtime();
	dat = extract(datum,0,2);
	if( dat == "Sam" || dat == "Mit")
	{
		AddItem("/p/weapon/sword/holzschwert");
		AddItem("/p/weapon/sword/machete");
		AddItem("/p/weapon/sword/florett");
		AddItem("/p/weapon/sword/bronzeschwert");
		AddItem("/p/weapon/sword/kurzschwert");
		AddItem("/p/weapon/sword/degen");
		AddItem("/p/weapon/sword/knochenschwert");
		AddItem("/p/weapon/sword/rapier");
		AddItem("/p/weapon/sword/krummsaebel");
		AddItem("/p/weapon/sword/saebel");
		AddItem("/p/weapon/axe/steinbeil");
		AddItem("/p/weapon/axe/handbeil");
		AddItem("/p/weapon/axe/spitzhacke");
		AddItem("/p/weapon/axe/handaxt");
		AddItem("/p/weapon/axe/pickel");
		AddItem("/p/weapon/axe/holzfaelleraxt");
		AddItem("/p/weapon/axe/steinaxt");
		//call_out("samstag", 1);
		return 1;
	}
	if( dat == "Son" || dat == "Die" || dat == "Don")
	{
		AddItem("/p/weapon/chain/dreschflegel");
		AddItem("/p/weapon/knife/kuechenmesser");
		AddItem("/p/weapon/knife/messer");
		AddItem("/p/weapon/knife/steindolch");
		AddItem("/p/weapon/knife/dolch");
		AddItem("/p/weapon/knife/fleischermesser");
		AddItem("/p/weapon/knife/obsidiandolch");
		AddItem("/p/weapon/knife/jagdmesser");
		AddItem("/p/weapon/knife/stilett");
		AddItem("/p/weapon/whip/peitsche");
		AddItem("/p/weapon/whip/neunschwaenzige");
		//call_out("sonntag", 1);
		return 1;
	}
	if( dat == "Fre" || dat == "Mon")
	{
		AddItem("/p/weapon/club/holzstock");
		AddItem("/p/weapon/club/knueppel");
		AddItem("/p/weapon/club/wanderstab");
		AddItem("/p/weapon/club/schmiedehammer");
		AddItem("/p/weapon/club/keule");
		AddItem("/p/weapon/club/dornenknueppel");
		AddItem("/p/weapon/club/kampfstab");
		AddItem("/p/weapon/club/dornenkeule");
		AddItem("/p/weapon/club/knochenkeule");
		AddItem("/p/weapon/spear/holzspeer");
		AddItem("/p/weapon/spear/speer");
		AddItem("/p/weapon/spear/angel");
		AddItem("/p/weapon/spear/obsidianspeer");
		AddItem("/p/weapon/spear/jagdspeer");
		AddItem("/p/weapon/spear/dreizack");
		AddItem("/p/weapon/spear/angriffsspeer");
		//call_out("montag", 1);
		return 1;
	}
	else
	{
		write("Etwas stimmt nicht\n");
		return 1;
	}

}

void refresh()
{
