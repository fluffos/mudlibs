#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Der Nordturm" );
  SetProp( P_INT_LONG,
    "Du hast die Turmspitze erreicht und blickst nun in das weite Tal von "
    "Tethyr. Ganz im Norden kannst Du die Felswand erkennen, welche das Tal "
    "umgibt. Auch glaubst Du, eine kleine Schlucht zu erkennen, bist Dir "
    "aber nicht ganz sicher. Weiter unten siehst Du noch den Wachweg und "
    "die breite Strasse ist auch nicht zu uebersehen."
    );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "himmel" }),
    "Er ist da, wo er immer ist.");

  AddDetail( ({ "boden" }),
    "Ein ganz normaler Steinboden.");

  AddDetail( ({ "steinboden" }),
    "So nennt man einen Boden aus Stein.");
    
  AddDetail( ({ "stein", "zinnen", "zinne" }),
    "Vermutlich Granit.");
    
  AddDetail( ({ "granit" }),
    "Granit wird sehr oft fuer so etwas verwendet, es ist hartes und "
    "widerstandsfaehiges Material.");
    
  AddDetail( ({ "material" }),
    "Es muss schon diese Eigenschaften aufweisen, wenn es Angriffen "
    "standhalten muss.");
    
  AddDetail( ({ "angriffe", "angriff" }),
    "Mit einer Stadtmauer aus Granit beissen die Angreifer auf selbiges.");
    
  AddDetail( ({ "angreifer" }),
    "Ich weiss nicht, warum sie das tun, aber wer versteht schon die Orks.");
    
  AddDetail( ({ "orks", "ork" }),
    "Nur Orks koennen so dumm sein und auf Granit beissen.");    
    
  AddDetail( ({ "stadtmauer", "mauer" }),
    "Sie umrandet die Stadt Avir.");
    
  AddDetail( ({ "avir", "stadt" }),
    "Diese Stadt heisst Avir.");
    
  AddDetail( ({ "turmspitze" }),
    "So nennt man das obere Ende eines Turmes.");
    
  AddDetail( ({ "turm" }),
    "Er ist rund und verdammt hoch.");
    
  AddDetail( ({ "ende" }),
    "Da, wo der Turm aufhoert. Eben dieser Platz hier.");
    
  AddDetail( ({ "platz" }),
    "Ein gemuetliches Plaetzchen ist es zwar nicht gerade, aber Du kennst "
    "Schlimmeres.");
    
  AddDetail( ({ "plaetzchen" }),
    "Homer denkt . o O ( Mhhh... Plaetzchen *sabber*)");
    
  AddDetail( ({ "homer" }),
    "Homer versteckt sich schnell.");
    
  AddDetail( ({ "tethyr" }),
    "Du hast keine Ahnung, wie man auf den Namen Tethyr kam.");
    
  AddDetail( ({ "namen", "name" }),
    "Du hast keine Ahnung.");
    
  AddDetail( ({ "ahnung" }),
    "Weisst Du denn GAR NICHTS?");
    
  AddDetail( ({ "nichts", "gar nichts" }),
    "Das ist sehr wenig, fast Null.");
    
  AddDetail( ({ "null" }),
    "Sagen wirs so: Wenn Du runter springst, gibt es eine weniger im "
    "Silberland.");
    
  AddDetail( ({ "silberland" }),
    "Ueberall.");
    
  AddDetail( ({ "tal" }),
    "So nennt man diese Landschaftsform.");
    
  AddDetail( ({ "landschaftsform" }),
    "Eine groessere Vertiefung in der Landschaft  - Tal.");
    
  AddDetail( ({ "vertiefung" }),
    "Sie ist keine Schlucht, also geschlossen.");
    


    
  AddDetail( ({ "loch" }),
    "Eben ein Tal, hast Du noch nie eines gesehen oder warum stellst Du "
    "Dich so an?");
    
  AddDetail( ({ "landschaft" }),
    "Lassen wir das.");
    
  AddDetail( ({ "norden", "sueden", "westen", "osten" }),
    "Du schaust gerade in diese Richtung.");
    
  AddDetail( ({ "richtung", "richtungen" }),
    "         Norden\n"
    "            /\\\n"
    "            |\n"
    " Westen < - o - > Osten\n"
    "            |\n"
    "            \\/\n"
    "         Sueden\n"
    );
    
  AddDetail( ({ "felswand" }),
    "Sie ist im ganzen Tal fast immer senkrecht.");
    
  AddDetail( ({ "schlucht" }),
    "Aber nicht zu kurz, sonst waere es ein Loch.\n"
    "Es scheint sich um einen Durchgang zu handeln, denn die breite Strasse "
    "fuehrt direkt dahin.");
    
  AddDetail( ({ "durchgang" }),
    "Vielleicht ein Pass?");
    
  AddDetail( ({ "pass" }),
    "Er koennte durch die Felswand nach Norden fuehren.");
    
  AddDetail( ({ "strasse" }),
    "Sie ist so breit, dass sie kaum zu uebersehen ist.");
    
  AddDetail( ({ "wachweg" }),
    "Er liegt weit unter Dir. Du erkennst ausserdem noch eine kleine "
    "Vorrichtung.");
    
  AddDetail( ({ "vorrichtung" }),
    "Du kannst nicht genau erkennen, was es ist, aber koennte es ein Aufzug "
    "sein?");
    
  AddDetail( ({ "aufzug" }),
    "Wenn es denn einer ist, verbindet er den Wachweg direkt mit der "
    "Strasse. Er scheint als Abkuerzung zu fungieren.");
    
  AddDetail( ({ "abkuerzung" }),
    "Sonst haette man am Fusse des Felsens noch einen weiteren Weg bauen "
    "muessen. Der Wachweg endet naemlich an der Suedseite des Felsens.");
    
  AddDetail( ({ "fuss", "fusse" }),
    "Unten.");
    
  AddDetail( ({ "felsen", "fels" }),
    "Auf ihm ruht Avir.");
    
  AddDetail( ({ "weg" }),
    "Einen, der zu der Nordseite fuehrt.");
    
  AddDetail( ({ "nordseite" }),
    "Dort beginnt die Strasse.");
    
  AddDetail( ({ "suedseite" }),
    "Die kannst Du von hier nicht einsehen.");
  
  AddDetail( ({"pause", "eigenschaften", "gar", "o", "schlimmeres", "mhhh"}), 
  						 "Mach mal ne Pause!");
 
  AddExit( "unten", ROOM "e3-e1");
	AddItem( NPC "bogenschuetze" , REFRESH_DESTRUCT);
}
