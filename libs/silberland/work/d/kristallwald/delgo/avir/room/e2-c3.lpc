
#include "../def.h"

inherit ROOM "std_mauer"; 

#include <properties.h>


void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Der Westturm" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Stadtmauer von Avir. Die Zinnen rechts und links von "
    "Dir begrenzen den Weg der Soeldner. Von hier oben hast Du eine gute "
    "Aussicht auf Tethyr und die Stadt. Du bleibst "
    "einen Moment stehen und laesst das alles auf Dich einwirken. Du kannst "
    "rauf in den Turm oder weiter auf der Mauer entlanglaufen. Eine Kurbel "
    "ist hier aufgebaut." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "turm" }),
    "Du kannst ihn durch eine Treppe nach oben betreten.");
    
  AddDetail( ({ "treppe" }),
    "Sie wurde auch aus Stein gebaut. Aber naja, die Stufen fehlen "
    "irgendwie...");
    
  AddDetail( ({ "kurbel" }),
    "Mit ihr kannst Du das Tor oeffnen und schliessen. Du musst sie nur "
    "drehen.");
    
  AddDetail( ({"aussicht"}),
     "Die ist Dir leider durch den Turm auf der Westseite verwehrt.");
     
  AddDetail( ({"westseite"}),
     "Dort.");

  AddDetail( ({"tor"}),
     "Dir faellt jetzt auf, wie gut das Stadttor und damit die ganze Stadt "
     "gesichert ist.");     
     
  AddDetail( ({"stadttor"}),
     "Hier fuehren die Seile hoch, die Du noch von der Haengebruecke kennst "
     "und hier kann man ueber einen genialen Mechanismus das Tor jederzeit "
     "schliessen und oeffnen.");
     
  AddDetail( ({"seile", "seil"}),
     "Im absoluten Notfall werden sie durchtrennt und die Haengebruecke "
     "faellt in die Tiefe.");
     
  AddDetail( ({"notfall"}),
     "Du bist alleine keine Bedrohung.");
     
  AddDetail( ({"bedrohung"}),
     "Eine feindliche Armee zum Beispiel.");
     
  AddDetail( ({"armee", "beispiel"}),
     "Noch ist keine da.");
     
  AddDetail( ({"tiefe"}),
     "Wenn sie in die Hoehe fliegen wuerde, waere es ein Vorzeichenfehler "
     "der Architekten.");
     
  AddDetail( ({"hoehe", "architekten", "architekt"}),
     "Hatten bestimmt Hoehenfluege.");
     
  AddDetail( ({"vorzeichenfehler", "hoehenfluege"}),
     "Was untersuchst Du den fuer Nehcas?");
     
  AddDetail( ({"nehcas"}),
     "Da, schon wieder! Ein sinnloses Liated!");
     
  AddDetail( ({"liated"}),
     "Ich gebs auf, untersuch doch weiter Zeugs wie scriptfalle, "
     "forschertod, ich-bin-ein-scripter-bestraft-mich.");
     
  AddDetail( ({"zeugs", "scriptfalle", "forschertod"}),
     "So etwas gibt es natuerlich nicht.");
     
  AddDetail( ({"ich-bin-ein-scripter-bestraft-mich"}),
     "Ok.");
     
  AddDetail( ({"ok"}),
     "^^");
     
  AddDetail( ({"haengebruecke"}),
     "Die ist vor dem Tor.");
     
  AddDetail( ({"mechanismus"}),
     "Dank der Flaschenzuege kann jedes Kind die Gitterstaebe heben und "
     "senken.");
     
  AddDetail( ({"flaschenzuege", "flaschenzug", "zug", "zuege"}),
     "Bitte einsteigen!");
     
  AddDetail( ({"kind"}),
     "Also koenntest auch Du es schaffen.");
     
  AddDetail( ({"gitterstaebe"}),
     "Die sind ansonsten recht schwer.");
     
 
  AddDetail( ({"stufen", "stufe"}),
     "Das ist keine Treppe, das ist eine Rampe.");
     
  AddDetail( ({"rampe"}),
     "Warum nur?");

  AddExit( "sueden", ROOM "e2-c4");
  AddExit( "norden", ROOM "e2-c2");
  AddExit( "oben", ROOM "e3-c3");
  
  AddCmd( ({ "dreh", "drehe", "kurbel", "kurble" }),
    "kurbel");
  
  AddItem( NPC "soeldner" , REFRESH_DESTRUCT); 
// Als "Bewacher", darf er zwar fliehen aber er sollte schon da stehen 
//bleiben
 
}

int kurbel(string str)
{
	if( str == "kurbel" || str == "an kurbel" )
	{
		object ob;
		ob=present("soeldner");
		if (ob)
		{
	 		write(BS("Der Soeldner laesst Dich nicht ran.\n"));
	 		return -1;
		}
		else
		{
			call_other( ROOM "e1-c3-tor", "gate_cmd", 1);
     	return 1;
		}
	}
	else
	{
		write(BS("Was willst Du drehen?\n"));
		return 1;
	}
}
