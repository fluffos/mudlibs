
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Bruecke in den Wolken" );
  SetProp( P_INT_LONG,
    "Du befindest Dich auf einer Steinbruecke und wenn Du nach Westen "
    "gehst, kommst Du zu einem Turm. Das ist aber auch schon alles, was Du "
    "siehst. Du scheinst Dich direkt in einer Wolkenbank zu befinden und "
    "dementsprechend ist die Sicht bescheiden.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "boden" }),
    "Es ist so nebelig, dass Du keine Einzelheiten erkennst.");
    
  AddDetail( ({ "einzelheiten" }),
    "Du bist Dir auch sicher, dass es keine gibt. Was soll man auch auf "
    "einem Steinboden auf einer Steinbruecke, hoch ueber einer Stadt, "
    "welche wiederum auf einem 200 Meter hohen Felsen inmitten eines "
    "sagenumwobenen Waldes liegt, fuer Besonderheiten finden?");

  AddDetail( ({ "steinboden" }),
    "Ein Boden aus Stein.");
    
  AddDetail( ({ "stein" }),
    "Der Boden ist aus Stein.");
    
  AddDetail( ({ "steinbruecke", "bruecke" }),
    "Du stehst drauf. (Das hoffst Du zumindest)");
    
  AddDetail( ({ "stadt", "avir" }),
    "Diese Stadt heisst Avir.");
    
  AddDetail( ({ "meter" }),
    "Was soll diese dumme Frage?");
    
  AddDetail( ({ "frage" }),
    "Ich weiss, dass Du weisst, dass ich weiss, dass Du weisst, was ein "
    "Meter ist!");
    
  AddDetail( ({ "felsen", "fels" }),
    "Den kannst Du schon gar nicht erkennen!");
    
  AddDetail( ({ "wald" }),
    "Was habe ich ueber den Felsen gesagt?");
    
  AddDetail( ({ "besonderheiten", "besonderheit" }),
    "Richtig, keine :-)");
    
  AddDetail( ({ "himmel" }),
    "Du versuchst, ihn zu betrachten, kannst aber kaum was erkennen. Dir "
    "faellt nur ein kleiner Schatten auf.");
    
  AddDetail( ({ "schatten" }),
    "Oh, der ist aber weit oben. Scheint ein Vogel zu sein.");
    
  AddDetail( ({ "vogel" }),
    "Es muss ein Vogel sein. Einer, der seit 15 Minuten am selben Platz "
    "schwebt.");
    
  AddDetail( ({ "platz" }),
    "Du klammerst Dich an die Hoffnung, es ist ein Vogel!");
    
  AddDetail( ({ "minuten" }),
    "Jetzt sind es schon 16 *schwitz*. Es ist ein Vogel, es ist ein Vogel, "
    "es ist ...");
    
  AddDetail( ({ "hoffnung" }),
    "Gib es auf. Du bist Dir jetzt sicher, dass es kein Vogel, sondern der "
    "Schatten eines Bauwerks ist.");
    
  AddDetail( ({ "bauwerk" }),
    "Die fallen jetzt noch weitere Schatten auf. Was steht da oben bloss? "
    "Du musst an die Zeichnung im Wachturm zurueckdenken...");
    
  AddDetail( ({ "wachturm" }),
    "Welcher war das bloss?");
    
  AddDetail( ({ "zeichnung" }),
    "Was zeigte sie doch gleich?");
    
  AddDetail( ({ "turm kuenste" }), // fetten FP!
    "Genau! Oh oh ... Du schluckst trocken. Sollte dieses ... Ding wirklich "
    "existieren?");
    
  AddDetail( ({ "ding" }),
    "Langsam geraet Dein Weltbild ins Schwanken.");
    
  AddDetail( ({ "weltbild", "schwanken" }),
    "Du faengst an zu zittern. Welches Volk hat solch eine Macht, um so "
    "etwas zu errichten?");
    
  AddDetail( ({ "volk" }),
    "Etwa das jetzt so ruhige Volk von Avir? Das scheint Dir "
    "unwahrscheinlich.");
    
  AddDetail( ({ "macht" }),
    "Auf natuerlichem Wege bringt so etwas keiner zustande.");
    
  AddDetail( ({ "weg", "wege" }),
    "Du schaust wieder nach unten. Wenn Du nach Westen gehst, wirst Du mehr "
    "erfahren, da bist Du Dir sicher.");
    
  AddDetail( ({ "westen" }),
    "Im Westen gelangst Du zu einem Turm.");
    
  AddDetail( ({ "turm" }),
    "Zumindest sieht es so aus, als waere es einer.");
    
  AddDetail( ({ "wolkenbank" }),
    "Sieht zwar sehr bequem aus, Du solltest Dich aber nicht reinsetzen. "
    "Die Wolken wuerden Dich nicht halten.");
    
  AddDetail( ({ "wolken", "wolke" }),
    "Sie sind hier sehr dicht.");
    
  AddDetail( ({ "sicht" }),
    "Sie ist wirklich sehr schlecht, durch die Wolken kommst Du Dir vor als "
    "waerst Du im Nebel.");
    
  AddDetail( ({ "nebel" }),
    "Nebelbank, nicht Wolkenbank. Mein Fehler!");
    
  AddDetail( ({ "fehler" }),
    "Verpetz mich bitte nicht!");
    
  AddDetail( ({ "nebelbank" }),
    "Du solltest hier verschwinden. Nebel macht nur depressiv. Such Dir "
    "einen schoeneren Ort!");
    
  AddDetail( ({ "ort" }),
    "Es gibt so viele schoene Orte im Silberland, und Du bist hier!");
    
  AddDetail( ({ "orte" }),
    "Das Meer waere jetzt sehr schoen!");
    
  AddDetail( ({ "meer" }),
    "Obwohl es da auch Nebel gibt.");
    
  AddDetail( ({ "silberland" }),
    "Ist es nicht schoen in seiner Pracht?");
    
  AddDetail( ({ "pracht" }),
    "Viele Plaetze sind wirklich praechtig anzusehen. Ich bin mir sicher, "
    "Du kennst nicht mal die Haelfte!");

  AddDetail( ({ "plaetze" }),
    "Such sie doch!");
    
  AddDetail( ({ "haelfte" }),
    "1/2");
  AddDetail( ({"das", "decke", "waende", "wand"}), "Nicht so pingelig!");

  AddExit( "ostunten", ROOM "e3-g3");
  AddExit( "westoben", ROOM "e5");
  
  SetProp(P_HIDE_EXITS, ({"osten", "westen"}) ); 
  AddExit( "osten", ROOM "e3-g3");
  AddExit( "westen", ROOM "e5");
  
}