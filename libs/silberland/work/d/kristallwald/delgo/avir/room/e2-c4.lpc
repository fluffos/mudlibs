
#include "../def.h"

inherit ROOM "std_mauer";  

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Die Stadtmauer" );
  SetProp( P_INT_LONG,
    "Du stehst auf der Stadtmauer von Avir. Die Zinnen rechts und links von "
    "Dir begrenzen den Weg der Soeldner. Von hier oben hast Du eine gute "
    "Aussicht auf Tethyr und die Stadt. Du bleibst einen Moment stehen und "
    "laesst das alles auf Dich einwirken. Im Norden kannst Du einen Turm "
    "sehen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"turm"}), 
     "Recht gross, moechte man meinen.");
     
  AddDetail( ({"aussicht"}), 
     "Du kannst hier den Westen des Waldes gut betrachten.");
     
  AddDetail( ({"westen"}), 
     "Keine Unterbrechung ist im Wald zu erkennen. Wie eine Decke... halt! "
     "Was ist das?");
     
  AddDetail( ({"decke"}), 
     "Wie eine Decke bedeckt der Wald das Tal.");
     
  AddDetail( ({"unterbrechung"}), 
     "Ein Baum ist wesentlich hoeher als die anderen.");
     
  AddDetail( ({"baum"}), 
     "Ist das der grosse Baum, um den sich zahlreiche Legenden hier "
     "drehen?");
     
  AddDetail( ({"legenden", "legende"}), 
     "Angeblich soll sich dort die alte Macht der.. ach, so ein Bloedsinn. "
     "Das ist bestimmt nur Humbug.");
     
  AddDetail( ({"macht"}), 
     "Legenden sprechen von diesem Baum und der Macht, die ihm inne wohnt.");
     
  AddDetail( ({"bloedsinn" , "humbug", "maerchen"}), 
     "Genau so ein Maerchen wie das Fraggle und der Balrog.");
     
  AddDetail( ({"fraggle", "balrog"}), 
     "Ich seh keine dieser beiden maechtigen Kreaturen.");
     
  AddDetail( ({"kreaturen", "kreatur"}), 
     "Keine der Bestien ist hier.");
     
  AddDetail( ({"bestien", "bestie"}), 
     "... noch sind sie nicht hier ...");
     
  AddExit( "sueden", ROOM "e2-c5");
  AddExit( "norden", ROOM "e2-c3");

}
