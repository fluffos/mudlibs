#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Tief im Berg");
  SetProp(P_INT_LONG,
    "<<Kampfplatz>>");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "" }),
    "");

  AddSpecialDetail( ({ "" }),
    "detail_fun");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");

  AddItem(NPC "priest" , REFRESH_DESTRUCT);
  AddItem(NPC "priest" , REFRESH_DESTRUCT);
  AddItem(NPC "priest" , REFRESH_DESTRUCT);
  AddItem(NPC "priest" , REFRESH_DESTRUCT);
  AddItem(NPC "priest" , REFRESH_DESTRUCT);
  AddItem(NPC "priest" , REFRESH_DESTRUCT);
  
  AddItem(NPC "daemon" , REFRESH_DESTRUCT);  
}

int is_priest(object ob)
{ 
  if(ob && ob->id("\n_zwergenpriester_bergwerk")) return 1;
  return 0;
}

int check_priests()
{
  object *priests;
  
  if(priests=filter_array(all_inventory(TO), "is_priest"))
  { return (sizeof(priests)); }
  else 
  { return 0; }
}