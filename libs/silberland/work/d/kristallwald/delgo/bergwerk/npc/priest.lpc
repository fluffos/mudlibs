#include "../def.h"

inherit "/p/std/npc/paladin_npc.lpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Zwergenpriester");
  SetProp(P_LONG,
    "Dieser Priester wurden von den Paladinen geschickt um der bevorstehenden "
    "Bedrohung durch Dothostyn Einhalt zu gebieten. Sie sitzen auf dem "
    "Boden und sind in ein tiefes Gebet versunken.");
    
  AddDetail( ({"bedrohung"}),
    "Der Daemon muss aufgehalten werden. Dazu wurden diese Priester "
    "geschickt, die speziell darauf trainiert wurden.");
    
  AddDetail( ({"gebet","einhalt"}),
    "Sie scheinen den Daemon an seinem Platz zu halten und zu schwaechen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Priester");
  SetProp(P_GENDER, MALE);
  AddId(({"priester", "zwerg", "paladin", "\n_zwergenpriester_bergwerk"}));
  AddClass( ({CL_DWARF}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_paladin(30, 10);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 110+random(20));
  SetProp(P_WEIGHT, 95000+random(15000));
  SetProp(P_ALIGN, 1200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 10);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 10);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" ist in Konzentration versunken.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0,
       DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0,
       DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0,
       DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0,
       DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0,
       DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0,
       DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0,
       DT_RIP:       0.0,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Zwergenpriester");
  
//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "ist in Konzentration versunken.\n");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 33);

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME("/p/weapon/sword/langschwert" );
  command("zuecke langschwert");

}

void die(int poisondeath)
{

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

   call_out("reaction", 0, TP,
        "ist zu beschaeftigt und reagiert nicht.",
        "ist zu beschaeftigt und reagiert nicht.");
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
