/*
  Der Daemon des Bergwerkes. Das Bergwerk ist etwas fuer mittlere Level, doch
  dieser NPC ist der einzige Anreiz fuer hohe Spieler.
  TODO:
    - 
*/
#include "../def.h"
inherit "std/npc";
inherit "/std/npc/spells";
inherit "/std/player/moneyhandler";


void create()
{

  int level, i;
  string room;
  
  if(!is_clone(TO)) return;

  ::create();

//--Vorfunktionen-----------------------------------------------------------
  
  level=35;
  room=ROOM+"arena";
  call_other(room, "???", 0);
  
  i=room->check_priests();
  { 
    switch(i)
    {
      case 1:  level=54; break;
      case 2:  level=50; break;
      case 3:  level=47; break;
      case 4:  level=43; break;
      case 5:  level=39; break;
      case 6:  level=35; break;
      default: level=55; break;
    }
  } 

//--beschreibung------------------------------------------------------------

  SetProp(P_SHORT, "Dothostyn");
  SetProp(P_LONG,
    "Dothostyn, die Plage der Welt. Wandler zwischen den Dimensionen. "
    "Vernicht des Morgens. Das furchterregende Monster vor Dir hat viele "
    "Namen, und doch weis niemand was Es ist und woher es kommt. Es sieht "
    "aus wie ein Drache doch strahlt Es eine Aura aus, die Dich erschauern "
    "laesst. da Dothostyn immer zwischen den Dimensionen wechselt, aendert "
    "sich auch staendig sein Aussehen.");
    
  AddDetail( ({"aussehen"}),
    "Die Schuppen wechseln unregelmaessig ihre Farbe und auch die Fluegel der"
    " Bestie scheinen sich staendig zu verformen.");
    
  AddDetail( ({"schuppen","schuppe", "farbe", "farben"}),
    "Die Farbe wechselt immer zwischen den Farben der Elementen und schwarz "
    "und weiss.");
    
  AddDetail( ({"elemente","schwarz", "weiss", "farbwechsel", 
               "anfaelligkeit"}),
    "Ob der Farbwechsel etwas mit der Anfaelligkeit der Bestie auf die "
    "Elemente zu tun hat?");
    
  AddDetail( ({"aura"}),
    "Du erinnerst Dich nur zu gut an die Geschichten ueber dieses Uebel.");
    
  AddDetail( ({"uebel","geschichten", "geschichte"}),
    "Wann immer in der Geschichte ein Ereignis eine ueberraschende Wendung "
    "nahm, hatte Dothostyn seine 'Finger' im Spiel. Es manipulierte das "
    "Leben seit Anbeginn der Zeit.");
    
  AddDetail( ({"leben","anbeginn", "zeit"}),
    "Natuerlich sind das nur Geschichten ...");
    
  AddDetail( ({"finger","klauen"}),
    "Die Klauen Dothostyns sind scharf und auch sie unterliegen dem "
    "Farbwechsel.");
    
  AddDetail( ({"fluegel","schwingen"}),
    "Mal die Schwingen eines Engels, dann die Fluegel einer Fledermaus oder "
    "Skelettschwingen eines untoten Vogels. Der Koerper macht Dir Angst.");
    
  AddDetail( ({"kopf", "augen", "nase", "gesicht", "blick"}),
    "Seltsam. Du kannst den Kopf nicht betrachten, so sehr Du Dich auch "
    "bemuehst, wendet irgendetwas in Dir den Blick immerwieder ab.");
    
  AddDetail( ({"koerper", "schwanz"}),
    "Dothostyn hat einen langen und schuppigen Schwanz, der langsam ueber den"
    " Boden hin und her schwingt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Dothostyn");
  SetProp(P_GENDER, NEUTER);
  AddId(({"monster", "bestie", "dothostyn", "daemon",
          "\n_dothostyn", "NOWIMPY", "NOCONTROL", "SCHUPPEN_WUSCHEL"}));
  AddClass( ({CL_DEMON, CL_FLYING, CL_NIGHTVISION }) );
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(level);

  SetProp(P_HANDS, ({" mit seinen Klauen und Fluegeln",
                    QueryProp(P_HANDS)[1]+((QueryProp(P_HANDS)[1])/2),
                    ({DT_BLUDGEON}) }) );
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 300+random(201));
  SetProp(P_WEIGHT, 750000+random(250001));
  SetProp(P_ALIGN, -1200+random(2400));
  SetProp(P_MAX_HANDS, 5); //Klauen+Fluegel+Schwanz
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 25);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" laesst sich nichts geben.\n" }) );

  SetProp(P_LOG_INFO, "dothostyn");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0,
       DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0,
       DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0,
       DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0,
       DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0,
       DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0,
       DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0,
       DT_RIP:       0.0,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " loest sich auf.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Ihr Narren, jetzt bin Ich nur noch staerker!");
  SetProp(P_KILL_NAME, "Dothostyn");
  SetProp(P_KILL_MSG, "ich habe Dich nicht zuerst angegriffen.");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 75);

 /* AddSpell(1, 0,
    ".\n",
    ".\n",
     DT_, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 1, DS_CURSE_ARMOUR,
    Name(WER,1) + " verflucht eine Deiner Ruestungen!\n",
    Name(WER,1) + " verflucht eine der Ruestungen von @WEM!\n" );*/

//--Chats------------------------------------------------------------------

  SetChats(1,
  ({Name(WER, 1)+" strahlt eine furchterregende Aura aus.\n",
    Name(WER, 1)+" schnaubt.\n"}) );

  SetAttackChats(2,
  ({Name(WER, 1)+" kaempft mit toedlicher Praezision.\n",
    "  "+Name(WER, 1)+" ***VERNICHTET*** Dich mit daemonischer Macht!!!!\n"
    "  ... das war nur eine Illusion!\n",
    Name(WER, 1)+" verwirrt Deine Sinne.\n"}) );

//--Ausruestung------------------------------------------------------------

  SUID;
  SetProp(P_TRANSPARENT, 1);
  if(QueryProp(P_LEVEL)>=55)
  {
    "/obj/gemmaster"->DistributeGem(20,10,1,1);
    "/obj/pearlmaster"->DistributePearl(20,10,1,1);
    TO->AddMoney(50000+random(50000));
  }
}

int old_enemies(object ob)
{
  if(ob->id("\n_zwergenpriester_bergwerk")) return 0;
  return 1;
}

void die(int poisondeath)
{
  object priest, ob, room, *enemies;
  int i;
  
  if(!( objectp(ENV(TO)) && file_name(ENV(TO)) ) )
  {return ::die(poisondeath);}
  
  enemies=filter_array(all_inventory(ENV(TO)), "old_enemies");
  room=ENV(TO);
  ::die(poisondeath);
  
  if(priest=present("\n_zwergenpriester_bergwerk", room))
  {
    priest->deep_remove(1);
    if(ob=clone_object(NPC+"daemon"))
    {
      tell_object(room, BS("Dothostyns Geist erhebt sich auf einmal und "
                              "faehrt ein in den Koerper "
                              +priest->name(WESSEN, 1)+"."));
      ob->move(room, M_TPORT|M_NOCHECK);
      for(i=0;i<=sizeof(enemies)-1;i++)
      { TO->Kill(enemies[i]); }
    }
  } 
  else
  { BWMASTER->Msg(""+TPN+" hat gerade DOTHOSTYN umgebracht", 2); }
  return;
}

