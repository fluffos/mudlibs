inherit "std/pub";

#include "../def.h"
#include <pub.h>

void create()
{
  ::create();



  SetProp(P_INT_SHORT, "Grenzwind");
  SetProp(P_INT_LONG,
    "Diese Speisegaststaette sieht verlassen aus. Du siehst nur einige Gaeste "
    "die in der hintersten Ecke des Lokals sitzen und eine gelangweilte "
    "Bedienung hinter der Theke. Es ist sauber, die Gaststaette ist in gutem "
    "Zustand und es riecht nach gutem Essen. Warum ist es hier nicht gerammelt "
    "voll? Eventuell belehrt Dich ein Blick auf das <menue>.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );
    SetProp(P_PUB_FLAGS, 0);

  AddDrink("Ambaiccino", ({"ambaiccino", "Ambaiccino"}), 
           210, 36, 6, 5,
           ({"Ambaiccino besteht aus einem grossen Becher heissen Cappuccino, "
             "einen doppelten Baileys und einen schuss Amaretto (fuer den "
             "Geschmack ;-)).\n Du bist erst ein wenig skeptisch, aber nach "
             "dem Du probiert hast, kommst Du auf den Geschmack und ploetzlich "
             "ist der Becher leer!\n",
             "&& trinkt voller Genuss einen Ambaiccino. Du willst auch einen!"
             "\n"}));

  AddDrink("Grenzwind - Schmugglerschnaps", ({"schnaps", "schmugglerschnaps", 
           "grenzwind"}), 
            199, 28, 10, 1,
           ({BS("Schmugglerschnaps - Verboten gut!\n"),
             "&& schmuggelt einen Schnaps nach draussen.\n"}));
  
  AddDrink("Kaibierrinhia", ({"bier", "kaibierrinhia"}), 
            179,24, 4, 4,
           ({BS("Toller Name, langweiliges Bier mit Zitronengeschmack. Wer "
           "davon noch eines trinkt ist entweder schon betrunken oder einfach "
           "nur eklig."),
             "&& kippt ein Bierchen.\n"}));
             
  AddDrink("A-Saft", ({"saft", "a-saft"}), 
            99,19, 0, 6,
           ({BS("Nein, kein Auberginen-, Apfel- oder Aprikosensaft sondern "
           "Ananassaft. Du fuehlst Dich etwas naeher an den Tropen."),
             "&& trinkt einen A-Saft.\n"}));

  AddFood("Das Tagesmenue mit Fleisch", ({"menue", "tagesmenue"}), 400, 55, 18, 
           ({BS("Du erhaellst ein komplettes Drei-Gaenge-Menue mit Tagessuppe, "
           "Tagesfleisch, Tagesbeilage und dem Tagesdessert. Welcher Tag ist "
           "heute eigentlich? *kratz*"),
             "&& bestellt sich einmal das Tagesmenue.\n"}));
  AddFood("Vegetatorium", ({"vegetatorium"}), 336, 		
  				45, 17, ({BS("Du bestellst Dir das vegetarische Menue und es gibt "
  				"alles was das gruene Herz begehert. Naja, guten Hunger."), "&& kaut "
  				"gelangweilt auf ein bisschen Gruenzeug herum.\n"}));
  
  AddDetail( ({ "speisegaststaette", "gaststaette" }),
    "Sie wirkt sehr verlassen. Du solltest vielleicht auch gehen.");
 
  AddDetail( ({ "gaeste", "gast" }),
    "Du bist der einize Gast, der nicht irgendwo im Schatten hockt.");
    
  AddDetail( ({ "schatten", "ecke" }),
    "In den Ecken des Raumes gibt es viel Schatten.");
    
  AddDetail( ({ "lokal", "raum", "grenzwind", "wind" }),
    "Wenn Du Dich richtig an das Schild am Eingang erinnerst, heisst dies Lokal"
    " 'Grenzwind'.");
    
  AddDetail( ({ "schild", "eingang" }),
    "Ueber dem Eingang hing ein Schild, darauf stand 'Grenzwind'.");
    
  AddDetail( ({ "bedienung", "theke" }),
    "Hinter der Theke steht die Bedienung. Ihr ist nur langweilig, sie selbst "
    "sieht auch eher so aus.");
    
  AddDetail( ({ "zustand", "essen" }),
    "Scheint in Ordnung zu sein.");
    
  AddDetail( ({ "ordnung" }),
    "Die Ordnung der Welt scheint hier erhalten.");
    
  AddDetail( ({ "welt" }),
    "Ausserhalb der Grenzwind.");
    
  AddDetail( ({ "blick" }),
    "Du musst nur 'menue' eintippen.");
    
  AddDetail( ({ "boden" }),
    "Unauffaellig einfach.");


  AddDetail( ({ "decke" }),
    "Sie erinnert Dich an den Boden. Ja, sieht aus wie der Boden halt nur von"
    " unten betrachtet.");

  AddDetail( ({ "waende", "wand" }),
    "Alles vorhanden, wir haben an alles gedacht.");

  AddSound( ({DEFAULT_SOUND, "kneipenlaerm", "laerm", "besonderes"}), 
    "Bis auf den ueblichen Kneipenlaerm, kannst Du nichts Besonderes "
    "hoeren.");

  AddSmell( ({DEFAULT_SMELL, "gerueche", "geruch"}), 
    "Hier treffen zuviele angenehme und unangenehme Gerueche aufeinander.");
  
  AddItem(NPC "einwohner", REFRESH_DESTRUCT);
    
  AddExit( "westen", ROOM "e4" );

}
