#include "../def.h"

inherit "std/room";

#include <properties.h>

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Strassenkreuzung");
  SetProp(P_INT_LONG,
    "Du befindest Dich auf einer Kreuzung mitten in Khorinis. Die Aussicht "
    "von hier ist wirklich praechtig. Du kannst im Norden die ganze Bucht "
    "einsehen und im Sueden die Felswaende erkennen. Im Osten fuehrt ein Weg "
    "zum Strand, und auf der anderen Seite kommst Du am Kai entlang zu einer "
    "Hafenkneipe."
    );
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );
    
  AddDetail( ({ "himmel", "wetter" }),
    "Gutes Wetter.");
    
  AddDetail( ({ "boden" }),
    "Der Boden und zugleich die Strasse besteht aus festgetrampelter Erde und "
    "Lehm.");
    
  AddDetail( ({ "strasse", "strassen" }),
    "Gut ist die Qualitaet der Strassen nicht.");
    
  AddDetail( ({ "qualitaet" }),
    "Wie sollte sie schon sein, wenn der Boden bei jedem laengeren Regenschauer"
    " aufweicht und saemtliche Fuesse und Raeder im Matsch versinken?");
    
  AddDetail( ({ "lehm", "erde" }),
    "Sehen wir den Vorteil: Viel Geld duerfte es nicht gekostet haben :-)");
    
  AddDetail( ({ "vorteil" }),
    "Nun, man kann das gesparte Geld fuer andere Sachen ausgeben oder es "
    "investieren.");
    
  AddDetail( ({ "sachen", "leben" }),
    "Schoene Sachen, die das Leben schoener machen?");
    
  AddDetail( ({ "geld" }),
    "Wertvoll.");
    
  AddDetail( ({ "kreuzung" }),
    "Hier treffen sich vier Strassen. Du kannst nach Norden, Osten, Sueden "
    "und Westen.");
    
  AddDetail( ({ "norden" }),
    "Da gehts zum Steg.");
    
  AddDetail( ({ "steg" }),
    "Von dort aus kannst Du in andere Teile des Silberlandes reisen.");
    
  AddDetail( ({ "teile" }),
    "Ob sie so interessant sind wie diese hier?");
    
  AddDetail( ({ "silberland" }),
    "Auch Du gehoerst dazu.");
    
  AddDetail( ({ "sueden" }),
    "Dort kommst Du weiter in die Stadt.");
    
  AddDetail( ({ "stadt", "khorinis" }),
    "Diese Stadt heisst Khorinis.");
    
  AddDetail( ({ "osten" }),
    "Dort gehts zum Strand.");
    
  AddDetail( ({ "strand" }),
    "Was Dich dort wohl erwartet? Du glaubst leise Musik zu hoeren.");
    
  AddDetail( ({ "musik" }),
    "Wie von einem Jahrmarkt.");
    
  AddDetail( ({ "jahrmarkt" }),
    "Ich glaube zur Zeit ist einer in der Stadt.");
    
  AddDetail( ({ "zeit" }),
    ctime());
    
  AddDetail( ({ "westen" }),
    "Dort gehts zum Kai.");
    
  AddDetail( ({ "kai" }),
    "So nennt man das Ufer in einem Hafen.");
    
  AddDetail( ({ "hafen" }),
    "Da Du Dich hier direkt an das Ufer stellen kannst, kann man das hier noch "
    "als Hafen bezeichnen.");
    
  AddDetail( ({ "ufer" }),
    "Das wurde wenigstens richtig befestigt. Aus schweren Felsbloecken wurde"
    " schon vor Jahren ein richtiger Kai gebaut.");
    
  AddDetail( ({ "felsbloecke", "bleocke", "felsblock", "block" }),
    "Sie scheinen noch viele Jahre ueberstehen zu wollen.");
    
  AddDetail( ({ "jahre", "jahren" }),
    "Du bist zuversichtlich, der Kai wird noch lange halten.");
    
  AddDetail( ({ "aussicht", "bucht" }),
    "Die Bucht ist lediglich durch eine circa 100 Meter breite Zufahrt zu "
    "erreichen. "
    "Ansonsten wird sie komplett von hohen Felswaenden umgeben, welche einen "
    "guten Schutz fuer die Stadt darstellen.");
    
  AddDetail( ({ "meter", "zufahrt" }),
    "Breit genug fuer einige Schiffe. Durch Wachtuerme auf den Klippen ist sie "
    "jedoch ausreichend geschuetzt.");
    
  AddDetail( ({ "schiffe" }),
    "Die fahren hier regelmaessig ein und aus.");
    
  AddDetail( ({ "klippen", "felswaende", "waende", "klippe", "felswand", 
                "wand" }),
    "Sie sind fast nicht zu ueberwinden. Du fragst Dich wie man dann wohl hoch "
    "zu den Wachtuermen kommt. Vermutlich gibt es da einen Tunnel.");
    
  AddDetail( ({ "tunnel" }),
    "Den wirst Du wohl kaum finden.");
    
  AddDetail( ({ "wachtuerme", "wachtuermen", "wachturm", "turm", "tuerme" }),
    "Sie sind zu weit weg um etwas Genaues zu erkennen.");
    
  AddDetail( ({ "etwas", "genaues" }),
    "Nix.");
    
  AddDetail( ({ "seite" }),
    "Westen.");
    
  AddDetail( ({ "hafenkneipe", "kneipe" }),
    "Hoffentlich typisch urig.");
    
  AddDetail( ({ "weg" }),
    "Ein Weg fuehrt Dich zum Strand.");
    
  AddDetail( ({ "raeder", "kutschen" }),
    "Kutschen haben Raeder.");
    
  AddDetail( ({ "regenschauer", "regen" }),
    "Du kennst keinen Regen?");
    
  AddDetail( ({ "schutz", "aufklaerung" }),
    "Schutz ist wichtig! (Aufklaerung hilft)");
    
  AddDetail( ({ "fuesse", "matsch" }),
    "Eklig.");
    
  AddSmell( ({DEFAULT_SMELL, "seeluft", "luft"}),
    "Du riechst die frische, salzige Seeluft.");
  
  AddSound( ({DEFAULT_SOUND, "meer", "meeres", "rauschen", "khorinis", 
              "gewaesser"}),
    "Du hoerst leise das Rauschen des Meeres. Das Gewaesser ist in Khorinis "
    "sehr ruhig. Nur noch leiser hoerst Du etwas Musik.");
  
  AddSound( ({"musik", "jahrmarkt", "markt"}),
    "Die Musik scheint von einem Jahrmarkt zu kommen.");
  
  AddItem(NPC "einwohner", REFRESH_DESTRUCT);
  AddItem(NPC "einwohner", REFRESH_DESTRUCT);
  AddItem(NPC "shalyl", REFRESH_DESTRUCT);
  
    
  AddExit( "osten",  ROOM "e2" );
  AddExit( "westen", ROOM "c2" );
  AddExit( "norden", ROOM "d1_steg" );
  AddExit( "sueden", ROOM "d3" );
}