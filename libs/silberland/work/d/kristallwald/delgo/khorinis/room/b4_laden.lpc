#include "../def.h"

inherit "std/laden";
#include <laden.h>
#include <properties.h>

void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));

  SetProp(P_INT_SHORT,"In einem Ruestungsladen.");
  //SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetStorageRoom(ROOM "lager" );
  SetProp(P_INT_SHORT, "An- und Verkauf Khorinis");
  SetProp(P_INT_LONG,
    "Aus einem kleinen Fenster blickt Dich ein gelangweilter Verkaeufer an, "
    "scheinbar ist in der Stadt wirklich nicht viel los. Durch das kleine "
    "Fenster scheint man mit ihm handeln zu koennen. Wie es aussieht befindet "
    "sich hinter dem Fenster das Lager des Ladens."
    );
    
  AddDetail( ({ "decke", "boden", "staub" }),
    "Einige Bretter dienen als Decke sowie als Boden.");
    
  AddDetail( ({ "bretter", "brett" }),
    "Lass lieber die Finger davon, sehen wacklig aus.");
    
  AddDetail( ({ "finger", "spielekind", "kind" }),
    "Sowas wie Dich nennt man ein Spielekind. Das kann seine Finger einfach "
    "nicht stillhalten.");
    
  AddDetail( ({ "fenster" }),
    "Besonders gross ist es nicht, aber die ueblichen Waren duerften "
    "durchpassen.");
    
  AddDetail( ({ "waren", "ware" }),
    "Die kannst Du Dir mit 'zeige' anzeigen lassen.");
    
  AddDetail( ({ "verkaeufer" }),
    "Der Einwohner Khorinis' hinter dem Fenster.");
    
  AddDetail( ({ "khorinis", "stadt" }),
    "Diese Stadt heisst Khorinis.");
    
  AddDetail( ({ "laden", "raum" }),
    "Begeistert bist Du hiervon nicht, aber Du sollst ja auch nicht hier "
    "einziehen.");
    
  AddDetail( ({ "waende", "wand" }),
    "Du entdeckst eine kleine Tuer.");
    
  AddDetail( ({ "tuer" }),
    "Sie scheint zu dem Verkaeufer und ins Lager zu fuehren.");
    
  AddDetail( ({ "lager" }),
    "Da kommst Du nicht rein.");
    
  AddDetail( ({ "einwohner" }),
    "Wo soll er sonst herkommen?");

  AddSound( ({DEFAULT_SOUND, "ruhe"}), 
    "Hier ist absolute Ruhe.");

  AddSmell( ({DEFAULT_SMELL, "staub", "luft"}), 
    "Du Luft hier ist recht staubig.");

  AddExit( "osten", ROOM "c4" );

}
