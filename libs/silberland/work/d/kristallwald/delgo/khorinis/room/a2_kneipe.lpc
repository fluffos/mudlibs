inherit "std/pub";

#include "../def.h"
#include <pub.h>

void create()
{
  ::create();


  SetProp(P_INT_SHORT, "'Zur Hafenkneipe'");
  SetProp(P_INT_LONG,
    "Du befindst Dich in der Hafenkneipe 'Zur Hafenkneipe'. Nachdem Du den "
    "Namen der Kneipe verstanden hast, beschliesst Du Dich zu setzen und Dir "
    "was zu bestellen. Dummerweise weisst Du nicht was, denn Du siehst "
    "nirgends eine Speisekarte. Vielleicht kannst Du die scheinbar aeusserst "
    "scheuen Bedienungen nach <menue> fragen, wenn sie gerade mal wieder an "
    "Dir vorbei flitzen. Ansonsten tummeln sich hier nur einige Einwohner "
    "und zwielichtige Gestalten.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_PUB_FLAGS, 0);

  AddDrink("Bier", ({"bier"}), 
           199, 25, 6, 4,
           ({"Eine Kellnerin bring dir einen Becher Bier.\n",
             "&& trinkt einen Becher Bier.\n"}));

  AddDrink("Inselschnaps", ({"inselschnaps", "schnaps"}), 
            219, 28, 9, 1,
           ({BS("Auf Ex kippst Du einen Inselschnapss herunter...!\nDeine "
             "Augen brennen zwar leicht und Rauch steigt aus deinen Ohren, "
             "aber geschmeckt hats allemal!\n"),
             "&& kippt einen Inselschnaps auf Ex.\n"}));
  
  AddDrink("Kinderbier", ({"kinderbier"}), 
            189,21, 0, 5,
           ({BS("Das Kinderbier stellt sich als Apfelschorle heraus. Du magst "
             "gar nicht dran denken wie man hier schon die Kinder an das "
             "Bier heranfuehrt.\n"),
             "&& trinkt ein Kinderbier *hihi*. && vertraegt halt nichts.\n"}));

  AddFood("Fleisch", ({"fleisch"}), 400, 55, 18, 
           ({BS("Du bestellst 'Fleisch'! Und was der aeusserst originelle Name "
             "verspricht das haelt er auch. Sie sollten dieses Gericht "
             "lediglich 'viel gebratenes Fleisch' nennen, ansonsten schmeckt "
             "es eigentlich ganz gut."),
             "&& verspeist riesige Mengen an Fleisch.\n"}));
  AddFood("Forelle 'Piraten Art'", ({"forelle"}), 555, 		
  				75, 28, ({BS("Die Forelle ist wirklich lecker, und die Pommes (in "
  				          "Form einer gefesselten Muellerin) als Beilage runden die "
  				          "Mahlzeit ab."), "&& verschlingt eine Forelle.\n"}));

  AddDetail( ({ "menue", "speisekarte", "karte" }),
    "Tippe einfach 'menue' ein.");
    
  AddDetail( ({ "waende", "wand" }),
    "Die Waende sind vollkommen schmucklos. Keine Bilder, keine Teppiche oder "
    "etwas Vergleichbares. Scheinbar ist die Kneipe hier wirklich nur auf ihren"
    " Betrieb ausgelegt.");
    
  AddDetail( ({ "decke" }),
    "Eine stinknormale Holzdecke.");
    
  AddDetail( ({ "holzdecke", "holz" }),
    "Das Holz hat ein paar Kerben.");
    
  AddDetail( ({ "kerben" }),
    "Du magst sie nicht zaehlen.");
    
  AddDetail( ({ "boden" }),
    "Ein Holzparkett wurde ausgelegt, damit es hier nicht so kalt ist.");
    
  AddDetail( ({ "holzparkett", "parkett" }),
    "Unsauber verarbeitet schauen hier und da noch ein paar Splitter hervor.");
    
  AddDetail( ({ "splitter" }),
    "Du beschliesst sie dort zu lassen.");
    
  AddDetail( ({ "bilder", "teppiche" }),
    "Wozu brauch man das auch?");
    
  AddDetail( ({ "vergleichbares" }),
    "Kalender?");
    
  AddDetail( ({ "kalender" }),
    "Naja, wenn man jeden Tag den selben Ablauf hat ist es doch egal welcher "
    "Tag heute ist oder? Das einzig interessante waeren ein paar typische "
    "Kalenderbildchen.");
    
  AddDetail( ({ "ablauf", "tag" }),
    "Wie die Bedienungen hier, jeden Tag das selbe machen. Schreckliche "
    "Vorstellung.");
    
  AddDetail( ({ "vorstellung" }),
    "Wer nichts wird, wird Wirt!");
    
  AddDetail( ({ "wirt" }),
    "Der is nich da.");
    
  AddDetail( ({ "kalenderbildchen", "bildchen" }),
    "Mit aufregenden Motiven.");
    
  AddDetail( ({ "motiven", "motive" }),
    "Landschaftsformen natuerlich.");
    
  AddDetail( ({ "landschaftsformen", "formen", "landschaft" }),
    "Faszinierend schoen.");
    
  AddDetail( ({ "kneipe", "hafenkneipe" }),
    "Der Name ist aeusserst treffend gewaehlt. Du musst schmunzeln.");
    
  AddDetail( ({ "name" }),
    "Zur Hafenkneipe.");
    
  AddDetail( ({ "stadt", "hafenstadt", "khorinis" }),
    "Dioese Stadt heisst Khorinis.");
    
  AddDetail( ({ "betrieb" }),
    "Servieren und Kassieren.");
    
  AddDetail( ({ "servieren", "kassieren" }),
    "Tag ein, Tag aus.");
    
  AddDetail( ({ "bedienung", "bedienungen" }),
    "Ab und an laeuft mal ein 'Kellner' an Dir vorbei, doch wuerdest Du sie "
    "nicht ansprechen, koenntest Du hier glatt verhungern.");
    
  AddDetail( ({ "kellner" }),
    "Sie sind nicht fein angezogen, rasieren sich nicht und haben kaum "
    "Manieren. Aber sie bedienen Dich, also sind sie Kellner.");
    
  AddDetail( ({ "manieren" }),
    "Die Speisen nicht mit dem Daumen auf dem Teller festhalten waere ein "
    "grosser Fortschritt im Verhalten der Kellner.");
    
  AddDetail( ({ "speisen" }),
    "<menue>");
    
  AddDetail( ({ "daumen" }),
    "Schon eklig.");
    
  AddDetail( ({ "fortschritt", "verhalten" }),
    "Aber was soll man in einer Hafenkneipe schon erwarten?");
    
  AddDetail( ({ "teller", "o" }),
    "Du denkst . o O (Wenigstens haben sie welche, und benutzen sie auch!)");
    
  AddDetail( ({ "dummerweise" }),
    "Dumm gelaufen!");
    
  AddDetail( ({ "einwohner" }),
    "Sie wollen nur in Ruhe essen.");
    
  AddDetail( ({ "ruhe" }),
    "In Ruhe!");
    
  AddDetail( ({ "gestalten" }),
    "Du schaust Dich um. Bist Du auch eine?");
    
  AddDetail( ({ "zur", "wenigstens", "fenster" }),
    "Es gibt hier Fenster.");
    
  AddSound( ({DEFAULT_SOUND, "kneipenlaerm", "laerm", "besonderes"}), 
    "Bis auf den ueblichen Kneipenlaerm, kannst Du nichts Besonderes "
    "hoeren.");

  AddSmell( ({DEFAULT_SMELL, "gerueche", "geruch"}), 
    "Hier treffen zuviele angenehme und unangenehme Gerueche aufeinander.");
    
  AddItem(NPC "einwohner", REFRESH_DESTRUCT);
  AddItem(NPC "einwohner", REFRESH_DESTRUCT);

  AddExit( "osten", ROOM "b2" );

}
