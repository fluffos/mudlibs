#include "../def.h"

inherit "std/room";

#include <properties.h>

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Der Hafen von Khorinis");
  SetProp(P_INT_LONG,
    "Da bist Du nun endlich, am Hafen von Khorinis. Du stehst auf einem "
    "relativ breiten Anlegesteg mit zwei kleinen Pfloecken. Im Norden kannst "
    "Du die ganze Bucht einsehen und im Sueden erwartet Dich die Stadt "
    "Khorinis, von der Du schon viel gehoert hast. Natuerlich steht hier "
    "auch ein Schild.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );
    
  AddDetail( ({ "himmel" }),
    "Klares Wetter.");
    
  AddDetail( ({ "wetter" }),
    "Nichts koennte es trueben, nichtmal deine Stimmung.");
    
  AddDetail( ({ "stimmung" }),
    "Du stehst am Rande einer neuen Welt, deine Stimmung sollte grossartig "
    "sein.");
    
  AddDetail( ({ "rande", "rand" }),
    "Das hier ist nur der Anfang, es gibt noch viel zu entdecken!");
    
  AddDetail( ({ "anfang" }),
    "Leg schon los!");
    
  AddDetail( ({ "welt" }),
    "Also zumindest ist diese Stadt neu fuer Dich und somit neue Welt, wenn "
    "Du hier vorher noch nie warst. Solltest Du hier schon gewesen sein, ist "
    "es nichtmehr sooooo spannend fuer Dich.");
    
  AddDetail( ({ "stadt", "khorinis" }),
    "Wenn Du dir diese 'Stadt' genau anschaust, merkst Du langsam, dass die "
    "Erzaehlungen darueber mal wieder einem bekannten Phaenomen zum Opfer "
    "gefallen sind.");
    
  AddDetail( ({ "erzaehlungen", "erzaehlung" }),
    "Du erinnerst Dich an die Worte des betrunkenen Seefahrers.");
    
  AddDetail( ({ "seefahrer", "fahrer", "fahrers", "seefahrers" }),
    "Wenn sie an Land sind, sind sie in einer Kneipe, und dann sind sie "
    "betrunken.");
    
  AddDetail( ({ "land" }),
    "Nicht auf dem Schiff.");
    
  AddDetail( ({ "schiff" }),
    "Nicht an Land.");
    
  AddDetail( ({ "kneipe", "institutionen", "institution" }),
    "Abends auch in anderen Institutionen mit spezieller Speisekarte.");
    
  AddDetail( ({ "speisekarte", "karte" }),
    "Du spuerst das Jugendschutzgesetz greifen.\n"
    "Jemand jammert in der Ferne.");
    
  AddDetail( ({ "worte" }),
    "Praechtige Haeuser, gut ausgebaute Strassen und ein wahnsinss "
    "Stadtklima. Einfach nur beeindruckend!");
    
  AddDetail( ({ "opfer" }),
    "Nekromant am Werk?");
    
  AddDetail( ({ "werk", "nekro", "nekromant", "nekromanten", "nekros" }),
    "Hier nicht, aber irgendwie musst Du an eine Faehre denken.");
    
  AddDetail( ({ "faehre" }),
    "Nicht da.");
    
  AddDetail( ({ "phaenomen" }),
    "Das Phaenomen der masslosen Uebertreibung bei Ueberlieferungen.");
    
  AddDetail( ({ "ueberliefeurngen", "ueberlieferung" }),
    "Wenn Geschichten oft weitererzaehlt werden, werden sie vom aktuelle "
    "Erzaehler immer noch etwas ausgebaut. Es entstehen richtige Mythen.");
    
  AddDetail( ({ "geschichten", "geschichte", "mythen", "mythos", "erzaehler" }),
    "So wird aus einem schwer besiegten Fraggle ein gigantischer Todespudel.");
    
  AddDetail( ({ "fraggle", "todespudel", "beispiel" }),
    "Das war nur ein Beispiel, sowas gibt es ja gar nicht.");
    
  AddDetail( ({ "uebertreibung" }),
    "Khorinis ist nicht ansatzweise so beeindruckend wie Du gedacht hast. Diese"
    " Ansammlung von Bretterhuetten und Lehmbrocken als Stadt zu bezeichnen ist"
    " wahrlich frech.");
    
  AddDetail( ({ "ansammlung", "recht", "stadtrecht", "dorf" }),
    "Wohl eher ein Dorf. Ein Dorf mit Stadtrecht.");
    
  AddDetail( ({ "bretterhuetten", "huetten", "lehmbrocken", "borcken", 
                "huette", "bretterhuette" }),
    "Geh naeher ran und ueberzeuge Dich.");
    
  AddDetail( ({ "boden" }),
    "Ein Holzsteg.");
    
  AddDetail( ({ "holzsteg", "anlegesteg", "steg", "holz" }),
    "Einfach aus Holz gezimmert.");
    
  AddDetail( ({ "pfloecke", "pflock", "pfloecken" }),
    "An solchen Pfloecken werden die Schiffe festgemacht.");
    
  AddDetail( ({ "schiffe" }),
    "Lies das Schild.");
    
  AddDetail( ({ "schild" }),
    "Lies es.");
    
  AddDetail( ({ "norden" }),
    "Nicht Sueden.");
    
  AddDetail( ({ "sueden" }),
    "Nicht Norden.");
    
  AddDetail( ({ "ferne", "bucht", "meer" }),
    "Die Bucht ist wirklich schoen, im Sueden kannst Du sie besser "
    "betrachten.");
    
  AddDetail( ({ "haeuser", "strassen", "haus", "strasse",
                "stadtklima", "jugendschutzgesetz", "schutzgesetz", "gesetz" }),
    "Schau's Dir an!");
    
  AddReadDetail( ({ "schild" }),
    "\n\t --------------------\n"
    "\t| Wir fahren fuer    |\n"
    "\t| sie taeglich nach: |\n"
    "\t| Kuestensegler:     |\n"
    "\t|   Derlim           |\n"
    "\t| Faehre:            |\n"
    "\t|   Todesinsel       |\n"
    "\t --------------------\n"
    );
    
  AddDetail( ({ "hafen" }),
    "'Hafen' ist recht hochgegriffen fuer einen Steg, aber was solls :-)");
    
  AddSmell( ({DEFAULT_SMELL, "seeluft", "luft"}),
    "Du riechst die frische, salzige Seeluft.");
  
  AddSound( ({DEFAULT_SOUND, "meer", "meeres", "rauschen", "khorinis", 
              "gewaesser"}),
    "Du hoerst leise das Rauschen des Meeres. Das Gewaesser ist in Khorinis "
    "sehr ruhig.");
    
  AddExit( "sueden", ROOM "d2" );
  
  AddItem(NPC "einwohner", REFRESH_DESTRUCT);
  
  call_other( FAEHRE, "refresh", 0);

}

void refresh()
{
  //leerlauf
}