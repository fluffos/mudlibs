#include "../def.h"

inherit "std/room";

#include <properties.h>

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Kai");
  SetProp(P_INT_LONG,
    "Die Strasse endet hier und Du stehst vor zwei groesseren Gebaeuden. Aus "
    "dem Gebaeude im Westen ist Groehlen zu hoeren und Du kannst Essen "
    "riechen. Das scheint die Hafenkneipe zu sein. Aus dem Gebaeude im Sueden "
    "riechst Du Parfuem. Was das wohl ist?");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "himmel", "wetter" }),
    "Gutes Wetter.");
    
  AddDetail( ({ "boden" }),
    "Festgetrampelte Erde.");
    
  AddDetail( ({ "erde" }),
    "Und Lehm natuerlich.");
    
  AddDetail( ({ "lehm" }),
    "Das sollen hier die Strassen sein, naja. Du hast zum Glueck nix auf "
    "Raedern.");
    
  AddDetail( ({ "strassen", "strasse" }),
    "Im Moment gut begehbar.");
    
  AddDetail( ({ "moment" }),
    "Jetzt.");
    
  AddDetail( ({ "glueck" }),
    "Ob man es Glueck nennen kann? Immerhin kannst Du Dir nur keine Kutsche "
    "leisten.");
    
  AddDetail( ({ "kutsche" }),
    "Hehe, Du armer Schlucker.");
    
  AddDetail( ({ "schlucker" }),
    "Ich wuerde ja fast Mitleid empfinden ...");
    
  AddDetail( ({ "mitleid" }),
    "... aber es ist mir egal. ;-)");
    
  AddDetail( ({ "raedern", "rader", "rad", "raeder" }),
    "Sowas siehst Du hier nirgends!");
    
  AddDetail( ({ "kai" }),
    "Er liegt ruhig vor Dir.");
    
  AddDetail( ({ "hafenkneipe", "kneipe" }),
    "Die Kneipe macht von aussen einen recht soliden Eindruck. Schwingtueren "
    "gewaehren Dir ab und an einen Einblick ins Innere.");
    
  AddDetail( ({ "eindruck" }),
    "Du kannst jedenfalls beruhigt reingehen. Wenn Du mit der Tuer knallst, "
    "wird das Haus nicht zusammenfallen.");
    
  AddDetail( ({ "haus" }),
    "Aus Steinen gebaut, mit einem massiven Holzdach noch eines der besten "
    "Haeuser der Stadt.");
    
  AddDetail( ({ "steine", "stein" }),
    "Kennst Du.");
    
  AddDetail( ({ "holzdach", "dach" }),
    "Es scheint von hier aus gesehen sogar dicht zu sein.");
    
  AddDetail( ({ "haeuser" }),
    "Die meissten sind in einem miesen Zustand.");
    
  AddDetail( ({ "zustand" }),
    "Sieh es Dir besser selber an.");
    
  AddDetail( ({ "stadt", "hafenstadt", "khorinis" }),
    "Die Stadt heist Khorinis.");
    
  AddDetail( ({ "tuer", "schwingtuer" }),
    "Wie willst Du bitte mit einer Schwingtuer knallen?");
    
  AddDetail( ({ "schwingtueren", "tueren" }),
    "Sie oeffnen sich immer wenn jemand die Kneipe verlaesst oder betritt.");
    
  AddDetail( ({ "jemand", "gaeste" }),
    "Gaeste.");
    
  AddDetail( ({ "innere", "einblick", "inneres" }),
    "Sieht ganz annehmbar aus, geh rein.");
    
  AddDetail( ({ "essen", "groehlen" }),
    "Gehoert das nicht zu einer Kneipe?");
    
  AddDetail( ({ "gebaeuden", "gebaeude" }),
    "Das Gebaeude im Sueden gibt Dir Raetsel auf.");
    
  AddDetail( ({ "raetsel" }),
    "Was ist das nur?");
    
  AddDetail( ({ "parfuem", "parfuemgeruch" }),
    "Der Parfuemgeruch stroemt aus einem offenen Fenster auf die Strasse.");
    
  AddDetail( ({ "fenster" }),
    "Haengt davor eine Laterne?");
    
  AddDetail( ({ "laterne" }),
    "Sie ist Rot.");
    
  AddDetail( ({ "rot" }),
    "Du denkst . o O (rote Laterne, woher kenne ich das nur? Wie hiess das "
    "Wort doch gleich?)");
    
  AddDetail( ({ "wort" }),
    "Natuerlich, das ist ein Bordell!");
    
  AddDetail( ({ "bordell", "o" }),
    "Sowas muss es in einer richtigen Hafenstadt schliesslich auch geben! Aber "
    "fuer Dich ist das nichts. Du bist zu anstaendig.");

  AddSmell( ({DEFAULT_SMELL, "parfuem", "geruch", "luft"}), 
    "Parfuemgeruch liegt in der Luft. Aus dem Westen riechst Du Essen.");
  
  AddSound( ({DEFAULT_SOUND, "groehlen"}), "Im Westen hoerst Du Groehlen.");
    
  AddItem(NPC "miliz", REFRESH_DESTRUCT);  

  AddExit( "osten", ROOM "c2" );
  AddExit( "westen", ROOM "a2_kneipe" );

}