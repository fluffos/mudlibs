#include "../def.h"

inherit "std/room";

#include <properties.h>

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Strasse in Khorinis");
  SetProp(P_INT_LONG,
    "Du bist auf einer der Strassen in Khorinis. Zwischen alten Haeusern, "
    "noch aelteren Strassen und noch viel aelterer Luft spazierst Du laessig "
    "durch die heruntergekommenen Hafenstadt. Es ist teilweise so alt und "
    "staubig, dass Du Dich gar nicht naeher umsehen willst. Du bist Dir auch "
    "sicher das es hier nichts Interessantes gibt. Du stehst an einer "
    "Kreuzung.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );


  AddDetail( ({ "himmel", "wetter" }),
    "Gutes Wetter.");
    
  AddDetail( ({ "boden", "lehm" }),
    "Festgetrampelter Lehm dient hier als Strasse.");
    
  AddDetail( ({ "strasse", "strassen" }),
    "Ein Schande fuer alle anderen Strassen im schoenen Silberland.");
    
  AddDetail( ({ "silberland", "land", "leben" }),
    "Du verbringst ein schoenes Leben im Silberland hoffe ich?");

  AddDetail( ({ "khorinis", "stadt", "hafenstadt" }),
    "Diese Stadt heisst Khorinis.");
    
  AddDetail( ({ "haeuser", "haus" }),
    "Alt und baufaellig. Du gehst lieber in keines rein.");
    
  AddDetail( ({ "luft" }),
    "Zumindest erscheint Dir die Luft so alt.");
    
  AddDetail( ({ "interessantes" }),
    "Selbst wenn, waere es vermutlich aelter als Du und wuerde zerfallen.");
    
    
  AddDetail( ({ "schande" }),
    "Im Vergleich zu Midas, sind die Strassen dort ja aus purem Gold.");
    
  AddDetail( ({ "midas" }),
    "Hauptstadt des Silberlandes.");
    
  AddDetail( ({ "hauptstadt", "zentrum", "kultur", "handel" }),
    "Das Zentrum von Kultur und Handel ist Midas.");

  AddDetail( ({ "gold" }),
    "Haettest du gerne, oder?");

  AddDetail( ({ "kreuzung" }),
    "Wohin sollst Du nur gehen?");
    
  AddSmell( ({DEFAULT_SMELL, "seeluft", "luft"}),
    "Du riechst die frische, salzige Seeluft.");
  
  AddSound( ({DEFAULT_SOUND, "meer", "meeres", "rauschen", "khorinis", 
              "gewaesser"}),
    "Du hoerst leise das Rauschen des Meeres. Das Gewaesser ist in Khorinis "
    "sehr ruhig.");
  
  AddItem(NPC "einwohner", REFRESH_DESTRUCT);
  AddItem(NPC "miliz", REFRESH_DESTRUCT);
    
  AddExit( "osten",  ROOM "e4" );
  AddExit( "westen", ROOM "c4" );
  AddExit( "norden", ROOM "d3" );
  AddExit( "sueden", ROOM "d5" );

}