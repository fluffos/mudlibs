#include "../def.h"

inherit "std/room";

#include <properties.h>

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Kai");
  SetProp(P_INT_LONG,
    "Du stehst direkt am Kai vom Hafen in Khorinis. Vor Dir das salzige Meer"
    "wasser und hinter Dir einige Haeuser. So wie man sich einen typischen "
    "Stadthafen vorstellt. Du geniesst die gute Luft und freust Dich einfach "
    "Deines Lebens.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "himmel", "wetter" }),
    "Gutes Wetter.");
    
  AddDetail( ({ "boden" }),
    "Festgetrampelter Lehm und viel Erde.");
    
  AddDetail( ({ "erde", "lehm" }),
    "Das ersetzt hier die Strassen.");
    
  AddDetail( ({ "strassen", "strasse" }),
    "Fuer Dich sind sie ausreichend, bleib bei Regen nur nicht zu "
    "lange an einem Fleck stehen. Hier wird die Strasse sandiger.");
    
  AddDetail( ({ "sand" }),
    "Du blickst Richtung Osten und siehst wie die Strasse dort endet.");
    
  AddDetail( ({ "richtung", "osten" }),
    "Du schaust genau hin und stellst fest, dass ein Sandweg weiterfuehrt.");
    
  AddDetail( ({ "sandweg", "weg" }),
    "Er fuehrt zum Strand.");
    
  AddDetail( ({ "strand", "zirkusgnom", "gnom" }),
    "Ein Zirkusgnom haelt Dich auf. Bald kannst Du hingehen.");
     
  AddDetail( ({ "regen" }),
    "Keine Angst. 'unt himmel'");
    
  AddDetail( ({ "angst" }),
    "Du doch nicht!");
    
  AddDetail( ({ "fleck" }),
    "Sonst versinkst Du noch drin.");
    
  AddDetail( ({ "kai", "stadthafen" }),
    "Die Luft, die Atmosphaere und die Aussicht. Alles passt wunderbar "
    "zu einem Bild zusammen.");
    
  AddDetail( ({ "luft" }),
    "Diese Luft ist typisch bei derartiger Meeresnaehe.");
    
  AddDetail( ({ "meeresnaehe", "naehe" }),
    "Du bist wirklich nah dran.");
    
  AddDetail( ({ "atmosphaere" }),
    "Woher weist Du eigentlich wie die Atmosphaere in einer Hafenstadt sein "
    "muss?");
    
  AddDetail( ({ "hafenstadt", "stadt", "khorinis" }),
    "Diese Stadt heisst Khorinis.");
    
  AddDetail( ({ "bild" }),
    "Das Bild einer Hafenstadt.");
    
  AddDetail( ({ "meer", "meerwasser" }),
    "Da ist mehr drin.");
    
  AddDetail( ({ "leben" }),
    "Freu Dich immer wenn Du noch eines hast.");
    
  AddDetail( ({ "hafen" }),
    "Der Hafen hier gefaellt Dir.");
    
  AddDetail( ({ "aussicht" }),
    "Du wuerdest Dir am liebsten ein Bild davon malen lassen.");
    
  AddDetail( ({ "haeuser", "haus" }),
    "Die Haeuser sehen nicht ganz so schoen aus. Aber immernoch besser als "
    "in der Stadtmitte. Immerhin sind die Haeuser hier noch aus Stein und "
    "haben ein intaktes Dach.");
    
  AddDetail( ({ "stadtmitte", "stadtmitte" }),
    "Dort sind die Haeuser nicht so stabil wie hier.");
    
  AddDetail( ({ "stein", "dach" }),
    "Nicht jedes Haus in der Stadtmitte kann das aufweisen.");

  AddSmell( ({DEFAULT_SMELL, "seeluft", "luft"}),
    "Du riechst die frische, salzige Seeluft.");
  
  AddSound( ({DEFAULT_SOUND, "meer", "meeres", "rauschen", "khorinis", 
              "gewaesser"}),
    "Du hoerst leise das Rauschen des Meeres. Das Gewaesser ist in Khorinis "
    "sehr ruhig.");
    
  //AddExit( "osten", KHORINIS_JAHRMARKT );
  AddExit( "westen", ROOM "e2" );

}