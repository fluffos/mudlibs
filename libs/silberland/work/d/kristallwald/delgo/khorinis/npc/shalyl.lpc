#include "../def.h"
//#include "/p/std/npc/berserker_npc.h"

//inherit "std/npc";
inherit "/p/std/npc/berserker_npc.lpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Trollberserkerin Shalyl");
  SetProp(P_LONG,
    "Die riesige Trollfrau wurde vor vielen Jahren hier geboren. Nach ihrer "
    "Ausbildung bei Kronang suchte sie in den fernen Bergen das Exil. Sie kam "
    "hierher zurueck und stellte eine Miliz auf um ihre ehemalige Heimat vor "
    "dem Piratenpack zu beschuetzen. Zugleich bietet solch eine Miliz "
    "natuerlich auch guten Schutz vor ihren Verfolgern vor dem Exil.");
  SetProp(P_NAME, "Shalyl");
  SetProp(P_GENDER, FEMALE);
  AddId(({"shalyl", "berserkerin", "trollfrau", "Axtmeister"}));
  SetProp(P_ARTICLE, 0);
  create_default_berserker(44,7);

  SetProp(P_HANDS, ({" mit ihren Faeusten",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Troll");
  SetProp(P_SIZE, 315);
  SetProp(P_WEIGHT, 225000);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 20);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp(P_MSGIN, "trollt an");
  SetProp(P_MSGOUT, "trollt");
  SetProp(P_MMSGIN, "ist da");
  SetProp(P_MMSGOUT, "vertrollt sich");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Shalyl");
  SetProp(P_KILL_MSG, "Mich besiegst Du nicht!");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.3, DT_COLD:      -0.2, DT_WATER:        0.1,
       DT_ACID:      0.3, DT_POISON:     0.2,  DT_MAGIC:       0.2,
       DT_MIND:      0.0, DT_SLASH:     -0.4, DT_BLUDGEON:    -0.3,
       DT_PIERCE:    0.1, DT_SQUEEZE:   -0.1, DT_WHIP:        -0.2,
       DT_RIP:       0.1]) );

  AddDetail( ({"haare","frisur"}),
    "Die grauen Haare sind gut gepflegt und reichen bis zur Schulter.");

  AddDetail( ({"ohren","ohr"}),
    "Die Ohren sind durch die Haare verdeckt.");
  
  AddDetail( ({"nase"}),
    "Die trollige Nase ist nicht sonderlich auffaelig.");
    
  AddDetail( ({"gesicht"}),
    "Es ist recht huebsch anzusehen. Fuer eine Trollfrau.");
        
  AddDetail( ({"augen","auge", "pupillen"}),
    "Die Augen sind steingrau und schauen dich fragend an.");
    
  AddDetail( ({"haut", "fell"}),
    "Die 'Haut' ist eher ein Fell. Gut entfalmmbar..");
    
  AddDetail( ({"lippen", "mund", "lippe"}),
    "'Den zum Kuessen sind sie da... ' Das glaubst du nicht!");
    
  AddDetail( ({"koerper"}),
    "Die Trollfrau ist sehr muskuloes, sie ist nicht umsonst die Anfuehrerin "
    "der Miliz.");
    
  AddDetail( ({"kleidung"}),
    "Dir faellt da nichts auf.");
  
  AddInfo(DEFAULT_INFO, 
    ({"hat Dich gar nicht gehoert.\n",
      "zuckt unwissend mit den Schultern.\n" }) );
  AddInfo("delgo", "Den Namen habe ich schonmal gehoert.","sagt: ");
  
  AddInfo( ({"arbeit"}) , "Ich bin fuer die Verteidigung der Stadt "
     "zusatendig." ,"sagt: ");
    
  AddInfo( ({"leben","alter"}) ,"Das geht dich nichts an ;-)"
    ,"kichert: ");
    
  AddInfo( ({"umgebung","stadt"}) , "ich wohne hier, aber ich verrate Dir "
    "nicht wo." ,"sagt: ");
    
  AddInfo( ({"gebiet","hilfe"}) , "Du bist hier in Khorinis."
    ,"sagt: ");

  SetProp(P_SPELLRATE, 45);

  SetAttackChats(10,
  ({Name(WER, 1)+" bleibt eine konzentrierte Soldatin!\n",
    Name(WER, 1)+" laesst sich nicht aus der Ruhe bringen.\n",
   }) );

  SUID;
  CLONEME(WEAPON "trollfaust" );
  command("zuecke axt");

  CLONEME("/p/armour/armour/titanpanzer" );
  command("trage alles");
}

int _query_wimpy() {return 0;}

void die(int poisondeath)
{
  write_file(LOG "shalyl",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || 
      "<Unbekannt>") + " killt " + name(WEN, 1) + ".\n");
  KORMASTER->Msg(""+TPN+" hat gerade Shalyl umgebracht", 2);
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "shalyl",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}


void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "blickt Dich missmutig an",
        "blickt @WEN missmutig an");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "knurrt",
        "knurrt");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "ist zu ernst zum Lachen",
        "ist zu ernst zum Lachen");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "tritt Dich",
        "tritt @WEN");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "knurrt",
        "knurrt");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "grinst",
        "grinst");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "tritt Dich weg",
        "tritt @WEN weg");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "laechelt. Du bekommst Angst",
        "laechelt");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "knurrt",
        "knurrt");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "versucht Dich zu ignorieren",
        "schaut weg");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher+"."));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere+"."), ({pl}) );
}
