#include "../def.h"

inherit "/std/mnpc";
inherit "/std/npc/spells";

void create()
{
  
  if (!is_clone(this_object())) return;
  ::create();


  SetProp(P_SHORT, "Ein Milizsoldat");
  SetProp(P_LONG, 
    "Diese Miliz wurde von Shalyl ausgebildet, die Berserkerin die hier vor "
    "langer Zeit geboren wurde und es sich zur Aufgabe gemacht hat ihre "
    "Heimat zu beschuetzen. Es sind zwar nur Milizen, aber sie werden bis "
    "zum Tode kaempfen wenn es sein muss."
    );
  SetProp(P_NAME, "Milizsoldat");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  AddId( ({"milizsoldat", "soldat", "miliz", "NOWIMPY"}) );
  create_default_npc(23);
  SetProp(P_HANDS, ({" mit blossen Haenden ",QueryProp(P_HANDS)[1],
                     DT_BLUDGEON}));
  SetProp(P_ALIGN, -200 - random(500) );
  SetProp(P_RACE, "Mensch");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_WEIGHT, 78000);
  SetProp(P_SIZE, 180);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC, 30);
  SetProp(P_REJECT, ({ REJECT_DROP,
    "Der Soldat laesst sich nicht von Dir ablenken.\n" }) );
  SetProp(P_MSGIN, "marschiert heran");
  SetProp(P_MSGOUT, "marschiert");
  SetProp(P_MMSGIN, "marschiert herein");
  SetProp(P_MMSGOUT, "marschiert woanders hin");
  SetProp(P_DIE_MSG,  " stuerzt mit einem Schmerzensschrei zu Boden.\n");
  AddDetail( ({"haare","frisur"}),
    "Die Haare sind kurz und blond.");

  AddDetail( ({"ohren","ohr"}),
    "Er lauscht nebenbei mit seinen Ohren in alle Richtungen.");
  
  AddDetail( ({"nase"}),
    "Dir faellt an der Nase nichts auf.");
    
  AddDetail( ({"gesicht"}),
    "Das Gesicht hat schon einiges miterlebt.");
        
  AddDetail( ({"augen","auge", "pupillen"}),
    "Die Augen ueberwachen aufmerksam die Umgebung.");
    
  AddDetail( ({"haut"}),
    "Die Haut ist braungebrannt, er hat scheinbar viel Dienst draussen.");
    
  AddDetail( ({"lippen", "mund", "lippe"}),
    "Der Mann murmelt leise vor sich hin.");
    
  AddDetail( ({"koerper"}),
    "Der Mann haelt sich fit, wie Du an dem durchtrainierten Koerper "
    "siehst.");
    
  AddDetail( ({"kleidung"}),
    "Die Unterkleidung waermt den Mann, bei seinem Dienst.");
    
  AddInfo(DEFAULT_INFO, 
    ({"weiss leider keine Antwort.\n",
      "kann Dir da nicht weiterhelfen.\n" }) );
  AddInfo("delgo", "Er ist bei uns bekannt.","sagt: ");
  
  AddInfo( ({"waffe","waffen"}) , "Ich habe den Umgang mit Waffen recht gut "
     "erlernt."
    ,"sagt: ");
    
  AddInfo( ({"ausbildung","vergangenheit"}) ,"Das war hart, aber ich moechte "
     "nicht darueber reden.."
    ,"sagt: ");
    
  AddInfo( ({"auftrag","aufgabe"}) , "Das wechselt taeglich."
    ,"sagt: ");
    
  AddInfo( ({"arbeit","leben"}) , "Sicher gibt es sichere Arbeit aber naja, "
     "was soll man machen?"
    ,"sagt: ");
    
  AddInfo( ({"tod","sterben"}) ,"Wenn es sein muss."
    ,"sagt: ");
    
  AddInfo( ({"gebiet","hilfe", "khorinis"}) , "Das hier ist Khorinis."
    ,"sagt: ");
  SetProp(P_MNPC_AREA, ({  ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "d2");
  SetProp(P_MNPC_WAIT, ({ 35, 40, 10 }));
  SetProp(P_MNPC_FLAGS, 
  				MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);
  SetChats(3,
  ({Name()+" blickt starr gerade aus.\n"
   ,Name()+" macht kehrt.\n"
   ,Name()+" beobachtet Dich aus den Augenwinkeln.\n"
   })
  );
  SetProp(P_SPELLRATE, 20);
  AddSpell(5, 550,
    Name()+" taeuscht Dich mit einer Finte!\n",
    Name()+" taeuscht @WEN mit einer Finte!\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));
  AddSpell(5, 700,
    Name()+" schleudert Dich mit einem Rueckhandhieb zu Boden!\n",
    Name()+" schleudert @WEN mit einem rueckhandhieb zu Boden!\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));

  SUID;
  CLONEME( "/p/weapon/axe/obsidianaxt" );
  CLONEME( "/p/armour/helm/kampfhelm" );
  CLONEME( "/p/armour/armour/eisenpanzer" );
  command("trage alles");
  command("zuecke axt" );
  

}
void angriff(object pl)
{
  if(!ENV(TO))           return;
  if(!ENV(pl))           return;
  if(!interactive(pl))   return;
  if(ENV(TO) != ENV(pl)) return;
  Kill(pl);
  return;
}

void init()
{
  ::init();
  if(!TP)                        return;
  if(!interactive(TP))           return;
  if(TP->QueryProp(P_GHOST))     return;
  if(!KORMASTER->IsEnemy(TP))   return;
  call_out("angriff", 0, TP);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  KORMASTER->AddEnemy(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}


void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt einen Milizsoldaten.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Ein Milizsoldat hat gerade "+CAP(getuid(player))+
      " umgebracht.\n");
}


void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;
  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "lacht Dich aus.",
        "lacht "+TP->name(WEN, 1)+" aus.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "brummt: Verschwinde!",
        "brummt: Verschwinde!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "schuettelt nur den Kopf.",
        "schuettelt nur den Kopf.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "lacht Dich nur aus.",
        "lacht "+TP->name(WEN, 1)+" nur aus.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "grummelt: Lenk mich nicht ab!",
        "grummelt: Lenk mich nicht ab "+TP->name(RAW)+"!");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Geh woanders spielen und lass die Erwachsenen arbeiten.",
        "sagt zu "+TP->name(WEM, 1)+": Geh woanders spielen und lass die "
        "Erwachsenen arbeiten.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "verschraenkt die Arme vor seiner Brust.",
        "verschraenkt die Arme vor seiner Brust.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "lacht ueber Dich.",
        "lacht ueber "+TP->name(WEN, 1)+".");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;
  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
