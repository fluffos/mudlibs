/*
Eine Streitaxt nur fuer Trolle, ein alter held mit namen Lic'nor starb mit 
dieser axt auf dem schlachtfeld gegen einen schamanen welcher seinen geist in 
die axt bannte, der geist hat etwas drunter gelitten ;-)
*/
/* FEYARIAs Kommentar in der Balance:
Axt sollte nur reden wenn man sie zueckt. also in der WieldFunc starten
und in der UnwieldFunc stoppen, selbiges in BecomesNetDead und 
BecomesNetAlive. - Soll auch nicht in Taschen labern
Also es gibt 2 Moeglichkeiten:
1. Ich lasse IMMER nen call_out laufen der die umgebung ueberprueft
2. Ich pruefe bei jeder init und BecomesNetAlive und lasse automatisch
   bei WieldFunc starten und bei UnwieldFunc stoppen
Loesung: 2. ist speichersparender und Fey meinte es ja auch, ergo stelle ich um
Was muss ich beachten:
 WieldFunc            schaltet ein (problemlos endloschleife, da diese durch
                      wegstecken oder ausloggen beendet wird (unwield,netdead)
 Unwiedlfunc          schaltet aus
 BecomesNetDead       schaltet aus (beide seq (_p_layer seq und _r_oom seq)
 BecomesNetAlive      prueft ob gezueckt oder in einem raum, schaltet dann ein.
                      falls nichts dergleichen schaltet init auf jeden fall ein
*/
inherit "std/weapon";
#include "../def.h"
#include <properties.h>
#include <combat.h>


void create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  
  SetProp(P_SHORT, "Die Streitaxt 'Trollfaust'");
  SetProp(P_LONG,  
    "Die Axt hat gigantische Ausmasse. Der Stiel ist so lang und die "
    "Axtblaetter so gross, dass damit nur wahre Riesen effektiv umgehen "
    "koennen. Die Axt wirkt schon ziemlich alt, scheint sich aber in gutem "
    "Zustand zu befinden.");
  AddDetail( ({"stiel"}), 
    "Auf dem Stiel steht das Wort Trollfaust.");
  AddDetail( ({"wort"}), 
    "Du drehst den Stiel und entdeckst noch ganz klein das Wort Lic'nor.");
  AddDetail( ({"lic'nor", "name"}), 
    "Wem gehoert wohl dieser Name? Du solltest Dir die Axt genauer anschauen.");
  AddDetail( ({"faust", "trollfaust"}), 
    "Scheinbar wurde diese Axt extra fuer einen Troll gemacht. Jemand anders "
    "duerfte damit nicht umgehen koennen.");
  AddDetail( ({"axtblaetter", "axtblatt", "blatt", "axtblatt"}), 
    "Bis auf einige Scharten ist die Klinge in gutem Zustand.");
    AddDetail( ({"scharte", "scharten", "klinge", "zustand"}), 
    "Der ein oder andere wird sich damit schon noch ganz gut spalten lassen.");
  SetProp(P_NAME, "Trollfaust");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  AddId( ({"faust", "trollfaust", "axt", "streitaxt"}) );
  SetProp(P_INFO, 
    "Der Geist von dem verschollenen Trollhelden Lic'nor scheint in diese Axt\n"
    "gebunden zu sein. Das duerfte erklaeren, warum er sich immer zu Wort "
    "meldet.\n");
  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 265);
  SetProp(P_WC_FIX, 25); 
  SetProp(P_WC_BONUS,(["Axtkaempfer":60, 
                       "Axtexperte":130, 
                       "Axtmeister":250]));
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL,([MAT_MISC_STONE:5, MAT_MITHRIL:60, MAT_AIR:35]));
  SetProp(P_WEIGHT, 5800);
  SetProp(P_VALUE, 7000);
  SetProp(P_SIZE, 180);
  SetProp(P_MAGIC, 1);
  SetProp(P_QUALITY_DECAY, 55);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1, P_RACE:"Troll"]) );  
  SetProp(P_WIELD_FUNC, TO);
  SetProp(P_UNWIELD_FUNC, TO);

}

int WieldFunc(object waffe)
{
  remove_call_out("pseq");
  while (remove_call_out("pseq") != -1); 
  remove_call_out("rseq");
  while (remove_call_out("rseq") != -1); 
  call_out("pseq", 0);
  return 1;
}
int UnwieldFunc(object waffe)
{
  remove_call_out("pseq");
  while (remove_call_out("pseq") != -1); 
  remove_call_out("rseq");
  while (remove_call_out("rseq") != -1); 
  return 1;
}
void BecomesNetDead(object spieler)
{
  remove_call_out("pseq");
  while (remove_call_out("pseq") != -1); 
  remove_call_out("rseq");
  while (remove_call_out("rseq") != -1); 
  return;
}
void BecomesNetAlive(object spieler)
{
  if(P_WIELDED)
  {
    call_out("pseq", 0);
    return;
  }
  if((interactive(ENV(TO))) || (interactive(ENV(ENV(TO)))))
  {
    return; //wird durchs zuecken/init aktiviert
  }
  call_out("rseq", 0);
  return;
}
void init()
{
  object ob;
   
  remove_call_out("pseq");
  while (remove_call_out("pseq") != -1); 
  remove_call_out("rseq");
  while (remove_call_out("rseq") != -1); 
    
  if(QueryProp(P_WIELDED))
  {
    call_out("pseq", 0);
    //return;
  }
  if( interactive(ENV(TO)) )
  {
    ob=ENV(ENV(TO));
    if(ob)
    {
      if(interactive(ob)) //muss sein, wegen den beuteln
      {
      }
    }
    //return; //wird durchs zuecken/init aktiviert
  }
  else
  {
    call_out("rseq", 0);
  }
  
  
  ::init(); 
}

void pseq()
{
  object ob;
  string s;
  int i;
  
  i=10;
  if(!( objectp(ENV(TO)) && file_name(ENV(TO))  ) ) return;
  if(!( objectp(ENV(ENV(TO))) && file_name(ENV(ENV(TO))) ) ) return;
  ob=ENV(TO);
  if(file_name(ENV(ob))=="/room/death/death_room") return;
  if(ob)
  {
    if(ob->InFight())
    {
      switch(1+random(19))
      {
        case 1:  s="Blut! BLUT! BLUHHHT!";
        break;
        case 2:  s="Lass mich das lieber machen!";
        break;
        case 3:  s="... Ausweichen ... und Konter!";
        break;
        case 4:  s="Jaha... so geht das!";
        break;
        case 5: s="Du musst mich nur zwischen seinen Kopf und den Schultern "
                  "bringen!";
        break;
        case 6:  s="Jaaaaah, ich will Blut sehen!";
        break;
        case 7:  s="Du Schwaechling, hau doch mal richtig zu!";
        break;
        case 8:  s="War das etwa schon alles?!";
        break;
        case 9:  s="Und von oben! Und von der Seite!";
        break;
        case 10:  s="Jaaah, getroffen!!!";
        break;
        case 11:  s="Immer auf den Kopf zielen!";
        break;
        case 12:  s="Huiii, das war richtig gut!";
        break;
        case 13:  s="Los, hau drauf!";
        break;
        case 14:  s="Treffer!";
        break;
        case 15:  s="Ich bin heute gut in Form!";
        break;
        case 16:  s="Autsch, das hat sicher weh getan!";
        break;
        case 17:  s="GRRRROOAAAARRRR!";
        break;
        case 18:  s="Ich knips Dir das Licht aus!";
        break;
        default: s="Keine Panik, falls Du stirbst mache ich weiter!";
        break;
      }
    }
    else
    {
      i=60;
      switch(1+random(19))
      {
        case 1:  s="Langsam faengst Du an mich zu langweilen!";
        break;
        case 2:  s="Lass mich mal lieber machen!";
        break;
        case 3:  s="Wann passiert mal was, geidlet hast Du lang genug!";
        break;
        case 4:  s="Auch aus Dir mache ich nochmal was brauchbares!";
        break;
        case 5:  s="Nicht glotzen, Toeten!";
        break;
        case 6:  s="Mir ist langweilig! Such uns was zum Metzeln!";
        break;
        case 7:  s="Ich will Blut sehen! Jetzt auf der Stelle!";
        break;
        case 8:  s="Wir zwei sind ein richtig gutes Team, meinst Du nicht"
                   " auch?";
        break;
        case 9:  s="Du koenntest mich mal wieder schaerfen lassen.";
        break;
        case 10:  s="Ist Dir auch so langweilig wie mir?";
        break;
        case 11:  s="Heute ist aber auch mal wieder gar nix los!";
        break;
        case 12:  s="Ach komm schon, lass uns was umhauen! Irgendwas!";
        break;
        case 13:  s="Du forschst doch wohl nicht etwa, oder?!";
        break;
        case 14:  s="Dum-di-dum...";
        break;
        case 15:  s="Ich schlaf hier gleich ein, TU endlich was!";
        break;
        case 16:  s="Los, ich will Feenfluegel knacken hoeren!";
        break;
        case 17:  s="Ist das oede, nicht mal eine Ameise zum Zerquetschen"
                    " da...";
        break;
        case 18:  s="Hey, der Typ da drueben starrt schon die ganze Zeit hier "
                 "rueber! Lass uns ihm eine Lehre erteilen!";
        break;
        default:  s="Nicht schaetzen, angreifen!";
        break;
      }
    }
    ENV(ob)->Message(BS("Lic'nor sagt: "+s), MSGFLAG_SAY);
  }
  call_out("pseq", i);
  return;
}

void rseq()
{
  string s;
  object ob;
  
  if(!( objectp(ENV(TO)) && file_name(ENV(TO)) ) ) return;
  if(ob=ENV(TO))
  {
    //if( (file_name(ENV(ob))) == "/room/death/death_room") return;
    if(ob)
    {
      switch(1+random(19))
      {
        case 1:  s="Hey bleib mal kurz stehen!";
        break;
        case 2:  s="Haste mal Waffenoel?";
        break;
        case 3:  s="Pssst, Du ... Ja genau DU! Heb mich auf, lass uns kaempfen!";
        break;
        case 4:  s="Alleinstehende Axt sucht starke(n) Trollberserker(in).";
        break;
        case 5:  s="Du brauchst gar nicht so zu schauen!";
        break;
        case 6:  s="He, Du da! Stehenbleiben!";
        break;
        case 7:  s="Ja, Dich meine ich!";
        break;
        case 8:  s="Was guckst Du denn so? Noch nie 'ne sprechende Axt gesehen?";
        break;
        case 9:  s="Pass lieber auf, sonst maehe ich Dich nieder! ";
        break;
        case 10:  s="Wie unverschaemt, mich hier einfach so liegen zu lassen!";
        break;
        case 11:  s="Fass mich ja nicht an!";
        break;
        case 12:  s="Guck nicht so daemlich!";
        break;
        case 13:  s="Ich bin die schoenste Axt, die je geschmiedet wurde!";
        break;
        case 14:  s="Hey! Geh SOFORT von meinem Stiel runter, sonst setzt es "
                    "was!";
        break;
        case 15:  s="Leg Dich ja nicht mit mir an!";
        break;
        case 16:  s="Geh mir aus der Sonne!";
        break;
        case 17:  s="Du siehst aus, als waerst Du zu gar nichts zu gebrauchen!";
        break;
        case 18:  s="Wie konnte man mich, MICH, hier nur liegen lassen?!";
        break;
        default:  s="Nimm mich, ich bin schwer und willig (fuer den Kampf).";
        break;
      
      }
    ob->Message(BS("Lic'nor sagt: "+s), MSGFLAG_SAY);
    }
  }
  call_out("rseq", 60);
  return;
}
