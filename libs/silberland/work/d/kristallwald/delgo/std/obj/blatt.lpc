#include "../def.h"

inherit "std/thing";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  call_out("remove", 60+random(40));

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein blaues Blatt");
  SetProp(P_LONG, "An der typischen blauen Faerbung dieses Blattes "
  "erkennst Du, dass es aus dem Tetyhrwald stammen muss. Feine "
  "Veraestelungen fuehren von seiner Mitte aus bis zur Spitze.");

  AddDetail( ({ "faerbung", "farbe" }),
    "Das Blatt hat eine seltsame, blaue Farbe.");

  AddDetail( ({ "tethyrwald" }),
    "Dieses Blatt stammt eindeutig aus dem Tethyrwald. Nirgendwo sonst "
    "gibt es derart blaufarbige Pflanzen.");

  AddDetail( ({ "pflanzen" }),
    "Nun ja, oder halt Blaetter.");

  AddDetail( ({ "veraestelungen", "veraestelung", "linie", "linien" }),
    "Feine, hauchduenne Linien kannst Du auf der Oberflaeche des "
    "Blattes erkennen. Sie laufen schraeg von der Mitte aus bis zur "
    "Spitze.");

  AddDetail( ({ "oberflaeche" }),
    "Die Oberflaeche des Blattes fuehlt sich ein wenig weich an.");

  AddDetail( ({ "mitte", "spitze" }),
    "Die Linien laufen von der Mitte aus bis zur Spitze des Blattes.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Blatt");
  SetProp(P_NAME_ADJ, "blau");
  AddAdjective( ({ "blaues", "blauen", "blauem" }) );
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "blatt", "waldschratblatt" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_PLANT);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);

//--Create Ende------------------------------------------------------------

}
