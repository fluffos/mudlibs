//** Npcmaster von Delgo ***************************************************//
/*
  Master zur Steuerung/Kontrolle von wichtigen NPCs in Tethyrgebieten
  - aufgrund der Fuelle der Infos Zeilenlaenge 150
*/
//**************************************************************************//
//** INHERIT + INCLUDE + DEFINE ********************************************//
#include "../def.h"
#include <ansi.h>

//--Vars----------------------------------------------------------------------
string *enemies;
mixed area_color, npcs;
int messagelevel;  // 0 = Nichts; 1 = Wichtiges; 2 = Quests; 3 = Alles

//--Prototypes----------------------------------------------------------------
void update_list();
//**************************************************************************//



//** StandardFunktionen ****************************************************//
//-- Create ------------------------------------------------------------------
void create()
{
  if(is_clone(TO))
  { destruct(TO); return; }

  SUID;
  enemies=({});
  npcs=({});
  area_color=ANSI_BOLD+ANSI_RED;
  return;
}

//-- Feindschaft beenden -----------------------------------------------------
void reset()
{
  enemies=({});
  update_list();
}
//**************************************************************************//



//** GebietsFeind-Verwaltung ***********************************************//
//-- Einen Feind hinzufuegen -------------------------------------------------
void AddEnemy(object pl)
{
  string uuid;
  if(!pl)              return;
  if(!interactive(pl)) return;
  uuid = getuuid(pl);
  if(member(enemies, uuid) == -1) enemies += ({ uuid });
}

//-- Ist das objekt ein Feind? -----------------------------------------------
int IsEnemy(object pl)
{
  string uuid;

  if(!pl)              return 0;
  if(!interactive(pl)) return 0;
  uuid = getuuid(pl);
  if(member(enemies, uuid) != -1) {return 1;}
  return 0;

}

