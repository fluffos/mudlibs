#include "../def.h"

inherit "std/mnpc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------

string groesse;
string ChatFunc();

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SUID;
}

//--Funktionen-------------------------------------------------------------

varargs void create_default_waldschrat(int level, int aggressive)
{
  if(!intp(level))      level      = 1;
  if(level < 1)         level      = 1;
  if(!intp(aggressive)) aggressive = 0;
  if(aggressive < 0)    aggressive = 0;
  if(aggressive > 100)  aggressive = 100;

  AddClass( ({CL_GIANT}) );
  AddId( ({"waldschrat", "schrat", "\nwaldschrat"}) );

  if(level < 17)
  {
      groesse = "klein";
      AddAdjective( ({ "kleiner", "kleinen", "kleinem" }) );
      SetProp(P_SIZE, 170+random(30));
      SetProp(P_WEIGHT, 40000+random(30000));
      SetProp(P_CORPSE, OBJ "aeste_klein");
  }
    
  if(level > 16 && level < 24)
  {
      groesse = "gross";
      AddAdjective( ({ "grosser", "grossen", "grossem" }) );
      SetProp(P_SIZE, 200+random(50));
      SetProp(P_WEIGHT, 50000+random(40000));
      SetProp(P_CORPSE, OBJ "aeste_gross");
  }
    
  if(level > 23)
  {
      groesse = "riesig";
      AddAdjective( ({ "riesiger", "riesigen", "riesigem" }) );
      SetProp(P_SIZE, 250+random(50));
      SetProp(P_WEIGHT, 60000+random(50000));
      SetProp(P_CORPSE, OBJ "aeste_riesig");
  }

  SetProp(P_SHORT, "Ein "+groesse+"er Waldschrat");
  //SetProp(P_LONG, --> siehe unten

  AddDetail( ({ "haut" }),
    "Seine Haut ist rindenartig und sehr rauh.");

  AddDetail( ({ "baum" }),
    "Der Waldschrat sieht einem Baum sehr aehnlich.");

  AddDetail( ({ "verwechseln" }),
    "Man koennte ihn fast mit einem Baum verwechseln.");

  AddDetail( ({ "augen" }),
    "Seine kleinen, dunklen Augen blicken Dich ein wenig argwoehnisch an.");

  AddDetail( ({ "gesicht" }),
    "Sein Gesicht ist klein und runzlig.");

  AddDetail( ({ "arme", "beine" }),
    "Er hat knorrige lange Arme und Beine, die fast wie die Aeste eines "
    "Baumes aussehen.");

  AddDetail( ({ "aeste" }),
    "Sie sehen aus wie Aeste.");

  AddDetail( ({ "blaetter" }),
    "Blaue Blaetter wachsen an seinen Armen und Beinen.");

  AddSpecialDetail( ({ "exemplar" }),
    "strexemplar");

  AddSpecialDetail( ({ "rasse" }),
    "strrasse");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" knarrt: Das kann ich nicht gebrauchen.\n" }) );

  SetProp(P_NAME, "Waldschrat");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE,"Waldschrat");
  SetProp(P_ALIGN, -200+random(400));

  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_NOMAGIC, 20);
  SetProp(P_WIMPY, 0);
  SetProp(P_HEAL, 0);
  SetProp(P_TEMPERATURE_RANGE,([T_RANGE_MIN:-10,T_RANGE_MAX:40]));

  SetProp(P_MSGIN, "stakst herein");
  SetProp(P_MSGOUT, "geht knarrend");
  SetProp(P_MMSGIN, "erscheint vor Dir");
  SetProp(P_MMSGOUT, "verschwindet im Wald");
  SetProp(P_MNPC_FLAGS, 0);

  SetProp(P_DIE_MSG, " faellt in sich zusammen.\n");
  SetProp(P_NOCORPSE, 0);

  SetProp(P_RESISTANCE_STRENGTHS,
    ([ DT_FIRE:     0.4,
       DT_MIND:    -0.3,
       DT_COLD:    -0.2 ]));

  SetProp(P_HANDS, ({" mit der Kraft des Waldes", 
                     QueryProp(P_HANDS)[1], 
                     ({DT_BLUDGEON, DT_MAGIC}) }) );

//--Tod--------------------------------------------------------------------

  SetProp(P_KILL_NAME, "Ein Waldschrat");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "scheint Dich nicht zu verstehen.\n",
            "richtet seine dunklen Augen auf Dich.\n",
            "blickt Dich stumm an."}));

//--Chats------------------------------------------------------------------

  SetChats(10, ({ "@@ChatFunc@@" }) );

  SetAttackChats(10,
  ({Name(WER, 1)+" holt mit seinen langen, astaehnlichen Armen aus.\n",
    Name(WER, 1)+" gibt ein dumpfes, drohendes Grollen von sich.\n",
    Name(WER, 1)+" schlaegt mit seinen Aesten nach Dir.\n",
    Name(WER, 1)+" wird langsam richtig wuetend.\n",
    "Goldgelbe Harztropfen fallen auf Dich herab.\n" }));

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "brich", "brech", "breche" }), "astbruch" );

//--Spells-----------------------------------------------------------------

  //nicht angreifbare NPCs brauchen keine Spells
  if(QueryProp(P_NOATTACK)) return;

  SetProp(P_SPELLRATE, 40);

  AddSpell(2, 270,
   BS(Name(WER, 1)+" schleudert Dich kraftvoll zur Seite!\n"),
   BS(Name(WER, 1)+" schleudert @WEN kraftvoll zur Seite!\n"),
   DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3, 350,
   BS(Name(WER, 1)+" laesst seine Aeste auf Dich niedersausen!\n"),
   BS(Name(WER, 1)+" laesst seine Aeste auf @WEN niedersausen!\n"),
   ({DT_BLUDGEON, DT_RIP}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 450,
   BS(Name(WER, 1)+" reisst mit seinen Zweigen eine klaffende Wunde in Dein "
   +"Bein!\n"),
   BS(Name(WER, 1)+" reisst mit seinen Zweigen eine klaffende Wunde in "
   +"@WESSEN Bein!\n"),
   ({DT_BLUDGEON, DT_RIP}), ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2, 0, DS_SLOW,
   BS(Name(WER, 1)+" beschwoert zahlreiche Ranken aus dem Boden, die Dich "
    +"umschlingen und beim Kaempfen behindern.\n"),
   BS(Name(WER, 1)+" beschwoert zahlreiche Ranken aus dem Boden, die @WEN "
    +"umschlingen und beim Kaempfen behindern.\n"), 5);

  AddDefaultSpell(1, 1, DS_BLIND,
   BS("Ein grosser Tropfen Harz faellt direkt in Deine Augen und verklebt "
   +"Dir die Sicht!"),
   BS("@WER taumelt einen Moment lang blindlings umher."), 4);

  create_default_npc(level);
}

//-------------------------------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;

  if(groesse == "klein")
  {
        txt =  "Der kleine Waldschrat, der vor Dir steht, scheint noch "
        +"recht jung zu sein, soweit man bei einem Waldschrat ueberhaupt "
        +"von jung sprechen kann. ";
  }
  
  if(groesse == "gross")
  {
        txt =  "Der grosse Waldschrat, der vor Dir steht, scheint bereits "
        +"ausgewachsen zu sein. ";
  }

  if(groesse == "riesig")
  {
        txt =  "Dieser riesige Waldschrat ist ein besonders praechtiges "
        +"Exemplar seiner Rasse. ";
  }

  txt = "Er hat eine sehr rauhe, rindenartige Haut und sieht einem Baum "
  +"fast zum Verwechseln aehnlich. Nur an den kleinen, dunklen Augen, die "
  +"Dich unverwandt aus dem seltsamen Gesicht heraus anstarren, erkennst "
  +"Du, dass er alles andere ist als ein einfacher, normaler Baum. An "
  +"seinen knorrigen Armen und Beinen, die aussehen wie lange Aeste, "
  +"wachsen ein paar blaue Blaetter. ";

  return BS(txt);
}

string strexemplar(string str)
{
  string s;

  if(groesse == "riesig")
  {
  	s = "Er ist riesengross.";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

string strrasse(string str)
{
  string s;

  if(groesse == "riesig")
  {
  	s = "Er ist ein Waldschrat.";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt einen "+groesse+"en Waldschrat.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": Ein "+groesse+"er Waldschrat hat gerade "
      +CAP(getuid(player))+" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
    case "traurig":
    case "intim":
      call_out("reaction", 0, TP,
        "blickt Dich schweigend an.",
        "blickt "+TP->name(WEN)+" schweigend an.");
      break;

    case "aergerlich":
    case "frech":
      call_out("reaction", 0, TP,
        "gibt ein drohendes Grollen von sich.",
        "gibt ein drohendes Grollen von sich.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "streckt erbost seine langen Aeste nach Dir aus.",
        "streckt erbost seine langen Aeste nach "+TP->name(WEM)+" aus.");
      Kill(TP);
      break;

    case "froh":
    case "nett":
      call_out("reaction", 0, TP,
        "knarrt verwundert mit seinen Aesten.",
        "knarrt verwundert mit seinen Aesten.");
      break;

    case "neutral":
    case "albern":
      call_out("reaction", 0, TP,
        "reckt seine Aeste und Zweige.",
        "reckt seine Aeste und Zweige");
     break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Hilfsfunktion: alle Spieler im Raum suchen
int filter_player(object ob)
{
  //alle Spieler
  if(query_once_interactive(ob) && !find_netdead(getuid(ob))) return 1;
 
  //Rest wird aussortiert
  return 0;
}

//Chatfunktion
string ChatFunc()
{
  object *inhalt;
  object player;
  inhalt = all_inventory(ENV(TO)); //Wer ist alles im Raum?
  inhalt = filter_array(inhalt, "filter_player"); //nur Spieler behalten
  
  if(!sizeof(inhalt)) return ""; //kein Spieler anwesend?
  
  player = inhalt[random(sizeof(inhalt))]; //einen beliebigen Spieler waehlen 

  switch(random(6))
  {
        case 1:
          call_out("reaction", 0, player,
          "knarrt leise.\n",
          "knarrt leise.\n");
          break;
        case 2:
          call_out("reaction", 0, player,
          "dreht sich im Wind.\n",
          "dreht sich im Wind.\n");
          break;
        case 3:
          call_out("reaction", 0, player,
          "raschelt ein wenig mit seinen Blaettern.\n",
          "raschelt ein wenig mit seinen Blaettern.\n");
          break;
        case 4:
          call_out("fackelangriff", 0, player);
          break;
        case 5:
          call_out("blattabwurf", 0, player);
          break;
        default:
          call_out("reaction", 0, player,
          "reckt seine Aeste zu allen Seiten.\n",
          "reckt seine Aeste zu allen Seiten.\n");
          break;
   }
   
   return "";
}

//Hilfsfunktion fuers Fackeln filtern:
int check_for_light(object ob)
{
  if( (ob->id("fackel")) && (ob->QueryProp(P_LIGHTED) > 0) ) return 1;
  return 0;
}

//wenn ein Spieler eine brennende Fackel hat -> angreifen
int fackelangriff(object player)
{
   object *inventar;
   inventar = all_inventory(player); //was hat der Spieler im Inv?
   inventar = filter_array(inventar, "check_for_light");

   if(sizeof(inventar))
   {
      tell_object(player, BS(Name(WER, 1)+" bemerkt ploetzlich Deine "
      +"brennende Fackel und gibt ein wuetendes Grollen von sich."));

      ENV(TO)->Message(BS(Name(WER, 1)+" scheint ueber irgendetwas sehr "
      +"veraergert zu sein."),
      MSGFLAG_SOUND, ([MSGFLAG_EXCLUDE: ({ player })]) );

      Kill(player);
      return 1;
   }

   return 0;
}

//Blaetter abwerfen
int blattabwurf(object player)
{
   object blatt;
   int i;
   
   i = 1+random(2);

   if(!(present("waldschratblatt", ENV(TO))))
   {
      while(i--)
      {
         blatt = clone_object(OBJ "blatt"); 
         blatt->move(ENV(TO), M_PUT|M_SILENT);
      }

      ENV(TO)->Message(break_string(Name(WER, 1)+" schuettelt sich ein "
      +"wenig.\nEin paar blaue Blaetter fallen zu Boden.", 78, 0, 1), 
      MSGFLAG_VISUAL);
      
      return 1;
   }
   else
   {
      ENV(TO)->Message(BS(Name(WER, 1)+" schuettelt sich ein wenig."), 
      MSGFLAG_VISUAL);

      return -1;
   }
}

//einen Ast abbrechen
int astbruch(string str)
{
  notify_fail("Was willst Du abbrechen?\n");

  if(!str || str == "") return 0;
  
  if(!(str == "ast ab" ||
       str == "aeste ab" ||
       str == "ast von waldschrat" ||
       str == "ast von waldschrat ab" ||
       str == "aeste von waldschrat" ||
       str == "aeste von waldschrat ab" ||
       str == "ast von schrat" ||
       str == "ast von schrat ab" ||
       str == "aeste von schrat" ||
       str == "aeste von schrat ab" ))  return 0;

  write(BS("Du versuchst, einen der Aeste des Waldschrates abzubrechen, "
  +"doch dieser scheint das gar nicht so gut zu finden."));

  ENV(TO)->Message(BS(TP->Name(WER, 1)+" versucht, einen der Aeste des "
  +"Waldschrates abzubrechen, was dieser gar nicht so gut zu finden "
  +"scheint."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  
  Kill(TP);
  return 1;
}
