#include "../def.h"

inherit "std/thing";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  AddId(({"linse","glaslinse","allon","\nallon","stab","\nmuaddib_quest_item",
	    "QUESTOBJ","NODESTRUCT"}));
  SetProp(P_SHORT, "Ein Stab mit einer Linse");
  SetProp(P_LONG, 
	  BS("Du siehst einen hoelzernen Stab, an dem eine glaeserne Linse "
	     "befestigt wurde."));
  SetProp(P_NAME, "Linsenstab");
  SetProp(P_GENDER, MALE);

  SetProp(P_MATERIAL, ([MAT_ELM_WOOD:95, MAT_GLASS:4, MAT_GOLD:1]));
  SetProp(P_WEIGHT, 2105);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);

  AddDetail(({"holz"}), 
            "Der ganze Stab besteht aus Holz."); 
  
  AddDetail(({"gold"}),
	    "Die Linse ist in Gold eingefasst.");
  
  AddDetail(({"glas"}),
	    "Die Linse besteht vollstaendig aus Glas.");
}
