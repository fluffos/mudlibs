#include "../def.h"

inherit "std/thing";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  AddId(({"dietrich", "\ndietrich","\nmuaddib_quest_item","QUESTOBJ",
	    "NODESTRUCT"}));
  SetProp(P_SHORT, "Ein Dietrich");
  SetProp(P_LONG,
	  BS("Du siehst einen Dietrich, den Du Dir gerade aus einem Nagel "
	     "und einem Stueck Draht gebastelt hast. Vielleicht kannst Du "
	     "ihn benutzen?"));
  SetProp(P_NAME, "Dietrich");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 75);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);
}
