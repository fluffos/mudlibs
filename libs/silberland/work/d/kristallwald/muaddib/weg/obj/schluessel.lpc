#include "../def.h"

inherit "std/thing";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  AddId(({"\nschluessel","schluessel", "schrankschluessel",
	    "\nschrankschluessel","\nmuaddib_quest_item","NODESTRUCT",
	    "QUESTOBJ"}));
  SetProp(P_SHORT, "Ein Schrankschluessel");
  SetProp(P_LONG, 
	  BS("Du siehst einen Schrankschluessel. Zu welchem Schrank der wohl "
	     "passt?"));
  SetProp(P_NAME, "Schrankschluessel");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);
}
