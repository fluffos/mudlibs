#include "../def.h"

inherit "std/thing";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  AddId(({"linse", "\nlinse","\nmuaddib_quest_item","QUESTOBJ","NODESTRUCT"}));
  SetProp(P_SHORT, "Eine Linse");
  SetProp(P_LONG, 
	  BS("Du siehst eine in Gold gefasste Linse mit hohem "
	     "Vergroesserungsfaktor. Vielleicht kannst Du damit was "
	     "fokussieren?"));
  SetProp(P_NAME, "Linse");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, ([MAT_GLASS:95,MAT_GOLD:5]));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 300);
  SetProp(P_NOBUY, 1);
}
