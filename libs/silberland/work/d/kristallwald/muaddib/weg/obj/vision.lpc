#include "../def.h"

inherit "std/thing";

#undef BSA
#define BSA(x) break_string(x,78,"Eine Stimme fluestert: ")

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  AddId("\nmuaddibs_vision");
  SetProp(P_SHORT, 0);
  SetProp(P_NAME, "Vision");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_INVIS, 1);
}

void init()
{
  ::init();
  
  call_out("vision1", 1, TP);
}

void vision1(object pl) 
{
  if(!objectp(pl))
    {
      call_out("remove", 0, 1);
      return;
    }

  tell_object(pl, 
      BS("Slartibart schaut Dich intensiv an, und Du faellst in einen "
	 "seltsamen Zustand. Du weisst nicht mehr, wie Du heisst, noch "
	 "wo Du bist, noch was Du tun wolltest..."));
  
  say(BS("Slartibart schaut "+TPN+" intensiv an.")+
      BS(TPN+" sinkt langsam zu Boden."));
  
  call_out("vision2", 15);
}

void vision2(object pl) 
{
  if(!objectp(pl)) 
    {
      call_out("remove", 0, 1);
      return;
    }

  tell_object(pl, 
      BSA(TPN+", wach auf! Komm zu Dir! Das ist nicht das Ende und ich bin "
	  "nicht der Tod. Ich bin nur einer der Waechter ueber Zeit und Raum. "
	  "Ich wache hier auf den Befehl eines Magiers hin und schaue darauf, "
	  "dass kein Spieler die Grenzen des Erlaubbaren ueberschreitet. Du "
	  "warst ganz knapp davor, aber mein Freund Slartibart hat Dich davon "
	  "abhalten koennen. Gut so... "));

  call_out("vision3", 15);
}

void vision3(object pl) 
{
  if(!objectp(pl)) 
    {
      call_out("remove", 0, 1);
      return;
    }

  tell_object(pl, 
      BSA("Dein Fehler war es, den Turm von Slartibart noch einmal betreten "
	  "zu wollen, obwohl Du seine Aufgabe schon geloest hattest. Wusstest "
	  "Du eigentlich, dass Du in diesem Turm nur getestet wurdest? Aber "
	  "lassen wir das, ich schweife ab..."));

  call_out("vision4", 15);
}

void vision4(object pl) 
{
  if(!objectp(pl)) 
    {
      call_out("remove", 0, 1);
      return;
    }

  tell_object(pl, 
      BSA("Gut, wo war ich? Achja, Dein Vergehen... Was war der Grund, dass "
	  "nochmal in den Turm wolltest? Vielleicht ein edler Grund? Den "
	  "Magiern im SL zu helfen? Oder doch nur, um persoenlichen Vorteil "
	  "aus eventuellen Fehlern zu ziehen? Naja gut, dafuer gibt es jetzt "
	  "ja mich, Flr'htyx. Der magische Fluch ueber dem Turm ist "
	  "aufgehoben, aber wir, die Waechter ueber Zeit und Raum, werden uns "
	  "jetzt den verraeterischen Spielern annehmen. So achte darauf, die "
	  "Regeln des Anstandes nicht zu ueberschreiten. Sonst holen wir "
	  "Dich..."));

  call_out("vision5", 15);
}

void vision5(object pl)
 {
  if(!objectp(pl)) 
    {
      call_out("remove", 0, 1);
      return;
    }

  tell_object(pl, 
      BS("Der Nebel, der sich um Deinen Kopf gelegt hat, lichtet sich, und "
	 "langsam kannst Du wieder klar denken..."));

  say(BS(TPN+" schuettelt kurz den Kopf."));

  call_out("remove", 0);
}
