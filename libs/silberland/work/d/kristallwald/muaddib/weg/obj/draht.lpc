#include "../def.h"

inherit "std/thing";

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"draht", "\ndraht","\nmuaddib_quest_item","QUESTOBJ","NODESTRUCT"}));
  SetProp(P_SHORT, "Ein Stueck Draht");
  SetProp(P_LONG, 
	  BS("Du siehst ein Stueck Draht. Vielleicht kannst Du daraus was "
	     "basteln?"));

  SetProp(P_NAME, "Draht");
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_IRON);
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);
}
