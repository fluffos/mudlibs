#include "../def.h"

inherit "std/thing";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  AddId(({"ankh","kreuz","\nankh","\nmuaddib_quest_item","QUESTOBJ",
	    "NODESTRUCT"}));
  SetProp(P_SHORT, "Ein Ankh");
  SetProp(P_LONG, 
	  BS("Du siehst ein Ankh. Ein Ankh sieht aus wie ein Kreuz, aber "
	     "halt doch nicht ganz."));
  SetProp(P_NAME, "Ankh");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_MATERIAL, MAT_GOLD);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 20000);
  SetProp(P_NOBUY, 1);
}
