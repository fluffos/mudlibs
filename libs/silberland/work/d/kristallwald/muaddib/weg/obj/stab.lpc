#include "../def.h"

inherit "std/thing";

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"\nmuaddib_quest_stab","holzstab","stab","\nmuaddib_quest_item",
	    "NODESTRUCT","QUESTOBJ"}));
  SetProp(P_SHORT, "Ein Stab");
  SetProp(P_LONG, 
	  BS("Du siehst einen hoelzernen Stab. Vielleicht kannst Du ihn "
	     "irgendwie verwenden?"));
  SetProp(P_NAME, "Stab");
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_ELM_WOOD);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);
  
  AddDetail(({"holz"}),
	    "Der ganze Stab besteht aus Holz.");
}
