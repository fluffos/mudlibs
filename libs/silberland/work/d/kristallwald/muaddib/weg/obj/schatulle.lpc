#include "../def.h"

inherit "/obj/container";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_CNT_STATUS, CNT_STATUS_CLOSED);
  SetProp(P_SHORT, "Eine Schatulle");
  SetProp(P_LONG, 
	  "Du siehst eine einfache Schatulle, die keine weiteren "
	  "Besonderheiten besitzt.");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Schatulle");
  SetProp(P_WEIGHT, 200);

  CLONEME(OBJ "schluessel");
  
  AddId(({"schatulle","\nschatulle","\nmuaddib_quest_item","QUESTOBJ",
	    "NODESTRUCT"}));
}
