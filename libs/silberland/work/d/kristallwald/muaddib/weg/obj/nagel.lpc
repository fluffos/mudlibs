#include "../def.h"

inherit "std/thing";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  AddId(({"nagel", "\nnagel","\nmuaddib_quest_item","QUESTOBJ","NODESTRUCT"}));
  SetProp(P_SHORT, "Ein Nagel");
  SetProp(P_LONG, 
	  BS("Du siehst einen gewoehnlichen Nagel. Vielleicht koenntest Du "
	     "daraus etwas Nuetzliches basteln?"));
  SetProp(P_NAME, "Nagel");
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_IRON);
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);
}
