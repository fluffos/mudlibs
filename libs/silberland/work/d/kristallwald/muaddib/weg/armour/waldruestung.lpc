#include "../def.h"

inherit "/std/armour";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Eine elfische Waldruestung");
  SetProp(P_LONG, 
	  BS("Die Waldruestung besteht nur aus Blaettern, die durch einen "
	     "obskuren, eventuell magischen Mechanismus zusammengehalten "
	     "wird. Sie gibt dem Traeger eine gewisse Tarnung im Wald."));
  SetProp(P_INFO, 
	  BS("Die Ruestung scheint ungewoehnlich stabil und doch leicht "
	     "zu sein."));
  SetProp(P_NAME, "Waldruestung");
  AddId(({"waldruestung", "ruestung", "waldelfenruestung"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 20);
  SetProp(P_MATERIAL, ({MAT_WOOD, MAT_PLANT}));
  SetProp(P_WEIGHT, 700);
  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_NOBUY, 1);
  SetProp(P_VALUE, 500);
  SetProp(P_WEAR_TEXT, ({"Du streifst eine Waldruestung ueber.\n",
			   " streift eine Waldruestung ueber.\n"}));
  SetProp(P_UNWEAR_TEXT, ({"Du legst eine Waldruestung ab.\n",
			     " legt eine Waldruestung ab.\n"}));
}



