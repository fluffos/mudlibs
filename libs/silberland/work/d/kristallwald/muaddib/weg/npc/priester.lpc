#include "../def.h"
#include "../turmquest.h"

inherit "std/npc";

#pragma strict types;

nosave object quest_player;

void create()
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Der Priester Slartibart des Nabla-Ordens");
  SetProp(P_LONG, 
	  BS("Du siehst einen Hohepriester des Nabla-Ordens. Dieser "
	     "Orden hat sein Lebenswerk und das der Angehoerigen dem "
	     "Dienst der Mathematik geweiht. Du willst das eigentlich "
	     "nicht so genau wissen."));
  SetProp(P_NAME, "Slartibart");
  SetProp(P_GENDER, MALE);
  AddId(({"priester","slartibart"}));
  SetProp(P_ALIGN, 700);
  SetProp(P_RACE, "Mensch");
  SetProp(P_ARTICLE, 0);
  
  SetProp(P_DEFAULT_INFO, "sagt: Willst Du mir nicht lieber helfen?\n");

  SetChats(10,({
    "Der Priester sagt: Ohh, warum kann mir niemand helfen?\n",
      "Der Priester jammert: Mein Ankh, mein Ankh...\n",
      "Der Priester sagt: Ich bin zu alt fuer den Turm.\n",
      "Der Priester heult leise vor sich hin.\n",
      "Der Priester berechnet das Volumen seines Ankhs.\n",
      "Der Priester sagt: Hilf mir, bitte, bitte!\n"}));

  SetProp(P_NOATTACK, 1);

  SetProp(P_REJECT, ({ 
    REJECT_DROP, "Slartibart sagt enttaeuscht: Das ist ja nicht mein "
      "Ankh.\n"}));

  AddInfo(({"hilfe","helfen","quest","aufgabe"}),
	  "@@mission@@", 
	  "sagt: ");

  AddInfo(({"ankh","ankhs"}),
	  "Ein Ankh ist wie ein Kreuz, aber halt doch nicht ganz.",
	  "sagt: ");

  AddInfo("weg", 
	  "Ja das ist ein Weg.", 
	  "sagt: ");

  AddInfo("versteck", 
	  "Wenn ich das bloss wuesste...", 
	  "stoehnt: ");

  AddInfo("waffe", 
	  "Die solltest Du gezueckt bei Dir tragen.", 
	  "raet Dir: ");

  AddInfo("erschaffer", 
	  "Das ist Muad'Dib gewesen.", 
	  "sagt: ");

  AddInfo("turm", 
	  "Ein fuerchterlicher Turm. Niemand will da fuer mich "
	  "rein und meinen Ankh wiederholen, den Muad'Dib dort "
	  "drinnen versteckt hat, um mich zu aergern.", 
	  "sagt: ");

  AddInfo(({"problem", "probleme"}),
	   "Das Problem ist, dass das Ankh nicht mehr zu finden ist.", 
	   "flucht: ");

  AddInfo("ort",
	  "Dies ist ein grauenhafter Ort.", 
	  "fluestert zitternd: ");

  AddInfo(({"muaddib", "muad'dib"}), 
	  "Muad'Dib ist mein Erschaffer.", 
	  "sagt: ");

  AddInfo(({"name","namen","slartibart"}), 
	  "Slartibart, das bin ich.", 
	  "sagt: ");

  AddInfo("volumen", 
	  "Ich kann mich nicht konzentrieren.", 
	  "sagt: ");
  
  AddInfo("belohnung",
	  "nickt Dir zu.");
  
  AddInfo(({"priester","orden","nabla","nablaorden","nabla-orden","dienst"}),
	  "Wir haben uns dem Dienst der Mathematik verpflichtet, um diese "
	  "hochgradig faszinierende Wissenschaft voranzutreiben.", 
	  "sagt: ");

  AddInfo(({"mathematik","wissenschaft"}), 
	  "Die Mathematik ist die einzig wahre Wissenschaft!", 
	  "sagt: "); 
  
  AddInfo("kreuz",
	  "Du weisst aber schon, was ein Kreuz ist, oder?", 
	  "sagt: ");

  AddInfo("zaubern", 
	  "Das ist seit neuestem verboten, weil da angeblich sogenannte "
	  "Abenteurer unfairer Weise geuebt haben.", 
	  "schnaubt veraechtlich: ");

  AddInfo("abenteurer", 
	  "Pffft. Von wegen.", 
	  "meint: ");
  
  AddInfo(({"fackel","fackeln"}), 
	  "Sowas habe ich leider nicht.", 
	  "sagt traurig: ");
  
  AddInfo(({"elessar","elfenstadt","elfen","elfensiedlung"}),
	  "deutet nach Norden.");
  
  AddInfo(({"derlim","hobbit","hobbits","hobbitdorf","hobbingen"}),
	  "deutet nach Sueden.");
  
  set_living_name("slartibart");
}

string mission()
{
  if(present("\nmuaddib_quest", TP))
    {
      if(!deep_present("\nankh", TP))
	call_out("los_geht", 1);
      
      return BS("Du hilfst mir doch schon. Hast Du das Ankh schon?");
    }
  
  AddCmd("los", "los_geht");
  
  return "Du willst mir wirklich helfen? Das wird eine gefaehrliche "
    "Reise, weil Du den Turm nur verlassen kannst, wenn Du mir \"raus\""
    " mitteilst. Der Turm hat keine Ausgaenge und wenn Du in ein anderes "
    "Stockwerk gehst, kannst Du nicht mehr ins daruntergelegene gehen. "
    "Also dann, Deine Aufgabe ist es, mir mein Ankh zurueckzubringen. Viel "
    "Glueck. Aber nimm eine Waffe mit, Du wirst sie brauchen. Und eine Fackel "
    "oder zwei wirst Du auch brauchen, da man im Turm nicht zaubern kann... "
    "Sag einfach 'los', wenn Du bereit bist.";
}

varargs int los_geht(string str)
{
  if((!IS_WIZARD(TP)) && (TP->QueryQuest(TURMQUEST)))
    {
      CLONE(OBJ "vision", TP);
      
      return 1;
    }
  
  write(BS("Der Priester sagt: ok, los gehts..."));
  write(BS("Der Priester versinkt in Konzentration."));

  if(!present("\nmuaddib_quest", TP))
    CLONE(OBJ "quest", TP);
  
  call_out("call_me_out_now", 5, TP);
  
  return 1;
}


void call_me_out_now(object pl)
{
  if(!objectp(pl)) return;
  
  if(ENV(pl)!=MENV) return;
  
  pl->move(ROOM "base:"+getuid(pl), M_GO);
}

void catch_tell(string str)
{
  string wer,was;
  object ob, ob1,ob2,ob3;

  if(sscanf(str, "%s sagt: los", wer) == 1 )
    {
      if(!objectp(ob2=find_living(LOWER(wer))))
        if(!objectp((ob2=PO))) return;

      call_out("los_geht", 2);
    }

  if(sscanf(str, "%s teilt Dir mit: %s\n", wer, was)==2)
    {
      wer=explode(wer, " ")[<1];
      
      if(!objectp(ob2=find_living(LOWER(wer))))
        if(!objectp(ob2=PO)) return;
      
      if((ob=present("\nmuaddib_quest", ob2)) &&
	 (strstr(file_name(ENV(ob2)), ROOM, 0)!=-1))
	{ 
	  if(was=="fertig"||was=="raus") 
	    {
	      write(BS("Du fuehlst Dich etwas unsicher...")); 
	      ob2->move(MENV, M_TPORT);
	      
	      if(!present(ob2, MENV))
		return write(BS("Slartibart kann Dich zur Zeit nicht "
				"herausholen!")+
			     BS("Versuche es etwas spaeter wieder, oder es "
				"ist ein Bug, dann melde Dich bitte bei "
				"einem Magier."));
	      
	      if(ob1=deep_present("ankh", TP))
		{
		  ob1->remove();
		  ob->remove();
		  
		  call_out("fertig",0);
		  
		  return;
		}
	      
	      call_out("nicht_fertig",0);
	      
	      return;
	    }
	  
	  tell_object(ob2,
	       BS("Slartibart teilt Dir mit: Willst Du etwa wieder raus?!"));

	  return;
	}

      tell_object(ob2, 
	  BS("Slartibart teilt Dir mit: Da koennte ja jeder kommen."));

      return;
    }
  
  return;
}

void fertig()
{
  object ob;

  write(BS("Der Priester sagt: Toll, Du hast es geschafft!"));

  if(TP->GiveQuest(TURMQUEST) == 1)
  {
    write_file(TURMQUESTLOG,
      sprintf("%s  %s hat den Ankh wiederbeschafft.\n",
      dtime(time()), CAP(TP->query_real_name())));
  }

  while(ob=present("\nmuaddib_quest_item", TP))
    {
      ob->remove();
    }

  write(BS("Der Priester ist nun gluecklich mit seinem Ankh.")+
	BS("Der Priester verschwindet nach Norden."));
  
  remove(1);
}
  
void nicht_fertig()
{
  object ob;

  write(BS("Slartibart sagt enttaeuscht: Du hast das Ankh ja gar nicht."));

  while(ob=present("\nmuaddib_quest", TP))
    {
      ob->remove();
    }
  
}
