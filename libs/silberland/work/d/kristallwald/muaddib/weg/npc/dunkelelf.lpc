/*
** Ein boeser Elf
**
**
** 17-07-2002  PROtheG  Ueberarbeitung, Spell debuggt
*/

#include "../def.h"

inherit "/std/npc";

#define ELADEN "/d/kristallwald/sargola/dorf/room/lagerrau"

void create()
{
  if(!is_clone(ME)) return;
  
  ::create();

  SetProp(P_SHORT, "Ein elfischer Raeuber");
  SetProp(P_LONG, 
	  BS("Ein aus der Gemeinschaft der Elfen Ausgestossener, der "
	     "Wanderer ueberfaellt, um leben zu koennen."));
  SetProp(P_NAME, "Raeuber");
  SetProp(P_NAME_ADJ, "elfisch");
  AddAdjective(({"elfischer","elfischen","elfische"}));

  SetProp(P_GENDER, MALE);
  AddId(({"raeuber", "elf"}));

  create_default_npc(14);

  SetProp(P_ALIGN, -500);
  SetProp(P_BODY, 125);
  SetProp(P_HANDS, ({" mit blossen Haenden", 120, DT_BLUDGEON}));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE, ({DT_BLUDGEON}));
  SetProp(P_VULNERABILITY, DT_FIRE);
  SetProp(P_RACE, "Elf");
  SetProp(P_NOMAGIC, 25);

  SetChats(5,({"Der Raeuber sagt: Gib mir Dein Geld, sonst hole ich es mir!\n",
		"Der Raeuber wirft Erde nach Dir.\n",
		  "Der Raeuber schaerft seinen Rapier.\n"}));

  SetAttackChats(20,({
    "Der Raeuber stuerzt sich begeistert in den Kampf.\n",
      "Der Raeuber ueberrascht Dich mit einer Finte.\n",
      "Der Raeuber verteidigt sich geschickt.\n",
      "Der Raeuber schluepft unter Deinem Arm durch und greift Dich von hinten an.\n",
      "Der Raeuber sagt: Endlich mal wieder ein ordentlicher Kampf!\n"}));
  
  AddSpell(1,150,
      "Der Elf fasst Dir an den Kopf und murmelt etwas.\n",
      "Der Elf fasst @WEM an den Kopf ud murmelt etwas.\n",
      DT_MIND,"extract_sp", ([SP_SHOW_DAMAGE:1]));
  
  SetProp(P_SPELLRATE, 5);

  SetProp(P_DIE_MSG, " stuerzt sich mit letzter Kraft in seine Waffe.\n");
  /*
    SetProp(P_MURDER_MSG, "Eines Tages wird jemand meiner Gruppe Dich toeten"+
    TP->name(WEN, 2)+"\n");
  */
  SetProp(P_HEAL, -10);

  SetProp(P_REJECT, ({REJECT_KEEP,
			"Der Raeuber steckt @WEN dankbar ein.\n"}) );

  SUID;

  CLONEME("/p/weapon/sword/rapier");
  CLONEME(ARMOUR "waldruestung");
  command_me("ziehe waldruestung an");
  command_me("zuecke rapier");
}


void extract_sp(object enemy, int damage, mixed dam_type)
{
  enemy->AddSp(-10-random(10));
}

void give_notify(object obj)
{
  if(obj->id("muenzen") )
    if( obj->QueryProp(P_AMOUNT)<500 ) 
      {
	tell_room(MENV,"Der Raeuber schreit wuetend: Das war zuwenig!\n");
	Kill(TP);
	return ;
      }
    else
      {
	tell_room(MENV,"Der Raeuber ist zufrieden und laesst Dich passieren.\n");
	return ;
      }
  
  return ::give_notify(obj);
}

void schleichdich()
{
  if(!MENV) return;
  
  call_other(ELADEN, "???");
  
  tell_room(MENV, Name()+" verschwindet in den Bueschen...\n");
  
  move(find_object(ELADEN), M_NOCHECK|M_SILENT);
  
  call_out("remove", 0);
}
