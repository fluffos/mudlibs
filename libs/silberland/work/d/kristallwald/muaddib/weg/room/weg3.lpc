/*
**  Muaddib Weg
**
**  2003-03-25  PROtheG  Ueberarbeitet
*/

#include "room2.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Weg im Flachland");
  SetProp(P_INT_LONG, 
	  BS("Der Weg schlaengelt sich durch eine schoene, grosse Wiese, auf "
	     "der viele Blumen wachsen. Neben dem Weg wachsen immer mehr "
	     "Pflanzen, die auch in der Groesse zunehmen. Westlich neben dem "
	     "Weg siehst Du einen recht grossen Busch. Weiter im Norden "
	     "siehst Du einen Waldrand. Im Osten steht ein ziemlich hoher "
	     "Turm."));

  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_FOREST]));

  AddDetail("boden", 
	    E_WEG);

  AddDetail("turm", 
	    "Ein seltsamer Turm. Weit und breit sind keine Fenster zu sehen, "
	    "von Tueren ganz zu schweigen. Er ist ziemlich hoch.");

  AddDetail("aufmerksamkeit", 
	    "Davon sollte ein Abenteurer viel besitzen.");

  AddDetail("abenteurer", 
	    "Als was wuerdest Du Dich bezeichnen, wenn nicht als Abenteurer?");

  AddDetail("wald", 
	    "Der Wald faengt erst im Norden an.");

  AddDetail("himmel", 
	    "Der Himmel ist blau und klar.");

  AddDetail("groesse", 
	    "Eine generelle Einheit, um Objekte zu unterscheiden.");

  AddDetail("gras", 
	    "Gras gibt es hier zuhauf, teilweise von Erdhuegeln durchsetzt.");

  AddDetail("weg", 
	    E_WEG);

  AddDetail("pfad", 
	    "Man koennte den Pfad eigentlich als Weg bezeichnen.");

  AddDetail("erdhuegel",
	    "Du wunderst Dich, ob es hier wohl Maulwuerfe gibt.");

  AddDetail("maulwuerfe",
	    "Die werden wohl in ihren Hoehlen sein.");

  AddDetail("hoehlen", 
	    "Maulwurfhoehlen haben die Angewohnheit, unterirdisch zu sein.");

  AddDetail("luft", 
	    "Reine, klare Luft.");

  AddDetail("erde", 
	    "Hauptsaechlich weiche Erde.");

  AddDetail("wiese", 
	    "Du denkst daran, wie schoen es waere, wenn Du Dich da hinlegen "
	    "koenntest. Aber dazu hast Du ja keine Zeit, da Du Abenteuer "
	    "bestehen musst. Schade eigentlich.");

  AddDetail("abenteuer", 
	    "Du bist doch hier, um Abenteuer zu bestehen, oder?");

  AddDetail(({"einheit","objekt","objekte","wissen","moment","zeit"}), 
	    "Das hat eigentlich nichts mit Abenteuern zu tun.");

  AddDetail("gewissen", 
	    "Dein Gewissen haelt dich davon ab, die Blumen zu pfluecken, die "
	    "auch noch fuer andere beruhigend sein koennten.");

  AddDetail("waldrand", 
	    "Im Norden scheint ein groesserer Wald anzufangen.");

  AddDetail(({"pflanzen","graeser","gewaechse"}),
	    "Du siehst Blumen, Graeser und Gewaechse.");

  AddDetail(({"blume","blumen"}), 
	    "Du erkennst Loewenzahn, Sumpfdotterblumen und Mohnblumen, zu "
	    "mehr reicht Dein Wissen nicht aus.");

  AddDetail(({"loewenzahn", "sumpfdotterblume", "sumpfdotterblumen", 
		"mohnblume","mohnblumen"}), 
	    "Du wuerdest sie gerne pfluecken, aber Dein Gewissen laesst Dich "
	    "nicht.");

  AddSmell(({"blume","blumen","gras","graeser",DEFAULT_SMELL}), 
	   "Es riecht angenehm nach Blumen und Graesern.");

  AddSound(DEFAULT_SOUND, 
	   "Du hoerst das sanfte Rauschen des Windes in der Wiese.");

  AddSound("rauschen", 
	   "Ein beruhigendes Geraeusch.");

  AddDetail("wind", 
	    "Es weht ein lauer Wind.");

  AddDetail(({"busch"}),
	    "Der Busch ist sehr gross, ansonsten aber ganz normal.");
  
  AddExit("norden",ROOM "weg4");
  AddExit("sueden",ROOM "weg2");
  
  AddItem(NPC "priester", REFRESH_DESTRUCT);
}
