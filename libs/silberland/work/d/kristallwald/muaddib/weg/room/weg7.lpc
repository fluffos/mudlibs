#include "room2.h"

inherit "/std/room";

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Ein Waldweg");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich auf einem Weg, der durch dichten Wald "
	     "fuehrt. Der Wald ist hier so dicht, dass Du keine Wahl hast, "
	     "Du musst auf dem Weg bleiben. Die Baeume strahlen eine "
	     "unangenehme Aura aus, Dir laeuft es bei dem Gedanken an die "
	     "moeglichen Gefahren trotz Deines Mutes kalt den Ruecken runter. "
	     "Eigentlich moechtest Du nur noch weg von hier. Im Nordwesten "
	     "wird der Waldweg breiter und Du kannst schon eine Kreuzung "
	     "erkennen."));

  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_FOREST]));

  AddDetail("himmel", 
	    "Den Himmel siehst Du durch die dichten Baeume nicht so genau.");

  AddDetail("erde", 
	    "Der typische Waldboden.");

  AddDetail("waldboden",
	    "Nadeln, Laub, und Aeste.");

  AddDetail("wald", 
	    "Du stehst in einem dichten Wald, der Dich mit seiner gruenen "
	    "Farbe beruhigt.");

  AddDetail("farbe",
	    "Ueber Farben weisst Du nur grundsaetzliches.");

  AddDetail("kreuzung", 
	    "Die Kreuzung ist noch ein Stueck weit entfernt.");

  AddDetail("gefahr", 
	    "Du denkst an Raeuber und Wegelagerer, die hier lauern koennten.");

  AddDetail("nadeln", 
	    "Die sind wohl von den Tannen gefallen.");

  AddDetail("laub", 
	    "Die koennten von den Laubbaeumen gefallen sein."); 

  AddDetail("laubbaeume", 
	    "Baeume, die Laub tragen. Im Gegensatz zu Nadelbaeumen wie zum "
	    "Beispiel Tannen.");

  AddDetail("harz", 
	    "Harz ist eine Substanz, die von Nadelbaeumen abgesondert wird.");

  AddDetail("pfad", 
	    "Ein Pfad im Wald.");

  AddSmell(DEFAULT_SMELL, 
	   "Es riecht nach Harz.");

  AddSmell("harz",
	   "Du riechst frisches Harz.");

  AddDetail("baeume", 
	    "Die Baeume stehen auffaellig dicht. Ein Baum faellt Dir "
	    "besonders auf.");

  AddDetail("boden", 
	    "Angenehmer, weicher Waldboden.");

  AddDetail(({"nadeln", "nadel", "zweige"}), 
	    "Das liegt hier am Boden rum.");

  AddDetail("kristallwald", 
	    "Bald kannst Du Dich von der Schoenheit des Kristallwaldes "
	    "selbst ueberzeugen.");

  AddDetail("schoenheit",
	    "Von der Schoenheit des Kristallwaldes hast Du schon viele "
	    "Geruechte gehoert.");

  AddDetail("geruechte", 
	    "Geruechte, wie man sie in Kneipen so hoert.");
  
  DUSTY;
  WOODY;
  
  AddDetail("aura", 
	    "Du fuehlst Dich ob dieser Aura unwohl.");

  AddDetail("baum", 
	    "Du hast Dich wohl getaeuscht. So besonders ist der nicht.");

  AddDetail("gedanken", 
	    "Das kann Dir niemand sagen.");

  AddDetail("mut", 
	    "Hast Du sowas?");

  AddDetail(({"raeuber","wegelagerer"}),
	    "Auf solchen Pfaden bist Du nie vor Raeubern und Wegelagerern "
	    "sicher.");
  
  AddDetail(({"waldweg","weg"}), E_WEG);
  
  AddExit("sueden",ROOM "weg6");
  AddExit("nordwesten",WEG_DORF);
}
