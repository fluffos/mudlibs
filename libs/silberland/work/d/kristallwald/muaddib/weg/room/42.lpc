/*
** Muaddib Lichtung
**
** 17-07-2002  PROtheG  Ueberarbeitung
*/

#include "room2.h"

inherit "/std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine kleine Lichtung");
  SetProp(P_INT_LONG, 
	  BS("Du stehst auf einer kleinen Lichtung und kannst Dir eigentlich "
	     "nicht vorstellen, warum sie so scharf von den Raeubern bewacht "
	     "wurde. Der Boden ist weich und schlammig, nur ein einzelner "
	     "Stein liegt in der Mitte der Lichtung. Die Voegel zwitschern "
	     "vergnuegt - im ganzen ein angenehmer Ort."));

  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);

  AddDetail("lichtung", 
	    "Die Lichtung ist fast kreisrund. Du kannst Dir vorstellen, dass "
	    "dieser Ort von oben betrachtet wie ein sauber aus dem Wald "
	    "geschnittener Kreis aussieht.");

  AddDetail("kreis", 
	    "Du stehst in einem Kreis von Baeumen; hier scheint wirklich ein "
	    "Magier mit einem Zirkel gearbeitet zu haben, was ja eher selten "
	    "passiert.");

  AddDetail("wegelagerer", 
	    "Die Raeuber scheinen sich nicht herein zu trauen.");

  AddDetail("inschrift", 
	    "Du kannst sie lesen.");

  AddDetail("gefuehl", 
	    "Du hast das Gefuehl, dass der Stein nicht ganz ungefaehrlich "
	    "ist.");

  AddDetail("zirkel", 
	    "Hast Du hier einen gesehen? Dann geh zum Arzt.");

  AddDetail("alles", 
	    "Wie, alles? Du glaubst doch nicht im Ernst, dass man es Dir so "
	    "einfach machen wird, oder?");

  AddDetail("einfach", 
	    "Einfacher ist es sicherlich, einzuschlafen.");

  AddDetail("aura", 
	    "Du glaubst, die Lichtung hat was mit der fruehen Zeit der Welt "
	    "zu tun.");

  AddDetail("fruehzeit", 
	    "Die Fruehzeit war die Zeit weit vor Deiner Geburt.");

  AddDetail(({"boden","weg","bodenverhaeltnisse"}), 
	    "Der Boden ist einfach nur schlammig und feucht. Mit jedem "
	    "Schritt musst Du aufpassen, nicht tiefer einzusinken.");

  AddDetail("stein", 
	    "Der Stein ist aus einem Material, das definitiv nicht aus "
	    "diesem Teil der Welt zu kommen scheint. Du willst auch gar "
	    "nicht wissen, was das genau ist, denn Du ahnst ein gewisses "
	    "diabolisches Potential. Er ist tiefschwarz, glatt poliert und "
	    "trotz der widrigen Bodenverhaeltnisse extrem sauber. Vielleicht "
	    "kannst Du auf der Unterseite auch noch was finden. Auf der "
	    "anderen Seite willst Du das eigentlich nicht. Auf der Oberseite "
	    "entdeckst du eine Inschrift.");

  AddReadDetail("inschrift", 
		"Auf dem Stein steht in grosser Schrift: ZWEIUNDVIERZIG\n"
		"Darunter steht klein: Die Unterseite ist der Schluessel zur "
		"absoluten Ruhe.");
  
  AddDetail(({"unterseite"}),
	    "Dazu muesstest Du den Stein schon umdrehen.");
  
  AddDetail("material", 
	    "Du kannst das Material nicht richtig zuordnen, aber eigentlich "
	    "moechtest Du den Stein nicht weiter untersuchen.");

  AddDetail(({"baum", "baeume"}), 
	    "Ganz normale Baeume, wie sie in jedem Wald vorhanden sind.");
  
  AddDetail("wald", 
	    "Du stehst in einem ganz normalen Wald.");
  
  AddDetail("oberseite", 
	    "Die Oberseite ist fuer gewoehnlich oben.");
  
  AddDetail("schwarz", 
	    "Die Meinungen verschiedener Leute ueber Schwarz differieren. "
	    "Manche rechnen es zu Farben, manche nicht.");
  
  AddDetail("magier",
	    "Die Verantwortlichen fuer den Inhalt der Welt.");

  AddDetail("welt", 
	    "Du stehst auf der Welt.");
  
  AddDetail(({"mitte","randpunkte"}), 
	    "Von der geometrischen Mitte eines Kreises sind alle "
	    "Randpunkte gleichweit entfernt.");

  AddDetail("ort", 
	    "Dieser Ort ist Dir unheimlich.");

  AddDetail("raeuber", 
	    "Der Raeuber ist lieber draussen geblieben. Vielleicht ist ihm "
	    "der Raum unheimlich.");
  
  AddDetail(({"geraeuschentwicklung","arzt","farben"}), 
	    "Du koenntest auf der Wissenschaftsebene mal eine Anfrage "
	    "posten.");

  AddDetail("ahnung", 
	    "Wenn Du die schon untersuchen musst, scheinst Du davon nicht "
	    "gerade viel zu haben.");

  AddDetail("wissenschaftsebene", 
	    "Das solltest Du langsam wissen, wie man in Ebenen kommentiert.");

  AddDetail("himmel", 
	    "Durch die Luecke in den Baeumen ist der klare Himmel gut zu "
	    "erkennen.");

  AddDetail("luecke", 
	    "Durch die Lichtung bedingt kann man den Himmel sehen.");

  AddDetail("voegel", 
	    "Das fuer einen Wald uebliche Kontingent an Voegeln.");

  AddSound(DEFAULT_SOUND, 
	   "Du hoerst die Voegel zwitschern.");

  AddCmd(({"drehe","dreh"}), "dreh_stein");

  AddExit("westen", ROOM+"weg5");
}

nosave int dreh_stein(string str)
{
  notify_fail(BS("Was willst Du drehen?"));
  if(!str) return 0;

  if(str=="stein"||str=="stein um")
  {
    //if(random(10)<3 && (counterX%3==0)) 
    if(random(TP->QueryAttribute(A_DEX))<15)
      {
	write(BS("Bei genauerer Untersuchung explodiert ploetzlich etwas in "
		 "Deiner Naehe mit enormer Geraeuschentwicklung."));

	say(BS(TPN+" wird von einer Explosion eingehuellt."));

	TP->SetProp(P_DEAF, TP->QueryProp(P_LEVEL)*3);

	write(BS("Es wird still."));
	write(BS("Du denkst, dass Du Deinem urspruenglichem Gefuehl, was "
		 "diesen Stein angeht, haettest trauen sollen."));

	return 1;
      }
    else 
      return write(BS("Von unten betrachtet ist das ein ganz normaler "
		      "Stein.")), 1;
  }
  
  return 0;
}  
