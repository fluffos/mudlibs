#include "../def.h"

inherit "std/room";

#pragma strong types;

nosave int treppe, verankerung;

void create()
{
  if(!is_clone(TO)) return;
  ::create();
    
  SetProp(P_INT_SHORT, "Das erste Obergeschoss des Turmes");
  SetProp(P_INT_LONG, 
	  BS("Du stehst in einem Geschoss, das sich von dem unteren nur "
	     "durch das herrschende Chaos unterscheidet. Hier liegt "
	     "massenhaft Geruempel herum und Du wunderst Dich, woher das "
	     "ganze Zeugs wohl kommt, wo doch hier nie jemand gelebt hat."));

  SetProp(P_NOMAGIC, 100);
  SetProp(P_NOREST,  
          "Ausrasten? Hier? Hast Du etwa Deine Aufgabe vergessen?\n"); 
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:10]));
  
  AddDetail("boden", 
	    "Der Boden besteht aus Stein.");
  
  AddDetail("decke", 
	    "Die Decke besteht aus Stein.");

  AddDetail(({"wand","waende"}), 
	    "Die Waende bestehen aus Stein.");

  AddDetail("stein", 
	    "Der ganze Raum scheint aus Stein zu bestehen.");

  AddDetail(({"raum","geschoss"}),
	    "Du stehst in einem Raum.");

  AddDetail("chaos", 
	    "Anders kann man das nicht bezeichnen.");

  AddDetail(({"stein","steine"}),
	    "Einfache Steine.");
   
  AddDetail(({"staub","dreck"}),
	    "Besonders sauber ist es hier nicht.");

  AddDetail("stockwerk", 
	    "Wenn Du Dich nicht verzaehlt hast, befindest Du Dich im "
	    "1. Stockwerk.");

  AddDetail("mauer",
	    "Die Mauer besteht aus Steinen.");

  AddDetail(({"geruempel","zeugs","zeug"}),
	    "Hier liegt soviel rum, dass Du nicht weisst, wo Du "
	    "anfangen sollst. Ein Haufen faellt Dir allerdings auf.");
  
  AddDetail("haufen",
	    "Vielleicht kannst Du ihn durchwuehlen?");

  AddDetail(({"turm","gemaeuer"}), 
	    "Der Turm, in dem Du stehst.");  

  AddCmd(({"durchwuehl","wuehl","durchwuehle","wuehle"}), "wuehle_haufen");

  treppe=0;
  
  previous_object()->CustomizeObject();
}

int nach_oben()
{
  TP->move(ROOM "ebene1:"+getuid(TP), M_GO);

  return 1;     // bugfix woody
}

varargs string int_long(mixed v, mixed vp, int f)
{
  SetProp(P_INT_LONG,
	  BS("Du stehst in einem Geschoss, das sich von dem unteren nur "
	     "durch das herrschende Chaos unterscheidet. Hier liegt "
	     "massenhaft Geruempel herum und Du wunderst Dich, woher das "
	     "ganze Zeugs wohl kommt, wo doch hier nie jemand gelebt hat.")+
	  (treppe ? "Du siehst eine Treppe, die nach oben fuehrt.\n":""));
  
  return ::int_long(v, vp, f);
}

nosave int wuehle_haufen(string str)
{
  object sch;

  notify_fail(BS("WAS willst Du durchwuehlen?"));
  if(!str) return 0;

  if(str=="in haufen"||str=="haufen")
    if(verankerung)
      return write(BS("Hier hast du schon alles durchsucht.")+
		   BS("Du siehst nur die Verankerung, wo Du den Hebel "
		      "herausgerissen hast.")), 1;
    else
      {
	write(BS("Du wuehlst...und wuehlst...und wuehlst..."));
	
	if(deep_present("schatulle", TP)) 
	  write(BS("Du findest eigentlich nur noch diesen Hebel."));
	else 
	  {
	    sch=clone_object(OBJ "schatulle");
	    
	    if(sch->move(TP, M_GET)==ME_TOO_HEAVY)
	      {
		write(BS("Nachdem Du den groessten Teil des Haufens zur Seite "
			 "geraeumt hast, findest Du eine Schatulle, doch als "
			 "Du sie nehmen willst, faellt sie Dir aus der "
			 "Hand.")+
		      BS("Aus den Augenwinkeln bemerkst Du einen Hebel."));

		sch->move(ME, M_NOCHECK);
	      }
	    else
	      write(BS("Nachdem Du den groessten Teil des Haufens zur Seite "
		       "geraeumt hast, findest Du eine Schatulle und nimmst "
		       "sie an Dich.")+
		    BS("Aus den Augenwinkeln bemerkst Du einen Hebel."));
	    
	  }
      
	AddDetail("hebel", 
		  "Ein einfacher Hebel, der locker in seiner Verankerung "
		  "sitzt.");
	
	AddDetail("verankerung",
		  "Eine Verankerung mit einem Hebel.");
	
	AddCmd(({"zieh","ziehe"}),"zieh_hebel");
	
	return 1;
      }
  
  return 0;
}

nosave int zieh_hebel(string str)
{
  notify_fail(BS("Was willst Du ziehen?"));
  if(!str) return 0;
  
  if(str=="hebel"||str=="an hebel"||str=="am hebel")
    if(verankerung)
      return write(BS("Das hast Du doch schon laengst gemacht.")), 1;
    else
      {
	write(BS("Du ziehst an dem Hebel und reisst ihn somit aus seiner "
		 "Verankerung.")+
	      BS("Du wirfst den Hebel frustriert weg und fragst Dich, was "
		 "Du jetzt machen sollst? Ein Gefuehl sagt Dir, dass der "
		 "Hebel wichtig war."));

	verankerung=1;
	
	AddDetail("verankerung", 
		  "Die Verankerung des Hebels scheint noch funktionstuechtig "
		  "zu sein. Nur fehlt halt jetzt der Hebel. Vielleicht "
		  "koennte man da was machen?");
	
	AddDetail("hebel", 
		  "Der Hebel ist nicht mehr zu gebrauchen, daher laesst Du "
		  "ihn liegen.");
	
	AddCmd(({"steck","stecke"}), "steck_schwert");
	
	return 1;
      }
  
  return 0;
}

nosave int steck_schwert(string str)
{
  string what;
  object waffe;

  notify_fail(BS("Was willst Du wohin stecken?"));
  if(!str) return 0;

  if(sscanf(str, "%s in verankerung", what)!=1)
    return 0;

  if(!objectp(waffe=TP->QueryProp(P_WEAPON)))
    return write(BS("Du hast ja keine Waffe gezueckt!")), 1;
  
  if(waffe->id(what))
    if(!treppe)
      {
	write(BS("Du steckst Deine Waffe in die Verankerung und ziehst "
		 "langsam am Hebel. Du hattest recht! Eine Treppe, die "
		 "Du erst jetzt bemerkst, senkt sich von der Decke."));
	
	AddDetail("treppe", 
		  "Du siehst eine einfache hoelzerne Treppe.");
	
	AddDetail("holz",
		  "Das ist eine hoelzerne Treppe. Daher besteht sie aus "
		  "Holz.");

	treppe=1;
	
	AddSpecialExit(({"oben","treppe"}),"nach_oben");
	
	return 1;
      }
    else return write(BS("Das hast Du ja schon getan.")), 1;
  
  return write(BS("Wieso benutzt Du dafuer denn nicht Deine Waffe?")), 1;
}

varargs string GetExits(object v)
{
  if(!sizeof(QueryProp(P_SPECIAL_EXITS))) 
    return "";
  
  return ::GetExits(v);
}
