#include "room2.h"

inherit "/std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Lichtung");
  SetProp(P_INT_LONG, 
	  BS("Du stehst auf einer Lichtung mitten im Wald. Die "
	     "Baeume stehen hier um die Lichtung herum ziemlich "
	     "dicht. Der Boden besteht aus weicher, von Nadeln "
	     "und Zweigen bedeckter Erde. Im Osten siehst Du "
	     "einen bewachten Hohlweg zu einer weiteren "
	     "Lichtung, im Sueden geht es weiter durch den Wald "
	     "und im Norden geht es in Richtung Kristallwald "
	     "weiter."));
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_FOREST]));

  AddDetail("gefahr", 
	    "Du denkst an Raeuber und Wegelagerer, die hier lauern koennten.");

  AddDetail("himmel", 
	    "Den Himmel siehst Du durch die dichten Baeume nicht so genau.");

  AddDetail("erde", 
	    "Der typische Waldboden.");

  AddDetail("waldboden",
	    "Nadeln, Laub, und Aeste.");

  AddDetail("wald", 
	    "Du stehst in einem dichten, gruenen Wald.");

  AddDetail("nadeln", 
	    "Die sind wohl von den Tannen gefallen.");

  AddDetail("laub", 
	    "Die koennten von den Laubbaeumen gefallen sein."); 

  AddDetail("laubbaeume", 
	    "Baeume, die Laub tragen. Im Gegensatz zu Nadelbaeumen wie "
	    "zum Beispiel Tannen.");

  AddDetail("nadelbaeume", 
	    "Baeume, die im Gegensatz zu Laubbaeumen Nadeln tragen.");

  AddDetail(({"tanne","tannen"}), 
	    "Du weisst sicher, dass Tannen zu den Nadelbaeumen gehoeren. "
	    "Eine weitere Unterteilung kannst Du nicht machen.");

  AddDetail("harz", 
	    "Harz ist eine Substanz, die von Nadelbaeumen abgesondert wird.");

  AddDetail("lichtung", 
	    "Eine Lichtung im Wald.");

  AddSmell(DEFAULT_SMELL, 
	   "Es riecht nach Harz.");

  AddDetail("baeume", 
	    "Die Baeume stehen auffaellig dicht.");

  AddDetail("boden", 
	    "Angenehmer, weicher Waldboden.");

  AddDetail(({"aeste", "nadeln", "nadel", "zweige"}), 
	    "Das liegt hier am Boden rum.");

  AddDetail("hohlweg", 
	    "Der Hohlweg ist gut bewacht. Du wunderst Dich, was dahinter "
	    "sein mag.");

  AddDetail("kristallwald", 
	    "Bald kannst Du Dich von der Schoenheit des Kristallwaldes "
	    "selbst ueberzeugen.");

  AddDetail("schoenheit",
	    "Von der Schoenheit des Kristallwaldes hast Du schon viele "
	    "Geruechte gehoert.");

  AddDetail("geruechte", 
	    "Geruechte, wie man sie in Kneipen so hoert.");

  AddExit("sueden", ROOM "weg4");
  AddExit("norden", ROOM "weg6");

  AddGuardedExit("osten", ROOM "42", "raeuber", 
		 "Der Raeuber laesst Dich nicht durch.\n");

  AddItem(NPC "dunkelelf", REFRESH_DESTRUCT);  
}
