#include "../def.h"

inherit "std/room";

#pragma strong types;

nosave int treppe;

void create()
{
  if(!is_clone(TO)) return;
  ::create();
    
  SetProp(P_INT_SHORT, "Das Erdgeschoss des Turmes");
  SetProp(P_INT_LONG, 
	  BS("Du stehst in einem dunklen Raum im Erdgeschoss des verzauberten "
	     "Turms. Die Waende sind allesamt rund und eben aus Stein gebaut. "
	     "Dich durchstroemt eine Aura, wie Du sie noch nie gefuehlt hast. "
	     "Irgendetwas Daemonisches geht vor sich in diesen alten "
	     "Gemaeuern."));

  SetProp(P_NOMAGIC, 100);
  SetProp(P_NOREST, 
	  "Ausrasten? Hier? Hast Du etwa Deine Aufgabe vergessen?\n");
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:10]));

  AddDetail("stein",
	    "Die ganzen Waende sind aus rohem Stein gefertigt.");

  AddDetail("raum", 
	    "Ein dunkler Raum in einem Turm.");

  AddDetail(({"erdgeschoss","geschoss"}), 
	    "Du fragst Dich, wieviele Geschosse es in diesem Turm wohl gibt.");

  AddDetail("turm", 
	    "Dieser Turm stellt alles, was Du darueber gehoert hast, in den "
	    "Schatten.");

  AddDetail("aura", 
	    "Du fragst Dich, ob es so klug war, dem alten Mann zu "
	    "helfen. Es ist ziemlich kalt und ziemlich unheimlich.");

  AddSound("geraeusche", 
	   "Du bekommst fuerchterliche Angst.");

  AddDetail("angst", 
	    "Normalerweise ist es gut, seine Angst rauszulassen.");

  AddDetail(({"mann","priester"}), 
	    "Naja, von wem hast Du Deinen Auftrag?");

  AddDetail(({"staub","dreck"}),
	    "Du musst husten, als Du den Staub naeher untersuchst.");

  AddDetail(({"decke","waende","wand"}), 
	    "Die Decke besteht wie auch die Waende aus Stein ohne "
	    "Besonderheiten.");

  AddDetail(({"stein","steine"}),
	    "Einfache Steine. Nichts weiter.");

  AddDetail("mauer",
	    "Die Mauer besteht aus Steinen.");
    
  AddDetail("besonderheiten",
	    "Du siehst keine.");

  AddDetail("boden", 
	    "Der Boden ist extrem staubig. Gegenueber von Dir kannst "
	    "Du einen Weidenkorb erkennen.");

  AddDetail(({"weidenkorb","korb"}), 
	    "Ausser der Tatsache, dass Du den Korb nicht heben kannst, "
	    "faellt Dir nichts auf. Vielleicht kannst Du ihn oeffnen?");

  AddDetail(({"auftrag","quest"}), 
	    "Dein Auftrag ist es, das Ankh des Priesters zu finden.");

  AddDetail("ankh", 
	    "Such es erstmal.");

  AddDetail(({"turm","gemaeuer"}), 
	    "Der Turm, in dem Du stehst.");

  AddCmd(({"dreh","drehe"}),"dreh_korb");
  AddCmd(CMD_OEFFNEN,"oeffne_korb");
  AddCmd(({"heb","hebe"}), "heb_korb");

  treppe=0;
  
  previous_object()->CustomizeObject();
}

void init()
{
  ::init();

  // Erstmal checken, ob es sich hier ueberhaupt um den Clone
  // handelt, der fuer TP 'zustaendig' ist, oder ob es z.B. ein
  // verfolgender Magier (bzw. Haustier o.ae.) ist...
  // -- habe den Teil bei Woody geklaut --
  if(explode(file_name(ME),":")[<1] != getuid(TP))
    TP->move(ROOM "weg3", M_GO);
}

varargs string int_long(mixed v, mixed vp, int f)
{
  SetProp(P_INT_LONG,
	  BS("Du stehst in einem dunklen Raum im Erdgeschoss des verzauberten "
	     "Turms. Die Waende sind allesamt rund und eben aus Stein gebaut. "
	     "Dich durchstroemt eine Aura, wie Du sie noch nie gefuehlt hast. "
	     "Irgendetwas Daemonisches geht vor sich in diesen alten "
	     "Gemaeuern.")+
	  (treppe ? "Du siehst eine Treppe, die nach oben fuehrt.\n":""));
  
  return ::int_long(v, vp, f);
}

nosave int dreh_korb(string str)
{
  notify_fail(BS("Was willst Du drehen?"));
  if(!str) return 0;

  if(str=="korb" || str=="weidenkorb")
    if(treppe)
      return write(BS("Das hast Du ja schon laengst getan.")), 1;
    else
      {
	write(BS("In dem Moment, wo Du den Korb drehst, wird eine Treppe "
		 "heruntergelassen.")); 
	
	AddDetail(({"treppe","stiege"}), 
		"Du siehst eine einfache hoelzerne Treppe.");
	
	AddDetail("holz",
		  "Die Treppe ist aus normalem Holz gebaut.");
	
	treppe=1;
	
	AddSpecialExit(({"oben","treppe"}),"nach_oben");
	
	return 1;
      }
  
  return 0;
}

int nach_oben()
{
  TP->move(ROOM "ebene0:"+getuid(TP), M_GO);
  
  return 1;     // bugfix woody
}

nosave int heb_korb(string str)
{
  notify_fail(BS("Was willst Du heben?"));
  if(!str) return 0;

  if(str=="korb"||str=="weidenkorb")
    return write(BS("Du kannst den Korb wirklich nicht hochheben. Er scheint "
		    "befestigt zu sein.")+
		 BS("Vielleicht kannst Du ihn oeffnen?")), 1;
  
  return 0;
}

nosave int oeffne_korb(string str)
{
  object draht;

  notify_fail(BS("Was willst Du oeffnen?"));
  if(!str) return 0;

  if(str=="korb"||str=="weidenkorb") 
    {
      write(BS("Du oeffnest den Korb und wuehlst etwas herum..."));
      
      if(deep_present("\ndraht", TP)) 
	write(BS("Du findest nichts mehr in dem Korb."));
      else
	if(!random(2)) 
	  {
	    draht=clone_object(OBJ "draht");
	    
	    if(draht->move(TP, M_GET)==ME_TOO_HEAVY)
	      {
		write(BS("Du findest ein Stueck Draht, doch er ist Dir zu "
			 "schwer, daher laesst Du ihn im Korb."));
		
		draht->remove(1);
	      }
	    else
	      write(BS("Du findest ein Stueck Draht und steckst es ein."));
	  } 
      
      write(BS("Du bemerkst, dass der Korb unten festgeschraubt ist.")+
	    BS("Vielleicht kannst Du ihn ja drehen?"));
      
      AddDetail(({"schraube","schrauben"}),
		"Tatsaechlich, der Korb ist angeschraubt!");
      
      return 1;
    }
  
  return 0;
}

varargs string GetExits(object v)
{
  if(!sizeof(QueryProp(P_EXITS))) 
    return "";
  
  return ::GetExits(v);
}
