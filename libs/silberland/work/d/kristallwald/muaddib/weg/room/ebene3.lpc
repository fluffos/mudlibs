#include "../def.h"

inherit "/std/room";

#pragma strong types;

nosave int ankh_da, alt_offen;

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_INT_SHORT,"Das oberste Geschoss des Turmes");
  SetProp(P_INT_LONG,
	  BS("Du stehst in einem Raum, der ein wenig wie eine "
	     "Kirche eingerichtet ist. Alles ist aus rohem Stein "
	     "gehauen und in der Mitte steht ein grosser Altar."));

  SetProp(P_NOMAGIC, 100);
  SetProp(P_NOREST,  
          "Ausrasten? Hier? Hast Du etwa Deine Aufgabe vergessen?\n"); 
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:10]));
  
  AddDetail(({"raum","ebene","stockwerk","obergeschoss"}),
	    "Der Raum strahlt eine unheimliche Aura aus. Hier moechtest "
	    "Du so schnell wie moeglich wieder weg.");

  AddDetail("boden",
	    "Der Boden ist aus rohem Stein.");

  AddDetail(({"wand","waende"}),
	    "Die Waende bestehen aus rohem Stein.");

  AddDetail(({"mitte","untersuchung","welt"}),
	    "Das ist nun wirklich nicht so wichtig.");

  AddDetail("vorderseite",
	    "Die Vorderseite des Altares ist schoen verziert.");

  AddDetail("aura",
	    "Der Raum wirkt sehr duester und bedrueckend.");

  AddDetail("kirche",
	    "Die Aehnlichkeit zu einer Kirche ist unverkennbar. Ueberall "
	    "sind Goetzenbilder aufgestellt und der Raum hat eine "
	    "unheilige Aura.");

  AddDetail("goetzenbilder",
	    "Eines steht fest: Dusty und Woody werden nicht dargestellt.");

  AddDetail(({"aehnlichkeit","ausstattung"}),
	    "Man kann deutlich eine kirchenaehnliche Ausstattung erkennen.");

  AddDetail(({"dusty","woody"}),
	    "Man sagt, sie haben die Welt erschaffen.");

  AddDetail("decke", 
	    "Die Decke besteht aus rohem Stein.");

  AddDetail("stein",
	    "Der Raum ist aus rauhem Stein gebaut.");

  AddDetail(({"steinplatte","platte"}),
	    "Bei genauerer Untersuchung stellt sich heraus, dass der Altar "
	    "unterhalb der Platte hohl sein muss.");

  AddDetail("verzierungen",
	    "Eine Spirale wirkt deplaziert auf Dich.");
  
  AddDetail(({"turm","gemaeuer"}), 
	    "Der Turm, in dem Du stehst.");  
  
  AddSpecialDetail("spirale","spira_altar");
  AddSpecialDetail("altar","x_altar");

  ankh_da=1;
  alt_offen=0;

  previous_object()->CustomizeObject();
}

string x_altar()
{
  if(!alt_offen)
    return BS("Er ist aus Stein gebaut und besitzt eine schwere Steinplatte. "
	      "An der Vorderseite sind mehrere Verzierungen angebracht.");

  if(ankh_da)
    {
      AddCmd(CMD_NEHMEN,"nimm_ankh");
	
      AddDetail("ankh", 
		"Das liegt hier auf einem Kissen.");
	
      AddDetail("kissen", 
		"Ein normales Kissen halt.");
      
      return BS("Ein Ankh liegt auf einem Kissen.");
    }  
  
  return BS("Da liegt ein Kissen.");
}

string spira_altar()
{
  if(alt_offen) 
    return BS("Du hast doch schon draufgedrueckt.");
  
  AddCmd(({"drueck","druecke"}), "drueck_spira");
  
  return BS("Vielleicht kannst Du die Spirale druecken?");
}

nosave int drueck_spira(string str)
{
  notify_fail(BS("Was willst Du druecken?"));
  if (!str) return 0;

  if(str=="spirale"||str=="verzierung")
    {
      write(BS("Du drueckst die Spirale und die Steinplatte auf dem Altar "
	       "schwingt herum."));

      alt_offen=1;

      return 1;
    }

  return 0;
}

nosave int nimm_ankh(string str)
{
  object ob;

  notify_fail(BS("Was willst Du nehmen?"));
  if(!str) return 0;

  if(explode(str, " ")[0]!="ankh")
    return 0;
  
  if(present("ankh", ENV(TP)))
    return 0;

  if(deep_present("ankh",TP))
    return write(BS("Aber Du hast doch bereits ein Ankh!")), 1;

  if(!ankh_da)
    return write(BS("Da liegt weit und breit kein Ankh.")), 1;

  ob=clone_object(OBJ"ankh");
  if(ob->move(TP, M_GET)==ME_TOO_HEAVY)
    {
      write(BS("Du nimmst das Ankh vom Altar, doch es faellt Dir aus der "
	       "Hand auf den Boden. Hoffentlich ist es nicht beschaedigt!"));
      
      ob->move(ME, M_NOCHECK);
    }
  else
    write(BS("Du nimmst das Ankh vom Altar."));
    
  ankh_da=0;

  return 1;
}
