#include "room2.h"

inherit "/std/room";

#include "/d/huegelland/feyaria/weg/directions.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Weg im Gebirge");
  SetProp(P_INT_LONG, 
	  BS("Du stehst auf einem schmalen Weg. Irgendwie hast Du ein "
	     "komisches Gefuehl bei der ganzen Sache, so, als ob irgendetwas "
	     "mit diesem Weg nicht stimmen wuerde. Der Wald hoert hier ganz "
	     "ploetzlich auf und um Dich herum siehst Du nur Steine. Kein "
	     "einziger Busch waechst hier; es ist fast totenstill und die "
	     "paar Geraeusche, die Du hoerst, kannst Du nicht richtig orten. "
	     "Am Wegrand steht ein Schild. Im Sueden siehst Du einen Wald."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_MOUNTAIN]));

  AddDetail("boden", 
	    "Der Boden ist ziemlich steinig.");

  AddDetail(({"abgeschiedenheit","einsamkeit"}), 
	    "In der Abgeschiedenheit des Waldes fuehlst Du Dich besonders "
	    "wohl.");

  AddDetail(({"berg","berge","gebirge"}), 
	    "Rundherum siehst Du einige Berge.");

  AddDetail("busch", 
	    "Buesche gibt es hier wirklich nicht.");

  AddDetail("gaensehaut", 
	    "Die ganze Gegend bringt Dich zum froesteln.");

  AddDetail("geraeusche", 
	    "Die kannst Du so nicht untersuchen.");

  AddDetail("gegend", 
	    "Du bist irgendwo zwischen Kristallwald und Gebirge.");

  AddDetail("mut", 
	    "Hast Du sowas?");

  AddDetail("schild", 
	    "Vielleicht kannst Du es lesen?");

  AddDetail("wald", 
	    "Wenn Du nach Norden gehst, laesst Du den Wald hinter Dir.");

  AddDetail("kristallwald", 
	    "Ein sagenumwobener Wald mit kristallinen Baeumen.");

  AddDetail(({"baum", "baeume"}), 
	    "Ein Wald besteht aus Baeumen.");

  AddDetail("wegrand", 
	    "Ausser einem Schild siehst Du nichts erwaehnenswertes.");

  AddDetail("himmel", 
	    "Der Himmel ist tiefblau und klar.");

  AddDetail("tiefblau", 
	    "Tiefblau ist eine Farbe.");

  AddDetail("farben", 
	    "Farben interpretiert Dein Gehirn, oder so aehnlich. Deine "
	    "mangelhaften Biologiekenntnisse machen sich bemerkbar.");

  AddDetail("biologie", 
	    "Biologie ist die Lehre vom Leben und damit hier eher "
	    "unangebracht.");

  AddDetail("steine", 
	    "Am Weg liegen Steine der verschiedensten Arten herum.");

  AddDetail("arten", 
	    "Du muesstest einen Geologen fragen.");

  AddDetail("geologe", 
	    "Du bist definitiv keiner.");

  AddDetail("sonne", 
	    "Die Sonne brennt unbarmherzig vom Himmel.");

  AddDetail("erde", 
	    "Von Erde siehst Du hier weit und breit nichts.");

  AddDetail("weg",
	    E_WEG);

  AddDetail("luft", 
	    "Weiche, reine Luft, die Dir durch die Lungen stroemt.");

  AddDetail("lungen", 
	    "Gewebe zum Atmen, genauer weisst Du das auch nicht, da Du "
	    "kein Biologe bist.");

  AddDetail("gefuehl", 
	    "Die Einsamkeit und Abgeschiedenheit des Weges beschert Dir eine "
	    "Gaensehaut. Wenn Du doch bloss jemanden dabei haettest, der Dir "
	    "Mut machen koennte.");

  AddDetail("sache",
	    "Du musst schon selber wissen, was Du hier machst.");

  AddSound(({"geraeusch","geraeusche"}), 
	   E_SOUND);

  AddSound(DEFAULT_SOUND, 
	   "Du hoerst die typischen Geraeusche des Waldes.");

  AddReadDetail("schild", E_SCHILD);

  SetProp(P_HIDE_EXITS, ({ED6, ED2}));

  AddExit(({ED6, ED6U}), ROOM "weg2");
  AddExit(({ED2OB, ED2}), KRISTALLWALD_WESTWEG);
}
