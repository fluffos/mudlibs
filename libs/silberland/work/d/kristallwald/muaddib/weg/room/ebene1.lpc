#include "../def.h"

inherit "std/room";

#pragma strong types;

nosave int schrank_offen, treppe;

void create()
{
  if(!is_clone(TO)) return;
  ::create();
    
  SetProp(P_INT_SHORT, "Das zweite Obergeschoss des Turmes");
  SetProp(P_INT_LONG, 
	  BS("Du stehst in einer Marmorhalle. Das ganze Geschoss ist mit "
	     "edelstem Marmor ausgelegt. In der Mitte des Raumes steht ein "
	     "Sockel, und gegenueber dem Eingang ist ein Wandschrank in "
	     "die Wand eingelassen. Der Aufgang, ueber den Du hereingekommen "
	     "bist, ist ploetzlich wieder verschwunden."));

  SetProp(P_NOMAGIC, 100);
  SetProp(P_NOREST, 
	  "Ausrasten? Hier? Hast Du etwa Deine Aufgabe vergessen?\n");
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:10]));
  
  AddDetail(({"aufgang","eingang"}), 
	    "Du bist ueber den Aufgang hereingekommen.");

  AddDetail("besonderheiten",
	    "Es gibt keine Besonderheiten hier.");

  AddDetail("moeglichkeit",
	    "Das ist nun wirklich nicht wichtig.");

  AddDetail("schluessel",
	    "Du braeuchtest einen Schluessel fuer den Sockel.");

  AddDetail(({"stockwerk","stock"}),
	    "Wenn Du Dich nicht verzaehlt hast, bist Du im 2. Stock.");

  AddDetail(({"raum","marmorhalle","halle","geschoss"}), 
	    "Du stehst in einer Halle, die aus bestem Marmor gebaut wurde.");

  AddDetail("marmor", 
	    "Der Marmor ist gruen geaedert.");

  AddDetail("mitte", 
	    "Die Mitte des Raumes ist in einem runden Raum leicht zu "
	    "bestimmen.");

  AddSpecialDetail("sockel","sockel_fun");

  AddSpecialDetail(({"schrank","wandschrank"}), "schrank_fun");

  AddDetail("boden", 
	    "Der Boden besteht aus Marmor und ist glattpoliert.");

  AddDetail("decke", 
	    "Die Decke besteht aus Marmor und ist glattpoliert.");

  AddDetail(({"waende","wand"}), 
	    "Ausser einem Wandschrank siehst Du keine Besonderheiten "
	    "an den Waenden.");

  AddDetail(({"schluesselloch","loch"}), 
	    "Hm. Einen passenden Schluessel hast Du nicht, womit koennte "
	    "man sowas noch aufbekommen...");
  
  AddDetail("sockel", 
	    "Im Sockel ist ein Schluesselloch eingelassen. Vielleicht "
	    "bekommt man so eine Moeglichkeit, das Stockwerk zu verlassen?");
  
  AddDetail(({"turm","gemaeuer"}), 
	    "Der Turm, in dem Du stehst.");
  
  AddSpecialDetail("treppe","treppe_fun");
  
  AddCmd("oeffne", "schrank_oeffnen");
  AddCmd(({"bastel","bastle","bastele"}),"bastel_dietrich");
  AddCmd(({"benutze","benutz","stecke","steck"}), "benutze_dietrich");

  treppe=0;
  schrank_offen=0;
  
  previous_object()->CustomizeObject();
}

string treppe_fun()
{
  if(treppe)
    return BS("Du siehst eine einfache hoelzerne Treppe.");

  return "";
}

int nach_oben()
{
  TP->move(ROOM "ebene2:"+getuid(TP), M_GO);

  return 1;     // bugfix woody
}

varargs string int_long(mixed v, mixed vp, int f)
{
  SetProp(P_INT_LONG,
	  BS("Du stehst in einer Marmorhalle. Das ganze Geschoss ist mit "
	     "edelstem Marmor ausgelegt. In der Mitte des Raumes steht ein "
	     "Sockel, und gegenueber dem Eingang ist ein Wandschrank in "
	     "die Wand eingelassen. Der Aufgang, ueber den Du hereingekommen "
	     "bist, ist ploetzlich wieder verschwunden.")+
	  (treppe ? "Du siehst eine Treppe, die nach oben fuehrt.\n":""));
  
  return ::int_long(v, vp, f);
}

string schrank_fun()
{
  return BS("Der Schrank ist gaenzlich schmucklos in die Wand eingelassen.")+
    (schrank_offen ? BS("Der Schrank ist geoeffnet und leer."): 
     BS("Der Schrank ist geschlossen und fest versperrt."));
}

nosave int benutze_dietrich(string str)
{
  object di;

  notify_fail(BS("Was willst Du worin benutzen?"));
  if(!str) return 0;

  if(str=="dietrich in schluesselloch"||str=="dietrich in loch")
    if(!objectp(di=deep_present("dietrich",TP)))
      return write(BS("Dietrich? Welchen Dietrich denn?")), 1;
    else
      if(!treppe)
	{
	  write(BS("Du schiebst den Dietrich langsam in das Schluesselloch "
		   "und versuchst ihn zu drehen. Erst nach einigem Probieren "
		   "merkst Du, wie das Schloss langsam nachgibt. Aus der "
		   "Decke senkt sich eine Wendeltreppe in dieses Geschoss "
		   "herab. Du brichst den Dietrich ab."));
	  
	  di->remove(1);
	  
	  AddDetail(({"treppe","wendeltreppe"}), 
		    "Du siehst eine einfache hoelzerne Treppe, die nach "
		    "oben fuehrt.");

	  AddDetail("holz",
		    "Ja. Die Treppe besteht aus Holz.");

	  treppe=1;
	  
	  AddSpecialExit(({"oben","treppe"}),"nach_oben");

	  return 1;
	}
      else
	{
	  di->remove(1);
	  
	  write(BS("Du schiebst den Dietrich langsam in das Schluesselloch "
		   "und versuchst ihn zu drehen. Da das Schloss jedoch "
		   "bereits geknackt ist, bricht der Dietrich einfach nur "
		   "ab."));

	  return 1;
	}
  
  return 0;
}

nosave int schrank_oeffnen(string str)
{
  string womit, was;
  object ob;

  notify_fail(BS("Was willst Du oeffnen?"));
  if(!str) return 0;

  if(member(({"schrank","schranktuer","wandschrank","schloss"}), str)!=-1)
    return write(BS("Der Schrank ist fest verschlossen, Da braeuchtest Du "
		    "schon den richtigen Schluessel, um das Schloss oeffnen "
		    "zu koennen!")), 1;

  if(sscanf(str,"%s mit %s", was, womit)!=2)
    return 0;

  if(member(({"schrank","schranktuer","wandschrank","schloss"}), was)==-1)
    return notify_fail(BS("Was willst Du denn oeffnen?")), 0;

  if(member(({"schrankschluessel","schluessel"}), womit)==-1)
    return notify_fail(BS("Womit willst Du den Schrank oeffnen?")), 0;
  
  if(!objectp(ob=deep_present("\nschluessel",TP)))
    return write(BS("Du hast scheinbar nicht den passenden "+CAP(womit)+
		    "bei Dir.")), 1;

  write(BS("Du drehst den Schluessel im Schloss, es knackt und der Schluessel "
	   "ist zerbrochen. Naja, wenigstens ist der Schrank jetzt offen. "
	   "Du oeffnest eine der Schranktueren und ploetzlich purzeln einige "
	   "Dinge heraus..."));

  ob->remove(1);
	      
  CLONEME(OBJ "linse");

  CLONEME(OBJ "nagel");

  if(!deep_present("\ndraht", TP))
    CLONEME(OBJ "draht");

  schrank_offen=1;

  return 1;
}

nosave int bastel_dietrich(string str)
{
  object na, dr, di;
  
  notify_fail(BS("Was willst Du basteln?"));
  if(!str) return 0;
  
  if(str=="dietrich"||str=="schluesselersatz"||str=="ersatz")
    if(objectp(na=present("nagel", TP)) && objectp(dr=present("draht", TP)))
      {
	write(BS("Du biegst den Draht und wickelst ihn um den Nagel, bis Du "
		 "schliesslich einen Dietrich gebastelt hast."));
	
	na->remove(1);
	dr->remove(1);
	
	di=clone_object(OBJ "dietrich");

	if(di->move(TP, M_GET)==ME_TOO_HEAVY)
	  {
	    write(BS("Als Du den Dietrich fertig hast, faellt er Dir "
		     "ungeschickterweise aus der Hand..."));

	    di->move(ME, M_NOCHECK);
	  }

	return 1;
      }
    else 
      return write(BS("Dazu fehlt Dir das Material.")), 1;
  
  return 0;
}
