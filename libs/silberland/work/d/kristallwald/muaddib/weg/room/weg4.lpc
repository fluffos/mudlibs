#include "room2.h"

inherit "/std/room";

nosave int flag, timeout;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Waldweg");
  SetProp(P_INT_LONG, 
	  BS("Du stehst mitten im Wald. Im Sueden siehst Du eine "
	     "Wiese, der Uebergang ist sehr sprunghaft. Die "
	     "Baeume hier sind nicht uebermaessig hoch, aber von "
	     "unglaublicher Dichte. Weiter im Norden erkennst Du "
	     "eine Lichtung. Der Weg wird hier eher schmal und "
	     "ist mit Grasbuescheln gesaeumt. Neben dem Weg "
	     "befindet sich ein grosser Busch."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_FOREST]));

  AddDetail("wald", 
	    "Ein normaler Wald mit dem ueblichen Bestand an Nadel- und "
	    "Laubbaeumen.");

  AddDetail("wiese", 
	    "Danach solltest Du im Sueden suchen.");

  AddDetail("weg", 
	    E_WEG);

  AddDetail("boden",
	    "Der Boden ist weich, wie das fuer einen Waldweg so ueblich ist.");

  AddDetail("himmel",
	    "Du kannst den Himmel nur erahnen.");

  AddDetail("farbe", 
	    "Ueber Farben weisst Du nur Grundsaetzliches.");

  AddDetail("uebergang", 
	    "Seltsam, dass hier der Wald so ploetzlich anfaengt.");

  AddDetail( ({"baum", "baeume"}), 
	     "Die Baeume sind ausnahmslos normal gewachsen und weisen die "
	     "ueblichen Eigenschaften von Baeumen auf.");

  AddDetail("aeste", 
	    "Da wuerdest Du nicht einmal drankommen, wenn Du eine Leiter "
	    "haettest.");

  AddDetail("rinde", 
	    "Auch die Rinde scheint normal zu sein.");

  AddDetail("dichte", 
	    "Die Dichte der Baeume verhindert, dass Du neben dem Weg laufen "
	    "kannst. Auch ist es nicht moeglich in irgendeine andere "
	    "Richtung durch den Wald zu gehen.");

  AddDetail("lichtung", 
	    "Die Lichtung ist im Norden zu suchen.");

  AddDetail(({"gras","grasbueschel"}),
	    "Ein Grasbueschel sticht Dir wegen seiner ungewoehnlichen Farbe "
	    "ins Auge. Als Du Dich bueckst, um es genauer zu untersuchen, "
	    "dringt Dir ein strenger Geruch in die Nase.");

  AddDetail(({"sehen","auge"}), 
	    "Das Auge dient Dir zum Sehen.");

  AddDetail("nase", 
	    "Die Nase dient Dir zum riechen.");

  AddDetail("laubbaeume", 
	    "Du siehst Birken, Eichen und Buchen.");

  AddDetail(({"birken","birke","eiche","eichen","buche","buchen","tanne",
		"tannen"}), 
	    "Eine weitergehende Untersuchung ist fuer Dich eher sinnlos.");

  AddDetail("eigenschaften", 
	    "Du fragst wirklich nach den Eigenschaften eines Baumes? Das "
	    "ist peinlich, da das ja nicht der einzige Wald im Silberland "
	    "ist.");

  AddDetail("silberland", 
	    "Du befindest Dich im Silberland.");

  AddDetail("nadel", 
	    "Nadeln wachsen auf Nadelbaeumen.");

  AddDetail("nadelbaeume", 
	    "Du siehst hauptsaechlich Tannen."); 

  AddSmell(DEFAULT_SMELL, 
	   "Es riecht streng.");

  AddSmell(({"gras","grasbueschel"}), 
	   "Der Geruch scheint diesem Grasbueschel zu entstroemen.");

  AddSmell("geruch", 
	   "Du kannst den Geruch einfach nicht einwandfrei feststellen.");

  AddSpecialDetail("busch","spec_busch");

  AddExit("norden",ROOM"weg5");
  AddExit("sueden",ROOM"weg3");

  flag=1;
}

string spec_busch()
{
  object wl, wl1;

  if(flag && !present("raeuber") )
    {
      say(BS(TPN+" lockt zwei Raeuber hinter einem Busch hervor."));
      
      (wl = clone_object(NPC "dunkelelf"))->move(TO, M_NOCHECK);
      (wl1 =clone_object(NPC "dunkelelf"))->move(TO, M_NOCHECK);

      wl->Kill(TP);
      wl1->Kill(TP);

      flag=0;
      timeout=1;

      return BS("In dem Moment, in dem Du Deine Aufmerksamkeit dem Busch "
		"widmest, springen zwei Raeuber hervor und greifen Dich an.");
    }
  
  return BS("Ein ganz normaler Busch. Du kannst nichts Besonderes erkennen.");
}

void reset()
{
  ::reset();

  if(flag) return;
  
  if(present("raeuber") && timeout)
    {
      timeout--;
      return;
    }
  
  if(timeout <= 0)
    {
      catch(present("raeuber")->schleichdich());
      catch(present("raeuber")->schleichdich());
    }
  
  flag=1;
}
