/*
**  Muaddib Weg
**
**  2003-03-25  PROtheG  Ueberarbeitet, Astloch erweitert
*/

#include "room2.h"

inherit "/std/room";

nosave int treasure;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Waldweg");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich auf einem Weg, der durch dichten "
	     "Wald fuehrt. Der Wald ist hier so dicht, dass Du keine Wahl "
	     "hast, Du musst auf dem Weg bleiben. Die Baeume strahlen eine "
	     "unangenehme Aura aus, Dir laeuft es bei dem Gedanken an die "
	     "moeglichen Gefahren trotz Deines Mutes kalt den Ruecken "
	     "runter. Eigentlich moechtest Du nur noch weg von hier."));

  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_FOREST]));

  AddDetail("himmel", 
	    "Den Himmel siehst Du durch die dichten Baeume nicht so genau.");

  AddDetail("erde", 
	    "Der typische Waldboden.");

  AddDetail("waldboden",
	    "Nadeln, Laub, und Aeste.");

  AddDetail(({"aeste","ast","nadeln","nadel"}), 
	    "Die sind wohl von den Tannen gefallen.");
  
  AddDetail("laub", 
	    "Das koennte von den Laubbaeumen gefallen sein."); 

  AddDetail("laubbaeume", 
	    "Baeume, die Laub tragen. Im Gegensatz zu Nadelbaeumen wie zum "
	    "Beispiel Tannen.");

  AddDetail("harz", 
	    "Harz ist eine Substanz, die von Nadelbaeumen abgesondert wird.");

  AddDetail("baum", 
	    "Du findest ein Astloch.");

  AddDetail("pfad", 
	    "Ein Pfad im Wald.");

  AddSmell(DEFAULT_SMELL, 
	   "Es riecht nach Harz.");

  AddDetail("baeume", 
	    "Die Baeume stehen auffaellig dicht. Ein Baum faellt Dir "
	    "besonders auf.");

  AddDetail("boden", 
	    "Angenehmer, weicher Waldboden.");

  AddDetail(({"nadeln", "nadel", "zweige"}), 
	    "Das liegt hier am Boden rum.");

  AddDetail("kristallwald", 
	    "Bald kannst Du Dich von der Schoenheit des Kristallwaldes "
	    "selbst ueberzeugen.");

  AddDetail("gefahr", 
	    "Du denkst an Raeuber und Wegelagerer, die hier lauern koennten.");

  AddDetail("schoenheit",
	    "Von der Schoenheit des Kristallwaldes hast Du schon viele "
	    "Geruechte gehoert.");

  AddDetail("geruechte", 
	    "Geruechte, wie man sie in Kneipen so hoert.");

  DUSTY;
  WOODY;

  AddDetail("astloch", 
	    "Vielleicht kannst Du hineingreifen.");

  AddDetail("aura", 
	    "Du fuehlst Dich ob dieser Aura unwohl.");

  AddDetail("gedanken", 
	    "Das kann Dir niemand sagen.");

  AddDetail("muenzen", 
	    "Mit Muenzen kann man sich etwas kaufen.");

  AddDetail("mut", 
	    "Hast Du den?");

  AddDetail(({"raeuber","wegelagerer"}),
	    "Raeuber und Wegelagerer koennen hier ueberall lauern.");

  AddDetail("weg",
	    E_WEG);

  AddDetail("wald", 
	    "Du befindest Dich in einem dichten Wald.");

  AddCmd(CMD_GREIFEN, "gr_astloch");

  AddExit("sueden",ROOM"weg5");
  AddExit("norden",ROOM"weg7");
 
  treasure=1;
}

nosave int gr_astloch(string str)
{
  notify_fail(BS("Wo willst du hineingreifen?"));
  if(!str) return 0;  
  
  if(str=="in astloch"||str=="in astloch hinein")
    if(treasure)
      {
	write(BS("Du findest ein paar Muenzen, die Du sofort einsteckst.")+
	      BS("Wer die hier wohl versteckt hat?"));

	TP->AddMoney(800+random(201));
	
	treasure=0;
	
	return 1;
      }
    else return write(BS("Du findest nichts. Vermutlich hat schon jemand das "
			 "Versteck ausgeraeumt.")), 1;
  
  return 0;
}

void reset()
{ 
  ::reset(); 

  treasure=1;
}

