**  Muaddib Weg
**
**  2003-03-25  PROtheG  Ueberarbeitet, trinken erweitert
*/

#include "room2.h"

inherit "std/room";

#include "/d/huegelland/feyaria/weg/directions.h"

#define MAXHEILEN 5
#define TRINK 8

nosave int heilen;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Weg am Fuss des Gebirges");
  SetProp(P_INT_LONG, 
	  BS("Der Weg ebnet sich langsam, die Umgebung wird gruener, neben "
	     "Dir fliesst ein sehr kleiner Bach, wohl aus einer kleinen "
	     "Quelle. Am Ufer steht ein kleiner Busch. Im Ganzen steigt "
	     "Deine Stimmung und die Angst von vorher verfliegt."));

  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_MOUNTAIN]));

  AddSmell(DEFAULT_SMELL, 
	   "Es riecht nach Wiese und Fruehling.");

  AddDetail("fruehling", 
	    "Es faellt Dir auf, dass Du eigentlich nicht mal weist, welche "
	    "Jahreszeit zur Zeit ist.");

  AddDetail("jahreszeit", 
	    "Winter ist ganz sicher nicht. Du denkst, dass es Fruehling sein "
	    "koennte.");

  AddDetail("angst", 
	    "So etwas verspuerst Du hier nicht.");

  AddDetail(({"frucht", "fruechte","besonderes"}), 
	    "Da ist nichts Besonderes.");

  AddDetail("mutter", 
	    "Ist es nicht peinlich, dass Du das untersuchen musst?");

  AddDetail("quelle", 
	    "Die Quelle des Baches ist unsichtbar.");

  AddDetail("stimmung", 
	    "Du bist in guter Stimmung.");

  AddDetail("ufer", 
	    "Das Ufer ist grasbewachsen.");

  AddDetail("wasser", 
	    "Das Wasser sieht frisch aus.");

  AddDetail("himmel", 
	    "Der Himmel ist ziemlich klar heute.");

  AddDetail("boden", 
	    "Die Steine geben langsam den Boden frei. Es wachsen schon hier "
	    "und da Grasbueschel und machen die Umgebung angenehmer.");

  AddDetail("steine", 
	    "Hier sind deutlich weniger Steine als im Norden.");

  AddDetail("gras", 
	    "Das Gras waechst hier schon recht regelmaessig.");

  AddDetail("grasbueschel", 
	    "Gras in Gruppen zusammengewachsen.");

  AddDetail("erde", 
	    "Du siehst saftige schwarze Erde.");

  AddDetail("luft", 
	    "Die Luft ist rein, was wohl auf den Bach zurueckzufuehren ist.");

  AddDetail("weg", 
	    E_WEG);

  AddDetail("umgebung", 
	    "Die Umgebung laedt so richtig zum idlen ein.");

  AddDetail("bach", 
	    "Der Bach fuehrt frisches Wasser aus einer Quelle. Vielleicht "
	    "kannst Du es ja trinken?");

  AddDetail("busch", 
	    "Am Busch haengen kleine, rote Fruechte.");

  AddCmd(({"trink", "trinke"}), "trink_wasser");

  heilen=MAXHEILEN;
  
  SetProp(P_HIDE_EXITS, ({ED2}) );

  AddExit(({ED2OB, ED2}), ROOM "weg1");
  AddExit("norden", ROOM "weg3");
}

void reset()
{
  ::reset();

  heilen=MAXHEILEN;
}

nosave int trink_wasser(string str)
{
  notify_fail(BS("Was willst Du trinken?"));
  if(!str) return 0;

  if(str == "wasser")
    {
      if(!TP->drink_soft(TRINK, 1))
	return write(BS("Soviel kannst Du nicht auf einmal trinken!")), 1;
      
      if(heilen)
        {
          heilen--;
	  
          write(BS("Du nimmst einen Schluck von dem Wasser und fuehlst "
                   "Dich total erfrischt!"));

          say(BS(TPN+" trinkt etwas Wasser."), ({TP}));

          TP->AddHp(20+random(21));
        }
      else
        {
          write(BS("Du nimmst einen Schluck von dem Wasser und fuehlst "
                   "Dich etwas besser."));

          say(BS(TPN+" trinkt etwas Wasser."), ({TP}));
        }

      return 1;
    }
  
  return 0;
}
