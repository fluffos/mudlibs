#include "../def.h"

inherit "std/room";

#pragma strong types;

nosave int treppe, einstell, in_loch;

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_INT_SHORT, "Das dritte Obergeschoss des Turmes");
  SetProp(P_INT_LONG, 
	  BS("Du stehst in einem aus rohem Granit gehauenen Raum, "
	     "ueberall liegen rohe Steinquader herum. Die "
	     "Atmosphaere im Raum ist angenehm. Der Boden ist etwas "
	     "staubig und es herrscht ein sehr angenehm "
	     "temperiertes Licht im Raum. Am Boden faellt Dir ein "
	     "kleines Loch auf. Durch den oberen Teil des Raumes "
	     "geht ein Lichtstrahl."));

  SetProp(P_NOMAGIC, 100);
  SetProp(P_NOREST,  
          "Ausrasten? Hier? Hast Du etwa Deine Aufgabe vergessen?\n"); 
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:10]));
    
  AddSound(DEFAULT_SOUND, 
	   "Es ist absolut still.");

  AddSmell(DEFAULT_SMELL, 
	   "Es riecht etwas abgestanden.");

  AddDetail("teil", 
	    "Der Strahl geht durch den oberen Teil des Raumes.");

  AddDetail("mauer",
	    "Die Mauer besteht aus Granit.");

  AddDetail(({"staub","dreck"}),
	    "Besonders sauber ist es hier nicht.");

  AddDetail(({"wand","waende"}),
	    "Auch die Waende bestehen aus Granit und sind seltsam glatt "
	    "poliert.");

  AddDetail(({"granit","raum"}), 
	    "Der ganze Raum scheint aus Granit zu bestehen. Seltsam, da Du "
	    "in den unteren Ebenen kein Granit gesehen hast.");

  AddDetail(({"ebene","ebenen"}),
	    "Da warst Du schon.");

  AddDetail(({"steinquader","quader","stein"}),
	    "Ein Quader faellt Dir auf. Vielleicht kannst Du ihn "
	    "verschieben?");
  
  AddDetail("stockwerk", 
	    "Du glaubst, im 3. Stockwerk zu sein.");

  AddDetail("atmosphaere", 
	    "Es ist sehr angenehm hier. Wenn Du nicht einen so dringenden "
	    "Auftrag haettest, wuerdest Du gerne ein wenig rumidlen.");

  AddDetail("auftrag", 
	    "Du suchst doch noch das Ankh vom Priester, oder?");

  AddDetail("ankh", 
	    "Such es erstmal.");

  AddDetail("priester", 
	    "Du erinnerst Dich doch an ihn, oder?");

  AddDetail("boden", 
	    "Ausser Staub und einem kleinen Loch ist da nix.");

  AddSpecialDetail("loch","spezial_loch");

  AddSpecialDetail(({"holzstab","stab"}),"spezial_stab");

  AddDetail(({"wand","mosaik"}), 
	    "Du siehst ein Mosaik, auf dem ein glaenzender Strich eine Wand "
	    "trifft.");

  AddDetail("strich",
	    "Das koennte ein Strahl sein.");

  AddDetail("licht", 
	    "Der Raum ist angenehm beleuchtet.");

  AddDetail("staub", 
	    "Der ganze Boden ist voll davon.");

  AddDetail(({"lichtstrahl","strahl"}),
	    "Du fragst Dich, wie Du den Lichtstrahl wohl auf das Mosaik "
	    "umlenken koenntest.");

  AddDetail("decke", 
	    "Auch die Decke besteht aus rohen Steinquadern.");
  
  AddDetail(({"turm","gemaeuer"}), 
	    "Der Turm, in dem Du stehst.");
  
  AddCmd(({"schieb","schiebe","verschieb","verschiebe"}),"schieb_quader");
  AddCmd(({"steck","stecke"}),"steck_stab");
  AddCmd(({"befestig","befestige"}),"befestige_verg");

  treppe=0;
  einstell=0;
  in_loch=0;

  previous_object()->CustomizeObject();
}

string spezial_stab()
{
  if(in_loch) 
    return BS("Der Stab steckt im Loch.");

  return 0;
}

string spezial_loch()
{
  if(in_loch)
    {
      AddDetail("stab",
		"Der steckt in einem Loch.");

      return BS("Mitten im Raum steckt ein Stab in einem Loch.");
    }
  
  return BS("Du siehst ein ordinaeres Loch im Boden.");
}

int nach_oben()
{
  TP->move(ROOM "ebene3:"+getuid(this_player()), M_GO);

  return 1;     // bugfix woody
}

varargs string int_long(mixed v, mixed vp, int f) 
{ 
  SetProp(P_INT_LONG, 
          BS("Du stehst in einem aus rohem Granit gehauenen Raum, " 
             "ueberall liegen rohe Steinquader herum. Die " 
             "Atmosphaere im Raum ist angenehm. Der Boden ist etwas " 
             "staubig und es herrscht ein sehr angenehm " 
             "temperiertes Licht im Raum. Am Boden faellt Dir ein " 
             "kleines Loch auf. Durch den oberen Teil des Raumes " 
             "geht ein Lichtstrahl.")+
          (in_loch ? "Mitten im Raum steckt ein Stab in einem Loch.\n":"")+
          (treppe ? "Du siehst eine Treppe, die nach oben fuehrt.\n":"")); 
   
  return ::int_long(v, vp, f); 
} 

nosave int schieb_quader(string str)
{
  object ob;

  notify_fail(BS("Was willst Du verschieben?"));
  if(!str) return 0;
  
  if(str=="quader"||str=="steinquader") 
    if(!deep_present("\nmuaddib_quest_stab", TP)) 
      {
	write(BS("Du verschiebst den Quader, der auf Rollen gelagert "
		 "zurueckrollt."));
	
	ob=clone_object(OBJ "stab");
	
	if(ob->move(TP, M_GET)==ME_TOO_HEAVY)
	  {
	    write(BS("Darunter liegt ein Stab, den Du jedoch liegen laesst, "
		     "da er Dir zu schwer ist."));
	    
	    ob->move(ME, M_NOCHECK);
	  }
	else
	  write(BS("Darunter liegt ein Stab, den Du gleich mitnimmst."));

	AddDetail("rollen",
		  "Du kannst sie nicht sehen.");
	
	return 1;
      }
    else 
      return write(BS("Du hast den Quader doch schon verschoben.")), 1;

  return 0;
}

nosave int steck_stab(string str)
{
  object ob;

  notify_fail(BS("Was willst Du wohin stecken?"));  
  if(!str) return 0;
  
  if(str!="stab in loch")
    return 0;
  
  if(!objectp(ob=present("allon",TP)))
    if(present("\nmuaddib_quest_stab", TP))
      return write(BS("Du steckst den Stab in das Loch. Der Stab auf dem "
		       "Mosaik glaenzt jedoch, eventuell hast Du noch etwas "
		      "vergessen.")+
		   BS("Du nimmst den Stab wieder an Dich.")), 1;
    else
      return write(BS("Du hast doch keinen geeigneten Stab bei Dir!")), 1;
  
  if(in_loch)
    return write(BS("Das hast Du doch schon getan.")), 1;
  
  write(BS("Du steckst den Stab mit der Linse in das Loch. "
	   "Vielleicht kannst Du den Stab jetzt irgendwie so drehen, "
	   "dass die Situation auf dem Mosaik nachgestellt wird?"));
  
  ob->remove(1);

  in_loch=1;
  
  AddCmd(({"dreh","drehe"}),"stell_ein");
  
  return 1;
}

nosave int befestige_verg(string str)
{
  object ob,ob1,ob2;

  notify_fail(BS("Was willst Du woran befestigen?"));
  if(!str) return 0;
  
  if(str=="linse an stab"||str=="linse am stab"||
     str=="linse an holzstab"||str=="linse am holzstab") 
    {
      if(!objectp(ob=present("linse",TP)))
	return write(BS("Aber Du hast doch garkeine Linse!")), 1;

      if(!objectp(ob1=present("\nmuaddib_quest_stab", TP)))
	return write(BS("Aber Du hast doch garkeinen Stab!")), 1;

      ob->remove(1);
      ob1->remove(1);

      ob2=clone_object(OBJ "allon");

      if(ob2->move(TP, M_GET)==ME_TOO_HEAVY)
	{
	  write(BS("Als Du gerade die Linse an dem Stab befestigt hast, "
		   "rutscht er Dir aus den Fingern und faellt auf den "
		   "Boden."));
	  
	  ob2->move(ME, M_NOCHECK);
	}
      else
	write(BS("Du befestigst die Linse am Stab."));

      return 1; 
    }  
  
  return 0;
}
  
nosave int stell_ein(string str)
{
  notify_fail(BS("Was willst Du wohin drehen?"));
  if(!str) return 0;

  str=implode(explode(str, "holz"), "");

  if(str=="stab zu mosaik"||str=="stab zum mosaik"||str=="stab auf mosaik"||
     str=="stab zu wand"||str=="stab zur wand"||str=="stab auf wand"||
     str=="stab in richtung zu wand"||str=="stab in richtung zur wand"||
     str=="stab in richtung zu mosaik"||str=="stab in richtung zum mosaik")
    if(!treppe)
      {
	write(BS("Du stellst den Lichtstrahl auf das Mosaik ein und wie von "
		 "Geisterhand wird eine Treppe heruntergelassen."));
	
	AddDetail("treppe", 
		  "Du siehst eine einfache hoelzerne Treppe.");
	
	AddDetail("holz",
		  "Die Treppe besteht definitiv aus Holz.");
	
	treppe=1;
	einstell=1;
	
	AddSpecialExit(({"oben","treppe"}),"nach_oben");	
	
	return 1;
      }
    else 
      return write(BS("Das hast Du ja schon laengst getan.")), 1;

  if(explode(str, " ")[0]=="stab")
    notify_fail(BS("Wo willst Du den Stab hindrehen?"));

  return 0;
}
