inherit "std/virtual/v_compiler";

#include <properties.h>
#include <v_compiler.h>
#include <wizlevels.h>
#include <moving.h>
#include "../def.h"

#define P_VALID_NAME "valid_name"



create()
{
  ::create();
  SetProp(P_COMPILER_PATH, ROOM+"" );
  SetProp(P_STD_OBJECT, ROOM+"base");
  SetProp(P_VALID_NAME, ({"base","ebene0","ebene1","ebene2","ebene3"}) );
}


string Validate(string file)
{
  string path, who, name;

  file = ::Validate(file);
  if ((sscanf(file, "%s:%s", name, who) == 2) &&
      (member(QueryProp(P_VALID_NAME), name) != -1))
  {
    SetProp(P_STD_OBJECT, ROOM+name);
    return file;
  }
}


int CustomizeObject()
{
  string name,foo, who;
  if (!(name = ::CustomizeObject()) || sscanf(name,"%s:%d",foo,who)!=2)
    return 0;
  return 1;
}



