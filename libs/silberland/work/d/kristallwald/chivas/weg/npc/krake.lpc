
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Krake");
  SetProp(P_LONG, BS(
    "Der Krake ist riesig."));
  SetProp(P_NAME, "Krake");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
  AddId(({"krake"}));
  
  create_default_npc(30);
  SetProp(P_HANDS, ({" mit seinen Krakenarmen",300,DT_SQUEEZE}));
  SetProp(P_RACE, "Krake");
  SetProp(P_SIZE, 1800);
  SetProp(P_WEIGHT, 220000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 8);
  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.8, DT_COLD:      0.0,  DT_WATER:  -0.5, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0,  DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.0,  DT_MAGIC:  0.0, DT_MIND:   0.0]));
  
  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "krakt wild herum");
  SetProp(P_MMSGOUT, "krakt weg");
  
  SetProp(P_DIE_MSG,  " faellt in sich zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "%s, Du machst das nicht noch mal!");
  SetProp(P_KILL_MSG, "Mit nur zwei Haenden und Beinen hast Du keine Chance!");
  
  AddInfo(DEFAULT_INFO, "schaut Dich genervt an.\n");
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das ist dem Kraken zu schwer.\n" }) );

  AddSpell(3,800, 
    "Der Krake zerquetscht Dich mit seinen Tentakeln.\n",
    "Der Krake zerdrueckt @WEN mit aller Kraft seiner Tentakeln.\n",
    ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));
  
  SetChats(3, ({
          "Der Krake krakt um Dich herum.\n",
          "Der Krake umarmt Dich mit seinen Tentakeln.\n"}) );
  
  SetAttackChats(10, ({
    "Der Krake droht mit seinen Tentakeln.\n",
    "Der Krake erdrueckt Dich mit seinen Tentakeln.\n"}) );
}

int Defend(int dam, string *dam_type_list, mixed spell, object enemy)
{
  if(QuerySkillAttribute(SA_SPEED)<300)
    TO->ModifySkillAttribute(TO, SA_SPEED, 300, 500);
  
  return ::Defend(dam, dam_type_list, spell, enemy);
}
  
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;
  
  call_out("react", 0, 
	   "wedelt wild mit seinen Tentakeln.",
	   "wedelt wild mit seinen Tentakeln.");
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
