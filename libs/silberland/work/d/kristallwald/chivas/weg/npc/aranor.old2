
inherit "std/mnpc";
inherit "std/npc/spells";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"

#define QUESTKEY "Bedrohung aus einer anderen Dimension"

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Aranor, der weise Zauberer");
  SetProp(P_LONG, BS(
    "Aranor steht in seiner dunklen Robe vor Dir. Seine Augen "
    "wirken warm und sanft. Seine ganze Statur wirkt sehr schmaechtig, aber Du "
    "spuerst trotzdem die Macht, die von ihm ausgeht. Vor allem seine "
    "Haende leuchten voll magischer Energie. Er macht einen sorgenvollen "
    "Eindruck auf Dich."));
  SetProp(P_NAME, "Aranor");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:50]));
  AddId( ({ "aranor","zauberer"}) );

  create_default_npc(42);
  SetProp(P_HANDS, ({" mit seinen Haenden" ,QueryProp(P_HANDS)[1], DT_RIP }) );
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170 );
  SetProp(P_ALIGN, 800);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_SPELLRATE,80);

  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_NOATTACK,1);

  SetProp(P_RESISTANCE_STRENGTHS , 
  ([DT_FIRE:      -0.2,  DT_COLD:     -0.2,  DT_WATER: -0.2,  DT_AIR:   -0.2, 
    DT_LIGHTNING: 0.3,  DT_EXPLOSION: 0.4,  DT_SOUND:  0.3,  DT_LIGHT: 0.0,
    DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.0,  DT_TERROR: 0.0,
    DT_HOLY:      0.2,  DT_UNHOLY:  -0.2,  DT_MAGIC: -0.2, DT_BLUDGEON: -0.6]));
  SetProp(P_MSGIN, "schleicht murmelnd herein");
  SetProp(P_MSGOUT, "schleicht murmelnd weiter");
  SetProp(P_MMSGIN, "schleicht fluesternd herein");
  SetProp(P_MMSGOUT, "schleicht fluesternd weiter");

  SetProp(P_MNPC_AREA, ( {ROOM "wasf10"}));
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "wasf10");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS); 

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_KILL_MSG, "Weisse Magie ist viel zu stark fuer Dich!");

  AddDetail( ({ "robe"}),
    "Die dunkele Robe verbirgt mehr als man denkt. Unter der Robe scheint "
    "ein starker Zauberer zu stecken.");
  AddDetail( ({ "augen"}),
    "Seine Augen wirken sanft und warm.");
  AddDetail( ({ "statur","figur"}),
    "Seine Statur ist schmaechtig, aber seine Figur ist auch nebensaechlich.");
  AddDetail( ({ "macht"}),
    "Von ihm geht eine starke Macht aus.");
  AddDetail( ({ "haende","energie"}),
    "Seine Haende leuchten von der magischen Energie.");
  AddDetail( ({ "eindruck","sorgen"}),
    "Er scheint grosse Sorgen zu haben.");

  AddInfo(DEFAULT_INFO, "murmelt sorgenvoll vor sich hin "
                        "und beachtet Dich nicht.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");
  AddInfo("sorgen", "Ich habe grosse Sorgen und weiss nicht wie ich sie "
          "alleine loesen soll.","sagt: ");
  AddInfo( ({"riss","risse","aufgabe"}),
    "Die Risse zwischen den Dimensionen sind ueber das ganze Silberland "
    "verteilt. Sie befinden sich hauptsaechlich in den Ortschaften im "
    "Silberland und an ein paar speziellen Orten der Macht. Es sind insgesamt "
    "zweiundzwanzig verschiedene Stellen, an denen sich diese Risse bilden. "
    "Sie sind das Verbindungstor fuer Daemonen in unsere Welt, um diese zu "
    "zerstoeren. Sie muessen aufgehalten und die Risse muessen "
    "geschlossen werden.",
    "sagt: ");
  AddInfo( ({"orte","ortschaften","ort","stellen"}),
    "Es sind insgesamt zweiundzwanzig Stellen. Ich kann Dir nur die Orte im "
    "groben sagen, den genauen Ort wird Dir ein magischer Stab mitteilen, "
    "wenn Du den exakten Raum betrittst. Wenn Du die Aufgabe uebernimmst, "
    "kann Dir der Stab die Orte im groben nennen.",
    "sagt: ");
  AddInfo( ({"hilfe"}),
    "Schoen das Du fragst. Wenn Du mir im Kampf gegen diese Risse zwischen "
    "den Dimensionen helfen willst, dann biete mir deine Hilfe an.",
    "sagt: ");
  AddInfo( ({"stab"}),
    "Ein magischer Stab, der die Risse aufspueren und schliessen kann. Er "
    "leuchtet kurz auf, wenn man einen Ort betritt, an dem ein Riss versteckt "
    "ist. Wenn Du mir hilfst, werde ich Dir einen geben.",
    "sagt: ");
  AddInfo( ({"dimension","dimensionen"}),
    "Die fremden Dimensionen sind Orte des Schreckens. Wenn die Wesen dieser "
    "Dimensionen in das Silberland vordringen, dann wird diese Welt "
    "zerstoert werden.",
    "sagt: ");
  AddInfo( ({"daemonen","wesen"}),
    "Die Daemonen der anderen Dimensionen sind stark und gefaehrlich. Momentan "
    "koennen nur kleine Daemonen in unsere Welt vordringen, wenn aber die "
    "Risse groesser werden, werden Daemonen zu uns vordringen, wogegen das "
    "Boese im Brunnen wie der Frosch im Anfaengerpark wirkt.",
    "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Aranor braucht Deine Sachen nicht.\n" }) );

  AddSpell(5,600, 
    "Ein Blitz schnellt aus der Hand von Aranor und trifft Dich.\n",
    "Ein Blitz aus der Hand von Aranor trifft @WEN mitten am "
    "Oberkoerper.\n",
    ({DT_LIGHTNING}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(1,1500, 
    "Ein Feuerball schnellt aus der Hand von Aranor und trifft Dich.\n",
    "Ein Feuerball aus der Hand von Aranor trifft @WEN .\n",
    ({DT_FIRE}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(3,800, 
    "Aranor trifft Dich mit einem hervorgezauberten Riesenhammer.\n",
    "Aranor beschwoert einen Riesenhammer, der @WEN mit aller Wucht trifft.\n",
    ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2, 1, DS_PARALYZE,
    "Aranor spricht heilige Formeln und Du kannst Dich nicht mehr bewegen!\n",
    "Aranor paralysiert @WEN!\n" );

  AddDefaultSpell(2, 1, DS_ANTIMAGIC,
    "Aranor verhindert Deine Zauber!\n",
    "Aranor verhindert, dass @WER Magie anwenden kann!\n" );

  AddDefaultSpell(3, 100, DS_DISARM);    

  SetChats(2, ({
          "Aranor spricht ein paar heilige Formeln.\n",
          "Aranor murmelt verzweifelt etwas ueber Risse.\n",
          "Aranor flucht ueber irgendwelche Dimensionen.\n",
          "Aranor murmelt unverstaendliche Worte.\n"}) );
  SetAttackChats(10, ({
    "Aranor schuetzt sich mit einem magischen Schild.\n",
    "Aranor weicht gekonnt aus.\n"}) );
  
  SUID;
  CLONEME( "/p/armour/boots/lederstiefel" );
  CLONEME( "/p/armour/trousers/hose" );
  CLONEME( "/p/armour/cloak/seidenumhang" );
  command("trage alles");

AddCmd( ({"biete" }), "bieten" );
AddCmd( ({"gib","gebe" }), "fertig" );
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;
  
  switch (gruppe) {
  case "aengstlich":
    call_out("reaction", 0, TP,
	     "haelt Dich fuer ein ungefaehrliches Wesen, darum reagiert er nicht.",
	     "findet "+TPN+" uninteressant.");
    break;
  case "aergerlich":
    call_out("reaction", 0, TP,
	     "bewegt seine Haende und entzuendet ein Feuer unter Deinem Hintern.",
	     "bewegt seine Haende und entzuendet ein Feuer unter "+TP->name(WESSEN)+" Hintern.");
    TP->AddHp(-10);
    break;
  case "albern":
    call_out("reaction", 0, TP,
	     "haelt Dich einfach nur fuer laestig.",
	     "beachtet "+TPN+" nicht.");
    break;
  case "fies":
    call_out("reaction", 0, TP,
	     "entzuendet magisch ein kleines Feuer unter Deinen Fuessen.",
	     "entzuendet magisch ein kleines Feuer unter "+TP->name(WESSEN)+" Fuessen.");
    TP->AddHp(-10);
    break;
  case "froh":
  case "intim":
  case "nett":
    call_out("reaction", 0, TP,
	     "findet das ekelig.",
	     "findet das ekelig.");
    break;

  case "neutral":
    call_out("reaction", 0, TP,
	     "beruehrt das nicht besonders.",
	     "beruehrt das nicht besonders.");
    break;
  case "traurig":
    call_out("reaction", 0, TP,
	     "troestet Dich.",
	     "troestet "+TP->Name(WEN)+".");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
void daemon()
{
  object daemon;
  
  if(present("CHIVASKOBOLD", MENV)) return;
  
  tell_room(MENV, 
   "Aranor beschwoert einen kleinen Kobold, der ihn im Kampf unterstuetzt.\n");

  daemon=clone_object(NPC "kobold");
  daemon->move(ENV(TO), M_GO|M_NOCHECK);
}

void Attack(object enemy)
{
  ::Attack(enemy);
  
  if (!random(5))
    daemon();
}

int bieten(string str)
{
  object stab;
  notify_fail("Wem moechtest Du was anbieten?\n");
  
  if(!str || str == "") return 0;
  if(!(str == "hilfe an" ||
       str == "aranor hilfe an" )) return 0;
  
  if(present("stab", TP)){
    
    write(BS("Aranor sagt: Aber Du hilfst mir doch schon.\n"
	     "Aranor sagt: Wenn Du fertig bist, dann gib mir "
             "einfach den Stab zurueck.\n"));
    
    return -1;
  }
  
  if(TP->QueryProp(P_LEVEL)<30)
    return write(BS("Aranor sagt: Ich fuerchte Deine Stufe reicht fuer diese")+
		 BS("Aranor sagt: Aufgabe noch nicht aus...")), -1;
  
  write("Aranor sagt: Danke Dir, ich kann naemlich hier nicht weg.\n"
	"Aranor sagt: Wenn Du alle Risse geschlossen hast, dann komm\n"
	"Aranor sagt: zurueck und gib mir den Stab zuruek und ich habe\n"
	"Aranor sagt: auch eine kleine Belohnung fuer Dich.\n");
  
  stab=clone_object(OBJ "stab")->move(TP, M_NOCHECK);
  return 1;
}

int fertig(string str)
{
  object diamant;
  object stab;
  int questerror;

  notify_fail("Wem moechtest Du was geben?\n");
  
  if(!str || str == "") return 0;
  if(!(str == "aranor stab" )) return 0;
  
  if(!objectp(stab=present("CHIVASSTAB", TP)))
    {
      write(BS("Aranor sagt: Du kannst doch gar nicht fertig sein, Du hast mir "
	       "ja noch nicht mal Hilfe angeboten.\n"));
      
      return -1;
    }
  
  if (stab->quest_fertig()) 
    { 
      if(TP->QueryQuest(QUESTKEY))
	{
	  write("Aranor sagt: Hervorragend, Du hast Deine Aufgabe wieder hervorragend "
		"geloest.\n"
		"Aranor sagt: Ich bin sehr stolz auf Dich.\n"
		"Aranor sagt: Nimm dieses kleine "
		"Geschenk um Dir meine Dankbarkeit zu zeigen.\n");
	  diamant=clone_object("/obj/gems/diamant");
	  diamant->SetProp(P_AMOUNT, 10);
	}
      else
	{
	  write("Aranor sagt: Hervorragend, Du hast Deine Aufgabe hervorragend "
		"geloest.\n"
		"Aranor sagt: Ich bin sehr stolz auf Dich.\n"
		"Aranor sagt: Nimm dieses kleine "
		"Geschenk um Dir meine Dankbarkeit zu zeigen.\n");
	  
	  diamant=clone_object("/p/magic/supergem");
	  diamant->create_super_gem(clone_object("/obj/gems/diamant"));
	}
      
      questerror=TP->GiveQuest(QUESTKEY);
      
      if(questerror!=1)
	return write(BS("Aranor sagt: Da ist ein BUG! Bitte informiere einen "
			"Erzmagier ueber diese Quest.")+
		     BS("Aranor sagt: Die Fehlermeldung lautet: "+questerror)), -1;
      
      if(diamant->move(TP, M_GET)==ME_TOO_HEAVY)
	{
	  write("Das Geschenk ist Dir zu schwer und faellt Dir aus der Hand.\n");
	  diamant->move(MENV, M_NOCHECK);
	}
      
      stab->remove();
      
      return 1;
    }
  
  write("Aranor sagt: Du hast leider noch nicht alle Risse geschlossen.\n"
	"Aranor sagt: Bitte beeile Dich!\n");
  
  return 1;
}
