
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Hoehlenkaefer");
  SetProp(P_LONG, BS(
    "Ein kleiner Hoehlenkaefer krabbelt umher. Sein kleiner bleicher Panzer "
    "schimmert im Licht der Fackeln."));
  SetProp(P_NAME, "Hoehlenkaefer");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
  AddId(({"kaefer","hoehlenkaefer","CHIVASKAEFER"}));
  
  create_default_npc(8);
  SetProp(P_HANDS, ({" mit seinen Beinchen",80,DT_BLUDGEON}));
  SetProp(P_RACE, "Kaefer");
  SetProp(P_SIZE, 40);
  SetProp(P_WEIGHT, 300);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "krabbelt aufgeregt herum");
  SetProp(P_MMSGOUT, "verschwindet im Moos");

  SetProp(P_DIE_MSG,  " wird zerquetscht.\n");
  SetProp(P_KILL_MSG, "Mit mir legst Du Dich nicht mehr an, Du Schuft!");

  AddDetail( ({ "panzer"}),
    "Der Panzer schimmert leicht im Schein der Fackeln.");

 AddInfo(DEFAULT_INFO, "schaut Dich genervt an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das ist dem Hoehlenkaefer zu schwer.\n" }) );

  SetChats(3, ({
          "Der Hoehlenkaefer krabbelt herum.\n",
          "Der Hoehlenkaefer wuehlt im Moos.\n"}) );

  SetAttackChats(10, ({
    "Der Hoehlenkaefer droht mit seinen Beinchen.\n"}) );

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
    case "aergerlich":
      call_out("react", 0, 
	       "krabbelt weg von Dir.", 
	       "krabbelt weg von "+TP->Name(WEM)+".");
      break; 

    case "froh":
      call_out("react", 0, "fliegt hoch und kitzelt Deine Nase.",
        "fliegt hoch und kitzelt "+TP->Name(WEN)+" an der Nase.");
    break;

    default:
      call_out("react", 0, "krabbelt um Dich herum.",
	"krabbelt um "+TP->Name(WEN)+" herum.");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


