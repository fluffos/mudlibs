    case 0:
      SetProp(P_SHORT, "Ein wuetender Daemon aus einer anderen Dimension");
      SetProp(P_LONG, BS("Der Daemon schaut boese und arglistig. Er hat "
			 "kleine Fluegel und spitze Zaehne."));
      SetProp(P_NAME, "Daemon");
      SetProp(P_NAME_ADJ, "wuetend");
      AddAdjective(({"wuetende","wuetenden","wuetend","wuetender"}));
      SetProp(P_GENDER, MALE);
      
      SetProp(P_HANDS, ({" mit seinen Klauen", 250+random(50), 
		    ({DT_BLUDGEON,DT_MAGIC})}));

      SetProp(P_RESISTANCE_STRENGTHS , 
	      ([DT_LIGHTNING: -0.5, DT_MAGIC: -0.3]));
      AddId( ({ "daemon"}) );

      AddSpell(2,600+random(200), 
	       "Der Daemon attackiert Dich mit seiner Magie.\n",
	       "Der Daemon attackiert @WEN mit seiner Magie.\n",
	       ({DT_MAGIC}), ([SP_SHOW_DAMAGE:1]));

      AddSpell(1,800+random(200), 
	       "Der Daemon schleudert Dir einen Blitz entgegen.\n",
	       "Der Daemon schleudert @WEM einen Blitz entgegen.\n",
	       ({DT_LIGHTNING}), ([SP_SHOW_DAMAGE:1]));
      break;
