void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Dimensionsdaemon");
  SetProp(P_LONG, BS(
    "Der Dimensionsdaemon schaut boese und arglistig. Er hat kleine Fluegel "
    "und spitze Zaehne."));
  SetProp(P_NAME, "Dimensionsdaemon");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:50]));
  AddId(({"dimensionsdaemon","daemon","CHIVASDAEMON"}));
  
  create_default_npc(10);
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, -800);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NO_SCORE, 1);
  
  SetProp(P_NOMAGIC,10+random(10));
  
  SetProp(P_MSGIN, "erscheint aus einem Riss in der Dimension");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "erscheint");
  SetProp(P_MMSGOUT, "verschwindet");
  
  SetProp(P_DIE_MSG,  " loest sich fluchend auf.\nEin paar Edelsteine werden zurueckgelassen...\n");
  SetProp(P_NOCORPSE, 1);
  
  AddInfo(DEFAULT_INFO, "blickt wuetend umher.\n");
  
  SetProp(P_SPELLRATE, 35);
  
  generate_daemon();
  
  SetProp( P_REJECT, ({ REJECT_DROP,
		 "Das ist "+name(WEM)+" zu schwer.\n" }) );
  
  SetChats(3, ({
	       Name()+" stapft wuetend umher.\n"}) );
  
  SetAttackChats(10, ({
		     Name()+" schlaegt wild um sich.\n"}) );

  "/obj/gemmaster"->DistributeGem(2, 2, 2, 1);
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;
  
  Kill(TP);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
victim->RemovePursuer(this_object());
}

