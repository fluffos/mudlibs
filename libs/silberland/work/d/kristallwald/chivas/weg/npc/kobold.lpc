
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Kobold");
  SetProp(P_LONG, BS(
    "Ein kleiner Kobold, der Aranor im Kampf unterstuetzt. Er ist klein und "
    "nicht besonders kraeftig, aber er schuetzt seinen Gebieter so gut es "
    "geht."));
  SetProp(P_NAME, "Kobold");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
 AddId(({"kobold","CHIVASKOBOLD"}));

  create_default_npc(8);
  SetProp(P_HANDS, ({" mit seinen Armen",80,DT_BLUDGEON}));
  SetProp(P_RACE, "Kobold");
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,1);

  SetProp(P_MSGIN, "erscheint aus dem Nichts");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "erscheint");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " loest sich auf.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_MSG, "Mit mir legst Du Dich nicht mehr an, Du Schuft!");

  AddInfo(DEFAULT_INFO, "schaut Dich genervt an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das ist dem Kobold zu schwer.\n" }) );

  SetChats(3, ({
          "Der Kobold stapft umher.\n"}) );

  SetAttackChats(10, ({
    "Der Kobold schlaegt wild um sich.\n"}) );

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "beschimpft Dich wuest.", "beschimpft " +
        TP->Name(WEN) + " wuest.");
      break; 

    case "aergerlich":
      call_out("react", 0, "droht mit seinen Faeusten.",
        "bedroht " + TP->Name(WEM) +
        " mit seinen Faeusten.");
    break;

    case "frech":
      call_out("react", 0, "stapft um Dich herum.",
        "krabbelt um "+TP->Name(WEN)+" herum.");
    break;

    case "nett":
      call_out("react", 0, "tritt Dich.",
        "tritt "+TP->Name(WEN)+".");
    break;

    case "froh":
      call_out("react", 0, "kitzelt Deine Nase.",
        "kitzelt "+TP->Name(WEN)+" an der Nase.");
    break;

    default:
      call_out("react", 0, "stapft um Dich herum.",
	"krabbelt herum.");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
