// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Waldsee");
  SetProp( P_INT_LONG,
	"Du stehst direkt an der Felswand, von wo der Wasserfall in diesen See "
        "faellt. Im Schatten der Felswand ist das Gras der Wiese ein wenig "
        "blasser als weiter im Suedosten in der Sonne. Ein kleiner, aber "
        "steiler Pfad fuehrt die Felswand hinauf." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"felswand","wand"}), 
            "Die Felswand ragt steil vor Dir auf. Ein kleiner Pfad fuehrt "
            "an der Felswand nach oben. Ansonsten sind nur ein paar Risse "
            "an der Wand zu erkennen.");

  AddDetail( ({"wasserfall"}),
	    "Der Wasserfall rauscht in den See.");

  AddDetail( ({"see"}),
	    "Der See neben Dir ist nicht sehr gross aber er scheint sehr "
            "tief zu sein, da Du  gleich nach ein paar Metern den Grund "
            "nicht mehr sehen kannst, obwohl das Wasser schoen klar ist.");

  AddDetail( ({"schatten","temperatur"}),
	    "Die Wiese direkt an der Felswand liegt im Schatten, so dass auch "
            "die Temperatur ein wenig niedriger ist als in der Sonne.");
  
  AddDetail( ({"gras","licht"}),
	    "Das Gras im Schatten ist viel blasser als das Gras in der Sonne. "
            "Es bekommt sicher zu wenig Licht.");

  AddDetail( ({"wiese","stellen"}), 
            "Die Wiese ist hier nicht so schoen wie an anderen Stellen.");

  AddDetail( ({"suedosten","dunkelelf"}),
	    "Im Suedosten ist die Sonne. Dort ist es schoener, ausser Du bist "
            "ein Dunkelelf.");

  AddDetail( ({"pfad"}),
	    "Der Pfad fuehrt an der steilen Felswand nach oben. Er ist nicht "
            "sehr breit und es ist sicher gefaehrlich ihn hoch zu steigen.");

  AddDetail( ({"risse"}),
	    "Die Risse sind recht klein. Man kann an ihnen nichts besonderes "
            "erkennen.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen blau. Die Sonne kannst Du hier im Schatten "
            "nicht erkennen.");

  AddDetail( ({"boden"}), 
            "Der Boden besteht aus normalen Gras. Es ist hier im Schatten ein "
            "wenig blasser.");

  AddDetail( ({"sonne"}),
	    "Die Sonne kannst Du momentan nicht sehen.");

  AddDetail( ({"wasser"}),
	    "Das Wasser ist schoen klar.");

  AddDetail( ({"grund","metern","meter"}),
	    "Du kannst ihn nach ein paar Metern nicht mehr sehen.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht eigentlich nach nichts. Es riecht noch "
                          "nicht einmal nach Gras.");  
 
  AddSmell( ({"gras"}),
	   "Das Gras sieht nicht nur blass aus. Es duftet noch nicht einmal.");

   AddSound(DEFAULT_SOUND, "Du hoerst das Rauschen des Wasserfalls.");

  AddSound( ({"rauschen","wasserfall"}),
	   "Das Rauschen uebertoent einfach alles.");
  
//-----Details Ende-----
  
AddExit("suedosten", ROOM "zenw12");
AddExit("nordoben", ROOM "zenw14");

}  
   
