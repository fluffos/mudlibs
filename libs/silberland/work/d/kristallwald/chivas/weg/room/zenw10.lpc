// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl=1;
int anzahl2=1;

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Waldsee");
  SetProp( P_INT_LONG,
	"Du stehst auf einer Lichtung im Wald. Vor Dir breitet sich ein "
        "kleiner See aus, der von einem beeindruckenden Wasserfall gespeisst "
        "wird. Rund um den See stehen kaum Baeume, sondern Du siehst eine "
        "mit Gras bewachsene Wiese. Auf der westlichen Seite fliesst ein "
	"kleiner Fluss aus dem See heraus und verschwindet suedoestlich im "
	"Wald. Durch ein paar grosse Steine im Fluss ist es moeglich nach "
	"Suedwesten zu gehen oder nach Norden naeher an den Wasserfall." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"lichtung"}), 
            "Die Lichtung auf der Du nun stehst besteht aus einer grossen "
            "Wiese und einem kleinen See, der durch einen grossen Wasserfall "
            "gespeist wird.");

  AddDetail( ({"wald","waldes"}),
	    "Der Wald hat wie der Weg geendet und Du stehst nun auf einer "
            "Lichtung.");

  AddDetail( ({"see","waldsee"}),
	    "Der See ist dunkelblau und grenzt direkt an die Wiese. Er wird "
            "durch einen grossen Wasserfall gespeisst und das Wasser fliesst "
            "ueber einen kleinen Fluss aus ihm heraus und verschwindet im "
            "Wald hinter Dir.");

  AddDetail( ({"wasserfall"}),
	    "Der Wasserfall ist riesig, er ergiesst sich von einer Felswand, "
            "die ueber hundert Meter hoch ist, in den See.");
  
  AddDetail( ({"baeume"}),
	    "Die Baeume enden an der Lichtung. Auf der Wiese stehen keine "
            "Baeume mehr.");

  AddDetail( ({"gras","graeser","graesern"}), 
            "Das Gras auf der Wiese ist halbhoch. Einige kleine Blumen wachsen "
            "zwischen den Graesern.");

  AddDetail( ({"wiese"}),
	    "Die Wiese erstreckt sich ueber die ganze Lichtung und umgibt zur "
            "Haelfte den See.");

  AddDetail( ({"seite"}),
	    "An der westlichen Seite fliesst ein kleiner Fluss aus dem See "
            "nach Suedosten.");

  AddDetail( ({"fluss"}),
	    "Der kleine Fluss fliesst aus dem See heraus. Du kannst ihn ueber "
            "ein paar Steine nach Suedwesten ueberqueren.");
  
  AddDetail( ({"steine"}),
	    "Die Steine sind gross, so dass es sehr einfach ist den Fluss zu "
            "ueberqueren.");

  AddDetail( ({"suedwesten"}), 
            "Nach Suedwesten kannst Du weitergehen, wenn Du es moechtest.");

  AddDetail( ({"norden"}),
	    "Im Norden gelangst Du naeher an den Wasserfall.");

  AddDetail( ({"boden"}),
	    "Am Boden siehst Du das Gras und einige kleine Kieselsteine.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen blau und die Sonne steht fast senkrecht "
            "am Himmel.");
  
  AddDetail( ({"weg"}),
	    "Der Weg hat am Rand der Lichtung geendet und Du stehst nun auf "
            "einer schoenen Wiese.");

  AddDetail( ({"rand"}), 
            "Am Rand der Lichtung siehst Du den Weg und die Baeume des "
            "Waldes.");

  AddDetail( ({"wasser"}),
	    "Das Wasser ist dunkel und ein paar Wellen sind zu sehen.");

  AddDetail( ({"felswand","wand"}),
	    "Der Felswand ist ueber hundert Meter hoch.");

  AddDetail( ({"meter"}),
	    "Du untersuchst auch wirklich alles.");
  
  AddDetail( ({"wellen"}),
	    "Die Wellen werden durch den Wasserfall hervor gerufen.");

  AddDetail( ({"blumen"}), 
            "Du siehst ein paar Gaensebluemchen und Veilchen im Gras stehen.");

  AddDetail( ({"gaensebluemchen","bluemchen"}),
	    "Die Gaensebluemchen passen sehr gut auf die Wiese.");

  AddDetail( ({"veilchen"}),
	    "Die blauen Veilchen sehen sehr schoen aus. Vielleicht kannst Du "
            "eines pfluecken und jemanden schenken, den Du magst.");

  AddDetail( ({"haelfte"}),
	    "Die eine Haelfte des Sees ist von der Wiese umringt. Die andere "
            "Haelfte grenzt an die Felswand, von wo der Wasserfall runter in "
            "den See stuerzt.");
  
  AddDetail( ({"sonne","gesicht"}),
	    "Die Sonne waermt Dein Gesicht.");

  AddSpecialDetail( ({ "kieselsteine","kieselstein" }), "kieselstein" );

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst ein paar Blumen auf der Wiese.");  
 
  AddSmell( ({"wiese","blumen","blume"}),
	   "Die Blumen duften herrlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Rauschen des Wasserfalls.");

  AddSound( ({"wasserfall","rauschen"}),
	   "Es ist fast ohrenbetaeubend.");
  
//-----Details Ende-----
  
AddExit("suedosten", ROOM "zenw9");
AddExit("suedwesten", ROOM "zenw12");
AddExit("norden", ROOM "zenw11");

AddCmd( ({"nimm" }), "nehmen" );
AddCmd( ({"pflueck", "pfluecke" }), "pfluecken" );
AddCmd( ({"lass", "lasse" }), "lassen" );

}
void reset()
	
{
  ::reset();
  anzahl=1; 
  anzahl2=1;
}

int nehmen(string str)
{
 object kieselstein;
 notify_fail("Was willst Du nehmen?\n");

 if(!str || str == "") return 0;
 if(!(str == "stein" ||
      str == "kieselstein" )) return 0;
 

 if( str == "stein" ||
     str == "kieselstein"){
    
  if(anzahl < 1)

  {
	  
  write(BS("Die Kieselsteine, die hier liegen sind nicht mehr interessant.\n"));
 
  say(TPN+" arglt ein wenig.\n");
  return 1;
  }
  else
  {
  write(BS("Du nimmst einen schoenen flachen Kieselstein aus dem Gras. \n"));
 
  say(TPN+" nimmt einen schoenen flachen Kieselstein.\n");
  kieselstein=clone_object(OBJ "kieselstein")->move(TP, M_NOCHECK);
  anzahl--;
  return 1;
 }
 }
}

int pfluecken(string str)
{
 object veilchen;
 notify_fail("Was willst Du pfluecken?\n");

 if(!str || str == "") return 0;
 if(!(str == "veilchen" ||
      str == "blume" )) return 0;
 

 if( str == "veilchen" ||
     str == "blume"){
    
  if(anzahl2 < 1)

  {
	  
  write(BS("Die Veilchen, die noch uebrig sind willst Du doch lieber stehen "
           "lassen.\n"));
 
  say(TPN+" arglt ein wenig.\n");
  return 1;
  }
  else
  {
  write(BS("Du pflueckst ein kleines blaues Veilchen aus dem Gras. \n"));
 
  say(TPN+" nimmt eine schoene kleine Blume.\n");
  veilchen=clone_object(OBJ "veilchen")->move(TP, M_NOCHECK);
  anzahl2--;
  return 1;
 }
 }
}

int lassen(string str)
{
   if ( member( ({"stein springen","kieselstein springen","kieselstein ueber oberflaeche springen","stein ueber oberflaeche springen"})
,str) != -1) 
  {
    write(BS( "Du ueberlegst ob Du hier einen Kieselstein ueber die Oberflaeche "
           "des Sees springen lassen koenntest, findest aber, dass es dafuer "
           "sicher eine bessere Stelle geben koennte.\n"));
    say( TPN+" ueberlegt kurz und entscheidet sich anders.\n");
    return 1;
  }
}

string kieselstein(string key)
{
    if ( anzahl < 1 )
    {
    return(BS("Die Kieselsteine sind nicht sehr interessant. Wuerde hier "
              "noch ein flacher liegen, waere es toll."));
    }
    else
    {
    return(BS("Es liegen verschiedene Kieselsteine im Gras. Ein besonders "
            "flacher Kieselstein faellt Dir besonders auf. Du kannst ihn "
            "mitnehmen und vielleicht was damit machen.\n"));
    }
}
   
