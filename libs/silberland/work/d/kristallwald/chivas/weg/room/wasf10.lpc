// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer grossen Kammer");
  SetProp( P_INT_LONG,
	"Die Kammer in der Du stehst ist riesengross und ueberall mit Runen "
        "und Schriftzeichen uebersaeht. In der Mitte der Kammer scheint ein "
        "grosser schmaler Riss zu sein, der aus sich heraus zu pulsieren "
        "scheint." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"kammer"}), 
            "Die Kammer ist riesig und leer, jedoch faellt Dir sofort der "
            "pulsierende Riss in der Mitte der Kammer auf.");

  AddDetail( ({"runen"}),
	    "Die ganzen Waende sind mit mystischen Runen uebersaeht. Ihre "
            "Bedeutung ist Dir jedoch nicht klar. Du merkst nur, dass "
            "magische Kraefte von den Runen ausgehen.");

  AddDetail( ({"schriftzeichen"}),
	    "Die Schriftzeichen sind in einer alten Dir unbekannten Sprache "
            "verfasst. Es scheinen eine Art Bannformeln zu sein, die den "
            "Riss in der Mitte in seiner Macht zu beschraenken scheinen.");

  AddDetail( ({"mitte","luft"}),
	    "In der Mitte der Kammer haengt ein grosser pulsierender Riss "
            "mitten in der Luft.");
  
  AddDetail( ({"riss","risses","dimensionen"}),
	    "Der grosse pulsierende Riss in der Mitte der Kammer wirkt ein "
            "wenig beunruhigend. Es scheint ein Riss zwischen den Dimensionen "
            "zu sein. Ab und zu sieht es so aus, als ob ein paar Daemonen "
            "ihre Krallen und Koepfe aus dem Riss stecken, jedoch von den "
            "Bannformeln an den Waenden gehindert werden, diese Welt zu "
            "betreten.");

  AddDetail( ({"waende","waenden"}), 
            "Die Waende sind mit lauter Runen und Schriftzeichen uebersaeht. "
            "Ausserdem haengen Halterungen fuer die Fackeln an den Waenden.");

  AddDetail( ({"boden"}),
	    "Der Boden besteht aus Granit und ist spiegelblank. Du kannst "
            "sogar Dein eigenes Spiegelbild sehen, da nicht ein Staubkorn "
            "am Boden zu sehen ist.");

  AddDetail( ({"decke"}),
	    "Selbst die Decke ist mit Runen und Schriftzeichen ueberzogen.");

  AddDetail( ({"bedeutung"}),
	    "Die Bedeutung verstehst Du nicht.");
  
  AddDetail( ({"kraefte"}),
	    "Die Runen und Schriftzeichen scheinen gewisse Kraefte zu haben, "
            "die die Macht des Risses zu bannen scheinen.");

  AddDetail( ({"sprache"}), 
            "Die Sprache, in der die Schriftzeichen geschrieben sind, ist Dir "
            "nicht bekannt.");

  AddDetail( ({"art","bannformeln","bannformel","formeln"}),
	    "Die Bannformeln muessen sehr stark sein, da der Riss auch "
            "trotz der Formeln sehr viel Macht ausstrahlt und wild am "
            "pulsieren ist.");

  AddDetail( ({"macht"}),
	    "Von dem pulsierenden Riss geht eine ungeheure Macht aus.");

  AddDetail( ({"lichtschein","licht"}),
	    "Der Lichtschein der Fackeln erhellt die ganze Kammer.");
  
  AddDetail( ({"fackeln"}),
	    "Die Fackeln in den Halterungen an den Waenden leuchten in einer "
            "magischen blauen Farbe.");

  AddDetail( ({"farbe","flammen"}), 
            "Die blaue Farbe der Flammen wirkt magisch.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen in der Kammer sind nicht so schaebig wie in der "
            "Hoehle. Sie bestehen aus purem Gold und haben wunderschoene "
            "Verzierungen.");

  AddDetail( ({"gold"}),
	    "Leider wuerde es auffallen, wenn Du eine der Halterungen "
            "einstecken wuerdest. Du kannst Dich gerade noch zurueckhalten.");

  AddDetail( ({"verzierungen"}),
	    "Es sind ein paar Kreise und Linien zu sehen.");
  
  AddDetail( ({"kreise","linien","grund"}),
	    "Die Kreise und Linien scheinen keinen besonderen Grund zu "
            "haben.");

  AddDetail( ({"staubkorn","staub"}), 
            "Es ist kein Staub zu erkennen.");

  AddDetail( ({"himmel"}),
	    "Den Himmel gibt es hier in der Kammer nicht.");

  AddDetail( ({"oberflaeche"}),
	    "Die pulsierende Oberflaeche scheint das Licht zu verschlucken.");

  AddDetail( ({"hoehle"}),
	    "Die Hoehle ist ausserhalb der Kammer.");

  AddDetail( ({"krallen"}),
	    "Die Krallen die aus dem Riss ab und zu erscheinen sind "
            "messerscharf und sehen gefaehrlich aus. Du willst sie nicht auf "
            "Deiner Haut spueren.");

  AddDetail( ({"koepfe"}),
	    "Die Koepfe die zeitweise im Riss erscheinen gehoeren Daemonen aus "
            "einer anderen Dimension. Sie sehen schrecklich aus.");

  AddDetail( ({"daemonen","wesen"}),
	    "Daemonen sind schreckliche Wesen.");

  AddDetail( ({"haut"}),
	    "Du koenntest Deine Haut ruhig mal wieder waschen.");

  AddDetail( ({"welt","silberland"}),
	    "Diese Welt ist das Silberland.");
  
  AddDetail( ({"granit"}),
	    "Der Granit ist sauber und man kann sein Spiegelbild erkennen.");

  AddDetail( ({"spiegelbild"}), 
            "Du findest Dich sehr schoen, obwohl Du definitiv mal duschen "
            "solltest.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht hier nach gar nichts. Es ist sehr steril.");  
  
  AddSound(DEFAULT_SOUND, "Du hoerst das Pulsieren des Steins.");

  AddSound( ({"pulsieren"}),
	   "Das Pulsieren ist sehr schwer zu beschreiben. Es hoert sich an "
           "wie ein Herz das schlaegt, nur lauter.");
  
  AddSound( ({"herz"}),
	   "bumm, bumm, bumm, bumm, ...");

//-----Details Ende-----
AddItem(NPC "aranor", REFRESH_DESTRUCT);
  
AddExit("suedwesten", ROOM "wasf9");

}  
   
