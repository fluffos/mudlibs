// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Waldsee");
  SetProp( P_INT_LONG,
	"Vor Dir tut sich eine grosse Felswand auf, ueber die der "
        "beeindruckende Wasserfall in den See stuerzt. Der Boden ist mit "
        "verschiedenen Graesern bewachsen, die bis an das Seeufer reichen. "
        "Einige Wellen, die durch den Wasserfall erzeugt werden schwappen an "
        "das flache Ufer." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"felswand","wand"}), 
            "Die Felswand ragt neben Dir mehr als hundert Meter auf. Sie ist "
            "fast senkrecht und nur ein paar Risse sind an ihr zu sehen.");

  AddDetail( ({"wasserfall"}),
	    "Der Wasserfall stuerzt direkt neben Dir an der Felswand herunter. "
            "Da Du nun so dicht neben ihm stehst, erkennst Du erst richtig wie "
            "gewaltig er ist.");

  AddDetail( ({"see","sees"}),
	    "Der See ist dunkel und die Oberflaeche ist mit Schaum und Wellen "
            "aufgewuehlt.");

  AddDetail( ({"boden"}),
	    "Am Boden sind lauter Graeser zu erkennen.");
 
  AddDetail( ({"wasser"}),
	    "Viel Wasser stuerzt in den See.");
 
  AddDetail( ({"graesern","graeser"}),
	    "Solche Graeser findet man oft auf einer Wiese. Sie sind nicht "
            "besonders interessant.");

  AddDetail( ({"seeufer","ufer"}), 
            "Die Wellen, die der Wasserfall verursacht, schwappen an das "
            "Seeufer, wo ein wenig Schilf waechst.");

  AddDetail( ({"wellen"}),
	    "Die Wellen sind nicht sehr gross, wenn sie an das Seeufer "
            "schwappen, jedoch ist die Oberflaeche des Sees nie ruhig.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist klar und die Sonne scheint. Auch ein paar Voegel "
            "sind am Himmel zu erkennen.");

  AddDetail( ({"meter"}),
	    "Du untersuchst wirklich alles.");
  
  AddDetail( ({"risse"}),
	    "Die Risse sind ueberall zu sehen. Du kannst aber sicher nicht an "
            "ihnen hoch klettern, da die parallel verlaufenen Risse zu weit "
            "von einander entfernt sind. Ein grosser Riss ist jedoch fuer "
            "Dich in reichbarer Naehe und verlaeuft direkt an der Wand entlang "
            "und verschwindet unter dem Wasserfall.");

  AddDetail( ({"naehe"}), 
            "Du kannst ihn ohne Probleme erreichen und sicher an ihm nach "
            "Westen klettern.");

  AddDetail( ({"westen"}),
	    "Im Westen von Dir befindet sich der grosse Wasserfall.");

  AddDetail( ({"probleme"}),
	    "Wir alle haben Probleme. Manche haben mehr und manche haben "
            "weniger.");

  AddDetail( ({"riss"}),
	    "Ein grosser Riss laeuft quer ueber die Felswand. Er ist sehr "
            "glitschig, da viele Algen sich auf dem feuchten Riss angesammelt "
            "haben.");
  
  AddDetail( ({"algen"}),
	    "Die Algen sind gruen und glitschig. Igitt!");

  AddDetail( ({"voegel"}), 
            "Die Voegel fliegen sehr hoch, so dass Du nicht genau erkennen "
            "kannst, was fuer Voegel es genau sind.");

  AddDetail( ({"sonne"}),
	    "Die Sonne steht fast senkrecht am Himmel.");

  AddDetail( ({"oberflaeche"}),
	    "Die Oberflaeche des Sees ist sehr unruhig. Es sind lauter kleine "
            "Wellen und Schaum zu sehen.");

  AddDetail( ({"schaum","hoehe","wassermassen","massen"}),
	    "Der Schaum entsteht, wenn die Wassermassen aus der Hoehe in den "
            "See stuerzen.");
  
  AddDetail( ({"wiese"}),
	    "Du stehst auf einer Wiese mit lauter Graesern und Blumen.");

  AddDetail( ({"schilf"}), 
            "Das Schilf steht am Seeufer und gedeiht sehr gut.");

  AddDetail( ({"blumen"}),
	    "Ein paar kleine Blumen sind zwischen den Graesern zu sehen. "
            "Es ist nichts besonderes an ihnen zu sehen");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst die Graeser und Blumen, die hier "
                          "wachsen.");  
 
  AddSmell( ({"graeser"}),
	   "Die Graeser duften wuerzig.");

  AddSmell( ({"blumen"}),
	   "Die Blumen duften blumig.");
  
  
  AddSound(DEFAULT_SOUND, "Du hoerst das Rauschen des Wasserfalls.");

  AddSound( ({"rauschen","wasserfall"}),
	   "Es ist ein ohrenbetaeubendes Geraeusch.");
  
  AddSound( ({"geraeusch"}),
	   "Es ist wirklich sehr laut.");

//-----Details Ende-----
  
AddExit("sueden", ROOM "zenw10");

AddCmd( ({"kletter", "klettere" }), "klettern" );

}
int klettern(string str)
{
   notify_fail("Woran moechtest Du wohin klettern?\n");
   if ( member( ({ "an rissen nach westen","an riss nach westen" }),str) != -1) 
  {
    write(BS ( "Du greifst in die tiefen Risse an der Felswand und kletterst "
               "an ihnen nach Westen unter den Wasserfall. Du bist froh, dass "
               "Du an der glitschigen Wand nicht abgerutscht bist.\n"));
      TP->move(ROOM "wasf1", M_GO, 
      "ploetzlich unter dem Wasserfall", "verschwindet", 
      "klettert herein");
    return 1;
  }
}

