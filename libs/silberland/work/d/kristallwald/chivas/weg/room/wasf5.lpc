// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int kaeferda;

void create()
	
{
  ::create();

   kaeferda=1; 

  SetProp( P_INT_SHORT, "In einer Hoehle");
  SetProp( P_INT_LONG,
	"Der Boden ist uneben und mit ein wenig Moos bedeckt. Die Waende sind "
        "unbehauen. Der einzige Hinweis, dass schon einmal Jemand hier war "
        "sind die eisernen Fackelhalter mit den darin brennenden Fackeln." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"boden"}), 
            "Am Boden waechst ein wenig Moos.");

  AddDetail( ({"moos"}),
	    "Das Moos ist gruen und Etwas bewegt sich im Moos.");

  AddDetail( ({"waende"}),
	    "Die Waende sind unbehauen. Nur die Halterungen fuer die Fackeln "
            "deuten darauf hin, dass schon Jemand vor Dir hier war.");

  AddDetail( ({"hinweis"}),
	    "Die Halter sind ein guter Hinweis.");
  
  AddDetail( ({"jemand"}),
	    "Vielleicht war es ein unsichtbarer Magier.");

  AddDetail( ({"fackelhalter","halter","halterungen"}), 
            "Die Halterungen sind alt und verrostet.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln erhellen die Hoehle ein wenig.");

  AddDetail( ({"etwas"}),
	    "Vielleicht kannst Du Etwas aufscheuchen.");

  AddDetail( ({"hoehle"}),
	    "Du befindest Dich in einer.");

  AddDetail( ({"magier"}),
	    "Die Magier verbrechen einiges.");

  AddDetail( ({"himmel"}),
	    "Einen Himmel gibt es hier nicht, hoechstens eine Decke.");

  AddDetail( ({"decke"}),
	    "Die Decke ist weit ueber Dir. Du kannst sie nicht sehen.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach gar nichts.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst leise Geraeusche im Moos.");

  AddSound( ({"moos","geraeusche"}),
	   "Irgendetwas steckt im Moos. Vielleicht kann man es aufscheuchen.");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "wasf6");
AddExit("sueden", ROOM "wasf4");

AddCmd( ({"scheuch", "scheuche" }), "scheuchen" );

}
void reset()
{
  ::reset();
  kaeferda=1;
  
}

int scheuchen (string str)
{
  notify_fail ("Was moechtest Du aufscheuchen?\n");

  if(!str) return 0;
  
  if(!(str == "etwas auf" )) return 0;

  if (present("CHIVASKAEFER",TO) || !kaeferda)
    {
      write(BS("Du erkennst nicht besonderes, Du hast Dich sicher getaeuscht."));
      return -1;
    }
  
  write(BS("Du scheuchst Etwas im Moos auf und erschreckst.\n"));
  
  kaeferda=0;
  
  clone_object(NPC "hoehlenkaefer")->move(TO,M_GO|M_NOCHECK,"krabbelt aus dem Moos");
  
  return 1;
}

