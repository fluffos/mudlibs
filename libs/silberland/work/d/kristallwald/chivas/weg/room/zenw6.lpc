// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int angel_zahl=1;

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer kleinen Bruecke");
  SetProp( P_INT_LONG,
	"Du stehst auf einer kleinen Holzbruecke im Wald, die einen kleinen "
        "Fluss ueberspannt. Die Balken der Bruecke scheinen schon sehr alt zu "
        "sein, da ueberall an ihnen Moos waechst. Das Gelaender der Bruecke "
        "ist mit ein paar Verzierungen versehen und bietet guten Halt auf "
        "dem rutschigen Untergrund." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"holzbruecke","bruecke"}), 
            "Die Holzbruecke fuehrt ueber einen kleinen Fluss im Wald.");

  AddDetail( ({"wald"}),
	    "Der Wald besteht aus hohen Baeumen.");

  AddDetail( ({"fluss","flusses"}),
	    "Der kleine Fluss schlaengelt sich unter der Bruecke durch den "
            "Wald. Du kannst im Wasser einige Forellen erkennen, die gegen "
            "die Stroemung anschwimmen. An seinem Ufer stehen verschiedene "
            "Pflanzen.");

  AddDetail( ({"balken","bohlen"}),
	    "Die maechtigen Balken, die die Bruecke bilden sind sehr alt. "
            "Sie stammen sicher von einer grossen Eiche aus dem Wald. Auf den "
            "Bohlen ist Moos zu sehen, wodurch die Bruecke ein wenig "
            "rutschig wird.");
  
  AddDetail( ({"moos"}),
	    "Das Moos gedeiht sehr gut auf der Bruecke. Es besitzt eine "
            "schoene gesunde gruene Farbe. Jedoch ist es sehr rutschig, wenn "
            "man auf das Moos tritt um die Bruecke zu ueberqueren.");

  AddDetail( ({"gelaender"}), 
            "Das alte Gelaender der Bruecke besteht auch aus Holz. Auf dem "
            "Gelaender sind verschiedene Verzierungen zu erkennen.");

  AddDetail( ({"verzierungen","verzierung"}),
	    "Die alten Verzierungen stellen einen See mit einem Wasserfall "
            "dar.");

  AddDetail( ({"halt"}),
	    "Das Gelaender bietet guten Halt und man faellt nicht so leicht "
            "in den Fluss.");

  AddDetail( ({"untergrund"}),
	    "Der Untergrund ist durch das Moos sehr rutschig. Pass auf!");
  
  AddDetail( ({"baeumen","baeume"}),
	    "Die Baeume im Wald sind gross gewachsen. Sie stehen aber nicht "
            "so dicht beieinander. Du kannst ohne Problem den Himmel sehen.");

  AddDetail( ({"wasser"}), 
            "Das Wasser ist klar und Du erkennst die Steine auf dem Boden des "
            "Flusses. Ausserdem siehst Du die Forellen im Fluss schwimmen.");

  AddDetail( ({"forellen","forelle"}),
	    "Die Forellen schwimmen gegen die Stroemung. Vielleicht kann man "
            "hier angeln und eine fangen.");

  AddDetail( ({"stroemung","muehe"}),
	    "Die Stroemung ist nicht so stark. Die Forellen haben keine "
            "grosse Muehe.");

  AddDetail( ({"ufer"}),
	    "Am Ufer des Flusses stehen viele Wasserpflanzen.");
  
  AddDetail( ({"pflanzen","wasserpflanzen"}),
	    "Du erkennst Schilf, einige Wasserblumen und andere Pflanzen, die "
            "Du noch nie gesehen hast.");

  AddDetail( ({"eiche","eichen"}), 
            "Die Eiche, aus deren Holz die Balken fuer die Bruecke stammen, "
            "kommt aus dem Wald. Gleich am Wegrand noerdlich der Bruecke "
            "ist ein grosser, schon sehr verwitterter, Baumstumpf zu sehen.");

  AddDetail( ({"see"}),
	    "Der See scheint an einem steilen Abhang im Wald zu sein. Ein "
            "Wasserfall ergiesst sich in den See.");

  AddDetail( ({"wasserfall"}),
	    "Der Wasserfall ist selbst auf der Verzierung beeindruckend.");

  AddDetail( ({"himmel"}),
	    "Die Sonne strahlt und Du erkennst auch ein paar Voegel weit "
            "oben am Himmel.");
  
  AddDetail( ({"sonne"}),
	    "Die Sonne steht beinahe senkrecht am Himmel.");

  AddDetail( ({"baumstumpf","stumpf"}), 
            "Der Baumstumpf am Wegrand noerdlich der Bruecke ist von "
            "verschiedenen Graesern fast "
            "schon zugewachsen. Es ist lange her, dass die Eiche gefaellt "
            "wurde und aus ihrem Holz die Bruecke gebaut wurde.");

  AddDetail( ({"holz"}),
	    "Es gibt viel Holz in einem Wald. Es ist fast nicht zu glauben.");

  AddDetail( ({"boden"}),
	    "Der Boden besteht aus den Balken der Bruecke, oder meintest Du "
            "den Flussboden?");

  AddDetail( ({"flussboden"}),
	    "Der Boden des Flusses ist mit Steinen und einigen Algen bedeckt. "
            "Du kannst ihn gut erkennen, da das Wasser schoen klar ist.");
  
  AddDetail( ({"steine","steinen"}),
	    "Die Steine sind teilweise grosse Steinbrocken.");

  AddDetail( ({"algen"}), 
            "Die Algen sind gruen wie das Moos auf der Bruecke.");

  AddDetail( ({"steinbrocken","brocken","kieselsteine"}),
	    "Die Steinbrocken sind groesser als kleine Kieselsteine.");

  AddDetail( ({"voegel"}),
	    "Es scheinen ein paar Raubvoegel zu sein, die von weit oben "
            "nach Beute suchen.");

  AddDetail( ({"raubvoegel"}),
	    "Es scheinen grosse Adler zu sein.");
  
  AddDetail( ({"adler"}),
	    "Sie kommen sicher aus dem hohen Gebirge.");

  AddDetail( ({"gebirge"}),
	    "Das Gebirge ist weit weg.");

  AddDetail( ({"beute"}),
	    "Hoffentlich bist Du nicht die Beute.");
  
  AddDetail( ({"schilf"}),
	    "Das Schilf ist am Ufer sehr hoch gewachsen.");

  AddDetail( ({"wasserblumen","blumen"}),
	    "Die Wasserblumen sind Sumpfiris und einige Sumpfdotterblumen.");

  AddDetail( ({"sumpfiris","iris","plaetzen"}),
	    "Die Sumpfiris kann bis zu 40 cm unter Wasser stehen und wird bis "
            "zu 80 cm gross. Sie liebt es an sonnigen bis halbschattigen "
            "Plaetzen zu wachsen und blueht meistens von Juni bis August. "
            "Du bist begeistert, wie gebildet Du bist, oder war es doch "
            "Google? \n"
            "Uebrigens blueht sie gelb.");
  
  AddDetail( ({"sumpfdotterblumen","sumpfdotterblume","caltha palustris","caltha","hahnenfussgewaechse","ranunculaceae","familie","pflanzenart"}),
	    "Die Sumpfdotterblume, auch Caltha palustris genannt, ist eine "
            "Pflanzenart aus der Familie der Hahnenfussgewaechse, die auch "
            "Ranunculaceae genannt werden. Es lebe Google.");

  AddDetail( ({"august","juni"}),
	    "Dies ist ein Monat.");
  
  AddDetail( ({"monat","tode","wort","forschen"}),
	    "Es sollen sich schon welche zu Tode geforscht haben.");

  AddDetail( ({"google"}),
	    "Du kannst dieses Wort nicht so richtig einordenen und solltest "
            "es wieder vergessen.");

  AddDetail( ({"nerven"}),
	    "Du hast noch nie Nerven gezeigt.");
  
  AddDetail( ({"abhang"}),
	    "Es sieht auf der Verzierung nach einem sehr steilen Abhang aus, "
            "da sich ja ein grosser Wasserfall bilden konnte.");

  AddDetail( ({"farbe"}),
	    "Das Moos und die Blaetter sind gruen, die Baumstaemme braun und "
            "die Blumen gelb.");

  AddDetail( ({"baumstaemme","baumstamm"}),
	    "In einem Wald mit Baeumen gibt es natuerlich auch Baumstaemme.");
  
  AddDetail( ({"problem"}),
	    "Du hast keins.");

  AddDetail( ({"blaetter","nadelwald"}),
	    "Blaetter sind in einem Wald etwas ganz normales, ausser Du "
            "befindest Dich in einem Nadelwald, jedoch ist dies keiner.");

  AddDetail( ({"graeser","graesern"}),
	    "Verschiedene Graeser haben den Baumstumpf fast schon komplett "
            "unter sich verdeckt. Mehr kannst Du von hier aus nicht "
            "erkennen.");

  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand noerdlich der Bruecke steht ein alter zugewachsener "
            "Baumstumpf zwischen den Straeuchern.");

  AddDetail( ({"straeucher","straeuchern"}),
	    "Um es genauer zu sehen musst Du die Bruecke verlassen.");

  AddDetail( ({"weg"}),
	    "Der weg fuehrt nach Norden und Sueden weiter.");

  AddDetail( ({"norden","sueden"}),
	    "Dies ist eine Himmelsrichtung.");

  AddDetail( ({"himmelsrichtung","richtung"}),
	    "Nun uebertreibst Du ein wenig beim Forschen.");


  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen","wasserblumen"}),
	   "Die Blumen am Fluss duften suesslich.");
  
  AddSound(DEFAULT_SOUND, "Du hoerst das Plaetschern des Flusses.");

  AddSound( ({"fluss","plaetschern"}),
	   "Das Plaetschern beruhigt Deine Nerven.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "zenw5");
AddExit("norden", ROOM "zenw7");

AddCmd( ({"angel","angle" }), "angeln" );
}

void reset()
	
{
  ::reset();
  angel_zahl=1; 
}

int angeln(string str)
{
 object forelle;
 notify_fail("Was willst Du womit angeln?\n");

 if(!str || str == "") return 0;
 if(!(str == "mit angel" ||
      str == "forelle" ||
      str == "forelle mit angel" ||
      str == "fisch mit angel" ||
      str == "fisch" ||
      str == "mit angel forelle" ||
      str == "mit angel nach fisch" )) return 0;
 

 if( str == "mit angel" ||
     str == "forelle mit angel" ||
     str == "mit angel forelle" ||
     str == "fisch mit angel" ||
     str == "mit angel fisch"){
    
  if(!present("angel", TP)){
	  
  write(BS("Du hast ja gar keine. Wie willst Du dann mit einer Angel angeln?\n"));
 
  say(TPN+" denkt nach.\n");
  return -1;
  }

  if(angel_zahl < 1)

  {
	  
  write(BS("Die Forellen fallen auf den Koeder an der Angel nicht mehr rein.\n"));
 
  say(TPN+" angelt umsonst.\n");
  return 1;
  }
  else
  {
  write(BS("Du angelst wild vor Dich hin und ploetzlich beisst auch eine "
	   "Forelle an. Du schnappst sie Dir und steckst sie ein. \n"));
 
  say(TPN+" faengt mit der Angel eine schoene Forelle.\n");
  forelle=clone_object(OBJ "forelle")->move(TP, M_NOCHECK);
  angel_zahl--;
  return 1;
 }
 if( str == "forelle" ||
     str == "fisch"){
 
 write(BS("Womit willst Du denn angeln ? "
	  "Eine Angel waere hier eine gute Idee.\n"));

 say(TPN+" stellt sich dumm an.\n");
 return 1;
 }
 }
}


