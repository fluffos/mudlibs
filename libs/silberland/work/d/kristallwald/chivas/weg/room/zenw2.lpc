// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Waldweg");
  SetProp( P_INT_LONG,
	"Der Weg fuehrt durch ein dicht bewachsendes Stueck Wald. Im Sueden "
        "kann man noch das Nordtor von Roch Adan erkennen. Im Norden siehst Du "
        "nur wie der Weg sich weiter durch den Wald schlaengelt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"weg","weges"}), 
            "Die Baeume am Rand des Weges geben die Richtung vor. Du kannst "
            "entweder nach Norden weiter in den Wald oder nach Sueden zum "
            "Nordtor von Roch Adan.");

  AddDetail( ({"stueck","wald","norden"}),
	    "Der Wald ist bezaubernd. Er macht einen sehr friedlichen Eindruck. "
            "Ueberall stehen grosse Eichen und Buchen und verdecken mit ihren "
            "Blaettern den Himmel.");

  AddDetail( ({"sueden","nordtor","tor"}),
	    "Du kannst das Tor im Sueden noch zwischen den Baeumen erkennen.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren.");
  
  AddDetail( ({"richtung"}),
	    "Es geht nach Norden und nach Sueden.");

  AddDetail( ({"boden","waldboden"}), 
            "Am Boden liegen einige Blaetter und kleine Steine herum. Am Rand "
            "des Weges ist auch ein wenig Gras zu sehen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist durch das Blaetterdach kaum zu sehen, nur einige "
            "Lichtstrahlen erreichen den Boden.");

  AddDetail( ({"blaetter","blaettern"}),
	    "Es liegen einige Blaetter am Boden. Ansonsten bilden die Blaetter "
            "ein sehr dichtes Blaetterdach.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach ist sehr dicht und laesst kaum Licht auf den "
            "Waldboden fallen.");
  
  AddDetail( ({"lichtstrahlen","strahlen","licht"}),
	    "Die Lichtstrahlen bilden kleine helle Flecke auf dem Waldboden.");

  AddDetail( ({"flecke"}), 
            "Die Flecke der Lichtstrahlen verschwinden staendig, da die "
            "Blaetter sich leicht im Wind bewegen.");

  AddDetail( ({"wind"}),
	    "Du kannst ihn ganz leise hoeren.");

  AddDetail( ({"baeume","baeumen"}),
	    "Die Baeume sind hauptsaechlich Eichen und Buchen.");

  AddDetail( ({"eiche","eichen","jahren","jahre","hunderte"}),
	    "Die grossen Eichen sind sicher schon Hunderte von Jahren alt.");
  
  AddDetail( ({"buche","buchen"}),
	    "Die Buchen sind sehr gross und bilden ein dichtes Blaetterdach.");

  AddDetail( ({"zentauren"}), 
            "Die Zentauren leben in Roch Adan.");

  AddDetail( ({"rand","wegrand"}),
	    "Am Wegrand sind ein paar Graeser zu sehen und ein groesserer "
            "Steinbrocken.");

  AddDetail( ({"steine"}),
	    "Zwischen den Steinen liegen auch einige kleine Zweige.");

  AddDetail( ({"zweige"}),
	    "Die Zweige sind wohl von den Baeumen gefallen.");
  
  AddDetail( ({"graeser","gras"}),
	    "Die Graeser wachsen nicht sehr hoch, da sie nicht sehr viel Licht "
            "bekommen.");

  AddDetail( ({"steinbrocken","brocken"}), 
            "Auf dem Steinbrocken ist Etwas eingeritzt.");

  AddDetail( ({"etwas"}),
	    "Es scheint eine kurze Inschrift zu sein.");

  AddDetail( ({"inschrift"}),
	    "Du kannst sie lesen.");

  AddDetail( ({"eindruck","wichtigste"}),
	    "Der erste Eindruck ist immer der Wichtigste.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Pflanzen.");  
 
  AddSmell( ({"pflanzen"}),
	   "Es riecht nach Baeumen.");

  AddSmell( ({"baeume"}),
	   "Es ist ganz normal, dass es in einem Wald nach Baeumen riecht.");
  
  
  AddSound(DEFAULT_SOUND, "Du hoerst den Wind leicht durch die Blaetter wehen.");

  AddSound( ({"wind","blaetter"}),
	   "Der Wind bringt die Blaetter leicht zum Rascheln.");
  
  AddSound( ({"rascheln"}),
	   "*raschel*raschel*raschel*raschel*");

  AddReadDetail( ({"inschrift"}),
		"Ich entschuldige mich schon einmal im voraus bei Justavius \n"
                "fuer vorhandene Fehler, die keinem vorher aufgefallen sind.\n"
                "                                                    Chivas\n");


//-----Details Ende-----
AddItem( "/d/ebene/lamuerte/wwald/npc/wolf", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "zenw2",
          P_MNPC_AREA:({ROOM "zenw2","zenw1","zenw3"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("sueden", ROOM "zenw1");
AddExit("norden", ROOM "zenw3");

}  
   
