// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  AddRoomMessage( ({ "In der Ferne schreit ein Kaeuzchen.\n",
                     "Ein paar Voegel zwitschern hoch oben in den Eichen.\n"}),
                     30, "sound" );

  SetProp( P_INT_SHORT, "Auf einem Waldweg");
  SetProp( P_INT_LONG,
	"Am Wegrand, zwischen zwei grossen, alten Eichen, steht eine verlassene "
        "und schon sehr herunter gekommene Holzhuette. Der Weg fuehrt direkt "
        "an ihr vorbei, jedoch scheint seit Jahren kein Lebewesen die Huette "
        "betreten zu haben. Der Weg fuehrt weiter durch den Wald in Richtung "
        "Norden." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"wegrand","rand"}), 
            "Am Wegrand steht eine alte Holzhuette. Vor ihr war anscheinend "
            "mal eine Rasenflaeche, da direkt vor ihr keine Baeume sind nur "
            "sehr hoch gewachsenes Gras. An beiden Seiten der Huette steht "
            "jeweils eine grosse und sehr alte Eiche.");

  AddDetail( ({"eichen"}),
	    "Die beiden Eichen stehen dicht an der alten Holzhuette. Ihre "
            "Aeste reichen weit nach oben und bilden ein dichtes Dach aus "
            "Blaettern.");

  AddDetail( ({"holzhuette","huette"}),
	    "Die Holzhuette sieht schon ein wenig verfallen aus. Die "
            "Fenster sind zerbrochen oder schmutzig und die verrostete Tuer "
            "ist auch nicht im besten Zustand. Die ehemalige Farbe der Huette "
            "ist nicht mehr genau zu definieren.");

  AddDetail( ({"weg"}),
	    "Der Weg fuehrt weiter in den Wald hinein.");
  
  AddDetail( ({"jahren","jahre","lebewesen"}),
	    "Seit Jahren war kein Lebewesen in der alten Huette.");

  AddDetail( ({"wald"}), 
            "Du befindest Dich schon tief im Wald.");

  AddDetail( ({"richtung","norden"}),
	    "Der Weg fuehrt weiter in den Wald hinein.");

  AddDetail( ({"boden","waldboden"}),
	    "Am Boden ist Erde und ein paar Steinchen zu sehen.");

  AddDetail( ({"himmel"}),
	    "Den Himmel kann man durch das dichte Blaetterdach nicht erkennen.");
  
  AddDetail( ({"rasenflaeche","flaeche","gras"}),
	    "Das Gras reicht einem Troll bis an die Knie. Eine Fee wuerde man "
            "gar nicht mehr erkennen.");

  AddDetail( ({"seiten","seite"}), 
            "An beiden Seiten der Huette stehen grosse Eichen.");

  AddDetail( ({"eiche"}),
	    "Die Eiche rechts von der Huette ist ein wenig groesser als die "
            "Eiche links von der Huette. Ansonsten sehen sie fast identisch "
            "aus. Der Umfang ihrer Staemme ist riesig.");

  AddDetail( ({"baeume"}),
	    "Neben den beiden Eichen siehst Du auch noch andere Baeume. Du "
            "erkennst ein paar Ulmen, Erlen und Kastanien.");

  AddDetail( ({"dach","blaetterdach"}),
	    "Das Dach welches die Eichen bilden ist sehr dicht und laesst "
            "kaum Sonnenstrahlen durch. Die Sonne und den Himmel kann man "
            "nur erahnen.");
  
  AddDetail( ({"blaettern","blaetter"}),
	    "Die Blaetter an den Aesten bewegen sich leicht im Wind.");

  AddDetail( ({"sonne"}), 
            "Die Sonne kannst Du nicht sehen.");

  AddDetail( ({"sonnenstrahlen","strahlen"}),
	    "Die Sonnenstrahlen erreichen nur teilweise den Waldboden. Einige "
            "Flecken sind zu sehen.");

  AddDetail( ({"flecke","flecken"}),
	    "Die Flecke tanzen auf dem Waldboden hin und her, da sich die "
            "Blaetter der Baeume leicht im Wind bewegen.");

  AddDetail( ({"wind"}),
	    "Du kannst ihn nur sehen, da sich die Blaetter ein wenig bewegen. "
            "Lauschen wuerde sicher mehr bringen.");
  
  AddDetail( ({"aeste","aesten"}),
	    "Die Aeste der Baeume sind weit oben. Du kannst sie nicht "
            "erreichen.");

  AddDetail( ({"umfang","staemme","stamm"}), 
            "Der Umfang der Staemme ist so riesig, dass mehrere Trolle sich "
            "die Haende reichen muessten um den Stamm zu umrunden.");

  AddDetail( ({"ulmen","erlen","kastanien","baumart","art"}),
	    "Eine Baumart, die hier im Wald waechst.");

  AddDetail( ({"troll","fee","trolle"}),
	    "Dies ist eine Rasse im Silberland.");

  AddDetail( ({"knie","haende","hand"}),
	    "Du hast sogar zwei davon.");
  
  AddDetail( ({"rasse"}),
	    "Es gibt verschiedene Rassen im Silberland.");

  AddDetail( ({"silberland"}), 
            "Du bist mitten im Silberland.");

  AddDetail( ({"voegel"}),
	    "Die Voegel sind weit oben in der Eiche. Du kannst sie nicht "
            "sehen, nur hoeren.");

  AddDetail( ({"erde","walderde"}),
	    "Die Erde ist sehr fruchtbare Walderde, in der sehr gut Baeume "
            "wachsen.");

  AddDetail( ({"steinchen"}),
	    "Kleine unscheinbare Steinchen liegen auf dem Waldboden.");
  
  AddDetail( ({"fenster"}),
	    "Die Fenster sind zerbrochen und sehr schmutzig.");

  AddDetail( ({"tuer"}),
	    "Die Tuer scheint sehr verrostet zu sein, wo man sich auch "
            "ganz leicht eine Blutvergiftung holen kann. Ob man sie noch "
            "oeffnen kann?");

  AddDetail( ({"zustand"}),
	    "Der Zustand der Tuer, oder besser gesagt der gesamten Huette "
            "ist miserabel.");

  AddDetail( ({"farbe"}),
	    "Es scheint einmal Weiss gewesen zu sein, jedoch ist sie fast "
            "ueberall abgeblaettert.");

  AddDetail( ({"weiss"}),
	    "Du bist Dir nicht sicher, aber es scheint wirklich Weiss "
            "gewesen zu sein.");

  AddDetail( ({"rassen","hilfe"}),
	    "Ruf die Hilfe auf, dann erfaehrst Du mehr ueber Rassen.");

  AddDetail( ({"blutvergiftung","vergiftung"}),
	    "Eine solche Vergiftung ist nicht gut. Man sollte darauf "
            "achten was man oeffnet und Hinweisen folgen.");

  AddDetail( ({"hinweise","hinweisen"}),
	    "Hinweise sind sehr wichtig und lebenserhaltend.");

  AddDetail( ({"jahreszeit","jahreszeiten"}),
	    "Es gibt vier Jahreszeiten.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst die Baeume und das Gras.");  
 
  AddSmell( ({"gras"}),
	   "Das Gras riecht nach Fruehling.");

  AddSmell( ({"baeume"}),
	   "Die Baeume riechen nach Wald.");

  AddSmell( ({"wald"}),
	   "In einem Wald kann man Baeume riechen.");

  AddSmell( ({"fruehling"}),
	   "Der Fruehling ist eine schoene Jahreszeit.");
  
  
  AddSound(DEFAULT_SOUND, "Du hoerst das Zwitschern der Voegel und den Wind, "
                          "der durch die Blaetter weht.");

  AddSound( ({"wind","blaetter"}),
	   "*raschel*raschel*raschel*");
  
  AddSound( ({"zwitschern","voegel"}),
	   "*zwitscher*");

//-----Details Ende-----
  
AddExit("sueden", ROOM "zenw3");
AddExit("nordwesten", ROOM "zenw5");

AddCmd( ({"oeffne" }), "oeffnen" );

}
int oeffnen(string str)
{
   if ( member( ({"tuer"})
,str) != -1) 
  {
    write(BS( "Du probierst die verklemmte Tuer zu oeffnen und schneidest Dich "
           "dabei an einem alten verrosteten Nagel. Sie geht nicht auf."));
    say( TPN+" verzieht das Gesicht vor Schmerz.\n");
    TP->AddHp(-15);
    this_player()->AddPoison(2);
    return 1;
  }
}

