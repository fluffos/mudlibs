// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle");
  SetProp( P_INT_LONG,
	"Die Hoehle geht weiter. An den Waenden haengen ein paar Fackeln, die "
        "diesen Teil der Hoehle erleuchten. Ausserdem sieht man ein paar Moose "
        "die sich am Boden und an den Waenden festgesetzt haben. Der Boden ist "
        "feucht und mit Steinbrocken uebersaeht." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"hoehle","teil"}), 
            "Du stehst in einem weiteren Teil der Hoehle. Er ist sehr gross und "
            "die Decke ist soweit ueber Dir, dass Du sie nicht mehr sehen "
            "kannst.");

  AddDetail( ({"waenden","waende","wand"}),
	    "An den Waenden haengen erleuchtete Fackeln in verrosteten "
            "Halterungen. Auch ein paar Moose sind an der Wand gewachsen.");

  AddDetail( ({"fackeln","fackel","schimmer"}),
	    "Die Fackeln haengen in alten verosteteten Halterungen und "
            "erleuchten die Hoehle in einem roetlichen Schimmer.");

  AddDetail( ({"moose","moos"}),
	    "An den Waenden und am Boden haben sich Moose abgesetzt. Sie sind "
            "nicht sehr interessant.");
  
  AddDetail( ({"boden"}),
	    "Am Boden erkennt man einige Steinbrocken und Moose.");

  AddDetail( ({"steinbrocken","brocken","steine"}), 
            "Grosse und kleine Steinbrocken liegen auf dem Boden. Sie sind "
            "sicher von der Decke abgebrochen. Hoffentlich passiert das nicht, "
            "solange Du hier drin bist.");

  AddDetail( ({"decke"}),
	    "Die Decke ist weit ueber Dir. Du kannst sie nicht erkennen.");

  AddDetail( ({"himmel"}),
	    "Den Himmel gibt es hier drinnen nicht.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen sind alt und verrostet.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Moos.");  
 
  AddSmell( ({"moosen","moos","moose"}),
	   "Das Moos ist feucht und stinkt ein wenig.");

  AddSound(DEFAULT_SOUND, "Du hoerst gar nichts.");

//-----Details Ende-----
  
AddExit("norden", ROOM "wasf4");
AddExit("westen", ROOM "wasf2");

}  
   
