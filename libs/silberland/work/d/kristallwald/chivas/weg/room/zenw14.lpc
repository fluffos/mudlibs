// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einer Steilwand");
  SetProp( P_INT_LONG,
	"Der Weg die Felswand hoch ist sehr steil und glitschig. Ueberall "
        "wachsen Algen, da ein leicher Nieselregen auf den Weg niederregnet, "
        "da er fast direkt am Wasserfall nach oben fuehrt. Du musst wirklich "
        "auf die scharfen Kanten und losen Felsbrocken aufpassen, sonst "
        "brichst Du Dir den Hals." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"weg"}), 
            "Der Weg ist sehr steil und scheint weiter hoch verschuettet zu "
            "sein. Du musst sehr aufpassen, da er sehr rutschig ist, da sich "
            "durch den steten Nieselregen des Wasserfalls Algen am Boden "
            "festgesetzt haben.");

  AddDetail( ({"felswand","wand"}),
	    "Du stehst ganz dicht an der Felswand, da der Weg nicht sehr "
            "breit ist. Einige Algen haben sich auch hier festgesetzt. Man "
            "sieht auch einige scharfe Kanten, an denen man sich sehr weh "
            "tun kann.");

  AddDetail( ({"algen"}),
	    "Die glitschigen gruenen Algen breiten sich ueber den gesamten "
            "Boden des Weges aus. Einige Algen haengen auch an der Felswand.");

  AddDetail( ({"nieselregen","regen"}),
	    "Ein leichter Nieselregen regnet auf Dich herab. Er kommt von dem "
            "Wasserfall, der direkt neben Dir in den See stuerzt.");
  
  AddDetail( ({"wasserfall"}),
	    "Der Wasserfall ergiesst sich direkt neben Dir in den See und "
            "verursacht einen leichten Nieselregen.");

  AddDetail( ({"kanten"}), 
            "Die scharfen Kanten, die von der Felswand abstehen sehen sehr "
            "gefaehrlich aus und Du kannst Dir sicher an ihnen weh tun.");

  AddDetail( ({"felsbrocken","brocken"}),
	    "Die grossen Felsbrocken stoeren Dich auf dem Weg voranzukommen. "
            "Weiter oben sind mehrere Felsbrocken herunter gestuerzt und "
            "scheinen den Weg zu versperren.");

  AddDetail( ({"hals"}),
	    "Du hast deinen Hals schon oft riskiert.");

  AddDetail( ({"boden","vorankommen"}),
	    "Der Boden ist nass und mit lauter glitschigen gruenen Algen und "
            "Felsbrocken bedeckt. Kein sehr angenehmes Vorankommen, wenn man "
            "weiter hoch will.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen blau und durch den Nieselregen kannst Du "
            "sogar einen Regenbogen sehen. Die Sonne ist von hier aus noch "
            "nicht zu sehen.");

  AddDetail( ({"sonne"}), 
            "Die Sonne ist von der Felswand verdeckt. Sei froh darueber, "
            "ansonsten koenntest Du ja nicht den huebschen Regenbogen "
            "erkennen, da ein Regenbogen immer nur von der Sonne weg sichtbar "
            "ist.");

  AddDetail( ({"regenbogen","farben"}), 
            "Der Regenbogen leuchtet in seinen verschiedenen Farben.");

  AddDetail( ({"see","entfernung"}),
	    "Der See liegt in schon einiger Entfernung unter Dir.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach nassen Algen.");  
 
  AddSmell( ({"algen"}),
	   "Die Algen stinken.");

  AddSound(DEFAULT_SOUND, "Das Rauschen des Wasserfalls uebertoent alles.");

  AddSound( ({"rauschen","wasserfall"}),
	   "Du hoerst nur das Rauschen, sonst nichts.");
  
//-----Details Ende-----
  
AddExit("suedunten", ROOM "zenw13");
AddExit("oben", ROOM "zenw15");

}
