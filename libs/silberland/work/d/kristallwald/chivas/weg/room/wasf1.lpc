// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Unter einem Wasserfall");
  SetProp( P_INT_LONG,
	"Du stehst im Eingang einer kleinen Hoehle direkt unter dem Wasserfall, "
        "dessen Wassermassen direkt vor Dir in den See stuerzen. Der Boden ist "
        "glitschig und mit Algen bedeckt. An der Felswand am Hoehleneingang "
        "kannst Du ein paar Zeichen erkennen. Anscheinend bist Du nicht der "
        "Erste, der hier her gekommen ist." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"eingang","hoehleneingang"}), 
            "Du stehst direkt vor dem Eingang zu einer Hoehle. An der Felswand "
            "neben dem Eingang sind ein paar Zeichen zu erkennen.");

  AddDetail( ({"hoehle","ende"}),
	    "Die Hoehle ist wohl ziemlich gross, da Du das Ende nicht "
            "sehen kannst. Weiter in der Hoehle scheint es erleuchtet zu "
            "sein, da Du ein Flackern zu sehen glaubst.");

  AddDetail( ({"wasserfall"}),
	    "Der Wasserfall stuerzt direkt neben Dir in den See. Du bist so "
            "nahe, dass Du die Wassermassen beruehren kannst.");

  AddDetail( ({"wassermassen","massen","wasser"}),
	    "Unendliche Wassermassen stuerzen direkt an Dir vorbei in den "
            "See.");
  
  AddDetail( ({"boden"}),
	    "Der Boden ist mit lauter glitschigen Algen bedeckt. Er ist "
            "sehr rutschig.");

  AddDetail( ({"algen"}), 
            "Die gruenen Algen bedecken fast den gesamten Boden und machen "
            "ihn ganz rutschig.");

  AddDetail( ({"zeichen"}),
	    "Es sind mystische Zeichen, die in sich strahlen. Eine Art Magie "
            "scheint auf ihnen zu liegen.");

  AddDetail( ({"erste"}),
	    "Die Zeichen sind sicher nicht natuerlich. Das heisst, Du warst "
            "nicht der Erste.");

  AddDetail( ({"himmel"}),
	    "Den Himmel kannst Du nicht sehen.");

  AddDetail( ({"decke"}),
	    "Du stehst erst am Eingang der Hoehle. Die Decke befindet sich in "
            "der Hoehle.");

  AddDetail( ({"riss"}),
	    "An dem Riss kannst Du sicher wieder zurueck nach Osten auf die "
            "Wiese klettern.");

  AddDetail( ({"wiese","osten"}),
	    "Im Osten neben dem Wasserfall ist eine Wiese zu sehen.");
  
  AddDetail( ({"felswand","wand","waende"}),
	    "Die Felswand unter dem Wasserfall ist feucht und an der Wand "
            "neben dem Hoehleneingang sind ein paar Zeichen zu erkennen. "
            "Ausserdem erkennst Du einen Riss, der nach Osten an der Wand "
            "entlang reicht.");

  AddDetail( ({"see"}), 
            "Der See ist unter Dir, Du kannst ihn nur durch die herab "
            "stuerzenden Wassermassen nicht sehen.");

  AddDetail( ({"flackern","sache","grund","augen"}),
	    "Du bist Dir nicht sicher, ob es an Flackern ist oder ob Dich nur "
            "Deine Augen getaeuscht haben. Um der Sache auf den Grund zu "
            "gehen, musst Du die Hoehle schon betreten.");

  AddDetail( ({"art","magie"}),
	    "Du kennst Dich zwar mit Magie aus, jedoch uebertrifft diese "
            "Magie bei weitem Dein Wissen. Vielleicht erfaehrst Du mehr in "
            "der Hoehle.");

  AddDetail( ({"wissen"}),
	    "Eigentlich weisst Du ja nicht viel.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht hier nach gar nichts.");  
 
  AddSound(DEFAULT_SOUND, "Das Rauschen uebertoent alle anderen Geraeusche.");

  AddSound( ({"rauschen","wasserfall"}),
	   "Mehr als das Rauschen des Wasserfalls ist nicht zu hoeren.");
  
  AddSound( ({"geraeusche"}),
	   "Du hoerst nur das Rauschen.");

//-----Details Ende-----
  
AddExit("norden", ROOM "wasf2");

AddCmd( ({"kletter", "klettere" }), "klettern" );

}
int klettern(string str)
{
   notify_fail("Wohin moechtest Du woran klettern?\n");
   if ( member( ({ "an rissen nach osten","an riss nach osten" }),str) != -1) 
  {
    write(BS ( "Du greifst in die tiefen Risse an der Felswand und kletterst "
               "an ihnen nach Osten unter den Wasserfall hervor und landest "
               "auf der Wiese an der Felswand.\n"));
      TP->move(ROOM "zenw11", M_GO, 
      "zurueck auf die Wiese", "klettert", 
      "klettert herein");
    return 1;
  }
}

