// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int fledermausda;

void create()
	
{
  ::create();

  fledermausda=1; 

  SetProp( P_INT_SHORT, "In einer Hoehle");
  SetProp( P_INT_LONG,
	"Die Fackeln leuchten auf einmal nicht mehr rot, sondern in einem "
        "magischen Gruen. Des weiteren befindet sich in Richtung Nordosten "
        "ein gemeisselter Durchgang, der mit verschiedenen Schriftzeichen und "
        "Runen umrundet ist." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"fackeln"}), 
            "Die Fackeln leuchten in diesem Teil der Hoehle in einer gruenen "
            "Farbe. Es scheint ein magisches Feuer zu sein.");

  AddDetail( ({"gruen","farbe","feuer","feuers","licht"}),
	    "Die gruene Farbe des magischen Feuers leuchtet sehr hell, so dass "
            "man sogar die weit oben liegende Decke sehen kann.");

  AddDetail( ({"richtung","nordosten"}),
	    "In Richtung Nordosten scheint es durch einen Durchgang in eine "
            "Kammer zu gehen.");

  AddDetail( ({"durchgang"}),
	    "Der Durchgang scheint in eine Kammer zu fuehren. Er ist mir "
            "verschiedenen Schriftzeichen und Runen gekennzeichnet.");
  
  AddDetail( ({"schriftzeichen"}),
	    "Die Schriftzeichen sind in einer Dir unbekannten alten Sprache "
            "geschrieben. Du kannst sie leider nicht lesen.");

  AddDetail( ({"runen"}), 
            "Die Runen glitzern im gruenen Licht der Fackeln. Sie sind Dir "
            "jedoch gaenzlich unbekannt.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit mehreren Steinen bedeckt. Ansonsten kannst Du "
            "nicht viel erkennen.");

  AddDetail( ({"waende","waenden","waende"}),
	    "An den Waenden haengen ein paar Halter fuer Fackeln. Ausserdem "
            "sind ein paar kleine Risse zu erkennen.");

  AddDetail( ({"decke"}),
	    "Hoch ueber Dir erkennst Du ein paar dunkle Flecke an der Decke.");
  
  AddDetail( ({"himmel"}),
	    "Den Himmel musst Du schon draussen suchen.");

  AddDetail( ({"sprache","sprachen"}), 
            "Es gibt viele alte Sprachen, die Du nicht kennst.");

  AddDetail( ({"steinen","steine"}),
	    "Die Steine sind von der Decke herunter gefallen. Sie sind nicht "
            "sehr interessant.");

  AddDetail( ({"halter"}),
	    "Es sind die ueblichen verrosteten Halter in denen die Fackeln "
            "stecken.");

  AddDetail( ({"risse"}),
	    "Die Risse sind sehr fein und scheinen schon sehr alt zu sein.");
  
  AddDetail( ({"flecke"}),
	    "Die Flecke scheinen sich zu bewegen. Es sind anscheined ein "
            "paar Fledermaeuse.");

  AddDetail( ({"fledermaeuse"}), 
            "Vielleicht kannst Du die Fledermaeuse wecken.");

  AddDetail( ({"kammer"}),
	    "Um in die Kammer zu kommen, musst Du nach Nordosten gehen.");

  AddDetail( ({"hoehle","teil"}),
	    "Das Ende der Hoehle scheint nahe zu sein.");

  AddDetail( ({"ende"}),
	    "Hoffentlich wird es nicht Dein Ende sein.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Tieren.");  
 
  AddSmell( ({"tiere","tieren"}),
	   "Du riechst sie, musst aber schon suchen, wo sie sind.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Rascheln.");

  AddSound( ({"rascheln"}),
	   "Das Rascheln scheint von der Decke zu kommen.");

//-----Details Ende-----
  
AddExit("norden", ROOM "wasf8");
AddExit("nordosten", ROOM "wasf10");

AddCmd( ({"weck", "wecke" }), "wecken" );

}
void reset()
{
  ::reset();
  fledermausda=1;
  
}
int wecken (string str)
{
  object fledermaus;
  notify_fail ("Wen moechtest Du wecken?\n");
   if ( member( ({ "fledermaus", "fledermaeuse" }),str) != -1) 
   {
//  if ( member( ({ "fledermaus","fledermaeuse" }),str) != -1) 

  if (present("CHIVASFLEDERMAUS",TO) || !fledermausda)

  {
    write(BS("Die Fledermaeuse ignorieren Dich und schlafen weiter."));
    return -1;
  }
  write(BS("Du gibst einen Schrei von Dir und weckst wirklich eine Fledermaus auf.\n"));
  fledermausda=0;
  fledermaus = clone_object ( "/d/kristallwald/chivas/zentauren/npc/fledermaus.lpc" );
  fledermaus->move(TO,M_GO|M_NOCHECK,"fliegt von der Decke und landet vor Dir auf dem Boden.");
  return 1;
}}

