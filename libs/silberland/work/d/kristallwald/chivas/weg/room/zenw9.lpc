// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Ein waldiger Waldweg");
  SetProp( P_INT_LONG,
	"Der Wald scheint im Nordwesten auf einer Lichtung mit einem See zu "
        "enden. Die Anzahl der Baeume nimmt schon ab und das Blaetterdach "
        "wird lichter. An der linken Seite des Weges fliesst der kleine Fluss, "
        "den Du vorhin ueberquert hast." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"wald"}), 
            "Der Wald scheint im Nordwesten auf einer Lichtung zu enden. Die "
            "Baeume um Dich herum nehmen ab und das Blaetterdach wird ein "
            "wenig lichter.");

  AddDetail( ({"nordwesten","lichtung"}),
	    "Im Nordwesten scheint eine Lichtung mit einem See zu sein.");

  AddDetail( ({"see"}),
	    "Der See im Nordwesten glaenzt in der Sonne.");

  AddDetail( ({"baeume"}),
	    "Die Anzahl der grossen Baeume nimmt weiter ab. Im Nordwesten "
            "stehen gar keine Baeume mehr, da dort eine Lichtung zu sein "
            "scheint.");
  
  AddDetail( ({"weg","weges","suedosten"}),
	    "Der Weg fuehrt Dich entweder nach Nordwesten oder nach Suedosten "
            "weiter. Der Weg ist von ein paar Baeumen und Bueschen "
            "an der rechten Seite gesaeumt. An der linken Seite fliesst ein "
            "kleiner Fluss.");

  AddDetail( ({"blaetterdach","anzahl"}), 
            "Das Blaetterdach ist sehr licht, da die Anzahl der Baeume bereits "
            "abnimmt. Du kannst recht gut den Himmel sehen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist strahlend blau und die Sonne scheint.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen ein paar Blaetter und Zweige, die von den Baeumen "
            "herunter gefallen sind. Auch ein paar kleine Steine sind zu "
            "erkennen.");

  AddDetail( ({"fluss","flusses"}),
	    "Der Fluss schlaengelt sich an der linken Seite des Weges entlang. "
            "Du kannst ihn leider nicht sehen, da er momentan hinter vielen "
            "Pflanzen versteckt ist.");
  
  AddDetail( ({"sonne"}),
	    "Die Sonne steht am Himmel und glaenzt im See, der im Nordwesten "
            "liegt.");

  AddDetail( ({"bueschen","buesche"}), 
            "Kleine unscheinbare Buesche stehen auf der rechten Seite des "
            "Weges.");

  AddDetail( ({"steine"}),
	    "Kleine uninteressante Steine liegen auf dem Weg.");

  AddDetail( ({"blaetter"}),
	    "Einige Blaetter sind von den Baeumen abgefallen und liegen nun "
            "auf dem Weg, wo sie verrotten werden.");

  AddDetail( ({"zweige"}),
	    "Kleine Zweige sind von den Baeumen abgebrochen und auf dem Weg "
            "gelandet.");
  
  AddDetail( ({"seite"}),
	    "An der linken Seite des Weges schlaengelt sich der Fluss entlang "
            "und an der rechten Seite stehen Buesche und Baeume.");

  AddDetail( ({"pflanzen"}), 
            "Es sind verschiedene Pflanzen, die an einem Fluss wachsen. "
            "Hauptsaechlich ist es aber Schilf, was hier waechst.");

  AddDetail( ({"schilf"}),
	    "Das Schilf waechst hier sehr hoch.");

  AddDetail( ({"blumen","namen"}),
	    "Zwischen dem Schilf siehst Du auch ein paar Blumen, deren "
            "Namen Du nicht kennst.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst ein paar Blumen.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen duften herrlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Fluss plaetschern und ein lautes "
                          "Rauschen.");

  AddSound( ({"fluss","plaetschern"}),
	   "Das Plaetschern des Flusses wirkt beruhigend.");
  
  AddSound( ({"rauschen","quelle"}),
	   "Das laute Rauschen kommt aus dem Nordwesten. Die Quelle des "
           "Rauschen kannst Du von hier aus nicht erkennen.");

//-----Details Ende-----
AddItem( "/d/ebene/lamuerte/wwald/npc/wildschwein", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "zenw9",
          P_MNPC_AREA:({ROOM "zenw9","zenw8","zenw7"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("suedosten", ROOM "zenw7");
AddExit("nordwesten", ROOM "zenw10");

}  
   
