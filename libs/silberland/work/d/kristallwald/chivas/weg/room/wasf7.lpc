// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle");
  SetProp( P_INT_LONG,
	"Die Fackeln an den Waenden brennen in einem roetlichen Schimmer. Man "
        "kann in diesem Teil der Hoehle das erste Mal die Decke erkennen. Der "
        "Boden ist steinig und die Waende sind mit Moos und ein paar Flechten "
        "bewachsen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"fackeln"}), 
            "Die Fackeln erhellen die Hoehle ein wenig. Sie haengen in "
            "eisernen Halterungen an den Waenden.");

  AddDetail( ({"waenden","waende"}),
	    "An den Waenden haengen verrostete Halterungen. Ausserdem "
            "waechst ein wenig Moos und ein paar Flechten im roten Schimmer "
            "der Fackeln an den Waenden.");

  AddDetail( ({"schimmer","lichtschein"}),
	    "Der rote Schimmer der Fackeln erhellt ein wenig die Hoehle.");

  AddDetail( ({"teil","hoehle"}),
	    "Du bist schon sehr tief in der Hoehle.");
  
  AddDetail( ({"decke"}),
	    "Die Decke ist hier das erste Mal zu sehen. Du erkennst einige "
            "Risse und ein paar Stellen, wo anscheinend grosse Brocken "
            "abgebrochen sind.");

  AddDetail( ({"boden"}), 
            "Auf dem Boden liegen groessere und kleinere Steine.");

  AddDetail( ({"steine","jahrhunderten","jahrhundert","jahrhunderte"}),
	    "Die Steine stammen anscheinend von der Decke. Sie sind teilweise "
            "schon vor Jahrhunderten abgebrochen und auf dem Boden gelandet.");

  AddDetail( ({"moos"}),
	    "Das Moos sieht ein wenig krank und gelblich aus.");

  AddDetail( ({"flechten","eindruck"}),
	    "Auch die Flechten machen keinen gesunden Eindruck. Es ist ja auch "
            "kein Wunder, da die Flechten nur den Lichtschein der Fackeln "
            "haben.");
  
  AddDetail( ({"himmel"}),
	    "Den Himmel kannst Du in der Hoehle nicht sehen.");

  AddDetail( ({"halterungen"}), 
            "Die eisernen Halterungen der Fackeln haben ein wenig Rost "
            "angesetzt.");

  AddDetail( ({"rost"}),
	    "Der Rost der Halterungen ist nicht sehr interessant. Er ist auch "
            "nicht wertvoll. Er ist eigentlich ueberhaupt nicht "
            "erwaehnenswert.");

  AddDetail( ({"stellen","brocken"}),
	    "An den Stellen sind wohl die Brocken abgebrochen, die nun als "
            "Steine auf dem Boden liegen.");

  AddDetail( ({"risse"}),
	    "Die Risse sehen nicht gerade beruhigend aus.");
  
  AddDetail( ({"wunder"}),
	    "Wunder gibt es immer wieder.");

  AddDetail( ({"mal"}), 
            "Es gibt immer ein erstes Mal.");

  AddDetail( ({"fuessen","fuesse"}),
	    "Du hast auch welche.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es ist ein wenig stickig.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst das Knirschen der Steine unter Deinen "
                          "Fuessen.");

  AddSound( ({"knirschen"}),
	   "*knirsch*");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "wasf8");
AddExit("osten", ROOM "wasf6");

}  
   
