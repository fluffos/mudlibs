// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Wegkreuzung");
  SetProp( P_INT_LONG,
	"Du stehst an einer Wegkreuzung mitten im Wald. Am Wegrand neben ein "
        "paar Straeuchern steht ein kleines Schild, was Dir sicher den Weg "
        "weisen kann. Im Sueden erkennst Du eine kleine Bruecke, die den Fluss "
        "ueberquert, der von Nordwesten her in Richtung Suedosten fliesst." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"wegkreuzung","kreuzung"}), 
            "Du stehst mitten auf der Wegkreuzung. Du musst Dich entscheiden.");

  AddDetail( ({"wald"}),
	    "Der Wald ist rings um Dich herum.");

  AddDetail( ({"wald"}),
	    "Die Sonne waermt Dich ein wenig und Du fuehlst Dich gut.");

  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand siehst Du verschiedene Straeucher. Direkt zwischen "
            "den Straeuchern steht ein altes Holzschild. Ausserdem siehst Du "
            "einen alten verwitterten Baumstumpf am Rand neben der Bruecke.");

  AddDetail( ({"straeucher","straeuchern","verlassen"}),
	    "Verschiede grosse Straeucher stehen am Rand des Weges. Ein "
            "Verlassen des Weges ist nicht moeglich. Zwischen ihnen steht "
            "ein altes Holzschild.");
  
  AddDetail( ({"schild","holzschild"}),
	    "Das alte Holzschild steht hier schon sehr lange. Du kannst es "
            "lesen.");

  AddDetail( ({"weg","weges","stelle"}), 
            "Der Weg gabelt sich an dieser Stelle.");

  AddDetail( ({"sueden","bruecke"}),
	    "Im Sueden ist eine alte Bruecke, die den Fluss ueberquert.");

  AddDetail( ({"fluss","nordwesten","richtung","suedosten"}),
	    "Ein kleiner Fluss fliesst von Nordwesten nach Suedosten. Im "
            "Sueden kann man ihn ueber eine alte Bruecke ueberqueren.");

  AddDetail( ({"baumstumpf"}),
	    "Den Baumstumpf hast Du auch schon von der Bruecke aus gesehen. "
            "Aus dem Holz des Baumes wurden die Balken der Bruecke gemacht. "
            "Der Baumstumpf selber ist mit verschiedenen Graesern fast "
            "zugewachsen.");
  
  AddDetail( ({"bruecke","sueden"}),
	    "Die Bruecke ist im Sueden.");

  AddDetail( ({"balken"}), 
            "Die Balken bilden eine Bruecke.");

  AddDetail( ({"holz","ueberfluss"}),
	    "Holz gibt es in einem Wald im Ueberfluss.");

  AddDetail( ({"baum","baumes","baeume","baeumen"}),
	    "Baeume gibt es auch in einem Wald.");

  AddDetail( ({"graesern","graeser"}),
	    "Die Graeser haben den Baumstumpf fast komplett bedeckt. Auch "
            "einige Moose sind zu erkennen.");
  
  AddDetail( ({"moos","moose","farbe"}),
	    "Das Moos hat eine gruene Farbe und ist unglaublich "
            "uninteressant.");

  AddDetail( ({"boden"}), 
            "Am Boden liegen ein paar Zweige und Steinchen.");

  AddDetail( ({"himmel","sonne"}),
	    "Der blaue Himmel ist zu sehen und die Sonne scheint.");

  AddDetail( ({"zweige"}),
	    "Die Zweige sind von den Baeumen abgefallen.");

  AddDetail( ({"steinchen","steine"}),
	    "Die Steinchen sind sehr uninteressant.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst nicht viel, ausser die ueblichen "
                          "Gerueche in einem Wald.");  
 
  AddSmell( ({"gerueche","wald"}),
	   "Es riecht sehr waldig.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Fluss im Sueden.");

  AddSound( ({"fluss"}),
	   "Du hoerst das Wasser ueber die Steine plaetschern.");
  
  AddSound( ({"wasser","plaetschern"}),
	   "*plaetscher*");

  AddReadDetail( ({"schild","holzschild"}),
		" \n"
                " +--------------------------------------+\n"
                " | Wasserfall      unbekanntes Gebiet   |\n"
                " |      <---------+--------->           |\n"
                " |                |                     |\n"
                " |                |                     |\n"
                " |            Roch Adan                 |\n"
                " +--------------------------------------+\n");


//-----Details Ende-----
  
AddExit("sueden", ROOM "zenw6");
AddExit("nordwesten", ROOM "zenw9");
AddExit("nordosten", ROOM "zenw8");

}  
   
