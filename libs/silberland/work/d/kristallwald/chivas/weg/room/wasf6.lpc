// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle");
  SetProp( P_INT_LONG,
	"Die Fackeln in den eisernen Fackelhalterungen sind erloschen. Die "
        "Person, die die anderen Fackeln angezuendet hat, muss hier die "
        "erloschenden Fackeln ersetzen. Neben den erloeschten Fackeln erkennt "
        "man ein paar Schriftzeichen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 0 );
  
//-----Details Anfang-----
  
  AddDetail( ({"fackeln"}), 
            "Die Fackeln in diesem Teil der Hoehle sind erloschen. Sie muessen "
            "von Jemandem ersetzt werden. Sicher wird das die Person tun, die "
            "auch die anderen Fackeln immer wieder anzuendet.");

  AddDetail( ({"fackelhalterungen","halterungen","fackelhalterung","halterung"}),
	    "Die eisernen Halterungen sind alt und verrostet. Ein paar "
            "Verzierungen kann man aber noch an ihnen erkennen.");

  AddDetail( ({"person","jemanden","jemandem","wer"}),
	    "Du weisst nicht, wer diese Person ist.");

  AddDetail( ({"schriftzeichen","schrift","zeichen"}),
	    "Die Schriftzeichen an den Waenden sind nur sehr blass, aber Du "
            "kannst sie lesen.");
  
  AddDetail( ({"himmel"}),
	    "Um den Himmel zu sehen, musst Du schon die Hoehle verlassen.");

  AddDetail( ({"decke"}), 
            "Die Decke ist weit ueber Dir und Du kannst sie nicht sehen.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen einige Steine herum, die anscheinend von der "
            "Decke gefallen sind.");

  AddDetail( ({"waenden","waende","wand"}),
	    "Die Waende sind unscheinbar, bis auf die verblassenden "
            "Schriftzeichen.");

  AddDetail( ({"verzierungen"}),
	    "Die verrosteten Verzierungen stellen einen Stab und verschiedene "
            "grosse Risse dar, von denen eine gewisse Macht auszugehen "
            "scheint. Jedenfalls sehen sie so aus.");

  AddDetail( ({"macht","gaensehaut"}),
	    "Die ausgehende Macht verpasst Dir eine Gaensehaut und Du weisst "
            "nicht einmal warum.");
  
  AddDetail( ({"hoehle","teil"}),
	    "Dieser Teil der Hoehle ist sehr dunkel, da die Fackeln erloschen "
            "sind.");

  AddDetail( ({"risse"}), 
            "Die Risse scheinen von einer Aura der Macht umgeben zu "
            "sein, die durch den Stab gebrochen wird.");

  AddDetail( ({"stab"}),
	    "Der abgebildete Stab scheint einen gewissen Zauber zu beinhalten.");

  AddDetail( ({"zauber"}),
	    "Den Zauber selbst kannst Du nicht erkennen, da die Verzierungen "
            "schon sehr alt sind und nur noch wenig zu erkennen ist.");

  AddDetail( ({"steine"}),
	    "Kleine und groessere Steine liegen auf dem Boden. Sie sind nicht "
            "sehr interessant.");
  
  AddDetail( ({"wasser","tropfen"}),
	    "Die Tropfen die von der Decke fallen bilden kleine Pfuetzen.");

  AddDetail( ({"pfuetzen"}), 
            "Kleine Pfuetzen sind am Boden zu sehen. Sie sind genau so "
            "uninteressant wie die Steine.");

  AddDetail( ({"aura"}),
	    "Die Aura kannst Du nur erahnen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach absolut gar nichts.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst ein leises Tropfen.");

  AddSound( ({"tropfen"}),
	   "Das Tropfen stammt von ein wenig Wasser, dass von der Decke auf "
           "den Boden platscht.");
  
  AddSound( ({"wasser"}),
	   "plitsch, platsch, plitsch, platsch");

  AddReadDetail( ({"schriftzeichen"}),
		"Die Zeit der Steine des Chaos wird wiederkommen.");


//-----Details Ende-----
  
AddExit("westen", ROOM "wasf7");
AddExit("osten", ROOM "wasf5");

}  
   
