// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle");
  SetProp( P_INT_LONG,
	"Die Hoehle ist riesig. Die Decke ist wieder im Dunkeln verschwunden. "
        "Sie ist wieder irgendwo hoch ueber Dir. An einer Wand sind ein paar "
        "Runen in die Wand gemeisselt. Sie leuchten ein wenig im Schein der "
        "Fackeln." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"hoehle"}), 
            "Du bist in einer Hoehle. Es ist unglaublich.");

  AddDetail( ({"decke"}),
	    "Die Decke kannst Du momentan nicht erkennen.");

  AddDetail( ({"dunkeln","dunkel"}),
	    "Im Dunkeln ueber Dir ist irgendwo die Decke.");

  AddDetail( ({"wand","waende","waenden"}),
	    "An den Waenden haengen die Fackeln in ihren Halterungen und Du "
            "erkennst ein paar Runen an der Wand.");
  
  AddDetail( ({"runen"}),
	    "Die Runen scheinen aus Mithril zu bestehen und von ihnen scheinen "            "magische Kraefte auszugehen.");

  AddDetail( ({"schein","leuchten"}), 
            "Der Schein der Fackeln erhellen die Hoehle ein wenig und bringt "
            "die in die Wand gemeisselten Runen ein wenig zum Leuchten.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln erhellen die Hoehle ein wenig, so dass Du etwas "
            "sehen kannst.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen der Fackeln sind alt und rostig.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen ein paar kleine Steine.");
  
  AddDetail( ({"himmel"}),
	    "Um den Himmel zu sehen, musst Du die Hoehle verlassen.");

  AddDetail( ({"steine"}), 
            "An den Steinen ist nichts zu erkennen.");

  AddDetail( ({"mithril"}),
	    "Mithril ist sehr wertvoll.");

  AddDetail( ({"kraefte"}),
	    "Du spuerst die magischen Kraefte der Runen, obwohl Du die "
            "Bedeutung der Runen nicht verstehst.");

  AddDetail( ({"bedeutung"}),
	    "Dafuer bist Du nicht intelligent genug.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig nach Schweiss.");  
 
  AddSmell( ({"schweiss"}),
	   "Du merkst, dass Du es selbst bist, der nach Schweiss stinkt.");

  AddSound(DEFAULT_SOUND, "Es ist totenstill, bis auf das Flackern der Fackeln.");

  AddSound( ({"flackern","fackeln"}),
	   "*flacker*flacker*");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "wasf9");
AddExit("norden", ROOM "wasf7");

}  
   
