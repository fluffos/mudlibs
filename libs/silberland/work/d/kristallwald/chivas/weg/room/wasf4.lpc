// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle");
  SetProp( P_INT_LONG,
	"Die Hoehle fuehrt immer tiefer in den Berg hinein. Nur ein paar "
        "Fackeln an den Waenden erhellen Deinen Weg. Die Luft ist feucht und "
        "ein wenig kalt. Am Boden liegen ein paar alte Knochen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"hoehle"}), 
            "In der Hoehle ist es kalt und feucht. Du kannst Deinen eigenen "
            "Atem sehen.");

  AddDetail( ({"berg","art"}),
	    "Du bist in einer Art Berg.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln erhellen die Hoehle ein wenig.");

  AddDetail( ({"waenden","waende","wand"}),
	    "Am den Waenden haengen Halterungen fuer die Fackeln. Ansonsten "
            "siehst Du nur die kahle Wand, an der nur ein paar Risse zu "
            "erkennen sind.");
  
  AddDetail( ({"weg"}),
	    "Der Weg fuehrt weiter in die Hoehle herein oder wieder zurueck "
            "zum Wasserfall.");

  AddDetail( ({"luft"}), 
            "Die Luft ist feucht und kalt. Brrrr.");

  AddDetail( ({"boden"}),
	    "Der Boden ist feucht. Ein paar Moose und Steinbrocken sind zu "
            "sehen. Ausserdem liegen ein paar Knochen herum.");

  AddDetail( ({"knochen"}),
	    "Die Knochen sehen ein wenig angenagt aus. Anscheinend gibt es "
            "hier ein paar Ratten. Du bist sehr angeekelt.");

  AddDetail( ({"decke"}),
	    "Die Decke ist weit ueber Dir. Du kannst sie nicht sehen.");
  
  AddDetail( ({"himmel"}),
	    "Verlass die Hoehle, dann kannst Du auch einen Himmel sehen.");

  AddDetail( ({"atem","ausatmen"}), 
            "Du siehst Deinen Atem beim Ausatmen.");

  AddDetail( ({"risse"}),
	    "Ein paar Risse sind klein, ein paar andere sind gross. Es sieht "
            "so aus, als ob die Hoehle nicht sehr stabil ist.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen sind alt und verrostet. Die Fackeln in den "
            "Halterungen brennen.");

  AddDetail( ({"wasserfall","eingang"}),
	    "Der Wasserfall ist am Eingang der Hoehle.");
  
  AddDetail( ({"moose","moos"}),
	    "Das Moos ist feucht, gruen und sehr uninteressant.");

  AddDetail( ({"steinbrocken","brocken"}), 
            "Ein paar Brocken sind anscheinend von der Decke abgebrochen und "
            "hier auf dem Boden aufgeschlagen.");

  AddDetail( ({"ratten"}),
	    "Du kannst momentan keine erkennen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig. Du kannst den Geruch jedoch "
                          "nicht genau identifizieren.");  
 
  AddSmell( ({"geruch"}),
	   "Der Geruch kommt anscheinend von den alten Knochen. Wie ekelig.");

  AddSmell( ({"knochen"}),
	   "Die Knochen stinken.");
  
  
  AddSound(DEFAULT_SOUND, "Du hoerst nichts.");

//-----Details Ende-----
  
AddExit("norden", ROOM "wasf5");
AddExit("sueden", ROOM "wasf3");

}  
   
