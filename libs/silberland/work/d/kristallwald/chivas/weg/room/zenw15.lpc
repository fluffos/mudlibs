// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Felswand");
  SetProp( P_INT_LONG,
	"Die Felswand geht weiter steil hinauf. Es ist ueberall sehr "
        "rutschig, da der Nieselregen des Wasserfalls auf den schmalen Pfad "
        "niederregnet. Der Boden ist mit ein wenig Geroell bedeckt und und die "
        "scharfen Kanten der Felswand sehen auch gefaehrlich aus." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"felswand","wand"}), 
            "Die Felswand ist steil und fuehrt weiter nach oben. Scharfe "
            "Kanten stehen ein wenig hervor, an denen man sich schneiden "
            "kann.");

  AddDetail( ({"nieselregen","regen"}),
	    "Der Nieselregen des Wasserfalls macht alles feucht und glitschig. "
            "Du musst sehr aufpassen, dass Du nicht ausrutscht.");

  AddDetail( ({"wasserfalls","wasserfall"}),
	    "Der Wasserfall rauscht an Dir vorbei in die Tiefe.");

  AddDetail( ({"pfad"}),
	    "Der Pfad ist schmal und gefaehrlich. Ein falscher Tritt und "
            "Du stuerzt in die Tiefe.");
  
  AddDetail( ({"boden"}),
	    "Der Boden ist mit Geroell bedeckt und sehr rutschig.");

  AddDetail( ({"geroell"}), 
            "Das Geroell am Boden ist lose und sehr rutschig.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ueber Dir ist klar. Durch den Nieselregen kannst Du "
            "sogar einen Regenbogen sehen. Die Sonne muss oberhalb der "
            "Felswand sein, da Du sie nicht sehen kannst.");

  AddDetail( ({"sonne"}), 
            "Du kannst die Sonne zwar noch nicht sehen, aber Du spuerst sie "
            "schon ein wenig staerker.");

  AddDetail( ({"tiefe"}),
	    "Du bist schon sehr hoch geklettert.");

  AddDetail( ({"regenbogen","regenbogens"}),
	    "Der Regenbogen strahlt in herrlichen Farben.");
  
  AddDetail( ({"farben"}),
	    "Es sind halt alle Farben eines Regenbogens zu sehen.");

  AddDetail( ({"kanten"}), 
            "Die Kanten sind sehr scharf. Du solltest aufpassen, dass Du "
            "Dich nicht schneidest. Da kann man ganz schnell eine "
            "Blutvergiftung bekommen.");

  AddDetail( ({"blutvergiftung","vergiftung","sache"}),
	    "Eine Blutvergiftung ist keine angenehme Sache.");

  AddDetail( ({"tritt"}),
	    "Der falsche Tritt und Du stuerzt ab.");

  AddDetail( ({"nase"}),
	    "Du hast eine und zwar eine besonders grosse.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Wasser.");  
 
  AddSmell( ({"wasser"}),
	   "So riecht es, wenn man von dem Nieselregen staendig Wasser in der "
           "Nase hat.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Rauschen des Wasserfalls.");

  AddSound( ({"rauschen","wasserfall"}),
	   "Das Rauschen uebertoent einfach alles.");

  
//-----Details Ende-----

AddExit("unten", ROOM "zenw14");
AddExit("oben", "/d/kristallwald/chivas/hochebene/room/hochst");

}
int go_oben(string dir)
{

  if(!(present("garlog", TO)))
  {
    write( BS( "Du rutscht auf dem Geroell aus und kommst nicht weiter nach "
               "oben. Anscheinend geht es hier momentan noch nicht weiter.") );
    say("Das rutschige Geroell laesst "+TP->Name(WEN)+" momentan "
      "nicht weiter nach oben gehen.\n");
    return -1;
  }
}
