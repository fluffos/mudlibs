// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Ein waldiger Waldweg");
  SetProp( P_INT_LONG,
	"Die Baeume stehen hier nicht mehr so dicht, wie weiter im Sueden. Ein "
        "paar Sonnenstrahlen werfen goldene Punkte auf den Waldweg. Viele "
        "Straeucher stehen am Wegrand und machen es unmoeglich den Weg zu "
        "verlassen. Im Norden ist eine Bruecke, ueber die man einen kleinen "
        "Fluss ueberqueren kann." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"baeume","baeumen"}), 
            "Es ist ein wenig freier als weiter im Sueden. Die Baeume "
            "stehen nicht mehr so dicht.");

  AddDetail( ({"sueden"}),
	    "Im Sueden liegt irgend wo ausser Sicht Roch Adan.");

  AddDetail( ({"sonnenstrahlen","strahlen"}),
	    "Die Sonnenstrahlen dringen durch das lichtere Blaetterdach.");

  AddDetail( ({"punkte"}),
	    "Kleine goldene Punkte sind auf dem Waldweg zu sehen. Sie "
            "entstehen durch die Sonnenstrahlen, die durch die Blaetter bis "
            "auf den Boden kommen.");

  AddDetail( ({"wald"}),
	    "Es ist kaum zu glauben, aber Du befindest Dich in einem Wald.");
  
  AddDetail( ({"waldweg","weg"}),
	    "Der Weg schlaengelt sich weiter durch den Wald nach Norden auf "
            "eine Bruecke zu.");

  AddDetail( ({"straeucher"}), 
            "Verschiedene Straeucher stehen am Wegrand.");

  AddDetail( ({"wegrand","rand","abweichen"}),
	    "Der Weg ist durch die Straeucher eingegrenzt. Ein Abweichen vom "
            "Weg ist dadurch nicht moeglich.");

  AddDetail( ({"norden"}),
	    "Im Norden befindet sich eine Bruecke, die ueber einen Fluss "
            "fuehrt.");

  AddDetail( ({"bruecke"}),
	    "Die Bruecke besteht aus dicken Eichenbohlen und scheint sehr alt "
            "zu sein.");
  
  AddDetail( ({"fluss"}),
	    "Der Fluss fliesst im Norden unter einer Bruecke durch.");

  AddDetail( ({"sicht"}), 
            "Du siehst Roch Adan natuerlich nicht.");

  AddDetail( ({"roch adan","roch","adan","zentauren","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach ist sehr licht, da die Baeume nicht mehr so "
            "dicht beieinander stehen.");

  AddDetail( ({"blaetter"}),
	    "Viele Blaetter haengen an den Baeumen.");
  
  AddDetail( ({"boden"}),
	    "Der Boden ist mit ganz normaler Erde bedeckt. Ein paar kleine "
            "Steine und Zweige sind auch zu erkennen.");

  AddDetail( ({"steine","kieselsteine"}), 
            "Es sind ganz normale Kieselsteine und an ihnen ist nichts "
            "besonderes zu erkennen.");

  AddDetail( ({"zweige"}),
	    "Die Zweige sind sicher von den Baeumen abgefallen.");

  AddDetail( ({"erde"}),
	    "Die Erde ist nicht sehr interessant.");

  AddDetail( ({"eichenbohlen","bohlen"}),
	    "Um die Balken naeher zu betrachten, musst Du schon naeher ran "
            "gehen.");
  
  AddDetail( ({"balken"}),
	    "Grosse Balken bilden die Bruecke im Norden, die ueber den Fluss "
            "fuehrt.");

  AddDetail( ({"sonne"}),
	    "Die Sonne steht am Himmel und waermt angenehm.");

  AddDetail( ({"himmel"}), 
            "Der Himmel ist gut zu erkennen, da die Baeume nicht mehr so "
            "dicht stehen. Die Sonne scheint.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Wald.");  
 
  AddSmell( ({"wald"}),
	   "Es riecht nach Baeumen und Straeuchern.");

  AddSmell( ({"baeume","straeucher"}),
	   "Die Baeume und Straeucher riechen nach Wald.");
  
  
  AddSound(DEFAULT_SOUND, "Du hoerst den Wind durch die Wipfel wehen.");

  AddSound( ({"wind","wipfel"}),
	   "Die Aeste aechzen ein wenig durch den Wind.");
  
  AddSound( ({"aeste"}),
	   "*aechz*");

//-----Details Ende-----

AddItem( "/d/ebene/Silberwald/npc/biber", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "zenw5",
          P_MNPC_AREA:({ROOM "zenw5","zenw6","zenw4"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("suedosten", ROOM "zenw4");
AddExit("norden", ROOM "zenw6");

}  
   
