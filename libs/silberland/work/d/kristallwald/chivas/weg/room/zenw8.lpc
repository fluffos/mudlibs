// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Waldweg");
  SetProp( P_INT_LONG,
	"Der Waldweg fuehrt nach Nordosten. Die Baeume und Buesche am Wegrand "
        "machen es unmoeglich den Weg zu verlassen. Die Sonne steht fast "
        "senkrecht am Himmel, doch wegen des dichten Blaetterdaches kannst Du "
        "sie nur erahnen.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"waldweg","weg","boden","waldboden","weges"}), 
            "Auf dem Waldweg sind einige Blaetter, Zweige und Steine zu "
            "zu sehen.");

  AddDetail( ({"nordosten"}),
	    "Im Nordosten fuehrt der Weg weiter.");

  AddDetail( ({"baeume"}),
	    "Die grossen Baeume ragen weit nach oben und ihr Blaetterdach "
            "verbirgt den Himmel.");

  AddDetail( ({"buesche"}),
	    "Die dichten Buesche und die breiten Staemme der Baeume verhindern, "
            "dass Du den Weg verlassen kannst. Ein Durchkommen ist unmoeglich.");
  
  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand sind einige breite und dichte Buesche zu sehen. "
            "Ausserdem siehst Du ein paar Graeser und kleine Blumen am Rand "
            "wachsen.");
 
  AddDetail( ({"himmel"}), 
            "Der Himmel ist durch das dichte Blaetterdach kaum zu sehen.");

  AddDetail( ({"sonne"}),
	    "Die Sonne steht sicher senkrecht am Himmel. Leider kannst Du "
            "sie von hier momentan nicht erkennen, da das Blaetterdach zu "
            "dicht ist.");

  AddDetail( ({"blaetterdaches","blaetterdach","dach"}),
	    "Das dichte Blaetterdach hindert die Sonne daran bis auf den "
            "Waldboden zu scheinen.");

  AddDetail( ({"durchkommen","verlassen"}),
	    "Ein Durchkommen und das Verlassen des Weges ist unmoeglich.");
  
  AddDetail( ({"staemme"}),
	    "Die Staemme sind sehr dick. Die Baeume muessen ein paar hundert "
            "Jahre alt sein.");

  AddDetail( ({"graeser","namen"}), 
            "Es sind unterschiedliche Graeser. Du kennst ihren Namen nicht.");

  AddDetail( ({"blumen"}),
	    "Es sind hauptsaechliche kleine Waldveilchen.");

  AddDetail( ({"jahre"}),
	    "Die Baeume sind sehr alt.");

  AddDetail( ({"waldveilchen","veilchen","blau"}),
	    "Die Veilchen bluehen in einem schoenen Blau. Sie sind "
            "viel zu schade zum pfluecken.");
  
  AddDetail( ({"steine","stein"}),
	    "Es sind ganz kleine normale Kieselsteine. Es ist nichts "
            "besonderes an ihnen zu erkennen.");

  AddDetail( ({"zweige","zweig"}), 
            "Die Zweige sind von den Baeumen herunter gefallen und auf dem "
            "Weg gefallen.");

  AddDetail( ({"blaetter"}),
	    "Einige Blaetter sind auf den Boden gefallen. Sie stammen sicher "
            "aus dem dichten Blaetterdach.");

  AddDetail( ({"kieselsteine","kieselstein"}),
	    "Die Kieselsteine liegen auf dem Weg und sind absolut wertlos.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst ein paar Veilchen am Wegrand.");  
 
  AddSmell( ({"veilchen"}),
	   "Die Veilchen duften suess.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Rascheln der Blaetter am Boden.");

  AddSound( ({"rascheln"}),
	   "Das Rascheln kommt durch Dich, wenn Du ueber die Blaetter gehst.");
  
//-----Details Ende-----
  
AddExit("suedwesten", ROOM "zenw7");
AddSpecialExit( "nordosten", "go_norden" );

}

int go_norden(string dir)
{
  if(!(present("marlog", TO)))
    {
      write( BS( "Ein ungutes Gefuehl haelt Dich zurueck. Du traust Dich "
		 "nicht weiter.") );
      say("Ein ungutes Gefuehl haelt "+TP->Name(WEN)+" davon ab, "
	  "nach Nordosten zu gehen.\n");
      return -1;
    }
}
