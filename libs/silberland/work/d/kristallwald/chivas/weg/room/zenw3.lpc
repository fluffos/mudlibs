// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Waldweg");
  SetProp( P_INT_LONG,
	"Ueberall sind grosse Baeume zu sehen, die den Waldweg saeumen. "
        "Verschiedene kleine Buesche und Straeucher sind zwischen den "
        "Baeumen zu sehen. Obwohl nicht viel Licht den Waldboden trifft, "
        "gedeihen sie recht gut." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"baeume","baeumen"}), 
            "Die Baeume saeumen den Waldweg. Zwischen ihren grossen und dicken "
            "Staemmen stehen kleine Buesche und Straeucher.");

  AddDetail( ({"waldweg","weg"}),
	    "Der Weg fuehrt weiter nach Norden in den Wald hinein.");

  AddDetail( ({"wald"}),
	    "Du bist schon tief im Wald.");

  AddDetail( ({"buesche"}),
	    "Es sind verschiedene Arten von Bueschen zu sehen. Du kennst sie "
            "leider nicht.");
  
  AddDetail( ({"straeucher"}),
	    "Du siehst einige Haselnussstraeucher.");
  
  AddDetail( ({"licht"}), 
            "Das Licht kommt nur selten durch das dichte Blaetterdach durch.");

  AddDetail( ({"waldboden","boden"}),
	    "Am Waldboden sind ein paar Steine, Blaetter und Zweige zu sehen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist durch das dichte Blaetterdach verdeckt. Du kannst "
            "ihn nicht sehen.");

  AddDetail( ({"staemme","staemmen"}),
	    "Die Staemme der grossen Baeume sind riesig. An einem Stamm faellt "
            "Dir was auf.");
  
  AddDetail( ({"stamm"}),
	    "Du hast Dich geirrt, aber schoen, dass Du forschst. ;-)");

  AddDetail( ({"arten","art","bibliothek"}), 
            "Du beschliesst in die Bibliothek zu gehen um nachzuschlagen, was "
            "es fuer Buesche sind.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach verdeckt den ganzen Himmel. Nur ab und zu "
            "erreicht ein Lichtstrahl den Waldboden.");

  AddDetail( ({"blaetter"}),
	    "Einige Blaetter sind aus dem dichten Blaetterdach auf dem "
            "Waldboden herunter gefallen.");

  AddDetail( ({"zweige"}),
	    "Die Zweige stammen sicher von den Baeumen.");
  
  AddDetail( ({"steine"}),
	    "Die Steine sind unglaublich uninteressant.");

  AddDetail( ({"haselnussstraeucher"}), 
            "Die Haselnussstraeucher haben leider keine Nuesse mehr. "
            "Anscheinend war ein verfressener Troll oder Oger kurz vor Dir "
            "da.");

  AddDetail( ({"lichtstrahl"}),
	    "Der Lichtstrahl, der ab und zu den Waldboden trifft springt "
            "hin und her und scheint Etwas zu schreiben.");

  AddDetail( ({"etwas"}),
	    "Du konzentrierst Dich auf den springenden Lichtstrahl und "
            "entzifferst einen imaginaeren Schriftzug.");

  AddDetail( ({"schriftzug"}),
	    "Du kannst ihn einigermassen lesen, obwohl er natuerlich "
            "nicht richtig sichtbar ist.");
  
  AddDetail( ({"troll","oger","rasse"}),
	    "Eine Rasse im Silberland.");

  AddDetail( ({"silberland"}), 
            "Du bist mittendrin.");

  AddDetail( ({"nuesse","nuss","haselnuss","haselnuesse"}),
	    "Es sind leider keine Haselnuesse vorhanden.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Wald.");  
 
  AddSmell( ({"wald"}),
	   "Es riecht halt ein wenig waeldisch, anders kann man es nicht "
           "beschreiben.");
  
  AddSound(DEFAULT_SOUND, "Du hoerst das Rascheln der Blaetter.");

  AddSound( ({"rascheln","blaetter"}),
	   "Das Rascheln kommt von Dir, da einige Blaetter am Boden liegen, "
           "ueber die Du gehst.");
  
  AddReadDetail( ({"schriftzug"}),
		"Dies ist ein Forscherpunkt. Gratuliere.");


//-----Details Ende-----
  
AddExit("sueden", ROOM "zenw2");
AddExit("norden", ROOM "zenw4");

}  
   
