// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Am Nordtor von Roch Adan");
  SetProp( P_INT_LONG,
	"Dies ist das Nordtor von Roch Adan. Es ist nicht so gross, wie das "
        "Haupttor weit im Sueden. Man erkennt von dieser Seite des Tores auch "
        "die Mauer, die um die ganze Stadt fuehrt. Sie ist jedoch sehr stark "
        "zugewachsen. Zu beiden Seiten stehen die Baeume des Waldes, der "
        "Roch Adan umgibt, sehr dicht. Ein Weg fuehrt weiter nach Norden. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"nordtor","tor","tores"}), 
            "Dies ist das Nordtor von Roch Adan. Es gibt noch das Haupttor im "
            "Sueden und ein weiteres Tor im Osten der Stadt.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren.");

  AddDetail( ({"haupttor","sueden"}),
	    "Das Haupttor ist weit im Sueden.");

  AddDetail( ({"seite","mauer"}),
	    "Die Mauer ist an vielen Stellen mit Efeu zugewachsen. Die "
            "Baumstaemme, die die Mauer bilden kann man kaum noch erkennen.");
  
  AddDetail( ({"seiten","baeume"}),
	    "Zu beiden Seiten wachsen grosse Baeume.");

  AddDetail( ({"wald","waldes"}), 
            "Du stehst mitten in einem Wald.");

  AddDetail( ({"weg","norden","richtung"}),
	    "Der Weg fuehrt durch den Wald weiter nach Norden oder in die "
            "entgegen gesetzte Richtung in die Stadt.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit Gras und kleinen Steinen bedeckt. Hinter dem "
            "Tor geht der Weg in eine Strasse ueber, die mit Pflastersteinen "
            "ausgelegt ist.");

  AddDetail( ({"strasse","plastersteinen","pflastersteine"}),
	    "Die Strasse hinter dem Tor fuehrt in die Stadt und ist mit "
            "Pflastersteinen ausgelegt.");
  
  AddDetail( ({"gras"}),
	    "Das Gras bedeckt fast den ganzen Boden. Es ist ein wenig "
            "nieder getrampelt von den Abenteurern, die diesen Weg schon "
            "genommen haben.");

  AddDetail( ({"steinen","steine"}), 
            "Kleine, ganz gewoehnliche Steine sind auf dem Weg zu sehen. "
            "Es ist nichts besonderes.");

  AddDetail( ({"abenteurern","abenteurer"}),
	    "Abenteurer wie Du einer bist.");

  AddDetail( ({"zentauren","volk"}),
	    "Die Zentauren sind ein maechtiges und stolzes Volk.");

  AddDetail( ({"osten"}),
	    "Im Osten von Roch Adan soll auch ein Tor sein.");
  
  AddDetail( ({"baumstaemme","staemme","eindruck","umfang"}),
	    "Die Baumstaemme der Mauer haben einen grossen Umfang und machen "
            "einen sehr stabilen Eindruck.");

  AddDetail( ({"efeu","stellen"}), 
            "Das Efeu ist an vielen Stellen an der Mauer, die die Stadt "
            "umrundet, hochgewachsen.");

  AddDetail( ({"blaetter"}),
	    "Der Wind bewegt die Blaetter. Lausche doch mal.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist ein wenig vom Blaetterdach der Baeume verdeckt. "
            "Trotzdem kannst Du ein paar Wolken und die Sonne sehen.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach ist nicht sehr dicht. Du kannst den Himmel ohne "
            "Probleme sehen.");
  
  AddDetail( ({"probleme"}),
	    "Du hast doch keine Probleme, ausser dass Du zuviel forschst.");

  AddDetail( ({"wolken","regen"}), 
            "Die Wolken sind weiss. Es sieht nicht nach Regen aus.");

  AddDetail( ({"sonne"}),
	    "Die Sonne scheint und waermt Dein Gesicht.");

  AddDetail( ({"gesicht"}),
	    "Du hast schon einmal besser ausgesehen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst den frischen Wald.");  
 
  AddSmell( ({"wald"}),
	   "Der Wald riecht nach Baeumen und Harz.");

  AddSmell( ({"baeume","baeumen","harz"}),
	   "Halt wie Harz und Baeume riechen. Beweg Dich mal nach draussen "
           "und schnupper selbst mal in einem Wald.");
  
  
  AddSound(DEFAULT_SOUND, "Du hoerst das Rauschen des Windes und das Gezwitscher " 
                          "von Voegeln. Ausserdem hoert man noch ganz leise "
                          "das Treiben in der Stadt.");

  AddSound( ({"voegel","voegeln","gezwitscher","tschip","triller"}),
	   "*** Tschip * Tschip * Triller * Triller ***");
  
  AddSound( ({"rauschen","wind","windes","blaetter","blaettern"}),
	   "Das Rauschen des Windes in den Blaettern wirkt sehr beruhigend.");

  AddSound( ({"treiben","stadt","stadtlaerm","laerm","geraeusche"}),
	   "Man hoert die ueblichen Geraeusche und den normalen Stadtlaerm. "
           "Sie sind jedoch ganz leise und kaum noch zu hoeren.");

//-----Details Ende-----
  
AddExit("sueden","/d/kristallwald/chivas/zentauren/room/zentor2");
AddExit("norden", ROOM "zenw2");

}  
   
