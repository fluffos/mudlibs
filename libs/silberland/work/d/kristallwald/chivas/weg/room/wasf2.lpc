// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle");
  SetProp( P_INT_LONG,
	"Die Hoehle scheint noch groesser zu sein als man von draussen sehen "
        "konnte. Die Waende sind natuerlich erstanden, jedoch wurden Halter "
        "fuer Fackeln an den Waenden angebracht. Am Boden liegen kleinere "
        "Felsbrocken, die Dich jedoch nicht am Weiterkommen hindern." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"weiterkommen"}), 
            "Die Felsbrocken behindern Dich nicht.");
  
  AddDetail( ({"hoehle"}), 
            "Du bist in der Hoehle.");

  AddDetail( ({"waende","waenden"}),
	    "Die Waende sehen natuerlich aus. Es wurden jedoch Halter fuer "
            "Fackeln an den Waenden angebracht.");

  AddDetail( ({"halter"}),
	    "Die alten Halter sind schmucklos und bestehen aus Eisen. "
            "Sie sind mit viel Rost ueberzogen.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln sind angezuendet und eine rote Flamme erleuchtet die "
            "Hoehle.");
  
  AddDetail( ({"boden"}),
	    "Am Boden liegen einige Felsbrocken, die anscheinend von der Decke "
            "abgebrochen sind und auf den Boden gefallen sind. Der Boden ist "
            "auch nass und kleine Pfuetzen bilden sich. Kleine Tropfen fallen "
            "regelmaessig von der Decke.");

  AddDetail( ({"felsbrocken","brocken"}), 
            "Einige der Felsbrocken sind recht gross. Du bist froh, dass Dir "
            "bis jetzt keiner auf den Kopf gefallen ist.");

  AddDetail( ({"decke"}),
	    "Die Decke ist weit ueber Dir. Du kannst sie kaum erkennen. Ab und "
            "zu faellt auch ein Wassertropfen von der Decke auf den Boden.");

  AddDetail( ({"himmel"}),
	    "Den gibt es hier natuerlich nicht.");

  AddDetail( ({"eisen"}),
	    "Das Eisen der Halter ist kaum noch zu sehen. Sie bestehen "
            "eigentlich nur noch aus Rost.");

  AddDetail( ({"kopf"}),
	    "Selbst Du hast einen.");

  AddDetail( ({"rost"}),
	    "Der Rost ueberzieht die gesamten Halter.");
  
  AddDetail( ({"flamme","flammen"}),
	    "Die roten Flammen erhellen die grosse Hoehle ein wenig.");

  AddDetail( ({"pfuetzen"}), 
            "Es sind kleine Pfuetzen am Boden, die durch die Tropfen "
            "entstanden sind, die von der Decke fallen.");

  AddDetail( ({"wassertropfen","tropfen"}),
	    "Du kannst sie nicht sehen, aber hoeren.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach gar nichts.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst das Rauschen vom Wasserfall und ein "
                          "anderes leises Geraeusch.");

  AddSound( ({"rauschen","wasserfall"}),
	   "Der Wasserfall ist auch in der Hoehle noch sehr gut zu hoeren.");
  
  AddSound( ({"wassertropfen","tropfen","geraeusch","plitsch","platsch"}),
	   "Du hoerst wie einige Wassertropfen auf den Boden fallen. Es hoert "
           "sich wie Plitsch und Platsch an.");

//-----Details Ende-----
  
AddExit("osten", ROOM "wasf3");
AddExit("sueden", ROOM "wasf1");

}  
   
