// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl=1;

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Waldsee");
  SetProp( P_INT_LONG,
	"Die Wiese auf der Du stehst wird von den Baeumen des Waldes und dem "
        "Ufer des Sees beschraenkt. Einige Blumen wachsen zwischen den "
        "Graesern und verleihen der Umgebung einen friedlichen Eindruck. "
        "Im Westen befindet sich zwischen den Baeumen eine kleine gemuetliche "
        "Blockhuette." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wiese"}), 
            "Die Wiese auf der Du stehst, ist begrenzt vom See und von "
            "den Baeumen des Waldes im Sueden.");

  AddDetail( ({"baeumen","baeume"}),
	    "Die Baeume sind im Sueden. Auf der Lichtung stehen keine Baeume.");

  AddDetail( ({"wald","waldes","sueden"}),
	    "Der Wald ist hinter Dir im Sueden.");

  AddDetail( ({"see","sees"}),
	    "Der See ist genau vor Dir. Kleine Wellen, die durch den "
            "Wasserfall entstehen, schwappen ans Ufer.");
  
  AddDetail( ({"blumen"}),
	    "Ein paar kleine Blumen stehen auf der Wiese. Sie sind nicht sehr "
            "interessant.");

  AddDetail( ({"graesern","graeser"}), 
            "Die Graeser sind noch uninteressanter als die Blumen.");

  AddDetail( ({"fluss","osten"}),
	    "Der Fluss im Osten fliest suedoestlich in den Wald. Man kann "
            "ihn leicht ueber ein paar Steine ueberqueren.");

  AddDetail( ({"boden"}),
	    "Am Boden sind ein paar Graeser und Blumen zu sehen.");

  AddDetail( ({"himmel","woelkchen"}),
	    "Der Himmel ist schoen blau. Kein Woelkchen ist zu sehen.");

  AddDetail( ({"sonne"}),
	    "Die Sonne am blauen Himmel waermt Dich.");
  
  AddDetail( ({"wellen"}),
	    "Ein paar Wellen, die durch den Wasserfall verursacht werden, "
            "schwappen sanft ans Ufer.");

  AddDetail( ({"wasserfall","blickfang"}), 
            "Der grosse Wasserfall ist der Blickfang des Sees.");

  AddDetail( ({"ufer"}),
	    "Am Ufer steht ein bisschen Schilf.");

  AddDetail( ({"steine"}),
	    "Man kann einfach ueber die Steine den Fluss ueberqueren.");

  AddDetail( ({"schilf"}),
	    "Das Schilf waechst sehr gut am See.");

  AddDetail( ({"lichtung"}),
	    "Die Lichtung umgibt den halben See. Auf der anderen Seite ist die "
            "riesige Felswand, von der der Wasserfall in den See stuerzt.");

  AddDetail( ({"eindruck"}),
	    "Der erste Eindruck ist der wichtigste.");

  AddDetail( ({"felswand","wand","seite","meter"}),
	    "Die Felswand ist mehr als hundert Meter hoch und sehr "
            "beeindruckend.");

  AddDetail( ({"umgebung"}),
	    "Die Umgebung gefaellt Dir hier.");

  AddDetail( ({"westen","blockhuette","huette"}),
	    "Im Westen ist eine kleine Blockhuette zwischen den Baeumen zu "
            "sehen. Wer da wohl wohnt?");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach ein paar Blumen.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen duften herrlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst das laute Rauschen des Wasserfalls.");

  AddSound( ({"wasserfall","rauschen"}),
	   "*rausch*rausch*rausch*");

//-----Details Ende-----
  
AddExit("nordosten", ROOM "zenw10");
AddExit("nordwesten", ROOM "zenw13");

AddCmd( ({"lass","lasse" }), "lassen" );

}
void reset()
	
{
  ::reset();
  anzahl=1; 
}

int lassen(string str)
{
 object krake;
 notify_fail("Was willst Du wo springen lassen?\n");

 if(!str || str == "") return 0;
 if(!(str == "stein ueber oberflaeche springen" ||
      str == "stein ueber wasseroberflaeche springen" ||
      str == "stein ueber wasser springen" ||
      str == "kieselstein ueber oberflaeche springen" ||
      str == "kieselstein ueber wasseroberflaeche springen" ||
      str == "kieselstein ueber wasser springen" )) return 0;
 

 if( str == "stein ueber oberflaeche springen" ||
      str == "stein ueber wasseroberflaeche springen" ||
      str == "stein ueber wasser springen" ||
      str == "kieselstein ueber oberflaeche springen" ||
      str == "kieselstein ueber wasseroberflaeche springen" ||
      str == "kieselstein ueber wasser springen"){
    
  if(!present("kieselstein", TP)){
	  
  write(BS("Du hast ja gar keinen Kieselstein, wie willst Du es dann anfangen ?\n"));
 
  say(TPN+" denkt nach.\n");
  return -1;
  }

  if(anzahl < 1)

  {
	  
  write(BS("Einmal an dieser Stelle reicht. Wenn man es oefter macht, verliert "
           "man schnell den Spass daran.\n"));
 
  say(TPN+" hat doch keine Lust einen Stein ueber die Oberflaeche springen "
          "zu lassen.\n");
  return 1;
  }
  else
  {
  write(BS("Du nimmst den Kieselstein, den Du schon hast, visierst die "
           "Oberflaeche des Sees an und wirfst ihn, Er beruehrt zweimal die "
           "Oberflaeche und haelt ploetzlich im Flug an.\n"
	   "Ein grosser Krakenarm haelt den Stein auf und wirft ihn "
           "auf Dich zurueck und trifft Dich direkt am Kopf.\n"));
 
  say(TPN+" wirft einen Stein, der fast sofort zurueck kommt und genau "
          "den Kopf des Werfenden trifft. Ein wirklich guter Wurf.\n");
  if (present("kieselstein",TP))
  present("kieselstein",TP)->remove();
  TP->AddHp(-20);
  krake=clone_object (NPC "krake" );
  krake->move(TO,M_GO|M_NOCHECK,"krakelt aus dem See");
  anzahl--;
  return 1;
 }
 }
}


