// Objekt  
// von Chivas

inherit "std/food";    

#include <food.h>      
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Forelle");
  SetProp(P_LONG,
    "Eine schoene blaue Forelle zappelt in Deinen Haenden. Sie sieht auch sehr "
    "lecker aus und Du kriegst grossen Hunger auf rohen Fisch.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Forelle");
  SetProp(P_GENDER, FEMALE);
  AddId(({"forelle", "fisch"}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 20); 
  SetProp(P_NOSELL, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_FOOD:100]));
  SetProp(P_INFO,
      "Die Forelle sieht sehr lecker aus!\n");
  SetProp(P_SMELL,
      "Riecht nach .. Fisch.");

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 10, 0 }),
         F_SOAK    : 4,         
         F_DRINK   : 0,       
         F_ALCOHOL : 0,         
         F_POISON  : 0,
	 F_SHOW_RAW: 1,
         F_MSG     : "Du isst die Forelle.",
         F_MSG_ROOM: "schlingt eine rohe Forelle herunter!",
	 F_MSG_DECAY: "Die Forelle scheint schlecht geworden zu sein...",
         F_VERB    : "essen"   
      ]) );                   
  
  start_decay(43200, -1); // haelt 12 stunden, danach giftig
}


