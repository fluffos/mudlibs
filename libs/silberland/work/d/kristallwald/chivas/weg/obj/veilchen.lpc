#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein schoenes Veilchen");
  SetProp(P_LONG,
    "Ein kleines blaues Veilchen. Es ist eine schoene Blume. "
    "Du kannst sie jemanden geben, den Du magst.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Veilchen");
  SetProp(P_GENDER, NEUTER);
  AddId("veilchen");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_PLANT: 100]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_SIZE, 150);
  SetProp(P_VALUE, 100);
}
