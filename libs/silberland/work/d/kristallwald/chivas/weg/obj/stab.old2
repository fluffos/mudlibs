#include "../def.h"

inherit "std/thing";

object spieler_obj,prev_env;
mapping rooms_to_visit;

void create()
{
  mapping rooms;
  int i;
  string *rr;
  string r;

  if (!is_clone(TO)) return;
  ::create();

  rooms_to_visit=([
    "/d/unterwelt/nekromanten/room/yaq_monoq/h2":"Nekromanteninsel",
    "/d/ebene/zordan/ogerhoehle/room/room_e5":"Ogerhoehle",
    "/gilden/paladine/room/burg_c2":"Sturmfels",
    "/d/gebirge/speedy/trollager/room/t3":"Trolllager",
      ]);
  rooms=([
    "/d/kristallwald/chivas/zentauren/room/zen26":"Roch Adan",
    "/d/ebene/ronja/feenquest/room/sgang14":"Feenschloss",
    "/d/dschungel/feyaria/felseninsel/room/strand1":"Felseninsel",
    "/d/dschungel/feyaria/tijara/room/weg_a5":"Tijara",
    "/d/kristallwald/sargola/dorf/room/1_0716":"Elessar",
    "/d/huegelland/raballion/hobbits/room/westweg2":"Derlim",
    "/d/ebene/lamuerte/burg/weg/15x9y":"Kyranda",
    "/d/kristallwald/delgo/avir/room/e1-e2-platz":"Avir",
    "/d/dschungel/feyaria/dorf/room/dorf-008":"Dschungelelfendorf",
    "/d/gebirge/iwo/arwenock/room/room_D-04":"Arwenock",
    "/d/gebirge/dusty/zwerge/room/gang04":"Felonia",
    "/d/unterwelt/zordan/dhrkion/room/weg-e7":"Dhrkion",
    "/d/wasser/woody/fischerdorf/room/hauptplatz":"Fischerdorf",
    "/d/unterwelt/clementine/polaris/room/room8":"Polaris",
    "/d/polar/thor/xandim/room/hstrasse2":"Yiqanuc",
    "/d/wueste/arthoas/erg/room/aragh/raum43":"Erg",
    "/d/wueste/protheg/arrakeen/room/ara_0_1_0":"Arrakeen",
    "/d/ebene/Silberwald/room/room_c06":"Silberwald",
    "/d/polar/lamuerte/dorf/rooms/festland_2":"Smoersky",
    "/d/wueste/gwenshara/echsendorf/room/ges_4":"Echsendorf",
    "/d/dschungel/dante/weg/room/weg14":"Dschungel",
    "/d/dschungel/feyaria/sumpf/room/sumpf9":"Sumpf",
    "/d/ebene/creative/feldlager/room/zelte/a6_b1":"Feldlager",
    "/d/ebene/Midas/room/room_d7":"Midas"
  ]);

  rr = m_indices(rooms);
  for (i = 0; i <= 11; i++)
  {
    r = rr[random(sizeof(rr))];
    rooms_to_visit[r] = rooms[r];
    rr -= ({r});
  }
//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein magischer Stab");
  SetProp(P_LONG,
    "Der magische Stab von Aranor hilft Dir die Risse zwischen den Dimensionen "
    "zu finden und diese zu schliessen. Er besteht aus einem "
    "Dir unbekannten Material und ist mit Schriftzeichen und Runen "
    "verziert. Mit 'stabh' bekommst Du eine kleine Hilfe.");

//--Namen------------------------------------------------------------------

  SetProp(P_INFO,
    "Betrete einen Raum in den Orten auf der Liste und der Stab wird Dir durch "
    "ein Leuchten zu erkennen geben, dass ein Riss vorhanden ist.");
  SetProp(P_NAME, "Stab");
  SetProp(P_GENDER, MALE);
  AddId(({"stab", "CHIVASSTAB"}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_MISC: 100]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 550);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

  AddCmd( ({"stabh" }), "stabh" );
  AddCmd( ({"stabl" }), "stabl" );
}

void init()
{
  ::init();

  if(interactive(environment()))
  {
    environment()->AddPursuer(this_object());
    spieler_obj=environment();
  }
  else
  {
    if(objectp(spieler_obj))
    {
      spieler_obj->RemovePursuer(this_object());
      spieler_obj=0;
    }
  }
}

int PreventFollow(object dest)
{
  if(member(rooms_to_visit,file_name(dest)))
  {
    if(rooms_to_visit[file_name(dest)])
    {
      AddCmd("verschliesse","riss_schliesse_fun");
      dest->AddDetail(({"riss"}),"Ein Riss zwischen den Dimensionen.");
      prev_env=dest;
      write(BS("Der magische Stab leuchtet kurz auf und zeigt Dir damit an "
               "dieser Stelle einen Riss zwischen den Dimensionen.\n"));
    }
  }
  else
  {
    RemoveCmd("verschliesse");
    if(objectp(prev_env))
    {
      prev_env->RemoveDetail(({"riss"}));
    }
  }
  return 1;
}

int riss_schliesse_fun(string text)
{
  object daemon;
  
  rooms_to_visit = m_delete(rooms_to_visit, file_name(environment(this_player())));
  
  prev_env->RemoveDetail(({"riss"}));
  RemoveCmd("verschliesse");
  write(BS( "Du verschliesst mit dem magischen Stab den Riss "
            "zwischen den Dimensionen.\n"));
  say( TPN+" verschliesst mit einem magischen Stab einen Riss "
       "zwischen den Dimensionen.\n");
  write("Der Riss schliesst sich.\n");
  daemon=clone_object (NPC "daemon" );
  daemon->move(environment(this_player()),M_GO|M_NOCHECK,"erscheint aus einem Riss zwischen "
	       "den Dimensionen, bevor sich der Riss schliesst.");
  daemon->Kill(TP);
  TP->AddPursuer(daemon);

  if (sizeof(rooms_to_visit) == 0)
    {
      write(BS( "Aranor teilt Dir mit: Hervorragend. Das Silberland ist sehr stolz "
		"auf Dich, komm zu mir wenn Du den letzten Daemon getoetet hast "
		"und gib mir den Stab zurueck."));
    }
  
  return 1;
}

int stabh(string str)
{
  write( "Folgende Befehle kannst Du mit dem magischen Stab "
	 "ausfuehren:\n"
	 "stabh - Hilfe der Befehle des magischen Stabs.\n"
	 "stabl - Liste der Orte wo Risse auftauchen\n"
	 "verschliesse - Befehl um die Risse mit dem Stab zu "
	 "schliessen.\n"
	 "\n"
	 "Wenn Du den letzten Riss geschlossen hast, geh zu Aranor und \n"
	 "gib ihm den Stab zurueck. Er wird Dich dafuer reichlich belohnen.\n");
  return 1;
}
int x;

int room_print(string path, string desc)
{ 
  printf("%2d. %-23s", x, desc);
  if (x%2 == 0) write("\n");
  x++;
}

int stabl(string str)
{ 
  x = 1;
  write( "Auf der Liste sind die groben Orte aufgeschrieben, an denen die "
	 "Risse zwischen den Dimensionen entstehen. Wenn Du einen Raum mit "
         "einem Riss betrittst, wird der Stab kurz aufleuchten und Dir damit "
         "zeigen, dass ein Riss vorhanden ist:\n"
	 "\n");
  walk_mapping(rooms_to_visit, "room_print");
  write("\n");
  return 1;
}

int quest_fertig()
{
  return sizeof(rooms_to_visit) == 0;
}
