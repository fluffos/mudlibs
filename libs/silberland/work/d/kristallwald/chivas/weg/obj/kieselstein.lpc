#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein flacher Kieselstein");
  SetProp(P_LONG,
    "Der Kieselstein ist schoen flach. Man kann ihn sicher an "
    "irgendeiner Stelle an einem Gewaesser schoen ueber die Wasseroberflaeche "
    "springen lassen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "kieselstein");
  SetProp(P_GENDER, MALE);
  AddId("kieselstein");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_STONE: 100]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE, 150);
  SetProp(P_VALUE, 1);
}
