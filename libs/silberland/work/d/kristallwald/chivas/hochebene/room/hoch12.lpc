// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Zu beiden Seiten des Weges erheben sich nun die beiden groessten "
        "Huegelgraeber der Hochebene. Es muessen maechtige Krieger oder "
        "Koenige gewesen sein, die hier begraben wurden. Das Huegelgrab im "
        "Osten wurde anscheinend gepluendert, da ein grosses Loch in dem "
        "Grab ist, so dass Du es ohne Muehe betreten kannst, wenn Du "
        "neugierig bist." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"seiten","huegelgraeber","graeber","huegel","huegelgraebern"}), 
            "Die beiden groessten Huegelgraeber der Hochebene sind zu "
            "beiden Seiten zu sehen. Sie sind mit viel Gras und kleinen "
            "weissen Blumen bewachsen.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Du bist auf der Hochebene von Gorthad.");

  AddDetail( ({"weges","weg"}),
	    "Du stehst auf dem Weg, der sich durch die Huegelgraeber ueber "
            "der Hochebene schlaegelt.");

  AddDetail( ({"krieger"}),
	    "Grosse Krieger wurden hier bestattet.");
  
  AddDetail( ({"koenige","koenigs"}),
	    "In diesen grossen Huegelgraebern wurden sicher die Koenige "
            "bestattet.");

  AddDetail( ({"huegelgrab","grab","osten"}), 
            "Im oestlichen Huegelgrab ist ein grosses Loch, durch das man es "
            "betreten kann.");

  AddDetail( ({"loch"}),
	    "Das Loch wurde direkt in den Huegel gegraben. Sicher haben "
            "Grabraeuber die letzte Ruhestaette des Koenigs geschaendet und "
            "ausgeraubt.");

  AddDetail( ({"muehe"}),
	    "Du wirst keine Muehe haben das Grab durch das Loch zu betreten.");

  AddDetail( ({"boden"}),
	    "Der Boden besteht aus grossen Pflastersteinen.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist strahlend blau und die Sonne waermt Dich.");

  AddDetail( ({"sonne"}), 
            "Die Sonne steht beinahe senkrecht am Himmel.");

  AddDetail( ({"pflastersteinen","pflastersteine","steinen","steine"}),
	    "Die Pflastersteine sind zu einem Weg zusammen gelegt. In den "
            "Fugen zwischen den Steinen waechst ein wenig Gras.");

  AddDetail( ({"fugen"}),
	    "Die Fugen sind nur klein, aber ein wenig Gras hat einen Weg "
            "gefunden sich dazwischen zu quetschen.");

  AddDetail( ({"gras"}),
	    "Das Gras waechst auf den Huegelgraebern und ein bisschen auch auf "
            "dem Weg.");
  
  AddDetail( ({"blumen"}),
	    "Die weissen Blumen, die auf allen Huegelgraebern wachsen.");

  AddDetail( ({"ruhestaette"}), 
            "Direkt neben dem grossen Loch siehst Du eine Steintafel.");

  AddDetail( ({"grabraeuber"}),
	    "Momentan siehst Du keinen.");

  AddDetail( ({"steintafel"}),
	    "Du kannst sie lesen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach den Blumen auf den Huegelgraebern."); 
 
  AddSmell( ({"blumen"}),
	   "Die Blumen duften suesslich.");

  AddSound(DEFAULT_SOUND, "Es ist totenstill.");

  AddReadDetail( ({"steintafel","tafel"}),
		"+--------------------------------------+\n"
                "|                                      |\n"
                "|    Groftar, Koenig der noerdlichen   |\n"
                "|             Ebenen                   |\n"
                "|                                      |\n"
                "+--------------------------------------+");

//-----Details Ende-----
  
AddExit("nordosten", ROOM "hoch13");
AddExit("suedosten", ROOM "hoch11");
AddExit("osten", ROOM "hg1-1");

}  
   
