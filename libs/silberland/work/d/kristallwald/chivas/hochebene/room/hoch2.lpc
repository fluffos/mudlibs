// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Du stehst am See von Gorthad. Ein stiller ruhiger See, wie er zu "
        "der sonstigen Umgebung hier gut passt. Nur einige kleine Wellen "
        "plaetschern leise ans Ufer. Ein wenig Schilf und ein paar Seerosen "
        "sind zu sehen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"see","sees","oberflaeche"}), 
            "Der See ist eigentlich ruhig, obwohl ein wenig Stroemung "
            "vorhanden ist, wodurch ein paar kleine Wellen zu sehen sind. "
            "Einige Seerosen schwimmen auf der Oberflaeche in einem ruhigen "
            "Seitenteil des Sees.");

  AddDetail( ({"seitenteil"}),
	    "Durch den Wasserfall, der von der Hochebene stuerzt ist eine "
            "gewisse Stroemung vorhanden, so dass sich die Seerosen nur in "
            "einem ruhigen Seitenteil des Sees ausgebreitet haben.");

  AddDetail( ({"stroemung"}),
	    "Die Stroemung ist nicht sehr stark, aber vorhanden.");

  AddDetail( ({"gorthad"}),
	    "Du bist auf der Hochebene von Gorthad, deswegen heisst der See "
            "auch See von Gorthad.");

  AddDetail( ({"umgebung"}),
	    "Die Umgebung wirkt sehr ruhig und friedlich. Die weite "
            "Graslandschaft traegt ihren Teil dazu bei.");

  AddDetail( ({"wellen"}),
	    "Die Wellen plaetschern sanft ans Ufer des Sees.");
  
  AddDetail( ({"ufer"}),
	    "Am Ufer des Sees steht Schilf im Wasser des Sees.");

  AddDetail( ({"schilf"}), 
            "Das Schilf waechst sehr hoch am Ufer des Sees.");

  AddDetail( ({"seerosen"}),
	    "Die Seerosen bluehen und schwimmen auf der Oberflaeche des Wassers.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen blau. Die Sonne steht beinahe senkrecht "
            "ueber Dir.");

  AddDetail( ({"sonne"}),
	    "Die Sonne ist eine grosse gluehende Gaskugel.");

  AddDetail( ({"gaskugel"}),
	    "Du kannst leider nichts mit der grossen Gaskugel am Himmel "
            "anfangen.");

  AddDetail( ({"boden","weg","weges"}),
	    "Der Weg auf dem Du stehst ist mit Steinen gepflastert.");
  
  AddDetail( ({"hochebene"}),
	    "Du befindest Dich auf einer Hochebene.");

  AddDetail( ({"graslandschaft","teil"}), 
            "Das Gras bewegt sich leicht im Wind.");

  AddDetail( ({"gras"}),
	    "Das Gras ist nicht sehr hoch und bewegt sich leicht im Wind.");

  AddDetail( ({"wind","brise"}),
	    "Eine leichte Brise weht ueber die Hochebene.");

  AddDetail( ({"steinen","steine","untergrund"}),
	    "Die Steine des Weges bilden einen festen und guten Untergrund.");
  
  AddDetail( ({"wasser","wassers"}),
	    "Im See ist ganz viel Wasser.");

  AddDetail( ({"sueden","tiefe","wasserfall"}), 
            "Im Sueden rauscht ein Wasserfall in die Tiefe.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen"}),
	   "Du riechst die Seerosen sogar vom Ufer aus.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wasserfall im Sueden in die Tiefe "
                          "rauschen.");

  AddSound( ({"wasserfall"}),
	   "*rausch*rausch*rausch*");
  
//-----Details Ende-----
AddItem( "/d/huegelland/feyaria/weg/npc/fuchs", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "hoch2",
          P_MNPC_AREA:({ROOM "hoch2"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("norden", ROOM "hoch6");
AddExit("sueden", ROOM "hoch1");
AddExit("westen", ROOM "hoch3");

}  
   
