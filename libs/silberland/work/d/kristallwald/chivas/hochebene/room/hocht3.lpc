// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Turm");
  SetProp( P_INT_LONG,
	"Du stehst auf dem Wachturm. Die Aussicht ist fantastisch. Die "
        "gesamte Hochebene erstreckt sich unter Dir. Du erkennst den Weg, "
        "der Dich zum Turm gefuehrt hat und auch die Huegelgraeber im Osten "
        "der Hochebene. Im Westen glaubst Du ein entferntes Glitzern zu "
        "erkennen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wachturm","turm"}), 
            "Du stehst auf dem Turm. Du hast eine herrliche Aussicht von hier "
            "aus.");

  AddDetail( ({"aussicht"}),
	    "Die Aussicht ist atemberaubend. Du kannst in alle "
            "Himmelsrichtungen schauen.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Du kannst die gesamte Hochebene von Gorthad von hier "
            "ueberblicken. Die Graslandschaft sieht wie fliessendes Wasser "
            "von hier oben aus, da der Wind das Gras bewegt.");

  AddDetail( ({"weg"}),
	    "Du siehst den Weg der Dich bis hier her gebracht hat.");
  
  AddDetail( ({"huegelgraeber","osten","huegelgraebern"}),
	    "Im Osten siehst Du die grossen Huegelgraeber, die mit kleinen "
            "weissen Blumen bedeckt sind und aus der Graslandschaft der "
            "Hochebene heraus stechen.");

  AddDetail( ({"westen","glitzern"}), 
            "Ganz weit im Westen scheint eine Glitzern zu sein. Du kannst es "
            "gerade so erahnen. Vielleicht ist da in der weiten Ferne das "
            "Meer.");

  AddDetail( ({"boden"}),
	    "Der Boden besteht aus grossen Steinquadern. In der Mitte ist "
            "eine dunkle Oeffnung.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist wunderschoen blau ueber Dir. Einige Voegel sind "
            "zu sehen.");

  AddDetail( ({"himmelsrichtungen","richtungen"}),
	    "Die Richtungen sind Norden, Nordosten, Osten, Suedosten, Sueden "
            "Suedwesten, Westen und Nordwesten.");
  
  AddDetail( ({"nordosten"}),
	    "Im Nordosten siehst Du tiefe dichte Waelder, die bisher noch "
            "komplett unerforscht sind. Ganz weit im Nordosten sind auch "
            "grosse Berge zu sehen, die bisher noch keinen Namen haben.");

  AddDetail( ({"waelder","wald"}),
	    "Tiefe und dichte Waelder kannst Du von hier aus erkennen.");

  AddDetail( ({"norden","berge"}),
	    "Im Norden scheinen grosse Berge und dichte Waelder zu sein.");

  AddDetail( ({"suedwesten"}), 
            "Im Suedwesten gibt es auch tiefe Waelder. zu sehen. Auch scheint "
            "ein Pfad zwischen den Baeumen sich an der Felswand der Hochebene "
            "entlang zu schlaengeln.");

  AddDetail( ({"sueden","ende"}),
	    "Im Sueden siehst Du den befestigen Weg, der zu dem Turm gefuehrt "
            "hat. Am Ende der Hochebene siehst Du nichts als Wald.");

  AddDetail( ({"suedosten"}),
	    "Im Suedosten der Hochebene erkennst Du einen kleinen See, der "
            "ueber die Kante der Hochebene zu verschwinden scheint. Ganz ganz "
            "weit im Suedosten erkennst Du gerade noch die Baumriesen von "
            "Roch Adan, die die umliegenden Waelder um einiges ueberragen.");

  AddDetail( ({"nordwesten"}),
	    "Im Nordwesten scheint die Hochebene ganz langsam auszulaufen und "
            "in einem Wald zu enden.");
  
  AddDetail( ({"wellen","graslandschaft","gras","landschaft","wasser"}),
	    "Die Graslandschaft der Hochebene wiegt sich leicht im Wind. Das "
            "Gras bewegt sich wie Wasser im Wind und bildet Wellen. Es sieht "
            "toll aus.");

  AddDetail( ({"wind"}), 
            "Der Wind weht ueber die Hochebene. Hier auf dem Turm ist er "
            "recht stark.");

  AddDetail( ({"ferne","meer"}),
	    "Ganz weit in der Ferne koennte das Meer glitzern. Du bist Dir "
            "aber nicht sicher.");

  AddDetail( ({"voegel","arten"}),
	    "Die Voegel kreisen weit oben am Himmel. Trotz Deiner guten "
            "Augen kannst Du nicht erkennen, was fuer Arten es sind.");

  AddDetail( ({"berge","namen"}),
	    "Die schneebedeckten Berge ganz ganz weit im Nordwesten haben "
            "sicher keinen Namen, da noch nie einer dort gewesen ist. So weit "
            "ist das faule Magierpack noch nicht vorgedrungen.");
  
  AddDetail( ({"pfad"}), 
            "Der Pfad schlaengelt sich durch den Wald an der Felswand entlang");

  AddDetail( ({"baeumen","baeume"}),
	    "Baeume gehoeren zu einem Wald, wie Sand in eine Wueste.");

  AddDetail( ({"felswand"}),
	    "Der Turm steht direkt an der Felswand, um alles gut im "
            "Ueberblick zu behalten.");

  AddDetail( ({"baumriesen","roch","adan","roch adan","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren. Geh ruhig mal hin und "
            "schau Dich um. Wenn Du schon da bist, hilf dem Astrologen.");
  
  AddDetail( ({"kante","see"}),
	    "Der See stuerzt ueber die Kante in einen weiter unten liegenden "
            "See, den Du natuerlich von hier aus nicht sehen kannst.");

  AddDetail( ({"augen"}), 
            "Du hast zwei Augen. Es ist ein Wunder.");

  AddDetail( ({"wunder"}),
	    "Wunder gibt es immer wieder, vor allem im Silberland.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland. Du hast ein sehr schlechtes Gedaechnis.");

  AddDetail( ({"gedaechnis"}),
	    "Man hat sich auch schon zu Tode geforscht.");
  
  AddDetail( ({"tode"}),
	    "Jetzt reicht es aber mit der Detailtiefe.");

  AddDetail( ({"detailtiefe"}),
	    "Jetzt ist aber Schluss.");
  
  AddDetail( ({"schluss"}),
	    "................");

  AddDetail( ({"magierpack","magier"}), 
            "Werde bloss nie ein Magier!");

  AddDetail( ({"sand","wueste"}),
	    "Da bist Du hier falsch.");

  AddDetail( ({"ueberblick"}),
	    "Man hat von hier einen hervorragenden Ueberblick.");

  AddDetail( ({"zentauren","geschoepfe"}),
	    "Zentauren sind magische Geschoepfe. Sie wohnen in Baumriesen und "
            "ihre Stadt heisst Roch Adan.");
  
  AddDetail( ({"astrologe","astrologen"}),
	    "Geh einfach zu ihm und biete ihm Hilfe an.");

  AddDetail( ({"hilfe"}),
	    "Du koenntest auch oft Hilfe gebrauchen.");
  
  AddDetail( ({"ohren"}),
	    "Deine Ohren sind viel zu gross.");

  AddDetail( ({"blumen"}),
	    "Kleine weisse Blumen wachsen auf den Huegelgraebern der grossen "
            "Helden.");
  
  AddDetail( ({"helden"}),
	    "Nur Helden werden in Huegelgraebern bestattet.");

  AddDetail( ({"steinquader","steinquadern"}),
	    "Die grossen Steinquader bilden einen stabilen Boden. Die Fugen "
            "sind immer noch intakt, so dass es auch nicht durchregnen kann.");
  
  AddDetail( ({"fugen"}),
	    "In den Fugen steckt jahrhunderte alter Moertel.");

  AddDetail( ({"moertel"}),
	    "Der Moertel sieht jedoch fast aus wie neu. Die Erbauer des Turms "
            "haben ihr Handwerk verstanden.");
  
  AddDetail( ({"erbauer","handwerk","meister","fach","fachs"}),
	    "Sie waren Meister ihres Fachs.");

  AddDetail( ({"mitte","oeffnung"}),
	    "Durch die Oeffnung bist Du hier auf die Plattform gekommen und "
            "durch sie kommst Du auch wieder herunter.");
  
  AddDetail( ({"plattform","art"}),
	    "Du stehst auf einer Art Plattform auf dem Turm.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du kannst gar nichts riechen. Schade.");  
 
  AddSound(DEFAULT_SOUND, "Der Wind rauscht hier oben sehr laut.");

  AddSound( ({"wind"}),
	   "Der Wind ist hier oben staerker und blaesst Dir um die Ohren.");
  
//-----Details Ende-----
  
AddExit("unten", ROOM "hocht2");

}  
   
