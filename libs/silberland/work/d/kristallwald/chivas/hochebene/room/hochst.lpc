// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einer Felswand");
  SetProp( P_INT_LONG,
	"Du stehst dicht an die feuchte Felswand gedrueckt, knapp unter der "
        "obersten Kante, wo die Felswand aufhoert. Ein paar Moose haben sich "
        "an der Wand festgesetzt, was die Wand glitschig im Nieselregen des "
        "Wasserfalls macht." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"felswand","wand"}), 
            "Die Felswand an der Du stehst ist steil und Du bist ganz "
            "dicht an sie gedrueckt, da der Pfad auf dem Du stehst sehr "
            "schmal ist. An ihr wachsen ein paar Moose zwischen den Rissen.");

  AddDetail( ({"kante"}),
	    "Die oberste Kante der Felswand ist direkt ueber Dir.");

  AddDetail( ({"moose"}),
	    "EIn paar Moose wachsen an der Felswand.");

  AddDetail( ({"gischt","wasser"}),
	    "Das Wasser rauscht an Dir vorbei in die Tiefe und fasert sich "
            "weiter unten in einen leichten Nieselregen auf. Ausserdem erkennt "
            "man einen Regenbogen von hier oben, der sich weiter unten "
            "bildet.");
  
  AddDetail( ({"wasserfalls","wasserfall"}),
	    "Der Wasserfall rauscht tosend ganz nah an Dir vorbei und endet "
            "tief unten in dem kleinen See.");

  AddDetail( ({"boden"}), 
            "Der Boden unter Dir ist nass und rutschig. Ein paar kleine "
            "Steine sind auch zu sehen.");

  AddDetail( ({"himmel"}),
	    "Den Himmel kannst Du durch die Gischt nicht so gut erkennen. Auch "
            "die Sonne ist nur zu erahnen, die leicht ueber die Kante scheint. "
            "Weiter unten siehst Du jedoch einen wunderschoenen Regenbogen "
            "im Nieselregen des Wasserfalls.");

  AddDetail( ({"sonne"}), 
            "Die Sonne ist durch die Gischt kaum zu erkennen. Ausserdem ist "
            "die Sonne auch noch teilweise von der Felswand verdeckt.");

  AddDetail( ({"regenbogen"}),
	    "Der Regenbogen leuchtet in vielen herrlichen Farben weiter unten. "
            "Direkt an dieser Stelle, wo sich das Wasser noch nicht weit genug "
            "in Nieselregen zerfasert hat, kann leider kein Regenbogen "
            "entstehen.");

  AddDetail( ({"farben"}),
	    "Es sind so viele Farben. Du kannst sie nicht einmal zaehlen.");
  
  AddDetail( ({"steine"}),
	    "Die Steine sind klein und unscheinbar.");

  AddDetail( ({"rissen","risse"}), 
            "Zwischen den Rissen sind ein paar Moose zu erkennen.");

  AddDetail( ({"pfad"}),
	    "Der Pfad, der die Felswand hochfuehrt ist sehr schmall.");

  AddDetail( ({"see"}),
	    "Der See ist weit unter Dir.");

  AddDetail( ({"tiefe"}),
	    "Es geht sehr tief nach unten.");
  
  AddDetail( ({"umgebung"}),
	    "Es gibt schoenere Orte als diesen hier.");

  AddDetail( ({"orte"}), 
            "Mauritius ist sehr schoen.");

  AddDetail( ({"nieselregen","regen"}),
	    "Der leichte Nieselregen ist warm.");
  
  AddDetail( ({"mauritius"}),
	    "Mauritius ist eine Insel.");

  AddDetail( ({"insel","urlaub","moment"}),
	    "Auf der Insel kann man schoen Urlaub machen, aber nicht im Moment.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach gar nichts.");  
 
  AddSound(DEFAULT_SOUND, "Das Rauschen des Wasserfalls ist uebermaechtig.");

  AddSound( ({"rauschen"}),
	   "Ausser dem Rauschen ist nicht viel zu hoeren.");
  
//-----Details Ende-----
  
AddExit("nordwestoben", ROOM "hoch1");
AddExit("unten", "/d/kristallwald/chivas/weg/room/zenw15");

}  
   
