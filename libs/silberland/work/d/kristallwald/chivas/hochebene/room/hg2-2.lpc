// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int geistda;

void create()
	
{
  ::create();

  geistda=1; 

  SetProp( P_INT_SHORT, "In einem Huegelgrab");
  SetProp( P_INT_LONG,
	"Auch in der Grabkammer ist kein Staub zu erkennen. Irgend eine "
        "Macht scheint das Grab sauber zu halten. In der Mitte der Grabkammer "
        "steht ein grosser schwerere Sarkophag und an den Waenden stehen "
        "alle moeglichen Schaetze." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"grabkammer","kammer","vorkammer"}), 
            "Du stehst in der grossen Grabkammer des Huegelgrabs. Sie ist "
            "genau so sauber wie die Vorkammer, wo Du vorher warst. In ihrer "
            "Mitte siehst Du einen grossen steinernen Sarg.");

  AddDetail( ({"staub"}),
	    "Auch hier ist kein Staub zu erkennen. Die Grabkammer ist "
            "unnatuerlich sauber. Es sieht so aus, als ob hier immer Jemand "
            "Staub wischt.");

  AddDetail( ({"macht","jemand"}),
	    "Ist es eine unerklaerliche Macht oder Jemand, der die Kammer "
            "so sauber haelt. Das ist hier die Frage.");

  AddDetail( ({"grab","huegelgrab","huegelgraeber"}),
	    "Du bist in einem Grab auf der Hochebene von Gorthad.");
  
  AddDetail( ({"mitte","sarkophag","sarg"}),
	    "Der grosse Sarkophag besteht aus Stein. Er ist mit lauter "
            "Symbolen und Schriftzeichen uebersaet. Die Grabplatte sitzt nicht "
            "ganz gerade auf dem Sarkophag.");

  AddDetail( ({"waende","waenden","wand"}), 
            "An den Waenden stehen lauter Kostbarkeiten. Einige kleine Truhen "
            "und Statuen, die dem Toten sicher als Grabbeigaben mitgegeben "
            "wurden.");

  AddDetail( ({"schaetze","kostbarkeiten","dinge"}),
	    "Du siehst ein paar kostbare Statuen und einige kleine Truhen.");

  AddDetail( ({"boden"}),
	    "Am Boden stehen ein paar kleine Truhen und andere Kostbarkeiten. "
            "Ansonsten ist der Boden von dem grossen Sarg bedeckt.");

  AddDetail( ({"decke"}),
	    "Die Decke ist kahl, bis auf eine kleine Oellampe, die direkt "
            "ueber dem Sarkophag haengt.");
  
  AddDetail( ({"himmel","raum"}),
	    "Der Himmel ist in einem Raum die Decke.");

  AddDetail( ({"frage"}), 
            "Dies Frage solltest Du klaeren.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Die Hochebene von Gorthad ist fuer ihre Huegelgraeber beruehmt.");

  AddDetail( ({"symbolen","symbole"}),
	    "Die Symbole sind zu alt fuer Dich, Du kannst sie nicht verstehen. "
            "Die Schriftzeichen dagegen verstehst Du.");

  AddDetail( ({"schriftzeichen"}),
	    "Du erkennst eine Inschrift.");
  
  AddDetail( ({"grabplatte","platte","seite"}),
	    "Die Grabplatte sitzt nicht fest auf dem Sarkophag. Du koenntest "
            "die Grabplatte sicher zur Seite schieben.");

  AddDetail( ({"truhen"}), 
            "Die Truhen sind mit einem Schloss versehen.");

  AddDetail( ({"statuen"}),
	    "Die Statuen bestehen aus purem Gold und stellen Kaempfer dar.");

  AddDetail( ({"grabbeigaben","beigaben"}),
	    "Die Truhen und Statuen sind Grabbeigaben fuer den Krieger der "
            "hier bestattet wurde.");

  AddDetail( ({"toten","kulturen","tradition"}),
	    "Dem Toten kostbare Dinge mit ins Grab zu legen ist in vielen "
            "Kulturen Tradition.");
  
  AddDetail( ({"oellampe","lampe","licht","schein"}),
	    "Die Lampe brennt und spendet ein wenig Licht. Irgendwer muss "
            "sie angezuendet haben.");

  AddDetail( ({"krieger"}), 
            "Es muss ein grosser Krieger gewesen sein, wenn er sein eigenes "
            "Huegelgrab bekommen hat.");

  AddDetail( ({"inschrift"}),
	    "Du kannst die Inschrift lesen.");

  AddDetail( ({"schloss","schloesser"}),
	    "Die Schloesser an den Truhen sehen intakt aus und strahlen "
            "eine gewisse Sicherheit aus. Falls Du auf die Idee kommst "
            "das Schloss zu knacken, solltest Du mit den Konsequenzen leben "
            "koennen.");

  AddDetail( ({"gold"}),
	    "Das Gold wurde anscheinend poliert und funkelt im Schein der "
            "Oellampe.");
  
  AddDetail( ({"kaempfer"}),
	    "Die Kaempfer sehen beinahe lebensecht aus und ihre Gold glaenzt "
            "im Schein der Oellampe.");

  AddDetail( ({"sicherheit"}), 
            "Das Schloss ist sicher nicht so einfach zu knacken, es hat "
            "sicher versteckte Fallen.");

  AddDetail( ({"fallen"}),
	    "Du untersuchst das Schloss, kannst aber keine Fallen entdecken, "
            "was jedoch nicht heissen soll, dass es keine gibt.");

  AddDetail( ({"konsequenzen","idee"}),
	    "Du bist hier mit gewarnt, dass es Konsequenzen haben kann.");

  AddDetail( ({"stein"}),
	    "Der Sarg, der Boden, die Waende und natuerlich auch die Decke "
            "bestehen aus Stein.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Hier kann man gar nichts riechen, es ist viel zu "
                          "sauber, als das es hier irgendwelche Gerueche "
                          "geben wuerde.");  
 
  AddSmell( ({"gerueche"}),
	   "Gerueche gibt es hier nicht.");

  AddSound(DEFAULT_SOUND, "Man kann hier gar nichts hoeren.");

  AddReadDetail( ({"inschrift"}),
		"Die Inschrift sagt, wer hier bestattet wurde:\n"
                "+--------------------------------------+\n"
                "|                                      |\n"
                "|    Hier liegt in Ehren begraben:     |\n"
                "|                                      |\n"
                "|      Grosnak, der Ordentliche        |\n"
                "|                                      |\n"
                "|     Er war einer unserer groessten   |\n"
                "|     und staerksten Kaempfer.         |\n"
                "|     Auf jedenfall war er der         |\n"
                "|     Ordentlichste.                   |\n"
                "|                                      |\n"
                "+--------------------------------------+");


//-----Details Ende-----
  
AddExit("osten", ROOM "hg2-1");

AddCmd( ({"schieb", "schiebe" }), "schieben" );
AddCmd( ({"knack", "knacke" }), "knacken" );

}
void reset()
{
  ::reset();
  geistda=1;
}

int schieben(string str)
{
   object geist;
   notify_fail("Was moechtest Du zur Seite schieben?\n");
   if ( member( ({ "grabplatte zur seite","platte zur seite" }),str) != -1) 

  if ( geistda )
  {
  write(BS("Du schiebst mit aller Kraft die Grabplatte zur Seite und ein "
           "Geist schwebt mit einem Besen aus dem Grab und faengt laut "
           "schimpfend sofort an, das Grab zu putzen."));
  write(BSA("Hoffentlich hast Du saubere Schuhe an, sonst bin ich naemlich wirklich sauer ."
           "Daraufhin fegt er Dich nicht mehr beachtend weiter.", "Der Geist sagt: "));
  geist=clone_object (NPC "grosnak" );
  geist->move(TO,M_GO|M_NOCHECK,"schwebt herein.");
  geistda--;
  return 1;
  }
  else
  {
  write(BS("Du kannst die Grabplatte nicht mehr verschieben, sie ist "
           "schon verschoben.\n"));
  return 1;
  }
}
int knacken(string str)
{
   if ( member( ({"schloss","schloesser"})
,str) != -1) 
  {
    write(BS("Du wagst es also trotz aller Warnungen doch. Als Du schliesslich "
           "versuchst das erste Schloss zu knacken, kommt eine kleine Nadel "
           "aus dem Schloss, die Du vorher nicht gesehen hast und sticht "
           "Dich."));
    write( "Danach laesst Du die Finger von den Truhen.\n");
    say( TPN+" verzieht vor Schmerz das Gesicht.\n");
    TP->AddHp(-30);
    this_player()->AddPoison(3);
    return 1;
  }
}

