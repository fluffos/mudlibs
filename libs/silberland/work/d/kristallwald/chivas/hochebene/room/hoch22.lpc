// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int fledermausda;

void create()
	
{
  ::create();

  fledermausda=1; 

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Am Wegrand steht ein alter abgestorbener Baum. Es sieht so aus, als "
        "ob vor langer Zeit ein Blitz in ihn eingeschlagen ist. Es ist der "
        "einzige Baum, oder was von ihm uebrig ist, den Du bisher auf der "
        "Hochebene gesehen hast. Ansonsten siehst Du nur Gras und ab und zu "
        "ein paar Findlinge." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"wegrand","rand"}), 
            "Ein abgestorbener Baum steht am Wegrand im Gras der Hochebene.");

  AddDetail( ({"baum","baumes"}),
	    "Der Baum ist schon vor langer Zeit abgestorben. Ein maechtiger "
            "Blitz hat ihn in der Mitte gespalten. Es scheint der einzige "
            "Baum auf der ganzen Hochebene gewesen zu sein. Du hast ansonsten "
            "noch keinen gesehen.");

  AddDetail( ({"zeit"}),
	    "Es ist sehr lange her. Sicher ist dies zu einer Zeit geschehen, "
            "als es noch nicht einmal die Huegelgraeber im Osten der Hochebene "
            "gab.");

  AddDetail( ({"blitz"}),
	    "Der Blitz hat den Baum in der Mitte fast bis zu den Wurzeln "
            "gespalten.");
  
  AddDetail( ({"hochebene","gorthad"}),
	    "Du befindest Dich auf der Hochebene von Gorthad, die fuer ihre "
            "Huegelgraeber bekannt ist.");

  AddDetail( ({"gras"}), 
            "Auf der Hochebene gibt es fast nur Gras. Es wirkt sehr "
            "beruhigend.");

  AddDetail( ({"findlinge"}),
	    "Hier sind momentan keine Findlinge. Im Sueden liegen ein paar "
            "herum, aber um diese genauer zu untersuchen, musst Du schon "
            "hingehen.");

  AddDetail( ({"boden"}),
	    "Der Weg besteht aus Pflastersteinen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen blau. Die Sonne wird von keinerlei Wolken "
            "verdeckt.");

  AddDetail( ({"wolken"}),
	    "Was ist an keinerlei Wolken nicht zu verstehen?");

  AddDetail( ({"sonne"}),
	    "Die Sonne sieht auf einmal aus wie Delgo. Du beginnst Dich zu "
            "fuerchten. Beim zweiten Blick auf die Sonne, wirkt sie jedoch "
            "wieder ganz normal.");

  AddDetail( ({"delgo"}),
	    "Delgo ist ein netter Magier im Silberland.");

  AddDetail( ({"magier"}),
	    "Davon gibt es einige hier und ausser idlen koennen sie nicht "
            "viel.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland.");
  
  AddDetail( ({"pflastersteinen","pflastersteine","steine","steinen"}),
	    "Die Pflastersteine bilden einen gut ausgebauten Weg. Zwischen den "
            "einzelnen Steinen waechst ein wenig Moos.");

  AddDetail( ({"huegelgraeber","osten","huegel"}), 
            "Im Osten erkennst Du verschiedene grosse und kleine Huegel. Um "
            "sie genauer zu untersuchen, musst Du schon hingehen.");

  AddDetail( ({"moos","farbe"}),
	    "Das Moos hat eine gesunde gruene Farbe und scheint sich zwischen "
            "den Pflastersteinen sehr wohl zu fuehlen.");

  AddDetail( ({"wurzeln","erde"}),
	    "Die Wurzeln des Baumes kannst Du natuerlich nicht sehen. Sie sind "
            "tief in der Erde.");

  AddDetail( ({"mitte"}),
	    "Ein breiter Riss zieht sich von oben bis unten durch den "
            "abgestorbenen Baum.");
  
  AddDetail( ({"riss"}),
	    "Im Riss erkennst Du ein Funkeln.");

  AddDetail( ({"funkeln"}), 
            "Das Funkeln macht Dich ein wenig nervoes. Es scheinen zwei gelbe "
            "Augen zu sein, die Dich anfunkeln.");

  AddDetail( ({"augen"}),
	    "Die Augen schauen Dich interessiert an. Vielleicht kannst Du "
            "den Besitzer der Augen heraus locken.");

  AddDetail( ({"weg"}),
	    "Der Weg fuehrt Dich ueber die Hochebene.");

  AddDetail( ({"besitzer"}),
	    "Probier doch mal den Besitzer heraus zu locken.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach verbrannten Holz.");  
 
  AddSmell( ({"holz"}),
	   "Es ist schon komisch, dass das Holz des abgestorbenen Baumes immer "
           "noch verbrannt riecht.");

  AddSound(DEFAULT_SOUND, "Du hoersten ein Rascheln.");

  AddSound( ({"rascheln"}),
	   "Das Rascheln kommt irgendwie aus dem alten Baum.");
  
  AddSound( ({"baum"}),
	   "Da musst schon ein wenig forschen.");

//-----Details Ende-----
  
AddExit("norden", ROOM "hoch23");
AddExit("sueden", ROOM "hoch21");

AddCmd( ({"lock","locke" }), "locken" );

}
void reset()
{
  ::reset();
  fledermausda=1;
}
int locken(string str)
{
   object fledermaus;
   notify_fail("Wen moechtest Du heraus locken?\n");
   if ( member( ({ "besitzer heraus" }),str) != -1) 

  if (present("fledermaus",TO) || !fledermausda)

  {
  write(BS("Du probierst mit sanften Worten den Besitzer der Augen aus "
           "dem Riss zu locken, jedoch verziehen sich die Augen in die "
           "Dunkelheit und Du siehst sie nicht mehr.\n"));
  return -1;
  }
  write(BS("Du lockst mit sanften Worten den Besitzer der gelben Augen "
           "hervor."));
  fledermausda=0;
  fledermaus=clone_object ("/d/kristallwald/chivas/zentauren/npc/fledermaus" );
  fledermaus->move(TO,M_GO|M_NOCHECK,"flattert herein.");
   return 1;
  }

