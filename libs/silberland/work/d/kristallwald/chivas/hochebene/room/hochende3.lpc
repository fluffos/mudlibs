// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Wald ist hier noch dichter als im Sueden. Die Baeume ruecken "
        "hier viel naeher an den Weg, so dass man eigentlich nur noch von "
        "einem breiten Pfad reden koennte. Die Lichtverhaeltnisse nehmen "
        "immer mehr ab im Norden. Dort ist wirklich ein richtig dunkler "
        "Wald." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wald"}), 
            "Der Wald wird im Norden immer dichter und duesterer.");

  AddDetail( ({"sueden"}), 
            "Im Sueden sah der Wald noch nicht so beunruhigend aus.");

  AddDetail( ({"baeume"}), 
            "Die Baeume stehen viel dichter am Weg als im Sueden. Sie scheinen "
            "im Norden noch dichter zu stehen.");

  AddDetail( ({"weg","pfad"}), 
            "Der Weg wird von den Baeumen gerade zu bedraengt, so dass er "
            "eigentlich nur noch wie ein breiter Pfad wirkt. ");

  AddDetail( ({"lichtverhaeltnisse","norden"}), 
            "Die Lichtverhaeltnisse sind im Norden noch viel schlechter als "
            "hier, obwohl sie hier schon nicht mehr ideal sind.");

  AddDetail( ({"boden"}), 
            "Der Boden ist schwarz und erdig.");
  
  AddDetail( ({"himmel","sonne"}), 
            "Der Himmel und die Sonne sind durch das dichte Blaetterdach gar "
            "nicht mehr zu sehen. Es ist schon recht dunkel und die Sicht "
            "nimmt rapide ab.");

  AddDetail( ({"sicht"}), 
            "Im Sueden kann man viel besser sehen.");

  AddDetail( ({"blaetterdach","dach"}), 
            "Das dichte Blaetterdach laesst kaum noch Licht durch.");

  AddDetail( ({"licht"}), 
            "Von Licht kann man in dieser duesteren Umgebung kaum noch reden.");

  AddDetail( ({"umgebung"}), 
            "In dieser Umgebung fuehlst Du Dich nicht wohl.");

  AddDetail( ({"gefuehl","gefuehle"}), 
            "Manchmal sollte man auf seine Gefuehle hoeren. Sie koennen Dir "
            "oft das Leben retten.");
  
  AddDetail( ({"leben"}), 
            "Dein Leben ist kostbar. Du moechtest sicher nicht dem Tod "
            "begegnen.");

  AddDetail( ({"tod"}), 
            "Tod ist zwar eigentlich ganz nett, trotzdem will man ihn nicht "
            "so oft treffen, ausser man ist ein Nekromant.");

  AddDetail( ({"nekromant","nekromanten"}), 
            "Die Nekromanten sind eine finstere Gilde im Silberland.");

  AddDetail( ({"gilde"}), 
            "Es gibt verschiedene Gilden im Silberland.");

  AddDetail( ({"gilden"}), 
            "Tipp einfach mal 'hilfe gilden'.");

  AddDetail( ({"silberland"}), 
            "Du bist im Silberland.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Gefahr.");  
 
  AddSmell( ({"gefahr","geruch"}),
	   "Es ist mehr ein Gefuehl, als ein Geruch. Die Gefahr geht "
           "anscheinend von dunklen Wald im Norden aus.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar merkwuerdige Geraeusche.");

  AddSound( ({"geraeusche"}),
	   "Die Geraeusche sind ein Knacken und Aechzen.");
  
  AddSound( ({"knacken","aechzen"}),
	   "Die Geraeusche kommen aus dem dunklen Wald im Norden.");

//-----Details Ende-----
  
AddExit("sueden", ROOM "hochende2");
AddExit("norden", "/d/kristallwald/chivas/zwergenfeste/room/zww13");

}
