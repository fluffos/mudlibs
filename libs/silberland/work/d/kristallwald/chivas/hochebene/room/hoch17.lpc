// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Eine leichte Brise streicht ueber das Gras der Hochebene. Auch ein "
        "paar Straeucher stehen am Rand des Weges. Der Weg fuehrt weiter von "
        "der Hochebene herunter, bzw. hinauf." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"brise","wind"}), 
            "Der Wind bewegt das Gras auf der Hochebene ein wenig.");

  AddDetail( ({"gras"}),
	    "Das Gras waechst auf der ganzen Hochebene.");

  AddDetail( ({"hochebene"}),
	    "Die Hochebene von Gorthad ist bekannt fuer seine riesige "
           "Graslandschaft und ihre Huegelgraeber.");

  AddDetail( ({"straeucher","abwechselung"}),
	    "Ein paar kleine Straeucher stehen am Rand des Weges. Im "
            "Sueden gibt es nur Gras. Du freust Dich ueber die Abwechslung.");
  
  AddDetail( ({"rand"}),
	    "Am Rand des Weges stehen ein paar Straeucher im Gras.");

  AddDetail( ({"weg","weges"}), 
            "Der Weg fuehrt von Norden nach Sueden die Hochebene hinauf.");

  AddDetail( ({"boden"}),
	    "Der Boden besteht aus denen Dir schon laengst bekannte "
            "Pflastersteinen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau. Am Horizont ziehen ein paar weisse Wolken "
            "auf.");

  AddDetail( ({"horizont","wolken"}),
	    "Die Wolken am Horizont sind weiss. Es sieht nicht so aus, als ob "
            "es regnen wuerde.");
  
  AddDetail( ({"huegelgraeber"}),
	    "Die Huegelgraeber der Hochebene sind weiter im Sueden.");

  AddDetail( ({"sueden"}), 
            "Im Sueden geht es weiter auf die Hochebene hinauf.");

  AddDetail( ({"norden"}),
	    "Nach Norden fuehrt der Weg von der Hochebene herunter.");

  AddDetail( ({"pflastersteine","pflastersteinen"}),
	    "Es sind ganz normale Pflastersteine, wie sie schon auf dem "
            "gesamten Weg zu sehen waren. In den Fugen zwischen den "
            "Steinen waechst ein wenig Gras.");

  AddDetail( ({"fugen"}),
	    "In den Fugen, zwischen dem Gras, siehst Du ein Funkeln.");
  
  AddDetail( ({"funkeln"}),
	    "Vielleicht kann man nach ihm greifen?");

  AddDetail( ({"graslandschaft","landschaft"}),
	    "Die Graslandschaft der Hochebene bedeckt hier fast alles.");

  AddDetail( ({"gorthad"}),
	    "Du befindest Dich auf der Hochebene von Gorthad.");

  AddDetail( ({"steine","steinen"}),
	    "Es sind grosse Pflastersteine, die den Weg bilden.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Gras.");  
 
  AddSmell( ({"gras"}),
	   "Es riecht sehr grasig.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind.");

  AddSound( ({"wind"}),
	   "Du hoerst den Wind ueber die Graslandschaft wehen.");
  
//-----Details Ende-----
  
AddExit("suedoben", ROOM "hoch16");
AddExit("nordunten", ROOM "hoch18");

AddCmd( ({"greifen", "greife","greif" }), "greifen" );

}
int greifen(string str)
{
   notify_fail("Nach was moechtest Du greifen?\n");
   if ( member( ({ "nach funkeln", "nach etwas" }),str) != -1) 
  {
    write(BS ( "Du greifst nach dem Funkeln und findest nur eine alte "
               "Glasscherbe, die nichts wert ist. Du wirfst sie wieder "
               "weg."));
    say( TPN+" greift nach Etwas und wirft es wieder weg.\n");
    return 1;
  }
  return 0;
}  
   
