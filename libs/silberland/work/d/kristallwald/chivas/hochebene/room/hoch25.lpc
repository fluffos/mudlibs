// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Der Weg fuehrt direkt an einem steilen Abhang entlang, dass den Rand "
        "der Hochebene darstellt. Falls Du die Hochebene verlassen willst, "
        "dann brauchst Du hier nur zu springen. Du bist innerhalb von Sekunden "
        "unten. Der Turm, der im Norden immer groesser wird, scheint ein "
        "alter Wachposten zu sein um die Umgebung zu beobachten." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"weg"}), 
            "Der Weg fuehrt direkt am steilen Abhang entlang auf einen Turm "
            "zu.");

  AddDetail( ({"abhang","felswand"}),
	    "Es ist eher eine senkrechte Felswand, die nach unten fuehrt. Ein "
            "Sprung wuerde Dich recht schnell nach unten bringen.");

  AddDetail( ({"rand"}),
	    "Der Rand der Felswand ist direkt neben dem Weg.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Du bist auf der Hochebene von Gorthad.");
  
  AddDetail( ({"sekunden"}),
	    "Es wuerde nur einige Sekunden dauern die Hochebene zu verlassen.");

  AddDetail( ({"turm","norden"}), 
            "Der schwarze Turm im Norden wird immer groesser. Es scheint ein "
            "alter Wachposten zu sein.");

  AddDetail( ({"wachposten","posten"}),
	    "Der Wachposten scheint verlassen zu sein. Um mehr zu erkennen, "
            "musst Du schon naeher ran gehen.");

  AddDetail( ({"umgebung"}),
	    "Von dem Turm aus kann man die gesamte Umgebung hervorragen "
            "beobachten.");

  AddDetail( ({"sprung"}),
	    "Spring doch einfach mal die Felswand runter.");

  AddDetail( ({"gras","es"}),
	    "Es ist das typische Gras der Hochebene.");
  
  AddDetail( ({"boden"}),
	    "Der Weg besteht aus grossen Pflastersteinen.");

  AddDetail( ({"sonne"}),
	    "Die Sonne scheint sehr grell, so dass ein direkter Blick in die "
            "Sonne sehr negativ fuer Deine Netzhaut waere.");

  AddDetail( ({"blick"}),
	    "Der direkte Blick in die Sonne ist nicht besonders gut.");

  AddDetail( ({"netzhaut"}),
	    "Du haettest dann einmal eine heile Netzhaut gehabt.");

  AddDetail( ({"himmel"}), 
            "Am noerdlichen Horizont scheinen ein paar Wolken aufzuziehen, die "
            "jedoch nicht die Sonne verdecken, die beinahe senkrecht ueber Dir "
            "steht.");

  AddDetail( ({"horizont","wolken"}),
	    "Die weissen Wolken am Horizont ziehen langsam auf Dich zu.");

  AddDetail( ({"pflastersteinen","pflastersteine","steine"}),
	    "Die Pflastersteine wurden vor Jahrhunderten hier zu einem "
            "stabilen Weg ausgelegt.");

  AddDetail( ({"jahrhunderten","jahrhunderte"}),
	    "Es ist schon sehr lange her.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Gras.");  
 
  AddSmell( ({"gras"}),
	   "Es riecht grasig.");

  AddSound(DEFAULT_SOUND, "Es ist sehr still hier.");

//-----Details Ende-----
  
AddExit("nordosten", ROOM "hoch26");
AddExit("sueden", ROOM "hoch24");

AddCmd( ({"spring","springe" }), "springen" );

}
int springen(string str)
{
   if ( member( ({"von hochebene","steilwand runter","felswand runter","wand runter"})
,str) != -1) 
  {
    write( BS("Du setzt an um einen mutigen Sprung die Felswand herunter zu "
           "wagen, als Dich eine knochige Hand zurueck haelt."));
    write(BSA("Dummer kleiner Abenteurer, machst Du alles was ein Magier sagt?",
          "Eine Stimme in Deinem Kopf sagt: "));
    write(BS( "Darauf hin gibt Dir TOD noch eine schallernde Ohrfeige und "
           "verschwindet wieder."));
    say( BS(TPN+" bekommt von Jemanden, der sich sofort danach in Rauch aufloest "
             "eine schallernde Ohrfeige."));
    TP->AddHp(-15);
    return 1;
  }
}

