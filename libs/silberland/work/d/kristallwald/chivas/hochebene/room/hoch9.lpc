// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Der Weg verlaeuft direkt zwischen den Huegelgraebern laengst "
        "vergessener Helden durch. Die Huegelgraeber sind mit kleinen "
        "weissen Blumen und gruenem Gras bewachsen. Ab und zu sieht man "
        "an den Huegeln kleine Steintafeln, die komplett in den Huegel "
        "eingebettet sind." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"weg"}), 
            "Der gepflasterte Weg fuehrt direkt an den Huegelgraebern vorbei.");

  AddDetail( ({"huegelgraebern","graeber","huegelgraeber"}),
	    "Die Huegelgraeber haben eine unterschiedliche Groesse. Einige "
            "sind riesig, andere dagegen sind kaum in der Landschaft "
            "auszumachen. Sie sind mit kleinen weissen Blumen und Gras "
            "bewachsen.");

  AddDetail( ({"helden"}),
	    "Grosse Helden laengst vergessener Zeiten liegen hier begraben.");

  AddDetail( ({"blumen"}),
	    "Die kleinen weissen Blumen wachsen komischerweise nur auf den "
            "Graebern. Sie sind klein und zierlich und ein suesslicher Duft "
            "entstroemt ihren Blueten.");
  
  AddDetail( ({"gras"}),
	    "Das Gras waechst auf der gesamten Hochebene. Zwischen dem Gras "
            "auf den Huegelgraebern sind kleine Tafeln eingelassen.");

  AddDetail( ({"steintafeln","steintafel","tafel","tafeln"}), 
            "Die Steintafeln bestehen zum groessten Teil aus Sandstein. Es sind "
            "Schriftzeichen zu erkennen.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit grossen Pflastersteinen bedeckt, die den Weg "
            "bilden.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen blau, nur ein paar weisse Wolken sind "
            "am noerdlichen Horizont zu erkennen.");

  AddDetail( ({"horizont"}),
	    "Am noerdlichen Horizont sind ein paar weisse Wolken zu sehen.");
  
  AddDetail( ({"wolken"}),
	    "Die weissen Wolken bringen sicher keinen Regen.");

  AddDetail( ({"regen","angst"}), 
            "Es wird bestimmt nicht regnen. Du brauchst keine Angst zu haben "
            "nass zu werden, obwohl Dir eine Dusche ganz gut tun wuerde.");

  AddDetail( ({"dusche","fremdwort"}),
	    "Es ist ueberall bekannt, dass eine Dusche fuer Dich ein "
            "Fremdwort ist.");

  AddDetail( ({"groesse"}),
	    "Es gibt grosse und kleine Huegelgraeber.");

  AddDetail( ({"landschaft"}),
	    "Die Landschaft besteht hauptsaechlich aus Gras. Nur auf den "
            "Huegelgraebern wachsen kleine weisse Blumen.");
  
  AddDetail( ({"zeiten"}),
	    "Es ist sehr lange her.");

  AddDetail( ({"duft"}), 
            "Du kannst einen Duft nur riechen.");

  AddDetail( ({"blueten"}),
	    "Die Blueten sind weiss und geoeffnet. Sie haben sich in Richtung "
            "der Sonne gedreht.");

  AddDetail( ({"richtung","sonne"}),
	    "Die Sonne steht beinahe senkrecht am Himmel und waermt Dich auf "
            "der Hochebene.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Du befindest Dich auf der Hochebene von Gorthad.");
  
  AddDetail( ({"pflaster","pflastersteinen","pflastersteine","steine"}),
	    "Die Pflastersteine sind schon ein wenig ausgetreten, obwohl der "
            "Weg trotzdem in einem sehr guten Zustand ist.");

  AddDetail( ({"zustand","annahme"}), 
            "Der Zustand ist eine subjektive Annahme.");

  AddDetail( ({"sandstein"}),
	    "Sandstein ist ein sehr weiche Steinart.");

  AddDetail( ({"schriftzeichen"}),
	    "Du kannst sie lesen.");

  AddDetail( ({"nase"}),
	    "Du hast eine sehr grosse Nase.");
  
  AddDetail( ({"steinart","steinarten","steinsorte"}),
	    "Es gibt weich und harte Steinarten. Granit ist zum Beispiel eine "
            "sehr harte Steinsorte.");

  AddDetail( ({"granit"}), 
            "Du untersuchst wirklich alles.");

  AddDetail( ({"beispiel","mist"}),
	    "Du bist das ideale Beispiel fuer jemanden, der jeden Mist "
            "untersucht.");

  AddDetail( ({"huegel","huegeln"}),
	    "Die Huegel sind Graeber laengst vergessener Helden.");

  AddDetail( ({"teil","metall"}),
	    "Sie bestehen zum groessten Teil aus Sandstein. Auch ein wenig "
            "Metall ist an ein paar Tafeln zu erkennen, jedoch ist es schon "
            "fast verrostet.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst den Duft der kleinen weissen Blumen.");  
 
  AddSmell( ({"duft","blumen"}),
	   "Der suessliche Duft der Blumen steigt Dir in die Nase.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind durch das Gras wehen.");

  AddSound( ({"gras","wind"}),
	   "Das Gras raschelt ein wenig durch den Wind.");
  
  AddReadDetail( ({"schriftzeichen"}),
		"Auf den Tafeln stehen die Namen der Krieger, die hier "
                "bestattet wurden. In den Huegelgraebern zu beiden Seiten "
                "liegen die Krieger Farodred und Nuadred begraben. Sie "
                "muessen stattliche Krieger sein, wenn sie in so grossen "
                "Huegelgraebern begraben wurden.");


//-----Details Ende-----
  
AddExit("norden", ROOM "hoch10");
AddExit("sueden", ROOM "hoch8");

}  
   
