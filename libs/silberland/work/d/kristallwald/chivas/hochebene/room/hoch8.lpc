// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Der Weg biegt nach Norden und Westen ab. Falls Du nach Westen gehst, "
        "wirst Du am Ufer des Sees von Gorthad entlang gehen. Nach Norden "
        "scheint der Weg zwischen Huegeln unterschiedlicher Groesse weiter zu "
        "fuehren." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"weg"}), 
            "Der gepflasterte Weg fuehrt nach Norden vom See von Gorthad weg "
            "oder nach Westen um den See herum.");

  AddDetail( ({"norden"}),
	    "Im Norden sieht man Huegel unterschiedlicher Groesse. Der Weg "
            "fuehrt direkt zwischen ihnen durch.");

  AddDetail( ({"westen"}),
	    "Im Westen geht der Weg am Ufer der Sees weiter durch die "
            "Graslandschaft der Hochebene.");

  AddDetail( ({"ufer"}),
	    "Am Ufer des Sees waechst ein wenig Schilf.");
  
  AddDetail( ({"see","sees"}),
	    "Der See liegt ruhig neben dem Weg. Es gibt kaum Wellen, die an "
            "das Ufer plaetschern.");

  AddDetail( ({"gorthad","hochebene"}), 
            "Du befindest Dich auf der Hochebene von Gorthad.");

  AddDetail( ({"huegeln","huegel"}),
	    "Die Huegel im Norden sind anscheinend nicht nur von Gras bedeckt, "
            "sondern auch von kleinen weissen Blumen.");

  AddDetail( ({"groesse"}),
	    "Die Groesse der Huegel unterscheidet sich. Es scheinen ein paar "
            "sehr grosse dabei zu sein und ein paar, die fast schon "
            "unscheinbar aus der Graslandschaft hervor stechen.");

  AddDetail( ({"boden"}),
	    "Der Boden des Weges ist mit grossen Steinen gepflastert. "
            "Zwischen den Steinen waechst ein wenig Gras.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ueber Dir ist blau. Ein paar Voegel kreisen weit oben "
            "vor der Sonne.");

  AddDetail( ({"voegel"}), 
            "Die Voegel kannst Du nicht so gut erkennen, da Dich die Sonne "
            "blendet.");

  AddDetail( ({"sonne"}),
	    "Die Sonne steht fast senkrecht am Himmel.");

  AddDetail( ({"steinen","steine"}),
	    "Die Steine bilden einen festen gepflasterten Weg.");

  AddDetail( ({"graslandschaft","landschaft"}),
	    "Die Graslandschaft erstreckt sich ueber die gesamte Hochebene.");
  
  AddDetail( ({"gras","hauptbestandteil"}),
	    "Gras ist der Hauptbestandteil der Hochebene von Gorthad.");

  AddDetail( ({"blumen"}), 
            "Es scheinen kleine weisse Blumen zu sein, aber um es genau zu "
            "erkennen, musst Du schon hingehen.");

  AddDetail( ({"wellen","oberflaeche"}),
	    "Es gibt kaum Wellen auf dem See zu sehen. Die Oberflaeche ist "
            "fast komplett glatt.");

  AddDetail( ({"schilf","kolben"}),
	    "Ein wenig Schilf waechst am Ufer des Sees. Die Kolben sind gross "
            "gewachsen und sehen gesund aus.");

  AddDetail( ({"singvoegel"}),
	    "Solche Voegel siehst Du nicht.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Gras.");  
 
  AddSmell( ({"gras"}),
	   "Es riecht grasig, anders kann man es nicht beschreiben.");

  AddSound(DEFAULT_SOUND, "Die Voegel weit oben am Himmel kreischen.");

  AddSound( ({"voegel"}),
	   "Da die Voegel kreischen, koennen es definitiv keine Singvoegel "
           "sein.");
  
//-----Details Ende-----
AddItem( "/d/ebene/Silberwald/npc/otter", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "hoch8",
          P_MNPC_AREA:({ROOM "hoch8"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("norden", ROOM "hoch9");
AddExit("westen", ROOM "hoch7");

}  
   
