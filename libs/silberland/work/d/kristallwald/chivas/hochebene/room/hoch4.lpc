// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Du stehst an einer Abzweigung vom Hauptweg. Ein kleiner Weg fuehrt "
        "nach Norden in unbekanntes Gebiet auf der Hochebene. Am Wegrand "
        "liegen einige grosse Findlinge." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"abzweigung"}), 
            "Ein kleiner Weg, der jedoch auch gut ausgebaut ist, biegt nach "
            "Norden vom Hauptweg ab.");

  AddDetail( ({"hauptweg","osten","westen"}),
	    "Der Hauptweg fuehrt von Osten nach Westen.");

  AddDetail( ({"weg"}),
	    "Der kleine Weg fuehrt nach Norden weiter in die Hochebene hinein. "
            "Der Hauptweg auf dem Du stehst fuehrt nach Osten oder Westen.");

  AddDetail( ({"norden","gebiet"}),
	    "Der Weg fuehrt nach Norden in unbekanntes Gebiet.");
  
  AddDetail( ({"hochebene","gorthad"}),
	    "Die Hochebene von Gorthad mit ihrer Graslandschaft ist sehr "
            "gross.");

  AddDetail( ({"wegrand","rand"}), 
            "Am Wegrand liegen ein paar grosse Findlinge im Gras.");

  AddDetail( ({"findlinge"}),
	    "Die grossen Findlinge sind fast so gross wie ein Troll. Ihre "
            "Oberflaeche ist glatt und kein Makel ist zu sehen.");

  AddDetail( ({"boden"}),
	    "Der Weg besteht aus grossen Pflastersteinen, so dass es "
            "eigentlich eine befestigte Strasse ist.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau und die Sonne steht fast senkrecht am "
            "Himmel.");
  
  AddDetail( ({"graslandschaft","landschaft","eindruck"}),
	    "Die weite Graslandschaft der Hochebene macht einen friedlichen "
            "Eindruck.");

  AddDetail( ({"gras"}), 
            "Das Gras waechst ungefaehr kniehoch.");

  AddDetail( ({"makel"}),
	    "An Dir sind einige Makel zu erkennen. Fass Dir erst einmal an "
            "die eigene Nase.");

  AddDetail( ({"nase"}),
	    "Deine Nase ist zu gross.");

  AddDetail( ({"troll","trolle","krieger","geschoepfe"}),
	    "Trolle sind grosse kraeftige Geschoepfe. Sie sind nicht sehr "
            "intelligent, aber starke Krieger.");
  
  AddDetail( ({"sonne"}),
	    "Die Sonne ist angenehm warm.");

  AddDetail( ({"strasse"}), 
            "Es ist jedoch nur ein gut ausgebauter Weg. Eine Strasse waere "
            "breiter.");

  AddDetail( ({"pflastersteinen","pflastersteine"}),
	    "Die Pflastersteine bilden einen gut ausgebauten Weg. Man kann "
            "sehr gut auf ihm gehen.");

  AddDetail( ({"oberflaeche"}),
	    "Du kannst die Oberflaeche beruehren.");

  AddDetail( ({"linien"}),
	    "Du kannst keine Linien erkennen. Vielleicht findest Du sie auf "
            "eine andere Art.");
  
  AddDetail( ({"art","wege"}),
	    "Es gibt viele Wege, die nach Midas fuehren.");

  AddDetail( ({"midas","hauptstadt","stadt","silberlandes","silberland"}), 
            "Midas ist die Hauptstadt des Silberlandes.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Gras, was in einer Graslandschaft "
                          "nichts ungewoehnliches sein duerfte.");  
 
  AddSmell( ({"gras"}),
	   "Sehr grasig.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind ueber die Hochebene wehen.");

  AddSound( ({"wind"}),
	   "Er weht nur ganz leise.");
  
//-----Details Ende-----
  
AddExit("osten", ROOM "hoch3");
AddExit("westen", ROOM "hoch5");
AddExit("norden", ROOM "hoch20");

AddCmd( ({"beruehr","beruehre" }), "beruehren" );
AddCmd( ({"folg", "folge", "entziffer" }), "folgen" );

}
int beruehren(string str)
{
   if ( member( ({"oberflaeche","flaeche"})
,str) != -1) 
  {
    write(BS ( "Du beruehrst die Oberflaeche der Findlinge und spuerst ganz "
           "feine Linien. Wenn Du ihnen folgst, kannst Du die Linien "
           "vielleicht entziffern.\n"));
    say( TPN+" untersucht die Findlinge.\n");
    return 1;
  }
   return 0;
}
int folgen(string str)
{
   notify_fail("Was moechtest Du folgen oder entziffern?\n");
   if ( member( ({ "linie", "linien" }),str) != -1) 
  {
    write(BS ( "Du folgst mit der Hand den Linien und entdeckst, dass sie "
               "Worte ergeben. Du denkst kurz nach und kommst drauf: "
               "Ich war hier!"));
    write(BS("Irgendwie hast Du etwas geistreicheres erwartet und bist "
               "enttaeuscht."));
    say( TPN+" ist enttaeuscht.\n");
    return 1;
  }
  return 0;
}  
   
