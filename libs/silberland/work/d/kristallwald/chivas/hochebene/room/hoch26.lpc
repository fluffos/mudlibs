// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Du stehst vor einem alten Wachturm. Er scheint aus Granit zu "
        "bestehen und ist komplett schwarz. Die alte Eichentuer des Turms "
        "ist aus den Angeln gerissen und komplett zertruemmert."
        "Kleine Schiessscharten sind auf den verschiedenen Ebenen des Turms "
        "zu erkennen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wachturm","turm","turms"}), 
            "Vor Dir steht ein grosser schwarzer Turm. Er war sicher einmal "
            "ein Wachturm, da man von ihm aus sicher die gesamte Hochebene "
            "und das umliegende Land erblicken kann.");

  AddDetail( ({"granit"}),
	    "Der Turm besteht aus schwarzen Granit. Es muss eine schwere "
            "Arbeit gewesen sein, die grossen Steinquader auf die Hochebene "
            "zu bringen, da hier ja kein Granit zu finden ist.");

  AddDetail( ({"eichentuer","tuer"}),
	    "Die Eichentuer ist aus den Angeln gerissen und liegt teilweise "
            "vor dem Turm und andere Teile liegen sicherlich im Erdgeschoss. "
            "Du kannst, da die Tuer ja nicht mehr da ist, den Turm ohne "
            "Probleme betreten.");

  AddDetail( ({"angeln","mauer"}),
	    "Die Angeln, in denen einmal die Tuer gehangen haben sind "
            "verrostet und haengen lose an der Mauer des Turms.");
  
  AddDetail( ({"schiessscharten","scharten","ziel"}),
	    "Aus den Schiessscharten wird sicher schon lange nicht mehr "
            "geschossen. Du bist recht froh darueber, da Du ansonsten ein "
            "gutes Ziel abgeben wuerdest.");

  AddDetail( ({"ebenen","obergeschoss","aussichtsplattform","plattform"}), 
            "Der Turm hat mehrere Ebenen. Ein Erdgeschoss, ein Obergeschoss "
            "und eine Aussichtsplattform ganz oben.");

  AddDetail( ({"boden"}),
	    "Du erkennst den Weg, der Dich bis zum Turm gefuehrt hat und "
            "einige Stuecke der alten Eichentuer, die komplett zerstoert "
            "wurde.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau. Es gibt nicht besonderes ausser der Sonne "
            "zu sehen und ein paar Wolken am Horizont.");

  AddDetail( ({"wolken","horizont"}),
	    "Die Wolken sind nicht sehr interessant.");

  AddDetail( ({"sonne"}),
	    "Die Sonne ist nicht sehr spannend und wird nur beschrieben, da "
            "Justavius das fehlende Detail gemeldet hat.");

  AddDetail( ({"detail","details"}),
	    "Details zu beschreiben kann ganz schoen nervig sein.");

  AddDetail( ({"justavius"}),
	    "Justavius ist der Lieblingstestie von Chivas.");

  AddDetail( ({"lieblingstestie","testie"}),
	    "Der Weg zum Lieblingstestie ist ein sehr langer.");

  AddDetail( ({"chivas"}),
	    "Chivas ist einer der unnuetzen Magier vom Silberland.");

  AddDetail( ({"magier"}),
	    "Magier sind die NPCs, die immer nur idlen.");

  AddDetail( ({"npcs"}),
	    "NPCs sind manchmal nett und manchmal boese.");

  AddDetail( ({"silberland"}),
	    "Du befindest Dich im Silberland.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Du bist auf der Hochebene von Gorthad und wie es hier aussieht, "
	    "kann man den Weg hier nach Osten verlassen und weiter in "
	    "die Graslandschaft der Hochebene vordringen.");
  
  AddDetail( ({"land"}),
	    "Von ganz oben hat man sicher eine gute Aussicht auf das Land "
            "rings herum.");

  AddDetail( ({"steinquader","quader"}), 
            "Die massiven Steinquader bestehen aus schwarzen Granit.");

  AddDetail( ({"arbeit"}),
	    "Es muss eine schwere Arbeit gewesen sein. Du bist froh, dass Du "
            "nicht helfen musstest.");

  AddDetail( ({"erdgeschoss"}),
	    "Du kannst das Erdgeschoss betreten.");

  AddDetail( ({"graslandschaft"}),
	    "Die Hochebene ist eine weite Graslandschaft.");

  AddDetail( ({"teile","stuecke"}),
	    "An den Stuecken erkennst Du, dass es einmal eine Eichentuer "
            "war.");
  
  AddDetail( ({"weg","richtung"}),
	    "Der Weg fuehrt zurueck in die Richtung wo Du hergekommen bist.");

  AddDetail( ({"probleme"}), 
            "Momentan hast Du eigentlich keine grossen Probleme.");

  AddDetail( ({"aussicht"}),
	    "Wenn Du die Aussicht geniessen willst, dann musst Du schon auf "
            "den Turm.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst die frische Luft.");  
 
  AddSmell( ({"luft"}),
	   "Die Luft ist schoen klar und laesst sich gut einatmen.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind.");

  AddSound( ({"wind"}),
	   "Der Wind rauscht leise ueber die Hochebene.");
  
//-----Details Ende-----
  
AddExit("suedwesten", ROOM "hoch25");
AddExit("norden", ROOM "hocht1");

AddCmd( ({"verlass","verlasse" }), "verlassen" );

}  
int verlassen(string str)
{
   notify_fail("Wohin moechtest Du was verlassen?\n");
   if ( member( ({ "weg nach osten" }),str) != -1) 
  {
    write(BS ( "Du verlaesst den Weg zum Turm und gehst durch das Gras der "
	       "Hochebene nach Osten."));
      TP->move( ORKHOEHLE+"/room/orks10-3", M_GO, 
      "in der Graslandschaft der Hochebene", "verschwindet", 
      "kommt vom Weg in die Graslandschaft gestapft");
    return 1;
  }
  return 0 ;
}   
