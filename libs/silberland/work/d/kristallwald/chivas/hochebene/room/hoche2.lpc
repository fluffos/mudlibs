// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einer steilen Felswand");
  SetProp( P_INT_LONG,
	"Der Pfad ist an dieser Stelle ein wenig breiter und ein paar kleine "
        "verkrueppelte Kiefern haben sich auf dem steinigen Boden festgesetzt. "
        "Die Felswand ist direkt neben Dir und weisst einige kleine Risse "
        "auf." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"pfad"}), 
            "Der Pfad ist hier breiter als weiter oben an der Felswand. Man "
            "kann ohne Probleme die Felswand hoch oder runter gehen.");

  AddDetail( ({"stelle"}),
	    "Hier ist der Pfad angenehm breit.");

  AddDetail( ({"kiefer","kiefern"}),
	    "Kleine verkrueppelte Kiefern haben sich auf dem kargen Steinboden "
            "festgesetzt. Aus ihnen werden nie grosse kraeftige Baeume "
            "werden.");

  AddDetail( ({"boden","steinboden"}),
	    "Der Boden ist hart und steinig. Viel Schutt, der sich von der "
            "Felswand im Laufe der Jahre getrennt hat, liegt hier auf dem "
            "Pfad.");
  
  AddDetail( ({"felswand"}),
	    "Die Felswand fuehrt steil nach oben. Tiefe Risse sind in ihr zu "
            "sehen.");

  AddDetail( ({"risse","rissen"}), 
            "Es gibt tiefe Risse in der Felswand. Einige Moose und Flechten "
            "haben sich in den Rissen festgesetzt.");

  AddDetail( ({"himmel","sonne"}),
	    "Du stehst im Schatten, aber der Himmel ist schoen blau, jedoch "
            "ist die Sonne von hier nicht zu sehen.");

  AddDetail( ({"schatten"}),
	    "Im Schatten ist es immer ein wenig kaelter.");

  AddDetail( ({"baeume"}),
	    "Die Kiefern sind keine richtigen Baeume. Baeume sind weiter "
            "unten zu sehen, wo der Pfad aufhoert.");
  
  AddDetail( ({"laufe","jahre"}),
	    "Es ist schon lange her.");

  AddDetail( ({"schutt"}), 
            "Es sind hauptsaechlich Steine, die sich von der Felswand geloest "
            "haben.");

  AddDetail( ({"steine"}),
	    "Es gibt grosse und kleine Steine, die auf dem Boden liegen.");

  AddDetail( ({"moose","moosen"}),
	    "Die Moose sind schoen gruen.");

  AddDetail( ({"flechten","flechte","lichen","lebensgemeinschaft","pilz","mykobionten","photosynthese","partnern"}),
	    "Als Flechte (Lichen) bezeichnet man eine symbiotische "
            "Lebensgemeinschaft zwischen einem Pilz, dem so genannten "
            "Mykobionten, und einem oder mehreren Photosynthese betreibenden "
            "Partnern.");
  
  AddDetail( ({"hochebene","gorthad"}),
	    "Oberhalb der Felswand ist die Hochebene von Gorthad.");

  AddDetail( ({"probleme"}),
	    "Momentan hast Du keine grossen Probleme.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Moosen");  
 
  AddSmell( ({"moose"}),
	   "Die Moose duften herzhaft.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind, der von der Hochebene weht.");

  AddSound( ({"wind"}),
	   "Der Wind rauscht.");
  
//-----Details Ende-----
  
AddExit("oben", ROOM "hoche3");
AddExit("unten", ROOM "hoche1");

}  
   
