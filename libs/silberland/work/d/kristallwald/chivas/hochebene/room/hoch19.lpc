// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int beeren_zahl;

void create()
	
{
  ::create();

  beeren_zahl=3;

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Der Weg fuehrt stetig bergauf oder bergab. Es kommt auf die Richtung "
        "an aus der Du kommst. Im Norden scheint ein dichter Wald zu beginnen. "
        "Im Sueden geht es weiter auf die Hochebene." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"weg"}), 
            "Der Weg ist mit grossen Pflastersteinen ausgelegt. Es laesst sich "
            "sehr gut auf ihm gehen.");

  AddDetail( ({"richtung"}),
	    "Die Frage ist woher Du kommst.");

  AddDetail( ({"norden","wald"}),
	    "Im Norden scheint ein dunkler Wald zu beginnen.");

  AddDetail( ({"sueden","hochebene"}),
	    "Im Sueden geht es weiter auf die Hochebene. Die Hochebene ist "
            "komplett mit Gras bedeckt. Keine Baeume sind zu sehen.");
  
  AddDetail( ({"boden"}),
	    "Die grossen Pflastersteine am Boden bilden einen guten Weg.");

  AddDetail( ({"sonne"}),
	    "Die Sonne scheint vom Himmel herab.");

  AddDetail( ({"himmel"}), 
            "Der Himmel ist blau. Ein paar weisse Wolken ziehen von Norden "
            "her auf.");

  AddDetail( ({"frage"}),
	    "Eine weitere Frage ist, ob die Beeren an den Straeuchern am "
            "Wegrand schmecken.");

  AddDetail( ({"baeume"}),
	    "Grosse Baeume wachsen im Norden und bilden einen dunklen Wald. "
            "Auf der Hochebene gibt es keine Baeume.");

  AddDetail( ({"pflastersteinen","pflastersteine","steine"}),
	    "Zwischen den grossen Pflastersteinen sind kleine Fugen zu sehen.");
  
  AddDetail( ({"fugen"}),
	    "Die kleinen Fugen sind mit Gras zugewachsen.");

  AddDetail( ({"gras"}),
	    "Hier ist ueberall Gras.");

  AddDetail( ({"wolken"}), 
            "Die Wolken sind weiss und deuten nicht auf Regen hin.");

  AddDetail( ({"regen"}),
	    "Es wird kein Regen geben.");

  AddDetail( ({"straeucher","straeuchern","wegrand"}),
	    "Am Wegrand stehen ein paar kleine Himbeerstraeucher.");

  AddDetail( ({"himbeerstraeucher"}),
	    "An den Straeuchern wachsen ein paar Himbeeren.");
  
  AddDetail( ({"himbeeren","beeren","beere","himbeere"}),
	    "Du kannst sie pfluecken.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst gar nichts.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst den Wind ueber das Gras wehen.");

  AddSound( ({"wind","gras"}),
	   "Das Gras raschelt ein wenig.");
  
//-----Details Ende-----

AddItem( "/d/huegelland/feyaria/weg/npc/dachs", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "hoch19",
          P_MNPC_AREA:({ROOM "hoch19"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("suedoben", ROOM "hoch18");
AddExit("nordunten", ROOM "hochende");

AddCmd( ({"pflueck","pfluecke" }), "pfluecken" );

}
int pfluecken(string str)
{
  object beere;

  notify_fail( "Was moechtest Du pfluecken?\n" );

 if(!str || str == "") return 0;
 if(!(str == "himbeere" ||
      str == "himbeeren" ||
      str == "beere" ||
      str == "beeren" )) return 0;

   {
     if( beeren_zahl < 1 )
     {
        write("Du findest keine Himbeere mehr, die reif genug zum Essen ist.\n");
        say(sprintf("%s findet keine reife Himbeere mehr.\n", TP->Name(WER)));
        return -1;
     }
      if ( beeren_zahl )
      {
        beere = clone_object( "/d/wasser/woody/obj/himbeere");
        write("Du pflueckst eine Himbeere.\n" );
        beeren_zahl=beeren_zahl-1;
        if ( ME_TOO_HEAVY == beere->move(TP,M_GET|M_SILENT) )          {
          write("Die Himbeere ist Dir zu schwer.\n" );
          say(BS(sprintf("%s ist zu schwach eine Himbeere zu pfluecken, "
          "Du koenntest fast Mitleid mit ihm haben.", TP->Name(WER))));
          beere -> remove();
          return 1;
      }
      }
    return 1;
   }
  return 1;
}
   
