// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Du befindest Dich auf der Hochebene von Gorthad. Diese Hochebene ist "
        "durch ihre grossen Huegelgraeber bekannt, wo grosse Helden aus "
        "vergangenen Zeiten koeniglich bestattet wurden. Es heisst auch, dass "
        "es hier spuken soll.\n"
        "Direkt neben dem Weg auf dem Du Dich befindest ist ein grosser "
        "stiller See, der sich ueber die Felsklippe in den unten an der "
        "Felswand befindlichen See ergiesst. Auf der westlichen Seite ist nur "
        "die Graslandschaft der Hochebene zu sehen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"hochebene"}), 
            "Du stehst auf der grossen Hochebene von Gorthad. Der Ausblick ist "
            "beeindruckend.");

  AddDetail( ({"gorthad"}),
	    "Gorthad heisst auf elfisch Huegelgrab. Ein sehr schoener Name "
            "fuer eine Hochebene.");

  AddDetail( ({"huegelgraeber","huegelgrab"}),
	    "Die Huegelgraeber sind weiter im Norden. Von hier kannst Du sie "
            "noch nicht sehen.");

  AddDetail( ({"helden"}),
	    "Grosse Helden liegen hier begraben. Die Geschichte ihres Kampfes "
            "ist nur noch zum Teil ueberliefert.");
  
  AddDetail( ({"zeiten"}),
	    "Die Zeiten der wirklich grossen Helden scheint vorbei zu sein.");

  AddDetail( ({"see","sees"}), 
            "Der See neben Dir plaetschert sanft ans Ufer. Auf der suedlichen "
            "Seite stuerzt er ueber die Felsklippe in den darunter liegenden "
            "See.");

  AddDetail( ({"felsklippe","klippe"}),
	    "Die Felsklippe ist direkt neben Dir.");

  AddDetail( ({"felswand","wand"}),
	    "Die Felswand fuehrt steil nach unten. Ein kleiner Pfad ist direkt "
            "an ihn gepresst.");

  AddDetail( ({"seite"}),
	    "An Deiner westlichen Seite breitet sich die Graslandschaft der "
            "Hochebene aus.");
  
  AddDetail( ({"graslandschaft","landschaft"}),
	    "Die Graslandschaft breitet sich vor Dir aus. Die Graeser wiegen "
            "sich leicht im Wind.");

  AddDetail( ({"ausblick"}), 
            "Der Ausblick ueber die Klippe hinweg ist beeindruckend. Ganz im "
            "Sueden kannst Du die Baumriesen von Roch Adan erkennen.");

  AddDetail( ({"name","namen"}),
	    "Du hast auch einen schoenen Namen.");

  AddDetail( ({"ufer"}),
	    "Die Wellen branden langsam ans Ufer.");

  AddDetail( ({"pfad","rand"}),
	    "Der Pfad fuehrt nach unten an den See am Rand der Felswand.");
  
  AddDetail( ({"baumriesen","riesen","laengen","wald"}),
	    "Die Baumriesen sind so gross, dass sie den uebrigen Wald um "
            "viele Laengen uebertreffen. Man kann sie von der Hochebene gut "
            "erkennen.");

  AddDetail( ({"roch","adan","roch adan","stadt"}), 
            "Roch Adan ist die Stadt der Zentauren.");

  AddDetail( ({"zentauren","geschoepfe"}),
	    "Zentauren sind maechtige Geschoepfe.");

  AddDetail( ({"kampfes","kampf"}),
	    "Es war ein grosser Krieg.");

  AddDetail( ({"krieg","krieges"}),
	    "Die Geschichte des Krieges ist nur bruchstueckhaft bekannt.");
  
  AddDetail( ({"geschichte","teil","nomaden"}),
	    "Es ging, so ist heute noch ueberliefert, um den Kampf zwischen "
            "den Orks der noerdlichen Gefilde und den Menschen, die zu der "
            "Zeit hier als Nomaden gelebt haben.");

  AddDetail( ({"zeit"}), 
            "Die Zeit ist lange her.");

  AddDetail( ({"gefilde","unwesen","norden"}),
	    "In den noerdlichen Gefilde haben damals viele Orks ihr Unwesen "
            "getrieben.");

  AddDetail( ({"orks","ork"}),
	    "Die Orks haben damals im Norden gelebt. Vielleicht leben sie "
            "dort immer noch.");

  AddDetail( ({"himmel"}),
	    "Einige Voegel kreisen hoch oben am blauen Himmel.");

  AddDetail( ({"sonne"}),
	    "Die Sonne steht fast senkrecht am Himmel und waermt Dich ein "
            "wenig.");
  
  AddDetail( ({"voegel"}),
	    "Sie kreisen zu hoch um zu erkennen, was fuer Voegel es sind.");

  AddDetail( ({"wind"}), 
            "Der Wind bewegt sanft die Graeser auf der Hochebene.");

  AddDetail( ({"boden"}),
	    "Du stehst auf einem gepflasterten Weg.");

  AddDetail( ({"weg"}),
	    "Der Weg fuehrt weiter in die Hochebene. Obwohl der Weg schon sehr "
            "alt ist, ist er noch in einem sehr guten Zustand.");

  AddDetail( ({"zustand"}),
	    "Die Pflastersteine sind kaum verschoben und sind nur ein wenig "
            "ausgetreten.");
  
  AddDetail( ({"pflastersteine","steine","pflastersteinen"}),
	    "Die Pflastersteine wurden vor Jahrhunderten zu diesem Weg "
            "ausgelegt Zwischen ihnen sind ein paar Grashalme zu sehen.");

  AddDetail( ({"grashalme","halme","grashalmen"}),
	    "Ein paar Grashalme sind zwischen den Pflastersteinen zu sehen. "
            "An den Grashalmen ist nichts zu entdecken. Tut mir leid.");

  AddDetail( ({"jahrhunderten","jahrhunderte"}),
	    "Das ist sehr lange her.");

  AddDetail( ({"wellen"}),
	    "Die Wellen plaetschern ans Ufer des Sees.");

  AddDetail( ({"menschen"}),
	    "Es sind nur Menschen auf der Hochebene von Gorthad begraben.");

  AddDetail( ({"graeser"}),
	    "Die Graeser der Graslandschaft wachsen nicht sehr hoch.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es duftet nach Gras");  
 
  AddSmell( ({"gras"}),
	   "Das Gras der Hochebene duftet herrlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wasserfall rauschen.");

  AddSound( ({"wasserfall"}),
	   "Der Wasserfall rauscht die Felswand hinunter.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "hoch2");
AddExit("suedostunten", ROOM "hochst");

}  
   
