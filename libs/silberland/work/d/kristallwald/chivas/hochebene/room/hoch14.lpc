// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl=1;

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Die Anzahl der Huegelgraeber nimmt ab. Im Sueden sind mehr zu "
        "sehen als hier im Norden der Hochebene. Zu beiden Seiten des "
        "Weges sind noch zwei Graeber zu sehen und Richtung Norden breitet "
        "sich vor Dir die grosse Grasflaeche der Ebene von Gorthad aus." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"anzahl"}), 
            "Die Anzahl der Huegelgraeber nimmt in Richtung Norden ab. Im "
            "Sueden sind mehr Graeber zu sehen.");

  AddDetail( ({"huegelgraeber","graeber"}),
	    "Zu beiden Seiten sind die letzten Huegelgraeber zu sehen. Sie "
            "sind mit kleinen weissen Blumen und Gras bedeckt.");

  AddDetail( ({"sueden"}),
	    "Im Sueden siehst Du lauter grosse Huegelgraeber.");

  AddDetail( ({"richtung"}),
	    "Du musst Dich halt fuer eine Richtung entscheiden.");

  AddDetail( ({"norden"}),
	    "Im Norden erstreckt sich die weite Graslandschaft der Hochebene.");
  
  AddDetail( ({"hochebene","gorthad","ebene"}),
	    "Du bist auf der weiten Hochebene von Gorthad.");

  AddDetail( ({"seiten"}), 
            "Zu beiden Seiten sind zwei grosse Huegelgraeber zu sehen.");

  AddDetail( ({"grasflaeche","graslandschaft","landschaft","gras"}),
	    "Die weite Graslandschaft erstreckt sich vor Deinen Augen.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit grossen Pflastersteinen ausgelegt, die einen "
            "stabilen Weg bilden.");

  AddDetail( ({"himmel","sonne"}),
	    "Der Himmel ist schoen blau und die Sonne laechelt Dich an.");
  
  AddDetail( ({"augen"}),
	    "Du hast schoene Augen.");

  AddDetail( ({"blumen"}), 
            "Die weissen Blumen wachsen nur auf den Huegelgraebern. Zwischen "
            "den Blumen erkennst Du zwei Steintafeln.");

  AddDetail( ({"pflastersteinen","pflastersteine","steine","steinen","grashalm","halm"}),
	    "Die Pflastersteine sind recht gross und bilden einen sehr gut "
            "ausgebauten Weg. Kein Grashalm waechst zwischen den Steinen.");

  AddDetail( ({"weg"}),
	    "Der Weg fuehrt von Norden nach Sueden ueber die Hochebene.");

  AddDetail( ({"steintafeln"}),
	    "Auf der westlichen Seite ist eine schwarze Granittafel zu sehen "
            "und auf der linken eine ganz normale aus Sandstein.");
  
  AddDetail( ({"granittafel"}),
	    "Die Granittafel hatte schon einmal bessere Tage gesehen. Sie "
            "ist recht matt, aber Du kannst sie noch lesen.");

  AddDetail( ({"sandsteintafel","sandstein"}), 
            "Der Sandstein hat unter den Jahrhunderten ein wenig gelitten, "
            "trotzdem kannst Du die Sandsteintafel noch lesen.");

  AddDetail( ({"jahrhunderten","jahrhunderte"}),
	    "Das ist sehr lange her.");

  AddDetail( ({"tage"}),
	    "Tage wie dieser sind schoen.");

  AddDetail( ({"seite"}),
	    "Es gibt viele Seiten.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen auf den Huegelgraebern duften suesslich.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind ueber die Hochebene rauschen.");

  AddSound( ({"wind"}),
	   "*rausch*");
  
  AddReadDetail( ({"granittafel"}),
		"+--------------------------------+\n"
                "|                                |\n"
                "|    Grosnak, der Ordentliche    |\n"
                "|                                |\n"
                "+--------------------------------+\n"
                "Da die Tafel sehr matt ist, koennte man die Tafel ja "
                "ein wenig polieren, was auch zu dem ordentlichen Besitzer "
                "des Huegelgrabes passen wuerde.");

  AddReadDetail( ({"sandsteintafel"}),
		"+--------------------------------+\n"
                "|                                |\n"
                "|    Mandred, der Berserker      |\n"
                "|                                |\n"
                "+--------------------------------+\n");

//-----Details Ende-----
  
AddExit("suedwesten", ROOM "hoch13");
AddExit("nordwesten", ROOM "hoch15");

AddCmd( ({"polier","poliere" }), "polieren" );

}
void reset()
	
{
  ::reset();
  anzahl=1; 
}

int polieren(string str)
{
 notify_fail("Was willst Du polieren?\n");

 if(!str || str == "") return 0;
 if(!(str == "granittafel" )) return 0;
 

 if( str == "granittafel"){
    
  if(anzahl < 1)

  {
	  
  write(BS("Da die Granittafel bereits poliert ist, nuetzt es nicht viel "
           "sie noch einmal zu polieren.\n"));
 
  say(TPN+" arglt ein wenig.\n");
  return 1;
  }
  else
  {
  write(BS("Du polierst ein wenig die Granittafel von 'Grosnak, dem "
           "Ordentlichen' und ploetzlich klappt die Tafel zur Seite und ein "
           "Eingang in das Huegelgrab oeffnet sich."));
 
  say(BS(TPN+" poliert Etwas und ein Durchgang in das westliche Huegelgrab "
          "oeffnet sich."));
  AddExit("westen", ROOM "hg2-1");
  anzahl--;
  return 1;
 }
 }
}

