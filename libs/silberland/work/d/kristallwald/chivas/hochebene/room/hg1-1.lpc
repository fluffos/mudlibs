// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Huegelgrab");
  SetProp( P_INT_LONG,
	"Dies scheint ein Vorraum des Grabes zu sein. Die Grabkammern selbst "
        "befinden sich weiter oestlich. Es sind anscheinend drei Kammern. Die "
        "Waende innerhalb des Huegelgrabes bestehen aus Stein. Die Erde wurde "
        "anscheinend spaeter um die Steingraeber aufgeschuettet." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 0 );

//-----Details Anfang-----
  
  AddDetail( ({"vorraum"}), 
            "Du stehst im Vorraum eines grossen Huegelgrabes.");

  AddDetail( ({"grab","grabes"}),
	    "Das Grab wurde anscheinend von Grabraeubern ausgeraubt. Sie haben "
            "sicher auch das Loch in der Westwand gegraben.");

  AddDetail( ({"grabkammern","kammern"}),
	    "Die Grabkammern liegen im Osten.");

  AddDetail( ({"waende","wand"}),
	    "Die Waende bestehen aus massiven Stein. In der Westwand ist ein "
            "grosses Loch und nach Osten geht es weiter in die Grabkammern.");
  
  AddDetail( ({"decke"}),
	    "An der Decke haengen grosse Spinnenweben.");

  AddDetail( ({"boden"}), 
            "Der Boden besteht aus grossen Steinplatten.");

  AddDetail( ({"huegelgrabes","huegelgrab","huegelgraeber"}),
	    "Du bist in einem Huegelgrab.");

  AddDetail( ({"stein"}),
	    "Die Waende bestehen aus massiven Stein. Verschiedene "
            "Schriftzeichen sind zu erkennen.");

  AddDetail( ({"erde","steingraeber"}),
	    "Die Huegelgraeber scheinen Steingraeber zu sein, um die Erde "
            "angefuellt wurde.");
  
  AddDetail( ({"himmel"}),
	    "Einen Himmel gibt es hier drinnen nicht.");

  AddDetail( ({"osten"}), 
            "Im Osten sind die Grabkammern.");

  AddDetail( ({"westwand","loch"}),
	    "In der Westwand ist das grosse Loch, durch das Du das Huegelgrab "
            "betreten hast.");

  AddDetail( ({"spinnenweben"}),
	    "Die Spinnenweben sind alt und verlassen.");

  AddDetail( ({"steinplatten","platten"}),
	    "Es sind grosse dicke Steinplatten, die den Boden bilden.");
  
  AddDetail( ({"schriftzeichen"}),
	    "Die Schriftzeichen sind kaum noch zu entziffern. Schade.");

  AddDetail( ({"grabraeubern","grabraeuber","raeuber"}), 
            "Die Grabraeuber sind schon vor langer Zeit verschwunden.");

  AddDetail( ({"zeit"}),
	    "Es ist schon sehr lange her.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Moder.");  
 
  AddSmell( ({"moder"}),
	   "Der Moder eines typischen Grabes-");

  AddSound(DEFAULT_SOUND, "Es ist totenstill.");

//-----Details Ende-----
  
AddExit("nordosten", ROOM "hg1-3");
AddExit("suedosten", ROOM "hg1-4");
AddExit("osten", ROOM "hg1-2");
AddExit("westen", ROOM "hoch12");

}  
   
