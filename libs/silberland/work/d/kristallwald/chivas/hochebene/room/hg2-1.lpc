// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Huegelgrab");
  SetProp( P_INT_LONG,
	"Die Vorkammer des Huegelgrabes ist sauber und aufgeraeumt. Es findet "
        "sich kein Staub auf dem Boden oder irgendwelche Spinnenweben an der "
        "Decke. Es sieht so aus, als ob hier Jemand regelmaessig zu putzen "
        "scheint, was unmoeglich ist, da seit Jahrhunderten kein Lebewesen "
        "dieses Grab betreten hat." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"vorkammer","kammer"}), 
            "Du stehst in der Vorkammer eines Huegelgrabes. An den Waenden "
            "haengen sogar Fackeln, die komischerweise immer noch brennen. "
            "Jedoch sieht das ganze Grab so aus, als ob hier oft Jemand "
            "vorbei schaut, da die ganze Kammer sauber und geputzt "
            "aussieht.");

  AddDetail( ({"huegelgrabes","huegelgrab","grab"}),
	    "Du bist in einem Huegelgrab.");

  AddDetail( ({"staub","staubkorn"}),
	    "Es ist kein Staub zu erkennen. Normalerweise erwartet man sowas "
            "in einem Grab, das schon seit Jahrhunderten keiner mehr betreten "
            "hat.");

  AddDetail( ({"boden","bodens"}),
	    "Der Boden ist sauber, nicht ein Staubkorn ist zu sehen. Er sieht "
            "so aus, als ob des oefteren hier geputzt wird. Die grossen "
            "Steinplatten des Bodens sind tadellos sauber und man kann sich "
            "in ihnen spiegeln.");
  
  AddDetail( ({"spinnenweben"}),
	    "Es sind keine Spinnenweben zu sehen. Anscheinend entfernt Jemand "
            "diese regelmaessig.");

  AddDetail( ({"decke"}), 
            "Die Decke besteht wie die Waende und der Boden aus grossen "
            "Steinplatten.");

  AddDetail( ({"jemand"}),
	    "Du weisst nicht wer der Jemand ist, der hier regelmaessig "
            "aufzuraeumen scheint.");

  AddDetail( ({"jahrhunderten","jahrhunderte"}),
	    "Sicher hat seit Jahrhunderten keiner mehr das Grab betreten.");

  AddDetail( ({"lebewesen"}),
	    "Es gibt viele Lebewesen im Silberland.");
  
  AddDetail( ({"wand","waenden","waende"}),
	    "An den Waenden haengen Fackeln, die die Kammer ein wenig "
            "erhellen.");

  AddDetail( ({"fackeln"}), 
            "Die Fackeln scheinen erst vor kurzem aufgehaengt worden zu sein. "
            "Sie leuchten in einem roten Schein und erhellen die Kammer ein "
            "wenig.");

  AddDetail( ({"steinplatten","platten"}),
	    "Die grossen Steinplatten sind glatt und sauber. Man kann sich "
            "sogar in ihnen spiegeln. Du erkennst Deine grosse Nase und bist "
            "der Meinung, dass die Platten das Spiegelbild sicher "
            "verzerren.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland.");

  AddDetail( ({"schein","licht"}),
	    "Der Schein spendet Dir ein wenig Licht, so dass Du alles gut "
            "sehen kannst.");
  
  AddDetail( ({"spiegelbild","nase","meinung"}),
	    "Das Spiegelbild muss verzerrt sein, da Du deine Nase nicht so "
            "gross in Erinnerung hast. Falls sie doch so gross ist, solltest "
            "Du vielleicht ueber eine Schoenheitsoperation nachdenken.");

  AddDetail( ({"schoenheitsoperation","operation"}), 
            "Schoenheitsoperationen gibt es im Silberland leider nicht, Du "
            "wirst wohl damit leben muessen.");

  AddDetail( ({"erinnerung","erinnerungen"}),
	    "Erinnnerungen sind was gutes.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht hier absolut sauber und reinlich.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst das Flackern der Fackeln.");

  AddSound( ({"fackeln","flackern"}),
	   "Die Fackeln flackern ein wenig und machen ein leises Geraeusch.");
  
  AddSound( ({"geraeusch"}),
	   "Es ist fast einschlaefernd.");

//-----Details Ende-----
  
AddExit("westen", ROOM "hg2-2");
AddExit("osten", ROOM "hoch14");

}  
   
