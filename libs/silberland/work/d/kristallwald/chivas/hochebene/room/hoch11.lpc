// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int raeuberda;

void create()
	
{
  ::create();

  raeuberda=1; 

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Der Weg schlaengelt sich immer weiter zwischen den impulsanten "
        "Huegelgraebern. Aber obwohl Du zwischen Graebern stehst hast Du "
        "kein mulmiges Gefuehl. Du fuehlst Dich momentan recht sicher und "
        "der Frieden der hier herrscht, beruhigt Dich." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"weg","weges"}), 
            "Der Weg fuehrt zwischen den Huegelgraebern hindurch.");

  AddDetail( ({"huegelgraebern","huegelgraeber","graeber","graebern"}),
	    "Die Huegelgraeber sind sehr gross und impulsant. Sie sind in "
            "diesem Teil der Hochebene wirklich riesig. Sie sind mit Gras und "
            "kleinen Blumen bewachsen. Im Schatten eines der Huegelgraeber "
            "bewegt sich Etwas.");

  AddDetail( ({"gefuehl"}),
	    "Vielleicht waere ein mulmiges Gefuehl zwischen solchen Graebern "
            "besser.");

  AddDetail( ({"frieden"}),
	    "Der Frieden der hier herrscht, kann Dich auch taeuschen.");
  
  AddDetail( ({"boden"}),
	    "Der Boden ist mit grossen Steinen gepflastert. Nur ein wenig Gras "
            "waechst in den Ritzen.");

  AddDetail( ({"himmel","sonne"}), 
            "Der Himmel ist blau. Nur ein paar Wolken ziehen von Norden her "
            "auf und werden bald die Sonne verdecken.");

  AddDetail( ({"wolken","norden","regen"}),
	    "Die Wolken, die von Norden her aufziehen sind schoen weiss und "
            "verheissen keinen Regen.");

  AddDetail( ({"ritzen"}),
	    "Zwischen den Steinen des Weges waechste ein wenig Gras.");

  AddDetail( ({"huegelgrab","huegelgrabs"}),
	    "Im Schatten eines Huegelgrabs scheint Etwas zu sein.");

  AddDetail( ({"steinplatten","steintafeln","tafeln","platten"}),
	    "Die Steinplatten sind eher Steintafeln, auf denen die Namen der "
            "hier begrabenen Helden stehen.");

  AddDetail( ({"namen","helden"}),
	    "Die Namen der Helden sind auf den Steintafeln verewigt. Du kannst "
            "die Namen lesen.");

  AddDetail( ({"gras"}),
	    "Es waechst Gras auf der gesamten Hochebene, auf den "
            "Huegelgraebern und ein wenig zwischen den Steinen des Weges. Im "
            "Gras auf den Huegelgraebern sind Steinplatten eingelassen.");
  
  AddDetail( ({"steine","steinen","pflastersteine"}),
	    "Die grossen Pflastersteine bilden einen gut begehbaren Weg.");

  AddDetail( ({"hochebene","teil","gorthad"}), 
            "Du bist auf der Hochebene von Gorthad.");

  AddDetail( ({"schatten","etwas"}), 
            "Im Schatten eines Huegelgrab scheint sich eine Gestalt zu "
            "bewegen. ");

  AddDetail( ({"gestalt"}), 
            "Du weisst nicht genau, was das fuer eine Gestalt ist. Du "
            "koenntest Dich ja einmal laut raeuspern. Vielleicht wird sie "
            "dadurch auf Dich aufmerksam.");

  AddDetail( ({"blumen"}),
	    "Die kleinen weissen Blumen sind nur auf den Graebern zu sehen "
            "und nicht in der restlichen Graslandschaft der Hochebene.");

  AddDetail( ({"graslandschaft","landschaft"}),
	    "Die Graslandschaft wird nur durch die Huegelgraeber "
            "unterbrochen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen auf den Graebern riechen suesslich.");

  AddSound(DEFAULT_SOUND, "Du hoerst nur den Wind.");

  AddSound( ({"wind"}),
	   "Der Wind rauscht leise ueber die Hochebene.");

  AddReadDetail( ({"namen"}),
		"Auf der Steintafel auf dem westlichen Huegelgrab steht: \n"
                "Chodgar, der kraeftige Axtschwinger\n"
                " \n"
                "Auf der Steintafel auf dem oestlichen Huegelgrab steht;\n"
                "Rethnar, der maechtige Schwertkaempfer\n"
                " \n"
                "Es muessen zwei maechtige Krieger gewesen sein, dass sie auf "
                "diesen Tafeln verewigt wurden und sie in diesen "
                "Huegelgraebern bestattet wurden.");

  
//-----Details Ende-----
  
AddExit("nordwesten", ROOM "hoch12");
AddExit("suedosten", ROOM "hoch10");

AddCmd( ({"raeusper" }), "raeuspern" );

}
void reset()
{
  ::reset();
  raeuberda=1;
}
int raeuspern(string str)
{
   object raeuber;
   notify_fail("Was moechtest Du tun? Wolltest Du Dich nicht laut raeuspern?\n");
   if ( member( ({ "laut" }),str) == -1) 
     return 0;

  if (present("grabraeuber",TO) || !raeuberda)

  {
  write(BS("Du raeusperst Dich laut, aber die Gestalt, die Du eben noch "
           "gesehen hast, verzieht sich weiter in den Schatten des "
           "Huegelgrabs und verschwindet."));
  return -1;
  }
  write(BS("Du raeusperst Dich laut und eine grimmig drein schauende Gestalt "
           "tritt aus dem Schatten auf Dich zu."));
  raeuberda=0;
  raeuber=clone_object (NPC "grabraeuber" );
  raeuber->move(TO,M_GO|M_NOCHECK,"stapft herein.");
   return 1;
  }

