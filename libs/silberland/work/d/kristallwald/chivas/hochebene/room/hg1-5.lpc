// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Huegelgrab");
  SetProp( P_INT_LONG,
	"Die Grabkammer des Koenigs scheint unberuehrt zu sein. Der Sarkophag "
        "ist heil und eine dicke Staubschicht liegt auf ihr. An den Waenden "
        "stehen goldene Grabbeigaben und andere Geschenke, die man dem Toten "
        "auf seine letzte Reise mitgegeben hat." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 0 );
  
//-----Details Anfang-----
  
  AddDetail( ({"grabkammer","kammer","grab"}), 
            "Die Grabkammer des Koenigs ist noch komplett unberuehrt.");

  AddDetail( ({"koenig","koenigs","ueberreste"}),
	    "Die sterblichen Ueberreste des Koenigs liegen sicher "
            "in dem Sarkophag.");

  AddDetail( ({"sarkophag"}),
	    "Der Sarkophag besteht aus schwarzen Granit und ist mit lauter "
            "Symbolen verziert. Auf der Grabplatte liegt eine dicke "
            "Staubschicht.");

  AddDetail( ({"staubschicht","staub","schicht","menge"}),
	    "Es liegt eine dicke Staubschicht auf dem Sarkophag. Ausserdem "
            "ist es in der ganzen Grabkammer recht staubig.");
  
  AddDetail( ({"waende","waenden","wand"}),
	    "An den Waenden, die aus Stein bestehen, sind Halterungen fuer "
            "Fackeln zu sehen und lauter Grabbeigaben und Geschenke, die dem "
            "Toten mit ins Grab gelegt wurden.");

  AddDetail( ({"grabbeigaben","beigaben"}), 
            "Es sind lauter goldene Grabbeigaben. Sie reichen von kleinen "
            "Statuen ueber kunstvolle Ruestungen und herrliche Waffen.");

  AddDetail( ({"geschenke"}),
	    "Auf den Geschenken steht leider nicht Dein Name, also "
            "darfst Du auch keins mitnehmen.");

  AddDetail( ({"tote","toten"}),
	    "Der Tote, hier in der Grabkammer, wird wohl der Koenig sein.");

  AddDetail( ({"reise"}),
	    "Diese Reise moechtest Du noch nicht antreten.");
  
  AddDetail( ({"boden"}),
	    "Am Boden ist wie auf dem Sarkophag eine Menge Staub zu sehen.");

  AddDetail( ({"himmel"}), 
            "Der Himmel wird in einem Grab mit Dach Decke genannt.");

  AddDetail( ({"decke","dach"}),
	    "Die Decke besteht wie die Waende und der Boden, der jedoch unter "
            "einer dicken Staubschicht versteckt ist, aus Stein. Ansonsten "
            "ist die Decke kahl und uninteressant.");

  AddDetail( ({"symbolen","symbole"}),
	    "Die Symbole sind in den Granit des Sarkophags geritzt und wurden "
            "dann mit Mithril ausgefuellt. Sie sehen fantastisch aus, obwohl "
            "Du sie nicht verstehst.");
  
  AddDetail( ({"grabplatte","platte","frieden"}),
	    "Die Grabplatte ist mit einer dicken Staubschicht bedeckt. Sie "
            "ist unversehrt. Der Koenig kann in Frieden ruhen.");

  AddDetail( ({"granit","gestein"}), 
            "Granit ist ein schwarzes und sehr hartes Gestein. Da es keinen "
            "Granit auf der Hochebene gibt, muss er von weit her geschafft "
            "worden sein.");

  AddDetail( ({"ruestungen"}),
	    "Die Ruestungen sehen sehr wertvoll aus. Sie bestehen aus "
            "Mithril und Gold. Da Du die Toten ehrst, laesst Du sie jedoch "
            "liegen.");

  AddDetail( ({"statuen","krieger"}),
	    "Die Statuen stellen anscheinend verschiedene Krieger dar. Sie "
            "bestehen aus Gold und anderem Material.");

  AddDetail( ({"waffen","waffe"}),
	    "Du erkennst ein grosses Breitschwert und eine grosse Axt.");
  
  AddDetail( ({"halterungen"}),
	    "Die Halterungen haengen an den Waenden und einige alte "
            "Spinnenweben sind daran zu erkennen.");

  AddDetail( ({"fackeln"}), 
            "Die Fackeln in den Halterungen sind schon lange verloschen.");

  AddDetail( ({"stein"}),
	    "Es ist wirklich unglaublich, die Waende, die Decke und vielleicht "
            "auch der Boden unter der Staubschicht bestehen aus echtem Stein. "
            "Du bist ganz entzueckt.");

  AddDetail( ({"mithril"}),
	    "Mithril ist sehr teuer.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Du bist auf der Hochebene von Gorthad.");
  
  AddDetail( ({"spinnenweben"}),
	    "Die Spinnenweben sind schon lange verlassen.");

  AddDetail( ({"gold","metall"}), 
            "Gold ist ein wertvolles Metall.");

  AddDetail( ({"material"}),
	    "Es scheint Mithril, Silber, Kupfer und Bronze zu sein, wenn Du "
            "es genau wissen willst.");

  AddDetail( ({"silber","kupfer","bronze"}),
	    "Silber, Kupfer und Bronze sind nicht so wertvoll wie Mithril "
            "oder Gold.");

  AddDetail( ({"breitschwert","schwert","legierungen"}),
	    "Das Schwert ist eine grosse zweihaendige Waffe. Es scheint aus "
            "Mithril und andere Legierungen zu bestehen. Es scheint sehr "
            "schwer zu sein, darum laesst Du es lieber stehen.");
  
  AddDetail( ({"axt","schneiden","farbe"}),
	    "Die Axt hat zwei Schneiden und hat eine tiefschwarze Farbe. "
            "Auf dem Axtblatt sind silberne Runen der Macht eingraviert und "
            "eine magische Aura scheint die Axt zu umgeben. Sie besitzt sicher "
            "eine herrliche Kampfkraft. Willst Du sie etwa mitnehmen?");

  AddDetail( ({"axtblatt"}),
	    "Das Axtblatt ist mit silbernen Runen geschmueckt. Es sieht "
            "gefaehrlich und scharf aus.");

  AddDetail( ({"runen","macht","kaempfer","kampf"}),
	    "Die Runen strahlen eine magische Macht aus. Sie unterstuetzten "
            "sicher den Kaempfer mit Magie im Kampf.");

  AddDetail( ({"aura","magie"}),
	    "Du spuerst geradezu die Magie der Axt.");

  AddDetail( ({"nase"}),
	    "Du hast eine sehr grosse Nase.");

  AddDetail( ({"name"}),
	    "Du hast auch einen.");

  AddDetail( ({"kampfkraft","gegner"}),
	    "Mit der Axt kann man sicher jeden Gegner zerstaeuben.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Der Staub kitzelt in der Nase.");  
 
  AddSmell( ({"staub"}),
	   "Du musst niesen.");

  AddSound(DEFAULT_SOUND, "Es ist sehr still in der Grabkammer.");

  AddSound( ({"grabkammer"}),
	   "Es ist still.");
  
//-----Details Ende-----
AddItem(NPC "crogan", REFRESH_DESTRUCT);
  
AddExit("westen", ROOM "hg1-2");

AddCmd( ({"nehme", "nimm" }), "nehmen" );

}
int nehmen(string str)
{
   if ( member( ({"axt","axt mit"})
,str) != -1) 
  {
    write( BS("Als Du die Axt an Dich nehmen willst, erscheint Kronang in \n"
              "einem lauten Knall neben Dir."));
    write( BSA("Wenn Du Berserker bist und Stufe 15 erreicht "
              "hast, kannst Du wieder kommen und diese Axt soll Dein sein. "
              "Bis dahin, schleich Dich!!!", "Kronang sagt: "));

    write(BS("Daraufhin verschwindet Kronang wieder in einer Rauchwolke."));
    say( BS(TPN+" spricht kurz mit Kronang, der daraufhin sofort wieder "
             "verschwindet."));
    return 1;
  }
  return 0;
}

