// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Huegelgrab");
  SetProp( P_INT_LONG,
	"Das Huegelgrab in dem Du stehst, scheint von Grabraeubern unberuehrt "
        "zu sein. Es liegt eine dicke Staubschicht am Boden und lauter alte "
        "Spinnenweben haengen von der Decke. Diesen Ort hat seit langer Zeit "
        "keiner mehr betreten. Nach Westen scheint man in die Grabkammer zu "
        "gelangen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 0 );

//-----Details Anfang-----
  
  AddDetail( ({"huegelgrab","grab","wunder"}), 
            "Es ist ein Wunder, das Grab ist absolut unberuehrt. Die einzigen "
            "Lebewesen, die vor Dir hier waren, sind wohl ein paar kleine "
            "Spinnen, die aber auch vor langer Zeit das Huegelgrab verlassen "
            "haben.");

  AddDetail( ({"grabraeuber","grabraeubern"}),
	    "Noch kein Grabraeuber hat das Grab geschaendet. Du freust Dich "
            "ein unberuehrtes Grab gefunden zu haben.");

  AddDetail( ({"staubschicht","staub","schicht"}),
	    "Eine dicke Staubschicht ist am Boden. Deine eigenen Fussspuren "
            "sind sehr gut zu erkennen.");

  AddDetail( ({"boden","jahrhunderten"}),
	    "Eine dicke Staubschicht bedeckt den Boden. Es war seit "
            "Jahrhunderten keiner mehr in diesem Huegelgrab.");
  
  AddDetail( ({"spinnenweben"}),
	    "Die Spinnenweben sind verlassen und haengen traege von der Decke "
            "herunter.");

  AddDetail( ({"decke"}), 
            "Die Decke besteht wie die Waende aus Stein. An ihr haengen einige "
            "alte Spinnenweben. Ansonsten ist sie schmucklos.");

  AddDetail( ({"ort"}),
	    "Du bist in einem der Huegelgraeber der Hochebene.");

  AddDetail( ({"zeit"}),
	    "Es ist schon sehr lange her.");

  AddDetail( ({"westen","grabkammer","kammer"}),
	    "Dies scheint nur eine Vorkammer zu sein. Die richtige Grabkammer "
            "ist weiter im Westen.");
  
  AddDetail( ({"lebewesen","spinnen"}),
	    "Die Spinnen sind schon lange weg. Sie haben nur ihre Spinnenweben "
            "zurueck gelassen.");

  AddDetail( ({"fussspuren","abdruecke"}), 
            "Du hinterlaesst eindeutige Abdruecke im Staub.");

  AddDetail( ({"huegelgraeber"}),
	    "Es gibt viele Huegelgraeber auf der Hochebene von Gorthad. Du "
            "befindest Dich in einem.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Du bist in einem Huegelgrab auf der Hochebene von Gorthad.");

  AddDetail( ({"waende","waenden","wand"}),
	    "An den Waenden haengen ein paar verloschene Fackeln in "
            "goldenen Halterungen. Ansonsten siehst Du nur den blanken Stein, "
            "aus dem das Grab besteht.");
  
  AddDetail( ({"vorkammer"}),
	    "Die Vorkammer ist leer. Hier gibt es nicht viel zu entdecken. Die "
            "Grabkammer ist vielleicht interessanter.");

  AddDetail( ({"stein","inneren"}), 
            "Das Grab besteht in seinem Inneren aus Stein. Die Erde, die man "
            "von aussen sieht, wurde anscheinend anschliessend auf das Grab "
            "geschuettet.");

  AddDetail( ({"fackeln","licht"}),
	    "Die Fackeln sind alt und brennen nicht mehr. Du brauchst es gar "
            "nicht erst zu probieren sie anzuzuenden. Sie werden nie mehr "
            "Licht spenden.");

  AddDetail( ({"halterungen"}),
	    "Die goldenen Halterungen, in denen die verloschenen Fackeln "
            "stecken, sind reich verziert. Sie haben sicher einen grossen "
            "Wert.");

  AddDetail( ({"erde"}),
	    "Hier im Grab siehst Du keine Erde.");
  
  AddDetail( ({"wert"}),
	    "Der Wert ist schon durch das Gold sehr hoch. Durch die "
            "Verzierungen sind sie sicher noch teurer und ein richtiges "
            "Meisterwerk.");

  AddDetail( ({"verzierungen"}), 
            "Die Verzierungen bestehen hauptsaechlich aus kleinen Linien und "
            "Kreisen. Auch ein paar Symbole sind zu erkennen.");

  AddDetail( ({"meisterwerk"}),
	    "Es sieht aus, als ob es sich um eine Schmiedekunst der Zwerge "
            "handelt.");

  AddDetail( ({"linien","kreisen","kreise"}),
	    "Wenn man laenger auf die Kreise und Linien schaut, wird man "
            "schnell ganz wirr im Kopf. Du wendest Dich leicht verstoert ab.");

  AddDetail( ({"symbole"}),
	    "Die Symbole bedeuten, dass man die Ruhe der Toten nicht stoeren "
            "sollte und derjenige, der sie stoert soll verfluecht sein. So "
            "einen Fluch in einem Grab sollte man nicht unterschaetzen.");
  
  AddDetail( ({"schmiedekunst","zwerge","koennen","metallverarbeitung"}),
	    "Die Zwerge sind fuer ihr Koennen bei der Metallverarbeitung "
            "silberlandweit beruehmt.");

  AddDetail( ({"kopf","anschauen"}), 
            "Es scheint so als ob sich die Linien und Kreise bei laengerem "
            "Anschauen zu bewegen scheinen. Es macht auf Dich den Eindruck, "
            "als ob eine Art von Magie auf ihnen zu liegen scheint.");

  AddDetail( ({"eindruck","art","magie"}),
	    "Es ist sicher eine uralte Magie, worueber das Wissen schon "
            "laengst verschollen ist.");

  AddDetail( ({"ruhe","toten","tote"}),
	    "Die Ruhe der Toten zu stoeren waere sehr gefaehrlich, wenn "
            "ein Fluch Dich dann treffen kann.");

  AddDetail( ({"wissen"}),
	    "Es kann jedoch sein, dass nicht alles verloren ist. Frag doch "
            "mal den Bibliothekar von Roch Adan nach 'Magie im Huegelgrab'.");
  
  AddDetail( ({"bibliothekar"}),
	    "Der Bibliothekar von Roch Adan ist bekannt fuer sein Wissen "
            "ueber vergangene Zeiten.");

  AddDetail( ({"roch","adan","roch adan","zentauren","stadt"}),
	    "Roch Adan ist eine Stadt im Silberland. In ihr leben die "
            "Zentauren.");
  
  AddDetail( ({"silberland"}),
	    "Du bist im Silberland.");

  AddDetail( ({"fluch","warnung"}),
	    "Eine solche Warnung sollte man nicht unterschaetzen.");
  
  AddDetail( ({"gold"}),
	    "Gold ist sehr wertvoll. Die Halterungen bestehen aus Gold.");

  AddDetail( ({"nase"}),
	    "Du hast eine sehr grosse Nase.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es ist staubig.");  
 
  AddSmell( ({"staub"}),
	   "Wenn Du einatmest, kitzelt Deine Nase und Du musst niesen.");

  AddSound(DEFAULT_SOUND, "Es ist ehrfuerchtig still in dem Grab.");

  AddSound( ({"grab"}),
	   "Du hoerst nur Deinen eigenen Herzschlag.");
  
  AddSound( ({"herzschlag"}),
	   "bum,bum,bum");

//-----Details Ende-----
  
AddExit("westen", ROOM "hg3-2");
AddExit("osten", ROOM "hoch10");

}  
   
