// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Du stehst noerdlich vom See von Gorthad. Der See macht einen schoenen "
        "und friedlichen Eindruck auf Dich. Weiter im Norden erheben sich "
        "einige Huegel in der Graslandschaft. Auf den Huegeln wachsen "
        "anscheinend kleine weisse Blumen, soweit Du es von hier aus sehen "
        "kannst." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"see","sees"}), 
            "Der See liegt friedlich am Rand des Weges.");

  AddDetail( ({"gorthad","hochebene"}),
	    "Du befindest Dich auf der Hochebene von Gorthad. Sie breitet sich "
            "als eine grosse Graslandschaft vor Dir aus.");

  AddDetail( ({"eindruck"}),
	    "Der erste Eindruck kann immer taeuschen.");

  AddDetail( ({"wasser"}),
	    "Das Wasser ist nass.");  

  AddDetail( ({"norden"}),
	    "Im Norden tauchen ein paar Huegel in der Graslandschaft auf.");

  AddDetail( ({"huegel"}), 
            "Im Norden sind ein paar groessere und kleinere Huegel zu "
            "erkennen. Sie scheinen mit Gras und Blumen bewachsen zu sein.");

  AddDetail( ({"graslandschaft","landschaft"}),
	    "Die Graslandschaft um Dich herum wirkt sehr friedlich.");

  AddDetail( ({"blumen"}),
	    "Du bist Dir nicht sicher ob es Blumen sind. Du musst schon naeher "
            "heran gehen um es genau zu erfahren.");

  AddDetail( ({"boden"}),
	    "Der Weg unter Deinen Fuessen ist gepflastert.");
  
  AddDetail( ({"Himmel"}),
	    "Der Himmel ist schoen blau.");

  AddDetail( ({"fuessen","fuesse"}), 
            "Du muesstest sie mal wieder waschen, wie waere es, wenn Du es "
            "gleich hier im See machen wuerdest.");

  AddDetail( ({"gras","bestandteil"}),
	    "Gras ist immer ein Bestandteil einer Graslandschaft.");

  AddDetail( ({"weg","weges"}),
	    "Der Weg auf dem Du stehst ist mit grossen Pflastersteinen "
            "befestigt.");

  AddDetail( ({"rand"}),
	    "Direkt am Rand des Weges ist das Ufer des Sees.");
  
  AddDetail( ({"pflastersteine","pflastersteinen","steine"}),
	    "Die grossen Pflastersteine bilden einen sehr guten Weg.");

  AddDetail( ({"ufer"}), 
            "Ein paar Wasserpflanzen wachsen am Ufer.");

  AddDetail( ({"wasserpflanzen"}),
	    "Du erkennst ein wenig Schilf und ein paar Wasserlilien.");

  AddDetail( ({"schilf"}),
	    "Das Schilf wirkt recht uninteressant.");

  AddDetail( ({"wasserlilien"}),
	    "Die Wasserlilien bluehen in einem sonnigen Gelb.");
  
  AddDetail( ({"gelb"}),
	    "Das Gelb laed Dich gerade dazu ein an der Bluete zu schnuppern.");

  AddDetail( ({"bluete"}), 
            "Schnupper doch mal an der Bluete.");

  AddDetail( ({"regen"}),
	    "Es sieht nicht nach Regen aus.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst das Gras der Hochebene.");  
 
  AddSmell( ({"gras"}),
	   "Das Gras riecht frisch wie nach einem Regen.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind durch das Gras wehen.");

  AddSound( ({"gras","wind"}),
	   "Das Gras raschelt ein wenig.");
  
//-----Details Ende-----
  
AddExit("osten", ROOM "hoch8");
AddExit("suedwesten", ROOM "hoch6");

AddCmd( ({"wasch", "wasche" }), "waschen" );
AddCmd( ({"schnupper" }), "schnuppern" );

}
int waschen(string str)
{
   if ( member( ({"fuesse","fuss"})
,str) != -1) 
  {
    write( "Du waeschst in aller Ruhe Deine Fuesse und ploetzlich schwimmen "
           "ein paar Fische mit den Baeuchen nach oben an der "
           "Wasseroberflaeche. Du ziehst sofort Deine Fuesse heraus und "
           "schaust Dich verlegen um und hoffst niemand hat es gesehen.\n");
    say( TPN+" schaut sich verlegen um.\n");
    return 1;
  }
   return 0;
}
int schnuppern(string str)
{
   notify_fail("An was moechtest Du schnuppern?\n");
   if ( member( ({ "an bluete", "an wasserlilie","an lilie" }),str) != -1) 
  {
    write(BS ( "Als Du an der suesslichen Bluete schnupperst, kommt eine "
               "kleine Biene wuetend aus der Bluete gekrochen und sticht Dir in die "
               "Nase. Danach verschwindet sie wieder zwischen den "
               "Bluetenblaettern."));
    say( TPN+" wird von einer kleinen Biene gestochen.\n");
    TP->AddHp(-15);
    return 1;
  }
  return 0;
}  
   
