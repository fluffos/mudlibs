// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Die Hochebene laueft langsam nach Norden hin aus. Man erkennt im "
        "Norden einige Straeucher, die nach und nach die Graslandschaft zu "
        "verdraengen scheinen. Im Sueden sieht man noch die Huegelgraeber der "
        "Hochebene." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"hochebene","gorthad"}), 
            "Du bist auf der Hochebene von Gorthad.");

  AddDetail( ({"norden"}),
	    "Im Norden laeuft die Hochebene langsam aus.");

  AddDetail( ({"straeucher"}),
	    "Im Norden sind einige Straeucher zu sehen.");

  AddDetail( ({"gras","suedwesten"}),
	    "Als Du das Gras genauer betrachtest, merkst Du, dass Du hier den "
	    "Weg nach Suedwesten verlassen kannst.");

  AddDetail( ({"graslandschaft","landschaft"}),
	    "In der weiten Graslandschaft der Hochebene ist sonst nur Gras "
            "zu sehen. Im Norden tauchen ein paar Straeucher auf.");
  
  AddDetail( ({"sueden","huegelgraeber","huegelgraebern"}),
	    "Im Sueden sind die Huegelgraeber der Hochebene zu sehen. Sie sind "
            "mit kleinen Blumen bewachsen.");

  AddDetail( ({"boden"}), 
            "Der Boden des Weges ist mit Pflastersteinen bedeckt.");

  AddDetail( ({"himmel","wolken","horizont"}),
	    "Der Himmel ist blau. Nur ein paar weisse Wolken tauchen am "
            "Horizont auf.");

  AddDetail( ({"blumen"}),
	    "Es sind kleine weisse Blumen. Sie wachsen nur auf den "
            "Huegelgraebern.");

  AddDetail( ({"pflastersteinen","pflastersteine"}),
	    "Die Pflastersteine bilden einen sehr gut ausgebauten Weg.");
  
  AddDetail( ({"weges","weg"}),
	    "Der Weg fuehrt nach Norden langsam von der Hochebene herunter "
            "oder nach Sueden zu den Huegelgraebern.");

  AddDetail( ({"voegel"}), 
            "Grosse Voegel fliegen weit oben am Himmel. Du hast sie beim "
            "ersten Blick in den Himmel gar nicht gesehen. Sie sind sicher "
            "direkt vor der Sonne geflogen, als Du das erste Mal den "
            "Himmel angeschaut hast.");

  AddDetail( ({"mal","blick"}),
	    "Manchmal ist ein zweiter Blick sehr wichtig.");

  AddDetail( ({"sonne"}),
	    "Die Sonne steht fast senkrecht am Himmel.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Gras.");  
 
  AddSmell( ({"gras"}),
	   "Das Gras riecht wie frisch gemaeht, obwohl es das nicht ist.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Kreischen ein paar Voegel.");

  AddSound( ({"voegel","kreischen"}),
	   "Die Voegel geben kraechzende Geraeusche von sich.");
  
  AddSound( ({"geraeusche"}),
	   "*kraechz*");

//-----Details Ende-----
  
AddExit("suedosten", ROOM "hoch15");
AddExit("nordunten", ROOM "hoch17");

AddCmd( ({"verlass","verlasse" }), "verlassen" );

}  
int verlassen(string str)
{
   notify_fail("Wohin moechtest Du was verlassen?\n");
   if ( member( ({ "weg nach suedwesten" }),str) != -1) 
  {
    write(BS ( "Du verlaesst den Weg und gehst durch das Gras der "
	       "Hochebene nach Suedwesten.\n"));
      TP->move( ORKHOEHLE+"/room/orks10-2", M_GO, 
      "in der Graslandschaft der Hochebene", "verschwindet", 
      "kommt vom Weg in die Graslandschaft gestapft");
    return 1;
  }
  return 0;
}      
