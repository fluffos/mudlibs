// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Waldanfang");
  SetProp( P_INT_LONG,
	"Im Norden beginnt ein dichter dunkler Wald. Im Sueden fuehrt Dich "
        "der Weg hoch auf die Hochebene von Gorthad. Zu beiden Seiten des "
        "Weges stehen schon kleine Baeumchen und einige dichte Buesche sind "
        "zu sehen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"norden","wald","waldes"}), 
            "Im Norden ist ein dunkler Wald. Die Baeume des Waldes stehen "
            "sehr dicht und man kann nicht sehr weit in den Wald hinein "
            "schauen. Der Weg ist recht schnell nicht mehr zu sehen.");

  AddDetail( ({"sueden"}),
	    "Im Sueden fuehrt der Weg stetig nach oben auf die Hochebene "
            "von Gorthad.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Die Hochebene von Gorthad ist fuer seine grossen Huegelgraeber "
            "bekannt.");

  AddDetail( ({"seiten","rand"}),
	    "Zu beiden Seiten des Weges stehen kleine Baeumchen und ein paar "
            "Buesche.");
  
  AddDetail( ({"weg","weges","pfad"}),
	    "Der Weg fuehrt nach Sueden auf die Hochebene und ist mit grossen "
            "Pflastersteinen angelegt. Nach Norden fuehrt der Weg in den "
            "dunklen Wald und geht von dem befestigten Weg in einen erdigen "
            "Pfad ueber.");

  AddDetail( ({"baeumchen"}), 
            "Kleine Baeumchen, die noch grosse Baeume werden wollen, stehen "
            "am Rand des Weges.");

  AddDetail( ({"buesche"}),
	    "Die Buesche bilden ein dichtes Buschwerk am Rand des Weges.");

  AddDetail( ({"baeume"}),
	    "Grosse Baeume bilden im Norden einen dunklen Wald.");

  AddDetail( ({"boden"}),
	    "Der gepflasterte Weg geht in einen erdigen Weg oder Pfad ueber, "
            "der in einen dunklen Wald im Norden fuehrt.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ueber Dir ist blau, bis auf ein paar Wolken, die "
            "sich langsam vor die Sonne schieben.");

  AddDetail( ({"huegelgraeber"}), 
            "Um die Huegelgraeber der Hochebene zu sehen, musst Du schon auf "
            "die Hochebene gehen.");

  AddDetail( ({"pflastersteinen","pflastersteine","steine","pflaster","steinen"}),
	    "Die Pflastersteine fangen genau an dieser Stelle an und stellen "
            "einen befestigten Weg dar, der auf die Hochebene fuehrt.");

  AddDetail( ({"buschwerk"}),
	    "Durch das dichte Buschwerk kann man den Weg nicht verlassen.");

  AddDetail( ({"wolken"}),
	    "Die Wolken haben eine schoene weisse Farbe.");
  
  AddDetail( ({"sonne"}),
	    "Die Sonne steht fast senkrecht am Himmel. Ein paar Wolken sind "
            "dabei sich langsam vor sie zu schieben.");

  AddDetail( ({"farbe"}), 
            "Die weisse Farbe deutet nicht auf Regen hin.");

  AddDetail( ({"regen"}),
	    "Es wird sicher nicht regnen.");

  AddDetail( ({"gefuehl","gefuehle","gefuehlen"}),
	    "Seinen Gefuehlen sollte man trauen.");

  AddDetail( ({"stelle"}),
	    "Der Weg wechselt von befestigen Steinen zu einem erdigen Pfad, "
            "der weiter nach Norden fuehrt.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Gefahr.");  
 
  AddSmell( ({"gefahr","geruch"}),
	   "Es ist mehr ein Gefuehl, als ein Geruch. Die Gefahr geht "
           "anscheinend von dem Wald aus.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar merkwuerdige Geraeusche.");

  AddSound( ({"geraeusche"}),
	   "Die Geraeusche sind ein Knacken und Aechzen.");
  
  AddSound( ({"knacken","aechzen"}),
	   "Die Geraeusche kommen aus dem dunklen Wald.");

//-----Details Ende-----
  
AddExit("suedoben", ROOM "hoch19");
AddExit("norden", ROOM "hochende2");

}
