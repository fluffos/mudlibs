// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl=1;

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Die Huegelgraeber zu beiden Seiten des Weges sind hier viel groesser "
        "als im Sueden. Es herrscht gerade zu eine mystische Stille und Du "
        "bist sehr bewegt von der Stimmung, die hier herrscht. Ein grosser "
        "Stein mit Verzierungen steht in der Mitte des breiten Weges." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"huegelgraeber","graeber","huegel","huegelgraebern"}), 
            "Die Huegelgraeber zu beiden Seiten sind viel groesser als im "
            "Sueden. Anscheinend sind hier groessere Persoenlichkeiten "
            "bestattet worden. Sie sind mit kleinen weissen Blumen und Gras "
            "bewachsen.");

  AddDetail( ({"seiten"}),
	    "Zu beiden Seiten sind grosse Huegelgraeber zu erkennen. Sie sind "
            "groesser als im Sueden.");

  AddDetail( ({"weg","weges"}),
	    "Der Weg fuehrt zwischen den grossen Huegelgraebern hindurch.");

  AddDetail( ({"sueden"}),
	    "Im Sueden sind die Graeber kleiner als hier.");
  
  AddDetail( ({"stille","umgebung"}),
	    "Die mystische Stille passt zur Umgebung.");

  AddDetail( ({"stimmung"}), 
            "Die Stimmung, die die Huegelgraeber verbreiten ist irgendwie "
            "mystisch.");

  AddDetail( ({"stein"}),
	    "Ein grosser Stein mit Verzierungen und Symbolen steht in der "
            "Mitte des Weges.");

  AddDetail( ({"verzierungen"}),
	    "Die Verzierungen stellen Krieger und Waffen dar und schildern die "
            "Geschichte eines Krieges.");

  AddDetail( ({"mitte"}),
	    "Genau in der Mitte des breiten Weges steht ein uralter "
            "grosser Stein");

  AddDetail( ({"sonne"}),
	    "Die Sonne laechelt Dir zu.");
  
  AddDetail( ({"boden"}),
	    "Der Boden ist mit grossen Pflastersteinen ausgelegt.");

  AddDetail( ({"himmel"}), 
            "Der Himmel ist blau. Nur am noerdlichen Horizont ziehen ein paar "
            "Wolken auf.");

  AddDetail( ({"horizont","wolken"}),
	    "Am noerdlichen Horizont ziehen ein paar weisse Wolken auf. Es "
            "wird also nicht regnen.");

  AddSpecialDetail( ({ "durchgang" }), "durchgang" );

  AddDetail( ({"persoenlichkeiten"}),
	    "Die Namen der Persoenlichkeiten steht auf kleinen Steintafeln, "
            "die im Gras der Huegel eingebettet sind.");

  AddDetail( ({"gras"}),
	    "Das Gras waechst ueberall.");
  
  AddDetail( ({"blumen"}),
	    "Es sind kleine weisse Blumen, die nur auf den Huegelgraebern zu "
            "wachsen scheinen.");

  AddDetail( ({"steintafeln","namen"}), 
            "Auf den Steintafeln stehen die Namen der gefallenen Helden. "
            "Du kannst sie lesen.");

  AddDetail( ({"helden"}),
	    "Du willst auch einmal gross, stark und beruehmt werden, so dass "
            "Dir auch ein grosses Huegelgrab gebaut wird.");

  AddDetail( ({"symbolen","symbole"}),
	    "Die Symbole sind sehr alt und Du kannst sie nicht deuten, oder "
            "solltest Du es vielleicht doch?");

  AddDetail( ({"krieger"}),
	    "Die Krieger sind gross und stolz.");
  
  AddDetail( ({"krieges","krieg","opfer"}),
	    "Der Krieg war lang und hat viele Opfer gefordert.");

  AddDetail( ({"waffen"}), 
            "Die Waffen sehen schrecklich aus, obwohl sie nur gezeichnet sind.");

  AddDetail( ({"pflastersteinen","pflastersteine","zustand","jahrhunderte"}),
	    "Sie sind in einem sehr guten Zustand, obwohl der Weg Jahrhunderte "
            "alt ist.");

  AddDetail( ({"huegelgrab"}),
	    "Es gibt hier viele Huegelgraeber.");

  AddDetail( ({"geschichte"}),
	    "Die Geschichte ist Dir nicht bekannt. Vielleicht findest Du "
            "ja noch wen, der sie kennt.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen"}),
	   "Die weissen Blumen auf den Graebern duften suesslich.");

  AddSound(DEFAULT_SOUND, "Es ist absolut still.");

  AddReadDetail( ({"steintafeln","steintafel","namen","name"}),
		"Hier liegen die beiden Heerfuehrer Grothan und Bolgar "
                "begraben, die die Orks in vielen Schlachten besiegt haben.");

//-----Details Ende-----
  
AddExit("nordwesten", ROOM "hoch11");
AddExit("sueden", ROOM "hoch9");

AddCmd( ({"deut","deute" }), "deuten" );

}
void reset()
	
{
  ::reset();
  anzahl=1; 
}

int deuten(string str)
{
 notify_fail("Was willst Du deuten?\n");

 if(!str || str == "") return 0;
 if(!(str == "symbole" )) return 0;
 

 if( str == "symbole"){
    
  if(anzahl < 1)

  {
	  
  write(BS("Du konzentrierst Dich, jedoch das Deuten der Symbole bringt Dich "
           "momentan nicht weiter.\n"));
 
  say(TPN+" arglt ein wenig.\n");
  return 1;
  }
  else
  {
  write(BS("Du konzentrierst Dich und probierst die Symbole zu deuten. Worte "
           "in einer fremden Sprache tauchen in Deinem Kopf auf und ploetzlich "
           "oeffnet sich im westlichen "
           "Huegelgrab ein Durchgang, der vorher nicht zu erkennen war. \n"));
 
  say(TPN+" konzentriert sich und ein Durchgang in das westliche Huegelgrab "
          "oeffnet sich.\n");
  AddExit("westen", ROOM "hg3-1");
  anzahl--;
  return 1;
 }
 }
}
string riss(string key)
{
    if ( anzahl )
    {
       return(BS("Da musst Du wohl noch ein wenig forschen.\n"));
    }
    else
    {
       return(BS("Der Durchgang scheint direkt in das Huegelgrab zu fuehren."));
    }
    return "";
}


