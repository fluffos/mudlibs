// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Turm");
  SetProp( P_INT_LONG,
	"Dies ist das Erdgeschoss des Turms. Das Mobiliar ist alt und "
        "teilweise kaputt. Allerlei Geruempel liegt in den Ecken und an "
        "den Waenden sind nutzlose Halterungen zwischen den Schiessscharten "
        "zu erkennen. Ein wenig Licht dringt durch die Schiessscharten in "
        "den Raum und erhellt das Erdgeschoss." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"erdgeschoss","raum","erdgeschosses"}), 
            "Du stehst nun im Erdgeschoss des Turms. Es herrscht ein "
            "schreckliches Durcheinander. Ein wenig Licht faellt durch "
            "die Schiessscharten und die offene Tuer in den Raum. Eine kleine "
            "Treppe schlaengelt sich an der Wand in der Obergeschoss des "
            "Turmes.");

  AddDetail( ({"turm","turms","turmes"}),
	    "Du stehst in einem schwarzen Turm.");

  AddDetail( ({"mobiliar"}),
	    "Das Mobiliar ist zerstoert und ueber den ganzen Boden verteilt.");

  AddDetail( ({"geruempel"}),
	    "Allerlei Geruempel liegt in den Ecken des Turms. Du erkennst "
            "zerbrochene Schwerter, Speere und alte Ruestungsteile.");
  
  AddDetail( ({"ecken"}),
	    "In den Ecken liegt lauter Geruempel rum.");

  AddDetail( ({"waende","waenden","wand","ausdruck"}), 
            "In den Waenden sind Schiessscharten und eine Tuer zu sehen. Der "
            "schwarze Granit verpasst dem Erdgeschoss einen duesteren "
            "Ausdruck. An einer Wand schlaengelt sich eine kleine Treppe in "
            "das Obergeschoss des Turms und an der anderen haengen ein paar "
            "Halterungen fuer Waffen.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen sind aus Holz. Hier haben schon lange keine "
            "Waffen mehr gehangen.");

  AddDetail( ({"schiessscharten","scharten"}),
	    "Die Schiessscharten sind schmal und lassen nur ein wenig Licht "
            "in das Erdgeschoss.");

  AddDetail( ({"licht"}),
	    "Ein wenig Licht erhellt das Erdgeschoss. Es stroemt durch die "
            "Schiessscharten und die zerbrochene Tuer.");
  
  AddDetail( ({"boden"}),
	    "Am Boden liegt das zerstoerte Mobiliar des Erdgeschosses und "
            "allerlei Geruempel befindet sich in den Ecken. Ausserdem ist "
            "der gesamte Boden mit einer dicken Staubschicht bedeckt. Es war "
            "sehr lange niemand hier im Turm.");

  AddDetail( ({"himmel"}), 
            "Der Himmel heisst in einem Raum Decke.");

  AddDetail( ({"decke"}),
	    "An der Decke haengt eine alte Oellampe, die schon vor langer "
            "Zeit erloschen ist.");

  AddDetail( ({"tuer","einzelteile","einzelteilen"}),
	    "Die Tuer ist komplett zerstoert und liegt teilweise in "
            "Einzelteilen im Raum verteilt. Sie wurde anscheinend gewaltsam "
            "zerstoert und nicht durch den Zahn der Zeit.");

  AddDetail( ({"treppe"}),
	    "Die Treppe fuehrt in das Obergeschoss des Turms.");
  
  AddDetail( ({"obergeschoss"}),
	    "Du weisst nicht, was im Obergeschoss ist. Geh einfach mal hin "
            "und schau nach.");

  AddDetail( ({"schwerter","schrott"}), 
            "Die Schwerter sind nicht mehr zu gebrauchen. Teilweise sind sie "
            "sogar abgebrochen. Sie sind nur noch Schrott.");

  AddDetail( ({"speere"}),
	    "Abgebrochene Speere liegen in den Ecken. Mit den Speeren wird "
            "man keinen Kampf mehr bestreiten koennen.");

  AddDetail( ({"ruestungsteile","ruestungen"}),
	    "Die Ruestungen sind alt und verrostet. Sie haben keinerlei Wert "
            "mehr. Du laesst sie einfach enttaeuscht liegen.");

  AddDetail( ({"granit"}),
	    "Die grossen Steinquader aus schwarzen Granit bilden eine "
            "stabile Mauer, die Jahrhunderte ueberstehen kann.");
  
  AddDetail( ({"waffen"}),
	    "Es sind keine Waffen in den Halterungen. Nur ein paar alte "
            "unbrauchbare Schwerter und Speere liegen im Geruempel der "
            "Ecken.");

  AddDetail( ({"staubschicht","staub","schicht"}), 
            "Eine dicke Staubschicht liegt am Boden. Es war schon lange "
            "keiner mehr hier.");

  AddDetail( ({"oellampe","lampe"}),
	    "Die Lampe ist alt und rostig. Sie hat schon vor langer langer "
            "Zeit aufgehoert zu brennen.");

  AddDetail( ({"zahn","zeit"}),
	    "Es ist schon sehr lange her.");

  AddDetail( ({"durcheinander"}),
	    "Es ist nicht gerade sauber hier.");

  AddDetail( ({"kampf"}),
	    "Du bist einem Kampf nie abgeneigt.");
  
  AddDetail( ({"wert"}),
	    "Haetten sie noch einen Wert gehabt, haettest Du sie schoen "
            "verkaufen koennen.");

  AddDetail( ({"steinquader","quader","stein","steinquadern","arbeit"}), 
            "Die Steinquader der Mauern sind riesig. Es muss eine schwere "
            "Arbeit gewesen sein, sie hier auf die Hochebene zu schaffen, "
            "da es hier keinen Granit gibt.");

  AddDetail( ({"mauer"}),
	    "Die Mauer besteht aus grossen Steinquadern.");

  AddDetail( ({"jahrhunderte","jahrhunderten"}),
	    "Vor Jahrhunderten hat man noch gar nicht an Dich gedacht.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Du bist auf der Hochebene von Gorthad.");
  
  AddDetail( ({"holz"}),
	    "Es ist ganz normales Holz. Es ist nicht wirklich interessant.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst gar nichts.");  
 
  AddSound(DEFAULT_SOUND, "Es ist totenstill.");

//-----Details Ende-----
  
AddExit("oben", ROOM "hocht2");
AddExit("sueden", ROOM "hoch26");

}  
   
