// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Die Hochebene scheint in Richtung Norden langsam auszulaufen, da der "
        "Weg langsam nach unten zu fuehren scheint. Auf beiden Seiten des "
        "Weges siehst Du kniehohes Gras, welches sich leicht im Wind bewegt. "
        "Im Sueden erkennst Du die Huegelgraeber der Hochebene." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"hochebene","gorthad"}), 
            "Die Hochebene von Gorthad laeuft in Richtung Norden langsam aus. "
            "Der Weg fuehrt ganz langsam bergab.");

  AddDetail( ({"richtung","norden"}),
	    "In Richtung Norden geht es langsam bergab. Die Hochebene scheint "
            "langsam auszulaufen.");

  AddDetail( ({"weg","weges","suedosten","nordwesten"}),
	    "Der Weg besteht aus grossen Steinen und fuehrt nach Suedosten "
            "oder Nordwesten.");

  AddDetail( ({"seiten"}),
	    "Direkt neben dem Weg beginnt die weite Graslandschaft der "
            "Hochebene.");
  
  AddDetail( ({"gras"}),
	    "Das Gras ist eines der Hauptmerkmale der Hochebene. Es waechst "
            "hier ueberall.");

  AddDetail( ({"wind"}), 
            "Der Wind weht sanft ueber das Gras der Hochebene.");

  AddDetail( ({"himmel","sonne"}), 
            "Im Norden tauchen ein paar weisse Wolken am Horizont auf, aber "
            "hier scheint die Sonne.");

  AddDetail( ({"wolken","horizont"}), 
            "Die weissen Wolken sehen nicht beunruhigend aus. Es wird sicher "
            "nicht regnen.");

  AddDetail( ({"boden","zeit"}), 
            "Am Boden ist der gepflasterte Weg, auf dem Du Dich schon die "
            "ganze Zeit bewegst.");

  AddDetail( ({"sueden","huegelgraeber","huegelgraebern"}),
	    "Im Sueden sind die grossen und kleinen Huegelgraeber zu sehen. "
            "Sie sind mit Gras und kleinen weissen Blumen bewachsen.");

  AddDetail( ({"steine","steinen","pflastersteine"}),
	    "Die grossen Pflastersteine bilden einen festen Weg. In den Ritzen "
            "zwischen den Steinen waechst ein wenig Moos.");

  AddDetail( ({"moos"}),
	    "Das Moos hat sich in den Ritzen zwischen den Steinen "
            "festgesetzt.");
  
  AddDetail( ({"ritzen"}),
	    "Die Ritzen zwischen den Steinen sind nur sehr schmal. Ein wenig "
            "Moos waechst in ihnen.");

  AddDetail( ({"graslandschaft","landschaft"}), 
            "Die Hochebene ist fast komplett von Gras bedeckt. Es gibt kaum "
            "Baeume oder Straeucher.");

  AddDetail( ({"baeume","straeucher"}),
	    "Baeume und Straeucher gibt es nur am Rand der Hochebene im "
            "Norden.");

  AddDetail( ({"rand"}),
	    "Du bist noch weit vom Rand der Hochebene entfernt.");

  AddDetail( ({"hauptmerkmale","merkmale"}),
	    "Die Merkmale der Hochebene sind natuerlich die Huegelgraeber und "
            "die weite ruhige Graslandschaft von Gorthad.");
  
  AddDetail( ({"blumen"}),
	    "Die kleinen weissen Blumen wachsen nur auf den Huegelgraebern. "
            "Ansonsten siehst Du im Gras keinerlei Blumen bluehen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst das Gras der Hochebene.");  
 
  AddSmell( ({"gras"}),
	   "Einfach grasig!");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind ueber das Gras wehen.");

  AddSound( ({"gras","rascheln","wind"}),
	   "Das Gras wiegt sich leicht im Wind und raschelt ein wenig.");
  
//-----Details Ende-----
  
AddExit("suedosten", ROOM "hoch14");
AddExit("nordwesten", ROOM "hoch16");

}  
   
