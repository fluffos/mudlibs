// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int zahl;

void create()
	
{
  ::create();

  zahl=3;

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Rings um Dich herum siehst Du die Graslandschaft der Hochebene. Im "
        "Nordosten scheinen ein paar Huegel zu sein. Du bist aber zu weit weg "
        "um etwas genaueres zu erkennen. Der alte, aber noch sehr gute Weg, "
        "fuehrt Dich nach Westen oder nach Osten auf der Hochebene." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"Graslandschaft","landschaft"}), 
            "Das Gras ein beiden Seiten des alten Weges waechst nicht "
            "besonders hoch. Es ist aber ein wenig komisch, dass keinerlei "
            "Blumen im Gras wachsen.");

  AddDetail( ({"hochebene"}),
	    "Du befindest Dich auf der Hochebene von Gorthad. Ihre weite "
            "Graslandschaft ist schon beeindruckend.");

  AddDetail( ({"nordosten","huegel"}),
	    "Die Huegel im Nordosten sind sicher die beruehmten Huegelgraeber "
            "der Hochebene.");

  AddDetail( ({"weg","weges"}),
	    "Der Weg ist mit grossen Pflastersteinen befestigt.");
  
  AddDetail( ({"westen","osten"}),
	    "Der Weg fuehrt nach Westen oder Osten. Du musst Dich schon "
            "entscheiden oder hier ein wenig idlen, was eine wirkliche "
            "Alternative zum Weitergehen darstellt.");

  AddDetail( ({"boden"}), 
            "Du siehst grosse Pflastersteine, die einen Weg bilden und Gras "
            "am Rand des Weges.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ueber Dir ist blau. Es sieht nicht so aus, als ob "
            "er Dir auf den Kopf fallen wuerde.");

  AddDetail( ({"sonne"}),
	    "Die Sonne brennt beinahe senkrecht vom Himmel.");

  AddDetail( ({"blumen","blume"}),
	    "Es ist schon komisch, dass nicht eine einzige Blume im Gras zu "
            "wachsen scheint.");

  AddDetail( ({"gras","seiten","rand"}),
	    "Es gibt nur Gras zu sehen.");
  
  AddDetail( ({"huegelgraeber","huegelgrab"}),
	    "Die Huegelgraeber der Hochebene sind riesig und Gorthad heisst "
            "ja auch auf elfisch Huegelgrab.");

  AddDetail( ({"pflastersteinen","pflastersteine"}), 
            "Die grossen Pflastersteine bilden einen gut ausgebauten Weg.");

  AddDetail( ({"alternative","weitergehen"}),
	    "Idle einfach mal.");

  AddDetail( ({"kopf","koepfe"}),
	    "Es gibt eindeutig schoenere und kluegere Koepfe im Silberland "
            "als Dich.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland.");
  
  AddDetail( ({"gorthad"}),
	    "Du befindest Dich auf der Hochebene von Gorthad.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Er riecht nach toten Tieren.");  
 
  AddSmell( ({"tiere","tieren"}),
	   "Es gibt hier keine toten Tiere. Du solltest Dich nur einmal "
           "waschen.");

  AddSound(DEFAULT_SOUND, "Es ist hier sehr still.");

//-----Details Ende-----
  
AddExit("osten", ROOM "hoch2");
AddExit("westen", ROOM "hoch4");

AddCmd( ({"idle" }), "idlen" );


}
void reset() {
   zahl=3;
   return ::reset();
}

int idlen(string str)
{
     if( zahl < 1 )
     {
        write("Du hast keine Lust zum Idlen mehr.\n");
        say(sprintf("%s will nicht mehr Idlen.\n", TP->Name(WER)));
        return -1;
     }
      if ( zahl )
     {
      TP->AddHp(25);
      write("Du fuehlst Dich durch das anstaendige Idlen erfrischt.\n" );
      zahl=zahl-1;
     }
    return 1;
}
   
