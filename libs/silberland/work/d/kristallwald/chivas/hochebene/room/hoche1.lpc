// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Vor einer steilen Felswand");
  SetProp( P_INT_LONG,
	"Eine steile Felswand mit einem kleinen Pfad ragt direkt vor Dir auf. "
        "Der Weg auf dem Du stehst fuehrt durch eine huegelige Landschaft mit "
        "Baeumen und Straeuchern in Richtung Westen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"felswand","wand"}), 
            "Die Felswand vor Dir ragt beinahe senkrecht vor Dir auf. Ein "
            "kleiner schmaller Pfad schlaengelt sich an ihr nach oben.");

  AddDetail( ({"pfad"}),
	    "Der kleine unscheinbare Pfad fuehrt die steile Felswand hoch auf "
            "die Hochebene von Gorthad.");

  AddDetail( ({"weg"}),
	    "Der Weg fuehrt von der steilen Felswand fort.");

  AddDetail( ({"landschaft"}),
	    "Die Landschaft ist ein wenig huegelig. Es ist kein Vergleich zu "
            "der flachen Hochebene von Gorthad.");
  
  AddDetail( ({"baeume","baeumen"}),
	    "Grosse Baeume saeumen den Weg, der nach Westen fuehrt.");

  AddDetail( ({"straeucher","straeuchern","rand"}), 
            "Kleine Straeucher stehen am Rand des Weges. Leider kannst Du "
            "keine Beeren an ihnen erkennen. Etwas Suesses waere schon nicht "
            "schlecht gewesen.");

  AddDetail( ({"richtung","westen"}),
	    "Der Weg fuehrt zwischen grossen Baeumen weiter nach Westen.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mir Erde und kleinen Kieselsteinen bedeckt.");

  AddDetail( ({"himmel","himmels"}),
	    "Es ist nur ein Teil des Himmels zu sehen, da die hohe Felswand "
            "einen Teil verdeckt.");
  
  AddDetail( ({"teil","wolken","sonne"}),
	    "Den Teil des Himmels, den Du sehen kannst, ist schoen blau. Es "
            "sind keinerlei Wolken und auch nicht die Sonne zu sehen.");

  AddDetail( ({"erde"}), 
            "Die Erde ist schwarz und sicher sehr fruchtbar.");

  AddDetail( ({"kieselsteine","kieselsteinen"}),
	    "Die Kieselsteine sind klein und fast rund. Sie sind nicht viel "
            "wert.");

  AddDetail( ({"etwas","suesses","naschkatze","katze"}),
	    "Du bist halt eine kleine Naschkatze.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Der kleine Pfad fuehrt auf die Hochebene von Gorthad.");
  
  AddDetail( ({"blumen"}),
	    "Zwischen den Straeuchern wachsen ein paar kleine Blumen.");

  AddDetail( ({"voegel","voegeln","wipfel","wipfeln"}), 
            "Kleine Voegel scheinen in den Wipfeln der grossen Baeume zu "
            "sitzen. Du kannst sie nicht sehen, aber hoeren.");

  AddDetail( ({"beeren"}),
	    "Du siehst leider keine. Schade.");

  AddDetail( ({"vergleich","unterschied"}),
	    "Es ist halt ein Unterschied. Hier ist es huegelig und auf der "
            "Hochebene halt nicht. Du untersuchst wirklich alles.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen duften herrlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Gezwitscher von Voegeln.");

  AddSound( ({"gezwitscher","voegel"}),
	   "Es wirkt sehr beruhigend.");
  
//-----Details Ende-----
AddItem( "/d/huegelland/feyaria/weg/npc/reh", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "hoche1",
          P_MNPC_AREA:({ROOM "hoche1"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("oben", ROOM "hoche2");
AddExit("westen", "/d/kristallwald/chivas/zwergenfeste/room/zwfe1");

}
