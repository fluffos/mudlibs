// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Du stehst am westlichen Rand der Hochebene. Ein schmaler Pfad fuehrt "
        "nach Westen von der Hochebene herunter. Nach Osten geht der breite "
        "Weg weiter durch die sagenhafte Graslandschaft." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"rand"}), 
            "Der westliche Rand der Hochebene faellt steil ab. Ein kleiner "
            "Pfad schlaengelt sich an der fast senkrechten Felswand hinunter.");

  AddDetail( ({"hochebene"}),
	    "Die Hochebene breitet sich nach Norden und Osten vor Dir aus.");

  AddDetail( ({"pfad","westen"}),
	    "Der Pfad fuehrt nach Westen an der Felswand hinunter.");

  AddDetail( ({"osten","weg"}),
	    "Der Weg fuehrt nach Osten.");
  
  AddDetail( ({"graslandschaft","landschaft","pracht"}),
	    "Die Graslandschaft breitet sich in seiner ganzen Pracht vor Dir "
            "aus.");

  AddDetail( ({"boden"}), 
            "Der Boden geht von einem mit Steinen gepflasterten Weg in einen "
            "mit Erde und Kies bedeckten kleinen Pfad ueber. Ansonsten ist "
            "lauter Gras in der Umgebung zu sehen.");

  AddDetail( ({"himmel","blau"}),
	    "Der Himmel ueber Dir zeigt ein strahlendes Blau und die Sonne "
            "waermt Dich.");

  AddDetail( ({"sonne"}), 
            "Die Sonne steht fast senkrecht ueber Dir.");

  AddDetail( ({"felswand","wand"}),
	    "An der Felswand fuehrt ein kleiner Pfad nach unten.");

  AddDetail( ({"norden"}),
	    "Im Norden siehst Du nur Gras.");
  
  AddDetail( ({"gras","hauptmerkmal","merkmal","umgebung"}),
	    "Gras ist das Hauptmerkmal der Hochebene neben den beruehmten "
            "Huegelgraebern.");

  AddDetail( ({"huegelgraebern","huegelgraeber","nordosten"}), 
            "Die Huegelgraeber liegen irgendwo im Nordosten.");

  AddDetail( ({"erde","kies"}),
	    "Der Pfad ist nur mit Erde und Kies bedeckt.");

  AddDetail( ({"steinen","steine","pflastersteine"}),
	    "Grosse Pflastersteine bilden den Weg.");

  AddDetail( ({"felswand","wand"}),
	    "Die Felswand faellt steil ab.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach gar nichts.");  
 
  AddSound(DEFAULT_SOUND, "Es ist still, man hoert gar nichts.");

//-----Details Ende-----
  
AddExit("osten", ROOM "hoch4");
AddExit("westunten", ROOM "hoche4");

}  
   
