// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einer steilen Felswand");
  SetProp( P_INT_LONG,
	"Der Pfad schmiegt sich eng an den Fels und ist sehr ausgetreten. "
        "Anscheinend wird der Pfad sehr oft von Abenteurern genutzt. Du bist "
        "sehr hoch ueber dem wirklichen Boden unterhalb der Felswand. Ein "
        "Sturz waere absolut toedlich. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"pfad","pfades"}), 
            "Der kleine Pfad schlaengelt sich an der Felswand entlang.");

  AddDetail( ({"fels","felswand","wand"}),
	    "Die Felswand ist direkt neben Dir. An ihr wachsen einige Moose "
            "und Flechten.");

  AddDetail( ({"abenteurer","abenteurern"}),
	    "Viele Abenteurer wie Du haben diesen Pfad genommen.");

  AddDetail( ({"boden"}),
	    "Der wirkliche Boden ist noch weit unter Dir. Du kannst die "
            "Baeume unten sehen. Der Boden des Pfades ist steinig.");
  
  AddDetail( ({"sturz"}),
	    "Der Sturz in die Tiefe wuerde toedlich sein.");

  AddDetail( ({"himmel","himmels"}), 
            "Den Himmel kannst Du nicht so gut sehen, da Du im Schatten der "
            "Felswand stehst.");

  AddDetail( ({"schatten","teil"}),
	    "Die Felswand liegt im Schatten. Den Teil des Himmels, den Du "
            "sehen kannst, ist blau.");

  AddDetail( ({"sonne"}), 
            "Die Sonne siehst Du nicht, sonst waerst Du ja auch nicht im "
            "Schatten.");

  AddDetail( ({"tiefe"}),
	    "Es geht noch sehr weit nach unten.");

  AddDetail( ({"steine"}),
	    "Kleine Steine liegen auf dem Boden. Sie sind sehr uninteressant.");
  
  AddDetail( ({"moose","flechten"}),
	    "Die Moose und Flechten haben sich in den Rissen der Felswand "
            "festgesetzt.");

  AddDetail( ({"risse"}), 
            "Die Risse sind tief, aber es versteckt sich leider nichts "
            "interessantes in ihnen.");

  AddDetail( ({"hochebene"}),
	    "Die Hochebene ist oberhalb der Felswand.");


  AddDetail( ({"baeume"}),
	    "Tief unter Dir erkennst Du die Wipfel der Baeume.");
  
  AddDetail( ({"wipfel"}),
	    "Die Wipfel der Baeume sind schoen gruen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst die Flechten und Moose.");  
 
  AddSmell( ({"flechten","moose"}),
	   "Sie duften ein wenig.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind von der Hochebene wehen.");

  AddSound( ({"wind"}),
	   "Er weht direkt an der Felswand hinunter.");
  
//-----Details Ende-----
  
AddExit("oben", ROOM "hoche4");
AddExit("unten", ROOM "hoche2");

}  
   
