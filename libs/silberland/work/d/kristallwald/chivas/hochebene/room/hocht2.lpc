// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Turm");
  SetProp( P_INT_LONG,
	"Im Obergeschoss des Turms sind nur ein paar Halterungen an den "
        "Waenden, wo die Wachen ihre Waffen dran haengen konnten. In der "
        "Decke ist ein Loch, durch dass man auf den Turm kommt. Von dort hat "
        "man sicher eine hervorragende Aussicht." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"obergeschoss"}), 
            "Du stehst im Obergeschoss des Turms. Es ist recht karg "
            "eingerichtet. Ausser den Halterungen an den Waenden ist nichts "
            "interessantes auf den ersten Blick zu sehen.");

  AddDetail( ({"turm","turms"}),
	    "Der Turm war sicher einmal ein Wachturm.");

  AddDetail( ({"halterungen","gegend"}),
	    "Die Halterungen an den Waenden sind aus Holz. Anscheinend wurden "
            "frueher verschiedene Waffen in sie gehaengt, damit sie nicht so "
            "in der Gegend herum liegen.");

  AddDetail( ({"waende","waenden","wand"}),
	    "Die Waende bestehen aus blankem Stein. Es sind sehr grosse "
            "schwarze Steinquader. An ihnen ist nicht viel zu sehen, ausser "
            "die Halterungen fuer die Waffen und die schmalen Schiessscharten "
            "durch die ein wenig Licht in den Turm dringt.");
  
  AddDetail( ({"waffen","schwerter","speere"}),
	    "Es sind keine Waffen mehr in den Halterungen. Aber damals haben "
            "die Wachen sicher ihre Schwerter und Speere in die Halterungen "
            "gehaengt.");

  AddDetail( ({"decke"}), 
            "Die Decke ist schmucklos. Nur ein Loch in der Decke ist zu sehen, "
            "durch das man auf die Aussichtsplattform des Turms kommt.");

  AddDetail( ({"loch"}),
	    "Durch das Loch in der Decke kommt man auf die Plattform oberhalb "
            "des Turms.");

  AddDetail( ({"aussicht","ausblick"}),
	    "Die Aussicht auf dem Turm ist sicher fantastisch. So nahe am Rand "
            "der Felswand hat man sicher einen hervorragenden Ausblick. Geh "
            "doch einfach weiter nach oben und schau nach.");

  AddDetail( ({"boden"}),
	    "Der Boden ist kahl und mit ein wenig Staub bedeckt. Eine schmale "
            "Treppe fuehrt nach unten in das Erdgeschoss.");
  
  AddDetail( ({"himmel"}),
	    "Den Himmel in einem Raum nennt man Decke.");

  AddDetail( ({"raum"}), 
            "Du bist im Obergeschoss des Turms.");

  AddDetail( ({"blick"}),
	    "Manchmal ist der erste Blick vollkommen ausreichend.");

  AddDetail( ({"wachturm"}),
	    "Man kann leider nicht mehr genaus ausmachen, was hier auf der "
            "Hochebene bewacht wurde. Es ist schon sehr viel Zeit vergangen "
            "und der Turm ist uralt.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Du bist auf der Hochebene von Gorthad.");
  
  AddDetail( ({"zeit","urzeiten"}),
	    "Es ist sehr lange her.");

  AddDetail( ({"holz","ecke"}), 
            "Das Holz der Halterungen ist alt und rissig. Du kannst ein paar "
            "kleine Schriftzeichen an einer Ecke erkennen.");

  AddDetail( ({"wachen"}),
	    "Es sind keine Wachen mehr da. Sie haben den Turm schon vor "
            "Urzeiten verlassen. Heute gibt es auf der Hochebene nicht mehr "
            "viel zu bewachen.");

  AddDetail( ({"stein","quader","steinquader"}),
	    "Die Steinquader sind gross und massiv. Sie werden nur durch die "
            "schmalen Schiessscharten unterbrochen, die ein wenig Licht "
            "spenden. An einem Brocken scheint Etwas zu sein.");

  AddDetail( ({"aussichtsplattform","plattform"}),
	    "Die Plattform ist ueber Dir. Du musst nur nach oben gehen um "
            "die Aussicht zu geniessen.");
  
  AddDetail( ({"rand","felswand","ende"}),
	    "Der Turm steht am Rand der Felswand, die das Ende der Hochebene "
            "markiert.");

  AddDetail( ({"schiessscharten","scharten"}), 
            "Die Schiessscharten sind sehr schmal. Man kann den Turm "
            "normalerweise sehr gut durch die schmalen Schiessscharten "
            "verteidigen.");

  AddDetail( ({"licht"}),
	    "Ein wenig Licht faellt durch die Schiessscharten in das "
            "Obergeschoss.");

  AddDetail( ({"staub"}),
	    "Viel Staub liegt auf dem Boden. Du kannst Deine eigenen "
            "Fussspuren sehen.");

  AddDetail( ({"treppe","erdgeschoss"}),
	    "Eine schmale Treppe fuehrt wieder in das Erdgeschoss hinunter.");
  
  AddDetail( ({"schriftzeichen"}),
	    "Du kannst die Schriftzeichen lesen.");

  AddDetail( ({"brocken","etwas"}), 
            "An einem Brocken wurde anscheinend in grosser Eile mit einem "
            "spitzen Gegenstand Etwas eingeritzt. Du kannst das Gekritzel "
            "aber entziffern und lesen.");

  AddDetail( ({"fussspuren","spuren"}),
	    "Es scheinen nur Deine Spuren zu sein. Es war schon sehr lange "
            "niemand mehr hier.");

  AddDetail( ({"gekritzel"}),
	    "Du kannst es lesen.");

  AddDetail( ({"gegenstand"}),
	    "Der Gegenstand ist nicht mehr da.");

  AddDetail( ({"minute"}),
	    "Eine Minute vergeht sehr schnell.");
  
  AddDetail( ({"eile"}),
	    "Manchmal ist man in grosser Eile und probiert sich noch "
            "in der letzten Minute noch mitzuteilen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach vergangener Zeit.");  
 
  AddSmell( ({"zeit"}),
	   "Es riecht einfach nur alt.");

  AddSound(DEFAULT_SOUND, "Es ist totenstill.");

  AddReadDetail( ({"schriftzeichen"}),
		"Made in Midas.");

  AddReadDetail( ({"gekritzel"}),
		"Sie stehen unten vor der Eichentuer und probieren sie "
                "einzutreten. Noch haelt sie stand, aber die Orks werden "
                "es bald geschafft haben. Unsere Pfeile sind aufgebraucht "
                "und gleich werden wir ihnen Schwert gegen Schwert "
                "gegenueber stehen. Ich hoeren das Splittern der Tuer, sie "
                "ko...");

//-----Details Ende-----
  
AddExit("oben", ROOM "hocht3");
AddExit("unten", ROOM "hocht1");

}  
   
