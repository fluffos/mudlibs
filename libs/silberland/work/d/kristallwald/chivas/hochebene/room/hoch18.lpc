// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Die Vegetation zu beiden Seiten des Weges besteht aus kleinen "
        "Straeuchern, die sich in der Graslandschaft der Hochebene deutlich "
        "hervor tun. Am Wegrand steht ein grosser Stein, auf dem verschiedene "
        "Symbole zu erkennen sind." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"vegetation"}), 
            "Die Vegetation auf der Hochebene ist recht spaerlich. Am Wegrand "
            "stehen ein paar Straeucher, ansonsten siehst Du nur die weite "
            "Graslandschaft der Hochebene. Weiter im Sueden scheinen ein paar "
            "weisse Blumen auf ein paar Huegeln zu wachsen.");

  AddDetail( ({"seiten"}),
	    "An den Seiten des Weges wachsen ein paar Straeucher und ein "
            "grosser Stein liegt zwischen ihnen.");

  AddDetail( ({"weg","weges","sichtweise"}),
	    "Der Weg fuehrt weiter nach hoch auf die Hochebene oder von der "
            "Hochebene herunter. Kommt auf die Sichtweise an von wo man "
            "kommt.");

  AddDetail( ({"straeuchern","straeucher"}),
	    "Die Straeucher sind recht klein. Ausserdem haben sie kaum "
            "Blaetter.");
  
  AddDetail( ({"graslandschaft","landschaft"}),
	    "Du siehst ueberall Gras, Gras und nochmals Gras.");

  AddDetail( ({"hochebene","gorthad"}), 
            "Die Hochebene von Gorthad ist riesig.");

  AddDetail( ({"stein"}),
	    "Ein grosser Stein mit Symbolen steht am Wegrand. Er ist ein wenig "
            "mit Moos bewachsen, aber die Symbole kann man sehr gut erkennen.");

  AddDetail( ({"symbole","symbolen"}),
	    "Die Symbole sind uralt. Diese Art von Symbolen hast Du noch nie "
            "gesehen. Sie sind sicher Jahrhunderte alt.");

  AddDetail( ({"boden"}),
	    "Der Weg besteht aus grossen Pflastersteinen.");
  
  AddDetail( ({"himmel","sonne"}),
	    "Der Himmel ist wie immer und die Sonne scheint.");

  AddDetail( ({"wegrand"}), 
            "Am Wegrand stehen ein paar kleine verlassene Straeucher. "
            "Ausserdem ist ein grosser Stein mit Symbolen zu erkennen.");

  AddDetail( ({"sueden","huegeln","huegel"}),
	    "Im Sueden scheinen ein paar Huegel zu sein, die mit weissen "
            "Blumen bewachsen sind.");

  AddDetail( ({"blumen"}),
	    "Es sieht jedenfalls so aus, als ob es Blumen sind. Um es genau "
            "zu wissen, musst Du schon naeher heran gehen.");

  AddDetail( ({"blaetter"}),
	    "Es sieht so aus, als ob die Blaetter abgefressen wurden. Was "
            "das wohl fuer ein Tier gewesen ist.");
  
  AddDetail( ({"tier"}),
	    "Du siehst momentan kein Tier.");

  AddDetail( ({"gras","grases"}), 
            "Man koennte es auch die Hochebene des Grases nennen.");

  AddDetail( ({"moos","eindruck"}),
	    "Das Moos macht einen gesunden und gruenen Eindruck.");

  AddDetail( ({"art","jahrhunderte","jahrhunderten"}),
	    "Vor Jahrhunderten hat man anscheinend solche Symbole gemeisselt. "
            "Heute kann sie sicher keiner mehr lesen, ausser die Person lebt "
            "selbst schon Jahrhunderte.");

  AddDetail( ({"person"}),
	    "Es muss nicht unbedingt eine lebendige Person sein, die die "
            "Symbole entziffern kann.");
  
  AddDetail( ({"pflastersteinen","pflastersteine"}),
	    "Die Pflastersteine bilden einen gut begehbaren Weg.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach gar nichts.");  
 
  AddSound(DEFAULT_SOUND, "Es ist hier sehr still.");

//-----Details Ende-----
  
AddExit("suedoben", ROOM "hoch17");
AddExit("nordunten", ROOM "hoch19");

}  
   
