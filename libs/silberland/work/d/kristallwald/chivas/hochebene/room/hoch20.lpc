// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Der kleine Weg fuehrt weiter nach Norden durch die Graslandschaft, "
        "die nur ab und zu durch ein paar grosse Findlinge unterbrochen "
        "wird. Im Nordosten kann man weiterhin ein paar groessere Huegel "
        "erkennen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"weg"}), 
            "Der Weg schlaengelt sich ueber die Hochebene von Gorthad.");

  AddDetail( ({"norden"}),
	    "Der Weg fuehrt nach Norden.");

  AddDetail( ({"graslandschaft","landschaft"}),
	    "Kaum etwas unterbricht die Graslandschaft der Hochebene.");

  AddDetail( ({"findlinge"}),
	    "Direkt neben Dir, am Rand des Weges, liegen drei grosse "
            "Findlinge. Sie sind mit verschiedenen Schriftzeichen uebersaeht.");
  
  AddDetail( ({"nordosten","huegel","huegelgraeber"}),
	    "Im Nordosten sind die grossen Huegelgraeber der Hochebene zu "
            "erkennen.");

  AddDetail( ({"boden"}), 
            "Am Boden siehst Du die Pflastersteine des Weges.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau und die Sonne leuchtet ueber Dir.");

  AddDetail( ({"sonne"}),
	    "Die Sonne steht beinahe senkrecht ueber Dir.");

  AddDetail( ({"rand"}),
	    "Am Rand des Weges liegen ein paar grosse Findlinge.");

  AddDetail( ({"schriftzeichen"}),
	    "Es ist wohl eher eine Wegbeschreibung.");
  
  AddDetail( ({"wegbeschreibung","beschreibung"}),
	    "Du kannst sie lesen.");

  AddDetail( ({"pflastersteine"}), 
            "Die Pflastersteine bilden einen gut ausgebauten Weg.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Du stehst auf der Hochebene von Gorthad.");

  AddDetail( ({"gras"}),
	    "Gras ist hier ueberall.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht grasig.");  
 
  AddSmell( ({"gras"}),
	   "Gras riecht sehr doll nach Gras. Es ist nicht zu fassen.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind.");

  AddSound( ({"wind"}),
	   "Der Wind bringt das Gras ein wenig zum Rascheln.");
  
  AddSound( ({"gras","rascheln"}),
	   "*raschel*");

  AddReadDetail( ({"wegbeschreibung","beschreibung"}),
		"Auf einem der Findlinge ist etwas eingeritzt:\n"
                "       \n"
                "                  Turm von Gorthad\n"
                "                        |\n"
                "                        | \n"
                "  unbekanntes           *          Huegel-\n"
                "  Gebiet      <------------------->graeber\n");


//-----Details Ende-----
  
AddExit("nordwesten", ROOM "hoch21");
AddExit("sueden", ROOM "hoch4");

}  
   
