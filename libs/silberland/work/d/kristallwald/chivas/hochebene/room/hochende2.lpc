// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Zu beiden Seiten des Weges stehen grosse Baeume dicht nebeneinander. "
        "Zwischen den Baeumen sind ausserdem ein paar Straeucher zu sehen, die "
        "es kaum ermoeglichen tiefer in den Wald hinein zu schauen. Im Sueden "
        "hoert der Wald auf und der Weg scheint langsam anzusteigen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"seiten"}), 
            "Du siehst links und rechts des Weges grosse Baeume stehen. Ihre "
            "Staemme sind sehr dick. Die Baeume scheinen schon sehr alt zu "
            "sein.");

  AddDetail( ({"weg","weges"}),
	    "Der Weg fuehrt nach Norden weiter in den Wald hinein und nach "
            "Sueden aus dem Wald hinaus. Er ist sehr erdig und ein "
            "paar kleine Steine sind auf ihm zu erkennen.");

  AddDetail( ({"baeume","baeumen","platz"}),
	    "Die Baeume stehen sehr dicht und lassen den Straeuchern nur "
            "wenig Platz. Die Baeume bilden ein dichtes Blaetterdach, so dass "
            "der Himmel kaum zu sehen ist.");
  
  AddDetail( ({"straeucher"}), 
            "Einige kleine Straeucher stehen zwischen den grossen Baeumen. "
            "Ein Strauch faellt Dir besonders auf.");

  AddDetail( ({"wald","waldes"}),
	    "Du stehst auf einem Weg in einem Wald.");

  AddDetail( ({"sueden"}),
	    "Im Sueden scheint der Wald abrupt aufzuhoeren. Der Weg "
            "schlaengelt sich leicht bergauf auf eine Hochebene.");
  
  AddDetail( ({"himmel"}), 
            "Der Himmel wird vom Blaetterdach der Baeume fast komplett "
            "verdeckt.");

  AddDetail( ({"boden","waldboden"}),
	    "Am Boden ist viel Erde und einige kleine Steine zu sehen.");

  AddDetail( ({"staemme"}),
	    "Der Umfang der Staemme ist sehr gross. Die Baeume muessen schon "
            "seit langer Zeit hier stehen und muessen sehr alt sein. Einige "
            "gelbliche Schlingpflanzen haben sich an ihnen fest gesetzt.");
  
  AddDetail( ({"zeit","jahrhunderte"}), 
            "Es sind sicher Jahrhunderte.");

  AddDetail( ({"schlingpflanzen","gelb"}),
	    "Einige gelbe Schlingpflanzen haben sich an den Staemmen "
            "festgesetzt. Sie sehen irgendwie giftig und gefaehrlich aus.");

  AddDetail( ({"norden"}),
	    "Im Norden geht es tiefer in den Wald.");
  
  AddDetail( ({"steine"}), 
            "Kleine Kieselsteine liegen am Boden und bilden neben der Erde "
            "den kleinen Weg.");

  AddDetail( ({"kieselsteine"}),
	    "Die kleinen runden Kieselsteine sind beeindruckend "
            "uninteressant.");

  AddDetail( ({"erde","walderde","schwarz"}),
	    "Die Walderde ist sicher sehr fruchtbar. Sie hat eine fast "
            "schwarze Farbe.");
  
  AddDetail( ({"farbe"}), 
            "In einem Wald gibt es viele Farben.");

  AddDetail( ({"farben"}),
	    "Es gibt Schwarz, Gelb und verschiedene Gruentoene.");

  AddDetail( ({"gruentoene","toene","gruen"}),
	    "Die Gruentoene bewegen sich von Hellgruen bis Dunkelgruen.");
  
  AddDetail( ({"hellgruen"}), 
            "Einige Blaetter der Straeucher sind hellgruen.");

  AddDetail( ({"dunkelgruen","faerbung"}),
	    "Die Blaetter der Baeume haben meistens eine eher dunkelgruene "
            "Faerbung.");

  AddDetail( ({"blaetter"}),
	    "An den Baeumen und Straeuchern haengen viele Blaetter. So muss "
            "es auch in einem Wald sein.");
  
  AddDetail( ({"hochebene","gorthad"}), 
            "Im Sueden beginnt die Hochebene von Gorthad.");

  AddDetail( ({"blaetterdach","dach","blick"}),
	    "Das dichte Blaetterdach verhindert den Blick auf den blauen "
            "Himmel. Nur ab und zu faellt ein Lichtstrahl auf den Weg.");

  AddDetail( ({"lichtstrahl","strahl"}),
	    "Es passiert nur sehr selten, dass ein Lichtstrahl auf den "
            "Waldboden trifft.");

  AddDetail( ({"strauch"}), 
            "Der Strauch sieht ein wenig krank aus. Er hat viel weniger "
            "Blaetter als die anderen Straeucher und ein paar Aeste sehen "
            "nicht ganz in Ordnung aus.");

  AddDetail( ({"aeste","ordnung"}),
	    "Die Aeste sind anscheinend abgebrochen, als ob sich an dieser "
            "Stelle regelmaessig Lebewesen durch den Strauch zwaengen.");

  AddDetail( ({"stelle"}),
	    "Als Du die Stelle naeher untersuchst und durch den Strauch "
            "schaust, siehst Du einen kleinen Trampelpfad, der hinter dem "
            "Strauch zu beginnen scheint.");
  
  AddDetail( ({"lebewesen"}), 
            "Momentan siehst Du niemanden, der sich durch den Strauch "
            "gezwaengt hat.");

  AddDetail( ({"trampelpfad","pfad"}),
	    "Der Trampelpfad scheint haeufig genutzt zu werden. Er sieht "
            "ziemlich ausgelatscht aus.");

  AddDetail( ({"voegel"}),
	    "Die Voegel stecke irgendwo im Blaetterdach. Du kannst sie nicht "
            "sehen, aber hoeren.");

  AddDetail( ({"umfang"}), 
            "Der Umfang der Staemme ist riesig. Selbst ein grosser Troll "
            "wuerde es nicht schaffen um ihn herum zu greifen.");

  AddDetail( ({"troll","trolle"}),
	    "Trolle sind gross und dumm.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Erde.");  
 
  AddSmell( ({"erde"}),
	   "Die Erde des Waldes riecht sehr erdig.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel im Wald.");

  AddSound( ({"voegel","wald"}),
	   "Die Voegel im Wald zwitschern leise.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "hochende");
AddExit("norden", ROOM "hochende3");

AddCmd( ({"zwaeng", "zwaenge" }), "zwaengen" );

}
int zwaengen(string str)
{
   notify_fail("Wo moechtest Du Dich durchzwaengen?\n");
     	if ( member( ({"durch strauch","durch straeucher","durch aeste"})
,str) != -1) 
  {
    write(BS ( "Du zwaengst Dich durch den Strauch auf den dahinter liegenden "
               "Trampelpfad.\n"));
      TP->move( ORKHOEHLE+"/room/orks28", M_GO, 
      "ploetzlich zwischen den Aesten eines Strauches", "verschwindet", 
      "zwaengt sich herein");
    return 1;
  }
  return 0; 
}

