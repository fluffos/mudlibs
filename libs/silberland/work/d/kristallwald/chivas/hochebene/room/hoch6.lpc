// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Die Wellen des Sees plaetschern leise ans Ufer. Die sonstige "
        "Vegetation ist recht spaerlich. Vor Dir breitet sich eine weite "
        "Graslandschaft aus. Im Norden erkennst Du einige grosse Huegel." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wellen"}), 
            "Ein paar kleine Wellen plaetschern an das Ufer, welches direkt "
            "an den Weg reicht.");

  AddDetail( ({"sees","see","rand"}),
	    "Der See liegt direkt am Rand des Weges.");

  AddDetail( ({"ufer"}),
	    "Am Ufer des Sees wachsen ein paar Pflanzen.");

  AddDetail( ({"vegetation"}),
	    "Ausser Gras und ein paar Pflanzen am Ufer ist die Vegetation "
            "recht eintoenig.");
  
  AddDetail( ({"graslandschaft","landschaft"}),
	    "Die Graslandschaft erstreckt sich ueber die gesamte Hochebene.");

  AddDetail( ({"norden"}), 
            "Im Norden sind ein paar Huegel zu erkennen.");

  AddDetail( ({"huegel"}),
	    "Die Huegel sind noch sehr weit im Norden. Du erkennst sie nur "
            "schemenhaft.");

  AddDetail( ({"boden"}),
	    "Der Weg auf dem Du stehst, ist in einem hervorragenden Zustand. "
            "Obwohl er vor Jahrhunderten angelegt wurde, ist er tadellos.");

  AddDetail( ({"himmel","sonne"}),
	    "Die Sonne steht fast senkrecht am Himmel.");
  
  AddDetail( ({"zustand"}),
	    "Wenn Du in dem Zustand des Weges waerst, wuerdest Du eindeutig "
            "besser aussehen.");

  AddDetail( ({"weg","weges"}), 
            "Der Weg fuehrt am Ufer des Sees entlang.");

  AddDetail( ({"hochebene"}),
	    "Dies ist die grosse Hochebene von Gorthad.");

  AddDetail( ({"pflanzen"}),
	    "Am Ufer steht ein wenig Schilf und ein paar Blumen.");

  AddDetail( ({"schilf","blumen"}),
	    "Die Blumen und das Schilf am Ufer gedeihen sehr gut.");
  
  AddDetail( ({"gras"}),
	    "Das Gras waechst ungefaehr kniehoch auf der Hochebene.");

  AddDetail( ({"gorthad"}), 
            "Du befindest Dich auf der Hochebene von Gorthad.");

  AddDetail( ({"jahrhunderten","jahrhunderte","bau"}),
	    "Der Bau des Weges ist Jahrhunderte her. Damals wusste man noch "
            "wie man einen anstaendigen Weg baut.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen am Ufer des Sees duften herrlich.");

  AddSound(DEFAULT_SOUND, "Du hoerscht die Wellen sanft an das Ufer plaetschern.");

  AddSound( ({"wellen"}),
	   "*plaetscher*");
  
//-----Details Ende-----
  
AddExit("nordosten", ROOM "hoch7");
AddExit("sueden", ROOM "hoch2");

}  
   
