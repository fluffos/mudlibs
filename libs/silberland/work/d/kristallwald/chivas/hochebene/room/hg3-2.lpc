// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Huegelgrab");
  SetProp( P_INT_LONG,
	"Hier in der Grabkammer gibt es keinen einzelnen Sarg. An den Waenden "
        "gibt es ein Dutzend Einbuchtungen, in die man die gefallenen Krieger "
        "gelegt hat. An der Decke haengen grosse Spinnenweben und eine dicke "
        "Staubschicht des Vergessens liegt ueber allem. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 0 );

//-----Details Anfang-----
  
  AddDetail( ({"grabkammer"}), 
            "Du stehst in der Grabkammer. In den Einbuchtungen wurden grosse "
            "Krieger einer laengst vergessenen Schlacht begraben. Ueberall "
            "am Boden stehen wertvolle Grabbeigaben.");

  AddDetail( ({"sarg"}),
	    "Es gibt keinen Sarg, nur die Einbuchtungen, in denen die "
            "Krieger bestattet wurden.");

  AddDetail( ({"waende","waenden","wand"}),
	    "An den Waenden sind lauter Einbuchtungen. An der Rueckseite "
            "des Huegelgrabes steht eine grosse Truhe. Ansonsten sind die "
            "Waende wie die Decke aus Stein.");

  AddDetail( ({"dutzend","einbuchtungen"}),
	    "In den Einbuchtungen wurden grosse Krieger bestattet.");
  
  AddDetail( ({"krieger"}),
	    "Die Krieger, die hier bestattet wurden, liegen in ihrer "
            "kompletten Ausruestung in den Einbuchtungen. Sie strahlen eine "
            "Art von Wuerde und Respekt aus.");

  AddDetail( ({"spinnenweben"}), 
            "Die Spinnenweben sind alt und verlassen. Hier lebt nichts mehr.");

  AddDetail( ({"staubschicht","staub","schicht","vergessens"}),
	    "Die Staubschicht am Boden ist sehr dick. Du kannst sehr deutlich "
            "Deine eigenen Fussspuren sehen.");

  AddDetail( ({"decke"}),
	    "Die Decke ist bis auf die grossen Spinnenweben komplett kahl.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit Staub bedeckt. Einige kleine Statuen stehen "
            "ausserdem auf dem Boden.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist hier die Decke.");

  AddDetail( ({"schlacht"}), 
            "Die Schlacht ist schon Jahrhunderte her.");

  AddDetail( ({"grabbeigaben","beigaben"}),
	    "Obwohl die Grabbeigaben mit Staub bedeckt sind, erkennst Du "
            "kleine prunkvolle Statuen und eine grosse Truhe.");

  AddDetail( ({"jahrhunderte"}),
	    "Das ist sehr lange her.");

  AddDetail( ({"statuen"}),
	    "Die kleinen mit Staub bedeckten Statuen bestehen aus Gold und "
            "sind mit wertvollen Opalen bedeckt. Sie sind ein Meisterstueck "
            "der Schmiedekunst.");
  
  AddDetail( ({"stein"}),
	    "Die Decke und die Waende sind aus Stein.");

  AddDetail( ({"rueckseite"}), 
            "An der Rueckseite steht eine grosse schwere Truhe. Ansonsten sind "
            "lauter Verzierungen an ihr zu sehen.");

  AddDetail( ({"huegelgrabes","huegelgrab","grab"}),
	    "Du befindest Dich in einem Huegelgrab.");

  AddDetail( ({"verzierungen"}),
	    "Die Verzierungen wurden in den Stein geritzt. Sie stellen eine "
            "Kampfszene dar.");

  AddDetail( ({"kampfszene","kampf","menschen","orks","szene","schlacht"}),
	    "Die Kampfszene zeigt den Kampf zwischen Menschen und Orks. Es ist "
            "eine Szene aus der grossen Schlacht.");
  
  AddDetail( ({"gold"}),
	    "Gold ist sehr wertvoll.");

  AddDetail( ({"opalen","opale"}), 
            "Die Opale sind matt, was jedoch auch an dem Staub liegen kann.");

  AddDetail( ({"meisterstueck","schmiedekunst","zwergen","zwerge","schmiede"}),
	    "Die Statuen wurden sicher von Zwergen hergestellt. Sie sind "
            "bekannt als die besten Schmiede im Silberland.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland.");

  AddDetail( ({"fussspuren"}),
	    "Sie zeichnen sich sehr deutlich im Staub ab.");
  
  AddDetail( ({"ausruestung","schwerter"}),
	    "Die schillerne Ausruestung und die Schwerter der bestatteten "
            "Krieger ist ein wenig matt geworden. Sie muessen einmal sehr "
            "wertvoll gewesen sein.");

  AddDetail( ({"art","wuerde","respekt"}), 
            "Sie sehen immer noch wie grosse Krieger aus. Sie sehen eher aus, "
            "als ob sie schlafen wuerden.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({"nase"}),
	    "Du hast eine sehr grosse Nase.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Staub.");  
 
  AddSmell( ({"staub"}),
	   "Der Staub kitzelt Dich in der Nase und Du musst niesen.");

  AddSound(DEFAULT_SOUND, "Es ist totenstill.");

//-----Details Ende-----
AddItem(OBJ "truhe", REFRESH_DESTRUCT);
  
AddExit("osten", ROOM "hg3-1");

}  
   
