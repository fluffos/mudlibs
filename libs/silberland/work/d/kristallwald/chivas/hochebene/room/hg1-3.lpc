// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Huegelgrab");
  SetProp( P_INT_LONG,
	"Du befindest Dich in einer Grabkammer. Genau vor Dir befindet sich "
        "ein steinerner Sarg, der jedoch aufgebrochen wurde, um die darin "
        "enthaltenen Schaetze zu stehlen. An den Waenden sind verschiedene "
        "Einbuchtungen, in denen Skelette grosser Krieger liegen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 0 );
  
//-----Details Anfang-----
  
  AddDetail( ({"grabkammer","kammer"}), 
            "Die Grabkammer ist duester und ein totales Chaos herrscht hier.");

  AddDetail( ({"sarg"}),
	    "Der Sarg ist aufgebrochen. Etwas ist in dem steinernden Sarg zu "
            "erkennen.");

  AddDetail( ({"schaetze"}),
	    "Schaetze gibt es in dieser Grabkammer nicht mehr. Alles was von "
            "Wert war haben die Grabraeuber mitgenommen.");

  AddDetail( ({"waende","waenden","wand"}),
	    "An den Waenden gibt es grosse Einbuchtungen, in denen Skelette "
            "bedeutender Krieger liegen.");
  
  AddDetail( ({"einbuchtungen"}),
	    "In den Einbuchtungen liegen die Skelette bedeutender Krieger, "
            "denen die Ehre zu Teil geworden ist im Koenigsgrab bestattet zu "
            "werden.");

  AddDetail( ({"skelette","plaetzen"}), 
            "Die Skelette in den Einbuchtungen liegen nicht mehr ordentlich "
            "an ihren Plaetzen. Sie wurden durchsucht und ausgepluendert. Die "
            "einzelnen Knochen liegen wild durcheinander. Diese Schaendung "
            "haben diese ehrenvollen Krieger nicht verdient gehabt.");

  AddDetail( ({"krieger"}),
	    "Grosse Krieger und andere wichtige Persoenlichkeiten wurden hier "
            "in dieser Kammer bestattet.");

  AddDetail( ({"boden"}),
	    "Auf dem Boden herrscht absolutes Chaos.");

  AddDetail( ({"decke"}),
	    "Die Decke ist schlicht und besteht aus Stein. Einige Spinnenweben "
            "haengen an ihr.");
  
  AddDetail( ({"himmel"}),
	    "Einen Himmel gibt es hier in der Grabkammer nicht.");

  AddDetail( ({"chaos"}), 
            "Alte verrostete Waffen, alte Ruestungsteile und der zerbrochene "
            "Sargdeckel liegen auf dem Boden. Die Grabkammer wurde anscheinend "
            "von Grabraeubern geschaendet.");

  AddDetail( ({"grabraeuber","grabraeubern","raeuber"}),
	    "Die Raeuber sind schon vor langer Zeit weiter gezogen.");

  AddDetail( ({"zeit"}),
	    "Anhand des Staubes, der sich auf das Chaos am Boden gelegt hat, "
            "ist damit zu rechnen, dass es schon lange her ist.");

  AddDetail( ({"staub","staubschicht"}),
	    "Eine dicke Staubschicht bedeckt alles in der Kammer.");
  
  AddDetail( ({"waffen"}),
	    "Die Waffen am Boden und in den Einbuchtungen sind alt und "
            "verrostet. Waeren sie wertvoll gewesen, haetten die Grabraeuber "
            "sie sicher mitgenommen.");

  AddDetail( ({"ruestungsteile","metall","leder","teile","ruestungen"}), 
            "Die Ruestungsteile sind nicht mehr zu gebrauchen. Das Metall an "
            "den Ruestungen sind verrostet und die Teile aus Leder fast "
            "verrottet.");

  AddDetail( ({"sargdeckel","deckel"}),
	    "Der Deckel des Sarges liegt zerbrochen am Boden. Man erkennt noch "
            "ein paar Ornamente und Schriftzeichen auf ihm.");

  AddDetail( ({"ornamente"}),
	    "Die Ornamente zeigen Schlachten vor einer halben Ewigkeit.");

  AddDetail( ({"schriftzeichen","zeichen"}),
	    "Du kannst sie gerade noch lesen.");
  
  AddDetail( ({"ewigkeit"}),
	    "Das ist sehr sehr sehr lange her.");

  AddDetail( ({"schlachten"}), 
            "Die Krieger sind anscheinend in grossen Schlachten ums Leben "
            "gekommen.");

  AddDetail( ({"leben"}),
	    "Du hast Dein Leben noch.");

  AddDetail( ({"etwas"}),
	    "Die mumifizierte Leiche eines grossen Krieges liegt in dem Sarg.");

  AddDetail( ({"leiche","mumie"}),
	    "Obwohl das Grab geschaendet wurde und die Mumie gepluendert "
            "wurde, strahlt sie immer noch Wuerde und Macht aus.");
  
  AddDetail( ({"wuerde"}),
	    "So etwas kann man nicht lernen. So etwas hat man einfach.");

  AddDetail( ({"macht"}), 
            "Der Krieger in dem Sarg muss viel Macht besessen haben, ansonsten "
            "haette er hier keinen eigenen Sarg im Huegelgrab der "
            "Koenigsfamilie.");

  AddDetail( ({"koenigsfamilie"}),
	    "Dieses grosse Huegelgrab gehoert der Koenigsfamilie.");

  AddDetail( ({"huegelgrab"}),
	    "Du bist im Huegelgrab der Koenigsfamilie. Es wurde leider "
            "aufgebrochen und geschaendet.");

  AddDetail( ({"wert","archaeologe"}),
	    "Es gibt hoechstens noch einen archaeologischen Wert. Da Du aber "
            "kein Archaeologe bist, kannst Du mit dem Wert nicht viel "
            "anfangen.");
  
  AddDetail( ({"koenigsgrab"}),
	    "Du bist im Huegelgrab des Koenigs. Er wurde aber nicht in dieser "
            "Grabkammer bestattet.");

  AddDetail( ({"koenig","koenigs"}),
	    "Der Koenig wurde nicht in dieser Grabkammer bestattet.");

  AddDetail( ({"schaendung"}),
	    "Eine ueble Schaendung der letzten Ruhestaette grosser Krieger "
            "wurde hier begangen.");

  AddDetail( ({"ruhestaette"}),
	    "Eine Ruhestaette wie diese waere ganz nett, nur nicht "
            "aufgebrochen und ausgeraubt.");
  
  AddDetail( ({"persoenlichkeiten"}),
	    "Vielleicht steht etwas auf dem zerbrochenen Sargdeckel.");

  AddDetail( ({"stein"}),
	    "Die Decke besteht wie die ganze Grabkammer aus Stein.");

  AddDetail( ({"spinnenweben"}),
	    "Die Spinnenweben wurden schon lange von ihren Besitzern "
            "verlassen.");

  AddDetail( ({"besitzern","besitzer","spinnen"}),
	    "Damit sind Spinnen gemeint. Was denkst Du denn?");
  
  AddDetail( ({"knochen"}),
	    "Die Knochen in den Einbuchtungen liegen wild durcheinander. ");
  
  AddDetail( ({"ehre","teil"}),
	    "Die Ehre ist nur den besten Kriegern zu Teil geworden.");
   
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Staub.");  
 
  AddSmell( ({"staub"}),
	   "Du musst laut niesen.");

  AddSound(DEFAULT_SOUND, "Es ist totenstill.");

  AddReadDetail( ({"schriftzeichen","zeichen"}),
		"+----------------------------------------+\n"
                "|                                        |\n"
                "|    Hier liegt der erste Ritter der     |\n"
                "|    des Koenigs begraben.               |\n"
                "|                                        |\n"
                "|        Grundred, der Tapfere           |\n"
                "|                                        |\n"
                "|    Sein Name soll fuer ewig in Ehren   |\n"
                "|    gehalten werden.                    |\n"
                "|                                        |\n"
                "+----------------------------------------+\n");


//-----Details Ende-----
  
AddExit("suedwesten", ROOM "hg1-1");

}  
   
