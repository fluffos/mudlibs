// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einer steilen Felswand");
  SetProp( P_INT_LONG,
	"Du befindest Dich auf einem sehr schmalen Pfad, der dicht an einer "
        "zerkluefteten Felswand entlang fuehrt. Am Boden liegen kleinere "
        "Steine, die den Untergrund sehr locker und unbefestigt machen. "
        "Direkt im Fels der Wand haben sich einige Flechten festgesetzt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"pfad","pfades"}), 
            "Der kleine Pfad fuehrt direkt an der Felswand steil hinunter.");

  AddDetail( ({"felswand","fels","wand"}),
	    "Die Felswand faellt beinahe senkrecht ab. Ein falscher Schritt "
            "auf dem Pfad und man ist des Todes.");

  AddDetail( ({"boden"}),
	    "Der Boden des Pfades ist sehr steinig und locker durch die "
            "Steine.");

  AddDetail( ({"steine"}),
	    "Kleine Steine liegen auf dem Pfad.");
  
  AddDetail( ({"untergrund"}),
	    "Der Untergrund ist durch die kleinen Steine sehr locker und "
            "unbefestigt. Du solltest aufpassen, damit Du nicht in die Tiefe "
            "stuerzt.");

  AddDetail( ({"flechten"}), 
            "Ein paar Flechten haben sich in den Rissen in der Felswand "
            "festgesetzt.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau. Einige Voegel fliegen direkt an der "
            "Felswand entlang.");

  AddDetail( ({"voegel"}),
	    "Sie fliegen unter der Sonne und scheinen den Wind auszunutzen, "
            "der an der Felswand weht.");

  AddDetail( ({"sonne"}), 
            "Die Sonne waermt Dich und Du fuehlst Dich gut.");

  AddDetail( ({"wind"}),
	    "Er weht recht stark an der Felswand entlang.");
  
  AddDetail( ({"rissen","risse","teil"}),
	    "Die Risse in der Felswand sind in diesem oberen Teil recht "
            "klein. Einige Pflanzen haben sich in ihnen festgesetzt.");

  AddDetail( ({"pflanzen"}), 
            "Neben den Flechten siehst Du ein paar Moose und ein wenig Gras.");

  AddDetail( ({"moose","moosen"}),
	    "Die Moose leuchten in einer gruenen Farbe.");

  AddDetail( ({"farbe"}),
	    "Die Farbe sieht gesund aus. Den Moosen scheint es gut zu gehen.");

  AddDetail( ({"gras","graeser"}),
	    "Die Samen der Graeser sind sicher von der Hochebene hier her "
            "geweht worden und haben sich hier festgesetzt.");
  
  AddDetail( ({"hochebene","gorthad"}),
	    "Die Hochebene von Gorthad liegt oberhalb der Felswand.");

  AddDetail( ({"samen","samenkoerner","koerner"}), 
            "Die Samenkoerner der Graeser sind so leicht, dass sie sehr gut "
            "vom Wind hier her getragen werden konnten. ");

  AddDetail( ({"tiefe"}),
	    "Es geht sehr weit nach unten.");

  AddDetail( ({"schritt"}),
	    "Ein falscher Schritt und man besucht Tod.");

  AddDetail( ({"todes","tod","meint","mich"}),
	    "Tod taucht hinter Dir auf und sagt: ER MEINT MICH! Daraufhin "
            "verschwindet Tod wieder.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Gras.");  
 
  AddSmell( ({"geruch","gras","grases"}),
	   "Der Geruch des Grases stammt von der Hochebene.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Kreischen der Voegel.");

  AddSound( ({"kreischen","voegel"}),
	   "Einige Voegel nutzen den Wind, der an der Felswand entlang weht.");
  
//-----Details Ende-----
  
AddExit("ostoben", ROOM "hoch5");
AddExit("unten", ROOM "hoche3");

}  
   
