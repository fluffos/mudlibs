// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Die Stille und die Graslandschaft um Dich herum, die nur durch "
        "eine leichte Brise bewegt wird, wirken sehr friedlich auf Dich. "
        "Wenn Du nicht wuesstest, das Gorthad Huegelgrab heisst, waere es "
        "wirklich ein romantischer Ort." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"stille","ruhe"}), 
            "Es ist hier sehr ruhig. Man kann hier sicher ideal idlen.");

  AddDetail( ({"graslandschaft","landschaft"}),
	    "Die Graslandschaft um Dich herum verstaerkt die Ruhe, die hier "
            "herrscht. Es gibt nichts ausser Gras zu sehen. Im Nordosten "
            "scheinen einige Huegel auf der Hochebene zu sein.");

  AddDetail( ({"brise"}),
	    "Eine leichte Brise streicht ueber die Graslandschaft.");

  AddDetail( ({"gorthad"}),
	    "Gorthad heisst auf elfisch Huegelgrab.");
  
  AddDetail( ({"huegelgrab","huegelgraeber"}),
	    "Die Huegelgraeber sind im Nordosten. Du erkennst einige Huegel, "
            "die sich leicht von der Graslandschaft abheben.");

  AddDetail( ({"ort"}), 
            "Ein romantischer Ort heisst nicht Huegelgrab in einer anderen "
            "Sprache.");

  AddDetail( ({"boden"}),
	    "Der Weg ist mit grossen Steinen ausgelegt.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen blau.");

  AddDetail( ({"sonne"}),
	    "Die Sonne laechelt Dich vom Himmel her an.");

  AddDetail( ({"nordosten","huegel"}),
	    "Um zu den Huegeln im Nordosten zu kommen, musst Du wohl den Weg "
            "nach Suedosten waehlen. Die Huegel sind sicher die beruehmten "
            "Huegelgraeber von Gorthad.");
  
  AddDetail( ({"suedosten","norden"}),
	    "Der Weg geht nach Norden und nach Suedosten.");

  AddDetail( ({"weg"}), 
            "Der Weg fuehrt ueber die ganze Hochebene.");

  AddDetail( ({"hochebene"}),
	    "Du bist auf der Hochebene von Gorthad.");

  AddDetail( ({"sprache","sprachen"}),
	    "Es gibt viele verschiedene Sprachen.");

  AddDetail( ({"steinen","steine","pflastersteine"}),
	    "Die grossen Pflastersteine bilden einen breiten Weg auf dem man "
            "hervorragend gehen kann.");
  
  AddDetail( ({"gras"}),
	    "Die ganze Hochebene ist mit Gras bewachsen. Es sind keinerlei "
            "Baeume oder Straeucher zu sehen. Nur Gras, Gras und Gras.");

  AddDetail( ({"baeume","straeucher"}), 
            "Um Baeume und Straeucher zu sehen, musst Du die Hochebene wohl "
            "verlassen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Abenteurern.");  
 
  AddSmell( ({"abenteurern","abenteurer"}),
	   "Eigentlich bist Du das. Du solltest Dich mal wieder waschen.");

  AddSound(DEFAULT_SOUND, "Du hoerst eine unglaubliche Stille.");

  AddSound( ({"stille"}),
	   "-------------------------");

//-----Details Ende-----
AddItem(NPC "orkkrieger", REFRESH_DESTRUCT);
  
AddExit("norden", ROOM "hoch22");
AddExit("suedosten", ROOM "hoch20");

}  
   
