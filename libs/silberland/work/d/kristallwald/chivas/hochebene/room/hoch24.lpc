// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Im Norden scheint ein grosser alter Turm zu stehen, der sich direkt "
        "am Rand der Hochebene befindet. Der Weg fuehrt weiter am Rand weiter "
        "nach Norden auf den Turm zu." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"norden"}), 
            "Im Norden ist ein grosser alter Turm zu sehen.");

  AddDetail( ({"turm"}),
	    "Der grosse alte Turm ist von außen ganz schwarz. Um ihn genauer "
            "zu untersuchen, musst Du schon hingehen.");

  AddDetail( ({"rand"}),
	    "Der Weg fuehrt direkt am Rand der Hochebene entlang. Es geht fast "
            "senkrecht hinunter. Unten kannst Du das Blaetterdach eines "
            "grossen Waldes erkennen.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Du bist auf der Hochebene von Gorthad. Die ganze Hochebene ist "
            "mit Gras bedeckt.");
  
  AddDetail( ({"weg"}),
	    "Der Weg fuehrt nach Norden auf einen Turm zu.");

  AddDetail( ({"gras"}),
	    "Das Gras neben dem Weg waechst ungefaehr kniehoch.");

  AddDetail( ({"boden"}), 
            "Der Boden des Weges ist mit grossen Pflastersteinen ausgelegt.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen blau. Nur am noerdlichen Horizont scheinen "
            "ein paar Wolken aufzuziehen.");

  AddDetail( ({"blaetterdach","waldes","wald"}),
	    "Ein grosser dichter Wald ist unterhalb der Hochebene zu "
            "sehen. Er ist eigentlich gar nicht weit weg. Ein Schritt ueber "
            "den Rand und Du bist in ein paar Sekunden unten im Wald.");

  AddDetail( ({"schritt","sekunden"}),
	    "Du bist zwar in ein paar Sekunden unten im Wald, kannst es aber "
            "sicher nicht geniessen, da Dir Gevatter Tod sicher recht schnell "
            "auf die Schulter klopfen wird.");
  
  AddDetail( ({"gevatter","tod"}),
	    "Du hast eigentlich nicht vor Gevatter Tod so schnell zu treffen.");

  AddDetail( ({"schulter"}), 
            "Du hast sogar zwei davon.");

  AddDetail( ({"horizont","wolken"}),
	    "Die Wolken sind weiss und verdecken nicht die Sonne.");

  AddDetail( ({"sonne"}), 
            "Die Sonne scheint sehr hell.");

  AddDetail( ({"pflastersteinen","pflastersteine","steine"}),
	    "Die grossen Pflastersteine bilden einen schoenen Weg.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nur nach Gras und Wald.");  
 
  AddSmell( ({"gras"}),
	   "Es riecht grasig.");

  AddSmell( ({"wald"}),
	   "Der Wald unterhalb der Hochebene riecht harzig.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind ueber die Hochebene wehen.");

  AddSound( ({"wind"}),
	   "Der Wind bringt das Gras leise zum Rascheln.");
  
  AddSound( ({"rascheln","gras"}),
	   "*raschel*raschel*raschel*");

//-----Details Ende-----
AddItem(NPC "geist", REFRESH_DESTRUCT);
  
AddExit("norden", ROOM "hoch25");
AddExit("suedosten", ROOM "hoch23");

}  
   
