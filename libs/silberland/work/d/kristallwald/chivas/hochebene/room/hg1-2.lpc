// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Huegelgrab");
  SetProp( P_INT_LONG,
	"Der steinerne Sarkophag des Koenigs ist aufgebrochen und die "
        "steinerne Grabplatte "
        "liegt zerbrochen auf dem Boden. An den Waenden haengen erloschene "
        "Fackeln, die schon seit Jahrhunderten nicht mehr angezuendet wurden. "
        "Ausserdem erkennt man verschiedene Zeichnungen an den Waenden." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 0 );

//-----Details Anfang-----
  
  AddDetail( ({"sarkophag"}), 
            "Der steinerne Sarkophag ist aufgebrochen und die grosse "
            "Grabplatte liegt zerbrochen auf dem Boden. Der Sarkophag ist "
            "ueberall mit Schriftzeichen verziert. Da die Grabplatte nicht "
            "mehr auf dem Sarkophag liegt, kann man in den Sarkophag "
            "schauen.");

  AddDetail( ({"grabplatte","platte"}),
	    "Die Grabplatte ist zerbrochen und liegt auf dem Boden.");

  AddDetail( ({"boden"}),
	    "Der Boden ist sehr staubig und eine grosse zerbrochene Grabplatte "
            "liegt neben dem Sarkophag.");

  AddDetail( ({"waende","waenden","wand"}),
	    "Die Waende bestehen wie der Boden und die Decke aus Stein. An den "
            "Waenden haengen ein paar erloschene Fackeln. Ein paar Zeichnungen "
            "sind auch zu erkennen.");
  
  AddDetail( ({"fackeln"}),
	    "Die Fackeln sind schon seit langer Zeit erloschen. Sie werden "
            "nie wieder Licht spenden.");

  AddDetail( ({"jahrhunderte","jahrhunderten","zeit"}), 
            "Es ist schon sehr lange her.");

  AddDetail( ({"koenig","koenigs"}),
	    "Die hier scheint die Grabkammer des Koenigs zu sein.");

  AddDetail( ({"schriftzeichen","zeichen"}),
	    "Du kannst sie lesen.");

  AddDetail( ({"leere"}),
	    "Gaehnende Leere ist sehr wenig.");
  
  AddDetail( ({"skelett"}),
	    "Es ist kein Skelett zu sehen.");

  AddDetail( ({"stein"}), 
            "Die Waende, der Boden und die Decke bestehen aus uninteressantem "
            "Stein.");

  AddDetail( ({"licht"}),
	    "Die Fackeln an der Wand werden kein Licht mehr spenden.");

  AddDetail( ({"decke"}),
	    "Die Decke sieht so trostlos aus wie der Rest der Kammer. Es sind "
            "nur ein paar verlassene Spinnenweben zu erkennen.");

  AddDetail( ({"grabkammer","kammer"}),
	    "Fuer die Grabkammer des Koenigs sieht diese Grabkammer sehr "
            "trostlos aus. Man haette eindeutig mehr erwarten koennen.");
  
  AddDetail( ({"rest"}),
	    "Die ganze Grabkammer sieht recht trostlos aus.");

  AddDetail( ({"spinnenweben","besitzern","besitzer","fetzen"}), 
            "Die Spinnenweben haengen in Fetzen von der Decke. Sie wurden "
            "schon vor langer Zeit von ihren Besitzern verlassen.");

  AddDetail( ({"zeichnungen","schlachtfeld","zeichnung"}),
	    "Die Zeichnungen zeigen den Koenig auf dem Schlachtfeld in "
            "verschiedenen Variationen.");

  AddDetail( ({"variation","variationen"}),
	    "Es gibt insgesamt vier verschiedene Variationen in denen der "
            "Koenig abgebildet ist.");

  AddDetail( ({"variation 1","variation eins","pferd"}),
	    "Der Koenig stuermt auf seinem Pferd seiner Armee voran um die "
            "feindlichen Orks niederzumetzeln.");
  
  AddDetail( ({"armee"}),
	    "Der Koenig hatte damals sicher eine grosse Armee.");

  AddDetail( ({"ork","orks","feinde"}), 
            "Die Orks waren die Feinde der Menschen.");

  AddDetail( ({"menschen"}),
	    "Menschen wurden hier in den Huegelgraebern bestattet.");

  AddDetail( ({"huegelgraebern","huegelgraeber","huegelgrab"}),
	    "Du bist in einem Huegelgrab.");

  AddDetail( ({"variation 2","variation zwei"}),
	    "Der Koenig scheint auf dieser Zeichnung eine Rede an seine "
            "Krieger zu halten.");
  
  AddDetail( ({"rede","kampf","mut"}),
	    "Es war sicher eine aufpeitschende Rede um den Kriegern Mut fuer "
            "den Kampf zu machen.");

  AddDetail( ({"krieger","kriegern"}), 
            "Grosse Krieger haben mit dem Koenig gekaempft.");

  AddDetail( ({"variation 3","variation drei"}),
	    "Der Koenig scheint Nachrichten von einem Herold zu bekommen.");

  AddDetail( ({"nachrichten"}),
	    "Aktuelle Nachrichten sind in einer Schlacht ueberlebenswichtig.");

  AddDetail( ({"schlacht"}),
	    "Es war eine grosse Schlacht zwischen den Menschen und den Orks.");
  
  AddDetail( ({"herold","bericht","herolde"}),
	    "Hoffentlich haben die Herolde immer rechtzeitig dem Koenig "
            "Bericht erstattet.");

  AddDetail( ({"variation 4","variation vier","kaffeetrinken"}),
	    "Der Koenig sitzt beim Kaffeetrinken mit Tod und Lars. "
            "Tod und Lars scheinen auf ihn einzureden, um ihm klar zu machen, "
            "dass er das Ende der Schlacht nicht mehr miterleben kann. Der "
            "Koenig scheint ein wenig erzuernt ueber diese Informationen.");

  AddDetail( ({"tod"}),
	    "Du willst ihn nicht wirklich kennenlernen.");

  AddDetail( ({"nase"}),
	    "Deine Nase ist ziemlich gross und ein noch groesserer Pickel ist "
            "zu sehen.");

  AddDetail( ({"pickel"}),
	    "Der Pickel ist wirklich ekelig.");
 
  AddDetail( ({"lars","gutes"}),
	    "Lars ist zwar sehr nett, aber wenn Du ihn triffst, hat das auch "
            "nichts Gutes zu bedeuten.");

  AddDetail( ({"ende"}), 
            "Alles hat irgendwann ein Ende.");

  AddDetail( ({"informationen"}),
	    "Informationen sind sehr wichtig, obwohl sie manchmal auch "
            "schmerzhaft sein koennen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Der Staub kitzelt Dir in der Nase.");  
 
  AddSmell( ({"nase","staub"}),
	   "Du musst niesen.");

  AddSound(DEFAULT_SOUND, "Es ist totenstill.");

  AddReadDetail( ({"schriftzeichen"}),
		"+------------------------------------------------+\n"
                "|                                                |\n"
                "|    Hier liegt Crogan, Koenig der Normaden      |\n"
                "|                                                |\n"
                "+------------------------------------------------+\n");


//-----Details Ende-----
  
AddExit("westen", ROOM "hg1-1");

AddCmd( ({"wir" }), "wir" );
AddCmd( ({"schau","schaue" }), "schauen" );

}
int wir(string str)
{
   notify_fail("");
   if ( member( ({"sind da"})
,str) != -1) 
  {
  if((present("CHIVASGEIST", TO)))
  {
    write( BSA("Aha, danke Dir, dass Du mich hier in die Kammer"
           "gefuehrt hast. Jetzt kann ich dem Koenig endlich die Nachricht"
           "ueberbringen, die er waehrend der Schlacht gebraucht haette.", "Der kleine Geist sagt: "));
    write( BS("Daraufhin schwebt der Geist durch einen ploetzlich aufgetauchten "
           "Ausgang im Osten und verschwindet." ));
    say(BS(TP->Name(WEN)+" unterhaelt sich kurz mit einem Geist, der sich darauf "
       "hin in Luft aufloest. Ausserdem oeffnet sich wie von Geisterhand im "
       "Osten ein Durchgang."));
    AddExit("osten", ROOM "hg1-5");
    present("CHIVASGEIST")->remove();
    if (present("geistinvis",TP))
    present("geistinvis",TP)->remove();
    return 1;
  }
  else
  {
    write(BS("Leider geht das so nicht. Du hast doch niemanden hier "
             "her gefuehrt, oder?"));
    return 0;
  }
}
}
int schauen(string str)
{
   if ( member( ({"in sarkophag","in sarg"})
,str) != -1) 
  {
    write(BS( "Als Du in den Sarkophag schaust, bist Du erstaunt, da in "
           "dem Sarkophag gaehnende Leere herrscht. Nicht einmal ein "
           "Skelett ist zu sehen. Ob hier wirklich der Koenig "
           "bestattet wurde?\n"));
    say( TPN+" schaut in den Sarkophag.\n");
    return 1;
  }
  return 0; 
}
   
