// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Der Weg fuehrt weiter nach Norden auf Etwas zu, dass Du schon "
        "schemenhaft im Norden erkennen kannst. Eine leichte Brise weht "
        "ueber die Graslandschaft der Hochebene." );

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"weg"}), 
            "Der Weg fuehrt weiter in Richtung Norden. Der Weg scheint bei "
            "einem Gebaeude zu enden.");

  AddDetail( ({"norden","richtung"}),
	    "Im Norden scheint ein Gebaeude zu stehen.");

  AddDetail( ({"etwas"}),
	    "Es scheint ein grosses schwarzes Gebaeude zu sein.");

  AddDetail( ({"brise"}),
	    "Ein leichter Wind weht ueber die Hochebene.");
  
  AddDetail( ({"graslandschaft","landschaft"}),
	    "Das Gras der weiten Graslandschaft bewegt sich durch den Wind "
            "ganz leicht.");

  AddDetail( ({"hochebene"}), 
            "Die Hochebene scheint nur aus Gras zu bestehen.");

  AddDetail( ({"gras"}),
	    "Gras, Gras und nochmals Gras!");

  AddDetail( ({"wind"}),
	    "Der Wind, der Wind, das himmlische Kind.");

  AddDetail( ({"kind"}),
	    "Ein einsames Kind ist nun wirklich nicht auf der Hochebene zu "
            "sehen. Falls das der Fall waere, waerst Du sicher nicht die "
            "richtige Person, die sich um ein Kind kuemmern sollte.");

  AddDetail( ({"fall","woody","dank"}),
	    "Der Fall tritt ja, Woody sei Dank, nicht ein.");

  AddDetail( ({"person"}),
	    "Jeder, nur nicht Du!");

  AddDetail( ({"boden"}),
	    "Der Boden besteht aus grossen Steinen, die den Weg bilden. "
            "Ansonsten siehst Du viel Gras am Boden.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen blau und die Sonne scheint.");

  AddDetail( ({"sonne"}),
	    "Als Du zur Sonne hochschaust, siehst Du kurz, wie Tod an der "
            "Sonne vorbei reitet um seinen Job zu machen.");

  AddDetail( ({"job"}),
	    "Der Job von Tod ist sehr hart.");

  AddDetail( ({"tod"}),
	    "Du willst ihn nicht wirklich treffen und auch nicht wirklich "
            "untersuchen.");
  
  AddDetail( ({"gebaeude"}),
	    "Es sieht wie ein grosser Turm aus.");

  AddDetail( ({"turm","entfernung"}), 
            "Der Turm ist auf diese Entfernung nur sehr schlecht zu erkennen. "
            "Du solltest naeher ran gehen, wenn Du ihn untersuchen willst.");

  AddDetail( ({"steine","steinen","pflastersteine"}),
	    "Die grossen Pflastersteine kennst Du nun schon ziemlich gut.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht eigentlich nach gar nichts.");  
 
  AddSound(DEFAULT_SOUND, "Es ist wunderschoen still.");

 //-----Details Ende-----
  
AddExit("nordwesten", ROOM "hoch24");
AddExit("sueden", ROOM "hoch22");

}
