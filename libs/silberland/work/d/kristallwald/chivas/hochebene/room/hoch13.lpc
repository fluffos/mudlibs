// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Die Anzahl der Huegelgraeber ist beachtlich, die den Weg saeumen. "
        "Es muss damals eine grosse Schlacht stattgefunden haben, wo viele "
        "mutige Krieger und Kriegsmaiden gefallen sind. Der Wind streicht "
        "sanft ueber die Grasflaechen der Hochebene und der Huegelgraeber." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"anzahl"}), 
            "Die Anzahl der Graeber ist sehr gross. Viele Helden wurden hier "
            "begraben.");

  AddDetail( ({"huegelgraeber","graeber","huegel","huegelgraebern","huegelgrab"}),
	    "Die Huegelgraeber sind mit Gras und kleinen weissen Blumen "
            "bewachsen. In jedem Huegelgrab ist eine Steintafel im Gras "
            "eingebettet, die einem sagt, wer hier bestattet wurde.");

  AddDetail( ({"weg"}),
	    "Rings um den Weg herum sind lauter Huegelgraeber zu sehen.");

  AddDetail( ({"schlacht","jahrhunderten","opfer"}),
	    "Eine grosse Schlacht scheint viele Opfer gefordert zu haben, die "
            "dann vor Jahrhunderten hier in den Huegelgraebern bestattet "
            "wurden.");
  
  AddDetail( ({"krieger","ruhe"}),
	    "Grosse Krieger haben in der Schlacht gekaempft und haben ihre "
            "letzte Ruhe auf der Hochebene gefunden.");

  AddDetail( ({"kriegsmaiden","maiden","gleichberechtigung"}), 
            "Grosse Kriegsmaiden sollen auch in der Schlacht gekaempft haben. "
            "Das ist wahre Gleichberechtigung.");

  AddDetail( ({"wind"}),
	    "Der Wind weht leicht ueber das Gras der Hochebene.");

  AddDetail( ({"grasflaechen"}),
	    "Die weiten Grasflaechen der Hochebene sind rings herum zu sehen.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Du befindest Dich auf der Hochebene von Gorthad. Die Hochebene "
            "ist riesig.");
  
  AddDetail( ({"boden"}),
	    "Du stehst auf dem Weg, dem Du schon die ganze Zeit folgst. Es "
            "hat sich nichts veraendert.");

  AddDetail( ({"himmel","sonne"}), 
            "Der Himmel ist direkt ueber Dir und die Sonne scheint freundlich "
            "ueber Dir.");

  AddDetail( ({"zustand"}), 
            "Der Zustand ist leider miserabel.");

  AddDetail( ({"zeit"}), 
            "Du gehst schon etwas laenger auf dem Weg.");

  AddDetail( ({"helden"}),
	    "Grosse Helden haben damals gekaempft.");

  AddDetail( ({"gras"}),
	    "Das Gras waechst auf der ganzen Hochebene.");

  AddDetail( ({"blumen"}),
	    "Die ueblichen kleinen weissen Blumen sind auf den Huegelgraebern "
            "zu sehen.");
  
  AddDetail( ({"steintafel","tafel"}),
	    "Die Steintafeln sind leider nicht mehr in einem guten Zustand. "
            "Du kannst sie leider nicht mehr lesen, um zu sehen wer hier "
            "begraben wurde.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen und Gras.");  
 
  AddSmell( ({"gras"}),
	   "Das Gras riecht frisch.");

  AddSmell( ({"blumen"}),
	   "Die kleine weisse Blumen riechen sehr blumig.");
  
  
  AddSound(DEFAULT_SOUND, "Du hoerst den Wind.");

  AddSound( ({"wind"}),
	   "Der Wind weht leicht ueber die Hochebene.");
  
//-----Details Ende-----
  
AddExit("nordosten", ROOM "hoch14");
AddExit("suedwesten", ROOM "hoch12");

}
