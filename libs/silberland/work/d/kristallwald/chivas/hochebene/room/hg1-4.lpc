// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Huegelgrab");
  SetProp( P_INT_LONG,
	"In der Grabkammer herrscht ein grosses Durcheinander. Der Sarg ist "
        "aufgebrochen und die Skelette grosser Krieger sind aus den "
        "Einbuchtungen heraus gerissen worden und einzelne Knochen und alte "
        "verrostete Ruestungsteile liegen auf dem Boden verstreut umher." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 0 );
  
//-----Details Anfang-----
  
  AddDetail( ({"grabkammer","kammer","grab"}), 
            "In der Grabkammer herrscht absolutes Chaos. Die Grabkammer wurde "
            "auf das Uebelste geschaendet.");

  AddDetail( ({"durcheinander","chaos","boden"}),
	    "Lauter Knochen und Ruestungsteile liegen am Boden. Ausserdem "
            "siehst Du die zerbrochene Grabplatte.");

  AddDetail( ({"sarg","ruestung"}),
	    "Der Sarg besteht wie auch die zerbrochene Grabplatte. Der Sarg "
            "ist ausserdem mit reichlich Verzierungen uebersaeht. Im Sarg "
            "selber liegen nur ein paar Knochen herum. Die Ruestung, die der "
            "Krieger sicher getragen hat, wurde wohl von den Grabraeubern "
            "geklaut.");

  AddDetail( ({"skelette"}),
	    "Die Skelette wurden wahrlos aus den Einbuchtungen gerissen und "
            "die einzelnen Knochen liegen auf dem Boden.");
  
  AddDetail( ({"krieger","kriegern"}),
	    "Ehrenvolle Krieger wurden in dieser Grabkammer bestattet und es "
            "ist eine Schande, dass ihre letzte Ruhestaette so geschaendet "
            "wurde.");

  AddDetail( ({"einbuchtungen"}), 
            "In den Einbuchtungen haben einmal die Krieger gelegen, die hier "
            "bestattet wurden. Jetzt sind sie fast leer und die Knochen und "
            "Ruestungsteile liegen auf dem Boden verstreut. Nur ein paar "
            "Kleinigkeiten liegen nun noch in den Einbuchtungen.");

  AddDetail( ({"knochen"}),
	    "Lauter Knochen und Schaedel liegen auf dem Boden herum. Sie "
            "wurden aus den Einbuchtungen heraus gerissen.");

  AddDetail( ({"ruestungsteile","teile","ruestungsteilen"}),
	    "Die Ruestungsteile, die hier am Boden liegen sind alt, verrostet "
            "und wertlos. Die ganzen teuren Teile wurden sicher gestohlen.");

  AddDetail( ({"decke"}),
	    "Die Decke ist auch aus Stein und kahl. Ein paar alte Spinnenweben "
            "haengen von der Decke herunter.");

  AddDetail( ({"waende","waenden","wand"}), 
            "An den Waenden sind die Einbuchtungen zu sehen, in denen die "
            "Krieger bestattet wurden. Zwischen den Einbuchtungen sind "
            "Halterungen zu sehen, in denen erloschene Fackeln haengen.");

  AddDetail( ({"himmel"}),
	    "Einen Himmel gibt es hier nicht.");

  AddDetail( ({"uebel","uebelste"}),
	    "Diese Grabraeuber haben keinerlei Achtung vor den Toten");

  AddDetail( ({"grabraeuber","weite","grabraeubern","raeuber"}),
	    "Es sind keine Grabraeuber mehr da, sie haben schon vor langer "
            "Zeit das Weite gesucht.");
  
  AddDetail( ({"achtung"}),
	    "Du hast Achtung gegenueber den hier bestatteten Kriegern.");

  AddDetail( ({"tote","toten","ruhe"}), 
            "Die Toten wurden in ihrer Ruhe gestoert.");

  AddDetail( ({"zeit"}),
	    "Es ist sehr lange her.");

  AddDetail( ({"grabplatte","platte"}),
	    "Die Grabplatte ist zerbrochen und liegt auf dem Boden zwischen "
            "den Knochen und Ruestungsteilen.");
 
  AddDetail( ({"verzierungen","linien","arbeit"}),
	    "Die Verzierungen sind fein in den Stein geritzt. Es ist eine "
            "herrliche Arbeit. Die feinen Linien bilden Kampfszenen einer "
            "grossen Schlacht, die vor Jahrhunderten stattgefunden hat.");
  
  AddDetail( ({"schande"}),
	    "Eine grosse Schande haben die Grabraeuber auf sich geladen, als "
            "sie dieses Grab ausgeraubt haben.");

  AddDetail( ({"ruhestaette"}), 
            "Die Grabkammer ist die letzte Ruhestaette grosser Krieger.");

  AddDetail( ({"kampfszenen","kampfszene","szene","schlacht","anblick"}),
	    "Es muss eine furchtbare Schlacht gewesen sein, wenn schon "
            "die Linien so detailreich sind und echt wirken. Du fuehlst "
            "Dich beim Anblick der Linien nicht sehr gut.");

  AddDetail( ({"jahrhunderte","jahrhunderten","zeit"}),
	    "Es ist schon sehr viel Zeit seit der Schlacht vergangen.");

  AddDetail( ({"kleinigkeiten"}),
	    "Die Kleinigkeiten sind ein paar wertlose Stofffetzen und ein "
            "paar Kupfermuenzen.");
  
  AddDetail( ({"stein"}),
	    "Der Boden, die Waende und auch die Decke bestehen aus Stein.");

  AddDetail( ({"spinnenweben","spinnen"}), 
            "Die Spinnenweben sind schon lange von den Spinnen verlassen.");

  AddDetail( ({"halterungen","fackeln"}),
	    "Die Fackeln in den Halterungen sind schone lange erloschen. Sie "
            "werden niemals mehr brennen.");

  AddDetail( ({"stofffetzen"}),
	    "Die Stofffetzen sind alt und nichts wert.");

  AddDetail( ({"kupfermuenzen","muenzen"}),
	    "Die Kupfermuenzen sind kaum etwas wert, deswegen lohnt es sich "
            "nicht sie mitzunehmen. Auf der Vorderseite ist das Konterfei "
            "einer Person zu erkennen.");
  
  AddDetail( ({"konterfei","vorderseite","person"}),
	    "Das Konterfei sieht aus wie Woody, der Mudgott. Also haben auch "
            "damals die Leute schon an ihn geglaubt.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddDetail( ({"leute"}),
	    "Die Krieger, die hier bestattet wurden.");

  AddDetail( ({"woody","mudgott","gott"}),
	    "Woody ist der Gott des Silberlandes.");

  AddDetail( ({"silberlandes","silberland"}),
	    "Du bist im Silberland.");

  AddDetail( ({"schaedel"}),
	    "Mehrere Schaedel liegen auf dem Boden herum und scheinen Dich "
            "anzugrinsen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig muffig in der Grabkammer.");  
 
  AddSmell( ({"grabkammer","kammer"}),
	   "Es ist ganz normal, wenn es so in einer Grabkammer riecht.");

  AddSound(DEFAULT_SOUND, "Es ist totenstill.");

//-----Details Ende-----
  
AddExit("nordwesten", ROOM "hg1-1");

}  
   
