
inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Geist");
  SetProp(P_LONG, BS(
    "Der kleine Geist macht einen ungluecklichen Eindruck. Wenn er noch am "
    "Leben waere, wuerde er sicher weinen. Man erkennt an ihm die durchsichtige "
    "Ruestung eines Herolds."));
  SetProp(P_NAME, "Geist");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
  AddId(({"geist","CHIVASGEIST"}));

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinen Armen",100,DT_BLUDGEON}));
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 8000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);

  SetProp(P_NOATTACK,1);

  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "schwebt herum");
  SetProp(P_MMSGOUT, "schwebt weg");

  SetProp(P_MNPC_AREA, ( {ROOM "hoch24", ROOM "hoch25", ROOM "hoch26",
                          ROOM "hocht1", ROOM "hocht2", ROOM "hocht3",
                          ROOM "hoch23", ROOM "hoch22", ROOM "hoch21",
                          ROOM "hoch20", ROOM "hoch19", ROOM "hoch18",
                          ROOM "hoch17", ROOM "hoch16", ROOM "hoch15",
                          ROOM "hoch14", ROOM "hoch13", ROOM "hoch12",
                          ROOM "hoch11", ROOM "hoch10", ROOM "hoch9",
                          ROOM "hoch3", ROOM "hoch2", ROOM "hoch1",
                          ROOM "hoch8", ROOM "hoch7", ROOM "hoch6",
                          ROOM "hoch5",ROOM "hoch4"}));
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "hoch24");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS); 

  SetProp(P_DIE_MSG,  " loest sich auf.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "schaut Dich genervt an.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");
  AddInfo("koenig", "Der Koenig ist mein Herr. Ich habe ihm immer "
          "Nachrichten gebracht und ihn informiert wie es in der Schlacht "
          "laeuft.","sagt: ");
  AddInfo("schlacht", "Die Schlacht haben wir gegen die Orks verloren.","sagt: ");
  AddInfo("orks", "Die Orks haben uns Normaden vernichtet.","sagt: ");
  AddInfo("normaden", "Wir waren ein stolzes Volk. Leider existieren wir "
          "heute nicht mehr.","sagt: ");
  AddInfo("nachrichten", "Ich habe dem Koenig immer die Nachrichten ueber "
          "das Schlachtfeld gebracht und ihn informiert wie die Schlacht "
          "steht.","sagt: ");
  AddInfo("hilfe", "Es waere toll, wenn Du mich in das groesste Huegelgrab "
          "zum Koenig bringen koenntest. Ich habe naemlich eine Nachricht noch "
          "nicht ueberbracht.","sagt: ");
  AddInfo("nachricht", "Die Nachricht ist nur fuer den Koenig. Biete mir doch "
          "bitte Hilfe an und bring mich zu ihm.","sagt: ");
  AddInfo("herold", "Ich war der Herold des Koenigs und habe ihm immer die "
          "Nachrichten gebracht, wie es in der Schlacht steht.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das ist dem kleinen Geist zu schwer.\n" }) );

  SetChats(8, ({
          "Der kleine Geist will zum Koenig.\n",
          "Der kleine Geist sagt: Bring mich bitte zu meinem Koenig.\n"}) );

  SetAttackChats(10, ({
    "Der Geist greift Dich an.\n",
    "Der Geist haut Dich mit seinen Geisterhaenden.\n"}) );

  AddCmd( ({"biete" }), "bieten" );
  
  catch(call_other(ROOM "hg1-2", "???"));
  tell_room(find_object(ROOM "hg1-2"), 
	    "Der Ausgang nach Osten ist ploetzlich verschwunden!\n");
  find_object(ROOM "hg1-2")->RemoveExit("osten");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "beschimpft Dich wuest.", "beschimpft " +
        TP->Name(WEN) + " wuest.");
      break; 

     case "frech":
      call_out("react", 0, "schwirrt um Dich herum.",
        "schwirrt um "+TP->Name(WEN)+" herum.");
    break;

    case "nett":
      call_out("react", 0, "knuddelt Dich.",
        "knuddelt "+TP->Name(WEN)+".");
    break;

    case "froh":
      call_out("react", 0, "kitzelt Deine Nase.",
        "kitzelt "+TP->Name(WEN)+" an der Nase.");
    break;

    default:
      call_out("react", 0, "kriecht herum.",
	"flattert herum.");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

int bieten(string str)
{
  notify_fail("Wem moechtest Du was anbieten?\n");
  
  if(!str || str == "") return 0;
  if(!(str == "hilfe an" || str == "geist hilfe an" )) return 0;
  
  if(member(TP->QueryPursuers(), ME) > -1)
    {
      write(BSA("Aber Du hilfst mir doch schon. Fuehre mich nun in das Grab des Koenigs.",
               "Der kleine Geist sagt: " ));
      
      return -1;
    }
  
  write(BSA("Danke Dir, ich habe mich naemlich "
           "irgendwie verlaufen und weiss nicht mehr den Weg zurueck in das "
           "groesste Huegelgrab. Wenn wir dort in der richtigen Grabkammer "
           "sind, musst Du nur 'wir sind da' tippen und ich kann endlich dem "
           "Koenig die Nachricht geben, die ich vergessen haben ihm zu "
           "bringen.", "Der kleine Geist sagt: "));
  
  TP->AddPursuer(ME);
  return 1;
}
