
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Grosnak, der ordentliche Geist");
  SetProp(P_LONG, BS(
    "Grosnak ist durchsichtig, aber man kann trotzdem recht gut seine "
    "Konturen sehen. Er traegt eine Ruestung, die wie er selber auch "
    "durchsichtig ist."));
  SetProp(P_NAME, "Grosnak");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
  AddId(({"grosnak","geist"}));

  create_default_npc(30);
  SetProp(P_HANDS, ({" mit seinen Armen",150,DT_BLUDGEON}));
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 8000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_SPELLRATE,30);
  SetProp(P_NOMAGIC,3);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.8, DT_COLD:      0.0,  DT_WATER:  -0.5, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0,  DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.8,  DT_UNHOLY:    -0.8,  DT_MAGIC:  0.0, DT_MIND:   0.0]));
  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "schwebt herum");
  SetProp(P_MMSGOUT, "schwebt weg");

  SetProp(P_DIE_MSG,  " loest sich auf.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "%s, Du machst das nicht noch mal!");
  SetProp(P_KILL_NAME, "Ein Geist");
  SetProp(P_KILL_MSG, "Das war nicht besonders geistreich von Dir!");

 AddInfo(DEFAULT_INFO, "schaut Dich genervt an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das ist dem verrueckten Geist zu schwer.\n" }) );

  AddSpell(3,800, 
    "Der Geist greift mit seinen Haenden in Dich rein und quetscht Dein Herz.\n",
    "Der Geist greift in @WEN hinein und zerquetscht das Herz.\n",
    ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));

  SetChats(6, ({
          "Grosnak der ordentliche Geist ist wie wild am Fegen.\n",
          "Grosnak sagt: Hier ist es immer wieder dreckig von "
          "den ganzen Abenteurern, die hier durchlaufen.\n"}) );

  SetAttackChats(10, ({
    "Der Geist greift Dich an.\n",
    "Der Geist haut Dich mit seinen Geisterhaenden.\n"}) );
 SUID;
  CLONEME( "/d/ebene/ronja/feenquest/weapon/besen" );
  command("zuecke besen");

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "beschimpft Dich wuest.", "beschimpft " +
        TP->Name(WEN) + " wuest.");
      break; 

     case "frech":
      call_out("react", 0, "schwirrt um Dich herum.",
        "schwirrt um "+TP->Name(WEN)+" herum.");
    break;

    case "nett":
      call_out("react", 0, "knuddelt Dich.",
        "knuddelt "+TP->Name(WEN)+".");
    break;

    case "froh":
      call_out("react", 0, "kitzelt Deine Nase.",
        "kitzelt "+TP->Name(WEN)+" an der Nase.");
    break;

    default:
      call_out("react", 0, "kriecht herum.",
	"flattert herum.");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

