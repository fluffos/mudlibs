
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Geist");
  SetProp(P_LONG, BS(
    "Ein kleiner Geist. Er ist sicher nicht sehr klug, dafuer aber "
    "toedlich."));
  SetProp(P_NAME, "Geist");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
  AddId( ({ "geisth","geist"}) );

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit seinen Haenden" ,QueryProp(P_HANDS)[1], DT_RIP }) );
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 150 );
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,2);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_SPELLRATE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,20);

  SetProp(P_MSGIN, "schwebt herein.");
  SetProp(P_MSGOUT, "schwebt.");
  SetProp(P_MMSGIN, "entsteht aus einer Rauchwolke.");
  SetProp(P_MMSGOUT, "schwebt weiter.");

  SetProp(P_DIE_MSG,  " loesst sich in einer Rauchwolke auf.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_NAME, "Ein boeser Geist");
  SetProp(P_KILL_MSG, "Die dunkle Seite der Macht ist staerker!");

  AddDetail( ({ "augen"}),
    "Die Augen wirken kalt und unfreundlich.");
  AddDetail( ({ "atem"}),
    "Der Atem stinkt nach Tod.");
  AddDetail( ({ "tod"}),
    "Vielleicht ereilt er Dich bald..");

  AddInfo(DEFAULT_INFO, "ist zu dumm um Dich zu beachten.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Geist will Deine Sachen nicht haben.\n" }) );

  SetChats(1, ({
          "Der Geist schleicht um Dich herum.\n"}) );
  SetAttackChats(10, ({
    "Der Geist zerfetzt Dich.\n",
    "Der Geist beisst Dich.\n"}) );

}
