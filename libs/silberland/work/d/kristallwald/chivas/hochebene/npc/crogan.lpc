
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Crogan, der Geist");
  SetProp(P_LONG, BS(
    "Crogan war einmal der Koenig der Normaden. Seine "
    "Ruestung und seine Krone sind beide durchsichtig wie er selbst auch. "
    "Trotz seiner geisterhaften Erscheinung strahlt er eine grosse Macht aus. "
    "Man darf ihn sicher auch als Geist nicht unterschaetzen."));
  SetProp(P_NAME, "Crogan");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:50]));
  AddId( ({ "crogan","geist","koenig"}) );

  create_default_npc(42);
  SetProp(P_HANDS, ({" mit seinen Haenden" ,QueryProp(P_HANDS)[1], DT_RIP }) );
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 200 );
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_SPELLRATE,80);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_RESISTANCE_STRENGTHS , 
  ([DT_FIRE:      -0.2,  DT_COLD:     -0.2,  DT_WATER: -0.2,  DT_AIR:   -0.2, 
    DT_LIGHTNING: 0.3,  DT_EXPLOSION: 0.4,  DT_SOUND:  0.3,  DT_LIGHT: 0.0,
    DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.0,  DT_TERROR: 0.0,
    DT_HOLY:      0.2,  DT_UNHOLY:  -0.2,  DT_MAGIC: -0.2, DT_BLUDGEON: -0.6]));
  SetProp(P_MSGIN, "schleicht murmelnd herein");
  SetProp(P_MSGOUT, "schleicht murmelnd weiter");
  SetProp(P_MMSGIN, "schleicht fluesternd herein");
  SetProp(P_MMSGOUT, "schleicht fluesternd weiter");

  SetProp(P_MNPC_AREA, ( {ROOM "hg1-5"}));
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "hg1-5");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS); 

  SetProp(P_DIE_MSG,  " loest sich auf.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_NAME, "Crogan");
  SetProp(P_KILL_MSG, "Geistermagie ist viel zu stark fuer Dich!");

  AddInfo(DEFAULT_INFO, "spielt mit ein paar Feuerbaellen in seinen Haenden "
                        "und beachtet Dich nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Crogan brauch Deine Sachen nicht.\n" }) );

  AddSpell(5,600, 
    "Ein Blitz schnellt aus der Hand von Crogan und trifft Dich.\n",
    "Ein Blitz aus der Hand von Crogan trifft @WEN mitten am "
    "Oberkoerper.\n",
    ({DT_LIGHTNING}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(1,1500, 
    "Ein Feuerball schnellt aus der Hand von Crogan und trifft Dich.\n",
    "Ein Feuerball aus der Hand von Crogan trifft @WEN .\n",
    ({DT_FIRE}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(3,800, 
    "Crogan trifft Dich mit einem hervorgezauberten Riesenhammer.\n",
    "Crogan beschwoert einen Riesenhammer, der @WEN mit aller Wucht trifft.\n",
    ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2, 1, DS_PARALYZE,
    "Crogan spricht boese Formeln und Du kannst Dich nicht mehr bewegen!\n",
    "Crogan paralysiert @WEN!\n" );

  AddDefaultSpell(2, 1, DS_ANTIMAGIC,
    "Crogan verhindert Deine Zauber!\n",
    "Crogan verhindert, dass @WER Magie anwenden kann!\n" );

  AddDefaultSpell(3, 100, DS_DISARM);    

  SetChats(2, ({
          "Crogan spricht ein paar geisthafte Beschwoerungen.\n",
          "Crogan murmelt unverstaendliche Worte.\n"}) );
  SetAttackChats(10, ({
    "Crogan schuetzt sich mit einem magischen Schild.\n",
    "Crogan weicht gekonnt aus.\n"}) );

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("reaction")!= -1)
    return;
  
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
       "haelt Dich fuer ein unwichtiges Wesen, darum reagiert er nicht.",
       "haelt "+TPN+" fuer ein unwichtiges Wesen, darum reagiert er nicht.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
       "bewegt seine Haende und entzuendet ein Feuer unter Deinem Hintern.",
       "bewegt seine Haende und entzuendet ein Feuer unter "+TP->name(WESSEN)+" Hintern.");
        TP->AddHp(-10);
      break;
    case "albern":
      call_out("reaction", 0, TP,
       "beachtet Dich nicht.",
       "beachtet "+TPN+" nicht.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
       "entzuendet magisch ein kleines Feuer unter Deinen Fuessen.",
       "entzuendet magisch ein kleines Feuer unter "+TP->name(WESSEN)+" Fuessen.");
        TP->AddHp(-10);
      break;
    case "froh":
    case "intim":
    case "nett":
      call_out("reaction", 0, TP,
       "findet das ekelig.",
       "findet das ekelig.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
       "beruehrt das nicht besonders.",
       "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
       "lacht Dich aus.",
       "lacht "+TP->Name(WEN)+" aus.");
    break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

void daemon()
{
  object daemon;
  
  if(present("geisth", MENV)) return;
  
  tell_room(ENV(TO), 
	    "Crogan beschwoert einen kleinen Geist, der ihn im Kampf unterstuetzt.\n");
  daemon=clone_object (NPC "geisth" );
  daemon->move(ENV(TO), M_GO|M_NOCHECK);
}

void Attack(object enemy)
{
  ::Attack(enemy);
  
  if (!random(8))
    daemon();
}

