
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Grabraeuber");
  SetProp(P_LONG, BS(
    "Der Grabraeuber sieht wild und ein wenig zerzaust aus. Er ist ein "
    "grosser Mann mit einem zernarbten Gesicht. Er ist sicher kein "
    "freundlicher Geselle."));
  SetProp(P_NAME, "Grabraeuber");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
  AddId(({"grabraeuber","raeuber"}));

  create_default_npc(30);
  SetProp(P_HANDS, ({" mit seinen Armen",300,DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 22000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "geht weg");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "%s, Du machst das nicht noch mal!");
  SetProp(P_KILL_NAME, "Ein Grabraeuber");
  SetProp(P_KILL_MSG, "Naja, dann raube ich halt Dich aus!");

 AddInfo(DEFAULT_INFO, "schaut Dich genervt an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Grabraeuber will Deine Sachen so nicht haben.\n" }) );

  AddSpell(4,800, 
    "Der Grabraeuber schlaegt Dich mit aller Kraft, so dass Du Sterne siehst.\n",
    "Der Grabraeuber laesst @WEN Sterne erblicken.\n",
    ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
          "Der Grabraeuber begutachtet Dich misstrauisch.\n",
          "Der Grabraeuber ueberlegt ob Du seine Beute willst.\n"}) );

  SetAttackChats(10, ({
    "Der Grabraeuber tritt Dir voller Kraft die Knie ein.\n",
    "Der Grabraeuber probiert Dir in den Ruecken zu stechen.\n"}) );

 SUID;
  CLONEME( "/p/weapon/knife/hiebdolch" );
  CLONEME( "/p/armour/armour/eisenpanzer" );
  CLONEME( "/p/armour/helm/kampfhelm" );
  CLONEME( "/p/armour/gloves/lederhandschuhe");
  command("trage alles");
  command("zuecke hiebdolch");


}


void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


