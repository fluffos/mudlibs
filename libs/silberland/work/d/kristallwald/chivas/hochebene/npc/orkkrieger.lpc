
inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein starker Orkkrieger");
  SetProp(P_LONG, BS(
    "Der Orkkrieger ist ein grosser kraeftiger Kaempfer. Er sieht erfahren und "
    "gefaehrlich aus. Er mustert Dich und schaetzt ab, ob Du fuer Ihn ein "
    "Gegner waerst."));
  SetProp(P_NAME, "Orkkrieger");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
  AddId(({"orkkrieger","ork","krieger"}));

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinen Armen",200,DT_BLUDGEON}));
  SetProp(P_RACE, "Ork");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 52000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
	  ([DT_FIRE: 0.8, DT_WATER:  -0.5]));

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, " kommt an");
  SetProp(P_MMSGOUT, "geht weg");

  SetProp(P_MNPC_AREA, ( {ROOM "hoch21", ROOM "hoch25", ROOM "hoch26",
                          ROOM "hocht1", ROOM "hocht2", ROOM "hocht3",
                          ROOM "hoch23", ROOM "hoch22", ROOM "hoch20"}));

  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "hoch21");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS); 

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "%s, Du machst das nicht noch mal!");
  SetProp(P_KILL_NAME, "Ein Orkkrieger");
  SetProp(P_KILL_MSG, "So etwas wie Dich verspeise ich schon zum Fruehstueck!");

  AddInfo(DEFAULT_INFO, "schaut Dich genervt an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das will der Krieger nicht haben.\n" }) );

  AddSpell(3,500, 
    "Der Orkkrieger schlaegt Dir mit aller Kraft auf den Oberkoerper, so dass "
    "Du kaum noch Luft bekommst.\n",
    "Der Orkkrieger schlaegt @WEN richtig stark.\n",
    ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
          "Der Orkkrieger begutachtet Dich misstrauisch.\n",
          "Der Orkkrieger ueberlegt ob Du leichte Beute bist.\n"}) );

  SetAttackChats(10, ({
    "Der Orkkrieger taeuscht Dich mit einer Finte.\n",
    "Der Orkkrieger taucht unter Deinen Schlaegen weg und trifft Dich.\n"}) );
  SUID;
  CLONEME( "/p/weapon/sword/krummschwert" );
  CLONEME( "/p/armour/armour/lederruestung" );
  CLONEME( "/p/armour/helm/lederhelm" );
  CLONEME( "/p/armour/gloves/lederhandschuhe");
  command("trage alles");
  command("zuecke schwert");
}
