#include "../def.h"
#include <properties.h>
#include <language.h>
#include <thing.h>
#include <moving.h>

inherit "/std/container";

int anzahl=1;

nosave string my_short()
{
  string ret;
  
  ret="Eine ";
  
  if(QueryProp(P_CNT_STATUS)==1)
    ret+="geschlossene ";
  else
    ret+="geoeffnete ";
  
  ret+="Truhe";
  
  return ret;
}

nosave string my_long()
{
  string ret;
  
  ret="Eine hoelzerne Truhe mit wertvollen Beschlaegen und Verzierungen. "
    "Momentan ist sie ";

  if(QueryProp(P_CNT_STATUS) == 1)
    ret+="geschlossen.";
  else
    ret+="geoeffnet. Die Truhe ist voller Edelsteine.";
  
  return(break_string(ret,78));
}

void create()
{
  if(!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_SHORT,#'my_short);
  Set(P_LONG,#'my_long,F_QUERY_METHOD);
  SetProp(P_NAME,"Truhe");
  SetProp(P_GENDER,FEMALE);
  SetProp(P_MAX_WEIGHT,50000);
  SetProp(P_CNT_STATUS,1);
  SetProp(P_TRANSPARENT,0);
  SetProp(P_NOGET,"Die Truhe ist einfach zu schwer.\n");
  SetProp(P_MATERIAL, ([MAT_OAK :92, MAT_IRON:8]) );
  AddId(({"truhe"}));
  
  AddDetail( ({"eichenholz","holz"}),
    "Die Truhe besteht aus Eichenholz, das Holz ist alt aber dennoch sehr hart.");

  AddDetail( ({"beschlaege"}),
    "Die Beschlaege der Truhe sind aus Gold. Sie ist sicher sehr wertvoll.");

  AddDetail( ({"gold"}),
    "Das Gold ist sicher sehr kostbar.");

  AddSpecialDetail( ({ "edelsteine"}),"detailedelsteine" );
  AddSpecialDetail( ({ "inschrift"}),"detailinschrift" );
   
  AddCmd(({"oeffne"}),"oeffnen_act");
  AddCmd(({"schliess","schliesse"}),"schliessen_act");
  AddCmd(({"nimm","nehme"}),"nehmen_act");
}

string detailedelsteine()
{
  if (QueryProp(P_CNT_STATUS))
    return(BS("Du siehst hier kein Edelsteine."));
  
  return(BS("Du siehst in der Truhe einen Haufen Edelsteine. Da Du aber nicht "
            "den Zorn der Toten erleben willst, laesst Du sie lieber in der "
            "Truhe.\n"));
}

string detailinschrift()
{
  if (QueryProp(P_CNT_STATUS))
    return(BS("Du siehst hier keine Inschrift."));

  return(BS("Du siehst eine kleine Inschrift im Deckel der Truhe. Auf ihm "
            "steht folgendes geschrieben:\n"
            "Wenn Du es bis hier her geschafft hast Abenteurer, dann hast Du "
            "Dir einen Edelstein verdient. Nimm ihn einfach.\n"));
}

nosave int oeffnen_act(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");
  if(!str) return 0;
  
  if(str=="truhe")
    if(QueryProp(P_CNT_STATUS)==0)
      {
	write(break_string("Die Truhe ist schon geoeffnet.",78));
	return 1;
      }
    else
      {
	SetProp(P_CNT_STATUS,0);
	SetProp(P_TRANSPARENT,1);
	
	write(break_string("Du oeffnest die Truhe.",78));
	tell_room(environment(this_player()),
		  break_string(this_player()->name(WER)+" oeffnet eine "
			       "Truhe.",78),({this_player()}));
	return 1;
      }
  
  return 0;
  
}

nosave int schliessen_act(string str)
{
  notify_fail("Was moechtest Du schliessen?\n");
  if(!str) return 0;
  
  if(str=="truhe")
    if(QueryProp(P_CNT_STATUS)==1)
      {
	write(break_string("Die Truhe ist schon geschlossen.",78));
	return 1;
      }
    else
      {
	SetProp(P_CNT_STATUS,1);
	SetProp(P_TRANSPARENT,0);
	write(break_string("Du schliesst die Truhe.",78));
	tell_room(environment(this_player()),
		  break_string(this_player()->name(WER)+" schliesst eine "
			       "Truhe.",78),({this_player()}));
	return 1;
      }
  
  return 0;
}

nosave int nehmen_act(string str)
{
  notify_fail("Was moechtest Du nehmen?\n");
  if(!str) return 0;
  
  if(str=="edelstein")
    if(QueryProp(P_CNT_STATUS)==1)
      {
	write(break_string("Du kannst keinen Edelstein aus einer geschlossenen "
			   "Truhe nehmen.",78));
	return 1;
      }
    else
      if(anzahl < 1)
	{
	  write(BS("Es wurde schon ein Edelstein aus der Truhe genommen. Man sollte "
		   "nicht gierig werden.\n"));
	  
	  say(TPN+" arglt ein wenig.\n");
	  return 1;
	}
      else
	{
	  write(BS("Du nimmst einen schoenen Edelstein aus der Truhe. \n"));
	  
	  say(TPN+" nimmt einen Edelstein aus der Truhe.\n");
	  clone_object("/obj/gems/onyx")->move(TP, M_NOCHECK);
	  anzahl--;
	  return 1;
	}
  
  return 0;
}

void reset()
{
  ::reset();
  anzahl=1; 
  
  if(QueryProp(P_CNT_STATUS)==0)
    {
      SetProp(P_CNT_STATUS,1);
      SetProp(P_TRANSPARENT,0);
    }
} 
