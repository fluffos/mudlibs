//erstellt im mai 04 von chivas
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Torwache von Roch Adan");
  SetProp(P_LONG,
    "Diese Torwache beschuetzt die hinter dem Tor liegende Stadt Roch Adan, die "
    "Stadt der Zentauren. Man sollte sich am Besten nicht mit ihr anlegen, da "
    "sie sehr grimmig aussieht.");
  SetProp(P_NAME, "Torwache");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId( ({ "torwache","wache"}) );
  AddId(({"Schwertexperte"}));


  create_default_npc(25);
  SetProp(P_HANDS, ({" mit seinen Haenden" ,150, DT_RIP }) );
  SetProp(P_SIZE, 260 );
  SetProp(P_RACE, "Zentaur");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,25);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "trabt an");
  SetProp(P_MSGOUT, "trabt");
  SetProp(P_MMSGIN, "kommt Dich inspizierend herein");
  SetProp(P_MMSGOUT, "trabt auf der Suche nach Stoerenfrieden weiter");
  
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder %s, dann stirbst Du unter meinen Hufen!");
  SetProp(P_KILL_NAME, "Eine Torwache");
  SetProp(P_KILL_MSG, "Probier es ruhig nochmal!");

  AddDetail( ({ "wache","torwache", "zentaur"}),
    "Dieser Zentaur gehoert zur Torwache von Roch Adan.");
  AddDetail( ({ "oberkoerper"}),
    "Der Oberkoerper ist der eines Menschen.");
  AddDetail( ({ "pferd"}),
    "Der Unterleib ist der eines Pferdes.");

  AddInfo(DEFAULT_INFO, "mustert Dich kritisch und ueberlegt ob Du wohl "
                        "Aerger machen wirst.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");
  AddInfo( ({"palast","herrscher","koenig"}),
    "Unser Koenig lebt in der Stadt im Palast.","sagt: ");
  AddInfo( ({"wache","torwache","posten"}),
    "Ich bin eine der Torwachen. Es ist ein sehr wichtiger Posten.","sagt: ");
  AddInfo( ({"stadt","roch adan"}),
    "Dies ist Roch Adan, die Stadt der Zentauren.","sagt: ");
  AddInfo( ({"zentauren"}),
    "Wir Zentauren sind stolze Wesen und gute Kaempfer.","sagt: ");
  AddInfo( ({"elen","hofnarr","narr","teleskop"}),
    "Der Hofnarr hat Elen das Teleskop wieder geklaut. Er wohl was am Haupttor "
    " versteckt.","sagt: ");
    
  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Eine Torwache will Deine Sachen nicht tragen.\n" }) );

  AddSpell(1,300, 
     "Eine Torwache tritt Dich mit seinen Hufen nieder.\n",
     "Eine Torwache zertrampelt @WEN mit seinen Hufen am Boden.\n",
     ({DT_BLUDGEON}), "tritt", ([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Eine Torwache trabt gebieterisch umher.\n",
    "Eine Torwache vertreibt einige Vagabunden.\n"}) );
  SetAttackChats(10, ({
    "Eine Torwache trampelt Dich nieder.\n",
    "Eine Torwache zereisst Dich.\n"}) );

 SUID;
  CLONEME(WEAPON "kometenschwert" );
  CLONEME( "/p/armour/gloves/lederhandschuhe" );
  CLONEME(ARMOUR "kometenpanzer" );
  CLONEME(ARMOUR "kometenhelm");
  command("trage alles");
  command("zuecke schwert");

TORMASTER -> add_wache();
  
}

void init()
{
  ::init();

 if ( TORMASTER -> IsWachefeind(TP) ) Kill(TP);

}

//masterbeginn

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  TORMASTER -> ruf_um_hilfe(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

void Attack(object enemy)
{
  int i;
  object ob;
  string raum;
  string *raum2;
  mapping exits;
  string *ausgaenge;

  exits = environment()->QueryProp(P_EXITS);
  ausgaenge = m_indices(exits);
  for ( i = sizeof(ausgaenge)-1; i>=0; i-- )
  {
    if ( !objectp(enemy) ) return;
    raum2 = explode(exits[ausgaenge[i]], "#" );
    raum = raum2[sizeof(raum2)-1];
    for ( ob=first_inventory(raum); ob; ob=next_inventory(ob) )
      if ( living(ob) && !query_once_interactive(ob) &&
           ob->id("\nwache") )
      {
	raum = file_name(ENV(TP));
	ob -> move(raum ,M_TPORT, 0,
          "hoert ein Heulen aus der Ferne und laeuft davon",
	  "kommt rasch herein gelaufen" );
        if ( enemy )
          ob -> Kill(enemy);
        return ::Attack(enemy);
      }
  }
  if (!objectp(enemy)) return;
  for ( ob=first_inventory(environment()); ob; ob=next_inventory(ob) )
    if ( living(ob) && !query_once_interactive(ob) &&
         ob->id("\nwache") )
      ob -> Kill(enemy);
  return ::Attack(enemy);
}

int remove(int arg)
{
  TORMASTER -> remove_wache(TO);
  return ::remove(arg);

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if ( killer == TO ) TORMASTER -> Sieg(player);
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "redet beruhigend auf Dich ein.",
        "beruhigt Dich fluesternd.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schimpft leise auf Dich.",
        "grummelt ueber dich fluesternd.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "findet gar nichts lustig.",
        "findet gar nichts lustig.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "droht Dir mit einem Schwert.",
        "schaut boese.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "faucht Dich fluesternd an.",
        "faucht fluesternd.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich guetig an.",
        "laechelt guetig.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "fluestert Dir zu: Nicht wenn ich Dienst habe Schatz.",
        "fluestert Dir zu: Spaeter mein Engel, jetzt muss ich arbeiten.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "schaut Dich streng an.",
        "guckt ein wenig boese.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "beachtet Dein Verhalten gar nicht.",
        TP->Name(WER)+" wird von einer Torwache gar nicht beachtet.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
void tritt(object enemy, int damage, mixed dam_type)
{
  if (!enemy->QueryProp(P_DISABLE_ATTACK))
    enemy->SetProp(P_DISABLE_ATTACK, 1+random(3));
}

