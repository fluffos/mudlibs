#include "../def.h"

inherit "std/repair";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Marlog, der Schmied");
  SetProp(P_LONG,
    "Marlog ist der Schmied von Roch Adan. Er ist einer der wenigen Menschen, "
    "die sich in der Stadt der Zentauren niedergelassen haben. Er ist vom Russ "
    "in der Schmiede unglaublich dreckig. Er benoetigt unbedingt eine Dusche.");

  SetProp(P_NAME, "Marlog");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));

  AddId( ({"marlog","schmied"}) );
  AddClass(CL_HUMAN); 

  create_default_npc(18);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 185);
  SetProp(P_ALIGN, 250);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_SPELLRATE,25);
  SetProp(P_ARTICLE, 0);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz hinaus");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "%s, Komm Du her und ich soll Dir nochmal etwas "
                        "reparieren!");
  SetProp(P_KILL_NAME, "Marlog");
  SetProp(P_KILL_MSG, "Das Feuer meiner Schmiede macht mich unbesiegbar!");

  AddDetail( ({ "schmied"}),
    "Marlog ist richtig dreckig.");
  AddDetail( ({ "russ","asche"}),
    "Ueberall an Marlog klebt Russ und Asche. Eine Dusche waere genau das "
    "Richtige fuer ihn.");
  AddDetail( ({ "dusche"}),
    "Eine Dusche koennte er gut vertragen. Er ist total dreckig.");
  AddDetail( ({ "mensch","menschen"}),
    "Neben Marlog gibt es nur noch einen Menschen in Roch Adan. Sie ist die "
    "Besitzerin der Kneipe.");
  AddDetail( ({ "besitzerin","kneipe","laris"}),
    "Laris ist die Besitzerin der Kneipe und ist neben Marlog der einzige "
    "Mensch der sich in Roch Adan nieder gelassen hat.");

  AddInfo(DEFAULT_INFO, "ist zu sehr mit dem Feuer beschaeftigt um "
                        "Dich zu beachten.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"schmiede"}),
    "Diese Schmiede gehoert mir.",
    "sagt: ");

  AddInfo( ({"elen","hofnarr","teleskop"}),
    "Der Hofnarr, der wie jede Woche Elen das Teleskop geklaut hat, war vorhin "
    "hier. Was er hier gemacht hat habe ich jedoch nicht gesehen, da ich "
    "beschaeftigt war.",
    "sagt: ");

  AddInfo( ({"zentauren","kunden"}),
    "Die Zentauren sind sehr gute Kunden.",
    "sagt: ");

  AddInfo( ({"axt","axtblatt"}),
    "Ich kann Dir ein Axtblatt schmieden, wenn Du die Bestandteile dabei hast "
    "und Du mir einen Gefallen tust.",
    "sagt: ");

  AddInfo( ({"bestandteile","teile"}),
    "Ich benoetige fuer ein Axtblatt 5 Stuecke Eisen.",
    "sagt: ");

  AddInfo( ({"eisen"}),
    "Ich weiss nicht, wo Du es bekommen kannst Vielleicht irgendwo in der "
    "Zwergenfeste von Ardhmir.",
    "sagt: ");

  AddInfo( ({"schmied","borolt"}),
    "Ich bin der Schmied hier in Roch Adan, aber es gibt noch einen namens "
    "Borolt. Er ist der Schmied in der Zwergenfeste von Ardhmir.",
    "sagt: ");

  AddInfo( ({"kleinigkeiten"}),
    "Damit es eine grosse maechtige Axt wird, fehlen noch ein paar Intarsien "
    "auf dem Axtblatt.",
    "sagt: ");

  AddInfo( ({"intarsien"}),
    "Ich kann Dir leider diese Intarsien nicht machen, aber frage doch einmal "
    "den Schmied in der Zwergenfeste von Ardhmir.",
    "sagt: ");

  AddInfo( ({"zwergenfeste","ardhmir"}),
    "Die Zwergenfeste von Ardhmir befindet sich noerdlich von Roch Adan.",
    "sagt: ");

  AddInfo( ({"gefallen"}),
    "Ich will unbedingt ein persoenliches Horoskop vom Astrologen, aber ich "
    "kann hier nicht weg. Es waere lieb von Dir, wenn Du ihn um ein "
    "Horoskop fuer mich bittest und es mir dann geben wuerdest. Dann schmiede "
    "ich Dir auch Dein Axtblatt, wenn Du das Eisen dabei hast.",
    "sagt: ");

  AddInfo(DEFAULT_INFO, "Willkommen in meiner Schmiede.","sagt: ");

  AddSpell(1,300, 
     "Marlog rammt Dich mit stupider Kraft zu Boden.\n",
     "Marlog rammt @WEN einfach um.\n",
     ({DT_BLUDGEON}), "tritt", ([SP_SHOW_DAMAGE:1]));

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WEM)+" will Deine Sachen nicht tragen.\n" }) );

  SetChats(3,
    ({Name(WER,1)+" sagt: Schoen Dich zu sehen!\n"
     })
  );

  SetAttackChats(10,
    ({Name(WER,1)+" schimpft: Das ist nicht witzig!\n"
     })
  );

  SUID;

  AddCmd( ({"gib","gebe" }), "geben" );  

}

int rep_auswahl(object ob)
{

  if(!ob->QueryMaterialGroup(MATGROUP_METAL))
  {
    TP->Message(BS(Name(WER,1)+" sagt: Ich kann nur Sachen aus Metall "
                "reparieren!"), MSGFLAG_SOUND);
    return 0;
  }

  if(!ob->QueryProp(P_WEAPON_TYPE))
  {
    TP->Message(BS(Name(WER,1)+" sagt: Ich repariere nur "
                "Waffen!"), MSGFLAG_SOUND);
    return 0;
  }

  return 1;
}
// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "redet beruhigend auf Dich ein.",
        "beruhigt Dich fluesternd.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schimpft leise auf Dich.",
        "grummelt ueber dich fluesternd.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert leise ueber Dich.",
        "kichert leise.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "bewirft Dich mit Russ und Asche.",
        "bewirft Dich mit Russ und Asche.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "faucht Dich fluesternd an.",
        "faucht fluesternd.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich guetig an.",
        "laechelt guetig.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "kuschelt Dich zaertlich zurueck.",
        "kuschelt Dich zaertlich.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "fluestert das ihm das sehr gefaellt.",
        "fluestert das ihm das sehr gefaellt.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        TP->Name(WER)+" wird von Marlog getroestet.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
  
  
}
void tritt(object enemy, int damage, mixed dam_type)
{
  if (!enemy->QueryProp(P_DISABLE_ATTACK))
    enemy->SetProp(P_DISABLE_ATTACK, 1+random(3));
}
int geben(string str)
{
   object axtblatt1;
   notify_fail("Was moechtest Du wem geben?\n");
   if ( member( ({ "marlog horoskop", "schmied horoskop","horoskop an marlog","horoskop an schmied" }),str) != -1) 
{
     if( present("axtblatt2",TP))
     {
        write(BS("Marlog sagt: Du hast doch sogar schon ein verziertes "
		 "Axtblatt, wozu brauchst Du dann noch ein einfaches "
		 "Axtblatt. Verschwinde und lass mich arbeiten.\n"));
        return -1;
     }
     if( present("axtblatt1",TP))
     {
        write(BS("Marlog sagt: Du hast doch schon ein Axtblatt, wofuer "
		 "brauchst Du denn noch eines.\n"));
        return -1;
     }
     if( !present("dragoninvis1",TP))
     {
        write(BS("Marlog sagt: Also mein Freund, Du brauchst doch gar nichts "
		 "von mir. Also brauchst Du mir auch nichts zu geben. Du "
		 "kannst natuerlich zu Anezram gehen und ihm Hilfe anbieten, "
		 "dann helfe ich Dir auch, wenn die Zeit reif dafuer ist.\n"));
        return -1;
     }
     if( !present("horoskopm",TP))
     {
        write(BS("Marlog sagt: Bevor ich Dir helfe und das Axtblatt fuer "
		 "Dich schmiede, will ich mein persoenliches Horoskop von "
		 "dem Astrologen und Du hast gar keins fuer mich.\n"));
        return -1;
     }     
     if( !present("eisen 5",TP))
     {
        write(BS("Marlog sagt: Du hast leider nicht genug Eisen. Du benoetigst "
		 "fuenf Stuecke Eisen fuer ein Axtblatt.\n"));
        return -1;
     }     
     else
      {
      {axtblatt1 = clone_object( "/d/kristallwald/chivas/dragonquest/obj/axtblatt1");
  present("horoskopm",TP)->remove();
  present("eisen 1",TP)->remove();
  present("eisen 1",TP)->remove();
  present("eisen 1",TP)->remove();
  present("eisen 1",TP)->remove();
  present("eisen 1",TP)->remove();
  if ( ME_TOO_HEAVY == axtblatt1->move(TP,M_GET|M_SILENT) )
     {
     write("Das eiserne Axtblatt wuerde Dir zu schwer werden.\n" );
     axtblatt1 -> remove();
     return 1;
     }
     else
     {
     write(BS("Du gibt Marlog sein Horoskop und die fuenf Stuecke Eisen, so "
	      "dass er nun das Axtblatt fuer Dich fertigen kann.\n"
	      "Marlog sagt: Hervorragend, Du hast mir mein Horoskop "
	      "gebracht und die fuenf Eisen hast Du auch. Ich "
	      "werde nun damit beginnen das Axtblatt dementsprechend "
	      "zu schmieden.\n"));
     TP->SetProp(P_PARALYZED, ([
                PARALYZE_TIME: 5,
                PARALYZE_MSG: "Du bist fasziniert, wie Marlog das Axtblatt "
		              "schmiedet.\n",
                PARALYZE_END: "Als Marlog fertig ist, ueberreicht er Dir das "
		              "fertige eiserne Axtblatt und sagt: Hier hast Du "
			      "es, aber es fehlen noch einige Kleinigkeiten, "
			      "bis es ein maechtiges Axtblatt wird.\n"]) );	
      call_out("fall1",4);
      return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}
void fall1()
{
  write(BS( "Marlog nimmt das Eisen und schuert das Feuer, so dass es richtig "
	    "heiss wird. Er legt das Eisen ins Feuer, bis es rot glueht.\n"));
  call_out("fall2",4);
}
void fall2()
{
  write(BS( "Marlog nimmt das gluehende Eisen aus der Esse und schlaegt mit "
	    "einem grossen Hammer darauf herum, bis sich ein grosses "
	    "Axtblatt formt.\n"));
}
