
inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein alter Zentaur");
  SetProp(P_LONG,
    "Der alte Zentaur ist schon recht klapprig auf den Hufen. Seine besten Tage scheinen lange "
    "vorbei zu sein. Sein Fell schimmert auch nicht mehr sonder es sieht eher zottelig aus. ");
  SetProp(P_NAME, "Zentaur");
  SetProp(P_GENDER,  MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"zentaur"}));

  create_default_npc(16);
SetProp(P_HANDS, ({" mit seinen Hufen und Haenden" ,QueryProp(P_HANDS)[1], DT_RIP }) );
  SetProp(P_SIZE, 240 );
  SetProp(P_RACE, "Zentaur");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_MSGIN, "trabt an");
  SetProp(P_MSGOUT, "trabt");
  SetProp(P_MMSGIN, "kommt herein getrabt.");
  SetProp(P_MMSGOUT, "trabt seines Weges.");

  SetProp(P_MNPC_AREA, ( {ROOM "zen13", ROOM "zen16", ROOM "zen17",
                          ROOM "zen18", ROOM "zen19", ROOM "zen20",
                          ROOM "zen21", ROOM "zen22", ROOM "zen23",
                          ROOM "zen24", ROOM "zen25", ROOM "zen26",
                          ROOM "zen27", ROOM "zen28", ROOM "zen29",
                          ROOM "zen30", ROOM "zen31", ROOM "zen32",
                          ROOM "zen33", ROOM "zen34", ROOM "zen35",
                          ROOM "zen36", ROOM "zen37", ROOM "zen43",
                          ROOM "zenladen",ROOM "zenschmied"}));
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "zen21");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS); 


  SetProp(P_DIE_MSG,  " stiert Dich ein letztes Mal boese an.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "warts nur ab, dass naechste Mal bist Du dran!");
  SetProp(P_KILL_NAME, "Ein alter Zentaur");
  SetProp(P_KILL_MSG, "Auch in meinem Alter verlange ich Respekt.");

  AddDetail( ({ "tage"}),
    "Er hat seine besten Tage laengst hinter sich.");
  AddDetail( ({ "hufe","hufen"}),
    "Er steht wegen seinem Alter schon ein wenig klapprig auf den Hufen.");
  AddDetail( ({ "fell"}),
    "Sein Fell schimmtert kaum noch, dafuer ist es aber schon sehr zottelig.");

  AddInfo(DEFAULT_INFO, "laechelt Dich ein wenig senil an.\n");
  AddInfo("Chivas", "Chivas hat mich erschaffen.","sagt: ");
  AddInfo( ({"alter"}),
    "Ich bin schon 102 Jahre alt. Das ist sogar fuer Zentauren schon ein "
    "stattliches Alter.",
    "sagt: ");
  AddInfo( ({"zentauren"}),
    "Die Zentauren leben hier friedlich mit allen anderen zusammen. Die "
    "Zentauren sind eine stolze Rasse.",
    "sagt: ");
  AddInfo( ({"elen"}),
    "Elen ist der Astrologe im Palast.",
    "sagt: ");
  AddInfo( ({"palast"}),
    "Der Palast ist im Norden der Stadt.",
    "sagt: ");
  AddInfo( ({"teleskop","hofnarr"}),
    "Ich habe vorhin gesehen, dass der Hofnarr auf der Strasse um den "
    "Park etwas versteckt hat.",
    "sagt: ");
  AddInfo( ({"park"}),
    "Ich liebe es im Park spazieren zu traben.",
    "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der kleine Zentaur will Deine Sachen nicht tragen.\n" }) );

  SetChats(3, ({
    "Der alte Zentaur stapft mit seinen Hufen.\n",
    "Der alte Zentaur tritt Dich mit seinen Hufen.\n"}) );
  SetAttackChats(10, ({
    "schlaegt Dich .\n"}) );

}
// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "redet beruhigend auf Dich ein.",
        "beruhigt Dich fluesternd.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schimpft leise auf Dich.",
        "grummelt ueber dich fluesternd.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert leise ueber Dich.",
        "kichert leise.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "tritt Dich mit seinen Hufen.",
        "stampft wuetend mit seinen Hufen auf.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "faucht Dich fluesternd an.",
        "faucht fluesternd.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich guetig an.",
        "laechelt guetig.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "kuschelt Dich zaertlich zurueck.",
        "kuschelt Dich zaertlich.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "fluestert das ihr das sehr gefaellt.",
        "fluestert das ihr das sehr gefaellt.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        TP->Name(WER)+" wird von einem alten Zentauren getroestet.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
  
  
}





