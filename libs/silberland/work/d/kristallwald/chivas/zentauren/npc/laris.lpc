

#include "../def.h"

inherit "std/npc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Laris, die Inhaberin");
  SetProp(P_LONG,
      "Laris ist eine zierliche Frau, eine der wenigen Menschen, die sich in "
      "Roch Adan niedergelassen haben. Sie ist sehr huebsch und hat eine "
      "Taetowierung ueber der linken Brust, die nicht gerade klein ist.");

  SetProp(P_NAME, "Laris");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));
  AddId( ({"laris"}) );
  AddId( ({"wirtin"}) );
  AddId( ({"inhaberin"}) );
 
  create_default_npc(18);
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 175);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_SPELLRATE,25);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz weg");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "%s, Du wirst hier nicht mehr bedient!");
  SetProp(P_KILL_NAME, "Laris");
  SetProp(P_KILL_MSG, "Das passiert, wenn man eine Frau falsch behandelt!");

  AddDetail( ({ "frau"}),
    "Laris ist eine sehr huebsche zierliche Frau.");
  AddDetail( ({ "menschen","stadt"}),
    "Hier in der Stadt gibt es nicht sehr viele Menschen, Laris ist eine der "
    "wenigen, die sich hier nieder gelassen haben.");
  AddDetail( ({ "taetowierung"}),
    "Die Taetowierung stellt einen kleinen roten Drachen dar. Sehr huebsch.");
  AddDetail( ({ "drachen","drache","feuer"}),
    "Der Drache speit Feuer und sieht sehr realistisch aus.");
  AddDetail( ({ "brust"}),
    "Die Brust ist auch sehr huebsch.");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"taetowierung"}),
    "Ich finde sie sehr huebsch und sie passt zu meinem Temperament.",
    "sagt: ");
    
  AddInfo( ({"temperament"}),
    "Mein Temperament wird als sehr feurig von anderen "
    "beschrieben.",
    "sagt: ");

  AddInfo( ({"zentauren","kunden"}),
    "Die Zentauren sind sehr gute Kunden. Sie sind sehr trinkfest.",
    "sagt: ");

  AddInfo(DEFAULT_INFO, "Was darf es sein? Ein Picollo oder einen Tee ?","fragt Dich: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" will Deine Sachen nicht tragen.\n" }) );
  SetAttackChats(10,
    ({Name(WER,1)+" zuernt: Das ist also der Dank!\n"
     })
 );

  AddSpell(1,300, 
     "Laris zieht Dir einen Stuhl ueber den Schaedel.\n",
     "Laris zieht @WEN einen Stuhl ueber den Schaedel.\n",
     ({DT_BLUDGEON}), "tritt", ([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Laris putzt die Theke.\n",
    "Laris spuelt ein paar Glaeser ab.\n"}) );
  SetAttackChats(10, ({
    "Laris pruegelt auf Dich ein.\n",
    "Laris wirft Bierkruege nach Dir.\n"}) );

 SUID;
  CLONEME(WEAPON "spiess" );
  CLONEME( "/p/armour/ring/ring" );
  CLONEME( "/p/armour/armour/bluse" );
  CLONEME( "/p/armour/trousers/rock");
  command("trage alles");
  command("zuecke spiess");
}
// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "redet beruhigend auf Dich ein.",
        "beruhigt Dich fluesternd.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schimpft leise auf Dich.",
        "schimpft ueber dich.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert leise ueber Dich.",
        "kichert leise.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "bespritzt Dich mit Bier.",
        "bespritzt Dich mit viel Bier.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "faucht Dich fluesternd an.",
        "faucht fluesternd.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich guetig an.",
        "laechelt guetig.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "kuschelt Dich zaertlich zurueck.",
        "kuschelt Dich zaertlich.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "fluestert das ihr das sehr gefaellt.",
        "fluestert das ihr das sehr gefaellt.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        TP->Name(WER)+" wird von Laris getroestet.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
  
  
}
void tritt(object enemy, int damage, mixed dam_type)
{
  if (!enemy->QueryProp(P_DISABLE_ATTACK))
    enemy->SetProp(P_DISABLE_ATTACK, 1+random(3));
}

