
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Fledermaus");
  SetProp(P_LONG, BS(
    "Eine kleine Fledermaus schwirrt um Dich herum. Sie schaut Dich ganz "
    "neugierig mit ihren kleinen gelben Augen an."));
  SetProp(P_NAME, "Fledermaus");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
 AddId(({"fledermaus","CHIVASFLEDERMAUS"}));

  create_default_npc(8);
  SetProp(P_HANDS, ({" mit ihren Fluegeln",80,DT_BLUDGEON}));
  SetProp(P_RACE, "Fledermaus");
  SetProp(P_SIZE, 40);
  SetProp(P_WEIGHT, 300);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0,  DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0,  DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.0,  DT_MAGIC:  0.0, DT_MIND:   0.0]));
//  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "flattert wild herum");
  SetProp(P_MMSGOUT, "verschwindet in der Luft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Mit mir legst Du Dich nicht mehr an, Du Schuft!");

  AddDetail( ({ "augen"}),
    "Die kleinen gelben Augen sehen sehr intelligent aus.");
  AddDetail( ({ "fluegel"}),
    "Die lederartigen Fluegel flattern sehr schnell um die kleine Fledermaus "
    "in der Luft zu halten.");

 AddInfo(DEFAULT_INFO, "schaut Dich genervt an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das ist der Fledermaus zu schwer.\n" }) );

  SetChats(3, ({
          "Die Fledermaus schwirrt um Dich herum.\n",
          "Die Fledermaus beisst Dir in den Hals.\n",
          "Die Fledermaus fliegt wild umher.\n"}) );

  SetAttackChats(10, ({
    "Die Fledermaus droht mit ihren Fluegeln.\n",
    "Die Fledermaus beisst Dir in den Hals.\n"}) );

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "beschimpft Dich wuest.", "beschimpft " +
        TP->Name(WEN) + " wuest.");
      break; 

    case "aergerlich":
      call_out("react", 0, "droht mit ihren Faeusten.",
        "bedroht " + TP->Name(WEM) +
        " mit seinen Faeusten.");
    break;

    case "frech":
      call_out("react", 0, "schwirrt um Dich herum.",
        "schwirrt um "+TP->Name(WEN)+" herum.");
    break;

    case "nett":
      call_out("react", 0, "knuddelt Dich.",
        "knuddelt "+TP->Name(WEN)+".");
    break;

    case "froh":
      call_out("react", 0, "kitzelt Deine Nase.",
        "kitzelt "+TP->Name(WEN)+" an der Nase.");
    break;

    default:
      call_out("react", 0, "flattert um Dich herum.",
	"flattert herum.");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


