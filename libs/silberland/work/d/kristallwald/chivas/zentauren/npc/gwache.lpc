//erstellt im mai 04 von chivas
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Gefaengniswache von Roch Adan");
  SetProp(P_LONG,
    "Die Gefaengniswache beschuetzt das Gefaengnis in Roch Adan und passt auf, dass "
    "kein Gefangener entflieht. Man sollte sich besser nicht mit dem Zentauren "
    "anlegen.");
  SetProp(P_NAME, "Gefaengniswache");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId( ({ "gefaengniswache"}) );
  AddId( ({ "wache"}) );
  AddId("Speerexperte");


  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinen Haenden" ,150, DT_RIP }) );
  SetProp(P_SIZE, 260 );
  SetProp(P_RACE, "Zentaur");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "trabt an");
  SetProp(P_MSGOUT, "trabt");
  SetProp(P_MMSGIN, "kommt Dich inspizierend herein");
  SetProp(P_MMSGOUT, "trabt auf der Suche nach Stoerenfrieden weiter");
  
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder %s, dann stirbst Du unter meinen Hufen!");
  SetProp(P_KILL_NAME, "Eine Gefaengniswache");
  SetProp(P_KILL_MSG, "Probier es ruhig nochmal!");

  AddDetail( ({ "wache","torwache", "zentaur","zentauren"}),
    "Dieser Zentaur gehoert zur Gefaengniswache von Roch Adan.");
  AddDetail( ({ "oberkoerper"}),
    "Der Oberkoerper ist der eines Menschen.");
  AddDetail( ({ "pferd"}),
    "Der Unterleib ist der eines Pferdes.");

  AddInfo(DEFAULT_INFO, "beachtet Dich nicht, da die Wache ihren Dienst "
                        "sehr ernst nimmt.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"palast","herrscher","koenig"}),
    "Unser Koenig lebt in der Stadt im Palast. ");
    
  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Eine Gefaengniswache will Deine Sachen nicht tragen.\n" }) );

  SetChats(3, ({
    "Eine Gefaengniswache kontrolliert die Zellen.\n",
    "Eine Gefaengniswache saeubert seine Waffen.\n"}) );
  SetAttackChats(10, ({
    "Eine Gefaengniswache trampelt Dich nieder.\n",
    "Eine Gefaengniswache zereisst Dich.\n"}) );

 SUID;
  CLONEME( "/p/weapon/spear/speer" );
  CLONEME( "/p/armour/gloves/lederhandschuhe" );
  CLONEME( "/p/armour/armour/lederpanzer" );
  CLONEME( "/p/armour/helm/lederhelm" );
  CLONEME(OBJ "schluessel");
  command("trage alles");
  command("zuecke speer");
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "redet beruhigend auf Dich ein.",
        "beruhigt Dich fluesternd.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schimpft leise auf Dich.",
        "grummelt ueber dich fluesternd.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "findet gar nichts lustig.",
        "findet gar nichts lustig.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "drohtDir mit einem Speer.",
        "schaut boese.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "faucht Dich fluesternd an.",
        "faucht fluesternd.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich guetig an.",
        "laechelt guetig.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "fluestert Dir zu: Nicht wenn ich Dienst habe Schatz.",
        "fluestert Dir zu: Spaeter mein Engel, jetzt muss ich arbeiten.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "schaut Dich streng an.",
        "guckt ein wenig boese.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "beachtet Dein Verhalten gar nicht.",
        TP->Name(WER)+" wird von einer Gefaengniswache gar nicht beachtet.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
  
  
}

