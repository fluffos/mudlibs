//erstellt im mai 04 von chivas
inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein grosser Zentaur");
  SetProp(P_LONG,
    "Dieser grosse Zentaur ist einer der Buerger dieser schoenen Stadt. Es ist "
    "ein erwachsener Zentaur, der kraeftig aussieht und Dich stolz anschaut. Sein "
    "Oberkoerper ist muskuloes und sein Fell schimmert in der Sonne.");
  SetProp(P_NAME, "Zentaur");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId( ({ "zentaur"}) );
  AddId(({"Speerexperte"}));

  create_default_npc(19);

SetProp(P_HANDS, ({" mit seinen Hufen und Haenden" ,QueryProp(P_HANDS)[1], DT_RIP }) );

  SetProp(P_SIZE, 260 );
  SetProp(P_RACE, "Zentaur");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,25);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "trabt an");
  SetProp(P_MSGOUT, "trabt");
  SetProp(P_MMSGIN, "kommt Dich pruefend herein.");
  SetProp(P_MMSGOUT, "trabt seine Besorgungen machend weiter.");
  
  SetProp(P_MNPC_AREA, ( {ROOM "zen13", ROOM "zen16", ROOM "zen17",
                          ROOM "zen18", ROOM "zen19", ROOM "zen20",
                          ROOM "zen21", ROOM "zen22", ROOM "zen23",
                          ROOM "zen24", ROOM "zen25", ROOM "zen26",
                          ROOM "zen27", ROOM "zen28", ROOM "zen29",
                          ROOM "zen30", ROOM "zen31", ROOM "zen32",
                          ROOM "zen33", ROOM "zen34", ROOM "zen35",
                          ROOM "zen36", ROOM "zen37", ROOM "zen43",
                          ROOM "zenladen",ROOM "zenschmied"}));
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "zen25");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS); 

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder %s, dann stirbst Du unter meinen Hufen!");
  SetProp(P_KILL_NAME, "Ein grosser Zentaur");
  SetProp(P_KILL_MSG, "Du hattest nicht den Hauch einer Chance, Kleiner!");

  AddDetail( ({ "buerger", "zentaur"}),
    "Dieser Zentaur lebt hier in Roch Adan.");
  AddDetail( ({ "oberkoerper"}),
    "Der Oberkoerper ist der eines Menschen.");
  AddDetail( ({ "pferd"}),
    "Der Unterleib ist der eines Pferdes.");
  AddDetail( ({ "stadt","roch adan","heimat"}),
    "Roch Adan ist sicher die Heimat dieses Zentauren.");
  AddDetail( ({ "fell","sonne"}),
    "Das Fell schimmert in der Sonne.");

  AddInfo(DEFAULT_INFO, "interessiert nicht was Du sagst.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"palast","herrscher","koenig"}),
    "Hier lebt unser Koenig, der Herrscher der Zentauren.","sagt: ");
  AddInfo( ({"roch adan","stadt"}),
    "Roch Adan ist unsere Stadt, die Stadt der Zentauren.","sagt: ");
  AddInfo( ({"elen","astrologe"}),
    "Elen ist der Astrologe in Roch Adan.","sagt: ");
  AddInfo( ({"hofnarr","narr","teleskop"}),
    "Wie ich den Hofnarr kenne, hat er sicher die Einzelteile"
    "gut versteckt.","sagt: ");
  AddInfo( ({"einzelteile","teile"}),
    "Da kann ich Dir leider nicht helfen, ich hab ihn hier nur rumlaufen sehen.","sagt: ");
  AddInfo( ({"zentauren","volk"}),
    "Wir sind ein stolzes Volk.","sagt: ");
    
  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der grosse Zentaur will Deine Sachen nicht tragen.\n" }) );

  AddSpell(1,200, 
     "Ein Zentaur tritt Dich mit seinen Hufen nieder.\n",
     "Ein Zentaur zertrampelt @WEN mit seinen Hufen am Boden.\n",
     ({DT_BLUDGEON}), "tritt", ([SP_SHOW_DAMAGE:1]));
    
  SetChats(3, ({
    "Ein grosser Zentaur begutachtet Dich.\n",
    "Ein grosser Zentaur schaetzt Dich ein und lacht.\n"}) );
  SetAttackChats(10, ({
    "Der grosse Zentaur trampelt Dich nieder.\n",
    "Der grosse Zentaur zereisst Dich.\n"}) );

 SUID;
  CLONEME( "/p/weapon/spear/holzspeer" );
  CLONEME( "/p/armour/armour/lederruestung" );
  CLONEME( "/p/armour/helm/lederhelm" );
  CLONEME( "/p/armour/gloves/lederhandschuhe");
  command("trage alles");
  command("zuecke holzspeer");
}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt einen Zentauren.");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Ein grosser Zentaur hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

 int _query_wimpy() { return 0; }

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "redet beruhigend auf Dich ein.",
        "beruhigt Dich fluesternd.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "stampft wuetend mit den Hufen.",
        "baut sich bedrohend vor Dir auf.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "lacht Dich aus.",
        "grinst leise.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "tritt Dich mit den Hinterhufen.",
        "tritt Dir mit einem Huf auf den Fuss.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "faucht Dich an.",
        "beschimpft Dich.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "findet Du solltest Dich nicht so anstellen.",
        TP->Name(WER)+" wird von einem Zentauren gemassregelt.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
  
  
}
void tritt(object enemy, int damage, mixed dam_type)
{
  if (!enemy->QueryProp(P_DISABLE_ATTACK))
    enemy->SetProp(P_DISABLE_ATTACK, 1+random(3));
}

