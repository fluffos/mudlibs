
inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Zentaur");
  SetProp(P_LONG,
    "Der Zentaur ist recht klein, aber im Vergleich zu Dir trotzdem "
    "recht stattlich. Du bist trotzdem der Meinung, dass er noch nicht "
    "ausgewachsen ist.");
  SetProp(P_NAME, "Zentaur");
  SetProp(P_GENDER,  MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"zentaur"}));

  create_default_npc(15);
SetProp(P_HANDS, ({" mit seinen Hufen und Haenden" ,QueryProp(P_HANDS)[1], DT_RIP }) );
  SetProp(P_SIZE, 190 );
  SetProp(P_RACE, "Zentaur");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_MSGIN, "trabt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein getrabt.");
  SetProp(P_MMSGOUT, "geht seines Weges.");

  SetProp(P_MNPC_AREA, ( {ROOM "zen2", ROOM "zen3", ROOM "zen4",
                          ROOM "zen5",ROOM "zen6"}));
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "zen4");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS); 


  SetProp(P_DIE_MSG,  " stiert Dich ein letztes Mal an.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "%s warts nur ab, DU, DU, Spieler DU!");
  SetProp(P_KILL_NAME, "Ein kleiner Zentaur");
  SetProp(P_KILL_MSG, "Auch kleine sind manchmal ganz groooossss!");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("Chivas", "Chivas hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der kleine Zentaur will Deine Sachen nicht tragen.\n" }) );

  SetChats(3, ({
    "Der Zentaur stapft mit seinen Hufen.\n",
    "Der Zentaur tritt Dich mit seinen Hufen.\n"}) );
  SetAttackChats(10, ({
    "Der Zentaur schlaegt Dich .\n"}) );

}





