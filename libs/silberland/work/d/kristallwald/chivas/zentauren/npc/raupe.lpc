
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Raupe");
  SetProp(P_LONG, BS(
    "Eine kleine dicke Raupe. Sie wirkt etwas genervt, da Du sie beim "
    "Fressen stoerst."));
  SetProp(P_NAME, "Raupe");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
  AddId(({"raupe","CHIVASRAUPE"})); 

  create_default_npc(5);
  SetProp(P_HANDS, ({" mit ihren Beinchen",25,DT_BLUDGEON}));
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 8);
  SetProp(P_WEIGHT, 25);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 16);
  SetProp(P_HEAL,3);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0,  DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0,  DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.0,  DT_MAGIC:  0.0, DT_MIND:   0.0]));
//  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "kriecht");
  SetProp(P_MMSGIN, "kriecht unter einem Blatt hervor");
  SetProp(P_MMSGOUT, "verschwindet unter einem Blatt");

  SetProp(P_DIE_MSG,  " kringelt sich tot zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Mit mir legst Du Dich nicht mehr an, Du Schuft!");

 AddInfo(DEFAULT_INFO, "schaut Dich genervt an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das ist der Raupe zu schwer.\n" }) );

  SetChats(3, ({
          "Die Raupe sucht nach leckeren Blaettern.\n",
          "Die Raupe knabbert an einem Blatt und will Dir nichts abgeben.\n",
          "Die Raupe krabbelt an einem Busch hoch.\n"}) );

  SetAttackChats(10, ({
    "Die Raupe droht mit seinen Faeusten.\n",
    "Die Raupe beisst Dir in den Fuss.\n"}) );

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {

    case "aergerlich":
      call_out("react", 0, "droht mit ihren Beinchen.",
        "bedroht " + TP->Name(WEM) +
        " mit seinen Beinchen.");
    break;

    case "frech":
      call_out("react", 0, "krabbelt um Dich herum.",
        "krabbelt um "+TP->Name(WEN)+" herum.");
    break;

    case "nett":
      call_out("react", 0, "knuddelt Dich.",
        "knuddelt "+TP->Name(WEN)+".");
    break;

    case "froh":
      call_out("react", 0, "kitzelt Deine Nase.",
        "kitzelt "+TP->Name(WEN)+" an der Nase.");
    break;

    default:
      call_out("react", 0, "kriecht herum.",
	"flattert herum.");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
