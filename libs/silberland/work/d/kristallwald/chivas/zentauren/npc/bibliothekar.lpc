//erstellt im mai 04 von chivas
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Bibliothekar von Roch Adan");
  SetProp(P_LONG,
    "Der Bibliothekar ist ein alter Zentaur, der mit seiner weissen Maehne und "
    "der Brille auf der Nase sehr weise aussieht. Trotz seines Alters sieht er "
    "recht stark aus.");
  SetProp(P_NAME, "Bibliothekar");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId( ({ "bibliothekar"}) );


  create_default_npc(19);
  SetProp(P_HANDS, ({" mit seinen Haenden" ,150, DT_RIP }) );
  SetProp(P_SIZE, 260 );
  SetProp(P_WEIGHT, 240000 );
  SetProp(P_RACE, "Zentaur");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,30);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "trabt an");
  SetProp(P_MSGOUT, "trabt");
  SetProp(P_MMSGIN, "kommt Dich inspizierend herein");
  SetProp(P_MMSGOUT, "geht auf der Suche nach Stoerenfrieden weiter");
  
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder %s, dann stirbst Du unter meinen Hufen!");
  SetProp(P_KILL_NAME, "Ein Bibliothekar");
  SetProp(P_KILL_MSG, "Lies mal ein Buch wie man das richtig macht!");

  AddDetail( ({ "bibliothekar"}),
    "Dieser Zentaur gehoert zur Bibliothek von Roch Adan.");
  AddDetail( ({ "oberkoerper"}),
    "Der Oberkoerper ist der eines Menschen.");
  AddDetail( ({ "pferd"}),
    "Der Unterleib ist der eines Pferdes.");
  AddDetail( ({ "maehne"}),
    "Die Maehne des Zentauren ist strahlend weiss.");
  AddDetail( ({ "brille","nase"}),
    "Eine kleine runde goldene Brille sitzt dem alten Zentauren auf der "
    "Nase.");
  AddDetail( ({ "alter","alters"}),
    "Sein Alter ist nicht richtig definierbar, aber er ist sehr alt.");

  AddInfo(DEFAULT_INFO, "ist zu sehr mit seinen Buechern beschaeftigt und "
                        "ignoriert Dich.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"palast","herrscher","koenig"}),
    "Unser Koenig lebt in der Stadt im Palast. ","sagt: ");
  AddInfo( ({"bibliothek"}),
   "Die Bibliothek bietet fast alles an Wissen, dass die Zentauren "
   "haben.","sagt: ");
  AddInfo( ({"zentauren","volk"}),
    "Die Zentauren sind ein stolzes Volk. ","sagt: ");
  AddInfo( ({"elen","teleskop","hofnarr","narr"}),
    "Hehe, hat der Hofnarr schon wieder das Teleskop von Elen versteckt? "
    "Er macht es oefters und Elen ist sicher wieder total fertig mit den "
    "Nerven.","sagt: ");
  AddInfo( ({"buecher"}),
    "Hier gibt es tausende von Buechern. ","sagt: ");
  AddInfo( ({"buch"}),
    "Wir haben hier viele Buecher, jedoch manchmal werden die Buecher nicht "
    "zurueck gebracht. Auf der einen Seite sind die Magier so schlampig, "
    "aber auch andere wie der Orkschamane unter der Hochebene.","sagt: ");
  AddInfo( ({"hochebene","gorthad"}),
    "Noerdlich von Roch Adan liegt die Hochebene von Gorthad. Auf ihr gibt es "
    "viele alte Huegelgraeber. ","sagt: ");
  AddInfo( ({"huegelgraeber","huegelgrab"}),
    "Die Huegelgraeber von Gorthad wurden vor Jahrhunderten angelegt. Grosse "
    "Helden sind damals in einer Schlacht zwischen den Menschen und den Orks "
    "gefallen. ","sagt: ");
  AddInfo( ({"menschen"}),
    "Menschen sind ganz in Ordnung. Ich kenne einige, die wirklich sehr "
    "nett sind. ","sagt: ");
  AddInfo( ({"ork","orks"}),
    "Orks sind scheussliche Geschoepfe. ","sagt: ");
  AddInfo( ({"helden"}),
    "Helden gibt es viele im Silberland, auch frueher gab es welche. ","sagt: ");
  AddInfo( ({"schlacht"}),
    "Die Schlacht auf der Hochebene ist schon lange her. Die Huegelgraeber "
    "sind die Ueberreste der Menschensiedlung, die noch weiter im Norden "
    "war. Die Orks haben damals alle niedergemetzelt und die Siedlung "
    "zerstoert. Die wenigen, die fliehen konnten, haben ihre Helden noch in "
    "den Graebern bestattet und sind dann davon gezogen. ","sagt: ");
  AddInfo( ({"siedlung","menschensiedlung"}),
    "Die Siedlung im Norden gibt es schon lange nicht mehr. ","sagt: ");
  AddInfo( ({"magie","verbuendeter"}),
    "Die Magie ist ein maechtiger Verbuendeter. ","sagt: ");
  AddInfo( ({"magie im huegelgrab"}),
    "Die Zwerge, die damals mit den Menschen im Norden verbuendet waren, haben "
    "die Graeber der Helden magisch geschuetzt. Frevler, die die Huegelgraeber "
    "entweihen, werden mit einem toedlichen Fluch belegt.","sagt: ");
  AddInfo( ({"zwerge"}),
    "Zwerge leben in Felonia oder in einer Zwergenfeste in der Naehe der "
    "Hochebene im Norden. ","sagt: ");
  AddInfo( ({"felonia","zwergenfeste","feste"}),
    "In Felonia und in der Zwergenfeste leben viele Zwerge. ","sagt: ");
  AddInfo( ({"fluch"}),
    "Sei froh, wenn Dich niemals ein Fluch trifft. ","sagt: ");
  AddInfo( ({"orkschamane","schamane"}),
    "Der Schamane der Orks hat sich schon vor langer Zeit ein Buch bei "
    "mir ausgeliehen und nicht zurueck gebracht. Waere lieb von Dir, wenn Du "
    "es mir bringen wuerdest. ","sagt: ");    
  AddInfo( ({"ratgeber"}),
    "Wir haben Ratgeber in dieser Bibliothek. Vor allem die 'Ratgeber fuer "
    "Heimwerker' sind sehr beliebt. ","sagt: ");
  AddInfo( ({"ratgeber fuer heimwerker"}),
    "Wir haben gerade ein neues Exemplar aus Midas geliefert bekommen. Leonardo, "
    "der Tischer, leiht sie sich immer aus. Wenn Du mich darum bittest, dann "
    "geb ich ihn Dir. ","sagt: ");
  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Eine Bibliothekar will Deine Sachen nicht tragen.\n" }) );

  AddSpell(1,400, 
     "Ein Bibliothekar tritt Dich mit seinen Hufen nieder.\n",
     "Ein Bibliothekar zertrampelt @WEN mit seinen Hufen am Boden.\n",
     ({DT_BLUDGEON}), "tritt", ([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Der Bibliothekar stellt ein paar Buecher zurueck.\n",
    "Der Bibliothekar stapelt Buecher.\n"}) );
  SetAttackChats(10, ({
    "Der Bibliothekar wirft mit Buechern nach Dir.\n",
    "Der Bibliothekar zereisst Dich.\n"}) );

 SUID;
  CLONEME( "/p/armour/armour/hemd" );
  CLONEME(WEAPON "stift");
  command("trage alles");
  command("zuecke stift");

  AddCmd( ({"gib","gebe" }), "geben" );
  AddCmd( ({"bitte" }), "bitten" );
}
// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "redet beruhigend auf Dich ein.",
        "beruhigt Dich fluesternd.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schimpft leise auf Dich.",
        "schimpft leise ueber Dich.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert leise ueber Dich.",
        "kichert leise.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "bewirft Dich mit einem Leihausweis.",
        "schmeisst ein altes Buch nach Dir.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "faucht Dich fluesternd an.",
        "faucht fluesternd.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich guetig an.",
        "laechelt guetig.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "ist zu alt um darauf zu reagieren.",
        "laechelt Dich nur an.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "fluestert das es ihm gefaellt.",
        "fluestert das es ihm gefaellt.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        TP->Name(WER)+" wird von einem alten Zentauren getroestet.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
  
  
}
void tritt(object enemy, int damage, mixed dam_type)
{
  if (!enemy->QueryProp(P_DISABLE_ATTACK))
    enemy->SetProp(P_DISABLE_ATTACK, 1+random(3));
}

int geben(string str)
{
   notify_fail("Was moechtest Du wem geben?\n");
   if ( member( ({ "buch an bibliothekar", "bibliothekar buch" }),str) != -1) 
  {
  if(!present("\norkbuch", TP)){
	  
  write(BS("Du hast ja gar nicht das Buch dabei.\n"));
 
  return -1;
  }    
  write(BS( "Du gibst das Buch vom Orkschamanen dem Bibliothekar, der sich "
         "daraufhin sehr freut und Dir dankt. Er gibt das Buch einer "
         "vorbeifliegenden Fee, die das Buch in den Regalen einsortiert.\n"));
  if (present("\norkbuch",TP))
  present("\norkbuch",TP)->remove();
  return 1;
  }
}
int bitten(string str)
{
  object ratgeber;
  notify_fail( "Wen willst Du fuer wen um was bitten?\n" );
  if ( member( ({ "bibliothekar fuer leonardo um ratgeber","bibliothekar fuer tischler um ratgeber","bibliothekar um ratgeber fuer tischler","bibliothekar um ratgeber fuer leonardo","bibliothekar um ratgeber","bibliothekar um exemplar" }), str ) != -1 ) 

   {
     if( !present("dragoninvis1",TP) )
     {
        write(BS("Der Bibliothekar sagt: Aber wozu brauchst Du denn den "
		 "Ratgeber? Du solltest zuerst einmal die dazu gehoerige "
		 "Quest starten.\n"));
        return -1;
     }
      if ( present("CHIVASRATGEBER",TP) )
      {
      write(BS("Der Bibliothekar sagt: Aber ich habe Dir doch schon einen "
	       "Ratgeber fuer Leonardo gegeben. Nun lauf schnell hin und gib "
	       "ihm den Ratgeber. Er braucht ihn sicher.\n" ));
      return -1;
      }
      else
      {
      {ratgeber = clone_object( "/d/kristallwald/chivas/dragonquest/obj/buch");
        if ( ME_TOO_HEAVY == ratgeber->move(TP,M_GET|M_SILENT) )

          {
          write(
          "Der Ratgeber wuerde Dir zu schwer werden.\n" );
          ratgeber -> remove();
          return 1;
          }
          else
          {
          write(BS("Der Bibliothekar sagt: Hier nimm diesen Ratgeber fuer "
		   "Heimwerker und bring in Leonardo. Er wartet sicher schon "
		   "darauf.\n"));
          return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}

