#include "../def.h"

inherit "std/npc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Garlog, der Tavernenbesitzer");
  SetProp(P_LONG,
      "Garlog ist hier der Herr im Haus und bedient die Gaeste. Fuer einen Zentauren ist er ziemlich gross. "
      "Sein Fell schimmert matt und hat eine roetliche Farbe. Sein Oberkoerper wirkt sehr muskuloes.");

  SetProp(P_NAME, "Garlog");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));

  AddId( ({"garlog","wirt","kneipenbesitzer","besitzer"}) );
 
  create_default_npc(18);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Zentaur");
  SetProp(P_SIZE, 230);
  SetProp(P_WEIGHT, 250000);
  SetProp(P_ALIGN, 500);
  SetProp(P_SPELLRATE,25);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "trabt herein");
  SetProp(P_MSGOUT, "trabt");
  SetProp(P_MMSGIN, "trabt herein");
  SetProp(P_MMSGOUT, "trabt kurz weg");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "%s, Du wirst hier nicht mehr bedient!");
  SetProp(P_KILL_NAME, "Garlog");
  SetProp(P_KILL_MSG, "Du hast Dich mit dem falschen Zentauren angelegt!");

  AddDetail( ({ "fell"}),
    "Das Fell von Garlog schimmert matt.");
  AddDetail( ({ "farbe"}),
    "Das Fell von Garlog hat eine roetliche Farbe.");
  AddDetail( ({ "oberkoerper"}),
    "Der Oberkoerper ist sehr muskuloes. Du kannst die Muskeln sogar unter "
    "dem Hemd sehr gut erkennen.");
  AddDetail( ({ "muskeln"}),
    "Du siehst, dass Garlog sehr stark ist.");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"taverne"}),
    "Dies ist meine Taverne.",
    "sagt: ");
    
  AddInfo( ({"essen","getraenke"}),
    "Hier gibt es das beste Essen und die leckersten Getraenke.",
    "sagt: ");

  AddInfo( ({"zentauren","kunden"}),
    "Die Zentauren sind sehr gute Kunden. Sie sind sehr trinkfest.",
    "sagt: ");

  AddInfo(DEFAULT_INFO, "Was darf es sein? Ein Zentaurenbraeu?","fragt Dich: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Garlog will Deine Sachen gar nicht haben.\n" }) );

  AddSpell(1,300, 
     "Garlog tritt Dich mit seinen Hufen nieder.\n",
     "Garlog zertrampelt @WEN mit seinen Hufen am Boden.\n",
     ({DT_BLUDGEON}), "tritt", ([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Garlog putzt mit einem dreckigen Lappen die Theke.\n",
    "Garlog zapft ein Bier und reicht es einem Gast.\n"}) );

  SetAttackChats(10, ({
    "Garlog schlaegt Dich .\n"}) );

  SUID;
  CLONEME(WEAPON "spiess" );
  command("zuecke spiess");
  CLONEME(ARMOUR "hemd" );
  command("trage alles");

}
// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "redet beruhigend auf Dich ein.",
        "beruhigt Dich fluesternd.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schimpft leise auf Dich.",
        "schimpft ueber dich.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert leise ueber Dich.",
        "kichert leise.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "bespritzt Dich mit Bier.",
        "bespritzt Dich mit viel Bier.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "faucht Dich fluesternd an.",
        "faucht fluesternd.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich guetig an.",
        "laechelt guetig.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "will nichts von Dir.",
        "mag diese Naehe nicht und draengt Dich zurueck.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "laechelt ein wenig zoegernd zurueck.",
        "winkt Dir irritiert zu.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        TP->Name(WER)+" wird von Laris getroestet.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
  
  
}
void tritt(object enemy, int damage, mixed dam_type)
{
  if (!enemy->QueryProp(P_DISABLE_ATTACK))
    enemy->SetProp(P_DISABLE_ATTACK, 1+random(3));
}

