//erstellt im mai 04 von chivas
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Roarex, der Zentaurenkoenig");
  SetProp(P_LONG,
    "Roarex ist der Koenig der Zentauren. Er ist der groesste Zentaur, den Du "
    "bisher gesehen hast. Er macht einen stolzen Eindruck und das man mit ihm "
    "besser nicht scherzen sollte. Sein Fell schimmert weiss und seine lockige "
    "Maehne gibt ihm ein edles Aussehen.");
  SetProp(P_NAME, "Roarex");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId( ({ "roarex","zentaurenkoenig","koenig"}) );
  AddId(({"Schwertmeister"}));


  create_default_npc(42);
  SetProp(P_HANDS, ({" mit seinen Haenden" ,150, DT_RIP }) );
  SetProp(P_SIZE, 280 );
  SetProp(P_RACE, "Zentaur");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,60);
  SetProp(P_ARTICLE, 0);
  SetProp(P_BODY, QueryProp(P_BODY) * 2);
  SetProp(P_NOMAGIC,30);

  SetProp(P_MSGIN, "trabt an");
  SetProp(P_MSGOUT, "trabt");
  SetProp(P_MMSGIN, "kommt seine Amtsgeschaefte erledigend herein");
  SetProp(P_MMSGOUT, "trabt seine Amtsgeschaefte erledigend weiter");
  
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder %s, dann stirbst Du unter meinen Hufen!");
  SetProp(P_KILL_NAME, "Roarex, Koenig der Zentauren");
  SetProp(P_KILL_MSG, "Wage es nicht noch einmal die Macht der Zentauren heraus zu fordern!");

  AddDetail( ({ "koenig", "zentaur"}),
    "Er ist der Koenig der Zentauren.");
  AddDetail( ({ "oberkoerper"}),
    "Der Oberkoerper ist der eines Menschen.");
  AddDetail( ({ "pferd"}),
    "Der Unterleib ist der eines Pferdes.");
  AddDetail( ({ "fell"}),
    "Sein Fell schimmert weiss und sieht sehr gepflegt aus.");
  AddDetail( ({ "maehne"}),
    "Seine Maehne gibt ihm ein edles Aussehen.");
  AddDetail( ({ "aussehen"}),
    "Er sieht sehr koeniglich aus.");

  AddInfo(DEFAULT_INFO, "reagiert nicht auf kleine Abenteurer.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"palast","herrscher","koenig"}),
    "Hier lebe ich und ich bin der Koenig der Zentauren. ","sagt: ");

  AddInfo( ({"baum","baeume"}),
    "Die Baumriesen von Roch Adan sind die groessten Baeume im "
    "Silberland. ","sagt: ");

  AddInfo( ({"baumriesen"}),
    "Roch Adan besteht aus sehr grossen Baeumen. ","sagt: ");

  AddInfo( ({"schaft","axtschaft"}),
    "Die Aeste von den Baumriesen von Roch Adan sind sehr gut um einen "
    "Axtschaft herzustellen. ","sagt: ");

  AddInfo( ({"ast","aeste"}),
    "Ich kann Dir einen dicken Ast von einem der Baumriesen von Roch Adan "
    "geben, wenn Du mich darum bittest. ","sagt: ");

  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Roarex will Deine Sachen nicht tragen.\n" }) );

AddSpell(7,750, 
     "Roarex schmettert Dir kleine Blitze entgegen.\n",
     "Roarex zerschmettert @WEN mit der Macht von Blitzen.\n",
     ({DT_LIGHTNING}), ([SP_SHOW_DAMAGE:1]));
AddSpell(3,900, 
     "Roarex tritt Dich mit seinen Hufen nieder.\n",
     "Roarex zertrampelt @WEN mit seinen Hufen am Boden.\n",
     ({DT_BLUDGEON}), "tritt", ([SP_SHOW_DAMAGE:1]));
AddSpell(1,1500, 
     "Roarex schleudert Dir einen riesigen magischen Feuerball entgegen.\n",
     "Roarex zerschmettert @WEN mit einem riesigen magischen Feuerball.\n",
     ({DT_FIRE,DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );
   
  SetChats(3, ({
    "Roarex trabt gebieterisch umher.\n",
    "Roarex erledigt irgendwelche Staatsgeschaefte.\n",
    "Roarex gibt einige Befehle.\n"}) );
  SetAttackChats(10, ({
    "Roarex trampelt Dich nieder.\n",
    "Roarex zerreisst Dich.\n"}) );

 SUID;
  CLONEME(WEAPON "sternenschwert" );
  CLONEME( "/p/armour/gloves/lederhandschuhe" );
  CLONEME(ARMOUR "sternenpanzer" );
  CLONEME(ARMOUR "sternenhelm");
  command("trage alles");
  command("zuecke schwert");
//}

PALASTMASTER -> add_palast();

AddCmd( ({"bitte" }), "bitten" );  
  
}

void init()
{
  ::init();

 if ( PALASTMASTER -> IsPalastfeind(TP) ) Kill(TP);

}



//masterbeginn

 


int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER -> ruf_um_hilfe(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

void Attack(object enemy)
{
  int i;
  object ob;
  string raum;
  string *raum2;
  mapping exits;
  string *ausgaenge;

  exits = environment()->QueryProp(P_EXITS);
  ausgaenge = m_indices(exits);
  for ( i = sizeof(ausgaenge)-1; i>=0; i-- )
  {
    if ( !objectp(enemy) ) return;
    raum2 = explode(exits[ausgaenge[i]], "#" );
    raum = raum2[sizeof(raum2)-1];
    for ( ob=first_inventory(raum); ob; ob=next_inventory(ob) )
      if ( living(ob) && !query_once_interactive(ob) &&
           ob->id("\npalast") )
      {
	raum = file_name(ENV(TP));
	ob -> move(raum ,M_TPORT, 0,
          "hoert ein Heulen aus der Ferne und laeuft davon",
	  "kommt rasch herein gelaufen" );
        if ( enemy )
          ob -> Kill(enemy);
        return ::Attack(enemy);
      }
  }
  if (!objectp(enemy)) return;
  for ( ob=first_inventory(environment()); ob; ob=next_inventory(ob) )
    if ( living(ob) && !query_once_interactive(ob) &&
         ob->id("\npalast") )
      ob -> Kill(enemy);
  return ::Attack(enemy);
}

int remove(int arg)
{
  PALASTMASTER -> remove_palast(TO);
  return ::remove(arg);

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if ( killer == TO ) PALASTMASTER -> Sieg(player);
}

void tritt(object enemy, int damage, mixed dam_type)
{
  enemy->do_damage(-20+random(-20), TO);
  enemy->SetProp(P_PARALYZED, ([
    PARALYZE_TIME:5+random(15),
    PARALYZE_MSG:"Du musst Dich erst von diesem Tritt erholen!\n",
    PARALYZE_MSG_OTHER:"%s versucht sich aufzurappeln, ist aber zu "
      "erschoepft.\n",
    PARALYZE_END:"Du hast Dich erholt!\n",
    PARALYZE_END_OTHER:"%s rappelt sich auf.\n"])
  );
  enemy->move(ROOM"zen38", M_GO, "nach Suedwesten", "fliegt",
    "wird hereingeschleudert und schlaegt hart auf"
  );
}
int bitten(string str)
{
  object ast;
  notify_fail( "Wen willst Du um was bitten?\n" );
  if ( member( ({ "roarex um ast", "koenig um ast", "zentaur um ast" }), str ) != -1 ) 

   {
     if( !present("dragoninvis1",TP) )
     {
        write(BS("Roarex sagt: Aber wozu brauchst Du denn einen Ast? Du "
		 "solltest zuerst einmal die dazu gehoerige Quest starten.\n"));
        return -1;
     }
     if( present("CHIVASAXTSCHAFT",TP) )
     {
        write(BS("Roarex sagt: Aber wozu brauchst Du denn einen Ast? Du hast "
		 "doch schon einen Axtschaft.\n"));
        return -1;
     }
     if ( present("CHIVASAST",TP) )
      {
      write(BS("Roarex sagt: Aber ich habe Dir doch schon einen Ast gegeben. "
	       "Nun werde mal nicht gierig und verschwinde.\n" ));
      return -1;
      }
      else
      {
      {ast = clone_object( "/d/kristallwald/chivas/dragonquest/obj/ast");
        if ( ME_TOO_HEAVY == ast->move(TP,M_GET|M_SILENT) )

          {
          write(
          "Der Ast wuerde Dir zu schwer werden.\n" );
          say(BS(sprintf("%s ist einfach zu schwach.\n", TP->Name(WER))));
          ast -> remove();
          return 1;
          }
          else
          {
          write(BS("Roarex sagt: Hier nimm diesen dicken Ast vom Baumriesen "
		   "des Palastes. Es ist das beste Holz im ganzen Silberland. "
		   "Damit kannst Du einen hervorragenden Schaft fuer eine Axt "
	           "herstellen.\n"));
          return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}

