
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Elen, der Astrologe");
  SetProp(P_LONG, BS(
    "Dies ist Elen, er ist der koenigliche Astrologe, der die Sterne und "
    "Planeten studiert und fuer diesen Teil des Palastes zustaendig ist. Er "
    "macht einen nicht sehr gluecklichen Eindruck und ist am fluchen."));
  SetProp(P_NAME, "Elen");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
  AddId("elen","astrologe");
  set_living_name("Elen");

  create_default_npc(25);
  SetProp(P_HANDS, ({" mit seinen Haenden",25,DT_BLUDGEON}));
  SetProp(P_RACE, "Zentaur");
  SetProp(P_SIZE, 230);
  SetProp(P_WEIGHT, 210000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOATTACK,1);

  SetProp(P_MSGIN, "trabt an.");
  SetProp(P_MSGOUT, "trabt.");
  SetProp(P_MMSGIN, "trabt herein.");
  SetProp(P_MMSGOUT, "verschwindet.");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Mit mir legst Du Dich nicht mehr an, Du Schuft!");

  AddDetail( ({ "eindruck"}),
    "Er scheint traurig zu sein.");

  AddInfo(DEFAULT_INFO, "hat andere Sorgen, als sich mit Dir zu "
                        "beschaeftigen.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"elen"}),
    "Ich bin der koenigliche Astrologe von Roch Adan, ich "
    "kuemmere mich um die Deutung der Zukunft.",
    "sagt: ");
    
  AddInfo( ({"zukunft","deutung"}),
    "Normalerweise kann ich Dir die Zukunft aus den Bewegungen der "
    "Planeten sagen, leider hat der verdammte Hofnarr wieder mein "
    "Teleskop geklaut.",
    "sagt: ");

  AddInfo( ({"hofnarr","narr"}),
    "Der Hofnarr treibt staendig Schabernack. Dieses Mal hat er mein Teleskop "
    "auseinander gebaut und die Einzelteile versteckt.",
    "sagt: ");
    
  AddInfo( ({"teleskop"}),
    "Das Teleskop steht sonst immer hier in der Mitte des Raumes. "
    "Jetzt hat der Hofnarr die einzelnen Teile des Teleskops versteckt.",
    "sagt: ");

  AddInfo( ({"hilfe"}),
    "Du willst mir wirklich helfen? Das waere wirklich nett. Der Hofnarr des "
    "Koenigs hat mir wieder einen Streich gespielt und mein Teleskop geklaut. "
    "Er hat es auseinander gebaut und die einzelnen Teile versteckt. Wenn Du "
    "mir helfen willst, dann biete mir Deine Hilfe an.",
    "sagt: ");
    
  AddInfo( ({"teile","einzelteile"}),
    "Das Teleskop laesst sich in acht Einzelteile zerlegen. Das Teleskop, "
    "drei Linsen, und vier Staebe, die als Fuesse dienen. Der Hofnarr hat sie "
    "irgendwo in Roch Adan an verschiedenen Orten versteckt.",
    "sagt: ");

  AddInfo( ({"ort","orte"}),
    "Da kann ich Dir leider nicht helfen, ich weiss nur, dass die Teile "
    "irgendwo in Roch Adan versteckt sind. Du musst sie schon suchen.",
    "sagt: ");

  AddInfo( ({"teleskop"}),
    "Da kann ich Dir leider nicht helfen, ich weiss nur, dass das Teleskop "
    "irgendwo in Roch Adan versteckt ist. Du musst es schon suchen.",
    "sagt: ");

  AddInfo( ({"stab","staebe"}),
    "Da kann ich Dir leider nicht helfen, ich weiss nur, dass die Staebe "
    "irgendwo in Roch Adan versteckt sind. Du musst sie schon suchen.",
    "sagt: ");

  AddInfo( ({"linse","linsen"}),
    "Da kann ich Dir leider nicht helfen, ich weiss nur, dass die Linsen "
    "irgendwo in Roch Adan versteckt sind. Du musst sie schon suchen.",
    "sagt: ");

  AddInfo( ({"sternenstaub","staub","beutel"}),
    "Sternenstaub ist sehr selten. Ich koennte Dir ein wenig Sternenstaub "
    "geben, wenn Du mir einen Gefallen tun wuerdest.",
    "sagt: ");

  AddInfo( ({"gefallen","heldenbier"}),
    "Ich habe so einen Durst auf das herbe Heldenbier der Orks. Wenn Du zu "
    "dem Wirt der Schenke in den Orkhoehlen gehst und mir ein Faesschen "
    "bringst und es mir gibst, dann gebe ich Dir einen Beutel mit "
    "Sternenstaub.",
    "sagt: ");

  AddInfo( ({"schenke","wirt","elfenmetzler"}),
    "Der Wirt in der Schenke 'Zum Elfenmetzler' in den Orkhoehlen kann Dir ein "
    "Faesschen Heldenbier geben.",
    "sagt: ");

  AddInfo( ({"orks","orkhoehlen"}),
    "Die Orkhoehlen sind irgendwo noerdlich von Roch Adan unter der Hochebene "
    "von Gorthad.",
    "sagt: ");

  AddInfo( ({"faesschen","fass"}),
    "Besorge bitte eines fuer mich. Geh zum Wirt in den Orkhoehlen und "
    "erwerbe ein Faesschen fuer mich und gib es mir. Dann gebe ich Dir auch "
    "einen Beutel mit Sternenstaub.",
    "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das ist Elen zu schwer.\n" }) );

  SetChats(3, ({
          "Elen ist laut am fluchen und schimpft ueber den Hofnarr.\n",
          "Elen grummelt: Dieser verdammte Hofnarr, immer versteckt er alles.\n",
          "Elen sucht sein Teleskop.\n"}) );

  SetAttackChats(10, ({
    "Elen droht mit seinen Faeusten.\n",
    "Elen tritt Dir auf den Fuss.\n"}) );

  AddCmd( ({"gib","gebe" }), "geben" );

}
// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "redet beruhigend auf Dich ein.",
        "beruhigt Dich fluesternd.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schimpft leise auf Dich.",
        "grummelt ueber dich fluesternd.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert leise ueber Dich.",
        "kichert leise.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "tritt Dich mit seinen Hufen.",
        "schnaupt Dich boese an.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "schimpft leise ueber Dich.",
        "schimpft leise ueber Dich und den Hofnarr.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich guetig an.",
        "laechelt guetig.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "will nicht mit Dir kuscheln, er will sein Teleskop.",
        "hat keine Zeit mit Dir zu kuscheln.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "fluestert das ihm das sehr gefaellt.",
        "fluestert das ihm das sehr gefaellt.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        TP->Name(WER)+" wird von Elen getroestet.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
int geben(string str)
{
  object staub;
  notify_fail("Was moechtest Du wem geben?\n");
   if ( member( ({ "elen faesschen", "faesschen an elen","elen fass","fass an elen" }),str) != -1) 
  {
  if(!present("faesschen", TP)){
	  
  write(BS("Du hast ja gar nicht das Faesschen dabei, Du musst es erst beim "
	   "Wirt in den Orkhoehlen erwerben.\n"));
 
  return -1;
  }    
  write(BS( "Du gibst Elen das Faesschen mit dem Heldenbier der Orks und "
	    "er packt es gleich zu seinen Sachen. Daraufhin holt er aus dem "
	    "Schrank einen kleinen Beutel mit Sternenstaub und gibt ihn Dir.\n"));
  if (present("faesschen",TP))
  present("faesschen",TP)->remove();
  staub = clone_object( "/d/kristallwald/chivas/dragonquest/obj/staub");
  staub->move(TP,M_GET|M_SILENT);
  return 1;
  }
}

