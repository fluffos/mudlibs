//erstellt im mai 04 von chivas
inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Palastwache von Roch Adan");
  SetProp(P_LONG,
    "Dieser Zentaur ist eine stattliche Palastwache. Er bewacht den Palast und "
    "sorgt fuer Ruhe und Ordnung. Sein Oberkoerper und sein Pferdekoerper sind "
    "durch Ruestungen geschuetzt. Er hat eine lange Maehne und ein schwarzes "
    "Fell.");
  SetProp(P_NAME, "Palastwache");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId( ({ "palastwache","wache"}) );
  AddId(({"Schwertmeister"}));


  create_default_npc(28);
  SetProp(P_HANDS, ({" mit seinen Haenden" ,150, DT_RIP }) );
  SetProp(P_SIZE, 260 );
  SetProp(P_RACE, "Zentaur");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,30);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "trabt an");
  SetProp(P_MSGOUT, "trabt");
  SetProp(P_MMSGIN, "kommt Dich inspizierend herein");
  SetProp(P_MMSGOUT, "trabt auf der Suche nach Stoerenfrieden weiter");
  
  SetProp(P_MNPC_AREA, ( {ROOM "zen38", ROOM "zen39", ROOM "zen40",
                          ROOM "zen41",ROOM "zen42"}));
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "zen41");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS); 

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder %s, dann stirbst Du unter meinen Hufen!");
  SetProp(P_KILL_NAME, "Eine Palastwache");
  SetProp(P_KILL_MSG, "Du hattest keine Chance, Kleiner!");

  AddDetail( ({ "wache","palastwache", "zentaur"}),
    "Dieser Zentaur gehoert zur Palastwache von Roch Adan.");
  AddDetail( ({ "oberkoerper"}),
    "Der Oberkoerper ist der eines Menschen.");
  AddDetail( ({ "pferd"}),
    "Der Unterleib ist der eines Pferdes.");
  AddDetail( ({ "maehne"}),
    "Die wilde Maehne weht ein wenig im Wind.");
  AddDetail( ({ "fell"}),
    "Das schwarze Fell scheint matt.");

  AddInfo(DEFAULT_INFO, "beachtet Dich einfach waehrend des Dienstes nicht.\n");  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");
  AddInfo("elen", "Elen ist der Astrologe hier im Palast.","sagt: ");
  AddInfo("teleskop", "Der verdammte Hofnarr hat sicher wieder das Teleskop "
          "von Elen versteckt. Wir von der Wache werden ihn irgendwann "
          "deswegen mal wegsperren.","sagt: ");
  AddInfo("versteck", "Da kann ich leider nicht helfen.","sagt: ");
  AddInfo("wache", "Wir beschuetzen unseren Koenig.","sagt: ");

  AddInfo( ({"palast","herrscher","koenig"}),
    "Hier lebt unser Koenig, der Herrscher der Zentauren. ");
    
  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Palastwache will Deine Sachen nicht tragen.\n" }) );
  AddSpell(1,300, 
     "Eine Palastwache tritt Dich mit seinen Hufen nieder.\n",
     "Eine Palastwache zertrampelt @WEN mit seinen Hufen am Boden.\n",
     ({DT_BLUDGEON}), "tritt", ([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Eine Palastwache verscheucht einige Kinder.\n",
    "Eine Palastwache mustert Dich und laechelt grimmig.\n",
    "Eine Palastwache ignoriert Dich.\n"}) );
  SetAttackChats(10, ({
    "Die Palastwache trampelt Dich nieder.\n",
    "Die Palastwache zereisst Dich.\n"}) );

 SUID;
  CLONEME(WEAPON "kometenschwert" );
  CLONEME( "/p/armour/gloves/lederhandschuhe" );
  CLONEME(ARMOUR "kometenpanzer" );
  CLONEME(ARMOUR "kometenhelm");
  command("trage alles");
  command("zuecke schwert");
//}

PALASTMASTER -> add_palast();
  
  
}

void init()
{
  ::init();

 if ( PALASTMASTER -> IsPalastfeind(TP) ) Kill(TP);

 if(TP && interactive(TP)) call_out("init_hallo",0,TP);
}



//masterbeginn

 


int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER -> ruf_um_hilfe(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

void Attack(object enemy)
{
  int i;
  object ob;
  string raum;
  string *raum2;
  mapping exits;
  string *ausgaenge;

  exits = environment()->QueryProp(P_EXITS);
  ausgaenge = m_indices(exits);
  for ( i = sizeof(ausgaenge)-1; i>=0; i-- )
  {
    if ( !objectp(enemy) ) return;
    raum2 = explode(exits[ausgaenge[i]], "#" );
    raum = raum2[sizeof(raum2)-1];
    for ( ob=first_inventory(raum); ob; ob=next_inventory(ob) )
      if ( living(ob) && !query_once_interactive(ob) &&
           ob->id("\npalast") )
      {
	raum = file_name(ENV(TP));
	ob -> move(raum ,M_TPORT, 0,
          "hoert ein Heulen aus der Ferne und laeuft davon",
	  "kommt rasch herein gelaufen" );
        if ( enemy )
          ob -> Kill(enemy);
        return ::Attack(enemy);
      }
  }
  if (!objectp(enemy)) return;
  for ( ob=first_inventory(environment()); ob; ob=next_inventory(ob) )
    if ( living(ob) && !query_once_interactive(ob) &&
         ob->id("\npalast") )
      ob -> Kill(enemy);
  return ::Attack(enemy);
}

int remove(int arg)
{
  PALASTMASTER -> remove_palast(TO);
  return ::remove(arg);

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if ( killer == TO ) PALASTMASTER -> Sieg(player);
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "redet beruhigend auf Dich ein.",
        "beruhigt Dich fluesternd.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schimpft leise auf Dich.",
        "grummelt ueber dich fluesternd.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "findet gar nichts lustig.",
        "findet gar nichts lustig.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "droht Dir mit einem Schwert.",
        "schaut boese.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "faucht Dich fluesternd an.",
        "faucht fluesternd.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich guetig an.",
        "laechelt guetig.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "fluestert Dir zu: Nicht wenn ich Dienst habe Schatz.",
        "fluestert Dir zu: Spaeter mein Engel, jetzt muss ich arbeiten.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "schaut Dich streng an.",
        "guckt ein wenig boese.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "beachtet Dein Verhalten gar nicht.",
        TP->Name(WER)+" wird von einer Palastwache gar nicht beachtet.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
  
  
}

void tritt(object enemy, int damage, mixed dam_type)
{
  if (!enemy->QueryProp(P_DISABLE_ATTACK))
    enemy->SetProp(P_DISABLE_ATTACK, 1+random(3));
}

