#include "../def.h"
#include <properties.h>
#include <language.h>
#include <thing.h>
#include <moving.h>

inherit "/std/container";

nosave string my_short()
{
  string ret;
  
  ret="Eine ";
   
  if(QueryProp(P_CNT_STATUS)==1)
  {
    ret+="geschlossene ";
  }
  else
  {
    ret+="geoeffnete ";
  }
  ret+="Truhe";
 
  return ret;
}
 
nosave string my_long()
{
  string ret;
  
  ret="Eine einfache Truhe. Sie besteht aus Eichenholz und hat Beschlaege "
      "aus Metall. Momentan ist sie ";
  if(QueryProp(P_CNT_STATUS) == 1)
  {
    ret+="geschlossen.";
  }
  else
  {
    ret+="geoeffnet. Am Boden der Truhe erkennst Du ein Loch.";
  }
  return(break_string(ret,78));
}
void create()
{
  if(!is_clone(this_object()))
  {
    return;
  }
  container::create();
  
  SetProp(P_SHORT,#'my_short);
  Set(P_LONG,#'my_long,F_QUERY_METHOD);
  SetProp(P_NAME,"Truhe");
  SetProp(P_GENDER,FEMALE);
  SetProp(P_MAX_WEIGHT,50000);
  SetProp(P_CNT_STATUS,1);
  SetProp(P_TRANSPARENT,0);
  SetProp(P_NOGET,"Die Truhe ist einfach zu schwer.\n");
  SetProp(P_MATERIAL, ([MAT_OAK :92, MAT_IRON:8]) );
  AddId(({"truhe"}));
  
  AddDetail( ({"eichenholz","holz"}),
    "Die Truhe besteht aus Eichenholz, das Holz ist alt aber dennoch sehr hart.");

  AddDetail( ({"beschlaege","metall"}),
    "Die Beschlaege der Truhe sind aus Eisen.");

  AddDetail( ({"eisen"}),
    "Das Eisen rostet schon ein wenig.");

  AddSpecialDetail( ({ "loch"}),"detailloch" );
   
  AddCmd(({"oeffne"}),"oeffnen_act");
  AddCmd(({"schliess","schliesse"}),"schliessen_act");
  AddCmd( ({"zwaeng", "zwaenge" }), "zwaengen" );
}
string detailloch()
{
  if (QueryProp(P_CNT_STATUS))
  {
  return(BS("Du siehst hier kein Loch."
           ));}
  return(BS("Du siehst am Boden der Truhe ein Loch. Du kannst Dich sicher "
                     "durch das Loch zwaengen. Aber pass auf, Du weisst nicht, was "
                     "Dich dort erwartet.\n"));
}

nosave int oeffnen_act(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");
  if(!str)
  {
    return 0;
  }
  if(str=="truhe")
  {
    if(QueryProp(P_CNT_STATUS)==0)
    {
      write(break_string("Die Truhe ist schon geoeffnet.",78));
      return 1;
    }
    else
    {
      SetProp(P_CNT_STATUS,0);
      SetProp(P_TRANSPARENT,1);
      
      write(break_string("Du oeffnest die Truhe.",78));
      tell_room(environment(this_player()),
      break_string(this_player()->name(WER)+" oeffnet eine "
      "Truhe.",78),({this_player()}));
      return 1;
    }
  }
  else
  {
    return 0;
  }
}
nosave int schliessen_act(string str)
{
  notify_fail("Was moechtest Du schliessen?\n");
  if(!str)
  {
    return 0;
  }
  if(str=="truhe")
  {
    if(QueryProp(P_CNT_STATUS)==1)
    {
      write(break_string("Die Truhe ist schon geschlossen.",78));
      return 1;
    }
    else
    {
      SetProp(P_CNT_STATUS,1);
      SetProp(P_TRANSPARENT,0);
      write(break_string("Du schliesst die Truhe.",78));
      tell_room(environment(this_player()),
      break_string(this_player()->name(WER)+" schliesst eine "
      "Truhe.",78),({this_player()}));
      return 1;
    }
  }
  else
  {
    return 0;
  }
}
void reset()
{
  container::reset();
  
  if(QueryProp(P_CNT_STATUS)==0)
  {
    SetProp(P_CNT_STATUS,1);
    SetProp(P_TRANSPARENT,0);
  }
} 
int zwaengen(string str)
{
   notify_fail("Wodurch willst Du Dich zwaengen?\n");
   if ( member( ({ "durch loch", "durch loch im boden","durch loch in truhe","durch loch in boden" }),str) != -1) 
  {
    write(BS ( "Du zwaengst Dich durch das Loch im Boden der Truhe und landest in einem Keller."));
    say( TPN+" steigt in die Truhe und verschwindet.\n");
    TP->move( ROOM "zenkeller", M_GO, "unten");
    return 1;
  }
}

