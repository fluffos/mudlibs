inherit "std/food";    

#include <food.h>      
#include "../def.h"


void create()
{
  if (!is_clone(this_object()))    
    return;                             

  ::create();


  AddId( ({ "heidelbeere" }) );
  AddId( ({ "beere" }) );

  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Heidelbeere");
  SetProp(P_SHORT, "Eine Heidelbeere");
  SetProp(P_LONG,
    "Die Heidelbeere ist klein und rund und sieht unglaublich "
    "lecker aus. Du kannst sie essen.");
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 5); 
  SetProp(P_NOSELL, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_FOOD:100]));
  SetProp(P_INFO,
      "Du willst die Heidelbeere nur noch essen!\n");
  SetProp(P_SMELL,
      "Riecht nach .. Heidelbeere.");

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 5, 0 }),
         F_SOAK    : 2,         
         F_DRINK   : 0,       
         F_ALCOHOL : 0,         
         F_POISON  : 0,         
         F_MSG     : "Du isst die Heidelbeere.",
         F_MSG_ROOM: "verschlingt gierig eine Heidelbeere!",
         F_VERB    : "essen"   
      ]) );                   
}




