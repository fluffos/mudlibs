#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleiner Dietrich");
  SetProp(P_LONG,
    "Ein kleiner Dietrich, mit dem Du sicher irgendetwas oeffnen koenntest.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Dietrich");
  SetProp(P_GENDER, MALE);
  AddId("dietrich");
  AddId("\nchivasdietrich");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_METAL: 100]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_SIZE, 80);
  SetProp(P_VALUE, 50);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

}

string *QueryDoorKey() {
   return ({ ORKHOEHLE+"/room/orks10:"+ZWERGENFESTE+"/room/zwfe28",
             ORKHOEHLE+"/room/orks10:"+ORKHOEHLE+"/room/orks13" }); 
}

