// 16.05.2004

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Urkunde");
  SetProp(P_LONG,
    "Die Urkunde macht Dich zu einem stolzen Besitzer eines grossen Gebietes in der Wueste. "
    "Irgendwie findest Du, dass es kein gutes Geschaeft war.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Urkunde");
  SetProp(P_GENDER, FEMALE);
  AddId("urkunde");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_PERGAMENT: 100]) );
  SetProp(P_WEIGHT, 20);
  SetProp(P_SIZE, 300);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 1);

  AddReadDetail( ({"urkunde"}),
		"Du liest, dass Dich die offizielle Urkunde zu einem "
                "stolzen Besitzer eines Wuestengebietes macht. Irgendwie "
                "bist Du enttaeuscht. ");
}
