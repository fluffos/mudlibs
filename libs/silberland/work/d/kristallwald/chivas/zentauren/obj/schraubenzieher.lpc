#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Schraubenzieher");
  SetProp(P_LONG,
    "Der Schraubenzieher ist in einem guten Zustand. Der Schraubenzieher dient "
    "dazu Schrauben zu lockern oder festziehen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schraubenzieher");
  SetProp(P_GENDER, MALE);
  AddId("schraubenzieher","QUESTOBJ");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_METAL: 100]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE, 150);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

}
