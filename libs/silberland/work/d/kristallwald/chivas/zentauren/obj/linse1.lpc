#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine grosse Linse");
  SetProp(P_LONG,
    "Die grosse Linse gehoert anscheinend in ein Teleskop, da sie zu vergroessern scheint.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Linse");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, "gross");
  AddAdjective(({"gross","grosse","grossen","grosser"}));
  AddId("QUESTOBJ");
  AddId("linse");
  AddId("linse1");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_GLASS: 100]) );
  SetProp(P_WEIGHT, 80);
  SetProp(P_SIZE, 80);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

}
