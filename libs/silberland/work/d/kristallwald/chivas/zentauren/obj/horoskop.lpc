#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Dein persoenliches Horoskop");
  SetProp(P_LONG,
    "Auf dem Zettel steht nur, dass Du in diesem Leben noch sehr viel Glueck haben "
    "wirst, es jedoch sehr kurz sein wird.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Horoskop");
  SetProp(P_GENDER, NEUTER);
  AddId("horoskop","QUESTOBJ");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_PAPER: 100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

}
