#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein gruener Stab");
  SetProp(P_LONG,
    "Der gruene Stab kann am oberen Ende in irgend etwas eingeschraubt werden und am unteren Ende "
    "scheint es in eine Fassung zu passen, so dass man ihn am Boden verankern kann.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Stab");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME_ADJ, "gruen");
  AddAdjective(({"gruen","gruene","gruenen","gruener"}));
  AddId("QUESTOBJ");
  AddId("stab");
  AddId("stab2");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_GLASS: 100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_SIZE, 1500);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

}
