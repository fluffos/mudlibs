/*
 * schokoriegel.c
 * ---
 * Letzte Aenderung: 2001-10-27 by Woody.
 *
 * Ein Beispiel fuer ein Nahrungsobjekt, ein Schokoriegel.
 *
 * Wichtig ist, dass derlei Objekte unbedingt beim Regionsmagier sowie
 * der Balance gemeldet werden muessen, bevor sie ins Spiel gebracht
 * werden duerfen.
 *
 */

inherit "std/food";     // ist fuer tragbare Heilung immer zu inheriten!

#include <properties.h>
#include <food.h>       // enthaelt die spezifischen food-Properties etc.


void create()
{
  if (!is_clone(this_object()))         // Die Blueprint braucht keinerlei
    return;                             // (objektbezogenen) Properties

  ::create();

  // Unter folgenden Begriffen kann ein Spieler spaeter das Objekt
  // ansprechen (mit "unt", "iss", "wirf...weg", ...):
  AddId( ({ "riegel", "schokoriegel" }) );

  // Properties fuer Namensermittlung des Objekts
  // z.B. obj->name(WEN,1) == "den leckeren Schokoriegel"
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME_ADJ, ({ "lecker" }) );
  SetProp(P_NAME, "Schokoriegel");

  // P_SHORT scheint fuer Objekte im Inventory bzw. in Raeumen liegenden auf
  SetProp(P_SHORT, "Ein Schokoriegel");
  // Die P_LONG wird bei "unt riegel" angezeigt. Wichtig: Zeilenumbrueche
  // braucht man nicht selbst angeben, diese werden automatisch gesetzt!
  // Und: normalerweise sollten Langbeschreibungen schon 2-3 Zeilen umfassen.
  SetProp(P_LONG,
    "Ein lecker aussehender Vollmilchschokoriegel.");

  SetProp(P_WEIGHT, 100);       // 100 Gramm hat eine Tafel normalerweise ;)
  SetProp(P_VALUE, 50);         // und ist hier 50 Muenzen wert.
  SetProp(P_MATERIAL,
      ([ MAT_MISC_FOOD : 100 ]) );      // 100% Nahrung (nicht naeher spezif.)

  SetProp(P_INFO,
      "Schokolade hat viel Zucker. Das staerkt. Auch Dich.");

  SetProp(P_SMELL,
      "Die Schokolade riecht ein wenig nach ... Schokolade. Und Kakao. :)");

  // Nun folgt der eigentlich interessante Teil fuer Nahrungsobjekte:
  // Die Property, die alles nahrungsspezifische festlegt, P_FOOD_INFO.
  // Wichtig ist hier, dass die durchschnittliche ((LP+MP)/2) Heilung max.
  // den doppelten Wert der aufaddierten Saettigungen betragen sollte.
  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 5,0 }), // Schoko heilt 5 Lebens- und 0 Magiepunkte
         F_SOAK    : 3,         // saettigt dabei um 3 Punkte
         F_DRINK   : 0,         // Trinksaettigung 0
         F_ALCOHOL : 0,         // Alkohol auch keiner ;)
         F_POISON  : 0,         // Vergiftet ist sie auch nicht
         F_MSG     : "Du naschst einen leckeren staerkenden Schokoriegel.",
         F_MSG_ROOM: "nascht einen leckeren Schokoriegel.",
         F_VERB    : "essen"    // Wird fuer Fehlermeldung "Was willst Du
      ]) );                     // essen" benoetigt
}


void Eating(object pl)
{
  // Diese Funktion wird automatisch aufgerufen, sobald der Spieler
  // die Nahrung verzehrt. Hier koennte man ihm etwa schokoladen-
  // verschmierte Finger (unsichtbares Objekt) verpassen, oder
  // andere Dinge tun, Heilung, Saettigung und Texte hingegen
  // sollten nur via P_FOOD_INFO gesetzt werden.
}

