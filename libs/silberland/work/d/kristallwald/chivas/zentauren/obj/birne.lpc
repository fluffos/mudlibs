inherit "std/food";    

#include <food.h>      
#include "../def.h"


void create()
{
  if (!is_clone(this_object()))    
    return;                             

  ::create();


  AddId( ({ "birne" }) );

  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Birne");
  SetProp(P_SHORT, "Eine Birne");
  SetProp(P_LONG,
    "Die Birne ist schoen gross und saftig. Da laeuft Dir das Wasser "
    "im Mund zusammen. Einfach lecker.");
  SetProp(P_WEIGHT, 25);
  SetProp(P_VALUE, 0); 
  SetProp(P_NOSELL, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_FOOD:100]));
  SetProp(P_INFO,
      "Du willst die Birne nur noch essen!\n");
  SetProp(P_SMELL,
      "Riecht nach .. Birne.");

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 5, 0 }),
         F_SOAK    : 2,         
         F_DRINK   : 0,       
         F_ALCOHOL : 0,         
         F_POISON  : 0,         
         F_MSG     : "Du isst die Birne.",
         F_MSG_ROOM: "verschlingt gierig eine Birne!",
         F_VERB    : "essen"   
      ]) );                   
}




