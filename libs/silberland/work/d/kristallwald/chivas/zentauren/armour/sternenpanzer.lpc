
inherit "/std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Sternenpanzer");
  SetProp (P_LONG,
    "Dieser herrliche Panzer wurde vollstaendig aus einem Dir unbekannten "
    "Kristall gefertigt. Du kannst einzelne Sterne auf dem Panzer "
    "sehen, die unterschiedlich leuchten. Der Panzer scheint ein Abbild "
    "des Sternenhimmels zu sein. Es sieht fast so aus, als ob sich die Sterne "
    "auch bewegen.");
  SetProp (P_NAME, "Sternenpanzer");
  SetProp (P_GENDER, MALE);
  AddId (({"panzer","sternenpanzer"}));

  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 40);
  SetProp (P_MATERIAL, MAT_CRYSTAL);
  SetProp (P_WEIGHT, 3000);
  SetProp (P_VALUE, 9500);
  SetProp (P_QUALITY_DECAY, 250);
  SetProp (P_WEAR_RESTRICTIONS, ([A_STR:17]) );
  SetProp(P_INFO, "Der Panzer scheint etwas ganz besonderes zu sein, als "
                "ob der Sternenhimmel darauf abgebildet ist.");

  AddDetail( ({"sterne"}),
    "Die Sterne glaenzen und der Panzer sieht aus, also ob sich "
    "die Oberflaeche des Panzers bewegen tut.");
  AddDetail( ({"sternenhimmel","himmel"}),
    "Der Sternenhimmel auf dem Panzer sieht fantastisch aus. "
    "Man kann verschiedene Sternenbilder erkennen.");
  AddDetail( ({"sternenbilder","bilder"}),
    "Die Sternenbilder kennst Du leider nicht. Du beschliesst "
    "Dich in Zukunft mehr damit zu beschaeftigen.");
  
}
