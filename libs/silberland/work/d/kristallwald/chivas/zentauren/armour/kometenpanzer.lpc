
inherit "/std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Kometenpanzer");
  SetProp (P_LONG,
    "Der Panzer besteht aus zwei Platten aus Kometenkristall, von denen die "
    "eine die Brust und die andere den Ruecken schuetzt. Beide Platten sind "
    "durch Eisenringe verbunden, um dem Oberkoerper noch einige "
    "Bewegungsfreiheit zu gewaehren.");
  SetProp (P_NAME, "Kometenpanzer");
  SetProp (P_GENDER, MALE);
  AddId (({"panzer","kometenpanzer"}));
  
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 30);
  SetProp (P_MATERIAL, ([MAT_CRYSTAL:92, MAT_IRON:8]) );
  SetProp (P_WEIGHT, 4000);
  SetProp (P_VALUE, 1700);
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR      : 15 ]) );

  AddDetail("kometen","kristall", 
    "Der Panzer scheint aus einem Kristall zu bestehen, die von einem "
    "Kometen stammen.");
  AddDetail( ({"platten", "platte"}),
    "Eine Platte schuetzt die Brust, die andere den Ruecken.");
  AddDetail( ({"ringe", "eisenringe"}),
    "Die Eisenringe verbinden die beiden Kristallplatten. Sie gewaehrem dem "
    "Oberkoerper etwas mehr Bewegungsfreiheit, als eine Vollruestung, sind "
    "aber auch ein Schwachpunkt, weil der Koerper so an der Seite schlechter "
    "geschuetzt ist.");
}
