#include "../def.h"

inherit "std/armour";  

void create()
{
  if(!is_clone(this_object())) return;   
                                         

  ::create();

  SetProp(P_SHORT, "Ein dreckiges Hemd");
  SetProp(P_LONG,
    "Ein dreckiges Hemd, auf dem lauter Flecken zu finden sind."
  );

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Hemd");
  AddId("hemd");

  SetProp(P_NAME_ADJ, ({"dreckig"}) );

  AddAdjective( ({"dreckig","dreckigen","dreckiges"}) );

  SetProp(P_INFO,
      "Das dreckige Hemd steht Dir sehr gut und passt gut zu Deiner Gesamterscheinung.\n");

  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 80);
  SetProp(P_MATERIAL, ([ MAT_CLOTH : 100 ]) );
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);

  SetProp(P_AC, 4);

  SetProp(P_QUALITY_DECAY, 50); 

  SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES);
  SetProp(P_WORN_TEXT, "getragen");
  SetProp(P_WEAR_TEXT, ({ "Du ziehst das dreckiges Hemd an.\n",
                          " zieht das dreckige Hemd an.\n" }) );
  SetProp(P_UNWEAR_TEXT, ({ "Du ziehst das dreckiges Hemd aus.\n",
                            " zieht das dreckige Hemd aus.\n" }) );
  SetProp(P_TEMPERATURE_PROTECTION,
      ([ T_COLD_PROT:2,T_HEAT_PROT:1 ]) );



}

