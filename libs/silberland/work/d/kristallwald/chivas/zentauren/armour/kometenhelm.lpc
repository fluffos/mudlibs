inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Kometenhelm");
  SetProp(P_LONG, 
    "Es ist ein relativ widerstandsfaehiger Helm aus Kristall. Der ganze Kopf "
    "und Hals ist durch dicke Kristallplatten geschuetzt, nur im Gesicht "
    "befindet sich ein herzfoermige Oeffnung, durch die Augen und Mund "
    "frei bleiben.");
  SetProp(P_NAME, "Kometenhelm");
  SetProp(P_GENDER, MALE);
  AddId( ({"helm", "kometenhelm"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 11);
  SetProp(P_MATERIAL, MAT_CRYSTAL);
  SetProp(P_WEIGHT, 1100);
  SetProp(P_VALUE, 3500);
  SetProp(P_QUALITY_DECAY, 250);
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:15]) );
  SetProp(P_DAM_PROTECTION, 
   QueryProp(P_DAM_PROTECTION) + ([DT_ACID:1]));
  

  
}




