
inherit "/std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Sternenhelm");
  SetProp(P_LONG, 
    "Es ist ein relativ widerstandsfaehiger Helm aus Sternenkristall. Der ganze Kopf "
    "und Hals ist durch dicke Platten geschuetzt, nur im Gesicht "
    "befindet sich ein herzfoermige Oeffnung, durch die Augen und Mund "
    "frei bleiben.");
  SetProp(P_NAME, "Sternenhelm");
  SetProp(P_GENDER, MALE);
  AddId( ({"helm", "sternenhelm"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 14);
  SetProp(P_MATERIAL, MAT_CRYSTAL);
  SetProp(P_WEIGHT, 1100);
  SetProp(P_VALUE, 3500);
  SetProp(P_QUALITY_DECAY, 250);
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:15]) );
  SetProp(P_INFO, "Der Helm scheint etwas ganz besonderes zu sein, als "
                "ob der Sternenhimmel darauf abgebildet ist.");

  AddDetail( ({"sterne"}),
    "Die Sterne glaenzen und dem Helm und es sieht aus, also ob sich "
    "die Oberflaeche des Helmes bewegen tut.");
  AddDetail( ({"sternenhimmel","himmel"}),
    "Der Sternenhimmel auf dem Helm sieht fantastisch aus. "
    "Man kann verschiedene Sternenbilder erkennen.");
  AddDetail( ({"sternenbilder","bilder"}),
    "Die Sternenbilder kennst Du leider nicht. Du beschliesst "
    "Dich in Zukunft mehr damit zu beschaeftigen.");
  AddDetail( ({"sternenkristall","kristall"}),
    "Auf dem Kristall kannst Du einzelne Sterne sehen.");
  AddDetail( ({"oeffnung"}),
    "Durch die Oeffnung bleiben Augen und Nase frei.");

}

