//Master Palast 

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>


object *palast;
object *palastfeinde;

void create()
{
  if (is_clone(TO))
  {
    destruct(TO);
    return;
  }

  palast = ({});
  palastfeinde = ({});
  
  seteuid(getuid(TO));
  return;
}

//PALASTMASTER
add_palast()
{
  palast += ({ PO });
}
ruf_um_hilfe(object spieler)
{
  if ( member(palastfeinde,spieler) == -1 )
    palastfeinde += ({ spieler });
}
remove_palast()
{
  palast -= ({ PO });
}
int IsPalastfeind(object enemy)
{
  if ( member(palastfeinde,enemy) != -1 )
    return 1;
  else
    return 0;
}
void Sieg(object player)
{
  palastfeinde -= ({ player });
}
//ENDPALASTMASTER


void reset()
{
  palastfeinde = ({});
  
  return;
}
