//Master Stadttor

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>


object *wache;
object *wachefeinde;

void create()
{
  if (is_clone(TO))
  {
    destruct(TO);
    return;
  }

  wache = ({});
  wachefeinde = ({});
  
  seteuid(getuid(TO));
  return;
}

//WACHEMASTER
add_wache()
{
  wache += ({ PO });
}
ruf_um_hilfe(object spieler)
{
  if ( member(wachefeinde,spieler) == -1 )
    wachefeinde += ({ spieler });
}
remove_wache()
{
  wache -= ({ PO });
}
int IsWachefeind(object enemy)
{
  if ( member(wachefeinde,enemy) != -1 )
    return 1;
  else
    return 0;
}
void Sieg(object player)
{
  wachefeinde -= ({ player });
}
//ENDWACHEMASTER


void reset()
{
  wachefeinde = ({});
  
  return;
}
