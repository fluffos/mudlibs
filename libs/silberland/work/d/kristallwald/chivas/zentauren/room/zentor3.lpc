// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Am Osttor von Roch Adan");
  SetProp( P_INT_LONG,
	"Dies ist das Osttor von Roch Adan. Durch dieses Tor verlaesst Du "
        "die Stadt in den dahinter liegenden Wald. Ein Weg schlaengelt sich "
        "in Richtung Osten. Ausserdem kannst Du die Mauer erkennen, die "
        "die gesamte Stadt umgibt. Direkt neben dem Tor steht ein kleines "
        "Holzschild." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"osttor","tor"}), 
            "Das Tor ist geoeffnet und besteht aus Holz. Es ist nicht mit "
            "dem Haupttor im Sueden zu vergleichen. Es gibt nur wenige "
            "Verzierungen.");

  AddDetail( ({"roch adan","adan","roch","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren. Du bist momentan am Osttor "
            "der Stadt.");

  AddDetail( ({"wald"}),
	    "Der tiefe Wald faengt direkt hinter dem Tor an.");

  AddDetail( ({"weg","richtung","osten"}),
	    "Der Weg fuehrt in den tiefen Wald in Richtung Osten.");
  
  AddDetail( ({"schild","holzschild"}),
	    "Du kannst es lesen.");

  AddDetail( ({"boden"}), 
            "Am Boden siehst Du ein paar Steine und Gras. Auch ein paar "
            "Blaetter, die vom Wind aus dem Wald herein geweht wurden.");

  AddDetail( ({"mauer"}),
	    "Die Mauer besteht aus maechtigen Holzstaemmen.");

  AddDetail( ({"holzstaemmen","holzstaemme","staemme"}),
	    "Die Holzstaemme sind von Moos und Efeu fast zugewachsen.");

  AddDetail( ({"moos"}),
	    "Das Moos ist dunkelgruen.");
  
  AddDetail( ({"efeu","Jahre","jahren"}),
	    "Das Efeu ist in den letzten Jahren an der Mauer hoch gewachsen "
            "und verdeckt sie fast komplett.");

  AddDetail( ({"holz"}), 
            "Die Mauer und das Tor bestehen aus Holz.");

  AddDetail( ({"verzierungen"}),
	    "Die Verzierungen sind klein und stellen ein paar Zentauren dar. "
            "Sie sind nicht sehr interessant.");

  AddDetail( ({"haupttor","sueden"}),
	    "Das Haupttor im Sueden ist viel groesser und reicher verziert als "
            "das kleine Osttor vor dem Du stehst.");

  AddDetail( ({"zentauren"}),
	    "Die Zentauren leben in dieser Stadt.");
  
  AddDetail( ({"steine","kieselsteine"}),
	    "Es sind ganz gewoehnliche Kieselsteine.");

  AddDetail( ({"gras"}), 
            "Das Gras ist hellgruen und kaum niedergetrampelt. Anscheinend "
            "gehen nicht viele diesen Weg.");

  AddDetail( ({"blaetter","farbe"}),
	    "Die Blaetter haben eine braune Farbe. Sie sind sicher von den "
            "Baeumen im Wald abgefallen.");

  AddDetail( ({"baeumen","baeume"}),
	    "Es gibt die Baeume im Wald hinter dem Tor und die Baumriesen in "
            "Roch Adan.");

  AddDetail( ({"baumriesen","baumriese","riesen","riese"}),
	    "In den Baumriesen leben die Zentauren.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist tiefblau. Nur einige Wolken sind zu erkennen.");

  AddDetail( ({"wolken"}), 
            "Die Wolken verkuenden, dass es keinen Regen geben wird.");

  AddDetail( ({"regen","gefahr"}),
	    "Es besteht nicht die Gefahr, dass es regnet.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst den Wald hinter dem Tor.");  
 
  AddSmell( ({"wald"}),
	   "Es riecht nach Baeumen.");

  AddSmell( ({"baeume","holz"}),
	   "Die Baeume riechen nach Holz.");
  
  
  AddSound(DEFAULT_SOUND, "Du hoerst den Wind durch die Baeume wehen.");

  AddSound( ({"baeume","wind"}),
	   "Die Blaetter bewegen sich im Wind.");
  
  AddSound( ({"blaetter"}),
	   "*raschel*raschel*raschel*");

  AddReadDetail( ({"schild"}),
		"Hier geht es noch nicht weiter, weiche zurueck Sterblicher. \n"
                "                                                  Chivas\n");


//-----Details Ende-----
AddItem(NPC "torwache", REFRESH_DESTRUCT);
  
AddExit("westen", ROOM "zeng4");
AddExit( "osten", "/d/kristallwald/gwenshara/suedwald/room/a1_m" );

}
int go_osten(string dir)
{

  if(!(present("marlog", TO)))
  {
    write( BS( "Eine Torwache kommt an und hindert Dich momentan daran durch das "
	       "Tor zu gehen. Darauf hin verschwindet sie wieder.") );
    say("Eine Torwache haelt "+TP->Name(WEN)+" davon ab, "
      "nach Osten zu gehen.\n");
  return -1;
  }
}
