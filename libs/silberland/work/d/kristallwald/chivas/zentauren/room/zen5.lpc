// von Chivas 
// 09.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl;

void create()
	
{
  ::create();

  anzahl=1;

  SetProp( P_INT_SHORT, "Auf einem Waldweg");
  SetProp( P_INT_LONG,
	"Der Wald endet hier. Es stehen nur noch vereinzelt ein paar Eichen "
        "und Ulmen am Wegrand. Der Wald geht langsam in eine bluehende Wiese "
        "ueber, die sonnenueberflutet im Nordwesten liegt. \n"
	"Einzelne Buesche und Straeucher sind am Wegrand und grenzen den Weg ein. "
	"Ausserdem faellt Dir ein grosser Steinfindling auf, der auf der rechten "
        "Seite des Weges steht. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"boden", "weg", "waldweg"}), 
            "Der Boden ist mit Gras bedeckt, und der Weg geht in eine wunderschoene "
            "Blumenwiese ueber. Vereinzelt liegen noch Blaetter, Zweige und Nadeln "
            "am Boden.");

  AddDetail( ({"blaetter","paar"}), 
            "An den Aesten der Baeume, Straeucher und Buesche haengen Blaetter. Es "
            "sind auch ein paar auf den Boden gefallen. ");

 AddDetail( ({"nadeln","nadelbaeumen"}), 
            "An den Tannen haengen Nadeln, deswegen zaehlen Tannen auch zu den "
            "Nadelbaeumen. Auf dem Waldweg liegen auch einige, die von ein paar "
            "Ameisen zu ihrem Bau getragen werden. Sie scheinen recht praktisch "
            "zum Bauen zu sein. ");

 AddDetail( ({"ameisen"}), 
            "Ein paar Ameisen sammeln die Nadeln vom Boden und schleppen sie "
            "anscheinend in ihren Bau. ");

 AddDetail( ({"sonne"}), 
            "Die Sonne scheint. ");

 AddDetail( ({"himmel","probleme","wetter"}), 
            "Den Himmel kann man jetzt ohne Probleme sehen. Es ist ein herrliches "
            "Wetter.");

 AddDetail( ({"blaetterdach"}),
	    "Das Blaetterdach ist so licht, das man ohne Probleme den Himmel sehen "
            "kann. Endlich hoert der Wald auf und es wird heller.");

 AddDetail( ({"bau","sache"}), 
            "Der Bau der Ameisen scheint hinter den Bueschen am Wegrand zu sein. "
            "Du kannst ihn nicht sehen, findest es aber auch nicht so interessant, "
            "der Sache nachzugehen. ");

 AddDetail( ({"tannen"}), 
            "Alte Tannen sind hier am Wegrand zu sehen. Eine Tanne faellt Dir "
            "besonders auf. ");

 AddDetail( ({"hunger","kuh"}), 
            "Du untersuchst auch wirklich alles. Mach ruhig so weiter.");

 AddDetail( ({"kopfschmerzen"}), 
            "Kopfschmerzen sind nicht gut.");

 AddDetail( ({"wald","ansammlung"}), 
            "Ein Wald ist eine Ansammlung von Baeumen.");

 AddDetail( ({"rote blumen"}), 
            "Wenn Du auf die Wiese gehst, wirst Du genau erkennen, um was fuer "
            "Blumen es sich handelt.");

 AddDetail( ({"blaue blumen"}), 
            "Du bist noch zu weit weg, um zu sehen was fuer blaue Blumen es sind.");

 AddDetail( ({"gelbe blumen"}), 
            "Es scheinen Narzissen zu sein. Du bist aber noch zu weit entfernt, "
            "um sie genau zu bestimmen. ");

 AddDetail( ({"brombeerbuesche","brombeerbusch","tiere"}), 
            "Leider sind keine Brombeeren mehr an den Bueschen. Anscheinend haben "
            "die Tiere schon alle gefressen. ");

 AddDetail( ({"brombeere","brombeeren"}), 
            "Keine mehr da, wie enttaeuschend. ");

 AddDetail( ({"haselnussstraeucher","haselnussstrauch"}), 
            "An den Straeuchern sind keine Haselnuesse mehr. Wie schade. ");

 AddDetail( ({"haselnusss","haselnuesse"}), 
            "Du haettest gerne welche gepflueckt. Leider sind alle weg. ");

 AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand stehen noch vereinzelt Baeume, doch nehmen sie stark ab. "
            "Der Weg ist hier noch mit Bueschen und Straeuchern gesaeumt. Ein grosser "
            "Findling liegt am Rand.  ");

 AddDetail( ({"herz","anblick"}),
	    "Der Anblick der Blumenwiese laesst Dein Herz leichter werden und Du "
            "freust Dich schon auf die Wiese.");
  
  AddDetail( ({"blumenwiese","wiese","spass"}),
	    "Im Nordwesten liegt eine wunderschoene Blumenwiese. Dein Herz wird "
            "bei diesem Anblick leicht und es wird Spass machen, ueber die Wiese zu "
            "laufen. ");

  AddDetail( ({"blumen","blumenmeer","meer"}),
	    "Lauter Blumen sind auf der Wiese im Nordwesten zu sehen. Es ist geradezu ein "
            "Blumenmeer. Du erkennst rote, blaue und gelbe Blumen.");

  AddDetail( ({"nordwest","nordwesten"}),
	    "Nicht ganz Norden und nicht ganz Westen, halt nordwest. ");

  AddDetail( ({"land"}),
	    "Du stehst auf dem Land. ");

  AddDetail( ({"stein","steinfindling","findling","seite"}),
	    "Ein riesiger Steinfindling liegt auf der rechten Seite des Weges. Er "
            "ist fast komplett mit Efeu zugewachsen. ");

  AddDetail( ({"efeu"}),
	    "Das Efeu bedeckt fast komplett den Findling. Vielleicht kannst Du es "
            "entfernen. ");

  AddSpecialDetail( ({ "schriftzeichen","zeichen" }), "zeichen" );

  AddDetail( ({"baeume","baeumen", "baum"}),
	    "Am Wegrand befinden sich nur noch ein paar Eichen, Tannen und Ulmen. ");

  AddDetail( ({"ulme","ulmen"}),
	   "Richtige Ulmen, das ist ja kaum zu fassen.");

  AddDetail( ({"eiche","eichen"}),
	   "Grosse Eichen, schoene Baeume, aber uninteressant. ");

  AddDetail( ({"gras"}),
	    "Ganz normales Gras. ");

  AddDetail( ({"zweige","zweig"}),
	    "Sie liegen auf dem Waldweg und sind wohl von den Baeumen heruntergefallen. ");

  AddDetail( ({"aeste","ast","tanne"}),
	    "Die Aeste wiegen sich leicht im Wind. An einer Tanne haengen die Aeste "
            "sehr tief. Vielleicht kann man ja hochklettern.");

  AddDetail( ({"wind"}),
	    "Die Aeste wiegen sich leicht im Wind. ");

  AddDetail( ({"buesche","bueschen","busch"}),
	    "Ganz normale Buesche, wie sie es in jedem Wald gibt. Einige Brombeerbuesche "
            "siehst Du auch.");

  AddDetail( ({"straeucher","straeuchern","strauch"}),
	    "Ein paar uninteressante Straeucher. Haselnussstraeucher sind wohl auch dabei.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  
  
  AddSmell(DEFAULT_SMELL, "Du riechst die Baeume, das Gras am Boden und die Blumen der nahen "
                          "Wiese.");  
 
  AddSmell( ({"baeume","baum"}),
	   "Sie duften nach Harz.");

  AddSmell( ({"harz"}),
	   "Geh einfach mal in einen Wald und schnupper an einem Baum der harzt.");

  AddSmell( ({"blumen"}),
	   "Sie riechen irgendwie.....blumig.");
  
  AddSmell( ({"gras"}),
	   "Das Gras duftet sehr frisch. Waerst Du eine Kuh, wuerdest Du jetzt Hunger kriegen.");

  AddSound(DEFAULT_SOUND, "Der Wind weht nur ganz leicht durch "
	   "das Blaetterdach, ausserdem hoerst Du Vogelgezwitscher.");

  AddSound( ({"wind"}),
	   "Du kannst ihn kaum hoeren, er bringt nur die Blaetter leicht zum Rascheln");
  
  AddSound( ({"blaetter","rascheln"}),
	   "Die Blaetter bewegen sich leicht im Wind, so dass sie rascheln!");

  AddSound( ({"vogelgezwitscher","gezwitscher"}),
	   "Es wirkt sehr beruhigend. ");

//-----Details Ende-----
  
AddExit("suedwesten", ROOM "zen4");
AddExit("nordwesten", ROOM "zen6");

AddCmd( ({"entfern", "entferne" }), "entfernen" );
AddCmd( ({"kletter" }), "klettern" );

}
void reset()
	
{
  ::reset();
  anzahl=1; 
}
int entfernen(string str)
{
   notify_fail("Was willst Du entfernen ?\n");
   if ( member( ({ "efeu" }),str) != -1) 
   {    
   if ( anzahl )
    {
    write( "Du entfernst das Efeu und entdeckst merkwuerdige Schriftzeichen.\n");
    say( TPN+" entfernt Efeu von einem Findling und entdeckt etwas.\n");
    anzahl--;
    return 1;   
    }
    else
    {
    write( "Du entdeckst, dass das Efeu schon entfernt wurde und siehst ein "
           "paar Schriftzeichen.\n");
    say( TPN+" probiert etwas, dass gar nicht funktionieren kann.\n");
    return 1;   
    }
  }
}
int klettern(string str)
{
   notify_fail("Wo willst Du hin klettern ?\n");
   if ( member( ({ "baum","auf baum","tanne","auf tanne" }),str) != -1) 
  {
    write( "Du beginnst die Tanne hoch zu klettern und schaffst es tatsaechlich "
           "bis auf die Spitze. Der Ausblick ist einfach phantastisch. Als Du Dich "
           "satt gesehen hast, kletterst Du wieder runter.\n");
    say( TPN+" klettert geschickt eine Tanne rauf und erscheint nach einiger Zeit "
             "wieder auf dem Boden.\n");
    return 1;
  }
}
string zeichen(string key)
{
    if ( anzahl )
    {
    return(BS("Momentan siehst Du keine Schriftzeichen.\n"));
    }
    else
    {
    return(BS("Die Schriftzeichen uebersteigen Deinen Intellekt. Wenn Du "
              "weiter auf die Schriftzeichen starrst, kriegst Du "
              "Kopfschmerzen.\n"));
    }
}

