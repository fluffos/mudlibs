// von Chivas
// 09.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl;

void create()
	
{
  ::create();

  anzahl = 1;

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Ohne eine Lichtquelle, ausser Du bist ein Drow oder Nekromant, "
        "waerst Du jetzt aufgeschmissen, da es hier im "
        "Wald stockfinster ist. Kein einziger Lichtstrahl dringt durch das "
        "Geflecht aus Aesten, Zweigen und Blaettern. Am Wegrand siehst Du "
        "einige Buesche und Straeucher, die komischerweise in dieser "
        "Finsternis gut gedeihen. Es weht kein Lueftchen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 0 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden","erde","waldboden"}), 
            "Der Boden ist kahl. In dieser Finsternis kann ja auch kaum was "
            "wachsen. Es liegen vereinzelt Steine auf dem kahlen Waldboden.");

  AddDetail( ({"weg","waldweg"}),
	    "Der Waldweg ist von Baeumen gesaeumt und fuehrt Dich "
	    "weiter nach Norden.");

  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand stehen einige Buesche und Straeucher, die "
            "komischerweise hier wachsen koennen. ");

  AddDetail( ({"baeume","baeumen"}),
	    "Die Baeume an dieser Stelle verdunkeln den Wald so sehr, dass "
            "man ohne Lichtquelle nichts erkennen wuerde. An einer alten Ulme "
            "kommt Dir der Stamm komisch vor.");

  AddDetail( ({"baum"}),
	    "Irgendetwas an dem Stamm dieser alten Ulme sieht komisch aus. ");

  AddDetail( ({"stamm"}),
	    "Eine klebrige Fluessigkeit rinnt am Stamm herunter. Vielleicht " 
            "solltest Du sie mal kosten. ");

  AddDetail( ({"fluessigkeit"}),
	    "Was das wohl ist? Bist Du mutig genug es zu kosten?");

  AddDetail( ({"ulme","ulmen"}),
	   "Dies ist eine alte Ulme, an deren Stamm etwas zu sein scheint.");

  AddDetail( ({"blatt","blaetter","blaetterdach","dach","geflecht"}),
	    "Die Blaetter bilden ein dichtes Dach, so dass kein Lichtstrahl "
	    "den Boden trifft.");

  AddDetail( ({"unterholz","durchkommen"}),
	    "Das Unterholz ist sehr dicht, so dass ein Durchkommen unmoeglich "
            "ist.");

  AddDetail( ({"holz"}),
	    "Baeume bestehen aus Holz. Dumme Frage!");

  AddDetail( ({"licht","verhaeltnisse","lichtverhaeltnisse"}),
	    "Es ist absolut finster. Kein Licht dringt durch das dichte "
	    "Blaetterdach.");

  AddDetail( ({"steine","steinen","stein","paar"}),
	    "Es sind ganz normale Kieselsteine, wie man sie auf jedem "
            "anstaendigen Waldweg findet. Jedoch sieht der Waldboden zwischen "
            "den Steinen an ein Paar Stellen komisch aus.");

  AddDetail( ({"wald","waldes","ansammlung"}),
	    "Ein Wald ist eine Ansammlung von Baeumen.");

  AddDetail( ({"zweige","zweig"}),
	    "Sie liegen auf dem Waldweg und sind wohl von den Baeumen "
            "heruntergefallen. ");

  AddDetail( ({"aeste","ast"}),
	    "Die Aeste bewegen sich ueberhaupt nicht. ");

  AddDetail( ({"drow","nekromant"}),
	    "Als Drow oder Nekromant brauchst Du keine laestigen "
            "Lichtquellen.");

  AddDetail( ({"lueftchen"}),
	    "Hier ist es absolut windstill. ");

  AddDetail( ({"buesche","bueschen"}),
	    "Es sind ganz normale Buesche. Nur komisch ist, dass sie in "
	    "dieser Dunkelheit ueberleben koennen. Du entdeckst noch, dass "
	    "sie riesige Dornen haben. Die Buesche bilden mit den Straeuchern "
            "undurchdringliches Unterholz. ");

  AddDetail( ({"straeucher","straeuchern"}),
	    "Straeucher in dieser Finsternis? Was es nicht alles gibt. "
            "Zwischen den Straeuchern erkennst Du noch eine weitere Pflanze.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddDetail( ({"stellen","stelle"}),
	    "An einigen Stellen ist der Boden mit Schleim bedeckt und ein "
            "Haufen Wuermer kriecht am Boden rum. Echt ekelig.");  

  AddDetail( ({"schleim"}),
	    "Der Schleim ist zaehfluessig. Du willst gar nicht wissen, wo der "
            "Schleim herkommt.");  

  AddDetail( ({"wurm","wuermer","haufen"}),
	    "Die Wuermer wuseln am Boden rum. Sie scheinen an Etwas zu "
            "nagen.");    

  AddDetail( ({"knochen","anblick"}),
	    "Der Knochen ist von den Wuermer schon fast abgenagt. Dir wird "
            "uebel bei dem Anblick.");    

  AddDetail( ({"etwas"}),
	    "Du entfernst einen Haufen Wuermer an einer Stelle und findest "
            "einen alten Knochen.");    

  AddDetail( ({"finsternis","dunkelelf","lichtquelle","dunkelheit"}),
	    "Mit einer Lichtquelle oder nur als Dunkelelf koenntest Du hier "
            "etwas erkennen. Es herrscht ansonsten absolute Dunkelheit.");    

  AddDetail( ({"himmel"}),
	    "Den kannst Du hier nicht sehen.");

  AddDetail( ({"dornen"}),
	    "Die Dornen an den Bueschen sind riesig. Man kann sich sicher sehr "
            "an ihnen verletzten.");

  AddDetail( ({"pflanze","foto","zeitung"}),
	    "Die Pflanze sieht wie eine fleischfressende Pflanze aus. Du "
            "erinnerst Dich an ein Foto in der Silberland-Zeitung, da sah eine "
            "Pflanze aehnlich aus. Du solltest Dich ihr besser nicht naehern.");    
  AddDetail( ({"silberland"}),
	    "Du bist im Silberland und findest es super hier.");

  AddDetail( ({"kieselsteine"}),
	    "An den Kieselsteinen kannst Du nicht viel erkennen.");    

  AddDetail( ({"lichtstrahl","probleme"}),
	    "Wenn es so etwas hier geben wuerde, koenntest Du ohne Probleme "
            "was sehen.");    

  AddDetail( ({"luecken","luecke"}),
	    "Keine Luecken heisst, dass keine Luecken vorhanden sind. Aber "
            "schoen, dass Du forschst.");    

  AddSmell(DEFAULT_SMELL, "Du riechst die Baeume und auch etwas Suessliches.");  
 
  AddSmell( ({"baeume","baum"}),
	   "Sie riechen halt nach Baum.");

  AddSmell( ({"suessliches"}),
	   "Es riecht nach Honig.");

  AddSmell( ({"honig"}),
	   "Schau Dich um, vielleicht findest Du ihn.");
  
  AddSound(DEFAULT_SOUND, "Hier ist es totenstill.");

  AddSound( ({"totenstill"}),
	   "Du moechtest das nicht wirklich mal hoeren.");
  
//-----Details Ende-----

AddExit("sueden", ROOM "zen10");  
AddExit("norden", ROOM "zen12");

AddCmd( ({"koste", "kosten" }), "kosten" );
}
void reset()
{
  ::reset();
  anzahl=1;
  
}
int kosten(string str)
{
   notify_fail("Was moechtest Du kosten?\n");
   if ( member( ({ "fluessigkeit", "honig" }),str) != -1) 
  {
    write(BS( "Du kostest die Fluessigkeit und es ist Honig. Du leckst den ganzen "
           "Stamm ab und Dir kommt der Gedanke, dass es ziemlich daemlich "
           "aussehen muss. Woody sei Dank ist es hier so dunkel.\n"));
    say( TPN+" verzieht entzueckt das Gesicht.\n");
    if ( anzahl )
    {
      TP -> heal_self(5+random(2));
      anzahl--;
    }
    return 1;
  }
    return 1;
  }

