// von Chivas 
// 09.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl;

void create()
	
{
  ::create();

  anzahl = 3;

  SetProp( P_INT_SHORT, "Auf einem Waldweg");
  SetProp( P_INT_LONG,
	"Der Wald wirkt sehr friedlich und idyllisch, die Baeume bewegen sich leicht im "
	"Wind, und es wirkt sehr beruhigend, hier spazieren zu gehen. In der Naehe hoerst "
	"Du einen Bach plaetschern, der sich hinter den Straeuchern zu verbergen scheint. "
	"Ansonsten siehst Du vereinzelte Buesche am Wegrand. Im Nordosten stehen nur noch "
        "vereinzelt Baeume. Der Wald scheint dort zu enden." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden","erde"}), 
            "Der Boden ist mit Gras bedeckt, ab und zu  "
	    "kann man auch ein paar Steine im Gras und Zweige am Boden liegen sehen. "
            "Auch ein paar Pilze wachsen im Gras. Das Blaetterdach wird ein wenig "
            "lichter und mehr Licht erreicht den Waldweg. ");

  AddDetail( ({"pilze","pilz"}),
	    "Im Gras wachsen verschiedene Sorten von Pilzen. ");

  AddDetail( ({"sorten"}),
	    "Du erkennst Fliegenpilze, Satanspilze und Knollenblaetterpilze. ");

  AddDetail( ({"fliegenpilze","fliegenpilz"}),
	    "Fliegenpilze sind giftig, da laesst Du lieber die Finger von. ");

  AddDetail( ({"satanspilze","satanspilz"}),
	    "Einen Pilz mit einem solchen Namen sollte man besser in Ruhe lassen. ");

  AddDetail( ({"knollenblaetterpilze","knollenblaetterpilz"}),
	    "Du betrachtest den Pilz und beschliesst, daran zu schnuppern. Da er sogar schlecht "
            "riecht, laesst Du ihn einfach stehen. ");

  AddDetail( ({"weg","waldweg"}),
	    "Der Waldweg ist von Baeumen gesaeumt und Du fuehlst Dich leicht und entspannt. "
	    "Am Wegrand stehen Straeucher. Hinter den Straeuchern scheint ein Bach zu sein. ");

  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand stehen kleinere Baeume und Straeucher. ");
  
  AddDetail( ({"baeume","baeumen"}),
	    "Am Wegrand befinden sich Baeume verschiedenster Art. ");

  AddDetail( ({"art"}),
	    "Halt Tannen, Kiefern, Eichen, Ulmen und viele mehr. ");

  AddDetail( ({"kiefer","kiefern"}),
	   "Halt wie Kiefern in einem Wald aussehen, Nadeln, Stamm und Aeste.");

  AddDetail( ({"tanne","tannen"}),
	   "Halt wie Tannen aussehen, schau Dir "  
           "mal in der Adventszeit Deinen Weihnachtsbaum an. ");

  AddDetail( ({"ulme","ulmen"}),
	   "Halt ganz normale Ulmen mit Blaettern, Stamm und Aesten.");

  AddDetail( ({"eiche","eichen"}),
	   "Halt wie Eichen aussehen, uninteressant.");

  AddDetail( ({"bach","naehe"}),
	    "Du kannst ihn nicht sehen, er scheint sich hinter den Straeuchern zu "
            "verbergen. Du kannst ihn nur hoeren. ");

  AddDetail( ({"blatt","blaetter","blaetterdach","dach"}),
	    "Das Blaetterdach ist schon lichter als weiter im Sueden. Richtung "
            "Norden scheint der Wald noch lichter zu werden.");

  AddDetail( ({"holz","frage"}),
	    "Baeume bestehen aus Holz, dumme Frage. ");

  AddDetail( ({"nadeln"}),
	    "Manche der Baeume hier im Wald habe Nadeln.");

  AddDetail( ({"stamm","regel"}),
	    "Baeume haben in der Regel einen Stamm.");

  AddDetail( ({"licht","verhaeltnisse","lichtverhaeltnisse"}),
	    "Es ist schon heller, das Blaetterdach ist schon lichter und man kann "
            "den Himmel sehen. ");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist strahlend blau zwischen den Blaettern an den Baeumen zu "
            "erkennen. Die Sonne scheint.");

  AddDetail( ({"weihnachtsbaum","weihnachten"}),
	    "Vielleicht solltest Du zu Weihnachten wieder kommen und Dir einen "
            "Weihnachtsbaum faellen.");

  AddDetail( ({"sonne"}),
	    "Die Sonne scheint am Himmel und wird nicht von Wolken verdeckt.");

  AddDetail( ({"wolken","wolke","regen"}),
	    "Ein paar Wolken kannst Du durch das Blaetterdach auch erkennen. Sie "
            "sind weiss und es sieht nicht nach Regen aus. ");

  AddDetail( ({"lichtstrahl","strahl"}),
	    "Immer mehr Licht trifft den Waldboden. ");
  
  AddDetail( ({"steine","steinen","stein"}),
	    "Ganz normale Steine, wie man sie auf jedem anstaendigen Waldweg "
	    "findet.");

  AddDetail( ({"wald","waldes","ansammlung"}),
	    "Ein Wald ist eine Ansammlung von Baeumen.");

  AddDetail( ({"gras"}),
	    "Ganz normales Gras, mit ein paar Steinen. ");

  AddDetail( ({"zweige","zweig"}),
	    "Sie liegen auf dem Waldweg und sind wohl von den Baeumen heruntergefallen. ");

  AddDetail( ({"aeste","ast"}),
	    "Die Aeste wiegen sich leicht im Wind. ");

  AddDetail( ({"wind"}),
	    "Der Wind laesst sich schlecht untersuchen, lauschen waere besser. ");

  AddDetail( ({"buesche","bueschen"}),
	    "Ganz normale Buesche, wie sieh es in jedem Wald gibt. ");

  AddDetail( ({"fische"}),
	    "Kleine Fische schwimmen im Bach. Es scheinen Forellen zu sein. ");

  AddDetail( ({"forelle","forellen"}),
	    "Die Forellen sehen wirklich appetitlich aus. Vielleicht kann man eine fangen. ");

  AddDetail( ({"adventszeit","finger","ruhe","namen"}),
	    "Du untersuchst wirklich alles, oder?");

  AddDetail( ({"straeucher","straeuchern","seite","strauch"}),
	    "Hinter den Straeuchern scheint ein Bach zu sein, vielleicht kannst "
            "Du einen Strauch zu Seite biegen, um den Bach zu finden.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst die Baeume, das Gras am Boden und auch klare Luft.");  
 
  AddSmell( ({"baeume","baum"}),
	   "Sie duften nach Kiefern und Tannen.");

  AddSmell( ({"luft"}),
	   "Du schnupperst an der klaren Luft und fuehlst Dich frei.");
  
  AddSmell( ({"kiefer","kiefern"}),
	   "Halt wie Kiefern riechen in einem Wald riechen.");

  AddSmell( ({"tanne","tannen"}),
	   "Halt wie Tannen riechen, falls Du es nicht weisst, schnupper "  
           "mal in der Adventszeit an Deinem Weihnachtsbaum. ");
  
  AddSmell( ({"weihnachtsbaum"}),
	   "Sei realistisch, warum sollte jetzt hier im Wald ein Weihnachtsbaum stehn.");

 
  AddSmell( ({"ulme","ulmen"}),
	   "Die Ulmen riechen wie ganz normale Ulmen.");

  AddSmell( ({"eiche","eichen","holz"}),
	   "Die Eichen riechen nach frischem Holz.");

  
  AddSound(DEFAULT_SOUND, "Der Wind weht nur ganz leicht durch "
	   "das Blaetterdach, trotzdem hoerst Du ein leichtes Rascheln. "
           "Ausserdem hoerst Du das Plaetschern eines kleinen Baches.");

  AddSound( ({"wind"}),
	   "Du kannst ihn kaum hoeren, er bringt nur die Blaetter leicht "
           "zum Rascheln");
  
  AddSound( ({"blaetter","rascheln"}),
	   "Die Blaetter bewegen sich leicht im Wind, so dass sie rascheln!");

  AddSound( ({"plaetschern","bach"}),
	      "Das Plaetschern wirkt beruhigend auf Dich, vielleicht kannst Du "
              "den Bach finden.");

//-----Details Ende-----
AddItem(NPC "zentaurk1", REFRESH_DESTRUCT);  

AddExit("sueden", ROOM "zen3");
AddExit("nordosten", ROOM "zen5");

AddCmd( ({"biege", "bieg" }), "biegen" );
AddCmd( ({"trink", "trinke" }), "trinken" );
AddCmd( ({"fang", "fange" }), "fangen" );
AddCmd( ({"faell", "faelle" }), "faellen" );


}
int biegen(string str)
{
   notify_fail("Was willst Du zu Seite biegen ?\n");
   if ( member( ({ "straeucher zu seite", "straeucher","strauch zur seite","straeucher zur seite","straeucher beiseite","strauch beiseite" }),str) != -1) 
  {
    write(BS( "Du biegst die Straeucher zu Seite und siehst einen kleinen Bach in dem kleine "
           "Fische schwimmen.\n"
           "Vielleicht kannst du einen Schluck Wasser trinken um Dich aufzufrischen.\n"));
    say( TPN+" biegt ein paar Straeucher zur Seite und schaut was sich dahinter versteckt.\n");
    return 1;
  }
}
int trinken(string str)
{
   notify_fail("Was moechtest Du trinken ?\n");
   if ( member( ({ "schluck", "wasser", "schluck wasser" }),str) != -1) 
  {
    write(BS ( "Du beugst Dich vor und trinkst einen Schluck Wasser. Wie erfrischend."));
    say( TPN+" beugt sich tiefer in die Straeucher und Du hoerst ein Schluerfen.\n");
    if ( anzahl )
    {
      TP -> heal_self(5+random(2));
      anzahl--;
    }
    return 1;
  }
}  
int fangen(string str)
{
   notify_fail("Was moechtest Du fangen ?\n");
   if ( member( ({ "forelle", "forellen" }),str) != -1) 
  {
    write(BS ( "Du beugst Dich vor und greifst blitzschnell ins Wasser um eine schoene "
               "Forelle zu fangen. Leider ist sie zu glitschig und sie entkommt."));
    say( TPN+" macht irgendetwas im Gebuesch. Du kannst aber nicht sehen was und hoerst "
             "nur ein leises Fluchen.\n");
    return 1;
  }

}  
int faellen(string str)
{
   notify_fail("Was moechtest Du faellen?\n");
   if ( member( ({ "baum", "weihnachtsbaum" }),str) != -1) 
  {
    write(BS ( "Vergiss es, bis Weihnachten ist er doch laengst vertrocknet. "
               "Komm in der Weihnachtszeit wieder, dann klappt es sicher."));
    say( TPN+" probiert etwas, dass aber momentan nicht klappen kann.\n");
    return 1;
  }

}  
   
