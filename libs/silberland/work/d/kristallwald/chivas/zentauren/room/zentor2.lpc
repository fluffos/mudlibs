inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>


void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Das Nordtor von Roch Adan");
  SetProp( P_INT_LONG,
	"Vor Dir befindet sich ein kleineres Tor im Vergleich zum Haupttor von Roch "
	"Adan im Sueden der Stadt. Hier siehst Du auch wieder die Mauer, die aus "
	"grossen Baumstaemmen gebaut um die ganze Stadt fuehrt. ");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----
  AddDetail( ({"tor"}), 
            "Das Tor fuehrt nach Norden in fuer Dich unbekanntes Gebiet. Das Tor ist klein "
            "und hat keinerlei Verzierungen wie das Haupttor im Sueden. ");

  AddDetail( ({"gebiet"}),
	    "Das Gebiet wird wohl erst spaeter etwas fuer Dich sein.");

  AddDetail( ({"verzierungen"}),
	    "Es sind keine vorhanden.");

  AddDetail( ({"vergleich"}),
	    "Im Vergleich mit dem Haupttor von Roch Adan wirkt dieses Tor klein und einfach.");

  AddDetail( ({"haupttor","sueden"}),
	    "Durch das Haupttor im Sueden hast Du die Stadt betreten.");

  AddDetail( ({"mauer"}), 
            "Die Mauer besteht aus Baumstaemmen. Sie sehen recht stabil aus und sind sicher "
            "auch unueberwindbar. ");

  AddDetail( ({"baumstaemmen","baumstaemme","staemme"}),
	    "Die grossen Baumstaemme bilden eine unueberwindliche Mauer, die um die ganze "
            "Stadt fuehrt.");

  AddDetail( ({"boden"}), 
            "Der Boden besteht aus Pflastersteinen, der nach dem Tor in einen erdigen Weg "
            "ueberzugehen scheint.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ueber Dir ist klar und die Sonne scheint. Aus dem Norden scheinen "
            "jedoch ein paar dunkle Wolken aufzuziehen.");

  AddDetail( ({"sonne"}),
	    "Die Sonne waermt Dich angenehm.");

  AddDetail( ({"wolken"}), 
            "Ein paar dunkle Wolken ziehen aus dem Norden Richtung Stadt. Es sieht nach "
            "Regen aus.");

  AddDetail( ({"regen","regenwetter","wetter"}),
	    "Du hasst Regenwetter.");

  AddDetail( ({"gasse"}),
	    "Die Gasse scheint am Tor zu enden.");

  AddDetail( ({"pflaster","steine","pflastersteine"}),
	    "Grosse Pflastersteine bedecken den Boden in der Gasse, die am Tor in einen "
            "erdigen Weg uebergeht. Einige Fugen erkennt man zwischen den Steinen."); 
  
  AddDetail( ({"fugen"}), 
            "Die Fugen zwischen den Pflastersteinen sind mit Unkraut bewachsen und mit Dreck "
            "gefuellt.");

  AddDetail( ({"dreck"}),
	    "Ganz normaler Dreck.");

  AddDetail( ({"unkraut","garten"}),
	    "Ekeliges Unkraut, welches Du nicht in Deinem Garten haben moechtest.");

  AddDetail( ({"weg"}), 
            "Hinter dem Tor beginnt ein erdiger Weg, der in einen Wald fuehrt. Der Weg ist mit "
            "Nadeln und Blaettern bedeckt.");

  AddDetail( ({"erde"}),
	    "Ganz normale Erde.");

  AddDetail( ({"nadeln"}),
	    "Die Nadeln scheinen von den Baeumen im Wald gefallen zu sein."); 
  
  AddDetail( ({"blaetter","blaettern"}), 
            "Die Blaetter scheinen von den Baeumen im Wald gefallen zu sein");

  AddDetail( ({"wald"}),
	    "Der Weg fuehrt in einen Wald, mehr kannst Du nicht erkennen.");

  AddDetail( ({"norden"}),
	    "Im Norden beginnt ein Wald.");

  AddDetail( ({"baeume","baeumen"}), 
            "Es scheinen ganz normale Baeume zu sein, nicht solche Baumriesen wie "
            "in der Stadt.");

  AddDetail( ({"baumriesen","riesen"}),
	    "Davon gibt es sehr viele in Roch Adan.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Dies ist die Stadt der Zentauren. Dir gefaellt es hier sehr gut.");
  
  AddDetail( ({"zentauren","wesen","oberkoerper","rest","pferdes"}), 
            "Die Zentauren sind stolze Wesen. Ihr Oberkoerper ist menschlich und der Rest eines Pferdes.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddSmell(DEFAULT_SMELL, "Du riechst den nahen Wald.");  
 
  AddSmell( ({"wald"}),
	   "Der Wald riecht nach Baeumen.");

  AddSmell( ({"baeume"}),
	   "Wie Baeume in einem Wald halt riechen.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind durch die Wipfel der Baeume rauschen.");

  AddSound( ({"wind","wipfel","rauschen"}),
	   "wuuuuuuuuusssssssccccccchhhhhhh");
  
//-----Details Ende-----

AddExit("sueden", ROOM "zeng3");  
AddExit( "norden", "/d/kristallwald/chivas/weg/room/zenw1" );

}

