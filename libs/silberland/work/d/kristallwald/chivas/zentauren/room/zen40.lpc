// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Palast der Zentauren");
  SetProp( P_INT_LONG,
	"Dies ist der oestliche Teil des Palastes und keine Fackeln erhellen "
        "diesen Raum. Trotzdem kannst Du sehr gut sehen, da der Raum durch "
        "tausende von Sternen an der Decke erhellt wird. Es sieht so aus, als "
        "ob der Sternenhimmel ueber dem Silberland hier magisch abgebildet "
        "wird. Du erkennst sogar Kometen, die sich langsam aber stetig "
        "bewegen. Ein wirklich faszinierender Raum, in dem die Zentauren die "
        "Zukunft in den Sternen lesen. \n" );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden","fugen"}), 
            "Der Boden besteht aus einem schwarzen Gestein. Es sind keinerlei "
            "Fugen oder aehnliches zu erkennen. Du wunderst Dich ausserdem "
            "darueber, dass kein bisschen Staub oder Dreck auf dem Boden ist. "
            "Es wirkt geradezu steril.\n"
            "Man erkennt jedoch vier Loecher in der Mitte des Raumes.");

  AddDetail( ({"oestliche teil","teil","palastes","palast","raum","raumes","teilen"}),
	"Dies ist der oestliche Teil des Palastes und keine Fackeln erhellen "
        "diesen Raum. Trotzdem kannst Du sehr gut sehen, da der Raum durch "
        "tausende von Sternen an der Decke erhellt wird. Es sieht so aus, als "
        "ob der Sternenhimmel ueber dem Silberland hier magisch abgebildet "
        "wird. Du erkennst sogar Kometen, die sich langsam aber stetig "
        "bewegen. Ein wirklich faszinierender Raum, in dem die Zentauren die "
        "Zukunft in den Sternen lesen. \n" );

  AddDetail( ({"fackeln","fackel"}),
	    "Es sind keine Fackeln vorhanden. Nur die Sterne an der Decke "
            "erhellen den Raum.");

  AddDetail( ({"schild"}),
	    "Du kannst es lesen.");
  
  AddDetail( ({"granit","gestein","granitplatte","platte","luecken"}),
	    "Das Gestein scheint Granit zu sein. Er ist makellos und man sieht "
            "nicht die geringsten Luecken. Es sieht fast so aus, als ob der "
            "ganze Boden aus einer einzigen Granitplatte besteht. Nur in der "
            "Mitte des Raumes sind vier Loecher im Boden.");

  AddDetail( ({"staub","dreck"}),
	    "Der Boden ist geradezu steril, keinerlei Dreck oder Staub zu "
            "sehen, was unmoeglich erscheint, da in den anderen Teilen des "
            "Palastes ueberall Reisig am Boden liegt.");

  AddDetail( ({"reisig"}),
	    "Reisig siehst Du hier nicht am Boden, er ist schwarz und "
            "unglaublich sauber.");

  AddDetail( ({"sternen","sterne"}),
	    "An der magischen Decke befinden sich tausende von Sternen. Manche "
            "leuchten heller und manche nicht so hell. Es reicht auf jedenfall "
            "aus den Raum komplett zu erhellen. Ein Stern faellt Dir besonders "
            "auf.");

  AddDetail( ({"stern","sonne"}),
	    "Der Stern ist so nah, dass man ihn schon als Sonne bezeichnen "
            "kann. Um ihn herum bewegen sich neun kleine Planeten.");

  AddDetail( ({"zentaur","zentauren","geschoepfe","huefte","menschen","pferdekoerper","bewegungen","kopf"}),
	    "Zentauren sind magische Geschoepfe, vom Kopf bis zur Huefte "
            "Menschen, darunter jedoch mit Pferdekoerper und -beinen versehen. "
            "Man erzaehlt sich ueber sie, dass sie die Zukunft in den "
            "Bewegungen der Planeten am Himmel lesen koennen. ");

  AddDetail( ({"himmel","sternenhimmel"}),
	    "Der abgebildete Himmel ist voll von Sternen, Planeten und Kometen.");

  AddDetail( ({"planeten","sonnensystem","system"}),
	    "Du siehst verschiedene Planeten, einige scheinen in dem "
            "Sonnensystem vom Silberland zu sein und da sind noch neun "
            "weitere, die um eine kleine Sonne kreisen.");

  AddDetail( ({"zukunft","raetsel","erleuchtung"}),
	    "Dir ist es ein Raetsel, wie die Zentauren mit den Planeten die "
            "Zukunft bestimmen koennen. So sehr Du Dich auch anstrengst, keine "
            "Erleuchtung kommt ueber Dich.");

  AddDetail( ({"decke","eindruck"}),
	    "An der Decke ist ein riesiger Sternenhimmel abgebildet. Die Decke "
            "macht einen gewoelbten Eindruck.");

  AddDetail( ({"silberland"}),
	    "Das Silberland ist einfach super.");

  AddDetail( ({"kometen","komet"}),
	    "Die Kometen ziehen am Himmel ihre Bahnen und ziehen einen langen "
            "Schweif hinter sich her.");

  AddDetail( ({"schweif","gefuehl","spieler","nachts"}),
	   "Der Schweif eines Kometen faellt Dir besonders auf. Du hast das "
           "Gefuehl, wenn Du diesen Kometen mit seinem Schweif irgendwann "
           "Nachts ueber dem Silberland siehst, wird ein besonderer Spieler "
           "geboren.");

  AddDetail( ({"loecher","loch","mitte","frage"}),
	   "In der Mitte des Raumes sind vier tiefe Loecher, es sieht so aus, "
           "als ob hier einmal etwas gestanden hat, was jedoch momentan "
           "entfernt wurde. Ob dies absichtlich geschehen ist, ist hier die "
           "Frage.");

  AddDetail( ({"waende","wand"}),
	   "Es gibt vier Waende. Welche Wand meinst Du? Ostwand, Westwand, "
           "Suedwand oder Nordwand?");

  AddDetail( ({"westwand","ausgang"}),
	   "An der Westwand ist der Ausgang in die Eingangshalle.");

  AddDetail( ({"nordwand"}),
	    "Es gibt ein Paar Regale an der Nordwand auf dem verschiedene "
            "Sachen liegen.");

  AddDetail( ({"ostwand"}),
	    "An der Ostwand haengen verschiedene Sternenkarten.");

  AddDetail( ({"suedwand"}),
	    "An der Suedwand steht ein grosser Schrank.");

  AddDetail( ({"karten","karte","bahnen","sternenkarten"}),
	    "Auf den Karten sind lauter Linien, Ziffern und Symbole "
            "abgebildet. Sie scheinen die Bahnen der Kometen abzubilden.");

  AddDetail( ({"regale","regal","paar","sachen"}),
	    "Die Sachen auf den Regalen sind merkwuerdige Geraete.");

  AddDetail( ({"schrank","holz","schrankes"}),
	    "Der grosse Schrank an der Suedwand hat 2 Tueren und besteht aus "
            "Holz.");

  AddDetail( ({"schranktuer","tuer","tueren"}),
	    "Die Tueren sehen recht massiv aus. Sie haengen in Scharnieren und "
            "an einer Schranktuer haengt ein Schild. Vielleicht solltest Du es "
            "lesen, bevor Du versuchst die Tueren des Schrankes zu oeffnen.");

  AddDetail( ({"scharniere","scharnier","schrauben"}),
	    "Die Scharniere sind recht alt. Vielleicht kann man die Schrauben "
            "der Scharniere irgendwie loesen.");
  
  AddDetail( ({"halle","eingang","eingangshalle"}),
	    "Die Eingangshalle befindet sich westlich von hier. Durch die "
            "Eingangshalle kommt man in die anderen Teile des Palastes oder "
            "auch wieder nach draussen.");

  AddDetail( ({"ziffern","linien","symbole","astrologe"}),
	    "Da Du kein Astrologe bist, verstehst Du nicht eine der Karten.");

  AddDetail( ({"geraet","geraete","winkel","spiegel","ruhe","angst"}),
	    "Die Geraete sehen komisch aus. Sie haben lauter Winkel, Spiegel "
            "usw.. Du laesst die Geraete in Ruhe, da Du Angst hast sie kaputt "
            "zu machen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  
  
  AddSmell(DEFAULT_SMELL, "Hier riecht es absolut nach gar nichts. Die Luft "
                          "wirkt fast steril.");  
 
  AddSmell( ({"luft"}),
	   "Die Luft riecht steril.");
  
  AddSound(DEFAULT_SOUND, "Es ist beinahe totenstill hier. Das Einzige was du "
                          "hoeren kannst, sind Deine eigenen Schritte und die "
                          "Kometen wie sie an der Decke entlang ziehen.");

  AddSound( ({"einzige","schritte"}),
	   "Das zu hoeren ist wirklich nicht sehr interessant.");
  
  AddSound( ({"kometen","komet"}),
	   "Es hoert sich an wie: wuuuuuuusssssssccccchhhhh");

  AddReadDetail( ({"schild"}),
		"                   _______________________________________\n"
                "                   |Oeffnen verboten, magisch gesichert. |\n"
                "                   |                                     |\n" 
                "                   |          Lebensgefahr!!!!!          |\n"
                "                   |                                     |\n"
                "                   |_____________________________________|\n");

//-----Details Ende-----
AddItem(NPC "elen", REFRESH_DESTRUCT);

AddExit("westen", ROOM "zen39");  
AddExit("nordwesten", ROOM "zen41");  

AddCmd( ({"oeffne" }), "oeffnen" );
AddCmd( ({"loese" }), "loesen" );
AddCmd( ({"biete" }), "bieten" );
AddCmd( ({"antworte" }), "antworten" );
AddCmd( ({"bitte" }), "bitten" );

}
int oeffnen(string str)
{
   notify_fail("Was moechtest Du oeffnen?\n");
   if ( member( ({ "schrank", "schranktuer","tuer" }),str) != -1) 
  {
    TP->AddHp(-50);
    write( "Du probierst die Schranktuer zu oeffnen und ploetzlich durchfaehrt Dich "
           "ein starker Schmerz. Vielleicht haettest Du auf die Warnung hoeren sollen. "
           "Vielleicht gibt es spaeter einen Trick den Schrank zu oeffnen.\n");
    say( TPN+" verzieht das Gesicht vor Schmerz.\n");
    return 1;
  }
}
int loesen(string str)
{
 object teleskop;
 notify_fail("Was willst Du womit loesen?\n");

 if(!str || str == "") return 0;
 if(!(str == "schrauben" ||
      str == "scharniere" ||
      str == "schrauben mit schraubenzieher"||
      str == "scharniere mit schraubenzieher" )) return 0;
 

 if( str == "schrauben mit schraubenzieher" ||
     str == "scharniere mit schraubenziehe"){
    
  if(!present("schraubenzieher", TP)){
	  
  write(BS("Du hast ja gar keinen. Wie willst Du dann die Schrauben loesen?\n"));
 
  say(TPN+" denkt nach.\n");
  return -1;
  }
  if(present("teleskop", TP)){
	  
  write(BS("Du findest nichts mehr im Schrank. Du hast alles was Du brauchst.\n"));
 
 say(TPN+" findet im Schrank nichts mehr.\n");
 return -1;
 }
 write(BS("Du nimmst den Schraubenzieher und loest die Schrauben an den Scharnieren. "
  "Die Tuer lockert sich ein wenig und Du greifst mit der Hand durch einen kleinen "
  "entstandenen Spalt."));
 
 teleskop=clone_object(OBJ "teleskop");

 if(teleskop->move(TP, M_GET)==ME_TOO_HEAVY)
  {
    write(BS("Du ertastest etwas, doch es ist Dir zu schwer, daher schraubst "
    "Du die Scharniere wieder fest."));
    teleskop->remove(1);
  }
 else
  write(BS("Du ertastest etwas und nimmst es an Dich. "
  "Anschliessend schraubst Du die Scharniere wieder fest.\n"));

  say(TPN+" werkelt am Schrank herum.\n");
 return 1;
}
 if( str == "schrauben" ||
     str == "scharniere"){
 
 write(BS("Womit willst Du denn die Schrauben loesen ? "
	  "Ein Schraubenzieher waere genau das richtige, jedoch geht dies "
          "erst ein wenig spaeter.\n"));

 say(TPN+" stellt sich dumm an.\n");
 return 1;
 }
}
int bieten(string str)
{
object astroinvis;
notify_fail("Wem moechtest Du was anbieten?\n");

if(!str || str == "") return 0;
 if(!(str == "hilfe an" ||
     str == "elen hilfe an" )) return 0;

 if(!present("elen"))
 {
  write(BS("Aber Elen ist doch garnicht da!"));
 return -1;
 }

  if(present("astroinvis", TP)){
	  
  write(BS("Elen sagt: Aber Du hilfst mir doch schon. Nun beeile Dich.\n"));
 
  say(TPN+" stellt sich dumm an.\n");
  return -1;
  }

  write(BS("Elen sagt: Danke Dir, ich kann naemlich hier nicht weg. Wenn Du alle Teile hast, "
           "komm zurueck und antworte mir 'Fertig'. Ich hab dann sicher auch eine kleine Belohnung fuer Dich.\n"));
 
  say(TPN+" bietet Elen seine Hilfe an.\n");
  astroinvis=clone_object(OBJ "astroinvis")->move(TP, M_NOCHECK);
  return 1;
 }


int antworten(string str)
{
 object horoskop;
 notify_fail("Was willst Du wem antworten?\n");

 if(!str || str == "") return 0;
 if(!(str == "elen fertig")) return 0;

 if( str == "elen fertig"){

 if(!present("elen"))
 {
  write(BS("Aber Elen ist doch gar nicht da!"));
  return -1;
 }
    
  if(!present("astroinvis", TP) && !present("dragoninvis2", TP))
  {
  write(BS("Du kannst doch gar nicht fertig sein, Du hast mir ja noch nicht "
	   "einmal begonnen.\n"));
  say(TPN+" stellt sich dumm an.\n");
  return -1;
  }
  if(present("linse2", TP) && present("linse1", TP) && present("linse3", TP) && present("stab1", TP) && present("stab2", TP) && present("stab3", TP) && present("stab4", TP) && present("teleskop", TP))
  { 
  write(BS("Elen sagt: Hervorragend, endlich kann ich wieder Horoskope "
	   "erstellen. \n"
           "Elen strahlt Dich an, baut das Teleskop zusammen und ueberreicht "
	   "Dir ein Horoskop.\n"));
  say(TPN+" freut sich.\n");
  if (present("linse1",TP))
  present("linse1",TP)->remove();
  if (present("linse2",TP))
  present("linse2",TP)->remove();
  if (present("linse3",TP))
  present("linse3",TP)->remove();
  if (present("stab1",TP))
  present("stab1",TP)->remove();
  if (present("stab2",TP))
  present("stab2",TP)->remove();
  if (present("stab3",TP))
  present("stab3",TP)->remove();
  if (present("stab4",TP))
  present("stab4",TP)->remove();
  if (present("teleskop",TP))
  present("teleskop",TP)->remove();
  if (present("schraubenzieher",TP))
  present("schraubenzieher",TP)->remove();
  if(present("astroinvis", TP))
  {
  present("astroinvis",TP)->remove();
  horoskop=clone_object(OBJ "horoskop")->move(TP, M_NOCHECK);
  if (IS_SEER(TP))
  call_other( "/obj/sehertormaster", "DiscoverDoor","/d/kristallwald/chivas/zentauren/room/zen39");  
  }
  if(present("dragoninvis2", TP))
  {
  present("dragoninvis2",TP)->remove();
  horoskop=clone_object("/d/kristallwald/chivas/dragonquest/obj/horoskopm")->move(TP, M_NOCHECK);
  }
  return 1;
  }
}
  {
  write(BS("Elen sagt: Dir fehlt immer noch etwas. Komm wieder wenn Du alles "
	   "hast. \n"));
  say(TPN+" verzweifelt.\n");
  return 1;
  } 
}
//}
int bitten(string str)
{
object dragoninvis2;
notify_fail("Wen moechtest Du um was fuer wen bitten?\n");

if(!str || str == "") return 0;
 if(!(str == "elen um horoskop fuer marlog" ||
     str == "elen um horoskop fuer schmied" )) return 0;

 if(!present("elen"))
 {
  write(BS("Aber Elen ist doch garnicht da!"));
 return -1;
 }
if(!present("dragoninvis1", TP))
 {
  write(BS("Elen sagt: Wofuer brauchst Du denn ein Horoskop fuer Marlog. "
	   "Der dreckige Schmied soll gefaelligst selbst zu mir kommen."));
 return -1;
 }
  if(present("dragoninvis2", TP)){
	  
  write(BS("Elen sagt: Aber Du hast mich doch bereits gebeten fuer Marlog "
	   "ein Horoskop zu erstellen und Du wolltest doch schon meine "
	   "Teile fuer das Teleskop suchen. Beeil Dich nun.\n"));
 
  say(TPN+" stellt sich dumm an.\n");
  return -1;
  }

  write(BS("Elen sagt: Kein Problem, aber der Hofnarr hat mein Teleskop "
	   "geklaut und die Einzelteile versteckt. Du musst mir erst alle "
	   "Teile bringen. Wenn Du alle Teile hast, komm zurueck und antworte "
	   "mir 'Fertig'. Dann erstelle ich das Horoskop fuer Marlog und gebe "
	   "es Dir.\n"));
 
  say(TPN+" bittet Elen um Etwas.\n");
  dragoninvis2=clone_object( "/d/kristallwald/chivas/dragonquest/obj/dragoninvis2")->move(TP, M_NOCHECK);
  return 1;
 }

