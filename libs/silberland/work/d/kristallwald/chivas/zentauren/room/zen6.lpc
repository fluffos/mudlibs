// von Chivas
// 06.6.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einer Wiese");
  SetProp( P_INT_LONG,
        "Die Sonne scheint Dir auf die Nase, die Blumenwiese, auf der "
        "Du stehst, gruent und blueht. Du fuehlst Dich pudelwohl, die Blumen "
        "und Graeser auf der Wiese zu betrachten. Ab und zu sieht man auch "
        "einen Erdhuegel zwischen dem Gras und dem Bach, den Du im Wald suedlich "
        "gehoert hast, kann man hier jetzt auch gut sehen. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden"}), 
            "Der Boden ist weich, da er von Gras und Blumen bedeckt ist. Die "
            "darunter befindliche Erde kann man nur auf ein paar Erdhuegeln "
            "erkennen, die anscheinend ein paar Maulwuerfe aufgeworfen haben.");

  AddDetail( ({"sonne"}),
	    "Die Sonne steht fast senkrecht am fast blauen Himmel und waermt Dich, "
            "so dass Du Dich einfach wohl fuehlst.");

  AddDetail( ({"himmel","horizont"}),
	    "Der Himmel ist strahlend blau. Nur an ein paar Wolken kannst Du "
            "am Horizont sehen.");

  AddDetail( ({"wolken","gefahr"}), 
            "Es sind nur kleine weisse Wolken am Himmel. Es besteht also keine Gefahr "
            "von Regen.");

  AddDetail( ({"regen"}), 
            "Es sieht nicht danach aus, dass es regnen wird. Keine dunklen Wolken "
            "am Himmel.");

  AddDetail( ({"blumen","meer","farbenpracht","farben","arten","blume"}),
	    "Hier auf der Wiese ist ein Meer von Blumen. Du erkennst Narzissen, Tulpen, "
            "Sonnenblumen, Gaensebluemchen, Lilien und noch andere Arten, die Du nicht "
            "kennst. Es ist einfach eine unglaubliche Farbenpracht.");

  AddDetail( ({"graeser","gras"}),
	    "Du gehst ueber das Gras der Wiese, es ist sehr weich und es laesst sich "
            "angenehm auf ihm gehen."); 
  
  AddDetail( ({"wiese","suche","blumenwiese"}), 
            "Die Wiese ist traumhaft schoen. Blumen und Graeser ueberall lassen die "
            "Wiese in den unterschiedlichsten Farben leuchten. Bienen und Hummeln summen "
            "durch die Luft auf der Suche nach Nektar.");

  AddDetail( ({"nase"}),
	    "Die Sonne scheint Dir auf die Nase. Du solltest aufpassen, dass Du keinen "
            "Sonnenbrand bekommst.");

  AddDetail( ({"sonnenbrand","abend"}),
	    "Deine Nase ist schon leicht geroetet. Du solltest Dich am Abend gut eincremen.");

  AddDetail( ({"erdhuegel","huegel"}),
	    "Die Erdhuegel stammen anscheinend von Maulwuerfen, die die Erde bei ihrem graben "
            "nach oben geworfen haben.");

  AddDetail( ({"erde","eindruck"}), 
            "Die Erde ist braeunlich und macht einen sehr fruchtbaren Eindruck.");

  AddDetail( ({"narzissen","pracht"}),
	    "Die Narzissen bluehen in voller Pracht und sehen sehr schoen aus.");

  AddDetail( ({"tulpen"}),
	    "Es gibt Tulpen in verschiedenen Farben auf der Wiese. Du erkennst rote, blaue "
            "und gelbe Tulpen. Einfach huebsch anzusehen."); 
  
  AddDetail( ({"sonnenblumen"}), 
            "Grosse Sonnenblumen stehen auf der Wiese. Ansonsten ist an ihnen nichts "
            "besonderes zu erkennen.");

  AddDetail( ({"gaensebluemchen"}),
	    "Die Gaensebluemchen wirken recht klein und zierlich neben den anderen "
            "groesseren Blumen, trotzdem passen sie sehr gut auf die Wiese. Sie gehoeren "
            "einfach hier her.");

  AddDetail( ({"lilien","blueten","form"}),
	    "Die Lilien sind sehr zierlich und die Blueten haben eine wunderschoene Form. "
            "Normalerweise wuerdest Du ja eine pfluecken, aber es waere einfach schade, "
            "wenn sie dann verwelken. ");

  AddDetail( ({"wald"}), 
            "Im Suedosten ist der Wald, verschiedene Baeume kann man erkennen.");

  AddDetail( ({"baeume"}),
	    "Die Baeume im Suedosten sind Ulmen, Eichen und Tannen.");

  AddDetail( ({"bach","stellen","aussehen"}),
	    "Der Bach fliesst hier ueber die Wiese und das Wasser plaetschert ueber "
            "einige Steine. An einigen Stellen steht etwas Schilf und verpasst dem "
            "Bach ein idyllisches Aussehen."); 
  
  AddDetail( ({"schilf","ufer"}), 
            "Das Schilf ist hochgewachsen und steht am Ufer des kleinen Baches.");

  AddDetail( ({"wasser"}),
	    "Das Wasser ist glasklar. Man kann einige Fische im Wasser sehen.");

  AddDetail( ({"steine","stein","geraeusch"}),
	    "Das Wasser plaetschert ueber die Steine, so dass man ein plaetscherndes "
            "Geraeusch hoeren kann.");

  AddDetail( ({"fische","stroemung"}), 
            "Die Fische schwimmen teilweise mit der Stroemung und teilweise gegen die "
            "Stroemung. Es sind wunderschoene Bachforellen.");

  AddDetail( ({"forellen","bachforellen","essbares"}),
	    "Die Bachforellen suchen anscheinend etwas Essbares und ihre Schuppen "
            "glaenzen in der Sonne.");

  AddDetail( ({"bienen","honig","honigduft"}),
	    "Die Bienen summen durch die Luft, erfuellen sie mit Honigduft."); 
  
  AddDetail( ({"maulwurf","maulwuerfe"}), 
            "Maulwuerfe kann man nicht erkennen. Nur die von ihnen aufgeworfenen "
            "Erdhuegel kannst Du sehen.");

  AddDetail( ({"schuppen","regenbogenfarben"}),
	    "Die Schuppen der Forellen glaenzen in der Sonne in den Regenbogenfarben.");

  AddDetail( ({"hummeln","nektar"}),
	    "Die Hummeln sammeln Nektar und fliegen von Blume zu Blume.");

  AddDetail( ({"luft"}),
	    "Du kannst sie riechen.");

  AddDetail( ({"dschungel","kobold","detail","baeren","jungen","lied","O","strophe","rede",
               "ameisen","kopf","ruhe","gemuetlichkeit","das","stande"}),
	    "Dieses Detail wurde an einen Kobold vermietet.");

  AddDetail( ({"tannen"}), 
            "Die Tannen bewegen sich leicht im Wind. Um sie zu untersuchen, sollte man "
            "naeher ran gehen.");

  AddDetail( ({"wind","lueftchen"}), 
            "von Wind kann eigentlich nicht die Rede sein. Es ist eher ein laues Lueftchen. ");

  AddDetail( ({"ulmen","untersuchung"}),
	    "Die Ulmen sind sehr hoch gewachsen. Fuer eine naehere Untersuchung muss man nach "
            "Suedosten gehen.");

  AddDetail( ({"eichen"}),
	    "Die Eichen sind alt und gross und wachsen im Wald im Suedosten."); 

  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen und ein leichter Honigduft von den "
                          "Bienen liegt in der Luft.");  
 
  AddSmell( ({"blumen"}),
	   "Es riecht nach allen moeglichen Blumen. Einfach blumig.");

  AddSmell( ({"honigduft","honig"}),
	   "Ein Honigduft liegt in der Luft von den nektarsammelnden Bienen und Hummeln.");

  AddSmell( ({"luft"}),
	   "Die Luft riecht klar, nach Honig und Blumen.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Plaetschern vom Bach und das Summen von Bienen "
                          "in der Luft.");

  AddSound( ({"plaetschern","bach","geraeusch"}),
	   "Das Plaetschern kommt dadurch zu Stande, dass das Wasser ueber Steine "
           "im Bach fliesst. Es wirkt sehr beruhigend.");

  AddSound( ({"summen","bienen"}),
	   "Du hoerst die Bienen summen und dabei kommt Dir irgendein Lied in den "
           "Kopf. Du kannst es aber nicht zuordnen. Die Strophe geht ungefaehr so: \n"
           "   \n"
           "Die Bienen summen in der Luft, erfuellen sie mit Honigduft \n"
           "und schaust Du unter einen Stein, entdeckst Du Ameisen, die hier gut gedeihn. \n"
           "Probiers mal mit Gemuetlichkeit, mit Ruhe und Gemuetlichkeit......\n"
           "  \n"
           "Du denkst . o O (Das war irgendwas mit einem Baeren und einem kleinen Jungen im "
           "Dschungel. Naja, vielleicht faellt es mir ja noch ein.) ");
    

//-----Details Ende-----
  
AddExit("suedosten", ROOM "zen5");
AddExit("norden", ROOM "zen7");

}

