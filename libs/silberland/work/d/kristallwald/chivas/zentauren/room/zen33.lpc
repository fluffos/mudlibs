// von Chivas
// 31.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";


#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Park von Roch Adan");
  SetProp( P_INT_LONG,
	"Dies ist die nordoestlichste Ecke des Parks, hier gibt es keine Blumen, sondern "
        "nur saftig gruenes Gras, das zum Ausrasten einlaedt. Der Weg, der durch den Park "
        "fuehrt, ist mit kleinen Steinchen angelegt worden und fuehrt an der Hecke entlang, "
        "die den gesamten Park umgibt. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----


  AddDetail( ({"boden"}), 
            "Die Wege sind mit kleinen Steinchen angelegt und das Gras auf dem Rasen ist kurz und gruen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau, bis auf ein paar kleine Wolken. Ein paar Voegel fliegen am Himmel.");

  AddDetail( ({"wolken","regen"}),
	    "Die Wolken sind weiss. Es sieht nicht nach Regen aus.");

  AddDetail( ({"sonne"}), 
            "Die Sonne steht am Himmel und waermt Dich angenehm.");

  AddDetail( ({"voegel"}),
	    "Die Voegel sind Schwalben, so weit Du es erkennen kannst.");

  AddDetail( ({"schwalben","insekten"}),
	    "Die Schwalben fliegen sehr weit oben am Himmel und suchen sicher Insekten."); 
  
  AddDetail( ({"park","ecke","parks"}), 
            "Du befindesst Dich hier in der nordoestlichsten Ecke des Parks. Die grossen Rasenflaechen laden "
            "geradezu dazu ein, sich einfach hinzusetzen um ein bisschen zu entspannen. Die kleinen Wege "
            "schlaengeln sich an der Hecke entlang.");

  AddDetail( ({"blumen","teil"}),
	    "Blumen gibt es in diesem Teil des Parkes leider nicht.");

  AddDetail( ({"gras"}),
	    "Das Gras ist schoen gruen und die Rasenflaechen sehen sehr gepflegt aus.");

  AddDetail( ({"ausrasten"}), 
            "Ausrasten ist eine gute Idee, aber hast Du es Dir schon verdient?");

  AddDetail( ({"weg","wege"}),
	    "Die Wege fuehren nach Westen und Sueden an der Hecke entlang. Sie sind mit kleinen Steinchen "
            "angelegt und sehen sehr gepflegt aus. Am Weg steht eine kleine Parkbank.");

  AddDetail( ({"steinchen","kieselsteine","steine"}),
	    "Ganz normale kleine Kieselsteine, die ab und zu in der Sonne glitzern. Ansonsten sind "
            "sie recht uninteressant."); 
  
  AddDetail( ({"hecke"}), 
            "Die Hecke umgibt den gesamten Park von Roch Adan und trennt ihn von der dahinter liegenden "
            "Strasse ab.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren.");

  AddDetail( ({"parkbank","bank","platz"}),
	    "Schade, die Bank ist schon besetzt. Ein Liebespaar hat darauf Platz genommen und ist mit sich "
            "selber beschaeftigt, so dass sie Dich gar nicht wahrnehmen.");

  AddDetail( ({"liebespaar","paar","knutschen"}), 
            "Das Paar ist wild am Knutschen. Du fragst Dich nur was die Hand des maennlichen Abenteurers unter "
            "dem Kettenhemd des weiblichen Abenteurers zu suchen hat. Irgendwie komisch.");

  AddDetail( ({"hand"}),
	    "Hier wird darauf hingewiesen, dass so manches Detail doch nicht weiter beschrieben werden sollte, da "
            "auch minderjaehrige Personen im Silberland unterwegs sind.");

  AddDetail( ({"personen","abenteurer","abenteurers"}),
	    "Abenteurer wie Du auch einer bist."); 
  
  AddDetail( ({"rasenflaechen","rasen","flaechen","flaeche","rasenflaeche"}), 
            "Die Rasenflaechen sind sicher erst vor kurzem gemaeht worden.");

  AddDetail( ({"idee"}),
	    "Selbst Du hast ab und zu mal eine, es ist nicht zu glauben.");

  AddDetail( ({"strasse","sicht"}),
	    "Die Strasse kannst Du von hier aus nicht sehen. Die Hecke versperrt Dir die Sicht.");

  AddDetail( ({"kettenhemd","meter"}), 
            "Du solltest Dir das Kettenhemd jetzt nicht weiter anschauen. Es sieht naemlich ziemlich aufdringlich "
            "aus, wenn Du einen Meter vor dem Paar stehst und willst das Kettenhemd untersuchen. Schaem Dich.");

  AddDetail( ({"detail","schreiben"}),
	    "Ein Detail ist etwas, was man beim Schreiben zu hassen lernt.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland und findest es toll hier."); 
  
  AddDetail( ({"zukunft","sternen"}), 
            "Ob Du eine hast, steht wirklich in den Sternen.");

  AddDetail( ({"kopf"}),
	    "Selbst Du hast einen, obwohl Du ihn nicht so oft benutzt.");

  AddDetail( ({"zentaur","zentauren","geschoepfe","huefte","menschen","pferdekoerper","bewegungen","planeten"}),
	    "Zentauren sind magische Geschoepfe, vom Kopf bis zur Huefte Menschen, "
            "darunter jedoch mit Pferdekoerper und -beinen versehen. Man erzaehlt "
            "sich ueber sie, dass sie die Zukunft in den Bewegungen der Planeten "
            "am Himmel lesen koennen. ");

  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");


  AddSmell(DEFAULT_SMELL, "Du riechst das Gras.");  
 
  AddSmell( ({"gras"}),
	   "Das Gras riecht wie frisch gemaeht.");

  AddSound(DEFAULT_SOUND, "Hoeren tust Du hier ausnahmsweise nichts.");

//-----Details Ende-----
AddItem(NPC "zentaurm1", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "zen33",
          P_MNPC_AREA:({ROOM "zen13", ROOM "zen16", ROOM "zen17",
                          ROOM "zen18", ROOM "zen19", ROOM "zen20",
                          ROOM "zen21", ROOM "zen22", ROOM "zen23",
                          ROOM "zen24", ROOM "zen25", ROOM "zen26",
                          ROOM "zen27", ROOM "zen28", ROOM "zen29",
                          ROOM "zen30", ROOM "zen31", ROOM "zen32",
                          ROOM "zen33", ROOM "zen34", ROOM "zen35",
                          ROOM "zen36", ROOM "zen37", ROOM "zen43",
                          ROOM "zenladen",ROOM "zenschmied"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );

AddExit("sueden", ROOM "zen28");  
AddExit("westen", ROOM "zen32");  

}  
   
