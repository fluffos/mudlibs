// von Chivas
// 06.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>


void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einer Wiese");
  SetProp( P_INT_LONG,
        "Die Wiese, die sich von hier aus Richtung Sueden erstreckt, ist wie aus dem "
        "Bild eines Malers, halt wunderschoen gruen mit vielen bunten Blumen, von denen "
	"Du viele gar nicht kennst. Weiter hinten auf der Wiese steht ein Bienenstock. "
        "Der Himmel ist blau und Du fuehlst Dich wohl. Auch ein Baum steht auf der Wiese "
        "und faellt Dir besonders auf." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( ({"boden"}), 
            "Der Boden ist weich, da er von Gras bewachsen ist. Ueberall stehen Blumen und Graeser "
            "auf der Wiese, von denen Du bei weitem nicht alles kennst. Auch ein Baum steht auf der "
            "Wiese.");

  AddDetail( ({"bild","namen","zusatz"}),
	    "Die Wiese, auf der Du stehst, koennte auch auf dem Bild eines Malers abgebildet sein. Die "
            "vielen Blumen gefallen Dir sehr. Vor allem die Sonnenblumen wuerden Dich dazu "
            "bringen, ein Bild zu malen. Vielleicht wuerdest Du Deinem Namen dann den Zusatz van "
            "geben, was irgendwie passend klingt.");

  AddDetail( ({"maler","malers","das","sonnenblumenfeld","motiv"}),
	    "Jeder Maler wuerde gerne ein Bild von dieser Wiese malen, vor allem von den Sonnenblumen, "
            "die sicher ein tolles Motiv darstellen wuerden. Man koennte das Bild dann -Das "
            "Sonnenblumenfeld- nennen.");

  AddDetail( ({"blumen"}), 
            "Verschiedene Blumen bluehen auf der Wiese. Viele der Blumen kennst Du nicht. Du erkennst "
            "jedoch einige Gaensebluemchen, bluehenden Holunder und sehr viele Sonnenblumen.");

  AddDetail( ({"gras","graeser","minute"}),
	    "Das Gras ist gruen und weich. Die verschiedenen Arten der Graeser kennst Du nicht. Man "
            "sollte sich mehr damit beschaeftigen. Du nimmst Dir vor, in einer ruhigen Minute mal "
            "die verschiedenen Arten nachzuschlagen.");

  AddDetail( ({"baum","birnenbaum","jahrzehnten"}),
	    "Der Baum ist ein alter Birnenbaum, der schon seit Jahrzehnten auf der Wiese stehen muss. "
            "Er hat einen wohlgeformten Stamm und die Aeste sind voller Birnen und Blaetter. Es ist "
            "so angenehm hier, dass Du Dich vielleicht einfach mal ausruhen solltest und Dich unter "
            "den Baum setzen solltest."); 
  
  AddDetail( ({"stamm"}), 
            "Der Stamm des Baumes ist mit einer dicken Rinde umgeben.");

  AddDetail( ({"rinde","gesundheit"}),
	    "Die Rinde ist sproede. Jedoch sieht sie gesund aus. Der Birnenbaum ist bei bester "
            "Gesundheit.");

  AddDetail( ({"blaetter","eindruck"}),
	    "Die Blaetter bewegen sich leicht im Wind und sind saftig gruen und machen einen gesunden "
            "Eindruck");

  AddDetail( ({"aeste","zustand"}), 
            "Die Aeste sind voller Blaetter und Birnen. Der Baum befindet sich in einem tadellosen "
            "Zustand.");
 

  AddDetail( ({"birnen","birne","moeglichkeit","mund","wasser"}),
	    "Die Birnen haengen an den Aesten. Schade, dass es keine Moeglichkeit gibt direkt "
            "an sie ranzukommen. Die Birnen haengen zu hoch und sie sehen "
            "doch so verfuehrerisch lecker aus. Dir laeuft das Wasser im Mund zusammen. "
            "Wie kommt man bloss an die Birnen ran, wie kommt man darauf?");

  AddDetail( ({"sonnenblumen"}),
	    "Die Sonnenblumen sehen herrlich aus. Man sollte ein Bild von ihnen malen."); 
  
  AddDetail( ({"gaensebluemchen"}), 
            "Die zierlichen Gaensebluemchen wachsen im hohen Gras zwischen den anderen Blumen, "
            "die Dir groesstenteils unbekannt sind.");

  AddDetail( ({"holunder","bluete"}),
	    "Der Holunder steht in voller Bluete und viele Bienen des weiter hinten auf der Wiese "
            "stehenden Bienenstocks schwirren um ihn herum.");

  AddDetail( ({"bienenstock","bienenstocks"}),
	    "Der Bienenstock beheimatet sicher tausende von Bienen. Du gehst besser nicht zu nah ran, "
            "da Du nicht gestochen werden willst.");

  AddDetail( ({"bienen"}), 
            "Die Bienen schwirren zwischen den Blumen und dem Bienenstock weiter hinten auf der Wiese "
            "hin und her. Sie sind wirklich sehr fleissig. ");

  AddDetail( ({"wiese"}),
	    "Die Wiese ist kunterbunt von all den bluehenden Blumen und Graesern. Auf der Wiese steht "
            "ein alter Birnenbaum und weiter hinten ein Bienenstock. Anscheinend zuechtet Jemand hier "
            "Bienen und wird sich auf den Honig freuen.");

  AddDetail( ({"hintern"}),
	    "Du hast einen knackigen Hintern. Du bist sehr stolz drauf."); 
  
  AddDetail( ({"etwas","spitzes"}), 
            "An der Stelle wo Du Dich hast hinsetzen wollen ist etwas Spitzes im Boden. Vielleicht "
            "kannst Du es rausziehen.");

  AddDetail( ({"scherbe"}),
	    "Die Scherbe glitzert ein wenig in der Sonne. Sie ist wertlos, also wirfst Du sie weg.");

  AddDetail( ({"jemand"}),
	    "Hier ist niemand zu sehen. Es kann natuerlich sein, dass ein unsichtbarer Magier neben "
            "Dir steht.");

  AddDetail( ({"honig","sache"}), 
            "Den Honig kannst Du nicht sehen, da er sich ja sicher im Bienenstock befindet. Dir ist "
            "es aber zu gefaehrlich, der Sache weiter nach zu gehen.");

  AddDetail( ({"magier","scripte"}),
	    "Falls wirklich ein Magier hier ist, so kannst Du ihn weder sehen noch hoeren. Dies ist "
            "jedoch auch nicht schlimm. Die Magier im Silberland sind sowieso meistens am idlen und "
            "bekommen nichts mit. Jedenfalls hat Dich noch keiner auf Deine illegalen Scripte "
            "angesprochen und Dich verwarnt.");

  AddDetail( ({"silberland"}),
	    "Das solltest Du eigentlich wissen, wenn Du schon so weit gekommen bist."); 
  
  AddDetail( ({"himmel"}), 
            "Der Himmel ist blau. Die Sonne strahlt zwischen ein paar Wolken hindurch und waermt "
            "Dich. Einige Voegel kreisen am Himmel.");

  AddDetail( ({"sonne"}),
	    "Die Sonne steht fast senkrecht und ist halb von ein paar Wolken verdeckt. Trotzdem "
            "waermt sie Dich und Du fuehlst Dich wohl.");

  AddDetail( ({"wolken","regen"}),
	    "Die Wolken sind weiss und es wird wohl keinen Regen geben. Sie verdecken ein bisschen "
            "die Sonne.");

  AddDetail( ({"voegel"}), 
            "Die Voegel kreisen am Himmel und es scheint sich wohl um Greifvoegel zu handeln, die "
            "von weit oben auf Beutejagd sind.");

  AddDetail( ({"greifvoegel","beutejagd","jagd"}),
	    "Es sind Greifvoegel. Einen Bussard kann man sogar erkennen.");

  AddDetail( ({"bussard","fluegelschlag"}),
	    "Der Bussard schwebt geradezu am Himmel ohne einen Fluegelschlag laesst er sich vom "
            "Wind tragen."); 

  AddDetail( ({"wind","thermik"}),
	    "Der Wind weht ganz leicht ueber den Boden. Weiter oben wo die Voegel sind, scheint "
            "er staerker zu sein, da die Voegel in der Thermik schweben."); 
  
  AddSmell(DEFAULT_SMELL, "Du riechst die Blumen. Sie duften einfach herrlich.");  
 
  AddSmell( ({"blumen","holunder","sonnenblumen","arten"}),
	   "Die Blumen duften nach Holunder und Sonnenblumen und nach anderen Arten, die Du "
           "nicht kennst.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind leicht wehen und das Kreischen eines Bussards am "
                          "Himmel.");

  AddSound( ({"wind","graeser","blumen","rascheln"}),
	   "Man hoert ein leises Rascheln der Graeser und Blumen, wenn der Wind ueber sie streicht.");

  AddSound( ({"bussard","kreischen"}),
	   "Der Bussard am Himmel laesst sein uebliches Kreischen verlauten. Dies macht er immer "
           "wenn er sich auf der Jagd befindet.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "zen7");
AddExit("nordwesten", ROOM "zen9");

AddCmd( ({"setz","setze" }), "setzen" );
AddCmd( ({"zieh", "ziehe" }), "ziehen" );
AddCmd( ({"kletter", "klettere" }), "klettern" );
}
int setzen(string str)
{
   notify_fail("Wohin moechtest Du Dich setzen?\n");
   if ( member( ({ "unter baum", "unter birnenbaum" }),str) != -1) 
  {
    write(BS( "Du setzt Dich unter den Birnenbaum, springst aber sofort wieder auf, da Dich Etwas "
           "in den Hintern gepiekst hat.\n"));
    say( TPN+" setzt sich hin, springt aber sofort fluchend wieder auf.\n");
    return 1;
  }
}
int ziehen(string str)
{
   notify_fail("Was moechtest Du rausziehen?\n");
   if ( member( ({ "etwas raus", "spitzes raus","etwas heraus","spitzes heraus" }),str) != -1) 
  {
    write(BS ( "Du ziehst eine alte Scherbe aus dem Boden. Das hat Dich gepiekst. Du bist enttaeuscht und wirfst sie wuetend weg."));
    say( TPN+" zieht eine Scherbe aus dem Boden, wirft sie dann aber wuetend "
             "weg.\n");
    return 1;
  }

}
int klettern(string str)
{
   notify_fail("Wohin moechtest Du klettern?\n");
   if ( member( ({ "auf baum", "auf birnenbaum" }),str) != -1) 
  {
    write(BS ( "Du kletterst den Baum hoch."));
    say( TPN+" klettert den Baum hoch und verschwindet.\n");
    TP->move( ROOM "zen45", M_GO, "rauf");
    return 1;
  }

}

  
   

