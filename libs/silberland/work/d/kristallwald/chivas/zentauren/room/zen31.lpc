// von Chivas
// 27.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int angel_zahl=1;

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Park von Roch Adan");
  SetProp( P_INT_LONG,
	"Dies ist die nordwestlichste Ecke des Parks. Hier bluehen hunderte von "
        "Blumen in ordentlich gepflegten Beeten und Bienen summen durch die Luft. "
        "Ausserdem ist ein kleiner Springbrunnen in der Naehe der Hecke gebaut worden, "
        "die den gesamten Park umgibt. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----


  AddDetail( ({"boden"}), 
            "Die Wege sind mit Steinchen bedeckt, ansonsten siehst Du die fast schwarze Erde der Beete und einen "
            "grossen Springbrunnen.");

  AddDetail( ({"ecke"}),
	    "Du bist in der nordwestlichen Ecke des Parks von Roch Adan.");

  AddDetail( ({"park","parks","stadtpark"}),
	    "Du befindest Dich in dem wunderschoenen Stadtpark von Roch Adan. An dieser Stelle des Parks "
            "ist ein geradezu ein Farbenmeer von Blumen und ein beeindruckender Springbrunnen.");

  AddDetail( ({"blumen","farbenmeer","meer","stelle","farben"}), 
            "Die Blumen bluehen in allen Farben. Du siehst Tulpen, Rosen, Lilien, Veilchen und sogar einige "
            "Orchideen. Lauter Bienen fliegen zwischen den Blumen hin und her.");

  AddDetail( ({"beeten","beete","blumenbeeten","blumenbeete","wunder"}),
	    "In den Blumenbeeten wachsen hunderte von Blumen. Es ist ja auch kein Wunder, da die Erde sehr "
            "fruchtbar aussieht.");

  AddDetail( ({"bienen","nektar"}),
	    "Die Bienen fliegen zwischen den Blumen hin und her und sammeln Nektar."); 
  
  AddDetail( ({"luft"}), 
            "Die Bienen summen durch die Luft.");

  AddDetail( ({"springbrunnen","brunnen","brunnens","naehe"}),
	    "Der Springbrunnen ist aus Granit und das Wasser plaetschert ueber zwei Ebenen "
            "in den grossen Brunnen. Auf dem Wasser schwimmen einige Seerosen.");

  AddDetail( ({"hecke"}),
	    "Die Hecke im Norden und im Westen schirmt den Park von der dahinter liegenden Strasse ab.");

  AddDetail( ({"erde"}), 
            "Die schwarze Erde ist sehr fruchtbar. In dieser Erde gedeihen die Blumen sehr gut.");

  AddDetail( ({"weg","wege"}),
	    "Die Wege schlaengeln sich durch den Park und sind mit kleinen Steinchen bedeckt.");

  AddDetail( ({"steinchen"}),
	    "Die kleinen Steinchen sind sehr sehr uninteressant."); 
  
  AddDetail( ({"wasser","druck","ebene","probleme"}), 
            "Das Wasser spritzt auf der obersten Ebene unter Druck heraus und bildet eine Fontaene. "
            "Danach plaetschert es ueber eine zweite Ebene in den Brunnen. Das Wasser ist klar, so "
            "dass man ohne Probleme den Grund sehen kann. ");

  AddDetail( ({"fontaene","meter"}),
	    "Die Fontaene, die aus der obersten Ebene schiesst ist mindestens drei Meter hoch.");

  AddDetail( ({"kieselsteine","steine"}),
	    "Die Kieselsteine am Grund des Brunnens sind nicht sehr interessant.");

  AddDetail( ({"arbeit"}),
	    "So etwas wie Arbeit kennst Du doch gar nicht, sei ehrlich.");

  AddDetail( ({"goldfische","fische","goldfisch","fisch","angel"}), 
            "Die Goldfische sind klein und flink, haettest Du eine Angel, koenntest Du "
            "vielleicht einen angeln.");

  AddDetail( ({"granit"}),
	    "Der Granit ist schwarz und sehr hart. Es muss eine schwere Arbeit gewesen sein, den Granit "
            "zu bearbeiten.");

  AddDetail( ({"grund"}),
	    "Durch das klare Wasser kann man auf dem Grund lauter Kieselsteine. Jetzt wo Du tiefer ins "
            "Wasser schaust, siehst Du auch einige kleine Goldfische."); 
  
  AddDetail( ({"seerosen"}), 
            "Die Seerosen schwimmen auf dem Wasser im Brunnen. Sie sehen sehr schoen aus und manche "
            "von ihnen bluehen sogar.");

  AddDetail( ({"veilchen"}),
	    "Die blauen Veilchen sind sehr begehrt bei den Bienen.");

  AddDetail( ({"tulpen"}),
	    "Die roten und gelben Tulpen bluehen wunderschoen.");

  AddDetail( ({"rosen","zuechtung"}), 
            "Die Rosen sind extrem gross und sind sicher eine eigene Zuechtung der Zentauren.");

  AddDetail( ({"lilien"}),
	    "Die gelben Lilien bewegen sich leicht im Wind.");

  AddDetail( ({"orchideen"}),
	    "Die Orchideen, die Du siehst, kennst Du nicht. Sie sehen aber in ihren verschiedenen Farben "
            "wirklich toll aus."); 
  
  AddDetail( ({"strasse"}), 
            "Die Strasse kannst Du durch die Hecke nicht sehen.");

  AddDetail( ({"wind","lueftchen"}),
	    "Ein leichter Wind weht durch den Park, obwohl man ihn wohl eher als Lueftchen bezeichnen sollte.");

  AddDetail( ({"himmel","sonne"}),
	    "Der Himmel ist schoen blau und die Sonne steht am fast senkrecht.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren.");

  AddDetail( ({"zentaur","zentauren","geschoepfe","kopf","huefte","menschen","pferdekoerper","zukunft","bewegungen","planeten"}),
	    "Zentauren sind magische Geschoepfe, vom Kopf bis zur Huefte Menschen, "
            "darunter jedoch mit Pferdekoerper und -beinen versehen. Man erzaehlt "
            "sich ueber sie, dass sie die Zukunft in den Bewegungen der Planeten "
            "am Himmel lesen koennen. ");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");


  AddSmell(DEFAULT_SMELL, "Du riechst die vielen Blumen im Park.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen duften suesslich.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Plaetschern vom Brunnen.");

  AddSound( ({"plaetschern","brunnen"}),
	   "Du hoerst wie das Wasser die zwei Ebenen in den Brunnen plaetschert. Es "
           "wirkt sehr beruhigend.");

//-----Details Ende-----

AddExit("sueden", ROOM "zen26");  
AddExit("osten", ROOM "zen32");

AddCmd( ({"angel","angle" }), "angeln" );
}

void reset()
	
{
  ::reset();
  angel_zahl=1; 
}

int angeln(string str)
{
 object goldfisch;
 notify_fail("Was willst Du womit angeln?\n");

 if(!str || str == "") return 0;
 if(!(str == "mit angel" ||
      str == "goldfisch" ||
      str == "fisch" ||
      str == "goldfisch mit angel" ||
      str == "mit angel goldfisch" ||
      str == "mit angel nach fisch" )) return 0;
 

 if( str == "mit angel" ||
     str == "goldfisch mit angel" ||
     str == "mit angel goldfisch" ||
     str == "mit angel fisch"){
    
  if(!present("angel", TP)){
	  
  write(BS("Du hast ja gar keine. Wie willst Du dann mit einer Angel angeln?\n"));
 
  say(TPN+" denkt nach.\n");
  return -1;
  }

  if(angel_zahl < 1)

  {
	  
  write(BS("Die Goldfische fallen auf den Koeder an der Angel nicht mehr rein.\n"));
 
  say(TPN+" angelt umsonst.\n");
  return 1;
  }
  else
  {
  write(BS("Du angelst wild vor Dich hin und ploetzlich beisst auch ein "
	   "Goldfisch an. Du schnappst ihn Dir und steckst ihn ein. \n"));
 
  say(TPN+" faengt mit der Angel einen Goldfisch.\n");
  goldfisch=clone_object(OBJ "goldfisch")->move(TP, M_NOCHECK);
  angel_zahl--;
  return 1;
 }
 if( str == "goldfisch" ||
     str == "fisch"){
 
 write(BS("Womit willst Du denn angeln ? "
	  "Eine Angel waere hier eine gute Idee.\n"));

 say(TPN+" stellt sich dumm an.\n");
 return 1;
 }
 }
}


