// von Chivas
// 25.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int fledermausda;

void create()
	
{
  ::create();

   fledermausda=1; 

  SetProp( P_INT_SHORT, "In einem Tunnel");
  SetProp( P_INT_LONG,
	"Hier ist der Tunnel sehr dunkel. Ohne das Licht, was aus dem Norden "
        "in den Tunnel faellt, koennte man hier nichts erkennen. Draussen "
        "erkennst Du lauter gruene Pflanzen. Da scheint ein Wald zu sein. "
        "Hier drinnen scheinen die Waende Dich zu erdruecken und es laeuft "
        "Dir eiskalt den Ruecken runter. Irgendwie fuehlst Du Dich beobachtet, "
        "aber was sollte hier in diesem Tunnel schon leben. Niemand wuerde "
        "sich hier wohlfuehlen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 0 );
  
//-----Details Anfang-----
  
  AddDetail( ({"boden"}), 
            "Der Boden besteht aus hartem Fels. Ein paar Steine liegen auf dem Boden, die anscheinend "
	    "von der Wand oder der Decke abgebrochen sind. An einigen Stellen wirkt der Boden "
            "ein wenig glitschig.");

  AddDetail( ({"tunnel","tunnels","platz","probleme"}),
	    "Der Tunnel ist grob gehauen und nur ein wenig Licht "
	    "aus dem Norden erhellt den Tunnel. Er bietet viel Platz, "
            "so dass Du ohne Probleme aufrecht stehen kannst. Trotzdem wirken "
            "die Waende erdrueckend. Im Norden endet der Tunnel und ein "
            "Wald scheint zu beginnen. Im Sueden geht der Tunnel weiter.");

 AddDetail( ({"steine"}),
	    "Die Steine sind wohl von der Decke oder der Wand abgebrochen. Sie sind aber uninteressant. "
            "Viel interessanter sind die Stellen am Boden die so eklig riechen.");

  AddDetail( ({"licht"}),
	    "Die Sonne scheint draussen und erhellt den Tunnel hier drinnen ein wenig.");

  AddDetail( ({"ruecken"}),
	    "Du fuehlst Dich hier nicht wohl. Dir laeuft es eiskalt den Ruecken runter.");

  AddDetail( ({"norden","tunnelende"}),
	    "Im Norden endet der Tunnel und ein Wald scheint direkt am Tunnelende zu beginnen. ");
  
  AddDetail( ({"wald"}),
	    "Der Wald scheint direkt hinter dem Tunnel zu beginnen. Du erkennst einige Baeume, "
            "Buesche und Straeucher. ");

  AddDetail( ({"wand","waende"}),
	    "Die Waende bestehen aus grob behauenen Fels. An ihnen kannst Du nichts entdecken. ");

  AddDetail( ({"decke","meter"}),
	    "Die Decke ist ein paar Meter ueber Dir und an ihr haengen tausende von Fledermaeusen. ");

  AddDetail( ({"stellen","stelle"}),
	    "Die Stellen am Boden sehen schleimig aus. Es scheinen Ausscheidungen von irgendwelchen Tieren "
            "hier in dem Tunnel sein. ");

  AddDetail( ({"ausscheidungen","tiere","tieren","sch","scheisse","sch..."}),
	    "Es handelt sich wirklich um Ausscheidungen von Tieren und zwar "
            "von tausenden Fledermaeusen, die ueber Dir an der Decke haengen, wie "
            "Du gerade bemerkst. Wie ekelig. ");

  AddDetail( ({"fledermaeuse","fledermaus","anzahl","niemand"}),
	    "Die Anzahl der Fledermaeuse ist kaum zu schaetzen, die an der Decke haengen. Es muessen tausende sein. "
            "Du solltest lieber ruhig sein und sie nicht wecken. ");

  AddDetail( ({"sueden"}),
	    "Sueden ist das Gegenteil von Norden. ");

  AddDetail( ({"gegenteil"}),
	    "Was ein Gegenteil ist solltest Du schon wissen, ansonsten "
            "solltest Du deine Intelligenz erhoehen. ");

  AddDetail( ({"intelligenz","tode"}),
	    "Jetzt hoer aber auf!!!! Es haben sich schon welche zu Tode untersucht.");

  AddDetail( ({"sonne"}),
	    "Die Sonne scheint draussen am Himmel zu scheinen und erhellt ein wenig "
	    "den Tunnel. ");

  AddDetail( ({"himmel"}),
	    "Den Himmel kannst Du natuerlich nicht sehen. Du bist in einem Tunnel. ");

  AddDetail( ({"baeume"}),
	    "Um was es sich ausserhalb des Tunnels fuer Baeume handelt kannst Du " 
            "nicht erkennen. Du siehst momentan nur ein paar Blaetter von den Baeumen. ");

  AddDetail( ({"buesche"}),
	   "Ein paar Buesche wachsen am Tunneleingang.");

  AddDetail( ({"pflanzen"}),
	   "Geh hin und schau Dich um.");

  AddDetail( ({"tunneleingang","tunnelausgang","betrachters","sichtweise","betrachter"}),
	   "Ob es sich um den Tunneleingang oder Tunnelausgang handelt kommt auf die Sichtweise des "
           "Betrachters an.");

  AddDetail( ({"straeucher"}),
	   "Ein paar Straeucher wachsen ausserhalb des Tunnels. Mehr kannst Du von hier aus nicht "
           "erkennen.");

  AddDetail( ({"blaetter"}),
	   "Die Blaetter sind gruen. Um mehr zu erkennen, musst Du schon raus gehen.");

  AddDetail( ({"fels"}),
	   "Der Fels im Tunnel ist kahl und scheint sehr hart zu sein.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht hier im Tunnel einfach eklig. Etwas scheint hier richtig zu stinken.");  
 
  AddSmell( ({"etwas"}),
	   "Der eklige Gestank kommt von einigen Stellen am Boden.");

  AddSmell( ({"gestank","stellen"}),
	   "Du schnupperst an den Stellen und es scheint wirklich Sch... zu sein. Von wem die wohl stammt.");
  
  AddSmell( ({"sch","scheisse"}),
	   "Du bist einfach wiederwaertig.");

  AddSound(DEFAULT_SOUND, "Es ist absolut still hier im Tunnel. Nur ab und zu hoerst Du ein Tropfen.");

  AddSound( ({"tropfen"}),
	   "Es fallen ab und zu ein paar Tropfen von der Decke. Es ist hier halt ein wenig feucht.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "zen49");
AddExit("norden", ROOM "zen47");

AddCmd( ({"weck", "wecke" }), "wecken" );

}
int wecken (string str)
{
  object fledermaus;
  notify_fail ("Wen moechtest Du wecken?\n");

  if(!str) return 0;  
  if(!(str == "fledermaus","fledermaeuse" )) return 0;
  if (present("CHIVASFLEDERMAUS",TO) || !fledermausda)

  {
    write(BS("Die Fledermaeuse ignorieren Dich und schlafen weiter."));
    return -1;
  }
  write(BS("Du gibst einen Schrei von Dir und weckst wirklich eine Fledermaus auf.\n"));
  fledermausda=0;
  fledermaus = clone_object (NPC "fledermaus.lpc" );
  fledermaus->move(TO,M_GO|M_NOCHECK,"fliegt von der Decke und landet vor Dir auf dem Boden.");
  return 1;
}
   
