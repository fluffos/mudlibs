// von Chivas
// 11.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/pub";

#include "../def.h"
#include <pub.h>


void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp(P_INT_SHORT,"In der Kneipe 'Zum Baumriesen'");
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "garlog");
  SetProp(P_PUBKEEPER_NAME, "garlog");
  SetProp(P_PUBMSG_NOKEEPER, "Garlog ist leider nicht hier.\n");
  SetProp(P_PUBMSG_NOENEMY, BS(
      "Du bist gerade in einem verbissen Kampf mit Garlog. Kein Wunder, "
      "dass er Dich nicht bedient."));
  SetProp(P_PUBMSG_NOINVITE, BS(
      "Garlog kaempft. Da hat er wahrhaft andere Sorgen als Kunden."));
  SetProp(P_PUBMSG_FIGHTING, "Garlog kaempft gerade.\n");

  AddDrink("Zentaurenbraeu", ({"bier","braeu","zentaurenbraeu"}),
           500, 55, 10, 6,
           ({"Garlog laechelt und bringt Dir einen Humpen Zentaurenbraeu.\n",
             "&& trinkt einen Humpen Zentaurenbraeu.\n"}));

  AddDrink("Whisky", ({"whisky"}),
            220, 28, 11, 1,
           ({"Garlog bringt Dir ein Glas Whisky.\n"
            +"ROECHEL!!!! Der hat es in sich!!\n",
             "&& trinkt ein Glas Whisky japst nach Luft.\n"}));

  AddDrink("Hopfenbluetentee", ({"hopfenbluetentee","bluetentee","tee"}),
            150, 15, 0, 5,
           ({"Garlog bringt Dir eine Tasse Hopfenbluetentee.\n"
            +"Der schmeckt ja richtig lecker!\n",
             "&& trinkt eine Tasse Hopfenbluetentee und ist enzueckt.\n"}));

  AddFood("Nudelsuppe", ({"suppe", "nudelsuppe"}), 200, 40, 17,
           ({"Garlog bringt Dir eine leckere Nudelsuppe. "
            +"\nHmmmm, die ist lecker und sehr deftig.\n",
             "&& isst eine Nudelsuppe.\n"}));
  AddFood("Ein leckeres Haehnchen", ({"haehnchen"}), 250, 30, 10,
           ({"Garlog bringt Dir ein leckeres Haehnchen!\n"
            +BS("Wow, die Haut ist sehr knusprig. Es ist aussergewoehnlich "
                "lecker."),
             "&& isst gierig ein lecker aussehendes Haehnchen!\n"}));

// ----------  Details  ---------------------

  AddDetail( ({"boden"}),
	    "Der Boden ist mit Reisig bedeckt. Unter dem Reisig kann man Holz "
	    "erkennen.");

  AddDetail( ({"holz","wunder"}),
	    "Was fuer ein Wunder. In einem Baum findet man Holz. Du bist fasziniert.");

  AddDetail( ({"reisig"}),
	    "Ganz normaler Reisig.");

  AddDetail( ({"baenke","bank"}),
	    "An der Wand stehen Baenke auf denen Gaeste sitzen und sich unterhalten.");
  
  AddDetail( ({"bier","zentaurenbraeu"}),
	    "Hier kannst Du auch Bier bestellen, das beruehmte Zentaurenbraeu.");

  AddDetail( ({"baumriesen","riesen","baum","baumriese"}),
	    "Du befindest Dich in einem. Dieser Baumriese ist eine Kneipe.");

  AddDetail( ({"kneipe","zum"}),
	    "Du befindest Dich in der Kneipe 'Zum Baumriesen'.");

  AddDetail( ({"menue"}),
	    "Das Menue haengt an der Wand. Tipp 'menue' und Du siehst was Du bestellen "
            "kannst.");

  AddDetail( ({"tuer","sonne","strasse"}),
	    "Die Tuer auf die Strasse ist offen. Draussen scheint die Sonne zu scheinen.");

  AddDetail( ({"wirt"}),
	    "Der Wirt dieser Kneipe steht vor Dir oder ist gerade nicht da.");

  AddDetail( ({"wand","waende"}),
	    "An den Waenden haengt ein Menue und Fackeln in ihren Halterungen, die "
            "den Raum erhellen. Ausserdem stehen Baenke an der Wand.");

  AddDetail( ({"raum"}),
	    "Der Raum ist eine Kneipe. Du stehst an der Theke.");

  AddDetail( ({"fackel","fackeln"}),
	    "Die Fackeln haengen in Halterungen an der Wand und erhellen die Kneipe ein wenig.");

  AddDetail( ({"halterung","halterungen","eisen"}),
	    "Die Halterungen in denen die Fackeln haengen, bestehen aus Eisen und sind sehr haesslich.");

  AddDetail( ({"decke","spinnenweben"}),
	    "An der Decke haengen ein paar Spinnenweben, ansonsten sieht man an ihr "
            "nichts interessantes.");
  
  AddDetail( ({"theke","fleck"}),
	    "Die Theke ist sehr lang und absolut auf hochglanz poliert. Du erkennst nicht "
            "einen einzigen Fleck.");

  AddDetail( ({"tische","tisch"}),
	    "An den Tischen sitzen viele Gaeste und unterhalten sich.");

  AddDetail( ({"stuehle","stuhl"}),
	    "Auf den Stuehlen an den Tischen sitzen die Gaeste oder stehen an der Theke.");

  AddDetail( ({"gaeste","elfen","zwergen","zwerge","menschen"}),
	    "Du siehst Elfen, Zwergen, Menschen und natuerlich auch Zentauren.");

  AddDetail( ({"stadt","roch","adan","roch adan"}),
	    "Roch Adan ist die Stadt der Zentauren.");
  
  AddDetail( ({"zentauren","mensch","pferd"}),
	    "Zentauren sind halb Mensch und halb Pferd. Du befindest Dich in ihrer Stadt.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Alkohol, gebratenen Haehnchen und Nudelsuppe.");  
 
  AddSmell( ({"alkohol","geruch"}),
	   "Der Geruch von Alkohol macht Dich schon fast besoffen.");

  AddSmell( ({"haehnchen","wasser","mund"}),
	   "Die gebratenen Haehnchen riechen sehr lecker. Dir laeuft das Wasser im Mund zusammen.");

  AddSmell( ({"nudelsuppe","suppe","hunger"}),
	   "Die Nudelsuppe riecht deftig und Du bekommst Hunger.");

  AddSound(DEFAULT_SOUND, "Du hoerst die anderen Gaeste, wie sie miteinander reden. Ausserdem "
                          "hoerst Du wie Geschirr abgewaschen wird.");

  AddSound( ({"gaeste"}),
	   "Die Gaeste zu belauschen waere nicht nett. Schaem Dich.");
  
  AddSound( ({"geschirr","geklapper"}),
		"Du hoerst das Geklapper von Geschirr wie es abgewaschen wird.");


// ----------- Details Ende -------------------

  AddExit("osten", ROOM "zen20");

  AddItem(NPC "garlog", REFRESH_DESTRUCT);
}

string _query_int_long()
{
  string txt;

  txt = "Du bist hier in einem Baumriesen, der als Kneipe zurecht gemacht ist. "
        "Es gibt eine grosse Theke an der einige Zentauren ein Bier trinken. "
        "Es stehen auch einige Tische, Baenke und Stuehle herum fuer Gaeste, "
        "die keine Zentauren sind. Gleich neben der Tuer haengt ein "
        "Menue an der Wand, das Du mit 'menue' lesen kannst. ";

  if(QueryProp(P_PUBKEEPER_ID))
  {
    if(!present(QueryProp(P_PUBKEEPER_ID)))
    {
      txt += "Seltsamerweise ist offenbar gerade niemand hier der Dich "
        "bedienen koennte.";
    }
    else
    {
      txt += "Der Wirt steht hinter der Theke und laechelt Dich "
        "freundlich an.";
    }
  }

  return BS(txt);
}
