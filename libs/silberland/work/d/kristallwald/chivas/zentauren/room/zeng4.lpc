// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Gasse in Roch Adan");
  SetProp( P_INT_LONG,
	"Du befindest Dich in einer kleinen Gasse in Roch Adan. Sie ist ein "
        "wenig ruhiger als der ganze Trubel auf der Strasse rund um den Park. "
        "Ueber dem Eingang zu einem Baumriesen im Norden haengt ein schaebiges "
        "altes Schild. Es scheint irgend eine Art von Geschaeft zu sein." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"gasse"}), 
            "Dies ist eine ganz normale Gasse in Roch Adan. Sie unterscheidet "
            "sich nur in ihrere Groesse von einer Strasse. Sie ist recht klein "
            "und duester, da durch die dicht stehenden Baumriesen nicht viel "
            "Licht in die Gasse faellt.");

  AddDetail( ({"roch adan","roch","adan","stadt"}),
	    "Roch Adan ist die Stadt in der Du Dich momentan befindest.");

  AddDetail( ({"trubel","strasse","park"}),
	    "Auf der Strasse im Westen herrscht der uebliche Trubel. Die "
            "Strasse fuehrt um den Park herum zum Palast der Zentauren.");

  AddDetail( ({"boden"}),
	    "Am Boden erkennst Du Gras und ein paar Steinchen.");
  
  AddDetail( ({"eingang","norden"}),
	    "Der Eingang zu dem Baumriesen im Norden sieht ein wenig duester "
            "aus. Es ist sicher kein normaler Laden, der sich hier in der "
            "Gasse verbirgt.");

  AddDetail( ({"schild"}), 
            "Du kannst es lesen.");

  AddDetail( ({"art","geschaeft","laden"}),
	    "Was fuer eine Art von Geschaeft es ist kannst Du nicht genau "
            "erkennen, da die Schaufenster mit grossen Vorhaengen verdeckt "
            "sind.");

  AddDetail( ({"schaufenster","fenster","fensters"}),
	    "Die Schaufenstern sind schmutzig und mit dicken Vorhaengen "
            "verdeckt.");

  AddDetail( ({"vorhaengen","vorhaenge"}),
	    "Durch die Vorhaenge kannst Du nicht sehen, was sich in der "
            "Auslage des Fensters befindet. Hoechst wahrscheinlich koenntest "
            "Du durch die schmutzigen Fenster sowieso nichts erkennen.");
  
  AddDetail( ({"baumriesen","baumriese","riese"}),
	    "Die Baumriesen in der Gasse stehen sehr dicht. Ueber dem Eingang "
            "eines Baumriesen haengt ein altes Schild.");

  AddDetail( ({"groesse"}), 
            "Die Gasse ist schmaler als eine Strasse.");

  AddDetail( ({"licht"}),
	    "Durch die Baumriesen faellt nicht sehr viel Licht in die Gasse, "
            "obwohl die Sonne fast senkrecht am Himmel steht.");

  AddDetail( ({"sonne","schatten"}),
	    "Du siehst sie momentan nicht, da Du im Schatten der Baumriesen "
            "stehst.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen blau. Es sind nur einige Wolken zu sehen.");
  
  AddDetail( ({"wolken"}),
	    "Die Wolken sind nicht sehr zahlreich und schoen weiss.");

  AddDetail( ({"palast","stueck","nordwesten"}), 
            "Der Palast ist noch ein Stueck weit weg. Da musst Du schon "
            "weiter nach Nordwesten gehen.");

  AddDetail( ({"zentauren","volk"}),
	    "Die Zentauren sind ein stolzes Volk. Du befindest Dich momentan "
            "in ihrer Stadt.");

  AddDetail( ({"gras"}),
	    "Das Gras ist ein wenig niedergetrampelt. Ein paar Hufabdruecke "
            "kannst Du auch erkennen.");

  AddDetail( ({"steinchen","steine","stein"}),
	    "Die Steine sind sehr gewoehnlich und uninteressant.");
  
  AddDetail( ({"hufabdruecke","abdruecke"}),
	    "Die Hufabdruecke stammen sicher von den Zentauren, da Du noch "
            "keine Pferde hier gesehen hast.");

  AddDetail( ({"pferde"}), 
            "Pferde gibt es hier sicher nicht.");

  AddDetail( ({"auslage"}),
	    "Da musst Du wohl den Laden betreten um zu sehen, was in der "
            "Auslage liegt.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Gras, welches am Boden waechst.");  
 
  AddSmell( ({"gras"}),
	   "Es duftet ein wenig.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Trubel der Strasse im Westen.");

  AddSound( ({"trubel","strasse","westen","stadt","laerm"}),
	   "Es herrscht der uebliche Laerm einer Stadt.");
  
  AddReadDetail( ({"schild"}),
		"+---------------------------------------+\n"
                "|                                       |\n"
                "| Der ungewoehnliche und geheimnisvolle |\n"
                "|                Laden                  |\n"
                "|                                       |\n"
                "+---------------------------------------+\n");


//-----Details Ende-----
  
AddExit("osten", ROOM "zentor3");
AddExit("westen", ROOM "zen29");
AddExit("norden", ROOM "zennpc3");

}  
   
