

#include "../def.h"

inherit "std/room"; 

#define AN 1
#define AUS 0

int feuer;

void create()
{
  ::create();

  feuer = AN;

  SetProp(P_INT_SHORT, "In einer Schmiede");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1); 
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 50, ENV_TERRAIN: TT_HOUSE]) );

//-----Details Anfang-----

  AddDetail( ({"boden"}) ,
    "Der Boden ist voller Russ. In einer Ecke liegt ein grosser Haufen Kohle, die der Schmied anscheinend "
    "fuer das Feuer benoetigt.");

  AddDetail( ({"russ"}) ,
    "Der Russ ist schwarz.");

  AddDetail( ({"decke"}) ,
    "Die Decke ist mit Russ vom Feuer bedeckt.");

  AddDetail( ({"wand","waende"}) ,
    "An den Waenden haengen verschiedene Werkzeuge und Hufeisen.");

  AddDetail( ({"mitte"}) ,
    "In der Mitte der Schmiede steht eine grosse Esse.");

  AddDetail( ({"schmiede"}) ,
    QueryProp(P_INT_LONG));

  AddDetail( ({"werkzeuge","werkzeug"}), 
            "Die Werkzeuge sind Zangen und Hammer, die der Schmied anscheinend fuer seine Arbeit braucht.");

  AddDetail( ({"amboss","sachen"}),
	    "Auf dem grossen Amboss beim Feuer entstehen viele interessante Sachen aus Metall.");

  AddDetail( ({"arbeit"}),
	    "Mit sowas kennst Du Dich nicht aus.");

  AddDetail( ({"zangen"}),
	    "Mit den Zangen haelt man anscheinend das zu bearbeitende Metall fest, wenn es glueht.");

  AddDetail( ({"hammer","hammern","form"}),
	    "Mit den Hammern bringt man das Metall in die gewuenschte Form.");

  AddDetail( ({"hufeisen"}), 
            "Die Hufeisen sind sicher fuer die Zentauren, da Du hier noch kein Pferd gesehen hast.");

  AddDetail( ({"schmied","marlog"}),
	    "Der Schmied hier heisst Marlog.");

  AddDetail( ({"zentauren","wesen","mensch","unterkoerper","pferdes"}),
	    "Die Zentauren sind magische Wesen. Sie sind halb Mensch und haben "
	    "den Unterkoerper eines Pferdes.");

  AddDetail( ({"pferd","pferde"}),
	    "Ein Pferd hast Du in Roch Adan noch nicht gesehen. Die Zentauren "
	    "brauchen ja auch keine Pferde.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Du befindest Dich in der Schmiede von Roch Adan, der Stadt der "
	    "Zentauren.");

  AddDetail( ({"haufen","kohle","ecke","kohlen"}),
	    "In der Ecke ist ein Haufen Kohle, die der Schmied sicher zu "
	    "seiner Arbeit brauch. Darunter kann man sicher Etwas verstecken.");

  AddDetail( ({"etwas"}),
	    "Falls sich Etwas unter den Kohlen befindet, dann musst Du schon "
	    "in der Kohle wuehlen um es zu finden.");

  AddDetail( ({"nase"}),
	    "Du hast eine und sie wird laenger wenn Du luegst.");

  AddDetail( ({"hitze"}),
	    "Es herrscht hier eine grosse Hitze, wenn das Feuer an ist.");

  AddDetail( ({"glut"}),
	    "Die Glut glueht rot in der Esse.");

  AddDetail( ({"flammen"}),
	    "Die Flammen lodern in der Esse.");

  AddDetail( ({"metall","eisen","bronze","metalle","bearbeiten"}),
	    "Hier werden viele Metalle verarbeitet. Eisen, Bronze und noch vieles mehr.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Rauch in der Schmiede.");  
 
  AddSmell( ({"rauch","nase"}),
	   "Der Rauch sticht in Deiner Nase.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Feuer knistern.");

  AddSound( ({"feuer","knistern"}),
	   "knister knister knister");

  AddSpecialDetail( ({"feuer","esse"}), "detail_feuer");

//-----Details Ende-----

  AddCmd( ({"loesche","loesch"})      , "cmd_loeschen");
  AddCmd( ({"zuend","zuende"})        , "cmd_zuenden");
  AddCmd( ({"wuehl","wuehle"})        , "wuehlen");

  AddItem(NPC "marlog", REFRESH_DESTRUCT);

  AddExit("westen", ROOM "zen24");
}

string detail_feuer(string str)
{
  string s;

  if(feuer == AN)
  {
    s = "Hell lodern die Flammen in der Esse und verbreiten eine ziemliche "
        "Hitze. ";
  }
  else
  {
    s = "Nur dunkelrot glimmt die Glut in der Esse. ";
  }

  return BS(s);
}

int cmd_loeschen(string str)
{
  notify_fail("Was moechtest Du loeschen?\n"); 

  if(!str || str == "") return 0; 

  if(!(str == "feuer"         ||            
       str == "esse"          )) return 0;  

  if(feuer == AUS)
  {
    tell_object(TP,"Aber das Feuer ist doch schon aus!\n"); 

    return -1; 
  }

  tell_object(TP,"Du nimmst einen Eimer Wasser und loeschst das Feuer.\n");

  TO->Message(BS(TP->Name()+" nimmt einen Eimer Wasser und loescht das "
              "Feuer."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  feuer = AUS;
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );

  return 1; 
}

int cmd_zuenden(string str)
{

  notify_fail("Was moechtest Du anzuenden?\n");

  if(!str || str == "") return 0;
  if(!(str == "feuer"         ||
       str == "esse"          ||
       str == "feuer an"      ||
       str == "esse an"       )) return 0;

  if(feuer == AN)
  {
    tell_object(TP,"Aber das Feuer brennt doch schon!\n");

    return -1; 
  }

  tell_object(TP,"Du pustest in die Glut und zuendest das Feuer wieder an.\n");

  TO->Message(BS(TP->Name()+" pustet in die Glut und zuendet das Feuer "
              "wieder an."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  feuer = AN;
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 50, ENV_TERRAIN: TT_HOUSE]) );

  return 1;
}

int wuehlen(string str)
{
 object stab3;
 notify_fail("Worin willst Du wuehlen?\n");

 if(!str || str == "") return 0;
 if(!(str == "in haufen" ||
      str == "in kohle" ||
      str == "in haufen kohle" )) return 0;
 

  if(!present("astroinvis", TP) && !present("dragoninvis2", TP)){
	  
  write(BS("Du bist enttaeuscht. Momentan findest Du hier leider nichts. Du bist aber schoen dreckig.\n"));
 
  say(TPN+" ist enttaeuscht und dreckig.\n");
  return -1;
  }
  if(present("stab3", TP)){
	  
  write(BS("Du findest nichts mehr. Du hast alles was Du brauchst.\n"));
 
  say(TPN+" findet im Haufen nichts mehr.\n");
  return -1;
  }

  write(BS("Du wuehlst in dem Haufen Kohle und machst Dich richtig schoen dreckig. "
	  "Als Du tiefer wuehlst, findest Du ploetzlich einen Stab, den Du sofort einsteckst. \n"));
 
  say(TPN+" scheint was am Boden entdeckt zu haben und steckt es ein.\n");
  clone_object(OBJ "stab3")->move(TP, M_NOCHECK);
  return 1;
}
string _query_int_long()
{
  string txt;

    if ( feuer == AN )
    {
      txt = "Du befindest Dich in einer Schmiede. In der Mitte brennt ein "
            "grosses Feuer. An der Wand haengen alle moeglichen Werkzeuge, die "
            "anscheinend zum Bearbeiten von Metall gebraucht werden. Auch "
            "einige Hufeisen haengen an der Wand, die anscheinend fuer die "
            "Zentauren sind. Neben dem Feuer steht ein Amboss, auf dem der "
            "Schmied die gewuenschten Sachen schmiedet.";
    }
    else
    {
      txt = "Du befindest Dich in einer Schmiede. In der Mitte brennt "
            "normalerweise ein grosses Feuer, dass jedoch von irgend jemand "
            "geloescht wurde. An der Wand haengen alle moeglichen Werkzeuge, "
            "die anscheinend zum Bearbeiten von Metall gebraucht werden. Auch "
            "einige Hufeisen haengen an der Wand, die anscheinend fuer die "
            "Zentauren sind. Neben dem Feuer steht ein Amboss, auf dem der "
            "Schmied die gewuenschten Sachen schmiedet.";
    }
  return BS(txt);
}

