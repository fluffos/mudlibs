// von Chivas
// 07.6.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl;

void create()
	
{
  ::create();

  anzahl=1;

  SetProp( P_INT_SHORT, "Auf einer Wiese");
  SetProp( P_INT_LONG,
        "Die Blumenwiese, auf der Du stehst, blueht in voller Pracht, die "
        "Sonne scheint und einige Woelkchen ziehen am Himmel langsam entlang. "
        "Der Weg schlaengelt sich weiter unbeirrbar von Sueden nach Norden und "
        "das Gras auf dem Du gehst ist schoen weich. Am Wegrand wurde ein Haufen "
        "Steine aufgestapelt. Was ist das bloss?" );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"boden"}), 
            "Der Weg ist mit Gras und Blumen bedeckt. Am Wegrand ist ein Haufen "
            "Steine aufgestapelt. Es sieht nicht so aus, als ob der Haufen "
            "natuerlichen Ursprungs ist. Irgendwer muss ihn ihn aufgestapelt "
            "haben, aber aus was fuer einem Grund?.");

  AddDetail( ({"wiese","blumenwiese","blumenpracht","pracht"}),
	    "Die Wiese strahlt in allen Farben. Unzaehlige Blumen wachsen auf ihr "
            "und eine grosse Anzahl verschiedener Graeser, die auch alle bluehen. "
            "Das einzige was nicht natuerlich wirkt, ist ein kleiner Steinhaufen "
            "am Wegrand.");

  AddDetail( ({"weg","spass"}),
	    "Der Weg schlaengelt sich durch die Blumenpracht der Wiese. Es macht "
            "Spass und ist sehr beruhigend, hier spazieren zu gehen. Am Wegrand ist "
            "ein Steinhaufen.");

  AddDetail( ({"wegrand"}), 
            "Am Wegrand ist ein Haufen Steine zwischen den Blumen und Graesern "
            "aufgestapelt worden. Man sollte ihn vielleicht naeher untersuchen.");

  AddDetail( ({"sonne"}),
	    "Die Sonne steht senkrecht am Himmel und waermt Dich. Du fuehlst Dich "
            "pudelwohl. Ach koennte doch das ganze Silberland so idyllisch, friedlich "
            "und ruhig sein.");

  AddDetail( ({"silberland"}),
	    "Du befindest Dich im Silberland. Da Du schon bis hier her vorgedrungen "
            "bist, muesstest Du das eigentlich wissen."); 

  AddDetail( ({"woelkchen","wolken","gefahr"}),
	    "Die Wolken, ziehen von leichtem Wind angetrieben, am Himmel dahin. Sie "
            "sind weiss, also besteht keine Gefahr, dass es regnet."); 
  
  AddDetail( ({"himmel","tag"}), 
            "Der Himmel ist strahlend blau, die Sonne steht fast senkrecht und "
            "einige Woelkchen ziehen am Himmel entlang. Es ist einfach ein "
            "wunderschoener Tag. Einige Voegel siehst man hoch am Himmel ihre "
            "Runden drehen.");

  AddDetail( ({"gras","graeser","arten","anzahl"}),
	    "Das Gras ist gruen und es ist sehr angenehm, auf ihm zu gehen, da es "
            "sehr weich ist. Die verschiedenen Arten der Graeser kennst Du nicht, "
            "sie sehen aber schoen aus, da einige von ihnen bluehen.");

  AddDetail( ({"blumen"}),
	    "Auf der Wiese wachsen die verschiedensten Blumen. Man sieht einige "
            "Narzissen, Tulpen. Sonnenblumen, Gaensebluemchen. Auch eine Rose "
            "steht auf der Wiese.");

  AddDetail( ({"haufen","steine","steinhaufen","ursprung","grund"}), 
            "Der Haufen Steine scheint eine Art Grab zu sein. Auf einem der Steine "
            "sind Zeichen eingraviert worden.");

  AddDetail( ({"zeichen"}),
	    "Du kannst die Zeichen leider nicht entziffern, aber vielleicht "
            "solltest Du doch mal einige Steine beiseite legen, um zu sehen "
            "was sich darunter befindet.");

  AddDetail( ({"grab","art","neugier"}),
	    "Es scheint eine Art Grab zu sein. Deine Neugier ist so gross, "
            "dass Du ueberlegst, ob es sich nicht lohnen wuerde die Steine "
            "beiseite zu legen und zu gucken, was sich in dem Grab befindet."); 

  AddSpecialDetail( ({ "schaedel" }), "schaedel" );
  
  AddSpecialDetail( ({ "riss" }), "riss" );
  AddSpecialDetail( ({ "toten" }), "schwert" );
  AddSpecialDetail( ({ "schrott" }), "schwert" );

  AddDetail( ({"narzissen","gelb"}),
	    "Die Narzissen bluehen in einem strahlenden Gelb auf der Wiese. Sie "
            "sind schoen anzusehen.");

  AddDetail( ({"sonnenblumen"}), 
            "Die Sonnenblumen sind hoch gewachsen und einige Bienen sammeln "
            "Nektar an ihnen.");

  AddDetail( ({"tulpen","gelbe tulpen","rote tulpen","blaue tulpen","rote","blaue",
               "gelbe","farben"}),
	    "Die Tulpen habe verschiedene Farben. Es gibt rote, blaue und gelbe "
            "Tulpen.");

  AddDetail( ({"rose"}),
	    "Eine einzige wunderschoene rote Rose steht auf der Wiese. Dir "
            "gefaellt die Rose so sehr, dass Du sie am liebsten pfluecken wuerdest."); 
  
  AddDetail( ({"gaensebluemchen"}), 
            "Kleine Gaensebluemchen stehen im Gras und zwischen den Blumen und "
            "sehen niedlich aus.");

  AddDetail( ({"bienen","arbeit"}),
	    "Die Bienen schwirren durch die Luft und gehen ihrer fleissigen Arbeit "
            "nach.");

  AddDetail( ({"hummeln","ueberfluss"}),
	    "Dicke fette Hummeln surren ueber die Wiese auf der Suche nach Nektar. "
            "Diesen werden sie hier im Ueberfluss finden.");

  AddDetail( ({"nektar"}), 
            "Die Bienen und Hummeln suchen in den Blumen und den bluehenden "
            "Graesern auf der Wiese nach Nektar.");

  AddDetail( ({"voegel","greifvoegel","vogel","greifvogel","runden"}), 
            "Hoch am Himmel ziehen einige Voegel ihre Runden. Du kannst leider "
            "nicht genau ausmachen, um was fuer Voegel es sich handelt. Es "
            "koennten Greifvoegel sein, die unten auf der Wiese nach Maeusen "
            "oder anderen kleinen Tieren suchen.");

  AddDetail( ({"sueden"}),
	    "Das Gegenteil von Norden. Im Sueden geht die Wiese weiter und "
            "dahinter in einen Wald.");

  AddDetail( ({"norden"}),
	    "Das Gegenteil von Sueden. Im Norden geht die Wiese weiter und wie "
            "es aussieht, danach in einen finsteren Wald"); 

  AddDetail( ({"wald"}), 
            "Hinter der Wiese scheint ein Wald anzufangen sowohl im Sueden, "
            "als auch im Norden.");

  AddSpecialDetail( ({ "knochen" }), "knochen" );

  AddSpecialDetail( ({ "schwert" }), "schwert" );

  AddDetail( ({"zentauren","zentaur"}),
	    "Zentauren sind magische Geschoepfe, vom Kopf bis zur Huefte Menschen, "
            "darunter jedoch mit Pferdekoerper und -beinen versehen. Man erzaehlt "
            "sich ueber sie, dass sie die Zukunft in den Bewegungen der Planeten "
            "am Himmel lesen koennen. ");

  AddDetail( ({"wind","lueftchen"}),
	    "Es weht ein leichter Wind, der die Wolken am Himmel langsam vor sich "
            "hertreibt. Man muesste eher von einem Lueftchen sprechen, als von Wind.");

  AddDetail( ({"hufeisen"}), 
            "Das Hufeisen scheint von dem hier begrabenen Zentauren zu stammen. "
            "Du legst es wieder zurueck, da Du es nicht gebrauchen kannst. "
            "Schliesslich bist Du kein Zentaur.");

  AddDetail( ({"schimmern","etwas"}),
	    "Das Schimmern kommt von einem alten Hufeisen, welches der Besitzer "
            "der Knochen anscheinend zu besseren Zeiten getragen hat.");

  AddDetail( ({"maus","maeuse","tieren","tiere","tier","tieren","suche","deckung"}),
	    "Einige Maeuse huschen zwischen den Graesern und Blumen hin und her "
            "auf der Suche nach Deckung vor den Greifvoegeln am Himmel."); 

  AddDetail( ({"gegenteil","beste"}),
	    "Du untersuchst wirklich alles. Du bist der/die Beste."); 
  
  AddSmell(DEFAULT_SMELL, "Es liegt ein Duft von Blumen und Graesern in der Luft.");  
 
  AddSmell( ({"blumen","parfuemerie"}),
	   "Die Blumen riechen recht suesslich, fast wie in einer Parfuemerie.");

  AddSmell( ({"graesern","duft"}),
	   "Die Graeser riechen ein wenig bitterer als die Blumen. Trotzdem "
           "ein interessanter Duft.");

  AddSmell( ({"luft"}),
	   "Die Luft ist vom Duft der Blumen und Graeser getraenkt.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Zwitschern von Voegeln und ab und zu "
                          "ein Rascheln am Boden.");

  AddSound( ({"zwitschern","voegeln","voegel","zwitscher"}),
	   "ZWITSCHER, ZWITSCHER, ZWITSCHER");
  
  AddSound( ({"rascheln"}),
		"Es kommt anscheinend von Maeusen und anderen kleinen Tieren, "
                "die durch das Gras laufen.");

//-----Details Ende-----
  
AddExit("sueden", ROOM "zen6");
AddExit("norden", ROOM "zen8");

AddCmd( ({"lege", "leg","raeume","raeum" }), "legen" );
AddCmd( ({"pflueck", "pfluecke" }), "pfluecken" );

}
int legen(string str)
{
   notify_fail("Was moechtest Du beiseite legen?\n");
   if ( member( ({ "steine weg", "steine beiseite" }),str) != -1) 
  {
   if ( anzahl )
    {
    write(BS( "Du legst die Steine vom Haufen beiseite und entdeckst einen "
           "Schaedel, einige Knochen und ein Schwert.\n"));
    say( TPN+" raeumt ein paar Steine beiseite.\n");
    anzahl--;
    return 1;
    }
    else
    {
    write(BS( "Du entdeckst, dass die Steine schon beiseite geraeumt wurden. Du "
           "entdeckst einen Schaedel, einige Knochen und ein Schwert.\n"));
    say( TPN+" probiert etwas, dass gar nicht mehr noetig ist.\n");
    return 1;   
    }
  }
}
int pfluecken(string str)
{
   notify_fail("Was moechtest Du pfluecken?\n");
   if ( member( ({ "rose" }),str) != -1) 
  {
    write(BS("Du pflueckst die Rose und riechst an ihr, als ploetzlich "
             "eine Biene aus der Bluete krabbelt und Dir in die Nase "
             "sticht.\n"));
    say( TPN+" riecht an einer Rose und wird von einer Biene gestochen.\n");
    TP->SetProp(P_PARALYZED, ([
                PARALYZE_TIME: 10,
                PARALYZE_MSG: "Du liegst am Boden und kannst Dich nicht ruehren Du hast einen "
                              "allergischen Schock.\n",
                PARALYZE_END: "Als der Schock langsam nachlaesst beschliesst Du Deine Nase "
                              "nicht mehr ueberall rein zu stecken.\n"]) );	
      call_out("fall1",4);
    return 1;
  }
 }
void fall1()
{
  write(BS( "Der Schmerz von dem Stich tut richtig weh, aber dies ist "
            "Dein kleinstes Problem. Du bist allergisch gegen Bienenstiche "
            "und kriegst einen allergischen Schock.\n"));
}
string schaedel(string key)
{
    if ( anzahl )
    {
    return(BS("Da musst Du wohl noch ein wenig forschen.\n"));
    }
    else
    {
    return(BS("Der Schaedel scheint zu einem Menschen zu gehoeren. Die restlichen "
            "Knochen scheinen eher auf ein Pferd hin zu deuten. Also scheint ein "
            "Zentaur hier begraben worden zu sein. Der Schaedel weisst einen "
            "riesigen Riss auf."));
    }
}
string knochen(string key)
{
    if ( anzahl )
    {
    return(BS("Da musst Du wohl noch ein wenig forschen.\n"));
    }
    else
    {
    return(BS("Die Knochen scheinen schon laenger hier zu liegen. Von den Knochen "
            "her zu urteilen, scheint es sich um die Knochen eines Zentauren zu "
            "handeln, der hier bestattet wurde. Unter den Knochen scheint Etwas "
            "zu schimmern."));
    }
}
string schwert(string key)
{
    if ( anzahl )
    {
    return(BS("Da musst Du wohl noch ein wenig forschen.\n"));
    }
    else
    {
    return(BS("Das Schwert ist alt und rostig und scheint keinen grossen Wert zu "
            "haben, also laesst Du es liegen. Du willst ja auch keinen Toten "
            "bestehlen, wenn er nur Schrott bei sich hat."));
    }
}
string riss(string key)
{
    if ( anzahl )
    {
    return(BS("Da musst Du wohl noch ein wenig forschen.\n"));
    }
    else
    {
    return(BS("Der Riss am Schaedel ist riesig. Es sieht so aus, als ob der Besitzer "
            "des Schaedels einen toedlichen Schlag mit einer grossen Keule oder "
            "Axt bekommen hat."));
    }
}
  
