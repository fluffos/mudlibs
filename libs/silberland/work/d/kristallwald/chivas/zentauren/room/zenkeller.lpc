inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Keller");
  SetProp( P_INT_LONG,
        "Hier im Keller des Baumriesen ist es recht kuehl und feucht. Einfach kein "
        "schoener Ort um hier laenger zu verweilen. Du erkennst an den Waenden ein paar "
	"alte zerbrechliche Regale. Ansonsten scheint der Keller leer zu sein. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 8, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 0 );
  
//-----Details Anfang-----

  AddDetail( ({"keller"}), 
             QueryProp(P_INT_LONG));

  AddDetail( ({"baumriesen","baumriese","baum","riese","baumriesens"}),
	    "Hier bist Du genau unter einem Baumriesen. Dies erkennst Du an den Wurzeln, die "
            "von der Decke haengen und die Du an den Waenden sehen kannst.");

  AddDetail( ({"ort"}),
	    "Ein Ort wie Mauritius waere jetzt wirklich schoener.");

  AddDetail( ({"waenden","waende","wand"}), 
            "An den Waenden siehst Du grosse Wurzeln und ein paar alte Regale.");

  AddDetail( ({"regale","regal"}),
	    "Auf den Regalen stehen ein paar Flaschen.");

  AddDetail( ({"boden"}),
	    "Der Boden ist erdig und feucht."); 
  
  AddDetail( ({"himmel"}), 
            "Du untersuchst auch wirklich alles, obwohl es recht unwahrscheinlich ist, dass "
            "Du hier den Himmel sehen kannst.");

  AddDetail( ({"mauritius"}),
	    "Du beschliesst mal wieder hinzufahren.");

  AddDetail( ({"decke"}),
	    "An der Decke siehst Du riesige Wurzeln des Baumriesens ueber Dir.");

  AddDetail( ({"wurzeln","wurzel"}), 
            "Die Wurzeln sind riesig, die Du sehen kannst. Es sieht fast so aus, als ob sie "
            "nach Dir greifen wollen.");

  AddDetail( ({"erde"}),
	    "Die Erde am Boden ist feucht und ekelig. Hier machst Du Dich nur schmutzig.");

  AddDetail( ({"flasche","flaschen"}),
	    "Die Flaschen sind noch aelter als die Regale. Sie sind sicher sehr viel wert. "
            "Ein richtiger kleiner Schatz."); 
  
  AddDetail( ({"schatz"}), 
            "Du ueberlegst ob Du vielleicht eine Flasche stibitzen solltest. Dann kannst "
            "Du Dich nachher in den Park legen und das gute Troepfchen geniessen Die Frage "
            "ist nur, ob Du so hinterhaeltig sein kannst einen armen Zentauren zu bestehlen.");

  AddDetail( ({"park","mitte"}),
	    "Der Park befindet sich in der Mitte der Stadt.");

  AddDetail( ({"troepfchen"}),
	    "Es ist ein ganz edeles Troepfchen.");

  AddDetail( ({"frage","sein","nichtsein"}), 
            "Sein oder Nichtsein, dass ist hier die Frage.");

  AddDetail( ({"zentauren"}),
	    "Du hast sicher schon einen in Roch Adan getroffen.");

  AddDetail( ({"stadt","roch adan","adan","roch"}),
	    "Roch Adan ist die Stadt der Zentauren."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht muffig hier im Keller.");  

  AddSound(DEFAULT_SOUND, "Es ist still wie in einem Grab.");

  AddSound( ({"grab"}),
	   "Das willst Du sicher nicht hoeren.");

//-----Details Ende-----
  
AddExit("oben", ROOM "zennpc1");

SetProp( P_HIDE_EXITS, ({ "suedwesten" }) );
AddCmd( ({"stibitz", "stibitze" }), "stibitzen" );

}
int stibitzen(string str)
{
   notify_fail("Was moechtest Du stibitzen?\n");
   if ( member( ({ "flasche" }),str) != -1) 
  {
    write(BS ( "Du schaust Dich um und schnappst Dir eine Flasche, aber leider hat Dich "
               "der Besitzer erwischt, der gerade in den Keller kommt. Er uebergibt Dich "
               "der Stadtwache.\n"));
    say( TPN+" stibitzt eine Flasche und wird erwischt.\n");
    this_player()->move(ROOM "zenz1", M_TPORT);
    return 1;
  }
}  

