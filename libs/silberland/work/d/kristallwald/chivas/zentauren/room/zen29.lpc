// von Chivas
// 25.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einer Strasse in Roch Adan");
  SetProp( P_INT_LONG,
	"Du befindest Dich in der Mitte der Oststrasse in Roch Adan, die zwischen den Baumriesen "
	"vom Haupttor im Sueden zum Palast der Zentauren im Norden fuehrt. "
	"Westlich befindet sich die Hecke, die den gesamten Park umschliesst. "
	"Die Strasse ist mit Gras und kleinen Steinchen bedeckt, die teilweise in der Sonne "
	"funkeln. ");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----


  AddDetail( ({"oststrasse","strasse","mitte"}), 
            "Die Strasse fuehrt von Norden nach Sueden.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Roch Adan ist die grosse Stadt der Zentauren. Sie besteht aus lauter Baumriesen, in denen "
            "die Zentauren wohnen und arbeiten.");

  AddDetail( ({"baumriesen","riesen","baeume"}),
	    "Die Baumriesen von Roch Adan sind die groesste Baeume im ganzen Silberland. In den Baeumen "
            "hausen die Zentauren.");

  AddDetail( ({"silberland","silberlandes"}), 
            "Du bist im Silberland.");

  AddDetail( ({"haupttor","tor","sueden"}), 
            "Das Haupttor ist irgendwo im Sueden, Du kannst hingehen. Von hier aus kannst Du es jedenfalls nicht "
            "sehen.");

  AddDetail( ({"palast","norden","stueck"}),
	    "Um den Palast zu sehen, musst Du noch ein Stueck weiter nach Norden gehen.");

  AddDetail( ({"zentauren","wesen","mensch","pferd"}),
	    "Zentauren sind magische Wesen. Sie sind halb Mensch und halb Pferd."); 
  
  AddDetail( ({"hecke","westen"}), 
            "Die Hecke im Westen umschliesst den gesamten Park von Roch Adan. Die Blaetter an der Hecke sind "
            "sehr dicht, so dass Du den Park nicht sehen kannst.");

  AddDetail( ({"blaetter","blick"}), 
            "Die Blaetter sind sehr dicht und bieten keinen Blick auf den Park. Obwohl, eine kleine Luecke kannst "
            "Du schon erkennen.");

  AddDetail( ({"park"}),
	    "Der Park von Roch Adan befindet sich hinter der dichten Hecke, so dass Du ihn nicht sehen kannst. "
            "Du beschliesst ihn spaeter einmal zu besuchen um Dich ein wenig in der Sonne auszuruhen.");

  AddDetail( ({"boden"}),
	    "Der Boden auf der Strasse ist mit Gras und kleinen Steinchen bedeckt. Die Steinchen funkeln leicht "
            "in der Sonne.");

  AddDetail( ({"gras","leuten"}), 
            "Das Gras ist von den vielen Leuten in der Stadt schon recht niedergetrampelt. Aber sowas ist wohl "
            "normal.");

  AddDetail( ({"steinchen","jahrhunderten"}),
	    "Die Steinchen sind leider nur glatt geschliffen, was in den Jahrhunderten, die sie hier schon liegen "
            "passieren kann. Sie reflektieren teilweise die Sonne, die fast senkrecht am Himmel steht.");

  AddDetail( ({"luecke"}),
	    "Die Luecke ist nicht sehr gross. Du kannst aber sicher den Park durch die Luecke betrachten."); 
  
  AddDetail( ({"rasenflaechen"}), 
            "Du siehst grosse Rasenflaechen, die anscheinend vor kurzer Zeit gemaeht worden sind. Ein paar "
            "Personen machen gleich bei der Hecke ein Picknick.");

  AddDetail( ({"blumenbeete","beete","blumenbeeten","beeten"}),
	    "Zwischen den Wegen und den Rasenflaechen sind kleine Blumenbeete angelegt, in denen viele Blumen "
            "wachsen.");

  AddDetail( ({"blumen","arten"}),
	    "Es sind verschiedene Blumen. Du siehst Veilchen, Tulpen, Rosen und andere Arten, die Du nicht kennst.");

  AddDetail( ({"wege"}),
	    "Die Wege im Park sind sehr gepflegt. Sie bestehen aus lauter kleinen Steinen.");

  AddDetail( ({"steinen","steine"}), 
            "Ganz normale Steine, nichts besonderes.");

  AddDetail( ({"sonne"}), 
            "Die Sonne strahlt vom Himmel und waermt Dich.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau, nur ein paar Wolken sind zu sehen, die jedoch nicht die Sonne verdecken.");

  AddDetail( ({"wolken"}),
	    "Die Wolken sind schoen weiss."); 
  
  AddDetail( ({"personen"}), 
            "Es sind ein paar Abenteurer wie Du, die sich im Park ausruhen und die Sonne geniessen. Sie haben "
            "eine grosse Decke ausgebreitet, auf der sie sich niedergelassen haben. Sie unterhalten sich "
            "angeregt. Vielleicht kannst Du sie belauschen.");

  AddDetail( ({"picknick","spass"}),
	    "Das Picknick scheint Spass zu machen. Die Personen lachen und freuen sich.");

  AddDetail( ({"decke"}),
	    "Die Decke ist recht gross und hat lauter Karos aufgemalt. Ansonsten ist die Decke auf der die "
            "Personen sitzen uninteressant.");

  AddDetail( ({"karos","arbeit"}), 
            "Die Karos sind sehr klein und es muss eine schwere Arbeit gewesen sein, die Karos auf die Decke "
            "zu sticken.");

  AddDetail( ({"gedanken"}),
	    "Selbst jemand wie Du macht sich ab und zu Gedanken.");

  AddDetail( ({"geschaefte"}),
	    "Die Geschaefte gehen Dich nichts an.");

  AddDetail( ({"veilchen"}), 
            "Kleine blaue Veilchen wachsen in den Beeten.");

  AddDetail( ({"tulpen"}),
	    "Die Tulpen sind gelb und rot und gedeihen hervorragend.");

  AddDetail( ({"bank","silberbank"}),
	    "Die Silberbank kannst Du nicht sehen, die ist doch in Midas.");

  AddDetail( ({"midas","hauptstadt"}),
	    "Midas ist die Hauptstadt des Silberlandes.");

  AddDetail( ({"rosen","zuechtungen"}),
	    "Die Rosen sind etwas ganz besonderes. Du hast solche noch nie gesehen. Es scheinen eigene "
            "Zuechtungen der Zentauren zu sein."); 
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");


  AddSmell(DEFAULT_SMELL, "Du riechst das Gras auf der Strasse. Ansonsten aber nichts.");  
 
  AddSmell( ({"gras"}),
	   "Das Gras riecht frisch.");

  AddSound(DEFAULT_SOUND, "Du hoerst den ueblichen Stadtlaerm.");

  AddSound( ({"stadtlaerm","laerm"}),
	   "Was Du halt in jeder Stadt hoerst. Nichts besonderes.");
  
//-----Details Ende-----

AddItem(NPC "zentaurk1", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "zen29",
          P_MNPC_AREA:({ROOM "zen13", ROOM "zen16", ROOM "zen17",
                          ROOM "zen18", ROOM "zen19", ROOM "zen20",
                          ROOM "zen21", ROOM "zen22", ROOM "zen23",
                          ROOM "zen24", ROOM "zen25", ROOM "zen26",
                          ROOM "zen27", ROOM "zen28", ROOM "zen29",
                          ROOM "zen30", ROOM "zen31", ROOM "zen32",
                          ROOM "zen33", ROOM "zen34", ROOM "zen35",
                          ROOM "zen36", ROOM "zen37", ROOM "zen43",
                          ROOM "zenladen",ROOM "zenschmied"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );

AddExit("sueden", ROOM "zen24");  
AddExit("norden", ROOM "zen34");
AddExit("osten", ROOM "zeng4");

AddCmd( ({"betrachte" }), "betrachten" );
AddCmd( ({"zwaeng", "zwaenge" }), "zwaengen" );
AddCmd( ({"belausch", "belausche" }), "belauschen" );

}
int betrachten(string str)
{
   notify_fail("Was moechtest Du wo durch betrachten?\n");
   if ( member( ({ "park durch hecke","park durch luecke" }),str) != -1) 
  {
    write( "Du schaust durch die Luecke in der Hecke und erkennst grosse Rasenflaechen, Blumenbeete und Personen "
           "die ein Picknick machen. Vielleicht kannst Du Dich auch durch die Hecke zwaengen.\n");
    say( TPN+" steckt den Kopf in die Hecke.\n");
    return 1;
  }
}
int zwaengen(string str)
{
   notify_fail("Wodurch willst Du Dich zwaengen?\n");
   if ( member( ({ "durch hecke", "durch luecke" }),str) != -1) 
  {
    write(BS ( "Du zwaengst Dich durch die Hecke und stehst ploetzlich mitten im Park."));
    say( TPN+" macht was an der Hecke und verschwindet.\n");
    TP->move( ROOM "zen28", M_GO, "westen");
    return 1;
  }

}
int belauschen(string str)
{
   notify_fail("Wen moechtest Du belauschen?\n");
   if ( member( ({ "personen","abenteurer" }),str) != -1) 
  {
    write( "Du belauscht ganz frech die Personen im Park. Das Gespraech scheint sich um zwielichtige "
           "Geschaefte der Silberbank zu handeln. Du beschliesst Dir Gedanken zu machen die Bank zu wechseln.\n");
    say( TPN+" hat seinen Kopf in der Hecke und sein Ohren scheinen groesser zu werden.\n");
    return 1;
  }
}
   
