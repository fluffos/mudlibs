// von Chivas
// 11.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"

inherit "std/laden";

#include "../def.h"
#include <laden.h>

void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));

  SetProp(P_INT_SHORT,"In einem Laden in Roch Adan");
  SetProp(P_SHOPKEEPER_ID, "arien");
  SetProp(P_SHOPKEEPER_NAME, "arien");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
  SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);

  SetStorageRoom(ROOM "zenlager" );

//-----Anfang Details-----------------

  AddDetail( ({"boden"}),
	    "Der Boden ist mit Reisig bedeckt. Einige Steinplatten erkennt man darunter. ");

  AddDetail( ({"wand","waende"}),
	    "Die Waende sind natuerlich aus Holz, wie es in einem Baum auch normal ist. An "
            "der Wand haengt eine Tafel wo man sieht was es zu kaufen gibt und ein alter "
            "Nagel ist auch noch zu sehen. \n"
            "Einige Fackeln an der Wand erhellen den Laden."); 

  AddDetail( ({"decke"}),
	    "Die Decke ist aus Holz wie die Wand auch. Ganz normal in einem Baum.");

  AddDetail( ({"fackeln","fackel"}),
	    "Die Fackeln an der Wand erhellen den Laden."); 

  AddDetail( ({"tresen"}),
	    "Der Tresen steht im Laden. Dahinter stehen einige Regale mit Waren.");

  AddDetail( ({"regale","regalen","schwert","ruestung","waren"}),
	    "In den Regalen sind lauter Waren. Von der Ruestung bis zum Schwert kann man hier "
            "normalerweise alles kaufen."); 

  AddDetail( ({"reisig"}),
	    "Der uebliche Reisig wie in allen Baeumen der Zentauren.");

  AddDetail( ({"baum","baeumen","wohnungen","kneipen"}),
	    "Dieser Baum ist ein Laden, in anderen Baeumen gibt es Wohnungen, Kneipen usw..");

  AddDetail( ({"zentauren","geschoepfe","mensch","pferd"}),
	    "Zentauren sind magische Geschoepfe. Sie sind halb Mensch und halb Pferd."); 

  AddDetail( ({"steinplatten","stein","platten"}),
	    "Zwischen den Steinplatten unter dem Reisig kannst Du einige Fugen erkennen."); 

  AddDetail( ({"fugen"}),
	    "In den Fugen sammelt sich Dreck und Schmutz.");

  AddDetail( ({"schmutz","dreck","haus"}),
	    "Hier ist nur Schmutz und Dreck. Hier findest Du keinen Zaubertrank wie in einem "
            "anderen wichtigen Haus."); 

  AddDetail( ({"holz"}),
	    "Richtiges Holz. Du bist fasziniert.");

  AddDetail( ({"laden"}),
	    "Du stehst mitten im Laden von Roch Adan."); 

  AddDetail( ({"roch adan","roch","adan","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren.");

  AddDetail( ({"nagel","zeit"}),
	    "An dem rostigen Nagel hat vor langer Zeit mal irgendetwas gehangen.");

  AddDetail( ({"tafel","sortiment"}),
	    "Auf der Tafel sieht man was man im Laden kaufen kann. Tipp 'zeige' und Du kriegst das "
            "Sortiment angezeigt."); 

  AddDetail( ({"zaubertrank","trank"}),
	    "Tja, hier im Laden findest Du keinen.");
  
  
  AddSmell(DEFAULT_SMELL, "Du riechst den Rost von alten Ruestungen und das Leder von Stiefeln in "
                          "den Regalen.");  
 
  AddSmell( ({"rost","ruestungen","qualitaet"}),
	   "Der Rost riecht nicht gut, so manche Ruestung scheint keine gute Qualitaet zu haben.");

  AddSmell( ({"leder","stiefeln"}),
	   "Das Leder riecht frisch. Das Leder scheint aber nass zu sein, ansonsten wuerde es "
           "nicht so stark riechen.");

  AddSound(DEFAULT_SOUND, "Du hoerst wie im Lager Waren gestapelt werden.");

  AddSound( ({"lager","waren"}),
	   "Anscheinend sind gerade einige Waren vom Regal gefallen. Es hat richtig laut gescheppert.");
  
//-----Details Ende-----


  AddExit("osten", ROOM "zen35");

  AddItem(NPC "arien", REFRESH_DESTRUCT);
}

string _query_int_long()
{
  string txt;

  txt = "Du befindest Dich hier in einem kleinen Laden in Roch Adan. Unzaehlige Regale "
        "stehen hinter dem Tresen. Du siehst eine kleine Tafel an einer Wand. ";

  if(QueryProp(P_SHOPKEEPER_ID))
  {
    if(!present(QueryProp(P_SHOPKEEPER_ID)))
    {
      txt += "Leider ist momentan gerade niemand hier.";
    }
    else
    {
      txt += "";
    }
  }

  return BS(txt);
}
