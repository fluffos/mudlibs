// von Elro
// 09.3.2004
// 
// Raum meines Gesellenstueckes "Weg9 - zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int fackel_zahl;

void create()
	
{
  ::create();

  fackel_zahl=1;


  SetProp( P_INT_SHORT, "An einem Waldanfang");
  SetProp( P_INT_LONG,
	"Der Waldanfang an dem Du Dich befindest ist sofort recht dicht und "
        "das Unterholz sieht sehr durchwachsen aus. Buesche und Straeucher "
        "stehen am Rand des Weges und zwaengen dem Weg seine Richtung auf. "
        "Im Nordwesten wird der Wald wirklich finster, so dass Du kaum etwas "
        "erkennen kannst. Du solltest etwas finden, so dass Du, wenn Du "
        "weiter nach Nordwesten gehst, auch was sehen kannst. Im Sueden "
        "beginnt eine grosse Wiese. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden","erde","zeit"}), 
            "Der Boden ist erdig, wie ein normaler Waldweg, ab und zu  "
	    "kann man auch ein paar Steine im Gras und Zweige am Boden liegen sehen. "
            "Von Zeit zu Zeit trifft ein Lichtstrahl durch das dichte Blaetterdach den "
            "Boden.");

  AddDetail( ({"weg","waldweg"}),
	    "Der Waldweg ist von Bueschen und Straeuchern gesaeumt und zwaengt Dir die Richtung auf. "
	    "Er fuehrt Richtung Norden in ein finsteres Waldstueck und im Sueden auf eine grosse "
            "Wiese.");

  AddDetail( ({"norden","waldstueck","hilfsmittel"}),
	    "Im Nordwesten wird der Wald sehr sehr dunkel. Ohne Hilfsmittel "
            "kann man da sicher nichts erkennen. ");

  AddDetail( ({"wegrand","rand"}),
	    "Buesche und Straeucher stehen am Wegrand. Ein Busch faellt Dir besonders auf. ");

  AddDetail( ({"waldanfang","anfang"}),
	    "Buesche und Straeucher stehen am Wegrand. Ein Busch faellt Dir besonders auf. ");
  
  AddDetail( ({"baeume","baeumen","baum"}),
	    "Am Waldanfang befinden sich meistens Baeume. Mehrere Baeume ergeben halt einen Wald, "
            "hier sind es Tannen, Kiefern und ein paar Eichen. ");

  AddDetail( ({"luecken","luecke","augenwinkeln"}),
	    "Du schaust Dir die Luecken an, aber wendest Dich dann ab, da nichts "
	    "interessantes zu erkennen ist. Aus den Augenwinkeln erkennst Du jedoch "
            "ploetzlich in einer Luecke Etwas glitzerndes. ");

  AddDetail( ({"blatt","blaetter","blaetterdach","dach","nadeldach"}),
	    "Die Blaetter und Nadeln bilden ein dichtes Dach, so dass kaum ein Lichtstrahl "
	    "den Boden trifft.");

  AddDetail( ({"unterholz"}),
	    "Das Unterholz ist sehr dicht, nur ab und zu sind ein paar Luecken "
	    "zwischen den Baeumen und dem Unterholz sehen. Das Unterholz besteht "
            "aus Bueschen und Straeuchern. ");

  AddDetail( ({"holz"}),
	    "Baeume bestehen aus Holz, dumme Frage. ");

  AddDetail( ({"luecke","glitzern","glitzerndes","etwas"}),
	    "Du koenntest ja mal probieren in die Luecke zu greifen. ");

  AddDetail( ({"licht","verhaeltnisse","lichtverhaeltnisse","himmel"}),
	    "Es ist ein bisschen schummrig, kaum Licht dringt durch das dichte "
	    "Blaetterdach. Der Himmel ist kaum noch zu sehen.");

  AddDetail( ({"lichtstrahl","strahl"}),
	    "Ab und zu trifft ein Lichtstrahl den Boden, was jedoch durch das "
	    "dichte Blaetterdach nicht haeufig geschieht. ");

  AddDetail( ({"wald","waldes","ansammlung"}),
	    "Ein Wald ist eine Ansammlung von Baeumen.");

  AddDetail( ({"gras"}),
	    "Ganz normales Gras, mit ein paar Steinen. ");

  AddDetail( ({"zweige","zweig"}),
	    "Sie liegen auf dem Waldweg und sind wohl von den Baeumen heruntergefallen. ");

  AddDetail( ({"aeste","ast"}),
	    "Die Aeste wiegen sich leicht im Wind. ");

  AddDetail( ({"wind"}),
	    "Die Aeste wiegen sich leicht im Wind. ");

  AddDetail( ({"buesche","bueschen","busch"}),
	    "Ganz normale Buesche, aber dort ist eine Luecke in dem einen Busch und darin scheint "
            "es zu glitzern. ");

  AddDetail( ({"straeucher","straeuchern"}),
	    "An den Straeuchern kannst Du nichts interessantes entdecken.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst, Dich bald zu waschen.");

  AddDetail( ({"tanne","tannen"}),
	    "Die Tannen bilden mit den Kiefern und Eichen ein dichtes Blaetter- bzw. Nadeldach.");

  AddDetail( ({"kiefer","kiefern"}),
	    "Die Kiefern sind sehr alt und die Rinde harzt ein wenig.");

  AddDetail( ({"steine"}),
	    "An den Steinen gibt es nichts besonderes zu sehen.");

  AddDetail( ({"eichen","eiche"}),
	    "Die Eichen sind sehr alt und die Staemme sind knochig.");

  AddDetail( ({"stamm","staemme"}),
	    "Jeder Baum hat einen.");

  AddDetail( ({"rinde"}),
	    "Die Rinde der Kiefern harzt ein wenig, pass auf, dass Du nicht dran kleben bleibst.");

  AddDetail( ({"nadeln"}),
	    "Die Kiefern und Tannen haben welche.");

  AddDetail( ({"wiese"}),
	    "Im Suedosten ist eine Wiese mit vielen Blumen.");

  AddDetail( ({"blumen","blume"}),
	    "Auf der Wiese wachsen viele Blumen. Du erkennst rote, blaue und gelbe Blumen.");

  AddDetail( ({"rote blumen","rote"}),
	    "Du erkennst nicht, was es fuer Blumen sind. Du musst schon naeher ran gehen.");

  AddDetail( ({"blaue blumen","blaue"}),
	    "Die Blumen sehen schoen aus, wenn Du wissen willst, was es fuer Blumen sind, musst Du "
            "schon naeher ran gehen.");

  AddDetail( ({"gelbe blumen","gelbe"}),
	    "Es koennten Sonnenblumen sein. Du bist Dir aber nicht sicher. "
            "Fuer eine genauere Untersuchung bist Du zu weit weg.");
  
  AddDetail( ({"untersuchung"}),
	    "Da musst Du schon naeher ran gehen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst die Baeume, das Gras am Boden und auch klare Luft.");  
 
  AddSmell( ({"baeume","baum"}),
	   "Sie duften nach Kiefern und Tannen.");

  AddSmell( ({"luft"}),
	   "Du schnupperst an der klaren Luft und fuehlst Dich frei.");
  
  AddSmell( ({"kiefer","kiefern"}),
	   "Halt wie Kiefern in einem Wald riechen.");

  AddSmell( ({"tanne","tannen","weihnachtsbaum","adventszeit"}),
	   "Halt wie Tannen riechen, falls Du es nicht weisst, schnupper "  
           "mal in der Adventszeit an Deinem Weihnachtsbaum. ");
  
  AddSmell( ({"eiche","eichen"}),
	   "Halt wie Eichen riechen, irgendwie eichig. ");
  
  AddSound(DEFAULT_SOUND, "Der Wind weht nur ganz leicht durch "
	   "das Blaetterdach, trotzdem hoerst Du ein leichtes Rascheln.");

  AddSound( ({"wind"}),
	   "Du kannst ihn kaum hoeren, er bringt nur die Blaetter leicht zum Rascheln.");
  
  AddSound( ({"blaetter","rascheln"}),
	   "Die Blaetter bewegen sich leicht im Wind, so dass sie rascheln!");

//-----Details Ende-----
  
AddExit("suedosten", ROOM "zen8");
AddExit("nordwesten", ROOM "zen10");

AddCmd( ({"greifen", "greife","greif" }), "greifen" );

}

int greifen(string str)
{
  object fackel;
  notify_fail( "Wo willst Du denn hineingreifen?\n" );
  if ( member( ({ "in luecke", "luecke", "in luecke rein", "in luecke hinein" }), str ) != -1 ) 

   {
     if( fackel_zahl < 1 )
     {
        write("Du greifst in die Luecke, suchst etwas herum, findest aber nichts.\n");
        say(sprintf("%s greift in eine Luecke.\n", TP->Name(WER)));
        return -1;
     }
      if ( present("fackel",TP) )
      {
      write("Du greifst in die Luecke und findest eine Fackel, aber nachdem Du "
            "bereits eine hast laesst Du sie liegen.\n" );
      say(sprintf("%s sucht krankhaft nach weiteren Sachen im Gebuesch.\n", TP->Name(WER)));
      return -1;
      }
      else
      {
        {fackel = clone_object( "/obj/fackel");
        if ( ME_TOO_HEAVY == fackel->move(TP,M_GET|M_SILENT) )

          {
          write(
          "Die Fackel wuerde Dir zu schwer werden.\n" );
          say(BS(sprintf("%s greift in den Busch, scheint aber vom Gepaeck "
          "behindert zu werden.\n", TP->Name(WER))));
          fackel -> remove();
          return 1;
          }
          else
          {
          write("Du greifst in die Luecke und findest eine Papierfackel, auf "
                "der anscheinend ein paar Tautropfen geglitzert haben,"
                "die Du sofort einsteckst.\n");
          say(sprintf("%s greift in den Busch und steckt etwas ein.\n",
          TP->Name(WER)));
          fackel_zahl--;
          return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}
