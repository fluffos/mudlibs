// von Chivas
// 12.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einem Marktplatz");
  SetProp( P_INT_LONG,
	"Dies ist der westliche Marktplatz, wo es nicht die ueblichen Sachen zu kaufen "
	"gibt. Alle Waren wirken ein wenig skurril. Du hast schaetzungsweise noch nicht "
	"einmal die Haelfte der Waren gesehen oder sie gegessen, was Du auch nicht tun "
	"willst, weil so manche Koestlichkeit so aussieht als ob sie mit Dir reden "
	"koennte. Der Sueden des Platzes ist durch eine grosse gepflegte Hecke vom "
        "dahinterliegenden Park getrennt.\n" 
        "Im Osten ist mehr los, da werden noch weitere Waren verkauft. Nach Suedwesten "
        "fuehrt die Strasse an der Hecke vorbei zu verschiedenen Baumhoehlen der "
        "Zentauren. Im Nordosten siehst Du einen Baumriesen der seines gleichen sucht. "
        "Im Westen ist ein Laden. ");

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  
  AddDetail( ({"boden"}), 
            "Der Boden ist mit Gras bedeckt und ueberall auf diesem Teil des Marktplatzes stehen "
            "Staende wo skurrile Waren verkauft werden.");

  AddDetail( ({"marktplatz","markt","platz","teil","marktplatzes","platzes"}),
	    "Auf dem westliche Marktplatz werden nicht die normalen Waren angeboten wie in der "
            "Mitte des Platzes.");

  AddDetail( ({"sachen","waren","dingen","dinge"}),
	    "Die angebotenen Waren oder Koestlichkeiten, wie es andere vielleicht bezeichnen wuerden, "
            "entsprechen doch nicht den Dingen, die Du kaufen wuerdest.");

  AddDetail( ({"nordosten","baumriesen","palast"}), 
            "Im Nordosten sieht man den groessten Baumriesen von Roch Adan. Dies scheint der Palast "
            "der Zentauren zu sein.");

  AddDetail( ({"suedwesten","strasse","baumhoehlen"}),
	    "Im Suedwesten geht die Strasse zwischen den Baumhoehlen der Zentauren und der Hecke weiter.");

  AddDetail( ({"staende","staenden"}),
	    "An den Staenden verkaufen die Haendler alle moeglichen Waren. Von Obst bis zu wilden Sachen "
            "in Behaeltern."); 
  
  AddDetail( ({"koestlichkeit","gemuese","obst","koestlichkeiten"}), 
            "Die Koestlichkeiten erstrecken sich von Gemuese und Obst, was sich bewegen kann, bis komische "
            "Sachen, die in Flaschen stecken.");

  AddDetail( ({"hecke","sueden"}),
	    "Im Sueden des Platzes ist eine Hecke, die den dahinter liegenden Park vom Marktplatz und der "
            "Strasse trennt.");

  AddDetail( ({"park"}),
	    "Der Park befindet sich hinter der Hecke. Du kannst nicht viel von ihm erkennen. Du beschliesst "
            "ihn spaeter einmal zu erforschen.");

  AddDetail( ({"westen","laden","baumhoehle"}), 
            "An einer Baumhoehle im Westen haengt ein Schild. Es scheint ein Laden zu sein.");

  AddDetail( ({"schild"}),
	    "Das Schild haengt zwar etwas schief aber man kann es trotzdem lesen.");

  AddDetail( ({"gras"}),
	    "Das Gras ist ein wenig niedergetrampelt."); 
  
  AddDetail( ({"himmel"}), 
            "Der Himmel ist blau. Die Sonne und ein paar Wolken kann man auch sehen.");

  AddDetail( ({"sonne"}),
	    "Die Sonne steht fast senkrecht am Himmel.");

  AddDetail( ({"wolken"}),
	    "Die Wolken schweben leicht am Himmel dahin.");

  AddDetail( ({"tinkturen"}), 
            "Die Tinkturen sollen wohl gegen alles moegliche helfen. Vor allem gegen gefaehrliche Gifte.");

  AddDetail( ({"flaschen"}),
	    "In den Flaschen scheinen alle moeglichen Fluessigkeiten zu sein. An einigen Staenden stehen auch "
            "komisch aussehende Behaelter.");

  AddDetail( ({"behaelter"}),
	    "In den Behaeltern sind Tiere in Alkohol eingelegt."); 
  
  AddDetail( ({"gifte","gift","haende"}), 
            "Die Gifte sind sicher sehr gefaehrlich. Davon solltest Du lieber die Haende lassen.");

  AddDetail( ({"fluessigkeiten"}),
	    "Die Fluessigkeiten scheinen irgend welche Tinkturen und Gifte zu sein.");

  AddDetail( ({"tiere","alkohol","delikatesse"}),
	    "Das ist echt eklig. Anscheinend ist es eine echte Delikatesse der Zentauren eingelegte Tiere "
            "zu essen. Wie abartig.");

  AddDetail( ({"mitte","osten"}), 
            "In der Mitte des Platzes im Osten werden ganz normal Waren angeboten, die Du kennst. Hier "
            "ist das ein wenig anders.");

  AddDetail( ({"zentauren","geschoepfe","mensch","pferd"}),
	    "Zentauren sind magische Geschoepfe. Sie sind halb Mensch und halb Pferd.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren."); 
  
  AddDetail( ({"blick","sortiment"}), 
            "Hoffentlich ist das Sortiment im Laden nicht so skuril wie die Sachen hier auf dem Markt.");

  AddDetail( ({"haendler","wesen"}),
	    "Haendler preisen an ihren Staenden Waren an, die kein normales Wesen kaufen wuerde.");

  AddDetail( ({"kaeufer"}),
	    "Die Kaeufer auf diesem Teil des Marktes sehen schon ein wenig dubios aus. Sicher hat so "
            "mancher Etwas auf dem Kerbholz.");

  AddDetail( ({"etwas","kerbholz","unschuldslamm"}), 
            "Dies interessiert Dich nicht wirklich, da Du auch kein Unschuldslamm bist.");

  AddDetail( ({"ich","du","er","sie"}),
	    "Du untersuchst wirklich alles.");

  AddSmell(DEFAULT_SMELL, "Du riechst die Tinkturen und Gifte in den Flaschen.");  
 
  AddSmell( ({"tinkturen","gifte"}),
	   "Du solltest nicht so tief einatmen. Es schadet vielleicht.");

  AddSound(DEFAULT_SOUND, "Du hoerst wie die Haendler und die Kaeufer um Waren feilschen.");

  AddSound( ({"haendler","verkaeufer","feilschen"}),
	   "Die Haendler und Verkaeufer schreien sich fast beim Feilschen an.");
  
  AddReadDetail( ({"schild"}),
		"Hier gibt es fast alles zu kaufen, kommen Sie rein und werfen Sie einen Blick auf unser Sortiment.");

//-----Details Ende-----
  

AddExit("suedwesten", ROOM "zen30");  
AddExit("westen", ROOM "zenladen");
AddExit("osten", ROOM "zen36");
AddExit("nordosten", ROOM "zen42");


}

