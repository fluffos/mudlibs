// von Chivas
// 01.6.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>


void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einer Strasse in Roch Adan");
  SetProp( P_INT_LONG,
	"Du befindest Dich auf einer Strasse in Roch Adan, die zwischen den Baumriesen "
	"vom Haupttor im Sueden westlich zum Palast der Zentauren im Norden fuehrt. "
	"Oestlich befindet sich eine gepflegte Hecke, die die Strasse "
	"vom dahinterliegenden Park abtrennt. Die Strasse ist mit Gras bedeckt, ab und "
	"zu erkennt man ein paar Hufabdruecke, aber auch Spuren von anderen Lebewesen. ");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( ({"strasse"}),
	    "Die Strasse fuehrt von Sueden nach Norden am Park und den Baumriesen der Zentauren vorbei. Der Boden "
            "ist sehr weich, da er mit Gras bedeckt ist.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Dies ist die Stadt der Zentauren. Dir gefaellt es hier sehr gut.");

  AddDetail( ({"baumriesen","riesen","baeume"}), 
            "In den Baumriesen arbeiten und wohnen die Zentauren. Die Baeume sind riesig. Sie sind die groessten "
            "im ganzen Silberland.");

  AddDetail( ({"haupttor","tor","sueden"}),
	    "Das Tor kannst Du von hier aus nicht sehen, Du weisst jedoch, dass Dich die Strasse Richtung Sueden "
            "dahin bringen wuerde.");

  AddDetail( ({"palast","norden"}),
	    "Den Palast im Norden kannst Du momentan noch nicht sehen. Du solltest hingehen und ihn Dir anschauen."); 
  
  AddDetail( ({"zentauren","wesen","oberkoerper","rest","pferdes"}), 
            "Die Zentauren sind stolze Wesen. Ihr Oberkoerper ist menschlich und der Rest eines Pferdes.");

  AddDetail( ({"hecke","eingang","moeglichkeit","stellen"}),
	    "Die Hecke umgibt den gesamten Park, bis auf ein paar Stellen, wo man ihn betreten kann. Hier ist "
            "leider keine Eingang in den Park und es gibt auch keine Moeglichkeit durch die Hecke zu kommen.");

  AddDetail( ({"park","westen"}),
	    "Der Park im Osten ist von einer grossen Hecke umgeben um den Laerm der Strasse vom Park fern "
            "zu halten. Du solltest vielleicht einmal hingehen und Dich ein wenig ausruhen.");

  AddDetail( ({"boden"}), 
            "Der Boden ist mit Gras bedeckt. Ab und zu sieht man auch ein paar Steinchen im Gras liegen. Viel "
            "interessanter ist jedoch eine kleine Pfuetze.");

  AddDetail( ({"hufabdruecke","abdruecke","pferd"}),
	    "Die Hufabdruecke stammen sicher von den Zentauren, da Du hier noch kein einziges Pferd gesehen hast.");

  AddDetail( ({"spuren","lebewesen","abenteurern","abenteurer"}),
	    "Die Spuren auf der Strasse stammen von anderen Abenteurern wie Dir, die Roch Adan besucht haben."); 
  
  AddDetail( ({"pfuetze"}), 
            "Die Pfuetze ist anscheinend noch vom letzten Regen. Es ist nicht mehr viel Wasser in der Pfuetze, "
            "aber um so mehr Schlamm.");

  AddDetail( ({"schlamm"}),
	    "Der Schlamm sieht sehr interessant aus. Vielleicht wuerde es sich lohnen, mal darin zu wuehlen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau und die Wolken ziehen langsam vorbei. Ein paar Voegel ziehen ihre Kreise.");

  AddDetail( ({"wolken"}), 
            "Die Wolken ziehen langsam am Himmel entlang, verdecken aber nicht die Sonne.");

  AddDetail( ({"sonne"}),
	    "Die Sonne waermt Dich sehr und Du fuehlst Dich wohl.");

  AddDetail( ({"voegel","kreise"}),
	    "Ein paar Voegel ziehen am Himmel ihre Kreise. Sie sind jedoch zu hoch um genau zu erkennen um "
            "was fuer Voegel es sich handelt."); 
  
  AddDetail( ({"steinchen","steine"}), 
            "Einige Steinchen liegen im Gras auf der Strasse. Sie sind aber nicht sehr interessant.");

  AddDetail( ({"regen"}),
	    "Es sieht gar nicht nach Regen aus, die Wolken sind schneeweiss.");

  AddDetail( ({"gras"}),
	    "Das Gras auf der Strasse ist ein wenig niedergetrampelt. Ein paar Steinchen liegen im Gras.");

  AddDetail( ({"wasser"}),
	    "Es ist nicht mehr viel Wasser in der Pfuetze.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland und fuehlst Dich wohl hier.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");


  AddSmell(DEFAULT_SMELL, "Du riechst die klare Luft und fuehlst Dich gut.");  
 
  AddSmell( ({"luft","fruehling"}),
	   "Die Luft ist sehr warm und riecht nach Fruehling.");

  AddSound(DEFAULT_SOUND, "Du hoerst den ueblichen Stadtlaerm.");

  AddSound( ({"stadtlaerm","laerm","beschaeftigungen"}),
	   "Du hoerst die Zentauren, wie sie ihren Beschaeftigungen nachgehen und wie andere Abenteurer "
           "die Stadt erkunden.");

//-----Details Ende-----
AddItem(NPC "zentaurm1", REFRESH_DESTRUCT);

AddExit("sueden", ROOM "zen20");  
AddExit("norden", ROOM "zen30");
AddExit("westen", ROOM "zeng1" );

AddCmd( ({"wuehl", "wuehle" }), "wuehlen" );

}
int wuehlen(string str)
{
 object linse2;
 notify_fail("In was willst Du wuehlen?\n");

 if(!str || str == "") return 0;
 if(!(str == "schlamm" ||
      str == "in schlamm" )) return 0;

  if(!present("astroinvis", TP) && !present("dragoninvis2", TP)){
	  
  write(BS("Du bist enttaeuscht. Es ist nur eine alte Scherbe die Du momentan hier findest. "
           "Du wirfst sie wieder weg.\n"));
 
  say(TPN+" ist enttaeuscht.\n");
  return -1;
  }
  if(present("linse2", TP)){
	  
  write(BS("Du findest nur noch eine alte Scherbe, die Du aber wieder wegwirfst.\n"));
 
  say(TPN+" findet nichts in der Pfuetze.\n");
  return -1;
  }

  write(BS("Du durchwuehlst den Schlamm in der Pfuetze und machst Dich richtig schoen dreckig dabei. "
	  "Aber das positive ist, Du findest eine kleine Linse, die Du sofort einsteckst.\n"));
 
  say(TPN+" scheint was in der Pfuetze zu finden.\n");
  clone_object(OBJ "linse2")->move(TP, M_NOCHECK);
  return 1;
}

