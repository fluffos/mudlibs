// von Chivas
// 25.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>



void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Du befindest Dich in einem Wald. Der Weg ist von grossen Baeumen gesaeumt. "
        "Es ist beeindruckend wie viele Baeume hier im Schatten des Gipfels wachsen. Im Sueden ist "
        "der Tunnel, durch den Du hierher gekommen bist. Er sieht von dieser Seite genau so "
        "beunruhigend aus, wie von der anderen Seite." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( ({"boden","weg","waldboden"}), 
            "Der Weg auf dem Du stehst ist steinig. Einige Aeste, Blaetter und Nadeln liegen am Boden, "
            "die scheinbar von den Baeumen gefallen sind. Am Wegrand zwischen den Bueschen waechst auch "
            "ein wenig Gras.");

  AddDetail( ({"wald"}),
	    "Der Wald unter dem Gipfel ist nicht so dicht wie der Wald im Nordwesten zu werden scheint. Die "
            "grossen Baeume stehen noch weiter auseinander, so dass das Licht der Sonne den Boden und den Eingang "
            "des Tunnels erreicht. ");

  AddDetail( ({"baeumen","baeume"}), 
            "Du erkennst lauter Tannen, Ulmen und Eichen.");

  AddDetail( ({"schatten"}),
	    "Der Schatten den der Berg normalerweise wirft ist momentan fast verschwunden, da die Sonne fast "
            "senkrecht ueber Dir steht.");

  AddDetail( ({"gipfel","berg","berges","moeglichkeit"}),
	    "Du stehst weit unter dem Gipfel des Berges. Um auf die andere Seite des Berges zu kommen, musst "
            "Du den Tunnel benutzen. Eine andere Moeglichkeit gibt es nicht."); 
  
  AddDetail( ({"schnee"}), 
            "Der Schnee auf dem Gipfel glitzert in der Sonne.");

  AddDetail( ({"sonne","licht","sonnenstrahlen","strahlen"}),
	    "Die Sonne steht fast senkrecht am Himmel und waermt Dich. Die Sonnenstrahlen glitzern im Schnee auf "
            "dem Gipfel des Berges.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist strahlend blau und nur ein paar Wolken sind zu erkennen.");

  AddDetail( ({"wolken","regen"}), 
            "Die Wolken sind weiss und es sieht nicht danach aus, dass es Regen geben koennte.");

  AddDetail( ({"sueden"}),
	    "Im Sueden ist der Eingang des Tunnels, durch den Du bis hier her gekommen bist.");

  AddDetail( ({"tunnel","tunnels","eingang","platz","probleme","fels","tunneleingang"}),
	    "Im Sueden ist der Tunnel, durch den Du bis hier her gekommen bist. Er sieht nicht sehr "
            "vertrauenserweckend aus. Der Eingang ist grob in den Fels gehauen, bietet aber genug Platz "
            "um aufrecht und ohne Probleme den Tunnel zu betreten."); 
  
  AddDetail( ({"seite"}), 
            "Um auf die andere Seite des Berges zu kommen, muss man den Tunnel benutzen. Dies moechtest Du "
            "eigentlich nicht, da Dir der Tunnel nicht sehr gefaellt.");

  AddDetail( ({"buesche"}),
	    "Einige Buesche saeumen den Weg.");

  AddDetail( ({"straeucher"}),
	    "Ein paar Straeucher stehen am Eingang des Tunnels.");

  AddDetail( ({"blaetter"}), 
            "Einige Blaetter sind von den Baeumen auf den Weg gefallen. Es raschelt, wenn man ueber sie geht.");

  AddDetail( ({"steinchen","steine"}),
	    "Ein paar ganz normale Steine liegen auf dem Weg. Uninteressant.");

  AddDetail( ({"gras"}),
	    "Ein wenig Gras waechst zwischen den Bueschen am Wegrand, ansonsten kannst Du nichts entdecken."); 
  
  AddDetail( ({"nordwesten"}), 
            "Im Nordwesten wird der Wald dichter. Hier kann man noch sehr gut den Himmel sehen.");

  AddDetail( ({"nadeln"}),
	    "Einige Nadeln sind von den Tannen auf den Waldboden gefallen. Ansonsten sind natuerlich tausende von "
            "Nadeln an den Aesten der Tannen.");

  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand stehen lauter grosser Baeume. Einige Buesche wachsen am Boden und zwischen den Bueschen ist "
            "auch ein wenig Gras zu sehen.");

  AddDetail( ({"tanne","tannen"}), 
            "Ganz normale Tannen, wie man sie ueberall her kennt.");

  AddDetail( ({"aesten","aeste"}),
	    "Am Boden und an den Baeumen erkennt man Aeste. Ein paar sind halt auf den Waldboden gefallen.");

  AddDetail( ({"eiche","eichen"}),
	    "Die Eichen die hier wachsen sind schon sehr alt. Ihre Staemme sind riesig."); 
  
  AddDetail( ({"ulmen","ulme"}), 
            "Die Aeste der Ulmen bewegen sich leicht im Wind. Ansonsten kannst Du an der Ulmen nicht viel erkennen.");

  AddDetail( ({"staemme","umfang","jahrhunderte"}),
	    "Die Staemme der Eichen haben einen grossen Umfang. Sie muessen schon Jahrhunderte hier stehen.");

  AddDetail( ({"wind"}),
	    "Da solltest Du doch wohl eher lauschen.");

   AddSmell(DEFAULT_SMELL, "Du riechst den frischen Wald und fuehlst Dich gleich besser als vorhin in dem "
                           "dunklen Tunnel.");  
 
  AddSmell( ({"wald"}),
	   "Der Wald riecht frischt. Du atmest tief ein und fuehlst Dich wohl.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Rascheln der Blaetter, wenn Du ueber sie gehst. Ausserdem den Wind, wie er "
                           "durch die Aeste weht."); 

  AddSound( ({"rascheln","blaetter","raschel"}),
	   "RASCHEL RASCHEL RASCHEL");

  AddSound( ({"wind","aeste"}),
	   "Die Aeste bewegen sich im Wind und man hoert wie die Aeste ab und zu aneinander schlagen.");

//-----Details Ende-----
  
AddExit("sueden", ROOM "zen48");
AddExit("nordwesten", ROOM "zen1");

}  
   
