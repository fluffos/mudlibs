// von Chivas
// 12.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>


void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Eine Strasse in Roch Adan");
  SetProp( P_INT_LONG,
	"Du befindest Dich auf einer Strasse in Roch Adan, die zwischen den Baumriesen "
	"vom Haupttor im Suedosten weiter in die Stadt hinein fuehrt. Die Baumriesen stehen nicht "
        "so dicht, so dass man ohne Probleme den Himmel erkennen kann. Ab und zu stolzieren "
	"Zentauren an Dir vorueber und mustern Dich kritisch. Die Strasse ist mit Gras "
        "bedeckt. Ab und zu erkennt man ein paar Hufabdruecke, aber auch Spuren von "
        "anderen Lebewesen. Es ist absolut windstill, die grossen Baeume scheinen den Wind "
        "abzuhalten. ");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

   
  AddDetail( ({"boden"}), 
            "Der Boden ist mit Gras bedeckt. Ausserdem erkennt man Hufabdruecke und andere Spuren.");

  AddDetail( ({"strasse","norden"}),
	    "Die Strasse fuehrt nach Suedosten Richtung Stadttor und nach Norden weiter in die Stadt hinein.");

  AddDetail( ({"roch adan","stadt","roch","adan"}),
	    "Die ist Roch Adan, die Stadt der Zentauren.");

  AddDetail( ({"baumriesen","baeume","baum","riesen","baeumen","baumes"}), 
            "Rings um Dich herum stehen Baumriesen. Ganz oben siehst Du riesige Aeste und Blaetter. "
            "In diesen Baeumen wohnen und arbeiten die Zentauren. "
            "Vor ein paar Baeumen sind sogar kleine Gaerten angelegt worden.");

  AddDetail( ({"haupttor","tor","stadttor","suedosten","richtung"}),
	    "Im Suedosten verlaesst Du Roch Adan wieder durch das Stadttor.");

  AddDetail( ({"zentauren","haelfte","mensch","pferd","pferde","wesen"}),
	    "Die Zentauren sind interessante Wesen, sie sind zur Haelfte Mensch und zur Haelfte Pferd."); 
  
  AddDetail( ({"gras"}), 
            "Die Strasse ist mit Gras bedeckt, es ist ein wenig niedergetrampelt. Die Halme sind umgeknickt.");

  AddDetail( ({"hufabdruecke","abdruecke"}),
	    "Die Hufabdruecke stammen sicher von den Zentauren, da es hier ansonsten keine Pferde gibt.");

  AddDetail( ({"spuren"}),
	    "Die Spuren stammen von anderen Lebewesen als den Zentauren. Sie stammen auch von Dir.");

  AddDetail( ({"lebewesen","abenteurer"}), 
            "Andere Abenteurer wie Du haben wohl die Spuren hinterlassen.");

  AddDetail( ({"himmel","probleme"}),
	    "Der Himmel ist blau und nur ein paar Wolken sind am Himmel zu sehen. Die Sonne scheint.");

  AddDetail( ({"sonne"}),
	    "Die Sonne scheint und waermt Dich angenehm."); 
  
  AddDetail( ({"wolken"}), 
            "Die Wolken zieh langsam am Himmel entlang. Auch ein paar Voegel ziehen ihre Kreise.");

  AddDetail( ({"voegel","kreise"}),
	    "Die Voegel am Himmel sind wohl ein paar Geier.");

  AddDetail( ({"halme"}),
	    "So etwas passiert halt, wenn viele die Strasse benutzen.");

  AddDetail( ({"gaerten"}), 
            "Die Gaerten sind sehr gepflegt. Du siehst in ihnen Beete, in denen die verschiedensten Sachen "
            "wachsen. Die Gaerten sind von kleinen Zaeunen umgeben.");

  AddDetail( ({"blumen"}),
	    "Die Blumen die Du in den Gaerten siehst sind Rosen und Begonien.");

  AddDetail( ({"beete","beeten","sachen"}),
	    "In den Beeten werden von den Zentauren des Baumes Blumen und Gemuese in der Erde angepflanzt."); 
  
  AddDetail( ({"gemuese"}), 
            "Du erkennst Karotten und Tomaten.");

  AddDetail( ({"karotten"}),
	    "Die Karotten sind sicher lecker.");

  AddDetail( ({"tomaten"}),
	    "Die Tomaten sind noch gruen und noch nicht reif.");

  AddDetail( ({"zaun","zaeunen","zaeune"}), 
            "Die Zaeune sind weiss gestrichen und umgeben die Gaerten vor den Baeumen der Zentauren.");

  AddDetail( ({"geier"}),
	    "Die Geier schweben weit oben am Himmel. Sie warten anscheinend auf ein paar Abenteurer, "
            "die sich mit den Zentauren anlegen.");

  AddDetail( ({"wind","windstill"}),
	    "Es ist absolut windstill, also kann man dies auch nicht untersuchen."); 
  
  AddDetail( ({"steine"}), 
            "Ganz normale Steine.");

  AddDetail( ({"aeste","ast"}),
	    "Wenn ein solcher Ast runter faellt, wuerde er Dich sicher erschlagen.");

  AddDetail( ({"blaetter","blatt"}),
	    "Die Blaetter sind genau so riesig wie der Baum selber.");

  AddDetail( ({"erde"}), 
            "Die Erde ist nicht die beste um etwas anzupflanzen. Es sind lauter Steine in der Erde.");

  AddDetail( ({"rosen","rot"}),
	    "Die Rosen sehen wunderschoen aus und bluehen in einem strahlenden Rot.");

  AddDetail( ({"begonien","knospen"}),
	    "Die Begonien haben noch nicht angefangen zu bluehen. Ihre Knospen sind noch geschlossen."); 
  
  AddSmell(DEFAULT_SMELL, "Es duftet nach den Rosen in den Gaerten.");  
 
  AddSmell( ({"rose","rosen"}),
	   "Die Rosen duften suesslich und erfrischend.");

  AddSound(DEFAULT_SOUND, "Du hoerst den ueblichen Laerm einer Stadt.");

  AddSound( ({"laerm","geschrei","kindern","tiere","leute"}),
	   "Du hoerst das Geschrei von Kindern, Leute hin und her laufen und ab und zu ein paar Tiere, die "
           "hier gehalten werden.");

//-----Details Ende-----

AddExit("suedosten", ROOM "zen13");  
AddExit("norden", ROOM "zen17");
AddExit("westen", ROOM "zennpc1");

}
   
