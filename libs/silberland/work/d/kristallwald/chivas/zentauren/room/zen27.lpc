// von Elro
// 09.3.2004
// 
// Raum meines Gesellenstueckes "Stadtweg - zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Park von Roch Adan");
  SetProp( P_INT_LONG,
	"Dies ist die Parkmitte, die ein wenig erhoeht ist, so dass man einen guten "
	"Rundumblick auf Roch Adan hat. Im Westen sieht man verschiedene Baeume, in denen "
	"Hoehlen und Laeden untergebracht sind. Im Norden erkennt man einen Baumriesen, "
	"der alle anderen Baeume, die auch riesig sind, bei weitem in den Schatten stellt. "
	"Im Osten sind wieder Baeume, in denen die Zentauren wohnen und arbeiten, und im "
        "Sueden erkennt man die Strasse, die zum Stadttor fuehrt. \n"
        "Direkt vor Dir steht eine Statue auf einem Podest und thront ueber dem ganzen "
        "Park, den man vor hier perfekt ueberblicken kann." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( ({"parkmitte","mitte","erhoehung"}), 
            "Dies ist die Parkmitte, sie ist etwas erhoeht und bietet einen sehr guten "
            "Ueberblick ueber die Stadt und den Park.");

  AddDetail( ({"park","eindruck","parks"}),
	    "Der Park macht einen sehr gepflegten Eindruck. Du kannst Brunnen "
            "im Park sehen, Rasenflaechen, Blumen und die Hecke, die den Park umgibt.");

  AddDetail( ({"roch adan","stadt","ueberblick","roch","adan","rundumblick"}),
	    "Von hier aus hat man einen sehr guten Ueberblick ueber Roch Adan. Man erkennt den "
            "restlichen Park und hinter der Hecke die Baeume in denen die Zentauren arbeiten "
            "und wohnen.");
  
  AddDetail( ({"statue","hand"}), 
            "Vor Dir in der Parkmitte steht eine Statue aus Bronze. Sie steht auf einem kleinen "
            "Podest und stellt einen Zentauren dar. Die Statue ist mit einem riesigen Schwert "
            "bewaffnet und haelt einen Schild in der Hand. Die Ruestung des Zentauren umschliesst "
            "den ganzen Koerper. Zu den Hufen des Zentauren liegt ein erschlagener Troll.");

  AddDetail( ({"hufen","hufe"}),
	    "Unter den Hufen liegt ein erschlagener Troll. Unter einem der Hufe scheint ein Stab "
            "eingeklemmt zu sein.");

  AddDetail( ({"stab","staebe"}),
	    "Vielleicht kannst Du den Stab abbrechen? Solche Staebe kann man immer gebrauchen. ");

  AddDetail( ({"podest","podestes","meter"}),
	    "Das Podest ist ca. einen halben Meter hoch und besteht aus Marmor. An der Vorderseite ist "
            "eine Plakette befestigt.");

  AddDetail( ({"plakette","vorderseite","geschehene","auskunft"}),
	    "An der Vorderseite des Podestes haengt ein Plakette, die aus purem Gold besteht. Auf ihr "
            "ist eine Inschrift zu erkennen."); 
  
  AddDetail( ({"inschrift"}), 
            "Du koenntest versuchen die Inschrift zu lesen.");

  AddDetail( ({"zentauren","kopf","huefte"}),
	    "Zentauren sind magische Geschoepfe, vom Kopf bis zur Huefte Menschen, "
            "darunter jedoch mit Pferdekoerper und -beinen versehen. Auf dem Podest vor Dir "
            "steht eine Statue von einem Zentauren.");

  AddDetail( ({"schwert","breitschwert"}),
	    "Das grosse Breitschwert der Statue glitzert in der Sonne.");

  AddDetail( ({"schild"}), 
            "Der Schild der Statue ist riesig und hat Verzierungen.");

  AddDetail( ({"verzierungen","verzierung"}), 
            "Die Verzierungen sind sehr filigran, aber ansonsten uninteressant.");

  AddDetail( ({"helm","gesicht"}),
	    "Der Helm der Statue laesst es nicht zu das Gesicht des Zentauren zu erkennen.");

  AddDetail( ({"ruestung"}),
	    "Die Ruestung des Zentauren ist bemerkenswert, sie umschliesst den menschlichen "
            "Oberkoerper und den Teil, der einem Pferd aehnelt nahezu perfekt. "); 
  
  AddDetail( ({"oberkoerper","menschen","pferd","pferdekoerper","koerper","geschoepfe","teil","pferdes","mensch","rest"}),
            "Zentauren sind halb Mensch und halb Pferd. Der Oberkoerper ist der eines Menschen "
            "und der Rest der Teil eines Pferdes.");

  AddDetail( ({"feind"}), 
            "Der Troll der erschlagen zu den Hufen der Statue liegt, scheint ein solcher gewesen zu sein.");

  AddDetail( ({"troll"}),
	    "Der Troll wurde von diesem Zentauren erschlagen und liegt zusammengekruemmt unter dem Zentauren. "
            "Vielleicht gibt die Plakette am Podest mehr Auskunft ueber das Geschehene.");

  AddDetail( ({"baumriesen","riesen","norden","schatten","baumriese"}),
	    "Der Baumriese im Norden ueberragt alle, die Du bisher gesehen hast. "
            "Um mehr zu sehen, solltest Du vielleicht naeher rangehen.");

  AddDetail( ({"baeume","westen","osten","hoehlen","laeden","kneipen","arbeitsstaette"}), 
            "Im Osten und Westen kannst Du Baeume erkennen, die die Zentauren als Hoehlen und "
            "Arbeitsstaette benutzen. Du kannst Laeden, Kneipen und noch andere Baeume erkennen.");

  AddDetail( ({"brunnen"}),
	    "Im Nordwesten und im Suedosten befindet sich jeweils ein Brunnen. Um sie naeher "
            "anzuschauen, sollte man schon hingehen.");

  AddDetail( ({"rasen","rasenflaechen","ausruhen","gras"}),
	    "Es gibt hier im Park sehr viele Rasenflaechen und der weiche Rasen laedt sicher "
            "einfach zum Ausruhen ein. Das Gras ist schoen gruen."); 
  
  AddDetail( ({"hecke"}), 
            "Die Hecke umgibt den ganzen Park.");

  AddDetail( ({"stadttor","tor","sueden","haupttor"}),
	    "Im Sueden erkennt man das Stadttor, durch das Du die Stadt betreten hast.");

  AddDetail( ({"strasse"}),
	    "Von der Erhoehung erkennt man die Strassen die an den Baeumen und der Hecke "
            "um den Park herum verlaeuft.");

  AddDetail( ({"gold"}), 
            "Die Plakette besteht aus purem Gold. Sie ist sicher einiges wert. Vielleicht kann "
            "man sie abreissen und einstecken.");

  AddDetail( ({"bronze"}),
	    "Die Statue besteht aus Bronze und ist hervorragend gearbeitet. Fast lebensecht.");

  AddDetail( ({"marmor"}),
	    "Das Podest besteht aus weissem Marmor und wurde sicher von weit her geholt."); 
  
  AddDetail( ({"sonne"}), 
            "Die Sonne steht fast senkrecht am Himmel und glitzert auf dem Schwert der Statue.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist fast wolkenlos. Nur einige weisse Wolken sind am Himmel zu sehen.");

  AddDetail( ({"wolken","regen"}),
	    "Weisse Wolken, mit Regen ist nicht zu rechnen.");

  AddDetail( ({"boden","weg"}), 
            "Der Weg, auf dem Du dich befindest, besteht aus kleinen Steinchen und wird vom Rasen "
            "eingegrenzt. Vor Dir auf dem Boden steht eine grosse Statue.");

  AddDetail( ({"steine","steinchen"}),
	    "Die Steine, die den Weg bilden sind kleine Kieselsteine.");

  AddDetail( ({"blumen","beeten","beete","bereichen"}),
	    "In den anderen Bereichen des Parks gibt es Beete mit Blumen.");

  AddDetail( ({"kieselsteine","detail"}),
	    "Dieses Detail wurde an die Oger Inc. vermietet."); 

  AddDetail( ({"oger","oger inc.","inc.","inc","firma","elfenohren","herstellung"}),
	    "Die Oger Inc. ist eine ehrenwerte Firma, die sich mit der Herstellung von gebackenen "
            "Elfenohren beschaeftigt."); 

  AddSmell(DEFAULT_SMELL, "Du riechst das Gras auf dem Rasen und die Blumen in den Beeten.");  
 
  AddSmell( ({"gras"}),
	   "Das Gras riecht frisch, als ob es gerade erst gemaeht wurde.");

  AddSmell( ({"blumen","suesslich"}),
	   "Die Blumen in den Beeten riechen suesslich.");

  AddSound(DEFAULT_SOUND, "Es ist sehr still im Park. Die Hecke haelt den Laerm von der Strasse fern.");

  AddSound( ({"laerm"}),
	   "Man hoert nur ab und zu etwas, aber nichts was verstaendlich ist.");

  AddReadDetail( ({"inschrift"}),
		"                   _______________________________\n"
                "                   |                             |\n"
                "                   |   Den Helden der Zentauren  |\n"
                "                   |                             |\n"  
                "                   |  Verteidiger von Roch Adan  |\n"
                "                   |   beim Angriff der Trolle   |\n"
                "                   |                             |\n"
                "                   |_____________________________|\n");



//-----Details Ende-----
AddItem(NPC "zentaurk1", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "zen27",
          P_MNPC_AREA:({ROOM "zen13", ROOM "zen16", ROOM "zen17",
                          ROOM "zen18", ROOM "zen19", ROOM "zen20",
                          ROOM "zen21", ROOM "zen22", ROOM "zen23",
                          ROOM "zen24", ROOM "zen25", ROOM "zen26",
                          ROOM "zen27", ROOM "zen28", ROOM "zen29",
                          ROOM "zen30", ROOM "zen31", ROOM "zen32",
                          ROOM "zen33", ROOM "zen34", ROOM "zen35",
                          ROOM "zen36", ROOM "zen37", ROOM "zen43",
                          ROOM "zenladen",ROOM "zenschmied"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );

AddExit("suedunten", ROOM "zen22");  
AddExit("ostunten", ROOM "zen28");
AddExit("westunten", ROOM "zen26");  
AddExit("nordunten", ROOM "zen32");

AddCmd( ({"reiss", "reisse" }), "reissen" );
AddCmd( ({"brech", "breche","brich" }), "brechen" );
AddCmd( ({"bitte" }), "bitten" );
}
int reissen(string str)
{
   notify_fail("Was moechtest Du abreissen?\n");
   if ( member( ({ "plakette ab", "plakette herunter" }),str) != -1) 
  {
    write(BS( "Du probierst die goldene Plakette abzureissen, laesst aber davon ab, als sich "
           "die Statue zu bewegen scheint.\n"));
    say( TPN+" probiert die Plakette abzureissen. Laesst dann aber eingeschuechtert davon ab.\n");
    return 1;
  }
}
int brechen(string str)
{
   notify_fail("Was moechtest Du abbrechen?\n");
   if ( member( ({ "stab", "stab ab" }),str) != -1) 
  {
    write(BS ( "Du probierst den Stab abzubrechen, schaffst es aber nicht. Vielleicht solltest "
               "Du die Statue einfach darum bitten."));
    say( TPN+" probiert krampfhaft einen Stab von der Statue zu brechen.\n");
    return 1;
  }

}  
int bitten(string str)
{
 object stab1;
 notify_fail("Wen willst Du um was bitten?\n");

 if(!str || str == "") return 0;
 if(!(str == "statue um stab" ||
      str == "zentauren um stab" )) return 0;

 if( str == "statue um stab" ||
     str == "zentauren um stab"){
    
  if(!present("astroinvis", TP) && !present("dragoninvis2", TP)){
	  
  write(BS("Du bist enttaeuscht. Die Statue reagiert momentan gar nicht auf Dich.\n"));
 
  say(TPN+" ist enttaeuscht.\n");
  return -1;
  }
  if(present("stab1", TP)){
	  
  write(BS("Da ist zwar noch ein Stab unter der Statue, aber den kannst Du nicht gebrauchen. "
           "Da musst Du schon wo anders nach weiteren Staeben suchen.\n"));
 
  say(TPN+" ist ein wenig faul zu forschen.\n");
  return -1;
  }

  write(BS("Du bittest die Statue und sie hebt ploetzlich den Huf, so dass Du ganz schnell den Stab "
	  "herausziehen kannst und ihn einsteckst.\n"));
 
  say(TPN+" scheint etwas von der Statue zu bekommen.\n");
  clone_object(OBJ "stab1")->move(TP, M_NOCHECK);
  return 1;
 }
}

