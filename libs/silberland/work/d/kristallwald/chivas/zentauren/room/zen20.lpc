// von Chivas
// 26.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>


void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einer Strasse in Roch Adan");
  SetProp( P_INT_LONG,
	"Du befindest Dich auf einer Strasse in Roch Adan, die zwischen den Baumriesen "
	"vom Haupttor im Sueden westlich zum Palast der Zentauren im Norden fuehrt. "
	"Oestlich befindet sich eine gepflegte Hecke, die die Strasse "
	"vom dahinterliegenden Park abtrennt. Die Strasse ist mit Gras bedeckt. Ab und "
	"zu erkennt man ein paar Hufabdruecke, aber auch Spuren von anderen Lebewesen. "
        "An einem Baumriesen im Westen haengt ein Schild ueber dem Eingang und bewegt "
        "sich leicht im Wind. ");
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----


  AddDetail( ({"boden"}), 
            "Der Boden ist mit Gras bedeckt und ein paar Steinchen sind zu erkennen. Einige kleine Pfuetzen "
            "sind vom letzten Regen noch da und machen den Boden doch ein wenig schlammig.");

  AddDetail( ({"strasse"}),
	    "Die Strasse fuehrt Dich westlich vom Park von Sueden, wo das Haupttor ist nach Norden "
            "zum Palast der Zentauren, den Du von hier aus jedoch noch nicht sehen kannst.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren. Dir gefaellt die Stadt mit ihren Baumriesen.");

  AddDetail( ({"baumriesen","riesen","baeumen","baeume"}), 
            "In den riesigen Baeumen wohnen und arbeiten die Zentauren. Ueber dem Eingang des Baumriesen "
            "im Westen haengt ein Schild und bewegt sich leicht im Wind.");

  AddDetail( ({"haupttor","tor","sueden"}),
	    "Da Haupttor im Sueden ist schon soweit weg, dass Du es nicht mehr sehen kannst.");

  AddDetail( ({"palast","norden"}),
	    "Der Palast der Zentauren ist noch zu weit weg. Geh hin und schau ihn Dir an."); 
  
  AddDetail( ({"zentauren","wesen","mensch","pferd","einwohner","einwohnern"}), 
            "Die Zentauren sind magische Wesen. Sie sind halb Mensch und halb Pferd. Sie sind die Einwohner "
            "dieser Stadt.");

  AddDetail( ({"hecke","osten","moeglichkeit"}),
	    "Im Osten grenzt eine grosse Hecke die Strasse vom Park ab. Du hast hier keine Moeglichkeit den "
            "Park zu erreichen.");

  AddDetail( ({"park","mittelpunkt"}),
	    "Der Park befindet sich hinter der Hecke und ist der Mittelpunkt von Roch Adan. Er soll sehr schoen "
            "sein und Du beschliesst spaeter einmal hinzu gehen und ihn Dir anzuschauen.");

  AddDetail( ({"gras"}), 
            "Das Gras auf der Strasse ist von den vielen Besuchern und Einwohnern der Stadt ziemlich "
            "niedergetrampelt. Ein paar Steinchen liegen zwischen dem Gras.");

  AddDetail( ({"steinchen"}),
	    "An den Steinchen gibt es eigentlich nichts besonderes zu entdecken.");

  AddDetail( ({"pfuetzen","regen"}),
	    "Die Pfuetzen sind wohl vom letzten Regen noch uebrig und es ist kaum noch Wasser drin. "
            "Die Wolken die momentan am Himmel zu sehen sind, sind schneeweiss."); 
  
  AddDetail( ({"hufabdruecke","abdruecke","pferde"}), 
            "Die Abdruecke stammen sicher von den Zentauren, da Du hier bisher keine Pferde gesehen hast.");

  AddDetail( ({"spuren","lebewesen","besuchern","besucher","abenteurern","abenteurer"}),
	    "Die Spuren stammen sicher von Abenteurern wie Dir oder auch von ganz normalen Besuchern der Stadt.");

  AddDetail( ({"westen","baumriese","kneipe","schlueckchen"}),
	    "Der Baumriese im Westen scheint eine Kneipe zu sein. Vielleicht solltest Du reingehen und ein "
            "Schlueckchen zu Dir nehmen. Ueber dem Eingang haengt ein grosses Schild. ");

  AddDetail( ({"schild"}), 
            "Das Schild bewegt sich leicht im Wind. Du kannst es lesen.");

  AddDetail( ({"eingang"}),
	    "Ueber dem Eingang haengt ein Schild, was sich leicht im Wind bewegt.");

  AddDetail( ({"wind","lueftchen"}),
	    "Man kann eigentlich nicht von Wind reden, es ist wohl eher ein Lueftchen."); 
  
  AddDetail( ({"himmel"}), 
            "Der Himmel ist blau, ein paar Wolken ziehen an ihm entlang und die Sonne steht fast senkrecht.");

  AddDetail( ({"wolken"}),
	    "Die Wolken sind schneeweiss. Es sieht nicht nach Regen aus.");

  AddDetail( ({"sonne"}),
	    "Die Sonne steht fast senkrecht am Himmel und waermt Dich.");

  AddDetail( ({"wasser"}), 
            "Man kann eigentlich nicht mehr so richtig von Wasser reden. Es ist doch eher Schlamm.");

  AddDetail( ({"schlamm"}),
	    "Der Schlamm ist richtig pampig und macht die Strasse ein wenig rutschig.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");


  AddSmell(DEFAULT_SMELL, "Du riechst Alkohol aus dem Baumriesen im Westen.");  
 
  AddSmell( ({"alkohol"}),
	   "Es scheint eine Kneipe im Westen zu sein. Vielleicht solltest Du auf ein Schlueckchen rein gehen.");

  AddSound(DEFAULT_SOUND, "Du hoerst Lachen und Gemurmel aus dem Baumriesen im Westen.");

  AddSound( ({"lachen","gemurmel","gaeste","gaesten"}),
	   "Das Lachen und Gemurmel stammt anscheinend von Gaesten der Kneipe.");
  
  AddReadDetail( ({"schild"}),
		"Zum Baumriesen");

//-----Details Ende-----

AddExit("suedosten", ROOM "zen17");  
AddExit("westen", ROOM "zen43");
AddExit("norden", ROOM "zen25");

}

