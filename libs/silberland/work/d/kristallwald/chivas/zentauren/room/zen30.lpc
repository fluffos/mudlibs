// von Elro
// 09.3.2004
// 
// Raum meines Gesellenstueckes "Stadtweg - zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>


void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einer Strasse in Roch Adan");
  SetProp( P_INT_LONG,
	"Du befindest Dich auf einer Strasse in Roch Adan, die zwischen den Baumriesen "
	"vom Haupttor im Sueden westlich zum Palast der Zentauren im Norden fuehrt. "
	"Oestlich befindet sich eine gepflegte Hecke, die die Strasse "
	"vom dahinterliegenden Park abtrennt. Die Strasse ist mit Gras bedeckt. Ab und "
	"zu erkennt man ein paar Hufabdruecke, aber auch Spuren von anderen Lebewesen. ");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----


  AddDetail( ({"strasse"}), 
            "Die Strasse fuehrt Dich weiter in die Stadt hinein, sie ist sehr gepflegt. Der "
            "Boden ist mit Gras bedeckt und man sieht einige Abdruecke auf dem Boden. Im Nordwesten "
            "endet die Strasse auf einem Markt.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren. Du befindest Dich momentan in ihr.");

  AddDetail( ({"baumriesen","riesen","baeume","baum"}),
	    "Die Baumriesen stehen westlich von Dir. In ihnen leben und arbeiten die Zentauren. Sie sind "
            "riesengross und solche grossen Baeume findest Du sonst nirgendwo im Silberland.");

  AddDetail( ({"haupttor","tor","sueden"}), 
            "Die Strasse fuehrt im Sueden zum Haupttor. Du bist durch das Tor in die Stadt gekommen.");

  AddDetail( ({"palast","norden"}),
	    "Im Norden befindet sich der Palast der Zentauren. Es soll der groesste Baum im Silberland sein.");

  AddDetail( ({"zentauren","mensch","pferd","oberkoerper","rest","pferdes"}),
	    "Die Zentauren sind halb Mensch und halb Pferd. Ihr Oberkoerper ist menschlich. Der Rest ist der "
            "eines Pferdes."); 
  
  AddDetail( ({"hecke","laerm"}), 
            "Die Hecke im Osten umschliesst den Park, der sich in der Mitte von Roch Adan befindet. Sie haelt den "
            "Laerm der Strasse vom Park fern, so dass man sich dort hervorragend entspannen kann.");

  AddDetail( ({"park","mitte","mittelpunkt","punkt"}),
	    "Der Park befindet hinter der Hecke und bildet den Mittelpunkt von Roch Adan. Du solltest spaeter "
            "mal hingehen und Dich einfach ausruhen.");

  AddDetail( ({"gras","wunder","leute"}),
	    "Das Gras ist ein bisschen niedergetrampelt, was jedoch auch kein Wunder ist, wenn viele "
            "Leute ueber die Strasse gehen.");

  AddDetail( ({"boden"}), 
            "Der Boden ist mit Gras bedeckt. Man erkennt einige Hufabdruecke und verschiedene andere Spuren.");

  AddDetail( ({"hufabdruecke","abdruecke"}),
	    "Du siehst Hufabdruecke der Zentauren auf dem Boden. Sie stammen sicher nicht von Pferden, da Du hier "
            "noch keins gesehen hast.");

  AddDetail( ({"spuren","lebewesen","abenteurern"}),
	    "Die Spuren stammen von anderen Abenteurern wie Du, die diese wunderschoene Stadt besucht haben."); 
  
  AddDetail( ({"himmel"}), 
            "Der Himmel ist blau, nur ein paar Wolken sind zu sehen und die Sonne die fast senkrecht am Himmel "
            "steht.");

  AddDetail( ({"sonne"}),
	    "Die Sonne waermt Dich angenehm.");

  AddDetail( ({"wolken"}),
	    "Die Wolken ziehen vom Wind leicht getrieben am Himmel entlang. Auch ein paar Voegel ziehen ihre "
            "Bahnen.");

  AddDetail( ({"voegel","bahnen"}), 
            "Die Voegel fliegen zu hoch um genau zu erkennen, um was fuer Voegel es sich handelt.");

  AddDetail( ({"luecke"}),
	    "Die Luecke ist sehr klein, die Zweige und Blaetter verdecken sie fast. Vielleicht "
            "solltest Du die Zweige beiseite biegen um mehr sehen zu koennen.");

  AddDetail( ({"blaetter"}),
	    "Die Blaetter der Hecke sind sehr klein und rund. Ansonsten kann man an ihnen nicht viel erkennen."); 
  
  AddDetail( ({"nest"}), 
            "Das Nest ist mit vier Eiern gefuellt.");

  AddDetail( ({"eiern","eier","kuecken","ruhe"}), 
            "Die Eier werden anscheinend gerade ausgebruetet. Die Vogelmama ist wohl gerade was essen. Huch, ein "
            "Ei wackelt. Es wird gleich ein Kuecken schluepfen. Du sollte das Nest nun in Ruhe lassen");

  AddDetail( ({"zweige"}),
	    "Du solltest die Zweige beiseite biegen um zu sehen was in der Luecke zu finden ist.");

  AddDetail( ({"silberland"}), 
            "Du bist im Silberland und Du findest es absolut super hier.");

  AddDetail( ({"nordwesten"}),
	    "Im Nordwesten befindet sich der Markt von Roch Adan.");

  AddDetail( ({"markt"}),
	    "Auf dem Markt scheint ziemlich was los zu sein. Einige Haendler, die ihre Waren anbieten, laufen "
            "wild umher."); 
  
  AddDetail( ({"haendler"}), 
            "Um die Haendler besser zu beobachten, solltest Du nach Nordwesten gehen.");

  AddDetail( ({"waren"}),
	    "Was fuer Waren es sind, die die Haendler verkaufen, kannst Du von hier aus nicht sehen. Geh doch "
            "einfach hin und schau nach.");

  AddDetail( ({"wind","zwitschern"}),
	    "Du solltest doch lieber lauschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst die eigenartigen Waren im Nordwesten, die dort auf dem Markt angepriesen "
                          "werden.");  
 
  AddSmell( ({"waren"}),
	   "Die Waren riechen von wuerzig bis suess. Du solltest naeher ran gehen und sie Dir genauer ansehen.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind, wie er sanft ueber die Hecke streicht und die Blaetter zum Rascheln "
                          "bringt.");

  AddSound( ({"rascheln"}),
	   "Der Wind weht leicht ueber die Hecke, dabei bringt der Wind die Blaetter zum Rascheln. Ausserdem "
           "hoerst Du ein leises Zwitschern in der Hecke.");
  
  AddSound( ({"zwitschern"}),
		"Das Zwitschern scheint aus der Hecke zu kommen. Ploetzlich faellt Dir auch eine kleine Luecke "
                "zwischen den Zweigen auf.");

//-----Details Ende-----

AddExit("sueden", ROOM "zen25");  
AddExit("nordosten", ROOM "zen35");

AddCmd( ({"biege", "bieg" }), "biegen" );

}
int biegen(string str)
{
   notify_fail("Was moechtest Du beiseite biegen?\n");
   if ( member( ({ "zweige", "zweige beiseite" }),str) != -1) 
  {
    write( "Du biegst die Zweige beiseite und findest ein kleines Nest.\n");
    say( TPN+" biegt ein paar Zweige an der Hecke beiseite.\n");
    return 1;
  }
}

