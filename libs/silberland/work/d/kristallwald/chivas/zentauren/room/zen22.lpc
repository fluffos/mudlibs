// von Chivas
// 31.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>


void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Park von Roch Adan");
  SetProp( P_INT_LONG,
	"Du befindest Dich im Park von Roch Adan, ein schoener Park, in dem man sich "
        "schoen erholen und Ruhe finden kann, da die Hecke, die rund um den Park fuehrt, " 
        "den Laerm der Strassen zurueckhaelt. Der Weg, der durch den Park fuehrt, ist mit "
        "kleinen Steinchen angelegt worden und fuehrt in verschiedene Richtungen. Im "
        "Suedwesten und Suedosten verlaesst man den Park Richtung Strasse." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----
  AddDetail( ({"park","boden"}), 
            "Du stehst im Park von Roch Adan. Du erkennst die Wege, die sich durch den Park "
            "schlaengeln, grosse Rasenflaechen und Beete in denen Blumen wachsen. Im Norden "
            "geht es zur Parkmitte, die auf einer Erhoehung sich befindet und im Osten "
            "kannst Du einen Brunnen sehen.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren.");

  AddDetail( ({"himmel","sonne"}),
	    "Der Himmel ist schoen blau und die Sonne waermt Dich.");

  AddDetail( ({"ruhe","plaetzchen","eingaengen"}),
	    "Ruhe kann man sicher hier im Park finden, aber Du solltest doch weiter in den Park gehen. "
            "Such Dir ein Plaetzchen weiter weg von der Strasse und den Eingaengen in der Hecke.");

  AddDetail( ({"hecke","moeglichkeit"}), 
            "Die Hecke umschliesst den kompletten Park, bis auf ein paar Eingaenge die einem die Moeglichkeit "
            "geben, den Park zu betreten.");

  AddDetail( ({"laerm"}),
	    "Da solltest Du besser lauschen.");

  AddDetail( ({"strassen","strasse"}),
	    "Die Strasse siehst Du im Suedosten und Suedwesten vom Park."); 
  
  AddDetail( ({"weg","wege"}), 
            "Der Weg ist mit kleinen Steinchen ausgelegt und schlaengelt sich in drei Richtungen weiter durch den "
            "Park.");

  AddDetail( ({"steinchen"}),
	    "Kleine Steinchen, an denen nichts besonderes ist.");

  AddDetail( ({"richtungen"}),
	    "Die Wege fuehren in verschiedene Richtungen.");

  AddDetail( ({"suedosten","suedwesten","richtung"}), 
            "In Richtung Suedosten und Suedwesten erreicht man die Strasse.");

  AddDetail( ({"rasenflaechen","rasen","flaechen"}),
	    "Die Rasenflaechen sind gerade erst gemaeht wurden. Das Gras ist ganz kurz.");

  AddDetail( ({"gras"}),
	    "Das Gras ist schoen kurz gemaeht."); 
  
  AddDetail( ({"beete","beeten"}), 
            "In den Beeten wachsen schoene Blumen.");

  AddDetail( ({"blumen"}),
	    "Du siehst Veilchen, Rosen, und Lilien.");

  AddDetail( ({"veilchen"}),
	    "Kleine niedliche Veilchen, die wunderschoen blau bluehen.");

  AddDetail( ({"rosen","zuechtungen","arten"}), 
            "Die Rosen sind besonders gross und sehen anders aus als die Arten, die Du kennst. "
            "Es sind sicher eigene Zuechtungen der Zentauren.");

  AddDetail( ({"lilien","gelb"}),
	    "Die Lilien bluehen in einem strahlendem Gelb.");

  AddDetail( ({"parkmitte","norden","mitte"}),
	    "Die Parkmitte befindet sich im Norden. Sie ist auf einer kleinen Erhoehung."); 
  
  AddDetail( ({"erhoehung"}), 
            "Auf der Erhoehung siehst Du eine Statue.");

  AddDetail( ({"statue"}),
	    "Um die Statue genauer zu betrachten, solltest Du schon hingehen.");

  AddDetail( ({"osten"}),
	    "Im Osten ist ein Brunnen.");

  AddDetail( ({"brunnen"}), 
            "Der Brunnen ist zu weit weg um mehr zu erkennen.");

  AddDetail( ({"zukunft"}),
	    "Das willst Du nicht wirklich wissen.");

  AddDetail( ({"kopf"}),
	    "Du hast einen, benutzt ihn aber nicht so oft."); 
  
  AddDetail( ({"huefte","menschen","planeten","bewegungen","pferdekoerper","eingaenge","ausgaenge","geschoepfe"}), 
            "Du untersuchst aber wirklich alles.");

  AddDetail( ({"zentaur","zentauren"}),
	    "Zentauren sind magische Geschoepfe, vom Kopf bis zur Huefte Menschen, "
            "darunter jedoch mit Pferdekoerper und -beinen versehen. Man erzaehlt "
            "sich ueber sie, dass sie die Zukunft in den Bewegungen der Planeten "
            "am Himmel lesen koennen. ");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");


  AddSmell(DEFAULT_SMELL, "Du riechst die Blumen im Park.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen duften herrlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Laerm auf der Strasse und ein Plaetschern im Osten.");

  AddSound( ({"laerm"}),
	   "Der Laerm der Strasse kannst Du hier noch sehr gut hoeren, da die Hecke halt zwei Ausgaenge "
           "oder Eingaenge hat. Es ist aber nur der uebliche Laerm wie in jeder Stadt. Uninteressant.");
  
  AddSound( ({"plaetschern"}),
	   "Das Plaetschern kommt von einem Brunnen im Osten. Geh doch einfach mal hin.");

//-----Details Ende-----

AddExit("osten", ROOM "zen23"); 
AddExit("suedosten", ROOM "zen19");
AddExit("westen", ROOM "zen21");  
AddExit("suedwesten", ROOM "zen17");
AddExit("nordoben", ROOM "zen27");

}  
   
