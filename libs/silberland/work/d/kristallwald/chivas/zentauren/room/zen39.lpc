// von Chivas
// 09.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>
#include <defines.h>
#include  <moving.h>

int fledermausda;

void create()
	
{
  ::create();

   fledermausda=1; 

  SetProp( P_INT_SHORT, "Im Palast der Zentauren");
  SetProp( P_INT_LONG,
	"Die Eingangshalle des Palastes ist riesig, sogar Drachen koennten hier eine Party "
	"feiern. Der Boden ist wie in allen Baeumen der Zentauren mit Reisig bedeckt. Die "
	"Waende schimmern hier im Innern silbern und sind mit Wandteppichen behaengt. Die "
	"Decke ist soweit ueber Dir, dass Du Dich nicht traust zu schaetzen, wie hoch sie "   
        "ist. An ihr haengt wohl der groesste Kronleuchter des ganzen Silberlandes mit "
	"tausenden von brennenden Kerzen. Wirklich beeindruckend. \n"
        "Nach Norden kommst Du in den Thronsaal, nach Osten und Westen geht es in andere "
        "Bereiche des Palastes. Durch das Tor in der Suedwand verlaesst man den Baum "
        "wieder. ");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden"}), 
            "Der Boden ist mit Reisig bedeckt und daempft ein wenig in der grossen Halle das "
            "Echo. Unter dem Reisig kann man grosse Steinplatten erkennen.");

  AddDetail( ({"echo"}), 
            "Da Du Dich natuerlich nicht zurueckhalten kannst probierst Du es natuerlich aus. "
            "Das Echo grummelt Dich jedoch nur boese an und Du laesst es.");

  AddDetail( ({"steinplatten","stein","platten","stellen"}), 
            "Die Steinplatten sind von Reisig bedeckt. Man kann sie nur an ein paar Stellen "
            "sehen. Sie sind sauber verfugt.");

  AddDetail( ({"tor","suedwand"}), 
            "Durch das Tor in der Suedwand kann man den Palast wieder verlassen.");

  AddDetail( ({"decke"}), 
            "Die Decke ist sehr hoch, Du traust Dich nicht einzuschaetzen wie hoch sie ist. "
            "An der Decke haengt ein riesiger Kronleuchter.");

  AddDetail( ({"fugen","fuge"}), 
            "Die Steinplatten sind sauber verfugt. Hier kann man nichts interessantes finden.");

  AddDetail( ({"palast","palastes"}),
	    "Dies ist der Palast der Zentauren. Du befindest Dich momentan in der Eingangshalle.");

  AddDetail( ({"eingangshalle","halle","eingang"}), 
 	"Die Eingangshalle des Palastes ist riesig, sogar Drachen koennten hier eine Party "
	"feiern. Der Boden ist wie in allen Baeumen der Zentauren mit Reisig bedeckt. Die "
	"Waende schimmern hier im Innern silbern und sind mit Wandteppichen behaengt. Die "
	"Decke ist soweit ueber Dir, dass Du Dich nicht traust zu schaetzen, wie hoch sie "   
        "ist. An ihr haengt wohl der groesste Kronleuchter des ganzen Silberlandes mit "
	"tausenden von brennenden Kerzen. Wirklich beeindruckend. \n"
        "Nach Norden kommst Du in den Thronsaal, nach Osten und Westen geht es in andere "
        "Bereiche des Palastes. Durch das Tor in der Suedwand verlaesst man den Baum "
        "wieder. ");

  AddDetail( ({"drachen","groesse"}),
	    "Hier gibt es natuerlich keine Drachen, es war bildlich gemeint um die Groesse der Halle "
            "darzustellen.");

  AddDetail( ({"party"}),
	    "Hier koennte man eine riesige tolle Party feiern. Hoffentlich wirst Du dazu mal eingeladen.");
  
  AddDetail( ({"reisig"}),
	    "Der Boden ist mit Reisig bedeckt. Unter dem Reisig siehst Du Steinplatten.");

  AddDetail( ({"baeumen","baeume","baum"}),
	    "Du befindest Dich im groessten aller Baeume in Roch Adan, dem Palast der Zentauren.");

  AddDetail( ({"stadt","roch adan","roch","adan","weg"}),
	    "Roch Adan ist die Stadt der Zentauren. Du bist durch sie durchgelaufen auf dem Weg zum Palast.");

  AddDetail( ({"waende","innern","wand"}),
	    "Die Waende schimmern leicht und es sieht nicht aus wie in einem Baum. An den Waenden haengen "
            "viele grossse Wandteppiche. In einer Ecke faellt Dir Etwas auf.");

  AddDetail( ({"verzierungen","geschichte"}), 
            "Die Verzierungen sind wunderschoen. Anscheinend stellen sie die Geschichte der "
            "Zentauren dar. Vielleicht findest Du ja einen Zentauren im Palast, der Dir mehr ueber "
            "die Geschichte der Zentauren erzaehlt.");

  AddDetail( ({"bereiche","osten","westen","schalter"}), 
            "Nach Osten und Westen geht es in andere Bereiche des Palastes. Im Osten scheint "
            "es irgendwie mystisch zu sein. Im Westen scheinen Schalter zu sein, wo man etwas "
            "beantragen kann.");

  AddDetail( ({"ecke","etwas","blick"}),
	    "So etwas hast Du noch nie gesehen. Auf den ersten Blick sieht es aus wie eine Ritterruestung.");

  AddDetail( ({"ritter","ritterruestung","ruestung"}),
	    "Die Ritterruestung unterscheidet sich komplett von allen Ruestungen die Du bisher "
            "gesehen hast. Sie scheint nur einem Zentauren zu passen. Der Helm scheint ein wenig zu wackeln.");

  AddDetail( ({"helm","visier"}),
	    "Der Helm wackelt wirklich ein wenig, vielleicht kannst Du das Visier hochklappen.");

  AddDetail( ({"wandteppichen","teppiche","wandteppiche"}),
	    "Die Wandteppiche haengen an den Waenden und sind riesig gross. Sie haben reiche Verzierungen "
            "und sind sicher sehr wertvoll.");

  AddDetail( ({"zentaur","zentauren","geschoepfe","kopf","huefte","menschen","beweis","pferdekoerper","zukunft","bewegungen","planeten"}),
	    "Zentauren sind magische Geschoepfe, vom Kopf bis zur Huefte Menschen, "
            "darunter jedoch mit Pferdekoerper und -beinen versehen. Man erzaehlt "
            "sich ueber sie, dass sie die Zukunft in den Bewegungen der Planeten "
            "am Himmel lesen koennen. ");

  AddDetail( ({"himmel"}),
	    "Wenn Du den Himmel sehen willst, dann geh einfach raus. ");

  AddDetail( ({"kinder","schabernack","wachen"}),
	    "Ein paar Kinder der Zentauren treiben hier im Palast ab und zu "
            "Schabernack. Deswegen werden sie meistens von den Wachen "
            "vertrieben. ");

  AddDetail( ({"kronleuchter","leuchter"}),
	    "Der Kronleuchter ist riesig. An ihm brennen tausende von Kerzen in einem magischen Blau. "
            "Er ist sicher der groesste Kronleuchter im Silberland.");

  AddDetail( ({"silberland","silberlandes","freude"}),
	    "Hier im Silberland gefaellt es Dir einfach super. Du huepfst vor Freude durch die Halle.");

  AddDetail( ({"kerzen","kerze","blau"}),
	    "Die Kerzen an dem grossen Kronleuchter sind ebenso gross. Sie brennen in einem magischen "
            "Blau. Ein weitere Beweis, dass Zentauren magische Geschoepfe sind.");

  AddDetail( ({"thronsaal","norden"}),
	    "Der Thronsaal befindet sich im Norden der Halle.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach dem Reisig am Boden, dem Wachs der Kerzen und ein leichter "
                          "Alkoholgeruch liegt in der Luft.");  
 
  AddSmell( ({"reisig","boden"}),
	   "Das Reisig am Boden riecht frisch, als ob es vor kurzem ausgetauscht wurde.");

  AddSmell( ({"alkoholgeruch","alkohol","geruch","luft"}),
	   "Anscheinend wurde vor kurzem hier ein Party gefeiert und der Alkohol haengt noch in der Luft.");
  
  AddSmell( ({"wachs"}),
	   "Es riecht nach Wachs von den Kerzen.");
  
  AddSound(DEFAULT_SOUND, "Du hoerst die Zentauren die hier im Palast arbeiten.");

  AddSound( ({"zentauren"}),
	   "Hier arbeiten viele Zentauren, Du hoerst wie sie ihren Geschaeften nachgehen.");
  
  AddSound( ({"geschaeften","staub"}),
	   "Manche wischen Staub, andere putzen hier und da.");

//-----Details Ende-----
AddItem(NPC "palastwache", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "zen39",
          P_MNPC_AREA:({ROOM "zen38",ROOM "zen39",ROOM "zen40",ROOM "zen41"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
AddItem("/obj/sehertor", REFRESH_REMOVE,(["rw_sehertor_disc": 0]) );

AddExit("sueden", ROOM "zen42");  
AddExit("osten", ROOM "zen40");  
AddExit("westen", ROOM "zen38");  
AddExit("norden", ROOM "zen41");
AddSpecialExit( "oben", "go_oben" );




AddCmd( ({"klapp", "klappe" }), "klappen" );

}
void reset()
{
  ::reset();
  fledermausda=1;
  
}

int klappen (string str)
{
  object fledermaus;
  notify_fail ("Was moechtest Du aufklappen?\n");

  if(!str || str == "klappe visier auf") return 0;
  
  if(!(str == "visier zurueck","visier auf","visier hoch" )) return 0;
  if (present("CHIVASFLEDERMAUS",TO) || !fledermausda)

  {
    write(BS("Du erkennst nicht besonderes, Du hast Dich sicher getaeuscht."));
    return -1;
  }
  write(BS("Du klappst das Visier auf und erschreckst.\n"));
  fledermausda=0;
  fledermaus = clone_object (NPC "fledermaus" );
  fledermaus->move(TO,M_GO|M_NOCHECK,"fliegt aus der Ruestung");
  return 1;
}
int go_oben(string dir)
{

  if(!(present("garlog", TO)))
  {
    write( BS( "Eine Zentaurenwache laesst Dich momentan noch nicht "
	       "nach Oben gehen.") );
    say("Eine Zentaurenwache laesst "+TP->Name(WEN)+" momentan "
      "nicht nach oben gehen.\n");
    return -1;
  }
}
