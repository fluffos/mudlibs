// von Chivas
// 31.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>


void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Park von Roch Adan");
  SetProp( P_INT_LONG,
	"Du bist im Osten des Parks, es ist eine Mischung aus Rasenflaechen und "
        "Blumenbeeten. Der Weg, der durch den Park fuehrt, ist mit Steinchen angelegt " 
        "worden und fuehrt an der Hecke entlang, die den Park von der dahinterliegenden "
        "Strasse abtrennt. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----
  AddDetail( ({"boden"}), 
            "Auf dem Boden sieht man die fruchtbare Erde der Beete, gut gemaehten Rasen und Steinchen auf dem Weg.");

  AddDetail( ({"zentauren","wesen","mensch","pferd"}),
	    "Die Zentauren sind magische Wesen. Sie sind halb Mensch und halb Pferd.");

  AddDetail( ({"osten","park","stadtpark","stadtparks","teil"}),
	    "Du bist im oestlichen Teil des Stadtparks.");

  AddDetail( ({"roch","adan","roch adan","stadt"}), 
            "Roch Adan ist die Stadt der Zentauren.");

  AddDetail( ({"mischung"}),
	    "Halt eine Mischung von Beeten und Rasenflaechen.");

  AddDetail( ({"hecke"}),
	    "Die grosse Hecke umgibt den gesamten Park von Roch Adan und trennt den Park von der Strasse ab."); 
  
  AddDetail( ({"strasse"}), 
            "Die Strasse ist hinter der Hecke und Du kannst sie durch die Hecke nicht sehen.");

  AddDetail( ({"luecke"}),
	    "Die Luecke in der Hecke ist sehr klein und kaum zu sehen. Aber vielleicht kannst Du Dich da "
            "durchzwaengen.");

  AddDetail( ({"erde"}),
	    "Die Erde ist sehr fruchtbar, was man daran sieht, dass die Blumen sehr gut gedeihen.");

  AddDetail( ({"rasenflaechen","rasen","flaechen","rasenflaeche","flaeche"}), 
            "Du siehst grosse Rasenflaechen, die anscheinend vor kurzer Zeit gemaeht worden sind. Ein paar "
            "Personen machen gleich bei der Hecke ein Picknick.");

  AddDetail( ({"blumenbeete","beete","blumenbeeten","beeten"}),
	    "Zwischen den Wegen und den Rasenflaechen sind kleine Blumenbeete angelegt, in denen viele Blumen "
            "wachsen.");

  AddDetail( ({"blumen","arten"}),
	    "Es sind verschiedene Blumen. Du siehst Veilchen, Tulpen, Rosen und andere Arten, die Du nicht kennst.");

  AddDetail( ({"wege","weg"}),
	    "Die Wege im Park sind sehr gepflegt. Sie bestehen aus lauter kleinen Steinen.");

  AddDetail( ({"steinen","steine","steinchen"}), 
            "Ganz normale Steine, nichts besonderes.");

  AddDetail( ({"sonne"}), 
            "Die Sonne strahlt vom Himmel und waermt Dich.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau, nur ein paar Wolken sind zu sehen, die jedoch nicht die Sonne verdecken.");

  AddDetail( ({"wolken"}),
	    "Die Wolken sind schoen weiss."); 
  
  AddDetail( ({"personen","abenteurer"}), 
            "Es sind ein paar Abenteurer wie Du, die sich im Park ausruhen und die Sonne geniessen. Sie haben "
            "eine grosse Decke ausgebreitet, auf der sie sich niedergelassen haben.");

  AddDetail( ({"picknick","spass"}),
	    "Das Picknick scheint Spass zu machen. Die Personen lachen und freuen sich.");

  AddDetail( ({"zeit"}),
	   "Davon hat man nie genug.");

  AddDetail( ({"decke"}),
	    "Die Decke ist recht gross und hat lauter Karos aufgemalt. Ansonsten ist die Decke auf der die "
            "Personen sitzen uninteressant.");

  AddDetail( ({"karos","arbeit"}), 
            "Die Karos sind sehr klein und es muss eine schwere Arbeit gewesen sein, die Karos auf die Decke "
            "zu sticken.");

  AddDetail( ({"veilchen"}), 
            "Kleine blaue Veilchen wachsen in den Beeten.");

  AddDetail( ({"tulpen"}),
	    "Die Tulpen sind gelb und rot und gedeihen hervorragend.");

  AddDetail( ({"rosen","zuechtungen"}),
	    "Die Rosen sind etwas ganz besonderes. Du hast solche noch nie gesehen. Es scheinen eigene "
            "Zuechtungen der Zentauren zu sein."); 
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  

  AddSmell(DEFAULT_SMELL, "Du riechst den das Gras auf dem Rasen und die Blumen.");  
 
  AddSmell( ({"gras"}),
	   "Das Gras riecht, als ob es gerade erst gemaeht wurde.");

  AddSmell( ({"blumen"}),
	   "Die Blumen riechen suesslich.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Bienen, die zwischen den Blumen umher fliegen.");

  AddSound( ({"bienen","summ"}),
	   "SUMM SUMM SUMM SUMM SUMM SUMM");

//-----Details Ende-----

AddExit("sueden", ROOM "zen23");  
AddExit("westoben", ROOM "zen27");  
AddExit("norden", ROOM "zen33");

AddCmd( ({"zwaeng", "zwaenge" }), "zwaengen" );

}
int zwaengen(string str)
{
   notify_fail("Wodurch willst Du Dich zwaengen?\n");
   if ( member( ({ "durch hecke", "durch luecke" }),str) != -1) 
  {
    write(BS ( "Du zwaengst Dich durch die Hecke und stehst ploetzlich auf der Strasse."));
    say( TPN+" macht was an der Hecke und verschwindet.\n");
    TP->move( ROOM "zen29", M_GO, "osten");
    return 1;
  }

}
   
