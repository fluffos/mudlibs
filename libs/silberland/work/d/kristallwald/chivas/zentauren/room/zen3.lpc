// von Elro
// 09.3.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>


void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Waldweg");
  SetProp( P_INT_LONG,
	"Der Wald wirkt sehr friedlich und idyllisch, die Baeume bewegen sich leicht im "
	"Wind, und es wirkt sehr beruhigend, hier spazieren zu gehen. Der Waldboden ist "
	"mit Nadeln und Blaettern bedeckt und raschelt wenn man auf ihm geht. Am Wegrand "
	"sind auch kleinere junge Baeume und Straeucher zu sehen. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden","erde","waldboden"}), 
            "Der Boden ist erdig wie ein normaler Waldweg, er ist von Nadeln und Blaettern "
            "bedeckt. Von Zeit zu Zeit trifft ein Lichtstrahl durch das dichte Blaetterdach "
            "den Boden, wo ein wenig Gras waechst.");

  AddDetail( ({"weg","waldweg","suedosten"}),
	    "Der Waldweg ist von jungen Baeumen gesaeumt und fuehrt Dich "
	    "weiter nach Norden oder nach Suedosten.");

  AddDetail( ({"wegrand","rand"}),
	    "Nicht auf dem Weg, sondern daneben. ");
  
  AddDetail( ({"norden"}),
	    "Norden ist das Gegenteil von Sueden. ");

  AddDetail( ({"land"}),
	    "Du stehst auf dem Land. ");

  AddDetail( ({"sueden"}),
	    "Sueden ist das Gegenteil von Norden. ");

  AddDetail( ({"gegenteil"}),
	    "Wenn Du das nicht weisst, solltest Du Deine Intelligenz erhoehen. ");

  AddDetail( ({"erforschen"}),
	    "Das tust Du gerade.");

  AddDetail( ({"intelligenz","ansammlung","normalerweise","zwei","zeit","adventszeit","tode"}),
	    "Jetzt hoer aber auf!!!! Es haben sich schon welche zu Tode untersucht.");

  AddDetail( ({"nadeln","nadel"}),
	    "Nadeln haengen an den Kiefern und Tannen.");

  AddDetail( ({"silberland"}),
	    "Du befindest Dich im Silberland.");

  AddDetail( ({"baeume","baeumen"}),
	    "Am Wegrand befinden sich junge Kiefern und Tannen, auch viele "
	    "Eichen und Ulmen kannst Du erkennen. Ein Baum faellt Dir besonders "
	    "auf. ");
  AddDetail( ({"baum","blitz"}),
	    "In den einen Baum scheint ein Blitz eingeschlagen zu sein. Er "
            "sieht gar nicht mehr gesund aus. Ansonsten bist Du nur froh, dass "
            "Du nicht der Baum bist.");

  AddDetail( ({"stamm"}),
	    "Sowas hat ein anstaendiger Baum im Silberland. ");

  AddDetail( ({"kiefer","kiefern"}),
	   "Halt wie Kiefern in einem Wald aussehen, Nadeln, Stamm und Aeste.");

  AddDetail( ({"tanne","tannen"}),
	   "Halt wie Tannen aussehen, schau Dir "  
           "mal in der Adventszeit Deinen Weihnachtsbaum an. ");

  AddDetail( ({"ulme","ulmen"}),
	   "Halt ganz normale Ulmen mit Blaettern, Stamm und Aesten.");

  AddDetail( ({"eiche","eichen"}),
	   "Halt wie Eichen aussehen, nicht sehr interessant. ");

  AddDetail( ({"blatt","blaetter","blaetterdach","dach"}),
	    "Die Blaetter bilden ein dichtes Dach, so dass kaum ein Lichtstrahl "
	    "den Boden trifft. Es ist trotzdem sehr idyllisch.");

  AddDetail( ({"holz"}),
	    "Baeume bestehen aus Holz, dumme Frage. ");

  AddDetail( ({"licht","verhaeltnisse","lichtverhaeltnisse"}),
	    "Es ist ein bisschen schummrig, aber trotzdem friedlich. ");

  AddDetail( ({"lichtstrahl","strahl","himmel"}),
	    "Ab und zu trifft ein Lichtstrahl den Boden, was jedoch durch das "
	    "dichte Blaetterdach nicht haeufig geschieht. Den Himmel kann man nur "
            "ein wenig sehen. ");
  
  AddDetail( ({"teil"}),
	    "Ja, dies ist ein Teil des Waldes. ");

  AddDetail( ({"wald","waldes"}),
	    "Ein Wald ist eine Ansammlung von Baeumen.");

  AddDetail( ({"gras"}),
	    "Ganz normales Gras, bestehend aus einzelnen Grashalmen. ");

  AddDetail( ({"grashalme","grashalmen"}),
	    "Zwischen den Grashalmen ist ein leichtes Glitzern zu erkennen. ");

  AddDetail( ({"glitzern"}),
	    "Das Glitzern war nur ein Lichtstrahl, der auf einem Tautropfen geglitzert hat. ");

  AddDetail( ({"tropfen","tautropfen"}),
	    "Ein Tropfen besteht aus Wasser. ");

  AddDetail( ({"wasser"}),
	    "Damit waschen sich normale Leute, Du anscheinend nicht. ");

  AddDetail( ({"leute","preis","details"}),
	    "Hiermit wird Dir der erste Preis fuer das Erforschen von Details ueberreicht. ");

  AddDetail( ({"zweige","zweig"}),
	    "Sie liegen auf dem Waldweg und sind wohl von den Baeumen heruntergefallen. ");

  AddDetail( ({"aeste","ast"}),
	    "Die Aeste wiegen sich leicht im Wind. ");

  AddDetail( ({"wind"}),
	    "Die Aeste wiegen sich leicht im Wind. ");

  AddDetail( ({"buesche","bueschen"}),
	    "Ganz normale Buesche, wie sie es in jedem Wald gibt. ");

  AddDetail( ({"straeucher","straeuchern"}),
	    "An den Straeuchern gibt es nicht viel zu sehen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst, Dich bald zu waschen.");

  
  
  AddSmell(DEFAULT_SMELL, "Du riechst die Baeume, das Gras am Boden und auch klare Luft.");  
 
  AddSmell( ({"baeume","baum"}),
	   "Sie duften nach Kiefern und Tannen.");
 
 AddSmell( ({"wald"}),
	   "Der Wald duftet nach Baeumen.");

  AddSmell( ({"luft"}),
	   "Du schnupperst an der klaren Luft und fuehlst Dich frei.");
  
  AddSmell( ({"kiefer","kiefern"}),
	   "Halt wie Kiefern in einem Wald riechen.");

  AddSmell( ({"tanne","tannen"}),
	   "Halt wie Tannen riechen, falls Du es nicht weisst, schnupper "  
           "mal in der Adventszeit an Deinem Weihnachtsbaum. ");
  
  AddSmell( ({"weihnachtsbaum"}),
	   "Sei realistisch, warum sollte jetzt hier im Wald ein Weihnachtsbaum stehn.");

 
  AddSmell( ({"ulme","ulmen"}),
	   "Halt wie Ulmen riechen. Ein wenig ulmig.");

  AddSmell( ({"eiche","eichen"}),
	   "Die Eichen duften herrlich nach Wald.");

  
  AddSound(DEFAULT_SOUND, "Der Wind weht nur ganz leicht durch "
	   "das Blaetterdach, trotzdem hoerst Du ein leichtes Rascheln.");

  AddSound( ({"wind"}),
	   "Du kannst ihn kaum hoeren, er bringt nur die Blaetter leicht zum Rascheln.");
  
  AddSound( ({"blaetter","rascheln"}),
	   "Die Blaetter bewegen sich leicht im Wind, so dass sie rascheln!");

//-----Details Ende-----
  
AddExit("suedosten", ROOM "zen2");
AddExit("norden", ROOM "zen4");

}
