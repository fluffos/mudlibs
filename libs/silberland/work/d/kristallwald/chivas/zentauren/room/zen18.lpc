// von Elro
// 09.3.2004
// 
// Raum meines Gesellenstueckes "Stadtweg4 - zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>


void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einer Strasse in Roch Adan");
  SetProp( P_INT_LONG,
	"Du befindest Dich auf einer Strasse in Roch Adan. Im Norden befindet sich ein "
	"Park, den Du aber von hier aus nicht erreichen kannst, da er durch eine sehr gut "
	"gepflegte Hecke aus Bueschen von der Strasse abgetrennt ist. Im Sueden siehst Du "
	"die Rueckseite eines Baumriesen. Hier haengen die Aeste etwas tiefer als an den "
	"anderen Baeumen. In beide Richtungen, in die Du gehen kannst, geht die Strasse "
        "weiter. ");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( ({"strasse","richtungen"}), 
            "Die Strasse ist mit Gras bedeckt und fuehrt Dich von Westen nach Osten an der Hecke vom Park "
            "entlang.");

  AddDetail( ({"boden"}),
	    "Der Boden der Strasse ist mit Gras bedeckt. Auch ein paar kleine Steinchen kann man "
            "sehen.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren. Eigentlich gefaellt Dir eine Stadt, die aus Baumriesen "
            "besteht. Es ist mal etwas anderes.");

  AddDetail( ({"norden","park","stadtpark","durchlass","stelle","mitte"}), 
            "Im Norden befindet sich der Stadtpark von Roch Adan. Er ist in der Mitte der Stadt. Du befindest "
            "Dich auf einer Strasse, die um den Park herum fuehrt. An dieser Stelle kannst Du den Park leider "
            "nicht betreten, da die grosse Hecke keinen Durchlass bietet.");

  AddDetail( ({"hecke","bueschen"}),
	    "Die Hecke ist so hoch, dass Du den Park nicht sehen kannst. Du kannst auch keine einzige Luecke "
            "sehen um mal von hier aus in den Park zu spaehen.");

  AddDetail( ({"sueden","baumriese","rueckseite","riese","baum"}),
	    "Du siehst die Rueckseite eines Baumriesen. Es ist wohl die andere Seite der Wache, in der sich "
            "die Wachposten vom Tor ausruhen. Der Stamm hat ein paar Risse und die Aeste haengen ein wenig "
            "tiefer als an den anderen Baumriesen, obwohl Du da natuerlich nur die Vorderseite siehst."); 
  
  AddDetail( ({"aeste","aussicht"}), 
            "Die Aeste haengen ein wenig tiefer als an den anderen Baumriesen. Vielleicht kann man versuchen "
            "am Stamm hochzuklettern und ein wenig die Aussicht geniessen.");

  AddDetail( ({"baeumen","baeume"}),
	    "Die Baeume hier in Roch Adan sind wohl die groessten im Silberland.");

  AddDetail( ({"himmel","himmels"}),
	    "Den Himmel kannst Du nicht so genau sehen, da die Aeste den Himmel ein wenig verdecken. Du "
            "erkennst nur das er blau ist und das anscheinend ein paar Wolken am Himmel sind.");

  AddDetail( ({"sonne"}), 
            "Die Sonne scheint zu scheinen, da die Blaetter und Aeste des Baumriesen "
            "grosse Schatten werfen.");

  AddDetail( ({"wolken","teil"}),
	    "Die Wolken ziehen am Himmel vorbei. Du kannst nur ein paar sehen, da die Aeste und Blaetter "
            "den groessten Teil des Himmels verdecken. Die Sonne kannst Du gar nicht sehen.");

  AddDetail( ({"gras","wesen"}),
	    "Das Gras auf der Strasse ist niedergetrampelt von den vielen Wesen, die hier schon lang gegangen "
            "sind. Ein paar Steinchen liegen im Gras."); 
  
  AddDetail( ({"steinchen"}), 
            "Die Steinchen sind uninteressant. Nichts besonderes.");

  AddDetail( ({"baumriesen","riesen"}),
	    "In den Baumriesen wohnen und arbeiten die Zentauren. Im Sueden befindet sich die Rueckseite der Wache.");

  AddDetail( ({"luecke"}),
	    "Wo keine Luecke ist, kann man auch keine Luecke untersuchen. Das ist ziemlich dumm.");

  AddDetail( ({"stamm","ueberblick"}), 
            "Der Stamm hat ein paar Risse. Man koennte versuchen am Stamm hochzuklettern um einen besseren Ueberblick "
            "ueber die Stadt zu haben.");

  AddDetail( ({"risse","rinde"}),
	    "Die Rinde hat ein paar Risse. Es wuerde dadurch einfach sein den Stamm hochzuklettern und die Aeste "
            "zu erreichen.");

  AddDetail( ({"vorderseite"}),
	    "Von den anderen Baumriesen in Roch Adan siehst Du halt nur die Vorderseite. Da wurden die ganzen tief "
            "haengenden Aeste wohl abgeschnitten."); 
  
  AddDetail( ({"seite"}), 
            "Welche Seite meinst Du? Die Vorderseite oder die Rueckseite?");

  AddDetail( ({"tor"}),
	    "Das Tor kannst Du von hier aus nicht sehen. Da musst Du wohl um den Baum herum gehen.");

  AddDetail( ({"wachposten"}),
	    "Die Wachposten stehen sicher am Tor oder sind in der Wache, darum kannst Du sie nicht sehen.");

  AddDetail( ({"silberland"}), 
            "Du bist im Silberland und es ist toll hier.");

  AddDetail( ({"schatten"}),
	    "Du stehst im Schatten eines Baumriesen.");

  AddDetail( ({"blaetter"}),
	    "Die Blaetter an den Baumriesen sind sogar groesser als Du."); 
  
  AddDetail( ({"wache"}), 
            "Im Sueden ist die Rueckseite der Wache. Wenn Du um auf der Strasse um den Baum herum gehst, "
            "kannst Du sie sicher auch betreten.");

  AddDetail( ({"zentauren","wesen","mensch","pferd"}),
	    "Zentauren sind magische Wesen, halb Mensch und halb Pferd.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddSmell(DEFAULT_SMELL, "Du riechst das Gras auf der Strasse.");  
 
  AddSmell( ({"strasse","gras"}),
	   "Das Gras riecht frisch.");

  AddSound(DEFAULT_SOUND, "Du hoerst den ueblichen Laerm einer Stadt.");

  AddSound( ({"laerm"}),
	   "Du hoerst wie die Zentauren auf der Strasse lang traben und in den Baumriesen arbeiten.");
  
  AddReadDetail( ({"zentauren"}),
		"trab, trab, trab, trab");

//-----Details Ende-----
AddItem(NPC "zentaurm3", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "zen18",
          P_MNPC_AREA:({ROOM "zen13", ROOM "zen16", ROOM "zen17",
                          ROOM "zen18", ROOM "zen19", ROOM "zen20",
                          ROOM "zen21", ROOM "zen22", ROOM "zen23",
                          ROOM "zen24", ROOM "zen25", ROOM "zen26",
                          ROOM "zen27", ROOM "zen28", ROOM "zen29",
                          ROOM "zen30", ROOM "zen31", ROOM "zen32",
                          ROOM "zen33", ROOM "zen34", ROOM "zen35",
                          ROOM "zen36", ROOM "zen37", ROOM "zen43",
                          ROOM "zenladen",ROOM "zenschmied"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );

AddExit("osten", ROOM "zen19");
AddExit("westen", ROOM "zen17");

AddCmd( ({"kletter", "klettere" }), "klettern" );

}
int klettern(string str)
{
 object stab2;
 notify_fail("Woran willst Du hochklettern?\n");

 if(!str || str == "") return 0;
 if(!(str == "an stamm hoch" ||
      str == "am stamm hoch" ||
      str == "stamm hoch" )) return 0;

  if(!present("astroinvis", TP) && !present("dragoninvis2", TP)){
	  
  write(BS("Du kletterst den Baum rauf, faellst aber runter, als Du einen losen Ast ergreifst. "
           "Du landest hart auf den Boden und kickst den bloeden Ast die Strasse runter.\n"));
 
  say(TPN+" landet auf dem Hintern und tritt einen Ast.\n");
  return -1;
  }
  if(present("stab2", TP)){
	  
  write(BS("Du kletterst den Baum rauf, rutschst aber immer wieder runter.\n"));
 
  say(TPN+" stellt sich einfach dumm an.\n");
  return -1;
  }

  write(BS("Du kletterst den Baum hoch und willst Dich an einem Ast festhalten. Dieser ist jedoch "
	  "lose und Du faellst runter und landest auf Deinem Hinterteil. Du fluchst und "
          "willst den Ast schon wegwerfen, den Du immer noch in der Hand haelst, als Du merkst, "
          "dass der Ast wohl ein Stab ist und zu einem Teleskop gehoeren scheint. Du steckst den "
          "Stab ein.\n"));
 
  say(TPN+" flucht, freut sich dann aber doch.\n");
  clone_object(OBJ "stab2")->move(TP, M_NOCHECK);
  return 1;

}

