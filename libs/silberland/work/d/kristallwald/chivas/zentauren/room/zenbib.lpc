inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Bibliothek von Roch Adan");
  SetProp( P_INT_LONG,
	"Du befindest Dich in der koeniglichen Bibliothek von Roch Adan. Du "
	"siehst tausende von Buechern auf riesigen Regalen, die in langen "
	"Reihen nebeneinander stehen. Gleich vor Dir ist ein Tisch, wo "
	"anscheinend der Bibliothekar den Schreibkram erledigt, der in einer "
	"Bibliothek halt so anfaellt. Ansonsten stehen einige Pulte herum "
        "an denen die Zentauren Buecher lesen koennen.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );


//-----Details Anfang-----

  
  AddDetail( ({"bibliothek"}), 
             QueryProp(P_INT_LONG));

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren.");

  AddDetail( ({"zentauren","wesen","oberkoerper","rest","pferdes"}), 
            "Die Zentauren sind stolze Wesen. Ihr Oberkoerper ist menschlich "
            "und der Rest eines Pferdes.");

  AddDetail( ({"buecher","buechern","anzahl"}),
	    "Du erkennst tausende von Buechern in den Regalen. Gleich "
            "am Eingang faellt Dir ein kleines Regal auf, das an der Wand "
            "steht. Neben dem Regal haengt ein interessant aussehendes "
            "Plakat.");

  AddDetail( ({"regale","regalen","dutzend","grund","meter"}), 
            "Die meisten Regale sind ein paar Meter hoch, so dass sogar die "
            "Zentauren nicht an die Buecher kommen wuerden. Aus diesem Grund "
            "scheinen ein Dutzend Feen hier angestellt zu sein.");

  AddDetail( ({"regal","eingang"}), 
            "Auf dem Regal direkt am Eingang stehen Buecher, dessen Einbaende "
            "in verschiedenen Farben leuchten. Vielleicht sagt Dir das Plakat "
            "neben dem Regal mehr ueber die Buecher.");

  AddDetail( ({"reihen"}),
	    "Es sind fast endlose Reihen von Regalen. Es muessen tausende von "
            "Buechern sein.");

  AddDetail( ({"tisch"}),
	    "An diesem Tisch sitzt normalerweise der Bibliothekar, wenn er "
            "nicht umher laeuft. Du siehst verschiedene Papiere und Ordner "
            "auf dem Tisch rumfliegen, einige Stifte sind in einer kleinen "
            "Tasse zusammengestellt."); 
  
  AddDetail( ({"bibliothekar"}), 
            "Er hat sicher eine Menge zu tun, bei der grossen Anzahl an "
            "Buechern.");

  AddDetail( ({"menge"}), 
            "Er hat halt sehr viel zu tun.");

  AddDetail( ({"schreibkram","kram"}),
	    "So etwas hassen wir doch alle.");

  AddDetail( ({"boden","baumhoehlen","hoehlen","reisig"}),
	    "Der Boden ist wie in den meisten Baumhoehlen der Zentauren mit "
            "Reisig bedeckt, unter dem man ein paar Steinplatten sehen kann.");

  AddDetail( ({"steinplatten","platten","stein"}),
	    "Ganz normale Steinplatten, nichts besonderes.");

  AddDetail( ({"himmel"}), 
            "Da must Du schon raus gehen.");

  AddDetail( ({"decke","lampen"}),
	    "An der Decke haengen ein paar Lampen, die die Bibliothek jedoch "
            "gut erhellen.");

  AddDetail( ({"pult","pulte","pulten","stuehlen","stuehle"}),
	    "Zentauren koennen halt nicht auf Stuehlen sitzen, also stehen "
            "sie an den Pulten und lesen."); 

  AddDetail( ({"waende","wand"}),
	    "Auch an den Waenden stehen Regale und es haengt ein grosses "
            "Schild und ein buntes Plakat an der einen Wand."); 
  
  AddDetail( ({"papiere"}), 
            "Die Papiere sind mit allem moeglichen vollgeschrieben. Das "
            "einzige, dass Dich interessiert ist das blaue Blatt, was wie "
            "eine offizielle Information aussieht.");

  AddDetail( ({"information","blatt","blaue Blatt"}),
	    "Du kannst die Information lesen.");

  AddDetail( ({"ordner","antraege","ordnern"}),
	    "In den Ordnern sind sicher die Antraege der Personen, die einen "
            "Leihausweis haben.");

  AddDetail( ({"person","personen"}),
	    "Personen wie Du, nur mit einem Leihausweis.");

  AddDetail( ({"leihausweis","ausweis"}),
	    "Momentan ist es wohl nicht moeglich einen Leihausweis zu "
            "beantragen. Du solltest es spaeter noch einmal probieren.");

  AddDetail( ({"stifte","tasse"}),
	    "In einer Tasse sind verschiedene Stifte zusammengestellt, damit "
            "sich nicht wahrlos auf dem Tisch rumfliegen. Nicht sehr "
            "interessant.");

  AddDetail( ({"feen","fee","platz"}), 
            "Die Feen flattern mit ihren kleinen Fluegeln hoch zu den Regalen "
            "und holen die Buecher fuer die Kunden herunter und bringen "
            "wiedergebrachte Buecher wieder an ihren Platz.");

  AddDetail( ({"kunden","leute"}), 
            "Halt Leute, die sich Buecher ausleihen.");

  AddDetail( ({"schild"}),
	    "Auf dem Schild stehen anscheinend die Personen, die sich Buecher "
            "ausgeliehen haben und sie bisher nicht zurueckgebracht haben. Du "
            "kannst es lesen.");

  AddDetail( ({"plakat"}),
	    "Auf dem Plakat ist eine Topliste abgebildet der am haeufigsten "
            "ausgeliehenen Buecher in der Bibliothek.");

  AddDetail( ({"topliste"}), 
            "Die Topliste der ausgeliehenen Buecher kannst Du Dir durchlesen.");

  AddDetail( ({"einbaende","top"}),
	    "Die Einbaende die Du interessant findest, sind die Top 10 der "
            "meist ausgeliehnen Buecher des Silberlandes. Jeder Einband "
            "leuchtet in einer anderen Farbe.");

  AddDetail( ({"silberland","silberlandes"}), 
            "Du bist im Silberland.");

  AddDetail( ({"einband","farben","farbe"}), 
            "Welchen Einband meinst Du? Rot, Gelb, Gruen, Schwarz, Blau, "
            "Rosa, Braun, Lila, Tuerkis, Weiss oder Gold? ");

  AddDetail( ({"rot","gelb","gruen","schwarz","blau","rosa","braun","lila","tuerkis","weiss","gold"}),
	    "Dies ist eine Farbe oder meinst Du vielleicht den jeweiligen "
            "Einband?"); 

  AddDetail( ({"roten einband","roter einband","rotem einband"}),
	    "Auf dem Einband steht: Diskutieren fuer Anfaenger, vielleicht "
            "kannst Du Buch 1 nehmen und Dir die Zusammenfassung auf der "
            "Rueckseite durchlesen. "); 

  AddDetail( ({"goldenen einband","goldener einband","goldenem einband"}),
      "Auf dem Einband steht: Schlaflieder des Silberlands (3. Ausgabe). "
      "Du kannst dir Buch 11 ja mal nehmen und durchblaettern."); 

  AddDetail( ({"gelben einband","gelber einband","gelbem einband"}),
	    "Auf dem Einband steht: Zu Besuch bei Gevatter Tod, vielleicht kannst "
            "Du Buch 2 nehmen und Dir die Zusammenfassung auf der Rueckseite durchlesen. "); 

  AddDetail( ({"gruenen einband","gruener einband","gruenem einband"}),
	    "Auf dem Einband steht: Scripten fuer Profis, vielleicht kannst Du Buch 3 "
            "nehmen und Dir die Zusammenfassung auf der Rueckseite durchlesen. "); 

  AddDetail( ({"schwarzen einband","schwarzer einband","schwarzem einband"}), 
            "Auf dem Einband steht: Der fuerchterliche Mudcrash, vielleicht kannst "
            "Du Buch 4 nehmen und Dir die Zusammenfassung auf der Rueckseite durchlesen. "); 

  AddDetail( ({"blauen einband","blauer einband","blauem einband"}),
	    "Auf dem Einband steht: Ich bin kein NPC !!!, vielleicht kannst Du Buch 5 "
            "nehmen und Dir die Zusammenfassung auf der Rueckseite durchlesen. "); 

  AddDetail( ({"rosa einband","rosanen einband","rosaner einband","rosanem einband"}),
	    "Auf dem Einband steht: Feen, Elfen und andere Frauen, vielleicht kannst "
            "Du Buch 6 nehmen und Dir die Zusammenfassung auf der Rueckseite durchlesen. "); 

  AddDetail( ({"braunen einband","brauner einband","braunem einband"}),
	    "Auf dem Einband steht: Das Gaffodorf, Mysterium oder Wahrheit, vielleicht "
            "kannst Du Buch 7 nehmen und Dir die Zusammenfassung auf der Rueckseite "
            "durchlesen. "); 

  AddDetail( ({"lila einband","lilaner einband","lilanen einband","lilanem einband"}), 
            "Auf dem Einband steht: Bier selber brauen, vielleicht kannst Du Buch 8 "
            "nehmen und Dir die Zusammenfassung auf der Rueckseite durchlesen. "); 

  AddDetail( ({"tuerkisen einband","tuerkiser einband","tuerkisem einband"}),
	    "Auf dem Einband steht: Sex mit Kristallmaennern, vielleicht kannst Du Buch 9 "
            "nehmen und Dir die Zusammenfassung auf der Rueckseite durchlesen. "); 

  AddDetail( ({"weissen einband","weisser einband","weissem einband"}),
	    "Auf dem Einband steht: Edelsteine gut gefaelscht, vielleicht kannst Du Buch 10 "
            "nehmen und Dir die Zusammenfassung auf der Rueckseite durchlesen. "); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Papier und Tinte.");  
 
  AddSmell( ({"papier"}),
	   "Das Papier riecht teilweise frisch, was von neuen Buechern "
           "zu kommen scheint und auch teilweise ein wenig modrig, was "
           "von ganz alten Buechern kommt.");

  AddSmell( ({"tinte"}),
           "Die Tinte kommt auch aus den Buechern. Sie riecht auch nicht "
           "mehr ganz frisch.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Blaettern von Seiten und das "
                          "Flattern von Fluegeln.");

  AddSound( ({"blaettern","seiten","seite"}),
	   "Hier wird viel gelesen und wenn man mehr als eine Seite lesen "
           "will, dann blaettert man um.");

  AddSound( ({"flattern","fluegel","fluegeln","feen","fee"}),
	   "Das Flattern der Fluegel stammt von kleinen Feen, die Buecher aus "
           "den hohen Regalen hohlen oder sie wieder zurueck ins Regal "
           "stellen.");
  
  AddReadDetail( ({"schild"}),
		"Auf dem Schild stehen diejenigen, die Buecher ausgeliehen "
                "haben und sie bisher nicht zurueckgebracht haben: \n"
                "   \n"
                "+--------------------------------------------------------------------------+\n"
                "| Ausleiher  Anzahl ausgeliehener Buecher (bisher nicht wieder aufgetaucht)|\n"
                "| Hiri       2.456 Buecher, z.B. Ihre Biographie 'Magierkinder, ein Horror'|\n"
                "| Delgo      2.390 Buecher, z.B. die Anleitung 'Wie werde ich E+ oder Gott'|\n"
                "| Chivas     2.189 Buecher, z.B. die Erstausgabe von 'LPC fuer Dummies'    |\n"
                "| Woody      1.957 Buecher, z.B. das Einzelstueck 'Das Silberland und ich' |\n"
                "| Feyaria    1.539 Buecher, z.B. die Biographie 'Berserkerfee mit Axt'     |\n"
                "| Angrox     1.293 Buecher + 384 Comics                                    |\n"
                "| Malar      1.026 Buecher, darunter Komplettloesungen Teil I - VIII       |\n"
                "| Gast1          1 Buch                                                    |\n"
                "|                                                                          |\n"
                "| Die Leihausweise dieser Personen wurden bis auf weiteres eingezogen,     |\n"
                "| bis die Buecher zurueckgebracht sind oder die Hoelle einfriert.          |\n"
                "|                                                                          |\n"
                "|                                                        Der Bibliothekar  |\n"
                "+--------------------------------------------------------------------------+\n");

  AddReadDetail( ({"topliste","liste"}),
		"Dies sind die am meisten ausgeliehenen Buecher im Silberland:\n"
                " 1. Diskutieren fuer Anfaenger (Autoren: A......, T...)\n"
                " 2. Zu Besuch bei Gevatter Tod (Autor: L..)\n"
                " 3. Scripten fuer Profis (Autor:  unbekannt)\n"
                " 4. Der fuerchterliche Mudcrash (Autor: K.....)\n"
                " 5. Ich bin kein NPC !!! (Autor: R...)\n"
                " 6. Feen, Elfen und andere Frauen (Autor: A.........)\n"
                " 7. Das Gaffodorf, Mysterium oder Wahrheit (Autor: unbekannt)\n"
                " 8. Bier selber brauen (Autor: G........)\n"
                " 9. Sex mit Kristallmaennern (Autor: S.....)\n"
                "10. Edelsteine gut gefaelscht (Autor: T....)\n");

  AddReadDetail( ({"information"}),
		"Es werden momentan keine Leihausweise ausgegeben. Bitte melden Sie sich "
                "zu einem spaeteren Zeitpunkt noch einmal.");

//-----Details Ende-----
  
AddExit("suedosten", ROOM "zeng2"); 

AddItem(NPC "bibliothekar", REFRESH_DESTRUCT);

AddCmd( ({"nimm" }), "nehmen" );
AddCmd( ({"stehle","stiehl" }), "stehlen" );

}

public string det_schlaflied() {
	string str, fulltext;
	int i;
  
	fulltext = call_other("/d/kristallwald/sargola/lichtung/npc/d", "GetSchlaflied", 10, 15);
  
	str = "\n"+fulltext+"\nDas solltest du dir merken. Koennte mal nuetzlich sein!\n";
	if(TP->QueryProp(P_GUILD) == "bardengilde" && TP->QuerySkill("abendstille ueberall") == 0) {
	  str += BS("Wenn du das einen Drachen genau so, Zeile fuer Zeile, vorsingst, wird er wohl einschlafen. Es darf "
			 "dir jedoch kein Fehler passieren. Also merke es dir gut!\n");
	}
  
	return str;
}
  

int nehmen(string str)
{
 notify_fail("Was willst Du nehmen?\n");

 if(!str || str == "") return 0;
 if(!(str == "buch 1" ||
      str == "buch 2" ||
      str == "buch 3" ||
      str == "buch 4" ||
      str == "buch 5" ||
      str == "buch 6" ||
      str == "buch 7" ||
      str == "buch 8" ||
      str == "buch 9" ||
      str == "buch 10"||
      str == "buch 11" )) return 0;
 
switch(str)
{

case "buch 1": write(BS("Du nimmst das erste Buch, drehst es um und liest Dir "
                        "die Zusammenfassung durch:\n"));
               write(BS("Die Autorin und der Autor dieses Buches haben ihre "
                        "eigene Erfahrung bezgl. des Diskutierens und "
                        "Scrollens, in dieses Buch einfliessen lassen. Es "
                        "ist eine Hilfe fuer kleinere Spieler ein aehnliches "
                        "Level irgendwann zu erreichen. \n"));
               write(BS("Nachdem Du die Rueckseite gelesen hast, stellst Du "
                        "das Buch zurueck."));
 
 say(TPN+" nimmt ein Buch und liest sich die Rueckseite durch.\n");
 return -1;
break;
case "buch 2": write(BS("Du nimmst das zweite Buch, drehst es um und liest "
                        "Dir die Zusammenfassung durch: \n"));
               write(BS("Der Autor berichtet ueber seine Besuche bei Gevatter "
                        "Tod und die Todesszenen die er bei seinen Besuchen "
                        "erlebt hat. Er erzaehlt in hinreissender Art ueber "
                        "das Feilschen um Erfahrungspunkte und so manchen "
                        "Deal mit Lars. Die Silberland-Presse haelt laut "
                        "Kritik das Buch fuer einen wichtigen Wegweiser im "
                        "Umgang mit dem Tod. "));
               write(BS("Nachdem Du die Rueckseite gelesen hast, stellst Du "
                        "das Buch zurueck.\n"));

 say(TPN+" nimmt ein Buch und liest sich die Rueckseite durch.\n");
 return -1;
break;
case "buch 3": write(BS("Du nimmst das dritte Buch, drehst es um und liest "
                        "Dir die Zusammenfassung durch:\n"));
               write(BS("Der unbekannte Autor dieses Buches beschreibt aus eigenen "
                        "Erfahrungen die Tips und Tricks beim Scripten im "
                        "Silberland. Es wird auf die Gefahren und "
                        "Konsequenzen hingewiesen und nennt geheime Orte von "
                        "Scriptfallen. \n"));
               write(BS("Nachdem Du die Rueckseite gelesen hast, stellst Du "
                        "das Buch zurueck."));
 
 say(TPN+" nimmt ein Buch und liest sich die Rueckseite durch.\n");
 return -1;
break;
case "buch 4": write(BS("Du nimmst das vierte Buch, drehst es um und liest "
                        "Dir die Zusammenfassung durch:\n"));
               write(BS("Der Autor erzaehlt in seiner natuerlich erfundenen "
                        "Geschichte von einem motivierten Magier, der es "
                        "schaffte durch einen kleinen Fehler, der jedem "
                        "haette passieren koennen, eine komplette Welt fuer "
                        "einen kurzen Moment in den Untergang zu schicken. Er "
                        "berichtet wie der Protagonist der Geschichte in "
                        "Selbstzweifel verfaellt, sich aber nach einiger Zeit "
                        "aus seinem tiefen Loch selbst herauszieht und "
                        "wundervolle Sachen proggte. \n"));
               write(BS("Nachdem Du die Rueckseite gelesen hast, stellst Du "
                        "das Buch zurueck."));

 say(TPN+" nimmt ein Buch und liest sich die Rueckseite durch.\n");
 return -1;
break;
case "buch 5": write(BS("Du nimmst das fuenfte Buch, drehst es um und liest "
                        "Dir die Zusammenfassung durch:\n"));
               write(BS("Diese Biographie eines Bewohners im Silberwald ist "
                        "humorvoll geschrieben, obwohl man mit dem Autor an "
                        "vielen Stellen Mitleid hat, wenn kleine Spieler ihn "
                        "mit einem NPC verwechseln und alle moeglichen Verben "
                        "an ihm ausprobieren, da sein Haus an einer Stelle "
                        "ist, die sehr gerne von Anfaengern besucht wird. \n"));
               write(BS("Nachdem Du die Rueckseite gelesen hast, stellst Du "
                        "das Buch zurueck."));
 
  say(TPN+" nimmt ein Buch und liest sich die Rueckseite durch.\n");
  return -1;
break;
case "buch 6": write(BS("Du nimmst das sechste Buch, drehst es um und liest "
                        "Dir die Zusammenfassung durch:\n"));
               write(BS("Dieser Ratgeber fuer Spieler jeder Stufe hilft vor "
                        "allem eher schuechternen Spielern. Der Autor spricht "
                        "offen ueber seine Ehen und Beziehungen und wie er "
                        "'mal wieder' die richtige fuer sein Leben im "
                        "Silberland gefunden hat. Die besten Anmachsprueche "
                        "in diesem Buch stehen jedoch unter Copyright und " 
                        "koennen nur durch ein Entgelt an den Autor benutzt "
                        "werden. \n"));
               write(BS("Nachdem Du die Rueckseite gelesen hast, stellst Du "
                        "das Buch zurueck."));

 say(TPN+" nimmt ein Buch und liest sich die Rueckseite durch.\n");
 return -1;
break;
case "buch 7": write(BS("Du nimmst das siebte Buch, drehst es um und liest "
                        "Dir die Zusammenfassung durch:\n"));
               write(BS("Ein unbekannter Autor berichtet von seinen Reisen in "
                        "das Gaffodorf, von den Personen und Gebraeuchen in "
                        "diesem Dorf. Es ist sehr detailreich beschrieben, "
                        "laesst jedoch offen, ob es sich um ein Hirngespinnst "
                        "oder um einen realen Besuch handelt. \n"));
               write(BS("Nachdem Du die Rueckseite gelesen hast, stellst Du "
                        "das Buch zurueck."));
 
  say(TPN+" nimmt ein Buch und liest sich die Rueckseite durch.\n");
  return -1;
break;
case "buch 8": write(BS("Du nimmst das achte Buch, drehst es um und liest Dir "
                        "die Zusammenfassung durch:\n"));
               write(BS("Der Autor gibt Anleitungen ueber die verschiedenen "
                        "Methoden des Bierbrauens und des nachtraeglichen "
                        "Verkoestigen des Selben. Nachdem der Leser die "
                        "Anleitungen genau studiert hat, ist er in der Lage "
                        "jede Art von Bier zu brauen. Der Autor uebernimmt "
                        "jedoch nicht die Garantie, dass das Eigenbraeu nicht "
                        "blind macht. \n"));
               write(BS("Nachdem Du die Rueckseite gelesen hast, stellst Du "
                        "das Buch zurueck."));

 say(TPN+" nimmt ein Buch und liest sich die Rueckseite durch.\n");
 return -1;
break;
case "buch 9": write(BS("Du nimmst das neunte Buch, drehst es um und liest "
                        "Dir die Zusammenfassung durch:\n"));
               write(BS("Die Autorin berichtet ueber einen Fluch, der "
                        "ueber ihren Mann gekommen ist und die Folgen, aber "
                        "auch Moeglichkeiten, die dieser Fluch mitgebracht "
                        "hat. Nachdem lesen des Buches fuehlt man sich mit "
                        "dieser armen Frau verbunden, obwohl man auch die "
                        "Vorteile (vor allem die Leserinnen) eines harten "
                        "Kristallmannes nicht unterschaetzen sollte. \n"));
               write(BS("Nachdem Du die Rueckseite gelesen hast, stellst Du "
                        "das Buch zurueck."));
 
  say(TPN+" nimmt ein Buch und liest sich die Rueckseite durch.\n");
  return -1;
break;
case "buch 10": write(BS("Du nimmst das zehnte Buch, drehst es um und liest "
                         "Dir die Zusammenfassung durch:\n"));
                write(BS("Der Autor beschreibt, wie man normale Steine als "
                         "Edelsteine verkauft. Dies ist jedoch nicht nur eine "
                         "Anleitung wie man den leichten Weg geht, sondern "
                         "auch eine Anleitung wie man richtig schuerft und "
                         "ueber die harte Arbeit der Zwerge. \n"
                         "Die erklaerten Tricks auf den ersten zwanzig Seiten "
                         "werden jedoch meistens nur gelesen wie Du siehst. "
                         "Die folgenden tausendfuenfhundert Seiten ueber das "
                         "Schuerfen und die harte Arbeit sehen fast noch neu "
                         "aus. \n"));
                write(BS("Nachdem Du die Rueckseite gelesen hast, stellst Du "
                         "das Buch zurueck."));
case "buch 11": write(BS("Du nimmst das elfte Buch und blaetterst ein wenig darin."));
                write(BS("Eine Seite findest du besonders interessant. Sie traegt den "
                         "Titel 'Schlaflied fuer Drachen III'. Darin steht: "));
                write(det_schlaflied());
                write(BS("Naja. Ohne die restlichen Teile kannst du nichts damit anfangen. "
                         "Also stellst du das Buch wieder zurueck."));
                return -1;
                break;

 say(TPN+" nimmt ein Buch und liest sich die Rueckseite durch.\n");
 return -1;
 }
}
int stehlen(string str)
{
   notify_fail("Was moechtest Du stehlen?\n");
   if((strstr(str, "buch")!=-1) || (strstr(str, "buecher")!=-1))
  { 
    write(BS ( "Du schaust Dich um und schnappst Dir ein Buch, aber leider hat Dich "
               "jemand dabei entdeckt."));
    say( TPN+" stiehlt ein Buch und wird erwischt.\n");
    this_player()->move(ROOM "zenz1", M_TPORT);
    return 1;
  }

}  

