// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einer Strasse in Roch Adan");
  SetProp( P_INT_LONG,
	"Du befindest Dich auf einer Strasse in Roch Adan, die zwischen den Baumriesen "
	"vom Haupttor im Sueden oestlich zum Palast der Zentauren im Norden fuehrt. "
	"Westlich befindet sich eine gepflegte Hecke, die die Strasse "
	"vom dahinterliegenden Park abtrennt. Die Strasse ist mit Gras bedeckt. Ab und "
	"zu erkennt man ein paar Hufabdruecke, aber auch Spuren von anderen Lebewesen. "
        "An der Baumhoehle im Osten wurde ein Schild angebracht.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----


  AddDetail( ({"boden"}), 
            "Der Boden der Strasse ist mit Gras bedeckt. Auch ein paar kleine Steinchen kannst Du erkennen. "
            "Ansonsten sieht man lauter Spuren und Hufabdruecke von Lebewesen, die vor Dir diesen Weg "
            "beschritten haben.");

 AddDetail( ({"steinchen"}), 
            "Ein paar kleine uninteressante Steinchen liegen auf dem Boden.");

  AddDetail( ({"strasse","weg"}),
	    "Die Strasse fuehrt von Norden nach Sueden und der Boden ist mit Gras bedeckt.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren. Du befindest Dich momentan auf einer Strasse in Roch Adan.");

  AddDetail( ({"baumriesen","riesen"}), 
            "Oestlich von Dir siehst Du einige Baumriesen, in denen die Zentauren wohnen und arbeiten. "
            "Die Baumhoehle direkt im Osten scheint etwas besonderes zu sein. Ueber der Tuer haengt ein Schild.");

  AddDetail( ({"haupttor","tor","sueden"}),
	    "Das Haupttor, durch das Du die Stadt betreten hast, liegt im Sueden.");

  AddDetail( ({"palast","norden"}),
	    "Der Palast der Zentauren scheint irgendwo im Norden der Stadt zu sein."); 
  
  AddDetail( ({"hecke","mitte"}), 
            "Die Hecke trennt die Strasse vom da hinter liegenden Park ab. Sie fuehrt um den ganzen Park, "
            "der in der Mitte von Roch Adan angelegt wurde.");

  AddDetail( ({"park"}),
	    "Hinter der Hecke ist der wunderschoene Park von Roch Adan. Du solltest vielleicht nachher mal "
            "hingehen und Dich ein wenig ausruhen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau, nur ein paar Wolken sind am Himmel, die jedoch nicht die Sonne verdecken.");

  AddDetail( ({"sonne"}), 
            "Die Sonne steht fast senkrecht und es ist sehr angenehm.");

  AddDetail( ({"wolken","regen"}),
	    "Die Wolken am Himmel sind schneeweiss und es sieht nicht nach Regen aus. Ein paar Voegel fliegen "
            "unter den Wolken umher.");

  AddDetail( ({"gras"}),
	    "Das Gras ist schon ziemlich niedergetreten, da hier anscheinend schon viele durchgelaufen sind. "
            "Aber Du kannst auch ein leichtes Glitzern im Gras erkennen."); 
  
  AddDetail( ({"hufabdruecke","pferde"}), 
            "Die Hufabdruecke stammen sicher von den Zentauren. Pferde hast Du hier naemlich noch gar nicht "
            "gesehen.");

  AddDetail( ({"spuren","lebewesen","abenteurern"}),
	    "Die Spuren stammen anscheinend von anderen Abenteurern wie Dir, die Roch Adan schon besucht haben.");

  AddDetail( ({"baumhoehle","osten"}),
	    "Die Baumhoehle im Osten scheint etwas besonderes zu sein. Ueber der Tuer haengt ein grosses Schild.");

  AddDetail( ({"schild"}), 
            "Auf dem Schild, ueber der Tuer, ist ein Hammer und ein Amboss abgebildet. "
            "Ausserdem ist Etwas in schoener Schrift auf das Schild geschrieben.");

  AddDetail( ({"hammer","amboss","zeichen"}),
	    "Auf dem Schild ist ein grosser Hammer und ein Amboss abgebildet. Das Zeichen fuer eine Schmiede.");

  AddDetail( ({"glitzern"}),
	    "Du solltest das Gras vielleicht einmal durchsuchen."); 
  
  AddDetail( ({"voegel"}), 
            "Die Voegel oben am Himmel sind Schwalben. Du bist stolz auf Dich wie gut Du Dich auskennst.");

 AddDetail( ({"etwas","schrift"}), 
            "Du kannst die Schrift lesen.");

 AddDetail( ({"tropfen"}), 
            "Ein Tropfen der in der Sonne glitzert.");

  AddDetail( ({"schwalben","suche","insekten"}),
	    "Die Schwalben fliegen hoch am Himmel auf der Suche nach Insekten.");

  AddDetail( ({"zentauren","mensch","pferd","oberkoerper","rest"}),
	    "Zentauren sind halb Mensch und halb Pferd. Der Oberkoerper ist menschlich und der Rest "
            "ist von einem Pferd.");

  AddDetail( ({"schmiede","schmied","hufeisen","leben"}), 
            "Im Osten ist also eine Schmiede. Wenn Du also in Deinem Leben mal ein Hufeisen verlierst, weisst "
            "Du wo Du hingehen kannst.");

  AddDetail( ({"tuer","rauch"}),
	    "Die Tuer ist offen und ein wenig Rauch dringt von innen nach aussen, Du kannst die Baumhoehle betreten. "
            "Ein bisschen ueber der Tuer haengt ein grosses Schild.");

  AddDetail( ({"brunnen"}),
	    "Den Brunnen kannst Du durch die Hecke nicht sehen. Da musst Du schon in den Park gehen."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig nach Rauch.");  
 
  AddSmell( ({"rauch"}),
	   "Der Rauch scheint aus der Baumhoehle im Osten zu kommen.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Plaetschern.");

  AddSound( ({"plaetschern","brunnen"}),
	   "Das Plaetschern stammt anscheinend von einem Brunnen, der hinter der Hecke zu sein schein.");
  
  AddReadDetail( ({"schrift","etwas","schild"}),
		"Unter dem Amboss und dem Hammer steht in schoener Schrift geschrieben: Schmied");
//-----Details Ende-----

AddExit("suedwesten", ROOM "zen19");  
AddExit("osten", ROOM "zenschmied");
AddExit("norden", ROOM "zen29");

AddCmd( ({"durchsuch", "durchsuche" }), "durchsuchen" );

}
int durchsuchen(string str)
{
 object linse1;
 notify_fail("Was willst Du durchsuchen?\n");

 if(!str || str == "") return 0;
 if(!(str == "gras")) return 0;
 
  if(!present("astroinvis", TP) && !present("dragoninvis2", TP)){
	  
  write(BS("Du bist enttaeuscht. Es war wohl gerade nur ein Tropfen, der in der Sonne geglitzert hat.\n"));
 
  say(TPN+" ist enttaeuscht.\n");
  return -1;
  }
  if(present("linse1", TP)){
	  
  write(BS("Du findest nichts mehr im Gras. Es scheint sich nur noch um einen Tropfen gehandelt zu haben, "
           "der in der Sonne geglitzert hat.\n"));
 
  say(TPN+" findet nichts im Gras.\n");
  return -1;
  }

  write(BS("Du durchsuchst das Gras und findest eine Linse, die anscheinend zu einem "
	  "Teleskop passen wuerde. Du steckst sie erst einmal ein und erhebst Dich zufrieden "
	  "vom Boden.\n"));
 
  say(TPN+" scheint was im Gras zu finden.\n");
  clone_object(OBJ "linse1")->move(TP, M_NOCHECK);
  return 1;
}

