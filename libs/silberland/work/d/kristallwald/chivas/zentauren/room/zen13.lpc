// Raum meines Gesellenstueckes "Stadt1 - zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Stadttor");
  SetProp( P_INT_LONG,
	"Ploetzlich stehst Du vor dem maechtigen Stadttor von Roch Adan. Der "
        "Torbogen besteht aus einem Dir unbekannten Material. Du erkennst, "
        "dass in das Material Bilder eingraviert sind. Durch das Tor kannst Du "
        "die Stadt erkennen, welche auf den ersten Blick einen netten Eindruck "
        "macht. Alle Haeuser scheinen in Baumriesen gebaut worden zu sein. "
        "Gleich noerdlich dem Stadttor ist ein Baum, der wohl als Wache "
        "dient. Nordoestlich und nordwestlich fuehrt die Strasse weiter in die "
        "Stadt hinein. \n"
        "Links und rechts vom Tor siehst du eine Mauer. Sie besteht aus vielen "
        "Baumstaemmen und verlaeuft anscheinend um die ganze Stadt. Des weiteren "
        "steht am linken Wegrand ein Schild. ");

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1);

//-----Details Anfang-----

  AddDetail( ({"boden","erde"}), 
            "Der Boden ist erdig wie ein normaler Waldweg, geht aber am "
            "Stadttor langsam in einen mit Gras bedeckten Weg ueber. Am Rand "
            "des Weges steht ein Schild zwischen ein paar Blumen im Gras. "
            "Ein paar Spuren kannst Du auch erkennen.");

  AddDetail( ({"spuren","abenteurern"}), 
            "Die meisten Spuren scheinen von Abenteurern wie Dir zu stammen, "
            "jedoch gibt es auch einige Hufabdruecke.");

  AddDetail( ({"hufabdruecke","abdruecke"}), 
            "Die Hufabdruecke scheinen von den Zentauren zu sein, die hier "
            "Wache am Tor halten. ");

  AddDetail( ({"weg","waldweg","strasse"}),
	    "Der Weg fuehrt nach Norden in die Stadt und nach Sueden in den "
            "finsteren Wald. Der Boden geht langsam von einem erdigen Boden "
            "in einen grasbedeckte Strasse ueber.");

  AddDetail( ({"wald","ansammlung"}),
	    "Ein Wald ist eine Ansammlung von Baeumen.");

  AddDetail( ({"baeume","baeumen"}),
	    "Im Norden erkennst Du Baumriesen, im Sueden gibt es ganz normale "
            "Baeume. ");

  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand steht ein Schild direkt vor dem Stadttor.");

  AddDetail( ({"schild"}),
	    "Auf dem Schild steht etwas geschrieben, Du koenntest versuchen "
            "es zu lesen. ");

  AddDetail( ({"blumen","blume"}),
	    "Am Wegrand sind einige Tulpen, Narzissen und noch andere "
            "Blumen, die Du aber nicht kennst. ");

  AddDetail( ({"tulpen","pfluecken"}),
	    "Wunderschoene rote und gelbe Tulpen. Sie sind einfach zu schoen "
            "zum Pfluecken. ");

  AddDetail( ({"narzissen"}),
	    "Die Narzissen sind sehr huebsch.");

  AddDetail( ({"tor","stadttor","torbogen","bogen"}),
	    "Das ist das maechtige Stadttor von Roch Adan. Wenn Du es "
            "durchschreitest, bist Du in der Stadt der Zentauren angekommen. "
            "Das Tor besteht aus einem Dir unbekannten Material, in das Bilder "
            "eingraviert sind. ");

  AddDetail( ({"material"}),
	    "Das Material ist Dir gaenzlich unbekannt. ");

  AddDetail( ({"zentaur","zentauren","geschoepfe","Pferdekoerper","huefte","menschen","planeten","zukunft","bewegungen"}),
	    "Zentauren sind magische Geschoepfe. Sie sind vom Kopf bis zur "
            "Huefte Menschen, darunter jedoch mit Pferdekoerper und -beinen "
            "versehen. Man erzaehlt sich ueber sie, dass sie die Zukunft an "
            "den Bewegungen der Planeten am Himmel lesen koennen. Vor Dir "
            "befindet sich ihre Stadt.");

  AddDetail( ({"kopf","lebewesen"}),
	    "Sowas sollten alle Lebewesen haben. Selbst Du hast einen.");

  AddDetail( ({"roch","adan","stadt","blick","eindruck"}),
	    "Roch Adan ist die Stadt der Zentauren, besuch sie einfach. Die "
            "Stadt macht einen nette Eindruck. ");

  AddDetail( ({"bilder","eingraviert"}),
	    "Du erkennst verschiedene Bilder, die anscheinend etwas ueber die "
            "Geschichte der Stadt erzaehlen. Vielleicht findest Du jemanden in "
            "Roch Adan, der Dir darueber mehr erzaehlen kann. ");

  AddDetail( ({"jemanden","geschichte"}),
	    "Vielleicht findest Du jemanden im Palast von Roch Adan, der Dir "
            "die Geschichte der Stadt erzaehlen kann. ");

  AddDetail( ({"palast"}),
	    "Der Palast befindet sich sicher irgendwo in der Stadt. ");

  AddDetail( ({"baum","wache","arbeit","torwachen","wachstation"}),
	    "Anscheinend dient der Baum hinter dem Tor den Torwachen als "
            "Wachstation, wo sie sich nach getaner Arbeit ausruhen koennen. ");

  AddDetail( ({"baumriesen","haeuser","stockwerke"}),
	    "Die Zentauren haben ihre Haeuser in Baumriesen gehauen. Sie sind "
            "wirklich beeindruckend, teilweise scheinen sie sogar mehrere "
            "Stockwerke zu haben. ");

  AddDetail( ({"gras"}),
	    "Das ist ganz normales Gras mit ein paar Steinen. Zwischen dem "
            "Gras kannst Du noch etwas Glitzerndes erkennen. ");

  AddDetail( ({"glitzerndes","etwas","glitzern","pferd","etwas glitzerndes"}),
	    "Du findest ein altes Hufeisen, das Du aber wieder wegwirfst. Was "
            "solltest Du auch damit machen? Du bist ja kein Pferd. ");

  AddDetail( ({"hufeisen"}),
	    "Ein Hufeisen liegt im Gras und glitzert in der Sonne. Es ist "
            "nicht sehr interessant.");

  AddDetail( ({"sonne"}),
	    "Die Sonne scheint am fast wolkenlosen Himmel. ");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist fast wolkenlos und die Sonne erwaermt Dich "
            "angenehm. ");

  AddDetail( ({"wolken","wolkenlos"}),
	    "Am Himmel befinden sich ein paar Schaefchenwolken. ");

  AddDetail( ({"schaefchenwolken"}),
	    "Du untersuchst aber wirklich alles. Maaaeeeehhhhhh. ");

  AddDetail( ({"steine","steinen"}),
	    "Du siehst verschiedene Arten von Steinen. ");

  AddDetail( ({"arten","art"}),
	    "Die einzige Art, die Du kennst, sind Kieselsteine. ");

  AddDetail( ({"kieselsteine"}),
	    "Das sind echte Kieselsteine, Du bist erstaunt. ");
  
  AddDetail( ({"baumstaemmen","baumstaemme","mauer"}),
	    "Die Baumstaemme bilden eine sehr hohe und fuer Dich "
            "unueberwindliche Mauer. Die Baumstaemme sind teilweise mit Efeu "
            "zugewachsen. Einer der Baumstaemme kommt Dir ein wenig klein und "
            "duenn vor. Vielleicht kannst Du ihn aus der Mauer reissen und "
            "ihn gebrauchen.");

  AddDetail( ({"efeu","stellen"}),
	    "Der Efeu ist teilweise schon so ueber die Mauer gewachsen, dass "
            "man ihn an einigen Stellen kaum noch sehen kann.");

  AddSmell(DEFAULT_SMELL, "Du riechst die Blumen, das Gras am Boden und auch "
                          "klare Luft.");  
 
  AddSmell( ({"blumen","blume"}),
	   "Blumen verschiedenster Art.");

  AddSmell( ({"luft"}),
	   "Du schnupperst an der klaren Luft und fuehlst Dich frei.");
  
  AddSmell( ({"gras"}),
	   "Wie halt normales Gras riecht.");
  
  AddSound(DEFAULT_SOUND, "Der Wind weht nur ganz leicht durch das lichte "
                          "Blaetterdach. Aus der Stadt im Norden hoerst Du "
                          "verschiedenste Geraeusche. ");

  AddSound( ({"wind","blaetterdach","rascheln"}),
	   "Der Wind verursacht ein leichtes Rascheln im Blaetterdach.");

  AddSound( ({"geraeusche"}),
	   "Die Geraeusche aus der Stadt sind verschiedenster Art - wie sie "
           "halt in einer Stadt ueblich sind. ");

  AddReadDetail( ({"schild"}),
		"\nROCH ADAN - Stadt der Zentauren \n"
                "  \n"
                "(Am unteren Ende des Schildes ist noch eine Schrift zu "
                "erkennen. Vielleicht kannst Du die Schrift auch lesen.)");

  AddReadDetail( ({"schrift"}),
		"Benimm Dich in dieser Stadt, sonst wirst Du es buessen. Dies "
                "ist keine Warnung, dies ist die Silberland-Realitaet. ");


//-----Details Ende-----
AddItem(NPC "torwache", REFRESH_DESTRUCT);
AddItem(NPC "torwache", REFRESH_DESTRUCT);

AddExit("sueden", ROOM "zen12");  
AddExit("nordosten", ROOM "zen16");
AddExit("nordwesten", ROOM "zen14");
AddExit("norden", ROOM "zen15");

AddCmd( ({"reiss", "reisse" }), "reissen" );

}
int reissen(string str)
{
 object stab4;
 notify_fail("Was willst Du wo raus reissen?\n");

 if(!str || str == "") return 0;
 if(!(str == "stamm aus mauer" ||
      str == "baumstamm aus mauer" ||
      str == "baumstamm aus mauer raus" ||
      str == "stamm aus mauer raus" )) return 0;

  if(!present("astroinvis", TP) && !present("dragoninvis2", TP)){
	  
  write(BS("Du probierst den duennen Stamm aus der Mauer zu reissen. Du "
           "brichst Dir dabei jedoch nur Deine gepflegten Fingernaegel ab und "
           "fluchst. Vielleicht klappt es zu einem anderen Zeitpunkt.\n"));
  say(TPN+" springt wild fluchend durch den Raum.\n");
  return -1;
  }
  if(present("stab4", TP)){
	  
  write(BS("Du hast doch den Stab schon. Noch einen brauchst Du nicht.\n"));
 
  say(TPN+" stellt sich einfach dumm an.\n");
  return -1;
  }

  write(BS("Du reisst an dem kleinen Baumstamm und kriegst ihn nach einer Zeit "
           "auch los. Du stellst dabei fest, dass es sich um einen Stab "
           "handelt, den Du sicher gebrauchen kannst. Du beschliesst ihn "
           "einzustecken und zu behalten.\n"));
 
  say(TPN+" steckt etwas ein und freut sich.\n");
  clone_object(OBJ "stab4")->move(TP, M_NOCHECK);
  return 1;
}

