// von Chivas
// 11.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";
inherit "/std/player/moneyhandler";

#include "../def.h"

#include <properties.h>

#include  <moving.h>
int anzahl;

void create()

{
  ::create();

  anzahl = 5;

  AddRoomMessage( ({ "Ein vorbei laufender Haendler schubst Dich.\n"}),
                     30, "sound" );


  SetProp( P_INT_SHORT, "Auf einem Marktplatz");
  SetProp( P_INT_LONG,
	"Hier in der Mitte des Marktplatzes herrscht reges Treiben, Haendler "
	"aus allen Ecken des Silberlandes vertreiben hier ihre Waren. Es "
	"riecht nach Gewuerzen und anderen Sachen, die Du nicht kennst.\n"
	"Im Norden siehst Du einen Baumriesen, der alle anderen ueberragt. Im "
	"Osten und Westen werden weitere Waren verkauft. Im Sueden befindet "
	"sich ein Park, der von einer Hecke umgeben ist, trotzdem kannst Du "
	"ihn von hier aus betreten. ");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden"}), 
            "Der Boden ist mit Gras bedeckt und ueberall stehen Staende und "
	    "die Haendler huschen auf der Marktplatz hin und her.");

  AddDetail( ({"gras"}),
	    "Das Gras ist niedergetrampelt von den viele Haendlern und den "
	    "Besuchern des Marktes. Kleine Steinchen kann man zwischen dem "
	    "Gras sehen.");

  AddDetail( ({"steine","steinchen","steinen"}),
	    "Kleine Steinchen liegen im Gras. Ansonsten kannst Du nichts an den Steinen erkennen.");
  
  AddDetail( ({"treiben","haendler"}),
	    "Hier herrscht ein hektisches Treiben. Haendler aus alles Ecken des Silberlandes verkaufen an "
            "ihren Staenden ihre Waren.");

  AddDetail( ({"marktplatz","marktplatzes","markt","platz","mitte","besucher","besuchern"}),
	    "Du befindest Dich in der Mitte des des Marktplatzes, viele Haendler verkaufen hier ihre Waren "
            "an Staenden. Die Besucher des Marktes laufen zwischen den Staenden umher und kaufen ein.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren.");

  AddDetail( ({"ecken"}),
	    "Sie kommen von ueberall her.");

  AddDetail( ({"silberland","silberlandes"}),
	    "Du befindest Dich im Silberland und Dir gefaellt es hier.");

  AddDetail( ({"zentaur","zentauren","geschoepfe","mensch","pferd"}),
	    "Zentauren sind magische Geschoepfe, halb Mensch und halb Pferd.");

  AddDetail( ({"waren","sachen","dinge"}),
	    "Die Waren sehen alle sehr lecker hier in der Mitte aus. Du siehst Gewuerze, Obst, Gemuese und sogar "
            "Bratwuerstchen. Im Osten und Westen werden die Waren skurriler. Du hast gar nicht die Zeit Dir alle "
            "Waren anzusehen.");

  AddDetail( ({"gewuerze","gewuerzen"}),
	    "Ein paar der Gewuerze kennst Du, aber die meisten hast Du noch nie gesehen.");

  AddDetail( ({"zeit","tode"}),
	    "Jetzt hoer aber auf!!!! Es haben sich schon welche zu Tode untersucht.");

  AddDetail( ({"obst","bananen","ananas","erdbeeren","aepfel","sorten"}),
	    "Du erkennst Bananen, Ananas, Erdbeeren, Aepfel und noch viele anderen Sorten.");

  AddDetail( ({"gemuese","arten","moehren","erbsen","spargel"}),
	    "Du siehst Moehren, Erbsen, Spargel und noch andere Arten von Gemuese.");

  AddDetail( ({"bratwuerstchen","wuerstchen","wurst","bratwurst"}),
	    "Die Bratwuerstchen sehen sehr lecker aus. Vielleicht kannst Du ja eins stibitzen.");

  AddDetail( ({"osten","westen"}),
	   "Im Osten und Westen werden die Waren ein wenig andersartig. Keine normalen Sachen die Du und Ich kaufen.");

  AddDetail( ({"palast","norden","baumriesen","riesen","riese","baumriese"}),
	   "Im Norden befindet sich ein Baumriese, der alle anderen ueberragt. Dies scheint der Palast der Zentauren "
           "zu sein.");

  AddDetail( ({"park","sueden","stelle","strasse","parkes"}),
	   "Im Sueden ist der Park von Roch Adan. An dieser Stelle kannst Du ihn betreten. Ansonsten umschliesst eine "
           "Hecke den Park und trennt ihn von der Strasse ab. Du kannst den Mittelpunkt des Parkes sehen, der leicht erhoeht ist.");

  AddDetail( ({"hecke"}),
	   "Die Hecke umgibt den ganzen Park. Sie ist jedoch an dieser Stelle unterbrochen und Du kannst ihn "
           "betreten.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau, die Sonne scheint und ein paar Wolken sind zu sehen.");

  AddDetail( ({"wolken","regen"}),
	    "Die Wolken sind weiss und es sieht nicht nach Regen aus.");

  AddDetail( ({"sonne"}),
	    "Die Sonne steht senkrecht am Himmel und waermt Dich.");

  AddDetail( ({"staenden","staende"}),
	    "An den Staenden preisen die Haendler ihre Waren an.");

  AddDetail( ({"mittelpunkt","punkt","erhoehung"}),
	    "Die Erhoehung im Mittelpunkt des Parkes ist sogar von hier gut zu erkennen. Auf der Erhoehung steht eine Statue.");
  
  AddDetail( ({"statue"}),
	    "Die Statue steht in der Parkmitte, um sie genau zu erkennen, bist Du jedoch zu weit weg.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","ich","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Gewuerzen.");  
 
  AddSmell( ({"gewuerzen","gewuerze"}),
	   "Die Gewuerze riechen teilweise ganze exotisch.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Haendler um ihre Waren feilschen.");

  AddSound( ({"haendler","argumente"}),
	   "Die Haendler feilschen lauthals und die Argumente sind ziemlich wirr.");
  
//-----Details Ende-----

AddItem(NPC "zentaurk1", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "zen36",
          P_MNPC_AREA:({ROOM "zen13", ROOM "zen16", ROOM "zen17",
                          ROOM "zen18", ROOM "zen19", ROOM "zen20",
                          ROOM "zen21", ROOM "zen22", ROOM "zen23",
                          ROOM "zen24", ROOM "zen25", ROOM "zen26",
                          ROOM "zen27", ROOM "zen28", ROOM "zen29",
                          ROOM "zen30", ROOM "zen31", ROOM "zen32",
                          ROOM "zen33", ROOM "zen34", ROOM "zen35",
                          ROOM "zen36", ROOM "zen37", ROOM "zen43",
                          ROOM "zenladen",ROOM "zenschmied"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
 
AddExit("sueden", ROOM "zen32");  
AddExit("osten", ROOM "zen37");
AddExit("westen", ROOM "zen35");
AddExit("norden", ROOM "zen42");

AddCmd( ({"stibitze" }), "stibitzen" );

}
void reset()
{
  ::reset();

  anzahl=5;
}
int stibitzen(string str)
{
   notify_fail("Was moechtest Du stibitzen?\n");
   if ( member( ({ "bratwuerstchen", "bratwurst","wurst","wuerstchen" }),str) != -1) 
  { 
    if ( anzahl )
    {
    write(BS( "Du stibitzt ein Wuerstchen und es schmeckt gut."));
    say(BS( TPN+" stibitzt ein Wuerstchen und schlingt es schnell herunter."));
      TP -> eat_food(2);
      TP -> heal_self(5+random(10));
      anzahl--;
    }
    return 1;
    write(BS( "Du schaffst es nicht eines zu stibitzen."));
    return 1;
  }
}

