


inherit "/std/room";

#include "../def.h"
#include "/mail/post.h"
#include <properties.h>
#include <rooms.h>
#include  <moving.h>

create(argh) {
  int i;
  (::create());
  SetProp(P_INT_SHORT,"Im Postamt von Roch Adan");
  SetProp(P_INT_LONG,
          "Dies ist das Postamt von Roch Adan. Hier kannst Du Briefe an Deine "
          "Mitspieler schicken und Briefe von ihnen lesen. Die Post befindet sich "
          "in einer fuer Roch Adan typischen Baumhoehle. Der Unterschied ist nur, "
          "dass ueberall grosse Haufen an Paeckchen und Briefen herum liegen. "
          "Der zustaendige Postbeamte scheint kein Freund von Ordnung zu sein.\n" 
          "                                                              \n"
          "Wenn Du das willst, tippe 'post' oder 'mail', bzw. 'mail <spieler>'.\n");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"postamt","amt","post"}), 
            QueryProp(P_INT_LONG));

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Roch Adan ist die Stadt, in der Du Dich gerade befindest.");

  AddDetail( ({"briefe","brief","briefen"}),
	    "Ueberall sind Haufen mit Briefen. Der zustaendige Postbeamte koennte "
            "sie wenigstens einmal ordentlich wegsortieren.");

  AddDetail( ({"mitspieler","spieler"}), 
            "Die anderen angemeldeten Spieler.");

  AddDetail( ({"baumhoehle","hoehle"}),
	    "Die Baumhoehle in diesem Baumriesen ist als Post eingerichtet.");

  AddDetail( ({"unterschied"}),
	    "Der Unterschied ist, dass dies eine Post ist und hier keiner wohnt."); 
  
  AddDetail( ({"haufen"}), 
            "Ueberall liegen groessere und kleinere Haufen mit Briefen und Paeckchen.");

  AddDetail( ({"paeckchen","pakete","paket","besitzer","besitzern","paketen"}),
	    "Lauter Pakete liegen auf dem Boden rum und warten von den Besitzern abgeholt "
            "zu werden.");

  AddDetail( ({"postbeamte","beamte","freund"}),
	    "Der Postbeamte, der hier zustaendig ist, ist kein Freund von Ordnung, "
            "alle Briefe und Pakete fliegen umher.");

  AddDetail( ({"ordnung","saustall"}), 
            "Hier ist geradezu ein Saustall. Von Ordnung ist man hier weit entfernt.");

  AddDetail( ({"boden"}),
	    "Am Boden sind lauter Haufen von Briefen und Paketen. Der zustaendige "
            "Postbeamte koennte sie ruhig mal ordentlich wegsortieren.");

  AddDetail( ({"himmel"}),
	    "Den kannst Du nicht sehen, da musst Du schon raus gehen."); 

  AddDetail( ({"wand","waende","spur"}),
	    "Auch an den Waenden stapelt sich die Post, von Ordnung keine Spur."); 
  
  AddDetail( ({"baumriesen","riesen","baum"}), 
            "Die ganze Stadt besteht aus Baumriesen, in denen die Zentauren ihre Baumhoehlen "
            "haben.");

  AddDetail( ({"groessere haufen"}),
	    "Halt verschiedene Pakete und Briefe.");

  AddDetail( ({"kleinere haufen"}),
	    "Halt verschiedene Pakete und Briefe. Aber ein Umschlag faellt Dir auf.");

  AddDetail( ({"decke","holz"}),
	    "Eine ganz normale Decke aus Holz.");

  AddDetail( ({"Zentauren"}), 
            "Was das sind, muesstest Du eigentlich, wo Du soweit schon in ihrer Stadt "
            "gekommen bist, schon wissen.");

  AddDetail( ({"umschlag","briefes"}),
	    "Auf dem Umschlag des Briefes steht Dein Name. Oeffne den Umschlag doch und schau "
            "nach was drin ist.");

  AddDetail( ({"name","namen"}),
	    "Deinen Namen solltest Du schon kennen."); 

  AddDetail( ({"flecke"}),
	    "Die Flecke scheinen Buchstaben zu sein."); 
  
  
  
  AddDetail( ({"buchstaben"}),
	    "Du kannst sie lesen."); 

  AddDetail( ({"gutschein"}),
	    "Du kannst ihn lesen."); 
   
  AddSmell(DEFAULT_SMELL, "Es riecht nach Papier.");  
 
  AddSmell( ({"papier","briefe","briefen","geruch"}),
	   "Der Geruch stammt sicher von den Briefen. Das ist aber noch Etwas anderes.");

  AddSmell( ({"etwas","ecke"}),
	   "Es riecht ein wenig schimmelig aus einem alten Paket in der Ecke.");

  AddSmell( ({"paket"}),
	   "In dem Paket scheint irgendwas zu sein, dass verdorben ist. Wie ekelig. Du bist "
           "froh, dass das Paket nicht fuer Dich ist.");

  AddSound(DEFAULT_SOUND, "Es ist sehr still hier drinnen. Man hoert nur den Laerm der Stadt "
                          "der durch die Tuer dringt.");

  AddSound( ({"tuer","laerm","stadt","stadtlaerm"}),
	   "Ganz normaler Stadtlaerm, nichts besonderes.");


  AddSpecialDetail( ({"zettel"}), "detail_zettel");
                
  AddReadDetail( ({"gutschein"}),
		"************************************************\n"
                "*                                              *\n"
                "*              G U T S C H E I N               *\n"
                "*                                              *\n"
                "*          ueber einen Tod ohne Abzug          *\n"
                "*            von Erfahrungspunkten !           *\n"
                "*                                              *\n"
                "*....                                          *\n"
                "************************************************\n"
                "                                                \n"
                "An der linken unteren Ecke fallen Dir einige kleine Flecke auf.");

  AddReadDetail( ({"buchstaben"}),
		"Die Buchstaben bilden einen kleinen Satz, der Dir mitteilt, dass "
                "der Gutschein zu einem bestimmten Datum ablaeuft. Das Datum war "
                "gestern und Du verfluchst die Post.\n"
                "Du zerknuellst den Zettel und den Gutschein und wirfst beides weg.");

//-----Details Ende-----

  AddExit("norden", ROOM "zeng2"); 
  
  AddCmd("post","do_mail");
  AddCmd("mail","do_mail");
  AddCmd( ({"oeffne" }), "oeffnen" );
//  AddCmd("zettel", "zettelfunc", 1);
 
  SetProp(P_INDOORS,1);

  if (!argh) {
    for (i=0;i<NRCABINS;++i) AddItem(MAILCABIN,REFRESH_REMOVE);
  }
}

do_mail(str) {
  object mailer;
  if (this_interactive()!=this_player()) return 0;
  mailer=clone_object(MAILER);
  mailer->SetOfficeName(short());
  mailer->do_mail(str);
  return 1;
}

int oeffnen(string str)
{
   notify_fail("Was moechtest Du oeffnen?\n");
   if ( member( ({ "umschlag", "brief" }),str) != -1) 
  {
    write(BS ( "Du oeffnest den Umschlag, er enthaelt einen Zettel."));
    say( TPN+" oeffnet etwas.\n");
    return 1;
  }

}  

string detail_zettel()
{
  if(TP)
  return "LIEBER "+TPN+",\n"
         "DA ICH DIR BEIM LETZTEN MAL ZU VIELE ERFAHRUNGSPUNKTE \n"
         "ABGEZOGEN HABE, ANBEI EIN GUTSCHEIN UND NOCHMALS \n"
         "ENTSCHULDIGUNG. \n"
         "                                            \n"
         "TOD \n";
  else
  return "blubb";
}    
