inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>


void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einer Gasse in Roch Adan");
  SetProp( P_INT_LONG,
	"Du befindest Dich in einer kleinen Gasse, die nach Norden zu einem Tor "
	"fuehrt, durch das man Roch Adan in unbekanntes Gebiet verlassen kann. "
	"Im Sueden befindet sich der kleine Platz, ueber den Du bis hierher "
	"gekommen bist. Zu beiden Seiten wird die Gasse durch Baumriesen eingeengt, in "
	"denen die Zentauren wohnen und arbeiten.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----
  AddDetail( ({"gasse"}), 
            "Du bist in einer schmalen Gasse, die von den Baumriesen eingeengt wird. Im "
            "Osten und Westen sind Baumhoehlen in denen Zentauren wohnen.");

  AddDetail( ({"norden","tor"}),
	    "Im Norden scheint ein Tor zu sein, durch das man anscheinend die Stadt "
            "verlassen kann.");

  AddDetail( ({"gebiet"}),
	    "Ein unbekanntes Gebiet ist ein Gebiet, das unbekannt ist.");

  AddDetail( ({"sueden","platz"}), 
            "Im Sueden ist der Platz, ueber den Du hier her gekommen bist. Wenn Du "
            "ihn naeher betrachten willst, solltest Du hingehen.");

  AddDetail( ({"seiten","westen","osten"}),
	    "Im Osten und Westen sind Baumriesen, in die die Zentauren ihre Baumhoehlen haben.");

  AddDetail( ({"baumriesen","rand","riesen","hoehlen","baumhoehlen","baumhoehle","hoehle"}),
	    "In den Baumriesen wohnen einige Zentauren. Obwohl die Gasse in der Du stehst "
            "am Rand von Roch Adan liegt, wirken die Baumhoehlen sehr gepflegt und nicht "
            "runtergekommen. Du siehst gepflegte Tueren und saubere Fenster."); 
  
  AddDetail( ({"boden"}), 
            "Der Boden ist mit Pflastersteinen bedeckt. Sie einzelnen Steine haben "
            "alle die gleiche Groesse. Wirklich erstaunlich.");

  AddDetail( ({"pflaster","pflastersteine","steine","platte"}),
	    "Grosse Pflastersteine bedecken den Boden. Nur kleine Fugen sind zu erkennen, "
            "ansonsten koennte man denken es ist eine grosse Platte.");

  AddDetail( ({"fugen"}),
	    "Die Fugen sind sehr klein und man erkennt nur ein wenig Unkraut und ansonsten "
            "ein bisschen Dreck.");

  AddDetail( ({"dreck","fingernaegeln","fingernaegel","naegel"}), 
            "Ganz normaler Dreck, wie unter Deinen Fingernaegeln.");

  AddDetail( ({"unkraut"}),
	    "Es ist nur ein wenig Unkraut zu sehen, die Gasse sieht trotzdem recht gepflegt aus.");

  AddDetail( ({"tueren","tuer"}),
	    "Die Tueren sehen alle sehr sauber aus und als ob sie erst vor kurzem neu gestrichen "
            "wurden. Vor den Tueren liegen grosse Fussmatten, wo die Zentauren ihre Hufe "
            "abputzen koennen, bevor sie die Hoehle betreten."); 
  
  AddDetail( ({"fenster","fenstern"}), 
            "Die Fenster sehen sauber geputzt aus und die Gardinen hinter den Fenstern sehen "
            "strahlend weiss aus. Vor den Fenstern haengen grosse Blumenkaesten.");

  AddDetail( ({"gardinen","gardine"}),
	    "Die Gardinen sind strahlend weiss. Hinter einer Gardine scheint sich Etwas zu verstecken.");

  AddDetail( ({"etwas"}), 
            "Es scheint ein kleines Zentaurenmaedchen zu sein.");

  AddDetail( ({"maedchen","zentaurenmaedchen"}),
	    "Das Zentaurenmaedchen scheint ein wenig schuechtern zu sein. Wink ihr doch einfach "
            "mal zu, es wird sie sicher freuen.");

  AddDetail( ({"fussmatten","matten","zentaur"}),
	    "Es sind riesige Fussmatten, so dass ein ausgewachsener Zentaur sich alle vier Hufe "
            "gleichzeitig abputzen kann.");

  AddDetail( ({"blumenkaesten","kaesten"}),
	    "In den Blumenkaesten wachsen schoene kleine Blumen."); 
  
  AddDetail( ({"blumen"}), 
            "Die Blumen in manchen Kaesten erkennst Du als Stiefmuetterchen. Die anderen Arten "
            "kennst Du nicht.");

  AddDetail( ({"stiefmuetterchen"}),
	    "Kleine Stiefmuetterchen sind in die Blumenkaesten gepflanzt. Sie sehen wirklich "
            "huebsch aus.");

  AddDetail( ({"groesse"}),
	    "Da muss jemand eine muehevolle Arbeit gehabt haben, die einzelnen Pflastersteine "
            "alle auf die gleiche Groesse zu bekommen. Dies war sicher die Arbeit eines "
            "Straeflings. Keiner tut das freiwillig.");

  AddDetail( ({"arbeit","straeflings","straefling","arbeiten"}), 
            "Du siehst hier keinen Straefling der diese Arbeit macht, aber Du solltest Dich "
            "auch nicht zu sehr dafuer interessieren. Du hast gehoert, dass die Zentauren "
            "sehr gerne interessierte Abenteurer fuer solche Arbeiten zwangsverpflichten.");

  AddDetail( ({"abenteurer","jemand"}),
	    "Jemand wie Du!");

  AddDetail( ({"hufe"}),
	    "Also Du hast keine."); 
  
  AddDetail( ({"arten"}), 
            "Diese Blumen kennst Du nicht, Du beschliesst Dich in diesem Bereich mehr zu bilden.");

  AddDetail( ({"bereich","bereichen"}),
	    "Eigentlich solltest Du Dich in allen Bereichen mehr bilden.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Dies ist die Stadt der Zentauren. Dir gefaellt es hier sehr gut.");

  AddDetail( ({"zentauren","wesen","oberkoerper","rest","pferdes"}), 
            "Die Zentauren sind stolze Wesen. Ihr Oberkoerper ist menschlich und der Rest eines Pferdes.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau und die Wolken ziehen langsam vorbei. Ein paar Voegel ziehen ihre Kreise.");

  AddDetail( ({"wolken"}), 
            "Die Wolken ziehen langsam am Himmel entlang, verdecken aber nicht die Sonne.");

  AddDetail( ({"sonne"}),
	    "Die Sonne waermt Dich sehr und Du fuehlst Dich wohl.");

  AddDetail( ({"voegel","kreise"}),
	    "Ein paar Voegel ziehen am Himmel ihre Kreise. Sie sind jedoch zu hoch um genau zu erkennen um "
            "was fuer Voegel es sich handelt."); 
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");


  AddSmell(DEFAULT_SMELL, "Du riechst die klare Luft und fuehlst Dich gut.");  
 
  AddSmell( ({"luft","fruehling"}),
	   "Die Luft ist sehr warm und riecht nach Fruehling.");

  AddSound(DEFAULT_SOUND, "Du hoerst den ueblichen Stadtlaerm.");

  AddSound( ({"stadtlaerm","laerm","beschaeftigungen"}),
	   "Du hoerst die Zentauren, wie sie ihren Beschaeftigungen nachgehen und wie andere Abenteurer "
           "die Stadt erkunden.");

//-----Details Ende-----

AddExit("sueden", ROOM "zeng2");  
AddExit("norden", ROOM "zentor2" );

AddCmd( ({"wink", "winke" }), "winken" );

}
int winken(string str)
{
   notify_fail("Wem moechtest Du zuwinken?\n");
   if ( member( ({ "maedchen", "zentaurenmaedchen","maedchen zu","zentaurenmaedchen zu" }),str) != -1) 
  {
    write(BS( "Du winkst dem Zentaurenmaedchen freundlich zu. Es kichert und winkt Dir froehlich "
           "zurueck. Du freust Dich und denkst das dies der richtige Weg ist Freundschaft mit "
           "Dir unbekannten Rassen zu schliessen.\n"));
     say( TPN+" winkt jemandem zu, den Du nicht sehen kannst.\n");
     return 1;
  }
}
