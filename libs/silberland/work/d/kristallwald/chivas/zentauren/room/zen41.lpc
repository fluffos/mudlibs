// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Thronsaal");
  SetProp( P_INT_LONG,
	"Du befindest Dich nun im Thronsaal des Zentauren-Palastes. Es sieht "
	"hier gar nicht mehr aus wie in einem Baum. Die Waende sind eben und "
	"glitzern leicht, an manchen Stellen haengen Portraits von alten "
	"Zentaurenkoenigen und Fackeln, die den Raum erhellen. Der Boden, ist "
        "wie im restlichen Palast, mit Reisig bedeckt. An der Nordwand steht ein "
        "Thron, wenn es ein Thron sein soll. Er sieht irgendwie komisch aus, halt "
        "nicht wie ein normaler Thron." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden"}), 
            "Der Boden ist mit Reisig bedeckt. Zwischen dem Reisig sieht man "
            "Steinplatten aus denen der Boden anscheinend besteht. ");

  AddDetail( ({"reisig","seite"}), 
            "Ganz normaler Reisig, vielleicht kannst Du ihn zur Seite schieben. ");
  
  AddDetail( ({"stein","steinplatten","platten"}), 
            "Die Steinplatten kann man so nicht richtig erkennen, da sie vom Reisig "
            "bedeckt sind. Vielleicht kann man den Reisig zur Seite schieben. ");

  AddDetail( ({"fugen"}), 
            "Die Fugen sind sauber verspachtelt. Da kannst Du nichts weiter entdecken. ");

  AddDetail( ({"himmel"}), 
            "Den Himmel kannst Du nicht sehen, Du bist in einem Baum. Hier gibt es "
            "nur eine Decke. ");

  AddDetail( ({"baum"}), 
            "Du befindest Dich in einem Baum, obwohl es hier gar nicht so aussieht.");
  
  AddDetail( ({"wand","waende","waenden"}), 
            "An den Waenden haengen Portraits laengst vergangener Koenige und "
            "Fackeln, die den Raum erhellen. An der Nordwand steht der Thron. ");
  
  AddDetail( ({"koenige","zentaurenkoenige","koenig","zentaurenkoenig"}), 
            "Ehemalige Koenige der Zentauren sind auf den Portraits abgebildet. ");

  AddDetail( ({"fackeln","fackel"}), 
            "Die Fackeln haengen in Halterungen und erhellen den Thronsaal. ");

  AddDetail( ({"halterung","halterungen"}), 
            "Die Fackeln haengen in Halterungen und erhellen den Thronsaal, sie "
            "haben einen goldenen Schimmer. ");

  AddDetail( ({"schimmer","gold"}), 
            "Die Halterungen bestehen aus purem Gold. Auch kleine Edelsteine kannst "
            "Du daran erkennen. ");

  AddDetail( ({"edelsteine"}), 
            "Kleine Edelsteine verzieren die goldenen Halterungen. ");
    
  AddDetail( ({"portraits","stellen"}), 
            "An den Waenden haengen insgesamt fuenf Portraits laengst vergangener "
            "Koenige. Jedes stellt einen anderen Koenig dar. ");

  AddDetail( ({"portrait"}), 
            "Welches Portrait meinst Du ? An der Wand haengen insgesamt fuenf Portraits. "
            "Alle sind verschieden. ");

  AddDetail( ({"portrait 1"}), 
            "In diesem Portrait siehst Du einen maechtig aussehenden Zentaurenkoenig, "
            "der ein machtvolles Schwert haelt und gerade einen Troll niederstreckt. ");

  AddDetail( ({"portrait 2"}), 
            "In diesem Portrait siehst Du einen mittelgrossen Zentaurenkoenig, "
            "der einen Dunkelelfen niedertrampelt. ");

  AddDetail( ({"portrait 3","pfeil","bogen"}), 
            "In diesem Portrait siehst Du einen grossen Zentaurenkoenig, "
            "der eine fliegende Fee mit Pfeil und Bogen verfolgt. ");

  AddDetail( ({"portrait 4","rauschebart","bart"}), 
            "In diesem Portrait siehst Du einen Zentaurenkoenig mit Rauschebart, "
            "der mit einer Hellebarde einen Zwerg erschlaegt. Zu seinen Hufen liegen "
            "schon ein Oger, ein Elf und ein ganzer Haufen Magier. ");

  AddDetail( ({"portrait 5"}), 
            "Auf diesem Portrait siehst Du einen Koenig, der recht lebendig aussieht. "
            "Vielleicht solltest Du das Bild naeher betrachten. ");

  AddDetail( ({"thronsaal","saal","raum","palast","palastes"}), 
        "Du befindest Dich nun im Thronsaal des Zentauren-Palastes, es sieht "
	"hier gar nicht mehr aus wie in einem Baum, die Waende sind eben und "
	"glitzern leicht, an manchen Stellen haengen Portraits von alten "
	"Zentauren-Koenigen und Fackeln, die den Raum erhellen. Der Boden ist wie im "
        "restlichen Palast mit Reisig bedeckt. An der Nordwand steht ein Thron, wenn "
        "es ein Thron sein soll, er sieht irgendwie komisch aus, halt nicht wie ein "
        "normaler Thron. " );

  AddDetail( ({"troll","dunkelelfen","dunkelelf","fee","oger","elf","zwerg"}), 
            "Eine der viele Rassen im Silberland. ");

  AddDetail( ({"silberland","welt"}), 
            "Du bist im Silberland und findest es toll hier! ");

  AddDetail( ({"rassen"}), 
            "Es gibt sehr viele verschiedene Rassen in dieser Welt! ");

  AddDetail( ({"magier","haufen","vergangenheit"}), 
            "Na wenigstens hat einer in der Vergangenheit den Magiern mal gezeigt, "
            "wer das Sagen hat. ");

  AddDetail( ({"schwert","hellebarde","waffe"}), 
            "Eine maechtige Waffe. So eine Waffe haettest Du wohl auch gerne. ");

  AddDetail( ({"zentauren","wesen"}), 
            "Die Zentauren sind stolze Wesen, halb Mensch, halb Pferd. ");

  AddDetail( ({"mensch","pferd","fragen"}), 
            "Stell nicht so bloede Fragen! ");

  AddDetail( ({"thron","komisch","kanapee","nordwand"}), 
            "Der Thron steht an der Nordwand und sieht eher aus wie ein lang gestrecktes "
            "Kanapee, waere auch witzig, einen Zentauren auf einem normalen Thron sitzen "
            "zu sehen. Am Thron sind kleine Verzierungen zu erkennen. ");

  AddDetail( ({"verzierungen","teile"}), 
            "Die Verzierungen stellen anscheinend Teile aus der Geschichte der Zentauren dar. "
            "Auch eine kleine Kritzelei kannst Du erkennen. ");

  AddDetail( ({"kritzelei","kritzeleien"}), 
            "Die Kritzelei ist sehr klein und kaum lesbar. Aber Du kannst es ja mal "
            "probieren. ");

  AddDetail( ({"glitzern"}), 
            "Das Glitzern kommt von den goldenen Halterungen, in denen die Fackeln stecken. ");

  AddDetail( ({"decke"}), 
            "Die Decke ist sehr weit oben, Du kannst sie kaum erkennen. Es sieht aber so aus, "
            "als ob Fledermaeuse an der Decke haengen.");

  AddDetail( ({"fledermaeuse"}), 
            "Es haengen wirklich Fledermaeuse an der Decke. Besser man ist ruhig, damit man "
            "sie nicht weckt. ");


  AddDetail( ({"geschichte"}), 
            "Ueber die Geschichte der Zentauren weisst Du gar nichts und verstehst deshalb "
            "die Verzierungen auch nicht. ");

  AddSmell(DEFAULT_SMELL, "Es riecht hier nach Reisig und irgendwie nach Pferd, aber "
                          "das behaelst Du wohl besser fuer Dich.");  
 
  AddSmell( ({"Reisig"}),
	   "Du kannst am Reisig nichts besonderes riechen.");

  AddSmell( ({"pferd","duft","thema"}),
	   "Das ist wohl ein normaler Duft, den die Zentauren haben. Du solltest aber "
           "besser nichts ueber das Thema sagen.");
   
  AddSound(DEFAULT_SOUND, "Du hoerst das Trampeln von Hufen auf dem Reisig. ");

  AddSound( ({"trampeln","hufe","hufen","geraeusch"}),
	   "Das Geraeusch machen die Zentauren waehrend sie durch den Thronsaal traben.");

  AddReadDetail( ({"kritzelei"}),
           "Wir brauchen keinen Koenig, wir brauchen ein demokratisches Parla___ \n"
           "    \n"
           "Da bricht die Kritzelei ab, anscheinend wurde der Schmierfink erwischt. Was wohl mit "
           "ihm geschehen ist. *Schluck* ");
  
//-----Details Ende-----
AddItem(NPC "palastwache", REFRESH_DESTRUCT);
AddItem(NPC "roarex", REFRESH_DESTRUCT);

AddExit("sueden", ROOM "zen39");  
AddExit("suedosten", ROOM "zen40");  
AddExit("suedwesten", ROOM "zen38"); 

AddCmd( ({"raeume","schiebe","schieb","raeum" }), "schiebe" );
AddCmd( ({"hebe"}), "heben" );
AddCmd( ({"betrachte"}), "betrachte" );
}
int schiebe(string str)
{
   notify_fail("Was moechtest Du zur Seite schieben?\n");
   if ( member( ({ "reisig","reisig weg","reisig beiseite","reisig zur seite"}),str) != -1) 
  {
    write(BS( "Du schiebst den Reisig beiseite und erkennst nun die Steinplatten ganz "
           "deutlich. Du erkennst zwischen den Steinplatten Fugen und ein wenig "
           "Schmutz. Eine Steinplatte ist ein wenig locker, vielleicht kannst Du sie "
           "ja anheben.\n"));
    say( TPN+" schiebt das Reisig am Boden zu Seite und betrachtet die Steinplatten.\n");
    return 1;
  }
}
int heben(string str)
{
 object schraubenzieher;
 notify_fail("Was willst Du heben?\n");

 if(!str || str == "") return 0;
 if(!(str == "steinplatte" ||
      str == "steinplatte an" ||
      str == "platte an"||
      str == "platte" )) return 0;
 

 if( str == "steinplatte" ||
     str == "steinplatte an" ||
     str == "platte an"||
     str == "platte"){

  if(!present("astroinvis", TP) && !present("dragoninvis2", TP)){
	  
  write(BS("Du bist enttaeuscht. Momentan findest Du hier leider nichts.\n"));
 
  say(TPN+" ist enttaeuscht.\n");
  return -1;
  }
  if(present("schraubenzieher", TP)){
	  
  write(BS("Du findest nichts mehr. Du hast alles was Du brauchst.\n"));
 
  say(TPN+" findet im Boden nichts mehr.\n");
  return -1;
  }

  schraubenzieher=clone_object(OBJ "schraubenzieher");

  if(schraubenzieher->move(TP, M_GET)==ME_TOO_HEAVY)
  {
   write(BS("Du hebst die Steinplatte an und findest einen Schraubenzieher. "
            "Leider ist er Dir zu schwer, daher laesst Du ihn liegen und "
            "legst die Steinplatte wieder sauber zurueck."));
   schraubenzieher->remove(1);
  }
  else
  write(BS("Du hebst die Steinplatte an und findest einen Schraubenzieher, den Du "
	  "auch sofort einsteckst. Danach legst Du die Steinplatte wieder sauber zurueck. \n"));
 
  say(TPN+" scheint was am Boden entdeckt zu haben.\n");
  return 1;
 }
}


int betrachte(string str)
{
   notify_fail("Was moechtest Du betrachten?\n");
   if ( member( ({ "portrait", "portrait 5", "portrait naeher","portrait 5 naeher" }),str) != -1) 
  {
    write(BS("\n Du betrachtest den Koenig auf dem Portrait naeher, er sieht wirklich lebendig aus. "
           "Als Du naeher ran gehst steigt der Koenig ploetzlich mit seinem Schwert aus seinem Rahmen "
           "und verpasst Dir eine Ohrfeige.\n"));
    say( TPN+" kriegt von einer Person aus einem Gemaelde eine unglaublich starke Ohrfeige.\n");
    TP->SetProp(P_PARALYZED, ([
                PARALYZE_TIME: 16,
                PARALYZE_MSG: "Du bist gerade ohnmaechtig und kannst nichts tun.\n",
                PARALYZE_END: "Als Du zu Dir kommst, siehst Du noch wie eine Palastwache den Koenig wieder "
                              "mit einem Speer in das Gemaelde zurueck draengt.\n"
                              ]) );	
      call_out("fall1",4);
    return 1;
  }
 }
void fall1()
{
  write(BS( "Du fliegst von dem Schlag durch den halben Thronsaal und als Du aufkommst "
         "schwinden Dir die Sinne. Dein Kopf droehnt und Dir wird schwarz vor Augen.\n"));
}  

