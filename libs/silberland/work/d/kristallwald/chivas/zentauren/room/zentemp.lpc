// von Chivas
// 01.6.2004
// 
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl;

void create()
	
{
  ::create();

  anzahl = 2;

SetProp(P_INT_SHORT,"In einem Tempel");
SetProp(P_INT_LONG,
   "Du befindest Dich im Tempel von Roch Adan. Hier beten die Zentauren "
   "zu ihren Goettern. Die Waende im Baum sind prunkvoll geschmueckt und "
   "an der Ostwand steht ein grosser Altar. Irgendwie fuehlst Du fast die "
   "heilige Aura der Zentaurengoetter und Du blickst Dich ehrfuerchtig um. "
   "Auch Du kannst hier beten und Deinen Frieden mit den Goettern machen.");
SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
SetProp(P_INDOORS, 1);
SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
 
  AddDetail( ({"tempel","holz"}),
	    "Der Tempel in dem Du Dich befindest sieht gar nicht aus, als waere "
            "er in einem Baum gebaut. Du kannst nirgends Holz sehen. Er koennte "
            "sonst wo sein.");

  AddDetail( ({"roch","adan","roch adan","stadt"}), 
            "Roch Adan ist die Stadt der Zentauren.");

  AddDetail( ({"opfer","fruechte"}), 
            "Die Opfer, die die Zentauren ihren Goettern dar bringen, sind Fruechte. "
            "Also nicht das was Du vorher gedacht hast. Ganz harmlos.");

  AddDetail( ({"goettern","zentaurengoetter","goetter","gott","geister","baeume","lebewesen"}),
	    "Die Zentauren glauben ihre Goetter sind Geister, die in ihnen leben und in "
            "allen Lebewesen im Silberland. Durch die Naturverbundenheit der Zentauren, "
            "ist das Zeichen ihres Glaubens ein grosser Baum, aehnlich der Baeume, "
            "in denen sie wohnen und arbeiten.");

  AddDetail( ({"naturverbundenheit","stueck","papier"}), 
            "Du bist leider nicht so naturverbunden wie die Zentauren. Du erinnerst "
            "Dich, dass Du erst gestern ein Stueck Papier arglos weggeworfen hast. "
            "Du fuehlst Dich schlecht.");

  AddDetail( ({"waende","wand"}),
	    "Welche Wand meinst Du? Nordwand, Westwand, Ostwand oder Suedwand?"); 

  AddDetail( ({"kerzen","kerze"}), 
            "Ein paar Kerzen brennen auf dem Altar. Ansonsten ist an ihnen "
            "nichts besonderes. Auch ein paar Raeucherstaebchen qualmen vor "
            "sich hin.");

  AddDetail( ({"raeucherstaebchen","staebchen"}), 
            "Die Raeucherstaebchen qualmen leicht.");
  
  AddDetail( ({"nordwand"}), 
            "An der Nordwand haengen einige Fackeln, die den Tempel leicht erhellen. Auch "
            "einige Teppiche erkennst Du.");

  AddDetail( ({"suedwand"}),
	    "An der Suedwand haengen einige Fackeln in ihren Halterungen und ein paar "
            "Teppiche, die die Wand verschoenern.");

  AddDetail( ({"westwand","tor"}),
	    "In der Westwand ist das Tor, das Dich wieder aus dem Tempel heraus fuehrt.");

  AddDetail( ({"ostwand"}), 
            "An der Ostwand steht ein grosser Altar, wo die Zentauren ihren Goettern "
            "Opfer darbringen. Hinter dem Altar haengt ein riesiger Gobelin an der Wand.");

  AddDetail( ({"altar"}),
	    "Der Altar ist riesengross und besteht aus schwarzem Granit. Auf der Vorderseite "
            "erkennt man ein grosses Symbol und auf dem Altar stehen einige Kerzen.");

  AddDetail( ({"granit"}), 
            "Der Altar besteht aus schwarzem Granit. Es war sicher schwer einen so grossen "
            "Altar hier her zu bringen.");

  AddDetail( ({"aura"}),
	    "Die Aura kannst Du nicht untersuchen, hoechstens fuehlen."); 
  
  AddDetail( ({"frieden","ziel","rassen","gilden"}), 
            "Frieden ist sehr wichtig, und das hoechste Ziel der Zentauren. Sie stehen allen "
            "Rassen und Gilden im Silberland neutral gegenueber und greifen nur an, wenn "
            "jemand sie stoert.");

  AddDetail( ({"boden"}),
	    "Der Boden hier im Tempel ist komplett anders als in den Baumhoehlen in denen Du "
            "bisher warst. Der Boden wird aus Moos gebildet und es ist angenehm weich und "
            "federnd auf ihm zu gehen.");

  AddDetail( ({"decke"}),
	    "An der Decke haengen viele Blaetter.");

  AddDetail( ({"blaetter"}),
	    "Der Tempel ist wirklich komisch. Du befindest Dich in einem Baum und im Baum sind "
            "Blaetter. Was es nicht alles gibt.");

  AddDetail( ({"himmel"}), 
            "Um den Himmel zu sehen, solltest Du schon raus gehen.");

  AddDetail( ({"wandteppiche","teppiche","wandteppichen","szenen","geschichte"}),
	    "Auf den Wandteppichen sind Szenen aus der Geschichte der Zentauren abgebildet, aber sehr "
            "uninteressant. Du interessierst Dich nicht sehr fuer Geschichte.");

  AddDetail( ({"baumhoehlen","hoehlen","hoehle","baumhoehle"}), 
            "Diese Baumhoehle unterscheidet sich von allen anderen, die Du bisher gesehen "
            "hast.");

  AddDetail( ({"silberland"}), 
            "Du bist im Silberland.");

  AddDetail( ({"gobelin"}),
	    "Auf dem Gobelin ist ein grosser Baum abgebildet, vor dem ein paar Zentauren beten.");

  AddDetail( ({"baum","baumriesen","riesen"}),
	    "Der Baum ist gross und stellt anscheinend einen Baumriesen dar, wie es sie hier in "
            "Roch Adan gibt. Es ist das Zeichen des Glaubens der Zentauren."); 
  
  AddDetail( ({"zeichen","glauben","glaubens"}), 
            "Das Zeichen fuer den Glauben der Zentauren ist ein grosser Baum.");

  AddDetail( ({"symbol","vorderseite"}),
	    "Das Symbol stellt einen grossen Baum dar und besteht aus purem Gold.");

  AddDetail( ({"gold","gefahr","lust"}),
	    "Du gierst nach dem Gold und haettest Lust das Symbol abzureissen. Aber pass auf, "
            "Du tust es auf eigene Gefahr.");

  AddDetail( ({"fackeln","fackel"}), 
            "Die Flammen der Fackeln brennen in einem gruenen Licht, was definitiv magisch zu "
            "sein scheint.");

  AddDetail( ({"halterungen","halterung"}),
	    "In den Halterungen an der Wand haengen Fackeln, die den Tempel ein wenig erhellen.");

  AddDetail( ({"moos"}),
	    "Das Moos ist schoen weich und Du wunderst Dich, wie es hier im Tempel "
            "ueberhaupt so gut gedeihen kann, da Moos normalerweise viel Wasser braucht."); 
  
  AddDetail( ({"wasser"}), 
            "Du kannst momentan kein Wasser sehen, aber irgendwie muss das Moos doch bewaessert "
            "werden. Du solltest das Moos vielleicht mal durchsuchen.");

  AddDetail( ({"oeffnung"}),
	    "Die Oeffnung ist klein und kreisrund. und ein paar Tropfen sind noch "
            "in der Oeffnung zu erkennen. Am anderen Ende erkennst Du einen Schlauch, "
            "wo der wohl hinfuehrt.");

  AddDetail( ({"ende","schlauch"}),
	    "Der Schlauch scheint unter dem Moos in eine Ecke zu fuehren.");

  AddDetail( ({"macht","ruhe"}),
	    "Der Tempel strahlt eine gewisse Macht und Ruhe aus.");

  AddDetail( ({"ecke"}), 
            "Du ertastest den Schlauch unter dem Moos und folgst ihm bis in die "
            "Ecke. Da ist ein kleiner Hebel.");

  AddDetail( ({"hebel"}),
	    "Was kann man wohl mit einem Hebel machen?");

  AddDetail( ({"licht","flammen","farbe"}),
	    "Die Flammen lodern in einer gruenlichen Farbe. Sie sind sicher magisch von "
            "den Zentauren erschaffen."); 
  
  AddDetail( ({"zentauren","wesen","oberkoerper","rest","pferdes"}), 
            "Die Zentauren sind stolze Wesen. Ihr Oberkoerper ist menschlich und "
            "der Rest eines Pferdes.");
 
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","es","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig nach Weihrauch, der von den "
                          "Raeucherstaebchen auf dem Altar stammt.");  
 
  AddSmell( ({"weihrauch","geruch"}),
	   "Irgendwie hasst Du diesen Geruch, einfach ekelig.");

  AddSound(DEFAULT_SOUND, "Es ist ehrfuerchtig still im Tempel.");

//-----Details Ende-----

AddExit("westen", ROOM "zeng2");

AddCmd( ({"bete","bete"}), "beten" );
AddCmd( ({"durchsuch", "durchsuche" }), "durchsuchen" );
AddCmd( ({"zieh","ziehe","drueck","druecke" }), "ziehen" );
AddCmd( ({"fuehl","fuehle" }), "fuehlen" );
AddCmd( ({"reiss","reisse" }), "reissen" );

}
void reset()
{
  ::reset();

  anzahl=2;
}

int beten() {
   write("Du haeltst eine kurzes Gebet.\n");
   if (this_player()->QueryProp(P_GHOST))
   {
	write(BS("Eine sehr starke Kraft durchfliesst Dich und gibt Dir wieder Kraft.\n"));
	say(this_player()->name()+" erscheint in koerperlicher Form.\n");
	this_player()->SetProp(P_GHOST,0);
   }
   return 1;
}

int durchsuchen(string str)
{
   notify_fail("Was moechtest Du durchsuchen.?\n");
   if ( member( ({ "moos" }),str) != -1) 
  {
    write(BS( "Du durchsuchst das Moos und findest eine kleine Oeffnung.\n"));
    say( TPN+" durchsucht das Moos.\n");
    return 1;
  }
}
int ziehen(string str)
{
   notify_fail("Was moechtest Du ziehen?\n");
   if ( member( ({ "hebel","an hebel" }),str) != -1) 
  {
    write(BS( "Du ziehst an dem Hebel und ploetzlich spritzt eine grosse Fontaene aus der Oeffnung "
           "und bist ploetzlich klitschnass. Hast Du sehr gut hinbekommen.\n"));
    say( TPN+" zieht an einem Hebel und ist nach kurzer Zeit komplett durchnaesst. Was "
             "fuer ein Idiot.\n");
    return 1;
  }
}
int fuehlen(string str)
{
   notify_fail("Du fuehlst Dich eigentlich ganz gut. Oder was meinst Du?\n");
   if ( member( ({ "aura" }),str) != -1) 
  {
    write(BS ( "Du fuehlst die Aura und Dich durchstroemt eine mystische Macht, die Dir Ruhe und "
           "Frieden gibt. Du fuehlst Dich eindeutig besser.\n"));
    say( TPN+" sieht auf einmal viel besser aus.\n");
    if ( anzahl )
    {
      TP -> heal_self(20+random(10));
      anzahl--;
    }
    return 1;
  }
}
int reissen(string str)
{
   notify_fail("Was moechtest Du abreissen?\n");
   if ( member( ({ "symbol ab" }),str) != -1) 
  {
    TP->AddHp(-50);
    write(BS( "Du probierst das Symbol abzureissen, als Dich ploetzlich ein Blitzstrahl "
           "trifft, der irgendwo aus dem Altar gekommen ist. Du solltest doch auf "
           "Warnungen mehr achten.\n"));
    say( TPN+" verzieht das Gesicht vor Schmerz.\n");
    return 1;
  }
}

