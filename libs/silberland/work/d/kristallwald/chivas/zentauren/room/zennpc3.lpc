// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Geschaeft in Roch Adan");
  SetProp( P_INT_LONG,
	"Hier ist alles sehr duester, die verstaubten Vorhaenge lassen kein "
        "Licht herein. Auf der grossen Ladentheke auf der gegenueber liegenden "
        "Seite liegt eine dicke Staubschicht. Die Regale hinter der Theke sind "
        "leer und einige Spinnweben haengen an ihnen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"vorhaenge"}), 
            "Die Vorhaenge sind alt und staubig. Sie lassen kein Licht in den "
            "Laden fallen.");

  AddDetail( ({"licht"}),
	    "Das einzige Licht hier drinnen stammt von dem Licht, was durch "
            "die Tuer dringt.");

  AddDetail( ({"ladentheke","theke","seite"}),
	    "Die Theke ist mit einer dicken Staubschicht bedeckt. Hier hat "
            "sicher seit Jahren keiner mehr geputzt.");

  AddDetail( ({"staubschicht","schicht","staub"}),
	    "Die Staubschicht ist richtig dicht. Auch am Boden ist sie sehr "
            "dick.");
  
  AddDetail( ({"regale","regalen"}),
	    "Die Regale sind fast leer. Nur ein paar alte Dosen stehen auf "
            "ihnen herum.");

  AddDetail( ({"spinnweben","weben"}), 
            "Selbst die alten Spinnweben sind so verlassen wie der Laden.");

  AddDetail( ({"boden","bodens","holzboden"}),
	    "Der Boden ist mit Staub und Dreck bedeckt.");

  AddDetail( ({"himmel"}),
	    "Hier gibt es nur eine Decke.");

  AddDetail( ({"decke"}),
	    "An der Decke haengen ein paar Eisenringe.");
  
  AddDetail( ({"eisenringe","ringe","eisenring","ring","eisenringen"}),
	    "An den Eisenringen konnte man anscheinend irgend etwas aufhaengen.");

  AddDetail( ({"tuer"}), 
            "Durch die Tuer hast Du den alten Laden betreten.");

  AddDetail( ({"laden","jahren"}),
	    "Der alte Laden wurde sicher schon vor Jahren aufgegeben. Was wohl "
            "aus dem Besitzer geworden ist.");

  AddDetail( ({"besitzer"}),
	    "Vielleicht findest Du ihn ja irgendwo.");

  AddDetail( ({"dosen"}),
	    "Die Dosen scheinen alte Farbdosen zu sein.");
  
  AddDetail( ({"dreck"}),
	    "Der Dreck bedeckt den ganzen Boden. Nur ein paar Ritzen aus dem "
             "Holz des Bodens sind zu erkennen.");

  AddDetail( ({"farbdosen"}), 
            "Die Farbdosen sind leer.");

  AddDetail( ({"holz"}),
	    "Aus Holz besteht der gesamte Baum, in dem Du Dich befindest.");

  AddDetail( ({"baum"}),
	    "Du bist in einem.");

  AddDetail( ({"ritzen","ritze"}),
	    "Die Ritzen sind am ganzen Boden zu sehen. Auch ein paar Spalten "
            "sind zu erkennen.");
  
  AddDetail( ({"spalten"}),
	    "Die Spalten bilden ein grosses Quadrat.");

  AddDetail( ({"quadrat"}), 
            "Das Quadrat scheint eine Falltuer zu sein, die nach unten in den "
            "Keller fuehrt.");

  AddDetail( ({"falltuer"}),
	    "Die Falltuer ist nachdem Du sie entdeckt hast gut zu sehen. Ein "
            "kleines Loch ist am unteren Ende der Falltuer zu sehen.");

  AddDetail( ({"keller"}),
	    "Der Keller ist sicher unter dem Holzboden.");

  AddDetail( ({"ende","loch"}),
	    "Es scheint ein Schluesselloch zu sein.");
  
  AddDetail( ({"schluesselloch"}),
	    "Es ist ein Schluesselloch und die Falltuer ist verschlossen. Wo "
            "ist wohl der Schluessel?");

  AddDetail( ({"schluessel"}), 
            "Chivas hat den Schluessel noch. Aetsch!!!");

  AddDetail( ({"chivas"}),
	    "Einer der vielen nervigen Magier.");

  AddDetail( ({"magier"}),
	    "Davon gibt es einige hier.");

  AddDetail( ({"waende","wand","waenden"}),
	    "An den Waenden sind viele Verzierungen zu sehen.");
  
  AddDetail( ({"verzierung","verzierungen"}),
	    "Einige der Verzierungen scheinen schwach zu leuchten. Es sind wohl "
            "magische Runen.");

  AddDetail( ({"runen","rune"}),
	    "Die magischen Runen stehen fuer Kraft und Macht. Es scheint damals "
            "ein Zauberladen gewesen zu sein. Du bist traurig, dass Du zu "
            "spaet kommst.");

  AddDetail( ({"kraft","macht","staerken"}),
	    "Kraft und Macht sind zwei wichtige Staerken, die man haben "
            "sollte.");

  AddDetail( ({"zauberladen"}),
	    "Vielleicht sind ja noch Sachen im Keller.");

  AddDetail( ({"sachen"}),
	    "Hier sind keine Sachen mehr zu sehen. Nur ein paar alte Dosen auf "
            "den Regalen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht staubig.");  
 
  AddSmell( ({"staub"}),
	   "Du musst wohl gleich niesen.");

  AddSound(DEFAULT_SOUND, "Es ist totenstill hier im Laden.");

//-----Details Ende-----
  
AddExit("sueden", ROOM "zeng4");

}  
   
