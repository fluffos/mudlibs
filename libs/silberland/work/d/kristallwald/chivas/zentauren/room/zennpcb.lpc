// von Chivas
// 01.6.2004
// 
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>


void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einer Baumhoehle");
  SetProp( P_INT_LONG,
	"Dies scheint das Zuhause des Bibliothekars von Roch Adan zu sein. Ueberall "
	"liegen Buecher und Schriften rum und man kann den Boden kaum erkennen. "
	"An den Waenden stehen ein paar Regale, auch diese sind mit Buechern bis "
	"unter die Decke vollgepackt. Das einzige, was auf eine Wohnung hinweisst "
	"ist der grosse Haufen Stroh, auf dem der Zentaur anscheinend schlaeft.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( ({"zuhause"}),
	    QueryProp(P_INT_LONG));

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Dies ist die Stadt der Zentauren. Dir gefaellt es hier sehr gut.");

  AddDetail( ({"bibliothekar","bibliothekars"}), 
            "Hier wohnt der Bibliothekar, wenn er nicht hier ist, ist er sicher in der "
            "Bibliothek.");

  AddDetail( ({"buecher","buechern","ausleiher","nase"}),
	    "Im Haus vom Bibliothekar sind viele Regale mit hunderten von Buechern. Es "
            "sieht so aus, als ob er selbst viel liest und die Buecher nicht gerne "
            "wieder zurueck bringt. Er sollte sich selber mal an die Nase fassen und "
            "nicht die anderen Ausleiher ruegen.");

  AddDetail( ({"schriften","schriftrollen"}),
	    "Auf dem Boden liegen auch viele Schriften und Schriftrollen rum. Sie sehen "
            "teilweise sehr alt aus."); 

  AddDetail( ({"boden"}),
	    "Der Boden ist groesstenteils mit Schriften und Schriftrollen bedeckt. Den "
            "richtigen Boden kann man kaum sehen. Nur ab und zu sieht man einen Teil "
            "einer Steinplatte."); 

  AddDetail( ({"steinplatte","teil","steinplatten"}),
	    "Unter den ganzen Sachen am Boden kann man nur einen Teil der Steinplatten, die "
            "auf dem Boden ausgelegt sind. Aber sie sind auch nicht sehr interessant."); 

  AddDetail( ({"sachen"}),
	    "Halt lauter Buecher, Schriften und ganze Schriftrollen."); 

  AddDetail( ({"regale"}),
	    "Viele Regale stehen in der Baumhoehle. Alle Regale sind bis oben hin mit "
            "Buechern voll gestellt."); 
  
  AddDetail( ({"zentauren","wesen","oberkoerper","rest","pferdes","zentaur"}), 
            "Die Zentauren sind stolze Wesen. Ihr Oberkoerper ist menschlich und "
            "der Rest eines Pferdes.");

  AddDetail( ({"decke"}),
	    "Die Decke ist weit ueber Dir und Du erkennst ein grosses Fenster, "
            "durch das Licht in die Baumhoehle faellt und sie erhellt.");

  AddDetail( ({"baumhoehle","hoehle","haus","baum","wohnung"}),
	    "In dieser Baumhoehle wohnt anscheinend der Bibliothekar."); 

  AddDetail( ({"waende","wand"}),
	    "An den Waenden stehen viele Regale mit Buechern, es ist ein Wunder, dass "
            "sich immer noch welche in der Bibliothek befinden. An der Nordwand faellt "
            "Dir noch etwas auf.");

  AddDetail( ({"wunder"}),
	    "Wunder gibt es immer wieder, heute oder morgen koennen sie geschehen...."); 

  AddDetail( ({"nordwand"}), 
            "An der Nordwand haengt ein grosser Wandteppich.");

  AddDetail( ({"wandteppich","teppich"}), 
            "Der Wandteppich hat ein nettes Muster, aber was viel interessanter ist, ist ein "
            "Luftzug der den Wandteppich ein wenig bewegt.");

  AddDetail( ({"muster","linien","quadrate","kreise"}), 
            "Das Muster stellt Linien, Quadrate und Kreise dar, nichts besonderes.");

  AddDetail( ({"luftzug","zug","seite"}), 
            "Der Luftzug kommt von hinter dem Wandteppich. Vielleicht solltest Du mal den Teppich "
            "zu Seite ziehen.");

  AddDetail( ({"haufen","stroh"}), 
            "Auf dem Haufen Stroh scheint der Bibliothekar zu schlafen.");

  AddDetail( ({"bibliothek"}),
	    "Die Bibliothek von Roch Adan ist gleich nebenan."); 

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau und die Sonne scheint.");

  AddDetail( ({"sonne","licht"}),
	    "Von der Sonne merkst Du hier in der Baumhoehle nicht viel. Es ist angenehm hier "
            "in dem Baum. Draussen wuerdest Du sicher schwitzen.");

  AddDetail( ({"fenster"}),
	    "Durch das Fenster, das schraeg an der Decke angebracht ist, kann man den "
            "Himmel sehen."); 
  
  AddDetail( ({"silberland"}),
	    "Du bist im Silberland und fuehlst Dich wohl hier.");

  AddDetail( ({"riss","geheimtuer"}),
	    "So etwas siehst Du nicht. Du musst es schon finden.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");


  AddSmell(DEFAULT_SMELL, "Es riecht nach Stroh und Buechern.");  
 
  AddSmell( ({"stroh"}),
	   "Das Stroh scheint frisch zu sein.");

  AddSmell( ({"buecher"}),
	   "Wie ganz normale Buecher. Nicht so interessant fuer die Nase.");

  AddSound(DEFAULT_SOUND, "Es ist eigentlich sehr still hier. Du hoerst nur einen leisen Luftzug.");

  AddSound( ({"luftzug"}),
	   "WO der wohl her kommt ?");

  AddReadDetail( ({"chivasliste"}),
		"Hi Justa, hier ist ein Sprungpunkt fuer Dich fuer die "
                "verschiedenen Gebiete, die im Test sind. Ich bringe die Liste "
                "immer auf den aktuellen Stand, so dass Du mit Nuts immer in "
                "die Gebiete springen kannst. \n"
                "                                        \n"
                "1. Dschungeltempel\n"
                "2. Hochebene\n"
                "3. Zwergenfeste (noch nicht nutzen\n"
                "4. Orkhoehle \n"
                "               \n"
                "Tip chivas und dann das Gebiet ein und Du landest in dem "
                "Gebiet. Bitte mach es nur mit Nuts und verrate es keinem.");

//-----Details Ende-----

AddExit("osten", ROOM "zeng2");

AddCmd( ({"zieh", "ziehe" }), "ziehen" );
AddCmd( ({"drueck", "druecke" }), "druecken" );
AddCmd( ({"chivas" }), "chivas" );

}
int ziehen(string str)
{
   notify_fail("Was moechtest Du zu Seite ziehen?\n");
   if ( member( ({ "wandteppich zu seite","teppich zu seite","wandteppich zur seite","teppich zur seite" }),str) != -1) 
  {
    write(BS ( "Du ziehst den Wandteppich zu Seite und findest eine Holzwand, die "
           "jedoch anders aussieht als die Innenwaende einer Baumhoehle. Durch "
           "einen kleinen Riss am unteren Ende zieht die Luft herein. Es scheint "
           "eine Geheimtuer zu sein. Drueck doch einfach mal gegen die Holzwand "
           "und sieh wohin es Dich bringt.\n"));
    say( TPN+" schaut sich den Wandteppich genauer an.\n");
    return 1;
  }
}
int druecken(string str)
{
   notify_fail("Gegen was moechtest Du druecken?\n");
   if ( member( ({ "gegen holzwand" }),str) != -1) 
  {
    write(BS ( "Du drueckst gegen die Holzwand, die auch sofort nachgibt. Ploetzlich "
               "stehst Du in der Bibliothek und ein paar Besucher schauen Dich verwirrt "
               "an und wundern sich wo Du hergekommen bist."));
    say( TPN+" verschwindet ploetzlich, aber nicht durch die Tuer.\n");
    TP->move( ROOM "zenbib", M_GO, "norden");
    return 1;
  }

}
int chivas(string str)
{

 notify_fail("Wo moechtest Du hin? \n");

 if(!str || str == "") return 0;
 if(!(str == "dschungeltempel" ||
      str == "hochebene" ||
      str == "orkhoehle" ||
      str == "zwergenfeste")) return 0;

 if( str == "dschungeltempel"){
      TP->move( "/d/dschungel/chivas/tempel/room/tem1", M_GO,
      "in einem Loch und das Gitter faellt zu", "verschwindet",
      "kommt durch das Gitter herein" );

  return 1;
 }

 if( str == "hochebene"){
      TP->move( "/d/kristallwald/chivas/hochebene/room/hoch1", M_GO,
      "in einem Loch und das Gitter faellt zu", "verschwindet",
      "kommt durch das Gitter herein" );

  return 1;
 }

 if( str == "orkhoehle"){
      TP->move( "/d/kristallwald/chivas/orkhoehle/room/orks30", M_GO,
      "in einem Loch und das Gitter faellt zu", "verschwindet",
      "kommt durch das Gitter herein" );

  return 1;
 }

 if( str == "zwergenfeste"){
      TP->move( "/d/kristallwald/chivas/zwergenfeste/room/zwfe27", M_GO,
      "in einem Loch und das Gitter faellt zu", "verschwindet",
      "kommt durch das Gitter herein" );

  return 1;
}}

