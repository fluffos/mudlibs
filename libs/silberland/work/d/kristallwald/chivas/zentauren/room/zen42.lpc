// von Chivas
// 10.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Vor dem Palast der Zentauren");
  SetProp( P_INT_LONG,
	"Du stehst vor dem groessten Baum in Roch Adan und Du haeltst den Atem an, da "
	"dieser Anblick Dich einfach ueberwaeltigt. Dies scheint der Palast der Zentauren "
	"zu sein. Im Norden kannst Du den Baumriesenpalast durch ein kunstvoll "
	"geschnitztes Tor betreten.  \n"
	"Ansonsten hoerst Du noch die Marktgeraeusche aus dem Sueden. Es scheint Marktzeit "
        "zu sein. ");

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden","strasse"}), 
            "Die Strasse vor dem Palast ist mit Gras bewachsen. Es ist angenehm darauf zu gehen.");

  AddDetail( ({"baum"}),
	    "Dies ist der groesste Baum, den Du jemals gesehen hast. Es ist der Palast der Zentauren. "
            "Genau vor Dir ist ein riesiges Tor, durch das Du den Palast betreten kannst.");

  AddDetail( ({"roch","adan","stadt","roch adan","baumhoehlen","hoehlen"}),
	    "Roch Adan ist die Stadt der Zentauren. Hier leben und arbeiten die Zentauren in ihren "
            "Baumhoehlen, die sie in die Baumriesen geschlagen haben.");
  
  AddDetail( ({"atem","anblick"}),
	    "Bei dem Anblick dieses Baumriesen stockt Dir der Atem. Sowas hast Du noch nie gesehen.");

  AddDetail( ({"palast","baumriesenpalast","baumriese","baumriesen","riesen","riese"}),
	    "Dies ist der Palast der Zentauren. Es ist der groesste Baum in Roch Adan. Er ist einfach "
            "ueberwaeltigend. Neben ihm sehen die anderen Baumriesen sogar klein aus. Der Palast scheint "
            "mehrere Stockwerke zu haben, da Du Fenster weiter oben sehen kannst. Vor Dir ist das Tor "
            "vom Palast.");

  AddDetail( ({"tor","tore"}),
	    "Das Tor ist riesengross, passend zum Baum. Die beiden Torfluegel sind geoeffnet und bestehen aus "
            "Mithril und Gold. Der Rahmen hat kunstvolle Schnitzereien und besteht aus einem Dir unbekannten "
            "Holz.");

  AddDetail( ({"mithril"}),
	    "Die Torfluegel bestehen aus Mithril und Gold. Das Mithril ist herrlich verarbeitet und "
            "unschaetzbar viel wert.");

  AddDetail( ({"gold"}),
	    "Das Gold ist wie das Mithril hervorragend verarbeitet und glaenzt in der Sonne.");

  AddDetail( ({"zentaur","zentauren","bewegungen","geschoepfe","kopf","huefte","menschen","zukunft","pferdekoerper","planeten","pferdebeine"}),
	    "Zentauren sind magische Geschoepfe, vom Kopf bis zur Huefte Menschen, "
            "darunter jedoch mit Pferdekoerper und -beinen versehen. Es wird erzaehlt, "
            "dass sie die Zukunft in den Bewegungen der Planeten am Himmel lesen koennen. ");

  AddDetail( ({"rahmen","holz"}),
	    "Der Rahmen des Tores besteht aus einem Dir unbekannten Holz. Du siehst grazile Schnitzereien "
            "auf ihm.");

  AddDetail( ({"schnitzereien","arbeit"}),
	    "Die Schnitzereien auf dem Rahmen stellen Zentauren bei ihrere taeglichen Arbeit dar.");

  AddDetail( ({"gras"}),
	    "Das Gras auf der Strasse ist schon ein wenig niedergetrampelt. Auch ein Paar Steine "
            "liegen im Gras.");

  AddDetail( ({"stockwerke"}),
	    "Der Palast scheint mehrere Stockwerke zu besitzen, da Du oben am Baum Fenster sehen kannst.");

  AddDetail( ({"fenster"}),
	    "Die Fenster in den oberen Stockwerken sind sehr gross und farbig wie in einer Kirche.");

  AddDetail( ({"kirche","tempel"}),
	   "Hier in Roch Adan gibt es keine Kirche. Vielleicht findest Du ja einen Tempel.");

  AddDetail( ({"steine","paar"}),
	   "Ganz normale kleine Steine.");

  AddDetail( ({"himmel"}),
	   "Der Himmel ist blau und die Sonne scheint. Einige Wolken sind auch zu sehen.");

  AddDetail( ({"wolken"}),
	   "Als Du die Wolken anschaust, sieht es so aus, als ob Dich ein Gesicht anlaechelt und "
           "Dir zunickt.");

  AddDetail( ({"gesicht"}),
	    "Du fragst Dich ob dies eben ein Gott oder eine Sinnestaeuschung war, da jetzt nichts "
            "mehr zu erkennen ist..");

  AddDetail( ({"dusty","mudgoettin","goettin","schutzherrin","herrin","paladine"}),
	    "Unsere Mudgoettin und Schutzherrin der Paladine.");

  AddDetail( ({"woody","mudgott"}),
	    "Unser Mudgott, einfach Woody.");

  AddDetail( ({"gott","sinnestaeuschung","taeuschung"}),
	    "Du bist Dir eigentlich ganz sicher, dass es keine Taeuschung war, sondern ein Gott. Du bist "
            "Dir nur nicht sicher ob es das Gesicht von Woody oder Dusty war.");

  AddDetail( ({"sonne"}),
	    "Die Sonne glitzert im Gold der Tore und steht fast senkrecht am Himmel.");

  AddDetail( ({"fluegeln","fluegel","torfluegel"}),
	    "Das Tor besteht aus zwei Fluegeln, die momentan geoeffnet sind.");

  AddDetail( ({"markt","marktzeit","sueden"}),
	    "Im Sueden ist der Markt von Roch Adan. Heute ist anscheinend Markt.");

  AddDetail( ({"nase","hunger"}),
	    "Du untersuchst auch alles.");

  AddDetail( ({"marktgeraeusche","geraeusche"}),
	    "Vielleicht waere lauschen angebrachter.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du kannst die Duefte vom nahen Markt riechen.");  
 
  AddSmell( ({"markt","duefte","duft"}),
	   "Man kann Gewuerze, Obst und Gemuese riechen.");

  AddSmell( ({"gewuerze","obst","gemuese","gewuerzen","geruch"}),
	   "Dir steigt der Geruch von unbekannten Gewuerzen, exotischen Obst und Gemuese in die Nase. "
           "Ausserdem riecht es auch nach gebratenem Fleisch.");
  
  AddSmell( ({"bratwuerstchen","wuerstchen","fleisch"}),
	   "Das Fleisch riecht nach leckeren Bratwuerstchen. Du kriegst richtig Hunger.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Marktgeraeusche aus dem Sueden und das Traben der Palastwachen.");

  AddSound( ({"traben","palastwachen","wachen"}),
	   "Die Palastwachen patrouilleren vor dem Tor.");
  
  AddSound( ({"markt","marktgeraeusche","geraeusche","feilschen","haendler"}),
	   "Du hoerst das Feilschen der Haendler und ansonsten die ueblichen Marktgeraeusche.");

//-----Details Ende-----

AddExit("sueden", ROOM "zen36");  
AddExit("suedosten", ROOM "zen37");  
AddExit("suedwesten", ROOM "zen35");  
AddExit("norden", ROOM "zen39");

}  
   
