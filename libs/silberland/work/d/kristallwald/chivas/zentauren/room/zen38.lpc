// von Chivas
// 09.3.2004
// 
// Raum meines Gesellenstueckes "Stadtweg - zentaurenstadt"

inherit "std/room";
inherit "/std/player/moneyhandler";

#include <properties.h>
#include "../def.h"
#include <moving.h>


void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Palast der Zentauren");
  SetProp( P_INT_LONG,
	"Dies ist der westliche Teil des Palastes. Dieser Teil wird durch Fackeln mit "
	"blauem Feuer erhellt, die an den verzierten Waenden haengen. Die Decke ist hier "
	"nicht so hoch und Du erkennst Bilder, die andere Rassen im Silberland "
	"darstellen. Die Schalter hier im Raum sehen aus wie in einem Rathaus. "
	"Im Nordosten geht es in den Thronsaal und nach Osten zurueck in den riesige "
	"Eingangshalle. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( ({"boden"}), 
            "Der Boden ist mit Reisig bedeckt. Darunter sind Steinplatten zu sehen, "
	    "die aber uninteressant sind.");

  AddDetail( ({"reisig"}),
	    "Der Reisig liegt im ganzen Palast auf dem Boden und bedeckt die "
            "Steinplatten.");

  AddDetail( ({"steinplatten","platten","stein"}),
	    "Ganz normale Steinplatten, die mit kleinen Fugen von einander getrennt sind.");
  
  AddDetail( ({"palast","palastes"}),
	    "Dies ist der Palast der Zentauren, Du stehst im westlichen Teil. ");

  AddDetail( ({"westlichen teil","teil","raum"}),
            "Dies ist der westliche Teil des Palastes, dieser Teil wird durch Fackeln mit "
            "blauen Feuer erhellt, die an den verzierten Waenden haengen. Die Decke ist hier "  
            "nicht so hoch und Du erkennst Bilder, die anderen Rassen im Silberland "
            "darstellen. Die Schalter hier im Raum sehen aus wie in einem Rathaus. "
            "Im Nordosten geht es in den Thronsaal und nach Osten zurueck in den riesige "
            "Eingangshalle. " );

  AddDetail( ({"thronsaal","nordosten"}),
	   "Der Thronsaal befindet sich im Nordosten, geh doch einfach mal hin.");

  AddDetail( ({"zentaur","zentauren","geschoepfe","kopf","huefte","menschen","pferdekoerper","zukunft","bewegungen","planeten"}),
	    "Zentauren sind magische Geschoepfe, vom Kopf bis zur Huefte Menschen, "
            "darunter jedoch mit Pferdekoerper und -beinen versehen. Man erzaehlt "
            "sich ueber sie, dass sie die Zukunft in den Bewegungen der Planeten "
            "am Himmel lesen koennen. ");

  AddDetail( ({"fackeln","fackel","feuer"}),
	    "Die Fackeln erhellen den Raum. Das Feuer leuchtet in einem beeindruckenden "
            "Blau und sieht irgendwie nach Magie aus. ");

  AddDetail( ({"blauen","blau","grund"}),
	    "Zentauren kennen sich sehr gut mit der Magie aus. Das ist wohl auch der "
            "Grund, wieso sie blaues Feuer erschaffen koennen. ");

  AddDetail( ({"magie"}),
	    "Magie ist etwas, das Deinen Intellekt uebersteigt. ");

  AddDetail( ({"waenden","waende","wand"}),
	    "An den Waenden haengen viele Fackeln, die mit einem blauen Feuer diesen "
	    "Teil des Palastes erhellen. Ausserdem erkennst Du Verzierungen an der Wand. ");

  AddDetail( ({"verzierten","verzierungen"}),
	    "Die Verzierungen stellen Runen da, die Du noch nie gesehen hast. ");

  AddDetail( ({"runen","rune"}),
	    "Die Runen kennst Du nicht, Du findest sie aber trotzdem faszinierend.");

  AddDetail( ({"decke"}),
	   "Die Decke ist hier nicht so hoch, Du erkennst Bilder an der Decke.");

  AddDetail( ({"bilder","bild","bildern"}),
	   "Die Bilder stellen die verschiedenen Rassen im Silberland dar.");

  AddDetail( ({"himmel"}),
	   "Den Himmel kannst Du hier nicht sehen. Da must Du schon nach draussen gehen.");

  AddDetail( ({"fugen"}),
	   "Die Fugen zwischen den Steinplatten sind recht klein und sauber mit Moertel verputzt.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddDetail( ({"moertel"}),
	   "Der Moertel steckt in den Fugen. Er ist sehr hart und hat keinerlei Luecken.");

  AddDetail( ({"luecken","luecke","handwerk"}),
	   "Du kannst nicht die kleinste Luecke im Moertel erkennen, da verstand jemand sein Handwerk.");

  AddDetail( ({"schalter","antraege"}),
	   "Die Schalter bestehen aus Ebenholz und es sieht aus wie in einem Rathaus wo man Antraege "
           "usw. ausfuellt und stundenlang warten muss. Ueber den Schaltern haengen kleine Plaketten.");

  AddDetail( ({"plaketten","plakette"}),
	   "Die Schalter sind durchnummeriert, von Schalter 1 bis Schalter 5. Die einzelnen Schalter "
           "sehen interessant aus.");

  AddDetail( ({"schalter 1"}),
	   "An Schalter 1 kann man das weisse Formular bekommen.");

  AddDetail( ({"schalter 2"}),
	   "An Schalter 2 kann man, wenn man das weisse Formular besitzt, das gelbe Formular "
           "bekommen. ");

  AddDetail( ({"schalter 3"}),
	   "An Schalter 3 kriegt man ein gruenes Formular. Vorraussetzung ist jedoch der Besitz "
           "eines gelben Formulares.");

  AddDetail( ({"schalter 4"}),
	   "Durch den Besitz eines gruenen Formulares bekommt man an Schalter 4 ein rosa Formular.");

  AddDetail( ({"schalter 5"}),
	   "An diesem Schalter bekommt man durch das Ueberreichen eines rosa Formulars etwas. Was es "
           "genau ist bleibt Dir jedoch verschlossen, wenn Du die Prozedur nicht durchlaeufst. Geh "
           "einfach zum ersten Schalter und beantrage ein weisses Formular.");

  AddDetail( ({"ebenholz"}),
	   "Das Ebenholz sieht sehr edel und teuer aus.");

  AddDetail( ({"rassen"}),
	   "Halt die Rassen im Silberland: Elfen, Hobbits, Dunkelelfen, Zwerge, Menschen, Trolle, "
           "Oger und Feen.");

  AddDetail( ({"elfen","ornamente","ornamenten"}),
	   "Elfen machen auf den Ornamenten irgendwas mit Baeumen. Was genau, willst Du gar nicht "
           "wissen.");

  AddDetail( ({"baeume","baeumen","baum"}),
	   "Du erroetest, als Du den Elfen und den Baum naeher betrachtest.");

  AddDetail( ({"hobbits","hobbit"}),
	   "Die Hobbits sind nur am Essen auf den Bildern. Vielfrasse.");

  AddDetail( ({"vielfrasse","vielfrass"}),
	   "Du bist auch einer.");

  AddDetail( ({"dunkelelfen"}),
	   "Die Dunkelelfen stechen sich gegenseitig einen Dolch in den Ruecken bei der Umarmung. "
           "Wirklich nette Leute, die man gerne zum Essen einlaedt.");

  AddDetail( ({"eingangshalle","eingang","halle"}),
	   "Die Eingangshalle befindet sich oestlich von hier.");

  AddDetail( ({"essen"}),
	   "Davon nimmst Du zuviel zu Dir.");

  AddDetail( ({"zwerge"}),
	   "Die Zwerge arbeiten die ganze Zeit in ihren Bergwerken und schwitzen. Was fuer ein "
           "Glueck, dass man Bilder nicht riechen kann.");

  AddDetail( ({"bergwerken","bergwerke"}),
	   "Dahin wirst Du gleich verbannt, wenn Du sowas weiter untersuchst.");

  AddDetail( ({"menschen"}),
	   "Menschen koennen eigentlich gar nichts. Aus diesem Grund stehen sie einfach rum.");

  AddDetail( ({"glueck","zeit"}),
	   "Davon hast Du leider viel zu wenig.");

  AddDetail( ({"umarmung"}),
	   "Eine Umarmung ist schoen, aber von einem hinterhaeltigen Dunkelelfen sollte man abraten.");

  AddDetail( ({"dolch","ruecken"}),
	   "Ein Dolch im Ruecken tut niemanden entzuecken.");

  AddDetail( ({"trolle","wesen"}),
	   "Trolle sind als dumme Wesen dargestellt, aus diesem Grund ziehen sie auch einen Wagen "
           "mit viereckigen Raedern.");

  AddDetail( ({"wagen","raedern","raeder"}),
	   "Tja, als Spieler Stufe 1 haettest Du sowas sicher auch noch gezogen.");

  AddDetail( ({"spieler","stufe","stufe 1"}),
	   "Du bist ein Spieler, aber hoffentlich nicht mehr Stufe 1. Falls Du doch Stufe 1 bist, "
           "raus hier und gehe lieber in den Anfaengerpark nach Midas.");

  AddDetail( ({"anfaengerpark","park","orten","orte"}),
	   "Anfaengerparks gibt es an verschiedenen Orten fuer kleine Spieler, z.B. in Midas.");

  AddDetail( ({"midas","hauptstadt"}),
	   "Midas ist die Hauptstadt vom Silberland.");

  AddDetail( ({"oger"}),
	   "Oger sind noch verfressener als Hobbits, deshalb verspeisst ein "
           "Oger gerade einen Hobbit.");

  AddDetail( ({"feen","ohren"}),
	   "Feen sind klein und laestig. Sie schwirren auf den Bildern, einem stattlichen Zentauren "
           "um die Ohren, der sie mit einer Feenklatsche erschlaegt.");

  AddDetail( ({"feenklatsche","klatsche","erschlagen"}),
	   "Feenklatschen sind ideal zum Erschlagen kleiner laestiger Feen.");

  AddDetail( ({"intellekt"}),
	   "Du besitzt keinen. Tut mir leid.");

  AddDetail( ({"silberland"}),
	   "Du befindest Dich im Silberland und bist gluecklich hier.");
  
  AddDetail( ({"rathaus","wirklichkeit"}),
	   "Es sieht nur aus wie in einem Rathaus wegen der Schalter. In Wirklichkeit bist Du im "
           "Palast der Zentauren.");

  AddSmell(DEFAULT_SMELL, "In diesem Teil des Palastes riecht es nach Reisig, aber auch nach Arbeit.");  
 
  AddSmell( ({"reisig","duft"}),
	   "Der Duft von Reisig ist nicht sonderlich interessant. Es sieht auch daemlich aus, wie "
           "Du am Boden rumschnueffelst.");

  AddSmell( ({"arbeit"}),
	   "Hier riecht es nach Arbeit. Vielleicht solltest Du Dich davon "
           "schleichen, bevor Du auch was tun musst.");
  
  AddSound(DEFAULT_SOUND, "Man hoert das Rascheln von Formularen, das Stempeln von Antraegen und "
                          "viel Gemurmel.");

  AddSound( ({"rascheln","formulare"}),
	   "Du hoerst das Rascheln von Formularen, wie es klingt, wenn damit gearbeitet wird.");

  AddSound( ({"stempeln","antraege","abstaenden"}),
	   "In regelmaessigen Abstaenden hoerst Du wie Antraege abgestempelt werden.");

  AddSound( ({"gemurmel","leute","reihen"}),
	   "Du hoerst das Gemurmel der armen Leute, die in langen Reihen vor den Schaltern stehen "
           "und warten.");
  
//-----Details Ende-----
AddItem(NPC "palastwache", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "zen39",
          P_MNPC_AREA:({ROOM "zen39"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );

AddExit("osten", ROOM "zen39");  
AddExit("nordosten", ROOM "zen41");

AddCmd( ({"beantrag", "beantrage" }), "cmd_beantragen" );

}

int cmd_beantragen(string str)

{
  object urkunde;

  notify_fail("Was moechtest Du beantragen ?\n");

  if(!str || str == "") return 0;
  if(!(str == "weisses formular","formular"))
  
  return 0;

  
  if( present("urkunde",TP)) 
      {
      write(BS("Die Schalterdame meint: \"Sie haben doch schon eine Urkunde. "
	    "Sie brauchen keines mehr.\""));
    
      say(BS(TPN+" bekommt doch kein Formular."));
      return -1;

      }
  else
      {
       {
   urkunde=clone_object( OBJ "urkunde");

   if (ME_TOO_HEAVY==urkunde->move(TP,M_GET|M_SILENT))
        {
         write(BS("Du kannst die Urkunde nicht mehr tragen. Und das nach all der Warterei.\n"));

         say(BS(TPN+" legt grummelnd eine Urkunde auf den Boden."));
 
         urkunde->remove();
         return 1;
        }
    else
        {
         if(TP->QueryMoney() <1000)
          {
           urkunde->remove();
           write("Du hast nicht genug Geld dabei.\n");
           return -1;

          }
	
         write(BS("Du hast Dich also dazu entschlossen ein Formular zu beantragen. "
	          "Du stellst Dich also in der Reihe an und wartest beim Schalter 1. "));
          TP->AddMoney(-1000);
     "p/daemon/zentralbank"->PayIn(1000,100);

TP->SetProp(P_PARALYZED, ([
  PARALYZE_TIME: 200,
  PARALYZE_MSG:"Du bist in den buerokratischen Faengen gefangen.\n",
  PARALYZE_MSG_OTHER:"Da scheint jemand an der Buerokratie zu verzweifeln.\n"
                              ]) );	
     
        call_out("fall1",10);
     return 1;
  
       }
      }
    }
     return 0;
}
void fall1()
{
   if (!objectp(TP)) return;
   if (ENV(TP)!=TO ) return;
   write (BS("Du stehst und wartest. "));
     call_out("fall2",7);
}
void fall2()
{
   if (!objectp(TP)) return;
   if (ENV(TP)!=TO ) return;
   write (BS("Und wartest. "));
     call_out("fall3",12);
}
void fall3()
{
   if (!objectp(TP)) return;
   if (ENV(TP)!=TO ) return;
   write (BS("Nun bist Du endlich an der Reihe und beantragst ein weisses Formular. Der Beamte "
	  "fuellt es mit Dir gewissenhaft aus, drueckt es Dir in die Hand und schickt Dich zu "
          "Schalter 2. Du bist schon ein wenig genervt."));
     call_out("fall4",12);
}     
void fall4()
{
   if (!objectp(TP)) return;
   if (ENV(TP)!=TO ) return;
   write(BS("Du begibst Dich zum Schalter 2. Auch hier ist eine Schlange und Du musst Dich "
	 "anstellen."));
     call_out("fall5",7);
}
void fall5()
{
   if (!objectp(TP)) return;
   if (ENV(TP)!=TO ) return;
   write (BS("Du wartest schon wieder. "));
     call_out("fall6",7);
}
void fall6()
{
   if (!objectp(TP)) return;
   if (ENV(TP)!=TO ) return;
   write (BS("Als Du an der Reihe bist, nimmt Dir der Beamte das Formular aus der Hand. Er murmelt etwas "
	  "unverstaendliches und fuellt ein gelbes Formular aus. Er gibt es Dir. "
          "Du begibst Dich sofort zu Schalter 3."));
     call_out("fall7",12);
}

void fall7()
{
   if (!objectp(TP)) return;
   if (ENV(TP)!=TO ) return;
   write(BS("Stell Dir vor, Du musst in der Schlange warten. "));

     call_out("fall8",7);
}
void fall8()
{
   if (!objectp(TP)) return;
   if (ENV(TP)!=TO ) return;
   write (BS("Als Du endlich an der Reihe bist, tauscht Du ganz schnell Gelb gegen Gruen und "
	  "begibst Dich komplett frustriert zu Schalter 4. "));
     call_out("fall9",12);
}
void fall9()
{
   if (!objectp(TP)) return;
   if (ENV(TP)!=TO ) return;
   write (BS("An Schalter 4 geht es komischerweise recht schnell. Der Beamte nimmt das Formular "
             "und schmeisst es ohne es anzusehen gleich ueber seine linke Schulter nach hinten. "
             "Haettest Du das gewusst, waerst Du gleich zu diesem Schalter gegangen. Der Beamte "
             "fuellt danach ein rosa Formular aus und drueckt es Dir in die Hand."));
     call_out("fall10",12);
}

void fall10()
{
   if (!objectp(TP)) return;
   if (ENV(TP)!=TO ) return;
   write(BS("Du stehst nun endlich in der letzten Schlange vor Schalter 5. Und es ist unglaublich, "
            "Du darfst warten."));
     call_out("fall11",7);
}
void fall11()
{
   if (!objectp(TP)) return;
   if (ENV(TP)!=TO ) return;
   write (BS("Und wartest."));
     call_out("fall12",7);
}
void fall12()
{
   if (!objectp(TP)) return;
   if (ENV(TP)!=TO ) return;
   write (BS("Du wartest noch immer."));
     call_out("fall13",7);
}
void fall13()
{
   if (!objectp(TP)) return;
   if (ENV(TP)!=TO ) return;
   write(BS("Du bist nun endlich an der Reihe. Der Beamte nimmt das rosa Formular und verlangt von "
            "Dir 1000 Muenzen, die Du ihm unter Gegrummel aushaendigst. Darauf hin ueberreicht "
            "der Beamte Dir eine Urkunde und bedankt sich."));
   say(BS(TPN+" steckt, am Schalter 5 stehend, etwas ein."));
   TP->SetProp(P_PARALYZED, 0);

}

