// von Chivas
// 03.6.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include <moving.h>



void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einem Waldweg");
  SetProp( P_INT_LONG,
	"Die Baeume stehen links und rechts des Weges nicht mehr so dicht. "
        "Du kannst den Himmel hier schon deutlicher erkennen. Einige Buesche "
        "und Straeucher sind auch zu sehen. Der Weg fuehrt weiter nach "
        "Nordwesten und nach Suedosten. ");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden","erde","erdig"}), 
            "Der Boden ist erdig, wie ein normaler Waldweg, ab und zu "
	    "liegen vereinzelt Kieselsteine am Boden und Zweige die von "
            "den Baeumen herunter gefallen sind. ");

  AddDetail( ({"erde","erdig"}), 
            "Ganz normale Erde, wie es sie im Wald gibt, sehr naehrstoffreich, "
            "so dass in ihr alles gut gedeiht. ");

  AddDetail( ({"weg","waldweg"}),
	    "Der Waldweg ist von Baeumen gesaeumt und schlaengelt sich "
	    "durch den Wald. Am Wegrand erkennt man mehrere Buesche und "
            "Straeucher.");

  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand erkennt man mehrere Buesche und Straeucher. ");
  
  AddDetail( ({"nordwesten"}),
	    "Nordwesten fuehrt der Weg in lichteren Wald. ");

  AddDetail( ({"suedosten"}),
	    "Nach Suedosten geht es dahin wo Du her kommst. ");

  AddDetail( ({"sonne"}),
	    "Die Sonne ist anscheinend momentan hinter den Wolken verschwunden. ");

  AddDetail( ({"himmel"}),
	    "Den Himmel kann man hier schon recht gut sehen, Du erkennst den "
            "blauen Himmel und ein paar Wolken. ");

  AddDetail( ({"blau","wolken"}),
	    "Blauer Himmel mit weissen Schaefchenwolken. ");

  AddDetail( ({"schaefchenwolken"}),
	    "Es sieht fast so aus, als ob es echte Schafe waeren: Maaeeehhhh. ");

  AddDetail( ({"kieselsteine"}),
	    "Kleine, mittlere und groessere Kieselsteine, aber sehr "
            "uninteressant. ");

  AddDetail( ({"baeume","baeumen","baum"}),
	    "Am Wegrand befinden sich grosse Eichen und Ulmen, die Kiefern und "
	    "Tannen sind hier nicht so zahlreich vorhanden. ");

  AddDetail( ({"stamm"}),
	    "Du hast Dich wohl geirrt. ");

  AddDetail( ({"kiefer","kiefern"}),
	   "Halt wie Kiefern in einem Wald aussehen, Nadeln, Stamm und Aeste.");

  AddDetail( ({"tanne","tannen"}),
	   "Halt wie Tannen aussehen, schau Dir "  
           "mal in der Adventszeit Deinen Weihnachtsbaum an. ");

  AddDetail( ({"ulme","ulmen"}),
	   "Halt ganz normale Ulmen mit Blaettern, Stamm und Aesten.");

  AddDetail( ({"eiche","eichen"}),
	   "Halt wie Eichen aussehen, obwohl am Stamm einer Eiche faellt Dir "  
           "etwas auf. ");

  AddDetail( ({"blatt","blaetter","blaetterdach","dach","lichtstrahl"}),
	    "Die Blaetter bilden ein dichtes Dach, so dass kaum ein Lichtstrahl "
	    "den Boden trifft.");

  AddDetail( ({"nadeln","nadel","nadelbaeumen"}),
	    "Nadeln wachsen an Tannen oder Kiefer, aber auch an anderen "
            "Nadelbaeumen, daher auch ihr Name. ");

  AddDetail( ({"holz"}),
	    "Baeume bestehen aus Holz, dumme Frage. ");

  AddDetail( ({"licht","verhaeltnisse","lichtverhaeltnisse"}),
	    "Es ist heller als im Suedosten, das Blaetterdach ist nicht mehr so dicht.");

  AddDetail( ({"wald","waldes","ansammlung"}),
	    "Ein Wald ist eine Ansammlung von Baeumen.");

  AddDetail( ({"links"}),
	    "Links ist da wo der Daumen rechts ist. ");

  AddDetail( ({"rechts"}),
	    "Rechts ist da wo der Daumen links ist. ");

  AddDetail( ({"daumen"}),
	    "Normalerweise hat man davon zwei. ");

  AddDetail( ({"zweige","zweig"}),
	    "Sie liegen auf dem Waldweg und sind wohl von den Baeumen herunter "
            "gefallen. ");

  AddDetail( ({"aeste","ast","wind"}),
	    "Die Aeste wiegen sich leicht im Wind. ");

  AddDetail( ({"buesche","bueschen"}),
	    "Ganz normale Buesche, wie sieh es in jedem Wald gibt. ");

  AddDetail( ({"straeucher","straeuchern"}),
	    "Ganz normale Straeucher.");

  AddDetail( ({"weihnachtsbaum","weihnachten"}),
	    "Vielleicht solltest Du zu Weihnachten wieder kommen und Dir einen "
            "Weihnachtsbaum faellen.");

 AddDetail( ({"adventszeit","schafe","name","Maaeeehhhh"}),
	    "Du untersuchst auch alles.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst die Baeume, die Erde am Boden und "
                          "auch klare Luft.");  
 
  AddSmell( ({"baeume","baum","baeumen"}),
	   "Sie duften nach Kiefern und Tannen.");

  AddSmell( ({"luft"}),
	   "Du riechst die klare Luft und fuehlst Dich frei.");

  AddSmell( ({"erde"}),
	   "Die Erde riecht nach Wald und Baeumen.");

  AddSmell( ({"wald"}),
	   "Der Wald riecht nach Baeumen.");
  
  AddSmell( ({"kiefer","kiefern"}),
	   "Halt wie Kiefern riechen in einem Wald riechen.");

  AddSmell( ({"tanne","tannen"}),
	   "Halt wie Tannen riechen, falls Du es nicht weisst, schnupper "  
           "mal in der Adventszeit an Deinem Weihnachtsbaum. ");
  
  AddSmell( ({"weihnachtsbaum"}),
	   "Sei realistisch, warum sollte jetzt hier im Wald ein Weihnachtsbaum "
           "stehn.");

 
  AddSmell( ({"ulme","ulmen"}),
	   "Halt ganz normale Ulmen mit Blaettern, Stamm und Aesten. Sie duften "
           "herrlich.");

  AddSmell( ({"eiche","eichen"}),
	   "Halt wie Eichen in einem Wald riechen. ");

  
  AddSound(DEFAULT_SOUND, "Der Wind weht nur ganz leicht durch "
	   "das Blaetterdach, trotzdem hoerst Du ein leichtes Rascheln.");

  AddSound( ({"wind"}),
	   "Du kannst ihn kaum hoeren, er bringt nur die Blaetter leicht zum "
           "Rascheln.");
  
  AddSound( ({"blaetter","rascheln"}),
	   "Die Blaetter bewegen sich leicht im Wind, so dass sie rascheln!");

//-----Details Ende-----
  
AddExit("suedosten", ROOM "zen1");
AddExit("nordwesten", ROOM "zen3");

AddCmd( ({"faell", "faelle" }), "faellen" );

}  
int faellen(string str)
{
   notify_fail("Was moechtest Du faellen?\n");
   if ( member( ({ "baum", "weihnachtsbaum" }),str) != -1) 
  {
    write(BS ( "Vergiss es, bis Weihnachten ist er doch laengst vertrocknet. "
               "Komm in der Weihnachtszeit wieder, dann klappt es sicher."));
    say( TPN+" probiert etwas, dass aber momentan nicht klappen kann.\n");
    return 1;
  }

}  
   
