// von Elro
// 09.3.2004
// 
// Raum meines Gesellenstueckes "Weg11 - zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>


void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Ohne eine Lichtquelle waerst Du jetzt aufgeschmissen, da es hier "
	"im Wald stockfinster ist. Eine Ausnahme bilden natuerlich die "
        "hochgeschaetzten Dunkelelfen und Nekromanten. Kein einziger "
        "Lichtstrahl dringt durch die dicht stehenden Baeume und durch das "
        "Geflecht aus Aesten, Zweigen und Blaettern. Am Wegrand siehst Du "
        "einige Buesche und Straeucher, die komischerweise in dieser "
        "Finsternis gut gedeihen. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 0 );
//-----Details Anfang-----
  
  AddDetail( ({"boden","erde","waldboden"}), 
            "Der Boden ist kahl. In dieser Finsternis kann ja auch kaum was "
            "wachsen. Vereinzelt liegen Steine auf dem kahlen Waldboden.");

  AddDetail( ({"weg","waldweg"}),
	    "Der Waldweg ist von Baeumen gesaeumt und fuehrt Dich "
	    "weiter nach Norden.");

  AddDetail( ({"ausnahme","dunkelelfen","nekromanten"}),
	    "Gehoerst Du zu dieser Ausnahme?");

  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand sind einige Buesche und Straeucher, die "
            "komischerweise hier wachsen koennen. ");

  AddDetail( ({"baeume","baeumen", "baum","stelle"}),
	    "Die Baeume an dieser Stelle des Waldes verdunkeln den Wald so "
            "sehr, dass man ohne Lichtquelle nichts erkennen wuerde. ");

   AddDetail( ({"blatt","blaetter","blaetterdach","dach","lichtstrahl","geflecht"}),
	    "Die Blaetter bilden ein dichtes Dach, so dass kein Lichtstrahl "
	    "den Boden trifft.");

  AddDetail( ({"unterholz"}),
	    "Das Unterholz ist sehr dicht, ein Durchkommen ist unmoeglich. ");

  AddDetail( ({"holz"}),
	    "Baeume bestehen aus Holz. Dumme Frage! ");

  AddDetail( ({"licht","verhaeltnisse","lichtverhaeltnisse","himmel"}),
	    "Es ist absolut finster. Kein Licht dringt durch das dichte "
	    "Blaetterdach. Der Himmel ist natuerlich nicht zu sehen, ansonsten "
            "waere es auch nicht so dunkel.");

  AddDetail( ({"steine","steinen","stein"}),
	    "Ganz normale Steine, wie man sie auf jedem anstaendigen Waldweg "
	    "findet. Aber da ist noch Etwas.");

  AddDetail( ({"wald","waldes","ansammlung"}),
	    "Ein Wald ist eine Ansammlung von Baeumen.");

  AddDetail( ({"zweige","zweig"}),
	    "Sie liegen auf dem Waldweg und sind wohl von den Baeumen "
            "heruntergefallen. ");

  AddDetail( ({"aeste","ast"}),
	    "Die Aeste wiegen sich leicht im Wind. ");

  AddDetail( ({"wind"}),
	    "Der Wind bewegt ganz leicht die Aeste und Blaetter. ");

  AddDetail( ({"dunkelheit","finsternis","hilfsmittel","lichtquelle"}),
	    "Es ist so dunkel, dass man ohne Hilfsmittel nichts sehen "
            "koennte.");

  AddDetail( ({"buesche","bueschen"}),
	    "Ganz normale Buesche, nur komisch das sie in dieser Dunkelheit "
            "ueberleben koennen. ");

  AddDetail( ({"straeucher","straeuchern"}),
	    "Straeucher in dieser Finsternis. Was es nicht alles gibt?");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddDetail( ({"etwas"}),
	    "Du kniest Dich hin und untersuchst den Boden genauer. Du "
            "entdeckst Schleifspuren.");

  AddDetail( ({"spuren","schleifspuren"}),
	    "Die Schleifspuren fuehren Richtung Straeucher, vielleicht "
            "solltest Du mal durch die Straeucher spaehen.");

  AddDetail( ({"altar"}),
	    "Der Altar scheint aus Granit zu sein und uralt. Du kannst nur "
            "erahnen, was hier fuer greuliche Sachen im Dunkeln geschehen "
            "sind. Auf dem Altar scheinen noch einige Blutspritzer zu kleben. "
            "Verzierungen sind an den Seiten des Altars zu erkennen, dahinter "
            "liegt alles in Schatten.");

  AddDetail( ({"blut","blutspritzer"}),
	    "Das Blut muss von einem armen Wesen sein, das hier geopfert wurde.");

  AddDetail( ({"knochen"}),
	    "Hier liegen vereinzelt Knochen herum. Anscheinend wurden die "
            "Geopferten einfach hier liegen gelassen und von Tieren abgenagt.");

  AddDetail( ({"symbole"}),
	    "Die Symbole verstehst Du nicht. Trotzdem floessen sie Dir "
            "irgendwie Furcht ein.");

  AddDetail( ({"schriftzeichen"}),
	    "Du koenntest versuchen sie zu lesen.");

  AddDetail( ({"granit","material"}),
	    "Der Altar besteht aus Granit, ein wirklich hartes Material.");

  AddDetail( ({"verzierungen"}),
	    "Die Verzierungen sind in Wirklichkeit Symbole und Schriftzeichen.");

  AddDetail( ({"gestalt"}),
	    "Wenn da eine Gestalt in den Schatten ist, so bewegt sie sich "
            "nicht und gibt auch keinen Laut von sich. Du glaubst aber Augen "
            "zu erkennen.");

  AddDetail( ({"schatten"}),
	    "Der Schatten ist wirklich beunruhigend. Ist da nicht eine Gestalt "
            "zu erkennen.");

  AddDetail( ({"augen"}),
	    "Wenn es Augen sind, so wirken sie sehr gefaehrlich, Du solltest "
            "Dich lieber aus dem Staub machen oder traust Du Dich um die "
            "Straeucher zu hirten?");

  AddDetail( ({"sachen"}),
	    "Das willst Du gar nicht wissen, dann bekommst Du nur Alptraeume.");

  AddDetail( ({"alptraeume"}),
	    "Alptraeume sind wirklich nicht sehr nett.");

  AddDetail( ({"dunkeln"}),
	    "Es ist wirklich duester. Haettest Du keine Lichtquelle bei Dir, "
            "dann wuerdest Du gar nichts erkennen. Die Ausnahme sind halt "
            "Dunkelelfen und Nekromanten.");

  AddDetail( ({"seiten","seite"}),
	    "An den Seiten des Altars sind Verzierungen.");
  
  
  AddSmell(DEFAULT_SMELL, "Du riechst die Baeume. ");  
 
  AddSmell( ({"baeume","baum"}),
	   "Sie riechen halt nach Baum.");

  AddSound(DEFAULT_SOUND, "Hier ist es totenstill.");

  AddSound( ({"totenstill"}),
	   "Du moechtest das nicht wirklich mal hoeren.");

  AddReadDetail( ({"schriftzeichen"}),
		"Sie sind in einer Dir unbekannten Sprache. Du liest folgendes "
                "und verstehst es nicht:\n"
                "TOT DLAB UD TSIB ,TSEIL SEID UD NNEW");
  
//-----Details Ende-----

AddExit("suedosten", ROOM "zen9");  
AddExit("norden", ROOM "zen11");


AddCmd( ({"spaeh", "spaehe" }), "spaehen" );
AddCmd( ({"hirt", "hirte" }), "hirten" );

}
int spaehen(string str)
{
   notify_fail("Wo willst Du durch spaehen?\n");
   if ( member( ({ "durch strauch", "durch straeucher" }),str) != -1) 
  {
    write(BS( "Du spaehst durch die Straeucher und Dir stockt der Atem. Du siehst "
           "einen alten Altar, der mit Blut bespritzt ist. Ausserdem liegen "
           "vor dem Altar ein paar alte Knochen.\n"));
    say( TPN+" wird ploetzlich kreidebleich.\n");
    return 1;
  }
}
int hirten(string str)
{
   notify_fail("Um was willst Du herum hirten?\n");
   if ( member( ({ "um straeucher herum" }),str) != -1) 
  {
    write(BS ( "Du hirtest voll des Mutes um die Straeucher herum "
               "und stellst Dich Deiner Angst."));
    say( TPN+" verschwindet ploetzlich.\n");
    this_player()->move(ROOM "zen46", M_GO, "westen");
    return 1;
  }

}  
  
