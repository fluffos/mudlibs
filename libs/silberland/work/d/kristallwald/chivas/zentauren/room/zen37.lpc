// von Chivas
// 11.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl;

void create()
	
{
  ::create();

  anzahl=1;

  SetProp( P_INT_SHORT, "Auf einem Marktplatz");
  SetProp( P_INT_LONG,
	"Dies ist der oestliche Marktplatz, wo es nicht die ueblichen Sachen "
        "zu kaufen gibt. Alle Waren wirken ein wenig skurril. Du hast "
        "schaetzungsweise noch nicht einmal die Haelfte der Waren gesehen "
        "oder sie gegessen, was Du auch nicht tun willst, weil so manche "
        "Koestlichkeit so aussieht als ob sie mit Dir reden koennte. Der "
        "Sueden des Platzes ist durch eine grosse gepflegte Hecke vom "
        "dahinterliegenden Park getrennt.\n" 
        "Im Westen ist mehr los, da werden noch weitere Waren verkauft. Nach "
        "Suedosten fuehrt die Strasse an der Hecke vorbei zu verschiedenen "
        "Baumhoehlen der Zentauren. Im Nordwesten siehst Du einen Baumriesen "
        "der seines gleichen sucht. ");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"boden"}), 
            "Der Boden ist mit Gras bedeckt. Ueberall stehen Staende, wo Waren verkauft werden. "
            "Ausserdem siehst Du einige Kaefige und einen Pflock der in den Boden gerammt wurde.");

  AddDetail( ({"gras"}),
	    "Das Gras ist niedergetrampelt.");

  AddDetail( ({"marktplatz","markt","teil","verhungern","platz","marktes","westen","marktplatzes"}),
	    "Auf diesem Teil des Marktplatzes werden nicht alltaegliche Sachen verkauft wie im Westen. "
            "Hier an den Staenden siehst Du Koestlichkeiten, die Du nicht einmal essen wuerdest, wenn Du "
            "am Verhungern waerst.");

  AddDetail( ({"sachen","waren","obst","gemuese","etwas","puls","haelfte"}), 
            "Die Waren sind wirklich skurril. Das angebotene Obst und Gemuese scheint sogar einen Puls zu "
            "haben. Sowas wuerdest Du nie anruehren. Ausserdem siehst Du noch Kaefige und einen Pflock wo "
            "Etwas angekettet ist.");

  AddDetail( ({"koestlichkeit","koestlichkeiten","finger"}),
	    "Von diesen Sachen laesst Du lieber die Finger. Dir wird schon schlecht wenn Du sie ansiehst.");

  AddDetail( ({"hecke"}),
	    "Die Hecke trennt den Park vom Markt ab."); 
  
  AddDetail( ({"park"}), 
            "Hinter der Hecke ist ein wunderschoener Park. Du kannst leider nicht viel erkennen und "
            "beschliesst den Park spaeter einmal aufzusuchen.");

  AddDetail( ({"baumhoehlen","baumhoehle","tuer"}),
	    "In den Baumhoehlen wohnen und arbeiten die Zentauren. Ueber der Tuer der Baumhoehle im Osten "
            "haengt ein grosses Schild. Es scheint sich um eine Gaststaette zu sein.");

  AddDetail( ({"westen","mitte"}),
	    "Im Westen ist die Mitte des Marktes, dort werden anscheinend normale Sachen verkauft.");

  AddDetail( ({"suedosten","strasse"}), 
            "Die Strasse geht im Suedosten weiter an der Hecke und den Baumhoehlen der Zentauren entlang.");

  AddDetail( ({"nordwesten","baumriesen","baeume","palast","baumriese"}),
	    "Im Nordwesten siehst Du einen Baumriesen, der alle anderen Baeume um vieles ueberragt. Es scheint "
            "der Palast der Zentauren zu sein.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen blau und die Sonne scheint und waermt. Einige Wolken und Voegel sind auch "
            "zu sehen."); 
  
  AddDetail( ({"sonne"}), 
            "Die Sonne steht fast senkrecht am Himmel und waermt Dich angenehm. Ein paar Wolken am Himmel verdecken "
            "sie nicht.");

  AddDetail( ({"wolken","regen"}),
	    "Die Wolken am Himmel sind weiss, es sieht nicht nach Regen aus.");

  AddDetail( ({"voegel"}),
	    "Die Voegel scheinen Schwalben zu sein.");

  AddDetail( ({"schwalben","zeichen"}), 
            "Die Schwalben fliegen sehr hoch. Ein gutes Zeichen dafuer, dass es keinen Regen gibt.");

  AddDetail( ({"schild","gaststaette","osten"}),
	    "Ueber der Baumhoehle im Osten, die eine Gaststaette zu sein scheint, haengt ein Schild. "
            "Du koenntest es lesen.");

  AddDetail( ({"zentauren","geschoepfe","mensch","pferd"}),
	    "Zentauren sind magische Geschoepfe. Sie sind halb Mensch und halb Pferd."); 
  
  AddDetail( ({"staende","staenden"}), 
            "An den Staenden werden die skurrielsten Waren verkauft.");

  AddDetail( ({"kaefige","tieren","tiere","kaeufern","kaeufer"}),
	    "Die Kaefige sind mit lauter Tieren gefuellt. Anscheinend werden sie Kaeufern angeboten, die "
            "vorhaben die armen Tiere nachher zu verzehren. Ein Kaefig faellt Dir besonders auf.");

  AddDetail( ({"kaetzchen","mitleid"}),
	    "Die kleinen Kaetzchen sehen so suess aus und Du hast Mitleid mit ihnen. Das Schloss was den "
            "Kaefig sichert muss weg.");

  AddDetail( ({"kaefig"}), 
            "In einem Kaefig sitzen niedliche kleine Kaetzchen. Du hast Mitleid und willst sie am liebsten "
            "befreien. Ein grosses Schloss sichert den Kaefig.");

  AddDetail( ({"schloss"}),
	    "Ein grosses aber altes Schloss sichert den Kaefig. Du muesstest es eigentlich knacken koennen.");

  AddDetail( ({"pflock","stand","dutzend"}),
	    "An einem grossen Pflock der in den Boden gerammt neben einem Stand steht sind an einer langen "
            "Kette ein Dutzend Fraggle angekettet."); 
  
  AddDetail( ({"kette"}), 
            "Die Kette ist alt und rostig.");

  AddDetail( ({"preise"}), 
            "Die Preise sind hier teilweise sehr hoch.");

  AddDetail( ({"fraggles","fraggle"}),
	    "Die Fraggle jammern, aber Du konntest sie sowieso nie leiden.");

  AddDetail( ({"haendler"}),
	    "Die Haendler preisen ihre Waren lauthals an und feilschen mit den "
	    "Besuchern des Marktes.");

  AddDetail( ({"besucher","kunden","gestalten","steckbrief"}), 
            "Die meisten Besucher sind recht dubiose Gestalten. Du bist Dir "
	    "sicher, dass Du so manchen Kunden' der hier Waren kauft schon "
	    "einmal auf einem Steckbrief gesehen hast.");

  
  AddSmell(DEFAULT_SMELL, "Es riecht nach skurrielen Dingen. Du willst gar "
		          "nicht so genau wissen was es ist.");  
 
  AddSmell( ({"dingen","dinge","gewuerzen","hauch","wort","gewuerze"}),
	   "Es riecht ein wenig nach Gewuerzen mit einem Hauch von.... Dir "
	   "faellt kein Wort dafuer ein.");

  AddSound(DEFAULT_SOUND, "Du hoerst das rege Treiben des Marktes und das "
		          "Feilschen der Haendler.");

  AddSound( ({"treiben","durcheinander"}),
	   "Es ist ein heilloses Durcheinander. Haendler schreien wild herum.");

  AddSound( ({"feilschen"}),
	   "Die Haendler feilschen mit Kunden ueber Preise. Dabei schreien sie sich richtig laut an.");
  
  AddReadDetail( ({"schild"}),
		"Zum wilden Zentauren.");

//-----Details Ende-----
  

AddExit("suedosten", ROOM "zen34");  
AddExit("osten", ROOM "zen44");
AddExit("westen", ROOM "zen36");
AddExit("nordwesten", ROOM "zen42");

AddCmd( ({"knacke", "knack" }), "knacken" );

}
void reset()
	
{
  ::reset();
  anzahl=1; 
}
int knacken(string str)
{
   notify_fail("Was moechtest Du knacken?\n");
   if ( member( ({ "schloss", "schloss auf" }),str) != -1) 
   {    
   if ( anzahl )
    {
    write(BS( "Du knackst das Schloss und oeffnest den Kaefig. Die kleinen "
           "Kaetzchen verkruemmeln sich still "
           "und heimlich durch die Hecke in den Park. Daraufhin gehst Du "
           "unschuldig pfeifend weiter, als ob nichts geschehen ist.\n"));
    say( TPN+" macht irgendwas verbotenes und etwas huscht blitzschnell in die Hecke.\n");
    anzahl--;
    return 1;   
    }
    else
    {
    write(BS( "Du entdeckst, dass das Schloss schon geknackt ist und keine "
           "Kaetzchen mehr da sind.\n"));
    say( TPN+" probiert etwas, das gar nicht mehr notwendig ist.\n");
    return 1;   
    }
  }
}
   
