// von Chivas
// 11.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"

inherit "std/pub";

#include "../def.h"
#include <pub.h>


void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp(P_INT_SHORT,"In der Gaststaette 'Zum wilden Zentauren'");
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "laris");
  SetProp(P_PUBKEEPER_NAME, "laris");
  SetProp(P_PUBMSG_NOKEEPER, "Laris ist leider nicht hier.\n");
  SetProp(P_PUBMSG_NOENEMY, BS(
      "Du bist gerade in einem verbissen Kampf mit Laris. Kein Wunder, "
      "dass sie Dich nicht bedient."));
  SetProp(P_PUBMSG_NOINVITE, BS(
      "Laris kaempft. Da hat sie wahrhaft andere Sorgen als Kunden."));
  SetProp(P_PUBMSG_FIGHTING, "Laris kaempft gerade.\n");

  AddDrink("Bier", ({"bier"}),
           500, 55, 10, 6,
           ({"Laris laechelt und bringt Dir ein grosses Glas Bier.\n",
             "&& trinkt ein grosses Glas Bier.\n"}));

  AddDrink("1 Flasche Sekt(Picollo)", ({"sekt","picollo","flasche"}),
            220, 28, 9, 3,
           ({"Laris bringt Dir einen Picollo.\n"
            +"Er schmeckt hervorragend. \n",
             "&& trinkt eine kleine Flasche Sekt.\n"}));

  AddDrink("Lindenbluetentee", ({"lindenbluetentee","bluetentee","tee"}),
            150, 15, 0, 5,
           ({"Laris bringt Dir eine Tasse Lindenbluetentee.\n"
            +"Der schmeckt fuer Tee nicht schlecht und beruhigt!\n",
             "&& trinkt eine Tasse Lindenbluetentee.\n"}));

  AddFood("Fragglesandwich", ({"fragglesandwich", "sandwich"}), 200, 25, 9,
           ({"Laris bringt Dir eine leckeres Fragglesandwich. "
            +"\nHmmmm, es schmeckt lecker. Ups, lebt der Fraggle noch.\n",
             "&& isst eine Fragglesandwich.\n"}));
  AddFood("Ein kleines Butterbrot", ({"butterbrot","brot"}), 80, 10, 4,
           ({"Laris bringt Dir ein kleines Butterbrot.\n"
            +BS("Das Butterbrot schmeckt eigentlich ganz gut, aber mit der Butter "
                "wurde gespart."),
             "&& isst gierig ein kleines Butterbrot.\n"}));

// ----------  Details  ---------------------

  AddDetail( ({"boden"}),
	    "Der Boden ist mit Reisig bedeckt. Unter dem Reisig kann man Holz erkennen.");

  AddDetail( ({"holz","wunder"}),
	    "Was fuer ein Wunder. In einem Baum findet man Holz. Du bist fasziniert.");

  AddDetail( ({"reisig"}),
	    "Ganz normaler Reisig.");

  AddDetail( ({"baenke","bank"}),
	    "An der Wand stehen Baenke auf denen Gaeste sitzen und sich unterhalten.");
  
  AddDetail( ({"bier","glas"}),
	    "Hier kannst Du auch Bier bestellen, ein richtig grosses Glas Bier.");

  AddDetail( ({"baumriesen","riesen","baum","baumriese"}),
	    "Du befindest Dich in einem. Dieser Baumriese ist eine Gaststaette.");

  AddDetail( ({"gaststaette","zum"}),
	    "Du befindest Dich in der Gaststaette 'Zum wilden Zentauren'.");

  AddDetail( ({"menue"}),
	    "Das Menue haengt an der Wand. Tipp 'menue' und Du siehst was Du bestellen "
            "kannst.");

  AddDetail( ({"tuer","sonne","strasse"}),
	    "Die Tuer auf die Strasse ist offen. Draussen scheint die Sonne zu scheinen.");

  AddDetail( ({"wirtin"}),
	    "Die Wirtin dieser Gaststaette steht vor Dir oder ist gerade nicht da.");

  AddDetail( ({"wand","waende"}),
	    "An den Waenden haengt ein Menue und Fackeln in ihren Halterungen, die "
            "den Raum erhellen. Ausserdem stehen Baenke an der Wand.");

  AddDetail( ({"raum"}),
	    "Der Raum ist eine Gaststaette. Du stehst an der Theke.");

  AddDetail( ({"fackel","fackeln"}),
	    "Die Fackeln haengen in Halterungen an der Wand und erhellen die Gaststaette ein wenig.");

  AddDetail( ({"halterung","halterungen","eisen"}),
	    "Die Halterungen in denen die Fackeln haengen bestehen aus Eisen und sind sehr haesslich.");

  AddDetail( ({"decke","spinnenweben"}),
	    "An der Decke haengen ein paar Spinnenweben, ansonsten sieht man "
            "nichts besonderes.");
  
  AddDetail( ({"theke","fleck","hochglanz"}),
	    "Die Theke ist sehr lang und absolut auf Hochglanz poliert. Du erkennst nicht "
            "einen einzigen Fleck.");

  AddDetail( ({"tische","tisch"}),
	    "An den Tischen sitzen viele Gaeste und unterhalten sich.");

  AddDetail( ({"stuehle","stuhl"}),
	    "Auf den Stuehlen an den Tischen sitzen die Gaeste oder stehen an der Theke.");

  AddDetail( ({"gaeste","elfen","zwergen","zwerge","menschen"}),
	    "Die Gaeste bestehen aus Elfen, Zwergen, Menschen und natuerlich "
            "auch Zentauren.");

  AddDetail( ({"stadt","roch","adan","roch adan"}),
	    "Roch Adan ist die Stadt der Zentauren.");
  
  AddDetail( ({"zentauren","mensch","pferd"}),
	    "Zentauren sind halb Mensch und halb Pferd. Du befindest Dich in ihrer Stadt.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Alkohol und gebratenen Fraggle.");  
 
  AddSmell( ({"alkohol","geruch"}),
	   "Der Geruch von Alkohol macht Dich schon fast besoffen.");

  AddSmell( ({"fraggle"}),
	   "Die gebratenen Fraggle riechen schon sehr lecker.");

  AddSound(DEFAULT_SOUND, "Du hoerst die anderen Gaeste, wie sie miteinander reden. Ausserdem "
                          "hoerst Du wie Geschirr abgewaschen wird.");

  AddSound( ({"gaeste"}),
	   "Die Gaeste zu belauschen waere nicht nett. Schaem Dich.");
  
  AddSound( ({"geschirr","geklapper"}),
		"Du hoerst das Geklapper von Geschirr wie es abgewaschen wird.");


// ----------- Details Ende -------------------
  AddExit("westen", ROOM "zen37");

  AddItem(NPC "laris", REFRESH_DESTRUCT);
}

string _query_int_long()
{
  string txt;

  txt = "Du befindest Dich in der Gaststaette 'Zum wilden Zentauren'. "
        "Es gibt eine grosse Theke an der einige Zentauren ein Bier trinken. "
        "Es stehen auch einige Tische, Baenke und Stuehle herum fuer Gaeste, "
        "die keine Zentauren sind. Gleich neben der Tuer haengt ein "
        "Menue an der Wand, das Du mit 'menue' lesen kannst. ";

  if(QueryProp(P_PUBKEEPER_ID))
  {
    if(!present(QueryProp(P_PUBKEEPER_ID)))
    {
      txt += "Seltsamerweise ist offenbar gerade niemand hier der Dich "
        "bedienen koennte.";
    }
    else
    {
      txt += "Die Wirtin steht hinter der Theke und laechelt Dich "
        "freundlich an.";
    }
  }

  return BS(txt);
}
