// von Chivas
// 01.6.2004

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>


void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einer Gasse in Roch Adan");
  SetProp( P_INT_LONG,
	"Du befindest Dich in einer Gasse in Roch Adan, die von der Strasse um "
	"den Park nach Westen abzweigt. Die Gasse dient anscheinend als "
	"Verbindungsweg zu einem anderen Teil der Stadt. An einem Baumriesen "
	"im Suedwesten haengt ein Schild. Die Gasse fuehrt nach Nordwesten auf "
	"einen kleinen Platz, von dem aus man anscheinend weiter nach Norden "
	"gehen kann. Ein paar Baumhoehlen direkt am Platz sehen recht "
	"interessant aus. ");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( ({"gasse"}),
	    "Die Gasse ist mit Steinen gepflastert und fuehrt Dich zurueck zur "
            "Strasse um den Park oder nach Nordwesten auf einen kleinen Platz.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Dies ist die Stadt der Zentauren. Dir gefaellt es hier sehr gut.");

  AddDetail( ({"baumriesen","riesen","baeume"}), 
            "In den Baumriesen arbeiten und wohnen die Zentauren. Die Baeume "
	    "sind riesig. Sie sind die groessten im ganzen Silberland. An "
	    "einem Baumriesen im Suedwesten haengt ein Schild.");

  AddDetail( ({"strasse","osten","westen","abzweigung","stelle","palast","haupttor","tor"}),
	    "Die Strasse im Osten fuehrt durch die Stadt um den Park herum, vom Palast "
            "zum Haupttor im Sueden. Hier ist eine Abzweigung nach Westen, die Dich zu "
            "dieser Stelle gebracht hat.");

  AddDetail( ({"park"}),
	    "Der Park ist im Osten von hier. Du kannst noch die Hecke erkennen, die den "
            "Park umgibt."); 
  
  AddDetail( ({"zentauren","wesen","oberkoerper","rest","pferdes"}), 
            "Die Zentauren sind stolze Wesen. Ihr Oberkoerper ist menschlich und der "
            "Rest eines Pferdes.");

  AddDetail( ({"hecke"}),
	    "Um die Hecke genauer zu betrachten, solltest Du wohl naeher ran gehen. "
            "Von hier aus, kannst Du nicht viel erkennen.");

  AddDetail( ({"platz","norwesten"}),
	    "Im Nordwesten ist ein kleiner Platz, um mehr zu sehen, solltest "
            "Du naeher ran gehen. Einige Baumhoehlen scheinen dort recht interessant "
            "zu sein.");

  AddDetail( ({"boden"}), 
            "Der Boden in der Gasse ist mit Steinen gepflastert. Ab und zu waechst "
            "ein wenig Gras in den Fugen zwischen den Steinen.");

  AddDetail( ({"steine","pflaster","pflastersteine"}),
	    "Es sind ganz normale Pflastersteine, zwischen ihnen waechst manchmal ein "
            "wenig Gras.");

  AddDetail( ({"fugen"}),
	    "Die Fugen zwischen den Steinen sind nicht besonders gross. Ab und zu "
            "waechst ein wenig Gras in ihnen."); 

  AddDetail( ({"suedwesten","tischler","werkstatt","tischlerei"}), 
            "Im Suedwesten scheint ein Tischler seine Werkstatt in einem "
	    "Baumriesen eingerichtet zu haben. Ueber dem Eingang haengt ein "
	    "Schild.");  

  AddDetail( ({"schild"}), 
            "Du kannst das Schild ueber dem Eingang im Suedwesten lesen.");

  AddDetail( ({"eingang"}), 
            "Im Suedwesten ist der Eingang zur Tischlerei von Roch Adan.");

  AddDetail( ({"gras"}), 
            "In den Fugen zwischen den Steinen wachsen ab und zu ein paar "
	    "Grashalme.");

  AddDetail( ({"halme","grashalme","anzahl","grashalmen","wiese"}),
	    "Eine paar Grashalme nennt man Gras. In einer groesseren Anzahl "
            "nennt man sie eine Wiese. Aber eine Wiese ist das hier nicht.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau und die Wolken ziehen langsam vorbei. Ein paar "
            "Voegel ziehen ihre Kreise.");

  AddDetail( ({"wolken"}), 
            "Die Wolken ziehen langsam am Himmel entlang, verdecken aber nicht "
            "die Sonne.");

  AddDetail( ({"sonne"}),
	    "Die Sonne waermt Dich sehr und Du fuehlst Dich wohl.");

  AddDetail( ({"voegel","kreise"}),
	    "Ein paar Voegel ziehen am Himmel ihre Kreise. Sie sind jedoch zu hoch "
            "um genau zu erkennen um was fuer Voegel es sich handelt."); 
  
  AddDetail( ({"baumhoehle","baumhoehlen","hoehle","hoehlen"}), 
            "Die Baumhoehlen auf dem Platz im Nordwesten sehen sehr interessant aus. Du "
            "solltest hingehen und sie naeher betrachten.");

  AddDetail( ({"verbindungsweg","weg","teil"}),
	    "Die Gasse ist anscheinend ein Verbindungsweg, der in einen anderen Teil "
            "der Stadt fuehrt.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland und fuehlst Dich wohl hier.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");


  AddSmell(DEFAULT_SMELL, "Du riechst die klare Luft und fuehlst Dich gut.");  
 
  AddSmell( ({"luft","fruehling"}),
	   "Die Luft ist sehr warm und riecht nach Fruehling.");

  AddSound(DEFAULT_SOUND, "Du hoerst den ueblichen Stadtlaerm.");

  AddSound( ({"stadtlaerm","laerm","beschaeftigungen","abenteurer"}),
	   "Du hoerst die Zentauren, wie sie ihren Beschaeftigungen nachgehen und wie andere Abenteurer "
           "die Stadt erkunden.");

  AddReadDetail( ({"schild"}),
		"+----------------------------+\n"
		"|                            |\n"
		"|         Tischlerei         |\n"
		"|                            |\n"
		"+----------------------------+");
//-----Details Ende-----

AddExit("osten", ROOM "zen25");  
AddExit("nordwesten", ROOM "zeng2");
AddExit("suedwesten", "/d/kristallwald/chivas/dragonquest/room/zentisch");
}
