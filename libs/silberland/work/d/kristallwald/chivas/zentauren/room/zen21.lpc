// von Chivas
// 26.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int sperlingda;

void create()
	
{
  ::create();

AddRoomMessage( ({ "Ein Gaertner maeht den Rasen mit einem merkwuerdigen Geraet, \n"
                   "welches ein surrendes Geraeusch von sich gibt.\n",
                   "Ein paar Abenteurer machen ein Picknick auf dem Rasen und lachen.\n" }),
                        30, "sound" );


  SetProp( P_INT_SHORT, "Im Park von Roch Adan");
  SetProp( P_INT_LONG,
	"Dies ist die suedwestlichste Ecke des Parks, hier gibt es grosse Rasenflaechen und "
        "das gruene Gras, laedt zum Ausruhen ein. Der Weg, der durch den Park fuehrt, ist mit "
        "kleinen Steinchen angelegt worden und fuehrt an der Hecke entlang, die den gesamten "
        "Park umgibt. Ausserdem siehtst Du Beete, in denen Blumen wachsen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  

  AddDetail( ({"boden"}), 
            "Der Boden der Wege besteht aus kleinen Steinchen und die grossen Rasenflaechen natuerlich aus Gras.");

  AddDetail( ({"ecke"}),
	    "Du bist in der suedwestlichen Ecke des Parks.");

  AddDetail( ({"park","parks","eindruck","ordnung","stadtpark"}),
	    "Dies ist der Stadtpark von Roch Adan. Er macht einen sehr gepflegten Eindruck. Die Zentauren scheinen "
            "darauf zu achten, dass er immer in Ordnung ist. Du siehst grosse Rasenflaechen, Beete und die sauber "
            "angelegten Wege, die sich durch den Park schlaengeln.");

  AddDetail( ({"rasenflaechen","rasen","flaechen","teil","rasenflaeche","flaeche"}), 
            "Die grossen Rasenflaechen in diesem Teil des Parks laden zum Ausrasten ein. Ein paar Abenteurer "
            "veranstalten auch ein gemuetliches Picknick.");

  AddDetail( ({"gras"}),
	    "Das Gras ist gruen und schoen kurz gemaeht. Jedenfalls da wo Du gerade stehst. Du siehst aber einen "
            "Gaertner der mit einem komisch aussehenden Geraet eine Rasenflaeche bearbeitet.");

  AddDetail( ({"ausruhen"}),
	    "Wenn Du mal fertig geforscht hast, ruhst Du Dich hier ein wenig aus."); 
  
  AddDetail( ({"weg","wege"}), 
            "Die Wege sind aus kleinen Steinchen angelegt worden. An ihrem Rand sind lauter Beete, in denen "
            "huebsche Blumen wachsen.");

  AddDetail( ({"steinchen"}),
	    "Ganz normale kleine Steinchen.");

  AddDetail( ({"hecke","westen"}),
	    "Die Hecke im Westen umgibt anscheinend den gesamten Park. Die Blaetter sind so dicht, so dass Du "
            "die dahinter liegende Strasse nicht sehen kannst.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren.");

  AddDetail( ({"beete","beeten","rand"}), 
            "In den gepflegten Beeten am Rand der Wege wachsen lauter Blumen.");

  AddDetail( ({"blumen"}),
	    "In den Beeten wachsen Veilchen, Tulpen und schoene Rosen. Ein paar Bienen schwirren um die Blumen rum.");

  AddDetail( ({"leute","abenteurer"}),
	    "Ein paar Abenteurer sitzen auf einer Decke und geniessen in der Sonne ein leckeres Picknick."); 
  
  AddDetail( ({"picknick","spass"}), 
            "Das Picknick scheint Spass zu machen. Es gibt ja auch leckere Sachen zum Essen und Trinken. ");

  AddDetail( ({"sachen"}),
	   "Es gibt Sachen zum Essen und zum Trinken.");

  AddDetail( ({"decke"}),
	    "Die Abenteurer sitzen auf einer grossen Decke, auf der sie ihr Essen und Trinken zu sich nehmen. Im "
            "Korb scheint wohl nichts mehr zu sein, oder?");

  AddDetail( ({"korb"}),
	    "Du koenntest ja mal einen Blick in den Korb werfen.");

  AddDetail( ({"blick","wirf","in"}),
	    "Dann WIRF doch einen BLICK IN KORB.");

  AddDetail( ({"pudding","nachtisch","schokolade"}),
	    "Der Pudding ist aus Schokolade und wird sehr gut zum Nachtisch schmecken.");

  AddDetail( ({"braten","essen","wasser","mund"}), 
            "Es gibt einen richtig lecker aussehenden Braten. Da laeuft Dir das Wasser im Mund zusammen.");

  AddDetail( ({"flasche","wein","trinken","lust","tropfen"}),
	    "Zum Picknick gibt es eine leckere Flasche Wein. Du haettest jetzt auch Lust auf einen guten Tropfen.");

  AddDetail( ({"gaertner","gaertners"}),
	    "Der Gaertner maeht mit einem komischen Geraet eine der Rasenflaechen."); 
  
  AddDetail( ({"geraet","rasenmaeher","maeher"}), 
            "Das Geraet gibt ein surrendes Geraeusch von sich. In dem Geraet steckt eine Kugel, die das Geraet "
            "anscheinend mit magischer Energie versorgt. Die Zentauren kennen sich wirklich mit Magie aus. ");

  AddDetail( ({"kugel","energie","innern"}),
	    "Du Kugel schimmert blaeulich von einer magischen Energie, die aus dem Innern der Kugel zu kommen scheint. "
            "Ohne diese Energie wuerde sicher auch das Geraet nicht funktionieren. Nennen wir das Geraet einfach mal "
            "Rasenmaeher, da das Geraet ja den Rasen maeht.");

  AddDetail( ({"veilchen"}),
	    "Die blauen Veilchen sehen wunderschoen aus.");

  AddDetail( ({"tulpen"}),
	    "Die Tulpen die hier wachsen sind gelb und rot. Aber nichts besonderes.");

  AddDetail( ({"rosen","zuechtung"}), 
            "Die Rosen sind sicher eine eigene Zuechtung der Zentauren. Sie sind wirklich toll.");

  AddDetail( ({"zentauren","wesen","mensch","pferd"}),
	    "Die Zentauren sind magische Wesen. Sie sind halb Mensch und halb Pferd. Sie kennen sich sehr gut mit "
            "der Magie aus.");

  AddDetail( ({"magie","jahrzehnte"}),
	    "Die Zentauren kennen sich sehr gut mit Magie aus. Bis Du Dich so gut auskennst, dauert es wohl noch "
            "Jahrzehnte.");

  AddDetail( ({"sonne"}),
	    "Die Sonne steht fast senkrecht am Himmel und waermt Dich.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen blau, nur ein paar weisse Wolken ziehen am Himmel entlang."); 
  
  AddDetail( ({"wolken","regen","schaefchenwolken"}), 
            "Die Wolken sehen nicht nach Regen aus. Ganz harmlose Schaefchenwolken.");

  AddDetail( ({"bienen","honig"}),
	    "Die Bienen sammeln Honig und fliegen zwischen den Blumen hin und her.");

  AddDetail( ({"blaettern","blaetter"}),
	    "Die Blaetter der Hecke sind sehr dicht, so dass man die dahinter liegende Strasse nicht sehen kann.");

  AddDetail( ({"strasse"}),
	    "Die Hecke trennt die den Park von der Strasse, so dass man den Laerm der Strasse nicht hoeren kann.");

  AddDetail( ({"laerm"}),
	    "1. Gibt es keinen Laerm, da er durch die Hecke aufgehalten wird. 2. Und wenn dann sollte man den Laerm "
            "schon erlauschen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");


  AddSmell(DEFAULT_SMELL, "Du riechst den suesslichen Duft der Blumen.");  
 
  AddSmell( ({"blumen","duft"}),
	   "Die Blumen riechen suesslich. Du schnupperst gerne an ihnen.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Surren vom Rasenmaeher, das Lachen der Leute die ein Picknick "
                          "machen und ein leises Rascheln in der Hecke.");

  AddSound( ({"surren","rasenmaeher","maeher","geraeusch"}),
	   "Das Surren kommt aus dem Rasenmaeher des Gaertners. Ein komisches Geraet.");

  AddSound( ({"lachen","leute","picknick"}),
	   "Das Picknick scheint viel Spass zu machen.");

  AddSound( ({"laerm"}),
	   "Du kannst den Laerm der Strasse nicht hoeren, da die Hecke den Laerm der Strasse fern haelt.");

  AddSound( ({"rascheln"}),
	   "Du hoerst ein Rascheln aus der Hecke. Vielleicht solltest Du sie mal durchsuchen.");

//-----Details Ende-----
AddItem(NPC "zentaura", REFRESH_DESTRUCT);


AddExit("sueden", ROOM "zen17");  
AddExit("osten", ROOM "zen22");
AddExit("norden", ROOM "zen26");

AddCmd( ({"durchsuch", "durchsuche" }), "durchsuchen" );
AddCmd( ({"wirf", "werfe" }), "werfen" );

}
void reset()
{
  ::reset();
  sperlingda=1;

}

int durchsuchen (string str)
{
  object sperling;
  notify_fail ("Was moechtest Du durchsuchen?\n");

  if(!str) return 0;
  
  if(!(str == "hecke" )) return 0;
  if (present("CHIVASSPERLING",TO) || !sperlingda)

  {
    write(BS("Du findest momentan nichts in der Hecke."));
    return -1;
  }
  write(BS("Du durchsuchst die Hecke und schreckst einen Sperling auf.\n"));
  sperlingda=0;
  sperling = clone_object (NPC "sperling" );
  sperling->move(TO,M_GO|M_NOCHECK,"fliegt aus der Hecke und landet vor Dir auf dem Boden.");
  return 1;
}
int werfen(string str)
{
   notify_fail("In was moechtest Du einen Blick werfen?\n");
   if ( member( ({ "blick in korb","blick in den korb","einen blick in den korb","einen blick in korb" }),str) != -1) 
  {
    write(BS ( "Du wirfst einen Blick in den Korb und siehst einen leckeren Pudding, der anscheinend als "
               "Nachtisch dienen soll."));
    say( TPN+" wirft einen Blick in den Korb auf der Decke.\n");
    return 1;
  }

}  
   
