// von Chivas
// 26.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>


void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einer Strasse in Roch Adan");
  SetProp( P_INT_LONG,
	"Du befindest Dich auf einer Strasse in Roch Adan, die zwischen den Baumriesen "
	"vom Haupttor im Sueden weiter durch die Stadt fuehrt. Im Norden befindet sich "
	"eine Hecke, die den Park begrenzt. Du kannst ihn im Nordwesten betreten. Die "
        "Strasse auf der Du stehst ist mit Gras bewachsen. ");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----


  AddDetail( ({"strasse","teil"}), 
            "Die Strasse fuehrt nach Sueden wieder zum Haupttor, durch das Du die Stadt betreten "
            "hast. Nach Nordosten geht es zu verschiedenen Baumriesen, in denen die Zentauren wohnen "
            "und arbeiten. Nach Westen geht es an einer Hecke vorbei, die den Park umschliesst weiter "
            "in den westlichen Teil der Stadt. Ansonsten kannst Du nach Norden und Nordwesten und den "
            "Park von Roch Adan betreten, wo die Strasse in einen steinigen Weg uebergeht.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren.");

  AddDetail( ({"baumriesen","riesen","baeume"}),
	    "Die Zentauren wohnen und arbeiten in den Baumriesen. Sie sind wohl die groessten Baeume im "
            "ganzen Silberland.");

  AddDetail( ({"haupttor","tor","sueden"}), 
            "Das Haupttor kannst Du gerade noch so erkennen. Durch das Tor verlaesst Du die Stadt wieder. ");

  AddDetail( ({"westen","hecke"}),
	    "Im Westen geht die Strasse weiter an der Hecke vorbei, die den ganzen Park umschliesst. Die kleinen "
            "Blaetter wehen leicht im Wind.");

  AddDetail( ({"park","eindruck","nordwesten"}),
	    "Der Park macht einen sehr gepflegten Eindruck. Du kannst grosse Rasenflaechen sehen, Beete in denen "
            "Blumen wachsen, gepflegte Wege und gleich im Norden einen Brunnen."); 
  
  AddDetail( ({"gras","personen"}), 
            "Das Gras ist von den vielen Personen, die hier rumlaufen niedergetrampelt.");

  AddDetail( ({"boden"}),
	    "Der Boden der Strasse ist mit Gras bedeckt und kleinen Steinchen.");

  AddDetail( ({"steinchen"}),
	    "Ganz normale kleine Steinchen. An ihnen ist nichts besonderes zu entdecken.");

  AddDetail( ({"himmel"}), 
            "Der Himmel ist schoen blau und die Sonne strahlt am Himmel.");

  AddDetail( ({"sonne"}),
	    "Die Sonne waermt Dich, obwohl sie wohl gleich mal hinter einer kleinen Wolke am Himmel verschwinden "
            "wird. Kleine Voegel fliegen unter den Wolken umher.");

  AddDetail( ({"wolke","wolken"}),
	    "Die Wolken sind weiss, es sieht nicht so aus als ob es regnen wird."); 
  
  AddDetail( ({"blaetter"}), 
            "Die kleinen gruenen Blaetter der Hecke bewegen sich leicht im Wind.");

  AddDetail( ({"voegel"}),
	    "Die Voegel sind zu hoch um genau zu erkennen um was fuer Voegel es sich handelt.");

  AddDetail( ({"silberland"}),
	    "DU befindest Dich im Silberland und es gefaellt Dir hier.");

  AddDetail( ({"norden","brunnen"}), 
            "Im Norden im Park ist gleich ein grosser Brunnen. Du solltest naeher ran gehen und ihn Dir anschauen.");

  AddDetail( ({"rasen","rasenflaechen","flaechen"}),
	    "Die Rasenflaechen im Park sind sehr gepflegt und sie sehen so aus, als ob sie gerade erst gemaeht "
            "wurden. Man kann sich sicher gut auf den Rasen setzen und sich ausruhen.");

  AddDetail( ({"beete","beeten"}),
	    "In den Beeten im Park wachsen viele schoene bunte Blumen."); 
  
  AddDetail( ({"blumen"}), 
            "Um genau zu sehen was fuer Blumen es sind, solltest Du den Park schon betreten.");

  AddDetail( ({"wege","weg"}),
	    "Die Wege bestehen aus kleinen Steinchen und schlaengeln sich durch den gesamten Park soweit Du es "
            "von hier aus sehen kannst.");

  AddDetail( ({"arbeit","sache"}),
	    "Arbeit ist nicht so Deine Sache, Du laesst lieber arbeiten.");

  AddDetail( ({"abenteurer"}), 
            "Andere Abenteurer wie Du selbst einer bist.");

  AddDetail( ({"zentauren","wesen","mensch","pferd"}),
	    "Zentauren sind magische Wesen, sie sind halb Mensch und halb Pferd.");

  AddDetail( ({"wind"}),
	    "Du siehst wie der Wind leicht die Blaetter der Hecke bewegt."); 
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");


  AddSmell(DEFAULT_SMELL, "Du riechst das Gras am Boden und die Blumen im nahen Park.");  
 
  AddSmell( ({"gras"}),
	   "Das Gras riecht frisch und nach Sommer.");

  AddSmell( ({"sommer"}),
	   "Sommer riecht wie frisches Gras.");

  AddSmell( ({"blumen"}),
	   "Die Blumen im Park riechen angenehm suesslich.");

  AddSound(DEFAULT_SOUND, "Du hoerst den ueblichen Laerm in der Stadt und ein Plaetschern im Park");

  AddSound( ({"laerm"}),
	   "Der Laerm stammt von den Zentauren, die ihrer Arbeit nachgehen oder von anderen Abenteurern wie Dir "
           "die Roch Adan erforschen.");
  
  AddSound( ({"plaetschern"}),
	   "Das Plaetschern kommt von einem Brunnen, der sich gleich noerdlich von Dir im Park befindet.");

//-----Details Ende-----

AddExit("sueden", ROOM "zen16");  
AddExit("westen", ROOM "zen18");
AddExit("nordosten", ROOM "zen24");
AddExit("nordwesten", ROOM "zen22");
AddExit("norden", ROOM "zen23");

}  
   
