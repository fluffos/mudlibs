// von Chivas
// 01.6.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Waldweg");
  SetProp( P_INT_LONG,
	"Die kraeftigen Baeume links und rechts weisen Dir den Weg. Nur ab "
	"und zu kannst Du kleine Luecken zwischen den Baeumen und dem "
	"Unterholz erkennen. Die Lichtverhaeltnisse in diesem Teil des Waldes "
	"sind recht schlecht, da durch die eng stehenden Baeume und das "
	"Blaetterdach kaum ein Lichtstrahl den Boden beruehrt. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden","erde"}), 
            "Der Boden ist erdig wie ein normaler Waldweg. Ab und zu  "
	    "kann man auch ein paar Steine im Gras und Zweige und Nadeln "
            "auf dem Boden liegen sehen. Von Zeit zu Zeit trifft ein "
	    "Lichtstrahl durch das dichte Blaetterdach den Boden.");

  AddDetail( ({"weg","waldweg"}),
	    "Der Waldweg ist von Baeumen gesaeumt und fuehrt Dich "
	    "weiter nach Norden in unbekanntes Gebiet oder nach Sueden "
            "in Richtung Kristallwald. Am Wegrand steht ein Schild.");

  AddDetail( ({"gebiet"}),
	    "Ein unbekanntes Gebiet. Du bist sehr neugierig.");

  AddDetail( ({"wegrand","rand"}),
	    "Nicht auf dem Weg, sondern daneben.");
  
  AddDetail( ({"schild","nordwest"}),
	    "Das Schild zeigt nach Nordwest, Du koenntest versuchen es zu "
            "lesen.");

  AddDetail( ({"norden"}),
	    "Norden ist das Gegenteil von Sueden.");

  AddDetail( ({"nordwest","nordwesten"}),
	    "Nicht ganz noerdlich und nicht ganz westlich, halt Nordwest.");

  AddDetail( ({"land"}),
	    "Du stehst auf dem Land.");

  AddDetail( ({"zentaur","zentauren","geschoepfe","kopf","huefte","menschen",
	       "pferdekoerper","koerper","zukunft","bewegungen","planeten"}),
	    "Zentauren sind magische Geschoepfe. Sie sind vom Kopf bis zur "
	    "Huefte Menschen, darunter jedoch, mit Pferdekoerper und -beinen "
	    "versehen. Man erzaehlt sich darueber, dass sie die Zukunft an "
	    "den Bewegungen der Planeten am Himmel lesen koennen.");

  AddDetail( ({"himmel"}),
	    "Den Himmel kann man durch das dichte Blaetterdach kaum erkennen.");

  AddDetail( ({"sonne"}),
	    "Die Sonne kann man durch das dichte Blaetterdach nicht erkennen.");


  AddDetail( ({"sueden"}),
	    "Sueden ist das Gegenteil von Norden.");

  AddDetail( ({"gegenteil"}),
            "Was ein Gegenteil ist solltest Du schon wissen, ansonsten "
            "solltest Du deine Intelligenz erhoehen. ");

  AddDetail( ({"intelligenz","ansammlung","normalerweise","zwei","zeit",
	      "adventszeit","tode"}),
	    "Jetzt hoer aber auf!!!! Es haben sich schon welche zu Tode untersucht.");

  AddDetail( ({"baeume","baeumen"}),
	    "Am Wegrand befinden sich grosse Kiefern und Tannen, aber auch viele "
	    "Eichen und Ulmen kannst Du erkennen. Ein Baum faellt Dir besonders "
	    "auf. ");

  AddDetail( ({"baum"}),
	    "Beim Stamm dieser Eiche sieht irgendetwas nicht natuerlich aus.");

  AddDetail( ({"stamm"}),
	    "Es wurde ein Schriftzug in den Stamm dieser Eiche geritzt, vielleicht " 
            "kannst Du ihn lesen. ");

  AddDetail( ({"schriftzug"}),
	   "Vielleicht kannst Du ihn ja lesen.");

  AddDetail( ({"kristallwald"}),
	   "Geh einfach mal hin und schau ihn Dir an, er ist einer der faszinierendsten "
           "Orte im Silberland.");

  AddDetail( ({"silberland","orte"}),
	   "Du bist im Silberland und findest es toll hier.");

  AddDetail( ({"nadeln","nadel"}),
	   "Nadeln haengen an den Kiefern, Tannen und liegen auf dem Boden.");

  AddDetail( ({"kiefer","kiefern"}),
	   "Wie halt Kiefern in einem Wald aussehen: Nadeln, Stamm und Aeste.");

  AddDetail( ({"tanne","tannen","weihnachtsbaum"}),
	   "Wie halt Tannen aussehen in einem Wald aussehen. Schau Dir "  
           "mal in der Adventszeit Deinen Weihnachtsbaum an. ");

  AddDetail( ({"ulme","ulmen"}),
	   "Wie halt ganz normale Ulmen mit Blaettern, Stamm und Aesten in einem Wald "
           "aussehen.");

  AddDetail( ({"eiche","eichen"}),
	   "Wie halt Eichen in einem Wald aussehen, obwohl Dir am Stamm einer Eiche etwas auffaellt. ");

  AddDetail( ({"luecken","luecke","augenwinkeln","augenwinkel"}),
	    "Du schaust Dir die Luecken an, wendest Dich aber dann ab, "
	    "da nichts interessantes zu erkennen ist. Ploetzlich erkennst Du "
	    "aus den Augenwinkeln in einer Luecke etwas Glitzerndes.");

  AddDetail( ({"blatt","blaetter","blaetterdach","dach","blaettern"}),
	    "Die Blaetter bilden ein dichtes Dach, so dass kaum ein Lichtstrahl "
	    "den Boden trifft.");

  AddDetail( ({"unterholz"}),
	    "Das Unterholz ist sehr dicht. Ab und zu sind ein paar Luecken "
	    "zwischen den Baeumen und dem Unterholz zu sehen. Das Unterholz besteht "
            "aus Bueschen und Straeuchern.");

  AddDetail( ({"holz"}),
	    "Baeume bestehen aus Holz. Dumme Frage!");

  AddDetail( ({"luecke","glitzern","glitzerndes","etwas"}),
	    "Du koenntest ja mal probieren in die Luecke zu greifen.");

  AddDetail( ({"licht","verhaeltnisse","lichtverhaeltnisse"}),
	    "Es ist ein bisschen schummrig, wenig Licht dringt durch das dichte "
	    "Blaetterdach.");

  AddDetail( ({"lichtstrahl","strahl"}),
	    "Ab und zu trifft ein Lichtstrahl den Boden, das jedoch durch das "
	    "dichte Blaetterdach nicht haeufig geschieht.");

  AddDetail( ({"steine","steinen","stein"}),
	    "Ganz normale Steine, wie man sie auf jedem anstaendigen Waldweg "
	    "findet.");

  AddDetail( ({"teil"}),
	    "Ja, dies ist ein Teil des Waldes.");

  AddDetail( ({"wald","waldes"}),
	    "Ein Wald ist eine Ansammlung von Baeumen.");

  AddDetail( ({"kraeftig","kraeftigen","alt"}),
	    "Die Baeume sind sehr kraeftig und alt.");

  AddDetail( ({"links"}),
	    "Links ist dort wo der Daumen rechts ist.");

  AddDetail( ({"rechts"}),
	    "Rechts ist dort wo der Daumen links ist.");

  AddDetail( ({"daumen"}),
	    "Normalerweise hat man davon zwei.");

  AddDetail( ({"gras"}),
	    "Ganz normales Gras, welches mit ein paar Steinen versehen ist.");

  AddDetail( ({"zweige","zweig"}),
	    "Sie liegen auf dem Waldweg und sind wohl von den Baeumen "
	    "heruntergefallen.");

  AddDetail( ({"aeste","ast","wind"}),
	    "Die Aeste wiegen sich leicht im Wind.");

  AddDetail( ({"buesche","bueschen"}),
	    "Ganz normale Buesche, die es in jedem Wald gibt.");

  AddDetail( ({"straeucher","straeuchern"}),
	    "Manche der Straeucher haben Beeren.");

  AddDetail( ({"taschenmesser","messer"}),
	    "Keiner hat hier ein Taschenmesser liegen lassen.");

  AddDetail( ({"beeren","beere"}),
	    "Die Beeren kennst Du nicht und Du traust Dich auch nicht sie zu "
	    "probieren. Oder solltest Du doch mal in eine beissen?");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst die Baeume, das Gras am Boden und auch "
		  "die klare Luft.");  
 
  AddSmell( ({"baeume","baum"}),
	   "Sie duften nach Kiefern und Tannen.");

  AddSmell( ({"luft"}),
	   "Du atmest die klare Luft ein und fuehlst Dich frei.");
  
  AddSmell( ({"kiefer","kiefern"}),
	   "Wie halt Kiefern in einem Wald.");

  AddSmell( ({"gras","boden"}),
	   "Das Gras am Boden riecht frisch.");

  AddSmell( ({"tanne","tannen"}),
	   "Wie Tannen halt so riechen. Falls Du es nicht weisst, dann "
	   "schnupper mal in der Adventszeit an Deinem Weihnachtsbaum. ");
  
  AddSmell( ({"weihnachtsbaum"}),
	   "Sei realistisch! Warum sollte jetzt hier im Wald ein Weihnachtsbaum "
           "stehen?");
 
  AddSmell( ({"ulme","ulmen"}),
	   "Wie halt ganz normale Ulmen riechen.");

  AddSmell( ({"eiche","eichen"}),
	   "Wie halt Eichen riechen, sie riechen halt nach Eichen, was sonst.");

  
  AddSound(DEFAULT_SOUND, "Der Wind weht nur ganz leicht durch "
	   "das Blaetterdach, trotzdem hoerst Du ein leichtes Rascheln.");

  AddSound( ({"wind"}),
	   "Du kannst ihn kaum hoeren. Er bringt nur die Blaetter leicht zum "
           "Rascheln.");
  
  AddSound( ({"blaetter","rascheln"}),
	   "Die Blaetter bewegen sich leicht im Wind, so dass sie rascheln!");

  AddReadDetail( ({"schild"}),
		"Folge diesem Weg, voll des Mutes, und Du erreichst das Land "
                "der Zentauren.");

  AddReadDetail( ({"schriftzug","schrift","zug"}),
		"In einen Stamm wurde mit einem Taschenmesser folgendes eingeritzt:\n"        
  +             "  \n"
  +             "                        ***    *** \n" 
  +             "                      **   *  *   ** \n"
  +             "                     *      **      * \n"
  +             "                     *     Elro     * \n"
  +             "                      *      +     * \n"
  +             "                        *  Hiri   * \n"
  +             "                          *     * \n"
  +             "                            * * \n"
  +             "                             * \n"
  +             "          \n");

//-----Details Ende-----
  
AddExit("suedosten", ROOM "zen47");
AddExit("nordwesten", ROOM "zen2");

AddCmd( ({"greifen", "greife","greif" }), "greifen" );
AddCmd( ({"beiss", "beisse", "beissen" }), "beissen" );

}
int beissen(string str)
{
   if ( member( ({"in beere","in beeren","in eine beere","beere","beeren","eine beere"})
,str) != -1) 
  {
    write( "Du beisst in die Beere und verziehst das Gesicht.\n");
    say( TPN+" verzieht das Gesicht.\n");
    return 1;
  }
}
int greifen(string str)
{
   notify_fail("Moechtest Du etwa in die Luecke greifen?\n");
   if ( member( ({ "luecke", "in luecke" }),str) != -1) 
  {
    write(BS ( "Du greifst in die Luecke, findest aber nichts."));
    say( TPN+" greift in eine Luecke.\n");
    return 1;
  }

}  
   
