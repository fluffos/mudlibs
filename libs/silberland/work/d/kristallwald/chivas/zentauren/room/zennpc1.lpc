inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>


void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einer Baumhoehle");
  SetProp( P_INT_LONG,
	"Dies ist die Baumhoehle eines Zentauren. Der "
	"Boden ist mit Reisig bedeckt und es ist sehr weich, wenn man auf ihm geht. "
        "An der Wand haengen ein paar Bilder und an der Nordwand steht ein "
        "Kleiderschrank. In einer Ecke liegt ein grosser Haufen mit Stroh, der "
        "wohl als Bett zu dienen scheint. In der Mitte der Hoehle steht ein grosser "
        "Tisch an dem der Zentaur anscheinend isst und andere Dinge macht.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( ({"boden"}), 
            "Der Boden ist mit Reisig bedeckt. Nur ab und zu sieht man den Steinboden.");

  AddDetail( ({"reisig"}),
	    "Der Reisig scheint recht frisch zu sein und bedeckt fast den ganzen Boden, "
            "nur ab und zu kann man Steinplatten unter dem Reisig sehen.");

  AddDetail( ({"wand","waende","holz"}),
	    "Die Waende und die Decke sind, wie sollte es anders sein, aus Holz. Einige Bilder haengen an "
            "der Wand.");

  AddDetail( ({"bilder","besitzer","besitzers","familie","gemaelde"}), 
            "Die Bilder sind Gemaelde, auf denen verschiedene Zentauren abgebildet sind, "
            "anscheinend die Familie des Besitzers der Baumhoehle.");

  AddDetail( ({"ecke"}),
	    "In der Ecke ist ein grosser Haufen mit Stroh.");

  AddDetail( ({"decke"}),
	    "Die Decke besteht natuerlich aus Holz.");

  AddDetail( ({"haufen","stroh"}),
	    "Das Stroh scheint wohl als Bett zu dienen."); 
  
  AddDetail( ({"bett"}), 
            "In einem normalen Bett kann ein Zentaur wohl auch nicht schlafen.");

  AddDetail( ({"mitte","tisch"}),
	    "In der Mitte steht ein grosser Tisch, an dem man wohl gemuetlich essen kann.");

  AddDetail( ({"nordwand"}),
	    "An der Nordwand steht ein grosser alter Kleiderschrank.");

  AddDetail( ({"himmel"}),
	    "Da must Du schon raus gehen.");

  AddDetail( ({"fuesse"}),
	    "Davon hast Du mindestens zwei.");

  AddDetail( ({"schrank","kleiderschrank"}), 
            "In dem Kleiderschrank sind sicher die Sachen des Besitzers der Baumhoehle.");

  AddDetail( ({"sachen","moeglichkeit"}),
	    "An die Sachen kommst Du nicht ran, der Schrank ist verschlossen und Du hast "
            "keine Moeglichkeit den Schrank zu oeffnen.");

  AddDetail( ({"steinboden","platten","steinplatten"}),
	    "Du erkennst ein paar Steinplatten zwischen dem Reisig, aber ansonsten uninteressant."); 

  AddDetail( ({"dinge"}),
	    "Alle moeglichen Dinge kann man machen."); 
  
  
  AddDetail( ({"zentauren","wesen","mensch","pferd","zentaur"}),
	    "Zentauren sind magische Wesen. Sie sind halb Mensch und halb Pferd."); 

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Dies ist die Stadt der Zentauren. Dir gefaellt es hier sehr gut.");

  AddDetail( ({"baumriesen","riesen","baeume","zuhause"}), 
            "In den Baumriesen arbeiten und wohnen die Zentauren. Die Baeume sind riesig. "
            "Sie sind die groessten im ganzen Silberland.");

  AddDetail( ({"baumhoehle","hoehle"}),
	    "In diesem Baumriesen wohnt ein Zentaur. Er hat sein Zuhause in dieser Baumhoehle.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland und fuehlst Dich wohl hier.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Reisig.");  
 
  AddSmell( ({"reisig"}),
	   "Der Reisig ist frisch, darum riecht er noch so intensiv.");

  AddSound(DEFAULT_SOUND, "Es ist recht still, Du hoerst nur das Rascheln Deiner Fuesse "
                          "im Reisig.");

  AddSound( ({"Rascheln","geraeusch"}),
	   "Ein Geraeusch, das Deine Fuesse im Reisig erzeugen.");

//-----Details Ende-----

AddItem(OBJ "truhe", REFRESH_DESTRUCT);

AddExit("osten", ROOM "zen14");

}

