// von Elro
// 09.3.2004
// 
// Raum meines Gesellenstueckes "Wache - zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>


void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Baumriesen");
  SetProp( P_INT_LONG,
	"Dies ist der Aufenthaltsbereich der Wachen vom Stadttor. Du wunderst Dich, "
	"dass in dem Baum doch soviel Platz ist. An den Waenden befinden sich "
	"Moeglichkeiten, Waffen und Ruestungen zu lagern. Der Boden ist mit Reisig "
	"bedeckt und es steht ein grosser runder Tisch in der Mitte des Raumes, an "
	"dem die Wachen anscheinend essen. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden"}), 
            "Der Boden ist mit Reisig bedeckt. Die Steinplatten darunter sind "
            "ein wenig verdeckt.");

  AddDetail( ({"stadttor","tor"}),
	   "Das Stadttor befinden sich im Sueden, ausserhalb der Wachstation.");

  AddDetail( ({"wachstation"}),
	   "Du befindest Dich in der Wachstation, wo sich die Wachen aufhalten.");

  AddDetail( ({"stadt","roch","adan","roch adan"}),
	   "Du befindest Dich in der Stadt Roch Adan. Wenn Du mehr sehen willst, musst Du die "
           "Wache schon verlassen.");

  AddDetail( ({"wache","wachen","taetigkeit","moment"}),
	   "Momentan sind keine Wachen in der Wachstation, anscheinend sind sie alle am Tor und "
           "gehen ihrer Taetigkeit nach.");

  AddDetail( ({"aufenthaltsbereich","bereich","aufenthalt","arbeit"}),
	    "Die Wachen ruhen sich hier nach getaner Arbeit aus. ");

  AddDetail( ({"himmel"}),
	   "Um den Himmel zu sehen, musst Du schon raus gehen.");

  AddDetail( ({"baum","platz","baumhoehle","raumes","raum","anschein"}),
	    "Es ist erstaunlich wie viel Platz doch in einem solchen Baum ist. Der Raum scheint "
            "groesser zu sein als es von aussen den Anschein macht.");
  
  AddDetail( ({"waende"}),
	    "An den Waenden haengen Waffen und Ruestungen. An der Westwand faellt Dir "
            "etwas auf. ");

  AddDetail( ({"wand"}),
	    "Welche Wand meinst Du ? ");

  AddDetail( ({"nordwand","ostwand"}),
	    "An dieser Wand haengen ein paar Waffen und Ruestungen. ");

  AddDetail( ({"suedwand"}),
	    "Durch die Tuer in der Suedwand hast Du den Wachraum betreten. ");

  AddDetail( ({"westwand","glasscheiben","scheiben","glas","front"}),
	    "An der Westwand steh ein grosser Schrank, der mit einem riesigen "
	    "Vorhaengeschloss gesichtert ist. Durch die milchweissen "
	    "Glasscheiben an der Front kannst Du nicht hindurch sehen. Wie "
	    "kriegst Du bloss raus, was in dem Schrank ist? ");

  AddDetail( ({"schrank","vorhaengeschloss","schloss","fingernagel","weichei","baby"}),
	   "Du machst Dich an dem Schrank zu schaffen und probierst das "
	   "Schloss aufzubekommen. Dabei brichst Du Dir einen Fingernagel ab "
	   "und Du heulst wie ein Baby. Weichei.");

  AddDetail( ({"waffen"}),
	    "In den Halterungen an der Wand haengen riesige Boegen und Schwerter. ");

  AddDetail( ({"halterungen","moeglichkeiten","halterung","moeglichkeit"}),
	    "An den Waenden sind Halterungen um Waffen und Ruestungen zu verstauen. ");

  AddDetail( ({"boegen","bogen"}),
	    "Die Boegen sind fast so gross wie Du, Du koenntest damit sicher nicht schiessen. "
            "Hoechstens Dir selbst in den Fuss. ");

  AddDetail( ({"fuss","fuesse"}),
	    "Normalerweise hast Du zwei Fuesse und nicht nur einen Fuss.");

  AddDetail( ({"tuer"}),
	    "Durch die Tuer in der Suedwand kannst Du die Wache wieder verlassen. ");

  AddDetail( ({"schwerter","schwert"}),
	    "Riesige Schwerter, Du koenntest ja mal probieren ein solches Schwert aus einer "
	    "Halterung zu ziehen. ");

  AddDetail( ({"ruestungen","ruestung","pferdekoerper","teil"}),
	    "Solche Ruestungen hast Du noch nie gesehen, es sieht so aus, als ob die Ruestungen "
            "einen kompletten Zentauren einkleiden wuerden, dass heisst den kompletten "
            "Pferdekoerper und den Teil der menschlich ist. ");

  AddDetail( ({"zentauren","weg"}),
	   "Du befindest Dich in der Stadt der Zentauren. Dir werden sicher welche ueber den Weg laufen.");

  AddDetail( ({"reisig"}),
	    "Ganz normales Reisig wie es wohl in jeder Baumhoehle den Boden bedeckt. Darunter kann " 
            "man Steinplatten erkennen, die jedoch uninteressant scheinen. ");

  AddDetail( ({"steinplatten"}),
	   "Die Steinplatten sind sauber verfugt.");

  AddDetail( ({"fugen"}),
	   "Ganz normale Fugen zwischen den Steinplatten. Uninteressant.");

  AddDetail( ({"tisch","pokerrunde"}),
	   "An diesem Tisch essen wohl die Wachen vom Tor, im Moment sieht es jedoch so aus, als ob "  
           "die Wachen in einem interessanten Pokerspiel gestoert wurden. Es gibt 6 Haufen von "
           "Karten, einen von dem man Karten bekommen kann, einen auf dem die schon abgeworfenen "
           "Karten liegen und vier Haufen die um den Tisch verteilt liegen. Dies scheinen die "
           "Spielerkarten zu sein. Des weiteren liegen Goldstuecke in der Mitte als Spieleinsatz "
           "und es stehen Glaeser auf dem Tisch. ");

  AddDetail( ({"mitte"}),
	   "In der Mitte des Raumes steht ein Tisch.");

  AddDetail( ({"haufen","karten","spielerkarten","pokerspiel","blick","spieler","spiel"}),
	   "Die Karten der Spieler ziehen Dich magisch an, vielleicht solltest Du mal einen Blick "  
           "wagen und sehen wer das Spiel macht. ");

  AddDetail( ({"glaeser","glas","schnueffeln","reste"}),
	    "In den Glaesern sind noch Reste einer alkoholischen Substanz. Du fuehlst Dich schon "
	    "vom Schnueffeln an den Glaesern ganz benommen. ");

  AddDetail( ({"substanz"}),
	    "Irgendwie ekelst Du dich davor. So etwas wuerdest Du nie trinken. ");

  AddDetail( ({"goldstuecke","goldstueck","betraege","berg","goldstuecken","einsatz","spieleinsatz"}),
	    "Auf dem Tisch liegt schon ein richtiger Berg an Goldstuecken. In dieser Pokerrunde "
	    "scheint es um hohe Betraege zu gehen.");

  AddDetail( ({"decke"}),
	    "Die Decke besteht aus Holz, wie ungewoehnlich fuer einen Baum. An der Decke haengt "
	    "eine kleine Oellampe und mehrere Ketten. ");

  AddDetail( ({"ketten","kette"}),
	    "Es sieht so aus, als ob die Zentauren Unruhestifter vom Tor zum abkuehlen hier "
            "an den Ketten aufhaengen. ");

  AddDetail( ({"holz"}),
	    "Baeume bestehen aus Holz, dumme Frage. ");

  AddDetail( ({"lampe","oel","oellampe"}),
	    "Eine kleine Oellampe haengt an der Decke, in dem eine kleine Flamme brennt. ");
  
  AddDetail( ({"flamme","licht"}),
	    "Die Flamme flackert in einem gruenlichen Licht und erhellt den Wachraum ein bisschen. ");
 
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  
  
  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig muffig und ein bisschen nach Alkohol.");  
 
  AddSmell( ({"alkohol","alkoholgeruch"}),
	   "Der Alkoholgeruch scheint von den Glaesern auf dem Tisch zu kommen.");
  
  AddSound(DEFAULT_SOUND, "Du hoerst nur die Geraeusche ausserhalb der Wache, typische "
           "Stadtgeraeusche. ");

  AddSound( ({"stadtgeraeusche","geraeusche"}),
	   "Geh doch raus, dann hoerst Du mehr.");

  AddReadDetail( ({"schild"}),
		"Folge diesem Weg voll des Mutes und Du erreichst das Land der Zentauren");

  AddReadDetail( ({"schriftzug","schrift","zug"}),
		"Auf dem Stamm steht mit einem Taschenmesser eingeritzt: Aradia + "          
                "Andronicus");

//-----Details Ende-----
  
AddExit("sueden", ROOM "zen13");

AddCmd( ({"zieh", "ziehe" }), "ziehen" );
AddCmd( ({"wage", "wag" }), "wagen" );

}
int wagen(string str)
{
   notify_fail("Was willst Du wagen?\n");
   if ( member( ({ "blick", "einen blick" }),str) != -1) 
  {
    write( "Du nimmst die einzelnen Karten der Spieler hoch und bist erstaunt.\n"
           "Spieler 1 = 4 Asse\n"
           "Spieler 2 = 4 Asse\n"
           "Spieler 3 = 4 Asse\n"
           "Spieler 4 = Royal Flash\n"
           "    \n"
           "Du findest es beeindruckend, alle betruegen und einer betruegt besser. Du grinst.\n");
    say( TPN+" nimmt die Karten der einzelnen Spieler, wagt einen Blick und grinst.\n");
    return 1;
  }
}
int ziehen(string str)
{
   notify_fail("Was moechtest Du woraus ziehen?\n");
   if ( member( ({ "schwert aus halterung" }),str) != -1) 
  {
    write(BS("\n Du ruettelst an dem Schwert aber es sitzt ziemlich fest in der Halterung. Als "
           "Du mit aller Gewalt daran ziehst loest sich das Schwert ploetzlich, schmeisst Dich "
           "um und landet genau auf Dir.\n"));
    say( TPN+" faellt zu Boden und ein riesiges Schwert landet direkt darauf.\n");
    TP->SetProp(P_PARALYZED, ([
                PARALYZE_TIME: 15,
                PARALYZE_MSG: "Du liegst unter dem schweren Schwert und kannst Dich nicht ruehren.\n",
                PARALYZE_END: "Ploetzlich betritt eine Zentaurenwache den Raum, sieht Dich in Deiner "
                              "misslichen Lage. Der Zentaur lacht Dich aus, nimmt aber das Schwert "
                              "von Dir runter und murmelt etwas von Kinder kann man nicht alleine "
                              "lassen. Danach verlaesst er kopfschuettelnd den Raum.\n"
                              ]) );	
      call_out("fall1",4);
    return 1;
  }
 }
void fall1()
{
  write(BS( "Dir ist das unglaublich peinlich, das Schwert liegt auf Dir und Du kriegst es nicht mehr "
         "von Dir runter. Du bist einfach erbaermlich. Du rufst ganz eingeschuechtert nach Hilfe.\n"));
}  

 
   
