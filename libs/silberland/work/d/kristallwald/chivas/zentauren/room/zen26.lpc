// von Chivas
// 27.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int beeren_zahl;


void create()
	
{
  ::create();

  beeren_zahl=1;

  SetProp( P_INT_SHORT, "Im Park von Roch Adan");
  SetProp( P_INT_LONG,
	"Du bist im Westen des Parks. Es ist eine Mischung aus Rasenflaechen "
        "und Blumenbeeten zu sehen. Der Weg, der durch den Park fuehrt, "
        "ist mit Steinchen angelegt worden und fuehrt an der Hecke entlang, "
        "die den Park von der dahinterliegenden Strasse abtrennt. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( ({"boden"}), 
            "Am Boden siehst Du lauter Gras auf den Rasenflaechen und kleine Steinchen auf den Wegen. "
            "In den Beeten wachsen schoene Blumen.");

  AddDetail( ({"park","westen"}),
	    "Du befindest Dich im Westen des Parks von Roch Adan, direkt an der grossen Hecke, die den Park "
            "von der Strasse trennt. Hier gibt es grosse Rasenflaechen und Blumenbeete an den Wegen. "
            "Im Osten siehst Du eine kleine Erhoehung im Park und im Norden einen Brunnen.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren.");

  AddDetail( ({"mischung"}), 
            "Es ist eine Mischung von Beeten und Rasenflaechen.");

  AddDetail( ({"weg","wege","wegen"}), 
            "Die Wege schlaengeln sich durch den Park und sind mit kleinen Steinchen angelegt.");

  AddDetail( ({"rasenflaechen","rasen","flaechen","flaeche","rasenflaeche","ausruhen"}),
	    "Auf den frisch gemaehten Rasenflaechen waechst schoen gruenes Gras, was zum Ausruhen einlaedt.");

  AddDetail( ({"brunnen","norden"}),
	    "Um den Brunnen besser zu sehen, solltest Du naeher ran gehen."); 

  AddDetail( ({"steinchen","steine","kieselsteine"}),
	    "Ganz normale kleine Kieselsteine. Nichts besonderes."); 
  
  AddDetail( ({"hecke"}), 
            "Die Hecke umgibt anscheinend den gesamten Park. Ihre Blaetter sind so "
            "dicht, dass Du die Strasse nicht sehen kannst. Direkt an der Hecke siehst "
            "Du einen kleinen Strauch.");

  AddDetail( ({"strauch"}),
	    "An dem Strauch wachsen Heidelbeeren.");

  AddDetail( ({"heidelbeeren","beeren","heidelbeere","beere"}),
	    "Die Heidelbeeren sehen lecker aus. Vielleicht solltest Du welche pfluecken.");

  AddDetail( ({"strasse"}), 
            "Die Strasse kannst Du von hier aus nicht sehen. Die Strasse ist hinter der Hecke.");

  AddDetail( ({"erhoehung","parkmitte","mitte","osten"}),
	    "Die Erhoehung im Osten ist die Parkmitte. Du erkennst eine Statue auf einem Podest.");

  AddDetail( ({"statue","podest"}),
	    "Um die Statue und das Podest besser zu sehen, solltest Du schon hingehen."); 
  
  AddDetail( ({"gras"}), 
            "Das Gras ist kurz gemaeht. Ab und zu sieht man ein Gaensebluemchen.");

  AddDetail( ({"blaetter"}),
	    "Die Blaetter der Hecke sind so dicht, dass Du nicht die Strasse sehen kannst.");

  AddDetail( ({"blumenbeeten","blumenbeete","beete","beeten","rand"}),
	    "In den Blumenbeeten am Rand der Wege wachsen sehr schoene und viele Blumen.");

  AddDetail( ({"blumen"}), 
            "In den Beeten wachsen Veilchen, Rosen und Tulpen.");

  AddDetail( ({"rosen","zuechtung"}),
	    "Die Rosen sind wunderschoen, sie sehen wie eine neue Zuechtung der Zentauren aus.");

  AddDetail( ({"veilchen"}),
	    "Die blauen Veilchen sind sehr schoen."); 
  
  AddDetail( ({"tulpen"}), 
            "Ein paar Tulpen wachsen in den Beeten. Sie sind blau und gelb, aber nicht sehr "
            "interessant.");

  AddDetail( ({"gaensebluemchen","bluemchen"}),
	    "Auf dem Rasen wachsen ein paar kleine Gaensebluemchen. Aber Du willst sie nicht "
            "pfluecken, da sie so schoen aussehen und es schade waere, wenn sie verwelken.");

  AddDetail( ({"wolken"}),
	    "Die Wolken ziehen langsam am Himmel entlang."); 
  
  AddDetail( ({"sonne"}), 
            "Die Sonne steht fast senkrecht am Himmel und waermt Dich angenehm.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ueber Dir ist blau, bis auf ein paar Wolken, die jedoch nicht die Sonne verdecken.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland.");

  AddDetail( ({"bienen","luft"}),
	    "Ein paar Bienen summen durch die Luft.");

  AddDetail( ({"geschoepfe"}), 
            "Es gibt viele magische Geschoepfe im Silberland.");

  AddDetail( ({"zentaur","zentauren","kopf","huefte","menschen","pferdekoerper","zukunft","bewegungen","planeten"}),
	    "Zentauren sind magische Geschoepfe, vom Kopf bis zur Huefte Menschen, "
            "darunter jedoch mit Pferdekoerper und -beinen versehen. Man erzaehlt "
            "sich ueber sie, dass sie die Zukunft in den Bewegungen der Planeten "
            "am Himmel lesen koennen. ");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

 
  AddSmell(DEFAULT_SMELL, "Du riechst die Blumen in den Beeten.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen riechen angenehm suesslich.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Bienen, die durch die Luft schwirren.");

  AddSound( ({"bienen","summ"}),
	   "SUMM SUMM SUMM SUMM SUMM SUMM SUMM SUMM");

//-----Details Ende-----

AddExit("sueden", ROOM "zen21");  
AddExit("ostoben", ROOM "zen27");
AddExit("norden", ROOM "zen31");

AddCmd( ({"pfluecke","pflueck" }), "cmd_pfluecken" );

}
int cmd_pfluecken(string str)
{
  object heidelbeere;
  notify_fail( "Was moechtest Du pfluecken ?\n" );
  if ( member( ({ "beere", "heidelbeere","beeren","heidelbeeren" }), str ) != -1 ) 

   {
     if( beeren_zahl < 1 )
     {
        write("Du findest momentan keine Beere die sich lohnt zu pfluecken.\n");
        say(sprintf("%s will doch keine Beeren pfluecken.\n", TP->Name(WER)));
        return -1;
     }
      if ( present("heidelbeere",TP) )
      {
      write("Da Du bereits eine Heidelbeere hast, brauchst Du nicht "
      +"mehr zu pfluecken.\n" );
      say(sprintf("%s hat genug Beeren gepflueckt.\n", TP->Name(WER)));
      return -1;
      }
      else
      {
        {heidelbeere = clone_object( OBJ "heidelbeere");
        if ( ME_TOO_HEAVY == heidelbeere->move(TP,M_GET|M_SILENT) )

          {
          write(
          "Die Heidelbeere wuerde Dir zu schwer werden. Du Weichei!\n" );
          say(BS(sprintf("%s probiert eine Heidelbeere zu pfluecken, "
                         "die"+TP->QueryPronoun(WEM)+"jedoch "
                         "zu schwer ist.\n", TP->Name(WER))));
          heidelbeere -> remove();
          return 1;
          }
          else
          {
          write("Du pflueckst eine Heidelbeere und steckst sie sofort "
                "ein.\n");
          say(sprintf("%s pflueckst eine Heidelbeere.\n",
          TP->Name(WER)));
          beeren_zahl--;
          return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}
