// von Chivas
// 25.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einer Strasse in Roch Adan");
  SetProp( P_INT_LONG,
	"Du befindest Dich auf einer Strasse in Roch Adan, die zwischen den Baumriesen "
	"vom Haupttor im Sueden oestlich zum Palast der Zentauren im Norden fuehrt. "
	"Westlich befindet sich eine gepflegte Hecke, die die Strasse vom dahinterliegenden Park abtrennt. "
        "Im Osten ist eine alte Baumhoehle in der wohl seit Jahren keiner mehr wohnt. Die Strasse "
        "ist mit Gras bedeckt. Ab und zu erkennt man ein paar Hufabdruecke, aber auch Spuren von anderen Lebewesen. ");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----


  AddDetail( ({"strasse"}), 
            "Die Strasse fuehrt von Nordwesten nach Sueden oestlich am Park " 
            "vorbei.");

  AddDetail( ({"boden"}),
	    "Der Boden der Strasse ist mit Gras und Steinchen bedeckt. Auch einige Hufabdruecke und Spuren von "
            "anderen Lebewesen kann man sehen.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren. Du stehst auf einer Strasse mitten in der Stadt.");

  AddDetail( ({"baumriesen","riesen"}), 
            "Oestlich von Dir sind lauter Baumriesen, in denen die Zentauren wohnen und arbeiten. Genau im Osten "
            "ist eine alte Baumhoehle, wo sicher seit Jahren keiner mehr wohnt.");

  AddDetail( ({"haupttor","sueden","tor"}),
	    "Das Haupttor ist weit im Sueden und Du kannst es von hier nicht sehen.");

  AddDetail( ({"palast","norden"}),
	    "Um zum Palast zu kommen musst Du noch weiter nach Norden gehen."); 
  
  AddDetail( ({"zentauren","wesen","mensch","pferd"}), 
            "Die Zentauren sind interessante Wesen. Sie sind halb Mensch und halb Pferd.");

  AddDetail( ({"hecke","westen","moeglichkeiten"}),
	    "Die Hecke im Westen umgibt den gesamten Park, der sich in der Mitte von Roch Adan befinden. Die "
            "Hecke ist dicht und es gibt keinerlei Moeglichkeiten sie zu ueberwinden.");

  AddDetail( ({"park","mitte"}),
	    "Der Park befindet sich in der Mitte der Stadt. Momentan kannst Du ihn leider nicht sehen, "
            "da er von der grossen Hecke umgeben ist. Du solltest aber spaeter einmal hingehen und ihn Dir "
            "ansehen. Er soll wunderschoen sein.");

  AddDetail( ({"baumhoehle","jahren","zeiten"}), 
            "Die Baumhoehle im Osten ist seit Jahren nicht mehr bewohnt. Die Fenster sind schmutzig und die Tuer "
            "ist uralt und hat auch schon bessere Zeiten gesehen.");

  AddDetail( ({"tuer","scharniere"}),
	    "Die alte hoelzerne Tuer kann man momentan nicht oeffnen, da die Scharniere eingerostet sind. "
            "Vielleicht geht es spaeter einmal, wenn ein Magier sich bequemt die Scharniere zu oelen.");

  AddDetail( ({"gras"}),
	    "Das Gras auf der Strasse ist ein wenig niedergetrampelt, was jedoch kein Wunder ist da sehr viele "
            "Leute die Strasse benutzen."); 
  
  AddDetail( ({"hufabdruecke","abdruecke"}), 
            "Die Hufabdruecke stammen sicher von den Zentauren.");

  AddDetail( ({"spuren","lebewesen","abenteurern"}),
	    "Die Spuren stammen von Abenteurern wie Dir.");

  AddDetail( ({"steinchen"}),
	    "Ein paar normale Steinchen liegen auf der Strasse zwischen dem Gras. Es ist nichts besonderes.");

  AddDetail( ({"himmel"}), 
            "Der Himmel ist blau und die Sonne steht fast senkrecht am Himmel. Ein paar Wolken ziehen langsam vorbei.");

  AddDetail( ({"sonne"}),
	    "Die Sonne strahlt und waermt Dich angenehm.");

  AddDetail( ({"wolken","regen"}),
	    "Die Wolken sind weiss und es sieht nicht so aus als ob es Regen geben wuerde."); 
  
  AddDetail( ({"fenster"}), 
            "Die Fenster sind sehr verdreckt, so dass Du nicht durch sie hindurch schauen kannst.");

  AddDetail( ({"magier","haufen"}),
	    "Magier sind ein seltsamer Haufen und Dir ein wenig suspekt.");

  AddDetail( ({"wunder"}),
	    "Wunder gibt es im Silberland sehr viele.");

  AddDetail( ({"leute","personen"}), 
            "Man kann auch Personen sagen.");

  AddDetail( ({"markt","waren","nordwesten"}), 
            "Im Nordwesten ist der Markt von Roch Adan. Du solltest hingehen und ihn Dir genauer anschauen..");

  AddDetail( ({"silberland"}),
	    "Du befindest Dich im Silberland und Du findest es super hier.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");


  AddSmell(DEFAULT_SMELL, "Du riechst die Waren, die auf dem Markt im Nordwesten angeboten werden. ");  
 
  AddSmell( ({"waren"}),
	   "Es riecht suesslich bis bitter. Du solltest auf den Markt gehen und die Waren naeher untersuchen.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Geschrei der Haendler, die im Nordwesten ihre Waren auf dem Markt anpreisen.");

  AddSound( ({"geschrei","haendler"}),
	   "Du kannst es nicht genau verstehen. Ab und zu hoerst Du nur ein 'sehr billig' oder ein 'nur vom besten'.");
  
//-----Details Ende-----

AddExit("sueden", ROOM "zen29");  
AddExit("nordwesten", ROOM "zen37");

}  
   
