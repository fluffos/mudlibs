// von Chivas
// 09.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>
#include <defines.h>
#include  <moving.h>

int fackel_zahl; 

int raupeda;

void create()
	
{
  ::create();

   fackel_zahl=1;
   raupeda=1; 

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Wald ist sehr dicht. Es fallen jedoch viele Lichtstrahlen aus dem "
	"Norden herein, wo die Anzahl der Baeume abzunehmen scheint. Im Sueden "
        "ist der Weg einfach nur als finster zu bezeichnen. Wenn Du den Weg "
        "waehlen solltest, waere sicher etwas Licht hilfreich. Vielleicht "
        "findest Du ja Etwas, um den Weg im Sueden zu erhellen. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden","erde", "waldweg", "weg","nadeln"}), 
            "Der Boden ist erdig wie ein normaler Waldweg. Am Wegrand stehen "
            "einige Straeucher und Baeume und ein alter abgestorbener "
            "Baumstamm. Zweige und Nadeln sind am Boden zwischen dem Gras "
            "liegen geblieben, nachdem sie von den Baeumen gefallen sind.");

  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand sind einige Straeucher, Baeume und ein abgestorbener "
            "Baumstamm. ");

  AddDetail( ({"anzahl"}),
	    "Im Norden nimmt die Anzahl der Baeume ab.");
  
  AddDetail( ({"baumstamm"}),
	    "Der Baumstamm ist uralt und knochig. Ein Astloch faellt Dir auf. ");

  AddDetail( ({"astloch"}),
	    "Das Astloch ist ziemlich tief und Du kannst nichts erkennen. "
            "Vielleicht solltest Du mal rein greifen? ");

  AddDetail( ({"baeume","baeumen"}),
	    "Am Wegrand befinden sich verschiedene Baeume, wie Kiefern und "
            "Tannen. Ein abgestorbener Baumstamm faellt Dir besonders auf. ");

  AddDetail( ({"baum"}),
	    "An den Baeumen faellt Dir eigentlich nichts auf.");

  AddDetail( ({"blaetter","blaetterdach","dach"}),
	    "Die Blaetter bilden ein dichtes Dach, so dass kaum ein "
            "Lichtstrahl den Boden trifft. Waere der Wald im Norden nicht "
            "lichter, waere es stockfinster hier. Am Blatt eines Strauches "
            "scheint Dir etwas aufzufallen.");
  
  AddDetail( ({"holz"}),
	    "Baeume bestehen aus Holz. Dumme Frage!");

  AddDetail( ({"wald","waldes","ansammlung"}),
	    "Ein Wald ist eine Ansammlung von Baeumen.");

  AddDetail( ({"gras"}),
	    "Ganz normales Gras, mit ein paar Steinen gespickt. ");

  AddDetail( ({"zweige","zweig"}),
	    "Sie liegen auf dem Waldweg und sind wohl von den Baeumen "
            "heruntergefallen. ");

  AddDetail( ({"aeste","ast"}),
	    "Die Aeste wiegen sich leicht im Wind. ");

  AddDetail( ({"wind"}),
	    "Die Aeste wiegen sich leicht im Wind, aber lauschen waere sicher "
            "sinnvoller. ");

  AddDetail( ({"buesche","bueschen"}),
	    "Ganz normale Buesche, die es in jedem Wald gibt. Obwohl, ein "
            "Busch ist doch interessant. ");

  AddDetail( ({"straeucher","straeuchern","strauches"}),
	    "Uninteressant, Du beachtest sie nicht weiter.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddDetail( ({"etwas"}),
	    "Das waere ja ein wenig zu einfach.");

  AddDetail( ({"busch"}),
	    "Ein Busch sieht anders aus als die anderen. Er besitzt kaum noch "
            "Blaetter. An der Unterseite, an einem der uebrig gebliebenen "
            "Blaetter, scheint sich irgendetwas zu bewegen. Du koenntest "
            "versuchen das Blatt herum zudrehen.");

  AddSpecialDetail( ({ "blatt"}),"detailBlatt" );

  AddDetail( ({"wunder"}),
	    "Wunder gibt es immer wieder, z.B. dass Du Dich noch nicht zu "
            "Tode geforscht hast.");

  AddDetail( ({"kiefer","kiefern"}),
	    "Du siehst eigentlich nichts interessantes. Die Rinde einer "
            "Kiefer sieht aber merkwuerdig aus.");

  AddDetail( ({"tanne","tannen"}),
	    "Das sind ganz normale Tannen, wie sie in einem anstaendigen Wald "
            "wachsen.");

  AddDetail( ({"risse","furchen"}),
	    "Die Risse sind tiefe Furchen. Anscheinend hat hier ein Baer "
            "seine Krallen geschaerft.");
  
  AddDetail( ({"stamm"}),
	    "Alle Baeume haben einen Stamm. Dir faellt ein abgestorbener "
            "Baumstamm auf und die Rinde einer Kiefer.");

  AddDetail( ({"rinde"}),
	    "Die Rinde einer Kiefer hat merkwuerdige Risse. ");

  AddDetail( ({"baer","krallen"}),
	    "An der Rinde einer Kiefer hat ein Baer seine Krallen geschaerft. "
            "Sei froh, dass er weg ist, ansonsten haette er sie vielleicht "
            "gleich an Dir ausprobiert.");

  AddDetail( ({"steine","steinen"}),
	    "Einige Steine liegen im Gras. Ein Stein gefaellt Dir.");

  AddDetail( ({"stein"}),
	    "Der Stein glitzert, wenn ein Sonnenstrahl ihn trifft. Ansonsten "
            "ist an ihm nichts aussergewoehnlich.");

  AddDetail( ({"lichtstrahl","lichtstrahlen","sonnenstrahl","teil","himmel","licht"}),
	    "Von Norden, wo die Baeume abnehmen, fallen viele Lichtstrahlen "
            "in diesen Teil des Waldes. Der Himmel ist nur im Norden etwas zu "
            "sehen.");

  AddDetail( ({"schmetterling"}),
	    "Wenn sich die Raupe verpuppt, wird sicher ein Schmetterling aus "
            "ihr. Er ist ein weiterer idealer Gegner fuer Dich, der Dich dazu "
            "bringen wird, Deine Grenzen neu zu definieren.");

  AddSmell(DEFAULT_SMELL, "Du riechst die Baeume, das Gras am Boden und auch "
                          "klare Luft.");  
 
  AddSmell( ({"baeume","baum"}),
	   "Sie duften nach Kiefern und Tannen.");

  AddSmell( ({"luft"}),
	   "Du schnupperst an der klaren Luft und fuehlst Dich frei.");
  
  AddSmell( ({"kiefer","kiefern"}),
	   "Sie riechen wie echte Kiefern. Kaum zu glauben.");

  AddSmell( ({"tanne","tannen","duft","geruchssinn","unterschied"}),
	   "Haettest Du nicht einen so ausgepraegten Geruchssinn, wuerdest Du "
           "keinen Unterschied zu dem Duft der Kiefern riechen, aber so. ");

  AddSound(DEFAULT_SOUND, "Der Wind weht nur ganz leicht durch "
	   "das Blaetterdach, trotzdem hoerst Du ein leichtes Rascheln.");

  AddSound( ({"wind"}),
	   "Du kannst ihn kaum hoeren, er bringt nur die Blaetter leicht zum "
           "Rascheln.");
  
  AddSound( ({"blaetter","rascheln"}),
	   "Die Blaetter bewegen sich leicht im Wind, so dass sie rascheln!");

//-----Details Ende-----
  
AddExit("sueden", ROOM "zen11");
AddExit("norden", ROOM "zen13");


AddCmd( ({"greifen", "greife","greif" }), "greifen" );
AddCmd( ({"dreh", "drehe" }), "drehen" );

}

string detailBlatt()
{
  if (!present("CHIVASRAUPE",TO))
    return(BS("Vielleicht solltest Du das Blatt umdrehen.\n"));
  return("Du musst Dich wohl getaeuscht haben, hier ist Nichts.\n");
}
void reset()
{
  ::reset();
  raupeda=1;
}

int drehen (string str)
{
  object raupe;
  notify_fail ("Was moechtest Du umdrehen?\n");

  if(!str) return 0;
  
  if(!(str == "blatt","blatt um" )) return 0;
  if (present("CHIVASRAUPE",TO) || !raupeda)

  {
    write(BS("Du kannst gerade nichts erkennen."));
    return -1;
  }
  write(BS("Du drehst das Blatt um und eine Raupe erscheint.\n"));
  raupeda=0;
  raupe = clone_object (NPC "raupe" );
  raupe->move(TO,M_GO|M_NOCHECK,"krabbelt");
  return 1;
}

int greifen(string str)
{
  object fackel;
  notify_fail( "Wo moechtest Du hineingreifen?\n" );
  if ( member( ({ "in astloch", "astloch", "in loch", "in loch rein", "in astloch rein"}), str ) != -1 ) 

   {
     if( fackel_zahl < 1 )
     {
        write("Du greifst in das Astloch, findest aber nichts.\n");
        say(sprintf("%s greift in ein Astloch.\n", TP->Name(WER)));
        return -1;
     }
      if ( present("fackel",TP) )
      {
      write("Da Du bereits eine Fackel hast, brauchst Du nicht mehr zu "
            "greifen.\n" );
      say(sprintf("%s sucht krankhaft nach weiteren Sachen im Astloch.\n", TP->Name(WER)));
      return -1;
      }
      else
      {
        {fackel = clone_object(  "/obj/fackel");
        if ( ME_TOO_HEAVY == fackel->move(TP,M_GET|M_SILENT) )
 
          {
          write(
          "Die Fackel wuerde Dir zu schwer werden.\n" );
          say(BS(sprintf("%s greift in das Astloch, scheint aber vom Gepaeck "
          "behindert zu werden.\n", TP->Name(WER))));
          fackel -> remove();
          return 1;
          }
          else
          {
          write("Du greifst in das Astloch und findest eine Papierfackel, "
                "die Du sofort einsteckst.\n");
          say(sprintf("%s greift in ein Astloch und steckt etwas ein.\n",
          TP->Name(WER)));
          fackel_zahl--;
          return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}
