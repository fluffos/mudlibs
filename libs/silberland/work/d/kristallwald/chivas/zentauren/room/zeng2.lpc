inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>


void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einem kleinen Platz");
  SetProp( P_INT_LONG,
	"Du befindest Dich auf einem kleinen Platz im Westen von Roch Adan. In der Mitte "
	"des kleinen Platzes ist ein kleiner Brunnen, der von ein paar Straeuchern "
	"gesaeumt wird. Im Sueden des Platzes befindet sich in einer Baumhoehle die Post. "
	"Im Osten scheint der Tempel von Roch Adan zu sein und im Nordwesten "
	"liegt die grosse Bibliothek der Zentauren.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( ({"platz","platzes"}),
	    "Du befindest Dich auf einem kleinen Platz im Westen von Roch Adan. In der Mitte "
            "befindet sich ein kleiner Brunnen.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Dies ist die Stadt der Zentauren. Dir gefaellt es hier sehr gut.");

  AddDetail( ({"baumriesen","riesen","baeume"}), 
            "In den Baumriesen arbeiten und wohnen die Zentauren. Die Baeume sind riesig. "
            "Sie sind die groessten im ganzen Silberland.");

  AddDetail( ({"baumhoehle","sueden","post"}),
	    "In dem Baumriesen im Sueden befindet sich die koenigliche Post der Zentauren. "
            "Du kannst dort deine Post abholen.");

  AddDetail( ({"mitte"}),
	    "In der Mitte des Platzes ist ein kleiner Brunnen und ein paar Straeucher."); 

  AddDetail( ({"gaertner"}),
	    "Den Gaertner siehst Du momentan nicht. Er ist sicher im grossen Park beschaeftigt."); 

  AddDetail( ({"park"}),
	    "Da solltest Du unbedingt einmal hingehen."); 
  
  AddDetail( ({"zentauren","wesen","oberkoerper","rest","pferdes"}), 
            "Die Zentauren sind stolze Wesen. Ihr Oberkoerper ist menschlich und der Rest eines Pferdes.");

  AddDetail( ({"brunnen"}),
	    "Der Brunnen wurde aus Steinen gebaut. Er scheint recht tief zu sein. Am "
            "Brunnen ist ausserdem ein Gestell befestigt.");

  AddDetail( ({"straeucher","straeuchern"}),
	    "Um den Brunnen herum stehen einige kleine Straeucher. Sie sehen gut "
            "gepflegt aus, als ob ein Gaertner sie erst vor kurzem gestutzt hat.");

  AddDetail( ({"boden"}), 
            "Der Boden auf dem ist mit Pflastersteinen ausgelegt.");

  AddDetail( ({"tempel","osten"}),
	    "Der Tempel der Zentauren ist im Osten, vielleicht solltest Du ihn mal "
            "besuchen.");

  AddDetail( ({"bibliothek"}),
	    "Die Bibliothek der Zentauren ist im Nordwesten. Besuch sie einmal und "
            "bilde Dich ein wenig."); 
  
  AddDetail( ({"pflaster","steine","pflastersteine"}), 
            "Die Pflastersteine sind sauber verlegt und man kann nur sehr kleine "
            "Fugen zwischen ihnen erkennen.");

  AddDetail( ({"fugen"}),
	    "In den Fugen zwischen den Pflastersteinen waechst ein wenig Gras.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau und die Wolken ziehen langsam vorbei. Ein "
            "paar Voegel ziehen ihre Kreise.");

  AddDetail( ({"wolken"}), 
            "Die Wolken ziehen langsam am Himmel entlang, verdecken aber nicht die Sonne.");

  AddDetail( ({"sonne"}),
	    "Die Sonne waermt Dich sehr und Du fuehlst Dich wohl.");

  AddDetail( ({"voegel","kreise"}),
	    "Ein paar Voegel ziehen am Himmel ihre Kreise. Sie sind jedoch zu hoch "
            "um genau zu erkennen um was fuer Voegel es sich handelt."); 
  
  AddDetail( ({"gras"}), 
            "In den Fugen zwischen dem Pflaster befindet sich ein wenig Gras, "
            "aber nicht sehr interessant.");

  AddDetail( ({"kurbel"}),
	    "Mit der Kurbel kannst Du den Eimer in den Brunnen herunter lassen.");

  AddDetail( ({"gestell","holz"}),
	    "Das Gestell besteht aus Holz und ein Seil mit einem Eimer ist an ihm befestigt.");

  AddDetail( ({"seil","eimer"}),
	    "Du erkennst auf einmal, dass Du das Seil und den Eimer mit einer Kurbel am "
            "Gestell herunter lassen kannst.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland und fuehlst Dich wohl hier.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");


  AddSmell(DEFAULT_SMELL, "Du riechst die klare Luft und fuehlst Dich gut.");  
 
  AddSmell( ({"luft","fruehling"}),
	   "Die Luft ist sehr warm und riecht nach Fruehling.");

  AddSound(DEFAULT_SOUND, "Du hoerst den ueblichen Stadtlaerm.");

  AddSound( ({"stadtlaerm","laerm","beschaeftigungen","abenteurer"}),
	   "Du hoerst die Zentauren, wie sie ihren Beschaeftigungen nachgehen und wie andere Abenteurer "
           "die Stadt erkunden.");

//-----Details Ende-----
AddItem(NPC "zentaurm3", REFRESH_DESTRUCT);

AddExit("sueden", ROOM "zenpost");  
AddExit("osten", ROOM "zentemp");
AddExit("norden", ROOM "zeng3");
AddExit("nordwesten", ROOM "zenbib");
AddExit("suedosten", ROOM "zeng1");
AddExit("westen", ROOM "zennpcb");
AddExit("nordosten", ROOM "zengef");


AddCmd( ({"lass", "lasse" }), "lassen" );

}
int lassen(string str)
{
   notify_fail("Was moechtest Du womit runter lassen?\n");
   if ( member( ({ "eimer mit kurbel runter", "eimer mit kurbel herunter","eimer herunter" }),str) != -1) 
  {
    write(BS("\n Du laesst den Eimer mit der Kurbel herunter und ziehst den Eimer voller Erwartung "
           "wieder herauf. Als Du in den Eimer schaust siehst Du ploetzlich einen kleinen Wasserkobold "
           "im Eimer sitzen, der Dich beschimpft und Dir mit einem kleinen Fisch eine Ohrfeige "
           "verpasst, so dass Du nur noch Sterne siehst..\n"));
    say( TPN+" kriegt von etwas im Eimer eine Ohrfeige, so dass er ohnmaechtig zu Boden kracht.\n");
    TP->SetProp(P_PARALYZED, ([
                PARALYZE_TIME: 10,
                PARALYZE_MSG: "Du bist gerade ohnmaechtig und kannst nichts tun. Wie peinlich von einem "
                              "kleinen Kobold niedergeschlagen zu werden.\n",
                PARALYZE_END: "Als Du zu Dir kommst, siehst Du noch wie der kleine Wasserkobold boese "
                              "schimpfend zurueck in den Brunnen springt.\n"
                              ]) );	
      call_out("fall1",4);
    return 1;
  }
 }
void fall1()
{
  write(BS( "Du fliegst von dem Schlag getroffen auf den harten Boden des Platzes und "
         "Dir schwinden die Sinne. Dein Kopf droehnt und Dir wird schwarz vor Augen.\n"));
}  

