// von Elro
// 09.3.2004
// 
// Raum meines Gesellenstueckes "Stadtweg - zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Park von Roch Adan");
  SetProp( P_INT_LONG,
	"Du befindest Dich im Park von Roch Adan, ein schoener Park, in dem man sich "
        "schoen erholen und Ruhe finden kann, da die Hecke, die rund um den Park fuehrt, " 
        "den Laerm der Strassen zurueckhaelt. Der Weg, der durch den Park fuehrt, ist mit "
        "kleinen Steinchen angelegt worden und fuehrt in verschiedene Richtungen. Im "
        "Norden verlaesst man den Park Richtung Marktplatz." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----


  AddDetail( ({"park","stadtpark"}), 
            "Der Park ist sehr schoen. Die Rasenflaechen und die Wege sind sehr gepflegt. Ausserdem siehst "
            "Du ein paar Blumen, die sauber in Beete am Rand des Weges gepflanzt sind.");

  AddDetail( ({"roch","adan","roch adan","stadt","mitte"}),
	    "Roch Adan ist die Stadt der Zentauren. Momentan bist Du im Stadtpark von Roch Adan, "
            "der sich in der Mitte der Stadt befindet.");

  AddDetail( ({"ruhe","friede","frieden"}),
	    "Hier im Park kannst Du wirklich Ruhe und Frieden finden. Es ist sehr erholsam hier spazieren "
            "zu gehen. Die Hecke haelt den Laerm der Strassen vom Park fern.");

  AddDetail( ({"hecke"}), 
            "Die Hecke umgibt den gesamten Park und trennt die Strassen vom Park in der Mitte von Roch Adan.");

  AddDetail( ({"laerm","strassen","krach"}),
	    "Vom Laerm auf den Strassen hoerst Du hier kaum etwas, da die grosse Hecke, die den Park umschliesst, "
            "den Krach vom Park fern zu halten scheint.");

  AddDetail( ({"weg","wege","weges","wegen"}),
	    "Die Wege sind sehr gepflegt und bestehen aus kleinen Steinchen. Nach Norden verlaesst man den Park "
            "wieder auf den Marktplatz. Nach Sueden kommt man zu einer kleinen Erhoehung im Park. Nach Westen und "
            "Osten fuehren weitere Wege. Am Rand der Wege sind Beete, in die ein Gaertner Blumen gepflanzt hat."); 
  
  AddDetail( ({"steinchen","steinen","unkraut","steine"}), 
            "Die kleinen Steinchen bilden die Wege im Park. Man kann keinerlei Unkraut zwischen den Steinen sehen. "
            "So einen sauberen Park hast Du selten gesehen.");

  AddDetail( ({"richtungen","richtung"}),
	    "Die Wege fuehren in alle Richtungen.");

  AddDetail( ({"norden","marktplatz","platz","markt"}),
	    "Im Norden verlaesst man den Park wieder. Dort befindet sich der Marktplatz auf dem die Haendler Waren "
            "aus allen Winkeln des Silberlandes verkaufen.");

  AddDetail( ({"sueden","erhoehung"}), 
            "Auf der Erhoehung im Sueden steht eine Statue.");

  AddDetail( ({"zentauren","mensch","oberkoerper","pferd","menschen","rest","pferdes"}), 
            "Die Zentauren sind halb Mensch und halb Pferd. Der Oberkoerper ist der eines Menschen und der Rest "
            "der eines Pferdes.");

  AddDetail( ({"statue"}),
	    "Um die Statue genauer zu untersuchen, musst Du schon hingehen.");

  AddDetail( ({"boden"}),
	    "Der Boden auf den Wegen ist mit Steinchen bedeckt. Ansonsten besteht er aus Rasenflaechen und Beeten "
            "in denen Blumen wachsen."); 
  
  AddDetail( ({"rasen","rasenflaechen","flaechen","gras"}), 
            "Die Rasenflaechen sind sehr gepflegt. Er scheint erst vor kurzem gemaeht worden zu sein.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau und die Wolken ziehen langsam dahin.");

  AddDetail( ({"sonne","tag"}),
	    "Die Sonne scheint und waermt Dich. Der Tag koennte gar nicht schoener sein.");

  AddDetail( ({"wolken"}), 
            "Die Wolken ziehe langsam am Himmel dahin. Sie sind weiss und verdecken nicht die Sonne, so dass es ein "
            "toller Tag ist.");

  AddDetail( ({"blumen"}),
	    "In den Beeten wachsen verschiedene Blumen. Leider kennst Du sie nicht. Es koennten vielleicht Rosen sein.");

  AddDetail( ({"rosen"}),
	    "Es handelt sich wirklich um Rosen, aber eine neue Zuechtung, wie "
            "Du sie noch nie gesehen hast.");

  AddDetail( ({"zuechtung"}),
	    "Die Rosen dieser Zuechtung scheinen sich zu bewegen und Dich anzuschauen. Wirklich faszinierend.");

  AddDetail( ({"rand","beete","gaertner","beeten","muehe","ordnung"}),
	    "Am Rand der Wege sind Beete angelegt worden, in denen Blumen wachsen. Die Gaertner hier im Park geben sich "
            "wirklich Muehe um alles in Ordnung zu halten."); 
  
  AddDetail( ({"osten","westen"}), 
            "Nach Osten und Westen fuehren die Wege weiter.");

  AddDetail( ({"winkeln","ecken"}),
	    "Man kann auch sagen, sie kommen aus allen Ecken des Silberlandes.");

  AddDetail( ({"silberland","silberlandes"}),
	    "Dies ist das Silberland. Du findest es cool hier.");

  AddDetail( ({"haendler","waren","sache","grund"}), 
            "Was die Haendler machen und was fuer Waren sie anbieten, kannst Du von hier aus nicht erkennen. Um der "
            "Sache auf den Grund zu gehen, musst Du schon hingehen.");

  AddSmell(DEFAULT_SMELL, "Du riechst das Gras und die Blumen hier im Park.");  
 
  AddSmell( ({"gras"}),
	   "Du riechst das frische Gras auf den frisch gemaehten Rasenflaechen.");

  AddSmell( ({"blumen"}),
	   "Die Blumen duften suesslich.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Bienen, die durch den Park fliegen.");

  AddSound( ({"bienen","summ"}),
	   "SUMM SUMM SUMM SUMM");
  
//-----Details Ende-----

AddExit("suedoben", ROOM "zen27");  
AddExit("osten", ROOM "zen33");
AddExit("westen", ROOM "zen31");  
AddExit("norden", ROOM "zen36");

}  
   
