// von Chivas
// 31.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>


void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Park von Roch Adan");
  SetProp( P_INT_LONG,
	"Dies ist die suedoestlichste Ecke des Parks, auch hier bluehen hunderte von "
        "Blumen in ordentlich gepflegten Beeten und Bienen summen durch die Luft. "
        "Ausserdem ist ein grosser Springbrunnen in der Naehe der Hecke gebaut worden, "
        "die den gesamten Park umgibt. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----


  AddDetail( ({"ecke","parks","park","wege","wegen"}), 
            "Du bist in der suedoestlichen Ecke des Parks von Roch Adan. Hier bluehen viele "
            "Blumen zwischen den Wegen. In der Naehe der Hecke siehst Du einen grossen Springbrunnen.");

  AddDetail( ({"blumen","teil"}),
	    "In diesem Teil des Parks wachsen hunderte von Blumen. Du siehst Rosen, Lilien, Tulpen und "
            "Veilchen. Ein paar Bienen schwirren um die Blumen und sammeln Nektar.");

  AddDetail( ({"beete","beeten"}),
	    "In den Beeten wachsen viele wunderschoene Blumen.");

  AddDetail( ({"bienen","nektar"}), 
            "Die Bienen sammeln den Nektar von den Blumen.");

  AddDetail( ({"luft"}),
	    "Die Luft ist schoen klar.");

  AddDetail( ({"springbrunnen","naehe","brunnen","brunnens"}),
	    "Der Springbrunnen steht in der Naehe der Hecke. Er besteht komplett aus Marmor. Aus der Mitte des "
            "Brunnens schiesst eine Fontaene ein paar Meter in die Luft."); 
  
  AddDetail( ({"hecke","richtung","sueden","stellen"}), 
            "Die Hecke umgibt den ganzen Park, bis auf die Stellen wo man den Park betreten oder verlassen "
            "kann. Hier kannst Du den Park Richtung Sueden zur Strasse verlassen. Ausserdem siehst Du in der Naehe "
            "der Hecke einen grossen Springbrunnen.");

  AddDetail( ({"rosen","zuechtung"}),
	    "Die Rosen sind besonders gross. Sie sind sicher eine eigene Zuechtung der Zentauren.");

  AddDetail( ({"lilien","gelb"}),
	    "Die Lilien bluehen in einem herrlichen Gelb.");

  AddDetail( ({"tulpen"}), 
            "Die Tulpen bluehen rot und gelb. Von den Tulpen gibt es hier so viele, dass Du sie nicht "
            "zaehlen kannst.");

  AddDetail( ({"veilchen"}),
	    "Die Veilchen sind blau und sehr zierlich, so dass sie kaum neben den anderen viel groesseren "
            "Blumen auffallen.");

  AddDetail( ({"wasser","wassers"}),
	    "Das Wasser ist klar und Du kannst den Grund des Brunnens sehen."); 
  
  AddDetail( ({"fontaene","hoehe","meter","mitte"}), 
            "Aus der Fontaene schiesst das Wasser ein paar Meter in die Hoehe.");

  AddDetail( ({"weg"}),
	    "Der Weg schlaengelt sich an der Hecke und an dem Brunnen vorbei. Ueber den Weg kannst Du den Park "
            "im Sueden verlassen.");

  AddDetail( ({"steinchen"}),
	    "Kleine Steinchen liegen auf dem Weg. Sehr sehr uninteressant.");

  AddDetail( ({"grund"}), 
            "Auf dem Grund des Brunnens siehst Du feinen Sand.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau, bis auf ein paar Wolken.");

  AddDetail( ({"sonne"}),
	    "Die Sonne steht fast senkrecht am Himmel und waermt Dich."); 
  
  AddDetail( ({"wolken"}), 
            "Ein paar Wolken sind am Himmel zu sehen, die jedoch nicht die Sonne verdecken.");

  AddDetail( ({"marmor"}),
	    "Der Marmor war bestimmt teuer. Wenn der Marmor nicht so schwer und der Brunnen so gross, "
            "wuerdest Du sicher gerne etwas von dem Marmor mitnehmen und verkaufen.");

  AddDetail( ({"boden"}),
	    "Du siehst kleine Steinchen auf dem Weg und die Blumen in den Beeten.");

  AddDetail( ({"sand","durst"}), 
            "Der Sand ist sehr fein. Wo Du so das Wasser betrachtest, hast Du ploetzlich Durst. Vielleicht "
            "solltest Du ein bisschen Wasser trinken.");

  AddDetail( ({"glitzern"}),
	    "Da glitzert Etwas im Wasser. Was das wohl ist?");

  AddDetail( ({"etwas","objekt"}),
	    "Vielleicht kannst Du das Objekt, das da im Wasser ist, mit Deinen "
	    "Haenden herausfischen."); 
  
  AddDetail( ({"kopf"}), 
            "Du hast auch einen, owohl Du ihn ja nicht oft benutzt.");

  AddDetail( ({"zukunft"}),
	    "Die Zukunft sieht sehr sehr schwarz fuer Dich aus.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren.");

  AddDetail( ({"strasse"}), 
            "Die Strasse geht um den ganzen Park. Du erreichst sie im Sueden.");

  AddDetail( ({"zentaur","zentauren","geschoepfe","huefte","menschen","pferdekoerper","bewegungen","planeten"}),
	    "Zentauren sind magische Geschoepfe, vom Kopf bis zur Huefte Menschen, "
            "darunter jedoch mit Pferdekoerper und -beinen versehen. Man erzaehlt "
            "sich ueber sie, dass sie die Zukunft in den Bewegungen der Planeten "
            "am Himmel lesen koennen. ");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");


  AddSmell(DEFAULT_SMELL, "Du riechst den Duft der Blumen.");  
 
  AddSmell( ({"duft","blumen"}),
	   "Die Blumen duften suess.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Plaetschern des Wassers.");

  AddSound( ({"wassers","plaetschern"}),
	   "Du hoerst wie das Wasser in den Brunnen plaetschert.");
  
//-----Details Ende-----
AddItem(NPC "zentaurk1", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "zen23",
          P_MNPC_AREA:({ROOM "zen13", ROOM "zen16", ROOM "zen17",
                          ROOM "zen18", ROOM "zen19", ROOM "zen20",
                          ROOM "zen21", ROOM "zen22", ROOM "zen23",
                          ROOM "zen24", ROOM "zen25", ROOM "zen26",
                          ROOM "zen27", ROOM "zen28", ROOM "zen29",
                          ROOM "zen30", ROOM "zen31", ROOM "zen32",
                          ROOM "zen33", ROOM "zen34", ROOM "zen35",
                          ROOM "zen36", ROOM "zen37", ROOM "zen43",
                          ROOM "zenladen",ROOM "zenschmied"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );

AddExit("sueden", ROOM "zen19");  
AddExit("westen", ROOM "zen22");
AddExit("norden", ROOM "zen28");

AddCmd( ({"trink", "trinke" }), "trinken" );
AddCmd( ({"fisch", "fische" }), "fischen" );

}
int trinken(string str)
{
   notify_fail("Was moechtest Du trinken?\n");
   if ( member( ({ "wasser", "wasser aus brunnen","aus brunnen" }),str) != -1) 
  {
    write( "Du trinkst einen Schluck Wasser und fuehlst Dich erfrischt. Als Du Dich wieder aufrichtest, "
           "siehst Du ein Glitzern im Wasser.\n");
    say( TPN+" trinkt einen Schluck Wasser aus dem Brunnen.\n");
    return 1;
  }
}
int fischen(string str)
{
 object linse3;
 notify_fail("Was willst Du womit wo raus fischen?\n");

 if(!str || str == "") return 0;
 if(!(str == "objekt" ||
      str == "etwas" ||
      str == "objekt aus wasser"||
      str == "objekt aus brunnen"||
      str == "etwas aus wasser" ||
      str == "etwas aus brunnen"||
      str == "objekt mit haenden aus wasser"||
      str == "objekt mit haenden aus brunnen"||
      str == "objekt mit haenden aus wasser heraus"||
      str == "objekt mit haenden aus brunnen heraus"||
      str == "objekt mit den haenden aus dem wasser"||
      str == "etwas mit haenden aus brunnen"||
      str == "etwas mit haenden aus wasser" )) return 0;
 

 if( str == "objekt mit haenden aus wasser" ||
     str == "objekt mit haenden aus brunnen"||
     str == "objekt mit haenden aus brunnen heraus"||
     str == "etwas mit haenden aus brunnen"||
     str == "objekt mit den haenden aus dem wasser"||
     str == "objekt mit haenden aus wasser heraus"||
     str == "etwas mit haenden aus wasser"){
    
  if(!present("astroinvis", TP) && !present("dragoninvis2", TP)){
	  
  write(BS("Du beugst Dich in den Brunnen und fischst eine Scherbe. Mist, haette ja auch was Tolles sein "
           "koennen. Du wirfst die Scherbe wieder in den Brunnen, so dass der naechste Forscher reinfaellt.\n"));
 
  say(TPN+" aergert sich.\n");
  return -1;
  }
  if(present("linse3", TP)){
	  
  write(BS("Du findest nur noch eine alte Scherbe und wirfst sie wieder in den Brunnen.\n"));
 
  say(TPN+" findet eine alte Scherbe und wirft sie wieder in den Brunnen.\n");
  return -1;
  }
  write(BS("Du beugst Dich tiefer in den Brunnen und fischst mit Deinen Haenden nach "
	  "dem Glitzern. Ploetzlich hast Du eine kleine Linse in der Hand, die Du sofort "
	  "einsteckst.\n"));
 
  say(TPN+" fischt mit den Haenden im Wasser rum und findet etwas.\n");
  clone_object(OBJ "linse3")->move(TP, M_NOCHECK);
  return 1;
 }
 if( str == "objekt" ||
     str == "etwas aus brunnen"||
     str == "objekt aus brunnen"||
     str == "etwas" ||
     str == "objekt aus wasser"||
     str == "etwas aus wasser"){
 
 write(BS("Womit willst Du denn fischen? Probier es doch mal mit den Haenden.\n"));

 say(TPN+" stellt sich dumm an.\n");
 return 1;
 }
}


