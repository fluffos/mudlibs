// von Elro
// 09.3.2004
// 
// Raum meines Gesellenstueckes "Stadtweg3 - zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>


void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einer Strasse in Roch Adan");
  SetProp( P_INT_LONG,
	"Du befindest Dich auf einer Strasse in Roch Adan, die zwischen den Baumriesen "
	"vom Haupttor im Sueden weiter durch die Stadt fuehrt. Im Norden befindet sich "
	"der Park der Stadt. Er sieht sehr gepflegt aus. Du kannst ihn im Norden und "
        "Nordosten betreten. Die Strasse auf der Du stehst ist mit Gras bewachsen. ");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----


  AddDetail( ({"strasse"}), 
            "Die Strasse ist mit Gras bedeckt. Auch ein paar Steine liegen im Gras.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren. Du findest die Stadt eigentlich sehr schoen.");

  AddDetail( ({"baumriesen","riesen"}),
	    "In den Baumriesen wohnen und arbeiten die Zentauren.");

  AddDetail( ({"haupttor","tor","sueden"}), 
            "Das Haupttor, durch das Du die Stadt betreten hast befindet sich im Sueden. Du kannst es "
            "zwischen den Baumriesen noch ein wenig sehen.");

  AddDetail( ({"boden"}),
	    "Der Boden der Strasse ist mit Gras bedeckt, was ein wenig niedergetrampelt ist. Auch ein "
            "paar Kieselsteine kannst Du sehen.");

  AddDetail( ({"himmel"}),
	    "Nur ein paar Wolken trueben den blauen Himmel. Die Sonne steht fast senkrecht und scheint auf "
            "Dich herab."); 
  
  AddDetail( ({"sonne"}), 
            "Die Sonne waermt Dich und Du fuehlst Dich gut.");

  AddDetail( ({"wolken","regen"}),
	    "Die Wolken sind schneeweiss und es sieht nicht nach Regen aus.");

  AddDetail( ({"norden","park","stadtpark","nordosten"}),
	    "Im Norden ist der Stadtpark von Roch Adan. Er ist sehr gepflegt und Du siehst grosse Rasenflaechen, "
            "Beete mit Blumen und die Wege, die durch den Park fuehren. ");

  AddDetail( ({"rasenflaechen","flaechen","rasen","ausruhen"}), 
            "Die grossen Rasenflaechen laden zum Ausruhen ein. Ein paar Leute machen ein Picknick und ein Gaertner "
            "maeht den Rasen.");

  AddDetail( ({"wege"}),
	    "Die Wege schlaengeln sich durch den Park und auf ihm siehst Du kleine Steinchen.");

  AddDetail( ({"steinchen"}),
	    "Ganz normale kleine Steinchen, soweit Du es von hier aus sehen kannst."); 
  
  AddDetail( ({"gras"}), 
            "Das Gras auf der Strasse ist ziemlich niedergetrampelt. Das Gras auf dem Rasen im Park sieht "
            "schoen gruen aus und wird gerade von einem Gaertner gemaeht.");

  AddDetail( ({"beete"}),
	    "In den Beeten im Park sind Blumen angepflanzt. Alles sieht sehr ordentlich und gepflegt aus.");

  AddDetail( ({"blumen"}),
	    "Was fuer Blumen es sind, kannst Du von hier aus nicht genau erkennen. Dafuer muesstest Du schon "
            "naeher ran gehen.");

  AddDetail( ({"leute"}), 
            "Einige Leute sitzen auf dem Rasen und machen anscheinend ein vergnuegliches Picknick.");

  AddDetail( ({"picknick"}),
	    "Was es beim Picknick alles gibt, kannst Du von hier aus nicht erkennen.");

  AddDetail( ({"gaertner"}),
	    "Der Gaertner maeht das Gras auf den Rasenflaechen mit einem komischen Geraet."); 
  
  AddDetail( ({"geraet"}), 
            "Um das Geraet zu untersuchen, musst Du schon naeher ran gehen.");

  AddDetail( ({"steine","kieselsteine"}),
	    "Ganz normale Kieselsteine, an denen nichts besonderes zu erkennen ist.");

  AddDetail( ({"zentauren","wesen","mensch","pferd"}),
	    "Die Zentauren sind interessante Wesen. Sie sind halb Mensch und halb Pferd.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");


  AddSmell(DEFAULT_SMELL, "Du riechst das frische Gras im Park.");  
 
  AddSmell( ({"gras"}),
	   "Das frisch gemaehte Gras riecht irgendwie nach Sommer.");

  AddSmell( ({"sommer"}),
	   "Sommer riecht irgendwie nach frisch gemaehtem Gras.");

  AddSound(DEFAULT_SOUND, "Du hoerst Lachen aus dem Park und wie ein paar Zentauren auf der Strasse entlang traben.");

  AddSound( ({"zentauren","pferde"}),
	   "Die Zentauren hoeren sich wie Pferde an, wenn sie gehen.");
  
  AddSound( ({"lachen"}),
	   "Das Lachen stammt sicher von den Leuten, die im Park ein Picknick veranstalten.");

//-----Details Ende-----

AddExit("sueden", ROOM "zen14");  
AddExit("osten", ROOM "zen18");
AddExit("nordosten", ROOM "zen22");
AddExit("nordwesten", ROOM "zen20");
AddExit("norden", ROOM "zen21");

}  
   
