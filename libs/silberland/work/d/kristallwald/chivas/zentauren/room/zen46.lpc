// von Elro
// 09.3.2004
// 
// Raum meines Gesellenstueckes "Weg11 - zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int geistda;

void create()
	
{
  ::create();

  geistda=1; 

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Du stehst nun genau vor dem Altar. So dicht vor ihm wirkt er noch "
        "unheimlicher als vorher. Eigentlich wirkt die ganze Umgebung viel "
        "bedrohlicher als vorhin, wo Du nur durch die Straeucher gespaeht "
        "hast. Es ist deutlich kuehler und es riecht nach Blut, Verwesung und "
        "Tod." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 0 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden"}), 
            "Am Boden siehst Du ein paar ekelige Wuermer kriechen. Du bist "
            "angewiedert.");

  AddDetail( ({"wuermer","anblick"}), 
            "Bei dem Anblick der Wuermer wird Dir schlecht.");

  AddDetail( ({"umgebung","geschmack"}), 
            "Die Umgebung entspricht nicht Deinem Geschmack.");

  AddDetail( ({"baeume","baeumen", "baum","stelle"}),
	    "Die Baeume an dieser Stelle des Waldes verdunkeln den Wald so "
            "sehr, dass man ohne Lichtquelle nichts erkennen wuerde. ");

   AddDetail( ({"blatt","blaetter","blaetterdach","dach","lichtstrahl","geflecht"}),
	    "Die Blaetter bilden ein dichtes Dach, so dass kein Lichtstrahl "
	    "den Boden trifft.");

  AddDetail( ({"licht","verhaeltnisse","lichtverhaeltnisse","himmel"}),
	    "Es ist absolut finster, kein Licht dringt durch das dichte "
	    "Blaetterdach. Der Himmel ist natuerlich nicht zu sehen, "
            "ansonsten waere es auch nicht so dunkel.");

  AddDetail( ({"wald","waldes","ansammlung"}),
	    "Ein Wald ist eine Ansammlung von Baeumen.");

  AddDetail( ({"dunkelheit","finsternis","hilfsmittel","lichtquelle"}),
	    "Es ist so dunkel, ohne Hilfsmittel wuerde man nichts sehen "
            "koennen.");

  AddDetail( ({"straeucher","straeuchern"}),
	    "Straeucher in dieser Finsternis. Was es nicht alles gibt.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddDetail( ({"etwas","art"}),
	    "Es scheint eine Art Gestalt zu sein.");

  AddDetail( ({"spuren","schleifspuren"}),
	    "Die Schleifspuren fuehren Richtung Straeucher, vielleicht "
            "solltest Du mal durch die "
            "Straeucher spaehen.");

  AddDetail( ({"altar"}),
	    "Der Altar scheint aus Granit zu sein und uralt. Du kannst nur "
            "erahnen, was hier fuer graeuliche Sachen im Dunkeln geschehen "
            "sind. Am Altar scheinen noch einige Blutspritzer zu kleben. "
            "Verzierungen sind an den Seiten des Altars zu erkennen, dahinter "
            "liegt alles in Schatten.");

  AddDetail( ({"blut","blutspritzer","wesen"}),
	    "Das Blut muss von einem armen Wesen sein, das hier geopfert "
            "wurde.");

  AddDetail( ({"knochen"}),
	    "Hier liegen vereinzelt Knochen rum, anscheinend wurden die "
            "Geopferten einfach hier "
            "liegen gelassen und von Tieren abgenagt.");

  AddDetail( ({"symbole","furcht"}),
	    "Die Symbole verstehst Du nicht, trotzdem floessen sie Dir "
            "irgendwie Furcht ein.");

  AddDetail( ({"schriftzeichen"}),
	    "Du koenntest versuchen sie zu lesen.");

  AddDetail( ({"granit","material"}),
	    "Der Altar besteht aus Granit. Einem wirklich harten Material.");

  AddDetail( ({"verzierungen","wirklichkeit"}),
	    "Die Verzierungen sind in Wirklichkeit Symbole und "
            "Schriftzeichen.");

  AddDetail( ({"gestalt"}),
	    "Vielleicht kannst Du die Gestalt aufscheuchen?");

  AddDetail( ({"verwesung"}),
	    "Du kannst die Verwesung riechen.");

  AddDetail( ({"schatten"}),
	    "Der Schatten ist wirklich beunruhigend. Hat sich da Etwas "
            "bewegt?");

  AddDetail( ({"sachen","alptraeume"}),
	    "Das willst Du gar nicht wissen, dann bekommst Du nur Alptraeume.");

  AddDetail( ({"dunkeln"}),
	    "Es ist wirklich duester, wenn Du keine Lichtquelle bei Dir "
            "haettest, wuerdest Du "
            "gar nichts erkennen.");

  AddDetail( ({"seiten","seite"}),
	    "An den Seiten des Altars sind Verzierungen.");
  
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blut, Verwesung und Tod. ");  
 
  AddSmell( ({"blut"}),
	   "Dir wird irgendwie schlecht.");

  AddSmell( ({"verwesung"}),
	   "Es stinkt fuerchterlich.");

  AddSmell( ({"tod","zeichen"}),
	   "Das ist kein gutes Zeichen!!!!");

  AddSound(DEFAULT_SOUND, "Hier ist es totenstill.");

  AddSound( ({"totenstill"}),
	   "Du moechtest das nicht wirklich mal hoeren.");

  AddReadDetail( ({"schriftzeichen"}),
		"Sie sind in einer Dir unbekannten Sprache. Du liest folgendes und verstehst "
                "es nicht:\n"
                "TOT DLAB UD TSIB ,TSEIL SEID UD NNEW");
  
//-----Details Ende-----

AddExit("osten", ROOM "zen10");  

AddCmd( ({"scheuch","scheuche" }), "scheuchen" );

}
void reset()
{
  ::reset();
  geistda=1;
}

int scheuchen(string str)
{
  object geist;
  notify_fail("Was moechtest Du aufscheuchen?\n");
  if ( member( ({ "gestalt auf", "etwas auf" }),str) != -1) 
  {
    if (present("geist",TO) || !geistda)
    {
      write(BS("Du nimmst einen Stein und wirfst ihn hinter den Altar, aber "
               "anscheinend hast Du Dich geirrt. Da war wohl nichts.\n"));
      return -1;
    }
    write(BS("Du nimmst einen Stein und wirfst ihn hinter den Altar und "
             "Etwas bewegt sich auf Dich zu.\n"));

    geistda = 0;
    geist = clone_object (NPC "geist" );
    geist->move(TO,M_GO|M_NOCHECK,"schwebt herein.");
    return 1;
  }
}
