// von Chivas

// 20.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tunnel");
  SetProp( P_INT_LONG,
	"Der Tunnel wird nur durch das Licht vom Eingang erhellt. Die Waende "
        "sind grob behauen und die Decke bietet selbst grossen unbeholfenen "
        "Trollen genug Platz zum aufrecht durchgehen. Ein paar Steine sind "
        "von der Wand auf den Tunnelboden gefallen, was Dich jedoch nicht "
        "davor zurueck haelt weiter zu gehen. Im Norden geht der Tunnel "
        "weiter, scheint dann aber auch bald wieder zu enden. ");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( ({"tunnel","tunnels","platz"}), 
            "Der Tunnel is grob gehauen, kahl und bietet viel Platz. Es ist ein bisschen duester, man kann aber durch "
            "das einfallende Licht aus dem Sueden noch recht gut alles erkennen. Es tropft von der "
            "Decke des Tunnels.");

  AddDetail( ({"boden","tunnelboden"}),
	    "Der Boden des Tunnels ist genau so kahl wie die Waende. Man kann aber gut auf ihm gehen. Ein paar "
            "Steine liegen herum, die anscheinend nachtraeglich von der Felswand herunter gefallen sind.");

  AddDetail( ({"licht","nacht"}),
	    "Das Licht, das vom Sueden in den Tunnel eindringt, stammt von der Sonne, die draussen fast senkrecht "
            "am Himmel steht. Waere es Nacht oder die Sonne wuerde hinter Wolken verschwinden waere es sicher "
            "so dunkel, dass Du nichts mehr sehen koenntest.");

  AddDetail( ({"sonne"}), 
            "Die Sonne kannst Du natuerlich von hier nicht sehen, dazu musst Du schon den Tunnel verlassen.");

  AddDetail( ({"himmel"}),
	    "Den Himmel kannst Du hier drin nicht sehen.");

  AddDetail( ({"decke","tunneldecke"}),
	    "Die Decke ist ein paar Meter ueber Dir. Ab und zu trifft Dich ein Tropfen der von der Tunneldecke "
            "faellt."); 
  
  AddDetail( ({"waende","wand","fels","felswand"}), 
            "Die Waende bestehen aus kahlem Fels, ab und zu kannst Du Adern sehen, die sich durch das Gestein "
            "schlaengeln.");

  AddDetail( ({"eingang"}),
	    "Der Eingang des Tunnels befindet sich im Sueden und das Licht faellt durch ihn in den Tunnel.");

  AddDetail( ({"trollen","troll","trolle"}),
	    "Trolle sind Lebewesen im Silberland.");

  AddDetail( ({"steine"}), 
            "Ein paar Steine sind von der Felswand abgebrochen und liegen auf dem Boden. Die Steine behindern "
            "Dich nicht am weiter gehen.");

  AddDetail( ({"Norden","richtung"}),
	    "Der Tunnel geht im Norden weiter, aber man kann schon das andere Ende sehen.");

  AddDetail( ({"gestein"}),
	    "Das Gestein hier im Tunnel ist sehr hart und ab und zu von Adern durchzogen."); 
  
  AddDetail( ({"wolken","tatsache"}), 
            "Wolken kannst Du im Tunnel natuerlich nicht sehen, die einzigen Wolken die Du erkennst sind die Wolken "
            "die erscheinen, wenn Du ueber diese Tatsache nachgruebelst und mit Deinem Intellekt scheiterst.");

  AddDetail( ({"intellekt","witz"}),
	    "Du musst eigentlich selbst lachen: Du + Intellekt = guter Witz");

  AddDetail( ({"meter","erklaerung","laengenmass"}),
	    "Ein Meter ist ein Laengenmass und ist so lang wie 100 Zentimeter oder 1000 Millimeter.");

  AddDetail( ({"millimeter","zentimeter"}), 
            "Untersuch dazu Meter und Du erhaelst eine Erklaerung.");

  AddDetail( ({"tropfen"}),
	    "Die Tunneldecke scheint rissig zu sein, wodurch Wasser eindringen kann und von der Decke tropft.");

  AddDetail( ({"Wasser"}),
	    "Ganz normales Wasser, nicht sehr interessant."); 
  
  AddDetail( ({"lebewesen","wesen","ich"}), 
            "Halt Wesen wie Du und Ich.");

  AddDetail( ({"silberland"}),
	    "Du befindest Dich im Silberland und es gefaellt Dir hier.");

  AddDetail( ({"ende","tunnelende","punkt"}),
	    "Das Ende des Tunnels im Norden kann man nur leicht erkennen. Es ist nur ein kleiner heller Punkt "
            "zu erkennen, der das Tunnelende andeutet.");

  AddDetail( ({"weg","unbekannte"}), 
            "Der Weg fuehrt im Sueden aus dem Tunnel oder nach Norden weiter ins Unbekannte.");

  AddDetail( ({"sueden"}), 
            "Im Sueden ist der Eingang vom Tunnel, oder der Ausgang, es kommt darauf an von wo man kommt.");

  AddDetail( ({"adern"}),
	    "Die Adern scheinen aus Quarz zu bestehen und durchziehen das Gestein.");

  AddDetail( ({"ausgang","gegenteil"}),
	    "Ausgang ist das Gegenteil von Eingang."); 
  
  AddDetail( ({"quarz"}), 
            "Das Quarz scheint nicht sehr wertvoll zu sein, ansonsten wuerde man ja auch Spuren sehen, die darauf "
            "hinweisen, dass hier geschuerft wurde.");

  AddDetail( ({"spuren"}),
	    "Du siehst keine Spuren, selbst Du hinterlaesst keine auf dem kahlen Boden.");

  AddSmell(DEFAULT_SMELL, "Es riecht einfach nur steril hier im Tunnel.");  
 
  AddSound(DEFAULT_SOUND, "Es ist totenstill, hoffentlich ist dies kein boeses Zeichen auf dem Weg weiter Richtung "
                          "Norden.");

  AddSound( ({"zeichen","totenstill"}),
	   "Man kann halt nichts hoeren.");

//-----Details Ende-----
  
AddExit("sueden", ROOM "zen50");
AddExit("norden", ROOM "zen48");

}  
   
