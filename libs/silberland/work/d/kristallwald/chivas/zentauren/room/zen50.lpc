// von Chivas
// 20.5.2004
// 
// Raum meines Gesellenstueckes "Zentaurenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Vor einem Tunnel");
  SetProp( P_INT_LONG,
	"Du stehst immer noch weit unter dem Gipfel des Berges, der "
        "schneebedeckt in der Sonne glitzert. Ueberall liegen Steinbrocken "
        "neben dem Pfad, Du solltest aufpassen, dass Dich so ein Brocken "
        "nicht mal trifft. Vor Dir ist der Eingang zu einem Tunnel. Er "
        "scheint nicht natuerlichen Ursprungs zu sein, weil nichts "
        "Natuerliches sich durch diesen Fels schlagen kann. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_MOUNTAIN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
 
  AddDetail( ({"gipfel"}), 
            "Der Gipfel ist schneebedeckt und der Schnee glitzert in der "
            "Sonne. Da hoch zu klettern waere absoluter Selbstmord.");

  AddDetail( ({"boden"}),
	    "Der Boden des Pfades ist mit kleinen Steinchen bedeckt und geht "
            "in blanken Fels ueber wo der Tunnel anfaengt.");

  AddDetail( ({"berg","berges","entfernung"}),
	    "Du bist schon weit oben, der Gipfel ist jedoch in unerreichbarer "
            "Entfernung ueber Dir.");

  AddDetail( ({"sonne"}), 
            "Die Sonne scheint am Himmel und glitzert im Schnee auf dem "
            "Gipfel des Berges.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau bis auf ein paar Wolken.");

  AddDetail( ({"wolken"}),
	    "Die Wolken sind schneeweiss. Es wird sicher keinen Regen geben "
            "oder in dieser Hoehe schneien."); 
  
  AddDetail( ({"schnee"}), 
            "Der Schnee glitzert in der Sonne wie ein grosser Haufen "
            "Edelsteine.");

  AddDetail( ({"steinbrocken","brocken","rand"}),
	    "Neben dem Pfad liegen grosse Steinbrocken, die anscheinend vom "
            "Gipfel herunter gerollt sind und hier gestoppt haben. Pass "
            "besser auf, dass ein solcher Brocken Dich nicht erwischt, wenn "
            "er den Hang runterrollt.");

  AddDetail( ({"pfad"}),
	    "Der Pfad ist mit kleinen Steinchen bedeckt. Am Rand des Pfades "
            "liegen Steinbrocken, die den steilen Hang herab gerollt sind. "
            "Der Pfad endet vor dem Eingang eines Tunnels. Wo der wohl "
            "hinfuehren mag.");

  AddDetail( ({"eingang"}), 
            "Du stehst vor dem Eingang eines Tunnels. Er ist grob in den "
            "Fels gehauen und fuehrt ins Unbekannte.");

  AddDetail( ({"tunnel","tunnels"}),
	    "Der Tunnel vor dem Du stehst macht Dich sehr neugierig, obwohl "
            "er sehr duester aussieht und Du nicht weisst wohin er Dich "
            "fuehren wird. Er ist grob in den Fels gehauen und macht auf "
            "jeden Fall den Eindruck, das er bewusst angelegt wurde und "
            "keinen natuerlichen Ursprung hat.");

  AddDetail( ({"ursprung","ursprungs","eindruck","fall","natuerliches"}),
	    "Der Tunnel wurde absichtlich angelegt um auf die andere Seite "
            "des Berges zu kommen."); 
  
  AddDetail( ({"fels","arbeit"}), 
            "Der Fels ist sehr hart und es muss schwere Arbeit gewesen sein, "
            "den Tunnel in den Fels zu schlagen.");

  AddDetail( ({"selbstmord"}),
	    "Das ist nichts fuer Dich.");

  AddDetail( ({"steinchen","steine"}),
	    "Kleine Steinchen liegen auf dem Pfad und knirschen wenn Du ueber "
            "sie gehst.");

  AddDetail( ({"regen","hoehe"}), 
            "Es sieht nicht nach Regen aus, obwohl es in dieser Hoehe sicher "
            "nicht mehr regnen wuerde, sondern schneien.");

  AddDetail( ({"haufen","edelsteine"}),
	    "Leider ist es ja nur Schnee, es war mehr bildlich gemeint.");

  AddDetail( ({"hang"}),
	    "Der Hang ist sehr steil und macht es unmoeglich den Gipfel hoch "
            "zu klettern."); 
  
  AddDetail( ({"unbekannte"}), 
            "Du bist sehr neugierig und solltest es erforschen. Also sei "
            "mutig und geh weiter.");

  AddDetail( ({"seite"}),
	    "Um das heraus zu finden, was sich dort befindet, musst Du schon "
            "durch den Tunnel durchgehen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst die klare Bergluft und fuehlst Dich "
                          "frei.");  
 
  AddSmell( ({"bergluft","luft"}),
	   "Die Luft ist klar und Du fuehlst Dich gut.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind, wie er ueber den kahlen Gipfel "
                          "pfeift und die Steinchen die unter Deinen Schritten "
                          "knirschen.");

  AddSound( ({"wind"}),
	   "Der Wind pfeift ueber den Gipfel: hhhhhuuuuuuuiiiiiii");
  
  AddSound( ({"schritten","steinchen"}),
		"knirsch,knirsch,knirsch");

//-----Details Ende-----
  
AddExit("suedostunten","/d/kristallwald/protheg/quelle/room/vorraum");
AddExit("norden", ROOM "zen49");

}  
   
