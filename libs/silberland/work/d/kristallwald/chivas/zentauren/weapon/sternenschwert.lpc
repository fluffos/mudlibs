inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Sternenschwert");
  SetProp(P_LONG,  
    "Dieses Sternenschwert hat eine lange, schmale und sehr scharfe Klinge und "
    "eine breite Parierstange. Es liegt sehr gut in der Hand, denn der Griff "
    "ist mit einem Lederband umwickelt. Man kann damit sowohl auf seinen "
    "Gegner einschlagen als auch mit der Spitze zustechen." );
  SetProp(P_NAME, "Sternenschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"sternenschwert", "schwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 190);
  SetProp(P_WC_FIX, 50);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":50, "Schwertexperte":150, "Schwertmeister":250]));
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_PIERCE}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_CRYSTAL :95, MAT_LEATHER:5]) );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 3500);
  SetProp(P_SIZE, 105);
  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:16]) ); 
  SetProp(P_INFO, "Das Schwert scheint etwas ganz besonderes zu sein, als "
                "ob der Sternenhimmel darauf abgebildet ist.");
  
  AddDetail( ({"griff"}),
	       "Der Griff ist mit einem Lederband umwickelt.");
  AddDetail( ({"lederband","band"}),
               "Das Lederband ist mehrfach um den Griff herum "
               "gewickelt und sehr fein verarbeitet.");
  AddDetail( ({"klinge"}),
	       "Die Klinge ist ziemlich lang und dient als breite "
	       "Parierstange.");
  AddDetail( ({"parierstange","stange"}),
	       "Die Parierstange dient als breite Klinge.");
  AddDetail( ({"spitze"}),
	       "Mit der Spitze kann man auch auf seinen Gegner "
	       "einstechen.");
  AddDetail( ({"gegner"}),
	       "Du wirst schon wissen, welchen Gegner, Du mit "
	       "diesem Kometenschwert, angreifen wirst.");  
  
}

