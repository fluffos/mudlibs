#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(this_object())) return; 
  ::create();

  SetProp(P_SHORT, "Ein Bratenspiess");
  SetProp(P_LONG,
    "Ein Bratenspiess, er wird normalerweise dazu verwendet Fleisch "
    "aufzuspiessen und es ueber dem Feuer zu braten An ihm kleben immer "
    "noch einige Fleischreste."
  );

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Bratenspiess");
  AddId( ({"spiess","bratenspiess","bratspiess" }) );

  SetProp(P_VALUE, 300);
  SetProp(P_WEIGHT, 1500);
  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_DAM_TYPE, DT_BLUDGEON); 
  SetProp(P_WC, 125);
  SetProp(P_WC_BONUS, (["laris": 60]) );
  SetProp(P_WC_BONUS, (["garlog": 60]) );
  SetProp(P_WC_FIX, 15);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_SIZE, 80);

  AddDetail( ({"fleisch","fleischreste","reste"}),
	       "Die Fleischreste an dem Bratspiess sehen schon ein wenig "
               "ekelig aus.");
}

