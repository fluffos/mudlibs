
#include "../def.h"

inherit "std/weapon";  
void create()
{
  if(!is_clone(this_object())) return;                                        

  ::create();

  SetProp(P_SHORT, "Ein Stift");
  SetProp(P_LONG,
    "Ein ganz normaler kleiner Stift mit einer Spitze, die sicher "
    "weh tut, wenn man damit jemanden sticht."
  );

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Stift");
  AddId( ({"stift" }) );

  SetProp(P_VALUE, 80);
  SetProp(P_WEIGHT, 50);


  SetProp(P_WEAPON_TYPE, WT_KNIFE);      
  SetProp(P_DAM_TYPE, DT_BLUDGEON);     
  SetProp(P_WC, 75);
  SetProp(P_WC_BONUS, (["bibliothekar": 100]) );
  SetProp(P_WC_FIX, 35);
  SetProp(P_NR_HANDS, 1);
  SetProp( P_QUALITY_DECAY, 20 );
  SetProp( P_SIZE, 10 );
}

