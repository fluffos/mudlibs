#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Stueck Eisen");
  SetProp(P_LONG,
    "Das Stueck Eisen eignet sich ideal um daraus etwas aus Metall "
    "herzustellen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Eisen");
  SetProp(P_GENDER, MALE);
  AddId("eisen","QUESTOBJ");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_IRON: 100]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_SIZE, 500);
  SetProp(P_VALUE, 50);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

}
