#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine glaenzende Silbermuenze");
  SetProp(P_LONG,
    "An einem Ende schaut man "
    "durch und auf der anderen Seite kann man durch Linsen die Sterne ganz nah sehen. "
    "In der Mitte ist ein Gewinde, wo man anscheinend Fuesse dranschrauben kann um "
    "das Teleskop darauf zu befestigen. Die Linsen scheinen zu fehlen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Teleskop");
  SetProp(P_GENDER, NEUTER);
  AddId("teleskop","QUESTOBJ");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_COPPER: 100]) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_SIZE, 1500);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

}
