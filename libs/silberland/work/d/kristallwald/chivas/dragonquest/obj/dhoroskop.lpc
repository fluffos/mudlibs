#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Greg's persoenliches Horoskop");
  SetProp(P_LONG,
    "Lieber Greg,\n"
    "dieses Horoskop ist speziell fuer Dich:\n"
    " \n"
    "Dein Leben wird ausgefuellt sein mit viel Arbeit und wenig Lohn. Jedoch "
    "wirst Du stattdessen auch keine Erfuellung in Deiner Arbeit finden. "
    "Eigentlich bist Du schon ein armes Wuerstchen und solltest lieber den "
    "Beruf wechseln. Jedenfalls sagen dies die Sterne.\n"
    "   \n"
    "Elen, der Astrologe");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Horoskop");
  SetProp(P_GENDER, NEUTER);
  AddId("horoskop","dhoroskop","QUESTOBJ");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_PAPER: 100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

}
