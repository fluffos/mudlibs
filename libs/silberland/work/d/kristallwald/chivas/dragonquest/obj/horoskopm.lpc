#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Marlogs persoenliches Horoskop");
  SetProp(P_LONG,
    "Lieber Marlog,\n"
    "hier Dein persoenliches Horoskop:\n"
    "                           \n"
    "Deine Sterne stehen besonders guenstig, um in diesem Jahr viele gute "
    "Geschaefte zu machen. Ausserdem werden Dich in der naechsten Zeit nur "
    "wenige Abenteurer toeten, wodurch Deine Besuche bei Gevatter Tod "
    "abnehmen werden. Desweiteren wird eine huebsche Spielerin Dir schoene "
    "Augen machen, die nicht merkt wie dreckig Du immer bist.\n"
    "                         \n"
    "Viel Glueck,\n"
    "Elen");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Horoskop");
  SetProp(P_GENDER, NEUTER);
  AddId("horoskop");
  AddId("horoskopm");
  AddId("QUESTOBJ");
//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_PAPER: 100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

}
