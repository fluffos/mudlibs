#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Faesschen Heldenbier");
  SetProp(P_LONG,
    "Das Faesschen Heldenbier ist sicher nichts fuer Dich. Mach damit lieber "
    "den Astrologen gluecklich.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Faesschen");
  SetProp(P_GENDER, NEUTER);
  AddId("faesschen","fass","heldenbier","QUESTOBJ");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_MISC_WOOD: 100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_SIZE, 500);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

}
