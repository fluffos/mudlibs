#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein dicker Ast");
  SetProp(P_LONG,
    "Der Ast ist ganz gerade und ziemlich dick. Er stammt von einem der "
    "Baumriesen von Roch Adan und man sollte einfach etwas aus ihm "
    "herstellen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Ast");
  SetProp(P_GENDER, MALE);
  AddId("ast");
  AddId("CHIVASAST");
  AddId("\nast");
  AddId("QUESTOBJ");
//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_MISC_WOOD: 100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_SIZE, 100);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

}
