#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein eisernes Axtblatt");
  SetProp(P_LONG,
    "Das eiserne Axtblatt hat zwei Schneiden und ist ein Bestandteil von einer "
    "Axt. Es sieht jedoch noch nicht fertig aus.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Axtblatt");
  SetProp(P_GENDER, NEUTER);
  AddId("axtblatt1");
  AddId("axtblatt");
  AddId("QUESTOBJ");
  AddId("CHIVASAXTBLATT1");
  
//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_COPPER: 100]) );
  SetProp(P_WEIGHT, 2500);
  SetProp(P_SIZE, 1500);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

}
