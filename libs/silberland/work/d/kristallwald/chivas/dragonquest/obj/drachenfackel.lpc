#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Drachenfackel");
  SetProp(P_LONG,
    "Die Fackel mit dem Drachenfeuer brennt lichterloh und strahlt eine "
    "unglaubliche Hitze aus.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Drachenfackel");
  SetProp(P_GENDER, NEUTER);
  AddId("drachenfackel");
  AddId("fackel");
  AddId("QUESTOBJ");
  AddId("CHIVASFACKEL");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_OAK: 100]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_SIZE, 700);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

}
