// Objekt von Quest 
// von Chivas

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein dicker Ratgeber fuer Heimwerker");
  SetProp(P_LONG,
    "Der Ratgeber fuer Heimwerker gibt alle moeglichen Tips und verraet ein "
    "paar Tips, wie man alle moeglichen Dinge reparieren oder herstellen "
    "kann. Leonardo liest diese Ratgeber immer besonders gerne.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Ratgeber");
  SetProp(P_GENDER, MALE);
  AddId("ratgeber");
  AddId("\nratgeber");
  AddId("ratgeber fuer heimwerker");
  AddId("QUESTOBJ");
  AddId("CHIVASRATGEBER");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_PAPER: 100]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE, 300);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

}
