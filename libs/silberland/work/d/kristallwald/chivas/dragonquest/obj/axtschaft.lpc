#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Axtschaft");
  SetProp(P_LONG,
    "Der Axtschaft besteht aus Holz und ist mit einigen Runen verziert. Es ist "
    "ein Schaft fuer eine maechtige Axt. Die Runen sind Zeichen grosser "
    "Macht, die noch magisch aktiviert werden koennen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Axtschaft");
  SetProp(P_GENDER, NEUTER);
  AddId("\naxtschaft");
  AddId("axtschaft");
  AddId("\naxtschaft");
  AddId("QUESTOBJ");
  AddId("CHIVASAXTSCHAFT");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_OAK: 100]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_SIZE, 800);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

}
