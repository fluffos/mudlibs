#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein verziertes Axtblatt");
  SetProp(P_LONG,
    "Das verzierte Axtblatt hat zwei Schneiden und besteht aus Eisen. Es wurde "
    "mit Intarsien aus Gold und Silber verfeinert. Ausserdem wurden an den "
    "Klingen einige Diamanten angebracht. Es ist ein wunderschoenes Axtblatt "
    "und wird einmal zu einer grossen Waffe gehoeren.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Axtblatt");
  SetProp(P_GENDER, NEUTER);
  AddId("axtblatt2");
  AddId("axtblatt");
  AddId("QUESTOBJ");
  AddId("CHIVASAXTBLATT2");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_COPPER: 100]) );
  SetProp( P_MATERIAL, ([ MAT_IRON : 70, MAT_GOLD : 14, MAT_SILVER : 14, MAT_DIAMOND : 2 ]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_SIZE, 1500);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

}
