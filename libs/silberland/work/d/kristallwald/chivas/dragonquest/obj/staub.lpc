#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein bisschen Sternenstaub");
  SetProp(P_LONG,
    "Der Sternenstaub glitzert magisch. Man kann ihn sicher wegen seiner "
    "magischen Eigenschaften sehr gut fuer magische Rituale benutzen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Sternenstaub");
  SetProp(P_GENDER, NEUTER);
  AddId("sternenstaub");
  AddId("staub");
  AddId("CHIVASSTAUB");
  AddId("QUESTOBJ");
//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_MISC_MAGIC : 100]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_SIZE, 300);
  SetProp(P_VALUE, 15000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

}
