// Objekt von Quest 
// von Chivas

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine handschriftliche Liste");
  SetProp(P_LONG,
    "");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Liste");
  SetProp(P_GENDER, MALE);
  AddId("liste","\nliste","QUESTOBJ");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_PAPER: 100]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_SIZE, 300);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

}
