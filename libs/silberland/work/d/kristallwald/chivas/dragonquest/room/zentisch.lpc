// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Tischlerei von Roch Adan");
  SetProp( P_INT_LONG,
	"In diesem Baumriesen befindet sich die Tischlerei von Roch Adan. "
	"Ueberall siehst Du Bretter und Werkzeuge herum liegen. An den Waenden "
	"stehen halb fertige Moebel und andere Gegenstaende. In der Mitte der "
	"Werkstatt ist eine grosse Werkbank, an der der Tischler alles "
	"zusammen baut, fuer das er beauftragt wird." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"baumriesen","baumriese","baum"}), 
            "Du befindest Dich in einem der Baumriesen von Roch Adan. In "
	    "diesem Baum befindet sich eine Tischlerei.");

  AddDetail( ({"tischlerei"}),
	    "In der Tischlerei werden alle moeglichen Dinge aus Holz "
	    "hergestellt.");

  AddDetail( ({"roch","adan","roch adan","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren.");

  AddDetail( ({"bretter"}),
	    "Lauter Bretter liegen in der Tischlerei herum, aus denen der "
	    "Tischler alle moeglichen Dinge herstellt.");
  
  AddDetail( ({"werkzeuge"}),
	    "Lauter Werkzeuge liegen auf der Werkbank herum, die zur "
	    "Herstellung von verschiedenen Gegenstaenden aus Holz dienen.");

  AddDetail( ({"waenden","waende","wand"}), 
            "An den Waenden haengen verschiedene Zeichnungen und ein schoenes "
	    "grosses Bild.");

  AddDetail( ({"moebel"}),
	    "Die Moebel, die hier herum stehen, sind noch nicht fertig. Sie "
	    "werden sicher vom Tischler noch fertig gestellt.");

  AddDetail( ({"gegenstaende","gegenstaenden","bedeutung","geraete"}),
	    "Es sind alle moeglichen Geraete aus Holz, die recht kompliziert "
	    "aussehen und dessen Bedeutung Du nicht verstehst.");

  AddDetail( ({"mitte"}),
	    "In der Mitte der Werkstatt steht eine grosse breite Werkbank.");
  
  AddDetail( ({"werkstatt"}),
	    "Die Werkstatt ist eine Tischlerei.");

  AddDetail( ({"tischler"}), 
            "Der Tischler erschafft alle moeglichen Dinge aus Holz.");

  AddDetail( ({"dinge"}),
	    "Der Tischler baut alle moeglichen Geraete und Moebel aus Holz.");

  AddDetail( ({"holz","werkstoff"}),
	    "Holz ist ein sehr guter Werkstoff, aus dem man alle moeglichen "
	    "Dinge erschaffen kann.");

  AddDetail( ({"zentauren"}),
	    "Die Zentauren leben hier in Roch Adan.");
  
  AddDetail( ({"zeichnungen"}),
	    "Die Zeichnungen an den Waenden sind Konstruktionsplaene.");

  AddDetail( ({"bild"}), 
            "Das Bild ist eher ein Gemaelde.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen lauter Haufen aus Holzspaehne.");

  AddDetail( ({"decke"}),
	    "An der Decke haengt eine interessante Konstruktion aus Holz.");

  AddDetail( ({"konstruktionsplaene","plaene"}),
	    "Die Konstruktionsplaene zeigen alle moeglichen Maschinen.");
  
  AddDetail( ({"gemaelde"}),
	    "Das Gemaelde zeigt eine junge Frau mit einem wunderschoenen "
	    "Laecheln. Unter dem Gemaelde haengt ein kleines Schild.");

  AddDetail( ({"haufen","holzspaehne"}), 
            "Die Holzspaehne ist wohl bei den letzten Arbeiten angefallen.");

  AddDetail( ({"konstruktion"}),
	    "Die Konstruktion, die unter der Decke haengt, scheint eine Art "
	    "Flugapparat zu sein. Der Tischler ist sehr erfinderisch.");

  AddDetail( ({"maschinen","arbeit","besitzer"}),
	    "Die Maschinen auf den Konstruktionsplaenen, sehen sehr "
	    "kompliziert aus und scheinen die Arbeit der Besitzer zu "
	    "erleichtern. Nur ein Genie kann solche Maschinen entwickeln.");

  AddDetail( ({"arbeiten"}),
	    "Es ist nicht zu glauben, aber in einer Werkstatt wird auch "
	    "gearbeitet.");
  
  AddDetail( ({"laecheln"}),
	    "Das Laecheln ist sehr geheimnisvoll und unergruendlich. Du bist "
	    "davon ueberzeugt, dass dieses Laecheln viele Raetsel aufgibt.");

  AddDetail( ({"schild"}), 
            "Du kannst es lesen.");

  AddDetail( ({"raetsel"}),
	    "Dieses Raetsel wird wohl nie geloest werden.");

  AddDetail( ({"genie","erfinden"}),
	    "Der Tischler ist sicher ein Genie beim Erfinden von Dingen.");

  AddDetail( ({"art","flugapparat","apparat","fluggeraet"}),
	    "Ob das Fluggeraet auch wirklich fliegt, wirst Du wohl nie "
	    "erfahren.");
  
  AddDetail( ({"frau"}),
	    "Die Frau auf dem Gemaelde hat ein geheimnisvolles Laecheln.");

  AddDetail( ({"werkbank"}),
	    "Auf der Werkbank liegen ein paar Werkzeuge und Bretter, mit denen "
	    "der Tischler arbeitet.");
  
  AddDetail( ({"herstellung"}),
	    "Hier werden alle moeglichen Dinge aus Holz hergestellt.");

  AddDetail( ({"schrank","ecke"}),
	    "In einer Ecke steht ein alter Schrank, der von dem Tischler "
	    "noch abgeschleift werden muss.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Holz.");  
 
  AddSmell( ({"holz"}),
	   "Das Holz riecht frisch und wurde wohl gerade erst bearbeitet.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Rascheln.");

  AddSound( ({"rascheln"}),
	   "Das Rascheln kommt aus einem der Haufen am Boden.");
 
  AddSound( ({"maeuse","maeusen"}),
	   "Die kleinen Maeuse spielen mit der Holzspaehne. Du solltest sie "
	   "einfach spielen lassen und nicht mehr beachten.");
    
  AddSound( ({"haufen","rascheln"}),
	   "Das Rascheln in den Haufen kommt von ein paar kleinen Maeusen, die "
	   "sich darin versteckt haben.");

  AddReadDetail( ({"schild"}),
		"+------------------------------------+\n"
		"|                                    |\n"
		"| Die Liebe meines Lebens: Lisa Mona |\n"
		"|                                    |\n"
		"+------------------------------------+\n");


//-----Details Ende-----

AddItem(NPC "leonardo", REFRESH_DESTRUCT); 

AddExit("nordosten", "/d/kristallwald/chivas/zentauren/room/zeng1");

}
