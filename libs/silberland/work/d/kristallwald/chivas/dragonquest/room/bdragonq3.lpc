// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Lichtung mit einem schwarzen Turm");
  SetProp( P_INT_LONG,
	"Du stehst auf einer Lichtung. Genau vor Dir reckt sich ein grosser "
	"schwarzer Turm in die Hoehe, der im Mittelpunkt der kleinen Lichtung "
	"steht, die von den hohen Baeumen des Waldes umringt wird. Der kleine "
	"Pfad auf dem Du hier her gekommen bist, fuehrt nach Nordwesten und "
	"nach Suedwesten um den Turm herum." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"lichtung"}), 
            "Die Lichtung ist nicht besonders gross. Viel Gras und sogar "
	    "einige Blumen wachsen auf der Lichtung. In der Mitte der "
	    "Lichtung steht ein grosser schwarzer Turm.");

  AddDetail( ({"turm","turms"}),
	    "Ein grosser schwarzer Turm steht im Mittelpunkt der Lichtung und "
	    "sieht bedrohlich aus. Der Eingang zum Turm befindet sich direkt "
	    "vor Dir im Westen.");

  AddDetail( ({"hoehe"}),
	    "Der schwarze Turm ist sehr hoch und reckt sich in den Himmel.");

  AddDetail( ({"mittelpunkt","mitte"}),
	    "In der Mitte der Lichtung steht ein grosser schwarzer Turm.");
  
  AddDetail( ({"baeume","baeumen","moeglichkeit"}),
	    "Die Baeume des Waldes umrunden die Lichtung. Sie stehen ganz "
	    "dicht, so dass man die Lichtung nicht verlassen kann. Die "
	    "einzige Moeglichkeit die Lichtung zu verlassen, ist der Pfad auf "
	    "dem Du hier her gekommen bis.");

  AddDetail( ({"waldes","wald"}), 
            "Der Wald mit seinen Baeumen ist rund um die Lichtung zu sehen. "
	    "Er ist sehr dicht und Du kannst die Lichtung nur ueber den Pfad "
	    "verlassen, der Dich hier her gefuehrt hat.");

  AddDetail( ({"pfad","osten"}),
	    "Der Pfad der Dich hier her gefuehrt hat liegt im Osten. Er "
	    "fuehrt nach Nordwesten und Suedosten um den Turm herum ueber die "
	    "Lichtung.");

  AddDetail( ({"nordwesten","suedwesten"}),
	    "Nach Nordwesten und Suedwesten fuehrt der Pfad ueber die Lichtung "
	    "um den Turm herum.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen einige Steinchen auf dem Pfad. Ansonsten ist "
	    "viel Gras und sogar einige Blumen auf der Lichtung zu erkennen.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist herrlich blau und die Sonne scheint ueber Dir.");

  AddDetail( ({"gras"}), 
            "Das Gras ist ein wenig blaesslich und scheint nicht so gut auf "
	    "der Lichtung zu gedeihen. Vielleicht liegt es an dem Turm und "
	    "seinem Bewohner.");

  AddDetail( ({"blumen"}),
	    "Die Blumen sind klein und unscheinbar. Sie scheinen in der Naehe "
	    "vom Turm nicht sehr gut zu wachsen. Eine negative Ausstrahlung "
	    "scheint alles in der Umgebung des Turms daran zu hindern "
	    "aufzubluehen.");

  AddDetail( ({"eingang","westen","eingaenge","richtung"}),
	    "Einer der Eingaenge zum Turm befindet sich westlich von Dir. Wie "
	    "es aussieht gibt es aus jeder Richtung jeweils einen Eingang.");

  AddDetail( ({"steinchen"}),
	    "Kleine bedeutungslose Steinchen liegen auf dem Pfad.");
  
  AddDetail( ({"sonne"}),
	    "Die Sonne scheint beinahe senkrecht vom Himmel.");

  AddDetail( ({"bewohner"}), 
            "Der Bewohner des Turms soll ein boesartiger schwarzer Drache "
	    "sein.");

  AddDetail( ({"naehe","umgebung"}),
	    "Die Naehe des Turms macht Dich ein wenig nervoes. Hier kann man "
	    "sich nicht wohl fuehlen.");

  AddDetail( ({"ausstrahlung"}),
	    "Die Ausstrahlung des Turms ist durchgehend negativ.");

  AddDetail( ({"drache","drachen"}),
	    "Der Drache ist boesartig und sehr stark. Du solltest ihn nur mit "
	    "der richtigen Waffe besuchen.");
  
  AddDetail( ({"waffe"}),
	    "Hast Du die richtige Waffe dabei?");

  AddDetail( ({"turmspitze"}), 
            "Die Turmspitze ist weit oben.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Gras und Blumen.");  
 
  AddSmell( ({"gras","blumen","duft"}),
	   "Der Duft nach Gras und Blumen riecht recht blass. Es riecht hier "
	   "alles nicht so frisch und lebendig wie auf einer normalen Lichtung "
	   "ohne schwarzen Turm.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel zwitschern.");

  AddSound( ({"voegel"}),
	   "Die Voegel zwitschern ganz leise in den Baeumen. Ausserdem hoerst "
	   "Du noch ein leises Fauchen.");
  
  AddSound( ({"fauchen"}),
	   "Das Fauchen kommt aus der Turmspitze und gehoert sicher dem "
	   "Drachen.");

//-----Details Ende-----
  
AddExit("nordwesten", ROOM "bdragonq4");
AddExit("suedwesten", ROOM "bdragonq5");
AddExit("osten", ROOM "bdragonq2");
AddSpecialExit( "westen", "go_w" );

}
int go_w(string dir)
{

  if(!(present("\ndqaxt", TP)))
  {
    write( BS( "Eine unheimliche und dunkle Macht scheint Dich zu laehmen und "
	       "Dich davon abzuhalten den Turm zu betreten. Du solltest schon "
	       "die richtige Waffe bei Dir haben um Dich dem Wesen im Turm zu "
	       "stellen.") );
    say("Eine unheimliche und dunkle Macht haelt "+TP->Name(WEN)+" davon ab, "
      "den Turm zu betreten.\n");
    TP->AddHp(-50);
    return -1;
  }
  write(BS("Du gehst mit der magischen Axt bewaffnet voller Mut in den Turm. "
	   "Nichts wird Dich jetzt noch aufhalten koennen.\n"));
 
  say(TPN+" verschwindet im Turm.\n");
  this_player()->move(ROOM "bdragonq7", M_TPORT);
  return 1;
}
