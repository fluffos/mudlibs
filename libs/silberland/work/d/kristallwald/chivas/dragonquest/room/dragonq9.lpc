// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle");
  SetProp( P_INT_LONG,
	"Die Kammer ist sehr gross und aehnelt von der Groesse eher einer "
	"kleinen Halle. Ein Fluss aus Lava schlaengelt sich durch die Kammer "
	"und Feuersaeulen zuengeln ab und zu aus dem Fluss heraus. In der "
	"Mitte der Kammer befindet sich ein erhoehtes Podest, auf dem ein "
	"weisser Drache liegt und Dich freundlich beobachtet." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 35, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"kammer"}), 
            "Die Kammer ist gross und eher eine kleine Halle. Ueberall sind "
	    "Saeulen aus Feuer zu sehen und ein Fluss aus Lava fliesst durch "
	    "die Kammer. In der Mitte befindet sich ein erhoehtes Podest.");

  AddDetail( ({"groesse"}),
	    "Die Groesse entspricht eher einer Halle als einer Kammer.");

  AddDetail( ({"halle"}),
	    "Man sollte eher Halle zu dieser Kammer sagen, da sie recht gross "
	    "ist.");

  AddDetail( ({"fluss","art","wasser"}),
	    "Eine Art Fluss schlaengelt sich durch die Halle. Jedoch ist kein "
	    "Wasser im Fluss, sondern brennende Lava.");
  
  AddDetail( ({"lava"}),
	    "Die Lava fliesst traege in dem Fluss. Ab und zu steigen Saeulen "
	    "aus Feuer aus dem Fluss auf.");

  AddDetail( ({"feuersaeulen","saeulen","feuer","tornados"}), 
            "Die Feuersaeulen sehen aus wie kleine Tornados, die aus der Lava "
	    "aufsteigen, sich kurz drehen und wieder verschwinden.");

  AddDetail( ({"mitte","podest","ruheplatz"}),
	    "In der Mitte der Halle ist ein erhoehtes Podest, welches als "
	    "Ruheplatz fuer den Drachen dient.");

  AddDetail( ({"boden"}),
	    "Am Boden siehst Du einige alte Ruestungsteile und Waffen.");

  AddDetail( ({"waende","hitze","wand"}),
	    "Die Waende gluehen von der Hitze der Lava.");
  
  AddDetail( ({"decke"}),
	    "Die Decke ist weit oben zu sehen. Jedoch ist sie nicht sehr "
	    "interessant.");

  AddDetail( ({"drache"}), 
            "Ein grosser weisser Drache liegt auf dem Podest.");

  AddDetail( ({"ruestungsteile","ruestungen","waffen"}),
	    "Die Ruestungsteile und Waffen scheinen von ein paar Unholden zu "
	    "stammen, die anscheinend versucht haben dem Drachen etwas "
	    "anzutun. Die Waffen sind hauptsaechlich schwarze Dolche und "
	    "Krummschwerter.");

  AddDetail( ({"unholde","wesen","chance"}),
	    "Boese Wesen versuchten den Drachen zu toeten. Jedoch hatten sie "
	    "keine Chance gegen den Drachen.");

  AddDetail( ({"krummschwerter","schwerter","dolche"}),
	    "Diese Waffen werden nur von boesen Wesen benutzt.");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({""}), 
            "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({""}), 
            "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({""}), 
            "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({"nase"}),
	    "Du hast eine grosse Nase.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst den Rauch vom Feuer.");  
 
  AddSmell( ({"rauch","feuer"}),
	   "Der Rauch kitzelt in der Nase.");

  AddSound(DEFAULT_SOUND, "Das Feuer knistert.");

  AddSound( ({"feuer"}),
	   "*knister*");
  
//-----Details Ende-----

AddItem(NPC "anezram", REFRESH_DESTRUCT);  

AddExit("osten", ROOM "dragonq8");

AddCmd( ({"toete" }), "toeten" ); 

}
int toeten(string str)
{
object dragoninvis3;
notify_fail("Wen moechtest Du toeten?\n");
 if ( member( ({ "anezram", "drache","alle" }),str) != -1) 
  {
 if(!present("anezram"))
 {
  write(BS("Aber Anezram ist doch gar nicht da!"));
  return -1;
 }
 if(!present("drachentoeter", TP))
 {
  write(BS("Du hast ja gar nicht die Axt bei Dir!"));
  return -1;
 }
 if(!present("dragoninvis4", TP))
    {
    write(BS( "Anezram sagt: Okay, Du bist also gekommen mich zu toeten. Dann "
	      "werde ich Dich vernichten.\n"
	      "Bei der ersten Attacke von Anezram beginnt Deine Axt zu gluehen"
	      "und schneidet wie durch Butter durch die Krallen des Drachen."
	      "An jeder Stelle wo Du mit der Axt den Drachen triffst beginnt "
	      "dieser sich unter Schmerzen aufzuloesen. Der Kampf war kurz "
	      "und unfair. Anezram hatte keine Chance gegen Dich."));
  if (present("dragoninvis1",TP))
  present("dragoninvis1",TP)->remove();
  if (present("dragoninvis3",TP))
  present("dragoninvis3",TP)->remove();
  present("anezram")->remove();
  return 1;
    }
    else
    {
    write(BS( "Du sollst nicht mich toeten Du Dummerchen. Du sollst Akinaj den "
	      "boesen Drachen toeten. Lauf und erfuelle die Aufgabe des "
	      "Guten.\n"));
  return 1;   
    }
  }
}

