// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Pfad auf dem Du stehst, endet im Osten vor einigen Straeuchern. "
	"Nach Westen fuehrt ein kleiner Pfad zwischen den hohen Baeumen des "
	"Waldes entlang. Wohin der Pfad fuehrt ist von hier aus nicht zu "
	"erkennen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"pfad"}), 
            "Der Pfad schlaengelt sich zwischen den Baeumen hindurch nach "
	    "Westen.");

  AddDetail( ({"osten"}),
	    "Im Osten endet der Pfad vor ein paar Straeuchern.");

  AddDetail( ({"straeucher","straeuchern","durchgang"}),
	    "Die Straeucher versperren Dir den Durchgang zum Weg. Du musst "
	    "Dich wohl durch die Straeucher zwaengen.");

  AddDetail( ({"westen"}),
	    "Der Pfad fuehrt durch den Wald nach Westen.");
  
  AddDetail( ({"baeume","baeumen"}),
	    "Die Baeume sind hoch gewachsen und der Pfad schlaengelt sich "
	    "duch sie hindurch.");

  AddDetail( ({"wald","waldes"}), 
            "Du stehst mitten im Wald.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen einzelne Blaetter, ein paar Zweige und einige "
	    "Steinchen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist durch das dichte Blaetterdach verdeckt.");

  AddDetail( ({"weg"}),
	    "Der Weg befindet sich hinter den Straeuchern.");
  
  AddDetail( ({"blaetter","laub"}),
	    "Die Blaetter sind von den Baeumen gefallen und liegen "
	    "nun als welkes Laub am Boden.");

  AddDetail( ({"zweige"}), 
            "Die Zweige sind auf dem Boden gelandet, als sie von "
	    "den Baeumen abgefallen sind.");

  AddDetail( ({"steinchen"}),
	    "Einige Steinchen liegen auf dem Pfad.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Die Baeume bilden ein dichtes Blaetterdach.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Wald.");  
 
  AddSmell( ({"wald"}),
	   "Es riecht hier ziemlich waldig.");

  AddSound(DEFAULT_SOUND, "Du hoerst einige Voegel in den Baeumen "
		          "zwitschern.");

  AddSound( ({"voegel"}),
	   "*tschip*tschip*tschip*tschip*");

//-----Details Ende-----
  
AddExit("westen", ROOM "bdragonq2");

AddCmd( ({"zwaeng", "zwaenge" }), "zwaengen" );

}
int zwaengen(string str)
{
   notify_fail("Wo moechtest Du Dich durchzwaengen?\n");
   if ( member( ({ "durch straeucher","durch strauch","durch zweige" }),str) != -1) 
  {
    write(BS ( "Du zwaengst Dich durch die Zweige der Straeucher und erreichst "
	       "einen Weg, der durch den Wald fuehrt.\n"));
      TP->move( "/d/kristallwald/chivas/zwergenfeste/room/zww10", M_GO, 
      "ploetzlich zwischen den Straeuchern", "verschwindet", 
      "zwaengt sich durch die Straeucher herein");
    return 1;
  }
}
