// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl;

void create()
	
{
  ::create();

  anzahl=1;

  SetProp( P_INT_SHORT, "In einer Hoehle");
  SetProp( P_INT_LONG,
	"Es herrscht absolute Dunkelheit in der Hoehle und man muss aufpassen, "
	"dass man nicht hinfaellt, da ueberall am Boden grosse und kleine "
	"Felsbrocken liegen. An den Waenden sind ausserdem scharfe Kanten vom "
	"Fels, wo man sich hervorragend dran verletzen kann." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 0 );

//-----Details Anfang-----
  
  AddDetail( ({"dunkelheit","schleier"}), 
            "Die Dunkelheit umgibt Dich wie ein schwarzer Schleier.");

  AddDetail( ({"hoehle","abschnitt"}),
	    "Die Hoehle hat in diesem Abschnitt eine unheimliche Aura.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit grossen und kleinen Felsbrocken uebersaeht.");

  AddDetail( ({"felsbrocken","brocken"}),
	    "Die Felsbrocken liegen ueberall am Boden herum und man muss "
	    "aufpassen, dass man sich nicht an ihnen stoesst.");
  
  AddDetail( ({"waende","waenden","wand"}),
	    "Die Waende der Hoehle sind rau und unbearbeitet. Teilweise stehen "
	    "scharfe Kanten in die Hoehle hinein, wo man sich schnell "
	    "schneiden kann.");
  
  AddSpecialDetail( ({ "kanten","kante" }), "kanten" );

  AddSpecialDetail( ({ "schlupfwinkel" }), "schlupfwinkel" );

  AddSpecialDetail( ({ "klauen","besitzer","mut" }), "klauen" );

  AddSpecialDetail( ({ "etwas" }), "etwas" );
  
  AddDetail( ({"fels"}),
	    "Der Fels der Waende ist rau und wurde niemals von den Zwergen "
	    "von Ardhmir bearbeitet. Du vermisst die kunstvollen Arbeiten "
	    "der Zwerge an den Waenden.");

  AddDetail( ({"aura"}),
	    "Man kann die unheimliche Aura an nichts richtig festmachen. Man "
	    "hat einfach nur das Gefuehl beobachtet zu werden.");

  AddDetail( ({"gefuehl"}),
	    "Manchmal sollte man einfach seinem Gefuehl vertrauen und einfach "
	    "schnell weiter gehen.");
  
  AddDetail( ({"zwerge","zwergen","arbeiten"}),
	    "Die Zwerge von Ardhmir haben oben in der Zwergenfeste fast jede "
	    "Wand kunstvoll verschoenert.");

  AddDetail( ({"ardhmir","zwergenfeste"}), 
            "Die Zwergenfeste von Ardhmir befindet sich oberhalb der Hoehle. "
	    "Du kannst jederzeit umkehren und Dir die Stadt der Zwerge "
	    "anschauen.");

  AddDetail( ({"stadt"}),
	    "Die Zwergenfeste von Ardhmir ist eine kleine Stadt.");

  AddDetail( ({"decke"}),
	    "Die Decke ist ueberhaupt nicht interessant. Du brauchst hier "
	    "nicht die Decke abzusuchen.");

  AddDetail( ({"versteck"}),
	    "Hinter den Kanten kann sich manchmal auch wer verstecken. ");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({""}), 
            "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig nach Rauch.");  
 
  AddSmell( ({"rauch","osten"}),
	   "Der Rauch scheint aus dem Osten zu kommen.");

  AddSound(DEFAULT_SOUND, "Du hoerst nur Deine eigenen Schritte.");

  AddSound( ({"schritte"}),
	   "*trap*trap*trap*");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "dragonq4");
AddExit("suedosten", ROOM "dragonq6");

AddCmd( ({"scheuch", "scheuche" }), "scheuchen" );

}
void reset()
{
  ::reset();
  anzahl=1;
}
int scheuchen(string str)
{
   object troll;
   notify_fail("Wen moechtest Du aufscheuchen?\n");
   if ( member( ({ "besitzer der klauen auf", "besitzer auf","etwas auf" }),str) != -1) 
  {
   if ( anzahl )
  {
    write(BS( "Du scheuchst den Besitzer der Klauen auf und ploeztlich tritt "
	      "er aus seinem Versteck.\n"));
    say( TPN+" scheucht Etwas auf.\n");
    troll=clone_object ("/d/unterwelt/ronja/sternenwald/npc/juwelentroll");
    troll->move(TO,M_GO|M_NOCHECK,"stapft herein.");
    anzahl--;
    return 1;
    }
    else
    {
    write(BS( "Du probierst wie verrueckt Jemanden aufzuscheuchen, obwohl Du "
	      "definitiv keinen zum aufscheuchen findest.\n"));
    say( TPN+" scheint an Paranoia zu leiden.\n");
    return 1;   
    }
  }
}

string kanten(string key)
{
    if ( anzahl )
    {
    return(BS("Hinter einer Kante scheint es so, als ob sich dort Etwas "
	      "bewegt hat.\n"));
    }
    else
    {
    return(BS("Hinter so mancher Kante kann man sich sicher gut verstecken, "
	      "jedoch gibt es momentan nicht viel zu entdecken. Schau spaeter "
	      "noch einmal nach."));
    }
}
string etwas(string key)
{
    if ( anzahl )
    {
    return(BS("Du erkennst an einer Kante ein paar Klauen, die aus einem "
	      "Schlupfwinkel hinter einer Kante hervorschauen.\n"));
    }
    else
    {
    return(BS("Es gibt momentan kein Etwas. Wie kommst Du darauf?"));
    }
}
string klauen(string key)
{
    if ( anzahl )
    {
    return(BS("Die Klauen sind wieder in der Dunkelheit der Hoehle "
	      "verschwunden. Sie sahen jedenfalls nicht sehr freundlich aus. "
	      "Falls Du jedoch genug Mut hast, kannst Du ja mal versuchen den "
	      "Besitzer der Klauen aufzuscheuchen.\n"));
    }
    else
    {
    return(BS("Hier gibt es keine Klauen."));
    }
}
string schlupfwinkel(string key)
{
    if ( anzahl )
    {
    return(BS("Hinter der Kante scheint es einen Schlupfwinkel zu geben, der "
	      "als Versteck fuer Etwas dient. Dieses Etwas scheint Klauen zu "
	      "besitzen.\n"));
    }
    else
    {
    return(BS("Hinter so machen Kanten bilden sich ab und zu ideale "
	      "Schlupfwinkel. Jedoch versteckt sich momentan niemand in "
	      "ihnen."));
    }
}
