// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Lichtung mit einem schwarzen Turm");
  SetProp( P_INT_LONG,
	"Du stehst nun noerdlich des Turms, der vor Dir in den Himmel reicht. "
	"Es besteht die Moeglichkeit den Turm auch von dieser Seite zu "
	"betreten. Anscheinend hat er Ausgaenge in alle Himmelsrichtungen. "
	"Ansonsten fallen Dir ein paar Brandflecke und einige Knochen auf, "
	"die auf dem Gras vor dem Turm liegen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"turms","turm"}), 
            "Der Turm ist suedlich von Dir zu sehen.");

  AddDetail( ({"himmel","sonne"}),
	    "Der Himmel ist blau und die Sonne steht beinahe senkrecht ueber "
	    "Dir.");

  AddDetail( ({"moeglichkeit"}),
	    "Du kannst den Turm auch von hier aus betreten.");

  AddDetail( ({"seite"}),
	    "Du bist auf der noerdlichen Seite der Lichtung.");
  
  AddDetail( ({"ausgaenge"}),
	    "Anscheinend gibt es Ausgaenge in alle Richtungen.");

  AddDetail( ({"himmelsrichtungen","richtungen","norden","sueden","osten","westen"}), 
            "Die Himmelsrichtungen sind Norden, Sueden, Osten und Westen.");

  AddDetail( ({"brandflecke","flecke"}),
	    "Grosse Brandflecke sind vor dem Turm im Gras zu sehen. "
	    "Anscheinend hat der Drache hier vor dem Turm einige Abenteurer "
	    "angefeuert.");

  AddDetail( ({"knochen"}),
	    "Die Knochen in Gras gehoeren sicher auch den Abenteurern, die "
	    "hier angefeuert wurden.");

  AddDetail( ({"gras"}),
	    "Das Gras auf der Lichtung ist ein wenig blass. Genau vor dem "
	    "Turm liegen einige Knochen im Gras und ein paar Brandflecke sind "
	    "zu sehen.");
  
  AddDetail( ({"boden"}),
	    "Du stehst auf einem Pfad, der um den Turm herum fuehrt. Auf dem "
	    "Pfad liegen die ueblichen kleinen Steinchen.");

  AddDetail( ({"abenteurer","abenteurern"}), 
            "Abenteurer wie Du auch einer bist. Sie haben sich halt nur mit "
	    "dem falschen Gegner angelegt.");

  AddDetail( ({"steinchen"}),
	    "Die Steinchen sind wirklich uninteressant, jedoch faellt Dir "
	    "auch ein Funkeln auf.");

  AddDetail( ({"gegner"}),
	    "Der Drache, der hier wohnt, ist ein maechtiger Gegner.");

  AddDetail( ({"drache"}),
	    "Der Drache soll pechschwarz sein und unglaublich boesartig.");
  
  AddDetail( ({"funkeln"}),
	    "Als Du das Funkeln genauer betrachtest erkennst Du eine kleine "
	    "runde Kugel.");

  AddDetail( ({"kugel"}), 
            "Du bist leicht angeeckelt. Es handelt sich bei der Kugel um ein "
	    "Glasauge.");

  AddDetail( ({"glasauge","auge","glasauges"}),
	    "Du laesst das Glasauge lieber liegen. Vielleicht kommt ja der "
	    "Besitzer noch wieder und wurde nicht vom Drachen zu Asche "
	    "verbrannt.");

  AddDetail( ({"besitzer"}),
	    "Du bist jedenfalls nicht der Besitzer des Glasauges.");

  AddDetail( ({"asche"}),
	    "Die Asche wurde schon laengst vom Wind davon geweht. Uebrig "
	    "geblieben sind nur ein paar Knochen und die Brandflecke.");
  
  AddDetail( ({"lichtung"}),
	    "Du stehst auf einer Lichtung mit einem grossen Turm.");

  AddDetail( ({"pfad"}), 
            "Der Pfad fuehrt um den Turm herum.");

  AddDetail( ({"wind"}), 
            "Du kannst den Wind hoeren.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht, als ob Etwas verbrannt ist.");  
 
  AddSmell( ({"etwas","geruch"}),
	   "Du kannst den Geruch nicht genau deuten, was es war, nur noch die "
	   "Brandflecke sind zu erkennen.");

  AddSound(DEFAULT_SOUND, "Du hoerst ganz leicht den Wind wehen.");

  AddSound( ({"wind"}),
	   "Der Wind rauscht ganz leise ueber die Lichtung.");

//-----Details Ende-----
  
AddExit("suedosten", ROOM "bdragonq3");
AddExit("suedwesten", ROOM "bdragonq6");
AddSpecialExit( "sueden", "go_s" );

}
int go_s(string dir)
{

  if(!(present("\ndqaxt", TP)))
  {
    write( BS( "Eine unheimliche und dunkle Macht scheint Dich zu laehmen und "
	       "Dich davon abzuhalten den Turm zu betreten. Du solltest schon "
	       "die richtige Waffe bei Dir haben um Dich dem Wesen im Turm zu "
	       "stellen.") );
    say("Eine unheimliche und dunkle Macht haelt "+TP->Name(WEN)+" davon ab, "
      "den Turm zu betreten.\n");
    TP->AddHp(-50);
    return -1;
  }
  write(BS("Du gehst mit der magischen Axt bewaffnet voller Mut in den Turm. "
	   "Nichts wird Dich jetzt noch aufhalten koennen.\n"));
 
  say(TPN+" verschwindet im Turm.\n");
  this_player()->move(ROOM "bdragonq7", M_TPORT);
  return 1;
}
