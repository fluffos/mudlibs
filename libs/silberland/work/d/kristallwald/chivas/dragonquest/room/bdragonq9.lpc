// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem schwarzen Turm");
  SetProp( P_INT_LONG,
	"Im zweiten Geschoss ist es ein wenig ordentlicher als im Geschoss "
	"weiter unten. Es gibt einen Altar, auf dem sauber und ordentlich "
	"einige Schaedel aufgereiht wurden. Die blutroten Kerzen auf dem Altar "
	"vervollstaendigen den duesteren Eindruck des zweiten Obergeschosses "
	"im Turm." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"geschoss","obergeschosses","obergeschoss"}), 
            "Du bist im zweiten Obergeschoss im schwarzen Turm.");

  AddDetail( ({"altar","kontrast"}),
	    "Der Altar besteht aus weissem Marmor und stellt dabei einen "
	    "starken Kontrast zu dem schwarzen Granit am Boden, der Decke "
	    "und den Waenden dar. Einige Schaedel sind sorgfaeltig auf "
	    "im aufgereiht und blutrote Kerzen brennen auf ihm.");

  AddDetail( ({"schaedel","schaedeln"}),
	    "Die Schaedel gehoeren unterschiedlichen Rassen an. Das "
	    "Interessante ist aber die Axt, die in jedem der Schaedel steckt.");

  AddDetail( ({"kerzen","licht"}),
	    "Die Kerzen sind blutrot und erhellen mit ihrem Licht das zweite "
	    "Obergeschoss.");
  
  AddDetail( ({"eindruck","beste"}),
	    "Der Eindruck, den Du hier von dem Turm hast ist nicht der Beste. "
	    "Vor allem, wenn Du die Schaedel auf dem Altar betrachtest.");

  AddDetail( ({"turm"}), 
            "Du bist im schwarzen Turm. Dies ist das zweite Obergeschoss.");

  AddDetail( ({"boden"}),
	    "Der Boden besteht aus grossen schwarzen Steinquadern. Eine breite "
	    "Treppe fuehrt nach unten.");

  AddDetail( ({"wand","waende","waenden"}),
	    "An den schwarzen Waenden ist nichts zu sehen.");

  AddDetail( ({"decke"}),
	    "Die Decke besteht aus grossen Quadern. Eine Treppe fuehrt durch "
	    "die Decke nach oben in die Turmspitze.");
  
  AddDetail( ({"granit"}),
	    "Der Turm besteht komplett aus schwarzem Granit.");

  AddDetail( ({"interessante","axt","aexte"}), 
            "Die Aexte, die in den Schaedeln stecken, sehen aehnlich aus wie "
	    "die Axt, die Du bei Dir traegst. Ob das ein gutes Zeichen ist?");

  AddDetail( ({"steinquadern","steinquader","quader","quadern"}),
	    "Der Turm besteht aus den grossen Steinquadern.");

  AddDetail( ({"treppe"}),
	    "Jeweils eine Treppe fuehrt nach oben und nach unten.");

  AddDetail( ({"turmspitze","spitze"}),
	    "Wenn Du die Treppe rauf gehst, kommst du in die Turmspitze.");
  
  AddDetail( ({"zeichen"}),
	    "Du solltest nicht anfangen auf Zeichen zu achten. Du hast das "
	    "nicht gelernt.");

  AddDetail( ({"rassen"}), 
            "Du erkennst alle moeglichen Rassen, die es im Silberland gibt.");

  AddDetail( ({"silberland"}),
	    "Es gibt viele verschiedene Lebewesen im Silberland.");

  AddDetail( ({"lebewesen","palette","ameisen","riesen","feen","trollen"}), 
            "Die Palette an Lebewesen reicht von den Ameisen bis zum Riesen "
	    "oder von den Feen bis zu den Trollen.");

  AddDetail( ({"marmor"}),
	    "In den weissen Marmor vom Altar sind Runen eingraviert worden.");

  AddDetail( ({"runen"}), 
            "Die Runen kannst Du zwar nicht entziffern, aber sie strahlen eine "
	    "gewisse Macht aus.");

  AddDetail( ({"macht"}),
	    "Mit Macht kennst Du Dich nicht aus, da Du ja keine besitzt.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Wachs.");  
 
  AddSmell( ({"wachs","duft"}),
	   "Der Duft nach Wachs kommt von den Kerzen.");

  AddSound(DEFAULT_SOUND, "Es ist totenstill.");

//-----Details Ende-----
  
AddExit("unten", ROOM "bdragonq8");
AddExit("oben", ROOM "bdragonq10");


}
