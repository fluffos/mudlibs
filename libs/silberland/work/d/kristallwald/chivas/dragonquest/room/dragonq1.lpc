// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle");
  SetProp( P_INT_LONG,
	"Du stehst auf einem kleinen Felsvorsprung innerhalb der grossen "
	"Schlucht, die die Halle von Ardhmir teilt. Der Spalt, in dem die "
	"Schlucht der grossen Halle verschwindet, ist eher eine Hoehle, die "
	"nach Sueden ins Ungewisse zu fuehren scheint. Die Felswand ausserhalb "
	"der Hoehle ist rissig und ein grosser Riss fuehrt fast bis zum oberen "
	"Ende der Schlucht." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"felsvorsprung","vorsprung","vorsprungs"}), 
            "Du befindest Dich auf einem kleinen Felsvorsprung unterhalb der "
	    "grossen Halle von Ardhmir in der Schlucht, die die Halle teilt. "
	    "Vor Dir tut sich eine Hoehle auf, in die die Schlucht in der "
	    "Suedwand verschwindet.");

  AddDetail( ({"schlucht"}),
	    "Du stehst auf einem kleinen Vorsprung mitten in der Schlucht an "
	    "der Wand. Die Schlucht fuehrt senkrecht an Dir vorbei in die "
	    "Tiefe.");

  AddDetail( ({"halle","meter"}),
	    "Die Halle befindet sich einige Meter ueber Dir. Du musst schon "
	    "hochklettern um wieder in die Halle zu kommen.");

  AddDetail( ({"ardhmir","zwergenfeste"}),
	    "Die Schlucht in der Du Dich befindest, ist in der Zwergenfeste "
	    "von Ardhmir und trennt dort die grosse Halle in zwei Haelften.");
  
  AddDetail( ({"spalt"}),
	    "Der Spalt in den die Schlucht unter der Suedwand zulaeuft, bildet "
	    "eine Hoehle, die weit nach Sueden zu fuehren scheint.");
  
  AddDetail( ({"hoehle","sueden","suedwand"}), 
            "Die Hoehle, die der Spalt bildet, fuehrt nach Sueden ins "
	    "Ungewisse.");

  AddDetail( ({"ungewisse"}),
	    "Da musst Du schon hingehen um mehr zu erfahren. Bist Du mutig "
	    "genug dafuer?");

  AddDetail( ({"felswand","wand","fels"}),
	    "Die Felswand um den Spalt herum ist sehr rissig. Ein grosser "
	    "Riss, der nach oben fuehrt, faellt Dir besonders auf.");

  AddDetail( ({"riss"}),
	    "An dem Riss kannst Du sicher sehr gut nach oben klettern um "
	    "wieder in die Halle zu gelangen.");
  
  AddDetail( ({"ende"}),
	    "Am Ende ist die grosse Halle, aus der Du bereits hier her "
	    "geklettert bist.");

  AddDetail( ({"boden"}), 
            "Der Boden des Vorsprungs ist mit ein paar Steinen bedeckt und "
	    "dadurch ein wenig rutschig. Du musst aufpassen, damit Du nicht "
	    "in die Schlucht faellst.");

  AddDetail( ({"decke"}),
	    "Die Decke der Halle ist von hier nur noch schlecht zu erkennen, "
	    "da sie viel zu hoch ist.");

  AddDetail( ({"waende"}),
	    "Die Waende der Schlucht fuehren senkrecht nach unten in die "
	    "Tiefe.");

  AddDetail( ({"tiefe"}),
	    "Die Schlucht scheint bodenlos zu sein. Sie verengt sich nur an "
	    "der Suedwand zu einem engen Spalt, der eine Hoehle bildet und "
	    "nach Sueden weiter verlaeuft.");
  
  AddDetail( ({"haelften"}),
	    "Die Schlucht trennt die Halle in zwei Haelften, die man nur ueber "
	    "zwei Bruecken ueberwinden kann.");

  AddDetail( ({"bruecken","unterseite"}), 
            "Die beiden Bruecken in der Halle kannst Du von hier aus gut von "
	    "unten erkennen. Jedoch ist die Unterseite der Bruecken sehr "
	    "uninteressant.");

  AddDetail( ({"steine","steinen"}),
	    "Kleinere und groessere Steine liegen auf dem Vorsprung und machen "
	    "den Boden ein wenig rutschig. Sie sind sicher mit der Zeit von "
	    "den Waenden abgebrochen.");

  AddDetail( ({"zeit"}),
	    "Die Zeit vergeht wie im Flug.");

  AddDetail( ({"flug"}),
	    "Wenn Du mal fliegen willst, dann nimm doch den Drachen, der Dich "
	    "in die Klamm fliegt oder den Pegasus, der Dich in die Wolkenstadt "
	    "bringt. Du kannst Dich natuerlich auch einfach nur schlecht "
	    "benehmen und Du fliegst raus.");
  
  AddDetail( ({"drache","maldor","klamm","seelen"}),
	    "Der Drache Mahldor fliegt Abenteurer wie Dich in die Klamm der "
	    "Seelen.");

  AddDetail( ({"abenteurer"}), 
            "Abenteurer wie Du auch einer bist.");

  AddDetail( ({"pegasus","wolkenstadt"}),
	    "Der Pegasus fliegt zur Wolkenstadt, wo einige Feen leben.");

  AddDetail( ({"feen","fee"}),
	    "Die Feen gehoeren zu den Rassen, die im Silberland wohnen.");

  AddDetail( ({"rassen"}),
	    "Es gibt sehr viele Rassen im Silberland. Schau Dich mal um. "
	    "Momentan befindest Du Dich bei den Zwergen von Ardhmir.");
  
  AddDetail( ({"zwerge","zwergen","schale"}),
	    "Die Zwerge sind manchmal ein wenig muerrisch, aber doch ganz "
	    "nett unter ihrer rauhen Schale.");

  AddDetail( ({"silberland"}), 
            "Du befindest Dich im Silberland.");

  AddDetail( ({"lust","sache","grund"}),
	    "Du untersuchst wirklich alles.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig uebel in der Schlucht.");  
 
  AddSmell( ({"schlucht"}),
	   "Ein modriger Geruch kommt aus der Tiefe.");

  AddSmell( ({"geruch","tiefe"}),
	   "Es stinkt und Du hast keine Lust der Sache weiter auf den "
	   "Grund zu gehen.");
  
  
  AddSound(DEFAULT_SOUND, "Du hoerst einen Windzug wie er durch die Schlucht "
		  "weht.");

  AddSound( ({"windzug"}),
	   "Der Windzug ist eher ein Pfeifen, dass man hoert.");
  
  AddSound( ({"pfeifen"}),
	   "*pfeif*");

//-----Details Ende-----
  
AddExit("sueden", ROOM "dragonq2");
AddCmd( ({"kletter", "klettere" }), "klettern" );

}
int klettern(string str)
{
   notify_fail("Wohin moechtest Du woran klettern?\n");
   if ( member( ({ "an riss nach oben","an riss hoch" }),str) != -1) 
  {
    write(BS ( "Du greifst in den Riss an der Felswand und kletterst "
               "an ihm vorsichtig nach oben.\n"));
      TP->move( "/d/kristallwald/chivas/zwergenfeste/room/zwfe23", M_GO, 
      "aus der Hoehle nach oben", "verschwindet", 
      "klettert aus der Schlucht herein");
    return 1;
  }
}

