// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle");
  SetProp( P_INT_LONG,
	"Die Hoehle fuehrt nach oben, wo Du das Flackern von Fackeln zu "
	"erahnen scheinst oder nach Osten in die tiefste Dunkelheit der "
	"Hoehle, wo man nicht genau erkennen kann, was auf einen wartet." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"hoehle","teil"}), 
            "Die untere Hoehle ist recht dunkel und wird nur ein wenig durch "
	    "das Licht von oben erhellt.");

  AddDetail( ({"flackern","fackeln"}),
	    "Durch das breite Loch in der Decke erkennst Du das Flackern von "
	    "Fackeln. In diesem Teil der Hoehle scheint es nichts mehr zu "
	    "geben, was die Umgebung erhellt.");

  AddDetail( ({"osten","weg"}),
	    "Im Osten, wo der Weg weiter geht, herrscht tiefe Dunkelheit.");

  AddDetail( ({"dunkelheit","moeglichkeit","nekromant","drow"}),
	    "Die Dunkelheit im Osten gibt Dir nicht die Moeglichkeit weit zu "
	    "sehen, ausser Du bist ein Nekromant oder Drow.");
  
  AddDetail( ({"boden"}),
	    "Am Boden liegen grosse und kleine Steinbrocken und ein altes "
	    "Skelett.");
  
  AddDetail( ({"waende","ursprung","waenden","wand"}), 
            "Die Waende sind uneben und haben einen natuerlichen Ursprung.");

  AddDetail( ({"decke"}),
	    "In der Decke ist ein breites Loch, durch das Du in den oberen "
	    "Teil der Hoehle klettern kannst.");

  AddDetail( ({"loch"}),
	    "Ein breites Loch fuehrt in den oberen Teil der Hoehle, aus dem "
	    "Du ja hier her gekommen bist. Du kannst also immer noch umkehren "
	    "und zurueck gehen.");

  AddDetail( ({"umgebung","lichtquellen"}),
	    "Hier gibt es keine Fackeln mehr oder andere Lichtquellen.");
  
  AddDetail( ({"steinbrocken","brocken"}),
	    "Grosse und kleine Brocken liegen auf dem Boden. Sie sind "
	    "anscheinend von der Decke oder den Waenden abgebrochen.");

  AddDetail( ({"skelett"}), 
            "Ein bleiches Skelett liegt am Boden. Es sieht so aus, als ob "
	    "es von oben herunter gefallen ist. Anscheinend wurde ein armer "
	    "Abenteurer von irgendeinem Wesen angegriffen und hat hier seine "
	    "letzte Ruhestaette gefunden. Dem Skelett fehlt die linke Hand. "
	    "Wo die wohl geblieben ist?");

  AddDetail( ({"wesen"}),
	    "Bisher bist Du noch auf kein unheimliches Wesen gestossen, dass "
	    "diesen Abenteurer gefressen haben muss. Bleib wachsam!");

  AddDetail( ({"abenteurer"}),
	    "Ein Abenteurer wie Du auch einer bist.");

  AddDetail( ({"hand"}),
	    "Die eine Hand fehlt. Entweder sie ist irgendwo oder der "
	    "Abenteurer hatte nur noch eine.");
  
  AddDetail( ({"ruhestaette"}),
	    "Du kannst Dir eine nettere Ruhestaette als diese Hoehle "
	    "vorstellen.");

  AddDetail( ({"licht"}), 
            "Das einzige Licht was es hier gibt, dass kommt von oben durch "
	    "das Loch.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Rauch.");  
 
  AddSmell( ({"rauch","geruch"}),
	   "Der Geruch von Rauch ist nur ganz leicht und kommt aus dem Osten.");

  AddSound(DEFAULT_SOUND, "Es ist totenstill und irgendwie unheimlich.");

//-----Details Ende-----
  
AddExit("oben", ROOM "dragonq3");
AddExit("osten", ROOM "dragonq5");

}
