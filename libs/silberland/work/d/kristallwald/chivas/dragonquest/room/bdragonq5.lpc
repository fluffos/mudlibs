// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Lichtung mit einem schwarzen Turm");
  SetProp( P_INT_LONG,
	"Die suedliche Seite des Turms unterscheidet sich auf keine Weise von "
	"den anderen Seiten. Ein Eingang fuehrt auch von hier in das Innere "
	"des Turms. Direkt vor dem Turm liegt ein langes Seil am Boden, dass "
	"wohl Jemand hier vergessen oder verloren hat." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"seite","teil"}), 
            "Du bist im suedlichen Teil der Lichtung. Der Turm ist in der "
	    "Mitte und rings um die Lichtung herum stehen die grossen Baeume "
	    "des Waldes.");

  AddDetail( ({"turm","turms","mitte","eindruck"}),
	    "Der Turm steht in der Mitte der Lichtung. Er macht einen "
	    "duesteren Eindruck.");

  AddDetail( ({"weise","seiten"}),
	    "Der Turm sieht auf allen Seiten gleich schwarz aus.");

  AddDetail( ({"eingang","innere","norden"}),
	    "Nach Norden kommst Du in das Innere des Turms.");
  
  AddDetail( ({"seil","stuecke"}),
	    "Ein Seil liegt vor dem Turm. Es ist in Stuecke gerissen und "
	    "teilweise angebrannt. Anscheinend hat ein Abenteurer versucht "
	    "von aussen am Turm hoch zu klettern und ist klaeglich "
	    "gescheitert.");

  AddDetail( ({"boden"}), 
            "Am Boden sind einige Steinchen auf dem Pfad zu sehen, der um den "
	    "Turm herum fuehrt. Ansonsten ist Gras auf der Lichtung zu sehen.");

  AddDetail( ({"jemand"}),
	    "Der Jemand war sicher kein Magier, sondern ein Abenteurer wie "
	    "Du.");

  AddDetail( ({"himmel","sonne"}),
	    "Der Himmel ist schoen blau und die Sonne lacht von oben auf Dich "
	    "herab.");

  AddDetail( ({"wald","waldes"}),
	    "Der Wald ist rings um die Lichtung herum.");
  
  AddDetail( ({"lichtung","lichtungen"}),
	    "Du stehst auf einer Lichtung, in dessen Mitte sich ein grosser "
	    "schwarzer Turm befindet.");

  AddDetail( ({"baeume"}), 
            "Die Baeume des Waldes stehen sehr eng zusammen, so dass es nicht "
	    "moeglich ist die Lichtung durch den Wald zu verlassen.");

  AddDetail( ({"abenteurer"}),
	    "Du bist auch ein Abenteurer, der auf so dumme Ideen kommen kann "
	    "und scheitern wird, den Drachen des Turms zu toeten.");

  AddDetail( ({"pfad","pfaden"}),
	    "Der Pfad fuehrt um den Turm herum.");

  AddDetail( ({"gras"}),
	    "Das Gras ist ein wenig blasser als auf anderen Lichtungen, die Du "
	    "bisher gesehen hast.");
  
  AddDetail( ({"magier"}),
	    "Magier idlen immer nur und machen nichts.");

  AddDetail( ({"ideen","idee"}), 
            "Du hast manchmal nicht die besten Ideen.");

  AddDetail( ({"drache","drachen"}),
	    "Der Drache im Turm ist boesartig und gemein.");

  AddDetail( ({"steinchen"}),
	    "Ganz normale Steinchen, wie man sie auf allen Pfaden findet.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Gras.");  
 
  AddSmell( ({"gras"}),
	   "Das Gras riecht nicht so frisch wie auf anderen Lichtungen, wo Du "
	   "bereits warst.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind ueber die Lichtung wehen.");

  AddSound( ({"wind"}),
	   "*weh*weh*weh*weh*weh*weh*");

//-----Details Ende-----
  
AddExit("nordosten", ROOM "bdragonq3");
AddExit("nordwesten", ROOM "bdragonq6");
AddSpecialExit( "norden", "go_n" );

}
int go_n(string dir)
{

  if(!(present("\ndqaxt", TP)))
  {
    write( BS( "Eine unheimliche und dunkle Macht scheint Dich zu laehmen und "
	       "Dich davon abzuhalten den Turm zu betreten. Du solltest schon "
	       "die richtige Waffe bei Dir haben um Dich dem Wesen im Turm zu "
	       "stellen.") );
    say("Eine unheimliche und dunkle Macht haelt "+TP->Name(WEN)+" davon ab, "
      "den Turm zu betreten.\n");
    TP->AddHp(-50);
    return -1;
  }
  write(BS("Du gehst mit der magischen Axt bewaffnet voller Mut in den Turm. "
	   "Nichts wird Dich jetzt noch aufhalten koennen.\n"));
 
  say(TPN+" verschwindet im Turm.\n");
  this_player()->move(ROOM "bdragonq7", M_TPORT);
  return 1;
}
