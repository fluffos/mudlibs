// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Lichtung mit einem schwarzen Turm");
  SetProp( P_INT_LONG,
	"Die Westseite des Turms wirkt genau so schwarz und bedrohlich wie "
	"die anderen Seiten. Der Eingang macht auch hier keinen besseren "
	"Eindruck auf Dich. Es wirkt hier sogar noch ein wenig duesterer, was "
	"vielleicht auch an den Baeumen liegen kann, die an dieser Seite ein "
	"wenig dichter am Turm stehen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"westseite","seite","westen","rest"}), 
            "Du stehst im Westen der Lichtung. Hier sind die Baeume des Waldes "
	    "dichter an den Turm gerueckt und es wirkt duesterer als auf dem "
	    "Rest der Lichtung.");

  AddDetail( ({"turm","turms","mittelpunkt"}),
	    "Der schwarze Turm ist der Mittelpunkt der Lichtung. Er erhebt "
	    "sich vor Dir in den blauen Himmel.");

  AddDetail( ({"seiten"}),
	    "Der schwarze Turm wirkt auf allen Seiten bedrohlich.");

  AddDetail( ({"eingang"}),
	    "Ein Eingang in den Turm befindet sich oestlich von Dir.");
  
  AddDetail( ({"eindruck"}),
	    "Der Eingang sieht auch nicht besser aus als die anderen auf "
	    "den anderen Seiten des Turms.");

  AddDetail( ({"baeume","baeumen"}), 
            "Die dunklen Baeume des Waldes sind hier naeher an den Turm "
	    "gerueckt und verstaerken die duestere Stimmung in diesem Teil "
	    "der Lichtung.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit Steinchen und Gras bedeckt. Du stehst auf einem "
	    "kleinen Pfad, der um den Turm herum fuehrt.");

  AddDetail( ({"himmel","sonne"}),
	    "Der Himmel ist blau und die Sonne scheint.");

  AddDetail( ({"waldes","wald","moeglichkeit"}),
	    "Der Wald umschliesst die Lichtung und es gibt keine Moeglichkeit "
	    "die Lichtung zu verlassen.");
  
  AddDetail( ({"gras","naehe"}),
	    "Das Gras wirkt in der Naehe vom Turm sehr blass und kraenklich.");

  AddDetail( ({"steinchen"}), 
            "Die Steinchen sind total uninteressant.");

  AddDetail( ({"stimmung","teil"}),
	    "Es herrscht eine duestere Stimmung in diesem Teil der Lichtung.");

  AddDetail( ({"lichtung"}),
	    "Du stehst nun auf der westlichen Seite der Lichtung.");

  AddDetail( ({"pfad"}),
	    "Der Pfad auf dem Du stehst, fuehrt Dich ueber die Lichtung um "
	    "den Turm herum.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht hier nach absolut gar nichts.");  
 
  AddSound(DEFAULT_SOUND, "Es ist hier totenstill und das beunruhigt Dich ein "
		  "wenig.");

//-----Details Ende-----
  
AddExit("nordosten", ROOM "bdragonq4");
AddExit("suedosten", ROOM "bdragonq5");
AddSpecialExit( "osten", "go_o" );

}
int go_o(string dir)
{

  if(!(present("\ndqaxt", TP)))
  {
    write( BS( "Eine unheimliche und dunkle Macht scheint Dich zu laehmen und "
	       "Dich davon abzuhalten den Turm zu betreten. Du solltest schon "
	       "die richtige Waffe bei Dir haben um Dich dem Wesen im Turm zu "
	       "stellen.") );
    say("Eine unheimliche und dunkle Macht haelt "+TP->Name(WEN)+" davon ab, "
      "den Turm zu betreten.\n");
    TP->AddHp(-50);
    return -1;
  }
  write(BS("Du gehst mit der magischen Axt bewaffnet voller Mut in den Turm. "
	   "Nichts wird Dich jetzt noch aufhalten koennen.\n"));
 
  say(TPN+" verschwindet im Turm.\n");
  this_player()->move(ROOM "bdragonq7", M_TPORT);
  return 1;
}
