// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem schwarzen Turm");
  SetProp( P_INT_LONG,
	"Du stehst im Erdgeschoss des schwarzen Turms. Durch die Ausgaenge in "
	"alle vier Himmelsrichtungen faellt genug Licht in den Turm, so dass "
	"es kein Problem gibt, alles genau zu sehen. Die schwarzen Quader, die "
	"die Waende bilden sind mit einigen Runen und kleinen Zeichnungen "
	"versehen. Eine steinernde Treppe fuehrt Dich weiter nach oben in den "
	"Turm." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"erdgeschoss"}), 
            "Du stehst im Erdgeschoss des schwarzen Turms. Eine Treppe fuehrt "
	    "Dich naeher an den boesen Drachen heran.");

  AddDetail( ({"turm","turms","ausstrahlung"}),
	    "Der schwarze Turm hat eine sehr negative Ausstrahlung auf Dich. "
	    "Deine Nackenhaare stellen sich bei dem Gedanken weiter nach "
	    "oben zu gehen auf.");

  AddDetail( ({"ausgaenge","himmelsrichtungen","norden","sueden","osten","westen","lichtung"}),
	    "Es gibt Ausgaenge nach Norden, Sueden, Osten und Westen. Wenn Du "
	    "raus gehst, stehst Du auf der Lichtung, die den Turm "
	    "umschliesst.");

  AddDetail( ({"licht"}),
	    "Das Licht, dass von der Lichtung durch die Ausgaenge einfaellt "
	    "reicht aus um alles genau zu erkennen.");
  
  AddDetail( ({"problem","probleme"}),
	    "Du hast doch nie Probleme.");

  AddDetail( ({"quader","steinquadern","steinquader","granit"}), 
            "Der Turm besteht aus grossen Steinquadern. Die Steinquader sind "
	    "aus schwarzem harten Granit.");

  AddDetail( ({"waende","wand"}),
	    "Die Waende sind mit Runen und Zeichnungen uebersaeht.");

  AddDetail( ({"runen","macht"}),
	    "Die Runen kannst Du leider nicht entziffern. Sie strahlen aber "
	    "eine gewisse Macht aus.");

  AddDetail( ({"zeichnungen"}),
	    "Die Zeichnungen stellen einen Drachen dar, der unsagbar "
	    "grausame Dinge tut.");
  
  AddDetail( ({"treppe"}),
	    "Eine steinernde Treppe fuehrt nach oben in den Turm.");

  AddDetail( ({"boden"}), 
            "Der Boden besteht aus grossen schwarzen Steinquadern.");

  AddDetail( ({"decke"}),
	    "Die Decke ist schmucklos und besteht wie die Waende und der Boden "
	    "aus schwarzem Granit.");

  AddDetail( ({"drachen","drache"}),
	    "In der Turmspitze lebt ein gefaehrlicher und boesartiger Drache.");

  AddDetail( ({"dinge"}),
	    "Die Dinge werden aufgrund jugendlicher Mudder nicht weiter "
	    "beschrieben.");
  
  AddDetail( ({"mudder"}),
	    "Wie Du auch einer bist.");

  AddDetail( ({"turmspitze","spitze"}), 
            "Die Turmspitze ist weit ueber Dir.");

  AddDetail( ({"gedanken"}),
	    "Gedanken sind etwas sehr wichtiges.");

  AddDetail( ({"nackenhaare"}),
	    "Du hast sehr viele Nackenhaare.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst das Gras und die Baeume der Lichtung.");  
 
  AddSmell( ({"gras"}),
	   "Das Gras riecht frisch.");

  AddSmell( ({"baeume","wald"}),
	   "Die Baeume riechen nach Wald.");
  
  
  AddSound(DEFAULT_SOUND, "Du hoerst den Wind durch die Baeume draussen "
		          "rauschen.");

  AddSound( ({"baeume","wind"}),
	   "*rausch*");

//-----Details Ende-----
AddExit("norden", ROOM "bdragonq4");
AddExit("westen", ROOM "bdragonq6");
AddExit("sueden", ROOM "bdragonq5");
AddExit("osten", ROOM "bdragonq3");
AddExit("oben", ROOM "bdragonq8");


}
