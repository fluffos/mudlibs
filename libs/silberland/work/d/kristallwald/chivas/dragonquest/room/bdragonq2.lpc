// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Pfad schlaengelt sich unaufhaltsam von Westen nach Osten. Die "
	"grossen Baeume um Dich herum machen hier nun einen etwas duesteren "
	"Eindruck, als ob Du hier nicht erwuenscht bist. Im Westen scheint der "
	"Pfad auf eine Lichtung im dichten Wald zu fuehren, auf der ein "
	"grosser schwarzer Turm steht." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"pfad"}), 
            "Der Pfad fuehrt nach Westen auf eine Lichtung oder zurueck nach "
	    "Osten, wo die Straeucher sind, durch die Du hier her gekommen "
	    "bist.");

  AddDetail( ({"westen"}),
	    "Im Westen befindet sich eine Lichtung mit einem grossen "
	    "schwarzen Turm.");

  AddDetail( ({"osten"}),
	    "Im Osten den Pfad entlang kommst Du zu den Straeuchern, durch die "
	    "Du hier her gekommen bist.");

  AddDetail( ({"baeume","rand"}),
	    "Die Baeume stehen hier nicht mehr so dicht und verschwinden im "
	    "Westen vor dir komplett, da dort eine Lichtung mit einem Turm "
	    "ist. Die Baeume schmiegen sich an den Rand der Lichtung.");
  
  AddDetail( ({"eindruck","gefuehl"}),
	    "Du hast halt so ein Gefuehl.");

  AddDetail( ({"lichtung"}), 
            "Die Lichtung oeffnet sich im Westen vor Dir. Ein grosser Turm ist "
	    "auf ihr zu sehen.");

  AddDetail( ({"wald"}),
	    "Der Wald hat im Westen eine grosse Lichtung.");

  AddDetail( ({"turm"}),
	    "Der Turm ist schwarz und sehr hoch. Geh einfach hin und schau "
	    "ihn Dir genauer an.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen einige Blaetter, Steine und Zweige.");
  
  AddDetail( ({"himmel","blaetterdach","tag"}),
	    "Der Himmel ist durch das lichter werdende Blaetterdach gut zu "
	    "erkennen. Es ist ein schoener Tag mit blauem Himmel.");

  AddDetail( ({"straeucher","straeuchern"}), 
            "Die Straeucher befinden sich irgendwo im Osten.");

  AddDetail( ({"blaetter"}),
	    "Viele Blaetter haengen an den Baeumen und einige sind auch auf "
	    "den Pfad gefallen.");

  AddDetail( ({"steine"}),
	    "Einige unbedeutende Steine liegen am Boden.");

  AddDetail( ({"zweige"}),
	    "Ein paar Zweige sind auf den Pfad gefallen.");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({""}), 
            "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Baeumen.");  
 
  AddSmell( ({"baeume"}),
	   "Die Baeume duften nach Wald.");

  AddSmell( ({"wald"}),
	   "Es riecht sehr waldig.");
  
  
  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel zwitschern.");

  AddSound( ({"voegel"}),
	   "Die Voegel zwitschern hoch in den Baeumen.");

//-----Details Ende-----
  
AddExit("westen", ROOM "bdragonq3");
AddExit("osten", ROOM "bdragonq1");

}
