// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle");
  SetProp( P_INT_LONG,
	"Die Hoehle fuehrt weiter nach Osten und es scheint auch waermer zu "
	"werden. Von der Decke tropft es an ein paar Stellen auf den Boden. "
	"Es ist sehr feucht und schwuel in diesem Teil der Hoehle." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 0);

//-----Details Anfang-----
  
  AddDetail( ({"hoehle","teil"}), 
            "Die Hoehle ist finster und es scheint waermer in Richtung Osten "
	    "zu werden.");

  AddDetail( ({"osten","richtung"}),
	    "Im Osten fuehrt die finstere Hoehle weiter.");

  AddDetail( ({"decke","hoehlendecke"}),
	    "Die Decke ist hoch ueber Dir und einige Stalagtiten sind zu "
	    "sehen. Es tropft regelmaessig von der Decke, so dass sich "
	    "kleinere Pfuetzen am Boden bilden.");

  AddDetail( ({"tropfen"}),
	    "Einige Tropfen fallen von der Decke auf den Boden.");
  
  AddDetail( ({"stellen"}),
	    "An einigen Stellen tropft es regelmaessig von der Decke.");
  
  AddDetail( ({"boden"}), 
            "Am Boden habe sich kleine Pfuetzen von den Tropfen gebildet, die "
	    "von der Decke auf den Boden fallen.");

  AddDetail( ({"waende","wand"}),
	    "Die Waende sind nicht sehr interessant. Einige Moose haben sich "
	    "in der Dunkelheit an ihnen festgesetzt.");

  AddDetail( ({"stalagtiten","jahre"}),
	    "Die Stalagtiten wachsen langsam von der Hoehlendecke zum Boden. "
	    "Sie werden aber noch ein paar tausend Jahre brauchen um den "
	    "Boden zu erreichen.");

  AddDetail( ({"pfuetzen","wasser"}),
	    "Kleine Pfuetzen haben sich am Boden gebildet. Du musst "
	    "aufpassen, sonst hast Du bald nasse Fuesse.");
  
  AddDetail( ({"moose"}),
	    "Wie die Moose hier in der Dunkelheit ueberleben koennen, ist Dir "
	    "ein Raetsel.");

  AddDetail( ({"raetsel","sache"}), 
            "Raetsel sind nicht so Deine Sache, eigentlich alles was mit dem "
	    "Kopf zu tun hat. Er tut schon wieder weh vom Nachdenken.");

  AddDetail( ({"kopf","nachdenken"}),
	    "Du untersuchst wirklich alles.");



  AddDetail( ({"dunkelheit"}),
	    "Es herrscht tiefe Dunkelheit in diesem Teil der Hoehle.");

  AddDetail( ({"fuesse"}),
	    "Du hast sehr grosse Fuesse.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nun staerker nach Rauch.");  
 
  AddSmell( ({"rauch","quelle","rauches"}),
	   "Die Quelle des Rauches kannst Du leider noch nicht ausmachen.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Tropfen.");

  AddSound( ({"tropfen"}),
	   "*plitsch*platsch*");
  
//-----Details Ende-----
  
AddExit("nordwesten", ROOM "dragonq5");
AddExit("osten", ROOM "dragonq7");

}
