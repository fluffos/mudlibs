// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle");
  SetProp( P_INT_LONG,
	"Von Westen scheint durch einen gemeisselten Torbogen leuchtend rotes "
	"Feuer aus einer Kammer und erhellt die Hoehle in der Du stehst. Der "
	"Boden und die Waende sind mit Moosen bewachsen, die anscheinend sehr "
	"gut im Schein des Feuers gedeihen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"westen","torbogen","bogen"}), 
            "Im Westen ist ein grosser Torbogen, durch den man die dahinter "
	    "liegende Kammer betreten kann. Der Torbogen ist mit vielen "
	    "Edelsteinen besetzt.");

  AddDetail( ({"feuer","feuers"}),
	    "Das Feuer aus der Kammer erhellt die Hoehle in der Du stehst und "
	    "hat natuerlich auch die Temperatur weiter erhoeht.");

  AddDetail( ({"kammer"}),
	    "Die Kammer erreichst Du, in dem Du nach Westen gehst und durch "
	    "den Bogen schreitest.");

  AddDetail( ({"hoehle","abschluss"}),
	    "Du bist tief in die Hoehle vorgedrungen, die in der Kammer im "
	    "Westen wohl ihren Abschluss findet.");
  
  AddDetail( ({"boden"}),
	    "Am Boden sind einige kleine Pfuetzen und viel Moos zu sehen.");

  AddDetail( ({"waende","wand"}), 
            "Die Waende sind mit Moos bewachsen. Auch ein paar Flechten sind "
	    "zu sehen.");

  AddDetail( ({"moose","moosen","moos","farbe"}),
	    "Die Moose haben eine dunkelgruene Farbe und scheinen im Licht "
	    "des Feuers gut zu wachsen.");

  AddDetail( ({"schein"}),
	    "Der Schein des Feuers aus der Kammer erhellt die Hoehle.");

  AddDetail( ({"decke","hoehlendecke"}),
	    "Ab und zu tropft es von der Decke der Hoehle.");
  
  AddDetail( ({"edelsteinen","edelsteine"}),
	    "Die Edelsteine sind hauptsaechlich grosse Rubine und Smaragde.");

  AddDetail( ({"rubine","smaragde"}), 
            "Die Rubine und Smaragde bilden Zeichen.");

  AddDetail( ({"zeichen"}),
	    "Du kannst die Zeichen lesen.");

  AddDetail( ({"temperatur","grad","celsius"}),
	    "Du fuehlst, dass es ungefaehr 30 Grad Celsius hier sein muessen.");

  AddDetail( ({"pfuetzen","wasser"}),
	    "Die kleinen Pfuetzen haben sich durch die Tropfen gebildet, die "
	    "von der Decke fallen.");
  
  AddDetail( ({"tropfen"}),
	    "Es tropft stetig von der Hoehlendecke.");

  AddDetail( ({"flechten"}), 
            "Die Flechten scheinen sich hier in der Hoehle sehr wohl zu "
	    "fuehlen, da sie hervorragend gedeihen.");

  AddDetail( ({"wolken","rauch"}),
	    "Kleine Wolken quellen aus der Kammer in die Hoehle.");

  AddDetail( ({"licht"}),
	    "Der Schein des Feuers erhellt die Hoehle.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Rauch.");  
 
  AddSmell( ({"rauch"}),
	   "Der Rauch kommt aus der Kammer und zieht in kleinen Wolken in "
	   "die Hoehle.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Feuer in der Kammer im Westen "
		          "knistern.");

  AddSound( ({"feuer","kammer","westen"}),
	   "*knister*");
  
  AddReadDetail( ({"zeichen"}),
		"Hier lebt Anezram, der weisse Drache.");


//-----Details Ende-----
  
AddExit("westen", ROOM "dragonq9");
AddExit("sueden", ROOM "dragonq7");

}
