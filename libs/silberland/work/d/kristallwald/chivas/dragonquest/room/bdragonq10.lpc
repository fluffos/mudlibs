// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem schwarzen Turm");
  SetProp( P_INT_LONG,
	"In der Turmspitze ist es sehr heiss. Auf dem Boden liegen ueberall "
	"die Knochen verschiedenster Rassen, die im Schein der Fackeln an den "
	"Waenden sauber und ordentlich abgenagt aussehen. Genau in der Mitte "
	"der Turmspitze ist ein riesiges Lager aus Gold und Edelsteinen "
	"aufgehaeuft. Es dient wohl als Ruhestaette fuer den Besitzer des "
	"Turms." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 35, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"turmspitze","spitze"}), 
            "Du hast die Turmspitze im schwarzen Turm erreicht. Gratuliere.");

  AddDetail( ({"boden"}),
	    "Auf dem Boden liegen lauter Knochen und in der Mitte ist ein "
	    "Lager aus Gold und Edelsteinen aufgehaeuft worden. Ansonsten "
	    "sieht man die grossen schwarzen Quader, die den Boden, die Waende "
	    "und die Decke bilden. Eine breite Treppe fuehrt durch ein Loch "
	    "im Boden zu den anderen Geschossen des Turms.");

  AddDetail( ({"knochen"}),
	    "Die Knochen sehen sauber abgenagt aus. Du bist froh, dass es "
	    "nicht Deine Knochen sind, die hier so sauber 'geputzt' wurden. "
	    "Sie gehoeren anscheinend verschiedenen Rassen, da sie sich in "
	    "Groesse und Form unterscheiden.");

  AddDetail( ({"rassen","groesse","form"}),
	    "Du entdeckst Knochen von Menschen, Elfen oder Dunkelelfen, "
	    "Zwergen, Trollen, Ogern, Feen und Hobbits.");
  
  AddDetail( ({"schein","licht"}),
	    "Der Schein der Fackeln spendet genug Licht um alles genau zu "
	    "erkennen.");
  
  AddDetail( ({"fackeln","halterungen"}), 
            "Die Fackeln haengen in Halterungen an den Waenden und erhellen "
	    "die Turmspitze.");

  AddDetail( ({"wand","waende","waenden"}),
	    "An den schwarzen Waenden aus grossen Quadern haengen einige "
	    "Fackeln in ihren Halterungen. Ansonsten ist hier nicht viel "
	    "zu erkennen.");

  AddDetail( ({"mitte"}),
	    "In der Mitte der Turmspitze ist ein Lager aus Gold und "
	    "Edelsteinen angehaeuft worden. Es blitzt und funkelt im Schein "
	    "der Fackeln.");

  AddDetail( ({"lager"}),
	    "Das ganze Lager besteht aus Gold und vielen Juwelen.");
  
  AddDetail( ({"gold","barren","muenzen"}),
	    "Das Gold blitzt im Schein der Fackeln. Du erkennst grosse Barren, "
	    "aber auch kleine Muenzen, die aus Gold bestehen.");

  AddDetail( ({"edelsteine","edelsteinen","juwelen"}), 
            "Viele Edelsteine sind zu sehen, die im Licht der Fackeln funkeln.");

  AddDetail( ({"ruhestaette"}),
	    "Das Lager wird anscheinend als Ruhestaette des Besitzers des "
	    "Turms genutzt. Es sieht nicht sehr bequem aus, aber Du bist ja "
	    "auch kein Drache.");

  AddDetail( ({"besitzer","drache","besitzers"}),
	    "Der Besitzer des Turms ist ein alter boesartiger Drache.");

  AddDetail( ({"turm","turms"}),
	    "Du befindest Dich in einem schwarzen Turm in der Naehe der "
	    "Hochebene von Gorthad.");
  
  AddDetail( ({"decke"}),
	    "Die Decke ist schmucklos bis auf ein paar alte Spinnweben.");

  AddDetail( ({"treppe","loch","geschosse","geschossen","weg","ausgang"}), 
            "Eine breite Treppe fuehrt nach unten in die anderen Geschosse des "
	    "Turms. Dieser Weg ist fuer Dich der einzige Ausgang.");

  AddDetail( ({"quader","steinquader"}),
	    "Der ganze Turm besteht aus diesen grossen schwarzen Steinquadern. "
	    "Sie bestehen anscheinend aus schwarzem Granit.");

  AddDetail( ({"granit","gestein"}),
	    "Granit ist ein sehr hartes Gestein.");

  AddDetail( ({"menschen"}),
	    "Du hast schon oft Knochen von Menschen gesehen, daher bist Du "
	    "sicher, dass hier auch welche gestorben sind.");
  
  AddDetail( ({"elfen","dunkelelfen","menge"}),
	    "Die Knochen von Elfen und Dunkelelfen sind nicht zu "
	    "unterscheiden. Es liegen jedenfalls eine grosse Menge davon "
	    "herum.");

  AddDetail( ({"trollen","trolle","ueberresten","ueberreste","kraft","troll"}), 
            "Die Knochen der Trolle sind die groessten, die hier herum liegen. "
	    "Man braucht schon einige Kraft um einem Troll die Knochen zu "
	    "brechen, was man aus den Ueberresten ersehen kann.");

  AddDetail( ({"ogern","oger","haut","muskeln","fett"}),
	    "Die Knochen der Oger sind besonders breit und sehen sogar ohne "
	    "Haut, Muskeln und Fett recht plump aus.");

  AddDetail( ({"zwergen","zwerge"}),
	    "Die Knochen der Zwerge sind ein wenig groesser als die der "
	    "Hobbits. Ausserdem sehen sie stabiler aus.");

  AddDetail( ({"feen"}),
	    "Die Knochen der Feen sehen klein und zierlich aus, so wie Feen "
	    "halt sind.");
  
  AddDetail( ({"hobbits"}),
	    "Die Knochen der Hobbits sehen kleiner als die der Zwerge aus. "
	    "Ansonsten unterscheiden diese sich nur dadurch, dass die "
	    "Knochen der Zwerge ein wenig stabiler aussehen.");

  AddDetail( ({"naehe","hochebene","gorthad","huegelgraebern","huegelgraeber","graeber"}), 
            "Die Hochebene von Gorthad mit ihren Huegelgraebern ist ganz in "
	    "der Naehe vom schwarzen Turm.");

  AddDetail( ({"spinnweben"}),
	    "Die Spinnweben an der Decke sind kaputt und wurden schon vor "
	    "langer Zeit von den Spinnen aufgegeben.");

  AddDetail( ({"zeit"}),
	    "Es ist lange her.");

  AddDetail( ({"spinnen"}),
	    "Igitt, Spinnen!");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Tod und Verderben.");  
 
  AddSmell( ({"tod","verderben"}),
	   "Bis gerade eben wusstest Du nicht wie Tod und Verderben riechen.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Flackern der Fackeln.");

  AddSound( ({"fackeln","flackern"}),
	   "*flacker*");

//-----Details Ende-----

AddItem(NPC "akinaj", REFRESH_DESTRUCT); 

AddExit("unten", ROOM "bdragonq9");

AddCmd( ({"toete" }), "toeten" ); 

}
int toeten(string str)
{
object dragoninvis3;
notify_fail("Wen moechtest Du toeten?\n");
 if ( member( ({ "akinaj", "drache","alle" }),str) != -1) 
  {
 if(!present("akinaj"))
 {
  write(BS("Aber Akinaj ist doch gar nicht da!"));
  return -1;
 }
 if(!present("drachentoeter", TP))
 {
  write(BS("Du hast ja gar nicht die Axt bei Dir!"));
  return -1;
 }
 if(present("dragoninvis4", TP))
 {
  write(BS("Du bist einen Deal mit mir eingegangen und der Deal beschuetzt "
	   "mich. Nun belaestige mich nicht weiter und kuemmer Dich um "
	   "Anezram!\n"
	   "Akinaj gibt Dir mit dem Schwanz einen Schlag, so dass Du die "
	   "ganze Treppe herunter kugelst und vor dem Turm landest."));
      TP->move( ROOM "bdragonq3", M_GO, 
      "wird von Akinaj die Treppe herunter geschubst", "verschwindet", 
      "kommt aus dem Turm gekugelt");
      return -1;
 }
 if(!present("dragoninvis3", TP))
    {
    write(BS( "Akinaj sagt: Okay, Du bist also gekommen mich zu toeten. Aber "
	      "bevor ich Dich vernichte wie Deine Vorgaenger, gebe ich Dir die "
	      "Chance einen Deal einzugehen. Probiere nicht mich zu toeten, "
	      "sondern Anezram, der so wiederlich gut ist. Fuer dieses "
	      "Geschaeft gebe ich Dir eine Belohnung. Tippe 'bestaetige deal' "
	      "und unser Pakt steht oder probiere mich noch einmal zu toeten "
	      "und es wird kein Angebot mehr geben und Du wirst vernichtet. "
	      "Aber bedenke, gehst Du einmal dieses Geschaeft ein, so bist Du "
	      "daran gebunden und der Deal beschuetzt mich.\n"));
  dragoninvis3=clone_object(OBJ "dragoninvis3")->move(TP, M_NOCHECK);
  return 1;
    }
    else
    {
    write(BS( "Du nimmst die Axt in beide Haende und begibst Dich in einen "
	      "Kampf mit Akinaj. \n"
	      "Die Axt beginnt in Deinen Haenden zu gluehen. Sie scheint zu "
	      "merken, dass Du Etwas boeses vernichten willst. An jeder Stelle "
	      "an der Du den Drachen triffst, beginnt er sich aufzuloesen. Den "
	      "Todesstoss verpasst Du ihm jedoch mit einer gekonnten "
	      "Koerperdrehung, wobei Du den Drachen triffst und ihm den "
	      "Schaedel spaltest.\n"));
  if (present("dragoninvis1",TP))
  present("dragoninvis1",TP)->remove();
  if (present("dragoninvis3",TP))
  present("dragoninvis3",TP)->remove();
  present("akinaj")->remove();
  return 1;   
    }
  }
}

