// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle");
  SetProp( P_INT_LONG,
	"Aus dem Norden dringt ein wenig Licht bis hier her. Die Waende sind "
	"weiterhin unbehauen und kahl. Am Boden haben sich ein paar kleinere "
	"Pfuetzen gebildet, die stetig von den Tropfen der Decke gefuellt "
	"werden. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1);

//-----Details Anfang-----
  
  AddDetail( ({"norden","licht"}), 
            "Aus dem Norden ist ein wenig Licht zu erkennen, so dass man hier "
	    "auch als normaler Abenteurer und nicht nur als Drow oder "
	    "Nekromant etwas sehen kann.");

  AddDetail( ({"waende","wand"}),
	    "Die Waende sind schmucklos und nichts ist an ihnen zu sehen. Nur "
	    "ein paar Flechten haben sich an ihnen fest gesetzt.");

  AddDetail( ({"boden"}),
	    "Am Boden haben sich lauter Pfuetzen von den Tropfen gebildet.");

  AddDetail( ({"pfuetzen","wasser"}),
	    "Die Pfuetzen sind flach und nicht tief, trotzdem kannst Du Dir "
	    "hier leicht nasse Fuesse holen, wenn Deine Schuhe nicht dicht "
	    "sind.");
  
  AddDetail( ({"tropfen"}),
	    "Staendig fallen Tropfen von der Decke auf den Boden.");
  
  AddDetail( ({"decke"}), 
            "Die Decke ist ueber Dir. Wo sollte sie auch sonst sein.");

  AddDetail( ({"drow","rasse"}),
	    "Die Drow sind eine boesartige Rasse im Silberland.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland.");

  AddDetail( ({"nekromant","nekromanten","gilde"}),
	    "Die Nekromanten sind eine Gilde im Silberland.");
  
  AddDetail( ({"flechten"}),
	    "Die Flechten koennen anscheinend auch bei wenig Licht hier gut "
	    "wachsen.");

  AddDetail( ({"fuesse"}), 
            "Nasse Fuesse sind wirklich ekelig.");

  AddDetail( ({"schuhe","stiefel"}),
	    "Nasse Schuhe oder Stiefel wieder trocken zu bekommen ist in einer "
	    "nassen Hoehle sehr schwer, wenn nicht sogar unmoeglich.");

  AddDetail( ({"abenteurer"}),
	    "Abenteurer, wie Du auch einer bist.");

  AddDetail( ({"hoehle"}),
	    "Du befindest Dich in einer Hoehle.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Der Geruch nach Rauch wird staerker.");  
 
  AddSmell( ({"geruch","rauch"}),
	   "Der Rauch scheint aus dem Norden zu kommen.");

  AddSound(DEFAULT_SOUND, "Die Tropfen verursachen ein leises Geraeusch.");

  AddSound( ({"tropfen","geraeusch"}),
	   "*platsch*plitsch*platsch*");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "dragonq8");
AddExit("westen", ROOM "dragonq6");

}
