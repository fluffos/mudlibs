// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem schwarzen Turm");
  SetProp( P_INT_LONG,
	"Im ersten Geschoss des Turms herrscht absolutes Chaos. Ueberall "
	"liegen alte Ruestungen und Waffen herum. Auch sind viele Knochen und "
	"Schaedel zu erkennen. Hier gab es anscheinend ein grosses Gemetzel "
	"zwischen mutigen Abenteurern und dem Besitzer des Turms." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"geschoss","obergeschoss"}), 
            "Hier hat anscheinend ein Kampf statt gefunden. Ueberall liegen "
	    "Ruestungen, Waffen und Knochen herum.");

  AddDetail( ({"turm","turms"}),
	    "Du bist im ersten Obergeschoss im schwarzen Turm.");

  AddDetail( ({"chaos"}),
	    "Es herrscht hier absolutes Chaos. Ueberall liegen Dinge herum.");

  AddDetail( ({"ruestungen"}),
	    "Die Ruestungen haben viele Brandflecken und sind komplett "
	    "zerfetzt.");
  
  AddDetail( ({"waffen","aexte","schwerter"}),
	    "Die Schwerter sind zerbrochen und die Aexte, die am Boden liegen, "
	    "sind schartig und nicht mehr zu gebrauchen.");

  AddDetail( ({"knochen","teile"}), 
            "Die Knochen sind zerschmettert und in viele Teile gebrochen. Hier "
	    "wurde keiner getoetet, sondern zermetzelt.");

  AddDetail( ({"schaedel","schaedeln"}),
	    "Die Schaedel sind eingedrueckt und haben grosse Loecher.");

  AddDetail( ({"gemetzel","art","weise"}),
	    "Die Abenteurer die hier gestorben sind, wurden auf brutale Art "
	    "und Weise niedergemetzelt.");

  AddDetail( ({"abenteurern","abenteurer"}),
	    "Abenteurer wie Du einer bist.");
  
  AddDetail( ({"besitzer"}),
	    "Der Besitzer des Turms ist ein starker und boeser Drache.");

  AddDetail( ({"boden"}), 
            "Der Boden ist voll mit Ruestungen, Waffen und Knochen. Eine "
	    "breite Treppe fuehrt nach unten ins Erdgeschoss.");

  AddDetail( ({"wand","waende","waenden"}),
	    "An den Waenden haengen einige Fackeln in Haltern. Ansonsten ist "
	    "nicht viel zu sehen, bis auf ein paar Brandflecke.");

  AddDetail( ({"decke","loch"}),
	    "In der Decke ist ein Loch, durch das eine breite Treppe weiter "
	    "nach oben fuehrt.");

  AddDetail( ({"kampf"}),
	    "Der Kampf ist schon lange zu vorbei.");
  
  AddDetail( ({"dinge"}),
	    "Du erkennst alte Ruestungen und kaputte Waffen zwischen den "
	    "Knochen und Schaedel ihrer Eigentuemer.");

  AddDetail( ({"eigentuemer","ende"}), 
            "Die Eigentuemer haben hier ihr unruehmliches Ende gefunden.");

  AddDetail( ({"brandflecken","brandflecke","flecke"}),
	    "Die Brandflecke stammen sicher vom feurigen Atem des Drachen, der "
	    "hier hausen soll. Du bist froh, dass das Feuer Dich nicht "
	    "getroffen hat.");

  AddDetail( ({"loecher","zaehnen","zaehne","zahnabdruck"}),
	    "Die Loecher in den Schaedeln stammen wohl von den Zaehnen des "
	    "Drachen. So ein Zahnabdruck ist sicher toedlich.");

  AddDetail( ({"drache","drachen"}),
	    "Der Drache in dem Turm ist sicher nur durch einen magischen "
	    "Gegenstand zu toeten.");
  
  AddDetail( ({"treppe"}),
	    "Eine Treppe fuehrt nach unten ins Erdgeschoss und eine weitere "
	    "nach oben in Richtung Turmspitze.");

  AddDetail( ({"erdgeschoss"}), 
            "Um ins Erdgeschoss zu kommen, musst Du nach unten gehen.");

  AddDetail( ({"feuer","atem","maul"}),
	    "Das Feuer aus dem Maul des Drachen verbrennt fast alles.");

  AddDetail( ({"gegenstand","beispiel","axt"}),
	    "Man kann ihn zum Beispiel mit einer magischen Axt, wie Du eine "
	    "dabei hast, toeten.");

  AddDetail( ({"richtung","turmspitze"}),
	    "Um in die Turmspitze zu kommen, musst Du die Treppe nach oben "
	    "nehmen.");
  
  AddDetail( ({"halter","haltern"}),
	    "Die Halter der Fackeln bestehen aus Eisen.");

  AddDetail( ({"eisen","rost"}), 
            "Das Eisen hat bisher kein Rost angesetzt. Entweder wird hier "
	    "regelmaessig geputzt und so sieht es hier nur wirklich nicht "
	    "aus, oder sie wurden erst vor kurzem ersetzt.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht verbrannt hier.");  

  AddSound(DEFAULT_SOUND, "Du hoerst das Flackern der Fackeln.");

  AddSound( ({"fackeln","flackern"}),
	   "Das Flackern der Fackeln wirkt irgendwie beruhigend auf Dich.");

//-----Details Ende-----
  
AddExit("unten", ROOM "bdragonq7");
AddExit("oben", ROOM "bdragonq9");


}
