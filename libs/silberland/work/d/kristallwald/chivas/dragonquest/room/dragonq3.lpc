// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle");
  SetProp( P_INT_LONG,
	"Die Hoehle fuehrt an dieser Stelle weiter nach unten in die Tiefe. "
	"Geh runter, wenn Du Dich traust, ansonsten hast Du natuerlich die "
	"Moeglichkeit zurueck nach Norden zu gehen und die Zwergenfeste "
	"von Ardhmir weiter zu erforschen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"hoehle","teil","raum"}), 
            "Die Hoehle endet abrupt vor einer Wand im Sueden. Durch ein "
	    "breites Loch im Boden geht es anscheinend noch tiefer in die "
	    "Hoehle hinein.");

  AddDetail( ({"stelle","weg"}),
	    "Durch ein Loch im Boden geht der Weg in der Hoehle weiter.");

  AddDetail( ({"tiefe"}),
	    "Was in der Tiefe alles auf Dich lauern kann, ist ungewiss.");

  AddDetail( ({"moeglichkeit"}),
	    "Falls Du ein Seicherl bist, kannst Du natuerlich auch umkehren.");
  
  AddDetail( ({"norden"}),
	    "nach Norden geht es zum Eingang der Hoehle und zurueck zur "
	    "Schlucht.");
  
  AddDetail( ({"ardhmir","zwergenfeste","feste"}), 
            "Die Zwergenfeste von Ardhmir ist oberhalb der Hoehle. Dort ist es "
	    "definitiv gemuetlicher als hier in der Hoehle.");

  AddDetail( ({"boden"}),
	    "Im Boden ist ein breites Loch, was nach unten fuehrt, wo "
	    "anscheinend die Hoehle weiter fuehrt. Du kannst jedoch durch die "
	    "Dunkelheit, die dort herrscht nicht viel erkennen.");

  AddDetail( ({"decke"}),
	    "Die Decke ist nicht sehr interessant.");

  AddDetail( ({"waende","waenden"}),
	    "An den Waenden haengen ein paar Fackeln, die diesen Teil der "
	    "Hoehle ein wenig erhellen.");
  
  AddDetail( ({"wand"}),
	    "Welche Wand meinst Du?");

  AddDetail( ({"sueden","unten"}), 
            "Im Sueden geht es nicht weiter, nur der Weg nach Unten oder "
	    "zurueck nach Norden ist frei.");

  AddDetail( ({"loch"}),
	    "Ein sehr breites Loch ist im Boden, durch das Du nach unten "
	    "steigen kannst.");

  AddDetail( ({"seicherl","begriff"}),
	    "Dieser Begriff ist selbsterklaerend.");

  AddDetail( ({"eingang","schlucht"}),
	    "Der Eingang zur Hoehle und die Schlucht befinden sich im Norden "
	    "der Hoehle. Geh einfach hin und schau nach ob sie immer noch "
	    "da sind.");
  
  AddDetail( ({"dunkelheit"}),
	    "Es herrscht tiefe Dunkelheit in dem Loch.");

  AddDetail( ({"fackeln"}), 
            "Fackeln brennen in einem gelblich orangen Licht und erhellen "
	    "die Hoehle ein wenig. Die Halterungen aus Eisen, in denen sie "
	    "haengen, haben schon bessere Zeiten gesehen.");

  AddDetail( ({"nordwand"}),
	    "Eine Nordwand gibt es hier nicht.");

  AddDetail( ({"westwand"}),
	    "An der Westwand haengen einige Fackeln.");

  AddDetail( ({"ostwand"}),
	    "An der Ostwand sind ein paar Halterungen mit den dazu gehoerigen "
	    "Fackeln zu sehen.");
  
  AddDetail( ({"suedwand"}),
	    "Die Suedwand ist leer. Nur eine Inschrift ist zu erkennen.");

  AddDetail( ({"zeiten","halterungen"}), 
            "Die Halterungen sind komplett verrostet.");

  AddDetail( ({"eisen"}),
	    "Es ist eigentlich kein Eisen mehr zu sehen, sondern sie bestehen "
	    "nur noch aus Rost.");

  AddDetail( ({"rost"}),
	    "Der Rost schimmert roetlich im Schein der Fackeln.");

  AddDetail( ({"schein","licht"}),
	    "Das Licht der Fackeln erhellt die Hoehle ein wenig und wirft "
	    "bewegte Schatten in den Raum.");
  
  AddDetail( ({"schatten"}),
	    "Du kannst Dir in der Hoehle nicht sicher sein, ob die Schatten "
	    "von Felsbrocken, den Waenden oder einem Gegner kommen.");

  AddDetail( ({"felsbrocken","brocken"}), 
            "Einige Felsbrocken liegen am Boden um das Loch herum. Hinter "
	    "einem Felsbrocken erkennst Du ein Glitzern im Schein der "
	    "Fackeln.");

  AddDetail( ({"gegner"}),
	    "Noch hast Du in dieser Hoehle keinen Gegner entdeckt, der Dir "
	    "etwas boeses antun will. Hoffentlich bleibt es auch dabei.");

  AddDetail( ({"glitzern"}),
	    "Das Glitzern stammt von einem alten Bronzering.");

  AddDetail( ({"bronzering","ring"}),
	    "Der Ring ist nicht viel wert, darum lohnt es sich fuer Dich "
	    "auch nicht ihn mitzunehmen. Viel interessanter ist jedoch, dass "
	    "der Ring immer noch an einer Hand haengt.");
  
  AddDetail( ({"hand"}),
	    "Die Hand besteht nur noch aus Knochen.");

  AddDetail( ({"knochen","situation"}),
	    "Die Knochen sind bleich und sehen irgendwie angenagt aus. Wo "
	    "jedoch das restliche Skelett ist, ist nicht zu erkennen. Die "
	    "Situation gefaellt Dir irgendwie gar nicht.");

  AddDetail( ({"skelett"}),
	    "Das Skelett ist nicht da, vielleicht ist es ja unten in der "
	    "Hoehle.");

  AddDetail( ({"inschrift"}),
	    "Du kannst sie lesen.");

  AddDetail( ({"finger","lippen"}),
	    "Du untersuchst wirklich alles.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Man kann absolut ueberhaupt nichts riechen.");  
 

  AddSound(DEFAULT_SOUND, "Du hoerst absolute Totenstille.");

  AddSound( ({"totenstille"}),
	   "Tod taucht aus der Dunkelheit auf und legt den Finger auf die "
	   "nicht vorhandenen Lippen und raunt: PSSSSSt! RUHE!!! Darauf "
	   "verschmilzt er wieder mit den Schatten.");
  
  AddReadDetail( ({"inschrift"}),
		"Der Weg in die Dunkelheit fuehrt meist zu einer guten Tat "
		"und einem spannenden Abenteuer.");

//-----Details Ende-----
  
AddExit("norden", ROOM "dragonq2");
AddExit("unten", ROOM "dragonq4");

}
