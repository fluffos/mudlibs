// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle");
  SetProp( P_INT_LONG,
	"Die Hoehle fuehrt von Norden, wo ein Felsvorsprung ist, nach Sueden "
	"tiefer in die Hoehle hinein. Die Waende sind scharfkantig und "
	"unbearbeitet. Das einzige Anzeichen, dass schon einmal Jemand hier "
	"gewesen ist, sind ein paar brennende Fackeln, die an den Waenden "
	"haengen und die Hoehle ein wenig erhellen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"hoehle"}), 
            "Die Hoehle ist breit und hoch, was auch sehr gut ist, da die "
	    "Waende aus sehr scharfkantigen Fels bestehen, wo man sich "
	    "schnell weh tun kann. Sie fuehrt von Norden, wo der Felsvorsprung "
	    "ist, nach Sueden weiter hinein.");

  AddDetail( ({"norden","felsvorsprung"}),
	    "Im Norden befindet sich der Felsvorsprung, der ein wenig in die "
	    "Schlucht ragt. Dort bist Du angekommen, als Du hinunter "
	    "geklettert bist.");

  AddDetail( ({"sueden"}),
	    "Was im Sueden auf Dich wartet, weiss niemand genau.");

  AddDetail( ({"waende","waenden","fels","wand"}),
	    "Die Waende bestehen aus Fels und sie sind unbearbeitet, was fuer "
	    "Dich bedeutet, dass es sich wohl um eine natuerliche Hoehle "
	    "handelt und nicht um einen gegrabenen Stollen der Zwerge.");
  
  AddDetail( ({"anzeichen","zeichen"}),
	    "Die Fackeln sind ein deutliches Zeichen dafuer, dass bereits "
	    "Jemand hier war.");
  
  AddDetail( ({"jemand"}), 
            "Wer der Jemand war ist jedoch nicht ueberliefert.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln brennen und erhellen die Hoehle ein wenig, so dass "
	    "man genug sehen kann. Sie stecken in alten Eisenhalterungen an "
	    "den Waenden.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit vielen Steinen und Brocken uebersaeht.");

  AddDetail( ({"decke"}),
	    "Die Decke sieht so aus wie die Waende.");
  
  AddDetail( ({"schlucht"}),
	    "Um die Schlucht zu sehen, musst Du schon nach Norden gehen.");

  AddDetail( ({"stollen"}), 
            "Viele Stollen wurden in Ardhmir von den Zwergen gegraben.");

  AddDetail( ({"zwerge","zwergen"}),
	    "Viele Zwerge arbeiten und wohnen in der Zwergenfeste von "
	    "Ardhmir.");

  AddDetail( ({"ardhmir","zwergenfeste"}),
	    "Die Zwergenfeste von Ardhmir befindet sich oberhalb der Hoehle.");

  AddDetail( ({"eisenhalterungen","halterungen"}),
	    "Die alten Halterungen der Fackeln sind teilweise sehr alt und "
	    "schon verrostet.");
  
  AddDetail( ({"steinen","steine","brocken","gehen"}),
	    "Die Steine und groesseren Brocken machen das Gehen ein wenig "
	    "muehselig, da man staendig aufpassen muss, wo man hintritt.");

  AddDetail( ({"eisen"}), 
            "Es ist eigentlich mehr Rost an den Halterungen als Eisen.");

  AddDetail( ({"rost"}),
	    "Durch den vielen Rost sehen die Halterungen nicht mehr sehr "
	    "stabil aus. Bald werden sie nicht mehr an den Waenden haengen, "
	    "sondern abfallen und weiter verrotten.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({""}), 
            "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Rost.");  
 
  AddSmell( ({"rost","geruch"}),
	   "Die Halterungen der Fackeln riechen nach Rost. Du wusstest bisher "
	   "gar nicht, dass Rost einen Geruch hat.");

  AddSound(DEFAULT_SOUND, "Es ist unheimlich still.");

//-----Details Ende-----
  
AddExit("norden", ROOM "dragonq1");
AddExit("sueden", ROOM "dragonq3");

}
