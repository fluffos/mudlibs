
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Anezram, der silberner Drache");
  SetProp(P_LONG, BS(
    "Anezram ist ein riesiger silberner Drache und seine Schuppen glaenzen "
    "silbrig im Schein des Feuers. Er hat lange spitze Zaehne und grosse "
    "Klauen an den Fuessen. Trotz der Zaehne und Klauen schaut er sehr "
    "freundlich, soweit das jedenfalls fuer einen Drachen moeglich ist."));
  SetProp(P_NAME, "Anezram");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:40]));
  AddId("anezram","drache");
  set_living_name("anezram");

  create_default_npc(50);
  SetProp(P_HANDS, ({" mit seinen Klauen",225,DT_BLUDGEON}));
  SetProp(P_RACE, "Drache");
  SetProp(P_SIZE, 830);
  SetProp(P_WEIGHT, 210000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOATTACK,1);

  AddDetail( ({ "drache"}),
    "Anezram ist ein gewaltiger silberner Drache.");

  AddDetail( ({ "schuppen","schein","feuers","feuer","licht"}),
    "Die vielen Schuppen von Anezram scheinen silbrig im Licht des Feuers.");

  AddDetail( ({ "zaehne","maul"}),
    "Hunderte spitze Zaehne sind im Maul des Drachen zu erkennen.");

  AddDetail( ({ "klauen","fuesse","fuessen"}),
    "Grosse scharfe Klauen sitzen an den Fuessen des Drachen.");

  AddDetail( ({ "augen"}),
    "Die goldenen Augen von Anezram sehen intelligent aus und scheinen Dich "
    "zu mustern.");  

  AddInfo(DEFAULT_INFO, "hat andere Sorgen, als sich mit Dir zu "
                        "beschaeftigen.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"anezram"}),
    "Hallo, ich bin Anezram, der silberne Drache. Ich hause hier unter der "
    "Zwergenfeste und beschuetze die Zwerge und die Gegend um die Hochebene.",
    "sagt: ");
    
  AddInfo( ({"aufgabe","quest","hilfe"}),
    "Ich habe eine Aufgabe fuer Dich. Nordwestlich der Hochebene befindet "
    "sich ein schwarzer Turm, in dem Akinaj, der schwarze Drache, haust. Er "
    "ist boese und gemein und tyrannisiert die Gegend. Du musst ihn "
    "aufhalten. Wenn Du mutig bist, dann biete mir Deine Hilfe an.","sagt: ");

  AddInfo( ({"drache","akinaj"}),
    "Akinaj ist ein schwarzer und boeser Drache. Man kann ihn leider nur mit "
    "einer speziellen magischen Axt toeten.",
    "sagt: ");
    
  AddInfo( ({"turm"}),
    "Der Turm in dem Akinaj wohnt ist nordwestlich der Hochebene.",
    "sagt: ");

  AddInfo( ({"axt"}),
    "Die Axt ist etwas ganz besonderes und besteht aus vielen Teilen, die "
    "dafuer notwendig sind. Du musst sie finden und zusammen bauen lassen.",
    "sagt: ");
  AddInfo( ({"gegend","hochebene","gorthad"}),
    "Die Gegend um die Hochebene von Gorthad wird von Akinaj tyrannisiert.",
    "sagt: ");

  AddInfo( ({"teilen","teile"}),
    "Die magische Axt besteht aus einem Schaft und einem verzierten Axtblatt.",
    "sagt: ");

  AddInfo( ({"schaft","tischler","holz"}),
    "Der Schaft ist mit Runen verziert und besteht aus einem besonderem Holz. "
    "Vielleicht kann Dir der Tischler in Roch Adan weiterhelfen.",
    "sagt: ");

  AddInfo( ({"fackel","feuer","drachenfeuer"}),
    "Wenn Du Drachenfeuer von mir brauchst, dann gib mir eine Fackel und ich "
    "werde sie Dir entzuenden.",
    "sagt: ");
  
  AddInfo( ({"axtblatt"}),
    "Das Axtblatt ist mit Gold, Silber und Diamanten verziert. Frag doch den "
    "Schmied in Roch Adan mal nach dem Axtblatt. Aber das ist noch nicht "
    "alles. Die Axt muss auch noch mit Magie versehen werden.",
    "sagt: ");

  AddInfo( ({"magie"}),
    "Um die Axt magisch werden zu lassen, so dass man mit ihr Akinaj toeten "
    "kann, musst Du zum Zwergenmagier der Zwergenfeste gehen. Er wird Dir "
    "sicher helfen.",
    "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das will Anezram gar nicht von Dir haben.\n" }) );

  SetChats(3, ({
          "Anezram mustert Dich mit seinen goldenen Augen und scheint zu "
	  "ueberlegen, ob Du die richtige Person fuer eine Aufgabe waerst.\n",
          "Anezram schenkt Dir ein guetiges Drachenlaecheln.\n",
          "Die Stimme von Anezram schleicht sich in Dein Gehirn und fragt "
	  "Dich, ob Du mutig genug fuer eine gefaehrlicht Quest bist.\n"}) );

  AddCmd( ({"biete" }), "bieten" );  
  AddCmd( ({"gib","gebe" }), "geben" );  
}
int bieten(string str)
{
object dragoninvis1;
notify_fail("Wem moechtest Du was anbieten?\n");

if(!str || str == "") return 0;
 if(!(str == "hilfe an" ||
     str == "anezram hilfe an" )) return 0;

  if(present("dragoninvis1", TP))
  {
  write(BS("Anezram sagt: Aber Du hilfst mir doch schon. Nun beeile Dich.\n"));
  return -1;
  }

  write(BS("Anezram sagt: Danke Dir, die Bewohner, die rund um die Hochebene "
	   "leben, werden Dir ewig dankbar sein. Nun beeile Dich und baue die "
	   "magische Axt zusammen und toete den boesen Drachen.\n"));
  dragoninvis1=clone_object(OBJ "dragoninvis1")->move(TP, M_NOCHECK);
  return 1;
 }
int geben(string str)
{
  object drachenfackel;
  notify_fail( "Wem willst Du was geben?\n" );
  if ( member( ({ "anezram fackel", "fackel anzeram" }), str ) != -1 ) 

   {
     if( !present("dragoninvis1",TP))
     {
        write(BS("Anezram sagt: Also mein Freund, Du hilfst mir noch nicht und "
		 "brauchst dementsprechend kein Feuer von mir.\n"));
        return -1;
     }
     if( !present("fackel",TP))
     {
        write(BS("Anezram sagt: Du hast ja gar keine Fackel dabei, die ich "
		 "mit meinem Feuer entzuenden soll.\n"));
        return -1;
     }
      if ( present("drachenfackel",TP) )
      {
      write(BS("Anezram sagt: Was soll ich mit noch einer Fackel? Du hast "
	       "mir doch schon eine gegeben und ich habe sie mit meinem "
	       "Drachenfeuer angezuendet.\n" ));
      return -1;
      }
      else
      {
      {drachenfackel = clone_object( OBJ "drachenfackel");
       if (present("fackel",TP))
       present("fackel",TP)->remove();
       if ( ME_TOO_HEAVY == drachenfackel->move(TP,M_GET|M_SILENT) )

          {
          write(
          "Die Fackel mit dem Drachenfeuer wuerde Dir zu schwer werden.\n" );
          say(BS(sprintf("%s ist einfach zu schwach.\n", TP->Name(WER))));
          drachenfackel -> remove();
          return 1;
          }
          else
          {
          write(BS("Du gibst Anezram eine Fackel, die der Drache kurz "
		   "anniest und mit einem kleinen Feuerball anzuendet. Darauf "
		   "hin gibt er Dir die Fackel mit dem heissen Drachenfeuer "
		   "zurueck.\n"));
          return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}

