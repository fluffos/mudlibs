//erstellt im mai 04 von chivas
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Leonardo, der Tischler");
  SetProp(P_LONG,
    "Leonardo ist ein Zentaur, der sich hier in Roch Adan niedergelassen hat "
    "und alle moeglichen Holzarbeiten fuer die Zentauren erledigt. Er ist "
    "recht gross fuer einen Zentauren und hat ein freundliches Gesicht.");
  SetProp(P_NAME, "Leonardo");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId( ({ "leonardo","tischler"}) );
  AddId(({"Speerexperte"}));


  create_default_npc(25);
  SetProp(P_HANDS, ({" mit seinen Haenden" ,150, DT_RIP }) );
  SetProp(P_SIZE, 260 );
  SetProp(P_RACE, "Zentaur");
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,35);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,3);
  SetProp(P_NOATTACK,1);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt Dich freundlich anlaechelnd herein");
  SetProp(P_MMSGOUT, "geht nach Holz suchend weg");
  
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder %s, dann werde ich Dich besiegen!");
  SetProp(P_KILL_NAME, "Leonardo, der Tischler");
  SetProp(P_KILL_MSG, "Probier es ruhig nochmal!");

  AddDetail( ({ "zentaur"}),
    "Leonardo ist ein Zentaur.");
  AddDetail( ({ "roch","adan","roch adan"}),
    "Leonardo lebt in Roch Adan.");
  AddDetail( ({ "zentauren","kunden"}),
    "Die Zentauren sind seine besten Kunden.");
  AddDetail( ({ "gesicht"}),
    "Leonardo laechelt meistens und hat ein nettes Gesicht.");

  AddInfo(DEFAULT_INFO, "ist zu beschaeftigt um sich um Dich zu kuemmern.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");
  AddInfo( ({"axt"}),
    "Ich kann Dir einen Schaft fuer eine Axt bauen.","sagt: ");
  AddInfo( ({"schaft","axtschaft"}),
    "Um einen Schaft zu bauen, benoetige ich einen dicken Ast. Ausserdem "
    "koenntest Du mir dann auch einen Gefallen tun.","sagt: ");
  AddInfo( ({"anezram","drache","zwergenfeste","ardhmir"}),
    "Anezram ist ein Drache, der unter der Zwergenfeste von Ardhmir "
    "wohnt.","sagt: ");
  AddInfo( ({"gefallen"}),
    "Du koenntest mir den neuen Ratgeber fuer Heimwerker vom Bibliothekar "
    "besorgen. Ich kann hier leider nicht weg. Wenn Du ihn hast, gib ihm mir, "
    "dann baue ich Dir einen wunderschoenen Schaft fuer eine Axt.","sagt: ");
  AddInfo( ({"ast"}),
    "Es sollte ein Ast vom Palast hier in Roch Adan sein. Geh doch mal zu "
    "Roarex unserem Koenig und frag ihn nach einem Ast. Vielleicht gibt er "
    "Dir einen.","sagt: ");
  AddInfo( ({"roarex","koenig","palast"}),
    "Roarex ist der Koenig der Zentauren und wohnt hier in Roch Adan in seinem "
    "Palast.","sagt: ");

  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Leonardo will Deine Sachen nicht haben.\n" }) );

  AddSpell(1,500, 
     "Leonardo tritt Dich mit seinen Hufen nieder.\n",
     "Leonardo zertrampelt @WEN mit seinen Hufen am Boden.\n",
     ({DT_BLUDGEON}), "tritt", ([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Leonardo schleift einen alten Schrank ab.\n",
    "Leonardo bearbeitet ein grosses Holzstueck auf der Werkbank.\n"}) );
  SetAttackChats(10, ({
    "Leonardo trampelt Dich nieder.\n",
    "Leonardo zereisst Dich.\n"}) );

 SUID;
  CLONEME(WEAPON "meissel" );
  CLONEME( "/p/armour/gloves/lederhandschuhe" );
  command("trage alles");
  command("zuecke meissel");

  AddCmd( ({"gib", "gebe" }), "geben" );  

}
int geben(string str)
{
  object schaft;
  notify_fail( "Wem willst Du was geben?\n" );
  if ( member( ({ "leonardo ratgeber", "leonardo buch","leonardo ast" }), str ) != -1 ) 

   {
     if( !present("dragoninvis1",TP))
     {
        write(BS("Leonardo sagt: Also mein Freund, Du brauchst doch gar nichts "
		 "von mir. Also brauchst Du mir auch nichts zu geben. Du "
		 "kannst natuerlich zu Anezram gehen und ihm Hilfe anbieten, "
		 "dann helfe ich Dir auch, wenn die Zeit reif dafuer ist.\n"));
        return -1;
     }
     if( !present("CHIVASAST",TP) )
     {
        write(BS("Leonardo sagt: Du hast ja noch nicht einmal den Ast, aus "
		 "dem ich Dir einen Axtschaft bauen soll. Besorg Dir erst "
		 "einmal den Ast, dann gib mir den Ratgeber, den ich haben "
		 "will und dann kommen wir ins Geschaeft.\n"));
        say(sprintf("%s hat nicht das, was Leonardo haben will.\n", TP->Name(WER)));
        return -1;
     }
     if( !present("CHIVASRATGEBER",TP))
     {
        write(BS("Leonardo sagt: Du hast zwar den Ast, aus dem ich Dir einen "
		 "Axtschaft bauen soll, aber nicht den Ratgeber um den ich "
		 "Dich gebeten habe. Bring mir meinen Ratgeber und gib ihn "
		 "mir, dann schnitze ich Dir einen wundervollen Axtschaft.\n"));
        say(sprintf("%s hat nicht das, was Leonardo haben will.\n", TP->Name(WER)));
        return -1;
     }
      if ( present("CHIVASAXTSCHAFT",TP) )
      {
      write(BS("Leonardo sagt: Was soll ich mit noch einem Ratgeber? Du hast "
	       "mir doch schon einen gegeben und einen Axtschaft hast Du doch "
	       "auch schon.\n" ));
      say(sprintf("%s bekommt eine Standpauke von Leonardo.\n", TP->Name(WER)));
      return -1;
      }
      else
      {
      {schaft = clone_object( OBJ "axtschaft");
       if (present("CHIVASRATGEBER",TP))
       present("CHIVASRATGEBER",TP)->remove();
       if (present("CHIVASAST",TP))
       present("CHIVASAST",TP)->remove();
       if ( ME_TOO_HEAVY == schaft->move(TP,M_GET|M_SILENT) )

          {
          write(
          "Der Axtschaft wuerde Dir zu schwer werden.\n" );
          say(BS(sprintf("%s ist einfach zu schwach.\n", TP->Name(WER))));
          schaft -> remove();
          return 1;
          }
          else
          {
          write(BS("Du gibst Leonardo den Ratgeber und den Ast, worauf sich "
		   "Leonardo sofort an die Arbeit macht.\n"));
     TP->SetProp(P_PARALYZED, ([
                PARALYZE_TIME: 5,
                PARALYZE_MSG: "Du bist fasziniert, wie Leonardo den Schaft "
		              "formt.\n",
                PARALYZE_END: "Leonardo gibt Dir einen schoenen verzierten "
		              "Schaft fuer einen Axt.\n"]) );	
      call_out("fall1",4);
      return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}
void fall1()
{
  write(BS( "Leonardo nimmt den Ast und entfernt die Rinde und schnitzt wie "
	    "wild daran herum.\n"));
  call_out("fall2",4);
}
void fall2()
{
  write(BS( "Als der Ast ganz gerade ist und die Form von einem Schaft hat, "
	    "nimmt er einen kleinen Meissel und verschoenert den Schaft mit "
	    "kleinen Runen.\n"));
}


