
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Akinaj, der schwarze Drache");
  SetProp(P_LONG, BS(
    "Akinaj ist ein riesiger schwarzer Drache und aus seinen Nuestern steigt "
    "grauer Rauch hervor. Seine gelben Augen schauen boesartig auf Dich "
    "hinunter und eine grosse Zunge leckt ueber spitze Zaehne."));
  SetProp(P_NAME, "Akinaj");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:40]));
  AddId("akinaj","drache");
  set_living_name("akinaj");

  create_default_npc(50);
  SetProp(P_HANDS, ({" mit seinen Klauen",225,DT_BLUDGEON}));
  SetProp(P_RACE, "Drache");
  SetProp(P_SIZE, 830);
  SetProp(P_WEIGHT, 210000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOATTACK,1);

  AddDetail( ({ "drache"}),
    "Akinaj ist ein gewaltiger schwarzer Drache.");

  AddDetail( ({ "schuppen","schein","feuers","feuer","licht"}),
    "Die vielen schwarzen Schuppen von Anezram schimmern im Licht des Feuers.");

  AddDetail( ({ "zaehne","maul"}),
    "Hunderte spitze Zaehne sind im Maul des Drachen zu erkennen.");

  AddDetail( ({ "klauen","fuesse","fuessen"}),
    "Grosse scharfe Klauen sitzen an den Fuessen des Drachen.");

  AddDetail( ({ "augen"}),
    "Die gelben Augen von Akinaj sehen intelligent und boshaft aus. Dir "
    "straeuben sich die Nackenhaare.");  

  AddInfo(DEFAULT_INFO, "hat andere Sorgen, als sich mit Dir zu "
                        "beschaeftigen.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"akinaj"}),
    "Das ist mein Name und Deinen brauche ich mir sicher nicht mehr zu "
    "merken.",
    "sagt: ");
    
  AddInfo( ({"aufgabe","quest"}),
    "Eine Quest ist doch nicht alles. Wie waere es mit einem Deal?",
    "sagt: ");

  AddInfo( ({"deal"}),
    "Der Deal ist, Du wirst belohnt, wenn Du Anezram toetest und nicht mich.",
    "sagt: ");
 
  AddInfo( ({"hilfe"}),
    "Von mir brauchst Du keine Hilfe erwarten.",
    "sagt: ");
    
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das will Akinaj gar nicht von Dir haben.\n" }) );

  SetChats(3, ({
          "Akinaj schaut Dich boesartig und listig an.\n"}) );

  AddCmd( ({"bestaetige" }), "bestaetigen" ); 

}
int bestaetigen(string str)
{
object dragoninvis4;
notify_fail("Tippe einfach nur 'bestaetige deal'.\n");

if(!str || str == "") return 0;
 if(!(str == "deal" )) return 0;

  if(present("dragoninvis4", TP))
  {
  write(BS("Akinaj sagt: Aber Du bist doch schon den Deal mit mir eingegangen. "
	   "Nun gehe und toete den verhassten Anezram.\n"));
  return -1;
  }

  write(BS("Akinaj sagt: Okay mein Freund. Du gehst den Deal mit mir ein. "
	   "Geh und toete Anezram und komm dann wieder und frage mich nach "
	   "der Belohnung.\n"));
  dragoninvis4=clone_object(OBJ "dragoninvis4")->move(TP, M_NOCHECK);
  return 1;
 }

