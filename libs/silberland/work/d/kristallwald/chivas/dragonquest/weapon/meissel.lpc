inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine grosser Holzmeissel");
  SetProp(P_LONG,  
    "Mit dem Holzmeissel kann man perfekt Holz zu wunderschoenen Dingen "
    "verarbeiten. Es ist auch eine gefaehrliche Waffe, da er sehr scharf ist.");
  SetProp(P_NAME, "Holzmeissel");
  SetProp(P_GENDER, MALE);
  AddId( ({"holzmeissel", "meissel"}) );
  SetProp(P_INFO, 
    "Nur maechtige Krieger koennen mit dieser Waffe kaempfen.\n");

  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 157);
  SetProp(P_WC_FIX, 15);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL,([MAT_STEEL:35, MAT_BRONCE:59, MAT_PELT:5, MAT_BLOOD:1]));
  SetProp(P_WEIGHT, 5500);
  SetProp(P_VALUE, 700);
  SetProp(P_SIZE, 60);
  SetProp(P_QUALITY_DECAY, 90);
  SetProp(P_WC_BONUS, (["greg": 60]) );
}

