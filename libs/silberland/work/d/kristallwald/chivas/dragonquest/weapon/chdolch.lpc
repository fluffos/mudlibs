inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine silberner Dolch");
  SetProp(P_LONG,  
    "Der Dolch besteht aus Silber und ist mit unzaehligen Zwergenrunen "
    "versehen. Es scheint ein ganz besonderer Dolch zu sein.");
  SetProp(P_NAME, "Silberdolch");
  SetProp(P_GENDER, MALE);
  AddId( ({"dolch"}) );
  AddId( ({"CHIVASDOLCH"}) );
  SetProp(P_INFO, 
    "Der Dolch scheint etwas magisches zu haben.\n");

  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 157);
  SetProp(P_WC_FIX, 15);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL,([MAT_STEEL:35, MAT_BRONCE:59, MAT_PELT:5, MAT_BLOOD:1]));
  SetProp(P_WEIGHT, 5500);
  SetProp(P_VALUE, 700);
  SetProp(P_SIZE, 60);
  SetProp(P_QUALITY_DECAY, 90);
  SetProp(P_WC_BONUS, (["greg": 60]) );
}

