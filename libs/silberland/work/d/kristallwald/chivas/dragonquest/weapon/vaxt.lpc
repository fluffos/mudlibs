inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine verzierte Axt");
  SetProp(P_LONG,  
    "Der magische Drachentoeter ist eine gefaehrliche und einzigartige Waffe. "
    "Der Schaft ist mit Runen verziert und die beiden Axtblaettern besitzen "
    "Intarsien aus Gold und Silber. An den Schneiden wurden Diamanten "
    "angebracht, die die Schneiden noch verstaerken.");
  SetProp(P_NAME, "Drachentoeter");
  SetProp(P_GENDER, MALE);
  AddId( ({"drachentoeter", "axt", "\ndqaxt"}) );
  SetProp(P_INFO, 
    "Nur maechtige Krieger koennen mit dieser Waffe kaempfen.\n");

  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 257);
  SetProp(P_WC_FIX, 15);
  SetProp(P_WC_BONUS,(["Axtkaempfer":60, "Axtexperte":130, "Axtmeister":250]));
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL,([MAT_STEEL:35, MAT_BRONCE:59, MAT_PELT:5, MAT_BLOOD:1]));
  SetProp(P_WEIGHT, 5500);
  SetProp(P_VALUE, 3333);
  SetProp(P_SIZE, 120);
  SetProp(P_QUALITY_DECAY, 90);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:23, P_LEVEL:15, P_XP:300000]) );  
}

