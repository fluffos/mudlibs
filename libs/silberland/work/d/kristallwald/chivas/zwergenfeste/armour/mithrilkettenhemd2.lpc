inherit "/std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Mithrilkettenhemd");
  SetProp (P_LONG,
    "Dieses herrliche Kettenhemd wurde vollstaendig aus Mithrilringen "
    "gefertigt. Die Mithrilringe sind poliert und glitzern silbrig. Am "
    "oberen Rand des Kettengewebes wurde ein Medaillon eingearbeitet, welches "
    "den Zwergenclan des Traegers darstellt. Es ist das Mithrilkettenhemd "
    "eins Zwergenmagiers.");
  SetProp (P_NAME, "Mithrilkettenhemd");
  SetProp (P_GENDER, MALE);
  AddId (({"kettenhemd","mithrilkettenhemd"}));

  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 39);
  SetProp (P_MATERIAL, MAT_MITHRIL);
  SetProp (P_WEIGHT, 2700);
  SetProp (P_VALUE, 8500);
  SetProp (P_QUALITY_DECAY, 250);
  SetProp (P_WEAR_RESTRICTIONS, ([A_STR:15, A_DEX:20]) );

  AddDetail( ({"mithril"}),
    "Das Mithril glaenzt und strahlt wie frischpoliertes Silber.");
  AddDetail( ({"mithrilringen","mithrilringe","ringe"}),
    "Die Mithrilringe sind sehr feingliederig.");
  AddDetail( ({"rand","medaillon"}),
    "Auf dem Medaillon sind ein paar bewegende Haende und einige Blitze "
    "abgebildet, welches den Traeger zu einem Clanmitglied der Zwergenmagier "
    "der Zwergenfeste von Ardhmir macht.");
  
}
