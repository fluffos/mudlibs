inherit "/std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Kettenpanzer von Ardhmir");
  SetProp(P_LONG,  
    "Dieser Kettenpanzer wurde in der Zwergenfeste von Ardhmir hergestellt. Er "
    "besteht aus vielen kleinen Eisenringen und einigen stabilen Eisenplatten, "
    "die einen erhoehten Schutz bieten. Auf der grossen Brustplatte ist ein "
    "Symbol eingraviert, welches den Clan der Traegers in der Zwergenfeste "
    "darstellt.") ;
  SetProp(P_NAME, "Kettenpanzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "kettenpanzer"}) );
  SetProp(P_INFO, 
    "Schmale Stichwaffen moegen schon hie und da durch eine Luecke in der "
    "Panzerung dringen koennen, dafuer gleiten aber Schwert- und Axthiebe "
    "ohne Schaden zu machen daran ab.");

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 34);
  SetProp(P_MATERIAL, ([MAT_STEEL:100]) );
  SetProp(P_WEIGHT, 4000);
  SetProp(P_VALUE, 3200);
  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR: 15]) );

  AddDetail( ({"eisenringe","ringe"}),
    "Die vielen Eisenringe sind sehr engmaschig zusammen genietet und bieten "
    "einen guten Schutz.");
  AddDetail( ({"eisenplatten","brustplatte"}),
    "Die Eisenplatten verstaerken noch den Schutz der Eisenringe. Auf der "
    "Brustplatte ist eine Gravur zu erkennen.");
  AddDetail( ({"symbol","gravur"}),
    "Das Symbol besteht aus zwei gekreuzten Aexten, welches den "
    "Traeger zu einem Clanmitglied der Axtschwinger der Zwergenfeste von "
    "Ardhmir macht.");
}

