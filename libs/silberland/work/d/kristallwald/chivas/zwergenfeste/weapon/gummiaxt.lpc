inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Die Herrscheraxt von Ardhmir *Replika*");
  SetProp(P_LONG,  
    "Die Herrscheraxt von Ardhmir besitzt zwei Axtblaetter auf denen goldene "
    "Intarsien abgebildet sind. Die Schneiden der Axtblaetter sehen "
    "rasiermesserscharf aus.\n"
    "Leider ist es nur eine Replik aus Gummi. Es ist sicher was fuer "
    "Touristen.");
  SetProp(P_NAME, "Herrscheraxt");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"gummiaxt","herrscheraxt", "axt", "koenigsaxt"}) );
  SetProp(P_INFO, 
    "Nur maechtige Krieger koennen mit dieser Waffe kaempfen, wenn sie nicht "
    "aus Gummi waere.\n");

  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 1);
  SetProp(P_WC_FIX, 1);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL,([MAT_STEEL:35, MAT_MISC:100]));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 1);
  SetProp(P_SIZE, 120);
  SetProp(P_QUALITY_DECAY, 90);
}

