
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Zwergenarbeiter");
  SetProp(P_LONG, BS(
    "Der Zwergenarbeiter ist recht schmutzig und sein Bart ist sehr verfilzt. "
    "Seine strammen Muskeln sind durch die jahrelange Arbeit in den Stollen "
    "sehr hart geworden."));
  SetProp(P_NAME, "Zwergenarbeiter");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
  AddId(({"zwergenarbeiter"}));
  AddId(({"zwerg"}));
  AddId(({"arbeiter"}));

  create_default_npc(18);
  SetProp(P_HANDS, ({" mit seinen Faeusten",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 120);
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0,  DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0,  DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.0,  DT_MAGIC:  0.0, DT_MIND:   0.0]));
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "stapft herein.");
  SetProp(P_MSGOUT, "stapft.");
  SetProp(P_MMSGIN, "kommt herein.");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Mit mir legst Du Dich nicht mehr an, Du Schuft!");

 AddInfo(DEFAULT_INFO, "schaut Dich genervt an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das ist dem Zwerg zu schwer.\n" }) );

  SetChats(3, ({
          "Der Zwerg baut Eisen ab.\n",
          "Der Zwerg haemmert singend vor sich auf den Fels ein.\n"}) );

  SetAttackChats(10, ({
    "Der Zwerg taeuscht Dich mit einer Finte.\n",
    "Der Zwerg trifft Dich mit seiner Faust.\n"}) );
 SUID;
  //CLONEME( OBJ "meissel" );
  //CLONEME( "/d/kristallwald/chivas/dragonquest/obj/eisen" );
  CLONEME( "/p/weapon/axe/spitzhacke" );
  CLONEME( "/obj/schaufel" );
  command_me("zuecke spitzhacke");

}

