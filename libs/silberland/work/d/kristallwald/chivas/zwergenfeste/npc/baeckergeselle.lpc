#include "../def.h"

inherit "std/npc";


void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Baeckergeselle");
  SetProp(P_LONG,
    "Der junge Baeckergeselle steht hinter der Theke und laechelt Dich "
    "freundlich an. Obwohl es sich bei dem Zwerg um einen jungen Zwerg "
    "handelt, ist sein Bart schon sehr lang. Aber so ist das wohl bei den "
    "Zwergen.");

  SetProp(P_NAME, "Baeckergeselle");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));

  AddId( ({"baeckergeselle","geselle"}) );

  create_default_npc(18);
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 120);
  SetProp(P_WEIGHT, 170000);
  SetProp(P_ALIGN, 300);
  SetProp(P_SPELLRATE,25);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz weg");
  AddDetail( ({ "baeckergeselle","geselle"}),
    "Der Baeckergeselle ist fuer den Laden verantwortlich.");
  AddDetail( ({ "bart"}),
    "Alle Zwerge haben Baerte, auch die jungen Zwerge haben schon welche.");

  AddInfo(DEFAULT_INFO, "Was darf es sein?","fragt Dich: ");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"laden"}),
    "Dies ist mein Laden, wenn Du etwas willst, dann kauf es, ansonsten "
    "verschwende nicht meine Zeit.",
    "sagt: ");
    
  AddInfo( ({"zeit","inventur"}),
    "Ich habe keine Zeit, die Inventur muss noch gemacht werden.",
    "sagt: ");

  AddInfo( ({"baeckerei","backladen","laden"}),
    "Dies ist eine Aussenstelle der Baeckerei in Felonia. Die Waren werden "
    "morgens frisch angeliefert.",
    "sagt: ");

  AddInfo( ({"baeckerei","backladen","laden"}),
    "Tipp einfach 'Zeige' und Du siehst was Du kaufen kannst.",
    "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" will Deine Sachen nicht tragen.\n" }) );
  SetAttackChats(10,
    ({Name(WER,1)+" zuernt: Das ist also der Dank!\n"
     })
  );
 SUID;
  CLONEME( "/p/armour/armour/kettenhemd" );
  command("trage alles");
}

