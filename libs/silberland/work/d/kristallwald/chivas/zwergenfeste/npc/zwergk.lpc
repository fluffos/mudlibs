inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Zwerg");
  SetProp(P_LONG,
    "Der kleine Zwerg ist ein lustiger Geselle mit einem freundlichen Gesicht. "
    "Sein langer Bart reicht fast bis auf den Boden und er muss aufpassen, "
    "dass er nicht darauf tritt.");

  SetProp(P_NAME, "Zwerg");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));

  AddId( ({"zwerg"}) );

  create_default_npc(12);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 90);
  SetProp(P_WEIGHT, 170000);
  SetProp(P_ALIGN, 200);
  SetProp(P_SPELLRATE,25);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz weg");

  SetProp(P_MNPC_AREA, ( {ROOM "zwfe9", ROOM "zwfe10", ROOM "zwfe11",
                          ROOM "zwfe12", ROOM "zwfe13", ROOM "zwfe14",
                          ROOM "zwfe15", ROOM "zwfe16", ROOM "zwfe17",
                          ROOM "zwfe18"}));
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "zwfe9");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS); 

  AddDetail( ({ "zwerg","eindruck","geselle"}),
    "Dies ist ein kleiner Zwerg, der einen froehlichen Eindruck macht.");
  AddDetail( ({ "gesicht"}),
    "Der kleine Zwerg laechelt Dich an.");
  AddDetail( ({ "bart"}),
    "Der Bart reicht bis auf den Boden.");

  AddInfo(DEFAULT_INFO, "Der kleine Zwerg beachtet Dich nicht und geht seinen "
		        "eigenen Dingen nach.");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"ardhmir","zwergenfeste","feste","zwergenreich"}),
    "Die Zwergenfeste von Ardhmir ist ein grosses Zwergenreich.",
    "sagt: ");

  SetProp(P_DIE_MSG,  " faellt tot um.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein kleiner Zwerg");
  SetProp(P_KILL_MSG, "Wage es nicht, die Zwerge heraus zu fordern!");


  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das will der kleine Zwerg nicht haben.\n" }) );

  SetChats(3, ({
          "Der kleine Zwerg untersucht hier einige Dinge.\n",
          "Der kleine Zwerg beobachtet Dich.\n"}) );

  SetAttackChats(10, ({
    "Der kleine Zwerg beisst Dir ins Bein.\n",
    "Der kleine Zwerg tritt Dir auf den Fuss.\n"}) );

 SUID;
  CLONEME( "/p/weapon/axe/handaxt" );
  CLONEME( "/p/armour/armour/lederruestung" );
  command("trage alles");
  command("zuecke axt");
}

