#include "../def.h"

inherit "std/npc";


void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Thrax, der Ladenbesitzer");
  SetProp(P_LONG,
    "Thrax ist ein alter Zwerg, der hier in der Zwergenfeste von Ardhmir einen "
    "Laden eroeffnet hat. Er versorgt die Zwerge mit fast allen Waren. Fuer "
    "einen Zwerg ist Thrax recht schmaechtig. Er war sicher vor seiner Zeit "
    "als Ladenbesitzer keiner der gefuerchteten Zwergenkrieger.");

  SetProp(P_NAME, "Thrax");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));

  AddId( ({"thrax","ladenbesitzer","besitzer"}) );

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 120);
  SetProp(P_WEIGHT, 70000);
  SetProp(P_ALIGN, 200);
  SetProp(P_SPELLRATE,25);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz weg");
  AddDetail( ({ "ladenbesitzer"}),
    "Thrax besitzt diesen Laden.");
  AddDetail( ({ "zwerg"}),
    "Thrax ist als Zwerg ziemlich schmaechtig.");
  AddDetail( ({ "laden"}),
    "Thrax besitzt diesen Laden.");
  AddDetail( ({ "waren"}),
    "Thrax verkauft fast alles.");

  AddInfo(DEFAULT_INFO, "Was darf es sein?","fragt Dich: ");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"laden"}),
    "Dies ist mein Laden, wenn Du etwas willst, dann kauf es, ansonsten "
    "verschwende nicht meine Zeit.",
    "sagt: ");
    
  AddInfo( ({"zeit","inventur"}),
    "Ich habe keine Zeit, die Inventur muss noch gemacht werden.",
    "sagt: ");

  AddInfo( ({"zwerge","kunden","zeitgenossen"}),
    "Die Zwerge sind sehr gute Kunden und friedliche Zeitgenossen.",
    "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" will Deine Sachen nicht tragen.\n" }) );
  SetAttackChats(10,
    ({Name(WER,1)+" zuernt: Das ist also der Dank!\n"
     })
  );
 SUID;
  CLONEME( "/p/armour/trousers/kettenhose" );
  CLONEME( "/p/armour/armour/kettenhemd" );
  CLONEME( "/p/weapon/axe/handaxt" );
  command("trage alles");
  command("zuecke axt");
}

