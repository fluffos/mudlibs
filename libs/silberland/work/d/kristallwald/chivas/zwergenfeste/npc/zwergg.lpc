inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein grosser Zwerg");
  SetProp(P_LONG,
    "Der grosse Zwerg koennte beinahe als kleiner Mensch durchgehen. Er ist "
    "duenn, aber dafuer umso groesser. Er geht seinen taeglichen Arbeiten in "
    "der Zwergenfeste nach.");

  SetProp(P_NAME, "Zwerg");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));

  AddId( ({"zwerg"}) );

  create_default_npc(12);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 140);
  SetProp(P_WEIGHT, 170000);
  SetProp(P_ALIGN, 200);
  SetProp(P_SPELLRATE,25);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz weg");

  SetProp(P_MNPC_AREA, ( {ROOM "zwfe19", ROOM "zwfe20", ROOM "zwfe21",
                          ROOM "zwfe22", ROOM "zwfe23"}));
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "zwfe22");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS); 

  AddDetail( ({ "zwerg","eindruck","geselle"}),
    "Dies ist ein Zwerg, der einen froehlichen Eindruck macht.");
  AddDetail( ({ "groesse","mensch","menschen"}),
    "Der Zwerg ist sehr gross.");
  AddDetail( ({ "bart"}),
    "Der Bart reicht bis auf den Boden.");

  AddInfo(DEFAULT_INFO, "Der kleine Zwerg beachtet Dich nicht und geht seinen "
		        "eigenen Dingen nach.");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"ardhmir","zwergenfeste","feste","zwergenreich"}),
    "Die Zwergenfeste von Ardhmir ist ein grosses Zwergenreich.",
    "sagt: ");

  AddInfo( ({"arbeiten"}),
    "Meine Arbeiten gehen Dich nichts an.",
    "sagt: ");

  SetProp(P_DIE_MSG,  " faellt tot um.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein grosser Zwerg");
  SetProp(P_KILL_MSG, "Wage es nicht, die Zwerge heraus zu fordern!");


  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das will der Zwerg nicht haben.\n" }) );

  SetChats(3, ({
          "Der grosser Zwerg geht seinen Arbeiten nach.\n",
          "Der grosse Zwerg beobachtet Dich.\n"}) );

  SetAttackChats(10, ({
    "Der grosse Zwerg schubst Dich zur Seite.\n",
    "Der grosse Zwerg tritt Dir auf den Fuss.\n"}) );

 SUID;
  CLONEME( "/p/weapon/axe/handaxt" );
  CLONEME( "/p/armour/armour/lederruestung" );
  command("trage alles");
  command("zuecke axt");
}

