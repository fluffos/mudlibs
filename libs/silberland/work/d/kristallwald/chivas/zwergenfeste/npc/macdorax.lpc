#include "../def.h"

inherit "std/npc";


void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Macdorax, der Wirt");
  SetProp(P_LONG,
    "Macdorax ist ein Zwerg mittleren Alters mit einem grossen dicken Bauch. "
    "Sein langer Bart ist leicht verfilzt und er macht allgemein einen nicht "
    "wirklich sauberen Eindruck."
  );

  SetProp(P_NAME, "Macdorax");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));

  AddId( ({"macdorax","wirt"}) );

  create_default_npc(22);
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 125);
  SetProp(P_WEIGHT, 170000);
  SetProp(P_ALIGN, 100);
  SetProp(P_SPELLRATE,25);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz weg");
  AddDetail( ({ "wirt"}),
    "Macdorax ist hier der Wirt.");
  AddDetail( ({ "zwerg","bauch"}),
    "Macdorax ist ein fetter Zwerg.");
  AddDetail( ({ "eindruck","bart"}),
    "Macdorax ist ein wenig unsauber.");
  AddInfo(DEFAULT_INFO, "Was darf es sein?","fragt Dich: ");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"kneipe","gasthaus","wirtschaft"}),
    "Dies ist mein Wirtshaus. Ich werde noch Filialen im ganzen Silberland "
    "eroeffnen.",
    "sagt: ");
    
  AddInfo( ({"zeit","inventur"}),
    "Ich habe keine Zeit, die Inventur muss noch gemacht werden.",
    "sagt: ");

  AddInfo( ({"zwerge","kunden","zeitgenossen"}),
    "Die Zwerge sind sehr gute Kunden und friedliche Zeitgenossen.",
    "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" will Deine Sachen nicht tragen.\n" }) );
  SetAttackChats(10,
    ({Name(WER,1)+" zuernt: Das ist also der Dank!\n"
     })
  );
 SUID;
  CLONEME( "/d/kristallwald/chivas/zentauren/weapon/spiess" );
  CLONEME( "/p/armour/armour/kettenhemd" );
  command("trage alles");
  command("zuecke spiess");
}

