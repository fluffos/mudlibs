#include "../def.h"

inherit "std/npc";


void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Thorak, der Wirt");
  SetProp(P_LONG,
    "Thorak ist ein alter Zwerg mit einem langen Bart und einer riesigen Nase, "
    "die vom Trinken ganz rot ist. Sicher ist er selbst sein bester Kunde.");

  SetProp(P_NAME, "Thorak");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));

  AddId( ({"thorak","wirt"}) );

  create_default_npc(22);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 130);
  SetProp(P_WEIGHT, 70000);
  SetProp(P_ALIGN, 100);
  SetProp(P_SPELLRATE,25);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz weg");
  AddDetail( ({ "wirt","thorak"}),
    "Thorak ist der Wirt vom 'Weissen Drachen'.");
  AddDetail( ({ "zwerg"}),
    "Thorak ist ein alter Zwerg.");
  AddDetail( ({ "bart","fuessen","fuesse"}),
    "Der Bart von Thorak ist so lang, dass er fast bis zu seinen Fuessen "
    "reich.");
  AddDetail( ({ "nase"}),
    "Die grosse Nase von Thorak ist riesengross.");
  AddDetail( ({ "kunde"}),
    "Er ist sein bester Kunde.");

  AddInfo(DEFAULT_INFO, "Was darf es sein?","fragt Dich: ");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"kneipe","zwergenkneipe"}),
    "Die Kneipe gehoert mir. Sie ist nach einem weissen Drachen benannt.",
    "sagt: ");
    
  AddInfo( ({"drache","drachen","weisser drache"}),
    "Der weisse Drache soll den Geruechten nach in einer Hoehle leben.",
    "sagt: ");

  AddInfo( ({"hoehle"}),
    "Die Hoehle soll unter der Zwergenfeste von Ardhmir sein. Man soll sie "
    "durch die Schlucht in der grossen Halle erreichen koennen.",
    "sagt: ");

  AddInfo( ({"halle"}),
    "Die grosse Halle ist ausserhalb der Kneipe.",
    "sagt: ");

  AddInfo( ({"schlucht"}),
    "Die tiefe Schlucht soll der Zugang zur Hoehle sein.",
    "sagt: ");

  AddSpell(1,300, 
     "Thorak schlaegt Dich mit aller Kraft.\n",
     "Thorak schlaegt @WEN mit aller Kraft.\n",
     ({DT_BLUDGEON}), "schlaegt", ([SP_SHOW_DAMAGE:1]));

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" will Deine Sachen nicht tragen.\n" }) );
  SetAttackChats(10,
    ({Name(WER,1)+" zuernt: Das ist also der Dank!\n"
     })
  );
 SUID;
  CLONEME( "/p/weapon/knife/kuechenmesser" );
  command("zuecke kuechenmesser"); 
  CLONEME( "/p/armour/boots/eisenstiefel" );
  CLONEME( "/d/gebirge/angrox/obj/kettenhemd" );
  command("trage alles");
}

