
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein hinterhaeltiger Attentaeter");
  SetProp(P_LONG, BS(
    "Ein durchtraeinierter Dunkelelf steht vor Dir und umkreist Dich mit "
    "einem spitzen Dolch in der Hand. Er ist hager aber sicher ein ernst zu "
    "nehmender Gegner."));
  SetProp(P_NAME, "Attentaeter");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
  AddId(({"attentaeter","killer"})); 

  create_default_npc(26);
  SetProp(P_HANDS, ({" mit seinen Haenden",25,DT_BLUDGEON}));
  SetProp(P_RACE, "Dunkelelf");
  SetProp(P_SIZE, 189);
  SetProp(P_WEIGHT, 60000);
  SetProp(P_ALIGN, -700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,3);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0,  DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.3,  DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.3,
      DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.5,  DT_UNHOLY:    -0.5,  DT_MAGIC:  -0.3, DT_MIND:   0.0]));
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "taucht aus dem Nichts auf");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");

  SetProp(P_DIE_MSG,  " stuerzt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Attentaeter");
  SetProp(P_KILL_MSG, "Auftrag erfuellt. Melde erfolgreichen Mord, Herr Delgo!");

 AddInfo(DEFAULT_INFO, "schaut Dich genervt an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das ist dem Dunkelelfen zu schwer.\n" }) );

  SetAttackChats(10, ({
    "Der Attentaeter schleicht lauernd um Dich herum.\n",
    "Der Attentaeter sticht Dich mit seinem Dolch.\n"}) );

 SUID;
  CLONEME( "/p/weapon/knife/meucheldolch" );
  command("zuecke meucheldolch"); 
  CLONEME( "/d/unterwelt/zordan/dhrkion/armour/spinnenpanzer" );
  CLONEME( "/d/unterwelt/zordan/dhrkion/armour/chitinguertel" );
  CLONEME( "/d/unterwelt/zordan/dhrkion/armour/chitinarmschienen" );
  CLONEME( "/p/armour/gloves/lederhandschuhe" );
  command("trage alles");

}

