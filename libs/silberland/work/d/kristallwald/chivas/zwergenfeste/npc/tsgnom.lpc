//erstellt im mai 04 von chivas
inherit "std/mnpc";

inherit "/std/player/moneyhandler";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Silbergnom");
  SetProp(P_LONG,
    "Der kleine Silbergnom hat struppelige silberne Haare und und ein gieriges "
    "Glitzern in den Augen. Er scheint recht reich zu sein, da er die besten "
    "Stoffe am Koerper traegt und ein teures Amulett.");
  SetProp(P_NAME, "Silbergnom");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId( ({ "silbergnom","gnom"}) );

  create_default_npc(24);

SetProp(P_HANDS, ({" mit seinen Haenden" ,QueryProp(P_HANDS)[1], DT_RIP }) );

  SetProp(P_SIZE, 100 );
  SetProp(P_RACE, "Gnom");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,25);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "stapft heran");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "kommt Dich gierig anschauend herein.");
  SetProp(P_MMSGOUT, "trabt sein Geld zaehlend weiter.");
  
  SetProp(P_MNPC_AREA, ( {ROOM "zwfe16", ROOM "zwfet", ROOM "zwfe17",
                          ROOM "zwfe18", ROOM "zwfep", ROOM "zwfe10",
                          ROOM "zwfe11", ROOM "zwfe12", ROOM "zwfe28",
                          ROOM "zwfef", ROOM "zwfe9", ROOM "zwfe8",
                          ROOM "zwfe7", ROOM "zwfe13", ROOM "zwfe14",
                          ROOM "zwfe15", ROOM "zwfe19", ROOM "zwfe20",
                          ROOM "zwfe21", ROOM "zwfe22",
                          ROOM "zwfe23", ROOM "zwfe24", ROOM "zwfe25",
                          ROOM "zwfe26",ROOM "zwfe27"}));
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "zwfe16");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS); 

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder %s, dann stirbst Du auf ganz"
		        "gemeine Weise");
  SetProp(P_KILL_NAME, "Ein kleiner Silbergnom");
  SetProp(P_KILL_MSG, "Du hattest nicht den Hauch einer Chance, Kleiner!");

  AddDetail( ({ "haare"}),
    "Die Haare sind struppelig und glaenzen silbrig.");
  AddDetail( ({ "glitzern","augen"}),
    "Das Glitzern in den Augen des Gnoms wirkt sehr gierig.");
  AddDetail( ({ "stoffe","koerper"}),
    "Die Stoffe, die der Gnom traegt sind sehr teuer. Er scheint recht gut "
    "zu verdienen.");
  AddDetail( ({ "amulett"}),
    "Das Amulett ist auch sehr teuer.");

  AddInfo(DEFAULT_INFO, "interessiert nicht was Du sagst.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"gold"}),
    "Tja, falls Du ein paar Stuecke Silber brauchst, so kann ich Dir sicher "
    "welche verkaufen. Sie sind auch gar nicht teuer, sie kosten nur 3000 "
    "Muenzen.","sagt: ");
  AddInfo( ({"axt","axtblatt"}),
    "Du brauchst sicher Silber und Gold fuer ein magisches Axtblatt.","sagt: ");
  AddInfo( ({"teuer","preis"}),
    "Da Du mir sehr sympatisch bist, kostet Dich die Sache pro Silber nur 3000 "
    "Muenzen.","sagt: ");

  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der kleine Silbergnom will Deine Sachen nicht tragen.\n" }) );

  AddSpell(1,400, 
     "Ein Silbergnom tritt Dir voller Kraft gegen das Schienenbein.\n",
     "Ein Silbergnom trampelt @WEN voller Kraft gegen das Schienenbein.\n",
     ({DT_BLUDGEON}), "tritt", ([SP_SHOW_DAMAGE:1]));
    
  SetChats(3, ({
    "Ein Silbergnom begutachtet Dich gierig.\n",
    "Ein Silbergnom ueberlegt, ob Du ein zukuenftiger Kunde sein wirst.\n"}) );
  SetAttackChats(10, ({
    "Ein Silbergnom beisst Dir in die Wade.\n",
    "Der grosse Zentaur zereisst Dich.\n"}) );

 SUID;
  CLONEME( "/p/weapon/knife/obsidiandolch" );
  CLONEME( "/p/armour/amulet/amulett" );
  CLONEME( "/p/armour/ring/ring" );
  CLONEME( "/p/armour/armour/seidenjacke");
  command("trage alles");
  command("zuecke obsidiandolch");

AddCmd( ({"kaufe","kauf"}), "kaufen");

}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt einen Silbergnom.");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Ein kleiner Silbergnom hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

 int _query_wimpy() { return 0; }

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "redet beruhigend auf Dich ein.",
        "beruhigt Dich fluesternd.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "lacht Dich aus.",
        "grinst leise.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "faucht Dich an.",
        "beschimpft Dich.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
  
  
}
void tritt(object enemy, int damage, mixed dam_type)
{
  if (!enemy->QueryProp(P_DISABLE_ATTACK))
    enemy->SetProp(P_DISABLE_ATTACK, 1+random(3));
}
int kaufen(string str)
{
  object edelmetall;
  notify_fail("Was moechtest Du kaufen?\n");

  if ( member( ({ "silber","stueck silber" }), str ) != -1 )

  if(TP->QueryMoney() < 3000) 
  {
    tell_object(TP,"Du hast nicht genug Geld dabei.\n");
    return -1;
  }

  edelmetall = clone_object( "/p/std/dragons/obj/schuppe");
  edelmetall->move(TP,M_GET|M_SILENT);
  TP->AddMoney(-3000);
  write(BS("Du bezahlst den Silbergnom, der gierig das Geld einsteckt, Dir "
	   "aber nur zoegerlich ein Stueck Silber gibt.\n"));
  "p/daemon/zentralbank"->PayIn(3000, 100);

  return 1;
}



