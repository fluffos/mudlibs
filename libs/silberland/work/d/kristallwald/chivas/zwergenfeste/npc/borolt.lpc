#include "../def.h"

inherit "std/npc";


void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Borolt, der Schmied von Ardhmir");
  SetProp(P_LONG,
    "Borolt ist der Schmied der Zwergenfeste. Er hat eine sehr muskuloese und "
    "gedrungene Gestalt. Sein langer Bart hat an mehreren Stellen Luecken, die "
    "durch das Feuer an der Schmiede entstanden sind.");

  SetProp(P_NAME, "Borolt");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));

  AddId( ({"borolt","schmied"}) );

  create_default_npc(28);
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 167);
  SetProp(P_WEIGHT, 170000);
  SetProp(P_ALIGN, 300);
  SetProp(P_SPELLRATE,25);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz weg");

  AddDetail( ({ "schmied","zwergenfeste"}),
    "Borolt ist der Schmied der Zwergenfeste.");

  AddDetail( ({ "gestalt"}),
    "Er ist sehr muskuloes.");

  AddDetail( ({ "bart","stellen","luecken","feuer","schmiede"}),
    "Der Bart von Borolt ist nicht in dem besten Zustand. Anscheinend fackelt "
    "er ab und zu den Bart an, so dass er einige Luecken hat.");

  AddInfo(DEFAULT_INFO, "Was darf es sein?","fragt Dich: ");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"schmiede"}),
    "Die Schmiede gehoert mir.",
    "sagt: ");
    
  AddInfo( ({"zwergenfeste","ardhmir"}),
    "Ich schmiede hier alles in der Zwergenfeste von Ardhmir.",
    "sagt: ");

  AddInfo( ({"zwerge","kunden"}),
    "Die Zwerge sind sehr gute Kunden.",
    "sagt: ");

  AddInfo( ({"axt"}),
    "Ich kann Dir sicher ein Axtblatt verfeinern.",
    "sagt: ");
    
  AddInfo( ({"axtblatt","blatt"}),
    "Wenn Du mir ein Axtblatt aus Eisen gibst, dann kann ich es mit Intarsien "
    "aus Gold und Silber verfeinern. Ich braeuchte jedoch fuer diese Aufgabe "
    "einige wichtige Sachen.",
    "sagt: ");

  AddInfo( ({"eisen","roch","adan","roch adan"}),
    "Ein Axtblatt aus Eisen bekommst Du sicher beim Schmied in Roch Adan.",
    "sagt: ");

  AddInfo( ({"intarsien"}),
    "Intarsien aus Gold und Silber sind sehr wichtig. Sie geben der Axt eine "
    "gewisse Macht, wenn die Axt magisch wird. Ich brauche jedoch einige "
    "Sachen fuer die Intarsien.",
    "sagt: ");
    
  AddInfo( ({"aufgabe","sachen"}),
    "Um die Intarsien in das eiserne Axtblatt zu bekommen, benoetige ich "
    "natuerlich das Axtblatt, ausserdem drei Stuecke Gold und zwei Stuecke "
    "Silber. Um die Metalle richtig miteinander verschmelzen zu koennen, "
    "benoetige ich eine Fackel, die mit Drachenfeuer entzuendet wurde, da "
    "ansonsten die Esse nicht heiss genug wird. Desweiteren brauche ich "
    "fuenf Diamanten um die Schneide zu verfeinern und dann waere da noch mein "
    "Lohn.",
    "sagt: ");

  AddInfo( ({"gold","silber","stuecke"}),
    "Das Gold und das Silber kannst Du sicher irgendwo kaufen oder finden, "
    "was weiss ich, such es einfach.",
    "sagt: ");

  AddInfo( ({"metalle","drachenfeuer","feuer","esse","fackel"}),
    "Um die Metalle richtig zu verschmelzen, muss das Feuer in der Esse "
    "besonders heiss sein. Nur Drachenfeuer kann die Glut so heiss machen. "
    "Nimm eine Fackel und frage einen Drachen nach seinem Drachenfeuer und "
    "bring es mir.",
    "sagt: ");
    
  AddInfo( ({"diamanten","klinge","haerte"}),
    "Die Diamanten geben der Klinge eine besondere Haerte. Du brauchst fuenf "
    "Diamanten.",
    "sagt: ");

  AddInfo( ({"zwergenmagier","magier"}),
    "Der Zwergenmagier von Ardhmir laeuft hier in der Feste irgendwo rum. Du "
    "musst ihn halt suchen.",
    "sagt: ");

  AddInfo( ({"lohn"}),
    "Also mein Lohn fuer die Arbeit sind fuenf Drachenschuppen. Wenn Du alles "
    "beisammen hast, das Gold, das Silber, die Fackel mit Drachenfeuer, die "
    "Diamanten, das eiserne Axtblatt und mein Lohn, dann kommt zurueck und "
    "gib mir meine fuenf Schuppen. Danach werde ich anfangen das Axtblatt zu "
    "vervollstaendigen.",
    "sagt: ");

  AddSpell(3,800, 
     "Borolt schlaegt Dich so hart, so dass Du Sternchen siehst.\n",
     "Borolt schlaegt @WEN sehr hart.\n",
     ({DT_BLUDGEON}), "schlaegt", ([SP_SHOW_DAMAGE:1]));

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" will Deine Sachen nicht tragen.\n" }) );
  SetAttackChats(10,
    ({Name(WER,1)+" zuernt: Das ist also der Dank!\n"
     })
  );
 SUID;
  CLONEME( "/p/armour/trousers/lederhose" );
  CLONEME( "/p/armour/boots/lederstiefel" );
  CLONEME( "/p/weapon/club/schmiedehammer" );
  command("trage alles");
  command("zuecke hammer");

AddCmd( ({"gib","gebe"}), "geben");

}
// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "redet beruhigend auf Dich ein.",
        "beruhigt Dich fluesternd.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schimpft leise auf Dich.",
        "grummelt ueber dich fluesternd.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert leise ueber Dich.",
        "kichert leise.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "wirf Sachen nach Dir.",
        "tritt Dich mit Ihren Hufen.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich guetig an.",
        "laechelt guetig.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "kuschelt Dich zaertlich zurueck.",
        "kuschelt Dich zaertlich.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "fluestert das ihr das sehr gefaellt.",
        "fluestert das ihr das sehr gefaellt.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        TP->Name(WER)+" wird von Arien getroestet.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
  
  
}
void schlaegt(object enemy, int damage, mixed dam_type)
{
  if (!enemy->QueryProp(P_DISABLE_ATTACK))
    enemy->SetProp(P_DISABLE_ATTACK, 1+random(3));
}
int geben(string str)
{
   object axtblatt2;
   object ob;
   object ob2;
   notify_fail("Wieviele moechtest Du wovon an wen geben?\n");
   if ( member( ({ "fuenf schuppen an borolt", "borolt fuenf schuppen","borolt 5 schuppen","5 schuppen an borolt","schmied fuenf schuppen","schmied 5 schuppen","5 schuppen an schmied","fuenf schuppen an schmied" }),str) != -1) 
{
     if( !present("dragoninvis1",TP))
     {
        write(BS("Borolt sagt: Also mein Freund, Du brauchst doch gar nichts "
		 "von mir. Also brauchst Du mir auch nichts zu geben. Du "
		 "kannst natuerlich zu Anezram gehen und ihm Hilfe anbieten, "
		 "dann helfe ich Dir auch, wenn die Zeit reif dafuer ist.\n"));
        return -1;
     }
     if( !present("CHIVASAXTBLATT1",TP))
     {
        write(BS("Borolt sagt: Du hast ja noch nicht einmal das eiserne "
		 "Axtblatt. Lass es Dir erst einmal vom Schmied in Roch Adan "
		 "herstellen, dann komm wieder zu mir.\n"));
        return -1;
     }     
     if( present("CHIVASAXTBLATT2",TP))
     {
        write(BS("Borolt sagt: Du hast doch schon ein verziertes Axtblatt, "
		 "was willst Du denn noch mit einem zweiten Axtblatt.\n"));
        return -1;
     }     
     if( !present("gold 3",TP))
     {
        write(BS("Borolt sagt: Du hast leider nicht genug Gold. Du benoetigst "
		 "drei Stuecke Gold fuer die Intarsien.\n"));
        return -1;
     }     
     if( !present("silber 2",TP))
     {
        write(BS("Borolt sagt: Du hast leider nicht genug Silber. Du "
		 "benoetigst zwei Stuecke Silber fuer die Intarsien.\n"));
        return -1;
     }     
     if( !present("CHIVASFACKEL",TP))
     {
        write(BS("Borolt sagt: Ich brauche das Feuer eines Drachen um die "
		 "Esse heiss genug zu bekommen um die Metalle miteinander zu "
		 "verbinden. Bring mir erst eine Fackel mit Drachenfeuer, dann "
		 "kann ich Dir helfen.\n"));
        return -1;
     }     
     if( present("diamant") && present("diamant")->QueryProp(P_AMOUNT) < 5)
     {
        write(BS("Borolt sagt: Du benoetigst 5 Diamanten fuer die Klinge "
		 "der Axt. Du hast nicht genug bei Dir. Komm wieder, wenn "
		 "Du fuenf Diamanten hast.\n"));
        return -1;
     }     
     if( present("schuppen") && present("schuppen")->QueryProp(P_AMOUNT) < 5)
     {
        write(BS("Borolt sagt: Du benoetigst 5 Schuppen als Lohn fuer meine"
		 "Arbeit.\n"));
        return -1;
     }     
     else
      {
      {axtblatt2 = clone_object( "/d/kristallwald/chivas/dragonquest/obj/axtblatt2");
  present("CHIVASAXTBLATT1",TP)->remove();
  present("gold 1",TP)->remove();
  present("gold 1",TP)->remove();
  present("gold 1",TP)->remove();
  present("silber 1",TP)->remove();
  present("silber 1",TP)->remove();
  present("CHIVASFACKEL",TP)->remove();
  if (ob = present("diamant", TP))
  ob->AddAmount(-5);
  if (ob2 = present("schuppen", TP))
  ob2->AddAmount(-5);
  if ( ME_TOO_HEAVY == axtblatt2->move(TP,M_GET|M_SILENT) )
     {
     write("Das verzierte Axtblatt wuerde Dir zu schwer werden.\n" );
     axtblatt2 -> remove();
     return 1;
     }
     else
     {
     write(BS("Du gibt Borolt seine geforderten fuenf Schuppen und "
              "die dazu gehoerigen Bestandteile um das verzierte "
	      "Axtblatt herzustellen.\n"
	      "Blakaldur sagt: Hervorragend, Du hast alle Teile "
	      "zusammen, die ich fuer die Herstellung brauche Ich "
	      "werde nun damit beginnen das Axtblatt dementsprechend "
	      "zu schmieden.\n"));
     TP->SetProp(P_PARALYZED, ([
                PARALYZE_TIME: 5,
                PARALYZE_MSG: "Du bist fasziniert, wie Borolt das Axtblatt "
		              "verfeinert.\n",
                PARALYZE_END: "Als Borolt fertig ist, ueberreicht er Dir das "
		              "verzierte Axtblatt und sagt: Hier hast Du "
			      "es, aber um es nun magisch zu verwandelt, "
			      "musst Du zu unserem Zwergenmagier gehen.\n"]) );	
      call_out("fall1",4);
      return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}
void fall1()
{
  write(BS( "Borolt nimmt die Fackel mit dem Drachenfeuer und entzuendet die "
	    "Esse mit dem Drachenfeuer. Eine unheimlich starke Hitze stroemt "
	    "aus der Esse.\n"));
  call_out("fall2",7);
}
void fall2()
{
  write(BS( "Borolt wirft das Silber und das Gold in die Esse und die "
	    "Metalle schmelzen unter der Hitze sofort. Das eiserne Axtblatt "
	    "legt er nur an den Rand, so dass es nur leicht zu gluehen "
	    "anfaengt.\n"));
  call_out("fall3",7);
}
void fall3()
{
  write(BS( "Als das Axtblatt gut durchgeglueht ist, nimmt er es und beginnt "
	    "Linien fuer die Intarsien mit dem Werkzeug in das gluehende "
	    "Axtblatt zu schnitzen.\n"));
  call_out("fall4",7);
}
void fall4()
{
  write(BS( "Als der Schmied damit fertig ist, fuellt er die eben "
	    "eingravierten Vertiefungen mit dem fluessigen Gold und Silber "
	    "auf.\n"));
  call_out("fall5",7);
}
void fall5()
{
  write(BS( "Als letzte Taetigkeit bringt Borolt die Diamanten direkt an den "
	    "Schneiden an, so dass diese noch wertvoller aussieht und im "
	    "Schein des Feuers funkelt.\n"));
}
