
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Garbox, der Herrscher von Ardhmir");
  SetProp(P_LONG, BS(
    "Garbox ist ein kraeftiger Zwerg mit einem grimmigen Gesicht. Er ist "
    "eing grosser Krieger unter den Zwergen von Ardhmir und der Herrscher "
    "der Feste."));
  SetProp(P_NAME, "Garbox");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
  AddId(({"garbox","herrscher","zkoenig"})); 

  create_default_npc(40);
  SetProp(P_HANDS, ({" mit seinen Haenden",25,DT_BLUDGEON}));
  SetProp(P_RACE, "Zwergt");
  SetProp(P_SIZE, 120);
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, 500);
  SetProp(P_SPELLRATE,80);
  SetProp(P_NOMAGIC,20);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,3);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.3, DT_COLD:      0.0,  DT_WATER:  0.3, DT_AIR:    0.0, 
      DT_LIGHTNING: -0.2,  DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  -0.2,
      DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.3, DT_TERROR: 0.0,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.5,  DT_MAGIC:  0.0, DT_MIND:   0.0]));
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt in die Ratshalle");
  SetProp(P_MMSGOUT, "verlaesst die Ratshalle");

  SetProp(P_DIE_MSG,  " stuerzt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Garbox, Herrscher von Ardhmir");
  SetProp(P_KILL_MSG, "Die Zwerge werden Dich verfluchen!");

  AddDetail( ({ "zwerg"}),
    "Garbox ist ein kraeftiger Zwerg.");

  AddDetail( ({ "gesicht"}),
    "Garbox hat zwar ein grimmiges Gesicht, aber er ist ein weiser Herrscher.");

  AddDetail( ({ "krieger"}),
    "Garbox ist ein guter Krieger.");

  AddDetail( ({ "herrscher"}),
    "Garbox ist der Herrscher der Feste.");

  AddDetail( ({ "ardhmir","feste","zwergenfeste"}),
    "Garbox ist der Herrscher von Ardhmir.");

  AddInfo(DEFAULT_INFO, "schaut Dich genervt an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das ist Garbox zu schwer.\n" }) );

  AddSpell(5,600, 
    "Die Ratshalle erkennt Dich nun als Feind des Herrschers an und ein Blitz "
    "von der Decke trifft Dich.\n",
    "Ein Blitz aus der Decke trifft @WEN mitten am Oberkoerper.\n",
    ({DT_LIGHTNING}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(3,800, 
    "Garbox trifft Dich mit seiner Axt, so dass Du nur noch Sternchen siehst.\n",
    "Garbox trifft mit seiner Axt @WEN mit aller Wucht.\n",
    ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2, 1, DS_PARALYZE,
    "Garbox paralysiert Dich mit seinem gekonnten Axtschwingen, so dass Du "
    "Dich vor Faszination nicht mehr bewegen kannst!\n",
    "Garbox paralysiert @WEN!\n" );

  AddDefaultSpell(3, 100, DS_DISARM);    

  SetChats(3, ({
          "Garbox gibt einige Befehle.\n",
          "Garbox unterschreibt ein paar Gesetze der Zwergenfeste.\n",
          "Garbox denkt angestrengt nach.\n"}) );

  SetAttackChats(10, ({
    "Garbox zerschmettert Dich.\n",
    "Garbox stuerzt sich wie ein Berserker auf Dich.\n"}) );

  SUID;
  CLONEME( "/p/armour/boots/eisenstiefel" );
  CLONEME( "/p/armour/helm/mithrilhelm" );
  CLONEME( "/p/armour/trousers/kettenhose" );
  CLONEME( "/p/armour/gloves/panzerhandschuhe" );
  CLONEME( WEAPON "koenigsaxt" );
  CLONEME( ARMOUR "mithrilkettenhemd");
  command("trage alles");
  command("zuecke axt");

ZWERGENMASTER -> add_wache();

}
void init()
{
  ::init();

 if ( ZWERGENMASTER -> IsWachefeind(TP) ) Kill(TP);

}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;
  
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "haelt Dich fuer ein unwichtiges Wesen, darum reagiert er nicht.",
        "findet Dich uninteressant.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "verflucht Dich.",
        "bewegt seine Haende und entzuendet ein Feuer unter Deinem Hintern.");
        TP->AddHp(-10);
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "haelt Dich einfach nur fuer laestig.",
        "beachtet Dich nicht.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "entzuendet magisch ein kleines Feuer unter Deinen Fuessen.",
        "tritt Dich.");
        TP->AddHp(-10);
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "findet das ekelig.",
        "will Dich nicht mehr sehen.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "verhext Dich sofort.",
        "findet das ekelig.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "findet das ekelig.",
        "will Dich nicht mehr sehen.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "lacht Dich aus.",
        TP->Name(WER)+" wird von Istar ausgelacht.");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
void hilfe()
{
 object hilfe;
 tell_room(ENV(TO), "Ein kleiner Zwergendiener stuerzt in die Ratshalle um "
		    "seinen Herscher zu beschuetzen.\n");
hilfe=clone_object (NPC "khilfe" );
 hilfe->move(ENV(TO), M_GO|M_NOCHECK);
}

//masterbeginn

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  ZWERGENMASTER -> ruf_um_hilfe(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

void Attack(object enemy)
{
  int i;
  object ob;
  string raum;
  string *raum2;
  mapping exits;
  string *ausgaenge;

  ::Attack(enemy);
   if (!random(5))
    hilfe();

   exits = environment()->QueryProp(P_EXITS);
  ausgaenge = m_indices(exits);
  for ( i = sizeof(ausgaenge)-1; i>=0; i-- )
  {
    if ( !objectp(enemy) ) return;
    raum2 = explode(exits[ausgaenge[i]], "#" );
    raum = raum2[sizeof(raum2)-1];
    for ( ob=first_inventory(raum); ob; ob=next_inventory(ob) )
      if ( living(ob) && !query_once_interactive(ob) &&
           ob->id("\nzwergenkrieger") )
      {
	raum = file_name(ENV(TP));
	ob -> move(raum ,M_TPORT, 0,
          "hoert ein Heulen aus der Ferne und laeuft davon",
	  "kommt rasch herein gelaufen" );
        if ( enemy )
          ob -> Kill(enemy);
        return ::Attack(enemy);
      }
  }
  if (!objectp(enemy)) return;
  for ( ob=first_inventory(environment()); ob; ob=next_inventory(ob) )
    if ( living(ob) && !query_once_interactive(ob) &&
         ob->id("\nzwergenkrieger") )
      ob -> Kill(enemy);
  return ::Attack(enemy);
}

int remove(int arg)
{
  ZWERGENMASTER -> remove_wache(TO);
  return ::remove(arg);

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if ( killer == TO ) ZWERGENMASTER -> Sieg(player);
}

