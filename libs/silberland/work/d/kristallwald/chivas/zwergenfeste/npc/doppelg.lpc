
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Blakaldur, der Zwergenzauberer");
  SetProp(P_LONG, BS(
    "Blakaldur ist ein weiser alter Zwerg, der der Zauberer der Zwergenfeste "
    "und der Berater des Herrschers ist. Er steht gebueckt auf seinem Stock "
    "vor Dir und murmelt geistesabwesend vor sich hin. Man sollte ihn "
    "definitiv nicht unterschaetzen."));
  SetProp(P_NAME, "Blakaldur");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:0]));
  AddId(({"blakaldur","zwergenzauberer","zwerg","zauberer"}));

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit seinen Haenden",25,DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 85);
  SetProp(P_WEIGHT, 40000);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "entsteht aus dem Nichts.");
  SetProp(P_MSGOUT, "geht.");
  SetProp(P_MMSGIN, "kommt boese schnaubend herein.");
  SetProp(P_MMSGOUT, "verschwindet.");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Mit mir legst Du Dich nicht mehr an, Du Schuft!");

 AddInfo(DEFAULT_INFO, "schaut Dich genervt an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das ist dem Doppelgaenger zu schwer.\n" }) );

  SetChats(3, ({
          "Der Doppelgaenger grummelt herum.\n"}) );

  SetAttackChats(10, ({
    "Der Doppelgaenger droht mit seinen Faeusten.\n",
    "Der Doppelgaenger tritt Dir gegen das Schienenbein.\n"}) );

  ZWERGENMASTER -> add_wache();
  
}

void init()
{
  ::init();

 if ( ZWERGENMASTER -> IsWachefeind(TP) ) Kill(TP);

}

//masterbeginn

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  ZWERGENMASTER -> ruf_um_hilfe(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

void Attack(object enemy)
{
  int i;
  object ob;
  string raum;
  string *raum2;
  mapping exits;
  string *ausgaenge;

  exits = environment()->QueryProp(P_EXITS);
  ausgaenge = m_indices(exits);
  for ( i = sizeof(ausgaenge)-1; i>=0; i-- )
  {
    if ( !objectp(enemy) ) return;
    raum2 = explode(exits[ausgaenge[i]], "#" );
    raum = raum2[sizeof(raum2)-1];
    for ( ob=first_inventory(raum); ob; ob=next_inventory(ob) )
      if ( living(ob) && !query_once_interactive(ob) &&
           ob->id("\nzwergenkrieger","garbox") )
      {
	raum = file_name(ENV(TP));
	ob -> move(raum ,M_TPORT, 0,
          "hoert ein Heulen aus der Ferne und laeuft davon",
	  "kommt rasch herein gelaufen" );
        if ( enemy )
          ob -> Kill(enemy);
        return ::Attack(enemy);
      }
  }
  if (!objectp(enemy)) return;
  for ( ob=first_inventory(environment()); ob; ob=next_inventory(ob) )
    if ( living(ob) && !query_once_interactive(ob) &&
         ob->id("\nzwergenkrieger","garbox") )
      ob -> Kill(enemy);
  return ::Attack(enemy);
}

int remove(int arg)
{
  ZWERGENMASTER -> remove_wache(TO);
  return ::remove(arg);

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if ( killer == TO ) ZWERGENMASTER -> Sieg(player);
}


