
inherit "std/mnpc";
inherit "std/npc/spells";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Blakaldur, der Zwergenzauberer");
  SetProp(P_LONG, BS(
    "Blakaldur ist ein weiser alter Zwerg, der der Zauberer der Zwergenfeste "
    "und der Berater des Herrschers ist. Er steht gebueckt auf seinem Stock "
    "vor Dir und murmelt geistesabwesend vor sich hin. Man sollte ihn "
    "definitiv nicht unterschaetzen."));
  SetProp(P_NAME, "Blakaldur");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:50]));
  AddId( ({ "blakaldur","zwergenzauberer","zwerg","zauberer"}) );

  create_default_npc(40);
  SetProp(P_HANDS, ({" mit seinen Haenden" ,QueryProp(P_HANDS)[1], DT_RIP }) );
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 120 );
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_SPELLRATE,80);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.3, DT_COLD:      0.0,  DT_WATER:  0.3, DT_AIR:    0.0, 
      DT_LIGHTNING: -0.2,  DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  -0.2,
      DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.3, DT_TERROR: 0.0,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.5,  DT_MAGIC:  0.0, DT_MIND:   0.0]));
  SetProp(P_ARTICLE, 0);
  SetProp(P_MSGIN, "schleicht murmelnd herein");
  SetProp(P_MSGOUT, "schleicht murmelnd weiter");
  SetProp(P_MMSGIN, "schleicht fluesternd herein");
  SetProp(P_MMSGOUT, "schleicht fluesternd weiter");

  SetProp(P_MNPC_AREA, ( {ROOM "zwfe26", ROOM "zwfe24", ROOM "zwfe25",
                          ROOM "zwfe21"}));
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "zwfe26");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS); 

  SetProp(P_DIE_MSG,  " faellt tot zu Bode.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Blakaldur");
  SetProp(P_KILL_MSG, "Zwergenmagie ist viel zu stark fuer Dich!");

  AddDetail( ({ "zauberer","blakaldur","zwerg"}),
    "Blakaldur ist ein Zwerg, der hier in der Zwergenfeste der Zauberer und "
    "Berater ist.");
  AddDetail( ({ "berater"}),
    "Er beraet den Herrscher in wichtigen Fragen.");
  AddDetail( ({ "herrscher"}),
    "Er beraet den Herrscher.");

  AddInfo(DEFAULT_INFO, "spielt mit ein paar Feuerbaellen in seinen Haenden "
                        "und beachtet Dich nicht.\n");

  AddInfo( ({"herrscher"}),
    "Der Herrscher ist ein guter Zwerg, der die Geschicke der Zwergenfeste "
    "sehr gut lenkt.","sagt: ");

  AddInfo( ({"zwergenfeste","feste","ardhmir","zwergenreich"}),
    "Die Zwergenfeste von Ardhmir ist ein grosses Zwergenreich.","sagt: ");

  AddInfo( ({"drache","drachen"}),
    "Ich kenne zwei Drachen, die hier in der Naehe leben. Da ist "
    "Anezram, der weisse Drache und Akinaj, der schwarze Drache.","sagt: ");

  AddInfo( ({"anezram"}),
    "Anezram wohnt unterhalb der Schlucht. Probier doch einmal zu ihm zu "
    "kommen.","sagt: ");

  AddInfo( ({"akinaj"}),
    "Akinaj ist ein boeser schwarzer Drache, der die Umgebung ausserhalb der "
    "Hochebene terrorisiert. Er lebt nordwestlich der Hochebene in einem "
    "Turm. Er kann nur durch eine magische Axt besiegt werden.","sagt: ");

  AddInfo( ({"hochebene"}),
    "Die Hochebene von Gorthad befindet sich oberhalb der "
    "Zwergenfeste","sagt: ");

  AddInfo( ({"axt"}),
    "Um den Drachen zu besiegen, benoetigst Du eine magische Axt. Ich kann Dir "
    "dabei helfen eine magische Axt zu fertigen. Du musst nur alle Teile "
    "haben.","sagt: ");

  AddInfo( ({"teile"}),
    "Damit ich eine Beschwoerung sprechen und ein Ritual durchfuehren "
    "kann, benoetige ich folgende Teile: das verzierte Axtblatt, den Axtschaft "
    "Sternenstaub und einen besonderen Dolch fuer das Ritual. Wenn Du alles "
    "dabei hast, dann gib mir einfach den Mithrildolch und ich starte mit dem "
    "Ritual und gebe Dir dann die magische Axt um den Drachen zu "
    "besiegen.","sagt: ");

  AddInfo( ({"axtblatt"}),
    "Das Axtblatt muss mit Drachenfeuer geschmiedet sein und mit Gold, Silber "
    "und Diamanten verziert sein. Frag doch mal den Schmied.","sagt: ");

  AddInfo( ({"axtschaft","schaft","tischler"}),
    "Der Axtschaft muss sauber geschnitzt sein und mit Runen verziert "
    "sein. Frag doch mal den Tischler in Roch Adan.","sagt: ");

  AddInfo( ({"sternenstaub","staub","astrologe"}),
    "Den Sternenstaub gibt es beim Astrologen von Roch Adan.","sagt: ");

  AddInfo( ({"tempel","dschungel"}),
    "Der Tempel befindet sich westlich von Tijara im Dschungel. Es ist der "
    "Tempel des Blutes, also pass auf Dich auf.","sagt: ");

  AddInfo( ({"reichtuemer, tempelspitze, drache"}),
    "In der Tempelspitze hat ein Drache seine Reichtuemer angehaeuft. "
    "Darunter muss sich auch der Dolch befinden.","sagt: ");

  AddInfo( ({"dolch"}),
    "Es ist ein besonderer Dolch, der vor langer Zeit uns Zwergen gestohlen "
    "wurde. Der Dolch soll sich nun in einem Tempel im Dschungel befinden. "
    "Dort in der Tempelspitze unter den ganzen Reichtuemern des Drachens, soll "
    "er sich befinden. Hole ihn und ich kann mit den anderen Sachen das "
    "Ritual vollziehen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Blakaldur braucht Deine Sachen nicht.\n" }) );

  AddSpell(5,600, 
    "Ein weisser Blitz schnellt aus der Hand von Blakaldur und trifft Dich.\n",
    "Ein weisser Blitz aus der Hand von Blakaldur trifft @WEN mitten am "
    "Oberkoerper.\n",
    ({DT_LIGHTNING}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(1,1500, 
    "Ein Feuerball schnellt aus der Hand von Blakaldur und trifft Dich.\n",
    "Ein Feuerball aus der Hand von Blakaldur trifft @WEN .\n",
    ({DT_FIRE}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(3,800, 
    "Blakaldur trifft Dich mit einem hervorgezauberten Riesenhammer.\n",
    "Blakaldur beschwoert einen Riesenhammer, der @WEN mit aller Wucht trifft.\n",
    ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2, 1, DS_PARALYZE,
    "Blakaldur spricht boese Formeln und Du kannst Dich nicht mehr bewegen!\n",
    "Blakaldur paralysiert @WEN!\n" );

  AddDefaultSpell(2, 1, DS_ANTIMAGIC,
    "Blakaldur verhindert Deine Zauber!\n",
    "Blakaldur verhindert, dass @WER Magie anwenden kann!\n" );

  AddDefaultSpell(3, 100, DS_DISARM);    

  SetChats(2, ({
          "Blakaldur spricht ein paar Beschwoerungen.\n",
          "Blakaldur murmelt unverstaendliche Worte.\n"}) );
  SetAttackChats(10, ({
    "Blakaldur schuetzt sich mit einem magischen Schild.\n",
    "Blakaldur weicht gekonnt aus.\n"}) );

 SUID;
  CLONEME( ARMOUR "mithrilkettenhemd2" );
  CLONEME( "/p/armour/trousers/lederhose" );
  CLONEME( "/p/armour/helm/zauberhut" );
  CLONEME( "/p/armour/cloak/seidenumhang" );
  command("trage alles");

  AddCmd( ({"gib","gebe" }), "geben" );

 }

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;
  
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "haelt Dich fuer ein unwichtiges Wesen, darum reagiert er nicht.",
        "findet Dich uninteressant.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "verflucht Dich.",
        "bewegt seine Haende und entzuendet ein Feuer unter Deinem Hintern.");
        TP->AddHp(-10);
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "haelt Dich einfach nur fuer laestig.",
        "beachtet Dich nicht.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "entzuendet magisch ein kleines Feuer unter Deinen Fuessen.",
        "tritt Dich.");
        TP->AddHp(-10);
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "findet das ekelig.",
        "will Dich nicht mehr sehen.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "verhext Dich sofort.",
        "findet das ekelig.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "findet das ekelig.",
        "will Dich nicht mehr sehen.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "lacht Dich aus.",
        TP->Name(WER)+" wird von Istar ausgelacht.");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
void daemon()
{
 object daemon;
 tell_room(ENV(TO), "Blakaldur beschwoert einen Doppelgaemger, der ihn im Kampf unterstuetzt und Dich verwirrt.\n");
daemon=clone_object ( NPC "doppelg" );
 daemon->move(ENV(TO), M_GO|M_NOCHECK);
}

void Attack(object enemy)
{
   ::Attack(enemy);
   if (!random(7))
    daemon();
}
int geben(string str)
{
   object axt;
   notify_fail("Was moechtest Du wem geben?\n");
   if ( member( ({ "dolch an blakaldur", "blakaldur dolch","mithrildolch an blakaldur","blakaldur mithrildolch","zauberer silberdolch","zauberer dolch","dolch an zauberer","silberdolch an zauberer" }),str) != -1) 
{
     if(!present("dragoninvis1",TP))
     {
        write(BS("Blakaldur sagt: Du brauchst meine Hilfe ja noch "
		 "gar nicht. Du solltest erst die Quest bei "
		 "Anezram starten und wenn die Zeit reif ist, dann "
		 "helfe ich Dir auch.\n"));
        return -1;
     }
     if(!present("CHIVASDOLCH",TP))
     {
        write(BS("Blakaldur sagt: Aber Du hast doch gar keinen "
		 "besonderen Dolch, den Du mir geben kannst.\n"));
        return -1;
     }
     if(!present("CHIVASAXTBLATT2",TP))
     {
        write(BS("Blakaldur sagt: Du hast ja noch nicht einmal das "
		 "verzierte Axtblatt, welches ich benoetige um Deine "
		 "magische Axt zu erschaffen. Los lauf zum Schmied "
		 "und besorge Dir eines.\n"));
        return -1;
     }
     if( !present("CHIVASAXTSCHAFT",TP))
     {
        write(BS("Blakaldur sagt: Dir fehlt noch der Axtschaft. Lauf "
		 "zum Tischler in Roch Adan und besorge Dir einen.\n"));
        return -1;
     }
     if( !present("CHIVASSTAUB",TP))
     {
        write(BS("Blakaldur sagt: Ich benoetige ein wenig Sternenstaub "
		 "fuer das Ritual und Du hast leider kein Sternenstaub "
		 "dabei. Vielleicht kann Dir wer in Roch Adan helfen, "
		 "der sich mit Sternen auskennt.\n"));
        return -1;
     }
     else
      {
      {axt = clone_object( "/d/kristallwald/chivas/dragonquest/weapon/dqaxt");
  present("CHIVASAXTSCHAFT",TP)->remove();
  present("CHIVASAXTBLATT2",TP)->remove();
  present("CHIVASSTAUB",TP)->remove();
  present("CHIVASDOLCH",TP)->remove();
  if ( ME_TOO_HEAVY == axt->move(TP,M_GET|M_SILENT) )
     {
     write("Die magische Axt wuerde Dir zu schwer werden.\n" );
     axt -> remove();
     return 1;
     }
     else
     {
     write(BS("Du gibt Blakaldur den Mithrildolch, das verzierte Axtblatt, "
	      "den Axtschaft mit den Runen und den Sternenstaub und "
	      "Blakaldur beginnt mit seinem Ritual.\n"));
     TP->SetProp(P_PARALYZED, ([
                PARALYZE_TIME: 5,
                PARALYZE_MSG: "Du bist von dem Ritual so fasziniert, dass "
		              "Du wie angewurzelt dastehst.\n",
                PARALYZE_END: "Als Blakaldur fertig ist, gibt er Dir den "
		              "magischen Drachentoeter um den Drachen nun "
			      "toeten zu koennen.\n"]) );	
      call_out("fall1",8);
      return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}
void fall1()
{
  write(BS( "Blakaldur nimmt den Mithrildolch in die Hand und er faengt sofort "
	    "an blaeulich zu gluehen. Er streicht Formeln murmelnd mit dem "
	    "Dolch ueber den Axtschaft und das Axtblatt, die sogleich "
	    "zu einer Einheit verschmelzen.\n"));
  call_out("fall2",8);
}
void fall2()
{
  write(BS( "Die sich soeben zusammen gefuegte Axt schimmert blaeulich und "
	    "kleine Blitze zischen von ihr weg. Das Gemurmel von Blakaldur "
	    "wird lauter und er nimmt den Beutel mit Sternenstaub.\n"));
  call_out("fall3",8);
}
void fall3()
{
  write(BS( "Der Sternenstaub rieselt aus dem Beutel auf das Axtblatt. Als "
	    "der Sternenstaub das Axtblatt beruehrt, beginnt dieses "
	    "magisch gruenlich zu schimmern. Blakaldur murmelt leiser ein "
	    "paar letzte Formeln und laechelt Dich an.\n"));
}
