
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein grimmiger Zwergenkrieger");
  SetProp(P_LONG, BS(
    "Der grimmig guckende Zwergenkrieger hat ein vernarbtes Gesicht und eine "
    "gedrungene muskuloese Gestalt mit sehr breiten Schultern. Er sieht "
    "kampferprobt aus und mit ihm sollte man besser nicht seine Spaesschen "
    "treiben."));
  SetProp(P_NAME, "Zwergenkrieger");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
  AddId(({"zwergenkrieger","krieger","zwerg","\nzwergenkrieger","zwache"})); 

  create_default_npc(25);
  SetProp(P_HANDS, ({" mit seinen Haenden",25,DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 120);
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,3);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.3, DT_COLD:      0.0,  DT_WATER:  0.3, DT_AIR:    0.0, 
      DT_LIGHTNING: -0.2,  DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  -0.2,
      DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.3, DT_TERROR: 0.0,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.5,  DT_MAGIC:  0.0, DT_MIND:   0.0]));
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt in die Ratshalle");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " faellt tot um.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Zwergenkrieger");
  SetProp(P_KILL_MSG, "Wage es nicht, die Zwerge heraus zu fordern!");

 AddInfo(DEFAULT_INFO, "schaut Dich genervt an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das will der Zwergenkrieger nicht haben.\n" }) );

  SetChats(3, ({
          "Der Zwergenkrieger vertreibt einige herumlungernde Zwerge.\n",
          "Der Zwergenkrieger beobachtet Dich misstrauisch.\n",
          "Der Zwergenkrieger bewacht die Ratshalle.\n"}) );

  SetAttackChats(10, ({
    "Der Zwergenkrieger stoesst Dich um.\n",
    "Der Zwergenkrieger schlaegt wie ein Berserker auf Dich ein.\n"}) );
  SUID;
  CLONEME( "/p/armour/boots/eisenstiefel" );
  CLONEME( "/p/armour/helm/eisenhelm" );
  CLONEME( ARMOUR "kettenpanzera" );
  CLONEME( "/p/armour/gloves/kettenhandschuhe" );
  CLONEME( "/p/weapon/axe/obsidianaxt" );
  command("trage alles");
  command("zuecke axt");

ZWERGENMASTER -> add_wache();
  
}

void init()
{
  ::init();

 if ( ZWERGENMASTER -> IsWachefeind(TP) ) Kill(TP);

}

//masterbeginn

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  ZWERGENMASTER -> ruf_um_hilfe(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

void Attack(object enemy)
{
  int i;
  object ob;
  string raum;
  string *raum2;
  mapping exits;
  string *ausgaenge;

  exits = environment()->QueryProp(P_EXITS);
  ausgaenge = m_indices(exits);
  for ( i = sizeof(ausgaenge)-1; i>=0; i-- )
  {
    if ( !objectp(enemy) ) return;
    raum2 = explode(exits[ausgaenge[i]], "#" );
    raum = raum2[sizeof(raum2)-1];
    for ( ob=first_inventory(raum); ob; ob=next_inventory(ob) )
      if ( living(ob) && !query_once_interactive(ob) &&
           ob->id("\nzwergenkrieger","garbox") )
      {
	raum = file_name(ENV(TP));
	ob -> move(raum ,M_TPORT, 0,
          "hoert ein Heulen aus der Ferne und laeuft davon",
	  "kommt rasch herein gelaufen" );
        if ( enemy )
          ob -> Kill(enemy);
        return ::Attack(enemy);
      }
  }
  if (!objectp(enemy)) return;
  for ( ob=first_inventory(environment()); ob; ob=next_inventory(ob) )
    if ( living(ob) && !query_once_interactive(ob) &&
         ob->id("\nzwergenkrieger","garbox") )
      ob -> Kill(enemy);
  return ::Attack(enemy);
}

int remove(int arg)
{
  ZWERGENMASTER -> remove_wache(TO);
  return ::remove(arg);

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if ( killer == TO ) ZWERGENMASTER -> Sieg(player);
}

