
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Zwergenwache");
  SetProp(P_LONG, BS(
    "Die Zwergenwache geht ein wenig lustlos ihrer Arbeit nach. Sie ist "
    "muskuloes und sie wirkt kampferprobt. Der lange Bart der Zwergenwache "
    "beruehrt fast den Boden und schimmert silbrig."));
  SetProp(P_NAME, "Zwergenwache");
  SetProp(P_GENDER, FEMALE);
  AddId(({"zwergenwache","wache","zwerg","\nzwergenwache","NOWIMPY"}));
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinen Haenden",25,DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 120);
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,3);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.3, DT_COLD:      0.0,  DT_WATER:  0.3, DT_AIR:    0.0, 
      DT_LIGHTNING: -0.2,  DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  -0.2,
      DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.3, DT_TERROR: 0.0,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.5,  DT_MAGIC:  0.0, DT_MIND:   0.0]));
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " faellt tot um.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Eine Zwergewache");
  SetProp(P_KILL_MSG, "Wage es nicht, die Zwerge heraus zu fordern!");

 AddInfo(DEFAULT_INFO, "schaut Dich genervt an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das will die Zwergenwache nicht haben.\n" }) );

  SetChats(3, ({
          "Die Zwergenwache vertreibt einige herumlungernde Zwerge.\n",
          "Die Zwergenwache beobachtet Dich misstrauisch.\n",
          "Die Zwergenwache wacht hier.\n"}) );

  SetAttackChats(10, ({
    "Die Zwergenwache stoesst Dich um.\n",
    "Die Zwergenwache schlaegt wie ein Berserker auf Dich ein.\n"}) );
  SUID;
  CLONEME( "/p/armour/boots/eisenstiefel" );
  CLONEME( "/p/armour/helm/eisenhelm" );
  CLONEME( ARMOUR "kettenpanzera" );
  CLONEME( "/p/armour/gloves/kettenhandschuhe" );
  CLONEME( "/p/weapon/axe/obsidianaxt" );
  command("trage alles");
  command("zuecke axt");

WACHMASTER -> add_wache();
  
}

void init()
{
  ::init();

 if ( WACHMASTER -> IsWachefeind(TP) ) Kill(TP);

}

//masterbeginn

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  WACHMASTER -> ruf_um_hilfe(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

void Attack(object enemy)
{
  int i;
  object ob;
  string raum;
  string *raum2;
  mapping exits;
  string *ausgaenge;

  exits = environment()->QueryProp(P_EXITS);
  ausgaenge = m_indices(exits);
  for ( i = sizeof(ausgaenge)-1; i>=0; i-- )
  {
    if ( !objectp(enemy) ) return;
    raum2 = explode(exits[ausgaenge[i]], "#" );
    raum = raum2[sizeof(raum2)-1];
    for ( ob=first_inventory(raum); ob; ob=next_inventory(ob) )
      if ( living(ob) && !query_once_interactive(ob) &&
           ob->id("\nzwergenwache") )
      {
	raum = file_name(ENV(TP));
	ob -> move(raum, M_TPORT, 0,
          "hoert ein Heulen aus der Ferne und laeuft davon",
	  "kommt rasch herein gelaufen" );
        if ( ob && enemy )      // woody, 20160520: "enemy" -> "ob && enemy"
          ob -> Kill(enemy);
        return ::Attack(enemy);
      }
  }
  if (!objectp(enemy)) return;
  for ( ob=first_inventory(environment()); ob; ob=next_inventory(ob) )
    if ( living(ob) && !query_once_interactive(ob) &&
         ob->id("\nzwergenwache") )
      ob -> Kill(enemy);
  return ::Attack(enemy);
}

int remove(int arg)
{
  WACHMASTER -> remove_wache(TO);
  return ::remove(arg);

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if ( killer == TO ) WACHMASTER -> Sieg(player);
}

