// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Zwergenfeste von Ardhmir");
  SetProp( P_INT_LONG,
	"Du stehst am Rand der grossen Schlucht im oestlichen Teil der "
	"riesigen Halle von Ardhmir. An der Ostwand stehen ein paar "
	"Ruestungen, die von den Zwergen geschmiedet wurden." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"rand"}), 
            "Du stehst am Rand der Schlucht und solltest aufpassen, dass Du "
	    "nicht runter faellst.");

  AddDetail( ({"schlucht"}),
	    "Die Schlucht ist unglaublich tief und sie scheint sogar "
	    "bodenlos.");

  AddDetail( ({"teil","haelften"}),
	    "Du bist im oestlichen Teil der Halle, die durch die Schlucht in "
	    "zwei Haelften geteilt wird.");

  AddDetail( ({"halle"}),
	    "Die grosse Halle wird in zwei Haelften durch die breite Schlucht "
	    "geteilt.");
  
  AddDetail( ({"zwergenfeste","feste","ardhmir"}),
	    "Du bist in der Feste von Ardhmir, in der viele Zwerge leben.");

  AddDetail( ({"ostwand","wand","waende","waenden"}), 
            "An der Ostwand stehen ein paar Ruestungen, die von den Zwergen "
	    "geschmiedet wurden.");

  AddDetail( ({"ruestungen"}),
	    "Die Ruestungen sehen sehr wertvoll aus und wurden sicher hier "
	    "in der Zwergenfeste geschmiedet.");

  AddDetail( ({"zwerge","zwergen"}),
	    "Einige Zwerge sind in der Halle zu sehen. Sie arbeiten oder "
	    "stehen in Gruppen zusammen und unterhalten sich.");

  AddDetail( ({"boden"}),
	    "Am Boden siehst Du die fuer diese Haelfte der Halle typischen "
	    "Granitplatten.");
  
  AddDetail( ({"decke","kopf"}),
	    "Die Decke woelbt sich hoch ueber Deinem Kopf auf die andere "
	    "Seite der Halle.");

  AddDetail( ({"gruppen"}), 
            "Die Zwerge fuehren anscheinend tiefgreifende Diskussionen, "
	    "da sie Dich ueberhaupt nicht beachten.");

  AddDetail( ({"diskussionen"}),
	    "Es handelt sich sicher um Gold oder Edelsteine, die "
	    "Lieblingsthemen der Zwerge.");

  AddDetail( ({"gold","edelsteine","dingen","dinge"}),
	    "Die Zwerge reden gerne ueber Gold und Edelsteine und verarbeiten "
	    "sie auch sehr gerne zu schoenen Dingen.");

  AddDetail( ({"granitplatten","granit","platten"}),
	    "Der Granit ist schwarz und saugt das Licht der Barinsteine "
	    "beinahe auf.");
  
  AddDetail( ({"barinsteine","steine"}),
	    "Leuchtende Barinsteine sind in verschiedener Hoehe an den grossen "
	    "Saeulen der Halle befestigt.");

  AddDetail( ({"hoehe","saeulen"}), 
            "Maechtige Saeulen stuetzen die riesige Decke ueber Dir. An ihnen "
	    "sind lauter leuchtende Steine befestigt, die mit ihrem Licht die "
	    "Halle beleuchten.");

  AddDetail( ({"licht"}),
	    "Das Licht der Barinsteine erhellt die gesamte Halle.");

  AddDetail( ({"hoehle","palast"}),
	    "Die Halle wirkt gar nicht so, als ob man in einer Hoehle ist. Man "
	    "kommt sich eher wie in einem grossen Palast vor.");

  AddDetail( ({"haelfte","seite","teile"}),
	    "Du stehst auf der oestlichen Haelfte von der grossen Halle, die "
	    "durch eine breite Schlucht in zwei Teile getrennt ist.");
  
  AddDetail( ({"lieblingsthemen"}),
	    "Du hast sicher auch Lieblingsthemen ueber die Du Dich gerne "
	    "unterhaelst.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst nur frische Luft.");  
 
  AddSmell( ({"luft"}),
	   "Obwohl Du in einer Hoehle bist, riecht die Luft hier sehr frisch.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Diskussionen der Zwerge.");

  AddSound( ({"diskussionen"}),
	   "Es geht um Edelsteine und Gold. So ist es immer wenn Zwerge "
	   "miteinander diskutieren.");
  
//-----Details Ende-----
AddItem(NPC "zwergg", REFRESH_DESTRUCT);

AddExit("sueden", ROOM "zwfe23");
AddExit("norden", ROOM "zwfe21");

}
