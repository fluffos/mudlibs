// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl;

void create()
	
{
  ::create();

  anzahl=1;

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Weg schlaengelt sich unaufhaltsam durch den Wald. Am Rand des "
        "Weges sind ein paar grosse Findlinge zu sehen, die mit viel Moos "
        "bewachsen sind. Die Baeume stehen sehr dicht und ihr Blaetterdach "
        "laesst kaum Licht auf den Waldboden fallen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1);

//-----Details Anfang-----
  
  AddDetail( ({"weg","weges"}), 
            "Der Weg fuehrt anscheinend unendlich durch diesen dichten Wald. "
	    "Einige Straeucher stehen auch am Rand.");

  AddDetail( ({"wald","weile"}),
	    "Du stehst in einem Wald und zwar schon eine ganze Weile.");

  AddDetail( ({"rand"}),
	    "Am Rand des Weges stehen ein paar Findlinge zwischen den grossen "
            "Baeumen. Auch einige Straeucher sind zu sehen.");

  AddDetail( ({"findlinge"}),
	    "Ein paar grosse Findlinge sind am Rand des Weges zwischen den "
            "Baeumen und Straeuchern zu sehen. Sie sind mit viel Moos "
	    "bewachsen.");

  AddSpecialDetail( ({ "moos" }), "moos" );
  
  AddSpecialDetail( ({ "etwas" }), "etwas" );

  AddSpecialDetail( ({ "zeichnung" }), "zeichnung" );

  AddDetail( ({"baeume","baeumen"}), 
            "Grosse Baeume saeumen den Weg. Sie stehen sehr dicht und bilden "
            "ein dichtes Blaetterdach. Zwischen den Baeumen stehen einige "
	    "Straeucher.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach ist sehr dicht und laesst nur ein wenig Licht "
            "durch.");

  AddDetail( ({"licht"}),
	    "Nur wenig Licht faellt durch die Blaetter auf den Waldboden.");

  AddDetail( ({"boden","waldboden"}),
	    "Am Boden liegen ein paar herunter gefallene Aeste und ein wenig "
            "Laub.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist durch die Blaetter der Baeume nicht zu sehen.");

  AddDetail( ({"straeucher","straeuchern"}),
	    "Die Straeucher stehen sehr dicht zwischen den Baeumen und "
	    "Findlingen. Zwischen den Zweigen der Straeucher erkennst Du "
	    "einen kleinen Pfad der nach Westen fuehrt.");

  AddDetail( ({"zweigen","zweige"}),
	    "Zwischen den Zweigen ist ein kleiner Pfad zu sehen, der nach "
	    "Westen fuehrt.");

  AddDetail( ({"pfad","westen"}),
	    "Der kleine Pfad, den Du zwischen den Zweigen siehst, fuehrt "
	    "nach Westen. Vielleicht kannst Du Dich durch die Straeucher "
	    "zwaengen und auf den Pfad gelangen.");

  AddDetail( ({"blaetter"}), 
            "Die Blaetter der Baeume bilden ein dichtes Dach, durch das nur "
            "wenig Licht auf den Waldboden trifft.");

  AddDetail( ({"aeste"}),
	    "Ein paar kleine Aeste liegen zwischen dem Laub am Boden.");

  AddDetail( ({"laub"}),
	    "Ein wenig Laub liegt am Boden und raschelt, wenn man den Weg "
            "entlang geht.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst den Wald.");  
 
  AddSmell( ({"wald"}),
	   "Es riecht nach Baeumen.");

  AddSmell( ({"baeume"}),
	   "Sie riechen wie es in einem Wald ueblich ist.");
  
  
  AddSound(DEFAULT_SOUND, "Du hoerst ein Rascheln.");

  AddSound( ({"rascheln","laub"}),
	   "Das Rascheln erzeugst Du selbst, wenn Du ueber das Laub gehst.");
  
//-----Details Ende-----
  
AddExit("nordosten", ROOM "zww11");
AddExit("sueden", ROOM "zww9");

AddCmd( ({"kratz", "kratze" }), "kratzen" );
AddCmd( ({"zwaeng", "zwaenge" }), "zwaengen" );

}
void reset()
	
{
  ::reset();
  anzahl=1; 
}
int kratzen(string str)
{
   notify_fail("Was willst Du abkratzen ?\n");
   if ( member( ({ "moos ab","moos von findling ab","moos von findlingen ab" }),str) != -1) 
   {    
   if ( anzahl )
    {
    write( "Du kratzt das Moos von einem Findling ab und findest eine "
           "Zeichnung in den Stein geritzt.\n");
    say( TPN+" entdeckt etwas.\n");
    anzahl--;
    return 1;   
    }
    else
    {
    write( "Du entdeckst, dass das Moos schon entfernt wurde und siehst eine "
           "Zeichnung in den Stein geritzt.\n");
    say( TPN+" probiert etwas, dass gar nicht funktionieren kann.\n");
    return 1;   
    }
  }
}
string moos(string key)
{
    if ( anzahl )
    {
    return(BS("Das Moos ist schoen gruen und scheint Etwas zu verbergen. Du "
              "kannst das Moos ja mal abkratzen.\n"));
    }
    else
    {
    return(BS("Das Moos wurde bereits von den Findlingen abgekratzt.\n"));
    }
}
string etwas(string key)
{
    if ( anzahl )
    {
    return(BS("Um das Etwas zu sehen, musst Du schon ein bisschen mehr tun.\n"));
    }
    else
    {
    return(BS("Es ist eine Zeichnung unter dem Moos versteckt.\n"));
    }
}
string zeichnung(string key)
{
    if ( anzahl )
    {
    return(BS("Du siehst keine Zeichnung auf den Findlingen.\n"));
    }
    else
    {
    return("Die Zeichnung wurde in den Stein geritzt und sieht sehr \n"
              "huebsch aus.\n"
              "                                             \n"
              "  $$$$$$$$$                                    $$$$$$$$$$\n"
              " $$$$$$$$$$$$$$                            $$$$$$$$$$$$$$$\n"
              " $$$$$$$$$$$$$$$$$                      $$$$$$$$$$$$$$$$$$\n"
              "$$$$$$$$$$$$$$$$$$$$$  !!          !! $$$$$$$$$$$$$$$$$$$$\n"
              "$$$$$$$$$$$$$$$$$$$$$$$  !!      !! $$$$$$$$$$$$$$$$$$$$$$\n"
              " $$$$$$$$$$$$$$$$$$$$$$$$ !!   !! $$$$$$$$$$$$$$$$$$$$$$$\n"
              "  $$$$$$$$$$$$$$$$$$$$$$$$  !!!  $$$$$$$$$$$$$$$$$$$$$$$$\n"
              "    $$$$$$$$$$$$$$$$$$$$$$$ ## $$$$$$$$$$$$$$$$$$$$$$$$\n"
              "     $$$$$$$$$$$$$$$$$$$$$$####$$$$$$$$$$$$$$$$$$$$$$$\n"
              "       $*******************####********************$\n"
              "    $$$$$$$$$$$$$$$$$$$$$$$####$$$$$$$$$$$$$$$$$$$$$$$\n"
              "   $$$$$$$$$$$$$$$$$$$$$$$$ ## $$$$$$$$$$$$$$$$$$$$$$$$\n"
              "   $$$$$$$$$$$$$$$$$$$$$$$$ ## $$$$$$$$$$$$$$$$$$$$$$$$\n"
              "   $$$$$$$$$$$$$$$$$$$$$$$  ##  $$$$$$$$$$$$$$$$$$$$$$$\n"
              "    $$$$$$$$$$$$$$$$$$$$$   ##   $$$$$$$$$$$$$$$$$$$$$\n"
              "     $$$$$$$$$$$$$$$$$$      #     $$$$$$$$$$$$$$$$$$\n"
              "        $$$$$$$$$$$$$                $$$$$$$$$$$$$\n");
    }
}
int zwaengen(string str)
{
   notify_fail("Wo moechtest Du Dich durchzwaengen?\n");
   if ( member( ({ "durch straeucher","durch strauch","durch zweige" }),str) != -1) 
  {
    write(BS ( "Du zwaengst Dich durch die Zweige der Straeucher und erreichst "
	       "einen kleinen Pfad, der nach Westen fuehrt.\n"));
      TP->move( "/d/kristallwald/chivas/dragonquest/room/bdragonq1", M_GO, 
      "ploetzlich zwischen den Straeuchern", "verschwindet", 
      "zwaengt sich durch die Straeucher herein");
    return 1;
  }
}
