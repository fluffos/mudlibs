// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Waldlichtung");
  SetProp( P_INT_LONG,
	"Der See liegt ruhig in der Mitte der Lichtung. Es wirkt alles ruhig "
        "und friedlich. Im Norden schlaengelt sich ein kleiner Fluss in den "
        "Wald und verschwindet zwischen den Baeumen. Man kann den Fluss ohne "
        "Probleme durchqueren, da er nicht sehr tief ist." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1);

//-----Details Anfang-----
  
  AddDetail( ({"see","mitte","sees"}), 
            "Der See liegt ruhig in der Mitte der Lichtung. Einige kleine "
            "Wellen sind auf ihm zu sehen.");

  AddDetail( ({"lichtung"}),
	    "Die Lichtung ist gross und wird von den grossen Baeumen des "
            "Waldes umringt.");

  AddDetail( ({"norden","fluss"}),
	    "Im Norden fliesst ein flacher Fluss aus dem See und verschwindet "
            "zwischen den Baeumen des Waldes. Du kannst ohne Probleme durch "
            "ihn hindurch waten.");

  AddDetail( ({"wald","waldes"}),
	    "Der Wald rahmt die grosse Lichtung ein. Waere der Wald nicht da, "
            "gaebe es natuerlich auch keine Lichtung.");
  
  AddDetail( ({"baeumen","baeume","rand"}),
	    "Die Baeume am Rand der Lichtung wachsen sehr hoch in den Himmel. "
            "Ausserdem stehen sie sehr dicht, so dass es keine Moeglichkeit "
            "gibt einfach so die Lichtung zu verlassen.");

  AddDetail( ({"probleme"}), 
            "Momentan hast Du keine Probleme.");

  AddDetail( ({"boden"}),
	    "Am Boden siehst Du Gras und Blumen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist herrlich blau.");

  AddDetail( ({"wellen"}),
	    "Die Wellen schwappen langsam ans Ufer.");
  
  AddDetail( ({"ufer"}),
	    "Das Gras der Wiese geht direkt in den See ueber. Ausserdem "
            "stehen ein paar Schilfrohre im flachen Wasser.");

  AddDetail( ({"wasser"}), 
            "Das Wasser ist ganz klar und Du kannst den ufernahen Grund des "
            "Sees erkennen.");

  AddDetail( ({"gras"}),
	    "Das Gras waechst auf der gesamten Wiese und ist saftig gruen.");

  AddDetail( ({"wiese"}),
	    "Auf der Wiese, auf der Du stehst, waechst viel Gras und auch "
            "einige Blumen.");

  AddDetail( ({"schilf","schilfrohre","rohre"}),
	    "Die Schilfrohre wachsen gerade in den Himmel und das Schilf "
            "waechst hier im See sehr gut.");
  
  AddDetail( ({"blumen"}),
	    "Hier wachsen verschiedene Arten von Blumen.");

  AddDetail( ({"art","arten"}), 
            "Du siehst ein paar Gaensebluemchen, ein wenig Loewenzahn und "
            "ein paar Veilchen.");

  AddDetail( ({"gaensebluemchen"}),
	    "Die Gaensebluemchen wachsen auf der ganzen Wiese und laecheln "
            "Dir zu.");

  AddDetail( ({"loewenzahn","gelb","bluete","richtung"}),
	    "Der Loewenzahn hat seine Bluete in Richtung Sonne gereckt und "
            "blueht in einem herrlichen Gelb.");

  AddDetail( ({"sonne"}),
	    "Die Sonne steht beinahe senkrecht am Himmel.");
  
  AddDetail( ({"veilchen","farbe"}),
	    "Die zierlichen Veilchen haben eine wunderschoene blaue Farbe.");

  AddDetail( ({"grund"}), 
            "Am ufernahen Grund des Sees erkennst Du einige Steine und viel "
            "Schlamm.");

  AddDetail( ({"moeglichkeit","moeglichkeiten"}),
	    "Die einzigen Moeglichkeiten, die Du hast, sind nach Norden durch "
            "den Fluss weiter zu gehen oder nach Suedosten zum Weg, der sich "
            "oestlich vom See entlang schlaengelt.");

  AddDetail( ({"steine"}),
	    "Kleine Steine liegen im Wasser. Sie sind nicht besonders "
            "interessant.");

  AddDetail( ({"schlamm"}),
	    "Der Schlamm sieht sehr weich aus. Wenn man hier in den See "
            "steigen wuerde, waere die Gefahr da, dass man im Schlamm "
            "versinkt.");
  
  AddDetail( ({"suedosten","weg"}),
	    "Im Suedosten siehst Du den Weg, der sich oestlich am See vorbei "
            "fuehrt.");

  AddDetail( ({"gefahr"}), 
            "Dieser Gefahr willst Du Dich nicht aussetzen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen","duft"}),
	   "Die Blumen der Wiese verstroehmen einen suesslichen Duft.");

  AddSound(DEFAULT_SOUND, "Es ist herrlich ruhig. Man kann hier in aller "
                          "Ruhe entspannen.");

  AddSound( ({"ruhe"}),
	   "______________________________________");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "zww15");
AddExit("suedosten", ROOM "zww5");

}
