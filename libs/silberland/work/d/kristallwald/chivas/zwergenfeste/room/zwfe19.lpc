// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Zwergenfeste von Ardhmir");
  SetProp( P_INT_LONG,
        "Du bist im nordoestlichen Teil der riesigen Halle. Im Norden scheint "
        "ein Tempel der Zwerge zu sein, aus dem metallisch klingende Musik "
        "schallt. Nach Suedwesten gibt es die Moeglichkeit die breite Schlucht "
        "die die Halle trennt ueber eine Bruecke zu ueberqueren. Auf dieser "
        "Seite kann man die Halle nach Sueden hin durchqueren.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"teil","teile"}), 
            "Dieser nordoestliche Teil der groessten Halle von Ardhmir wirkt "
	    "sehr ruhig und bedaechtig. Es liegt sicher an dem Tempel, der "
	    "sich noerdlich von Dir befindet.");

  AddDetail( ({"halle"}),
            "Die Halle erstreckt sich auf beiden Seiten der Schlucht nach "
	    "Sueden. Nach Suedwesten kann man den Abgrund ueber eine Bruecke "
	    "ueberqueren oder auf dieser Seite einfach nach Sueden gehen.");

  AddDetail( ({"norden","tempel"}),
            "Im Norden befindet sich ein Heiligtum der Zwerge. Es wurde ein "
	    "Tempel in den Stein gehauen. Geh einfach mal hin und schau Dich "
	    "um und erfahre ein wenig mehr ueber die Goetter und Kultur der "
	    "Zwerge die in der Zwergenfeste von Ardhmir leben.");

  AddDetail( ({"zwerge"}),
	    "Viele hundert Zwerge wohnen und arbeiten im Zwergenreich von "
	    "Ardhmir.");
  
  AddDetail( ({"musik"}),
	    "Die Musik kannst Du nur hoeren und nicht untersuchen.");

  AddDetail( ({"moeglichkeit"}), 
            "Du hast die Moeglichkeit ueber die grosse Steinbruecke den "
	    "Abgrund zwischen den beiden Teilen der Halle zu ueberqueren.");

  AddDetail( ({"schlucht","abgrund"}),
            "Die Schlucht, die die grosse Halle in zwei Teile trennt, zieht "
	    "sich vom suedlichen Ende der Halle bis zum noerdlichen Ende und "
	    "verschwindet darauf unter der noerdlichen Wand. Sie scheint "
	    "beinahe bodenlos zu sein und wenn Du hinunter guckst, wird Dir "
	    "richtig schwindelig.");

  AddDetail( ({"bruecke","suedwesten","steinbruecke","richtung"}),
            "Eine grosse Steinbruecke ueberspannt die breite Schlucht in "
	    "Richtung Suedwesten. Am Fuss der Bruecke stehen zwei grosse "
	    "Statuen.");

  AddDetail( ({"sueden"}),
            "Du kannst diese Seite der Halle nach Sueden hin durchschreiten. "
	    "Um auf der anderen Seite nach Sueden zu gehen, musst Du zuerst "
	    "ueber die Bruecke gehen und die Schlucht ueberqueren.");
  
  AddDetail( ({"boden"}),
            "Der Boden ist hier mit schwarzem Granit gepflastert, der "
	    "keinerlei Reflektion von Licht zulaesst.");

  AddDetail( ({"decke"}), 
            "Die Decke befindet sich weit ueber Dir und Du kannst sie kaum "
	    "erkennen. Ein paar grosse Zacken sind ganz leicht zu sehen.");

  AddDetail( ({"waende","waenden"}),
            "An den Waenden sind viele Ornamente zu sehen, die die hohe Kunst "
	    "der Zwerge unter Beweis stellen.");

  AddDetail( ({"ardhmir","zwergenfeste","feste","zwergenreich","reich"}),
            "Du bist schon tief in das Zwergenreich von Ardhmir vorgedrungen "
	    "und hast sicher schon viel kennen gelernt.");

  AddDetail( ({"seiten","seite"}),
            "Die riesige Halle ist in zwei Teile durch eine tiefe Schlucht "
            "getrennt. Du befindest Dich momentan im nordoestlichen Teil der "
	    "Halle.");
  
  AddDetail( ({"heiligtum","heiligtuemer"}),
            "Alle Rassen im Silberland haben ihre Heiligtuemer. Eines der "
	    "Zwerge befindet sich noerdlich von Dir.");

  AddDetail( ({"goetter"}), 
            "Du kannst mehr ueber die Goetter der Zwerge im Tempel erfahren. "
	    "Geh einfach mal hin und informier Dich.");

  AddDetail( ({"kultur"}),
            "Die Kultur der Zwerge ist einzigartig und komplex. Sicher kannst "
	    "Du einiges ueber sie im Tempel noerdlich von Dir erfahren.");

  AddDetail( ({"stein","hoehle"}),
            "Die ganze Zwergenfeste besteht aus Stein. Du befindest Dich ja "
            "eigentlich auch in einer Hoehle, obwohl es hier nicht so "
	    "aussieht.");

  AddDetail( ({"ende","blick"}),
            "Die Schlucht verschwindet unter der noerdlichen Wand und entzieht "
	    "sich Deinem Blick. Du fragst Dich wo sie wohl hinfuehrt.");
  
  AddDetail( ({"wand","ungewisse"}),
            "In der noerdlichen Wand befindet sich der Eingang zum Tempel. "
	    "Gleich neben dem Tempel verschwindet der Abgrund unter der Wand "
	    "und fuehrt ins Ungewisse.");

  AddDetail( ({"statuen","fuss","steinstatuen","steinstatue","statue"}), 
            "Am Fuss der Bruecke stehen zwei grosse Steinstatuen, die jeweils "
	    "einen Schmied mit Amboss und Hammer und einen Steinmetz "
	    "darstellen.");

  AddDetail( ({"licht"}),
            "Das Licht stammt von leuchtenden Barinsteinen, die an den grossen "
            "Saeulen der Halle befestigt sind.");

  AddDetail( ({"zacken"}),
            "Die Zacken, die Du an der Decke sehen kannst, sind riesige "
            "Stalagtiten, die langsam nach unten wachsen.");

  AddDetail( ({"ornamente","linien"}),
	    "An den Waenden siehst Du geschwungene Ornamente und Linien. Es "
	    "sieht wunderschoen aus und die Ornamente und Linien scheinen "
	    "sich sogar zu bewegen. Ein Wunder ist geschehen.");
  
  AddDetail( ({"kunst","handwerkskunst"}),
	    "Die hohe Kunst beim Umgang mit Gesteinen oder Metall wurde ueber "
	    "tausende von Jahren verfeinert und von Generation zu Generation "
	    "weiter gegeben.");

  AddDetail( ({"rassen","gute","boese","grosse","kleine"}), 
            "Es gibt sehr viele verschiedene Rassen im Silberland. Es gibt "
	    "Gute und Boese, Grosse und Kleine.");

  AddDetail( ({"schmied","amboss","hammer"}),
	    "Die Steinstatue, die den Schmied darstellt, steht vor einem "
	    "Amboss und hat einen riesigen Hammer in der Hand. Er schaut "
	    "sehr streng. Du brauchst Dir aber keine Gedanken zu machen.");

  AddDetail( ({"steinmetz","meissel"}),
	    "Die Steinstatue, die den Steinmetz darstellt, hat einen grossen "
	    "Meissel in der Hand und schaut ein wenig grimmig. Du bist aber "
	    "sicher nicht der Grund, wieso er so grimmig schaut. Anscheinend "
	    "hatte der Kuenstler der Statuen nur keine Lust und war aus diesem "
	    "Grund vielleicht selbst ein wenig grimmig gelaunt.");

  AddDetail( ({"saeulen"}),
	    "Maechtige Saeulen, die so dick sind wie die Baumriesen in Roch "
	    "Adan, tragen die Decke der Halle. An ihnen sind Barinsteine "
	    "in Fassungen befestigt, die alles in ein gelbliches Licht "
	    "tauchen, so dass Du gut sehen kannst.");
  
  AddDetail( ({"barinsteinen","barinsteine","hoehe"}),
	    "Die Barinsteine sind in verschiedener Hoehe an den grossen "
	    "Saeulen angebracht und erhellen die gesamte Halle.");

  AddDetail( ({"stalagtiten"}),
	    "Die Stalagtiten wachsen in tausenden von Jahren langsam von der "
	    "Decke zum Boden.");

  AddDetail( ({"jahren","jahre","zeit"}),
	    "Das ist eine sehr lange Zeit.");

  AddDetail( ({"fassungen"}),
	    "Die Fassungen an den Saeulen halten die Barinsteine. Sie "
	    "scheinen aus purem Gold zu bestehen.");
  
  AddDetail( ({"gold"}),
	    "Es ist sicher Gold. Es funkelt sehr begehrenswert.");

  AddDetail( ({"baumriesen","roch","adan","roch adan","baeume"}),
	    "Die Baumriesen von Roch Adan sind die groessten Baeume im "
	    "Silberland.");

  AddDetail( ({"silberland"}),
	    "Du befindest Dich tief im Silberland.");

  AddDetail( ({"wunder"}),
	    "Eigentlich ist es kein Wunder, sondern nur eine optische "
	    "Taeuschung, die naive Charakter verwirren kann.");
  
  AddDetail( ({"taeuschung","gesteinen"}),
	    "Die optische Taeuschung beweist wieder einmal die hohe Kunst "
	    "der Zwerge beim Umgang mit Gesteinen.");

  AddDetail( ({"charakter"}),
	    "Zeige auf Dich selbst und Du weisst wer damit gemeint ist.");

  AddDetail( ({"generation","generationen"}),
	    "Die Zwerge leben hier in der Zwergenfeste von Ardhmir schon seit "
	    "Generationen und haben ihre Handwerkskunst immer weiter "
	    "verfeinert.");

  AddDetail( ({"grund"}),
	    "Man hat immer einen Grund.");
  
  AddDetail( ({"gedanken"}),
	    "Du solltest Dir auch oefter mal Gedanken machen.");

  AddDetail( ({"lust","spass"}),
	    "Du hast richtig viel Lust und Spass am Forschen.");

  AddDetail( ({"kuenstler"}),
	    "Der Kuenstler der Statuen war vielleicht nicht gut gelaunt, aber "
	    "er hat sein Handwerk verstanden. Die Statuen sind sehr "
	    "detailreich.");

  AddDetail( ({"hand"}),
	    "Die eine Statue hat einen Hammer in der Hand und die andere "
	    "Statue einen Meissel.");
  
  AddDetail( ({"forschen","forscherpunkt"}),
	    "Dies gab vielleicht einen Forscherpunkt.");

  AddDetail( ({"eingang"}),
	    "Im Norden ist der Eingang zu einem Tempel.");

  AddDetail( ({"beweise","beweis"}),
	    "Es gibt in dem Zwergenreich von Ardhmir viele Beweise fuer die "
	    "Kunst der Zwerge.");

  AddDetail( ({"metall","umgang"}),
	    "Der Umgang mit Metall wird den Zwergen schon in die Wiege "
	    "gelegt.");
  
  AddDetail( ({"wiege"}),
	    "Das ist mehr als Sprichwort gemeint.");

  AddDetail( ({"sprichwort"}),
	    "Du erforscht wirklich alles.");

  AddDetail( ({"granit"}),
	    "Der Granit ist pechschwarz und muss von weither hier her "
	    "gebracht worden sein, da es in dieser Gegend keinen Granit gibt.");

  AddDetail( ({"reflektion"}),
	    "Der schwarze Granit scheint das Licht gerade zu verschlucken.");
  
  AddDetail( ({"handwerk"}),
	    "Die Zwerge beherrschen ihr Handwerk.");

  AddDetail( ({"gegend"}),
	    "Der Granit stammt sicher aus dem Gebirge.");

  AddDetail( ({"gebirge"}),
	    "Das Gebirge ist weit weg und beheimatet die Hauptstadt der "
	    "Zwerge.");

  AddDetail( ({"hauptstadt","felonia"}),
	    "Die Hauptstadt der Zwerge ist Felonia.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Ein suesslicher Geruch ist zu vernehmen.");  
 
  AddSmell( ({"geruch"}),
	   "Der suessliche Geruch scheint aus dem Tempel zu kommen.");

  AddSound(DEFAULT_SOUND, "Du hoerst eine metallische Musik und ein paar "
		          "Zwerge.");

  AddSound( ({"zwerge"}),
	   "Die Zwerge gehen etwas lauter ihren Taetigkeiten in der Halle "
	   "nach.");
  
  AddSound( ({"taetigkeiten","zwerge","personen"}),
	   "Man belauscht keine anderen Personen. Schaeme Dich!");

  AddSound( ({"musik"}),
	   "Die Musik scheint aus dem Tempel zu kommen.");

//-----Details Ende-----
  
AddExit("sueden", ROOM "zwfe20");
AddExit("norden", ROOM "zwfea");
AddExit("suedwesten", ROOM "zwfe18");

}
