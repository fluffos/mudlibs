// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Zwergenfeste von Ardhmir");
  SetProp( P_INT_LONG,
	"Du stehst am Ende der laenglichen ersten Halle von Ardhmir. Von hier "
	"aus zieht sich die Halle in noerdliche Richtung. Nach Suedwesten kann "
	"man eine der vielen Raeume von Ardhmir betreten. Ein suesslicher Duft "
	"stroemt durch die Oeffnung in die Halle." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"ende","halle"}), 
            "Dies ist das Ende der laenglichen ersten Halle von Ardhmir. Du "
	    "kannst nur noch durch eine Oeffnung im Suedwesten weiter gehen "
	    "oder nach Norden die Halle durchschreiten.");

  AddDetail( ({"ardhmir","zwergenfeste"}),
	    "Es gibt sehr viele Zwerge in den Hallen von Ardhmir.");

  AddDetail( ({"richtung","norden"}),
	    "Nach Norden streckt sich die erste Halle von Ardhmir.");

  AddDetail( ({"suedwesten","raum","kammer"}),
	    "Im Suedwesten scheint sich ein Baecker niedergelassen zu "
	    "haben.");
  
  AddDetail( ({"raeume"}),
	    "Es gibt viele verschiedene Raeume in der Zwergenfeste. "
	    "Suedwestlich scheint ein Baecker sein Geschaeft zu haben.");

  AddDetail( ({"duft"}), 
            "Den Duft kannst Du nicht untersuchen, nur riechen.");

  AddDetail( ({"oeffnung"}),
	    "Die Oeffnung nach Suedwesten fuehrt in den Baeckerladen.");

  AddDetail( ({"boden"}),
	    "Der Boden ist eben und man kann sehr gut auf ihm gehen.");

  AddDetail( ({"waende","waenden","wand"}),
	    "An den Waenden haengen die leuchtenden Steine, die Du ueberall "
	    "in Ardhmir schon gesehen hast.");
  
  AddDetail( ({"decke"}),
	    "Die Decke ist weit ueber Dir.");

  AddDetail( ({"zwerge"}), 
            "Es gibt viele Zwerge in der Zwergenfeste. Einige gehen in dieser "
	    "Halle ihren Beschaeftigungen nach.");

  AddDetail( ({"hallen"}),
	    "Es gibt viele grosse Hallen in Ardhmir.");

  AddDetail( ({"baecker","geschaeft","laden","baeckers","backerladen"}),
	    "Geh doch einfach mal hin und schau nach, was er Dir anbieten "
	    "kann.");

  AddDetail( ({"steine","barinsteine"}),
	    "Die Barinsteine erhellen die Hallen von Ardhmir.");
  
  AddDetail( ({"beschaeftigungen"}),
	    "Die Beschaeftigungen der Zwerge gehen Dich nichts an.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Ein suesslicher Duft kommt aus dem Suedwesten.");  
 
  AddSmell( ({"suedwesten","duft"}),
	   "Es duftet nach Koestlichkeiten des Baeckers.");

  AddSmell( ({"koestlichkeiten","brot"}),
	   "Es duftet nach frisch gebackenem Brot.");
  
  
  AddSound(DEFAULT_SOUND, "Du hoerst verschiedene Gespraeche der Zwerge.");

  AddSound( ({"gespraeche","zwerge","leute"}),
	   "Man belauscht keine anderen Leute.");
  
//-----Details Ende-----
  
AddExit("suedwesten", ROOM "zwfeab");
AddExit("norden", ROOM "zwfe14");

}
