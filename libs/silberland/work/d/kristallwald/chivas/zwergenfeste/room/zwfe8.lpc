// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl;

void create()
	
{
  ::create();

  anzahl=1;

  SetProp( P_INT_SHORT, "In der Zwergenfeste von Ardhmir");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"tunnel","osten"}), 
            "Der breite Tunnel fuehrt weiter in die Zwergenfeste hinein.");

  AddDetail( ({"waende","wand"}),
	    "An den Waenden sind viele Verzierungen zu erkennen und ein paar "
            "leuchtende Steine, die den Tunnel erhellen.");

  AddDetail( ({"zwergenfeste","feste","ardhmir"}),
	    "Du befindest Dich auf den Weg in die Zwergenfeste von Ardhmir.");
  
  AddDetail( ({"weg"}),
	    "Es ist eigentlich ein Tunnel der nach Osten fuehrt.");

  AddDetail( ({"verzierungen"}), 
            "Die Verzierungen zeigen Zwerge.");

  AddDetail( ({"steine","barinsteine","barinstein","stein","licht"}),
	    "Die Barinsteine leuchten und erhellen den Tunnel, so dass man "
            "alles gut erkennen kann.");

  AddDetail( ({"zwerge"}),
	    "Die Verzierungen mit den Zwergen sind sauber in die Wand "
            "gemeisselt und wurden dann mit Silber ausgegossen. Es ist eine "
            "hohe Kunst, die nur die besten Handwerker von Ardhmir "
            "beherrschen.");

  AddDetail( ({"einwohner"}),
	    "Die Einwohner der Feste sind sehr reich.");

  AddDetail( ({"silber"}),
	    "Das Silber ist in die Vertiefungen eingearbeitet, die von den "
            "Handwerkern der Zwergenfeste in die Wand gemeisselt wurden.");

  AddDetail( ({"handwerker","handwerkern"}),
	    "Die Zwergenfeste von Ardhmir hat die besten Handwerker des "
            "Silberlandes.");
  
  AddDetail( ({"vertiefungen"}),
	    "Die Vertiefungen sind nun mit Silber ausgefuellt.");

  AddDetail( ({"kunst"}),
	    "Die Handwerker von Ardhmir beherrschen ihre Kunst.");

  AddDetail( ({"silberland","silberlandes"}), 
            "Du befindest Dich im Silberland.");

  AddSpecialDetail( ({ "steinbrocken","brocken" }), "brocken" );
  AddSpecialDetail( ({ "decke","himmel" }), "decke" );
  AddSpecialDetail( ({ "boden","steinplatten","platten" }), "boden" );
  AddSpecialDetail( ({ "gold","goldader","ader","spitzhacke" }), "gold" );
  AddSpecialDetail( ({ "glitzern" }), "glitzern" );
  AddSpecialDetail( ({ "luecken","luecke","risse" }), "luecken" );

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht trotzdem Du in einem Tunnel bist nach "
                          "frischer Luft.");  
 
  AddSmell( ({"luft"}),
	   "Es riecht so frisch, als ob Du draussen waerst.");

  AddSound(DEFAULT_SOUND, "Man hoert noch ein wenig den Wind durch die Baeume "
                          "draussen rauschen.");

  AddSound( ({"wind","baeume"}),
	   "*rausch*");
  
//-----Details Ende-----
  
AddExit("westoben", ROOM "zwfe7");
AddExit("ostunten", ROOM "zwfe9");

AddCmd( ({"bau","baue" }), "bauen" );

}
string _query_int_long()
{
  string txt;

    if ( anzahl )
    {
     txt = "Der Tunnel fuehrt weiter nach Osten. Der Tunnel ist breit und die "
        "Waende sind kunstvoll geschmueckt. Der Boden ist sauber und fuehrt "
        "Dich langsam weiter nach unten in die Zwergenfeste von Ardhmir.";
    }
    else
    {
    txt = "Der Tunnel fuehrt weiter nach Osten. Der Tunnel ist breit und die "
        "Waende sind kunstvoll geschmueckt. Der Boden ist jedoch mit lauter "
        "grossen Steinbrocken bedeckt, als ob sie vor kurzen erst von der "
        "Decke herunter gefallen sind. Hoffentlich stand dort keiner und "
        "wurde getroffen.";    }
  return BS(txt);
}
void reset()
{
  ::reset();
  anzahl=1;
}
string decke(string key)
{
    if ( anzahl )
    {
    return(BS("Die Decke ist recht weit ueber Dir. Du erkennst dort ein "
              "Glitzern."));
    }
    else
    {
    return(BS("An der Decke erkennst Du grosse Luecken und Risse, die wohl "
              "entstanden sind, als die grossen Brocken herunter gefallen "
              "sind."));
    }
}
string brocken(string key)
{
    if ( anzahl )
    {
    return(BS("Du siehst keine Steinbrocken. Der Boden ist sauber."));
    }
    else
    {
    return(BS("Grosse Steinbrocken liegen auf den Steinplatten am Boden. "
              "Sie sind anscheinend erst vor kurzem von der Decke herunter "
              "gefallen. Wie das wohl geschehen konnte?"));
    }
}
string luecken(string key)
{
    if ( anzahl )
    {
    return(BS("Du siehst keine Luecken und Risse an der Decke."));
    }
    else
    {
    return(BS("Die grossen Luecken und Risse passen gar nicht zu den sonst so "
              "sauber ausgearbeiteten Tunnel der Zwergenfeste."));
    }
}
string boden(string key)
{
    if ( anzahl )
    {
    return(BS("Auf dem Boden sind grosse Steinplatten zu sehen, die sauber "
            "geschliffen wurden, so dass man hervorragend auf ihnen gehen "
            "kann."));
    }
    else
    {
    return(BS("Die Steinplatten auf dem Boden sind von den grossen "
              "Steinbrocken fast komplett bedeckt."));
    }
}
string gold(string key)
{
    if ( anzahl )
    {
    return(BS("Die Goldader glitzert im Licht der Barinsteine. Anscheinend "
              "haben die Einwohner von Ardhmir vergessen diese Ader abzubauen. "
            "Vielleicht kannst Du das restliche Gold mit einer Spitzhacke "
            "abbauen."));
    }
    else
    {
    return(BS("Du siehst leider keine Goldader, noch nicht mal ein bisschen "
              "Gold."));
    }
}
string glitzern(string key)
{
    if ( anzahl )
    {
    return(BS("Das Glitzern scheint eine Goldader zu sein, die im Licht der "
            "Barinsteine glitzert."));
    }
    else
    {
    return(BS("Du siehst leider kein Glitzern."));
    }
}
int bauen(string str)
{
 notify_fail("Was willst Du abbauen womit abbauen?\n");

 if(!str || str == "") return 0;
 if(!(str == "gold ab" ||
      str == "gold mit spitzhacke ab" ||
      str == "gold mit hacke ab" )) return 0;
 

 if( str == "gold mit spitzhacke ab" ||
     str == "gold mit hacke ab"){
    
  if(!present("spitzhacke", TP)){
	  
  write(BS("Du hast ja gar keine. Wie willst Du dann damit Gold abbauen?\n"));
 
  say(TPN+" denkt nach.\n");
  return -1;
  }

  if(!present("leiter", TP)){
	  
  write(BS("Du hast ja gar keine Leiter. Wie willst Du denn dann an die "
           "Decke kommen? Denk doch mal nach!\n"));
 
  say(TPN+" denkt nach.\n");
  return -1;
  }

    if ( anzahl )
    {
    write(BS( "Du steigst auf die Leiter und beginnst mit der Spitzhacke die "
              "Decke zu maltretieren, bis ploetzlich Risse auftauchen und "
              "sich einige Brocken vor Decke loesen und Dich darunter "
              "begraben.\n"
              "Kurz darauf wachst Du am Boden unter ein paar Brocken wieder "
              "auf. Na super, sieh Dir die Schweinerei hier mal an. Das "
              "naechste Mal solltest Du Dir ein paar Gedanken machen, wieso "
              "die Zwerge das Gold nicht abgebaut haben. Gratulation!!!"));
    say( TPN+" macht etwas verdammt Dummes und wird von ein paar Steinbrocken "
              "begraben.\n");
    anzahl--;
    return 1;
    }
    else
    {
    write(BS( "Du kannst hier kein Gold abbauen."));
    say( TPN+" probiert etwas unmoegliches.\n");
    return 1;
    }
 if( str == "gold ab"){
 
 write(BS("Womit willst Du denn das Gold abbauen ? "
	  "Eine Spitzhacke waere hier eine gute Idee.\n"));

 say(TPN+" stellt sich dumm an.\n");
 return 1;
 }
 }
}



