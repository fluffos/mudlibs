// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Zwergenfeste von Ardhmir");
  SetProp( P_INT_LONG,
	"Die Hallen scheinen hier im Norden zu enden. Ein kleiner Gang scheint "
        "weiter nach Norden weiter zu fuehren und im Nordwesten "
        "ist wohl der Schmied beheimatet, der die beruehmten Panzer "
        "und Waffen der Zwerge herstellt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"hallen","halle"}), 
            "Die Hallen enden hier. Es gibt nur noch die Moeglichkeit nach "
	    "Norden in einen Gang weiter zu gehen oder nach Nordwesten, wo "
	    "anscheinend der Schmied von Ardhmir beheimatet ist.");

  AddDetail( ({"norden","gang","rest"}),
	    "Im Norden fuehrt ein Gang weiter, der sich jedoch noch nicht "
	    "ganz fertig zu sein scheint. Wie Du von hier erkennen kannst, "
	    "ist der Gang nur grob behauen und nicht so sauber wie der Rest "
	    "von Ardhmir. Aber Du kannst ja hingehen und es Dir genauer "
	    "anschauen.");

  AddDetail( ({"nordwesten"}),
	    "Im Nordwesten hat sich der Schmied der Feste niedergelassen. Am "
	    "Eingang zu seiner Schmiede stehen zwei grosse Ritterruestungen "
	    "und ein Schild wurde ueber der Oeffnung angebracht.");
  
  AddDetail( ({"schmied","schmiedes"}),
	    "Der Schmied der Feste ist im Nordwesten zu finden.");
  
  AddDetail( ({"panzer"}), 
            "Die Panzer des Schmiedes sind geradezu legendaer fuer ihre "
	    "Qualitaet.");

  AddDetail( ({"waffen"}),
	    "Die Waffen von Ardhmir haben schon so manch uebles Wesen zu Tod "
	    "geschickt.");

  AddDetail( ({"zwerge"}),
	    "Die Zwerge leben und arbeiten hier in der Zwergenfeste.");

  AddDetail( ({"wand","waende","waenden"}),
	    "An den Waenden haengen ein paar Barinsteine in ihren Fassungen "
	    "und erhellen das Ende der Halle.");
  
  AddDetail( ({"boden"}),
	    "Der Boden ist glatt geschliffen und sauber, so dass man sich "
	    "sogar darin spiegeln koennte. Du solltest es aber bei Deinem "
	    "Aussehen lieber lassen.");

  AddDetail( ({"decke"}), 
            "Die Decke ist durch das Licht der Barinsteine gut zu erkennen. "
	    "Jedoch gibt es nichts interessantes an ihr zu erkennen.");

  AddDetail( ({"moeglichkeit"}),
	    "Es gibt immer irgendeine Moeglichkeit.");

  AddDetail( ({"ardhmir","feste","zwergenfeste"}),
	    "Du bist schon tief in die Zwergenfeste von Ardhmir vorgedrungen.");

  AddDetail( ({"eingang","oeffnung","eingangs"}),
	    "Ueber dem Eingang zur Schmiede haengt ein grosses Schild. "
	    "Ausserdem siehst Du zu beiden Seiten je eine grosse Ruestung "
	    "stehen, die das Geschick des Schmiedes zeigen.");
  
  AddDetail( ({"ritterruestungen","ritterruestung","ruestung","ruestungen"}),
	    "Die Ruestungen neben dem Eingang zur Schmiede sind sehr gut "
	    "verarbeitet. Sie bestehen aus Metall und Leder und bieten kaum "
	    "Angriffsflaeche fuer den Gegner.");

  AddDetail( ({"schild"}), 
            "Das Schild haengt ueber der Oeffnung zur Schmiede. Du kannst es "
	    "lesen.");

  AddDetail( ({"qualitaet","besten"}),
	    "Die Qualitaet gehoert zu den Besten im Silberland.");

  AddDetail( ({"wesen"}),
	    "Es gibt viele ueble Wesen im Silberland, die man bekaempfen kann. "
	    "Natuerlich gilt das gleiche auch fuer gute Wesen. Auch sie kann "
	    "man hervorragend zu Tode quaelen.");

  AddDetail( ({"Tod","tode"}),
	    "Tod erscheint aus dem Nichts neben Dir. \n"
	    "Tod fragt: WAS WILLST DU VON MIR?\n");
  
  AddDetail( ({"barinsteine","steine"}),
	    "Die Barinsteine spenden mit ihrem gelben Gluehen genug Licht um "
	    "alles genau sehen zu koennen.");

  AddDetail( ({"aussehen"}), 
            "Kein Kommentar!");

  AddDetail( ({"kommentar"}),
	    "Man sollte doch nicht persoenlich werde und die Gefuehle von "
	    "Abenteurern verletzen.");

  AddDetail( ({"gefuehle"}),
	    "Hast Du ueberhaupt welche?");

  AddDetail( ({"abenteurern","abenteurer"}),
	    "Abenteurer wie Du einer bist.");
  
  AddDetail( ({"seiten"}),
	    "Zu beiden Seiten des Eingangs stehen grosse Ruestungen.");

  AddDetail( ({"geschick"}), 
            "Das Geschick des Schmiedes ist sehr gross.");

  AddDetail( ({"schmiede"}),
	    "Die Schmiede ist im Nordwesten.");

  AddDetail( ({"metall","sachen","metallsachen"}),
	    "Es wird Metall in einer Schmiede verarbeitet. Man kann aus ihm "
	    "verschiedenste Sachen schmieden.");

  AddDetail( ({"leder"}),
	    "Mit Leder werden Ruestungen und andere Metallsachen gepolstert.");
  
  AddDetail( ({"angriffsflaeche"}),
	    "Es gibt kaum eine Chance durch die Ruestung durchzukommen.");

  AddDetail( ({"gegner"}),
	    "Du hattest bestimmt auch schon Gegner auf dem Weg bis in die "
	    "Zwergenfeste von Ardhmir.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland. Es ist kaum zu glauben.");

  AddDetail( ({"fassungen"}),
	    "Die goldenen Fassungen der Barinsteine glitzern ein wenig im "
	    "Licht der Steine.");
  
  AddDetail( ({"chance"}),
	    "Eine kleine Chance gibt es immer.");

  AddDetail( ({"weg"}),
	    "Es war ein langer Weg bis hier her.");

  AddDetail( ({"ende"}),
	    "Dies ist das noerdliche Ende der Hallen.");

  AddDetail( ({"licht","gluehen"}),
	    "Das Gluehen der Barinsteine spendet soviel Licht, so dass man "
            "alles gut erkennen kann.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst Rauch.");  
 
  AddSmell( ({"rauch"}),
	   "Der Rauch stammt sicher aus der Schmiede im Nordwesten.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Haemmern auf Metall.");

  AddSound( ({"haemmern","metall"}),
	   "Das Haemmern stammt anscheinend aus der Schmiede.");
  
  AddReadDetail( ({"schild"}),
"+-------------------------------------------------------------------+\n"
"|                                                                   |\n"
"|  Beste Waffen und Ruestungen zu kaufen. Auch Reparatur moeglich ! |\n"
"|                                                                   |\n"
"|  Brak, der Schmied Ihres Vertrauens                               |\n"
"|                                          .-.                      |\n"
"|                                         {{@}}                     |\n"
"|                         <>               8@8                      |\n"
"|                       .::::.             888                      |\n"
"|                   @\\\\/W\\/\\/W\\//@         8@8                      |\n"
"|                    \\\\/^\\/\\/^\\//     _    )8(    _                 |\n"
"|                     \\_O_<>_O_/     (@)__/8@8\\__(@)                |\n"
"|                ____________________   ~-=):(=-~                   |\n"
"|               |<><><>  |  |  <><><>|     |.|                      |\n"
"|               |<>      |  |      <>|     |S|                      |\n"
"|               |<>      |  |      <>|     |'|                      |\n"
"|               |<>   .--------.   <>|     |.|                      |\n"
"|               |     |   ()   |     |     |P|                      |\n"
"|               |_____| (O\\/O) |_____|     |'|                      |\n"
"|               |     \\   /\\   /     |     |.|                      |\n"
"|               |------\\  \\/  /------|     |U|                      |\n"
"|               |       '.__.'       |     |'|                      |\n"
"|               |        |  |        |     |.|                      |\n"
"|               :        |  |        :     |N|                      |\n"
"|                \\<>     |  |     <>/      |'|                      |\n"
"|                 \\<>    |  |    <>/       |.|                      |\n"
"|                  \\<>   |  |   <>/        |K|                      |\n"
"|                   `\\<> |  | <>/'         |'|                      |\n"
"|                     `-.|  |.-`           \\ /                      |\n"
"|                        '--'               ^                       |\n"
"|                                                                   |\n"
"+-------------------------------------------------------------------+\n");


//-----Details Ende-----
  
AddExit("sueden", ROOM "zwfe11");
AddExit("norden", ROOM "zwfe28");
AddExit("nordwesten", ROOM "zwfef");

}
