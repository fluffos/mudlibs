inherit "std/pub";

#include "../def.h"
#include <pub.h>


void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));
  SetProp(P_INT_SHORT,"In der Zwergenkneipe 'Zum weissen Drachen'");
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "thorak");
  SetProp(P_PUBKEEPER_NAME, "thorak");
  SetProp(P_PUBMSG_NOKEEPER, "Thorak ist leider nicht hier.\n");
  SetProp(P_PUBMSG_NOENEMY, BS(
      "Du bist gerade in einem verbissen Kampf mit Thorak. Kein Wunder, "
      "dass er Dich nicht bedient."));
  SetProp(P_PUBMSG_NOINVITE, BS(
      "Thorak kaempft. Da hat er wahrhaft andere Sorgen als Kunden."));
  SetProp(P_PUBMSG_FIGHTING, "Thorak kaempft gerade.\n");

  AddDrink("Zwergenmet", ({"met","zwergenmet"}),
           360, 50, 10, 6,
           ({"Thorak serviert Dir einen grossen Humpen Zwergenmet.\n",
             "&& trinkt einen grossen Humpen Met.\n"}));

  AddDrink("Zwergenbraeu", ({"zwergenbraeu","braeu"}),
            220, 28, 9, 3,
           ({"Thorak bringt Dir ein Glas Zwergenbraeu.\n"
            +"Es schmeckt ein wenig bitter und Du schuettelst Dich. \n",
             "&& trinkt ein Glas Zwergenbraeu und schuettelt sich.\n"}));

  AddDrink("Schneckentee", ({"schneckentee","tee"}),
            150, 15, 0, 5,
           ({"Thorak bringt Dir eine Tasse schleimigen Schneckentee.\n"
            +"Der Tee soll zwar eine Koestlichkeit sein, aber vielleicht "
	    "solltest Du das naechste Mal was anderes bestellen. Es schmeckt "
	    "scheusslich.\n",
             "&& trinkt eine Tasse Schneckentee und wird ganz gruen im "
	     "Gesicht.\n"}));

  AddFood("Schneckensuppe", ({"schneckensuppe", "suppe"}), 200, 25, 9,
           ({"Thorak bringt Dir eine leckere Schneckensuppe. Sie ist wirklich "
	    "schleimig."
            +"\nHmmmm, es schmeckt lecker. Du haettest das gar nicht gedacht.\n",
             "&& loeffelt eine Suppe.\n"}));
  AddFood("Ein feuriges Drachensteak", ({"drachensteak","steak"}), 80, 10, 7,
           ({"Thorak bringt Dir ein brennende Drachensteak.\n"
            +BS("Das Drachensteak schmeckt eigentlich ganz gut, aber Dein "
		"Rachen brennt. Vielleicht haettest Du erst pusten sollen."),
             "&& isst gierig feuriges Drachensteak.\n"}));

// ----------  Details  ---------------------

  AddDetail( ({"menue"}),
	    "Tipp einfach mal 'menue'.");

  AddDetail( ({"fee","feen"}),
	    "Feen sind sehr reinlich.");

  AddDetail( ({"humpen"}),
	    "Grosse Humpen stehen auf den Tischen.");

  AddDetail( ({"zwergenmet"}),
	    "Das Zwergenmet sieht lecker aus.");

  AddDetail( ({"wirt","thorak"}),
	    "Der Wirt der Kneipe heisst Thorak.");

  AddDetail( ({"augen"}),
	    "Du hast schoene Augen.");

  AddDetail( ({"nebelschwaden","qualm"}),
	    "Der Qualm haengt dicht unter der Decke.");

  AddDetail( ({"spinnweben","weben","staub"}),
	    "Die Spinnweben sind fast so alt wie die Halterungen. Hier wird "
	    "nicht sehr oft Staub geputzt.");

  AddDetail( ({"ardhmir","zwergenfeste"}),
	    "Du befindest Dich in der Zwergenfeste von Ardhmir.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen sind alt und mit Spinnweben bedeckt.");

  AddDetail( ({"licht","fackeln"}),
	    "Das schummrige Licht der Fackeln erhellt die Kneipe.");

  AddDetail( ({"scherben","glaesern","glaeser","schuhe"}),
	    "Die Scherben der Glaeser sind schoen spitz. Hoffentlich hast Du "
	    "Schuhe an.");

  AddDetail( ({"bierlachen"}),
	    "Du solltest aufpassen, dass Du nicht auf den Bierlachen "
	    "ausrutscht.");

  AddDetail( ({"sauberkeit"}),
	    "Sauberkeit ist nicht so wichtig und es stoert Dich auch nicht, "
	    "dass hier nicht so auf Sauberkeit geachtet wird. Du bist doch "
	    "keine Fee, oder?");

  AddDetail( ({"hoehle"}),
	    "Hier sieht man, dass die Zwergenfeste von Ardhmir in einer Hoehle "
	    "ist. Ansonsten kann man das in Ardhmir schnell vergessen.");

  AddDetail( ({"fels"}),
	    "Die Theke besteht aus Fels, der auch sonst ueberall in der Kneipe "
	    "zu sehen ist.");

  AddDetail( ({"rassen"}),
	    "Es gibt viele Rassen im Silberland.");

  AddDetail( ({"geschmack"}),
	    "Dies ist eine Kneipe ganz nach Deinem Geschmack.");

  AddDetail( ({"spass"}),
	    "Hier in der Kneipe kann man sicher viel Spass haben.");

  AddDetail( ({"trinken","feiern","stimmung"}),
	    "Die Stimmung laedt zum Trinken und Feiern ein. Hier fuehlst Du "
	    "Dich wohl.");

  AddDetail( ({"waende","wand"}),
	    "An den Waenden haengen ein paar Fackeln in alten Halterungen, die "
	    "die Kneipe in ein schummriges Licht huellt.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen ein paar Scherben von ein paar Glaesern und "
	    "einige grosse Bierlachen sind zu sehen. Anscheinend wird hier "
	    "nicht besonders auf Sauberkeit geachtet, aber Dich stoert sowas "
	    "nicht. Es passt irgendwie zu der gemuetlichen Stimmung in der "
	    "Kneipe.");

  AddDetail( ({"decke"}),
	    "Die Decke ist ueberhaupt nicht verkleidet und Du kannst den "
	    "blanken Fels einer Hoehle durch die Nebelschwaden sehen, die "
	    "durch den Qualm der Pfeifen entstehen.");

  AddDetail( ({"theke"}),
	    "Die lange Theke wurde direkt aus dem Fels der Hoehle heraus "
	    "gemeisselt.");

  AddDetail( ({"tische","stuehle"}),
	    "Die Tische und Stuehle sind nicht gerade komfortabel, dafuer "
	    "aber rustikal und unzerstoerbar. Sie bestehen naemlich aus "
	    "Stein.");

  AddDetail( ({"gast","gaeste","besuch"}),
	    "Es sind nur Zwerge in der Kneipe zu Besuch. Anscheinend verirren "
	    "sich nur selten andere Rassen in die Kneipe.");

  AddDetail( ({"zwerge"}),
	    "Lauter Zwerge sitzen auf den Stuehlen und reden oder lachen.");

  AddDetail( ({"pfeifen","rauch"}),
	    "Die Zwerge, die hier als Gaeste an den Tischen sitzen "
	    "blasen viel Rauch aus ihren Pfeifen.");

  AddDetail( ({"zwergenkneipe","kneipe"}),
	    "Die Zwergenkneipe ist ganz nach Deinem Geschmack. Hier macht das "
	    "Trinken und Feiern sicher viel Spass.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Alkohol und Rauch.");  
 
  AddSmell( ({"rauch"}),
	   "Der Rauch brennt Dir in den Augen.");

  AddSmell( ({"alkohol","luft"}),
	   "Du bist schon von dem Alkohol in der Luft ein wenig beduselt.");

  AddSound(DEFAULT_SOUND, "Du hoerst Gelaechter und Gespraeche.");

  AddSound( ({"gelaechter","witz"}),
	   "Anscheinend hat ein Gast einen Witz erzaehlt.");
  
  AddSound( ({"gespraeche"}),
		"Du sollst doch keine Gespraeche belauschen.");


// ----------- Details Ende -------------------
  AddExit("norden", ROOM "zwfe23");

  AddItem(NPC "thorak", REFRESH_DESTRUCT);
}

string _query_int_long()
{
  string txt;

  txt = "Dies ist eine typische Zwergenkneipe, wie Du sie Dir bisher immer "
	"vorgestellt hast. Es ist verraucht von den Pfeifen der Zwerge, die "
	"hier zu Gast sind. Die Tische und Stuehle sind einfach und "
	"rustikal und es gibt eine schoene lange Theke, an der das Menue "
	"haengt. Tipp einfach 'menue' um zu sehen, was es hier so alles "
	"gibt\n.";

  if(QueryProp(P_PUBKEEPER_ID))
  {
    if(!present(QueryProp(P_PUBKEEPER_ID)))
    {
      txt += "Seltsamerweise ist offenbar gerade niemand hier der Dich "
        "bedienen koennte.";
    }
    else
    {
      txt += "Der Wirt steht hinter der Theke und fuellt grosse Humpen mit dem "
	     "wuerzigen Zwergenmet, dass es hier gibt.";
    }
  }

  return BS(txt);
}
