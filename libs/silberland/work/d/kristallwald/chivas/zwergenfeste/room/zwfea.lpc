inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

SetProp(P_INT_SHORT,"Im Heiligtum von Ardhmir");
SetProp(P_INT_LONG,
   "Der Tempel von Ardhmir ist den Zwergengoettern gewidmet. Ueberall im "
   "Tempel sind Steinskulpturen der Goetter zu sehen. An der Nordwand steht "
   "ein grosser Altar, der in der Form eines Amboss geformt ist. Ueberall "
   "stehen brennende Kerzen und einige betende Zwerge sind anwesend.");
SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
SetProp(P_INDOORS, 1);
SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
 
  AddDetail( ({"tempel"}),
	    "Die Kammer in der der Tempel sich befindet wurde in den Fels der "
	    "Hochebene gehauen und kunstvoll mit Ornamenten, Verzierungen und "
	    "einigen Wandteppichen geschmueckt.");

  AddDetail( ({"ardhmir","zwergenfeste","feste","zwergenreich","reich"}), 
            "Der Tempel ist das Heiligtum von Ardhmir. Du befindest Dich "
	    "momentan in dem Zwergenreich.");

  AddDetail( ({"zwergengoetter","goetter","goettern","aspekt","oberste","gott","vielzahl"}), 
            "Zwerge verehren eine Vielzahl an Goettern, die jeweils fuer einen "
	    "Aspekt zwergischen Lebens zustaendig sind. Der Oberste Gott ist "
	    "Orodin, der auf seiner Schmiede die Welt für die Zwerge erschuf. "
	    "Weitere Goetter sind z.B. Reorx, der Gott des Todes, er kuemmert "
	    "sich um die Seelen der verstorbenen Zwerge und Kiira die Goettin "
	    "der Liebe.");

  AddDetail( ({"steinskulpturen","skulpturen","statuen"}),
	    "Einige Steinskulpturen der Goetter stehen an den Waenden auf "
	    "kleinen Podesten. Du erkennst die Statuen von Orodin, Reorx und "
	    "Kiira. Ausserdem sind zwei kleine Statuen von Woody und Dusty "
	    "zu erkennen, die jedoch nicht zu den Zwergengoettern gehoeren, "
	    "aber trotzdem verehrt werden.");
 
  AddDetail( ({"nordwand","altar","altars"}),
	    "An der Nordwand steht ein grosser Altar, der die Form von einem "
	    "Amboss hat. Er nimmt die gesamte noerdliche Wand des Tempels ein "
	    "und auf ihm liegen und stehen einige Requisiten fuer die "
	    "Zwergenpriester.");

  AddDetail( ({"form","amboss"}), 
            "Der riesige Amboss, der als Altar dient, scheint aus Eisen zu "
	    "bestehen. Verschiedene Zeichen sind mit Gold verziert im Eisen "
	    "des Altars zu sehen. ");

  AddDetail( ({"kerzen"}), 
            "Ueberall stehen Kerzen im Tempel. Auch haengen viele Kerzen in "
	    "Halterungen an den Waenden. Sie erhellen den Tempel in einem "
	    "schummrigen Licht.");

  AddDetail( ({"zwerge"}),
	    "Einige Zwerge knieen vor dem Altar und beten leise.");
 
  AddDetail( ({"boden"}),
	    "Der Boden besteht aus grossen glaenzenden Marmorplatten.");

  AddDetail( ({"decke","dunkelheit"}), 
            "Die Decke ist ueber Dir und in der Dunkelheit weiter oben nicht "
	    "zu erkennen. Der Schein der Kerzen reicht nicht soweit nach "
	    "oben.");

  AddDetail( ({"waende","waenden"}), 
            "An den Waenden stehen grosse Statuen auf Podesten. Ausserdem sind "
	    "verschiedene Verzierungen, Ornamente und Wandteppiche zu "
	    "erkennen.");

  AddDetail( ({"fels"}),
	    "Der harte Fels der Hochebene wurde glatt gehauen, so dass die "
	    "Waende gerade sind und es nicht so aussieht wie in einer Hoehle.");
 
  AddDetail( ({"hochebene","gorthad"}),
	    "Die Zwergenfeste von Ardhmir befindet sich tief unter der "
	    "Hochebene von Gorthad.");

  AddDetail( ({"ornamente","ornamenten"}), 
            "Die Ornamente an den Waenden sind sehr fein und verspielt. Ein "
	    "Steinmetz der Zwerge hat sich sehr viel Muehe gegeben.");

  AddDetail( ({"verzierungen","quadrate","kreise","kringel","dreiecke","bedeutung"}), 
            "Die Verzierungen zeigen Quadrate, Kreise, Kringel und Dreiecke. "
	    "Die Bedeutung verstehst Du leider nicht.");

  AddDetail( ({"wandteppiche","wandteppichen","teppiche","name"}),
	    "Auf den Wandteppichen sind verschiedene Zwergengoetter "
	    "abgebildet, die wohl nicht so wichtig sind, da noch nicht einmal "
	    "ihr Name in die Teppiche gestickt ist.");
 
  AddDetail( ({"orodin","schmiede","welt"}),
	    "Orodin ist der hoechste Gott der Zwerge. Er wird am meisten von "
	    "allen Goettern verehrt.");

  AddDetail( ({"reorx","todes","tod","seelen","gewissheit"}), 
            "Reorx ist der Gott, den die Zwerge am wenigsten sehen moechten, "
	    "jedoch sollte man sich mit ihm gut stellen, da man ihn mit "
	    "Gewissheit irgendwann treffen wird.");

  AddDetail( ({"kiira","goettin","liebe","grund"}), 
            "Kiira ist die Goettin der Liebe und wird aus diesem Grund "
	    "natuerlich auch sehr von den Zwergen verehrt.");

  AddDetail( ({"podesten","podeste","namen"}),
	    "Auf den Podesten stehen einige Statuen von Goettern. Ihre Namen "
	    "sind auf den Podesten eingeritzt. Du liest: Orodin, Reorx, Kiira, "
	    "Woody und Dusty.");
 
  AddDetail( ({"woody","gottheit"}),
	    "Woody wird als Gott im gesamten Silberland verehrt. Auch die "
	    "Zwerge erkennen ihn als Gottheit an.");

  AddDetail( ({"dusty"}), 
            "Dusty wird wie Woody im Silberland verehrt. Ganz speziell jedoch "
	    "von den Paladinen, die ihr Leben Dusty geweiht haben.");

  AddDetail( ({"lebens","leben"}), 
            "Welchem Gott Du folgst, ist nur Dir bekannt.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland.");
 
  AddDetail( ({"paladine","paladinen","gilde","gute"}),
	    "Die Paladine sind eine Gilde im Silberland, die Dusty verehren "
	    "und fuer das Gute kaempfen.");

  AddDetail( ({"zwergenpriester","priester"}), 
            "Die Zwergenpriester leiten die Zeremonien hier im Tempel.");

  AddDetail( ({"requisiten"}), 
            "Du erkennst eine Axt, einen Meissel und eine Spitzhacke.");

  AddDetail( ({"wand"}),
	    "Welche Wand meinst Du?");
 
  AddDetail( ({"westwand","ostwand"}),
	    "An der Westwand und an der Ostwand haengen viele Kerzen, einige "
	    "Wandteppiche und einige Statuen stehen an der Wand.");

  AddDetail( ({"suedwand","ausgang"}), 
            "In der Suedwand ist der Ausgang in die grosse Halle.");

  AddDetail( ({"gold"}),
	    "Das Gold glaenzt Dich an.");
 
  AddDetail( ({"zeichen","sprache","kraft","macht","eindruck"}),
	    "Die Zeichen sind in einer alten zwergischen Sprache geschrieben, "
	    "die Du leider nicht lesen kannst. Sie machen auf Dich jedoch den "
	    "Eindruck von Kraft und Macht.");

  AddDetail( ({"halterungen"}), 
            "Selbst die Halterungen haben kleine Verzierungen und sehen sehr "
	    "kunstvoll aus.");

  AddDetail( ({"licht","schein","kerzenlicht"}), 
            "Das schummrige Kerzenlicht passt perfekt zu dem Tempel.");

  AddDetail( ({"marmorplatten","granit","gegensatz","marmor","platten","marmorboden"}),
	    "Die Marmorplatten sind sehr wertvoll und wurden von weit her aus "
	    "dem Gebirge hier her nach Ardhmir geschafft. Sie sind ein "
	    "grosser Gegensatz gegen die Platten aus Granit in der grossen "
	    "Halle.");

  AddDetail( ({"hoehle"}),
	    "Es ist kaum zu glauben, aber dieser Tempel ist in einer Hoehle, "
	    "obwohl es ueberhaupt nicht wie in einer Hoehle aussieht.");
 
  AddDetail( ({"muehe","steinmetz","kunst"}),
	    "Die Steinmetze haben ihre ganze Kunst in die Ornamente gelegt und "
	    "voll Muehe die schoensten Ornamente gezaubert, die Du jemals "
	    "gesehen hast.");

  AddDetail( ({"zeremonien"}), 
            "Die Zeremonien, die hier im Tempel abgehalten werden, sind Dir "
	    "fremd.");

  AddDetail( ({"axt","meissel","spitzhacke","aexten"}), 
            "Wozu eine Axt, ein Meissel und eine Spitzhacke dienen, weisst Du "
	    "auch nicht und willst es auch nicht so genau wissen.");

  AddDetail( ({"gebirge"}),
	    "Das Gebirge ist weit von Ardhmir entfernt.");
 
  AddDetail( ({"halle"}),
	    "Nach Sueden gelangst Du in die grosse Halle.");

  AddDetail( ({"kammer"}), 
            "Es ist eigentlich keine Kammer, sondern ein grosser Tempel.");

  AddDetail( ({"heiligtum"}), 
            "Der Tempel ist das Heiligtum von Ardhmir.");

  AddDetail( ({"eisen"}),
	    "Das Eisen glaenzt, als ob es gerade erst poliert wurde.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","es","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Kerzenwachs.");  
 
  AddSmell( ({"kerzenwachs","wachs"}),
	   "Das Kerzenwachs riecht irgendwie beruhigend.");

  AddSound(DEFAULT_SOUND, "Du hoerst eine Art von metallisch klingender "
		          "Musik.");

  AddSound( ({"art","musik","geraeusch"}),
	   "Ab und zu schlagen die betenden Zwerge mit ihren Aexten auf den "
	   "Marmorboden, was dieses metallische Geraeusch hervor ruft.");
//-----Details Ende-----

AddExit("sueden", ROOM "zwfe19");

AddCmd( ({"bete","bete"}), "beten" );

}
int beten() {
   write("Du haeltst eine kurzes Gebet.\n");
   if (this_player()->QueryProp(P_GHOST))
   {
	write(BS("Eine sehr starke Kraft durchfliesst Dich und gibt Dir wieder Kraft.\n"));
	say(this_player()->name()+" erscheint in koerperlicher Form.\n");
	this_player()->SetProp(P_GHOST,0);
   }
   return 1;
}


