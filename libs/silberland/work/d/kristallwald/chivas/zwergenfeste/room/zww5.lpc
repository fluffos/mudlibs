// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Waldlichtung");
  SetProp( P_INT_LONG,
	"In der Mitte der natuerlichen Lichtung ist ein grosser idyllischer "
        "Waldsee. Am Ufer des Sees steht ein wenig Schilf und andere Blumen. "
        "Ansonsten siehst Du hauptsaechlich Gras auf der Lichtung, dass auch "
        "bis an das Ufer reicht. Grosse Baeume schirmen in alle Richtungen "
        "die Lichtung und den See ab. Der Weg fuehrt oestlich am See vorbei. "
        "Der Rest des Sees wird von einer grossen Wiese umrundet." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1);

//-----Details Anfang-----
  
  AddDetail( ({"mitte","waldsee","see","sees","augen","mittelpunkt"}), 
            "Der See ist der Mittelpunkt der Lichtung. Er ruht von einer "
            "Wiese umschlossen vor Deinen Augen.");

  AddDetail( ({"lichtung"}),
	    "Die Lichtung ist gross und wird von den Baeumen des Waldes "
            "eingerahmt. In ihrer Mitte ist ein grosser See zu sehen.");

  AddDetail( ({"ufer"}),
	    "Am Ufer waechst ein wenig Schilf und ein paar andere "
            "Wasserpflanzen. Das Gras der Wiese reicht bis an das Ufer des "
            "Sees.");

  AddDetail( ({"schilf"}),
	    "Das Schilf steht am Ufer und passt sehr gut zu dem See.");
  
  AddDetail( ({"blumen"}),
	    "Einige Blumen stehen am Ufer und auf der Wiese. Du solltest auf "
            "die Wiese nach Nordwesten gehen um genau zu sehen, was fuer "
            "Blumen es sind.");

  AddDetail( ({"gras"}), 
            "Das Gras ist saftig gruen.");

  AddDetail( ({"weg","norden","sueden"}),
	    "Der Weg schlaengelt sich von Sueden nach Norden oestlich der "
            "der Lichtung entlang.");

  AddDetail( ({"rest","wiese","nordwesten","probleme"}),
	    "Die Wiese fuehrt westlich um den See herum. Du kannst ohne "
            "Probleme auf die Wiese nach Nordwesten gehen.");
  
  AddDetail( ({"baeumen","baeume","richtungen"}),
	    "Die grossen Baeume des Waldes umranden die grosse Lichtung.");

  AddDetail( ({"wald","waldes","ort"}), 
            "In mitten des grossen Waldes ist diese wunderschoene Lichtung "
            "ein Ort der Ruhe und des Erholens.");

  AddDetail( ({"wasserpflanzen"}),
	    "Du erkennst Schilf. Die anderen Wasserpflanzen kennst Du leider "
            "nicht.");

  AddDetail( ({"pflanzen"}),
	    "Du siehst viele Pflanzen auf der Lichtung.");

  AddDetail( ({"ruhe","erholen","erholens","frieden"}),
	    "Hier auf der Lichtung kann man sich sehr gut ausruhen und "
            "Frieden finden.");
  
  AddDetail( ({"boden"}),
	    "Am Boden erkennst Du ein paar Steinchen und trockene Erde.");

  AddDetail( ({"steinchen"}), 
            "Es sind kleine Kieselsteine zu sehen.");

  AddDetail( ({"erde"}),
	    "Die Erde ist trocken. Es hat wohl laengere Zeit nicht mehr "
            "geregnet.");

  AddDetail( ({"himmel","sonne"}),
	    "Der Himmel ist schoen blau und die Sonne waermt Dich angenehm.");

  AddDetail( ({"zeit","weile"}),
	    "Es ist schon eine Weile her.");
  
  AddDetail( ({"kieselsteine"}),
	    "Ein kleiner Kiesel faellt Dir besonders auf.");

  AddDetail( ({"kiesel"}), 
            "Der laengliche Kiesel ist ein kleiner Knochen.");

  AddDetail( ({"knochen"}),
	    "Der kleine Knochen hat die Groesse wie ein Knochen an der Hand. "
            "Es scheint ein Fingerknochen zu sein.");

  AddDetail( ({"groesse"}),
	    "Der Knochen hat eine gewisse Groesse.");

  AddDetail( ({"hand","haende"}),
	    "Du kontrollierst Deine Haende um sicher zu gehen, dass dort nicht "
            "ein Knochen fehlt.");
  
  AddDetail( ({"fingerknochen"}),
	    "Du schaust Dich um, siehst aber niemanden, der ihn zu "
            "vermissen scheint. Du laesst ihn lieber liegen, vielleicht kommt "
            "der Besitzer ja wieder um ihn zu holen.");

  AddDetail( ({"besitzer"}), 
            "Dem Besitzer wird der Verlust sicher noch auffallen.");

  AddDetail( ({"verlust","fall"}),
	    "Dir waere der Verlust auf jeden Fall aufgefallen.");

  AddDetail( ({"voegel","voegeln"}),
	    "Einige Voegel fliegen ueber die Lichtung");

  AddDetail( ({"biene"}),
	    "Wenn Du nicht hektisch reagierst, sticht sie Dich nicht und "
            "fliegt weg.");
  
  AddDetail( ({"nase"}),
	    "Auf Deiner Nase sitzt eine kleine Biene.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es steigt Dir ein suesslicher Duft in die Nase.");  
 
  AddSmell( ({"duft","blumen"}),
	   "Der Duft kommt von den Blumen auf der Wiese.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Gezwitscher von Voegeln.");

  AddSound( ({"gezwitscher","voegel"}),
	   "Das Gezwitscher wirkt beruhigend auf Dich.");
  
//-----Details Ende-----
  
AddExit("nordosten", ROOM "zww6");
AddExit("suedwesten", ROOM "zww4");
AddExit("nordwesten", ROOM "zww16");

}
