// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Zwergenfeste von Ardhmir");
  SetProp( P_INT_LONG,
	"Die Halle in der Du stehst ist wie alle anderen Hallen der Feste "
        "gut durch die magischen Steine an den Waenden beleuchtet. Im Westen "
        "ist ein Laden, in dem man alle moeglichen Sachen kaufen kann." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"halle","hallen","sueden","norden"}), 
            "Die Halle zieht sich von Sueden nach Norden und wird durch grosse "
	    "Saeulen gestuetzt.");

  AddDetail( ({"feste","zwergenfeste","ardhmir"}),
	    "Du befindest Dich in der Zwergenfeste von Ardhmir.");

  AddDetail( ({"steine","barinsteine"}),
	    "Die leuchtenden Barinsteine strahlen ein gelbliches warmes Licht "
	    "aus und erhellen die Halle.");

  AddDetail( ({"waende","wand","waende"}),
	    "An den Waenden haengen die leuchtenden Barinsteine, die die "
	    "Halle erhellen. An der Westwand haengt ueber einer Oeffnung ein "
	    "Schild.");
  
  AddDetail( ({"westen","laden","zwergenladen","ladens"}),
	    "Im Westen ist der Laden von Ardhmir.");

  AddDetail( ({"sachen","waren"}), 
            "Im Laden kannst Du alle moeglichen Waren kaufen.");

  AddDetail( ({"boden","fels"}),
	    "Der Boden besteht aus glatt geschliffenen Fels. Der Fels am Boden "
	    "ist so glatt, so dass Du sogar Dein Spiegelbild sehen kannst.");

  AddDetail( ({"decke"}),
	    "Die Decke ist weit ueber Dir zu sehen. Sie ist jedoch nicht "
	    "besonders interessant.");

  AddDetail( ({"saeulen"}),
	    "Die grossen Saeulen der Halle tragen die Decke, die weit ueber "
	    "Dir zu sehen ist.");
  
  AddDetail( ({"licht"}),
	    "Das gelblich warme Licht der Barinsteine erhellt die Halle.");

  AddDetail( ({"westwand","oeffnung"}), 
            "In der Westwand befindet sich eine Oeffnung, die in den Laden "
	    "von Ardhmir fuehrt. Ueber der Oeffnung haengt ein kleines "
	    "Schild.");

  AddDetail( ({"schild"}),
	    "Du kannst das Schild lesen.");

  AddDetail( ({"spiegelbild"}),
	    "Du betrachtest kurz Dein Spiegelbild und findest Du muesstest "
	    "Dich mal wieder gruendlich waschen.");

  AddDetail( ({"thrax","besitzer"}),
	    "Thrax ist wohl der Besitzer des Ladens.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht suesslich aus dem Sueden.");  
 
  AddSmell( ({"sueden"}),
	   "Anscheinend wird weiter suedlich gebacken. Es duftet koestlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Poltern.");

  AddSound( ({"poltern"}),
	   "Das Poltern kommt aus dem Laden. Anscheinend ist dort etwas "
	   "umgefallen.");
  
  AddReadDetail( ({"schild"}),
		"+------------------------------------+\n"
		"|                                    |\n"
		"|        Thrax's Zwergenladen        |\n"
		"|                                    |\n"
		"+------------------------------------+\n");


//-----Details Ende-----
  
AddExit("sueden", ROOM "zwfe15");
AddExit("norden", ROOM "zwfe13");
AddExit("westen", ROOM "zwfel");

}
