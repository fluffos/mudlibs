// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Stollen");
  SetProp( P_INT_LONG,
	"Du stehst in einem breiten Stollen, der von Norden nach Sueden "
	"fuehrt. Die Waende sehen grob behauen aus, als ob hier geschuerft "
	"wurde. Eine Treppe fuehrt hier nach oben zurueck in die "
	"Zwergenfeste." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"stollen"}), 
            "Du bist in einem breiten Stollen. Er fuehrt nach Norden und "
	    "nach Sueden.");

  AddDetail( ({"norden"}),
	    "Nach Norden fuehrt der Stollen weiter.");
  
  AddDetail( ({"sueden"}), 
            "Nach Sueden kannst Du auch gehen.");

  AddDetail( ({"wand","waende","waenden"}),
	    "An den Waenden haengen Fackeln und die Spuren des Abbaus von "
	    "Metallen sind zu sehen.");
  
  AddDetail( ({"treppe","stelle"}), 
            "Eine steinerne Treppe fuehrt an dieser Stelle nach oben und damit "
	    "zurueck in die Zwergenfeste.");

  AddDetail( ({"zwergenfeste","ardhmir"}),
	    "Ueber die Treppe kommst Du zurueck in die Zwergenfeste von "
	    "Ardhmir.");
  
  AddDetail( ({"boden"}), 
            "Am Boden sind einige Felsbrocken zu sehen und ein paar Schienen, "
	    "die im Stollen entlang laufen.");

  AddDetail( ({"decke"}),
	    "Die Decke ist beeindruckend uninteressant. Ausser das eine Treppe "
	    "nach oben in die Zwergenfeste fuehrt.");
  
  AddDetail( ({"fackeln"}), 
            "Die Fackeln an den Waenden erhellen den Stollen.");

  AddDetail( ({"spuren","abbaus","abbau","hammereinschlaege"}),
	    "Du erkennst wo die Zwerge Metall abgebaut haben. Man kann "
	    "deutlich die Spuren der Hammereinschlaege sehen.");
  
  AddDetail( ({"metallen","metalle","metall","eisen","gold","silber"}), 
            "Es wird hier hauptsaechlich Eisen abgebaut. Nur ab und an findet "
	    "man ein wenig Gold und Silber.");

  AddDetail( ({"felsbrocken","seite"}),
	    "Einige Felsbrocken liegen am Boden. Sie wurden aber ordentlich "
	    "zur Seite geraeumt, damit sie nicht auf den Schienen liegen.");
  
  AddDetail( ({"schienen"}), 
            "Die Schienen fuehren von Norden nach Sueden und werden von den "
	    "Zwergen fuer ihre Loren benutzt um das abgebaute Metall "
	    "abzutransportieren.");

  AddDetail( ({"loren","stollenwagen","lore"}),
	    "Als Loren werden auch die Stollenwagen bezeichnet. Moment ist "
	    "keine Lore da.");
  
  AddDetail( ({"zwerge","zwergen"}), 
            "Die Zwerge bauen hier in den Stollen Metall ab.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig nach Rauch.");  
 
  AddSmell( ({"rauch","fackeln"}),
	   "Der Rauch kommt von den Fackeln.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Haemmern.");

  AddSound( ({"haemmern"}),
	   "Das Haemmern kommt von den Zwergen, die hier arbeiten.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "zwfest6");
AddExit("oben", ROOM "zwfe10");
AddExit("norden", ROOM "zwfest4");
}
