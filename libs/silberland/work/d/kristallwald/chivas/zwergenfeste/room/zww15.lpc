// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, " Auf einer Waldlichtung");
  SetProp( P_INT_LONG,
	"Du stehst mitten in dem kleinen Fluss, der aus dem See fliesst und "
        "zwischen den Baeumen des Waldes im Westen verschwindet. Der Fluss ist "
        "nicht sehr tief, so dass keine Gefahr droht an dieser Stelle zu "
        "ertrinken. Das Wasser ist klar und man kann die grossen und kleinen "
        "Steine auf dem Grund des Flusses erkennen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1);

//-----Details Anfang-----
  
  AddDetail( ({"fluss","flusses","bach"}), 
            "Der Fluss ist eher ein breiter Bach, der aus dem See kommt und "
            "zwischen den Baeumen verschwindet.");

  AddDetail( ({"see","osten","mittelpunkt"}),
	    "Der See liegt ruhig im Osten. Der Fluss in dem Du stehst kommt "
            "aus dem See.");

  AddDetail( ({"baeume","baeumen"}),
	    "Grosse Baeume umranden die Lichtung. Der Fluss in dem Du stehst, "
            "verschwindet zwischen ihnen im Westen im Wald.");

  AddDetail( ({"wald","waldes","westen"}),
	    "Der dichte Wald umrundet die gesamte Lichtung.");
  
  AddDetail( ({"gefahr","stelle","angst"}),
	    "Du brauchst keine Angst zu haben. Der Fluss ist viel zu flach "
            "um zu ertrinken.");

  AddDetail( ({"wasser"}), 
            "Das Wasser ist klar und Du kannst den Grund und auch ein paar "
            "Fische sehen.");

  AddDetail( ({"steine","steinen"}),
	    "Grosse und kleine Steine sind am Grund zu sehen. An einigen "
            "Steinen haften Algen.");

  AddDetail( ({"grund","boden"}),
	    "Durch das klare Wasser kann man sehr gut den Boden sehen. Viele "
            "Steine und auch ein paar Algen sind zu sehen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ueber Dir ist herrlich blau.");
  
  AddDetail( ({"lichtung"}),
	    "Auch der Fluss gehoert zu einer grossen Lichtung, dessen "
            "Mittelpunkt der See ist. Ansonsten umschliesst eine grosse Wiese "
            "den See.");

  AddDetail( ({"fische"}), 
            "Kleine silberne Fische schwimmen gegen die Stroemung. Es scheinen "
            "kleine Forellen zu sein.");

  AddDetail( ({"algen"}),
	    "Die Algen sind dunkelgruen und haften an den Steinen. Sie "
            "bewegen sich traege in der Stroemung des Flusses.");

  AddDetail( ({"wiese","norden","sueden"}),
	    "Im Norden und Sueden siehst Du die Wiese. Auf ihr wachsen viele "
            "Blumen und Gras.");

  AddDetail( ({"stroemung"}),
	    "Die Stroemung ist nicht sehr stark.");
  
  AddDetail( ({"forellen"}),
	    "Die kleine Forellen schwimmen gegen die Stroemung. Du brauchst "
            "Dir aber keine Gedanken zu machen eine zu fangen, sie sind viel "
            "zu flink fuer Dich.");

  AddDetail( ({"blumen"}), 
            "Um genau zu sehen, was fuer Blumen es sind, musst Du schon naeher "            "ran gehen.");

  AddDetail( ({"gras"}),
	    "Das Gras auf der Wiese ist schoen gruen.");

  AddDetail( ({"gedanken"}),
	    "Du machst Dir ja sowieso recht selten Gedanken, wieso solltest Du "
            "jetzt damit anfangen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Die Luft ist herrlich klar.");  
 
  AddSmell( ({"luft"}),
	   "Du atmest tief ein und fuehlst Dich wohl.");

  AddSound(DEFAULT_SOUND, "Der Fluss plaetschert leise vor sich hin.");

  AddSound( ({"fluss"}),
	   "*plaetscher*");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "zww17");
AddExit("sueden", ROOM "zww16");

}
