// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl=1;

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer kleinen Lichtung");
  SetProp( P_INT_LONG,
	"Die kleine Lichtung auf der Du stehst ist eigentlich eine Art Platz, "
        "der vor einem riesigen Tor angelegt wurde. Das Tor ist der Zugang "
        "zur Zwergenfeste von Ardhmir. Das schwere steinernde Tor ist mit "
        "lauter Runen und Symbolen ueberzogen. Das Tor ist momentan geoeffnet "
	"und Du kannst die Zwergenfeste betreten." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"lichtung"}), 
            "Die Lichtung ist ein grosser kuenstlich angelegter Platz. Die "
            "Baeume die hier gestanden haben wurden vor Jahren gefaellt um "
            "hier vor der Behausung der Zwerge Handel zu treiben.");

  AddDetail( ({"art","platz"}),
	    "Auf dem Platz wird normalerweise reger Handel getrieben. Der "
	    "Handel ist anscheinend schon vorbei. Du solltest frueher "
	    "aufstehen um hier zu feilschen.");

  AddDetail( ({"tor","zugang"}),
	    "Das Tor zur Zwergenfeste ist offen und Du kannst in die "
	    "Zwergenfeste gehen. Es ist mit "
            "lauter Runen und Symbolen versehen.");

  AddDetail( ({"zwergenfeste","feste","ardhmir","innere"}),
	    "Hinter dem grossen Tor liegt die Zwergenfeste von Ardhmir. Du "
	    "kannst die Zwergenfeste betreten, da das Tor offen ist.");
  
  AddDetail( ({"runen"}),
	    "Die Runen scheinen verschiedene Zauber zu beinhalten. Ein "
            "Eindringen mit Gewalt wird kaum moeglich sein.");

  AddDetail( ({"symbole","symbolen"}), 
            "Die Symbole am Tor sehen wertvoll aus. Es sieht so aus, als ob "
            "sie aus Mithril gegossen sind.");

  AddDetail( ({"zauberformeln","formel","formeln","zauberformel"}),
	    "Die Zauberformel um das Tor zu oeffnen oder zu verschliessen "
	    "haben nur die Zwerge oder auserwaehlte Magier.");

  AddDetail( ({"handel","handeln"}),
	    "Der Platz ist ideal zum Handeln. Leider ist heute kein Markttag.");

  AddDetail( ({"behausung"}),
	    "Hinter dem steinernden Tor ist die Behausung der Zwerge, die "
            "sonst hier auf dem Platz Handel treiben.");
  
  AddDetail( ({"zwerge","zwergen"}),
	    "Die Zwerge sind wohl alle in der Feste. Um welche zu sehen, musst "
	    "Du schon in die Zwergenfeste gehen oder sogar bis nach Felonia.");

  AddDetail( ({"baeume","rand"}), 
            "Grosse Baeume stehen noch am Rand der Lichtung. Ansonsten wurden "
            "die Baeume von den Zwergen abgeholzt um einen grossen Platz zum "
            "Handeln zu haben. Ein Baum faellt Dir besonders auf.");

  AddDetail( ({"jahren","jahre"}),
	    "Es ist schon lange her.");

  AddDetail( ({"felonia"}),
	    "In Felonia leben viele Zwerge.");

  AddDetail( ({"markttag","zeitpunkt"}),
	    "Du musst zu einem anderen Zeitpunkt wieder kommen.");
  
  AddDetail( ({"magier"}),
	    "Du bist keiner!");

  AddDetail( ({"gewalt","eindringen","zauber","moeglichkeit"}), 
            "Es gibt keine Moeglichkeit in die Feste mit Gewalt einzudringen, "
	    "da jedoch das Tor offen ist, brauchst Du sie auch nicht.");

  AddDetail( ({"mithril"}),
	    "Mithril ist sehr selten und besonders kostbar.");

  AddDetail( ({"himmel","teil"}),
	    "Du stehst leider im Schatten der grossen Felswand um den Himmel "
            "komplett zu sehen. Der Teil, den Du sehen kannst, ist blau.");

  AddDetail( ({"sonne"}), 
            "Da Du im Schatten stehst, kannst Du auch keine Sonne sehen.");

  AddDetail( ({"schatten"}),
	    "Die Felswand wirft einen langen Schatten.");
  
  AddDetail( ({"felswand","wand"}),
	    "Die Felswand reicht beinahe senkrecht nach oben. Am Ende der "
            "Felswand ist die Hochebene von Gorthad.");

  AddDetail( ({"ende","hochebene","gorthad"}), 
            "Um auf die Hochebene zu kommen, musst Du einen anderen Weg "
            "waehlen.");

  AddDetail( ({"weg","westen"}),
	    "Ein Weg fuehrt von der Lichtung nach Westen herunter oder ein "
	    "anderer in die Zwergenfeste.");

  AddDetail( ({"boden"}),
	    "Am Boden waechst Gras. An ein paar Stellen kann man auch die "
            "Baumstuempfe der gefaellten Baeume sehen.");

  AddDetail( ({"gras","tagen"}),
	    "Das Gras ist kurz und nieder getrampelt. An Tagen wo man hier "
            "Handel treiben kann, sind sicher viele Haendler hier und laufen "
            "herum.");
  
  AddDetail( ({"haendler"}),
	    "Momentan ist kein Haendler hier.");

  AddDetail( ({"baumstuempfe","stuempfe","stellen","rest"}), 
            "Die Baumstuempfe stehen einfach nur so rum. Der Rest fehlt leider.");

  AddDetail( ({"baum"}),
	    "Es ist ein schoener Apfelbaum.");

  AddSpecialDetail( ({ "apfelbaum","apfelbaumes","pfluecken" }), "apfelbaum" );
  
  AddSpecialDetail( ({ "stamm" }), "stamm" );
  
  AddSpecialDetail( ({ "leiter" }), "leiter" );

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Wald und Gras.");  
 
  AddSmell( ({"gras"}),
	   "Es riecht grasig.");

  AddSmell( ({"wald"}),
	   "Es riecht waldig.");
  
  
  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel im Wald zwitschern.");

  AddSound( ({"voegel","wald"}),
	   "Die Voegeln trillern ihre Lieder.");
  
  AddSound( ({"lieder"}),
	   "Die Lieder klingen sehr schoen und wirken beruhigend.");

//-----Details Ende-----
AddItem(NPC "wache", REFRESH_DESTRUCT);
AddItem(NPC "wache", REFRESH_DESTRUCT);

AddExit("westen", ROOM "zwfe5");
AddExit("osten", ROOM "zwfe7");

AddCmd( ({"nimm" }), "nehmen" );

}
void reset()
	
{
  ::reset();
  anzahl=1; 
}

int nehmen(string str)
{
  object leiter;
  notify_fail( "Was moechtest Du nehmen?\n" );
  if ( member( ({ "leiter"}), str ) != -1 ) 

   {
     if( anzahl < 1 )
     {
        write("Du willst eine Leiter nehmen, wo keine ist.\n");
        say(sprintf("%s ist leicht paranoid.\n", TP->Name(WER)));
        return -1;
     }
      if ( present("leiter",TP) )
      {
      write("Da Du bereits eine Leiter hast, solltest Du Dich auch damit "
	    "zu Frieden geben.\n" );
      say(sprintf("%s ist sehr gierig.\n", TP->Name(WER)));
      return -1;
      }
      else
      {
        {leiter = clone_object(OBJ "leiter");
        if ( ME_TOO_HEAVY == leiter->move(TP,M_GET|M_SILENT) )
 
          {
          write(
          "Die Leiter wuerde Dir zu schwer werden.\n" );
          say(BS(sprintf("%s will eine Leiter nehmen, ist dafuer aber viel "
			 "zu schwach.\n", TP->Name(WER))));
          leiter -> remove();
          return 1;
          }
          else
          {
          write("Du nimmst Dir die Leiter vom Apfelbaum und steckst sie "
	        "ein.\n");
          say(sprintf("%s nimmt eine Leiter.\n",
          TP->Name(WER)));
          anzahl--;
          return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}
string apfelbaum(string key)
{
    if ( anzahl )
    {
    return(BS("Leider sind keine Aepfel mehr am Baum. Anscheinend wurden sie "
	    "erst vor kurzem gepflueckt. Eine Leiter lehnt noch am Stamm."));
    }
    else
    {
    return(BS("Leider sind keine Aepfel mehr am Baum. Anscheinend wurden sie "
	    "erst vor kurzem gepflueckt. Ausserdem ist auch die Leiter nicht "
	    "mehr da, die ansonsten hier zum Pfluecken steht."));
    }
}
string stamm(string key)
{
    if ( anzahl )
    {
    return(BS("Der Stamm des Apfelbaumes ist sehr dick und eine Leiter lehnt "
	    "am Stamm."));
    }
    else
    {
    return(BS("Der Stamm ist sehr dick und uninteressant, weil die Leiter "
	      "fehlt, die Du hier erwartet hast. Anscheinend war schon wer "
	      "schneller als Du."));
    }
}
string leiter(string key)
{
    if ( anzahl )
    {
    return(BS("Falls Du mal eine brauchst, jetzt weisst Du wo eine zu finden "
	    "ist."));
    }
    else
    {
    return(BS("Leider ist jetzt keine da. Da war wohl wer schneller als Du."));
    }
}
