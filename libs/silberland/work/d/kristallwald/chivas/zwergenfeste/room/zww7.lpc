// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, " Auf einer Waldlichtung");
  SetProp( P_INT_LONG,
	"Du stehst auf einer Bruecke, die ueber einen Fluss fuehrt, der sich "
        "in den Waldsee im Westen ergiesst. Die dicken Balken der Bruecke sind "
        "mit Moos bedeckt und das Gelaender ist teilweise nicht mehr "
        "vorhanden. Die Bruecke wurde anscheinend seit Jahren nicht mehr "
        "ausgebessert und repariert." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1);

//-----Details Anfang-----
  
  AddDetail( ({"bruecke"}), 
            "Die Bruecke ist in einem miserabelen Zustand. Die Balken am Boden "
	    "sind mit Moos bewachsen und sehr rutschig und das Gelaender ist "
	    "nur noch teilweise vorhanden. Man muss wirklich aufpassen, dass "
	    "man nicht in den Fluss faellt.");

  AddDetail( ({"fluss","flusses"}),
	    "Der Fluss fliesst schnell unter der Bruecke durch und muendet in "
	    "dem Waldsee im Westen. Du kannst einige grosse Steine im klaren "
	    "Wasser erkennen. Im Osten verschwindet der Fluss zwischen den "
	    "Baeumen des Waldes.");

  AddDetail( ({"waldsee","see","westen"}),
	    "Im Westen liegt der schoene grosse Waldsee, der von einer "
	    "schoenen Wiese umrundet wird. Der Fluss fliesst direkt in den "
	    "See und verliert sich dann.");

  AddDetail( ({"balken"}),
	    "Die Balken sind mit Moos bewachsen und dadurch sehr rutschig. "
	    "Zwischen den Balken gibt es breite Spalten.");
  
  AddDetail( ({"moos"}),
	    "Das Moos ist saftig gruen und verdammt rutschig. Pass auf, dass "
	    "Du nicht 'absichtlich' ausrutschst.");

  AddDetail( ({"gelaender"}), 
            "Das Gelaender hat auch schon bessere Zeiten gesehen. Es ist nur "
	    "noch teilweise vorhanden. An ein paar Stellen kann man noch ein "
	    "paar Verzierungen erkennen, obwohl sie schon sehr verblasst "
	    "sind.");

  AddDetail( ({"jahren","jahre","zeiten"}),
	    "Es ist sehr lange her.");

  AddDetail( ({"zustand"}),
	    "Die Bruecke wurde schon seit Jahren nicht mehr repariert. Ihr "
	    "Zustand ist erbaermlich.");

  AddDetail( ({"steine"}),
	    "Grosse Steine, die vom staendigen Strom des Wassers rund "
	    "geschliffen sind, liegen im Fluss und das Wasser plaetschert "
	    "leise darueber.");
  
  AddDetail( ({"baeume","baeumen","rand"}),
	    "Du stehst am Rand der Lichtung und im Westen ist der tiefe Wald.");

  AddDetail( ({"wald","waldes","osten"}), 
            "Der Wald ist im Osten von Dir.");

  AddDetail( ({"wiese"}),
	    "Eine Wiese mit Blumen und Gras umrundet den gesamten Waldsee, bis "
	    "auf den Teil, wo der Weg von Norden nach Sueden verlaeuft.");

  AddDetail( ({"spalten"}),
	    "Durch die breiten Spalten, zwischen den Balken, erkennst Du den "
	    "darunter fliessenden Fluss.");

  AddDetail( ({"stellen","verzierungen"}),
	    "Die Verzierungen waren einmal schoen und haben anscheinend den "
	    "See und den Fluss gezeigt. Jetzt sind sie schon sehr verblasst "
	    "und man kann sie nur noch erahnen.");
  
  AddDetail( ({"strom"}),
	    "Es ist schon viel Wasser den Fluss entlang geflossen.");

  AddDetail( ({"lichtung"}), 
            "Die Lichtung breitet sich im Norden, Sueden und Westen vor Dir "
	    "aus.");

  AddDetail( ({"norden","sueden"}),
	    "Im Norden und Sueden siehst Du den Weg, der sich am Rand der "
	    "Lichtung entlang schlaengelt.");

  AddDetail( ({"weg","teil"}),
	    "Der Weg fuehrt Dich durch den Wald. Du bist im schon eine Weile "
	    "gefolgt.");

  AddDetail( ({"weile","ding"}),
	    "Gut Ding will Weile haben.");
  
  AddDetail( ({"blumen","rot","gelb","blau"}),
	    "Die Blumen bluehen in den unterschiedlichsten Farben. Um mehr zu "
	    "erkennen, musst Du schon naeher ran gehen.");

  AddDetail( ({"gras","gruen"}), 
            "Das Gras auf der Wiese ist nicht besonders hoch und ist schoen "
	    "gruen.");

  AddDetail( ({"farben"}),
	    "Du siehst Rot, Gelb, Blau, Gruen und noch andere Farben.");

  AddDetail( ({"wasser","wassers"}),
	    "Das Wasser ist ganz klar und man kann den Grund des Flusses "
	    "sehen.");

  AddDetail( ({"grund"}),
	    "Am Grund des Flusses erkennst Du einge Wasserpflanzen und grosse "
	    "Steine.");
  
  AddDetail( ({"wasserpflanzen"}),
	    "Du siehst ein paar Algen, die sich an den Steinen festgesetzt "
	    "haben. Die anderen Wasserpflanzen kennst Du nicht.");

  AddDetail( ({"pflanzen"}), 
            "Es gibt hier sehr viele Pflanzen. Du siehst Baeume, Blumen, Gras "
	    "und viele andere.");

  AddDetail( ({"boden"}),
	    "Du stehst auf grossen mit Moos bewachsenen Balken. Darunter "
	    "kannst Du den Fluss sehen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau und die Sonne waermt Dich.");

  AddDetail( ({"algen"}),
	    "Die Algen sind dunkelgruen und bewegen sich leicht in der "
	    "Stroemung des Flusses.");
  
  AddDetail( ({"stroemung"}),
	    "Die Stroemung des Flusses ist zwar schnell aber nicht sehr "
	    "stark.");
  
  AddDetail( ({"sonne"}),
	    "Ein paar Voegel fliegen vor der Sonne am Himmel. Du kannst nur "
	    "ihre schwarzen Umrisse sehen, da Dich die Sonne blendet und Du "
	    "nicht zu lange direkt in sie sehen solltest.");
  
  AddDetail( ({"umrisse","voegel"}),
	    "Du kannst nicht genau erkennen, was fuer Voegel es sind. Sie "
	    "fliegen viel zu hoch und direkt vor der Sonne.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen","duft"}),
	   "Die Blumen auf der Wiese haben einen suesslichen Duft, den Du "
	   "bis hier her riechen kannst.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Wasser ueber die Steine plaetschern.");

  AddSound( ({"wasser","steine","geraeusch"}),
	   "Das Geraeusch des plaetschernden Wassers wirkt sehr beruhigend.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "zww8");
AddExit("sueden", ROOM "zww6");

AddCmd( ({"rutsch", "rutsche" }), "rutschen" );

}
int rutschen(string str)
{
   notify_fail("Was willst Du absichtlich tun?\n");
   if ( member( ({ "absichtlich aus" }),str) != -1) 
  {
    write(BS ( "Du rutschst ploetzlich aus und probierst Dich noch am "
               "Gelaender festzuhalten, was jedoch nachgibt. Du landest im "
	       "Fluss und schwimmst schlecht gelaunt ans Ufer. Ein "
	       "unsichtbarer Magier lacht Dich aus.\n"));
      TP->move( ROOM "zww6", M_GO, 
      "aus und faellt in den Fluss", "rutscht", 
      "kommt schimpfend aus dem Wasser gekrochen");
    return 1;
  }
}

