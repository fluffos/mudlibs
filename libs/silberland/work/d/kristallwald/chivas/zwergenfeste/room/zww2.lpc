// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Wald zeigt sich in seiner ganzen Pracht. Die grossen alten "
        "Baeume und einige Buesche geben dem Weg die Richtung vor. Im Osten "
        "kann man durch die Baeume den Fluss sehen, den man im Sueden ueber "
        "eine Bruecke ueberqueren kann." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1);
  
//-----Details Anfang-----
  
  AddDetail( ({"wald"}), 
            "Der Wald ist hier wunderschoen. Viele Lichtstrahlen fallen "
            "golden auf den Waldboden.");

  AddDetail( ({"pracht"}),
	    "Der Wald zeigt sich in seiner vollen Pracht. Du erkennst ueberall "
            "grosse alte Baeume.");

  AddDetail( ({"baeume"}),
	    "Die grossen alten Baeume saeumen den Weg. Zwischen den Baeumen im "
            "Osten kannst Du einen Fluss sehen.");

  AddDetail( ({"buesche"}),
	    "Grosse dichte Buesche stehen zwischen den Baeumen und hindern "
            "Dich daran einfach den Weg zu verlassen.");
  
  AddDetail( ({"weg","richtung"}),
	    "Der Weg fuehrt nach Sueden oder nach Nordosten.");

  AddDetail( ({"osten","fluss"}), 
            "Im Osten ist ein Fluss zwischen den Baeumen zu sehen. Man kann "
            "ihn im Sueden ueber eine Bruecke ueberqueren.");

  AddDetail( ({"sueden","bruecke"}),
	    "Im Sueden ist eine stabile Bruecke zu erkennen, die ueber einen "
            "Fluss fuehrt.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist ein wenig durch das lichte Blaetterdach zu sehen. "
            "Er ist hellblau.");

  AddDetail( ({"boden","waldboden"}),
	    "Der Boden ist mit Blaettern und ein paar Zweigen bedeckt.");
  
  AddDetail( ({"lichtstrahlen","strahlen","farbe"}),
	    "Viele Lichtstrahlen fallen auf den Boden. Sie haben eine goldene "
            "Farbe.");

  AddDetail( ({"blaetterdach","dach"}), 
            "Das Blaetterdach ist nicht sehr dicht.");

  AddDetail( ({"blaettern","blaetter"}),
	    "Einige Blaetter liegen am Boden. Es sind natuerlich auch viele "
            "Blaetter an den Baeumen zu sehen.");

  AddDetail( ({"zweigen","zweige"}),
	    "Einige Zweige sind von den Baeumen herunter gefallen und sind "
            "auf dem Boden gelandet.");

  AddDetail( ({"laub"}),
	    "Viel Laub liegt am Boden.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Wald.");  
 
  AddSmell( ({"wald"}),
	   "Es duftet sehr waldig.");

  AddSound(DEFAULT_SOUND, "Die Blaetter rascheln ein wenig.");

  AddSound( ({"blaetter","rascheln"}),
	   "Ein Rascheln entsteht, wenn Du ueber das Laub am Boden gehst.");
  
//-----Details Ende-----
AddItem( "/d/huegelland/feyaria/weg/npc/huegelkatze", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "zww2",
          P_MNPC_AREA:({ROOM "zww2","zww3","zww1"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("nordosten", ROOM "zww3");
AddExit("sueden", ROOM "zww1");

}
