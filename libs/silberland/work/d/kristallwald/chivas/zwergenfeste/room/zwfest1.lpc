// von Chivas

inherit "/d/gebirge/angrox/room/std_bergwerk_new";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int eisenzahl;

void create()
	
{
  ::create();

  eisenzahl=3;

  SetProp( P_INT_SHORT, "In einem Stollen");
  SetProp( P_INT_LONG,
	"Der Stollen fuehrt hier nicht weiter nach Norden. Die Zwerge sind "
	"gerade dabei hier die Metalle der Hochebene abzubauen. An der Wand "
	"haengen ein paar Fackeln, in dessen Schein man sehr gut schuerfen "
	"kann." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"stollen","ende"}), 
            "Der Stollen ist hier zu Ende. Es geht nicht weiter nach Norden.");

  AddDetail( ({"norden"}),
	    "Im Norden geht es nicht weiter, Du kannst nur noch zurueck "
	    "gehen.");
  
  AddDetail( ({"zwerge"}), 
            "Die Zwerge arbeiten hier in den Stollen und bauen die Metalle "
	    "ab.");

  AddDetail( ({"metalle","metall"}),
	    "Hier in den Stollen wird hauptsaechlich Eisen abgebaut, aber ab "
	    "und zu findet man auch Gold und Silber.");
  
  AddDetail( ({"hochebene","gorthad"}), 
            "Die Hochebene von Gorthad ist weit ueber Dir.");

  AddDetail( ({"wand","waende","waenden"}),
	    "Die Waende sind grob behauen und ein paar Fackeln haengen an "
	    "ihnen, die den Stollen erhellen.");
  
  AddDetail( ({"fackeln"}), 
            "Die Fackeln brennen vor sich hin und erhellen den Stollen.");

  AddDetail( ({"schein","licht"}),
	    "Der Schein der Fackeln spendet genug Licht.");
  
  AddDetail( ({"boden"}), 
            "Am Boden liegen viele Steine und Felsbrocken, die bei der Arbeit "
	    "im Stollen von den Waenden abgebrochen sind.");

  AddDetail( ({"decke"}),
	    "Die Decke ist nur grob behauen.");
  
  AddDetail( ({"eisen"}), 
            "Man findet viel Eisen in den Stollen unter der Zwergenfeste.");

  AddDetail( ({"gold","silber"}),
	    "Gold und Silber ist hier in den Stollen nicht sehr haeufig zu "
	    "finden.");
  
  AddDetail( ({"arbeit","arbeiten"}), 
            "Die Arbeit in den Stollen ist sehr schwer und nicht fuer "
	    "jedermann das Richtige.");

  AddDetail( ({"steine"}),
	    "Grosse und kleine Steine liegen am Boden verstreut.");
  
  AddDetail( ({"felsbrocken","brocken"}), 
            "Die Felsbrocken am Boden sind sicher von den Waenden abgebrochen "
	    "als hier am Stollen gearbeitet wurde.");

  AddDetail( ({"zwergenfeste","feste","ardhmir"}),
	    "Die Zwergenfeste von Ardhmir befindet sich oberhalb der Stollen "
	    "in denen Du Dich gerade befindest.");
  
  AddDetail( ({"richtige"}), 
            "Du bist nicht der Richtige fuer Arbeiten hier im Stollen.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht stickig in den Stollen.");  

  AddSound(DEFAULT_SOUND, "Du hoerst das Haemmern der Arbeiter in den "
		          "Stollen.");

  AddSound( ({"haemmern","arbeiter"}),
	   "Die Arbeiter haemmern in den Stollen und bauen das Metall ab.");
  
//-----Details Ende-----
AddItem(NPC "zwerga", REFRESH_DESTRUCT);
  
AddExit("suedosten", ROOM "zwfest4");

//AddCmd( ({"bau","baue" }), "bauen" );

}
