// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Zwergenfeste von Ardhmir");
  SetProp( P_INT_LONG,
	"Die laengliche Halle fuehrt von Norden nach Sueden. An den Waenden "
        "sind viele Verzierungen zu sehen und die gluehenden Steine spenden "
        "ausreichend Licht. Im Westen ist eine grosse Oeffnung zu sehen, "
        "ueber der ein grosses Schild haengt. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"halle","norden","sueden"}), 
            "Du bist nun in einer laenglichen Halle angelangt, die sich von "
	    "Sueden nach Norden erstreckt.");

  AddDetail( ({"waende","waenden","wand"}),
	    "An den Waenden haengen gluehende Barinsteine, die die Halle "
	    "erhellen. Ausserdem erkennst Du die hier ueblichen Verzierungen, "
	    "die die hohe Kunst der Zwerge zeigen. In der westlichen Wand ist "
	    "eine grosse Oeffnung zu sehen, ueber der ein Schild haengt.");

  AddDetail( ({"verzierungen"}),
	    "Es sind genauer gesagt verschiedene grosse Steinmetzarbeiten, die "
	    "in die Wand gemeisselt wurden.");

  AddDetail( ({"steine","barinsteine"}),
	    "Die Barinsteine stecken in ihren goldenen Halterungen und "
	    "erhellen die Halle in einem warmen gelben Licht.");
  
  AddDetail( ({"westen","oeffnung"}),
	    "Im Westen ist eine grosse Oeffnung, die aussieht wie ein "
	    "riesiger Torbogen.");
  
  AddDetail( ({"schild"}), 
            "Das grosse Schild haengt ueber der Oeffnung im Westen. Du kannst "
	    "es lesen.");

  AddDetail( ({"decke"}),
	    "Die Decke ist gut zu erkennen, jedoch ist an ihr nichts "
            "besonderes zu erkennen.");

  AddDetail( ({"boden"}),
	    "Der Boden ist eben und sieht fast aus wie Marmor.");

  AddDetail( ({"marmor"}),
	    "Es sieht nur so aus wie Marmor. Er ist sehr glatt und sauber "
            "geschliffen.");

  AddDetail( ({"kunst","bearbeitung","steinen"}),
	    "Die Kunst der Zwerge ist bei der Bearbeitung von Steinen "
	    "unuebertroffen.");
  
  AddDetail( ({"zwerge"}),
	    "Viele Zwerge leben hier in der Zwergenfeste.");

  AddDetail( ({"steinmetzarbeiten"}), 
            "Du erkennst fuenf verschiedene Reliefs.");

  AddDetail( ({"zwergenfeste","feste","ardhmir"}),
	    "Du bist in der Zwergenfeste von Ardhmir.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen fuer die Barinsteine sind aus Gold und beweisen "
            "den Reichtum der Feste.");

  AddDetail( ({"reichtum"}),
	    "Reichtum ist nicht alles. Du bist doch auch gluecklich und hast "
            "nicht viel.");

  AddDetail( ({"gold"}),
	    "Das Gold der Halterungen glaenzt.");

  AddDetail( ({"gaststaette"}),
	    "Im Westen ist eine Gaststaette.");

  AddDetail( ({"licht"}),
	    "Die Barinsteine erhellen die laengliche Halle.");

  AddDetail( ({"torbogen","bogen"}),
	    "Die Oeffnung ist eher ein grosser Torbogen, auf dem verschiedene "
            "Schriftzeichen zu sehen sind.");

  AddDetail( ({"schriftzeichen","zwergensprache"}),
	    "Die Schriftzeichen sind in einer alten Zwergensprache "
            "geschrieben. Selbst die Zwerge koennen sie nicht mehr lesen.");
  
  AddDetail( ({"relief","reliefs"}),
	    "Es gibt fuenf verschiedene Reliefs. Welches willst Du Dir "
	    "ansehen?");

