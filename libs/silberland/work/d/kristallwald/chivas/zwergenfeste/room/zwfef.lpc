#include "../def.h"

inherit "std/room"; 

#define AN 1
#define AUS 0

int feuer;

void create()
{
  ::create();

  feuer = AN;

  SetProp(P_INT_SHORT, "In der Schmiede von Ardhmir");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1); 
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 50, ENV_TERRAIN: TT_CAVE]) );

//-----Details Anfang-----

  AddDetail( ({"boden"}) ,
    "Der Boden ist voller Russ. In einer Ecke liegt ein grosser Haufen Kohle, die der Schmied anscheinend fuer das Feuer benoetigt.");

  AddDetail( ({"russ"}) ,
    "Der Russ ist schwarz.");

  AddDetail( ({"decke"}) ,
    "Die Decke ist mit Russ vom Feuer bedeckt.");

  AddDetail( ({"mitte"}) ,
    "In der Mitte der Schmiede steht eine grosse Esse.");

  AddDetail( ({"schmiede"}) ,
    QueryProp(P_INT_LONG));

  AddDetail( ({"waende","wand","waenden"}), 
            "An den Waenden haengen verschiedene Teile von Ruestungen, die "
	    "noch nicht fertig sind. Anscheinend arbeitet der Schmied an "
	    "mehreren Ruestungen gleichzeitig.");

  AddDetail( ({"zwergenfeste","ardhmir"}),
	    "Die Schmiede befindet sich in der Zwergenfeste von Ardhmir.");

  AddDetail( ({"teile","ruestungen"}),
	    "Du siehst Panzer, Armschienen und vieles mehr. Aber auch einige "
	    "Waffen haengen an den Waenden.");

  AddDetail( ({"werkzeuge","meister","fach","fachs"}), 
            "Ueberall in der Schmiede liegen Werkzeuge umher. Der Schmied ist "
	    "sicher ein Meister seines Fachs, aber auch unglaublich "
	    "unordentlich.");

  AddDetail( ({"waffen"}),
	    "Die noch nicht fertigen Waffen sehen jetzt schon gefaehrlich "
	    "und scharf aus.");

  AddDetail( ({"amboss"}),
	    "Der Amboss ist riesig und steht er steht gleich neben der Esse "
	    "um das Metall zu bearbeiten.");

  AddDetail( ({"panzer","armschienen","meisterstuecke"}), 
            "Die Panzer und Armschienen und andere Teile sehen sehr gut "
	    "verarbeitet aus. Sie sind teilweise kunstvoll mit Intarsien "
	    "geschmueckt. Es sind wirklich Meisterstuecke, obwohl sie noch "
	    "nicht ganz fertig sind.");

  AddDetail( ({"intarsien","gold","silber"}),
	    "Die Intarsien sind mit Gold und Silber auf den Ruestungen "
	    "angebracht.");

  AddDetail( ({"haufen","kohle","ecke"}),
	    "Mit der Kohle wird das Feuer in der Esse geschuert.");

  AddDetail( ({"zwerge"}), 
            "Die Zwerge bestellen hier ihre beruehmten Ruestungen und Waffen.");

  AddDetail( ({"schmied","borolt"}),
	    "Der Schmied hier heisst Borolt.");

  AddDetail( ({"hitze"}),
	    "Wenn die Esse angefeuert ist, herrscht in der Schmiede eine "
	    "grosse Hitze.");

  AddDetail( ({"nase"}),
	    "Du hast eine und sie wird laenger wenn Du luegst.");

  AddDetail( ({"glut","esse"}),
	    "Die Glut glueht rot in der Esse.");

  AddDetail( ({"flammen"}),
	    "Die Flammen lodern in der Esse.");

  AddDetail( ({"metall","eisen","bronze","metalle","bearbeiten"}),
	    "Hier werden viele Metalle verarbeitet. Eisen, Bronze und noch vieles mehr.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Rauch in der Schmiede.");  
 
  AddSmell( ({"rauch","nase"}),
	   "Der Rauch sticht in Deiner Nase.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Feuer knistern.");

  AddSound( ({"feuer","knistern"}),
	   "knister knister knister");

  AddSpecialDetail( ({"feuer","esse"}), "detail_feuer");

//-----Details Ende-----

  AddCmd( ({"loesche","loesch"})      , "cmd_loeschen");
  AddCmd( ({"zuend","zuende"})        , "cmd_zuenden");

  AddItem(NPC "borolt", REFRESH_DESTRUCT);

  AddExit("suedosten", ROOM "zwfe12");
}

string detail_feuer(string str)
{
  string s;

  if(feuer == AN)
  {
    s = "Hell lodern die Flammen in der Esse und verbreiten eine ziemliche "
        "Hitze. ";
  }
  else
  {
    s = "Nur dunkelrot glimmt die Glut in der Esse. ";
  }

  return BS(s);
}

int cmd_loeschen(string str)
{
  notify_fail("Was moechtest Du loeschen?\n"); 

  if(!str || str == "") return 0; 

  if(!(str == "feuer"         ||            
       str == "esse"          )) return 0;  

  if(feuer == AUS)
  {
    tell_object(TP,"Aber das Feuer ist doch schon aus!\n"); 

    return -1; 
  }

  tell_object(TP,"Du nimmst einen Eimer Wasser und loeschst das Feuer.\n");

  TO->Message(BS(TP->Name()+" nimmt einen Eimer Wasser und loescht das "
              "Feuer."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  feuer = AUS;
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );

  return 1; 
}

int cmd_zuenden(string str)
{

  notify_fail("Was moechtest Du anzuenden?\n");

  if(!str || str == "") return 0;
  if(!(str == "feuer"         ||
       str == "esse"          ||
       str == "feuer an"      ||
       str == "esse an"       )) return 0;

  if(feuer == AN)
  {
    tell_object(TP,"Aber das Feuer brennt doch schon!\n");

    return -1; 
  }

  tell_object(TP,"Du pustest in die Glut und zuendest das Feuer wieder an.\n");

  TO->Message(BS(TP->Name()+" pustet in die Glut und zuendet das Feuer "
              "wieder an."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  feuer = AN;
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 50, ENV_TERRAIN: TT_HOUSE]) );

  return 1;
}
string _query_int_long()
{
  string txt;

    if ( feuer == AN )
    {
      txt = "Du befindest Dich in der Schmiede von Ardhmir. In der Mitte "
	    "brennt ein grosses Feuer. An der Wand haengen alle moeglichen "
	    "Teile von Ruestungen, die anscheinend noch nicht fertig "
	    "geschmiedet sind. Ausserdem liegen ueberall die verschiedensten "
	    "Werkzeuge zum Schmieden herum. Neben dem Feuer steht ein "
	    "riesiger Amboss, auf dem der Schmied die Ruestungen und Waffen "
	    "der Zwerge schmiedet.";
    }
    else
    {
      txt = "Du befindest Dich in der Schmiede von Ardhmir. In der Mitte "
	    "brennt normalerweise ein grosses Feuer, dass jedoch momentan "
	    "geloescht ist. An der Wand haengen alle moeglichen "
	    "Teile von Ruestungen, die anscheinend noch nicht fertig "
	    "geschmiedet sind. Ausserdem liegen ueberall die verschiedensten "
	    "Werkzeuge zum Schmieden herum. Neben dem Feuer steht ein "
	    "riesiger Amboss, auf dem der Schmied die Ruestungen und Waffen "
	    "der Zwerge schmiedet.";
    }
  return BS(txt);
}

