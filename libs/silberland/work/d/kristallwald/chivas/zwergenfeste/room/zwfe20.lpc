// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Zwergenfeste von Ardhmir");
  SetProp( P_INT_LONG,
	"Der oestliche Teil der Halle zieht sich von Norden nach Sueden am "
	"Rand der Schlucht entlang. Die grossen Saeulen rings um Dich herum "
	"stuetzen die riesige Decke der Halle ueber Dir." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"teil","haelften"}), 
            "Du bist im oestlichen Teil der Halle, die durch die Schlucht in "
	    "zwei Haelften geteilt ist.");

  AddDetail( ({"halle"}),
	    "Die riesige zweite Halle von Ardhmir ist die groesste Halle, die "
	    "Du je gesehen hast.");

  AddDetail( ({"norden","sueden"}),
	    "Du kannst den oestlichen Teil der Halle nach Norden oder nach "
	    "Sueden durchschreiten.");

  AddDetail( ({"rand","schlucht"}),
	    "Die Schlucht zieht sich durch die gesamte Halle. Man kann sie nur "
	    "durch die Bruecken ganz im Norden und im Sueden ueberqueren.");
  
  AddDetail( ({"saeulen"}),
	    "Die maechtigen Saeulen der Halle stuetzen die Decke. An ihnen "
	    "grosse Barinsteine befestigt, die die Halle erhellen.");

  AddDetail( ({"decke"}), 
            "Die Decke ist weit ueber Dir.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit schwarzen Granitplatten ausgelegt.");

  AddDetail( ({"waende","waenden","wand"}),
	    "So richtig erkennen kannst Du nur die Ostwand, an der Du ein "
	    "grosses Relief erkennst.");

  AddDetail( ({"ardhmir","zwergenfeste"}),
	    "Du bist tief in die Zwergenfeste von Ardhmir vorgedrungen.");
  
  AddDetail( ({"bruecken","details"}),
	    "Du kannst die Bruecken zwar gut sehen, aber keine Details "
	    "erkennen. Da musst Du wohl naeher rangehen.");

  AddDetail( ({"barinsteine"}), 
            "Die Barinsteine erhellen die gesamte Halle.");

  AddDetail( ({"granitplatten","platten","granit"}),
	    "Die Granitplatten wurden von weit her in die Zwergenfeste "
	    "gebracht. Granit gibt es naemlich nicht unter der Hochebene von "
	    "Gorthad.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Die Zwergenfeste befindet sich unterhalb der Hochebene von "
	    "Gorthad.");

  AddDetail( ({"zwergenfeste","ardhmir"}),
	    "Du befindest Dich in der zweiten Halle der Zwergenfeste von "
	    "Ardhmir.");
  
  AddDetail( ({"relief","ostwand"}),
	    "Das riesige Relief zeigt eine Karte vom Silberland.");

  AddDetail( ({"silberland"}), 
            "Du bist im Silberland.");

  AddDetail( ({"karte"}),
	    "Die Karte zeigt sehr viele Details.");

  AddDetail( ({"details"}),
	    "Du siehst die grossen bekannten Orte, aber auch Gegenden, die "
	    "bisher nur ganz wenige Abenteurer besucht haben.");

  AddDetail( ({"orte","midas","tijara","derlim","roch","adan","roch adan"}),
	    "Du erkennst auf der Karte Orte wie Midas, Tijara, Derlim, Roch "
	    "Adan und noch einige mehr.");
  
  AddDetail( ({"gegenden","gebieten","gebiete"}),
	    "Du erkennst Gegenden, die sich noch viel weiter noerdlich von "
	    "Dir befinden. Diese Gegenden zaehlen momentan noch zu den "
	    "unerforschten Gebieten.");

  AddDetail( ({"hoehle"}), 
            "Du bist in einer Hoehle, obwohl es hier gar nicht so aussieht.");

  AddDetail( ({"zwerge"}),
	    "Einige Zwerge sind in der Halle zu sehen.");

  AddDetail( ({"belueftungssystem"}),
	    "Das Belueftungssystem ist sehr gut und hervorragend versteckt.");

  AddDetail( ({"abenteurer"}),
	    "Abenteurer wie Du.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach frischer Luft.");  
 
  AddSmell( ({"luft"}),
	   "Obwohl Du in einer Hoehle bist, ist die Luft herrlich frisch. "
	   "Das Belueftungssystem der Zwerge muss sehr gut sein.");

  AddSound(DEFAULT_SOUND, "Du hoerst viele Gespraeche in der grossen Halle.");

  AddSound( ({"gespraeche"}),
	   "Einige Zwerge stehen umher und unterhalten sich.");
  
  AddSound( ({"zwerge"}),
	   "Man belauscht keine anderen. Schaem Dich!");

//-----Details Ende-----
AddItem(NPC "zwergd", REFRESH_DESTRUCT);

AddExit("sueden", ROOM "zwfe21");
AddExit("norden", ROOM "zwfe19");

}
