// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Weg fuehrt immer weiter durch den dichten Wald. Das Unterholz "
        "an den Seiten des Weges ist so dicht durch verschiedene Straeucher "
        "und Buesche, so dass es fuer Dich keine andere Moeglichkeit gibt als "
        "dem Weg zu folgen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"weg","weges"}), 
            "Der Weg fuehrt weiter durch den dichten Wald. Es ist kein Ende in "
            "Sicht.");

  AddDetail( ({"wald"}),
	    "Du siehst den Wald vor lauter Baeumen nicht. Wo er wohl ist?");

  AddDetail( ({"unterholz","seiten"}),
	    "Das Unterholz ist sehr dicht. Es gibt nur den Weg.");

  AddDetail( ({"straeucher","straeuchern"}),
	    "Es wachsen leider keine Beeren an den Straeuchern.");
  
  AddDetail( ({"buesche"}),
	    "Es sind kleine unbedeutende Buesche. Sie sind nicht sehr "
            "interessant.");

  AddDetail( ({"moeglichkeit","moeglichkeiten"}), 
            "Es gibt meistens mehrere Moeglichkeiten, aber hier leider nicht.");

  AddDetail( ({"boden"}),
	    "Der Boden des Weges ist erdig mit ein paar kleinen Steinen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel steckt irgendwo hinter dem Blaetterdach. Ob er "
            "ueberhaupt noch da ist?");

  AddDetail( ({"ende","sicht"}),
	    "Obwohl Du durch die dichten Baeume auch nicht weit sehen kannst.");
  
  AddDetail( ({"baeume","baeumen"}),
	    "Die grossen Baeume grenzen direkt an den Weg.");

  AddDetail( ({"blaetterdach","dach"}), 
            "Das Blaetterdach ist sehr dicht.");

  AddDetail( ({"beeren"}),
	    "Es gibt hier leider keine Beeren.");

  AddDetail( ({"steinen","steine"}),
	    "Die Steine sind klein und rund und unglaublich uninteressant. Es "
            "ist schon beeindruckend, wie uninteressant sie sind.");

  AddDetail( ({"voegeln","voegel"}), 
            "Sie stecken irgendwo im Blaetterdach. Du kannst sie nicht sehen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach klarer Waldluft.");  
 
  AddSmell( ({"waldluft","luft"}),
	   "Es riecht herrlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst Gezwitscher.");

  AddSound( ({"gezwitscher"}),
	   "Es stammt von Voegeln, die Du im Blaetterdach nicht sehen kannst.");
  
//-----Details Ende-----
AddItem( "/d/gebirge/eros/mon/wanderzwerg", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "zwfe4",
          P_MNPC_AREA:({ROOM "zwfe4","zwfe3","zwfe2","zwfe1","zwfe5","zwefee"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("suedosten", ROOM "zwfe3");
AddExit("norden", ROOM "zwfe5");

}
