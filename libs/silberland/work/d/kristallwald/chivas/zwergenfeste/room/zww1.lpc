// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Im Sueden ist ein schnell fliessender Fluss, ueber die eine reich "
        "verzierte Holzbruecke fuehrt. Die Baeume zu beiden Seiten des Weges "
        "saeumen den Weg und es herrscht eine idyllische Stimmung." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1);

//-----Details Anfang-----
  
  AddDetail( ({"sueden"}), 
            "Im Sueden ist ein schnell fliessender Fluss, ueber den eine "
            "stabile Holzbruecke fuehrt.");

  AddDetail( ({"fluss","flusses"}),
	    "Ein schnell fliessender Fluss kreuzt den Weg. Eine Bruecke fuehrt "
            "ueber ihn hinweg. An seinem Ufer stehen ein paar Wasserpflanzen.");

  AddDetail( ({"holzbruecke","bruecke"}),
	    "Eine kleine und stabile Holzbruecke fuehrt ueber den Fluss im "
            "Sueden. Ihr Gelaender hat zahlreiche Verzierungen.");

  AddDetail( ({"baeume","baeumen"}),
	    "Grosse Baeume stehen zu beiden Seiten des Weges. Ihr dichtes "
            "Blaetterdach laesst nur ab und zu einen Lichtstrahl auf den Boden "
            "fallen.");
  
  AddDetail( ({"seiten"}),
	    "An beiden Seiten des Weges stehen grosse Baeume.");

  AddDetail( ({"weg","weges"}), 
            "Der Weg fuehrt im Sueden ueber eine Bruecke. Im Norden fuehrt der "
            "Weg weiter durch den Wald.");

  AddDetail( ({"stimmung"}),
	    "Es herrscht eine idyllische Stimmung. Es wirkt alles sehr "
            "friedlich.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist nur ansatzweise durch das Blaetterdach der Baeume "
            "zu sehen.");

  AddDetail( ({"boden","aeste","waldboden"}),
	    "Am Boden liegen einige Blaetter, die von den Baeumen herab "
            "gefallen sind und ein paar kleine Aeste.");
  
  AddDetail( ({"wasserpflanzen"}),
	    "Die Wasserpflanzen die am Ufer sind hauptsaechlich Schilf und ein "
            "paar Blumen.");

  AddDetail( ({"ufer"}), 
            "Am Ufer steht ein wenig Schilf und ein paar Blumen.");

  AddDetail( ({"schilf","rohre","gewaesser","gewaessern","justavius"}),
	    "Das Schilf waechst hoch und die Rohre stehen gerade aus dem "
            "Wasser heraus. Eigentlich gibt es keinen Schilf an schnell "
	    "fliessenden Gewaessern, wie Justavius meint, aber es wirkt sehr "
	    "nett.");

  AddDetail( ({"blumen"}),
	    "Es scheinen kleine gelbe Sumpfdotterblumen zu sein.");

  AddDetail( ({"sumpfdotterblumen","sumpfdotterblumen"}),
	    "Die Sumpfdotterblumen leuchten in einer herrlichen gelben Farbe.");
  
  AddDetail( ({"farbe","gelb"}),
	    "Das Gelb der Blumen sticht in dem Gruen des Waldes sehr heraus.");

  AddDetail( ({"gruen"}), 
            "Ansonsten sieht man eigentlich nur verschiedene Gruentoene.");

  AddDetail( ({"gruentoene"}),
	    "Die Gruentoene reichen von Hellgruen ueber Normalgruen bis "
            "Dunkelgruen.");

  AddDetail( ({"wald","waldes"}),
	    "Du befindest Dich in einem Wald weit im Norden der Region "
            "Kristallwald.");

  AddDetail( ({"region","regionen"}),
	    "Es gibt viele Regionen im Silberland.");
  
  AddDetail( ({"kristallwald"}),
	    "Der Kristallwald befindet sich weit im Sueden.");

  AddDetail( ({"silberland"}), 
            "Du bist im Silberland.");

  AddDetail( ({"hellgruen"}),
	    "Das Gras zwischen den Baeumen und am Ufer ist hellgruen.");

  AddDetail( ({"gras"}),
	    "Ein wenig Gras waechst zwischen den Baeumen und am Ufer des "
            "Flusses.");

  AddDetail( ({"normalgruen","bezeichnung"}),
	    "Normalgruen ist eine komische Bezeichnung, aber diese Farbe "
            "haben die meisten Blaetter hier im Wald.");
  
  AddDetail( ({"blaetter"}),
	    "Es haengen viele Blaetter an den Baeumen und einige sind auch "
            "von den Baeumen herunter gefallen und auf dem Boden gelandet.");

  AddDetail( ({"dunkelgruen"}), 
            "Die Blaetter einer grossen Eiche sind dunkelgruen.");

  AddDetail( ({"eiche"}),
	    "Der Stamm der grossen Eiche faellt Dir auf.");

  AddDetail( ({"gelaender"}),
	    "Das Gelaender der Bruecke ist mit zahlreichen Verzierungen der "
            "Zwerge verschoenert.");

  AddDetail( ({"verzierungen"}),
	    "Die Verzierungen zeigen verschiedene taegliche Arbeiten der "
            "Zwerge.");
  
  AddDetail( ({"blaetterdach","dach"}),
	    "Das dichte Blaetterdach verhindert den Blick auf den Himmel. Nur "
            "ab und zu trifft ein Lichtstrahl den Waldboden.");

  AddDetail( ({"lichtstrahl","strahl"}),
	    "Ab und zu faellt ein goldener Lichtstrahl auf den Waldboden. "
            "Es wirkt sehr idyllisch und friedlich.");
  
  AddDetail( ({"zwerge","naehe"}),
	    "Hier in der Naehe wohnen viele Zwerge.");

  AddDetail( ({"arbeiten","schuerfen","herstellen","waffen"}), 
            "Man erkennt Zwerge beim Schuerfen und beim Herstellen von "
            "Waffen, wofuer die Zwerge ja beruehmt sind.");

  AddDetail( ({"stamm"}),
	    "Am Stamm kann man eine kleine Inschrift erkennen.");

  AddDetail( ({"inschrift"}),
	    "Du kannst sie lesen.");

  AddDetail( ({"blick"}),
	    "Der Blick auf den Himmel ist durch das dichte Blaetterdach "
            "verwehrt.");
  
  AddDetail( ({"wasser"}),
	    "Das Wasser plaetschert ueber ein paar Steine im Fluss.");
  
  AddDetail( ({"steine"}),
	    "Einige groessere Steine liegen im Fluss, ueber die das Wasser "
            "plaetschert.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen am Fluss duften herrlich suess.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Rascheln der Blaetter und das "
                          "Plaetschern im Fluss.");

  AddSound( ({"rascheln","blaetter"}),
	   "*raschel*raschel*raschel*");

  AddSound( ({"plaetschern","fluss"}),
	   "Das Plaetschern wirkt sehr beruhigend.");
  
  AddReadDetail( ({"inschrift"}),
		"Du kannst sehr stolz auf Dich sein, dass Du bis in diese "
                "Detailtiefe geforscht hast.");

//-----Details Ende-----
  
AddExit("norden", ROOM "zww2");
AddExit("sueden", ROOM "zwfee");

}
