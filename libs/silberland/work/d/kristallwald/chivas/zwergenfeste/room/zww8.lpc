// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Waldlichtung");
  SetProp( P_INT_LONG,
	"Du stehst auf einer grossen Waldlichtung, die in der Mitte einen "
        "grossen Waldsee hat. Man kann den See anscheinend komplett umrunden. "
        "Im Sueden ist eine Bruecke zu sehen, die ueber einen Fluss fuehrt, "
        "der den See mit seinem Wasser speisst." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1);

//-----Details Anfang-----
  
  AddDetail( ({"waldlichtung","lichtung"}), 
            "Eine grosse Lichtung breitet sich vor Dir aus. In der Mitte "
            "liegt ein  grosser ruhiger See, der von einer grossen Wiese "
            "umrundet wird. Der Weg fuehrt nach Nordosten in den Wald hinein "
            "oder nach Sueden ueber eine Bruecke.");

  AddDetail( ({"mitte","waldsee","see"}),
	    "In der Mitte der Lichtung ist ein grosser See zu sehen. Ein "
            "paar Wellen plaetschern leise ans Ufer.");

  AddDetail( ({"sueden","bruecke"}),
	    "Im Sueden fuehrt eine Bruecke ueber einen Fluss.");

  AddDetail( ({"fluss"}),
	    "Der Fluss speisst den See mit Wasser.");
  
  AddDetail( ({"wasser"}),
	    "Viel Wasser fliesst durch den Fluss in den See.");

  AddDetail( ({"boden"}), 
            "Am Boden siehst Du einige Steinchen und viel Erde.");

  AddDetail( ({"himmel","tag"}),
	    "Es ist ein herrlicher Tag.");

  AddDetail( ({"wald","nordosten"}),
	    "Der grosse Wald umgibt die gesamte Lichtung. Im Nordosten laeuft "
            "der Weg wieder in den Wald.");

  AddDetail( ({"weg","stelle"}),
	    "Du kannst dem Weg nach Sueden ueber die Bruecke folgen oder auch "
            "nach Nordosten die Lichtung verlassen. An dieser Stelle kannst "
            "Du natuerlich auch den See ueber die Wiese umrunden und den Weg "
            "verlassen.");
  
  AddDetail( ({"wiese","westen"}),
	    "Im Westen siehst Du eine grosse Wiese, die um den ganzen See "
            "herum fuehrt. Du kannst ohne Probleme die Wiese mit den ganzen "
            "Blumen betreten.");

  AddDetail( ({"wellen","wasseroberflaeche","oberflaeche"}), 
            "Einige Wellen sind auf dem ruhigen See zu erkennen. Anscheinend "
            "gibt es ein wenig Wind, der die Wasseroberflaeche bewegt.");

  AddDetail( ({"ufer"}),
	    "Am Ufer erkennt man ein wenig Schilf.");

  AddDetail( ({"probleme","ort"}),
	    "An einem so schoenen Ort sollte man keine Probleme haben. Das "
            "Wetter ist herrlich und alles ist wunderschoen hier.");

  AddDetail( ({"blumen"}),
	    "Verschiedene bunte Blumen wachsen auf der Wiese. Geh einfach "
            "hin um zu sehen, was fuer Blumen es sind.");
  
  AddDetail( ({"wetter"}),
	    "Der Himmel ist schoen blau und die Sonne waermt Dich ein wenig.");

  AddDetail( ({"sonne"}), 
            "Die Sonne steht fast senkrecht am Himmel.");

  AddDetail( ({"wind","lueftchen"}),
	    "Es weht eigentlich nur ein leichtes Lueftchen.");

  AddDetail( ({"schilf","schilfrohre","rohre"}),
	    "Ein paar Schilfrohre wachsen am Ufer.");

  AddDetail( ({"erde"}),
	    "Die Erde ist schwarz und sicher sehr fruchtbar. Sie ist, durch "
            "viele Abenteurer die hier schon lang gegangen sind, ein wenig "
            "ausgetreten.");
  
  AddDetail( ({"steinchen"}),
	    "Es sind ganz normale kleine Steinchen. Sie sind nicht sehr "
            "interessant.");

  AddDetail( ({"abenteurer","gruppe"}), 
            "Du gehoerst auch zu dieser Gruppe.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst einen suesslichen Duft.");  
 
  AddSmell( ({"duft"}),
	   "Der suessliche Duft stammt von den Blumen der Wiese.");

  AddSmell( ({"blumen"}),
	   "Die Blumen duften herrlich.");
  
  
  AddSound(DEFAULT_SOUND, "Du hoerst ein leises Plaetschern und Vogelgezwitscher.");

  AddSound( ({"plaetschern","wellen"}),
	   "Das Plaetschern stammt von den Wellen, die gegen das Ufer schlagen.");
  
  AddSound( ({"vogelgezwitscher","gezwitscher"}),
	   "*tschip*tschip*tschip*");

//-----Details Ende-----
  
AddExit("nordosten", ROOM "zww9");
AddExit("sueden", ROOM "zww7");
AddExit("westen", ROOM "zww18");

}
