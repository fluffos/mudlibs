// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Zwergenfeste von Ardhmir");
  SetProp( P_INT_LONG,
	"Die riesige Halle erstreckt sich vor Dir nach Norden. Eine Bruecke "
        "ueberspannt die Schlucht nach Nordwesten. Im Sueden scheint eine "
	"typische Zwergenkneipe zu sein, aus der lautes Lachen und Gepolter "
	"kommt. Ein Schild haengt ueber dem Eingang zur Kneipe." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"halle"}), 
            "Die grosse Halle von Ardhmir ist in der Mitte durch eine tiefe "
	    "Schlucht geteilt. Sie erstreckt sich von hier aus weiter nach "
	    "Norden. Riesige Saeulen stuetzen die Decke der Halle ab.");

  AddDetail( ({"norden"}),
	    "Die Halle fuehrt weiter nach Norden. Im Sueden ist nur noch eine "
	    "Kneipe, wie sie bei den Zwergen ueblich ist.");

  AddDetail( ({"bruecke","nordwesten"}),
	    "Nach Nordwesten kann man die Schlucht ueber eine Bruecke "
	    "ueberqueren um auf die westliche Seite der Halle zu kommen. Die "
	    "Bruecke besteht aus Stein und wird auch von dieser Seite von zwei "
	    "grossen Statuen verschoent.");

  AddDetail( ({"schlucht","mitte","richtung","abgrund"}),
	    "In der Mitte der Halle zieht sich von Sueden nach Norden eine "
	    "tiefe Schlucht. Man kann sogar sagen der Abgrund ist bodenlos, da "
	    "ihn noch nie jemand lebend von dort zurueck gekehrt ist. Die "
	    "Schlucht verengt sich an dieser Stelle und verschwindet in der "
	    "Tiefe unter dem Fels in Richtung Sueden.");
  
  AddDetail( ({"sueden","zwergenkneipe","kneipe"}),
	    "Im Sueden ist eine Zwergenkneipe. Der Eingang ist direkt suedlich "
	    "von Dir und ein grosses Schild haengt darueber.");

  AddDetail( ({"lachen"}), 
            "Das Lachen kann man nur hoeren.");

  AddDetail( ({"stelle"}), 
            "An der Stelle wo die Schlucht unter dem Fels in einer Spalte "
	    "verschwindet zieht sich ein Riss von der oberen Kante der "
	    "Schlucht an der Suedwand zum Spalt hinunter.");

  AddDetail( ({"kante"}), 
            "An der Kante zur Schlucht zieht sich ein Riss an der Suedwand "
	    "runter zum Spalt.");

  AddDetail( ({"spalt","spalte"}), 
            "An der Stelle wo die Schlucht zu einem schmalen Spalt wird ist "
	    "in ein paar Metern tiefe ein Felsvorsprung zu sehen.");

  AddDetail( ({"felsvorsprung","vorsprung"}), 
            "Von dem Vorsprung kann man sicher gut in den Spalt hinein gehen.");

  AddDetail( ({"riss"}), 
            "Der Riss zieht sich an der Suedwand am Rande der Schlucht "
	    "hinunter zu einem kleinen Felsvorsprung vor der Spalte, in der "
	    "die Schlucht verschwindet Man koennte ja mal versuchen an dem "
	    "Riss nach unten zu klettern.");

  AddDetail( ({"gepolter"}),
	    "Das Gepolter kommt aus der Zwergenkneipe und man kann es "
	    "natuerlich nur hoeren.");

  AddDetail( ({"schild"}),
	    "Das Schild ueber dem Eingang zur Kneipe kannst Du lesen.");

  AddDetail( ({"eingang"}),
	    "Der Eingang im Sueden fuehrt Dich in eine echte Zwergenkneipe. "
	    "Ueber dem Eingang haengt ein grosses Schild.");
  
  AddDetail( ({"boden"}),
	    "Der Boden ist wie in der gesamten oestlichen Haelfte der Halle "
	    "mit schwarzen Granitplatten ausgelegt.");

  AddDetail( ({"decke"}), 
            "Die Decke ist weit oben sehr gut durch das Licht der Barinsteine "
	    "zu erkennen, jedoch gibt es dort nicht viel zu sehen, was "
	    "interessant sein koennte.");

  AddDetail( ({"wand","waende","waenden"}),
	    "An den Waenden finden sich einige wunderschoene Reliefs.");

  AddDetail( ({"saeulen"}),
	    "Die grossen Saeulen ragen in der ganzen Halle zur Decke hinauf. "
	    "An den Saeulen sind lauter Barinsteine befestigt, die genug "
	    "Licht spenden um die ganze Halle in ein warmes gelbliches Licht "
	    "zu tauchen.");

  AddDetail( ({"seite"}),
	    "Du bist auf der oestlichen Seite der Halle.");
  
  AddDetail( ({"statuen"}),
	    "Die zwei Statuen auf dieser Seite der Bruecke haben das Aussehen "
	    "von grossen Zauberern.");

  AddDetail( ({"tiefe"}), 
            "In der Tiefe verschwindet die Schlucht in der Suedwand. Wohin "
	    "sie fuehrt weiss niemand.");

  AddDetail( ({"suedwand"}),
	    "In der Wand direkt im Sueden ist der Eingang zur Kneipe. In der "
	    "Tiefe der Schlucht verschwindet der Abgrund.");

  AddDetail( ({"haelfte"}),
	    "Du bist in der oestlichen Haelfte der Halle. Um in die westliche "
	    "Haelfte zu kommen, musst Du ueber die Bruecke nach Nordwesten "
	    "gehen");

  AddDetail( ({"granitplatten","platten","granit","kontrast"}),
	    "Die grossen schwarzen Granitplatten wurden von weit her hier nach "
	    "Ardhmir gebracht. Sie passen irgendwie in die Halle und bilden "
	    "einen guten Kontrast zu dem gelben Licht der Barinsteine.");
  
  AddDetail( ({"licht"}),
	    "Das gelbe Licht der Barinsteine erhellen die gesamte Halle.");

  AddDetail( ({"barinsteine","steine"}), 
            "Die Barinsteine sind an den grossen Saeulen befestigt um die "
	    "Dunkelheit aus der unterirdischen Halle zu vertreiben.");

  AddDetail( ({"dunkelheit","ecken"}),
	    "Es gibt kaum Dunkelheit in der Halle. Es sieht in ein paar Ecken "
	    "hoechstens ein wenig daemmerig aus, aber ansonsten ist die "
	    "gesamte Halle sehr gut ausgeleuchtet.");

  AddDetail( ({"reliefs"}),
	    "Die Reliefs wurden von Meisterhand erstellt. \n"
"                            ==(W{==========-      /===-             \n"
"                              ||  (.--.)         /===-_---~~~~~~~~~------____ \n"
"                              | \\_,|**|,__      |===-~___                _,-'`\n"
"                 -==\\\\        `\\ ' `--'   ),    `//~\\\\   ~~~~`---.___.-~~  \n"
"             ______-==|        /`\\_. .__/\\ \\    | |  \\\\           _-~`     \n"
"       __--~~~  ,-/-==\\\\      (   | .  |~~~~|   | |   `\\        ,'         \n"
"    _-~       /'    |  \\\\     )__/==0==-\\<>/   / /      \\      /           \n"
"  .'        /       |   \\\\      /~\\___/~~\\/  /' /        \\   /'            \n"
" /  ____  /         |    \\`\\.__/-~~   \\  |_/'  /          \\/'       \n"
"/-'~    ~~~~~---__  |     ~-/~         ( )   /'        _--~`     \n"
"                  \\_|      /        _) | ;  ),   __--~~        \n"
"                    '~~--_/      _-~/- |/ \\   '-~ \\          \n"
"                   {\\__--_/}    / \\\\_>-|)<__\\      \\         \n"
"                   /'   (_/  _-~  | |__>--<__|      |         \n"
"                  |   _/) )-~     | |__>--<__|      |        \n"
"                  / /~ ,_/       / /__>---<__/      |        \n"
"                 o-o _//        /-~_>---<__-~      /         \n"
"                 (^(~          /~_>---<__-      _-~          \n"
"                ,/|           /__>--<__/     _-~                 \n"
"             ,//('(          |__>--<__|     /                  .----_   \n"
"            ( ( '))          |__>--<__|    |                 /' _---_~\\   \n"
"         `-)) )) (           |__>--<__|    |               /'  /     ~\\`\\  \n"
"        ,/,'//( (             \\__>--<__\\    \\            /'  //        ||   \n"
"      ,( ( ((, ))              ~-__>--<_~-_  ~--____---~' _/'/        /'   \n"
"    `~/  )` ) ,/|                 ~-_~>--<_/-__       __-~ _/  \n"
"  ._-~//( )/ )) `                    ~~-'_/_/ /~~~~~~~__--~    \n"
"   ;'( ')/ ,)(                              ~~~~~~~~~~         \n"
"  ' ') '( (/        \n"
"    '   '  `        \n"
"           \n");

  AddDetail( ({"aussehen","zauberer","zauberern"}),
	    "Die Zauberer haben jeweils eine lange Robe an und einen langen "
	    "Bart, der ihnen ein weises Aussehen gibt. Sie haben ihre Arme "
	    "zur Decke gestreckt und in ihren nach oben gerichteten "
	    "Handflaechen scheint ein gruenes Feuer zu brennen.");
  
  AddDetail( ({"robe"}),
	    "Die Robe der Zauberer sieht taeuschend echt aus. Sie sieht nicht "
	    "so aus, als ob sie aus Stein besteht.");

  AddDetail( ({"bart","ausdruck"}), 
            "Der Bart der Zauberer verpasst den Gesichtern einen weisen und "
	    "guetigen Ausdruck.");

  AddDetail( ({"gesichtern","gesichter"}),
	    "Die Gesichter der Zauberer bekommen noch ein besonders mystisches "
	    "Aussehen durch die Augen.");

  AddDetail( ({"arme"}),
	    "Die Arme sind zur Decke gereckt.");

  AddDetail( ({"handflaechen","feuer"}),
	    "Die Handflaechen zeigen nach oben. Darauf brennt ein magisches "
	    "gruenes Feuer. Es sieht geheimnisvoll aus, passt aber ideal zu "
	    "den beiden Statuen.");
  
  AddDetail( ({"meisterhand","steinmetze","kunst"}),
	    "Die Steinmetze der Zwerge beherschen ihre Kunst.");

  AddDetail( ({"stein","fels","hoehle"}),
	    "In einer Hoehle gibt es schon aus Prinzip viel Fels.");

  AddDetail( ({"ardhmir","zwergenfeste","feste","zwergenreiches","zwergenreich"}),
	    "Die Zwergenfeste von Ardhmir beeindruckt Dich doch sehr.");
  
  AddDetail( ({"zwergen","zwerge"}),
	    "Sehr viele Zwerge leben und arbeiten in der Feste.");

  AddDetail( ({"augen"}),
	    "Die Augen bestehen aus grossen Rubinen.");

  AddDetail( ({"prinzip","prinzipien","sache"}),
	    "Prinzipien sind nicht Deine Sache.");
  
  AddDetail( ({"rubine","rubinen"}),
	    "Di Rubine sind sicher eigross und viel wert. Sie zeigen den "
	    "Reichtum des Zwergenreiches von Ardhmir.");

  AddDetail( ({"reichtum"}),
	    "Die Zwerge hier sind sehr reich.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst Alkohol.");  
 
  AddSmell( ({"geruch","alkohol"}),
	   "Der Geruch von Alkohol kommt aus der Kneipe im Sueden.");

  AddSound(DEFAULT_SOUND, "Du hoerst lautes Lachen und Gepolter.");

  AddSound( ({"lachen","gepolter","geraeusche"}),
	   "Alle Geraeusche kommen aus der Kneipe. Geh einfach mal rein und "
	   "schau Dich um.");
  
  AddReadDetail( ({"schild"}),
"  \n"
"                           /   \\                            \n"
" _                 )      ((   ))     (                     \n"
"(@)               /|\\      ))_((     /|\\                 _  \n"
"|-|              / | \\    (/\\|/\\)   / | \\               (@) \n"
"| | ------------/--|-voV---\\`|'/--Vov-|--\\--------------|-| \n"
"|-|                  '^`   (o o)  '^`                   | | \n"
"| |                        `\\Y/'                        |-| \n"
"|-|                                                     | | \n"
"| |       Zwergenkneipe 'Zum weissen Drachen'           |-| \n"
"|_|_____________________________________________________| | \n"
"(@)       l   /\\ /         ( (       \\ /\\   l           |-| \n"
"          l /   V           \\ \\       V   \\ l           (@) \n"
"          l/                _) )_          \\I               \n"
"                            `\\ /'                           \n"
"                              `                              \n"
"           \n");


//-----Details Ende-----
  
AddExit("sueden", ROOM "zwfes1");
AddExit("norden", ROOM "zwfe22");
AddExit("nordwesten", ROOM "zwfe16");

AddCmd( ({"kletter", "klettere" }), "klettern" );

}
int klettern(string str)
{
   notify_fail("Wohin moechtest Du woran klettern?\n");
   if ( member( ({ "an riss nach unten","an riss runter" }),str) != -1) 
  {
        write(BS ( "Du greifst in den Riss an der Felswand und probierst nach "
               "unten zu klettern, schaffst es aber momentan nicht.\n"));
	//    write(BS ( "Du greifst in den Riss an der Felswand und kletterst "
//               "an ihm vorsichtig nach unten.\n"));
//      TP->move( DRAGONQUEST+"/room/dragonq1", M_GO, 
//      "aus der Halle nach unten", "verschwindet", 
//      "klettert aus der Schlucht herein");
    return 1;
  }
}
