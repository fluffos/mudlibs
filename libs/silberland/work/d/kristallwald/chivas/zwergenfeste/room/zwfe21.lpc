// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Zwergenfeste von Ardhmir");
  SetProp( P_INT_LONG,
	"Du stehst in der Mitte im oestlichen Teil der grossen Halle. Westlich "
	"von Dir ist die tiefe Schlucht zu sehen, die die Halle teilt. Nach "
	"Norden und Sueden kann man die oestliche Haelfte der Halle zwischen "
	"den grossen Saeulen weiter durchschreiten. Genau im Osten vor Dir tut "
	"sich ein grosses Tor im Fels auf." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"mitte"}), 
            "Du stehst genau in der Mitte der grossen Halle von Ardhmir. Du "
	    "kannst weiter nach Norden oder nach Sueden durch die Halle gehen "
	    "und dann ueber eine Bruecke die andere Seite der Halle "
	    "erreichen. Der direkte Weg ist Dir leider durch die unterirdische "
	    "Schlucht versperrt.");

  AddDetail( ({"teil","haelfte","seite","haelften"}),
	    "Die grosse Halle ist in zwei Haelften geteilt, wie Du sicher "
	    "schon gemerkt hast, ansonsten waerst Du ja jetzt nicht hier.");

  AddDetail( ({"halle","dimensionen"}),
	    "Die grosse Halle des Zwergenreiches hat riesige Dimensionen und "
	    "ist die groesste, die Du jemals gesehen hast.");

  AddDetail( ({"schlucht","abgrund"}),
	    "Die Schlucht neben Dir scheint bodenlos zu sein. Du musst "
	    "aufpassen, dass Du nicht reinfaellst.");
  
  AddDetail( ({"norden","sueden"}),
	    "Die Halle erstreckt sich von Dir aus gesehen nach Norden und "
	    "Sueden.");

  AddDetail( ({"saeulen"}), 
            "Die hohen Saeulen reichen weit nach oben zur Decke. An den "
	    "Saeulen sind in der ganzen Halle leuchtende Steine angebracht, "
	    "die die Halle in ein gelblich warmes Licht tauchen.");

  AddDetail( ({"osten","tor"}),
	    "Ein grosses Tor im Osten fuehrt in den Palast von Ardhmir. Der "
	    "Torbogen aus einem Dir unbekannten Material ist mit blaeulich "
	    "schimmernden Runen verziert.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit schwarzen Granitplatten ausgelegt.");

  AddDetail( ({"decke"}),
	    "Die Decke ganz weit oben ist mit verschieden grossen Stalagtiten "
	    "besetzt.");
  
  AddDetail( ({"waende","waenden","wand"}),
	    "Die Waende sind mit goldenen und silbernen Ornamenten "
	    "verziert.");

  AddDetail( ({"weg","beste"}), 
            "Der direkte Weg ist nicht immer der Beste.");

  AddDetail( ({"gold","silber"}), 
            "Das Gold und Silber der Ornamente glaenzt herrlich.");

  AddDetail( ({"bruecke","bruecken"}),
	    "Du kannst die zwei Bruecken im Norden und Sueden sehen, wie sie "
	    "sich ueber den Abgrund der Schlucht spannen.");

  AddDetail( ({"ardhmir","zwergenfeste","feste","zwergenreich","reich"}),
	    "Du bist tief im Reich der Zwerge.");

  AddDetail( ({"zwerge","zwerg"}),
	    "Es gibt natuerlich viele Zwerge in der Zwergenfeste von Ardhmir.");
  
  AddDetail( ({"licht"}),
	    "Das gelbe Licht der Barinsteine erhellt die ganze Halle.");

  AddDetail( ({"steine","barinsteine"}), 
            "Die Barinsteine an den Saeulen schenken genug Licht um die "
	    "ganze Halle auszuleuchten.");

  AddDetail( ({"granitplatten","platten","granit","ort"}),
	    "Der schwarze Granit wurde von weit her an diesen Ort gebracht, "
	    "da es ihn unter der Hochebene von Gorthad nicht gibt.");

  AddDetail( ({"stalagtiten","meter","jahren","richtung"}),
	    "Einige der Stalagtiten sind schon tausende von Jahren alt und "
	    "mehrere Meter lang. Sie wachsen langsam Richtung Boden.");

  AddDetail( ({"ornamenten","ornamente","ornament","stoffen","bauwerken","tapeten","muster"}),
	    "Ein Ornament ist ein meist sich wiederholendes, oft abstraktes "
	    "oder abstrahiertes Muster. Man findet Ornamente z. B. als "
	    "Verzierung auf Stoffen, Bauwerken, Tapeten, etc. im ganze "
	    "Silberland. Vor allem die Ornamente von Felonia oder die "
	    "glanzvollen Ornamente im Gaffodorf sind silberlandweit beruehmt.");
  
  AddDetail( ({"torbogen","bogen","eingang"}),
	    "Der grosse Torbogen im Osten ist der Eingang zum Palast der "
	    "Zwergenfeste.");

  AddDetail( ({"material"}), 
            "Das Material ist sicher besonders wertvoll und selten. Du hast so "
	    "ein Material noch nie gesehen.");

  AddDetail( ({"palast"}),
	    "Im Osten befindet sich der Palast des Herrschers von Ardhmir. "
	    "Besuch ihn doch mal.");

  AddDetail( ({"runen","blau"}),
	    "Die Runen leuchten in einem magischen Blau. Sie strahlen eine "
	    "ungeheure Macht aus.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Das Zwergenreich von Ardhmir befindet sich unterhalb der "
	    "Hochebene von Gorthad.");
  
  AddDetail( ({"gaffodorf","dorf","dorfes"}),
	    "Du solltest es unbedingt einmal besuchen. Einige Besucher "
	    "schwaermen nur von der Pracht des Dorfes.");

  AddDetail( ({"besucher"}), 
            "Die Besucher sind meist nur Magier. Abenteurer verirren sich "
	    "nur selten im Gaffodorf.");

  AddDetail( ({"abenteurer"}),
	    "Abenteurer wie Du einer bist.");

  AddDetail( ({"magier"}),
	    "Magier sind ein wenig anders.");

  AddDetail( ({"felonia","hauptstadt"}),
	    "Felonia ist die Hauptstadt der Zwerge im Gebirge.");
  
  AddDetail( ({"gebirge"}),
	    "Das Gebirge ist ziemlich weit weg von hier.");

  AddDetail( ({"silberland"}),
	    "Du befindest Dich im Silberland.");
  
  AddDetail( ({"herrschers","herrscher"}),
	    "Der Herrscher von Ardhmir ist ein weiser Zwerg, der die "
	    "Geschicke seines Volkes mit Intelligenz zu lenken weiss.");

  AddDetail( ({"geschicke","volkes","volk","geschick"}), 
            "Die Geschicke des Volkes sind dem Herrscher sehr wichtig.");

  AddDetail( ({"intelligenz"}),
	    "Das ist sicher nichts fuer Dich.");

  AddDetail( ({"macht"}),
	    "Auf den Runen liegt ein grosser Zauber. Du solltest Dir vorher "
	    "genau ueberlegen, ob Du in dem Palast Aerger anfangen willst.");

  AddDetail( ({"zauber"}),
	    "Der Zauber schwaecht sicher diejenigen, die dem Herrscher "
	    "etwas antun wollen.");
  
  AddDetail( ({"aerger"}),
	    "Beachte besser diese Warnung, es ist kein Scherz.");

  AddDetail( ({"warnung"}),
	    "Schlussendlich ist es Deine Entscheidung. Du bist alt genug.");
  
  AddDetail( ({"scherz","scherze"}),
	    "Es gibt bessere Scherze als eine Warnung.");

  AddDetail( ({"entscheidung"}), 
            "Entscheide Dich weise und wage es nicht hinterher zu sudern.");

  AddDetail( ({"verzierung","verzierungen"}),
	    "In der Zwergenfeste gibt es ueberall sagenhafte Verzierungen.");

  AddDetail( ({"pracht"}),
	    "Vor allem die Pracht der Ornamente hier in Ardhmir ist "
	    "unuebertroffen.");

  AddDetail( ({"fels"}),
	    "Fels ist ueberall um Dich herum.");
  
  AddDetail( ({"belueftungssystem"}),
	    "Das Belueftungssystem ist nicht zu sehen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst nur die frische Luft, die durch das "
		  "gute Belueftungssystem der Zwerge in die Feste geleitet "
		  "wird.");  
 
  AddSmell( ({"luft"}),
	   "Die Luft riecht gut und frisch.");

  AddSound(DEFAULT_SOUND, "Du hoerst viele Zwerge in der Halle.");

  AddSound( ({"zwerge"}),
	   "Die Zwerge reden miteinander und sind am arbeiten.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "zwfe22");
AddExit("norden", ROOM "zwfe20");
AddSpecialExit( "osten", "go_osten" );

AddItem("/gilden/bardengilde/obj/ehrenstatue", REFRESH_DESTRUCT, (["hero": "angara"]));

}
int go_osten(string dir)
{

  if(!(present("zwinvis2", TP)))
  {
    write( BS( "Du durchschreitest das magische Tor zum Palast und Deine "
	       "Nackenhaare stellen sich auf. Das Tor scheint Dich genau "
	       "zu bewerten, ob Du ein Freund oder Feind des Herrschers von "
	       "Ardhmir bist.") );
  say(TPN+" durchschreitet das Tor nach Osten.\n");
   this_player()->move(ROOM "zwfe24", M_TPORT);
    return -1;
  }
  write(BS("Du durchschreitest das magische Tor zum Palast und Deine "
	   "Nackenhaare stellen sich auf. Ein Blitz trifft Dich als Du "
	   "weiter gehst. Anscheinend betrachtet Dich das magische Tor als "
	   "Feind der Herrschers von Ardhmir."));
 
  say(TPN+" durchschreitet von einem Blitz getroffen das Tor nach Osten.\n");
  TP->AddHp(-50);
  this_player()->move(ROOM "zwfe24", M_TPORT);
  return 1;
}
