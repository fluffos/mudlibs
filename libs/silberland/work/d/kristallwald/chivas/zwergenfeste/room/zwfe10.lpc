// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Zwergenfeste von Ardhmir");
  SetProp( P_INT_LONG,
	"In dieser Halle ist die Decke gar nicht zu erkennen. Sie muss weit "
        "ueber Dir in der Dunkelheit sein. Der Lichtschein der gluehenden "
        "Steine an den Waenden reicht nicht so weit hinauf. Ein sehr breiter "
        "Gang im Osten scheint weiter in die Feste zu fuehren." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"halle"}), 
            "Die Halle in der Du stehst ist nicht so gross wie die Halle "
	    "weiter im Westen, macht jedoch auf Dich immer noch den Eindruck "
	    "klein und unbedeutend zu sein.");

  AddDetail( ({"decke","dunkelheit"}),
	    "Die Decke der Halle ist soweit ueber Dir in der Dunkelheit, so "
	    "dass Du sie nur erahnen kannst.");

  AddDetail( ({"lichtschein","steine","barinsteine","steinen"}),
	    "Die Barinsteine erhellen die Halle recht gut. Jedoch reicht ihr "
	    "Lichtschein nicht bis zur Decke hinauf.");

  AddDetail( ({"waende","waenden","wand"}),
	    "An den Waenden haengen ein paar leuchtende Steine, die die Halle "
	    "ausleuchten. Zwischen den Steinen sind kunstvolle "
	    "Steinmetzarbeiten zu erkennen.");
  
  AddDetail( ({"gang","osten"}),
	    "Ein breiter Gang im Osten fuehrt Dich tiefer in die Zwergenfeste "
	    "hinein. Ansonsten kann man in die erste grosse Halle nach Westen "
	    "gehen oder weiter nach Norden.");
  
  AddDetail( ({"zwergenfeste","feste","ardhmir","zwergenreich","reich"}), 
            "Du bist im Zwergenreich von Ardhmir.");

  AddDetail( ({"treppe"}), 
            "Neben der Treppe steht ein Schild.");

  AddDetail( ({"schild"}), 
            "Du kannst es lesen.");

  AddDetail( ({"boden"}),
	    "Der Boden ist eben und sauber. Anscheinend wird hier sehr auf "
	    "Sauberkeit und Ordnung geachtet. Ausserdem geht eine Treppe nach "
	    "unten.");

  AddDetail( ({"westen"}),
	    "Im Westen ist die erste grosse Halle von Ardhmir, durch die man "
	    "kommt, wenn man die Zwergenfeste betritt oder sie verlassen "
	    "moechte.");

  AddDetail( ({"eindruck"}),
	    "Anscheinend soll dieser Eindruck auch vermittelt werden.");
  
  AddDetail( ({"steinmetzarbeiten","arbeiten"}),
	    "Die Steinmetzarbeiten zeigen die Hochebene von Gorthad mit dem "
	    "Turm und einigen Haeusern.");

  AddDetail( ({"norden"}), 
            "Im Norden scheint ein Tunnel weiter zu fuehren.");

  AddDetail( ({"tunnel"}),
	    "Geh einfach nach Norden und schau nach wo er hin fuehrt.");

  AddDetail( ({"sauberkeit","ordnung"}),
	    "Sauberkeit und Ordnung scheint hier in der Zwergenfeste sehr "
	    "wichtig zu sein. Normalerweise traut man dies den Zwergen ja "
	    "gar nicht zu.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Die Zwergenfeste befindet sich unterhalb der Hochebene von "
	    "Gorthad.");
  
  AddDetail( ({"turm"}),
	    "Den Turm gibt es immer noch auf der Hochebene.");

  AddDetail( ({"haeuser","haeusern"}), 
            "Die Haeuser sind auf der Hochebene schon seit langer Zeit "
	    "verschwunden. Statt dessen findet man dort nur noch ein paar "
	    "Huegelgraeber.");

  AddDetail( ({"zeit","jahrhunderte"}),
	    "Es ist schon Jahrhunderte her, dass dort Menschen gelebt haben.");

  AddDetail( ({"menschen"}),
	    "Es gibt viele Menschen im Silberland.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland.");
  
  AddDetail( ({"huegelgraeber","graeber","huegelgrab"}),
	    "Die Huegelgraeber sind nun das Merkmal der Hochebene und geben "
	    "ihr ihren Namen.");

  AddDetail( ({"merkmal","namen"}), 
            "Gorthad heisst auf elfisch Huegelgrab.");

  AddDetail( ({"zwergen","zwerge"}),
	    "Viele Zwerge leben in der Feste.");

  AddDetail( ({"beschaeftigungen"}),
	    "Die Beschaeftigungen der Zwerge von Ardhmir gehen Dich nichts "
	    "an.");

  AddDetail( ({"tagewerk"}),
	    "Die Zwerge haben viel zu tun. Was sie genau tun geht Dich nichts "
            "an.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach frischer Luft.");  
 
  AddSmell( ({"luft"}),
	   "Die Luft riecht so frisch, so dass man beinahe denken koennte man "
	   "waere draussen.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Zwerge bei ihren taeglichen "
		          "Beschaeftigungen.");

  AddSound( ({"zwerge"}),
	   "Einige Zwerge laufen umher und verrichten ihr Tagewerk. Du hoerst "
	   "ihr rumtapsen und noch vieles mehr, was Dich nicht besonders "
	   "interessiert.");

  AddReadDetail( ({"schild"}),
		"+-----------------------------------+\n"
		"|                                   |\n"
		"|        Bergwerksstollen           |\n"
		"|                                   |\n"
		"|                |                  |\n"
		"|                |                  |\n"
		"|                \\/                 |\n"
		"|                                   |\n"
		"+-----------------------------------+\n");  
//-----Details Ende-----
  
AddExit("sueden", ROOM "zwfe9");
AddExit("norden", ROOM "zwfe11");
AddExit("osten", ROOM "zwfe18");
AddExit("unten", ROOM "zwfest5");

}
