// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int beeren_zahl;

void create()
	
{
  ::create();

  beeren_zahl=3;

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Weg fuehrt von Norden nach Suedwesten, wo eine grosse Lichtung "
        "ist. Die Baeume stehen hier nicht mehr so dicht und die Lichtung "
        "breitet sich direkt vor Dir im Suedwesten aus. In seiner Mitte "
        "scheint ein grosser See zu sein." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1);

//-----Details Anfang-----
  
  AddDetail( ({"weg"}), 
            "Der Weg fuehrt durch einen schoenen Wald. Die Baeume stehen nicht "
            "so dicht und es wirkt sehr idyllisch. Im Suedwesten kommt der "
            "Weg auf eine Lichtung.");

  AddDetail( ({"norden"}),
	    "Im Norden wird der Wald dichter.");

  AddDetail( ({"suedwesten","lichtung"}),
	    "Im Suedwesten ist eine idyllische Lichtung im Wald zu sehen, in "
            "deren Mitte ein See zu sein scheint.");

  AddDetail( ({"baeume"}),
	    "Die Baeume stehen nicht so dicht wie im Norden. Viel Licht faellt "
            "durch das Blaetterdach auf den Waldboden. Einige kleine "
            "Straeucher stehen zwischen den Baeumen.");
  
  AddDetail( ({"mitte","see"}),
	    "In der Mitte der Lichtung ist ein grosser See. Um mehr zu sehen, "
            "musst Du schon hingehen.");

  AddDetail( ({"boden","waldboden"}), 
            "Der Boden ist mit einigen Zweigen und Blaettern bedeckt.");

  AddDetail( ({"himmel"}),
	    "Der Himmel,der durch das lichte Blaetterdach ein wenig zu sehen "
            "ist scheint herrlich blau zu sein.");

  AddDetail( ({"wald"}),
	    "Du bist in einem grossen Wald.");

  AddDetail( ({"zweigen","zweige"}),
	    "Einige Zweige sind von den Baeumen herunter gefallen und auf dem "
            "Waldboden gelandet.");
  
  AddDetail( ({"blaettern","blaetter"}),
	    "Die grossen Aeste der Baeume sind voll von Blaettern. Aber einige "
            "Blaetter liegen auch am Boden.");

  AddDetail( ({"blaetterdach"}), 
            "Das Blaetterdach ist nicht sehr dicht. Man kann sogar ein wenig "
            "den Himmel erkennen.");

  AddDetail( ({"aeste"}),
	    "Aeste sind etwas ganz normales fuer Baeume.");

  AddDetail( ({"straeucher"}),
	    "Es sind kleine Straeucher, an denen auch ein paar Beeren "
            "haengen. Andere Straeucher haben wunderschoene Blueten.");

  AddDetail( ({"beeren"}),
	    "Es sind wunderschoene Himbeeren, die hier wachsen.");
  
  AddDetail( ({"himbeeren","himbeere"}),
	    "Pflueck doch einfach mal ein paar, sie schmecken sicher gut.");

  AddDetail( ({"blueten"}), 
            "Die weissen Blueten der Straeucher sehen sehr schoen aus. Einige "
            "kleine Bienen schwirren um die Blueten herum.");

  AddDetail( ({"bienen"}),
	    "Es sind ganz kleine Bienen, die hier Nektar sammeln.");

  AddDetail( ({"nektar"}),
	    "Nektar ist sehr wichtig fuer die Bienen.");

  AddDetail( ({"licht"}),
	    "Sehr viel Licht faellt durch das lichte Blaetterdach.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blueten.");  
 
  AddSmell( ({"blueten"}),
	   "Die weissen Blueten der Straeucher duften herrlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Summen.");

  AddSound( ({"summen","bienen"}),
	   "Einige kleine Bienen summen um die Blueten der Straeucher herum.");
  
//-----Details Ende-----
AddItem( "/d/ebene/Silberwald/npc/hoernchen", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "zww9",
          P_MNPC_AREA:({ROOM "zww9"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("norden", ROOM "zww10");
AddExit("suedwesten", ROOM "zww8");

AddCmd( ({"pflueck","pfluecke" }), "pfluecken" );

}
int pfluecken(string str)
{
  object beere;

  notify_fail( "Was moechtest Du pfluecken?\n" );

 if(!str || str == "") return 0;
 if(!(str == "himbeere" ||
      str == "himbeeren" ||
      str == "beere" ||
      str == "beeren" )) return 0;

   {
     if( beeren_zahl < 1 )
     {
        write("Du findest keine Himbeere mehr, die reif genug zum essen ist.\n");
        say(sprintf("%s findet keine reife Himbeere mehr.\n", TP->Name(WER)));
        return -1;
     }
      if ( beeren_zahl )
      {
        beere = clone_object( "/d/wasser/woody/obj/himbeere");
        write("Du pflueckst eine Himbeere.\n" );
        beeren_zahl=beeren_zahl-1;
        if ( ME_TOO_HEAVY == beere->move(TP,M_GET|M_SILENT) )          {
          write("Die Himbeere ist Dir zu schwer.\n" );
          say(BS(sprintf("%s ist zu schwach eine Himbeere zu pfluecken, "
          "Du koenntest fast Mitleid haben.\n", TP->Name(WER))));
          beere -> remove();
          return 1;
      }
      }
    return 1;
   }
  return 1;
}


void reset() {
  beeren_zahl=3;
  return ::reset();
}
   
