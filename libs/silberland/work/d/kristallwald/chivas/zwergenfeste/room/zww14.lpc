// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Wald ist duester und unheimlich. Die Baeume ruecken in Richtung "
        "Norden immer naeher an den Weg und scheinen sich gerade zu auf Dich "
        "zu stuerzen um nach Dir zu greifen. Man fuehlt sich nicht sehr wohl "
        "hier." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1);

//-----Details Anfang-----
  
  AddDetail( ({"wald"}), 
            "Der Wald wirkt duester und unheimlich. Im Norden sieht es noch "
            "duesterer aus.");

  AddDetail( ({"baeume","baeumen"}),
	    "Die Baeume wirken geradezu bedrohlich. Sie scheinen naeher am "
            "Weg zu stehen.");

  AddDetail( ({"richtung","norden"}),
	    "Im Norden scheint gar kein Licht mehr durch das Blaetterdach "
            "zu dringen und es geht eine beaengstigende Aura vom Norden aus.");

  AddDetail( ({"weg"}),
	    "Der Weg fuehrt weiter nach Norden.");
  
  AddDetail( ({"boden"}),
	    "Am Boden liegen einige Blaetter und Aeste.");

  AddDetail( ({"himmel"}), 
            "Der Himmel ist durch das Blaetterdach der Baeume nicht zu sehen.");

  AddDetail( ({"blaetterdach","blick"}),
	    "Das dichte Blaetterdach verhindert jeden Blick auf den Himmel. "
            "Es dringt nur wenig Licht bis auf den Weg vor.");

  AddDetail( ({"aura"}),
	    "Die Aura im Norden verpasst Dir ein mulmiges Gefuehl.");

  AddDetail( ({"licht"}),
	    "Es fehlt nur ganz wenig Licht durch das dichte Blaetterdach. Im "
            "Norden ist eigentlich gar kein Licht mehr zu sehen.");
  
  AddDetail( ({"gefuehl","gefuehle"}),
	    "Seinen Gefuehlen sollte man oefter mal trauen.");

  AddDetail( ({"blaetter"}), 
            "An den Baeumen haengen viele Blaetter. Es sind auch einige auf "
            "den Boden gefallen.");

  AddDetail( ({"aeste"}),
	    "Am Boden liegen einige abgebrochene Aeste. Die Aeste an den "
            "Baeumen scheinen irgendwie nach Dir zu greifen. Du fuehlst Dich "
            "hier nicht besonders wohl.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({""}), 
            "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({""}), 
            "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({""}), 
            "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Tod.");  
 
  AddSmell( ({"tod"}),
	   "Es riecht nicht besonders gut. Du solltest besser von hier "
           "verschwinden.");

  AddSound(DEFAULT_SOUND, "Es herrscht Totenstille.");

  AddSound( ({"totenstille","stille"}),
	   "Die Totenstille beruhigt Dich nicht wirklich.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "zww13");
AddSpecialExit( "norden", "go_norden" );

}
int go_norden(string dir)
{

  if(!(present("marlog", TO)))
  {
    write( BS( "Du traust Dich momentan nicht weiter in den dunklen Wald "
               "hinein.") );
    say("Vor Angst schlotternd dreht"+TP->Name(WEN)+" um, da der dunkle Wald "
      "im Norden doch zu gefaehrlich scheint.\n");
  return -1;
  }
}
