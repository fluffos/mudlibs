// von Chivas

inherit "/d/gebirge/angrox/room/std_bergwerk_new";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int eisenzahl;

void create()
	
{
  ::create();

  eisenzahl=3;

  SetProp( P_INT_SHORT, "In einem Stollen");
  SetProp( P_INT_LONG,
	"Der Stollen findet hier ein abruptes Ende. Die Zwerge sind gerade "
	"dabei hier die Metalle abzubauen und sind dementsprechend noch nicht "
	"weiter ins Innere der Hochebene vorgedrungen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"stollen","ende","stollens"}), 
            "Du hast das Ende des Stollens erreicht. Die Zwerge sind noch "
	    "nicht weiter vorgedrungen.");

  AddDetail( ({"zwerge","zwergen"}),
	    "Die Zwerge schuerfen hier in den Stollen nach Edelmetallen.");
  
  AddDetail( ({"metalle","edelmetalle","edelmetallen"}), 
            "Man findet hier in den Stollen hauptsaechlich Eisen. Es gibt nur "
	    "ab und zu Gold und Silber hier zu finden.");

  AddDetail( ({"innere"}),
	    "Die Zwerge sind noch nicht soweit in das Innere der Hochebene "
	    "vorgedrungen.");
  
  AddDetail( ({"hochebene","gorthad"}), 
            "Die Hochebene von Gorthad befindet sich weit ueber Dir.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen zahlreiche Steine.");
  
  AddDetail( ({"wand","waende","waenden"}), 
            "Die Waende sind nur grob behauen und man erkennt Schuerfspuren "
	    "von den Zwergen. Ausserdem haengen einige Fackeln an den "
	    "Waenden.");

  AddDetail( ({"decke"}),
	    "Die Decke ist nur grob behauen und sehr sehr uninteressant.");
  
  AddDetail( ({"eisen"}), 
            "Man findet hauptsaechlich Eisen in den Stollen.");

  AddDetail( ({"gold","silber"}),
	    "Gold und Silber sind sehr kostbar. Leider findet man recht wenig "
	    "davon hier in den Stollen.");
  
  AddDetail( ({"steine"}), 
            "Die Steine sind beim Schuerfen von den Waenden abgebrochen.");

  AddDetail( ({"schuerfspuren","spuren","schuerfen"}),
	    "Man erkennt ganz deutlich wo die Zwerge an den Waenden geschuerft "
	    "haben.");
  
  AddDetail( ({"fackeln"}),
	    "Die Fackeln an den Waenden erhellen den Stollen ein wenig.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht hier einfach nur stickig.");  

  AddSound(DEFAULT_SOUND, "Du hoerst ein Haemmern.");

  AddSound( ({"haemmern"}),
	   "Das Haemmern kommt aus den anderen Stollen.");
  
//-----Details Ende-----
AddItem(NPC "zwerga", REFRESH_DESTRUCT);
  
AddExit("sueden", ROOM "zwfest4");

//AddCmd( ({"bau","baue" }), "bauen" );

}
