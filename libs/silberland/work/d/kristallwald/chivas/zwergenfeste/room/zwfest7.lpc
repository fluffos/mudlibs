// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Stollen");
  SetProp( P_INT_LONG,
	"Der breite Stollen in dem Du stehst fuehrt nach Sueden und nach "
	"Norden. Ausserdem fuehrt eine breite Treppe wieder hinauf in die "
	"Zwergenfeste. Einige Fackeln haengen an den Waenden und erhellen "
	"den Stollen, in dem die Zwerge nach Metallen schuerfen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"stollen"}), 
            "Du bist in den Stollen der Zwerge, wo diese Eisen abbauen und ab "
	    "und zu ein wenig Gold und Silber.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit Felsbrocken uebersaeht. Ausserdem sieht man "
	    "Schienen, die von Norden nach Sueden verlaufen.");
  
  AddDetail( ({"sueden","norden"}), 
            "Der Stollen verlaeuft vom Norden nach Sueden.");

  AddDetail( ({"treppe"}),
	    "Eine Treppe fuehrt nach oben in die Zwergenfeste zurueck.");
  
  AddDetail( ({"zwergenfeste","ardhmir"}), 
            "Du befindest Dich in den Stollen unter der Zwergenfeste von "
	    "Ardhmir.");

  AddDetail( ({"fackeln","licht"}),
	    "Viele Fackeln haengen an den Waenden und erhellen den Stollen.");
  
  AddDetail( ({"wand","waende","waenden"}), 
            "Die Waende sind mit Rissen uebersaeht. Ausserdem haengen einige "
	    "Fackeln an den Waenden und spenden Licht.");

  AddDetail( ({"zwerge"}),
	    "Die Zwerge arbeiten hier und bauen das Metall ab.");
  
  AddDetail( ({"metallen","metalle","metall"}), 
            "Die Zwerge bauen die Metalle unter der Hochebene hier ab. Es "
	    "handelt sich hauptsaechlich um Eisen, aber auch Gold und Silber "
	    "sind ab und zu zu finden.");

  AddDetail( ({"decke"}),
	    "Die Decke ist rissig.");
  
  AddDetail( ({"eisen"}), 
            "Es wird hier viel Eisen abgebaut.");

  AddDetail( ({"gold"}),
	    "Gold ist sehr schoen, leider findet man es hier nur selten.");
  
  AddDetail( ({"silber"}), 
            "Silber glaenzt herrlich, leider hier nur selten.");

  AddDetail( ({"felsbrocken","brocken","steinbrocken"}),
	    "Einige Felsbrocken liegen am Boden. Die Schienen wurden jedoch "
	    "von den Steinbrocken befreit.");
  
  AddDetail( ({"schienen","stollenwagen"}), 
            "Die Schienen sind fuer die Stollenwagen, in denen die Zwerge das "
	    "abgebaute Metall abtransportieren.");

  AddDetail( ({"rissen","risse"}),
	    "Es sind viele Risse in den Waenden und der Decke zu sehen.");
  
  AddDetail( ({"hochebene","gorthad"}), 
            "Du befindest Dich tief unterhalb der Hochebene von Gorthad.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Rauch.");  
 
  AddSmell( ({"rauch","fackeln"}),
	   "Der Rauch kommt von den Fackeln.");

  AddSound(DEFAULT_SOUND, "Du hoerst in der Ferne die Zwerge haemmern.");

  AddSound( ({"ferne","zwerge"}),
	   "*haemmer*");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "zwfest8");
AddExit("oben", ROOM "zwfe13");
AddExit("norden", ROOM "zwfest6");
}
