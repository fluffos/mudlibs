// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Ein umgefallener Baumstamm versperrt den Weg nach Sueden. Er ist "
        "umgefallen und mitten auf dem Weg zum liegen gekommen. Ansonsten "
        "sieht man die Baeume ordentlich am Rand des Weges stehen. Zwischen "
        "ihnen ist dichtes Unterholz zu erkennen, dass es unmoeglich "
        "macht den Weg zu verlassen. Im Nordosten ist eine Lichtung im Wald zu "
        "sehen. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1);

//-----Details Anfang-----
  
  AddDetail( ({"baumstamm","sueden","stamm","baum","baums"}), 
            "Ein grosser mit Moos bewachsener Baum ist auf den Weg gefallen. "
            "Er scheint schon seit einiger Zeit hier zu liegen. Die einzige "
            "Chance um weiter nach Sueden zu kommen, ist ueber ihn zu "
            "klettern.");

  AddDetail( ({"weg","weges"}),
	    "Der Weg ist nach Sueden hin versperrt, da ein grosser Baumstamm "
            "quer ueber dem Weg liegt. Im Nordosten scheint eine Lichtung zu "
            "sein.");

  AddDetail( ({"baeume","rand","platz"}),
	    "Viele grosse Baeume stehen am Rand des Weges. Nur an der Stelle, "
            "wo der umgefallene Baum gestanden hat, ist eine Bresche zu "
            "sehen. In der Bresche wachsen jedoch schon wieder junge Baeume "
            "nach um den Platz auszufuellen.");

  AddDetail( ({"unterholz"}),
	    "Das Unterholz zwischen den Baeumen macht es unmoeglich an dem "
            "Baumstamm vorbei zu gehen. Selbst die Bresche, die der "
            "umgefallene Baum geschlagen hat, ist schon wieder mit Bueschen "
            "und kleinen Baeumen bewachsen.");
  
  AddDetail( ({"nordosten","lichtung"}),
	    "Im Nordosten scheint eine grosse Lichtung zu sein. Um mehr zu "
            "sehen, musst Du schon naeher ran gehen. Dort scheint auch ein "
            "See zu sein.");

  AddDetail( ({"wald"}), 
            "Der Wald ist um Dich herum und besteht komischerweise aus "
            "Baeumen.");

  AddDetail( ({"boden"}),
	    "Am Boden des Weges sind einige Blaetter, Steine und Erde zu "
            "sehen. Die Blaetter sind sicher von den Baeumen herab gefallen, "
            "denn wo sollten sie sonst herkommen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist nur teilweise durch das Blaetterdach zu sehen, "
            "obwohl es im Nordosten ein wenig lichter wird und er auch "
            "ein bisschen durch die Luecke im Blaetterdach zu sehen ist, die "
            "der umgefallene Baum hinterlassen hat. Er scheint blau zu sein.");

  AddDetail( ({"chance","chancen"}),
	    "Wenn sich einem eine Chance bietet, dann sollte man sie auch "
            "ergreifen.");
  
  AddDetail( ({"moos"}),
	    "Das Moos waechst fast auf dem gesamten Baumstamm, Es ist das "
            "beste Zeichen dafuer, dass der Stamm hier schon eine Weile "
            "liegt.");

  AddDetail( ({"zeit","weile"}), 
            "Der Baumstamm liegt schon eine lange Zeit quer ueber den Weg. "
            "Es fuehlt sich anscheinend niemand dafuer verantwortlich ihn "
            "einmal aus dem Weg zu schaffen.");

  AddDetail( ({"zeichen","umfallen"}),
	    "Ein anderes Zeichen, dass der Baum schon eine laengere Zeit "
            "umgefallen ist, ist die schon fast wieder zugewachsene Bresche, "
            "die der Baum beim Umfallen geschlagen hat.");

  AddDetail( ({"bresche","stelle"}),
	    "Die Bresche, die der umgefallene Baum geschlagen hat, ist schon "
            "wieder mit Bueschen und jungen Baeumen bewachsen. Die grossen "
            "Wurzeln des umgefallenen Baums ragen in die Hoehe.");

  AddDetail( ({"buesche","bueschen"}),
	    "Es sind kleine Buesche mit Dornen, so dass man nicht an ihnen "
            "vorbei den Baumstamm umgehen kann. Man muss schon ueber den "
            "Baumstamm klettern um weiter nach Sueden zu kommen.");
  
  AddDetail( ({"see"}),
	    "Du kannst den See nur erahnen. Geh naeher ran und schau nach.");

  AddDetail( ({"blaetterdach","dach","luecke"}), 
            "Das Blaetterdach ist dicht, wenn man von der Luecke absieht, den "
            "der umgefallene Baum hinterlassen hat.");

  AddDetail( ({"blaetter"}),
	    "Es gibt sehr viele Blaetter an den Baeumen. Natuerlich liegen "
            "auch einige auf dem Boden des Weges.");

  AddDetail( ({"steine","steinchen","wert","kieselsteine"}),
	    "Die kleinen Steinchen, die Du zwischen den Blaettern am Boden "
            "sehen kannst, haben keinen Wert. Es sind ganz normale kleine "
            "Kieselsteine.");

  AddDetail( ({"erde"}),
	    "Die Erde ist ein wenig feucht, da die Sonne unter dem dichten "
            "Blaetterdach den Boden nicht so schnell austrocknen kann.");
  
  AddDetail( ({"dornen"}),
	    "Die Dornen der Buesche sehen spitz aus. Sie verhindern, dass Du "
            "am Baumstamm vorbei gehen kannst.");

  AddDetail( ({"wurzeln","hoehe"}), 
            "Die Wurzeln ragen in einer wirren Form in die Hoehe.");

  AddDetail( ({"sonne"}),
	    "Die Sonne steht hoechstwahrscheinlich am Himmel.");

  AddDetail( ({"form"}),
	    "Die Form sieht aus wie ein Kunstwerk.");

  AddDetail( ({"kunstwerk"}),
	    "Es scheint moderne Kunst zu sein.");
  
  AddDetail( ({"kunst"}),
	    "Du hast leider von Kunst keine Ahnung und schon gar nicht von "
            "moderner und abstrakter Kunst. Geh lieber weiter.");

  AddDetail( ({"ahnung"}), 
            "Du hast keine Ahnung und davon besonders viel.");

  AddDetail( ({"voegel"}),
	    "Die Voegel sitzen irgendwo zwischen den Blaettern und Du kannst "
            "sie nicht sehen, nur hoeren.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht unglaublich waldig.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel im Blaetterdach.");

  AddSound( ({"voegel"}),
	   "*triller*");
  
//-----Details Ende-----
  
AddExit("nordosten", ROOM "zww5");

AddCmd( ({"kletter", "klettere" }), "klettern" );

}
int klettern(string str)
{
   notify_fail("Wo moechtest Du drueber klettern?\n");
   if ( member( ({ "ueber baum","ueber baumstamm","ueber stamm" }),str) != -1) 
  {
    write(BS ( "Du kletterst ohne viel Muehe ueber den auf den Weg gefallenen "
               "Baumstamm.\n"));
      TP->move( ROOM "zww3", M_GO, 
      "ueber einen Baumstamm", "klettert", 
      "klettert ueber einen Baumstamm herein");
    return 1;
  }
}

