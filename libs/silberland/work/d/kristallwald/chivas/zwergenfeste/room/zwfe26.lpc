// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Im Palast von Ardhmir");
  SetProp( P_INT_LONG,
	"Du bist im noerdlichen Teil des Palastes von Ardhmir. Die Zwerge "
	"haben besonders viel Muehe investiert um den Palast in vollem "
	"Glanz der Zwergenkunst erstrahlen zu lassen. An den Waenden sind "
	"grosse Reliefs zu sehen und einige Statuen wurden hier aufgestellt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"teil"}), 
            "Du befindest Dich im noerdlichen Teil des Palastes.");

  AddDetail( ({"palast","palastes"}),
	    "Nach Suedosten geht es in die grosse Ratshalle von Ardhmir.");

  AddDetail( ({"ardhmir","zwergenfeste","feste"}),
	    "Du bist in der Zwergenfeste von Ardhmir.");

  AddDetail( ({"zwerge","muehe"}),
	    "Die Zwerge der Feste haben sich grosse Muehe gegeben den Palast "
	    "besonders schoen aussehen zu lassen.");
  
  AddDetail( ({"glanz","zwergenkunst","kunst","steinmetze"}),
	    "Durch die Reliefs an den Waenden und den grossen Statuen kann "
	    "man die ganze Kunst der Steinmetze von Ardhmir erkennen.");

  AddDetail( ({"waenden","waende","wand"}), 
            "An den Waenden sind grosse Reliefs zu erkennen. Zwischen den "
	    "Reliefs haengen gelb leuchtende Barinsteine, wie sie in ganz "
	    "Ardhmir zu sehen sind.");

  AddDetail( ({"reliefs"}),
	    "Die grossen Reliefs zeigen die Hochebene von Gorthad und einen "
	    "Plan von Ardhmir.");

  AddDetail( ({"statuen"}),
	    "Die Statuen sind Nachbildungen grosser Zwergenkrieger.");

  AddDetail( ({"boden"}),
	    "Der Boden besteht aus einem einzigen grossen Mosaik aus "
	    "Halbedelsteinen.");
  
  AddDetail( ({"decke"}),
	    "Die Decke ist weit ueber Dir, aber sie ist nicht besonders "
	    "interessant.");

  AddDetail( ({"ratshalle","halle","suedosten","geschicke","reich","reiches"}), 
            "Im Suedosten liegt die grosse Ratshalle von Ardhmir, in der die "
	    "Zwerge mit ihrem Herrscher die Geschicke des Reiches lenken.");

  AddDetail( ({"barinsteine","steine"}),
	    "Die Barinsteine an den Waenden erhellen die Halle in der Du "
	    "stehst, so dass Du hervorragend sehen kannst.");

  AddDetail( ({"nachbildungen","zwergenkrieger","krieger","ehre","kraft","gesichter","haltung","kampf"}),
	    "Es sind Nachbildungen beruehmter Zwergenkrieger, die sich im "
	    "Kampf bewaehrt haben. Ihre Gesichter sehen streng aus und "
	    "ihre ganze Haltung zeigt Ehre und Kraft.");

  AddDetail( ({"hochebene","gorthad","huegelgraeber","graeber"}),
	    "Auf der Hochebene sind sogar die kleinen und grossen "
	    "Huegelgraeber zu erkennen.");
  
  AddDetail( ({"plan"}),
	    "Der Plan zeigt Dir auch die versteckten Raeume von Ardhmir.");

  AddDetail( ({"raeume","augen","hilfe"}), 
            "Da Du aber lieber selber forschen willst, wendest Du ganz schnell "
	    "Deine Augen ab. Du willst sie ja ohne Hilfe finden.");

  AddDetail( ({"mosaik"}),
	    "Das Mosaik stellt zwei Drachen dar.");

  AddDetail( ({"halbedelsteinen","halbedelsteine"}),
	    "Die Halbedelsteine sind einiges wert, aber zu einem wundervollen "
	    "Mosaik zusammengefuegt, sogar unbezahlbar.");

  AddDetail( ({"herrscher"}),
	    "In der Ratshalle sitzt der Herrscher von Ardhmir.");
  
  AddDetail( ({"drachen"}),
	    "Man erkennt einen 'weissen Drachen' und einen 'schwarzen "
	    "Drachen'. Sie scheinen sich gegenseitig zu belauern.");

  AddDetail( ({"weissen drachen","weisser drache"}), 
            "Der weisse Drache sieht nett und freundlich aus.");

  AddDetail( ({"drache"}),
	    "Welchen Drachen meinst Du?");

  AddDetail( ({"schwarzer drache","schwarzen drachen"}),
	    "Der schwarze Drache schaut hinterhaeltig wie ein Dunkelelf.");

  AddDetail( ({"dunkelelf","dunkelelfen"}),
	    "Die Dunkelelfen sind als hinterhaeltig bekannt.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst ein wenig Rauch aus der Ratshalle "
		          "kommen.");  
 
  AddSmell( ({"rauch","rauches","geruch"}),
	   "Der Geruch des Rauches ist nicht sehr stark.");

  AddSound(DEFAULT_SOUND, "Du hoerst viel, aber nichts was Dich besonders "
		  "interessiert.");

//-----Details Ende-----
AddItem(NPC "blakaldur", REFRESH_DESTRUCT);

AddExit("suedosten", ROOM "zwfe27");
AddExit("sueden", ROOM "zwfe24");

}
