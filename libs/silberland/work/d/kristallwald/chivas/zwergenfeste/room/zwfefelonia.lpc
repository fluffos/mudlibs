// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Kammer in Felonia");
  SetProp( P_INT_LONG,
	"Die Kammer ist bis auf ein paar Schienen leer. Anscheinend gibt es "
        "hier die Moeglichkeit mit einem Stollenwagen in ein anderes "
        "Zwergenreich zu fahren. Direkt neben den Schienen steht ein kleines "
        "Schild." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"kammer"}), 
            "Die Kammer ist kahl und die Waende schmucklos bis auf die "
	    "Halterungen fuer die Fackeln. Ein paar Schienen verlaufen auf "
	    "dem Boden und verschwinden in einem grossen Loch in der Wand.");

  AddDetail( ({"schienen"}),
	    "Am Boden sind Schienen angebracht, die in einem Loch in der Wand "
	    "verschwinden. Sie sehen so aus, als ob sie recht haeufig "
	    "benutzt werden. Neben den Schienen steht ein Schild.");

  AddDetail( ({"moeglichkeit"}),
	    "Du solltest die Moeglichkeit nutzen und mehr im Silberland "
	    "kennen lernen.");

  AddDetail( ({"stollenwagen","wagen"}),
	    "Auf den Schienen fahren die Stollenwagen der Zwerge.");
  
  AddDetail( ({"zwergenreich","reich"}),
	    "Die Zwergenfeste von Ardhmir ist ein grosses Zwergenreich im "
	    "Silberland.");
  
  AddDetail( ({"schild"}), 
            "Du kannst es lesen.");

  AddDetail( ({"boden"}),
	    "Am Boden sind Schienen zu erkennen, die in einem Loch in der "
	    "Wand verschwinden. Neben den Schienen steht ein Schild.");

  AddDetail( ({"wand","waende","waenden"}),
	    "Die Waende sind kahl bis auf die Halterungen der Fackeln. "
	    "Ansonsten ist wie an der Decke nur der blanke Fels zu erkennen.");

  AddDetail( ({"decke"}),
	    "Die Decke ist uninteressant. Nur der blanke Fels ist zu sehen.");
  
  AddDetail( ({"zwergenfeste","ardhmir"}),
	    "Die Zwergenfeste von Ardhmir ist ein grosses Zwergenreich "
	    "unterhalb der Hochebene von Gorthad.");

  AddDetail( ({"kristallwald","region","gebirge"}), 
            "Der Kristallwald ist eine Region im Silberland. Momentan "
	    "befindest Du Dich in Felonia was in der Region Gebirge liegt.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Die Hochebene von Gorthad befindet sich in der Region "
	    "Kristallwald. Genauer gesagt liegt sie noerdlich von Roch Adan.");

  AddDetail( ({"silberland"}),
	    "Du befindest Dich im Silberland.");

  AddDetail( ({"felonia","stadt"}),
	    "Felonia ist eine Stadt im Gebirge, in der viele Zwerge leben.");
  
  AddDetail( ({"zwerge"}),
	    "Zwerge sind stark, mutig, aber auch ab und zu ein wenig "
	    "schmutzig.");

  AddDetail( ({"loch"}), 
            "Das breite Loch in der Wand fuehrt in einen dunklen Stollen. "
	    "Du traust Dich nicht diesen Weg zu gehen, aber vielleicht kannst "
	    "Du ihn ja fahren.");

  AddDetail( ({"stollen"}),
	    "Der Stollen ist sehr dunkel und Du kannst nicht viel erkennen. "
	    "Die Schienen verschwinden in dem Stollen und dessen Dunkelheit.");

  AddDetail( ({"weg","wege"}),
	    "Manchne Wege fuehren in interessante Gebiete.");

  AddDetail( ({"gebiete"}),
	    "Es gibt viele interessante Gebiete im Silberland.");
  
  AddDetail( ({"dunkelheit"}),
	    "Die tiefe Dunkelheit im Tunnel ist nicht zu durchdringen.");

  AddDetail( ({"fels"}), 
            "Der Fels wurde hier nicht bearbeitet und wirkt auf Dich "
	    "unglaublich uninteressant.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln erhellen die Kammer ein wenig.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen bestehen aus Eisen und sind nicht viel wert.");

  AddDetail( ({"eisen"}),
	    "Das Eisen der Halterungen hat schon ein wenig Rost angesetzt.");
  
  AddDetail( ({"rost"}),
	    "Der Rost schimmert roetlich im Schein der Fackeln.");

  AddDetail( ({"schein","licht"}), 
            "Der Schein der Fackeln erhellt die Kammer genuegend, so dass "
	    "man alles gut sehen kann. Nur in dem Stollen fehlt jegliches "
	    "Licht.");

  AddDetail( ({"tunnel"}),
	    "Der Tunnel ist ein Stollen der Zwerge.");

  AddDetail( ({"roch","adan","roch adan","stadt","zentauren"}),
	    "Roch Adan ist die Stadt der Zentauren.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Feuer.");  
 
  AddSmell( ({"feuer","geruch","fackeln"}),
	   "Der Geruch stammt von den Fackeln.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Fackeln flackern.");

  AddSound( ({"fackeln","flackern"}),
	   "*flacker*flacker*flacker*flacker*");

  AddReadDetail( ({"schild"}),
		"+-------------------------------+\n"
                "| Hier kannst Du mit einem      |\n"
                "| Stollenwagen in die Zwergen-  |\n"
                "| feste von Ardhmir reisen.     |\n"
                "| Wenn ein Wagen da ist, kannst |\n"
                "| Du ihn mit 'kletter in wagen' |\n"
                "| besteigen und dann beginnt    |\n"
                "| auch bald die Fahrt.          |\n"
                "|                               |\n"
                "| Viel Glueck!                  |\n"
                "|                               |\n"
                "+-------------------------------+\n");


//-----Details Ende-----
  
AddExit("norden", "/d/gebirge/dusty/zwerge/room/gang03");

}
