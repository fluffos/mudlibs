// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Ein grosser Baumstamm liegt quer ueber den Weg in Richtung Norden. "
        "Er ist im Wald umgefallen und hier zum liegen gekommen. Eine kleine "
        "Schneise wurde in den Wald gerissen, die jedoch schon wieder von "
        "kleinen Baeumen ausgefuellt wird." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1);

//-----Details Anfang-----
  
  AddDetail( ({"baumstamm","stamm","baum"}), 
            "Ein grosser Baumstamm liegt quer ueber den Weg. Wenn Du weiter "
            "nach Norden willst, musst Du schon ueber den Baumstamm klettern. "
            "Er ist mit Moos bewachsen.");

  AddDetail( ({"weg","suedwesten","weges"}),
	    "Der Weg ist nach Norden durch den umgefallenen Baumstamm "
            "versperrt. Nach Suedwesten kannst Du ohne Probleme gehen.");

  AddDetail( ({"richtung","norden"}),
	    "In Richtung Norden ist der Weg durch den Baumstamm versperrt.");

  AddDetail( ({"wald"}),
	    "Der Wald ist um Dich herum. Grosse Baeume stehen am Rand des "
            "Weges. Es gibt nur eine Stelle wo keine grosse Baeume stehen.");
  
  AddDetail( ({"schneise","bresche"}),
	    "In der Bresche, die der umgefallene Baumstamm gerissen hat, "
            "wachsen schon wieder kleine Baeume und einige Straeucher.");

  AddDetail( ({"baeumen","baeume","rand"}), 
            "Es gibt grosse Baeume im Wald und einige kleine junge "
            "Sproesslinge, die in der Bresche nachwachsen und langsam die "
            "Stelle, wo der Baum gestanden hat, auffuellen.");

  AddDetail( ({"boden"}),
	    "Am Boden sind einige Blaetter und feuchte Erde zu sehen.");

  AddDetail( ({"himmel"}),
	    "Du kannst den Himmel nur leicht durch das Blaetterdach sehen. "
            "Da wo der umgefallene Baum eine Luecke in das Blaetterdach "
            "gerissen hat, ist der Himmel blau.");

  AddDetail( ({"moos"}),
	    "Viel gruenes Moos ist an dem Baumstamm zu sehen. Es ist ein "
            "Zeichen dafuer, dass er schon sehr lange so hier liegt.");
  
  AddDetail( ({"probleme"}),
	    "Du hast keine grossen Probleme.");

  AddDetail( ({"stelle"}), 
            "An dieser Stelle hat der umgefallene Baum eine Schneise oder "
            "Bresche in den Wald geschlagen.");

  AddDetail( ({"sproesslinge"}),
	    "Einige Sproesslinge wachsen in der Schneise.");

  AddDetail( ({"blaetter"}),
	    "Viele Blaetter haengen an den Aesten der Baeume und einige sind "
            "auch zu Boden gefallen.");

  AddDetail( ({"erde"}),
	    "Die Erde ist feucht.");
  
  AddDetail( ({"blaetterdach","dach","luecke"}),
	    "Es gibt eine Luecke im Blaetterdach, die der umgefallene Baum "
            "im Blaetterdach hinterlassen hat.");

  AddDetail( ({"aeste","aesten"}), 
            "Die Baeume haben grosse und kleine Aeste, wie es fuer Baeume in "
            "einem Wald ueblich ist.");

  AddDetail( ({"zeichen"}),
	    "Es ist schon sehr lange her. Dieses Zeichen erkennst Du sehr "
            "gut.");

  AddDetail( ({"straeucher"}),
	    "Die Straeucher sind schon sehr hoch gewachsen. Sie haben spitze "
            "Dornen.");

  AddDetail( ({"dornen"}),
	    "Die eng stehenden Straeucher in der Bresche mit seinen spitzen "
            "Dornen verhindern, dass Du einfach so den Baumstamm umgehen "
            "kannst.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht waldig.");  
 
  AddSound(DEFAULT_SOUND, "Es ist recht still.");

//-----Details Ende-----
  
AddExit("suedwesten", ROOM "zww2");

AddCmd( ({"kletter", "klettere" }), "klettern" );

}
int klettern(string str)
{
   notify_fail("Wo moechtest Du drueber klettern?\n");
   if ( member( ({ "ueber baum","ueber baumstamm","ueber stamm" }),str) != -1) 
  {
    write(BS ( "Du kletterst ohne viel Muehe ueber den auf den Weg gefallenen "
               "Baumstamm.\n"));
      TP->move( ROOM "zww4", M_GO, 
      "ueber einen Baumstamm", "klettert", 
      "klettert ueber einen Baumstamm herein");
    return 1;
  }
}

