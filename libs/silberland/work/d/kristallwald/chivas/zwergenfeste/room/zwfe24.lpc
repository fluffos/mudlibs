// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Im Palast von Ardhmir");
  SetProp( P_INT_LONG,
	"Du stehst nun im Palast von Ardhmir. An den Waenden haengen "
	"leuchtende Barinsteine, die diese Halle vom Palast erhellen und "
	"wertvolle Wandteppiche verbergen den Fels. Am Boden sind ueberall "
	"kleine und grosse Mosaike zu sehen. Im Westen ist das grosse "
	"magische Tor, dass Du durchschritten hast um hier her zu kommen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"palast","palastes"}), 
            "Die ist der Palast von Ardhmir, in dem weiter im Osten die "
	    "grosse Ratshalle der Zwergenfeste sein soll.");

  AddDetail( ({"ardhmir","zwergenfeste","feste"}),
	    "Du bist im Palast der Zwergenfeste von Ardhmir.");

  AddDetail( ({"waende","waenden","wand"}),
	    "An den Waenden haengen Barinsteine und Wandteppiche.");

  AddDetail( ({"barinsteine","steine"}),
	    "Die Barinsteine erhellen den Palast mit ihrem gelblich warmen "
	    "Licht.");
  
  AddDetail( ({"halle","eingangshalle"}),
	    "Die Eingangshalle vom Palast ist reich verziert und an den "
	    "Waenden haengen riesige Wandteppiche.");

  AddDetail( ({"wandteppiche","teppiche","wandteppichen","teppich","teppiche","wandteppich"}), 
            "Die Wandteppiche zeigen Schmiede bei ihrer Arbeit, Steinmetze "
	    "beim Erstellen von Statuen und Krieger, die die Zwergenfeste "
	    "vor Angreifern verteidigen. Sie sind sehr detailreich und sicher "
	    "auch sehr wertvoll.");

  AddDetail( ({"fels","hoehle"}),
	    "Der Fels der Hoehle, in den der Palast gehauen wurde, ist kaum "
	    "zu erkennen, da er von grossen Wandteppichen zugehaengt ist.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit kleinen und grossen Mosaiken ausgelegt.");

  AddDetail( ({"mosaike","mosaiken"}),
	    "Die Mosaike wurden aus Halbedelsteinen zusammen gesetzt und "
	    "zeigen verschiedene Bilder.");
  
  AddDetail( ({"westen","tor"}),
	    "Im Westen ist das magische Tor, durch das man den Palast der "
	    "Zwerge betritt. Um das Tor herum sind lauter Runen zu sehen.");

  AddDetail( ({"zwerge"}), 
            "Viele Zwerge laufen durch den Palast und gehen ihren Aufgaben "
	    "nach.");

  AddDetail( ({"runen"}),
	    "Die Runen leuchten in einem magischen Blau.");

  AddDetail( ({"blau","leuchten"}),
	    "Das blaue Leuchten der Runen strahlt eine gewisse Macht aus.");

  AddDetail( ({"macht"}),
	    "Hoffentlich trifft Dich diese Macht nicht irgendwann einmal.");
  
  AddDetail( ({"aufgaben","beschaeftigungen"}),
	    "Es ist fuer Dich nicht ersichtlich, welche Aufgaben die Zwerge "
	    "zu erledigen haben.");

  AddDetail( ({"ratshalle","osten"}), 
            "Im Osten soll die grosse Ratshalle von Ardhmir sein, wo der "
	    "Herrscher ueber die Zwerge der Feste wacht. Um in die Ratshalle "
	    "zu gelangen, musst Du erst einmal nach Norden oder Sueden gehen.");

  AddDetail( ({"herrscher","zwerg"}),
	    "Der Herrscher von Ardhmir soll ein weiser Zwerg sein.");

  AddDetail( ({"norden","sueden","bereiche"}),
	    "Nach Norden und nach Sueden kommt man in andere Bereiche des "
	    "Palastes.");

  AddDetail( ({"licht"}),
	    "Das Licht der Barinsteine laesst Dich alles gut erkennen.");
  
  AddDetail( ({"schmiede","arbeit"}),
	    "Die Schmiede sind bei ihrer Arbeit sehr detailreich auf dem "
	    "Wandteppich dargestellt.");

  AddDetail( ({"steinmetze","erstellen","statuen","kunst"}), 
            "Die hohe Kunst der Steinmetze ist sehr liebevoll in den "
	    "Teppich gewebt worden.");

  AddDetail( ({"krieger","angreifer","angreifern","orks","trolle","trollen"}),
	    "Die Krieger auf dem Wandteppich verteidigen die zweite grosse "
	    "Halle von Ardhmir vor Orks und Trollen.");

  AddDetail( ({"halbedelsteinen","halbedelsteine"}),
	    "Die Halbedelsteine bilden wunderschoene Bilder auf dem Boden.");

  AddDetail( ({"bilder","gesichtern","gesichter","vergangenheit","baerte","baerten"}),
	    "Die Bilder zeigen die verschiedenen Herrscher aus der "
	    "Vergangenheit der Zwergenfeste. Du siehst Zwergenherrscher mit "
	    "langen Baerten und weisen Gesichtern.");
  
  AddDetail( ({"zwergenherrscher"}),
	    "Die Zwergenfeste hatte schon viele Herrscher in ihrer "
	    "Geschichte.");

  AddDetail( ({"geschichte"}), 
            "Die Geschichte der Zwergenfeste ist ruhmvoll.");

  AddDetail( ({"decke"}),
	    "Die Decke ist mit Ornamenten besetzt.");

  AddDetail( ({"ornamente"}),
	    "Die Ornamente sind sehr kunstvoll, aber nicht besonders "
	    "interessant.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach gar nichts. Die Luft ist gut.");  
 
  AddSmell( ({"luft"}),
	   "Die Luft riecht frisch.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Zwerge bei ihrer Arbeit.");

  AddSound( ({"zwerge","arbeit"}),
	   "Die Zwerge laufen umher und gehen ihren Beschaeftigungen nach. "
	   "Dabei verursachen sie natuerlich Geraeusche.");
  
  AddSound( ({"geraeusche"}),
	   "*taps*");

//-----Details Ende-----
  
AddExit("sueden", ROOM "zwfe25");
AddExit("norden", ROOM "zwfe26");
AddSpecialExit( "westen", "go_westen" );

}
int go_westen(string dir)
{

  if(!(present("koenigsaxt", TP)))
  {
    write( BS( "Du durchschreitest das magische Tor um den Palast von Ardhmir "
	       "zu verlassen und Deine Nackenhaare stellen sich auf. Das Tor "
	       "scheint Dich genau zu bewerten, ob Du ein Freund oder Feind "
	       "des Herrschers von Ardhmir bist.") );
  say(TPN+" durchschreitet das Tor nach Westen.\n");
   this_player()->move(ROOM "zwfe21", M_TPORT);
    return 1;
  }
  write(BS("Du durchschreitest das magische Tor um den Palast zu verlassen "
	   "und Deine Nackenhaare stellen sich auf. Ein Blitz trifft Dich als "
	   "Du weiter gehst. Anscheinend hat das magische Tor gemerkt, dass Du "
	   "die Axt des Herrschers aus dem Palast schmuggeln willst, die Dir "
	   "ja gar nicht gehoert."));
 
  say(TPN+" durchschreitet von einem Blitz getroffen das Tor nach Westen.\n");
  present("koenigsaxt",TP)->remove();
  TP->AddHp(-50);
  this_player()->move(ROOM "zwfe21", M_TPORT);
  return 1;
}
