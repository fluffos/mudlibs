// von Chivas

inherit "/d/gebirge/angrox/room/std_bergwerk_new";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl;

int eisenzahl;

void create()
	
{
  ::create();

  anzahl=1;
  eisenzahl=3;

  SetProp( P_INT_SHORT, "In einem Stollen");
  SetProp( P_INT_LONG,
	"Das Ende des Stollens ist hier erreicht. Aber wie es aussieht, wird "
	"hier sowieso nicht viel abgebaut. Am Ende des Stollen steht ein "
	"Tisch mit allen moeglichen Sachen darauf. Anscheinend wird hier eher "
	"Pause gemacht und Karten gespielt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"ende","stollens","stollen"}), 
            "Du bist am Ende dieses Stollen.");

  AddDetail( ({"tisch"}),
	    "Ein Tisch und mehrere Stuehle stehen in diesem Stollen. Hier "
	    "wird anscheinend Pause gemacht.");
  
  AddDetail( ({"sachen"}), 
            "Auf dem Tisch sind einige Spielkarten zu sehen, einige Glaeser "
	    "und ein paar Flaschen.");

  AddDetail( ({"pause"}),
	    "In diesem Stollen wird Pause gemacht, wenn nicht gearbeitet "
	    "wird.");
  
  AddDetail( ({"karten","spielkarten"}), 
            "Die Zwerge spielen anscheinend gerne Karten, wenn sie nicht "
	    "arbeiten muessen.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen viele Steine.");
  
  AddDetail( ({"decke"}), 
            "Die Decke ist nicht weit ueber Dir und einige Erzadern sind zu "
	    "sehen.");

  AddDetail( ({"wand","waende","waenden"}),
	    "An den Waenden haengen einige Fackeln, die den Stollen erhellen.");
  
  AddDetail( ({"fackeln","licht"}), 
            "Die Fackeln spenden genug Licht um hier Karten zu spielen oder "
	    "um sich einfach auszuruhen von der schweren Arbeit.");

  AddDetail( ({"erzadern","adern","eisen"}),
	    "Die Erzadern bestehen aus Eisen.");
  
  AddDetail( ({"glaeser","glaesern"}), 
            "Die Glaeser sind sehr schmutzig. Du wuerdest nicht aus diesen "
	    "Glaesern trinken.");

  AddDetail( ({"flaschen","flasche"}),
	    "Die Flaschen, die auf dem Tisch stehen, beinhalten den guten "
	    "Brandwein der Zwerge. Er gibt wieder viel Kraft, wenn man ihn "
	    "trinkt.");
  
  AddDetail( ({"stuehle"}), 
            "Die Stuehle sehen schon sehr alt und klapprig aus.");

  AddDetail( ({"arbeit"}),
	    "Die Arbeit in den Stollen ist sehr anstrengend und kraftraubend.");
  
  AddDetail( ({"brandwein"}), 
            "Vielleicht kannst Du ja eine Flasche fuer Dich stibitzen.");

  AddDetail( ({"zwerge"}),
	    "Die Zwerge gehen hier in den Stollen ihrer Arbeit nach.");
  
  AddDetail( ({"kraft"}), 
            "Der Brandwein gibt wieder viel Kraft.");

  AddDetail( ({"steine"}),
	    "Die Steine am Boden sind nicht sehr interessant.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Rauch.");  
 
  AddSmell( ({"rauch","geruch"}),
	   "Der Geruch nach Rauch kommt von den Fackeln.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Zwerge in den anderen Stollen "
		  "haemmern.");

  AddSound( ({"stollen","zwerge"}),
	   "*haemmer*");
  
//-----Details Ende-----
AddItem(NPC "zwerga", REFRESH_DESTRUCT);
  
AddExit("suedwesten", ROOM "zwfest4");

AddCmd( ({"stibitze","stibitz" }), "stibitzen" );
//AddCmd( ({"bau","baue" }), "bauen" );

}
int stibitzen(string str)
{
  object brandwein;
  notify_fail( "Was moechtest Du stibitzen?\n" );
  if ( member( ({ "flasche", "brandwein", "flasche brandwein"}), str ) != -1 ) 

   {
     if( anzahl < 1)
     {
        write("Es war sicher schon jemand vor Dir hier und hat eine Flasche "
	      "stibitzt. Falls Du jetzt auch eine mitnimmst, dann faellt es "
	      "auf. Du laesst es lieber sein.\n");
        return -1;
     }
      if ( present("brandwein",TP) )
      {
      write("Da Du bereits eine Flasche Brandwein hast, laesst Du die "
	    "anderen lieber stehen. Sei nicht so gierig.\n" );
      say(sprintf("%s ist ein wenig gierig.\n", TP->Name(WER)));
      return -1;
      }
      else
      {
        {brandwein = clone_object( OBJ "brandwein");
        if ( ME_TOO_HEAVY == brandwein->move(TP,M_GET|M_SILENT) )
 
          {
          write(
          "Die Flasche Brandwein wuerde Dir zu schwer werden.\n" );
          say(BS(sprintf("%s ist einfach nur ein Weichei.\n", TP->Name(WER))));
          brandwein -> remove();
          return 1;
          }
          else
          {
          write("Du schaust Dich um ob keiner schaut und steckst schnell "
	        "eine Flasche Brandwein ein.\n");
          say(sprintf("%s steckt heimlich eine Flasche Brandwein ein.\n",
          TP->Name(WER)));
          anzahl--;
          return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}
void reset()
{
  ::reset();
  anzahl=1;
}
