// von Chivas

inherit "/d/gebirge/angrox/room/std_bergwerk_new";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int eisenzahl;

void create()
	
{
  ::create();

  eisenzahl=3;

  SetProp( P_INT_SHORT, "In einem Stollen");
  SetProp( P_INT_LONG,
	"Der Stollen ist hier zu Ende und nur noch der Weg zurueck nach "
	"Nordosten ist moeglich. Viele Steinbrocken liegen am Boden, die die "
	"Arbeiter noch nicht abtransportiert haben. Pass auf, dass Du nicht "
	"ueber einen faellst und Dir was brichst." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"stollen"}), 
            "Der Stollen ist hier schon zu Ende. Es geht noch nicht weiter.");

  AddDetail( ({"ende"}),
	    "Du hast das Ende des Stollen erreicht.");
  
  AddDetail( ({"weg","nordosten"}), 
            "Du kannst nur zurueck nach Nordosten gehen.");

  AddDetail( ({"steinbrocken"}),
	    "Viele grosse Steinbrocken liegen am Boden, die noch von den "
	    "Zwergen weggeraeumt werden muessen, bis die Arbeiten hier weiter "
	    "gehen.");
  
  AddDetail( ({"boden"}), 
            "Am Boden liegen sehr viele Steinbrocken, die die Zwerge noch "
	    "abtransportieren muessen.");

  AddDetail( ({"arbeiter","zwerge"}),
	    "Die Zwerge haben hier noch viel zu tun.");
  
  AddDetail( ({"wand","waende","waenden"}), 
            "An den Waenden sieht man die Arbeiten der Zwerge und es haengen "
	    "einige Fackeln an den Waenden, die den Stollen erhellen.");

  AddDetail( ({"decke"}),
	    "Die Decke ist hier recht niedrig. Die Arbeiten sind hier noch "
	    "nicht abgeschlossen.");
  
  AddDetail( ({"arbeiten","abbau"}), 
            "Die Arbeiten und der Abbau der Metalle muss hier noch fortgesetzt "
	    "werden.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln erhellen den Stollen.");
  
  AddDetail( ({"metalle","eisen"}), 
            "Die verschiedensten Metalle werden hier von den Zwergen abgebaut, "
	    "aber hauptsaechlich ist es Eisen.");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es ist heiss und stickig.");  

  AddSound(DEFAULT_SOUND, "Du hoerst die Zwerge in den Stollen arbeiten.");

  AddSound( ({"zwerge"}),
	   "Du hoerst wie die Zwerge in den Stollen Eisen abbauen.");
  
//-----Details Ende-----
AddItem(NPC "zwerga", REFRESH_DESTRUCT);
  
AddExit("nordosten", ROOM "zwfest8");

//AddCmd( ({"bau","baue" }), "bauen" );

}
