// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl;

void create()
	
{
  ::create();

  anzahl = 2;

  SetProp( P_INT_SHORT, "Im Palast von Ardhmir");
  SetProp( P_INT_LONG,
	"Der suedliche Teil des Palastes ist mit lauter Waffen und Schilden "
        "an den Waenden behangen. Ausserdem stehen die kunstvollsten "
	"Ruestungen in der Halle die Du jemals gesehen hast. Auch am Boden ist "
	"wie in den anderen Raeumen des Palastes wieder ein grosses Mosaik zu "
	"sehen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"teil","halle"}), 
            "Du bist im suedlichen Teil des Palastes. Diese Halle ist "
	    "anscheinend den Schmieden von Ardhmir gewidmet, da hier ueberall "
	    "Kunstwerke der Schmiede zu bewundern sind.");

  AddDetail( ({"palast","palastes"}),
	    "Der Palast von Ardhmir ist besonders kunstvoll von den Zwergen "
	    "hergerichtet worden.");

  AddDetail( ({"waffen","waffe"}),
	    "Du erkennst riesige Aexte, Schwerter, aber auch andere Waffen, "
	    "die Du noch nie gesehen hast. Auch die Dir unbekannten Waffen "
	    "sehen todbringend aus.");

  AddDetail( ({"wand","waende","waenden","schmiedekunst"}),
	    "An den Waenden der Halle haengen lauter gefaehrliche Waffen, die "
	    "die Schmiedekunst von Ardhmir wiederspiegeln. Auch einige "
	    "Barinsteine haengen an den Waenden und erhellen die Halle.");
  
  AddDetail( ({"ruestungen"}),
	    "Die Ruestungen sehen so aus, als ob keine Waffe des Silberlandes "
	    "sie durchdringen koennte. Verschiedene Gravuren sind als "
	    "Verschoenerung auf ihnen in Gold und Silber angebracht.");

  AddDetail( ({"boden"}), 
            "Am Boden ist ein riesiges Mosaik aus Halbedelsteinen zusammen "
	    "gesetzt worden.");

  AddDetail( ({"mosaik"}),
	    "Das Mosaik aus Halbedelsteinen stellt anscheinend die Goetter "
	    "und Magier im Silberland dar. Ganz im Vordergrund sind Woody und "
	    "Dusty zu erkennen. Dahinter stehen die Erzmagier und andere "
	    "Magier.");

  AddDetail( ({"raeume","raeumen","mosaike"}),
	    "Die Raeume des Palastes besitzen alle Mosaike am Boden.");

  AddDetail( ({"decke"}),
	    "Die Decke ist weit ueber Dir. Sie ist mit einer wunderschoenen "
	    "Deckenbemalung ausgestattet.");
  
  AddDetail( ({"kunstwerke"}),
	    "Damit sind die Ruestungen, Waffen und Schilde gemeint.");

  AddDetail( ({"zwerge","zwergen"}),
	    "Viele hundert Zwerge wohnen hier in der Zwergenfeste.");

  AddDetail( ({"schmieden","schmiede","kunstfertigkeit","besten"}), 
            "Die Schmiede der Zwerge gehoeren zu den Besten des Silberlandes. "
	    "Vor allem die Schmiede von Ardhmir sind fuer ihre Kunstfertigkeit "
	    "beruehmt.");

  AddDetail( ({"ardhmir","zwergenfeste"}),
	    "Du bist im Palast der Zwergenfeste von Ardhmir.");

  AddDetail( ({"schilden","schilde","groessen","formen","schild"}),
	    "Die Schilde haben verschiedene Groessen und Formen. Anscheinend "
	    "ist fuer jede Rasse im Silberland das passende Schild vorhanden.");

  AddDetail( ({"aexte","spezialitaet","intarsien","axtblaetter","axtblaettern"}),
	    "Die Aexte sehen besonders gefaehrlich aus. Sie sind ja auch eine "
	    "besondere Spezialitaet der Zwerge. Die Aexte sind hauptsaechlich "
	    "Aexte mit zwei Axtblaettern, die mit schwungvollen Intarsien "
	    "aus Gold und Silber verschoenert sind.");
  
  AddDetail( ({"schwerter","schwert","qualitaet"}),
	    "Die Schwerter haben eine besonders hohe Qualitaet. Jeder Paladin "
	    "wuerde am liebsten ein solches Schwert haben.");

  AddDetail( ({"barinsteine"}), 
            "Die Barinsteine an den Waenden erhellen die Halle, so dass Du "
	    "auch alles gut erkennen kannst.");

  AddDetail( ({"gravuren","verschoenerung"}),
	    "Die Gravuren sind in alter Zwergensprache geschrieben.");

  AddDetail( ({"halbedelsteinen","halbedelsteine"}),
	    "Die Halbedelsteine bilden ein wunderschoenes Mosaik am Boden.");

  AddDetail( ({"silberlandes","silberland"}),
	    "Du bist im Silberland.");
  
  AddDetail( ({"goetter","vordergrund","woody","dusty","goettern"}),
	    "Woody und Dusty winken Dir auf dem Mosaik zu und laecheln Dich "
	    "an. Wink doch mal zurueck.");

  AddDetail( ({"erzmagier","angrox","feyaria","protheg","balanceantraege","wolle"}), 
            "Die Erzmagier hinter den Goettern sind Angrox, Feyaria und "
	    "Protheg, die ueber irgendetwas diskutieren. Anscheinend haben "
	    "sie sich bezueglich irgendwelcher Balanceantraege von kleinen "
	    "Magiern in der Wolle.");

  AddDetail( ({"magier","hasibaerchi","hicks","hiri","magiern","hintergrund"}),
	    "Im Hintergrund stehen die kleinen Magier, wie Hasibaerchi, Hicks, "
	    "Hiri und noch viele andere. Ein Magier mit einem X faellt Dir "
	    "besonders auf.");

  AddDetail( ({"rasse","rassen"}),
	    "Es gibt viele Rassen im Silberland.");

  AddDetail( ({"paladin","paladine","gilde"}),
	    "Die Paladine sind eine Gilde im Silberland. Sie kaempfen mit "
	    "einem Schwert.");
  
  AddDetail( ({"zwergensprache","sprache"}),
	    "Die alte Sprache der Zwerge verstehst Du nicht.");

  AddDetail( ({"magier mit einem x","x","bugs","typos","delgo","chivas","umhang"}), 
            "Der Magier mit einem aufgenaehten X auf dem Umhang ist Delgo. "
	    "Delgo ist dafuer verantwortlich alle Typos und Bugs von Chivas "
	    "und den anderen Magiern auszubessern. Dafuer moegen ihn die "
	    "anderen Magier auch und lassen ihn mitspielen.");

  AddDetail( ({"aufgaben"}),
	    "Die Zwerge hier im Palast haben vielfaeltige Aufgaben. Die einen "
	    "putzen, andere wiederum bauen etwas und wieder andere bewachen "
	    "den Palast.");

  AddDetail( ({"gold","silber","glaenzen","metalle"}),
	    "Die Zwerge verarbeiten sehr gerne Gold und Silber. Das Glaenzen "
	    "der Metalle gefaellt den Zwergen ganz besonders.");

  AddDetail( ({"deckenbemalung","bemalung","himmel","wolken","voegel"}),
	    "Die Deckenbemalung zeigt den Himmel. Du erkennst Wolken und "
	    "Voegel. Ein riesiger Barinstein, der besonders hell leuchtet, "
	    "stellt die Sonne dar. Man koennte wirklich fast denken, man "
	    "waere unter freiem Himmel und nicht in einer Hoehle.");
  
  AddDetail( ({"barinstein","sonne"}),
	    "Ein besonders grosser und hell leuchtender Barinstein stellt die "
	    "Sonne am Himmel dar. Es ist der groesste Barinstein, den Du in "
	    "Ardhmir bisher gesehen hast.");
  
  AddDetail( ({"hoehle"}),
	    "Es sieht hier wirklich nicht wie in einer Hoehle aus.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig rauchig aus dem Nordosten.");  
 
  AddSmell( ({"nordosten","rauch","geruch"}),
	   "Geh hin und schau nach, woher der Geruch nach Rauch kommt.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Zwerge wie sie im Palast ihre "
		  "Aufgaben erledigen und miteinander reden.");

  AddSound( ({"zwerge"}),
	   "Schaem Dich, man belauscht niemanden.");
  
//-----Details Ende-----
  
AddExit("nordosten", ROOM "zwfe27");
AddExit("norden", ROOM "zwfe24");

AddCmd( ({"wink","winke" }), "winken" );

}
void reset()
{
  ::reset();
  anzahl=1;
}
int winken(string str)
{
   notify_fail("Wem willst Du zurueck winken?\n"); 
   if ( member( ({ "goettern zurueck","woody und dusty zurueck","woody zurueck","dusty zurueck" }),str) != -1) 
  {
    write(BS ( "Du winkst Woody und Dusty zurueck "
               "und Du fuehlst wie Dich eine mystische Macht durchstroemt. "
               "Du fuehlst Dich eindeutig besser.\n"));
    say( TPN+" sieht auf einmal viel besser aus.\n");
    if ( anzahl )
    {
      TP -> heal_self(20+random(10));
      anzahl--;
    }
    return 1;
  }
}
