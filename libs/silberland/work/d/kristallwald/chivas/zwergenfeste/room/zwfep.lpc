


inherit "/std/room";

#include "../def.h"
#include "/mail/post.h"
#include <properties.h>
#include <rooms.h>
#include  <moving.h>

create(argh) {
  int i;
  (::create());

  AddRoomMessage( ({ "Einige Postangestellte laufen umher und sortieren in "
		     "Hektik die Post der Zwerge.\n"}), 30, "sound" );

  SetProp(P_INT_SHORT,"Im Postamt von Ardhmir");
  SetProp(P_INT_LONG,
          "Du stehst im Postamt von Ardhmir. An den Waenden stehen grosse "
          "Regale, auf denen sich die Briefe und kleine Pakete stapeln. An der "
          "Decke haengt ein grosser Kronleuchter, an denen hunderte von "
          "Kerzen brennen und im Postamt Licht spenden.\n" 
          "                                                              \n"
          "Wenn Du das willst, tippe 'post' oder 'mail', bzw. 'mail <spieler>'.\n");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"postamt","amt","post"}), 
            QueryProp(P_INT_LONG));

  AddDetail( ({"ardhmir","zwergenfeste"}),
	    "Du bist nun im Postamt der Zwergenfeste von Ardhmir. Auch die "
	    "Zwerge verschicken gerne Briefe und bekommen welche.");

  AddDetail( ({"waende","waenden","wand"}),
	    "An den Waenden stehen viele Regale, die bis oben hin mit Briefen "
	    "und Paketen gefuellt sind. Anscheinend herrscht in Ardhmir ein "
	    "reger Postbetrieb.");
  
  AddDetail( ({"regale","last"}),
	    "Die Regale an den Waenden brechen beinahe unter der Last der "
	    "Briefe und Pakete zusammen.");

  AddDetail( ({"briefe","briefen"}),
	    "Hunderte von Briefen liegen auf den Regalen und warten darauf "
	    "von den Zwergen abgeholt zu werden.");
  
  AddDetail( ({"pakete","paketen"}),
	    "Viele kleine Pakete liegen auf den Regalen. Es waere schon "
	    "interessant zu wissen, was da verschickt wird, aber das "
	    "Postgeheimnis verhindert Deine Neugier.");

  AddDetail( ({"decke"}),
	    "An der Decke haengt ein grosser Kronleuchter, der das Postamt "
	    "von Ardhmir erhellt.");
  
  AddDetail( ({"kronleuchter"}),
	    "An dem Kronleuchter brennen hunderte von Kerzen und erhellen "
	    "das Postamt. Die ganzen Kerzen morgens anzuzuenden ist schon "
	    "eine langwierige Arbeit.");

  AddDetail( ({"kerzen","licht"}),
	    "Die Kerzen tauchen das Postamt in ein sanftes gelbliches Licht, "
	    "so dass man alles gut sehen kann.");
  
  AddDetail( ({"boden"}),
	    "Der Boden besteht aus Stein und einige groessere Pakete stehen "
	    "auf ihm, die nicht in die Regale gepasst haben oder zu schwer "
	    "fuer die Regale gewesen waeren.");

  AddDetail( ({"zwerge"}),
	    "Es ist kaum zu glauben, aber die meisten Zwerge von Ardhmir "
	    "koennen lesen und schreiben.");
  
  AddDetail( ({"postbetrieb"}),
	    "Es werden viele Briefe und Pakete in der Zwergenfeste "
	    "verschickt.");

  AddDetail( ({"neugier","postgeheimnis"}),
	    "Du kannst Deine Neugier gerade so zuegeln, da Du ja auch nicht "
	    "willst, dass einer Deine Post liest.");
  
  AddDetail( ({"arbeit","morgen"}),
	    "Diese Arbeit moechtest Du nicht jeden Morgen machen.");

  AddDetail( ({"postangestellte","angestellte","hektik","sortieren"}),
	    "Einige Postangestellte sind am Sortieren der Briefe und Pakete "
	    "und wirken leicht gestresst.");

  AddDetail( ({"stein"}),
	    "Der Boden besteht aus Stein.");

  AddDetail( ({"gewicht"}),
	    "Die Pakete sind teilweise zu schwer und stehen auf dem Boden.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Papier und Wachs.");  
 
  AddSmell( ({"papier"}),
	   "Der Geruch nach Papier kommt von den Briefen.");

  AddSmell( ({"wachs"}),
	   "Der Geruch vom Wachs kommt von den hunderten von Kerzen am "
	   "Kronleuchter.");

  AddSmell( ({"geruch"}),
	   "Du riechst das Papier der Briefe und das Wachs der Kerzen.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Flackern der Kerzen und wie die "
		          "Postangestellten die Briefe und Pakete sortieren.");

  AddSound( ({"flackern","kerzen"}),
	   "*flacker*");

  AddSound( ({"postangestellte","angestellte"}),
	   "Das Sortieren der Briefe und Pakete geschieht recht laut, da sich "
	   "die Zwerge staendig Befehle zum Werfen und Fangen zurufen.");

  AddSound( ({"befehle","werfen","fangen"}),
	   "Die Befehle klingen recht harsch. Hier moechtest Du sicher nicht "
	   "gerne arbeiten.");

//-----Details Ende-----

  AddExit("sueden", ROOM "zwfe18"); 
  
  AddCmd("post","do_mail");
  AddCmd("mail","do_mail");
 
  SetProp(P_INDOORS,1);

  if (!argh) {
    for (i=0;i<NRCABINS;++i) AddItem(MAILCABIN,REFRESH_REMOVE);
  }
}

do_mail(str) {
  object mailer;
  if (this_interactive()!=this_player()) return 0;
  mailer=clone_object(MAILER);
  mailer->SetOfficeName(short());
  mailer->do_mail(str);
  return 1;
}
 
