// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Zwergenfeste von Ardhmir");
  SetProp( P_INT_LONG,
	"Die Kammer ist leer. Die Waende sind nur mit ein paar Verzierungen "
        "verschoenert. Am Boden sind Schienen zu sehen. die durch einen "
        "dunklen Tunnel im Sueden ins Ungewisse fuehren. Direkt neben den "
        "Schienen steht ein kleines Schild." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"kammer"}), 
            "Die Kammer ist mittelgross mit einem grossen Loch in der "
            "Suedwand.");

  AddDetail( ({"waende","wand"}),
	    "Die Waende haben ein paar Verzierungen. Ansonsten sind nur ein "
            "paar Barinsteine zu sehen, die die Kammer erhellen.");

  AddDetail( ({"verzierungen","verzierung"}),
	    "Die Verzierungen zeigen einen Stollenwagen, in dem ein paar "
            "Abenteurer sitzen, die anscheinend Todesaengste ausstehend und "
            "lauthals zu schreien scheinen.");

  AddDetail( ({"boden"}),
	    "Der Boden besteht aus festem Gestein. Ein paar Schienen wurden "
            "auf dem Boden ausgelegt und fuehren in den Tunnel.");
  
  AddDetail( ({"schienen"}),
	    "Die Schienen fuehren geradewegs in den Tunnel und verschwinden "
            "in der Dunkelheit.");

  AddDetail( ({"tunnel","sueden"}), 
            "Im Sueden fuehrt ein Tunnel ins Ungewisse. Die Schienen fuehren "
            "direkt in die Dunkelheit.");

  AddDetail( ({"decke","himmel"}),
	    "Die Decke ist kahl und sehr uninteressant.");

  AddDetail( ({"ungewisse","dunkelheit"}),
	    "Das Ungewisse kann sehr spannend sein, aber manchmal auch "
            "toedlich.");

  AddDetail( ({"schild"}),
	    "Du kannst das Schild lesen.");
  
  AddDetail( ({"suedwand","loch"}),
	    "In der Suedwand ist ein grosses Loch, welches der Beginn des "
            "Tunnels ist, in den die Schienen hinein fuehren.");

  AddDetail( ({"beginn","anfang"}), 
            "Alles hat einen Anfang.");

  AddDetail( ({"barinsteine"}),
	    "Die Barinsteine leuchten gelb und erhellen die Kammer ein wenig.");

  AddDetail( ({"abenteurer"}),
	    "Abenteurer wie Du und Du.");

  AddDetail( ({"todesaengste","weicheier"}),
	    "Du haeltst die Abenteurer auf den Verzierungen fuer Weicheier.");
  
  AddDetail( ({"stollenwagen"}),
	    "Der Stollenwagen auf der Verzierung scheint in einem wahnsinnigen "
            "Tempo durch den Tunnel zu rasen.");

  AddDetail( ({"tempo"}), 
            "Jedenfalls sieht es nach Tempo auf der Verzierung aus.");

  AddDetail( ({"dunkelheit"}),
	    "Im Tunnel ist es stockdunkel.");

  AddDetail( ({"gestein"}),
	    "Du kennst Dich mit dem Gestein nicht aus.");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({""}), 
            "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht ausnahmsweise nach gar nichts.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst ein Poltern im Tunnel.");

  AddSound( ({"poltern","tunnel"}),
	   "Ob dort ein Stollenwagen ankommt?");
  
  AddReadDetail( ({"schild"}),
		"+-------------------------------+\n"
                "| Hier kannst Du mit einem      |\n"
                "| Stollenwagen nach Felonia     |\n"
                "| reisen.                       |\n"
                "| Wenn ein Wagen da ist, kannst |\n"
                "| Du ihn mit 'kletter in wagen' |\n"
                "| besteigen und dann beginnt    |\n"
                "| auch bald die Fahrt.          |\n"
                "|                               |\n"
                "| Viel Glueck,                  |\n"
                "| Der Herrscher von Ardhmir     |\n"
                "+-------------------------------+\n");


//-----Details Ende-----
AddItem(OBJ "wagen", REFRESH_DESTRUCT,1);
  
AddExit("norden", ROOM "zwfe16");

}
