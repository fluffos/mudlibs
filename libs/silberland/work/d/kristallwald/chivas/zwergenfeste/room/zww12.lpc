// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int gnomda;

void create()
	
{
  ::create();

  gnomda=1; 

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Wald macht einen finsteren Eindruck. Die Baeume sind viel mehr "
        "an den Weg gerueckt und das dichte Blaetterdach bildet eine Art "
        "dunklen Tunnel, durch den man laufen muss." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1);

//-----Details Anfang-----
  
  AddDetail( ({"wald","waldes"}), 
            "Der Wald wird dunkler, um so weiter man nach Norden kommt.");

  AddDetail( ({"eindruck"}),
	    "Der erste Eindruck ist der wichtigste. Man sollte sich auf ihn "
            "verlassen.");

  AddDetail( ({"baeume","baeumen"}),
	    "Die Baeume stehen sehr dicht am Weg. Ihr dichtes Blaetterdach "
            "laesst nur noch einen kleinen Teil des Lichts der Sonne durch.");

  AddDetail( ({"weg"}),
	    "Der Weg scheint im Osten auf eine Kreuzung zu treffen.");
  
  AddDetail( ({"blaetterdach","blaetterdaches","dach"}),
	    "Das Blaetterdach ist sehr dicht. Kaum ein Lichtstrahl schafft es "
            "durch die Blaetter.");

  AddDetail( ({"art","tunnel"}), 
            "Die dicken Aeste der Baeume bilden mit den Blaettern eine Art "
            "Tunnel. Es ist jedenfalls fast so dunkel wie in einem.");

  AddDetail( ({"boden","waldboden"}),
	    "Am Boden liegt ein wenig Laub.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist irgendwo oberhalb des Blaetterdaches, das wie "
            "ein Tunnel aussieht.");

  AddDetail( ({"norden","sueden","waldgegend","vergleich"}),
	    "Im Norden ist der Wald dunkler im Vergleich mit der idyllischen "
            "Waldgegend im Sueden.");
  
  AddDetail( ({"lichts","licht","teil"}),
	    "Es kommt kaum noch Licht durch das dichte Blaetterdach. Es ist "
            "sehr duester in diesem Teil des Waldes.");

  AddDetail( ({"sonne"}), 
            "Die Sonne, die senkrecht am Himmel stehen muesste, siehst Du "
            "durch das dichte Blaetterdach nicht.");

  AddDetail( ({"blaettern","blaetter"}),
	    "Einige Blaetter sind auf dem Waldboden zu sehen, aber die "
            "meissten Blaetter haengen an den Baeumen.");

  AddDetail( ({"lichtstrahl","strahl"}),
	    "Es ist kein Lichtstrahl zu sehen.");

  AddDetail( ({"osten","kreuzung"}),
	    "Im Osten ist eine Kreuzung. Wenn Du mehr ueber die Kreuzung "
            "wissen willst, dann solltest Du dort hingehen.");
  
  AddDetail( ({"laub"}),
	    "Es liegt einiges Laub auf dem Weg.");

  AddDetail( ({"gebuesch"}), 
            "Du entdeckst einen kleinen Busch zwischen den Baeumen.");

  AddDetail( ({"busch"}),
	    "Aus dem Busch schauen Dich zwei gelbe Augen an.");

  AddDetail( ({"augen"}),
	    "Die Augen sind gross und gelb und scheinen eine gewisse "
            "Intelligenz zu besitzen.");

  AddDetail( ({"intelligenz"}),
	    "Die Wahrscheinlichkeit, dass die Intelligenz des Wesen groesser "
            "ist als Deine, ist sicher sehr hoch.");
  
  AddDetail( ({"wahrscheinlichkeit"}),
	    "Die Wahrscheinlichkeit trifft zu.");

  AddDetail( ({"wesen"}), 
            "Vielleicht kannst Du es ja hervor locken.");

  AddDetail( ({"aeste"}),
	    "Die Baeume haben grosse Aeste.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Laub.");  
 
  AddSmell( ({"laub"}),
	   "Das Laub am Boden riecht ein wenig faulig.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Rascheln.");

  AddSound( ({"rascheln"}),
	   "Das Rascheln kommt aus einem kleinen Gebuesch zwischen den "
           "Baeumen.");
  
  AddSound( ({"gebuesch"}),
	   "Ein Gebuesch kann man nicht lauschen. Spieler!");

//-----Details Ende-----
  
AddExit("osten", ROOM "zww13");
AddExit("sueden", ROOM "zww11");

AddCmd( ({"lock","locke" }), "locken" );

}
void reset()
{
  ::reset();
  gnomda=1;
}
int locken(string str)
{
   object gnom;
   notify_fail("Was moechtest Du hervor locken?\n");
   if ( member( ({ "wesen hervor","wesen heraus" }),str) != -1) 

  if (present("CHIVASGNOM",TO) || !gnomda)

  {
  write(BS("Du probierst mit beruhigenden Worten das Wesen hervor zu locken, "
           "jedoch scheint es momentan nicht die Absicht zu haben sich ganz "
           "zu zeigen.\n"));
  return -1;
  }
  write(BS("Du sprichst mit beruhigenden Worten auf das Wesen ein und nach "
           "einer Weile stapft es aus dem Busch hervor und zeigt sich Dir.\n"));
  gnomda=0;
  gnom=clone_object (NPC "gnom" );
  gnom->move(TO,M_GO|M_NOCHECK,"stapft herein.");
   return 1;
  }

