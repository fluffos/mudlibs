// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl;
int axt_zahl;

void create()
	
{
  ::create();

  anzahl = 2;
  axt_zahl=1;

  SetProp( P_INT_SHORT, "In der Ratshalle von Ardhmir");
  SetProp( P_INT_LONG,
	"Dies ist die Ratshalle von Ardhmir, in dem der Herrscher von Ardhmir "
	"mit seinen Beratern ueber das Volk der Zwergenfeste herrscht. Die "
	"grosse Halle wird von leuchtenden Barinsteinen an den Waenden und "
	"grossen Kohlebecken erhellt. In der Mitte steht ein grosser runder "
	"Tisch, an dem sicher die wichtigen Entscheidungen getroffen werden. "
	"Am Ende der Halle steht ein grosser Granitthron auf einem hohen "
	"Podest, welches man ueber ein paar Stufen erreichen kann." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"ratshalle","halle"}), 
            "Die Ratshalle von Ardhmir ist riesig. Hier kann man grosse "
	    "Versammlungen abhalten und rauschende Feiern veranstalten. "
	    "Ausserdem zeigt die Halle den ganzen Glanz und die Pracht eines "
	    "Zwergenreiches.");

  AddDetail( ({"ardhmir"}),
	    "Du bist in der Zwergenfeste von Ardhmir.");

  AddDetail( ({"herrscher","koenig","herrschers"}),
	    "Der Herrscher von Ardhmir ist ein grosser Koenig.");

  AddDetail( ({"berater","beratern","beratung"}),
	    "Die Berater sind natuerlich nur da, wenn auch eine Beratung "
	    "ansteht.");
  
  AddDetail( ({"volk"}),
	    "Das Volk der Zwerge lebt und arbeitet in Ardhmir.");

  AddDetail( ({"zwergenfeste","feste"}), 
            "Die Zwergenfeste von Ardhmir ist eines der beiden grossen "
	    "Zwergenreiche im Silberland.");

  AddDetail( ({"barinsteinen","barinsteine","teile","farbe"}),
	    "Die Barinsteine an den Waenden leuchten in einer gelbliche "
	    "Farbe und erhellen grosse Teile der Halle.");

  AddDetail( ({"waenden","waende","wand"}),
	    "An den Waenden haengen grosse Wandteppiche. Zwischen den "
	    "Wandteppichen haengen grosse leuchtende Barinsteine.");

  AddDetail( ({"kohlebecken","becken","stellen"}),
	    "In der Halle sind an verschiendenen Stellen grosse Kohlebecken "
	    "aufgestellt, in denen die Kohle glueht und die Halle erleuchtet. "
	    "Die Becken scheinen aus irgendeinem Kristall zu bestehen.");
  
  AddDetail( ({"kohle"}),
	    "Die heisse Kohle in den Becken glueht und erhellt zusaetzlich zu "
	    "den Barinsteinen die Ratshalle.");

  AddDetail( ({"mitte","tisch","geschicke"}), 
            "In der Mitte der Halle steht ein grosser runder Tisch, an den "
	    "sich der Herrscher und seine Berater setzen um die Geschicke des "
	    "Zwergenvolkes zu lenken.");

  AddDetail( ({"stuehle"}),
	    "Natuerlich gibt es auch Stuehle, ansonsten koennten sie sich ja "
	    "nicht hinsetzen.");

  AddDetail( ({"entscheidungen"}),
	    "Manche Entscheidungen benoetigen einer ausfuehrlichen Beratung.");

  AddDetail( ({"ende","granitthron","thron","throns"}),
	    "Am Ende der Ratshalle steht auf einem Podest der grosse mit Runen "
	    "verzierte Thron des Herrschers.");

  AddDetail( ({"granit"}),
	    "Der Thron besteht aus schwarzem Granit. Nur die Runen sind auf "
	    "der schwarzen Oberflaeche zu erkennen.");
  
  AddDetail( ({"podest"}),
	    "Das Podest steht am Ende der Halle und auf ihm steht ein grosser "
	    "und beeindruckender Thron. Ein paar Stufen fuehren rauf auf das "
	    "Podest.");

  AddDetail( ({"stufen"}), 
            "Die Stufen fuehren auf das Podest mit dem Thron.");

  AddDetail( ({"himmel","decke"}),
	    "Die Decke weit oben ist kaum zu erkennen. Nur ab und zu sieht man "
	    "ein Glitzern im Lichtschein der Becken und Barinsteine.");

  AddDetail( ({"boden"}),
	    "Der Boden besteht aus grossen Mosaiken, die aus kleinen "
	    "Halbedelsteinen hergestellt wurden.");

  AddDetail( ({"halbedelsteinen","halbedelsteine","edelsteine","wert","mineralien"}),
	    "Die Edelsteine sind zwar selten, aber fuer die Zwerge nur von "
	    "geringem Wert, da sie ja durch das Schuerfen in den Stollen "
	    "wertvollere Mineralien finden.");
  
  AddDetail( ({"schuerfen","fertigkeiten"}),
	    "Schuerfen ist eine der Fertigkeiten, die man im Silberland "
	    "lernen kann.");

  AddDetail( ({"silberland","land"}), 
            "Du bist im Silberland.");

  AddDetail( ({"stollen"}),
	    "Hier sind keine Stollen zu sehen, schliesslich befindest Du Dich "
	    "in der Ratshalle von Ardhmir.");

  AddDetail( ({"zwerge"}),
	    "Die Zwerge bewohnen die Feste von Ardhmir.");

  AddDetail( ({"mosaiken"}),
	    "Die Mosaiken stellen verschiedene alltaegliche Taetigkeiten "
	    "der Zwerge und ihrer Geschichte dar.");
  
  AddDetail( ({"taetigkeiten","anfertigen"}),
	    "Es sind alltaegliche Taetigkeiten, wie Schuerfen oder das "
	    "Anfertigen von Ruestungen und Waffen.");

  AddDetail( ({"geschichte"}), 
            "Die Geschichte von Ardhmir ist in verschiedenen Mosaiken "
	    "dargestellt. Ein Mosaik faellt Dir besonders auf.");

  AddDetail( ({"ruestungen"}),
	    "Ruestungen schuetzen Dich.");

  AddDetail( ({"waffen","aufzaehlung"}),
	    "Es gibt viele verschiedene Waffen im Silberland. Eine Aufzaehlung "
	    "wuerde zu lange dauern.");

  AddDetail( ({"mosaik"}),
	    "Ein Mosaik, dass die Geschichte von Ardhmir darstellt, zeigt "
	    "einen Zwergenkrieger, der von einer Gruppe von Orks angegriffen "
	    "wird.");
  
  AddDetail( ({"gruppe","orks","ork"}),
	    "Die Orks sehen boese und hinterhaeltig aus. Sie sollen ganz in "
	    "der Naehe der Feste in einer Hoehle leben.");

  AddDetail( ({"naehe","hoehle"}),
	    "Da musst Du die Hoehle der Orks schon suchen. Hier bist Du bei "
	    "den Zwergen.");

  AddDetail( ({"steine","steinen","arten"}),
	    "Es gibt viele verschiedene Arten von Steinen. Einige Steine "
	    "leuchten wie die Barinsteine in der Zwergenfeste von Ardhmir und "
	    "andere sind wertvoll wie die Edelsteine oder Halbedelsteine.");

  AddDetail( ({"zwergenkrieger","krieger","zwergenkriegers","kriegers"}),
	    "Der Zwergenkrieger ist muskuloes und detailgetreu aus den "
	    "Halbedelsteinen dargestellt. Er traegt eine prunkvolle Ruestung "
	    "und eine grosse leuchtende Axt.");

  AddDetail( ({"ruestung"}), 
            "Die Ruestung des Zwergenkriegers scheint sich perfekt an den "
	    "abgebildeten Koerper des Kriegers anzupassen. Solche Ruestungen "
	    "koennen halt nur die Zwerge herstellen.");

  AddDetail( ({"axt"}),
	    "Die Axt wirkt sehr maechtig und fast real, als ob man nach ihr "
	    "greifen koennte.");

  AddDetail( ({"zwergenreiches","zwergenreich","reich","glanz","pracht"}),
	    "Ardhmir ist eines der beiden prachtvollen Zwergenreiche im "
	    "Silberland.");

  AddDetail( ({"versammlungen"}),
	    "In der Ratshalle kann man sehr grosse Versammlungen einberufen, "
	    "da sie genug Platz fuer alle bietet.");
  
  AddDetail( ({"feier","feiern"}),
	    "In der Ratshalle gab es schon viele grosse Feiern.");

  AddDetail( ({"zwergenreiche"}), 
            "Es gibt neben Ardhmir auch noch die Hauptstadt der Zwerge im "
	    "Gebirge. Sie heisst Felonia.");

  AddDetail( ({"wandteppichen","wandteppiche"}),
	    "Die grossen Wandteppiche an den Waenden zeigen die Wappen der "
	    "einzelnen Zwergenclans von Ardhmir.");

  AddDetail( ({"kristall","magie"}),
	    "Das besondere Kristall scheint das Licht der gluehenden Kohle "
	    "zu verstaerken. Es sieht so aus, als ob ein wenig Magie mit im "
	    "Spiel waere.");

  AddDetail( ({"geschicke","jahrhunderten"}),
	    "Die Herrscher von Ardhmir lenken die Geschicke des Zwergenvolkes "
	    "seit Jahrhunderten sehr weise.");
  
  AddDetail( ({"zwergenvolkes","zwergenvolk"}),
	    "Die Zwerge sind ein stolzes und tapferes Volk.");

  AddDetail( ({"runen"}), 
            "Die Runen sind in den Thron eingearbeitet und wurden mit Gold "
	    "und Mithril ausgefuellt. Ausserdem scheint eine starke Magie von "
	    "ihnen auszugehen.");

  AddDetail( ({"oberflaeche"}),
	    "Die Oberflaeche des Throns ist glatt. Die einzigen Unebenheiten "
	    "stammen von den eingearbeiteten Runen.");

  AddDetail( ({"glitzern","lichtschein","diamanten"}),
	    "Das Glitzern an der Decke, was durch den Lichtschein der "
	    "gluehenden Kohle ausgeloest wird, stammt sicher von wertvollen "
	    "Diamanten oder anderen Edelsteinen an der Decke.");

  AddDetail( ({"hauptstadt","felonia"}),
	    "Felonia liegt unterhalb des Gebirges und ist die Hauptstadt der "
	    "Zwerge.");
  
  AddDetail( ({"gebirge","gebirges"}),
	    "Das Gebirge ist weit entfernt und eine Reise ist lang und "
	    "beschwerlich.");

  AddDetail( ({"reise"}), 
            "Eine Reise ins Gebirge waere sehr lang.");

  AddDetail( ({"platz"}),
	    "Die Halle ist riesig gross und bietet genug Platz fuer alle "
	    "moeglichen Anlaesse.");

  AddDetail( ({"anlaesse"}),
	    "Es gibt viele Anlaesse um die grosse Halle zu benutzten. Es waere "
	    "selbst genug Platz fuer eine Drachenpaarung.");

  AddDetail( ({"drachenpaarung","paarung","beispiel","aufwand"}),
	    "Dies war natuerlich nur ein Beispiel. Der Aufwand alle "
	    "Kohlebecken, Stuehle und den Tisch beseite zu raeumen, waere viel "
	    "zu gross.");
  
  AddDetail( ({"magie"}),
	    "Magie ist fuer Dich unbegreiflich. Dein Intellekt ist dafuer "
	    "nicht gross genug.");

  AddDetail( ({"gold","mithril"}),
	    "Das Gold und Mithril zeigen den Reichtum der Zwergenfeste von "
	    "Ardhmir.");

  AddDetail( ({"unebenheiten"}),
	    "Die kleinen Unebenheiten sind nur dort, wo die Runen in den "
	    "Granit eingearbeitet wurden. Man kann sie sehr gut spueren, "
	    "wenn man mit der Hand ueber die Oberflaeche streicht.");
  
  AddDetail( ({"intellekt"}),
	    "Deute mit dem Finger auf Dich selbst.");

  AddDetail( ({"finger"}), 
            "Du hast welche.");

  AddDetail( ({"wappen"}),
	    "Du siehst verschiedene Wappen. Es gibt wohl zehn verschiedene "
	    "Clans und damit auch zehn Wandteppiche mit Wappen in Ardhmir.");

  AddDetail( ({"zwergenclans","zwergenclan","clan","clans"}),
	    "In der Zwergenfeste von Ardhmir gibt es zehn verschiedene Clans, "
	    "die jeweils fuer eine Lebenszeit abwechselnd den Herrscher der "
	    "Feste stellen. Vielleicht erfaehrt man mehr ueber die Clans, wenn "
            "man die einzelnen Wandteppiche genauer untersucht. ");

  AddDetail( ({"lebenszeit","reihen"}),
	    "Stirbt ein Herrscher, so wird vom naechst folgenden Clan ein "
	    "neuer Herrscher aus ihren Reihen auserkoren.");
  
  AddDetail( ({"wandteppich 1","wandteppich eins","amboss","hammer","eisenschmieder"}),
	    "Der erste Wandteppich hat ein grosses blaues Wappen, auf dem "
            "ein grosser Amboss und ein Hammer abgebildet ist. Es handelt "
            "sich dabei um den Clan der Eisenschmieder.");

  AddDetail( ({"wandteppich 2","wandteppich zwei","axtschwinger","aexte","kaempfer"}),
            "Der zweite Wandteppich hat ein grosses gelbes Wappen, auf dem "
            "zwei gekreuzte Aexte zu sehen sind. Es handelt sich um den Clan "
            "der Axtschwinger. Es sollen die besten Kaempfer von Ardhmir "
            "sein.");

  AddDetail( ({"wandteppich 3","wandteppich drei","mithrilbarren","mithrilschmieder"}),
	    "Der dritte Wandteppich hat ein silbernes Wappen auf dem einige "
            "Mithrilbarren zu sehen sind. Es handelt sich um den Clan der "
            "Mithrilschmieder. Es sollen die Besten im ganzen Land sein.");	

  AddDetail( ({"wandteppich 4","wandteppich vier","kunstwerke","goldschmieder"}),
	    "Der vierte Wandteppich hat ein goldenes Wappen auf dem einige "
            "Kunstwerke zu sehen sind. Es handelt sich hier um den Clan der "
            "Goldschmieder.");	

  AddDetail( ({"wandteppich 5","wandteppich fuenf","flammen","feuer","feuermeister"}),
            "Der fuenfte Wandteppich hat ein rotes Wappen auf dem einige "
            "Flammen abgebildet sind. Es handelt sich um den Clan der "
            "Feuermeister. Keine anderen Zwerge im Silberland koennen ein "
            "so heisses Feuer schueren.");	

  AddDetail( ({"wandteppich 6","wandteppich sechs","felsbrocken","steinbeisser","steinmetzen"}),
	    "Der sechste Wandteppich hat ein graues Wappen auf dem einige "
            "Felsbrocken und Steine zu sehen sind. Es handelt sich um den "
            "Clan der Steinbeisser. Sie sollen zu den Besten Steinmetzen im "
            "Silberland gehoeren.");		   

  AddDetail( ({"wandteppich 7","wandteppich sieben","gemenschleifer"}),
            "Der siebte Wandteppich hat ein tuerkises Wappen auf dem einige "
            "Edelsteine zu sehen sind. Es handelt sich um den Clan der "
            "Gemenschleifer.");	

  AddDetail( ({"wandteppich 8","wandteppich acht","totenschaedel","orktoeter","kopfgeldjaeger"}),
	    "Der achte Wandteppich hat ein schwarz-rotes Wappen mit dem "
            "Totenschaedel von einem Ork darauf. Es handelt sich um den Clan "
            "der Orktoeter. Es gibt keine gerisseneren Kopfgeldjaeger und "
            "Orktoeter im Silberland.");		   

  AddDetail( ({"wandteppich 9","wandteppich neun","pflanzen","heiler"}),
	    "Der neunte Wandteppich hat ein weisses Wappen auf dem einige "
            "Pflanzen zu sehen sind. Es handelt sich um den Clan der Heiler.");	

  AddDetail( ({"wandteppich 10","wandteppich zehn","zwergenmagier","blitze","haende"}),
            "Der zehnte Wandteppich hat ein Wappen, das in regelmaessigen "
            "Abstaenden magisch die Farbe wechselt. Auf dem Wappen sind ein "
            "paar sich bewegende Haende zu erkennen und einige Blitze. Es "
            "handelt sich hier um den Clan der Zwergenmagier.");	

  AddDetail( ({"farbe","farben","leben"}), 
            "Farben sind im Leben sehr wichtig.");

  AddDetail( ({"besten"}),
	    "Zu den Besten willst Du auch irgendwann gehoeren.");

  AddDetail( ({"reichtum"}),
	    "Die Zwergenfeste von Ardhmir ist sehr reich.");

  AddDetail( ({"spiel"}),
	    "Du spielst sehr gerne hier.");
  
  AddDetail( ({"koerper"}),
	    "Du hast einen grandiosen Koerper.");

  AddDetail( ({"licht"}), 
            "Die Halle ist gut beleuchtet. Du kannst alles genau erkennen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Rauch.");  
 
  AddSmell( ({"rauch"}),
	   "Der Rauch kommt aus den Kohlebecken. Es ist jedoch nicht so "
           "schlimm, dass Du husten muesstest.");

  AddSound(DEFAULT_SOUND, "Du hoerst die gluehende Kohle in den Becken "
                          "knacken.");

  AddSound( ({"kohle"}),
	   "*knack*");
  
//-----Details Ende-----
AddItem(NPC "zwache", REFRESH_DESTRUCT);
AddItem(NPC "zwache", REFRESH_DESTRUCT);
AddItem(NPC "zkoenig", REFRESH_DESTRUCT);
  
AddExit("nordwesten", ROOM "zwfe26");
AddExit("suedwesten", ROOM "zwfe25");

AddCmd( ({"streich","streiche"}), "streichen" );
AddCmd( ({"deut", "deute" }), "deuten" );
AddCmd( ({"greif","greife" }), "greifen" );

}
void reset()
{
  ::reset();
  axt_zahl=1;
  anzahl=2;
}
int streichen(string str)
{
   notify_fail("Womit willst Du wo was streichen?\n"); 
   if ( member( ({ "mit hand ueber oberflaeche","mit hand ueber unebenheit" }),str) != -1) 
  {
    write(BS ( "Du streichst mit der Hand ueber die Unebenheiten der Runen "
               "und fuehlst wie Dich eine mystische Macht durchstroemt. "
               "Du fuehlst Dich eindeutig besser.\n"));
    say( TPN+" sieht auf einmal viel besser aus.\n");
    if ( anzahl )
    {
      TP -> heal_self(20+random(10));
      anzahl--;
    }
    return 1;
  }
}
int deuten(string str)
{
   notify_fail("Moechtest Du etwa mit dem Finger auf Dich deuten?\n");
   if ( member( ({ "mit finger auf dich","mit finger auf mich" }),str) != -1) 
  {
    write(BS( "Du deutest mit dem Finger auf Dich selbst und ploetzlich "
              "hoerst Du ueberall um Dich herum lautes Gelaechter. Du "
              "schaemst Dich ein wenig.\n"));
    say( TPN+" deutet mit dem Finger auf sich selbst und ploetzlich ertoent "
             "von ueberall lautes Gelaechter.\n");
    return 1;
  }
}
int greifen(string str)
{
  object axt;
  notify_fail( "Nach was willst Du greifen?\n" );
  if ( member( ({ "nach axt", "nach waffe" }), str ) != -1 ) 

   {
     if( axt_zahl < 1 )
     {
        write(BS("Du greifst nach der Axt und wendest Dich leider "
                 "enttaeuscht ab, da es sich wohl diesmal wirklich nur um "
                 "eine gute Abbildung einer Axt handelt und um keine "
                 "echte.\n"));
        say(sprintf("%s greift nach etwas.\n", TP->Name(WER)));
        return -1;
     }
      if ( present("gummiaxt",TP) )
      {
      write("Du greifst nach der Axt, aber nachdem Du "
            "bereits eine dieser Aexte hast laesst Du unangetastet.\n" );
      say(sprintf("%s versucht irgend etwas, dass nicht klappt.\n", TP->Name(WER)));
      return -1;
      }
      else
      {
        {axt = clone_object( WEAPON "gummiaxt");
        if ( ME_TOO_HEAVY == axt->move(TP,M_GET|M_SILENT) )

          {
          write(
          "Die Axt wuerde Dir zu schwer werden.\n" );
          say(BS(sprintf("%s greift nach Etwas, ist jedoch zu schwach um "
                         "es zu nehmen.\n", TP->Name(WER))));
          axt -> remove();
          return 1;
          }
          else
          {
          write(BS("Du greifst nach der Axt, die so real aussieht und "
                "ploetzlich erscheint sie in Deiner Hand.\n"));
          say(sprintf("%s greift wohin und steckt etwas ein.\n",
          TP->Name(WER)));
          axt_zahl--;
          return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}
