// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Stollen");
  SetProp( P_INT_LONG,
	"Der Stollen in dem Du stehst, teilt sich hier Richtung Norden in drei "
	"Gaenge auf. Sie fuehren anscheinend in weitere Stollen, in denen die "
	"Zwerge arbeiten und hier unten Eisen und andere Metalle abbauen. So "
	"wie die Waende aussehen, gibt es hier unten keine Edelsteine, sondern "
	"nur Metalle.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"stollen"}), 
            "Der Stollen teilt sich hier in mehrere Gaenge in Richtung "
	    "Norden.");

  AddDetail( ({"richtung","norden","nordwesten","nordosten","gaenge","sueden"}), 
            "In Richtung Norden teilt sich der Stollen auf. Es geht nach "
	    "Norden, Nordosten und Nordwesten. Du kannst natuerlich auch "
	    "zurueck nach Sueden gehen.");

  AddDetail( ({"zwerge"}),
	    "Die Zwerge bauen hier hauptsaechlich Eisen ab.");
  
  AddDetail( ({"eisen"}), 
            "Es gibt hier hauptsaechlich Eisen, aber auch ab und zu andere "
	    "Metalle.");

  AddDetail( ({"metalle","gold","silber","metall"}),
	    "Es gibt nur ab und zu hier Gold und Silber zu finden.");
  
  AddDetail( ({"wand","waende","waenden"}), 
            "An den Waenden haengen viele Fackeln, die den Stollen mit ihrem "
	    "Licht erhellen. Ansonsten sind an den Waenden die Spuren "
	    "des Abbaus der Metalle zu erkennen.");

  AddDetail( ({"edelsteine"}),
	    "Edelsteine gibt es hier in den Stollen nicht, ausser Du hast "
	    "welche mitgebracht.");
  
  AddDetail( ({"boden"}), 
            "Am Boden sind einige Steine zu sehen und ein paar Schienen, die "
	    "hier in Richtung Norden aufhoeren.");

  AddDetail( ({"decke"}),
	    "An der Decke ist nicht viel zu erkennen.");
  
  AddDetail( ({"fackeln","licht"}), 
            "Die Fackeln an den Waenden spenden genug Licht um alles genau zu "
	    "erkennen.");

  AddDetail( ({"spuren","abbaus","abbau"}),
	    "Du erkennst an den Waenden die Spuren des Abbaus. Es sind lauter "
	    "Risse in den Waenden zu sehen, die durch die Hammerschlaege der "
	    "Zwerge entstanden sind.");
  
  AddDetail( ({"steine"}), 
            "Die Steine sind von den Waenden und der Decke abgefallen, als "
	    "hier das Eisen abgebaut wurde.");

  AddDetail( ({"schienen"}),
	    "Auf den Schienen fahren Stollenwagen, mit denen das Eisen "
	    "abtransportiert wird.");
  
  AddDetail( ({"hammerschlaege","schlaege"}), 
            "Die Hammerschlaege kannst Du nicht sehen, nur ihre Folgen.");

  AddDetail( ({"stollenwagen","stellen"}),
	    "Ein Stollenwagen ist momentan nicht zu sehen. Sicher stehen sie "
	    "an anderen Stellen, wo sie benoetigt werden.");
  
  AddDetail( ({"folgen","risse","rissen"}), 
            "Aufgrund der Hammerschlaege sind lauter Risse in den Waenden zu "
	    "sehen. Diesmal ist aber an den Rissen nichts besonderes zu "
	    "erkennen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht stickig in den Stollen.");  

  AddSound(DEFAULT_SOUND, "Du hoerst Hammerschlaege in den Stollen.");

  AddSound( ({"hammerschlaege"}),
	   "Es wird laut gehaemmert und Metall abgebaut.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "zwfest5");
AddExit("nordwesten", ROOM "zwfest1");
AddExit("nordosten", ROOM "zwfest3");
AddExit("norden", ROOM "zwfest2");
}
