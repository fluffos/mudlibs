// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Zwergenfeste von Ardhmir");
  SetProp( P_INT_LONG,
	"Die Halle reicht weit nach oben in die Dunkelheit. Grosse Saeulen "
        "halten die Decke, die oben in der Dunkelheit sein muss. An den "
        "Waenden und an den Saeulen sind leuchtende Steine in metallenen "
        "Fassungen zu erkennen. Der Boden scheint aus Marmor zu bestehen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"halle"}), 
            "Die Halle zieht sich laenglich von Sueden nach Norden und grosse "
	    "Saeulen stuetzen die Decke, die sich irgendwo in der Dunkelheit "
	    "weit oben befinden muss.");

  AddDetail( ({"dunkelheit"}),
	    "Die Dunkelheit ist bis knapp unter die Decke zurueck gedraengt. "
	    "Hier unten auf dem Boden kann man alles sehr gut erkennen, da "
	    "die leuchtenden Barinsteine an den Waenden die Halle gut "
	    "erhellen.");

  AddDetail( ({"saeulen"}),
	    "Die grossen Saeulen ragen weit nach oben in die Dunkelheit und "
	    "tragen die Decke.");

  AddDetail( ({"decke"}),
	    "Du kannst die Decke in der Dunkelheit weit oben nicht sehen.");
  
  AddDetail( ({"waende","waenden","wand"}),
	    "An den Waenden haengen viele leuchtende Barinsteine, die die "
	    "Halle erhellen.");

  AddDetail( ({"steine","barinsteine"}), 
            "Die Barinsteine erhellen mit ihrem gelblichen Schein die Halle. "
	    "Sie sind in Fassungen an den Waenden angebracht.");

  AddDetail( ({"fassungen"}),
	    "Die Fassungen in denen die Steine befestigt sind, scheinen aus "
	    "Gold zu sein.");

  AddDetail( ({"boden","schild","treppe"}),
	    "Der Boden ist so glatt geschliffen, so dass er beinahe wie "
	    "Marmor aussieht. Eine Treppe fuehrt nach unten, neben der ein "
	    "Schild steht, welches Du lesen kannst.");

  AddDetail( ({"marmor"}),
	    "Es ist nur besonders glatt geschliffener Fels, der beinahe wie "
	    "Marmor aussieht.");
  
  AddDetail( ({"norden","sueden"}),
	    "Die laengliche Halle erstreckt sich von Sueden nach Norden. Nach "
	    "Osten kannst Du tiefer in die Zwergenfeste vordringen.");

  AddDetail( ({"osten","gang"}), 
            "Im Osten fuehrt ein Gang tiefer in die Zwergenfeste von Ardhmir.");

  AddDetail( ({"zwergenfeste","feste","ardhmir"}),
	    "Du befindeste Dich in einer Halle in der Zwergenfeste von "
	    "Ardhmir.");

  AddDetail( ({"schein","lichtschein"}),
	    "Durch den gelblichen warmen Lichtschein der Barinsteine kannst Du "
	    "sehr gut alles erkennen.");

  AddDetail( ({"gold","anzeichen"}),
	    "Das Gold ist ein sehr gutes Anzeichen fuer den Reichtum der "
	    "Zwergenfeste.");
  
  AddDetail( ({"reichtum"}),
	    "Die Zwergenfeste von Ardhmir ist sehr reich.");

  AddDetail( ({"zwerge"}), 
            "Einige Zwerge stehen in der Halle und unterhalten sich. Andere "
	    "gehen ihren Beschaeftigungen nach.");

  AddDetail( ({"beschaeftigungen","aufgaben"}),
	    "Die Beschaeftigungen der der Zwerge gehen Dich nichts an.");

  AddDetail( ({"fels"}),
	    "Der Fels an den Waenden und am Boden ist glatt geschliffen.");

  AddDetail( ({"belueftungssystem"}),
	    "Das Belueftungssystem ist sehr gut versteckt und Du kannst es "
	    "nicht sehen.");

  AddDetail( ({"hoehle"}),
	    "Du befindest Dich in einer Hoehle.");
  
  AddDetail( ({"wiese"}),
	    "Um eine Wiese zu sehen, musst Du die Zwergenfeste verlassen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst frische Luft.");  
 
  AddSmell( ({"luft"}),
	   "Die Luft riecht wie draussen auf einer Wiese und nicht wie in "
	   "einer Hoehle. Das Belueftungssystem der Zwerge muss sehr gut "
	   "sein.");

  AddSound(DEFAULT_SOUND, "Du hoerst wie die Zwerge in Ardhmir arbeiten.");

  AddSound( ({"zwerge"}),
	   "Lauter Zwerge gehen durch die Halle um ihre alltaeglichen Aufgaben "
	   "zu erfuellen.");

  AddReadDetail( ({"schild"}),
		"+-----------------------------------+\n"
		"|                                   |\n"
		"|        Bergwerksstollen           |\n"
		"|                                   |\n"
		"|                |                  |\n"
		"|                |                  |\n"
		"|                \\/                 |\n"
		"|                                   |\n"
		"+-----------------------------------+\n");    
//-----Details Ende-----
  
AddExit("sueden", ROOM "zwfe14");
AddExit("norden", ROOM "zwfe9");
AddExit("osten", ROOM "zwfe16");
AddExit("unten", ROOM "zwfest7");
}
