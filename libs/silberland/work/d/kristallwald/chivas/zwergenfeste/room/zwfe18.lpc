// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl;

void create()
	
{
  ::create();

  anzahl=1;
  
  SetProp( P_INT_SHORT, "In der Zwergenfeste von Ardhmir");
  SetProp( P_INT_LONG,
	"Du stehst in einer weiteren grossen, von riesigen Saeulen getragenen "
	"Halle. Der Weg nach Osten ist durch eine tiefe unterirdische Schlucht "
	"versperrt. Auf der anderen Seite siehst Du den oestlichen Teil der "
	"grossen Halle, wo Du auch einige Zwerge erkennst. Im Nordosten fuehrt "        "eine breite Bruecke ueber den Abgrund auf die andere Seite. Noerdlich "
	"von Dir befindet sich eine der vielen Kammern der Zwergenfeste. Ein "
	"Schild wurde ueber dem Eingang befestigt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"saeulen","saeule"}), 
            "Die grossen Saeulen die die Halle tragen, haben riesige Ausmasse. "
	    "Sie sind rund und haben eine ganz glatte Oberflaeche. An einigen "
	    "Stellen, in unterschiedlicher Hoehe, wurde Barinsteine befestigt "
	    "um die Halle zu erhellen.");

  AddDetail( ({"halle"}),
	    "Die Halle ist ein besonderer Ort in der Zwergenfeste von Ardhmir. "            "Sie wird in der Mitte von einem tiefen Abgrund durchzogen.");

  AddDetail( ({"weg"}),
	    "Der einzige Weg um nach Osten auf die andere Seite der Schlucht "
	    "zu kommen, ist die Bruecke im Nordosten.");

  AddDetail( ({"osten"}),
	    "Im Osten siehst Du den oestlichen Teil der Halle. Er ist jedoch "
	    "durch eine tiefe Schlucht von Dir getrennt.");
  
  AddDetail( ({"schlucht","abgrund","mitte"}),
	    "Die Schlucht ist sehr tief und scheint bodenlos zu sein. Sie "
	    "trennt die riesige Halle in zwei Haelften und scheint eine "
	    "natuerliche Barriere zu sein, falls es Feinde der Zwerge bis in "
	    "diese Halle schaffen wuerden.");
  
  AddDetail( ({"seite","teil","haelften"}), 
            "Du befindest Dich im westlichen Teil der grossen Halle. Um auf "
	    "die andere Seite zu kommen, koenntest Du ueber die Bruecke im "
	    "Nordosten gehen.");

  AddDetail( ({"zwerge"}),
	    "Viele Zwerge wohnen in Ardhmir und gehen ihren Beschaeftigungen "
	    "nach.");

  AddDetail( ({"nordosten","bruecke"}),
	    "Im Nordosten befindet sich eine grosse und breite Bruecke, die "
	    "Dich ueber den Abgrund auf die andere Seite der Halle bringt. "
	    "Am Anfang der Bruecke stehen zwei grosse Statuen.");

  AddDetail( ({"kammern"}),
	    "In der Zwergenfeste gibt es viele Kammern, in denen die Zwerge "
	    "leben und arbeiten. Im Norden scheint eine besondere Kammer zu "
	    "sein.");
  
  AddDetail( ({"kammer","norden"}),
	    "Ueber dem Eingang zur Kammer haengt ein grosses Schild. Du kannst "
	    "sie ohne Probleme betreten.");

  AddDetail( ({"zwergenfeste","ardhmir","zwergenreich","reich","feste"}), 
            "Du befindest Dich in der Zwergenfeste von Ardhmir.");

  AddDetail( ({"eingang"}),
	    "Ueber dem Eingang der Kammer haengt ein grosses Schild.");

  AddDetail( ({"schild"}),
	    "Du kannst das Schild lesen.");

  AddDetail( ({"anschein"}),
	    "Der Anschein truegt manchmal.");

  AddDetail( ({"axtblatt","blatt"}),
	    "Auf dem Axtblatt steht eine kleine Inschrift geschrieben.");  

  AddDetail( ({"boden"}),
	    "Der Boden besteht aus grossen Steinplatten, wodurch es nicht den "
	    "Anschein macht, man waere in einer Hoehle.");
  
  AddDetail( ({"decke"}),
	    "Die Decke ist durch die an den Saeulen angebrachten Barinsteine "
	    "sehr gut hoch oben zu sehen. Anscheinend haben sich ganz oben an "
	    "ihr ein paar Fledermaeuse zum schlafen aufgehaengt.");

  AddDetail( ({"waende","waenden","wand"}), 
            "An den Waenden sind die Dir schon bekannten Verzierungen zu "
	    "erkennen, die man in der ganzen Feste bewundern kann.");

  AddDetail( ({"ausmasse"}),
	    "Die Ausmasse sind so gross, dass ein Dutzend Trolle es nicht "
	    "schaffen wuerden, sie zu umfassen.");

  AddDetail( ({"oberflaeche"}),
	    "Die Oberflaeche der Saeulen ist so flach geschliffen und poliert, "
	    "so dass man beinahe denken koennte, es handele sich um Marmor. "
	    "Du kannst Dein Spiegelbild sogar erkennen.");

  AddDetail( ({"barinsteine","steine","stellen","hoehe"}),
	    "An einigen Stellen an den Saeulen haengen in unterschiedlicher "
	    "Hoehe Barinsteine und leuchten die gesamte Halle mit einem "
	    "warmen gelblichen Licht aus.");
  
  AddDetail( ({"dutzend","trolle"}),
	    "Es haben noch nie soviele Trolle es bis in diese Halle geschafft. "
	    "Sie wurden alle vorher erschlagen.");

  AddSpecialDetail( ({ "spiegelbild" }), "spiegelbild" );

  AddSpecialDetail( ({ "gestalt" }), "gestalt" );

  AddSpecialDetail( ({ "blick" }), "blick" );

  AddSpecialDetail( ({ "dinge" }), "dinge" );

  AddDetail( ({"ort"}),
	    "Es gibt viele besondere Orte in der Zwergenfeste von Ardhmir.");

  AddDetail( ({"barriere","ursprung"}),
	    "Der Abgrund hat einen natuerlichen Ursprung. Selbst die Zwerge "
	    "haetten eine so tiefe kuenstliche Schlucht nicht erschaffen "
	    "koennen.");
  
  AddDetail( ({"feinde","feind"}),
	    "Noch kein Feind der Zwerge hat es so weit in das Zwergenreich "
	    "von Ardhmir geschafft.");

  AddDetail( ({"beschaeftigungen"}), 
            "Die Beschaeftigungen der Zwerge gehen Dich nichts an. Du hast "
	    "es ja auch nicht gern, wenn Jemand seine Nase in Deine "
	    "Angelegenheiten steckt.");

  AddDetail( ({"nase"}),
	    "Deine Nase ist besonders huebsch.");

  AddDetail( ({"jemand","angelegenheiten"}),
	    "Manchmal machen es die Magier und das ist sehr nervig beim "
	    "Scripten.");

  AddDetail( ({"scripten"}),
	    "Lass Dich nicht erwischen, denn es ist verboten!");
  
  AddDetail( ({"magier"}),
	    "Magier sind nervig und stoeren!!!");
  
  AddDetail( ({"licht"}),
	    "Das Licht erhellt die gesamte Halle.");

  AddDetail( ({"statuen","steinstatuen","anfang"}),
	    "Am Anfang der Bruecke stehen zwei grosse Steinstatuen. Es sind "
	    "zwei grosse Zwergenkrieger, die hier Wache zu halten scheinen, so "
	    "dass nicht jeder tiefer in das Zwergenreich vordringen kann.");

  AddDetail( ({"probleme"}),
	    "Kleinere oder groessere Probleme hat jeder, stell Dich nicht so "
	    "an.");
  
  AddDetail( ({"steinplatten","platten"}),
	    "Die Steinplatten bilden einen ebenen Boden, wo man gut drauf "
	    "laufen kann. Die Ritzen zwischen den Platten sind kaum zu "
	    "erkennen.");

  AddDetail( ({"hoehle"}), 
            "Man kann es kaum fuer moeglich halten, dass man in einer Hoehle "
	    "ist.");

  AddDetail( ({"fledermaeuse"}),
	    "Die Fledermaeuse haengen weit oben an der Decke. Du kannst sie "
	    "kaum erkennen. Es ist nur ein Wunder, dass es hier keine Flecken "
	    "am Boden gibt, die die Fledermaeuse verursacht haben.");

  AddDetail( ({"verzierungen"}),
	    "Die Verzierungen an den Waenden sind riesengrosse Reliefs.");

  AddDetail( ({"zwergenkrieger","krieger","kriegern","meter"}),
	    "Die Zwergenkrieger sind mehrere Meter hoch und voll ausgeruestet "
	    "mit Kettenhemd und Axt. Von den Kriegern scheint eine Art Magie "
	    "auszugehen.");
  
  AddDetail( ({"wache"}),
	    "Die Zwergenkrieger halten Wache beim Zugang auf die Bruecke.");

  AddDetail( ({"ritzen"}), 
            "Die Ritzen sind so schmal, so dass man leider nichts darin "
	    "finden kann.");

  AddDetail( ({"flecken"}),
	    "Anscheinend wird hier regelmaessig geputzt. Du haettest nie "
	    "gedacht, dass die Zwerge so auf Sauberkeit achten, schliesslich "
	    "waschen sie sich ja noch nicht einmal, soweit man den Geruechten "
	    "glauben kann.");

  AddDetail( ({"sauberkeit","sache"}),
	    "Sauberkeit ist manchmal nicht so Deine Sache.");

  AddDetail( ({"geruechten","geruechte"}),
	    "Man sollte manchen Geruechten einfach nicht glauben.");
  
  AddDetail( ({"zugang"}),
	    "Der Zugang zur Bruecke ist durch die beiden Statuen beschuetzt.");

  AddDetail( ({"reliefs"}),
	    "Die Reliefs die in die Waende gemeisselt sind, zeigen das Leben "
	    "in der Zwergenfeste.");

  AddDetail( ({"kettenhemd"}),
	    "Das Kettenhemd ist sehr detailgetreu in den Stein gemeisselt "
	    "worden. Man kann sogar die einzelnen Kettenringe sehen.");
  
  AddDetail( ({"axt","aexte"}),
	    "Die grossen Aexte der Zwergenkrieger sehen wirklich bedrohlich "
	    "aus. Auf einem Axtblatt erkennst Du eine kleine Inschrift.");

  AddDetail( ({"kettenringe"}), 
            "Zwischen ein paar Kettenringen ist ein Glitzern zu sehen.");

  AddDetail( ({"glitzern"}),
	    "Das Glitzern stammt anscheinend von ein paar Diamantsplittern, "
	    "die in das Kettenhemd eingesetzt wurden. Es sieht einfach "
	    "phantastisch aus und zeigt erneut den Reichtum und die "
	    "Detailverliebtheit der Zwerge.");

  AddDetail( ({"reichtum"}),
	    "Die Zwerge der Feste sind sehr reich.");

  AddDetail( ({"detailverliebtheit","fall","feinheiten"}),
	    "Die Zwerge arbeiten die Feinheiten sehr gut aus dem Stein "
	    "heraus und ergaenzen sie noch ab und zu um Edelsteine oder wie "
	    "in diesem Fall mit Diamantsplittern.");
  
  AddDetail( ({"diamantsplitter","diamantsplittern"}),
	    "Die Diamantsplitter sind ganz klein und man kann sie leicht "
	    "uebersehen.");

  AddDetail( ({"edelsteine"}), 
            "Edelsteine siehst Du hier gerade keine.");

  AddDetail( ({"inschrift"}),
	    "Du kannst die Inschrift lesen.");

  AddDetail( ({"leben"}),
	    "Du siehst in den Stein gemeisselte Zwerge, die Metall auf einem "
	    "Amboss verarbeiten, Zwerge die Skulpturen aus dem Stein schlagen "
	    "und andere Zwerge die die Kreaturen der Dunkelheit aus Ardhmir "
	    "zurueck draengen.");

  AddDetail( ({"metall","amboss","bearbeiten"}),
	    "Die Zwerge sind sehr gut im Bearbeiten von Metall.");
  
  AddDetail( ({"skulpturen"}),
	    "Die Skulpturen die die Zwerge schaffen koennen, sehen manchmal "
	    "lebensecht aus. Die beiden Statuen am Anfang der Bruecke sind ein "
	    "gutes Beispiel dafuer.");

  AddDetail( ({"beispiel","beispiele"}),
	    "Du findest viele Beispiele von der Kunst der Zwerge in Ardhmir.");

  AddDetail( ({"kreaturen","dunkelheit"}),
	    "Viele Kreaturen der Dunkelheit haben es schon probiert in das "
	    "Zwergenreich einzudringen. Nur ein paar wenige haben es "
	    "geschafft und wurden mit dem Tod bestraft.");

  AddDetail( ({"art","magie"}),
	    "Du hast das Gefuehl, dass diese Magie, die Du spuerst, Dich nicht "
	    "so einfach ueber die Bruecke gehen laesst.");
  
  AddDetail( ({"tod"}),
	    "Der Tod ist im Silberland nicht unbedingt das Ende.");

  AddDetail( ({"gefuehl"}), 
            "Dein Gefuehl hat Dich nur ganz selten betrogen.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland.");

  AddDetail( ({"ende"}),
	    "Das Ende ist noch lange nicht gekommen.");

  AddDetail( ({"marmor"}),
	    "Es sieht nur so aus wie Marmor. Es ist jedoch keiner, sondern "
	    "nur glatt geschliffen und poliert.");
  
  AddDetail( ({"kunst"}),
	    "Die hohe Kunst der Zwerge wird im gesamten Silberland "
	    "geschaetzt.");

  AddDetail( ({"stein","fels"}), 
            "Stein und Fels befinden sich rings um Dich herum, schliesslich "
	    "befindest Du Dich in einer Hoehle, obwohl es hier nicht so "
	    "aussieht.");

  AddDetail( ({"wunder"}),
	    "Wunder gibt es immer wieder.");

  AddDetail( ({"belueftungssystem"}),
	    "Es ist gut versteckt und Du kannst es nicht sehen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst frische Luft, aber auch noch einen "
		  "komischen Geruch.");  
 
  AddSmell( ({"luft"}),
	   "In der ganzen Zwergenfeste ist die Luft frisch. Die Zwerge haben "
	   "ein sehr gutes Belueftungssystem.");

  AddSmell( ({"geruch"}),
	   "Ein leicht uebler Geruch dringt aus dem Abgrund. Du willst "
	   "eigentlich gar nicht wissen, was dort so komisch riecht.");
  
  
  AddSound(DEFAULT_SOUND, "Du hoerst lauter Geraeusche in der Zwergenfeste.");

  AddSound( ({"geraeusche"}),
	   "Die Geraeusche werden von den Zwergen verursacht, die hier "
	   "arbeiten und leben.");
  
  AddReadDetail( ({"schild"}),
		"+-----------------------------------------------+\n"
		"|                                               |\n"
		"|                                               |\n"
		"|              Post von Ardhmir                 |\n"
		"|                                               |\n"
		"|                                               |\n"
		"+-----------------------------------------------+\n");

  AddReadDetail( ({"inschrift"}),
		"Beuge Dein Knie vor den Zwergenkriegern und sie gewaehren "
		"Dir Gnade und Du kannst tiefer in das Reich der Zwerge "
		"gelangen.");

//-----Details Ende-----
AddItem(NPC "zwergn", REFRESH_DESTRUCT);

AddExit("sueden", ROOM "zwfe17");
AddExit("westen", ROOM "zwfe10");
AddExit("norden", ROOM "zwfep");
AddSpecialExit( "nordosten", "go_nw" );

AddCmd( ({"dreh", "drehe" }), "drehen" );
AddCmd( ({"beug", "beuge" }), "beugen" );

}
int go_nw(string dir)
{

  if(!(present("zwinvis1", TP)))
  {
    write( BS( "Die Zwergenkrieger bewegen sich ploetzlich und schleudern "
               "Dich zurueck, so dass Du an der Wand landest. Eine Stimme "
	       "in Deinem Kopf fluestert Dir zu: Wir lassen Dich nicht so "
	       "einfach durch! Weiche oder stirb!") );
    say("Die Zwergenkrieger aus Stein halten "+TP->Name(WEN)+" davon ab, "
      "die Bruecke zu ueberqueren.\n");
    TP->AddHp(-50);
    return -1;
  }
  write(BS("Du gehst ohne von den Zwergenkriegern beachtet zu werden weiter "
	   "nach Nordosten.\n"));
 
  say(TPN+" verschwindet nach Nordosten.\n");
  this_player()->move(ROOM "zwfe19", M_TPORT);
  return 1;
}
int drehen(string str)
{
 object killer;
 notify_fail("Wie moechtest Du Dich umdrehen?\n");
 if ( member( ({ "schnell", "schnell um" }),str) != -1) 
  {
   if ( anzahl )
    {
    write(BS( "Du drehst Dich schnell um und erkennst eine dunkle Gestalt mit "
	      "einem Messer, die Dir wohl die Kehle durschneiden wollte.\n"));
    say( TPN+" dreht sich schnell um und sieht eine Gestalt vor sich "
	     "stehen.\n");
    killer=clone_object (NPC "killer" );
    killer->move(TO,M_GO|M_NOCHECK,"schleicht um Dich herum");
    anzahl--;
    return 1;
    }
    else
    {
    write(BS( "Du drehst Dich schnell um, siehst aber niemanden hinter Dir. Du "
	      "hast Dich wohl getaeuscht.\n"));
    say( TPN+" scheint an Paranoia zu leiden.\n");
    return 1;   
    }
  }
}
void reset()
{
  ::reset();
  anzahl=1; 
}
int beugen(string str)
{
 object zwinvis1;

 notify_fail("Vor wem moechtest Du was beugen? \n");

 if(!str || str == "") return 0;
 if(!(str == "knie vor zwergenkriegern" ||
      str == "knie vor zwergenkrieger" ||
      str == "knie vor kriegern" ||
      str == "knie vor krieger" ||
      str == "knie vor statuen" ||
      str == "knie vor statue" )) return 0;
 
 if( str == "knie vor zwergenkriegern" ||
     str == "knie vor zwergenkrieger" ||
     str == "knie vor kriegern" ||
     str == "knie vor krieger" ||
     str == "knie vor statuen" ||
     str == "knie vor statue"){
    
  if(present("zwinvis1", TP)){
	  
  write(BS("Du musst Dein Knie nicht beugen. Du hast bereits als wuerdig "
	   "befunden und die Statuen werden Deinen Weg nicht behindern.\n"));
  return -1;
  }
  write(BS("Du beugst Dein Knie voller Demut vor den grossen Steinstatuen der "
	   "Zwergenkrieger und ein Lichtstrahl trifft Dich kurz. Anscheinend "
	   "wurdest Du soeben als wuerdig empfunden und kannst nun ohne "
	   "Probleme die Bruecke ueberqueren.\n"));
 
  say(TPN+" wird von einem Lichtstrahl getroffen und scheint wuerdig zu sein "
	  "tiefer in das Reich der Zwerge vorzudringen.\n");
  zwinvis1=clone_object(OBJ "zwinvis1")->move(TP, M_NOCHECK);
  return 1;
  }
}
string spiegelbild(string key)
{
    if ( anzahl )
    {
    return(BS("Dein Spiegelbild laechelt Dich an. Jedoch scheint noch eine "
	      "andere Gestalt hinter Dir zu stehen und Dich mit einem "
	      "boesartigen und hinterhaeltigen Blick zu beobachten.\n"));
    }
    else
    {
    return(BS("Dein Spiegelbild laechelt Dich an. Ansonsten gibt es momentan "
	      "nichts zu sehen."));
    }
}
string gestalt(string key)
{
    if ( anzahl )
    {
    return(BS("Die Gestalt scheint Dir nicht gewogen zu sein. Sie will Dich "
	      "anscheinend ueberfallen oder Dir noch schlimmere Dinge "
	      "antun. Dreh Dich schnell um!\n"));
    }
    else
    {
    return(BS("Du siehst Deine Gestalt, wie sie sich in der Saeule spiegelt."));
    }
}
string dinge(string key)
{
    if ( anzahl )
    {
    return(BS("Um den schlimmen Dingen zu entgehen, sollstest Du Dich schnell "
	      "umdrehen.\n"));
    }
    else
    {
    return(BS("Verschiedene Dinge gefallen Dir, aber Dein langweiliges "
	      "Spiegelbild gefaellt Dir heute nicht."));
    }
}
string blick(string key)
{
    if ( anzahl )
    {
    return(BS("Der Blick der Gestalt wirkt feindselig auf Dich. Du solltest "
	      "Dich vielleicht schnell umdrehen, bevor etwas passiert.\n"));
    }
    else
    {
    return(BS("Dein Spiegelbild laechelt Dich an. Dein Blick wirkt nicht "
	      "gerade entzueckt. Vielleicht solltest Du es spaeter noch einmal "
	      "versuchen!"));
    }
}

