// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, " Auf einer Waldlichtung");
  SetProp( P_INT_LONG,
	"Die Wellen des Sees plaetschern leise an das Ufer und das Schilf "
        "wiegt sich leicht im Wind. Einige Seerosen sind von hier aus in der "
        "Mitte des Sees zu sehen. Im Norden fliesst ein Fluss in den See "
        "hinein. Man kann ihn ueber eine alte Bruecke jedoch problemlos "
        "ueberqueren." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1);

//-----Details Anfang-----
  
  AddDetail( ({"wellen"}), 
            "Kleine Wellen schwappen sanft an das Ufer des Sees.");

  AddDetail( ({"see","sees","westen"}),
	    "Der See ist in der Mittelpunkt der Lichtung, an dessen Rand sich "
	    "der Weg entlang schlaengelt. Ansonsten ist der See von einer "
	    "Blumenwiese umgeben.");

  AddDetail( ({"ufer"}),
	    "Einige Wellen plaetschern ans Ufer. Ausserdem sind grosse "
	    "Schilfrohre und einige andere Pflanzen am Ufer zu sehen.");

  AddDetail( ({"schilf","schilfrohre"}),
	    "Grosse Schilfrohre stehen im Wasser am Ufer des Sees. Sie sind "
	    "sicher ein idealer Nestplatz fuer verschiedene Vogelarten hier "
	    "am See.");
  
  AddDetail( ({"wind","lueftchen"}),
	    "Der Wind weht nur ganz leicht. Es ist eher ein Lueftchen als ein "
	    "Wind.");
  
  AddDetail( ({"seerosen","mitte"}), 
            "In der Mitte des Sees sind ein paar Seerosen zu sehen. Ihre "
	    "Blueten sind weit geoeffnet.");

  AddDetail( ({"norden","fluss"}),
	    "Im Norden ist ein Fluss, der in dem See muendet.");

  AddDetail( ({"bruecke"}),
	    "Eine alte Bruecke fuehrt ueber den Fluss. Du kannst ihn also "
	    "ohne nass zu werden ueberqueren.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen einige kleine Steinchen. Ansonsten ist nur "
	    "trockene Erde zu sehen.");
  
  AddDetail( ({"himmel","sonne"}),
	    "Der Himmel ist schoen blau und die Sonne scheint.");

  AddDetail( ({"mittelpunkt"}), 
            "Der See ist der Mittelpunkt der Lichtung.");

  AddDetail( ({"lichtung"}),
	    "DU befindest Dich auf einem Weg am Rand der Lichtung.");

  AddDetail( ({"blumenwiese","wiese"}),
	    "Die Wiese umgibt fast den gesamten See. Nur an der Stelle wo "
	    "der Weg ist, wachsen keine Blumen oder Graeser.");

  AddDetail( ({"pflanzen"}),
	    "Es stehen einige Wasserpflanzen direkt am schlammigen Ufer.");
  
  AddDetail( ({"wasserpflanzen"}),
	    "Neben dem Schilf erkennst Du einige Sumpfdotterblumen. Die "
	    "anderen Pflanzen kennst Du nicht. Du beschliesst Dich demnaechst "
	    "mit dieser Thematik mehr zu beschaeftigen.");

  AddDetail( ({"sumpfdotterblume","sumpfdotterblumen","wassergewaechs","gewaechs","gelb"}), 
            "Die Sumpfdotterblume ist ein Wassergewaechs und leuchtet in einem "
	    "strahlenden Gelb.");

  AddDetail( ({"weg","norden","sueden","rand","stelle"}),
	    "Der Weg schlaengelt sich am Rand der Lichtung zwischen den "
	    "Baeumen des Waldes im Osten und dem See im Westen von Norden nach "
	    "Sueden.");

  AddDetail( ({"osten","waldes","wald"}),
	    "Im Osten siehst Du die grossen Baeume des Waldes.");

  AddDetail( ({"baeumen","baeume"}),
	    "Grosse Baeume saeumen den Weg im Osten. Zwischen den Baeumen sind "
	    "einige Buesche zu sehen.");
  
  AddDetail( ({"buesche"}),
	    "Die Buesche verhindern, dass Du weiter in den Wald vordringen "
	    "kannst. Du musst auf dem Weg bleiben.");

  AddDetail( ({"blumen"}), 
            "Viele Blumen wachsen auf der Wiese. Wenn Du mehr erfahren willst, "
	    "dann musst Du schon naeher ran gehen.");

  AddDetail( ({"graeser","gras"}),
	    "Auf der Wiese waechst natuerlich auch Gras.");

  AddDetail( ({"vogelarten","voegel","unmenge"}),
	    "An diesem See gibt es sicher eine Unmenge verschiedener "
	    "Vogelarten.");

  AddDetail( ({"nestplatz","nester"}),
	    "Da das Schilf sehr dicht steht, kannst Du keine Nester sehen. Du "
	    "solltest die Voegel auch nicht stoeren.");
  
  AddDetail( ({"blueten","faerbung"}),
	    "Die Blueten sind gross und weit geoeffnet. Sie haben eine "
	    "herrliche weisse und rosa Faerbung.");

  AddDetail( ({"erde"}), 
            "An der trockenen Erde ist nichts interessantes zu entdecken.");

  AddDetail( ({"steinchen"}),
	    "Die Steinchen sind absolut wertlos.");

  AddDetail( ({"nase"}),
	    "Du hast eine recht grosse Nase.");

  AddDetail( ({"thematik","ahnung"}),
	    "Davon hast Du keine Ahnung.");
  
  AddDetail( ({"wasser"}),
	    "Im See ist viel Wasser.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Der Duft der Blumen steigt Dir in die Nase.");  
 
  AddSmell( ({"duft","blumen"}),
	   "Die Blumen duften suesslich.");
  
  AddSound(DEFAULT_SOUND, "Du hoerst die Wellen, wie sie ans Ufer plaetschern. "
		          "Ausserdem hoerst Du das Gezwitscher der Voegel.");

  AddSound( ({"wellen"}),
	   "Die Wellen plaetschern ganz leise ans Ufer.");
  
  AddSound( ({"gezwitscher","voegel","lied"}),
	   "Die Voegel singen ein froehliches Lied.");

//-----Details Ende-----
AddItem( "/d/ebene/Silberwald/npc/otter", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "zww6",
          P_MNPC_AREA:({ROOM "zww6"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("norden", ROOM "zww7");
AddExit("suedwesten", ROOM "zww5");

}
