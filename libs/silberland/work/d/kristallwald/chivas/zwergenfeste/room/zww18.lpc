// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Waldlichtung");
  SetProp( P_INT_LONG,
	"Der See liegt ruhig in der Mitte der Lichtung, die von grossen "
        "Baeumen eingerahmt ist. Viele Blumen wachsen auf der Lichtung und "
        "verleihen diesem Teil des Waldes eine wunderschoene Atmosphaere." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1);

//-----Details Anfang-----
  
  AddDetail( ({"see","mitte"}), 
            "In der Mitte der Lichtung ist ein grosser See. Einige Seerosen "
	    "sind zu sehen und einige Wasserpflanzen stehen am Ufer im "
	    "Wasser.");

  AddDetail( ({"lichtung"}),
	    "Die Lichtung liegt im hellen Sonnenschein. Es ist ein sehr "
	    "idyllischer Ort.");

  AddDetail( ({"baeume","baeumen"}),
	    "Die grossen Baeume des Waldes umrunden die Lichtung. Waeren sie "
	    "nicht da und der Wald weg, dann gaebe es auch keine Lichtung.");

  AddDetail( ({"blumen"}),
	    "Du erkennst verschiedene Arten von Blumen.");
  
  AddDetail( ({"teil","wald","waldes"}),
	    "Dieser Teil des Waldes ist wirklich schoen.");
  
  AddDetail( ({"atmosphaere","ort"}), 
            "Es ist sehr idyllisch an diesem Ort. Hier kann man sich richtig "
            "wohl fuehlen.");

  AddDetail( ({"boden"}),
	    "Am Boden siehst Du viel Gras und viele Blumen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist herrlich blau.");

  AddDetail( ({"wasser"}),
	    "Das Wasser ist glasklar. Du kannst ein paar Fische sehen.");
  
  AddDetail( ({"ufer"}),
	    "Am Ufer siehst Du Schilf und noch andere Wasserpflanzen.");

  AddDetail( ({"wasserpflanzen"}), 
            "Da Du Dich ja bereits seit Jahren mit Wasserpflanzen "
            "beschaeftigst, weisst Du, dass es sich bei den Wasserpflanzen um "
            "Kalmus, Sumpfcalla, Froschloeffel und "
            "Wiesenknoeterich handelt.");

  AddDetail( ({"seerosen"}),
	    "Die Seerosen schwimmen auf der Wasseroberflaeche und haben ihre "
	    "Blueten weit geoeffnet.");

  AddDetail( ({"blueten"}),
	    "Es gibt ziemlich viele Blueten hier. Die Blueten der Seerosen "
            "sind rosa und weiss und sehen wunderschoen aus.");

  AddDetail( ({"wasseroberflaeche","oberflaeche"}),
	    "An der Wasseroberflaeche sind ein paar kleine Wellen zu sehen.");
  
  AddDetail( ({"wellen"}),
	    "Die Wellen schwappen sanft an das Ufer.");

  AddDetail( ({"sonneschein"}), 
            "Die Lichtung steht im vollen Sonnenschein, da die Sonne fast "
	    "senkrecht steht.");

  AddDetail( ({"sonne"}),
	    "Die Sonne befindet sich am blauen Himmel. Wo sollte sie auch "
	    "sonst sein?");

  AddDetail( ({"arten"}),
	    "Auf der Wiese wachsen Schlangen-Knoeterich, Wiesenschaumkraut, "
            "Loewenzahn und Gaensebluemchen.");

  AddDetail( ({"gras"}),
	    "Das Gras ist schoen gruen.");
  
  AddDetail( ({"fische"}),
	    "Es sind ganz kleine Fische, die sich zwischen den Wasserpflanzen "
            "tummeln.");

  AddDetail( ({"schilf"}), 
            "Das Schilf waechst gerade und hoch.");

  AddDetail( ({"kalmus","bluetenkolben","sumpfpflanze","sommer","struktur","randbereich"}),
	    "Kalmus besticht durch seine aromatisch duftenden, weissbunten "
            "Blaetter und zeigt im Sommer herrlich feine Bluetenkolben. Als "
            "schilfartige Sumpfpflanze  bringt der Kalmus Struktur in den "
            "Randbereich des Sees. ");

  AddDetail( ({"sumpfcalla","suempfen","erlenbruechen","sumpfzone"}),
               "Aus Suempfen und Erlenbruechen kennst Du diese wildromantische "
               "Pflanze. Fuer die Gestaltung einer naturnahen Wasserlandschaft "
               "ist sie unentbehrlich, hat aber auch im schmueckenden "
               "Zierteich mit Sumpfzone vor Deinem Seherhaus eine absolute "
               "Berechtigung.");

  AddDetail( ({"froschloeffel","sumpfpflanze","namensgebung","bluetenrispe"}),
               "Der Froschloeffel ist eine rechte Sumpfpflanze. Die Form seiner "
               "Blaetter sorgt fuer die Namensgebung. Herrlich frischgruen "
               "schieben sie sich aus dem Wasser und werden gekroent von einer "
               "zarten Bluetenrispe.");
  
  AddDetail( ({"wiesenknoeterich","wildpflanze","seeraemder","gaerten","begleiter","flachmoore"}),
               "Du kennst ihn als heimische Wildpflanze feuchter Wiesen "
               "und Flachmoore. Der Wiesenknoeterich ist jedoch auch ein "
               "schmeichelhafter Begleiter fuer Seeraender in unseren Gaerten. "
               "Herrlich intensiv und ausdauernd leuchten seine Blueten.");

  AddDetail( ({"blaetter"}), 
            "Hier gibt es sehr viele Blaetter.");

  AddDetail( ({"wiesen","wiese"}),
	    "Du stehst auf einer Wiese mit vielen Blumen");

  AddDetail( ({"seherhaus"}),
	    "Die Frage ist ob Du schon eins hast.");

  AddDetail( ({"pflanze","pflanzen"}),
	    "Hier gibt es viele Pflanzen.");
  
  AddDetail( ({"wasserlandschaft"}),
	    "Der See ist eine schoene Wasserlandschaft.");

  AddDetail( ({"zierteich","teich"}),
	    "Ein Zierteich vor dem Seherhaus ist schon was ganz tolles.");

  AddDetail( ({"berechtigung","details","magier","mal"}),
	    "Du hast die Berechtigung den Magier, der diese Details "
            "geschrieben hat das naechste Mal anzuschreien.");

  AddDetail( ({"gaensebluemchen"}),
	    "Die Gaensebluemchen sind zart und klein.");

  AddDetail( ({"loewenzahn","kuhblume","butterblume","pusteblume","bluetenstand"
,"einzelblueten","koerbchen"}),
	    "Der Loewenzahn, auch Kuhblume, Butterblume oder Pusteblume "
            "genannt, kennt Du sehr gut. Sein Bluetenstand besteht aus vielen "
            "Einzelblueten, die in einem Koerbchen zusammengefasst sind.");

  AddDetail( ({"schlangen-Knoeterich","schlangen","knoeterich","wiesen-knoeterich","bluetenaehren","volksmund"}),
	    "Der Schlangen- oder auch Wiesen-Knoeterich waechst auf "
            "naehrstoffreichen, feuchten Wiesen. Die walzenfoermigen "
            "Bluetenaehren werden im Volksmund auch 'Zahnbuersten' genannt.");

  AddDetail( ({"zahnbuersten","zahnbuerste","zaehnen","zaehne"}),
	    "Eine Zahnbuerste solltest Du ruhig mal wieder benutzen. Deine "
            "Zaehne sehen nicht besonders sauber aus.");

  AddDetail( ({"wiesenschaumkraut","traube","bluetenblaetter","schaumhaeufchen","eiern","zikade"}),
	    "Die zu einer Traube vereinigten Blueten besitzen vier "
            "Bluetenblaetter. Die auf ihr zu findenden Schaumhaeufchen, mit "
            "den Eiern einer Zikade, haben ihr den Namen gegeben.");

  AddDetail( ({"name","namen"}),
	    "Du hast auch einen Namen,");

  AddDetail( ({"nase"}),
	    "Du hast eine besonders grosse Nase.");

  AddDetail( ({"frage","sache"}),
	    "Fragen ist immer eine gute Sache.");

  AddDetail( ({"jahren"}),
	    "Lang ist es her.");

  AddDetail( ({"form"}),
	    "Die Form sollte man schon wahren.");

  AddDetail( ({"gestaltung","angelegenheit"}),
	    "Die Gestaltung ist eine wichtige und nicht "
            "vernachlaessigbare Angelegenheit.");

  AddDetail( ({"seerand","seeraender"}),
	    "Damit ist das Ufer gemeint.");

  AddDetail( ({"sonnenschein"}),
	    "Der Sonnenschein waermt Dich.");



  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Der Duft der Blumen dringt Dir in die Nase.");  
 
  AddSmell( ({"duft","blumen"}),
	   "Sie duften suesslich.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Voegel zwitschern.");

  AddSound( ({"voegel","lied"}),
	   "Die Voegel singen ihr Lied.");
  
//-----Details Ende-----
  
AddExit("osten", ROOM "zww8");
AddExit("westen", ROOM "zww17");

}
