// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Weg gabelt sich an dieser Stelle. Nach Norden fuehrt der Weg "
        "auf eine kleine Bruecke zu. Nach Sueden fuehrt der Weg in Richtung "
        "Hochebene von Gorthad und nach Osten scheint es auf eine grosse "
        "Lichtung zu gehen, die vor der steilen Felswand der Hochebene "
        "endet." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"weg","stelle","weges"}), 
            "Der Weg gabelt sich und fuehrt in verschiedene Richtungen.");

  AddDetail( ({"norden","bruecke"}),
	    "Im Norden ist eine kleine Bruecke, die ueber einen Fluss zu "
            "fuehren scheint.");

  AddDetail( ({"sueden","richtung"}),
	    "Der Weg in Richtung Sueden fuehrt sicher zur Hochebene von "
            "Gorthad.");
  
  AddDetail( ({"osten","lichtung"}),
	    "Im Osten scheint eine grosse Lichtung zu sein, die direkt vor "
            "der steilen Felswand der Hochebene endet.");

  AddDetail( ({"hochebene","gorthad"}), 
            "Die Felswand ist die natuerliche Grenze der Hochebene. Es sind "
            "sicher schon einige die Felswand herunter gefallen.");

  AddDetail( ({"felswand"}),
	    "Die Felswand fuehrt steil nach oben. Anscheinend ist in der "
            "Felswand ein grosses Tor. Es sieht jedenfalls von hier so aus.");

  AddDetail( ({"boden","untergrund","waldboden"}),
	    "Der Boden ist mit Blaettern und Zweigen der Baeume bedeckt.");

  AddDetail( ({"himmel"}),
	    "Den Himmel kannst Du durch das dichte Blaetterdach des Waldes "
            "kaum erkennen.");
  
  AddDetail( ({"richtungen"}),
	    "Es geht nach Norden, Osten oder Sueden.");

  AddDetail( ({"fluss"}), 
            "Der Fluss plaetschert vor sich hin.");

  AddDetail( ({"grenze","grenzen"}),
	    "Du kennst Deine Grenzen sicher noch nicht.");

  AddDetail( ({"tor"}),
	    "Es scheint ein Tor in der Felswand zu sein. Um mehr zu sehen, "
            "musst Du schon nach Osten gehen.");

  AddDetail( ({"baeumen","baeume"}),
	    "Die Baeume stehen ganz dicht am Weg. Ihre grossen Aeste bilden "
            "mit den daran befindlichen Blaettern ein dichtes Dach.");
  
  AddDetail( ({"blaettern","blaetter"}),
	    "Viele Blaetter liegen auf dem Boden und bilden einen weichen "
            "Untergrund. Die Blaetter sind sicher von den Baeumen abgefallen. "
            "Natuerlich haengt auch eine Unmenge an Blaettern an den Baeumen. "
            "Es sind ja schliesslich nicht alles abgefallen.");

  AddDetail( ({"zweigen","zweige"}), 
            "Kleine Zweige liegen auf dem Boden. Sie knacken leise, wenn man "
            "auf sie tritt.");

  AddDetail( ({"waldes","wald"}),
	    "Du stehst in einem Wald, obwohl man ihn vor lauter Baeumen kaum "
            "sehen kann.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach ist sehr dicht. Nur ab und zu trifft ein "
            "Sonnenstrahl den Waldboden.");

  AddDetail( ({"unmenge","anzahl"}),
	    "Die Anzahl ist so gross, dass Du sie nicht zaehlen kannst.");
  
  AddDetail( ({"sonnenstrahl","strahl"}),
	    "Nur ab und zu erreicht ein waermender Strahl der Sonne den Boden "
            "des Weges.");

  AddDetail( ({"sonne"}), 
            "Die Sonne ist durch das dichte Blaetterdach nicht zu sehen.");

  AddDetail( ({"voegel"}),
	    "Du kannst leider keine sehen. Sie sitzen dicht versteckt im "
            "Blaetterdach.");

  AddDetail( ({"aeste"}),
	    "Grosse Aeste bilden ein dichtes Blaetterdach ueber Dir.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst die klare Luft des Waldes.");  
 
  AddSmell( ({"luft"}),
	   "Sie ist sehr erfrischend.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel zwitschern.");

  AddSound( ({"voegel"}),
	   "Die Voegel singen ein schoenes Lied.");
  
  AddSound( ({"lied"}),
	   "Du verstehst es leider nicht.");

//-----Details Ende-----
  
AddExit("sueden", ROOM "zwfe4");
AddExit("norden", ROOM "zwfee");
AddExit("osten", ROOM "zwfe6");

}
