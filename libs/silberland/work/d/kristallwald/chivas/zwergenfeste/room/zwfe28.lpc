int ost()
{
  if((present("wache", TO)))
  {
    write( BS( "Du willst durch das Tor schreiten, aber die Zwergenwache "
	       "hindert Dich daran.") );
    say("Eine Zwergenwache haelt "+TP->Name(WEN)+" davon ab durch das Tor "
      "zu gehen.\n");
    return -1;
  } 
  else
  {
  write(BS("Du verlaesst den Tunnel in Richtung Osten und das Tor "
            "schlaegt hinter Dir zu.\n"));
  say(TPN+" verschwindet nach Osten durch das Tor und das Tor faellt zu.\n");
  RemoveExit("osten");
  this_player()->move( "/d/kristallwald/chivas/orkhoehle/room/orks10", M_GO);
  return 1;
  }
}

