// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int schluessel_zahl;

void create()
	
{
  ::create();

  schluessel_zahl=1;

  SetProp( P_INT_SHORT, "In der Zwergenfeste von Ardhmir");
  SetProp( P_INT_LONG,
	"Der Gang unterscheidet sich komplett von dem Rest von Ardhmir. Die "
        "Waende sind nur grob behauen und nicht so sauber und glatt wie sonst "
        "in der Feste. Es sieht so aus, als ob man durch diesen Gang die "
        "kleine Stadt vergroessern wollte. Die Bauarbeiten wurden jedoch "
        "gestoppt und es wurde ein grosses Tor mit Gittern im Osten "
        "eingesetzt, dass den Weg versperrt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"gang","ganges"}), 
            "Der Gang ist nur grob behauen. Er wurde anscheinend nicht fertig "
            "gebaut und im Osten durch ein grosses Tor verschlossen. ");

  AddDetail( ({"rest"}),
	    "Der Rest von Ardhmir ist sauber und die Waende sind glatt und "
            "reich verziert. Hier sind die Waende jedoch nur grob behauen.");

  AddDetail( ({"ardhmir","feste","zwergenfeste","teil"}),
	    "Du bist in der Zwergenfeste von Ardhmir. Zwar in einem nicht "
            "so schoenen Teil, aber Du bist da.");

  AddDetail( ({"waende","waenden","wand"}),
	    "Die Waende sind grob behauen. Anscheinend wurden die Arbeiten "
            "an diesem Gang eingestellt. An der Wand direkt neben dem Tor im "
            "Osten steht ein kleiner Tisch mit zwei Stuehlen.");
  
  AddDetail( ({"stadt"}),
	    "Die Zwergenfeste von Ardhmir ist eine kleine Stadt. Man kann sie "
            "natuerlich von ihrer Groesse nicht mit Felonia vergleichen.");

  AddDetail( ({"bauarbeiten","arbeiten","sackgasse","gasse"}), 
            "Die Bauarbeiten wurden hier abgebrochen und ein Tor wurde in "
            "den Gang gebaut, so dass dies eine Sackgasse ist.");

  AddDetail( ({"tor","osten","tores"}),
	    "Das Tor im Osten besteht aus einem grossen Gitter aus "
            "Eisenstaeben. Durch das Tor kommt man so schnell nicht.");

  AddDetail( ({"gitter","gittern"}),
	    "Das Gitter besteht aus dicken Eisenstaeben. An den Eisenstaeben "
            "haengt ein grosses Schild.");

  AddDetail( ({"weg"}),
	    "Der Weg ist durch das grosse Tor versperrt.");
  
  AddDetail( ({"boden"}),
	    "Am Boden liegen grosse Steinbrocken, die von den Waenden "
            "abgehauen wurden.");

  AddDetail( ({"decke","himmel"}), 
            "Die Decke des Ganges ist auch nur grob behauen.");

  AddDetail( ({"tisch"}),
	    "Ein kleiner Tisch steht neben dem Tor. Auf ihm stehen ein paar "
            "Kerzen, die den Gang ein wenig erhellen. Ansonsten ruhen sich "
            "anscheinend hier an dem Tisch und auf den Stuehlen die Wachen "
            "des Tores aus.");

  AddDetail( ({"stuehle","stuehlen"}),
	    "Auf den Stuehlen sitzen normalerweise die Wachen, die auf das "
            "Tor aufpassen.");

  AddDetail( ({"groesse"}),
	    "Groesse ist nicht alles. Sie wird haeufig ueberschaetzt.");
  
  AddDetail( ({"felonia","hauptstadt"}),
	    "Felonia ist die Hauptstadt der Zwerge.");

  AddDetail( ({"zwerge"}), 
            "Die Zwerge sind eine der vielen Rassen im Silberland.");

  AddDetail( ({"rasse","rassen"}),
	    "Es gibt viele verschiedene Rassen im Silberland.");

  AddDetail( ({"silberland"}),
	    "Du bist in im Silberland.");

  AddDetail( ({"loch"}),
	    "Neben dem Schild ist ein kleines Loch zu erkennen.");

  AddDetail( ({"eisenstaebe","eisenstaeben","rost"}),
	    "Die grossen Eisenstaebe sehen sehr stabil aus. Anscheinend "
            "werden sie regelmaessig ausgetauscht. Es ist keinerlei Rost an "
            "ihnen zu sehen.");
  
  AddDetail( ({"schild"}),
	    "Es scheint eine Warnung zu sein, die auf dem Schild steht. Du "
            "kannst das Schild lesen.");

  AddDetail( ({"warnung"}), 
            "Eine Warnung sollte man im Silberland nicht unterschaetzen.");

  AddDetail( ({"steinbrocken","brocken"}),
	    "Die Steinbrocken wurden aus den Waenden und der Decke gehauen, "
            "als der Gang gegraben wurde.");

  AddDetail( ({"kerzen","licht"}),
	    "Die Kerzen brennen und spenden ein wenig Licht, so dass man "
            "in dem Gang auch was sehen kann.");

  AddDetail( ({"wachen"}),
	    "Normalerweise bewachen sie das Tor, damit niemand den Gang "
            "dahinter betritt oder aus diesem heraus kommt.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst das Wachs der Kerzen.");  
 
  AddSmell( ({"kerzen","wachs"}),
	   "Es riecht wie Wachs. Es ist nicht zu glauben.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Geraeusche hinter dem Tor.");

  AddSound( ({"tor","geraeusche"}),
	   "Du hoerst merkwuerdige Geraeusche, als ob jemand hinter dem "
           "Tor ist. Du fuehlst Dich hier nicht wohl bei dem Tor.");
  
  AddReadDetail( ({"schild"}),
		"+-----------------------+\n"
                "|                       |\n"
                "|   Zutritt verboten !  |\n"
                "|                       |\n"
                "|     Lebensgefahr !    |\n"
                "|                       |\n"
                "+-----------------------+\n"
		"Als Du das Schild liest, entdeckst Du ein kleines Loch. "
		"Du kannst sicher in das Loch fassen.\n");


//-----Details Ende-----
AddItem(NPC "wache", REFRESH_DESTRUCT);
AddItem(NPC "wache", REFRESH_DESTRUCT);

AddExit("sueden", ROOM "zwfe12");

//AddCmd( ({"oeffne" }), "oeffnen" );
AddCmd( ({"fass", "fasse" }), "fassen" );

  NewDoor("osten", ORKHOEHLE+"/room/orks10",
             ({"tor"}), ({
             D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY | DOOR_CLOSED,
	     D_LONG,   BS("Das Tor im Osten besteht aus einem grossen Gitter aus "
                         "Eisenstaeben. Durch das Tor kommt man so schnell nicht."),
	     D_GENDER, NEUTER,
	     D_SHORT, "Eine %ses Tor.",
	     D_NAME, "Tor",
	     
              }) );

}

int fassen(string str)
{
  object schluessel;
  notify_fail( "Wo willst Du denn hinein fassen?\n" );
  if ( member( ({ "in loch", "loch" }), str ) != -1 ) 

   {
     if( schluessel_zahl < 1 )
     {
        write("Du fasst in das Loch, suchst etwas herum, findest aber "
	      "nichts. Anscheinend hast Du Dich getaeuscht\n");
        say(sprintf("%s sucht etwas.\n", TP->Name(WER)));
        return -1;
     }
      if ( present("\nzwergenschluessel",TP) )
      {
      write("Du fasst in das Loch und findest einen verzierten Schluessel. Da "
            "Du bereits einen hast laesst Du ihn fuer den naechsten Abenteurer "
	    "liegen.\n" );
      say(sprintf("%s findet etwas, laesst es jedoch liegen.\n", TP->Name(WER)));
      return -1;
      }
      else
      {
        {schluessel = clone_object( OBJ "zwergenschluessel");
        if ( ME_TOO_HEAVY == schluessel->move(TP,M_GET|M_SILENT) )

          {
          write(
          "Der Schluessel wuerde Dir zu schwer werden.\n" );
          say(BS(sprintf("%s ist ein absolutes Weichei und kann nicht einmal "
			 "mehr die leichtesten Sachen tragen.\n", TP->Name(WER))));
          schluessel -> remove();
          return 1;
          }
          else
          {
          write("Du fasst in das Loch und findest einen verzierten Schluessel, "
                "den Du sofort einsteckst.\n");
          say(sprintf("%s fasst wo rein und steckt etwas ein.\n",
          TP->Name(WER)));
          schluessel_zahl--;
          return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}
