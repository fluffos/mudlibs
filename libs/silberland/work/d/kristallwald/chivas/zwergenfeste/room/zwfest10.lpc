// von Chivas

inherit "/d/gebirge/angrox/room/std_bergwerk_new";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int eisenzahl;

void create()
	
{
  ::create();

  eisenzahl=3;

  SetProp( P_INT_SHORT, "In einem Stollen");
  SetProp( P_INT_LONG,
	"Einige Fackeln an den Waenden erhellen die Arbeiten hier am Stollen. "
	"Die Zwerge sind hier noch nicht sehr weit vorgedrungen und haben hier "
	"erst mit der Arbeit und dem Abbau der Metalle angefangen. Viele "
	"Steine und Felsbrocken liegen auf dem Boden herum." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"fackeln"}), 
            "Die Fackeln erhellen den Stollen.");

  AddDetail( ({"waenden","wand","waende"}),
	    "An den Waenden haengen einige Fackeln und es sind viele Adern "
	    "zu sehen, die noch abgebaut werden muessen.");
  
  AddDetail( ({"arbeiten","teil"}), 
            "Die Arbeiten in diesem Teil des Stollen sind noch nicht "
	    "abgeschlossen.");

  AddDetail( ({"stollen"}),
	    "Du bist am Ende des Stollen angekommen. Hier sind die Arbeiten "
	    "noch nicht weit voran geschritten.");
  
  AddDetail( ({"zwerge","zwergen"}), 
            "Die Zwerge haben hier noch viel zu tun.");

  AddDetail( ({"arbeit","abbau"}),
	    "Der Abbau der Adern muss hier noch stattfinden. Die Arbeit hat "
	    "hier erst begonnen.");
  
  AddDetail( ({"metalle","eisen","gold","silber","metall"}), 
            "Es wird hier viel Eisen abgebaut und nur wenig Gold und Silber.");

  AddDetail( ({"steine"}),
	    "Viele grosse und kleine Steine liegen auf dem Boden herum.");
  
  AddDetail( ({"felsbrocken"}), 
            "Grosse Felsbrocken, die die Zwerge aus den Waenden gebrochen "
	    "haben liegen herum. Sie muessen noch abtransportiert werden.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen lauter Steine und grosse Felsbrocken.");
  
  AddDetail( ({"decke"}), 
            "Die Decke ist nicht sehr interessant.");

  AddDetail( ({"adern"}),
	    "Du kannst verschiedene Adern an den Waenden sehen, die Metall "
	    "enthalten und die von den Zwergen noch abgebaut werden muessen.");
  
  AddDetail( ({"ende"}), 
            "Der Stollen ist noch nicht sehr lang und Du hast das Ende "
	    "erreicht.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es ist stickig.");  

  AddSound(DEFAULT_SOUND, "Man hoert nur das Haemmern der Zwerge in den "
		  "Stollen.");

  AddSound( ({"haemmern","zwerge","stollen"}),
	   "*haemmer*");
  
//-----Details Ende-----
AddItem(NPC "zwerga", REFRESH_DESTRUCT);
  
AddExit("norden", ROOM "zwfest8");

//AddCmd( ({"bau","baue" }), "bauen" );

}
