// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl=1;

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Zwergenfeste von Ardhmir");
  SetProp( P_INT_LONG,
	"Die grosse Schlucht, die die riesige Halle in zwei Haelften trennt, "
	"hat hier ihre breiteste Stelle und die Saeulen scheinen sogar noch "
	"ein wenig dicker zu sein als im Norden oder im Sueden. Am Rand zum "
	"Abgrund steht eine kleine Gedenktafel." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"schlucht","abgrund"}), 
            "Die Schlucht durchzieht die ganze Halle und teilt sie in zwei "
	    "Haelften. Der Abgrund scheint bodenlos zu sein, aber Du kannst ja "
	    "mal an den Rand gehen und in den Abgrund hinunter gucken ob "
	    "Du etwas erkennen kannst.");

  AddDetail( ({"halle"}),
	    "Die riesige Halle ist in zwei Haelften geteilt. Du befindest Dich "
	    "momentan im westlichen Teil der Halle, die durch den tiefen "
	    "Abgrund getrennt ist.");

  AddDetail( ({"haelften","haelfte"}),
	    "Die zwei Haelften die von der Schlucht getrennt werden, bilden "
	    "zusammen die groesste Halle, die Du jemals gesehen hast.");

  AddDetail( ({"stelle"}),
	    "An dieser Stelle ist die Schlucht breiter als sonst wo in der "
	    "Halle. Selbst ein guter Bogenschuetze wuerde es nicht schaffen "
	    "mit einem Pfeil die andere Seite zu erreichen.");
  
  AddDetail( ({"saeulen","saeule"}),
	    "Die Saeulen sind ein wenig dicker an dieser Stelle, da sie ein "
	    "groesseres Gewicht der Decke, durch die breite Schlucht, tragen "
	    "muessen. Viele leuchtende Steine sind an ihnen befestigt, die "
	    "die Halle sehr gut beleuchten.");
  
  AddDetail( ({"norden","sueden"}), 
            "Die Halle fuehrt weiter auf dieser Seite nach Norden und Sueden "
	    "weiter.");

  AddDetail( ({"rand"}),
	    "Am Rand der Schlucht wurde auf einem Podest eine Gedenktafel "
	    "angebracht.");

  AddDetail( ({"boden","gebietes","gebiet"}),
	    "Ausnahmsweise faellt dem dummen Magier dieses Gebietes diesmal "
	    "keine bessere Beschreibung fuer den Boden ein als: Dieses Detail "
	    "wurde an einen Gnom vermietet.");

  AddDetail( ({"waende","wand","waenden","westen"}),
	    "Die Wand im Westen von Dir wurde mit einem riesigen Relief von "
	    "den Steinmetzen der Zwergenfeste verschoenert.");
  
  AddDetail( ({"decke"}),
	    "Die Decke ist weit ueber Dir und erstreckt sich von dieser "
	    "Seite der Halle bis auf die andere Seite. Du kannst leider nichts "
	    "interessantes an ihr entdecken.");

  AddDetail( ({"schwaerze"}), 
            "In der Schlucht ist nur tiefste Schwaerze zu erkennen.");

  AddDetail( ({"teil"}),
	    "Du befindest Dich westlich der Schlucht. Wenn Du auf die andere "
	    "Seite willst, musst du eine Bruecke im Norden oder Sueden "
	    "benutzen.");

  AddDetail( ({"bruecke","bruecken"}),
	    "Im Norden und im Sueden befinden sich jeweils zwei Bruecken, "
	    "ueber die man auf die andere Seite gelangen kann.");

  AddDetail( ({"seite"}),
	    "Auf der anderen Seite der Schlucht erkennst Du ein paar Zwerge "
	    "und ein paar andere Abenteurer wie Du einer bist. Wink ihnen doch "
	    "mal zu.");
  
  AddDetail( ({"abenteurer"}),
	    "Ein paar Abenteurer sind auf der anderen Seite der Schlucht zu "
	    "sehen. Sie sind schon weiter in die Zwergenfeste von Ardhmir "
	    "vorgedrungen.");

  AddDetail( ({"zwerge"}), 
            "Ein paar Zwerge gehen auf dieser Seite der Halle und ein paar "
	    "auf der anderen Seite ihren Beschaeftigungen nach. Es ist auch "
	    "kein Wunder in einem Zwergenreich auf Zwerge zu treffen.");

  AddDetail( ({"zwergenfeste","feste","ardhmir","zwergenreich","reich"}),
	    "Das Zwergenreich von Ardhmir ist gross und maechtig.");

  AddDetail( ({"beschaeftigungen","angelegenheiten"}),
	    "Die Beschaeftigungen der Zwerge gehen Dich nichts an. Kuemmere "
	    "Dich um Deine eigenen Angelegenheiten.");

  AddDetail( ({"wunder"}),
	    "Es ist ein Wunder, dass Du ueberhaupt bis hier her gekommen "
	    "bist.");
  
  AddDetail( ({"bogenschuetze","pfeil"}),
	    "Warum sollte hier jetzt ein Bogenschuetze oder ein Pfeil sein. "
	    "Du untersuchst wirklich alles. Sei aber ruhig stolz auf Dich!");

  AddDetail( ({"gewicht"}), 
            "Das Gewicht der Decke ist sicher sehr hoch.");

  AddDetail( ({"steine","barinsteine"}),
	    "Die Barinsteine leuchten die Halle mit ihrem gelblichen Licht "
	    "sehr gut aus.");

  AddDetail( ({"podest"}),
	    "An dem Podest haengt eine goldene Gedenktafel.");

  AddDetail( ({"gedenktafel","tafel"}),
	    "Die Gedenktafel besteht aus Gold mit Mithrilinsignien.");
  
  AddDetail( ({"gold"}),
	    "Das Gold der Tafel glaenzt wie frisch poliert.");

  AddDetail( ({"mithrilinsignien","insignien"}), 
            "Die Insignien sind kleine Buchstaben.");

  AddDetail( ({"mithril"}),
	    "Mithril ist im Silberland sehr wertvoll.");

  AddDetail( ({"buchstaben"}),
	    "Du kannst die Buchstaben lesen.");

  AddDetail( ({"silberland","ort"}),
	    "Das Silberland ist ein toller Ort um etwas zu erleben und Freunde "
	    "zu treffen.");
  
  AddDetail( ({"freunde"}),
	    "Entschuldige, dass war nicht persoenlich gemeint. Du kannst "
	    "sicher nichts dafuer, dass Du keine hast.");

  AddDetail( ({"magier"}),
	    "Magier sind boese, hinterhaeltig und gemein!");
  
  AddDetail( ({"beschreibung","beschreibungen"}),
	    "Die Beschreibung von Beschreibung faellt ziemlich schwer.");

  AddDetail( ({"detail","forscherpunkt"}),
	    "Es ist wirklich beeindruckend, dass Du sogar das Detail 'Detail' "
	    "untersuchst. Naja, vielleicht war es ja ein Forscherpunkt.");
  
  AddDetail( ({"gnom","gnome","rassen"}),
	    "Gnome sind eine der vielen Rassen im Silberland, an die gerne "
	    "mal etwas vermietet wird.");

  AddDetail( ({"steinmetzen","steinmetze"}),
	    "Momentan arbeitet keiner der Steinmetze mehr an dem Relief. Sie "
	    "wurden schon vor langer Zeit damit fertig und arbeiten jetzt "
	    "sicher irgendwo anders in der Feste.");
  
  AddDetail( ({"zeit"}),
	    "Es ist schon lange her.");

  AddDetail( ({"relief","bild"}),
	    "Das in den Fels gehauene Relief zeigt die grosse Halle und die "
	    "Schlucht. Auf dieser Seite stuermen einige Trolle und Orks in "
	    "Richtung Schlucht auf ein paar Verteidiger zu. Auf der anderen "
	    "Seite stehen grosse Kampfmaschinen der Zwerge. Es ist ein "
	    "beeindruckendes aber auch duesteres Bild.");
  
  AddDetail( ({"verteidiger"}),
	    "Die Verteidiger auf dieser Seite sind ein paar uebrig gebliebene "
	    "Zwerge, die sicher durch die Orks und Trolle erschlagen wurden.");

  AddDetail( ({"fels","hoehle"}),
	    "Eine Hoehle besteht meistens aus Fels.");
  
  AddDetail( ({"trolle","orks","wut","angreifer"}),
	    "Die Trolle und Orks scheinen vor Wut zu rasen und alles zu "
	    "erschlagen, was sich ihnen entgegen stellt.");

  AddDetail( ({"richtung"}),
	    "Die richtige Richtung ist immer sehr wichtig.");
  
  AddDetail( ({"kampfmaschinen","maschinen","position","steinbrocken","speere","hallenseite"}),
	    "Auf der anderen Hallenseite auf dem Relief sind Zwerge zu sehen, "
	    "die grosse Kampfmaschinen in Position bewegen, die sicher auch "
	    "grosse Steinbrocken und Speere ueber die Schlucht auf die "
	    "Angreifer schleudern koennen.");
  
  AddDetail( ({"licht"}),
	    "Das Licht der Barinsteine erhellt die gesamte Halle.");

  AddDetail( ({"belueftungssystem"}),
	    "Das Belueftungssystem ist gut versteckt und Du kannst es nicht "
	    "sehen.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Man riecht frische Luft und einen komischen "
		          "Geruch.");  
 
  AddSmell( ({"luft"}),
	   "Die frische Luft stammt von dem guten Belueftungssystem in der "
	   "Zwergenfeste.");

  AddSmell( ({"geruch"}),
	   "Der komische Geruch kommt aus dem Abgrund. Du willst eigentlich "
	   "gar nicht wissen, was da unten vermodert.");
  
  AddSound(DEFAULT_SOUND, "Du hoerst die Zwerge in der grossen Halle.");

  AddSound( ({"zwerge"}),
	   "Die Zwerge gehen ihren Beschaeftigungen laut nach.");
  
  AddReadDetail( ({"buchstaben"}),
		"In Gedenken an die tapferen Zwerge, die die zweite Halle "
		"gegen die Trolle und Orks verteidigt haben und ihr Leben "
		"gelassen haben.");

//-----Details Ende-----
  
AddExit("sueden", ROOM "zwfe16");
AddExit("norden", ROOM "zwfe18");

AddCmd( ({"guck", "gucke" }), "gucken" );
AddCmd( ({"wink", "winke" }), "winken" );
AddCmd( ({"wirf", "werf","werfe" }), "werfen" );

}  
void reset()
{
  ::reset();
  anzahl=1; 
}
int gucken(string str)
{
   notify_fail("Was moechtest Du hinunter gucken?\n");
   if ( member( ({ "in schlucht hinunter", "in abgrund hinunter","in schlucht","in abgrund" }),str) != -1) 
  {
    write(BS ( "Du schaust in den Abgrund hinab und siehst nur tiefste "
	       "Schwaerze. Vielleicht koennte man ja etwas brennendes "
	       "hinunter werfen und dann was sehen."));
    say( TPN+" schaut sich die Schlucht ein wenig genauer an.\n");
    return 1;
  }

}
int winken(string str)
{
   notify_fail("Wem moechtest Du zuwinken?\n");
   if ( member( ({ "abenteurer zu", "abenteurern zu","zwerge zu","zwergen zu" }),str) != -1) 
  {
    write(BS ( "Du winkst den Abenteurern und Zwergen auf der anderen Seite "
	       "der Schlucht zu. Die Abenteurer winken lieb zurueck und die "
	       "Zwerge schuetteln nur die Koepfe und gehen weiter ihren "
	       "Taetigkeiten nach."));
    say( TPN+" winkt ueber die Schlucht.\n");
    return 1;
  }

}

int werfen(string str)
{
 object babydrache;
 notify_fail("Was willst Du wo hin werfen?\n");

 if(!str || str == "") return 0;
 if(!(str == "fackel in abgrund" ||
      str == "fackel in schlucht" ||
      str == "brennende fackel in den abgrund" ||
      str == "brennende fackel in die schlucht" ||
      str == "fackel in den abgrund" ||
      str == "fackel in die schlucht" )) return 0;
 

 if( str == "fackel in abgrund" ||
      str == "fackel in schlucht" ||
      str == "brennende fackel in den abgrund" ||
      str == "brennende fackel in die schlucht" ||
      str == "fackel in den abgrund" ||
      str == "fackel in die schlucht")
 {
    
   if(!present("fackel", TP))
   {
     write(BS("Du hast ja gar keine Fackel, die Du in die Schlucht werfen "
	   "kannst ?\n"));
 
     say(TPN+" denkt nach.\n");
     return -1;
    }
    if(anzahl < 1)
    {
       write(BS("Eine Fackel wurde bereits runter geworfen und es reicht. Wenn man "
	   "es oefter macht, verliert man schnell den Spass daran.\n"));
 
       say(TPN+" hat keine Lust.\n");
       return 1;
    }
    else
    {
        write(BS("Du nimmst eine Fackel, zuendest sie an und wirfst sie in die "
	   "Schlucht. Die Fackel faellt und faellt und wird ploetzlich von "
	   "einem Schatten aufgefangen und erlischt.\n"
	   "Der Schatten steigt hoeher und hoeher und hat Dich fast "
	   "erreicht.\n"));
 
        say(TPN+" wirft eine Fackel in die Schlucht.\n");
        if (present("fackel",TP))
        present("fackel",TP)->remove();
        babydrache=clone_object ("/d/unterwelt/stahldorn/dammnis/npc/babydrache" );
        babydrache->move(TO,M_GO|M_NOCHECK,"landet vor Dir auf dem Boden");
        anzahl--;
        return 1;
    }
  }
}


