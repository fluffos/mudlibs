// von Chivas

inherit "/d/gebirge/angrox/room/std_bergwerk_new";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int kistezahl;
int werkzeugzahl;
int eisenzahl;

void create()
	
{
  ::create();

  kistezahl=1;
  werkzeugzahl=1;
  eisenzahl=3;

  SetProp( P_INT_SHORT, "In einem Stollen");
  SetProp( P_INT_LONG,
	"Die Zwerge sind erst dabei hier im Stollen die Metalle abzubauen. Du "
	"stehst am Ende des Stollen und der Weg fuehrt nur zurueck. In einer "
	"Ecke liegen sogar ein paar Werkzeuge herum, mit denen man hier "
	"normalerweise gut Eisen abbauen kann." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"zwerge"}), 
            "Wie es aussieht haben die Zwerge mehrere Stollen angefangen, sind "
	    "hier aber noch nicht weit vorgedrungen.");

  AddDetail( ({"stollen","anfang"}),
	    "Der Stollen ist erst am Anfang. Die Arbeiten sind noch nicht "
	    "sehr weit.");
  
  AddDetail( ({"metalle"}), 
            "Die Metalle, die hier abgebaut werden, sind hauptsaechlich Eisen "
	    "und ein wenig Gold und Silber.");

  AddDetail( ({"ende"}),
	    "Der Stollen ist hier zu Ende.");
  
  AddDetail( ({"weg"}), 
            "Der Weg fuehrt hier fuer Dich nur zurueck.");

  AddDetail( ({"ecke","abbau"}),
	    "In einer Ecke liegen einige Werkzeuge, die die Zwerge zum Abbau "
	    "benutzen.");
  
  AddSpecialDetail( ({ "kiste" }), "kiste" );

  AddSpecialDetail( ({ "werkzeuge","werkzeug" }), "werkzeuge" );

  AddSpecialDetail( ({ "meissel","hammer" }), "meissel" );

  AddSpecialDetail( ({ "inschrift" }), "inschrift" );

  AddSpecialDetail( ({ "stangen" }), "stangen" );
  
  AddDetail( ({"boden"}),
	    "Am Boden liegen einige Steine und Felsbrocken herum.");
  
  AddDetail( ({"waende","waenden","wand","fackeln"}), 
            "An den Waenden haengen einige Fackeln und ein paar Eisenadern "
	    "sind zu sehen.");

  AddDetail( ({"decke"}),
	    "Die Decke ist auch von Eisenadern durchzogen.");
  
  AddDetail( ({"arbeiten"}), 
            "Die Arbeiten sind hier noch nicht weit voran gekommen.");

  AddDetail( ({"eisen"}),
	    "Es wird hier hauptsaechlich Eisen abgebaut. Hier gibt es viele "
	    "Eisenadern.");
  
  AddDetail( ({"gold"}), 
            "Es gibt hier kaum Gold in den Stollen.");

  AddDetail( ({"silber"}),
	    "Es gibt hier nur wenig Silber.");
  
  AddDetail( ({"steine"}), 
            "Die Steine am Boden sind nicht sehr interessant.");

  AddDetail( ({"felsbrocken"}),
	    "Die grossen Felsbrocken sehen so aus, als ob sie aus der Wand "
	    "gesprengt wurden. Wie kann sowas geschehen.");
  
  AddDetail( ({"eisenadern"}), 
            "Die Eisenadern sind sehr gross. Hier kann man sicher mit dem "
	    "richtigen Werkzeug sehr gut Eisen abbauen.");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht stickig.");  

  AddSound(DEFAULT_SOUND, "Man hoert ein Haemmern.");

  AddSound( ({"haemmern"}),
	   "Das Haemmern kommt aus den anderen Stollen.");
  
//-----Details Ende-----
AddItem(NPC "zwerga", REFRESH_DESTRUCT);
  
AddExit("nordwesten", ROOM "zwfest8");

AddCmd( ({"oeffne" }), "oeffnen" );
AddCmd( ({"nimm","nehme" }), "nehmen" );
//AddCmd( ({"bau","baue" }), "bauen" );

}
void reset()
{
  ::reset();
  kistezahl=1; 
  werkzeugzahl=1; 
  //eisenzahl=3+random(2); 
}
int oeffnen(string str)
{
   notify_fail("Was willst Du oeffnen?\n"); 
   if ( member( ({ "kiste" }),str) != -1) 
  {
    write(BS ( "Du oeffnest die Kiste und findest ein paar komische Stangen."));
    say( TPN+" oeffnet eine Kiste.\n");
    kistezahl--;
    return 1;
  }
}
string kiste(string key)
{
    if ( kistezahl )
    {
    return(BS("Die Kiste ist verschlossen. Du kannst sie oeffnen.\n"));
    }
    else
    {
    return(BS("Die Kiste ist offen und Du siehst ein paar komische Stangen."));
    }
}

string werkzeuge(string key)
{
    if ( werkzeugzahl )
    {
    return(BS("Du erkennst eine Spitzhacke und zusaetzlich "
	      "siehst Du noch eine Kiste."));
    }
    else
    {
    return(BS("Du siehst leider nur noch eine Kiste, die Spitzhacke hat wohl "
	      "wer genommen."));
    }
}
string spitzhacke(string key)
{
    if ( werkzeugzahl )
    {
    return(BS("Du kannst die Spitzhacke nehmen und vielleicht "
	      "damit Eisen abbauen."));
    }
    else
    {
    return(BS("Du siehst keine Spitzhacke hier herumliegen."));
    }
}
string stangen(string key)
{
    if ( kistezahl )
    {
    return(BS("Du siehst keine Stangen. Vielleicht sind sie in der "
	      "verschlossenen Kiste.\n"));
    }
    else
    {
    return(BS("Die Stangen sehen laenglich aus und sie haben eine Inschrift."));
    }
}
string inschrift(string key)
{
    if ( kistezahl )
    {
    return(BS("Du siehst keine Inschrift.\n"));
    }
    else
    {
    return(BS("Auf den Stangen steht folgendes geschrieben: Vorsicht, "
	      "explosive Magie in den Stangen. Finger weg!!!!\n"
	      "Du nimmst die Warnung ernst und laesst sie lieber liegen."));
    }
}
int nehmen(string str)
{
  object spitzhacke;
  notify_fail( "Was moechtest Du nehmen?\n" );
  if ( member( ({ "spitzhacke"}), str ) != -1 ) 

   {
     if( werkzeugzahl < 1 )
     {
        write("Du kannst keine Spitzhacke nehmen.\n");
        say(sprintf("%s stellt sich dumm an.\n", TP->Name(WER)));
        return -1;
     }
      if ( present("spitzhacke",TP) )
      {
      write(BS("Da Du bereits eine Spitzhacke hast, brauchst Du "
	       "keine mehr.\n" ));
      say(sprintf("%s ist gierig.\n", TP->Name(WER)));
      return -1;
      }
      else
      {
        {
	spitzhacke = clone_object("/p/weapon/axe/spitzhacke");
	if ( ME_TOO_HEAVY == spitzhacke->move(TP,M_GET|M_SILENT) ) 
          {
          write(
          "Du bist ein Weichei, Du kannst ja noch nicht mal mehr etwas "
	  "tragen.\n" );
          say(BS(sprintf("%s ist zu schwach eine Spitzhacke an sich zu "
			 "nehmen.\n", TP->Name(WER))));
          spitzhacke -> remove();
	  return 1;
          }
          else
          {
          write("Du nimmst die Spitzhacke an Dich.\n");
          say(sprintf("%s nimmt eine Spitzhacke an sich.\n",
          TP->Name(WER)));
          werkzeugzahl--;
          return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}
