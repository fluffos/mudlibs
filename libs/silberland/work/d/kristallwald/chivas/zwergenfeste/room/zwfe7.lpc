// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Zwergenfeste von Ardhmir");
  SetProp( P_INT_LONG,
	"Du stehst im Eingang zur Zwergenfeste von Ardhmir. Ein breiter, von "
        "leuchtenen Steinen erhellter Tunnel fuehrt im Osten tiefer in die "
        "Hochebene hinein. Nach Westen kann man die Zwergenfeste verlassen "
        "und man gelangt auf eine grosse Lichtung." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"eingang"}), 
            "Von hier aus fuehrt ein breiter Tunnel tief in die Zwergenfeste "
            "von Ardhmir.");

  AddDetail( ({"zwergenfeste","feste"}),
	    "Um mehr ueber die Zwergenfeste zu erfahren, musst Du schon weiter "
            "voran gehen.");

  AddDetail( ({"ardhmir","name"}),
	    "Dies ist der Name der Zwergenfeste und heisst frei aus dem "
            "Elfischen uebersetzt: Reich der Schaetze.");

  AddDetail( ({"steine","steinen","barinsteine","barinsteinen"}),
	    "Die leuchtenden Steine sind so genannte Barinsteine. Man findet "
            "sie nicht sehr haeufig und sie sind sehr kostbar, da sie von "
            "sich aus leuchten. Es ist ein Zeichen fuer den Reichtum der "
            "Zwergenfeste.");
  
  AddDetail( ({"tunnel","osten"}),
	    "Der Tunnel fuehrt nach Osten in die Zwergenfeste.");

  AddDetail( ({"hochebene","gorthad"}), 
            "Die Zwergenfeste befindet sich unterhalb der Hochebene von "
            "Gorthad.");

  AddDetail( ({"westen","lichtung"}),
	    "Im Westen ist eine grosse sonnenueberflutete Lichtung. Wenn Du "
            "mehr von ihr sehen willst, dann musst Du schon nach Westen "
            "gehen.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit grossen Steinplatten ausgelegt.");

  AddDetail( ({"decke","himmel"}),
	    "Die Decke ist glatt wie der Boden, aber nicht so interessant.");
  
  AddDetail( ({"waende","waenden","wand"}),
	    "An den Waenden haengen grosse leuchtende Barinsteine, die den "
            "Tunnel, der in die Feste fuehrt erhellt.");

  AddDetail( ({"schaetze"}), 
            "Ob es hier Schaetze gibt, musst Du wohl selbst heraus finden.");

  AddDetail( ({"reich","zwergenreich"}),
	    "Die Zwergenfeste von Ardhmir ist ein maechtiges Zwergenreich.");

  AddDetail( ({"elfischen","elfisch","elfen","sprache"}),
	    "Dies ist die Sprache der Elfen.");

  AddDetail( ({"sonne"}),
	    "Die Sonne siehst Du hier drin natuerlich nicht.");
  
  AddDetail( ({"zeichen","reichtum"}),
	    "Es gibt viele Zeichen fuer den Reichtum von Ardhmir. Neben den "
            "seltenen und wertvollen Barinsteinen an den Waenden ist ein "
            "weiteres Zeichen die Verzierung an den Waenden.");

  AddDetail( ({"verzierung"}), 
            "Die Verzierung stellt einige Zwerge dar, die ihrer taeglichen "
            "Arbeit nachgehen. Die Verzierungen sind in die Waende "
            "eingearbeitet und wurden mit Gold ausgegossen.");

  AddDetail( ({"arbeit","stein","steinmetze","statuen","sachen"}),
	    "Die hier abgebildeten Zwerge sind Steinmetze, die Statuen und "
            "andere Sachen aus Stein herstellen. ");

  AddDetail( ({"zwerge"}),
	    "Natuerlich leben Zwerge in der Feste von Ardhmir.");

  AddDetail( ({"belueftungssystem"}),
	    "Du kannst das Belueftungssystem nicht sehen. Es ist sicher gut "
            "versteckt.");
  
  AddDetail( ({"blaetter","baeume","aesten","aeste"}),
	    "Um so etwas zu sehen, musst Du schon wieder raus auf die Lichtung "
            "gehen.");

  AddDetail( ({"steinplatten","platten"}), 
            "Die grossen Steinplatten sind sauber aneinander gelegt und sind "
            "makellos. Sie sind ganz glatt abgeschliffen.");

  AddDetail( ({"gold","metall"}),
	    "Gold ist ein wertvolles Metall.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht ueberhaupt nicht stickig in diesem "
                          "Tunnel. Anscheinend haben die Zwerge ein gutes "
                          "Belueftungssystem.");  
 
  AddSmell( ({"tunnel"}),
	   "Es riecht nach gar nichts.");

  AddSound(DEFAULT_SOUND, "Du hoerst noch die Blaetter der Baeume ausserhalb "
                          "des Tunnels an den Aesten rauschen.");

  AddSound( ({"blaetter","baeume","aeste"}),
	   "*rausch*");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "zwfe6");
AddExit("ostunten", ROOM "zwfe8");

}
