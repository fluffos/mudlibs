// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int spechtda;

void create()
	
{
  ::create();

  spechtda=1; 

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Am Rand des Weges stehen kleine Straeucher mit spitzen Dornen "
        "zwischen den grossen alten Baeumen des Waldes. Der Waldboden ist mit "
        "vielen Blaettern und Nadeln bedeckt, die von den Baeumen herunter "
        "gefallen sind." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"rand"}), 
            "Am Rand sind zwischen den maechtigen Staemmen der Baeume kleine "
            "Straeucher zu sehen.");

  AddDetail( ({"weges","weg","richtung"}),
	    "Der Weg fuehrt nach Nordwesten oder nach Sueden. Du hast die "
            "Wahl.");

  AddDetail( ({"straeucher","straeuchern"}),
	    "Die kleinen Straeucher haben leckere Beeren. Jedoch sind sie "
            "durch die spitzen Dornen nicht erreichbar.");

  AddDetail( ({"dornen"}),
	    "Die spitzen Dornen sehen giftig und gefaehrlich aus.");
  
  AddDetail( ({"baeume","baeumen"}),
	    "Die grossen Baeume bilden eine dichtes Spalier und die Richtung "
            "wird Dir aufgezwungen.");

  AddDetail( ({"wald","waldes"}), 
            "Du bist schon tief in den Wald vorgedrungen.");

  AddDetail( ({"waldboden","boden"}),
	    "Der Waldboden ist mit Blaettern und Nadeln bedeckt. Auch ein paar "
            "Steine sind zu sehen.");

  AddDetail( ({"blaettern","blaetter"}),
	    "Die Blaetter am Boden sind am verwelken, wobei die Blaetter an "
            "den Aesten in einem strahlenden Gruen haengen.");

  AddDetail( ({"nadeln"}),
	    "Die Nadeln stammen von einer Tanne, die zwischen den Laubbaeumen "
            "am Rand des Weges steht.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist durch das dichte Blaetterdach der Laubbaeume nicht "
            "zu sehen. Nur ab und zu trifft ein Lichtstrahl der Sonne den "
            "Boden.");

  AddDetail( ({"staemmen","staemme"}), 
            "Die maechtigen Staemme der Baeume bilden fast eine massive Wand, "
            "da sie sehr dicht stehen.");

  AddDetail( ({"wand"}),
	    "Natuerlich ist hier im Wald keine Wand. Das war nur bildlich "
            "gemeint.");

  AddDetail( ({"wahl","qual"}),
	    "Wer die Wahl hat, hat die Qual.");

  AddDetail( ({"beeren","vogelbeeren"}),
	    "Es sind sowieso nur giftige Vogelbeeren.");
  
  AddDetail( ({"spalier","platz"}),
	    "Die Baeume stehen sehr dicht. Der Platz zwischen ihnen wird "
            "von kleinen Straeuchern mit spitzen Dornen aufgefuellt.");

  AddDetail( ({"steine","kieselsteine"}), 
            "Kleine runde Kieselsteine liegen auf dem Weg. Sie nicht leider "
            "nicht wertvoll und Du laesst sie liegen.");

  AddDetail( ({"gruen"}),
	    "Die Farbe ist dem Wald angemessen.");

  AddDetail( ({"farbe","farben"}),
	    "Es gibt hier im Wald viele Farben. Es gibt Gruen, Braun, Rot, "
            "Grau, Gold und noch viele anderen. Die einzelnen Farben, wie "
            "das Gruen haben zusaetzlich noch verschiedene Stufen.");

  AddDetail( ({"laubbaeumen","laubbaeume"}),
	    "Es gibt viele Laubbaeume hier im Wald. Sie sind momentan nicht "
            "sehr interessant.");
  
  AddDetail( ({"tanne"}),
	    "Die Tanne sticht ein wenig zwischen den Laubbaeumen hervor. Sie "
            "ist schoen gewachsen und ihr Stamm ist sehr dick.");

  AddDetail( ({"blaetterdach","dach"}), 
            "Das Blaetterdach ist sehr dicht. Nur durch einen leichten "
            "Windzug bewegen sich die Blaetter ein wenig, so dass ab und zu "
            "ein Lichtstrahl der Sonne bis auf den Waldboden vordringt.");

  AddDetail( ({"lichtstrahl","strahl","gold"}),
	    "Nur ab und zu schafft es ein Lichtstrahl auf den Waldboden, der "
            "dann golden schimmert. Es ist sehr romantisch und friedlich "
            "hier.");

  AddDetail( ({"sonne"}),
	    "Die Sonne kannst Du durch das dichte Blaetterdach nicht sehen.");

  AddDetail( ({"stamm"}),
	    "Am Stamm einer Tanne faellt Dir Etwas auf.");
  
  AddDetail( ({"etwas"}),
	    "Es ist ein kleines Loch in der Rinde der Tanne.");

  AddDetail( ({"rinde","loch"}), 
            "Du koenntest ja mal in das Loch fassen, wenn Du Dich traust.");

  AddDetail( ({"braun"}),
	    "Die Aeste und Staemme der Baeume sind braun.");

  AddDetail( ({"rot"}),
	    "Die Beeren an den Straeuchern sind rot.");

  AddDetail( ({"grau"}),
	    "Die kleinen Kieselsteine am Boden sind grau.");
  
  AddDetail( ({"stufen","hellgruen","dunkelgruen"}),
	    "Die Stufen reichen von Hellgruen bis Dunkelgruen.");

  AddDetail( ({"windzug","wind"}),
	    "Den Windzug kannst Du hoechstens hoeren.");

  AddDetail( ({"aeste","aesten"}),
	    "An den Aesten haengen viele Blaetter oder auch Nadeln.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Wald.");  
 
  AddSmell( ({"wald"}),
	   "Es riecht ein wenig waldig hier.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind durch das Blaetterdach wehen.");

  AddSound( ({"wind","windzug"}),
	   "Er bringt die Blaetter zum Rascheln.");
  
  AddSound( ({"blaetter","rascheln"}),
	   "*raschel*");

//-----Details Ende-----
  
AddExit("sueden", ROOM "zwfe2");
AddExit("nordwesten", ROOM "zwfe4");

AddCmd( ({"fass","fasse" }), "fassen" );

}
void reset()
{
  ::reset();
  spechtda=1;
}
int fassen(string str)
{
   object specht;
   notify_fail("Wo moechtest Du rein fassen?\n");
   if ( member( ({ "in loch" }),str) != -1) 

  if (present("specht",TO) || !spechtda)

  {
  write(BS("Du fasst in das Loch, findest jedoch momentan nichts. Du bist "
           "enttaeuscht.\n"));
  return -1;
  }
  write(BS("Du fasst in das Loch und spuerst einen leichten Schmerz, da Dich "
           "der Bewohner in die Hand gehakt hat.\n"));
  TP->AddHp(-15);
  spechtda=0;
  specht=clone_object (NPC "specht" );
  specht->move(TO,M_GO|M_NOCHECK,"flattert herein.");
   return 1;
  }

