// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Wald ist hier viel dunkler als weiter im Sueden. Auch die "
        "Atmosphaere scheint sich ein wenig zu aendern. Im Sueden wirkt der "
        "Wald heller und freundlicher." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1);

//-----Details Anfang-----
  
  AddDetail( ({"wald","waldes"}), 
            "Der Wald wirkt hier eindeutig dunkler als im Sueden. Die Baeume "
            "stehen dichter zusammen und es dringt weniger Licht durch die "
            "Blaetter auf den Waldboden.");

  AddDetail( ({"sueden"}),
	    "Im Sueden wirkt alles freundlicher und heller.");

  AddDetail( ({"atmosphaere"}),
	    "Du kannst nicht genau sagen was es ist, aber irgendwie wirkt "
            "die Atmosphaere bedrueckender als im Sueden.");

  AddDetail( ({"boden","waldboden"}),
	    "Am Boden sind viele Blaetter zu sehen, die von den Baeumen "
            "abgefallen sind. Sie bedecken den ganzen Weg.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist durch die dichten Blaetter der Baeume nur zu "
            "erahnen.");

  AddDetail( ({"baeume","baeumen"}), 
            "Die Baeume stehen dicht zusammen. Ihre dicken Staemme bilden "
            "neben dem Weg fast eine Mauer.");

  AddDetail( ({"blaetter"}),
	    "An den Baeumen haengen viele Blaetter. Auch am Boden sind "
            "welche zu sehen.");

  AddDetail( ({"weg"}),
	    "Der Weg fuehrt entweder nach Norden oder nach Suedwesten.");

  AddDetail( ({"norden"}),
	    "Im Norden wirkt der Wald dunkler.");
  
  AddDetail( ({"suedwesten"}),
	    "Im Suedwesten kommt Dir der Wald eindeutig heller und "
            "freundlicher vor.");

  AddDetail( ({"staemme"}), 
            "Die dicken Staemme und die dichten Straeucher am Wegrand machen "
            "es unmoeglich den Weg zu verlassen.");

  AddDetail( ({"mauer"}),
	    "Das war nur bildlich gemeint.");

  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand siehst Du die grossen Baeume des Waldes und ein paar "
            "Straeucher.");

  AddDetail( ({"straeucher"}),
	    "Die Straeucher haben grosse spitze Dornen.");
  
  AddDetail( ({"dornen"}),
	    "Die Dornen sehen giftig aus. Du solltest Dich davon "
            "fern halten. Zwischen den Dornen scheint ein Glitzern zu sein.");

  AddDetail( ({"glitzern"}), 
            "Du kannst nicht genau erkennen, was das Glitzern ist. Vielleicht "
            "ist es ja auch Etwas wertvolles, vielleicht auch nur ein "
            "Tautropfen.");

  AddDetail( ({"etwas"}),
	    "Wenn das Etwas nur ein Tautropfen ist, ist es eine schmerzhafte "
            "Erfahrung, falls es jedoch Etwas wertvolles ist, dann hast Du "
            "Glueck. Greif nach dem Etwas und finde es heraus.");

  AddDetail( ({"tautropfen","tropfen"}),
	    "Es koennte nur ein Tautropfen sein. Du musst es schon selbst "
            "heraus finden. Aber sei gewarnt.");

  AddDetail( ({"glueck"}),
	    "Glueck ist sehr wichtig und gut wenn man es hat.");
  
  AddDetail( ({"erfahrung"}),
	    "Erfahrung kann man nie zu wenig haben.");

  AddDetail( ({"licht"}), 
            "Nur ein wenig Licht dringt durch die Blaetter der Baeume.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach absolut gar nichts.");  
 
  AddSound(DEFAULT_SOUND, "Es ist totenstill.");

//-----Details Ende-----
  
AddExit("norden", ROOM "zww12");
AddExit("suedwesten", ROOM "zww10");

AddCmd( ({"greifen", "greife","greif" }), "greifen" );

}
int greifen(string str)
{
   notify_fail("Nach was moechtest Du greifen?\n");
   if ( member( ({ "nach glitzern", "nach etwas" }),str) != -1) 
  {
    write(BS ( "Du greifst nach dem Glitzern und findest nur eine alte "
               "Glasscherbe, die nichts wert ist. Du wirfst sie wieder "
               "deprimiert weg. Schoen, dass Du Dich bei dem Versuch an den "
               "giftigen Dornen geschnitten hast."));
    say( TPN+" greift nach Etwas, wirft es wieder weg und flucht.\n");
    this_player()->AddPoison(1);
    return 1;
  }

}  

