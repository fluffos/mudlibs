// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  AddRoomMessage( ({ "Ein beladener Stollenwagen mit einem Zwerg rauscht "
		     "von Osten nach Westen an Dir vorbei und ueberfaehrt "
		     "Dich beinahe.\n"}),
                     45, "sound" );

  SetProp( P_INT_SHORT, "In einem Stollen");
  SetProp( P_INT_LONG,
	"Der Stollen ist sehr breit und erstreckt sich von Norden nach Sueden "
	"und von Osten nach Westen. Die Zwerge haben hier anscheinend schon "
	"alles abgebaut und arbeiten anscheinend in anderen Teilen des "
	"Stollens weiter um die Metalle hier unter der Hochebene "
	"abzubauen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"stollen","stollens","kreuzung"}), 
            "Der Stollen in dem Du stehst, bildet hier eine Kreuzung und "
	    "fuehrt von Norden nach Sueden und von Osten nach Westen.");

  AddDetail( ({"norden","sueden","osten","westen","himmelsrichtungen","richtungen"}),
	    "Du kannst normalerweise in alle vier Himmelsrichtungen gehen.");
  
  AddDetail( ({"zwerge","zwerg"}), 
            "Die Zwerge arbeiten hier in den Stollen.");

  AddDetail( ({"teilen"}),
	    "Die Stollen unter der Hochebene sind sehr weitlaeufig, so dass "
	    "man sich hier schnell verlaufen kann. Momentan arbeiten die "
	    "Zwerge nicht hier, sondern in anderen Teilen der Stollen.");
  
  AddDetail( ({"metalle","eisen"}), 
            "Es wird hauptsaechlich Eisen hier abgebaut.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Du befindest Dich weit unter der Hochebene von Gorthad.");
  
  AddDetail( ({"boden"}), 
            "Am Boden sind einige Steine zu sehen und Schienen, die in alle "
	    "Richtungen laufen.");

  AddDetail( ({"waende","wand","waenden"}),
	    "An den Waenden haengen Fackeln, die den Stollen erhellen.");
  
  AddDetail( ({"fackeln","licht"}), 
            "Die Fackeln spenden genuegend Licht im Stollen.");

  AddDetail( ({"schienen"}),
	    "Die Schienen sind hier durch eine Weiche miteinander verbunden.");
  
  AddDetail( ({"weiche"}), 
            "Ueber die Weiche kann man steuern, wohin die Stollenwagen fahren "
	    "sollen.");

  AddDetail( ({"steine"}),
	    "Einige Steine liegen auf dem Boden, jedoch nicht auf den "
	    "Schienen.");
  
  AddDetail( ({"decke"}), 
            "Die Decke sieht grob bearbeitet aus.");

  AddDetail( ({"stollenwagen"}),
	    "Ein Stollenwagen ist hier momentan nicht zu sehen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht stickig.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst das Flackern der Fackeln.");

  AddSound( ({"flackern","fackeln"}),
	   "*flacker*");
  
//-----Details Ende-----
AddItem(NPC "zwerga", REFRESH_DESTRUCT);
  
AddExit("sueden", ROOM "zwfest7");
AddExit("norden", ROOM "zwfest5");
AddSpecialExit( "osten", "go_osten" );
AddSpecialExit( "westen", "go_westen" );

}
int go_osten(string dir)
{

  if(!(present("garlog", TO)))
  {
    write( BS( "Du willst momentan nicht nach Osten gehen.") );
    return -1;
  }
}
int go_westen(string dir)
{

  if(!(present("garlog", TO)))
  {
    write( BS( "Du willst momentan nicht nach Westen gehen.") );
    return -1;
  }
}
