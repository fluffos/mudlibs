// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Wald wird an dieser Stelle durch einen Fluss unterbrochen. "
        "Eine Bruecke fuehrt ueber den Fluss auf die andere Seite, wo der Weg "
        "weiter zu gehen scheint. An der Bruecke sind zahlreiche Verzierungen "
        "zu erkennen. Sie ist ein Kunstwerk der Zwerge." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"wald"}), 
            "Du siehst den Wald vor lauter Baeumen nicht.");

  AddDetail( ({"stelle"}),
	    "Hier wird der Wald kurz durch einen Fluss unterbrochen.");

  AddDetail( ({"fluss"}),
	    "Der Fluss fliesst sehr schnell und ist sicher tief. Die einzige "
            "Moeglichkeit um auf die andere Seite zu kommen ist die "
            "Bruecke.");

  AddDetail( ({"bruecke","moeglichkeit","holz"}),
	    "Die Bruecke besteht aus Holz und ist reich verziert. Sie wurde "
            "sicher von den Zwergen gebaut, die hier in der Naehe wohnen.");
  
  AddDetail( ({"seite"}),
	    "Um auf die andere Seite zu kommen, musst Du schon die Bruecke "
            "benutzen.");

  AddDetail( ({"kunstwerk"}),
	    "Die Bruecke ist mit ihren Verzierungen ein Kunstwerk der Zwerge.");

  AddDetail( ({"zwerge","zwergen"}), 
            "Die Zwerge der nahen Zwergenfeste haben die Bruecke "
            "erbaut.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit Blaettern und Nadeln bedeckt.");

  AddDetail( ({"himmel"}),
	    "Der Himmel wirkt durch das Blaetterdach der Baeume herrlich "
            "blau.");

  AddDetail( ({"blaetterdach"}),
	    "Das Blaetterdach ist durch den Fluss unterbrochen. Man kann sehr "
            "gut den Himmel erkennen.");
  
  AddDetail( ({"baeume","baeumen"}),
	    "Viele grosse Baeume stehen am Rand des Weges.");

  AddDetail( ({"rand"}), 
            "Auch einige kleine Buesche stehen zwischen den Baeumen.");

  AddDetail( ({"buesche"}),
	    "Die Buesche verhindern das Verlassen des Weges.");

  AddDetail( ({"verlassen"}),
	    "Du willst den Weg auch nicht verlassen. Was solltest Du in einem "
            "finsteren Wald. Du wuerdest Dich doch nur verlaufen.");

  AddDetail( ({"weg","weges","waldweg"}),
	    "Der Waldweg fuehrt Dich direkt an die Bruecke.");
  
  AddDetail( ({"blaettern","blaetter","nadeln"}),
	    "Die Blaetter und Nadeln sind von den Baeumen herunter auf den "
            "Weg gefallen.");

  AddDetail( ({"zwergenfeste","feste","naehe"}), 
            "Die Zwergenfeste ist gleich in der Naehe.");

  AddDetail( ({"verzierungen"}),
	    "Die Verzierungen zeigen Zwerge bei ihrer taeglichen Arbeit.");

  AddDetail( ({"arbeit","reichtum","schaetze","stein","berge"}),
	    "Die Arbeit der meisten Zwerge ist Reichtum zu scheffeln und dem "
            "harten Stein der Berge ihre Schaetze zu entreissen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht wie in einem typischen Wald.");  
 
  AddSmell( ({"wald"}),
	   "Es riecht waldig.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel und den Fluss.");

  AddSound( ({"voegel"}),
	   "Die Voegel sitzen in den Baeumen und zwitschern vor sich hin.");

  AddSound( ({"fluss"}),
	   "Der Fluss plaetschert vor sich hin.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "zwfe5");
AddExit("norden", ROOM "zww1");

}
