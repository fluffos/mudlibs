// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Du stehst an einer Wegkreuzung. Es geht entweder nach Sueden, Norden "
        "oder nach Westen. Am Wegrand zwischen den grossen duester aussehenden "
        "Baeumen steht ein kleiner Wegweiser, der Dir bei der Suche nach dem "
        "richtigen Weg sicher helfen kann." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1);

//-----Details Anfang-----
  
  AddDetail( ({"wegkreuzung","kreuzung"}), 
            "Hier gabelt sich der Weg. Man kann nach Norden, Sueden und Westen "
            "gehen. Ein kleiner Wegweiser steht am Rand des Weges.");

  AddDetail( ({"sueden"}),
	    "Im Sueden siehst Du nur Wald.");

  AddDetail( ({"norden"}),
	    "Im Norden scheint der Wald noch duesterer zu werden.");

  AddDetail( ({"westen"}),
	    "Im Westen ist auch nur Wald zu sehen.");
  
  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand steht ein kleiner Wegweiser, der Dir helfen kann "
            "den richtigen Weg zu waehlen.");

  AddDetail( ({"baeume","baeumen"}), 
            "Die Baeume sehen duester aus. Weiter im Norden wirken sie sogar "
            "noch unheimlicher.");

  AddDetail( ({"wegweiser"}),
	    "                                             \n"
            "                 unbekanntes Gebiet          \n"
            "                         |                   \n"
            "                         |                   \n"
            "                         |                   \n"
            " Waldsee,       <--------|                   \n"
            " Zwergenfeste            |                   \n"
            "                         |                   \n"
            "                         |                   \n"
            "                  Hochebene von Gorthad      \n");

  AddDetail( ({"suche","platz","idlen"}),
	    "Es ist halt wichtig wohin Du willst. Es ist hier naemlich kein "
            "schoener Platz zum Idlen.");

  AddDetail( ({"weg","weges","stelle"}),
	    "Der Weg gabelt sich an dieser Stelle. Du hast die Qual der Wahl.");
  
  AddDetail( ({"qual","qualen"}),
	    "Wollen wir mal hoffen, dass dies die einzige Qual bleibt.");

  AddDetail( ({"wahl"}), 
            "Es ist doch schoen, wenn man waehlen kann.");

  AddDetail( ({"wald"}),
	    "Du stehst tief in einem dunklen Wald.");

  AddDetail( ({"boden"}),
	    "Am Boden sind viele Blaetter zu sehen, die von den Baeumen "
            "abgefallen sind.");

  AddDetail( ({"blaetter"}),
	    "Es sind viele Blaetter an den Baeumen und bilden ein dichtes "
            "Blaetterdach. Auch am Boden liegen viele Blaetter.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist durch die Blaetter der Baeume nicht zu sehen. "
            "Die Lichtverhaeltnisse sind recht duester.");

  AddDetail( ({"lichtverhaeltnisse","licht"}), 
            "Da das dichte Blaetterdach die Sonne nicht durchlaesst, kann man "
            "nur sehr schlecht sehen.");

  AddDetail( ({"sonne"}),
	    "Die Sonne steht irgendwo am Himmel. Du kannst sie nicht sehen.");

  AddDetail( ({"gebiet"}),
	    "Das Gebiet ist unerforscht.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Die Hochebene von Gorthad liegt im Sueden.");
  
  AddDetail( ({"waldsee"}),
	    "Anscheind gibt es im Westen einen Waldsee. Geh doch mal hin und "
            "schau ihn dir an.");

  AddDetail( ({"zwergenfeste","feste","ardhmir"}), 
            "Im Westen scheint die beruehmte Zwergenfeste von Ardhmir zu "
            "liegen.");

  AddDetail( ({"blaetterdach"}),
	    "Das Blaetterdach der Baeume ist sehr dicht und laesst kaum Licht "
            "durch.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Wald.");  
 
  AddSmell( ({"wald"}),
	   "Es riecht nach Laub.");

  AddSmell( ({"laub","geruch"}),
	   "Es ist ein typischer Geruch in einem Wald.");
  
  
  AddSound(DEFAULT_SOUND, "Es ist sehr still. Du bist ein wenig beunruhigt.");

//-----Details Ende-----
  
AddExit("norden", ROOM "zww14");
AddExit("sueden", HOCHEBENE+"/room/hochende3");
AddExit("westen", ROOM "zww12");

}
