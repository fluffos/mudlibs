// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Weg fuehrt weiter von Norden nach Sueden durch den Wald. Das "
        "dichte Blaetterdach laesst nur ab und zu einen Lichtstrahl auf den "
        "Waldboden fallen. Alles wirkt sehr idyllisch und friedlich. Die "
        "Voegel zwitschern und ein paar Waldtiere schauen Dich neugierig an." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"weg","weges"}), 
            "Der Weg fuehrt von Norden nach Sueden durch den Wald. Durch die "
            "Baeume im Osten kannst Du die steile Felswand der Hochebene "
            "erkennen.");

  AddDetail( ({"norden","sueden","moeglichkeit"}),
	    "Nach Norden und Sueden fuehrt der Weg. Es gibt durch das dichte "
            "Unterholz keine Moeglichkeit den Weg zu verlassen.");

  AddDetail( ({"wald"}),
	    "Der Wald um Dich herum ist dicht. Du kannst jedoch durch die "
            "ein paar Baeume im Osten die Felswand erkennen.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das dichte Blaetterdach laesst ab und zu einen Lichtstrahl "
            "durch.");
  
  AddDetail( ({"lichtstrahl","strahl","licht","ort","schein","strahls"}),
	    "Ab und zu trifft ein Lichtstrahl den Waldboden. Der goldene "
            "Schein des Strahls macht dies zu einem romantischen Ort.");

  AddDetail( ({"waldboden","boden"}), 
            "Der Waldboden ist erdig. Ein paar Blaetter und herunter gefallene "
            "Zweige sind zu sehen.");

  AddDetail( ({"voegel"}),
	    "Die Voegel sitzen irgendwo im Blaetterdach. Du kannst sie nicht "
            "sehen, nur hoeren.");

  AddDetail( ({"waldtiere","tiere"}),
	    "Ab und zu schauen ein paar Waldtiere aus dem Unterholz oder "
            "hinter einem Baum hervor und beobachten Dich neugierig. Sie "
            "verschwinden jedoch sofort, als Du sie bemerkst.");

  AddDetail( ({"himmel","sonne"}),
	    "Den Himmel und die Sonne kannst Du durch das dichte Blaetterdach "
            "nicht sehen.");
  
  AddDetail( ({"osten","felswand","wand"}),
	    "Die Felswand der Hochebene ist ein wenig zwischen den dichten "
            "Baeumen zu erkennen.");

  AddDetail( ({"baeume","baeumen","baum"}), 
            "Die Baeume stehen dicht am Weg. Zwischen ihnen wachsen viele "
            "kleine Buesche und bilden ein dichtes Unterholz. Zwischen den "
            "grossen Staemmen im Osten ist die steile Felswand der Hochebene "
            "zu sehen.");

  AddDetail( ({"unterholz"}),
	    "Das dichte Unterholz aus Bueschen macht es unmoeglich den Weg "
            "zu verlassen.");

  AddDetail( ({"blaetter","blaettern"}),
	    "Es gibt viele Blaetter im Wald. Einige sind auf den Waldboden "
            "gefallen. Die meisten haengen jedoch noch an den Aesten der "
            "Baeume.");

  AddDetail( ({"zweige"}),
	    "Die Zweige sind von den Baeumen herunter gefallen.");
  
  AddDetail( ({"aesten","aeste"}),
	    "Die Aeste sind gross und und bilden mit den Blaettern ein "
            "dichtes Dach.");

  AddDetail( ({"hochebene","gorthad"}), 
            "Du bist ganz in der Naehe der Hochebene von Gorthad.");

  AddDetail( ({"naehe"}),
	    "Du bist nicht weit weg.");

  AddDetail( ({"staemmen","staemme"}),
	    "Die dicken Staemme weisen darauf hin, dass die Baeume schon "
            "sehr alt sind.");

  AddDetail( ({"buesche","bueschen"}),
	    "Es sind sehr viele Buesche. Sie machen es unmoeglich den "
            "Weg zu verlassen. Zwischen zwei Bueschen siehst Du einen grossen "
            "Haufen.");

  AddDetail( ({"haufen"}), 
            "Der Haufen ist ein grosser Ameisenhaufen.");

  AddDetail( ({"ameisenhaufen","bau"}), 
            "Der Haufen besteht aus Tannennadeln und kleinen Holzstuecken. "
            "Ausserdem sind tausende Ameisen zu sehen, die weiter an dem "
            "Bau arbeiten.");

  AddDetail( ({"ameisen"}), 
            "Lauter kleine Ameisen gehen ihrer emsigen Arbeit nach.");

  AddDetail( ({"arbeit"}), 
            "Arbeit wuerde Dir auch ganz gut tun.");

  AddDetail( ({"tannennadeln","nadeln"}), 
            "Die Nadeln stammen von den Baeumen.");

  AddDetail( ({"holzstuecken","holzstuecke"}), 
            "Die Holzstuecke stammen sicher von den Baeumen.");
  
  AddDetail( ({"rand"}),
	    "Am Rand des Weges stehen grosse Baeume und Buesche.");

  AddDetail( ({"hase","hasen"}), 
            "Ein toter Hase liegt am Rand des Weges. Du hast ihn eigentlich "
            "mehr errochen als vorher gesehen, da er von den Bueschen am "
            "Rand des Weges fast komplett verdeckt ist. Der Hase scheint "
            "an Altersschwaeche gestorben zu sein, da Du keine "
            "offensichtlichen Wunden erkennen kannst. Der arme Hase.");

  AddDetail( ({"altersschwaeche"}),
	    "Bis Du daran stirbst, dauert es noch eine Weile.");

  AddDetail( ({"weile","ding"}),
	    "Gut Ding will Weile haben.");

  AddDetail( ({"wunden"}),
	    "Es sind keine Wunden am Hasen zu erkennen. Er scheint eines "
            "natuerlichen Todes gestorben zu sein.");
  
  AddDetail( ({"tod","todes"}),
	    "Der Tod ist keine Person, der Du gerne gegenueber trittst.");

  AddDetail( ({"person"}), 
            "Aber er kann auch sehr nett sein. Frag mal Lars.");

  AddDetail( ({"lars","assistent"}),
	    "Lars ist der Assistent von Tod.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Aas.");  
 
  AddSmell( ({"aas"}),
	   "Ein toter Hase liegt zwischen den Bueschen am Rand des Weges. Wie "
           "ekelig.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Gezwitscher von vielen Voegeln im "
                          "Blaetterdach.");

  AddSound( ({"voegeln","voegel","gezwitscher"}),
	   "*triller*tschip*triller*");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "zwfe1");
AddExit("norden", ROOM "zwfe3");

}
