// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Zwergenfeste von Ardhmir");
  SetProp( P_INT_LONG,
	"Du stehst in einer der grossen Hallen von Ardhmir. Die Decke ist weit "
        "ueber Dir und die Waende sind mit reichen Verzierungen geschmueckt. "
        "Grosse leuchtende Steine an den Waenden erhellen die ganze Halle. Der "
        "Boden ist eben und sieht fast wie glatt geschliefener Marmor aus. Es "
        "sieht ueberhaupt nicht aus wie in einer Hoehle." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"hallen"}), 
            "Die Zwergenfeste von Ardhmir hat viele grosse Hallen, die die "
	    "Besucher immer wieder beeindrucken.");

  AddDetail( ({"halle"}),
	    "Du befindest Dich momentan in einer der ersten Hallen von Ardhmir "            "und es sieht gar nicht aus wie in einer normalen Hoehle.");

  AddDetail( ({"ardhmir","zwergenfeste","feste"}),
	    "Dies ist die Zwergenfeste von Ardhmir. Eines der Zwergenreiche im "
	    "Silberland.");

  AddDetail( ({"decke"}),
	    "Die Decke ist weit ueber Dir und wird von grossen Saeulen in der "
	    "Halle getragen. Man kann sie trotz der Hoehe in der sie sich "
	    "befindet recht gut erkennen und man sieht sogar dort eine "
	    "grosse Zeichnung.");
  
  AddDetail( ({"waende","waenden","wand"}),
	    "An den Waenden haengen die bereits schon bekannten leuchtenden "
	    "Barinsteine, die die gesamte Halle gut erhellen. Ausserdem sind "
	    "die Waende der Halle reich verziert.");

  AddDetail( ({"verzierungen"}), 
            "Die Verzierungen zeigen ein paar Zwergenkrieger in kompletter "
	    "Ausruestung und vielen Waffen.");

  AddDetail( ({"steine","barinsteine"}),
	    "Die Barinsteine leuchten in einem warmen Gelb und erhellen die "
	    "Halle komplett. Sie haengen in goldenen Fassungen an den "
	    "Waenden.");

  AddDetail( ({"boden"}),
	    "Der Boden ist sauber und sehr glatt geschliffen, so dass man "
	    "sogar sein Spiegelbild im Boden sehen kann. Es sieht fast so "
	    "aus, als ob hier Marmorplatten verlegt wurden.");

  AddDetail( ({"marmorplatten","platten","marmor","steinplatten"}),
	    "Es sind jedoch nur normale Steinplatten, die den Boden bilden, "
	    "obwohl sie beinahe wie Marmor aussehen.");
  
  AddDetail( ({"hoehle","palast"}),
	    "Du kommst Dir gar nicht wie in einer Hoehle vor, eher wie in "
	    "einem Palast.");

  AddDetail( ({"besucher"}), 
            "Damit sind Abenteurer wie Du gemeint oder andere Einwohner des "
	    "Silberlandes.");

  AddDetail( ({"abenteurer"}),
	    "Du bist einer.");

  AddDetail( ({"einwohner"}),
	    "Das Silberland hat viele verschiedene Einwohner.");

  AddDetail( ({"silberland","silberlandes"}),
	    "Du befindest Dich momentan im Silberland.");
  
  AddDetail( ({"zwergenreiche","reiche"}),
	    "Neben der Zwergenfeste von Ardhmir gibt es noch die Hauptstadt "
	    "der Zwerge. Sie heisst Felonia.");

  AddDetail( ({"felonia","hauptstadt"}), 
            "Felonia liegt im Gebirge.");

  AddDetail( ({"gebirge"}),
	    "Das Gebirge ist weit weg von Ardhmir.");

  AddDetail( ({"saeulen"}),
	    "Die grossen Saeulen sind sehr breit und reichen hinauf zur Decke. "            "Sie haben ein beeindruckendes Muster.");

  AddDetail( ({"hoehe","entfernung"}),
	    "Die Decke ist sehr weit ueber Dir.");
  
  AddDetail( ({"zeichnung"}),
	    "Die Zeichnung sieht aus wie ein grosser gruener Drache. Er sieht "
	    "fast schon lebendig aus dieser Entfernung aus.");

  AddDetail( ({"zwerge"}), 
            "Viele Zwerge leben in der Zwergenfeste von Ardhmir.");

  AddDetail( ({"zwergenkrieger","krieger","arbeit"}),
	    "Die Krieger wurden in die Wand gemeisselt und die feinen Linien "
	    "der Verzierungen wurden mit Mithril ausgegossen. Es ist eine "
	    "fantastische Arbeit der Zwerge.\n"
	    "Die Zwergenkrieger scheinen auf der Jagd nach Etwas zu sein. Es "
	    "scheint ein starker Gegner zu sein, wenn man die ganze "
	    "Ausruestung und die Waffen betrachtet.");

  AddDetail( ({"ausruestung","helmen","helme","kettenhemden","kettenhemd"}),
	    "Die Ausruestung der Zwerge besteht aus schwer aussehenden "
	    "Kettenhemden und grossen Helmen. Mit dieser Ausruestung koennen "
	    "sie sich sicher einem grossen Gegner stellen.");

  AddDetail( ({"waffen","pfeile","speere","aexte"}),
	    "Die abgebildeten Waffen sind hauptsaechlich Aexte. Auch ein paar "
	    "Pfeile und Speere sind zu erkennen.");
  
  AddDetail( ({"fassungen","fassung"}),
	    "Die Fassungen, in denen die Barinsteine stecken, bestehen aus "
	    "purem Gold. Dies spiegelt nur mehr den Reichtum der Zwergenfeste "
	    "wieder.");

  AddDetail( ({"spiegelbild"}), 
            "Du betrachtest Dein Spiegelbild im Boden genauer und findest Du "
	    "bist schon sehr gut aussehend. Du laechelst Dein Spiegelbild an.");

  AddDetail( ({"muster","taeuschung"}),
	    "Das Muster sieht aus wie die Rinde von grossen Baeumen, wie sie "
	    "in Roch Adan stehen. Sie sehen beinahe echt aus. Die Steinmetze "
	    "der Zwerge haben eine grossartige Taeuschung erschaffen.");

  AddDetail( ({"steinmetze","steinmetzarbeiten"}),
	    "Die Zwerge haben die besten Steinmetze im Silberland.");

  AddDetail( ({"baeume"}),
	    "Die grossen Saeulen sehen fast aus wie Baeume. Natuerlich gibt "
	    "es hier in der Hoehle keine echten Baeume.");
  
  AddDetail( ({"drache","koerper"}),
	    "Der gruene Drache scheint auf der Flucht zu sein. Ein paar Speere "
	    "und Pfeile stecken bereits in seinem Koerper. Die ganze Szene "
	    "macht einen sehr realistischen Eindruck.");

  AddDetail( ({"linien","mithril"}),
	    "Glaenzendes Mithril verschoenert die Steinmetzarbeiten der "
	    "Zwerge.");

  AddDetail( ({"jagd","etwas","gegner"}),
	    "Da musst Du Dich schon ein wenig mehr umschauen, was die Zwerge "
	    "jagen.");

  AddDetail( ({"szene","eindruck","szenen"}),
	    "Die Zwerge wissen anscheinend wie man Szenen beeindruckend "
	    "darstellt.");
  
  AddDetail( ({"reichtum"}),
	    "Die Zwergenfeste von Ardhmir ist sehr reich.");

  AddDetail( ({"roch adan","roch","adan","zentauren"}),
	    "In Roch Adan leben die Zentauren.");

  AddDetail( ({"rinde"}),
	    "Die Saeulen sehen aus wie die Rinde von Baeumen. Natuerlich ist "
            "es keine echte Rinde.");

  AddDetail( ({"gold","anblick"}),
	    "Beim Anblick des Goldes wirst Du neidisch bei all dem Reichtum.");
  
  AddDetail( ({"gelb","licht"}),
	    "Das gelbe Licht erhellt die Halle.");

  AddDetail( ({"flucht"}),
	    "Anscheinend ist der Drache auf der Flucht vor den Kriegern auf "
            "den Waenden.");

  AddDetail( ({"ort"}),
	    "Ardhmir ist ein schoener Ort.");

  AddDetail( ({"geschaefte","geschaeften"}),
	    "Die Zwerge gehen hier in der Zwergenfeste ihren Geschaeften "
	    "nach.");
  
  AddDetail( ({"geheimnis","geheimnisse"}),
	    "Es gibt viele Geheimnisse in Ardhmir. Vielleicht findest Du "
	    "einige heraus.");
  
  AddDetail( ({"system"}),
	    "Das System, dass die Luft in der Zwergenfeste austauscht ist gut "
	    "versteckt und Du kannst es nicht finden. Es ist ein streng "
	    "gehuetetes Geheimnis der Zwerge.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht gar nicht wie in einer Hoehle.");  
 
  AddSmell( ({"hoehle"}),
	   "In einer Hoehle ist die Luft meistens alt und muffig. Hier ist "
	   "die Luft frisch.");

  AddSmell( ({"luft"}),
	   "Die Luft riecht gut und erfrischend. Anscheind wird die Luft durch "
	   "irgendein System, dass Du nicht sehen kannst, staendig "
	   "ausgetauscht.");
  
  
  AddSound(DEFAULT_SOUND, "Man kann lauter verschiedene Geraeusche in der "
		          "Halle hoeren.");

  AddSound( ({"halle","geraeusche"}),
	   "Die Geraeusche reichen vom entfernten Haemmern bis zum Gemurmel "
	   "von anderen Personen in der Halle.");
  
  AddSound( ({"haemmern"}),
	   "Das Haemmern kommt anscheinend von einem Ort, der tiefer in der "
	   "Zwergenfeste liegt. Geh einfach mal hin und schau Dich um.");

  AddSound( ({"gemurmel","personen"}),
	   "Ein paar andere Abenteurer und einige Zwerge befinden sich in der "
	   "Halle und gehen ihren Geschaeften nach oder unterhalten sich nur "
	   "leise.");
  
  AddSound( ({"abenteurer","zwerge","geschaeften","geschaefte"}),
	   "Man belauscht keine anderen. Schaem Dich.");

//-----Details Ende-----
AddItem(NPC "zwergk", REFRESH_DESTRUCT);

AddExit("westoben", ROOM "zwfe8");
AddExit("norden", ROOM "zwfe10");
AddExit("sueden", ROOM "zwfe13");

}
