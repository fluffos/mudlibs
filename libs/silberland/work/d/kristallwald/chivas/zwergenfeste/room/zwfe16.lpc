// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Zwergenfeste von Ardhmir");
  SetProp( P_INT_LONG,
	"Die zweite Halle von Ardhmir in der Du stehst ist riesengross und "
	"wird von einer breiten Schlucht, die von Sueden nach Norden "
	"verlaeuft, in zwei Haelften getrennt. Grosse Saeulen ragen weit nach "
	"oben und tragen die riesige Decke. Nach Suedosten fuehrt eine "
	"Bruecke ueber die Schlucht auf die andere Seite." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"halle"}), 
            "Du stehst in einer riesigen Halle, die von einer breiten "
	    "Schlucht in zwei Haelften geteilt ist.");

  AddDetail( ({"ardhmir","zwergenfeste","feste","reich","zwergenreich"}),
	    "Du bist schon tief in die Zwergenfeste von Ardhmir "
	    "vorgedrungen.");

  AddDetail( ({"schlucht","abgrund"}),
	    "Die breite Schlucht erstreckt sich durch die ganze Halle. Sie "
	    "ist anscheinend bodenlos und natuerlichen Ursprungs.");

  AddDetail( ({"sueden","norden"}),
	    "Die Halle und die Schlucht verlaufen von Sueden nach "
	    "Norden.");
  
  AddDetail( ({"haelften","haelfte"}),
	    "Du befindeste Dich in der westlichen Haelfte der Halle. Um auf "
	    "die andere Seite zu kommen, musst Du ueber eine der zwei "
	    "Bruecken gehen. Eine Bruecke ist im Suedosten und die andere "
	    "befindet sich weiter im Norden der Halle.");

  AddDetail( ({"saeulen","saeule"}), 
            "Die grossen Saeulen haben riesige Ausmasse. Sie sind mit "
	    "Barinsteinen in unterschiedlicher Hoehe versehen. Ansonsten ist "
	    "die Oberflaeche der Saeulen komplett glatt und poliert. Du "
	    "kannst sogar Dein Spiegelbild in der Saeule sehen.");

  AddDetail( ({"decke"}),
	    "Die grosse Decke woelbt sich ueber Dir auf die andere Seite der "
	    "Halle. Ansonsten ist an ihr nicht viel zu entdecken.");

  AddDetail( ({"suedosten","bruecke"}),
	    "Im Suedosten fuehrt eine Bruecke ueber den Abgrund, der die Halle "
	    "trennt. Am Anfang der Bruecke stehen zwei grosse Statuen und "
	    "scheinen den Uebergang auf die andere Seite zu bewachen.");

  AddDetail( ({"seite"}),
	    "Du bist auf der westlichen Seite der Schlucht.");
  
  AddDetail( ({"boden","palast","haus","gefuehl"}),
	    "Der Boden ist mit grossen Steinplatten ausgelegt, wodurch man "
	    "eher das Gefuehl hat in einem Palast oder Haus zu sein, aber "
	    "nicht in einer Hoehle.");

  AddDetail( ({"waende","waenden"}), 
            "An den Waenden der Halle sind verschiedene Reliefs zu erkennen, "
	    "die von den Steinmetzen in den Fels gehauen wurden. In der "
	    "Suedwand befindet sich die Oeffnung zu einer Kammer.");

  AddDetail( ({"suedwand","oeffnung","eingang"}),
	    "Die Oeffnung in der Suedwand fuehrt in eine Kammer. Ueber dem "
	    "Eingang zur Kammer haengt ein Schild.");

  AddDetail( ({"ursprung","ursprungs"}),
	    "So tief wie die Schlucht zu sein scheint, haben die Zwerge sie "
	    "sicher nicht gegraben. Sie ist aber ein idealer Schutz vor "
	    "Eindringlingen, die bis hier hin in das Zwergenreich vorgedrungen "
	    "sind.");

  AddDetail( ({"zwerge","zwergen"}),
	    "Viele hundert Zwerge wohnen in der Feste von Ardhmir. Einige "
	    "befinden sich mit Dir in der Halle und gehen ihren Taetigkeiten "
	    "nach.");
  
  AddDetail( ({"schutz","eindringlinge","eindringlingen"}),
	    "Die breite Schlucht kann man nur ueber die Bruecke im Suedosten "
	    "oder eine zweite Bruecke weiter im Norden der Halle ueberqueren.");

  AddDetail( ({"taetigkeiten"}), 
            "Einige Zwerge sind am arbeiten oder sie stehen in kleinen "
	    "Gruppen in der Halle und unterhalten sich.");

  AddDetail( ({"gruppen"}),
	    "Du siehst einige Gruppen zusammen stehen und sich unterhalten.");

  AddDetail( ({"barinsteine","barinsteinen","steine","hoehe"}),
	    "Die Barinsteine sind in unterschiedlicher Hoehe von den Zwergen "
	    "an den Saeulen angebracht worden umd die gesamte Halle gut "
	    "auszuleuchten.");

  AddDetail( ({"oberflaeche"}),
	    "Die glatte Oberflaeche der Saeulen wurde anscheinend sogar von "
	    "den Zwergen poliert, so dass man das Spiegelbild sehen kann.");
  
  AddDetail( ({"spiegelbild"}),
	    "Du siehst heute wieder besonders adrett aus.");

  AddDetail( ({"anfang","statuen","steinstatuen"}), 
            "Am Anfang der Bruecke stehen zwei grosse Statuen. Es sind zwei "
	    "grosse steinerne Drachen, die mit weit aufgerissenen Maul Dich "
	    "anzustarren scheinen.");

  AddDetail( ({"uebergang","durchlass"}),
	    "Anscheinend sichern die Statuen den Uebergang ueber die Bruecke.");

  AddDetail( ({"ausmasse"}),
	    "Die Ausmasse der Saeulen sind wirklich gewaltig.");

  AddDetail( ({"steinplatten"}),
	    "Auf ein paar der Steinplatten erkennst Du einige Zeichen.");
  
  AddDetail( ({"hoehle","eindruck"}),
	    "Es macht nicht den Eindruck, dass Du in einer Hoehle bist.");

  AddDetail( ({"kammer","probleme"}), 
            "Du kannst die Kammer im Sueden ohne Probleme betreten.");

  AddDetail( ({"reliefs"}),
	    "Die Reliefs zeigen verschiedene Szenen.");

  AddDetail( ({"fels","stein"}),
	    "Die Waende bestehen aus Fels, wie es in einer Hoehle ueblich "
	    "ist.");

  AddDetail( ({"steinmetzen","steinmetze","kunst"}),
	    "An den Reliefs sieht man die Kunst der Steinmetze von Ardhmir.");
  
  AddDetail( ({"Schild"}),
	    "Du kannst das Schild lesen.");

  AddDetail( ({"drachen"}),
	    "Die Drachen wurden sehr detailreich aus dem Fels geschlagen. "
	    "Man erkennt jede einzelne Schuppe der Drachen und die Klauen "
	    "sehen besonders gefaehrlich aus.");

  AddDetail( ({"zeichen"}),
	    "Du kannst die Zeichen auf den Steinplatten lesen.");
  
  AddDetail( ({"szenen"}),
	    "Es sind verschiedene Szenen aus dem Leben der Zwerge auf den "
	    "Waenden zu erkennen.");

  AddDetail( ({"maul"}), 
            "Das Maul der Drachen ist weit aufgerissen und die spitzen "
	    "Zaehne funkeln im Licht der Barinsteine.");

  AddDetail( ({"klauen","fuesse"}),
	    "Die Fuesse der Drachen sind sehr gross und die spitzen Klauen "
	    "wurden nachtraeglich aus Gold angebracht. Waeren es nicht die "
	    "Klauen von Drachen, koennte man sogar sagen es sieht wirklich "
	    "trendy aus.");

  AddDetail( ({"schuppe","schuppen"}),
	    "Jede einzelne der Schuppen ist gut zu erkennen. Ein magischer "
	    "Schimmer liegt auf ihnen.");

  AddDetail( ({"licht"}),
	    "Das Licht der Barinsteine huellt die Halle in ein warmes "
	    "gelbliches Licht.");
  
  AddDetail( ({"zaehne"}),
	    "Die besonders spitzen Zaehne scheinen nicht aus Stein zu sein, "
	    "sondern sie wurden zusaetzlich aus Silber gefertigt.");

  AddDetail( ({"silber"}), 
            "Das Silber der Zaehne verleiht den Drachen ein besonders "
	    "gefaehrliches Aussehen.");

  AddDetail( ({"aussehen"}),
	    "Das Aussehen ist immer wichtig. Egal ob es sich um Deines "
	    "handelt oder das der Statuen.");

  AddDetail( ({"schimmer","magie"}),
	    "Die Magie, die Du auf den Schuppen siehst, sagt Dir, dass der "
	    "Uebergang ueber die Bruecke nicht einfach so funktioniert.");

  AddDetail( ({"leben"}),
	    "Es geht in den Reliefs um die Arbeit der Steinmetze und Schmiede. "
	    "Auch ein paar Zwerginnen sind zu sehen.");
  
  AddDetail( ({"schmiede","metall"}),
	    "Die Schmiede von Ardhmir bearbeiten Metall und stellen alles "
	    "moegliche her.");

  AddDetail( ({"arbeit"}),
	    "Die Arbeit ist der Lebensinhalt der Zwerge.");

  AddDetail( ({"lebensinhalt"}),
	    "Du hast hoffentlich einen anderen Lebensinhalt und nicht nur "
	    "Arbeit im Kopf.");
  
  AddDetail( ({"kopf"}),
	    "Es waere eigentlich schon wuenschenswert, wenn ueberhaupt etwas "
	    "in Deinem Kopf waere.");

  AddDetail( ({"zwerginnen","zwergin"}), 
            "Selbst die Zwerginnen auf den Reliefs haben Baerte. Es wirkt "
	    "irgendwie komisch auf Dich.");

  AddDetail( ({"baerte","geschlechter"}),
	    "Bei den Zwergen haben beide Geschlechter Baerte. Die der "
	    "weiblichen Zwerge werden nur nicht so lang.");

  AddDetail( ({"gold"}), 
            "Gold ist sehr wertvoll. Du haettest gerne mehr davon.");

  AddDetail( ({"wand"}),
	    "Es gibt nur normale Waende hier. Nur in der Suedwand ist eine "
	    "besondere Oeffnung.");

  AddDetail( ({"demut"}),
	    "Ein wenig Demut wuerde Dir ganz gut tun.");

  AddDetail( ({"rauch"}),
	    "Es ist aber nicht viel Rauch zu sehen.");
  
  AddDetail( ({"nuestern"}),
	    "Aus den Nuestern der Steinstatuen kraeuselt sich ein wenig "
	    "Rauch hervor.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig nach Rauch.");  
 
  AddSmell( ({"rauch"}),
	   "Der Geruch nach Rauch kommt von den Steinstatuen.");

  AddSmell( ({"geruch","steinstatuen"}),
	   "Ein wenig Rauch kommt aus den Nuestern der Steinstatuen. "
	   "Anscheinend bestehen sie nicht nur aus Stein.");
  
  
  AddSound(DEFAULT_SOUND, "Du hoerst verschiedene Geraeusche in der grossen "
		          "Halle.");

  AddSound( ({"geraeusche"}),
	   "Du hoerst die Zwerge wie sie ihren Beschaeftigungen nachgehen "
	   "und ein paar Gespraeche.");
  
  AddSound( ({"zwerge","beschaeftigungen"}),
	   "Ein paar Zwerge haemmern in der Halle und arbeiten.");

  AddSound( ({"gespraeche","gespraechen"}),
	   "Du solltest Dich schaemen, man belauscht keine Gespraeche anderer. "
	   "Neben den Gespraechen hoerst Du auch noch ein leises Wispern.");
  
  AddSound( ({"wispern"}),
	   "Das leise Wispern kommt von den grossen Steinstatuen vor der "
	   "Bruecke.");

  AddSound( ({"steinstatuen"}),
	   "Lausche den Drachen.");

  AddSound( ({"drachen","stimme"}),
	   "Du lauscht den Drachen und hoerst eine Stimme in Deinem Kopf: "
	   "Senke Deinen Kopf in Demut und wir gewaehren Dir Durchlass auf die "
	   "andere Seite der Halle");

  AddReadDetail( ({"schild"}),
		"+----------------------------------------+\n"
		"|                                        |\n"
		"|       Stollenwagen nach Felonia        |\n"
		"|                                        |\n"
		"+----------------------------------------+\n");

  AddReadDetail( ({"zeichen"}),
		"Leider sind die Zeichen in einer Dir unbekannten alten "
		"Zwergensprache. Du bist enttaeuscht.");

//-----Details Ende-----

AddItem(NPC "silbergnom", REFRESH_DESTRUCT);

AddExit("sueden", ROOM "zwfet");
AddExit("norden", ROOM "zwfe17");
AddExit("westen", ROOM "zwfe13");
AddSpecialExit( "suedosten", "go_sw" );

AddCmd( ({"senk", "senke" }), "senken" );

}
int go_sw(string dir)
{

  if(!(present("zwinvis1", TP)))
  {
    write( BS( "Die Drachen bewegen sich ploetzlich und schleudern "
               "Dich zurueck. Um Dir die Sinnlosigkeit Deiner Tat einzubrennen "
	       "trifft Dich auch noch ein kleiner Feuerball, den die "
	       "Steinstatuen auf Dich schiessen. Eine Stimme "
	       "in Deinem Kopf fluestert Dir zu: Wir lassen Dich nicht so "
	       "einfach durch! Weiche oder stirb!") );
    say("Die Drachen aus Stein halten "+TP->Name(WEN)+" davon ab, "
      "die Bruecke zu ueberqueren.\n");
    TP->AddHp(-50);
    return -1;
  }
  write(BS("Du gehst ohne von den Drachen behindert zu werden weiter "
	   "nach Suedosten.\n"));
 
  say(TPN+" verschwindet nach Suedosten.\n");
  this_player()->move(ROOM "zwfe23", M_TPORT);
  return 1;
}
int senken(string str)
{
 object zwinvis1;

 notify_fail("Was willst Du wie senken? \n");

 if(!str || str == "") return 0;
 if(!(str == "kopf in demut" ||
      str == "haupt in demut" ||
      str == "kopf in demut vor drachen" ||
      str == "haupt in demut vor statuen" )) return 0;
 
 if( str == "kopf in demut" ||
      str == "haupt in demut" ||
      str == "kopf in demut vor drachen" ||
      str == "haupt in demut vor statuen"){
    
  if(present("zwinvis1", TP)){
	  
  write(BS("Du musst Dein Haupt nicht mehr senken. Du wurdest bereits als "
	   "wuerdig befunden und die Statuen werden Deinen Weg nicht "
	   "behindern.\n"));
  return -1;
  }
  write(BS("Du senkst Dein Haupt voller Demut vor den grossen Steinstatuen der "
	   "Drachen und ein Lichtstrahl trifft Dich kurz. Anscheinend "
	   "wurdest Du soeben als wuerdig empfunden und kannst nun ohne "
	   "Probleme die Bruecke ueberqueren.\n"));
 
  say(TPN+" wird von einem Lichtstrahl getroffen und scheint wuerdig zu sein "
	  "tiefer in das Reich der Zwerge vorzudringen.\n");
  zwinvis1=clone_object(OBJ "zwinvis1")->move(TP, M_NOCHECK);
  return 1;
  }
}
