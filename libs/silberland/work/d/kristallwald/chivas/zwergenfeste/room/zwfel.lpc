inherit "std/laden";

#include "../def.h"
#include <laden.h>

void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));

  SetProp(P_INT_SHORT,"Im Laden von Ardhmir");
  SetProp(P_SHOPKEEPER_ID, "thrax");
  SetProp(P_SHOPKEEPER_NAME, "thrax");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);

  SetStorageRoom(ROOM "zwfelager" );

//-----Anfang Details-----------------

  AddDetail( ({"gluehwuermchen","licht"}),
	    "Die Gluehwuermchen in den Lampen leuchten und spenden genug Licht "
	    "im Laden, so dass Du gut sehen kannst.");  
  
  AddDetail( ({"lampen"}),
	    "In den Lampen stecken kleine Gluehwuermchen, die den Laden "
	    "erhellen.");  
  
  AddDetail( ({"thrax"}),
	    "Thrax ist der Besitzer des Ladens.");  
  
  AddDetail( ({"zeige"}),
	    "Mit Zeige kannst Du Dir die Waren anschauen, die Du hier kaufen "
	    "kannst.");  
  
  AddDetail( ({"decke"}),
	    "An der Decke haengen ein paar Lampen.");  
  
  AddDetail( ({"boden","fels"}),
	    "Am Boden kannst Du den blanken Fels erkennen.");  
  
  AddDetail( ({"alltag"}),
	    "Wie der Alltag der Zwerge hier in Ardhmir aussieht, weisst Du "
	    "nicht.");  
  
  AddDetail( ({"besitzer"}),
	    "Der Besitzer des Ladens heisst Thrax.");  
  
  AddDetail( ({"zwerge"}),
	    "Viele Zwerge leben in Ardhmir und kaufen hier ihre Sachen, die "
	    "sie fuer den Alltag brauchen.");  
  
  AddDetail( ({"theke","mitte","haelften"}),
	    "Eine lange Theke teilt den Laden in zwei Haelften. Durch die "
	    "Theke kommst Du selbst nicht an die Regale, sondern Du musst "
	    "Dich an den Besitzer des Ladens halten, der Dir die Waren "
	    "gibt, die Du kaufen willst. In der Mitte der Theke haengt eine "
	    "Tafel.");  
  
  AddDetail( ({"verkauf"}),
	    "Du kannst hier fast alles kaufen.");  
  
  AddDetail( ({"waren","sachen","produkten","produkte"}),
	    "Die verschiedensten Waren stehen auf den Regalen zum Verkauf.");  
  
  AddDetail( ({"regale","regalen","bersten"}),
	    "Die Regale sind zum Bersten voll.");  
  
  AddDetail( ({"felswaende","waende","waenden","wand"}),
	    "An den Waenden stehen lauter Regale, wo die ganzen Waren drauf "
	    "stehen, die Du hier kaufen kannst.");  
  
  AddDetail( ({"ardhmir","zwergenfeste"}),
	    "Du bist in der Zwergenfeste von Ardhmir, wo viele hundert Zwerge "
	    "leben und arbeiten.");  
  
  AddDetail( ({"zwergenladen","laden","ladens"}),
	    "Du stehst im Laden von Ardhmir, wo Du kaufen und verkaufen "
	    "kannst.");  
  
  AddDetail( ({"tafel","sortiment"}),
	    "Auf der Tafel steht das Sortiment, dass Du hier erwerben kannst. "
	    "Tipp 'Zeige' und Du kannst sehen was Du kaufen kannst.");  

  AddSmell(DEFAULT_SMELL, "Es riecht nach Leder und anderen Sachen.");  
 
  AddSmell( ({"leder","geruch"}),
	   "Der Geruch vom Leder kommt von den verschiedensten Produkten, die "
	   "aus Leder bestehen und die Du hier kaufen kannst.");

  AddSmell( ({"sachen"}),
	   "Es riecht nach den unterschiedlichsten Sachen hier im Laden.");

  AddSound(DEFAULT_SOUND, "Du hoerst wie hinten im Lager gearbeitet wird.");

  AddSound( ({"lager"}),
	   "Du hoerst es hinten im Lager ein Poltern.");

  AddSound( ({"poltern"}),
	   "Anscheinend ist hinten im Lager etwas umgefallen.");  
//-----Details Ende-----


  AddExit("osten", ROOM "zwfe14");

  AddItem(NPC "thrax", REFRESH_DESTRUCT);
}

string _query_int_long()
{
  string txt;

  txt = "Dies ist der Zwergenladen von Ardhmir. Die Felswaende des Ladens sind "
	"mit lauter Regalen vollgestellt, auf denen alle moeglichen Waren zum "
	"Verkauf stehen. Vor Dir an einer langen Theke haengt eine Tafel.";

  if(QueryProp(P_SHOPKEEPER_ID))
  {
    if(!present(QueryProp(P_SHOPKEEPER_ID)))
    {
      txt += "Leider ist momentan gerade niemand hier.";
    }
    else
    {
      txt += "";
    }
  }

  return BS(txt);
}
