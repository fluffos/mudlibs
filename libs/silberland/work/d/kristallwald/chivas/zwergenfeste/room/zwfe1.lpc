// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Die Baeume stehen nicht sehr dicht, so dass die Sonne auf den "
        "Boden faellt und Dich waermt. Eine steile Felswand und der Pfad der "
        "an ihr hinauf fuehrt sind im Osten gut zu erkennen. Nach Norden "
        "fuehrt der Weg tiefer in den Wald neben der Felswand. Die Abzweigung "
        "nach Suedwesten ist durch einen grossen umgefallenen Baum "
        "versperrt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"baeume","baeumen"}), 
            "Die Baeume stehen hier noch nicht so dicht. Im Norden, wo der "
            "Weg weiter fuehrt, wird der Wald dichter. Momentan ist das "
            "Blaetterdach noch durchlaessig und die Sonne scheint durch.");

  AddDetail( ({"sonne"}),
	    "Die Sonne steht fast senkrecht am Himmel und waermt Dich. Da das "
            "Blaetterdach nicht so dicht ist, treffen viele Sonnenstrahlen "
            "den Waldboden.");

  AddDetail( ({"boden","waldboden"}),
	    "Am Waldboden liegen einige Blaetter und Zweige. Ansonsten ist "
            "sieht man die normale fruchtbare Walderde.");

  AddDetail( ({"felswand","osten"}),
	    "Im Osten ist die Felswand der Hochebene zu sehen.");
  
  AddDetail( ({"pfad"}),
	    "Der schmale Pfad im Osten schlaengelt sich an der Felswand hoch "
            "auf die Hochebene.");

  AddDetail( ({"norden","weg","weges"}), 
            "Im Norden fuehrt der Weg tiefer in den Wald hinein.");

  AddDetail( ({"abzweigung","suedwesten"}),
	    "Der Weg fuehrt nach Norden in den Wald, nach Osten zur Hochebene "
            "und nach Suedwesten in unbekanntes Gebiet. Nach Suedwesten ist "
            "aber leider der Weg durch einen umgefallenen Baum versperrt.");

  AddDetail( ({"baum"}),
	    "Ein grosser umgestuerzter Baum versperrt den Weg nach "
            "Suedwesten.");

  AddDetail( ({"himmel"}),
	    "Die Sonne steht beinahe senkrecht am blauen Himmel.");
  
  AddDetail( ({"wald","waldes","anfang"}),
	    "Du stehst am Anfang eines grossen Waldes. Nach Norden hin wird "
            "der Wald dichter.");

  AddDetail( ({"blaetterdach","dach"}), 
            "Das Blaetterdach ist noch sehr durchlaessig und verschiedene "
            "Sonnenstrahlen treffen den Waldboden.");

  AddDetail( ({"sonnenstrahlen","strahlen"}),
	    "Viele Sonnenstrahlen treffen den Waldboden.");

  AddDetail( ({"blaetter"}),
	    "Einige Blaetter liegen auf dem Boden und sie rascheln, wenn man "
            "ueber sie geht.");

  AddDetail( ({"zweige"}),
	    "Kleine Zweige liegen auf dem Weg. Sie sind von den Baeumen "
            "abgefallen. Natuerlich sind auch noch Zweige an den Baeumen.");
  
  AddDetail( ({"walderde","erde"}),
	    "Die Erde ist schwarz und fruchtbar, ansonsten wuerden auch nicht "
            "so viele Pflanzen hier wachsen.");

  AddDetail( ({"pflanzen"}), 
            "Halt die Baeume, Buesche und sonstige Pflanzen in einem Wald.");

  AddDetail( ({"buesche"}),
	    "Am Rand des Weges stehen einige kleine Buesche. Sie sind nicht "
            "sehr interessant.");

  AddDetail( ({"rand"}),
	    "Am Rand stehen Baeume und einige kleine Buesche.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Der Pfad an der Felswand fuehrt auf die Hochebene von Gorthad, "
            "die fuer ihre Huegelgraeber beruehmt ist.");
  
  AddDetail( ({"huegelgraeber"}),
	    "Um die Huegelgraeber zu sehen, musst Du schon auf die Hochebene "
            "gehen.");

  AddDetail( ({"gebiet"}), 
            "Das Gebiet im Suedwesten ist noch unerforscht.");

  AddDetail( ({"blumen","waldblumen"}),
	    "Die duftenden Waldblumen hast Du zuerst am Rand des Weges gar "
            "nicht gesehen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es duftet nach Blumen.");  
 
  AddSmell( ({"blumen","waldblumen"}),
	   "Kleine Waldblumen stehen am Rand des Weges. Sie duften herrlich.");

  AddSound(DEFAULT_SOUND, "Die Blaetter am Boden rascheln, wenn man ueber sie "
                          "geht.");

  AddSound( ({"blaetter"}),
	   "Sie rascheln leise, wenn man ueber sie geht.");
  
//-----Details Ende-----
  
AddExit("osten", "/d/kristallwald/chivas/hochebene/room/hoche1");
AddExit("norden", ROOM "zwfe2");
AddSpecialExit( "suedwesten", "go_suedwesten" );

}
int go_suedwesten(string dir)
{

  if(!(present("marlog", TO)))
  {
    write( BS( "Der Weg nach Suedwesten ist durch einen grossen umgestuerzten "
               "Baum versperrt. Probiere es spaeter noch einmal.") );
    say("Fluchend scheitert"+TP->Name(WEN)+" daran, den Weg "
      "nach Suedwesten zu gehen.\n");
  return -1;
  }
}
