inherit "std/pub";

#include "../def.h"
#include <pub.h>


void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));
  SetProp(P_INT_SHORT,"In der Gaststaette 'Macdorax'");
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "macdorax");
  SetProp(P_PUBKEEPER_NAME, "macdorax");
  SetProp(P_PUBMSG_NOKEEPER, "Macdorax ist leider nicht hier.\n");
  SetProp(P_PUBMSG_NOENEMY, BS(
      "Du bist gerade in einem verbissen Kampf mit Macdorax. Kein Wunder, "
      "dass sie Dich nicht bedient."));
  SetProp(P_PUBMSG_NOINVITE, BS(
      "Macdorax kaempft. Da hat er wahrhaft andere Sorgen als Kunden."));
  SetProp(P_PUBMSG_FIGHTING, "Macdorax kaempft gerade.\n");

  AddDrink("Bier", ({"bier","zwergenbier"}),
           400, 55, 10, 6,
           ({"Macdorax laechelt grimmig und bringt Dir ein grosses "
	     "Glas Bier.\n",
             "&& trinkt ein grosses Glas Bier.\n"}));

  AddDrink("Schnaps", ({"schnaps"}),
            220, 28, 9, 3,
           ({"Macdorax bringt Dir einen Schnaps.\n"
            +"Er schmeckt bitter und Du schuettelst Dich. \n",
             "&& trinkt einen Schnaps und schuettelt sich.\n"}));

  AddDrink("Moostee", ({"moostee","moostee"}),
            150, 15, 0, 5,
           ({"Macdorax bringt Dir eine Tasse gruenlichen Moostee.\n"
            +"Der Tee schmeckt gar nicht schlecht!\n",
             "&& trinkt eine Tasse Moostee.\n"}));

  AddFood("Flechtensuppe", ({"flechtensuppe", "suppe"}), 200, 25, 9,
           ({"Macdorax bringt Dir eine leckere Flechtensuppe. "
            +"\nHmmmm, es schmeckt lecker. Du haettest das gar nicht gedacht.\n",
             "&& loeffelt eine Suppe.\n"}));
  AddFood("Ein kleines Butterbrot", ({"butterbrot","brot"}), 80, 10, 4,
           ({"Macdorax bringt Dir ein kleines Butterbrot.\n"
            +BS("Das Butterbrot schmeckt eigentlich ganz gut, aber mit der Butter "
                "wurde gespart."),
             "&& isst gierig ein kleines Butterbrot.\n"}));

// ----------  Details  ---------------------

  AddDetail( ({"boden","zeit","fleck","flecken"}),
	    "Der Boden ist fleckig. Anscheinend wurde hier schon laengere Zeit "
	    "nicht mehr durchgewischt.");

  AddDetail( ({"decke"}),
	    "An der Decke haengen mehrere kleine Leuchter, auf denen "
	    "unzaehlige Kerzen brennen.");

  AddDetail( ({"waende","waenden","wand"}),
	    "An der Wand direkt neben dem Eingang haengt das Menue der "
	    "Gaststaette. An den anderen Waenden haengen verschiedene Bilder.");

  AddDetail( ({"zwergengaststaette","gaststaette","macdorax"}),
	    "Dies ist die Gaststaette von Macdorax.");

  AddDetail( ({"zwerge"}),
	    "Einige Zwerge sitzen an den Tischen und essen. Andere stehen nur "
	    "an der Theke und trinken. Alle sind tief in ihre Gespraeche "
	    "vertieft und nehmen keine Notiz von Dir.");

  AddDetail( ({"abenteurer"}),
	    "Abenteurer wie Du.");

  AddDetail( ({"kleinigkeit","portionen"}),
	    "Die Portionen sehen fuer eine Kleinigkeit recht gross aus.");

  AddDetail( ({"tische","tischen"}),
	    "An den Tischen, die aus Holz bestehen, sitzen einige Gaeste und "
	    "essen.");

  AddDetail( ({"theke"}),
	    "Die Theke ist ein wenig schmuddelig, jedoch scheint es die Gaeste "
	    "und auch den Wirt nicht besonders zu stoeren.");

  AddDetail( ({"bier"}),
	    "Das Bier soll hier besonders gut schmecken.");

  AddDetail( ({"eingang","ausgang","osten"}),
	    "Der Eingang oder fuer Dich gesehen der Ausgang ist im Osten.");

  AddDetail( ({"menue"}),
	    "Tipp einfach mal 'menue'.");

  AddDetail( ({"leuchter","leuchtern"}),
	    "Einige Leuchter haengen an der Decke. Sie scheinen aus Bronze zu "
	    "bestehen und unzaehlige Kerzen brennen an ihnen.");

  AddDetail( ({"kerzen"}),
	    "Die Kerzen auf den Leuchtern erhellen die Gaststaette ein wenig, "
	    "dass man alles gut erkennen kann.");

  AddDetail( ({"bilder"}),
	    "Die Bilder, die an den Waenden aufgehaengt wurden, zeigen Teile "
	    "der Zwergenfeste.");

  AddDetail( ({"notiz"}),
	    "Keiner der Anwesenden nimmt Notiz von Dir. Du fuehlst Dich ein "
	    "wenig gekraenkt.");

  AddDetail( ({"gespraeche"}),
	    "Die Gespraeche kann man nicht untersuchen, nur hoeren.");

  AddDetail( ({"gaeste","anwesenden"}),
	    "Die Gaeste sind hauptsaechlich Zwerge, aber Du kannst auch ein "
	    "paar Menschen und eine Fee erkennen.");

  AddDetail( ({"menschen","haendler","waren"}),
	    "Die Menschen sind Haendler, die ihre Waren an die Zwerge "
	    "verkaufen wollen.");

  AddDetail( ({"fee","soeldner","zaehne","berserkerfeen","berserkerfee"}),
	    "Die Fee ist bis unter die Zaehne bewaffnet und scheint ein "
	    "Soeldner zu sein. Anscheinend gehoert sie zu den legendaeren "
	    "Berserkerfeen, von denen Du schon gehoert hast.");

  AddDetail( ({"wirt","besitzer"}),
	    "Der Wirt der Gaststaette heisst Macdorax.");

  AddDetail( ({"bronze","glanz"}),
	    "Die Leuchter bestehen aus Bronze. Leider ist ihr Glanz schon "
	    "sehr matt und sie muessten mal geputzt werden.");

  AddDetail( ({"teile","hallen","ratsaal"}),
	    "Du erkennst Bilder, wo die Hallen von Ardhmir abgebildet sind und "
	    "auch der grosse Ratsaal der Zwergenfeste.");

  AddDetail( ({"glaeser"}),
	    "Die Glaeser, in denen hier ausgeschenkt wird, sehen nicht "
	    "besonders sauber aus.");

  AddDetail( ({"lappen","dreck"}),
	    "Der Lappen, der auf der Theke liegt, steht vor Dreck.");

  AddDetail( ({"holz","eiche"}),
	    "Das Holz der Tische scheint aus Eiche zu sein. Es ist sehr "
	    "robust, was es in einer Zwergenkneipe wohl auch sein muss.");

  AddDetail( ({"zwergenkneipe","kneipe","begriff"}),
	    "Der Begriff Kneipe passt eigentlich besser als Gaststaette. Man "
	    "sollte es aber nicht dem Besitzer sagen.");

  AddDetail( ({"zwergenfeste","ardhmir"}),
	    "Das 'Macdorax' ist eine der zwei Gaststaetten in Ardhmir.");

  AddDetail( ({"gaststaetten"}),
	    "Es gibt noch eine andere Gaststaette oder Kneipe in Ardhmir.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Essen und Alkohol.");  
 
  AddSmell( ({"alkohol","geruch"}),
	   "Der Geruch von Alkohol macht Dich schon fast besoffen.");

  AddSmell( ({"essen"}),
	   "Das Essen riecht lecker.");

  AddSound(DEFAULT_SOUND, "Du hoerst die anderen Gaeste, wie sie miteinander "
		          "reden. Ausserdem hoerst Du wie Geschirr abgewaschen "
			  "wird.");

  AddSound( ({"gaeste"}),
	   "Die Gaeste zu belauschen waere nicht nett. Schaem Dich.");

  AddSound( ({"gespraeche"}),
	   "Die Gespraeche gehen Dich gar nichts an. Schaem Dich.");  

  AddSound( ({"geschirr","geklapper"}),
		"Du hoerst das Geklapper von Geschirr wie es abgewaschen wird.");


// ----------- Details Ende -------------------
  AddExit("osten", ROOM "zwfe11");

  AddItem(NPC "macdorax", REFRESH_DESTRUCT);
}

string _query_int_long()
{
  string txt;

  txt = "Dies ist die beruehmte Zwergengaststaette 'Macdorax', von der Du "
	"sicher schon einmal gehoert hast. Die Zwerge und auch Abenteurer wie "
        "Du kehren hier gern ein um schnell eine Kleinigkeit zu essen. An den "
	"Tischen sitzen einige Gaeste und auch an der Theke stehen ein "
	"paar Zwerge und trinken Bier. Gleich neben dem Eingang haengt ein "
	"Menue an der Wand, das Du mit 'menue' lesen kannst. ";

  if(QueryProp(P_PUBKEEPER_ID))
  {
    if(!present(QueryProp(P_PUBKEEPER_ID)))
    {
      txt += "Seltsamerweise ist offenbar gerade niemand hier der Dich "
        "bedienen koennte.";
    }
    else
    {
      txt += "Der Wirt steht hinter der Theke und putzt mit einem dreckigen "
	      "Lappen ein paar Glaeser, die dadurch wieder schmutzig werden.";
    }
  }

  return BS(txt);
}
