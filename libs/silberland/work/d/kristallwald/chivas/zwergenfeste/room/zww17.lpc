// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Waldlichtung");
  SetProp( P_INT_LONG,
	"Am Rand der Lichtung stehen die grossen Baeume des Waldes. Zwischen "
        "ihnen ist dichtes Unterholz zu erkennen, so dass man die Lichtung "
        "nicht quer durch den Wald verlassen kann. Im Sueden schlaengelt sich "
        "ein kleiner flacher Fluss aus dem See und verschwindet zwischen den "
        "Baeumen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1);

//-----Details Anfang-----
  
  AddDetail( ({"rand","baeume","baeumen"}), 
            "Am Rand der Lichtung stehen die grossen Baeume des Waldes. Sie "
            "rahmen die gesamte Lichtung ein.");

  AddDetail( ({"lichtung"}),
	    "Du stehst auf einer grossen Lichtung, in dessen Mitte sich ein "
            "See befindet. Die Wiese auf der Du stehst umrundet fast den "
            "gesamten See. Ausgenommen ist nur die Stelle im Osten wo der "
            "normale Weg von Norden nach Sueden fuehrt.");

  AddDetail( ({"wald","waldes"}),
	    "Der Wald ist ringsum die Lichtung zu sehen.");

  AddDetail( ({"unterholz","moeglichkeit"}),
	    "Das Unterholz ist sehr dicht und es gibt keine Moeglichkeit die "
            "Wiese durch den Wald zu verlassen.");
  
  AddDetail( ({"sueden","fluss"}),
	    "Im Sueden ist ein flacher Fluss, der aus dem See kommt. Es ist "
            "ueberhaupt kein Problem durch ihn zu waten, da er nicht sehr "
            "tief ist.");

  AddDetail( ({"see","mitte"}), 
            "Der See liegt ganz ruhig in der Mitte der Lichtung.");

  AddDetail( ({"boden"}),
	    "Am Boden siehst Du Gras und verschiedene Blumen.");

  AddDetail( ({"himmel","sonne"}),
	    "Der Himmel ist blau. Die Sonne steht beinahe senkrecht ueber Dir.");

  AddDetail( ({"weg","osten","norden","sueden","stelle"}),
	    "Weiter im Osten ist der Weg, der von Norden nach Sueden "
            "verlaeuft.");
  
  AddDetail( ({"wiese"}),
	    "Auf der Wiese wachsen Gras und verschiedene Blumen.");

  AddDetail( ({"problem","probleme","ort"}), 
            "Probleme hat man an solch einem Ort nicht.");

  AddDetail( ({"blumen","detail"}),
	    "Wenn Du wissen willst, was fuer Blumen es sind, geh bitte nach "
            "Osten. Da sind sie bis ins Detail beschrieben.");

  AddDetail( ({"gras"}),
	    "Das Gras ist schoen gruen. Es ist ideal zum Idlen hier.");

  AddDetail( ({"idlen","sache"}),
	    "Idlen ist eine tolle Sache.");
  
  AddDetail( ({"ufer","sicht"}),
	    "Hier reicht das Gras bis an das Ufer vom See. Keine Pflanzen "
            "behindern die Sicht auf das Wasser.");

  AddDetail( ({"wasser"}), 
            "Das Wasser ist sehr klar.");

  AddDetail( ({"pflanzen"}),
	    "Hier auf der Lichtung gibt es sehr viele Pflanzen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Die Blumen duften.");  
 
  AddSmell( ({"blumen"}),
	   "Sie riechen sehr gut.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Wellen ans Ufer schwappen.");

  AddSound( ({"wellen"}),
	   "*schwap*schwap*schwap*");
  
//-----Details Ende-----
AddItem( "/d/ebene/Park/npc/igel", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "zww17",
          P_MNPC_AREA:({ROOM "zww17"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("osten", ROOM "zww18");
AddExit("sueden", ROOM "zww15");

}
