// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Stollen");
  SetProp( P_INT_LONG,
	"Der Stollen teilt sich nach Sueden in mehrere Gaenge auf, in denen "
	"die Zwerge weiter nach Metallen schuerfen. Der Stollen wird durch "
	"einige Fackeln an den Waenden erhellt, so dass man alles sehr gut "
	"sehen kann." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"stollen"}), 
            "Der Stollen teilt sich im Sueden in mehrere Gaenge auf.");

  AddDetail( ({"sueden","suedosten","suedwesten"}),
	    "Im Sueden kannst Du zwischen drei Stollen waehlen.");
  
  AddDetail( ({"gaenge"}), 
            "Die Stollen fuehren nach Sueden, Suedwesten und Suedosten.");

  AddDetail( ({"zwerge"}),
	    "Die Zwerge bauen hier verschiedene Metalle ab.");
  
  AddDetail( ({"metall","metalle","metallen","eisen","gold","silber"}), 
            "Es handelt sich hauptsaechlich um Eisen, aber auch Gold und "
	    "Silber wird ab und zu gefunden.");

  AddDetail( ({"fackeln","licht"}),
	    "Die Fackeln erhellen den Stollen mit ihrem Licht.");
  
  AddDetail( ({"waende","wand","waenden"}), 
            "An den Waenden haengen einige Fackeln.");

  AddDetail( ({"decke"}),
	    "Die Decke ist nicht weit ueber Dir.");
  
  AddDetail( ({"boden","richtung","schienen"}), 
            "Am Boden sind Schienen zu sehen, die in Richtung Sueden enden und "
	    "nur nach Norden verlaufen. Ein Stollenwagen steht hier auf den "
	    "Schienen.");

  AddDetail( ({"norden"}),
	    "Du kannst natuerlich auch den Schienen folgen und nach Norden "
	    "gehen.");
  
  AddDetail( ({"stollenwagen"}), 
            "Ein Stollenwagen steht auf den Schienen. Er ist leider nur mit "
	    "Felsbrocken beladen und nicht mit Metall.");

  AddDetail( ({"felsbrocken"}),
	    "Die Zwerge transportieren auch die Felsbrocken mit den "
	    "Stollenwagen und nicht nur das abgebaute Metall.");
  
  AddDetail( ({""}), 
            "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht stickig.");  

  AddSound(DEFAULT_SOUND, "Du hoerst die Zwerge in den Stollen arbeiten.");

  AddSound( ({"zwerge"}),
	   "Du hoerst die Zwerge haemmern.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "zwfest10");
AddExit("norden", ROOM "zwfest7");
AddExit("suedosten", ROOM "zwfest11");
AddExit("suedwesten", ROOM "zwfest9");
}
