//=========================================================================
//
// Der Wagen faehrt zwischen der Zwergenfeste und Felonia
//
//=========================================================================

#include "../def.h"

inherit "std/transport";

#define HALTEPLATZ_1 ROOM "zwfet"
#define HALTEPLATZ_2 ROOM "zwfefelonia"

void create()
{
  ::create();

//-------------------------------------------------------------------------
// Beschreibung von Innen
//-------------------------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem alten Stollenwagen");
  SetProp(P_INT_LONG,
    "Du stehst in einem alten Stollenwagen, der sich anscheinend durch "
    "magische Kraefte zu bewegen scheint."
  );

//-------------------------------------------------------------------------
// Beschreibung von Aussen
//-------------------------------------------------------------------------

  SetProp(P_SHORT, "Ein alter Stollenwagen");
  SetProp(P_LONG,
    "Du siehst einen alten Stollenwagen."
  );

  AddId( ({"stollenwagen", "wagen"}) );

  SetProp(P_NAME, "Stollenwagen");
  SetProp(P_NAME_ADJ, ({"alt"}) );
  AddAdjective( ({"alten","alt","alter"}) );

  SetProp(P_GENDER, MALE);

  SetProp(P_LIGHT, 0);      //Das Licht wird von der Umgebung uebernommen!
  SetProp(P_TRANSPARENT,1); // Man kann hinein/hinaus schauen

  SetProp(P_DEPARTMSG, ({ // Der Ballon fliegt ab
    // Im Stollenwagen
    "Der alte Stollenwagen setzt sich ploetzlich durch irgendeine magische "
    "Kraft in Bewegung.\n"
    "Du haelst Dich fest.\n",
    // Ausserhalb vom Stollenwagen
    "Der alte Stollenwagen setzt sich langsam in Bewegung "
    "und verschwindet.\n"}));

  SetProp(P_ARRIVEMSG, ({ // Der Stollenwagen kommt an
    // Im Stollenwagen
    "Der Stollenwagen kommt mit lautem Gepolter und einem "
    "starken Ruck in @@QueryArrived@@ an.\n",
    // Ausserhalb
    "Ein alter Stollenwagen kommt aus einem Stollen geschossen und haelt "
    "mit einem Ruck an.\n"}));

  SetProp(P_ENTERMSG, ({ // Jemand betritt den Stollenwagen
    // Ausserhalb
    "klettert in einen alten Stollenwagen",
    // Im Ballon
    "klettert in den Stollenwagen"}));

//-------------------------------------------------------------------------
// Es duerfen nur bis zu 5 Wesen im Ballon
// sein, NPCs gelten auch. Fuer Gegenstaende gibt es keine Beschraenkung.
//-------------------------------------------------------------------------

  SetProp(P_MAX_PASSENGERS, 5);

//-------------------------------------------------------------------------
// Der Ballon ist bereits voll
//-------------------------------------------------------------------------

  SetProp(P_ENTERFAIL,
    BS("Es befinden sich bereits 5 Personen in dem Stollenwagen. Es "
       "ist kein Platz mehr."));

  SetProp(P_LEAVEMSG, ({ // Jemand verlaesst den Stollenwagen
    // Ausserhalb
    "klettert aus einem Stollenwagen",
    // Im Ballon
    "verlaesst den Stollenwagen"}));

  SetProp(P_LEAVEFAIL, // Im Flug darf man den Ballon nicht verlassen
    // Meldung an den Spieler
    "Der alte Stollenwagen faehrt dafuer viel zu schnell durch den "
    "engen Stollen");

  // oder

  // SetProp(P_LEAVEFAIL, ({
  //   // Meldung an den Spieler
  //   "Der knallrote Heissluftballon fliegt dafuer viel zu hoch.\n");
  //   // Meldung an Ballon Insassen (ausser Spieler)
  //   "waere fast aus dem Heissluftballon gefallen.\n"}));

  AddCmd( ({"kletter","klettere", "betrete", "betret"}), "cmd_klettern");
  AddCmd( ({"verlasse", "verlass"}), "cmd_verlassen");

  AddRoute(HALTEPLATZ_1, // Der Ballon landet zuerst in LANDEPLATZ_1
     30, // wartet dort 30 sek lang, dann P_DEPARTMSG und
     20, // nach 20 sek die naechste Meldung/Aktion
     "Ardhmir", // wird bei QueryArrived zurueckgeliefert (siehe oben)
     ({"ardhmir","zwergenfeste","feste"}), // die einzelnen ids fuer 'reise nach/zu(m) bla'
     "zur Zwergenfeste von Ardhmir"); // Du reist jetzt 'nach Bla'

//-------------------------------------------------------------------------
// Meldung an alle im Ballon und 15 sek warten auf naechste Meldung/Aktion
//-------------------------------------------------------------------------

  AddMsg("Der Stollenwagen wird immer schneller.\n", 5);

  AddMsg("Es geht auf alten verrosteten Schienen auf und ab durch einen "
         "engen Stollen.\n", 5);

  AddMsg("Ploetzlich sieht man ein grosses Loch im Boden, wo jedoch auch "
         "die Schienen unterbrochen sind.\n", 3);

  AddMsg("Der Wagen segelt ueber den Abgrund und landet funkenspruehend "
         "auf der anderen Seite des Abgrunds. Du wischt Dir den "
         "Angstschweiss aus dem Gesicht.\n", 5);

  AddMsg("Die Fahrt geht rasend schnell weiter.\n", 5);

  AddMsg("Es ist ein Wunder, dass sich der Wagen auf den schmalen "
         "Schienen haelt und nicht gegen die Tunnelwand schlaegt.\n", 5);

  AddMsg("Es ist sehr beunruhigend, wenn der Wagen in der Kurve nur auf "
         "zwei Raedern steht.\n", 5);

  AddMsg("Das Tempo ist moerderisch. Ploetzlich siehst Du TOD neben Dir, "
         "der Dir aufmunternd zunickt.\n", 3);

  AddMsg("TOD ist wieder verschwunden, anscheinend ist ihm irgend etwas "
         "dazwischen gekommen. Da hast Du aber noch einmal Glueck "
         "gehabt.\n", 5);

  AddMsg("So langsam geht Dein Puls runter und Du gewoehnst Dich an "
         "die Fahrt im Stollenwagen.\n", 5);

  AddMsg("Der Stollenwagen wird ein wenig langsamer und naehert sich Felonia.\n", 10);

//-------------------------------------------------------------------------
// Naechster Halteplatz erreicht
//-------------------------------------------------------------------------

  AddRoute(HALTEPLATZ_2, 30, 20, "in Felonia", ({"felonia"}), "nach Felonia");
  AddMsg("Der Stollenwagen wird immer schneller.\n", 5);

  AddMsg("Es geht auf alten verrosteten Schienen auf und ab durch einen "
         "engen Stollen.\n", 5);

  AddMsg("Ploetzlich sieht man ein grosses Loch im Boden, wo jedoch auch "
         "die Schienen unterbrochen sind.\n", 3);

  AddMsg("Der Wagen segelt ueber den Abgrund und landet funkenspruehend "
         "auf der anderen Seit des Abgrunds. Du wischt Dir den "
         "Angstschweiss aus dem Gesicht.\n", 5);

  AddMsg("Die Fahrt geht rasend schnell weiter.\n", 5);

  AddMsg("Es ist ein Wunder, dass sich der Wagen auf den schmalen "
         "Schienen haelt und nicht gegen die Tunnelwand schlaegt.\n", 5);

  AddMsg("Es ist sehr beunruhigend, wenn der Wagen in der Kurve nur auf "
         "zwei Raedern steht.\n", 5);

  AddMsg("Das Tempo ist moerderisch. Ploetzlich siehst Du TOD neben Dir, "
         "der Dir aufmunternd zunickt.\n", 3);

  AddMsg("TOD ist wieder verschwunden, anscheinend ist ihm irgend etwas "
         "dazwischen gekommen. Da hast Du aber noch einmal Glueck "
         "gehabt.\n", 5);

  AddMsg("So langsam geht Dein Puls runter und Du gewoehnst Dich an "
         "die Fahrt im Stollenwagen.\n", 5);

  AddMsg("Der Stollemwagen wird ein wenig langsamer und naehert sich Ardhmir.\n", 10);

  Start();
}
int cmd_klettern(string str)
{
  notify_fail("Wo willst Du rein oder raus klettern?\n");
  if(str=="in wagen"||
     str=="in stollenwagen"||
     str=="in stollenwagen rein"||
     str=="in wagen rein")
    return Enter();

  if(str=="aus wagen"||
     str=="aus stollenwagen"||
     str=="aus wagen raus"||
     str=="aus stollenwagen raus")
    return Leave();
  return 0;
}
int cmd_verlassen(string str)
{
  notify_fail("Was willst Du verlassen?\n");
  if(str=="wagen"||
     str=="stollenwagen")
    return Leave();
  return 0;
}
void init()
{
  ::init();
  if(interactive(TP))
  {
    catch(call_other(HALTEPLATZ_1, "zwfet"));
    catch(call_other(HALTEPLATZ_2, "zwfefelonia"));
  }
}


