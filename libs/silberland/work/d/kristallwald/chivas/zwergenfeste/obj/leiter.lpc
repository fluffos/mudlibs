#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Leiter");
  SetProp(P_LONG,
    "Die Leiter besteht aus Holz. Man kann sicher an ihr hochklettern und "
    "Dinge erreichen, die weiter oben sind.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Leiter");
  SetProp(P_GENDER, MALE);
  AddId("leiter");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_OAK: 100]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE, 200);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 0);

}
