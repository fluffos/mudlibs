// von Chivas

#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "Unsichtbar!" );
  SetProp(P_NAME, 0);
  SetProp(P_GENDER, MALE);
  AddId(({"zwinvis3","unsichtbar"}));

  SetProp(P_MATERIAL, ([MAT_GLASS: 100]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
}
void player_message()
{
  mixed env;
  
  while(remove_call_out("player_message") != -1) continue;
  
  if(objectp(TP) && objectp(env=ENV(TO)))
  {
    tell_object(env, BS("Hier kann die Message rein!"));
    call_out("player_message",30); //5 Minuten Timer
    return;
  }
  call_out("remove", 0);
  return;
}

void reset()
{
  ::reset();
  remove();

}
