inherit "std/food";    

#include <food.h>      
#include "../def.h"


void create()
{
  if (!is_clone(this_object()))    
    return;                             

  ::create( ({ "trink", "trinke" }) );


  AddId( ({ "brandwein" }) );
  AddId( ({ "flasche" }) );

  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Brandwein");
  SetProp(P_SHORT, "Eine Flasche Brandwein");
  SetProp(P_LONG,
    "Die Flasche beinhaltet den guten Brandwein der Zwergenfeste von Ardhmir. "
    "Er schmeckt sicher sehr lecker.");
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 200); 
  SetProp(P_NOSELL, 1);
  SetProp(P_MATERIAL, ([MAT_ALCOHOL:100]));
  SetProp(P_INFO,
      "Du willst den Brandwein nur noch trinken!\n");
  SetProp(P_SMELL,
      "Riecht nach .. Brandwein.");

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 80, 40 }),
         F_SOAK    : 0,         
         F_DRINK   : 100,       
         F_ALCOHOL : 20,         
         F_POISON  : 0,         
         F_MSG     : "Du trinkst die Flasche mit Brandwein leer.",
         F_MSG_ROOM: "trinkt gierig eine Flasche Brandwein!",
         F_VERB    : "trinken"   
      ]) );                   
  start_decay(43200, -1);

}




