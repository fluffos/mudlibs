#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Hammer und ein Meissel");
  SetProp(P_LONG,
    "Der Hammer und der Meissel besteht aus hartem Stahl. Mit dem Hammer und "
    "dem Meissel kann man sicher sehr gut Eisen abbauen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Hammer und Meissel");
  SetProp(P_GENDER, MALE);
  AddId("meissel");
  AddId("hammer");
  AddId("hammer und meissel");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_METAL: 100]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE, 150);
  SetProp(P_VALUE, 150);
  SetProp(P_NOSELL, 1);


}
