inherit "std/food";    

#include <food.h>      
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Fisch");
  SetProp(P_LONG,
    "Ein kleiner Fisch zappelt in Deinen Haenden. Er sieht auch sehr "
    "lecker aus und Du kriegst grossen Hunger auf rohen Fisch.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Fisch");
  SetProp(P_GENDER, MALE);
  AddId("fisch");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 20); 
  SetProp(P_NOSELL, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_FOOD:100]));
  SetProp(P_INFO,
      "Der Goldfisch sieht sehr lecker aus!\n");
  SetProp(P_SMELL,
      "Riecht nach .. Fisch.");

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 10, 0 }),
         F_SOAK    : 4,         
         F_DRINK   : 0,       
         F_ALCOHOL : 0,         
         F_POISON  : 0,         
         F_MSG     : "Du isst den zappelnden Fisch.",
         F_MSG_ROOM: "schlingt einen zappelnden Fisch herunter!",
         F_VERB    : "essen"   
      ]) );                   
}


