#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine kleine Murmel");
  SetProp(P_LONG,
    "Die kleine Murmel ist fast schwarz. Sieht aber fast aus wie ein Auge.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "murmel");
  SetProp(P_GENDER, FEMALE);
  AddId("murmel");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_GLASS: 100]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE, 150);
  SetProp(P_VALUE, 100);
}
