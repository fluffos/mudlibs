inherit "std/food";    

#include <food.h>      
#include "../def.h"


void create()
{
  if (!is_clone(this_object()))    
    return;                             

  ::create();


  AddId( ({ "apfel" }) );

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Apfel");
  SetProp(P_SHORT, "Ein Apfel");
  SetProp(P_LONG,
    "Der Apfel ist schoen rot und gross. Da laeuft Dir das Wasser "
    "im Mund zusammen. Einfach lecker.");
  SetProp(P_WEIGHT, 25);
  SetProp(P_VALUE, 0); 
  SetProp(P_NOSELL, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_FOOD:100]));
  SetProp(P_INFO,
      "Du willst den Apfel nur noch essen!\n");
  SetProp(P_SMELL,
      "Riecht nach .. Apfel.");

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 5, 0 }),
         F_SOAK    : 2,         
         F_DRINK   : 0,       
         F_ALCOHOL : 0,         
         F_POISON  : 0,         
         F_MSG     : "Du isst den Apfel.",
         F_MSG_ROOM: "verschlingt gierig einen Apfel!",
         F_VERB    : "essen"   
      ]) );                   
}




