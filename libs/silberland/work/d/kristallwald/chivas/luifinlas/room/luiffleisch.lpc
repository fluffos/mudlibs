inherit "std/laden";
inherit "/d/wueste/protheg/most/std_things";

#include "../def.h"
#include <properties.h>
#include <player.h>
#include <moving.h>
#include <laden.h>

#define MAX_BUY 8

nosave mapping gekauft;

void create()
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:22]));

  SetProp(P_INT_SHORT, "In der Fleischerei von Luifinlas");
  SetProp(P_INT_LONG, 
     BS("Du bist in der Fleischerei von Luifinlas. Hier kannst Du Fleisch in "
	"verschiedener Form kaufen. An der Decke haengen Wuerstchen und kleine "
	"Fleischstuecke liegen in der Auslage des Tresens. Es sieht alles so "
	"lecker aus.")+
     BS("Wenn Du wissen willst, was Du hier kaufen kannst, gib einfach "
        "'zeige' ein."));
  
  AddDetail(({"fleischerei","name"}), 
	    "Hier gibt es Wuerstchen und wie der Name schon sagt auch "
	    "Fleisch.");
  
  AddDetail(({"luifinlas"}), 
	    "Du bist in Luifinlas.");
  
  AddDetail(({"fleisch","form"}), 
	    "Hier gibt es viel Fleisch in jeder Form. Dies ist kein Ort fuer "
	    "Vegetarier.");
  
  AddDetail(({"decke"}), 
	    "An der Decke haengen Wuerstchen.");
  
  AddDetail(({"wuerstchen"}), 
	    "DIe Wuerstchen sehen lecker aus.");
  
  AddDetail(({"fleischstuecke","stuecke","wasser","mund"}), 
	    "Die Fleischstuecke lassen Dir das Wasser im Mund zusammen "
	    "laufen.");
  
  AddDetail(({"auslage"}), 
	    "In der Auslage liegt viel Fleisch.");
  
  AddDetail(({"tresens","tresen"}), 
	    "Am Tresen haengt ein kleines Schild.");
  
  AddDetail(({"ort"}), 
	    "Du magst den Ort, da Du ja auch Fleisch magst.");
  
  AddDetail(({"vegetarier"}), 
	    "Du bist keiner.");
  
  AddDetail(({"schild"}), 
	    "Du kannst mit 'zeige' sehen, was es hier alles gibt.");
  
  AddDetail(({"boden","fliesen"}), 
	    "Der Boden ist gefliest und sauber.");
  
  AddDetail(({"waende","waenden","wand"}), 
	    "An den Waenden haengen auch Wuerste.");
  
  AddDetail(({"wuerste","wasser","mund"}), 
	    "Dir laeuft das Wasser im Mund zusammen.");
  
  AddDetail(({""}), 
	    "");

  AddSmell(DEFAULT_SMELL, 
	   "Es riecht ganz lecker nach Fleisch.");

  AddSmell(({"duft"}),
	   "Der Duft ist verfuehrisch."); 

  AddSmell(({"fleisch"}), 
	   "Der Duft macht Dich hungrig.");

  AddSound(DEFAULT_SOUND, "Du hoerst wie hinten in der Fleischerei "
		          "gearbeitet wird.");

  AddSound( ({"fleischerei"}),
	   "Du willst nicht wissen, was weiter hinten gerade passiert.");


  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "fleischermeister");
  SetProp(P_SHOPKEEPER_NAME, "Der Fleischermeister");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  
  SetStorageRoom(ROOM "luifflager");      

  AddExit("westen", ROOM "luifinlas74");

  AddItem(NPC "fleischermeister", REFRESH_DESTRUCT);  

  
  RemoveFixedObject(0);
  
  gekauft=([]);
}

void reset()
{
  ::reset();
  
  gekauft=([]);
}

int sell(string str, int f)
{
  if(present("fleischermeister"))
    return notify_fail(break_string("Entschuldigt bitte, edler Gast, aber "
				    "wir kaufen hier nichts an.", 78, 
				    "Der junge Fleischermeister meint: ")), 0;
  
  return notify_fail(BS("Der Fleischmereister ist leider nicht da!")), 0;
}

nosave int force_sell(string str) { return sell(); }
nosave int evaluate(string str) { return sell(); }

nosave string do_liste(string str)
{
  object store;
  int i;
  object *inv;
  string *k;
  mapping obj;
  string tmp, out;
    
  call_other(storage, "_register_shop", ME);
  
  if(!objectp(store=find_object(storage))) return "";

  inv=all_inventory(store);
  obj=([]);
  out="";
  
  switch(str)
    {
    case "lecker":
    case "wuerste":
      for(i=sizeof(inv)-1;i>=0;i--)
	if(inv[i]->id("WURST"))
	  if(member(obj, tmp=explode(file_name(inv[i]), "#")[0]))
	    obj[tmp, 2]+=1;
	  else
	    obj+=([tmp:inv[i]->Name(WER); QueryBuyValue(inv[i]); 1]);
      
      k=m_indices(obj);
      
      for(i=sizeof(obj)-1;i>=0;i--)
	out+=sprintf("  %30-'.'s %1d Stueck zu je %3d Muenzen\n",
		     obj[k[i]]+" ", obj[k[i],2], obj[k[i],1]);
      		     
      break;
      
    case "stueck":
    case "fleisch":
      for(i=sizeof(inv)-1;i>=0;i--)
	if(!inv[i]->id("FLEISCH"))
	  if(member(obj, tmp=explode(file_name(inv[i]), "#")[0]))
	    obj[tmp, 2]+=1;
	  else
	    obj+=([tmp:inv[i]->Name(WER); QueryBuyValue(inv[i]); 1]);

      k=m_indices(obj);
      
      for(i=sizeof(obj)-1;i>=0;i--)
	out+=sprintf("  %30-'.'s %1d Stueck zu je %3d Muenzen\n",
		     obj[k[i]]+" ", obj[k[i],2], obj[k[i],1]);
		     
      break;

    default:
      out+=do_liste("wuerste");
      tmp=do_liste("fleisch");

      if(strlen(out))
	out=" Wuerste\n==============\n"+out+"\n";
            
      if(strlen(tmp))
	tmp=" Fleisch\n=============\n"+tmp;
      
      out+=tmp;
    }
  return out;
}

nosave int list(string str)
{
  string prefix, ret;
  
  notify_fail("Mit 'zeige', 'zeige wuerste' oder 'zeige fleisch' "
		 "siehst Du die Auswahl.");
  
  if((str) && 
     (member(({"lecker","wuerste","fleisch","stueck"}), str)==-1)) 
    return 0;
  
  if(!prefix=CheckKeeper()) return 1;
  
  if(strlen(ret=do_liste(str)))
    TP->More(make_document(ret));
  else
    write(BS (prefix+"Ich bin im Moment leider total ausverkauft!"));

  return 1;
}

//Alles unflexibel, muss ich das buy halt ueberschreiben...
nosave int buy(string str)
{
  int i, val;
  object ob, store;
  string prefix, dummy;

  // Im Kampf kann man nichts kaufen
  if(TP->InFight())
    return write(BS ("Dazu bist Du im Moment viel zu beschaeftigt.")), 1;

  // Haendler da? Meldungen etc.
  if(!prefix=CheckKeeper(2)) return 0;
  if(!str)
    return write(BS (KeeperPrefix("fragt Dich: ")+"Was willst Du kaufen?")), 1;

  _notify_fail(prefix+"Das kann ich im Lager nicht finden.\n");
  
  // Objekt suchen
  if(sscanf(str,"%d%s",i,dummy)>0 && i>0)
    if((dummy==" ab") || (dummy=="")) ob=FindInStore(i);
    else ob=FindInStore(str);
  else ob=FindInStore(str);
  
  if(!ob)  return 0;

  if(member(gekauft, getuid(TP)))
    if(gekauft[getuid(TP)] >= MAX_BUY)
      return write(prefix+"Du kaufst noch alles weg!\n"+
		   prefix+"Lass den anderen doch auch etwas ueber!\n"), 1;

  // Geld pruefen
  val=QueryBuyValue(ob);
  if((i=this_player()->QueryMoney()) < val)
    return write(break_string(ob->Name(WER,1)+" wuerde"+
			      (ob->IsPlural() ? "n " : " ")+val+" Muenze"+
			      (val==1 ? "" : "n")+" kosten, Du "+
			      (i ? "hast aber nur "+i+"."
			       : "bist aber voellig pleite!"),
			      78, prefix)), 1;

  // Geldtransfer
  this_player()->AddMoney(-val);
  mymoney += val;

  // fixed object? (staendig verfuegbar)
  if(stringp(ob))
    ob=clone_object((string) ob);

  // Kaufen und als behalten markieren
  write(BS ("Du kaufst Dir "+ob->name(WEN,1)+"."));
  say(BS (TP->Name()+" kauft sich "+ob->name(WEN)+"."));
  ob->SetProp(P_KEEP_ON_SELL, getuid(TP));

  // Kanns der Spieler tragen?
  if (ob->move(this_player(),M_GET) <= 0)
  {
    write(prefix + "Du kannst " + ob->QueryPronoun(WEN) +
        " nicht mehr tragen!\n");
    ob->move(environment(this_player()));       // Objekt in den Raum moven
  }

  UpdateCounter(ob,-1);

  if(member(gekauft, getuid(TP))) gekauft[getuid(TP)]++;
  else gekauft+=([getuid(TP):1]);  

  return 1;
}

mapping QueryVars()
{
  return gekauft;
}
