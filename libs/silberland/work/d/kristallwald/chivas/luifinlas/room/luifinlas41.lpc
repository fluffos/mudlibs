// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Weg fuehrt von Suedwesten nach Nordosten, wo ein Bach den Weg "
	"kreuzt. Eine kleine Bruecke scheint ueber ihn hinweg zu fuehren. Die "
	"Baeume werden ein wenig lichter und geben Dir den Blick frei auf den "
	"Bach, der munter vor sich hin plaetschert." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"weg","rand"}),
	    "Der Weg fuehrt Dich nach Nordosten an den Rand eines Baches, "
	    "ueber den eine Bruecke fuehrt. Du kannst sehr gut den Bach von "
	    "hier aus sehen.");

  AddDetail( ({"suedwesten","nordosten"}),
	    "Nach Suedwesten oder Nordosten kannst Du von hier aus gehen.");
  
  AddDetail( ({"bach"}),
	    "Der Bach plaetschert ueber groessere und kleinere Steine am Weg "
	    "und unter der Bruecke im Nordosten vorbei. Auch ein paar "
	    "Wasserpflanzen kannst Du sehen.");

  AddDetail( ({"bruecke"}), 
            "Die Bruecke befindet sich im Nordosten. Du musst schon hingehen "
	    "um mehr zu erkennen.");

  AddDetail( ({"baeume","moeglichkeit"}),
	    "Die Baeume geben Dir die Moeglichkeit den Bach gut zu sehen. Sie "
	    "stehen nicht so dicht.");

  AddDetail( ({"blick"}),
	    "Du kannst den Bach sehr gut von hier sehen.");

  AddDetail( ({"boden"}),
	    "Am Boden sind lauter kleine Steinchen und einige Blaetter zu "
	    "sehen.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist nur teilweise zu sehen, da er hier noch vom "
	    "dichten Blaetterdach der Baeume verdeckt wird.");

  AddDetail( ({"steine"}),
	    "Die Steine liegen im Bach und der Bach plaetschert ueber sie "
	    "hinweg.");
  
  AddDetail( ({"wasserpflanzen"}),
	    "Du siehst ein paar gruene Wasserpflanzen, die Du jedoch nicht "
	    "kennst.");

  AddDetail( ({"blaetter"}), 
            "Die Blaetter sind von den Baeumen auf den Weg gefallen.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach ist sehr dicht ueber Dir.");

  AddDetail( ({"steinchen"}),
	    "Die Steinchen sind nicht sehr interessant.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht waldig.");  

  AddSound(DEFAULT_SOUND, "Du hoerst den Bach plaetschern.");

  AddSound( ({"bach","plaetschern"}),
	   "Das Plaetschern wirkt sehr beruhigend auf Dich.");
  
//-----Details Ende-----
  
AddExit("nordosten", ROOM "luifinlas40");
AddExit("suedwesten", ROOM "luifinlas42");

}
