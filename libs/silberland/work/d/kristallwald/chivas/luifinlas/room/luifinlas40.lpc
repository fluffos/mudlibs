// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int angel_zahl=1;

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Du stehst mitten im Wald auf einer kleinen Holzbruecke, die einen "
	"Bach ueberspannt. Der Bach plaetschert ueber grosse und kleine Steine "
	"munter durch den Wald hindurch. Auch einige Bachforellen sind in der "
	"Stroemung zu sehen. In beiden Richtungen in die Du gehen kannst ist "
	"nur dichter Wald zu sehen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wald"}),
	    "Du bist mitten im Wald. Es ist recht schoen hier mit dem Bach, "
	    "der hier fliesst und den Baeumen hier.");

  AddDetail( ({"holzbruecke","bruecke","zeiten"}),
	    "DIe Holzbruecke auf dem Du stehst hat schon bessere Zeiten "
	    "gesehen. Sie ist alt und ein wenig wackelig.");
  
  AddDetail( ({"bach","baches"}),
	    "Der Bach plaetschert ueber die Steine unter der Bruecke durch.");

  AddDetail( ({"steine"}), 
            "Der Bach fliesst ueber grosse und kleine Steine.");

  AddDetail( ({"bachforellen","forellen"}),
	    "Du siehst ein paar leckere Bachforellen. Vielleicht kannst Du "
	    "welche angeln.");

  AddDetail( ({"stroemung"}),
	    "Die Stroemung ist recht stark.");

  AddDetail( ({"richtungen"}),
	    "Du kannst in zwei Richtungen gehen.");
  
  AddDetail( ({"boden"}),
	    "Der Boden besteht aus dicken Bohlen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ueber Dir ist blau.");
  
  AddDetail( ({"bohlen"}),
	    "Die Bohlen sind morsch. Du solltest nicht so lange hier stehen. "
	    "Vielleicht brechen sie. Sie sind schon ziemlich alt.");

  AddDetail( ({"baeumen","baeume","seiten"}), 
            "Es sind viele Baeume auf beiden Seiten der Bruecke.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht waldig.");  

  AddSound(DEFAULT_SOUND, "Du hoerst das Plaetschern des Baches.");

  AddSound( ({"bach","plaetschern"}),
	   "Das Plaetschern des Baches wirkt beruhigend.");
  
//-----Details Ende-----
  
AddExit("nordosten", ROOM "luifinlas39");
AddExit("suedwesten", ROOM "luifinlas41");

AddCmd( ({"angel","angle" }), "angeln" );
}

void reset()
	
{
  ::reset();
  angel_zahl=1; 
}

int angeln(string str)
{
 object fisch;
 notify_fail("Was willst Du womit angeln?\n");

 if(!str || str == "") return 0;
 if(!(str == "mit angel" ||
      str == "bachforelle" ||
      str == "bachforelle mit angel" ||
      str == "mit angel bachforelle" ||
      str == "forelle" ||
      str == "forelle mit angel" ||
      str == "mit angel forelle" ||
      str == "fisch" ||
      str == "fisch mit angel" ||
      str == "mit angel fisch" ||
      str == "mit angel nach fisch" )) return 0;
 

 if( str == "mit angel" ||
      str == "bachforelle" ||
      str == "bachforelle mit angel" ||
      str == "mit angel bachforelle" ||
      str == "forelle" ||
      str == "forelle mit angel" ||
      str == "mit angel forelle" ||
      str == "fisch" ||
      str == "fisch mit angel" ||
      str == "mit angel fisch" ||
      str == "mit angel nach fisch"){
    
  if(!present("angel", TP)){
	  
  write(BS("Du hast ja gar keine. Wie willst Du dann mit einer Angel angeln?\n"));
 
  say(TPN+" denkt nach.\n");
  return -1;
  }

  if(angel_zahl < 1)

  {
	  
  write(BS("Die Bachforellen fallen auf den Koeder an der Angel nicht mehr "
	   "rein.\n"));
 
  say(TPN+" angelt umsonst.\n");
  return 1;
  }
  else
  {
  write(BS("Du angelst wild vor Dich hin und ploetzlich beisst auch eine "
	   "Bachforelle an. Du schnappst sie Dir und steckst sie ein. \n"));
 
  say(TPN+" faengt mit der Angel einen Fisch.\n");
  fisch=clone_object(OBJ "fisch")->move(TP, M_NOCHECK);
  angel_zahl--;
  return 1;
 }
 if( str == "fisch"){
 
 write(BS("Womit willst Du denn angeln ? "
	  "Eine Angel waere hier eine gute Idee.\n"));

 say(TPN+" stellt sich dumm an.\n");
 return 1;
 }
 }
}

