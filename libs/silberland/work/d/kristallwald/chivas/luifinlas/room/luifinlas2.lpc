// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Du stehst auf einer Bruecke, die ueber einen Bach fuehrt. Das Wasser "
	"plaetschert durch den Wald. Die Zweige einer grossen Weide haengen in "
	"den Bach. Es ist ein sehr schoener Ort hier und Du fuehlst Dich sehr "
	"wohl." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"bruecke"}),
	    "Die Bruecke auf der Du stehst und die den kleinen Bach "
	    "ueberspannt besteht aus Holz. Ihr Gelaender ist reich verziert.");

  AddDetail( ({"bach","baches"}),
	    "Der Bach plaetschert hier unter der Bruecke durch.");
  
  AddDetail( ({"wasser","wassers"}),
	    "Das Wasser ist glasklar und Du kannst die grossen Steine am "
	    "Grund des Baches gut sehen. Auch einige Algen sind gut in der "
	    "Stroemung zu erkennen.");

  AddDetail( ({"wald"}), 
            "Du bist mitten im Wald.");

  AddDetail( ({"zweige","oberflaeche"}),
	    "Die Zweige der Weide haengen in den Bach und verkreuseln die "
	    "Oberflaeche des Wassers.");

  AddDetail( ({"weide"}),
	    "Die grosse Weide ist ein schoener Baum. Hier kann man sicher gut "
	    "rasten.");

  AddDetail( ({"ort"}),
	    "Du fuehlst Dich an diesem Ort sehr gut.");
  
  AddDetail( ({"boden"}),
	    "Du stehst auf der Bruecke.");

  AddDetail( ({"himmel","sonne"}),
	    "Die Sonne steht am Himmel und spiegelt sich im Bach.");
  
  AddDetail( ({"gelaender"}),
	    "Am Gelaender erkennst Du schoene Schnitzereien.");

  AddDetail( ({"holz"}), 
            "Das Holz stammt sicher hier aus dem Wald.");

  AddDetail( ({"schnitzereien"}),
	    "Die Schnitzereien sehen aus wie kleine Voegel. Sie sind wirklich "
	    "sehr gelungen.");

  AddDetail( ({"voegel"}),
	    "Es sitzen einige im Blaetterdach ueber Dir und ein Kuenstler hat "
	    "welche in das Gelaender der Bruecke geschnitzt.");

  AddDetail( ({"blaetterdach"}),
	    "Das Blaetterdach der Baeume ist hier nicht sehr dicht ueber Dir, "
	    "da Du Dich ja auf einer Bruecke im Wald befindest und keine "
	    "Baeume direkt neben Dir stehen.");
  
  AddDetail( ({"baeume"}),
	    "Es gibt hier viele Baeume, aber ein Baum faellt Dir besonders "
	    "auf.");

  AddDetail( ({"baum"}),
	    "Eine alte Weide sieht sehr schoen aus.");
  
  AddDetail( ({"grund","steine"}),
	    "Am Grund des Baches sind grosse Steine zu sehen. Einige schauen "
	    "auch aus dem Bach heraus und das Wasser plaetschert ueber sie "
	    "hinweg.");

  AddDetail( ({"stroemung","algen"}), 
            "Die Algen haften am Grund des Baches und bewegen sich leicht in "
	    "der sanften Stroemung des Baches.");

  AddDetail( ({"kuenstler"}),
	    "Der Kuenstler ist nicht da.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht waldig.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst den Bach plaetschern.");

  AddSound( ({"bach"}),
	   "*plaetscher*");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas1");
AddExit("sueden", ROOM "luifinlas3");

}

