// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Waldweg");
  SetProp( P_INT_LONG,
	"Das Licht, was auf den Waldweg einfaellt ist nur sehr gedaempft. Die "
	"Baeume stehen ganz nah am Weg und ihre Kronen beruehren sich ueber "
	"Dir und bieten den Sonnenstrahlen kaum die Moeglichkeit den Boden zu "
	"erreichen. Am Boden sind einige Steinchen zu sehen und ein paar herab "
        "gefallene Blaetter und Aeste." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"licht"}),
	    "Das Licht ist nur sehr gedaempft. Durch das dichte Blaetterdach "
	    "dringt kaum ein Lichtstrahl.");

  AddDetail( ({"waldweg","weg","suedwesten","nordosten"}),
	    "Der Weg fuehrt Dich durch den dichten Wald von Suedwesten nach "
	    "Nordosten.");
  
  AddDetail( ({"baeume"}),
	    "Die Baeume stehen sehr dicht am Weg.");

  AddDetail( ({"kronen"}), 
            "Die Kronen der grossen Baeume beruehren sich ueber Dir und "
	    "bilden ein dichtes Blaetterdach.");

  AddDetail( ({"sonnenstrahlen","strahlen","lichtstrahl","strahl"}),
	    "Es dringen kaum Sonnenstrahlen durch die Blaetter der Baeume.");

  AddDetail( ({"moeglichkeit","teil"}),
	    "Das Licht hat kaum eine Moeglichkeit diesen Teil des Waldes zu "
	    "erhellen.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit Steinchen, Blaettern und Aesten bedeckt.");
  
   AddDetail( ({"steinchen"}),
	    "Die Steinchen sind klein und rund und ausserdem nicht besonders "
	    "interessant.");

  AddDetail( ({"blaetter","blaettern"}),
	    "Es gibt Blaetter auf dem Boden und sehr sehr viele an den "
	    "Baeumen.");
  
  AddDetail( ({"aeste","aesten"}),
	    "Die Aeste sind sicher von den Baeumen herunter gefallen.");

  AddDetail( ({"blaetterdach","dach"}), 
            "Das Blaetterdach ist sehr dicht ueber Dir.");

  AddDetail( ({"waldes","wald","indiz"}),
	    "Da Du Dich auf einem Waldweg befindest, musst Du wohl in einem "
	    "Wald sein. Auch die Baeume sind ein gutes Indiz dafuer.");

  AddDetail( ({"himmel"}),
	    "Der Himmel muss hinter dem dichten Blaetterdach der Baeume sein.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht waldig.");  
 
  AddSound(DEFAULT_SOUND, "Es hoert sich hier alles waldig an.");


//-----Details Ende-----
  
AddExit("nordosten", ROOM "luifinlas46");
AddExit("suedwesten", "/d/kristallwald/chivas/weg/room/zenw8");

}
