inherit "std/pub";

#include "../def.h"
#include <pub.h>


void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp(P_INT_SHORT,"In der Gaststaette 'Zum Zwergenkrieger'");
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "grimbosch");
  SetProp(P_PUBKEEPER_NAME, "grimbosch");
  SetProp(P_PUBMSG_NOKEEPER, "Grimbosch ist leider nicht hier.\n");
  SetProp(P_PUBMSG_NOENEMY, BS(
      "Du bist gerade in einem verbissen Kampf mit Grimbosch. Kein Wunder, "
      "dass er Dich nicht bedient."));
  SetProp(P_PUBMSG_NOINVITE, BS(
      "Grimbosch kaempft. Da hat er wahrhaft andere Sorgen als Kunden."));
  SetProp(P_PUBMSG_FIGHTING, "Grimbosch kaempft gerade.\n");

  AddDrink("Bier", ({"bier"}),
           500, 55, 10, 6,
           ({"Grimbosch nickt und bringt Dir ein grosses Glas Bier.\n",
             "&& trinkt ein grosses Glas Bier.\n"}));

  AddDrink("1 Flasche Sekt(Picollo)", ({"sekt","picollo","flasche"}),
            220, 28, 9, 3,
           ({"Grimbosch bringt Dir einen Picollo und guckt Dich ein wenig "
	    "suspekt an. Wer trinkt sowas.\n"
            +"Er schmeckt hervorragend. \n",
             "&& trinkt eine kleine Flasche Sekt.\n"}));

  AddDrink("Zwergentee", ({"zwergentee","tee"}),
            150, 15, 0, 5,
           ({"Grimbosch bringt Dir eine Tasse starken Zwergentee.\n"
            +"Der schmeckt fuer Tee nicht schlecht und beruhigt!\n",
             "&& trinkt eine Tasse Zwergentee.\n"}));

  AddFood("Hoehlenwuermer", ({"hoehlenwuermer", "wuermer"}), 200, 25, 9,
           ({"Grimbosch bringt Dir eine Schale mit lebenden und sich "
	   "windenden Hoehlenwuermern. "
            +"\nHmmmm, es schmeckt lecker. Sieht aber ekelig aus.\n",
             "&& isst eine Portion Hoehlenwuermer.\n"}));
  AddFood("Eine Blutwurst", ({"blutwurst","wurst"}), 80, 10, 4,
           ({"Grimbosch bringt Dir eine Blutwurst.\n"
            +BS("Die Blutwurst schmeckt eigentlich ganz gut, wenn nicht der "
		"blutige Geschmack waere."),
             "&& isst gierig eine Delikatesse.\n"}));

// ----------  Details  ---------------------

  AddDetail( ({"boden"}),
	    "Der Boden besteht aus grossen Steinplatten.");

  AddDetail( ({"steinplatten","platten","steine"}),
	    "Die Steinplatten wurden sicher von weit her aus dem Gebirge "
	    "hier her gebracht.");

  AddDetail( ({"gebirge"}),
	    "Geh einfach mal hin.");

  AddDetail( ({"gaststaette","zum"}),
	    "Du befindest Dich in der Gaststaette 'Zum Zwergenkrieger'.");

  AddDetail( ({"menue"}),
	    "Das Menue haengt an der Wand. Tipp 'menue' und Du siehst was Du "
	    "bestellen kannst.");

  AddDetail( ({"tuer","sonne","strasse"}),
	    "Die Tuer auf die Strasse ist offen. Draussen scheint die Sonne zu "
	    "scheinen.");

  AddDetail( ({"wirt"}),
	    "Der Wirt dieser Gaststaette steht vor Dir oder ist gerade nicht "
	    "da.");

  AddDetail( ({"viertel"}),
	    "Das Viertel, in dem Du Dich befindest, wird hauptsaechlich von "
	    "Zwergen bewohnt.");

  AddDetail( ({"wand","waende"}),
	    "An den Waenden haengt ein Menue und Fackeln in ihren Halterungen, "
	    "die den Raum erhellen. Ausserdem stehen Baenke an der Wand.");

  AddDetail( ({"raum"}),
	    "Der Raum ist eine Gaststaette. Du stehst an der Theke.");

  AddDetail( ({"luifinlas","stadt"}),
	    "Luifinlas ist die Stadt, in der Du bist.");

  AddDetail( ({"fackel","fackeln"}),
	    "Die Fackeln haengen in Halterungen an der Wand und erhellen die "
	    "Gaststaette ein wenig.");

  AddDetail( ({"halterung","halterungen","eisen"}),
	    "Die Halterungen in denen die Fackeln haengen bestehen aus Eisen "
	    "und sind sehr haesslich.");

  AddDetail( ({"decke","spinnenweben"}),
	    "An der Decke haengen ein paar Spinnenweben, ansonsten sieht man "
            "nichts besonderes.");
  
  AddDetail( ({"theke","fleck","hochglanz"}),
	    "Die Theke ist sehr lang und absolut auf Hochglanz poliert. "
	    "Du erkennst einen einzigen Fleck.");

  AddDetail( ({"tische","tisch"}),
	    "An den Tischen sitzen viele Gaeste und unterhalten sich.");

  AddDetail( ({"baenke"}),
	    "Die Baenke sind besetzt von Zwergen, die hier viel Bier trinken.");

  AddDetail( ({"bier"}),
	    "Das Bier schmeckt hier sehr gut.");

  AddDetail( ({"zwergenkrieger","krieger"}),
	    "Auch viele robuste und grimmige Zwergenkrieger trinken hier ihr "
	    "Bier.");

  AddDetail( ({"stuehle","stuhl"}),
	    "Auf den Stuehlen an den Tischen sitzen die Gaeste oder stehen an der Theke.");

  AddDetail( ({"gaeste","elfen","zwergen","zentauren","zwerge","menschen","abstand","ueberzahl"}),
	    "Die Gaeste bestehen aus Elfen, Zentauren, Menschen und natuerlich "
            "auch Zwerge sind anwesend. Sie sind mit Abstand in der "
	    "Ueberzahl.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Alkohol und gebratenem Essen.");  
 
  AddSmell( ({"alkohol","geruch"}),
	   "Der Geruch von Alkohol macht Dich schon fast besoffen.");

  AddSmell( ({"essen"}),
	   "Das gebratene Essen riecht schon sehr lecker.");

  AddSound(DEFAULT_SOUND, "Du hoerst die anderen Gaeste, wie sie miteinander "
		          "reden. Ausserdem hoerst Du wie in der Kueche hinter "
			  "der Theke gekocht wird.");

  AddSound( ({"gaeste"}),
	   "Die Gaeste zu belauschen waere nicht nett. Schaem Dich.");
  
  AddSound( ({"kueche","geklapper","geschirr"}),
		"Du hoerst das Geklapper von Geschirr.");

// ----------- Details Ende -------------------
  AddExit("osten", ROOM "luifinlas81");

  AddItem(NPC "grimbosch", REFRESH_DESTRUCT);
}

string _query_int_long()
{
  string txt;

  txt = "Du befindest Dich in der Gaststaette 'Zum Zwergenkrieger' im Viertel "
	"der Zwerge in Luifinlas. Es gibt eine grosse Theke an der viele "
	"Gaeste stehen und Bier trinken. Es sind hauptsaechlich Zwerge "
	"anwesend. Ausserdem stehen auch einige Tische, Baenke und Stuehle "
	"herum wo sich einige der Gaeste niedergelassen haben. Gleich neben "
	"der Tuer haengt ein Menue an der Wand, das Du mit 'menue' lesen "
	"kannst. ";

  if(QueryProp(P_PUBKEEPER_ID))
  {
    if(!present(QueryProp(P_PUBKEEPER_ID)))
    {
      txt += "Seltsamerweise ist offenbar gerade niemand hier der Dich "
        "bedienen koennte.";
    }
    else
    {
      txt += "Der Wirt steht hinter der Theke und laechelt Dich "
        "grimmig an.";
    }
  }

  return BS(txt);
}
