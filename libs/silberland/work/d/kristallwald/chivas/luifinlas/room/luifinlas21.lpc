// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Strasse von Luifinlas");
  SetProp( P_INT_LONG,
	"Lauter unterschiedliche Haeuser stehen an der Strasse. Es gibt grosse "
	"und kleine Haeuser, aber auch welche, die gar nicht wie Haeuser "
	"aussehen. Im Sueden ist der grosse Platz von Luifinlas, auf dem eine "
	"grosse Statue zu stehen scheint." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"haeuser"}),
	    "Viele Haeuser stehen hier. Einige sehen eher aus wie Hoehlen und "
	    "in ihnen scheinen auch Leute zu wohnen. Die Haeuser sind den "
	    "einzelnen Rassen im Silberland angepasst.");

  AddDetail( ({"strasse","norden","sueden"}),
	    "Die Strasse fuehrt von Norden nach Sueden.");
  
  AddDetail( ({"sueden","platz"}),
	    "Im Sueden ist ein grosser Platz zu sehen.");

  AddDetail( ({"luifinlas"}), 
            "Du bist in Luifinlas.");

  AddDetail( ({"statue"}),
	    "Die Statue ist ein grosses Denkmal.");

  AddDetail( ({"boden"}),
	    "Der Boden der Strasse ist sauber gepflastert.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau.");
   
  AddDetail( ({"rassen","frieden"}),
	    "Es gibt alle moeglichen Rassen im Silberland. Fast alle "
	    "wohnen auch in Luifinlas in Frieden miteinander.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland.");
  
  AddDetail( ({"denkmal"}),
	    "Geh einfach naeher ran um Dir das Denkmal anzusehen.");

  AddDetail( ({"hoehlen"}), 
            "In den Haeusern, die mehr wie Hoehlen aussehen, wohnen wohl "
	    "Hobbits, die es ja lieben in Hoehlen zu wohnen.");

  AddDetail( ({"hobbits"}), 
            "Die Hobbits sind eine der vielen Rassen im Silberland.");

  AddDetail( ({"leute"}), 
            "Davon gibt es viele in Luifinlas.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach allem moeglichen.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst viel Laerm vom Platz.");

  AddSound( ({"laerm","platz"}),
	   "Geh einfach naeher ran um mehr zu hoeren. Von hier aus verstehst "
	   "Du nicht viel.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "luifinlas15");
AddExit("norden", ROOM "luifinlas22");


}
