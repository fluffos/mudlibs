// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Im Gefaengnis von Luifinlas");
  SetProp( P_INT_LONG,
	"Du stehst im Gefaengnis von Luifinlas. An den Waenden sind lauter "
	"kleine Zellen zu sehen und einige Ketten haengen an den Waenden. In "
	"der Mitte steht ein grosser Schreibtisch mit einem Stuhl, wo "
	"anscheinend der Gefaengniswaerter arbeitet und seine Listen erstellt. "
	"Nach Osten kannst Du das Gefaengnis wieder verlassen und nach Unten "
	"geht es anscheinend zu den wirklich gefaehrlichen Verbrechern." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"gefaengnis"}),
	    "Du bist im Gefaengnis der Stadt.");

  AddDetail( ({"stadt","luifinlas"}),
	    "Auch Luifinlas hat als grosse Stadt ein Gefaengnis.");
  
  AddDetail( ({"waende","waenden","wand"}),
	    "An den Waenden sind die Zellen zu sehen und einige Ketten haengen "
	    "dort auch.");

  AddDetail( ({"zellen"}), 
            "Die Zellen sind klein und einige Ketten sind auch zu sehen.");

  AddDetail( ({"ketten"}),
	    "Die Ketten sind wohl dafuer gedacht, einen Haeftling ein wenig "
	    "sicherer zu verwahren.");

  AddDetail( ({"mitte","schreibtisch","tisch","stuhl"}),
	    "In der Mitte steht ein grosser Schreibtisch und ein Stuhl. Auf "
	    "dem Tisch liegen alle moeglichen Unterlagen und Listen herum.");

  AddDetail( ({"gefaengniswaerter","waerter"}),
	    "Der Gefaengniswaerter hat hier sicher einiges zu tun.");
  
  AddDetail( ({"listen"}),
	    "Die Listen, die er hier anfertigt muss er sicher zum Patrizier "
	    "bringen um ihm darzulegen, wieviele Gaeste momentan hier wohnen.");

  AddDetail( ({"osten"}),
	    "Im Osten kannst Du raus aus dem Gefaengnis.");
  
  AddDetail( ({"unten","verbrechern","verbrecher","schwerverbrecher"}),
	    "Nach unten kannst Du noch nicht gehen. Dies haelt Chivas momentan "
	    "noch fuer zu gefaehrlich.");

  AddDetail( ({"boden"}), 
            "Der Boden besteht aus grossen Steinplatten.");

  AddDetail( ({"decke","stein"}),
	    "Die Decke besteht aus hartem Stein.");

  AddDetail( ({"haeftling","haeftlinge","haeftlingen"}),
	    "Einige Haeftlinge sitzen in den kleinen Zellen. Die "
	    "Schwerverbrecher sind aber sicher unten untergebracht.");

  AddDetail( ({"unterlagen"}),
	    "Die Unterlagen beschaeftigen sich sicher mit den Haeftlingen.");
  
  AddDetail( ({"gaeste","gast"}),
	    "Du willst kein Gast hier sein.");

  AddDetail( ({"patrizier"}),
	    "Der Patrizier regiert die Stadt Luifinlas.");
  
  AddDetail( ({"chivas","magier"}),
	    "Chivas ist einer dieser faulen Magier.");

  AddDetail( ({"steinplatten","platten"}), 
            "Die Steinplatten gehen nahtlos ineinander ueber.");

  AddDetail( ({"nerven"}),
	    "Nerven sollte man hier schon haben.");
  
  AddDetail( ({"ruhe"}),
	    "Ruhe hat man hier sicher mehr als genug.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig muffig im Gefaengnis.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst ein Heulen.");

  AddSound( ({"heulen"}),
	   "Das Heulen stammt von einem der Haeftlinge. Er ist sicher ein "
	   "wenig mit den Nerven runter. Du laesst ihn besser in Ruhe.");
  
//-----Details Ende-----
  
AddExit("osten", ROOM "luifinlas83");
AddSpecialExit( "unten", "go_unten" );

}
int go_unten(string dir)
{

  if(!(present("marlog", TO)))
  {
    write( BS( "Ein Gefaengniswaerter haelt Dich davon ab runter zu gehen. "
               "Momentan darf nur einer der Magier nach unten gehen und die "
	       "Schwerverbrecher besuchen.") );
    say("Ein Gefaengniswaerter haelt "+TP->Name(WEN)+" davon ab, "
      "nach Unten zu gehen.\n");
  return -1;
  }
}
