// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einer Waldkreuzung");
  SetProp( P_INT_LONG,
	"Du stehst an einer Kreuzung im Wald. Es gibt drei Moeglichkeiten "
	"weiter zu gehen. Nach Norden und Osten geht es weiter im Wald. Im "
	"Westen scheint sich eine grosse Stadt zu befinden. Du kannst die "
	"Stadtmauer und das Tor der Stadt von hier aus sehen. Am Rand steht "
	"ein Wegweiser der Dir vielleicht helfen kann bei der Wahl Deiner "
	"Richtung." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"kreuzung"}),
	    "Du stehst an einer Kreuzung des Weges. Du kannst nach Norden, "
	    "Westen oder Osten gehen. Am Rand steht ein Wegweiser, der Dir "
	    "sagt, wohin es geht.");

  AddDetail( ({"wald","stelle"}),
	    "Der Wald beginnt an dieser Stelle und setzt sich nach Norden und "
	    "Osten fort.");
  
  AddDetail( ({"moeglichkeiten"}),
	    "Es gibt immer Moeglichkeiten.");

  AddDetail( ({"norden"}), 
            "Im Norden ist ein tiefer Wald.");

  AddDetail( ({"osten"}),
	    "Im Osten geht der Wald weiter.");

  AddDetail( ({"westen","stadt"}),
	    "Im Westen liegt eine Stadt. Du kannst die Stadtmauer und das Tor "
	    "sehen.");

  AddDetail( ({"stadtmauer","mauer"}),
	    "Die Stadtmauer fuehrt um die ganze Stadt herum.");
  
  AddDetail( ({"tor"}),
	    "Das Tor im Osten ist geoeffnet.");

  AddDetail( ({"rand","wegrand"}),
	    "AM Wegrand steht ein Wegweiser.");
  
  AddDetail( ({"wegweiser"}),
	    "Du kannst das Schild lesen.");

  AddDetail( ({"wahl","richtung"}), 
            "Du musst eine Wahl ueber Deine Richtung treffen.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen einige Blaetter und Steine.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist durch das Blaetterdach noch gut zu sehen, da es "
	    "hier nicht so dicht ist.");

  AddDetail( ({"schild"}),
	    "Lies es.");
  
  AddDetail( ({"blaetter"}),
	    "Viele Blaetter liegen auf dem Boden.");

  AddDetail( ({"steine"}),
	    "Einige uninteressante Steine liegen am Boden.");
  
  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach der Baeume ist nicht so dicht an hier.");

  AddDetail( ({"baeume"}), 
            "Hier gibt es sehr viele davon. Ist ja auch normal in einem Wald.");

  AddDetail( ({"weg","weges"}),
	    "Du stehst auf einem Weg.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddReadDetail( ({"schild"}),
		"Norden - Luifinlas\n"
		"Westen - Roch Adan\n"
		"Osten - unbekannt\n");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Wald.");  
 
  AddSmell( ({"wald"}),
	   "Es riecht waldig.");

  AddSound(DEFAULT_SOUND, "Es ist recht still hier.");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "luifinlas64");
AddExit("osten", ROOM "luifinlas65");
AddExit("norden", ROOM "luifinlas62");

}

