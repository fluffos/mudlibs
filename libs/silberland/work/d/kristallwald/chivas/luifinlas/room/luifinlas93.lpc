// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Es ist sehr dunkel in diesem Teil des Waldes. Im Norden herrscht "
	"sogar absolute Dunkelheit, so dass man dort sicher eine Lichtquelle "
	"benoetigt. Hier sieht man zumindest die langen Aeste der Baeume, die "
	"einen zu greifen versuchen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"teil","wald","waldes"}),
	    "Du bist tief in einem dunklen Wald.");

  AddDetail( ({"norden"}),
	    "Im Norden herrscht absolute Finsternis.");
  
  AddDetail( ({"dunkelheit","finsternis"}),
	    "Dort brauchst Du sicher eine Lichtquelle.");

  AddDetail( ({"lichtquelle"}), 
            "Du kannst nur hoffen, dass Du eine hast, wenn Du nach Norden "
	    "gehst, ansonsten siehst Du naemlich nicht viel.");

  AddDetail( ({"aeste"}),
	    "Die langen Aeste der Baeume scheinen nach Dir zu greifen. Der "
	    "Wald macht einen sehr feindseligen Eindruck auf Dich.");

  AddDetail( ({"baeume","baeumen"}),
	    "Die Baeume stehen sehr dicht. Nur einige kleine Straeucher sind "
	    "zwischen ihnen zu sehen.");

  AddDetail( ({"boden","weg","weges","steinchen"}),
	    "Der Boden des Weges ist mit kleinen Steinchen bedeckt, die nicht "
	    "sehr wichtig sind.");
  
  AddDetail( ({"himmel"}),
	    "Den Himmel kannst Du nur erahnen.");

  AddDetail( ({"eindruck"}),
	    "Du bist sicher, dass der Eindruck nicht falsch ist.");
  
  AddDetail( ({"straeucher","blaetter"}),
	    "Die Straeucher sind tot. Sie haben keine Blaetter mehr und haben "
	    "die Dunkelheit hier nicht gut verkraftet.");

  AddDetail( ({""}), 
            "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach nichts.");  

  AddSound(DEFAULT_SOUND, "Es ist totenstill.");

//-----Details Ende-----
  
AddExit("nordosten", ROOM "luifinlas92");
AddExit("sueden", ROOM "luifinlas94");

}

