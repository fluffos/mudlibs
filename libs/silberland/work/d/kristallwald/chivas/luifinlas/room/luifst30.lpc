// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Stadtmauer von Luifinlas");
  SetProp( P_INT_LONG,
	"Du bist auf der Suedseite der Stadtmauer. Du hast einen "
        "einen guten Ueberblick ueber das Umland. Die Wiese bietet keinen "
	"Moeglichkeit sich zu verstecken, um unbemerkt in die Stadt zu "
	"kommen. Du erkennst auch einen Weg, der aus dem Stadttor nach "
	"Sueden fuehrt."	);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"suedseite"}),
	    "Du bist an der Suedseite der Stadtmauer von Luifinlas.");

  AddDetail( ({"stadtmauer","meter","mauer"}),
	    "Die Stadtmauer ist mehrere Meter hoch und besteht aus Stein. Sie "
	    "ist ein maechtiger Schutz gegen Angriffe und fuehrt um die ganze "
	    "Stadt herum.");
  
  AddDetail( ({"ueberblick","umland"}),
	    "Du hast einen guten Ueberblick auf das Umland der Stadt.");

  AddDetail( ({"wiese"}), 
            "Die Wiese ist angelegt worden. Die dort stehenden Baeume wurden "
	    "gefaellt und nur die Baumstuempfe sind zu sehen.");

  AddDetail( ({"moeglichkeit"}),
	    "Auf der Wiese hast Du keine Moeglichkeit Dich an die Stadt "
	    "heran zu schleichen.");

  AddDetail( ({"stadt"}),
	    "Die Stadt wird von der Mauer komplett eingeschlossen. Nur durch "
	    "die Stadttore kann man hinein oder heraus gelangen.");

  AddDetail( ({"boden"}),
	    "Der Boden der Stadtmauer besteht aus Stein.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau.");

  AddDetail( ({"stein"}),
	    "Die Stadtmauer besteht aus grossen Steinquadern.");
  
  AddDetail( ({"schutz"}),
	    "Der Schutz durch die maechtige Stadtmauer ist enorm.");

  AddDetail( ({"angriffe"}), 
            "An der Stadtmauer prallen viele Angriffe ab.");

  AddDetail( ({"steinquadern","steinquader"}),
	    "Grosse Steinquader bilden die Stadtmauer von Luifinlas.");

  AddDetail( ({"stadttore","tore","sueden","osten","westen","norden"}),
	    "Es gibt Stadttore im Sueden, Osten, Westen und Norden.");

  AddDetail( ({"baeume"}),
	    "Man sieht Baeume nur weiter entfernt.");
  
  AddDetail( ({"baumstuempfe"}),
	    "Auf der Wiese sind viele Baumstuempfe zu sehen.");

  AddDetail( ({"luifinlas"}),
	    "Luifinlas wird komplett von der Mauer umschlossen.");
  
  AddDetail( ({"weg"}),
	    "Der Weg fuehrt aus dem Stadttor nach Norden in unbekanntes "
	    "Gebiet.");

  AddDetail( ({"gebiet"}),
	    "Da warst Du sicher noch nicht.");

  AddDetail( ({"stadttor","naehe"}),
	    "Du bist in der Naehe des noerdlichen Stadttors.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"nase"}),
	    "Deine Nase ist sehr gross.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst die Stadt.");  
 
  AddSmell( ({"stadt"}),
	   "Dir steigen die unterschiedlichsten Gerueche der Stadt in die "
	   "Nase.");

  AddSmell( ({"gerueche"}),
	   "Es sind alle moeglichen Gerueche.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Laerm der Stadt.");

  AddSound( ({"laerm"}),
	   "Um besser zu hoeren, was los ist, musst Du schon von der "
	   "Stadtmauer runter und in die Stadt gehen.");
  
//-----Details Ende-----
//
AddExit("westen", ROOM "luifst31");  
AddExit("osten", ROOM "luifst29");
AddExit("nordostunten", ROOM "luifinlas30");

}

