// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Wald ist sehr dicht um den Weg herum. Am Rand des Weges sind "
	"lauter Straeucher, die es Dir unmoeglich machen den Weg zu "
	"verlassen. Ein kleiner Busch zwaengt sich auch zwischen den grossen "
	"Staemmen der Baeume hervor." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wald","moeglichkeit"}),
	    "Der Wald ist sehr dicht um Dich herum. Lauter Baeume und "
	    "Straeucher, die Dir nicht die Moeglichkeit geben, den Weg zu "
	    "verlassen.");

  AddDetail( ({"weg","weges"}),
	    "Der Weg fuehrt hier durch den dichten Wald.");
  
  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand sind viele Baeume und Straeucher zu sehen.");

  AddDetail( ({"straeucher","sicht"}), 
            "Die Straeucher versperren Dir zusaetzlich die Sicht um mehr von "
	    "dem Wald zu sehen.");

  AddDetail( ({"busch"}),
	    "Der kleine Busch zwaengt sich zwischen den Baeumen durch. Seine "
	    "Aeste sind aber nicht so dicht.");

  AddDetail( ({"staemme","staemmen"}),
	    "Die Baeume haben grosse dicke Staemme. Zwischen zwei Staemmen ist "
	    "ein kleiner Busch zu sehen.");

  AddDetail( ({"baeume","baeumen"}),
	    "Die Baeume sind hier eng am Weg.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit Blaettern und kleinen Steinchen "
	    "bedeckt.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist durch das dichte Blaetterdach nicht zu erkennen.");

  AddDetail( ({"aeste"}), 
            "Du kannst zwischen den Aesten durchgucken.");

  AddDetail( ({"pfad","osten"}),
	    "Der Pfad fuehrt nach Osten. Vielleicht kannst Du Dich durch "
	    "die Aeste zwaengen.");

  AddDetail( ({"steinchen"}),
	    "Kleine Steinchen liegen am Boden.");

  AddDetail( ({"blaettern","blaetter"}),
	    "Die Blaetter sind von den Baeumen herunter gefallen.");
  
  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach ueber Dir ist sehr dicht.");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht waldig.");  

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel im Blaetterdach.");

  AddSound( ({"voegel"}),
	   "*triller*");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas34");
AddExit("suedwesten", ROOM "luifinlas36");

AddCmd( ({"zwaeng", "zwaenge" }), "zwaengen" );
AddCmd( ({"guck", "gucke" }), "gucken" );

}
int zwaengen(string str)
{
   notify_fail("Wo moechtest Du Dich durchzwaengen?\n");
   if ( member( ({ "durch aeste","durch busch" }),str) != -1) 
  {
    write(BS ( "Du zwaengst Dich durch den Busch hindurch auf den dahinter "
	       "liegenden Pfad.\n"));
      TP->move( ROOM "luifhex1", M_GO, 
      "ploetzlich zwischen den Aesten eines Busches", "verschwindet", 
      "zwaengt sich herein");
    return 1;
  }
}
int gucken(string str)
{
   if ( member( ({"durch aeste","durch aeste hindurch","durch busch","durch busch hindurch"})
,str) != -1) 
  {
    write( "Du guckst durch den Busch hindurch und siehst einen kleinen "
           "Pfad.\n");
    say( TPN+" macht Etwas, dass Du nicht sehen kannst.\n");
    return 1;
  }
}
