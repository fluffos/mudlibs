// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int angel_zahl=1;

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Wiese");
  SetProp( P_INT_LONG,
	"Du stehst in einem Blumenmeer, durch das der Weg nach Nordosten in "
	"den Wald fuehrt. Nach Sueden ueberquerst Du einen Bach ueber eine "
	"kleine Bruecke. Der plaetschert vor sich hin ueber die Wiese." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"blumenmeer","richtungen"}),
	    "Das Blumenmeer erstreckt sich in alle Richtungen bis zur "
	    "Waldgrenze.");

  AddDetail( ({"meer"}),
	    "Hier ist ausser einem Blumenmeer kein richtiges Meer zu "
	    "sehen.");
  
  AddDetail( ({"blumen"}),
	    "Lauter Blumen in allen moeglichen Farben sind zu sehen.");

  AddDetail( ({"nordosten","wald"}), 
            "Im Nordosten geht es in den Wald.");

  AddDetail( ({"sueden"}),
	    "Im Sueden ist eine Bruecke, die ueber einen kleinen Bach "
	    "fuehrt.");

  AddDetail( ({"bach","bett","seiten"}),
	    "Der Bach plaetschert in seinem Bett ueber die Wiese und "
	    "verschwindet auf beiden Seiten im Wald. Du erkennst ein "
	    "paar Fische im Bach.");

  AddDetail( ({"bruecke","holz"}),
	    "Die Bruecke besteht aus Holz und fuehrt ueber den "
	    "kleinen Bach.");
    
  AddDetail( ({"wiese","lichtung"}),
	    "Die Wiese ist sehr gross. Es ist eine grosse Lichtung. Du siehst "
	    "ein paar Bienenkoerbe auf der Wiese stehen.");

  AddDetail( ({"boden"}),
	    "Der Boden des Weges ist mit kleinen Steinchen bedeckt.");
  
  AddDetail( ({"himmel","wolken"}),
	    "Der Himmel ueber Dir ist blau. Nur ein paar Wolken sind "
	    "zu sehen.");

  AddDetail( ({"weg"}), 
            "Der Weg fuehrt von Nordosten nach Sueden.");

  AddDetail( ({"waldgrenze","grenze"}),
	    "Die Waldgrenze umschliesst die Lichtung.");

  AddDetail( ({"fische"}),
	    "Du kannst ja mal probieren einen zu angeln.");

  AddDetail( ({"steinchen"}),
	    "Die Steinchen sind nicht sehr interessant.");
  
  AddDetail( ({"bienenkoerbe","koerbe","nektar"}),
	    "Viele Bienen umschwirren die Koerbe und suchen Nektar in den "
	    "Blumen.");

  AddDetail( ({"bienen","luft"}),
	    "Es fliegen viele Bienen durch die Luft.");
  
  AddDetail( ({"farben"}),
	    "Du siehst rote, gelbe, blaue und noch viele andere Blumen.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen"}),
	   "Es riecht sehr gut hier.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Summen.");

  AddSound( ({"summen","bienen"}),
	   "Das Summen kommt von den Bienen.");
  
//-----Details Ende-----
  
AddExit("nordosten", ROOM "luifinlas50");
AddExit("sueden", ROOM "luifinlas52");

AddCmd( ({"angel","angle" }), "angeln" );
}

void reset()
	
{
  ::reset();
  angel_zahl=1; 
}

int angeln(string str)
{
 object fisch;
 notify_fail("Was willst Du womit angeln?\n");

 if(!str || str == "") return 0;
 if(!(str == "mit angel" ||
      str == "fisch" ||
      str == "fisch mit angel" ||
      str == "mit angel fisch" ||
      str == "mit angel nach fisch" )) return 0;
 

 if( str == "mit angel" ||
     str == "fisch mit angel" ||
     str == "mit angel fisch"){
    
  if(!present("angel", TP)){
	  
  write(BS("Du hast ja gar keine. Wie willst Du dann mit einer Angel angeln?\n"));
 
  say(TPN+" denkt nach.\n");
  return -1;
  }

  if(angel_zahl < 1)

  {
	  
  write(BS("Die Fische fallen auf den Koeder an der Angel nicht mehr rein.\n"));
 
  say(TPN+" angelt umsonst.\n");
  return 1;
  }
  else
  {
  write(BS("Du angelst wild vor Dich hin und ploetzlich beisst auch ein "
	   "Fisch an. Du schnappst ihn Dir und steckst ihn ein. \n"));
 
  say(TPN+" faengt mit der Angel einen Fisch.\n");
  fisch=clone_object(OBJ "fisch")->move(TP, M_NOCHECK);
  angel_zahl--;
  return 1;
 }
 if( str == "fisch"){
 
 write(BS("Womit willst Du denn angeln ? "
	  "Eine Angel waere hier eine gute Idee.\n"));

 say(TPN+" stellt sich dumm an.\n");
 return 1;
 }
 }
}

