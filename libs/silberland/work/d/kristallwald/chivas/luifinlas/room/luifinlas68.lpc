// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  AddRoomMessage( ({ "Ein paar kleine Hobbitkinder laufen schreiend im "
	             "Dorf herum und spielen.\n"}),
                     30, "sound" );
  
  SetProp( P_INT_SHORT, "In Hubbleton");
  SetProp( P_INT_LONG,
	"Du stehst im noerdlichen Teil des Dorfes Hubbleton. Lauter kleine "
	"grasbewachsene Huegel sind zu erkennen, in denen anscheinend die "
	"Hobbits des Dorfes leben. Nach Norden kann man das Dorf verlassen und "
	"eine grosse Wiese sehen. Im Sueden ist die Mitte des Dorfes, wo ein "
	"grosser Baum steht." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"teil"}),
	    "Du stehst im noerdlichen Teil des kleinen Dorfes Hubbleton.");

  AddDetail( ({"dorf","dorfes","hubbleton"}),
	    "Das kleine Dorf Hubbleton wird nur von Hobbits bewohnt. Es "
	    "besteht aus lauter Grashuegeln, in denen die Hobbits ihre Hoehlen "
	    "gebaut haben.");
  
  AddDetail( ({"huegel","grashuegeln","huegeln","grashuegel"}),
	    "In den mit Gras bedeckten Huegeln wohnen die Hobbits von "
	    "Hubbleton. Sie haben ihre wohnlichen Hoehlen direkt in die "
	    "Huegel gebaut.");

  AddDetail( ({"hobbits"}), 
            "Hier in Hubbleton leben nur Hobbits.");

  AddDetail( ({"norden","wiese"}),
	    "Im Norden ist eine grosse mit Gras bewachsene Wiese zu sehen.");

  AddDetail( ({"sueden","mitte"}),
	    "In der Mitte des Dorfes steht ein grosser alter Baum.");

  AddDetail( ({"baum"}),
	    "Der Baum ist eine grosse alte Weide.");
  
  AddDetail( ({"boden","steinchen"}),
	    "Der Boden im gesamten Dorf ist mit kleinen Steinchen bedeckt. "
	    "Genauso wie auf dem Weg, der Dich hier her gefuehrt hat.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist herrlich blau. Nur ein paar weisse Woelkchen "
	    "ziehen am Himmel entlang.");
  
  AddDetail( ({"hoehlen","hoehle","hobbithoehle","fall"}),
	    "Die Hobbits haben wohnliche Hoehlen. Sie sind auf keinen Fall "
	    "kalt und nass oder anders wie man sich eine normale Hoehle "
	    "vorstellt. Man kann sich sehr wohl in einer Hobbithoehle "
	    "fuehlen.");

  AddDetail( ({"gras","stellen"}), 
            "Das Gras auf der Wiese im Norden und auf den Huegeln ist kurz "
	    "geschoren und sieht sehr gepflegt aus. Ausserdem ist es herrlich "
	    "gruen. Es sind keine dunklen oder vertrockneten Stellen zu "
	    "sehen.");

  AddDetail( ({"weide","aeste","blaetter"}),
	    "Die Weide ist riesig und ihre Aeste und Blaetter reichen weit "
	    "nach unten. Geh einfach mal naeher ran und schau sie Dir an.");

  AddDetail( ({"weg","seite"}),
	    "Nach Norden fuehrt ein Weg aus dem Dorf hinaus. Sicher gibt es "
	    "auf der anderen Seite noch einen Weg, der Dich suedlich des "
	    "Dorfes weiter bringt.");

  AddDetail( ({"woelkchen","regen"}),
	    "Die weissen Woelkchen sehen nicht nach Regen aus.");
  
  AddDetail( ({"hobbitkinder","kinder","kindern"}),
	    "Die Kinder schreien und lachen und spielen friedlich "
	    "miteinander.");

  AddDetail( ({"herz"}),
	    "Du hast eins.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Gras.");  
 
  AddSmell( ({"gras"}),
	   "Das Gras auf den Huegeln und auf der Wiese duftet herrlich "
	   "frisch.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Lachen und Schreien von Kindern.");

  AddSound( ({"kindern","schreien","lachen","kinderlachen"}),
	   "Es ist schoen die Kinder zu hoeren. Es befreit Dein Herz ein "
	   "Kinderlachen zu hoeren.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas69");
AddExit("sueden", ROOM "luifinlas101");
AddExit("suedosten", ROOM "luifinlas102");
AddExit("suedwesten", ROOM "luifinlas100");

}

