


inherit "/std/room";

#include "../def.h"
#include "/mail/post.h"
#include <properties.h>
#include <rooms.h>
#include  <moving.h>

create(argh) {
  int i;
  (::create());
  SetProp(P_INT_SHORT,"Im Postamt von Luifinlas");
  SetProp(P_INT_LONG,
          "Dies ist das Postamt von Luifinlas. An der hinteren Wand stehen "
	  "grosse Regale auf denen sich die Briefe und viele Pakete stapeln. "
	  "In der Mitte zieht sich ein grosser Tresen durch die Post um den "
	  "hinteren Arbeitsbereich von der Oeffentlichkeit zu trennen. "
	  "Ausserdem erkennst Du ein paar kleine Tische im Eingangsbereich, wo "
	  "einige Blaetter und Hefte liegen. \n" 
          "                                                              \n"
          "Wenn Du das willst, tippe 'post' oder 'mail', bzw. 'mail <spieler>'.\n");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1 );
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"postamt","amt","post"}), 
            QueryProp(P_INT_LONG));

  AddDetail( ({"luifinlas","stadt"}),
	    "Luifinlas ist die Stadt, in der Du Dich gerade befindest."); 

  AddDetail( ({"wand","waende"}),
	    "An der hinteren Wand stehen viele Regale. An den anderen Waenden "
	    "haengen einige Schilder."); 

  AddDetail( ({"regale","regal","regalen"}),
	    "Auf den Regalen stapeln sich Briefe und Pakete. Die einzelnen "
	    "Regale sind mit Woertern beschriftet. "); 

  AddDetail( ({"briefe","brief"}),
	    "Viele Briefe liegen auf den Regalen."); 

  AddDetail( ({"pakete","paket"}),
	    "Viele Pakete liegen auf den Regalen. Es gibt groessere und "
	    "kleinere und einige sehen auch recht schwer aus. Du bist froh, "
	    "dass Du sie nicht tragen musst."); 

  AddDetail( ({"mitte","tresen"}),
	    "Der Tresen ist sauber geputzt und trennt den Arbeitsbereich vom "
	    "Eingangsbereich."); 

  AddDetail( ({"arbeitsbereich"}),
	    "Im Arbeitsbereich sortieren die Angestellten der Post die Briefe "
	    "und Pakete. Dieser Arbeitsbereich ist nur fuer Personen erlaubt, "
	    "die hier arbeiten."); 

  AddDetail( ({"oeffentlichkeit","leute"}),
	    "Damit sind Leute wie Du gemeint."); 

  AddDetail( ({"tische"}),
	    "Ein paar Tische stehen im Eingangsbereich auf denen Blaetter und "
	    "Hefte ausgelegt sind."); 

  AddDetail( ({"eingangsbereich"}),
	    "Du befindest Dich im Eingangsbereich der Post von Luifinlas."); 

  AddDetail( ({"blaetter","werbeblaetter"}),
	    "Die Blaetter auf den Tischen sind meistens Werbeblaetter der "
	    "verschiedenen Handwerker hier in Luifinlas."); 

  AddDetail( ({"hefte","infobroschueren"}),
	    "Die Hefte auf den Tischen sind Infobroschueren der ansaessigen "
	    "Gilden."); 

  AddDetail( ({"boden","steinplatten","platten"}),
	    "Der Boden besteht aus Steinplatten und ist blank geputzt."); 

  AddDetail( ({"decke"}),
	    "Die Decke besteht aus Holz und ist schmucklos. Eine grosse "
	    "Oellampe haengt von ihr und spendet Licht."); 

  AddDetail( ({"schilder"}),
	    "Die Schilder werben fuer verschiedene Handwerker in Luifinlas."); 

  AddDetail( ({"woertern","woerter"}),
	    "An den Regalen stehen die einzelne Orte, in die die Post "
	    "anscheind verschickt werden soll. Du erkennst Orte wie Midas, "
	    "Felonia, Tijara, Roch Adan und noch einige mehr."); 

  AddDetail( ({"orte","midas","felonia","tijara","roch","adan","roch adan"}),
	    "Midas,Felonia, Tijara und Roch Adan sind einige der vielen "
	    "Orte im Silberland."); 

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland."); 

  AddDetail( ({"angestellten","angestellte","personen","tatsache"}),
	    "Es sind meist kleine Kobolde, die fuer die Post arbeiten. Dies "
	    "ist kein Vorurteil, sondern eine Tatsache im Silberland."); 

  AddDetail( ({"kobolde","rasse"}),
	    "Kobolde sind eine Rasse im Silberland."); 

  AddDetail( ({"vorurteil","vorurteile"}),
	    "Du hast keine Vorurteile. Du bist immer offen fuer alles."); 

  AddDetail( ({"gilden"}),
	    "Es gibt viele Gilden in Luifinlas. Schau Dich einfach mal um. "
	    "Momentan hast Du keine grosse Lust zum Lesen."); 

  AddDetail( ({"oellampe","lampe","licht","raum"}),
	    "Die Lampe erhellt den Raum."); 

  AddDetail( ({"holz"}),
	    "Es ist sehr uninteressant und hat keine Details."); 

  AddDetail( ({"details","detail"}),
	    "Dann forsch mal!"); 

  AddDetail( ({"handwerker"}),
	    "Es gibt viele Handwerker in Luifinlas."); 

  AddDetail( ({"lesen"}),
	    "Liegt Dir nicht besonders."); 

  AddDetail( ({"lust"}),
	    "Du hast immer Lust."); 

  AddDetail( ({""}),
	    ""); 

  AddDetail( ({""}),
	    ""); 

  AddDetail( ({""}),
	    ""); 

  AddDetail( ({""}),
	    ""); 

  AddDetail( ({""}),
	    ""); 

  AddDetail( ({""}),
	    ""); 

  AddDetail( ({""}),
	    ""); 

  AddDetail( ({""}),
	    ""); 

  AddDetail( ({""}),
	    ""); 

  AddDetail( ({""}),
	    ""); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Putzmitteln.");  

  AddSmell( ({"putzmitteln","putzmittel"}),
	   "Hier wird anscheinend oft sauber gemacht.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Knistern von Papier.");

  AddSound( ({"papier","knistern"}),
	   "Das Knistern kommt aus dem Arbeitsbereich, wo die Briefe sortiert "
	   "werden.");
           
//-----Details Ende-----

  AddExit("sueden", ROOM "luifinlas12"); 
  
  AddCmd("post","do_mail");
  AddCmd("mail","do_mail");
 
  SetProp(P_INDOORS,1);

  if (!argh) {
    for (i=0;i<NRCABINS;++i) AddItem(MAILCABIN,REFRESH_REMOVE);
  }
}

do_mail(str) {
  object mailer;
  if (this_interactive()!=this_player()) return 0;
  mailer=clone_object(MAILER);
  mailer->SetOfficeName(short());
  mailer->do_mail(str);
  return 1;
}

