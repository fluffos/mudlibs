// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem dunklen Wald");
  SetProp( P_INT_LONG,
	"Es ist stockdunkel an dieser Stelle des Waldes und die Kaelte, die "
	"hier herrscht ist auch nicht angenehm. Die langen Aeste scheinen "
	"nach Dir zu greifen und auch die grossen Wurzeln, die ueber den "
	"Weg wachsen scheinen es auf Dich abgesehen zu haben." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 0 );

//-----Details Anfang-----
  
  AddDetail( ({"stelle","nacht"}),
	    "Es herrscht Nacht an dieser Stelle im Wald.");

  AddDetail( ({"wald","waldes"}),
	    "Du bist tief in einem dunklen Wald.");
  
  AddDetail( ({"kaelte"}),
	    "Es ist kalt hier und Du hoffst bald wieder in schoenere Gegenden "
	    "zu gelangen.");

  AddDetail( ({"aeste"}), 
            "Die Aeste, die von den Baeumen haengen scheinen nach Dir zu "
	    "greifen. Du fuehlst Dich nicht sehr wohl hier.");

  AddDetail( ({"wurzeln"}),
	    "Einige Wurzeln wachsen hier ueber den Weg. Pass auf, dass sie "
	    "Dich nicht packen.");

  AddDetail( ({"weg","steinchen"}),
	    "Der Weg besteht aus kleinen Steinchen und einige Wurzeln sind "
	    "ueber den Weg gewachsen.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit kleinen unbedeutenden Steinchen bedeckt.");
  
  AddDetail( ({"himmel"}),
	    "Himmel, was ist das? Hier siehst Du keinen Himmel.");

  AddDetail( ({"gegenden"}),
	    "Damit ist nicht hier gemeint.");
  
  AddDetail( ({"baeumen","baeume","mauer"}),
	    "Die Baeume bilden eine unueberwindliche Mauer. Du kannst nur nach "
	    "Norden oder Suedwesten gehen.");

  AddDetail( ({"norden"}), 
            "Im Norden ist es genau so dunkel.");

  AddDetail( ({"suedwesten"}),
	    "Im Suedwesten scheint es heller zu sein.");

  AddDetail( ({"dunkelheit"}),
	    "Hier ist es nicht hell.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig modrig in der Dunkelheit.");  

  AddSound(DEFAULT_SOUND, "Du hoerst gar nichts.");

//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas91");
AddExit("suedwesten", ROOM "luifinlas93");

}

