// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Wiese");
  SetProp( P_INT_LONG,
	"Die Wiese erstreckt sich weit nach Sueden. Nach Nordwesten kommt man "
	"in ein kleines Dorf, welches aus Huegeln besteht, in denen die "
	"Hobbits ihre Hoehlen gebaut haben. Die Huegel sind wie die Wiese mit "
	"Gras bewachsen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wiese"}),
	    "Die Wiese ist mit Gras bewachsen. Genau so woe die Huegel des "
	    "Dorfes. Sie erstreckt sich von hier weit nach Sueden.");

  AddDetail( ({"sueden"}),
	    "Im Sueden geht die Wiese weiter. In weiter Entfernung kannst Du "
	    "den Waldrand im Sueden sehen.");
  
  AddDetail( ({"nordwesten"}),
	    "Wenn Du nach Nordwesten gehst, dann kannst Du das Dorf betreten.");

  AddDetail( ({"dorf","dorfes","hubbleton"}), 
            "Das Dorf, dass vor Dir liegt, heisst Hubbleton und ihn ihm wohnen "
	    "nur Hobbits. Es ist ein sehr kleines, aber dafuer feines Dorf.");

  AddDetail( ({"huegel","huegeln"}),
	    "Die Huegel sind mit Gras bewachsen. Aus dem ein oder anderen "
	    "Huegel siehst Du Rauch aufsteigen. Anscheindend wird da gerade "
	    "gekocht. In den Huegeln haben die Hobbits ihre Hoehlen.");

  AddDetail( ({"hobbits"}),
	    "Die Hobbits sind eine der vielen Rassen hier im Silberland.");

  AddDetail( ({"hoehlen"}),
	    "Die Hoehlen unter den Huegeln werden von den Hobbits bewohnt. Es "
	    "soll recht wohnlich in ihnen sein.");
  
  AddDetail( ({"gras"}),
	    "Viel Gras waechst auf den Wiesen. Hier ist das Gras anscheinend "
	    "gemaeht worden. Im Sueden ist das Gras deutlich hoeher als hier.");

  AddDetail( ({"boden","weg","weges"}),
	    "Der Boden des Weges, auf dem Du stehst ist mit kleinen Steinchen "
	    "bedeckt.");
  
  AddDetail( ({"entfernung","waldrand","rand","wald"}),
	    "In weiter Entfernung kannst Du den Wald sehen. Um mehr zu "
	    "erkennen, musst Du schon naeher ran gehen.");

  AddDetail( ({"rassen"}), 
            "Es gibt viele Rassen im Silberland. Die Hobbits sind nur eine von "
	    "vielen.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland.");

  AddDetail( ({"steinchen"}),
	    "Kleine Steinchen bilden den Weg.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ueber Dir ist blau.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig nach Rauch.");  
 
  AddSmell( ({"rauch"}),
	   "Der Rauch kommt aus den Hoehlen der Hobbits, die anscheinend "
	   "gerade kochen.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Hobbits im Dorf.");

  AddSound( ({"hobbits","dorf"}),
	   "Du kannst nicht viel verstehen. Du musst wohl naeher ran gehen.");
  
//-----Details Ende-----
  
AddExit("nordwesten", ROOM "luifinlas103");
AddExit("sueden", ROOM "luifhd6");

}
