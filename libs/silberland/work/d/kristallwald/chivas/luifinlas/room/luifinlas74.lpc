// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Strasse in Luifinlas");
  SetProp( P_INT_LONG,
	"Die Strasse schlaengelt sich durch die Stadt. Im Nordwesten liegt "
	"der Mittelpunkt der Stadt. Nach Sueden geht die Strasse weiter in die "
	"Wohngebiete der Einwohner. Im Osten und Suedosten scheinen zwei "
	"interessante Geschaefte zu sein." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"strasse"}),
	    "Du stehst in einer der zahllosen Strassen von Luifinlas.");

  AddDetail( ({"stadt","luifinlas"}),
	    "Du bist in einer Stadt, die Luifinlas heisst.");
  
  AddDetail( ({"nordwesten","mittelpunkt"}),
	    "Nach Nordwesten geht es sicher zum Mittelpunkt der Stadt.");

  AddDetail( ({"sueden","wohngebiete","einwohner"}), 
            "Nach Sueden scheint man in die Wohngebiete von Luifinlas zu "
	    "kommen.");

  AddDetail( ({"osten","fleischerei","wuerstchen","dinge"}),
	    "Im Osten ist eine Fleischerei, wo man Wuerstchen und andere "
	    "Dinge kaufen kann.");

  AddDetail( ({"suedosten","laden","sachen"}),
	    "Im Suedosten ist ein normaler Laden, wo Du Sachen kaufen und "
	    "verkaufen kannst.");

  AddDetail( ({"geschaefte"}),
	    "Im Osten ist eine Fleischerei und im Suedosten ein normaler "
	    "kleiner Laden.");
  
  AddDetail( ({"boden"}),
	    "Der Boden der Strasse ist gepflastert.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ueber Luifinlas ist herrlich blau.");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst Wuerstchen.");  
 
  AddSmell( ({"wuerstchen","duft"}),
	   "Der Duft nach Wuerstchen kommt aus dem Osten.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Kinder schreien.");

  AddSound( ({"horde","kinder"}),
	   "Eine Horde Kinder laeuft schreient und lachend an Dir die Strasse "
	   "hinunter vorbei.");
  
//-----Details Ende-----
  
AddExit("suedosten", ROOM "luifladen1");
AddExit("osten", ROOM "luiffleisch");
AddExit("nordwesten", ROOM "luifinlas78");
AddExit("sueden", ROOM "luifinlas70");

}
