// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Waldweg");
  SetProp( P_INT_LONG,
	"Der Wald ist recht duester und kaum ein Sonnenstrahl dringt durch "
	"das dichte Blaetterdach ueber Dir. Der Weg auf dem Du Dich befindest "
	"schlaengelt sich durch die dicht stehenden Baeume am Rand von Osten "
	"nach Westen. Im Westen scheint eine Kreuzung zu sein." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wald"}),
	    "Der Wald in dem Du stehst erstreckt sich weiter nach Osten. Er "
	    "ist sehr dunkel, da die Baeume sehr dicht am Weg sehen und ihr "
	    "Blaetterdach kaum Sonnenstrahlen durchlassen.");

  AddDetail( ({"sonnenstrahl","himmel","strahl","sonnenstrahlen","strahlen"}),
	    "Es treffen kaum Sonnenstrahlen den Boden, da das Blaetterdach "
	    "sehr dicht ist. Dementsprechend kannst Du auch den Himmel nicht "
	    "sehen.");
  
  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach der grossen Baeume ist sehr dicht. Kaum ein "
	    "Sonnenstrahl kommt durch.");

  AddDetail( ({"weg"}), 
            "Der Weg zieht sich von Osten nach Westen oder anders herum. Es "
	    "kommt darauf an, von wo Du kommst.");

  AddDetail( ({"baeume","baeumen"}),
	    "Die Baeume stehen dicht am Weg und sie stehen sehr dicht. Nur ein "
	    "paar Straeucher finden zwischen ihnen Platz.");

  AddDetail( ({"rand"}),
	    "Am Rand vom Weg stehen grosse Baeume und ein paar Straeucher.");

  AddDetail( ({"osten"}),
	    "Im Osten fuehrt der Weg weiter und der Wald ist sehr dunkel.");
  
  AddDetail( ({"westen","kreuzung"}),
	    "Im Westen ist eine Kreuzung zu sehen. Der Wald ist lichter im "
	    "Westen.");

  AddDetail( ({"boden"}),
	    "Am Boden erkennst Du Laub von den Baeumen, Aeste und kleine "
	    "Steine.");
  
  AddDetail( ({"platz"}),
	    "Es ist kaum Platz zwischen den dicht stehenden Baeumen.");

  AddDetail( ({"straeucher"}), 
            "Es sind nur ganz kleine Straeucher, die hier Platz finden. Sie "
	    "werden sicher bei dem wenigen Licht auch nicht sehr gut wachsen.");

  AddDetail( ({"laub"}),
	    "Das Laub stammt von den Baeumen und sammelt sich auf dem Weg.");

  AddDetail( ({"aeste"}),
	    "Die Aeste sind von den Baeumen gefallen und hier auf dem Weg "
	    "gelandet.");

  AddDetail( ({"steine"}),
	    "Die Steine lagen hier wohl schon immer. Sie sind nicht wichtig.");
  
  AddDetail( ({"licht"}),
	    "Es ist nicht sehr viel Licht vorhanden.");

  AddDetail( ({"zeit"}),
	    "Du hast viel Zeit.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Laub.");  
 
  AddSmell( ({"laub"}),
	   "Das Laub riecht ein wenig faulig. Es ist anscheinend schon vor "
	   "laengerer Zeit auf den Boden gefallen.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Aeste knarren.");

  AddSound( ({"aeste","geraeusch"}),
	   "Das ist ein normales Geraeusch in einem Wald.");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "luifinlas63");
AddSpecialExit( "osten", "go_osten" );

}
int go_osten(string dir)
{

  if(!(present("marlog", TO)))
  {
    write( BS( "Eine unbekannte Macht haelt Dich davon ab momentan weiter "
	       "nach Osten zu gehen.") );
    say("Eine unbekannte Macht haelt "+TP->Name(WEN)+" davon ab, "
      "nach Osten zu gehen.\n");
  return -1;
  }
}
