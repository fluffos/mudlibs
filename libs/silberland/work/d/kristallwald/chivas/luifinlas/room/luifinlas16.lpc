// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Strasse in Luifinlas");
  SetProp( P_INT_LONG,
	"Nach Westen fuehrt die Strasse auf den grossen Platz in der Mitte "
	"der Stadt. Nach Osten fuehrt die gepflasterte Strasse zum Osttor in "
	"der Stadtmauer von Luifinlas. Links und rechts der Strasse sind alle "
	"moeglichen Haeuser der Einwohner zu erkennen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"westen","platz","mitte"}),
	    "Im Westen ist der Platz von Luifinlas. Er ist die Mitte der "
	    "Stadt.");

  AddDetail( ({"stadt","luifinlas"}),
	    "Du bist in Luifinlas. Luifinlas ist eine grosse Stadt.");
  
  AddDetail( ({"osten"}),
	    "Im Osten fuehrt die Strasse weiter.");

  AddDetail( ({"strasse"}), 
            "Die Strasse ist gepflastert und fuehrt entweder nach Osten oder "
	    "Westen.");

  AddDetail( ({"osttor","tor"}),
	    "Im Osten muss das Osttor der Stadt sein.");

  AddDetail( ({"stadtmauer","mauer"}),
	    "Die Stadtmauer ist auch weit im Osten. Geh einfach mal hin.");

  AddDetail( ({"haeuser","einwohner","haeusern"}),
	    "In den Haeusern wohnen die Einwohner von Luifinlas.");
  
  AddDetail( ({"boden"}),
	    "Der Boden besteht aus grossen Steinen. Die Strasse ist "
	    "gepflastert.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau.");
  
  AddDetail( ({"steine","steinen"}),
	    "Die Steine sind nicht sehr interessant.");

  AddDetail( ({""}), 
            "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Stadt.");  
 
  AddSmell( ({"stadt","gerueche"}),
	   "Viele Gerueche riechst Du in der Stadt.");

  AddSound(DEFAULT_SOUND, "Du hoerst viele Leute in der Stadt.");

  AddSound( ({"leute","stadt"}),
	   "Du willst doch niemanden belauschen?");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "luifinlas15");
AddExit("osten", ROOM "luifinlas17");


}
