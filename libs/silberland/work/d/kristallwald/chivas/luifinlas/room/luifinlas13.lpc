// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Strasse in Luifinlas");
  SetProp( P_INT_LONG,
	"Du stehst auf einer gepflasterten Strasse, die von Westen kommend "
	"nach Osten in die Mitte der Stadt führt. Die Haeuser "
	"in der Strasse machen einen gepflegten Eindruck auf Dich. Das Haus "
	"im Norden hat neben der Tuer ein grosses Loch in der Wand und wirkt "
	"dadurch ein wenig merkwuerdig. Ueber dem Haus im Sueden haengt ein "
	"grosses Schild." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"strasse","boden"}),
	    "Die Strasse ist geplastert und geht von Westen nach Osten.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen und gefaellt Dir.");


  AddDetail( ({"westen","osten"}),
	    "Man kann auf der Strasse nach Osten und nach Westen gehen.");
  
  AddDetail( ({"mitte"}),
	    "Die Mitte der Stadt liegt im Osten. Geh einfach hin und schau "
	    "Dich um.");

  AddDetail( ({"stadt","luifinlas"}), 
            "Du befindest Dich in der interessanten Stadt Luifinlas.");

  AddDetail( ({"haeuser"}),
	    "Es gibt viele interessante Haeuser hier in Luifinlas. Ein "
	    "interessantes Haus ist im Norden und eines im Sueden.");

  AddDetail( ({"eindruck"}),
	    "In diesem Teil der Stadt achten die Bewohner sehr auf ihre "
	    "Haeuser.");

  AddDetail( ({"haus","hauses"}),
	    "Welches Haus meinst Du? Das Haus im Sueden oder das Haus im "
	    "Norden?");
    
  AddDetail( ({"tuer"}),
	    "Neben der Tuer vom Haus im Norden ist ein grosses Loch in der "
	    "Wand und ein wenig Qualm quellt daraus hervor.");

  AddDetail( ({"loch","wand"}),
	    "Das Loch ist ungefaehr so gross wie ein kleiner Troll und sieht "
	    "aus, als ob es durch eine Explosion entstanden ist, die im Inneren "
	    "des Hauses geschehen ist.");
  
  AddDetail( ({"haus im norden","norden"}),
	    "Das Haus im Norden ist eigentlich ein huebsches Haus. Es hat jedoch ein "
	    "Loch in der Wand, was es ein wenig merkwuerdig aussehen laesst.");

  AddDetail( ({"haus im sueden","sueden"}), 
            "Das Haus im Sueden ist rot angemalt und ein grosses Schild haengt am "
	    "Eingang. Des weiteren hat das Haus einen grossen Turm.");

  AddDetail( ({"schild"}),
	    "Du kannst das Schild lesen");

  AddDetail( ({"teil","stadtteile","stadtteil"}),
	    "Es gibt in Luifinlas gut gepflegte Stadtteile, aber auch welche "
	    "in denen Du Dich besser nicht rumtreiben solltest.");

  AddDetail( ({"qualm","schwaden"}),
	    "Der Qualm quillt in großen Schwaden aus dem Loch in der Wand.");
  
  AddDetail( ({"inneren","innere"}),
	    "Um das Innere zu sehen und zu klaeren was genau passiert ist, musst "
	    "Du wohl das Haus betreten.");

  AddDetail( ({"explosion","folgen","dank"}),
	    "Die Explosion ist Woody sei Dank nicht mehr zu sehen. Nur noch die "
	    "Folgen kann man erkennen.");
  
  AddDetail( ({"bewohner"}),
	    "Luifinlas hat viele Bewohner.");
  
  AddDetail( ({"woody","beistand"}),
	    "Gepriesen sei Woody. Du kniest Dich ploetzlich hin und bittest Woody "
	    "um seinen Beistand.");

  AddDetail( ({"eingang"}), 
            "Du kannst in das Haus im Sueden ruhig gehen.");

  AddDetail( ({"turm"}),
	    "Der Turm ist wirklich hoch und am Turmende erkennst Du Etwas.");

  AddDetail( ({"turmende","etwas","glocke"}),
	    "Am Turmende haengt eine grosse Glocke. Wann die wohl geleutet wird.");

  AddDetail( ({"feuerwehr"}),
	    "Jede Stadt braucht eine gute Feuerwehr. Wenn man das Loch gegenueber "
	    "sieht, macht das sicher Sinn.");
  
  AddDetail( ({"sinn"}),
	    "Sinn oder Unsinn, das ist hier die Frage.");

  AddDetail( ({"frage","fragen"}),
	    "Fragen ueber Fragen, wenn das bei Dir so ist, dann forsch gefaelligst "
	    "mehr und finde was heraus.");
  
  AddDetail( ({"unsinn","menge"}),
	    "Ja, Du machst eine Menge Unsinn.");

  AddDetail( ({"troll"}),
	    "Ein Troll koennte durch das Loch gehen, aber Du benutzt eher die Tuer.");


  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

   AddReadDetail( ({"schild"}),
	    "+--------------------------------------+\n"
	    "|                                      |\n"
	    "|                Feuerwehr             |\n"
	    "|                                      |\n"
	    "+--------------------------------------+\n");


  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig verbrannt. Irgendwie nach Qualm.");  
 
  AddSmell( ({"qualm","geruch"}),
	   "Der Geruch kommt von dem Qualm der aus dem Loch in der Wand im Norden "
	   "kommt.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Geraeusche einer Stadt.");

  AddSound( ({"geraeusche","stadt"}),
	   "Wie eine Stadt halt so klingt.");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "luifinlas12");
AddExit("osten", ROOM "luifinlas14");
AddExit("norden", ROOM "luifwiss");
AddExit("sueden", ROOM "luiffeuer");

}
