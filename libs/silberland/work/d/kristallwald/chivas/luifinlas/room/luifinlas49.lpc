// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl = 1;

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Die Baeume stehen links und rechts des Weges und es ist angenehm im "
	"Schatten der Baeume spazieren zu gehen. Ein paar kleine Blumen stehen "
	"direkt neben den Baeumen. Auch ein paar Pilze kannst Du erkennen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"baeume","baeumen"}),
	    "Die Baeume sind grosse Laubbaeume, die am Wegrand stehen. Auch "
	    "ein paar Fichten und Tannen sind zu sehen.");

  AddDetail( ({"weges","weg","norden","sueden"}),
	    "Der Weg fuehrt Dich von Norden nach Sueden oder von Sueden nach "
	    "Norden. Es kommt ganz darauf an, von wo Du kommst.");
  
  AddDetail( ({"schatten"}),
	    "Der Schatten tut sehr gut. Kaum ein Lichtstrahl dringt durch das "
	    "dichte Blaetterdach ueber Dir.");

  AddDetail( ({"blumen"}), 
            "Du erkennst kleine rote Blumen. Du kennst sie leider nicht, aber "
	    "sie sehen sehr schoen aus. Vielleicht kannst Du eine pfluecken "
	    "und mitnehmen.");

  AddDetail( ({"pilze"}),
	    "Die Pilze sind leider alle giftig. Du bist enttaeuscht.");

  AddDetail( ({"boden"}),
	    "Am Boden liegt viel Laub von den Baeumen und viele kleine "
	    "Steine.");

  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand stehen viele Baeume, wie in einem Wald ueblich.");
  
  AddDetail( ({"fichten"}),
	    "Ein paar Fichten stehen hier auch.");

  AddDetail( ({"tannen"}),
	    "Einige Tannen kannst Du erkennen.");
  
  AddDetail( ({"laubbaeume","stelle","ueberzahl"}),
	    "Die Laubbaeume sind in der Ueberzahl an dieser Stelle.");

  AddDetail( ({"lichtstrahl","strahl"}), 
            "Nur wenige Lichtstrahlen treffen den Boden.");

  AddDetail( ({"blaetterdach"}),
	    "Das Blaetterdach bietet viel Schatten.");

  AddDetail( ({"laub"}),
	    "Viel Laub von den Baeumen liegt auf dem Weg.");

  AddDetail( ({"steine"}),
	    "Kleine unbedeutende Steine liegen am Boden.");
  
  AddDetail( ({"wald"}),
	    "Du bist in einem Wald.");

  AddDetail( ({"himmel","blaetterdach","dach"}),
	    "Der Himmel ist durch das dichte Blaetterdach der Baeume "
	    "verdeckt.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen am Wegrand duften sehr gut.");

  AddSound(DEFAULT_SOUND, "Du hoerst viele Voegel.");

  AddSound( ({"voegel"}),
	   "*tschip*");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas48");
AddExit("sueden", ROOM "luifinlas50");

AddCmd( ({"pflueck", "pfluecke" }), "pfluecken" );

}

int pfluecken(string str)
{
  object blume;
  notify_fail( "Was willst Du denn pfluecken?\n" );
  if ( member( ({ "blume", "rote blume" }), str ) != -1 ) 

   {
     if( anzahl < 1 )
     {
        write("Du willst eigentlich eine Blume pfluecken, entscheidest Dich \n"
	      "jedoch dagegen, da Du erkennst, dass hier bereits eine \n"
	      "gepflueckt wurde und Du willst die restlichen Blumen lieber \n"
	      "stehen lassen.\n");
        say(sprintf("%s tut nichts.\n", TP->Name(WER)));
        return -1;
     }
      if ( present("blume",TP) )
      {
      write("Du hast schon eine Blume und willst keine weitere.\n" );
      say(sprintf("%s tut nichts sondern macht nur Bloedsinn.\n", TP->Name(WER)));
      return -1;
      }
      else
      {
        {blume = clone_object( OBJ "blume");
        if ( ME_TOO_HEAVY == blume->move(TP,M_GET|M_SILENT) )

          {
          write(
          "Die Blume wuerde Dir zu schwer werden. Du Weichei.\n" );
          say(BS(sprintf("%s ist einfach zu weich fuer das Silberland.\n", TP->Name(WER))));
          blume -> remove();
          return 1;
          }
          else
          {
          write("Du pflueckst die Blume und steckst sie ein.\n");
          say(sprintf("%s pflueckt eine Blume und steckt sie ein.\n",
          TP->Name(WER)));
          anzahl--;
          return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}
