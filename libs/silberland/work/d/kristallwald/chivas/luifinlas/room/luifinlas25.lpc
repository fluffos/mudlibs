// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Am Nordtor von Luifinlas");
  SetProp( P_INT_LONG,
	"Du stehst genau unter der Stadtmauer im Tor von Luifinlas. Das grosse "
	"Tor ist verschlossen und versperrt Dir das Weitergehen nach Norden. "
	"Auf der linken und rechten Seite siehst Du die grossen Steinquader, "
	"die die Stadtmauer bilden." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"stadtmauer","mauer"}),
	    "Du bist genau im Tor der Stadtmauer. Die grossen Steinquader "
	    "der grossen breiten Stadtmauer sind direkt neben Dir zu "
	    "sehen.");

  AddDetail( ({"tor"}),
	    "Das Tor ist mit Eisen beschlagen und besteht aus dicken "
	    "Eichenbohlen. Es ist momentan geschlossen und Du wirst es "
	    "sicher nicht oeffnen koennen.");
  
  AddDetail( ({"luifinlas"}),
	    "Du bist in Luifinlas.");

  AddDetail( ({"weitergehen","norden"}), 
            "Du kannst momentan nicht nach Norden gehen.");

  AddDetail( ({"seite"}),
	    "Auf beiden Seiten siehst Du die grossen Steinquader der "
	    "Stadtmauer.");

  AddDetail( ({"steinquader"}),
	    "Dicke und schwere Steinquader bilden die Stadtmauer von "
	    "Luifinlas.");

  AddDetail( ({"boden","pflaster","strasse"}),
	    "Der Boden der Strasse ist gepflastert.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ueber Dir ist blau.");

  AddDetail( ({"eisen"}),
	    "Das Eisen verstaerkt das Tor. Es ist sicher schwer dieses "
	    "Tor zu zerstoeren.");
  
  AddDetail( ({"eichenbohlen","bohlen"}),
	    "Die dicken Eichenbohlen halten so manchen Angriff ab. Das "
	    "Tor ist sehr stabil.");

  AddDetail( ({"angriff","eindruck"}), 
            "Obwohl das Tor und die Mauer einen sicheren Eindruck "
	    "machen, willst Du doch nicht bei einem Angriff hier sein.");

  AddDetail( ({"nase"}),
	    "Du hast eine besonders grosse Nase.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst die Stadt.");  
 
  AddSmell( ({"stadt"}),
	   "Dir steigen die unterschiedlichsten Gerueche der Stadt in die "
	   "Nase.");

  AddSmell( ({"gerueche"}),
	   "Es sind alle moeglichen Gerueche.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Laerm der Stadt.");

  AddSound( ({"laerm"}),
	   "Um besser zu hoeren, was los ist, musst Du schon weiter "
	   "in die Stadt hinein gehen.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "luifinlas24");

}

