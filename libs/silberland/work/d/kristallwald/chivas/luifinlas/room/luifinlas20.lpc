// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Am Osttor von Luifinlas");
  SetProp( P_INT_LONG,
	"Du stehst im Durchgang des Osttores von Luifinlas. Das Tor vor Dir "
	"ist geschlossen und es ist hier recht dunkel, da nur von einer Seite "
	"Licht in den Durchgang dringt. Der Durchgang durch die Stadtmauer "
	"bietet Dir einen guten Blick auf die dicken Steinquader der Mauer." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"durchgang"}),
	    "Du bist in einem Durchgang durch die Stadtmauer.");

  AddDetail( ({"osttores","osttor","tor"}),
	    "Das Osttor besteht aus Holz und Eisen. Es ist momentan "
	    "geschlossen.");
  
  AddDetail( ({"seite","licht"}),
	    "Es dringt nur Licht aus Westen in den Durchgang, da momentan das "
	    "Tor geschlossen ist.");

  AddDetail( ({"stadtmauer","mauer"}), 
            "Du bist in einem Durchgang durch die Stadtmauer.");

  AddDetail( ({"blick"}),
	    "Du kannst Dir die Mauer von hier aus gut ansehen.");

  AddDetail( ({"steinquader"}),
	    "Die grossen Steinquader bilden die Stadtmauer und halten sicher "
	    "gut stand bei einem Angriff.");

  AddDetail( ({"boden"}),
	    "Der Boden ist gepflastert.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist von hier nicht zu sehen.");

  AddDetail( ({"angriff"}),
	    "Einen Angriff willst Du trotzdem nicht erleben.");
  
  AddDetail( ({"holz"}),
	    "Das Holz wirkt sehr stabil.");

  AddDetail( ({"eisen"}),
	    "Das Eisen verstaerkt das Tor erheblich.");

  AddDetail( ({"luifinlas","stadt"}),
	    "Luifinlas ist eine grosse Stadt.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht hier ein wenig modrig.");  

  AddSound(DEFAULT_SOUND, "Die Geraeusche der Stadt sind hier ein wenig "
		  "gedaempft.");

  AddSound( ({"geraeusche","stadt","geraeuschen"}),
	   "Du hoerst nicht ganz so gut hier. Die Stadtmauer schirmt Dich vor "
	   "den Geraeuschen ab.");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "luifinlas19");

}
