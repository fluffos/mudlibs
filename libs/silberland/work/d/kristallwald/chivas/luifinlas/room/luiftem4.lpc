inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

SetProp(P_INT_SHORT,"In einem Tempel in Luifinlas");
SetProp(P_INT_LONG,
   "Du bist hier in einem der ganz seltenen Tempel. Ein paar "
		    "verwirrte Priester beten hier Angrox an. Ueberall an den "
		    "Waenden haengen Gemaelde des Zwerges, der ein Erzmagier "
		    "im Silberland ist. An der Nordwand steht ausserdem ein "
		    "grosser Altar mit lauter Kerzen.");
SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
SetProp(P_INDOORS, 1);
SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
 
  AddDetail( ({"tempel"}),
	    "Du bist im Tempel des Angrox.");

  AddDetail( ({"priester"}), 
            "Die Priester, die Angrox anbeten sind sicher ein wenig verwirrt.");

  AddDetail( ({"angrox"}), 
" _____________________________________________________________________________\n"
"(    Papa Lamuerte und Angrox und die lange Nacht der Mudprogrammiererei     ()"
"|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~|\n"
"| Er ist seit  7. Nov 2008, 08:45 Uhr anwesend. (Idle: 00:02:46)             |\n"
"| Er kommt von shell.idle.at (88.198.77.195) [Muenchen (ueber Unbekannt)].   |\n"
"|                                                                            |\n"
"| Rasse: Zwerg,  Magierstufe: 66,  Gildenerzmagier                           |\n"
"| Gilde: Druidenzirkel,  Gildenstufe: 15,  Gesinnung: .                      |\n"
"| Alter: 2331d 13:46:48,  Geboren am Mit,  8. Mai 1996, 14:50 Uhr.           |\n"
"| Gestorben: 65 mal!                                                         |\n"
"| PLAYERKILLS: 2 !!!                                                         |\n"
"|                                                                            |\n"
"| E-Mail: angrox@sl.mud.at,  ICQ: 37043021, Skype: angrox2                   |\n"
"| Er hat seine Post zuletzt gelesen am: Mon,  6. Aug 2007, 19:19 Uhr.        |\n"
"| Homepage: http://www.idle.at                                               |\n"
"|                                                                            |\n"
"| Er ist Sohn von Creative und Vater von Azrael, Thor, Embee, Cirion,        |\n"
"|   Xorgan, Banshee, Iwo, Koomi, Buzzom, Angel, Libella, Delgo und Arc.      |\n"
"| Regionsmagier von     : Event, Gebirge.                                    |\n"
"| Regionsmitarbeiter von: Gebirge, Huegelland, Seher, Wasser.                |\n"
"|                         Magic Items, Sheriff                               |\n"
"|___________________________________________________________________________ |\n"
"\___________________________________________________________________________\/\n"
"                                                                             \n"
"Du kannst ihn jederzeit per Mail oder 'teile angrox mit xxx' erreichen. "
"Schick ihm ruhig ein paar Nachrichten.");

  AddDetail( ({"wand","waende","waenden"}),
	    "An den Waenden haengen lauter Gemaelde von Angrox.");

  AddDetail( ({"gemaelde","oel","seiten"}),
	    "Alle Gemaelde sind in Oel gemalt und zeigen Angrox. Er grinst Dir von "
	    "allen Seiten entgegen. Du bekommst eine Gaensehaut und Du fuerchtest "
	    "Dich ein wenig.");

  AddDetail( ({"zwerges","zwerg"}), 
            "Angrox war mal ein stolzer Zwerg.");

  AddDetail( ({"erzmagier"}), 
            "Angrox ist jetzt einer dieser faulen Erzmagier. Dies wuerde ich hier "
	    "im Tempel aber nicht erwaehnen.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland.");

  AddDetail( ({"nordwand"}),
	    "An der Nordwand ist ein grosser Altar zu sehen.");

  AddDetail( ({"altar","wort"}), 
            "Der Altar besteht aus Granit und auf ihm ist ueberall das Wort Angrox "
	    "eingraviert. Ausserdem stehen auf ihm viele Kerzen und einige "
	    "Raeucherstaebchen sind zu sehen.");

  AddDetail( ({"kerzen"}), 
            "Die roten Kerzen brennen und erhellen den Tempel ein wenig.");

  AddDetail( ({"boden"}),
	    "Der Boden besteht aus grossen Steinplatten.");

  AddDetail( ({"decke"}),
	    "Die Decke ist zu hoch, als das Du sie sehen koenntest.");

  AddDetail( ({"gaensehaut"}), 
            "Du solltest keinem erzaehlen, dass Du eine bekommen hast.");

  AddDetail( ({"granit","stein"}), 
            "Granit ist ein harter Stein.");

  AddDetail( ({"raeucherstaebchen"}),
	    "Die Raeucherstaebchen qualmen vor sich hin.");

  AddDetail( ({"steinplatten","platten"}),
	    "Selbst in die Steinplatten ist das Bildnis von Angrox graviert. Du "
	    "bekommst wirklich Angst.");

  AddDetail( ({"angst"}), 
            "Du fuerchtest Dich sonst vor nichts.");

  AddDetail( ({"bildnis"}), 
            "Angrox grinst Dich sogar vom Boden aus an.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","es","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Raeucherstaebchen.");  
 
  AddSmell( ({"raeucherstaebchen"}),
	   "Dir wird schlecht.");

  AddSound(DEFAULT_SOUND, "Es ist sehr still.");

//-----Details Ende-----

AddExit("sueden", ROOM "luifinlas18");

AddCmd( ({"bete","bete"}), "beten" );

}
int beten() {
   write("Du haeltst eine kurzes Gebet.\n");
   if (this_player()->QueryProp(P_GHOST))
   {
	write(BS("Eine sehr starke Kraft durchfliesst Dich und gibt Dir wieder Kraft.\n"));
	say(this_player()->name()+" erscheint in koerperlicher Form.\n");
	this_player()->SetProp(P_GHOST,0);
   }
   return 1;
}


