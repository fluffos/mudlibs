// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Waldweg");
  SetProp( P_INT_LONG,
	"Die Baeume stehen hier weit auseinander am ansteigenden Weg, der "
	"nach oben in steiniges und baumloses Gelaende zu fuehren scheint. "
	"Nach Suedosten geht es in einen dunklen Wald hinein." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"baeume","platz","vergleich"}),
	    "Die Baeume nehmen im Vergleich zum Suedosten stark ab und sie "
	    "stehen auch nicht mehr so dicht beieinander. Sie geben Dir genug "
	    "Platz um auf dem Weg zu gehen.");

  AddDetail( ({"weg","westoben","suedostunten"}),
	    "Der Weg fuehrt entweder nach Westoben oder nach Suedostunten.");
  
  AddDetail( ({"gelaende","westen"}),
	    "Das Gelaende im Westen scheint steiniger und baumloser zu "
	    "werden.");

  AddDetail( ({"suedosten"}), 
            "Im Suedosten scheint der Wald sehr dicht zu sein.");

  AddDetail( ({"wald"}),
	    "Du bist auf einem Weg im Wald.");

  AddDetail( ({"boden"}),
	    "Der Boden ist unter Dir.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau.");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht waldig.");  

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel zwitschern.");

  AddSound( ({"voegel"}),
	   "*zwitscher*");
  
//-----Details Ende-----
  
AddExit("westoben", ROOM "luifinlas99");
AddExit("suedostunten", ROOM "luifinlas97");

}

