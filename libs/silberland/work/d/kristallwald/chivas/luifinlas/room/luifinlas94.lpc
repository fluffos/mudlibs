// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem dunklen Wald");
  SetProp( P_INT_LONG,
	"Der Wald um Dich herum ist sehr dicht und die Baeume und das "
	"Blaetterdach bilden einen dunklen Tunnel ueber dem Weg, auf dem Du "
	"stehst. Die ganze Umgebung wirkt sehr gefaehrlich und man fuehlt "
	"sich hier nicht wohl." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wald","waldes"}),
	    "Der Wald steht sehr dicht am Weg und ist irgendwie nicht "
	    "freundlich.");

  AddDetail( ({"baeume","baeumen"}),
	    "Die Baeume stehen so dicht, so dass Du den Weg nicht verlassen "
	    "kannst.");
  
  AddDetail( ({"blaetterdach","dach","grad","teilen"}),
	    "Das dichte Blaetterdach haelt das Licht ab und es ist wirklich "
	    "dunkel hier und auch ein paar Grad kaelter als in anderen Teilen "
	    "des Waldes.");

  AddDetail( ({"tunnel"}), 
            "Es wirkt hier wie in einem Tunnel, da der Wald so dicht ist. "
	    "Natuerlich bist Du nicht in einem Tunnel.");

  AddDetail( ({"weg","norden","sueden"}),
	    "Der Weg fuehrt durch diesen Tunnel nach Norden und nach Sueden.");

  AddDetail( ({"umgebung"}),
	    "Die Umgebung hier im Wald wirkt irgendwie feindlich auf Dich.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen kleine Steinchen und einige Blaetter und Aeste.");
  
  AddDetail( ({"himmel"}),
	    "Du wuerdest gerne den Himmel sehen.");

  AddDetail( ({"licht"}),
	    "Hier gibt es kaum Licht.");
  
  AddDetail( ({"steinchen"}),
	    "Die Steinchen sind nicht interessant.");

  AddDetail( ({"blaetter"}), 
            "Die Blaetter sind von den Baeumen herunter auf den Weg gefallen.");

  AddDetail( ({"aeste","finger"}),
	    "Die abgestorbenen Aeste, die aussehen wie Finger, stammen von den "
	    "Baeumen.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht modrig hier im Wald.");  
 
  AddSmell( ({"wald"}),
	   "Es riecht modrig und verschimmelt hier im Wald.");

  AddSound(DEFAULT_SOUND, "Es herrscht Totenstille.");

  AddSound( ({"totenstille"}),
	   "--------------------------------");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas93");
AddExit("sueden", ROOM "luifinlas95");

}

