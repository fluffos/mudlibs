// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();
  
  SetProp( P_INT_SHORT, "Auf einer Wiese");
  SetProp( P_INT_LONG,
	"Die Wiese fuehrt nach Sueden in ein Dorf, welches aus Huegeln "
	"besteht, in die die dort ansaessigen Hobbits ihre Hoehlen gebaut "
	"haben. Hier auf der Wiese sieht man kaum Blumen, sondern "
	"hauptsaechlich Gras." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wiese"}),
	    "Die Wiese ist mit Gras bedeckt. Hier naeher am Dorf ist es kurz "
	    "gemaeht worden.");

  AddDetail( ({"sueden","dorf","hubbleton"}),
	    "Im Sueden ist das Dorf Hubbleton. Ein Dorf, was ausschliesslich "
	    "von Hobbits bewohnt wird.");
  
  AddDetail( ({"huegel","huegeln"}),
	    "Die Huegel sind wie die Wiese mit kurzem Gras bewachsen. In ihnen "
	    "haben die Hobbits ihre Hoehlen.");

  AddDetail( ({"hobbits"}), 
            "Die Hobbits wohnen in dem Dorf im Sueden.");

  AddDetail( ({"hoehlen"}),
	    "Die Hoehlen der Hobbits sollen recht wohnlich sein.");

  AddDetail( ({"blumen"}),
	    "Nur ein paar Gaensebluemchen stehen auf der Wiese.");

  AddDetail( ({"gras"}),
	    "Das Gras ist kurz gemaeht und sieht hier naeher am Dorf sehr "
	    "gepflegt aus.");
  
  AddDetail( ({"boden"}),
	    "Der Boden des Weges auf dem Du Dich befindest ist mit Steinchen "
	    "bedeckt.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau und ein grosser Adler ist zu sehen.");
  
  AddDetail( ({"weges","weg"}),
	    "Der Weg fuehrt Dich ins Dorf oder von ihm weg.");

  AddDetail( ({"steinchen"}), 
            "Die Steinchen befinden sich schon lange auf dem Weg.");

  AddDetail( ({"adler","wind","bahnen"}),
	    "Der Adler segelt im Wind und zieht seine Bahnen am Himmel. Er "
	    "sieht wirklich majestaetisch aus.");

  AddDetail( ({"gaensebluemchen","bluemchen"}),
	    "Die Gaensebluemchen sehen huebsch zwischen dem Gras aus.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Gras.");  
 
  AddSmell( ({"gras"}),
	   "Das Gras riecht frisch gemaeht.");

  AddSound(DEFAULT_SOUND, "Du hoerst Geraeusche aus dem Dorf.");

  AddSound( ({"dorf","geraeusche"}),
	   "Dann geh einfach in das Dorf. Dann hoerst Du mehr.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas104");
AddExit("sueden", ROOM "luifinlas68");


}

