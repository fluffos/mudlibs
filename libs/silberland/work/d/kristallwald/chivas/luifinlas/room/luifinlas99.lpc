// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem steinigen Weg");
  SetProp( P_INT_LONG,
	"Der Weg fuehrt weiter nach Oben und die Baeume nehmen weiter ab. Nur "
	"ein paar kleinere Baeume und einige Straeucher wachsen hier im "
	"steinigen Boden." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"weg","oben","westoben","ostunten","weges"}),
	    "Der Weg fuehrt Dich nach Westoben oder Ostunten. Die Baeume "
	    "links und rechts des Weges nehmen deutlich ab und die karge "
	    "steinige Gegend kommt zum Vorschein.");

  AddDetail( ({"baeume"}),
	    "Die Baeume sind nicht so gross und maechtig wie weiter im Osten, "
	    "wo auch der Wald viel dichter ist.");
  
  AddDetail( ({"straeucher","beeren","straeuchern"}),
	    "Einige Straeucher wachsen auf dem steinigen Boden neben dem Weg. "
	    "Sie sehen aber ein wenig erbaermlich aus und haben kaum Blaetter "
	    "und gar keine Beeren.");

  AddDetail( ({"boden","steinchen"}), 
            "Der Boden des Weges besteht aus kleinen Steinchen und die Gegend "
	    "in der Du Dich befindest ist auch sehr steinig und hart.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist bis auf ein paar kleine Wolken blau.");

  AddDetail( ({"gegend","vorschein"}),
	    "Die Gegend ist steinig und unwirtlich.");

  AddDetail( ({"wald","osten"}),
	    "Der Wald ist weiter im Osten.");
  
  AddDetail( ({"blaetter"}),
	    "Nur ein paar Blaetter haengen an den Straeuchern. Sie sehen nicht "
	    "sehr gesund aus.");

  AddDetail( ({"wolken"}),
	    "Die Wolken sind weiss.");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach nichts.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst nur Deine Schritte.");

  AddSound( ({"schritte","steine","steinchen","steinen"}),
	   "Deine Schritte knirschen auf den Steinen am Boden.");
  
//-----Details Ende-----
  
AddExit("ostunten", ROOM "luifinlas98");
AddSpecialExit( "westoben", "go_westoben" );

}
int go_westoben(string dir)
{

  if(!(present("nuts", TO)))
  {
    write( BS( "Du willst noch nicht in diese karge Gegend vordringen.") );
    say("Eine unsichtbare Macht haelt "+TP->Name(WEN)+" davon ab, "
      "nach Westoben zu gehen.\n");
  return -1;
  }
}
