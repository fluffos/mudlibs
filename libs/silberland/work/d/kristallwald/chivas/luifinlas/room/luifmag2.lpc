// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Im Magierturm von Luifinlas");
  SetProp( P_INT_LONG,
	"Die zweite Etage ist anscheinend fuer praktische Uebungen gedacht. "
        "Es sind verschiedene Brandflecke an den Waenden, der Decke und am "
	"Boden zu sehen. In der Ecke stehen ein paar Regale und einige "
	"Tische. Ausserdem laufen ein paar kleinere komisch aussehende Tiere "
	"hier herum." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"etage"}),
	    "Du bist in der zweiten Etage des Turms der Magier in Luifinlas.");

  AddDetail( ({"uebungen"}),
	    "Hier lernen die Magier anscheinend ihre ersten Zaubersprueche um "
	    "Gegenden, Lebewesen und Gegenstaende zu erschaffen.");
  
  AddDetail( ({"brandflecke","flecke"}),
	    "Die Brandflecke deuten auf fehlgegangene Zauber hin.");

  AddDetail( ({"waende","wand","waenden"}), 
            "An den Waenden sind viele Brandflecken zu sehen. Ausserdem "
	    "siehst Du unzaehlige Tueren.");

  AddDetail( ({"decke"}),
	    "Die Decke hat auch einige Brandflecke abbekommen.");

  AddDetail( ({"boden","stein"}),
	    "Der Boden besteht aus Stein und hier sind groessere und kleinere "
	    "Brandflecke zu erkennen.");

  AddDetail( ({"ecke"}),
	    "In der Ecke stehen einige Regale und Tische.");
  
  AddDetail( ({"regale"}),
	    "Auf den Regalen stehen viele Buecher.");

  AddDetail( ({"tiere"}),
	    "Die kleinen Tiere die hier herum laufen, sehen ein wenig komisch "
	    "aus. Die Zauber haben anscheinend nicht so funktioniert, wie "
	    "sie sollten. Du erkennst eine Maus, jedenfalls sollte es wohl "
	    "eine sein, eine Ziege, die ein wenig anders aussieht und einen "
	    "dicken Frosch, soweit man von einem Frosch sprechen kann.");
  
  AddDetail( ({"turms","turm","luifinlas"}),
	    "Du bist im Turm der Magier in Luifinlas.");

  AddDetail( ({"magier","magiers"}), 
            "Hier haben die Magier ihre Bueros.");

  AddDetail( ({"zaubersprueche","zauber","sprueche","lehrlinge","zauberspruechen"}),
	    "Manche Zaubersprueche der Lehrlinge funktionieren anscheinend "
	    "nicht immer.");

  AddDetail( ({"gegend","gegenden","zeit"}),
	    "Um eine ganze Gegend zu erschaffen, muessen die jungen Magier "
	    "erst einmal eine lange Zeit ueben.");

  AddDetail( ({"lebewesen"}),
	    "Lebewesen zu erschaffen ist nicht einfach.");
  
  AddDetail( ({"gegenstaende"}),
	    "Manche Gegenstaende sehen nicht so aus, wie sie aussehen sollten. "
	    "Schau Dir mal die Tische an.");

  AddDetail( ({"tische"}),
	    "Auf den Tischen stehen verschiedene Sachen, die die jungen Magier "
	    "mit ihren Zauberspruechen erstellt haben.");
  
  AddDetail( ({"tueren","tuer"}),
	    "Die Tueren fuehren zu den Bueros der fertigen Magier. Du siehst "
	    "den Tueren kleine Schilder.");

  AddDetail( ({"buecher","zaubern","lektuere"}), 
            "Die Buecher behandeln das Zaubern und wie man alles erschafft. "
	    "Dies ist also keine Lektuere fuer Dich.");

  AddDetail( ({"maus","elefant","ruessel"}),
	    "Die kleine Maus hat einen Ruessel wie ein Elefant. Der Zauber "
	    "scheint nicht so gewollt zu sein und die Maus sieht nicht sehr "
	    "gluecklich aus.");

  AddDetail( ({"ziege","fell","schuppen","feuer"}),
	    "Die Ziege, die hier herum laeuft hat kein Fell, sondern Schuppen "
	    "und sie spukt Feuer. Es sieht fast so aus, als ob der Magier hier "
	    "einen Fehler gemacht hat.");

  AddDetail( ({"frosch","farbe","chamaeleon"}),
	    "Der Frosch sitzt auf dem Boden und sieht eigentlich ganz normal "
	    "aus, bis auf das er staendig die Farbe wechselt wie ein "
	    "Chamaeleon.");
  
  AddDetail( ({"bueros"}),
	    "Die Magier haben hier ihre Bueros.");

  AddDetail( ({"schilder","name"}),
	    "An jeder Tuer steht der Name des jeweiligen Magiers und die "
	    "Oeffnungszeiten seines Bueros.");
  
  AddDetail( ({"fehler"}),
	    "Magier machen eigentlich keine Fehler.");

  AddDetail( ({"oeffnungszeiten","tag","uhr","zeitsystem"}), 
            "Das komische ist, dass alle Oeffnungszeiten zwischen 25 und 27 "
	    "Uhr an jedem Tag liegen. Anscheinend haben die Magier ein "
	    "eigenes Zeitsystem.");

  AddDetail( ({"sachen"}),
	    "Du siehst lauter verunstaltete Sachen. Kaputte Tassen und Teller, "
	    "komisch aussehende Kerzen und andere Dinge.");

  AddDetail( ({"dinge"}),
	    "Du kannst nicht alle misslungenen Dinge der Magier hier "
	    "aufzaehlen lassen.");

  AddDetail( ({"tassen","haut","tee"}),
	    "Die Tassen haben teilweise eine schuppige Haut und scheinen zu "
	    "atmen. Du willst sicher nicht aus ihnen Deinen Tee trinken.");

  AddDetail( ({"teller","zaehne","angst"}),
	    "Die Teller haben Zaehne. Du kriegst schon ein wenig Angst.");

  AddDetail( ({"kerzen"}),
	    "Die Kerzen kichern und albern rum. Das sollten Kerzen eigentlich "
	    "nicht tun.");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht hier ein wenig angebrannt.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst ein Kichern.");

  AddSound( ({"kichern","tische"}),
	   "Das Kichern kommt von einem der Tische.");
  
//-----Details Ende-----
  
AddExit("unten", ROOM "luifmag1");
AddExit("oben", ROOM "luifmag3");
}

