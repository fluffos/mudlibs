
inherit "std/laden";

#include "../def.h"
#include <laden.h>

void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));

  SetProp(P_INT_SHORT,"In einem Laden in Luifinlas");
  SetProp(P_SHOPKEEPER_ID, "amrod");
  SetProp(P_SHOPKEEPER_NAME, "amrod");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);

  SetStorageRoom(ROOM "luiflager" );

//-----Anfang Details-----------------

  AddDetail( ({"waren","ware"}),
	    "Du kannst hier alles moegliche kaufen.");

  AddDetail( ({"decke"}),
	    "Die Decke besteht aus Holz."); 

  AddDetail( ({"boden"}),
	    "Der Boden besteht wie die Decke aus Holz.");

  AddDetail( ({"holz","waeldern","waelder"}),
	    "Es ist ganz gewoehnliches Holz aus den umliegenden Waeldern der "
	    "Stadt.");

  AddDetail( ({"kisten","ecke"}),
	    "In der Ecke stehen grosse Kisten");

  AddDetail( ({"tresen"}),
	    "Hier gehen viele Waren ueber den Tresen."); 

  AddDetail( ({"luifinlas","stadt"}),
	    "Du bist in Luifinlas."); 

  AddDetail( ({"laden","laeden"}),
	    "Du stehst in einem der vielen Laeden von Luifinlas."); 

  AddDetail( ({""}),
	    ""); 

  AddDetail( ({""}),
	    ""); 

  AddDetail( ({"regale","regalen","regal"}),
	    "In den Regalen stapeln sich die Waren.");

  AddDetail( ({"wand","waende"}),
	    "An den Waenden hinter dem Tresen stehen lauter Regale mit den "
	    "Waren.");

  AddDetail( ({"tafel","sortiment"}),
	    "Auf der Tafel sieht man was man im Laden kaufen kann. Tipp "
	    "'zeige' und Du kriegst das Sortiment angezeigt."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach allen moeglichen Dingen.");  
 
  AddSmell( ({"dinge","dingen","gerueche"}),
	   "Du kannst es nicht genau beschreiben. Zu viele Gerueche sind "
	   "hier im Laden vorhanden.");

  AddSound(DEFAULT_SOUND, "Du hoerst wie im Lager Waren gestapelt werden.");

  AddSound( ({"lager","waren"}),
	   "Anscheinend sind gerade einige Waren vom Regal gefallen. Es hat "
	   "richtig laut gescheppert.");
  
//-----Details Ende-----


  AddExit("osten", ROOM "luifinlas24");

  AddItem(NPC "amrod", REFRESH_DESTRUCT);
}

string _query_int_long()
{
  string txt;

  txt = "Du befindest Dich hier in einem Laden in Luifinlas. Unzaehlige Regale "
        "stehen hinter dem Tresen und es gibt auch viele Kisten, die in den "
	"Ecken stehen. Du siehst eine kleine Tafel an einer Wand. ";

  if(QueryProp(P_SHOPKEEPER_ID))
  {
    if(!present(QueryProp(P_SHOPKEEPER_ID)))
    {
      txt += "Leider ist momentan gerade niemand hier.";
    }
    else
    {
      txt += "";
    }
  }

  return BS(txt);
}
