// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Strasse in Luifinlas");
  SetProp( P_INT_LONG,
	"Auf beiden Seiten der Strasse sind grosse Haeuser gebaut worden. Vor "
	"allem ein Haus im Norden mit einer herrlichen Fassade faellt Dir "
	"besonders auf. Im Sueden ist ein kleiner Laden fuer Kraeuter zu "
	"sehen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"seiten"}),
	    "Auf beiden Seiten sind grosse Haeuser zu sehen. Ein Haus im "
	    "Norden faellt Dir besonders auf.");

  AddDetail( ({"strasse"}),
	    "Die Strasse ist mit Steinen gepflastert.");
  
  AddDetail( ({"haeuser","wohnhaeuser"}),
	    "Die Haeuser sind hauptsaechlich Wohnhaeuser. Nur ein Haus ist "
	    "anders.");

  AddDetail( ({"haus","norden"}), 
            "Das Haus im Norden hat eine reich verzierte Fassade. Es ist die "
	    "Oper von Luifinlas.");

  AddDetail( ({"fassade"}),
	    "Die Fassade der Oper ist reich verziert mit allen moeglichen "
	    "Skulpturen und Stuckarbeiten.");

  AddDetail( ({"laden","kraeuter","sueden"}),
	    "Im Sueden ist ein kleiner Laden fuer Kraeuter.");

  AddDetail( ({"boden"}),
	    "Der Boden besteht aus Steinen.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau.");

  AddDetail( ({"steinen","steine"}),
	    "Die Steine sind uninteressant. Sie bilden nur die Strasse.");
  
  AddDetail( ({"luifinlas"}),
	    "Du bist in Luifinlas.");

  AddDetail( ({"oper"}), 
            "An der Oper mit ihrer schoenen Fassade haengt ein Schild.");

  AddDetail( ({"schild"}),
	    "Du kannst es lesen.");

  AddDetail( ({"skulpturen"}),
	    "Die Skulpturen sehen fast echt aus.");

  AddDetail( ({"stuckarbeiten"}),
	    "Die Stuckarbeiten sind phantastisch. Nur ein echter Meister "
	    "konnte sie so hinbekommen.");

  AddDetail( ({"meister"}),
	    "Es war wirklich ein Meister, der diese Stuckarbeiten erstellt "
	    "hat.");

  AddReadDetail( ({"schild"}),
	    "+-----------------------------------+\n"
	    "|                                   |\n"
	    "|      Wegen Umbau geschlossen      |\n"
	    "|                                   |\n"
	    "+-----------------------------------+");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Stadt.");  
 
  AddSmell( ({"stadt","gerueche"}),
	   "Hier gibt es wirklich viele Gerueche.");

  AddSound(DEFAULT_SOUND, "Es sind viele Sachen zu hoeren.");

  AddSound( ({"sachen","geraeusche"}),
	   "Es gibt viel zu viele Geraeusche, um sich nur auf eins zu "
	   "konzentrieren.");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "luifinlas16");
AddExit("osten", ROOM "luifinlas18");
AddExit("sueden", ROOM "luifkraut");


}
