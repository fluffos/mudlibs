// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Wald wird hier von einem Bach durchkreuzt. Du stehst auf einer "
	"kleinen Bruecke, die ueber den Bach fuehrt. Die Baeume ueber Dir "
	"bilden ein dichtes Blaetterdach, dass den gesamten Bach ueberspannt. "
	"Im Sueden wird der Wald lichter." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wald","stelle"}),
	    "Du bist mitten im Wald. An dieser Stelle wird der Wald von einem "
	    "kleinen Bach durchkreuzt.");

  AddDetail( ({"bach","westen","osten","baches"}),
	    "Der Bach plaetschert ueber groessere Steine von Westen nach "
	    "Osten unter der Bruecke durch, auf der Du gerade stehst.");
  
  AddDetail( ({"bruecke","holz"}),
	    "Die Bruecke besteht aus Holz. Sie ist recht einfach gebaut. Bis "
	    "auf die dicken Bohlen am Boden und ein wackliges Gelaender ist "
	    "nicht viel an ihr zu sehen.");

  AddDetail( ({"baeume","fall","weg"}), 
            "Die Baeume stehen recht dicht am Bach und ruecken ein wenig mehr"
	    "an den Weg als es im Sueden der Fall ist.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach der Baeume am Bach ist sehr dicht.");

  AddDetail( ({"sueden"}),
	    "Im Sueden wird der Wald lichter als hier.");

  AddDetail( ({"boden","bohlen"}),
	    "Dicke Bohlen bilden den Boden. Sie sind teilweise mit Moos "
	    "bewachsen.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist durch das dichte Blaetterdach der Baeume nur "
	    "teilweise zu sehen.");

  AddDetail( ({"steine"}),
	    "Der Bach plaetschert ueber die Steine, die dort einfach so "
	    "rumliegen.");
  
  AddDetail( ({"gelaender"}),
	    "Das Gelaender sieht sehr wackelig aus. Du haelst Dich besser "
	    "nicht daran fest, sondern probierst besser so ueber die "
	    "Bruecke zu kommen.");

  AddDetail( ({"moos","feuchtigkeit"}), 
            "Das Moos waechst hier sehr gut, da durch die Wasserspritzer des "
	    "Baches immer wieder Feuchtigkeit auf die Bohlen kommt.");

  AddDetail( ({"wasserspritzer"}),
	    "Du hast auch schon ein paar abbekommen. Du solltest bald weiter "
	    "gehen, damit Du nicht noch nasser wirst.");

  AddDetail( ({"wasser"}),
	    "Es gibt Wasser in dem Bach.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht waldig.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst das Plaetschern des Baches.");

  AddSound( ({"bach","plaetschern","geraeusch","wasser"}),
	   "Das Wasser fliesst geraeuschvoll ueber die Steine.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas71");
AddExit("sueden", ROOM "luifinlas67");


}

