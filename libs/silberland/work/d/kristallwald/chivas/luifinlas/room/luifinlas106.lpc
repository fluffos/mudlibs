// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Strasse in Luifinlas");
  SetProp( P_INT_LONG,
	"Die Wohnhaeuser hier am Rand der Stadtmauer sind wohl gerade "
	"restauriert worden. Die weisse Farbe strahlt, die Fenster sehen "
	"frisch geputzt aus und die Holzbalken der Haeuser sind reich mit "
	"Verzierungen versehen. Vor einem Haus steht eine Bank.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"haus"}), 
            "Vor einem der Wohnhaeuser steht eine Bank.");
  
  AddDetail( ({"wohnhaeuser","haeuser"}), 
            "Die Wohnhaeuser hier sind anscheinend frisch renoviert worden "
	    "und stehen zum Einzug bereit.");  

  AddDetail( ({"rand"}), 
            "Die Wohnhaeuser befinden sich am Rand der Stadtmauer.");  
  
  AddDetail( ({"stadtmauer","mauer"}), 
            "Die grosse Stadtmauer umschliesst die ganze Stadt. Sie besteht "
	    "aus grossen Steinquadern und eine Tuer ist in die Mauer "
	    "eingelassen.");  
  
  AddDetail( ({"farbe"}), 
            "Die Haeuser wurden gerade erst mit frischer Farbe gestrichen.");  
  
  AddDetail( ({"fenster"}), 
            "Die Fenster wurden frisch geputzt.");  
  
  AddDetail( ({"holzbalken","balken"}), 
            "Die Holzbalken haben reiche Verzierungen.");  
  
  AddDetail( ({"verzierungen"}), 
            "Die Verzierungen stellen verschiedene Zeichen dar.");  
  
  AddDetail( ({"bank"}), 
            "Auf der Bank sitzen ein paar Menschen und Hobbits.");  
  
  AddDetail( ({"boden"}), 
            "Der Boden ist gepflastert.");  
  
  AddDetail( ({"himmel"}), 
            "Der Himmel ist blau.");  
  
  AddDetail( ({"einzug","seher","seherhaus"}), 
            "Hier kann ein Seher sein Seherhaus bauen.");  
  
  AddDetail( ({"stadt","luifinlas"}), 
            "Luifinlas ist eine grosse Stadt. Du bist gerade in einer Strasse "
	    "von ihr.");  
  
  AddDetail( ({"steinquader","steinquadern","tonnen"}), 
            "Die grossen Steinquader wiegen mehrere Tonnen.");  
  
  AddDetail( ({"tuer"}), 
            "Die Tuer ist momentan verschlossen.");  
  
  AddDetail( ({"strasse"}), 
            "Du stehst auf einer gepflasterten Strasse in Luifinlas.");  
  
  AddDetail( ({"zeichen"}), 
            "Die Zeichen kannst Du lesen.");  
  
  AddDetail( ({"menschen"}), 
            "Die Menschen unterhalten sich mit den Hobbits.");  
  
  AddDetail( ({"hobbits","spaesse"}), 
            "Die Hobbits lachen und treiben ihre Spaesse.");  
  
  AddDetail( ({""}), 
            "");  
  
  AddDetail( ({""}), 
            "");  
  
  AddDetail( ({""}), 
            "");  
  
  AddReadDetail( ({"zeichen"}), 
            "Hier in Luifinlas sind alle Freunde.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach allen moeglichen Dingen.");  
 
  AddSmell( ({"dinge","dingen"}),
	   "Die Dinge, die alle zu riechen sind, kann man hier nicht alle "
	   "aufzaehlen.");

  AddSound(DEFAULT_SOUND, "Du hoerst Lachen und die Einwohner miteinander "
		          "reden");

  AddSound( ({"lachen"}),
	   "Das Lachen stammt von den Einwohnern, die auf der einer Bank "
	   "sitzen.");
  
  AddSound( ({"einwohner"}),
	   "Die Einwohner reden miteinander.");

//-----Details Ende-----
  
AddExit("sueden", ROOM "luifbau7");
AddExit("suedwesten", ROOM "luifinlas105");
AddExit("norden", ROOM "luifbau6");

}
