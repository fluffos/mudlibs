// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Am Osttor von Roch Adan");
  SetProp( P_INT_LONG,
	"Du stehst am Osttor von Roch Adan, der Stadt der Zentauren. Du kannst "
	"die Mauer aus Holzpalisaden sehen, die sich anscheinend um die ganze "
	"Stadt herum zieht. Ausserdem erkennst Du die grossen Baumriesen der "
	"Stadt, in denen die Zentauren wohnen. Nach Osten fuehrt ein Weg tief "
	"in einen Wald hinein." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"osttor","stelle","tor"}),
	    "Das Osttor ist offen und Du kannst die Stadt an dieser Stelle "
	    "betreten.");

  AddDetail( ({"roch adan","roch","adan","westen"}),
	    "Roch Adan ist die Stadt der Zentauren. Das Osttor der Stadt ist "
	    "im Westen zu sehen und Du kannst sie betreten.");
  
  AddDetail( ({"stadt"}),
	    "Roch Adan heisst die Stadt im Westen.");

  AddDetail( ({"zentauren"}), 
            "Viele Zentauren leben in der Stadt im Westen. Besuch sie doch "
	    "mal.");

  AddDetail( ({"holzpalisaden","palisaden","stadtmauer","mauer"}),
	    "Die Holzpalisaden bilden die Stadtmauer von Roch Adan. Sie ziehen "
	    "sich um die ganze Stadt.");

  AddDetail( ({"baumriesen","wohnstaetten"}),
	    "Die Baumriesen sind die Wohnstaetten der Zentauren.");
  
  AddDetail( ({"osten"}),
	    "Im Osten fuehrt der Weg tief in den Wald.");

  AddDetail( ({"weg"}),
	    "Der Weg ist fuehrt entweder in die Stadt oder auf eine Kreuzung "
	    "im Osten.");
  
  AddDetail( ({"wald"}),
	    "Der Wald faengt im Osten von Dir an.");

  AddDetail( ({"boden"}), 
            "Auf dem Boden ist ausser ein paar Steinchen nicht viel zu sehen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist wunderschoen blau.");

  AddDetail( ({"kreuzung"}),
	    "Da kannst Du wohl entscheiden wohin Du gehen willst.");

  AddDetail( ({"steinchen"}),
	    "Die Steinchen sind nicht sehr interessant.");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst die Stadt.");  
 
  AddSmell( ({"stadt","gerueche"}),
	   "Es sind halt die ueblichen Gerueche der Stadt.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Stadt");

  AddSound( ({"stadt","geraeusche"}),
	   "Du hoerst die ueblichen Geraeusche der Stadt in Westen.");
  
//-----Details Ende-----
  
AddExit("westen", "/d/kristallwald/chivas/zentauren/room/zentor3");
AddExit("osten", ROOM "luifinlas63");

}

