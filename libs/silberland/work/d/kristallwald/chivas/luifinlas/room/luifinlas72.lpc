// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Strasse von Luifinlas");
  SetProp( P_INT_LONG,
	"Die Strasse fuehrt an den Haeusern nach Nordwesten. Im Suedosten ist "
	"der grosse Platz von Luifinlas mit dem grossen Denkmal zu sehen. Die "
	"Strasse macht einen nicht ganz so sauberen Eindruck. Hier und da ist "
	"Abfall zu erkennen. Anscheinend gehen die Leute hier nicht oft lang "
	"und machen sauber." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"strasse"}),
	    "Die Strasse fuehrt nach Nordwesten oder zurueck zum Platz nach "
	    "Suedosten. Sie ist gepflastert und hier und da liegt Abfall "
	    "herum.");

  AddDetail( ({"haeusern","haeuser","unterschieden","unterschiede"}),
	    "Die Haeuser sind alle unterschiedlich gebaut. Man sieht groessere "
	    "und kleinere Haeuser passend zu den jeweiligen Rassen, die wohl "
	    "die Haeuser bewohnen. Neben diesen Unterschieden, sind sie aber "
	    "alle nicht mehr im besten Zustand.");
  
  AddDetail( ({"nordwesten"}),
	    "Im Nordwesten geht die Strasse weiter.");

  AddDetail( ({"suedosten"}), 
            "Im Suedosten muendet die Strasse auf dem Platz von Luifinlas.");

  AddDetail( ({"platz"}),
	    "Der Platz im Suedosten ist recht gross. Ein grosses Denkmal "
	    "steht auf ihm.");

  AddDetail( ({"luifinlas","stadt"}),
	    "Du bist in Luifinlas.");

  AddDetail( ({"denkmal"}),
	    "Geh einfach mal naeher ran und schau es Dir an.");
  
  AddDetail( ({"eindruck"}),
	    "Die Strasse ist einfach dreckig. Es liegt Abfall herum und "
	    "niemanden scheint es zu stoeren.");

  AddDetail( ({"leute"}),
	    "Hier macht anscheinend keiner regelmaessig sauber.");
  
  AddDetail( ({"boden"}),
	    "Der Boden besteht aus Pflastersteinen, zwischen denen an einigen "
	    "Stellen Gras waechst. Ansonsten ist der Boden recht dreckig und "
	    "hier und da liegt Abfall herum.");

  AddDetail( ({"himmel"}), 
            "Der Himmel ueber Dir ist blau.");

  AddDetail( ({"abfall","tuer"}),
	    "Auf der Strasse liegt Abfall, welcher einfach vor die Tuer "
	    "gekippt wurde.");

  AddDetail( ({"zustand","farbe","zeiten"}),
	    "Die Haeuser haben schon bessere Zeiten gesehen. Ihre Farbe ist "
	    "ausgeblichen und sie wurden schon lange nicht mehr gestrichen "
	    "oder von aussen wenigstens geputzt.");

  AddDetail( ({"rassen","zwergen","zwerge","feen","fee","trollen","trolle","hobbits"}),
	    "Die grossen Haeuser gehoeren sicher Trollen und die kleinen "
	    "Haeuser wohl eher Feen, Hobbits oder den Zwergen.");
  
  AddDetail( ({"stellen","gras"}),
	    "Das Gras, welches an ein paar Stellen zwischen den Steinen "
	    "waechst ist platt getreten und mehr grau als gruen.");

  AddDetail( ({"pflastersteinen","steine","pflaster","pflastersteine","steinen"}),
	    "Die Pflastersteine wurden in der ganzen Stadt verlegt.");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Abfall.");  
 
  AddSmell( ({"abfall"}),
	   "Es stinkt hier ein wenig.");

  AddSound(DEFAULT_SOUND, "Du hoerst Laerm vom Platz herkommen.");

  AddSound( ({"laerm"}),
	   "Geh einfach hin und hoer ihn Dir an.");
  
//-----Details Ende-----
  
AddExit("nordwesten", ROOM "luifinlas83");
AddExit("suedosten", ROOM "luifinlas15");


}
