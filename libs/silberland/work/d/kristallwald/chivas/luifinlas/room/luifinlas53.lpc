// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Wiese");
  SetProp( P_INT_LONG,
	"Die Wiese erstreckt sich nach Norden, wo eine Bruecke ueber einen "
	"kleinen Bach fuehrt, der ueber die Wiese fliesst. Der Wald beginnt "
	"im Sueden und umrandet die ganze Lichtung." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wiese","norden"}),
	    "Die Wiese erstreckt sich weit nach Norden. Lauter Blumen sind zu "
	    "sehen.");

  AddDetail( ({"bruecke"}),
	    "Die Bruecke fuehrt ueber einen kleinen Bach.");
  
  AddDetail( ({"bach"}),
	    "Der Bach plaetschert ueber die Wiese.");

  AddDetail( ({"wald","sueden"}), 
            "Im Sueden fuehrt der Weg in den Wald hinein.");

  AddDetail( ({"lichtung"}),
	    "Die Lichtung ist sehr gross.");

  AddDetail( ({"boden"}),
	    "Der Boden des Weges ist mit kleinen Steinchen bedeckt.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ueber Dir ist schoen blau. Ein paar weisse Wolken "
	    "ziehen am Himmel entlang und die Sonne steht senkrecht ueber "
	    "Dir.");
  
  AddDetail( ({"sonne"}),
	    "Die Sonne steht senkrecht am Himmel.");

  AddDetail( ({"blumen"}),
	    "Viele verschiedene bunte Blumen stehen auf der Wiese.");
  
  AddDetail( ({"weg","weges"}),
	    "Der Weg fuehrt ueber die Wiese und verschwindet im Sueden und "
	    "Norden im Wald.");

  AddDetail( ({"steinchen"}), 
            "Kleine unbedeutsame Steinchen liegen auf dem Weg.");

  AddDetail( ({"wolken"}),
	    "Die weissen Wolken ziehen langsam am Himmel entlang.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Gras.");  
 
  AddSmell( ({"gras"}),
	   "Das Gras duftet herrlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel.");

  AddSound( ({"voegel"}),
	   "*triller*");
  
//-----Details Ende-----
  
AddExit("nordosten", ROOM "luifinlas52");
AddExit("sueden", ROOM "luifinlas54");

}
