// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einer Kreuzung im Wald");
  SetProp( P_INT_LONG,
	"An dieser Stelle gabelt sich der Weg. Er fuehrt nach Nordosten, nach "
	"Westen und nach Sueden. Der Weg ansich gibt Dir keinen Hinweis "
	"darauf, wohin Du gehen solltest. Vielleicht koenntest Du aber auf das "
	"Schild am Rand des Weges schauen. Es wurde sicher von einem lieben "
	"Magier aufgestellt um Dich zu unterstuetzen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"stelle","nordosten","westen","sueden","entscheidung"}),
	    "An dieser Stelle kannst Du nach Nordosten, Sueden oder Westen "
	    "gehen. Es ist Deine Entscheidung wohin Du gehst.");

  AddDetail( ({"weg","weges"}),
	    "Der Weg, der Dich durch den Wald fuehrt teilt sich an dieser "
	    "Stelle.");
  
  AddDetail( ({"hinweis","schild"}),
	    "Ein Schild steht am Wegrand. Du kannst es lesen.");

  AddDetail( ({"rand","wegrand"}), 
            "Am Wegrand zwischen den grossen Baeumen des Waldes steht ein "
	    "Schild.");

  AddDetail( ({"magier"}),
	    "Magier sind immer nett. Sie sind zwar faul, aber meistens nett.");

  AddDetail( ({"boden"}),
	    "Am Boden sind kleine Steinchen zu sehen. Ausserdem viele Blaetter "
	    "und Nadeln, die von den Baeumen herunter gefallen sind.");

  AddDetail( ({"himmel"}),
	    "Der himmel ist durch das recht dichte Blaetterdach schlecht zu "
	    "sehen. Du kannst ihn nur erahnen.");
  
  AddDetail( ({"wald","waldes"}),
	    "Du bist mitten im Wald zwischen den grossen Baeumen. Der Weg "
	    "gabelt sich an dieser Stelle.");

  AddDetail( ({"baeume","baeumen","platz"}),
	    "Die grossen Baeume am Wegrand weichen hier ein wenig zurueck und "
	    "geben genug Platz, so dass sich der Weg teilen kann.");
  
  AddDetail( ({"blaetter"}),
	    "Die Blaetter sind von den Baeumen auf den Weg gefallen.");

  AddDetail( ({"nadeln"}), 
            "Die Nadeln stammen von den paar Tannen, die hier stehen.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Die Blaetter der grossen Baeume bilden ein dichtes Blaetterdach "
	    "ueber dem Weg.");

  AddDetail( ({"tannen"}),
	    "Einige Tannen stehen hier neben den Laubbaeumen.");

  AddDetail( ({"laubbaeume","laubbaeumen","ueberzahl"}),
	    "Die Laubbaeume sind hier in der Ueberzahl. Nur wenige Nadelbaeume "
	    "sind zu sehen.");
  
  AddDetail( ({"nadelbaeume"}),
	    "Es gibt hier nur ein paar Tannen.");

  AddDetail( ({"steinchen"}),
	    "Die Steinchen sind uninteressant.");
  
  AddReadDetail( ({"schild"}),
	    "+------------------------------------------------+\n"
	    "|                                                |\n"
	    "|                                Luifinlas       |\n"
	    "|                                   /            |\n"
	    "|                                  /             |\n"
	    "| Hochebene von Gorthad           /              |\n"
	    "| Roch Adan / Hubbleton ---------+               |\n"
	    "| Zwergenfeste von Ardhmir       |               |\n"
	    "|                                |               |\n"
	    "|                                |               |\n"
	    "|                            Roch Adan           |\n"
	    "|                                                |\n"
	    "+------------------------------------------------+\n");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht waldig.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel weit oben im "
		          "Blaetterdach.");

  AddSound( ({"voegel"}),
	   "*tschip*triller*zwischer*");
  
//-----Details Ende-----
  
AddExit("nordosten", ROOM "luifinlas36");
AddExit("sueden", ROOM "luifinlas48");
AddExit("westen", ROOM "luifinlas38");

}
