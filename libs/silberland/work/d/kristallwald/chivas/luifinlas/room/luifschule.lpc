// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Schule von Luifinlas");
  SetProp( P_INT_LONG,
	"Du stehst in der Schule von Luifinlas. Lauter kleine Tische und "
	"Baenke stehen in mehreren Reihen im Raum. An den Waenden haengen "
	"verschiedene Bilder und Zeichnungen und an der Suedwand haengt eine "
	"grosse Tafel." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"schule"}),
	    "Du bist in der Schule von Luifinlas.");

  AddDetail( ({"luifinlas","stadt"}),
	    "Du bist in der grossen Stadt Luifinlas.");
  
  AddDetail( ({"tische"}),
	    "Die Tische stehen in mehreren Reihen hintereinander.");

  AddDetail( ({"baenke","baenken"}), 
            "Auf den Baenken sitzten die Kinder und lauschen dem Lehrer.");

  AddDetail( ({"reihen"}),
	    "Die Baenke und Tische stehen sauber in Reihen hintereinander.");

  AddDetail( ({"raum"}),
	    "Dieser Raum ist eine Schule.");

  AddDetail( ({"waenden","waende","wand"}),
	    "An den Waenden haengen lauter Bilder und Zeichnungen. An der "
	    "Suedwand haengt eine grosse Tafel.");
  
  AddDetail( ({"bilder"}),
	    "Die Bilder wurden von den Kindern gemalt. Sie zeigen die Stadt "
	    "Luifinlas. Jedenfalls glaubst Du das.");

  AddDetail( ({"zeichnungen","strichmaennchen"}),
	    "Die Zeichnungen enthalten hauptsaechlich Strichmaennchen. Eines "
	    "sieht aus wie Du.");
  
  AddDetail( ({"suedwand","tafel"}),
	    "An der Suedwand haengt eine grosse Tafel. Auf ihr sind "
	    "Matheaufgaben zu sehen. Sie uebersteigen leider Deine "
	    "Intelligenz.");

  AddDetail( ({"kinder","pause"}), 
            "Die Kinder haben wohl gerade Pause.");

  AddDetail( ({"lehrer"}),
	    "Der Lehrer ist nicht da.");

  AddDetail( ({"intelligenz","detail"}),
	    "Das Du dieses Detail Dir anschaust, ist schon sehr fraglich.");

  AddDetail( ({"matheaufgaben","aufgaben","horizont"}),
	    "Die Aufgaben ueberschreiten Deinen Horizont.");
  
  AddDetail( ({"decke","holz"}),
	    "Die Decke besteht aus Holz.");

  AddDetail( ({"boden"}),
	    "Du siehst Pakett am Boden.");
  
  AddDetail( ({"pakett"}),
	    "Der Pakett sieht schon sehr abgenutzt aus.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Kreide.");  
 
  AddSmell( ({"kreide"}),
	   "Du wusstest nicht das Kreide riecht.");

  AddSound(DEFAULT_SOUND, "Es ist recht still, da die Kinder nicht da sind.");

//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas18");


}
