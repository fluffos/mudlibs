// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Die Baeume stehen hier nicht so dicht wie in anderen Teilen des "
	"Waldes. Der Wald geht hier in eine grosse Wiese im Suedosten "
	"ueber. Einige Straeucher stehen am Rand des Weges und ein grosser "
	"Findling liegt am Rand. Ausserdem siehst Du im Norden eine kleine "
	"Bruecke, die ueber einen Bach fuehrt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"baeume","baeumen"}),
	    "Die grossen Baeume stehen nicht sehr dicht. Du siehst "
	    "hauptsaechlich Laubbaeume und nur ein paar Nadelbaeume.");

  AddDetail( ({"norden","bruecke"}),
	    "Im Norden fuehrt eine Bruecke ueber einen kleinen Bach.");
  
  AddDetail( ({"wald","waldes"}),
	    "Du bist in einem Wald, was Du an den vielen Baeumen auch merken "
	    "solltest.");

  AddDetail( ({"wiese","suedosten"}), 
            "Im Suedosten beginnt eine grosse Wiese.");

  AddDetail( ({"straeucher","platz"}),
	    "Einige Straeucher sind am Rand des Weges zu sehen. Sie haben "
	    "genug Platz zwischen den Baeumen um hier zu wachsen.");

  AddDetail( ({"rand"}),
	    "Am Rand stehen Straeucher und ein grosser Findling ist zu sehen.");

  AddDetail( ({"weges","weg","richtung"}),
	    "Du befindest Dich auf einem Weg, der hier durch den Wald geht "
	    "und in Richtung Suedosten auf eine Wiese fuehrt.");
  
  AddDetail( ({"findling"}),
	    "Der grosse Findling ist mit Zeichen uebersaeht.");

  AddDetail( ({"teilen"}),
	    "In anderen Teilen des Waldes stehen die Baeume dichter.");
  
  AddDetail( ({"laubbaeume"}),
	    "Du siehst Buchen, einige Erlen, ein paar Birken und eine alte "
	    "Eiche.");

  AddDetail( ({"nadelbaeume"}), 
            "Du siehst nur ein paar Tannen.");

  AddDetail( ({"bach"}),
	    "Der Bach plaetschert im Norden unter einer Bruecke durch und "
	    "verschwindet fuer Dich nicht sichtbar im Wald.");

  AddDetail( ({"zeichen"}),
	    "Die Zeichen sehen schon leicht verwittert aus. Sie scheinen sehr "
	    "alt zu sein. Du erkennst Strichmaennchen, die am jagen sind.");

  AddDetail( ({"boden"}),
	    "Am Boden sind lauter Steinchen zu sehen, die den Weg bilden. Auch "
	    "einige Blaetter und Nadeln liegen am Boden, die von den Baeumen "
	    "herab gefallen sind.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist nur ein bisschen durch das Blaetterdach der Baeume "
	    "zu sehen. Geh einfach nach Suedosten auf die Wiese, dann kannst "
	    "Du ihn besser betrachten.");

  AddDetail( ({"buchen"}),
	    "Hauptsaechlich Buchen sind hier am Rand zu sehen. Sie sind sehr "
	    "gross gewachsen.");
  
  AddDetail( ({"erlen","abwechslung"}),
	    "Die Erlen bieten ein wenig Abwechslung neben den Buchen.");

  AddDetail( ({"birken"}), 
            "Die Birken sind schoen gewachsen.");

  AddDetail( ({"eiche"}),
	    "Eine alte und grosse Eiche steht zwischen den anderen Baeumen und "
	    "sieht majestaetisch aus.");

  AddDetail( ({"tannen"}),
	    "Einige Tannen haben sich zwischen die Laubbaeume verirrt.");

  AddDetail( ({"strichmaennchen","maenchen","kunst"}),
	    "Die Strichmaennchen wuerdest Du nicht als grosse Kunst "
	    "bezeichnen, aber Du kannst es sicher auch nicht viel besser.");
  
  AddDetail( ({"nadeln"}),
	    "Die Nadeln stammen von den Tannen.");

  AddDetail( ({"blaetter"}),
	    "Die Blaetter am Boden sind von den Baeumen herunter gefallen.");
  
  AddDetail( ({"blaetterdach","dach","sonnenstrahlen","strahlen"}),
	    "Das Blaetterdach ist nicht sehr dicht, einige Sonnenstrahlen "
	    "finden den Weg bis zu Dir hinunter.");

  AddDetail( ({"steinchen"}), 
            "Die Steinchen sind nicht interessant.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht waldig.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel in den Baeumen.");

  AddSound( ({"voegel"}),
	   "*zwitscher*");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas84");
AddExit("suedosten", ROOM "luifinlas66");


}

