// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  AddRoomMessage( ({ "Einige Leute rempeln Dich an, als sie in die Stadt "
		     "wollen oder aus ihr heraus.\n"}),
                     30, "sound" );

  SetProp( P_INT_SHORT, "Auf einem Weg");
  SetProp( P_INT_LONG,
	"Der Weg fuehrt ueber eine grosse Wiese aus dem Wald heraus, welcher "
	"im Nordwesten beginnt. Genau vor Dir erhebt sich die grosse "
	"Stadtmauer von Luifinlas, die Du durch den Durchgang in der Mauer "
	"betreten kannst. Genau ueber dem Durchgang in der Mauer siehst Du "
	"das Wappen der Stadt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"weg","weges"}),
	    "Der Weg auf dem Du stehst fuehrt entweder durch den Durchgang im "
	    "Osten in die Stadt hinein oder nach Nordwesten in Richtung Wald.");

  AddDetail( ({"wiese"}),
	    "Die Wiese vor der Stadt ist mit halbhohen Gras bedeckt. Die "
	    "Baeume, die dort mal standen, wurden gerodet und nur ihre "
	    "Baumstuempfe sind uebrig geblieben. ");
  
  AddDetail( ({"wald","richtung","waldgrenze"}),
	    "Im Nordwesten siehst Du die Waldgrenze. Dort beginnt der grosse "
	    "Wald.");

  AddDetail( ({"leute"}),
	    "Verschiedene Leute sind auf dem Weg in die Stadt oder aus ihr "
	    "heraus.");

  AddDetail( ({"nordwesten"}), 
            "Im Nordwesten siehst Du den Wald. Der Weg fuehrt in ihn hinein.");

  AddDetail( ({"stadtmauer","mauer"}),
	    "Die grosse und maechtige Stadtmauer von Luifinlas erhebt sich "
	    "vor Dir. Durch einen Durchgang hindurch kannst Du die Stadt "
	    "betreten, da das Tor offen steht. Ein Wappen ist in die Mauer "
	    "genau ueber dem Durchgang gemeisselt worden.");

  AddDetail( ({"stadt","luifinlas"}),
	    "Die Stadt, die Du hier betreten kannst, heisst Luifinlas.");

  AddDetail( ({"durchgang","osten","punkt","westen"}),
	    "Im Osten ist der breite und grosse Durchgang, der das Tor in "
	    "der Stadtmauer bildet. Es ist hier im Westen der einzige Punkt, "
	    "um ihn die Stadt zu gelangen.");
  
  AddDetail( ({"wappen","stein"}),
	    "Das Wappen wurde in den Stein der Mauer gemeisselt. Es stellt "
	    "einen Adler dar, um den sich acht Sterne anordnen.");

  AddDetail( ({"boden","steinchen"}),
	    "Der Boden des Weges besteht aus kleinen Steinchen.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist herrlich blau.");

  AddDetail( ({"gras"}), 
            "Das Gras der Wiese ist halbhoch gemaeht, so dass man sich nicht "
	    "in ihm verstecken kann.");

  AddDetail( ({"baeume"}),
	    "Die Baeume auf der Wiese wurden gerodet. Wenn Du ein paar Baeume "
	    "naeher sehen willst, musst Du schon nach Nordwesten in den Wald "
	    "gehen.");

  AddDetail( ({"baumstuempfe","zeit"}),
	    "Einige Baumstuempfe auf der Wiese zeugen davon, dass auch hier "
	    "einmal Baeume gestanden haben. Sie wurden vor langer Zeit "
	    "gerodet.");

  AddDetail( ({"tor","tores"}),
	    "Das Tor besteht aus Holz und Eisen. Es ist momentan geoeffnet und "
	    "Du kannst die Stadt durch den Durchgang betreten.");
  
  AddDetail( ({"adler"}),
	    "Der Adler symbolisiert die Staerke und Macht der Stadt.");

  AddDetail( ({"sterne"}),
	    "Die Sterne symbolisieren die Rassen im Silberland. Hier in "
	    "Luifinlas leben alle Rassen einigermassen friedlich "
	    "nebeneinander.");
  
  AddDetail( ({"holz"}),
	    "Das Holz des Tores besteht aus grossen und dicken Eichenbohlen.");

  AddDetail( ({"eisen"}), 
            "Das Tor ist mit Eisen verstaerkt worden, so dass es fast jeden "
	    "Angriff abwehren kann.");

  AddDetail( ({"staerke","macht"}),
	    "Luifinlas ist eine der groessten Staedte des Silberlandes und ist "
	    "deshalb sehr stark und maechtig.");

  AddDetail( ({"staedte"}),
	    "Es gibt viele Staedte im Silberland. Luifinlas ist eine davon.");

  AddDetail( ({"silberlandes","silberland"}),
	    "Du bist im Silberland.");
  
  AddDetail( ({"rassen"}),
	    "Es gibt viele verschiedene Rassen im Silberland. Acht davon "
	    "kann man sogar selbst spielen.");

  AddDetail( ({"eichenbohlen","bohlen"}),
	    "Die Bohlen sind sehr dick. Sie halten so manchen Angriff aus.");
  
  AddDetail( ({"angriff","thema"}),
	    "Da Du die Stadt ja nicht angreifen willst, brauch Dich das Thema "
	    "ja nicht weiter zu beschaeftigen.");

  AddDetail( ({"nase"}), 
            "Du hast eine besonders grosse.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst schon die Gerueche der Stadt.");  
 
  AddSmell( ({"gerueche","stadt"}),
	   "Die verschiedensten Gerueche der Stadt steigen Dir in die Nase. Du "
	   "kannst sie nicht voneinander unterscheiden.");

  AddSound(DEFAULT_SOUND, "Du hoerst Laerm aus der Stadt kommen.");

  AddSound( ({"laerm","stadt"}),
	   "Geh einfach rein, um ihn genauer zu hoeren.");
  
//-----Details Ende-----
  
AddExit("nordwesten", ROOM "luifinlas8");
AddExit("osten", ROOM "luifinlas10");

}

