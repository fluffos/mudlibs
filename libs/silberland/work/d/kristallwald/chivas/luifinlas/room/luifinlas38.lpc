// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Weg fuehrt weiter durch den Wald von Westen nach Osten. Die "
	"Baeume und Straeucher am Rand stehen dicht zusammen und geben Dir "
	"die Richtung vor. Im Osten scheint sich der Weg zu gabeln und Dir "
	"die Moeglichkeit zu geben, Deine Richtung zu waehlen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"weg"}),
	    "Der Weg fuehrt Dich durch den grossen Wald. Im Osten scheint sich "
	    "der Weg zu teilen.");

  AddDetail( ({"wald"}),
	    "Der Wald in dem Du Dich befindest ist riesig. Er wird nur von ein "
	    "paar Lichtungen und Baechen unterbrochen.");
  
  AddDetail( ({"westen","osten"}),
	    "Du kannst nach Westen oder nach Osten gehen.");

  AddDetail( ({"baeume"}), 
            "Die grossen Baeume stehen direkt neben dem Weg und Du kannst "
	    "nicht an ihnen oder dem dichten Unterholz vorbei und den Weg "
	    "verlassen.");

  AddDetail( ({"straeucher","chance","barriere"}),
	    "Einzelne Straeucher bilden noch eine zusaetzliche Barriere "
	    "zwischen den Baeumen. Du hast keine Chance hier vom Weg "
	    "abzuweichen.");

  AddDetail( ({"rand","wegrand"}),
	    "Am Wegrand stehen Baeume und Straeucher.");

  AddDetail( ({"richtung"}),
	    "Entweder Du gehst nach Osten oder nach Westen.");
  
  AddDetail( ({"moeglichkeit"}),
	    "Du hast weiter im Osten die Moeglichkeit einen anderen Weg zu "
	    "gehen.");

  AddDetail( ({"boden"}),
	    "Der Boden sieht aus wie im restlichen Wald, wo Du bereits warst.");
  
  AddDetail( ({"himmel","blaetterdach","dach"}),
	    "Der Himmel ist eigentlich nicht durch das dichte Blaetterdach zu "
	    "sehen.");

  AddDetail( ({"baechen","baeche","bach"}), 
            "Hier gibt es ausnahmsweise gerade keinen Bach.");

  AddDetail( ({"lichungen","lichtung"}),
	    "Eine Lichtung findest Du hier gerade nicht. Da musst Du schon "
	    "woanders hingehen.");

  AddDetail( ({"unterholz"}),
	    "Das dichte Unterholz hindert Dich zusaetzlich daran den Weg zu "
	    "verlassen.");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Wald.");  
 
  AddSmell( ({"wald"}),
	   "Der Wald riecht waldig.");

  AddSound(DEFAULT_SOUND, "Du hoerst einen Ast knacken.");

  AddSound( ({"ast"}),
	   "Du bist auf einen Ast getreten. Pass besser auf.");
  
//-----Details Ende-----
  
AddExit("osten", ROOM "luifinlas37");
AddExit("westen", ROOM "luifinlas39");

}
