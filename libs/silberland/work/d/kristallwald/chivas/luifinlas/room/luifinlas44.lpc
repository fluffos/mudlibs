// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Lichtung");
  SetProp( P_INT_LONG,
	"Du befindest Dich auf einer grossen Lichtung, die von maechtigen und "
	"dicht stehenden Baeumen umrandet ist. Der Weg schlaengelt sich "
	"zwischen den hohen Graesern und vielen Blumen hindurch. Die Sonne "
	"steht beinahe senkrecht am Himmel und nur ein paar Woelkchen sind "
	"zu sehen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"lichtung"}),
	    "Die Lichtung auf der Du Dich befindest ist wunderschoen. Auf ihr "
	    "bluehen viele Blumen und die Graeser wiegen sich leicht im Wind, "
	    "der hier weht. Die Lichtung ist von den hohen Baeumen des Waldes "
	    "umschlossen.");

  AddDetail( ({"baeumen","baeume"}),
	    "Die grossen Baeume des Waldes umschliessen die grosse Lichtung, "
	    "auf der Du Dich befindest.");
  
  AddDetail( ({"weg","boden"}),
	    "Der Weg ist mit Steinchen bedeckt und schlaengelt sich ueber die "
	    "grosse Lichtung.");

  AddDetail( ({"graeser","graesern"}), 
            "Die Graeser wachsen recht hoch und wiegen sich leicht im Wind.");

  AddDetail( ({"blumen"}),
	    "Du kannst viele bunte Blumen auf der Lichtung sehen. Du weisst "
	    "zwar nicht, um welche Blumen es sich handelt, aber sie sehen sehr "
	    "schoen aus.");

  AddDetail( ({"sonne"}),
	    "Die Sonne steht senkrecht ueber Dir.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist bis auf ein paar Woelkchen wunderschoen blau.");
  
  AddDetail( ({"woelkchen"}),
	    "Ein paar weisse Woelkchen ziehen am Himmel entlang.");

  AddDetail( ({"wald","waldes"}),
	    "Der Wald umringt die grosse Lichtung.");
  
  AddDetail( ({"wind","wiegen"}),
	    "Es weht ein leichter Wind, der die Graeser und Blumen zum Wiegen "
	    "bringt.");

  AddDetail( ({"steinchen"}), 
            "Die Steinchen bilden den Weg, der sich ueber die Lichtung "
	    "schlaengelt.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen duften toll.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind, wie er ueber die Lichtung "
		          "weht.");

  AddSound( ({"wind","blumen","graeser","geraeusch"}),
	   "Der Wind bewegt die Blumen und Graeser und das verursacht ein "
	   "Geraeusch.");
  
//-----Details Ende-----
  
AddExit("osten", ROOM "luifinlas43");
AddExit("westen", ROOM "luifinlas45");

}
