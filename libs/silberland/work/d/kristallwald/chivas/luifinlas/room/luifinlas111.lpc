// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Strasse in Luifinlas");
  SetProp( P_INT_LONG,
	"Die Strasse endet hier zwischen ein paar Haeusern und der Stadtmauer "
	"im Norden. Die Haeuser nicht nicht im besten Zustand und die Strasse "
        "ist auch sehr dreckig. Ausserdem haengen an den Ecken dunkle "
        "Gestalten herum." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"strasse"}),
	    "Die Strasse endet hier an der Stadtmauer. Sie ist dreckig und "
	    "ueberall liegt Unrat herum.");

  AddDetail( ({"haeusern","haeuser"}),
	    "Die Haeuser sind nicht in dem besten Zustand und es scheint auch "
	    "kein besonders gutes Viertel zu sein. Ein paar Orks und Trolle "
	    "lungern vor den Haeusern herum.");
  
  AddDetail( ({"stadtmauer","mauer","norden"}),
	    "Die Stadtmauer baut sich im Norden vor Dir auf. Sie besteht aus "
	    "grossen Steinquadern und eine Tuer ist zu sehen.");

  AddDetail( ({"zustand","beste"}), 
            "Der Zustand der Haeuser ist nicht der Beste. Die Haeuser sind "
	    "schmutzig und ein paar Scheiben sind zerbrochen.");

  AddDetail( ({"ecken"}),
	    "An den Ecken der Haeuser sind ein paar dunkle Gestalten zu "
	    "sehen.");

  AddDetail( ({"gestalten"}),
	    "Die Gestalten sind unter ihren dunklen Umhaengen verborgen.");

  AddDetail( ({"boden"}),
	    "Der Boden der Strasse ist gepflastert und es liegt viel Unrat "
	    "herum.");
  
  AddDetail( ({"himmel"}),
	    "Obwohl dies eine finstere Gegend ist, ist der Himmel blau.");

  AddDetail( ({"unrat","abfall","teile","teilen"}),
	    "Es liegt Abfall direkt auf der Strasse. Hier scheint keiner "
	    "aufzuraeumen wie in den anderen Teilen der Stadt.");
  
  AddDetail( ({"viertel","gegend"}),
	    "Dieses Viertel ist nicht so gut. Hier haengen ein paar dunkle "
	    "Gestalten herum.");

  AddDetail( ({"orks"}), 
            "Die Orks schauen Dich grimmig an. Du bist hier nicht sicher.");

  AddDetail( ({"trolle","muskeln"}),
	    "Die Trolle lassen ihre Muskeln spielen. Sie suchen sich gerne "
	    "Jemanden aus, der schwaecher ist als sie.");

  AddDetail( ({"steinquadern","steinquader","quader","tonnen"}),
	    "Die Steinquader sind gross und wiegen einige Tonnen.");

  AddDetail( ({"tuer"}),
	    "Die Tuer ist momentan verschlossen und Du kannst sie nicht "
	    "oeffnen.");
  
  AddDetail( ({"scheiben","fenster"}),
	    "Die Scheiben der Fenster sind teilweise zerbrochen.");

  AddDetail( ({"umhaengen","umhaenge"}),
	    "Unter den Umhaengen stecken sicher ein paar Dunkelelfen.");
  
  AddDetail( ({"stadt","luifinlas"}),
	    "Du bist in der Stadt Luifinlas.");

  AddDetail( ({"jemanden","jemand"}), 
            "Hoffentlich bist Du nicht dieser Jemand.");

  AddDetail( ({"dunkelelfen"}),
	    "Dunkelelfen sind boese und gefaehrlich. Pass auf Dich auf.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Muell.");  
 
  AddSmell( ({"muell"}),
	   "Du riechst den Muell, der hier auf der Strasse liegt.");

  AddSound(DEFAULT_SOUND, "Es ist leider beunruhigend still.");

//-----Details Ende-----
  
AddExit("osten", ROOM "luifbau12");
AddExit("westen", ROOM "luifbau13");
AddExit("sueden", ROOM "luifinlas110");

}
