// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Strasse in Luifinlas");
  SetProp( P_INT_LONG,
	"Du stehst in einer Sackgasse, von wo aus die Strasse nur zurueck nach "
	"Westen fuehrt. Im Osten ist die grosse Stadtmauer von Luifinlas zu "
	"sehen, in der eine Tuer zu sehen ist. Ansonsten sind lauter kleine "
	"Haeuser zu sehen. Ein Haus im Sueden faellt Dir besonders auf." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"sackgasse","weg"}),
	    "Du stehst in einer Sackgasse und es geht nur den Weg zurueck.");

  AddDetail( ({"strasse","westen"}),
	    "Die Strasse fuehrt zurueck nach Westen.");
  
  AddDetail( ({"osten","stadtmauer","mauer"}),
	    "Im Osten ist die Stadtmauer zu sehen. In ihr ist eine Tuer "
	    "eingelassen.");

  AddDetail( ({"luifinlas","stadt"}), 
            "Du bist in der Stadt Luifinlas.");

  AddDetail( ({"tuer","schluessel","chivas"}),
	    "Die Tuer ist momentan noch abgeschlossen und nur Chivas hat "
	    "den Schluessel.");

  AddDetail( ({"haeuser","eindruck"}),
	    "Es gibt hier lauter kleine nette Haeuser, die alle einen sehr "
	    "gepflegten Eindruck machen.");

  AddDetail( ({"haus","sueden","seher"}),
	    "Das Haus im Sueden wurde gerade erst neu gebaut und ist noch "
	    "unbewohnt. Du koenntest hier einziehen, wenn Du ein Seher bist.");
   
  AddDetail( ({"boden","steine","steinen"}),
	    "Der Boden ist mit Steinen gepflastert.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ueber Dir ist blau.");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach nicht viel.");  

  AddSound(DEFAULT_SOUND, "Es ist recht ruhig hier.");

//-----Details Ende-----
  
AddExit("sueden", ROOM "luifbau9");
AddExit("westen", ROOM "luifinlas113");

}
