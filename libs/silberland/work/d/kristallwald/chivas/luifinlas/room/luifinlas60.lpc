// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Waldweg");
  SetProp( P_INT_LONG,
	"Die Baeume links und recht geben dem Weg die Richtung vor. Zwischen "
	"den grossen Baeumen im Westen ist eine kleine Grasflaeche, auf der "
	"ein abgebranntes Lagerfeuer zu sehen ist. Anscheinend hat hier "
	"Jemand Rast gemacht und sich Etwas zu essen gemacht." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"baeume","baeumen"}),
	    "Die Baeume stehen direkt am Weg. Nur im Westen lassen sie Platz "
	    "fuer eine kleine Grasflaeche.");

  AddDetail( ({"weg","weges"}),
	    "Der Weg fuehrt durch den dichten Wald.");
  
  AddDetail( ({"richtung","norden","suedosten"}),
	    "Du kannst nach Norden oder nach Suedosten gehen.");

  AddDetail( ({"westen"}), 
            "Im Westen sind die Baeume ein wenig zurueck gewichen und haben "
	    "Platz fuer eine kleine Grasflaeche gelassen.");

  AddDetail( ({"grasflaeche","platz"}),
	    "Die Grasflaeche ist nicht gross. Ein abgebranntes Lagerfeuer ist "
	    "auf ihr zu sehen.");

  AddDetail( ({"lagerfeuer","feuer","zeit"}),
	    "Das Lagerfeuer ist alt und abgebrannt. Hier wurde schon laengere "
	    "Zeit kein Feuer mehr angezuendet.");

  AddDetail( ({"jemand"}),
	    "Wer dieser Jemand war, weisst Du nicht und wirst es sicher auch "
	    "nie heraus bekommen.");
  
  AddDetail( ({"rast"}),
	    "Du koenntest hier ja auch ein wenig rasten, wenn Du Zeit dazu "
	    "hast.");

  AddDetail( ({"etwas"}),
	    "Was hier gekocht wurde ist nicht klar, aber Du kannst ein paar "
	    "Sachen zwischen den abgebrannten Holzscheiten entdecken.");
  
  AddDetail( ({"boden"}),
	    "Der Boden des Weges ist mit kleinen Steinchen bedeckt.");

  AddDetail( ({"sachen"}), 
            "Du erkennst ein paar Knochen.");

  AddDetail( ({"holzscheite","holzscheiten","scheite","holz"}),
	    "Das Holz ist komplett abgebrannt.");

  AddDetail( ({"knochen"}),
	    "Neben den abgenagten Knochen siehst Du auch einen Schaedel.");

  AddDetail( ({"schaedel","schaedels"}),
	    "Beim Anblick des Schaedels wird Dir schlecht. Es scheint ein "
	    "menschliches Wesen gewesen sein.");
  
  AddDetail( ({"anblick"}),
	    "So ein Anblick gefaellt Dir gar nicht.");

  AddDetail( ({"wesen"}),
	    "Du bedauerst das arme Wesen.");
  
  AddDetail( ({"steinchen"}),
	    "Lauter Steinchen liegen am Boden.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist wohl irgendwo ueber Dir.");

  AddDetail( ({"wald"}),
	    "Du bist mitten im Wald.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Feuer.");  
 
  AddSmell( ({"feuer","geruch"}),
	   "Der Geruch stammt sicher von dem abgebrannten Lagerfeuer.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel in den Baeumen.");

  AddSound( ({"voegel"}),
	   "*triller*");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas59");
AddExit("suedosten", ROOM "luifinlas61");

}
