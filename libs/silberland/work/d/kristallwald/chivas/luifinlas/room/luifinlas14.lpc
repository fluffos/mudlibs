// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Platz von Luifinlas");
  SetProp( P_INT_LONG,
	"Die Strasse fuehrt an vielen Haeusern vorbei und muendet im Osten "
	"auf dem grossen Platz von Luifinlas. Auf beiden Seiten der Strasse "
	"gibt es unterschiedlichste Laeden, wo Sachen allerart angeboten "
	"werden." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"strasse"}),
	    "Du befindest Dich auf einer Strasse.");

  AddDetail( ({"haeusern","haeuser"}),
	    "In den Haeusern wohnen viele Einwohner von Luifinlas.");
  
  AddDetail( ({"osten","platz"}),
	    "Im Osten ist ein grosser Platz mit einem Denkmal.");

  AddDetail( ({"luifinlas","stadt"}), 
            "Du bist in Luifinlas.");

  AddDetail( ({"seiten","laeden"}),
	    "Es gibt unzaehlige Laeden in Luifinlas.");

  AddDetail( ({"sachen"}),
	    "In dieser Stadt kannst Du fast alles kaufen.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit Steinen gepflastert.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ueber Dir ist herrlich blau.");

  AddDetail( ({"denkmal"}),
	    "Das Denkmal ist sehr gross. Um es genauer zu betrachten, musst Du "
	    "jedoch weiter nach Osten gehen.");
  
  AddDetail( ({"steine","steinen"}),
	    "Grosse Steine bilden die gepflasterte Strasse. Zwischen ihnen "
	    "wachsen hier und da ein paar Grasbueschel.");

  AddDetail( ({"grasbueschel","gras","bueschel"}), 
            "Das Gras hat keine grosse Chance zu wachsen, da es von den vielen "
	    "Leuten auf der Strasse staendig nieder getrampelt wird.");

  AddDetail( ({"chance","chancen"}),
	    "Du hast alle Chancen.");

  AddDetail( ({"leuten","leute"}),
	    "Es herrscht ein reges Treiben auf der Strasse.");

  AddDetail( ({"treiben"}),
	    "Hier sind viele Leute auf der Strasse. Im Osten auf dem Platz "
	    "sind noch mehr.");
  
  AddDetail( ({"wald"}),
	    "Hier ist kein Wald, da musst Du schon die Stadt verlassen.");

  AddDetail( ({"ohren"}),
	    "Du hast grosse Ohren.");

  AddDetail( ({"einwohner"}),
	    "Luifinlas hat viele Einwohner.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Stadt.");  
 
  AddSmell( ({"stadt"}),
	   "Die Stadt riecht anders als der Wald ausserhalb.");

  AddSound(DEFAULT_SOUND, "Es herrscht viel Laerm.");

  AddSound( ({"laerm"}),
	   "Du haelst Dir die Ohren zu.");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "luifinlas13");
AddExit("osten", ROOM "luifinlas15");


}
