// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Wald ist riesig, in dem Du Dich befindest. Die Baeume ruecken in "
	"Richtung Nordwesten immer dichter an den Weg und die Helligkeit "
	"nimmt ab. Hier stehen die Baeume zwar dicht, aber Du kannst alles gut "
	"erkennen. Im Osten scheint eine Hoehle am Wegrand zu sein." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wald"}),
	    "Der Wald ist wirklich riesig, in dem Du Dich befindest.");

  AddDetail( ({"baeume","baeumen"}),
	    "Die Baeume stehen zwar dicht hier, aber in Richtung Nordwesten "
	    "wirkt der Wald noch dichter.");
  
  AddDetail( ({"richtung","nordwesten"}),
	    "In Richtung Nordwesten ist es richtig dunkel.");

  AddDetail( ({"weg"}), 
            "Der Weg auf dem Du stehst fuehrt Dich nach Nordwesten in den "
	    "dunklen Wald oder nach Osten, wo man auch so gut sehen kann.");

  AddDetail( ({"helligkeit","ordnung"}),
	    "Die Helligkeit ist hier in Ordnung, nimmt aber im Nordwesten "
	    "stark ab.");

  AddDetail( ({"osten","hoehle","wegrand"}),
	    "Geh einfach mal hin.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen kleine Steinchen, die den Weg bilden.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist nur zu erahnen.");

  AddDetail( ({"steinchen"}),
	    "Die Steinchen sind klein und uninteressant.");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht waldig.");  

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel.");

  AddSound( ({"voegel"}),
	   "*zwitscher*");
  
//-----Details Ende-----
  
AddExit("nordwesten", ROOM "luifinlas89");
AddExit("osten", ROOM "luifinlas87");

}

