// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Am Suedtor von Luifinlas");
  SetProp( P_INT_LONG,
	"Du stehst mitten im Durchgang durch die grosse und maechtige "
	"Stadtmauer von Luifinlas. Das Tor ist geoeffnet und Du kannst aus der "
	"Stadt heraus gehen oder sie betreten. Die dicken Steinquader der "
	"Stadtmauer sind an dieser Stelle gut zu sehen und zeigen erst wie "
	"dick die Mauer ist." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"durchgang"}),
	    "Der Durchgang durch die Stadtmauer ist sehr breit. Du kannst die "
	    "dicken Steinquader sehen, welche die Stadtmauer bilden.");

  AddDetail( ({"stadtmauer","mauer"}),
	    "Die Stadtmauer umschliesst die gesamte Stadt. Du kannst sie hier "
	    "durch den Durchgang betreten, da das Tor offen ist.");
  
  AddDetail( ({"luifinlas","stadt"}),
	    "Du stehst im Durchgang zu Luifinlas.");

  AddDetail( ({"steinquader","schutz","tonnen"}), 
            "Die grossen Steinquader wiegen sicher mehrere Tonnen und bilden "
	    "einen grossartigen Schutz fuer die Stadt.");

  AddDetail( ({"stelle","blick"}),
	    "Hier kannst Du einen guten Blick auf die Mauer werfen.");

  AddDetail( ({"boden"}),
	    "Der Boden geht hier vom steinigen Weg in eine gepflasterte "
	    "Strasse ueber.");

  AddDetail( ({"himmel"}),
	    "Den Himmel kannst Du hier im Durchgang nicht sehen.");
  
  AddDetail( ({"weg"}),
	    "Der Weg fuehrt aus der Stadt heraus.");

  AddDetail( ({"strasse"}),
	    "Die Strasse fuehrt in die Stadt hinein.");
  
  AddDetail( ({"tor"}),
	    "Das Tor im Durchgang ist geoeffnet. Es besteht aus Holz und "
	    "Eisen.");

  AddDetail( ({"holz"}),
	    "Das Holz besteht aus dicken Eichenbohlen.");

  AddDetail( ({"eichenbohlen","bohlen"}),
	    "Die Bohlen sind dick und halten einiges aus.");

  AddDetail( ({"eisen"}),
	    "Das Eisen verstaerkt das Tor noch weiter.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Stadt.");  
 
  AddSmell( ({"stadt","gerueche"}),
	   "Die Stadt hat viele Gerueche.");

  AddSound(DEFAULT_SOUND, "Du hoerst alle Laute ein wenig hohl.");

  AddSound( ({"laute"}),
	   "Die Laute sind hier im Durchgang ein wenig hohl.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas30");
AddExit("sueden", ROOM "luifinlas32");

}
