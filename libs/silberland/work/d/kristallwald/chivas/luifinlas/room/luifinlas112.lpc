// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Strasse in Luifinlas");
  SetProp( P_INT_LONG,
	"Die Strasse endet hier an der Stadtmauer. Sie erhebt sich vor Dir "
	"im Westen und im Osten fuehrt Dich die Strasse wieder "
	"weg von hier. Ansonsten siehst Du verschiedene Haeuser, die alle "
	"schon bessere Zeiten erlebt haben." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"strasse"}),
	    "Die Strasse endet hier vor der Stadtmauer. An beiden Seiten der "
	    "Strasse stehen Haeuser, die schon einmal in einem besseren "
	    "Zustand waren. Dies ist sicher nicht das Viertel der reichen "
	    "Leute.");

  AddDetail( ({"stadtmauer","mauer","seite","schutz","feinde","feinden"}),
	    "Die Stadtmauer ragt vor Dir auf. Sie ist sehr hoch und bietet "
	    "einen guten Schutz vor Feinden, die vielleicht ausserhalb lauern. "
	    "Auf der anderen Seite, kannst Du die Stadt auch hier nicht "
	    "verlassen. Sie ist viel zu hoch um drueber zu klettern.");
  
  AddDetail( ({"westen"}),
	    "Im Westen ist die hohe Stadtmauer.");

  AddDetail( ({"osten"}), 
            "Im Osten fuehrt die Strasse von hier weg.");

  AddDetail( ({"haeuser","seiten"}),
	    "Die Haeuser, die hier stehen sehen ein wenig schaebig aus. Die "
	    "ehemals weisse Farbe der Waende blaettert ab und die Fenster sind "
	    "sehr dreckig.");

  AddDetail( ({"zeiten","zustand","beste"}),
	    "Es gab schon bessere Zeiten fuer dieses Viertel. Die Zeiten sind "
	    "aber schon lange vorbei. Der Zustand der Haeuser ist nicht der "
	    "Beste.");

  AddDetail( ({"boden"}),
	    "Der Boden der Strasse ist gepflastert und Du siehst hier und da "
	    "Muell am Boden liegen.");
  
  AddDetail( ({"himmel"}),
	    "Wenigstens ist hier der Himmel schoen blau.");

  AddDetail( ({"viertel"}),
	    "Das Viertel ist ein wenig herunter gekommen, aber wer will auch "
	    "schon in der Naehe des Gefaengnis wohnen.");
  
  AddDetail( ({"leute"}),
	    "Anstaendige Leute wohnen woanders in Luifinlas.");

  AddDetail( ({"stadt","luifinlas"}), 
            "Du bist in der Stadt Luifinlas.");

  AddDetail( ({"farbe"}),
	    "Die Farbe an den Waenden war mal weiss. Jetzt ist sie braun oder "
	    "abgeblaettert.");

  AddDetail( ({"waende"}),
	    "Die Waende sahen sicher mal schoen weiss aus. Es ist aber schon "
	    "lange her.");

  AddDetail( ({"fenster"}),
	    "Die Fenster sind dreckig. Unter einem Fenster haengt noch ein "
	    "Blumenkasten.");
  
  AddDetail( ({"muell"}),
	    "Es liegt viel Muell hier herum.");

  AddDetail( ({"naehe","gefaengnis"}),
	    "Ein Gefaengnis ist gleich in der Naehe.");
  
  AddDetail( ({"blumenkasten","blumen"}),
	    "Die Blumen in dem Blumenkasten sind schon vor langem verwelkt.");

  AddDetail( ({""}), 
            "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Muell.");  
 
  AddSmell( ({"muell"}),
	   "Der Muell auf der Strasse riecht.");

  AddSound(DEFAULT_SOUND, "Es ist recht still hier.");

//-----Details Ende-----
  
AddExit("osten", ROOM "luifinlas110");
AddExit("sueden", ROOM "luifbau14");

}
