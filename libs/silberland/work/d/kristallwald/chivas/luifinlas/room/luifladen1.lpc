
inherit "std/laden";

#include "../def.h"
#include <laden.h>

void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));

  SetProp(P_INT_SHORT,"In einem Laden in Luifinlas");
  SetProp(P_SHOPKEEPER_ID, "orgot");
  SetProp(P_SHOPKEEPER_NAME, "orgot");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);

  SetStorageRoom(ROOM "luiflager" );

//-----Anfang Details-----------------

  AddDetail( ({"laden","laeden"}),
	    "Du bist in einem der vielen Laeden von Luifinlas. Dieser hier "
	    "gehoert Orgot, dem Troll.");

  AddDetail( ({"orgot","troll","besitzer"}),
	    "Orgot ist der Besitzer des Ladens und ein grosser Troll."); 

  AddDetail( ({"waren"}),
	    "Du kannst hier alle moeglichen Waren kaufen.");

  AddDetail( ({"luifinlas","stadt"}),
	    "Du bist in der Stadt Luifinlas.");

  AddDetail( ({"inventar"}),
	    "Das Inventar besteht aus einem Tresen und vielen Regalen. Alles "
	    "sieht ein wenig groeber aus. Orgot hat es anscheinend selber "
	    "gebaut und ist als Troll nicht besonders handwerklich begabt."); 

  AddDetail( ({"regale","last","regal"}),
	    "Die Regale sind voll gestellt mit allen moeglichen Waren, die man "
	    "hier kaufen kann. Sie biegen sich unter der Last und sind dazu "
	    "auch noch schief.");

  AddDetail( ({"tresen","verkaufstresen"}),
	    "Der Tresen ist eigenlich nur ein dickes Brett auf zu grossen "
	    "Holzkloetzen. Orgot hat sich dabei nicht sehr viel Muehe "
	    "gegeben."); 

  AddDetail( ({"boden","holz"}),
	    "Der Boden besteht aus Holz und ist sehr dreckig. Hier wurde schon "
	    "lange nicht mehr durchgefegt.");

  AddDetail( ({"decke"}),
	    "Die Decke ist beeindruckend uninteressant."); 

  AddDetail( ({"wand","waende","waenden"}),
	    "An den Waenden stehen mehrere Regale und an einer Wand nahe dem "
	    "Eingang haengt eine kleine Tafel.");

  AddDetail( ({"brett"}),
	    "Das Brett ist dick aber noch nicht einmal abgeschliffen. Pass "
	    "auf, dass Du Dir keinen Splitter in den Finger rammst."); 

  AddDetail( ({"holzkloetzen","holzkloetze","kloetze"}),
	    "Es sind grosse runde Holzkloetze. Nicht sehr schoen, aber sie "
	    "erfuellen ihren Zweck.");

  AddDetail( ({"muehe","fall"}),
	    "Du gibst Dir auf jeden Fall immer Muehe."); 

  AddDetail( ({"eingang"}),
	    "Du hast durch den Eingang den Laden betreten.");

  AddDetail( ({"splitter","finger"}),
	    "Du passt genau auf."); 

  AddDetail( ({"zweck"}),
	    "Der Zweck heiligt die Mittel."); 

  AddDetail( ({"Mittel"}),
	    "Verschiedene Mittel kannst Du hier sicher auch kaufen.");

  AddDetail( ({"tafel","sortiment"}),
	    "Auf der Tafel sieht man was man im Laden kaufen kann. Tipp "
	    "'zeige' und Du kriegst das Sortiment angezeigt."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach allen moeglichen Dingen.");  
 
  AddSmell( ({"dinge","dingen","gerueche"}),
	   "Du kannst es nicht genau beschreiben. Zu viele Gerueche sind "
	   "hier im Laden vorhanden.");

  AddSound(DEFAULT_SOUND, "Du hoerst wie im Lager Waren gestapelt werden.");

  AddSound( ({"lager","waren"}),
	   "Anscheinend sind gerade einige Waren vom Regal gefallen. Es hat "
	   "richtig laut gescheppert.");
  
//-----Details Ende-----


  AddExit("nordwesten", ROOM "luifinlas74");

  AddItem(NPC "orgot", REFRESH_DESTRUCT);
}

string _query_int_long()
{
  string txt;

  txt = "Dies ist der Laden von Orgot dem Troll. Er verkauft hier in seinem "
	"Laden alle moeglichen Waren. Der Laden ist ein wenig groesser als "
	"normal und das Inventar ist groeber als man es gewohnt ist. "
	"Anscheinend hat Orgot als Troll das Inventar selber hergestellt. Die "
	"vielen Regale und auch der Verkaufstresen sind ein wenig schraeg.";

  if(QueryProp(P_SHOPKEEPER_ID))
  {
    if(!present(QueryProp(P_SHOPKEEPER_ID)))
    {
      txt += "Leider ist momentan gerade niemand hier.";
    }
    else
    {
      txt += "";
    }
  }

  return BS(txt);
}
