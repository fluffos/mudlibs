// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl = 1; 

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Wiese");
  SetProp( P_INT_LONG,
	"Lauter Blumen und Gras sind auf der Wiese zu sehen. Auch einige "
	"Baeume wachsen vereinzelt auf ihr. Im Sueden scheinen einige Huegel "
	"zu sein, die auch mit Gras bewachsen sind. Ist das vielleicht das "
	"Dorf Hubbleton?" );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"blumen"}),
	    "Verschiedene kleine Blumen wachsen auf der Wiese.");

  AddDetail( ({"gras"}),
	    "Das Gras auf der Wiese ist halbhoch und schoen gruen. Im Sueden "
	    "ist das Gras kurz gemaeht worden.");
  
  AddDetail( ({"wiese"}),
	    "Die Wiese ist sehr gross.");

  AddDetail( ({"baeume"}), 
            "Einige Baeume stehen auf der Wiese. Du erkennst auch einen "
	    "Birnenbaum.");

  AddDetail( ({"sueden"}),
	    "Im Sueden sind viele Huegel zu sehen.");

  AddDetail( ({"huegel","haeuser"}),
	    "Die Huegel sind die Haeuser der Hobbits von Hubbleton. Das Dorf "
	    "im Sueden.");

  AddDetail( ({"dorf","hubbleton"}),
	    "Das Dorf im Sueden heisst Hubbleton.");
  
  AddDetail( ({"boden"}),
	    "Der Boden ist mit kleinen Steinchen bedeckt, welche den Weg "
	    "bilden, auf dem Du stehst.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau.");
  
  AddDetail( ({"birnenbaum","baum"}),
	    "Ein Birnenbaum steht direkt am Weg. Du erkennst einige Birnen.");

  AddDetail( ({"hobbits"}), 
            "Viele Hobbits wohnen in Hubbleton.");

  AddDetail( ({"weg"}),
	    "Der Weg fuehrt ueber die Wiese.");

  AddDetail( ({"birnen"}),
	    "Vielleicht kannst Du eine erreichen und sie pfluecken?");

  AddDetail( ({"steinchen"}),
	    "Kleine Steinchen liegen auf dem Boden und bilden den Weg.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Gras.");  
 
  AddSmell( ({"gras"}),
	   "Das Gras riecht frisch.");

  AddSound(DEFAULT_SOUND, "Du hoerst Voegel.");

  AddSound( ({"voegel"}),
	   "Die Voegel fliegen am Himmel und zwitschern.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas66");
AddExit("sueden", ROOM "luifinlas69");

AddCmd( ({"pflueck", "pfluecke" }), "pfluecken" );

}

int pfluecken(string str)
{
  object birne;
  notify_fail( "Was willst Du denn pfluecken?\n" );
  if ( member( ({ "birne" }), str ) != -1 ) 

   {
     if( anzahl < 1 )
     {
        write("Du willst eine Birne pfluecken, erreichst leider keine \n"
	      "Birne mehr. Anscheinend war jemand schneller als Du und \n"
	      "hat die letzten Birnen in Reichweite bereits gepflueckt.\n");
        say(sprintf("%s tut nichts.\n", TP->Name(WER)));
        return -1;
     }
      if ( present("birne",TP) )
      {
      write("Da Du bereits eine hast, willst Du den anderen auch welche "
	    "ueberlassen.\n" );
      say(sprintf("%s tut nichts, sondern macht nur Bloedsinn.\n", TP->Name(WER)));
      return -1;
      }
      else
      {
        {birne = clone_object("/d/kristallwald/chivas/zentauren/obj/birne");
        if ( ME_TOO_HEAVY == birne->move(TP,M_GET|M_SILENT) )

          {
          write(
          "Die Birne wuerde Dir zu schwer werden. Du Weichei.\n" );
          say(BS(sprintf("%s ist einfach zu weich fuer das Silberland.\n", TP->Name(WER))));
          birne -> remove();
          return 1;
          }
          else
          {
          write("Du pflueckst eine Birne von einem Ast in Reichweite und "
		"steckst sie ein.\n");
          say(sprintf("%s pflueckt eine Birne und steckt sie ein.\n",
          TP->Name(WER)));
          anzahl--;
          return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}
