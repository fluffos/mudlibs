// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Wald wird im Sueden lichter als hier. An der einen Seite des "
	"Weges scheint er an einem kleinen See vorbei zu gehen. Die Baeume "
	"stehen hier jedoch noch dicht am Weg." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wald"}),
	    "Der Wald ist recht dicht, wird aber im Sueden lichter als hier.");

  AddDetail( ({"sueden"}),
	    "Im Sueden scheint ein See zu sein.");
  
  AddDetail( ({"seite"}),
	    "Auf einer Seite des Weges im Sueden ist ein See.");

  AddDetail( ({"weg","weges"}), 
            "Der Weg fuehrt nach Norden oder nach Suedosten an einem See "
	    "vorbei.");

  AddDetail( ({"see"}),
	    "Geh doch naeher ran. Dann kannst Du ihn besser sehen.");

  AddDetail( ({"baeume"}),
	    "Viele Baeume stehen am Weg, aber das ist wohl auch normal fuer "
	    "einen Wald.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen Blaetter und Aeste.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel im Suedosten scheint blau zu sein. Hier ist das "
	    "Blaetterdach noch zu dicht um alles genau zu sehen.");

  AddDetail( ({"blaetterdach","dach","moeglichkeit"}),
	    "Das Blaetterdach ueber Dir ist sehr dicht und bietet Dir kaum die "
	    "Moeglichkeit den Himmel zu sehen.");
  
  AddDetail( ({"blaetter"}),
	    "Die Blaetter sind sicher von den Baeumen gefallen.");

  AddDetail( ({"aeste"}), 
            "Die Aeste stammen von den Baeumen am Rand des Weges.");

  AddDetail( ({"rand"}),
	    "Am Rand stehen viele Baeume.");

  AddDetail( ({""}),
	    "");


  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Wald.");  
 
  AddSmell( ({"wald"}),
	   "Es riecht waldig.");

  AddSound(DEFAULT_SOUND, "Du hoerst den See im Suedosten.");

  AddSound( ({"see"}),
	   "Du hoerst ein Platschen.");

  AddSound( ({"platschen","fisch"}),
	   "Anscheinend ist ein Fisch hochgesprungen und wieder im See "
	   "gelandet.");

//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas54");
AddExit("suedosten", ROOM "luifinlas56");

}
