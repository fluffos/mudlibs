// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Strasse in Luifinlas");
  SetProp( P_INT_LONG,
	"In dieser Strasse befinden sich hauptsaechlich Wohnhaeuser der "
	"Einwohner von Luifinlas. Nur das Haus im Sueden ist nicht zum "
	"Wohnen geeignet. Am Eingang des Hauses haengt ein grosses "
	"goldenes Schild." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"strasse","nordosten","nordwesten"}),
	    "Die Strasse fuehrt nach Nordwesten oder Nordosten. An ihr "
	    "stehen hauptsaechlich Wohnhaeuser und ein grosses besonderes "
	    "Haus.");

  AddDetail( ({"wohnhaeuser","haeuser","fenster","fenstern"}),
	    "Die Wohnhaeuser sehen sehr gepflegt aus und hier moechte man "
	    "gerne wohnen. Vor den Fenstern haengen Blumenkaesten.");
  
  AddDetail( ({"einwohner","buerger"}),
	    "Hier wohnen viele Buerger von Luifinlas.");

  AddDetail( ({"luifinlas"}), 
            "Du bist in Luifinlas.");

  AddDetail( ({"wohnen"}),
	    "Das Haus im Sueden ist nicht zum Wohnen geeignet.");

  AddDetail( ({"haus","hauses","sueden"}),
	    "Das grosse Haus im Sueden hat nur schmale Fenster und sieht sehr "
	    "edel aus. Grosse Saeulen sind vor dem Haus zu sehen und es macht "
	    "einen sehr teuren Eindruck. Es ist die Bank von Luifinlas.");

  AddDetail( ({"schild"}),
	    "Du kannst es lesen.");
  
  AddDetail( ({"eingang"}),
	    "Am Eingang haengt ein grosses Schild.");

  AddDetail( ({"boden"}),
	    "Der Boden der Strasse ist gepflastert.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen blau.");

  AddDetail( ({"saeulen"}), 
            "Die Saeulen verpassen dem Haus etwas serioeses.");

  AddDetail( ({"eindruck"}),
	    "Das Haus macht einen sehr reichen Eindruck.");

  AddDetail( ({"bank"}),
	    "Geh einfach mal rein.");

  AddDetail( ({"blumenkaesten"}),
	    "Vor den Wohnhaeusern haengen einige Blumenkaesten. Viele Blumen "
	    "stecken in den Blumenkaesten.");

  AddDetail( ({"blumen"}),
	    "Du siehst rote, blaue und gelbe Blumen in den Blumenkaesten.");

  AddDetail( ({""}),
	    "");
      
  AddReadDetail( ({"schild"}),
	    "+----------------------------------+\n"
	    "|                                  |\n"
	    "|               Bank               |\n"
	    "|          von Luifinlas           |\n"
	    "|                                  |\n"
	    "+----------------------------------+\n");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen in den Blumenkaesten duften herrlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Geraeusche einer Stadt.");

  AddSound( ({"geraeusche","stadt"}),
	   "Es sind zu viele um sie auseinander zu halten.");
  
//-----Details Ende-----
  
AddExit("nordwesten", ROOM "luifinlas70");
AddExit("nordosten", ROOM "luifinlas106");
AddExit("suedosten", ROOM "luifbau8");
AddExit("sueden", ROOM "luifbank");

}
