// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Waldweg");
  SetProp( P_INT_LONG,
	"Der Wald ist hier ein wenig lichter als im Nordosten, wo er sehr "
	"dicht und dunkel zu sein scheint. Im Westen ist eine grosse Lichtung "
	"zu sehen auf die die Sonne scheint. Die grossen Baeume links und "
	"rechts des Weges stehen nicht sehr dicht und einige Straeucher sind "
	"zu sehen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wald"}),
	    "Die Baeume des Waldes stehen hier nicht so eng nebeneinander. Sie "
	    "bieten auch kleinen Straeuchern genuegend Platz um hier zu "
	    "wachsen.");

  AddDetail( ({"nordosten"}),
	    "Im Nordosten ist der Wald viel dichter als hier.");
  
  AddDetail( ({"westen"}),
	    "Im Westen kannst Du eine grosse Lichtung sehen.");

  AddDetail( ({"lichtung"}), 
            "Du siehst im Westen eine grosse Lichtung auf der viele Blumen "
	    "wachsen.");

  AddDetail( ({"sonne"}),
	    "Die Sonne scheint auf die grosse Lichtung und es scheint dadurch "
	    "dort sehr schoen zu sein.");

  AddDetail( ({"baeume","baeumen"}),
	    "Die grossen Baeume wachsen links und rechts des Weges.");

  AddDetail( ({"weg","weges"}),
	    "Der Weg fuehrt Dich entweder nach Nordosten tiefer in den Wald "
	    "oder nach Westen auf eine grosse Lichtung.");
  
  AddDetail( ({"straeucher","platz","straeuchern"}),
	    "Einige Straeucher nutzen den Platz zwischen den Baeumen um hier "
	    "zu wachsen.");

  AddDetail( ({"boden"}),
	    "Kleine Steinchen bilden den Weg, auf dem Du Dich befindest.");
  
  AddDetail( ({"blumen"}),
	    "Viele Blumen wachsen auf der Lichtung. Geh doch einfach mal hin.");

  AddDetail( ({"steinchen"}), 
            "Viele Steinchen liegen am Boden. Es faellt Dir keiner besonders "
	    "auf.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist ueber Dir.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Wald.");  
 
  AddSmell( ({"wald"}),
	   "Dies ist vollkommen normal, wenn man sich in einem befindet.");

  AddSound(DEFAULT_SOUND, "Es hoert sich nach Wald an.");

  AddSound( ({"wald"}),
	   "Es ist vollkommen normal, wenn es sich in einem Wald auch nach "
	   "Wald anhoert.");
  
//-----Details Ende-----
  
AddExit("nordosten", ROOM "luifinlas41");
AddExit("westen", ROOM "luifinlas43");

}
