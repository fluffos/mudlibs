// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Lichtung");
  SetProp( P_INT_LONG,
	"Du stehst am Rand einer grossen Lichtung, die sich vor Dir nach "
	"Sueden ausbreitet. Der Weg auf dem Du stehst, fuehrt entweder nach "
	"Norden in den angrenzenden Wald oder nach Suedosten ueber die "
	"Lichtung, wo viele Blumen im Gras wachsen und auch einige Obstbaeume "
	"stehen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"rand"}),
	    "Du stehst am Rand eines Waldes. Im Sueden vor Dir liegt eine "
	    "grosse Lichtung, auf der Du Obstbaeume, Blumen und Gras "
	    "erkennst.");

  AddDetail( ({"lichtung"}),
	    "Die Lichtung ist sehr gross und wird von dem umliegenden Wald "
	    "eingerahmt. Auf ihr stehen einige Obstbaeume weiter im Suedosten "
	    "und viele Blumen und Gras sind auf ihr zu sehen.");
  
  AddDetail( ({"sueden"}),
	    "Im Sueden liegt die grosse Lichtung.");

  AddDetail( ({"weg"}), 
            "Der Weg fuehrt nach Norden in den Wald oder nach Suedosten ueber "
	    "die Lichtung.");

  AddDetail( ({"norden"}),
	    "Im Norden beginnt der Wald.");

  AddDetail( ({"suedosten"}),
	    "Nach Suedosten fuehrt der Weg an ein paar Obstbaeumen vorbei "
	    "ueber die Lichtung.");

  AddDetail( ({"blumen"}),
	    "Viele bunte Blumen wachsen auf der Lichtung. Du kennst Dich aber "
	    "mit Blumen nicht so gut aus.");
  
  AddDetail( ({"gras"}),
	    "Das Gras auf der Lichtung ist recht hoch gewachsen.");

  AddDetail( ({"obstbaeume","obstbaeumen"}),
	    "Die Obstbaeume im Suedosten sind Apfelbaeume.");
  
  AddDetail( ({"baeume"}),
	    "Was fuer Baeume meinst Du? Obstbaeume oder Waldbaeume?");

  AddDetail( ({"waldbaeume","eichen","buchen","tannen","fichten","arten"}), 
            "Du erkennst ein paar Eichen, Buchen, Tannen und Fichten. "
	    "Eigentlich sind viele verschiedene Arten zu sehen.");

  AddDetail( ({"wald","waldes"}),
	    "Der Wald beginnt gleich im Norden.");

  AddDetail( ({"boden"}),
	    "Der Boden des Weges besteht aus kleinen Steinen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ueber Dir ist blau und die Sonne scheint.");
  
  AddDetail( ({"apfelbaeume"}),
	    "Geh einfach hin und schau sie Dir im Suedosten genauer an.");

  AddDetail( ({"steinen","steine"}),
	    "Die Steine bilden den Weg, so dass er sich gut erkennbar von dem "
	    "Gras der Lichtung abhebt.");
  
  AddDetail( ({"sonne"}),
	    "Die Sonne waermt Dich.");

  AddDetail( ({""}), 
            "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen und Wald.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen duften suess.");
  
  AddSmell( ({"wald","geruch"}),
	   "Der Wald hat seinen eigenen Geruch. Du magst ihn.");

  AddSound(DEFAULT_SOUND, "Du hoerst viele Voegel in den Baeumen des Waldes.");

  AddSound( ({"voegel","lied"}),
	   "Die Voegel singen Dir ein Lied.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifhd3");
AddExit("suedosten", ROOM "luifhd1");

}
