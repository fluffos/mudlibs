// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Strasse in Luifinlas");
  SetProp( P_INT_LONG,
	"Die Haeuser sehen aermlich aus und sie sind nicht sehr gross. Die "
	"Strasse wirkt ein wenig dreckiger als in anderen Vierteln der Stadt."
	"Die Strassen nach Norden und Westen scheinen direkt an der "
	"Stadtmauer zu enden." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"haeuser"}),
	    "Die Haeuser wirken aermlich und sie sind in einem schlechten "
	    "Zustand.");

  AddDetail( ({"strasse","strassen","norden","westen"}),
	    "Die Strasse ist gepflastert und es liegt ein wenig Muell herum. "
	    "Die Strassen nach Norden und Westen enden vor der Stadtmauer von "
	    "Luifinlas.");
  
  AddDetail( ({"viertel","vierteln"}),
	    "Es gibt gute und weniger gute Viertel in Luifinlas. Entscheide "
	    "Du, in was fuer einem Du gerade bist.");

  AddDetail( ({"stadt","luifinlas"}), 
            "Du bist in einer grossen Stadt.");

  AddDetail( ({"stadtmauer"}),
	    "Die Stadtmauer ist im Westen und Norden zu sehen. Geh einfach mal "
	    "hin um sie genauer zu sehen.");

  AddDetail( ({"boden","steine","steinen"}),
	    "Der Boden besteht aus grossen Steinen und es liegt Muell herum.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist sogar hier blau.");
  
  AddDetail( ({"zustand"}),
	    "Die Farbe blaettert von den Waenden und sie wirken allgemein "
	    "sehr schmutzig.");

  AddDetail( ({"waende","waenden","farbe","stellen"}),
	    "Es gab sicher mal weisse Farbe an den Waenden, jedoch ist sie "
	    "an vielen Stellen abgeblaettert oder nur noch braun.");
  
  AddDetail( ({"muell"}),
	    "Hier wird anscheinend nicht so haeufig sauber gemacht.");

  AddDetail( ({""}), 
            "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig nach Muell.");  
 
  AddSmell( ({"muell","geruch"}),
	   "Der Geruch stammt von dem Muell, der hier auf der Strasse liegt.");

  AddSound(DEFAULT_SOUND, "Es ist still. Viel zu still fuer eine Stadt.");

//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas111");
AddExit("westen", ROOM "luifinlas112");
AddExit("suedosten", ROOM "luifinlas83");

}
