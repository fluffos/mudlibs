// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg in einem dunklen Wald");
  SetProp( P_INT_LONG,
	"Der Weg steigt nach Nordwesten an und die Baeume nehmen rasant ab. "
	"Nach Sueden ist der Wald noch viel dichter und es herrscht dort "
	"absolute Finsternis. Hier stehen die Baeume zwar dicht und es ist "
	"recht dunkel, aber man kann auch ein wenig sehen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"weg","weges"}),
	    "Der Weg fuehrt entweder nach Nordwesten, wo er ansteigt oder nach "
	    "Sueden, wo der Wald stockfinster zu sein scheint.");

  AddDetail( ({"nordwesten","nordwestoben"}),
	    "Es geht nach Nordwestoben raus aus dem Wald.");
  
  AddDetail( ({"baeume","blaetterdach","lichtstrahl"}),
	    "Die Baeume stehen hier sehr dicht und es ist dunkel. Ihr "
	    "Blaetterdach ist nahezu komplett dicht und kaum ein Lichtstrahl "
	    "trifft den Boden.");

  AddDetail( ({"sueden"}), 
            "Im Sueden herrscht absolute Dunkelheit.");

  AddDetail( ({"wald"}),
	    "");

  AddDetail( ({"finsternis","dunkelheit"}),
	    "Im Sueden braucht man eine Lichtquelle, da dort nichts zu "
	    "sehen ist.");

  AddDetail( ({"boden"}),
	    "Der Boden des Weges ist wie immer gleich.");
  
  AddDetail( ({"himmel"}),
	    "Den Himmel kannst Du kaum erkennen.");

  AddDetail( ({"lichtquelle","dunkelelf"}),
	    "Ohne Lichtquelle kannst Du im Sueden nur als Dunkelelf was "
	    "sehen.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig waldig.");  

  AddSound(DEFAULT_SOUND, "Du hoerst vereinzelt einen Vogel.");

  AddSound( ({"vogel"}),
	   "*piep*");
  
//-----Details Ende-----
  
AddExit("nordwestoben", ROOM "luifinlas98");
AddExit("sueden", ROOM "luifinlas91");

}

