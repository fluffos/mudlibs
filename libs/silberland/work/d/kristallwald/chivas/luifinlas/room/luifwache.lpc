// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Stadtwache von Luifinlas");
  SetProp( P_INT_LONG,
	"In der Wache gibt es mehrere Schreibtische, an denen die Wachen "
	"ihre Bueroarbeit erledigen koennen. Ausserdem sind einige Betten zu "
	"sehen, in denen die Wachen sich ausruhen koennen, wenn sie "
	"Nachtschicht haben. An den Waenden haengen lauter Fotos von "
	"Verdaechtigen, die von der Wache gesucht werden." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wache","stadtwache","hauptquartier"}),
	    "Du bist in der Stadtwache von Luifinlas.");

  AddDetail( ({"schreibtische"}),
	    "Die Schreibtische sind mit vielen Ordnern und Akten bedeckt. Hier "
	    "gibt es anscheinend einiges nachzuarbeiten.");
  
  AddDetail( ({"wachen"}),
	    "Die Wachen der Stadt haben hier ihr Hauptquartier.");

  AddDetail( ({"bueroarbeit","arbeit"}), 
            "Wie die Schreibtische aussehen, gibt es hier noch viel "
	    "Bueroarbeit zu tun.");

  AddDetail( ({"betten","nachtschicht","einsatz"}),
	    "Die Betten sind fuer die Wachen der Nachtschicht, so dass sie "
	    "sich ausruhen koennen, wenn kein Einsatz ansteht.");

  AddDetail( ({"waenden","waende","wand"}),
	    "An den Waenden haengen lauter Fotos und ein grosser "
	    "Waffenschrank.");

  AddDetail( ({"fotos","verdaechtigen","verdaechtige"}),
	    "Als Du Dir die Fotos ansiehst, faellt Dir ein Foto besonders "
	    "auf.");
  
  AddDetail( ({"boden","steinplatten"}),
	    "Der Boden besteht aus Steinplatten.");

  AddDetail( ({"decke"}),
	    "An der Decke haengt ein grosser Leuchter.");
  
  AddDetail( ({"luifinlas","stadt"}),
	    "Du bist in der Stadtwache von Luifinlas.");

  AddDetail( ({"ordnern","ordner","verhoere","beweise","faelle","faellen"}), 
            "Die Ordner beinhalten Verhoere und Beweise von Faellen, die hier "
	    "bearbeitet werden.");

  AddDetail( ({"akten"}),
	    "Die Akten beschaeftigen sich mit einzelnen Verdaechtigen.");

  AddDetail( ({"waffenschrank","schrank"}),
	    "Der Waffenschrank hat eine mit Eisenstaeben abgesicherte "
	    "Glasscheibe. Durch die Scheibe kannst Du verschiedene Waffen "
	    "sehen.");

  AddDetail( ({"foto"}),
	    "Du laechelst Dich selbst von dem Foto aus an. Du wirst rot und "
	    "fuehlst Dich auf einmal gar nicht mehr so gut hier in der Wache.");
  
  AddDetail( ({"leuchter"}),
	    "Auf dem Leuchter stecken viele Kerzen.");

  AddDetail( ({"kerzen"}),
	    "Die Kerzen sind aus, da genug Licht durch die Fenster dringt.");
  
  AddDetail( ({"licht","tag"}),
	    "Draussen ist es heller Tag, darum dringt genug Licht durch den "
	    "Eingang und die Fenster in die Wache.");

  AddDetail( ({"fenster"}), 
            "Die Fenster sind sauber geputzt und das Licht faellt ungehindert "
	    "in die Wache hinein.");

  AddDetail( ({"eingang"}),
	    "Durch den Eingang hast Du die Stadtwache betreten.");

  AddDetail( ({"eisenstaebe","eisenstaeben"}),
	    "Die Eisenstaebe sichern den Waffenschrank, so dass keiner die "
	    "Waffen so einfach nehmen kann, auch wenn er die Scheibe "
	    "zerschlaegt.");

  AddDetail( ({"glasscheibe","scheibe"}),
	    "Hinter der Glasscheibe siehst Du viele Waffen.");
  
  AddDetail( ({"waffen"}),
	    "Du siehst verschiedene Schwerter und auch einige Hellebarden und "
	    "Aexte im Waffenschrank.");

  AddDetail( ({"schwerter"}),
	    "Die Schwerter sehen sehr scharf aus.");
  
  AddDetail( ({"hellebarden"}),
	    "Die Hellebarden werden von der Stadtwache sehr gerne benutzt.");

  AddDetail( ({"aexte","zwergen","zwerge"}), 
            "Die Aexte werden hauptsaechlich von den Zwergen der Stadtwache "
	    "benutzt.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht hier recht steril.");  
 
  AddSound(DEFAULT_SOUND, "Es ist recht still.");

//-----Details Ende-----
  
AddExit("sueden", ROOM "luifinlas83");

}
