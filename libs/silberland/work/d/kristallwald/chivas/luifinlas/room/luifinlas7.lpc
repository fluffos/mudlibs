// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Die Baeume nehmen hier ein wenig ab und im Suedosten gibt es noch "
	"weniger Baeume zu sehen. Grosse Straeucher stehen am Wegrand und auch "
	"ein grosser Ameisenhuegel ist zu sehen. Nach Westen hin ist der Wald "
	"viel dichter und der Weg fuehrt unter dem dichten Blaetterdach "
	"weiter." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"baeume"}),
	    "Die Baeume stehen hier nicht so dicht, wie weiter im Westen. Im "
	    "Suedosten sind noch weniger zu sehen und eine Wiese scheint dort "
	    "zu beginnen.");

  AddDetail( ({"straeucher"}),
	    "Grosse Straeucher stehen hier. An einigen haengen ein paar "
	    "Waldbeeren.");

  AddDetail( ({"wegrand","rand"}), 
            "Am Wegrand sind lauter Baeume und Straeucher zu sehen. Auch "
	    "ein grosser Ameisenhuegel ist dort zu erkennen.");

  AddDetail( ({"ameisenhuegel","huegel"}),
	    "Der Ameisenhuegel ist fast so gross wie Du. Die siehst unendlich "
	    "viele Ameisen auf ihm herumkrabbeln.");

  AddDetail( ({"ameisen"}),
	    "Die Ameisen sind beschaeftigt und lassen sich durch Dich nicht "
	    "stoeren.");

  AddDetail( ({"westen"}),
	    "Im Westen ist der Wald viel dichter.");
  
  AddDetail( ({"wald"}),
	    "Du bist mitten im Wald.");

  AddDetail( ({"weg","steinchen"}),
	    "Der Weg auf dem Du Dich befindest ist mit kleinen Steinchen "
	    "bedeckt.");
  
  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach ist zwar dicht, aber man kann ein wenig vom "
	    "Himmel sehen.");

  AddDetail( ({"boden"}), 
            "Am Boden liegen kleine Steinchen und einige Ameisen sind zu "
	    "sehen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel scheint blau zu sein. Du kannst aber durch das "
	    "Blaetterdach nicht so viel erkennen.");

  AddDetail( ({"suedosten","wiese"}),
	    "Im Suedosten scheint der Wald zu enden und eine Wiese beginnt. "
	    "Geh doch einfach hin und schau sie Dir an.");

  AddDetail( ({"waldbeeren","beeren"}),
	    "Die Waldbeeren sehen lecker aus. Du kannst sie ja pfluecken.");
  
  AddDetail( ({"arbeiten","sache"}),
	    "Das ist nicht so Deine Sache.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht waldig.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst ein Knistern.");

  AddSound( ({"knistern"}),
	   "Das Knistern kommt vom Ameisenhuegel, wo die Ameisen am Arbeiten "
	   "sind.");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "luifinlas6");
AddExit("suedosten", ROOM "luifinlas8");

AddCmd( ({"pflueck", "pfluecke" }), "pfluecken" );

}
int pfluecken(string str)
{
   if ( member( ({"beere","beeren","waldbeere","waldbeeren"})
,str) != -1) 
  {
    write( "Du pflueckst ein paar Beeren und schlingst sie sofort herunter. \n"
	   "Sie schmecken herrlich.\n");
    say( TPN+" isst ein paar Beeren.\n");
    return 1;
  }
}
