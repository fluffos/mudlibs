inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Strasse von Luifinlas");
  SetProp( P_INT_LONG,
	"Die Strasse fuehrt schnurgerade von Sueden nach Norden an den "
	"verschiedensten Gebaeuden vorbei. Im Osten schein ein Tischler sich "
	"niedergelassen zu haben, da aus der Tuer lautes Haemmern und Saegen "
	"an Dein Ohr dringt. Im Westen ist ein grosses dunkles Gebaeude zu "
	"sehen, in welches sich immer wieder vermummte Gestalten hinein "
	"verziehen oder aus ihm heraus kommen um sofort wieder im Schatten der "
	"Haeuser zu verschwinden." );
