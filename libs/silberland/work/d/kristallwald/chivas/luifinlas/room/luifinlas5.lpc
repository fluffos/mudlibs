// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Du stehst auf einer Kreuzung mitten im Wald. Der Weg geht nach "
	"Nordwesten, Osten und nach Sueden. An einem der Baeume am Wegrand "
	"haengt ein Wegweiser, der Dir bei Deiner Entscheidung in welche "
	"Richtung Du gehen willst, helfen kann." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"kreuzung"}),
	    "Hier ist eine Kreuzung mitten im Wald, wo Du Dich entscheiden "
	    "musst, wie es weiter gehen soll.");

  AddDetail( ({"wald"}),
	    "Der Wald ist dicht und die Baeume stehen eng am Weg.");
  
  AddDetail( ({"weg"}),
	    "Du befindest Dich auf dem Weg, der sich hier in drei Richtungen "
	    "teilt.");

  AddDetail( ({"nordwesten","osten","sueden","richtungen"}), 
            "Es geht hier in drei Richtungen: Nordwesten, Osten und Sueden.");

  AddDetail( ({"baeume"}),
	    "Die Baeume stehen dicht am Weg. An einem der Baeume haengt ein "
	    "Wegweiser.");

  AddDetail( ({"wegrand","rand"}),
	    "Am Rand stehen lauter Baeume, wie es in einem Wald auch sein "
	    "sollte.");

  AddDetail( ({"wegweiser"}),
	    "Du kannst ihn lesen.");
  
  AddDetail( ({"entscheidung"}),
	    "Du musst hier schon eine Entscheidung treffen oder einfach hier "
	    "idlen.");

  AddDetail( ({"richtung"}),
	    "In welche Richtung willst Du gehen?");
  
  AddDetail( ({"boden","steinchen"}),
	    "Der Boden besteht aus kleinen Steinchen. Vereinzelt trifft ein "
	    "Lichtstrahl auf den Boden.");

  AddDetail( ({"himmel"}), 
            "Der Himmel ist durch das dichte Blaetterdach nur zu erahnen.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach ist hier sehr dicht. Kaum ein Lichtstrahl "
	    "erreicht den Boden.");

  AddDetail( ({"lichtstrahl","lichtstrahlen"}),
	    "Es sind kaum Lichtstrahlen zu sehen.");

  AddDetail( ({""}),
	    "");
  
  AddReadDetail( ({"wegweiser","weiser"}),
	    "+------------------------------------------+\n"
	    "|                                          |\n"
	    "| Hochebene von                            |\n"
	    "|  Gorthad --------------------- Luifinlas |\n"
	    "|                     |                    |\n"
	    "|                     |                    |\n"
	    "|                     |                    |\n"
	    "|                 Hubbleton                |\n"
	    "|                                          |\n"
	    "+------------------------------------------+\n");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht waldig.");  
 
  AddSound(DEFAULT_SOUND, "Es ist hier wirklich ruhig.");

//-----Details Ende-----
  
AddExit("nordwesten", ROOM "luifinlas4");
AddExit("sueden", ROOM "luifinlas71");
AddExit("osten", ROOM "luifinlas6");

}

