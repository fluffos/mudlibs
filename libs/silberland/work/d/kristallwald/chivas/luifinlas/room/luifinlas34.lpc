// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Wald um Dich herum ist sehr dicht bewachsen. Zwischen den "
	"dicken Staemmen der grossen Baeume sind verschiedene Straeucher zu "
	"sehen. Das dichte Blaetterdach ueber Dir bietet der Sonne kaum die "
	"Moeglichkeit den Boden zu erreichen. Im Norden scheint der Wald "
	"lichter zu werden." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wald"}),
	    "Der Wald um Dich herum ist sehr dicht an den Weg gewachsen.");

  AddDetail( ({"staemmen","staemme"}),
	    "Die Baeume haben grosse dicke Staemme.");
  
  AddDetail( ({"baeume","baeumen"}),
	    "Die Baeume sind gross und stehen dicht am Weg.");

  AddDetail( ({"straeucher"}), 
            "Einige kleine Straeucher stehen am Wegrand. Du erkennst auch "
	    "einen Strauch mit Heidelbeeren.");

  AddDetail( ({"blaetterdach","dach","stelle"}),
	    "Das Blaetterdach ist an dieser Stelle sehr dicht.");

  AddDetail( ({"sonne","moeglichkeit"}),
	    "Die Sonne findet kaum eine Moeglichkeit den Boden zu "
	    "erreichen.");

  AddDetail( ({"boden","steinchen"}),
	    "Am Boden liegen die ueblichen kleinen Steinchen.");
  
  AddDetail( ({"norden"}),
	    "Im Norden wird der Wald lichter als er hier ist.");

  AddDetail( ({"himmel"}),
	    "Den Himmel kannst Du hier durch das dichte Blaetterdach "
	    "nicht sehen.");
  
  AddDetail( ({"weg"}),
	    "Du stehst auf dem Weg.");

  AddDetail( ({"wegrand","rand"}), 
            "Am Wegrand stehen die Baeume und ein paar Straeucher.");

  AddDetail( ({"strauch"}),
	    "Ein Strauch faellt Dir besonders auf. An ihm wachsen "
	    "kleine Heidelbeeren.");

  AddDetail( ({"heidelbeeren"}),
	    "Die Heidelbeeren scheinen zwar noch nicht reif zu sein, "
	    "aber Du kannst ja ein paar pfluecken.");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Heidelbeeren.");  
 
  AddSmell( ({"heidelbeeren"}),
	   "Die Heidelbeeren wachsen an einem Strauch am Rand.");

  AddSound(DEFAULT_SOUND, "Du hoerst verschiedene Voegel.");

  AddSound( ({"voegel"}),
	   "Du kannst die Voegel leider nicht voneinander unterscheiden.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas33");
AddExit("sueden", ROOM "luifinlas35");

AddCmd( ({"pflueck", "pfluecke" }), "pfluecken" );
}
int pfluecken(string str)
{
   if ( member( ({"beere","heidelbeere","beeren","heidelbeeren"})
,str) != -1) 
  {
    write( "Du pflueckst ein paar Heidelbeeren und beisst genuesslich rein.\n"
           "Du verziehst aber sofort das Gesicht, da die Heidelbeeren noch \n"
	   "nicht reif sind, dafuer aber um so saurer.\n");
    say( TPN+" verzieht das Gesicht.\n");
    return 1;
  }
}

