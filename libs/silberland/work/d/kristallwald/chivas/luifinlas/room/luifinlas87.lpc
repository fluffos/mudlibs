// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Hier mitten im Wald tut sich zwischen den Baeumen eine Hoehle auf, "
	"ueber der ein kleines Schild haengt. Der Weg fuehrt Dich nach Westen "
	"oder nach Suedosten. Das Blaetterdach ist sehr dicht durch die "
	"eng aneinander stehenden Baeume." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wald"}),
	    "Du bist mitten im Wald.");

  AddDetail( ({"baeumen","baeume"}),
	    "Die Baeume stehen sehr dicht. Zwischen den Baeumen im Norden ist "
	    "eine Hoehle zu sehen.");
  
  AddDetail( ({"hoehle","norden"}),
	    "Du kannst die Hoehle betreten. Ueber der Hoehle haengt ein "
	    "Schild.");

  AddDetail( ({"schild"}), 
            "Du kannst es lesen.");

  AddDetail( ({"weg"}),
	    "Der Weg fuehrt entweder nach Westen oder nach Suedosten. Er "
	    "fuehrt durch den dichten Wald.");

  AddDetail( ({"westen","suedosten"}),
	    "Da kannst Du hingehen.");

  AddDetail( ({"blaetterdach"}),
	    "Das Blaetterdach ist hier sehr dicht.");
  
  AddDetail( ({"boden","steinchen"}),
	    "Am Boden liegen kleine Steinchen und bilden den Weg.");

  AddDetail( ({"himmel"}),
	    "Den Himmel kannst Du durch das Blaetterdach nicht sehen.");
  
  AddDetail( ({""}),
	    "");

  AddReadDetail( ({"schild"}),
	    "+------------------------------+\n"
	    "|                              |\n"
	    "|         Waldschenke          |\n"
	    "|                              |\n"
	    "+------------------------------+");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht besonders waldig.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst Blaetter rascheln.");

  AddSound( ({"blaetter","rascheln"}),
	   "Die Blaetter an den Baeumen rascheln ein wenig.");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "luifinlas88");
AddExit("suedosten", ROOM "luifinlas86");
AddExit("norden", ROOM "luifwkneipe");

}

