// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hobbithoehle");
  SetProp( P_INT_LONG,
	"Ein paar Regale sind hier zu sehen, in denen viele Buecher stehen. "
	"Auch einen Tisch und drei Stuehle sind vorhanden. Ein kleines Bett "
	"steht an einer Wand und ein grosser Spiegel an einer anderen. Auf "
	"dem Boden liegt ein bunter Teppich." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"regale"}),
	    "An der Wand stehen einige Regale. Auf ihnen sind viele Buecher "
	    "und einige persoenliche Dinge zu sehen.");

  AddDetail( ({"buecher"}),
	    "Die Buecher sind teilweise schon sehr alt. Auf den Buchruecken "
	    "stehen die Titel der Buecher.");
  
  AddDetail( ({"tisch"}),
	    "Der Tisch steht direkt an einer Wand unter einem runden Fenster. "
	    "Ein schlanke Vase steht auf dem Tisch.");

  AddDetail( ({"stuehle"}), 
            "Die Stuehle stehen um den Tisch herum.");

  AddDetail( ({"dinge","besitzer","besitzers"}),
	    "Die persoenlichen Dinge des Besitzers gehen Dich nichts an.");

  AddDetail( ({"bett","groesse"}),
	    "Das Bett ist ordentlich gemacht und genau richtig von der Groesse "
	    "fuer einen Hobbit.");

  AddDetail( ({"wand","waenden","waende"}),
	    "An den Waenden haengen Regale und ein Tisch steht an einer Wand. "
	    "Ausserdem siehst Du einen grossen Spiegel.");

  AddDetail( ({"spiegel","spiegels"}),
	    "Der grosse Spiegel ist mit Verzierungen uebersaeht. Es gibt aber "
	    "noch Etwas sonderbares an dem Spiegel.");
  
  AddDetail( ({"boden"}),
	    "Der Boden besteht aus Holz und ein grosser Teppich liegt auf "
	    "ihm.");

  AddDetail( ({"holz"}),
	    "Das Holz ist schlicht und nichts ist besonders an ihm.");

  AddDetail( ({"teppich"}),
	    "Der Teppich ist kunterbunt");
  
  AddDetail( ({"decke"}),
	    "An der Decke haengt ein eiserner Leuchter.");

  AddDetail( ({"buchruecken","ruecken titel","schneewittchen","hobbitdrachentoeter","ringe","der","klassiker","ringe","titel"}), 
            "Auf den Buchruecken stehen verschiedene Titel. Du schaust sie "
	    "Dir genauer an und siehst Buecher wie 'Schneewittchen und die "
	    "sieben Hobbits', 'Der Hobbitdrachentoeter' oder 'Der Hobbit der "
	    "Ringe' und der Klassiker 'Der grosse Hobbit'.");

  AddDetail( ({"fenster","licht"}),
	    "Die Fenster hier in der Hobbithoehle sind klein und rund, lassen "
	    "aber genug Licht hinein, so dass Du alles sehen kannst.");

  AddDetail( ({"vase"}),
	    "In der schlanken Vase steht eine Blume.");

  AddDetail( ({"hobbit"}),
	    "Hier wohnt ein Hobbit.");
  
  AddDetail( ({"etwas","raumes","mitte"}),
	    "Als Du in den Spiegel schaust, siehst Du kein Spiegelbild von "
	    "Dir. Ausserdem sieht die Hobbithoehle im Spiegel ein wenig "
	    "anders aus. Die Kerzen am Leuchter brennen, in der Vase steckt "
	    "keine Blume und vier Stuehle stehen um den Tisch herum, der in "
	    "der Mitte des Raumes steht. Wenn Du mutig bist, koenntest Du ja "
	    "mal den Spiegel beruehren.");

  AddDetail( ({"verzierungen","rand"}),
	    "Es sind alte Schriftzeichen auf dem Rand des Spiegels zu sehen, "
	    "die wie Verzierungen aussehen.");
  
  AddDetail( ({"leuchter","hoehle"}),
	    "Am Leuchter haengen Kerzen. Die Kerzen sind aus, da es hier hell "
	    "genug in der Hoehle ist.");

  AddDetail( ({"hobbithoehle","hoehle"}), 
            "Du bist in einer Hobbithoehle.");

  AddDetail( ({"blume"}),
	    "Die Blume ist rot und sehr schoen anzusehen.");

  AddDetail( ({"spiegelbild"}),
	    "Du kannst Dein Spiegelbild nicht sehen. Du erschauerst ein "
	    "wenig.");

  AddDetail( ({"schriftzeichen"}),
	    "Die Schriftzeichen sind sehr alt und Du kannst sie so nicht "
	    "lesen. Du musst erst Jemanden finden, der es kann.");
  
  AddDetail( ({"jemanden","chivas"}),
	    "Momentan kann es nur Chivas. Komm spaeter noch einmal wieder.");

  AddDetail( ({"kerzen"}),
	    "Die Kerzen brennen noch nicht. Es ist hell genug in der Hoehle.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach nicht viel hier.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst Lachen.");

  AddSound( ({"lachen"}),
	   "Das Lachen kommt aus dem Spiegel. Du erschauerst.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "luifinlas100");

AddCmd( ({"beruehr", "beruehre" }), "beruehren" );

}
int beruehren(string str)
{
   if ( member( ({"spiegel"})
,str) != -1) 
  {
    write( "Du beruehrst den Spiegel mit der Hand und Deine Hand verschwindet \n"
	   "im Spiegel. Du ziehst entsetzt die Hand zurueck, da Du Dich \n"
	   "momentan noch nicht traust einen Schritt weiter zu gehen.\n");
    say( TPN+" ist erschrocken.\n");
    return 1;
  }
}
