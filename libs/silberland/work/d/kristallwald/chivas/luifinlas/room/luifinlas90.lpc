// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem dunklen Wald");
  SetProp( P_INT_LONG,
	"Hier ist es stockdunkel und auch ein kaelter als im Suedosten. Du "
	"siehst die blassen Blaetter der eng stehenden Baeume und einige "
	"blattlose und tote Straeucher am Wegrand. Am Boden siehst Du ein "
	"paar Wurzeln, die sich auf den Weg vorgewagt haben." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 0 );

//-----Details Anfang-----
  
  AddDetail( ({"suedosten"}),
	    "Im Suedosten ist es sicher waermer und heller.");

  AddDetail( ({"blaetter","eindruck"}),
	    "Die Blaetter machen einen blassen Eindruck in der Dunkelheit.");
  
  AddDetail( ({"baeume"}),
	    "Die Baeume stehen sehr dicht.");

  AddDetail( ({"straeucher"}), 
            "Einige Straeucher stehen am Wegrand, jedoch sind sie blattlos und "
	    "tot. Sie haben anscheinend diese Dunkelheit nicht ueberlebt.");

  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand stehen die grossen Baeume und ein paar tote Straeucher "
	    "sind zu sehen.");

  AddDetail( ({"boden","steinchen"}),
	    "Der Boden des Weges besteht aus kleinen unscheinbaren Steinchen. "
	    "Ausserdem sind ein paar Wurzeln der Baeume zu sehen, die sich "
	    "ueber den Weg gelegt haben.");

  AddDetail( ({"wurzeln"}),
	    "Die Wurzeln haben sich auf den Weg ausgebreitet. Du musst bei "
	    "dieser Dunkelheit darauf achten, dass Du nicht stolperst.");
  
  AddDetail( ({"himmel"}),
	    "Den Himmel kannst Du sicher nicht sehen.");

  AddDetail( ({"dunkelheit"}),
	    "Es herrscht absolute Dunkelheit hier im Wald.");
  
  AddDetail( ({"weges","weg"}),
	    "Du bist auf einem Weg durch einen stockdunklen Wald.");

  AddDetail( ({"hoehle"}), 
            "Du bist in keiner Hoehle, sondern im Wald.");

  AddDetail( ({"wald"}), 
            "Du bist in einem Wald. Kaum zu glauben.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht zwar waldig, aber Du kommst Dir eher wie "
		  "in einer Hoehle vor.");  
 
  AddSound(DEFAULT_SOUND, "Es ist absolut still hier.");

//-----Details Ende-----
  
AddExit("westen", ROOM "luifinlas91");
AddExit("suedosten", ROOM "luifinlas89");

}

