// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem leeren Haus in Luifinlas");
  SetProp( P_INT_LONG,
	"Du bist in einem schoenen Haus in Luifinlas. Es ist leider komplett "
	"leer. Du koenntest hier noch einziehen. Wende Dich bitte an den "
	"zustaendigen Magier.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"haus"}),
	    "Du stehst in einem leeren Haus, das noch bezogen werden muss.");

  AddDetail( ({"luifinlas","stadt"}),
	    "Du bist in der Stadt Luifinlas.");
  
  AddDetail( ({"magier","chivas"}),
	    "Der zustaendige Magier ist Chivas.");

  AddDetail( ({""}), 
            "");

  AddDetail( ({"boden","decke","waende","wand","seherhaus","details"}), 
            "Diese Details musst Du spaeter in Deinem Seherhaus selbst "
	    "definieren.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht frisch geputzt.");  
 
  AddSound(DEFAULT_SOUND, "Es ist herrlich still hier.");

//-----Details Ende-----
  
AddExit("nordwesten", ROOM "luifinlas105");

}
