// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hobbithoehle");
  SetProp( P_INT_LONG,
	"Du stehst in einer kleinen Hobbithoehle. Ein wenig Sonnenschein "
	"dringt durch die runden Fenster ein und spendet genug Licht um alles "
	"zu sehen. Ein Tisch und mehrere Stuehle stehen in der Mitte. "
	"Ausserdem erkennst Du ein Bett in einer Ecke und ein paar Bilder an "
	"den Waenden." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"hobbithoehle","hoehle"}),
	    "Du stehst in einer kleinen Hobbithoehle, die sehr nett "
	    "eingerichtet ist.");

  AddDetail( ({"sonnenschein"}),
	    "Der Sonnenschein dringt durch die Fenster und erhellt die "
	    "Hoehle.");
  
  AddDetail( ({"fenster"}),
	    "Die kleinen runden Fenster lassen das Licht hinein, so dass Du "
	    "alles sehen kannst.");

  AddDetail( ({"licht","helligkeit"}), 
            "Es herrscht genug Helligkeit in der Hoehle.");

  AddDetail( ({"tisch"}),
	    "Ein kleiner Tisch steht in der Mitte der Hoehle.");

  AddDetail( ({"stuehle"}),
	    "Ein paar Stuehle stehen um den Tisch herum.");

  AddDetail( ({"mitte"}),
	    "In der Mitte der Hoehle steht ein Tisch.");
  
  AddDetail( ({"bett","ecke"}),
	    "In der Ecke der Hoehle steht ein kleines Bett, in dem sicher nur "
	    "ein Hobbit Platz hat.");

  AddDetail( ({"bilder","bildern"}),
	    "Auf den Bildern an den Waenden laecheln Dich viele "
	    "Hobbitgesichter an.");
  
  AddDetail( ({"waende","waenden","wand"}),
	    "An den Waenden haengen viele Bilder.");

  AddDetail( ({"hobbit"}), 
            "Dies ist wohl die Hoehle von einem Hobbit.");

  AddDetail( ({"platz","zwerg","fee"}),
	    "Naja, vielleicht passt auch noch ein Zwerg rein oder eine Fee.");

  AddDetail( ({"hobbitgesichter","gesichter"}),
	    "Die Gesichter auf den Bildern strahlen Dich an. Es sind alles "
	    "Hobbits.");

  AddDetail( ({"boden","holz"}),
	    "Der Boden besteht aus Holz.");
  
  AddDetail( ({"decke"}),
	    "An der Decke haengt eine Oellampe.");

  AddDetail( ({"oellampe","lampe"}),
	    "Die Lampe ist aus.");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Putzmitteln.");  
 
  AddSmell( ({"putzmittel","putzmitteln"}),
	   "Hier wurde anscheinend gerade erst sauber gemacht.");

  AddSound(DEFAULT_SOUND, "Du hoerst Stimmen.");

  AddSound( ({"stimmen"}),
	   "Die Stimmen kommen von ausserhalb der Hoehle.");
  
//-----Details Ende-----
  
AddExit("osten", ROOM "luifinlas100");


}
