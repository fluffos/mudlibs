// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int apfel_zahl=3;

void create()
	
{
  ::create();

  AddRoomMessage( ({ "Ein paar Rehe laufen ueber die Lichtung und "
		     "verschwinden im Wald.\n"}), 30, "sound" );

  SetProp( P_INT_SHORT, "Auf einer Lichtung");
  SetProp( P_INT_LONG,
	"Die grosse Lichtung ist mit Gras und lauter Blumen bewachsen. Auch "
	"ein paar Baeume stehen hier neben dem Weg, der ueber die Lichtung "
	"fuehrt. Im Sueden ist eine kleine Wegkreuzung und Du musst dort eine "
	"Entscheidung treffen, wohin Du gehen willst. Du kannst natuerlich "
	"auch nach Nordwesten gehen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"lichtung"}),
	    "Du stehst mitten auf einem Weg in einer grossen Lichtung, die "
	    "von dem grossen dichten Wald ringsherum umgeben ist.");

  AddDetail( ({"gras"}),
	    "Viel Gras ist auf der Lichtung zu sehen. Es ist recht hoch "
	    "gewachsen, da hier wohl keiner das Gras zu maehen scheint.");
  
  AddDetail( ({"blumen"}),
	    "Viele bunte Blumen stehen auf der Lichtung. Du erkennst "
	    "einige Gaensebluemchen und noch viele andere, die Du jedoch "
	    "nicht kennst.");

  AddDetail( ({"baeume","baeumen"}), 
            "Die Baeume direkt hier auf der Lichtung sind Apfelbaeume.");

  AddDetail( ({"weg","weges"}),
	    "Der Weg fuehrt Dich ueber die grosse Lichtung mitten im "
	    "Wald. Irgendwann fuehrt er auch sicher wieder in ihn "
	    "hinein.");

  AddDetail( ({"sueden","wegkreuzung","kreuzung"}),
	    "Im Sueden ist eine Kreuzung. Ein kleines Schild scheint "
	    "dort zu stehen um Dir zu erklaeren, wohin er fuehrt.");

  AddDetail( ({"entscheidung"}),
	    "Du musst schon eine Entscheidung treffen, wenn Du nicht "
	    "ewig oder bis zum naechsten Reboot hier stehen willst.");
  
  AddDetail( ({"nordwesten"}),
	    "Im Nordwesten geht es weiter ueber die Lichtung.");

  AddDetail( ({"boden"}),
	    "Der Boden des Weges besteht aus lauter kleinen Steinen.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist direkt ueber Dir und die Sonne scheint.");

  AddDetail( ({"wald"}), 
            "Der Wald ist ringsum die Lichtung sehen. So gehoert es "
	    "sich auch fuer eine anstaendige Lichtung.");

  AddDetail( ({"gaensebluemchen","bluemchen","tausenden"}),
	    "Die Gaensebluemchen gibt es zu Tausenden auf der Lichtung. "
	    "Du magst Gaensebluemchen.");

  AddDetail( ({"apfelbaeume"}),
	    "Die Apfelbaeume sind voll von Aepfeln.");

  AddDetail( ({"schild"}),
	    "Da musst Du schon nach Sueden gehen um das Schild lesen "
	    "zu koennen.");
  
  AddDetail( ({"reboot"}),
	    "Der naechste Reboot ist hoffentlich noch lange entfernt.");

  AddDetail( ({"steinen","steine"}),
	    "Die Steine bilden den Weg. Ansonsten haben sie keine "
	    "besondere Aufgabe.");
  
  AddDetail( ({"sonne"}),
	    "Die Sonne scheint und sie steht fast senkrecht ueber Dir.");

  AddDetail( ({"aepfeln","aepfel","apfel"}), 
            "Die Aepfel sind schoen rot. Einige von ihnen haengen an "
	    "Zweigen, die recht weit runter haengen. Vielleicht "
	    "erreichst Du sie und kannst sie pfluecken.");

  AddDetail( ({"zweigen","zweige"}),
	    "Einige Zweige der Apfelbaeume haengen recht tief. Du "
	    "kannst sie vielleicht erreichen und ein paar Aepfel "
	    "pfluecken.");

  AddDetail( ({"aufgabe"}),
	    "Hast Du ueberhaupt eine Aufgabe?");

  AddDetail( ({"rehe"}),
	    "Hier laufen oefter Rehe ueber die Lichtung.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Die Blumen duften herrlich.");  
 
  AddSmell( ({"blumen"}),
	   "Du riechst gerne an Blumen.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel in den Baeumen.");

  AddSound( ({"voegel"}),
	   "*tschip*");
  
//-----Details Ende-----
  
AddExit("nordwesten", ROOM "luifhd2");
AddExit("sueden", ROOM "luifinlas43");

AddCmd( ({"pflueck","pfluecke" }), "pfluecken" );
}

void reset()
	
{
  ::reset();
  apfel_zahl=3; 
}

int pfluecken(string str)
{
 object apfel;
 notify_fail("Was willst Du pfluecken?\n");

 if(!str || str == "") return 0;
 if(!(str == "apfel" ||
      str == "apfel von zweig" ||
      str == "apfel von baum" )) return 0;
 

 if( str == "apfel" ||
     str == "apfel von zweig" ||
     str == "apfel von baum"){
    
  if(apfel_zahl < 1)

  {
	  
  write(BS("Die Aepfel, die in erreichbarer Entfernung waren, sind schon "
	   "alle weg.\n"));
 
  say(TPN+" streck sich umsonst.\n");
  return 1;
  }
  else
  {
  write(BS("Du streckst Dich und pflueckst einen Apfel und steckst ihn "
	   "sofort ein. \n"));
 
  say(TPN+" pflueckt einen Apfel.\n");
  apfel=clone_object(OBJ "apfel")->move(TP, M_NOCHECK);
  apfel_zahl--;
  return 1;
 }
}
}
