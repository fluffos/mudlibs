// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Waldweg");
  SetProp( P_INT_LONG,
	"Der Waldweg zieht sich weiter nach Nordosten. Es scheint ein grosser "
	"Wald zu sein, in dem Du Dich befindest. Die grossen Baeume links und "
	"rechts des Weges geben Dir nicht die Moeglichkeit den Pfad zu "
	"verlassen. Am Wegrand liegen einige groessere Steine." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"waldweg","weg","weges","boden"}),
	    "Der Weg fuehrt durch den dichten Wald. Lauter kleine Steinchen, "
	    "ein paar Blaetter und einige Zweige liegen auf ihm.");

  AddDetail( ({"nordosten"}),
	    "Im Nordosten geht der Weg weiter durch den Wald. Natuerlich geht "
	    "er auch nach Suedwesten weiter.");
  
  AddDetail( ({"wald"}),
	    "Du stehst tief in einem Wald.");

  AddDetail( ({"baeume","baeumen"}), 
            "Grosse Baeume stehen direkt am Wegrand. Ihre Staemme bilden fast "
	    "eine Mauer, so dass Du den Weg nicht verlassen kannst.");

  AddDetail( ({"moeglichkeit"}),
	    "Du hast keine Moeglichkeit den Weg zu verlassen.");

  AddDetail( ({"pfad"}),
	    "Der Pfad ist eigentlich ein ordentlicher Weg.");

  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand stehen Baeume und Buesche. Ausserdem liegen einige "
	    "grosse Steine am Rand.");
  
  AddDetail( ({"steine"}),
	    "Die Steine sind grosse Findlinge.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist durch das dichte Blaetterdach nicht zu sehen.");

  AddDetail( ({"steinchen"}), 
            "Kleine Steinchen bilden den Weg hier im Wald.");

  AddDetail( ({"blaetter"}),
	    "Es liegen einige Blaetter auf dem Boden. Sie sind von den "
	    "Baeumen herunter gefallen und auf dem Boden gelandet. Natuerlich "
	    "gibt es auch noch viele Blaetter an den Baeumen.");

  AddDetail( ({"zweige"}),
	    "Die Zweige sind von den Baeumen herunter gefallen und auf dem Weg "
	    "gelandet.");

  AddDetail( ({"staemme"}),
	    "Die Staemme der Baeume sind sehr dick.");
  
  AddDetail( ({"mauer","art"}),
	    "Die Baeume stehen so dicht, so dass sie eine Art Mauer bilden. "
	    "Zwischen den Baeumen stehen auch einige Buesche, die es Dir noch "
	    "schwieriger machen wuerden, den Weg zu verlassen.");

  AddDetail( ({"buesche"}),
	    "Die Buesche stehen zwischen den Baeumen.");
  
  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach ist sehr dicht ueber Dir.");

  AddDetail( ({"findlinge"}), 
            "Die Findlinge liegen sicher schon seit Urzeiten hier. Es hat sie "
	    "sicher keiner absichtlich in den Wald getragen.");

  AddDetail( ({"urzeiten"}),
	    "Das ist sehr lange her.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Wald");  
 
  AddSmell( ({"wald"}),
	   "Es riecht waldig.");

  AddSound(DEFAULT_SOUND, "Es ist recht still hier.");

//-----Details Ende-----
  
AddExit("osten", ROOM "luifinlas45");
AddExit("suedwesten", ROOM "luifinlas47");

}
