// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Dorfmitte von Hubbleton");
  SetProp( P_INT_LONG,
	"Hier auf der Westseite des Dorfplatzes sind viele Hobbithoehlen zu "
	"sehen. Ein paar Hobbits sitzen hier auf Baenken und Stuehlen vor "
	"ihren Hoehlen und geniessen die Sonne, die vom blauen Himmel scheint. "
	"Nach Westen und Norden kannst Du jeweils eine der Hobbithoehlen "
	"betreten." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"westseite","seite"}),
	    "Du bist auf der westlichen Seite der Dorfmitte oder des "
	    "Dorfplatzes.");

  AddDetail( ({"dorfplatzes","platz","dorfplatz","dorfmitte","mitte"}),
	    "Von der Dorfmitte aus gelangt man in alle Hobbithoehlen. Hier "
	    "gibt es sonst keine Strassen, nur einen Weg, der im Norden und "
	    "Sueden aus dem Dorf heraus fuehrt.");
  
  AddDetail( ({"hobbithoehlen","hoehlen","hoehle"}),
	    "Die Hobbithoehlen sind ueberall zu sehen. Sie sind in die "
	    "grasbwachsenen Huegel gebaut.");

  AddDetail( ({"hobbits","voelkchen"}), 
            "In diesem Dorf wohnen nur Hobbits. Sie sind ein lustiges "
	    "Voelkchen.");

  AddDetail( ({"baenken"}),
	    "Auf den Baenken vor den Hoehlen sitzen einige Hobbits und "
	    "geniessen den schoenen Tag und die Sonne.");

  AddDetail( ({"stuehlen","stuehle"}),
	    "Auf den Stuehlen sitzen einige Hobbits, die auf den Baenken "
	    "keinen Platz mehr gefunden haben. Sie haben einfach Stuehle aus "
	    "den Hoehlen geholt und sich darauf gesetzt um die Sonne zu "
	    "geniessen.");

  AddDetail( ({"sonne"}),
	    "Die Sonne waermt und steht senkrecht am Himmel.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen blau.");

  AddDetail( ({"westen","norden"}),
	    "Im Westen und Norden kannst Du in die ein oder andere Hoehle der "
	    "Hobbits gehen und Dich umschauen.");
  
  AddDetail( ({"strassen","weg","strasse","sueden"}),
	    "Hier in Hubbleton gibt es keine Strassen. Nur einen Platz in der "
	    "Mitte und jeweils einen Weg im Norden und Sueden, der aus dem "
	    "Dorf hinaus fuehrt.");

  AddDetail( ({"huegel"}), 
            "Die Huegel des Dorfes sind mit Gras bewachsen. In ihnen haben die "
	    "Hobbits ihre gemuetlichen Hoehlen gebaut.");

  AddDetail( ({"dorf","hubbleton"}),
	    "Du bist in dem kleinen Dorf Hubbleton. Hier leben nur Hobbits.");

  AddDetail( ({"tag"}),
	    "Es ist ein herrlicher Tag.");

  AddDetail( ({"boden"}),
	    "Der Boden im Dorf ist mit kleinen Steinchen bedeckt.");

  AddDetail( ({"steinchen"}),
	    "Die Steinchen sind nicht sehr interessant.");

  AddDetail( ({"gras"}),
	    "Das Gras auf den Huegeln ist sehr gruen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es duftet nach Essen.");  
 
  AddSmell( ({"essen","duft","hoehlen"}),
	   "Der Duft kommt aus den Hoehlen der Hobbits. Sie essen halt sehr "
	   "gerne.");

  AddSound(DEFAULT_SOUND, "Du hoerst Lachen und die Hobbits reden.");

  AddSound( ({"lachen"}),
	   "Das Lachen klingt herzaft. Die Hobbits hier scheinen sehr froh zu "
	   "sein.");

  AddSound( ({"hobbits","hobbit"}),
	   "Man belauscht keine anderen. Schaem Dich!.");  
//-----Details Ende-----
  
AddExit("nordosten", ROOM "luifinlas68");
AddExit("suedosten", ROOM "luifinlas103");
AddExit("osten", ROOM "luifinlas101");
AddExit("westen", ROOM "luifhd12");
AddExit("norden", ROOM "luifhd13");

}

