// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einem See");
  SetProp( P_INT_LONG,
	"Der See an dem Du stehst ist ein sehr schoener Ort. Tausende von "
	"Seerosen sind auf ihm zu sehen und am Rand sieht man viel Schilf und "
	"andere Wasserpflanzen. Auf der westlichen Seite des Weges sind "
	"grosse Baeume und Straeucher." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"see","sees"}),
	    "Der See ist nicht sehr gross und liegt inmitten des grossen "
	    "Waldes.");

  AddDetail( ({"ort"}),
	    "Es ist wirkliche ein sehr schoener Ort hier.");
  
  AddDetail( ({"seerosen"}),
	    "Die Seerosen sehen schoen auf dem See aus. Einige Seerosen sind "
	    "aufgegangen und zeigen Dir ihre Blueten.");

  AddDetail( ({"schilf","rand"}), 
            "Das Schilf am Ufer ist sehr hoch und gut gewachsen.");

  AddDetail( ({"wasserpflanzen"}),
	    "Verschiedenste Wasserpflanzen stehen am Ufer und bluehen in "
	    "vielen Farben.");

  AddDetail( ({"seite"}),
	    "Auf einer Seite des Weges ist der See und auf der anderen Seite "
	    "sind die Baeume des Waldes.");
  
  AddDetail( ({"baeume"}),
	    "Die Baeume auf der westlichen Seite sind sehr gross und stehen "
	    "direkt am Weg.");

  AddDetail( ({"straeucher"}),
	    "Kleine Straeucher stehen am Weg. Sie sind aber nicht sehr "
	    "interessant.");
  
  AddDetail( ({"boden"}),
	    "Am Boden sind viele kleine Steine zu sehen. Auch einige Blaetter "
	    "und Aeste liegen dort.");

  AddDetail( ({"himmel"}), 
            "Der Himmel ist blau und die Sonne scheint.");

  AddDetail( ({"wald","waldes"}),
	    "Du bist mitten im Wald.");

  AddDetail( ({"blueten"}),
	    "Die Blueten sind rot und weiss. Sehr schoen anzusehen.");

  AddDetail( ({"farben"}),
	    "Verschiedenste Farben sind an den Wasserpflanzen zu sehen.");
  
  AddDetail( ({"steine"}),
	    "Die Steine liegen einfach nur so auf dem Weg rum.");

  AddDetail( ({"blaetter"}),
	    "Die Blaetter sind wohl von den Baeumen herunter gefallen.");
  
  AddDetail( ({"aeste"}),
	    "Die Aeste stammen sicher von den Baeumen.");

  AddDetail( ({"sonne"}), 
            "Die Sonne steht fast senkrecht am Himmel.");

  AddDetail( ({"fisch"}),
	    "Du kannst den Fisch nicht sehen. Er ist schon wieder abgetaucht.");

  AddDetail( ({"weg","weges"}),
	    "Du stehst auf einem Weg mitten im Wald.");

  AddDetail( ({"ufer"}),
	    "Am Ufer des Sees waechst Schilf.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen","blueten","duft"}),
	   "Der Duft stammt sicher aus den Blueten der vielen Wasserpflanzen "
	   "und Seerosen.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Platschen.");

  AddSound( ({"platschen"}),
	   "Anscheinend ist ein Fisch im See hochgesprungen.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas56");
AddExit("sueden", ROOM "luifinlas58");

}
