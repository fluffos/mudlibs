
inherit "std/laden";

#include "../def.h"
#include <laden.h>

void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));

  SetProp(P_INT_SHORT,"Im Laden von Hubbleton");
  SetProp(P_SHOPKEEPER_ID, "sita");
  SetProp(P_SHOPKEEPER_NAME, "sita");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
  SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);

  SetStorageRoom(ROOM "luifhdlager" );

//-----Anfang Details-----------------


  AddDetail( ({"laden"}),
	    "Du bist im Laden von Hubbleton."); 

  AddDetail( ({"huegel"}),
	    "Der Laden ist in einen der grasbedeckten Huegel gebaut, in denen "
	    "die hier lebenden Hobbits wohnen.");

  AddDetail( ({"fenster","licht"}),
	    "Durch kleine runde Fenster faellt Licht in den Laden. Es reicht "
	    "um alle Waren gut genug sehen zu koennen."); 

  AddDetail( ({"waren"}),
	    "Hier gibt es sehr viele Waren zu kaufen. Tipp einfach 'zeige' und "
	    "Du siehst was es hier alles gibt.");

  AddDetail( ({"schraenken","schraenke"}),
	    "In den Schraenken an den Waenden werden die Waren aufbewahrt."); 

  AddDetail( ({"waenden","waende"}),
	    "An den Waenden stehen lauter Schraenke.");

  AddDetail( ({"wand"}),
	    "An einer Wand haengt eine kleine Tafel."); 

  AddDetail( ({"boden"}),
	    "Der Boden ist mit Steinplatten ausgelegt.");

  AddDetail( ({"decke","holz"}),
	    "Die Decke besteht aus Holz."); 

  AddDetail( ({"hubbleton","dorf"}),
	    "Hubbleton heisst das Dorf in dem Du Dich befindest.");

  AddDetail( ({"hobbits"}),
	    "In Hubbleton wohnen nur Hobbits."); 

  AddDetail( ({"steinplatten","platten"}),
	    "An den Steinplatten ist nichts besonderes zu sehen.");

  AddDetail( ({"sita","hohlfuss"}),
	    "Sita Hohlfuss gehoert der Laden, in dem Du stehst.");

  AddDetail( ({"tafel","sortiment"}),
	    "Auf der Tafel sieht man was man im Laden kaufen kann. Tipp "
	    "'zeige' und Du kriegst das Sortiment angezeigt."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach allen moeglichen Dingen.");  
 
  AddSmell( ({"dinge","dingen","gerueche"}),
	   "Du kannst es nicht genau beschreiben. Zu viele Gerueche sind "
	   "hier im Laden vorhanden.");

  AddSound(DEFAULT_SOUND, "Du hoerst wie im Lager Waren gestapelt werden.");

  AddSound( ({"lager","waren","regal"}),
	   "Anscheinend sind gerade einige Waren vom Regal gefallen. Es hat "
	   "richtig laut gescheppert.");
  
//-----Details Ende-----


  AddExit("westen", ROOM "luifinlas103");

  AddItem(NPC "sita", REFRESH_DESTRUCT);
}

string _query_int_long()
{
  string txt;

  txt = "Dies ist der Laden von Sita Hohlfuss. Der Laden ist in einen Huegel "
	"gebaut worden. Kleine runde Fenster spenden genug Licht um alle "
	"Waren gut zu sehen. In den Schraenken an den Waenden sieht man das "
	"gesamte Sortiment, was Sita hier verkauft. An einer Wand haengt eine "
	"Tafel, auf der steht, was man hier erwerben kann.";

  if(QueryProp(P_SHOPKEEPER_ID))
  {
    if(!present(QueryProp(P_SHOPKEEPER_ID)))
    {
      txt += "Leider ist momentan gerade niemand hier.";
    }
    else
    {
      txt += "";
    }
  }

  return BS(txt);
}
