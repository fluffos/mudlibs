// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int murmel_zahl=1;

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hobbithoehle");
  SetProp( P_INT_LONG,
	"Der Hobbit, der hier lebt scheint ein Jaeger zu sein. Ueberall an den "
	"Waenden haengen seine Jagdtrophaeen. Auf dem Boden siehst Du einen "
	"grossen Teppich mit dem Muster eines Tigers und die Bettdecke scheint "
	"aus Leopardenfell zu sein." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"hobbit"}),
	    "Der hier wohnende Hobbit ist anscheinend weit im Silberland herum "
	    "gekommen. Ueberall haengen Trophaeen exotischer Tiere.");

  AddDetail( ({"jaeger"}),
	    "Der Hobbit muss ein Jaeger sein.");
  
  AddDetail( ({"waenden","waende","wand"}),
	    "An den Waenden haengen lauter Koepfe von Tieren, die der Hobbit "
	    "wohl als Trophaeen aufgehaengt hat. Ausserdem siehst Du einen "
	    "Schrank, ein Bett und einige Regale.");

  AddDetail( ({"jagdtrophaeen","trophaeen"}), 
            "Es sind viele Trophaeen hier in der Hoehle zu sehen.");

  AddDetail( ({"boden","holzboden"}),
	    "Am Boden siehst Du einen grossen Teppich, der auf einem glatten "
	    "Holzboden liegt.");

  AddDetail( ({"teppich","muster"}),
	    "Der Teppich hat das Muster eines Tigers. Es ist anscheinend das "
	    "Fell eines vom Jaeger erlegten Tieres.");

  AddDetail( ({"tigers","tiger","tigerfell"}),
	    "Der Teppich besteht aus dem Fell eines Tigers. Ausserdem haengt "
	    "gleich neben dem Eingang ein Tigerkopf an der Wand.");
  
  AddDetail( ({"bettdecke","leopardenfell"}),
	    "Die Bettdecke, die sauber und ordentlich auf dem Bett in der "
	    "Ecke liegt, scheint ein Leopardenfell zu sein.");

  AddDetail( ({"fell"}),
	    "Es gibt ein Tigerfell und ein Leopardenfell hier in der Hoehle, "
	    "welches meinst Du?");
  
  AddDetail( ({"decke"}),
	    "An der Decke haengt ein kleiner Leuchter mit mehreren Kerzen.");

  AddDetail( ({"silberland"}), 
            "Du bist im Silberland und weil Du hier bist, bist Du auch schon "
	    "gut rumgekommen.");

  AddDetail( ({"tiere","tieren","tieres"}),
	    "Der Jaeger hat schon viele Tiere erlegt, was man an den Trophaeen "
	    "in der Hoehle sehen kann.");

  AddDetail( ({"koepfe"}),
	    "Verschiedene Koepfe von Tieren haengen an den Waenden. Du siehst "
	    "einen Tigerkopf, einen Wolfskopf, einen Leopardenkopf, einen "
	    "Hirsch und noch viele mehr.");

  AddDetail( ({"hoehle","hoehlen"}),
	    "Du bist in der Hoehle eines der Hobbits von Hubbleton. Hier "
	    "scheint ein Jaeger zu wohnen.");
  
  AddDetail( ({"schrank","schrankes"}),
	    "Ein grosser Schrank steht in der Ecke. Seine Tueren sind "
	    "geschlossen.");

  AddDetail( ({"bett","ecke"}),
	    "Ein kleines Bett steht in der Ecke. Eine wunderschoene Bettdecke "
	    "liegt auf ihm.");
  
  AddDetail( ({"regale","regal"}),
	    "Ein paar Regale stehen an den Waenden. Verschiedene Gegenstaende "
	    "sind auf ihnen zu sehen.");

  AddDetail( ({"tigerkopf","eingang","maul"}), 
            "Der Tigerkopf am Eingang ist wirklich beeindruckend und es wirkt "
	    "so, als ob der Tiger noch leben wuerde. Sein Maul ist weit "
	    "aufgerissen und er zeigt seine grossen Zaehne.");

  AddDetail( ({"leuchter","bronze"}),
	    "Der Leuchter besteht aus Bronze. Ein paar Kerzen sind auf ihn "
	    "gesteckt.");

  AddDetail( ({"kerzen","wachs"}),
	    "Die Kerzen sind aus und teilweise schon herunter gebrannt. Das "
	    "Wachs der Kerzen haengt am Leuchter herunter. Trotz das die "
	    "Kerzen aus sind, kannst Du hier in der Hoehle gut genug sehen, "
	    "da das Licht durch die runden Fenster einfaellt.");

  AddSpecialDetail( ({ "wolfskopf","wolf","wolfes","augenhoehle","kopfes" }), "wolf" );  
  AddDetail( ({"leopardenkopf"}),
	    "Der Leopardenkopf ist gut praepariert. Er sieht immer noch "
	    "lebendig aus.");

  AddDetail( ({"hirsch","hirsches","kopf"}),
	    "Der Kopf des Hirsches an der Wand hat ein riesiges Geweih.");
  
  AddDetail( ({"hobbits"}),
	    "Die Hobbits wohnen in diesem Dorf, wo Du Dich befindest.");

  AddDetail( ({"hubbleton","dorf"}), 
            "Das Dorf heisst Hubbleton.");

  AddDetail( ({"tueren","schranktuer"}),
	    "Die Tueren des Schrankes sind verschlossen. Ein kleines "
	    "Schluesselloch ist an der Schranktuer zu sehen.");

  AddDetail( ({"gegenstaende"}),
	    "Du erkennst ein paar Buecher, einige Pfeile und noch andere "
	    "Sachen auf den Regalen.");

  AddDetail( ({"zaehne"}),
	    "Die Zaehne sind sehr spitz.");
  
  AddDetail( ({"licht","fenster"}),
	    "Es kommt genug Licht durch die runden Fenster, so dass Du gut "
	    "sehen kannst.");

  AddSpecialDetail( ({ "augen","auge" }), "augen" );
  
  AddDetail( ({"schluesselloch","loch"}),
	    "Anscheinend brauch man einen Schluessel fuer den Schrank. Du hast "
	    "momentan keinen, also kannst Du auch nicht den Schrank oeffnen.");
  
  AddDetail( ({"buecher","thema","jagen"}),
	    "Die Buecher behandeln alle nur ein Thema: Das Jagen");

  AddDetail( ({"pfeile"}),
	    "Kleine Pfeile liegen auf dem Regal. Sie passen sicher in eine "
	    "Armbrust. Sie sind schoen spitz.");
  
  AddDetail( ({"sachen"}),
	    "Es sind noch ein paar persoenliche Dinge zu sehen.");

  AddSpecialDetail( ({ "murmeln" }), "murmeln" );
  
  AddDetail( ({"schluessel"}),
	    "Wer hat wohl den passenden Schluessel fuer den Schrank?");

  AddDetail( ({"armbrust"}),
	    "Die Armbrust ist sicher gut verwahrt in dem Schrank, der hier "
	    "in der Hoehle steht. Da kommst Du sicher nicht so einfach ran.");

  AddDetail( ({"dinge","zeug"}),
	    "Du siehst ein Tagebuch, einige Ringe und anderes Zeug, welches "
	    "Dich noch weniger interessiert.");
  
  AddSpecialDetail( ({ "murmel" }), "murmel" );
  
  AddDetail( ({"tagebuch","privatsphaere"}),
	    "Du koenntest das Tagebuch vielleicht lesen, wenn Du gerne in "
	    "der Privatsphaere anderer herum schnueffelst.");

  AddDetail( ({"ringe"}),
	    "Die Ringe sind nicht besonders wertvoll, deshalb laesst Du sie "
	    "liegen.");
  
  AddDetail( ({"geweih"}),
	    "Das Geweih ist wirklich gross.");

  AddReadDetail( ({"tagebuch"}),
	    "Du nimmst das Tagebuch vom Regal und beginnst zu lesen:\n"
	    "                                                       \n"
	    "Es war eine stuermische Nacht und die Frau bei mir war \n"
	    "noch stuermischer. Meine Haende glitten langsam ....   \n"
	    "                                                       \n"
	    "Du legst das Tagebuch wieder zurueck an die Stelle von der Du es "
	    "genommen hast. Du bist rot im Gesicht und hast nicht damit "
	    "gerechnet einen Porno zu lesen. Der Hobbit, der hier wohnt "
	    "scheint ein ganz wilder zu sein.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach toten Tieren.");  
 
  AddSmell( ({"tieren","beste","geruch","tiere","tier"}),
	   "Du wuerdest hier ungerne wohnen. Der Geruch hier ist nicht der "
	   "Beste.");

  AddSound(DEFAULT_SOUND, "Du hoerst Stimmen und Lachen von ausserhalb der "
		  "Hoehle.");

  AddSound( ({"stimmen"}),
	   "Du hoerst die Stimmen, jedoch nicht was sie sagen.");

  AddSound( ({"lachen"}),
	   "Das Lachen wirkt herzaft.");
    
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas103");

AddCmd( ({"zieh","ziehe" }), "ziehen" );
}

void reset()
	
{
  ::reset();
  murmel_zahl=1; 
}

int ziehen(string str)
{
 object murmel;
 notify_fail("Was willst Du woraus ziehen?\n");

 if(!str || str == "") return 0;
 if(!(str == "murmel heraus" ||
      str == "murmel aus augenhoehle heraus" ||
      str == "murmel aus kopf heraus" )) return 0;
 

 if( str == "murmel heraus" ||
     str == "murmel aus augenhoehle heraus" ||
     str == "murmel aus kopf heraus"){
    
  if(murmel_zahl < 1)

  {
	  
  write(BS("Eine Murmel ist schon weg. Das andere Auge sitzt zu fest.\n"));
 
  say(TPN+" zieht umsonst.\n");
  return 1;
  }
  else
  {
  write(BS("Du ziehst eine Murmel aus der Augenhoehle heraus und steckst "
	   "sie ein.\n"));
 
  say(TPN+" zieht etwas heraus und steckt es ein.\n");
  murmel=clone_object(OBJ "murmel")->move(TP, M_NOCHECK);
  murmel_zahl--;
  return 1;
 }
 }
}
string murmel(string key)
{
    if ( murmel_zahl )
    {
    return(BS("Die eine Murmel ist ein wenig locker in der Augenhoehle des "
	    "Kopfes. Man koennte sie vielleicht einfach heraus ziehen.\n"));
    }
    else
    {
    return(BS("Es steckt nur noch eine Murmel in den Augehoehlen des "
	      "Wolfskopfes. Die andere Murmel wurde wohl von Jemanden "
	      "heraus gezogen und mitgenommen."));
    }
}
string murmeln(string key)
{
    if ( murmel_zahl )
    {
    return(BS("Die eine Murmel scheint ein wenig locker zu sitzen.\n"));
    }
    else
    {
    return(BS("Es steckt nur noch eine Murmel in den Augehoehlen des "
	      "Wolfskopfes. Die andere Murmel wurde wohl von Jemanden "
	      "heraus gezogen und mitgenommen."));
    }
}
string augen(string key)
{
    if ( murmel_zahl )
    {
    return(BS("Die Augen sehen wirklich echt aus. Dabei sind es nur grosse "
	      "Murmeln.\n"));
    }
    else
    {
    return(BS("Es ist leider nur ein Auge zu sehen. Das andere wurde "
	      "wohl entfernt."));
    }
}
string wolf(string key)
{
    if ( murmel_zahl )
    {
    return(BS("Ein grosser Wolfskopf haengt an der Wand. Die Augen des Wolfes "
	      "scheinen Dich zu verfolgen."));
    }
    else
    {
    return(BS("Der Wolfskopf hat nur noch ein Auge. Das andere wurde "
	      "wohl von jemanden entfernt."));
    }
}
