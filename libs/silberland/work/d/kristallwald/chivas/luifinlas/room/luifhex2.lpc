// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Nach Westen oder Osten fuehrt der Pfad und im Osten scheint der Pfad "
	"zu einem kleinen Haeuschen zu fuehren. Ansonsten wird der Pfad durch "
	"grosse dicke Baeume eingeschlossen und das Unterholz ist "
	"undurchdringlich." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"westen"}),
	    "Der Pfad fuehrt auch nach Westen.");

  AddDetail( ({"osten"}),
	    "Im Osten scheint ein kleines Haeuschen zu sein, zu dem Dich der "
	    "Pfad fuehrt.");
  
  AddDetail( ({"pfad"}),
	    "Der Pfad ist erdig und fuehrt nach Osten oder Westen.");

  AddDetail( ({"haeuschen"}), 
            "Ein kleines Haeuschen steht im Osten. Geh einfach hin und "
	    "schau es Dir an.");

  AddDetail( ({"baeume"}),
	    "Die Baeume stehen sehr dicht am Pfad.");

  AddDetail( ({"unterholz"}),
	    "Das dichte Unterholz hindert Dich daran den Pfad zu verlassen.");

  AddDetail( ({"boden"}),
	    "Der Boden ist erdig und ab und zu sind kleine Pfuetzen zu sehen.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist durch das dichte Blaetterdach kaum zu erkennen.");

  AddDetail( ({"pfuetzen"}),
	    "Pass auf, dass Du nicht reintrittst und nasse Fuesse bekommst.");
  
  AddDetail( ({"fuesse"}),
	    "Deine Fuesse sind recht gross.");

  AddDetail( ({"blaetterdach"}), 
            "Das Blaetterdach ist sehr dicht.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht waldig.");  

  AddSound(DEFAULT_SOUND, "Du hoerst viele Voegel im Blaetterdach ueber Dir.");

  AddSound( ({"voegel"}),
	   "Die Voegel zwitschern laut vor sich hin.");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "luifhex1");
AddExit("osten", ROOM "luifhex3");


}

