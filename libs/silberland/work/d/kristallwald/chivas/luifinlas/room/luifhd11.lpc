// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hobbithoehle");
  SetProp( P_INT_LONG,
	"Hier herrscht ein grosses Durcheinander. Alle moeglichen "
	"Kleidungsstuecke liegen am Boden und auf dem Tisch steht lauter "
	"benutztes Geschirr. Das Bett sieht auch so aus, als ob es seit langer "
	"Zeit nicht mehr gemacht wurde. Hier fuehlst Du Dich sehr wohl. Es "
	"sieht aus wie bei Dir zu Hause." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"durcheinander","chaos"}),
	    "Hier herrscht Chaos. Alles ist durcheinander und liegt herum. "
	    "Hier wurde schon lange nicht mehr aufgeraeumt.");

  AddDetail( ({"kleidungsstuecke","stuecke","hosen","hemden","schuhe","raum"}),
	    "Viele Hosen und Hemden, aber auch Schuhe liegen einfach im Raum "
	    "herum. Der Hobbit der hier wohnt, haelt anscheined nicht viel "
	    "von Sauberkeit.");
  
  AddDetail( ({"boden"}),
	    "Am Boden liegt alles moegliche herum.");

  AddDetail( ({"tisch"}), 
            "Der Tisch ist auch sehr unordentlich. Lauter Geschirr steht "
	    "auf ihm herum.");

  AddDetail( ({"geschirr","mal"}),
	    "Das Geschirr wurde schon vor langer Zeit das letzte Mal "
	    "abgewaschen.");

  AddDetail( ({"bett"}),
	    "Das Bett ist nicht gemacht und die Bettdecke hat viele Flecken.");

  AddDetail( ({"hause"}),
	    "Du raeumst zwar auch nicht oft auf, aber wie hier sah es schon "
	    "lange nicht mehr bei Dir aus.");
  
  AddDetail( ({"decke"}),
	    "An der Decke haengt eine alte Oellampe.");

  AddDetail( ({"hobbit"}),
	    "Der Hobbit, der hier wohnt, haelt nicht viel von Sauberkeit.");
  
  AddDetail( ({"sauberkeit","fremdwort"}),
	    "Sauberkeit ist hier ein Fremdwort.");

  AddDetail( ({"wand","waenden","waende"}), 
            "An den Waenden ist nicht viel zu sehen. Nur ein Schrank steht "
	    "dort.");

  AddDetail( ({"zeit"}),
	    "Es ist lange her, dass hier mal aufgeraeumt wurde.");

  AddDetail( ({"bettdecke","flecken"}),
	    "Du wuerdest Dich nicht in das Bett legen.");
  
  AddDetail( ({"oellampe","glas"}),
	    "Das Glas der Oellampe ist kaputt. Sie funktioniert sicher nicht "
	    "mehr.");

  AddDetail( ({"schrank","wunder"}),
	    "Der Schrank ist leer, was ja auch kein Wunder ist, da alles auf "
	    "dem Boden liegt.");
  
  AddDetail( ({"maus","ecke"}),
	    "Eine kleine Maus sitzt in der Ecke und fuehlt sich hier wohl.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht schimmelig hier, was auch kein Wunder ist "
		  "bei der Unordnung hier.");  
 
  AddSmell( ({"unordnung"}),
	   "Da kann man doch nicht riechen.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Fiepen.");

  AddSound( ({"fiepen"}),
	   "Das Fiepen kommt aus einer Ecke, wo Du eine kleine Maus siehst. "
	   "Sie scheint sich hier sehr wohl zu fuehlen.");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "luifinlas102");


}
