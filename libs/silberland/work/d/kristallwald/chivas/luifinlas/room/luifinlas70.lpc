// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Strasse in Luifinlas");
  SetProp( P_INT_LONG,
	"Du bist weit in die Stadt vorgedrungen. Hier gibt es hauptsaechlich "
	"die Wohnhaeuser der Einwohner von Luifinlas, welche von der "
	"Architektur sehr unterschiedlich, aber interessant sind. Im Sueden "
	"befindet sich ein grosses Haus mit einem Tor. Ueber dem Tor haengt "
	"ein Schild." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"stadt","luifinlas"}),
	    "Du bist in Luifinlas.");

  AddDetail( ({"wohnhaeuser"}),
	    "Es gibt hier hauptsaechlich Wohnhaeuser. Nur das Haus im Sueden "
	    "ist anders.");
  
  AddDetail( ({"einwohner","einwohnern"}),
	    "Die Einwohner der Stadt sind genau so unterschiedlich wie die "
	    "Architektur der Wohnhaeuser.");

  AddDetail( ({"architektur"}), 
            "Die Architektur ist den Einwohnern angepasst. Du siehst kleinere "
	    "Haeuser fuer die Hobbits und Zwerge, groessere Bauten fuer die "
	    "Trolle, Oger und Zentauren und normale Gebaeude fuer die "
	    "Menschen und Elfen.");

  AddDetail( ({"haus","tor","sueden"}),
	    "Das Haus im Sueden mit dem grossen Tor scheint eine besondere "
	    "Funktion zu haben. Schau Dir doch mal das Schild an.");

  AddDetail( ({"schild"}),
	    "Du kannst das Schild lesen.");

  AddDetail( ({"boden","strasse"}),
	    "Der Boden der Strasse ist gepflastert.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau.");

  AddDetail( ({"haeuser","haeusern"}),
	    "Die kleineren Haeuser werden sicher von den kleineren Rassen "
	    "bewohnt. Sie sind klein und wurden liebevoll mit Verzierungen "
	    "versehen.");
  
  AddDetail( ({"hobbits"}),
	    "Die Hobbits wohnen hier in kleinen Haeusern.");

  AddDetail( ({"zwerge"}), 
            "Die Haeuser der Zwerge haben Verzierungen mit Waffen und "
	    "Ruestungen.");

  AddDetail( ({"bauten","wohnstaetten","wohnstaette"}),
	    "Die grossen Bauten sind die Wohnstaetten der Trolle, Oger und "
	    "Zentauren.");

  AddDetail( ({"trolle"}),
	    "Die Trolle leben hier friedlich mit den anderen Rassen zusammen.");

  AddDetail( ({"oger"}),
	    "Die Oger fuehlen sich hier in Luifinlas sehr wohl. Sie halten "
	    "sich sogar zurueck und fressen nicht die Einwohner.");
  
  AddDetail( ({"zentauren","roch adan","roch","adan"}),
	    "Die Zentauren wohnen sonst nur in Roch Adan, fuehlen sich aber "
	    "auch in Luifinlas sehr wohl.");

  AddDetail( ({"gebaeude"}),
	    "Die Gebaeude der Menschen und Elfen sind normal gross.");
  
  AddDetail( ({"menschen"}),
	    "Die Menschen haben vor ihren Gebaeuden ein paar Blumenkaesten "
	    "gehaengt.");

  AddDetail( ({"elfen"}), 
            "Die Elfen haben ihre Wohnungen in grosser Hoehe auf ein paar "
	    "Baeume gebaut.");

  AddDetail( ({"rassen"}),
	    "Es gibt viele Rassen im Silberland und auch in Luifinlas.");

  AddDetail( ({"verzierungen","essen","waffen","ruestungen"}),
	    "Die Verzierungen an den Haeusern der Zwerge stellen Waffen und "
	    "Ruestungen dar. Die Verzierungen an den Haeusern der Hobbits "
	    "stellen hauptsaechlich Essen dar. Wie typisch fuer die Hobbits.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland.");
  
  AddDetail( ({"wohnungen","hoehe","baeume"}),
	    "Ein paar grosse Baeume sind hier. Die Elfen haben ihre Wohnungen "
	    "in der Hoehe der Baeume gebaut.");

  AddDetail( ({"funktion"}),
	    "Es ist eine grosse Bibliothek.");
  
  AddDetail( ({"bibliothek"}),
	    "Geh einfach rein und schau Dich um.");
  
  AddDetail( ({"blumenkaesten"}),
	    "In den Blumenkaesten wachsen verschiedene kleine Blumen.");
  
  AddDetail( ({"blumen"}),
	    "Es sind rote, blaue und gelbe Blumen zu sehen.");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({"nase"}), 
            "Du hast eine grosse Nase.");

  AddReadDetail( ({"schild"}),
	    "+----------------------------------+\n"
	    "|                                  |\n"
	    "|           Bibliothek             |\n"
	    "|         von Luifinlas            |\n"
	    "|                                  |\n"
	    "+----------------------------------+\n");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen","duft"}),
	   "Der Duft der Blumen aus den Blumenkaesten ist verfuehrerisch.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Krach der Leute auf der Strasse.");

  AddSound( ({"krach","leute"}),
	   "Die Leute unterhalten sich. Du willst aber nicht lauschen.");
  
//-----Details Ende-----
  
AddExit("suedwesten", ROOM "luifinlas76");
AddExit("norden", ROOM "luifinlas74");
AddExit("sueden", ROOM "luifbib");
AddExit("suedosten", ROOM "luifinlas105");
}
