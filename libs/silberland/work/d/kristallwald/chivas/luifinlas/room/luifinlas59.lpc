// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Waldweg");
  SetProp( P_INT_LONG,
	"Der endlose Wald, in dem Du Dich befindest ist sehr dicht und der Weg "
	"scheint sich ewig zu ziehen, bis Du wieder in der Zivilisation einer "
	"Stadt oder eines Ortes bist. Die Baeume weisen Dir den Weg und die "
	"Straeucher am Wegrand lassen Dich nicht abweichen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wald"}),
	    "Du bist tief in einem Wald.");

  AddDetail( ({"weg"}),
	    "Der Weg fuehrt nach Nordosten und Sueden.");
  
  AddDetail( ({"zivilisation"}),
	    "Du bist weit weg von der Zivilisation.");

  AddDetail( ({"stadt","ort","ortes"}), 
            "Da musst Du wohl noch ein bisschen gehen.");

  AddDetail( ({"baeume"}),
	    "Viele Baeume sind in diesem Wald. Damit konnte ja keiner "
	    "rechnen.");

  AddDetail( ({"straeucher"}),
	    "Einige Straeucher unterbrechen die die Baeume im Wald.");

  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand sind Baeume und Straeucher zu sehen.");
  
  AddDetail( ({"boden"}),
	    "Der Boden ist wie immer im Wald. Geh nach Nordosten oder Sueden "
	    "und schau ihn Dir an.");

  AddDetail( ({"nordosten"}),
	    "Da kannst Du hingehen.");
  
  AddDetail( ({"sueden"}),
	    "Im Sueden ist auch Wald zu sehen.");

  AddDetail( ({"himmel"}), 
            "Der Himmel ist nicht zu sehen. Das Blaetterdach ist hier zu "
	    "dicht.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Ein dichtes Blaetterdach, welches die Baeume ueber Dir bilden "
	    "ist zu sehen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht einfach nur nach Wald.");  

  AddSound(DEFAULT_SOUND, "Es hoert sich auch nach Wald an.");

//-----Details Ende-----
  
AddExit("nordosten", ROOM "luifinlas58");
AddExit("sueden", ROOM "luifinlas60");

}
