// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Du stehst auf einem Pfad, der nur nach Osten fuehrt. Im Westen endet "
	"der Pfad an einem Busch, der zwischen den grossen Staemmen der "
	"Baeume eingeklemmt scheint. Durch das dichte Unterholz hast Du keine "
	"Chance den Pfad nach Sueden oder Norden zu verlassen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"blaetterdach","dach"}), 
            "Das Blaetterdach ueber Dir ist sehr dicht. Du kannst den Himmel "
	    "nicht erkennen.");

  AddDetail( ({"pfad","osten","trampelpfad"}),
	    "Der kleine Trampelpfad fuehrt nach Osten und endet im Westen vor "
	    "einem Busch.");
  
  AddDetail( ({"westen","busch"}), 
            "Im Westen ist der Busch, durch den Du Dich gezwaengt hast. Du "
	    "kannst Dich wieder durch den Busch zwaengen um zurueck zum "
	    "Weg zu gelangen.");

  AddDetail( ({"staemmen","staemme"}),
	    "Die grossen Staemme des Waldes und das dichte Unterholz lassen "
	    "Dich den Pfad nicht verlassen.");
  
  AddDetail( ({"unterholz","chance","sueden","norden","stelle"}), 
            "Das Unterholz ist an dieser Stelle so dicht, dass Du auf dem "
	    "Pfad bleiben musst.");

  AddDetail( ({"boden"}),
	    "Der Boden ist erdig und einige Blaetter und Nadeln liegen auf "
	    "ihm.");
  
  AddDetail( ({"himmel"}), 
            "Den Himmel kannst Du hier nicht sehen.");

  AddDetail( ({"weg"}),
	    "Der Weg muss hinter dem Busch liegen.");
  
  AddDetail( ({"waldes","wald"}), 
            "Du bist mitten im Wald auf einem Trampelpfad.");

  AddDetail( ({"blaetter","nadeln"}),
	    "Die Blaetter und Nadeln stammen von den Baeumen. Sie sind wohl "
	    "auf den Pfad gefallen.");
  
  AddDetail( ({"baeume","baeumen"}), 
            "Die Baeume stehen sehr dicht am Pfad und geben Dir die Richtung "
	    "vor.");

  AddDetail( ({"richtung"}),
	    "Du kannst nach Osten gehen.");
  
  AddDetail( ({""}), 
            "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Wald.");  
 
  AddSmell( ({"wald"}),
	   "Es riecht unglaublich waldig.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel zwitschern.");

  AddSound( ({"voegel"}),
	   "Die Voegel sitzen hoch oben im Blaetterdach und singen ihr Lied.");
  
  AddSound( ({"lied"}),
	   "*triller*zwitscher*triller*");

//-----Details Ende-----
  
AddExit("osten", ROOM "luifhex2");

AddCmd( ({"zwaeng", "zwaenge" }), "zwaengen" );

}
int zwaengen(string str)
{
   notify_fail("Wo moechtest Du Dich durchzwaengen?\n");
   if ( member( ({ "durch aeste","durch busch" }),str) != -1) 
  {
    write(BS ( "Du zwaengst Dich durch den Busch auf den dahinter liegenden "
               "Weg.\n"));
      TP->move( ROOM "luifinlas35", M_GO, 
      "ploetzlich zwischen den Aesten eines Busches", "verschwindet", 
      "zwaengt sich herein");
    return 1;
  }
}

