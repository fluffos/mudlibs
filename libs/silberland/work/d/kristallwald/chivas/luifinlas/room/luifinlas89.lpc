// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Es ist sehr dunkel im Wald. Man kann ohne Lichtquelle kaum etwas "
	"sehen, ausser man ist ein Dunkelelf. Die Baeume sperren mit ihrem "
	"dichten Blaetterdach fast komplett aus. Sie stehen ganz dicht am "
	"Weg und ihr Unterholz macht es unmoeglich den Weg zu verlassen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wald","stelle"}),
	    "Der Wald ist an dieser Stelle sehr dunkel.");

  AddDetail( ({"lichtquelle"}),
	    "Hier brauchst Du noch keine Lichtquelle. Im Nordwesten sieht das "
	    "anders aus.");
  
  AddDetail( ({"dunkelelf","dunkelelfen"}),
	    "Die Dunkelelfen koennen auch ohne Lichtquelle alles sehen.");

  AddDetail( ({"baeume"}), 
            "Die Baeume ruecken immer naeher an den Weg.");

  AddDetail( ({"blaetterdach"}),
	    "Das Blaetterdach laesst kaum noch Licht durch.");

  AddDetail( ({"weg"}),
	    "Der Weg gibt Dir die Richtung vor. Du kannst ihn nicht "
	    "verlassen.");

  AddDetail( ({"unterholz","chance"}),
	    "Das Unterholz ist sehr dicht. Du hast keine Chance den Weg zu "
	    "verlassen.");
  
  AddDetail( ({"boden","steinchen"}),
	    "Der Boden ist mit kleinen Steinchen bedeckt.");

  AddDetail( ({"himmel"}),
	    "Den Himmel kannst Du durch das Blaetterdach nicht sehen.");
  
  AddDetail( ({"nordwesten"}),
	    "Im Nordwesten ist es richtig dunkel.");

  AddDetail( ({"licht"}), 
            "Etwas Licht kommt noch durch, aber nicht viel.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht waldig, wie in einem Wald ueblich.");  
 
  AddSmell( ({"wald"}),
	   "Es riecht halt waldig.");

  AddSound(DEFAULT_SOUND, "Nur ein paar Voegel sind hier zu hoeren.");

  AddSound( ({"voegel"}),
	   "*zwitscher*");
  
//-----Details Ende-----
  
AddExit("nordwesten", ROOM "luifinlas90");
AddExit("suedosten", ROOM "luifinlas88");

}

