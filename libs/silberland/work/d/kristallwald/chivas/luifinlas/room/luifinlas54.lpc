// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Wald ist hier lichter als im Sueden. Die Baeume stehen nicht so "
	"dicht und geben einen guten Ausblick auf die Wiese im Norden. Im "
	"Sueden wird der Wald dagegen dichter als hier." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wald"}),
	    "Der Wald ist hier recht lichtdurchlaessig. Im Sueden wird "
	    "er sehr viel dichter.");

  AddDetail( ({"sueden"}),
	    "Im Sueden fuehrt der Weg durch dichteren Wald.");
  
  AddDetail( ({"baeume","baeumen"}),
	    "Es stehen viele Baeume um Dich herum. Sie stehen nicht sehr "
	    "dicht.");

  AddDetail( ({"ausblick","wiese","norden"}), 
            "Der Ausblick auf die Wiese im Norden mit ihren vielen "
	    "Blumen ist phantastisch.");

  AddDetail( ({"boden"}),
	    "Am Boden siehst Du einige Blaetter und Nadeln.");

  AddDetail( ({"weg"}),
	    "Der Weg fuehrt nach Norden auf eine Wiese und nach Sueden "
	    "tiefer in den Wald.");

  AddDetail( ({"blumen"}),
	    "Es gibt viele schoene bunte Blumen im Norden. Geh einfach "
	    "hin und geniesse es.");
  
  AddDetail( ({"blaetter"}),
	    "Die Blaetter stammen sicher von den Laubbaeumen.");

  AddDetail( ({"laubbaeumen","laubbaeume"}),
	    "Hier gibt es viele Laubbaeume im Wald.");
  
  AddDetail( ({"nadeln"}),
	    "Die Nadeln stammen sicher von den Tannen am Wegrand.");

  AddDetail( ({"tannen"}), 
            "Eine ganz normale Baumart in einem Wald.");

  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand stehen Baeume. Auch einige Straeucher kannst Du "
	    "erkennen.");

  AddDetail( ({"baumart","bibliothek","buch","baumarten"}),
	    "Wenn Du mehr ueber Baumarten wissen willst, dann geh doch "
	    "in eine Bibliothek und leih Dir ein Buch.");

  AddDetail( ({"straeucher","heidelbeerstraeucher"}),
	    "Es sind Heidelbeerstraeucher. Leider wurden sie schon "
	    "abgepflueckt. Du musst woh spaeter noch einmal vorbei kommen.");
  
  AddDetail( ({"himmel"}),
	    "Soweit Du den Himmel sehen kannst, ist er schoen blau.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Wald.");  
 
  AddSmell( ({"wald"}),
	   "Wie es halt in einem Wald riecht.");

  AddSound(DEFAULT_SOUND, "Es ist sehr still hier.");

//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas53");
AddExit("sueden", ROOM "luifinlas55");

}
