// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Strasse in Luifinlas");
  SetProp( P_INT_LONG,
	"Du bist in einem Wohngebiet der Stadt angekommen. Die Haeuser sind "
	"sehr schoen und machen einen gepflegten Eindruck. Ausserdem ist die "
	"hier ein wenig ruhiger als in den anderen Teilen der Stadt. Nach "
	"Sueden und Westen geht es weiter in die Wohngebiete und im Sueden ist "
	"ein kleiner Springbrunnen zu sehen.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wohngebiet"}), 
            "Du stehst in einem Wohngebiet von Luifinlas. Die Haeuser hier "
	    "sind gepflegt und sehen gut aus.");
  
  AddDetail( ({"stadt","luifinlas"}), 
            "Du bist in der Stadt Luifinlas.");  

  AddDetail( ({"haeuser","wohnhaeuser"}), 
            "Die Haeuser hier sind Wohnhaeuser.");  

  AddDetail( ({"eindruck"}), 
            "Die Haeuser machen einen gepflegten Eindruck.");  

  AddDetail( ({"teilen","teile"}), 
            "Hier ist es ruhiger als in anderen Teilen der Stadt.");  

  AddDetail( ({"sueden","westen"}), 
            "Du kannst weiter in die Wohngebiete nach Sueden und Westen "
	    "gehen.");  

  AddDetail( ({"wohngebiete"}), 
            "Hier sind die Wohngebiete der Einwohner von Luifinlas.");  

  AddDetail( ({"springbrunnen"}), 
            "Im Sueden ist ein Springbrunnen zu sehen.");  

  AddDetail( ({"boden"}), 
            "Der Boden der Strasse ist mit Steinen gepflastert.");  

  AddDetail( ({"himmel"}), 
            "Der Himmel ueber der Stadt ist blau.");  

  AddDetail( ({"einwohner"}), 
            "Luifinlas hat viele Einwohner.");  

  AddDetail( ({"strasse"}), 
            "Du befindest Dich auf einer Strasse in Luifinlas.");  

  AddDetail( ({"steinen","steine","pflaster"}), 
            "Die Steine bilden die Strasse. Zwischen den Steinen waechst ein "
	    "wenig Gras.");  

  AddDetail( ({"gras"}), 
            "Es ist nicht viel Gras, dass zwischen den Steinen waechst.");  

  AddDetail( ({""}), 
            "");  

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht einfach nur nach Stadt.");  
 
  AddSmell( ({"stadt","gerueche"}),
	   "Du riechst gern die Gerueche der Stadt.");

  AddSound(DEFAULT_SOUND, "Du hoerst verschiedene Leute auf der Strasse.");

  AddSound( ({"leute"}),
	   "Du willst sie nicht belauschen.");

//-----Details Ende-----
  
AddExit("sueden", ROOM "luifinlas107");
AddExit("osten", ROOM "luifinlas82");
AddExit("westen", ROOM "luifinlas109");

}
