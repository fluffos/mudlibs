// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Waldweg");
  SetProp( P_INT_LONG,
	"Die Baeume stehen dicht am Weg. Einzelne Straeucher zwaengen sich "
	"zwischen den Baeumen hindurch. Das Blaetterdach der grossen Baeume "
	"bildet ein fast komplett geschlossenes Dach und nur wenige "
	"Sonnenstrahlen erreichen den Boden. Ein paar Aeste liegen auf dem "
	"Waldweg." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"baeume","baeumen"}),
	    "Die Baeume stehen sehr dicht am Wegrand.");

  AddDetail( ({"weg","waldweg","nordwesten","sueden"}),
	    "Der Weg fuehrt von hier aus nach Nordwesten oder nach Sueden.");
  
  AddDetail( ({"straeucher"}),
	    "Kleine Straeucher sind am Wegrand zu sehen.");

  AddDetail( ({"blaetterdach","dach"}), 
            "Das Blaetterdach laesst kaum Sonnenstrahlen durch.");

  AddDetail( ({"sonnenstrahlen","strahlen"}),
	    "Sonnenstrahlen sind hier kaum zu sehen, da das Blaetterdach sehr "
	    "dicht ist.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mir kleinen Aesten und Laub bedeckt.");

  AddDetail( ({"aeste","aesten"}),
	    "Die Aeste sind von den Baeumen gefallen.");
  
  AddDetail( ({"wald"}),
	    "Du bist mitten im tiefen Wald.");

  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand im Wald stehen komischerweise Baeume.");
  
  AddDetail( ({"laub"}),
	    "Das Laub stammt sicher von den umliegenden Baeumen.");

  AddDetail( ({"himmel"}), 
            "Den Himmel kannst Du durch das dichte Blaetterdach nicht "
	    "sehen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Laub.");  
 
  AddSmell( ({"laub"}),
	   "Das Laub riecht modrig.");

  AddSound(DEFAULT_SOUND, "Es ist sehr still hier.");
  
//-----Details Ende-----
  
AddExit("nordwesten", ROOM "luifinlas60");
AddExit("sueden", ROOM "luifinlas62");

}
