// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Die Baeume sind hier weniger und mehr Sonne kommt durch das "
	"Blaetterdach als weiter im Norden. Im Sueden sind noch weniger "
        "Baeume zu sehen und dort scheint eine Wiese zu sein. Einige "
        "Straeucher stehen am Wegrand." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"baeume"}),
	    "Die Baeume stehen nicht sehr dicht und Du kannst durch "
	    "das Blaetterdach sogar den Himmel sehen.");

  AddDetail( ({"sonne"}),
	    "Die Sonne steht fast senkrecht am Himmel wie Du durch das "
	    "Blaetterdach sehen kannst.");
  
  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach ist sehr durchlaessig und Du kannst den Himmel "
	    "sehen.");

  AddDetail( ({"norden","stelle"}), 
            "Im Norden ist der Wald dichter als an dieser Stelle.");

  AddDetail( ({"sueden"}),
	    "Im Sueden ist eine Wiese zu sehen.");

  AddDetail( ({"wiese"}),
	    "Die Wiese im Sueden ist sehr gross.");

  AddDetail( ({"straeucher"}),
	    "Viele Straeucher stehen am Wegrand.");
   
  AddDetail( ({"boden"}),
	    "Am Boden liegen Blaetter und Steine.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau und die Sonne scheint.");
  
  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand stehen Baeume und Straeucher friedlich nebeneinander.");

  AddDetail( ({"blaetter"}), 
            "Die Blaetter sind wohl von den Baeumen gefallen.");

  AddDetail( ({"steine"}),
	    "Die Steine lagen hier wohl schon immer. Ein Stein faellt Dir "
	    "besonders auf.");

  AddDetail( ({"stein","kiesel"}),
	    "Schade, es war wohl nur ein Tautropfen auf einem kleinen Kiesel.");

  AddDetail( ({"tautropfen","tropfen"}),
	    "Der Tautropfen glaenzt in der Sonne.");

  
  AddDetail( ({"wald"}),
	    "Du bist mitten im Wald.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Gras.");  
 
  AddSmell( ({"gras","geruch"}),
	   "Der Geruch kommt sicher von der Wiese.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind, wie er durch die Blaetter "
		          "weht.");

  AddSound( ({"wind","blaetter"}),
	   "Es rauscht in den Blaettern.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas49");
AddExit("suedwesten", ROOM "luifinlas51");

}
