// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Die Baeume stehen dicht am Weg. Auch einige Buesche sind am Wegrand "
	"zu sehen. Im Westen ist eine Kreuzung zu sehen. Der Wald ist gross "
	"undurchdringlich. Der Boden des Weges ist mit Blaettern und Aeste "
	"bedeckt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"baeume","baeumen"}),
	    "Die Baeume stehen hier dicht am Weg.");

  AddDetail( ({"weg","weges"}),
	    "Der Weg fuehrt durch den dichten Wald.");
  
  AddDetail( ({"buesche"}),
	    "Einige grosse Buesche stehen am Wegrand und ermoeglichen Dir "
	    "nicht den Weg zu verlassen.");

  AddDetail( ({"wegrand","rand"}), 
            "Am Wegrand stehen wie in einem Wald ueblich Baeume. Dazwischen "
	    "stehen einige grosse Buesche.");

  AddDetail( ({"westen","kreuzung"}),
	    "Im Westen scheint eine Kreuzung zu sein.");

  AddDetail( ({"wald"}),
	    "Du befindest Dich mitten im tiefen Wald.");

  AddDetail( ({"boden"}),
	    "Am Boden siehst Du viele Blaetter und Aeste.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist durch das dichte Blaetterdach ueber Dir nicht zu "
	    "sehen.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach der grossen Baeume am Wegrand ist ueber Dir sehr "
	    "dicht und verdeckt den Himmel.");
  
  AddDetail( ({"blaettern","blaetter"}),
	    "Die Blaetter sind sicher von den Baeumen gefallen.");

  AddDetail( ({"aeste"}), 
            "Die Aeste stammen sicher auch von den Baeumen und sind hier "
	    "gelandet.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht hier besonders waldig. Dir gefaellt das.");  
  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel.");

  AddSound( ({"voegel"}),
	   "*zwitscher*");
  
//-----Details Ende-----
  
AddExit("osten", ROOM "luifinlas7");
AddExit("westen", ROOM "luifinlas5");

}

