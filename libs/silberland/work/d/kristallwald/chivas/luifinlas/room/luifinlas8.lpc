// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Am Rand eines Waldes");
  SetProp( P_INT_LONG,
	"Du stehst am Ende oder am Anfang eines grossen Waldes. Der Weg auf "
	"dem Du Dich befindest fuehrt nach Nordwesten tiefer in ihn hinein. "
	"Nach Osten hin hoert der Wald vollkommen auf und muendet auf eine "
	"grosse Wiese, durch die sich der Weg schlaengelt. Im Osten erkennst "
	"Du die grosse Stadt Luifinlas." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"ende","anfang"}),
	    "Auf jedenfall beginnt hier der Wald.");

  AddDetail( ({"waldes","wald"}),
	    "Du kannst den Wald nach Nordwesten betreten.");
  
  AddDetail( ({"weg","weges"}),
	    "Der Weg auf dem Du stehst fuehrt entweder in den Wald hinein oder "
	    "nach Suedosten zur Stadt.");

  AddDetail( ({"nordwesten"}), 
            "Nach Nordwesten kommt man in den Wald.");

  AddDetail( ({"osten"}),
	    "Im Osten liegt eine grosse Wiese und dahinter die grosse Stadt "
	    "Luifinlas.");

  AddDetail( ({"wiese"}),
	    "Die Wiese ist gross und mit Gras bedeckt. Auch einige "
	    "Baumstuempfe sind zu sehen.");

  AddDetail( ({"stadt","luifinlas"}),
	    "Die grosse Stadt Luifinlas siehst Du im Osten. Besser gesagt, "
	    "Du siehst ihre maechtige Stadtmauer.");
  
  AddDetail( ({"boden","steinchen"}),
	    "Der Boden des Weges ist mit kleinen Steinchen bedeckt.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ueber Dir ist schoen blau.");
  
  AddDetail( ({"suedosten","westtor"}),
	    "Der Weg fuehrt auch nach Suedosten zum Westtor der Stadt.");

  AddDetail( ({"gras"}), 
            "Das Gras auf der Wiese ist halbhoch.");

  AddDetail( ({"baumstuempfe","umgebung","ueberblick"}),
	    "Die Baeume auf der Wiese wurden gefaellt um einen guten "
	    "Ueberblick auf die Umgebung der Stadt von der Stadtmauer aus zu "
	    "haben. So kann sich niemand an die Stadt heran schleichen.");

  AddDetail( ({"stadtmauer","mauer"}),
	    "Die grosse Mauer, die die Stadt umgibt, besteht aus grossen "
	    "Steinquadern.");

  AddDetail( ({"baeume","baeumen"}),
	    "Die Baeume wurden auf der Wiese gefaellt. Im Wald stehen "
	    "natuerlich noch viele Baeume.");
  
  AddDetail( ({"steinquadern","steinquader","quader","stein"}),
	    "Es ist sicher schwer dort ein Loch rein zu schlagen.");

  AddDetail( ({"loch"}),
	    "Natuerlich siehst Du kein Loch. Du untersuchst wirklich alles.");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Wiese.");  
 
  AddSmell( ({"wiese","gras"}),
	   "Das Gras auf der Wiese riecht herrlich frisch.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind, wie er durch die Baeume des "
		  "Waldes weht.");

  AddSound( ({"wind","baeume","wald","blaetter","rascheln"}),
	   "Die Blaetter in den Baeumen rascheln, wenn der Wind durch sie "
	   "faehrt.");
  
//-----Details Ende-----
  
AddExit("nordwesten", ROOM "luifinlas7");
AddExit("suedosten", ROOM "luifinlas9");

}

