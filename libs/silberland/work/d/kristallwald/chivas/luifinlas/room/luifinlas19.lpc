// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Am Osttor von Luifinlas");
  SetProp( P_INT_LONG,
	"Du stehst vor dem Durchgang, welcher durch die Stadtmauer aus der "
	"Stadt herausfuehrt. Jedoch erkennst Du im dunklen Durchgang, dass "
	"das Tor momentan geschlossen ist. \n"
	"Im Norden scheint ein Arzt zu sein und im Sueden ist ein grosses "
	"Haus mit eine dreieckigen Schild ueber dem Eingang zu sehen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"durchgang","licht","seite"}),
	    "Der Durchgang ist dunkel. Es liegt natuerlich daran, dass auf "
	    "der anderen Seite das Tor geschlossen ist und kein Licht "
	    "einfaellt.");

  AddDetail( ({"stadtmauer","mauer"}),
	    "Die Stadtmauer erhebt sich oestlich von Dir. Sie ist riesig und "
	    "Du kannst von hier aus auf sie gelangen, in dem Du entweder "
	    "die Treppe nach Nordostoben oder die nach Suedostoben nimmst.");
  
  AddDetail( ({"stadt","luifinlas"}),
	    "Luifinlas ist eine grosse Stadt. Du bist gerade da.");

  AddDetail( ({"tor"}), 
            "Das Tor ist geschlossen.");

  AddDetail( ({"norden","arzt","arztzeichen","tuer"}),
	    "Im Norden ist ein Arzt. Du erkennst es an dem Arztzeichen ueber "
	    "der Tuer.");

  AddDetail( ({"sueden","haus"}),
	    "Ein grosses Haus ist im Sueden zu sehen. Es schmiegt sich an die "
	    "Stadtmauer und scheint irgendwie merkwuerdig zu sein.");

  AddDetail( ({"schild","schildes","mitte"}),
	    "Das Schild ist dreieckig und ein Auge ist in der Mitte des "
	    "Schildes.");
  
  AddDetail( ({"eingang"}),
	    "Ueber dem Eingang haengt ein Schild.");

  AddDetail( ({"boden","strasse"}),
	    "Der Boden der Strasse auf dem Du stehst ist gepflastert.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau.");

  AddDetail( ({"auge"}),
	    "Das Auge wirkt irgendwie allwissend.");

  AddDetail( ({"nordostoben","suedostoben","treppe"}), 
            "Du kannst nach Nordostoben oder nach Suedostoben eine Treppe hoch "
	    "gehen und so auf die Stadtmauer gelangen.");

  AddDetail( ({"schule","westen"}),
	    "Von hier aus kannst Du nichts sehen. Du musst schon naeher nach "
	    "Westen gehen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Stadt.");  
 
  AddSmell( ({"stadt","gerueche"}),
	   "Es gibt die unterschiedlichsten Gerueche in der Stadt.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Kinder schreien.");

  AddSound( ({"kinder"}),
	   "Weiter im Westen scheint eine Schule zu sein.");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "luifinlas18");
AddExit("osten", ROOM "luifinlas20");
AddExit("norden", ROOM "luifarzt");
AddExit("sueden", ROOM "luifillu");
AddExit("nordostoben", ROOM "luifst19");
AddExit("suedostoben", ROOM "luifst21");

}
