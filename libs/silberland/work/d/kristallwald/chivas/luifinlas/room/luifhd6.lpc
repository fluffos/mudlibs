// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Wiese");
  SetProp( P_INT_LONG,
	"Die Wiese ist sehr gross und der Weg auf dem Du stehst fuehrt ueber "
	"sie nach Norden oder nach Sueden in den Wald hinein. Die Huegel "
	"weiter im Norden sind sicher die Hoehlen der Hobbits von Hubbleton." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wiese","graswiese"}),
	    "Die grosse Wiese ist mit Gras bedeckt. Nur ab und zu sieht man "
	    "eine Blume.");

  AddDetail( ({"weg"}),
	    "Der Weg fuehrt nach Norden oder Sueden.");
  
  AddDetail( ({"norden","sueden"}),
	    "Dahin kannst Du gehen.");

  AddDetail( ({"wald"}), 
            "Der Wald befindet sich von hier aus im Sueden.");

  AddDetail( ({"huegel"}),
	    "Die Huegel weiter im Norden sind wie die Wiese mit Gras bedeckt. "
	    "Es sind sicher die Hobbithoehlen des Dorfes Hubbleton. Aus "
	    "einigen Huegeln siehst Du Rauch aufsteigen.");

  AddDetail( ({"hoehlen","hobbithoehlen"}),
	    "Die Hobbits in dieser Gegend wohnen in Hoehlen, die in grosse "
	    "Huegel gebaut sind. Es soll sehr wohnlich in ihnen sein.");

  AddDetail( ({"hobbits","gegend","hobbitgemeinde","gemeinde"}),
	    "Die Hobbits wohnen in dem Dorf Hubbleton, welches Du im Norden "
	    "siehst. Es ist die einzige Hobbitgemeinde hier im Norden.");
  
  AddDetail( ({"hubbleton","dorfes","dorf"}),
	    "Hubbleton ist ein Dorf in dem nur Hobbits wohnen. Es liegt "
	    "noerdlich von Dir.");

  AddDetail( ({"blume","blumen"}),
	    "Es gibt nur wenige Blumen auf der Wiese hier. Es ist eine reine "
	    "Graswiese.");
  
  AddDetail( ({"gras","zeit","hoehe"}),
	    "Das Gras, welches hier waechst ist recht hoch gewachsen. Es nimmt "
	    "aber weiter im Norden an Hoehe ab. Dort wurde anscheinend erst "
	    "vor kurzer Zeit gemaeht.");

  AddDetail( ({"rauch"}), 
            "Der Rauch kommt sicher aus den Hoehlen. Anscheinend wird gerade "
	    "gekocht.");

  AddDetail( ({"luft"}),
	    "Die Luft riecht gut.");
  
  AddDetail( ({"boden"}),
	    "Der Weg ist mit kleinen Steinchen bedeckt und gut im Gras zu "
	    "sehen.");
  
  AddDetail( ({"himmel","sonne"}),
	    "Der Himmel ist weit ueber Dir. Die Sonne scheint.");
  
  AddDetail( ({"steinchen","fall"}),
	    "Die Steinchen sind rund. Manche sind auch eckig. Auf jeden "
	    "Fall sind sie nicht sehr interessant.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Gras.");  
 
  AddSmell( ({"gras"}),
	   "Das Gras duftet frisch.");

  AddSound(DEFAULT_SOUND, "Du hoerst einen Adler kreischen.");

  AddSound( ({"adler","kreischen"}),
	   "Ein Adler fliegt hoch ueber Dir in der Luft und gibt ein "
	   "Kreischen von sich.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifhd7");
AddExit("sueden", ROOM "luifhd5");

}
