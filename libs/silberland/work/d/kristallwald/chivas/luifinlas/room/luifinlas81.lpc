// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Strasse von Luifinlas");
  SetProp( P_INT_LONG,
	"Dies ist ein Viertel von Luifinlas, in dem wohl hauptsaechlich die "
	"Zwerge wohnen und arbeiten. Ueberall sind schwer bewaffnete Zwerge "
	"unterwegs. Als Elf fuehlt man sich hier sicher nicht so wohl. Im "
	"Sueden ist eine typische Zwergenschmiede zu sehen und aus dem Westen "
	"ist lautes Gegroelle zu vernehmen, wie es nur in einer echten "
	"Zwergenkneipe zu Hause ist." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"viertel","gegend"}),
	    "Du bist in einem Viertel der Zwerge.");

  AddDetail( ({"luifinlas","stadt"}),
	    "Du bist in Luifinlas. Luifinlas ist eine grosse Stadt im "
	    "Silberland.");
  
  AddDetail( ({"zwerge"}),
	    "Hier sind lauter Zwerge zu sehen.");

  AddDetail( ({"elf"}), 
            "Als Elf ist es keine schoene Gegend.");

  AddDetail( ({"sueden","zwergenschmiede","schmiede"}),
	    "Im Sueden ist eine typische Zwergenschmiede. Es quillt Rauch "
	    "aus der Tuer und aus dem Schornstein.");

  AddDetail( ({"westen","zwergenkneipe","kneipe","hause"}),
	    "Im Westen ist eine Zwergenkneipe. Geh einfach mal rein und schau "
	    "sie Dir an.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit Steinen gepflastert.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist wunderschoen blau.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland.");
  
  AddDetail( ({"rauch"}),
	    "Der Rauch zieht aus der Tuer und dem Schornstein im Sueden.");

  AddDetail( ({"tuer"}), 
            "Durch die Tuer im Sueden dringt Rauch auf die Strasse.");

  AddDetail( ({"schornstein"}),
	    "Aus dem Schornstein im Sueden quillt Rauch.");

  AddDetail( ({"steinen","steine","pflaster"}),
	    "Das Pflaster auf der Strasse ermoeglicht Dir angenehm durch die "
	    "Strassen von Luifinlas zu gehen.");

  AddDetail( ({"strasse","strassen"}),
	    "Du stehst auf einer Strasse der Stadt.");
  
  AddDetail( ({"ohr","ohren"}),
	    "Du hast sehr grosse Ohren.");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst Rauch.");  
 
  AddSmell( ({"rauch"}),
	   "Der Rauch dringt aus der Schmiede auf die Strasse.");

  AddSound(DEFAULT_SOUND, "Es dringt Gegroelle an Dein Ohr.");

  AddSound( ({"gegroelle"}),
	   "Das Gegroelle kommt aus der Kneipe im Westen.");
  
//-----Details Ende-----
  
AddExit("nordwesten", ROOM "luifinlas82");
AddExit("osten", ROOM "luifinlas29");
AddExit("westen", ROOM "luifkneipe1");
AddExit("sueden", ROOM "luifschmied");

}
