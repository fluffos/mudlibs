// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Lichtung");
  SetProp( P_INT_LONG,
	"Die Lichtung erstrahlt im Glanz der Sonne. Kleine Kieselsteinchen am "
	"Boden bilden den Weg, der ueber die Lichtung fuehrt. Links und rechts "
	"des Weges sind viele Graeser und Blumen zu sehen.Nach Norden zweigt "
	"der Weg ab und fuehrt ueber die Lichtung." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"lichtung"}),
	    "Die Lichtung liegt im vollen Sonnenlicht. Eine grosse Wiese mit "
	    "lauter Blumen ist auf ihr zu sehen. Außerdem zweigt der Weg hier "
	    "nach Norden ab.");

  AddDetail( ({"glanz","sonne"}),
	    "Der Glanz der Sonne taucht die Lichtung in volles Sonnenlicht.");
  
  AddDetail( ({"kieselsteinchen","steinchen"}),
	    "Die Steinchen am Boden bilden einen gut begehbaren Weg.");

  AddDetail( ({"boden","weg","weges"}), 
            "Der Weg besteht aus kleinen Steinchen. Ausserdem zweigt der Weg "
	    "hier nach Norden ab. Am Rand des Weges steht ein kleines Schild.");

  AddDetail( ({"graeser"}),
	    "Viele verschiedene Graeser sind auf der Wiese zu sehen.");

  AddDetail( ({"blumen"}),
	    "Viele verschiedene Blumen stehen auf der Wiese und bluehen in "
	    "voller Pracht.");

  AddDetail( ({"norden"}),
	    "Der Weg zweigt hier nach Norden ab. Ansonsten kannst Du nach "
	    "Westen und Osten gehen.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen blau. Nur ein paar kleine Wolken sind zu "
	    "sehen.");

  AddDetail( ({"wiese"}),
	    "Es ist eine grosse Wiese auf der Lichtung zu sehen. Der Weg auf "
	    "dem Du Dich befindest, schlaengelt sich durch die Blumen und "
	    "Graeser der Wiese.");
  
  AddDetail( ({"sonnenlicht","licht"}),
	    "Das Sonnenlicht laesst die Wiese erstrahlen.");

  AddDetail( ({"rand"}), 
            "Am Rand des Weges steht ein Schild zwischen den Blumen und "
	    "Graesern der Wiese.");

  AddDetail( ({"schild"}),
	    "Du kannst es lesen.");

  AddDetail( ({"pracht"}),
	    "Die Blumen sind sehr schoen.");

  AddDetail( ({"osten","ende"}),
	    "Im Osten fuehrt der Weg wieder in den Wald hinein. Das Ende der "
	    "Lichtung ist dort erreicht.");
  
  AddDetail( ({"westen"}),
	    "Im Westen geht es weiter ueber die Lichtung.");

  AddDetail( ({"wolken","regen"}),
	    "Die Wolken sind schoen weiss. Es wird keinen Regen geben.");
  
  AddDetail( ({"nektar","bienen"}),
	    "Die Bienen sammeln den Nektar.");

  AddDetail( ({"wald"}),
	    "Im Osten kannst Du den Wald betreten.");

  AddReadDetail( ({"schild"}),
		"+-----------------------------------------------+\n"
		"|                    Hubbleton                  |\n"
		"|                        |                      |\n"
		"|                        |                      |\n"
		"|                        |                      |\n"
		"|   Roch Adan <----------+---------> Luifinlas  |\n"
		"|                                               |\n"
		"+-----------------------------------------------+\n");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen duften herrlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Summen.");

  AddSound( ({"summen","bienen"}),
	   "Das Summen stammt sicher von Bienen, die auf der Wiese Nektar "
	   "suchen.");
  
//-----Details Ende-----
  
AddExit("osten", ROOM "luifinlas42");
AddExit("westen", ROOM "luifinlas44");
AddExit("norden", ROOM "luifhd1");

}
