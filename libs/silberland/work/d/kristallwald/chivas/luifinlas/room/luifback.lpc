inherit "std/laden";
inherit "/d/wueste/protheg/most/std_things";

#include "../def.h"
#include <properties.h>
#include <player.h>
#include <moving.h>
#include <laden.h>

#define MAX_BUY 8

nosave mapping gekauft;

void create()
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:22]));

  SetProp(P_INT_SHORT, "In der Baeckerei von Luifinlas");
  SetProp(P_INT_LONG, 
     BS("Du bist in der Baeckerei von Luifinlas. Es riecht verfuehrerisch hier "
	"im Laden. In der Mitte steht ein grosser Tresen, an dem die Waren "
	"verkauft werden. Hinter dem Tresen befinden sich lauter Regale mit "
	"den Koestlichkeiten, die es hier zu kaufen gibt. Nach hinten geht "
	"eine weitere Tuer, wo es in die Backstube geht.")+
     BS("Wenn Du wissen willst, was Du hier kaufen kannst, gib einfach "
        "'zeige' ein."));
  
  AddDetail(({"baeckerei","laden"}), 
	    "Du bist in der Baeckerei.");

  AddDetail(({"luifinlas","stadt"}),                          
	    "Du befindest Dich in Luifinlas. Dies ist eine Stadt im "
	    "Silberland.");
  
  AddDetail(({"mitte","tresen","tresens"}), 
	    "In der Mitte steht ein grosser Tresen und trennt den Laden in "
	    "zwei Haelften.");

  AddDetail(({"waren","koestlichkeiten","backwaren"}),                          
	    "In den Regalen liegen leckere Semmeln, Baguettes, Laugenstangerl "
	    "und vieles mehr.");
  
  AddDetail(({"regale","regalen"}), 
	    "In den Regalen liegen lauter Semmeln, Baguettes und andere "
	    "leckere Sachen.");

  AddDetail(({"tuer"}),                          
	    "Durch die Tuer bist Du rein gekommen. Ausserdem gibt es eine "
	    "weitere Tuer hinter dem Tresen, der anscheinend in die Backstube "
	    "fuehrt. Die kannst Du leider nicht betreten.");
  
  AddDetail(({"backstube"}), 
	    "Die Backstube ist anscheinend hinter der Tuer, die sich auf der "
	    "anderen Seite des Tresens befindet. Du kannst leider nicht in "
	    "die Backstube gehen. Dies ist nur den hier angestellten Personen "
	    "erlaubt.");

  AddDetail(({"boden"}),                          
	    "Der Boden besteht aus Steinplatten und ist sauber geputzt, wie "
	    "man es in einem anstaendigen Laden auch erwarten kann.");
  
  AddDetail(({"decke"}), 
	    "Die Decke ist weiss gestrichen und ansonsten uninteressant.");

  AddDetail(({"waende","wand","norden"}),                          
	    "An der Wand hinter dem Tresen sind Regale aufgestellt. Im Norden "
	    "ist eine Tuer durch die Du die Baeckerei betreten hast. Ansonsten "
	    "sind die Waende weiss gestrichen und sauber.");
  
  AddDetail(({"silberland"}), 
	    "Was das Silberland ist, solltest Du eigentlich wissen.");

  AddDetail(({"haelften","seite","haelfte"}),                          
	    "Auf der einen Haelfte, stehen Kaeufer so wie Du und auf der "
	    "anderen Seite des Tresens steht der Baecker und verkauft Dir "
	    "seine Backwaren und dort befindet sich auch hinter einer Tuer die "
	    "Backstube.");
  
  AddDetail(({"baecker"}), 
	    "Der Baecker backt hier alles.");

  AddDetail(({"baeckerhandwerk"}), 
	    "Das Baeckerhandwerk wird hier noch hoch gehalten.");

  AddDetail(({"herstellen","sachen"}), 
	    "In der Backstube werden viele Sachen hergestellt.");

  AddDetail(({"baeckermeister","meister","faelle","faellen"}), 
	    "Der Baeckermeister backt hier in den meisten Faellen noch "
	    "selbst.");

  AddDetail(({"kaeufer","geld"}),                          
	    "Du bist ein Kaeufer, wenn Du etwas haben willst und genug Geld "
	    "hast.");
  
  AddDetail(({"semmel","semmeln","baguette","baguettes","laugenstangerl","sachen"}), 
	    "Dies kannst Du hier kaufen.");

  AddDetail(({"personen","gehilfen"}),                          
	    "Das ist der Baeckermeister und seine Gehilfen.");

  AddDetail(({"steinplatten","stein","platten"}),                          
	    "Es sind ganz schlichte Platten. An ihnen kann man nichts "
	    "besonderes entdecken.");
  
  AddSmell(DEFAULT_SMELL, 
	   "Es riecht ganz lecker nach Backwaren.");

  AddSmell(({"duft"}),
	   "Der Duft ist verfuehrisch."); 

  AddSmell(({"backwaren"}), 
	   "Der Duft macht Dich hungrig.");

  AddSound(DEFAULT_SOUND, "Du hoerst wie in der Backstube die Backwaren "
		  "hergestellt werden.");

  AddSound( ({"backwaren","backstube","geraeusche"}),
	   "Da Du Dich nicht mit dem Baeckerhandwerk auskennst, gehst Du davon "
	   "aus, dass dies die normalen Geraeusche sind, die beim Herstellen "
	   "von Backwaren entstehen.");


  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "baeckermeister");
  SetProp(P_SHOPKEEPER_NAME, "Der Baeckermeister");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  
  SetStorageRoom(ROOM "luifblager");      

  AddExit("norden", ROOM "luifinlas11");

  AddItem(NPC "baeckermeister", REFRESH_DESTRUCT);  

  
  RemoveFixedObject(0);
  
  gekauft=([]);
}

void reset()
{
  ::reset();
  
  gekauft=([]);
}

int sell(string str, int f)
{
  if(present("baeckermeister"))
    return notify_fail(break_string("Entschuldigt bitte, edler Gast, aber "
				    "wir kaufen hier nichts an.", 78, 
				    "Der junge Baeckermeister meint: ")), 0;
  
  return notify_fail(BS("Der Baeckermeister ist leider nicht da!")), 0;
}

nosave int force_sell(string str) { return sell(); }
nosave int evaluate(string str) { return sell(); }

nosave string do_liste(string str)
{
  object store;
  int i;
  object *inv;
  string *k;
  mapping obj;
  string tmp, out;
    
  call_other(storage, "_register_shop", ME);
  
  if(!objectp(store=find_object(storage))) return "";

  inv=all_inventory(store);
  obj=([]);
  out="";
  
  switch(str)
    {
    case "suesses":
    case "suessgebaeck":
      for(i=sizeof(inv)-1;i>=0;i--)
	if(inv[i]->id("SUESSIGKEIT"))
	  if(member(obj, tmp=explode(file_name(inv[i]), "#")[0]))
	    obj[tmp, 2]+=1;
	  else
	    obj+=([tmp:inv[i]->Name(WER); QueryBuyValue(inv[i]); 1]);
      
      k=m_indices(obj);
      
      for(i=sizeof(obj)-1;i>=0;i--)
	out+=sprintf("  %30-'.'s %1d Stueck zu je %3d Muenzen\n",
		     obj[k[i]]+" ", obj[k[i],2], obj[k[i],1]);
      		     
      break;
      
    case "gebaeck":
    case "salzgebaeck":
      for(i=sizeof(inv)-1;i>=0;i--)
	if(!inv[i]->id("SUESSIGKEIT"))
	  if(member(obj, tmp=explode(file_name(inv[i]), "#")[0]))
	    obj[tmp, 2]+=1;
	  else
	    obj+=([tmp:inv[i]->Name(WER); QueryBuyValue(inv[i]); 1]);

      k=m_indices(obj);
      
      for(i=sizeof(obj)-1;i>=0;i--)
	out+=sprintf("  %30-'.'s %1d Stueck zu je %3d Muenzen\n",
		     obj[k[i]]+" ", obj[k[i],2], obj[k[i],1]);
		     
      break;

    default:
      out+=do_liste("suessgebaeck");
      tmp=do_liste("salzgebaeck");

      if(strlen(out))
	out=" Suessgebaeck\n==============\n"+out+"\n";
            
      if(strlen(tmp))
	tmp=" Salzgebaeck\n=============\n"+tmp;
      
      out+=tmp;
    }
  return out;
}

nosave int list(string str)
{
  string prefix, ret;
  
  notify_fail("Mit 'zeige', 'zeige suessgebaeck' oder 'zeige salzgebaeck' "
		 "siehst Du die Auswahl.");
  
  if((str) && 
     (member(({"suesses","suessgebaeck","salzgebaeck","gebaeck"}), str)==-1)) 
    return 0;
  
  if(!prefix=CheckKeeper()) return 1;
  
  if(strlen(ret=do_liste(str)))
    TP->More(make_document(ret));
  else
    write(BS (prefix+"Ich bin im Moment leider total ausverkauft!"));

  return 1;
}

//Alles unflexibel, muss ich das buy halt ueberschreiben...
nosave int buy(string str)
{
  int i, val;
  object ob, store;
  string prefix, dummy;

  // Im Kampf kann man nichts kaufen
  if(TP->InFight())
    return write(BS ("Dazu bist Du im Moment viel zu beschaeftigt.")), 1;

  // Haendler da? Meldungen etc.
  if(!prefix=CheckKeeper(2)) return 0;
  if(!str)
    return write(BS (KeeperPrefix("fragt Dich: ")+"Was willst Du kaufen?")), 1;

  _notify_fail(prefix+"Das kann ich im Lager nicht finden.\n");
  
  // Objekt suchen
  if(sscanf(str,"%d%s",i,dummy)>0 && i>0)
    if((dummy==" ab") || (dummy=="")) ob=FindInStore(i);
    else ob=FindInStore(str);
  else ob=FindInStore(str);
  
  if(!ob)  return 0;

  if(member(gekauft, getuid(TP)))
    if(gekauft[getuid(TP)] >= MAX_BUY)
      return write(prefix+"Du kaufst noch alles weg!\n"+
		   prefix+"Lass den anderen doch auch etwas ueber!\n"), 1;

  // Geld pruefen
  val=QueryBuyValue(ob);
  if((i=this_player()->QueryMoney()) < val)
    return write(break_string(ob->Name(WER,1)+" wuerde"+
			      (ob->IsPlural() ? "n " : " ")+val+" Muenze"+
			      (val==1 ? "" : "n")+" kosten, Du "+
			      (i ? "hast aber nur "+i+"."
			       : "bist aber voellig pleite!"),
			      78, prefix)), 1;

  // Geldtransfer
  this_player()->AddMoney(-val);
  mymoney += val;

  // fixed object? (staendig verfuegbar)
  if(stringp(ob))
    ob=clone_object((string) ob);

  // Kaufen und als behalten markieren
  write(BS ("Du kaufst Dir "+ob->name(WEN,1)+"."));
  say(BS (TP->Name()+" kauft sich "+ob->name(WEN)+"."));
  ob->SetProp(P_KEEP_ON_SELL, getuid(TP));

  // Kanns der Spieler tragen?
  if (ob->move(this_player(),M_GET) <= 0)
  {
    write(prefix + "Du kannst " + ob->QueryPronoun(WEN) +
        " nicht mehr tragen!\n");
    ob->move(environment(this_player()));       // Objekt in den Raum moven
  }

  UpdateCounter(ob,-1);

  if(member(gekauft, getuid(TP))) gekauft[getuid(TP)]++;
  else gekauft+=([getuid(TP):1]);  

  return 1;
}

mapping QueryVars()
{
  return gekauft;
}
