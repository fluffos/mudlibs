// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Auf dem Waldweg liegen lauter herunter gefallene Blaetter und Aeste "
	"herum. Die Baeume sind hochgewachsen und bilden ein dichtes Dach weit "
	"ueber Deinem Kopf. An den Seiten des Weges haben sich kleinere "
	"Pflanzen wie Moose und Flechten angesiedelt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"waldweg","weg","weges"}),
	    "Der Weg im Wald fuehrt nach entweder nach Nordosten oder nach "
	    "Suedwesten.");

  AddDetail( ({"blaetter"}),
	    "Die Blaetter sind von den Baeumen auf den Weg gefallen.");
  
  AddDetail( ({"aeste"}),
	    "Die Aeste stammen auch von den Baeumen.");

  AddDetail( ({"baeume","baeumen","stamm"}), 
            "Die Baeume sind gross und haben einen dicken Stamm.");

  AddDetail( ({"dach","blaetterdach"}),
	    "Das Blaetterdach, welches die Baeume ueber Dir bilden ist "
	    "sehr dicht.");

  AddDetail( ({"kopf"}),
	    "Du findest, dass Du einen sehr schoenen Kopf hast.");

  AddDetail( ({"seiten"}),
	    "An den Seiten des Weges stehen grosse Baeume und einige andere "
	    "Pflanzen.");
  
  AddDetail( ({"pflanzen"}),
	    "Du erkennst Moose, Flechten und ein paar Pflanzen, die Du nicht "
	    "kennst.");

  AddDetail( ({"moos","moose"}),
	    "Das Moos ist gruen.");
  
  AddDetail( ({"flechten"}),
	    "Die Flechten sind recht klein.");

  AddDetail( ({"boden"}), 
            "Am Boden liegen Blaetter und Aeste.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist durch das dichte Blaetterdach nicht besonders "
	    "gut zu sehen.");

  AddDetail( ({"nordosten","suedwesten","richtungen"}),
	    "Nordosten und Suedwesten sind die Richtungen, in die Du gehen "
	    "kannst.");

  AddDetail( ({"wald"}),
	    "Du bist mitten im Wald.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht waldig.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst hier gar nichts. Es ist recht ruhig.");

//-----Details Ende-----
  
AddExit("nordosten", ROOM "luifinlas35");
AddExit("suedwesten", ROOM "luifinlas37");

}
