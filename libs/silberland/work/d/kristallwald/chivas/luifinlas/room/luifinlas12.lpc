// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Strasse in Luifinlas");
  SetProp( P_INT_LONG,
	"Die Strasse zieht sich von Westen nach Osten tiefer in die Stadt "
        "hinein. Im Sueden steht kein Haus, sondern man kann nur eine freie "
        "Flaeche sehen, die mit Gras und einigen Blumen bewachsen ist. An "
        "der Strasse vor der Wiese steht ein Schild im Boden.\n"
	"Im Norden scheint die Post zu sein, was man an dem Horn erkennt, "
	"welches ueber der Tuer haengt.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"strasse"}),
	    "Du stehst auf einer Strasse in Luifinlas.");

  AddDetail( ({"westen","osten"}),
	    "Im Westen kannst Du die Stadt wieder verlassen und nach "
	    "Osten weiter in die Stadt hinein gehen.");
  
  AddDetail( ({"stadt","luifinlas"}),
	    "Luifinlas ist eine grosse Stadt in der Region Kristallwald.");

  AddDetail( ({"kristallwald","region"}), 
            "Kristallwald ist eine Region im Silberland.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland.");

  AddDetail( ({"haus","haeuser"}),
	    "In einer Stadt gibt es sehr viele Haeuser, deswegen heisst es "
	    "auch Stadt.");

  AddDetail( ({"sueden","flaeche","gras","blumen","wiese"}),
	    "Im Sueden ist eine freie Flaeche, die mit Gras und Blumen bewachsen "
	    "ist. Man kann also sagen, es ist eine kleine Wiese. Vor der Wiese "
	    "steht ein Schild in den Boden gerammt.");
   
  AddDetail( ({"boden"}),
	    "Der Boden besteht aus grossen Steinquadern der Strasse");

  AddDetail( ({"steinquadern","steinquader","stein","quader"}),
	    "Die Steinquader sind gross und quadratisch und wurden hier sicher "
	    "unter schwerster Muehe als Strasse zusammen gesetzt.");
  
  AddDetail( ({"muehe"}),
	    "Du machst Dir nur selten die Muehe nachzudenken bzw. zu forschen.");

  AddDetail( ({"norden","post","nachrichten"}), 
            "Im Norden scheint eine Post zu sein. Besuche sie doch mal und lies "
	    "Deine Nachrichten.");

  AddDetail( ({"tuer"}),
	    "Die Tuer fuehrt Dich in die Post.");

  AddDetail( ({"horn","posthorn"}),
	    "Das Posthorn ueber der Tuer glaenzt golden in der Sonne.");

  AddDetail( ({"sonne","tag"}),
	    "Die Sonne scheint und es ist ein schoener Tag.");
  
  AddDetail( ({"schild"}),
	    "Du kannst das Schild lesen.");

  AddDetail( ({"himmel"}),
	    "Die Sonne scheint und nur ein paar Wolken sind am Himmel zu sehen.");

  AddDetail( ({"wolken"}),
	    "Als Du die Wolken betrachtest, hast du ganz kurz das Gefuehl, dass Du die Augen eines "
	    "Gottes gesehen hast.");

  AddDetail( ({"augen","gottes","gott","goetter"}),
	    "Du kannst jetzt keine Augen mehr sehen, die Goetter haben auch nicht staendig Zeit nach "
	    "Dir zu schauen.");

  AddDetail( ({"gefuehl","gefuehle"}),
	    "Du hast regelmaessig komische Gefuehle, solltest Dich deswegen aber nicht schaemen.");

  AddDetail( ({"zeit"}),
	    "Da die Goetter nicht immer Zeit haben, musst Du auf die selber aufpassen.");

   AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
    AddReadDetail( ({"schild"}),
	    "+--------------------------------------+\n"
	    "|                                      |\n"
	    "|           Ballon-Landeplatz          |\n"
	    "|                                      |\n"
	    "+--------------------------------------+\n");
  
  AddSmell(DEFAULT_SMELL, "Ein leckerer Duft liegt in der Luft.");  
 
  AddSmell( ({"duft","luft","baeckerei"}),
	   "Der leckere Duft stroemt aus der Baeckerei im Westen.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Laerm der Stadt.");

  AddSound( ({"laerm","stadt","waelder","waeldern"}),
	   "In den Waeldern um Luifinlas herum ist es eindeutig ruhiger.");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "luifinlas11");
AddExit("osten", ROOM "luifinlas13");
AddExit("norden", ROOM "luifpost");
AddExit("sueden", ROOM "luifballon");

}
