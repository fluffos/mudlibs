// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Waldrand");
  SetProp( P_INT_LONG,
	"Du stehst direkt an einem Waldrand. Die Baeume wachsen hier bis an "
	"den Rand einer Wiese, die im Nordosten beginnt. Weiter im Norden "
	"kannst Du eine grosse Stadt erkennen. Im Sueden werden die hier "
	"wenigen Baeume mehr und der Wald wird dichter und dunkler." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"waldrand","rand"}),
	    "Hier ist der Waldrand. Im Nordosten beginnt eine grosse Wiese.");

  AddDetail( ({"wiese","nordosten"}),
	    "Die Wiese im Nordosten scheint um eine grosse Stadt im Norden "
	    "zu fuehren. Viele Graeser und Blumen wachsen auf ihr. Auch ein "
	    "paar Baumstuempfe sind zu sehen.");
  
  AddDetail( ({"norden","stadt","luifinlas"}),
	    "Die Stadt im Norden ist Luifinlas.");

  AddDetail( ({"sueden"}), 
            "Im Sueden ist der Wald dichter.");

  AddDetail( ({"baeume"}),
	    "Weiter im Sueden stehen mehr Baeume als hier.");

  AddDetail( ({"wald"}),
	    "Weiter im Sueden ist der Wald richtig dicht.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen lauter kleine Steinchen.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist herrlich blau.");

  AddDetail( ({"blumen"}),
	    "Kleine rote und blaue Blumen sind auf der Wiese zu sehen.");
  
  AddDetail( ({"graeser"}),
	    "Das Gras ist nur halbhoch. Es wird anscheinend regelmaessig von "
	    "Leuten aus der Stadt gemaeht.");

  AddDetail( ({"baumstuempfe","blick","gegend"}), 
            "Die Baeume wurden sicher gefaellt um einen besseren Blick auf die "
	    "umliegende Gegend der Stadt werfen zu muessen. So koennen sich "
	    "keine Feinde an die Stadt heran schleichen.");

  AddDetail( ({"steinchen"}),
	    "Kleine Steinchen bilden den Weg auf dem Du stehst.");

  AddDetail( ({"leuten","leute"}),
	    "Die Leute sind momentan nicht da.");

  AddDetail( ({"feinde"}),
	    "Du siehst momentan keine Feinde.");
  
  AddDetail( ({"weg"}),
	    "Du stehst auf einem Weg, der entweder nach Sueden oder nach "
	    "Nordosten fuehrt.");

  AddDetail( ({"gras"}),
	    "Das Gras auf der Wiese ist halbhoch.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen","duft"}),
	   "Der Duft der Blumen stammt von der Wiese im Nordosten.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel in den Baeumen.");

  AddSound( ({"voegel"}),
	   "*tschip*triller*zwitscher*");
  
//-----Details Ende-----
  
AddExit("nordosten", ROOM "luifinlas32");
AddExit("sueden", ROOM "luifinlas34");

}
