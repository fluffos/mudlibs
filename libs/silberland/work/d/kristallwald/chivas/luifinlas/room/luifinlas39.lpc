// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Wald wird ein wenig lichter und Du kannst zwischen den Baeumen "
	"einen kleinen Bach erkennen, der den Weg weiter im Suedwesten kreuzt. "
	"Einige kleinere Straeucher und auch ein paar Blumen sind am Wegrand "
	"zu sehen. Eigentlich ist es hier recht schoen und angenehm." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wald"}),
	    "Du stehst mitten in dem Wald.");

  AddDetail( ({"baeumen","baeume"}),
	    "Die Baeume sind gross, stehen aber nicht sehr dicht. Du kannst "
	    "zwischen ihnen einen Bach sehen.");
  
  AddDetail( ({"bach"}),
	    "Der Bach kreuzt den Weg im Suedwesten. Du kannst von hier aus "
	    "sehen, wie er ueber einige grosse Steine vor sich hin "
	    "plaetschert.");

  AddDetail( ({"weg","weges"}), 
            "Du stehst auf einem Weg, der durch den Wald fuehrt.");

  AddDetail( ({"suedwesten"}),
	    "Im Suedwesten kreuzt ein kleiner Bach den Weg, wo eine Bruecke "
	    "den Bach ueberquert.");

  AddDetail( ({"straeucher"}),
	    "Einige uninteressante Straeucher stehen am Rand des Weges.");

  AddDetail( ({"blumen"}),
	    "Kleine rote Blumen wachsen am Wegrand. Sie sind sehr huebsch, "
	    "aber Du laesst sie stehen, damit sie auch noch andere erfreuen "
	    "koennen.");
  
  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand sind Baeume, Straeucher und Blumen zu sehen.");

  AddDetail( ({"boden","steinchen"}),
	    "Der Boden besteht aus kleinen Steinchen, wie ueberall auf dem "
	    "Weg.");
  
  AddDetail( ({"himmel","blaetterdach"}),
	    "Der Himmel ist nur teilweise durch das Blaetterdach zu sehen.");

  AddDetail( ({"steine"}), 
            "Grosse Steine liegen im Bach.");

  AddDetail( ({"bruecke"}),
	    "Eine Bruecke ist im Suedwesten zu sehen.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht waldig.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst den Bach plaetschern.");

  AddSound( ({"bach"}),
	   "*plaetscher*");
  
//-----Details Ende-----
  
AddExit("osten", ROOM "luifinlas38");
AddExit("suedwesten", ROOM "luifinlas40");

}
