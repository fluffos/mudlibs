// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Wald um Dich herum ist dicht und undurchdringlich. Zwischen den "
	"grossen Baeumen am Wegrand befindet sich dichtes Unterholz. Auch ein "
	"grosser Findling liegt dort und laesst Dir nicht die Moeglichkeit den "
	"Weg zu verlassen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wald"}),
	    "Der Wald umgibt Dich.");

  AddDetail( ({"baeume","baeumen"}),
	    "Grosse Baeume stehen um Dich herum und grenzen den Weg ein. Die "
	    "Blaetter der Baeume bilden ein dichtes Blaetterdach ueber Dir, "
	    "so dass kaum ein Sonnenstrahl bis auf den dringt.");
  
  AddDetail( ({"unterholz"}),
	    "Das Unterholz ist sehr dicht zwischen den Baeumen.");

  AddDetail( ({"findling"}), 
            "Ein grosser Findling liegt zwischen den Baeumen. Ein paar "
	    "Zeichen sind auf ihm zu erkennen.");

  AddDetail( ({"weg"}),
	    "Der Weg fuehrt von Sueden nach Norden.");

  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand sind lauter Baeume zu sehen.");

  AddDetail( ({"moeglichkeit","moeglichkeiten"}),
	    "Du hast viele Moeglichkeiten hier im Silberland. Nur nicht "
	    "unbedingt hier.");
  
    AddDetail( ({"boden","lichtflecke"}),
	    "Am Boden siehst Du einige Lichtflecke, die von den wenigen "
	    "Sonnenstrahlen stammen, die auf den Boden treffen. Ausserdem ist "
	    "viel Laub und Kieselsteine zu sehen.");

  AddDetail( ({"blaetter","farben","formen"}),
	    "Die Blaetter haben alle moeglichen Farben und Formen und bilden "
	    "ein dichtes Blaetterdach.");
  
  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach weit ueber Dir ist sehr dicht.");

  AddDetail( ({"sonnenstrahl","strahl","strahlen","sonnenstrahlen"}), 
            "Nur einige Sonnenstrahlen treffen den Boden und erhellen ihn nur "
	    "ein wenig.");

  AddDetail( ({"zeichen"}),
	    "Es sind lauter kleine Schriftzeichen.");

  AddDetail( ({"sueden"}),
	    "Im Sueden geht der Weg weiter durch den Wald.");

  AddDetail( ({"norden","kreuzung"}),
	    "Im Norden scheint eine Kreuzung zu sein.");
  
  AddDetail( ({"kieselsteine","steine"}),
	    "Es sind ganz normale kleine Steine.");

  AddDetail( ({"laub"}),
	    "Das Laub ist halb verrottet und sammelt sich hier am Boden.");
  
  AddDetail( ({"schriftzeichen"}),
	    "Die Schriftzeichen sind sehr alt und wurden in einer alten "
	    "Keilschrift geschrieben.");

  AddDetail( ({"keilschrift"}), 
            "Die Keilschrift ist mehrere tausend Jahre alt. Du kannst sie "
	    "nicht mehr lesen.");

  AddDetail( ({"jahre"}),
	    "So alt wirst Du nie.");

  AddDetail( ({"himmel"}),
	    "Der Himmel muesst ueber Dir sein, so wie der Boden unter Dir.");

  AddDetail( ({"silberland"}),
	    "Du befindest Dich momentan im Silberland.");  

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht komischerweise nach Wald.");  
 
  AddSmell( ({"wald","geruch"}),
	   "Dir gefaellt der Geruch.");

  AddSound(DEFAULT_SOUND, "Du hoerst weit ueber Dir Voegel zwitschern.");

  AddSound( ({"voegel"}),
	   "*zwitscher*zwitscher*");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas37");
AddExit("sueden", ROOM "luifinlas49");

}
