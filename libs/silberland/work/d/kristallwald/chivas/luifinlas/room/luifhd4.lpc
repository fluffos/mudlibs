// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  AddRoomMessage( ({ "Die Blaetter an den Baeumen bewegen sich leicht im "
		     "Wind.\n"}),
                     30, "sound" );

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Die grossen Baeume saeumen den Weg, der sich von Nordosten nach "
	"Sueden zieht. Die Baeume stehen aber nicht so dicht, dass es "
	"beklemmend wirken wuerde, sondern weit genug auseinander, so dass "
	"ein paar Buesche zwischen ihnen wachsen koennen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"baeume","baeumen"}),
	    "Die Baeume sind sehr gross und bilden ueber Dir ein Blaetterdach, "
	    "dass den gesamten Weg auf dem Du Dich befindest ueberspannt.");

  AddDetail( ({"weg"}),
	    "Der Weg fuehrt entweder nach Nordosten oder aber nach Sueden. Es "
	    "kommt darauf an, wohin Du gehen willst.");
  
  AddDetail( ({"nordosten","sueden"}),
	    "In diese Richtung kannst Du gehen.");

  AddDetail( ({"buesche"}), 
            "Die Buesche wachsen zwischen den Baeumen. Sie sind klein, rund "
	    "und nicht sehr ansprechend.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen Blaetter und Nadeln der Baeume. Ausserdem siehst "
	    "Du kleine Steinchen.");

  AddDetail( ({"himmel"}),
	    "Den Himmel kannst Du nur teilweise sehen. Das Blaetterdach ist "
	    "zwar nicht sehr dicht, behindert Dich jedoch soweit, dass Du den "
	    "Himmel nicht komplett sehen kannst.");

  AddDetail( ({"blaetterdach","dach","licht"}),
	    "Das Blaetterdach ist nicht sehr dicht. Viel Licht erreicht den "
	    "Weg auf dem Du Dich befindest.");
  
  AddDetail( ({"richtung","reboot"}),
	    "Du musst eine Richtung waehlen oder hier stehen bleiben und auf "
	    "den naechsten Reboot warten.");

  AddDetail( ({"blaetter"}),
	    "Einige Blaetter liegen am Boden und viele haengen an den Aesten "
	    "der Baeume.");
  
  AddDetail( ({"nadeln"}),
	    "Viele Nadeln sind auf den Boden gefallen.");

  AddDetail( ({"steinchen"}), 
            "Die Steinchen bilden den urspruenglichen Weg. Die Blaetter und "
	    "Nadeln sind von den Baeumen dazu gekommen.");

  AddDetail( ({"wind"}),
	    "Die Blaetter an den Baeumen bewegen sich leicht im Wind weiter "
	    "oben. Hier unten ist es windstill.");

  AddDetail( ({"aeste"}),
	    "Hier im Wald gibt es viele Aeste an den Baeumen. Einfach "
	    "wunderbar!!!");

  AddDetail( ({"wald"}),
	    "Du bist im Wald.");

  AddDetail( ({"wipfeln","wipfel"}),
	    "Die Wipfel sind weit ueber Dir.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht einfach nur waldig.");  

  AddSound(DEFAULT_SOUND, "Du hoerst ein Rascheln.");

  AddSound( ({"rascheln","blaetter","wind"}),
	   "Das Rascheln kommt vom Wind, der durch die Blaetter weit oben "
	   "in den Wipfeln weht.");
  
//-----Details Ende-----
  
AddExit("nordosten", ROOM "luifhd5");
AddExit("sueden", ROOM "luifhd3");

}
