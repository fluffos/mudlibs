inherit "std/pub";

#include "../def.h"
#include <pub.h>


void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp(P_INT_SHORT,"In der Wirtschaft 'Zum lustigen Hobbit'");
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "milo");
  SetProp(P_PUBKEEPER_NAME, "milo");
  SetProp(P_PUBMSG_NOKEEPER, "Milo Breitfuss ist leider nicht hier.\n");
  SetProp(P_PUBMSG_NOENEMY, BS(
      "Du bist gerade in einem verbissen Kampf mit Milo Breitfuss. Kein Wunder, "
      "dass er Dich nicht bedient."));
  SetProp(P_PUBMSG_NOINVITE, BS(
      "Milo Breitfuss kaempft. Da hat er wahrhaft andere Sorgen als Kunden."));
  SetProp(P_PUBMSG_FIGHTING, "Milo Breitfuss kaempft gerade.\n");

  AddDrink("Hobbitbraeu", ({"braeu","hobbitbraeu"}),
           500, 55, 10, 6,
           ({"Milo Breitfuss nickt und bringt Dir ein grosses Glas "
	    "Hobbitbraeu.\n",
             "&& trinkt ein grosses Glas Hobbitbraeu.\n"}));

  AddDrink("1 Becher Rachenputzer", ({"becher","putzer","rachenputzer"}),
            220, 28, 9, 3,
           ({"Milo Breitfuss bringt Dir einen Becher und guckt Dich ein wenig "
	    "suspekt an. Wer trinkt sowas.\n"
            +"Dir bleibt die Luft weg, als Du den Becher herunter "
	    "schluckst. \n",
             "&& trinkt einen Becher und wird ganz rot im Gesicht.\n"}));

  AddDrink("Hobbittee", ({"Hobbittee","tee"}),
            150, 15, 0, 5,
           ({"Milo Breitfuss bringt Dir eine Tasse starken Hobbittee.\n"
            +"Der schmeckt fuer Tee nicht schlecht und beruhigt!\n",
             "&& trinkt eine Tasse Hobbittee.\n"}));

  AddFood("Hobbits Allerlei", ({"hobbits allerlei", "allerlei"}), 200, 25, 9,
           ({"Milo Breitfuss bringt Dir eine Schale mit Hobbits Allerlei. "
            +"\nHmmmm, es schmeckt lecker. Sieht aber ekelig aus.\n",
             "&& isst eine Portion Allerlei.\n"}));
  AddFood("Eine Portion Pudding", ({"portion","pudding"}), 80, 10, 4,
           ({"Milo Breitfuss bringt Dir eine Portion Pudding.\n"
            +BS("Der Pudding schmeckt sehr lecker und suess."),
             "&& isst gierig eine Delikatesse.\n"}));

// ----------  Details  ---------------------

  AddDetail( ({"menue"}),
	    "Das Menue haengt an der Wand. Tipp 'menue' und Du siehst was Du "
	    "bestellen kannst.");

  AddDetail( ({"osten","luifinlas","stadt"}),
	    "Im Osten ist ein grosse Stadt namens Luifinlas.");

  AddDetail( ({"kneipen"}),
	    "Andere Kneipen gibt es hier in Hubbleton nicht. Da musst Du schon "
	    "weiter nach Osten nach Luifinlas gehen. Da gibt es einige "
	    "Kneipen.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland.");

  AddDetail( ({"ambiente"}),
	    "Das Ambiente ist sehr gut und Du fuehlst Dich wohl.");

  AddDetail( ({"theke"}),
	    "Die Theke ist kleiner als in anderen Kneipen, aber sie ist sauber "
	    "und ordentlich geputzt.");

  AddDetail( ({"eindruck"}),
	    "Die Wirtschaft ist sehr sauber und gemuetlich.");

  AddDetail( ({"waenden","waende","wand"}),
	    "Die Waende bestehen aus Holz und viele Bilder haengen daran. Auch "
	    "das Menue haengt an der Wand.");

  AddDetail( ({"bilder"}),
	    "An den Waenden haengen viele Bilder von Hobbits. Sie alle "
	    "laecheln auf den Bildern. Es wirkt alles sehr freundlich und nett "
	    "hier.");

  AddDetail( ({"tische"}),
	    "An den Tischen sitzen viele Hobbits und reden miteinander und "
	    "trinken etwas.");

  AddDetail( ({"stuehle"}),
	    "Die Stuehle sind teilweise mit Gaesten besetzt.");
  
  AddDetail( ({"rassen"}),
	    "Es gibt viele Rassen im Silberland.");

  AddDetail( ({"hobbitgroesse","groesse"}),
	    "Die Hobbits sind kleiner als die meisten Rassen im Silberland.");

  AddDetail( ({"inventar"}),
	    "Das Inventar ist an die Groesse der Hobbits angepasst.");

  AddDetail( ({"gaeste"}),
	    "Die Gaeste sind fast nur Hobbits.");

  AddDetail( ({"fenster"}),
	    "Die Fenster sind klein und rund. Sie passen eigentlich sehr gut "
	    "zu dem Ambiente in der Wirtschaft.");

  AddDetail( ({"hobbithuegel","huegel"}),
	    "Die Wirtschaft ist in einen Huegel gebaut worden, wie es bei den "
	    "Hobbits ueblich ist. Den Huegel selbst kannst Du natuerlich nur "
	    "von draussen sehen.");

  AddDetail( ({"hobbit","hobbits"}),
	    "Hier im Dorf wohnen nur Hobbits. Dementsprechend heisst auch die " 
	    "Wirtschaft und auch die Gaeste bestehen fast nur aus Hobbits.");

  AddDetail( ({"dorf","hubbleton"}),
	    "Die Wirtschaft in der Du gerade bist ist in dem kleinen Dorf "
	    "Hubbleton.");

  AddDetail( ({"wirtschaft","zum"}),
	    "Du bist in der Wirtschaft 'Zum lustigen Hobbit'.");

  AddDetail( ({"boden"}),
	    "Der Boden besteht aus Holz. Du siehst dicke Holzbohlen.");

  AddDetail( ({"holz"}),
	    "Du siehst hier viel Holz in der Wirtschaft.");

  AddDetail( ({"holzbohlen"}),
	    "Zwischen den Holzbohlen ist viel Dreck zu sehen.");

  AddDetail( ({"dreck","pech","zaubertrank"}),
	    "Du hast leider Pech. Hier gibt es keinen Zaubertrank.");

  AddDetail( ({"wirt"}),
	    "Du kannst den Wirt auf fragen, wenn er da ist.");

  AddDetail( ({"decke"}),
	    "An der Decke haengen mehrere Leuchter.");

  AddDetail( ({"leuchter","leuchtern"}),
	    "An den Leuchtern haengen Kerzen.");

  AddDetail( ({"kerzen"}),
	    "Die Kerzen brennen und sorgen fuer zusaetzlich Licht.");

  AddDetail( ({"licht"}),
	    "Auch durch die kleinen runden Fenster dringt ein wenig Licht "
	    "in die Gaststube.");

  AddDetail( ({"fenster"}),
	    "Kleine runde Fenster sind an den Waenden zu sehen.");

  AddDetail( ({"gaststube","stube"}),
	    "Du bist in der Gaststube der Wirtschaft.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Alkohol und gebratenem Essen.");  
 
  AddSmell( ({"alkohol","geruch"}),
	   "Der Geruch von Alkohol macht Dich schon fast besoffen.");

  AddSmell( ({"essen"}),
	   "Das gebratene Essen riecht schon sehr lecker.");

  AddSound(DEFAULT_SOUND, "Du hoerst die anderen Gaeste, wie sie miteinander "
		          "reden. Ausserdem hoerst Du wie in der Kueche hinter "
			  "der Theke gekocht wird.");

  AddSound( ({"gaeste"}),
	   "Die Gaeste zu belauschen waere nicht nett. Schaem Dich.");
  
  AddSound( ({"kueche","geklapper","geschirr"}),
		"Du hoerst das Geklapper von Geschirr.");

// ----------- Details Ende -------------------
  AddExit("osten", ROOM "luifinlas103");

  AddItem(NPC "milo", REFRESH_DESTRUCT);
}

string _query_int_long()
{
  string txt;

  txt = "Du befindest Dich in der Wirtschaft 'Zum lustigen Hobbit' im kleinen "
	"Dorf Hubbleton. Die Wirtschaft ist in einen typischen Hobbithuegel "
	"gebaut und hat kleine runde Fenster. Auch das Inventar ist der "
	"Hobbitgroesse angepasst und fuer alle anderen Rassen ein wenig zu "
	"niedrig. Die kleinen Stuehle und Tische und die vielen Bilder an den "
	"Waenden machen einen sehr gemuetlichen Eindruck. Die Theke an der Du "
	"stehst ist sauber und alles macht einen gepflegten Eindruck.";

  if(QueryProp(P_PUBKEEPER_ID))
  {
    if(!present(QueryProp(P_PUBKEEPER_ID)))
    {
      txt += "Seltsamerweise ist offenbar gerade niemand hier der Dich "
        "bedienen koennte.";
    }
    else
    {
      txt += "Der Wirt steht hinter der Theke und laechelt Dich "
        "grimmig an.";
    }
  }

  return BS(txt);
}
