// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Strasse in Luifinlas");
  SetProp( P_INT_LONG,
	"Die Strasse endet hier im Wohngebiet. Die Haeuser hier sind in einem "
	"guten Zustand und vor den Fenstern haengen Blumenkaesten. Da die "
	"Strasse hier endet und ein wenig breiter ist, haben die Einwohner "
	"einen Springbrunnen hier angelegt.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"strasse","norden"}), 
            "Die Strasse endet hier und fuehrt nur zurueck nach Norden.");
  
  AddDetail( ({"wohngebiet"}), 
            "Du bist mitten in einem Wohngebiet.");  

  AddDetail( ({"haeuser","sueden","suedwesten","suedosten"}), 
            "Die Haeuser hier sind schoen und sehen sehr gepflegt aus. Die "
	    "Haeuser im Suedosten, Suedwesten und Sueden kannst Du betreten."); 

  AddDetail( ({"zustand"}), 
            "Der Zustand der Haeuser ist gut.");  

  AddDetail( ({"fenster","fenstern"}), 
            "Vor den Fenstern siehst Du Blumenkaesten haengen.");  

  AddDetail( ({"blumenkaesten"}), 
            "In den Blumenkaesten sind viele Blumen zu sehen.");  

  AddDetail( ({"einwohner"}), 
            "Luifinlas hat viele Einwohner.");  

  AddDetail( ({"springbrunnen","brunnen","brunnens"}), 
            "Der Springbrunnen besteht aus Granit. Grosse Steingargoyles "
	    "spucken Wasser vom Rand des Brunnens in das Becken.");  

  AddDetail( ({"boden"}), 
            "Der Boden ist mit Steinen gepflastert und ein paar Pfuetzen sind "
	    "zu sehen.");  

  AddDetail( ({"himmel"}), 
            "Der Himmel ueber Dir ist blau.");  

  AddDetail( ({"blumen"}), 
            "Du siehst kleine rote, blaue und gelbe Blumen in den "
	    "Blumenkaesten. Sie sehen sehr huebsch aus.");  

  AddDetail( ({"luifinlas","stadt"}), 
            "Du bist in Luifinlas. Sie ist eine grosse Stadt im Silberland.");  

  AddDetail( ({"granit","gestein","arbeit"}), 
            "Granit ist ein hartes Gestein. Es war sicher eine harte Arbeit "
	    "den Brunnen zu erschaffen.");  

  AddDetail( ({"steingargoyles","steingargoyle","gargoyle"}), 
            "Die Steingargoyles sehen fast lebendig aus. Sie sitzen am Rand "
	    "des Brunnens und spucken Wasser in das Becken.");  

  AddDetail( ({"rand"}), 
            "Am Rand sitzen einige Gargoyles und spucken Wasser in das "
	    "Becken.");  

  AddDetail( ({"wasser"}), 
            "Du siehst im Wasser einige Fische.");  

  AddDetail( ({"becken"}), 
            "Das Becken ist breit und beinhaltet viel Wasser.");  

  AddDetail( ({"silberland"}), 
            "Du bist im Silberland.");  

  AddDetail( ({"fische"}), 
            "Es sind kleine Goldfische.");  

  AddDetail( ({"goldfische"}), 
            "Die Goldfische sind sicher von einem Einwohner in das Becken "
	    "gesetzt worden.");  

  AddDetail( ({"steinen","steine","pflaster"}), 
            "Die Steine bilden die Strasse hier in Luifinlas.");  

  AddDetail( ({"pfuetzen","pfuetze"}), 
            "Die Pfuetzen sind momentan nicht sehr interessant.");  

  AddDetail( ({""}), 
            "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddSmell(DEFAULT_SMELL, "Es riecht einfach nur nach Stadt.");  
 
  AddSmell( ({"stadt","gerueche"}),
	   "Du riechst gern die Gerueche der Stadt.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Plaetschern.");

  AddSound( ({"plaetschern","springbrunnen","wasser"}),
	   "Das Plaetschern stammt von dem Wasser aus dem Springbrunnen.");

//-----Details Ende-----
  
AddExit("sueden", ROOM "luifbau2");
AddExit("suedwesten", ROOM "luifbau1");
AddExit("suedosten", ROOM "luifbau3");
AddExit("norden", ROOM "luifinlas108");

}
