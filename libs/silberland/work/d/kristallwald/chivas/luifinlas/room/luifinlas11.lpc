// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Strasse in Luifinlas");
  SetProp( P_INT_LONG,
	"Die Strasse verlaesst in Richtung Westen die Stadt durch den "
	"Durchgang , der durch die Stadtmauer von Luifinlas fuehrt. Nach Osten "
	"kommt man tiefer in die Stadt hinein. Im Norden ist ein sauber "
	"geweisseltes Haus mit einem grossen Schild darueber. Im Sueden "
	"befindet sich anscheined ein Baecker, da aus der Tuer ein leckerer "
	"Duft weht. Nach Nordwestoben und nach Suedwestoben kann man eine "
	"Treppe hinauf auf die Stadtmauer gelangen.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"strasse"}),
	    "Die Strasse fuehrt nach Osten und Westen.");

  AddDetail( ({"richtung"}),
	    "In Richtung Westen geht es durch die Stadtmauer aus der Stadt "
	    "heraus. Nach Osten kommt man tiefer in die Stadt.");
  
  AddDetail( ({"westen","durchgang","tor"}),
	    "Durch einen grossen Durchgang in der Stadtmauer kann man die "
	    "Stadt verlassen. Das eiserne Tor im Durchgang ist geoeffnet.");

  AddDetail( ({"stadtmauer","mauer","seiten","meter"}), 
            "Die Stadtmauer ist mehrere Meter hoch und besteht aus grossen "
	    "Steinquadern. Eine Treppe fuehrt jeweils an beiden Seiten des "
	    "Durchgangs auf die Stadtmauer.");

  AddDetail( ({"luifinlas","stadt"}),
	    "Du bist in einer Stadt, die Luifinlas heisst.");

  AddDetail( ({"norden","haus","eingang"}),
	    "Im Norden ist ein grosses Haus. Ueber dem Eingang haengt ein "
	    "grosses Schild. ");

  AddDetail( ({"schild"}),
	    "Du kannst das Schild lesen.");
  
  AddDetail( ({"sueden","baecker","baeckers"}),
	    "Im Sueden ist der Baecker von Luifinlas.");

  AddDetail( ({"tuer"}),
	    "Die Tuer des Baeckers steht offen und Du kannst ihn besuchen.");
  
  AddDetail( ({"nordwestoben","suedwestoben","treppe"}),
	    "Eine steinerne Treppe fuehrt nach Suedwestoben und Nordwestoben "
	    "an der Stadtmauer hinauf.");

  AddDetail( ({"osten"}), 
            "Nach Osten dringt man tiefer in die Stadt ein.");

  AddDetail( ({"steinquadern","steinquader","stein","quader","angriffen"}),
	    "Die grossen Steinquader bilden eine starke Mauer, die die Stadt "
	    "vor Angriffen schuetzt.");

  AddDetail( ({"boden","fall"}),
	    "Der Boden der Strasse ist gepflastert, wie es in der ganzen "
	    "Stadt der Fall ist.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist wunderschoen blau.");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({"waeldern","waelder"}),
	    "Wenn Du Waelder sehen willst, dann musst Du schon die Stadt "
	    "verlassen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddReadDetail( ({"schild"}),
	    "+--------------------------------------+\n"
	    "|                                      |\n"
	    "| Rekrutierungsbuero der Fremdenlegion |\n"
	    "|                                      |\n"
	    "+--------------------------------------+\n");
  
  AddSmell(DEFAULT_SMELL, "Ein leckerer Duft liegt in der Luft.");  
 
  AddSmell( ({"duft","luft","baeckerei"}),
	   "Der leckere Duft stroemt aus der Baeckerei im Sueden.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Laerm der Stadt.");

  AddSound( ({"laerm","stadt"}),
	   "In den Waeldern um Luifinlas herum ist es eindeutig ruhiger.");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "luifinlas10");
AddExit("osten", ROOM "luifinlas12");
AddExit("norden", ROOM "luiflegion");
AddExit("sueden", ROOM "luifback");
AddExit("nordwestoben", ROOM "luifst3");
AddExit("suedwestoben", ROOM "luifst1");
}
