// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Wiese");
  SetProp( P_INT_LONG,
	"Die Wiese liegt im gleissenden Sonnenlicht. Einige Blumen und Graeser "
	"sind zu sehen. Auch vereinzelte Baeume sind auf der Wiese zu sehen. "
	"Im Nordwesten beginnt ein Wald und nach Sueden geht die Wiese "
	"weiter." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wiese","sueden"}),
	    "Die Wiese erstreckt sich weit nach Sueden. In der Ferne kannst Du "
	    "ein paar grasbedeckte Huegel erkennen.");

  AddDetail( ({"sonnenlicht","licht"}),
	    "Die Wiese liegt in vollem Sonnenlicht. Kein Woelkchen ist am "
	    "Himmel zu sehen.");
  
  AddDetail( ({"blumen"}),
	    "Nur vereinzelte Gaensebluemchen sind auf der Wiese zwischen dem "
	    "hohen Gras zu sehen.");

  AddDetail( ({"graeser","gras"}), 
            "Das Gras der Wiese ist hier sehr hoch und wild gewachsen. Im "
	    "Sueden ist es kuerzer. ");

  AddDetail( ({"baeume"}),
	    "Vereinzelte Baeume stehen auf der Wiese. Weiter im Sueden stehen "
	    "sie sogar direkt am Weg. Von hier kannst Du nicht viel erkennen.");

  AddDetail( ({"nordwesten","wald","waldes"}),
	    "Im Nordwesten von hier beginnt ein Wald. Der Weg auf dem Du "
	    "stehst fuehrt in ihn hinein.");

  AddDetail( ({"boden","steinchen"}),
	    "Der Boden ist mit kleinen Steinchen bedeckt.");
  
  AddDetail( ({"himmel","sonne"}),
	    "Der Himmel ist blau und die Sonne scheint.");

  AddDetail( ({"ferne","huegel"}),
	    "Um mehr von den Huegeln in der Ferne zu sehen, musst Du naeher "
	    "ran gehen.");
  
  AddDetail( ({"weg","zeit"}),
	    "Du stehst auf einem Weg. Du bist ihm schon eine Zeit lang "
	    "gefolgt, da Du ansonsten nicht hier waerst.");

  AddDetail( ({"woelkchen"}), 
            "Die Woelkchen sind weiss. Es wird sicher nicht regnen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen","gaensebluemchen"}),
	   "Die Gaensebluemchen auf der Wiese riechen gut.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Blaetter des Waldes rauschen.");

  AddSound( ({"blaetter","wind","rauschen"}),
	   "Das Rauschen stammt vom Wind, der durch die Blaetter weht.");
  
//-----Details Ende-----
  
AddExit("nordwesten", ROOM "luifinlas67");
AddExit("sueden", ROOM "luifinlas104");


}

