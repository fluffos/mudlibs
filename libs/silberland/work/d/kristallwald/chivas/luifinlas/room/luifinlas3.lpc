// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Die Baeume sind hier recht stark gemischt. Du siehst Laubbaeume und "
	"Nadelbaeume am Wegrand stehen. Auch ein paar Straeucher sind hier. "
	"Im Norden ist eine Bruecke zu sehen, die ueber einen kleinen Bach "
	"fuehrt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"baeume","baeumen","stelle"}),
	    "Es gibt hier viele verschiedene Baeume. Es gibt Laubbaeume und "
	    "Nadelbaeume an dieser Stelle im Wald.");

  AddDetail( ({"laubbaeume"}),
	    "Du siehst hauptsaechlich Buchen. Ausserdem sind Eichen und ein "
	    "paar Ahorn zu sehen.");
  
  AddDetail( ({"nadelbaeume"}),
	    "Du erkennst ein paar Tannen und einige Kiefern.");

  AddDetail( ({"wegrand","rand"}), 
            "Am Wegrand stehen viele Baeume und einige Straeucher.");

  AddDetail( ({"straeucher","abwechslung"}),
	    "Die Straeucher bieten zwischen den Baeumen ein wenig "
	    "Abwechslung.");

  AddDetail( ({"norden","bruecke"}),
	    "Im Norden fuehrt eine Bruecke ueber einen kleinen Bach.");

  AddDetail( ({"bach"}),
	    "Der Bach plaetschert vor sich hin.");
   
  AddDetail( ({"boden","steinchen"}),
	    "Der Boden ist mit kleinen Steinchen bedeckt.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist durch das Blaetterdach nur zu erahnen.");
  
  AddDetail( ({"wald"}),
	    "Du bist mitten in einem Wald.");

  AddDetail( ({"buchen"}), 
            "Die Buchen sind sehr hoch und stehen am Wegrand.");

  AddDetail( ({"eichen"}),
	    "Einige alten Eichen sind hier zu sehen.");

  AddDetail( ({"ahorn"}),
	    "Ein paar Ahorn sind auch vorhanden.");

  AddDetail( ({"tannen","nadeln"}),
	    "Die Tannen haben viele Nadeln.");
  
  AddDetail( ({"kiefern"}),
	    "Ein paar Kiefern sind zu sehen.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach ist sehr dicht.");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht waldig.");  

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel.");

  AddSound( ({"voegel"}),
	   "*zwitscher*");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas2");
AddExit("suedosten", ROOM "luifinlas4");

}

