// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Wald ist sehr dicht. Viele grosse Baeume stehen direkt am Weg. "
	"Im Norden ist eine Kreuzung zu sehen und im Sueden scheint eine "
	"Bruecke einen Bach zu ueberqueren. Der Weg selbst ist breit und gut "
	"begehbar und fuehrt von Norden nach Sueden oder anders herum." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wald","richtung"}),
	    "Der dichte Wald um Dich herum gibt dem Weg, auf dem Du stehst "
	    "die Richtung vor.");

  AddDetail( ({"baeume"}),
	    "Die Baeume stehen sehr dicht am Weg.");
  
  AddDetail( ({"weg"}),
	    "Der Weg ist mit kleinen Steinchen bedeckt und fuehrt von Norden "
	    "nach Sueden oder anders herum. Es kommt darauf an, von wo Du "
	    "kommst.");

  AddDetail( ({"norden","kreuzung"}), 
            "im Norden teilt sich der Weg.");

  AddDetail( ({"sueden","bruecke","bach"}),
	    "Im Sueden ist ein Bach zu sehen und eine kleine Bruecke, die "
	    "ueber ihn hinweg fuehrt.");

  AddDetail( ({"boden","steinchen"}),
	    "Die Steinchen am Boden bilden den Weg.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist durch die vielen Blaetter kaum zu sehen.");
  
  AddDetail( ({"blaetter","sicht"}),
	    "Die Blaetter haengen an den Baeumen und versperren Dir die Sicht "
	    "nach oben auf den Himmel.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht wie in einem Wald ueblich.");  
 
  AddSmell( ({"wald"}),
	   "Du warst doch sicher schon oefter in einem Wald und weisst daher "
	   "wie es dort riecht.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Bach im Sueden plaetschern.");

//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas5");
AddExit("sueden", ROOM "luifinlas84");


}

