// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Ein grosser Baumstamm liegt ueber dem Weg und versperrt den Weg nach "
        "Suedosten. Er ist aus dem Wald heraus auf den Weg gefallen. Die "
	"uebrigen Baeume stellen eine unueberwindbare Wand dar, so dass Du den "
	"Weg nicht verlassen kannst." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"baumstamm","stamm"}),
	    "Ein grosser Baumstamm liegt ueber dem Weg nach Suedosten. Da "
	    "musst Du wohl drueber klettern.");

  AddDetail( ({"weg"}),
	    "Der Weg fuehrt durch den Wald und Du kannst ihn nicht verlassen. "
	    "Du kannst nur nach Nordwesten oder nach Sueden, aber da musst Du "
	    "ueber einen Baumstamm klettern.");
  
  AddDetail( ({"suedosten"}),
	    "Nach Suedosten versperrt ein grosser Baumstamm den Weg durch den "
	    "Wald.");

  AddDetail( ({"wald"}), 
            "Du stehst mitten im Wald auf einem Weg zwischen grossen Baeumen.");

  AddDetail( ({"baeume","wand","baeumen"}),
	    "Die Baeume stehen sehr dicht und bilden eine undurchdringliche "
	    "Wand.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit Steinchen und ein paar Blaettern bedeckt.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist durch das dichte Blaetterdach nicht zu sehen.");
  
  AddDetail( ({"nordwesten"}),
	    "Nach Nordwesten kannst Du weiter durch den Wald gehen.");

  AddDetail( ({"blaettern","blaetter"}),
	    "Viele Blaetter sind natuerlich an den Baeumen, aber einige "
	    "liegen auch auf dem Boden.");
  
  AddDetail( ({"steinchen"}),
	    "Viele Steinchen bilden den Weg am Boden.");

  AddDetail( ({"blaetterdach","dach"}), 
            "Das Blaetterdach ist sehr dicht.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht waldig.");  

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel im Blaetterdach.");

  AddSound( ({"voegel"}),
	   "*triller*");
  
//-----Details Ende-----
  
AddExit("nordwesten", ROOM "luifinlas87");

AddCmd( ({"kletter", "klettere" }), "klettern" );

}
int klettern(string str)
{
   notify_fail("Wo moechtest Du drueber klettern?\n");
   if ( member( ({ "ueber baum","ueber baumstamm","ueber stamm" }),str) != -1) 
  {
    write(BS ( "Du kletterst ohne viel Muehe ueber den auf den Weg gefallenen "
               "Baumstamm.\n"));
      TP->move( ROOM "luifinlas1", M_GO, 
      "ueber einen Baumstamm", "klettert", 
      "klettert ueber einen Baumstamm herein");
    return 1;
  }
}

