// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();
  AddRoomMessage( ({ "Einige kleine lebendig gewordene Papierzettel flattern "
                     "aufgeregt im Arbeitsraum umher.\n"}),
                     30, "sound" );
  
  SetProp( P_INT_SHORT, "Im Magierturm von Luifinlas");
  SetProp( P_INT_LONG,
	"Dieses ist der Arbeitsraum von Merlin. Es liegen vollgeschriebene "
      "Zettel auf dem Boden, die Waende sind mit Kreidezeichen zugekritzelt. "
      "Man merkt, dass dieser Raum dafuer da ist, dass Merlin fuer sich "
      "ungestoert arbeiten kann. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"arbeitsraum","raum"}),
	    "Du bist im Arbeitsraum von Merlin. Er hat sich hier nieder "
	    "gelassen um zu arbeiten.");

  AddDetail( ({"merlin","magier"}),
	    "Merlin ist eine grosser Magier.");
  
  AddDetail( ({"zettel"}),
	    "Viele Zettel liegen auf dem Boden.");

  AddDetail( ({"boden","holz"}), 
            "Der Boden besteht aus Holz.");

  AddDetail( ({"waende","wand"}),
	    "Die Waende sind mit Kreidezeichen zugekritzelt.");

  AddDetail( ({"kreidezeichen","zeichen"}),
	    "Du kannst sie leider nicht lesen und verstehst sie auch nicht.");

  AddDetail( ({"raum"}),
	    "Der Raum ist der Arbeitsraum von Merlin und seine Testies "
	    "springen von hier in neue Gebiete.");
  
  AddDetail( ({"decke"}),
	    "An der Decke sind Wolken zu sehen.");

  AddDetail( ({"papierzettel"}),
	    "Einige magische Papierzettel fliegen im Raum herum.");
  
  AddDetail( ({"gebiete"}),
	    "Du darfst sicher nicht in diese Gebiete.");

  AddDetail( ({"testies","testie"}), 
            "Du bist sicher kein Testie.");

  AddDetail( ({"wolken"}),
	    "Die Wolken sind magisch, denn in einem Raum haben ja Wolken "
	    "nichts verloren.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Papier und Tinte.");  
 
  AddSmell( ({"papier","tinte"}),
	   "Danach sollte ein Arbeitsraum auch riechen.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Papierzettel im Raum rumflattern.");

  AddSound( ({"papierzettel","flattern"}),
	   "Sie rascheln beim Flattern.");
  
//-----Details Ende-----
  
AddExit("unten", ROOM "luifmag2");
AddSpecialExit( "gaffodorf", "go_nuts" );
AddSpecialExit( "geheim1", "go_nuts" );
AddSpecialExit( "geheim2", "go_nuts" );
AddSpecialExit( "geheim3", "go_nuts" );
AddSpecialExit( "geheim4", "go_nuts" );
AddSpecialExit( "geheim5", "go_nuts" );

}
int go_nuts(string dir)
{

  if(!(present("nuts", TO)))
  {
    write( BS( "Da Du nicht Merlin bist, sein Testie, oder Jemand dem "
	       "Merlin erlaubt hat dieses Gebiet zu betreten, hast Du leider "
	       "keine Chance dort hin zu gelangen.") );
    say("Eine unsichtbare Macht haelt "+TP->Name(WEN)+" davon ab, "
      "einen nicht erlaubten Ausgang zu nutzen.\n");
  return -1;
  }
}
