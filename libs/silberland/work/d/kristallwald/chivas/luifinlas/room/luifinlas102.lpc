// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Dorfmitte von Hubbleton");
  SetProp( P_INT_LONG,
	"Du bist im oestlichen Teil des Dorfplatzes. Rings um Dich herum sind "
	"lauter Hobbithoehlen zu sehen. Im Norden und im Osten befinden sich "
	"sogar zwei Hoehlen, die Du betreten koenntest, wenn Du willst. "
	"Ansonsten siehst Du vor den Hoehlen Baenke aufgestellt, auf denen die "
	"Hobbits sitzen und die Sonne geniessen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"teil","dorfplatzes","platz"}),
	    "Du bist im oestlichen Teil des Dorfes Hubbleton. Rings um Dich "
	    "herum sind lauter grasbewachsene Huegel, in denen die hier "
	    "wohnenden Hobbits ihre Hoehlen gebaut haben.");

  AddDetail( ({"dorf","dorfes","hubbleton"}),
	    "Du bist in einem kleinen Dorf. Es heisst Hubbleton und es wird "
	    "von Hobbits bewohnt.");
  
  AddDetail( ({"hobbithoehlen","hoehlen"}),
	    "Die Hobbits wohnen in den Hoehlen. Du kannst welche nach Norden "
	    "und Osten betreten.");

  AddDetail( ({"norden","osten"}), 
            "Im Norden und im Osten sind Hobbithoehlen, die Du betreten "
	    "kannst.");

  AddDetail( ({"baenke"}),
	    "Vor den Hoehlen der Hobbits stehen einige Baenke auf denen "
	    "die Hobbits das gute Wetter geniessen.");

  AddDetail( ({"hobbits"}),
	    "Viele Hobbits wohnen in Hubbleton. Einige sitzen hier vor ihren "
	    "Hoehlen auf Baenken und geniessen die waermende Sonne.");

  AddDetail( ({"boden"}),
	    "Der Boden ist wie auf dem gesamten Platz mit kleinen Steinchen "
	    "bedeckt.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ueber Dir ist blau.");

  AddDetail( ({"wetter"}),
	    "Das Wetter ist hervorragend.");

  AddDetail( ({"sonne"}), 
            "Die Sonne scheint und waermt Dich.");

  AddDetail( ({"steinchen"}),
	    "Die kleinen Steinchen liegen auf dem Boden. Ein Stein faellt Dir "
	    "besonders auf.");

  AddDetail( ({"stein","scherbe"}),
	    "Ein Stein glitzert in der Sonne. Als Du ihn genauer betrachtest "
	    "merkst Du, dass es eine kleine Scherbe ist und nichts "
	    "wertvolles. Du bist ein wenig enttaeuscht.");

  AddDetail( ({"huegel"}),
	    "Die Huegel, in denen die Hobbits ihre Hoehlen haben, sind mit "
	    "Gras bewachsen.");

  AddDetail( ({"gras"}),
	    "Das Gras ist kurz gemaeht und schoen gruen.");
    
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Essen.");  
 
  AddSmell( ({"essen"}),
	   "Bei den Hobbits riecht es immer nach Essen. Sie machen ja nicht "
	   "viel anderes.");

  AddSound(DEFAULT_SOUND, "Du hoerst Stimmen.");

  AddSound( ({"stimmen","hobbits"}),
	   "Du hoerst die Hobbits reden.");
  
//-----Details Ende-----
  
AddExit("nordwesten", ROOM "luifinlas68");
AddExit("suedwesten", ROOM "luifinlas103");
AddExit("westen", ROOM "luifinlas101");
AddExit("norden", ROOM "luifhd14");
AddExit("osten", ROOM "luifhd11");

}

