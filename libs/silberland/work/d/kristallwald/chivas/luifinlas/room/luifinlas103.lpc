// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Dorfmitte von Hubbleton");
  SetProp( P_INT_LONG,
	"Du stehst auf der Suedseite der Dorfmitte des kleinen Dorfes. Nach "
	"Suedosten kannst Du das Dorf verlassen. Nach Sueden kann man eine der "
	"Hobbithoehlen betreten. Im Westen scheint eine kleine Wirtschaft zu "
	"sein und im Osten ein kleiner Laden." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"suedseite","seite"}),
	    "Du stehst auf der Suedseite der Dorfmitte in Hubbleton. Rings um "
	    "Dich herum sind Hobbithoehlen zu sehen.");

  AddDetail( ({"dorfmitte","mitte"}),
	    "Genau in der Dorfmitte steht eine grosse alte Weide. Alle "
	    "Hoehlen des Dorfes muenden auf die Dorfmitte.");
  
  AddDetail( ({"dorfes","dorf","hubbleton"}),
	    "Du bist in Hubbleton. Ein Dorf, welches von Hobbits bewohnt "
	    "wird.");

  AddDetail( ({"suedosten","weg"}), 
            "Ein Weg fuehrt nach Suedosten aus dem Dorf hinaus.");

  AddDetail( ({"sueden"}),
	    "Wenn Du nach Sueden gehst, kannst Du eine der vielen "
	    "Hobbithoehlen betreten.");

  AddDetail( ({"hobbithoehlen","hoehlen","wohnungen","hoehle"}),
	    "Die Hobbits haben Hoehlen in die Huegel gegraben und dort ihre "
	    "Wohnungen gebaut.");

  AddDetail( ({"westen","wirtschaft"}),
	    "Die Hoehle im Westen ist eine kleine Wirtschaft. Ueber dem "
	    "Eingang der Hoehle haengt ein kleines Schild.");
  
  AddDetail( ({"osten","laden","sachen"}),
	    "Im Osten ist der Laden des Dorfes, wo Du Sachen kaufen und "
	    "verkaufen kannst.");

  AddDetail( ({"boden"}),
	    "Der Boden der Dorfmitte ist mit kleinen Steinchen bedeckt.");
  
  AddDetail( ({"himmel","sonne"}),
	    "Der Himmel ueber Dir ist schoen blau und die Sonne steht "
	    "senkrecht am Himmel.");

  AddDetail( ({"weide","norden"}), 
            "Eine grosse alte Weide steht genau in der Mitte des Dorfes. Wenn "
	    "Du weiter nach Norden gehst, stehst Du genau unter ihr.");

  AddDetail( ({"hobbits"}),
	    "Viele Hobbits wohnen hier in Hubbleton.");

  AddDetail( ({"huegel"}),
	    "Die Huegel, in denen die Hobbits ihre Hoehlen haben sind mit "
	    "Gras bewachsen und sehen sehr natuerlich aus.");

  AddDetail( ({"eingang"}),
	    "Ueber dem Eingang der Hoehle im Westen haengt ein kleines "
	    "Schild.");
  
  AddDetail( ({"schild"}),
	    "Du kannst das Schild lesen.");

  AddDetail( ({"steinchen"}),
	    "Viele kleine Steinchen bilden den Boden der Dorfmitte.");
  
  AddDetail( ({"gras"}),
	    "Gruenes Gras waechst auf den Huegeln, in denen die Hobbits ihre "
	    "Hoehlen gebaut haben.");

  AddDetail( ({""}), 
            "");

  AddReadDetail( ({"schild"}),
	    "+--------------------------------------+\n"
	    "|                                      |\n"
	    "|             Wirtschaft               |\n"
	    "|                                      |\n"
	    "|         'Zum lustigen Hobbit'        |\n"
	    "|                                      |\n"
	    "+--------------------------------------+\n");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach leckeren Essen.");  
 
  AddSmell( ({"essen","geruch"}),
	   "Der Geruch kommt aus der Wirtschaft im Westen.");

  AddSound(DEFAULT_SOUND, "Du hoerst Lachen und Reden.");

  AddSound( ({"lachen","reden"}),
	   "Die Hobbits lachen viel und natuerlich reden hier in der "
	   "Dorfmitte auch einige miteinander.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas101");
AddExit("nordwesten", ROOM "luifinlas100");
AddExit("nordosten", ROOM "luifinlas102");
AddExit("westen", ROOM "luifhd9");
AddExit("osten", ROOM "luifhd10");
AddExit("sueden", ROOM "luifhd8");
AddExit("suedosten", ROOM "luifhd7");
}

