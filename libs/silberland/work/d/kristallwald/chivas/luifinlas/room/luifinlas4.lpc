// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Weg auf dem Du Dich befindest, fuehrt Dich nach Nordwesten oder "
	"Suedosten. Im Suedosten scheint sich der Weg zu gabeln. Die Baeume "
	"stehen dicht am Rand des Weges und ein paar Buesche sind zu erkennen. "
	"Das dichte Blaetterdach laesst kaum einen Lichtstrahl auf den Boden "
	"treffen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"weg","weges"}),
	    "Der Weg fuehrt von Nordwesten nach Suedosten.");

  AddDetail( ({"nordwesten"}),
	    "Im Nordosten ist noch mehr Wald zu sehen.");
  
  AddDetail( ({"suedosten"}),
	    "Im Suedosten ist eine Kreuzung zu sehen.");

  AddDetail( ({"baeume","baeumen"}), 
            "Die Baeume stehen dicht am Wegrand.");

  AddDetail( ({"rand","wegrand"}),
	    "Am Wegrand sieht man Baeume und Buesche.");

  AddDetail( ({"buesche"}),
	    "Die Buesche zwaengen sich an den Baeumen vorbei an den Weg.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach ueber Dir ist sehr dicht.");
  
  AddDetail( ({"lichtstrahl"}),
	    "Es trifft fast kein Lichtstrahl auf den Boden.");

  AddDetail( ({"boden","steinchen"}),
	    "Am Boden sind lauter kleine Steinchen zu sehen.");
  
  AddDetail( ({"himmel"}),
	    "Den Himmel kannst Du hier nicht sehen.");

  AddDetail( ({"wald"}), 
            "Du bist mitten im Wald.");

  AddDetail( ({"kreuzung"}),
	    "Eine Kreuzung ist im Suedosten zu sehen.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht waldig.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel ueber Dir.");

  AddSound( ({"voegel"}),
	   "*zwitscher*");
  
//-----Details Ende-----
  
AddExit("nordwesten", ROOM "luifinlas3");
AddExit("suedosten", ROOM "luifinlas5");

}

