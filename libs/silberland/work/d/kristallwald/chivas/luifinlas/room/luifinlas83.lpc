// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Strasse von Luifinlas");
  SetProp( P_INT_LONG,
	"Die Strasse, in der Du Dich befindest fuehrt weiter nach Nordwesten.  "
	"Hier gibt nur zwei groessere Gebaeude zwischen den kleinen Haeusern. "
	"Das Haus im Norden ist die Stadtwache von Luifinlas. Im Westen steht "
	"das Gefaengnis der Stadt, wie Du an den Gittern an den Fenstern "
	"erkennen kannst." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"strasse","nordwesten","suedosten"}),
	    "Die Strasse auf der Du stehst fuehrt nach Nordwesten oder "
	    "Suedosten. Sie ist gepflastert und besteht aus grossen Steinen.");

  AddDetail( ({"steine","steinen","boden","pflastersteine"}),
	    "grosse Pflastersteine bilden die Strasse. Zwischen ihnen waechst "
	    "ein wenig Gras.");
  
  AddDetail( ({"gebaeude","gebaeuden"}),
	    "Die grossen Gebaeude sind die Stadtwache und das Gefaengnis.");

  AddDetail( ({"haus","norden","stadtwache"}), 
            "Das Haus im Norden ist die Stadtwache von Luifinlas. Neben dem "
	    " Eingang haengen mehrere Zettel an der Wand.");

  AddDetail( ({"luifinlas","stadt"}),
	    "Luifinlas heisst die Stadt, in der Du Dich befindest. Das "
	    "solltest Du eigentlich langsam wissen.");

  AddDetail( ({"haeusern","haeuser","geld","einwohner","wohnhaeuser"}),
	    "Einige kleinere Wohnhaeuser stehen neben den grossen Gebaeuden. "
	    "Sie sind nicht sehr schoen und anscheinend wohnen dort ein paar "
	    "aermere Einwohner. Wer will auch schon neben einem Gefaengnis "
	    "wohnen, wenn er genuegend Geld besitzt.");

  AddDetail( ({"westen","gefaengnis","gefaengnisses"}),
	    "Im Westen steht das Gefaengnis der Stadt. Ein grosses Eisentor "
	    "ist zu sehen und die vergitterten Fenster wirken auch nicht sehr "
	    "einladend auf Dich.");
  
  AddDetail( ({"gitter","gittern","gitterstaebe"}),
	    "Die Gitter sind vor den Fenstern angebracht, damit keiner einfach "
	    "so entkommen kann.");

  AddDetail( ({"fenster","fenstern"}),
	    "Vor den Fenstern sind dicke Gitter angebracht. Sie sehen nicht "
	    "sehr einladend aus.");
  
  AddDetail( ({"gras"}),
	    "Das Gras ist ein wenig platt getreten von den Leuten, die hier "
	    "herumlaufen.");

  AddDetail( ({"himmel"}), 
            "Der Himmel ist blau.");

  AddDetail( ({"leuten","leute"}),
	    "Es sind hauptsaechlich die Wachen der Stadt und vielleicht das "
	    "Gesindel, was sich weiter im Nordwesten herum treibt.");

  AddDetail( ({"wachen"}),
	    "Die Wachen arbeiten fuer die Stadtwache.");

  AddDetail( ({"gesindel"}),
	    "Im Nordwesten ist ein wohl nicht so gutes Viertel.");
  
  AddDetail( ({"viertel","urteil"}),
	    "Es gibt gute und suboptimale Viertel in Luifinlas. Ein Urteil "
	    "musst Du Dir selber machen.");

  AddDetail( ({"wand"}),
	    "An der Wand neben dem Eingang zur Stadtwache siehst Du lauter "
	    "Zettel haengen.");
  
  AddDetail( ({"zettel"}),
	    "Di Zettel sind Steckbriefe, die hier ausgehaengt werden.");

  AddDetail( ({"eingang"}), 
            "Neben dem Eingang der Stadtwache haengen unzaehlige Zettel "
	    "an der Wand.");

  AddDetail( ({"eisentor","tor","frage"}),
	    "Das Tor ist offen und Du koenntest ins Gefaengnis gehen. Die "
	    "Frage ist, ob Du auch wieder gehen darfst.");

  AddDetail( ({"steckbriefe"}),
	    "Es haengen viele Steckbriefe an der Wand. Zehn Steckbriefe "
	    "scheinen recht neu zu sein, da sie noch nicht ausgeblichen sind. "
	    "Du kannst sie Dir sicher mit 'lies steckbrief x' genauer "
	    "ansehen.");

  AddReadDetail( ({"steckbrief"}),
	    "Welchen Steckbrief willst Du denn genau lesen?");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({""}), 
            "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");

  AddReadDetail( ({"steckbrief 1"}),
	    "+---------------------------------------------+\n"
	    "|                   Steckbrief                |\n"
	    "|                                             |\n"
	    "|  Name: Elrohir                              |\n"
	    "|  Rasse: Dunkelelf                           |\n"
	    "|  Groesse: gross                             |\n"
	    "|  Haarfarbe: weiss                           |\n"
	    "|  Augenfarbe: dunkel                         |\n"
	    "|                                             |\n"
	    "|  Verbrechen:                                |\n"
	    "|  Dem Gesuchten wird zur Last gelegt mehrere |\n"
	    "|  Auftragsmorde im Namen der Assassinen-     |\n"
	    "|  Gilde durchgefuehrt zu haben.              |\n"
	    "|                                             |\n"
	    "|  Belohnung: 10000 Muenzen                   |\n"
	    "|  Uebergabe: Besser tot als lebendig.        |\n"
	    "+---------------------------------------------+");

  AddReadDetail( ({"steckbrief 2"}),
	    "+---------------------------------------------+\n"
	    "|                   Steckbrief                |\n"
	    "|                                             |\n"
	    "|  Name: Woody                                |\n"
	    "|  Rasse: Mudgott                             |\n"
	    "|  Groesse: unbeschreiblich                   |\n"
	    "|  Haarfarbe: goettlich                       |\n"
	    "|  Augenfarbe: wow                            |\n"
	    "|                                             |\n"
	    "|  Verbrechen:                                |\n"
	    "|  Obwohl er alles erschaffen hat, stahl er   |\n"
	    "|  einer armen Frau der Stadt ein Huhn und    |\n"
	    "|  verschlang es vor ihren Augen ohne zu .    |\n"
	    "|  bezahlen. Er soll sich schaemen.           |\n"
	    "|                                             |\n"
	    "|  Belohnung: 5 Muenzen                       |\n"
	    "|  Uebergabe: Bittet Ihn einfach mitzukommen. |\n"
	    "+---------------------------------------------+");

  AddReadDetail( ({"steckbrief 3"}),
	    "+---------------------------------------------+\n"
	    "|                   Steckbrief                |\n"
	    "|                                             |\n"
	    "|  Name: Arnold                               |\n"
	    "|  Rasse: Troll                               |\n"
	    "|  Groesse: gross                             |\n"
	    "|  Haarfarbe: schwarzgruen                    |\n"
	    "|  Augenfarbe: dunkelgrau                     |\n"
	    "|                                             |\n"
	    "|  Verbrechen:                                |\n"
	    "|  Dem Gesuchten wird zur Last gelegt mehrere |\n"
	    "|  Diebstaehle im Auftrag der Diebes-         |\n"
	    "|  Gilde durchgefuehrt zu haben.              |\n"
	    "|                                             |\n"
	    "|  Belohnung: 5000 Muenzen                    |\n"
	    "|  Uebergabe: Besser tot als lebendig.        |\n"
	    "+---------------------------------------------+");

  AddReadDetail( ({"steckbrief 4"}),
	    "+---------------------------------------------+\n"
	    "|                   Steckbrief                |\n"
	    "|                                             |\n"
	    "|  Name: Balthasar                            |\n"
	    "|  Rasse: Hobbit                              |\n"
	    "|  Groesse: mittelgross                       |\n"
	    "|  Haarfarbe: hellbraun                       |\n"
	    "|  Augenfarbe: mittelbraun                    |\n"
	    "|                                             |\n"
	    "|  Verbrechen:                                |\n"
	    "|  Dem Gesuchten wird zur Last gelegt einige  |\n"
	    "|  Haendler erpresst zu haben  .              |\n"
	    "|                                             |\n"
	    "|  Belohnung: 8000 Muenzen                    |\n"
	    "|  Uebergabe: Besser tot als lebendig.        |\n"
	    "+---------------------------------------------+");

  AddReadDetail( ({"steckbrief 5"}),
	    "+---------------------------------------------+\n"
	    "|                   Steckbrief                |\n"
	    "|                                             |\n"
	    "|  Name: Heinzel                              |\n"
	    "|  Rasse: Zwerg                               |\n"
	    "|  Groesse: klein                             |\n"
	    "|  Haarfarbe:  schiefergrau                   |\n"
	    "|  Augenfarbe: grau                           |\n"
	    "|                                             |\n"
	    "|  Verbrechen:                                |\n"
	    "|  Dem Gesuchten wird zur Last gelegt einigen |\n"
	    "|  Maennern in Luifinlas Hoerner aufgesetzt   |\n"
	    "|  zu haben.                                  |\n"
	    "|                                             |\n"
	    "|  Belohnung: 20000 Muenzen                   |\n"
	    "|  Uebergabe: Der Wache tot, den Frauen       |\n"
	    "|  lebend.                                    |\n"
	    "+---------------------------------------------+");

  AddReadDetail( ({"steckbrief 6"}),
	    "+---------------------------------------------+\n"
	    "|                   Steckbrief                |\n"
	    "|                                             |\n"
	    "|  Name: Laris                                |\n"
	    "|  Rasse: Mensch (NPC)                        |\n"
	    "|  Groesse: mittelgross                       |\n"
	    "|  Haarfarbe: blond                           |\n"
	    "|  Augenfarbe: blau                           |\n"
	    "|                                             |\n"
	    "|  Verbrechen:                                |\n"
	    "|  Der Gesuchten wird zur Last gelegt mehrere |\n"
	    "|  Betruegereien in Luifinlas begangen zu     |\n"
            "|  haben.	                                   |\n"
	    "|                                             |\n"
	    "|  Belohnung: 100 Muenzen                     |\n"
	    "|  Uebergabe: Besser tot als lebendig.        |\n"
	    "+---------------------------------------------+");

  AddReadDetail( ({"steckbrief 7"}),
	    "+---------------------------------------------+\n"
	    "|                   Steckbrief                |\n"
	    "|                                             |\n"
	    "|  Name: Justavius                            |\n"
	    "|  Rasse: Mensch                              |\n"
	    "|  Groesse: gross                             |\n"
	    "|  Haarfarbe: hellblond                       |\n"
	    "|  Augenfarbe: braun                          |\n"
	    "|                                             |\n"
	    "|  Verbrechen:                                |\n"
	    "|  Dem Gesuchten wird zur Last gelegt nicht   |\n"
	    "|  immer Zeit zu haben, um Chivas sein Testie |\n"
	    "|  zu sein.                                   |\n"
	    "|                                             |\n"
	    "|  Belohnung: 10 Muenzen                      |\n"
	    "|  Uebergabe: Besser tot als lebendig.        |\n"
	    "+---------------------------------------------+");

  AddReadDetail( ({"steckbrief 8"}),
	    "+---------------------------------------------+\n"
	    "|                   Steckbrief                |\n"
	    "|                                             |\n"
	    "|  Name: Angrox                               |\n"
	    "|  Rasse: Zwerg                               |\n"
	    "|  Groesse: winzig                            |\n"
	    "|  Haarfarbe: kanalgitterblau                 |\n"
