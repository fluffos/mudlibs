  AddReadDetail( ({"steckbrief 9"}),
	    "+---------------------------------------------+\n"
	    "|                   Steckbrief                |\n"
	    "|                                             |\n"
	    "|  Name: Lusignan                             |\n"
	    "|  Rasse: Dunkelelf                           |\n"
	    "|  Groesse: gross                             |\n"
	    "|  Haarfarbe: weiss                           |\n"
	    "|  Augenfarbe: dunkel                         |\n"
	    "|                                             |\n"
	    "|  Verbrechen:                                |\n"
	    "|  Dem Gesuchten wird zur Last gelegt mehrere |\n"
	    "|  Auftragsmorde im Namen der Assassinen-     |\n"
