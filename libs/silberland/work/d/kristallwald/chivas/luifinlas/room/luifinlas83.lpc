	    "+---------------------------------------------+");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Gefaengnis.");  
 
  AddSmell( ({"gefaengnis","freiheit"}),
	   "Das Gefaengnis riecht nicht nach Freiheit.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Heulen.");

  AddSound( ({"heulen"}),
	   "Das Heulen dringt durch die Gitterstaebe des Gefaengnisses auf "
	   "die Strasse.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifwache");
AddExit("westen", ROOM "luifknast");
AddExit("suedosten", ROOM "luifinlas72");
AddExit("nordwesten", ROOM "luifinlas110");

}
