	    "|                                             |\n"
	    "|  Belohnung: 10000 Muenzen                   |\n"
	    "|  Uebergabe: Besser tot als lebendig.        |\n"
	    "+---------------------------------------------+");

  AddReadDetail( ({"steckbrief 10"}),
	    "+---------------------------------------------+\n"
	    "|                   Steckbrief                |\n"
	    "|                                             |\n"
	    "|  Name: Hier koennte Dein Name stehen        |\n"
	    "|  Rasse:                                     |\n"
	    "|  Groesse:                                   |\n"
	    "|  Haarfarbe:                                 |\n"
	    "|  Augenfarbe:                                |\n"
	    "|                                             |\n"
	    "|  Verbrechen:                                |\n"
	    "|                                             |\n"
	    "|                                             |\n"
	    "|  Belohnung: 10000 Muenzen                   |\n"
