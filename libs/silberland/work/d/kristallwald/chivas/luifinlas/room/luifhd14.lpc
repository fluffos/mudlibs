// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hobbithoehle");
  SetProp( P_INT_LONG,
	"Dies ist definitiv eine weibliche Hobbithoehle. Ueberall ist Pluesch "
	"zu sehen. Das Bett ist mit einer rosa Decke bedeckt und die "
	"Tischdecke auf dem Tisch hat Spitzen. Es kann kein maennlicher "
	"Hobbit hier wohnen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"hobbithoehle","hoehle"}),
	    "Es ist ganz klar, dass hier ein weiblicher Hobbit wohnt.");

  AddDetail( ({"pluesch","stellen"}),
	    "Das Pluesch an allen Stellen ist schon beaengstigend.");
  
  AddDetail( ({"bett"}),
	    "Das Bett an einer Wand hat sogar eine rosa Decke.");

  AddDetail( ({"decke","blumenmuster","muster"}), 
            "Die Decke auf dem Bett ist rosa und hat ein Blumenmuster.");

  AddDetail( ({"tischdecke"}),
	    "Die weisse Tischdecke hat ganz viel Spitze.");

  AddDetail( ({"tisch"}),
	    "Der Tisch hat eine Tischdecke und eine Vase mit Blumen steht "
	    "darauf.");

  AddDetail( ({"spitzen","spitze"}),
	    "Die Spitze wurde anscheinend noch zusaetzlich dran gehaekelt.");
  
  AddDetail( ({"hobbit"}),
	    "Kein maennlicher Hobbit wuerde sich sowas antun.");

  AddDetail( ({"boden"}),
	    "An Boden ist ein rosa Teppich zu sehen.");
  
  AddDetail( ({"wand","waenden","waende"}),
	    "An der Wand steht ein Bett, ein Schrank und die runden Fenster "
	    "sind zu sehen.");

  AddDetail( ({"vase"}), 
            "selbst die Vase auf dem Tisch ist rosa.");

  AddDetail( ({"blumen"}),
	    "Die Blumen wurde wohl gerade erst in die Vase gestellt. Sie "
	    "wirken frisch und sie sind Woody sei Dank nicht rosa.");

  AddDetail( ({"teppich"}),
	    "Der Teppich ist natuerlich rosa und sehr weich.");

  AddDetail( ({"schrank"}),
	    "Der Schrank ist geschlossen und natuerlich rosa. Ausserdem siehst "
	    "zarte Verzierungen am Schrank.");
  
  AddDetail( ({"fenster","fenstern","gardinen"}),
	    "Vor den kleinen runden Fenstern haengen gehaekelte Gardinen.");

  AddDetail( ({"woody","mudgott","gott"}),
	    "Woody ist unser Mudgott.");
  
  AddDetail( ({"dank"}),
	    "Man sollte viel haeufiger Woody danken.");

  AddDetail( ({"verzierungen","feen"}), 
            "Die Verzierungen zeigen kleine Feen. Wirklich suess und Dir wird "
	    "leicht schlecht.");

  AddDetail( ({"standuhr","ecke","anblick"}),
	    "In der Ecke steht eine grosse Standuhr. Die schoene Standuhr "
	    "wurde total verschandelt und rosa angemalt. Du erschauerst bei "
	    "diesem Anblick.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst Parfuem.");  
 
  AddSmell( ({"parfuem"}),
	   "Die ganze Hoehle wurde einparfuemiert.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Ticken.");

  AddSound( ({"ticken"}),
	   "Das Ticken kommt von einer Standuhr in der Ecke.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "luifinlas102");


}
