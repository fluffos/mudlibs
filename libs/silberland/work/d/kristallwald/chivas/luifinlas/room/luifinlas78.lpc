// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Strasse in Luifinlas");
  SetProp( P_INT_LONG,
	"Die Strasse muendet im Nordwesten auf dem grossen Platz der Stadt. "
	"Im Suedosten verlaeuft die Strasse weiter an allen moeglichen "
	"Haeusern und Geschaeften vorbei. Die Strassen sind sehr belebt und "
	"Du siehst fast alle Rassen des Silberlandes in Luifinlas." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"strasse","strassen"}),
	    "Die Strasse verlaeuft von Nordwesten nach Suedosten. Links und "
	    "rechts der Strasse sind viele Haeuser und Geschaefte zu sehen.");

  AddDetail( ({"nordwesten","platz"}),
	    "Im Nordwesten ist der grosse Platz von Luifinlas.");
  
  AddDetail( ({"stadt","luifinlas"}),
	    "Du bist in einer Stadt, die Luifinlas heisst.");

  AddDetail( ({"suedosten"}), 
            "Im Suedosten geht es an Haeusern und Geschaeften vorbei.");

  AddDetail( ({"haeusern","haeuser","besitzer","besitzern","schuss"}),
	    "Die Haeuser sehen tadellos aus. Sie werden von ihren Besitzern "
	    "gut in Schuss gehalten.");

  AddDetail( ({"geschaefte","geschaeften"}),
	    "Viele kleinere Geschaefte sind zu sehen, aber keins davon "
	    "interessiert Dich wirklich, oder bist Du an Reizwaesche "
	    "interessiert.");

  AddDetail( ({"rassen","oger","feen","trolle","orks","zwerge","zentauren","elfen"}),
	    "Du siehst Oger, Orks, Feen, Trolle, Elfen, Zwerge, Zentauren und "
	    "noch viele mehr, die hier ihren Geschaeften nachgehen.");
  
  AddDetail( ({"silberland","silberlandes"}),
	    "Du bist im Silberland.");

  AddDetail( ({"boden"}),
	    "Die Strasse ist mit grossen Steinen gepflastert.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ueber Dir ist blau.");

  AddDetail( ({"reizwaesche","wort","gesicht"}), 
            "Schon bei dem Wort, wirst Du rot im Gesicht.");

  AddDetail( ({"steine","steinen"}),
	    "Zwischen den Steinen waechst ein wenig Gras.");

  AddDetail( ({"gras","chance"}),
	    "Das Gras hat auf einer so belebten Strasse keine grosse Chance "
	    "sich auszubreiten und zu wachsen.");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es liegen alle moeglichen Duefte der Stadt in der "
		          "Luft.");  
 
  AddSmell( ({"luft","duefte","stadt"}),
	   "Du kannst die Duefte in der Luft kaum voneinander unterscheiden.");

  AddSound(DEFAULT_SOUND, "Du hoerst Feilschen, Gerede, Lachen und vieles "
		          "mehr.");

  AddSound( ({"feilschen","gerede","lachen","sache"}),
	   "Du hoerst zu viel um Dich auf eine Sache zu konzentrieren.");
  
//-----Details Ende-----
  
AddExit("nordwesten", ROOM "luifinlas15");
AddExit("suedosten", ROOM "luifinlas74");


}
