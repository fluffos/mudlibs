// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Strasse von Luifinlas");
  SetProp( P_INT_LONG,
	"Viele Haeuser unterschiedlichster Form stehen am Strassenrand. Vor "
	"ein paar Haeuser wurden Tische und Baenke gestellt, wo die Einwohner "
        "sich anscheinend hingesetzt haben und den Tag in der Sonne "
	"geniessen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"haeuser","form","formen","strassenrand","haeusern"}),
	    "Die Haeuser haben alle unterschiedliche Formen. Dies liegt sicher "
	    "daran, dass hier auch viele unterschiedliche Rassen in Luifinlas "
	    "wohnen.");

  AddDetail( ({"tische","baenke","tischen","baenken"}),
	    "An den Tischen sitzen die Einwohner vor den Haeusern auf Baenken "
	    "und geniessen den wunderschoenen Tag.");
  
  AddDetail( ({"tag"}),
	    "Es ist ein herrlicher Tag.");

  AddDetail( ({"luifinlas","stadt"}), 
            "Du bist in Luifinlas.");

  AddDetail( ({"boden","strasse"}),
	    "Die Strasse auf der Du stehst ist gepflastert.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen blau.");
  
  AddDetail( ({"rassen"}),
	    "In Luifinlas leben fast alle Rassen.");

  AddDetail( ({"einwohner"}),
	    "Luifinlas hat sehr viele Einwohner. Es ist eine grosse Stadt.");
  
  AddDetail( ({"sonne"}),
	    "Die Sonne scheint oben am Himmel.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach nichts besonderem.");  
 
  AddSound(DEFAULT_SOUND, "Du hast Dich an den Krach der Stadt schon "
		  "gewoehnt.");

  AddSound( ({"krach","stadt"}),
	   "Du hoerst den Krach eigentlich gar nicht mehr.");
  
//-----Details Ende-----
  
AddExit("suedwesten", ROOM "luifinlas80");
AddExit("nordosten", ROOM "luifinlas15");


}
