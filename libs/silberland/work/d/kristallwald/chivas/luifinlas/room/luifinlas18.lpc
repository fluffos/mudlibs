// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Strasse in Luifinlas");
  SetProp( P_INT_LONG,
	"Im Osten kannst Du das grosse Osttor von Luifinlas sehen, dass Dich "
	"aus der Stadt heraus bringen wuerde. In Richtung Westen wirst Du "
	"sicher die Stadtmitte erreichen. Im Norden scheint einer der "
	"zahlreichen Tempel der Stadt zu sein und im Sueden scheinen die "
	"kleinen Kinder der Stadt zur Schule gehen zu muessen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"osten","osttor"}),
	    "Die Strasse fuehrt nach Osten auf das Osttor von Luifinlas zu.");

  AddDetail( ({"stadt"}),
	    "Du bist in einer grossen Stadt.");

  AddDetail( ({"richtung"}), 
            "Du kannst nach Osten und Westen weiter auf der Strasse gehen.");

  AddDetail( ({"westen","stadtmitte"}),
	    "Nach Westen gehend erreichst Du sicher die Stadtmitte.");

  AddDetail( ({"norden","tempel"}),
	    "Im Norden ist einer der vielen Tempel der Stadt.");

  AddDetail( ({"sueden","schule","kinder"}),
	    "Im Sueden muessen die kleinen Kinder zur Schule gehen.");
  
  AddDetail( ({"boden"}),
	    "Der Boden der Strasse ist mit Steinen gepflastert.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau.");
  
  AddDetail( ({"luifinlas"}),
	    "Du bist in Luifinlas.");

  AddDetail( ({"strasse"}), 
            "Du bist auf einer Strasse.");

  AddDetail( ({"steine","steinen"}),
	    "Die Steine bilden eine gute Strasse. Auf ihnen laesst es sich "
	    "sehr gut gehen.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht hier nach viel.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Kinder.");

  AddSound( ({"kinder"}),
	   "Die Kinder gehoeren sicher zu der Schule im Sueden.");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "luifinlas17");
AddExit("osten", ROOM "luifinlas19");
AddExit("norden", ROOM "luiftem4");
AddExit("sueden", ROOM "luifschule");


}
