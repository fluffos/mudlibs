// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Mitte von Hubbleton");
  SetProp( P_INT_LONG,
	"Du bist in der Dorfmitte von Hubbleton. Rings herum sind lauter "
	"Grashuegel zu sehen, in denen die Hobbits ihre Hoehlen haben. Hier in "
	"der Mitte steht eine grosse alte Weide, deren Zweige und Blaetter "
	"angenehmen Schatten spenden. Eine grosse Bank steht direkt unter der "
	"Weide, wo man ausruhen und dem Treiben im Dorf zusehen kann." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"dorfmitte","mitte"}),
	    "Du bist in der Mitte des Dorfes Hubbleton.");

  AddDetail( ({"grashuegel","huegel"}),
	    "In den Grashuegeln sind die Hoehlen der Hobbits. Rings um die "
	    "Dorfmitte sind lauter Huegel. Ein paar kannst Du auch betreten.");

  AddDetail( ({"gras"}), 
            "Die Huegel sind mit Gras bewachsen.");

  AddDetail( ({"dorf","dorfes"}),
	    "Du bist in dem Dorf Hubbleton.");

  AddDetail( ({"hobbits"}),
	    "Viele Hobbits leben in Hubbleton.");

  AddDetail( ({"hoehlen"}),
	    "In den Hoehlen leben die Hobbits.");
  
  AddDetail( ({"weide"}),
	    "Eine grosse alte Weide steht in der Dorfmitte. Ihr Stamm ist "
	    "mehrere Meter dick und eine kleine Bank steht neben ihr. Die "
	    "Zweige und Blaetter der Weide spenden angenehmen Schatten.");

  AddDetail( ({"zweige"}),
	    "Die Zweige der Weide haengen tief herunter.");
  
  AddDetail( ({"blaetter"}),
	    "Die Blaetter der Weide haengen an den Zweigen tief herunter.");

  AddDetail( ({"schatten"}), 
            "Der Schatten, den die Weide spendet, ist sehr angenehm.");

  AddDetail( ({"bank","tag"}),
	    "Auf der Bank sitzen einige Einwohner des Dorfes und geniessen "
	    "den Tag.");

  AddDetail( ({"treiben"}),
	    "Es herrscht ein ruhiges Treiben. Die Hobbits lassen sich nicht "
	    "verrueckt machen.");

  AddDetail( ({"boden","steinchen","fall"}),
	    "Der Boden ist mit kleinen Steinchen bedeckt, wie es im ganzen "
	    "Dorf der Fall ist.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist hier nur ein bisschen zu sehen, da die Zweige und "
	    "Blaetter der Weide sehr dicht sind.");

  AddDetail( ({"hubbleton"}),
	    "Du bist in Hubbleton, dem Dorf der Hobbits.");
  
  AddDetail( ({"stamm","meter"}),
	    "Der Stamm ist mehere Meter dick. Ein kleines Schild haengt am "
	    "Stamm der Weide.");

  AddDetail( ({"einwohner"}), 
            "Die Einwohner des Dorfes sitzen auf der Bank und geniessen den "
	    "Tag. Sie albern mitteinander rum und sie scheinen sich sehr wohl "
	    "zu fuehlen.");

  AddDetail( ({"schild"}),
	    "Du kannst das kleine Schild lesen.");

  AddDetail( ({""}),
	    "");

  AddReadDetail( ({"schild"}),
	    "+-------------------------------+\n"
	    "|       Justavius-Eiche         |\n"
	    "|                               |\n"
	    "| Diese wunderschoene Weide ist |\n"
	    "| Justavius gewidmet, der immer |\n"
	    "| wieder meine neuen Gebiete    |\n"
	    "| testen muss. Vielen Dank von  |\n"
	    "| meiner Seite.                 |\n"
	    "|                               |\n"
	    "|                       Chivas  |\n"
	    "+-------------------------------+\n");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach allen moeglichen Dingen.");  
 
  AddSmell( ({"dinge","dingen"}),
	   "Die Dinge, die alle zu riechen sind, kann man hier nicht alle "
	   "aufzaehlen.");

  AddSound(DEFAULT_SOUND, "Du hoerst Lachen und die Einwohner miteinander "
		          "reden");

  AddSound( ({"lachen"}),
	   "Das Lachen stammt von den Hobbits, die auf der Bank sitzen.");
  
  AddSound( ({"einwohner"}),
	   "Die Einwohner reden miteinander.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas68");
AddExit("sueden", ROOM "luifinlas103");
AddExit("osten", ROOM "luifinlas102");
AddExit("westen", ROOM "luifinlas100");
}

