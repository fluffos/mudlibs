// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Weg");
  SetProp( P_INT_LONG,
	"Der steinige Weg geht hier unter der grossen und maechtigen "
	"Stadtmauer von Luifinlas in eine gepflasterte Strasse ueber. Die "
	"Stadtmauer ist sehr hoch, so dass ein Eindringen in die Stadt kaum "
	"moeglich ist, wenn das Tor verschlossen ist. Hier genau im Durchgang "
	"wirkt die Stadtmauer noch breiter und groesser als davor." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"weg"}),
	    "Der Weg fuehrt aus der Stadt nach Nordosten heraus und ueber eine "
	    "Wiese. Hier im Durchgang geht der Weg in eine gepflasterte "
	    "Strasse ueber.");

  AddDetail( ({"stadtmauer","mauer"}),
	    "Die Stadtmauer ist wirklich beeindruckend. Hier im Durchgang "
	    "siehst Du wie dick sie ist. Sie besteht aus grossen "
	    "Steinquadern.");
  
  AddDetail( ({"luifinlas","stadt"}),
	    "Du stehst am Westtor von Luifinlas.");

  AddDetail( ({"strasse"}), 
            "Eine Strasse beginnt hier und fuehrt in die Stadt hinein.");

  AddDetail( ({"eindringen"}),
	    "Das Eindringen in die Stadt ist bei der grossen Stadtmauer sicher "
	    "schwer, wenn man nicht bemerkt werden will.");

  AddDetail( ({"tor","stadttor","westtor"}),
	    "Du bist am Westtor von Luifinlas. Es ist geoeffnet und Du kannst "
	    "die Stadt betreten oder verlassen.");

  AddDetail( ({"durchgang"}),
	    "Du stehst mitten im Durchgang der Stadtmauer, wo das geoeffnete "
	    "grosse Holztor zu sehen ist.");
  
  AddDetail( ({"boden","steinchen"}),
	    "Am Boden geht der Weg aus kleinen Steinchen in eine gepflasterte "
	    "Strasse ueber.");

  AddDetail( ({"himmel"}),
	    "Den Himmel kannst Du hier im Durchgang nicht sehen.");
  
  AddDetail( ({"nordosten","wiese","gras"}),
	    "Der Weg fuehrt ueber eine Wiese mit viel Gras nach Nordosten.");

  AddDetail( ({"steinquadern","steinquader","quader","stein"}), 
            "Die maechtigen Steinquader bilden eine sehr grosse und stabile "
	    "Mauer.");

  AddDetail( ({"holztor"}),
	    "Das Holztor besteht aus dicken Eichenbohlen und ist mit Eisen "
	    "beschlagen.");

  AddDetail( ({"eichenbohlen","bohlen"}),
	    "Die Bohlen sind sehr stabil und halten einiges aus.");

  AddDetail( ({"eisen"}),
	    "Das Eisen verstaerkt das Holztor zusaetzlich.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst die Gerueche der Stadt.");  
 
  AddSmell( ({"gerueche","stadt","sachen"}),
	   "Du riechst hunderte Sachen, aber nichts spezielles.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Laerm der Stadt.");

  AddSound( ({"laerm","stadt"}),
	   "Betritt die Stadt und hoer es Dir genauer an.");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "luifinlas9");
AddExit("osten", ROOM "luifinlas11");

}

