// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Platz von Luifinlas");
  SetProp( P_INT_LONG,
	"Du stehst auf dem Platz von Luifinlas. Direkt in der Mitte ragt ein "
	"grosses Denkmal in den Himmel. Ringsherum herrscht ein munteres "
	"Treiben. Man sieht einige Verkaufsstaende, wo Waren angeboten werden "
	"und an der einen Seite des Denkmals haben sich ein paar Musikanten "
	"niedergelassen, die fuer die Leute auf dem Platz spielen und hoffen "
	"ein paar Muenzen zu bekommen. Lauter Strassen gehen von dem Platz in "
	"alle Richtungen ab." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"platz","platzes"}),
	    "Der grosse Platz von Luifinlas wird von einem grossen Denkmal "
	    "ueberschattet, um das herum sich einige Haendler mit ihren "
	    "Staenden niedergelassen haben und ihre Waren hier anbieten.");

  AddDetail( ({"luifinlas","stadt","stadtmitte"}),
	    "Du bist in der Stadt Luifinlas. Du befindest Dich genau in der "
	    "Stadtmitte.");
  
  AddDetail( ({"mitte"}),
	    "In der Mitte des Platzes steht ein grosses Denkmal.");

  AddDetail( ({"denkmal","denkmals"}), 
            "Das Denkmal ist sehr gross. Es zeigt einen stattlichen Mann, der "
	    "die Arme weit ausbreitet, als ob er jeden willkommen heisst. "
	    "Eine gold schimmernde Plakette haengt am unteren Ende des "
	    "Denkmals.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ueber dem Platz ist schoen blau.");

  AddDetail( ({"treiben"}),
	    "Es herrscht reges Treiben.");

  AddDetail( ({"verkaufsstaende","staende","staenden","haendler","verkaufsstaenden"}),
	    "An den Verkaufsstaenden auf dem Platz gibt es alle moeglichen "
	    "Waren aus dem ganzen Silberland zu sehen. Du siehst, dass hier "
	    "Haendler aus Tijara, Roch Adan, Ardhmir, Felonia, Midas und noch "
	    "aus vielen anderen Teilen anwesend sind und ihre Waren feil "
	    "bieten.");
  
  AddDetail( ({"waren"}),
	    "Alle moeglichen Waren, aus allen Teilen des Silberlandes werden "
	    "hier angeboten.");

  AddDetail( ({"seite"}),
	    "An einer Seite des Denkmals haben sich ein paar Musikanten "
	    "niedergelassen.");
  
  AddDetail( ({"musikanten","instrumente","instrumenten","lieder"}),
	    "Die Musikanten spielen auf ihren Instrumenten einige lustige und "
	    "teilweise frivole Lieder.");

  AddDetail( ({"leute","passanten"}), 
            "Viele Leute sind hier auf dem Platz.");

  AddDetail( ({"muenzen"}),
	    "Die Musikanten hoffen ein paar Muenzen von den Passanten zu "
	    "bekommen.");

  AddDetail( ({"strassen"}),
	    "Viele Strassen gehen von dem Platz ab.");

  AddDetail( ({"richtungen","richtung"}),
	    "Du kannst in jede Richtung gehen.");
  
  AddDetail( ({"boden","pflastersteinen","pflastersteine"}),
	    "Der Boden besteht aus grossen Pflastersteinen.");

  AddDetail( ({"ende"}),
	    "Am unteren Ende des Denkmals haengt eine gold schimmernde "
	    "Plakette.");
  
  AddDetail( ({"plakette"}),
	    "Die Plakette unter dem Denkmal scheint aus Gold zu sein. Du "
	    "kannst die Plakette lesen.");

  AddDetail( ({"mann","mensch"}), 
            "Der Mann ist ein Mensch und hat eine stattliche Figur. Er hat "
	    "einen Vollbart und scheint zu laecheln.");

  AddDetail( ({"arme"}),
	    "Die Arme sind weit ausgestreckt. Er scheint alle willkommen zu "
	    "heissen.");

  AddDetail( ({"figur"}),
	    "Die stattliche Figur ist nicht dick, sondern nur staemmig.");

  AddDetail( ({"vollbart"}),
	    "Der Vollbart verdeckt nicht ein freundliches Laecheln.");
  
  AddDetail( ({"laecheln"}),
	    "Das Denkmal scheint freundlich zu laecheln.");

  AddDetail( ({"gold"}),
	    "Die Plakette ist sicher sehr wertvoll.");
  
  AddDetail( ({"silberland","silberlandes"}),
	    "Du bist im Silberland.");

  AddDetail( ({"teilen","teile"}), 
            "Das Silberland ist sehr gross.");

  AddDetail( ({"tijara","dschungel","obst","obstsorten"}),
	    "Die Haendler aus Tijara bieten exotische Obstsorten aus dem "
	    "Dschungel an.");

  AddDetail( ({"roch adan","roch","adan","holzarbeiten","zentauren"}),
	    "Die Haendler aus Roch Adan bieten die beruehmten Holzarbeiten "
	    "der Zentauren an.");

  AddDetail( ({"ardhmir","zwergenfeste","waffen"}),
	    "Die Haendler der Zwergenfeste von Ardhmir bieten ihre beruehmten "
	    "Waffen an.");

  AddDetail( ({"felonia","ruestungen"}),
	    "Die Haendler aus Felonia verkaufen hier ihre beruehmten "
	    "Ruestungen.");
  
  AddDetail( ({"midas","koestlichkeiten","mund","wasser"}),
	    "Hier gibt es sogar die Koestlichkeiten aus Midas zu kaufen. Dir "
	    "laeuft das Wasser im Mund zusammen.");

  AddDetail( ({""}),
	    "");
  
  AddReadDetail( ({"plakette"}),
	    "+-------------------------------------------------------+\n"
	    "|                                                       |\n"
	    "|                    Cornelius I                        |\n"
	    "|                                                       |\n"
	    "| Cornelius, der Erste, ist der Gruender von Luifinlas. |\n"
	    "| Er gruendete die Stadt Luifinlas nach der Schlacht um |\n"
	    "| Midas um einen Ort zu schaffen, wo alle Rassen des    |\n"
	    "| Silberlandes in Frieden miteinander leben koennen.    |\n"
	    "|                                                       |\n"
	    "+-------------------------------------------------------+\n");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach den Waren auf dem Platz.");  
 
  AddSmell( ({"waren","gerueche"}),
	   "Die Gerueche sind uebermaechtig.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Haendler schreien und die Musikanten "
		  "Lieder spielen.");

  AddSound( ({"haendler"}),
		  "Die Haendler bieten lautstark ihre Waren an.");

  AddSound( ({"musikanten","lieder"}),
	   "Die Lieder der Musikanten sind nicht unbedingt gut, aber frivol "
	   "und das gefaellt Dir.");

//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas21");
AddExit("sueden", ROOM "luifinlas26");
AddExit("nordosten", ROOM "luifinlas79");
AddExit("nordwesten", ROOM "luifinlas72");
AddExit("westen", ROOM "luifinlas14");
AddExit("osten", ROOM "luifinlas16");
AddExit("suedosten", ROOM "luifinlas78");
AddExit("suedwesten", ROOM "luifinlas73");

}
