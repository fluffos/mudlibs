// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem dunklen Wald");
  SetProp( P_INT_LONG,
	"Du stehst auf einer Kreuzung im Wald, in dem es stockdunkel ist. "
	"Der Weg fuehrt hier nach Norden, Osten oder Sueden. Die Baeume "
	"verhindern mit ihrem dichten Blaetterdach, dass Licht bis zu Dir "
	"durchdringt. Es ist unheimlich und kalt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 0 );

//-----Details Anfang-----
  
  AddDetail( ({"kreuzung"}),
	    "Hier in der Dunkelheit musst Du Dich entscheiden, wohin Du gehen "
	    "willst. Vielleicht hilft Dir das Schild am Wegrand.");

  AddDetail( ({"wald"}),
	    "Der Wald ist sehr dicht durch die Baeume am Wegrand und das "
	    "Unterholz.");
  
  AddDetail( ({"weg"}),
	    "Der Weg teilt sich hier.");

  AddDetail( ({"norden","osten","sueden"}), 
            "Du kannst nach Norden, Osten oder Sueden gehen. Schau doch mal "
	    "das Schild am Wegrand an.");

  AddDetail( ({"blaetterdach","dach","lichtquelle","dunkelelf"}),
	    "Das Blaetterdach ist so dicht, dass es hier stockdunkel ist und "
	    "Du nichts sehen kannst ohne Lichtquelle oder als Dunkelelf.");

  AddDetail( ({"licht"}),
	    "Hier gibt es ueberhaupt kein Licht, ausser Du hast es mit hier "
	    "her gebracht.");
  
  AddDetail( ({"boden","steinchen"}),
	    "Der Boden ist mit kleinen Steinchen bedeckt.");

  AddDetail( ({"himmel"}),
	    "Den Himmel wuerdest Du gerne sehen.");
  
  AddDetail( ({"dunkelheit"}),
	    "Es herrscht absolute Dunkelheit.");

  AddDetail( ({"schild"}), 
            "Du kannst es lesen.");

  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand steht ein kleines Schild");

  AddDetail( ({"baeume"}),
	    "Die grossen Baeume stehen sehr dicht und haben ein sehr dichtes "
	    "Blaetterdach.");

  AddDetail( ({"unterholz","durchkommen"}),
	    "Das Unterholz haelt Dich auf dem Weg. Es gibt kein Durchkommen.");
  
  AddDetail( ({""}),
	    "");

  AddReadDetail( ({"schild"}),
	    "+---------------------------------------------+\n"
	    "|                                             |\n"
	    "|     unbekanntes Gebiet                      |\n"
	    "|             |                               |\n"
	    "|             |                               |\n"
	    "|             +-------- Luifinlas / Hubbleton |\n"
	    "|             |                               |\n"
	    "|             |                               |\n"
	    "|      Hochebene von Gorthad                  |\n"
	    "|                                             |\n"
	    "+---------------------------------------------+\n");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es ist ungemuetlich hier und Du willst hier nicht "
		          "riechen.");  

  AddSound(DEFAULT_SOUND, "Es ist totenstill hier.");

//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas97");
AddExit("sueden", ROOM "luifinlas92");
AddExit("osten", ROOM "luifinlas90");

}

