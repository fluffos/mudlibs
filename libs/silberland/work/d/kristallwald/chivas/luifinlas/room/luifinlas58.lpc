// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Wald ist hier und im Suedwesten sehr dicht. Im Norden wird er "
	"lichter und der Weg scheint an einem kleinen See vorbei zu fuehren. "
	"Die Baeume, die jetzt auf der oestlichen Seite des Weges stehen, "
	"weichen im Norden und machen dem See Platz." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wald"}),
	    "Der Wald ist sehr dicht, wird aber lichter im Norden.");

  AddDetail( ({"suedwesten"}),
	    "Im Suedwesten ist nur Wald zu sehen.");
  
  AddDetail( ({"norden"}),
	    "Im Norden scheint ein See am Weg zu sein.");

  AddDetail( ({"weg","weges"}), 
            "Der Weg fuehrt im Norden an einem See vorbei.");

  AddDetail( ({"see"}),
	    "Geh naeher ran und schau ihn Dir an.");

  AddDetail( ({"baeume"}),
	    "Lauter Baeume sind in diesem Wald.");

  AddDetail( ({"seite"}),
	    "Auf der oestlichen Seite werden die Baeume im Norden verschwinden "
	    "und dem See Platz machen.");
  
  AddDetail( ({"platz"}),
	    "Da wo hier Baeume sind, ist im Norden der See.");

  AddDetail( ({"boden","steinchen"}),
	    "Der Boden ist mit kleinen Steinchen bedeckt, die aber nicht sehr "
	    "interessant sind.");
  
  AddDetail( ({"himmel","blaetterdach","dach"}),
	    "Der Himmel wird vom dichten Blaetterdach verdeckt.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst Baeume.");  
 
  AddSmell( ({"baeume"}),
	   "Sie duften sehr baumig.");

  AddSound(DEFAULT_SOUND, "Du hoerst Voegel.");

  AddSound( ({"voegel"}),
	   "*triller*");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas57");
AddExit("suedwesten", ROOM "luifinlas59");

}
