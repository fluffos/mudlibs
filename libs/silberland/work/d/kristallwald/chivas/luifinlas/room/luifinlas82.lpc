// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Strasse von Luifinlas");
  SetProp( P_INT_LONG,
	"Du scheinst Dich nun in einem Viertel zu befinden. wo sich "
	"hauptsaechlich Zwerge niedergelassen haben. Die Gebaeude sind "
	"niedriger, es gibt lauter Laeden mit Steinmetzen und Schmieden und "
	"ueberall laufen fast nur Zwerge herum, die teilweise auch schwer "
	"bewaffnet sind." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"viertel"}),
	    "In diesem Viertel der Stadt scheinen hauptsaechlich Zwerge zu "
	    "wohnen und zu arbeiten.");

  AddDetail( ({"zwerge"}),
	    "Viele Zwerge wohnen hier und sind auf der Strasse zu sehen.");
  
  AddDetail( ({"gebaeude","zustand"}),
	    "Die Gebaeude sind niedriger und hauptsaechlich fuer Zwerge "
	    "gebaut. Sie sind in einem guten Zustand und wirken sehr "
	    "gepflegt.");

  AddDetail( ({"laeden"}), 
            "Hier gibt es lauter Laeden, die hauptsaechlich fuer Zwerge "
	    "sind.");

  AddDetail( ({"steinmetze","steinmetzen"}),
	    "Viele Steinmetze der Zwerge haben sich hier nieder gelassen.");

  AddDetail( ({"schmieden","schmiede"}),
	    "Einige Schmieden sind hier zu sehen.");

  AddDetail( ({"boden"}),
	    "Am Boden siehst Du lauter Pflastersteine, die zu der Strasse "
	    "gehoert.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ueber Dir ist blau.");

  AddDetail( ({"strasse","norden","suedosten","westen"}),
	    "Die Strasse fuehrt nach Norden, Suedosten und nach Westen.");
  
  AddDetail( ({"pflastersteine","steine","pflaster"}),
	    "Die Pflastersteine sind uninteressant und bilden die "
	    "Strasse.");

  AddDetail( ({"stadt","luifinlas"}), 
            "Du bist in der Stadt Luifinlas.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Rauch.");  
 
  AddSmell( ({"rauch"}),
	   "Der Rauch dringt aus den Schmieden.");

  AddSound(DEFAULT_SOUND, "Du hoerst Haemmern.");

  AddSound( ({"haemmern"}),
	   "Das Haemmern stammt aus den Schmieden und von den "
	   "Steinmetzen.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas80");
AddExit("suedosten", ROOM "luifinlas81");
AddExit("westen", ROOM "luifinlas108");
}
