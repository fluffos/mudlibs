// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Bruecke");
  SetProp( P_INT_LONG,
	"Du stehst auf einer Bruecke, die ueber einen kleinen Bach fuehrt, der "
	"ueber eine Wiese fliesst. Du kannst zwischen den Holzbohlen am Boden "
	"das Wasser unter Dir lang fliessen sehen. Am Gelaender der Bruecke "
	"kannst Du verschiedene Schnitzereien erkennen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"bruecke","fuesse"}),
	    "Die Bruecke fuehrt Dich ueber den kleinen Bach. Waere hier keine "
	    "Bruecke, muesstest Du durch den Bach stiefeln und wuerdest nasse "
	    "Fuesse bekommen.");

  AddDetail( ({"bach"}),
	    "Der Bach plaetschert unter der Bruecke durch.");
  
  AddDetail( ({"wiese","teile"}),
	    "Die Wiese ist sehr gross und wird durch den Bach in zwei Teile "
	    "geteilt.");

  AddDetail( ({"holz"}),
	    "Die Bruecke besteht aus Holz.");

  AddDetail( ({"holzbohlen","bohlen"}),
	    "Die dicken Holzbohlen wuerden sogar einen Troll oder Oger "
	    "aushalten. Die Bruecke wird sicher nicht einstuerzen.");

  AddDetail( ({"oger","troll","trolle"}),
	    "Oger und Trolle sind sehr schwer, aber auch sie wuerden die "
	    "Bohlen halten.");

  AddDetail( ({"boden"}),
	    "Grosse Holzbohlen bilden den Boden der Bruecke.");
  
  AddDetail( ({"wasser"}),
	    "Das Wasser plaetschert unter Dir hindurch.");

  AddDetail( ({"gelaender"}),
	    "Das Gelaender besteht wie die Bruecke aus Holz. Im Gelaender sind "
	    "viele Schnitzereien zu sehen.");
  
  AddDetail( ({"schnitzereien","initialen","wanderer"}),
	    "Die Schnitzereien sind sehr unterschiedlich. Anscheinend haben "
	    "viele Wanderer ihre Initialen im Gelaender hinterlassen.");

  AddDetail( ({"himmel"}), 
            "Der Himmel ist blau und die Sonne steht ueber Dir.");

  AddDetail( ({"sonne"}),
	    "Die Sonne waermt Dich.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Die Luft ist herrlich frisch.");  
 
  AddSmell( ({"luft"}),
	   "Die Luft riecht gut.");

  AddSound(DEFAULT_SOUND, "Man hoert viele Voegel am Himmel.");

  AddSound( ({"voegel"}),
	   "*zwitscher*");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas51");
AddExit("suedwesten", ROOM "luifinlas53");

}
