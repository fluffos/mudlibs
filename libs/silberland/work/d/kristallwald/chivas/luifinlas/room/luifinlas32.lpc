// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Wiese");
  SetProp( P_INT_LONG,
	"Du befindest Dich auf einer grossen Wiese, die vor der Stadt im "
	"Norden angelegt wurde um einen guten Blick auf das Umland zu haben. "
	"Du erkennst einige Baumstuempfe, die von gerodeten Baeumen stammen. "
	"Im Suedwesten beginnt aber die Baumgrenze eines grossen Waldes." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wiese"}),
	    "Die Wiese auf der Du Dich befindest, fuehrt von der Stadt im "
	    "Norden, die von einer maechtigen Stadtmauer umrundet wird bis "
	    "zum Wald im Sueden.");

  AddDetail( ({"stadt","norden","luifinlas"}),
	    "Die Stadt im Norden ist die grosse Stadt Luifinlas.");
  
  AddDetail( ({"blick"}),
	    "Von der Stadtmauer hat man einen guten Blick auf alles, was auf "
	    "die Stadt zukommt.");

  AddDetail( ({"umland"}), 
            "Das Umland um die Stadt wurde gerodet und eine grosse Wiese ist "
	    "entstanden.");

  AddDetail( ({"baumstuempfe","stellen"}),
	    "An vielen Stellen auf der Wiese sieht man Baumstuempfe, die von "
	    "den gerodeten Baeumen stammen.");

  AddDetail( ({"baeumen","baeume"}),
	    "Die Baeume hier auf der Wiese sind gerodet worden. Weiter im "
	    "Sueden stehen noch viele, denn dort ist der Wald.");

  AddDetail( ({"suedwesten","baumgrenze","grenze"}),
	    "Wenn Du dem Weg nach Suedwesten folgst auf dem Du stehst, dann "
	    "erreichst Du die Baumgrenze des Waldes.");
  
  AddDetail( ({"wald","waldes","sueden"}),
	    "Im Sueden ist ein grosser Wald.");

  AddDetail( ({"boden","steinchen"}),
	    "Der Boden des Weges, auf dem Du stehst, besteht aus kleinen "
	    "Steinchen.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ueber Dir ist blau.");

  AddDetail( ({"stadtmauer","mauer"}), 
            "Die maechtige Stadtmauer umschliesst die gesamte Stadt.");

  AddDetail( ({"weg","weges"}),
	    "Der Weg fuehrt Dich nach Norden oder Suedwesten.");

  AddDetail( ({"blumen"}),
	    "Kleine rote und blaue Blumen stehen auf der Wiese.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen riechen gut.");

  AddSound(DEFAULT_SOUND, "Du hoerst von hier aus schon den Laerm der Stadt.");

  AddSound( ({"laerm","stadt"}),
	   "Um genaueres zu hoeren, solltest Du naeher ran gehen.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas31");
AddExit("suedwesten", ROOM "luifinlas33");

}
