// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Waldweg");
  SetProp( P_INT_LONG,
	"Der Weg fuehrt durch einen dichten Wald nach Sueden oder nach "
	"Norden. Im Norden scheint der Wald dichter zu sein und im Sueden "
	"ist eine Weggabelung zu erkennen. Der Weg auf dem Du Dich befindest "
	"ist gesaeumt von grossen Baeumen. Zwischen den Baeumen sind einzelne "
	"Buesche zu sehen, die es Dir unmoeglich machen an dieser Stelle den "
	"Weg zu verlassen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"weg","richtung","stelle"}),
	    "Der Weg gibt Dir die Richtung vor. Du kannst nicht vom Weg "
	    "abweichen.");

  AddDetail( ({"wald","daemmerlicht"}),
	    "Der Wald ist dicht, aber nicht angsteinfloessend oder boese. Du "
	    "fuehlst Dich hier im Daemmerlicht der Baeume ganz wohl.");
  
  AddDetail( ({"sueden"}),
	    "Im Sueden gabelt sich der Weg.");

  AddDetail( ({"norden"}), 
            "Im Norden geht der Wald weiter.");

  AddDetail( ({"weggabelung","gabelung"}),
	    "Du musst schon nach Sueden gehen um mehr zu erkennen.");

  AddDetail( ({"baeume","baeumen"}),
	    "Viele Baeume befinden sich hier im Wald. Sie machen eigentlich "
	    "einen Wald aus.");

  AddDetail( ({"buesche"}),
	    "Kleine unbedeutsame Buesche stehen am Wegrand zwischen den "
	    "dicken Staemmen der Baeume.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit Blaettern bedeckt. Ausserdem siehst Du ein "
	    "paar kleine Ameisen.");
  
  AddDetail( ({"himmel"}),
	    "Den Himmel kannst Du durch das dichte Blaetterdach nicht "
	    "sehen.");

  AddDetail( ({"wegrand","rand"}), 
            "Am Wegrand stehen die grossen Baeume.");

  AddDetail( ({"staemme","staemmen"}),
	    "Die dicken Staemme der Baeume saeumen den Weg. Ein Stamm faellt "
	    "Dir besonders auf.");

  AddDetail( ({"blaettern","blaetter","aesten","aeste"}),
	    "Es sind viele Blaetter von den Baeumen auf den Boden gefallen. "
	    "Natuerlich befinden sich auch noch unzaehlbar viele Blaetter an "
	    "den Aesten der Baeume.");

  AddDetail( ({"ameisen"}),
	    "Die Ameisen gehen ihrer Arbeit nach und lassen sich von Dir nicht "
	    "stoeren.");
  
  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach ueber Dir ist sehr dicht.");

  AddDetail( ({"arbeit","fremdwort"}),
	    "Arbeit ist ein Fremdwort fuer Dich.");
  
  AddDetail( ({"stamm","stammes"}),
	    "In die Rinde des Stammes wurde etwas eingeritzt.");

  AddDetail( ({"rinde"}), 
            "Du erkennst ein kleines Herz und ein paar Buchstaben.");

  AddDetail( ({"herz","geste"}),
	    "Das Herz ist sehr klein, aber trotzdem eine nette Geste "
	    "desjenigen, der es eingeritzt hat.");

  AddDetail( ({"buchstaben","kreuz"}),
	    "Du erkennst die Buchstaben C und L, die mit einem Kreuz "
	    "verbunden sind.");

  AddDetail( ({"c"}),
	    "Das C steht sicher fuer Chivas.");
  
  AddDetail( ({"l","frau"}),
	    "Das L steht sicher fuer seine Frau.");

  AddDetail( ({"chivas"}),
	    "Chivas ist einer der faulen Magier im Silberland.");
  
  AddDetail( ({"magier"}),
	    "Magier sind faul.");

  AddDetail( ({"silberland"}), 
            "Du bist im Silberland.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht waldig."); 

  AddSound(DEFAULT_SOUND, "Es ist beruhigend ruhig.");

//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas61");
AddExit("sueden", ROOM "luifinlas63");

}
