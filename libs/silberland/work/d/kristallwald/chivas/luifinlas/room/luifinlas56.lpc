// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einem See");
  SetProp( P_INT_LONG,
	"Der Wald wird hier in oestlicher Richtung von einem kleinen See "
	"unterbrochen. Nur im Westen des Weges stehen grosse Baeume. Der See "
	"liegt ruhig vor Dir. Viele Wasservoegel sind auf ihm zu sehen und "
	"tausende von Seerosen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wald"}),
	    "Der Wald ist hier mit einem See verschoenert. Der Magier, der "
	    "das hier geschrieben hat, ist wirklich sehr romantisch.");

  AddDetail( ({"richtung"}),
	    "Du kannst ueber den Weg nach Nordwesten und Sueden gehen. Im "
	    "Westen stehen grosse Baeume und im Osten ist der See.");
  
  AddDetail( ({"see","sees"}),
	    "Das Ufer des Sees ist hier direkt am Weg. Tausende Seerosen sind "
	    "zu sehen und viele Wasservoegel schwimmen auf dem See.");

  AddDetail( ({"weg","weges"}),
	    "Der Weg ist mit kleinen Steinchen bedeckt und fuehrt direkt am "
	    "See entlang.");

  AddDetail( ({"baeume","seite"}),
	    "Grosse Baeume stehen auf der westlichen Seite des Weges. Zwischen "
	    "zwei Baeumen steht eine kleine Bank, die zum Ausruhen einlaedt.");

  AddDetail( ({"wasservoegel","voegel"}),
	    "Du erkennst einige Haubentaucher, ein paar Enten und zwei "
	    "Schwaene.");
  
  AddDetail( ({"seerosen"}),
	    "Die Seerosen schwimmen auf der Wasseroberflaeche. Ein paar "
	    "Seerosen sind auch aufgegangen und zeigen Dir ihre Blueten.");

  AddDetail( ({"boden"}),
	    "Der Boden des Weges auf dem Du stehst ist mit kleinen Steinchen "
	    "bedeckt.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau und spiegelt sich in der Wasseroberflaeche "
	    "des Sees.");

  AddDetail( ({"magier"}), 
            "Eigentlich ist dem Magier nichts mehr zu Wald eingefallen und er "
	    "musste mal ein anderes Detail einfuegen.");

  AddDetail( ({"detail"}),
	    "Du untersuchst wirklich alles.");

  AddDetail( ({"nordwesten"}),
	    "Da fuehrt der Weg in wieder in den Wald.");

  AddDetail( ({"sueden"}),
	    "Da fuehrt der Weg weiter am Ufer des Sees entlang.");
  
  AddDetail( ({"westen"}),
	    "Hier sind nur Baeume.");

  AddDetail( ({"osten"}),
	    "Da ist der See.");
  
  AddDetail( ({"ufer"}),
	    "Das Ufer reicht direkt an den Weg. Einige Wasserpflanzen und "
	    "etwas Schilf sind zu sehen.");

  AddDetail( ({"steinchen"}), 
            "Die Steinchen sind nicht sehr interessant.");

  AddDetail( ({"bank"}),
	    "Die Bank ist leider schon besetzt. Ein Hobbit liegt quer ueber "
	    "der Bank.");

  AddDetail( ({"ausruhen"}),
	    "Du musst Dich sicher nicht ausruhen.");

  AddDetail( ({"haubentaucher","essbaren"}),
	    "Die Haubentaucher verschwinden immer wieder und tauchen unter um "
	    "nach Essbaren fuer sich zu suchen.");
  
  AddDetail( ({"enten"}),
	    "Die Enten schwimmen gemuetlich ueber den See und weichen dabei "
	    "den Seerosen aus.");

  AddDetail( ({"schwaene"}),
	    "Die zwei Schwaene schwimmen majestetisch ueber den See.");
  
  AddDetail( ({"blueten"}),
	    "Du siehst wunderschoene rote und weisse Blueten der Seerosen.");

  AddDetail( ({"wasseroberflaeche","oberflaeche"}), 
            "Der Himmel spiegelt sich in der Wasseroberflaeche. Auf ihr "
	    "schwimmen die Voegel und die Seerosen.");

  AddDetail( ({"hobbit"}),
	    "Der Hobbit schlaeft und Du solltest ihn auch schlafen lassen. Er "
	    "scheint sich sehr wohl hier zu fuehlen und ist wohl einfach "
	    "eingedoest.");

  AddDetail( ({"wasserpflanzen"}),
	    "Du kennst Dich leider nicht so gut aus mit Wasserpflanzen, aber "
	    "sie sind sehr schoen.");

  AddDetail( ({"schilf"}),
	    "Das Schilf waechst sehr hoch am Ufer.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst die Blueten der Seerosen.");  
 
  AddSmell( ({"blueten","seerosen"}),
	   "Sie duften herrlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Schnarchen.");

  AddSound( ({"schnarchen","hobbit"}),
	   "Das Schnarchen stammt von dem Hobbit auf der Bank.");
  
//-----Details Ende-----
  
AddExit("nordwesten", ROOM "luifinlas55");
AddExit("sueden", ROOM "luifinlas57");

}
