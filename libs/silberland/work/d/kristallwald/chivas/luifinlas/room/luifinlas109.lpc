// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Strasse in Luifinlas");
  SetProp( P_INT_LONG,
	"Die Strasse geht hier nicht weiter und endet vor der hohen "
	"Stadtmauer von Luifinlas im Westen. Nach Sueden und Norden kannst Du "
	"zwei schoene Haeuser betreten, die sich an die Stadtmauer schmiegen. "
	"Nach Osten geht es wieder zurueck von wo Du her gekommen bist.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"strasse"}), 
            "Die gepflasterte Strasse endet im Westen an der Stadtmauer von "
	    "Luifinlas. Nach Osten kannst Du der Strasse weiter folgen.");
  
  AddDetail( ({"stadtmauer","mauer","westen"}), 
            "Die hohe Stadtmauer ist im Westen zu sehen. Sie besteht aus "
	    "grossen Steinquadern und eine Tuer ist zu sehen.");

  AddDetail( ({"luifinlas"}), 
            "Du bist in der Stadt Luifinlas.");  

  AddDetail( ({"sueden","norden","haeuser","haus"}), 
            "Nach Norden und Sueden kannst Du jeweils ein Haus betreten. Die "
	    "Haeuser sind gut gepflegt aus und man kann hier sicher gut "
	    "wohnen.");  

  AddDetail( ({"osten"}), 
            "Die Strasse fuehrt nach Osten.");  

  AddDetail( ({"boden"}), 
            "Der Boden ist mit Pflastersteinen bedeckt.");  

  AddDetail( ({"himmel"}), 
            "Der Himmel ist schoen blau.");  

  AddDetail( ({"steinquadern","steinquader","stein","quader"}), 
            "Die grossen Steinquader bilden die Stadtmauer.");  

  AddDetail( ({"tuer","schluessel"}), 
            "Die Tuer fuehrt wohl in die Stadtmauer von Luifinlas. Sie ist "
	    "momentan verschlossen und Du hast keinen Schluessel. ");  

  AddDetail( ({"pflastersteinen","pflastersteine","steine","pflaster"}), 
            "Die Pflastersteine am Boden sind nicht sehr interessant.");  

  AddDetail( ({""}), 
            "");  

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht einfach nur nach Stadt.");  
 
  AddSmell( ({"stadt","gerueche"}),
	   "Du riechst gern die Gerueche der Stadt.");

  AddSound(DEFAULT_SOUND, "Du hoerst verschiedene Leute auf der Strasse.");

  AddSound( ({"leute"}),
	   "Du willst sie nicht belauschen.");

//-----Details Ende-----
  
AddExit("sueden", ROOM "luifbau4");
AddExit("osten", ROOM "luifinlas108");
AddExit("norden", ROOM "luifbau5");

}
