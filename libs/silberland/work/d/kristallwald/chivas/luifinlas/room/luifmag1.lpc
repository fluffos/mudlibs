// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Im Magierturm von Luifinlas");
  SetProp( P_INT_LONG,
	"Du bist im Erdgeschoss des Turms der Magier. An den Waenden stehen "
	"hohe Regale und einige Schreibtische sind zu sehen, an denen kleine "
	"Kobolde arbeiten, die die Magier in ihrer Arbeit unterstuetzen. An "
	"einer Wand haengt eine Tafel." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"erdgeschoss"}),
	    "Du bist im Erdgeschoss des Turms und hier herrscht emsiges "
	    "Treiben.");

  AddDetail( ({"turm","turms","magierturm"}),
	    "In diesem Turm haben die Magier ihre Bueros.");
  
  AddDetail( ({"wand","waende","waenden"}),
	    "An den Waenden sind viele Regale zu sehen und unzaehlige Tueren. "
	    "An einer Wand haengt eine Tafel.");

  AddDetail( ({"regale"}), 
            "Auf den Regalen stehen viele Buecher und einige Papyrusrollen "
	    "sind zu erkennen.");

  AddDetail( ({"schreibtische"}),
	    "An den Schreibtischen arbeiten viele Kobolde.");

  AddDetail( ({"kobolde"}),
	    "Die Kobolde unterstuetzen die Magier.");

  AddDetail( ({"magier"}),
	    "Die Magier arbeiten hier.");
  
  AddDetail( ({"arbeit","fremdwort"}),
	    "Arbeit ist fuer Dich ein Fremdwort.");

  AddDetail( ({"tafel"}),
	    "Du kannst die Tafel lesen.");
  
  AddDetail( ({"boden","steinplatten"}),
	    "Der Boden besteht aus grossen Steinplatten.");

  AddDetail( ({"decke"}), 
            "Die Decke ist sehr hoch ueber Dir. Der ganze Turm scheint magisch "
	    "vergroessert zu sein, da hier drin mehr Platz ist, als es von "
	    "aussen den Anschein hatte.");

  AddDetail( ({"treiben","leute","dinge"}),
	    "Viele Kobolde, Magier und andere Leute laufen umher und haben "
	    "wichtige Dinge zu tun.");

  AddDetail( ({"bueros"}),
	    "Die Bueros der Magier sind sicher weiter oben.");

  AddDetail( ({"buecher","buechern"}),
	    "Die Buecher enthalten Zauber zum Erschaffen des Silberlandes und "
	    "die Konzepte der Magier.");
  
  AddDetail( ({"papyrusrollen","rollen"}),
	    "Die Papyrusrollen enthalten die alten Konzepte der Altmagier und "
	    "Erzmagier, als alles anfing, was schon sehr lange her ist.");

  AddDetail( ({"zauber"}),
	    "Die Zauber in den Buechern sind nichts fuer Dich.");
  
  AddDetail( ({"erschaffen","silberlandes","silberland"}),
	    "Auch das Erschaffen des Silberlandes muss gut dokumentiert "
	    "werden.");

  AddDetail( ({"konzepte","buch"}), 
            "Du kannst ja mal versuchen ein Buch aus den Regalen zu nehmen um "
	    "Dir die Konzepte anzusehen. Es ist sicher sehr interessant.");

  AddDetail( ({"altmagier","erzmagier","goetter","papier"}),
	    "Die Konzepte der meisten Altmagier, Erzmagier und Goetter sind "
	    "schon sehr alt und deshalb noch auf den Papyrusrollen "
	    "geschrieben und nicht auf Papier.");

  AddDetail( ({"platz"}),
	    "Der Platz im Turm ist riesig. Er wurde sicher magisch erweitert "
	    "um alle Magier und die Kobolde hier unter zu bringen.");

  AddDetail( ({"anschein"}),
	    "Der erste Anschein truegt oft.");
  
  AddDetail( ({"zettel"}),
	    "Du kannst ihn lesen.");

  AddDetail( ({"tueren","antraege","sachen"}),
	    "Hinter den Tueren sind verschiedene Bueros, wo Antraege und "
	    "andere Sachen bearbeitet werden.");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({""}), 
            "");

  AddDetail( ({""}),
	    "");

  AddReadDetail( ({"zettel"}),
	    "Da es in der letzten Zeit keine Beschwerden gab, wurden die "
	    "Beschwerdestellen voruebergehend geschlossen. Wende Dich bitte "
	    "an Merlin um sie wieder zu oeffnen. gez. Oberkobold der Magier");

  AddReadDetail( ({"tafel"}),
	    "+-----------------------------------------------------+\n"
	    "| Beschwerdestellen                                   |\n"
	    "|                                                     |\n"
	    "| Magische Fehlschlaege von Magiern          Raum 101 |\n"
	    "| Unerlaubte Tode durch Magierwillkuer       Raum 102 |\n"
	    "| Gemeine Quests                             Raum 103 |\n"
	    "|                                                     |\n"
	    "| Allgemeine Beschwerdestelle fuer Spieler   Raum  x  |\n"
	    "|                                                     |\n"
	    "+-----------------------------------------------------+\n"
	    "                                                       \n"
	    "Unter der Tafel wurde noch ein kleiner Zettel gehaengt.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Magie.");  
 
  AddSmell( ({"magie"}),
	   "Du weisst nicht genau wie sie riecht, aber hier riecht es so.");

  AddSound(DEFAULT_SOUND, "Du hoerst viel, aber nichts besonderes.");

//-----Details Ende-----
  
AddExit("westen", ROOM "luifinlas27");
AddExit("oben", ROOM "luifmag2");

AddCmd( ({"nimm", "nehme" }), "nehmen" );

}  
int nehmen(string str)
{
   notify_fail("Was moechtest Du aus den Regalen nehmen?\n");
   if ( member( ({ "buch aus regal", "buch aus regalen" }),str) != -1) 
  {
    write(BS ( "Du willst ein Buch heimlich aus den Regalen nehmen und sofort "
	       "ertoent ein lautes Grollen und alle schauen Dich an. Du "
	       "laechelst nervoes, taetschelst das Buch noch einmal und "
	       "stellst es zurueck ins Regal."));
    say( TPN+" probiert etwas und wird erwischt.\n");
    return 1;
  }

}  

