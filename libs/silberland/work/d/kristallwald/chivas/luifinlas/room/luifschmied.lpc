#include "../def.h"

inherit "std/room"; 

#define AN 1
#define AUS 0

int feuer;

void create()
{
  ::create();

  feuer = AN;

  SetProp(P_INT_SHORT, "In der Schmiede von Luifinlas");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1); 
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 45, ENV_TERRAIN: TT_HOUSE]) );

//-----Details Anfang-----


  AddDetail( ({"boden"}),
	    "Der Boden besteht aus Stein, ist jedoch von einer leichten "
	    "Russschicht bedeckt.");

  AddDetail( ({"wand","waende","waenden"}),
	    "An den Waenden haengen lauter Werkzeuge und noch andere Sachen.");

  AddDetail( ({"decke"}), 
            "Die Decke ist vom Feuer geschwaerzt.");

  AddDetail( ({"stadt","luifinlas"}),
	    "Du bist in Luifinlas.");

  AddDetail( ({"werkzeuge"}),
	    "Es haengen lauter Hammer und Zangen an den Waenden.");

  AddDetail( ({"hufeisen"}), 
            "Die Hufeisen wurden sicher beauftragt und muessen nur noch "
	    "abgeholt werden. Du brauchst momentan keine Hufeisen.");

  AddDetail( ({"gegenstaende","sachen","metallherstellung"}),
	    "Es sind alles moeglichen Gegenstaende, die sicher etwas mit "
	    "der Metallherstellung zu tun haben. Du kannst aber nicht deuten, "
	    "wofuer sie genau gebraucht werden.");

  AddDetail( ({"amboss","form"}),
	    "Ein grosser Amboss steht neben der Esse. Auf ihm bringt der "
	    "Schmied das Metall in die gewuenschte Form.");

  AddDetail( ({"stein"}), 
            "Der Boden muss aus Stein bestehen, da er ansonsten brennen "
	    "wuerde.");

  AddDetail( ({"russ","russschicht","schicht"}),
	    "Eine Russschicht ist in einer Schmiede ganz normal.");

  AddDetail( ({"hammer"}),
	    "Du siehst Hammer in unterschiedlichen Groessen.");

  AddDetail( ({"zangen"}), 
            "Du siehst Zangen in verschiedensten Formen.");

  AddDetail( ({"formen","groessen"}),
	    "Du bist kein Fachmann und weisst nicht genau, wofuer genau was "
	    "benutzt werden muss.");

  AddDetail( ({"mitte","feuerstelle"}), 
            "In der Mitte ist eine Feuerstelle.");

  AddDetail( ({"fachmann"}),
	    "Du bist kein Fachmann.");

  AddDetail( ({""}), 
            "");

  AddDetail( ({"schmied","grebozim"}),
	    "Der Schmied hier heisst Grebozim.");

  AddDetail( ({"hitze"}),
	    "Wenn die Esse angefeuert ist, herrscht in der Schmiede eine "
	    "grosse Hitze.");

  AddDetail( ({"nase"}),
	    "Du hast eine und sie wird laenger wenn Du luegst.");

  AddDetail( ({"glut","esse"}),
	    "Die Glut glueht rot in der Esse.");

  AddDetail( ({"flammen"}),
	    "Die Flammen lodern in der Esse.");

  AddDetail( ({"metall","eisen","bronze","metalle","metall","bearbeiten","arbeiten"}),
	    "Hier werden viele Metalle verarbeitet. Eisen, Bronze und noch vieles mehr.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Rauch in der Schmiede.");  
 
  AddSmell( ({"rauch","nase"}),
	   "Der Rauch sticht in Deiner Nase.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Feuer knistern.");

  AddSound( ({"feuer","knistern"}),
	   "knister knister knister");

  AddSpecialDetail( ({"feuer","esse"}), "detail_feuer");

//-----Details Ende-----

  AddCmd( ({"loesche","loesch"})      , "cmd_loeschen");
  AddCmd( ({"zuend","zuende"})        , "cmd_zuenden");

  AddItem(NPC "grebozim", REFRESH_DESTRUCT);

  AddExit("norden", ROOM "luifinlas81");
}

string detail_feuer(string str)
{
  string s;

  if(feuer == AN)
  {
    s = "Hell lodern die Flammen in der Esse und verbreiten eine ziemliche "
        "Hitze. ";
  }
  else
  {
    s = "Nur dunkelrot glimmt die Glut in der Esse. ";
  }

  return BS(s);
}

int cmd_loeschen(string str)
{
  notify_fail("Was moechtest Du loeschen?\n"); 

  if(!str || str == "") return 0; 

  if(!(str == "feuer"         ||            
       str == "esse"          )) return 0;  

  if(feuer == AUS)
  {
    tell_object(TP,"Aber das Feuer ist doch schon aus!\n"); 

    return -1; 
  }

  tell_object(TP,"Du nimmst einen Eimer Wasser und loeschst das Feuer.\n");

  TO->Message(BS(TP->Name()+" nimmt einen Eimer Wasser und loescht das "
              "Feuer."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  feuer = AUS;
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );

  return 1; 
}

int cmd_zuenden(string str)
{

  notify_fail("Was moechtest Du anzuenden?\n");

  if(!str || str == "") return 0;
  if(!(str == "feuer"         ||
       str == "esse"          ||
       str == "feuer an"      ||
       str == "esse an"       )) return 0;

  if(feuer == AN)
  {
    tell_object(TP,"Aber das Feuer brennt doch schon!\n");

    return -1; 
  }

  tell_object(TP,"Du pustest in die Glut und zuendest das Feuer wieder an.\n");

  TO->Message(BS(TP->Name()+" pustet in die Glut und zuendet das Feuer "
              "wieder an."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  feuer = AN;
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 50, ENV_TERRAIN: TT_HOUSE]) );

  return 1;
}
string _query_int_long()
{
  string txt;

    if ( feuer == AN )
    {
      txt = "Du befindest Dich in der Schmiede von Luifinlas. In der Mitte "
	    "brennt ein grosses Feuer. Hier werden saemtliche Arbeiten mit "
	    "Metall fuer die ganze Stadt erledigt. An den Waenden haengen "
	    "allerlei Werkzeuge, Hufeisen und andere Gegenstaende. Außerdem "
	    "siehst Du einen grossen Amboss, auf dem der Schmied das zu "
	    "verarbeitende Metall formt.";
    }
    else
    {
      txt = "Du befindest Dich in der Schmiede von Luifinlas. In der Mitte "
	    "brennt normalerweise ein grosses Feuer, dass jedoch momentan "
	    "geloescht ist. Hier werden saemtliche Arbeiten mit "
	    "Metall fuer die ganze Stadt erledigt. An den Waenden haengen "
	    "allerlei Werkzeuge, Hufeisen und andere Gegenstaende. Außerdem "
	    "siehst Du einen grossen Amboss, auf dem der Schmied das zu "
	    "verarbeitende Metall formt.";
    }
  return BS(txt);
}

