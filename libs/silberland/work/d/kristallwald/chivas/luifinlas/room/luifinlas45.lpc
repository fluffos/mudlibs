// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Waldweg");
  SetProp( P_INT_LONG,
	"Der Wald ist an dieser Stelle ein wenig lichter als im Osten und "
	"hoert in Richtung Westen ganz auf und scheint auf eine Lichtung zu "
	"muenden. Am Wegrand sind viele Straeucher und Buesche zu sehen. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wald","vergleich"}),
	    "Der Wald nimmt hier ab im Vergleich zum Westen. Die Baeume stehen "
	    "nicht mehr so dicht und hoeren im Osten komplett auf, da dort "
	    "eine Lichtung ist.");

  AddDetail( ({"stelle"}),
	    "Die Baeume sind hier nicht mehr so dicht.");
  
  AddDetail( ({"osten"}),
	    "Im Osten ist eine Lichtung zu sehen.");

  AddDetail( ({"westen"}), 
            "Im Westen ist der Wald dunkler und dichter.");

  AddDetail( ({"lichtung"}),
	    "Auf der Lichtung ist eine grosse Wiese.");

  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand sind verschiedene Straeucher und kleine Buesche zu "
	    "sehen.");

  AddDetail( ({"weg","boden"}),
	    "Am Boden sind Steinchen und Blaetter zu sehen.");
  
  AddDetail( ({"straeucher"}),
	    "Einige Straeucher wachsen zwischen den Baeumen am Wegrand.");

  AddDetail( ({"buesche"}),
	    "Kleine runde Buesche sind am Wegrand zu sehen.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist hier gut zu sehen. Er ist schoen blau.");

  AddDetail( ({"baeume","baeumen","platz"}), 
            "Die Baeume wachsen am Rand nicht mehr so dicht und geben Dir "
	    "genug Platz den Himmel zu sehen.");

  AddDetail( ({"wiese"}),
	    "Auf der Wiese ist Gras zu sehen. Auch viele Blumen stehen dort.");

  AddDetail( ({"steinchen"}),
	    "Die Steinchen sind ueberhaupt nicht interessant.");

  AddDetail( ({"blaetter"}),
	    "Die Blaetter stammen von den Baeumen und sind von ihnen "
	    "abgefallen und hier am Boden gelandet.");
  
  AddDetail( ({"gras"}),
	    "Das Gras ist gruen.");

  AddDetail( ({"blumen","farben"}),
	    "Die Blumen leuchten in den verschiedensten Farben. Geh einfach "
	    "naeher ran und schau sie Dir an.");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen","duft"}),
	   "Der Duft der Blumen stammt von der Wiese.");

  AddSound(DEFAULT_SOUND, "Du hoerst Voegel in den Baeumen zwitschern.");

  AddSound( ({"voegel"}),
	   "*zwitscher*");
  
//-----Details Ende-----
  
AddExit("osten", ROOM "luifinlas44");
AddExit("westen", ROOM "luifinlas46");

}
