// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  AddRoomMessage( ({ "In der Ferne schreit ein Kaeuzchen.\n",
                     "Ein paar Voegel zwitschern hoch oben in den Eichen.\n"}),
                     30, "sound" );

  SetProp( P_INT_SHORT, "An einem Waldrand");
  SetProp( P_INT_LONG,
	"Du stehst an einem Waldrand. Direkt am Weg, auf dem Du Dich "
	"befindest stehen grosse Eichen, Buchen, Tannen und noch einige andere "
	"Baumarten. Auch ein paar Straeucher kannst Du erkennen. Nach Sueden "
	"hin breitet sich vor Dir eine grosse Lichtung aus und nach Norden "
	"geht es weiter in den Wald hinein." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"kaeuzchen"}),
	    "Das Kaeuzchen muss hoch oben in den Wipfeln einer Eiche sitzen. "
	    "Du kannst es nicht sehen, nur hoeren.");

  AddDetail( ({"voegel"}),
	    "Die Voegel sitzen hoch oben in den Baeumen. Du siehst sie von "
	    "hier nicht. ");
  
  AddDetail( ({"waldrand","rand"}),
	    "Du stehst am Rand des Waldes und vor Dir breitet sich in Richtung "
	    "Sueden eine grosse Lichtung aus.");

  AddDetail( ({"weg"}), 
            "Der Weg ist mit Blaettern und Nadeln der umliegenden Baeume "
	    "bedeckt.");

  AddDetail( ({"eichen"}),
	    "Ein paar grosse Eichen stehen am Weg. Eine Eiche faellt Dir "
	    "besonders auf.");

  AddDetail( ({"buchen"}),
	    "Grosse Buchen stehen am Weg und ueberschatten mit ihren Kronen "
	    "den Weg.");

  AddDetail( ({"tannen"}),
	    "Einige Tannen stehen zwischen den verschiedenen Laubbaeumen.");
  
  AddDetail( ({"baumarten","arten","palme"}),
	    "Es gibt unzaehlige Arten hier im Wald. Du findest Eichen, Buchen, "
	    "Tannen und noch viele mehr. Eine Palme wirst Du natuerlich hier "
	    "nicht finden.");

  AddDetail( ({"baeume","baeumen"}),
	    "Viele Baeume stehen am Weg. So soll es in einem Wald auch sein.");
  
  AddDetail( ({"straeucher","dekoration"}),
	    "Einige kleine Straeucher stehen zwischen den Baeumen. Sie sind "
	    "aber nur Dekoration, damit es hier ein wenig schoener aussieht.");

  AddDetail( ({"sueden","lichtung","richtung"}), 
            "Im Sueden liegt eine grosse Lichtung. Geh doch einfach mal hin "
	    "und schau sie Dir an.");

  AddDetail( ({"norden","wald","waldes"}),
	    "Im Norden ist der Wald ein wenig dichter als hier.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen die Blaetter und Nadeln der Baeume.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist von hier aus durch die Kronen der Baeume nicht "
	    "mehr so gut zu sehen. Geh einfach nach Sueden, da ist es besser.");

  AddDetail( ({"wipfel","wipfeln","kronen"}),
	    "Die Kronen bilden ueber Dir ein Blaetterdach. Es ist nicht so "
	    "dicht, dass es dunkel waere, aber sie spenden angenehmen "
	    "Schatten.");

  AddDetail( ({"blaetter","blaettern"}), 
            "Viele Blaetter liegen auf dem Boden. Natuerlich sind noch mehr "
	    "Blaetter an den Baeumen.");

  AddDetail( ({"nadeln"}),
	    "Viele Nadeln sind von den Tannen auf den Boden gefallen.");

  AddDetail( ({"eiche"}),
	    "Die grosse Eiche hat einen riesigen Stamm.");

  AddDetail( ({"laubbaeumen","laubbaeume"}),
	    "Hier gibt es die unterschiedlichsten Laubbaeume im Wald.");
  
  AddDetail( ({"schatten"}),
	    "Der Schatten der Baeume ist sehr angenehm.");

  AddDetail( ({"stamm"}),
	    "Der Stamm wurde leider bei einem Gewitter beschaedigt und in "
	    "der Mitte von einem Blitz gespalten. Trotzdem scheint die Eiche "
	    "nicht eizugehen und strahlt in voller Pracht.");
  
  AddDetail( ({"gewitter","angst"}),
	    "Es kommt sicher jetzt kein Gewitter. Keine Angst.");

  AddDetail( ({"blitz","einschlag"}), 
            "Der Blitz ist in den Stamm der Eiche eingeschlagen und hat ihn "
	    "gespalten.");

  AddDetail( ({"mitte"}),
	    "In der Mitte der Eiche ist ein riesiger Riss zu sehen. Die "
	    "Raender sind schwarz verkohlt.");

  AddDetail( ({"pracht"}),
	    "Viele gruene Blaetter haengen an der Eiche und man merkt ihr den "
	    "Einschlag nicht an.");

  AddDetail( ({"riss","risses"}),
	    "Der Riss zieht sich von oben nach unten durch den Stamm.");
  
  AddDetail( ({"raender"}), 
            "Die Raender sind schwarz verkohlt und da ist noch Etwas.");

  AddDetail( ({"etwas"}),
	    "Ein leichter gruenlicher Schimmer liegt ueber den Raendern des "
	    "Risses.");

  AddDetail( ({"schimmer"}),
	    "Der Schimmer scheint einer starken Magie zu entspringen.");

  AddDetail( ({"magie"}),
	    "Die Magie kommt aus dem unteren Ende des Risses heraus.");

  AddDetail( ({"ende"}),
	    "Am Ende des Risses entdeckst Du einen Stein.");

  AddDetail( ({"stein"}),
	    "Der Stein schimmert farbig und scheint die Eiche mit seiner "
	    "Magie zu heilen. Neben dem Stein ist eine kleine Inschrift in den "
	    "Stamm geritzt.");

  AddDetail( ({"inschrift"}),
	    "Du kannst sie lesen.");

  AddDetail( ({"ferne"}),
	    "Also ist es nicht sehr nah.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach der Baeume ist ueber Dir recht dicht.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddReadDetail( ({"inschrift"}),
	    "Lieber Forscher, bitte lass den Stein hier liegen und nimm ihn \n"
	    "nicht mit. Es ist ein Stein mit grosser Kraft und ich \n"
	    "habe ihn in die Eiche gelegt um sie mit ihm zu heilen. Bei der \n"
	    "Erschaffung des Waldes habe ich aus Versehen einen Blitz \n"
	    "erschaffen, welcher die Eiche verletzt hat. \n"
	    "                                \n"
	    "                      Chivas\n");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Harz.");  
 
  AddSmell( ({"harz","geruch"}),
	   "Dieser Geruch ist ganz normal fuer einen Wald.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Kaeuzchen und verschiedene Voegel.");

  AddSound( ({"kaeuzchen"}),
	   "huuuhuuuu");

  AddSound( ({"voegel"}),
	   "*zwitscher*");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifhd4");
AddExit("sueden", ROOM "luifhd2");

AddCmd( ({"nimm", "nehme" }), "nehmen" );

}
int nehmen(string str)
{
   notify_fail("Was moechtest Du nehmen?\n");
   if ( member( ({ "stein" }),str) != -1) 
  {
    write(BS( "Du probierst den Stein trotz der Inschrift zu nehmen und "
	      "ploetzlich sausst ein grosser Blitz vom Himmel und trifft "
	      "Dich. Du schreist vor Schmerzen. \n"));
    say( TPN+" wird von einem Blitz getroffen und schreit.\n");
    TP->AddHp(-45);
    return 1;
  }
}

