// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Strasse in Luifinlas");
  SetProp( P_INT_LONG,
	"Du stehst vor der noerdlichen Stadtmauer. Die Strasse fuehrt von hier "
	"aus nur nach Sueden. Ansonsten siehst du schoene Haeuser in diesem "
	"Teil der Stadt. Kleine Blumenkaesten haengen unter den Fenstern der "
	"Haeuser." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"stadtmauer","mauer","hoehe","stelle"}),
	    "Die Stadtmauer ragt vor Dir in die Hoehe. An dieser Stelle kommst "
	    "Du nicht auf die Stadtmauer.");

  AddDetail( ({"strasse","sueden"}),
	    "Die Strasse fuehrt von hier aus nach Sueden.");
  
  AddDetail( ({"haeuser"}),
	    "Die Haeuser machen einen gepflegten Eindruck. Die Blumenkaesten "
	    "unter den Fenstern sind mit Blumen bepflanzt.");

  AddDetail( ({"teil","viertel"}), 
            "Es ist eigentlich ein gutes Viertel, in dem Du Dich befindest.");

  AddDetail( ({"stadt"}),
	    "Du bist in einer Stadt.");

  AddDetail( ({"blumenkaesten"}),
	    "In den Blumenkaesten sind natuerlich Blumen zu sehen.");

  AddDetail( ({"fenster","fenstern"}),
	    "Unter den geputzten Fenstern haengen Blumenkaesten.");
  
  AddDetail( ({"boden","steinen","steine"}),
	    "Der Boden besteht aus Steinen, die eine gepflasterte Strasse "
	    "bilden.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau.");
  
  AddDetail( ({"blumen"}),
	    "Du siehst lauter kleine schoene Blumen.");

  AddDetail( ({"eindruck"}), 
            "Hier in den Haeusern, die wohl recht neu sind, kann man sicher "
	    "gut wohnen.");

  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen","duft"}),
	   "Der Duft der Blumen stammt von den Blumen in den Blumenkaesten.");

  AddSound(DEFAULT_SOUND, "Du hoerst die ueblichen Geraeusche der Stadt.");

  AddSound( ({"stadt","geraeusche"}),
	   "Es gibt zu viele Geraeusche um sie hier aufzuzaehlen.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "luifinlas113");
AddExit("osten", ROOM "luifbau10");
AddExit("westen", ROOM "luifbau11");

}
