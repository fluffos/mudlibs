// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Weg ist durch einen Baumstamm in Richtung Nordwesten versperrt. "
	"Der umgekippte Baumstamm hat eine kleine Bresche zwischen die Baeume "
	"geschlagen. Du kannst aber ohne Probleme nach Sueden gehen und "
	"schauen wo der Weg hinfuehrt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"weg","weges"}),
	    "Der Weg fuehrt hier nach Nordwesten und Sueden durch den Wald.");

  AddDetail( ({"nordwesten","richtung"}),
	    "Nach Nordwesten liegt ein grosser Baumstamm ueber den Weg.");
  
  AddDetail( ({"baumstamm","stamm"}),
	    "Der Baumstamm hat eine kleine Bresche in den Wald geschlagen und "
	    "ist hier auf dem Weg gelandet. Du musst wohl ueber in klettern, "
	    "wenn Du nach Nordwesten willst.");

  AddDetail( ({"bresche"}), 
            "Die Bresche ist nicht sehr gross und kleinere Pflanzen wachsen "
	    "dort schon wieder.");

  AddDetail( ({"baeume"}),
	    "Es gibt in diesem Wald wirklich viele Baeume.");

  AddDetail( ({"probleme"}),
	    "Nach Sueden kannst Du ohne Probleme gehen.");

  AddDetail( ({"sueden"}),
	    "Im Sueden ist eine kleine Bruecke zu sehen, die ueber einen "
	    "Bach fuehrt.");
  
  AddDetail( ({"boden"}),
	    "Am Boden siehst Du die ueblichen kleinen Steinchen des Weges.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist hier gut zu sehen. Er ist blau.");
  
  AddDetail( ({"wald"}),
	    "Du bist mitten in einem Wald.");

  AddDetail( ({"pflanzen"}), 
            "Es sind hauptsaechlich junge Baeume.");

  AddDetail( ({"bruecke"}),
	    "Die Bruecke ist im Sueden. Wenn Du mehr sehen willst, dann geh "
	    "einfach hin.");

  AddDetail( ({"bach"}),
	    "Der Bach plaetschert im Sueden durch den Wald.");

  AddDetail( ({"steinchen"}),
	    "Die Steinchen sind nicht sehr wichtig.");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht waldig.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst den Bach im Sueden plaetschern.");

  AddSound( ({"bach"}),
	   "*plaetscher*");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "luifinlas2");

AddCmd( ({"kletter", "klettere" }), "klettern" );

}
int klettern(string str)
{
   notify_fail("Wo moechtest Du drueber klettern?\n");
   if ( member( ({ "ueber baum","ueber baumstamm","ueber stamm" }),str) != -1) 
  {
    write(BS ( "Du kletterst ohne viel Muehe ueber den auf den Weg gefallenen "
               "Baumstamm.\n"));
      TP->move( ROOM "luifinlas86", M_GO, 
      "ueber einen Baumstamm", "klettert", 
      "klettert ueber einen Baumstamm herein");
    return 1;
  }
}

