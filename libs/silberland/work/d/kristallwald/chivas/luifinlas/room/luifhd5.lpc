// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Wald ist nicht sehr dicht und hoert in noerdlicher Richtung ganz "
	"auf. Einige Straeucher sind am Wegrand zu sehen und auch ein paar "
	"groessere Steine liegen am Rand. Im Norden beginnt eine Wiese und "
	"in der Entfernung kannst Du grasbedeckte Huegel erkennen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wald"}),
	    "Der Wald mit seinen Baeumen ist nicht sehr dicht und es ist "
	    "angenehm hier spazieren zu gehen.");

  AddDetail( ({"richtung"}),
	    "In Richtung Norden beginnt eine Wiese.");
  
  AddDetail( ({"straeucher"}),
	    "Kleine und groessere Straeucher wachsen am Rand des Weges auf "
	    "dem Du Dich befindest.");

  AddDetail( ({"wegrand","rand"}), 
            "Am Wegrand stehen Baeume und Straeucher. Auch ein paar groessere "
	    "Steine sind zu sehen.");

  AddDetail( ({"steine","findlinge","urzeiten","findlingen"}),
	    "Die Steine sind grosse Findlinge, die hier sicher schon seit "
	    "Urzeiten liegen. Sie sind teilweise von Moos und Flechten "
	    "bewachsen.");

  AddDetail( ({"norden","wiese","gras"}),
	    "Im Norden ist eine Wiese zu sehen. Das Gras auf ihr steht sehr "
	    "hoch.");

  AddDetail( ({"entfernung","huegel"}),
	    "Auf der Wiese erkennt man in einiger Entfernung grasbedeckte "
	    "Huegel. Um die Huegel besser sehen zu koennen, musst Du schon "
	    "naeher ran gehen.");
  
  AddDetail( ({"boden"}),
	    "Der Boden ist mit kleinen Steinchen und Laub bedeckt.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist besser im Norden zu sehen.");
  
  AddDetail( ({"baeumen","baeume","platz"}),
	    "Die Baeume am Rand stehen nicht sehr dicht und bieten genug "
	    "Platz fuer den Weg und kleinere Straeucher, die dort wachsen.");

  AddDetail( ({"weg","weges"}), 
            "Der Weg fuehrt hier aus dem Wald heraus.");

  AddDetail( ({"moose","moos"}),
	    "Das Moos ist dunkelgruen und hat sich auf den Findlingen "
	    "festgesetzt.");

  AddDetail( ({"flechten"}),
	    "Die Flechten haben sich an den Findlingen festgesetzt und "
	    "gedeihen sehr gut.");

  AddDetail( ({"steinchen"}),
	    "Kleine Steinchen bilden den Weg, auf dem Du Dich befindest.");
  
  AddDetail( ({"laub"}),
	    "Das Laub ist von den Baeumen abgefallen.");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Laub.");  
 
  AddSmell( ({"laub"}),
	   "Das Laub am Boden riecht ein wenig faulig.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel.");

  AddSound( ({"voegel"}),
	   "*triller*");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifhd6");
AddExit("suedwesten", ROOM "luifhd4");

}
