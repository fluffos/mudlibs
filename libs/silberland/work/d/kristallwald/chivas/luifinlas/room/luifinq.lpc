	"unterstuetzen. An der Westwand steht ein Altar, vor dem einige "
	"Personen in langen Kutten knieen und beten." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
