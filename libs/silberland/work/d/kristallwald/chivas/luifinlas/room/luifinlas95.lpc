// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem duesteren Wald");
  SetProp( P_INT_LONG,
	"Die Baeume stehen sehr dicht an dem Weg, auf dem Du Dich befindest. "
	"Einige abgestorbene Aeste haengen wie Finger herunter und scheinen "
	"nach Dir zu greifen. Am Boden sind viele Steine zu sehen und einige "
	"Blaetter, die von den abgestorbenen Aesten abgefallen sind." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"baeume","eindruck","baeumen"}),
	    "Die Baeume stehen dicht um Dich herum und machen einen "
	    "bedrohlichen Eindruck.");

  AddDetail( ({"weg","norden","sueden"}),
	    "Der Weg fuehrt nach Norden oder nach Sueden.");
  
  AddDetail( ({"aeste","finger","aesten"}),
	    "Die Aeste an den Baeumen scheinen nach Dir zu greifen. Viele von "
	    "den Aesten sind abgestorben und haengen herunter.");

  AddDetail( ({"boden","steine","blaetter"}), 
            "Am Boden liegen viele Steine und Blaetter.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist durch das dichte Blaetterdach der Baeume nicht "
	    "zu sehen.");

  AddDetail( ({"blaetterdach","dach","licht"}),
	    "Das Blaetterdach laesst kaum Licht durch und es ist hier recht "
	    "dunkel.");

  AddDetail( ({"wesen"}),
	    "Du kannst keine sehen.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blaettern.");  
 
  AddSmell( ({"blaettern","blaetter"}),
	   "Sie riechen ein wenig modrig.");

  AddSound(DEFAULT_SOUND, "Man hoert vereinzelte Aeste knarren. Ansonsten ist "
		          "es totenstill.");

  AddSound( ({"aeste"}),
	   "Einige Aeste knarren im Wind, obwohl es hier ueberhaupt keinen "
	   "Wind gibt.");

  AddSound( ({"wind"}),
	   "Es gibt hier keinen Wind. Vielleicht eher ein Raunen.");  

  AddSound( ({"raunen"}),
	   "Das Raunen kommt von den Baeumen.");

  AddSound( ({"baeume","baeumen"}),
	   "Man kann ein leises Aechtzen hoeren.");

  AddSound( ({"aechtzen","wesen"}),
	   "Du hoffst, dass das Aechtzen von den Aesten stammt und nicht von "
	   "irgendwelchen Wesen zwischen den Baeumen. Dich friert es.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "luifinlas94");
AddExit("sueden", "/d/kristallwald/chivas/zwergenfeste/room/zww14");

}

