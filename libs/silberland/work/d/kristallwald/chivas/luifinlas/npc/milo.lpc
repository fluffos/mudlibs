#include "../def.h"

inherit "std/npc";


void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Milo Breitfuss, der Wirt");
  SetProp(P_LONG,
    "Milo Breitfuss ist ein kleiner dicker Hobbit mit einem froehlichen "
    "Gesicht. Er hat kurze schwarze Haare und immer ein Laecheln auf den "
    "Lippen."
  );

  SetProp(P_NAME, "Milo Breitfuss");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));

  AddId( ({"milo","breitfuss","wirt"}) );

  create_default_npc(14);
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 110);
  SetProp(P_WEIGHT, 170000);
  SetProp(P_ALIGN, 100);
  SetProp(P_SPELLRATE,30);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz weg");
  AddDetail( ({ "wirt"}),
    "Milo Breitfuss ist hier der Wirt.");
  AddDetail( ({ "hobbit"}),
    "Milo Breitfuss ist ein kleiner Hobbit.");
  AddDetail( ({ "gesicht"}),
    "Er hat ein froehliches Gesicht.");
  AddInfo(DEFAULT_INFO, "Was darf es sein?","fragt Dich: ");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"kneipe","gasthaus","wirtschaft"}),
    "Dies ist mein Wirtshaus. Ich werde noch Filialen im ganzen Silberland "
    "eroeffnen.",
    "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" will Deine Sachen nicht tragen.\n" }) );
  SetAttackChats(10,
    ({Name(WER,1)+" zuernt: Das ist also der Dank!\n"
     })
  );
 SUID;
  CLONEME( "/d/kristallwald/chivas/zentauren/weapon/spiess" );
  command("zuecke spiess");
}

