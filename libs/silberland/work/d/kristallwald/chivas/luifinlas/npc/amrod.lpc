#include "../def.h"

inherit "std/npc";


void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Amrod, der Ladenbesitzer");
  SetProp(P_LONG,
    "Amrod ist der Ladenbesitzer. Er hat sich als Elf hier in Luifinlas "
    "niedergelassen. Er ist gross und sehr duenn und hat grosse blaue "
    "Augen und blonde Haare." );

  SetProp(P_NAME, "Amrod");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));

  AddId( ({"amrod","ladenbesitzer"}) );

  create_default_npc(18);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 190);
  SetProp(P_WEIGHT, 170000);
  SetProp(P_ALIGN, 500);
  SetProp(P_SPELLRATE,25);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz weg");
  AddDetail( ({ "ladenbesitzer"}),
    "Amrod gehoert der Laden.");
  AddDetail( ({ "elf"}),
    "Amrod ist ein Elf.");

  AddInfo(DEFAULT_INFO, "Was darf es sein?","fragt Dich: ");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"laden"}),
    "Dies ist mein Laden, wenn Du etwas willst, dann kauf es, ansonsten "
    "verschwende nicht meine Zeit.",
    "sagt: ");
    
  AddInfo( ({"zeit","inventur"}),
    "Ich habe keine Zeit, die Inventur muss noch gemacht werden.",
    "sagt: ");

  AddSpell(1,300, 
     "Amrod schlaegt Dich Hufen nieder.\n",
     "Amrod schlaegt @WEN nieder.\n",
     ({DT_BLUDGEON}), "schlaegt", ([SP_SHOW_DAMAGE:1]));

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" will Deine Sachen nicht tragen.\n" }) );
  SetAttackChats(10,
    ({Name(WER,1)+" zuernt: Das ist also der Dank!\n"
     })
  );
 SUID;
  CLONEME( "/p/armour/ring/ring" );
  CLONEME( "/p/armour/trousers/lederhose" );
  CLONEME( "/p/armour/boots/lederstiefel" );
  command("trage alles");
}
// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "redet beruhigend auf Dich ein.",
        "beruhigt Dich fluesternd.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schimpft leise auf Dich.",
        "grummelt ueber dich fluesternd.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert leise ueber Dich.",
        "kichert leise.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "wirf Sachen nach Dir.",
        "tritt Dich mit Ihren Hufen.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich guetig an.",
        "laechelt guetig.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "kuschelt Dich zaertlich zurueck.",
        "kuschelt Dich zaertlich.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "fluestert das ihr das sehr gefaellt.",
        "fluestert das ihr das sehr gefaellt.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        TP->Name(WER)+" wird von Arien getroestet.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
  
  
}
void tritt(object enemy, int damage, mixed dam_type)
{
  if (!enemy->QueryProp(P_DISABLE_ATTACK))
    enemy->SetProp(P_DISABLE_ATTACK, 1+random(3));
}

