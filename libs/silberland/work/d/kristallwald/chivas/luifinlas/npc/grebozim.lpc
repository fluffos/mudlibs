#include "../def.h"

inherit "std/npc";


void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Grebozim, der Schmied von Luifinlas");
  SetProp(P_LONG,
    "Grebozim ist der Schmied der Stadt. Er ist fuer einen Zwerg recht gross "
    "und er hat einen muskuloesen Koerper. Sein langer und typischer "
    "Zwergenbart weisst jedoch einige Luecken auf, die sicher durch das Feuer "
    "entstanden sind.");

  SetProp(P_NAME, "Grebozim");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));

  AddId( ({"grebozimt","schmied"}) );

  create_default_npc(28);
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 157);
  SetProp(P_WEIGHT, 170000);
  SetProp(P_ALIGN, 300);
  SetProp(P_SPELLRATE,25);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz weg");

  AddDetail( ({ "schmied","luifinlas"}),
    "Grebozim ist der Schmied von Luifinlas.");

  AddDetail( ({ "gestalt"}),
    "Er ist sehr muskuloes.");

  AddDetail( ({ "bart","stellen","luecken","feuer","schmiede","zwergenbart"}),
    "Der Bart von Borolt ist nicht in dem besten Zustand. Anscheinend fackelt "
    "er ab und zu den Bart an, so dass er einige Luecken hat.");

  AddInfo(DEFAULT_INFO, "Was darf es sein?","fragt Dich: ");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"schmiede"}),
    "Die Schmiede gehoert mir.",
    "sagt: ");
    
  AddInfo( ({"luifinlas"}),
    "Ich schmiede hier alles fuer die Stadt.",
    "sagt: ");

  AddInfo( ({"einwohner","kunden"}),
    "Die Einwohner sind sehr gute Kunden.",
    "sagt: ");

  AddSpell(3,800, 
     "Grebozim schlaegt Dich so hart, so dass Du Sternchen siehst.\n",
     "Grebozim schlaegt @WEN sehr hart.\n",
     ({DT_BLUDGEON}), "schlaegt", ([SP_SHOW_DAMAGE:1]));

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" will Deine Sachen nicht tragen.\n" }) );
  SetAttackChats(10,
    ({Name(WER,1)+" zuernt: Das ist also der Dank!\n"
     })
  );
 SUID;
  CLONEME( "/p/armour/trousers/lederhose" );
  CLONEME( "/p/armour/boots/lederstiefel" );
  CLONEME( "/p/weapon/club/schmiedehammer" );
  command("trage alles");
  command("zuecke hammer");

}
// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "redet beruhigend auf Dich ein.",
        "beruhigt Dich fluesternd.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schimpft leise auf Dich.",
        "grummelt ueber dich fluesternd.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert leise ueber Dich.",
        "kichert leise.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "wirf Sachen nach Dir.",
        "tritt Dich mit Ihren Hufen.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich guetig an.",
        "laechelt guetig.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "kuschelt Dich zaertlich zurueck.",
        "kuschelt Dich zaertlich.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "fluestert das ihr das sehr gefaellt.",
        "fluestert das ihr das sehr gefaellt.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        TP->Name(WER)+" wird von Arien getroestet.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
  
  
}
void schlaegt(object enemy, int damage, mixed dam_type)
{
  if (!enemy->QueryProp(P_DISABLE_ATTACK))
    enemy->SetProp(P_DISABLE_ATTACK, 1+random(3));
}

