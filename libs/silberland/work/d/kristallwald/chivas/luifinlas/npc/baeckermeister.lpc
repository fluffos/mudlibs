#include "../def.h"

inherit "std/npc";


void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Baeckermeister");
  SetProp(P_LONG,
    "Der Baeckermeister steht hinter seinem Tresen und haelt sich seinen "
    "dicken Bauch. Er ist mittelgross fuer einen Menschen und hat schon "
    "ein paar graue Haare. Er macht einen sehr netten und zufriedenen Eindruck "
    "und scheint sehr stolz auf seine Arbeit zu sein.");

  SetProp(P_NAME, "Baeckermeister");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));

  AddId( ({"baecker","meister","baeckermeister"}) );

  create_default_npc(18);
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170);
  SetProp(P_WEIGHT, 170000);
  SetProp(P_ALIGN, 300);
  SetProp(P_SPELLRATE,25);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz weg");
  AddDetail( ({ "baecker","meister","baeckermeister"}),
    "Dem Baecker gehoert der Laden.");
  AddDetail( ({ "bauch"}),
    "Er hat einen ziemlich dicken Bauch. Anscheinend ist er selbst sein "
    "bester Kunde.");
  AddDetail( ({ "haare"}),
    "Er ist nicht mehr der Juengste und hat schon einige graue Haare.");
  
  AddInfo(DEFAULT_INFO, "Was darf es sein?","fragt Dich: ");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"laden"}),
    "Dies ist mein Laden, wenn Du etwas willst, dann verkauf ich es Dir "
    "gerne.",
    "sagt: ");
    
  AddInfo( ({"baeckerei","backladen","laden"}),
    "Tipp einfach 'Zeige' und Du siehst was Du kaufen kannst.",
    "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" will Deine Sachen nicht tragen.\n" }) );
  SetAttackChats(10,
    ({Name(WER,1)+" zuernt: Das ist also der Dank!\n"
     })
  );
 SUID;
  CLONEME( ARMOUR "schuerze" );
  command("trage alles");
}

