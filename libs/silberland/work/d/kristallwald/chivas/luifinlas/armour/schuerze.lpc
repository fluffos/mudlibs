#include "../def.h"

inherit "std/armour";  

void create()
{
  if(!is_clone(this_object())) return;   
                                         

  ::create();

  SetProp(P_SHORT, "Eine Baeckerschuerze");
  SetProp(P_LONG,
    "Eine weisse Baeckerschuerze, auf der sich viel Mehl angesammelt hat."
  );

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Schuerze");
  AddId("schuerze");

  SetProp(P_NAME_ADJ, ({"weiss"}) );

  AddAdjective( ({"weiss","weisse"}) );

  SetProp(P_INFO,
      "Die Schuerze steht Dir sehr gut. Du willst eigentlich sofort "
      "anfangen zu backen.\n");

  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 80);
  SetProp(P_MATERIAL, ([ MAT_CLOTH : 100 ]) );
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);

  SetProp(P_AC, 4);

  SetProp(P_QUALITY_DECAY, 50); 

  SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES);
  SetProp(P_WORN_TEXT, "getragen");
  SetProp(P_WEAR_TEXT, ({ "Du ziehst die Schuerze an.\n",
                          " zieht die Schuerze an.\n" }) );
  SetProp(P_UNWEAR_TEXT, ({ "Du ziehst die Schuerze aus.\n",
                            " zieht die Schuerze aus.\n" }) );
  SetProp(P_TEMPERATURE_PROTECTION,
      ([ T_COLD_PROT:2,T_HEAT_PROT:1 ]) );



}

