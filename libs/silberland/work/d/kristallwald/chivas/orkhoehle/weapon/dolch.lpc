#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(this_object())) return; 
  ::create();

  SetProp(P_SHORT, "Ein verzierter Dolch");
  SetProp(P_LONG,
    "Ein kleiner verzierter Dolch, der sicher gut fuer boesartige magische "
    "Rituale ist."
  );

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Dolch");
  AddId( ({"dolch","\nCHIVASDOLCH" }) );

  SetProp(P_VALUE, 300);
  SetProp(P_WEIGHT, 1500);
  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_DAM_TYPE, DT_BLUDGEON); 
  SetProp(P_WC, 125);
  SetProp(P_WC_BONUS, (["laris": 60,"garlog": 60]) );
  SetProp(P_WC_FIX, 15);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_SIZE, 80);

  AddDetail( ({"verzierungen","runen"}),
	       "Es sind ein paar Runen zu erkennen, die Du nicht verstehst.");
}

