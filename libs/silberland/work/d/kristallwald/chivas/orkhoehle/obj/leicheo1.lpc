inherit "std/thing";    

#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Orkleiche");
  SetProp(P_LONG,
    "Eine verstuemmelte Orkleiche, die langsam anfaengt zu verwesen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Orkleiche");
  SetProp(P_GENDER, FEMALE);
  AddId("orkleiche");
  AddId("leiche");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_WEIGHT, 222250);
  SetProp(P_NOSELL, 1);
  SetProp(P_MATERIAL, ([MAT_MISC:100]));
}
void reset()
{
  ::reset();
  remove();

}

