#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Buch");
  SetProp(P_LONG,
    "Das Buch sieht so aus, als ob es in die Bibliothek gehoert.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Buch");
  SetProp(P_GENDER, NEUTER);
  AddId("buch");
  AddId("\norkbuch");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_PAPER: 100]) );
  SetProp(P_WEIGHT, 20);
  SetProp(P_SIZE, 300);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);


}
