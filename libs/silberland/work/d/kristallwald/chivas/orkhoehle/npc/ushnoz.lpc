#include "../def.h"

inherit "std/npc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ushnoz, der Ladenbesitzer");
  SetProp(P_LONG,
      "Ushnoz ist ein kleiner Ork, der wohl zu schmaechtig ist um mit der "
      "Horde auf Beutezug zu gehen. Aus diesem Grund hat Ushnoz hier einen "
      "Laden eroeffnet und er grinst Dich mit einem unglaublich haesslichen "
      "Laecheln an.");

  SetProp(P_NAME, "Ushnoz");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));

  AddId( ({"ushnoz","ladenbesitzer","besitzer"}) );
 
  create_default_npc(16);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Ork");
  SetProp(P_SIZE, 150);
  SetProp(P_WEIGHT, 1200000);
  SetProp(P_ALIGN, -300);
  SetProp(P_SPELLRATE,25);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "stapft herein");
  SetProp(P_MMSGOUT, "stapft kurz weg");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "%s, Du wirst hier nicht mehr bedient!");
  SetProp(P_KILL_NAME, "Ushnoz");
  SetProp(P_KILL_MSG, "Du hast Dich mit dem falschen Ork angelegt!");

  AddDetail( ({ "orkgesicht","gesicht"}),
    "Das Gesicht ist haesslich wie bei allen Orks.");
  AddDetail( ({ "laecheln"}),
    "Vor dem Laecheln kann man sogar Angst bekommen.");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"laden"}),
    "Dies ist mein Laden. Du kannst hier viel kaufen.",
    "sagt: ");
    
  AddInfo(DEFAULT_INFO, "Was darf es sein? Mit 'Zeige' kannst Du Dir "
		  "anzeigen lassen, was ich hier verkaufe.","fragt Dich: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Ushnoz will Deine Sachen gar nicht haben.\n" }) );

  AddSpell(1,300, 
     "Ushnoz trifft Dich mit seinen stahlharten Faust ins Gesicht.\n",
     "Ushnoz haut @WEN seine Faust mitten ins Gesicht.\n",
     ({DT_BLUDGEON}), "trifft", ([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Ushnoz laechelt Dich an. Jedenfalls versucht er es.\n",
    "Ushnoz raeumt ein paar Waren weg.\n"}) );

  SetAttackChats(10, ({
    "Ushnoz schlaegt Dich .\n"}) );

  SUID;
  CLONEME( "/p/armour/trousers/lederhose" );
  CLONEME( "/p/armour/armour/kettenhemd" );
  command("trage alles");

}

