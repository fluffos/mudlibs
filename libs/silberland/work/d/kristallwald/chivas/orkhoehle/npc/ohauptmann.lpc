#include "../def.h"

inherit "std/npc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Orkhauptmann");
  SetProp(P_LONG,
      "Dr Orkhauptmann ist ein staemmiger Ork, der fuer Recht und Ordnung zu "
      "sorgen hat. Sein runzeliges Orkgesicht ist mit Narben von vielen "
      "Kaempfen uebersaeht. Auch an seinen muskuloesen Armen sind viele alte "
      "und verheilte Schnittwunden zu erkennen.");

  SetProp(P_NAME, "Orkhauptmann");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));

  AddId( ({"orkhauptmann","ork","hauptmann"}) );
 
  create_default_npc(22);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Ork");
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 1200000);
  SetProp(P_ALIGN, 500);
  SetProp(P_SPELLRATE,25);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);

  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "stapft herein");
  SetProp(P_MMSGOUT, "stapft kurz weg");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "%s, Du wirst hier nicht mehr bedient!");
  SetProp(P_KILL_NAME, "Ein Orkhauptmann");
  SetProp(P_KILL_MSG, "Du hast Dich mit dem falschen Ork angelegt!");

  AddDetail( ({ "orkgesicht","gesicht"}),
    "Das Gesicht ist mit vielen Narben uebersaeht. Ausserdem sind die langen "
    "Hauer des Orks zu sehen.");
  AddDetail( ({ "narben","schnittwunden"}),
    "Viele Narben von Kaempfen schmuecken das Gesicht und die Arme.");
  AddDetail( ({ "arme"}),
    "Die Arme sind mit Narben uebersaeht und sind sehr muskuloes.");
  AddDetail( ({ "muskeln"}),
    "Du siehst, dass der Hauptmann sehr stark ist.");
  AddDetail( ({ "hauer","mund"}),
    "Grosse gelbe Hauer ragen aus dem Mund hervor und geben dem Gesicht ein "
    "schreckliches und gefaehrliches Aussehen.");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"kneipe","kneipen"}),
    "Wir habe hier zwei Kneipen.",
    "sagt: ");
    
  AddInfo( ({"ork","orks","kunden"}),
    "Die Orks sind sehr gute Kaempfer.",
    "sagt: ");

  AddInfo(DEFAULT_INFO, "Was lungerst Du hier rum?","fragt Dich: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Okrhauptmann will Deine Sachen gar nicht haben.\n" }) );

  AddSpell(1,300, 
     "Der Hauptmann trifft Dich mit seinen stahlharten Faust ins Gesicht.\n",
     "Der Hauptmann haut @WEN seine Faust mitten ins Gesicht.\n",
     ({DT_BLUDGEON}), "trifft", ([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Der Hauptmann schaut uebel gelaunt in die Runde, ob es irgendwo Aerger "
    "gibt.\n"}) );

  SetAttackChats(10, ({
    "Der Hauptmann schlaegt Dich .\n"}) );

  SUID;
  CLONEME( "/p/weapon/sword/kurzschwert" );
  CLONEME( "/p/armour/armour/lederruestung" );
  CLONEME( "/p/armour/trousers/kettenhose" );
  command("trage alles");
  command("zuecke schwert");

}
// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "lacht Dich aus.",
        "haelt Dich fuer einen Jammerlappen.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schimpft leise auf Dich.",
        "schimpft ueber dich.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert leise ueber Dich.",
        "kichert leise.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "bespritzt Dich mit Bier.",
        "bespritzt Dich mit viel Bier.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "faucht Dich fluesternd an.",
        "faucht fluesternd.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich guetig an.",
        "laechelt guetig.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "will nichts von Dir.",
        "mag diese Naehe nicht und draengt Dich zurueck.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "laechelt ein wenig zoegernd zurueck.",
        "winkt Dir irritiert zu.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        TP->Name(WER)+" wird von Laris getroestet.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
  
  
}
void tritt(object enemy, int damage, mixed dam_type)
{
  if (!enemy->QueryProp(P_DISABLE_ATTACK))
    enemy->SetProp(P_DISABLE_ATTACK, 1+random(3));
}

