inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein normaler Ork");
  SetProp(P_LONG,
    "Der Ork schaut Dich ein wenig feindselig an und leckt ueber seine "
    "gelblichen Hauer. Er ist muskuloes und durchtrainiert, scheint aber "
    "gerade nicht viel zu tun zu haben und lungert nur in den Hoehlen rum.");

  SetProp(P_NAME, "Ork");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));

  AddId( ({"ork"}) );

  create_default_npc(14);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Ork");
  SetProp(P_SIZE, 170);
  SetProp(P_WEIGHT, 170000);
  SetProp(P_ALIGN, -400);
  SetProp(P_SPELLRATE,25);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz weg");

  SetProp(P_MNPC_AREA, ( {ROOM "orks7", ROOM "orks5", ROOM "orks3",
                          ROOM "orks8", ROOM "orks6"}));
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "orks5");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS); 

  AddDetail( ({ "ork"}),
    "Der Ork ist einfach nur haesslich.");
  AddDetail( ({ "hauer"}),
    "Die Hauer sind ekelig gelb.");

  AddInfo(DEFAULT_INFO, "beachtet Dich nicht und geht seinen "
		        "eigenen Dingen nach.");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"orkhoehle","hoehle"}),
    "Die Orkhoehle ist riesig.",
    "sagt: ");

  AddInfo( ({"horde"}),
    "Die Horde ist stark und unbesiegt.",
    "sagt: ");

  SetProp(P_DIE_MSG,  " faellt tot um.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein normaler Ork");
  SetProp(P_KILL_MSG, "Leg Dich nicht mit der Horde an!");


  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das will der Ork nicht haben.\n" }) );

  SetChats(3, ({
          "Der Ork mustert Dich ganz genau.\n",
          "Der Ork waegt Deine Schwaechen ab.\n"}) );

  SetAttackChats(10, ({
    "Der Ork tritt Dich hinterhaeltig.\n",
    "Der Ork haut Dir voller Wut in den Bauch.\n"}) );

 SUID;
  CLONEME( "/p/weapon/sword/kurzschwert" );
  CLONEME( "/p/armour/armour/lederruestung" );
  command("trage alles");
  command("zuecke schwert");
}

