#include "../def.h"

inherit "std/npc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Kragnarr, der Kneipenbesitzer");
  SetProp(P_LONG,
      "Kragnarr ist ein alter Ork, der sich zurueck gezogen hat um diese "
      "Kneipe eroeffnen. Sein runzeliges Orkgesicht ist mit Narben von vielen "
      "Kaempfen uebersaeht. Auch an seinen muskuloesen Armen sind viele alte "
      "und verheilte Schnittwunden zu erkennen.");

  SetProp(P_NAME, "Kragnarr");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));

  AddId( ({"kragnarr","wirt","kneipenbesitzer","besitzer"}) );
 
  create_default_npc(28);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Ork");
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 1200000);
  SetProp(P_ALIGN, 500);
  SetProp(P_SPELLRATE,25);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "stapft herein");
  SetProp(P_MMSGOUT, "stapft kurz weg");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "%s, Du wirst hier nicht mehr bedient!");
  SetProp(P_KILL_NAME, "Kragnarr");
  SetProp(P_KILL_MSG, "Du hast Dich mit dem falschen Ork angelegt!");

  AddDetail( ({ "orkgesicht","gesicht"}),
    "Das Gesicht ist mit vielen Narben uebersaeht. Ausserdem sind die langen "
    "Hauer des Orks zu sehen.");
  AddDetail( ({ "narben","schnittwunden"}),
    "Viele Narben von Kaempfen schmuecken das Gesicht und die Arme.");
  AddDetail( ({ "arme"}),
    "Die Arme sind mit Narben uebersaeht und sind sehr muskuloes.");
  AddDetail( ({ "muskeln"}),
    "Du siehst, dass Kragnarr sehr stark ist.");
  AddDetail( ({ "hauer","mund"}),
    "Grosse gelbe Hauer ragen aus dem Mund hervor und geben dem Gesicht ein "
    "schreckliches und gefaehrliches Aussehen.");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"kneipe"}),
    "Dies ist meine Kneipe.",
    "sagt: ");

  AddInfo( ({"faesschen","fass","heldenbier","krusgor"}),
    "Sowas gibt es hier nicht. Probier es mal bei Krusgor, dem Wirt in der "
    "anderen Schenke.",
    "sagt: ");    
  AddInfo( ({"essen","getraenke"}),
    "Hier gibt es das beste Essen und die leckersten Getraenke.",
    "sagt: ");

  AddInfo( ({"ork","orks","kunden"}),
    "Die Orks sind sehr gute Kunden. Sie sind sehr trinkfest.",
    "sagt: ");

  AddInfo(DEFAULT_INFO, "Was darf es sein? Ein anstaendiges Kampfbraeu?","fragt Dich: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Kragnarr will Deine Sachen gar nicht haben.\n" }) );

  AddSpell(2,500, 
     "Kragnarr trifft Dich mit seinen stahlharten Faust ins Gesicht.\n",
     "Kragnarr haut @WEN seine Faust mitten ins Gesicht.\n",
     ({DT_BLUDGEON}), "trifft", ([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Kragnarr schaut uebel gelaunt in die Runde, ob es irgendwo Aerger gibt.\n",
    "Kragnarr zapft ein Bier und reicht es einem Gast.\n"}) );

  SetAttackChats(10, ({
    "Kragnarr schlaegt Dich .\n"}) );

  SUID;
  CLONEME( "/p/weapon/knife/fleischermesser" );
  command("zuecke messer");
  CLONEME( "/p/armour/trousers/lederhose" );
  CLONEME( "/p/armour/boots/kampfstiefel" );
  CLONEME( "/p/armour/helm/titanhelm" );
  CLONEME( "/d/kristallwald/chivas/zentauren/armour/hemd" );
  command("trage alles");

}

