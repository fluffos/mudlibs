inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein dicker Ork");
  SetProp(P_LONG,
    "Der dicke Ork hat noch ein grosses Huehnerbein zwischen seinen Hauern "
    "haengen und kaut wild darauf rum. Er war sicher schon lange nicht mehr "
    "auf Beutezug, da er mit seinem dicken Bauch der Horde sicher nicht mehr "
    "folgen koennte.");

  SetProp(P_NAME, "Ork");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));

  AddId( ({"ork"}) );

  create_default_npc(14);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Ork");
  SetProp(P_SIZE, 170);
  SetProp(P_WEIGHT, 170000);
  SetProp(P_ALIGN, -400);
  SetProp(P_SPELLRATE,25);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz weg");

  SetProp(P_MNPC_AREA, ( {ROOM "orks12", ROOM "orks11", ROOM "orks14",
                          ROOM "orks8", ROOM "orks9"}));
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "orks11");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS); 

  AddDetail( ({ "ork"}),
    "Der Ork ist unglaublich fett.");
  AddDetail( ({ "bauch"}),
    "Der Ork hat einen richtig fetten Bauch.");
  AddDetail( ({ "hauer","huehnerbein","mund"}),
    "Die Hauer des Orks sind gelblich und ein Huehnerbein schaut ihm aus dem "
    "Mund.");

  AddInfo(DEFAULT_INFO, "beachtet Dich nicht und geht seinen "
		        "eigenen Dingen nach.");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"orkhoehle","hoehle"}),
    "Die Orkhoehle ist riesig.",
    "sagt: ");

  SetProp(P_DIE_MSG,  " faellt tot um.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein dicker Ork");
  SetProp(P_KILL_MSG, "Mit Dir teile ich nicht mein Essen!");


  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das will der fette Ork nicht haben.\n" }) );

  SetChats(3, ({
          "Der fette Ork schaut ob hier irgend was Essbares ist.\n",
          "Der fette Ork schmatzt vor sich hin.\n"}) );

  SetAttackChats(10, ({
    "Der fette Ork schubst Dich zur Seite mit seinem Bauch.\n",
    "Der fette Ork tritt Dir auf den Fuss.\n"}) );

 SUID;
  CLONEME( "/p/weapon/sword/kurzschwert" );
  CLONEME( "/p/armour/armour/lederruestung" );
  command("trage alles");
  command("zuecke schwert");
}

