//erstellt im mai 04 von chivas
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Rorgat, der Orkfuerst");
  SetProp(P_LONG,
    "Rorgat ist der kraeftigste Ork, den Du bisher gesehen hast. Er strahlt eine "
    "grosse Authoritaet aus und begutachtet Dich grimmig. Seine Muskeln sind "
    "ueberall mit Taetowierungen und Narben uebersaeht. Seine gelben Hauer wurden "
    "anscheinend zusaetzlich angespitzt.");
  SetProp(P_NAME, "Rorgat");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId( ({ "rorgat","orkfuerst","ork","fuerst"}) );
  AddId(({"Schwertmeister"}));


  create_default_npc(42);
  SetProp(P_HANDS, ({" mit seinen Haenden" ,150, DT_RIP }) );
  SetProp(P_SIZE, 180 );
  SetProp(P_RACE, "Ork");
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,60);
  SetProp(P_ARTICLE, 0);
  SetProp(P_BODY, QueryProp(P_BODY) * 2);
  SetProp(P_NOMAGIC,30);

  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt die Horde organisierend herein");
  SetProp(P_MMSGOUT, "geht die Horde organisierend weiter");
  
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder %s, dann zerschmettert Dich die Horde!");
  SetProp(P_KILL_NAME, "Rorgat, der Orkfuerst");
  SetProp(P_KILL_MSG, "Wage es nicht noch einmal die Macht der Horde heraus zu fordern!");

  AddDetail( ({ "fuerst", "ork"}),
    "Er ist der Fuerst der Orks.");
  AddDetail( ({ "authoritaet"}),
    "Entweder man hat es oder man hat es nicht.");
  AddDetail( ({ "muskeln"}),
    "Rorgat ist sehr muskuloes.");
  AddDetail( ({ "taetowierungen"}),
    "Rorgat hat sehr viele wiederliche Taetowierungen.");
  AddDetail( ({ "narben"}),
    "Ueberall auf seinem Koerper sind grosse Narben zu sehen, die er sich in "
    "zahllosen Kaempfen verdient hat.");
  AddDetail( ({ "hauer"}),
    "Seine Hauer sind gelblich, aber sie wurden wohl nachtraeglich angespitzt um "
    "gefaehrlicher auszusehen.");

  AddInfo(DEFAULT_INFO, "reagiert nicht auf kleine Abenteurer.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"orkhoehle","hoehle","orkhoehlen","hoehlen"}),
    "In diesen Hoehlen lebt die Horde der Orks. ","sagt: ");

  AddInfo( ({"orks","ork"}),
    "Die Orks sind eine stolze und maechtige Rasse. ","sagt: ");

  AddInfo( ({"fuerst","orkfuerst"}),
    "Ich herrsche ueber die Horde. ","sagt: ");

  AddInfo( ({"horde"}),
    "Die Horde besteht aus vielen starken Kriegern. ","sagt: ");

  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Rorgat will Deine Sachen nicht tragen.\n" }) );

AddSpell(7,750, 
     "Rorgat beherrscht die Magie und schmettert Dir kleine Blitze entgegen.\n",
     "Rorgat zerschmettert @WEN mit der Macht von Blitzen.\n",
     ({DT_LIGHTNING}), ([SP_SHOW_DAMAGE:1]));
AddSpell(3,900, 
     "Rorgat trifft Dich mit all seiner Kraft, so dass Du Sterne siehst.\n",
     "Rorgat trifft @WEN voller Kraft mit seiner Faust.\n",
     ({DT_BLUDGEON}), "tritt", ([SP_SHOW_DAMAGE:1]));
AddSpell(1,1500, 
     "Rorgat schleudert Dir einen riesigen magischen Feuerball entgegen.\n",
     "Rorgat zerschmettert @WEN mit einem riesigen magischen Feuerball.\n",
     ({DT_FIRE,DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );
   
  SetChats(3, ({
    "Rorgat stapft gebieterisch umher.\n",
    "Rorgat erledigt irgendwelche Dinge fuer die Horde.\n",
    "Rorgat gibt einige Befehle.\n"}) );
  SetAttackChats(10, ({
    "Rorgat schlaegt Dich.\n",
    "Rorgat zerreisst Dich.\n"}) );

 SUID;
  CLONEME( "/d/kristallwald/chivas/zentauren/weapon/sternenschwert" );
  CLONEME( "/p/armour/gloves/panzerhandschuhe" );
  CLONEME( "/p/armour/trousers/kettenhose" );
  CLONEME( "/p/armour/armour/titanpanzer" );
  CLONEME( "/p/armour/helm/titanhelm" );
  command("trage alles");
  command("zuecke schwert");

KRIEGERMASTER -> add_wache();

}
void init()
{
  ::init();

 if ( KRIEGERMASTER -> IsWachefeind(TP) ) Kill(TP);

}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;
  
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "haelt Dich fuer ein unwichtiges Wesen, darum reagiert er nicht.",
        "findet Dich uninteressant.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "verflucht Dich.",
        "bewegt seine Haende und entzuendet ein Feuer unter Deinem Hintern.");
        TP->AddHp(-10);
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "haelt Dich einfach nur fuer laestig.",
        "beachtet Dich nicht.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "entzuendet magisch ein kleines Feuer unter Deinen Fuessen.",
        "tritt Dich.");
        TP->AddHp(-10);
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "findet das ekelig.",
        "will Dich nicht mehr sehen.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "verhext Dich sofort.",
        "findet das ekelig.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "findet das ekelig.",
        "will Dich nicht mehr sehen.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "lacht Dich aus.",
        TP->Name(WER)+" wird von Istar ausgelacht.");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
void hilfe()
{
 object hilfe;
 tell_room(ENV(TO), "Ein kleiner Orkdiener stuerzt herein um "
		    "seinen Fuersten zu beschuetzen.\n");
hilfe=clone_object (NPC "ohilfe" );
 hilfe->move(ENV(TO), M_GO|M_NOCHECK);
}

//masterbeginn

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  KRIEGERMASTER -> ruf_um_hilfe(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

void Attack(object enemy)
{
  int i;
  object ob;
  string raum;
  string *raum2;
  mapping exits;
  string *ausgaenge;

  ::Attack(enemy);
   if (!random(15))
    hilfe();

   exits = environment()->QueryProp(P_EXITS);
  ausgaenge = m_indices(exits);
  for ( i = sizeof(ausgaenge)-1; i>=0; i-- )
  {
    if ( !objectp(enemy) ) return;
    raum2 = explode(exits[ausgaenge[i]], "#" );
    raum = raum2[sizeof(raum2)-1];
    for ( ob=first_inventory(raum); ob; ob=next_inventory(ob) )
      if ( living(ob) && !query_once_interactive(ob) &&
           ob->id("orkkrieger","orkfuerst") )
      {
	raum = file_name(ENV(TP));
	ob -> move(raum ,M_TPORT, 0,
          "hoert ein Heulen aus der Ferne und laeuft davon",
	  "kommt rasch herein gelaufen" );
        if ( enemy && ob )
          ob -> Kill(enemy);
        return ::Attack(enemy);
      }
  }
  if (!objectp(enemy)) return;
  for ( ob=first_inventory(environment()); ob; ob=next_inventory(ob) )
    if ( living(ob) && !query_once_interactive(ob) &&
         ob->id("orkkrieger","orkfuerst") )
      ob -> Kill(enemy);
  return ::Attack(enemy);
}

int remove(int arg)
{
  KRIEGERMASTER -> remove_wache(TO);
  return ::remove(arg);

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if ( killer == TO ) KRIEGERMASTER -> Sieg(player);
}

void tritt(object enemy, int damage, mixed dam_type)
{
  enemy->do_damage(-20+random(-20), TO);
  enemy->move(ROOM"orks16", M_GO, "nach Osten", "fliegt",
    "wird hereingeschleudert und schlaegt hart auf");
}

public varargs void die(int pd) {
  object ob;
  if(objectp(ob=present("\nbarden_hero_killquest", QueryProp(P_KILLER)))) {
    ob->Mark();
  }

  ::die(pd);
  return;
}
