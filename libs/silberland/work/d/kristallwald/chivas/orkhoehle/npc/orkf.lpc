inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kraeftige Orkfrau");
  SetProp(P_LONG,
    "Die kraeftige Orkfrau aehnelt im Aussehen kaum ihren maennlichen "
    "Artgenossen. Der einzige Unterschied ist, dass sich die Lederruestung "
    "ein wenig oberhalb des Bauches auswoelbt. Sie ist wundervoll haesslich.");

  SetProp(P_NAME, "Orkfrau");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));

  AddId( ({"ork"}) );

  create_default_npc(16);
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Ork");
  SetProp(P_SIZE, 150);
  SetProp(P_WEIGHT, 170000);
  SetProp(P_ALIGN, -400);
  SetProp(P_SPELLRATE,25);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz weg");

  SetProp(P_MNPC_AREA, ( {ROOM "orks2", ROOM "orks1", ROOM "orks3",
                          ROOM "orks27", ROOM "orks26"}));
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "orks2");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS); 

  AddDetail( ({ "orkfrau"}),
    "Die Orkfrau ist einfach nur haesslich.");
  AddDetail( ({ "hauer"}),
    "Die Hauer sind ekelig gelb.");

  AddInfo(DEFAULT_INFO, "beachtet Dich nicht und geht ihren "
		        "eigenen Dingen nach.");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"orkhoehle","hoehle"}),
    "Die Orkhoehle ist riesig.",
    "sagt: ");

  AddInfo( ({"horde"}),
    "Die Horde ist stark und unbesiegt.",
    "sagt: ");

  SetProp(P_DIE_MSG,  " faellt tot um.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Eine Orkfrau");
  SetProp(P_KILL_MSG, "Frauenpower!");


  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das will die Orkfrau nicht haben.\n" }) );

  SetChats(3, ({
          "Die Orkfrau mustert Dich ganz genau.\n",
          "Die Orkfrau waegt Deine Schwaechen ab.\n"}) );

  SetAttackChats(10, ({
    "Die Orkfrau tritt Dich hinterhaeltig.\n",
    "Die Orkfrau haut Dir voller Wut in den Bauch.\n"}) );

 SUID;
  CLONEME( "/p/weapon/sword/kurzschwert" );
  CLONEME( "/p/armour/armour/lederruestung" );
  command("trage alles");
  command("zuecke schwert");
}

