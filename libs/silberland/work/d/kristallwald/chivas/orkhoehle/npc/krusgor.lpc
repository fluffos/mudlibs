#include "../def.h"

inherit "std/npc";
inherit "/std/player/moneyhandler";
void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Krusgor, der Kneipenbesitzer");
  SetProp(P_LONG,
      "Krusgor ist der Kneipenbesitzer. Er ist ein muskuloeser Ork mit sehr "
      "spitzen Hauern. Er ist unglaublich haesslich und hat eine riesige "
      "Warze auf der Nase.");

  SetProp(P_NAME, "Krusgor");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));

  AddId( ({"krusgor","wirt","kneipenbesitzer","besitzer"}) );
 
  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Ork");
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 1200000);
  SetProp(P_ALIGN, -300);
  SetProp(P_SPELLRATE,25);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "stapft herein");
  SetProp(P_MMSGOUT, "stapft kurz weg");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "%s, Du wirst hier nicht mehr bedient!");
  SetProp(P_KILL_NAME, "Krusgor");
  SetProp(P_KILL_MSG, "Du hast Dich mit dem falschen Ork angelegt!");

  AddDetail( ({ "orkgesicht","gesicht","warze","nase"}),
    "Das Gesicht ist sehr haesslich und er hat eine riesige Warze auf der "
    "Nase.");
  AddDetail( ({ "muskeln"}),
    "Du siehst, dass Krusgor sehr stark ist.");
  AddDetail( ({ "hauer","mund"}),
    "Grosse gelbe Hauer ragen aus dem Mund hervor und geben dem Gesicht ein "
    "schreckliches und gefaehrliches Aussehen.");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"kneipe"}),
    "Dies ist meine Kneipe.",
    "sagt: ");

  AddInfo( ({"faesschen","fass"}),
    "Du kannst hier ein Faesschen Heldenbier erwerben. Es kostet nur 3000 "
    "Muenzen.",
    "sagt: ");    

  AddInfo( ({"essen","getraenke"}),
    "Hier gibt es das beste Essen und die leckersten Getraenke.",
    "sagt: ");

  AddInfo( ({"ork","orks","kunden"}),
    "Die Orks sind sehr gute Kunden. Sie sind sehr trinkfest.",
    "sagt: ");

  AddInfo(DEFAULT_INFO, "Was darf es sein? Ein anstaendiges Heldenbier?","fragt Dich: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Krusgor will Deine Sachen gar nicht haben.\n" }) );

  AddSpell(1,300, 
     "Krusgor trifft Dich mit seinen stahlharten Faust ins Gesicht.\n",
     "Krusgor haut @WEN seine Faust mitten ins Gesicht.\n",
     ({DT_BLUDGEON}), "trifft", ([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Krusgor schaut uebel gelaunt in die Runde, ob es irgendwo Aerger gibt.\n",
    "Krusgor zapft ein Bier und reicht es einem Gast.\n"}) );

  SetAttackChats(10, ({
    "Krusgor schlaegt Dich .\n"}) );

  SUID;
  CLONEME( "/d/kristallwald/chivas/zentauren/weapon/spiess" );
  command("zuecke spiess");
  CLONEME( "/d/kristallwald/chivas/zentauren/armour/hemd" );
  command("trage alles");

  AddCmd( ({"erwerb","erwerbe"}), "erwerben");

}
int erwerben(string str)
{
  object faesschen;
  notify_fail("Was moechtest Du erwerben?\n");

  if ( member( ({ "faesschen","fass","heldenbier","bier"}), str ) != -1 )

  if(TP->QueryMoney() < 3000) 
  {
    tell_object(TP,"Du hast nicht genug Geld dabei.\n");
    return -1;
  }

  faesschen = clone_object( "/d/kristallwald/chivas/dragonquest/obj/faesschen");
  faesschen->move(TP,M_GET|M_SILENT);
  TP->AddMoney(-3000);
  write(BS("Du bezahlst den Wirt, der gierig das Geld einsteckt, Dir "
	   "aber nur zoegerlich ein Faesschen mit Heldenbier gibt.\n"));
  "p/daemon/zentralbank"->PayIn(3000, 100);

  return 1;
}


