
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein grimmiger Orkwaechter");
  SetProp(P_LONG, BS(
    "Der grimmige Orkwaechter sieht sehr gelangweilt aus. Er ist mit Narben "
    "uebersaeht und seine spitzen Hauer sind sehr spitz. Der muskuloese "
    "Koeper zeigt Dir, dass kein einfacher Gegner Dir gegenueber steht."));
  SetProp(P_NAME, "Orkwaechter");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
  AddId(({"orkwaechter","ork","waechter"})); 

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinen Haenden",25,DT_BLUDGEON}));
  SetProp(P_RACE, "Ork");
  SetProp(P_SIZE, 170);
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,3);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.3, DT_COLD:      0.0,  DT_WATER:  0.3, DT_AIR:    0.0, 
      DT_LIGHTNING: -0.2,  DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  -0.2,
      DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.3, DT_TERROR: 0.0,
      DT_HOLY:     0.3,  DT_UNHOLY:    -0.5,  DT_MAGIC:  0.0, DT_MIND:   0.0]));
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " faellt tot um.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Orkwaechter");
  SetProp(P_KILL_MSG, "Wage es nicht, die Horde heraus zu fordern!");

 AddInfo(DEFAULT_INFO, "schaut Dich genervt an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das will der Orkwaechter nicht haben.\n" }) );

  SetChats(3, ({
          "Der Orkwaechter schaut gelangweilt umher.\n",
          "Der Orkwaechter bewacht hier Etwas.\n"}) );

  SetAttackChats(10, ({
    "Der Orkwaechter stoesst Dich um.\n",
    "Der Orkwaechter schlaegt wie ein Berserker auf Dich ein.\n"}) );
  SUID;
  CLONEME( "/p/armour/boots/kampfstiefel" );
  CLONEME( "/p/armour/helm/kampfhelm" );
  CLONEME( "/p/armour/armour/lederruestung" );
  CLONEME( "/p/armour/gloves/kettenhandschuhe" );
  CLONEME( "/p/weapon/spear/kampfspiess" );
  command("trage alles");
  command("zuecke spiess");

WAECHTERMASTER -> add_wache();
  
}

void init()
{
  ::init();

 if ( WAECHTERMASTER -> IsWachefeind(TP) ) Kill(TP);

}

//masterbeginn

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  WAECHTERMASTER -> ruf_um_hilfe(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

void Attack(object enemy)
{
  int i;
  object ob;
  string raum;
  string *raum2;
  mapping exits;
  string *ausgaenge;

  exits = environment()->QueryProp(P_EXITS);
  ausgaenge = m_indices(exits);
  for ( i = sizeof(ausgaenge)-1; i>=0; i-- )
  {
    if ( !objectp(enemy) ) return;
    raum2 = explode(exits[ausgaenge[i]], "#" );
    raum = raum2[sizeof(raum2)-1];
    for ( ob=first_inventory(raum); ob; ob=next_inventory(ob) )
      if ( living(ob) && !query_once_interactive(ob) &&
           ob->id("orkwaechter") )
      {
	raum = file_name(ENV(TP));
	ob -> move(raum ,M_TPORT, 0,
          "hoert ein Heulen aus der Ferne und laeuft davon",
	  "kommt rasch herein gelaufen" );
        if ( enemy && ob )
          ob -> Kill(enemy);
        return ::Attack(enemy);
      }
  }
  if (!objectp(enemy)) return;
  for ( ob=first_inventory(environment()); ob; ob=next_inventory(ob) )
    if ( living(ob) && !query_once_interactive(ob) &&
         ob->id("orkwaechter") )
      ob -> Kill(enemy);
  return ::Attack(enemy);
}

int remove(int arg)
{
  WAECHTERMASTER -> remove_wache(TO);
  return ::remove(arg);

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if ( killer == TO ) WAECHTERMASTER -> Sieg(player);
}

