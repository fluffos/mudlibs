// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Im Anfaengerpark der Orkhoehle");
  SetProp( P_INT_LONG,
	"Die Waende der Hoehle haben einige tiefe Risse und alles ist sehr "
	"feucht hier. Der Boden ist mit lauter Moosen bewachsen und das "
	"Feuer der Fackeln erhellt die Hoehle genug, so dass Du alles genau "
	"erkennen und erforschen kannst." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({""}), 
            "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({"umgebung","geschmack"}),
	    "Die Umgebung entspricht nicht Deinem Geschmack.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "");  
 
  AddSmell( ({""}),
	   "");

  AddSound(DEFAULT_SOUND, "");

  AddSound( ({""}),
	   "");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "orksa3");
AddExit("westen", ROOM "orksa1");


}

