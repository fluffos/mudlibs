// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()

{
  ::create();

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"Der Tunnel ist grob behauen und es liegen lauter grosse Steinbrocken "
	"im Weg. Im Sueden endet der Gang, der nicht fertig ausgebaut aussieht "
	"vor einem grossen vergitterten Tor. An der Seite des Tores steht ein "
	"grosser Tisch mit Stuehlen, wo hoechstwahrscheinlich sich die Wachen "
	"ausruhen, die das Tor bewachen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"tunnel","tunnels"}), 
            "Der Tunnel wurde nicht weiter gegraben. Die Waende sehen noch "
	    "unfertiger aus, als die anderen Tunnel in der Hoehle, die Du "
	    "schon gesehen hast.");

  AddDetail( ({"steinbrocken","brocken"}),
	    "Grosse Steinbrocken liegen am Boden und machen den Weg zu einem "
	    "Hindernislauf. ");

  AddDetail( ({"weg"}),
	    "Der Weg nach Sueden ist durch ein Tor versperrt.");

  AddDetail( ({"sueden","tor","gang","ende","tores"}),
	    "Im Sueden ist ein Tor, welches den weiteren Weg fuer Dich "
	    "versperrt. Das Tor ist verschlossen, aber vielleicht gibt es "
	    "eine Moeglichkeit das Tor zu oeffnen und weiter zu gehen.");
  
  AddDetail( ({"seite"}),
	    "An der Seite neben dem Tor steht ein Tisch und ein paar Stuehle, "
	    "wo sich die Wachen des Tores niederlassen koennen um sich "
	    "auszuruhen.");

  AddDetail( ({"tisch","tisches"}), 
            "Der Tisch ist alt und besteht aus Holz.");

  AddDetail( ({"stuehlen","stuehle"}),
	    "Die Stuehle sind wie der Tisch schon sehr alt und sehen auch "
	    "nicht mehr so stabil aus.");

  AddDetail( ({"wachen"}),
	    "Die Wachen sind normalerweise dafuer zustaendig das Tor "
	    "geschlossen zu halten.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen grosse Steinbrocken.");

  AddDetail( ({"wand","waenden","waende"}), 
            "Die Waende haben lauter Ecken und Kanten. Es sieht so aus, als "
	    "ob die Arbeiten abrupt eingestellt wurden. In der Suedwand ist "
	    "ein Tor.");

  AddDetail( ({"decke","rest"}),
	    "Die Decke ist uninteressant. Schau Dir lieber den Rest des "
	    "Tunnels an.");

  AddDetail( ({"hoehle","orkhoehle"}),
	    "Die Hoehle in der Du stehst gehoert den Orks.");

  AddDetail( ({"hindernislauf"}),
	    "Der Weg scheint sowieso ein Ende in diesem Tunnel zu haben, da "
	    "ein grosses vergittertes Tor den Weg nach Sueden versperrt.");
  
  AddDetail( ({"moeglichkeit"}),
	    "Du musst nur die Moeglichkeit finden.");

  AddDetail( ({"holz"}), 
            "Das Holz ist sehr alt und hat lauter Risse.");

  AddDetail( ({"ecken","kanten"}),
	    "Die Waende haben lauter Ecken und Kanten.");

  AddDetail( ({"suedwand"}),
	    "In der Suedwand ist ein grosses Tor.");

  AddDetail( ({"orks"}),
	    "Die Orks haben das Tor in die Suedwand eingelassen. Anscheinend "
	    "wollen sie nicht, dass Etwas durch das Tor kommt oder das man "
	    "durch das Tor wohin gelangt.");
  
  AddDetail( ({"risse","eingang","schluessel"}),
	    "Falls Du gedacht hast, hier ist der Schluessel, so hast Du Dich "
	    "getaeuscht. Er ist irgendwo in der Orkhoehle zu finden. Als "
	    "kleiner Tip: Er ist wohl in der Naehe vom Eingang.");

  AddDetail( ({"etwas"}), 
            "Das solltest Du genauer erkunden.");

  AddDetail( ({"arbeiten"}),
	    "Die Arbeiten wurden hier eingestellt. Es wurde nur noch das Tor "
	    "im Sueden angebracht.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es ist staubig hier, da die Arbeiten nicht "
		  "beendet wurden.");  
 
  AddSmell( ({"staub"}),
	   "Du musst niesen. Gesundheit.");

  AddSound(DEFAULT_SOUND, "Du hoerst einige Geraeusche hinter dem Tor.");

  AddSound( ({"geraeusche","tor"}),
	   "Probier doch hinter das Tor zu gelangen.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "orks10");
AddExit("osten", ROOM "orks8");

AddItem(NPC "owache", REFRESH_DESTRUCT);
AddItem(NPC "owache", REFRESH_DESTRUCT);

//AddCmd( ({"oeffne" }), "oeffnen" );
NewDoor("sueden",ROOM "orks10",
             ({"tor"}), ({
             D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY | DOOR_CLOSED,
	     D_LONG,   BS("Das Tor im Sueden besteht aus einem grossen Gitter aus "
                         "Eisenstaeben. Durch das Tor kommt man so schnell nicht."),
	     D_GENDER, NEUTER,
	     D_SHORT, "Eine %ses Tor.",
	     D_NAME, "Tor",
	     
              }) );

}

