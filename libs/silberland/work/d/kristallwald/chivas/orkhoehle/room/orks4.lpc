// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"Der Seitengang in dem Du stehst fuehrt Dich nach Sueden in eine "
	"Kammer wo eine unnatuerliche Hitze von ausgeht oder nach Westen zum "
	"Hauptgang zurueck. Auch hier wird der Tunnel von den schon bekannten "
	"Fackeln erhellt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"seitengang"}), 
            "Du befindest Dich in einem schmalen Seitengang. Wie es hier "
	    "aussieht, kommen nicht viele Lebewesen hier vorbei.");

  AddDetail( ({"sueden","kammer"}),
	    "Im Sueden ist eine abschliessende Kammer, von der eine grosse "
	    "Hitze ausgeht. Du kannst auch ein Gluehen aus der Kammer sehen.");

  AddDetail( ({"hitze"}),
	    "Die Hitze ist recht gross und scheint in der Kammer noch groesser "
	    "zu sein.");

  AddDetail( ({"westen","hauptgang"}),
	    "Nach Westen geht es zurueck in den Hauptgang, aus dem Du gekommen "
	    "bist.");
  
  AddDetail( ({"gang"}),
	    "Welchen Gang meinst Du? Den Seitengang oder den Hauptgang?");

  AddDetail( ({"tunnel"}), 
            "Der Tunnel ist ein kleiner Seitengang, der zu einer Kammer "
	    "fuehrt. Es scheint aber so, als ob nicht viele hier vorbei "
	    "kommen.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit Asche bedeckt.");

  AddDetail( ({"decke"}),
	    "Die Decke ist kahl und unglaublich uninteressant. Ausserdem ist "
	    "sie nur ganz dicht ueber Deinem Kopf.");

  AddDetail( ({"waende","wand","waenden","abwechselung"}),
	    "Die Waende sind rauh und nur die Fackeln in ihren Halterungen "
	    "bieten ein wenig Abwechselung.");
  
  AddDetail( ({"fackeln"}),
	    "Die Fackeln huellen den Tunnel in ein schummriges Licht.");

  AddDetail( ({"lebewesen"}), 
            "Damit sind die Orks oder Abenteurer wie Du gemeint.");

  AddDetail( ({"orks"}),
	    "Die Orks wohnen zu hunderten in den Hoehlen.");

  AddDetail( ({"abenteurer"}),
	    "Abenteurer wie Du einer bist, verirren sich sowieso recht selten "
	    "in die Orkhoehlen.");

  AddDetail( ({"hoehlen","orkhoehlen"}),
	    "Die Hoehlen unter der Hochebene gehoeren den Orks. Sie sind "
	    "riesig und man kann sich schnell verlaufen.");
  
  AddDetail( ({"hochebene","gorthad"}),
	    "Die Hoehlen befinden sich unterhalb der Hochebene von Gorthad.");

  AddDetail( ({"gluehen","feuer"}), 
            "Das Gluehen stammt sicher von einem Feuer. Geh einfach mal hin "
	    "und schau es Dir genauer an.");

  AddDetail( ({"asche"}),
	    "Die Asche stammt sicher aus der Kammer.");

  AddDetail( ({"kopf"}),
	    "Pass auf, dass Du Dir den Kopf nicht an der Decke anschlaegst.");

  AddDetail( ({"halterungen","urzeiten"}),
	    "Die Halterungen bestehen nur noch aus Rost. Das Eisen, dass vor "
	    "Urzeiten zu den Halterungen geschmiedet wurde, ist schon lange "
	    "verschwunden.");
  
  AddDetail( ({"licht","probleme"}),
	    "Das Licht erhellt den Tunnel ein wenig, so dass man ohne Probleme "
	    "sehen kann.");

  AddDetail( ({"eisen"}), 
            "Du siehst keine Eisen mehr. Es ist nur noch Rost uebrig.");

  AddDetail( ({"rost","platz"}),
	    "Es ist eigentlich ein Wunder, dass die Fackeln noch von den "
	    "Halterungen an ihrem Platz gehalten werden. Lange werden sie "
	    "das nicht mehr tun.");

  AddDetail( ({"wunder"}),
	    "Wunder gibt es immer wieder. Vor allem hier im Silberland.");

  AddDetail( ({"silberland"}),
	    "Genau dort befindest Du Dich.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Rauch.");  
 
  AddSmell( ({"rauch"}),
	   "Der Rauch kommt aus der Kammer.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Knistern.");

  AddSound( ({"knistern","feuer"}),
	   "Das Knistern stammt anscheinend von einem Feuer aus der Kammer.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "orksch");
AddExit("westen", ROOM "orks3");

}

