// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Der Wind weht ueber das Gras der Hochebene. Du kommst Dir wie in "
	"einem grossen gruenen Meer vor. Ansonsten sind nur die Huegelgraeber "
	"im Osten zu sehen. Ausserdem faellt Dir am Boden Etwas auf." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wind"}), 
            "Der Wind weht ueber die Hochebene von Gorthad.");

  AddDetail( ({"gras"}),
	    "Das gruene Gras bewegt sich leicht im Wind.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Du bist auf der Hochebene von Gorthad.");

  AddDetail( ({"meer"}),
	    "Das war nur symbolisch gemeint. Das richtige Meer ist weit weg.");
  
  AddDetail( ({"huegelgraeber","graebern","graeber","osten"}),
	    "Die Huegelgraeber der Hochebene sind im Osten zu sehen. Viele "
	    "Blumen wachsen auf den Graebern.");

  AddDetail( ({"boden"}), 
            "Am Boden ist Gras und ein Loch zu sehen.");

  AddDetail( ({"etwas","loch"}),
	    "Das Loch ist ziemlich klein und von dieser Seite kommst Du da "
	    "nicht rein.");

  AddDetail( ({"seite"}),
	    "Sicher kann man von der anderen Seite aus dem Loch auf die "
	    "Hochebene klettern.");

  AddDetail( ({"himmel","sonne"}),
	    "Der Himmel ist schoen blau und die Sonne scheint.");
  
  AddDetail( ({"blumen"}),
	    "Viele kleine weisse Blumen wachsen auf den Huegelgraebern im "
	    "Osten.");

  AddDetail( ({""}), 
            "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen der Huegelgraeber duften herrlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind ueber die Hochebene wehen.");

  AddSound( ({"wind"}),
	   "*rausch*");

//-----Details Ende-----
  
AddExit("norden", ROOM "orks10-2");
AddExit("suedwesten", ROOM "orks10-3");


}
