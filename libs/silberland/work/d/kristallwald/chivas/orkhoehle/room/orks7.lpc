// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"Verschiedene Gaenge zweigen von dem Tunnel in dem Du stehst ab. "
	"Drei Tunnel fuehren in Richtung Sueden und einer fuehrt nach Norden "
	"in eine Kneipe, wie Du durch das Schild ueber dem Tunnel erkennen "
	"kannst. Ueberall haengen brennende Fackeln, so dass man sehr gut "
	"sehen kann." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"gaenge","gang"}), 
            "Verschiedene Gaenge zweigen von hier aus nach Sueden. Ein Gang "
	    "fuehrt nach Norden in eine Kneipe.");

  AddDetail( ({"tunnel"}),
	    "Du stehst in einem breiten Tunnel in den Orkhoehlen unterhalb der "
	    "Hochebene von Gorthad.");

  AddDetail( ({"richtung","sueden"}),
	    "In Richtung Sueden zweigen mehrere Gaenge ab.");

  AddDetail( ({"norden","kneipe"}),
	    "Im Norden ist eine Kneipe. Ein Schild haengt ueber dem Gang, der "
	    "nach Norden fuehrt.");
  
  AddDetail( ({"schild"}),
	    "Du kannst das Schild lesen.");

  AddDetail( ({"fackeln"}), 
            "Einige Fackeln haengen in alten Halterungen an den Waenden und "
	    "erhellen den Tunnel in dem Du stehst.");

  AddDetail( ({"boden"}),
	    "Der Boden ist feucht und mit ein wenig Moos bedeckt.");

  AddDetail( ({"decke"}),
	    "Die Decke ist kahl und unglaublich uninteressant.");

  AddDetail( ({"wand","waende","waenden"}),
	    "Die Waende sind nur grob behauen um den Tunnel ein wenig zu "
	    "erweitern. Ansonsten siehst Du nur die Fackeln in ihren alten "
	    "Halterungen.");
  
  AddDetail( ({"orkhoehlen","hoehlen"}),
	    "Du befindest Dich schon tief in den Hoehlen der Orks.");

  AddDetail( ({"hochebene","gorthad"}), 
            "Die Hochebene von Gorthad befindet sich oberhalb der Hoehlen, "
	    "in denen Du Dich gerade befindest.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen sind sehr alt und bestehen fast nur noch aus "
	    "Rost.");

  AddDetail( ({"moos","moose"}),
	    "Einige Moose wachsen am Boden. Das Moos gedeiht recht gut im "
	    "Schein der Fackeln.");

  AddDetail( ({"orks"}),
	    "Viele Orks leben in diesen Hoehlen.");
  
  AddDetail( ({"rost"}),
	    "Das die Halterungen ueberhaupt noch an den Waenden haengen, ist "
	    "ein wahres Wunder.");

  AddDetail( ({"wunder"}), 
            "Es gibt viele Wunder im Silberland.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland und fuehlst Dich sehr wohl hier.");

  AddDetail( ({"schein"}),
	    "Der Schein der Fackeln laesst Dich alles gut erkennen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht eigentlich ganz lecker aus der Kneipe "
		  "im Norden.");  
 
  AddSmell( ({"kneipe","norden"}),
	   "Geh einfach mal hin und iss was.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Gegrunze der Orks aus der Kneipe.");

  AddSound( ({"gegrunze","orks","kneipe"}),
	   "Die Orks unterhalten sich sehr laut in der Kneipe und lachen "
	   "barsch.");
  
  AddReadDetail( ({"schild"}),
		"+--------------------------------------------+\n"
                "|                                            |\n"
                "|           Zum Zwergenschlaechter           |\n"
                "|                                            |\n"
                "+--------------------------------------------+\n");
//-----Details Ende-----
  
AddExit("norden", ROOM "orkschenke1");
AddExit("suedwesten", ROOM "orks8");
AddExit("sueden", ROOM "orks5");
AddExit("suedosten", ROOM "orks3");

}

