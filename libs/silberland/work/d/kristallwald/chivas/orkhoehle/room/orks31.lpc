// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Wald wird ein wenig lichter. Im Sueden ist eine grosse Lichtung, "
        "die genau an der Felswand der Hochebene zu sein scheint. Der Pfad "
        "fuehrt nach Sueden oder tiefer in den Wald nach Norden." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wald"}), 
            "Der Wald um Dich herum wird im Sueden lichter und endet auf "
            "einer grossen Lichtung vor der Felswand.");

  AddDetail( ({"lichtung","sueden"}),
	    "Im Sueden scheint eine grosse Lichtung zu sein. Um mehr zu "
            "erkennen, musst Du schon hingehen.");

  AddDetail( ({"felswand"}),
	    "Die hoehe Felswand gehoert zur Hochebene von Gorthad.");

  AddDetail( ({"hochebene","gorthad","huegelgraebern","huegelgraeber"}),
	    "Du solltest die Hochebene mit ihren Huegelgraebern mal besuchen.");
  
  AddDetail( ({"pfad"}),
	    "Der Pfad fuehrt zwischen den Baeumen auf eine grosse Lichtung im "
            "Sueden.");

  AddDetail( ({"norden"}), 
            "Im Norden fuehrt der schmale Pfad tiefer in den Wald hinein.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist hier besser zu sehen und von Sueden fehlt "
            "Sonnenschein auf den Pfad herein.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen einige Blaetter und Aeste, die von den Baeumen "
            "herunter gefallen sind.");

  AddDetail( ({"baeume","baeumen","moeglichkeit","richtung"}),
	    "Die Baeume zwaengen dem Pfad die Richtung auf. Es gibt keine "
            "Moeglichkeit den Pfad zu verlassen.");
  
  AddDetail( ({"sonnenschein","sonne"}),
	    "Der Sonnenschein der Sonne waermt Dich ein wenig.");

  AddDetail( ({"blaetter"}), 
            "Die Blaetter am Boden liegen hier schon sehr lange und sind "
            "dabei zu vermodern.");

  AddDetail( ({"aeste"}),
	    "Die Aeste liegen hier schon laenger. Auf ein paar Aesten hat "
            "sich auch schon ein wenig Moos gebildet.");

  AddDetail( ({"moos"}),
	    "Das Moos ist schoen gruen.");

  AddDetail( ({"zweige","zweigen"}),
	    "Baeume haben viele Zweige.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Wald.");  
 
  AddSmell( ({"wald"}),
	   "Es duftet nach Baeumen.");

  AddSmell( ({"baeume","harz"}),
	   "Die Baeume riechen harzig.");
  
  
  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel in den Zweigen der "
                          "Baeume zwitschern.");

  AddSound( ({"voegel"}),
	   "*tschip*triller*tschip*");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "orks30");
AddExit("sueden", ROOM "orks32");


}

