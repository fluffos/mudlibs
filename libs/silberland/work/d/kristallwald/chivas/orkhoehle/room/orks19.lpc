// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"Du stehst in einer runden Kammer, die natuerlichen Ursprungs ist. "
	"In der Kammer herrscht ein heilloses Chaos. Ueberall liegen alte "
	"verrostete Ruestungsteile, Waffen und zerbrochene Knochen herum. "
	"Anscheinend wurden ein paar Eindringlinge von den Orks bis in diese "
	"Kammer ohne Ausweg gehetzt und dann gnadenlos niedergemetzelt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 0 );

//-----Details Anfang-----
  
  AddDetail( ({"kammer","ursprungs","ursprung","jahre"}), 
            "Die Kammer in der Du stehst ist natuerlichen Ursprungs. Es "
	    "herrscht ein absolutes Durcheinander in der Kammer, welches "
	    "jedoch schon Jahre her ist, da alles von einer dicken "
	    "Staubschicht bedeckt ist. Nur in der Ecke sieht es wenig "
	    "anders aus.");

  AddDetail( ({"chaos","durcheinander"}),
	    "Ueberall liegen verrostete Ruestungsteile herum. Waffen liegen "
	    "zerborsten am Boden und einige Knochen sind zu sehen.");

  AddDetail( ({"ruestungsteile","ruestungen","leder"}),
	    "Die Ruestungen sind verrostet und das Leder an den Ruestungen "
	    "verrottet.");

  AddDetail( ({"waffen"}),
	    "Die Waffen am Boden sind rostig und zerborsten. Sie sind absolut "
	    "unbrauchbar und Du laesst sie liegen.");
  
  AddDetail( ({"knochen"}),
	    "Einige Knochen die teilweise zerbrochen oder durchtrennt sind, "
	    "liegen am Boden und gehoeren sicher den Eindringlingen, die hier "
	    "von den Orks niedergemetzelt wurden. ");

  AddDetail( ({"eindringlinge","eindringlingen","ende","rest"}), 
            "Einige Eindringlinge sind wohl vor Jahren in die Orkhoehlen "
	    "eingedrungen um der Horde den das Handwerk zu legen. Es sieht so "
	    "aus, als ob die Mission gescheitert ist und der klaegliche Rest "
	    "sich bis hier her retten konnte. Dann kam das unruehmliche Ende.");

  AddDetail( ({"orks"}),
	    "Hunderte von Orks leben in diesen Hoehlen.");

  AddDetail( ({"ausweg"}),
	    "Aus dieser Kammer gibt es nur einen einzigen Ausweg.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen lauter alte Ruestungen und Waffen. Ausserdem "
	    "ist alles von einer dicken Staubschicht bedeckt.");
  
  AddDetail( ({"waende","wand","waenden"}),
	    "Die Waende sind kahl und unbehauen. Die Hoehle ist natuerlichen "
	    "Ursprungs.");

  AddDetail( ({"decke","kopf"}), 
            "Die Decke ist knapp ueber Deinem Kopf. Pass auf und stoss Dich "
	    "nicht.");

  AddDetail( ({"staubschicht","staub"}),
	    "Es liegt eine dicke Staubschicht ueber allem. Nur in der Ecke "
	    "scheint kein Staub zu liegen. Kaum wahrnehmbare Abdruecke fuehren "
	    "in die Ecke und aus ihr heraus.");

  AddDetail( ({"ecke"}),
	    "In einer Ecke liegt ueberhaupt kein Staub. Statt dessen liegt "
	    "dort ein recht neuer Rucksack und eine Matte auf der man schlafen "
	    "kann. Was fuer ein Wesen hat sich hier wohl niedergelassen?");

  AddDetail( ({"mission"}),
	    "Die Mission ist wohl gescheitert, da die Orks noch immer in "
	    "diesen Hoehlen leben.");
  
  AddDetail( ({"horde"}),
	    "Die Horde der Orks terrorisiert die Gegend um die Hochebene.");

  AddDetail( ({"handwerk","meucheln","morden","rauben"}), 
            "Das Handwerk der Orks besteht aus Meucheln, Morden und Rauben.");

  AddDetail( ({"orkhoehlen","orkhoehle","hoehle","hoehlen"}),
	    "Die Orkhoehlen befinden sich unterhalb der Hochebene von "
	    "Gorthad.");

  AddDetail( ({"abdruecke","spuren"}),
	    "Die Abdruecke sind kaum zu sehen. Der Besitzer der Abdruecke muss "
	    "sehr geuebt sein, keine Spuren zu hinterlassen.");

  AddDetail( ({"wesen","besitzer"}),
	    "Anscheinend versteckt sich hier ein Spion in der Kammer, der die "
	    "Orks ausspioniert. Momentan ist er nicht hier. Vielleicht "
	    "entdeckst Du ihn irgendwo in den Hoehlen. Er hat sich aber sicher "
	    "gut versteckt.");
  
  AddDetail( ({"gegend","hochebene","gorthad"}),
	    "Die Hochebene von Gorthad befindet sich oberhalb der Orkhoehle.");

  AddDetail( ({"spion","feinde","feinden","informationen","elfen"}), 
            "Der Spion gehoert sicher zu den Elfen, da die Abdruecke im Staub "
	    "kaum zu sehen sind und nur Elfen so schleichen koennen. Er "
	    "verhilft den Feinden der Orks zu wichtigen Informationen.");

  AddDetail( ({"rucksack"}),
	    "Der Rucksack ist mit Lebensmitteln gefuellt und ein paar "
	    "persoenlichen Dingen.");

  AddDetail( ({"matte"}),
	    "Auf der Matte ruht sich der Besitzer sicher aus, wenn er wieder "
	    "aus den Orkhoehlen in sein Versteck zurueck kehrt.");

  AddDetail( ({"versteck"}),
	    "Es ist ein gutes Versteck, da seit Jahren niemand hier war.");
  
  AddDetail( ({"lebensmitteln","lebensmittel"}),
	    "Du laesst die Lebensmittel lieber liegen, schliesslich gehoeren "
	    "sie Dir ja nicht.");

  AddDetail( ({"dinge","dingen"}), 
            "Die Dinge sind zu persoenlich um hier jetzt aufgezaehlt zu "
	    "werden.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht staubig.");  
 
  AddSmell( ({"staub"}),
	   "*hatschie*");

  AddSound(DEFAULT_SOUND, "Es herrscht eine Totenstille.");

  AddSound( ({"totenstille"}),
	   "Du willst die Totenstille noch sehr lange nicht hoeren.");
  
//-----Details Ende-----
  
AddExit("nordosten", ROOM "orks9");

}

