// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Pfad fuehrt nach Westen und nach Suedosten durch den Wald. Die "
        "Baeume und Straeucher geben Dir nicht die Moeglichkeit vom Pfad "
        "abzuweichen. Es ist recht duester, da das dichte Blaetterdach kaum "
        "Licht durchlaesst." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"pfad"}), 
            "Der Pfad schlaengelt sich durch die Baeume des Waldes. Es gibt "
            "keine Moeglichkeit ihn zu verlassen.");

  AddDetail( ({"westen"}),
	    "Im Westen scheint der Pfad vor einem grossen Strauch abrupt zu "
            "enden.");

  AddDetail( ({"suedosten"}),
	    "Der Pfad fuehrt nach Suedosten in den Wald hinein.");

  AddDetail( ({"wald"}),
	    "Du stehst mitten in einem Wald. Leider erkennst Du ihn vor lauter "
            "Baeumen kaum.");
  
  AddDetail( ({"baeume","baeumen"}),
	    "Grosse Baeume saeumen den Pfad und draengen ihm und Dir die "
            "Richtung auf.");

  AddDetail( ({"straeucher"}), 
            "Kleine und mittelgrosse Straeucher stehen zwischen den grossen "
            "Baeumen. Sie sind jedoch nicht besonders interessant.");

  AddDetail( ({"moeglichkeit"}),
	    "Es gibt keine Moeglichkeit fuer Dich den Pfad zu verlassen.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach ist sehr dicht und laesst nur wenig Licht auf "
            "den Boden fallen.");

  AddDetail( ({"licht"}),
	    "Licht gibt es hier kaum.");
  
  AddDetail( ({"blaetter","blaettern"}),
	    "Die Blaetter der Baeume verdecken den Himmel. Einige liegen auch "
            "auf dem Boden und vergammeln auf dem Pfad.");

  AddDetail( ({"boden"}), 
            "Auf dem festgestampften Pfad siehst Du natuerlich Erde. Ausserdem "
            "sind ein paar Blaetter zu sehen, die auf dem Pfad langsam vor "
            "sich hingammeln. Einige Steine sind zwischen den Blaettern zu "
            "erkennen.");

  AddDetail( ({"strauch"}),
	    "Ueberall stehen Straeucher zwischen den Baeumen herum. Nur im "
            "Westen ist ein besonders grosser Strauch zu sehen. Wenn Du ihn "
            "naeher untersuchen willst, dann musst Du schon hingehen.");

  AddDetail( ({"richtung"}),
	    "Du kannst nach Westen oder Suedosten gehen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel versteckt sich irgendwo hinter dem dichten "
            "Blaetterdach.");
  
  AddDetail( ({"steine"}),
	    "Es gibt grosse und kleine Steine auf dem Boden.");

  AddDetail( ({"grosse steine"}), 
            "Die grossen Steine sind nicht sehr interessant.");

  AddDetail( ({"kleine steine"}),
	    "Die kleinen Steine sind eigentlich noch uninteressanter als die "
            "grossen Steine, aber danke, dass Du geforscht hast. ;)");

  AddDetail( ({"nase"}),
	    "Du hast eine sehr grosse Nase.");

  AddDetail( ({"erde"}),
	    "Die Erde ist sehr festgetrampelt. Anscheinend wird dieser Pfad "
            "von vielen Abenteurern und anderen Wesen genutzt.");
  
  AddDetail( ({"wesen"}),
	    "Du kannst momentan keine anderen Wesen erkennen.");

  AddDetail( ({"abenteurer","abenteurern"}), 
            "Abenteurer wie Du und Du.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht sehr nach Wald.");  
 
  AddSmell( ({"wald","duft"}),
	   "Ein waldiger Duft weht Dir um die Nase.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel.");

  AddSound( ({"voegel"}),
	   "Du hoerst die Voegel ein wenig voegeln, denkst Dir aber dabei "
           "nichts schlimmes.");
  
//-----Details Ende-----
  
AddExit("suedosten", ROOM "orks30");
AddExit("westen", ROOM "orks28");

}

