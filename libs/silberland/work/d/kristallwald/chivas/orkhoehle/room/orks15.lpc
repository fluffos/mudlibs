// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"An den Waenden haengen saubere staehlernde Halterungen fuer die "
	"Fackeln, die den Gang ein wenig erhellen. Die Waende sind glatt und "
	"nicht wie sonst grob behauen. Nach Norden fuehrt der Gang in eine "
	"grosse Kammer. Eigentlich kann man sogar von einer grossen Halle "
	"reden." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"waenden","waende","wand"}), 
            "Die Waende sind ein wenig glatt gehauen und nicht so grob wie "
	    "sonst in den Orkhoehlen.");

  AddDetail( ({"halterungen","zwergenstahl"}),
	    "Die Halterungen sind aus Zwergenstahl und wurden sicher von den "
	    "Orks irgendwo geraubt. In ihnen stecken brennende Fackeln.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln flackern und erhellen den Gang.");

  AddDetail( ({"gang"}),
	    "Der Gang fuehrt nach Norden in eine Kammer.");
  
  AddDetail( ({"norden","kammer","halle"}),
	    "Im Norden ist eine Kammer zu sehen, die wohl eher eine grosse "
	    "Halle ist. Geh doch mal hin und schau sie Dir an.");

  AddDetail( ({"boden"}), 
            "Am Boden ist nur Dreck zu sehen und er ist ein wenig feucht wie "
	    "in der ganzen Hoehle.");

  AddDetail( ({"decke"}),
	    "Von der Decke haengen ein paar Stalagtiten.");

  AddDetail( ({"orkhoehle","orkhoehlen","hoehle","hoehlen"}),
	    "Du befindest Dich in den Orkhoehlen unterhalb der Hochebene von "
	    "Gorthad.");

  AddDetail( ({"stalagtiten","jahre"}),
	    "Die Stalagtiten brauchen noch ueber tausend Jahre, bis sie den "
	    "Boden erreicht haben.");
  
  AddDetail( ({"hochebene","gorthad"}),
	    "Die Hochebene von Gorthad befindet sich ueber den Orkhoehlen.");

  AddDetail( ({"dreck"}), 
            "Der Dreck besteht hauptsaechlich aus Unrat und ein paar Knochen.");

  AddDetail( ({"unrat"}),
	    "Du willst eigentlich gar nicht wissen, was es fuer ein Unrat ist, "
	    "er stinkt jedenfalls erbaermlich.");

  AddDetail( ({"knochen"}),
	    "Die Knochen sind sauber abgenagt.");

  AddDetail( ({"orks"}),
	    "Die Orks hausen zu in diesen Hoehlen.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Unrat.");  
 
  AddSmell( ({"unrat"}),
	   "Der Unrat stinkt erbaermlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst Lachen und Gespraeche aus dem Norden.");

  AddSound( ({"norden","gespraeche","lachen"}),
	   "Um mehr zu hoeren, musst Du weiter nach Norden gehen.");
  
//-----Details Ende-----
  
AddExit("nordosten", ROOM "orks14");
AddExit("norden", ROOM "orks16");

}
