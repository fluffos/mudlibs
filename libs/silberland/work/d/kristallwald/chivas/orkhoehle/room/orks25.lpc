// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"Diese Kammer ist groesser als die anderen Schlafstaetten der Orks. "
	"An den Waenden stehen Hochbetten, in denen mehrere Orks Platz haben. "
	"Zwischen den Hochbetten haengen brennende Fackeln und Halterungen "
	"fuer Waffen an den Waenden." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"kammer","platz","schlafen"}), 
            "In der Kammer stehen lauter Hochbetten, in denen viele Orks "
	    "Platz zum Schlafen finden.");

  AddDetail( ({"schlafstaetten","kammern"}),
	    "Die anderen Kammern sind kleiner. Hier dagegen koennen viele Orks "
	    "uebernachten.");

  AddDetail( ({"orks"}),
	    "Die Orks wohnen in diesen Hoehlen.");

  AddDetail( ({"wand","waende","waenden"}),
	    "An den Waenden stehen viele Hochbetten, in denen die Orks "
	    "schlafen koennen. Ausserdem siehst Du Halterungen fuer die "
	    "Waffen der Krieger.");
  
  AddDetail( ({"hochbetten","betten","dutzend"}),
	    "In den Hochbetten in dieser Kammer haben ein paar Dutzend Orks "
	    "Platz zum Schlafen.");

  AddDetail( ({"fackeln"}), 
            "Die Fackeln haengen in Haltern an den Waenden und erhellen die "
	    "grosse Kammer.");

  AddDetail( ({"halterungen","gegend"}),
	    "Die Halterungen sind dafuer da, dass die Orks ihre Waffen dort "
	    "einhaengen, damit sie nicht einfach so in der Gegend rumliegen.");

  AddDetail( ({"waffen"}),
	    "Momentan befinden sich keine Waffen in den Halterungen. Die Orks "
	    "sind sicher unterwegs auf einem Raubzug.");

  AddDetail( ({"boden"}),
	    "Der Boden ist sehr dreckig und viele Stiefelabdruecke sind zu "
	    "sehen.");
  
  AddDetail( ({"decke"}),
	    "Die Decke ist nur grob behauen, so dass man nach oben hin genug "
	    "Platz fuer die Hochbetten hat.");

  AddDetail( ({"hoehlen"}), 
            "Die Hoehlen sind sehr weitlaeufig. Hier in der Kammer schlafen "
	    "die Orks.");

  AddDetail( ({"krieger","metzeln","hause"}),
	    "Die Krieger der Orks brauchen auch ab und zu Ruhe, wenn sie "
	    "abends vom Metzeln nach Hause kommen.");

  AddDetail( ({"haltern","halter"}),
	    "In den alten rostigen Haltern haengen einige Fackeln, die die "
	    "Kammer mit ihrem Schein erhellen.");

  AddDetail( ({"raubzug"}),
	    "Ein Raubzug der Orks kann ein paar Tage dauern. Es kommt ganz "
	    "darauf an, ob sie nur die Umgebung der Hochebene unsicher machen "
	    "oder sogar bis Roch Adan wandern um die Zentauren anzugreifen.");
  
  AddDetail( ({"stiefelabdruecke","abdruecke","stiefel"}),
	    "Die Abdruecke der Stiefel am Boden sind sehr matschig. Es passt "
	    "wohl keiner darauf auf, dass die Stiefel vorher ausgezogen "
	    "werden.");

  AddDetail( ({"schein"}), 
            "Der Schein der Fackeln erhellt die grosse Kammer, so dass Du "
	    "alles gut erkennen kannst.");

  AddDetail( ({"roch","adan","roch adan","zentauren","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren. Sie befindet sich weit "
	    "suedlich von den Hoehlen der Orks.");

  AddDetail( ({"umgebung","hochebene","gorthad"}),
	    "Die Umgebung der Hochebene von Gorthad ist nur von Zwergen "
	    "bewohnt.");

  AddDetail( ({"zwerge"}),
	    "Die Zwerge bewohnen die Zwergenfeste von Ardhmir.");
  
  AddDetail( ({"zwergenfeste","ardhmir"}),
	    "Die Zwergenfeste von Ardhmir ist gut bewacht und die Orks "
	    "greifen sie nur im Notfall an, da die Zwerge sich sehr gut "
	    "verteidigen koennen und nicht vor den Orks davonlaufen.");

  AddDetail( ({"notfall","hunger"}), 
            "Die Orks greifen nur selten die Zwergenfeste an. Ein Notfall "
	    "waere grosser Hunger. Ansonsten probieren sie es zu vermeiden.");

  AddDetail( ({"ruhe"}),
	    "Du brauchst auch ab und zu Ruhe.");

  AddDetail( ({"tage"}),
	    "Ein anstaendiger Raubzug ist nicht so schnell vollbracht.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es stinkt wie ueberall in den Hoehlen der Orks.");  
 
  AddSmell( ({"hoehlen","geruch"}),
	   "Dir wird bei dem Geruch schlecht.");

  AddSound(DEFAULT_SOUND, "Du hoerst nichts, da momentan keiner der Orks hier "
		  "schlaeft und schnarcht.");

//-----Details Ende-----
AddItem(NPC "orkk", REFRESH_DESTRUCT);

AddExit("nordwesten", ROOM "orks22");

}

