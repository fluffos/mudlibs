// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Pfad schlaengelt sich durch die dicht stehenden Baeume des "
        "Waldes. Waere der Pfad nicht so ausgetrampelt und dadurch so gut "
        "sichtbar, koennte man sich hier sicher sehr gut verlaufen und nie "
        "wieder heraus finden." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"pfad","richtung","pfades"}), 
            "Der Pfad schlaengelt sich zwischen den Baeumen durch und ist "
            "ziemlich ausgetrampelt.");

  AddDetail( ({"baeume","baeumen"}),
	    "Die grossen Baeume draengen dem Pfad die Richtung auf. Ein Baum "
            "faellt Dir jedoch besonders auf.");

  AddDetail( ({"waldes","wald"}),
	    "Der Wald ist um Dich herum.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit ein paar Blaettern und Aesten der Baeume "
            "bedeckt. Ansonsten ist der Boden sehr ausgetrampelt.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel und die Sonne sind durch das dichte Blaetterdach "
            "der Baeume kaum zu sehen.");

  AddDetail( ({"baum","stamm"}), 
            "Am Stamm von einem Baum ist eine Inschrift eingeritzt.");

  AddDetail( ({"blaettern","blaetter"}),
	    "Es sind lauter Blaetter an den Baeumen und ein paar am Boden.");

  AddDetail( ({"aesten","aeste"}),
	    "Es gibt viele Aeste in einem Wald. Es ist kaum zu glauben.");

  AddDetail( ({"sonne"}),
	    "Die Sonne ist kaum zu erkennen.");
  
  AddDetail( ({"inschrift"}),
	    "Du kannst die Inschrift lesen.");

  AddDetail( ({"blaetterdach","dach"}), 
            "Das Blaetterdach der Baeume ist sehr dicht und laesst nur wenig "
            "Licht hindurch.");

  AddDetail( ({"sueden"}),
	    "Der Pfad fuehrt weiter nach Sueden.");

  AddDetail( ({"licht"}),
	    "Es gibt genug Licht um alles sehen zu koennen.");

  AddDetail( ({"warnung","warnungen"}),
	    "Warnungen sollte man normalerweise ernst nehmen.");
  
  AddDetail( ({"gefahr","vorname"}),
	    "Gefahr ist Dein zweiter Vorname.");

  AddDetail( ({"blumen","rand"}), 
            "Ein paar kleine blaue Blumen stehen am Rand des Pfades.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig nach Blumen.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen duften gut.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel zwitschern.");

  AddSound( ({"voegel"}),
	   "*zwitscher*");
  
  AddReadDetail( ({"inschrift"}),
		"Es scheint eine Warnung zu sein, es steht am Stamm folgendes "
                "geschrieben: Weiter im Sueden lauert Gefahr, gehe nicht "
                "weiter.");


//-----Details Ende-----
  
AddExit("nordwesten", ROOM "orks29");
AddExit("sueden", ROOM "orks31");


}

