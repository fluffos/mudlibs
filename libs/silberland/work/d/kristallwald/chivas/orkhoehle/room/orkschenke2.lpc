inherit "std/pub";

#include "../def.h"
#include <pub.h>


void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp(P_INT_SHORT,"In der Kneipe 'Zum Elfenmetzler'");
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "krusgor");
  SetProp(P_PUBKEEPER_NAME, "krusgor");
  SetProp(P_PUBMSG_NOKEEPER, "Krusgor ist leider nicht hier.\n");
  SetProp(P_PUBMSG_NOENEMY, BS(
      "Du bist gerade in einem verbissen Kampf mit Krusgor. Kein Wunder, "
      "dass er Dich nicht bedient."));
  SetProp(P_PUBMSG_NOINVITE, BS(
      "Krusgor kaempft. Da hat er wahrhaft andere Sorgen als Kunden."));
  SetProp(P_PUBMSG_FIGHTING, "Krusgor kaempft gerade.\n");

  AddDrink("Orkisches Heldenbier", ({"orkisches heldenbier","heldenbier","bier"}),
           400, 55, 10, 6,
           ({"Kragnarr laechelt und bringt Dir ein grosses Glas orkisches "
	    "Heldenbier Es schmeckt sehr schal, aber was hast Du erwartet.\n",
             "&& trinkt ein grosses Glas Heldenbier.\n"}));

  AddDrink("Feuergrog", ({"feuergrog","grog"}),
            220, 28, 11, 1,
           ({"Krangnarr bringt Dir ein Glas Feuergrog.\n"
            +"ROECHEL!!!! Der hat es in sich!!\n",
             "&& trinkt ein Glas Feuergrog japst nach Luft.\n"}));

  AddDrink("Elfenblut", ({"elfenblut","blut"}),
            150, 15, 0, 5,
           ({"Krangnarr bringt Dir ein Glas Elfenblut.\n"
            +"Der schmeckt ja richtig lecker!\n",
             "&& trinkt eine Glas Elfenblut und leckt sich die blutigen "
	     "Lippen.\n"}));

  AddFood("Wurstsuppe", ({"suppe", "wurstsuppe"}), 200, 40, 17,
           ({"Krangnarr bringt Dir eine leckere Wurstsuppe. "
            +"\nHmmmm, die ist lecker und sehr deftig.\n",
             "&& isst eine herzafte Wurstsuppe.\n"}));
  AddFood("Ein Elfenbraten", ({"elfenbraten","braten"}), 250, 30, 10,
           ({"Krangnarr bringt Dir ein grosses Tablett mit einem halben "
	     "Elfen!\n"
            +BS("Wow, die Haut ist sehr knusprig. Der Elf ist "
		"aussergewoehnlich lecker. Du koenntest Dich daran gewoehnen."),
             "&& isst gierig einen knusprigen Elfen!\n"}));

// ----------  Details  ---------------------

  AddDetail( ({"kerzen"}),
	    "Die Kerzen brennen in den Leuchtern und erhellen die Kneipe.");

  AddDetail( ({"hoehle"}),
	    "Diese Hoehle wird als Kneipe von den Orks benutzt.");
  
  AddDetail( ({"auseinandersetzungen","aerger"}),
	    "Du willst sicher nicht hier sein, wenn es Aerger gibt und sich "
	    "die Gaeste gegenseitig verhauen.");

  AddDetail( ({"kerzenleuchter","leuchter","leuchtern"}),
	    "Die Kerzen auf den Leuchtern erhellen die Kneipe recht gut.");

  AddDetail( ({"fels"}),
	    "Der blanke Fels der Hoehle ist an der Decke zu sehen.");

  AddDetail( ({"unrat"}),
	    "Es ist viel Essen auf den Boden gefallen und verfault dort. Es "
	    "wird wohl nicht sehr oft in der Kneipe durchgefegt.");

  AddDetail( ({"teller"}),
	    "Die Teller sind mit Essen gefuellt und es scheint allen gut zu "
	    "schmecken.");

  AddDetail( ({"glaeser"}),
	    "Die Glaeser, die Du siehst sind alle ziemlich dreckig. Es scheint "
	    "aber niemanden zu stoeren.");

  AddDetail( ({"scharten","schwerter","aexte"}),
	    "Die Scharten in der Theke wurden sicher von Schwerter und Aexten "
	    "gemacht. Anscheinend gibt es oefter Auseinandersetzungen hier in "
	    "der Orkkneipe.");

  AddDetail( ({"decke"}),
	    "An der Decke ist der Fels zu sehen. Ausserdem haengen ein paar "
	    "Kerzenleuchter an der Decke.");

  AddDetail( ({"wirt","krusgor"}),
	    "Der Wirt der Kneipe heisst Krusgor.");

  AddDetail( ({"boden"}),
	    "Der Boden ist wunderschoen dreckig und voller Unrat.");

  AddDetail( ({"tafel"}),
	    "Mit 'menue' kannst Du  sehen, was Du kaufen kannst.");
  
  AddDetail( ({"eingang"}),
	    "Neben dem Eingang haengt eine kleine Tafel.");

  AddDetail( ({"sueden","durchgang","vorratsraum","suedwand"}),
	    "Im Sueden geht es in der Vorratsraum der Kneipe.");

  AddDetail( ({"getraenke","massen"}),
	    "Die Getraenke werden hier in der Kneipe in Massen genossen.");

  AddDetail( ({"essen"}),
	    "Obwohl der Wirt auch zu den Orks gehoert, scheint das Essen hier "
	    "zu schmecken.");

  AddDetail( ({"orks","sprache"}),
	    "Die Orks unterhalten sich in ihrer knurrenden Sprache.");

  AddDetail( ({"tischen","tische"}),
	    "Die Tische stehen voller Glaeser und Teller.");

  AddDetail( ({"bankreihen","reihen"}),
	    "Auf den Bankreihen sitzen viele Gaeste. Es sind hauptsaechlich "
	    "Orks, die hier essen und trinken.");

  AddDetail( ({"bier"}),
	    "Das Bier scheint hier sehr gut zu schmecken.");

  AddDetail( ({"gast","gaeste"}),
	    "Die Gaeste sind hauptsaechlich Orks.");

  AddDetail( ({"wand","waenden","waende"}),
	    "An einer Wand laeuft die lang gezogene Theke entlang. Gleich "
	    "neben dem Eingang haengt eine Tafel an der Wand. In der Suedwand "
	    "befindet sich ein Durchgang zum Vorratsraum.");

  AddDetail( ({"stein","theke"}),
	    "Die Theke besteht aus Stein. Im Stein der Theke befinden sich "
	    "einige Scharten, die sicher durch Schwerter oder Aexte der Theke "
	    "zugefuegt wurden. Ansonsten ist die Theke einfach nur dreckig "
	    "und den Wirt scheint dies nicht zu stoeren.");
  
  AddDetail( ({"orkkneipe","kneipe","zum","elfenschlaechter"}),
	    "Du befindest Dich in der Kneipe 'Zum Elfenschlaechter'.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach herzaften Braten.");  
 
  AddSmell( ({"braten"}),
	   "Der Braten, der hier serviert wird, riecht wirklich sehr gut.");

  AddSound(DEFAULT_SOUND, "Du hoerst das harte Gelaechter und Geknurre der "
		  "Orks, die hier zu Gast sind.");

  AddSound( ({"gast","orks"}),
	   "Die Orks lachen und knurren, wie sie es immer tun.");
  
  AddSound( ({"geknurre"}),
		"*knurr*");

  AddSound( ({"gelaechter"}),
		"Das Gelaechter klingt rauh und hart.");


// ----------- Details Ende -------------------

  AddExit("norden", ROOM "orks6");
  AddExit("sueden", ROOM "orks20");
  
  AddItem(NPC "krusgor", REFRESH_DESTRUCT);
}

string _query_int_long()
{
  string txt;

  txt = "Du befindest Dich in der Orkkneipe 'Zum Elfenschlaechter'. Eine aus "
	"Stein gemauerte Theke verlaeuft an der Wand entlang, an denen "
	"zahlreiche Gaeste stehen und ihr Bier geniessen. Lange Bankreihen "
	"sind an schweren Tischen aufgestellt, wo viele Orks das Essen und die "
	"Getraenke zu geniessen scheinen. Im Sueden ist ein Durchgang, der in "
	"den Vorratsraum der Kneipe fuehrt. Direkt neben dem Eingang haengt "
	"eine Tafel an der Wand, die Du mit 'menue' lesen kannst. ";

  if(QueryProp(P_PUBKEEPER_ID))
  {
    if(!present(QueryProp(P_PUBKEEPER_ID)))
    {
      txt += "Seltsamerweise ist offenbar gerade niemand hier der Dich "
        "bedienen koennte.";
    }
    else
    {
      txt += "Der Wirt steht hinter der Theke und laechelt Dich "
        "freundlich an.";
    }
  }

  return BS(txt);
}
