// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"Der Tunnel endet im Westen vor einer Kammer, ueber der ein altes "
	"Holzschild haengt oder fuehrt weiter nach Nordunten in eine andere "
	"Hoehle. Neben dem Gang, der nach unten fuehrt, steht ein kleines "
	"Metallschild. Ansonsten ist in dem Tunnel ausser den Fackeln "
	"an den Waenden und ein paar Moosen, die hier wachsen nicht viel zu "
	"erkennen. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"tunnel","umgebung","teil"}), 
            "Der Tunnel ist nicht mehr sehr breit und ziemlich feucht. Es "
	    "tropft sogar von der Decke. Ein paar Moose wachsen an den Waenden "
	    "und gedeihen recht gut in der feuchten Umgebung.");

  AddDetail( ({"westen","kammer"}),
	    "Im Westen befindet sich eine Kammer, die Du problemlos betreten "
	    "kannst. Es scheint eine Art Laden zu sein, in dem die Orks Sachen "
	    "kaufen und verkaufen koennen.");

  AddDetail( ({"metallschild"}),
	    "Neben dem Gang, der nach Nordunten fuehrt steht ein kleines "
	    "Metallschild. Du kannst es lesen.");

  AddDetail( ({"schild"}),
	    "Ueber der Kammer haengt ein altes Holzschild und ein Metallschild "
	    "steht neben dem Gang, der nach Nordunten fuehrt.");

  AddDetail( ({"holzschild"}),
	    "Ueber der Kammer haengt ein altes Holzschild. Du kannst es "
	    "lesen.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln flackern in ihren Halterungen und erhellen den Tunnel "
	    "ein wenig. Das schummrige Licht reicht jedoch aus, so dass Du "
	    "alles genau erkennen kannst.");
  
  AddDetail( ({"wand","waende","waenden"}),
	    "Die Waende sind teilweise mit Moos bewachsen und einige Fackeln "
	    "haengen in Halterungen und erhellen den Tunnel.");

  AddDetail( ({"moos","moosen","moose"}), 
            "Die Moose gedeihen in der Feuchtigkeit und dem Licht der Fackeln "
	    "recht gut und haben sich an der Wand festgesetzt.");

  AddDetail( ({"boden"}),
	    "Der Boden ist feucht von den Tropfen, die von der Decke fallen. "
	    "An ein paar Stellen haben sich sogar kleine Pfuetzen gebildet.");

  AddDetail( ({"decke","hoehlendecke"}),
	    "Die Decke ist kahl und recht niedrig. Ab und zu tropft es von ihr "
	    "auf den Boden.");

  AddDetail( ({"tropfen","feuchtigkeit","abstaenden"}),
	    "Kleine Tropfen fallen in regelmaessigen Abstaenden von der "
	    "Hoehlendecke und sammeln sich in kleinen Pfuetzen am Boden. Die "
	    "Feuchtigkeit in diesem Teil der Hoehle ist recht hoch.");
  
  AddDetail( ({"art","laden"}),
	    "Im Westen ist ein Laden, in dem Du Sachen kaufen und verkaufen "
	    "kannst.");

  AddDetail( ({"orks"}), 
            "Die Orks leben in diesen Hoehlen.");

  AddDetail( ({"sachen","dinge"}),
	    "Man kann alle moeglichen Dinge in dem Laden kaufen und "
	    "verkaufen.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen, in denen die Fackeln stecken, sind alt und "
	    "rostig. Sie werden sicher nicht mehr lange an ihrem Platz "
	    "haengen.");

  AddDetail( ({"licht","schein","lichtschein"}),
	    "Der Lichtschein der Fackeln reicht aus, so dass Du gut sehen "
	    "kannst.");
  
  AddDetail( ({"stellen","pfuetzen"}),
	    "An einigen Stellen sind kleine Pfuetzen zu sehen, die sich durch "
	    "die staetig zu Boden fallenden Tropfen gebildet haben.");

  AddDetail( ({"hoehle","orkhoehle","hoehlen"}), 
            "Du befindest Dich mitten in den Hoehlen der Orks. Nach Nordunten "
	    "geht es tiefer in die Hoehlen hinein.");

  AddDetail( ({"platz"}),
	    "Irgendwann werden sie einfach auf den Boden fallen und "
	    "verrotten, wenn sie nur noch aus Rost bestehen.");

  AddDetail( ({"rost"}),
	    "Der Rost glaenzt roetlich im Schein der Fackeln.");

  AddDetail( ({"waren"}),
	    "Du kannst alle moeglichen Waren im Laden kaufen.");
  
  AddDetail( ({"nordunten"}),
	    "Nach Nordunten fuehrt ein Gang. Er fuehrt in den Anfaengerpark "
	    "der Orks.");

  AddDetail( ({"gang"}), 
            "Der Gang fuehrt nach Nordunten. Dort soll sich der Anfaengerpark "
	    "der Orks befinden.");

  AddDetail( ({"anfaengerpark"}),
	    "Der Anfaengerpark der Orks befindet sich noerdlich von Dir.");

  AddDetail( ({"umgebung","geschmack"}),
	    "Die Umgebung entspricht nicht Deinem Geschmack.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Moos.");  
 
  AddSmell( ({"moos"}),
	   "Das Moos riecht trotz der Umgebung frisch.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Haendler im Laden um seine Waren "
		  "feilschen.");

  AddSound( ({"haendler","laden"}),
	   "Er scheint ein guter Haendler zu sein. Geh doch mal hin und kauf "
	   "auch etwas.");

  AddReadDetail( ({"metallschild"}),
		"+--------------------------------------------+\n"
                "|                                            |\n"
                "|          Anfaengerpark der Orks            |\n"
                "|                                            |\n"
                "+--------------------------------------------+\n"); 
  AddReadDetail( ({"holzschild"}),
		"+--------------------------------------------+\n"
                "|                                            |\n"
                "|             Ushnoz's Orkladen              |\n"
                "|                                            |\n"
                "+--------------------------------------------+\n");  
//-----Details Ende-----
  
AddExit("sueden", ROOM "orks11");
AddExit("westen", ROOM "orkladen");
//AddExit("nordunten", ROOM "orksa1");
AddSpecialExit( "nordunten", "go_nordunten" );
}
int go_nordunten(string dir)
{

  if(!(present("marlog", TO)))
  {
    write( BS( "Eine unbekannte Macht haelt Dich davon ab momentan weiter "
	       "nach Nordunten zu gehen.") );
    say("Eine unbekannte Macht haelt "+TP->Name(WEN)+" davon ab, "
      "nach Nordunten zu gehen.\n");
  return -1;
  }
}


