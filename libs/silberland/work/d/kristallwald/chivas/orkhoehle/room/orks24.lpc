// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"In der Kammer liegt allerlei Unrat am Boden verstreut, so dass es "
	"sehr schwierig ist auf nichts zu treten. An der hinteren Wand liegen "
	"einige alte Saecke, in denen Stroh ist und welche als "
	"Bett dienen. An den Waenden haengen ein paar brennende "
	"Fackeln, die die Kammer soweit erhellen, so dass man das Chaos hier "
	"sehr gut sehen kann." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"kammer","ruhe"}), 
            "In der Kammer herrscht ein Chaos und Du wuerdest Dich hier nicht "
	    "zur Ruhe betten.");

  AddDetail( ({"unrat"}),
	    "Es liegen lauter Essensreste und zerrissene Klamotten am Boden.");

  AddDetail( ({"boden"}),
	    "Am Boden liegt einiges herum und es ist schwer nirgends drauf "
	    "zu treten.");

  AddDetail( ({"wand","waende","waenden"}),
	    "An der hinteren Wand liegen einige Saecke. Ansonsten haengen die "
	    "ueblichen Fackeln an den Waenden.");
  
  AddDetail( ({"saecke","strohsaecke"}),
	    "Die Saecke scheinen als Bett zu dienen und sehen sehr unbequem "
	    "aus. Sie sind mit Stroh gefuellt.");

  AddDetail( ({"stroh"}), 
            "Das Stroh ist nass und faulig. Es stinkt ekelig.");

  AddDetail( ({"bett"}),
	    "Als Bett wuerdest Du die Strohsaecke nicht bezeichnen.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln erhellen die Kammer ein wenig. Sie haengen in alten "
	    "Halterungen an den Waenden.");

  AddDetail( ({"chaos"}),
	    "Es herrscht ein grosses Chaos in der Kammer. Man muss aufpassen, "
	    "dass man nirgendwo drauf tritt.");
  
  AddDetail( ({"decke"}),
	    "Die Decke ist kahl und uninteressant.");

  AddDetail( ({"essensreste"}), 
            "Die Essensreste am Boden sind am vergammeln.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen sind alt und haesslich.");

  AddDetail( ({"klamotten"}),
	    "Die Klamotten sind zerrissen und nicht mehr zu gebrauchen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Das Stroh in den Saecken ist faulig und stinkt.");  
 
  AddSmell( ({"stroh"}),
	   "Das Stroh stinkt ekelig.");

  AddSound(DEFAULT_SOUND, "Du hoerst hier gar nichts.");

//-----Details Ende-----
  
AddExit("westen", ROOM "orks22");

}

