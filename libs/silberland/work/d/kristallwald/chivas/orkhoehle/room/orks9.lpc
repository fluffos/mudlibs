// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"Der Tunnel ist nicht besonder breit und hoch. Er scheint in einer "
	"kleinen Kammer im Suedwesten zu enden. Einige alte Spinnenweben "
	"haengen von der Decke und sind schon seit Jahren nicht mehr "
	"bewohnt. Es war anscheinend schon sehr lange niemand mehr in "
	"diesem verlassenen Gang." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 0 );

//-----Details Anfang-----
  
  AddDetail( ({"tunnel"}), 
            "Der Tunnel in dem Du Dich diesmal befindest ist recht schmal.");

  AddDetail( ({"kammer","suedwesten"}),
	    "Eine kleine Kammer scheint im Suedwesten zu sein. Was sie wohl "
	    "beherbergt?");

  AddDetail( ({"spinnenweben","jahren","jahre","jemand"}),
	    "Alte Spinnenweben haengen von der Decke. Sie sind jedoch schon "
	    "seit Jahren verlassen, da sich kaum Jemand hier her verirrt, "
	    "den man fressen kann.");

  AddDetail( ({"decke"}),
	    "An der Decke haengen ein paar alte und verlassene Spinnenweben.");
  
  AddDetail( ({"gang"}),
	    "Der Gang ist schon seit Jahren verlassen.");

  AddDetail( ({"boden"}), 
            "Am Boden sind viele Steinbrocken zu sehen, die sicher von der "
	    "Decke herunter gefallen sind. Ausser den Steinbrocken ist "
	    "sonst nur eine dicke Staubschicht zu sehen.");

  AddDetail( ({"wand","waende","waenden"}),
	    "Die Waende sind kahl und die dort haengenden Fackeln sind schon "
	    "lange erloschen und lassen sich auch nicht mehr anzuenden.");

  AddDetail( ({"steinbrocken","brocken","weg"}),
	    "Die Steinbrocken stoeren Dich ein wenig auf Deinem Weg.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln sind schon lange erloschen und lassen sich auch nicht "
	    "mehr anzuenden.");
  
  AddDetail( ({"staubschicht","schicht"}),
	    "In der Staubschicht sind neben Deinen Fussspuren nur ganz leichte "
	    "Abdruecke zu sehen, die in die Kammer fuehren und aus ihr "
	    "heraus.");

  AddDetail( ({"fussspuren","spuren"}), 
            "Deine Fussspuren sind gut zu erkennen.");

  AddDetail( ({"abdruecke"}),
	    "Die Abdruecke sind nur ganz schwer zu erkennen. Anscheinend "
	    "schleicht irgendwer regelmaessig in die Kammer und wieder aus "
	    "ihr heraus. Vielleicht erfaehrst Du mehr, wenn Du die Kammer "
	    "betrittst.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach absolut gar nichts. Es stinkt hier "
		          "noch nicht einmal.");  
 
  AddSound(DEFAULT_SOUND, "Es herrscht absolute Stille.");

  AddSound( ({"stille"}),
	   ".................");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "orks8");
AddExit("suedwesten", ROOM "orks19");

}

