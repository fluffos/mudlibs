// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Wald");
  SetProp( P_INT_LONG,
	"Der Trampelpfad fuehrt nach Osten. In Richtung Westen endet der Pfad "
        "vor einem grossen Strauch, wo einige Aeste abgebrochen sind. Grosse "
        "Baeume saeumen den schmalen Trampelpfad und ihr Blaetterdach laesst "
        "nur spaerlich Lichtstrahlen hindurch. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"trampelpfad","pfad"}), 
            "Der Trampelpfad ist komplett ausgelatscht. Er schlaengelt sich "
            "zwischen den Baeumen in Richtung Osten durch den Wald. Im Westen "
            "endet der Pfad vor einem Strauch.");

  AddDetail( ({"westen"}),
	    "Im Westen endet der Pfad vor einem grossen Strauch.");

  AddDetail( ({"osten"}),
	    "Im Osten fuehrt der Pfad durch die Baeume weiter in den Wald "
            "hinein.");

  AddDetail( ({"strauch"}),
	    "Der Strauch sieht schon ziemlich mitgenommen aus. Viele seiner "
            "Aeste sind abgebrochen und er hat auch schon viele Blaetter "
            "verloren.");
  
  AddDetail( ({"aeste"}),
	    "Einige Aeste an dem Strauch sind abgebrochen. Du kannst Dich "
            "sicher durch die Aeste zwaengen um den dahinter liegenden Weg "
            "zu erreichen, den Du von hier aus, durch die spaerlichen "
            "Blaetter, ein wenig sehen kannst.");

  AddDetail( ({"baeume","baeumen"}), 
            "Die Baeume stehen sehr dicht und saeumen den schmalen "
            "Trampelpfad.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das dichte Blaetterdach laesst kaum Lichtstrahlen durch. Der Wald "
            "ist hier ein wenig duester.");

  AddDetail( ({"lichtstrahlen","strahlen"}),
	    "Nur ab und zu treffen ein paar Lichtstrahlen den Waldboden.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist durch das dichte Blaetterdach leider nicht zu "
            "sehen.");
  
  AddDetail( ({"boden","waldboden"}),
	    "Am Waldboden ist nur Schlamm und ein paar Steine zu sehen.");

  AddDetail( ({"wald"}), 
            "Du stehst mitten in einem Wald. Waere der Trampelpfad nicht, "
            "wuerdest Du Dich sicher verlaufen.");

  AddDetail( ({"richtung"}),
	    "Es geht nach Westen oder nach Osten durch den Strauch.");

  AddDetail( ({"blaetter"}),
	    "Es sind sehr viele Blaetter an den Baeumen zu sehen. An einem "
            "Strauch im Westen haengen dagegen sehr wenige.");

  AddDetail( ({"weg"}),
	    "Hinter dem Strauch liegt ein breiter Weg, der durch den Wald "
            "fuehrt.");
  
  AddDetail( ({"schlamm"}),
	    "Der Pfad ist ekelig schlammig.");

  AddDetail( ({"steine"}), 
            "Es sind ein paar kleine uninteressante Steine.");

  AddDetail( ({"voegel"}),
	    "Die Voegel sind oben im Blaetterdach. Du kannst sie nicht sehen "
            "aber hoeren.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Wald.");  
 
  AddSmell( ({"wald"}),
	   "Es riecht unglaublich waldig.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel zwitschern.");

  AddSound( ({"voegel"}),
	   "Die Voegel sitzen hoch oben im Blaetterdach und singen ihr Lied.");
  
  AddSound( ({"lied"}),
	   "*triller*zwitscher*triller*");

//-----Details Ende-----
  
AddExit("osten", ROOM "orks29");

AddCmd( ({"zwaeng", "zwaenge" }), "zwaengen" );

}
int zwaengen(string str)
{
   notify_fail("Wo moechtest Du Dich durchzwaengen?\n");
   if ( member( ({ "durch aeste","durch strauch" }),str) != -1) 
  {
    write(BS ( "Du zwaengst Dich durch den Strauch auf den dahinter liegenden "
               "Weg.\n"));
      TP->move( "/d/kristallwald/chivas/hochebene/room/hochende2", M_GO, 
      "ploetzlich zwischen den Aesten eines Strauches", "verschwindet", 
      "zwaengt sich herein");
    return 1;
  }
}

