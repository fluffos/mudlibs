// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"Du stehst in einer natuerlichen Kammer, von denen drei Abzweigungen "
	"abgehen. Nach Sueden fuehrt ein Tunnel, der wieder einige "
	"Abzweigungen zu haben scheint. Nach Norden fuehrt ein Tunnel weiter "
	"und nach Westen fuehrt ein Gang, der ordentlich ausgebaut und nicht "
	"nur grob behauen wurde, wie die anderen Tunnel in der Hoehle der "
	"Orks." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"kammer"}), 
            "Aus der Kammer fuehren drei Abzweigungen. Du kannst nach Norden, "
	    "Sueden oder Westen gehen.");

  AddDetail( ({"abzweigungen","bereiche"}),
	    "Die Abzweigungen fuehren Dich in andere Bereiche der Hoehle.");

  AddDetail( ({"sueden"}),
	    "Nach Sueden fuehrt ein Tunnel weiter.");

  AddDetail( ({"norden","gebiet"}),
	    "Nach Norden fuehrt ein Tunnel in unbekanntes Gebiet.");
  
  AddDetail( ({"tunnel"}),
	    "Es gibt viele Tunnel in der Orkhoehle.");

  AddDetail( ({"westen","gang"}), 
            "Im Westen ist ein Gang, der anscheinend ordentlicher ausgebaut "
	    "wurde, als die normalen Tunnel in der Hoehle. Die Waende wirken "
	    "glatter und nicht so kantig wie sonst ueberall.");

  AddDetail( ({"hoehle","orkhoehle","orkhoehlen","hoehlen"}),
	    "Du stehst tief in den Orkhoehlen unter der Hochebene von "
	    "Gorthad.");

  AddDetail( ({"orks"}),
	    "Hunderte von Orks leben in diesen Hoehlen.");

  AddDetail( ({"waende","wand","waenden"}),
	    "An den Waenden haengen ein paar Fackeln, die die Kammer erhellen. "
	    "Die Waende in der Kammer sind kantig und unbehauen. Dagegen sind "
	    "die Waende im Westen glatter und bearbeitet.");
  
  AddDetail( ({"boden"}),
	    "Am Boden liegen einige Steine und ein paar kleine Pfuetzen haben "
	    "sich am Boden gebildet.");

  AddDetail( ({"decke","hoehlendecke"}), 
            "Die Decke ist uneben und rissig. Einige Tropfen fallen von ihr "
	    "auf den Boden.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Die Hochebene von Gorthad befindet sich oberhalb der Hoehlen.");

  AddDetail( ({"fackeln","licht","schein"}),
	    "Die Fackeln erhellen mit ihrem Schein die Kammer ein wenig. Man "
	    "kann zwar gut sehen, jedoch ist das Licht nicht besonders stark, "
	    "so dass es ueberall Schatten gibt.");

  AddDetail( ({"steine"}),
	    "Die Steine sind von den der Decke gefallen. Sie sind nicht sehr "
	    "interessant.");
  
  AddDetail( ({"pfuetzen"}),
	    "Einige kleine Pfuetzen haben sich am Boden gebildet. Sie werden "
	    "stetig von den herab fallenden Tropfen gespeist.");

  AddDetail( ({"tropfen"}), 
            "Kleine Tropfen fallen von der Decke auf den Boden.");

  AddDetail( ({"schatten"}),
	    "Die Schatten machen Dich ein wenig nervoes. In den Schatten kann "
	    "man sich recht gut verstecken und einen Hinterhalt stellen.");

  AddDetail( ({"risse"}),
	    "In der Decke sind ein paar Risse zu sehen. Sie sind aber nicht "
	    "beaengstigend, da die Hoehlendecke aus massiven Fels besteht.");

  AddDetail( ({"fels"}),
	    "Der Fels der Hochebene ist sehr hart.");
  
  AddDetail( ({"hinterhalt"}),
	    "Du hoffst, dass Du in diesen Hoehlen nicht in einen Hinterhalt "
	    "geraetst.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Die Luft ist in den Hoehlen nicht besonders gut.");  
 
  AddSmell( ({"luft","hoehlen"}),
	   "Die Luft ist alt und stickig.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Tropfen auf den Boden fallen.");

  AddSound( ({"tropfen"}),
	   "*plitsch*platsch*plitsch");
  
//-----Details Ende-----
AddItem(NPC "orkd", REFRESH_DESTRUCT);

AddExit("sueden", ROOM "orks8");
AddExit("norden", ROOM "orks12");
AddExit("westen", ROOM "orks14");

}

