// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Im Eingang der Orkhoehle");
  SetProp( P_INT_LONG,
	"Der Sonnenschein, der durch den Eingang faellt, erhellt die Hoehle "
	"ein wenig. Am schlammigen Hoehlenboden kann man viele Abdruecke "
	"erkennen. Im Westen und im Sueden wurden jeweils kleine Kammern "
        "in den Stein geschlagen, wo sich die Wachmannschaften des Eingangs "
        "ausruhen koennen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"sonnenschein","schein"}), 
            "Der Sonnenschein faellt in den Eingang der Hoehle.");

  AddDetail( ({"eingang","eingangs","hoehleneingang"}),
	    "Du stehst im Eingang zum Reich der Orks.");

  AddDetail( ({"hoehlenboden","boden"}),
	    "Der Hoehlenboden ist schlammig. Zwischen einzelnen Pfuetzen sind "
	    "verschiedene Abdruecke zu erkennen.");

  AddDetail( ({"risse","rissen"}),
	    "Aus den Rissen in der Decke tropft es auf den Hoehlenboden.");

  AddDetail( ({"abdruecke"}),
	    "Es gibt allerlei verschiedene Abdruecke. Du erkennst Abdruecke "
	    "von Orks, Trollen und anderen Lebewesen. Richtig unberuhigend "
	    "wirken eigentlich nur die Schleifspuren, die weiter in die "
	    "Hoehle hinein fuehren.");
  
  AddDetail( ({"westen","sueden"}),
	    "Im Westen und im Sueden sind Kammern fuer die Wachmannschaften "
	    "in den Stein gehauen.");

  AddDetail( ({"kammern","kammer","ruheraum"}), 
            "Die Kammern dienen als Ruheraum fuer die Wachen, die am Eingang "
	    "aufpassen.");

  AddDetail( ({"stein"}),
	    "Die Waende der Hoehle bestehen aus blanken Stein.");

  AddDetail( ({"wachmannschaften","mannschaften","mannschaft","wachmannschaft"}),
	    "Die Wachmannschaften am Eingang beschuetzen das Reich der Orks "
	    "vor moeglichen Angriffen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen blau. Man kann ihn aus dem Eingang der "
	    "Hoehle heraus noch gut erkennen.");
  
  AddDetail( ({"hoehle","hoehlen"}),
	    "Du stehst im Eingang zu einer grossen Hoehle, die von den Orks "
	    "bewohnt wird.");

  AddDetail( ({"orks"}), 
            "Die Orks sind eine boese und niedertraechtige Rasse, die im "
	    "Silberland lebt.");

  AddDetail( ({"rasse","rassen"}),
	    "Es gibt viele verschiedene Rassen im Silberland.");

  AddDetail( ({"silberland"}),
	    "Du befindest Dich im Silberland.");

  AddDetail( ({"waende","wand"}),
	    "In die Waende wurden zwei Kammern geschlagen, wo die "
	    "Wachmannschaft vom Eingang sich ausruhen kann. Ausserdem sind "
	    "ein paar Halterungen fuer Fackeln zu erkennen.");
  
  AddDetail( ({"halterungen"}),
	    "Die Halterungen fuer die Fackeln sind alt und rostig.");

  AddDetail( ({"fackeln","fackel","licht"}), 
            "Die Fackeln sind momentan nicht angezuendet, da genug Licht "
	    "durch den Hoehleneingang faellt. Sie werden sicher erst in der "
	    "Daemmerung angesteckt.");

  AddDetail( ({"daemmerung"}),
	    "Die Daemmerung ist noch lange nicht da. Die Sonne steht draussen "
	    "fast im Zenit.");

  AddDetail( ({"sonne","zenit"}),
	    "Du kannst die Sonne nicht sehen, da die Sonne beinahe senkrecht "
	    "steht. Um sie zu sehen, musst Du schon den Hoehleneingang "
	    "verlassen.");

  AddDetail( ({"reich"}),
	    "Das Reich der Orks unter der Hochebene soll sehr weitlaeufig "
	    "sein. Ganze Horden sollen hier leben.");
  
  AddDetail( ({"hochebene","gorthad"}),
	    "Die Hoehle befindet sich unter der Hochebene von Gorthad.");

  AddDetail( ({"horden"}), 
            "Den Horden von Orks willst Du eigentlich nicht begegnen.");

  AddDetail( ({"pfuetzen"}),
	    "Kleine Pfuetzen haben sich am Eingang der Hoehle gebildet. Das "
	    "Wasser in den Pfuetzen sieht jedoch ekelig aus.");

  AddDetail( ({"trolle","trollen"}),
	    "Trolle gehoeren zu den Rassen, die im Silberland leben.");

  AddDetail( ({"decke"}),
	    "Die Decke ist uneben und hat ein paar Risse.");

  AddDetail( ({"schleifspuren","spuren"}),
	    "Die Schleifspuren deuten auf ein Opfer der Orks, dass in die "
	    "Hoehlen verschleppt wurde. Du bist froh, dass Du es nicht "
	    "gewesen bist.");
  
  AddDetail( ({"lebewesen","weg"}),
	    "Verschiedene Lebewesen haben schon den Weg in die Hoehlen "
	    "gewagt. Es sind jedoch nicht alle wieder heraus gekommen.");

  AddDetail( ({"wachen"}), 
            "Die Wachen beschuetzen die Hoehle der Orks vor Angriffen.");

  AddDetail( ({"angriffen","angriff","angreifer"}),
	    "Ein Angriff auf die Orks kann fuer den Angreifer schnell den Tod "
	    "bedeuten.");

  AddDetail( ({"tod"}),
	    "Du willst eigentlich ungerne Tod besuchen. Er ist zwar ganz nett, "
	    "aber irgendwie fuehlst Du Dich danach immer ein wenig "
	    "unerfahrener als vorher.");

  AddDetail( ({"wasser"}),
	    "Das Wasser ist fast schwarz und stinkt fuerchterlich. Du bist "
	    "Dir nicht mehr sicher, dass es ueberhaupt Wasser ist.");
  
  AddDetail( ({"opfer"}),
	    "Es gibt viele Opfer der Orks.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es kommt ein schrecklicher Geruch aus der Hoehle.");  
 
  AddSmell( ({"geruch","hoehle"}),
	   "Es riecht, als ob die Orks etwas fleischiges zum Essen in der "
	   "Hoehle vorbereiten. Du musst leicht wuergen.");
  
  AddSmell( ({"essen","etwas"}),
	   "Es scheint fast so, als ob Etwas geroestet wird, dass sicher "
	   "intelligent war.");
  
  AddSound(DEFAULT_SOUND, "Du hoerst das Grunzen der Orks und ein paar "
		  "entfernte Schreie.");

  AddSound( ({"grunzen","orks"}),
	   "Die Orks grunzen eigentlich staendig.");
  
  AddSound( ({"schreie"}),
	   "Die Schreie kommen tief aus der Hoehle. Du erschauerst ein wenig.");

//-----Details Ende-----
  
AddExit("norden", ROOM "orks32");
AddExit("westen", ROOM "orks26");
AddExit("suedwesten", ROOM "orks2");
AddExit("sueden", ROOM "orks27");

}

