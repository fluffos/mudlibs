// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl;
int anzahl2;
int anzahl3;

void create()
	
{
  ::create();

  anzahl=1;
  anzahl2=3;
  anzahl3=1;

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"Dies ist anscheinend der Lagerraum fuer die Kneipe. Du erkennst "
	"verschiedene Kisten und Faesser unterschiedlicher Groesse. Ausserdem "
	"haengen von der Decke einige grosse Haken, an denen Fleisch an der "
	"Luft getrocknet wird. Es stinkt fuerchterlich in dieser Kammer." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"lagerraum"}), 
            "Im Lagerraum der Kneipe stehen alle moeglichen Kisten und Faesser "
	    "rum. Ausserdem riecht es ein wenig unangenehm.");

  AddDetail( ({"kneipe"}),
	    "Die Kneipe befindet sich noerdlich von Dir. Hier im Lagerraum "
	    "wirst Du sicher nicht bedient.");

  AddSpecialDetail( ({ "kisten" }), "kisten" );

  AddSpecialDetail( ({ "kiste","deckel" }), "kiste" );

  AddSpecialDetail( ({ "boden" }), "boden" );

  AddSpecialDetail( ({ "held" }), "held" );

  AddSpecialDetail( ({ "getreide","dinge" }), "getreide" );

  AddSpecialDetail( ({ "chaos","durcheinander","truemmern","truemmer" }), "durcheinander" );

  AddDetail( ({"faesser","faessern"}),
	    "Grosse Faesser stehen an der Wand. Der Wirt hat genug zu Trinken "
	    "fuer lange Zeit. An den Faessern haengen verschiedene Schilder, "
	    "die Dir zeigen, was sich in ihnen befindet.");
  
  AddDetail( ({"groesse"}),
	    "Die Faesser und Kisten haben alle eine unterschiedliche Groesse.");

  AddDetail( ({"decke"}), 
            "An der Decke, die aus blankem Fels besteht, haengen grosse Haken, "
	    "an denen Fleisch an der stinkigen Luft trocknet.");

  AddDetail( ({"haken"}),
	    "An den Haken haengt Fleisch, dass an der Luft trocknet. An "
	    "einigen Haken haengen auch echte Orkspezialitaeten.");

  AddDetail( ({"fleisch","anblick"}),
	    "Das Fleisch trocknet hier an der Luft und stinkt. Kleine Maden "
	    "sind in dem Fleisch zu erkennen. Bei dem Anblick wird Dir "
	    "schlecht und Du wirst hier sicher nichts mehr essen.");

  AddDetail( ({"luft"}),
	    "Die Luft im Vorratsraum ist verbraucht und es stinkt "
	    "fuerchterlich.");
  
  AddDetail( ({"kammer"}),
	    "Die Kammer wird als Vorratsraum fuer die Kneipe benutzt.");

  AddDetail( ({"wand","waende","waenden"}),
	    "An den Waenden stehen einige grosse Faesser und ein paar Fackeln "
	    "haengen in ihren Halterungen.");

  AddDetail( ({"zeit"}),
	    "Es dauert, bis die Faesser leer sind.");

  AddDetail( ({"trinken","fass"}),
	    "Aus einem Fass an der Wand tropft es durch ein kleines Loch "
	    "heraus.");
  
  AddDetail( ({"schilder"}),
	    "Du erkennst fuenf Schilder an den Faessern.");

  AddDetail( ({"orkspezialitaeten","spezialitaeten"}), 
            "Die Orkspezialitaeten sind anders als Du sie Dir vorgestellt "
	    "hast. Du erkennst einen Menschen und eine Fee, die an Haken "
	    "haengen. Ausserdem haengt ein grosses Netz an einem der Haken.");

  AddDetail( ({"maden"}),
	    "Kleine Maden fressen sich durch das Fleisch, was an den Haken "
	    "haengt. Es sieht wirklich sehr lecker aus.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen bestehen aus schnoerkellosem Eisen und sind "
	    "beeindruckend uninteressant.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln erhellen den Vorratsraum ein wenig.");
  
  AddDetail( ({"eisen"}),
	    "Das Eisen der Halterungen ist an ein paar Stellen ein wenig "
	    "rostig.");

  AddDetail( ({"stellen","rost"}), 
            "Der Rost wird bald die Halterungen zerfressen haben.");

  AddDetail( ({"schild 1","schild eins","schild1","elfen","wein","elessar"}),
	    "Auf dem Schild steht: Wein der Elfen aus Elessar. Er wurde sicher "
	    "bei den Raubzuegen der Orks geklaut.");

  AddDetail( ({"schild 3","schild drei","schild3","zwergenbraeu","braeu","koestlichkeit"}),
	    "Auf dem Schild steht: Zwergenbraeu aus Ardhmir. Wie die Orks an "
	    "diese Koestlichkeit gekommen sind, wird Dir ewig ein Raetsel "
	    "bleiben. Die Zwerge wuerden den Orks nie ihr Zwergenbraeu "
	    "ueberlassen und sie sind nie so tief nach Ardhmir vorgedrungen um "
	    "es zu stehlen.");

  AddDetail( ({"schild 4","schild vier","schild4","champagner","tijara","haendler"}),
	    "Auf dem Schild steht: Champagner aus Tijara. Die Orks haben "
	    "wohl einen Haendler ueberfallen, der den Champagner in Tijara "
	    "erstanden hat.");

  AddDetail( ({"schild 5","schild fuenf","schild5","wasser"}),
	    "Auf dem Schild steht: Wasser. Igitt, wer trinkt den sowas. Du "
	    "schuettelst Dich.");

  AddDetail( ({"schild"}),
	    "Welches Schild meinst Du?");

  AddDetail( ({"schild2","schild zwei","schild 2","lesen","echter","rum"}),
	    "Auf dem Schild steht: Echter Rum. Du fuehlst Dich schon beim "
	    "Lesen ganz besoffen.");
  
  AddDetail( ({"loch"}),
	    "Aus dem Loch troepfelt es sehr stark. Es scheint leckerer "
	    "Elfenwein zu sein.");

  AddDetail( ({"elfenwein"}), 
            "Hier kann man also doch ein wenig trinken ohne zu bezahlen.");

  AddDetail( ({"orks","haende"}),
	    "Die Orks leben in diesen Hoehlen und sie gehen haeufig auf "
	    "Raubzuege, wo dann oefters solche Faesser in die Haende der "
	    "Orks fallen.");

  AddDetail( ({"raetsel","sachen"}),
	    "Viele Sachen sind fuer Dich ein Raetsel, welches Du nie loesen "
	    "wirst.");

  AddDetail( ({"zwerge","ardhmir","zwergenfeste","naehe"}),
	    "Die Zwerge leben hier ganz in der Naehe in der Zwergenfeste von "
	    "Ardhmir.");
  
  AddDetail( ({"raubzuegen","raubzuege"}),
	    "Die Raubzuege der Orks sind sehr gefaehrlich. Vor allem fuer "
	    "die, die ueberfallen werden.");

  AddDetail( ({"mensch","menschen","appetit"}),
	    "Auf Mensch hast Du heute keinen grossen Appetit.");

  AddDetail( ({"fee","feen","hunger"}),
	    "Du hast zwar gehoert, dass Feen sehr knusprig sein sollen, aber "
	    "darauf hast Du jetzt keinen Hunger.");

  AddSpecialDetail( ({ "netz","wesen","bewegung" }), "netz" );

  AddDetail( ({"fels"}),
	    "Du erkennst den blanken Fels der Hoehle.");

  AddDetail( ({"vorratsraum","raum"}),
	    "Dies ist der Raum, wo der Wirt sein Essen und Trinken "
	    "aufbewahrt.");

  AddDetail( ({"wirt"}),
	    "Der Wirt ist sicher in der Kneipe.");

  AddDetail( ({"hoehle"}),
	    "Die Hoehle ist ein Vorratsraum. Sie ist eine der vielen Kammern "
	    "in den Orkhoehlen.");

  AddDetail( ({"orkhoehlen","hoehlen"}),
	    "Die Orkhoehlen unterhalb der Hochebene sind sehr weitlaeufig.");

  AddDetail( ({"holz","beispiel"}),
	    "Verschiedenes besteht hier aus Holz. Die Kisten sind zum Beispiel "
	    "aus Holz.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Die Hoehlen befinden sich unterhalb der Hochebene von Gorthad.");

  AddDetail( ({"kammern"}),
	    "Es gibt hier viele Kammern in den Hoehlen. Diese hier wird als "
	    "Vorratsraum benutzt.");

  AddDetail( ({"essen"}),
	    "Hier bewahrt der Wirt das Essen auf, dass er vorne in der Kneipe "
	    "verkauft.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es stinkt wiederlich in der Vorratskammer. Du "
		  "solltest Dir genau ueberlegen, ob man in der Kneipe "
		  "etwas essen sollte.");  
 
  AddSmell( ({"vorratskammer"}),
	   "Es stinkt sehr.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Gaeste in der Kneipe.");

  AddSound( ({"gaeste","kneipe"}),
	   "Die Gaeste lachen und unterhalten sich.");

//-----Details Ende-----
  
AddExit("norden", ROOM "orkschenke2");

AddCmd( ({"kletter", "klettere" }), "klettern" );
AddCmd( ({"trink", "trinke" }), "trinken" );
AddCmd( ({"reiss", "reisse","zerreiss","zerreisse" }), "reissen" );
}
int klettern(string str)
{
 notify_fail("Wo moechtest Du rauf klettern?\n");
 if ( member( ({ "stapel", "kisten","auf kisten","auf stapel","stapel rauf" }),str) != -1) 
  {
   if ( anzahl )
    {
    write(BS( "Du kletterst auf den Stapel mit den Kisten, der durch Dich "
	      "ins Schwanken geraet. Als Du fast die Spitze erreicht hast, "
	      "neigt sich der Stapel und faellt mit Dir um.\n"));
    say( TPN+" klettert auf einen Stapel mit Kisten, der sofort umfaellt. Was "
	     "fuer ein Idiot.\n");
    anzahl--;
    return 1;
    }
    else
    {
    write(BS( "Es ist ja gar kein Stapel mehr da, auf den Du klettern "
	      "kannst.\n"));
    say( TPN+" scheint an Paranoia zu leiden.\n");
    return 1;   
    }
  }
}
int trinken(string str)
{
   notify_fail("Was moechtest Du trinken ?\n");
   if ( member( ({ "elfenwein", "wein", "tropfen" }),str) != -1) 
  {
    write(BS ( "Du beugst Dich runter und faengst die Tropfen mit der Hand "
	       "auf. Du trinkst den suessen Elfenwein und fuehlst Dich "
	       "erfrischt."));
    say( TPN+" beugt sich tiefer und trinkt etwas.\n");
    if ( anzahl2 )
    {
      TP->AddHp(25);
      anzahl2--;
    }
    return 1;
  }
}  
int reissen(string str)
{
 notify_fail("Was moechtest Du zerreissen?\n");
 if ( member( ({ "netz" }),str) != -1) 
  {
   if ( anzahl3 )
    {
    write(BS( "Du zerreisst das Netz mit aller Kraft und zwei kleine Kobolde "
	      "purzeln aus dem Netz. Der eine Kobold tritt Dir aus Dankbarkeit "
	      "noch kraeftig vor das Schienbein bevor er leise durch die "
	      "Kneipe verschwindet.\n"));
    say( TPN+" jault schmerzhaft auf.\n");
    TP->AddHp(-15);
    anzahl3--;
    return 1;
    }
    else
    {
    write(BS( "Das Netz ist schon zerrissen. Du kannst nichts mehr "
	      "zerreissen.\n"));
    say( TPN+" scheint an Paranoia zu leiden.\n");
    return 1;   
    }
  }
}
void reset()
{
  ::reset();
  anzahl=1;
  anzahl2=3;
  anzahl3=1;
}
string kisten(string key)
{
    if ( anzahl )
    {
    return(BS("Die Kisten bestehen aus Holz und wurden saeuberlich aufeinander "
	      "gestapelt. Die Kiste, die ganz oben auf dem Stapel steht, "
	      "faellt Dir besonders auf."));
    }
    else
    {
    return(BS("Die Kisten liegen in einem heillosen Durcheinander auf dem "
	      "Boden verstreut. Anscheinend hat ein richtiger Held hier ein "
	      "Durcheinander angerichtet."));
    }
}
string kiste(string key)
{
    if ( anzahl )
    {
    return(BS("Der Deckel der obersten Kiste auf dem Stapel ist ein wenig "
	      "lose. Wenn man auf den Stapel klettern wuerde, koennte man "
	      "sicher hineinschauen."));
    }
    else
    {
    return(BS("Die Kisten liegen in einem heillosen Durcheinander auf dem "
	      "Boden verstreut. Anscheinend hat ein richtiger Held hier ein "
	      "Durcheinander angerichtet."));
    }
}
string stapel(string key)
{
    if ( anzahl )
    {
    return(BS("Der Stapel mit den Kisten sieht zwar ein wenig wackelig aus, "
	      "aber bei Deinem Koennen duerfte dies ja kein Problem sein "
	      "auf den Stapel zu klettern."));
    }
    else
    {
    return(BS("Die Kisten waren sicher einmal sauber gestapelt, bis Jemand "
	      "die Kisten umgeschmissen hat."));
    }
}
string durcheinander(string key)
{
    if ( anzahl )
    {
    return(BS("Alle Kisten stehen sauber gestapelt uebereinander."));
    }
    else
    {
    return(BS("Es herrscht ein unglaubliches Chaos. Die Kisten haben einmal "
	      "als Stapel aufeinander gestanden. Jetzt liegen sie teilweise "
	      "zerbrochen am Boden."));
    }
}
string held(string key)
{
    if ( anzahl )
    {
    return(BS("Du bist ein wahrer Held."));
    }
    else
    {
    return(BS("Warst Du der Held, der dieses Chaos hier angerichtet hat?"));
    }
}
string boden(string key)
{
    if ( anzahl )
    {
    return(BS("Der Boden ist zwar ein wenig schmutzig, aber die Kisten und "
	      "Faesser stehen ordentlich gestapelt im Vorratsraum."));
    }
    else
    {
    return(BS("Der Boden ist mit Kisten uebersaeht. Die Kisten sind teilweise "
	      "zerbrochen und Getreide und andere Dinge, die in den Kisten "
	      "waren, haben sich auf dem Boden verteilt."));
    }
}
string getreide(string key)
{
    if ( anzahl )
    {
    return(BS("Es befinden sich sicher alle moeglichen Dinge in den Kisten."));
    }
    else
    {
    return(BS("Ein wenig Getreide und andere Dinge, die sich in den Kisten "
	      "befunden haben, liegen auf dem Boden zwischen den Truemmern "
	      "der Kisten."));
    }
}
string netz(string key)
{
    if ( anzahl3 )
    {
    return(BS("In dem Netz ist Bewegung. Anscheinend ist dort wer gefangen. "
	      "Vielleicht kannst Du das Netz zerreissen und das arme Wesen "
	      "befreien."));
    }
    else
    {
    return(BS("Das Netz ist zerrissen und leer. Anscheinend wurde ein armes "
	      "gefangenes Wesen befreit."));
    }
}
