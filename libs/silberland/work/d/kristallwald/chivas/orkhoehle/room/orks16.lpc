// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl;

void create()
	
{
  ::create();

  anzahl=1;

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"Die Kammer ist eher eine grosse Halle. Es sind lange Reihen von "
	"Baenken und Tischen aufgebaut, an denen sich die Orks anscheinend "
	"zu Versammlungen und grossen Gelagen treffen. An den Waenden haengen "
	"viele Fackeln und lebensgrosse Statuen von allen moeglichen "
	"Lebewesen. Nach Westen fuehrt ein grosser Durchgang in das Herz des "
	"Orkreiches." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"kammer","halle"}), 
            "Die Kammer kann man eher als grosse Halle bezeichnen. Sie wird "
	    "anscheinend fuer Versammlungen der Horde genutzt, da lange "
	    "Reihen von Tischen und Baenken hier aufgestellt sind.");

  AddDetail( ({"reihen","baenken","baenke","tischen","tische","platz"}),
	    "Die langen Reihen von Baenken und Tischen bietet fuer mehrere "
	    "hundert Orks Platz. Die Baenke und Tische bestehen aus Holz.");

  AddDetail( ({"orks","horde"}),
	    "Ein paar Orks der Horde sitzen an den Tischen und saufen "
	    "miteinander. Dabei unterhalten sie sich in einer knurrenden "
	    "Sprache.");

  AddDetail( ({"versammlungen","gast","versammlung"}),
	    "Auf einer solchen Versammlung moechtest Du ungerne zu Gast sein, "
	    "wenn hunderte von Orks hier versammelt sind um ihre naechsten "
	    "Raubzuege zu planen.");
  
  AddDetail( ({"gelagen","gelage"}),
	    "Hier finden auch die grossen Gelage der Orks statt, die immer "
	    "gefeiert werden, wenn sie von einem erfolgreichen Beutezug wieder "
	    "zurueck sind.");

  AddDetail( ({"waenden","wand","waende"}), 
            "An den Waenden ist der kahle Fels zu sehen und ein paar brennende "
	    "Fackeln. Einige Statuen stehen an den Waenden.");

  AddDetail( ({"fackeln","licht"}),
	    "Die brennenden Fackeln erhellen die Halle in einem schummrigen "
	    "Licht. Ueberall sind grosse und kleine Schatten zu sehen.");

  AddDetail( ({"statuen"}),
	    "Die Statuen bilden verschiedene Lebewesen des Silberlandes ab.");

  AddDetail( ({"lebewesen"}),
	    "Die Lebewesen sehen irgendwie eingetrocknet aus. Sie scheinen "
	    "nicht aus Stein zu bestehen.");
  
  AddDetail( ({"westen","durchgang"}),
	    "Im Westen ist der Durchgang zum Thronsaal des Orkreiches.");

  AddDetail( ({"herz"}), 
            "Das Herz des Orkreiches liegt im Westen.");

  AddDetail( ({"orkreiches","orkreich","orkhoehlen","orkhoehle","hoehlen"}),
	    "Das Orkreich erstreckt sich ueber viele Hoehlen unterhalb der "
	    "Hochebene von Gorthad.");

  AddDetail( ({"holz","mobiliar"}),
	    "Das Holz der Tische und Baenke hat teilweise tiefe Furchen und "
	    "Kerben. Die Orks gehen nicht besonders zimperlich mit dem "
	    "Mobiliar um.");

  AddDetail( ({"sprache"}),
	    "Die Sprache kannst Du hoechstens hoeren.");
  
  AddDetail( ({"raubzuege","umgebung","beutezug"}),
	    "Die Orks unternehmen regelmaessig Raubzuege in die Umgebung. Sie "
	    "haben auch schon einmal mit den Trollen zusammen die Zwergenfeste "
	    "von Ardhmir oder die Stadt der Zentauren angegriffen.");

  AddDetail( ({"trolle","trollen","verbuendeten","verbuendete"}), 
            "Die Trolle sind die natuerlichen Verbuendeten der Orks.");

  AddDetail( ({"zwergenfeste","ardhmir","zwerge","naehe"}),
	    "Die Zwergenfeste von Ardhmir ist ganz in der Naehe der "
	    "Orkhoehlen.");

  AddDetail( ({"stadt","zentauren","roch","adan","roch adan"}),
	    "Die Stadt der Zentauren ist Roch Adan und befindet sich suedlich "
	    "der Hochebene von Gorthad.");

  AddDetail( ({"gorthad","hochebene"}),
	    "Das Orkreich befindet sich in den Hoehlen unterhalb der Hochebene "
	    "von Gorthad.");
  
  AddDetail( ({"schatten","taeuschung"}),
	    "Die Schatten scheinen sich zu bewegen, was jedoch nur eine "
	    "optische Taeuschung ist.");

  AddDetail( ({"thronsaal","saal"}), 
            "Sei nicht enttaeuscht, wenn Du nach Westen gehst. Es sieht sicher "
	    "nicht so aus wie im Thronsaal der Zwerge oder Zentauren.");

  AddDetail( ({"silberlandes","silberland"}),
	    "Du bist im Silberland.");

  AddDetail( ({"boden"}),
	    "Der Boden ist uebersaeht mit Essensresten vom letzten Gelage.");

  AddDetail( ({"decke"}),
	    "Die Decke ueber Dir ist beeindruckend uninteressant.");
  
  AddDetail( ({"stein","weise"}),
	    "Du bist schockiert. Es waren einmal echte Lebewesen, die auf "
	    "irgendeine abartige Weise mumifiziert und dann von den "
	    "Orks in die Halle gestellt wurden. Du erkennst einen Ritter der "
	    "Menschen, einen Zwergenkrieger, eine Fee und ein Elf steht noch "
	    "in der Ecke.");

  AddDetail( ({"ritter","menschen","ruestung","visier","gesicht"}), 
            "Der Ritter der Menschen hat eine verbeulte Ruestung an und sieht "
	    "ziemlich herunter gekommen aus. Sein Visier ist hochgeklappt und "
	    "Du erkennst sein mumifiziertes Gesicht.");

  AddDetail( ({"fee","zustand","gestalt","fluegel","pergament"}),
	    "Die kleine Fee ist in einem erbaermlichen Zustand. Ihre kleine "
	    "mumifizierte Gestalt wirkt ausgedoerrt und ihre Fluegel sind "
	    "vertrocknet und rissig wie Pergament.");

  AddDetail( ({"zwergenkrieger","krieger","brust","pfeile","leiche","zieluebungen"}),
	    "Der mumifizierte Zwergenkrieger hat immer noch ein paar "
	    "abgebrochene Pfeile in der Brust stecken. Anscheinend wird die "
	    "mumifizierte Leiche immer noch fuer Zieluebungen von der Orks "
	    "benutzt.");

  AddSpecialDetail( ({ "elf","ecke","elfenkriegers","elfenkrieger" }), "ecke" );

  AddSpecialDetail( ({ "augen","eindruck" }), "augen" );

  AddSpecialDetail( ({ "spion","elfen" }), "spion" );  

  AddSpecialDetail( ({ "frage","gewissen" }), "frage" ); 

  AddDetail( ({"essensresten","essensreste","reste","essen","unrat"}),
	    "Es liegt viel Unrat und einige Knochen am Boden.");

  AddDetail( ({"knochen"}), 
            "Du willst eigentlich gar nicht wissen, was das fuer Knochen "
	    "sind.");

  AddDetail( ({"fels"}),
	    "Der Fels ist nicht besonders interessant.");

  AddDetail( ({"kerben","furchen"}),
	    "Die Kerben und Furchen an dem Moebiliar stammt von den Orks. Sie "
	    "haben wohl mit ihren Waffen daran rumgeschnitzt.");

  AddDetail( ({"waffen"}),
	    "Die Waffen der Orks sind spitz und sehr gefaehrlich.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es stinkt in der Halle, wie ueberall wo die Orks "
		          "hausen.");  
 
  AddSmell( ({"halle","essensresten","essen","reste","boden"}),
	   "Es stinkt nach den Essensresten auf dem Boden.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Gespraeche und das rauhe Gelaechter "
		          "der Orks.");

  AddSound( ({"gelaechter"}),
	   "Das Gelaechter klingt boesartig.");
  
  AddSound( ({"sprache","gespraeche"}),
	   "Die Sprache der Orks klingt hinterhaeltig und boesartig.");

//-----Details Ende-----
AddItem(NPC "okrieger", REFRESH_DESTRUCT);
AddItem(NPC "okrieger", REFRESH_DESTRUCT);

AddExit("sueden", ROOM "orks15");
AddExit("norden", ROOM "orks17");
AddExit("westen", ROOM "orks18");

AddCmd( ({"verrat", "verrate" }), "verraten" );

}
int verraten(string str)
{
 notify_fail("Wen moechtest Du verraten?\n");
 if ( member( ({ "spion", "elf" }),str) != -1) 
  {
   if ( anzahl )
    {
    write(BS( "Du zeigst auf den Elfen, der sich als Statue tarnt und rufst "
	      "laut: Spion!\n"));
    say( TPN+" zeigt auf eine Statue und ruft laut: Spion!. Ein paar Orks "
	     "springen auf und stuerzen sich auf eine Statue die zum Leben "
	     "erwacht. Ein Kampf zwischen einem Dutzend Orks und einem Elfen "
	     "beginnt, der jedoch nicht lange dauert.\n");
    anzahl--;
    TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN)-300);
    TP->SetProp(P_PARALYZED, ([
                PARALYZE_TIME: 15,
                PARALYZE_MSG: "Du bist so fasziniert von der Situation, so "
		              "dass Du Dich nicht ruehren kannst.\n",
                PARALYZE_END: "Du erwachst aus Deiner Starre, die Du waehrend "
		              "des Kampfes hattest.\n"]) );	
      call_out("fall1",5);
    AddItem(OBJ "leicheo1");
    AddItem(OBJ "leicheo2");
    AddItem(OBJ "leichee");
    return 1;
    }
    else
    {
    write(BS( "Es ist ja niemand da, den Du verraten kannst.\n"));
    say( TPN+" scheint an Paranoia zu leiden.\n");
    return 1;   
    }
  }
}
void fall1()
{
  write(BS( "Die Orks in der Halle springen mit Gebruell von den Baenken auf "
	    "und stuerzen sich auf den Elfen und ein brutaler Kampf "
	    "beginnt.\n"));
  call_out("fall2",5);
}
void fall2()
{
  write(BS( "Die Orks schlagen mit aller Brutalitaet auf den Elfen ein, der "
	    "behaende den Orks ausweicht und dabei einen der Angreifer "
	    "niedersticht.\n"));
  call_out("fall3",5);
}
void fall3()
{
  write(BS( "Die Orks aendern ihre Taktik und greifen gleichzeitig an. Der "
	    "Elf kann den ersten Angriffen ausweichen und einen zweiten "
	    "Ork niederstrecken, bis ein starker Axthieb ihn.......\n"));
  call_out("fall4",6);
}
void fall4()
{
  write(BS( "Nachdem der Elf von den Orks niedergemetzelt wurde, bedanken sich "
	    "die Orks bei Dir und verteilen die Habseligkeiten des Elfen und "
	    "ihrer Kollegen untereinander.\n"));
}
void reset()
{
  ::reset();
  anzahl=1;
}
string ecke(string key)
{
    if ( anzahl )
    {
    return(BS("In der Ecke steht noch ein Elf. Der Elf macht jedoch einen "
	      "recht frischen Eindruck. Anscheinend wurde er erst kuerzlich "
	      "hier aufgestellt. Vor allem die Augen des Elfenkriegers machen "
	      "auf Dich einen faszinierenden Eindruck."));
    }
    else
    {
    return(BS("Du musst Dich wohl getaeuscht haben. In der Ecke steht kein "
	      "Elf."));
    }
}
string augen(string key)
{
    if ( anzahl )
    {
    return(BS("Dein Herz bleibt beinahe stehen, als Du merkst, dass der Elf "
	      "blinzelt. Er ist gar keine mumifizierte Statue, sondern ein "
	      "Spion der Elfen, der die Orks ausspioniert."));
    }
    else
    {
    return(BS("Hier sind gar keine Augen, die Du betrachten kannst."));
    }
}
string spion(string key)
{
    if ( anzahl )
    {
    return(BS("Stellt sich fuer Dich nur die Frage, ob Du ihn an die Orks "
	      "verraetst oder ob Du ihn weiter spionieren laesst."));
    }
    else
    {
    return(BS("Sowas siehst Du hier nicht."));
    }
}
string frage(string key)
{
    if ( anzahl )
    {
    return(BS("Kannst Du das mit Deinem Gewissen vereinbaren? Verraten oder "
	      "nicht?"));
    }
    else
    {
    return(BS("Du stellst Dir oft Fragen."));
    }
}
