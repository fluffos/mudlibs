void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"Die Kammer ist nicht besonders gross und wurde grob in den Stein "
	"gehauen. In einer Ecke steht ein kaputtes Bett mit alten dreckigen "
	"Decken und an einer Wand steht ein alter Kleiderschrank. Ansonsten "
	"ist in der Kammer nicht viel zu sehen, ausser dass es hier sehr "
	"schmutzig ist." );
