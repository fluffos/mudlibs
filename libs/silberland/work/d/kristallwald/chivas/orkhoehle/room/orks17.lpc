// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"Der Gang fuehrt nach Sueden in eine grosse geraeumige Kammer. "
	"Ansonsten wirkt der Gang sehr sauber und viel gepflegter als "
	"die Tunnel im Osten. Die Waende sind glatt und ab und zu sind sogar "
	"kleine eingeritzte Zeichnungen zu sehen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"gang"}), 
            "Der Gang ist ein wenig sauberer als die Tunnel im Osten. Es ist "
	    "jedoch nicht so, als ob es sauber waere, es ist jedenfalls nicht "
	    "ganz so dreckig.");

  AddDetail( ({"kammer","halle","sueden"}),
	    "Im Sueden ist eine Kammer, die sehr gross ist. Man koennte sogar "
	    "sagen es ist eine grosse Halle.");

  AddDetail( ({"tunnel","osten"}),
	    "Die Tunnel im Osten sind besonders dreckig und stickig.");

  AddDetail( ({"waende","waenden","wand"}),
	    "An den Waenden sind verschiedene kleinere Zeichnungen zu sehen. "
	    "Ausserdem haengen brennende Fackeln an den Waenden.");
  
  AddDetail( ({"zeichnungen"}),
	    "Die Zeichnungen wurden von den Orks in die Wand gekratzt. Als Du "
	    "sie genauer betrachtest wirst Du rot. Es handelt sich "
	    "hauptsaechlich um obszoene Grafiken.");

  AddDetail( ({"boden"}), 
            "Der Boden ist ein wenig staubig, aber bei weitem nicht mehr so "
	    "dreckig wie im Osten.");

  AddDetail( ({"decke"}),
	    "An der Decke haengen ein paar Fledermaeuse und schlafen.");

  AddDetail( ({"fackeln","probleme"}),
	    "Die Fackeln erhellen den Gang soweit, dass Du ohne Probleme "
	    "sehen kannst.");

  AddDetail( ({"grafiken","mudder"}),
	    "Da es hier minderjaehrige Mudder gibt, werden diese Grafiken "
	    "nicht weiter beschrieben.");
  
  AddDetail( ({"fledermaeuse"}),
	    "Die Fledermaeuse lassen sich von Dir nicht stoeren.");

  AddDetail( ({"hoehlen","orkhoehlen"}), 
            "Die Orkhoehlen sind unter der Hochebene sehr weitreichend und "
	   "man kann sich sehr schnell verlaufen, wenn man nicht aufpasst. ");

  AddDetail( ({"hochebene","gorthad"}),
	    "Das Orkreich befindet sich unterhalb der Hochebene von Gorthad.");

  AddDetail( ({"orkreich"}),
	    "Das Orkreich ist sehr weitlaeufig. Die Hoehlen bilden ein "
	    "schoenes Labyrinth und man kann sich gut verlaufen, wenn man sich "
	    "den Weg nicht aufschreibt.");

  AddDetail( ({"labyrinth","weg"}),
	    "Da Du aber schon bis hier her gekommen bist, ist zu vermuten, "
	    "dass Du Dir den Weg auch gemerkt hast.");
  
  AddDetail( ({"orks","hunderte"}),
	    "In den Hoehlen leben Hunderte von Orks.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht in diesem Gang ausnahmsweise nicht so "
		  "streng wie sonst in den Hoehlen.");  
 
  AddSmell( ({"gang"}),
	   "Es riecht nicht zu uebel, aber auch noch nicht gut.");

  AddSound(DEFAULT_SOUND, "Du hoerst Lachen und Gerede aus dem Sueden.");

  AddSound( ({"sueden","lachen","gerede"}),
	   "Geh doch einfach mal hin, vielleicht hoerst Du dann mehr.");
  
//-----Details Ende-----
  
AddExit("suedosten", ROOM "orks14");
AddExit("sueden", ROOM "orks16");

}

