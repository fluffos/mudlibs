// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"Der Gang ist nicht so grob behauen wie der Tunnel im Osten. Die "
	"Waende sind glatt und die Fackelhalter sind nicht mehr rostig, "
	"sondern leuchten im Schein der Fackeln blaeulich wie blanker Stahl. "
	"Nach Westen verweigt der Gang nach Suedwesten und Nordwesten." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"gang"}), 
            "Der Gang ist nicht mehr so grob behauen. Die Waende wurden "
	    "anscheinend von den Orks nachtraeglich bearbeitet und "
	    "geglaettet.");

  AddDetail( ({"tunnel","osten"}),
	    "Ein Tunnel fuehrt nach Osten und in andere Teile der Orkhoehlen.");

  AddDetail( ({"waende","wand","waenden"}),
	    "Die Waende sind von den Orks bearbeitet worden und glatt. Sie "
	    "haben sicher nicht die Klasse der Zwerge, aber fuer die Orks ist "
	    "es schon eine recht grosse Leistung. Einige Fackeln erhellen den "
	    "Gang.");

  AddDetail( ({"fackelhalter","halter","fackelhaltern"}),
	    "An den Fackelhaltern ist keinerlei Rost mehr zu sehen. Sie sehen "
	    "fast neu aus. Sicher haben die Orks sie irgendwo geklaut und hier "
	    "aufgehaengt.");
  
  AddDetail( ({"rost"}),
	    "Es ist kein Rost an den Haltern zu erkennen. Rost siehst Du nur "
	    "an Halterungen im Osten.");

  AddDetail( ({"schein","fackeln"}), 
            "Der Schein der Fackeln erhellt den Gang, so dass Du alles gut "
	    "erkennen kannst.");

  AddDetail( ({"stahl"}),
	    "Der Stahl der Halter funkelt blaeulich im Schein der Fackeln.");

  AddDetail( ({"westen","nordwesten","suedwesten"}),
	    "Du kannst nach Westen in den Tunnel gehen oder in die Gaenge "
	    "nach Nordwesten und Suedwesten.");

  AddDetail( ({"boden","pfuetzen"}),
	    "Selbst der Boden ist hier sauberer. Er ist zwar feucht, aber es "
	    "bilden sich hier keine Pfuetzen.");
  
  AddDetail( ({"decke"}),
	    "Die Decke ist nicht interessant. Einige Spinnweben kann man an "
	    "ihr sehen.");

  AddDetail( ({"teile","orkhoehlen","hoehlen"}), 
            "Die Orkhoehlen sind ziemlich gross.");

  AddDetail( ({"orks","leistung"}),
	    "Die geraden und behauenen Waende sind eine grosse Leistung fuer "
	    "die Orks, die ansonsten nicht sehr gut in solchen Dingen sind.");

  AddDetail( ({"zwerge","klasse","steinmetzarbeiten","arbeiten"}),
	    "Die Steinmetzarbeiten haben nicht die Klasse der Zwerge. Die "
	    "Zwerge sind viel besser als die Orks in solchen Arbeiten.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen im Osten sind sehr rostig, aber hier ist kein "
	    "Rost zu sehen.");
  
  AddDetail( ({"gaenge"}),
	    "Die Gaenge fuehren nach Nordwesten und Suedwesten.");

  AddDetail( ({"spinnweben"}), 
            "Die Spinnweben sind schon seit langer Zeit verlassen.");

  AddDetail( ({"dingen","dinge"}),
	    "Damit sind alle Dinge gemeint, die nichts mit Toeten, Meucheln "
	    "oder Rauben zu tun hat.");

  AddDetail( ({"zeit"}),
	    "Es ist schon lange her.");

  AddDetail( ({"toeten","meucheln","rauben","taetigkeiten"}),
	    "Fuer solche Taetigkeiten gibt es nicht viele, die besser sind "
	    "als die Orks.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es stinkt wie ueberall hier.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst das Flackern der Fackeln.");

  AddSound( ({"fackeln","flackern"}),
	   "Die Fackeln flackern ein wenig: flacker, flacker, flacker.");
  
//-----Details Ende-----
  
AddExit("osten", ROOM "orks11");
AddExit("nordwesten", ROOM "orks17");
AddExit("suedwesten", ROOM "orks15");

}

