inherit "std/pub";

#include "../def.h"
#include <pub.h>


void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp(P_INT_SHORT,"In der Kneipe 'Zum Zwergenschlaechter'");
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "kragnarr");
  SetProp(P_PUBKEEPER_NAME, "kragnarr");
  SetProp(P_PUBMSG_NOKEEPER, "Kragnarr ist leider nicht hier.\n");
  SetProp(P_PUBMSG_NOENEMY, BS(
      "Du bist gerade in einem verbissen Kampf mit Kragnarr. Kein Wunder, "
      "dass er Dich nicht bedient."));
  SetProp(P_PUBMSG_NOINVITE, BS(
      "Kragnarr kaempft. Da hat er wahrhaft andere Sorgen als Kunden."));
  SetProp(P_PUBMSG_FIGHTING, "Kragnarr kaempft gerade.\n");

  AddDrink("Kampfbraeu", ({"bier","braeu","kampfbraeu"}),
           400, 55, 10, 6,
           ({"Kragnarr laechelt und bringt Dir einen Humpen Kampfbraeu.\n",
             "&& trinkt einen Humpen Kampfbraeu.\n"}));

  AddDrink("Whisky", ({"whisky"}),
            220, 28, 11, 1,
           ({"Krangnarr bringt Dir ein Glas Whisky.\n"
            +"ROECHEL!!!! Der hat es in sich!!\n",
             "&& trinkt ein Glas Whisky japst nach Luft.\n"}));

  AddDrink("Kraeutertee", ({"kraeutertee","tee"}),
            150, 15, 0, 5,
           ({"Krangnarr bringt Dir eine Tasse Kraeutertee.\n"
            +"Der schmeckt ja richtig lecker!\n",
             "&& trinkt eine Tasse Kraeutertee und ist enzueckt.\n"}));

  AddFood("Nudelsuppe", ({"suppe", "nudelsuppe"}), 200, 40, 17,
           ({"Krangnarr bringt Dir eine leckere Nudelsuppe. "
            +"\nHmmmm, die ist lecker und sehr deftig.\n",
             "&& isst eine Nudelsuppe.\n"}));
  AddFood("Ein leckeres Haehnchen", ({"haehnchen"}), 250, 30, 10,
           ({"Krangnarr bringt Dir ein leckeres Haehnchen!\n"
            +BS("Wow, die Haut ist sehr knusprig. Es ist aussergewoehnlich "
                "lecker."),
             "&& isst gierig ein lecker aussehendes Haehnchen!\n"}));

// ----------  Details  ---------------------

  AddDetail( ({"boden"}),
	    "Der Boden ist sehr schmutzig vom Dreck, den die Gaeste mit in "
	    "die Kneipe geschleppt haben.");

  AddDetail( ({"decke"}),
	    "Die Decke ist kahl und uninteressant.");

  AddDetail( ({"dreck"}),
	    "Der Dreck ist schoen schlammig. Es wird keinen Spass machen, "
	    "hier durchzuwischen.");

  AddDetail( ({"spass"}),
	    "Wer braucht schon Spass?");

  AddDetail( ({"kopf","koepfe"}),
	    "Du siehst die Koepfe von einem Elfen, einem Menschen und einer "
	    "Fee an der Wand haengen.");

  AddDetail( ({"elfen","auge","messer"}),
	    "Der Kopf des Elfen sieht sehr schlecht praepariert aus. Ein "
	    "langes Messer steckt auch noch im Auge des Elfen.");

  AddDetail( ({"menschen","eindruck","axt"}),
	    "Der Kopf des Menschen sieht sehr mitgenommen aus. Dieser "
	    "Eindruck entsteht sicher durch die Axt, die noch in dem Kopf "
	    "steckt.");

  AddDetail( ({"fee","bisswunden","biss"}),
	    "Der Kopf der Fee hat starke Bisswunden. Der Wirt hat "
	    "die Fee anscheinend durch einen Biss getoetet.");

  AddDetail( ({"wunder"}),
	    "Wunder gibt es immer wieder.");

  AddDetail( ({"holz"}),
	    "Die Tische und Baenke bestehen aus altem Holz.");

  AddDetail( ({"hochebene","gorthad","huegelgraeber"}),
	    "Schau Dir die Hochebene doch einmal an und vor allem die "
	    "Huegelgraeber, die es dort gibt.");

  AddDetail( ({"orkhoehlen","hoehlen"}),
	    "Die Kneipe, in der Du stehst, befindet sich in den weitlaeufigen "
	    "Orkhoehlen. Die Hoehlen selber befinden sich unterhalb der "
	    "Hochebene von Gorthad.");

  AddDetail( ({"tellern","teller"}),
	    "Die Teller sehen schmutzig aus. Hoffentlich sehen sie sauberer "
	    "aus, wenn sie abgewaschen sind.");

  AddDetail( ({"glaesern","glaeser","platz"}),
	    "Die Glaeser sind meistens leer. Der Wirt koennte sie mal "
	    "abraeumen und ein wenig Platz schaffen.");

  AddDetail( ({"trophaeen","trophaee"}),
	    "An den Waenden haengen einige Trophaeen des Wirtes. Du erkennst "
	    "den Kopf von einem Elfen, einem Menschen und den einer Fee.");

  AddDetail( ({"selbstdarstellung","protzerei","sachen"}),
	    "Selbstdarstellung und Protzerei sind Sachen, mit denen Du Dich "
	    "hervorragend auskennst.");

  AddDetail( ({"gaeste"}),
	    "Es sind fast nur Orks als Gaeste in der Kneipe.");

  AddDetail( ({"hunger"}),
	    "Eigentlich hast Du immer Hunger.");
  
  AddDetail( ({"bier","kampfbraeu"}),
	    "Hier kannst Du auch Bier bestellen, das beruehmte Kampfbraeu der "
	    "Orks.");

  AddDetail( ({"kneipe","zum","zwergenschlaechter"}),
	    "Du befindest Dich in der Kneipe 'Zum Zwergenschlaechter'.");

  AddDetail( ({"menue","tafel"}),
	    "Das Menue haengt an der Wand. Tipp 'menue' und Du siehst was Du "
	    "bestellen kannst.");

  AddDetail( ({"wirt","wirtes"}),
	    "Der Wirt dieser Kneipe steht vor Dir oder ist gerade nicht da.");

  AddDetail( ({"raum"}),
	    "Der Raum ist eine Kneipe. Du stehst an der Theke.");

  AddDetail( ({"geschichten"}),
	    "Du kannst die Geschichten nicht untersuchen, sondern hoechstens "
	    "hoeren.");

  AddDetail( ({"halterung","halterungen","eisen"}),
	    "Die Halterungen bestehen aus Eisen. Sie sind nicht so "
	    "verrostet wie die anderen, die Du schon in den Hoehlen gesehen "
	    "hast.");

  AddDetail( ({"orks"}),
	    "Es leben sehr viele Orks in diesen Hoehlen.");
  
  AddDetail( ({"baenke"}),
	    "Die Baenke sind fast alle von Orks besetzt. Es ist ja auch kein "
	    "Wunder, schliesslich befindest Du Dich in den Orkhoehlen.");

  AddDetail( ({"tische"}),
	    "Die Tische bestehen aus dickem Holz und sind voll beladen von "
	    "Glaesern und Tellern.");

  AddDetail( ({"seite","theke"}),
	    "An der hinteren Seite der Hoehle ist eine lange Theke zu sehen. "
	    "Einige Gaeste sind an sie gelehnt und trinken miteinander.");

  AddDetail( ({"wand","waende","waenden"}),
	    "An den Waenden haengen einige Trophaeen des Wirtes und die "
	    "Halterungen fuer die Fackeln.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln an den Waenden erhellen die Kneipe ein wenig.");
  
  AddDetail( ({"hoehle"}),
	    "In dieser Hoehle befindet sich die Kneipe 'Zum "
	    "Zwergenschlaechter'. Es ist eine typische Kneipe der Orks.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Essen und Alkohol.");  
 
  AddSmell( ({"essen"}),
	   "Das Essen riecht sehr lecker und Du bekommst Hunger.");

  AddSmell( ({"alkohol"}),
	   "Bei soviel Alkohol in der Luft wird man ja fast schon besoffen.");

  AddSmell( ({"luft"}),
	   "Du faengst an zu wanken.");

  AddSound(DEFAULT_SOUND, "Du hoerst wie die Orks Geschichten erzaehlen.");

  AddSound( ({"orks","geschichten"}),
	   "Die Geschichten, die die Gaeste erzaehlen, bestehen hauptsaechlich "
	   "aus Selbstdarstellung und Protzerei.");
  
// ----------- Details Ende -------------------

  AddExit("sueden", ROOM "orks7");

  AddItem(NPC "kragnarr", REFRESH_DESTRUCT);
}

string _query_int_long()
{
  string txt;

  txt = "Du stehst in einer halbdunklen Hoehle, in der ein paar Fackeln an der "
	"Wand haengen. An der hinteren Seite der Hoehle siehst Du eine lange "
        "Theke und ansonsten sind ueberall Tische und Baenke zu sehen, auf "
	"denen hauptsaechlich Orks sitzen und laut groehlend Geschichten "
	"erzaehlen. Gleich neben der Theke haengt eine Tafel an der Wand, die "
	"Du mit 'menue' lesen kannst. ";

  if(QueryProp(P_PUBKEEPER_ID))
  {
    if(!present(QueryProp(P_PUBKEEPER_ID)))
    {
      txt += "Seltsamerweise ist offenbar gerade niemand hier der Dich "
        "bedienen koennte.";
    }
    else
    {
      txt += "Der Wirt steht hinter der Theke und laechelt Dich "
        "freundlich an.";
    }
  }

  return BS(txt);
}
