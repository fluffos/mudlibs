
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

SetProp(P_INT_SHORT,"In einem Tempel");
SetProp(P_INT_LONG,
   "Du befindest Dich im Heiligtum der Orks. Grosse Becken mit brennendem "
   "Feuer sind aufgestellt und verursachen eine grosse Hitze. Am Ende der "
   "grossen Hoehle ist ein Altar gebaut worden, der schreckliche Gravuren "
   "besitzt. An den Seitenwaenden stehen einige Skulpturen und von der Decke "
   "haengen riesige Stalagtiten herab.");
SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_CAVE]) );
SetProp(P_INDOORS, 1);
SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
 
  AddDetail( ({"heiligtum","tempel","art","tempels"}),
	    "Die scheint eine Art Tempel von den Orks zu sein, wo sie zu ihren "
	    "Goettern beten.");
 
  AddDetail( ({"becken"}),
	    "In den grossen Becken, die in der gesamten Hoehle aufgestellt "
	    "sind, brennen Feuer, die die Hoehle erhellen.");
 
  AddDetail( ({"feuer"}),
	    "Die Feuer strahlen eine grosse Hitze aus.");
 
  AddDetail( ({"hitze"}),
	    "Die Hitze ist beinahe unertraeglich.");
 
  AddDetail( ({"ende","altar"}),
	    "Am Ende der Hoehle steht ein alter Altar auf denen Gravuren und "
	    "Symbole zu sehen sind.");
 
  AddDetail( ({"hoehle","ursprung","ursprungs"}),
	    "Die Hoehle in der Du stehst, wird von den Orks als Tempel "
	    "genutzt. Sie ist natuerlichen Ursprungs, was man an den "
	    "Stalagtiten sehen kann, die von der Decke haengen.");
 
  AddDetail( ({"gravuren"}),
	    "Die Gravuren sehen schrecklich aus und zeigen widerliche und "
	    "greuliche Szenen.");
 
  AddDetail( ({"seitenwaenden","seitenwaende"}),
	    "An den Seitenwaenden des Tempels stehen grosse Skulpturen aus "
	    "Stein.");
 
  AddDetail( ({"skulpturen","stein"}),
	    "Die Skulpturen bestehen aus Stein und stellen verschiedene "
	    "Fuehrer der Horde dar, die hier in der Vergangenheit geherrscht "
	    "haben.");
 
  AddDetail( ({"decke","stalagtiten"}),
	    "Lange Stalagtiten haengen von der Decke. Auch ein paar "
	    "Fledermaeuse sind zu erkennen.");
 
  AddDetail( ({"waenden","wand","waende"}),
	    "An den Seitenwaenden stehen grosse Skulpturen und am Ende steht "
	    "ein Altar.");
 
  AddDetail( ({"boden"}),
	    "Am Boden sind lauter dunkle Flecken zu erkennen.");
 
  AddDetail( ({"orks"}),
	    "Die Orks beten hier zu ihren Goettern.");
 
  AddDetail( ({"goetter","goettern"}),
	    "Die Goetter der Orks sind schreckliche Wesen.");
 
  AddDetail( ({"symbole"}),
	    "Die Symbole am Altar kannst Du nicht entziffern.");
 
  AddDetail( ({"szenen","greuel"}),
	    "Die Szenen zeigen allerlei Greuel, die hier wegen der jugendlichen "
	    "Mudder, nicht weiter beschrieben werden duerfen.");
 
  AddDetail( ({"horde"}),
	    "Die Horde der Orks lebt in diesen Hoehlen schon seit "
	    "Jahrhunderten.");
 
  AddDetail( ({"fuehrer","vergangenheit","krieger"}),
	    "Die Skulpturen, die die Fuehrer der Vergangenheit darstellen, "
	    "sehen wie schreckliche Krieger aus. Du bist froh, dass sie der "
	    "Vergangenheit angehoeren.");
 
  AddDetail( ({"fledermaeuse"}),
	    "Einige Fledermaeuse haengen von der Decke. Lass sie ruhig "
	    "schlafen.");
 
  AddDetail( ({"flecken"}),
	    "Die dunklen Flecken am Boden scheinen getrocknetes Blut zu sein. "
	    "Anscheinend wurden hier auch Opfer dargebracht.");
 
  AddDetail( ({"wesen"}),
	    "Es sind boesartige Wesen, ueber die Du nicht viel weisst, was "
	    "wohl sicher auch besser so ist.");
 
  AddDetail( ({"mudder","muddern"}),
	    "Du gehoerst auch zu den Muddern.");
 
  AddDetail( ({"jahrhunderten","jahrhunderte","zeit"}),
	    "Das ist schon eine lange Zeit.");
 
  AddDetail( ({"opfer"}),
	    "Du bist froh, dass Du nicht zu den Opfern gehoerst.");
 
  AddDetail( ({"blut"}),
	    "Du bist Dir ziemlich sicher, dass es Blut ist.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","es","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Blut.");  
 
  AddSmell( ({"blut","geruch","flecken"}),
	   "Der Geruch geht von den dunklen Flecken am Boden aus.");

  AddSound(DEFAULT_SOUND, "Du hoerst gar nichts. Es ist sehr still hier.");

//-----Details Ende-----

AddExit("sueden", ROOM "orks22");

AddCmd( ({"bete","bete"}), "beten" );

}
int beten() {
   write("Du haeltst eine kurzes Gebet.\n");
   if (this_player()->QueryProp(P_GHOST))
   {
	write(BS("Eine sehr starke Kraft durchfliesst Dich und gibt Dir wieder Kraft.\n"));
	say(this_player()->name()+" erscheint in koerperlicher Form.\n");
	this_player()->SetProp(P_GHOST,0);
   }
   return 1;
}

