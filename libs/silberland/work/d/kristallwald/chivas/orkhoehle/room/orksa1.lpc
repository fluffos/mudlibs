// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Im Anfaengerpark der Orkhoehle");
  SetProp( P_INT_LONG,
	"Du stehst im Anfaengerpark der Orkhoehlen. Die Hoehlen hier sind "
	"hauptsaechlich fuer die ersten Versuche der jungen Orks gedacht. Die "
	"Hoehle ist von einigen Fackeln erhellt, so dass Du alles gut erkennen "
	"kannst. Am Boden wachsen einige Moose und Flechten." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"anfaengerpark","park","anfaenger"}),
	    "Du befindest Dich im Anfaengerpark, wo kleine Spieler und "
	    "Anfaenger ihre ersten Gehversuche machen koennen.");

  AddDetail( ({"orkhoehlen","hoehlen","hoehle"}),
	    "Die Orkhoehlen sind weitlaeufig und gefaehrlich. Hier jedoch "
	    "haben kleine Spieler ihre Ruhe, um alles genau zu erforschen "
	    "und um erste Erfahrung zu sammeln.");
  
  AddDetail( ({"versuche","gehversuche"}),
	    "Hier koennen Anfaenger und junge Orks ihre ersten Erfahrungen "
	    "machen, ohne gefaehrliche Monster zu treffen.");

  AddDetail( ({"orks"}), 
            "Die jungen Orks koennen sich hier richtig austoben. Du natuerlich "
	    "auch.");

  AddDetail( ({"fackeln","schein"}),
	    "Die Fackeln, die an den Waenden haengen, erhellen die Hoehle sehr "
	    "gut, so dass Du alles genau sehen kannst.");

  AddDetail( ({"boden"}),
	    "Am Boden wachsen einige Moose und Flechten. Ansonsten ist der "
	    "Boden mit viel Dreck bedeckt.");

  AddDetail( ({"waende","waenden","wand"}),
	    "An den Waenden haengen Fackeln in Halterungen und auch einige "
	    "Moose und Flechten sind am Fels der Wand zu sehen.");
  
  AddDetail( ({"decke"}),
	    "Die Decke befindet sich komischerweise wirklich ueber Dir, jedoch "
	    "ist sie aeusserst uninteressant.");

  AddDetail( ({"moose","moosen"}),
	    "Die Moose wachsen recht gut im Schein der Fackeln.");
  
  AddDetail( ({"flechten"}),
	    "Die Flechten wachsen am Boden und den Waenden.");

  AddDetail( ({"spieler"}), 
            "Kleine Spieler koennen hier ihre ersten Erfahrungen sammeln. Fuer "
	    "etwas groessere Spieler ist es hier nicht mehr so interessant.");

  AddDetail( ({"erfahrung","erfahrungen"}),
	    "Die ersten Erfahrungen sind die wichtigsten.");

  AddDetail( ({"monster"}),
	    "Grosse und gefaehrliche Monster wirst Du hier im Anfaengerpark "
	    "nicht finden.");

  AddDetail( ({"dreck"}),
	    "Der Dreck am Boden ist sehr schlammig, da es in der Hoehle sehr "
	    "feucht ist.");
    
  AddDetail( ({"fels"}),
	    "Der blanke Fels ist zwischen den Moosen und Flechten zu sehen.");

  AddDetail( ({"ruhe"}),
	    "Hier hast Du deine Ruhe.");
  
  AddDetail( ({"halterungen"}),
	    "Die Halterungen der Fackeln sind alt und verrostet.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Rauch.");  
 
  AddSmell( ({"rauch"}),
	   "Der Rauch stammt von den Fackeln, die hier in der Hoehle brennen.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Fackeln flackern.");

  AddSound( ({"fackeln"}),
	   "*flacker*");
  
//-----Details Ende-----
  
AddExit("suedoben", ROOM "orks12");
AddExit("westen", ROOM "orksa8");
AddExit("norden", ROOM "orksa4");
AddExit("osten", ROOM "orksa2");

}

