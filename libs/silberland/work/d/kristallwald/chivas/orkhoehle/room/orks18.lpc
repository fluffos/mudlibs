// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"Du stehst in einer riesigen Hoehle. Grosse Saeulen, die jedoch nur "
	"grob behauen sind, stuetzen die Decke, die weit ueber Dir im "
	"Schein der Fackeln zusehen ist. Die Waende sind mit Steinmetzarbeiten "
	"'verschoent' worden. An der Westwand steht ein grosser steinerner "
	"Thron auf einem Podest und ist ueber ein paar Stufen zu erreichen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"hoehle","thronsaal","saal","orkhoehle"}), 
            "Die riesige Hoehle in der Du stehst ist anscheinend der Thronsaal "
	    "des Orkfuersten. Einen Thronsaal hast Du Dir zwar bisher immer "
	    "ein wenig schoener vorgestellt, aber Geschmaecker sind ja "
	    "bekannterweise verschieden.");

  AddDetail( ({"saeulen"}),
	    "Die Saeulen sehen grob behauen aus. Man merkt, dass die Orks "
	    "nicht fuer solche Aufgaben geschaffen sind.");

  AddDetail( ({"decke"}),
	    "An der Decke ist bis auf den Fels nicht viel zu erkennen.");

  AddDetail( ({"schein","fackeln","licht"}),
	    "Der Schein der Fackeln erhellt die Hoehle soweit, dass Du alles "
	    "gut erkennen kannst.");
  
  AddDetail( ({"waende","waenden","wand"}),
	    "An den Waenden haengen einige Fackeln, die genuegend Licht "
	    "spenden um alles genau zu erkennen. Ausserdem sind einige "
	    "Steinmetzarbeiten der Orks zu sehen. An der Westwand steht ein "
	    "Thron auf einem Podest.");

  AddDetail( ({"steinmetzarbeiten","arbeiten"}), 
            "Die Steinmetzarbeiten, soweit man sie als solche bezeichnen "
	    "kann, sind von einer miserablen Qualitaet. Sie zeigen anscheinend "
	    "irgendwelche Siegesszenen der Orks.");

  AddDetail( ({"westwand"}),
	    "An der Westwand steht ein grosser Thron auf einem Podest, dass "
	    "man ueber ein paar Stufen erklimmen muss.");

  AddDetail( ({"thron","ruecken"}),
	    "Der Thron sieht schaurig aus. Anscheinend wurde er aus grossen "
	    "und kleinen Knochen von den Opfern der Orks zusammen gebaut. "
	    "Dir laeuft es eiskalt den Ruecken runter.");

  AddDetail( ({"podest"}),
	    "Auf dem Podest an der Westwand, welches man durch ein paar "
	    "Stufen erklimmen muss, steht ein grosser Thron aus Knochen, der "
	    "dem Fuersten der Orkhoehle vorbehalten ist.");
  
  AddDetail( ({"stufen"}),
	    "Die Stufen sind grob behauen und schief. Sie genuegen aber um "
	    "das Podest zu betreten, auf dem der Thron steht.");

  AddDetail( ({"boden","ort"}), 
            "Der Boden ist uneben und feucht, wie die gesamte Hoehle. Es ist "
	    "einfach ein Ort, an dem man sich nicht besonders heimisch "
	    "fuehlt.");

  AddDetail( ({"orkfuersten","orkfuerst","fuerst"}),
	    "Der Orkfuerst sitzt normalerweise auf seinem Thron.");

  AddDetail( ({"geschmaecker","geschmack"}),
	    "Du hast normalerweise einen exzellenten Geschmack.");

  AddDetail( ({"orks"}),
	    "Die Orks bewohnen diese Hoehlen.");
  
  AddDetail( ({"aufgaben","gebieten"}),
	    "Die Orks sind viel besser auf anderen Gebieten, wie z.B. "
	    "unschuldige Wesen ruecklings niederzumetzeln.");

  AddDetail( ({"fels"}), 
            "Der Fels ist ueberall in der Hoehle zu sehen.");

  AddDetail( ({"qualitaet","anblick","babyzwerg","baby","traenen"}),
	    "Beim Anblick der Qualitaet der Steinmetzarbeiten wuerden die "
	    "Zwerge in Traenen ausbrechen. Sogar ein Babyzwerg kann schon "
	    "schoener steinmetzen.");

  AddDetail( ({"siegesszenen","szenen"}),
	    "Die Siegesszenen zeigen die Hochebene von Gorthad und einen "
	    "Ueberfall auf das Volk der Menschen, die dort vor langer Zeit "
	    "gelebt haben.");

  AddDetail( ({"opfern","opfer","knochen","groesse"}),
	    "Die Knochen haben unterschiedliche Groesse und stammen "
	    "anscheinend von verschiedenen Rassen aus dem Silberland.");
  
  AddDetail( ({"hoehlen"}),
	    "Die Hoehlen der Orks sind sehr weitlaeufig und befinden sich "
	    "unterhalb der Hochebene von Gorthad.");

  AddDetail( ({"wesen"}), 
            "Pass gut auf Dich auf!");

  AddDetail( ({"zwerge","zwerg","kunst"}),
	    "Die Zwerge beherrschen diese Kunst besonders gut.");

  AddDetail( ({"rassen","elfen","zwergen","zentauren"}),
	    "Es gibt verschiedene Rassen im Silberland. Du erkennst Knochen "
	    "von Menschen, Elfen, Zwergen und Zentauren. Es sind natuerlich "
	    "auch Knochen vorhanden, die Du momentan gar nicht zuordnen "
	    "kannst.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland.");
  
  AddDetail( ({"hochebene","gorthad"}),
	    "Die Hochebene von Gorthad befindet sich oberhalb dieser Hoehlen.");

  AddDetail( ({"ueberfall","volk","menschen","zeit","uebergriffe"}), 
            "Der Ueberfall auf das Volk der Menschen war vor langer Zeit, noch "
	    "bevor die Huegelgraeber auf der Hochebene entstanden sind. Die "
	    "Menschen sind durch die Uebergriffe der Orks vertrieben oder "
	    "getoetet worden.");

  AddDetail( ({"huegelgraeber"}),
	    "Es gibt viele Huegelgraeber auf der Hochebene von Gorthad. Schau "
	    "sie Dir doch mal an.");

  AddDetail( ({"hoehlensystem"}),
	    "Die Hoehlen der Orks sind sehr weitlaeufig.");

  AddDetail( ({""}),
	    "");
  
  AddDetail( ({""}),
	    "");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es stinkt wie in dem gesamten Hoehlensystem der "
		  "Orks.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst das Geknurre der Orks, die hier ihren "
		  "Taetigkeiten nachgehen.");

  AddSound( ({"orks","geknurre","taetigkeiten"}),
	   "Es klingt nicht besonders hoeflich.");
  
//-----Details Ende-----

AddItem(NPC "ofuerst", REFRESH_DESTRUCT);

AddExit("osten", ROOM "orks16");

AddCmd( ({"betret", "betrete" }), "betreten" );

}
int betreten(string str)
{
   notify_fail("Was moechtest Du betreten?\n");
   if ( member( ({ "podest","stufen" }),str) != -1) 
  {
    write(BS ( "Du betrittst die erste Stufe und wirst sofort von ein paar "
	       "Orkwachen wieder zurueck gedraengt.\n"));
    return 1;
  }
}

