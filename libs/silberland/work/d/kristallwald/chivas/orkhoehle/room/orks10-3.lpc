// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Du stehst mitten in der Graslandschaft der Hochebene. Im Osten sind "
	"ein paar Huegelgraeber zu sehen und im Westen geht es zu einem Weg, "
	"der vor einem hohen Turm endet." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"graslandschaft","landschaft"}), 
            "Die Graslandschaft der Hochebene von Gorthad scheint unendlich "
	    "zu sein. Du siehst wie der Wind das Gras leicht bewegt.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Du befindest Dich auf der Hochebene von Gorthad.");

  AddDetail( ({"osten","huegelgraeber","graeber","huegelgraebern"}),
	    "Im Osten sind die beruehmten Huegelgraeber der Hochebene zu "
	    "sehen. Sie sind mit kleinen Blumen bewachsen.");

  AddDetail( ({"westen","weg","turm","wachturm"}),
	    "Im Westen steht ein alter Wachturm. Ein Weg fuehrt direkt zu dem "
	    "Turm. Geh doch einfach mal hin und schau ihn Dir an.");
  
  AddDetail( ({"boden"}),
	    "Am Boden ist viel Gras zu sehen.");

  AddDetail( ({"gras"}), 
            "Das Gras ist saftig gruen.");

  AddDetail( ({"himmel","sonne"}),
	    "Der Himmel ist herrlich blau und die Sonne scheint.");

  AddDetail( ({"wind"}),
	    "Ein leichter Wind weht ueber die Hochebene.");

  AddDetail( ({"blumen"}),
	    "Kleine weisse Blumen wachsen auf den Huegelgraebern.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst die Blumen von den Huegelgraebern.");  
 
  AddSmell( ({"blumen","duft"}),
	   "Der Wind weht den Duft der Blumen herueber. Sie duften sehr gut.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind ueber die Hochebene wehen und "
		  "das Gras zum Rascheln bringen.");

  AddSound( ({"gras","wind","rascheln"}),
	   "*raschel*");
  
//-----Details Ende-----
  
AddExit("nordosten", ROOM "orks10-1");
AddExit("westen", "/d/kristallwald/chivas/hochebene/room/hoch26");


}
