// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Vor einer Hoehle");
  SetProp( P_INT_LONG,
	"Du stehst auf einer kleinen Lichtung und vor Dir tut "
        "sich eine grosse Oeffnung in der Felswand auf, die zur Hochebene von "
        "Gorthad gehoert. In der Hoehle scheinen ein paar Fackeln zu leuchten "
        "und ein ekliger Geruch kommt aus ihr heraus." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"lichtung","sueden"}), 
            "Die Lichtung ist gross und wird von grossen Baeumen umrundet. "
            "An der Seite der Felswand ist die Oeffnung zu einer Hoehle zu "
            "erkennen.");

  AddDetail( ({"felswand","hoehe"}),
	    "Die Felswand ragt vor Dir in die Hoehe und in am Boden hat sie "
            "eine grosse Oeffnung, die in eine Hoehle zu fuehren scheint.");

  AddDetail( ({"oeffnung","seite"}),
	    "Die Oeffnung sieht bedrohlich aus und ein uebler Gestank kommt "
            "aus ihr hervor. Sicher hausen dort ein paar schreckliche "
            "Kreaturen.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Die Felswand gehoert zur Hochebene von Gorthad.");
  
  AddDetail( ({"hoehle"}),
	    "Wie gross die Hoehle ist, in die die Oeffnung fuehrt kannst Du "
            "von hier aus nur erahnen. In der Hoehle scheinen ein paar "
            "Fackeln zu leuchten.");

  AddDetail( ({"fackeln"}), 
            "Die Fackeln erhellen die Hoehle nur ein wenig. Von hier kannst "
            "Du jedenfalls noch nicht viel erkennen.");

  AddDetail( ({"geruch","gestank"}),
	    "Sowas kann man nur riechen und nicht untersuchen. Sei froh "
            "darueber.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau und die Sonne steht beinahe senkrecht.");

  AddDetail( ({"boden"}),
	    "Der Boden ist schlammig und ein paar Pfuetzen sind zu sehen.");
  
  AddDetail( ({"baeumen","baeume"}),
	    "Grosse Baeume saeumen die Lichtung. Die einzige Moeglichkeit die "
            "Lichtung zu verlassen, ist der Pfad im Norden oder die Hoehle "
            "im Sueden.");

  AddDetail( ({"kreaturen"}), 
            "Es sind sicher eklige Kreaturen wie Orks.");

  AddDetail( ({"sonne"}),
	    "Die Sonne brennt vom Himmel herunter.");

  AddDetail( ({"schlamm","gras","grashalm"}),
	    "Es ist nur Schlamm auf der Lichtung zu sehen. Kein einziger "
            "Grashalm ist mehr zu sehen.");

  AddDetail( ({"pfuetzen"}),
	    "Grosse Pfuetzen haben sich im Schlamm gebildet. Anscheinend "
            "stammen sie vom letzten Regen.");
  
  AddDetail( ({"moeglichkeit","wahl"}),
	    "Du hast also zwei Wege zur Wahl. Entscheide klug.");

  AddDetail( ({"weg","wege"}), 
            "Alle Wege fuehren nach Midas.");

  AddDetail( ({"midas","hauptstadt"}),
	    "Midas ist die Hauptstadt des Silberlandes.");

  AddDetail( ({"silberlandes","silberland"}),
	    "Du bist im Silberland und fuehlst Dich hier gut.");

  AddDetail( ({"orks","ork","wesen"}),
	    "Orks sind eklig gruene, dumme, aber aeusserst kampfwuetige und "
            "gerissene Wesen.");
  
  AddDetail( ({"regen"}),
	    "Momentan wird es sicher nicht regnen.");

  AddDetail( ({"naehe"}), 
            "Du bist sehr tapfer.");

  AddDetail( ({"pfad","norden"}),
	    "Zwischen zwei grossen Baeumen fuehrt ein schmaler Pfad nach "
            "Norden.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es kommt ein ekliger Geruch aus der Hoehle.");  
 
  AddSmell( ({"geruch","gestank","hoehle"}),
	   "Es riecht nach Verwesung.");

  AddSmell( ({"verwesung"}),
	   "Bei dem Geruch wird Dir beinahe schlecht.");
  
  AddSound(DEFAULT_SOUND, "Es ist komplett still. Nicht einmal Voegel oder "
                          "andere Tiere sind zu hoeren.");

  AddSound( ({"voegel","tiere"}),
	   "Anscheinend trauen sich keine Tiere in die Naehe der Hoehle.");
  
//-----Details Ende-----
AddItem(NPC "owache", REFRESH_DESTRUCT);  
AddItem(NPC "owache", REFRESH_DESTRUCT);

AddExit("norden", ROOM "orks31");
AddExit("sueden", ROOM "orks1");


}

