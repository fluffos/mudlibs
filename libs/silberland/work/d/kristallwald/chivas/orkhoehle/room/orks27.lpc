// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"In dem Wachraum herrscht das typische Orkchaos. Am Boden liegt "
	"allerlei Unrat und auch das Mobiliar sieht recht mitgenommen aus. "
	"In einem der hier aufgestellten Betten liegt ein grosser fetter Ork "
	"und schnarcht laut vor sich hin." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wachraum","raum"}), 
            "Dies ist der suedliche Wachraum, wo sich die Wachen vom Eingang "
	    "ausruhen koennen.");

  AddDetail( ({"orkchaos","chaos"}),
	    "Es herrscht ein Chaos im Raum. Die Orks sind nicht gerade "
	    "reinlich.");

  AddDetail( ({"boden"}),
	    "Am Boden liegt allerhand Unrat.");

  AddDetail( ({"unrat"}),
	    "Es sind hauptsaechlich Essensreste.");
  
  AddDetail( ({"mobiliar"}),
	    "Da Mobiliar ist herunter gekommen und fast kaputt.");

  AddDetail( ({"betten"}), 
            "Die Betten sind alt und dreckig. In einem der Betten liegt ein "
	    "grosser fetter Ork und schnarcht.");

  AddDetail( ({"ork"}),
	    "Der Orks schlaeft und scharcht laut vor sich hin. Du solltest "
	    "ihn besser nicht wecken.");

  AddDetail( ({"orks"}),
	    "Die Orks leben in den Hoehlen unter der Hochebene.");

  AddDetail( ({"waende","wand","waenden"}),
	    "An den Waenden sind alle moeglichen Schmierereien.");
  
  AddDetail( ({"decke"}),
	    "An der Decke haengt eine alte Oellampe, die den Wachraum ein "
	    "wenig erhellt.");

  AddDetail( ({"wachen","dienst"}), 
            "Die Wachen vom Eingang koennen sich hier ausruhen, wenn sie "
	    "keinen Dienst haben.");

  AddDetail( ({"eingang","naehe"}),
	    "Der Eingang zur Hoehle ist ganz in der Naehe.");

  AddDetail( ({"essensreste"}),
	    "Die Essensreste vergammeln am Boden.");

  AddDetail( ({"hoehlen","hoehle"}),
	    "Du befindest Dich in den Hoehlen der Orkhorde.");
  
  AddDetail( ({"hochebene","gorthad"}),
	    "Die Hoehlen sind unterhalb der Hochebene von Gorthad.");

  AddDetail( ({"schmierereien"}), 
            "Die Schmierereien haben hauptsaechlich einen obszoenen Inhalt.");

  AddDetail( ({"orkhorde"}),
	    "Die Orkhorde lebt in den Hoehlen.");

  AddDetail( ({"inhalt"}),
	    "Der Inhalt wurde von Woody aufgrund jugendlicher Mudder zensiert "
	    "und darf aus diesem Grund hier nicht beschrieben werden.");

  AddDetail( ({"woody","gott"}),
	    "Woddy ist der Gott im Silberland.");
  
  AddDetail( ({"mudder"}),
	    "Du bist einer.");

  AddDetail( ({"grund"}), 
            "Wende Dich diesbezueglich an Woody.");

  AddDetail( ({"silberland"}),
	    "Du befindest Dich im Silberland.");

  AddDetail( ({"oellampe","lampe"}),
	    "Die Oellampe erhellt den Wachraum ein wenig.");

  AddDetail( ({"raetsel"}),
	    "Du magst Raetsel.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es stinkt in dem Wachraum.");  
 
  AddSmell( ({"gestank","wachraum"}),
	   "Wie die Orks diesen Gestank aushalten, ist fuer Dich ein Raetsel.");

  AddSound(DEFAULT_SOUND, "Der Ork im Wachraum schnarcht sehr laut.");

  AddSound( ({"ork"}),
	   "*schnarch*");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "orks1");


AddCmd( ({"weck", "wecke" }), "wecken" );

}
int wecken(string str)
{
   notify_fail("Wen moechtest Du wecken?\n");
   if ( member( ({ "ork" }),str) != -1) 
  {
    write(BS ( "Du weckst den Ork und er schaut Dich boese an. Er gibt "
	       "Dir eine schallernde Ohrfeige und warnt Dich davor es "
	       "noch einmal zu machen. Dann schlaeft er weiter.\n"));
    TP->AddHp(-30);
    return 1;
  }
}

