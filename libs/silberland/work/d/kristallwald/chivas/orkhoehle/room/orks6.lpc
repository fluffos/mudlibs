// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"Der Tunnel hat verschiedene Abzweigungen in noerdliche Richtung. Ein "
	"weiterer Tunnel fuehrt nach Suedosten wo die Schlafkammern der Orks "
	"zu sein scheinen. Vor der Kammer im Sueden, aus der helles Licht und "
	"lautes Gebruelle draengt, haengt ein wackeliges Schild." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"tunnel"}), 
            "Der Tunnel in dem Du stehst fuehrt in verschiedene Richtungen. Du "
	    "kannst nach Sueden, Suedosten, Nordosten, Nordwesten und Norden "
	    "gehen.");

  AddDetail( ({"abzweigungen","richtung","richtungen"}),
	    "Es gibt hier verschiedene Abzweigungen, die in verschiedene "
	    "Richtungen fuehren.");

  AddDetail( ({"suedosten","schlafkammern","kammern","kraft","schlafen"}),
	    "Im Suedosten scheinen die Kammern zu sein, in denen die Orks sich "
	    "zum Schlafen zurueck ziehen, um neue Kraft fuer die Raubzuege der "
	    "Horde zu sammeln.");

  AddDetail( ({"orks"}),
	    "Viele hundert Orks leben in diesen Hoehlen.");
  
  AddDetail( ({"kammer","sueden","eingang","kneipe"}),
	    "Die Kammer im Sueden scheint eine Kneipe zu sein. Ein Schild "
	    "haengt ueber dem Eingang.");

  AddDetail( ({"licht"}), 
            "Helles Licht stroemt aus der Kneipe in den Tunnel und erhellt ihn "
	    "noch ein wenig mehr.");

  AddDetail( ({"gebruelle"}),
	    "Das Gebruelle kannst Du hoeren.");

  AddDetail( ({"schild"}),
	    "Du kannst das Schild lesen.");

  AddDetail( ({"boden"}),
	    "Der Boden ist feucht und dreckig.");
  
  AddDetail( ({"decke"}),
	    "Die Decke ist kahl und uninteressant.");

  AddDetail( ({"wand","waende","waenden"}), 
            "An den Waenden haengen ein paar Fackeln, die den Tunnel ein wenig "
	    "erhellen.");

  AddDetail( ({"nordosten","nordwesten","norden","probleme"}),
	    "Du kannst ohne Probleme in diese Richtung gehen.");

  AddDetail( ({"raubzuege","gegend"}),
	    "Die Orks unternehmen oft Raubzuege in der Gegend der Orkhoehlen.");

  AddDetail( ({"horde"}),
	    "Die Horde lebt in den Hoehlen unter der Hochebene.");
  
  AddDetail( ({"hoehlen","orkhoehlen"}),
	    "Die Hoehlen der Orks sind sehr weitlaeufig. Pass auf, dass Du "
	    "Dich nicht verirrst.");

  AddDetail( ({"fackeln"}), 
            "Die Fackeln erhellen den Tunnel ein wenig. Sie werden von dem "
	    "hellen Licht aus der Kneipe im Sueden unterstuetzt.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Die Hoehlen befinden sich unterhalb der Hochebene von Gorthad.");

  AddDetail( ({"hunger"}),
	    "Hast Du Hunger? Dann geh in die Kneipe und ess was.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht ganz lecker aus der Kneipe im Sueden.");  
 
  AddSmell( ({"kneipe","sueden","geruch"}),
	   "Bei dem Geruch kriegst Du gleich Hunger.");

  AddSound(DEFAULT_SOUND, "Du hoerst Lachen und lautes Gebruelle aus der "
		  "Kneipe.");

  AddSound( ({"gebruelle","lachen"}),
	   "Es scheint eine gute Stimmung in der Kneipe zu herrschen.");
  
  AddSound( ({"stimmung","feier","feiern"}),
	   "Die Orks sind lauthals am Feiern.");

  AddReadDetail( ({"schild"}),
		"+--------------------------------------------+\n"
                "|                                            |\n"
                "|             Zum Elfenschlaechter           |\n"
                "|                                            |\n"
                "+--------------------------------------------+\n");
//-----Details Ende-----
  
AddExit("norden", ROOM "orks5");
AddExit("nordosten", ROOM "orks3");
AddExit("nordwesten", ROOM "orks8");
AddExit("sueden", ROOM "orkschenke2");
AddExit("suedosten", ROOM "orks22");

}

