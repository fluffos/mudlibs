// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"Du stehst in einer grossen geraeumigen Kammer, von der einzelne "
	"Tunnel in alle Himmelsrichtungen fuehren. An den Waenden und am Boden "
        "wachsen verschiedene Moose und Farne, die im Schummerlicht der "
	"Fackeln recht gut gedeihen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"kammer"}), 
            "Die Kammer in der Du Dich befindest ist sehr geraeumig. Es "
	    "fuehren lauter Tunnel in alle Richtungen. Ansonsten ist es recht "
	    "feucht in der Kammer und an den Waenden und an der Decke wachsen "
	    "Pflanzen im Schein der Fackeln.");

  AddDetail( ({"tunnel"}),
	    "Verschiedene Tunnel fuehren in alle Richtungen der grossen "
	    "Orkhoehle.");

  AddDetail( ({"himmelsrichtungen","richtungen","norden","osten","sueden","westen"}),
	    "Du kannst nach Norden, Osten, Sueden oder Westen weitergehen.");

  AddDetail( ({"decke","hoehlendecke"}),
	    "Von der Decke haengen einige Flechten herab.");
  
  AddDetail( ({"moose","moos"}),
	    "Das gruene Moos gedeiht recht gut im Schein der Fackeln.");

  AddDetail( ({"farne","farn"}), 
            "Die Farne sind recht gross gewachsen, was bemerkenswert ist, da "
	    "es hier ja nur wenig Licht gibt.");

  AddDetail( ({"schummerlicht","licht","schein"}),
	    "Das schummrige Licht erhellt die Kammer ein wenig, so dass einige "
	    "Pflanzen hier wachsen und Du genug sehen kannst.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln haengen in rostigen Halterungen an den Waenden und "
	    "flackern vor sich hin.");

  AddDetail( ({"waenden","waende","wand"}),
	    "An den Waenden sind einige Moose zu sehen, die im Schein der "
	    "Fackeln sogar recht gut gedeihen. Ansonsten haengen an den "
	    "grob behauenen Waenden ein paar Fackeln, die Dir genug Licht "
	    "spenden.");
  
  AddDetail( ({"boden"}),
	    "Der Boden ist recht feucht und einige Moose und Farne wachsen auf "
	    "ihm im Schein der Fackeln. Ausserdem erkennst Du einige grosse "
	    "und kleine Felsbrocken.");

  AddDetail( ({"pflanzen"}), 
            "Du erkennst verschiedene Moose und Farne, die an den Waenden und "
	    "am Boden wachsen. Von der Decke haengen einige Flechten.");

  AddDetail( ({"flechten"}),
	    "Die Flechten haengen traege von der Hoehlendecke.");

  AddDetail( ({"halterungen","rost"}),
	    "Die Halterungen sind alt und verrostet.");

  AddDetail( ({"felsbrocken","zeit"}),
	    "Die Felsbrocken sind vor langer Zeit von der Decke und den "
	    "Waenden abgebrochen. Niemand hat es fuer noetig gehalten, sie "
	    "wegzuraeumen.");
  
  AddDetail( ({"orkhoehle","hoehle","hoehlen"}),
	    "Viele Orks leben in diesen Hoehlen.");

  AddDetail( ({"orks"}), 
            "Die Orks sind eine sehr feindselige und blutluesternde Rasse.");

  AddDetail( ({"rasse"}),
	    "Sie sind eigentlich das krasse Gegenteil der Feen.");

  AddDetail( ({"gegenteil","feen"}),
	    "Feen sind klein und liebreizend, sieht man einmal von den "
	    "legendaeren und selten gesehenen Berserkerfeen ab.");

  AddDetail( ({"berserkerfeen","legende"}),
	    "Sie sind eine Legende. Du hast noch keine gesehen.");
  
  AddDetail( ({"windzug"}),
	    "Ein leichter Windzug zieht durch die Kammer und bringt die "
	    "Fackeln zum flackern.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Pflanzen.");  
 
  AddSmell( ({"pflanzen","moose","farne","flechten","gerueche","geruechen"}),
	   "Du riechst die Pflanzen in der Kammer. Es gehoert zu den besten "
	   "Geruechen, die Du hier bisher gerochen hast.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Flackern der Fackeln.");

  AddSound( ({"flackern","fackeln"}),
	   "Die Fackeln flackern ein wenig. Ein leichter Windzug bringt sie "
	   "zum Flackern und Du kannst ihn hoeren. *flacker*");

  AddSound( ({"wind","windzug"}),
	   "Ein leichter Windzug rauscht durch die Hoehlen der Orks. Er bringt "
	   "die Fackeln zum Flackern.");  

//-----Details Ende-----
AddItem(NPC "orkn", REFRESH_DESTRUCT);

AddExit("norden", ROOM "orks7");
AddExit("osten", ROOM "orks3");
AddExit("westen", ROOM "orks8");
AddExit("sueden", ROOM "orks6");

}

