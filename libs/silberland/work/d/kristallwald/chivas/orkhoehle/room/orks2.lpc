// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int schluessel_zahl;

void create()
	
{
  ::create();

  schluessel_zahl=1;

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"Der Hauptgang der Hoehle fuehrt nach Sueden tiefer in das Reich der "
	"Orks hinein. An den Waenden haengen alte verrostete Halterungen, in "
	"denen Fackeln brennen, die den Gang erhellen. Am Boden sind einige "
	"Pfuetzen und viel Unrat der Bewohner zu erkennen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"hauptgang","gang","ganges"}), 
            "Der Hauptgang fuehrt tiefer in die Hoehle der Orks. Ein paar "
	    "kleine Nebengaenge sind zwar zu sehen, aber uninteressant.");

  AddDetail( ({"hoehle","hoehlen"}),
	    "Die Hoehle ist das Reich der Orks. Es scheint ein riesiges "
	    "Hoehlensystem unter der Hochebene zu sein.");

  AddDetail( ({"sueden"}),
	    "Im Sueden geht es tiefer in die Hoehle hinein.");

  AddDetail( ({"reich"}),
	    "Du befindest Dich im Reich der Orks.");
  
  AddDetail( ({"orks"}),
	    "Die Orks haben sich in diesen Hoehlen nieder gelassen und sich "
	    "ihr eigenes Reich geschaffen.");

  AddDetail( ({"waende","waenden","ursprung","ursprungs","wand"}), 
            "An den Waenden, die natuerlichen Ursprungs sind, erkennt man "
	    "einige Risse und alte Halterungen, in denen Fackeln stecken.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen fuer die Fackeln sind alt und verrostet. An dem "
	    "Rost erkennt man sehr gut, dass es den Orks egal ist, wie es "
	    "hier aussieht.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln erhellen den Gang. Ohne sie waere es hier stockdunkel "
	    "und man koennte selbst als Dunkelelf kaum etwas erkennen.");

  AddDetail( ({"dunkelelf","dunkelelfen","drows","drow"}),
	    "Die Dunkelelfen oder auch Drows sind eine boesartige Rasse hier "
	    "im Silberland.");
  
  AddDetail( ({"boden"}),
	    "Der Boden ist feucht und ein paar Pfuetzen sind zu sehen. "
	    "Ausserdem liegt eine Menge Unrat herum.");

  AddDetail( ({"pfuetzen"}), 
            "Kleine Pfuetzen haben sich gebildet. Sie stammen sicher vom "
	    "Wasser, dass nach einem Regenschauer durch die Decke gesickert "
	    "und an den Waenden herunter gelaufen ist.");

  AddDetail( ({"unrat","abfall","menge"}),
	    "Du erkennst einige Stofffetzen, ein paar Knochen und weiteren "
	    "Abfall.");

  AddDetail( ({"bewohner"}),
	    "Die Bewohner der Hoehlen sind hauptsaechlich Orks. Jedoch kann "
	    "es gut sein, dass sich noch andere Kreaturen in diesen Hoehlen "
	    "herum treiben.");

  AddDetail( ({"nebengaenge"}),
	    "Die Nebengaenge sind nicht interessant und es gibt auch nichts "
	    "zu entdecken.");
  
  AddDetail( ({"hoehlensystem","system"}),
	    "Die Gaenge der Hoehle sind weit verzweigt. Man kann sich hier "
	    "sehr schnell verlaufen.");

  AddDetail( ({"hochebene","gorthad"}), 
            "Die Hoehle befindet sich unter der Hochebene von Gorthad.");

  AddDetail( ({"risse","rissen","riss"}),
	    "In den Rissen an den Waenden wachsen ein paar Moose und aus den "
	    "Rissen in der Decke tropft es auf den Boden.");

  AddDetail( ({"rost"}),
	    "Der Rost hat die Halterungen aus Eisen schon fast zerfressen.");

  AddDetail( ({"rasse","rassen"}),
	    "Es gibt viele verschiedene Rassen im Silberland.");
  
  AddDetail( ({"silberland"}),
	    "Du befindest Dich im Silberland. Es ist kaum zu glauben.");

  AddDetail( ({"wasser"}), 
            "Das Wasser tropft von der Decke oder rinnt an den Waenden "
	    "herunter und sammelt sich in kleinen Pfuetzen am Boden des "
	    "Ganges.");

  AddDetail( ({"regenschauer","regen","schauer"}),
	    "Wenn es ausserhalb der Hoehle geregnet hat, scheint sich das "
	    "Wasser in den Hoehlen zu sammeln, so dass hier alles ekelig nass "
	    "ist.");

  AddDetail( ({"decke","himmel"}),
	    "An der Decke sind ein paar Risse zu sehen, aus denen einzelne "
	    "Tropfen herab fallen. Ausserdem erkennt man ein paar alte "
	    "Spinnenweben.");

  AddDetail( ({"knochen"}),
	    "Die Knochen sehen abgenagt aus. Du kannst leider nicht mehr genau "
	    "erkennen, zu was fuer einem Lebewesen die Knochen gehoert haben. "
	    "Die Frage die sich stellt ist, ob die Knochen von den Orks oder "
	    "irgendeiner gefaehrlichen Bestie abgenagt wurden.");
  
  AddDetail( ({"stofffetzen"}),
	    "Die Stofffetzen haben anscheinend einmal zu einem Hemd und einer "
	    "Hose gehoert. Der Besitzer der Knochen hatte sie anscheinend an, "
	    "bevor ihn sein Schicksal ereilte.");

  AddDetail( ({"kreaturen","moeglichkeit","vorsicht"}), 
            "Da die Moeglichkeit besteht, dass sich ausser Orks hier noch "
	    "schlimmere Kreaturen herum treiben, ist hoechste Vorsicht "
	    "geboten. Du willst ja nicht wie die Knochen, die hier liegen, "
	    "enden.");

  AddDetail( ({"moose","moos"}),
	    "Das Moos sieht in dem Daemmerlicht der Fackeln ein wenig "
	    "kraenklich aus. Zwischen dem Moos in einem Riss entdeckst Du "
	    "im Fackelschein ein leichtes Funkeln.");

  AddDetail( ({"daemmerlicht","licht","fackelschein","schein"}),
	    "Der Fackelschein erhellt den Gang ein wenig.");

  AddDetail( ({"funkeln"}),
	    "Das Funkeln kommt aus einem Loch zwischen dem Moos im Riss.");
  
  AddDetail( ({"eisen"}),
	    "Das Eisen ist kaum noch zu erkennen. Es gibt eigentlich nur noch "
	    "Rost.");

  AddDetail( ({"spinnenweben","spinnweben"}),
	    "Die Spinnenweben sind alt und laengst verlassen. Auch wenn die "
	    "Spinnen noch darin wohnen wuerden, waere es nicht gefaehrlich, "               "da die Spinnen sehr klein gewesen sein muessen.");

  AddDetail( ({"lebewesen","lebewesens","chance"}),
	    "Du hast keine Chance anhand der Knochen die Rasse des Lebewesens "
	    "zu bestimmen.");

  AddDetail( ({"frage","fragen"}),
	    "Fragen stellen sich immer wieder. Sie hoeren erst auf, wenn man "
	    "Tod gegenueber steht.");
  
  AddDetail( ({"bestie"}),
	    "Eine grosse und gefaehrliche Bestie willst Du hier eigentlich "
	    "nicht treffen. Die Orks reichen Dir eigentlich vollkommen aus.");

  AddDetail( ({"hemd","hose","reste","kleidung"}),
	    "Die Reste von Hemd und Hose sind nicht mehr zu gebrochen. Sie "
	    "wurden halt in kleine Fetzen zerrissen.");

  AddDetail( ({"schicksal"}),
	    "Dein Schicksal ist noch ungewiss.");

  AddDetail( ({"besitzer"}),
	    "Der Besitzer wird die Reste seiner Kleidung nie mehr benoetigen.");
  
  AddDetail( ({"spinnen"}),
	    "Du siehst momentan keine Spinnen. Die Spinnenweben sind "
	    "verlassen.");

  AddDetail( ({"tod","uptime","lust"}),
	    "Du hast keine Lust Tod in dieser Uptime zu begegnen.");

  AddDetail( ({"loch"}),
	    "Du kannst ja mal in das Loch fassen. Vielleicht ist es ja etwas, "
	    "dass Du gebrauchen koenntest.");

  AddDetail( ({"fetzen"}),
	    "Es ist kaum noch etwas uebrig.");
  
  AddDetail( ({"gaenge"}),
	    "Es gibt hier sehr viele Gaenge in der Hoehle.");

  AddDetail( ({"tropfen"}),
	    "Einige Tropfen fallen von der Decke.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Schmutz und verdorbenen Fleisch.");  
 
  AddSmell( ({"schmutz"}),
	   "Es stinkt einfach.");

  AddSmell( ({"fleisch"}),
	   "Du willst eigentlich nicht wissen, was fuer Fleisch es ist.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Flackern der Fackeln und andere "
		  "Geraeusche in der Hoehle.");

  AddSound( ({"flackern","fackeln"}),
	   "*flacker*flacker*flacker*");
  
  AddSound( ({"geraeusche","hoehle"}),
	   "Die Geraeusche sind nicht sehr laut und dadurch schwer "
	   "auszumachen. Du musst schon weiter in die Hoehle vordringen um "
	   "zu erfahren, was das fuer Geraeusche sind.");

//-----Details Ende-----
AddItem(NPC "orkf", REFRESH_DESTRUCT);

AddExit("nordosten", ROOM "orks1");
AddExit("sueden", ROOM "orks3");


AddCmd( ({"fass", "fasse" }), "fassen" );

}

int fassen(string str)
{
  object schluessel;
  notify_fail( "Wo willst Du denn hinein fassen?\n" );
  if ( member( ({ "in loch", "loch" }), str ) != -1 ) 

   {
     if( schluessel_zahl < 1 )
     {
        write("Du fasst in das Loch, suchst etwas herum, findest aber "
	      "nichts. Anscheinend hast Du Dich getaeuscht\n");
        say(sprintf("%s sucht etwas.\n", TP->Name(WER)));
        return -1;
     }
      if ( present("orkschluessel",TP) )
      {
      write("Du fasst in das Loch und findest einen Bronzeschluessel. Da Du "
            "bereits einen hast laesst Du ihn fuer den naechsten Abenteurer "
	    "liegen.\n" );
      say(sprintf("%s findet etwas, laesst es jedoch liegen.\n", TP->Name(WER)));
      return -1;
      }
      else
      {
        {schluessel = clone_object( OBJ "orkschluessel");
        if ( ME_TOO_HEAVY == schluessel->move(TP,M_GET|M_SILENT) )

          {
          write(
          "Der Schluessel wuerde Dir zu schwer werden.\n" );
          say(BS(sprintf("%s ist ein absolutes Weichei und kann nicht einmal "
			 "mehr die leichtesten Sachen tragen.\n", TP->Name(WER))));
          schluessel -> remove();
          return 1;
          }
          else
          {
          write("Du fasst in das Loch und findest einen Bronzeschluessel, "
                "den Du sofort einsteckst.\n");
          say(sprintf("%s fasst wo rein und steckt etwas ein.\n",
          TP->Name(WER)));
          schluessel_zahl--;
          return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}

void reset() {
  schluessel_zahl=1;
  return ::reset();
}
