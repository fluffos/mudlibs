// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"Dies scheint der Bereich der Orkhoehle zu sein, wo sich die "
	"Orkkrieger hin zurueck ziehen um zu schlafen und sich von ihren "
	"Beutezuegen auszuruhen. Es sind verschiedene Kammern zu sehen, die "
	"vom Tunnel abzweigen und grob in den Stein geschlagen wurden. Im "
	"Norden scheint eine Art Heiligtum der Orks zu sein." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"bereich","schlafstaetten"}), 
            "In diesem Bereich sind die Schlafstaetten der Orks zu finden.");

  AddDetail( ({"orkhoehle","hoehlen","hoehle"}),
	    "Du befindest Dich tief in den Hoehlen der Orks.");

  AddDetail( ({"orkkrieger","horde","krieger"}),
	    "Die Orkkrieger der Horde schlafen und wohnen in diesem Bereich "
	    "der Hoehle.");

  AddDetail( ({"beutezuegen","beutezuege","beutezug","umgebung"}),
	    "Die Orks gehen oft auf Beutezug in der Umgebung der Hoehle.");
  
  AddDetail( ({"kammern"}),
	    "In den Kammern sind die Schlafstaetten der Orks. Hier koennen sie "
	    "sich ausruhen, wenn sie nicht in der Kneipe sitzen oder auf "
	    "Beutezug sind.");

  AddDetail( ({"tunnel"}), 
            "Du stehst in einem Tunnel, der in verschiedene Kammern abzweigt.");

  AddDetail( ({"stein","fels","fall","ursprungs","ursprung"}),
	    "Die Kammern wurde in den Fels der Hoehle geschlagen. Sie sind "
	    "auf keinen Fall natuerlichen Ursprungs. Man kann jedoch erkennen, "
	    "dass die Orks andere Staerken haben, als den Stein zu bearbeiten. "
	    "Alles sieht ein wenig grob behauen aus und nicht gerade schoen "
	    "verarbeitet.");

  AddDetail( ({"norden","heiligtum","art","tempel"}),
	    "Im Norden scheint eine Art Tempel der Orks zu sein. Es ist "
	    "kaum zu glauben, dass die Orks doch an ein hoeheres Wesen "
	    "glauben.");

  AddDetail( ({"orks"}),
	    "Die Orks leben hier in den Hoehlen.");
  
  AddDetail( ({"boden"}),
	    "Der Boden ist ein wenig feucht und einige Felsbrocken liegen "
	    "herum.");

  AddDetail( ({"wand","waende","waenden"}), 
            "An den Waenden sind einige verrostete Halterungen fuer Fackeln "
	    "zu sehen. Ansonsten sind die Waende schmucklos.");

  AddDetail( ({"decke"}),
	    "Die Decke ist kahl und unattraktiv.");

  AddDetail( ({"kneipe"}),
	    "Die Orks gehen auch gerne in die Kneipe und trinken etwas.");

  AddDetail( ({"staerken","rauben","morden"}),
	    "Die Staerken der Orks liegen eher im Rauben und Morden.");
  
  AddDetail( ({"wesen"}),
	    "Geh doch einfach mal in den Tempel und schau Dich um.");

  AddDetail( ({"felsbrocken","brocken"}), 
            "Die Brocken sind von den Waenden abgeschlagen worden, jedoch hat "
	    "keiner sich dafuer verantwortlich gefuehlt, sie nachher auch "
	    "wegzuraeumen.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen bestehen kaum noch aus Eisen. Sie bestehen "
	    "hauptsaechlich aus Rost.");

  AddDetail( ({"fackeln"}),
	    "Das Licht der Fackeln erhellt den Tunnel ein wenig, so dass Du "
	    "gut genug sehen kannst.");

  AddDetail( ({"eisen"}),
	    "Eisen ist an den Halterungen kaum noch zu sehen.");
  
  AddDetail( ({"rost"}),
	    "Der Rost glaenzt roetlich im Schein der Fackeln.");

  AddDetail( ({"schein","licht"}), 
            "Das Licht scheint hell genug, um alles genau zu erkennen.");

  AddDetail( ({"grund"}),
	    "Es gibt immer einen Grund.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Unrat.");  
 
  AddSmell( ({"unrat","schmutz"}),
	   "Die Orks sind nicht sehr reinlich und schmeissen alles weg. Aus "
	   "diesem Grund riecht es ueberall nach Schmutz und Unrat.");

  AddSound(DEFAULT_SOUND, "Es herrscht Totenstille.");

  AddSound( ({"totenstille"}),
	   "Du solltest die Totenstille auch nicht stoeren.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "orktemp");
AddExit("osten", ROOM "orks24");
AddExit("nordwesten", ROOM "orks6");
AddExit("sueden", ROOM "orks21");
AddExit("suedosten", ROOM "orks25");

}

