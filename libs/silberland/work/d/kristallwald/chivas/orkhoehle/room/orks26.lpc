// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"Dies ist der Wachraum der Eingangswache, in dem sich die Orks, die "
	"am Eingang der Hoehle Wache halten muessen, zurueck ziehen koennen. "
	"An der Westwand steht ein alter Holztisch und zwei Stuehle. An der "
	"Suedwand befinden sich ein paar Betten zum Ausruhen und an der "
	"Nordwand sind Halterungen fuer Waffen und Ruestungen zu erkennen. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wachraum","ausruhen"}), 
            "Der Wachraum ist zum Ausruhen fuer die Wachen gedacht, die auf "
	    "den Eingang aufpassen.");

  AddDetail( ({"eingangswache","wache","wachen"}),
	    "Die Wachen passen auf, dass kein Unbefugter, der der Horde etwas "
	    "antun will, in die Hoehlen kommt.");

  AddDetail( ({"orks"}),
	    "Die Orks leben in diesen Hoehlen.");

  AddDetail( ({"eingang","osten"}),
	    "Der Eingang zur Hoehle ist im Osten.");
  
  AddDetail( ({"hoehle","hoehlen","unterschlupf"}),
	    "Die Hoehlen dienen als Unterschlupf fuer die Orks.");

  AddDetail( ({"westwand"}), 
            "An der Westwand ist ein alter Holztisch und mehrere Stuehle zu "
	    "sehen.");

  AddDetail( ({"holztisch","tisch"}),
	    "Der Holztisch ist alt und klapprig.");

  AddDetail( ({"stuehle","moment"}),
	    "Auf die Stuehle wuerdest Du Dich nicht mehr setzen, da sie so "
	    "aussehen, als ob sie jeden Moment zusammen klappen.");

  AddDetail( ({"suedwand"}),
	    "An der Suedwand stehen ein paar Betten, in denen die Orks die "
	    "gerade keine Wache haben, ein Nickerchen machen koennen.");
  
  AddDetail( ({"betten","nickerchen","bett","richtige","flecken"}),
	    "Vielleicht sind die Betten fuer Orks genau das Richtige. Du "
	    "wuerdest Dich jedoch nie in ein solches Bett legen. Die Betten "
	    "sind dreckig und haben ueberall Flecken. Igitt.");

  AddDetail( ({"waende","wand"}), 
            "Welche Wand meinst Du?");

  AddDetail( ({"nordwand","weg"}),
	    "An der Nordwand sind Halterungen fuer Waffen angebracht, damit "
	    "sie nicht einfach im Weg rumliegen.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen sind voll mit Waffen.");

  AddDetail( ({"waffen","schwerter","lanzen"}),
	    "Du siehst die boesartigen Schwerter und Lanzen, die die Orks am "
	    "Eingang tragen.");
  
  AddDetail( ({"ruestungen"}),
	    "Die Ruestungen haengen sauber aufgereiht in den Halterungen. Sie "
	    "sind aber nicht viel wert, darum laesst Du sie haengen.");

  AddDetail( ({"boden"}), 
            "Der Boden ist richtig schoen dreckig. Hier macht anscheinend nie "
	    "einer sauber.");

  AddDetail( ({"ostwand","oeffnung"}),
	    "In der Ostwand ist die Oeffnung, durch die Du die Kammer betreten "
	    "hast.");

  AddDetail( ({"kammer"}),
	    "Der Wachraum ist eine kleine Kammer mit ein paar Moebeln.");

  AddDetail( ({"moebel","moebeln"}),
	    "Die Moebel sehen schon sehr herunter gekommen aus.");
  
  AddDetail( ({"unbefugter","frage"}),
	    "Die Frage ist, ob Du auch ein Unbefugter bist.");

  AddDetail( ({"decke"}), 
            "Die Decke ist kahl. Nur eine kleine Oellampe haengt an ihr und "
	    "spendet ein wenig Licht.");

  AddDetail( ({"oellampe","lampe","licht"}),
	    "Die brennende Oellampe erhellt die Kammer ein wenig.");

  AddDetail( ({"horde"}),
	    "Die Horde lebt in diesen Hoehlen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es stinkt in der Kammer.");  
 
  AddSmell( ({"kammer"}),
	   "Es riecht hier wirklich nicht besonders gut.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Wachen am Eingang.");

  AddSound( ({"wachen","eingang"}),
	   "Anscheinend unterhalten sich die Wachen am Eingang.");
  
//-----Details Ende-----
  
AddExit("osten", ROOM "orks1");

}

