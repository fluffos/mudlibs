// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl;
int dolch_anz;

void create()
	
{
  ::create();

  anzahl=1;
  dolch_anz=1;
  
  SetProp( P_INT_SHORT, "In einer Kammer");
  SetProp( P_INT_LONG,
	"In der Kammer herrscht eine grosse Hitze. In der Mitte brennt ein "
	"grosses Feuer, welches die gesamte Kammer erhellt. An den Waenden "
	"haengen lauter Fetische und ein paar Regale sind zu sehen. Viele "
	"verschiedene Symbole sind an die Waende, den Boden und auch die "
	"Decke gemalt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"kammer","ort"}), 
            "Dies ist sicher der Ort eines Zauberers oder eines Schamanen.");

  AddDetail( ({"hitze"}),
	    "Die Hitze des Feuers ist sehr gross.");

  AddDetail( ({"mitte","feuer","feuers"}),
	    "In der Mitte der Kammer brennt ein grosses Feuer. Es ist aber "
	    "kein normales Feuer, da es ab und zu die Farbe wechselt.");

  AddDetail( ({"waenden","waende","wand"}),
	    "An den Waenden stehen ein paar Regale und einige Fetische "
	    "haengen an ihr. Ausserdem erkennst Du Dir unbekannte aufgemalte "
	    "Symbole an der Wand.");
  
  AddDetail( ({"fetische"}),
	    "Die verschiedenen Fetische benoetigt der Schamane anscheinend "
	    "fuer seine Magie. Du laesst sie lieber dort haengen wo sie sind.");

  AddDetail( ({"regale","regalen"}), 
            "In den Regalen stehen lauter Glaeser und andere Utensilien.");

  AddDetail( ({"symbole"}),
	    "Die Symbole an den Waenden, am Boden und an der Decke scheinen "
	    "sich regelmaessig zu veraendern. Eine starke Magie geht von "
	    "ihnen aus. Da Du Dich jedoch bisher nie mit der Orkmagie "
	    "beschaeftigt hast, kannst Du die Symbole nicht deuten.");

  AddDetail( ({"boden"}),
	    "Am Boden liegt viel Asche vom Feuer. Ausserdem sind viele Symbole "
	    "auf dem Boden zu sehen. Komischerweise werden die Symbole nicht "
	    "auch von der Asche bedeckt. Um die Symbole herum ist immer ein "
	    "kleiner Kreis nicht mit Asche bedeckt.");

  AddDetail( ({"decke"}),
	    "Auch an der Decke sind raetselhafte Symbole zu erkennen. Leider "
	    "kannst Du sie nicht deuten.");
  
  AddDetail( ({"asche"}),
	    "Am Boden ist ueberall Asche vom Feuer zu sehen. Nur die Stellen, "
	    "an denen sich die Symbole befinden, ist keine Asche zu sehen und "
	    "die Symbole sind gut zu erkennen.");

  AddDetail( ({"zauberers","zauberer","schamanen","schamane","orkschamanen","orkschamane"}), 
            "In dieser Kammer wohnt und arbeitet der Schamane der Orks.");

  AddDetail( ({"orks"}),
	    "Die Orks, die in diesen Hoehlen wohnen, verehren den Schamanen. "
	    "Er steht in der Hierachie der Orks ganz weit oben.");

  AddDetail( ({"hierachie"}),
	    "Die Hierachie der Orks ist sehr komplex. Frag doch den "
	    "Bibliothekar von Roch Adan mal danach. Vielleicht erklaert er sie "
	    "Dir.");

  AddDetail( ({"roch","adan","roch adan","zentauren","stadt"}),
	    "Roch Adan ist die Stadt der Zentauren.");

  AddDetail( ({"bibliothek"}),
	    "Die Bibliothek ist in Roch Adan.");

  AddDetail( ({"bibliothekar"}),
	    "Der Bibliothekar in Roch Adan kennt sich mit vielen Dingen aus.");
  
  AddDetail( ({"dingen","dinge"}),
	    "Dinge von denen Du nichts verstehst.");

  AddDetail( ({"farbe","natur"}), 
            "Die Farbe wechselt regelmaessig von Rot zu Gelb, dann zu Gruen, "
	    "worauf ein tiefes Blau folgt und daraufhin wieder zu Rot. Das "
	    "Feuer ist definitiv magischer Natur, da ein normales anstaendiges "
	    "Feuer so etwas nicht tut. ");

  AddDetail( ({"rot","blut","adern"}),
	    "Die rote Farbe des Feuers sieht aus wie das Blut, dass in Deinen "
	    "Adern fliesst.");

  AddDetail( ({"gelb","gelbfieber","haut"}),
	    "Das Gelb des Feuers aehnelt der Farbe Deiner Haut, wenn Du an "
	    "Gelbfieber erkrankt bist.");

  AddDetail( ({"gruen","gesichtes","gesicht","seekrankheit"}),
	    "Das gruene Feuer kommt von der Farbe Deines Gesichtes bei "
	    "Seekrankheit erschreckend nahe.");
  
  AddDetail( ({"blau","eis"}),
	    "Das tiefe Blau sieht fast aus wie stark gefrorenes Eis.");

  AddDetail( ({"magie"}), 
            "Die Magie des Orkschamanen soll sehr gross sein.");

  AddDetail( ({"glaeser","glaesern"}),
	    "In den Glaesern, verschiedener Groesse, befinden sich alle "
	    "moeglichen Sachen.");

  AddDetail( ({"utensilien"}),
	    "Du siehst kleine und grosse Dolche auf den Regalen liegen. "
	    "Ausserdem sind verschiedene Haken und Ringe zu finden. Auch "
	    "einige Buecher siehst Du.");

  AddDetail( ({"orkmagie","raetsel"}),
	    "Die Orkmagie ist ein Raetsel fuer Dich. Du verstehst sie nicht.");
  
  AddDetail( ({"kreis","stellen","art","weise"}),
	    "Kleine Kreise haben sich um die Symbole gebildet und sie scheinen "
	    "die Asche auf magische Art und Weise von den Symbolen "
	    "fernzuhalten.");

  AddDetail( ({"dolche","dolch"}), 
            "Einige der Dolche sind mit magischen Runen ueberzogen. Andere "
	    "wiederum besitzen kostbare Edelsteine. Du solltest aber besser "
	    "keinen Dolch stehlen, da Du nicht weisst, was passiert. Aber "
	    "grundsaetzlich ist es ja Deine Entscheidung.");

  AddDetail( ({"haken"}),
	    "Die Haken sind sehr spitz. Du willst eigentlich nicht genau "
	    "wissen, fuer was fuer Rituale sie gebraucht werden.");

  AddDetail( ({"ringe"}),
	    "Die Ringe haben fuer Dich keinerlei Bedeutung. Du weisst "
	    "jedenfalls nicht, wozu man sie gebrauchen kann.");

  AddDetail( ({"buecher"}),
	    "Die Buecher sind in einer Sprache geschrieben, die Du nicht "
	    "verstehst. Nur ein Buch");

  AddSpecialDetail( ({ "buecher" }), "buecher" );

  AddSpecialDetail( ({ "buch","anfaenger" }), "buch" );

  AddSpecialDetail( ({ "buchruecken","titel" }), "buchruecken" );  

  AddSpecialDetail( ({ "aufkleber","eigentum" }), "aufkleber" );  

  AddDetail( ({"groesse"}),
	    "Es gibt grosse und kleine Glaeser auf den Regalen.");

  AddDetail( ({"sachen"}),
	    "Du siehst alle moeglichen Kreaturen in den Glaesern, aber auch "
	    "einzelne Augen, Zungen und sogar ganze Koepfe.");

  AddDetail( ({"runen"}), 
            "Die Runen auf den Dolchen sind ebenfalls magisch.");

  AddDetail( ({"edelsteine"}),
	    "Du erkennst ein paar Smaragde, Rubine und Diamanten.");

  AddDetail( ({"rituale","geschmack"}),
	    "Die Rituale sind sicher nicht nach Deinem Geschmack und "
	    "verursachen sicher Schmerzen.");

  AddDetail( ({"schmerzen"}),
	    "Schmerzen sind nicht gerade angenehm.");
  
  AddDetail( ({"rubine"}),
	    "Die Rubine glaenzen im Schein des Feuers blutrot.");

  AddDetail( ({"smaragde"}), 
            "Die Smaragde sind gruen und sicher sehr wertvoll.");

  AddDetail( ({"diamanten"}),
	    "Die Diamanten sind einfach nur einzigartig und strahlen Dich an.");

  AddDetail( ({"schein"}),
	    "Der Schein des Feuers erhellt die ganze Kammer.");

  AddDetail( ({"bedeutung"}),
	    "Die Ringe haben sicher eine Bedeutung, jedoch entzieht sie sich "
	    "Dir.");
  
  AddDetail( ({"sprache","sprachen"}),
	    "Du verstehst nicht viel von Sprachen.");

  AddDetail( ({"entscheidung"}),
	    "Die Entscheidung liegt ganz alleine bei Dir.");

  AddDetail( ({"kreaturen"}), 
            "Du siehst alle moeglichen kleinen Kreaturen in den Glaesern.");

  AddDetail( ({"augen"}),
	    "Die leblosen Augen aus den Glaesern starren Dich an. Du fuehlst "
	    "Dich nicht besonders gut.");

  AddDetail( ({"zungen","mund","anblick","zunge"}),
	    "Irgendwie versteckt sich Deine Zunge bei dem Anblick ganz hinten "
	    "in Deinem Mund.");

  AddDetail( ({"koepfe","wesen"}),
	    "Die Koepfe passen zu Menschen, Elfen und Zwerge. Du schluckst, "
	    "wenn Du daran denkst, wie grauenvoll diese armen Wesen "
	    "gestorben sind.");
  
  AddDetail( ({"menschen","elfen","zwerge"}),
	    "Es gibt sehr viele Menschen, Elfen und Zwerge im Silberland.");

  AddDetail( ({"silberland"}), 
            "Du bist im Silberland.");

  AddDetail( ({"hoehlen"}),
	    "Du befindest Dich in den Hoehlen der Orks.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Rauch und anderen Sachen in der "
		          "Kammer.");  
 
  AddSmell( ({"rauch"}),
	   "Der Rauch kommt von dem grossen Feuer in der Mitte der Kammer.");

  AddSmell( ({"sachen"}),
	   "Du kannst nicht genau definieren, nach was es hier noch riecht.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Feuer knistern.");

  AddSound( ({"feuer"}),
	   "*knister*knister*knister*");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "orks4");

AddItem(NPC "oschamane", REFRESH_DESTRUCT);

AddCmd( ({"nimm" }), "nehmen" );
AddCmd( ({"stehl","stehle" }), "stehlen" );

}
void reset()
{
  ::reset();
  anzahl=1;
  dolch_anz=1;
}
int nehmen(string str)
{
 object buch;
 notify_fail("Was willst Du nehmen?\n");

 if(!str || str == "") return 0;
 if(!(str == "buch" ||
      str == "buch von regal" )) return 0;
 

 if( str == "buch" ||
     str == "buch von regal"){
    
  if(anzahl < 1)

  {
	  
  write(BS("Die Buecher, die hier noch liegen, solltest Du besser liegen "
	   "lassen.\n"));
 
  say(TPN+" arglt ein wenig.\n");
  return 1;
  }
  else
  {
  write(BS("Du nimmst das Buch vom Regal und steckst es ein. \n"));
 
  say(TPN+" nimmt ein Buch vom Regal und steckt es ein.\n");
  buch=clone_object(OBJ "buch")->move(TP, M_NOCHECK);
  anzahl--;
  return 1;
 }
 }
}
int stehlen(string str)
{
object dolch;
notify_fail("Was moechtest Du stehlen?\n");

if(!str || str == "") return 0;
 if(!(str == "dolch" ||
     str == "dolch von regal" )) return 0;

 if(dolch_anz<1) {
   write(BS("So etwas siehst Du nicht!"));
   return 1;
 }
 if(!present("okrim"))
 {
  write(BS("Da der Orkschamane nicht da ist, steckst Du den Dolch einfach "
           "ein. Fuehl Dich schlecht!"));
  dolch=clone_object(WEAPON "dolch")->move(TP, M_NOCHECK);
  dolch_anz--;
  return -1;
 }

  if(present("\nCHIVASDOLCH", TP)){
	  
  write(BS("Da Du bereits einen hast, brauchst Du keinen mehr.\n"));
 
  say(TPN+" ist ziemlich gierig.\n");
  return -1;
  }

  write(BS("Okrim bemerkt Dich und sagt: Aha, ein kleiner dreckiger Dieb. Dir "
	   "werde ich helfen. Ich brauchte sowieso jemanden fuer ein "
	   "Ritual. Der Schamane schaut Dir in die Augen und paralysiert "
	   "Dich.\n"));
 
  say(TPN+" hat ganz viel Aerger und geraet unter den Bann des Schamanen.\n");
    TP->SetProp(P_PARALYZED, 100);
    TP->SetProp(P_PARALYZED, ([
    PARALYZE_TIME: 10,
    PARALYZE_MSG: "Du bist im Bann des Schamanen.\n",
    PARALYZE_END:"Schlussendlich spricht der Schamane am Ende des Rituals "
                 "einige Woerter der Macht, die Du nicht verstehst. Er hat "
		 "irgendetwas mit Dir gemacht und das ist sicher nicht gut.\n",
    PARALYZE_END_OTHER:"Ein Frosch erwacht aus dem Bann des Schamanen."
                              ]) );	
      call_out("fall1",4);
      TP->SetProp(P_FROG,1);
  return 1;
 }
void fall1()
{
  write(BS( "Der Schamane nimmt in aller Ruhe einen Dolch vom Regal und kommt "
	    "langsam auf Dich zu. Ausserdem hat er einige Haken und andere "
	    "Utensilien in der Hand.\n"));
  call_out("fall2",4);
}  
void fall2()
{
  write(BS( "Der Schamane beginnt eine Art Singsang und ritzt Dir dabei die "
	    "Haut an mehreren Stellen auf. Du spuerst einen starken Schmerz "
	    "und ein Brennen auf der ganzen Haut.\n"));
    call_out("fall3",4);
}  
void fall3()
{
  write(BS( "Die naechsten Minuten vergehen fuer Dich wie Stunden, in denen "
	    "die Haken und anderen Utensilien zur Benutzung kommen. Du "
	    "spuerst nur noch Schmerzen am ganzen Koerper. Du wirst den "
	    "Schamanen sicher nie wieder bestehlen.\n"));
}
string buecher(string key)
{
    if ( anzahl )
    {
    return(BS("Die Buecher sind in einer Dir fremden Sprache geschrieben und "
	      "Du verstehst sie nicht. Ein Buch jedoch scheint anders zu "
	      "sein."));
    }
    else
    {
    return(BS("Die Buecher sind in einer Dir fremden Sprache geschrieben und "
	      "Du verstehst sie nicht. Komm spaeter einmal wieder, vielleicht "
	      "gibt es dann ein Buch, dass Du verstehst."));
    }
}
string buch(string key)
{
    if ( anzahl )
    {
    return(BS("Das Buch heisst 'Orkmagie fuer Anfaenger' und hat am "
	      "Buchruecken einen grossen Aufkleber."));
    }
    else
    {
    return(BS("Momentan gibt es hier kein Buch, dass Dich interessieren "
              "koennte. Komm spaeter noch einmal wieder."));
    }
}
string buchruecken(string key)
{
    if ( anzahl )
    {
    return(BS("Auf dem Buchruecken siehst Du den Titel 'Orkmagie fuer "
	      "Anfaenger' und einen grossen Aufkleber."));
    }
    else
    {
    return(BS("Die Buecher, die hier noch liegen, wirken nicht sehr "
	      "interessant und was auf den Buchruecken steht, kannst Du "
	      "sowieso nicht lesen."));
    }
}
string aufkleber(string key)
{
    if ( anzahl )
    {
    return(BS("Auf dem Aufkleber steht: Eigentum der Bibliothek von Roch "
	      "Adan. Nimm doch das Buch und gib es dem Bibliothekar. Er "
	      "wird sich sicher darueber freuen."));
    }
    else
    {
    return(BS("Du siehst keinen Aufkleber."));
    }
}
