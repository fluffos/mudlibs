// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"Der Gang der Hoehle wird mit brennenden Fackeln an der Wand erhellt. "
	"Die groben Waende sind ausserdem mit verschiedenen Zeichnungen von "
	"den Bewohnern der Hoehle verziert wurden. Der Boden ist dreckig und "
	"von den vielen Stiefeln, die hier schon entlang gegangen sind, "
	"ausgetreten." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"gang","ganges","tunnel"}), 
            "Der Gang fuehrt tiefer in die Hoehlen der Orks hinein.");

  AddDetail( ({"hoehle","hoehlen","orkhoehlen"}),
	    "Die Hoehlen der Orks unter der Hochebene von Gorthad sind riesig "
	    "und hunderte von Orks sollen hier hausen.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln erhellen den Tunnel, in dem Du Dich befindest, ein "
	    "wenig. Sie haengen in alten verrosteten Halterungen an den "
	    "Waenden.");

  AddDetail( ({"wand","waende","waenden","hoehlenwand"}),
	    "Die Waende sind natuerlich entstanden und an einigen Stellen "
	    "grob behauen um den Gang ein wenig zu vergroessern. Ausserdem "
	    "erkennst Du einige Zeichnungen zwischen den Halterungen der "
	    "Fackeln.");
  
  AddDetail( ({"zeichnungen"}),
	    "Die Zeichnungen sehen ein wenig kindlich aus, zeigen jedoch "
	    "grosse Brutalitaet. Die Orks sind sicher keine Meister darin, "
	    "ihr Leben in Bildern darzustellen. Auch einige Schriftzuege sind "
	    "zu erkennen.");

  AddDetail( ({"bewohner","bewohnern"}), 
            "Die Bewohner dieser Hoehlen sind hauptsaechlich Orks.");

  AddDetail( ({"boden"}),
	    "Der Boden ist dreckig und feucht. Er sieht ziemlich ausgetreten "
	    "aus.");

  AddDetail( ({"stiefeln","stiefel"}),
	    "Viele Stiefel haben den Boden des Ganges ausgetreten.");

  AddDetail( ({"decke"}),
	    "Die Decke ist kahl und uninteressant.");
  
  AddDetail( ({"hochebene","gorthad"}),
	    "Die Hoehlen befinden sich unterhalb der Hochebene von Gorthad.");

  AddDetail( ({"orks"}), 
            "Die Orks sind eine boesartige Rasse. Sie hausen in diesen "
	    "Hoehlen.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen der Fackeln sind alt und bestehen beinahe nur "
	    "noch aus Rost.");

  AddDetail( ({"stellen"}),
	    "An einigen Stellen wurde die Hoehlenwand grob bearbeitet, um den "
	    "Gang ein wenig zu vergrossern.");

  AddDetail( ({"meister","bilder","bildern"}),
	    "Die Zwerge sind in dieser Kunst viel bewanderter als die Orks.");
  
  AddDetail( ({"zwerge","kunst"}),
	    "Besuche einmal die Zwergenfeste von Ardhmir. Dort gibt es "
	    "wunderschoene Steinmetzarbeiten.");

  AddDetail( ({"zwergenfeste","ardhmir","steinmetzarbeiten","reliefs"}), 
            "Die Zwergenfeste von Ardhmir befindet sich nicht weit entfernt "
	    "von den Orkhoehlen. Sie ist beruehmt fuer ihre Reliefs und "
	    "Steinmetzarbeiten.");

  AddDetail( ({"leben"}),
	    "Das Leben der Orks besteht aus Kaempfen, Morden und Rauben.");

  AddDetail( ({"kaempfen","morden","rauben","talent"}),
	    "Dafuer haben die Orks ein wahres Talent.");

  AddDetail( ({"brutalitaet"}),
	    "Die Brutalitaet, die Du in den Zeichnungen erkennen kannst, ist "
	    "unglaublich. Das dargestellte Greuel laesst Dir die Nackenhaare "
	    "aufstellen.");
  
  AddDetail( ({"schriftzuege","inhalte"}),
	    "Die Schriftzuege haben meistens obszoene Inhalte, die hier nicht "
	    "genannt werden sollten. Ein Schriftzug faellt Dir aber besonders "
	    "auf.");

  AddDetail( ({"rasse","rassen"}), 
            "Es gibt viele Rassen im Silberland, aber nur wenige sind so "
	    "brutal wie die Orks.");

  AddDetail( ({"rost","eisen"}),
	    "Der Rost ueberwiegt an den Halterungen. Das Eisen ist kaum noch "
	    "zu sehen, aus dem die Halterungen urspruenglich bestanden haben.");

  AddDetail( ({"silberland"}),
	    "Du befindest Dich im Silberland.");

  AddDetail( ({"schriftzug"}),
	    "Du kannst ihn lesen.");
  
  AddDetail( ({"nackenhaare"}),
	    "Davon hast Du besonders viele.");

  AddDetail( ({"greuel"}), 
            "Das dargestellte Greuel ist trotz der kindlichen Zeichnungen "
	    "erschreckend und sollte hier nicht weiter beschrieben werden.");

  AddDetail( ({"schrift"}),
	    "Ein Schriftzug ist in filigraner Schrift geschrieben. Du kannst "
	    "den Schriftzug lesen.");
  
  AddDetail( ({"dreck"}),
	    "Es liegt ziemlich viel Dreck auf dem Boden");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Dreck.");  
 
  AddSmell( ({"dreck"}),
	   "Es riecht hier wirklich nicht besonders gut.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Orks in den Hoehlen.");

  AddSound( ({"orks","hoehlen"}),
	   "Die Orks machen teilweise ziemlich viel Laerm.");
  
  AddSound( ({"laerm"}),
	   "Eigentlich willst Du nicht wirklich wissen, was sie in den Hoehlen "
	   "machen.");

  AddReadDetail( ({"schriftzug"}),
           "Du kannst es kaum fassen, aber da steht in filigraner Schrift "
	   "geschrieben: \n"
	   "                                 \n"
	   "Rikz war hier!!! \n"
	   "                                 \n");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "orks2");
AddExit("osten", ROOM "orks4");
AddExit("nordwesten", ROOM "orks7");
AddExit("suedwesten", ROOM "orks6");
AddExit("westen", ROOM "orks5");

}

