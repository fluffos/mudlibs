// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int dietrich_zahl;

void create()
	
{
  ::create();

  dietrich_zahl=1;

  SetProp( P_INT_SHORT, "In einem grob behauenen Gang");
  SetProp( P_INT_LONG,
	"Der Gang in dem Du stehst ist breit und die Decke sehr hoch. Die "
        "Waende sind nur sehr grob behauen, als ob die Arbeiten hier "
        "abgebrochen wurden. In der Nordwand und in der Westwand ist "
        "jeweils ein Tor eingesetzt worden. Am Boden liegen grosse "
	"Steinbrocken und verschiedene andere Sachen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 0 );

//-----Details Anfang-----
 
  AddDetail( ({"gang"}), 
            "Der Gang in dem Du stehst, ist zwar breit und hoch, jedoch sieht "
	    "er unfertig auf, als ob die Arbeiten abrupt eingestellt wurden. "
	    "Im Norden und im Westen ist jeweils ein grosses Tor angebracht "
	    "worden.");

  AddDetail( ({"decke"}),
	    "Die Decke ueber Dir ist grob behauen. Eine Zacken an der Decke "
	    "faellt Dir besonders auf.");

  AddDetail( ({"waende","wand","waenden","moment"}),
	    "Die Waende sehen auch unfertig bearbeitet aus. Die Arbeiten "
	    "wurden von einem Moment auf den anderen eingestellt. Es haengen "
	    "noch nicht einmal Fackeln an den Waenden. In der Nordwand und in "
	    "der Westwand ist jeweils ein grosses Tor eingesetzt worden.");

  AddDetail( ({"arbeiten"}),
	    "Die Arbeiten wurden abrupt eingestellt. Du weisst auch nicht, wer "
	    "hier gearbeitet hat. Es ist nicht ersichtlich ob es die Orks oder "
	    "die Zwerge waren. Sicher ist nur, dass die beiden Rassen hier "
	    "aufeinander gestossen sind und beide sich mit den Toren "
	    "voreinander schuetzen.");
  
  AddDetail( ({"nordwand","handwerker", "nordtor"}),
	    "In der Nordwand ist ein Tor - das Nordtor, dass in die Hoehlen der Orks "
	    "fuehrt. Es sieht ein wenig klaeglich aus, da die Orks nicht so "
	    "gute Handwerker sind.");
  
  AddDetail( ({"westwand"}), 
            "In der Westwand befindet sich ein schweres Eisentor - das Westtor, dass in die "
	    "Zwergenfeste von Ardhmir fuehrt.");

  AddDetail( ({"tor","tore","toren"}),
	    "Welches Tor meinst Du? Es gibt ein Nordtor und ein Westtor.");

  AddDetail( ({"nordtor"}),
	    "Das Nordtor sieht schlecht verarbeitet aus und fuehrt in die "
	    "Hoehlen der Orks.");

  AddDetail( ({"westtor","eisentor"}),
	    "Das Westtor besteht aus hartem Eisen und fuehrt in die "
	    "Zwergenfeste von Ardhmir.");
  
  AddDetail( ({"boden"}),
	    "Am Boden liegen grosse Steinbrocken und alle moeglichen Sachen.");

  AddDetail( ({"steinbrocken","brocken"}), 
            "Die grossen Steinbrocken sind sicher von der unfertigen Decke "
	    "oder den Waenden abgebrochen.");

  AddDetail( ({"sachen"}),
	    "Es liegen einige alte Ruestungsteile, ein paar Waffen und viele "
	    "Knochen herum.");

  AddDetail( ({"norden","westen"}),
	    "Im Norden und im Westen ist jeweils ein Tor.");

  AddDetail( ({"zacken"}),
	    "Als Du den Zacken, der von der Decke herunter haengt, genauer "
	    "betrachtest, erkennst Du ein Loch, was nach oben fuehrt.");
  
  AddDetail( ({"fackeln"}),
	    "Es sind leider keine Fackeln vorhanden.");

  AddDetail( ({"orks","naehe"}), 
            "Die Orks leben hier ganz in der Naehe in ihren Hoehlen.");

  AddDetail( ({"zwerge"}),
	    "Die Zwerge wohnen gleich hinter dem Tor im Westen.");

  AddDetail( ({"hoehlen"}),
	    "Die Hoehlen der Orks sollen sehr weitlaeufig sein.");

  AddDetail( ({"zwergenfeste","ardhmir"}),
	    "Die Zwergenfeste von Ardhmir ist vor allem durch ihren Reichtum "
	    "im Silberland beruehmt.");
  
  AddDetail( ({"ruestungsteile","teile"}),
	    "Die Ruestungsteile sind zum groesstenteils verrottet. Da kann man "
	    "sicher gar nichts mehr von benutzen oder lohnt sich eine "
	    "Durchsuchung der Reste.");

  AddDetail( ({"waffen"}), 
            "Die Waffen sind alle zerborsten und nicht mehr zu gebrauchen. Du "
	    "solltest sie einfach liegen lassen.");

  AddDetail( ({"knochen"}),
	    "Die Knochen sehen aus, als ob sie zu Zwergen und auch zu Orks "
	    "passen koennten.");

  AddDetail( ({"loch"}),
	    "Das Loch fuehrt schraeg nach oben. Wenn Du auf einen grossen "
	    "Steinbrocken klettern wuerdest, koenntest Du sicher das Loch "
	    "erreichen und hochklettern.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland.");
  
  AddDetail( ({"rassen"}),
	    "Die beiden Rassen sind miteinander verfeindet und koennen sich "
	    "wirklich nicht leiden.");

  AddDetail( ({"durchsuchung","reste"}), 
            "Eine Durchsuchung ist immer eine gute Idee.");

  AddDetail( ({"idee","ideen"}),
	    "Du hast immer sehr viele Ideen. Die meisten sind zwar nicht viel "
	    "wert, aber immerhin gibst Du nicht auf.");

  AddDetail( ({"eisen"}),
	    "Das geschmiedete Eisen der Zwerge ist sehr hart.");

  AddDetail( ({"reichtum"}),
	    "Der Reichtum ist ueberall bekannt.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Die Luft ist stickig.");  
 
  AddSmell( ({"luft"}),
	   "Die Luft riecht alt und abgestanden.");

  AddSound(DEFAULT_SOUND, "Es ist totenstill in dem Gang.");

  AddSound( ({"gang"}),
	   "------------------");
  
//-----Details Ende-----

  //AddCmd( ({"oeffne" }), "oeffnen" );
  AddCmd( ({"kletter","klettere" }), "klettern" );
  AddCmd( ({"durchsuch","durchsuche" }), "durchsuchen" );

  NewDoor("westen", ZWERGENFESTE+"/room/zwfe28",
             ({"tor", "westtor"}), ({
             D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY | DOOR_CLOSED,
	     D_LONG,   BS("Das Tor im Westen besteht aus einem grossen Gitter aus "
                         "Eisenstaeben. Durch das Tor kommt man so schnell nicht."),
	     D_GENDER, NEUTER,
	     D_SHORT, "Eine %ses Tor Richtung Westen.",
	     D_NAME, "Tor",
	     
              }) );
  NewDoor("norden",ROOM "orks13",
             ({"tor", "nordtor"}), ({
             D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY | DOOR_CLOSED,
	     D_LONG,   BS("Das Tor im Norden besteht aus einem grossen Gitter aus "
                         "Eisenstaeben. Durch das Tor kommt man so schnell nicht."),
	     D_GENDER, NEUTER,
	     D_SHORT, "Eine %ses Tor Richtung Norden.",
	     D_NAME, "Tor",
	     
              }) );

}
    
void reset()
{
  ::reset();
  dietrich_zahl=1;
}
int durchsuchen(string str)
{
  object dietrich;
  notify_fail( "Was moechtest Du durchsuchen?\n" );
  if ( member( ({ "reste","ruestungsteile" }), str ) != -1 ) 

   {
     if( dietrich_zahl < 1 )
     {
        write("Du durchwuehlst die Reste der Ruestungsteile, aber findest "
	      "momentan leider nichts.\n");
        say(sprintf("%s durchwuehlt sinnlos die alten "
		    "Ruestungsteile.\n", TP->Name(WER)));
        return -1;
     }
      if ( present("\nchivasdietrich",TP) )
      {
      write("Du hast bereits einen Dietrich, wie viele willst Du denn "
      +"noch ?\n" );
      say(sprintf("%s stellt sich dumm an.\n", TP->Name(WER)));
      return -1;
      }
      else
      {
        {dietrich = clone_object("/d/kristallwald/chivas/zentauren/obj/dietrich.lpc");
        if ( ME_TOO_HEAVY == dietrich->move(TP,M_GET|M_SILENT) )

          {
          write(
          "Der Dietrich ist Dir zu schwer. Du Weichei!\n" );
          say(BS(sprintf("%s findet einen Dietrich und laesst ihn fallen.\n", TP->Name(WER))));
          dietrich -> remove();
          return 1;
          }
          else
          {
          write("Du durchwuehlst die Reste der Ruestungsteile und findest "
		"ploetzlich einen Dietrich.\n");
          say(sprintf("%s findet etwas.\n",
          TP->Name(WER)));
          dietrich_zahl--;
          return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}
