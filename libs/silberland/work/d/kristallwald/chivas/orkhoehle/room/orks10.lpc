int nord()
{
 write(BS("Du verlaesst den Gang nach Norden und betrittst die Hoehlen der "
	  "Orks. Das Tor schlaegt scheppernd hinter Dir zu.\n"));
 say(TPN+" verschwindet aus dem Gang nach Norden und das Tor faellt zu.\n");
 RemoveExit("norden");
 this_player()->move(ROOM "orks13", M_GO);
 return 1;
}
int west()
{
 write(BS("Du verlaesst den Gang durch das Tor im Westen und betrittst die "
	  "Zwergenfeste von Ardhmir. Das schwere Eisentor schlaegt hinter Dir "
	  "zu.\n"));
 say(TPN+" verschwindet aus dem Gang nach Westen und das Tor faellt zu.\n");
 RemoveExit("westen");
 this_player()->move( "/d/kristallwald/chivas/zwergenfeste/room/zwfe28", M_GO);
 return 1;
}
int klettern(string str)
{
   notify_fail("Moechtest Du etwa auf einen grossen Steinbrocken klettern?\n");
   if ( member( ({ "auf grossen steinbrocken","auf grossen brocken" }),str) != -1) 
  {
    write(BS ( "Du kletterst auf den grossen Steinbrocken und erreichst das "
	       "Loch. Du erkennst, dass das Loch ein Tunnel ist und kletterst "
	       "weiter nach oben.\n"));
      TP->move( ROOM "orks10-1", M_GO, 
      "ploetzlich in einem Loch in der Decke", "verschwindet", 
      "zwaengt sich aus einem Loch im Boden herein");
    return 1;
  }
}
