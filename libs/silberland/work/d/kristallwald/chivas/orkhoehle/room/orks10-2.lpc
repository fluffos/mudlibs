// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hochebene von Gorthad");
  SetProp( P_INT_LONG,
	"Du stehst in der Graslandschaft der Hochebene. Im Suedosten "
	"befindet sich eines der vielen Huegelgraeber und im Nordosten "
	"befindet sich ein befestigter Weg, der ueber die Hochebene fuehrt. "
	"Im Sueden geht es weiter durch die Graslandschaft." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"graslandschaft","landschaft"}), 
            "Du stehst mitten in der Graslandschaft der Hochebene.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Du befindest Dich auf der Hochebene von Gorthad.");

  AddDetail( ({"suedosten","huegelgraeber","graeber","graebern"}),
	    "Im Suedosten sind die beruehmten Huegelgraeber von Gorthad. Viele "
	    "Blumen wachsen auf den Graebern.");

  AddDetail( ({"nordosten","weg"}),
	    "Im Nordosten ist der befestigte Weg, der ueber die Hochebene "
	    "fuehrt.");
  
  AddDetail( ({"sueden"}),
	    "Im Sueden geht es weiter durch die Graslandschaft der Hochebene.");

  AddDetail( ({"boden"}), 
            "Am Boden ist nur Gras zu sehen.");

  AddDetail( ({"himmel","sonne"}),
	    "Der Himmel ist blau und die Sonne scheint.");

  AddDetail( ({"blumen"}),
	    "Die Blumen sind weiss und wunderschoen.");

  AddDetail( ({"gras"}),
	    "Das Gras ist schoen gruen.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst die Blumen, die auf den Graebern "
		  "wachsen.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen duften herrlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind ueber die Hochebene rauschen.");

  AddSound( ({"wind"}),
	   "*rausch*");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "orks10-1");
AddExit("nordosten", "/d/kristallwald/chivas/hochebene/room/hoch16");


}
