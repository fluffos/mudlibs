// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"Dies scheint die Kammer eines Hauptmannes zu sein, da neben einem "
	"Bett auch noch ein Tisch mit lauter Papieren und Karten zu sehen "
	"ist. An den Waenden haengen einige typische Orkwaffen in Halterungen "
	"und ein grosses Regal an der hinteren Seite der Kammer faellt Dir "
	"auf." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"kammer","zuhause"}), 
            "Die Kammer ist das Zuhause von einem Hauptmann der Orks. Er "
	    "arbeitet hier die naechsten Raubzuege der Horde aus.");

  AddDetail( ({"hauptmannes","hauptmann","hauptmanns"}),
	    "Der Hauptmann ist dafuer zustaendig, dass die Horde nicht kopflos "
	    "ueber alles herfaellt, was ausserhalb der Hoehlen rumlaeuft.");

  AddDetail( ({"bett"}),
	    "Das Bett ist zwar ein wenig fleckig, aber nicht so dreckig wie "
	    "die Betten in den anderen Kammern.");

  AddDetail( ({"tisch"}),
	    "Auf dem Tisch liegen lauter Papiere und Karten.");
  
  AddDetail( ({"papieren","papiere","sprache"}),
	    "Die Papiere sind in einer Dir fremden Sprache geschrieben und "
	    "leider verstehst Du sie nicht.");

  AddDetail( ({"karten"}), 
            "Die Karten zeigen die Hochebene, die Stadt der Zentauren und die "
	    "Zwergenfeste von Ardhmir.");

  AddDetail( ({"wand","waenden","waende"}),
	    "An den Waenden haengen zahlreiche Orkwaffen in den Halterungen. "
	    "Ansonsten ist an den Waenden nicht viel zu sehen.");

  AddDetail( ({"orkwaffen","waffen"}),
	    "Die Orkwaffen sehen spitz und gefaehrlich aus. Mit diesen Waffen "
	    "wuerdest Du nie kaempfen, da sie speziell fuer die Orks "
	    "entwickelt wurden.");

  AddDetail( ({"halterungen"}),
	    "In den Halterungen haengen spezielle Waffen fuer die Orks.");
  
  AddDetail( ({"seite","regal"}),
	    "An der hinteren Seite ist ein Regal zu sehen. Verschiedene Dinge "
	    "liegen auf dem Regal.");

  AddDetail( ({"boden","sinn","ordnung"}), 
            "Der Boden ist zwar nicht sauber, aber bei weitem nicht so "
	    "dreckig wie sonst in den Orkhoehlen. Anscheinend hat der "
	    "Hauptmann einen gewissen Sinn fuer Ordnung.");

  AddDetail( ({"decke"}),
	    "An der Decke haengt eine kleine Oellampe, die die Kammer ein "
	    "wenig erhellt.");

  AddDetail( ({"orks","ork"}),
	    "Viele Orks in den Hoehlen gehoeren zur Horde, die der Hauptmann "
	    "kommandiert.");

  AddDetail( ({"raubzuege","aufgabe"}),
	    "Die Raubzuege der Orks muessen gut geplant werden. Diese Aufgabe "
	    "hat der Hauptmann, der hier wohnt.");
  
  AddDetail( ({"horde"}),
	    "Die Horde wird von dem Hauptmann kommandiert.");

  AddDetail( ({"hoehlen","orkhoehlen"}), 
            "Die Hoehlen sind von vielen Orks bewohnt.");

  AddDetail( ({"betten"}),
	    "Die Betten in den anderen Kammern sind viel dreckiger als das "
	    "Bett des Hauptmanns. Er ist ein wenig reinlicher, aber sicher "
	    "noch nicht sauber.");

  AddDetail( ({"kammern"}),
	    "In den anderen Kammern schlafen die normalen Orks. Sie haben "
	    "keine einzelne Kammer nur fuer sich wie der Hauptmann.");

  AddDetail( ({"hochebene","gorthad"}),
	    "Die Orkhoehlen befinden sich unterhalb der Hochebene von "
	    "Gorthad.");
  
  AddDetail( ({"zwergenfeste","ardhmir","feste","naehe"}),
	    "Die Zwergenfeste von Ardhmir ist ganz in der Naehe der "
	    "Orkhoehlen. Ein Angriff auf die Feste muss sehr genau geplant "
	    "werden, da die Zwerge sehr gute Kaempfer sind und ihre "
	    "Zwergenfeste hervorragend verteidigen.");

  AddDetail( ({"stadt","zentauren","roch","adan","roch adan","tritt"}), 
            "Roch Adan ist die Stadt der Zentauren. Sie wurde schon lange "
	    "nicht mehr von den Orks ueberfallen, da der Tritt eines "
	    "Zentauren auch fuer einen Ork toedlich ist.");

  AddDetail( ({"dinge"}),
	    "Du erkennst einige persoenliche Sachen und ein beschriebenes "
	    "Pergament.");

  AddDetail( ({"oellampe","lampe"}),
	    "Die Lampe an der Decke erhellt die Kammer soweit, dass Du alles "
	    "gut sehen kannst.");

  AddDetail( ({"zwerge","kaempfer"}),
	    "Die Zwerge von Ardhmir sind fuer ihre kaempferischen Faehigkeiten "
	    "im ganzen Silberland bekannt.");
  
  AddDetail( ({"faehigkeiten"}),
	    "Geh doch einfach mal hin und teste sie aus.");

  AddDetail( ({"silberland"}), 
            "Du bist im Silberland.");

  AddDetail( ({"sachen"}),
	    "Die persoenlichen Sachen des Hauptmanns gehen Dich nichts an. Du "
	    "magst es doch auch nicht, wenn Jemand in Deinen persoenlichen "
	    "Sachen stoebert.");

  AddDetail( ({"jemand"}),
	    "Falls es Jemand macht, dann sicher nur ein Magier.");

  AddDetail( ({"magier","magiern"}),
	    "Du kannst den Magiern im Silberland ruhig vertrauen. *grins*");
  
  AddDetail( ({"pergament"}),
	    "Das Pergament sieht wie eine Art Plan aus.");
  
  AddDetail( ({"art","plan"}),
	    "Der Plan zeigt den geplanten Angriff auf Roch Adan. Du solltest "
	    "den Koenig der Zentauren warnen.");
  
  AddDetail( ({"koenig","roarex"}),
	    "Roarex ist der Koenig der Zentauren.");
  
  AddDetail( ({"angriff"}),
	    "Ein Angriff der Orks ist sicher toedlich.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht hier nicht ganz so schlimm wie sonst in "
		  "der Hoehle.");  
 
  AddSmell( ({"hoehle"}),
	   "Ansonsten riecht es in der Hoehle ekelig.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Oellampe flackern.");

  AddSound( ({"oellampe","lampe"}),
	   "*flacker*");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "orks22");

AddItem(NPC "ohauptmann", REFRESH_DESTRUCT);

}

