// von Chivas

inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Orkhoehle");
  SetProp( P_INT_LONG,
	"Die einzelnen Tunnel und Kammern in der Hoehle wirken wie ein "
	"grosses Labyrinth, in dem man sich leicht verirren kann. Fast alle "
	"Tunnel wirken gleich und staendig sind andere Abzweigungen zu sehen. "
	"Wenn man sich hier herein gewagt hat, ohne eine Karte zu zeichnen, "
	"dann findet man vielleicht nie mehr heraus." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"tunnel"}), 
            "In der Orkhoehle gibt es viele Tunnel, die fast gleich aussehen.");

  AddDetail( ({"kammern"}),
	    "Die vielen Kammern in der Hoehle koennen einen leicht verwirren.");

  AddDetail( ({"hoehle","orkhoehle","hoehlen","orkhoehlen"}),
	    "Du befindest Dich in den Hoehlen der Orks.");

  AddDetail( ({"labyrinth"}),
	    "Die Orkhoehlen sind fast wie ein Labyrinth. Hoffentlich hast Du "
	    "eine Karte gezeichnet.");
  
  AddDetail( ({"abzweigungen"}),
	    "Die vielen Abzweigungen fuehren jeweils in neue Tunnel und "
	    "Kammern.");

  AddDetail( ({"karte"}), 
            "Eine Karte waere hier in den Hoehlen nicht schlecht.");

  AddDetail( ({"boden"}),
	    "Der Boden ist feucht und einige Felsbrocken liegen herum.");

  AddDetail( ({"decke"}),
	    "In der Decke sind einige Risse zu sehen.");

  AddDetail( ({"waenden","waende","wand"}),
	    "An den Waenden haengen verrostete Halterungen.");
  
  AddDetail( ({"orks"}),
	    "Die Orks leben in diesen Hoehlen und fuehlen sich anscheinend "
	    "wohl hier.");

  AddDetail( ({"felsbrocken","brocken"}), 
            "Die Felsbrocken haben sich wohl von der Decke geloest und sind "
	    "auf den Boden gefallen.");

  AddDetail( ({"risse"}),
	    "Die Decke ist rissig. Einige Felsbrocken haben sich aus der "
	    "Decke heraus geloest und sind runter gefallen.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen sind alt und bestehen fast nur noch aus Rost.");

  AddDetail( ({"rost"}),
	    "Der Rost wirkt roetlich im Schein der Fackeln.");
  
  AddDetail( ({"schein","fackeln"}),
	    "Die Fackeln erhellen diesen Teil der Hoehle ein wenig, so dass "
	    "man hier gut sehen kann.");

  AddDetail( ({"teil"}), 
            "Du bist schon weit in die Orkhoehlen vorgedrungen.");

  AddDetail( ({"atmen"}),
	    "Das Atmen ist durch die verbrauchte Luft und die "
	    "Luftfeuchtigkeit, die hier herrscht nicht so leicht.");

  AddDetail( ({"luftfeuchtigkeit"}),
	    "Die Luftfeuchtigkeit ist sehr gross in der Hoehle.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");
  
  AddSmell(DEFAULT_SMELL, "Die schlechte Luft macht das Atmen nicht besser.");  
 
  AddSmell( ({"luft"}),
	   "Die Luft wirkt verbraucht.");

  AddSound(DEFAULT_SOUND, "Hier herrscht momentan absolute Stille.");

  AddSound( ({"stille"}),
	   "...................");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "orks11");
AddExit("westen", ROOM "orks13");
AddExit("sueden", ROOM "orks9");
AddExit("suedosten", ROOM "orks6");
AddExit("nordosten", ROOM "orks7");
AddExit("osten", ROOM "orks5");

}

