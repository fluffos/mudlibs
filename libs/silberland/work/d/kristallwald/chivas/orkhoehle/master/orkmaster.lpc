//Master Orks

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>


object *ork;
object *orkfeinde;

void create()
{
  if (is_clone(TO))
  {
    destruct(TO);
    return;
  }

  ork = ({});
  orkfeinde = ({});
  
  seteuid(getuid(TO));
  return;
}

//ORKMASTER
add_ork()
{
  ork += ({ PO });
}
ruf_um_hilfe(object spieler)
{
  if ( member(orkfeinde,spieler) == -1 )
    orkfeinde += ({ spieler });
}
remove_ork()
{
  ork -= ({ PO });
}
int Isorkfeind(object enemy)
{
  if ( member(orkfeinde,enemy) != -1 )
    return 1;
  else
    return 0;
}
void Sieg(object player)
{
  orkfeinde -= ({ player });
}
//ENDORKMASTER


void reset()
{
  orkfeinde = ({});
  
  return;
}
