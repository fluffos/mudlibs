#include "../def.h"

inherit "std/room";

int leckereien;

void create()
{
  ::create();

  leckereien = 2 + random(4);

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Im Haus eines Wilderers");
  SetProp(P_INT_LONG,
    "Du betrittst die suedoestliche Huette. Diese Huette ist offenbar fuer "
    "eine einzige Person gedacht. Sie ist simpel eingerichtet. Ein Bett "
    "steht an der Wand gegenueber der Tuer und ein Tisch samt Sessel direkt "
    "neben der Tuer. Vor dem Bett steht eine einfache Kleiderkiste.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

AddDetail(({ "bett" }),
"Ein einfaches Bett steht an der Wand gegenueber der Tuer. Es sieht aus, als ob hier jemand schlaeft.");

AddDetail(({ "boden" }),
"Der Boden der Huette besteht aus festgestampfter Erde.");

AddDetail(({ "decke", "waende", "wand" }),
"Die Decke und die Waende der Huette sind einfach gebaut und schuetzen vor Wind und Wetter.");

AddDetail(({ "huette" }),
"Die suedoestliche Huette ist einfach eingerichtet und fuer eine einzelne Person gedacht.");

AddDetail(({ "kleiderkiste" }),
"Vor dem Bett steht eine einfache Kleiderkiste. Hier bewahrt man vermutlich seine Kleidung auf.");

AddDetail(({ "person" }),
"Die Huette scheint fuer eine einzige Person gedacht zu sein..");

AddDetail(({ "sessel" }),
"Ein einfacher Sessel steht neben dem Tisch. Hier kann man bequem sitzen.");

AddDetail(({ "tisch" }),
"Ein Tisch steht direkt neben der Tuer, zusammen mit einem einfachen Sessel.");

AddDetail(({ "tuer" }),
"Die Tuer fuehrt nach draussen.");

AddDetail(({ "waende" }),
"Die Waende der Huette sind einfach gebaut und schuetzen vor Wind und Wetter.");

AddDetail(({ "wand" }),
"Die Wand der Huette ist einfach gebaut und schuetzt vor Wind und Wetter.");

AddDetail(({ "erde" }),
    "Wirklich fest getretene Erde. Fuer einen echten Boden hat es nicht gereicht.");

AddDetail(({ "kleidung" }),
    "Die Kleidung wird vermutlich in der Kleiderkiste aufbewahrt.");

AddDetail(({ "wetter", "wind", "wettereinfluesse" }),
    "Die Huette bietet Schutz vor Wind und Wetter, was nuetzlich sein duerfte.");

AddDetail(({ "schutz" }),
  "Die Huette bietet ihrem Bewohner Schutz vor den Elementen und gewaehrt einen privaten Raum.");

AddDetail(({ "bewohner" }),
  "Die Huette wird derzeit offenbar bewohnt. Sie ist einfach aber zweckmaessig eingerichtet.");

AddDetail(({ "elementen", "regen", "widrigkeiten" }),
  "Die Huette bietet Schutz vor den Elementen, sei es Regen, Wind oder andere Wettereinfluesse.");

AddDetail(({ "raum", "ruheplatz" }),
  "Der Raum in der Huette ist simpel und dient dem Bewohner als Ruheplatz, geschützt vor den Widrigkeiten der Umgebung.");

AddDetail( ({"umgebung"}),
  "Die findest du drausse, vor der Huette.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "nordwesten", ROOM "wilderer2" );

  AddItem(NPC "eberlieb", REFRESH_DESTRUCT);

  AddCmd("oeffne|oeffen&kiste|kleiderkiste", "cmd_oeffnen", "Was willst du oeffnen?");
}

public int cmd_oeffnen() {
  object key;

  if(!objectp(key=present("\nsuedwald_key_chest", TP))) {
    write(BS("Du versuchst die Kiste zu oeffnen. Sie ist allerdings verspeert. Wieder sowas, wo du einen Schluessel brauchst!"));
    return -1;
  }

  write(BS("Du sperrst die Kiste auf und durchsuchst sie. Abseits von Kleidung findest du noch ein paar Muenzen und Edelsteine! "
           "Leider bricht der Schluessel dabei ab."));
  say(BS(TPN+" sperrt die Kleiderkiste auf und raeumt sie aus."));

  TP->AddMoney(300 + random(700));
  "/obj/gemmaster"->DistributeGem(3,5,1,1);

  key->remove(1);
  return 1;
}
