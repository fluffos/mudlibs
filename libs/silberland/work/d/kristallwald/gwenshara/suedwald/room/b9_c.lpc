#include "../def.h"
inherit ROOM "std_weg_room";

public void create() {
    ::create();

    SetProp(P_INT_LONG, 
        "Du befindest dich hier am Rand des suedlichen Tethyrwalds. Im Nordosten "
        "beginnt offenbar eine gut gepflasterte Strasse. Regelmaessig aufgestellte "
        "Laternen am Rand der Strasse markieren den Beginn der Zivilisation. Oestlich "
        "erkennst du einen Berg, den du hier umrundest, um auf die Strasse zu "
        "gelangen. Ein einfach Waldpfad fuehrt dich nach Suedwesten.");

    AddExit("suedwesten", ROOM "b8_d");
    AddExit("nordosten", ANSCHLUSS_AVIR);

    AddDetail("beginn", "Der Beginn der Gegend zeigt einen gut gepflasterten Weg im Nordosten, der scheinbar in die Zivilisation fuehrt.");
    AddDetail("berg", "Oestlich erhebt sich ein bewaldeter Berg, den du umrunden musst, um auf die gepflasterte Strasse zu gelangen.");
    AddDetail("boden", "Der Boden unter deinen Fuessen fuehlt sich fest und natuerlich an, bedeckt von einem Teppich aus Waldboden und gelegentlichen Steinen.");
    AddDetail("himmel", "Der Himmel ueber dir praesentiert sich in den verschiedensten Nuancen, von einem klaren, tiefen Blau bis zu leicht verschleierten Wolken.");
    AddDetail("laternen", "Regelmaessig aufgestellte Laternen am Rand der Strasse markieren den Beginn der Zivilisation.");
    AddDetail("rand", "Am Rand des Waldpfades nach Suedwesten scheint die Zivilisation in weiter Ferne, waehrend die Baeume des Tethyrwalds behutsam den Uebergang von wilder Natur zu menschengemachter Struktur markieren.");
    AddDetail("strasse", "Der gut gepflasterte Weg im Nordosten wird von regelmaessig aufgestellten Laternen begleitet, die den Beginn der Zivilisation markieren.");
    AddDetail("tethyrwalds", "Die Baeume im Tethyrwald, besonders die Nadeln, tragen eine leicht blaeuliche Faerbung, die dem Wald eine mystische Atmosphaere verleiht.");
    AddDetail("waldpfad", "Ein einfacher Waldpfad fuehrt dich nach Suedwesten, einladend und neugierig machend auf das, was im Inneren des Waldes verborgen liegt.");
    AddDetail("zivilisation", "Die Zivilisation scheint in der Ferne, waehrend der gut gepflasterte Weg und die Laternen den Uebergang von der Wildnis des Tethyrwalds zu menschlichen Einfluessen markieren.");
    AddDetail("atmosphaere", "Die Atmosphaere in der Gegend ist gepraegt von der wilden Natur des Tethyrwalds, waehrend die Laternen den Hauch der Zivilisation ankuendigen.");
    AddDetail("baeume", "Die Baeume im Tethyrwald verleihen der Umgebung eine majestaetische Praesenz, besonders durch ihre leicht blaeuliche Faerbung.");
    AddDetail("blau", "Der Himmel zeigt eine Vielzahl von Blautoenen, von einem klaren, tiefen Blau bis zu leicht verschleierten Wolken.");
    AddDetail("einfluessen", "Der gut gepflasterte Weg und die Laternen markieren den Uebergang von der Wildnis des Tethyrwalds zu menschlichen Einfluessen.");
    AddDetail("faerbung", "Die Baeume im Tethyrwald, besonders die Nadeln, tragen eineun leicht blaeuliche Faerbung, die der Umgebung eine mystische Atmosphaere verleiht.");
    AddDetail("ferne", "Die Zivilisation scheint in der Ferne zu liegen, waehrend der gut gepflasterte Weg die Verbindung zur menschlichen Einflussnahme darstellt.");
    AddDetail("fuessen", "Der Boden unter deinen Fuessen fuehlt sich fest und natuerlich an, bedeckt von einem Teppich aus Waldboden und gelegentlichen Steinen.");
    AddDetail("gegend", "Die Gegend am Rand des Tethyrwalds bietet einen faszinierenden Mix aus wilder Natur und ersten Anzeichen menschlicher Zivilisation.");
    AddDetail("inneren", "Der einfache Waldpfad laedt ein, das Innere des Tethyrwalds zu erkunden und birgt vielleicht noch unentdeckte Geheimnisse.");
    AddDetail("nadeln", "Die Nadeln der Baeume im Tethyrwald tragen zur leicht blaeulichen Faerbung bei und verleihen dem Wald eine einzigartige Atmosphaere.");
    AddDetail("natur", "Die Natur praesentiert sich in ihrer vollen Pracht, von den majestaetischen Baeumen bis zum festen Boden unter deinen Fuessen.");
    AddDetail("nuancen", "Der Himmel zeigt eine Vielzahl von Nuancen, von einem klaren Blau bis zu leicht verschleierten Wolken, was die Szenerie besonders reizvoll macht.");
    AddDetail("steinen", "Der Boden ist mit einem Teppich aus Waldboden und gelegentlichen Steinen bedeckt, was dem Weg eine natuerliche Beschaffenheit verleiht.");
    AddDetail("struktur", "Die gut gepflasterte Strasse und die Laternen bringen Struktur in die Umgebung und markieren den Beginn menschlicher Einflussnahme.");
    AddDetail("teppich", "Ein Teppich aus Waldboden und Steinen bedeckt den festen Boden, waehrend du dich durch den Tethyrwald bewegst.");
    AddDetail("tethyrwald", "Der Tethyrwald beeindruckt mit seinen majestaetischen Baeumen, besonders durch die leicht blaeuliche Faerbung der Nadeln.");
    AddDetail("uebergang", "Der Uebergang von der Wildnis des Tethyrwalds zur Zivilisation wird durch den gepflasterten Weg und die Laternen deutlich hervorgehoben.");
    AddDetail("wald", "Der Wald umgibt dich mit seiner natuerlichen Pracht, waehrend der Waldpfad dazu einlaedt, tiefer in sein Inneres vorzudringen.");
    AddDetail("waldboden", "Der Boden besteht aus einem Teppich aus Waldboden und gelegentlichen Steinen, der den Waldpfad bedeckt.");
    AddDetail("weg", "Der gut gepflasterte Weg im Nordosten fuehrt in die Zivilisation und markiert einen klaren Pfad durch den Tethyrwald.");
    AddDetail("wildnis", "Die Wildnis des Tethyrwalds umgibt dich mit einer faszinierenden Mischung aus majestaetischen Baeumen und natuerlicher Bodenbeschaffenheit.");
    AddDetail("wolken", "Der Himmel ist von leicht verschleierten Wolken durchzogen, die die Szenerie in verschiedene Nuancen von Blau tauchen.");
    AddDetail("anzeichen", "Die Laternen am Rand der Strasse sind erste Anzeichen menschlicher Einflussnahme in dieser natuerlichen Umgebung.");
    AddDetail("beschaffenheit", "Die Beschaffenheit des Bodens unter deinen Fuessen ist fest und natuerlich, bedeckt von einem Teppich aus Waldboden und gelegentlichen Steinen.");
    AddDetail("blautoenen", "Der Himmel zeigt eine Vielzahl von Blautoenen, von einem klaren, tiefen Blau bis zu leicht verschleierten Wolken.");
    AddDetail("bodenbeschaffenheit", "Die Bodenbeschaffenheit besteht aus einem Teppich aus Waldboden und gelegentlichen Steinen, was dem Pfad eine natuerliche Struktur verleiht.");
    AddDetail("einflussnahme", "Die Laternen am Rand der Strasse und der gepflasterte Weg markieren den Beginn menschlicher Einflussnahme auf die wilde Umgebung des Tethyrwalds.");
    AddDetail("geheimnisse", "Der einfache Waldpfad laedt ein, das Innere des Tethyrwalds zu erkunden und birgt vielleicht noch unentdeckte Geheimnisse.");
    AddDetail("hauch", "Die Laternen und der gepflasterte Weg bringen einen Hauch von Zivilisation in die ansonsten wilde Umgebung des Tethyrwalds.");
    AddDetail("innere", "Der Waldpfad laedt ein, das Innere des Tethyrwalds zu erkunden und die verborgene Schoenheit der Natur zu entdecken.");
    AddDetail("inneres", "Der einfache Waldpfad fuehrt dich tiefer in das Inneres des Tethyrwalds, wo die Natur ihre Geheimnisse offenbart.");
    AddDetail("mischung", "Die Gegend bietet eine faszinierende Mischung aus wilder Natur und den ersten Anzeichen menschlicher Zivilisation.");
    AddDetail("mix", "Die Gegend bietet einen faszinierenden Mix aus majestaetischen Baeumen, wilder Natur und den ersten Anzeichen menschlicher Einflussnahme.");
    AddDetail("pfad", "Der gut gepflasterte Pfad im Nordosten fuehrt dich in die Zivilisation und markiert einen klaren Weg durch den Tethyrwald.");
    AddDetail(({"pracht", "schoenheit"}), "Die Pracht des Tethyrwalds zeigt sich in den majestaetischen Baeumen und der natuerlichen Schoenheit der Umgebung.");
    AddDetail("praesenz", "Die majestaetische Praesenz der Baeume verleiht dem Tethyrwald eine eindrucksvolle und erhabene Atmosphaere.");
    AddDetail("szenerie", "Die Szenerie um dich herum wird von der Natur des Tethyrwalds und den ersten Anzeichen menschlicher Einflussnahme gepraegt.");
    AddDetail("umgebung", "Die Umgebung am Rand des Tethyrwalds bietet einen faszinierenden Anblick, gepraegt von wilder Natur und den Spuren menschlicher Praesenz.");
    AddDetail("verbindung", "Der gut gepflasterte Weg und die Laternen schaffen eine Verbindung zwischen der Wildnis des Tethyrwalds und der beginnenden Zivilisation.");
    AddDetail(({"vielzahl", "eindruecke", "eindruecken"}), "Die Umgebung praesentiert eine Vielzahl von Eindruecken, von majestaetischen Baeumen bis zu den ersten Anzeichen menschlicher Einflussnahme.");    
    AddDetail("anblick", "Der Anblick am Rand des Tethyrwalds ist faszinierend, gepraegt von majestaetischen Baeumen und den ersten Anzeichen menschlicher Einflussnahme.");
    AddDetail("spuren", "Die Spuren menschlicher Praesenz sind deutlich sichtbar, insbesondere durch den gut gepflasterten Weg und die regelmaessig aufgestellten Laternen.");
}