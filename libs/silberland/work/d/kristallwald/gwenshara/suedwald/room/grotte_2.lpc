#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

SetProp(P_INT_SHORT, "Ein See im Herzen des Tethyrwalds");
SetProp(P_INT_LONG, "Ein schmaler, sumpfiger Pfad schlaengelt sich am Uferrand "
                    "des Sees durch die wilden Gefilde des Tethyrwaldes. Umgeben "
                    "von blaeulichen Blaettern der Laubbaeume fuehrt der Pfad zu "
                    "einem bescheidenen Wasserfall, dessen sanfte Fluten in ein "
                    "sumpfiges Becken fallen. Das Ufer ist von "
                    "niedrigen Graesern und Wurzeln durchzogen, waehrend der Pfad "
                    "Herausforderungen in Form von feuchten Hindernissen birgt. "
                    "Vor dir oeffnet sich ein unscheinbarer Durchlass zu einer "
                    "Grotte unter dem kleinen Wasserfal. Hier, in dieser sumpfigen "
                    "Oase, wird die ungestueme Wildnis des Tethyrwaldes lebendig.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------

  //--Details----------------------------------------------------------------

  AddDetail( ({ "becken" }),
    "Das sumpfige Becken unter dem Wasserfall wirkt wie ein natuerlicher Sammelplatz fuer die klaren Fluten.");

  AddDetail( ({ "blaettern" }),
    "Die blaeulichen Blaetter der Laubbaeume schimmern im sanften Licht, umgeben von einer magischen Aura.");

  AddDetail( ({ "boden" }),
    "Der sumpfige Boden des Pfades gibt bei jedem Schritt nach, waehrend die Natur ihre unberuehrte Pracht enthuellt.");

  AddDetail( ({ "durchlass" }),
    "Der unscheinbare Durchlass fuehrt zu einer verborgenen Grotte, die von einer geheimnisvollen Energie durchdrungen ist.");

  AddDetail( ({ "fluten" }),
    "Die sanften Fluten des Wasserfalls fallen in das sumpfige Becken, fuellen die Umgebung mit beruhigendem Rauschen und symbolisieren die Kraft des Wassers.");

  AddDetail( ({ "form" }),
    "Die natuerliche Form des schmalen Pfades windet sich entlang des Uferrands und fuehrt zu einem bescheidenen Wasserfall.");

  AddDetail( ({ "gefilde" }),
    "Die wilden Gefilde des Tethyrwaldes erstrecken sich um den schmalen Pfad und spiegeln die ungestueme Natur wider.");

  AddDetail( ({ "graesern" }),
    "Niedrige Graeser schmiegen sich an das Ufer und tanzen sanft im sumpfigen Wind des Tethyrwaldes.");

  AddDetail( ({ "grotte" }),
    "Die verborgene Grotte unter dem Wasserfall birgt Geheimnisse und strahlt eine mystische Aura aus.");

  AddDetail( ({ "herausforderungen" }),
    "Der Pfad birgt Herausforderungen in Form von feuchten Hindernissen, die Abenteurer ueberwinden muessen.");

  AddDetail( ({ "himmel" }),
    "Die Oeffnung des Himmels ueber dem sumpfigen Pfad gibt einen Blick auf die natuerliche Magie des Tethyrwaldes frei.");

  AddDetail( ({ "hindernissen" }),
    "Der Pfad ist mit feuchten Hindernissen gespickt, die den Weg durch die Wildnis erschweren und gleichzeitig Abenteuer bereithalten.");

  AddDetail( ({ "laubbaeume", "laub" }),
    "Die majestaetischen Laubbaeume mit blaeulichen Blaettern saeumen den Uferrand des Sees und schaffen eine malerische Kulisse.");

  AddDetail( ({ "oase" }),
    "Die sumpfige Oase am Uferrand des Sees bietet einen friedlichen Rueckzugsort inmitten der wilden Natur des Tethyrwaldes.");

  AddDetail( ({ "pfad" }),
    "Der schmale, sumpfige Pfad windet sich entlang des Uferrands, eingebettet in die unberuehrte Wildnis des Tethyrwaldes.");

  AddDetail( ({ "sees", "see" }),
    "Der glitzernde See erstreckt sich in malerischer Schoenheit, eingebettet in die ungestueme Wildnis des Tethyrwaldes.");

  AddDetail( ({ "tethyrwaldes", "tethyrwald", "wald" }),
    "Die Aura des Tethyrwaldes durchdringt diesen sumpfigen Ort und verbindet die Wildnis mit der verborgenen Grotte.");

  AddDetail( ({ "ufer" }),
    "Das Ufer des Sees ist von niedrigen Graesern und Wurzeln durchzogen, die die Grenze zwischen Wasser und Land markieren.");

  AddDetail( ({ "uferrand" }),
    "Der Uferrand des Sees ist gesaeumt von blauen Blaettern und majestaetischen Baeumen, die die Grenze zwischen Land und Wasser markieren.");

  AddDetail( ({ "wasserfal" }),
    "Der kleine Wasserfall ergiesst sich in den See und erfuellt die Umgebung mit beruhigendem Rauschen.");

  AddDetail( ({ "wasserfall" }),
    "Der unscheinbare Wasserfall im Nordwesten fuegt sich harmonisch in die wilde Umgebung ein, waehrend seine sanften Fluten das sumpfige Becken speisen.");

  AddDetail( ({ "wildnis" }),
    "Die unberuehrte Wildnis des Tethyrwaldes wird durch die feinen Details dieses sumpfigen Ortes lebendig.");

  AddDetail( ({ "wurzeln" }),
    "Die Wurzeln der Baeume durchziehen den Boden und geben dem Pfad eine natuerliche Struktur, waehrend sie sich sanft im sumpfigen Boden verankern.");

  AddDetail( ({ "abenteuer" }),
    "Der schmale Pfad verspricht ein Abenteuer durch die ungestueme Wildnis des Tethyrwaldes.");

  AddDetail( ({ "abenteurer" }),
    "Abenteurer, die diesen sumpfigen Pfad betreten, werden mit der rohen Schoenheit der Natur konfrontiert.");

  AddDetail( ({ "aura" }),
    "Die Aura dieses Ortes spiegelt die unberuehrte Wildnis und mystische Energie des Tethyrwaldes wider.");

  AddDetail( ({ "baeume" }),
    "Die majestaetischen Baeume des Tethyrwaldes ragen entlang des Pfades und bilden eine natuerliche Kulisse.");

  AddDetail( ({ "baeumen" }),
    "Die majestaetischen Baeume des Tethyrwaldes ragen entlang des Pfades und bilden eine natuerliche Kulisse.");

  AddDetail( ({ "blaetter" }),
    "Die blaeulichen Blaetter der Laubbaeume tanzen im sanften Licht, verleihen dem Wald eine magische Atmosphaere.");

  AddDetail( ({ "blick" }),
    "Von diesem sumpfigen Pfad aus bietet sich ein malerischer Blick auf den glitzernden See und die umgebende Wildnis.");

  AddDetail( ({ "details" }),
    "Die feinen Details des Pfades und der Umgebung offenbaren die Schoenheit und Komplexitaet der Natur.");

  AddDetail( ({ "energie" }),
    "Eine geheimnisvolle Energie durchdringt die verborgene Grotte unter dem Wasserfall.");

  AddDetail( ({ "geheimnisse" }),
    "Die Geheimnisse der Natur werden in den verborgenen Winkeln dieses sumpfigen Pfades gehuetet.");

  AddDetail( ({ "graeser" }),
    "Die niedrigen Graeser am Ufer des Sees wiegen sich im sanften Wind, fuegen sich harmonisch in die Umgebung ein.");

  AddDetail( ({ "grenze" }),
    "Das Ufer des Sees bildet eine natuerliche Grenze zwischen dem klaren Wasser und dem festen Land.");

  AddDetail( ({ "kraft" }),
    "Die Kraft des kleinen Wasserfalls und des umgebenden Waldes wird in jedem Detail spuerbar.");

  AddDetail( ({ "kulisse" }),
    "Die majestaetische Kulisse der blauen Blaetter, Baeume und des glitzernden Sees verleiht dem Ort eine natuerliche Pracht.");

  AddDetail( ({ "land" }),
    "Das feste Land entlang des Ufers bildet einen sicheren Pfad fuer Abenteurer, die die Wildnis erkunden.");

  AddDetail( ({ "licht" }),
    "Das sanfte Licht der Sonnenstrahlen durchdringt das Blaetterdach und taucht den Pfad in eine warme Atmosphaere.");

  AddDetail( ({ "magie" }),
    "Die Magie des Tethyrwaldes schwebt in der Luft und verleiht dem sumpfigen Pfad eine mystische Aura.");

  AddDetail( ({ "natur" }),
    "Die rohe Schoenheit und unberuehrte Natur des Tethyrwaldes offenbaren sich entlang des Pfades.");

  AddDetail( ({ "oeffnung" }),
    "Die Oeffnung des Himmels ueber dem sumpfigen Pfad gibt einen Blick auf die natuerliche Magie des Tethyrwaldes frei.");

  AddDetail( ({ "ort" }),
    "Dieser Ort, umgeben von blaeulichen Blaettern und wilden Gefilden, strahlt eine natuerliche Ruhe aus.");

  AddDetail( ({ "pracht" }),
    "Die Pracht der unberuehrten Natur offenbart sich in jedem Detail dieses Ortes.");

  AddDetail( ({ "rauschen" }),
    "Das beruhigende Rauschen des Wassers und des Windes bildet eine natuerliche Symphonie entlang des sumpfigen Pfades.");

  AddDetail( ({ "rueckzugsort" }),
    "Die sumpfige Oase am Uferrand des Sees bietet einen friedlichen Rueckzugsort inmitten der wilden Natur.");

  AddDetail( ({ "sammelplatz" }),
    "Das sumpfige Becken unter dem Wasserfall wirkt wie ein natuerlicher Sammelplatz fuer die klaren Fluten.");

  AddDetail( ({ "schoenheit" }),
    "Die Schoenheit dieses Ortes offenbart sich in der harmonischen Verbindung von Wasser, Wald und Himmel.");

  AddDetail( ({ "schritt" }),
    "Der weiche Boden gibt bei jedem Schritt nach, waehrend du den sumpfigen Pfad entlang wanderst.");

  AddDetail( ({ "struktur" }),
    "Die Struktur des sumpfigen Bodens und der umgebenden Wurzeln verleiht dem Pfad eine natuerliche Form.");

  AddDetail( ({ "umgebung" }),
    "Die wilde Umgebung des Tethyrwaldes wird durch die feinen Details dieses sumpfigen Pfades lebendig.");

  AddDetail( ({ "wasser" }),
    "Das klare Wasser des Sees spiegelt die Schoenheit des Himmels und der umgebenden Natur wider.");

  AddDetail( ({ "wassers" }),
    "Das klare Wasser des Sees spiegelt die Schoenheit des Himmels und der umgebenden Natur wider.");

  AddDetail( ({ "weg" }),
    "Der sumpfige Pfad windet sich am Uferrand des Sees entlang und fuehrt mutige Entdecker tiefer in die Wildnis.");

  AddDetail( ({ "wind" }),
    "Der sanfte Wind des Tethyrwaldes streicht durch die Baeume und traegt den Duft der wilden Natur mit sich.");

  AddDetail( ({ "atmosphaere" }),
    "Die Atmosphaere dieses Ortes ist von einer wilden, unberuehrten Natur durchzogen, die die Sinne anspricht.");

  AddDetail( ({ "blaetterdach", "gewoelbe" }),
    "Das Blaetterdach der majestaetischen Baeume bildet ein gruenes Gewoelbe ueber dem sumpfigen Pfad.");

  AddDetail( ({ "detail" }),
    "Jedes Detail dieses Ortes traegt zur Schoenheit und Komplexitaet der wilden Natur des Tethyrwaldes bei.");

  AddDetail( ({ "duft" }),
    "Der Duft von frischem Laub und wilden Blumen erfuellt die Luft und verbindet sich mit der natuerlichen Symphonie des Tethyrwaldes.");

  AddDetail( ({ "entdecker" }),
    "Entdecker, die diesen sumpfigen Pfad betreten, werden mit der Faszination der unentdeckten Wildnis konfrontiert.");

  AddDetail( ({ "komplexitaet", "nuancen" }),
    "Die Komplexitaet der Natur zeigt sich in den vielen Nuancen und feinen Details dieses sumpfigen Pfades.");

  AddDetail( ({ "luft" }),
    "Die frische Luft des Tethyrwaldes durchdringt diesen Ort und traegt den Duft der wilden Natur.");

  AddDetail( ({ "ruhe" }),
    "Die natuerliche Ruhe dieses Ortes wird nur vom beruhigenden Rauschen des Wassers und dem sanften Wind durchbrochen.");

  AddDetail( ({ "sonnenstrahlen" }),
    "Die Sonnenstrahlen durchbrechen das Blaetterdach und tauchen den sumpfigen Pfad in ein warmes, goldenes Licht.");

  AddDetail( ({ "symphonie" }),
    "Die Natur spielt eine harmonische Symphonie aus rauschendem Wasser, zwitschernden Voegeln und dem sanften Wind des Tethyrwaldes.");

  AddDetail( ({ "verbindung", "einheit" }),
    "Die Verbindung von Wasser, Wald und Himmel schafft eine harmonische Einheit inmitten der wilden Natur.");

  AddDetail( ({ "winkeln" }),
    "Die verborgenen Winkeln des sumpfigen Pfades bergen Geheimnisse und unentdeckte Schoenheit.");

  AddDetail( ({ "blumen" }),
    "Die wilden Blumen am Ufer des Sees tragen zur bunten Pracht dieses Ortes bei und verstroemen einen betoerenden Duft.");

  AddDetail( ({ "faszination" }),
    "Die Faszination der unberuehrten Wildnis des Tethyrwaldes wird in jedem Detail dieses sumpfigen Pfades spuerbar.");

  AddDetail( ({ "sinne", "anblick", "dueften", "duefte", "geraeuschen", "geraeusche" }),
    "Die Natur dieses Ortes spricht alle Sinne an, von den frischen Dueften bis zu den sanften Geraeuschen und dem harmonischen Anblick.");

  AddDetail( ({ "voegeln", "voegel", "lieder" }),
    "Die Voegel zwitschern in den Baeumen und tragen zu einer lebendigen Atmosphaere bei, waehrend sie ihre Lieder singen.");


//--Ausgaenge--------------------------------------------------------------

  AddExit( "suedosten", ROOM "grotte_1" );
  AddExit( "westen", ROOM "grotte_3");

  AddItem( NPC "schnappi", REFRESH_DESTRUCT );
}