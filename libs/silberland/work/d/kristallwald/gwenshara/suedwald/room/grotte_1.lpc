#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

SetProp(P_INT_SHORT, "Ein See im Herzen des Tethyrwalds");
SetProp(P_INT_LONG, "Inmitten der urtuemlichen Wildnis des Tethyrwaldes "
                    "erstreckt sich der Uferrand eines glitzernden Sees. Die blaeulichen "
                    "Blaetter der Laubbaeume rauschen im Wind, waehrend ein schlammiger Pfad "
                    "sich um den See schlaengelt. Im Nordwesten ist ein kleiner Wasserfall "
                    "zu erkennen, dessen rauschendes Wasser die wilde Atmosphaere verstaerkt. "
                    "Hier im Herzen des Waldes spuehrst du eine Aura der unberuehrten Natur "
                    "und Urtuemlichkeit, die Abenteurer mit der rohen Wildnis des Waldes "
                    "verbindet.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------

AddDetail( ({ "abenteurer" }),
"Abenteurer streifen durch die Wildnis, fasziniert von der unberuehrten Schoenheit.");

AddDetail( ({ "atmosphaere" }),
"Die Atmosphaere ist erfuellt von der wilden Magie des Tethyrwaldes.");

AddDetail( ({ "aura" }),
"Eine Aura der Urtuemlichkeit und Natur umgibt diesen Ort.");

AddDetail( ({ "blaetter" }),
"Die blaeulichen Blaetter der Laubbaeume schimmern im sanften Licht.");

AddDetail( ({ "boden" }),
"Der Boden des schlammigen Pfades gibt bei jedem Schritt nach.");

AddDetail( ({ "herzen" }),
"Die Herzen der Abenteurer pochen im Einklang mit der pulsierenden Natur um sie herum.");

AddDetail( ({ "himmel" }),
"Der Himmel ueber dem Tethyrwald laesst vereinzelt Sonnenstrahlen durch die Blaetter fallen.");

AddDetail( ({ "laubbaeume" }),
"Majestaetische Laubbaeume mit blaeulichen Blaettern erstrecken sich entlang des Uferrandes.");

AddDetail( ({ "natur" }),
"Die unberuehrte Natur des Tethyrwaldes offenbart sich in jeder Ecke.");

AddDetail( ({ "pfad" }),
"Ein schlammiger Pfad windet sich um den See, verbunden mit der Wildnis des Waldes.");

AddDetail( ({ "see", "sees" }),
"Der glitzernde See bildet das Herzstueck dieses malerischen Ortes.");

AddDetail( ({ "tethyrwaldes", "thetyrwald" }),
"Der Tethyrwald umhuellt diesen Ort in seiner urspruenglichen Schoenheit.");

AddDetail( ({ "uferrand" }),
"Der Uferrand des Sees ist gesaeumt von blauen Blaettern und majestaetischen Baeumen.");

AddDetail( ({ "urtuemlichkeit" }),
"Die Urtuemlichkeit der Wildnis dringt durch jede Ecke dieses Ortes.");

AddDetail( ({ "waldes" }),
"Die wilde Natur des Waldes offenbart sich in all ihrer Pracht.");

AddDetail( ({ "wasser" }),
"Das klare Wasser des Sees spiegelt die Schoenheit der umgebenden Wildnis wider.");

AddDetail( ({ "wasserfall" }),
"Ein kleiner Wasserfall im Nordwesten ergiesst sich sanft in den See, untermalt von beruhigendem Rauschen.");

AddDetail( ({ "wildnis" }),
"Die Wildnis des Tethyrwaldes breitet sich in ihrer unberuehrten Pracht aus.");

AddDetail( ({ "wind" }),
"Der Wind streicht durch die Blaetter und traegt den Duft der Wildnis mit sich.");

AddDetail( ({ "baeumen", "baeume" }),
"Die majestaetischen Baeume umgeben den Ort und verleihen ihm eine natuerliche Eleganz.");

AddDetail( ({ "duft" }),
"Ein betoerender Duft von frischem Laub und wilden Blumen erfuellt die Luft.");

AddDetail( ({ "ecke" }),
"In jeder Ecke dieser Wildnis verbergen sich Geheimnisse und unentdeckte Schoenheit.");

AddDetail( ({ "einklang" }),
"Der Einklang zwischen Mensch und Natur spiegelt sich in der Atmosphaere dieses Ortes wider.");

AddDetail( ({ "herzstueck" }),
"Der glitzernde See bildet das Herzstueck dieses zauberhaften Ortes.");

AddDetail( ({ "licht" }),
"Das sanfte Licht der Sonnenstrahlen durchdringt das Blaetterdach und taucht den Ort in eine warme Atmosphaere.");

AddDetail( ({ "magie" }),
"Die wilde Magie des Tethyrwaldes schwebt in der Luft und verleiht dem Ort eine mystische Aura.");

AddDetail( ({ "ort" }),
"Dieser Ort ist eine Verbindung von natuerlicher Schoenheit und geheimnisvoller Ruhe.");

AddDetail( ({ "pracht" }),
"Die Pracht der unberuehrten Natur offenbart sich in jedem Detail dieses Ortes.");

AddDetail( ({ "rauschen" }),
"Das beruhigende Rauschen des Wassers und des Windes bildet eine natuerliche Symphonie.");

AddDetail( ({ "schoenheit" }),
"Die Schoenheit dieses Ortes ist ein Zusammenspiel von Landschaft, Flora und Fauna.");

AddDetail( ({ "schritt" }),
"Der weiche Boden gibt bei jedem Schritt nach, waehrend du den Pfad entlang wanderst.");

AddDetail( ({ "sonnenstrahlen" }),
"Vereinzelte Sonnenstrahlen dringen durch das Blaetterdach und setzen den Wald in ein zauberhaftes Lichtspiel.");

AddDetail( ({ "tethyrwald" }),
"Der Tethyrwald ist mehr als nur Baeume; er ist eine lebendige Entitaet, die diesen Ort umgibt.");

//--Details----------------------------------------------------------------

AddDetail( ({ "blaetterdach" }),
"Das Blaetterdach der Baeume bildet einen natuerlichen Schirm, der sanftes Licht durchlaesst.");

AddDetail( ({ "blumen" }),
"Farbenfrohe Blumen sprenkeln die Umgebung und setzen natuerliche Akzente in der Wildnis.");

AddDetail( ({ "detail" }),
"Jedes Detail dieser Landschaft erzaehlt eine Geschichte von unberuehrter Natur und Urspruenglichkeit.");

AddDetail( ({ "eleganz" }),
"Die Eleganz der Natur zeigt sich in der harmonischen Gestaltung der Landschaft.");

AddDetail( ({ "entitaet" }),
"Der Tethyrwald ist mehr als nur ein Wald; er ist eine lebendige Entitaet, die diesen Ort umgibt.");

AddDetail( ({ "fauna" }),
"Die lebendige Fauna des Tethyrwaldes offenbart sich in den vielfaeltigen Tiergeraeuschen.");

AddDetail( ({ "flora" }),
"Die vielfaeltige Flora des Tethyrwaldes spiegelt sich in einer bunten Palette von Pflanzen wider.");

AddDetail( ({ "geheimnisse" }),
"Die Geheimnisse der Natur offenbaren sich in den verborgenen Winkeln dieses Waldes.");

AddDetail( ({ "landschaft" }),
"Die beeindruckende Landschaft des Tethyrwaldes erstreckt sich in malerischer Schoenheit.");

AddDetail( ({ "laub" }),
"Das Laub der Baeume bildet einen dichten Teppich auf dem Boden und verleiht dem Wald eine natuerliche Decke.");

AddDetail( ({ "lichtspiel" }),
"Das Lichtspiel der Sonnenstrahlen durch die Blaetter verleiht dem Wald eine zauberhafte Atmosphaere.");

AddDetail( ({ "luft" }),
"Die frische Luft des Tethyrwaldes traegt den Duft von Blumen und Erde.");

AddDetail( ({ "mensch" }),
"Der Mensch findet hier eine friedliche Verbindung mit der Natur und ihrer urspruenglichen Schoenheit.");

AddDetail( ({ "ruhe" }),
"Die Ruhe dieses Ortes ist wie eine stille Symphonie, die die Seele beruhigt.");

AddDetail( ({ "symphonie" }),
"Die Symphonie der Natur erklingt in den sanften Geraeuschen des Wassers, der Blaetter und der Voegel.");

AddDetail( ({ "verbindung" }),
"Die Verbindung zwischen Mensch und Natur ist in jedem Detail dieses Waldes spuerbar.");

AddDetail( ({ "wald" }),
"Der Wald umgibt diesen Ort mit einer Aura von Geheimnis und urspruenglicher Kraft.");

AddDetail( ({ "zusammenspiel" }),
"Das harmonische Zusammenspiel von Flora, Fauna und Landschaft bildet die Essenz des Tethyrwaldes.");


AddDetail( ({ "akzente" }),
"Die farbenfrohen Blumen setzen natuerliche Akzente in der wilden Umgebung.");

AddDetail( ({ "decke" }),
"Das Laub der Baeume bildet eine natuerliche Decke ueber dem Boden des Waldes.");

AddDetail( ({ "erde" }),
"Die fruchtbare Erde des Tethyrwaldes naehrt eine vielfaeltige Flora.");

AddDetail( ({ "essenz" }),
"Die Essenz des Tethyrwaldes offenbart sich in der unberuehrten Schoenheit und Wildheit.");

AddDetail( ({ "geheimnis" }),
"Die Geheimnisse der Natur verborgen in den Winkeln dieses zauberhaften Waldes.");

AddDetail( ({ "geraeuschen" }),
"Die sanften Geraeusche des Waldes, von plaetschernden Baechen bis zu singenden Voegeln, erfuellen die Luft.");

AddDetail( ({ "geschichte" }),
"Jedes Detail dieser Landschaft erzaehlt eine Geschichte von unberuehrter Natur und Urspruenglichkeit.");

AddDetail( ({ "gestaltung" }),
"Die harmonische Gestaltung der Landschaft spiegelt die Schoenheit des Tethyrwaldes wider.");

AddDetail( ({ "kraft" }),
"Die kraftvolle Aura des Tethyrwaldes durchdringt die Umgebung.");

AddDetail( ({ "palette" }),
"Die bunte Palette von Pflanzen fuellt den Wald mit einer Vielfalt an Farben.");

AddDetail( ({ "pflanzen" }),
"Eine Vielzahl von Pflanzen in allen Formen und Groessen schmueckt die Umgebung.");

AddDetail( ({ "schirm" }),
"Das Blaetterdach der Baeume bildet einen natuerlichen Schirm vor der Sonne.");

AddDetail( ({ "seele" }),
"Die Seele findet hier Ruhe und Frieden inmitten der Natur.");

AddDetail( ({ "teppich" }),
"Das Laub bildet einen dichten Teppich auf dem Waldboden.");

AddDetail( ({ "tiergeraeuschen" }),
"Die Geraeusche der Tiere, von zwitschernden Voegeln bis zu raschelnden Tieren, fuegen sich zu einer natuerlichen Symphonie zusammen.");

AddDetail( ({ "umgebung" }),
"Die Umgebung des Tethyrwaldes ist gepraegt von natuerlicher Schoenheit und Urspruenglichkeit.");

AddDetail( ({ "urspruenglichkeit" }),
"Die Urspruenglichkeit des Tethyrwaldes ist in jedem Detail dieses Ortes spuerbar.");

AddDetail( ({ "voegel" }),
"Die Voegel singen ihre Lieder und fuegen sich harmonisch in die Symphonie der Natur ein.");

AddDetail( ({ "winkeln" }),
"Die verborgenen Winkel des Waldes bergen Geheimnisse und unentdeckte Schoenheit.");

AddDetail( ({ "baechen", "baeche" }),
    "Kleine Baeche durchziehen die Landschaft und tragen zur lebendigen Atmosphaere bei.");

  AddDetail( ({ "farben" }),
    "Die vielfaeltigen Farben der Blumen und Pflanzen beleben die Umgebung.");

  AddDetail( ({ "formen" }),
    "Die unterschiedlichen Formen von Baeumen und Pflanzen praegen die Struktur des Waldes.");

  AddDetail( ({ "frieden", "gefuehl" }),
    "Ein Gefuehl des Friedens umgibt diesen Ort, eingebettet in die natuerliche Ruhe des Tethyrwaldes.");

  AddDetail( ({ "geraeusche" }),
    "Die Geraeusche der Natur, von fliessenden Baechen bis zu leisen Winden, fuellen die Luft.");

  AddDetail( ({ "groessen" }),
    "Baeume in verschiedenen Groessen ragen empor und verleihen dem Wald eine eindrucksvolle Struktur.");

  AddDetail( ({"struktur"}),
    "Wirklich eindrucksvoll.");

  AddDetail( ({ "lieder", "kulisse" }),
    "Die Voegel singen ihre Lieder und tragen zur akustischen Kulisse des Waldes bei.");

  AddDetail( ({ "sonne" }),
    "Die Sonne durchbricht das Blaetterdach und setzt den Wald in ein warmes Licht.");

  AddDetail( ({ "tiere", "nagetiere", "nagetieren" }),
    "Eine Vielzahl von Tieren, von kleinen Nagetieren bis zu majestaetischen Voegeln, belebt den Tethyrwald.");

  AddDetail( ({ "vielfalt" }),
    "Die Vielfalt der Natur zeigt sich in den unterschiedlichen Tieren, die den Wald bevoelkern.");

  AddDetail( ({ "vielzahl" }),
    "Eine Vielzahl von Pflanzen und Tieren praegt die Umgebung.");

  AddDetail( ({ "waldboden", "untergrund", "textur" }),
    "Der Waldboden ist mit Laub bedeckt, bildet einen weichen Untergrund und verleiht dem Wald eine natuerliche Textur.");

  AddDetail( ({ "wildheit" }),
    "Die Wildheit des Tethyrwaldes manifestiert sich in der ungezaehmten Schoenheit der Natur.");

  AddDetail( ({ "winkel" }),
    "Die verborgenen Winkel des Waldes bergen Geheimnisse und unentdeckte Schoenheit.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "nordosten", ROOM "b5_d" );
  AddExit( "nordwesten", ROOM "grotte_2");
}