#include "../def.h"

inherit "std/room";

int key;

void create()
{
  ::create();

  key = 1;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Im Schlafhaus der Wilderer");
  SetProp(P_INT_LONG,
    "Du betrisst die westliche Huette. Naja, Huette ist vielleicht zu viel "
    "gesagt. Von herinnen sieht es eher wie eine zugige Barracke aus. Es "
    "gibt eigentlich keine Einrichtung hier. Nur ein paar Strohmatten sind "
    "im Raum als Schlaflager verteilt. Der Boden besteht dafuer aus "
    "dreckigen Holzielen und im Dach ist nur ein kleines Loch.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "strohmatten", "schlaflager", "lager", "matten", "schlafunterlage" }),
    "Ein paar dreckige Strohmatten dienen hier als Schlaflager. Es sind "
    "einfach ein paar durchgelegene Strohballen, die mit Seilen zusammengebunden "
    "wurden. Viel Habe duerften die Wilderer hier nicht besitzen, denn viel "
    "kann man in diesen Matten nicht verstecken.");

  AddDetail( ({"habe"}),
    "Im Grunde kann man hier nicht wirklich Privatbesitz haben. Man kann vielleicht "
    "ein paar Muenzen in das Stroh seiner Matte stecken und hoffen, dass niemand "
    "zu gruendlich sucht.");

    AddDetail(({ "barracke" }),
    "Das Schlafhaus der Wilderer sieht von innen eher wie eine zugige Barracke aus.");

AddDetail(({ "boden", "holzielen" }),
    "Der Boden besteht aus dreckigen Holzielen, die kaum Komfort bieten.");

AddDetail(({ "dach", "loch" }),
    "Im Dach gibt es nur ein kleines Loch, durch das vielleicht etwas Tageslicht einfaellt.");

AddDetail(({ "decke" }),
    "Es gibt keine wirkliche Decke. Das Dach ist von innen sichtbar und gibt den Blick auf den Himmel frei.");

AddDetail(({ "einrichtung" }),
    "Es gibt keine Einrichtung hier. Nur einige Strohmatten, die als Schlaflager dienen.");

AddDetail(({ "grunde" }),
    "Die Wilderer scheinen hier keine grossen Ansprueche zu haben, denn es gibt nur das Noetigste.");

AddDetail(({ "huette" }),
    "Die westliche Huette ist eher karg und bietet kaum Annehmlichkeiten.");

AddDetail(({ "loch" }),
    "Das kleine Loch im Dach laesst nur begrenzt Licht herein.");

AddDetail(({ "matte", "matten", "schlaflager", "strohmatte", "strohmatten" }),
    "Ein paar dreckige Strohmatten dienen als Schlaflager. Sie bestehen aus durchgelegenen Strohballen, die mit Seilen zusammengebunden sind.");

AddDetail(({ "muenzen", "privatbesitz" }),
    "Privatbesitz in den Matten zu haben, ist schwer vorstellbar. Vielleicht koennten einige Muenzen im Stroh versteckt sein.");

AddDetail(({ "raum" }),
    "Der Raum ist spaerlich eingerichtet und bietet nur das Notwendigste.");

AddDetail(({ "seilen" }),
    "Die Strohmatten sind mit Seilen zusammengebunden, um eine gewisse Stabilitaet zu gewaehrleisten.");

AddDetail(({ "stroh", "strohballen" }),
    "Die Strohmatten bestehen aus durchgelegenen Strohballen, die nicht besonders komfortabel aussehen.");

AddDetail(({ "waende", "wand" }),
    "Die Waende der Huette sind einfach und bieten wenig Schutz vor den Elementen.");

AddDetail(({ "wilderer" }),
    "Die Wilderer, die hier schlafen, haben es offenbar nicht besonders gemuetlich.");

    AddDetail(({ "annehmlichkeiten" }),
    "Es gibt hier kaum Annehmlichkeiten. Die Wilderer haben es einfach gehalten.");

AddDetail(({ "blick" }),
    "Der Blick nach draussen bietet wenig Abwechslung. Die Umgebung ist einfach und schlicht.");

AddDetail(({ "elementen" }),
    "Die Huette bietet nur begrenzten Schutz vor den Elementen. Sie ist nicht besonders wetterfest.");

AddDetail(({ "himmel" }),
    "Der Blick zum Himmel erfolgt durch das kleine Loch im Dach.");

AddDetail(({ "komfort" }),
    "Es gibt hier kaum Komfort. Die Schlafbedingungen sind einfach und spartanisch.");

AddDetail(({ "licht", "tageslicht" }),
    "Das Tageslicht dringt durch das kleine Loch im Dach und spendet begrenzte Helligkeit.");

AddDetail(({ "notwendigste" }),
    "Die Ausstattung der Huette beschraenkt sich auf das Notwendigste.");

AddDetail(({ "schlafhaus" }),
    "Dies ist das Schlafhaus der Wilderer, das trotz seiner Einfachheit als Unterkunft dient.");

AddDetail(({ "schutz" }),
    "Die Huette bietet nur begrenzten Schutz vor den Elementen. Sie ist nicht besonders wetterfest.");

AddDetail(({ "stabilitaet" }),
    "Die Strohmatten sind mit Seilen zusammengebunden, um eine gewisse Stabilitaet zu gewaehrleisten.");

AddDetail(({ "tageslicht" }),
    "Das Tageslicht dringt durch das kleine Loch im Dach und spendet begrenzte Helligkeit.");

    AddDetail(({ "abwechslung" }),
    "Die Umgebung bietet wenig Abwechslung. Die Huette ist schlicht und einfach gehalten.");

AddDetail(({ "ausstattung" }),
    "Die Ausstattung der Huette ist aeusserst spartanisch und beschraenkt sich auf das Notwendigste.");

AddDetail(({ "einfachheit" }),
    "Die Einfachheit der Huette ist offensichtlich. Sie dient lediglich als einfache Unterkunft.");

AddDetail(({ "helligkeit" }),
    "Die Helligkeit in der Huette ist begrenzt. Das Tageslicht dringt durch das kleine Loch im Dach.");

AddDetail(({ "schlafbedingungen" }),
    "Die Schlafbedingungen sind einfach und spartanisch. Die Strohmatten dienen als einfache Schlafunterlage.");

AddDetail(({ "umgebung" }),
    "Die Umgebung der Huette ist schlicht und wenig abwechslungsreich.");

AddDetail(({ "unterkunft" }),
    "Die Huette dient als einfache Unterkunft fuer die Wilderer.");


//--Ausgaenge--------------------------------------------------------------
  AddExit( "osten", ROOM "wilderer2" );

  AddCmd("suche|such&in&lager|matte|matten|stroh|schlaflager|strohmatte|strohmatten", "cmd_suchen", "Was willst du durchsuchen?");
  AddCmd("durchsuche|durchsuch&lager|matte|matten|stroh|schlaflager|strohmatte|strohmatten", "cmd_suchen", "Was willst du durchsuchen?");

  AddItem(NPC "poacher_easy", REFRESH_DESTRUCT);
}

public int cmd_suchen() {
  object ob;

  say(BS(TPN+" durchwuehlt die Schlaflager der Wilderer."));

  if(!key) {
    write(BS("Du durchwuehlst die Schlaflager, kannst aber nichts finden."));
    return -1;
  }

  write(BS("Du durchsuchst die Schlaflager und findest tatsaechlich einen kleinen Schluessel im Stroh.\n"));
  ob = clone_object(OBJ "kiste_schluessel");
  if(ob->move(TP, M_GET) != 1) {
    write(BS("Du kannst ihn gerade nicht tragen, also laesst du ihn da, wo er ist."));
    ob->remove(1);
    return -1;
  }

  key = 0;
  return 1;
}

public void reset() {
  ::reset();

  key=1;
}