#include "../def.h"
#include "/p/daemon/pcgd/pcgd.h"

inherit "/std/room";

public void create() {
    string err, *items;
    int tries;

    ::create();

    SetProp(P_INT_SHORT, "Im suedlichen Tethyrwald");
    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15+random(10), ENV_TERRAIN: TT_FOREST]) );

    PCGD->LoadBiome(BIOMES "weg");

    // workaround...
    for(tries=0; tries < 3; tries++) {
        if(err=catch(PCGD->GenerateRoom(BIOMES "weg", TO, 3+random(3), PCG_EACH_BUCKET_ONE|PCG_CONTENT_ONLY_ONCE|PCG_CONTENT_NO_SUCCESSION, 0.7))) {
            tell_room(TO, BS("Fehler beim generieren: "+err+". Generiere neu.\n"));
        } else {
            break;
        }
    }
    call_other(WALDMASTER, "???");

    items = call_other(WALDMASTER, "GetItemsForSpawnPoint", file_name(TO));
    if(pointerp(items)) {
        AddItem(items, REFRESH_DESTRUCT);
    }
}