#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

SetProp(P_INT_SHORT, "Die Grotte der Tierkoenige");
SetProp(P_INT_LONG, "In der Grotte unter dem bescheidenen Wasserfall enthuellt "
                    "sich eine mystische Kammer, gepraegt von einer imposanten "
                    "Holzstatue eines Elchs, deren Geweih fast die Decke beruehrt. "
                    "Zu Fuessen der Statue befindet sich eine Opferschale, gefuellt "
                    "mit den Ueberresten von Waldtieren als ehrfuerchtige Gaben. "
                    "Die Waende der Grotte sind mit unzaehligen Handabdruecken und "
                    "kunstvollen Darstellungen von Tieren und Jagdszenen uebersaet. "
                    "Ein kleines Rinnsal, das direkt dem Maul des Elchs entspringt "
                    "rinnt durch die Eingangsoeffnung hinaus. Hier handelt es sich "
                    "eindeutig um einen heiligen Ort.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

  //--Details----------------------------------------------------------------

