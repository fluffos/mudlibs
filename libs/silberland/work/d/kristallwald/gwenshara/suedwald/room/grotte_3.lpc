  AddDetail( ({ "moos" }),
    "Der Boden der Grotte ist mit einer dicken Schicht aus Moos und Erde bedeckt, die die urtuemliche Natur des Tethyrwaldes widerspiegelt.");

  AddDetail( ({ "natur" }),
    "Die Grotte spiegelt die wilde und unberuehrte Natur des Tethyrwaldes wider, insbesondere durch die kunstvollen Darstellungen und die Elchstatue.");

  AddDetail( ({ "pfad" }),
    "Der sumpfige Pfad erstreckt sich vom Uferrand des Sees bis zur Eingangsoeffnung der Grotte, und scheint von den Bewohnern des Tethyrwaldes genutzt zu werden.");

  AddDetail( ({ "qualitaet" }),
    "Die Elchstatue strahlt eine mythische Qualitaet aus, die die majestaetische und urtuemliche Natur der Tierkoenige repraesentiert.");

  AddDetail( ({ "schirm" }),
    "Die Decke der Grotte ist von schwarzem Fels durchzogen, der wie ein natuerlicher Schirm vor der Aussenwelt wirkt.");

  AddDetail( ({ "see" }),
    "Durch die Eingangsoeffnung kannst du einen Blick auf den glitzernden See des Tethyrwaldes werfen.");

  AddDetail( ({ "szenen" }),
    "Die Darstellungen an den Waenden zeigen kunstvolle Szenen von Tieren und Jagdsituationen, die die Beziehung zwischen den Bewohnern des Tethyrwaldes und der Natur verdeutlichen.");

  AddDetail( ({ "teppich" }),
    "Der Boden der Grotte ist mit einem dichten Teppich aus Moos und Erde bedeckt, der sich weich unter deinen Fuessen anfuehlt.");

  AddDetail( ({ "tethyrwaldes", "tethyrwald" }),
    "Die Grotte repraesentiert einen kleinen Ausschnitt der wilden und unberuehrten Natur des Tethyrwaldes.");

  AddDetail( ({ "tierkoenige" }),
    "Die Tierkoenige werden in den kunstvollen Darstellungen an den Waenden der Grotte verehrt und repraesentieren die Kraft und Schoenheit der Natur.");

  AddDetail( ({ "ueberreste" }),
    "In der Opferschale zu Fuessen der Elchstatue liegen die Ueberreste von Waldtieren, die als ehrfuerchtige Gaben dargebracht wurden.");

  AddDetail( ({ "verbindung" }),
    "Die Darstellungen an den Waenden zeigen kunstvolle Szenen von Tieren und Jagdsituationen, die die enge Verbindung der Bewohner des Tethyrwaldes zur Natur verdeutlichen.");

  AddDetail( ({ "waldes" }),
    "Die Grotte repraesentiert einen kleinen Ausschnitt der wilden und unberuehrten Natur des Tethyrwaldes.");

