//--Ausgaenge--------------------------------------------------------------

  AddExit( "osten", ROOM "grotte_2" );

//--Items------------------------------------------------------------------

  AddItem( NPC "gruener_mann", REFRESH_DESTRUCT );

//--Commands---------------------------------------------------------------
  
  AddCmd("opfer|opfere&tier|leiche", "cmd_opfern", "Was willst du opfern?\n");
}

public int cmd_opfern(string str) {
  object corpse;

  if(!objectp(corpse=present("Leiche", TP))) {
    write(BS("Du benoetigst die Leiche eines Tieres, um es hier zu opfern."));
    return -1;
  }

  write(BS("Du opferst die Ueberreste des Tieres in der Opferschale unter "
           "der Statue des Elchs."));
  say(BS(TPN+" legt die Ueberreste eines Tieres in die Opferschale unter der Elchstatue."));

  call_out("sacrifice_sequence", 0, 0, TP, "/gilden/waldlaeufer/master/skillmaster"->HasSkill(getuid(TP), "Die Namen der Avatara"), corpse->QueryProp(P_LEVEL));
  corpse->remove(1);
  return 1;
}

public void sacrifice_sequence(int step, object pl, int knowsNames, int sacrificeLevel) {
  string msg;

  //DB(sprintf("sacrifice :: step=%d pl=%O names=%d level=%d\n", step, pl, knowsNames, sacrificeLevel));

  if(!objectp(pl)) return;
  if(!present(pl, TO)) return; // spieler ist gegangen

  switch(step) {
    case 0: msg = "Ein blaeuliches Gluehen erfuellt die Augen der Elchstatue."; break;
    case 1: msg = "Langsam und knarzend senkt sich der Kopf der Statue und sie beginnt die Opfergabe zu fressen!"; break;
    case 2: msg = "Aus dem Augenwinkel erkennst du, wie sich die Zeichnungen an der Wand zu bewegen beginnen."; break;
    case 3: msg = "Zuerst herrscht in dem Bild eine grosse, dunkle Leere.\n"; break;
    case 4: msg = "Ploetzlich erhebt sich in strahlenden Linien das Bildnis einer Schwaenin, die ihre strahlenden Schwingen aus "
                  "Licht ausbreitet. Der Glanz durchdringt die Finsternis, wie die ersten Sonnenstrahlen.";
                  if(knowsNames) msg += " Du erkennst Eoin, die Schwanenkoenign, die das Licht in die Welt brachte.";
                  break;
    case 5: msg = "Das Licht bringt auch den Schatten. Aus der Tiefe der Unterwelt erhebt sich ein dunkler Rabe dessen "
                  "schwarzes Gefieder alles in Duesternis huellt. Sein erster kraechzender Ruf bring den Verfall, der "
                  "alles im Gleichgewicht haelt.";
            if(knowsNames) msg += " Es ist Arawn, der Fluchrabe, der fuer Tod und Verfall, aber auch den Ausgleich steht.";
            break;
    case 6: msg = "Im Gefolge der Dunkelheit erkennst du leuctende Augen, die dir Angst machen. Ein finsterer Schattenwolf "
                  "tritt aus der entstandenden Dunkelheit. Sein Geheul hallt durch die wilden Waelder, wo er ueber die Grenze "
                  "zwischen Licht und Schatten wacht.";
            if(knowsNames) msg += " Dies ist Morca, der Schattenwolf, der fuer unsere tiefsten Aengste, aber auch Respekt, steht.";
            break;
    case 7: msg = "Eis und Schnee beginnen zu fallen. Dann siehst du das Abbild eines riesigen Elchs, mit Schnee und Eis im Fell "
                  "und auf seinen grossen Schaufeln voranschreiten. Wo er hin tritt, folgt der Winter.";
            if(knowsNames) msg += " Es ist Ciaran, der Elchkoenig, der den Winter, Eis und Schnee bringt. Er fuehrt den Jahreszyklus an.";
            break;
    case 8: msg = "Gras spriesst auf den Boden, als der Fruehling auf den Winter folgt. Im hohen Gras windet sich eine giftige Natter "
                  "die dich schon anspringen will - gerade als sie verblasst.";
            if(knowsNames) msg += " In ihr erkennst du Fiachra, die Giftnatter, die fuer die Wildheit und Gefahr der Natur steht.";
            break;
    case 9: msg = "Eine heisse Sonne steigt auf. Doch nein, es ist ein rot gemalter Luchs, der sie, wie einen Ball aus Wolle, spielerisch "
                  "vor sich her schiebt. Unter seinem Blick faellt die lodernde Hitze auf die Welt. Wo seine Fuesse hintreten springen "
                  "Flammen hervor, die das Gras verdorren und den Sommer symbolisieren";
            if(knowsNames) msg += " Er traegt den Namen Aeden, der Sonnenluchs, der fuer die Hitze des Sommers und das Feuer steht.";
            break;
    case 10: msg = "Dann beginnt sanft der Regen zu fallen und die Feuer zu loeschen. Grosse Winde ziehen auf und wehen ueber die Berge, "
                   "aus denen ein wilder Falke herabsaust. Unter seinem Fluegelschlag wehen Stuerme ueber das Land und entwurzeln Baeume "
                   "oder bringen Sturmfluten.";
             if(knowsNames) msg += " Dies ist Bran, der Sturmfalke, der Wind und Wetter ueber das Land lenkt und den Herbst einlaeutet.";
             break;
    case 11: msg = "Durch den Sturm und aus den Wolken zucken Blitze. Ein riesiger Vogel bricht aus ihnen hervor. Ein Donnervogel! "
                   "Aus seinen Schwingen schlagen Blitze ein und spalten Baeume. Er bringt die Rohe kraft des Gewitters.";
             if(knowsNames) msg += " Es handelt sich um Thorondor, den Donnervogel, dessen Ruf Blitz und Donner folgen.";
             break;
    case 12: msg = "Als die Sturzbaeche des Regens und Donners versiegen bleiben Suempfe und Seen zurueck. Aus ihnen steigt eine "
                   "riesige Kroete hervor und mit ihr kommen Schwaerme von Muecken und Getier.";
             if(knowsNames) msg += " Das ist Brenin, die Kroetenkoenigin, deren aetzende Haut Suempfe entstehen und Mueckenschwaerme emporsteigen laesst.";
             break;
    case 13: msg = "Langsam weichen die Suempfe und Tuempfel zurueck und werden durch spriessende Blumen und pulsierendes "
                   "Leben abgeloest. Sanften schrittes steigt ein weisser Hirsch ueber das Land und da, wo er schreitet bleibt nichts als "
                   "Leben und die Kraft des Guten zurueck. Aus seinem Geweih spriessen Blumen und Hoffnung.";
             if(knowsNames) msg += "Du erkennst Lir, den weissen Hirsch, Hueter der Harmonie und des Lebens.";
             break;
    case 14: msg = "Dann, ploetzlich, erhebt sich ueber allem ein maechtiger, funkelnder Drache. Er speit ueber das Land und die Farben "
                   "der Magie regnen ueber alls nieder. Was unbelebt war, wird belebt, Wissen, Weisheit und stete Kraft durchfluten alles.";
             if(knowsNames) msg += " Es ist Belenus, der Drache der Magie, der Wund Mysterien ueber die Welt haucht.";
             break;
    case 15: msg = "Langsam kehren deine Sinne wieder zu dir zurueck und die Vision versiegt."; break;
    default:
      tell_object(pl, BS("Nach diesem Schauspiel fuehlst du die unbaendige Kraft der Natur ganz Nahe bei dir. Du hast die Schoepfungsgeschichte "
      "der Avatara, auch Tierkoenige genannt, gesehen..."));
      pl->AddHp(sacrificeLevel * 5);
      pl->AddSp(sacrificeLevel * 5);
      return;
  }

  tell_object(pl, BS(msg));
  call_out("sacrifice_sequence", 4, ++step, pl, knowsNames, sacrificeLevel);
  return;
}
