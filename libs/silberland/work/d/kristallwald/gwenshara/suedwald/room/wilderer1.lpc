#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Am Rand eines Unterschlupfs");
  SetProp(P_INT_LONG,
    "Du stehst hier, mitten im Wald, vor einer notduerftig zusammengezimmerten "
    "Palisade. Es gibt nicht einmal ein echtes Tor in ihr. Also eigentlich hat "
    "hier irgendendjemand einfach Baumstaemme in den Boden gerammt. Links und "
    "rechts des Wegs ist die Vegetation so dicht, dass du nicht hindurch kommst. "
    "Hinter der Palisde erkennst du ein paar kleine, notduerftige Huetten.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------

  //--Details----------------------------------------------------------------

  AddDetail( ({ "baumstaemme", "baumstaemmen", "staemme" }),
    "Die Baumstaemme sind notduerftig in den Boden gerammt und bilden eine einfache Palisade.");

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus weichem Waldboden, bedeckt mit Laub und kleinen Zweigen.");

  AddDetail( ({ "himmel" }),
    "Der Himmel ist durch das dichte Blaetterdach der Baeume nur schwer zu erkennen, aber ein leichtes Tageslicht dringt hindurch.");

  AddDetail( ({ "huetten" }),
    "Hinter der Palisade siehst du einige kleine, notduerftige Huetten, die vermutlich als Unterschlupf dienen.");

  AddDetail( ({ "palisade", "palisde" }),
    "Die Palisade besteht aus Baumstaemmen, die grob zusammengenagelt wurden, um einen einfachen Schutz zu bieten.");

  AddDetail( ({ "tor" }),
    "Es gibt kein richtiges Tor in der Palisade, nur eine Luecke, die den Eingang bildet.");

  AddDetail( ({ "vegetation" }),
    "Die Vegetation links und rechts des Wegs ist so dicht, dass du nicht hindurch kommen kannst.");

  AddDetail( ({ "wald" }),
    "Der Wald ist dicht und undurchdringlich, mit einer Vielzahl von Baeumen und Pflanzen.");

  AddDetail( ({ "wegs", "weg" }),
    "Der Weg ist kaum erkennbar, da die Vegetation ihn fast vollstaendig bedeckt.");

  AddDetail( ({ "baeume" }),
    "Die Baeume umgeben dich von allen Seiten, ihre Staemme ragen hoch in den Himmel und bilden ein dichtes Blaetterdach.");

  AddDetail( ({ "blaetterdach", "dach" }),
    "Das Blaetterdach der Baeume bildet eine undurchdringliche Decke aus gruenen Blaettern, die das Tageslicht filtern.");

  AddDetail( ({ "eingang" }),
    "Der Eingang zur Palisade ist lediglich eine Luecke in den Baumstaemmen, die den Weg hinein markiert.");

  AddDetail( ({ "laub" }),
    "Der Boden ist mit einem Teppich aus Laub bedeckt, das von den umgebenden Baeumen gefallen ist.");

  AddDetail( ({ "luecke" }),
    "Die Luecke in der Palisade bildet den Eingang und ermoeglicht den Zugang zum Unterschlupf.");

  AddDetail( ({ "pflanzen" }),
    "Zwischen den Baumstaemmen und auf dem Boden wachsen verschiedene Pflanzen und setzen dem Ort eine natuerliche Note auf.");

  AddDetail( ({ "schutz" }),
    "Die Palisade bietet einen einfachen Schutz vor der Wildnis des Waldes.");

  AddDetail( ({ "tageslicht" }),
    "Das Tageslicht dringt nur schwach durch das dichte Blaetterdach der Baeume, wodurch der Ort in ein gedaempftes Licht getaucht wird.");

  AddDetail( ({ "unterschlupf" }),
    "Die kleinen Huetten hinter der Palisade dienen als einfacher Unterschlupf fuer die Bewohner.");

  AddDetail( ({ "vielzahl" }),
    "Es gibt eine Vielzahl von Baeumen, Pflanzen und Zweigen, die den Wald beleben.");

  AddDetail( ({ "waldboden" }),
    "Der Waldboden ist mit Moos und kleinen Pflanzen bedeckt, was dem Boden eine weiche Textur verleiht.");

  AddDetail( ({ "zweigen", "zweige" }),
    "Die Zweige der Baeume erstrecken sich in alle Richtungen und bilden ein dichtes Geflecht ueber dem Weg.");

  AddDetail( ({ "bewohner", "anwesenheit" }),
    "Die Bewohner des Lagers sind nicht direkt sichtbar, aber ihre Anwesenheit ist in den Huetten und in der Umgebung zu spueren.");

  AddDetail( ({ "blaettern", "blaetter" }),
    "Die Blaetter der Baeume rascheln im Wind und erzeugen ein beruhigendes Geraeusch in der Waldluft.");

  AddDetail( ({ "decke", "barriere" }),
    "Die Decke des Blaetterdachs bildet eine natuerliche Barriere gegen das direkte Sonnenlicht und gibt dem Ort eine gedaempfte Atmosphaere.");

  AddDetail( ({ "geflecht", "netzwerk" }),
    "Das Geflecht der Baeume, Zweige und Blaetter bildet ein undurchdringliches Netzwerk ueber dem Pfad.");

  AddDetail( ({ "licht" }),
    "Das Licht, das durch das Blaetterdach faellt, wirft sanfte Lichtstrahlen auf den Boden und erzeugt ein malerisches Muster.");

  AddDetail( ({ "moos" }),
    "Moos bedeckt den Waldboden und verleiht dem Ort eine weiche und feuchte Textur.");

  AddDetail( ({ "note" }),
    "Der Ort hat eine natuerliche Note, die durch die Vegetation, das Moos und die natuerliche Umgebung verstaerkt wird.");

  AddDetail( ({ "ort" }),
    "Dieser Ort ist abgelegen und von dichten Baeumen umgeben, was ihn zu einem ruhigen und natuerlichen Rueckzugsort macht.");

  AddDetail( ({ "seiten" }),
    "Die Seiten der Palisade bestehen aus grob zusammengenagelten Baumstaemmen und vermitteln einen improvisierten Eindruck.");

  AddDetail( ({ "teppich" }),
    "Der Teppich aus Laub, Moos und Pflanzen auf dem Waldboden bildet eine natuerliche Unterlage fuer den Pfad.");

  AddDetail( ({ "textur" }),
    "Die Textur des Waldbodens ist weich und feucht durch das Moos, das den Boden bedeckt.");

  AddDetail( ({ "wildnis" }),
    "Die Wildnis des Waldes erstreckt sich um den Ort herum, und die dichten Baeume sorgen fuer ein naturbelassenes Umfeld.");

  AddDetail( ({ "zugang" }),
    "Der Zugang zum Lager erfolgt durch eine einfache Luecke in der Palisade, die den Weg zum Unterschlupf freigibt.");

  AddDetail( ({ "atmosphaere" }),
    "Die Atmosphaere in diesem Teil des Waldes ist ruhig und gleichzeitig belebt durch die natuerlichen Geraeusche der Wildnis.");

  AddDetail( ({ "eindruck", "lebensweise" }),
    "Der Eindruck des Lagers ist rustikal und improvisiert, passend zur einfachen Lebensweise der Bewohner.");

  AddDetail( ({ "geraeusch", "geraeusche", "rascheln", "zwitschern", "voegel" }),
    "Verschiedene Geraeusche der Natur, wie das Rascheln der Blaetter und das Zwitschern der Voegel, erfuellen die Luft.");

  AddDetail( ({ "lager", "lagers" }),
    "Das Lager besteht aus einfachen Huetten und einer improvisierten Palisade, die den Bewohnern Schutz bietet.");

  AddDetail( ({ "lichtstrahlen", "strahlen" }),
    "Die Lichtstrahlen, die durch das Blaetterdach dringen, malen ein zauberhaftes Muster auf den Waldboden.");

  AddDetail( ({ "muster" }),
    "Das Muster aus Licht und Schatten, das durch das Blaetterdach auf den Pfad faellt, verleiht dem Ort eine malerische Qualitaet.");

  AddDetail( ({ "pfad" }),
    "Der Pfad durch das Lager ist von der umgebenden Vegetation gesaeumt und fuehrt zu den Huetten und dem Zentrum des Lagers.");

  AddDetail( ({ "rueckzugsort" }),
    "Der Ort dient als ruhiger Rueckzugsort inmitten der Wildlnis.");

  AddDetail( ({ "sonnenlicht", "beleuchtung", "licht" }),
    "Das Sonnenlicht dringt durch das Blaetterdach und sorgt fuer eine warme und natuerliche Beleuchtung des Lagers.");

  AddDetail( ({ "umfeld" }),
    "Das Umfeld des Lagers besteht aus dichtem Wald, der eine natuerliche Barriere und gleichzeitig einen Schutz bietet.");

  AddDetail( ({ "umgebung" }),
    "Die Umgebung ist von einer wilden und urspruenglichen Natur gepraegt, die den Eindruck eines naturbelassenen Lebens vermittelt.");

  AddDetail( ({ "unterlage" }),
    "Die Unterlage des Pfades besteht aus einem Teppich aus Laub, Moos und Pflanzen, der dem Boden eine weiche Textur verleiht.");

  AddDetail( ({ "waldluft", "duft", "erde" }),
    "Die Waldluft ist frisch und erfuellt mit dem Duft von Baeumen und Erde, was die natuerliche Atmosphaere des Ortes unterstreicht.");

  AddDetail( ({ "wind", "rauschen" }),
    "Der Wind bewegt die Blaetter der Baeume und erzeugt ein sanftes Rauschen, das den Ort lebendig wirken laesst.");

  AddDetail( ({ "zentrum" }), "Da wirst du naeher rangehen muessen.");


//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", ROOM "b6_l" );
  AddExit( "sueden", ([
    EX_DEST  : ROOM "wilderer2",
    EXG_ID   : "\nsuedwald_wilderer_wache",
    EXG_PLMSG: "Der Waechter sagt: He da! Hier darfst du nicht vorbei!\n",
    EXG_RMMSG: "Der Waechter sagt: He da! Hier darfst du nicht vorbei!\n" ]) );

  AddItem( NPC "wilderer_wache", REFRESH_DESTRUCT);
  AddItem( ({ OBJ "fangfalle", OBJ "giftfalle", OBJ "netzfalle", OBJ "stolperdraht"}), REFRESH_REMOVE );
  AddItem( ({ OBJ "fangfalle", OBJ "giftfalle", OBJ "netzfalle", OBJ "stolperdraht"}), REFRESH_REMOVE );
}