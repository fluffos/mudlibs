#include "../def.h"

inherit "std/room";

int leckereien;

void create()
{
  ::create();

  leckereien = 2 + random(4);

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem Raeucherhaus");
  SetProp(P_INT_LONG,
    "Du betrittst die oestliche Huette und ein Schwall aus Hitze, Rauch und "
    "Roestaromen kommt dir entgegen. Diese Huette ist kreisrund und in der "
    "Mitte befindet sich eine grosse Feuerstelle, durch die qualmend Rauch "
    "abzieht. Einige Stuecke Fleisch haengen auf einem Rost darueber, wohl "
    "um geraeuchert zu werden. Der Boden besteht lediglich aus gestampfter "
    "Erde. Links der Feuerstelle ist ein grosser Tisch, auf dem wohl die "
    "erlegten Tiere ausgeweidet und zerlegt werden, sowie ein dicker "
    "Hackstock. Rechts der Feuerstelle haengen fertig geraeucherte Schinken, "
    "Wuerste und andere Leckereien.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail(({"leckereien", "wuerste", "schinken"}),
    "Auf mehreren Haken haengen da leckere Schinken, Wuerste und gerauechertes "
    "Fleisch. Es sieht wirklich sehr lecker aus. Du koenntest dir einfach ein paar "
    "davon stibitzen...");

 AddDetail(({"boden", "erde"}),
 "Der Boden der Huette besteht aus gestampfter Erde, die von den Bewegungen der Wilderer und ihrer Aktivitaeten gezeichnet ist.");

AddDetail(({"decke", "waende", "wand"}),
 "Die Decke und die Waende der Huette sind aus einfachen Materialien gebaut, die die Hitze und den Rauch des Feuers zurueckhalten.");

AddDetail(({"feuerstelle", "feuer", "rauch"}),
 "Die grosse Feuerstelle in der Mitte der Huette erzeugt eine intensive Hitze und laesst Rauch abziehen, der den Raum erfuellt.");

AddDetail(({"fleisch", "stuecke", "geraeuchertes fleisch"}),
 "Einige Stuecke Fleisch haengen ueber der Feuerstelle und werden offenbar geraeuchert, um sie zu konservieren.");

AddDetail(({"hackstock"}),
 "Ein dicker Hackstock steht links der Feuerstelle und dient wahrscheinlich dazu, Fleisch zu zerlegen und vorzubereiten.");

AddDetail(({"haken"}),
 "Rechts der Feuerstelle haengen Haken mit fertig geraeucherten Schinken, Wuersten und anderen leckeren Stuecken Fleisch.");

AddDetail(({"hitze"}),
 "Die Hitze in der Huette wird durch die Feuerstelle und die geraeucherten Fleischstuecke erzeugt, die ueber dem Feuer haengen.");

AddDetail(({"huette"}),
 "Die kreisrunde Huette ist einfach gebaut und von Rauch und Hitze erfuellt, die durch die Feuerstelle entstehen.");

AddDetail(({"mitte"}),
 "Die Mitte der Huette wird von der grossen Feuerstelle dominiert, um die sich die Aktivitaeten der Wilderer abspielen.");

AddDetail(({"roestaromen", "rauch"}),
 "Ein intensiver Duft von Rauch und Roestaromen erfuellt die Huette aufgrund der Raeucheraktivitaeten.");

AddDetail(({"rost"}),
 "Ueber der Feuerstelle haengt ein Rost, auf dem Stuecke Fleisch geraeuchert werden, um sie zu konservieren.");

AddDetail(({"schwall"}),
 "Ein Schwall aus Hitze, Rauch und Roestaromen kommt dir beim Betreten der Huette entgegen.");

AddDetail(({"tiere"}),
 "Der Tisch links der Feuerstelle koennte dazu dienen, erlegte Tiere auszuweiden und zu zerlegen, um Fleisch zu gewinnen.");

AddDetail(({"tisch"}),
 "Links der Feuerstelle steht ein grosser Tisch, auf dem wohl die erlegten Tiere ausgeweidet und zerlegt werden.");

AddDetail(({"waende"}),
 "Die Waende der Huette sind einfach gebaut und schuetzen vor Wind und Wetter.");

AddDetail(({"wand"}),
 "Die Wand der Huette ist einfach gebaut und schuetzt vor Wind und Wetter.");

AddDetail(({"aktivitaeten", "bewegungen", "taetigkeiten"}),
"Die Aktivitaeten und Bewegungen der Wilderer sind ueberall in der Huette zu spueren, vom Feuer bis zur Fleischzubereitung.");

AddDetail(({"betreten"}),
"Beim Betreten der Huette spuerst du sofort die Hitze, den Rauch und den intensiven Duft von geraeuchertem Fleisch.");

AddDetail(({"duft"}),
"Der Duft von geraeuchertem Fleisch und der Rauchfuellung schwebt in der Huette.");

AddDetail(({"fleischstuecke"}),
"Verschiedene Fleischstuecke haengen ueber der Feuerstelle und warten darauf, geraeuchert zu werden.");

AddDetail(({"koch"}),
"Der Wilderer-Koch in der Huette ist damit beschaeftigt, die Fleischstuecke ueber der Feuerstelle zu geraeuchern.");

AddDetail(({"materialien"}),
"Die Huette ist aus einfachen Materialien wie Holz und Erde gebaut, was fuer die Wilderer ausreichend ist.");

AddDetail(({"raeucheraktivitaeten", "rauch", "raeuchern"}),
"Die Rauchentwicklung durch das Raeuchern fuellt die Huette mit Rauch.");

AddDetail(({"raum"}),
"Das ist die Huette, in der du hier bist.");

AddDetail(({"wetter", "wind"}),
"Die Huette bietet Schutz vor Wind und Wetter, was fuer die Wilderer bei ihren Aktivitaeten von Vorteil ist.");

AddDetail(({"wilderer"}),
"Die Wilderer in der Huette sind mit verschiedenen Aktivitaeten beschaeftigt, darunter das Raeuchern von Fleisch und die Zubereitung von Nahrung.");

AddDetail(({"wind"}),
"Der Wind hat hier wenig Einfluss, da die Huette gut geschuetzt ist und den Wilderern erlaubt, ihre Taetigkeiten ungehindert fortzusetzen.");

AddDetail(({ "einfluss" }),
    "Die Huette ist gut geschuetzt, und der Wind hat wenig Einfluss auf die Aktivitaeten der Wilderer.");

AddDetail(({ "fleischzubereitung" }),
    "Diese Huette dient ver Verarbeitung vom Fleisch der erlegten Tiere, darunter das Raeuchern.");

AddDetail(({ "holz" }),
    "Die Huette ist aus einfachen Materialien wie Holz und Erde gebaut, was fuer die Wilderer ausreichend ist.");

AddDetail(({ "rauchentwicklung" }),
    "Die Rauchentwicklung durch das Raeuchern fuellt die Huette mit Rauch.");

AddDetail(({ "rauchfuellung", "rauch" }),
    "Ein Schwall aus Hitze, Rauch und Roestaromen kommt dir beim Betreten der Huette entgegen.");

AddDetail(({ "schutz" }),
    "Die Huette bietet Schutz vor Wind und Wetter, was fuer die Wilderer bei ihren Aktivitaeten von Vorteil ist.");

AddDetail(({ "vorteil" }),
    "Die Huette ist gut geschuetzt, und der Wind hat wenig Einfluss auf die Aktivitaeten der Wilderer.");

AddDetail(({ "zubereitung" }),
    "Die Wilderer in der Huette sind mit verschiedenen Aktivitaeten beschaeftigt, darunter das Raeuchern von Fleisch und die Zubereitung von Nahrung.");


//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", ROOM "wilderer2" );

  AddItem(NPC "wilderer_koch", REFRESH_DESTRUCT);

  AddCmd("stibitz|stibitze|stehle|stehl|stiehl&wuerste|wurst|schinken|leckerei|leckereien", "cmd_stehlen", "Was willst du stibitzen?\n");
  AddCmd("raeuchere|raeucher&tier|leiche", "cmd_raeuchern", "Was willst du raeuchern?");
}

public int cmd_raeuchern() {
  object corpse;

  if(!objectp(corpse=present("Leiche", TP))) {
    write(BS("Du hast doch gar nichts zum raeuchern dabei!"));
    return -1;
  }

  write(BS("Du haengst die Leiche ueber das Feuer und laesst sie etwas einrauchen. Danach nimmst du die fertige Leckerei an dich."));
  corpse->remove(1);
  corpse = clone_object(OBJ "leckerei");
  if(corpse->move(TP, M_GET) != 1) {
    write(BS("Leider kannst du das gerade nicht tragen und legst es auf den Boden."));
    corpse->move(TO, M_SILENT|M_NOCHECK);
    return 1;
  }
  return 1;
}

public int cmd_stehlen() {
  object ob;

  if(objectp(present("\nsuedwald_koch", TO))) {
    write("Ohje... im Moment fuehlst du dich zu sehr beobachtet!\n");
    return -1;
  }

  if(!leckereien) {
    write(BS("Hm. Leider ist nichts mehr da, dass dir gut genug scheint."));
    return -1;
  }

  ob = clone_object(OBJ "leckerei");
  if(ob->move(TP, M_GET) != 1) {
    write(BS("Leider kannst du das gerade nicht tragen."));
    ob->remove();
    return -1;
  }

  leckereien--;

  write(BS("Du stibitzt dir " + ob->name(WEN)));
  say(BS(TPN + " schnappt sich schnell " + ob->name(WEN)));
  return 1;
}

public void reset() {
  ::reset();
  leckereien = 2 + random(4);
}