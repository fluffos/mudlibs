#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Im Lager von Wilderern");
  SetProp(P_INT_LONG,
    "Du bist nun im Inneren der Palisade. Hier haben wohl ein paar Wilderer "
    "ein kleines Lager errichtet. Der Boden ist mit Rindenmulch ausgestreut. "
    "Eine Feuerstelle befindet sich genau im Zentrum des Lagers und ein paar "
    "Gestelle zum Gerben von Tierhaeuten stehen daneben. Es gibt hier drei "
    "kleine, notduerftige Huetten im Osten, Suedosten und Westen. Im Sueden "
    "grenzt das Lager an die Felskante eines bewaldeten Berges, in der ein "
    "grosses Holztor eingelassen ist - offenbar eine alte Mine.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "inneren" }),
    "Hier befindest du dich in einem kleinen Lager, dass von einer notduerftigen "
    "Palisade umgeben ist.");

  AddDetail( ({ "feuerstelle", "stelle" }),
    "Auf der Feuerstelle steht ein alter Topf, den wohl jemand vergessen hat. "
    "Das Feuer ist bereits abgebrannt und nur noch kalte Asche.");

  AddDetail( ({ "huetten" }),
    "Die drei Huetten sehen allesamt aehnlich aus, mit kelinen Unterschieden. "
    "Die sind aus Holz zusammengezimmert und alle mit Stroh gedeckt. Welche interessiert dich denn genau?");

  AddDetail( ({"oestliche huette", "huette im osten"}),
    "Die oestliche Huette ist kreisrund. Mitten aus dem Dach erhebt sich dicker "
    "Qualm, wie von einem Feuer.");

  AddDetail( ({"suedoestliche huette", "huette im suedosten"}),
    "Die Huette im Suedosten ist robuster gebaut als die anderen. Ueber ihrem Eingang "
    "haengt der Kopf eines Hirschs.");

  AddDetail( ({ "westliche huette", "huette im westen" }),
    "Die westliche Huette ist etwas groesser als die anderen. Ein paar alter Stiefel steht "
    "davor um ausgelueftet zu werden.");

  AddDetail( ({ "kante", "felskante", "berg" }),
    "Dieses Lager wurde an den Fuss einer Kante des Berges gebaut und ist somit von hinten geschuetzt. "
    "In der Felskante erkennst du ein grosses Holztor, das wohl zu einer alten Mine fuehrt. Oben "
    "am Berg, auf einem Vorsprung, hat jemand ein Holzfort errichtet.");
  
  AddDetail( ({ "tor", "holztor" }),
    "Das Holztor ist etwas groesser und scheint in den Berg zu fuehren. Eine dicke Kette und ein "
    "Vorhaengeschloss sichern es.");

  AddDetail( ({ "schloss", "kette", "vorhaengeschloss" }),
    "Das sieht ziemlich stabil aus. Ohne einen Schluessel wirst du es nicht oeffnen koennen.");

  AddDetail( ({ "schluessel" }),
    "Wo koennte der wohl sein?");

  AddDetail( ({ "asche" }),
    "Die Asche in der Feuerstelle ist bereits kalt und erinnert an ein erloschenes Feuer.");

  AddDetail( ({ "boden" }),
    "Der Boden des Lagers ist mit Rindenmulch bedeckt, was dem Lager einen natuerlichen und rustikalen Charakter verleiht.");

  AddDetail( ({ "feuer" }),
    "Das Feuer in der Feuerstelle ist erloschen, und nur noch kalte Asche zeugt davon, dass hier vor Kurzem noch Waerme und Licht war.");

  AddDetail( ({ "fuss" }),
    "Der Boden unter deinen Fuessen besteht aus dem weichen Rindenmulch des Waldes.");

  AddDetail( ({ "gerben" }),
    "Die Gestelle zum Gerben von Tierhaeuten stehen bereit, um die Beute der Wilderer zu verarbeiten.");

  AddDetail( ({ "himmel" }),
    "Der Himmel ueber dem Lager ist durch das Blaetterdach der Baeume nur teilweise sichtbar.");

  AddDetail( ({ "holz" }),
    "Das Holz, das fuer die Huetten und die Palisade verwendet wurde, scheint aus dem umliegenden Wald zu stammen.");

  AddDetail( ({ "holzfort" }),
    "Oben am Berg befindet sich ein Holzfort, das einen Ueberblick ueber das Lager und seine Umgebung ermoeglicht.");

  AddDetail( ({ "lager" }),
    "Das Lager der Wilderer erstreckt sich innerhalb der Palisade und besteht aus einfachen Huetten und Arbeitsflaechen.");

  AddDetail( ({ "mine" }),
    "Die Felskante des Berges beherbergt eine alte Mine, die durch ein Holztor verschlossen ist.");

  AddDetail( ({ "palisade" }),
    "Die Palisade rund um das Lager ist notduerftig aus Baumstaemmen errichtet und bietet rudimentaeren Schutz.");

  AddDetail( ({ "rindenmulch" }),
    "Der Rindenmulch auf dem Boden sorgt fuer eine natuerliche Unterlage und gibt dem Lager eine gewisse Urigkeit.");

  AddDetail( ({ "stroh" }),
    "Die Daecher der Huetten sind mit Stroh gedeckt, was einen einfachen und traditionellen Baustil vermuten laesst.");

  AddDetail( ({ "tierhaeuten" }),
    "Die Gestelle stehen bereit, um Tierhaeute zu trocknen und zu verarbeiten, was auf die Aktivitaet von Wilderern hindeutet.");

  AddDetail( ({ "topf" }),
    "Der Topf auf der Feuerstelle ist alt und vernachlaessigt. Er wurde anscheinend vergessen, als das Feuer erloschen ist.");

  AddDetail( ({ "unterschieden" }),
    "Die Huetten sehen sich aehnlich, haben aber kleine Unterschiede, die auf verschiedene Nutzungen hinweisen.");

  AddDetail( ({ "vorsprung" }),
    "Ein Felsvorsprung am Berg beherbergt das Holzfort und bietet einen strategischen Ueberblick ueber das Lager.");

  AddDetail( ({ "wilderer" }),
    "Das Lager scheint von Wilderern genutzt zu werden, die hier ihren Unterschlupf gefunden haben.");

  AddDetail( ({ "zentrum" }),
    "Im Zentrum des Lagers befindet sich die Feuerstelle, die vermutlich als Treffpunkt und Kochstelle dient.");

  AddDetail( ({ "aktivitaet" }),
    "Ueberall im Lager zeugen Werkzeuge und Spuren davon, dass hier eine gewisse Aktivitaet stattfindet.");

  AddDetail( ({ "arbeitsflaechen" }),
    "Einige Arbeitsflaechen im Lager deuten darauf hin, dass die Wilderer hier ihre Beute verarbeiten und Vorbereitungen treffen.");

  AddDetail( ({ "baeume" }),
    "Die Baeume im umliegenden Wald ragen hoch ueber das Lager, spenden Schatten und tragen zum wilden Ambiente bei.");

  AddDetail( ({ "baumstaemmen", "baumstaemme" }),
    "Die Palisade des Lagers wurde aus grob behauenen Baumstaemmen errichtet, was auf eine einfache Bauweise hindeutet.");

  AddDetail( ({ "baustil", "bauweise" }),
    "Der Baustil der Huetten und der Palisade ist einfach und zweckmaessig, passend zur rustikalen Umgebung des Lagers.");

  AddDetail( ({ "beute" }),
    "Die Gestelle zum Gerben und Trocknen von Tierhaeuten lassen darauf schliessen, dass die Wilderer hier ihre Beute verarbeiten.");

  AddDetail( ({ "blaetterdach" }),
    "Das Blaetterdach der Baeume laesst nur vereinzelt Sonnenlicht auf den Boden fallen und verleiht dem Lager eine gewisse Urigkeit.");

  AddDetail( ({ "charakter", "urigkeit", "ambiente" }),
    "Das Lager hat einen raubeinigen Charakter, der durch die einfache Bauweise unterstrichen wird.");

  AddDetail( ({ "daecher" }),
    "Die Daecher der Huetten sind mit Stroh gedeckt, was den einfachen und traditionellen Charakter des Lagers betont.");

  AddDetail( ({ "felsvorsprung" }),
    "Der Felsvorsprung am Berg beherbergt das Holzfort und bietet einen strategischen Ueberblick ueber das gesamte Lager.");

  AddDetail( ({ "fuessen" }),
    "Der Boden unter deinen Fuessen besteht aus dem weichen Rindenmulch des Waldes.");

  AddDetail( ({ "gestelle" }),
    "Die Gestelle im Lager dienen zum Trocknen und Gerben von Tierhaeuten, was auf die Wildereiaktivitaeten hindeutet.");

  AddDetail( ({ "kochstelle", "mitte" }),
    "Die Feuerstelle in der Mitte des Lagers wird vermutlich auch als Kochstelle genutzt, um Nahrung zu zubereiten.");

  AddDetail( ({ "kurzem" }),
    "Die kalte Asche in der Feuerstelle erinnert daran, dass hier vor Kurzem noch ein Feuer brannte.");

  AddDetail( ({ "licht", "flecken", "lichtflecken", "sonnenlicht" }),
    "Das Sonnenlicht dringt nur vereinzelt durch das Blaetterdach der Baeume und wirft Lichtflecken auf den Boden des Lagers.");

  AddDetail( ({ "nutzungen" }),
    "Die Huetten im Lager haben verschiedene Nutzungen, die sich durch kleine Unterschiede in ihrer Bauweise zeigen.");

  AddDetail( ({ "schutz" }),
    "Die Palisade des Lagers bietet rudimentaeren Schutz vor der Umgebung und deutet auf eine gewisse Abgeschiedenheit hin.");

  AddDetail( ({ "tierhaeute" }),
    "Die Tierhaeute auf den Gestellen lassen darauf schliessen, dass die Wilderer hier ihre Beute verarbeiten und Gerberei betreiben.");

  AddDetail( ({ "treffpunkt" }),
    "Die Feuerstelle im Zentrum des Lagers koennte als Treffpunkt dienen, um sich zu versammeln und Geschichten auszutauschen.");

  AddDetail( ({ "ueberblick" }),
    "Der Felsvorsprung am Berg bietet einen Ueberblick ueber das gesamte Lager und die umliegende Waldlandschaft.");

  AddDetail( ({ "umgebung" }),
    "Die Umgebung des Lagers besteht aus dichtem Wald und verleiht dem Ort eine gewisse Abgeschiedenheit.");

  AddDetail( ({ "unterlage" }),
    "Der Boden des Lagers ist mit Rindenmulch bedeckt, was als natuerliche Unterlage dient.");

  AddDetail( ({ "unterschiede" }),
    "Die kleinen Unterschiede zwischen den Huetten deuten darauf hin, dass sie unterschiedliche Funktionen oder Nutzungen haben.");

  AddDetail( ({ "unterschlupf" }),
    "Das Lager dient als Unterschlupf fuer Wilderer, die hier Schutz und Rueckzug vor der Aussenwelt gefunden haben.");

  AddDetail( ({ "waerme" }),
    "Die kalte Asche in der Feuerstelle zeugt von der vergangenen Waerme, die hier durch das Feuer erzeugt wurde.");

  AddDetail( ({ "wald", "waldes", "ort", "waldlandschaft" }),
    "Der umliegende Wald erstreckt sich weit um das Lager herum und verleiht dem Ort eine natuerliche und wilde Umgebung.");

  AddDetail( ({ "abgeschiedenheit" }),
    "Die Abgeschiedenheit des Lagers wird durch die dichte Vegetation und die Palisade betont, die vor der Aussenwelt schuetzt.");

  AddDetail( ({ "aussenwelt" }),
    "Die Aussenwelt bleibt durch die Palisade und die dichte Vegetation draussen, was dem Lager einen Rueckzugsort im Wald verschafft.");

  AddDetail( ({ "funktionen" }),
    "Die verschiedenen Huetten und Arbeitsflaechen im Lager haben unterschiedliche Funktionen, die durch ihre Bauweise und Ausstattung erkennbar sind.");

  AddDetail( ({ "gerberei" }),
    "Die Gestelle im Lager deuten darauf hin, dass hier Gerberei betrieben wird, um Tierhaeute zu verarbeiten und zu konservieren.");

  AddDetail( ({ "geschichten", "erfahrungen" }),
    "Die Feuerstelle koennte als Treffpunkt dienen, um sich zu versammeln, Geschichten zu erzaehlen und Erfahrungen auszutauschen.");

  AddDetail( ({ "nahrung" }),
    "Die Kochstelle am Lagerfeuer deutet darauf hin, dass hier Nahrung zubereitet wird, um den Wilderern Energie und Nahrung zu liefern.");

  AddDetail( ({ "rueckzug", "rueckzugsort" }),
    "Das Lager bietet den Wilderern einen Rueckzugsort, der durch die Palisade und die abgeschiedene Lage in der Natur verstaerkt wird.");

  AddDetail( ({ "schatten" }),
    "Die dichten Baeume und das Blaetterdach spenden Schatten im Lager, was bei den Wilderern an heissen Tagen sicherlich willkommen ist.");

  AddDetail( ({ "spuren" }),
    "Ueberall im Lager sind Spuren von Aktivitaeten, Werkzeugen und Tierhaeuten zu sehen, die darauf hindeuten, dass hier Wildereiaktivitaeten stattfinden.");

  AddDetail( ({ "trocknen", "verarbeitungsprozesses", "prozess", "verarbeitungsprozess", "verarbeitung", "teil", "jagd" }),
    "Die Gestelle im Lager werden verwendet, um Tierhaeute zu trocknen, was ein Teil des Verarbeitungsprozesses nach der Jagd sein koennte.");

  AddDetail( ({ "vorbereitungen" }),
    "Einige Arbeitsflaechen im Lager weisen darauf hin, dass hier Vorbereitungen fuer die Verarbeitung von Beute und Wildereiaktivitaeten getroffen werden.");

  AddDetail( ({ "werkzeuge" }),
    "Ueberall im Lager sind Werkzeuge zu sehen, die fuer die Verarbeitung von Tierhaeuten und andere Wildereiaktivitaeten verwendet werden.");

  AddDetail( ({ "wildereiaktivitaeten" }),
    "Das Lager zeugt von Wildereiaktivitaeten, die durch die Arbeitsflaechen, Gestelle und Werkzeuge fuer die Verarbeitung von Tierhaeuten erkennbar sind.");


//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", ROOM "wilderer1" );
  AddExit( "osten", ROOM "wilderer3" );
  AddExit( "suedosten", ROOM "wilderer4" );
  AddExit( "westen", ROOM "wilderer5" );

  AddCmd("sperr|sperre&schloss|vorhaengeschloss|tor|holztor|kette&auf", "cmd_open", "Was willst du aufsperren?\n");
  AddCmd("oeffne|oeffen&tor|holztor|schloss|vorhaengeschloss|kette", "cmd_open", "Was willst du oeffnen?\n");

  AddItem(NPC "poacher_easy", REFRESH_DESTRUCT);
}

public int cmd_open() {
  object key;

  if(!objectp(key=present("\nsuedwald_key_fort", TP))) {
    write(BS("Ohne Schluessel wird das nichts."));
    return -1;
  }

  // Anschluss fuer die stag lord quest spaeter mal...
  write(BS("Gerade als du das Schloss aufsperren willst entdeckst du einen kleinen Zettel daran, auf dem steht:"));
  write("    Aus Sicherheitsgruenden (oder fehlender Zeit) ist dieser Teil noch nicht zugaenglich.\n");
  write("    Bitte komm ein andermal wieder! - Gwenshara\n");

  write(BS("Leider bricht der Schluessel dabei ab."));
  key->remove(1);
  return 1;
}
