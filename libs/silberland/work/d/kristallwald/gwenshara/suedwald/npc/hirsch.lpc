inherit "std/mnpc";

#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein grosser Hirsch");
  SetProp(P_LONG, "Dieser grosse Hirsch erhebt sich hier majestetisch. Er grast friedlich ein paar Zweige ab. "
                  "Sein Geweih ist gross gewachsen.");
  SetProp(P_NAME, "Hirsch");
  SetProp(P_GENDER, MALE);
  AddId( ({"hirsch", "FELL_WUSCHEL"}) );
  AddClass(({CL_ANIMAL}));

  create_default_npc(20+random(5));
  SetProp(P_HANDS, ({" mit seinem spitzen Geweih", QueryProp(P_HANDS)[1], DT_PIERCE}));
  SetProp(P_RACE, "Hirsch");
  SetProp(P_SIZE, 100+random(110));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);

  SetProp(P_MSGIN, "stolziert herein");
  SetProp(P_MSGOUT, "stolziert");  
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "b2_g");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, " blickt dich kauend an.\n");
  SetProp(P_REJECT, ({ REJECT_DROP,  "Der Hirsch kann nichts nehmen.\n"}));
  SetProp(P_DIE_MSG, " faellt roehrend zu Boden.\n");

  SetChats(1, ({"Der Hirsch kaut genuesslich einen Ast.\n",
                "Der Hirsch roehrt laut.\n",
                "Der Hirsch blickt dich kauend an.\n",
                "Der Hirsch schnaubt leise.\n",
                "Der Hirsch scharrt im Reisig.\n"}) );
  
  SetAttackChats(2, ({"Der Hirsch tritt mit seinen Hufen um sich.\n",
                      "Der Hirsch roehrt wild auf.\n",
                      "Der Hirsch versucht auszuweichen.\n",
                      "Der Hirsch rennt in einem weiten Bogen um dich.\n",
                      "Der Hirsch nimmt Anlauf.\n"}));

  SetProp(P_SPELLRATE, 10);

  AddSpell(1, 600, 
    "Der Hirsch stuermt mit gesenktem Geweih auf dich zu.\n",
    "Der Hirsch stuermt mit gesenktem Geweih auf @WEN zu.\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE: 1]));
}
