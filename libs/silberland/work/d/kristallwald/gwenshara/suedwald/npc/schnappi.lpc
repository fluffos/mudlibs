inherit "std/mnpc";
inherit "/std/npc/spells";

#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Riesenschnappschildkroete");
  SetProp(P_LONG, "Vor dir erhebt sich eine riesengrosse Schnappschildkroete. Ihr Panzer ist "
                  "mit feinen Hornstacheln ueberzogen. Ihre Kiefer sehen sehr schnappig aus und "
                  "die Haut hat eine hellrote Zeichnung.");
  SetProp(P_NAME, "Riesenschnappschildkroete");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"schildkroete", "schnappschildkroete", "riesenschnappschildkroete"}) );
  AddClass(({CL_ANIMAL}));

  create_default_npc(27);
  SetProp(P_HANDS, ({" mit ihrem starken Kiefer", QueryProp(P_HANDS)[1], DT_SQUEEZE}));
  SetProp(P_RACE, "Schildkroete");
  SetProp(P_SIZE, 150+random(50));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_BODY, QueryProp(P_BODY) + 30);

  SetProp(P_MSGIN, "stapft langsam herein");
  SetProp(P_MSGOUT, "stapft langsam");  

  AddInfo(DEFAULT_INFO, "gurgelt vor sich hin.\n");
  SetProp(P_REJECT, ({ REJECT_DROP,  "Die Riesenschnappschildkroete kann nichts tragen.\n"}));

  SetProp(P_SPELLRATE, 20);

  AddSpell(1, 700, 
    Name(WER) + " schnappt nach dir und beisst dir fast den Kopf ab!\n",
    Name(WER) + " schnappt nach @WEM und beisst fast den Kopf ab!\n",
    DT_SQUEEZE, ([SP_SHOW_DAMAGE: 1]));

  AddDefaultSpell(1, 200, DS_REDUCE_AC,
    Name(WER) + " schnappt wie eine Kneifzange einen Teil deiner Ruestung auf.\n",
    Name(WER) + " schnappt wie eine Kneifzange einen Teil @WESSEN Ruestung auf.\n");
  
  AddSpell(4, 300,
    Name(WER) + " rammt dich um.\n",
    Name(WER) + " rammt @WEN um.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]));

  AddSpell(3, 500,
    "Du stichst dich an " + name(WESSEN) + " Stacheln!\n",
    "@WER sticht sich an " + name(WESSEN) + " Stacheln!\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE: 1]));
}
