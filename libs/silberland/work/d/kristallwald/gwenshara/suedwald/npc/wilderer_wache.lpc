#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Wache der Wilderer");
  SetProp(P_LONG,
    "Dieser abgerissene Kerl haelt hier Wache, damit niemand in das Lager "
    "der Wilderer schleichen kann. Er ist sogar fuer einen Zwerg recht klein "
    "und sieht ziemlich heruntergekommen aus.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Wache der Wilderer");
  SetProp(P_GENDER, FEMALE);
  AddId(({"wache", "wilderer", SUEDWALD_POACHER, "\nsuedwald_wilderer_wache", "Keulenkaempfer"}));
  AddClass( ({CL_DWARF}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(16);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 115);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Killer-NPC");
  SetProp(P_KILL_MSG, "Du hattest keine Chance!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "ignoriert dich.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" sagt: Ich halte hier Wache, waehrend die anderen jagen duerfen!\n",
    Name(WER, 1)+" rotzt auf den Boden.\n",
    Name(WER, 1)+" schnitzt an einem Holzstueck herum.\n",
    Name(WER, 1)+" bastelt eine kleine Stolperfalle.\n"
   }) );

  SetAttackChats(5,
  ({Name(WER, 1)+" tritt dir gegen das Schienbein!\n",
    Name(WER, 1)+" stuerzt sich bruellend auf dich.\n",
    Name(WER, 1)+" versucht eine Falle auszuloesen, schafft es aber nicht.\n",
    Name(WER, 1)+" rammt dir die Faust in den Magen.\n",
    Name(WER, 1)+" gibt dir eine ordentliche Kopfnuss.\n",
   }) );

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME( "/p/weapon/club/knueppel");
  command("zuecke knueppel");

  CLONEME(ARMOUR "waschbaerenmuetze" );
  command("trage alles");
}

public void die(int poisondeath) {
  WALDMASTER->PoacherKilledBy(TP || QueryProp(P_KILLER));
  ::die(poisondeath);
  return;
}

public int Defend(int dam, string *dam_type_list, mixed spell, object enemy) {
  object trap;
  
  if(objectp(trap=present(SUEDWALD_TRAP, ENV(TO))) && !random(5)) {
    tell_room(ENV(TO), BS(Name(WER) + " loest eine Falle aus."));
    trap->trigger(enemy);
  }

  return ::Defend(dam, dam_type_list, spell, enemy);
}
