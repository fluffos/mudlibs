inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include "../def.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine dicke Bache");
  SetProp (P_LONG, "Diese Bache, ein weibliches Wildschwein, sieht ganz schoen dick aus. Guter Schinken.\n");
  SetProp (P_NAME, "Bache");
  SetProp (P_GENDER, FEMALE);
  SetProp(P_RACE, "Schwein");
  AddId ( ({"wildschwein", "schwein", "bache"}) );
  AddClass(({CL_ANIMAL}));
  
  create_default_npc(15);
  SetProp (P_BODY, 50);
  SetProp (P_SIZE, 60+random(20));
  SetProp(P_WEIGHT, 120000);
  SetProp (P_HANDS, ({" mit ihren Vorderpfoten", QueryProp(P_HANDS)[1], DT_BLUDGEON}));
  SetProp (P_ALIGN, -100);

  SetProp(P_MSGIN, "laeuft futtersuchend herein");
  SetProp(P_MSGOUT, "laeuft");  
  SetProp(P_MMSGOUT, "laeuft der Bache hinterher");
  SetProp(P_MMSGIN, "laeuft futtersuchend herein");
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "b2_g");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  call_out("frischlinge", 0);
}

public void frischlinge() {
  object ob;
  int i;

  for(i=0; i<2+random(4); ++i) {
    ob = clone_object(NPC "frischling");
    ob->move(ENV(TO), M_SILENT|M_NOCHECK);
    ob->AddDefender(TO);
    AddPursuer(ob);
    tell_room(ENV(TO), BS("Ein Frischling kriecht hinter der Bache hervor."));
  }
  return;
}

public void init() {
  ::init();

  if(TP->id("wildschwein")) {
    AddDefender(TP);
  }
}

public void InformDefend(object enemy) {
  Kill(enemy);
}
