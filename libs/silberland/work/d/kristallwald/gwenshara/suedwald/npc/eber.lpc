inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include "../def.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein wilder Eber");
  SetProp (P_LONG, "Ein gefaehrlich wirkender Wildschweineber. Es schnaubt Dich an.\n");
  SetProp (P_NAME, "Eber");
  SetProp (P_GENDER, MALE);
  SetProp(P_RACE, "Schwein");
  AddId ( ({"wildschwein", "schwein", "eber"}) );
  AddClass(({CL_ANIMAL}));
  
  create_default_npc(12);
  SetProp (P_BODY, 50);
  SetProp (P_SIZE, 60+random(20));
  SetProp(P_WEIGHT, 120000);
  SetProp (P_HANDS, ({" mit seinen Vorderpfoten", 65}));
  SetProp (P_ALIGN, -100);
  SetProp (P_MURDER_MSG, "Nutsch! %s!");

  SetProp(P_MSGIN, "laeuft futtersuchend herein");
  SetProp(P_MSGOUT, "laeuft");  
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "b2_g");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SUID;
  CLONEME ("/d/ebene/obj/waffe/eckzaehne");
  command ("zuecke eckzaehne");
}

public void init() {
    ::init();
  
    if(TP->id("wildschwein")) {
      AddDefender(TP);
    }
  }
  
  public void InformDefend(object enemy) {
    Kill(enemy);
  }
  
