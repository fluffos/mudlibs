#include "../def.h"
inherit "std/npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Mampffred, der Koch der Wilderer");
  SetProp(P_LONG,
    "Mampffred ist ein grosser und dicker Oger. Du bist dir gar nicht sicher, wie "
    "er es durch die Tuer geschafft hat. Wie erwartet ist er ziemlich speckig "
    "und scheint staendig zu schwitzen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Mampffred");
  SetProp(P_GENDER, MALE);
  AddId(({"mampffred", "oger", "koch", "wilderer", "\nsuedwald_koch"}));
  AddClass( ({CL_OGRE}) );
  SetProp(P_ARTICLE, 0);

  set_living_name("mampffred");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(22);

  SetProp(P_HANDS, ({" mit seinen speckigen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Oger");
  SetProp(P_SIZE, 230);
  SetProp(P_WEIGHT, 275000);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" sagt: Das kann ich nicht raeuchern!!!!\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_WATER  : -0.2, DT_TERROR :  0.25 ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Jetzt wirst du eine Rauchwurst!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " murmelt etwas unverstaendliches.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"wurst","schinken","wuerste","rauchern","leckerei"}),
    "Ich liebe Geraeuchertes! Am liebsten Wildbret!",
    "sagt: ");

  SetChats(3, ({
    "Mampffred haengt eine frische Tierleiche zum raeuchern auf.\n",
    "Der Koch filetiert einen Hasen.\n",
    "Mampffred kostet einen der Schinken.\n",
    "Mampffred faschiert ein paar Tierteile und stopft sie in einen Wurstdarm.\n",
    "Der Koch denkt . o ( Nur mal kurz kosten... )\n"
  }));

  SUID;
  CLONEME("/p/weapon/knife/fleischermesser" );
  command("zuecke messer");

  CLONEME("/p/armour/cloak/schuerze" );
  command("trage alles");

  CLONEME(OBJ "leckerei");
}

public void die(int poisondeath) {
  WALDMASTER->PoacherKilledBy(TP || QueryProp(P_KILLER));
  ::die(poisondeath);
  return;
}
