inherit "std/mnpc";

#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein roter Fuchs");
  SetProp(P_LONG, "Der Fuchs ist hier auf der Suche nach Maeusen, die er fressen kann.");
  SetProp(P_NAME, "Fuchs");
  SetProp(P_GENDER, MALE);
  AddId( ({"fuchs", "FELL_WUSCHEL"}) );
  AddClass(({CL_ANIMAL}));

  create_default_npc(8 + random(5));
  SetProp(P_HANDS, ({" mit seinen spitzen Zaehnchen", QueryProp(P_HANDS)[1], DT_PIERCE}));
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 10+random(10));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 6);

  SetProp(P_MSGIN, "tapst herein");
  SetProp(P_MSGOUT, "tapst");  
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "b2_g");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "fiept leise.\n");
  SetProp(P_REJECT, ({ REJECT_DROP,  "Der Fuchs kann das nicht tragen.\n"}));
}
