inherit "std/mnpc";

#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine, sirrende Libelle");
  SetProp(P_LONG, "Diese Libelle ist etwas groesser als andere. Sie zischt geschwind herum und "
                  "surrt dabei leise. Ein sehr nuetzliches Tier.");
  SetProp(P_NAME, "Libelle");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"libelle", "FEDERN_WUSCHEL"}) );
  AddClass(({CL_ANIMAL}));

  create_default_npc(3);
  SetProp(P_HANDS, ({" mit ihren kleinen Mandibeln", QueryProp(P_HANDS)[1], DT_RIP}));
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 10+random(10));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 6);

  SetProp(P_MSGIN, "surrt herein");
  SetProp(P_MSGOUT, "surrt");  
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "b2_g");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "fliegt einen Keis um dich.\n");
  SetProp(P_REJECT, ({ REJECT_DROP,  "DieLibelle kann das nicht tragen.\n"}));
}
