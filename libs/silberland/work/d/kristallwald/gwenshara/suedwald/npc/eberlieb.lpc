#include "../def.h"
inherit "std/npc";
inherit "std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eberlieb, der Anfuerher der Wilderer");
  SetProp(P_LONG,
    "Eberlieb ist ein unscheinbarer Mann. Ziemlich durchschnittlich und "
    "trotzdem scheint er hier das Kommando zu haben. Vielleicht ist er "
    "dir etwas zu unscheinbar...");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Eberlieb");
  SetProp(P_GENDER, MALE);
  AddId(({"eberlieb", "anfuehrer", "wilderer", "\nsuedwald_eberlieb", "Messermeister"}));
  AddClass( ({CL_HUMAN}) );
  SetProp(P_ARTICLE, 0);

  set_living_name("eberlieb");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(32);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 175);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will das nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Leg dich nicht mit mir an!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "sagt: Keine Ahnung was du von mir willst.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"wilderer"}),
    "Wir sind keine Wilderer, sondern freischaffende Unternehmer! Wir "
    "nutzen die Ressourcen des Waldes zur kapitalistischen Gewinnmaximierung.",
    "sagt: ");

  AddInfo( ({"unternehmer"}),
    "Ganz richtig. Wir erwirtschaften fuer unseren Auftraggeber grosse Gewinne "
    "in Form von Rohmaterialien.", "sagt: ");
  
  AddInfo( ({"auftraggeber"}),
    "Das geht dich einen Dreck an!", "sagt: ");

  AddInfo( ({"kiste", "kleiderkiste"}),
    "Lass die Finger davon! Die gehoert mir. Wenn ich nur wuesste wo ich den Schluessel "
    "verloren hab...", "sagt: ");

  AddInfo( ({"schluessel"}),
    "Der kann nicht weit sein. Er muss irgendwo im Lager sein.", "sagt: ");

  AddInfo( ({"mine", "tor", "holztor"}),
    "Unser eigentliches Fort befindet sich auf dem Berg. Aktuell ist der Zugang "
    "durch die Mine aber gesperrt.", "sagt: ");

  AddInfo( ({"fort", "holzfort"}),
    "Dort oben sind noch mehr von uns und der Hirschfuerst. Er ist unser Anfuehrer. "
    "Im Moment kommst du aber nicht durch die Mine, da diese gesperrt ist.", "sagt: ");

  AddInfo( ({"fuerst", "hirschfuerst"}),
    "Der Hirschfuerst wird eines Tages der unangefochtene Herrscher aller Waelder.", "sagt: ");


  SetProp(P_SPELLRATE, 25);

  AddSpell(3, 350, 
    "Eberlieb rammt dir seinen Dolch in den Ruecken.\n",
    "Eberlieb rammt @WEM einen Dolch in den Ruecken.\n",
     DT_PIERCE, ([SP_SHOW_DAMAGE: 1]));

  AddSpell(1, 900,
    "Eberlieb verschwindet im Schatten, taucht ploetzlich hinter dir auf und versucht dir die Kehle duchzuschneiden!\n",
    "Eberlieb verschwindet im Schatten und taucht ploetzlich hinter @WEM wieder auf!\n",
    DT_SLASH, ([SP_SHOW_DAMAGE: 1]));

  AddSpell(2, 400,
    "Eberlieb schlitzt dich mit seinem Dolch auf.\n",
    "Eberlieb schlitzt @WEN mit seinem Dolch auf.\n", DT_SLASH, ([SP_SHOW_DAMAGE: 1]));

  AddDefaultSpell(1, 666, DS_BLIND
    "Eberlieb sticht dir mit seinem Dolch die Augen aus!\n",
    "Eberlieb sticht @WEM mit seinem Dolch die Augen aus!\n");

  SUID;
  CLONEME("/p/weapon/knife/meucheldolch" );
  command("zuecke dolch");

  CLONEME("/p/armour/boots/lederstiefel" );
  CLONEME("/p/armour/armour/lederruestung" );
  command("trage alles");

  CLONEME(OBJ "minenschluessel");
}

public void die(int poisondeath) {
  WALDMASTER->PoacherKilledBy(TP || QueryProp(P_KILLER));
  ::die(poisondeath);
  return;
}
