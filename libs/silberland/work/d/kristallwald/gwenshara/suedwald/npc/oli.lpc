#include "../def.h"

inherit "std/npc";

object owner;
int wildDog, wasWildDog;

public void create() {
  if(!is_clone(TO)) return;

  ::create();

  wildDog = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Oli, der Labrador von Edila");
  SetProp(P_LONG,
    "Oli ist ein brauner Labrador. Seine Schnauze hat schon erste graue "
    "Haare und sein schwanz dreht sich wie der Propeller eines Flugzeugs. "
    "Auf dem Kopf hat er eine lustige Kuerbishaube. Er sieht dich neugierig "
    "an. Ein echt guter Junge!");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Oli");
  SetProp(P_GENDER, MALE);
  AddId(({"oli", "\nedila_oli", "labrador", "hund"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(10);

  SetProp(P_HANDS, ({" mit seinem Gebiss",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Hund");
  SetProp(P_SIZE, 100);
  SetProp(P_WEIGHT, 25000);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "laeuft herein");
  SetProp(P_MSGOUT, "laeuft");
  SetProp(P_MMSGIN, "kommt bellend aus dem Wald gelaufen");
  SetProp(P_MMSGOUT, "laeuft bellend in den Wald");
//--Tod--------------------------------------------------------------------

  SetProp(P_NOATTACK,1 );
  SetProp(P_FRIEND, 1);

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","bellt: ");
}

public void SetOwner(object _owner) {
    owner = _owner;
    owner->AddPursuer(TO);
    tell_object(owner, BS("Oli folgt dir jetzt neugierig."));
    set_living_name("suedwald_oli_"+getuid(owner));
    wasWildDog = 0;
    return;
}

public void init() {
    ::init();

    if(!wildDog && TP->id(SUEDWALD_ANIMAL)) {
        wildDog = 1;
        owner->RemovePursuer(TO);
        command_me("emote springt aufgeret herum, als er "+TPN+" entdeckt.");
        call_out("run_wild", 0, 2+random(1));
        return;
    }

    if(wasWildDog && TP == owner) {
        call_out("follow_again", 0);
    }
}

public object QueryOwner() {
    return owner;
}

public void run_wild(int steps) {
    mixed exits;
    string *directions;

    exits = ENV(TO)->QueryProp(P_EXITS);
    directions = m_indices(exits);

    command_me(directions[random(sizeof(directions))]);
    if(--steps>0) {
        call_out("run_wild", steps);
    } else {
        wildDog = 0;
        wasWildDog = 1;
        command_me("emote bruhigt sich.");
    }
    return;
}

public void follow_again() {
    command_me("emote freut sich dich zu sehen.");
    SetOwner(owner);
    wasWildDog = 0;
}

public void reset() {
    ::reset();

    command_me("emote sieht ein Reh und laeuft in den Wald.");
    remove(1);
    return;
}
