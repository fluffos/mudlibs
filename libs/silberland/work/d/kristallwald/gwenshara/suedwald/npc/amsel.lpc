inherit "std/mnpc";

#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Amsel");
  SetProp(P_LONG, "Die Amsel sitzt am Boden und huepft pickend herum.");
  SetProp(P_NAME, "Amsel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"amsel", "FEDERN_WUSCHEL"}) );
  AddClass(({CL_ANIMAL}));

  create_default_npc(5);
  SetProp(P_HANDS, ({" mit ihrem Schnabel", QueryProp(P_HANDS)[1], DT_PIERCE}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 10+random(10));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");  
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "b2_g");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "zwitschert.\n");
  SetProp(P_REJECT, ({ REJECT_DROP,  "Die Amsel will das nicht haben.\n"}));
}
