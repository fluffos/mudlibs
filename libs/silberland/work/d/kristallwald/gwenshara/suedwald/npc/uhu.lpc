inherit "std/mnpc";

#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Uhu sitzt auf einem Ast und schaut dich mit grossen Augen an.");
  SetProp(P_LONG, "Wow! Dieser Uhu ist ueberrascht gross. Seine grossen Augen starren dich missmutig an.");
  SetProp(P_NAME, "Uhu");
  SetProp(P_GENDER, MALE);
  AddId( ({"uhu", "eule", "FEDERN_WUSCHEL"}) );
  AddClass(CL_FLYING);
  AddClass(({CL_ANIMAL}));

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinen scharfen Krallen", QueryProp(P_HANDS)[1], DT_RIP}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 70+random(30));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 1);

  SetProp(P_MSGIN, "gleitet herein");
  SetProp(P_MSGOUT, "gleitet");  
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "b2_g");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "schuhut laut.\n");
  SetProp(P_REJECT, ({ REJECT_DROP,  "Der Uhu will das nicht haben.\n"}));
}
