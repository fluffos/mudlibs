inherit "std/mnpc";

#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein kraeftiger Schwarzbaer");
  SetProp(P_LONG, "Das ist ein typischer Schwarzbaer. Sein Rumpf ist massiv und die "
                  "GLiedmassen kraeftig. Seine Klauen eigenen sich hervorragend zum "
                  "Graben, Reissen und Klettern.");
  SetProp(P_NAME, "Schwarzbaer");
  SetProp(P_GENDER, MALE);
  AddId( ({"baer", "schwarzbaer", "FELL_WUSCHEL"}) );
  AddClass(({CL_ANIMAL}));

  create_default_npc(25+random(5));
  SetProp(P_HANDS, ({" mit seinen scharfen Krallen", QueryProp(P_HANDS)[1], DT_SLASH}));
  SetProp(P_RACE, "Baer");
  SetProp(P_SIZE, 150 + random(30));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);

  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "stapft");  
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "b2_g");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, " brummt dich an.\n");
  SetProp(P_REJECT, ({ REJECT_DROP,  "Der Schwarzbaer kann nichts nehmen.\n"}));
  SetProp(P_DIE_MSG, " geht bruellend zu Boden.\n");

  SetChats(1, ({"Der Schwarzbaer wuehlt in der Erde.\n",
                "Der Schwarzbaer kratzt an einem Baumstamm.\n",
                "Der Schwarzbaer bruellt laut.\n",
                "Der Schwarzbaer stellt sich auf seine Hinterbeine.\n",
                "Der Schwarzbaer schnueffelt laut in deine Richtung.\n",
                "Der Schwarzbaer beutelt einen Kopf hin und her.\n"}) );
  
  SetAttackChats(2, ({"Der Schwarzbaer schlaegt mit einer Pranke nach dir.\n",
                      "Der Schwarzbaer bruellt dich laut an.\n",
                      "Der Schwarzbaer knurrt wild.\n"}));

  SetProp(P_SPELLRATE, 20);

  AddSpell(1, 700, 
    "Der Schwarzbaer stellt sich auf und schlaegt mit beiden Pranken nach dir.\n",
    "Der Schwarzbaer stellt sich auf und schlaegt mit beiden Pranken nach @WEM.\n",
    DT_SLASH, ([SP_SHOW_DAMAGE: 1]));

  AddSpell(3, 300,
     "Der Schwarzbaer bruellt dir direkt ins Gesicht.\n",
     "Der Schwarzbaer bruellt @WEM direkt ins Gesicht.\n",
     DT_SOUND, ([SP_SHOW_DAMAGE:1 ]));

  AddSpell(3, 250,
     "Der Schwarzbaer rammt dich mit der Schulter.\n",
     "Der Schwarzbaer rammt @WEN mit der Schulter.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 450,
     "Der Schwarzbaer verbeisst sich in dir.\n",
     "Der Schwarzbaer verbeisst sich in @WEM.\n",
    DT_RIP, ([SP_SHOW_DAMAGE: 1]));
}
