inherit "std/mnpc";

#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Habicht");
  SetProp(P_LONG, "Der Habicht sitzt auf einem Ast ueber dir und beobachtet dich ganz genau.");
  SetProp(P_NAME, "Habicht");
  SetProp(P_GENDER, MALE);
  AddId( ({"habicht", "FEDERN_WUSCHEL"}) );
  AddClass(({CL_ANIMAL}));

  create_default_npc(8);
  SetProp(P_HANDS, ({" mit seinen Krallen", QueryProp(P_HANDS)[1], DT_RIP}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 30+random(10));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 1);

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");  
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "b2_g");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "kreicht laut.\n");
  SetProp(P_REJECT, ({ REJECT_DROP,  "Der Habicht will das nicht haben.\n"}));
}
