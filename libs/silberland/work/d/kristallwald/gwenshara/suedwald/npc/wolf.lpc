inherit "std/mnpc";

#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein struppiger Waldwolf");
  SetProp(P_LONG, "Der Waldwolf ist etwas kleiner als seine Verwandten aus dem Flachland. Sein Fell ist "
                  "grau und struppig.");
  SetProp(P_NAME, "Wolf");
  SetProp(P_GENDER, MALE);
  AddId( ({"wolf", "waldwolf", "FELL_WUSCHEL"}) );
  AddClass(({CL_ANIMAL}));

  create_default_npc(15+random(5));
  SetProp(P_HANDS, ({" mit seinen Faengen", QueryProp(P_HANDS)[1], DT_RIP}));
  SetProp(P_RACE, "Wolf");
  SetProp(P_SIZE, 75+random(40));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht");  
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "b2_g");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, " knurrt leise.\n");
  SetProp(P_REJECT, ({ REJECT_DROP,  "Der Wolf kann nichts nehmen.\n"}));
  SetProp(P_DIE_MSG, " jault nochmal auf und ist dann tot.\n");

  SetChats(1, ({"Der Wolf schnueffelt herum.\n",
                "Der Wolf blinzelt kurz.\n",
                "Der Wolf stellt seine Ohren auf.\n"}) );

  SetProp(P_SPELLRATE, 10);

  AddSpell(1, 300, 
    "Der Wolf beisst dich.\n",
    "Der Wolf beisst @WEN.\n",
    DT_RIP, ([SP_SHOW_DAMAGE: 1]));
}
