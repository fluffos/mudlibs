#include "../def.h"

inherit "std/npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Edila, das kleine Hobbitmaedchen sucht ihren Hund");
  SetProp(P_LONG,
    "Edila ist ein kleines Hobbitmaedchen. Eher schmaechtig in der Statur und "
    "weit weg von den heimischen Huegeln. Sie scheint nach irgendetwas, oder "
    "irgendjemandem zu suchen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Edila");
  SetProp(P_GENDER, FEMALE);
  AddId(({"edila", "maedchen", "hobbit", "hobbitmaedchen"}));
  AddClass( ({CL_HOBBIT}) );
  SetProp(P_ARTICLE, 0);

  set_living_name("edila");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(5);

  SetProp(P_HANDS, ({" mit ihren Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 70);
  SetProp(P_WEIGHT, 10000);
  SetProp(P_ALIGN, 600);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    Name(WER,1)+" sagt: Danke! Sowas wollte ich schon immer haben!.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  //--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Wer suche jetzt meinen Oli?!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "fragt: Kannst du mir helfen meinen Hund zu finden?\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"hund","oli"}),
    "Mein Hund Oli ist davon gelaufen! Wir waren hier auf einem Spaziergang und "
    "dann hat er ein Reh gesehen. Er ist ihm sofort nachgelaufen und ich konnte ihn "
    "gar nicht mehr halten! Bitte hilf mir ihn zu finden!.",
    "weint: ");

  AddInfo( ({"hilfe","helfen", "suchen"}),
    "Ich war hier mit meinem Hund, Oli, spazieren. Als er ein Reh gesehen hat ist "
    "er einfach davon gelaufen. Wenn du ihn mir zurueckbringen willst, dann "
    "<biete> mir deine Hilfe an.",
    "jammert: ");

  AddInfo( ({"reh","rehe"}),
    "Oli ist ein Labrador und liieeeebt Jagdspiele. Am liebsten ware er wohl ein "
    "Jagdhund geworden. Darum musst man gut aufpassen. Wenn er ein Reh oder anderes "
    "Wildtier, jagt er ihm sofort nach!",
    "sagt: ");

  AddInfo( ({"derlim","hobbingen","spaziergang","wanderung","zuhause"}), 
    "Ich hatte einfach Lust auf einen Spaziergang und jetzt bin ich hier! Meine Eltern "
    "machen sich da keine Sorgen. Wandern ist fuer uns Hobbits ganz normal.", "sagt: ");

  AddInfo( ({"eltern"}),
    "Meine Eltern leben in Derlim, gleich vor der Hecke am Suedweg!", "sagt: ");

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" ruft: OLI, OLI! WO BIST DU?\n",
    Name(WER, 1)+" blaest fest in eine Hundepfeife.\n",
    Name(WER, 1)+" sucht nach ihrem Hund.\n",
    Name(WER, 1)+" sagt: Kannst du mir helfen, Oli zu finden?\n"
   }) );

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME("/p/weapon/club/wanderstab");
  command("zuecke stab");

  CLONEME("/p/armour/armour/weste" );
  command("trage alles");

  AddCmd("biete|biet&edila|maedchen|hobbit|hobbitmaedchen&hilfe|unterstzetung|an", "cmd_helfen", "Wem willst deine Hilfe anbieten?");
  AddCmd("hilf|helfe&edila|maedchen|hobbit|hobbitmaedchen", "cmd_helfen", "Wem willst du deine Hilfe anbieten?");
}

public int cmd_helfen() {
    object ob;

    if(TP->QueryQuest(DOGQUEST_NAME)) {
        command_me("sag Danke, "+TPN+", aber du hast mir schon einmal geholfen.");
        return 1;
    }

    if(objectp(present("\nedila_hundepfeife", TP))) {
        command_me("sag Aber du hilfst mir doch schon, "+TPN+"!");
        return 1;
    }

    ob = clone_object(OBJ "hundepfeife");
    if(ob->move(TP, M_GET) != 1) {
        command_me("sag Leider kannst du meine Hundepfeife gerade nicht targen. Komm wieder wenn du bereit bist!");
        ob->remove();
        return -1;
    }

    command_me("sag Danke, "+TPN+"! Du bist ein Goldschatz! Also hoer gut zu. Oli ist ein "
               "Labrador. Wir sind hier durch den Wald spaziert und dann hat er ein Reh gesehen. "
               "Dann ist er ins Unterholz abgezischt und nicht wieder gekommen. Mit der Hundepfeife "
               "kannst du ihn anlocken, wenn du in seiner Naehe bist. Dann bring ihn einfach zu mir "
               "zurueck. Aber pass auf! Wenn er wieder ein Wildtier sieht, dann wird er es verfolgen!");
    write(BS("Edila gibt dir eine Hundepfeife."));
    tell_room(ENV(TO), BS("Edila gibt "+TPN+" eine Hundepfeife."), ({TP}));
    return 1; 
}

public void init() {
    ::init();

    if(TP->id("\nedila_oli")) {
        call_out("complete_quest", 0, TP);
    }
}

public void complete_quest(object oli) {
    int r;
    object pfeife;

    if(present(oli->QueryOwner(), ENV(TO)) && present(oli, ENV(TO))) {
        command_me("sag Vielen Dank, dass du mir meinen geliebten Oli zurueck gebracht hast, "+TPN+"!!!");
        r = oli->QueryOwner()->GiveQuest(DOGQUEST_NAME);
        if(r != 1) {
            command_me("sag Quest Fehler: " + r);
        } else {
            call_out("oli_geht", 0, oli);
        }
        if(objectp(pfeife=present("\nedila_hundepfeife", TP))) {
            pfeife->remove();
        }
    }
    return;
}

public void oli_geht(object oli) {
    tell_room(ENV(TO), BS("Oli sieht ein Reh und rennt ihm aufgeregt nach."));
    oli->remove(1);
    return;
}
