inherit "std/npc";

#include <properties.h>
#include <language.h>
#include "../def.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein kleiner Frischling");
  SetProp (P_LONG, "Das hier ist ein Babywilschwein. Es hat noch seine dunkelbraunen Strefen im Fell und wuehlt hier spielerisch herum.");
  SetProp (P_NAME, "Frischling");
  SetProp (P_GENDER, MALE);
  SetProp(P_RACE, "Schwein");
  AddId ( ({"wildschwein", "schwein", "frischling"}) );
  AddClass(({CL_ANIMAL}));
  
  create_default_npc(5);
  SetProp (P_BODY, 50);
  SetProp (P_SIZE, 60+random(20));
  SetProp(P_WEIGHT, 5000);
  SetProp (P_HANDS, ({" mit kleinen Vorderpfoten", 65}));
  SetProp (P_ALIGN, 100);

  SetProp(P_MMSGOUT, "laeuft der Bache hinterher");
  SetProp(P_MMSGIN, "laeuft futtersuchend herein");
}
