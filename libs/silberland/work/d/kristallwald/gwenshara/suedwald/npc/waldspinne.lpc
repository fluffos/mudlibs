inherit "std/mnpc";
inherit "/std/npc/spells";

#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine grosse, haarige Waldspinne");
  SetProp(P_LONG, "Die Waldspinne ist eine etwa zwergengrosse Spinnenart. Sie lebt in den Waeldern und "
                  "faengt mit ihren Netzen kleine Nagetiere.");
  SetProp(P_NAME, "Waldspinne");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"spinne", "waldspinne"}) );
  AddClass(({CL_ANIMAL}));

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit ihren Mandibeln", QueryProp(P_HANDS)[1], ({DT_RIP, DT_POISON})}));
  SetProp(P_RACE, "Spinne");
  SetProp(P_SIZE, 100+random(40));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 8);

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");  
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "b2_g");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "klackert mit ihren Mandibeln.\n");
  SetProp(P_REJECT, ({ REJECT_DROP,  "Die Spinne braucht das nicht.\n"}));

  SetProp(P_SPELLRATE, 10);

  AddDefaultSpell(1, 200, DS_POISON,
    "Die Spinne beisst dich und ein brennendes Gefuehl bleibt zurueck.\n",
    "Die Spinne beisst @WEN.\n", 1);

  AddDefaultSpell(1, 0, DS_SLOW,
    "Die Spinne wickelt dich in ein Netz.\n",
    "Die Spinne wickelt @WEN in ein Netz.\n");

  AddSpell(3, 250, 
     "Die Spinne beisst dich.\n",
     "Die Spinne beisst @WEN.\n",
     DT_POISON, ([SP_SHOW_DAMAGE:1]));
}
