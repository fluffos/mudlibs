#include "../def.h"

inherit "/std/mnpc.lpc";

//--Create-----------------------------------------------------------------

void create()
{
  string race, short;
  if(!is_clone(TO)) return;

  ::create();

  switch(random(8)) {
    case 0: 
      SetProp(P_SHORT, "Ein dunkelelfischer Wilderer");
      SetProp(P_RACE, "Dunkelelf");
      SetProp(P_SIZE, 190);
      SetProp(P_WEIGHT, 50000);
      break;
    case 1:
      SetProp(P_SHORT, "Ein elfischer Wilderer");
      SetProp(P_RACE, "Elf");
      SetProp(P_SIZE, 190);
      SetProp(P_WEIGHT, 50000);
      break;
    case 2:
      SetProp(P_SHORT, "Ein zwergischer Wilderer");
      SetProp(P_RACE, "Zwerg");
      SetProp(P_SIZE, 130);
      SetProp(P_WEIGHT, 90000);
      break;
    case 3:
      SetProp(P_SHORT, "Ein feeischer Wilderer");
      SetProp(P_RACE, "Fee");
      SetProp(P_SIZE, 75);
      SetProp(P_WEIGHT, 15000);
      break;
    case 4:
      SetProp(P_SHORT, "Ein trollischer Wilderer");
      SetProp(P_RACE, "Troll");
      SetProp(P_SIZE, 380);
      SetProp(P_WEIGHT, 150000);
      break;
    case 5:
      SetProp(P_SHORT, "Ein ogrischer Wilderer");
      SetProp(P_RACE, "Oger");
      SetProp(P_SIZE, 250);
      SetProp(P_WEIGHT, 250000);
      break;
    case 6:
      SetProp(P_SHORT, "Ein menschlicher Wilderer");
      SetProp(P_RACE, "Mensch");
      SetProp(P_SIZE, 190);
      SetProp(P_WEIGHT, 50000);
      break;
    case 7:
      SetProp(P_SHORT, "Ein hobbitscher Wilderer");
      SetProp(P_RACE, "Hobbit");
      SetProp(P_SIZE, 120);
      SetProp(P_WEIGHT, 50000);
      break;
  }

//--Beschreibungen---------------------------------------------------------

  SetProp(P_LONG,
    sprintf("Vor dir steht eine abgerissene Gestalt, gekleidet in Felle und "
    "einfache Kleidung. Dem Aussehen nach handelt es sich um einen Wilderer, "
    "der hier mit Fallen Waldtiere jagt. Der Statur nach zu schliessen handelt es sich "
    "um einen %s.", QueryProp(P_RACE)));

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Wilderer");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"wilderer", lower_case(QueryProp(P_RACE)), "Schwertkaempfer", SUEDWALD_POACHER}));
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

create_default_npc(9);

  SetProp(P_HANDS, ({" mit blossen Haenden"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })  );
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" sagt: Ich nehme nichts von Dir.\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "tritt aus dem Wald");
  SetProp(P_MMSGOUT, "verschwindet im Wald");

  SetProp(P_MNPC_AREA, ({  ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "b8_d");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);

//--Ausruestung------------------------------------------------------------

  SUID; 
 
  CLONEME("/p/weapon/sword/machete");
  command("zuecke machete"); 

  call_out("get_ready", 0);

  SetProp(P_SPELLRATE, 20);
  AddSpell(3, 250,
    Name(WER) + " versucht dir eine Hand abzuhacken.\n",
    Name(WER) + " versucht @WEM eine Hand abzuhacken.\n", 
    DT_SLASH, ([SP_SHOW_DAMAGE: 1]));

  AddSpell(2, 300,
    Name(WER) + " rammt dir eine Faust ins Gesicht.\n",
    Name(WER) + " rammt @WEM die Faust ins Gesicht.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]));

  AddSpell(1, 350,
    Name(WER) + " wuergt dich mit einem Lederriemen.\n",
    Name(WER) + " wuergt @WEN mit einem Lederriemen.\n",
    DT_SQUEEZE, ([SP_SHOW_DAMAGE: 1]));

//--Create Ende------------------------------------------------------------
}

public int Defend(int dam, string *dam_type_list, mixed spell, object enemy) {
  object trap;
  
  if(objectp(trap=present(SUEDWALD_TRAP, ENV(TO))) && !random(5)) {
    tell_room(ENV(TO), BS(Name(WER) + " loest eine Falle aus."));
    trap->trigger(enemy);
  }

  return ::Defend(dam, dam_type_list, spell, enemy);
}


public void init() {
  ::init();

  if(TP->id(SUEDWALD_ANIMAL)) {
    command_me("sag HAHA! Neue Beute fuer mich!");
    Kill(TP);
  }

  return;
}

public void die(int poisondeath) {
  WALDMASTER->PoacherKilledBy(TP || QueryProp(P_KILLER));
  ::die(poisondeath);
  return;
}


//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "schuettelt verwundert den Kopf.",
        "schuettelt verwundert den Kopf.");
      break;

    case "aergerlich":
    case "fies":
      call_out("reaction", 0, TP,
        "knurrt: Leg Dich nicht mit mir an!",
        "knurrt: Leg Dich nicht mit mir an!");
        break;

    case "frech":
      call_out("reaction", 0, TP,
        "brummt Dich unwirsch an.",
        "brummt "+TP->name(WESSEN)+" unwirsch an.");
      break;

    case "albern":
    case "froh":
      call_out("reaction", 0, TP,
        "runzelt die Stirn.",
        "runzelt die Stirn.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Lass das lieber sein.",
        "sagt: Lass das lieber sein.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "beachtet Dich gar nicht.",
        "beachtet "+TP->name(WEN)+" gar nicht.");
      break;

    case "traurig":
    case "nett":
      call_out("reaction", 0, TP,
        "mustert Dich stumm.",
        "mustert "+TP->name(WEN)+" stumm.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

