#include "../def.h"
#include "/gilden/waldlaeufer/def_extern.h"

inherit "/std/mnpc";
inherit "/std/npc/spells";

#define DEFAULT_RANGER_ID "\ndefault_ranger_npc"
#define P_RANGER_MAX_PET_LEVEL "ranger_max_pet_level"

//--Create-----------------------------------------------------------------
object pet;

void create()
{
  string race, short;
  if(!is_clone(TO)) return;

  ::create();

  switch(random(2)) {
    case 0: 
        SetProp(P_SHORT, "Ein erfahrene Hueterin der Waldlaeufer");;
        SetProp(P_GENDER, FEMALE);
        break;
    case 1:
        SetProp(P_SHORT, "Eine erfahrener Hueter der Waldlaeufer");
        SetProp(P_GENDER, MALE);
        break;
  }

//--Beschreibungen---------------------------------------------------------

  race = ({"Elf", "Mensch", "Fee", "Dunkelelf", "Zwerg", "Troll", "Oger", "Hobbit"})[random(8)];

  SetProp(P_LONG,
    sprintf("Die Gestalt vor Dir traegt einen etwa knoechellangen, "
    "dunklen Wollumhang. Die grosse Kapuze und das schwarze Tuch "
    "um den Hals verbergen das darunter befindliche Gesicht, das Du "
    "so nur erahnen kannst. Der Statur nach zu schliessen handelt es sich "
    "um ein%s %s. Der Koerperhaltung und dem Gehabe nach zu Urteilen handelt "
    "es sich um einen erfahrene Waldlaeufer, der hier wohl die Aufsicht "
    "ueber die Schueler im Wald hat.", (QueryProp(P_GENDER)==MALE?"en":"e"), race));

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, (QueryProp(P_GENDER)==MALE?"Hueter":"Hueterin"));
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"waldlaeufer", "waldlaeuferin", "hueter", "hueterin", lower_case(race), "Messerexperte", "Bogenexperte", SUEDWALD_RANGER}));
  AddId( ({DEFAULT_RANGER_ID}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------
  
  create_default_npc(20+random(5)); 

  SetProp(P_HANDS, ({" mit blossen Haenden"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })  );

  SetProp(P_RACE, race);
  SetProp(P_SIZE, 175);
  SetProp(P_WEIGHT, 78);
  SetProp(P_ALIGN, 30);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" sagt: Ich nehme nichts von Dir.\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "tritt aus dem Wald");
  SetProp(P_MMSGOUT, "verschwindet im Wald");

  SetProp(P_MNPC_AREA, ({  ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "b8_d");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "beachtet Dich nicht.\n",
            "runzelt die Stirn.\n",
            "blickt Dich schweigend an.\n"}));


  SUID;
  if(!random(2)) {
    clone_object("/p/weapon/knife/jagdmesser")->move(TO);
    command("zuecke messer");
  } else {
    clone_object("/p/weapon/bow/langbogen")->move(TO);
    command("zuecke bogen");
    
  }

  clone_object("/p/armour/cloak/umhang")->move(TO);
  command("zieh alles an");

  call_out("get_ready", 0);

  SetProp(P_SPELLRATE, 25);
  if(objectp(present("bogen"))) {
    AddSpell(3, 300, 
      Name(WER) + " zielt mit einem raschen Schuss auf Dich.\n",
      Name(WER) + " zielt mit einem raschen Schuss auf @WEN.\n", 
      DT_PIERCE, ([SP_SHOW_DAMAGE: 1]));
  }

  if(objectp(present("dolch")) || objectp(present("messer"))) {
    AddSpell(3, 250,
      Name(WER) + " laeuft auf Dich zu, springt ab und stoesst zu.\n",
      Name(WER) + " laeuft auf @WEN zu, springt ab und stoesst zu.\n", 
      DT_PIERCE, ([SP_SHOW_DAMAGE: 1]));
  }

  AddDefaultSpell(2, 250, DS_PARALYZE,
    Name(WER) + " tritt Dich kraeftig.\n",
    Name(WER) + " tritt @WEN kraeftig.\n", 
    DT_SQUEEZE, 1);

//--Create Ende------------------------------------------------------------
}

public void get_ready() {
  object ob;
  int i;

  command_me("zuecke dolch");
  command_me("zuecke bogen");
  command_me("zieh alles an");

  if(objectp(ob=clone_object("/gilden/waldlaeufer/npc/pet")) ) {
    if(ob->second_create(TO, ({"fuchs", "wildschwein", "waldwolf", "steinadler"})[random(4)])) { 
      pet=ob; 
    } else {
      return;
    }

    ob->SetProp(P_LEVEL, QueryProp(P_LEVEL)/2); 
    ob->new_level();
    ob->order("hilf mir");
  }
  return;
}

public int Defend(int dam, string *dam_type_list, mixed spell, object enemy) {
  object trap;
  
  if(objectp(trap=present(SUEDWALD_TRAP, ENV(TO))) && !random(2)) {
    tell_room(ENV(TO), BS(Name(WER) + " loest eine Falle aus."));
    trap->trigger(enemy);
  }

  if(!random(20)) {
    tell_room(ENV(TO), BS(Name(WER) + " weicht geschickt aus."));
    return 0;
  }

  return ::Defend(dam, dam_type_list, spell, enemy);
}

public void init() {
  ::init();

  if(TP->id(SUEDWALD_RANGER)) {
    AddDefender(TP);
  }

  return;
}

public void InformDefend(object enemy) {
  Kill(enemy);
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "schuettelt verwundert den Kopf.",
        "schuettelt verwundert den Kopf.");
      break;

    case "aergerlich":
    case "fies":
      call_out("reaction", 0, TP,
        "knurrt: Leg Dich nicht mit mir an!",
        "knurrt: Leg Dich nicht mit mir an!");
        break;

    case "frech":
      call_out("reaction", 0, TP,
        "brummt Dich unwirsch an.",
        "brummt "+TP->name(WESSEN)+" unwirsch an.");
      break;

    case "albern":
    case "froh":
      call_out("reaction", 0, TP,
        "runzelt die Stirn.",
        "runzelt die Stirn.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Lass das lieber sein.",
        "sagt: Lass das lieber sein.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "beachtet Dich gar nicht.",
        "beachtet "+TP->name(WEN)+" gar nicht.");
      break;

    case "traurig":
    case "nett":
      call_out("reaction", 0, TP,
        "mustert Dich stumm.",
        "mustert "+TP->name(WEN)+" stumm.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

