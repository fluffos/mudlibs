inherit "std/mnpc";

#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine grosser Schroeter");
  SetProp(P_LONG, "Der grosse Schroeter ist eigentlich nichts anderes als ein menschengrosser Hirschkaefer.");
  SetProp(P_NAME, "Schroeter");
  SetProp(P_GENDER, MALE);
  AddId( ({"schroeter"}) );
  AddClass(({CL_ANIMAL}));

  create_default_npc(12 + random(4));
  SetProp(P_HANDS, ({" mit seinen Hoernern", QueryProp(P_HANDS)[1], DT_PIERCE}));
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 150+random(30));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 6);

  SetProp(P_MSGIN, "wandert herein");
  SetProp(P_MSGOUT, "wandert");  
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "b2_g");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "reagiert nicht.\n");
  SetProp(P_REJECT, ({ REJECT_DROP,  "Der Schroeter kann nichts tragen.\n"}));
}
