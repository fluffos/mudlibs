inherit "std/mnpc";

#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein scheuer Luchs");
  SetProp(P_LONG, "Der Luchs schleicht hier neugierig herum. Seine Ohrenpueschel sind staendig "
                  "wachsam aufgestellt und zucken bei jedem Geraeusch, dass du machst herum.");
  SetProp(P_NAME, "Luchs");
  SetProp(P_GENDER, MALE);
  AddId( ({"luchs", "FELL_WUSCHEL"}) );
  AddClass(({CL_ANIMAL}));

  create_default_npc(10+random(5));
  SetProp(P_HANDS, ({" mit seinen Krallen", QueryProp(P_HANDS)[1], DT_RIP}));
  SetProp(P_RACE, "Luchs");
  SetProp(P_SIZE, 50+random(40));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_WIMPY, 10 + random(40));

  SetProp(P_MSGIN, "huscht herein");
  SetProp(P_MSGOUT, "huscht");  
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "b2_g");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, " faucht.\n");
  SetProp(P_REJECT, ({ REJECT_DROP,  "Der Luchs kann nichts nehmen.\n"}));
  SetProp(P_DIE_MSG, " winselt auf und stirbt.\n");

  SetProp(P_SPELLRATE, 10);

  AddSpell(1, 250, 
    "Der Luchs kratzt dich mit seinen Klauen.\n",
    "Der Luchs kratzt @WEN mit seinen Klauen.\n",
    DT_RIP, ([SP_SHOW_DAMAGE: 1]));
}
