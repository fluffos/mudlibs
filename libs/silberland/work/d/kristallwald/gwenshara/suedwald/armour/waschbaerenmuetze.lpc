#include "../def.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Waschbaerenmuetze");
  SetProp(P_LONG,
    "Das ist die typische Muetze der Fallensteller und Wilderer. Sie wurde "
    "aus einem Waschbaeren gemacht und sein gestreifter schwanz baumelt "
    "wie ein Anhaenger davon herunter.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Waschbaerenmuetze");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"muetze", "waschbaerenmuetze"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_FUR );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 120);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 3);
}
