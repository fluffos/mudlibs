#include "../def.h"
#include "/gilden/waldlaeufer/def_extern.h"
#include <ansi.h>

inherit "std/armour";

public string _query_short() {
  string s;
  s = "Die Kapuze des gruenen Manns";

  if(!objectp(TP) || !living(TP)) return s;

  switch( TP->QueryProp(P_TTY) )
  {
    case "ansi" :  s = ANSI_GREEN + ANSI_BG_BLACK + s + ANSI_NORMAL; break;
    case "vt100" : s = ANSI_BOLD + s + ANSI_NORMAL; break;
  }
  
  return s;
}

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------
  SetProp(P_LONG,
    "Das ist die Kapuze des gruenen Manns. Sie besteht aus einem dicken "
    "gruenen Wollstoff und einem Band, das dein Gesicht verbirgt. Sie scheint "
    "von einer urtuemlichen Macht erfuellt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Kapuze des gruenen Manns");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kapuze", "kapuze des gruenen manns"}) );
  SetProp(P_INFO, "Die Kapuze des gruenen Manns kanalisiert die Macht der Flamme von Tethyr.");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 2500);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 8);

  SetProp(P_RANGER_BONUS, 10);
  SetProp(P_RANGER_SPELLCOST, 10);
}
