#include "../def.h"

inherit OBJ "std_trap";

public void create() {
    if(!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Eine Falle mit einem Giftpfeil");
    SetProp(P_LONG, "Diese Falle besteht im Grunde aus einer kleinen Armbrust, die im Unterholz "
                    "versteckt ist und mit einem kleinen Giftpfeil versehen ist. Wenn man an "
                    "einer Schnut zieht wird sie ausgeloest.");
    SetProp(P_NAME, "Giftpfeilfalle");
    SetProp(P_GENDER, FEMALE);
    AddId(({"pfeilfalle", "giftpfeilfalle", "pfeilfalle"}));
}

public void trigger(object enemy) {
    tell_room(ENV(TO), BS("Ein kleiner Giftpfeil trifft " + enemy->name(WEN, 1) + " ins Bein."),
              ({enemy}));
    tell_object(enemy, BS("EEin kleiner Giftpfeil trifft dich ins Bein!"));

    if(query_once_interactive(enemy)) {
        enemy->AddHp(-3);
        enemy->AddPoison(1);
    }
    else enemy->AddHp(-10);

    ::trigger(enemy);
    return;
}