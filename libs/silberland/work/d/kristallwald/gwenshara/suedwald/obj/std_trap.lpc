#include "../def.h"
#include "/p/daemon/skillmaster/skillmaster.h"

inherit "/std/thing";

object *discoveredBy;

public void create() {
    if(!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Eine Falle");
    SetProp(P_NAME, "Falle");
    SetProp(P_NOGET, 1);
    SetProp(P_NOBUY, 1);
    SetProp(P_VALUE, 0);

    AddId(SUEDWALD_TRAP);
    AddId("falle");

    discoveredBy = ({});

    AddCmd(({"loese", "loes"}), "cmd_ausloesen");
    AddCmd(({"entschaerfe", "entschaerf"}), "cmd_entschaerfen");
}

public int _query_invis() {
    if(member(discoveredBy, TP) < 0) return 1;
    return 0;
}

public void trigger(object target) {
    remove();
    return;
}

public int cmd_ausloesen(string str) {
    string what;
    object *enemies;

    if(member(discoveredBy, TP) < 0) return 0; // nicht entdeckt

    notify_fail("Was willst du ausloesen?\n");
    if(sscanf(str, "%s aus", what) != 1) return 0;
    if(!id(what)) return 0;

    notify_fail("Das geht nur im Kampf!\n");
    if(!sizeof(enemies=TP->PresentEnemies()) > 0) return 0;

    write("Du loest " + name(WEN) + " aus.\n");
    say(TPN + " loest " + name(WEN, 2) + " aus.\n");
    trigger(enemies[random(sizeof(enemies))]);
    return 1;
}

public int cmd_entschaerfen(string str) {
    object *enemies;
    string what;

    if(member(discoveredBy, TP) < 0) return 0; // nicht entdeckt

    notify_fail("Was willst du entschaerfen?\n");
    if(sscanf(str, "%s aus", what) != 1) return 0;
    if(!id(what)) return 0;

    write(BS("Du entschaerfst die Falle.\n"));
    say(BS(TPN + " entschaerft eine Falle.\n"));
    remove();
    return 1;
}

public void init() {
    ::init();

    if(TP->id("Spieler")) {
        call_out("sense", 0, TP);
    }

    return;
}

public void sense(object pl) {
    if(member(discoveredBy, pl) >= 0) return; // schon entdeckt
    if(pl->QueryProp(P_BLIND)) return; // blinde spieler sehen keine fallen

    if(SKILLMASTER->UseSkill(TP, SK_SENSE, 500-random(1000), 500-random(1000)) > 0) {
        discoveredBy += ({pl});
        tell_object(pl, BS("Du entdeckst "+name(WEN, 2)+" die hier errichtet wurde."));
    }

    return;
} 