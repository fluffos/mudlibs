#include "../def.h"
#define POTENTIAL_OLI_ROOMS ({ROOM "a7_b", ROOM "b4_a", ROOM "b5_d", ROOM "b2_l", ROOM "b6_l"})
#define CLOSE_TO_OLI_ROOMS ({\
    ({ROOM "a8_c", ROOM "a0_b", ROOM "a9_a"}),\
    ({ROOM "b3_b", ROOM "b5_b"}),\
    ({ROOM "b6_c", ROOM "b6_e", ROOM "grotte_1", ROOM "b7_d"}),\
    ({ROOM "b1_l", ROOM "b2_k"}),\
    ({ROOM "b5_k"})\
})
inherit "std/thing";

int oliRoom;
object oli;

public void create() {
  if (!is_clone(TO)) return;

  ::create();

  oliRoom = random(sizeof(POTENTIAL_OLI_ROOMS));

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Hundepfeife");
  SetProp(P_LONG,
    "Diese Hundepfeife ist aus einem Stueck Ochsenhorn gfertigt. Sie erzeugt "
    "Toene, die nur Hunde hoeren koennen. Du kannst sie blasen, um Oli, den "
    "vermissten Hund von Edila, anzulocken.");

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "Mit dieser Hundepfeife kannst du Oli anlocken, um ihn zu Edila zurueck zu bringen.");
  SetProp(P_NAME, "Hundepfeife");
  SetProp(P_GENDER, FEMALE);
  AddId(({"QUESTOBJ", "pfeife", "hundepfeife", "\nedila_hundepfeife"}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_HORN );
  SetProp(P_WEIGHT, 20);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

  AddCmd(({"blas", "blase"}), "cmd_blasen");
  AddCmd(({"lausch", "lausche"}), "cmd_lauschen");
}

public int cmd_blasen(string str) {
    string fn;

    if(TP->QueryQuest(DOGQUEST_NAME)) {
        write(BS("Hoppla! Du hast Edila ihren Hund doch schon zurueck gebracht."));
        remove();
        return 1;
    }

    notify_fail("Was moechtest du blasen?\n");
    if(!str || str == "") return 0;
    if(str != "hundepfeife" && str != "pfeife" && str != "in pfeife" && str != "in hundepfeife") return 0;

    if(objectp(find_living("suedwald_oli_"+getuid(TP)))) {
        write(BS("Du hast Oli schon gerufen. Er muss hier irgendwo rumlaufen. Finde ihn!"));
        return 1;
    }

    write(BS("Mit aller Kraft blaest du in die Hundepfeife.\n"));
    say(BS(TPN + " blaest mit aller Kraft in eine Hundepfeife.\n"));
    fn = file_name(ENV(TP));
    if(fn == POTENTIAL_OLI_ROOMS[oliRoom]) {
        oli = clone_object(NPC "oli");
        oli->move(ENV(TP), M_TPORT);
        write(BS("Du hoerst ein lautes Bellen aus dem Wald."));
        say(BS("Aus dem Wald ertoent lautes Bellen."));
        oli->SetOwner(TP);
    } else {
        write(BS("Nichts passiert."));
        say(BS("Nichts passiert"));
    }

    return 1;
}

public int cmd_lauschen(string str) {
    string fn;
    fn = file_name(ENV(TP));

    if(fn == POTENTIAL_OLI_ROOMS[oliRoom]) {
        write(BS("Du hoerst deutlich das Bellen eines Hundes. Oli muss hier sein!"));
        return 1;
    }

    if(member(CLOSE_TO_OLI_ROOMS[oliRoom], fn) >= 0) {
        write(BS("Du hoerst das Bellen eines Hundes in der Naehe. Du bist nicht ganz da, "
        "aber Oli kann nicht mehr weit weg sein!"));
        return 1;
    }

    return 0;
}

public int OliRoom() {
    return oliRoom;
}
