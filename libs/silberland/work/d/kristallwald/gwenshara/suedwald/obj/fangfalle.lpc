#include "../def.h"

inherit OBJ "std_trap";

public void create() {
    if(!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Eine Fangfalle");
    SetProp(P_LONG, "Die Fangfalle besteht aus einem einfachen Stock als Ausloeser und "
                    "mehreren spitzen Pfloecken auf einem Ring, der zuklappt, sobald man "
                    "sie ausloest. Die Pflocken bohren sich dann in das Opfer und fuegen "
                    "ihm schwere Schaden zu.");
    SetProp(P_NAME, "Fangfalle");
    SetProp(P_GENDER, FEMALE);
    AddId(({"fangfalle"}));
}

public void trigger(object enemy) {
    tell_room(ENV(TO), BS("Eine Fangfalle schnappt zu und spitze Pfloecke bohren sich in " + enemy->name(WEN, 1)),
              ({enemy}));
    tell_object(enemy, BS("Eine Fangfalle schnappt zu und spitze Pfloecke bohren sich in dich!"));

    if(query_once_interactive(enemy)) enemy->AddHp(-20);
    else enemy->AddHp(-50);

    ::trigger(enemy);
    return;
}