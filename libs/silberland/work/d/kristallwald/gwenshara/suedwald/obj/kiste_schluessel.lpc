#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleiner Schluessel");
  SetProp(P_LONG,
    "Dieser Schluessel ist relativ klein und unscheinbar. So einer, wie man "
    "ihn gelegentlich fuer Kleiderkisten verwendet.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schluessel");
  SetProp(P_GENDER, MALE);
  AddId(({"\nsuedwald_key_chest", "schluessel"}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_STEEL );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 01);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
}
