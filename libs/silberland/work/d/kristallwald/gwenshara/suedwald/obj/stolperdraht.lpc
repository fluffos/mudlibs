#include "../def.h"

inherit OBJ "std_trap";

public void create() {
    if(!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Ein Stolperseil");
    SetProp(P_LONG, "Hier wurde einfach ein duenes Seil gespannt, ueber das man stolpert, wenn "
                    "man unvorsichtig ist. Zum Ausloesen wird an einer kleinen Kordel gezogen, "
                    "die das Seil fest spannt.");
    SetProp(P_NAME, "Stolperfalle");
    SetProp(P_GENDER, FEMALE);
    AddId(({"stolperseil", "stolperfalle"}));
}

public void trigger(object enemy) {
    tell_room(ENV(TO), BS(enemy->name(WER, 1)+" stolpert ueber ein duennes Seil am Boden."),
              ({enemy}));
    tell_object(enemy, BS("Du stolperst ueber ein duennes Seil, das hier gespannt wurde!"));

    enemy->SetProp(P_DISABLE_ATTACK, 1+random(3));

    ::trigger(enemy);
    return;
}