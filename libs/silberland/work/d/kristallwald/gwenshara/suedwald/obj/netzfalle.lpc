#include "../def.h"

inherit OBJ "std_trap";

public void create() {
    if(!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Eine Netzfalle");
    SetProp(P_LONG, "Am Boden wurde ein Netz ausgelegt und mit Laub bedeckt. Wenn jemand "
                    "an einem Seil zieht um die Falle auszuloesen, dann ist das Opfer "
                    "im Netz gefangen!");
    SetProp(P_NAME, "Netzfalle");
    SetProp(P_GENDER, FEMALE);
    AddId(({"netzfalle"}));
}

public void trigger(object enemy) {
    tell_room(ENV(TO), BS(enemy->name(WER, 1)+" wird von einem Netz gefangen."),
              ({enemy}));
    tell_object(enemy, BS("Ploetzlich faellt ein Netz auf dich und faengt dich ein."));

    enemy->SetProp(P_PARALYZED, ([
        PARALYZE_TIME: 2+random(4),
        PARALYZE_MSG: "Du strampelst in einem Netz.\n",
        PARALYZE_MSG_OTHER: "%s versucht sich aus dem Netz zu befreien.\n",
        PARALYZE_END: "Endlich hast du dich aus dem Netz befreit!\n",
        PARALYZE_END_OTHER: "%s hat sich aus dem Netz befreit.\n"
    ]));

    ::trigger(enemy);
    return;
}