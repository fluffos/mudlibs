inherit "std/food";     

#include <properties.h>
#include <food.h>       
#include "../def.h"


public void create() {
  if (!is_clone(this_object()))         
    return;                             

  ::create();

  switch(random(3)) {
    case 0: 
        AddId( ({ "wurst", "rauchwurst" }) );
        SetProp(P_GENDER, FEMALE);
        SetProp(P_NAME, "Rauchwurst");
        SetProp(P_SHORT, "Eine leckere Rauchwurst");
        SetProp(P_LONG, "Eine gut geraeucherte Wildwurst. Riecht koestlich.");
        break;
    case 1:
        AddId( ({ "schinken", "Raeucherschinken" }) );
        SetProp(P_GENDER, MALE);
        SetProp(P_NAME, "Raeucherschinken");
        SetProp(P_SHORT, "Ein Raeucherschinken");
        SetProp(P_LONG, "Ein saftiges Stueck Raeucherschinken.");
        break;
    case 2:
        AddId( ({ "fleisch", "raeucherfleisch" }) );
        SetProp(P_GENDER, NEUTER);
        SetProp(P_NAME, "Raeucherfleisch");
        SetProp(P_SHORT, "Ein Streifen Raeucherfleisch");
        SetProp(P_LONG, "Du haeltst einen Streifen geraeuchertes Wildbret in der Hand. Direkt bereit fuer den Verzehr.");
        break;
  }

  SetProp(P_WEIGHT, 100);       
  SetProp(P_VALUE, 20);         
  SetProp(P_MATERIAL, ([ MAT_FLESH : 100 ]) );      


  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 10+random(10),10+random(10) }), 
         F_SOAK    : 20,         
         F_DRINK   : 0,         
         F_ALCOHOL : 0,         
         F_POISON  : 0,        
         F_MSG     : "Mh. Mit gutem Raucharoma. Hier war ein Experte am Werk!\n",
         F_MSG_ROOM: "verzehrt genuesslich eine geraeucherte Leckerei.\n",
         F_VERB    : "essen"    
      ]) );                     
}
