#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein grossbartiger Eisenschluessel");
  SetProp(P_LONG,
    "Dieser Schluessel ist schwer und gross. Mit seinem riesigen Bart ist "
    "er wohl fuer ein starkes Vorhaengeschloss gedacht.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Eisenschluessel");
  SetProp(P_GENDER, MALE);
  AddId(({"\nsuedwald_key_fort", "schluessel", "eisenschluessel"}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_STEEL );
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 01);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
}
