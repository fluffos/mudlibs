#include "../def.h"

inherit "std/armour";

//--Create-----------------------------------------------------------------

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Cheraanischild");
  SetProp(P_LONG,
    "Dieser Schild wurde von den Cheraani hergestellt. Er besteht aus "
    "einem sehr harten und festen Material, das vollstaendig mit Leder "
    "ueberzogen wurde. An der Innenseite sind zwei kleine Schlaufen "
    "befestigt, so dass der Schild sicher in der Hand liegt. Die "
    "Aussenseite ist mit feinen Stickereien huebsch verziert.");

  AddDetail( ({ "cheraani" }),
    "Die Cheraani haben diesen Schild angefertigt.");

  AddDetail( ({ "material" }),
    "Da es vollstaendig mit Leder ueberzogen ist, kannst Du nicht genau "
    "sagen, um welches Material es sich handelt. Es macht jedoch einen "
    "sehr festen und stabilen Eindruck.");

  AddDetail( ({ "eindruck" }),
    "Der Schild sieht sehr stabil aus.");

  AddDetail( ({ "leder" }),
    "Das Leder hat eine seltsame blaue Faerbung.");

  AddDetail( ({ "faerbung" }),
    "Das Leder wurde blau eingefaerbt.");

  AddDetail( ({ "innenseite" }),
    "An der Innenseite des Schildes sind zwei kleine Schlaufen befestigt, "
    "durch die man ihn sicher mit einer Hand tragen kann.");

  AddDetail( ({ "schlaufen", "hand" }),
    "Im Kampf steckt man eine Hand durch die beiden Schlaufen und haelt "
    "ihn so sicher in der Hand.");

  AddDetail( ({ "kampf", "schutz" }),
    "Der Schild stellt einen guten Schutz im Kampf dar.");

  AddDetail( ({ "aussenseite", "stickereien" }),
    "Feine Stickereien zieren die Aussenseite des Schildes.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Cheraanischild");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "schild", "cheraanischild" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "Dieser Schild wurde in vollkommender Kunstfertigkeit "
  +"von den Cheraani hergestellt.");
  SetProp(P_MATERIAL, ([ MAT_LEATHER: 35, MAT_IVORY: 65 ]));
  SetProp(P_WEIGHT, 1200+random(450));
  SetProp(P_VALUE, 800+random(600));

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_SHIELD);
  SetProp(P_AC, 20+random(5));
  SetProp(P_QUALITY_DECAY, 100+random(20));

//--Create Ende------------------------------------------------------------

}
