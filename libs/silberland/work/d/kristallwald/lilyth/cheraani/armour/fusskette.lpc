#include "../def.h"

inherit "std/armour";

//--Create-----------------------------------------------------------------

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein silbernes Fusskettchen");
  SetProp(P_LONG,
    "Dieses kleine Fusskettchen wurde wahrlich meisterhaft gefertigt. "
    "An den einzelnen Gliedern der schmalen, zweireihigen Silberkette "
    "wurden winzige Kristalle in Form von kleinen Sternchen befestigt, "
    "die ein helles, mal roetliches, mal blaugruenes Schimmern "
    "ausstrahlen.");

  AddDetail( ({ "glieder", "glied", "gliedern" }),
    "An jedem einzelnen Glied der Kette wurden winzige, schimmernde "
    "Kristalle befestigt.");

  AddDetail( ({ "silberkette", "silber" }),
    "Die schmale, zweireihige Kette wurde aus reinstem Silber "
    "handgefertigt und sieht sehr edel aus.");

  AddDetail( ({ "kristall", "kristalle" }),
    "Die Kristalle schimmern hell und klar und geben bei jedem Schritt "
    "ein kaum hoerbares Klirren von sich.");

  AddDetail( ({ "schritt" }),
    "Vorsichtig machst Du einen Schritt.\n *klirr*");

  AddDetail( ({ "klirren" }),
    "Es ist kaum zu hoeren.");

  AddDetail( ({ "form", "sternchen", "stern", "sterne", "himmel" }),
    "Die Kristalle haben die Form von winzigkleinen Sternchen, die so "
    "wirklichkeitsgetreu aussehen, als seien sie geradewegs vom Himmel "
    "herabgefallen.");

  AddDetail( ({ "schimmern" }),
    "Von den Kristallen geht ein helles, mal roetliches, mal "
    "blaeulich-gruenes Schimmern aus.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Fusskettchen");
  SetProp(P_NAME_ADJ, "silbern");
  AddAdjective( ({ "silbernes", "silbernen", "silbernem" } ));
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "fusskettchen", "kettchen", "fusskette", "kette" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "Es ist wirklich ein edles Schmuckstueck.\nDie Cheraani "
  "haben es hergestellt.");
  SetProp(P_MATERIAL, ([ MAT_SILVER: 80, MAT_CRYSTAL: 20 ]));
  SetProp(P_WEIGHT, 170);
  SetProp(P_VALUE, 125);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_QUALITY_DECAY, 100);

//--Create Ende------------------------------------------------------------

}
