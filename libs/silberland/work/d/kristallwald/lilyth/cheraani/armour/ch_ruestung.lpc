#include "../def.h"

inherit "std/armour";

//--Create-----------------------------------------------------------------

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Cheraaniruestung");
  SetProp(P_LONG,
    "Diese Ruestung zeugt von dem grossartigen Koennen und der "
    "Kunstfertigkeit der Cheraani. Sie besteht fast vollstaendig aus "
    "sandfarbenem, ungewoehnlich weichgegerbten Leder und ist mit feinen "
    "Stickereien und Perlen verziert worden. Zusaetzlich staerken kleine, "
    "sorgsam geschliffene Elfenbeinplaettchen die Vorder- und Rueckseite "
    "der Ruestung, so dass sie auch im Kampf einen sehr guten Schutz "
    "darstellt.");

  AddDetail( ({ "koennen", "kunstfertigkeit" }),
    "Die Ruestung wurde wirklich meisterhaft gearbeitet.");

  AddDetail( ({ "cheraani" }),
    "Sie haben diese Ruestung angefertigt.");

  AddDetail( ({ "leder" }),
    "Das Leder ist ungewoehnlich weich und anschmiegsam und hat eine sehr "
    "schoene, sandartige Faerbung.");

  AddDetail( ({ "faerbung" }),
    "Man koennte es auch als eine Mischung zwischen Hellbraun und Beige "
    "bezeichnen.");

  AddDetail( ({ "farbe", "mischung", "hellbraun", "beige" }),
    "Die Farbe des Leders ist eine Mischung zwischen Hellbraun und Beige.");

  AddDetail( ({ "stickerei", "stickereien", "perlen" }),
    "Die Ruestung ist mit feinen Stickereien und winzigen Perlen verziert.");

  AddDetail( ({ "elfenbein", "elfenbeinplaettchen", "plaettchen" }),
    "Sorgsam geschliffene Plaettchen aus Elfenbein verstaerken die "
    "Ruestung an der Vorder- und Rueckseite.");

  AddDetail( ({ "vorderseite", "rueckseite" }),
    "Sie ist durch kleine Elfenbeinplaettchen verstaerkt worden.");

  AddDetail( ({ "kampf", "schutz", "verletzungen" }),
    "Die Ruestung stellt im Kampf einen guten Schutz vor Verletzungen dar.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Cheraaniruestung");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "ruestung", "cheraaniruestung" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "Diese Ruestung wurde in vollkommender Kunstfertigkeit "
  +"von den Cheraani hergestellt.");
  SetProp(P_MATERIAL, ([ MAT_LEATHER: 70, MAT_IVORY: 30 ]));
  SetProp(P_WEIGHT, 1500+random(1000));
  SetProp(P_VALUE, 800+random(700));

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 22+random(10));
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_MAX_SIZE: 160 ]) );

//--Create Ende------------------------------------------------------------

}
