#include "../def.h"

inherit "std/armour";

//--Create-----------------------------------------------------------------

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Cheraaniamulett");
  SetProp(P_LONG,
    "Bei diesem Amulett handelt es sich um ein magisches Artefakt der "
    "Cheraani-Aeltesten. Es besteht aus einer kleinen, runden Platte aus "
    "Elfenbein, die mit seltsamen Symbolen verziert und mit einem "
    "hellblauen Lederband verbunden ist. Trotz des recht schlichten "
    "Aeusseren dieser Amulette erzaehlt man sich, dass manchen von ihnen "
    "eine gewisse Art von Magie innewohnt.");

  AddDetail( ({ "artefakt", "cheraani", "cheraani-aelteste", "aelteste",
  "cheraani-aeltesten", "aeltesten" }),
    "Dieses Amulett ist ein magisches Artefakt der Cheraani-Aeltesten.");

  AddDetail( ({ "platte", "elfenbeinplatte" }),
    "Die kleine, runde Platte aus Elfenbein wurde an einem hellblauen "
    "ledernen Band befestigt. Sie ist mit seltsamen Symbolen verziert.");

  AddDetail( ({ "elfenbein" }),
    "Die Platte besteht aus Elfenbein.");

  AddDetail( ({ "symbole" }),
    "Sie sehen irgendwie magisch aus, doch mehr kannst Du leider nicht "
    "erkennen.");

  AddDetail( ({ "lederband", "band" }),
    "Ein schmales Band aus hellblau gefaerbtem Leder wurde an der "
    "Elfenbeinplatte befestigt.");

  AddDetail( ({ "leder" }),
    "Es ist hellblau und fuehlt sich sehr weich und anschmiegsam an.");

  AddDetail( ({ "aeusseres", "aeusseren" }),
    "Eigentlich sieht das Amulett recht schlicht und einfach aus.");

  AddDetail( ({ "art", "magie" }),
    "Wer weiss, vielleicht bietet es ja einen gewissen Schutz vor "
    "irgendetwas.");

  AddDetail( ({ "schutz" }),
    "Man kann nie wissen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Cheraaniamulett");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "amulett", "cheraaniamulett" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "Dieses Amulett wurde in vollkommender Kunstfertigkeit "
  +"von den Cheraani hergestellt.");
  SetProp(P_MATERIAL, ([ MAT_LEATHER: 70, MAT_IVORY: 30 ]));
  SetProp(P_WEIGHT, 250+random(150));
  SetProp(P_VALUE, 200+random(150));

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_AMULET);
  SetProp(P_AC, 1+random(3));
  SetProp(P_QUALITY_DECAY, 100);
  
  switch(random(100))
  {
    case 0..10:
      SetProp(P_DAM_PROTECTION, DT_FIRE);
      break;
    case 11..20:
      SetProp(P_DAM_PROTECTION, DT_COLD);
      break;
    case 21..30:
      SetProp(P_DAM_PROTECTION, DT_WATER);
      break;
    case 31..40:
      SetProp(P_DAM_PROTECTION, DT_TERROR);
      break;
    case 41..100:
      break;
  }

//--Create Ende------------------------------------------------------------

}
