#include "../def.h"

inherit "std/armour";

//--Create-----------------------------------------------------------------

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Cheraanirobe");
  SetProp(P_LONG,
    "Dies ist eine Robe, wie sie normalerweise nur die Aeltesten der "
    "Cheraani tragen. Sie besteht aus einem sehr feinen, silbrig "
    "schimmernden Stoff und hat eine weite Kapuze, die weich bis auf den "
    "Ruecken hinabfaellt. Seltsame Symbole sind auf dem Stoff eingenaeht.");

  AddDetail( ({ "aelteste", "aeltesten", "cheraani", "cheraani-aelteste",
  "cheraani-aeltesten" }),
    "Nur die Cheraani-Aeltesten tragen solche Roben.");

  AddDetail( ({ "stoff" }),
    "Du glaubst, dass es sich bei dem Stoff um Seide handelt, bist Dir "
    "aber nicht ganz sicher.");

  AddDetail( ({ "seide", "fall" }),
    "Auf jeden Fall sieht es Seide ziemlich aehnlich.");

  AddDetail( ({ "kapuze", "ruecken" }),
    "Die weite Kapuze faellt bis auf den Ruecken hinab.");

  AddDetail( ({ "symbole" }),
    "Die Robe ist mit seltsamen Symbolen verziert.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Cheraanirobe");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "robe", "cheraanirobe" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "Diese Robe wurde in vollkommender Kunstfertigkeit "
  +"von den Cheraani hergestellt.");
  SetProp(P_MATERIAL, ([MAT_SILK: 70, MAT_MISC_MAGIC: 30]) );
  SetProp(P_WEIGHT, 350+random(300));
  SetProp(P_VALUE, 600+random(400));

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 7+random(3));
  SetProp(P_QUALITY_DECAY, 100);

//--Create Ende------------------------------------------------------------

}
