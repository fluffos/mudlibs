#include "../def.h"

inherit "std/weapon";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleines Schnitzmesser");
  SetProp(P_LONG,
    "Das kleine Schnitzmesser hat eine kurze, schon etwas abgestumpfte "
    "Klinge und einen schmalen, einfachen Holzgriff. Es sieht nicht "
    "sonderlich beeindruckend aus.");

  AddDetail( ({ "klinge" }),
    "Sie ist schon etwas abgestumpft.");

  AddDetail( ({ "holzgriff", "griff" }),
    "Der schmale Griff des Messers besteht aus einfachem Holz.");

  AddDetail( ({ "holz" }),
    "Einfaches, normales Holz.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schnitzmesser");
  SetProp(P_NAME_ADJ, "klein");
  AddAdjective( ({ "kleines", "kleinen", "kleinem" }) );
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "messer", "schnitzmesser" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "Sie wurde in vollkommender Kunstfertigkeit "
  +"von den Cheraani hergestellt.");
  SetProp(P_MATERIAL, ([MAT_MISC_METAL: 60, MAT_MISC_WOOD: 50]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_SIZE, 14);
  SetProp(P_VALUE, 150);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 50);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 1);

//--Create Ende------------------------------------------------------------

}
