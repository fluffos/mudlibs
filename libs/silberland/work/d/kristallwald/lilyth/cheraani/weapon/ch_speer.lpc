#include "../def.h"

inherit "std/weapon";

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Cheraanispeer");
  SetProp(P_LONG,
    "Dieser kurze Speer ist ein wahres Meisterstueck. Er hat eine schmale "
    "Klinge, die gerade mal so dick ist wie der Finger einer Fee und sein "
    "Griff ist mit weichem, blaugefaerbten Leder umwickelt, das angenehm "
    "in der Hand liegt. Aufgrund der geringen Laenge und dem kaum "
    "spuerbaren Gewicht kann dieser Speer problemlos mit einer Hand "
    "gezueckt werden.");

  AddDetail( ({ "meisterstueck" }),
    "Der Speer ist ein wahres Meisterstueck.");

  AddDetail( ({ "cheraani" }),
    "Die Cheraani haben diesen Speer angefertigt.");

  AddDetail( ({ "klinge" }),
    "Die glaenzende Klinge ist sehr schmal und duenn.");

  AddDetail( ({ "finger", "fee" }),
    "Die Klinge ist in etwa so dick wie der Finger einer Fee.");

  AddDetail( ({ "leder" }),
    "Weiches, anschmiegsames Leder umgibt den Speergriff. Es hat eine "
    "blaue, seltsam schimmernde Farbe.");

  AddDetail( ({ "farbe" }),
    "Das Leder schimmert blau.");

  AddDetail( ({ "griff", "speergriff" }),
    "Der Griff ist etwa doppelt so lang wie die Klinge und ist mit weichem "
    "Leder umwickelt.");

  AddDetail( ({ "hand" }),
    "Der Speer liegt dank seinem ausbalancierten Gewicht und dem mit Leder "
    "umwickelten Griff gut in der Hand.");

  AddDetail( ({ "laenge" }),
    "Der Speer ist nur etwa halb so lang wie die Speere, die die Menschen "
    "normalerweise benutzen.");

  AddDetail( ({ "menschen" }),
    "Auch Menschen greifen haeufig zu Speeren, um sich zu verteidigen.");

  AddDetail( ({ "gewicht" }),
    "Der Speer ist ungewoehnlich leicht.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Cheraanispeer");
  SetProp(P_GENDER, MALE);
  AddId( ({ "speer", "cheraanispeer" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "Er wurde in vollkommender Kunstfertigkeit "
  +"von den Cheraani hergestellt.");
  SetProp(P_MATERIAL, ([MAT_MISC_METAL: 70, MAT_IVORY: 10, MAT_LEATHER: 20]) );
  SetProp(P_WEIGHT, 1400);
  SetProp(P_SIZE, 75);
  SetProp(P_VALUE, 950);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_WC, 170);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 1);

//--Create Ende------------------------------------------------------------

}
