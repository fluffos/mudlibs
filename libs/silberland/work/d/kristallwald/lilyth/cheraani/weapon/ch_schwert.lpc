#include "../def.h"

inherit "std/weapon";

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Cheraanischwert");
  SetProp(P_LONG,
    "Dieses Schwert wurde in jahrelanger Arbeit von den Cheraani aus den "
    "edelsten Materialien angefertigt. Seine Klinge ist aeusserst scharf "
    "und ungewoehnlich lang. Seltsame Symbole sind in sie eingraviert. "
    "Der schmale Griff des Schwertes ist mit weichem Leder umwickelt, so "
    "dass es angenehm in der Hand liegt.");

  AddDetail( ({ "arbeit", "jahre" }),
    "Es hat sicherlich einige Jahre gedauert, dieses Schwert anzufertigen.");

  AddDetail( ({ "cheraani" }),
    "Dieses Schwert wurde von den Cheraani angefertigt.");

  AddDetail( ({ "materialien" }),
    "Das Schwert wurde aus den edelsten Metallen geschmiedet und der mit "
    "weichem Leder umwickelte Griff besteht aus reinem Elfenbein.");

  AddDetail( ({ "metall", "metalle" }),
    "Nur die edelsten Metalle wurden fuer das Schwert verwendet.");

  AddDetail( ({ "klinge" }),
    "Sie ist lang und scharf und vermag selbst dem groessten und "
    "staerksten Wesen etwas entgegenzusetzen.");

  AddDetail( ({ "symbole" }),
    "Seltsame, Dir fremde Symbole sind in die Klinge eingraviert.");

  AddDetail( ({ "griff", "schwertgriff" }),
    "Er ist mit weichem Leder umwickelt und liegt daher angenehm in der "
    "Hand.");

  AddDetail( ({ "elfenbein" }),
    "Der Schwertgriff besteht aus Elfenbein.");

  AddDetail( ({ "leder" }),
    "Weiches Leder umgibt den Griff des Schwertes. Es hat eine seltsame, "
    "blaeulich schimmernde Farbe.");

  AddDetail( ({ "farbe" }),
    "Das Leder wurde blau eingefaerbt.");

  AddDetail( ({ "hand" }),
    "Das Schwert liegt angenehm in der Hand.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Cheraanischwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "schwert", "cheraanischwert" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "Es wurde in vollkommender Kunstfertigkeit "
  +"von den Cheraani hergestellt.");
  SetProp(P_MATERIAL, ([MAT_MISC_METAL: 70, MAT_IVORY: 10, MAT_LEATHER: 20]) );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_SIZE, 47);
  SetProp(P_VALUE, 1650);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC, 160+random(30));
  SetProp(P_WC_FIX, 30+random(10));
  SetProp(P_DAM_TYPE, DT_SLASH);
  SetProp(P_NR_HANDS, 1);

//--Create Ende------------------------------------------------------------

}
