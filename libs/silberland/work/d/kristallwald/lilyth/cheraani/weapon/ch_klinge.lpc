#include "../def.h"

inherit "std/weapon";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Cheraaniklinge");
  SetProp(P_LONG,
    "Diese kurze, dolchartige Klinge wurde von den Cheraani angefertigt. "
    "Sie ist eine sehr gute Waffe bei Kaempfen auf kurzer Distanz und wird "
    "daher haeufig von den Cheraani-Waechtern bei der Ausfuehrung ihres "
    "Dienstes verwendet. Ihr Griff ist mit weichem Leder umwickelt und "
    "liegt so angenehm in der Hand.");

  AddDetail( ({ "cheraani" }),
    "Sie haben diese Klinge angefertigt.");

  AddDetail( ({ "waffe" }),
    "Diese Klinge ist eine sehr gute Waffe.");

  AddDetail( ({ "kaempfe", "distanz" }),
    "Fuer Kaempfe auf kurzer Distanz ist die Klinge hervorragend geeignet.");

  AddDetail( ({ "waechter", "cheraani-waechter" }),
    "Sie verwenden diese Klingen haeufig bei der Ausfuehrung ihres "
    "Dienstes.");

  AddDetail( ({ "ausfuehrung", "dienst" }),
    "Wie ihr Name schon sagt, sind sie die Waechter der Cheraani.");

  AddDetail( ({ "name" }),
    "Cheraani-Waechter.");

  AddDetail( ({ "griff" }),
    "Der Griff der Klinge ist mit weichem Leder umwickelt.");

  AddDetail( ({ "leder" }),
    "Es ist sehr weich und anschmiegsam.");

  AddDetail( ({ "hand" }),
    "Das weiche Leder, mit dem der Griff umwickelt ist, umschmeichelt "
    "Deine Hand.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Cheraaniklinge");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "klinge", "cheraaniklinge" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "Sie wurde in vollkommender Kunstfertigkeit "
  +"von den Cheraani hergestellt.");
  SetProp(P_MATERIAL, ([MAT_MISC_METAL: 70, MAT_IVORY: 10, MAT_LEATHER: 20]) );
  SetProp(P_WEIGHT, 350);
  SetProp(P_SIZE, 27);
  SetProp(P_VALUE, 350);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 85+random(15));
  SetProp(P_WC_FIX, 50+random(20));
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 1);

  SetProp(P_WC_BONUS, (["Messerkaempfer":50, "Messerexperte":120,
  "Messermeister":180 ]) );

//--Create Ende------------------------------------------------------------

}
