#include "../def.h"

inherit "/d/kristallwald/lilyth/cheraani/npc/std_npc_cheraani";

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ichezel, die Cheraani-Aelteste");
  SetProp(P_LONG,
    "Ichezel ist die aelteste und weiseste der drei Cheraani-Aeltesten. "
    "Ihr fast weisses Fell ist von zahlreichen silbergrauen Straehnen "
    "durchzogen. Frueher war sie die Heilerin der Cheraani, bis sie sich "
    "schliesslich ganz dem Studium der Magie zuwandte und ihre fruehere "
    "Aufgabe an ihre Tochter Leya uebertrug.");
    
  AddDetail( ({ "fell" }),
    "Ihr Fell hat eine ungewoehnlich helle, fast weisse Farbe. An den "
    "silbergrauen Straehnen, von denen es durchzogen ist, kannst Du ihr "
    "hohes Alter erkennen.");

  AddDetail( ({ "farbe" }),
    "Es ist fast weiss.");

  AddDetail( ({ "straehne", "straehnen" }),
    "Silbrig glaenzende Straehnen durchziehen das gesamte Fell.");

  AddDetail( ({ "alter" }),
    "Ichezel muss bereits sehr, sehr alt sein.");

  AddDetail( ({ "heilerin" }),
    "Frueher war Ichezel die Heilerin der Cheraani.");

  AddDetail( ({ "studium", "magie" }),
    "Sie studiert die Magie und ihr Vorkommen in allen nur denkbaren "
    "Formen.");

  AddDetail( ({ "vorkommen", "form", "formen" }),
    "Nicht immer offenbart sich die Magie in ihrer einfachsten Form.");

  AddDetail( ({ "aufgabe" }),
    "Leya, ihre Tochter, hat diese Aufgabe inzwischen uebernommen.");

  AddDetail( ({ "leya", "tochter" }),
    "Leya ist ihre Tochter.");

  AddDetail( ({ "gabe" }),
    "Die Faehigkeit, andere heilen zu koennen, ist eine besondere Gabe.");

  AddDetail( ({ "faehigkeit" }),
    "Nicht viele besitzen diese Faehigkeit.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Ichezel");
  SetProp(P_GENDER, FEMALE);
  AddId(({"ichezel", "aelteste", "cheraani-aelteste"}));

//--Eigenschaften----------------------------------------------------------

  create_default_cheraani(23);                     //Level 6-9:   Kinder
                                                   //Level 10-15: Erwachsene
  SetProp(P_HANDS,                                 //Level 16-20: Wachen
  ({ " mit Cheraanimagie", 230, DT_MAGIC }) );     //Level 21+:   Aelteste

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" sagt freundlich: Das behalte lieber selbst.\n" }) );

//--Bewegungen-------------------------------------------------------------
  
  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "betritt den Versammlungsraum");
  SetProp(P_MMSGOUT, "verlaesst den Versammlungsraum");

//--Tod--------------------------------------------------------------------

  SetProp(P_KILL_NAME, "Ichezel, die Cheraani-Aelteste");
  SetProp(P_MURDER_MSG, "Meine Zeit ist also gekommen...");

//--Infos------------------------------------------------------------------

  AddLibrary("/d/kristallwald/lilyth/cheraani/npc/cheraani.lib", 4);

  AddInfo(DEFAULT_INFO,
         ({ "blickt Dich schweigend an.\n",
            "schuettelt weise mit dem Kopf.\n",
            "sagt: Das kann ich Dir leider nicht beantworten.\n"}));

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 55);

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" blickt Dich freundlich an.\n",
    Name(WER, 1)+" fragt Dich: Kann ich Dir helfen?\n",
    Name(WER, 1)+" ordnet ein paar Schriftrollen.\n",
    Name(WER, 1)+" liest in einer Schriftrolle.\n",
    Name(WER, 1)+" gruebelt vor sich hin.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" murmelt einen Zauberspruch.\n",
    Name(WER, 1)+" seufzt: Warum tust Du das?\n",
    Name(WER, 1)+" sammelt ihre Magie.\n",
    Name(WER, 1)+" konzentriert sich kurz.\n" }));

//--Ausruestung------------------------------------------------------------

  SUID;

  CLONEME(ARMOUR "ch_amulett");
  CLONEME(ARMOUR "ch_robe");
  command("trage alles");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt die Cheraani-Aelteste ("+Name(WER,1)+").\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": Eine der Cheraani-Aeltesten ("+Name(WER,1)+") hat gerade "
      +CAP(getuid(player))+" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  object wache;
  object room;

  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "laechelt Dir beruhigend zu.",
        "laechelt "+TP->name(WEM)+" beruhigend zu.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "warnt Dich: Hoer sofort damit auf!",
        "warnt "+TP->name(WEN)+": Hoer sofort damit auf!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "laechelt Dir freundlich zu.",
        "laechelt "+TP->name(WEM)+" freundlich zu.");
      break;

    case "fies":
      call_other(ROOM "eb2_c1_weg", "???");
      call_other(ROOM "eb2_c3_weg", "???");
      
      room = find_object(ROOM "eb2_c1_weg");
      wache = present("cheraaniwaechter", room);
      
      if(wache && !wache->InFight())
      {
         wache->hilfe(TP);
         return;
      }
      
      room = find_object(ROOM "eb2_c3_weg");
      wache = present("cheraaniwaechter", room);
      
      if(wache && !wache->InFight())
      {
         wache->hilfe(TP);
         return;
      }
      
      call_out("reaction", 0, TP,
        "sagt: He, lass das!",
        "sagt: He, lass das!");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "runzelt die Stirn.",
        "runzelt die Stirn.");
      break;

    case "froh":
    case "nett":
      call_out("reaction", 0, TP,
        "blickt Dich freundlich an.",
        "blickt "+TP->name(WEN)+" freundlich an.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "mustert Dich erstaunt und Du senkst erroetend den Blick.",
        "mustert "+TP->name(WEN)+" erstaunt.\n"+TP->name(WER)+" erroetet.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "fragt Dich freundlich: Kann ich Dir helfen?",
        "fragt "+TP->name(WEN)+" freundlich: Kann ich Dir helfen?");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        "troestet "+TP->name(WEN)+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
