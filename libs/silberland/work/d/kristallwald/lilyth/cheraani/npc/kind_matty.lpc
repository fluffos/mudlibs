#include "../def.h"

inherit "/d/kristallwald/lilyth/cheraani/npc/std_npc_cheraani";

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Matty, der Cheraanijunge");
  SetProp(P_LONG,
    "Matty ist das juengste der Cheraanikinder. Meistens spielt er mit "
    "den Zwillingen Yala und Yole, da seine Mutter Tamit ihn nicht so "
    "gerne alleine herumstreifen laesst. Mit seinen grossen dunklen "
    "Augen, dem noch voellig sandfarbenen Fell und den aengstlich an die "
    "Brust gepressten Pfoten sieht er wirklich knuffig aus.");

  AddDetail( ({ "zwillinge" }),
    "Die Zwillinge sind haeufig bei Matty zu finden.");

  AddDetail( ({ "mutter", "tamit" }),
    "Tamit ist Mattys Mutter.");

  AddDetail( ({ "augen" }),
    "Mit seinen grossen, dunklen Augen starrt er Dich ehrfurchtsvoll an.");

  AddDetail( ({ "fell" }),
    "Mattys Fell ist noch voellig sandfarben. Erst mit der Zeit wird es "
    "ein wenig nachdunkeln und ein intensiveres Braun annehmen.");

  AddDetail( ({ "zeit" }),
    "Erst mit der Zeit bekommen die Cheraani ihre typische braune "
    "Fellfarbe.");

  AddDetail( ({ "fellfarbe", "farbe", "sand", "braun" }),
    "Bei der Geburt hat das Fell der Cheraani die Farbe von hellem Sand, "
    "erst spaeter dunkelt es ein wenig nach und wird zu einem satten "
    "Braun.");

  AddDetail( ({ "brust", "pfoten", "pfote" }),
    "Seine kleinen Pfoten haelt er fest an sich gepresst.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Matty");
  SetProp(P_GENDER, MALE);
  AddId(({"matty", "cheraanijunge", "junge"}));

//--Eigenschaften----------------------------------------------------------

  create_default_cheraani(6);                      //Level 6-9:   Kinder
                                                   //Level 10-15: Erwachsene
  SetProp(P_HANDS,                                 //Level 16-20: Wachen
  ({ " mit schwacher Magie", 60, DT_MAGIC }) );    //Level 21+:   Aelteste

  SetProp(P_SIZE, 60);
  SetProp(P_WEIGHT, 20000);

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "laeuft herein");
  SetProp(P_MSGOUT, "laeuft");
  SetProp(P_MMSGIN, "kommt hereingelaufen");
  SetProp(P_MMSGOUT, "laeuft schnell nach Hause");

  SetProp(P_MNPC_AREA, ({ ROOM "eb1_f2_weg", ROOM "eb1_f4_weg",
                          ROOM "eb1_g1_weg", ROOM "eb1_g3_weg", 
                          ROOM "eb1_g4_weg", ROOM "eb1_h2_weg", 
                          ROOM "eb1_h6_weg", ROOM "eb1_i5_weg", 
                          ROOM "eb1_j4_weg", ROOM "eb1_j6_weg", 
                          ROOM "eb1_k5_weg", ROOM "eb1_h5_eingang" }) );

  SetProp(P_MNPC_WAIT, ({ 30, 40, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS + MOV_INDOORS);
  SetProp(P_MNPC_DEFAULTROOM, ROOM "eb1_f2_weg");

//--Tod--------------------------------------------------------------------

  SetProp(P_KILL_NAME, "Matty");
  SetProp(P_MURDER_MSG, "Maaaami!!!");

//--Infos------------------------------------------------------------------

  AddLibrary("/d/kristallwald/lilyth/cheraani/npc/cheraani.lib", 1);

  AddInfo(DEFAULT_INFO,
         ({ "blickt Dich mit grossen Augen an.\n",
            "scheint sich vor Dir zu fuerchten.\n",
            "sagt aengstlich: Das weiss ich nicht, dafuer bin ich noch zu klein.\n"}));

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 40);

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" starrt Dich ehrfurchtsvoll an.\n",
    Name(WER, 1)+" spielt mit einem kleinen Stein.\n",
    Name(WER, 1)+" reibt sich die Aeuglein.\n",
    Name(WER, 1)+" versucht, sich vor Dir zu verstecken.\n",
    Name(WER, 1)+" blickt aengstlich zu Dir auf.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" ruft laut um Hilfe!\n",
    Name(WER, 1)+" faengt an zu weinen.\n",
    Name(WER, 1)+" versucht, Dich zu treten.\n",
    Name(WER, 1)+" weint: Ich habe Dir doch nichts getan!\n" }));

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt ein Cheraanikind ("+Name(WER,1)+").\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": Ein Cheraanikind ("+Name(WER,1)+") hat gerade "
      +CAP(getuid(player))+" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
    case "intim":
      call_out("reaction", 0, TP,
        "blickt Dich verwundert an.",
        "blickt "+TP->name(WEN)+" verwundert an.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "verkriecht sich voellig veraengstigt in eine Ecke.",
        "verkriecht sich voellig veraengstigt in eine Ecke.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "kichert leise.",
        "kichert leise.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "bricht in Traenen aus und faengt bitterlich an zu weinen.",
        "bricht in Traenen aus und faengt bitterlich an zu weinen.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "weicht aengstlich vor Dir zurueck.",
        "weicht aengstlich vor "+TP->name(WEM)+" zurueck.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "lacht Dich froehlich an.",
        "lacht "+TP->name(WEN)+" froehlich an.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "blickt Dich treuherzig an.",
        "blickt "+TP->name(WEN)+" treuherzig an.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "betrachtet Dich neugierig.",
        "betrachtet "+TP->name(WEN)+" neugierig.");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "versucht unbeholfen, Dich zu troesten.",
        "versucht unbeholfen, "+TP->name(WEN)+" zu troesten.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

void give_notify(object was)
{
    write(BS("Matty staunt: Danke, "+TP->Name()+"!"));
     
    ENV(TO)->Message(BS("Matty staunt: Danke, "+TP->Name()+"!"),
    MSGFLAG_SOUND|MSGFLAG_NO_TP);
    was->move(TO, M_GET|M_SILENT);
    
    return;
}
