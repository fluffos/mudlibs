#include "../def.h"

inherit "/d/kristallwald/lilyth/cheraani/npc/std_npc_cheraani";

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Yole, der Cheraanijunge");
  SetProp(P_LONG,
    "Yole ist ein kleiner Cheraanijunge mit grossen blauen Augen und einem "
    "spitzbuebischem Laecheln. Er ist der Zwillingsbruder von Yala und "
    "meistens in ihrer Naehe zu finden. Seine Eltern Liara und Alenos "
    "besitzen ein kleines Gasthaus auf diesem Baum.");

  AddDetail( ({ "auge", "augen" }),
    "Mit seinen grossen, blauen Augen schaut er Dich froehlich an.");

  AddDetail( ({ "laecheln" }),
    "Er sieht ziemlich aufgeweckt aus.");

  AddDetail( ({ "zwillingsbruder", "bruder", "yala" }),
    "Er ist der Zwillingsbruder von Yala und haelt es fuer seine Pflicht, "
    "auf seine Schwester aufzupassen, da er ein paar Minuten frueher auf "
    "die Welt gekommen ist als sie und somit der Aeltere der beiden ist.");

  AddDetail( ({ "pflicht" }),
    "Er passt stets auf seine Schwester auf.");

  AddDetail( ({ "schwester", "zwillingsschwester" }),
    "Yala ist seine Zwillingsschwester.");

  AddDetail( ({ "minuten" }),
    "Nur ein paar Minuten.");

  AddDetail( ({ "welt", "rolle" }),
    "Er wurde ein klein wenig frueher geboren als Yala und nimmt seine "
    "Rolle als grosser Bruder sehr ernst.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Yole");
  SetProp(P_GENDER, MALE);
  AddId(({"yole", "cheraanijunge", "junge"}));

//--Eigenschaften----------------------------------------------------------

  create_default_cheraani(7);                      //Level 6-9:   Kinder
                                                   //Level 10-15: Erwachsene
  SetProp(P_HANDS,                                 //Level 16-20: Wachen
  ({ " mit schwacher Magie", 70, DT_MAGIC }) );    //Level 21+:   Aelteste

  SetProp(P_SIZE, 60);
  SetProp(P_WEIGHT, 21000);

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "laeuft herein");
  SetProp(P_MSGOUT, "laeuft");
  SetProp(P_MMSGIN, "kommt hereingelaufen");
  SetProp(P_MMSGOUT, "laeuft schnell nach Hause");

  SetProp(P_MNPC_AREA, ({ ROOM "eb1_f2_weg", ROOM "eb1_f4_weg",
                          ROOM "eb1_g1_weg", ROOM "eb1_g3_weg", 
                          ROOM "eb1_g4_weg", ROOM "eb1_h2_weg", 
                          ROOM "eb1_h6_weg", ROOM "eb1_i5_weg", 
                          ROOM "eb1_j4_weg", ROOM "eb1_j6_weg", 
                          ROOM "eb1_k5_weg", ROOM "eb1_h5_eingang",
                          ROOM "eb1_g2_kneipe" }) );

  SetProp(P_MNPC_WAIT, ({ 30, 40, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS + MOV_INDOORS);
  SetProp(P_MNPC_DEFAULTROOM, ROOM "eb1_g3_weg");

//--Tod--------------------------------------------------------------------

  SetProp(P_KILL_NAME, "Yole");
  SetProp(P_MURDER_MSG, "Das war gemein!");

//--Infos------------------------------------------------------------------

  AddLibrary("/d/kristallwald/lilyth/cheraani/npc/cheraani.lib", 1);

  AddInfo(DEFAULT_INFO,
         ({ "blickt Dich mit grossen Augen an.\n",
            "behauptet: Das wissen nur die Aeltesten!\n",
            "faengt an, nachzudenken.\n"}));

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 40);

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" mustert Dich neugierig.\n",
    Name(WER, 1)+" blickt Dich verschmitzt an.\n",
    Name(WER, 1)+" fuchtelt mit seinem kleinen Schnitzmesser herum.\n",
    Name(WER, 1)+" kratzt sich nachdenklich am Kopf.\n",
    Name(WER, 1)+" schnitzt an einem kleinen Ast herum.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" ruft laut um Hilfe!\n",
    Name(WER, 1)+" faengt an zu weinen.\n",
    Name(WER, 1)+" versucht, Dich zu treten.\n",
    Name(WER, 1)+" weint: Ich habe Dir doch nichts getan!\n" }));

//--Ausruestung------------------------------------------------------------

  SUID;
  
  CLONEME(WEAPON "messer");
  command("zuecke schnitzmesser");
  
//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt ein Cheraanikind ("+Name(WER,1)+").\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": Ein Cheraanikind ("+Name(WER,1)+") hat gerade "
      +CAP(getuid(player))+" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
    case "intim":
      call_out("reaction", 0, TP,
        "schaut Dich verwundert an.",
        "schaut "+TP->name(WEN)+" verwundert an.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "sagt: Hey, das sage ich meiner Mama!",
        "sagt: Hey, das sage ich meiner Mama!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "kichert froehlich.",
        "kichert froehlich.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "bricht in Traenen aus und faengt bitterlich an zu weinen.",
        "bricht in Traenen aus und faengt bitterlich an zu weinen.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "stupst Dich vorsichtig an.",
        "stupst "+TP->name(WEN)+" vorsichtig an.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "huepft um Dich herum.",
        "huepft um "+TP->name(WEN)+" herum.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "knuddelt Dich froehlich.",
        "knuddelt "+TP->name(WEN)+" froehlich.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "betrachtet Dich neugierig.",
        "betrachtet "+TP->name(WEN)+" neugierig.");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich lieb.",
        "troestet "+TP->name(WEN)+" lieb.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

void give_notify(object was)
{
    write(BS("Yole staunt: Danke, "+TP->Name()+"!"));
     
    ENV(TO)->Message(BS("Yole staunt: Danke, "+TP->Name()+"!"),
    MSGFLAG_SOUND|MSGFLAG_NO_TP);
    was->move(TO, M_GET|M_SILENT);
    
    return;
}
