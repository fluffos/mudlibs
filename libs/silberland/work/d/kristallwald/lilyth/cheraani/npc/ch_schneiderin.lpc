#include "../def.h"

inherit "/d/kristallwald/lilyth/cheraani/npc/std_npc_cheraani";

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Jair, die Schneiderin");
  SetProp(P_LONG,
    "Jair ist eine huebsche, schlanke Cheraani mit grossen blauen "
    "Augen und einem dichten, roetlichbraunen Fell. Sie ist die "
    "Schneiderin der Cheraani und kennt sich mit Nadel und Faden "
    "bestens aus. Wenn Du etwas genaeht haben willst, brauchst Du es "
    "ihr nur zu sagen.");

  AddDetail( ({ "augen", "auge" }),
    "Sie hat grosse blaue Augen, mit denen sie Dich freundlich ansieht.");

  AddDetail( ({ "fell" }),
    "Es hat eine besonders schoene, roetlichbraune Faerbung und sieht "
    "sehr gepflegt aus.");

  AddDetail( ({ "faerbung" }),
    "Roetlichbraun.");

  AddDetail( ({ "nadel", "faden" }),
    "Damit kann sie hervorragend umgehen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Jair");
  SetProp(P_GENDER, FEMALE);
  AddId(({"jair", "schneiderin"}));

//--Eigenschaften----------------------------------------------------------

  create_default_cheraani(13);                     //Level 6-9:   Kinder
                                                   //Level 10-15: Erwachsene
  SetProp(P_HANDS,                                 //Level 16-20: Wachen
  ({ " mit Cheraanimagie", 130, DT_MAGIC }) );     //Level 21+:   Aelteste

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" sagt verwundert: Aber das brauchst Du doch sicherlich "
    +"selbst.\n" }) );

//--Bewegungen-------------------------------------------------------------
  
  SetProp(P_MSGIN, "huscht leise herein");
  SetProp(P_MSGOUT, "huscht");
  SetProp(P_MMSGIN, "kommt flink heraufgeklettert");
  SetProp(P_MMSGOUT, "klettert flink davon");
  
//--Tod--------------------------------------------------------------------

  SetProp(P_KILL_NAME, "Jair, die Schneiderin");

//--Infos------------------------------------------------------------------

  AddLibrary("/d/kristallwald/lilyth/cheraani/npc/cheraani.lib", 2);

  AddInfo(DEFAULT_INFO,
         ({ "gruebelt vor sich hin.\n",
            "schaut Dich fragend an.\n",
            "sagt: Das weiss ich leider nicht, frag lieber die Aeltesten "
            +"danach.\n"}));

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 50);

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" .\n",
    Name(WER, 1)+" .\n",
    Name(WER, 1)+" .\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" .\n",
    Name(WER, 1)+" .\n",
    Name(WER, 1)+" .\n" }));

//--Ausruestung------------------------------------------------------------

//SUID;
//CLONEME(WEAPON "");
//command("zuecke waffe");

//CLONEME(ARMOUR "");
//command("trage alles");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt Jair, die Schneiderin.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": Jair, die Schneiderin hat gerade "
      +CAP(getuid(player))+" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "laechelt Dir beruhigend zu.",
        "laechelt "+TP->name(WEM)+" beruhigend zu.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "blickt Dich vorwurfsvoll an.",
        "blickt "+TP->name(WEN)+" vorwurfsvoll an.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "kichert belustigt.",
        "kichert belustigt.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "sagt: Hey, was soll denn das?!",
        "sagt: Hey, was soll denn das?!");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "runzelt die Stirn.",
        "runzelt die Stirn.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "freut sich.",
        "freut sich.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "blickt Dich verdutzt an.",
        "blickt "+TP->name(WEN)+" verdutzt an.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "knuddelt Dich froehlich.",
        "knuddelt Dich froehlich.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "nickt Dir freundlich zu.",
        "nickt Dir freundlich zu.");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        "troestet "+TP->name(WEN)+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
