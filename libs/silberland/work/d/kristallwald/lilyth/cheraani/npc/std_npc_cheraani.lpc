//Waffe verzaubern
void spell_waffe(object enemy, int damage, mixed dam_type)
{
  if(waffe_verzaubert) return;
 
  waffe_verzaubert      = 1;
  waffe_verzaubert_ende = time() + 20; //10 sek dauer und 10 sek pause
}


//Defend-Funktion fuer Spells Ausweichen, Schnell und Waffe verzaubern
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if(ausweichen       && (time() > ausweich_ende)) ausweichen = 0;
  if(schnell          && (time() > schnell_ende )) schnell    = 0;
  if(waffe_verzaubert && (time() > waffe_verzaubert_ende )) waffe_verzaubert = 0;

  if(waffe_verzaubert)
  {
    enemy->Defend(dam, dam_type, ([SP_SHOW_DAMAGE:1]));
    return ::Defend(0, dam_type, spell, enemy);
  }

  if(!ausweichen) return ::Defend(dam, dam_type, spell, enemy);

  if(!pointerp(dam_type)) dam_type = ({dam_type});
  
  if(sizeof(filter_array(dam_type,PHYSICAL_DAMAGE_TYPES)))
  {
     dam = 2 * dam / 3;

     if(dam < 10)
     {
        tell_object(enemy, Name(WER)+" weicht Dir muehelos aus.\n");
     }
     else if(dam < 20)
     {
        tell_object(enemy, Name(WER)+" weicht Dir flink aus.\n");
     }
     else
     {
        tell_object(enemy, Name(WER)+" weicht Dir ein wenig aus.\n");
     }
  }

  return ::Defend(dam, dam_type, spell, enemy);
}
