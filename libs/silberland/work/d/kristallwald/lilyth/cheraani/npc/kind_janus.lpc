#include "../def.h"

inherit "/d/kristallwald/lilyth/cheraani/npc/std_npc_cheraani";

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Janus, der Cheraanijunge");
  SetProp(P_LONG,
    "Janus ist der aelteste der Cheraanijungen und fuer sein Alter schon "
    "recht vernuenftig. Er ist der Sohn von Majati, der Waffenschmiedin, "
    "und Tarkon, dem Waechter der Cheraani. Wenn er mal gross ist, will er "
    "ein ebenso guter Waechter werden wie sein Vater.");

  AddDetail( ({ "alter" }),
    "Janus ist das aelteste der Cheraanikinder.");

  AddDetail( ({ "sohn" }),
    "Er ist der Sohn von Majati, der Waffenschmiedin, und Tarkon, dem "
    "Waechter.");

  AddDetail( ({ "waechter" }),
    "Janus' Wunsch ist es, spaeter einmal ein ebenso guter und starker "
    "Waechter zu werden wie sein Vater Tarkon.");

  AddDetail( ({ "wunsch" }),
    "Dies ist sein sehnlichster Wunsch.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Janus");
  SetProp(P_GENDER, MALE);
  AddId(({"janus", "cheraanijunge", "junge"}));

//--Eigenschaften----------------------------------------------------------

  create_default_cheraani(9);                      //Level 6-9:   Kinder
                                                   //Level 10-15: Erwachsene
  SetProp(P_HANDS,                                 //Level 16-20: Wachen
  ({ " mit schwacher Magie", 90, DT_MAGIC }) );    //Level 21+:   Aelteste

  SetProp(P_SIZE, 87);
  SetProp(P_WEIGHT, 27000);

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "laeuft herein");
  SetProp(P_MSGOUT, "laeuft");
  SetProp(P_MMSGIN, "kommt hereingelaufen");
  SetProp(P_MMSGOUT, "laeuft schnell nach Hause");

  SetProp(P_MNPC_AREA, ({ ROOM "eb1_e8_weg", ROOM "eb1_f7_weg",
                          ROOM "eb1_f8_weg", ROOM "eb1_g6_weg",
                          ROOM "eb1_g9_weg", ROOM "eb1_i8_weg", 
                          ROOM "eb1_h6_weg", ROOM "eb1_h7_weg", 
                          ROOM "eb1_i7_weg", ROOM "eb1_h5_eingang" }) );

  SetProp(P_MNPC_WAIT, ({ 30, 40, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS + MOV_INDOORS);
  SetProp(P_MNPC_DEFAULTROOM, ROOM "eb1_i7_weg");

//--Tod--------------------------------------------------------------------

  SetProp(P_KILL_NAME, "Janus");
  SetProp(P_MURDER_MSG, "Das war gemein!");

//--Infos------------------------------------------------------------------

  AddLibrary("/d/kristallwald/lilyth/cheraani/npc/cheraani.lib", 1);

  AddInfo(DEFAULT_INFO,
         ({ "blickt Dich mit grossen Augen an.\n",
            "behauptet: Das wissen nur die Aeltesten!\n",
            "faengt an, nachzudenken.\n"}));

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 40);

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" kaempft mit einem imaginaeren Gegner.\n",
    Name(WER, 1)+" betrachtet Dich eindringlich.\n",
    Name(WER, 1)+" mustert Dich argwoehnisch.\n",
    Name(WER, 1)+" versucht, ernsthaft und erwachsen auszusehen.\n",
    Name(WER, 1)+" denkt ueber irgendetwas nach.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" ruft laut um Hilfe!\n",
    Name(WER, 1)+" pruegelt mit seinen kleinen Pfoten auf Dich ein.\n",
    Name(WER, 1)+" versucht, Dich zu treten.\n",
    Name(WER, 1)+" jammert: Ich habe Dir doch nichts getan!\n" }));

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt ein Cheraanikind ("+Name(WER,1)+").\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": Ein Cheraanikind ("+Name(WER,1)+") hat gerade "
      +CAP(getuid(player))+" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
    case "intim":
      call_out("reaction", 0, TP,
        "schaut Dich verwundert an.",
        "schaut "+TP->name(WEN)+" verwundert an.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "sagt: Hey, das sage ich meinem Papa!",
        "sagt: Hey, das sage ich meinem Papa!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "kichert froehlich.",
        "kichert froehlich.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "bricht in Traenen aus und faengt bitterlich an zu weinen.",
        "bricht in Traenen aus und faengt bitterlich an zu weinen.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "stupst Dich vorsichtig an.",
        "stupst "+TP->name(WEN)+" vorsichtig an.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "huepft um Dich herum.",
        "huepft um "+TP->name(WEN)+" herum.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "knuddelt Dich froehlich.",
        "knuddelt "+TP->name(WEN)+" froehlich.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "betrachtet Dich neugierig.",
        "betrachtet "+TP->name(WEN)+" neugierig.");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich lieb.",
        "troestet "+TP->name(WEN)+" lieb.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

void give_notify(object was)
{
    write(BS("Janus staunt: Danke, "+TP->Name()+"!"));
     
    ENV(TO)->Message(BS("Janus staunt: Danke, "+TP->Name()+"!"),
    MSGFLAG_SOUND|MSGFLAG_NO_TP);
    was->move(TO, M_GET|M_SILENT);
    
    return;
}
