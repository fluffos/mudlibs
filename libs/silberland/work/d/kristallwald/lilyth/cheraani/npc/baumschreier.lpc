#include "../def.h"

inherit "std/mnpc";
inherit "/std/npc/spells";

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Baumschreier");
  SetProp(P_LONG,
    "Der Baumschreier ist ein kleines, affenaehnliches Wesen mit einem "
    "flaumigen, weichen Fell und grossen dunklen Augen. Mit seinen "
    "krallenbewehrten Pfoten findet er leichten Halt auf den Baeumen, "
    "auf denen er seinen natuerlichen Lebensraum hat.");

  AddDetail( ({ "wesen", "gattung" }),
    "Dieses kleine Wesen gehoert der Gattung der Baumschreier an.");

  AddDetail( ({ "fell" }),
    "Er hat ein sehr weiches, flaumiges Fell, dessen Farbe je nach "
    "Tageszeit mal sehr hell, mal eher braeunlich und zu anderen Zeiten "
    "wiederum fast schwarz auszusehen scheint.");

  AddDetail( ({ "tageszeit", "zeit", "zeiten" }),
    "Die Farbe seines Fells ist je nach Tageszeit verschieden.");

  AddDetail( ({ "augen", "auge" }),
    "Seine grossen dunklen Augen flitzen rasch hin und her und betrachten "
    "Dich neugierig und keineswegs scheu.");

  AddDetail( ({ "pfoten", "pfote" }),
    "Seine kleinen Pfoten sind mit feinen Krallen besetzt, mit denen er "
    "sich leicht am Stamm eines Baumes festhalten kann.");

  AddDetail( ({ "kralle", "krallen" }),
    "Die Krallen sind fein geformt, sehen aber sehr fest und stabil aus.");

  AddDetail( ({ "halt" }),
    "Besseren als Du jedenfalls.");

  AddDetail( ({ "baeume", "baeumen", "baum" }),
    "Baumschreier leben fuer gewoehnlich auf Baeumen.");

  AddDetail( ({ "lebensraum" }),
    "Der Baumschreier haelt sich am liebsten auf Baeumen auf.");

  AddSpecialDetail( ({ "farbe" }),
    "strfarbe");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Baumschreier");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"baumschreier", "schreier", "FELL_WUSCHEL"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(8);

  SetProp(P_HANDS, ({ " mit seinen krallenbewehrten Pfoten", 80, DT_RIP }) );

  SetProp(P_RACE, "Baumschreier");
  SetProp(P_SIZE, 25);
  SetProp(P_WEIGHT, 5000);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" interessiert sich nicht fuer Deine Sachen.\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "wuselt herein");
  SetProp(P_MSGOUT, "wuselt");
  SetProp(P_MMSGIN, "wuselt herein");
  SetProp(P_MMSGOUT, "wuselt davon");

  SetProp(P_MNPC_AREA, ({ ROOM "eb1_" }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "eb1_e9_weg");
  SetProp(P_MNPC_WAIT, ({ 60, 20, 50 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Ein Baumschreier");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "schnattert aufgeregt etwas, das Du leider nicht verstehst.\n",
            "schaut Dich mit grossen Augen verstaendnislos an.\n",
            "will viel lieber von Dir gestreichelt werden.\n"}));

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

  AddSpell(1,160,
    Name(WER, 1)+" beisst Dich schmerzhaft in den Arm!\n",
    Name(WER, 1)+" beisst @WEN schmerzhaft in den Arm!\n",
    DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,190,
    Name(WER, 1)+" zerkratzt Dein Gesicht mit seinen Krallen!\n",
    Name(WER, 1)+" zerkratzt @WESSEN Gesicht mit seinen Krallen!\n",
    DT_RIP,([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" schnattert leise vor sich hin.\n",
    Name(WER, 1)+" huscht blitzschnell auf einen anderen Ast.\n",
    Name(WER, 1)+" blickt Dich mit grossen Augen an.\n",
    Name(WER, 1)+" putzt sich mit seinen Pfoten das Gesicht. Wie suess!\n",
    Name(WER, 1)+" stellt sich kurz auf die Hinterbeine.\n",
    Name(WER, 1)+" reckt und streckt sich und maunzt dabei leise.\n",
    Name(WER, 1)+" schnuppert an Dir herum.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" zerkratzt Dich mit seinen Krallen!\n",
    Name(WER, 1)+" versucht, Dich zu beissen.\n",
    Name(WER, 1)+" faucht Dich wuetend an!\n" }));

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt einen Baumschreier.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "legt den Kopf schief.",
        "legt den Kopf schief.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "faucht Dich drohend an!",
        "faucht "+TP->name(WEN)+" drohend an!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "springt lustig schnatternd auf und ab.",
        "springt lustig schnatternd auf und ab.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "verkriecht sich leise wimmernd in einer Ecke.",
        "verkriecht sich leise wimmernd in einer Ecke.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "knurrt leise.",
        "knurrt leis.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "flitzt blitzschnell um Dich herum.",
        "flitzt blitzschnell um "+TP->name(WEN)+" herum.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "schnurrt zufrieden.",
        "schnurrt zufrieden.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "springt kurz auf Deine Schulter und schnattert Dir aufgeregt etwas "
        +"ins Ohr.",
        "springt kurz auf "+TP->name(WESSEN)+" Schulter und schnattert "
        +(TP->QueryProp(P_GENDER)==MALE?"ihm":"ihr")+" aufgeregt etwas "
        +"ins Ohr.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "schnuppert neugierig an Dir herum.",
        "schnuppert neugierig an Dir herum.");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "kuschelt sich troestend an Dich an.",
        "kuschelt sich troestend an "+TP->name(WEN)+" an.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));

  ENV(TO)->Message(BS(Name(WER, 1)+" "+andere), 
  MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ pl }) ]) );
}

//--Funktionen-------------------------------------------------------------

string strfarbe(string str)
{
  string s;
  string txt;
  
  switch(random(5))
  {
      case 1:
  	txt = "roetlich-braun";
  	break;
      case 2:
  	txt = "fast beigefarben";
  	break;
      case 3:
  	txt = "goldbraun";
  	break;
      case 4:
  	txt = "dunkelbraun";
  	break;
      default:
  	txt = "hellbraun";
  	break;
  }

  s = "Jetzt gerade sieht das Fell "+txt+" aus.";

  return BS(s);
}
