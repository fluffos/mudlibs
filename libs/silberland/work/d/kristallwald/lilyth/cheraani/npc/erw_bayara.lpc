#include "../def.h"

inherit "/d/kristallwald/lilyth/cheraani/npc/std_npc_cheraani";

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Bayara, der Cheraani");
  SetProp(P_LONG,
    "Bayara ist ein schon etwas aelterer Cheraani, wie Du an seinem "
    "dunklen Fell erkennen kannst. Seitdem er seine Lebensgefaehrtin und "
    "seinen kleinen Sohn bei einem schrecklichen Unfall im Wald verloren "
    "hat, ist er sehr einsam und Fremden gegenueber recht verschlossen. "
    "Er sieht sehr traurig und ein wenig verbittert aus.");

  AddDetail( ({ "fell", "faerbung" }),
    "Sein Fell hat eine schon stark nachgedunkelte Faerbung, woran Du "
    "erkennst, dass dieser Cheraani schon ein wenig aelter ist.");

  AddDetail( ({ "lebensgefaehrtin", "gefaehrtin" }),
    "Sie ist bei einem schrecklichen Unfall ums Leben gekommen.");

  AddDetail( ({ "sohn" }),
    "Er hatte einen kleinen Sohn, den er ueber alles geliebt hat.");

  AddDetail( ({ "unfall", "genaueres" }),
    "Frag ihn am besten selbst danach. Vielleicht ist er ja bereit, Dir "
    "Genaueres zu erzaehlen.");

  AddDetail( ({ "wald", "seiten", "seite" }),
    "Der Wald umgibt Dich auch hier von allen Seiten.");

  AddDetail( ({ "fremde", "fremden" }),
    "Damit bist Du gemeint.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Bayara");
  SetProp(P_GENDER, MALE);
  AddId(({"bayara"}));

//--Eigenschaften----------------------------------------------------------

  create_default_cheraani(15);                     //Level 6-9:   Kinder
                                                   //Level 10-15: Erwachsene
  SetProp(P_HANDS,                                 //Level 16-20: Wachen
  ({ " mit Cheraanimagie", 150, DT_MAGIC }) );     //Level 21+:   Aelteste

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" sagt verwundert: Aber das brauchst Du doch sicherlich "
    +"selbst.\n" }) );

//--Bewegungen-------------------------------------------------------------
  
  SetProp(P_MSGIN, "huscht leise herein");
  SetProp(P_MSGOUT, "huscht");
  SetProp(P_MMSGIN, "kommt flink heraufgeklettert");
  SetProp(P_MMSGOUT, "klettert flink davon");

/*
  SetProp(P_MNPC_AREA, ({ ROOM "eb1_a7_weg",  ROOM "eb1_b6_weg",
                          ROOM "eb1_b8_weg",  ROOM "eb1_c7_weg",
                          ROOM "eb1_d6_weg",  ROOM "eb1_d10_weg", 
                          ROOM "eb1_e8_weg",  ROOM "eb1_e9_weg", 
                          ROOM "eb1_e11_weg", ROOM "eb1_f8_weg", 
                          ROOM "eb1_f10_weg", ROOM "eb1_d7_eingang" }) );

  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS + MOV_INDOORS);
  SetProp(P_MNPC_DEFAULTROOM, ROOM "eb1_a7_weg");
*/

//--Tod--------------------------------------------------------------------

  SetProp(P_KILL_NAME, "Bayara, der Cheraani");

//--Infos------------------------------------------------------------------

  AddLibrary("/d/kristallwald/lilyth/cheraani/npc/cheraani.lib", 2);

  AddInfo(DEFAULT_INFO,
         ({ "gruebelt vor sich hin.\n",
            "schaut Dich fragend an.\n",
            "sagt: Das weiss ich leider nicht, frag lieber die Aeltesten "
            +"danach.\n"}));

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 50);

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" .\n",
    Name(WER, 1)+" .\n",
    Name(WER, 1)+" .\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" .\n",
    Name(WER, 1)+" .\n",
    Name(WER, 1)+" .\n" }));

//--Ausruestung------------------------------------------------------------

//SUID;
//CLONEME(WEAPON "");
//command("zuecke waffe");

//CLONEME(ARMOUR "");
//command("trage alles");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt einen Cheraani ("+Name(WER,1)+").\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": Ein Cheraani ("+Name(WER,1)+") hat gerade "
      +CAP(getuid(player))+" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "laechelt Dir beruhigend zu.",
        "laechelt "+TP->name(WEM)+" beruhigend zu.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "blickt Dich vorwurfsvoll an.",
        "blickt "+TP->name(WEN)+" vorwurfsvoll an.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "kichert belustigt.",
        "kichert belustigt.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "sagt: Hey, was soll denn das?!",
        "sagt: Hey, was soll denn das?!");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "runzelt die Stirn.",
        "runzelt die Stirn.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "freut sich.",
        "freut sich.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "blickt Dich verdutzt an.",
        "blickt "+TP->name(WEN)+" verdutzt an.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "knuddelt Dich froehlich.",
        "knuddelt Dich froehlich.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "nickt Dir freundlich zu.",
        "nickt Dir freundlich zu.");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        "troestet "+TP->name(WEN)+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
