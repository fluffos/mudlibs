#include "../def.h"

inherit "/d/kristallwald/lilyth/cheraani/npc/std_npc_cheraani";

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Fidar, der Blumenhaendler");
  SetProp(P_LONG,
    "Fidar ist der Blumenhaendler der Cheraani. Du weisst nicht warum, "
    "aber irgendwie kommt er Dir ein wenig seltsam vor. Ob das wohl mit "
    "den zahlreichen kleinen, bunten Schleifchen zusammenhaengt, die er "
    "sich in sein Fell geflochten hat? Wenn es um Blumen geht, ist er "
    "jedoch der beste Ansprechpartner, den Du hier oben finden wirst.");

  AddDetail( ({ "schleifchen", "schleifen", "schleife" }),
    "Ueberall in seinem Fell entdeckst Du kleine, bunte Schleifchen, die "
    "es in lustigen Buescheln vom Koerper abstehen lassen. Spontan fragst "
    "Du Dich, ob Du Deine Haare bei Deiner naechsten Geburtstagsparty "
    "wohl auch so toll hinbekommen wirst.");

  AddDetail( ({ "fell" }),
    "Sein hellbraunes Fell ist mit bunten Schleifen verziert, die es in "
    "kleinen Buescheln vom Koerper abstehen lassen.");

  AddDetail( ({ "koerper" }),
    "Der gesamte Koerper der Cheraani ist mit einem weichen, meist in "
    "Brauntoenen gehaltenen Fell bedeckt. Die meisten Cheraani tragen ihr "
    "Fell kurz, doch Fidar hat es wohl schon laengere Zeit wachsen lassen.");

  AddDetail( ({ "bueschel", "buescheln" }),
    "Du denkst   . o O (Eine wirklich tolle Frisur!)");

  AddDetail( ({ "haare", "haar", "frisur" }),
    "Schnell befuehlst Du Deine Haare. Hm, die koennten auch mal wieder "
    "gewaschen werden.");

  AddDetail( ({ "geburtstagsparty", "party", "geburtstag" }),
    "Wann hast Du denn eigentlich Geburtstag?");

  AddDetail( ({ "brauntoene", "braunton" }),
    "Fidars Fell ist hellbraun.");

  AddDetail( ({ "zeit" }),
    "Es ist schon ganz schoen lang geworden.");

  AddDetail( ({ "blumen" }),
    "Wenn Du etwas ueber Blumen wissen willst, kann Fidar Dir sicherlich "
    "weiterhelfen.");

  AddDetail( ({ "ansprechpartner", "partner" }),
    "Er ist der allerbeste.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Fidar");
  SetProp(P_GENDER, MALE);
  AddId(({"fidar", "blumenhaendler", "haendler"}));

//--Eigenschaften----------------------------------------------------------

  create_default_cheraani(12);                     //Level 6-9:   Kinder
                                                   //Level 10-15: Erwachsene
  SetProp(P_HANDS,                                 //Level 16-20: Wachen
  ({ " mit Cheraanimagie", 120, DT_MAGIC }) );     //Level 21+:   Aelteste

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" sagt verwundert: Aber das brauchst Du doch sicherlich "
    +"selbst.\n" }) );

//--Bewegungen-------------------------------------------------------------
  
  SetProp(P_MSGIN, "huscht leise herein");
  SetProp(P_MSGOUT, "huscht");
  SetProp(P_MMSGIN, "kommt flink heraufgeklettert");
  SetProp(P_MMSGOUT, "klettert flink davon");
  
//--Tod--------------------------------------------------------------------

  SetProp(P_KILL_NAME, "Fidar, der Blumenhaendler");

//--Infos------------------------------------------------------------------

//AddLibrary("/d/kristallwald/lilyth/cheraani/npc/cheraani.lib", 2);

  AddInfo(DEFAULT_INFO,
         ({ "gruebelt vor sich hin.\n",
            "schaut Dich fragend an.\n",
            "sagt: Das weiss ich leider nicht, frag lieber die Aeltesten "
            +"danach.\n"}));

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 50);

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" traellert leise vor sich hin.\n",
    Name(WER, 1)+" bindet einen wunderschoenen Strauss zusammen.\n",
    Name(WER, 1)+" fuellt eine Vase mit frischem Wasser.\n",
    Name(WER, 1)+" fragt Dich: Moechtest Du ein paar Blumen kaufen?\n",
    Name(WER, 1)+" spricht leise mit seinen Blumen.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" .\n",
    Name(WER, 1)+" .\n",
    Name(WER, 1)+" .\n" }));

//--Ausruestung------------------------------------------------------------

//SUID;
//CLONEME(WEAPON "");
//command("zuecke waffe");

//CLONEME(ARMOUR "");
//command("trage alles");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt Fidar, den Blumenhaendler.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": Fidar, der Blumenhaendler hat gerade "
      +CAP(getuid(player))+" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "laechelt Dir beruhigend zu.",
        "laechelt "+TP->name(WEM)+" beruhigend zu.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "blickt Dich vorwurfsvoll an.",
        "blickt "+TP->name(WEN)+" vorwurfsvoll an.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "kichert belustigt.",
        "kichert belustigt.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "sagt: Hey, was soll denn das?!",
        "sagt: Hey, was soll denn das?!");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "runzelt die Stirn.",
        "runzelt die Stirn.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "freut sich.",
        "freut sich.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "blickt Dich verdutzt an.",
        "blickt "+TP->name(WEN)+" verdutzt an.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "knuddelt Dich froehlich.",
        "knuddelt Dich froehlich.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "nickt Dir freundlich zu.",
        "nickt Dir freundlich zu.");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        "troestet "+TP->name(WEN)+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
