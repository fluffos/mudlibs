#include "../def.h"

inherit "/d/kristallwald/lilyth/cheraani/npc/std_npc_cheraani";

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Iunu, der Waechter der Cheraani");
  SetProp(P_LONG,
    "Iunu ist einer der beiden Waechter der Cheraani. Er bewacht den "
    "noerdlichen Eingang zum Versammlungsraum der Cheraani-Aeltesten und "
    "sorgt dafuer, dass niemand mit boesartiger Gesinnung zu ihnen "
    "gelangt. Sein strenger Blick sagt Dir, dass Du Dich besser nicht mit "
    "ihm anlegen solltest.");

  AddDetail( ({ "eingang", "versammlungsraum" }),
    "Er bewacht den noerdlichen Eingang zum Versammlungsraum.");

  AddDetail( ({ "aelteste", "cheraani-aelteste", "aeltesten",
  "cheraani-aeltesten" }),
    "Du triffst sie sicherlich im Versammlungsraum.");

  AddDetail( ({ "gesinnung" }),
    "Wenn Du eine boese Gesinnung hast, wirst Du kaum zu den Aeltesten "
    "durchgelassen werden.");

  AddDetail( ({ "blick" }),
    "Iunu blickt ein wenig streng drein, scheinbar nimmt er seine Aufgabe "
    "sehr ernst.");

  AddDetail( ({ "aufgabe" }),
    "Seine Aufgabe ist es, den Eingang zum Versammlungsraum der Aeltesten "
    "zu bewachen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Iunu");
  SetProp(P_GENDER, MALE);
  AddId(({"iunu", "waechter", "cheraaniwaechter", "NOWIMPY"}));

//--Eigenschaften----------------------------------------------------------

  create_default_cheraani(18);                     //Level 6-9:   Kinder
                                                   //Level 10-15: Erwachsene
  SetProp(P_HANDS,                                 //Level 16-20: Wachen
  ({ " mit Cheraanimagie", 180, DT_MAGIC }) );     //Level 21+:   Aelteste

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" sagt streng: Ich darf nichts von Dir annehmen!\n" }) );

//--Bewegungen-------------------------------------------------------------
  
  SetProp(P_MSGIN, "kommt mit strengem Blick herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "nimmt seinen Posten ein");
  SetProp(P_MMSGOUT, "verlaesst kurz seinen Posten");

//--Tod--------------------------------------------------------------------

  SetProp(P_KILL_NAME, "Ein Waechter der Cheraani");
  SetProp(P_MURDER_MSG, "Ich habe versagt!");
  
//--Infos------------------------------------------------------------------

  AddLibrary("/d/kristallwald/lilyth/cheraani/npc/cheraani.lib", 3);

  AddInfo(DEFAULT_INFO,
         ({ "blickt Dich schweigend an.\n",
            "sagt: Ich habe keine Zeit fuer Deine Fragen.\n",
            "deutet auf den Vorhang.\n"}));

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 50);

//--Chats------------------------------------------------------------------

  SetChats(5,
  ({Name(WER, 1)+" raeuspert sich leise.\n",
    Name(WER, 1)+" mustert Dich argwoehnisch.\n",
    Name(WER, 1)+" verlagert sein Gewicht auf die andere Seite.\n",
    Name(WER, 1)+" blickt wachsam umher.\n",
    Name(WER, 1)+" lauscht aufmerksam.\n",
    Name(WER, 1)+" schaut kurz zum Himmel hinauf.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" versucht, Dich vom Baum zu schubsen.\n",
    Name(WER, 1)+" ruft erbost: Das wirst Du buessen!\n",
    Name(WER, 1)+" konzentriert sich voellig auf den Kampf.\n" }));

//--Ausruestung------------------------------------------------------------

  SUID;

  switch(random(3))
  {
    case 1:
      CLONEME(WEAPON "ch_klinge");
      command("zuecke klinge");
      break;
    case 2:
      CLONEME(WEAPON "ch_schwert");
      command("zuecke schwert");
      break;
    default:
      CLONEME(WEAPON "ch_speer");
      command("zuecke speer");
      break;
  }

  if(!random(4))
  {
     CLONEME(ARMOUR "ch_schild");
  }

  CLONEME(ARMOUR "ch_ruestung");
  command("trage alles");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt einen Waechter der Cheraani ("+Name(WER,1)+").\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": Ein Cheraaniwaechter ("+Name(WER,1)+") hat gerade "
      +CAP(getuid(player))+" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "laechelt Dir beruhigend zu.",
        "laechelt "+TP->name(WEM)+" beruhigend zu.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "sagt: Hey, lass das!",
        "sagt: Hey, lass das!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "grinst Dich belustigt an.",
        "grinst "+TP->name(WEN)+" belustigt an.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "warnt Dich: Hoer sofort auf damit!",
        "warnt "+TP->name(WEN)+": Hoer sofort auf damit!");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "runzelt die Stirn.",
        "runzelt die Stirn.");
      break;

    case "froh":
    case "nett":
    case "neutral":
      call_out("reaction", 0, TP,
        "nickt Dir freundlich zu.",
        "nickt "+TP->name(WEM)+" freundlich zu.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "runzelt pikiert die Stirn.",
        "runzelt pikiert die Stirn.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "sagt freundlich: Sei nicht traurig.",
        "sagt freundlich: Sei nicht traurig.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

void hilfe(object player)
{
  command_me("suedoben");
  call_out("rauswurf", 3, player);
  return;
}

void rauswurf(object player)
{
  if(!present(getuid(player), ENV(TO)))
  {
     Message(BS(Name(WER, 1)+" mustert Dich argwoehnisch und kehrt dann "
     +"wieder zurueck an seinen Posten."), 
     MSGFLAG_VISUAL);
  }
  else
  {
     tell_object(player, BS(Name(WER, 1)+" packt Dich unsanft am Kragen und "
     +"geleitet Dich nach draussen."));
     
     ENV(TO)->Message(BS(Name(WER, 1)+ " wirft "+player->Name()+" unsanft "
     +"hinaus."), MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ player }) ]) );

     player->move(ROOM "eb2_c1_weg", M_GO);
  }
  
  command_me("nordunten");
  return;
}
