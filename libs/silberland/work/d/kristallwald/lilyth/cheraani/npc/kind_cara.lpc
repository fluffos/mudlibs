#include "../def.h"

inherit "/d/kristallwald/lilyth/cheraani/npc/std_npc_cheraani";

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Cara, das Cheraanimaedchen");
  SetProp(P_LONG,
    "Cara ist ein Cheraanimaedchen, das Dich mit seinen grossen, braunen "
    "Augen freundlich ansieht. Sie ist die einzige Tochter von Aranel und "
    "Jucor, dem Schmuckverkaeufer und geht ihrer Mutter oft beim Anfertigen "
    "von kleineren Schmuckstuecken hilfreich zur Hand.");

  AddDetail( ({ "auge", "augen" }),
    "Sie hat grosse, braune Augen.");

  AddDetail( ({ "tochter" }),
    "Cara ist die Tochter von Aranel und Jucor, dem Schmuckverkaeufer.");

  AddDetail( ({ "jucor", "schmuckverkaeufer", "vater" }),
    "Jucor, der Schmuckverkaeufer, ist ihr Vater.");

  AddDetail( ({ "aranel", "mutter" }),
    "Aranel ist Caras Mutter.");

  AddDetail( ({ "anfertigen", "schmuckstuecke", "schmuckarbeiten", "hand" }),
    "Cara hilft ihrer Mutter oft dabei, huebsche Schmuckarbeiten "
    "anzufertigen, die ihr Vater dann in seinem Schmuckgeschaeft verkaufen "
    "kann.");

  AddDetail( ({ "schmuckgeschaeft" }),
    "Ihr Vater besitzt ein kleines Schmuckgeschaeft.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Cara");
  SetProp(P_GENDER, NEUTER);
  AddId(({"cara", "cheraanimaedchen", "maedchen"}));

//--Eigenschaften----------------------------------------------------------

  create_default_cheraani(8);                      //Level 6-9:   Kinder
                                                   //Level 10-15: Erwachsene
  SetProp(P_HANDS,                                 //Level 16-20: Wachen
  ({ " mit schwacher Magie", 80, DT_MAGIC }) );    //Level 21+:   Aelteste

  SetProp(P_SIZE, 71);
  SetProp(P_WEIGHT, 25000);

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "laeuft herein");
  SetProp(P_MSGOUT, "laeuft");
  SetProp(P_MMSGIN, "kommt hereingelaufen");
  SetProp(P_MMSGOUT, "laeuft schnell nach Hause");

  SetProp(P_MNPC_AREA, ({ ROOM "eb1_c4_weg", ROOM "eb1_c5_weg",
                          ROOM "eb1_d3_weg", ROOM "eb1_d6_weg",
                          ROOM "eb1_d3_weg", ROOM "eb1_d6_weg", 
                          ROOM "eb1_f4_weg", ROOM "eb1_f5_weg", 
                          ROOM "eb1_g4_weg", ROOM "eb1_d7_eingang" }) );

  SetProp(P_MNPC_WAIT, ({ 30, 40, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS + MOV_INDOORS);
  SetProp(P_MNPC_DEFAULTROOM, ROOM "eb1_c5_weg");

//--Tod--------------------------------------------------------------------

  SetProp(P_KILL_NAME, "Cara");
  SetProp(P_MURDER_MSG, "Maaaami!!!");

//--Infos------------------------------------------------------------------

  AddLibrary("/d/kristallwald/lilyth/cheraani/npc/cheraani.lib", 1);

  AddInfo(DEFAULT_INFO,
         ({ "blickt Dich mit grossen Augen an.\n",
            "behauptet: Das wissen nur die Aeltesten!\n",
            "faengt an, nachzudenken.\n"}));

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 40);

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" schaut Dich neugierig an.\n",
    Name(WER, 1)+" fragt Dich: Bist Du neu hier?\n",
    Name(WER, 1)+" gruebelt vor sich hin.\n",
    Name(WER, 1)+" summt leise vor sich hin.\n",
    Name(WER, 1)+" huepft ein wenig herum.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" ruft laut um Hilfe!\n",
    Name(WER, 1)+" faengt an zu weinen.\n",
    Name(WER, 1)+" versucht, Dich zu treten.\n",
    Name(WER, 1)+" weint: Ich habe Dir doch nichts getan!\n" }));

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt ein Cheraanikind ("+Name(WER,1)+").\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": Ein Cheraanikind ("+Name(WER,1)+") hat gerade "
      +CAP(getuid(player))+" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
    case "intim":
      call_out("reaction", 0, TP,
        "schaut Dich verwundert an.",
        "schaut "+TP->name(WEN)+" verwundert an.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "sagt: Hey, das sage ich meiner Mama!",
        "sagt: Hey, das sage ich meiner Mama!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "kichert froehlich.",
        "kichert froehlich.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "bricht in Traenen aus und faengt bitterlich an zu weinen.",
        "bricht in Traenen aus und faengt bitterlich an zu weinen.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "stupst Dich vorsichtig an.",
        "stupst "+TP->name(WEN)+" vorsichtig an.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "huepft um Dich herum.",
        "huepft um "+TP->name(WEN)+" herum.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "knuddelt Dich froehlich.",
        "knuddelt "+TP->name(WEN)+" froehlich.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "betrachtet Dich neugierig.",
        "betrachtet "+TP->name(WEN)+" neugierig.");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich lieb.",
        "troestet "+TP->name(WEN)+" lieb.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

void give_notify(object was)
{
    write(BS("Cara staunt: Danke, "+TP->Name()+"!"));
     
    ENV(TO)->Message(BS("Cara staunt: Danke, "+TP->Name()+"!"),
    MSGFLAG_SOUND|MSGFLAG_NO_TP);
    was->move(TO, M_GET|M_SILENT);
    
    return;
}
