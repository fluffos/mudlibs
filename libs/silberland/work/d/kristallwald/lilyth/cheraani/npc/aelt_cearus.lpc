#include "../def.h"

inherit "/d/kristallwald/lilyth/cheraani/npc/std_npc_cheraani";

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Cearus, der Cheraani-Aelteste");
  SetProp(P_LONG,
    "Cearus ist der einzige der maennlichen Cheraani, der seinen Platz "
    "unter den Aeltesten einnehmen durfte. Sein Interesse gilt besonders "
    "fremden Voelkern und Kulturen und so ist er haeuftig damit "
    "beschaeftigt, alles Wissenswerte ueber ihre Lebensweisen "
    "herauszufinden und es fuer die Nachwelt schriftlich festzuhalten.");

  AddDetail( ({ "platz" }),
    "Cearus ist der einzige maennliche Cheraani unter den "
    "Cheraani-Aeltesten.");

  AddDetail( ({ "interesse", "voelker", "kulturen", "lebensweisen", 
  "lebensgewohnheiten", "gewohnheiten" }),
    "Er interessiert sich fuer alles, was mit anderen Voelkern und ihren "
    "Lebensgewohnheiten zu tun hat.");

  AddDetail( ({ "wissenswertes", "wissenswerte", "wissen" }),
    "Auch ueber Dein Volk gibt es sicherlich einiges Wissenswerte.");

  AddDetail( ({ "nachwelt" }),
    "Auch spaeteren Generationen sollte dieses Wissen zuteil werden.");

  AddDetail( ({ "generationen" }),
    "Es werden sicherlich noch weitere folgen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Cearus");
  SetProp(P_GENDER, MALE);
  AddId(({"cearus", "aeltester", "cheraani-aeltester"}));

//--Eigenschaften----------------------------------------------------------

  create_default_cheraani(21);                     //Level 6-9:   Kinder
                                                   //Level 10-15: Erwachsene
  SetProp(P_HANDS,                                 //Level 16-20: Wachen
  ({ " mit Cheraanimagie", 210, DT_MAGIC }) );     //Level 21+: Aelteste

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" sagt freundlich: Das behalte lieber selbst.\n" }) );

//--Bewegungen-------------------------------------------------------------
  
  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "betritt den Versammlungsraum");
  SetProp(P_MMSGOUT, "verlaesst den Versammlungsraum");

//--Tod--------------------------------------------------------------------

  SetProp(P_KILL_NAME, "Cearus, der Cheraani-Aelteste");
  SetProp(P_MURDER_MSG, "Meine Zeit ist also gekommen...");

//--Infos------------------------------------------------------------------

  AddLibrary("/d/kristallwald/lilyth/cheraani/npc/cheraani.lib", 4);

  AddInfo(DEFAULT_INFO,
         ({ "blickt Dich schweigend an.\n",
            "schuettelt weise mit dem Kopf.\n",
            "sagt: Das kann ich Dir leider nicht beantworten.\n"}));

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 55);

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" schaut kurz auf.\n",
    Name(WER, 1)+" nickt Dir freundlich zu.\n",
    Name(WER, 1)+" betrachtet Dich nachdenklich.\n",
    Name(WER, 1)+" runzelt die Stirn.\n",
    Name(WER, 1)+" blaettert in einem Buch.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" murmelt einen Zauberspruch.\n",
    Name(WER, 1)+" seufzt: Warum tust Du das?\n",
    Name(WER, 1)+" sammelt seine Magie.\n",
    Name(WER, 1)+" konzentriert sich kurz.\n" }));

//--Ausruestung------------------------------------------------------------

  SUID;

  CLONEME(ARMOUR "ch_amulett");
  CLONEME(ARMOUR "ch_robe");
  command("trage alles");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt den Cheraani-Aeltesten ("+Name(WER,1)+").\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": Der Cheraaniaelteste ("+Name(WER,1)+") hat gerade "
      +CAP(getuid(player))+" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  object wache;
  object room;

  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "laechelt Dir beruhigend zu.",
        "laechelt "+TP->name(WEM)+" beruhigend zu.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "warnt Dich: Hoer sofort damit auf!",
        "warnt "+TP->name(WEN)+": Hoer sofort damit auf!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "laechelt Dir freundlich zu.",
        "laechelt "+TP->name(WEM)+" freundlich zu.");
      break;

    case "fies":
      call_other(ROOM "eb2_c1_weg", "???");
      call_other(ROOM "eb2_c3_weg", "???");
      
      room = find_object(ROOM "eb2_c1_weg");
      wache = present("cheraaniwaechter", room);
      
      if(wache && !wache->InFight())
      {
         wache->hilfe(TP);
         return;
      }
      
      room = find_object(ROOM "eb2_c3_weg");
      wache = present("cheraaniwaechter", room);
      
      if(wache && !wache->InFight())
      {
         wache->hilfe(TP);
         return;
      }
      
      call_out("reaction", 0, TP,
        "sagt: He, lass das!",
        "sagt: He, lass das!");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "runzelt die Stirn.",
        "runzelt die Stirn.");
      break;

    case "froh":
    case "nett":
      call_out("reaction", 0, TP,
        "blickt Dich freundlich an.",
        "blickt "+TP->name(WEN)+" freundlich an.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "mustert Dich erstaunt und Du senkst erroetend den Blick.",
        "mustert "+TP->name(WEN)+" erstaunt.\n"+TP->name(WER)+" erroetet.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "fragt Dich freundlich: Kann ich Dir helfen?",
        "fragt "+TP->name(WEN)+" freundlich: Kann ich Dir helfen?");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        "troestet "+TP->name(WEN)+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
