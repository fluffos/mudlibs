#include "../def.h"

inherit "/d/kristallwald/lilyth/cheraani/npc/std_npc_cheraani";

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Aelie, das Cheraanimaedchen");
  SetProp(P_LONG,
    "Aelie ist ein kleines Cheraanimaedchen mit grossen, dunklen Augen und "
    "einem sehr traurigen Gesicht. Ihre Eltern, die beide Kundschafter der "
    "Cheraani waren, sind von ihrem letzten Erkundungsgang, der sie weit "
    "bis ausserhalb des Tethyrwaldes fuehrte, nicht mehr zurueckgekehrt. "
    "Seitdem ist die kleine Aelia ganz alleine und niemand scheint sich um "
    "sie zu kuemmern.");

  AddDetail( ({ "auge", "augen" }),
    "Mit ihrem grossen, dunklen Augen blickt Aelia Dich traurig an.");

  AddDetail( ({ "gesicht" }),
    "Sie sieht wirklich sehr traurig aus.");

  AddDetail( ({ "eltern" }),
    "Aelias Eltern waren die Kundschafter der Cheraani.");

  AddDetail( ({ "tethyrwald", "wald" }),
    "Du befindest Dich gerade im Tethyrwald.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Aelie");
  SetProp(P_GENDER, NEUTER);
  AddId(({"aelie", "cheraanimaedchen", "maedchen"}));

//--Eigenschaften----------------------------------------------------------

  create_default_cheraani(7);                      //Level 6-9:   Kinder
                                                   //Level 10-15: Erwachsene
  SetProp(P_HANDS,                                 //Level 16-20: Wachen
  ({ " mit schwacher Magie", 70, DT_MAGIC }) );    //Level 21+:   Aelteste

  SetProp(P_SIZE, 67);
  SetProp(P_WEIGHT, 25000);

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "laeuft weinend herein");
  SetProp(P_MSGOUT, "laeuft weinend");
  SetProp(P_MMSGIN, "kommt weinend hereingelaufen");
  SetProp(P_MMSGOUT, "laeuft weinend davon");

  SetProp(P_MNPC_AREA, ({ ROOM "eb1_f7_weg", ROOM "eb1_f8_weg", 
                          ROOM "eb1_g6_weg" }) );

  SetProp(P_MNPC_WAIT, ({ 30, 40, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS + MOV_INDOORS);
  SetProp(P_MNPC_DEFAULTROOM, ROOM "eb1_f7_weg");

//--Tod--------------------------------------------------------------------

  SetProp(P_KILL_NAME, "Aelie");

//--Infos------------------------------------------------------------------

  AddLibrary("/d/kristallwald/lilyth/cheraani/npc/cheraani.lib", 1);

  AddInfo(DEFAULT_INFO,
         ({ "schnieft nur leise.\n",
            "blickt Dich verzweifelt an.\n",
            "ist zu traurig, um Dir zu antworten.\n"}));

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 40);

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" faengt bitterlich an zu weinen.\n",
    Name(WER, 1)+" macht einen sehr ungluecklichen Eindruck.\n",
    Name(WER, 1)+" schaut Dich mit grossen, traurigen Augen an.\n",
    Name(WER, 1)+" schluchzt leise vor sich hin.\n",
    Name(WER, 1)+" ruft weinend nach ihren Eltern.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" ruft laut um Hilfe!\n",
    Name(WER, 1)+" faengt an zu weinen.\n",
    Name(WER, 1)+" versucht, Dich zu treten.\n",
    Name(WER, 1)+" weint: Ich habe Dir doch nichts getan!\n" }));

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt ein Cheraanikind ("+Name(WER,1)+").\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": Ein Cheraanikind ("+Name(WER,1)+") hat gerade "
      +CAP(getuid(player))+" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
    case "intim":
      call_out("reaction", 0, TP,
        "schaut Dich verwundert an.",
        "schaut "+TP->name(WEN)+" verwundert an.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "schnieft: Du bist gemein.",
        "schnieft: Du bist gemein.");
      break;

    case "neutral":
    case "nett":
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt traurig.",
        "laechelt traurig.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "bricht in Traenen aus und faengt bitterlich an zu weinen.",
        "bricht in Traenen aus und faengt bitterlich an zu weinen.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "weint leise vor sich hin.",
        "weint leise vor sich hin.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "seufzt leise.",
        "seufzt leise.");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "versucht, Dich zu troesten.",
        "versucht, "+TP->name(WEN)+" zu troesten.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

void give_notify(object was)
{
    write(BS("Aelie staunt: Danke, "+TP->Name()+"!"));
     
    ENV(TO)->Message(BS("Aelie staunt: Danke, "+TP->Name()+"!"),
    MSGFLAG_SOUND|MSGFLAG_NO_TP);
    was->move(TO, M_GET|M_SILENT);
    
    return;
}
