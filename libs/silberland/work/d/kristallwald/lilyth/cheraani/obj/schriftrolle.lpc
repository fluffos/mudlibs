#include "../def.h"

inherit "std/thing";
inherit "players/lilyth/sonstiges/special/nedit";

//--Variablen&Defines------------------------------------------------------

int leer;
int gerollt;
int versiegelt;
int entsiegelt;
string rollentext;
string inhalt(string str);
string out();

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  leer = JA;
  gerollt = NEIN;
  versiegelt = NEIN;
  entsiegelt = NEIN;
  rollentext = "";

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine leere Schriftrolle");
//SetProp(P_LONG, --> siehe unten

  AddDetail( ({ "pergament" }),
    "Die Schriftrolle besteht aus einem sehr feinen, von Hand geschoepften "
    "Pergament.");

  AddDetail( ({ "hand" }),
    "Das Pergament wurde handgefertigt.");

  AddDetail( ({ "nachricht" }),
    "Mit dieser Schriftrolle kannst Du anderen eine Nachricht ueberbringen.");

  AddReadDetail( ({ "rolle", "schriftrolle" }),
    #'inhalt);

  AddSpecialDetail( ({ "pergament" }),
    "strpergament");

  AddSpecialDetail( ({ "wachssiegel", "siegel", "wachs", "kerzenwachs" }),
    "strsiegel");

  AddSpecialDetail( ({ "inhalt" }),
    "strinhalt");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schriftrolle");
  SetProp(P_NAME_ADJ, "leer");
  AddAdjective( ({ "leere", "leeren", "leerer" } ));
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "rolle", "schriftrolle" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, break_string("Mit 'beschreibe schriftrolle' kannst Du "
  +"etwas auf die Schriftrolle schreiben.\n(Hinweis: Es oeffnet sich der "
  +"aus Mail und Zeitung bekannte Editor.)\n\nWenn Du die Schriftrolle "
  +"loswerden willst, kannst Du sie einfach zerreissen.", 78,0,1));
  SetProp(P_MATERIAL, MAT_PERGAMENT);
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 100);

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "beschreib", "beschreibe" }), "beschreiben");
  AddCmd( ({ "roll", "rolle" }), "rollen" );
  AddCmd( ({ "brich", "brech", "breche", "zerbrich", "zerbrech", 
   "zerbreche" }), "entsiegeln" );
  AddCmd( ({ "versiegel", "versiegle", "versiegele", 
   "versiegl" }), "versiegeln" );
  AddCmd( ({ "zerreiss", "zerreisse" }), "zerreissen" );

//--Create Ende------------------------------------------------------------

}

//--Long&SpecialDetails----------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;
  string s;

  //beschrieben, zusammengerollt, versiegelt, entsiegelt?
  if(leer == JA)
  {
        s = "Das Pergament ist noch unbeschrieben.";
  }
  if(leer == NEIN)
  {
        s = "Es steht etwas auf dem Pergament geschrieben.";
  }
  if(gerollt == JA)
  {
        s = "Das Pergament wurde sorgsam zusammengerollt, so dass ihr "
           +"Inhalt nicht zu sehen ist.";
  }
  if(versiegelt == JA)
  {
        s =  "Ein rotes Wachssiegel schuetzt den Inhalt der Schriftrolle "
            +"vor neugierigen Blicken.";
  }
  if(entsiegelt == JA)
  {
        s =  "Das rote Wachssiegel, mit dem die Schriftrolle versiegelt "
            +"war, wurde zerbrochen.";
  }

  txt = "Diese kleine Schriftrolle wurde aus feinem Pergament gefertigt "
  +"und ist perfekt dazu geeignet, jemandem eine schriftliche Nachricht "
  +"zu ueberbringen - oder ueberbringen zu lassen. "+s;

  return BS(txt);
}

string strsiegel(string str)
{
  string s;
  
  s = "Sowas siehst Du da nicht!";

  if(versiegelt == JA)
  {
  	s = "Die Schriftrolle wurde mit einem kleinen Siegel aus rotem "
  	   +"Kerzenwachs versiegelt.";
  }
  if(entsiegelt == JA)
  {
        s = "Das Siegel, mit dem die Schriftrolle versiegelt war, wurde "
           +"zerbrochen.";
  }

  return BS(s);
}

string strinhalt(string str)
{
  string s;

  if(versiegelt == JA || gerollt == JA)
  {
  	s = "Du kannst nicht sehen, ob auf der Schriftrolle etwas "
  	   +"geschrieben steht.";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

string inhalt(string str)
{
  string txt;

  if(versiegelt == NEIN)
  {
     if(gerollt == NEIN)
     {
         if(leer == NEIN)
         {
            TP->More(out());
            ENV(TP)->Message(BS(TP->Name(WER, 1)+" liest eine Schriftrolle."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
            return "";
         }
         else
         {
            txt = "Auf der Schriftrolle steht nichts geschrieben.";
         }
     }
     else
     {
         txt = "Du solltest die Rolle zunaechst auseinanderrollen.";
     }
  }
  else
  {
        txt = "Das geht nicht, die Schriftrolle ist noch versiegelt.\nAber "
             +"vielleicht kannst Du das Siegel ja aufbrechen?";
  }
  
  return break_string(txt, 78, 0, 1);
}

string strpergament(string str)
{
  string s;
  
  s = "Die Schriftrolle besteht aus einem sehr feinen, von Hand "
     +"geschoepften Pergament.";

  if(leer == NEIN)
  {
     if(gerollt == NEIN && versiegelt == NEIN)
     {
  	s = "Mit 'lies rolle' kannst Du lesen, was auf der Schriftrolle "
  	   +"geschrieben steht";
     }
  }

  return BS(s);
}

//--Funktionen-------------------------------------------------------------

int beschreiben(string str)
{
   notify_fail("Was willst Du beschreiben? Vielleicht eine Schriftrolle?\n");

   if(!str || str == "") return 0;

   if(!(str == "schriftrolle" ||
        str == "rolle")) return 0;

   if(leer == NEIN)
   {
      write(BS("Aber die Schriftrolle wurde doch schon beschrieben."));
      return -1;
   }

   if(versiegelt == JA)
   {
       write(BS("Aber die Schriftrolle ist doch versiegelt!"));
       return -1;
   }

   if(gerollt == JA && leer == JA)
   {
       write(BS("Du rollst die Schriftrolle auseinander und beginnst "
       +"zu schreiben..."));
   }
    
   if(gerollt == NEIN && leer == JA)
   {
       write(BS("Du breitest die Schriftrolle vor Dir aus und beginnst "
       +"zu schreiben..."));
   }

   ENV(TP)->Message(BS(TP->Name(WER, 1)+" nimmt eine Schriftrolle zur "
   +"Hand und faengt an zu schreiben."),
   MSGFLAG_VISUAL|MSGFLAG_NO_TP);

   this_object()->nedit("ausgabe", "", time());
   return 1;
}

void ausgabe(string text, int zeit)
{
   rollentext = text;
     
   write(break_string("Abschliessend wirfst Du noch einmal einen pruefenden Blick "
   +"auf Dein Werk:\n", 78, 0, 1));
   write(break_string(text, 78, 0, 1));
   write(break_string("\nWenn Du willst, kannst Du die Schriftrolle jetzt "
   +"versiegeln.", 78, 0, 1));

   SetProp(P_SHORT, "Eine Schriftrolle (beschrieben)");
   SetProp(P_NAME_ADJ, 0);
   RemoveAdjective( ({ "leere", "leeren", "leerer" } ));
   SetProp(P_INFO, break_string("Du kannst die Schriftrolle zusammenrollen "
   +"und dann versiegeln.\n\nWenn Du die Schriftrolle loswerden willst, "
   +"kannst Du sie einfach zerreissen.", 78, 0, 1));
   leer = NEIN;
   return;
}

int rollen(string str)
{
  notify_fail("Was willst Du zusammen- oder auseinanderrollen?\n");

  if(!str || str == "") return 0;

  if(str == "rolle zusammen" ||
     str == "schriftrolle zusammen")
  {
      if(gerollt == NEIN)
      {
          write(BS("Du rollst die Schriftrolle zusammen."));
          
          ENV(TP)->Message(BS(TP->Name(WER, 1)+" rollt eine Schriftrolle "
          +"sorgsam zusammen."),
          MSGFLAG_VISUAL|MSGFLAG_NO_TP);
          
          gerollt = JA;
          SetProp(P_SHORT, "Eine Schriftrolle (zusammengerollt)");
          SetProp(P_NAME_ADJ, 0);
          RemoveAdjective( ({ "leere", "leeren", "leerer" } ));
          SetProp(P_INFO, break_string("Du kannst die Schriftrolle "
          +"auseinanderrollen und dann lesen, was auf ihr steht.\n\n"
          +"Wenn Du die Schriftrolle loswerden willst, kannst Du sie "
          +"einfach zerreissen.", 78, 0, 1));
          return 1;
      }
      else
      {
          write(BS("Die Schriftrolle ist bereits zusammengerollt."));
          return -1;
      }
  }
  
  if(str == "rolle auseinander" ||
     str == "schriftrolle auseinander")
  {
     if(gerollt == JA)
     {
        if(versiegelt == NEIN)
        {
            write(BS("Du rollst die Schriftrolle auseinander."));
          
            ENV(TP)->Message(BS(TP->Name(WER, 1)+" rollt eine Schriftrolle "
            +"auseinander."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
          
            if(leer == NEIN)
            {
                SetProp(P_SHORT, "Eine Schriftrolle (beschrieben)");
                SetProp(P_NAME_ADJ, 0);
                RemoveAdjective( ({ "leere", "leeren", "leerer" } ));
            }
            
            if(leer == JA)
            {
                SetProp(P_SHORT, "Eine leere Schriftrolle");
                SetProp(P_NAME_ADJ, "leer");
                AddAdjective( ({ "leere", "leeren", "leerer" } ));
            }

            SetProp(P_INFO, break_string("Mit 'lies rolle' kannst Du lesen, "
            +"was auf der Schriftrolle geschrieben steht.\n\nWenn Du die "
            +"Schriftrolle loswerden willst, kannst Du sie einfach "
            +"zerreissen.", 78, 0, 1));
            gerollt = NEIN;
            return 1;
        }
        else
        {
            write(BS("Das geht nicht, die Schriftrolle wurde versiegelt."));
            return -1;
        }
     }
     else
     {
        write(BS("Die Schriftrolle ist bereits auseinandergerollt."));
        return -1;
     }
  }
}

int versiegeln(string str)
{
  notify_fail("Was willst Du versiegeln?\n");

  if(!str || str == "") return 0;

  if(!(str == "schriftrolle" ||
       str == "rolle")) return 0;

  if(leer == JA)
  {
        write(BS("Meinst Du wirklich, es macht Sinn, eine leere "
        +"Schriftrolle zu versiegeln?"));
        return -1;
  }

  if(versiegelt == NEIN)
  {
     if(gerollt == JA)
     {
        write(BS("Du laesst ein wenig heisses Wachs auf die "
        +"zusammengerollte Schriftrolle tropfen und presst dann Dein "
        +"persoenliches Siegel darauf."));
      
        ENV(TP)->Message(BS(TP->Name(WER, 1)+" versiegelt eine Schriftrolle "
        +"mit heissem Wachs."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      
        SetProp(P_SHORT, "Eine Schriftrolle (versiegelt)");
        SetProp(P_NAME_ADJ, 0);
        RemoveAdjective( ({ "leere", "leeren", "leerer" } ));
        SetProp(P_INFO, break_string("Du koenntest das Siegel einfach "
        +"zerbrechen.\n\nWenn Du die Schriftrolle loswerden willst, "
        +"kannst Du sie einfach zerreissen.", 78, 0, 1));
        versiegelt = JA;
        return 1;
     }
     else
     {
        write(BS("Du solltest die Schriftrolle zuerst zusammenrollen."));
        return -1;
     }
  }
  else
  {
      write(BS("Die Schriftrolle wurde bereits versiegelt."));
      return -1;
  }
}

int entsiegeln(string str)
{
  notify_fail("Was willst Du aufbrechen?\n");

  if(!str || str == "") return 0;

  if(!(str == "siegel auf" ||
       str == "siegel")) return 0;

  if(versiegelt == JA)
  {
      write(BS("Du brichst das Siegel vorsichtig auf."));
      
      ENV(TP)->Message(BS(TP->Name(WER, 1)+" zerbricht das Siegel einer "
      +"Schriftrolle."),
      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      
      SetProp(P_SHORT, "Eine Schriftrolle (entsiegelt)");
      SetProp(P_NAME_ADJ, 0);
      RemoveAdjective( ({ "leere", "leeren", "leerer" } ));
      SetProp(P_INFO, break_string("Das Siegel der Schriftrolle wurde "
      +"zerbrochen.\nDu kannst die Rolle nun einfach auseinanderrollen "
      +"und dann mit 'lies rolle' lesen, was auf ihr steht.\n\n"
      +"Wenn Du die Schriftrolle loswerden willst, kannst Du sie einfach "
      +"zerreissen.", 78, 0, 1));
      versiegelt = NEIN;
      entsiegelt = JA;
      return -1;
  }
  else
  {
      write(BS("Die Schriftrolle ist doch gar nicht versiegelt."));
      return 1;
  }
}

int zerreissen(string str)
{
  notify_fail("Was willst Du zerreissen?\n");

  if(!str || str == "") return 0;

  if(!(str == "schriftrolle" ||
       str == "rolle")) return 0;

  write(BS("Du zerreisst die Schriftrolle in kleine Fetzen."));
      
  ENV(TP)->Message(BS(TP->Name(WER, 1)+" zerreisst eine Schriftrolle."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      
  TO->remove();
  return 1;
}

string out()
{
  int i, n;
  string s, titel;
  string *text;
  text = explode(rollentext, "\n");
  n = sizeof(text);

  s  = "  ________________________________________________________________________ \n";
  s += " / \\                                                                      \\\n";
  s += " \\~/______________________________________________________________________/\n";
  s += "  |                                                                       |\n";


  for(i=0;i<n;i++)
  {
    s += sprintf("  |  %-66s   |\n", text[i]);
  }

  s += "  |                                                                       |\n";
  s += " __\\----- ----- ------------  ------- ----- -------  --------  -----------\\\n";
  s += " \\_/______________________________________________________________________/\n\n";

  return s;
}

