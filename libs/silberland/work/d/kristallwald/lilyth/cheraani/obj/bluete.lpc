#include "../def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

int angesteckt;

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  angesteckt = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine kleine Rosenbluete");
  SetProp(P_LONG,
    "Zutiefst bewundernd betrachtest Du die winzige Rosenbluete in Deinen "
    "Haenden. Ihre zarten Bluetenblaetter sehen aeusserst zerbrechlich und "
    "doch wunderschoen aus. Sie sind zartrosa gefaerbt und duften leicht "
    "nach Rosen.");

  AddDetail( ({ "bluetenblaetter", "blaetter", "bluetenblatt", "blatt" }),
    "Die zarten, feingeformten Bluetenblaetter sind zu einer kleinen "
    "Rosenbluete geformt.");
    
  AddDetail( ({ "rosen", "duft" }),
    "Ein leichter Duft nach frischen Rosen geht von der Bluete aus.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Rosenbluete");
  SetProp(P_NAME_ADJ, "klein");
  AddAdjective( ({ "kleine", "kleinen" }) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_INFO, "Du kannst Dir die Rosenbluete in Dein Haar stecken (und "
  "sie natuerlich auch wieder herausnehmen.");
  AddId( ({"rosenbluete", "bluete"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_HERBAL);
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 70);
  SetProp(P_SMELL, "Die kleine Rosenbluete duftet zart nach frischen Rosen.\n");
  
//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "steck", "stecke" }), "anstecken" );
  AddCmd( ({ "nimm", "nehm", "nehme" }), "abnehmen" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

int anstecken(string str)
{
  notify_fail("Was moechtest Du Dir wohin stecken?\n");

  if(!str || str == "") return 0;

  if(!(str == "rosenbluete in haar" ||
       str == "bluete in haar" ||
       str == "rosenbluete in haare" ||
       str == "bluete in haare" ||
       str == "rosenbluete ins haar" ||
       str == "bluete ins haar")) return 0;

  if(angesteckt == 1)
  {
      write(BS("Aber die Rosenbluete steckt doch bereits in Deinem "
      +"Haar!"));
      return -1;
  }
  else
  {
      write(BS("Du steckst Dir die kleine Rosenbluete in Dein Haar."));
         
      ENV(TP)->Message(BS(TP->Name(WER, 1)+" steckt sich eine kleine "
      +"Rosenbluete in "+(PL->QueryProp(P_GENDER)==MALE?"sein":"ihr")+" "
      +"Haar."),
      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      
      angesteckt = 1;
      return 1;
  }
  
  return 0;
}

int abnehmen(string str)
{
  notify_fail("Was moechtest Du wo herausnehmen?\n");

  if(!str || str == "") return 0;

  if(!(str == "rosenbluete aus haar" ||
       str == "bluete aus haar" ||
       str == "rosenbluete aus haar heraus" ||
       str == "bluete aus haar heraus" ||
       str == "rosenbluete aus haaren" ||
       str == "bluete aus haaren" ||
       str == "rosenbluete aus haaren heraus" ||
       str == "bluete aus haaren heraus")) return 0;

  if(angesteckt == 1)
  {
      write(BS("Du nimmst die Rosenbluete aus Deinem Haar."));

      ENV(TP)->Message(BS(TP->Name(WER, 1)+" nimmt eine Rosenbluete aus "
      +(PL->QueryProp(P_GENDER)==MALE?"seinem":"ihrem")+" Haar."),
      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      
      angesteckt = 0;
      return 1;
  }
  else
  {
      write(BS("Aber die Rosenbluete steckt doch gar nicht in Deinem "
      +"Haar."));
      return -1;
  }
  
  return 0;
}

string extra_look()
{
    if(!ENV(TO)) return "";
    
    if(angesteckt == 1)
    {
       return "Eine kleine Rosenbluete steckt in "
       +(ENV(TO)->QueryProp(P_GENDER)==MALE?"seinem":"ihrem")+" Haar.\n";
    }

    return "";
}
