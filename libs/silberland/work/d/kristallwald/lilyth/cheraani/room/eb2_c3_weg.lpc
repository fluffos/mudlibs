#include "../def.h"

inherit "std/room";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Auf dem Grossen Baum der Cheraani");
  SetProp(P_INT_LONG,
    "Der bewachte Eingang im Sueden.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------
/*
  AddDetail( ({ "" }),
    "");

  AddDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");
*/
//--Ausgaenge--------------------------------------------------------------

//AddExit( "nordwesten", "nach Nordwesten#" + "./eb2_b2_weg" );
//AddExit( "nordosten", "nach Nordosten#" + "./eb2_d2_weg" );
  AddExit( "nordoben", ([ EX_DEST:     "./eb2_c2_aelteste",
                          EX_MSG:      "nach Nordoben",
                          EX_TESTFUNC: "exit_test" ]) );

//--Kommandos--------------------------------------------------------------

//AddCmd( ({ "", "" }), "" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "wache_tarkon", REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

int exit_test(string dir)
{
     object mywaechter;

     if(!TP||!interactive(TP)) return 1;
     mywaechter=present("cheraaniwaechter");
     
     if(mywaechter)
     {
         if(TP->QueryProp(P_ALIGN) < -200)
         {
              write(BS("Der Waechter sagt: Halt! Du kommst hier nicht "
              +"weiter!"));

              TO->Message(BS("Der Waechter haelt "+TP->Name(WEN, 1)+" "
              +"zurueck, als "+(PL->QueryProp(P_GENDER)==MALE?"er":"sie")+" "
              +"den Versammlungsraum der Aeltesten betreten will."),
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);
              return 0;
         }
     }
     return 1;
}
