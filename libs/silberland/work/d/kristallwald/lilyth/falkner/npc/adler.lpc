#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein riesiger Adler");
  SetProp(P_LONG,
    "Ein riesiger Adler dreht ueber Dir seine Runden am Himmel. Er ist "
    "wirklich gewaltig gross und seine ausgebreiteten Schwingen werfen "
    "einen grossen Schatten ueber Dich.");

  AddDetail( ({ "runden" }),
    "Der Adler fliegt ueber Dir am Himmel.");

  AddDetail( ({ "schwingen", "fluegel", "spannweite", "weite" }),
    "Seine Fluegel haben eine gewaltige Spannweite.");

  AddDetail( ({ "schatten" }),
    "Die gewaltigen Schwingen des Adlers werfen einen grossen Schatten "
    "auf Dich herab.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Adler");
  SetProp(P_NAME_ADJ, "riesig");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"adler", "\nFALKadler"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(15);

  SetProp(P_HANDS, ({ " mit seinen scharfen Krallen", 150, 
    ({DT_RIP, DT_BLUDGEON}) }) );

  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 56);
  SetProp(P_WEIGHT, 12000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp( P_REJECT, ({ REJECT_DROP, "" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "stoesst vom Himmel herab auf Dich zu");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "stoesst vom Himmel herab");
  SetProp(P_MMSGOUT, "stoesst einen lauten Schrei aus und fliegt davon");
  
//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " stuerzt tot vom Himmel herab.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Ein riesiger Adler");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "dreht langsam seine Runden am Himmel.\n");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

  AddSpell(1,320,
    Name(WER, 1)+" zerreisst Dich mit seinen scharfen Krallen!\n",
    Name(WER, 1)+" zerreisst @WEN mit seinen scharfen Krallen!\n",
    DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,270,
    Name(WER, 1)+" hackt mit seinem Schnabel nach Dir!\n",
    Name(WER, 1)+" hackt mit seinem Schnabel nach @WEM!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" dreht langsam seine Runden am Himmel.\n",
    Name(WER, 1)+" stoesst einen lauten Schrei aus.\n"}));

  SetAttackChats(10,
  ({Name(WER, 1)+" stoesst einen lauten Schrei aus!\n",
    Name(WER, 1)+" flattert aufgeregt mit seinen Fluegeln.\n",
    Name(WER, 1)+" stuerzt sich fluegelschlagend auf Dich!\n"}));

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

void init()
{
   ::init();
   if(TP && TP->id("\nfalkner")) AddDefender(TP);
   if(TP && TP->id("\nFALKadler")) AddDefender(TP);
   if(find_call_out("fly_away") == -1) call_out("fly_away", 300);
}

void InformDefend(object enemy)
{
   Kill(enemy);
}

void fly_away()
{
   ENV(TO)->Message(BS("Der riesige Adler stoesst einen lauten Schrei "
   +"aus und fliegt davon."), MSGFLAG_SOUND|MSGFLAG_VISUAL);
        
   TO->remove();
   return;
}
