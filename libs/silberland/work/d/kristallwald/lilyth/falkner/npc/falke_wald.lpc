#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------

int haube_auf;
int falke_arm;
string catcher;

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  haube_auf = NEIN;
  falke_arm = NEIN;
  catcher = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Silberfalke");
  SetProp(P_LONG,
    "Der Silberfalke sitzt auf einem grossen Ast ganz in Deiner Naehe und "
    "beaeugt Dich mit schiefgelegtem Kopf. Er hat ein wunderschoenes, "
    "silbergrau glaenzendes Gefieder, das sich zu den Schwingenspitzen hin "
    "immer mehr verdunkelt, bis es schliesslich fast schwarz erscheint. "
    "Seine intelligenten Augen sind goldbraun gesprenkelt und von "
    "orangegelben Ringen umgeben.");

  AddDetail( ({ "ast", "naehe" }),
    "Er sitzt ganz in Deiner Naehe auf einem grossen Ast.");

  AddDetail( ({ "kopf", "seite" }),
    "Sein Kopf ist schraeg auf die Seite gelegt, als er Dich mit "
    "seinem durchdringenden Blick aufmerksam betrachtet.");

  AddDetail( ({ "gefieder", "silbergrau", "federn" }),
    "Sein Gefieder glaenzt silbergrau.");

  AddDetail( ({ "schwingenspitzen", "spitzen", "schwingen", 
  "schwingenspitze", "spitze", "schwinge"}),
    "An den Schwingenspitzen geht das Silbergrau seines Gefieders ganz "
    "allmaehlich in ein tiefes Schwarz ueber.");

  AddDetail( ({ "schwarz" }),
    "Es sieht richtig huebsch aus.");

  AddDetail( ({ "augen", "auge", "blick" }),
    "Der Blick seiner Augen ist aufmerksam auf Dich gerichtet.");

  AddDetail( ({ "ringe", "ring", "ringen" }),
    "Seine Augen sind von orangegelben Ringen umgeben.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Silberfalke");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"falke", "silberfalke", "\nFALKsilberfalke"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(9);

  SetProp(P_HANDS, ({ " mit seinen scharfen Krallen", 90, DT_RIP }) );

  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 30+random(15));
  SetProp(P_WEIGHT, 350+random(370));
  SetProp(P_ALIGN, -40);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann das doch gar nicht tragen.\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "kommt herbeigeflogen");
  SetProp(P_MMSGOUT, "fliegt davon");
  
//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Ein Silberfalke");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "beaeugt Dich aufmerksam.\n",
            "legt seinen Kopf schraeg.\n"}));

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 35);

   AddSpell(1, 150,
     Name()+" stuerzt sich mit seinen scharfen Krallen auf Dich!\n",
     Name()+" stuerzt sich mit seinen scharfen Krallen auf @WEN!\n",
      ({ DT_RIP }),([SP_SHOW_DAMAGE:1]));

   AddSpell(1, 210,
     Name()+" hackt wuetend mit seinem Schnabel nach Dir!\n",
     Name()+" hackt wuetend mit seinem Schnabel nach @WEM!\n",
      ({ DT_RIP }),([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" beaeugt Dich aufmerksam.\n",
    Name(WER, 1)+" stoesst einen lauten Schrei aus.\n",
    Name(WER, 1)+" breitet seine Fluegel aus.\n",
    Name(WER, 1)+" putzt sein Gefieder.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" stoesst einen durchdringenden Schrei aus.\n",
    Name(WER, 1)+" stoesst laut kreischend auf Dich herab.\n",
    Name(WER, 1)+" zerkratzt Dein Gesicht mit seinen Krallen.\n", 
    Name(WER, 1)+" hackt mit seinem Schnabel auf Dich ein.\n" }));

//--Kommandos--------------------------------------------------------------

  AddCmd("lock|locke&falke|falken|silberfalke|silberfalken&mit&maus|waldmaus|leiche&an|heran|herbei", 
  "anlocken", "WEN willst Du WOMIT anlocken?|WOMIT willst Du den Silberfalken anlocken?|WOMIT willst Du den Silberfalken anlocken?|Willst Du den Silberfalken mit der Waldmaus ANLOCKEN?");

  AddCmd("setz|setze&falke|falken|silberfalke|silberfalken&haube|falkenhaube&auf", 
  "aufsetzen", "WAS willst Du WEM aufsetzen?|WAS willst Du dem Falken aufsetzen?|Willst Du vielleicht dem Falken die Falkenhaube AUFSETZEN?");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt einen Silberfalken.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }

  if(catcher == getuid(player))
  {
    catcher = 0;
    remove_call_out("seqfalke");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
    case "albern":
      call_out("reaction", 0, TP,
        "legt seinen Kopf schraeg.",
        "legt seinen Kopf schraeg.");
      break;

    case "aergerlich":
    case "fies":
      call_out("reaction", 0, TP,
        "hackt mit seinem Schnabel nach Dir!",
        "hackt mit seinem Schnabel nach "+TP->name(WEM)+"!");
        TP->AddHp(-5);
      break;

    case "froh":
    case "nett":
    case "frech":
      call_out("reaction", 0, TP,
        "beaeugt Dich aufmerksam.",
        "beaeugt "+TP->name(WEN)+" aufmerksam.");
      break;

    case "intim":
    case "traurig":
      call_out("reaction", 0, TP,
        "reibt seinen Schnabel leicht an Deiner Hand.",
        "reibt seinen Schnabel leicht an "+TP->name(WESSEN)+" Hand.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "breitet seine Fluegel aus.",
        "breitet seine Fluegel aus.");
     break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));

  ENV(TO)->Message(BS(Name(WER, 1)+" "+andere), 
  MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ pl }) ]) );
}

//--Funktionen-------------------------------------------------------------

int anlocken(string str)
{
  object koeder;
  koeder = present("\nFALKkoeder", TP);

  if(present("\nFALKsilberfalke_QuestObj", TP)) 
  {
       write(BS("Aber Du hast doch schon einen Falken bei Dir."));
       return -1;
  }
  
  if(!catcher)
  {
     if(!koeder)
     {
        write(break_string("Du schnalzst leise mit der Zunge und versuchst, "
        +"den Silberfalken anzulocken, doch er scheint sich ueberhaupt nicht "
        +"fuer Dich zu interessieren.\nVielleicht brauchst Du eine Art "
        +"Koeder?", 78,0,1));
        return -1;
     }
     else
     {
        write(BS("Du haeltst dem Falken die tote Waldmaus lockend vor den "
        +"Schnabel."));

        ENV(TP)->Message(BS(TP->Name(WER, 1)+" versucht, den Silberfalken "
        +"mit einer toten Maus anzulocken."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        call_out("seqfalke", 4, TP, 1);
        catcher = getuid(TP);
        return 1;
     }
  }
  else
  {
     if(catcher == getuid(TP))
     {
        write(BS("Aber das tust Du doch schon!"));
        return -1;
     }
     else
     {
        write(BS("Das geht jetzt nicht, "+catcher+" lockt den Falken gerade "
        +"zu sich heran."));
        return -1;
     }
  }
}

int aufsetzen(string str)
{
  object haube;
  haube = present("\nFALKhaube", TP);

  if(!haube)
  {
     write(BS("WEM willst Du WAS aufsetzen?"));
     return -1;
  }

  if(catcher == getuid(TP))
  {
     if(falke_arm == NEIN)
     {
          write(BS("Dafuer ist der Falke doch viel zu weit weg."));
          return -1;
     }

     write(BS("Du setzt dem Silberfalken schnell die Haube auf den "
     +"Kopf, so dass er nichts mehr sehen kann."));

     ENV(TP)->Message(BS(TP->Name(WER, 1)+" setzt dem Silberfalken "
     +"eine Haube auf."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
     haube_auf = JA;
     haube->remove();
     return 1;
  }
  else
  {
     write(BS("Dafuer ist der Falke doch viel zu weit weg."));
     return -1;
  }
}

void seqfalke(object player, int pos)
{
  string s;           //Meldungen fuer den Spieler
  string txt;         //Meldung fuer alle anderen im Raum
  object koeder;
  object *handschuh;
  object *rooms;
  object myfalke;
  object myhandschuh;
  
  koeder = present("\nFALKkoeder", player);       //Koeder vorhanden?
  handschuh = player->QueryArmours(AT_GLOVE);     //Handschuhe an?
  rooms = m_values(ENV(TO)->QueryProp(P_EXITS));  //Ausgaenge vorhanden?
  myhandschuh = present("\nFALKhandschuh", player); //fuers entfluchen...

  s = "";
  txt = "";

  if(!player || ENV(player) != ENV(TO))
  {
     catcher = 0;
     return;
  }

  //Spieler hat Koeder in der Zwischenzeit weggeworfen
  if(!koeder)
  {
     if(!sizeof(rooms))
     {
        tell_object(player, break_string("Der Vogel bemerkt Deinen "
        +"Taeuschungsversuch und fliegt wieder zurueck auf seinen Ast.", 
        78, 0, 1));
        
        ENV(player)->Message(BS("Der Vogel bemerkt "+player->name(WESSEN)+" "
        +"Taeuschungsversuch und fliegt wieder zurueck auf seinen Ast."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        catcher = 0;
        return;
     }
     else
     {
        tell_object(player, break_string("Der Vogel bemerkt Deinen "
        +"Taeuschungsversuch und fliegt empoert davon.", 78, 0, 1));

        ENV(player)->Message(BS("Der Vogel bemerkt "+player->name(WESSEN)+" "
        +"Taeuschungsversuch und fliegt empoert davon."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        TO->move(rooms[random(sizeof(rooms))], M_GO);
        catcher = 0;
        return;
     }
     return;
  }

  //Spieler ist Frosch - selbst schuld ;)
  if(player->QueryProp(P_FROG) == 1)
  {
     tell_object(player, BS("Der Silberfalke fliegt auf Dich zu und "
     +"scheint Dich mit einem Leckerbissen zu verwechseln."));
     
     ENV(player)->Message(BS("Der Silberfalke scheint "+player->name(WEN)+" "
     +"mit einem Leckerbissen zu verwechseln."),
     MSGFLAG_VISUAL|MSGFLAG_NO_TP);

     Kill(TP);
     catcher = 0;
     return;
  }

  //Falke nimmt nix von Geistern
  if(player->QueryProp(P_GHOST) == 1)
  {
     if(!sizeof(rooms))
     {
        tell_object(player, break_string("Der Silberfalke fliegt mit "
        +"entsetztem Kreischen von Dir fort.\nAnscheinend hat er noch nie "
        +"einen Geist gesehen. ;)", 78, 0, 1));

        ENV(player)->Message(break_string("Der Silberfalke fliegt mit "
        +"entsetztem Kreischen von "+player->name(WEM)+" fort.\nAnscheinend "
        +"hat er noch nie einen Geist gesehen.", 78, 0, 1),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        catcher = 0;
        return;
     }
     else
     {
        tell_object(player, break_string("Der Silberfalke fliegt mit "
        +"entsetztem Kreischen davon.\nAnscheinend hat er noch nie "
        +"einen Geist gesehen. ;)", 78, 0, 1));

        ENV(player)->Message(break_string("Der Silberfalke fliegt mit "
        +"entsetztem Kreischen davon, als haette er einen Geist gesehen.", 
        78, 0, 1), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        TO->move(rooms[random(sizeof(rooms))], M_GO);
        catcher = 0;
        return;
     }
     return;
  }

  //wenn soweit alles gutgegangen ist, darf die Sequenz endlich starten:
  switch(pos)
  {
     case 1:
       if( sizeof(handschuh) && !(handschuh[0]->id("\nFALKhandschuh")) )
       {
         tell_object(player, break_string("Der Silberfalke erhebt sich von "
         +"seinem Ast, krallt sich schmerzhaft an Deinem Arm fest, schnappt "
         +"Dir den Koeder aus der Hand und fliegt rasch damit davon.\n"
         +"Vielleicht haettest Du doch besser den dicken Lederhandschuh "
         +"anziehen sollen?", 78, 0, 1));

         ENV(player)->Message(break_string("Der Silberfalke erhebt sich von "
         +"seinem Ast, krallt sich schmerzhaft an "+player->Name(WESSEN)+" "
         +"Arm fest, schnappt sich den Koeder und fliegt rasch damit davon.", 
         78, 0, 1), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

         player->AddHp(-10);
         koeder->remove();
         catcher = 0;

         if(!sizeof(rooms)) return;

         TO->move(rooms[random(sizeof(rooms))], M_GO);
         return;
         break;
       }

       if(!sizeof(handschuh))
       {
         tell_object(player, break_string("Der Silberfalke erhebt sich von "
         +"seinem Ast, krallt sich schmerzhaft an Deinem Arm fest, schnappt "
         +"Dir den Koeder aus der Hand und fliegt rasch damit davon.\nDu "
         +"haettest wohl besser daran getan, Deinen Arm vorher mit einem "
         +"dickeren Handschuh zu schuetzen.", 78, 0, 1));

         ENV(player)->Message(break_string("Der Silberfalke erhebt sich von "
         +"seinem Ast, krallt sich schmerzhaft an "+player->Name(WESSEN)+" "
         +"Arm fest, schnappt sich den Koeder und fliegt rasch damit davon.", 
         78, 0, 1), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

         player->AddHp(-20);
         koeder->remove();
         catcher = 0;

         if(!sizeof(rooms)) return;

         TO->move(rooms[random(sizeof(rooms))], M_GO);
         return;
         break;
       }

       s = "Der Silberfalke erhebt sich von seinem Ast, laesst sich auf "
       +"Deinem gut geschuetzten Arm nieder und beginnt mit Wonne zu "
       +"fressen.";
       
       txt = "Der Silberfalke erhebt sich von seinem Ast, laesst sich auf "
       +player->name(WESSEN)+" Arm nieder und beginnt mit Wonne zu "
       +"fressen.";
       
       falke_arm = JA;
       handschuh[0]->SetProp(P_CURSED, "Du kannst den Handschuh nicht "
       +"ausziehen, solange der Silberfalke auf ihm sitzt!\n");
       break;

     case 2:
         s = "Der Silberfalke zerreisst die tote Maus mit seinem Schnabel "
         +"in kleine Stueckchen.";
         break;

     case 3:
         s = "Der Silberfalke scheint sein Mahl wirklich zu geniessen.";
         break;

     case 4:
         s = "Der Silberfalke hat die tote Maus fast aufgefressen.";
         break;

     case 5:
       if(haube_auf == NEIN)
       {
         s = "Der Silberfalke beendet sein Mahl und breitet seine Schwingen "
            +"aus.";
         break;
       }
       else
       {
         s = "Der Silberfalke bleibt ganz ruhig auf Deinem Arm sitzen.";
         break;
       }

     case 6:
       if(haube_auf == NEIN)
       {
         tell_object(player, break_string("Der Silberfalke stoesst noch "
         +"einen lauten Schrei aus und erhebt sich dann mit einem Ruck "
         +"in die Luefte.", 78, 0, 1));

         ENV(player)->Message(break_string("Der Silberfalke stoesst noch "
         +"einen lauten Schrei aus und erhebt sich dann mit einem Ruck "
         +"in die Luefte.", 78, 0, 1), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

         falke_arm = NEIN;
         catcher = 0;
         if(myhandschuh) myhandschuh->SetProp(P_CURSED, 0);

         if(!sizeof(rooms)) return;

         TO->move(rooms[random(sizeof(rooms))], M_GO);

         return;
         break;
       }
       else
       {
         myfalke = clone_object(OBJ "qfalke");

         if(ME_TOO_HEAVY == myfalke->move(TP,M_GET|M_SILENT))
         {
            myfalke->remove();

            tell_object(player, break_string("Ploetzlich schuettelt der "
            +"Falke seinen Kopf und die Haube rutscht von seinen Augen "
            +"herunter. Mit einem lauten Kreischen fliegt er davon.", 
            78, 0, 1));

            ENV(player)->Message(BS("Ploetzlich schuettelt der Falke seinen "
            +"Kopf und die Haube rutscht von seinen Augen herunter. Mit "
            +"einem lauten Kreischen fliegt er davon."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);

            falke_arm = NEIN;
            haube_auf = NEIN;
            catcher = 0;
            if(myhandschuh) myhandschuh->SetProp(P_CURSED, 0);

            if(!sizeof(rooms)) return;

            TO->move(rooms[random(sizeof(rooms))], M_GO);

            return;
         }

         tell_object(player, BS("Du solltest den Falken jetzt "
         +"schnell zu Friedegard bringen."));

         TO->remove();
         return;
         break;
       }

     default:
       return;
       break;
  }
        
  tell_object(player, break_string(s, 78, 0, 1));
  ENV(player)->Message(break_string(txt, 78, 0, 1), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  pos = pos + 1;
  call_out("seqfalke", 4, player, pos);
}


int Defend(int dam, string dtype, int spell, object enemy)
{
  if(catcher) catcher = 0;
  if(find_call_out("seqfalke") != -1) remove_call_out("seqfalke");
  
  return ::Defend(dam,dtype,spell,enemy);        
}
