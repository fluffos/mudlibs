#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"

inherit "/p/service/angel/haustiere/std_petshop_vendor";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------

#define SP_KOSTEN 90

int fktfalkenhaube();
int fktschutz();

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Friedegard, der Falkner");
  SetProp(P_LONG,
    "Friedegard ist ein grossgewachsener, wenn auch ansonsten recht "
    "unscheinbarer Mann mittleren Alters mit sandfarbenem Haar und "
    "freundlichen braunen Augen. An seiner linken Hand traegt er einen "
    "dick gepolsterten Lederhandschuh, der fast seinen gesamten Unterarm "
    "bedeckt.");

  AddDetail( ({ "alter", "jahre" }),
    "Er scheint etwa dreissig bis vierzig Jahre alt zu sein.");

  AddDetail( ({ "haar", "haare" }),
    "Er hat kurzgeschnittenes, sandfarbenes Haar.");

  AddDetail( ({ "augen", "auge" }),
    "Seine Augen sind von einem hellen, sanften Braun.");

  AddDetail( ({ "braun", "sprenkel", "sprenkeln" }),
    "Ein helles Braun mit winzigen grauen Sprenkeln darin.");

  AddDetail( ({ "hand", "linke hand" }),
    "Seine linke Hand wird von einem dicken Lederhandschuh verdeckt.");

  AddDetail( ({ "rechte hand" }),
    "An seiner rechten Hand traegt er keinen Handschuh.");

  AddDetail( ({ "lederhandschuh", "handschuh" }),
    "Wofuer der wohl gut ist?");

  AddDetail( ({ "unterarm" }),
    "Der Handschuh bedeckt fast den ganzen Unterarm.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Friedegard");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"falkner", "friedegard", "mann", "\nfalkner", "\npetshop_vendor",
  "NOWIMPY"}));
  AddClass( ({CL_HUMAN}) );
  SetProp(P_ARTICLE, 0);

  set_living_name("friedegard");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(19);

  SetProp(P_HANDS, ({ " mit seinen Haenden", 190, DT_BLUDGEON }) );

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 76);
  SetProp(P_WEIGHT, 55000);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "" }) );

//SetProp(P_LOG_INFO, "/lilyth/falkner/falkner");

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt froehlich pfeifend des Weges entlang");
  SetProp(P_MSGOUT, "spaziert froehlich pfeifend");
  SetProp(P_MMSGIN, "erscheint aus dem Wald");
  SetProp(P_MMSGOUT, "verschwindet zwischen den Baeumen");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Friedegard");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "zuckt ratlos mit den Schultern.\n",
            "blickt Dich nachdenklich an.\n",
            "gruebelt vor sich hin.\n"}));

  AddInfo( ({"falke", "falken"}),
    "Ich kann Dir leider im Moment nur einen Wanderfalken oder einen "
    "einen Buntfalken anbieten, da mir mein Silberfalke davongeflogen "
    "ist.",
    "seufzt: ");

  AddInfo( ({"silberfalke", "silberfalken"}),
    "Mein Silberfalke ist mir davongeflogen, dabei habe ich mich immer gut "
    "um ihn gekuemmert. Wenn ich doch bloss jemanden finden wuerde, der "
    "ihn mir zurueckbringt. Ich kann meine anderen Voegel nicht so lange "
    "alleine lassen, sonst wuerde ich ja selbst nach ihm suchen.",
    "jammert: ");

  AddInfo( ({"buntfalke"}),
    "Der Buntfalke hat seinen Namen von seinem huebschen, bunten Gefieder. "
    "Er ist eine sehr kleine Falkenart, durch seine geringe Groesse aber "
    "auch recht schnell und wendig.",
    "sagt eifrig: ");

  AddInfo( ({"gefieder"}),
    "Damit meine ich das Federkleid der Voegel.",
    "sagt: ");

  AddInfo( ({"federkleid"}),
    "Das Federkleid der Voegel nennt man auch Gefieder.",
    "sagt: ");

  AddInfo( ({"falkenart", "falkenarten"}),
    "Es gibt viele, verschiedene Falkenarten.",
    "sagt: ");

  AddInfo( ({"groesse"}),
    "Es gibt grosse und kleine Falken, wie Du Dir sicherlich denken kannst.",
    "sagt: ");

  AddInfo( ({"wanderfalke", "bursche"}),
    "Der Wanderfalke ist ein besonders grosser und kraeftiger Bursche. "
    "Ausserdem ist er einer der schnellsten Jaeger unter den Falken.",
    "sagt stolz: ");

  AddInfo( ({"jaeger", "jagd"}),
    "Die meisten Greifvoegel sind mehr oder weniger gute Jaeger. Viele "
    "von ihnen machen sogar Jagd auf andere Voegel.",
    "sagt: ");

  AddInfo( ({"sperber"}),
    "Der Sperber ist ein flinker, kleiner Greifvogel und ein hervorragender "
    "Flieger.",
    "erklaert: ");

  AddInfo( ({"flieger"}),
    "Ich wuerde auch gerne fliegen koennen...",
    "seufzt sehnsuechtig: ");

  AddInfo( ({"steinadler"}),
    "Der Steinadler mit seinem goldbraunen Gefieder ist ein besonders "
    "prachtvolles Tier. Man nennt ihn auch den Koenig der Luefte, weil "
    "er unglaublich geschickt bei der Jagd ist.",
    "prahlt: ");

  AddInfo( ({"tier", "tiere"}),
    "Auch Voegel sind Tiere, oder etwa nicht?",
    "sagt: ");

  AddInfo( ({"koenig", "koenig der luefte"}),
    "Der Steinadler wird auch Koenig der Luefte genannt.",
    "sagt: ");

  AddInfo( ({"voegel", "vogel", "greifvogel", "greifvoegel"}),
    "Auf der Tafel dort drueben steht, welche Voegel ich Dir im Moment "
    "verkaufen kann.",
    "erklaert: ");

  AddInfo( ({"hilfe"}),
    "Du wuerdest mir wirklich helfen? Oh, ich waere Dir so dankbar, wenn Du "
    "meinen Silberfalken finden wuerdest! Er ist mir einfach so "
    "davongeflogen und muss hier irgendwo im Wald stecken. Sehr weit kann "
    "er nicht geflogen sein. Ach bitte, halte doch einmal nach ihm Ausschau.",
    "sagt hoffnungsvoll: ");

  AddInfo( ({"ausschau"}),
    "Schau Dich einfach ein wenig im Wald um, vielleicht findest Du "
    "meinen Silberfalken ja! Lass mich ueberlegen... Du brauchst noch "
    "eine Falkenhaube und einen Schutz fuer Deine Haende, sonst kannst "
    "Du ihn nicht hierherbringen.",
    "sagt eifrig: ");

  AddInfo( ({"falkenhaube", "haube"}),
  #'fktfalkenhaube);

  AddInfo( ({"handschuh", "lederhandschuh"}),
    "Der Lederhandschuh schuetzt die Haende vor den doch recht scharfen "
    "Krallen der Voegel.",
    "erklaert: ");

  AddInfo( ({"haende"}),
    "Dir seine von feinen Narben ueberzogenen Haende.",
    "zeigt: ");

  AddInfo( ({"narben", "narbe"}),
    "Es kommt schon einmal vor, dass die Voegel einen mit ihren "
    "scharfkantigen Krallen verletzen. Aber das machen sie nicht mit "
    "Absicht.",
    "sagt: ");

  AddInfo( ({"krallen", "kralle"}),
    "Greifvoegel haben wirklich scharfe Krallen, mit denen sie schnell "
    "jemanden verletzen koennen, auch wenn sie es eigentlich gar nicht "
    "wollen.",
    "nickt: ");

  AddInfo( ({"schutz"}),
  #'fktschutz);

  AddInfo( ({"friedegard"}),
    "Das bin ich.",
    "sagt: ");

  AddInfo( ({"beruf"}),
    "Ich bin Falkner von Beruf.",
    "sagt: ");

  AddInfo( ({"falkner"}),
    "Der Beruf des Falkners bringt viel Arbeit, aber auch viel Freude mit "
    "sich.",
    "erklaert: ");

  AddInfo( ({"arbeit", "freude"}),
    "Ich liebe die Arbeit mit meinem Voegeln.",
    "laechelt: ");

  AddInfo( ({"alter"}),
    "Ich bin vorgestern 38 Jahre alt geworden. Warum interessiert Dich das?",
    "sagt misstrauisch: ");

  AddInfo( ({"tethyrwald", "wald"}),
    "auf die Baeume ringsherum.",
    "deutet ");

  AddInfo( ({"baeume", "baum"}),
    "Wir sind hier in einem Wald, da gibt es viele Baeume.",
    "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

  AddSpell(1,250,
    Name(WER, 1)+" boxt Dir mitten ins Gesicht!\n",
    Name(WER, 1)+" boxt @WEM mitten ins Gesicht.\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,380,
    Name(WER, 1)+" bricht Dir mit einem kraeftigen Handkantenschlag die Nase!\n",
    Name(WER, 1)+" bricht @WEM mit einem kraeftigen Handkantenschlag die Nase!\n",
    DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,320,
    break_string(Name(WER, 1)+" tritt Dir mit voller Wucht in den Magen!\n"
    +"Dir wird ganz uebel.\n", BS_LEAVE_MY_LFS, 78, 0, 1),
    break_string(Name(WER, 1)+" tritt @WEM mit voller Wucht in den Magen!n"
    +"@WER kruemmt sich vor Schmerzen.\n", BS_LEAVE_MY_LFS, 78, 0, 1),
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  //Adler zu Hilfe holen
  AddSpell(1,1,
    "",
    "",
    DT_BLUDGEON, "call_help");

//--Chats------------------------------------------------------------------

  SetChats(4,
  ({Name(WER, 1)+" seufzt leise vor sich hin.\n",
    Name(WER, 1)+" schaut zum Himmel hinauf.\n",
    Name(WER, 1)+" fragt hoffnungsvoll: Hast Du meinen Falken gesehen?\n",
    Name(WER, 1)+" sieht ein wenig niedergeschlagen aus.\n",
    Name(WER, 1)+" betrachtet das undurchdringliche Dickicht.\n",
    Name(WER, 1)+" blickt Dich freundlich an.\n", }));

  SetAttackChats(10,
  ({Name(WER, 1)+" ruft erbost: Meine Falken werden Dir die Augen auskratzen!\n",
    Name(WER, 1)+" versucht, Dich zum Stolpern zu bringen.\n",
    Name(WER, 1)+" blickt verzweifelt zum Himmel hinauf.\n",
    Name(WER, 1)+" sagt: Wie kannst Du es wagen!\n",
    Name(WER, 1)+" fragt: Regelst Du Deine Streitigkeiten immer mit Gewalt?!\n" }));

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME("/p/armour/armour/lederruestung");
  CLONEME("/p/armour/boots/lederstiefel");
  command("trage alles");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt den Falkner.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": Der Falkner hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "schaut Dich verwundert an.",
        "schaut "+TP->name(WEN)+" verwundert an.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "runzelt die Stirn.",
        "runzelt die Stirn.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "grinst Dich belustigt an.",
        "grinst "+TP->name(WEN)+" belustigt an.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "knurrt: Hey, lass das sofort bleiben!",
        "knurrt: Hey, lass das sofort bleiben!");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "raeuspert sich.",
        "raeuspert sich.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "laechelt freundlich.",
        "laechelt freundlich.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "erroetet und stammelt verlegen etwas.",
        "erroetet und stammelt verlegen etwas.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "nickt Dir freundlich zu.",
        "nickt "+TP->name(WEM)+" freundlich zu.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "blickt Dich freundlich an.",
        "blickt "+TP->name(WEN)+" freundlich an.");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        "troestet "+TP->name(WEN)+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Adler herbeirufen:
void call_help(object enemy,int damage,string damtype)
{
  object adler;

  if(QueryProp(P_SP) < SP_KOSTEN || present("\nFALKadler", MENV))
  {
    return; //zu wenig MP oder es ist schon ein Adler da -> Abbruch
  }

  AddSp(-SP_KOSTEN);

  adler = clone_object(NPC "adler");

  if(adler && ENV(TO))
  {
    ENV(TO)->Message(BS("Ploetzlich taucht ein riesiger Adler ueber Dir am "
    +"Himmel auf."), MSGFLAG_VISUAL);

    adler->move(ENV(TO),M_GO|M_SILENT);
    adler->Kill(enemy);
  }
  else
  {
    //Adler removen, wenn beim Clonen was schiefgegangen ist
    adler->remove();
  }

  return;
}


//Spieler gibt ihm den Falken:
void give_notify(object was)
{
   if(was->id("\nFALKsilberfalke_QuestObj"))
   {
      if(find_call_out("QUEST_GELOEST") == -1)
      {
          write(break_string("Du hast ihn mir zurueckgebracht! Danke, "
          +TP->Name(WER)+"!", 78, "Friedegard jubelt: "));

          ENV(TO)->Message(break_string("Du hast ihn mir zurueckgebracht!\n"
          +"Danke, "+TP->Name(WER)+"!", 78, "Friedegard jubelt: "),
          MSGFLAG_VISUAL|MSGFLAG_NO_TP);

          call_out("QUEST_GELOEST", 3, TP, 1);

          was->remove();
          return;
      }

      write(break_string("Einen Moment, ich bin gerade beschaeftigt.\n"
      +"Versuch es doch bitte gleich noch einmal.", 78,
      "Friedegard sagt: ", 1));
      return ::give_notify(was);
    }

    write(BS(Name(WER, 1)+" wundert sich: Aber das brauchst Du doch "
    +"bestimmt noch."));
    return ::give_notify(was);
}


//Quest wurde erfolgreich geloest:
void QUEST_GELOEST(object player, int pos)
{
  string s;
  string txt;
  object mygutschein;
  object handschuh;
  handschuh = present("\nFALKhandschuh", TP);

  s = "";
  txt = "";

  if(!player || ENV(player) != ENV(TO))
  {
     return;
  }

  switch(pos)
  {
     case 1:
         s = Name(WER, 1)+" strahlt: Weisst Du was? Da Du mir so sehr "
             +"geholfen hast, bekommst Du auch eine Kleinigkeit von mir. "
             +"Ich hoffe, Du kannst etwas damit anfangen.";
         txt = Name(WER, 1)+" strahlt "+player->name(WEN)+" freudig an "
             +"und sagt dann noch etwas, das Du nicht verstehst.";
         break;

     case 2:
        mygutschein = clone_object("/p/service/angel/haustiere/obj/100k_gutschein");

        s = "";
        txt = "";

        switch(player->GiveQuest(QUESTNAME))
        {
          case 1:
            write_file(QUESTLOG "quest.log",
             dtime(time())+": "+CAP(getuid(player))+" loest die Quest.\n");
    //      write_file("/log/quests/falkner",
    //       dtime(time())+": "+CAP(getuid(player))+" loest die Quest.\n");

            s = Name(WER, 1)+" gibt Dir einen Gutschein.";
            txt = Name(WER, 1)+" drueckt "+player->name(WEM)+" etwas "
                  +"in die Hand.";

            if(ME_TOO_HEAVY == mygutschein->move(player, M_GET|M_SILENT))
            {
               mygutschein->move(ENV(player), M_PUT|M_SILENT);

               tell_object(player, BS("Du kannst den Gutschein nicht "
               +"mehr tragen und legst ihn vorerst auf dem Boden ab."));
            }

            if(handschuh)
            {
                handschuh->remove();
            }

            call_other("/d/kristallwald/lilyth/falkner/room/falknerlichtung",
            "sell_falke", 0);

            break;

          case -1:
            write_file(QUESTLOG "quest.log",
             dtime(time())+": "+CAP(getuid(player))+" GiveQuest schlug "
             +"fehl!!! -1 (Bereits geloest!)\n");

            tell_object(player, break_string("Leider kann ich Dir nicht "
             +"noch einen Gutschein geben, da Du mir schon einmal "
             +"geholfen und Deine Belohnung bereits erhalten hast.\n"
             +"Sollte das nicht stimmen, wende Dich bitte an "
             +"einen anwesenden Magier.", 78, "Friedegard sagt: ", 1));

            if(handschuh)
            {
                handschuh->remove();
            }

            call_other("/d/kristallwald/lilyth/falkner/room/falknerlichtung",
            "sell_falke", 0);

            break;

          case -2:
            write_file(QUESTLOG "quest.log",
             dtime(time())+": "+CAP(getuid(player))+" GiveQuest schlug "
             +"fehl!!! -2 (Quest nicht angemeldet!)\n" );

            tell_object(player, BS("Die Quest ist leider noch nicht "
             +"angemeldet! Sollte es diese Quest dennoch geben, wende "
             +"Dich SOFORT an einen anwesenden Magier!"));
            break;

          case -3:
            write_file(QUESTLOG "quest.log",
             dtime(time())+": "+CAP(getuid(player))+" GiveQuest schlug "
             +"fehl!!! -3 (Unbefugter Zugriff!)\n" );

            tell_object(player, BS("Unbefugter Zugriff, wende Dich "
             +"bitte SOFORT an einen anwesenden Magier!"));
            break;

          case -4:
            write_file(QUESTLOG "quest.log",
             dtime(time())+": "+CAP(getuid(player))+" GiveQuest schlug "
             +"fehl!!! -4 (Quest deaktiviert)\n" );

            tell_object(player, BS("Die Quest ist deaktiviert!"));
            break;

          default:
            write_file(QUESTLOG "quest.log",
             dtime(time())+": "+CAP(getuid(player))+" UNBEKANNTER FEHLER!!\n");

            tell_object(player, BS("Unbekannter Fehler!! Bitte wende Dich "
             +"SOFORT an einen anwesenden Magier!!!"));
            break;
        }

        break;

     default:
        return;
        break;
  }

  tell_object(player, break_string(s, 78, 0, 1));
  ENV(TO)->Message(break_string(txt, 78, 0, 1), MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

  pos = pos + 1;
  call_out("QUEST_GELOEST", 4, player, pos);
}

//Falkenhaube geben:
int fktfalkenhaube()
{
  object myhaube;

  if(present("\nFALKhaube", TP))
  {
     tell_object(TP, break_string("Aber Du hast doch schon "
     +"eine Falkenhaube von mir bekommen!", 78, "Friedegard sagt: "));
     return -1;
  }
  else
  {
     myhaube = clone_object(OBJ "falkenhaube");

     if(ME_TOO_HEAVY == myhaube->move(TP,M_GET|M_SILENT))
     {
          tell_object(TP, break_string("Hm, Du kannst die Haube "
          +"leider nicht mehr tragen. Leg lieber erstmal etwas ab.", 78,
          "Friedegard sagt: "));

          myhaube->remove();
          return -1;
     }
     else
     {
          tell_object(TP, break_string("Die Falkenhaube hindert den Falken "
          +"daran, einfach wegzufliegen. Wenn Du ihm die Haube aufgesetzt "
          +"hast, kann er seine Umgebung nicht sehen und bleibt ruhig auf "
          +"Deinem Arm sitzen.", 78, "Friedegard sagt eifrig: "));

          tell_object(TP, BS(Name(WER, 1)+" gibt Dir eine "
          +"Falkenhaube."));

          ENV(TO)->Message(BS(Name(WER, 1)+" gibt "+TP->name(WEM)+" "
          +"eine Falkenhaube."),
          MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ TP })]));
          return 1;
     }
  }
}


//Handschuh geben:
int fktschutz()
{
  object myhandschuh;

  if(present("\nFALKhandschuh", TP))
  {
     tell_object(TP, break_string("Aber Du hast doch schon "
     +"einen Handschuh von mir bekommen!", 78, "Friedegard sagt: "));
     return -1;
  }
  else
  {
     myhandschuh = clone_object(ARMOUR "fhandschuh");

     if(ME_TOO_HEAVY == myhandschuh->move(TP,M_GET|M_SILENT))
     {
         tell_object(TP, break_string("Hm, Du kannst den Handschuh "
         +"gar nicht mehr tragen. Leg lieber erstmal etwas ab.", 78,
         "Friedegard sagt: "));

         myhandschuh->remove();
         return -1;
     }
     else
     {
         tell_object(TP, break_string("Warte, ich gebe Dir am "
         +"besten meinen Handschuh mit, dann kann Dich der Falke nicht "
         +"verletzen.", 78, "Friedegard sagt: "));

         tell_object(TP, BS(Name(WER, 1)+" gibt Dir einen dicken "
         +"Lederhandschuh."));

         ENV(TO)->Message(BS(Name(WER, 1)+" gibt "+TP->name(WEM)+" "
         +"einen dicken Lederhandschuh."),
         MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ TP })]));
         return 1;
     }
  }
}
