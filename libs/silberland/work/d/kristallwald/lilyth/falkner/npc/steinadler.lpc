#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

inherit "/p/service/angel/haustiere/std_pet.lpc";

//--Create-----------------------------------------------------------------

void create()
{
  SetProp (P_PET_PRICE, 144000);
  SetProp (P_PET_LEVEL, 12);
  	
  if(!is_clone(TO)) return;

  ::create();

//--Bezeichnungen----------------------------------------------------------

  SetProp(P_NAME, "Steinadler");
  SetProp(P_GENDER, MALE);
  AddId(({"steinadler", "adler", "FEDERN_WUSCHEL"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE,1);
  
  SetProp(P_PET_ENEMIES, ({ }) );
  SetProp(P_PET_FOOD, (["leiche":3, "kaninchen":2, "vogelfutter":1, "Nahrung":0]) );

//--Eigenschaften----------------------------------------------------------

  create_default_npc(12);

  SetProp(P_HANDS, ({" mit seinen scharfen Krallen"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_RIP})
                    })  );

  SetProp(P_RACE, "Steinadler");
  SetProp(P_SIZE, 80+random(15));
  SetProp(P_WEIGHT, 3000+random(3500));
  SetProp(P_ALIGN, -40);
  SetProp(P_MAX_HANDS, 2);

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt weiter");
  SetProp(P_MMSGIN, "kommt herbeigeflogen");
  SetProp(P_MMSGOUT, "fliegt davon");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 30);

   AddSpell(1, 120,
     Name()+" stuerzt sich mit lautem Gekreische auf Dich!\n",
     Name()+" stuerzt sich mit lautem Gekreische auf @WEN!\n",
      ({ DT_BLUDGEON }),([SP_SHOW_DAMAGE:1]));

   AddSpell(1, 150,
     Name()+" hackt wuetend mit seinem Schnabel nach Dir!\n",
     Name()+" hackt wuetend mit seinem Schnabel nach @WEM!\n",
      ({ DT_RIP }),([SP_SHOW_DAMAGE:1]));

   AddSpell(1, 220,
     Name()+" zerreisst Dich mit seinen scharfen Krallen!\n",
     Name()+" zerreisst @WEN mit seinen scharfen Krallen!\n",
      ({ DT_RIP }),([SP_SHOW_DAMAGE:1]));

//--Create Ende------------------------------------------------------------

}
