#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine kleine Waldmaus");
  SetProp(P_LONG,
    "Eine vorwitzige kleine Waldmaus mit schwarzen Knopfaugen, leicht "
    "zitternden Schnurrbarthaaren und winzigen Pfoten huscht hier auf "
    "dem Boden herum. Sie scheint wohl auf Nahrungssuche zu sein, "
    "denn sonst haette sie sich sicherlich nicht aus ihrem Nest gewagt.");

  AddDetail( ({ "knopfaugen", "augen", "knopfauge", "auge" }),
    "Sie sind tiefschwarz und glaenzend.");

  AddDetail( ({ "schnurrbarthaare", "schnurrbarthaar", "barthaare", 
  "barthaar", "haare", "haar", "nase" }),
    "Die Schnurrbarthaare zittern leicht, als die kleine Maus ihre "
    "Nase pruefend in die Luft haelt.");

  AddDetail( ({ "pfote", "pfoten" }),
    "Auf ihren vier winzigen Pfoten huscht sie flink hin und her.");

  AddDetail( ({ "nahrungssuche", "suche" }),
    "Auch eine Waldmaus muss ab und zu mal etwas fressen.");

  AddDetail( ({ "nest" }),
    "Nur selten wagt sich die kleine Waldmaus aus ihrem schuetzenden Nest.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Waldmaus");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"waldmaus", "maus"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(3, 50);

  SetProp(P_HANDS, ({ " mit ihren winzigen Pfoten", 30, DT_BLUDGEON }) );

  SetProp(P_RACE, "Maus");
  SetProp(P_SIZE, 11);
  SetProp(P_WEIGHT, 20);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 50);
  SetProp(P_NOMAGIC, 0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann das doch gar nicht tragen.\n" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "huscht herein");
  SetProp(P_MSGOUT, "huscht");
  SetProp(P_MMSGIN, "klettert aus einem Loch im Boden");
  SetProp(P_MMSGOUT, "verschwindet blitzschnell in einem Loch im Boden");
  
//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_CORPSE, OBJ "koeder");
  SetProp(P_KILL_NAME, "Eine kleine Waldmaus");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "quiekt aufgeregt.\n",
            "blickt Dich neugierig mit ihren Knopfaugen an.\n"}));

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" schnuppert auf dem Boden herum.\n",
    Name(WER, 1)+" sucht auf dem Waldboden nach Nahrung.\n",
    Name(WER, 1)+" quiekt aufgeregt.\n",
    Name(WER, 1)+" versucht, ein kleines Loch zu graben.\n",
    Name(WER, 1)+" huscht leise hin und her.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" sucht nach einem Loch im Boden.\n",
    Name(WER, 1)+" quiekt voellig veraengstigt.\n",
    Name(WER, 1)+" hat panische Angst vor Dir.\n" }));

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt eine Waldmaus.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
    case "neutral":
      call_out("reaction", 0, TP,
        "sucht auf dem Waldboden nach Nahrung.",
        "sucht auf dem Waldboden nach Nahrung.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "zittert am ganzen Leib.",
        "zittert am ganzen Leib.");
      break;

    case "albern":
    case "nett":
      call_out("reaction", 0, TP,
        "flitzt rasch auf dem Boden hin und her.",
        "flitzt rasch auf dem Boden hin und her.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "quiekt entsetzt auf und verkriecht sich voellig veraengstigt.",
        "quiekt entsetzt auf und verkriecht sich voellig veraengstigt.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "versucht, Dich mit ihren winzigen Zaehnchen zu beissen.",
        "versucht, "+TP->name(WEN)+" mit ihren winzigen Zaehnchen zu beissen.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "streckt ihre winzige Nase in die Luft und schnuppert aufgeregt.",
        "streckt ihre winzige Nase in die Luft und schnuppert aufgeregt.");
      break;

    case "intim":
    case "traurig":
      call_out("reaction", 0, TP,
        "schnuppert zutraulich an Deiner Hand herum.",
        "schnuppert zutraulich an "+TP->name(WESSEN)+" Hand herum.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));

  ENV(TO)->Message(BS(Name(WER, 1)+" "+andere), 
  MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ pl }) ]) );
}
