#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

inherit "/p/service/angel/haustiere/std_pet.lpc";

//--Create-----------------------------------------------------------------

void create()
{
  SetProp (P_PET_PRICE, 9000);
  SetProp (P_PET_LEVEL, 3);
  	
  if(!is_clone(TO)) return;

  ::create();

//--Bezeichnungen----------------------------------------------------------

  SetProp(P_NAME, "Buntfalke");
  SetProp(P_GENDER, MALE);
  AddId(({"buntfalke", "falke", "FEDERN_WUSCHEL"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE,1);
  
  SetProp(P_PET_ENEMIES, ({ }) );
  SetProp(P_PET_FOOD, (["leiche":3, "maus":2, "vogelfutter":1, "Nahrung":0]) );

//--Eigenschaften----------------------------------------------------------

  create_default_npc(3);

  SetProp(P_HANDS, ({" mit seinem spitzen Schnabel"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_RIP})
                    })  );

  SetProp(P_RACE, "Buntfalke");
  SetProp(P_SIZE, 20+random(10));
  SetProp(P_WEIGHT, 100+random(100));
  SetProp(P_ALIGN, -40);
  SetProp(P_MAX_HANDS, 2);

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt weiter");
  SetProp(P_MMSGIN, "kommt herbeigeflogen");
  SetProp(P_MMSGOUT, "fliegt davon");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 30);

   AddSpell(1, 55,
     Name()+" hackt mit seinem Schnabel nach Dir!\n",
     Name()+" hackt mit seinem Schnabel nach @WEM!\n",
      ({ DT_RIP }),([SP_SHOW_DAMAGE:1]));

//--Create Ende------------------------------------------------------------

}
