#include "../def.h"
#include <laden.h>
#include "/p/service/angel/haustiere/std_pet.h"

inherit "/p/service/angel/haustiere/std_petshop";

//--Variablen&Defines------------------------------------------------------
 
string tafel(string key);
void PreparePet();

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------

  RemoveItem("/obj/entsorg");

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"Auf einer kleinen Lichtung");
  SetProp(P_INT_LONG, 
    "Eine kleine Waldlichtung. Die Sonne scheint, die Voegel zwitschern "
    "und der Himmel ist strahlend blau. Ein paar seltsame Holzpfloecke "
    "wurden hier aufgestellt. Mitten in der Luft haengt eine grosse "
    "Tafel, die Du lesen kannst.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_SHOPKEEPER_ID, "falkner");
  SetProp(P_SHOPKEEPER_NAME, "Friedegard");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  catch(call_other(ROOM "falknerstore", "???"));
  SetStorageRoom(ROOM "falknerstore");
 
  SetProp(P_PET_KONFIG_TOOL, "/d/kristallwald/lilyth/falkner/obj/floete");

  AddPet("buntfalke", "/d/kristallwald/lilyth/falkner/npc/buntfalke");
  AddPet("wanderfalke", "/d/kristallwald/lilyth/falkner/npc/wanderfalke");
  AddPet("steinadler", "/d/kristallwald/lilyth/falkner/npc/steinadler");
  AddPet("sperber", "/d/kristallwald/lilyth/falkner/npc/sperber");

//--Details----------------------------------------------------------------

//AddDetail( ({ "" }),
//  "");

  AddReadDetail ( ({ "tafel", "preistafel"}), #'tafel );

  AddSound( DEFAULT_SOUND,
    "Nix zu hoeren.");

  AddSound( ({ "voegel" }),
    "Vogelgezwitscher.");

  AddSmell( DEFAULT_SMELL,
    "Nix zu riechen.");

  AddSmell( ({ "nix" }),
    "Wirklich nix.");

//--Ausgaenge--------------------------------------------------------------

  //AddExit( "westen", "aus dem Geschaeft#" + "./mg_gang2" );

//--Kommandos--------------------------------------------------------------



//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "falkner", REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//Preisliste immer neu generieren:
string tafel(string key)
{
  return GetPriceList();
}

//Spieler sollen hier nix verkaufen:
int sell(string str, int f)
{
  string prefix;

  if (!prefix=CheckKeeper(2)) return 0;

  write(capitalize(QueryProp(P_SHOPKEEPER_NAME))+
       " sagt: Ich kaufe nichts!\n");
  return -1;
}

//nach Loesen der Quest wird auch der Silberfalke verkauft:
void sell_falke()
{
  AddPet("sperber", "/d/kristallwald/lilyth/falkner/npc/silberfalke");
  return;
}

//im Reset Silberfalken wieder entfernen:
void reset()
{
  RemovePet("silberfalke");
  return ::reset();
}
