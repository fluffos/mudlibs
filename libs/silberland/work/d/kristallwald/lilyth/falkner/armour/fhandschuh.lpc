#include "../def.h"

inherit "std/armour";

//--Create-----------------------------------------------------------------

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein dicker Lederhandschuh");
  SetProp(P_LONG,
    "Dieser Lederhandschuh besteht aus einem sehr dicken, "
    "widerstandsfaehigen Leder, das die Hand, auf dem er getragen wird, "
    "besonders gut vor spitzen Vogelkrallen schuetzt. Das Leder sieht "
    "schon ziemlich alt und zerkratzt aus.");

  AddDetail( ({ "leder" }),
    "Es ist besonders widerstandsfaehig, aber schon ein wenig zerkratzt.");

  AddDetail( ({ "hand", "einzelstueck", "stueck" }),
    "Dieser Handschuh ist ein Einzelstueck und wird normalerweise nur "
    "auf einer Hand getragen.");

  AddDetail( ({ "vogelkrallen", "krallen" }),
    "Durch diesen Handschuh spuert man sie nicht.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Lederhandschuh");
  SetProp(P_NAME_ADJ, "dick");
  AddAdjective( ({ "dicker", "dicken", "dickem" } ));
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 0);
  AddId( ({ "handschuh", "lederhandschuh", "\nFALKhandschuh" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_LEATHER: 100 ]));
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 0);
  SetProp(P_NEVERDROP, 0);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 5);
  SetProp(P_QUALITY_DECAY, 100);

//--Create Ende------------------------------------------------------------

}
