inherit "/p/service/angel/haustiere/std_pet_item.lpc";

#include "../def.h"
#include <properties.h>
#include <moving.h>
#include "/p/service/angel/haustiere/std_pet.h"

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine kleine blaue Floete");
  SetProp(P_LONG,
    "Mit der kleinen, blauen Floete, die Dir an einer feingliedrigen "
    "Kette um den Hals baumelt, kannst Du Dein Haustier jederzeit "
    "zu Dir rufen.");

  AddDetail( ({ "kette", "silberkette" }),
    "Die Floete haengt an einer schmalen, feingliedrigen Silberkette "
    "um Deinen Hals. So kannst Du sie nicht so leicht verlieren.");

  AddDetail( ({ "silber", "glied", "glieder" }),
    "Die Glieder der Kette bestehen aus glaenzendem Silber.");

  AddDetail( ({ "hals" }),
    "Die Floete haengt an einer silbernen Kette um Deinen Hals.");

  AddDetail( ({ "haustier", "tier" }),
    "Du hast eines.");

//--Namen------------------------------------------------------------------

   SetProp(P_INFO,
     "Mit dieser kleinen Floete kannst Du folgendes tun:\n"
    +"---------------------------------------------\n"
    +"spielen:   Damit kannst Du Dein Haustier zu Dir holen.\n"
    +"pethelp:   Dieses Kommando zeigt Dir einen Hilfetext an.\n"
    +"petconfig: Damit kannst Du Dein Haustier veraendern.\n\n"
    +"entlasse <haustiername> fuer immer:\n"
    +"(WARNUNG: laesst sich nicht wieder rueckgaengig machen!)\n\n" );

  SetProp(P_NAME, "Floete");
  SetProp(P_NAME_ADJ, "blau");
  AddAdjective( ({ "blaue", "blauen" } ));
  SetProp(P_GENDER, FEMALE);
  AddId( ({"floete"}) );
  seteuid(getuid(this_object()));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_WOOD);
  SetProp(P_WEIGHT, 5);

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "spiel", "spiele" }), "BringPetBack" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

void _delay(string args)
{
	::BringPetBack(args);
}

int BringPetBack(string args)
{
   if(args == "floete")
   {
   	write(BS("Du spielst eine kurze Melodie auf Deiner Floete.\n"));
   	
        TO->Message(TP->Name(WER, 1)+" spielt auf einer kleinen Floete.\n",
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        call_out("_delay", 2, args);
        return 1;
   }
   
   notify_fail ("Was moechtest Du spielen?\n");
   return 0;
}
