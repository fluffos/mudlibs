#include "../def.h"

inherit "std/thing";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine tote Waldmaus");
  SetProp(P_LONG,
    "Mit spitzen Fingern haeltst Du den kleinen, feingliedrigen Koerper "
    "einer toten Waldmaus in den Haenden. Auch wenn Dir die Maus fast ein "
    "klein wenig leid tut, scheint dies doch der perfekte Koeder fuer einen "
    "groesseren Raubvogel zu sein.");

  AddDetail( ({ "finger", "haende" }),
    "Mit spitzen Fingern haeltst Du die kleine Maus fest.");

  AddDetail( ({ "koerper" }),
    "Er liegt schlaff und kraftlos in Deinen Haenden.");

  AddDetail( ({ "raubvogel" }),
    "Nun, die meisten Raubvoegel fressen doch so etwas, oder nicht?");

  AddDetail( ({ "koeder" }),
    "Diese tote Maus ist der perfekte Koeder fuer einen Raubvogel.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Waldmaus");
  SetProp(P_NAME_ADJ, "tot");
  AddAdjective( ({ "tote", "toten" } ));
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "waldmaus", "maus", "leiche", "\nFALKkoeder" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, break_string("Mit dieser toten Maus koenntest Du vielleicht einen "
  +"Raubvogel anlocken.\nHinweis: Mit 'vernichte leiche' kannst Du die "
  +"Maus auch einfach loswerden.", 78,0,1));
  SetProp(P_MATERIAL, ([MAT_BONE: 45, MAT_FLESH:50, MAT_BLOOD: 5]) );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "vernicht", "vernichte" }), "vernichten" );


//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

int vernichten(string str)
{
  notify_fail("Was willst Du vernichten?\n");

  if(!str || str == "") return 0;

  if(!(str == "maus" ||
       str == "waldmaus" ||
       str == "leiche")) return 0;

  write(BS("Du entsorgst die Ueberreste der toten Maus ordentlich."));
  TO->remove();
  return 1;
}
