#include "../def.h"

inherit "std/thing";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Silberfalke");
  SetProp(P_LONG,
    "Auf dem dicken Lederhandschuh, den Du angezogen hast, sitzt ein "
    "prachtvoller Silberfalke. Ueber seinen Kopf ist eine duenne Lederhaube "
    "gezogen, so dass er die Umgebung nicht sehen kann und daher ruhig auf "
    "Deinem Arm sitzenbleibt. Du solltest ihn so schnell wie moeglich zu "
    "Friedegard, dem Falkner, bringen, damit dieser sich um ihn kuemmern "
    "kann.");

  AddDetail( ({ "kopf" }),
    "Sein Kopf wird von einer duennen Lederhaube verdeckt.");

  AddDetail( ({ "lederhaube", "haube" }),
    "Sie sorgt dafuer, dass der Falke seine Umgebung nicht sehen kann.");

  AddDetail( ({ "umgebung" }),
    "Schau Dich doch einfach um.");

  AddDetail( ({ "arm" }),
    "Der Falke sitzt seelenruhig auf Deinem Arm.");

  AddDetail( ({ "friedegard", "falkner" }),
    "Er wird sich bestimmt sehr darueber freuen, dass Du ihm seinen "
    "Lieblingsfalken wiederbringst.");

  AddDetail( ({ "lieblingsfalke", "lieblingstier" }),
    "Dieser Silberfalke ist das Lieblingstier von Friedegard, dem Falkner.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Silberfalke");
  SetProp(P_GENDER, MALE);
  AddId( ({ "silberfalke", "falke", "\nFALKsilberfalke_QuestObj" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_MISC_LIVING: 100]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_INFO, "Am besten waere es, Du wuerdest diesen Falken schnell "
  +"zu Friedegard, dem Falkner, bringen, dem er ausgebuext ist. "
  +"Andererseits koenntest Du ihn natuerlich auch einfach wieder "
  +"freilassen, damit der arme Falke seine Freiheit noch ein Weilchen "
  +"laenger geniessen kann.");

//--Kommandos--------------------------------------------------------------

  AddCmd("lass|lasse&falke|falken|silberfalke|silberfalken&frei|fliegen", 
  "freilassen", "Was willst Du tun?|Was genau willst Du denn machen? Vielleicht den Falken freilassen?");

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

int freilassen(string str)
{
   handschuh = present("\nFALKhandschuh", TP);
 
   write(break_string("Du nimmst dem Falken vorsichtig die Haube ab.\n"
   +"Der Falke stoesst sich von Deinem Arm ab, erhebt sich mit einem "
   +"lauten Kreischen in die Luft und entschwindet langsam Deinem Blick."));

   ENV(TP)->Message(BS(TP->Name(WER, 1)+" nimmt dem Silberfalken seine "
   +"Haube ab und laesst ihn fliegen."), 
   MSGFLAG_VISUAL|MSGFLAG_NO_TP);

   if(handschuh) handschuh->SetProp(P_CURSED, 0);
   TO->remove();
   return 1;
}

varargs int move(mixed dest,int method)
{
  if(objectp(dest))
  {
    if(dest->id("\nfalkner")) method = method | M_NOCHECK;
  }

  return ::move(dest, method);
}
