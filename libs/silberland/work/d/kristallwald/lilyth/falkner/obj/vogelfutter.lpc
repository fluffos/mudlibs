#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"

inherit "/std/thing.lpc";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Vogelfutter");
  SetProp(P_LONG,
    "Diese Futtermischung ist nur fuer groessere Voegel wie Falken, Adler "
    "oder andere Greifvoegel geeignet, denn es besteht aus grob "
    "geschnittenen Fleischstueckchen, deren Herkunft nicht mehr ganz "
    "eindeutig scheint.");

  AddDetail( ({ "futtermischung", "mischung" }),
    "Es ist eine bunte Mischung aus verschiedenen Fleischstueckchen.");

  AddDetail( ({ "falken", "adler", "greifvoegel", "art" }),
    "Dieses Futter schmeckt Greifvoegeln aller Art besonders gut.");

  AddDetail( ({ "fleisch", "fleischstueckchen", "fleischstuecke", 
  "stueckchen", "stuecke", "fleischstueck", "stueck" }),
    "Die Fleischstueckchen sind recht gross und daher nur fuer grosse "
    "Vogelarten geeignet.");

  AddDetail( ({ "herkunft" }),
    "So ganz genau kann man wohl nicht mehr sagen, von welchen Tieren "
    "die Fleischstuecke stammt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Vogelfutter");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"vogelfutter", "futter"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 40);
  SetProp(P_SMELL, "Das Vogelfutter riecht nach frischem Fleisch.\n");
  
//--Create Ende------------------------------------------------------------

}
