#include "../def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Falkenhaube");
  SetProp(P_LONG,
    "Diese kleine Lederhaube besteht eigentlich nur aus einem einfachen "
    "Stueck sehr duennem Leder, das an zwei Enden mit jeweils einem "
    "schmalen Lederband versehen ist.");

  AddDetail( ({ "stueck", "leder" }),
    "Das Leder ist sehr duenn und fuehlt sich angenehm weich an.");

  AddDetail( ({ "enden", "ende" }),
    "An zwei Enden wurde ein schmales Lederband befestigt.");

  AddDetail( ({ "lederband", "band" }),
    "Es ist ebenfalls anschmiegsam weich.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Falkenhaube");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "falkenhaube", "haube", "lederhaube", "\nFALKhaube" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, break_string("Diese Haube wurde extra fuer Falken gemacht.\n"
  +"Mit 'zerfetze Haube' kannst Du sie auch einfach loswerden.", 78,0,1));
  SetProp(P_MATERIAL, ([MAT_LEATHER: 100]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 5);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "zerfetz", "zerfetze" }), "zerfetzen" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

int zerfetzen(string str)
{
  notify_fail("Was willst Du zerfetzen?\n");

  if(!str || str == "") return 0;

  if(!(str == "haube" ||
       str == "falkenhaube")) return 0;

  write(BS("Du zerfetzt die Falkenhaube in kleine Stueckchen."));
  TO->remove();
  return 1;
}
