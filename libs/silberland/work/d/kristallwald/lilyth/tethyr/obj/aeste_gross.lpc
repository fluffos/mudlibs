#include "../def.h"

inherit "std/thing";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  call_out("remove", 60+random(40));

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein grosser Haufen Aeste");
  SetProp(P_LONG, "Ein paar schon leicht bruechig gewordene Aeste, an "
  "denen sogar noch ein paar Blaetter haengen, liegen auf "
  "einem Haufen zusammen. Es scheinen die Ueberreste eines grossen "
  "Waldschrats zu sein.");

  AddDetail( ({ "blaetter" }),
    "Ein paar blaue Blaetter haengen noch an den Aesten.");

  AddDetail( ({ "ueberreste", "waldschrat", "schrat" }),
    "Bei diesen Aesten scheint es sich um die Ueberreste eines Waldschrats "
    "zu handeln.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Haufen Aeste");
  SetProp(P_NAME_ADJ, "gross");
  AddAdjective( ({ "grosser", "grossen", "grossem" }) );
  SetProp(P_GENDER, MALE);
  AddId( ({ "haufen", "aeste", "ast", "ueberreste" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_WOOD);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 0);

//--Create Ende------------------------------------------------------------

}
