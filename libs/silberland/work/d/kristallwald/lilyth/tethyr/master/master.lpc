#include "../def.h"
#include <ansi.h>

//--Variablen&Defines------------------------------------------------------

int messagelevel;

//--Create-----------------------------------------------------------------

void create()
{
  if(is_clone(this_object()))
  {
    destruct(this_object());
    return;
  }

  seteuid(getuid(this_object()));

  return;

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//Messages
void Msg(string s, int level)
{
  object pl;
  int i;
  string str;

  write_file(LOG "tethyr.log",ctime()+": "+s+"\n");

  pl = find_player("lilyth");

  if(objectp(pl) && interactive(pl) && IS_WIZARD(pl) && (level <= messagelevel))
  {
    str = BSI(s+"","TETHYR: ");
    if(pl->QueryProp(P_TTY)) str = ANSI_BOLD+ANSI_RED+str+ANSI_NORMAL;
    tell_object(pl,str);
  }
}

//Message Level setzen
void SetLevel(int level)
{
  messagelevel = level;
}

//Message Level abfragen
int QueryLevel()
{
  return messagelevel;
}
