#include "../def.h"

inherit "/d/kristallwald/lilyth/tethyr/npc/std_npc_waldschrat";

//--Create-----------------------------------------------------------------

void create()
{
  int schratlevel;
  
  if(!is_clone(TO)) return;

  ::create();

  schratlevel = 14+random(12);

  create_default_waldschrat(schratlevel);
}

