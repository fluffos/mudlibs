#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Cassandra, die Traumseherin");
  SetProp(P_LONG,
    "Cassandra, die Traumseherin.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Cassandra");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"cassandra", "traumseherin", "seherin"}));
  AddClass( ({CL_HUMAN}) );
  SetProp(P_ARTICLE, 0);

  set_living_name("cassandra");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(22);

  SetProp(P_HANDS, ({ " mit Magie", 220, DT_BLUDGEON }) );

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 167);
  SetProp(P_WEIGHT, 60000);
  SetProp(P_ALIGN, 150);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" fragt: Was soll ich damit?\n" }) );

//SetProp(P_LOG_INFO, "/lilyth/palast/cassandra");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0     ]));

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
//SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Cassandra");
  SetProp(P_KILL_MSG, "Dein Schicksal hat sich erfuellt!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "schaut Dich fragend an.\n");
  AddInfo("lilyth", "Lilyth hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

/*
  AddSpell(1,0,
    Name(WER, 1)+" .\n",
    Name(WER, 1)+" .\n",
     DT_,([SP_SHOW_DAMAGE:1]));
*/
//--Chats------------------------------------------------------------------
/*
  SetChats(3,
  ({Name(WER, 1)+" .\n",
    Name(WER, 1)+" .\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" .\n",
    Name(WER, 1)+" .\n" }));
*/
//--Ausruestung------------------------------------------------------------

  SUID;
//CLONEME(WEAPON "" );
//CLONEME("/p/weapon/.../...");
//command("zuecke waffe");

//CLONEME(ARMOUR "" );
//CLONEME("/p/armour/.../...");
//command("trage alles");

//--Variable---------------------------------------------------------------



//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt Cassandra.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}
