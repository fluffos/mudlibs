inherit "std/armour";

#include "../def.h"
#include "/p/daemon/skillmaster/skillmaster.h"

//--Variablen&Defines------------------------------------------------------

int wickeln_called;

/*
string *level_names = 
({ "PLACEHOLDER",
   "Die Stufe des Lernens",
   "Die Stufe der Vision",
   "Die Stufe der Erkenntnis",
   "Die Stufe der Erleuchtung",
   "Die Stufe der Hellsicht",
   "Die Stufe der Prophezeiung",
   "Die Stufe der Weisheit" });
*/

//--Create-----------------------------------------------------------------

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  wickeln_called = 0;


//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein goldenes Armband");
//SetProp(P_LONG, -> siehe unten

  AddDetail( ({ "smaragdsplitter", "splitter" }),
    "Die Runen wurden mit kleinen Smaragdsplittern in das Armband "
    "eingesetzt.");

  AddDetail( ({ "zeichen", "traumseher" }),
    "Dieses Armband ist das magische Zeichen der Traumseher. Wer es "
    "besitzt, ist in der Lage, die hohe Kunst des Traumsehens "
    "einzusetzen und in die Zukunft zu blicken.");

  AddDetail( ({ "kunst", "traumsehen" }),
    "Das Traumsehen ist eine sehr hohe Kunst.");

  AddDetail( ({ "zukunft" }),
    "Mit Hilfe dieses Armbands bist Du in der Lage, in die Zukunft zu "
    "blicken.");

  AddDetail( ({ "lage" }),
    "Theoretisch solltest Du dazu in der Lage sein.");

  AddDetail( ({ "leuchten" }),
    "Du spuerst, dass den Runen eine besondere Magie innewohnt, die "
    "durch das Leuchten zum Ausdruck gebracht wird.");

  AddSpecialDetail( ({ "runen", "rune" }),
    "strrunen");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Armband");
  SetProp(P_NAME_ADJ, "golden");
  AddAdjective( ({ "goldenes" } ));
  SetProp(P_GENDER, NEUTER);
  AddId( ({"band", "armband", "\nTraumseherArmband"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "Du kannst es um Dein Handgelenk wickeln.");
  SetProp(P_MATERIAL, ([MAT_SILK: 80, MAT_EMERALD: 10, MAT_GOLD: 10]) );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_QUALITY_DECAY, 0);
  SetProp(P_WEAR_FUNC, this_object());

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "wickel", "wickle", "wickl", "wickele" }), "wickeln" );
//AddCmd( ({ "sag", "sage" }), "zukunft_voraussagen" ); //jmd. anderem
//AddCmd( ({ "blick", "blicke" }), "in_zukunft_blicken" ); //sich selbst

//--Create Ende------------------------------------------------------------

}

//--Allgemeine Funktionen--------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;

  txt = "Ein schmales goldenes Armband, in das kleine Runen aus "
        "Smaragdsplittern eingesetzt sind. Es ist das magische "
        "Zeichen der Traumseher.";

  return BS(txt);
}

//SpecialDetails:
string strrunen(string str)
{
  string s;
  string t;

  t = "";

  s = "Magische Runen aus winzigen Smaragdsplittern wurden in das Armband "
     +"eingesetzt. ";

//if(Spieler == Stufe 1) { t = "weisses"; }
//if(Spieler == Stufe 2) { t = "gelbes"; }
//if(Spieler == Stufe 3) { t = "orangenes"; }
//if(Spieler == Stufe 4) { t = "roetliches"; }
//if(Spieler == Stufe 5) { t = "violettes"; }
//if(Spieler == Stufe 6) { t = "blaeuliches"; }
//if(Spieler == Stufe 7) { t = "silbriges"; }

  if(QueryProp(P_WORN))
  {
     s += "Ein helles, "+t+" Leuchten geht von ihnen aus.";
  }
  
  return BS(s);
}

//Hilfsfunktion fuers Wickeln:
int WearFunc(object me)
{
  if(wickeln_called)
  {
        wickeln_called = 0;
        return 1;
  }
  else
  {
        write(BS("So geht das nicht."));
        return 0;
  }
}

//Armband um- oder abwickeln:
int wickeln(string str)
{
  notify_fail("Was moechtest Du Dir um- oder abwickeln?\n");

  if(!str || str == "") return 0;

  if(str == "armband um handgelenk" ||
     str == "armband um gelenk" ||
     str == "armband um" ||
     str == "band um handgelenk" ||
     str == "band um gelenk" ||
     str == "band um")
  {
     if(QueryProp(P_WORN))
     {
        write(BS("Du hast das Armband doch bereits umgewickelt."));
        return -1;
     }
     else
     {
        write(break_string("Du wickelst das Armband um Dein Handgelenk.\n"
        +"Die Runen leuchten auf und Du spuerst, wie ihre Magie durch "
        +"Dich hindurchfliesst.", 78, 0, 1));

  	ENV(TP)->Message(BS(TP->Name(WER, 1)+" wickelt ein Armband um "
        +(TP->QueryProp(P_GENDER) == MALE ? "sein": "ihr")+" Handgelenk."),
  	MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  	  
        wickeln_called = 1;
        DoWear(1,0);
        return 1;
     }
  }

  if(str == "armband ab" ||
     str == "armband von handgelenk" ||
     str == "armband von handgelenk ab" ||
     str == "armband von gelenk" ||
     str == "armband von gelenk ab" ||
     str == "band ab" ||
     str == "band von handgelenk" ||
     str == "band von handgelenk ab" ||
     str == "band von gelenk" ||
     str == "band von gelenk ab")
  {
     if(QueryProp(P_WORN))
     {
        write(break_string("Du wickelst das Armband ab.\n"
        +"Das Leuchten der Runen verblasst langsam und Du spuerst, "
        +"wie Deine Macht schwindet."));

  	ENV(TP)->Message(BS(TP->Name(WER, 1)+" wickelt ein Armband von "
  	+(PL->QueryProp(P_GENDER)==MALE?"seinem":"ihrem")+" Handgelenk."),
  	MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        wickeln_called = 1;
        DoUnwear(1,0);
  	return 1;
     }
     else
     {
  	write(BS("Aber Du hast das Armband doch gar nicht um."));
  	return -1;
     }
  }

  return 0;
}

//Im ExtraLook sichtbar:
string extra_look()
{
  if(!ENV(TO)) return "";
   
//if(Spieler == Traumseher)
//{
     if(QueryProp(P_WORN))
     {
        return ""
        +((TO->QueryProp(P_WORN))->QueryProp(P_GENDER)==MALE?"Er":"Sie")
        +" traegt das magische Zeichen der Traumseher bei sich!\n";
     }
//}
  return "";
}

