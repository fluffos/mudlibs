#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Wasserpferd");
  SetProp(P_LONG,
    "Noch nie hast Du ein solches Geschoepf wie dieses gesehen. Der grosse "
    "platte Kopf des Wesens scheint schwerelos im Wasser zu schweben. Der "
    "massige Koerper wird auf dem Ruecken von einer schmalen Reihe "
    "schuppiger Zacken bedeckt und die glatte dunkelblaue Haut weicht unter "
    "dem Kiefer einem leuchtendgruenen Streifen, der im Wasser hell "
    "schimmert. Grosse bernsteingelbe Augen blicken Dich unverwandt an und "
    "scheinen bis auf den Grund Deiner Seele blicken zu koennen.");

  AddDetail( ({ "geschoepf", "wesen", "wasserpferde" }),
    "Du bist Dir ziemlich sicher, dass es sich bei diesem Wesen um eines "
    "der mysterioesen Wasserpferde handelt, von denen die alten Geschichten "
    "erzaehlen.");

  AddDetail( ({ "geschichten", "geschichte" }),
    "Kennst Du sie etwa nicht?");

  AddDetail( ({ "kopf" }),
    "Der grosse platte Kopf schwebt reglos vor Dir im Wasser.");

  AddDetail( ({ "koerper" }),
    "Der Koerper wirkt sehr massig und gross, dennoch aber nicht plump. "
    "Auf dem Ruecken ist er mit einer Reihe schuppiger Zacken bedeckt.");

  AddDetail( ({ "ruecken", "reihe", "reihen" }),
    "Schuppige, ein wenig abgerundete Zacken bedecken den breiten Ruecken "
    "des Wasserpferdes.");

  AddDetail( ({ "zacken", "spuelen" }),
    "Durch das staendige Spuelen des Wassers sind sie leicht abgerundet.");

  AddDetail( ({ "haut" }),
    "Die samtig schimmernde Haut ist sehr glatt und ebenmaessig.");

  AddDetail( ({ "kiefer", "streifen" }),
    "Unter dem Kiefer siehst Du einen leuchtendgruenen hellen Streifen "
    "Haut.");

  AddDetail( ({ "augen", "auge", "farbe" }),
    "Die grossen pupillenlosen Augen haben eine bernsteingelbe Farbe.");

  AddDetail( ({ "grund", "seele" }),
    "Du kannst Deinen Blick kaum von den pupillenlosen Augen abwenden, "
    "die Dich seelenruhig betrachten.");

  AddDetail( ({ "blick", "gedanken", "gedanke" }),
    "Du hast fast das Gefuehl, als koenne dieses Wesen Deine Gedanken "
    "lesen.");

  AddDetail( ({ "gefuehl" }),
    "Du bist Dir nicht ganz sicher, ob Du Dich in der Naehe des "
    "Wasserpferdes wohlfuehlen sollst oder nicht. Irgendwie ist es Dir "
    "unheimlich.");

  AddDetail( ({ "naehe", "wasser" }),
    "Das Wasserpferd schwimmt - oder schwebt - direkt vor Dir im Wasser.");

  AddDetail( ({ "beine", "bein" }),
    "Es hat kurze, kraeftige Beine mit flossenartigen Hufen daran.");

  AddDetail( ({ "flossen", "hufe", "flosse", "huf" }),
    "Du kannst Dich nicht recht entscheiden, ob es sich nun um Flossen oder "
    "Hufe handelt. Es scheint eher eine Art Zwischending zu sein.");

  AddDetail( ({ "art", "zwischending" }),
    "Eine Art Zwischending zwischen Flossen und Hufen.");

  AddDetail( ({ "nuestern", "nuester" }),
    "Es hat grosse kiemenartige Nuestern, mit denen es unter Wasser "
    "atmen kann.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Wasserpferd");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"pferd", "wasserpferd"}));
  AddClass( ({CL_ANIMAL, CL_SWIMMING}) );
  SetProp(P_ARTICLE, 1);

  set_living_name("wasserpferd");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(27);

  SetProp(P_HANDS, ({" mit gefletschten Zaehnen"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })  );

  SetProp(P_RACE, "Tier");
  SetProp(P_SIZE, 175);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp(P_RESISTANCE_STRENGTHS,
    ([ DT_WATER:      -1.0,
       DT_MAGIC:      -0.2 ]));

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "schwimmt lautlos herein");
  SetProp(P_MSGOUT, "schwimmt lautlos");
  SetProp(P_MMSGIN, "taucht aus den Tiefen des Wassers auf");
  SetProp(P_MMSGOUT, "verschwindet in den Tiefen des Wassers");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " stirbt mit einem leisen Seufzen.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Ein Wasserpferd");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "schaut Dich unverwandt an.\n");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);
/*
  AddSpell(1,0,
    Name(WER, 1)+" !\n",
    Name(WER, 1)+" !\n",
    DT_,([SP_SHOW_DAMAGE:1]));
*/
//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" blickt Dich unverwandt an.\n",
    Name(WER, 1)+" schnaubt leise.\n",
    Name(WER, 1)+" schwimmt ein wenig um Dich herum.\n",
    Name(WER, 1)+" kommt auf Dich zugeschwommen.\n",
    Name(WER, 1)+" schnappt nach einem vorbeischwimmenden Fisch.\n",
    Name(WER, 1)+" knabbert an ein paar Wasserpflanzen herum.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" schnappt nach Dir!\n",
    Name(WER, 1)+" schleudert Dich wild durch das Wasser!\n",
    Name(WER, 1)+" entbloesst seine grossen, spitzen Zaehne.",
    Name(WER, 1)+" versucht, Dich auf den Grund des Wassers zu druecken.\n" }));

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt das Wasserpferd.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "stubst Dich behutsam mit seiner Nase an.",
        "stubst "+TP->name(WEN)+" behutsam mit seiner Nase an.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "gibt ein tiefes, drohendes Grollen von sich.",
        "gibt ein tiefes, drohendes Grollen von sich.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "blaeht seine grossen Nuestern weit auf.",
        "blaeht seine grossen Nuestern weit auf.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "schnappt mit seinen scharfen Zaehnen nach Dir!",
        "schnappt mit seinen scharfen Zaehnen nach "+TP->name(WEM)+"!");
        TP->AddHp(-10-random(25));
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "zeigt Dir eine lange Reihe spitzer Zaehne.",
        "zeigt "+TP->name(WEM)+" eine lange Reihe spitzer Zaehne.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "blinzelt Dich gutmuetig an.",
        "blinzelt "+TP->name(WEN)+" gutmuetig an.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "gibt ein wohliges, grollendes Geraeusch von sich.",
        "gibt ein wohliges, grollendes Geraeusch von sich.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "schnaubt Dich leicht an.",
        "schnaubt "+TP->name(WEN)+" leicht an.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "blickt Dich unverwandt an.",
        "blickt "+TP->name(WEN)+" unverwandt an.");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "neigt troestend seinen grossen Kopf zu Dir herab.",
        "neigt troestend seinen grossen Kopf zu "+TP->name(WESSEN)+" herab.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Wegwerf-Meldung unterdruecken:
void give_notify(object was)
{
    write("Das Wasserpferd schnaubt leise und stubst "+was->name()+" "
    +"dann mit seiner Nase wieder zu Dir zurueck.\n");
    
    ENV(TO)->Message(BS("Das Wasserpferd schnaubt leise und stubst "
    +was->name()+" dann mit seiner Nase wieder zu "
    +this_player()->Name(WEM)+" zurueck."),
    MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    
    was->move(ENV(TO), M_SILENT|M_PUT);
    return;
}
