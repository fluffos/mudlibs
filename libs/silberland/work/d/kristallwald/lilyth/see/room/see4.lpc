#include "../def.h"
#include "/d/wasser/cirion/water.h"

inherit "/d/wasser/cirion/room/wroom.lpc";

//--Variablen&Defines------------------------------------------------------

#ifndef P_WROOM_SINK
#define P_WROOM_SINK "wroom_sink"
#endif

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem grossen See");
  SetProp(P_INT_LONG,
    "Du schwimmst ganz in der Naehe des Ufers in dem grossen See herum. Das "
    "Wasser ist hier recht flach und sehr ruhig, nur ab und zu bilden sich "
    "winzige Wellen durch Deine Schwimmbewegungen. Du kannst bis "
    "auf den Grund des Sees blicken, da das Wasser kristallklar ist.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_WATER,
                           ENV_WATER: 5]) );
  SetProp(P_WROOM_SINK, 0);

//--Details----------------------------------------------------------------

  AddDetail( ({ "naehe" }),
    "");

  AddDetail( ({ "ufer" }),
    "");

  AddDetail( ({ "see" }),
    "");

  AddDetail( ({ "wasser" }),
    "");

  AddDetail( ({ "wellen" }),
    "");

  AddDetail( ({ "schwimmbewegungen" }),
    "");

  AddDetail( ({ "grund" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");

//--Ausgaenge--------------------------------------------------------------

  AddWaterExit ("osten", ROOM "see5");
//AddWaterExit( "osten", "nach Osten#" + "./see5" );
//AddWaterExit( "sueden", "nach Sueden#" + "./see7" );
//AddWaterExit( "westen", "nach Westen#" + "./see3" );
//AddWaterExit( "nordwesten", "nach Nordwesten#" + "./see1" );

//--Kommandos--------------------------------------------------------------

//AddCmd( ({ "", "" }), "" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer Special Details----------------------------------------



//--Funktionen fuer Kommandos----------------------------------------------

