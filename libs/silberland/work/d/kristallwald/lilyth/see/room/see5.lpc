#include "../def.h"
#include "/d/wasser/cirion/water.h"

inherit "/d/wasser/cirion/room/wroom.lpc";

//--Variablen&Defines------------------------------------------------------

#ifndef P_WROOM_SINK
#define P_WROOM_SINK "wroom_sink"
#endif

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem grossen See");
  SetProp(P_INT_LONG,
    "Traege laesst Du Dich im ruhigen Wasser des Sees treiben. Das Ufer "
    "breitet sich noerdlich von Dir aus und zieht sich in einem langen, "
    "halbkreisfoermigen Streifen ein ganzes Stueck weiter in Richtung "
    "Suedwesten. Die Sonne strahlt vom wolkenlosen Himmel auf Dich herab.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_WATER,
                           ENV_WATER: 5]) );
  SetProp(P_WROOM_SINK, 0);

//--Details----------------------------------------------------------------

  AddDetail( ({ "wasser" }),
    "");

  AddDetail( ({ "see" }),
    "");

  AddDetail( ({ "ufer" }),
    "");

  AddDetail( ({ "streifen" }),
    "");

  AddDetail( ({ "stueck" }),
    "");

  AddDetail( ({ "richtung" }),
    "");

  AddDetail( ({ "suedwesten" }),
    "");

  AddDetail( ({ "sonne" }),
    "");

  AddDetail( ({ "himmel" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");

//--Ausgaenge--------------------------------------------------------------

  AddWaterExit ("westen", ROOM "see4");
//AddWaterExit( "suedwesten", "nach Suedwesten#" + "./see7" );

//--Kommandos--------------------------------------------------------------

//AddCmd( ({ "", "" }), "" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer Special Details----------------------------------------



//--Funktionen fuer Kommandos----------------------------------------------

