inherit "/p/service/iwo/access/ac_client_fun.lpc";

int access_rights(string name, string file, int readflag, int def, string fun)
{
   //Lesezugriff regeln
   if(readflag)
   {
       if(name == "torian" || name == "delgo" || name == "yara")
         return 1;
       else
         return ::access_rights(name, file, readflag, def);
   }

   if(name == "torian")
      return 1;

   //Yara Zugriff auf Haustierverzeichnis
   if(name=="yara" && (file[0..6]=="palast/" ||
                      file[0..7]=="falkner/"))
     return 1;
}

