#include "../def.h"
#include <laden.h>

inherit "std/laden";

//--Variablen&Defines------------------------------------------------------

int deckel;

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------

  RemoveFixedObject("/obj/boerse");
  RemoveFixedObject("/obj/stempel");

  deckel = AUF;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem Bogenladen");
//SetProp(P_INT_LONG, ""); -> siehe unten

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_SHOPKEEPER_ID, "ceyth");
  SetProp(P_SHOPKEEPER_NAME, "Ceyth");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetStorageRoom(ROOM "ug_lagerraum_bogenladen" );

//--Details----------------------------------------------------------------

  AddDetail( ({ "bogenladen", "laden" }),
    "Du befindest Dich in einem Bogenladen.");

  AddDetail( ({ "waende", "wand" }),
    "An den Waenden sind einfache schlichte Holzregale befestigt. In den "
    "meisten von ihnen liegen Pfeilspitzen in unterschiedlichen Groessen, "
    "Pfeilschaefte und Bogensehnen herum. Ausserdem siehst Du eine Reihe "
    "kleiner Kaesten in einem der Regale stehen.");

  AddDetail( ({ "holzregale", "regale" }),
    "Die schlichten Holzregale sind allesamt mit Pfeilspitzen, Schaeften "
    "und Bogensehnen gefuellt.");

  AddDetail( ({ "pfeilspitzen", "spitzen", "pfeilspitze", "spitze" }),
    "Pfeilspitzen in vielen verschiedenen Groessen liegen in den Regalen.");

  AddDetail( ({ "groessen", "groesse" }),
    "Die Pfeilspitzen haben unterschiedliche Groessen.");

  AddDetail( ({ "pfeilschaefte", "schaefte", "pfeilschaft", "schaft" }),
    "Einige, noch nicht mit Federn versehene Pfeilschaefte liegen lose in "
    "den Regalen herum.");

  AddDetail( ({ "bogensehnen", "sehnen", "bogensehne", "sehne" }),
    "Die Bogensehnen bestehen zum groesstenteils aus hellglaenzender "
    "Seide. Einige von ihnen sind zerrissen und scheinen noch auf ihre "
    "Reparatur zu warten.");

  AddDetail( ({ "seide" }),
    "Bogensehnen koennen auch aus anderem Material hergestellt werden, "
    "doch diese hier bestehen fast alle aus Seide.");

  AddDetail( ({ "material" }),
    "Am besten fragst Du Ceyth danach.");

  AddDetail( ({ "reparatur" }),
    "Ceyth stellt nicht nur Boegen her, sondern repariert sie auch gerne bei "
    "Bedarf.");

  AddDetail( ({ "bedarf" }),
    "Wenn Du einen kaputten Bogen bei Dir hast, kannst Du ihn Dir von "
    "Ceyth reparieren lassen.");

  AddDetail( ({ "reihe" }),
    "Du zaehlst insgesamt neun solcher Kaestchen, die ordentlich "
    "aneinandergereiht in dem Regal stehen.");

  AddDetail( ({ "kaesten", "kaestchen" }),
    "Die Kaesten sind bis auf einen allesamt fest verschlossen.");

  AddDetail( ({ "inhalt" }),
    "Neugierig schaust Du in den Kasten hinein. Er ist etwa zur Haelfte "
    "mit lauter kleineren Dingen gefuellt, die anscheinend fuer die "
    "Verzierung der Boegen, die Ceyth anfertigt, zu dienen scheinen.");

  AddDetail( ({ "haelfte" }),
    "Der Kasten ist nur halbvoll.");

  AddDetail( ({ "dinge" }),
    "Grosse glaenzende Federn, schimmernde Perlen, buntes Garn und sogar "
    "Edelsteinsplitter liegen wild durcheinander in dem Kasten.");

  AddDetail( ({ "verzierung" }),
    "Die Moeglichkeiten, mit welchen Materialien ein Bogen verziert werden "
    "kann, sind nahezu unbegrenzt.");

  AddDetail( ({ "moeglichkeiten", "moeglichkeit" }),
    "Es gibt unzaehlige.");

  AddDetail( ({ "materialien" }),
    "Einige davon siehst Du in dem Kasten liegen.");

 AddDetail( ({ "bogen", "boegen" }),
    "Ceyth fertigt saemtliche seiner Boegen eigenhaendig an und verziert "
    "sie anschliessend mit den edelsten Materialien.");

  AddDetail( ({ "federn", "feder" }),
    "Federn dienen hauptsaechlich dazu, die Pfeilschaefte damit zu versehen, "
    "sie koennen aber auch als Verzierung der Boegen genutzt werden.");

  AddDetail( ({ "perlen", "perle" }),
    "Grosse und kleine schimmernde Perlen befinden sich in dem Kasten.");

  AddDetail( ({ "garn" }),
    "Du siehst grobes und feineres Garn in allen moeglichen Farben.");

  AddDetail( ({ "farben" }),
    "Alle Farben, die Du Dir nur vorstellen kannst.");

  AddDetail( ({ "edelsteinsplitter" }),
    "Auch einige sorgfaeltig geschliffene Edelsteinsplitter liegen in dem "
    "kleinen Kasten.");

  AddDetail( ({ "regal", "holzregal" }),
    "In einem der Regale befindet sich eine Reihe kleiner Kaesten.");

  AddDetail( ({ "zielscheibe", "scheibe" }),
    "An einer Wand haengt eine grosse Zielscheibe, in der mehrere Pfeile "
    "stecken.");

  AddDetail( ({ "pfeile", "pfeil" }),
    "Verwundert reibst Du Dir die Augen. Die Pfeile stecken ausnahmslos "
    "alle in dem kleinen roten Kreis in der Mitte der Scheibe.");

  AddDetail( ({ "augen", "auge" }),
    "Du bist ziemlich beeindruckt.");

  AddDetail( ({ "kreis" }),
    "Wer auch immer diese Pfeile auf die Scheibe geschossen hat, muss "
    "ein wirklicher Meisterschuetze gewesen sein.");

  AddDetail( ({ "meisterschuetze" }),
    "Du vermutest, dass es Ceyth selbst war, der diese Pfeile abgeschossen "
    "hat.");

  AddDetail( ({ "mitte" }),
    "In der Mitte der Zielscheibe ist ein kleiner roter Kreis eingezeichnet, "
    "waehrend die anderen Kreise nach aussen hin immer groesser werden und "
    "somit auch viel leichter zu treffen sind.");

  AddDetail( ({ "kreise" }),
    "Um den roten Kreis herum siehst Du mehrere schwarze Kreise, die "
    "nach aussen hin einen immer groesseren Durchmesser haben.");

  AddDetail( ({ "durchmesser" }),
    "Er wird nach aussen hin immer groesser.");

  AddDetail( ({ "holztisch", "tisch" }),
    "Ein schmaler Holztisch steht direkt unter der Zielscheibe an der "
    "Wand. Einige laengliche Holzstuecke liegen auf ihm.");

  AddDetail( ({ "holzstuecke", "holzstueck" }),
    "Aus ihnen scheint Ceyth die Boegen anzufertigen.");

  AddDetail( ({ "ladenbesitzer", "besitzer" }),
    "Ceyth ist der Besitzer dieses Ladens.");

  AddDetail( ({ "ceyth" }),
    "Er scheint gerade nicht da zu sein.");

  AddDetail( ({ "holztheke", "theke" }),
    "Die Theke befindet sich in einer Ecke weiter hinten im Laden. Sie "
    "besteht aus einem hellem Holz und hat eine sehr glatte Oberflaeche.");

  AddDetail( ({ "holz" }),
    "Fast alles hier im Laden besteht aus Holz.");

  AddDetail( ({ "oberflaeche" }),
    "Die Oberflaeche der Theke ist sehr glatt und schimmert leicht im "
    "Licht.");

  AddDetail( ({ "licht" }),
    "Der gesamte Laden wird durch zwei kleine Laternen erhellt, die "
    "rechts und links neben dem Eingang an der Wand befestigt sind.");

  AddDetail( ({ "laternen", "laterne" }),
    "Die Laternen spenden gerade genuegend Licht, um den gesamten Laden zu "
    "erhellen.");

  AddDetail( ({ "eingang" }),
    "Der Eingang, durch den Du hier hereingekommen bist, liegt im Osten.");

  AddDetail( ({ "osten" }),
    "Dort kommst Du auch wieder aus dem Laden heraus.");

  AddDetail( ({ "ecke" }),
    "In einer Ecke hinten im Laden befindet sich eine schmale helle "
    "Holztheke.");

  AddDetail( ({ "boden" }),
    "Der Holzfussboden sieht sehr sauber und gepflegt aus.");

  AddDetail( ({ "holzfussboden", "holzboden", "fussboden" }),
    "Der Boden besteht aus Holz.");

  AddDetail( ({ "decke" }),
    "Die Decke besteht aus hellen weissen Steinen.");

  AddDetail( ({ "steine", "stein" }),
    "Die Steine an der Decke haben eine sehr schoene weisse Farbe.");

  AddDetail( ({ "farbe" }),
    "Weiss.");

  AddSound( DEFAULT_SOUND,
    "Abgesehen von den leisen Geraeuschen, die von draussen hereindringen, "
    "ist es hier absolut still.");

  AddSound( ({ "geraeusche", "geraeusch" }),
    "Leise Geraeusche dringen von den Gaengen draussen herein.");

  AddSound( ({ "gang", "gaenge" }),
    "Draussen, ausserhalb des Ladens.");

  AddSound( ({ "laden" }),
    "Ausser den leisen Geraeuschen von draussen hoerst Du nichts.");

  AddSmell( DEFAULT_SMELL,
    "Ein leichter Holzgeruch durchzieht den Laden.");

  AddSmell( ({ "holzgeruch", "geruch" }),
    "Es riecht sehr angenehm.");

  AddSmell( ({ "laden" }),
    "Im ganzen Laden duftet es leicht nach Holz.");

  AddSmell( ({ "holz" }),
    "Es riecht angenehm frisch und wuerzig.");

  AddSpecialDetail( ({ "kasten" }),
    "strkasten");

  AddSpecialDetail( ({ "deckel" }),
    "strdeckel");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "osten", "nach Osten#" + "./ug_gang2" );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "heb", "hebe" }), "deckel_aufheben" );
  AddCmd( ({ "oeffne" }), "oeffnen" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "bogenbauer", REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer SpecialDetails-------------------------------------------

string strkasten(string str)
{
  string s;

  if(deckel == AUF)
  {
  	s = "Einer der Kaesten ist nicht wie die anderen mit einem Deckel "
  	+"verschlossen, so dass Du seinen gesamten Inhalt sehen kannst.";
  }
  else
  {
  	s = "Von einem der Kaesten ist der Deckel ein wenig herabgerutscht, "
        +"so dass Du seinen Inhalt teilweise erkennen kannst.";
  }
  return BS(s);
}

string strdeckel(string str)
{
  string s;

  if(deckel == AUF)
  {
  	s = "Suchend schaust Du Dich um und entdeckst den Deckel "
  	+"schliesslich auf dem Boden vor dem Regal. Er muss wohl "
  	+"hinuntergefallen sein.";
  }
  else
  {
  	s = "Der Deckel sitzt nicht ganz so fest wie die anderen auf dem "
  	+"Kasten auf.";
  }
  return BS(s);
}

//--Funktionen ------------------------------------------------------------

//Langbeschreibung:
string _query_int_long()
{
  string txt;

  txt = "Du stehst in einem kleinen, aber geraeumigen Bogenladen. Ueberall "
  "an den Waenden siehst Du Regale, in denen Pfeilspitzen und "
  "Bogensehnen herumliegen. An einer Wand haengt eine grosse Zielscheibe, "
  "in der einige Pfeile stecken. Direkt darunter steht ein schmaler "
  "Tisch, auf dem mehrere laengliche Holzstuecke liegen. ";

  if(QueryProp(P_SHOPKEEPER_ID))
  {
        if(!present(QueryProp(P_SHOPKEEPER_ID)))
        {
                txt += "Der Ladenbesitzer scheint gerade nicht da zu sein, "
                +"denn hinter der hellen Holztheke in der hinteren Ecke "
                +"des Ladens ist niemand zu sehen.";
        }
        else
        {
                txt += "In der hinteren Ecke des Ladens befindet sich eine "
                +"helle Holztheke, hinter der ein hochgewachsener Halbelf "
                +"steht, der Dich mit ruhigem Blick abwartend mustert.";
        }
   }
   return BS(txt);
}

//Deckel aufheben:
int deckel_aufheben(string str)
{
  notify_fail("Was moechtest Du aufheben?\n");

  if(!str || str == "") return 0;

  if(!(str == "deckel auf" ||
       str == "deckel von boden auf" ||
       str == "deckel vom boden auf" )) return 0;

  if(deckel == AUF)
  {
        write(break_string("\bDu hebst den heruntergefallenen Deckel "
        +"vom Boden auf und versuchst, den dazugehoerigen Kasten wieder "
        +"damit zu verschliessen. Doch der Kasten ist anscheinend zu voll, "
        +"denn er laesst sich nicht richtig schliessen.\n", 78,0,1));

        TO->Message(BS(TP->Name(WER, 1)+" hebt etwas vom Boden auf und macht "
        +"sich anschliessend an einem der Regale zu schaffen."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        deckel = ZU;
        return 1;
  }
  else
  {
        write(BS("Du drueckst ein wenig auf dem Deckel herum, doch der "
        +"Kasten laesst sich nicht besser verschliessen."));

        TO->Message(BS(TP->Name(WER, 1)+" fummelt an einem "
        +"der Regale herum."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        return -1;
  }
}

int oeffnen(string str)
{
  notify_fail("Was willst Du oeffnen?\n");

  if(!str || str == "") return 0;

  if(!(str == "kasten" ||
       str == "kaesten" )) return 0;

  write(BS("Die Kaesten sind fest verschlossen. Du bekommst sie einfach "
  +"nicht auf."));

  TO->Message(BS(TP->Name(WER, 1)+" fummelt an einem der Regale herum."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

void reset()
{
	::reset();
	deckel = AUF;
}

//Haendler kauft nur Boegen
varargs int do_sell(object ob, int force, string prefix, int limit)
{
  if( ob->QueryProp(P_WEAPON_TYPE) == "bow" )
  {
    return ::do_sell(ob, force);
  }
  else
  {
    write(BS("Ceyth sagt: Tut mir leid, aber ich kaufe nur Boegen jeglicher "
    +"Art."));
    return 1;
  }
}
