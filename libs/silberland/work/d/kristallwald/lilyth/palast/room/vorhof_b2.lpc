#include "../def.h"

inherit "std/room";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Auf einem grossen Vorhof");
  SetProp(P_INT_LONG,
    "Du bist auf einem grossen offenen Platz angelangt. Im Norden "
    "kannst Du einen gewaltigen Palast sehen, der sich dort in "
    "majestaetischer Groesse gegen den blauen Himmel abzeichnet. "
    "Oestlich von Dir befindet sich das weisse Tor, durch das Du "
    "diesen Vorhof betreten hast und auch wieder verlassen kannst.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "platz" }),
    "Du stehst auf einem sehr grossen und weitlaeufigen Platz, der sich vor "
    "dem Palast ausbreitet.");

  AddDetail( ({ "norden" }),
    "Im Norden siehst Du die weissen Mauern des Palastes in der Sonne "
    "schimmern.");

  AddDetail( ({ "mauern", "palastmauern", "mauer", "palastmauer" }),
    "Die hohen Mauern des Palasts sind aus hellen, weissen Steinen erbaut "
    "worden.");

  AddDetail( ({ "steine", "stein" }),
    "Sie glaenzen und schimmern ein wenig in der Sonne.");

  AddDetail( ({ "sonne" }),
    "Die Sonne scheint gutgelaunt auf Dich herab und laesst den Palast vor "
    "Dir in all seiner Pracht erstrahlen.");

  AddDetail( ({ "pracht" }),
    "Der Palast ist wirklich praechtig anzuschauen.");

  AddDetail( ({ "palast", "gebaeude" }),
    "Ein gewaltiger Palast erhebt sich noerdlich von Dir bis in den Himmel.");

  AddDetail( ({ "groesse" }),
    "Obwohl der Palast wirklich gewaltig gross ist, wirkt er durch "
    "seine besondere Bauweise kein bisschen plump oder gar klobig.");

  AddDetail( ({ "bauweise" }),
    "Der Palast wirkt auf den ersten Blick zwar unglaublich gross mit "
    "seinen hohen Mauern, aber die vielen mehrstufigen Kuppeldaecher und die "
    "weisse Farbe erwecken dennoch den Eindruck eines fast anmutigen und "
    "eleganten Gebaeudes.");

  AddDetail( ({ "blick" }),
    "Du schaust noch einmal genauer hin und beschliesst, dass der Palast "
    "zwar unheimlich gross zu sein scheint, aber dennoch von aussen sehr "
    "elegant und anmutig wirkt.");

  AddDetail( ({ "daecher", "kuppeldaecher", "dach", "kuppeldach" }),
    "Auch von hier unten aus kannst Du erkennen, dass sich die glitzernden "
    "Daecher des Palastes in unterschiedlichen Hoehen befinden und so dem "
    "Palast ein interessantes und anmutiges Aeusseres verleihen. Zudem "
    "erhebt sich in der Mitte ein sehr hoher, schmaler Turm bis hinauf in "
    "die Wolken.");

  AddDetail( ({ "hoehen", "hoehe" }),
    "Die Daecher befinden sich in unterschiedlichen Hoehen.");

  AddDetail( ({ "aeusseres" }),
    "Von aussen sieht der Palast sehr interessant aus.");

  AddDetail( ({ "mitte" }),
    "Etwa in der Mitte des Palastes steigt ein einzelner, hoher Turm empor.");

  AddDetail( ({ "turm" }),
    "Er ist sehr schmal und seine Spitze ragt bis in die Wolken hinauf.");

  AddDetail( ({ "wolken" }),
    "Abgesehen von einer kleinen Wolkengruppe um die Turmspitze herum "
    "ist der Himmel voellig wolkenfrei.");

  AddDetail( ({ "wolkengruppe", "gruppe" }),
    "Ein paar kleine weisse Woelkchen haben sich um die Turmspitze herum "
    "gruppiert.");

  AddDetail( ({ "woelkchen" }),
    "Kleine weisse Wattewoelkchen.");

  AddDetail( ({ "wattewoelkchen" }),
    "Es sind wirklich nur sehr kleine Wolken.");

  AddDetail( ({ "turmspitze", "spitze" }),
    "Die Turmspitze reicht bis in die Wolken hinauf.");

  AddDetail( ({ "farbe" }),
    "Die Palastmauern, die Daecher wie auch der Turm des Palastes sind "
    "allesamt in einem hellen, strahlenden Weiss gehalten.");

  AddDetail( ({ "weiss" }),
    "Waere der Palast schwarz, wuerde er wohl eine eher bedrohliche "
    "Wirkung haben.");

  AddDetail( ({ "wirkung" }),
    "Er ist aber nicht schwarz, sondern weiss.");

  AddDetail( ({ "eindruck" }),
    "Der Palast wirkt trotz seiner gewaltigen Ausmasse sehr anmutig und "
    "einladend.");

  AddDetail( ({ "ausmasse" }),
    "Der Palast hat wirklich gewaltige Ausmasse.");

  AddDetail( ({ "himmel" }),
    "Das Wetter ist heute wieder einmal herrlich. Die Sonne scheint und es "
    "sind kaum Wolken am strahlend blauen Himmel zu sehen.");

  AddDetail( ({ "loblied", "lied" }),
    "Das kanntest Du doch bestimmt schon.");

  AddDetail( ({ "taaaaag", "tag" }),
    "Dieser Tag ist eigentlich viel zu schoen, um ihn im Inneren eines "
    "Palastes zu verbringen.");

  AddDetail( ({ "inneres", "inneren" }),
    "Auch wenn es Dich schon ein wenig interessiert, was sich dort "
    "drinnen befindet.");

  AddDetail( ({ "tor" }),
    "Das weisse Tor befindet sich oestlich von Dir. Die beiden Torfluegel "
    "sind weit geoeffnet, so dass Du den Vorhof jederzeit wieder verlassen "
    "kannst.");

  AddDetail( ({ "torfluegel", "fluegel" }),
    "Sie sind weit geoeffnet.");

  AddDetail( ({ "vorhof" }),
    "Dies hier ist der Vorhof des Palastes.");

  AddDetail( ({ "boden" }),
    "Auf dem ganzen Vorhof ist der Boden mit einer hellen Sandschicht "
    "ausgestreut worden.");

  AddDetail( ({ "sandschicht", "schicht" }),
    "Der Sand sieht fast weiss aus.");

  AddDetail( ({ "sand" }),
    "Du kniest Dich kurz hin und laesst ein wenig von dem hellen Sand durch "
    "Deine Finger rieseln.");

  AddDetail( ({ "finger" }),
    "Ein paar glitzernde Sandkoernchen kleben nun daran.");

  AddDetail( ({ "sandkoernchen", "koernchen" }),
    "Du pustest die Sandkoernchen von Deinen Fingerspitzen.");

  AddDetail( ({ "fingerspitzen", "spitzen" }),
    "Deine Fingerspitzen sind jetzt wieder ganz sauber.");

  AddDetail( ({ "besucher", "palastbesucher", "personen" }),
    "Ausser Dir befinden sich noch zahlreiche andere Besucher auf "
    "dem Vorhof.");

  AddDetail( ({ "osten" }),
    "Dort befindet sich das weisse Tor, das wieder zurueck auf den "
    "Waldweg fuehrt.");

  AddDetail( ({ "waldweg", "weg" }),
    "Der befindet sich auf der anderen Seite des Tores.");

  AddDetail( ({ "seite" }),
    "Um dorthin zu gelangen, wirst Du wohl oder uebel durch das Tor "
    "schreiten und den Vorhof verlassen muessen.");

  AddSound( DEFAULT_SOUND,
    "Leises Stimmengewirr dringt an Dein Ohr.");

  AddSound( ({ "stimmengewirr", "gewirr" }),
    "Du hoerst die leisen Stimmen der vielen Palastbesucher, die sich "
    "hier um Dich herum auf dem Platz tummeln.");

  AddSound( ({ "stimmen", "stimme" }),
    "Du verstehst nicht, was sie sagen.");

  AddSound( ({ "besucher", "palastbesucher", "personen" }),
    "Es befinden sich recht viele Personen auf diesem Platz, die "
    "anscheinend alle den Palast besuchen wollen.");

  AddSound( ({ "platz" }),
    "Du hoerst leises Stimmengewirr.");

  AddSound( ({ "ohr" }),
    "An Deinem eigenen Ohr zu lauschen, macht nicht allzuviel Sinn.");

  AddSound( ({ "sinn" }),
    "Um nicht zu sagen, ueberhaupt keinen.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm kuehl und sehr frisch hier draussen.");

  AddSmell( ({ "luft" }),
    "Du fuehlst Dich wohl.");

  AddSpecialDetail( ({ "wetter" }),
    "strwetter");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", "nach Norden#" + "./vorhof_b1" );
  AddExit( "nordosten", "nach Nordosten#" + "./vorhof_c1" );
  AddExit( "nordwesten", "nach Nordwesten#" + "./vorhof_a1" );
  AddExit( "tor", "zurueck auf den Waldweg#" + "/d/kristallwald/delgo/waldwege/room/dh33" );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "schreit", "schreite" }), "schreiten" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer Special Details----------------------------------------

string strwetter(string key)
{
  string s;

  s = "Du schmetterst lauthals ein Loblied in den Himmel:\n"
  +"'Sooo ein Taaaaag, so wuuunderschoen wie heeeuteee...'\n";

  TO->Message(TP->Name(WER, 1)+" faengt lauthals an zu singen. Entsetzt "
  +"haeltst Du Dir die Ohren zu.\n",
  MSGFLAG_SOUND|MSGFLAG_NO_TP);

  return break_string(s, 78, 0, BS_LEAVE_MY_LFS);
}

//--Funktionen fuer Kommandos----------------------------------------------

//durch Tor schreiten:
int schreiten(string str)
{
  notify_fail("Wo moechtest Du hindurchschreiten?\n");

  if(!str || str == "") return 0;

  if(!(str == "durch tor" ||
       str == "durch das tor" ||
       str == "durch tor hindurch" ||
       str == "durch das tor hindurch")) return 0;

  write(BS("Du schreitest mit erhabener Miene durch das Tor, "
  +"betrachtest noch einmal eindringlich den Waldweg, der dort "
  +"liegt, und marschierst dann zufrieden wieder zurueck auf den "
  +"Vorhof."));

  TO->Message(BS(TP->Name(WER, 1)+" schreitet durch das weisse Tor "
  +"und kommt kurz darauf wieder zurueck."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;
}
