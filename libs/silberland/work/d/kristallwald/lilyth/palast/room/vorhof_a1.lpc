#include "../def.h"
#include <laden.h>
#include <food.h>

inherit "std/laden";

//--Variablen&Defines------------------------------------------------------

int gras;

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------

  gras = DA;
  RemoveItem("/obj/entsorg"); //Muellschlucker weg
  RemoveFixedObject("/obj/boerse");
  RemoveFixedObject("/obj/stempel");

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Auf einem grossen Vorhof");
  SetProp(P_INT_LONG,
    "Du befindest Dich in der westlichen Ecke des grossen Vorhofs vor "
    "dem riesigen Palast, der sich einige Meter vor Dir gegen den "
    "fast wolkenlosen Himmel erhebt. Du kannst hier einige "
    "Pferdeunterstaende sehen, ebenso wie eine Traenke fuer die Tiere und "
    "einen grossen Haufen Heu, der direkt daneben auf dem Boden liegt.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  SetProp(P_SHOPKEEPER_ID, "obstverkaeufer");
  SetProp(P_SHOPKEEPER_NAME, "der Obstverkaeufer");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetStorageRoom(ROOM "vorhof_lagerraum_obst" );
  SetProp(P_SPECIAL_SHOP, ([P_FOOD_INFO:"Der Obstverkaeufer sagt: Ich kaufe "
  +"nur essbare Sachen!\n"]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "ecke" }),
    "Dies ist die westliche Ecke des Vorhofs.");

  AddDetail( ({ "vorhof" }),
    "Du befindest Dich auf dem Vorhof des Palastes.");

  AddDetail( ({ "palast" }),
    "Die weissen Mauern des gewaltigen Palastes erheben sich einige "
    "Meter vor Dir in den Himmel.");

  AddDetail( ({ "mauern", "mauer" }),
    "Der gesamte Palast wurde aus weissen Steinen erbaut.");

  AddDetail( ({ "steine" }),
    "Sie sind hellweiss und glaenzen leicht in der Sonne.");

  AddDetail( ({ "meter" }),
    "Die Entfernung von Dir bis zum Palast betraegt etwa "
    "fuenfundzwanzig Meter.");

  AddDetail( ({ "entfernung" }),
    "Man koennte auch sagen, der Abstand zwischen Dir und dem Palast.");

  AddDetail( ({ "abstand" }),
    "Abstand und Entfernung haben in etwa die gleiche Bedeutung.");

  AddDetail( ({ "bedeutung" }),
    "Es bedeutet so ziemlich das gleiche.");

  AddDetail( ({ "himmel" }),
    "Der Himmel ist fast vollkommen klar. Du siehst nur wenige Wolken und "
    "die Sonne scheint auf Dich herab.");

  AddDetail( ({ "sonne" }),
    "Die Sonne scheint vom Himmel herab und waermt Dich ein wenig.");

  AddDetail( ({ "wolken", "wolke" }),
    "Du kannst kaum welche sehen. Nur um die Turmspitze des Palastes herum "
    "hat sich eine kleine Wolkendecke gebildet.");

  AddDetail( ({ "turmspitze", "spitze" }),
    "Die Spitze des Turmes verschwindet fast in den Wolken.");

  AddDetail( ({ "turm" }),
    "Ein schmaler Turm ragt vom Palast hinauf. Seine Spitze reicht bis "
    "in die Wolken.");

  AddDetail( ({ "wolkendecke" }),
    "Um die Turmspitze herum haben sich ein paar Wolken gebildet. "
    "Ansonsten ist der Himmel voellig wolkenlos.");

  AddDetail( ({ "pferdeunterstaende", "unterstaende", "unterstand",
                "pferdeunterstand" }),
    "Die Unterstaende bestehen eigentlich nur aus ein paar grob "
    "zusammengehauenen Holzbrettern und Balken. Der Boden unter den "
    "Unterstaenden ist mit Stroh bedeckt.");

  AddDetail( ({ "holzbretter", "bretter", "holz", "holzbrett", "brett" }),
    "Die Holzbretter bilden die Waende und das Dach der Unterstaende. "
    "Sie werden mit langen Naegeln zusammengehalten.");

  AddDetail( ({ "waende", "wand" }),
    "Die Unterstaende haben nur drei Waende und sind zu einer Seite hin "
    "voellig offen.");

  AddDetail( ({ "seite" }),
    "Dort kannst Du in die Unterstaende hineinschauen.");

  AddDetail( ({ "dach" }),
    "Das flache Dach der Unterstaende wird ebenfalls durch lange "
    "aneinandergereihte Holzbretter gebildet.");

  AddDetail( ({ "naegel", "nagel" }),
    "Lange, schon ein wenig verrostete Naegel halten die Holzbretter "
    "zusammen.");

  AddDetail( ({ "rost" }),
    "Die Naegel sind schon ein wenig verrostet.");

  AddDetail( ({ "holzbalken", "balken" }),
    "Die Holzbalken bilden die Stuetzen fuer die aus Holzbrettern "
    "zusammengezimmerten Waende und das Dach.");

  AddDetail( ({ "stuetzen", "stuetze" }),
    "Wenn die Holzbalken nicht vorhanden waeren, wuerden die Unterstaende "
    "einfach in sich zusammenfallen.");

  AddDetail( ({ "boden unter unterstaende", "boden unter unterstaenden" }),
    "Der Boden, auf dem die Pferde stehen, ist mit einer dicken Lage Stroh "
    "bedeckt.");

  AddDetail( ({ "lage" }),
    "Sie ist bestimmt zehn Zentimeter dick.");

  AddDetail( ({ "zentimeter" }),
    "Na gut, vielleicht sind es auch ein paar weniger.");

  AddDetail( ({ "stroh" }),
    "Das Stroh sieht sehr frisch aus. Anscheinend wird hier regelmaessig "
    "ausgemistet.");

  AddDetail( ({ "traenke" }),
    "Eine breite Traenke aus Stein befindet sich direkt vor den "
    "Pferdeunterstaenden. Sie ist mit klarem, sauberem Wasser gefuellt.");

  AddDetail( ({ "stein" }),
    "Die Traenke besteht aus Stein.");

  AddDetail( ({ "pferde" }),
    "Zwei grosse Pferde sind mit Lederriemen unter den Unterstaenden "
    "festgebunden. Eines der Pferde hat ein besonders schoenes "
    "schwarzglaenzendes Fell, das andere ist braunweissgetupft.");

  AddDetail( ({ "lederriemen", "riemen" }),
    "Die beiden Pferde sind mit langen braunen Lederriemen an den "
    "Holzbalken festgebunden.");

  AddDetail( ({ "pferd" }),
    "Welches der Pferde moechtest Du Dir naeher ansehen?");

  AddDetail( ({ "schwarzes pferd" }),
    "Das grosse schwarze Pferd sieht sehr edel und gepflegt aus. Es hat "
    "einen sehr schmalen, fein geformten Kopf und schwarzes glaenzendes "
    "Fell. Mit seinen grossen dunklen Augen blickt es Dich ruhig an.");

  AddDetail( ({ "kopf" }),
    "Der Kopf ist fein geformt und sehr schmal.");

  AddDetail( ({ "augen" }),
    "Grosse dunkelschimmernde Augen blicken Dich sanftmuetig an.");

  AddDetail( ({ "braunweissgetupftes pferd" }),
    "Das braunweissgetupfte Pferd ist etwas kleiner als das schwarze Pferd "
    "neben ihm. Es hat lange, zottige Haare und irgendwie hast Du das "
    "Gefuehl, dass es Dich angrinst.");

  AddDetail( ({ "haare", "haar" }),
    "Die langen zottigen Haare reichen fast bis auf den Boden herab.");

  AddDetail( ({ "gefuehl" }),
    "Das kleinere Pferd hat sein Maul halb geoeffnet, so dass Du seine "
    "grossen Zaehne erkennen kannst. Es sieht fast so aus, als wuerde es "
    "Dich froehlich angrinsen.");

  AddDetail( ({ "maul", "pferdemaul" }),
    "Das Pferdemaul ist halb geoeffnet.");

  AddDetail( ({ "zaehne", "pferdezaehne" }),
    "Grosse, ein wenig gelblich verfaerbte Pferdezaehne blinken Dir "
    "entgegen.");

  AddDetail( ({ "fell" }),
    "Das Fell des schwarzen Pferdes hat einen dunklen Glanz und sieht "
    "aeusserst gepflegt aus.");

  AddDetail( ({ "glanz" }),
    "Das Fell schimmert in einem edlen dunklen Glanz.");

  AddDetail( ({ "haufen", "heuhaufen" }),
    "Ein grosser Heuhaufen liegt neben der Traenke auf dem Boden.");

  AddDetail( ({ "heu" }),
    "Das Heu sieht sehr frisch aus. Es scheint den Pferden als Nahrung zu "
    "dienen.");

  AddDetail( ({ "nahrung" }),
    "Pferde fressen unter anderem Heu.");

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus hellen Pflastersteinen, die jedoch mit einer "
    "duennen Sandschicht ausgestreut sind.");

  AddDetail( ({ "pflastersteine", "pflaster", "pflasterstein" }),
    "Der Boden besteht aus hellen Pflastersteinen.");

  AddDetail( ({ "sandschicht", "schicht" }),
    "Heller, fast weisser Sand bedeckt den Boden. Nur an wenigen Stellen "
    "kannst Du noch das Pflaster darunter erkennen.");

  AddDetail( ({ "sand" }),
    "Der gesamte Boden ist mit einer hellen Sandschicht ueberzogen.");

  AddDetail( ({ "stellen", "stelle" }),
    "Um die Pferdeunterstaende herum ist der Sand recht stark zertreten, "
    "so dass Du das Pflaster darunter erkennen kannst.");

  AddSound( DEFAULT_SOUND,
    "Ab und zu dringt ein leises Wiehern und Schnauben unter den "
    "Pferdeunterstaenden hervor. Ansonsten ist hier nicht sehr viel zu "
    "hoeren.");

  AddSound( ({ "wiehern", "schnauben", "geraeusche" }),
    "Ein leises Wiehern und Schnauben ist zu hoeren.");

  AddSound( ({ "pferdeunterstaende", "unterstaende" }),
    "Die Pferde geben leise, friedliche Geraeusche von sich.");

  AddSound( ({ "pferde", "pferd" }),
    "Die Geraeusche kommen von den Pferden unter den Unterstaenden.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig nach Pferden und Stroh.");

  AddSmell( ({ "pferde", "pferdegeruch", "geruch", "pferd" }),
    "Die Pferde riechen eigentlich sehr angenehm und sauber.");

  AddSmell( ({ "stroh" }),
    "Die Unterstaende sind mit frischem Stroh ausgelegt.");

  AddSmell( ({ "unterstaende", "pferdeunterstaende" }),
    "Unter den Unterstaenden dringt ein leichter Pferdegeruch hervor.");

  AddSmell( ({ "heu" }),
    "Du schnupperst ein wenig an dem Heuhaufen herum und musst dann "
    "einmal kraeftig niesen. Hatschi!");

  AddSpecialDetail( ({ "wasser" }),
    "strwasser");

  AddSpecialDetail( ({ "grashalme", "halme", "grashalm", "halm" }),
    "strgrashalme");

  AddSpecialDetail( ({ "wasseroberflaeche", "oberflaeche" }),
    "strwasseroberflaeche");

  AddSpecialDetail( ({ "tiere" }),
    "strtiere");

  AddRoomMessage(
    ({"Du hoerst ein leises Wiehern.\n",
      "Eines der Pferde schluerft geraeuschvoll etwas Wasser aus der "
      "Traenke.\n"}),75,"func");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "osten", "nach Osten#" + "./vorhof_b1" );
  AddExit( "suedosten", "nach Suedosten#" + "./vorhof_b2" );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "fuetter", "fuettere" }), "fuettern" );
  AddCmd( ({ "fisch", "fische" }), "fischen" );
  AddCmd( ({ "grins", "grinse" }), "grinsen" );
  AddCmd( ({ "trink", "trinke" }), "trinken" );
  AddCmd( ({ "mist", "miste" }), "ausmisten" );
  AddCmd( ({ "durchsuch", "durchsuche", "durchwuehl", "durchwuehle",
  "wuehl", "wuehle" }), "wuehlen" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "obstverkaeufer", REFRESH_DESTRUCT);
  AddItem(NPC "yoshy", REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer Kommandos----------------------------------------------

//Pferd füttern:
int fuettern(string str)
{
  object mygras;

  notify_fail("Wen willst Du womit fuettern?\n");

  if(!str || str == "") return 0;

  if(!(str == "pferd mit gras" ||
       str == "pferd mit bueschel" ||
       str == "pferd mit grasbueschel" )) return 0;

       mygras = present("\ngrasbueschel",TP);

       if(mygras)
       {
         write(BS("Vorsichtig streckst Du Deine Hand mit dem "
         +"Gras aus. Nach einer Weile kommt eines der Pferde naeher an "
         +"Dich heran und entbloesst seine beachtlichen Pferdezaehne. "
         +"Dann nimmt es aeusserst behutsam das ihm angebotene Futter "
         +"aus Deiner Handflaeche und schnaubt Dich zum Dank leicht "
         +"an."));

         TO->Message(BS(TP->Name(WER, 1)+" fuettert eines der Pferde mit "
         +"ein wenig Gras.\n"), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
         mygras->remove();
         return 1;
       }
       else
       {
         write(BS("Aber Du hast doch gar nichts bei Dir, womit Du das "
         +"Pferd fuettern koenntest!\n"));
         return -1;
       }
}

//Gras aus Traenke fischen:
int fischen(string str)
{
  notify_fail("Was moechtest Du woraus fischen?\n");

  if(!str || str == "") return 0;

  if(!(str == "gras heraus" || str == "grashalm heraus" ||
       str == "grashalme heraus" || str == "halm heraus" ||
       str == "halme heraus" || str == "gras aus traenke" ||
       str == "grashalm aus traenke" || str == "grashalme aus traenke" ||
       str == "halm aus traenke" || str == "halme aus traenke" ||
       str == "gras aus traenke heraus" ||
       str == "grashalm aus traenke heraus" ||
       str == "grashalme aus traenke heraus" ||
       str == "halm aus traenke heraus" ||
       str == "halme aus traenke heraus" || str == "gras aus wasser" ||
       str == "grashalm aus wasser" || str == "grashalme aus wasser" ||
       str == "halm aus wasser" || str == "halme aus wasser" ||
       str == "gras aus wasser heraus" ||
       str == "grashalm aus wasser heraus" ||
       str == "grashalme aus wasser heraus" ||
       str == "halm aus wasser heraus" ||
       str == "halme aus wasser heraus" )) return 0;

  if(gras == DA)
  {
    write(BS("Du greifst mit beiden Haenden in das Wasser und "
    +"schoepfst die darin herumschwimmenden Grashalme heraus.\n"));

    TO->Message(BS(TP->Name(WER, 1)+" panscht froehlich mit beiden "
  	+"Haenden in der Traenke herum.\n"), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    gras = WEG;
    return 1;
  }
  else
  {
    write(BS("Es befinden sich doch gar keine Grashalme mehr in dem "
    +"Wasser!"));
    return -1;
  }
}

void reset()
{
        ::reset();
        gras = DA;
}

//braunweissgeflecktes Pferd angrinsen:
int grinsen(string str)
{
  notify_fail("Wen oder was willst Du angrinsen?\n");

  if(!str || str == "") return 0;

  if(!(str == "braunweissgetupftes pferd" ||
       str == "braunweissgetupftes pferd an" )) return 0;

  write(BS("Du grinst das braunweissgefleckte Pferd an und "
  +"faehrst dann entsetzt zurueck, als es auf Dich zukommt und Dir mit "
  +"seiner langen feuchten Zunge mitten ueber das Gesicht faehrt. "
  +"Wuaeeeh, das klebt!"));

  TO->Message(BS(TP->Name(WER, 1)+" scheint sich mit einem der Pferde "
  +"anzufreunden, denn es schlabbert "
  +(PL->QueryProp(P_GENDER)==MALE?"ihn":"sie")+" gerade von oben "
  +"bis unten ab."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

//Wasser aus Traenke trinken
int trinken(string str)
{
  notify_fail("Was willst Du woraus trinken?\n");

  if(!str || str == "") return 0;

  if(!(str == "wasser" ||
       str == "wasser aus traenke" ||
       str == "wasser aus pferdetraenke" )) return 0;

  if(gras == WEG)
  {
    write(BS("Du beugst Dich ueber die Traenke und schoepfst ein "
    +"wenig Wasser heraus. Hm, schmeckt gar nicht mal so uebel, auch "
    +"wenn es ein wenig frischer sein koennte."));

    TO->Message(BS(TP->Name(WER, 1)+" trinkt ein wenig Wasser aus der "
    +"Pferdetraenke."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;
  }
  else
  {
    write(BS("Aber in dem Wasser schwimmen doch viel zu viele "
    +"Grashalme herum, um daraus zu trinken."));
    return -1;
  }
}

//Unterstaende ausmisten
int ausmisten(string str)
{
  notify_fail("Was willst Du tun?\n");

  if(!str || str == "") return 0;

  if(!(str == "aus" ||
       str == "stroh aus" ||
       str == "unterstaende aus" ||
       str == "unterstand" )) return 0;

  write(BS("Das ueberlass mal lieber den Stallburschen."));
  return 1;
}

//im Heuhaufen wuehlen
int wuehlen(string str)
{
  notify_fail("Was willst Du durchwuehlen?\n");

  if(!str || str == "") return 0;

  if(!(str == "haufen" ||
       str == "heuhaufen" ||
       str == "heu" ||
       str == "in haufen" ||
       str == "in heuhaufen" ||
       str == "in heu" )) return 0;

  write(BS("Du durchwuehlst den Heuhaufen gruendlich, doch Du findest "
  +"nichts ausser Heu. Nun ja, es kann ja nicht in jedem Heuhaufen eine "
  +"Stecknadel versteckt sein."));

  TO->Message(BS(TP->Name(WER, 1)+" wuehlt im Heuhaufen herum."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

//--Funktionen fuer Details------------------------------------------------

string strwasser(string str)
{
  string s;

  if(gras == DA)
  {
  	s = "Abgesehen von ein paar vereinzelten Grashalmen, die auf der "
        "Wasseroberflaeche schwimmen, sieht das Wasser sehr sauber und klar "
        "aus.";
  }
  else
  {
  	s = "Das Wasser sieht sehr sauber und klar aus.";
  }
  return BS(s);
}

string strgrashalme(string str)
{
  string s;

  if(gras == DA)
  {
  	s = "Ein paar vereinzelte Grashalme schwimmen auf der "
  	"Wasseroberflaeche. Du koenntest sie vielleicht herausfischen.";
  }
  else
  {
  	s = "Es sind keine Grashalme zu sehen.";
  }
  return BS(s);
}

string strwasseroberflaeche(string str)
{
  string s;

  if(gras == DA)
  {
  	s = "Auf der glatten Wasseroberflaeche schwimmen ein paar Grashalme.";
  }
  else
  {
  	s = "Die Wasseroberflaeche ist voellig ruhig.";
  }
  return BS(s);
}

string strtiere(string str)
{
  string s;

  if(!present("\nyoshy"))
  {
    s = "Die einzigen Tiere, die Du hier momentan sehen kannst, sind "
  	   +"die beiden Pferde, die in den Unterstaenden untergebracht sind.";
  }
  else
  {
    s = "Die einzigen Tiere, die Du hier momentan sehen kannst, sind "
       +"die beiden Pferde, die in den Unterstaenden untergebracht sind, "
  	   +"und der kleine Hund, der gerade direkt vor Deinen Fuessen "
  	   +"herumwuselt.";
  }
  return BS(s);
}
