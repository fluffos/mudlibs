//--Funktionen fuer SpecialDetails-----------------------------------------

string strbaenke(string str)
{
  string s;
  s = "";

  if(BANK(TP))
  {
  	bank -= ({ capitalize(getuid(TP)) });

  	if(sizeof(bank) == 0)
  	{
  	        s = "Auf einer der Baenke sitzt Du.";
  	}
  	if(sizeof(bank) == 1)
  	{
  	        s = "Du und "+bank[0]+" sitzt auf den Baenken.";
  	}
  	if(sizeof(bank) > 1)
  	{
  	        s = "Ausser Dir selbst sitzen auch "+MyCountUp(bank)+" "
  	        +"auf den Baenken.";
  	}

  	bank += ({ capitalize(getuid(TP)) });
   }
   else
   {
  	if(sizeof(bank) == 1)
  	{
  	        s = "Auf einer der Baenke sitzt "+bank[0]+".";
  	}
  	if(sizeof(bank) > 1)
  	{
  	        s = "Auf den Baenken sitzen "+MyCountUp(bank)+".";
  	}
   }
   return BS("Auf dem grossen Teppich stehen ein paar niedrige Baenke im "
   +"Kreis um den Haufen Kissen herum, der dort liegt. Sie sind weich "
   +"gepolstert und sehen recht bequem aus. "+s);
}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_int_long()
{
  string txt;
  string s;

  if(present("mahmud"))
  {
          s = "Darauf sitzt ein weisshaariger, alter Mann, "
          +"der Dir freundlich entgegenblickt. ";
  }
  else
  {
          s = "";
  }

  txt = "Du bist auf einem grossen, kreuzungsaehnlichen Platz angelangt. "
       +"Eine breite, abgewinkelte Treppe fuehrt hier wieder hinab in "
       +"das Mittelgeschoss. Im Zentrum des Platzes liegt ein riesiger, "
       +"runder Teppich, in dessen Mitte einige Kissen angeordnet sind. "
       +s+"Um die Kissen herum stehen ein paar niedrige Baenke.";

/*
  txt = "Du bist auf einem grossen, kreuzungsaehnlichen Platz angelangt. "
       +"Eine breite, abgewinkelte Treppe fuehrt hier weiter nach oben und "
       +"nach unten. Im Zentrum des Platzes liegt ein riesiger, runder "
       +"Teppich, in dessen Mitte einige Kissen angeordnet sind. "
       +s+"Um die Kissen herum stehen ein paar niedrige Baenke.";
*/
   return BS(txt);
}

//auf Bank sitzen:
int sitzen(string str)
{
  notify_fail("Wo moechtest Du Dich hinsetzen?\n");

  if(!str || str == "") return 0;

  if(str == "auf bank" ||
     str == "auf baenke")
  {
      if(BANK(TP))
      {
         write("Aber Du sitzt doch bereits auf einer der Baenke.\n");
         return -1;
      }

      if(sizeof(bank) > 4)
      {
         write(BS("Es ist leider kein freier Platz mehr da.\n"));
         return -1;
      }

      write(BS("Du setzt Dich auf eine der Baenke."));

      TO->Message(BS(TP->Name(WER, 1)+" setzt sich auf eine der Baenke."),
      MSGFLAG_VISUAL|MSGFLAG_NO_TP);

      bank += ({ capitalize(getuid(TP)) });
      return 1;
  }

  if(str == "auf kissen")
  {
      if(present("mahmud"))
      {
         write(BS("Aber Mahmud sitzt doch dort!"));
         return -1;
      }
      else
      {
         write(BS("Du machst es Dir auf den Kissen bequem. Ploetzlich "
         +"wirst Du Dir der zahlreichen empoerten Blicke der anderen "
         +"Palastbesucher bewusst, die um Dich herumstehen. Du stammelst "
         +"verlegen etwas und springst dann schnell wieder auf."));

         TO->Message(BS(TP->Name(WER, 1)+" macht es sich auf den Kissen "
         +"bequem, springt jedoch schnell wieder auf, als die anderen "
         +"Palastbesucher "+(PL->QueryProp(P_GENDER)==MALE?"ihn":"sie")+" "
         +"empoert anstarren."),
         MSGFLAG_VISUAL|MSGFLAG_NO_TP);
         return 1;
      }
  }
}

//von Bank aufstehen:
int aufstehen(string str)
{
  notify_fail("Was moechtest Du tun?\n");

  if(!str || str == "") return 0;

  if(!(str == "von bank auf" ||
       str == "auf")) return 0;

  if(BANK(TP))
  {
        write(BS("Du stehst wieder auf."));

        TO->Message(BS(TP->Name(WER, 1)+" steht von einer der Baenke auf."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  }
  else
  {
        write(BS("Aber Du sitzt doch gar nicht auf einer der Baenke."));
        return -1;
  }

  bank -= ({ capitalize(getuid(TP)) });
  return 1;
}

//Test beim Verlassen des Raumes, ob man auf der Bank sitzt
int exit_test(string dir)
{
        if(BANK(TP))
        {
                write(BS("Dazu solltest Du erstmal aufstehen."));
                return 0;
        }

        return 1;
}

//Spieler logt aus waehrend des auf der Bank Sitzens
void BecomesNetDead(object spieler)
{
  if(BANK(spieler))
  bank -= ({ capitalize(getuid(spieler)) });
}

//Spieler stirbt waehrend des Sitzens
void NotifyPlayerDeath(object spieler, object killer, int lost_xp)
{
  if(BANK(spieler))
  bank -= ({ capitalize(getuid(spieler)) });
}
