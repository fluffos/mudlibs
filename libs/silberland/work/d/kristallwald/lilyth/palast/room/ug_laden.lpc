#include "../def.h"
#include <laden.h>

inherit "std/laden";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"In einem kleinen dunklen Laden");
  //SetProp(P_INT_LONG, ""); -> siehe unten

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_SHOPKEEPER_ID, "velg'larn");
  SetProp(P_SHOPKEEPER_NAME, "Velg'larn");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetStorageRoom(ROOM "ug_lagerraum_laden" );

//--Details----------------------------------------------------------------

  AddDetail( ({ "licht" }),
    "Ein sehr schwaches, schummriges Licht herrscht in diesem Laden.");

  AddDetail( ({ "laden", "raum" }),
    "Du befindest Dich in einem kleinen Laden.");

  AddDetail( ({ "augen", "auge" }),
    "Deine Augen brauchen einen kleinen Moment, um sich an die hier "
    "herrschende Dunkelheit zu gewoehnen.");

  AddDetail( ({ "moment" }),
    "Erst nach einem kurzen Moment gewoehnen sich Deine empfindlichen Augen "
    "an die Dunkelheit.");

  AddDetail( ({ "dunkelheit" }),
    "Richtig dunkel ist es hier zwar nicht, aber im Gegensatz zu draussen "
    "merkt man den Unterschied schon sehr stark.");

  AddDetail( ({ "gegensatz" }),
    "Dort draussen beim Brunnen war es viel heller als hier drinnen.");

  AddDetail( ({ "brunnen" }),
    "Der befindet sich im Suedosten.");

  AddDetail( ({ "suedosten" }),
    "Im Suedosten kannst Du den Laden wieder verlassen.");

  AddDetail( ({ "unterschied" }),
    "Hell - Dunkel.");

  AddDetail( ({ "hell" }),
    "Draussen war es sehr hell.");

  AddDetail( ({ "dunkel" }),
    "Hier ist es recht dunkel.");

  AddDetail( ({ "umrisse", "umriss" }),
    "Nur schwach kannst Du die Umrisse der Regale erkennen, die unordentlich "
    "mit unzaehligen Gegenstaenden vollgestopft sind.");

  AddDetail( ({ "gegenstaende", "gegenstand" }),
    "Das duerften wohl die Waren sein, die der Haendler hier verkauft.");

  AddDetail( ({ "waren", "ware" }),
    "Wenn Du einfache Dinge fuer den taeglichen Gebrauch suchst, wirst Du "
    "hier sicher fuendig.");

  AddDetail( ({ "dinge", "ding" }),
    "Alles moegliche.");

  AddDetail( ({ "gebrauch" }),
    "Was man eben so alles braucht im taeglichen Leben.");

  AddDetail( ({ "leben" }),
    "Nach dem Leben folgt meistens der Tod.");

  AddDetail( ({ "tod" }),
    "Du bist noch nicht tot. Zum Glueck.");

  AddDetail( ({ "glueck" }),
    "Hoffentlich haelt Dein Glueck noch eine Weile an.");

  AddDetail( ({ "weile" }),
    "Du lebst ja immer noch!\n"
    "Lars reibt sich die Haende in der Ferne.");

  AddDetail( ({ "lars" }),
    "Lars ist eigentlich ganz lieb. Der Tod hingegen... nun ja.");

  AddDetail( ({ "haende", "hand" }),
    "Du koenntest Deine Haende auch mal wieder waschen.");

  AddDetail( ({ "ferne" }),
    "Du siehst ihn zwar nicht, aber Du weisst: Irgendwo da draussen ist er.");

  AddDetail( ({ "regale", "regal" }),
    "Die Regale sind bis obenhin mit zahlreichen Gegenstaenden "
    "vollgestopft.");

  AddDetail( ({ "schraenke", "schrank" }),
    "Die Schraenke sind so mit allerlei Waren ueberfuellt, dass sie sich "
    "nicht einmal mehr schliessen lassen.");

  AddDetail( ({ "schild" }),
    "Du kannst es lesen.");

  AddDetail( ({ "ostwand", "wand" }),
    "An der Ostwand haengt ein kleines Schild.");

  AddDetail( ({ "boden" }),
    "Obwohl der Besitzer dieses Ladens nicht allzu ordentlich zu sein "
    "scheint, sieht der Boden hier sehr sauber aus. Du kannst keinen "
    "Staub oder Schmutz entdecken.");

  AddDetail( ({ "staub" }),
    "Es liegt kein einziges Staubkoernchen auf dem Boden.");

  AddDetail( ({ "staubkoernchen" }),
    "Wenn Du Dich anstrengst, findest Du ja vielleicht doch irgendwo eines.");

  AddDetail( ({ "schmutz" }),
    "Es ist zwar nicht sehr ordentlich in diesem Laden, aber Schmutz "
    "kannst Du hier wirklich nirgendwo entdecken.");

  AddDetail( ({ "decke" }),
    "In diesem dunklen Licht kannst Du die Decke nicht sehr genau erkennen.");

  AddDetail( ({ "theke" }),
    "Die Verkaufstheke besteht aus dunklem Holz.");

  AddDetail( ({ "verkaufstheke" }),
    "Ueber diese Theke ist sicher schon die eine oder andere, mehr oder "
    "weniger legale Ware gewandert.");

  AddDetail( ({ "kundschaft" }),
    "Rein aeusserlich sieht der Laden nicht gerade so aus, als ob er "
    "sehr viel Umsatz machen wuerde. Aber vielleicht taeuscht das ja auch.");

  AddDetail( ({ "umsatz" }),
    "Vielleicht hat sein Besitzer es auch einfach nur gerne etwas "
    "schlichter.");

  AddDetail( ({ "holz" }),
    "Dunkles Mahagoniholz.");

  AddDetail( ({ "mahagoniholz", "mahagoni" }),
    "Mahagoni ist ein sehr pflegeleichtes und unempfindliches Holz.");

  AddDetail( ({ "waende" }),
    "An den Waenden sind Fackelhalter befestigt, in denen lange schwarze "
    "Fackeln stecken. An der Ostwand haengt ein kleines Schild und im "
    "Suedosten befindet sich der Eingang, durch den Du den Laden betreten "
    "hast.");

  AddDetail( ({ "fackelhalter", "halter" }),
    "Die Halter bestehen aus einem dunklen Metall. Lange schwarze Fackeln "
    "stecken in ihnen.");

  AddDetail( ({ "metall" }),
    "Es handelt sich sicher um eine Art Eisen.");

  AddDetail( ({ "art", "eisen" }),
    "Schwarzgefaerbtes Eisen.");

  AddDetail( ({ "fackeln", "fackel" }),
    "Es sind keine normalen Fackeln, sondern schwarze Hoellenfackeln, die "
    "den Raum eher verdunkeln, als dass sie Licht spenden.");

  AddDetail( ({ "hoellenfackeln", "hoellenfackel" }),
    "Die Hoellenfackeln verbreiten kein Licht, sondern Dunkelheit.");

  AddDetail( ({ "eingang" }),
    "Dort kannst Du den Laden auch wieder verlassen.");

  AddDetail( ({ "nackenhaare", "haare" }),
    "Deine Nackenhaare straeuben sich beim Gedanken an das, was da "
    "womoeglich in dem Regal lauert.");

  AddDetail( ({ "gedanken", "gedanke" }),
    "Denk lieber gar nicht weiter darueber nach.");

  AddDetail( ({ "haendler", "besitzer" }),
    "Der scheint gerade nicht da zu sein.");

  AddDetail( ({ "gestalt" }),
    "Die ist schon laengst wieder verschwunden.");

  AddDetail( ({ "paeckchen" }),
    "Was das wohl war?");

  AddReadDetail( ({ "schild" }),
    "x-----------------------------x\n"
    "|     Gemischtwarenladen      |\n"
    "|                             |\n"
    "|   Aushaendigung der Ware    |\n"
    "|    nur gegen Barzahlung     |\n"
    "x-----------------------------x\n");

  AddSound( DEFAULT_SOUND,
    "Es ist sehr ruhig hier im Laden. Ab und zu glaubst Du, ein leises "
    "Rascheln oder Kratzen aus einem der Regale zu hoeren.");

  AddSound( ({ "laden" }),
    "Abgesehen von dem leisen Rascheln und Kratzen ist es hier sehr ruhig.");

  AddSound( ({ "rascheln", "kratzen" }),
    "Was mag das nur sein?");

  AddSound( ({ "regal", "regale" }),
    "Unauffaellig naeherst Du Dich dem Regal, aus dem die leisen Geraeusche "
    "dringen, als sie ploetzlich verstummen.");

  AddSound( ({ "geraeusche", "geraeusch" }),
    "Deine Nackenhaare straeuben sich. Irgendetwas ist in diesem Regal, "
    "Du traust Dich aber nicht nachzusehen, was es sein koennte.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig abgestanden und modrig hier im Laden.");

  AddSmell( ({ "laden" }),
    "Abgestandene Luft erfuellt den Laden.");

  AddSmell( ({ "luft" }),
    "Die Luft ist hier drinnen nicht sehr frisch.");

  AddRoomMessage(
    ({"Eine dunkle Gestalt betritt den Laden, spricht kurz mit Velg'larn "
    "und drueckt ihm unauffaellig etwas in die Hand, woraufhin der Haendler "
    "ihr ein geheimnisvoll aussehendes Paeckchen zusteckt. Dann huscht sie "
    "blitzschnell wieder hinaus.\n"}),135);

//--Ausgaenge--------------------------------------------------------------

  AddExit( "suedosten", "aus dem Laden#" + "./ug_mitte" );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "such", "suche" }), "staubkoernchen" );
  AddCmd( ({ "schliess", "schliesse" }), "schraenke" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "haendler", REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_int_long()
{
  string txt;

  txt = "Du stehst in einem kleinen, mit schummrigem Licht ausgefuellten "
  "Laden. Nachdem sich Deine Augen an die Dunkelheit gewoehnt haben, die "
  "hier herrscht, kannst Du die Umrisse einiger mit zahlreichen "
  "Gegenstaenden vollgestopfter Regale und Schraenke sowie ein kleines "
  "Schild an einer Wand erkennen. ";

  if(QueryProp(P_SHOPKEEPER_ID))
  {
        if(!present(QueryProp(P_SHOPKEEPER_ID)))
        {
                txt += "Leider scheint der Besitzer des Ladens gerade nicht "
                +"hier zu sein.";
        }
        else
        {
                txt += "Der Ladenbesitzer, ein schwarzgekleideter Dunkelelf, "
                +"steht hinter der Theke und wartet auf Kundschaft.";
        }
   }
   return BS(txt);
}

//Staubkorn suchen:
int staubkoernchen(string str)
{
  notify_fail("Wonach moechtest Du denn suchen?\n");

  if(!str || str == "") return 0;

  if(!(str == "staubkoernchen" ||
       str == "nach staubkoernchen" )) return 0;

  {
  	write(BS("Du kriechst auf allen Vieren ueber den Boden und "
  	+"entdeckst tatsaechlich ein klitzekleines Staubkoernchen. "
  	+"Ordentlich, wie Du nun einmal bist, pickst Du es vorsichtig "
  	+"mit dem Zeigefinger auf und laesst es draussen vor den Eingang "
  	+"fallen. Dann erhebst Du Dich ein wenig verlegen wieder."));

  	TO->Message(BS(TP->Name(WER, 1)+" kriecht auf allen Vieren "
  	+"ueber den Boden und scheint verzweifelt etwas zu suchen."),
  	MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        return 1;
  }
}

//Schraenke schliessen:
int schraenke(string str)
{
  notify_fail("Was moechtest Du schliessen?\n");

  if(!str || str == "") return 0;

  if(!(str == "schraenke" ||
       str == "schrank" )) return 0;

  {
  	write(BS("Mit aller Kraft stemmst Du Dich gegen einen der offenen "
  	+"Schraenke und versuchst, ihn zu schliessen, doch Du schaffst es "
  	+"nicht."));

  	TO->Message(BS(TP->Name(WER, 1)+" versucht, einen der Schraenke zu "
  	+"schliessen, schafft es jedoch nicht."),
  	MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        return 1;
  }
}
