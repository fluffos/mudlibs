#include "../def.h"

inherit "std/room";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem Palast");
  SetProp(P_INT_LONG,
    "Du bist am noerdlichen Ende des Palastes angelangt. Eine breite "
    "geschwungene Treppe aus glaesernen Stufen fuehrt hier in einem weiten "
    "Bogen nach oben. Rechts und links am Fuss der Treppe stehen zwei hohe "
    "Vasen aus geschliffenem Glas, in denen jeweils eine einzelne blaue "
    "Blume steckt.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "ende" }),
    "Dies ist das noerdliche Ende des Palastes.");

  AddDetail( ({ "palast" }),
    "Du befindest Dich im Untergeschoss des Palastes.");

  AddDetail( ({ "untergeschoss" }),
    "Dort bist Du jetzt gerade. Die Treppe fuehrt weiter hinauf ins "
    "Mittelgeschoss.");

  AddDetail( ({ "mittelgeschoss" }),
    "Wenn Du so neugierig bist, geh doch einfach mal hinauf.");

  AddDetail( ({ "treppe" }),
    "Die breite Treppe fuehrt in einem weiten Bogen hinauf ins "
    "Mittelgeschoss des Palastes. Die Stufen bestehen, wie Du jetzt "
    "erkennen kannst, aus Kristall.");

  AddDetail( ({ "stufen", "treppenstufen" }),
    "Die Stufen bestehen aus reinem Kristall. Gerade, als Du vorsichtig "
    "einen Fuss auf die unterste Stufe setzen willst, faellt Dir etwas an "
    "ihr auf.");

  AddDetail( ({ "fuss" }),
    "Du traust Dich kaum, einen Fuss auf eine der Treppenstufen zu setzen, "
    "aus Angst, sie zu beschaedigen.");

  AddDetail( ({ "angst" }),
    "Keine Sorge, die Stufen werden Dich sicher muehelos tragen koennen.");

  AddDetail( ({ "sorge", "sorgen" }),
    "Du brauchst Dir keine Sorgen zu machen.");

  AddDetail( ({ "stufe", "unterste stufe" }),
    "Neugierig beugst Du Dich hinunter und erkennst nun, dass in jede "
    "einzelne der vielen Stufen sehr feine duenne Linien eingelassen sind.");

  AddDetail( ({ "kristall" }),
    "Die Treppenstufen bestehen aus reinem Kristall.");

  AddDetail( ({ "linien", "linie" }),
    "Hauchduenne Muster wurden mit groesster Sorgfalt in jede einzelne "
    "Stufe eingearbeitet.");

  AddDetail( ({ "muster" }),
    "Eigentlich sind es nicht einfach nur blosse Muster, sondern Bilder.");

  AddDetail( ({ "bilder", "bild" }),
    "Die Bilder stellen verschiedene Szenen dar.");

  AddDetail( ({ "szenen", "szene" }),
    "Staunend betrachtest Du die zahlreichen Bilder, die auf den Stufen "
    "abgebildet werden. Erst jetzt bemerkst Du, dass auf jeder einzelnen "
    "Stufe andere Wesen und Orte dargestellt werden. Ploetzlich kommt Dir "
    "ein Gedanke.");

  AddDetail( ({ "wesen", "rassen" }),
    "Jede einzelne Stufe ist einem anderen Wesen des Silberlandes und seiner "
    "Entstehung gewidmet.");

  AddDetail( ({ "orte", "landschaften", "ort", "landschaft" }),
    "Obwohl die Szenen einfach nur in den Kristall hineingearbeitet wurden, "
    "glaubst Du, den Zauber der dort dargestellten Orte und Wesen beinahe "
    "spueren zu koennen. Helle freundliche Waelder wechseln sich ab mit "
    "dunklen hoehlenartigen Gaengen, sanfte Huegel gehen ueber in "
    "riesige Gebirgslandschaften.");

  AddDetail( ({ "zauber" }),
    "Von den dargestellten Orten geht ein spuerbarer Zauber aus, der Dir "
    "leichte Schauer ueber den Ruecken jagt und in Dir den sehnsuechtigen "
    "Wunsch weckt, diese Orte selbst einmal zu besuchen.");

  AddDetail( ({ "waelder", "wald" }),
    "Anmutig und majestaetisch erheben sich lichtdurchflutete Waelder vor "
    "Deinen Augen.");

  AddDetail( ({ "gaenge", "hoehlengaenge" }),
    "Dunkle, ein wenig unheimlich wirkende Hoehlengaenge werden ebenfalls "
    "auf den Stufen abgebildet.");

  AddDetail( ({ "huegel", "huegellandschaften" }),
    "Sanfte Huegellandschaften, die in hohe Bergmassive uebergehen, breiten "
    "sich vor Dir aus.");

  AddDetail( ({ "gebirgslandschaften", "bergmassive", "gebirgslandschaft",
  "bergmassiv"}),
    "Du siehst ueberwaeltigende Gebirgslandschaften, die sehr echt und "
    "originalgetreu im Kristall festgehalten wurden.");

  AddDetail( ({ "schauer", "ruecken" }),
    "Du spuerst den Zauber der dargestellten Landschaften deutlich.");

  AddDetail( ({ "wunsch" }),
    "Du schwoerst Dir selbst, dass Du all diese Orte irgendwann einmal "
    "mit eigenen Augen sehen wirst.");

  AddDetail( ({ "augen" }),
    "Irgendwann wirst Du sie selber sehen.");

  AddDetail( ({ "gedanke" }),
    "Du betrachtest die Szenen nochmals ganz genau und kommst schliesslich "
    "zu dem Schluss, dass auf jeder einzelnen Stufe die "
    "Entstehungsgeschichte einer der vielen Rassen des Silberlandes bildlich "
    "dargestellt wird.");

  AddDetail( ({ "silberland" }),
    "Viele verschiedene Wesen bevoelkern das Silberland.");

  AddDetail( ({ "schluss" }),
    "Du bist Dir ganz sicher.");

  AddDetail( ({ "entstehungsgeschichte", "geschichte", "entstehung" }),
    "Ehrfurcht erfuellt Dich angesichts dieser grossartigen schoepferischen "
    "Leistung, die sich dort vor Dir praesentiert.");

  AddDetail( ({ "ehrfurcht" }),
    "Du bist ueberwaeltigt.");

  AddDetail( ({ "leistung" }),
    "Nur ein wahrer Kuenstler koennte solch eine Arbeit vollbringen.");

  AddDetail( ({ "sorgfalt" }),
    "Das muss ein wahrer Kuenstler gewesen sein, der diese zahlreichen "
    "Szenen so sorgfaeltig in die Stufen eingraviert hat.");

  AddDetail( ({ "kuenstler" }),
    "Mit viel Liebe zum Detail wurde jede einzelne dieser Szenen in den "
    "Kristall eingearbeitet.");

  AddDetail( ({ "liebe" }),
    "Diesem Kuenstler hat seine Arbeit wohl sehr viel Spass gemacht, sonst "
    "haette er sich sicherlich nicht soviel Muehe gegeben.");

  AddDetail( ({ "arbeit" }),
    "All diese vielen Bilder in den harten Kristall einzuarbeiten... das "
    "war bestimmt keine leichte Arbeit.");

  AddDetail( ({ "spass" }),
    "Es hat ihm sicher viel Spass bereitet.");

  AddDetail( ({ "muehe" }),
    "Er hat sich wirklich sehr viel Muehe gegeben.");

  AddDetail( ({ "detail" }),
    "Jedes einzelne Detail wurde vom Kuenstler mit viel Liebe in den "
    "Stein eingraviert.");

  AddDetail( ({ "bogen" }),
    "Die Treppe fuehrt in einem weiten Bogen hinauf.");

  AddDetail( ({ "fuss" }),
    "Am Fuss der Treppe stehen zwei hohe Vasen aus Glas.");

  AddDetail( ({ "vasen", "vase" }),
    "Die beiden Vasen stehen unten am Fuss der Treppe. Sie bestehen aus "
    "geschliffenem Glas und weisen einige huebsche Verzierungen auf. In "
    "jeder der Vasen steckt eine Blume, die ein blaeuliches Licht "
    "ausstrahlt.");

  AddDetail( ({ "verzierungen", "verzierung" }),
    "Huebsche Verzierungen sind in dem Glas eingraviert worden.");

  AddDetail( ({ "licht" }),
    "Ein blaeuliches Licht geht von den Blumen aus.");

  AddDetail( ({ "glas" }),
    "Die beiden Vasen bestehen aus durchsichtigem geschliffenen Glas.");

  AddDetail( ({ "blume", "blumen" }),
    "Die Blumen haben grosse tiefblaue Blueten, die von innen her zu "
    "leuchten scheinen.");

  AddDetail( ({ "blueten", "bluete" }),
    "Da die Blueten zu leuchten scheinen, dachtest Du zunaechst, dass auch "
    "sie aus Kristall bestehen, doch dann bemerkst Du erstaunt, dass sie "
    "echt sind. Die Blaetter fuehlen sich weich und zart an, als Du sie "
    "beruehrst, und ein lieblicher Duft geht von ihnen aus.");

  AddDetail( ({ "blaetter", "blatt" }),
    "Samtweich fuehlen sich die Bluetenblaetter unter Deinen Fingern an.");

  AddDetail( ({ "finger" }),
    "Vorsichtig beruehrst Du die zarten Bluetenblaetter.");

  AddDetail( ({ "bluetenblaetter", "bluetenblatt" }),
    "Die Blumen haben blaue Blueten.");

  AddDetail( ({ "duft" }),
    "Riech doch mal.");

  AddDetail( ({ "boden" }),
    "Du stehst auf einem mit flauschigen weissen Laeufern ausgelegten "
    "hellen Marmorboden.");

  AddDetail( ({ "laeufer" }),
    "Schneeweisse Laeufer wurden auf dem glatten Marmorboden ausgelegt.");

  AddDetail( ({ "marmorboden" }),
    "Der Boden besteht aus weissem Marmor.");

  AddDetail( ({ "marmor" }),
    "Wie kein anderer Stein repraesentiert weisser Marmor Erhabenheit und "
    "Reinheit von Geist und Anmut.");

  AddDetail( ({ "stein" }),
    "Marmor ist eine besonders wertvolle Steinart.");

  AddDetail( ({ "steinart" }),
    "Marmor ist eine Steinart.");

  AddDetail( ({ "erhabenheit", "groesse" }),
    "Groesse und Erhabenheit strahlt der weisse Marmor aus.");

  AddDetail( ({ "reinheit" }),
    "Du hast fast das Gefuehl, nichts auf der Welt koenne reiner sein als "
    "dieser weisse Marmor.");

  AddDetail( ({ "gefuehl" }),
    "Dein Gefuehl taeuscht Dich nicht.");

  AddDetail( ({ "welt" }),
    "Es gibt mit Sicherheit nicht viel auf dieser Welt, das reiner ist "
    "als dieser Marmor.");

  AddDetail( ({ "sicherheit" }),
    "Da bist Du Dir ziemlich sicher.");

  AddDetail( ({ "geist" }),
    "Ob Dein Geist auch so rein ist?");

  AddDetail( ({ "anmut" }),
    "Anmutig taenzelst Du ein paar Schritte durch den Raum und drehst "
    "einige etwas unbeholfen wirkende Pirouetten.");

  AddDetail( ({ "schritte", "schritt" }),
    "Du machst einen Schritt nach dem anderen.");

  AddDetail( ({ "raum" }),
    "Du stehst vor einer grossen kristallenen Treppe.");

  AddDetail( ({ "pirouetten", "pirouette" }),
    "Du drehst Dich einmal um Dich selbst.");

  AddDetail( ({ "decke" }),
    "Helle weisse Steine bilden die Decke ueber Deinem Kopf.");

  AddDetail( ({ "steine" }),
    "Auch die Steine haben eine gleichmaessige weisse Farbe.");

  AddDetail( ({ "farbe" }),
    "Weiss ist eindeutig die vorherrschende Farbe hier.");

  AddDetail( ({ "kopf" }),
    "Die Decke befindet sich ueber Deinem Kopf.");

  AddDetail( ({ "waende", "wand" }),
    "Anders als in den uebrigen Raeumen des Palastes, die Du bisher gesehen "
    "hast, sind die Waende hier nur aus schlichtem, weissem Marmor und "
    "weisen keinerlei sonstige Ausschmueckungen auf.");

  AddDetail( ({ "raeume" }),
    "In den anderen Raeumen des Untergeschosses waren die Waende meist reich "
    "verziert.");

  AddDetail( ({ "ausschmueckungen", "schmuck", "ausschmueckung" }),
    "Der einzige Schmuck an den Waenden ist der reine, weisse Marmor "
    "selbst, aus dem sie bestehen.");

  AddSound( DEFAULT_SOUND,
    "Ehrfuerchtige Stille herrscht hier.");

  AddSound( ({ "stille" }),
    "Du hoerst nichts, ausser den Geraeuschen, die Du selbst verursachst.");

  AddSound( ({ "geraeusche", "geraeusch" }),
    "Du lauschst an Dir, hoerst aber nichts Besonderes.");

  AddSound( ({ "besonderes" }),
    "Laut schnippst Du mit den Fingern direkt neben Deinem rechten Ohr und "
    "erschrickst fuerchterlich.");

  AddSound( ({ "finger", "ohr" }),
    "Siehst Du, jetzt hast Du doch etwas gehoert. ;)");

  AddSmell( DEFAULT_SMELL,
    "Ein schwacher Duft durchzieht den Raum.");

  AddSmell( ({ "duft" }),
    "Der Duft scheint von den Blumen neben der Treppe zu kommen.");

  AddSmell( ({ "blumen", "blume", "bluete", "blueten" }),
    "Die Blueten stroemen einen schwachen, aber sehr angenehmen Duft aus.");

  AddSmell( ({ "treppe" }),
    "Neben der Treppe stehen zwei hohe Vasen, in denen jeweils eine duftende "
    "blaue Blume steckt.");

  AddSmell( ({ "vasen", "vase" }),
    "Die Blumen in den Vasen duften sehr angenehm.");

  AddSmell( ({ "raum" }),
    "Ein schwacher Duft durchzieht den Raum.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "sueden", "nach Sueden#" + "./ug_gang3" );
  AddExit( "oben", "die Treppe hinauf#" + "./mg_treppe1" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "soldat_ug2", REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

