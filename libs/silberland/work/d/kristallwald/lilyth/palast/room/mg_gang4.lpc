//=========================================================================
// File: mg_gang4.c
// Project: Palast
//
// Created by Lilyth (2004)
//=========================================================================

#include "../def.h"

inherit "std/room";

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem Palast");
  SetProp(P_INT_LONG,
    "Ein langer, breiter Gang fuehrt durch das Mittelgeschoss. Ein riesiges "
   "Gemaelde haengt an einer der Waende, die ebenso wie der mit hellblauen "
    "Teppichen ausgelegte Boden aus blauem, golddurchwirktem Marmor "
    "bestehen. Im Westen weitet sich der Gang zu einem kleinen, von "
    "schwachem Licht erhellten Raum aus.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INFO, "Das Gemaelde an der Wand hat irgendetwas Besonderes "
  "an sich.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "gang", "gaenge" }),
    "Der lange Gang fuehrt durch das Mittelgeschoss. Du kannst ihm nach "
    "Osten oder Westen weiter folgen.");

  AddDetail( ({ "mittelgeschoss" }),
    "Dies hier ist das Mittelgeschoss des Palastes.");

  AddDetail( ({ "untergeschoss" }),
    "Von dort bist Du hergekommen.");

  AddDetail( ({ "obergeschoss" }),
    "Warst Du heute schon mal dort?");

  AddDetail( ({ "geschoss" }),
    "Dieser Palast hat mehrere Geschosse, welches davon meinst Du denn?");

  AddDetail( ({ "palast" }),
    "Du stromerst schon seit geraumer Zeit hier herum.");

  AddDetail( ({ "geschosse" }),
    "Nun ja, da waeren das Untergeschoss, das Obergeschoss... und natuerlich "
    "das Mittelgeschoss, in dem Du Dich zur Zeit befindest.");

  AddDetail( ({ "zeit" }),
    "Zur Zeit befindest Du Dich im Mittelgeschoss.");

  AddDetail( ({ "gemaelde", "bild" }),
    "Das Gemaelde steckt in einem breiten, goldenen Rahmen. Es zeigt ein "
    "grosses Gebaeude auf einem Huegel, der von undurchdringlichem Wald "
    "umgeben ist. Das ganze kommt Dir irgendwie sehr bekannt vor.");

  AddDetail( ({ "gebaeude" }),
    "Das Gebaeude kommt Dir sehr bekannt vor. Als Du genauer hinsiehst, "
    "merkst Du, dass es den Palast darstellt, in dem Du Dich gerade "
    "befindest. Allerdings scheint er auf dem Bild noch nicht ganz "
    "fertig gebaut zu sein, denn Du kannst weder den Vorhof noch "
    "den hohen Turm entdecken, den Du draussen sehen konntest. "
    "Vor dem Palast sind einige grosse und kleine Gestalten abgebildet.");

  AddDetail( ({ "vorhof" }),
    "Du solltest ihn eigentlich gesehen haben, als Du hergekommen bist. "
    "Anders gesagt: Wenn Du ihn nicht gesehen hast... wie bist Du dann "
    "hierhergekommen?");

  AddDetail( ({ "turm" }),
    "Von draussen konntest Du einen hohen Turm sehen, der vom Palast "
    "emporragt, doch auf diesem Gemaelde ist er nicht zu sehen. Anscheinend "
    "ist er erst vor kurzem gebaut worden.");

  AddDetail( ({ "huegel" }),
    "Das Gebaeude steht auf einem dicht bewaldeten Huegel, der sich "
    "inmitten des Tethyrwaldes erhebt.");

  AddDetail( ({ "wald" }),
    "Bei dem Wald auf dem Gemaelde handelt es sich um den Tethyrwald, "
    "wie Du unschwer an den merkwuerdig blaufarbigen Baeumen erkennen "
    "kannst.");

  AddDetail( ({ "tethyrwald" }),
    "Der Tethyrwald ist auf dem Gemaelde zu sehen.");

  AddDetail( ({ "baeume", "baum" }),
    "Sie sind merkwuerdigerweise blau statt gruen.");

  AddDetail( ({ "gestalten" }),
    "Du siehst die verschiedenartigsten Wesen auf dem Gemaelde, die "
    "sich gegenseitig die Haende schuetteln, auf die Schultern klopfen "
    "oder sich auf sonstige Weise sehr freundlich gegenueber "
    "verhalten zu scheinen.");

  AddDetail( ({ "wesen" }),
    "Du siehst mehrere Mitglieder aller moeglichen Rassen auf dem Bild.");

  AddDetail( ({ "mitglieder" }),
    "Von jeder Rasse scheinen mehrere Mitglieder auf dem Gemaelde "
    "abgebildet zu sein. Ein kleiner Kobold faellt Dir besonders auf.");

  AddDetail( ({ "kobold" }),
    "Mitten unter den anderen Rassen ist ein kleiner Kobold zu sehen. "
    "Er hat ein schmales, spitzes Gesicht und sieht ein wenig griesgraemig "
    "aus. An seinem Guertel baumelt ein laengliches, glitzerndes Etwas.");

  AddDetail( ({ "gesicht" }),
    "Der Kobold hat ein spitzes, etwas verkniffenes Gesicht. Er starrt "
    "genau in Deine Richtung.");

  AddDetail( ({ "richtung" }),
    "Griesgraemig starrt Dich der kleine Kobold an. Irgendwie hast Du "
    "das Gefuehl, dass Du ihn kennst.");

  AddDetail( ({ "gefuehl" }),
    "Ob es der gleiche Kobold ist wie der, der unten den Brunnen bewacht? "
    "Dann muss er aber schon ziemlich alt sein, wenn er beim Bau dieses "
    "Palastes bereits lebte. Er koennte Dir sicher eine Menge darueber "
    "erzaehlen.");

  AddDetail( ({ "menge" }),
    "Frag ihn einfach mal aus, wenn es Dich so sehr interessiert.");

  AddDetail( ({ "bau" }),
    "Der Palast wurde schon vor ewigen Zeiten erbaut.");

  AddDetail( ({ "zeiten" }),
    "Es ist schon sehr lange her.");

  AddDetail( ({ "brunnen" }),
    "Der Brunnen im Untergeschoss wird von einem kleinen Kobold bewacht, "
    "der diesem hier ziemlich aehnlich sieht.");

  AddDetail( ({ "guertel" }),
    "An seinem Guertel siehst Du etwas baumelm.");

  AddDetail( ({ "etwas" }),
    "Es handelt sich um eine kleine Glocke.");

  AddDetail( ({ "glocke" }),
    "Wozu die wohl gut ist?");

  AddDetail( ({ "rassen", "rasse" }),
    "Menschen, Hobbits, Elfen und auch alle anderen Rassen sind auf dem "
    "Bild zu sehen.");

  AddDetail( ({ "menschen", "hobbits", "elfen", "trolle", "oger", "zwerge",
  "dunkelelfen", "feen", "untote" }),
    "Sie alle sind auf dem Bild zu sehen.");

  AddDetail( ({ "haende", "schulter", "schultern", "weise" }),
    "Sie scheinen einander sehr freundschaftlich gesinnt zu sein.");

  AddDetail( ({ "rahmen" }),
    "Der Rahmen ist sehr breit und besteht aus Gold.");

  AddDetail( ({ "gold" }),
    "Nach allem, was Du bislang vom Palast gesehen hast, bist Du sicher, "
    "dass es sich um echtes Gold handelt.");

  AddDetail( ({ "waende" }),
    "Die Waende sind aus blauem Marmor gefertigt. Die Wand, an der das "
    "Gemaelde haengt, wird fast voellig von diesem bedeckt.");

  AddDetail( ({ "wand" }),
    "An einer Wand haengt ein riesiges Gemaelde.");

  AddDetail( ({ "teppiche", "teppich" }),
    "Hellblaue, mit goldenen Fransen verzierte Teppiche liegen auf dem "
    "Marmorboden.");

  AddDetail( ({ "fransen" }),
    "Die Teppiche sind an den Raendern mit goldenen Fransen verziert.");

  AddDetail( ({ "raender", "teppichraender", "rand", "teppichrand" }),
    "An ihren Raendern sind die Teppiche mit goldenen Fransen ausgestattet.");

  AddDetail( ({ "boden" }),
    "Hellblaue, weiche Teppiche liegen auf dem ebenfalls blauen "
    "Marmorboden.");

  AddDetail( ({ "marmorboden" }),
    "Der Boden besteht vollstaendig aus blauem Marmor.");

  AddDetail( ({ "marmor" }),
    "Der Marmor hat eine helle, blaue Farbe, die nur von den goldenen "
    "Sprenkeln und Faeden abgewechselt wird, die sich durch ihn hindurch "
    "ziehen.");

  AddDetail( ({ "farbe", "blau" }),
    "Es ist ein sehr schoenes, helles Blau.");

  AddDetail( ({ "sprenkel", "sprenkeln" }),
    "Der blaue Marmor ist goldgesprenkelt.");

  AddDetail( ({ "faeden", "faden", "goldfaeden", "goldfaden" }),
    "Feine duenne Goldfaeden ziehen sich durch den Marmor.");

  AddDetail( ({ "westen" }),
    "Geh doch einfach hin!");

  AddDetail( ({ "osten" }),
    "Dort fuehrt der Gang weiter.");

  AddDetail( ({ "teestube", "stube" }),
    "Im Westen befindet sich eine kleine Teestube.");

  AddDetail( ({ "licht" }),
    "Ein schwaches, leicht flackerndes Licht erfuellt den Raum im Westen. "
    "Ob der Lichtschein von einem Feuer stammt?");

  AddDetail( ({ "lichtschein", "schein", "flackern" }),
    "Das Licht, das aus dem Westen zu sehen ist, scheint leicht zu "
    "flackern.");

  AddDetail( ({ "feuer" }),
    "Vielleicht wird das Flackern von einem Feuer verursacht. Vielleicht "
    "aber auch nicht.");

  AddDetail( ({ "raum" }),
    "Du kannst nicht genau erkennen, was sich in dem Raum befindet. "
    "Doch halt, Dir faellt eine kleine Tafel auf, die ueber dem Eingang "
    "befestigt ist.");

  AddDetail( ({ "tafel" }),
    "Eine kleine, weisse Tafel wurde ueber dem Eingang befestigt. "
    "Du koenntest sie lesen.");

  AddDetail( ({ "eingang" }),
    "Der Eingang befindet sich westlich von hier.");

  AddDetail( ({ "decke" }),
    "Auch die leicht gewoelbte Decke besteht aus blauem Marmor.");

  AddReadDetail ( ({ "tafel" }),
    "Auf der Tafel steht:\n"
    "                      +------------+\n"
    "                      |  Teestube  |\n"
    "                      +------------+\n");

  AddSound( DEFAULT_SOUND,
    "Eine wohltuende Stille umgibt Dich.");

  AddSound( ({ "stille" }),
    "Es ist sehr ruhig hier.");

  AddSmell( DEFAULT_SMELL,
    "Du glaubst, einen sehr schwachen Feuergeruch ausmachen zu koennen.");

  AddSmell( ({ "feuergeruch", "geruch" }),
    "Tatsaechlich, es riecht ein wenig nach Feuer.");

  AddSmell( ({ "feuer" }),
    "Es scheint aus dem Westen zu kommen.");

  AddSmell( ({ "westen" }),
    "Aus dem Westen dringt ein schwacher Geruch nach Feuer hierher.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "osten", "nach Osten#" + "./mg_treppe2" );
  AddExit( "westen", "nach Westen#" + "./mg_teestube" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "bild_gang4", REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}
