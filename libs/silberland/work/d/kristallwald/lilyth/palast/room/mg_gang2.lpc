//=========================================================================
// File: mg_gang2.c
// Project: Palast
//
// Created by Lilyth (2004)
//=========================================================================

#include "../def.h"

inherit "std/room";

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem Palast");
  SetProp(P_INT_LONG,
    "Der breite Gang fuehrt im Westen zurueck zu der Treppe, ueber die Du "
    "in das Obergeschoss gelangen kannst, und muendet im Osten in einem "
    "kleinen Geschaeft, aus dem seltsame Geraeusche dringen. Ein riesiges "
    "Gemaelde haengt hier an der Wand und der Marmorboden ist mit "
    "hellblauen Teppichen ausgelegt.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INFO, "Das Gemaelde an der Wand sieht irgendwie interessant "
  "aus.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "gang", "gaenge" }),
    "Ein langer breiter Gang fuehrt durch das Mittelgeschoss des Palastes.");

  AddDetail( ({ "palast" }),
    "Du befindest Dich immer noch im Palast.");

  AddDetail( ({ "westen" }),
    "Im Westen befindet sich eine Treppe, die in das Obergeschoss fuehrt.");

  AddDetail( ({ "treppe" }),
    "Geh nach Westen, dann siehst Du sie.");

  AddDetail( ({ "mittelgeschoss" }),
    "Das hier ist das Mittelgeschoss des Palastes.");

  AddDetail( ({ "untergeschoss" }),
    "Das Untergeschoss solltest Du bereits gesehen haben. Es befindet sich "
    "unter Dir.");

  AddDetail( ({ "obergeschoss" }),
    "Im Westen kannst Du ueber eine Treppe dorthin gelangen.");

  AddDetail( ({ "geschoss" }),
    "Du befindest Dich hier im Mittelgeschoss.");

  AddDetail( ({ "osten" }),
    "Ein kleines Geschaeft liegt direkt im Osten.");

  AddDetail( ({ "geschaeft" }),
    "Von hier aus kannst Du nicht sehr viel erkennen, das einzige, was Dir "
    "auffaellt, sind die etwas seltsamen Geraeusche, die von dort zu "
    "kommen scheinen.");

  AddDetail( ({ "geraeusche" }),
    "Du koenntest ihnen ja mal lauschen.");

  AddDetail( ({ "gemaelde", "bild" }),
    "Das in einem breiten, vergoldeten Rahmen befindliche Gemaelde bedeckt "
    "fast die gesamte Wand des Ganges. Es zeigt die langen, dunklen "
    "Gassen einer grossen Stadt sowie viele ihrer Bewohner. Doch es ist "
    "kein sehr friedliches Bild, wie Dir nach kurzem Betrachten auffaellt.");

  AddDetail( ({ "gassen", "gasse" }),
    "Lange, dunkle Gassen sind auf dem Gemaelde zu erkennen. Ploetzlich "
    "faellt Dir der grosse Turm auf, der sich im Hintergrund der Stadt "
    "erhebt.");

  AddDetail( ({ "turm" }),
    "Der Turm erhebt sich gross und dunkel ueber der Stadt.");

  AddDetail( ({ "hintergrund" }),
    "Im Hintergrund des Gemaeldes ist ein grosser, dunkler Turm zu "
    "erkennen.");

  AddDetail( ({ "stadt" }),
    "Du glaubst, dass es sich bei dieser Stadt um Avir handelt.");

  AddDetail( ({ "avir", "felsen" }),
    "Die Stadt Avir liegt hoch oben auf einem Felsen inmitten des "
    "Tethyrwaldes.");

  AddDetail( ({ "tethyrwald", "wald" }),
    "Avir liegt, ebenso wie dieser Palast, im Tethyrwald.");

  AddDetail( ({ "bewohner", "gestalten", "menschen" }),
    "Als Du die Gestalten auf dem Bild betrachtest, faellt Dir auf, dass "
    "fast nur alte, weisshaarige Maenner und Frauen sowie Kinder zu "
    "sehen sind. Viele von ihnen weisen Verletzungen auf und sie scheinen "
    "scheinen von Angst und Hoffnungslosigkeit erfuellt zu sein.");

  AddDetail( ({ "verletzungen", "verletzung" }),
    "Viele der Menschen auf dem Bild sind mehr oder weniger schwer "
    "verletzt.");

  AddDetail( ({ "angst", "hoffnungslosigkeit", "leid", "elend" }),
    "Die Menschen auf dem Bild sehen angstvoll und hoffnungslos angesichts "
    "ihres Elends erfuellt.");

  AddDetail( ({ "maenner" }),
    "Zahlreiche alte, krank und ausgezehrt aussehende Maenner sind auf dem "
    "Bild zu sehen.");

  AddDetail( ({ "frauen" }),
    "Zwischen den vielen aelteren Frauen faellt Dir ploetzlich eine "
    "junge, wunderschoene Frau auf. Sie hat lange, goldblonde Haare und "
    "traegt ein weisses Kleid. Sie sieht sehr traurig aus.");

  AddDetail( ({ "frau", "junge frau" }),
    "Eine junge Frau ist auf dem Bild abgebildet. Traurig blickt sie auf "
    "das schreckliche Leid und Elend um sie herum. Du glaubst, sie schon "
    "einmal gesehen zu haben.");

  AddDetail( ({ "heilerin" }),
    "Ja, jetzt faellt es Dir wieder ein. Die junge Frau auf dem Bild ist "
    "die Heilerin aus Avir, die in dem grossen Buch unten im Palast "
    "erwaehnt wird. Auf einmal hast Du das Gefuehl, dass sich der Blick "
    "der Heilerin Dir ploetzlich zuwendet, so als ob sie Dir etwas sagen "
    "wollte.");

  AddDetail( ({ "buch" }),
    "Das Buch, in dem die Geschichte des Palastes aufgeschrieben ist.");

  AddDetail( ({ "geschichte" }),
    "Hast Du sie gelesen?");

  AddDetail( ({ "gefuehl" }),
    "Ob Du Deinem Gefuehl trauen kannst?");

  AddDetail( ({ "blick" }),
    "Du fuehlst den Blick der jungen Frau auf Dir ruhen.");

  AddDetail( ({ "haare", "haar", "ruecken" }),
    "Lange, goldblonde Haare umrahmen ihr schoenes, trauriges Gesicht.");

  AddDetail( ({ "kleid", "gewand" }),
    "Das lange, weisse Gewand ist sehr sorgfaeltig gefertigt worden, und "
    "im Gegensatz zu der Kleidung der anderen Menschen auf dem Bild sieht "
    "es voellig rein und sauber aus.");

  AddDetail( ({ "kleidung", "gegensatz", "sachen" }),
    "Die Menschen sind allesamt sehr einfach gekleidet, und die wenigen "
    "Sachen, die sie tragen, sind schmutzig und haeufig mit Blutflecken "
    "uebersaeht. Das Kleid der Heilerin hingegen scheint unberuehrt von "
    "all dem zu sein.");

  AddDetail( ({ "blutflecken", "blutfleck", "flecken", "fleck" }),
    "Die Kleidung der Menschen ist haeufig mit Blutflecken uebersaeht.");

  AddDetail( ({ "gesicht", "trauer" }),
    "Unbeschreibliche Trauer ist in ihrem Gesicht zu sehen.");

  AddDetail( ({ "kinder", "jungen", "maedchen" }),
    "Kleine Kinder mit erschreckend alt und erwachsen blickenden Augen "
    "sind auf dem Bild zu sehen.");

  AddDetail( ({ "augen" }),
    "Bekuemmert betrachtest Du die kleinen, abgemagerten Jungen und "
    "Maedchen, die bereits unbeschreibliche Schrecknisse erlebt haben "
    "muessen. Es ist keinerlei Freude oder sonst irgendein Gefuehl in "
    "ihren kleinen Gesichtern zu erkennen.");

  AddDetail( ({ "schrecknisse" }),
    "Unweigerlich musst Du an Deine eigene Kindheit denken, die zwar "
    "auch nicht immer rosig gewesen ist, aber doch groesstenteils "
    "froehliche und schoene Erinnerungen aufweist.");

  AddDetail( ({ "kindheit" }),
    "Sie ist schon eine ganze Weile her.");

  AddDetail( ({ "weile" }),
    "Deine Kindheit liegt schon eine Weile zurueck.");

  AddDetail( ({ "erinnerungen", "moment" }),
    "Du versinkst einen Moment lang in Deinen Erinnerungen und laechelst "
    "schmunzelnd in Dich hinein.");

  AddDetail( ({ "freude", "gefuehl", "regung", "gesichter" }),
    "Keinerlei Regung ist in ihren Gesichtern zu sehen.");

  AddDetail( ({ "betrachten" }),
    "Du betrachtest das Bild eingehend.");

  AddDetail( ({ "rahmen" }),
    "Ein goldener Rahmen umgibt das riesige Gemaelde.");

  AddDetail( ({ "wand" }),
    "Eine der Waende wird von einem riesigen Gemaelde verdeckt.");

  AddDetail( ({ "marmorboden", "boden" }),
    "Blaue, mit goldenen Faeden durchzogene Marmorfliesen bilden den "
    "Boden unter Dir. Er ist mit schoenen hellblauen Teppichen ausgelegt.");

  AddDetail( ({ "faeden", "goldfaeden" }),
    "Feine goldene Faeden durchziehen den blauen Marmor.");

  AddDetail( ({ "marmorfliesen", "fliesen" }),
    "Die Fliesen bestehen aus reinstem Marmor.");

  AddDetail( ({ "marmor" }),
    "Blauer, von feinen Goldfaeden durchzogener Marmor.");

  AddDetail( ({ "teppiche", "teppich" }),
    "Hellblaue, weiche Teppiche liegen auf dem Boden. Sie haben goldene "
    "Fransen an den Raendern und sehen wirklich sehr huebsch aus.");

  AddDetail( ({ "fransen", "teppichraender", "raender", "teppichrand",
  "rand" }),
    "Die Teppichraender sind mit goldenen Fransen verziert.");

  AddDetail( ({ "waende" }),
    "Der Marmor an den Waenden ist mit goldenen Faeden durchsetzt. An einer "
    "Wand siehst Du ein riesengrosses Gemaelde haengen.");

  AddDetail( ({ "decke" }),
    "Die leicht nach aussen gewoelbte Decke besteht aus dem gleichen, "
    "golddurchsetzten blauen Marmor wie der Boden und die Waende.");

  AddSound( DEFAULT_SOUND,
    "Leise, etwas seltsame Geraeusche dringen aus dem Osten an Dein Ohr.");

  AddSound( ({ "geraeusche", "geraeusch" }),
    "Du vermagst nicht genau zu sagen, wer oder was diese Geraeusche "
    "verursacht. Sie klingen irgendwie seltsam.");

  AddSound( ({ "osten" }),
    "Die Geraeusche kommen aus dem Osten.");

  AddSound( ({ "ohr" }),
    "Daran kannst Du doch nicht lauschen!");

  AddSmell( DEFAULT_SMELL,
    "Ein undefinierbarer Geruch kommt aus dem Osten.");

  AddSmell( ({ "geruch", "gerueche" }),
    "Du schnupperst ein wenig in der Luft herum und kannst einen "
    "stechenden, jedoch nicht weiter erkennbaren Geruch ausmachen, vermischt "
    "mit einem schwachen pflanzenartigen Duft.");

  AddSmell( ({ "luft" }),
    "Die bisher angenehm frische Luft ist hier mit einem leichten, aber "
    "stechenden Geruch durchsetzt.");

  AddSmell( ({ "duft" }),
    "Er ist kaum wahrnehmbar.");

  AddSmell( ({ "pflanze", "pflanzen" }),
    "Du weisst nicht genau, worum es sich hierbei handeln koennte.");

  AddSmell( ({ "osten", "geschaeft" }),
    "Die Gerueche kommen aus dem kleinen Geschaeft im Osten. Was koennte "
    "das nur sein?");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "osten", "nach Osten#" + "./mg_tiergeschaeft" );
  AddExit( "westen", "nach Westen#" + "./mg_treppe2" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "bild_gang2", REFRESH_DESTRUCT);
  AddItem(NPC "soldat_mg", REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}
