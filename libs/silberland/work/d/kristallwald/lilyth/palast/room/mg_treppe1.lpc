reset()
{
	::reset();
	if(i<5)
	{
	  TO->Message(BS("Ploetzlich flackern die erloschenen Kerzen "
	  +"in einem magischen Licht auf."),
	  MSGFLAG_VISUAL);
	  i = 5;
  }
  //blut = ({});
