#include "../def.h"

inherit "std/room";

//--Variablen&Defines------------------------------------------------------

int i; //Zaehlvariable fuer Kerzen
string strfeuer(string str);
//#define BLUT(wer) (member(blut, capitalize(getuid(wer)))!=-1)
//string *blut;

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------

  i = 5;
//blut = ({});

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem Palast");
  SetProp(P_INT_LONG,
    "Du befindest Dich im Mittelgeschoss des Palastes. Eine breite "
    "geschwungene Treppe fuehrt hier wieder hinunter in das Untergeschoss. "
    "Waehrend unten jedoch groesstenteils alles in Weiss gehalten wurde, "
    "siehst Du hier oben ausschliesslich hellblauen, goldgesprenkelten "
    "Marmor. An einer Wand steht ein kleiner, runder Tisch und im Sueden "
    "fuehrt ein langer Gang weiter durch den Palast.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "mittelgeschoss" }),
    "Du bist im Mittelgeschoss des Palastes angelangt.");

  AddDetail( ({ "palast" }),
    "Du befindest Dich in einem Palast.");

  AddDetail( ({ "untergeschoss" }),
    "Das liegt am unteren Ende der Treppe.");

  AddDetail( ({ "obergeschoss" }),
    "Wenn es hier ein Obergeschoss gibt, liegt es mit ziemlicher "
    "Sicherheit irgendwo ueber Dir.");

  AddDetail( ({ "sicherheit" }),
    "Da kannst Du Dir relativ sicher sein.");

  AddDetail( ({ "ende", "unteres ende" }),
    "Du koenntest einfach nach unten gehen.");

  AddDetail( ({ "geschoss" }),
    "Welches Geschoss meinst Du denn?");

  AddDetail( ({ "treppe" }),
    "Eine breite, geschwungene Treppe fuehrt hier nach unten. Ihre Stufen "
    "bestehen aus schimmerndem Kristall.");

  AddDetail( ({ "stufen", "treppenstufen", "stufe", "treppenstufe" }),
    "Die einzelnen Stufen der Treppe bestehen aus Kristall, und in "
    "jede von ihnen scheint etwas eingraviert worden zu sein, denn Du "
    "kannst hauchduenne Linien auf ihnen erkennen.");

  AddDetail( ({ "linien", "linie" }),
    "Von hier oben aus kannst Du leider nicht genau erkennen, was sie "
    "darstellen sollen.");

  AddDetail( ({ "kristall" }),
    "Die Treppe besteht komplett aus schimmerndem Kristall.");

  AddDetail( ({ "weiss" }),
    "Im Untergeschoss herrschte eindeutig die Farbe Weiss vor, waehrend "
    "hier oben alles in einem hellen, sehr warmen Blau erstrahlt.");

  AddDetail( ({ "farbe" }),
    "Welche Farbe meinst Du denn?");

  AddDetail( ({ "blau" }),
    "Das helle Blau des Marmors wirkt warm und freundlich.");

  AddDetail( ({ "marmor" }),
    "Der Marmor, den Du hier ueberall an den Waenden und auf dem Boden "
    "siehst, hat eine helle, blaeuliche Faerbung mit winzigen goldenen "
    "Sprenkeln darin.");

  AddDetail( ({ "faerbung" }),
    "Der Marmor hat eine schoene, hellblaue Faerbung. Durch die goldenen "
    "Sprenkel wirkt er jedoch keinesfalls kalt und abweisend, sondern "
    "verleiht Deiner Umgebung ganz im Gegenteil eine sehr angenehme und "
    "warme Atmosphaere.");

  AddDetail( ({ "sprenkel" }),
    "Kleine goldene Sprenkel zieren den blauen Marmor.");

  AddDetail( ({ "umgebung" }),
    "Nun, dort, wo Du Dich jetzt gerade befindest.");

  AddDetail( ({ "gegenteil" }),
    "Blau ist eigentlich eine eher kuehle Farbe, doch durch die goldenen "
    "Sprenkel wirkt es warm und freundlich.");

  AddDetail( ({ "atmosphaere" }),
    "Waehrend im Untergeschoss alles herrlich verziert und prachtvoll "
    "ausgeschmueckt war, herrscht hier oben eine sehr warme und "
    "freundliche Atmosphaere.");

  AddDetail( ({ "wand" }),
    "An einer der Waende steht ein kleiner runder Tisch.");

  AddDetail( ({ "tisch" }),
    "Auf dem Tisch liegt ein kleines gesticktes Deckchen, auf dem ein "
    "grosser weisser Kerzenleuchter sowie eine kleine seltsame Figur "
    "stehen.");

  AddDetail( ({ "deckchen", "tischdeckchen", "tischdecke" }),
    "Das Tischdeckchen ist mit huebschen Stickereien verziert.");

  AddDetail( ({ "stickereien", "stickerei" }),
    "Feine bunte Stickereien zieren das kleine Deckchen.");

  AddDetail( ({ "kerzenleuchter", "leuchter" }),
    "Der Kerzenleuchter besteht aus weissem Elfenbein. Es stecken "
    "fuenf Kerzen in ihm.");

  AddDetail( ({ "elfenbein" }),
    "Der Kerzenleuchter wurde aus Elfenbein geschnitzt. Er weist fuenf "
    "rundliche Vertiefungen auf.");

  AddDetail( ({ "vertiefungen", "vertiefung" }),
    "In jeder der Vertiefungen steckt eine Kerze.");

  AddDetail( ({ "figur" }),
    "Die Figur stellt einen schmalen, verzierten Stab aus blaugefaerbtem "
    "Glas dar, um den zwei verschlungene Schlangen zu sehen sind.");

  AddDetail( ({ "stab" }),
    "Der Stab besteht aus blaugefaerbtem Glas, nur seine kugelfoermige "
    "Spitze schimmert in vielen verschiedenen Farben. Um ihn herum siehst Du "
    "zwei Schlangen, die sich um den Stab geschlungen haben.");

  AddDetail( ({ "glas" }),
    "Das Glas wurde blau eingefaerbt. Es ist vollkommen makellos, Du "
    "siehst keine Kratzer oder Abschuerfungen in seiner Oberflaeche.");

  AddDetail( ({ "kratzer" }),
    "Das Glas ist nicht zerkratzt.");

  AddDetail( ({ "abschuerfungen" }),
    "Es sind keine zu sehen.");

  AddDetail( ({ "abschuerfung" }),
    "Es ist keine zu sehen.");

  AddDetail( ({ "oberflaeche" }),
    "Die Oberflaeche des Glases ist absolut makellos.");

  AddDetail( ({ "spitze" }),
    "Eigentlich ist es gar keine Spitze, sondern eine kugelfoermige "
    "Ausbuchtung.");

  AddDetail( ({ "ausbuchtung" }),
    "Die Spitze des Stabes ist kugelfoermig.");

  AddDetail( ({ "farben" }),
    "Die Spitze des Stabes leuchtet und schimmert in allen moeglichen "
    "Farben.");

  AddDetail( ({ "schlangen", "schlange" }),
    "Zwei miteinander verschlungene Schlangen winden sich um den Stab. "
    "Ihre Augen bestehen aus winzigen rotgluehenden Edelsteinen und ihre "
    "Koerper sind aus einem schimmernden gruenlichen Material gefertigt.");

  AddDetail( ({ "augen", "schlangenaugen", "auge", "schlangenauge" }),
    "Die Augen der Schlangen funkeln roetlich.");

  AddDetail( ({ "edelsteine", "rubine", "edelstein", "rubin" }),
    "Winzige Rubine stellen die Augen der Schlangen dar. Ein sonderbares "
    "Gluehen geht von ihnen aus.");

  AddDetail( ({ "gluehen" }),
    "Die Schlangenaugen gluehen roetlich.");

  AddDetail( ({ "koerper" }),
    "Ihre Koerper schimmern gruenlich, doch Du kannst das Material nicht "
    "naeher bestimmen, aus dem sie bestehen. Irgendwie verspuerst Du "
    "ploetzlich das Verlangen, die Schlangen anzufassen und sie zu "
    "beruehren.");

  AddDetail( ({ "material" }),
    "Du kannst nicht erkennen, um was fuer ein Material es sich handelt.");

  AddDetail( ({ "verlangen" }),
    "Du kannst es Dir selbst nicht erklaeren.");

  AddDetail( ({ "sueden", "gang" }),
    "Ein langer Gang fuehrt nach Sueden weiter.");

  AddDetail( ({ "boden", "marmorboden" }),
    "Der gesamte Boden ist mit hellen Marmorfliesen in verschiedenen "
    "Blautoenen ausgelegt.");

  AddDetail( ({ "marmorfliesen", "fliesen" }),
    "Hellblaue, goldgesprenkelte Marmorfliesen bilden den Boden unter "
    "Deinen Fuessen.");

  AddDetail( ({ "fuesse", "fuss" }),
    "Deine Fuesse stehen fest auf dem blauen Marmorboden.");

  AddDetail( ({ "blautoene", "toene", "blauton", "ton" }),
    "Der Marmor hat keine ganz einheitliche blaue Faerbung, sondern setzt "
    "sich aus mehreren, jedoch ueberwiegend hellen Blautoenen zusammen.");

  AddDetail( ({ "waende" }),
    "Die Waende bestehen aus hellblauem, goldgesprenkelten Marmor. Sie "
    "sind sehr schlicht gehalten und weisen keinerlei Verzierungen auf. "
    "An einer Waende steht ein kleiner runder Tisch.");

  AddDetail( ({ "verzierungen", "verzierung" }),
    "Die Waende weisen keinerlei Verzierungen auf.");

  AddDetail( ({ "decke" }),
    "Die blaue Marmordecke ist stark nach aussen gewoelbt und mit "
    "huebschen Mustern bemalt.");

  AddDetail( ({ "marmordecke" }),
    "Die Decke besteht ebenfalls aus hellblauem Marmor.");

  AddDetail( ({ "muster" }),
    "Duenne linienfoermige Muster verlaufen sternfoermig auf die Woelbung "
    "in der Mitte der Decke zu.");

  AddDetail( ({ "mitte", "woelbung" }),
    "In der Mitte ist die Decke stark gewoelbt.");

  AddSound( DEFAULT_SOUND,
    "Hier oben ist es sehr ruhig und still.");

  AddSound( ({ "ruhe", "stille" }),
    "Du hoerst absolut gar nichts.");

  AddSmell( DEFAULT_SMELL,
    "Die Kerzen auf dem Tisch verstroemen einen leichten Duft nach "
    "Kerzenwachs und Feuer.");

  AddSmell( ({ "wachs", "kerzenwachs" }),
    "Der Kerzenwachs duftet ein wenig.");

  AddSmell( ({ "duft" }),
    "Der Kerzenwachs verstroemt einen angenehmen Duft.");

  AddSmell("feuer", #'strfeuer);

  AddSmell( ({ "kerzen", "kerze" }),
    "Die Kerzen riechen ein wenig nach Wachs und Feuer.");

  AddSpecialDetail( ({ "kerzen", "kerze", "licht" }),
    "strkerzen");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "unten", "die Treppe hinunter#" + "./ug_treppe" );
  AddExit( "sueden", "nach Sueden#" + "./mg_gang1" );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "pust", "puste", "loesch", "loesche" }), "kerze_loeschen" );
  AddCmd( ({ "zuend", "zuende" }), "kerze_anzuenden" );
  AddCmd( ({ "beruehr", "beruehre", "fass", "fasse" }), "schlange_beruehren" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer SpecialDetails-------------------------------------------

string strkerzen(string str)
{
  string s;

  if(i == 5)
  {
        s = "Alle fuenf Kerzen brennen und spenden helles Licht.";
  }

  if(i == 4)
  {
  	s = "Vier der fuenf Kerzen brennen hell und spenden Dir Licht. "
  	    +"Eine von ihnen ist erloschen.";
  }

  if(i == 3)
  {
  	s = "Drei der fuenf Kerzen brennen hell und spenden Dir Licht. "
  	    +"Zwei von ihnen sind erloschen.";
  }

  if(i == 2)
  {
  	s = "Nur zwei der fuenf Kerzen brennen, die anderen drei sind "
  	    +"erloschen.";
  }

  if(i == 1)
  {
  	s = "Nur eine einzige Kerze brennt, die anderen sind alle "
  	    +"erloschen.";
  }

  if(i == 0)
  {
        s = "Alle fuenf Kerzen sind erloschen.";
  }

  return BS(s);
}

string strfeuer(string str)
{
  string s;

  if(i > 0)
  {
        s = "Du kannst das Feuer der brennenden Kerzen riechen.";
  }
  else
  {
        s = "Die erloschenen Kerzen riechen noch schwach nach Feuer.";
  }

  return BS(s);
}

//--Funktionen fuer Kommandos----------------------------------------------

//Kerze loeschen:
int kerze_loeschen(string str)
{
  notify_fail("Was moechtest Du auspusten?\n");

  if(!str || str == "") return 0;

  if(!(str == "kerze aus" ||
       str == "kerzen aus" ||
       str == "kerze" ||
       str == "kerzen" )) return 0;

  if(i > 0)
  {
        write(BS("Du pustest vorsichtig eine der Kerzen aus."));

        TO->Message(BS(TP->Name(WER, 1)+" pustet eine der Kerzen aus."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        i--;

        if(i == 0)
        {
            SetProp(P_LIGHT, 0);
        }

        return 1;
  }
  else
  {
        write(BS("Aber es brennt doch gar keine Kerze mehr!"));
        return -1;
  }
}

//Kerze anzuenden:
int kerze_anzuenden(string str)
{
  notify_fail("Was moechtest Du anzuenden?\n");

  if(!str || str == "") return 0;

  if(!(str == "kerze an" ||
       str == "kerzen an" )) return 0;

  if(i < 5)
  {
        write(BS("Du zuendest eine der Kerzen an."));

        TO->Message(BS(TP->Name(WER, 1)+" zuendet eine der Kerzen an."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        i++;

        if(i == 1)
        {
            SetProp(P_LIGHT, 1);
        }

        return 1;
  }
  else
  {
        write(BS("Aber es brennen doch schon alle fuenf Kerzen!"));
        return -1;
  }
}

