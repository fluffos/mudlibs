#include "../def.h"
#include <laden.h>

inherit "std/laden";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------

  RemoveFixedObject("/obj/boerse");
  RemoveFixedObject("/obj/stempel");
  RemoveItem("/obj/entsorg");

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Eine geraeumige Schmiede");
  SetProp(P_INT_LONG,
    "Erstaunt betrachtest Du die geraeumige Schmiede, die Du gerade betreten "
    "hast. In der Mitte des Raumes befindet sich eine kleine offene "
    "Feuerstelle, in der ein loderndes Feuer prasselt. Neben dem Feuer "
    "siehst Du einen grossen Blasebalg und einen Amboss stehen. An der "
    "oestlichen Wand befindet sich ein grosser rechteckiger Tisch, auf dem "
    "verschiedene Schmiedewerkzeuge ordentlich nebeneinander aufgereiht "
    "liegen.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_SHOPKEEPER_ID, "tungdil");
  SetProp(P_SHOPKEEPER_NAME, "Tungdil");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetStorageRoom(ROOM "ug_lagerraum_schmiede" );

//--Details----------------------------------------------------------------

  AddDetail( ({ "schmiede" }),
    "Gleich auf den ersten Blick hast Du erkannt, dass es sich bei diesem "
    "Raum um eine Schmiede handelt.");

  AddDetail( ({ "blick" }),
    "Der zweite Blick bestaetigt nur, was Dir bereits nach dem ersten Blick "
    "klar war: Dies ist eine Schmiede.");

  AddDetail( ({ "mitte" }),
    "Mitten im Raum siehst Du eine kleine Feuerstelle mit einem prasselnden "
    "Feuer darin.");

  AddDetail( ({ "raum" }),
    "Du befindest Dich in einer Schmiede.");

  AddDetail( ({ "feuerstelle" }),
    "Eine heisse Glut geht von der Feuerstelle und dem darin prasselnden "
    "offenen Feuer aus.");

  AddDetail( ({ "glut" }),
    "Du kannst die helle, fast weisse Glut in der Feuerstelle sehen und "
    "ihre Hitze spueren.");

  AddDetail( ({ "feuer" }),
    "Das Feuer prasselt unaufhoerlich vor sich hin und verbreitet eine "
    "starke Hitze in der Schmiede.");

  AddDetail( ({ "hitze" }),
    "Es ist sehr warm hier. Du schwitzt ein wenig.");

  AddDetail( ({ "blasebalg" }),
    "Mit dem Blasebalg wird das Feuer belueftet. Eine halblange hoelzerne "
    "Stange ist an ihm befestigt, so dass man die Luft aus ihm herauspressen "
    "kann.");

  AddDetail( ({ "stange" }),
    "Wenn man die Stange herunterdrueckt, wird die gesamte Luft, die sich "
    "in dem dicken Ledersack befindet, durch ein schmales Roehrchen "
    "hinausgepresst.");

  AddDetail( ({ "ledersack", "sack" }),
    "Der Blasebalg besteht im grundegenommen aus einem dicken ledernen "
    "Sack, der mit Luft gefuellt ist.");

  AddDetail( ({ "roehrchen" }),
    "Das Roehrchen ist auf das Feuer gerichtet.");

  AddDetail( ({ "amboss" }),
    "Ein grosser und sehr schwer aussehender Amboss steht neben der "
    "Feuerstelle. Erst jetzt bemerkst Du den breiten Wassertrog, der "
    "hinter dem Amboss steht.");

  AddDetail( ({ "wassertrog", "trog" }),
    "Ein mit kaltem Wasser gefuellter Trog aus Stein steht hinter dem "
    "Amboss. Hier wird das gluehende Metall, nachdem es in der Feuerstelle "
    "erhitzt wurde, im Wasserbad abgekuehlt.");

  AddDetail( ({ "stein" }),
    "Der Wassertrog besteht aus Stein.");

  AddDetail( ({ "wasserbad" }),
    "Um das gluehend heisse Metall abzukuehlen, wenn es aus dem Feuer "
    "geholt wird, taucht man es in den Wassertrog hinein.");

  AddDetail( ({ "wand" }),
    "An der oestlichen Wand steht ein grosser Tisch, auf dem die "
    "verschiedensten Schmiedewerkzeuge liegen.");

  AddDetail( ({ "tisch" }),
    "Der Tisch ist rechteckig und besteht aus dunklem Holz. Zahlreiche "
    "Werkzeuge liegen ordentlich nebeneinander aufgereiht auf der "
    "Tischplatte.");

  AddDetail( ({ "holz" }),
    "Du weisst nicht, um welche Holzart es sich hierbei handelt.");

  AddDetail( ({ "holzart" }),
    "So gut kennst Du Dich da leider nicht aus.");

  AddDetail( ({ "tischplatte" }),
    "Die Tischplatte ist mit vielen Kratzern und Rillen uebersaeht. "
    "Anscheinend benutzt Tungdil den Tisch haeufig fuer kleinere "
    "Schmiedearbeiten.");

  AddDetail( ({ "kratzer" }),
    "Die gesamte Tischplatte ist mit Kratzern uebersaeht.");

  AddDetail( ({ "rillen", "rille" }),
    "Tiefe Rillen ziehen sich ueber die Tischplatte.");

  AddDetail( ({ "tungdil", "schmied" }),
    "Anscheinend ist er gerade nicht da.");

  AddDetail( ({ "schmiedearbeiten", "schmiedearbeit" }),
    "An dem Tisch fertigt Tungdil haeufig kleinere Schmiedearbeiten an.");

  AddDetail( ({ "waffen", "waffe" }),
    "Welche Waffen Tungdil gerade anbietet, kannst Du Dir mit 'zeige waffen' "
    "anschauen.");

  AddDetail( ({ "ruestungen", "ruestung" }),
    "Welche Ruestungen Tungdil gerade anbietet, kannst Du Dir mit 'zeige "
    "ruestungen' anschauen.");

  AddDetail( ({ "kunden" }),
    "Auch Du bist ein potentieller Kunde.");

  AddDetail( ({ "kunde" }),
    "Moechtest Du etwas kaufen?");

  AddDetail( ({ "schmiedewerkzeuge", "werkzeuge", "schmiedewerkzeug", "werkzeug" }),
    "Du siehst Zangen, Haemmer, Feilen, Meissel, Eisensaegen und andere "
    "Werkzeuge auf dem Tisch liegen. Sie sehen allesamt sehr sauber und "
    "gepflegt aus. Anscheinend werden sie regelmaessig mit Wasser gereinigt "
    "und anschliessend eingeoelt.");

  AddDetail( ({ "zangen", "zange" }),
    "Damit man sich an dem gluehenden Metall nicht die Finger verbrennt, "
    "benutzt der Schmied eine der Zangen, um es festzuhalten.");

  AddDetail( ({ "finger", "haende", "hand" }),
    "Das heisse Metall mit den blossen Haenden anzufassen, wuerde ziemlich "
    "wehtun.");

  AddDetail( ({ "haemmer", "meissel", "hammer" }),
    "Mit Hammer und Meissel wird das heisse Metall in seine endgueltige Form "
    "gebracht.");

  AddDetail( ({ "form", "formgebung", "metall" }),
    "Das Metall muss zunaechst erhitzt werden, damit es anschliessend in "
    "seine gewuenschte Form gebracht werden kann.");

  AddDetail( ({ "feilen", "feile" }),
    "Die Feilen werden, nachdem das Metall in die gewuenschte Form gebracht "
    "wurde, fuer die anschliessende Feinarbeit genutzt.");

  AddDetail( ({ "feinarbeit" }),
    "Alle kleineren Unebenheiten, die nach der Formgebung noch vorhanden "
    "sind, koennen mit den Feilen leicht beseitigt werden.");

  AddDetail( ({ "unebenheiten", "unebenheit" }),
    "Nachdem das Metall in die richtige Form gebracht wurde, sind meistens "
    "noch kleinere Unebenheiten vorhanden, die entfernt werden muessen.");

  AddDetail( ({ "eisensaegen", "eisensaege" }),
    "Mit den Eisensaegen werden ueberstehende Metallstuecke einfach "
    "abgesaegt.");

  AddDetail( ({ "metallstuecke", "metallstueck" }),
    "Ueberstehende Metallstuecke kann man einfach mit einer Eisensaege "
    "absaegen.");

  AddDetail( ({ "wasser" }),
    "Um die Werkzeuge richtig sauber zu halten, werden sie zunaechst mit "
    "Wasser vom groebsten Schmutz befreit, sorgfaeltig eingeoelt und "
    "schliesslich im Freien getrocknet.");

  AddDetail( ({ "schmutz" }),
    "Die Werkzeuge, die auf dem Tisch liegen, sehen aeusserst sauber und "
    "gepflegt aus.");

  AddDetail( ({ "freien" }),
    "Nach dem Einoelen werden die Werkzeuge draussen im Freien getrocknet.");

  AddDetail( ({ "einoelen" }),
    "Mit Oel kann man die Werkzeuge am besten reinigen.");

  AddDetail( ({ "oel" }),
    "Ganz normales Oel.");

  AddDetail( ({ "boden" }),
    "Der harte Steinboden ist mit Sand ausgestreut.");

  AddDetail( ({ "sand" }),
    "Auf dem Steinboden wurde eine dicke Sandschicht ausgestreut.");

  AddDetail( ({ "sandschicht" }),
    "Der gesamte Boden ist mit einer dicken Sandschicht bedeckt.");

  AddDetail( ({ "steinboden" }),
    "Du wunderst Dich ein wenig, dass hier, anders als im Rest des Palastes, "
    "nur ein einfacher Steinboden ist. Doch schliesslich kommst Du zu dem "
    "Schluss, dass der wertvolle Marmor eigentlich auch viel zu schade fuer "
    "eine Schmiede waere.");

  AddDetail( ({ "rest" }),
    "Ausserhalb der Schmiede hast Du im Palast fast ueberall nur Marmorboden "
    "gesehen.");

  AddDetail( ({ "palast" }),
    "Auch die Schmiede gehoert zum Palast.");

  AddDetail( ({ "schluss" }),
    "Auch Du findest, dass der teure Marmor hier viel zu schade waere.");

  AddDetail( ({ "marmor", "marmorboden" }),
    "Der Marmor, der fast ueberall im Palast verlegt wurde, muss sehr "
    "teuer gewesen sein.");

  AddDetail( ({ "decke" }),
    "In der Decke befindet sich ein grosser Rauchabzug.");

  AddDetail( ({ "rauchabzug" }),
    "Der Rauchabzug in der Decke sorgt dafuer, dass die Luft hier drinnen "
    "nicht allzu stickig wird und der Rauch vom Feuer abziehen kann.");

  AddDetail( ({ "luft" }),
    "Trotz des lodernden Feuers ist die Luft hier drinnen keineswegs "
    "stickig.");

  AddDetail( ({ "rauch" }),
    "Wo ein Feuer ist, entsteht auch viel Rauch.");

  AddDetail( ({ "waende" }),
    "Die Waende sind mit einer duennen Schicht Russ bedeckt.");

  AddDetail( ({ "schicht", "russschicht" }),
    "Die Schicht ist nur sehr duenn.");

  AddDetail( ({ "russ" }),
    "Eine schwarze Russschicht bedeckt die Waende.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Prasseln des Feuers.");

  AddSound( ({ "prasseln" }),
    "Das Feuer prasselt leise vor sich hin.");

  AddSound( ({ "feuer" }),
    "Das Feuer in der Feuerstelle knistert und prasselt leise vor sich hin.");

  AddSound( ({ "feuerstelle" }),
    "In der Feuerstelle brennt ein kleines Feuer.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig nach Rauch.");

  AddSmell( ({ "rauch" }),
    "Der Rauch kommt wohl von dem Feuer, das in der Feuerstelle brennt.");

  AddSmell( ({ "feuer" }),
    "Du faengst an zu husten, als Du den Rauch einatmest.");

  AddSmell( ({ "feuerstelle", "luft" }),
    "Du riechst den Rauch, der von dem Feuer herruehrt.");

  AddRoomMessage(
    ({"Das Feuer prasselt leise vor sich hin.\n"}),70,"func");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "suedwesten", "nach Suedwesten#" + "./ug_mitte" );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "drueck", "druecke" }), "blasebalg" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "schmied", REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//Blasebalg druecken
int blasebalg(string str)
{
  notify_fail("Was willst Du druecken?\n");

  if(!str || str == "") return 0;

  if(!(str == "blasebalg" ||
       str == "stange" ||
       str == "stange herunter" ||
       str == "stange runter" )) return 0;

  write(BS("Mit aller Kraft drueckst Du den Hebel hinunter. Ein "
  +"starker Luftzug stroemt aus dem Blasebalg und laesst das Feuer "
  +"gefaehrlich aufflackern."));

  TO->Message(BS(TP->Name(WER, 1)+" betaetigt den Blasebalg. Das Feuer in "
  +"der Feuerstelle lodert gefaehrlich auf und Du weichst erschrocken ein "
  +"paar Schritte zurueck."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;
}

//Schmied kauft nur Metallkrams an
varargs int do_sell(object ob, int force, string prefix, int limit)
{
  if( ob->QueryMaterialGroup(MATGROUP_METAL)>10 )
  {
    return ::do_sell(ob, force);
  }
  else
  {
    write(BS("Tungdil brummt: Ich kaufe nur Sachen aus Metall!"));
    return 1;
  }
}
