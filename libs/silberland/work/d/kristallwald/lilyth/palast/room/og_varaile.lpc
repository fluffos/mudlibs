#include "../def.h"
#include <laden.h>

inherit "std/laden";

//--Variablen&Defines------------------------------------------------------


//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------

  RemoveFixedObject("/obj/boerse");
  RemoveFixedObject("/obj/stempel");
  RemoveItem("/obj/entsorg");

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem wunderlichen Laden");
//SetProp(P_INT_LONG, --> siehe unten

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_SHOPKEEPER_ID, "varaile");
  SetProp(P_SHOPKEEPER_NAME, "Varaile");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetStorageRoom(ROOM "og_lagerraum_varaile" );

//--Details----------------------------------------------------------------

  AddDetail( ({ "laden", "raum" }),
    "Du befindest Dich im Laden von Varaile.");

  AddDetail( ({ "tischchen", "tisch" }),
    "Ein kleiner, runder Tisch steht neben Dir. Auf ihm ruht auf einem "
    "weichen Kissen eine seltsame, leuchtende Kugel.");

  AddDetail( ({ "kissen" }),
    "Das Kissen besteht aus rotem Samt.");

  AddDetail( ({ "samt" }),
    "Er schimmert roetlich im Licht der Kugel.");

  AddDetail( ({ "kugel" }),
    "Die Kugel wirkt fast durchsichtig, dennoch gibt sie ein seltsames, "
    "fast unwirkliches Licht ab. Es wird mal heller und mal etwas "
    "schwaecher und scheint ab und zu seine Farbe zu aendern. Es verleiht "
    "dem Raum eine irgendwie wundersame Atmosphaere.");

  AddDetail( ({ "farbe" }),
    "Die Kugel wechselt ihre Farbe ab und zu. Mal sieht sie roetlich aus, "
    "mal eher blaeulich, und manchmal gibt sie auch ein gruenliches "
    "Licht ab. Dann wieder veraendert sich ihre Farbe in ein leuchtendes "
    "Gelb. Sie scheint nach und nach alle Facetten des Regenbogens "
    "anzunehmen.");

  AddDetail( ({ "gelb" }),
    "Jetzt gerade sieht sie eher violett aus.");

  AddDetail( ({ "facetten", "facette", "farben" }),
    "Alle Farben des Regenbogens sind vertreten.");

  AddDetail( ({ "regenbogen" }),
    "Der Regenbogen vereint alle moeglichen Farben in sich.");

  AddDetail( ({ "atmosphaere" }),
    "Du hast fast das Gefuehl, in einer Art Traum gefangen zu sein.");

  AddDetail( ({ "gefuehl" }),
    "Du fuehlst Dich wohl und sicher vor allen Gefahren dieser Welt.");

  AddDetail( ({ "art" }),
    "Es erscheint Dir fast wie eine Art Traum.");

  AddDetail( ({ "traum" }),
    "Du traeumst ein wenig vor Dich hin.");

  AddDetail( ({ "gefahr", "gefahren" }),
    "In der Welt dort draussen lauern viele Gefahren. Doch hier scheinst "
    "Du vor ihnen sicher zu sein.");

  AddDetail( ({ "welt" }),
    "Sie ist gross und weit und Du hast schon einiges von ihr gesehen.");

  AddDetail( ({ "licht" }),
    "Ein fast unwirkliches Licht erfuellt den ganzen Raum.");

  AddDetail( ({ "vitrinen", "vitrine" }),
    "Glaeserne Vitrinen stehen um Dich herum. In ihnen liegen die "
    "Waren aus, die Varaile hier verkauft.");

  AddDetail( ({ "glas" }),
    "Die Vitrinen bestehen aus durchsichtigem Glas.");

  AddDetail( ({ "dinge", "waren" }),
    "All die schoenen Sachen, die Varaile hier verkauft, sind in den "
    "Vitrinen ausgestellt worden. ");

  AddDetail( ({ "waende" }),
    "Die Waende sind mit bunten Seidentuechern geschmueckt worden. An "
    "einer Wand haengt zudem eine kleine Tafel.");

  AddDetail( ({ "wand" }),
    "An einer der Waende siehst Du eine kleine, blaue Tafel, auf der "
    "etwas geschrieben steht.");

  AddDetail( ({ "tafel" }),
    "Du kannst es lesen.");

  AddDetail( ({ "tuecher", "seidentuecher" }),
    "Bunte Tuecher verhuellen die Waende und die weisse Holzdecke. Sie "
    "scheinen aus reiner Seide zu bestehen.");

  AddDetail( ({ "seide" }),
    "Die Seide schimmert ein wenig im Licht.");

  AddDetail( ({ "aussehen" }),
  ([ 0: "Die bunten Tuecher an den Waenden verleihen dem Laden ein "
       +"heimeliges Aussehen. Du fuehlst Dich sehr wohl hier.",
    "dunkelelf": "Die bunten Tuecher an den Waenden verleihen dem Laden ein "
       +"heimeliges Aussehen. Du fuehlst Dich sehr wohl hier. Nicht einmal "
       +"das gedaempfte Licht kann Dich stoeren." ]) );

  AddDetail( ({ "elfe", "varaile" }),
    "Sie scheint gerade nicht da zu sein.");

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus weissen Holzlatten.");

  AddDetail( ({ "holzlatten", "latten", "latte", "holzlatte" }),
    "Sie wurden ordnungsgemaess auf dem gesamten Boden verlegt.");

  AddDetail( ({ "decke" }),
    "Als Du an die Decke schaust, siehst Du, dass sie ebenfalls mit "
    "bunten Tuechern bedeckt wurde. Anscheinend war Varaile die weisse "
    "Holzdecke einfach zu langweilig.");

  AddDetail( ({ "holzdecke" }),
    "Die Decke besteht aus weissem Holz, welches Du nur erahnen kannst, "
    "da es vollstaendig von den bunten Tuechern verdeckt wird.");

  AddDetail( ({ "holz" }),
    "Fast alles hier oben besteht aus weissem Holz.");

  AddDetail( ({ "kunden", "kunde" }),
    "Du bist einer.");

  AddDetail( ({ "sachen" }),
    "In den Vitrinen sind bunte Kerzen und Windlichter, ein huebsch "
    "verzierter Beutel, eine kleine Schneekugel, bunte Luftballons, Rollen "
    "mit Luftschlangen, ein kleiner, gruener Plueschdrache und eine "
    "wunderschoene Spieluhr ausgestellt.");

  AddSpecialDetail( ({ "theke" }),
    "strtheke");

  AddSpecialDetail( ({ "wuensche", "wunsch" }),
    "strwuensche");

  AddSpecialDetail( ({ "kerzen", "kerze" }),
    "strkerze");

  AddSpecialDetail( ({ "beutel" }),
    "strbeutel");

  AddSpecialDetail( ({ "spieluhr", "spieluhren" }),
    "strspieluhr");

  AddSpecialDetail( ({ "drache", "drachen", "plueschdrache" }),
    "strdrache");

  AddSpecialDetail( ({ "luftballons", "luftballon" }),
    "strluftballon");

  AddSpecialDetail( ({ "windlicht", "windlichter" }),
    "strwindlicht");

  AddSpecialDetail( ({ "taschentuecher", "taschentuch" }),
    "strtaschentuch");

  AddSpecialDetail( ({ "schneekugel" }),
    "strschneekugel");

  AddSpecialDetail( ({ "luftschlangen", "luftschlange", "rollen", "rolle" }),
    "strluftschlange");

  AddReadDetail( ({ "tafel" }),
    "  o=====================================o\n"
    "   *        Herzlich Willkommen        *\n"
    "   *        in Varaile's Laden!        *\n"
    "   *                                   *\n"
    "   *    Varaile's aktuelles Angebot    *\n"
    "   *    kannst Du Dir ansehen mit:     *\n"
    "   *                                   *\n"
    "   *              'zeige'              *\n"
    "   *                                   *\n"
    "   *    Etwas kaufen kannst Du mit:    *\n"
    "   *                                   *\n"
    "   *           'kaufe <gegenstand>'    *\n"
    "   *    oder   'kaufe <nr>'            *\n"
    "   *                                   *\n"
    "   *     Viel Spass beim Stoebern!     *\n"
    "  o=====================================o\n");

  AddSound( DEFAULT_SOUND,
    "Du kannst leise Musik hoeren.");

  AddSound( ({ "musik" }),
    "Eine leise, sehr ruhige Musik klingt durch den Raum.");

  AddSound( ({ "raum" }),
    "Der Raum wird von den leisen Klaengen einer geheimnisvollen Musik "
    "erfuellt.");

  AddSound( ({ "klang", "klaenge" }),
    "Sie wirken irgendwie beruhigend.");

  AddSmell( DEFAULT_SMELL,
    "Ein schwacher Duft erfuellt den Raum.");

  AddSmell( ({ "duft" }),
    "Du kannst nicht genau sagen, was das fuer ein Duft ist.");

  AddSmell( ({ "raum" }),
    "Es riecht irgendwie angenehm hier.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", "nach Norden#" + "./og_treppe" );

//--Kommandos--------------------------------------------------------------



//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "varaile", REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer SpecialDetails-----------------------------------------

string strtheke(string str)
{
  string s;

  if(present(QueryProp(P_SHOPKEEPER_ID)))
  {
  	s = "Direkt vor Dir befindet sich eine hohe Theke. Hinter ihr steht "
  	+"eine junge, huebsche Elfe. Laechelnd blickt sie Dich an und "
  	+"wartet auf Deine Wuensche.";
  }
  else
  {
        s = "Direkt vor Dir befindet sich eine hohe Theke. Eigentlich "
        +"sollte man annehmen, dass jemand dahinter stuende, um die Kunden "
        +"zu bedienen, doch Du kannst niemanden sehen. Wenn Du etwas "
        +"kaufen moechtest, wirst Du wohl warten muessen.";
  }

  return BS(s);
}

string strwuensche(string str)
{
  string s;

  if(present(QueryProp(P_SHOPKEEPER_ID)))
  {
  	s = "Wenn Du einen Wunsch hast, wird Varaile sicherlich alles "
  	+"tun, um ihn zu erfuellen.";
  }
  else
  {
        s = "Sowas siehst Du da nicht!";
  }

  return BS(s);
}

string strkerze(string str)
{
  string s;
  object ob;
  ob = find_object(ROOM "og_lagerraum_varaile");

  if(present("kerze", ob))
  {
  	s = "Ein paar bunte Kerzen liegen in den Vitrinen.";
  }
  else
  {
  	s = "Huch, anscheinend sind die Kerzen gerade alle ausverkauft.";
  }
  return BS(s);
}

string strbeutel(string str)
{
  string s;
  object ob;
  ob = find_object(ROOM "og_lagerraum_varaile");

  if(present("tabakbeutel", ob))
  {
  	s = "Ein kleiner, verzierter Beutel ist in einer der Vitrinen "
  	+"zu sehen. Wofuer der wohl gut ist?";
  }
  else
  {
  	s = "Schade, anscheinend ist der huebsche Beutel schon an jemand "
  	+"anders verkauft worden, denn es haengt ein kleines Schildchen "
  	+"daran, auf dem gross und deutlich steht: 'VERKAUFT'.";
  }
  return BS(s);
}

string strspieluhr(string str)
{
  string s;
  object ob;
  ob = find_object(ROOM "og_lagerraum_varaile");

  if(present("spieluhr", ob))
  {
  	s = "Du bewunderst die kleine Spieluhr, die in einer der Vitrinen "
  	+"steht. Sie ist wirklich wunderschoen.";
  }
  else
  {
  	s = "Die Spieluhr scheint bereits verkauft zu sein.";
  }
  return BS(s);
}

string strdrache(string str)
{
  string s;
  object ob;
  ob = find_object(ROOM "og_lagerraum_varaile");

  if(present("drache", ob))
  {
  	s = "Der kleine Plueschdrache sieht wirklich niedlich aus. Am "
  	+"liebsten wuerdest Du ihn gleich kaufen.";
  }
  else
  {
  	s = "Der Plueschdrache scheint nicht mehr zum Verkauf zu stehen.";
  }
  return BS(s);
}

string strluftballon(string str)
{
  string s;
  object ob;
  ob = find_object(ROOM "og_lagerraum_varaile");

  if(present("luftballon", ob))
  {
  	s = "Ein paar bunte Luftballons sind in den Vitrinen zu sehen.";
  }
  else
  {
  	s = "Huch, die Luftballons sind ja alle loecherig! Die kann man "
  	+"wohl nicht mehr kaufen.";
  }
  return BS(s);
}

string strwindlicht(string str)
{
  string s;
  object ob;
  ob = find_object(ROOM "og_lagerraum_varaile");

  if(present("windlicht", ob))
  {
  	s = "Die Windlichter sind kunterbunt und sehr klein, so dass man "
  	+"sie sicherlich gut verstauen kann.";
  }
  else
  {
  	s = "Die restlichen Windlichter, die Du in den Vitrinen sehen "
  	+"kannst, sind leider schon aufgebrannt.";
  }
  return BS(s);
}

string strtaschentuch(string str)
{
  string s;
  object ob;
  ob = find_object(ROOM "og_lagerraum_varaile");

  if(present("taschentuch", ob))
  {
  	s = "Du siehst einige bunte, seidene Taschentuecher gefaltet "
  	+"in den Vitrinen liegen.";
  }
  else
  {
  	s = "Schade, die Taschentuecher sehen nicht mehr sehr schoen aus. "
  	+"Warte lieber, bis Varaile sie gegen neue Tuecher ausgetauscht "
  	+"hat.";
  }
  return BS(s);
}

string strschneekugel(string str)
{
  string s;
  object ob;
  ob = find_object(ROOM "og_lagerraum_varaile");

  if(present("schneekugel", ob))
  {
  	s = "Die kleine, runde Schneekugel sieht wirklich suess aus.";
  }
  else
  {
  	s = "Ein kleines Schildchen baumelt von der Schneekugel herab. "
  	+"'VERKAUFT'.";
  }
  return BS(s);
}

string strluftschlange(string str)
{
  string s;
  object ob;
  ob = find_object(ROOM "og_lagerraum_varaile");

  if(present("luftschlangen", ob))
  {
  	s = "Du siehst ein paar kleine Rollen mit bunten Luftschlangen.";
  }
  else
  {
  	s = "Die Luftschlangen sehen schon ein wenig zerknittert aus. "
  	+"Die wuerdest Du nicht mehr kaufen wollen.";
  }
  return BS(s);
}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_int_long()
{
  string txt;
  string s;

  if(QueryProp(P_SHOPKEEPER_ID))
  {
        if(!present(QueryProp(P_SHOPKEEPER_ID)))
        {
                s = "Direkt vor Dir siehst Du eine hohe Theke, hinter der "
                +"jedoch niemand zu sehen ist. ";
        }
        else
        {
                s = "Direkt vor Dir siehst Du eine hohe Theke, hinter der "
                +"eine junge Elfe steht, die Dich freundlich anlaechelt. ";
        }
  }

  txt = "Du befindest Dich in einem kleinen, wunderlichen Laden. "+s
  +"Auf einem runden Tischchen steht eine seltsame Kugel, die den Raum mit "
  +"einem geheimnisvoll schimmernden Licht erfuellt. Glaeserne Vitrinen, "
  +"die mit allerlei seltsamen Dingen gefuellt sind, stehen um Dich herum. "
  +"Die Waende sind mit bunten Tuechern verhangen und geben dem Raum ein "
  +"sehr wohnliches und heimeliges Aussehen.";

   return BS(txt);
}

//Kein verkaufen hier:
int sell(string str, int f)
{
  string prefix;

  if (!prefix=CheckKeeper(2)) return 0;

  write(capitalize(QueryProp(P_SHOPKEEPER_NAME))+
       " sagt bedauernd: Es tut mir wirklich leid, aber ich kaufe nichts.\n");
  return -1;
}

//Nachfrage mitloggen, zumindest die erste Zeit
int buy(string str)
{
   PALASTMASTER->Msg("Varaile: "+TP->Name()+" will '"+str+"' kaufen", 2);
   return ::buy(str);
}
