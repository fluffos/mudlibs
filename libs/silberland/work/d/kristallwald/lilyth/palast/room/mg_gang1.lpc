//=========================================================================

#include "../def.h"

inherit "std/room";

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem Palast");
  SetProp(P_INT_LONG,
    "Vor Dir erstreckt sich ein langer, breiter Gang, der durch das "
    "Mittelgeschoss fuehrt. Ausser dem riesigen Gemaelde, das an einer "
    "der Waende haengt, gibt es hier nicht sehr viel zu sehen. Der Boden "
    "ist mit weichen, hellblauen Teppichen ausgelegt. Du kannst dem Gang "
    "in zwei Richtungen weiter folgen.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INFO, "Du solltest Dir das Gemaelde mal etwas genauer "
  "anschauen.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "gang", "gaenge" }),
    "Der Gang fuehrt durch das Mittelgeschoss. Er ist sehr lang und breit, "
    "so dass die Besucher des Palastes genuegend Platz fuer sich haben und "
    "sich nicht gegenseitig auf die Fuesse zu treten brauchen.");

  AddDetail( ({ "mittelgeschoss", "geschoss" }),
    "Du befindest Dich im Mittelgeschoss des Palastes.");

  AddDetail( ({ "untergeschoss" }),
    "Das Untergeschoss befindet sich unter Dir.");

  AddDetail( ({ "obergeschoss" }),
    "Die Vermutung liegt nahe, dass es irgendwo ueber Dir liegt.");

  AddDetail( ({ "vermutung", "wahrscheinlichkeit" }),
    "Du bist Dir ziemlich sicher.");

  AddDetail( ({ "besucher" }),
    "Immer wieder triffst Du hier auf andere Besucher, die sich - "
    "ebenso wie Du - den Palast anschauen wollen.");

  AddDetail( ({ "palast", "volk", "voelker" }),
    "Dies ist der Palast der Voelker, genauer gesagt, sein Mittelgeschoss.");

  AddDetail( ({ "platz" }),
    "Es herrscht kein sehr grosses Gedraenge hier drinnen, obwohl stets "
    "zahlreiche Besucher durch den Palast stroemen.");

  AddDetail( ({ "gedraenge" }),
    "Hier herrscht keines.");

  AddDetail( ({ "fuesse", "fuss" }),
  ([ 0: "Vorsicht! Unachtsam, wie Du nun einmal bist, haettest Du gerade "
  "fast eine winzige kleine Fee umgerannt, die sich direkt vor Deinen "
  "Fuessen auf dem Boden niedergelassen hatte und nun erschrocken vor Dir "
  "in der Luft schwebt.",
  "fee": "Wenn Du jemandem auf die Fuesse trittst, merkt das vermutlich "
  "sowieso keiner, ausser vielleicht eine andere Fee. :)" ]) );

  AddDetail( ({ "fee" }),
  ([ 0: "Du denkst   . o O (Was sitzt die auch da unten rum?).",
  "fee": "Ihr seid nun einmal recht klein und zierlich." ]) );

  AddDetail( ({ "gemaelde", "bild" }),
    "Ein riesiges Gemaelde bedeckt fast die gesamte Wand des Ganges. Es hat "
    "einen breiten, vergoldeten Rahmen und zeigt eine seltsam duestere "
    "Szenerie, die so gar nicht zu dem friedvollen, praechtigen Palast "
    "zu passen scheint.");

  AddDetail( ({ "rahmen" }),
    "Der Rahmen des Gemaeldes ist vergoldet.");

  AddDetail( ({ "szenerie" }),
    "Langsam schreitest Du den Gang entlang und betrachtest das Gemaelde. "
    "Es scheint eine Szene aus einer laengst vergangenen Zeit darzustellen, "
    "einer Zeit, in der noch Krieg herrschte. Ueberall siehst Du in Kaempfe "
    "verwickelte Menschen und Orks, Verwundete, die hilflos und verzweifelt "
    "ihre Haende ausstrecken, und die blutgetraenkte Erde, auf der sie "
    "liegen. Kaltes Grauen erfasst Dich, als Du das Bild anschaust.");

  AddDetail( ({ "szene" }),
    "Das ganze Gemaelde wirkt sehr duester und Du fuehlst Dich sehr "
    "unwohl bei dem Gedanken, dass das, was Du dort siehst, tatsaechlich "
    "einmal so geschehen sein koennte.");

  AddDetail( ({ "gedanke", "gedanken", "krieg", "kriege" }),
    "Auch Du hast sicher schon das eine oder andere ueber die Kriege von "
    "damals gehoert. ");

  AddDetail( ({ "zeit" }),
    "Es muss schon sehr lange her sein.");

  AddDetail( ({ "kaempfe", "kampf" }),
    "Schwere, blutige Kaempfe wurden damals im ganzen Lande ausgetragen.");

  AddDetail( ({ "land", "lande", "silberland" }),
    "Das Silberland hat eine lange und nicht immer ganz friedliche "
    "Geschichte.");

  AddDetail( ({ "geschichte", "geschichten" }),
    "Wenn Du mehr darueber erfahren willst, solltest Du mal in den "
    "Bibliotheken des Silberlandes stoebern, vielleicht wirst Du ja "
    "irgendwo fuendig.");

  AddDetail( ({ "bibliotheken", "bibliothek" }),
    "Es gibt viele Bibliotheken im Silberland.");

  AddDetail( ({ "menschen", "kaempfende", "kaempfenden" }),
    "Die Menschen, die Du auf dem Bild siehst, sehen abgekaempft und "
    "ausgezehrt aus. Sie wehren sich mit verzweifelter Entschlossenheit "
    "gegen die brutalen Angriffe der Orks, obwohl sie wesentlich schlechter "
    "ausgeruestet sind und den finsteren Scharen hilflos ausgeliefert "
    "zu sein scheinen.");

  AddDetail( ({ "entschlossenheit", "augen", "wehr" }),
    "Verzweifelte Entschlossenheit blitzt aus den Augen der wenigen "
    "Uebriggebliebenen, die sich noch mit letzter Kraft gegen die "
    "Orkscharen zur Wehr setzen.");

  AddDetail( ({ "kraft" }),
    "Obwohl sie kaum noch Kraft besitzen, haben sie noch nicht aufgegeben.");

  AddDetail( ({ "uebriggebliebene", "uebriggebliebenen", "kameraden",
  "angriffe", "angriff" }),
    "Nur wenige Menschen haben diese Angriffe ueberlebt.");

  AddDetail( ({ "orkscharen", "scharen", "uebermacht" }),
    "Gewaltige Orkscharen sind auf dem Gemaelde abgebildet.");

  AddDetail( ({ "orks" }),
    "Wild und boesartig aussehende Orks sind auf dem Gemaelde zu sehen. Sie "
    "sind fuer den Kampf geruestet und scheinen keinerlei Ruecksicht "
    "auf die ihnen kaum gewachsenen und zahlenmaessig weit unterlegenen "
    "Menschen zu nehmen, die ihnen gegenueberstehen und ihren Angriff "
    "zurueckzudraengen versuchen.");

  AddDetail( ({ "ruecksicht" }),
    "Ruecksichtslos schlagen die Orks auf die Menschen ein.");

  AddDetail( ({ "verwundete" }),
    "Zahlreiche Verwundete liegen auf der Erde und starren mit leeren, "
    "verzweifelten Blicken auf ihre kaempfenden Kameraden. Einer von "
    "ihnen scheint noch erschreckend jung zu sein, fast noch ein Kind.");

  AddDetail( ({ "blick", "blicke" }),
    "Sie sehen verzweifelt aus.");

  AddDetail( ({ "kind", "junge" }),
    "Ein Knabe von etwa zehn bis zwoelf Jahren ist auf dem Bild zu sehen. "
    "Er starrt reglos auf die Kaempfenden um ihn herum.");

  AddDetail( ({ "jahre", "jahren" }),
    "Du schaetzt ihn auf nicht aelter als zwoelf.");

  AddDetail( ({ "knabe" }),
    "Du weisst nicht, warum, aber irgendetwas an diesem Jungen fasziniert "
    "Dich. Du wuerdest gerne mehr ueber ihn erfahren, doch da er "
    "mittlerweile sicher schon lange tot ist, hast Du keine Ahnung, wie Du "
    "das anstellen koenntest.");

  AddDetail( ({ "ahnung" }),
    "Du wuerdest ihn gerne etwas ueber die Geschehnisse von damals "
    "fragen.");

  AddDetail( ({ "geschehnisse" }),
    "Du kannst ihn leider nicht fragen, da er nicht mehr lebt.");

  AddDetail( ({ "blicke" }),
    "Voellige Hoffnungslosigkeit spricht aus ihren Augen.");

  AddDetail( ({ "haende", "beistand" }),
    "Verzweifelt strecken die Verwundeten ihre Haende nach ihren Kameraden "
    "aus, wie um ihnen Beistand zu geben.");

  AddDetail( ({ "erde", "blut" }),
    "Die Erde ist ueber und ueber mit Blut getraenkt.");

  AddDetail( ({ "grauen" }),
    "Du musst an die Hilflosigkeit und die Verzweiflung denken, die die "
    "Menschen damals verspuert haben mussten, als sie der ungeheuren "
    "Uebermacht der Orks gegenueberstanden.");

  AddDetail( ({ "hilflosigkeit", "verzweiflung", "hoffnungslosigkeit" }),
    "Du kannst sie nachempfinden, wenn Du das Bild betrachtest.");

  AddDetail( ({ "wand" }),
    "Eine der Waende wird fast voellig von dem grossen Gemaelde "
    "eingenommen, das dort haengt.");

  AddDetail( ({ "waende" }),
    "Die Waende bestehen aus hellblauem Marmor. Eine Wand wird fast voellig "
    "von einem riesigen Gemaelde verdeckt.");

  AddDetail( ({ "boden", "marmorboden" }),
    "Der Boden besteht aus edlen, blauen Marmorfliesen und ist zum Teil mit "
    "hellblauen Teppichen ausgelegt.");

  AddDetail( ({ "marmorfliesen", "marmorfliese", "fliesen", "fliese" }),
    "Blaue Marmorfliesen bedecken den gesamten Boden.");

  AddDetail( ({ "decke" }),
    "Die Decke besteht vollstaendig aus hellblauem Marmor. Sie ist leicht "
    "nach aussen gewoelbt.");

  AddDetail( ({ "teil" }),
    "Der Boden ist zum Teil mit weichen Teppichen ausgelegt.");

  AddDetail( ({ "marmor" }),
    "Der hellblaue Marmor ist von feinen Goldfaeden durchzogen und sieht "
    "sehr wertvoll und edel aus.");

  AddDetail( ({ "goldfaeden", "faeden" }),
    "Feine goldene Faeden durchziehen den blauen Marmor.");

  AddDetail( ({ "teppiche", "teppich" }),
    "Grosse, hellblaue Teppiche bedecken den Marmorboden teilweise. Sie "
    "sehen herrlich weich aus und Du versinkst beim Gehen tief in ihnen. "
    "Ihre Raender sind mit goldenen Fransen verziert.");

  AddDetail( ({ "raender", "teppichraender", "rand", "teppichrand",
  "fransen" }),
    "Lange, goldene Fransen verzieren die Teppichraender.");

  AddDetail( ({ "gehen" }),
    "Beim Gehen versinkst Du foermlich in den weichen Teppichen auf "
    "dem Boden.");

  AddDetail( ({ "richtungen", "richtung" }),
    "Der Gang fuehrt nach Norden und Sueden weiter.");

  AddDetail( ({ "norden" }),
    "Mit ziemlicher Wahrscheinlichkeit bist Du von dort hergekommen.");

  AddDetail( ({ "sueden" }),
    "Du kannst dem Gang nach dorthin weiter folgen.");

  AddSpecialDetail( ({ "luft" }),
    "str_luft");

  AddSound( DEFAULT_SOUND,
    "Bis auf die leisen Geraeusche der anderen Besucher ist es hier oben "
    "sehr ruhig.");

  AddSound( ({ "geraeusch", "geraeusche", "unterhaltung", "unterhaltungen" }),
    "Du kannst nur die leisen Unterhaltungen der anderen Palastbesucher "
    "hoeren.");

  AddSound( ({ "besucher", "palastbesucher" }),
    "Sie unterhalten sich nur leise, um die Ruhe des Palastes nicht zu "
    "stoeren.");

  AddSound( ({ "ruhe", "palast" }),
    "Es herrscht eine angenehme Ruhe im Palast.");

  AddSmell( DEFAULT_SMELL,
    "Ein schwacher, aber frischer Luftzug zieht durch den Gang.");

  AddSmell( ({ "luftzug" }),
    "Die Luft hier im Gang ist angenehm frisch.");

  AddSmell( ({ "gang" }),
    "Der Gang ist von frischer Luft erfuellt.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", "nach Norden#" + "./mg_treppe1" );
  AddExit( "sueden", "nach Sueden#" + "./mg_treppe2" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "bild_gang1", REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer SpecialDetails-----------------------------------------

string str_luft(string str)
{
  string s;
  string t;

  if(this_player()->QueryProp(P_RACE) == "Fee")
  {
  	s = "Sowas siehst Du da nicht!";
  }
  else
  {

      switch(TP->QueryProp(P_RACE))
      {
          case "Elf": t = "Elfen";
            break;
          case "Zwerg": t = "Zwerge";
            break;
          case "Oger": t = "Oger";
            break;
          case "Troll": t = "Trolle";
            break;
          case "Dunkelelf": t = "Dunkelelfen";
            break;
          case "Hobbit": t = "Hobbits";
            break;
          case "Untoter": t = "Untoten";
            break;
          case "Mensch": t = "Menschen";
            break;
          case "Magier": t = "Magier";
            break;
          default: t = "... ja, was bist Du eigentlich?? ...";
            break;
      }

      s = "Empoert schaut Dich die Fee kurz von oben bis unten an, murmelt "
          "etwas von 'immer diese unachtsamen "+t+"' und flattert dann "
          "blitzschnell davon.";
  }
  return BS(s);
}
