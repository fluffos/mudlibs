#include "../def.h"

inherit "std/room";

//--Variablen&Defines------------------------------------------------------

#define BANK(wer) (member(bank, capitalize(getuid(wer)))!=-1)
#define MyCountUp(arg) (sizeof(arg) > 1 ? \
    implode(arg[0..<2], ", ") + " und " + arg[<1] : \
    (sizeof(arg) == 0 ? "niemand" : arg[0]) )

string *bank=({});

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem Palast");
  SetProp(P_INT_LONG,
    "Du folgst dem breiten, mit schneeweissen Laeufern ausgelegten Gang, der "
    "weiter in den Palast hineinfuehrt. Die Waende sind ueber und ueber "
    "reich verziert und an beiden Seiten siehst Du kleine Baenke aus "
    "schimmerndem weissen Holz, die wohl fuer die Besucher gedacht sind. "
    "Ein niedriger Sockel, auf dem ein grosses goldenes Buch liegt, steht "
    "neben einer der Baenke auf der Westseite des Ganges.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "laeufer" }),
    "Flauschige schneeweisse Laeufer wurden hier im Gang auf dem glatten "
    "Marmorboden ausgelegt.");

  AddDetail( ({ "marmorboden", "boden" }),
    "Der Boden besteht aus hellem Marmor.");

  AddDetail( ({ "marmor" }),
    "Der helle Marmor ist groesstenteils mit schneeweissen Laeufern "
    "ausgelegt.");

  AddDetail( ({ "gang" }),
    "Der Gang fuehrt im Norden tiefer in den Palast hinein und im Sueden "
    "zurueck in die grosse Eingangshalle.");

  AddDetail( ({ "norden" }),
    "Noerdlich von hier gelangst Du weiter in den Palast hinein.");

  AddDetail( ({ "eingangshalle" }),
    "Die Eingangshalle befindet sich im Sueden.");

  AddDetail( ({ "sueden" }),
    "Im Sueden gelangst Du zurueck in die Eingangshalle.");

  AddDetail( ({ "palast" }),
    "Du laeufst in den weiten Gaengen des Palastes umher.");

  AddDetail( ({ "gaenge" }),
    "Du befindest Dich momentan in einem der breiten Gaenge, die durch "
    "den Palast fuehren.");

  AddDetail( ({ "waende", "wand" }),
    "Anders als in der Eingangshalle sind die Waende hier mit Perlmutt und "
    "Edelsteinen reich verziert.");

  AddDetail( ({ "perlmutt" }),
    "Glaenzendes und schimmerndes Perlmutt ueberzieht die Waende.");

  AddDetail( ({ "edelsteine" }),
    "Viele glitzernde Edelsteine sind in Form von Mosaiken an den Waenden "
    "angebracht worden.");

  AddDetail( ({ "form" }),
    "Die Edelsteine bilden bunte Mosaike.");

  AddDetail( ({ "mosaike", "mosaik" }),
    "Die Edelsteine leuchten in allen moeglichen Farben und bilden "
    "kunstvolle Mosaike an den Waenden.");

  AddDetail( ({ "farben" }),
    "Du siehst feuerrote Rubine, eisblaue Saphire, sonnengelbe Topase, "
    "regenbogenfarbene Opale und viele andere Edelsteine an den Waenden "
    "glitzern und leuchten.");

  AddDetail( ({ "rubine", "rubin" }),
    "Man sagt, der Rubin sei der Edelstein des Feuers.");

  AddDetail( ({ "edelstein" }),
    "Der Rubin ist ein sehr wertvoller Edelstein.");

  AddDetail( ({ "feuer" }),
    "Dies ruehrt wohl nicht zuletzt von seiner feuerroten Farbe her.");

  AddDetail( ({ "farbe" }),
    "Rubine sind feuerrot.");

  AddDetail( ({ "topase", "topas" }),
    "Topase sind gelb wie die Sonne.");

  AddDetail( ({ "sonne" }),
    "Die Sonne ist normalerweise gelb.");

  AddDetail( ({ "saphire", "saphir" }),
    "Saphire werden haeufig mit Eis in Verbindung gebracht. ");

  AddDetail( ({ "eis" }),
    "Saphire sind eisblau.");

  AddDetail( ({ "verbindung" }),
    "Saphire bringt man haeufig mit Eis in Verbindung.");

  AddDetail( ({ "opale", "opal" }),
    "Die Opale leuchten in allen Farben des Regenbogens.");

  AddDetail( ({ "regenbogen" }),
    "Bestimmt hast Du schon mal einen Regenbogen auf einem Deiner "
    "zahlreichen Abenteuer gesehen.");

  AddDetail( ({ "abenteuer" }),
    "Du hast schon einiges erlebt hier im SilberLand.");

  AddDetail( ({ "silberland" }),
    "Der Palast, der Wald draussen... das alles gehoert zum SilberLand.");

  AddDetail( ({ "wald" }),
    "Der befindet sich ausserhalb des Palastes.");

  AddDetail( ({ "seiten" }),
    "Zu Deiner Linken und zu Deiner Rechten stehen kleine weisse Baenke "
    "im Gang.");

  AddDetail( ({ "linke", "linken" }),
    "Links ist da, wo der Daumen rechts ist.");

  AddDetail( ({ "daumen" }),
    "Der etwas dickere kurze Knubbel an Deiner Hand.");

  AddDetail( ({ "knubbel" }),
    "Das ist Dein Daumen.");

  AddDetail( ({ "hand" }),
    "Du hast sogar zwei davon!");

  AddDetail( ({ "rechte", "rechten" }),
    "Rechts befindet sich meistens direkt gegenueber von links.");

  AddDetail( ({ "atmosphaere" }),
    "Es herrscht eine herrliche Atmosphaere im Palast.");

  AddDetail( ({ "weisses holz" }),
    "Die Baenke sind aus schimmerndem weissen Holz geschnitzt.");

  AddDetail( ({ "besucher" }),
    "Du bist nicht alleine hier im Palast.");

  AddDetail( ({ "sockel" }),
    "Der Sockel besteht aus hellem, leicht roetlichem Nachtbluetenholz. "
    "Ein grosses goldenes Buch liegt darauf.");

  AddDetail( ({ "nachtbluetenholz" }),
    "Nachtbluetenholz ist sehr selten und heutzutage kaum noch in der Natur "
    "zu finden. Seine Oberflaeche ist sehr glatt und fuehlt sich fast ein "
    "wenig weich und nachgiebig unter Deinen Fingern an. Es hat eine sehr "
    "schoene roetliche Faerbung.");

  AddDetail( ({ "natur" }),
    "Nachtbluetenholz kommt kaum noch in der freien Natur vor.");

  AddDetail( ({ "oberflaeche" }),
    "Das Nachtbluetenholz hat eine sehr glatte und fast weiche Oberflaeche.");

  AddDetail( ({ "finger" }),
    "Du faehrst mit Deinen Fingern leicht ueber das glatte Holz.");

  AddDetail( ({ "holz" }),
    "Welches Holz meinst Du denn?");

  AddDetail( ({ "faerbung" }),
    "Das Nachtbluetenholz hat eine leicht roetliche Faerbung.");

  AddDetail( ({ "buch" }),
    "Das Buch besteht aus purem Gold und ist mit vielen Schnoerkeln und "
    "geheimnisvollen Zeichen verziert. Der Titel des Buches ist in grossen "
    "versilberten Lettern aufgebracht und deutlich zu lesen.");

  AddDetail( ({ "gold" }),
    "Das Buch besteht aus reinem Gold und hat sicherlich ein nicht "
    "unerhebliches Gewicht.");

  AddDetail( ({ "gewicht" }),
    "Ob Du es ueberhaupt anheben koenntest?");

  AddDetail( ({ "schnoerkel" }),
    "Viele kurze und lange, kreisrunde und ovale, goldene und silberne "
    "Schnoerkel zieren das Buch von aussen.");

  AddDetail( ({ "zeichen" }),
    "Die Zeichen sehen sehr geheimnisvoll aus, so als ob sie magischen "
    "Ursprungs waeren.");

  AddDetail( ({ "ursprung" }),
    "Vielleicht wirken diese Zeichen irgendeine Art von Magie.");

  AddDetail( ({ "art" }),
    "So genau kennst Du Dich da leider nicht aus.");

  AddDetail( ({ "magie" }),
    "Du spuerst, dass eine gewisse Magie von diesen sonderbaren Zeichen "
    "ausgeht.");

  AddDetail( ({ "titel" }),
    "Lies ihn.");

  AddDetail( ({ "lettern", "letter" }),
    "Buchstaben.");

  AddDetail( ({ "buchstaben", "buchstabe" }),
    "Lettern.");

  AddDetail( ({ "westseite" }),
    "Auf der Westseite steht ein niedriger Sockel, auf dem ein grosses "
    "goldenes Buch liegt, neben den Baenken.");

  AddDetail( ({ "decke" }),
    "Die Decke ist hier etwas niedriger als in der Eingangshalle. Sie "
    "besteht aus hellen weissen Steinen und ist leicht gewoelbt.");

  AddDetail( ({ "steine" }),
    "Die Decke ist aus hellen weissen Steinen gefertigt.");

  AddReadDetail( ({ "titel" }),
    "'Der Palast der Voelker'.");

  AddReadDetail( ({ "buch" }),
    "Welche Seite des Buches moechtest Du denn lesen?\n"
    "(Hinweis: 'lies seite 1', 'lies seite 3' usw.)");

  AddReadDetail( ({ "seite 1", "seite eins", "erste seite", "1. seite" }),
"*************************************#************** - 1 - ***************\n"
"*                                   *#                                   *\n"
"*                                   *#  Es war der erste dieser Art,     *\n"
"*                                   *#  und ein ungewohnter Anblick,     *\n"
"*                                   *#  wie die Scharen von Orks durch   *\n"
"*                                   *#  den Wald rannten. Und wie es     *\n"
"*                                   *#  in einem Krieg ueblich war,      *\n"
"*  'Und es begab sich, dass im Tal  *#  bestand er nicht nur aus den     *\n"
"*   von Tethyr ein Krieg tobte...'  *#  edlen Taten der Waldlaeufer und  *\n"
"*                                   *#  der Kleriker, welche zusammen    *\n"
"*                                   *#  die Schwarzpelze vernichteten.   *\n"
"*                                   *#  Doch es waren ihrer viele, und   *\n"
"*                                   *#  somit dauerte der Krieg mehrere  *\n"
"*                                   *#  Jahre, keiner weiss heute noch,  *\n"
"*                                   *#  wie lang...                      *\n"
"*                                   *#                                   *\n"
"*************************************#************************************");

  AddReadDetail( ({ "seite 2", "seite zwei", "zweite seite", "2. seite",
                    "seite 3", "seite drei", "dritte seite", "3. seite" }),
"*************** - 2 - ***************#************** - 3 - ***************\n"
"*                                   *#                                   *\n"
"*  Und in diesem Krieg wurden viele *#  Es war das zweite Jahr des Krie- *\n"
"*  Geschichten erlebt, doch nur     *#  ges, und nun zeigte sich die     *\n"
"*  wenige haben vor dem realisti-   *#  schwaerzeste Seite des Krieges   *\n"
"*  schen Auge der Neuzeit noch      *#  am schlimmsten. Neben den vielen *\n"
"*  Bestand. Nur die, deren Zeugen   *#  Leichen der Orks kam man nicht   *\n"
"*  heute noch stehen. Zeugen, die   *#  um die schrecklichen Hinter-     *\n"
"*  nichts sagen koennen, und die    *#  lassenschaften der Kaempfe im    *\n"
"*  dennoch viel erzaehlen, alte     *#  Wald herum. Abgetrennte Extremi- *\n"
"*  Zeugnisse der Zeit.              *#  taeten, Blutlachen, Leichenteile *\n"
"*                                   *#  und wimmernde Opfer, die ent-    *\n"
"*  Eines von diesen ist der Palast  *#  weder ihren restlichen Koerper   *\n"
"*  der Voelker. Er liegt heute noch *#  suchten oder um den Gnadenstoss  *\n"
"*  ruhig und versteckt im Tal...    *#  bettelten.                       *\n"
"*                                   *#                                   *\n"
"*************************************#************************************");

  AddReadDetail( ({ "seite 4", "seite vier", "vierte seite", "4. seite",
                    "seite 5", "seite fuenf", "fuenfte seite", "5. seite" }),
"*************** - 4 - ***************#************** - 5 - ***************\n"
"*                                   *#                                   *\n"
"*  Verwundete, Kranke, Verstuem-    *#  Es lag ausserhalb der Faehigkei- *\n"
"*  melte und seelische Greise im    *#  ten der Priester und Kleriker,   *\n"
"*  Koerper junger Soldaten bevoel-  *#  neben der Kriegsfuehrung auch    *\n"
"*  kerten die Zufluchten der Men-   *#  noch die Verlorenen zu erretten. *\n"
"*  schen und Elfen im Tal. Die      *#  Vor den Fenstern der Soeldner,   *\n"
"*  Stadt Avir, hoch oben auf einem  *#  vor den Toren der Kaserne und    *\n"
"*  Felsen des Schutzes, inmitten    *#  vor den Tueren der Ritter lagen  *\n"
"*  von Mauern der Isolation, war    *#  sie. Und ihre Herzen wurden      *\n"
"*  am schlimmsten betroffen. Die    *#  schwerer, der Glanz ihrer Siege  *\n"
"*  Strassen wurden belagert von     *#  matter und der Strahl ihrer      *\n"
"*  den Armeen des Elends und den    *#  Hoffnung blasser, wenn die Ver-  *\n"
"*  Kaempfern des Leids.             *#  teidiger ihrer Haeuser verlies-  *\n"
"*                                   *#  sen, um in den Krieg zu ziehen.  *\n"
"*                                   *#                                   *\n"
"*************************************#************************************");

  AddReadDetail( ({ "seite 6", "seite sechs", "sechste seite", "6. seite",
                    "seite 7", "seite sieben", "siebte seite", "7. seite" }),
"*************** - 6 - ***************#************** - 7 - ***************\n"
"*                                   *#                                   *\n"
"*  Die Kaempfer der Stadt waren     *#  Nur die wenigen Hueter im Wald   *\n"
"*  unmotiviert und schockiert,      *#  hielten die anstuermenden Trup-  *\n"
"*  und so zog die Angst ein in      *#  pen weiter auf. Das Leid war     *\n"
"*  ihre Herzen und schwaechte ihre  *#  gross und das Elend unbesiegbar, *\n"
"*  Kraft. Viele junge Kaempfer      *#  so schien es... Doch wie in so   *\n"
"*  waren nicht mehr faehig, eine    *#  vielen gefuehrten Kriegen und    *\n"
"*  Waffe zu fuehren, sahen sie doch *#  Schlachten, welche noch zu fueh- *\n"
"*  taeglich, was die Waffen ihrer   *#  ren sind, ist es die Liebe, wel- *\n"
"*  Feinde anrichteten. Es war nicht *#  che nach wie vor der Drehpunkt   *\n"
"*  ihre Schuld, waren sie doch noch *#  im Verlauf des Krieges ist, doch *\n"
"*  so jung. Und die wenigen Alten   *#  entscheiden meist nur zwei Leute *\n"
"*  reichten nicht aus, um den Orks  *#  ueber die neue Richtung und das  *\n"
"*  den letzten Stoss zu verpassen.  *#  damit bestimmte Ende...          *\n"
"*                                   *#                                   *\n"
"*************************************#************************************");

  AddReadDetail( ({ "seite 8", "seite acht", "achte seite", "8. seite",
                    "seite 9", "seite neun", "neunte seite", "9. seite" }),
"*************** - 8 - ***************#************** - 9 - ***************\n"
"*                                   *#                                   *\n"
"*  Eine Heilerin aus dem Turm der   *#  so zerbrechlich. Sie war noch    *\n"
"*  Kuenste, hoch ueber Avir, begab  *#  nicht bereit fuer die Bilder des *\n"
"*  sich herab auf die Strassen      *#  des Krieges, und so verschloss   *\n"
"*  Avirs, vorbei am manifestierten  *#  sie ihre Augen und rannte den    *\n"
"*  Leid. Trauer ergriff ihr Herz    *#  Wachweg hinab. Am Fusse des Fel- *\n"
"*  und eine Traene beruehrte den    *#  sens angekommen, rannte sie      *\n"
"*  Boden, als sie durch das Stadt-  *#  blindlings in den todbringenden  *\n"
"*  tor schritt. Hindurch durch die  *#  Wald hinein. Ein Posten sah nur  *\n"
"*  Inkarnation des Elends ging sie  *#  noch, wie ihr wallendes, gold-   *\n"
"*  den Wachweg entlang, bis sie     *#  blondes Haar im Wald verschwand. *\n"
"*  schliesslich anfing zu schluch-  *#  Ihr strahlendweisses Gewand war  *\n"
"*  zen. Sie konnte nicht mehr. Sie  *#  nur noch einige Augenblicke zu   *\n"
"*  war noch so jung, so schoen und  *#  sehen, bevor es vom Dunkel des   *\n"
"*                                   *#                                   *\n"
"*************************************#************************************");

  AddReadDetail( ({ "seite 10", "seite zehn", "zehnte seite", "10. seite",
                    "seite 11", "seite elf", "elfte seite", "11. seite" }),
"*************** - 10 - **************#************** - 11 - **************\n"
"*                                   *#                                   *\n"
"*  Waldes verschluckt wurde. Durch  *#  einfach.. zu Deinem Schicksal..' *\n"
"*  einen Traenenschleier war es ihr *#  Und dann veraenderte sich der    *\n"
"*  unmoeglich zu sehen, wohin sie   *#  Wind, sie lief nicht mehr gegen  *\n"
"*  rannte. Sie wollte nur fort.     *#  ihn, er drehte sich und schien   *\n"
"*  Doch ploetzlich draengte sich    *#  sie ploetzlich zu treiben, und   *\n"
"*  eine Stimme in ihren Kopf, nein, *#  sie sah Wege, die ihr vorher     *\n"
"*  keine Stimme... mehr ein Wispern *#  verschlossen waren. So glitt sie *\n"
"*  drang von allen Seiten an ihr    *#  elfengleich einige Zeit durch    *\n"
"*  Ohr. 'Es nuetzt nichts... Du     *#  den Wald, obwohl sie eigentlich  *\n"
"*  kannst Dich davor nicht ver-     *#  nicht wusste, wohin sie ging,    *\n"
"*  schliessen. Du bist zu Hoeherem  *#  und wem oder was sie folgte.     *\n"
"*  bestimmt, Deine Faehigkeiten     *#  Der Gedanke verflog, als sie     *\n"
"*  werden gebraucht... folge mir    *#  ploetzlich auf eine Lichtung     *\n"
"*                                   *#                                   *\n"
"*************************************#************************************");

  AddReadDetail( ({ "seite 12", "seite zwoelf", "zwoelfte seite", "12. seite",
                    "seite 13", "seite dreizehn", "dreizehnte seite",
                    "13. seite" }),
"*************** - 12 - **************#************** - 13 - **************\n"
"*                                   *#                                   *\n"
"*  hinaustrat, und der Wind ver-    *#  und es sah so aus, als wuerden   *\n"
"*  schwand. Am anderen Ende der     *#  sie friedlich schlafen. Die      *\n"
"*  Lichtung stand eine verhuellte   *#  Heilerin schrie erschrocken auf, *\n"
"*  Gestalt. Die Gestalt deutete     *#  als sie bemerkte, dass einige    *\n"
"*  auf die Felswand, vor der sie    *#  Gesichter vor Schmerzen grauen-  *\n"
"*  stand, und schon war sie ver-    *#  voll verzerrt waren. Aus toten   *\n"
"*  schwunden. 'Viel Glueck...'      *#  und weit aufgerissenen Augen     *\n"
"*  Unsicher lief die Heilern auf    *#  starrten sie die junge Frau an.  *\n"
"*  die Felswand zu, und dann sah    *#  Ein Gedanke raste durch ihren    *\n"
"*  sie die Koerper. Um einen Brun-  *#  Kopf. Sie waren tot! Sie waren   *\n"
"*  nen herum sassen und lagen meh-  *#  alle tot! Warum hatte sie der    *\n"
"*  rere Gestalten. Ein Geruch der   *#  Hueter hierher gefuehrt?!        *\n"
"*  Verwesung ging von ihnen aus,    *#                                   *\n"
"*                                   *#                                   *\n"
"*************************************#************************************");

  AddReadDetail( ({ "seite 14", "seite vierzehn", "vierzehnte seite",
                    "14. seite", "seite 15", "seite fuenfzehn",
                    "fuenfzehnte seite", "15. seite" }),
"*************** - 14 - **************#************** - 15 - **************\n"
"*                                   *#                                   *\n"
"*  Als sich eine Hand sanft auf     *#  Wie es sich herausstellte, waren *\n"
"*  ihre Schulter legte, zuckte sie  *#  nicht alle Maenner tot, und so   *\n"
"*  zusammen und drehte sich er-     *#  konnte die Heilerin mit Hilfe    *\n"
"*  schrocken um. Sie wollte schrei- *#  der Kraft ihrer Goettin und der  *\n"
"*  en, doch seltsam es ihr war, sie *#  Liebe wahre Wunder vollbringen.  *\n"
"*  verfiel den leuchtend gruenen    *#  Und die angeschlagenen Soldaten  *\n"
"*  Augen des jungen Mannes sofort.  *#  blieben dort. Der Wald gewaehrte *\n"
"*  Sie laechelte ihn an, und er     *#  ihnen Ruhe und Nahrung zur Ge-   *\n"
"*  laechelte ebenfalls. Es waren    *#  nesung. Sie errichteten ein      *\n"
"*  kaum Worte noetig. Es war die    *#  kleines Lager, das von nun an    *\n"
"*  Liebe, die sich gerade auf einer *#  ihr Stuetzpunkt war. Und immer,  *\n"
"*  Lichtung am Rande des Tales ein- *#  wenn jemand verletzt war, kam    *\n"
"*  gefunden hatte.                  *#  er zurueck und begab sich in     *\n"
"*                                   *#                                   *\n"
"*************************************#************************************");

  AddReadDetail( ({ "seite 16", "seite sechzehn", "sechzehnte seite",
                    "16. seite", "seite 17", "seite siebzehn",
                    "siebzehnte seite", "17. seite" }),
"*************** - 16 - **************#************** - 17 - **************\n"
"*                                   *#                                   *\n"
"*  die heilenden Haende der jungen  *#  wurden weniger, und schliesslich *\n"
"*  Frau aus Avir. Zusammen mit ih-  *#  war auch der letzte dort ver-    *\n"
"*  rem geliebten Kaempfer baute sie *#  schwunden, denn von nun an kuem- *\n"
"*  das Lager weiter aus und nach    *#  merten sich die freien Heiler im *\n"
"*  einiger Zeit kamen immer mehr    *#  Norden um alle Kriegsverletzten. *\n"
"*  Leute. Einige Jahre spaeter war  *#  Der Mut in den Herzen der Krie-  *\n"
"*  der Ort ein Sammelpunkt fuer     *#  ger erwachte neu, und schon bald *\n"
"*  einige freie Heiler und viele    *#  waren die Orks aus dem Tal ver-  *\n"
"*  Verwundete geworden. Zusammen    *#  trieben und es kehrte wieder     *\n"
"*  mit ihnen und mit ihrem Mann     *#  Ruhe ein...                      *\n"
"*  hatte die junge Heilerin das     *#                                   *\n"
"*  Lager fast zu einem Palast aus-  *#                                   *\n"
"*  gebaut. Die Verwundeten in Avir  *#                                   *\n"
"*                                   *#                                   *\n"
"*************************************#************************************");

  AddReadDetail( ({ "seite 18", "seite achtzehn", "achtzehnte seite",
                    "18. seite", "seite 19", "seite neunzehn",
                    "neunzehnte seite", "19. seite" }),
"*************** - 18 - **************#************** - 19 - **************\n"
"*                                   *#                                   *\n"
"*  Das sich liebende Paar sollte    *#                                   *\n"
"*  die naechsten Kriege nicht mehr  *#                                   *\n"
"*  erleben, doch lebten beide noch  *#                                   *\n"
"*  lange Zeit in Frieden und Har-   *#                                   *\n"
"*  monie zusammen in ihrem Palast,  *#                                   *\n"
"*  der in den kurz waehrenden Frie- *#                                   *\n"
"*  denszeiten spaeter immer mehr    *#                                   *\n"
"*  von einem Ort des Heilens zu     *#                                   *\n"
"*  einem Ort des Handels wurde.     *#                                   *\n"
"*  Er wurde von den nachfolgenden   *#                                   *\n"
"*  Generationen erhalten und steht  *#                                   *\n"
"*  heute noch in voller Pracht im   *#                                   *\n"
"*  Norden des Waldes von Tethyr.    *#                                   *\n"
"*                                   *#                                   *\n"
"*************************************#************************************");

  AddSound( DEFAULT_SOUND,
    "Du hoerst nur ein leises Fluestern von den anderen Besuchern, die sich "
    "mit Dir hier im Gang aufhalten. Ansonsten ist es sehr still hier.");

  AddSound( ({ "fluestern" }),
    "Ein leises Fluestern erfuellt den Gang.");

  AddSound( ({ "gang" }),
    "Es ist sehr ruhig hier im Gang.");

  AddSound( ({ "besucher" }),
    "Die anderen Besucher unterhalten sich leise.");

  AddSmell( DEFAULT_SMELL,
    "Ein leichter Luftzug zieht durch den Gang und bringt etwas frische "
    "Luft herein. Ein sehr schwacher Blumenduft liegt in der Luft.");

  AddSmell( ({ "luftzug" }),
    "Ein leichter Luftzug durchzieht den Gang.");

  AddSmell( ({ "gang" }),
    "Die Luft im Gang ist sehr frisch und sogar ein wenig kuehl.");

  AddSmell( ({ "luft" }),
    "Die Luft ist angenehm frisch.");

  AddSmell( ({ "blumenduft", "duft", "blumen" }),
    "Ein kaum wahrnehmbarer Duft nach frischen Blumen erfuellt den Gang. "
    "Seltsam, denn Du kannst hier nirgendwo auch nur eine einzige Blume "
    "entdecken.");

  AddSmell( ({ "blume" }),
    "Obwohl Du hier nirgendwo eine Blume siehst, kannst Du sie deutlich "
    "riechen.");

  AddSpecialDetail( ({ "baenke", "bank" }),
    "strbaenke");

//--Ausgaenge--------------------------------------------------------------

  AddExit ("norden", ([ EX_DEST: "./ug_mitte",
                       EX_TESTFUNC: "exit_test",
                       EX_MSG: "nach Norden" ]) );

  AddExit ("sueden", ([ EX_DEST: "./ug_eingangshalle",
                        EX_TESTFUNC: "exit_test",
                        EX_MSG: "nach Sueden" ]) );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "heb", "hebe" }), "buch_anheben" );
  AddCmd( ({ "sitz", "sitze", "setz", "setze" }), "sitzen" );
  AddCmd( ({ "steh", "stehe" }), "aufstehen" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer SpecialDetails-----------------------------------------

string strbaenke(string str)
{
  string s;
  s = "";

  if(BANK(TP))
  {
  	bank -= ({ capitalize(getuid(TP)) });

  	if(sizeof(bank) == 0)
  	{
  	        s = "Du sitzt mutterseelenalleine auf einer der Baenke "
  	        +"herum.";
  	}
  	if(sizeof(bank) == 1)
  	{
  	        s = bank[0]+" und Du habt es euch auf einer der Baenke "
  	        +"gemuetlich gemacht.";
  	}
  	if(sizeof(bank) > 1)
  	{
  	        s = "Neben Dir sitzen "+MyCountUp(bank)+" auf den Baenken.";
  	}

  	bank += ({ capitalize(getuid(TP)) });
   }
   else
   {
  	if(sizeof(bank) == 1)
  	{
  	        s = bank[0]+" hat es sich auf einer der Baenke gemuetlich "
  	        +"gemacht.";
  	}
  	if(sizeof(bank) > 1)
  	{
  	        s = "Es sitzen "+MyCountUp(bank)+" auf der Bank.";
  	}
   }
   return BS("Zu beiden Seiten des Ganges stehen kleine huebsche Baenke "
   +"aus schimmerndem weissem Holz. Sie sind fuer die Besucher des Palastes "
   +"gedacht, die sich dort ausruhen oder auch einfach nur die Atmosphaere "
   +"des Palastes geniessen wollen. "+s);
}

//--Funktionen-------------------------------------------------------------

//Buch anheben:
int buch_anheben(string str)
{
  notify_fail("Was willst Du anheben?\n");

  if(!str || str == "") return 0;

  if(!(str == "buch" ||
       str == "buch an")) return 0;

  write(BS("Du versuchst, das grosse goldene Buch anzuheben, doch "
  +"es ruehrt sich keinen Zentimeter von der Stelle."));

  TO->Message(BS(TP->Name(WER, 1)+" hantiert an dem Sockel herum und schaut "
  +"dann etwas enttaeuscht.\n"), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;
}

//auf Bank sitzen:
int sitzen(string str)
{
  notify_fail("Wo moechtest Du Dich hinsetzen?\n");

  if(!str || str == "") return 0;

  if(!(str == "auf bank" ||
       str == "auf baenke")) return 0;

  if(BANK(TP))
  {
        write("Aber Du sitzt doch schon auf einer Bank!\n");
        return -1;
  }

  if(sizeof(bank) > 4)
  {
        write(BS("Die Baenke sind leider schon alle besetzt. Fuer Dich ist "
        +"dort kein Platz mehr. :(\n"));
        return -1;
  }

  write(BS("Du setzt Dich auf eine der Baenke und ruhst Dich einen "
  +"Moment lang aus."));

  TO->Message(TP->Name(WER, 1)+" ruht sich auf einer Bank aus.\n",
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  bank += ({ capitalize(getuid(TP)) });
  return 1;
}

//von Bank aufstehen:
int aufstehen(string str)
{
  notify_fail("Was moechtest Du tun?\n");

  if(!str || str == "") return 0;

  if(!(str == "von bank auf" ||
       str == "auf")) return 0;

  if(BANK(TP))
  {
        write(BS("Du erhebst Dich frisch und ausgeruht wieder von der "
        +"Bank."));

        TO->Message(TP->Name(WER, 1)+" steht von der Bank auf.\n",
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  }
  else
  {
        write("Aber Du sitzt doch gar nicht auf der Bank!\n");
        return -1;
  }

  bank -= ({ capitalize(getuid(TP)) });
  return 1;
}

//Test beim Verlassen des Raumes, ob man auf der Bank sitzt
int exit_test(string dir)
{
        if(BANK(TP))
        {
                write("Dazu solltest Du erstmal aufstehen.\n");
                return 0;
        }

        return 1;
}

//Spieler logt aus waehrend des auf der Bank Sitzens
void BecomesNetDead(object spieler)
{
  if(BANK(spieler))
  bank -= ({ capitalize(getuid(spieler)) });
}

//Spieler stirbt waehrend des Sitzens
void NotifyPlayerDeath(object spieler, object killer, int lost_xp)
{
  if(BANK(spieler))
  bank -= ({ capitalize(getuid(spieler)) });
}
