  AddDetail( ({ "steine", "stein" }),
    "Die gesamte Decke besteht aus hellen weissen Steinen.");

  AddDetail( ({ "ostwand", "wand" }),
    "An der Ostwand haengt ein grosses Zepter.");

  AddDetail( ({ "zepter", "szepter" }),
    "Ein maechtiges Zepter haengt an der Ostwand. Es wurde aus "
