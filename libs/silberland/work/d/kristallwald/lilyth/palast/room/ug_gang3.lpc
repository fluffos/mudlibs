  AddDetail( ({ "sterne", "stern" }),
    "In der Nacht kannst Du die Sterne am Himmel sehen.");

  AddDetail( ({ "nacht" }),
    "Jetzt ist es Tag.");

  AddDetail( ({ "tag" }),
    "Draussen ist es hell, also ist es Tag.");

  AddDetail( ({ "himmel" }),
    "Hier drinnen ist leider kein Himmel zu sehen.");

  AddDetail( ({ "seiten", "seite" }),
    "Zu Deiner Linken und zu Deiner Rechten stehen kleine weisse Baenke "
