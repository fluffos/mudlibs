  AddDetail( ({ "holz", "weisses holz" }),
    "Das weisse Holz, aus dem die Baenke geschnitzt sind, schimmert leicht.");

  AddDetail( ({ "besucher" }),
    "Es befinden sich noch einige andere Besucher hier im Palast.");

  AddDetail( ({ "decke" }),
    "Die Decke ist hier recht niedrig und leicht gewoelbt. Sie besteht "
