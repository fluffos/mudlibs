//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "heb", "hebe" }), "laeufer_anheben" );
  AddCmd( ({ "sitz", "sitze", "setz", "setze" }), "sitzen" );
  AddCmd( ({ "steh", "stehe" }), "aufstehen" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer SpecialDetails-----------------------------------------

string strbaenke(string str)
{
  string s;
  s = "";

  if(BANK(TP))
  {
  	bank -= ({ capitalize(getuid(TP)) });

  	if(sizeof(bank) == 0)
  	{
  	        s = "Du sitzt mutterseelenalleine auf einer der Baenke "
  	        +"herum.";
  	}
  	if(sizeof(bank) == 1)
  	{
  	        s = bank[0]+" und Du habt es euch auf einer der Baenke "
  	        +"gemuetlich gemacht.";
  	}
  	if(sizeof(bank) > 1)
  	{
  	        s = "Neben Dir sitzen "+MyCountUp(bank)+" auf den Baenken.";
  	}

  	bank += ({ capitalize(getuid(TP)) });
   }
   else
   {
  	if(sizeof(bank) == 1)
  	{
  	        s = bank[0]+" hat es sich auf einer der Baenke gemuetlich "
  	        +"gemacht.";
  	}
  	if(sizeof(bank) > 1)
  	{
  	        s = "Es sitzen "+MyCountUp(bank)+" auf der Bank.";
  	}
   }
   return BS("Zu beiden Seiten des Ganges stehen kleine huebsche Baenke "
   +"aus schimmerndem weissen Holz. Sie sind fuer die Besucher des Palastes "
   +"gedacht, die sich dort ausruhen oder auch einfach nur die Atmosphaere "
   +"des Palastes geniessen wollen. "+s);
}

//--Funktionen-------------------------------------------------------------

//Laeufer anheben:
int laeufer_anheben(string str)
{
  notify_fail("Was moechtest Du anheben?\n");

  if(!str || str == "") return 0;

  if(!(str == "laeufer an" ||
       str == "laeufer hoch" )) return 0;

  if(maus == DA)
  {
  	write(BS("Vorsichtig hebst Du den Laeufer an einer Ecke hoch. "
  	+"Huch! Die winzig kleine Maus, die es sich unter dem Laeufer "
  	+"gemuetlich gemacht hatte und sich nun von Dir gestoert fuehlt, "
  	+"piepst Dich empoert an und flitzt dann blitzschnell den Gang "
  	+"hinunter, um sich ein neues Versteck zu suchen."));

  	TO->Message(BS(TP->Name(WER, 1)+" schaut neugierig unter einen der "
  	+"Laeufer und blickt dann ein wenig verdutzt den Gang hinunter."),
  	MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    maus = WEG;
    return 1;
  }
  else
  {
  	write(BS("Vorsichtig hebst Du den Laeufer an einer Ecke hoch. "
  	+"Hm, anscheinend hatte sich nur eine kleine Luftblase unter dem "
  	+"Laeufer gebildet und so die Beule verursacht."));

  	TO->Message(BS(TP->Name(WER, 1)+" schaut neugierig unter einen der "
  	+"Laeufer."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    return -1;
  }
}

void reset()
{
	::reset();
	maus = DA;
}

//auf Bank sitzen:
int sitzen(string str)
{
  notify_fail("Wo moechtest Du Dich hinsetzen?\n");

  if(!str || str == "") return 0;

  if(!(str == "auf bank" ||
       str == "auf baenke")) return 0;

  if(BANK(TP))
  {
        write(BS("Aber Du sitzt doch bereits auf der Bank!"));
        return -1;
  }

  if(sizeof(bank) > 4)
  {
        write(BS("Die Baenke sind leider alle besetzt. Fuer Dich ist "
        +"kein Platz mehr."));
        return -1;
  }

  write(BS("Du machst es Dir auf einer der Baenke gemuetlich."));

  TO->Message(BS(TP->Name(WER, 1)+" macht es sich auf einer Bank "
  +"gemuetlich."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  bank += ({ capitalize(getuid(TP)) });
  return 1;
}

//von Bank aufstehen:
int aufstehen(string str)
{
  notify_fail("Was moechtest Du tun?\n");

  if(!str || str == "") return 0;

  if(!(str == "von bank auf" ||
       str == "auf")) return 0;

  if(BANK(TP))
  {
        write(BS("Du erhebst Dich frisch und ausgeruht wieder von der "
        +"Bank."));

        TO->Message(BS(TP->Name(WER, 1)+" steht von der Bank auf."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  }
  else
  {
        write(BS("Aber Du sitzt doch gar nicht auf der Bank!"));
        return -1;
  }

  bank -= ({ capitalize(getuid(TP)) });
  return 1;
}

//Test beim Verlassen des Raumes, ob man auf der Bank sitzt
int exit_test(string dir)
{
  if(BANK(TP))
  {
    write(BS("Dazu solltest Du erstmal von der Bank aufstehen."));
    return 0;
  }
  return 1;
}

//Spieler logt aus waehrend des auf der Bank Sitzens
void BecomesNetDead(object spieler)
{
  if(BANK(spieler))
  bank -= ({ capitalize(getuid(spieler)) });
}

//Spieler stirbt waehrend des Sitzens
void NotifyPlayerDeath(object spieler, object killer, int lost_xp)
{
  if(BANK(spieler))
  bank -= ({ capitalize(getuid(spieler)) });
}
