  AddDetail( ({ "kraft", "hilfe" }),
    "Ganz alleine und ohne jegliche Hilfe.");

  AddDetail( ({ "machtsymbol", "symbol", "macht" }),
    "Dieses Zepter stellt ein nicht zu unterschaetzendes Machtsymbol dar.");

  AddDetail( ({ "schnitzereien", "schnitzerei" }),
    "Herrliche Schnitzereien verzieren das Zepter.");

  AddSound( DEFAULT_SOUND,
    "Angenehme Stille umgibt Dich von allen Seiten.");

  AddSound( ({ "stille" }),
    "Es ist sehr ruhig hier.");

  AddSound( ({ "seiten" }),
    "Du bist umzingelt. ;)");

  AddSmell( DEFAULT_SMELL,
    "Ein leichter Blumenduft zieht durch den Gang.");

  AddSmell( ({ "blumenduft", "duft", "blumen", "blume" }),
