  AddDetail( ({ "norden" }),
    "Im Norden fuehrt der Gang noch weiter in den Palast hinein.");

  AddDetail( ({ "sueden" }),
    "Im Sueden kommst Du zurueck in die Mitte des Palastes.");

  AddDetail( ({ "palast" }),
    "Du laeufst in den weiten Gaengen des Palastes umher.");

  AddDetail( ({ "palastmitte", "mitte", "mittelpunkt" }),
    "Der Brunnen bildet den Mittelpunkt des Palastes.");

  AddDetail( ({ "brunnen" }),
    "Der befindet sich im Sueden.");

  AddDetail( ({ "gaenge" }),
    "Zahlreiche Gaenge wie dieser fuehren Dich durch den gesamten Palast.");

  AddDetail( ({ "waende" }),
    "Die Waende sind ueber und ueber mit Perlmutt und glitzernden "
    "Edelsteinen verziert. An der Ostwand siehst Du ein grosses Zepter "
    "haengen.");

  AddDetail( ({ "perlmutt" }),
    "Glaenzendes und schimmerndes Perlmutt ueberzieht die Waende.");

  AddDetail( ({ "edelsteine", "edelstein" }),
    "Viele glitzernde Edelsteine sind in Form von Mosaiken an den Waenden "
