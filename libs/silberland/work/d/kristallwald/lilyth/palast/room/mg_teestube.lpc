  AddDetail( ({ "geraeusch", "geraeusche" }),
    "Jeder Schritt wird von den dicken Teppichen stark gedaempft.");

  AddDetail( ({ "schritt", "schritte" }),
    "Du kannst Deine eigenen Schritte nicht hoeren.");

  AddDetail( ({ "muster" }),
    "Lauter bunte Muster sind auf den Teppichen zu sehen. Abgesehen davon, "
