  AddDetail( ({ "marmor" }),
    "Der Marmor ist blau.");

  AddDetail( ({ "faeden", "faden", "goldfaeden", "goldfaden" }),
    "Goldene Faeden ziehen sich durch den Marmor. Sie glaenzen hell im "
    "flackernden Lichtschein des Feuers.");

  AddDetail( ({ "kamin" }),
    "In eine Wand wurde ein steinerner Kamin eingelassen. Ein kleines "
    "Feuer brennt darin.");

  AddDetail( ({ "stein", "steine" }),
    "Der Kamin besteht aus einem dunklen, leicht blaeulichen Stein.");

  AddDetail( ({ "feuer" }),
    "Das Feuer prasselt lustig vor sich hin und fuellt den Raum mit seinem "
    "flackernden, gedaempften Licht.");

  AddDetail( ({ "boden" }),
    "Du kannst nicht erkennen, woraus der Boden besteht, denn er ist "
