string strdiener(string str)
{
  string s;
  s = "";

  if(TP->QueryProp(P_GUILD) == "dunkelelfen")
  {
     if(this_player()->QueryProp(P_GENDER) == MALE && str == "diener")
     {
      	 s = "Du bist ein Diener Lloths.";
     }
     if(this_player()->QueryProp(P_GENDER) == FEMALE && str == "dienerin")
     {
  	 s = "Du bist eine Dienerin Lloths.";
     }
  }
  else
  {
     s = "Sowas siehst Du da nicht";
  }

  return BS(s);
}

string strlloth(string str)
{
  string s;
  s = "";

  if(TP->QueryProp(P_GUILD) == "dunkelelfen")
  {
        s = "Lloth ist allmaechtig!";
  }
  else
  {
        s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

string strsessel(string str)
{
  string s;
  s = "";

  if(SESSEL(TP))
  {
  	sessel -= ({ capitalize(getuid(TP)) });

  	if(sizeof(sessel) == 0)
  	{
  	        s = "Du hast es Dir in einem der Sessel gemuetlich gemacht.";
  	}
  	if(sizeof(sessel) == 1)
  	{
  	        s = sessel[0]+" und Du sitzt gemuetlich in den Sesseln "
  	        +"herum.";
  	}
  	if(sizeof(sessel) > 1)
  	{
  	        s = ""+MyCountUp(sessel)+" haben es sich, ebenso wie Du, in "
  	        +"den Sesseln gemuetlich gemacht.";
  	}

  	sessel += ({ capitalize(getuid(TP)) });
   }
   else
   {
  	if(sizeof(sessel) == 1)
  	{
  	        s = sessel[0]+" hat es sich in einem der Sessel gemuetlich "
  	        +"gemacht.";
  	}
  	if(sizeof(sessel) > 1)
  	{
  	        s = ""+MyCountUp(sessel)+" haben es sich in den Sesseln "
  	        +"gemuetlich gemacht.";
  	}
   }
   return BS("Es stehen mehrere Sessel um die runden Tische herum. Ein paar "
   +"von ihnen sehen sehr gross und schwer aus, andere dagegen sind klein "
   +"und zierlich, einige sind dick gepolstert und andere wiederum sehr "
   +"schlicht und einfach ausgestattet. Es scheint fuer jeden Geschmack "
   +"etwas dabei zu sein. "+s);
}

string strsofa(string str)
{
  string s;
  s = "";

  if(SOFA(TP))
  {
  	sofa -= ({ capitalize(getuid(TP)) });

  	if(sizeof(sofa) == 0)
  	{
  	        s = "Du sitzt gemuetlich auf einem der Sofas.";
  	}
  	if(sizeof(sofa) == 1)
  	{
  	        s = sessel[0]+" und Du sitzt gemuetlich auf einem der Sofas.";
  	}
  	if(sizeof(sofa) > 1)
  	{
  	        s = ""+MyCountUp(sofa)+" sitzen gemuetlich neben Dir auf "
  	        +"einem der Sofas.";
  	}

  	sofa += ({ capitalize(getuid(TP)) });
   }
   else
   {
  	if(sizeof(sofa) == 1)
  	{
  	        s = sofa[0]+" hat es sich auf einem der Sofas gemuetlich "
  	        +"gemacht.";
  	}
  	if(sizeof(sofa) > 1)
  	{
  	        s = ""+MyCountUp(sofa)+" haben es sich auf einem der Sofas "
  	        +"gemuetlich gemacht.";
  	}
   }
   return BS("Einige mit weichen Kissen ausgepolsterte und sehr bequem "
   +"aussehende Sofas stehen an den Waenden. Viele von ihnen sind bereits "
   +"von den anderen Besuchern besetzt. "+s);
}

//--Funktionen fuer Menue--------------------------------------------------

//Pfefferminztee enttaubt:
taub(object zahler, object trinker)
{
   if(trinker->QueryProp(P_DEAF) != 0)
   {
      tell_object(trinker, BS(
      "Du bekommst einen heissen Pfefferminztee vorgesetzt und "
      "trinkst vorsichtig ein paar Schlucke. Ploetzlich kannst Du die "
      "Geraeusche in Deiner Umgebung wieder viel deutlicher wahrnehmen.\n" ));
      Message(BS(trinker->Name(WER)+" bestellt sich einen heissen "
      +"Pfefferminztee.\n"),
      MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ trinker })]));
      trinker->SetProp(P_DEAF, 0);
   }
   else
   {
      tell_object(trinker, BS(
      "Du bekommst einen heissen Pfefferminztee vorgesetzt.\nVorsichtig "
      "schluerfst Du an dem heissen Getraenk, um Dir nicht den Mund zu "
      "verbrennen.\n" ));
      Message(BS(trinker->Name(WER)+" bestellt sich einen heissen "
      +"Pfefferminztee.\n"),
      MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ trinker })]));
   }
}

//Zitronentee entblindet:
blind(object zahler, object trinker)
{
   if(trinker->QueryProp(P_BLIND) != 0)
   {
      tell_object(trinker, BS(
      "Du bestellst Dir einen heissen Zitronentee. Hmm, schmeckt "
      "eigentlich gar nicht mal so schlecht, wenn auch ein wenig "
      "saeuerlich.\nPloetzlich kannst Du wieder etwas sehen!\n" ));
      Message(BS(trinker->Name(WER)+" bestellt sich eine kleine Tasse "
      +"Zitronentee und verzieht beim Trinken ein wenig das Gesicht.\n"),
      MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ trinker })]));
      trinker->SetProp(P_BLIND, 0);
   }
   else
   {
      tell_object(trinker, BS(
      "Du bestellst Dir einen heissen Zitronentee. Hmm, schmeckt "
      "eigentlich gar nicht mal so schlecht, wenn auch ein wenig "
      "saeuerlich.\n" ));
      Message(BS(trinker->Name(WER)+" bestellt sich eine kleine Tasse "
      +"Zitronentee und verzieht beim Trinken ein wenig das Gesicht.\n"),
      MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ trinker })]));
   }
}

//Kamillentee entfroscht:
frosch(object zahler, object trinker)
{
   if(trinker->QueryProp(P_FROG) == 1)
   {
      tell_object(trinker, BS(
      "Genuesslich trinkst Du einen heissen, mit viel Zucker gesuessten "
      "Kamillentee.\nPloetzlich merkst Du, dass sich irgendetwas veraendert "
      "hat.\n" ));
      Message(BS(trinker->Name(WER)+" trinkt einen heissen Kamillentee und "
      +"scheint sich ploetzlich irgendwie zu veraendern.\n"),
      MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ trinker })]));
      trinker->SetProp(P_FROG, 0);
   }
   else
   {
      tell_object(trinker, BS(
      "Genuesslich trinkst Du einen heissen, mit viel Zucker gesuessten "
      "Kamillentee.\n" ));
      Message(BS(trinker->Name(WER)+" trinkt einen heissen Kamillentee.\n"),
      MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ trinker })]));
   }
}

//Kraeutertee entgiftet:
gift(object zahler, object trinker)
{
   if(trinker->QueryProp(P_POISON) > 0)
   {
      tell_object(trinker, BS(
      "Du bestellst Dir einen heissen Kraeutertee.\nSchon nach wenigen "
      "Schlucken fuehlst Du Dich auf einmal wieder putzmunter.\n" ));
      Message(BS(trinker->Name(WER)+" bekommt eine grosse Tasse mit einem "
      +"dampfenden Getraenk darin vorgesetzt.\nDer Duft von frischen "
      +"Kraeutern dringt an Deine Nase.\n"),
      MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ trinker })]));
      trinker->AddPoison(-1 - random(3));
   }
   else
   {
      tell_object(trinker, BS(
      "Du bestellst Dir einen heissen Kraeutertee.\nHmm, der schmeckt "
      "aber gesund!\n" ));
      Message(BS(trinker->Name(WER)+" bekommt eine grosse Tasse mit einem "
      +"dampfenden Getraenk darin vorgesetzt.\nDer Duft von frischen "
      +"Kraeutern dringt an Deine Nase.\n"),
      MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ trinker })]));
   }
}

//--Funktionen-------------------------------------------------------------

//auf Sessel oder Sofa sitzen:
int sitzen(string str)
{
  notify_fail("Wo moechtest Du Dich hinsetzen?\n");

  if(!str || str == "") return 0;

  if(str == "auf sessel" ||
     str == "in sessel")
  {
        if(SESSEL(TP))
        {
            write(BS("Du sitzt doch bereits in einem der Sessel!"));
            return -1;
        }

        if(sizeof(sessel) > 4)
        {
            write(BS("Die Sessel sind leider schon alle besetzt."));

            TO->Message(BS(TP->Name(WER, 1)+" schaut sich nach einem freien "
            +"Platz um."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
            return -1;
        }

        if(TP->QueryProp(P_RACE) == "Elf" ||
           TP->QueryProp(P_RACE) == "Dunkelelf")
        {
            write(BS("Anmutig laesst Du Dich in einen grossen, weichen "
            +"Sessel sinken."));

            TO->Message(BS(TP->Name(WER, 1)+" laesst sich anmutig in einen "
            +"grossen, weichen Sessel sinken."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        }

        if(TP->QueryProp(P_RACE) == "Troll" ||
           TP->QueryProp(P_RACE) == "Oger")
        {
            write(BS("Etwas schwerfaellig laesst Du Dich auf einem der "
            +"grossen Sessel nieder."));

            TO->Message(BS(TP->Name(WER, 1)+" laesst sich etwas "
            +"schwerfaellig auf einem der grossen Sessel nieder."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        }

        if(TP->QueryProp(P_RACE) == "Hobbit")
        {
            write(BS("Du suchst Dir einen kleinen, weich gepolsterten "
            +"Sessel aus und macht es Dir darauf gemuetlich."));

            TO->Message(BS(TP->Name(WER, 1)+" macht es sich in einem "
            +"kleinen, weich gepolsterten Sessel gemuetlich."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        }

        if(TP->QueryProp(P_RACE) == "Fee")
        {
            write(BS("Waehlerisch flatterst Du eine Weile herum, bis Du "
            +"einen winzigen freien Sessel erspaehst, und laesst Dich dann "
            +"entspannt darauf nieder."));

            TO->Message(BS(TP->Name(WER, 1)+" flattert eine Weile suchend "
            +"herum und laesst sich dann auf einem winzigen kleinen Sessel "
            +"nieder."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        }

        if(TP->QueryProp(P_RACE) == "Zwerg")
        {
            write(BS("Du suchst Du Dir einen einfachen, kleinen Sessel "
            +"aus und laesst Dich darauf nieder."));

            TO->Message(BS(TP->Name(WER, 1)+" laesst sich auf einem der "
            +"kleineren Sessel nieder."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        }

        if(TP->QueryProp(P_RACE) == "Mensch")
        {
            write(BS("Du suchst Du Dir einen noch freien Sessel "
            +"und laesst Dich darauf nieder."));

            TO->Message(BS(TP->Name(WER, 1)+" laesst sich auf einem der "
            +"noch freien Sessel nieder."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        }

        if(TP->QueryProp(P_RACE) == "Untoter")
        {
            write(BS("Du manovrierst Deine klapprigen Knochen in einen "
            +"sehr bequem aussehenden Sessel."));

            TO->Message(BS(TP->Name(WER, 1)+" laesst sich mit klappernden "
            +"Knochen in einen weichen Sessel sinken."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        }

        if(TP->QueryProp(P_RACE) == "Magier")
        {
            write(BS("Mit absolutem Kennerblick suchst Du Dir den "
            +"schoensten und bequemsten Sessel heraus, schubst den Zwerg, "
            +"der dort gerade sass, unsanft herunter und machst es Dir dann "
            +"selbst darauf gemuetlich."));

            TO->Message(break_string(TP->Name(WER, 1)+" schubst einen "
            +"Zwerg von seinem Sessel herunter und macht es sich dann "
            +"dort gemuetlich.\nDu denkst   . o O (Immer diese "
            +"unverschaemten Magier.)", 78,0,1),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
       }

        sessel += ({ capitalize(getuid(TP)) });
        return 1;
  }

  if(str == "auf sofa")
  {
        if(SOFA(TP))
        {
                write(BS("Du sitzt doch bereits auf einem der Sofas!"));
                return -1;
        }
        if(sizeof(sofa) > 4)
        {
                write(BS("Die Sofas sind leider schon alle besetzt."));
                return -1;
        }

        write(BS("Du machst es Dir auf einem der Sofas gemuetlich."));

        TO->Message(BS(TP->Name(WER, 1)+" macht es sich auf einem der "
        +"Sofas gemuetlich."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        sofa += ({ capitalize(getuid(TP)) });
        return 1;
  }

  return 0;
}

//aufstehen:
int aufstehen(string str)
{
  notify_fail("Von wo moechtest Du aufstehen?\n");

  if(!str || str == "")
  {
     write(BS("Von wo moechtest Du aufstehen?"));
     return -1;
  }

  if(str == "von sessel auf")
  {
     if(SESSEL(TP))
     {
        write(BS("Mit einigem Bedauern erhebst Du Dich muehsam "
        +"aus dem Sessel. Dabei war es gerade so gemuetlich."));

        TO->Message(BS(TP->Name(WER, 1)+" erhebt sich von einem der "
        +"Sessel."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        sessel -= ({ capitalize(getuid(TP)) });
        return 1;
     }
     else
     {
        write(BS("Aber Du sitzt doch gar nicht in einem der Sessel!"));
        return -1;
     }
  }

  if(str == "von sofa auf")
  {
     if(SOFA(TP))
     {
        write(BS("Mit einigem Bedauern erhebst Du Dich muehsam "
        +"von dem Sofa. Dabei war es gerade so gemuetlich."));

        TO->Message(BS(TP->Name(WER, 1)+" erhebt sich von einem der "
        +"Sofas."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        sofa -= ({ capitalize(getuid(TP)) });
        return 1;
     }
     else
     {
        write(BS("Aber Du sitzt doch gar nicht auf einem der Sofas!"));
        return -1;
     }
  }

  if(str == "auf")
  {
     if(SESSEL(TP))
     {
        write(BS("Mit einigem Bedauern erhebst Du Dich muehsam "
        +"aus dem Sessel. Dabei war es gerade so gemuetlich."));

        TO->Message(BS(TP->Name(WER, 1)+" erhebt sich von einem der "
        +"Sessel."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        sessel -= ({ capitalize(getuid(TP)) });
        return 1;
     }

     if(SOFA(TP))
     {
        write(BS("Mit einigem Bedauern erhebst Du Dich muehsam "
        +"von dem Sofa. Dabei war es gerade so gemuetlich."));

        TO->Message(BS(TP->Name(WER, 1)+" erhebt sich von einem der "
        +"Sofas."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        sofa -= ({ capitalize(getuid(TP)) });
        return 1;
     }

     write(BS("Aber Du sitzt doch gar nicht!"));
     return -1;
  }
  return -1;
}

//Test beim Verlassen des Raumes, ob man auf Sessel oder Sofa sitzt
int exit_test(string dir)
{
        if(SOFA(TP) || SESSEL(TP))
        {
                write(BS("Dazu solltest Du erstmal aufstehen."));
                return 0;
        }

        return 1;
}

//Spieler logt aus waehrend des Sitzens
void BecomesNetDead(object spieler)
{
  if(SESSEL(spieler))
  {
        sessel -= ({ capitalize(getuid(spieler)) });
  }
  if(SOFA(spieler))
  {
        sofa -= ({ capitalize(getuid(spieler)) });
  }
  return;
}

//Spieler stirbt waehrend des Sitzens
void NotifyPlayerDeath(object spieler, object killer, int lost_xp)
{
  if(SESSEL(spieler))
  {
        sessel -= ({ capitalize(getuid(spieler)) });
  }
  if(SOFA(spieler))
  {
        sofa -= ({ capitalize(getuid(spieler)) });
  }
  return;
}

//Kerzen loeschen:
int loeschen(string str)
{
  notify_fail("Was moechtest Du loeschen?\n");

  if(!str || str == "") return 0;

  if(!(str == "kerze" ||
       str == "kerze aus" ||
       str == "kerzen" ||
       str == "kerzen aus")) return 0;

        write(BS("Du versuchst, eine der Kerzen auszupusten, doch "
        +"sie flackert nur leicht und leuchtet dann voellig unbeirrt "
        +"weiter."));

        TO->Message(BS(TP->Name(WER, 1)+" versucht, eine der Kerzen "
        +"auszupusten, schafft es aber nicht."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        return 1;
}

void reset()
{
        laden::reset();
        pub::reset();
}

//Kein verkaufen hier:
int sell(string str, int f)
{
  string prefix;

  if (!prefix=CheckKeeper(2)) return 0;

  write(capitalize(QueryProp(P_SHOPKEEPER_NAME))+
       " sagt bedauernd: Es tut mir leid, aber wir kaufen nichts.\n");
  return -1;
}

int bestelle(string str)
{
  int i, val, j;
  object k, ob, store;
  string prefix, dummy;


  // Im Kampf kann man nichts kaufen, essen oder trinken
  if (this_player()->InFight()) {
    write(BS("Dazu bist Du im Moment viel zu beschaeftigt."));
    return 1;
  }

  _notify_fail("Was willst Du kaufen oder bestellen?\n");
  if (!str || str=="") return 0;

  // Wenn Kellnerin nicht da, kein kaufen oder bestellen
  if (!CheckKeeper(this_player())) return -1;

  if (k=present(QueryProp(P_PUBKEEPER_ID)))
    prefix=k->Name()+" sagt: ";
  else
    prefix=capitalize(QueryProp(P_PUBKEEPER_NAME))+" sagt: ";
    _notify_fail(break_string("Tut mir leid, "
    +(str ? capitalize(str) : "das")+" haben wir nicht im Angebot.",
      78, prefix));

   j = search_what(str,this_player(),this_player());

  if(j) return j; // Getraenk oder Essen gefunden

/*----------------------------------------------------------------------------*/
/* Nur noch verkaufen des Ladens                                              */

  // Objekt suchen im Lagerraum
  if (sscanf(str,"%d%s",i,dummy)>0 && i>0)
  {
    if ((dummy==" ab") || (dummy==""))
      ob=FindInStore(i);
    else
      ob=FindInStore(str);
  }
  else
    ob=FindInStore(str);

  if (!ob)
    return 0;

  // Geld pruefen
  val=QueryBuyValue(ob);
  if ((i=this_player()->QueryMoney()) < val) {
    write(break_string(ob->Name(WER,1)+" wuerde"+
        (ob->IsPlural() ? "n " : " ")+val+" Muenze"+
        (val==1 ? "" : "n")+" kosten, Du "+
        (i ? "hast aber nur "+i+"."
           : "bist aber voellig pleite!"),
        78, prefix));
    return 1;
  }

  // Geldtransfer
  this_player()->AddMoney(-val);
  mymoney += val;

  // fixed object? (staendig verfuegbar)
  if (stringp(ob))
    ob=clone_object((string) ob);

  // Kaufen und als behalten markieren
  write("Du kaufst " + ob->name(WEN,1) + ".\n");
  say(this_player()->Name() + " kauft " + ob->name(WEN) + ".\n");
  ob->SetProp(P_KEEP_ON_SELL, getuid(this_player()));

  // Kanns der Spieler tragen?
  if (ob->move(this_player(),M_GET) <= 0)
  {
    write(prefix + "Du kannst " + ob->QueryPronoun(WEN) +
        " nicht mehr tragen!\n");
    ob->move(environment(this_player()));       // Objekt in den Raum moven
  }
  UpdateCounter(ob,-1);
  return 1;
}
