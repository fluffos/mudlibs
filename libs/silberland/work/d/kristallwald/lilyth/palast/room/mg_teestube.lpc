  AddDetail( ({ "zehenspitzen" }),
    "Langsam fangen sie an, zu schmerzen.");

  AddDetail( ({ "platz" }),
    "Beeil Dich lieber, bevor ihn Dir jemand vor der Nase wegschnappt.");

  AddDetail( ({ "nase" }),
    "Das war nicht woertlich gemeint.");

  AddDetail( ({ "palast" }),
    "Du befindest Dich immer noch im Palast.");

  AddDetail( ({ "wand" }),
    "In eine der Waende wurde ein grosser Kamin eingelassen.");

  AddDetail( ({ "waende" }),
    "Wie Du schon fast erwartet hast, bestehen auch hier die Waende aus "
