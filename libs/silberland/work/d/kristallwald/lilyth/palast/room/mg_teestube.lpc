#include "../def.h"
#include <laden.h>
#include <pub.h>
#include <routingd.h>

inherit "std/laden";
inherit "std/pub";

#define MAX_ANZ 3       /* Max 3 Objekte einer Sorte im Laden */
#define BUY_FACT 300    /* Objekte kosten BUY_FACT mal P_VALUE / 100 */
#define MAX_SELL_OBS 40 /* Max 40 Objekte auf einmal verkaufen */
#define EVAL_LIMIT 100000  /* eval darf dabei nicht unter 100000 sinken */

//--Variablen&Defines------------------------------------------------------

#define MyCountUp(arg) (sizeof(arg) > 1 ? \
    implode(arg[0..<2], ", ") + " und " + arg[<1] : \
    (sizeof(arg) == 0 ? "niemand" : arg[0]) )

#define SESSEL(wer) (member(sessel, capitalize(getuid(wer)))!=-1)
string *sessel=({});

#define SOFA(wer) (member(sofa, capitalize(getuid(wer)))!=-1)
string *sofa=({});

//--Create-----------------------------------------------------------------

void create()
{
  object router;

  pub::create();

  _set_shop_percent_left();
  last=wantto=mymoney=50000;
  buyfact=BUY_FACT;

  AddCmd(({"zeig","zeige"}),"list");
  AddCmd(({"verkauf","verkaufe"}),"sell");
  AddCmd(({"versetz","versetze"}),"force_sell");
  AddCmd(({"schaetz","schaetze"}),"evaluate");
  AddCmd(({"untersuche","unt"}), "show_obj");
  AddItem("/obj/entsorg",REFRESH_REMOVE);

  ob_anz = ([]);
  fixed_obj = ({ });
  fixed_value = ([ ]);
  fixed_ids = ([ ]);

  if (!is_clone(this_object()) && objectp(router=find_object(ROUTER)))
    router->RegisterTarget(TARGET_SHOP,file_name(this_object()));

//--Initialisierungen------------------------------------------------------

  RemoveItem("/obj/entsorg");
  RemoveItem("/obj/topliste");

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einer gemuetlichen Teestube");
  SetProp(P_INT_LONG,
    "Nachdem sich Deine Augen an das leicht gedaempfte Licht gewoehnt "
    "haben, schaust Du Dich neugierig in der Teestube um. Ueberall im Raum "
    "stehen mehrere Sessel und kleine Sofas um runde Tische "
    "herum. Einige von ihnen sind bereits von Besuchern des Palastes "
    "besetzt, die sich leise miteinander unterhalten. An einer Wand siehst "
    "Du einen grossen Kamin, in dem ein kleines Feuer lustig vor sich "
    "hinprasselt.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

//--Ladeneigenschaften-----------------------------------------------------

  SetProp(P_SHOPKEEPER_ID, "kellnerin");
  SetProp(P_SHOPKEEPER_NAME, "Die junge Kellnerin");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetStorageRoom(ROOM "mg_lagerraum_teestube" );

//--Pubeigenschaften-------------------------------------------------------

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "kellnerin");
  SetProp(P_PUBKEEPER_NAME, "Kellnerin");
  SetProp(P_PUBMSG_NOKEEPER, "Es ist leider niemand da, der Dich bedienen "
  +"koennte.\n");
  SetProp(P_PUBMSG_NOENEMY, BS("Du glaubst doch nicht, dass Dich die "
  +"Kellnerin jetzt noch bedient?!"));
  SetProp(P_PUBMSG_NOINVITE, BS("Die junge Kellnerin ist gerade in einen "
  +"Kampf verwickelt!"));
  SetProp(P_PUBMSG_FIGHTING, "Die junge Kellnerin ist gerade in einen Kampf "
  +"verwickelt!\n");

//--Details----------------------------------------------------------------

  AddDetail( ({ "augen", "auge" }),
    "Deine Augen brauchen einen kleinen Moment, um sich das das flackernde "
    "Licht zu gewoehnen.");

  AddDetail( ({ "moment" }),
    "Langsam gewoehnen sich Deine Augen an das Licht.");

  AddDetail( ({ "licht" }),
    "Die einzige Lichtquelle hier im Raum ist das kleine Feuer, das "
    "im Kamin brennt. Ausserdem sind auf den Tischen ein paar Kerzen "
    "verteilt worden.");

  AddDetail( ({ "lichtschein" }),
    "Das Feuer fuellt den Raum mit seinem flackernden Licht.");

  AddDetail( ({ "lichtquelle", "lichtquellen", "quelle", "quellen" }),
  ([ 0: "Das Feuer spendet gerade genuegend Licht, um alles halbwegs "
  "deutlich erkennen zu koennen.",
  "dunkelelf": "Am liebsten waere es Dir ja, wenn auch diese Lichtquelle "
  "nicht vorhanden waere, aber da Du heute in gnaediger Stimmung bist, "
  "versuchst Du, das Feuer so gut wie moeglich zu ignorieren." ]) );

  AddDetail( ({ "stimmung" }),
  ([ 0: "Sowas siehst Du da nicht!",
  "dunkelelf": "Du willst die anderen Palastbesucher (ausnahmsweise "
  "einmal) nicht veraergern." ]) );

  AddDetail( ({ "kerzen", "kerze" }),
    "Auf den Tischen stehen kleine blaue Kerzen in silbernen Haltern. "
    "Sie scheinen irgendwie magisch zu sein, denn ihre Flammen "
    "leuchten in einem merkwuerdig glimmenden Blau.");

  AddDetail( ({ "flammen", "flamme", "kerzenflammen", "kerzenflamme" }),
    "Blaeulich glimmende Flammen sind an den Kerzen zu sehen. Sie sehen "
    "so aus, als wuerden sie immerzu leuchten.");

  AddDetail( ({ "blau" }),
    "Die Kerzenflammen glimmen in einem seltsamen Blau. Da scheint Magie "
    "im Spiel zu sein.");

  AddDetail( ({ "magie" }),
    "Na, Du weisst schon, dieses Hokuspukus-Zeugs.");

  AddDetail( ({ "spiel" }),
    "Hier ist eindeutig Magie im Spiel.");

  AddDetail( ({ "halter", "kerzenhalter" }),
    "Flache, versilberte Kerzenhalter stehen auf den Tischen. In jedem "
    "von ihnen steckt eine kleine blaue Kerze.");

  AddDetail( ({ "raum" }),
    "Du befindest Dich in einer gemuetlichen Teestube.");

  AddDetail( ({ "teestube", "stube" }),
    "Wie Du bereits auf dem Schild draussen vor dem Eingang lesen konntest, "
    "handelt es sich bei diesem Raum um eine Teestube. Daher verwundert "
    "es Dich nicht sonderlich, dass viele der Besucher hier Teetassen und "
    "Teekaennchen vor sich auf dem Tisch stehen haben.");

  AddDetail( ({ "schild" }),
    "Hast Du es nicht gesehen?");

  AddDetail( ({ "eingang" }),
    "Der Eingang zur Teestube befindet sich nun oestlich von Dir. Auch "
    "wenn er jetzt eher einen Ausgang darstellt.");

  AddDetail( ({ "ausgang" }),
    "Da Du Dich bereits in der Teestube befindest, ist es kein Eingang "
    "mehr, sondern ein Ausgang.");

  AddDetail( ({ "teetassen", "teetasse", "tassen", "tasse" }),
    "Der Grossteil der Besucher, die Du hier siehst, trinken Tee aus "
    "kleinen, zierlichen Teetassen.");

  AddDetail( ({ "grossteil" }),
    "Die Mehrzahl der Besucher.");

  AddDetail( ({ "mehrzahl" }),
    "Die meisten von ihnen.");

  AddDetail( ({ "einzahl" }),
    "Du kannst wohl nie genug kriegen, oder?");

  AddDetail( ({ "tee" }),
    "Auch Du bekommst so richtig Lust auf eine schoene, heisse Tasse "
    "Tee.");

  AddDetail( ({ "lust" }),
    "Mach es Dir doch einfach irgendwo gemuetlich und bestell Dir "
    "einen Tee.");

  AddDetail( ({ "teekaennchen", "kaennchen", "teekannen", "teekanne",
  "grosse teekaennchen", "kleine teekaennchen" }),
    "Grosse und kleine Teekaennchen stehen ueberall auf den Tischen.");

  AddDetail( ({ "tische", "tisch" }),
    "Mehrere runde Tische stehen im ganzen Raum verteilt. Auf jedem von "
    "ihnen siehst Du eine kleine, blaue Kerze, eine Karte sowie ein "
    "kleines, weisses Taefelchen stehen.");

  AddDetail( ({ "karte" }),
    "Dies scheint die Teekarte zu sein. Du kannst sie lesen.");

  AddDetail( ({ "teekarte", "teekarten", "karten" }),
    "Auf jedem der Tische liegt eine Teekarte.");

  AddDetail( ({ "taefelchen", "tafel" }),
    "Auf den Taefelchen steht etwas geschrieben.");

  AddDetail( ({ "besucher", "palastbesucher" }),
    "Wenn Du geglaubt hast, Du haettest diesen Raum fuer Dich alleine, hast "
