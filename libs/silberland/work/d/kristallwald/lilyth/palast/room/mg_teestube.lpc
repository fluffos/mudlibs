  AddSmell( ({ "duefte", "weihnachtsduefte", "nuesse", "nuss" }),
    "Du kannst es gar nicht abwarten, bis es endlich wieder soweit ist.");

  AddSmell( ({ "duft", "raum" }),
    "Der ganze Raum wird von allerlei suesslichen Dueften durchdrungen.");

  AddSmell( ({ "feuer", "russ" }),
    "Das Feuer im Kamin riecht etwas nach Feuer und Russ, jedoch nicht "
    "so stark, dass es unangenehm waere.");

  AddSpecialDetail( ({ "sessel" }),
    "strsessel");

  AddSpecialDetail( ({ "sofa", "sofas" }),
    "strsofa");

  AddSpecialDetail( ({ "hokuspokus", "zeugs", "hokuspokus-zeugs" }),
    "strhokuspokus");

  AddSpecialDetail( ({ "meister" }),
    "strmeister");

  AddSpecialDetail( ({ "kronang" }),
    "strkronang");

  AddSpecialDetail( ({ "dusty", "erleuchtung", "ehre" }),
    "strdusty");

  AddSpecialDetail( ({ "anvar", "gelegenheit" }),
    "stranvar");

  AddSpecialDetail( ({ "xarfai" }),
    "strxarfai");

  AddSpecialDetail( ({ "diener", "dienerin" }),
    "strdiener");

  AddSpecialDetail( ({ "lloth" }),
    "strlloth");

  AddSpecialDetail( ({ "sessel" }),
    "strsessel");

  AddSpecialDetail( ({ "sofa", "sofas" }),
    "strsofa");

  AddRoomMessage(
    ({ "Das Feuer knistert leise vor sich hin.\n",
       " *knack*\n",
       " *knister*\n" }), 100);

//--Menue------------------------------------------------------------------

  AddDrink("Fruechtetee", ({"fruechtetee"}),
    50, 10, 0, 3,
    ({"Du trinkst einen Fruechtetee und fuehlst Dich etwas gestaerkt.\n",
     "&& trinkt einen Fruechtetee und sieht etwas gestaerkt aus.\n"}));

  AddDrink("Pfefferminztee", ({"pfefferminztee"}),
    450, 5, 0, 4, "taub");

  AddDrink("Zitronentee", ({"zitronentee"}),
    500, 5, 0, 4, "blind");

  AddDrink("Kamillentee", ({"kamillentee"}),
    750, 5, 0, 4, "frosch");

  AddDrink("Kraeutertee", ({"kraeutertee"}),
    1500, 5, 0, 5, "gift");

  AddDrink("Weihnachtstee", ({"weihnachtstee"}),
    110, 18, 0, 6,
    ({"Die junge Kellnerin bringt Dir einen Weihnachtstee an den Tisch. "
      "Vorsichtig schluerfst Du das heisse, herrlich duftende Getraenk "
      "und schliesst dabei geniesserisch die Augen. Langsam breitet sich "
      "eine wohlige Waerme in Deinem ganzen Koerper aus.\n",
      "Die junge Kellnerin bringt && ein heisses, herrlich duftendes "
      "Getraenk an den Tisch.\n"
      "Ein weihnachtlicher Duft breitet sich langsam im Raum aus.\n"}));

//--Ausgaenge--------------------------------------------------------------

  AddExit ("osten", ([ EX_DEST: "./mg_gang4",
                       EX_TESTFUNC: "exit_test",
                       EX_MSG: "auf den Gang hinaus" ]) );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "sitz", "sitze", "setz", "setze" }), "sitzen" );
  AddCmd( ({ "steh", "stehe", "erheb", "erhebe" }), "aufstehen" );
  AddCmd( ({ "loesch", "loesche", "pust", "puste" }), "loeschen" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "kellnerin", REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer SpecialDetails-----------------------------------------

string strhokuspokus(string str)
{
  string s;
  s = "";

  switch(TP->QueryProp(P_GUILD))
  {
      case "abenteurer": s = "Du bist zwar kein Meister der Magie, "
        +"aber ein wenig verstehst Du schon davon.";
        break;
      case "berserker": s = "Hmm... falls Kronang jemals von so etwas "
        +"gesprochen hat, hast Du wohl gerade nicht zugehoert.";
        break;
      case "paladine": s = "Bete zu Dusty, und sie wird Dir "
        +"Erleuchtung bringen!";
        break;
      case "zechpreller": s = "Du hascht sicher schon mal davon "
        +"gehoert! *hicks*";
        break;
      case "druidenzirkel": s = "Ob Anvar Dir mehr darueber sagen kann?";
        break;
      case "nekromanten": s = "Xarfai weiss sicher mehr darueber.";
        break;
      case "dunkelelfen":
        if(TP->QueryProp(P_GENDER) == MALE)
        {
            s = "Du als ein Diener Lloths solltest wissen, was das ist.";
        }
        if(TP->QueryProp(P_GENDER) == FEMALE)
        {
            s = "Du als eine Dienerin Lloths solltest wissen, was das ist.";
        }
        break;
      default: s = "Kennst Du Dich damit aus?";
        break;
  }

  return BS(s);
}

string strmeister(string str)
{
  string s;
  s = "";

  if(TP->QueryProp(P_GUILD) == "abenteurer")
  {
        s = "Nein, ein Meister bist Du nicht gerade.";
  }
  else
  {
        s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

