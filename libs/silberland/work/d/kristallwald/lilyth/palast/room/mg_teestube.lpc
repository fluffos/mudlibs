  AddDetail( ({ "plaetzchen" }),
    "Hoffentlich ist noch eines fuer Dich frei.");

  AddDetail( ({ "sitzen" }),
    "Du stellst Dich auf Deine Zehenspitzen und spaehst aufmerksam durch "
