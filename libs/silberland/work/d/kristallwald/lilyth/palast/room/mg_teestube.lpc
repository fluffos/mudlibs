    "zu haben.");

  AddDetail( ({ "zweck", "zwecke" }),
    "Sie dienen nur zur Verzierung.");

  AddDetail( ({ "verzierung", "verzierungen" }),
    "Die Teppiche sind mit huebschen, bunten Mustern verziert.");

  AddDetail( ({ "decke" }),
    "Die Decke ist hier sehr niedrig, und verleiht dem Raum dadurch eine "
    "gemuetliche Atmosphaere.");

  AddDetail( ({ "atmosphaere" }),
    "Du beginnst langsam, Dich hier wohlzufuehlen.");

  AddDetail( ({ "geschmack" }),
    "Ist fuer Dich etwa nichts passendes dabei?");

  AddReadDetail( ({ "teekarte", "karte" }),
    "                  TEEKARTE\n\n"
    "*** Fruechtetee\n"
    "    Eine bunte Mischung verschiedenster Fruechte\n"
    "*** Zitronentee\n"
    "    Fuer den etwas anderen Geschmack\n"
    "*** Pfefferminztee\n"
    "    Schaerft die Sinne\n"
    "*** Kamillentee\n"
    "    Die pure Gesundheit (auch fuer Gruenhaeute)\n"
    "*** Kraeutertee\n"
    "    Eine Vielfalt frischer Kraeuter (sehr gesund)\n"
    "*** Weihnachtstee\n"
    "    Fuer die schoenste aller Jahreszeiten\n");

  AddReadDetail( ({ "taefelchen", "tafel" }),
    "                *** SONDERAKTION ***\n"
    "Geniessen Sie Ihren Tee auch zu Hause aus einem edlen Teeservice\n"
    "aus feinstem Porzellan! Heute besonders guenstig:\n"
    "Ein Service fuer drei Personen mit allem Drum und Dran!\n"
    "Kaufen und geniessen Sie!");

  AddSound( DEFAULT_SOUND,
    "Nur das leise Prasseln und Knacken des Feuers sowie die leisen "
    "Stimmen der Besucher um Dich herum sind zu hoeren.");

  AddSound( ({ "prasseln" }),
    "Das Feuer prasselt leise vor sich hin.");

  AddSound( ({ "feuer" }),
    "Es prasselt leise vor sich hin.");

  AddSound( ({ "knacken" }),
    "*knack*");

  AddSound( ({ "stimmen", "stimme" }),
    "Die leisen Stimmen der Besucher dringen zu Dir.");

  AddSound( ({ "besucher", "palastbesucher" }),
    "Die Besucher um Dich herum unterhalten sich leise.");

  AddSound( ({ "unterhaltung", "unterhaltungen" }),
    "Unauffaellig lehnst Du Dich ein wenig vor und lauschst den "
    "Unterhaltungen um Dich herum. Ploetzlich kannst Du ein paar "
    "undeutliche Worte aufschnappen.");

  AddSound( ({ "worte", "wort" }),
    "'... psst, sei mal leise! Ich glaube, da versucht jemand, uns zu "
    "belauschen ...'");

  AddSound( ({ "schritt", "schritte" }),
    "Du machst einen grossen Schritt und lauscht. Nichts.");

  AddSmell( DEFAULT_SMELL,
    "Ein herrlicher Duft nach allen nur denkbaren Teesorten schwebt im "
    "Raum. Ausserdem riecht es ein wenig nach Feuer.");

  AddSmell( ({ "teesorten", "tee", "sorten" }),
    "Haaach, Du kannst gar nicht soviel riechen, wie Du am liebsten "
    "wuerdest! Es duftet nach allerlei Kraeutern und Fruechten, nach "
    "Pfefferminz, Orange und Zitrone und sogar ein klein wenig nach Zimt. "
    "Herrlich!");

  AddSmell( ({ "kraeuter", "kraut" }),
    "Es riecht herrlich nach allerlei frischen Kraeutern.");

  AddSmell( ({ "fruechte", "frucht" }),
    "Du riechst den frischen, saftigen Duft von Orangen, Aepfeln und "
    "Zitronen.");

  AddSmell( ({ "pfefferminz", "pfefferminze", "pfefferminzgeruch" }),
    "Der leichte Pfefferminzgeruch ist nicht zu ueberriechen.");

  AddSmell( ({ "apfel", "aepfel", "orange", "orangen", "zitrone",
    "zitronen" }),
    "Ein frischer Duft nach Aepfeln, Orangen, Zitronen und zahlreichen "
    "anderen Fruechten liegt in der Luft.");

  AddSmell( ({ "luft", "gerueche", "geruch" }),
    "Zahlreiche Gerueche liegen in der Luft, einer herrlicher als der "
