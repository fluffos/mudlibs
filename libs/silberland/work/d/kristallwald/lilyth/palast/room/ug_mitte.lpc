//--Funktionen-------------------------------------------------------------

//Muenze in Brunnen werfen:
int werfen(string str)
{
  notify_fail("Was willst Du wo hineinwerfen?\n");

  if(!str || str == "") return 0;

  if(!(str == "muenze in brunnen" ||
       str == "muenze in becken" )) return 0;

  if(present("geld", TP))
  {
    write(BS("Hoffnungsvoll drehst Du Dich um und wirfst mit "
    +"geschlossenen Augen eine Muenze ueber Deine Schulter hinweg in "
    +"das Brunnenbecken. Jetzt hast Du bestimmt ganz viel Glueck!"));

    TO->Message(TP->Name(WER, 1)+" wirft eine Muenze in den Brunnen.\n",
    MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    TP->AddMoney(-1);
    return 1;
  }
  else
  {
    write(BS("Aber Du hast doch gar kein Geld bei Dir!\n"));
    return -1;
  }
}

//Wasser trinken:
int trinken(string str)
{
  notify_fail("Was moechtest Du woraus trinken?\n");

  if(!str || str == "") return 0;

  if(!(str == "wasser aus brunnen" ||
       str == "wasser" )) return 0;

  if(i < 3)
  {
    write(BS("Du beugst Dich ueber das Brunnenbecken und "
    +"schoepfst eine Handvoll des kristallklaren Wassers heraus. "
    +"Geniesserisch laesst Du es Deine trockene Kehle "
    +"hinabrinnen. Ahhh, tut das gut!"));

    TO->Message(BS(TP->Name(WER, 1)+" beugt sich ueber das "
    +"Brunnenbecken und trinkt ein wenig von dem frischen, "
    +"klaren Wasser."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    TP->AddHp(5+random(5));
    i++;
    return 1;
  }
  else
  {
    write(BS("Du beugst Dich ueber das Brunnenbecken und "
    +"schoepfst eine Handvoll des kristallklaren Wassers heraus. "
    +"Geniesserisch laesst Du es Deine trockene Kehle "
    +"hinabrinnen. Ahhh, das tut gut, auch wenn es Dich nicht "
    +"so sehr erfrischt."));

    TO->Message(BS(TP->Name(WER, 1)+" beugt sich ueber das "
    +"Brunnenbecken und trinkt ein wenig von dem frischen, "
    +"klaren Wasser.\n"), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return -1;
  }
}

void reset()
{
  i = 0;
  ::reset();
}

void gebet()
{
   object kobold;
   kobold = present("kobold", TO);

   if(kobold)
   {
      kobold->SetChats(10, ({ }));
      kobold->SetProp(P_NOATTACK, "herrscht Dich an: Stoere nicht das "
      +"Gebet!");

      TO->Message(break_string("Ploetzlich faengt der kleine Kobold an, "
      +"aufgeregt umherzuhuepfen und wie wild mit seinem Gloeckchen zu "
      +"laeuten...\n\n"
      +"                   *KLINGELING*\n\n", 78,0,1), MSGFLAG_VISUAL);

      call_out("seqgebet", 9, 1);
   }

   return;
}

//Hilfsfunktion fuers Filtern in der Sequenz
int filter_lebewesen(object ob)
{
  if(query_once_interactive(ob) && !find_netdead(getuid(ob))) return 1;
    // alle Spieler

  return 0;   // Rest wird aussortiert
}

void seqgebet(int pos)
{
  object kobold;
  object *inhalt;
  string s;
  kobold = present("kobold", TO);
  inhalt = all_inventory(TO); // Wer befindet sich alles im Raum
  inhalt = filter_array(inhalt, "filter_lebewesen"); // nur Spieler behalten

  if(!sizeof(inhalt))
  {
    if(kobold)
    {
        kobold->SetChats(3,
        ({kobold->Name(WER, 1)+" schaut angespannt auf die Uhr.\n",
          kobold->Name(WER, 1)+" raeuspert sich leise.\n",
          kobold->Name(WER, 1)+" scheint auf etwas zu warten.\n",
          kobold->Name(WER, 1)+" blickt sich nervoes um.\n",
          kobold->Name(WER, 1)+" macht einen unruhigen Eindruck.\n" }));

          kobold->SetProp(P_NOATTACK, 0);
    }
    return;
  }

  switch(pos)
  {
      case 1:
        s = "Von allen Seiten stroemen die Besucher des Palastes herbei "
        +"und versammeln sich um den Brunnen herum.\n\n";
        break;

      case 2:
        s = "Verwundert betrachtest Du die vielen Leute um Dich herum, "
        +"die sich erstaunlich leise verhalten und andaechtig auf den "
        +"Brunnen in ihrer Mitte blicken. Die meisten von ihnen "
        +"scheinen zu beten.\n\n";
        break;

      case 3:
        s = "Du denkst   . o O (Nun ja, ein kleines Gebet kann ja nicht "
        +"schaden...)\n\n";
        break;

      case 4:
        s = "Du schliesst Deine Augen und faengst ebenfalls leise an zu "
        +"beten.\n\n";
        break;

      case 5:
        s = "Du versenkst Dich voellig in Deine eigenen Gedanken und wirst "
        +"immer ruhiger und gelassener.\n\n";
        break;

      case 6:
        s = "Ein tiefes Gefuehl der Zufriedenheit ueberkommt Dich.\n\n";
        break;

      case 7:
        s = "Schliesslich oeffnest Du Deine Augen wieder und bemerkst, "
        +"dass sich die vielen Leute schon wieder verstreut haben "
        +"und nur Du noch ganz alleine vor dem Brunnen stehst.\n\n";
        break;

      default:
          if(kobold)
          {
            kobold->SetChats(3,
            ({kobold->Name(WER, 1)+" schaut angespannt auf die Uhr.\n",
              kobold->Name(WER, 1)+" raeuspert sich leise.\n",
              kobold->Name(WER, 1)+" scheint auf etwas zu warten.\n",
              kobold->Name(WER, 1)+" blickt sich nervoes um.\n",
              kobold->Name(WER, 1)+" macht einen unruhigen Eindruck.\n" }));

            kobold->SetProp(P_NOATTACK, 0);
          }
          return;
          break;
  }

  Message(break_string(s, 78, 0, BS_LEAVE_MY_LFS));
  pos = pos + 1;
  call_out("seqgebet", 9, pos);
}
