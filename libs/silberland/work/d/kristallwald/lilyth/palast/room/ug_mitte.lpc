#include "../def.h"
#include <ansi.h>

inherit "std/room";

//--Variablen&Defines------------------------------------------------------

int i;
void gebet();

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------

  i = 0;

