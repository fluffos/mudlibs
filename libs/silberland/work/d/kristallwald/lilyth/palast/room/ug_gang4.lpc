  AddSmell( ({ "gang" }),
    "Angenehme frische Luft erfuellt den Gang.");

  AddSmell( ({ "luft" }),
    "Der Gang ist von frischer Luft erfuellt.");

  AddSmell( ({ "blumenduft", "duft" }),
    "Er ist sehr angenehm.");

  AddSpecialDetail( ({ "edelstein" }),
