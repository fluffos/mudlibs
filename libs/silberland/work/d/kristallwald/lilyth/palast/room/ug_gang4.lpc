  AddDetail( ({ "wand" }),
    "Ein grosses Bild haengt an einer der Waende.");

  AddDetail( ({ "decke" }),
    "Die Decke besteht aus hellen weissen Steinen und ist leicht gewoelbt.");

  AddDetail( ({ "eingangshalle" }),
    "Die befindet sich irgendwo weiter suedlich von hier.");

  AddDetail( ({ "steine", "stein" }),
    "Die Decke besteht aus hellen weissen Steinen.");

  AddSound( DEFAULT_SOUND,
    "Angenehme Ruhe umgibt Dich.");

  AddSound( ({ "ruhe" }),
    "Du hoerst nur die Stille im Gang.");

  AddSound( ({ "stille" }),
    "\n");

  AddSound( ({ "gang" }),
    "Es ist wirklich sehr ruhig hier im Gang.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft hier im Gang ist angenehm frisch. Ausserdem kannst Du auch "
