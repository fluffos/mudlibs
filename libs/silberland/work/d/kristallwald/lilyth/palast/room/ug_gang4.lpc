//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "brich", "brech", "breche", "loes", "loese" }), "brechen" );
  AddCmd( ({ "sitz", "sitze", "setz", "setze" }), "sitzen" );
  AddCmd( ({ "steh", "stehe" }), "aufstehen" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer SpecialDetails-----------------------------------------

string stredelstein(string str)
{
  string s;

  if(edelstein == DA)
  {
  	s = "Tatsaechlich, der Edelstein hat sich irgendwie aus der Wand "
  	+"gelockert. Ein unerhoerter Gedanke schiesst Dir durch den Kopf "
  	+"und mit einem unbehaglichen Gefuehl verdraengst Du ihn schnell "
  	+"wieder.";
  }
  else
  {
  	s = "Hmm, Du hast Dich wohl doch geirrt. Der Edelstein sitzt "
  	+"genauso fest in der Wand wie die anderen.";
  }
  return BS(s);
}

string strgedanke(string str)
{
  string s;

  if(edelstein == DA)
  {
  	s = "Vielleicht koenntest Du ... hm, nein, so etwas tut man nicht. "
  	+"Wirklich nicht. Das ist voellig undenkbar.";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

string strkopf(string str)
{
  string s;

  if(edelstein == DA)
  {
  	s = "Nachdenklich runzelst Du die Stirn. Vielleicht, wenn es keiner "
        +"merken wuerde...";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

string strstirn(string str)
{
  string s;

  if(edelstein == DA)
  {
  	s = "Traust Du Dich oder traust Du Dich nicht?";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

string strgefuehl(string str)
{
  string s;

  if(edelstein == DA)
  {
  	s = "Nein, niemals wuerdest Du so etwas wagen.";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

string strbaenke(string str)
{
  string s;
  s = "";

  if(BANK(TP))
  {
  	bank -= ({ capitalize(getuid(TP)) });

  	if(sizeof(bank) == 0)
  	{
  	        s = "Du sitzt mutterseelenalleine auf einer der Baenke "
  	        +"herum.";
  	}
  	if(sizeof(bank) == 1)
  	{
  	        s = bank[0]+" und Du habt es euch auf einer der Baenke "
  	        +"gemuetlich gemacht.";
  	}
  	if(sizeof(bank) > 1)
  	{
  	        s = "Neben Dir sitzen "+MyCountUp(bank)+" auf den Baenken.";
  	}

  	bank += ({ capitalize(getuid(TP)) });
   }
   else
   {
  	if(sizeof(bank) == 1)
  	{
  	        s = bank[0]+" hat es sich auf einer der Baenke gemuetlich "
  	        +"gemacht.";
  	}
  	if(sizeof(bank) > 1)
  	{
  	        s = "Es sitzen "+MyCountUp(bank)+" auf der Bank.";
  	}
   }
   return BS("Zu beiden Seiten des Ganges stehen kleine huebsche Baenke "
   +"aus schimmerndem weissem Holz. Sie sind fuer die Besucher des Palastes "
   +"gedacht, die sich dort ausruhen oder auch einfach nur die Atmosphaere "
   +"des Palastes geniessen wollen. "+s);
}

//--Funktionen-------------------------------------------------------------

//Edelstein aus Wand brechen:
int brechen(string str)
{
  notify_fail("Was moechtest Du wo herausloesen oder -brechen?\n");

  if(!str || str == "") return 0;

  if(!(str == "edelstein aus wand" ||
       str == "edelstein aus wand heraus" ||
       str == "edelstein aus mosaik" ||
       str == "edelstein aus mosaik heraus")) return 0;

  if(edelstein == DA)
  {
    write(BS("Unauffaellig und mit einem sehr schlechten Gewissen "
    +"loest Du den Edelstein vorsichtig aus der Wand heraus und steckst "
    +"ihn schnell ein. Erleichtert atmest Du auf. Anscheinend hat "
    +"niemand Deine boese Tat bemerkt."));

    "/obj/gemmaster"->DistributeGem(1,0,2,TP,({"saphir","rubin","opal",
    "topas", "smaragd", "bergkristall", "aquamarin", "onyx", "granat",
    "diamant"}));

    PALASTMASTER->Msg(TP->Name()+" bricht einen Edelstein aus der Wand!", 2);

    TO->Message(BS(TP->Name(WER, 1)+" macht sich unauffaellig an der Wand "
    +"zu schaffen und schaut sich dann mit schlechtem Gewissen um."),
    MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    edelstein = WEG;
    return 1;
  }
  else
  {
    write(BS("Die Edelsteine sitzen alle fest in der Wand. Du kannst "
    +"keinen einzigen herausloesen."));

    TO->Message(BS(TP->Name(WER, 1)+" macht sich unauffaellig an der "
    +"Wand zu schaffen.\n"), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    return -1;
  }
}

void reset()
{
	::reset();
	edelstein = DA;
}

//auf Bank sitzen:
int sitzen(string str)
{
 notify_fail("Wo moechtest Du Dich hinsetzen?\n");

  if(!str || str == "") return 0;

  if(!(str == "auf bank" ||
       str == "auf baenke")) return 0;

  if(BANK(TP))
  {
    write(BS("Aber Du sitzt doch bereits auf der Bank!"));
    return -1;
  }

  if(sizeof(bank) > 4)
  {
    write(BS("Die Baenke sind leider alle besetzt. Fuer Dich ist kein Platz "
    +"mehr."));
    return -1;
  }

  write(BS("Du machst es Dir auf einer der Baenke gemuetlich."));

  TO->Message(BS(TP->Name(WER, 1)+" macht es sich auf einer Bank "
  +"gemuetlich."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  bank += ({ capitalize(getuid(TP)) });
  return 1;
}

//von Bank aufstehen:
int aufstehen(string str)
{
  notify_fail("Was moechtest Du tun?\n");

  if(!str || str == "") return 0;

  if(!(str == "von bank auf" ||
       str == "auf")) return 0;

  if(BANK(TP))
  {
    write(BS("Du erhebst Dich frisch und ausgeruht wieder von der Bank."));

    TO->Message(BS(TP->Name(WER, 1)+" steht von der Bank auf."),
    MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  }
  else
  {
    write(BS("Aber Du sitzt doch gar nicht auf der Bank!"));
    return -1;
  }

  bank -= ({ capitalize(getuid(TP)) });
  return 1;
}

//Test beim Verlassen des Raumes, ob man auf der Bank sitzt
int exit_test(string dir)
{
  if(BANK(TP))
  {
    write(BS("Dazu solltest Du erstmal von der Bank aufstehen."));
    return 0;
  }
  return 1;
}

//Spieler logt aus waehrend des auf der Bank Sitzens
void BecomesNetDead(object spieler)
{
  if(BANK(spieler))
  bank -= ({ capitalize(getuid(spieler)) });
}

//Spieler stirbt waehrend des Sitzens
void NotifyPlayerDeath(object spieler, object killer, int lost_xp)
{
  if(BANK(spieler))
  bank -= ({ capitalize(getuid(spieler)) });
}
