  AddDetail( ({ "gift" }),
    "Aber mit solchen Dingen hast Du ja sicherlich nichts zu schaffen.");

  AddDetail( ({ "dinge", "ding", "dingen" }),
    "Oder etwa doch?");

  AddDetail( ({ "bergkristalle", "kristalle", "bergkristall", "kristall" }),
    "Die Bergkristalle sind fast voellig durchsichtig.");

  AddDetail( ({ "seiten", "seite" }),
    "Zu Deiner Linken und zu Deiner Rechten stehen kleine weisse Baenke "
