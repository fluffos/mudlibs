  AddDetail( ({ "haare", "haar" }),
    "Die schwarzen, halblangen und ein wenig gewellten Haare fallen ihm "
    "locker in das huebsche Gesicht.");

  AddDetail( ({ "gesicht" }),
    "Das Gesicht ist huebsch und wohlgeformt.");

  AddDetail( ({ "augen", "auge" }),
    "Seine Augen sind strahlend gruen.");

  AddDetail( ({ "laecheln" }),
    "Froehlich grinst Dich der Junge von seinem Bild aus an. Du laesst "
