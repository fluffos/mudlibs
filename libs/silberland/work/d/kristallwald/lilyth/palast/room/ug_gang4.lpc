  AddDetail( ({ "geschaeft" }),
    "Du kannst es betreten, indem Du einfach nach Osten gehst.");

  AddDetail( ({ "palastmitte", "mitte", "mittelpunkt" }),
    "Der Brunnen bildet den Mittelpunkt des Palastes.");

  AddDetail( ({ "brunnen" }),
    "Du findest ihn westlich von hier.");

  AddDetail( ({ "gaenge" }),
    "Wie Du sicher schon bemerkt hast, fuehren breite, verzierte Gaenge "
