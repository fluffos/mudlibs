  AddDetail( ({ "atmosphaere" }),
    "Es herrscht eine herrliche Atmosphaere im Palast.");

  AddDetail( ({ "holz" }),
    "Die Baenke sind aus schimmerndem weissem Holz geschnitzt.");

  AddDetail( ({ "besucher" }),
    "Ausser Dir halten sich noch andere Besucher hier im Palast auf.");

  AddDetail( ({ "bild" }),
    "Das Bild an der Wand zeigt das Portrait eines Jungen. Du bist Dir "
