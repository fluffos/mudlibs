  AddDetail( ({ "palast" }),
    "Du laeufst in den weiten Gaengen des Palastes umher.");

  AddDetail( ({ "laden" }),
    "Im Osten befindet sich eine Art Laden.");

  AddDetail( ({ "art" }),
    "Du kannst von hier aus nicht erkennen, was fuer ein Geschaeft das "
