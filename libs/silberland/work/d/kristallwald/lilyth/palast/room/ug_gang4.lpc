#include "../def.h"

inherit "std/room";

//--Variablen&Defines------------------------------------------------------

#define BANK(wer) (member(bank, capitalize(getuid(wer)))!=-1)
#define MyCountUp(arg) (sizeof(arg) > 1 ? \
    implode(arg[0..<2], ", ") + " und " + arg[<1] : \
    (sizeof(arg) == 0 ? "niemand" : arg[0]) )

string *bank=({});

int edelstein;

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------

  edelstein = DA;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem Palast");
  SetProp(P_INT_LONG,
    "Du folgst dem breiten, mit schneeweissen Laeufern ausgelegten Gang, "
    "der durch den Palast fuehrt. Die Waende sind reich verziert und "
    "zu beiden Seiten hin stehen kleine Baenke aus schimmerndem weissen "
    "Holz fuer die Besucher bereit. Ein grosses Bild haengt an einer der "
    "Waende.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

