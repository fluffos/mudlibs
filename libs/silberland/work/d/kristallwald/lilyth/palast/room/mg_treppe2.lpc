  AddExit ("westen", ([ EX_DEST: "./mg_gang4",
                        EX_TESTFUNC: "exit_test",
                        EX_MSG: "nach Westen" ]) );

  AddExit ("osten", ([ EX_DEST: "./mg_gang2",
                       EX_TESTFUNC: "exit_test",
                       EX_MSG: "nach Osten" ]) );

  AddExit ("oben", ([ EX_DEST: "./og_treppe",
