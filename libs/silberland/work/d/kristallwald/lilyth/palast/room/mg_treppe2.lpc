//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "trink", "trinke" }), "trinken" );
  AddCmd( ({ "sitz", "sitze", "setz", "setze" }), "sitzen" );
  AddCmd( ({ "steh", "stehe", "erheb", "erhebe" }), "aufstehen" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer SpecialDetails-----------------------------------------

string strbaenke(string str)
{
  string s;
  s = "";

  if(BANK(TP))
  {
  	bank -= ({ capitalize(getuid(TP)) });

  	if(sizeof(bank) == 0)
  	{
  	        s = "Du hast Dich auf einer der Baenke niedergelassen.";
  	}
  	if(sizeof(bank) == 1)
  	{
  	        s = bank[0]+" und Du habt euch auf einer der Baenke "
  	        +"niedergelassen.";
  	}
  	if(sizeof(bank) > 1)
  	{
  	        s = ""+MyCountUp(bank)+" und Du sitzt auf den Baenken.";
  	}

  	bank += ({ capitalize(getuid(TP)) });
   }
   else
   {
  	if(sizeof(bank) == 1)
  	{
  	        s = bank[0]+" hat sich auf einer der Baenke "
  	        +"niedergelassen.";
  	}
  	if(sizeof(bank) > 1)
  	{
  	        s = ""+MyCountUp(bank)+" sitzen auf den Baenken "
  	        +"beisammen.";
  	}
   }
   return BS("Die drei Baenke sind kreisfoermig um den niedrigen runden "
   +"Tisch herum angeordnet. Sie selbst sind ebenfalls halbkreisfoermig "
   +"und mit weichen runden Polstern ausgelegt. "+s);
}

//--Funktionen-------------------------------------------------------------

//auf Bank sitzen:
int sitzen(string str)
{
  notify_fail("Wo moechtest Du Dich hinsetzen?\n");

  if(!str || str == "") return 0;

  if(!(str == "auf bank" ||
       str == "auf baenke" ||
       str == "auf rundbank" ||
       str == "auf rundbaenke" )) return 0;

  if(BANK(TP))
  {
    write(BS("Aber Du sitzt doch bereits auf einer der Rundbaenke!"));
    return -1;
  }

  if(sizeof(bank) > 6)
  {
    write(BS("Es ist leider kein Platz mehr auf den Baenken frei."));
    return -1;
  }

  write(BS("Du laesst Dich auf einer der Rundbaenke nieder."));

  TO->Message(BS(TP->Name(WER, 1)+" laesst sich auf einer der Baenke "
  +"nieder."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  bank += ({ capitalize(getuid(TP)) });
  return 1;
}

//von Bank aufstehen:
int aufstehen(string str)
{
  notify_fail("Von wo willst Du aufstehen?\n");

  if(!str || str == "") return 0;

  if(!(str == "von bank auf" ||
       str == "von rundbank auf" ||
       str == "von baenke auf" ||
       str == "von rundbaenke auf" ||
       str == "von baenken auf" ||
       str == "von rundbaenken auf" ||
       str == "auf")) return 0;

  if(BANK(TP))
  {
    write(BS("Du stehst wieder auf."));

    TO->Message(BS(TP->Name(WER, 1)+" erhebt sich von einer der Baenke."),
    MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  }
  else
  {
    write(BS("Aber Du sitzt doch gar nicht auf einer Bank!"));
    return -1;
  }

  bank -= ({ capitalize(getuid(TP)) });
  return 1;
}

//Test beim Verlassen des Raumes, ob man auf der Bank sitzt
int exit_test(string dir)
{
  if(BANK(TP))
  {
    write(BS("Dazu solltest Du zuerst aufstehen."));
    return 0;
  }
  return 1;
}

//Spieler logt aus waehrend des auf der Bank Sitzens
void BecomesNetDead(object spieler)
{
  if(BANK(spieler))
  bank -= ({ capitalize(getuid(spieler)) });
}

//Spieler stirbt waehrend des Sitzens
void NotifyPlayerDeath(object spieler, object killer, int lost_xp)
{
  if(BANK(spieler))
  bank -= ({ capitalize(getuid(spieler)) });
}

//Wasser aus Karaffe trinken:
int trinken(string str)
{
  notify_fail("Was moechtest Du woraus trinken?\n");

  if(!str || str == "") return 0;

  if(!(str == "wasser aus karaffe" ||
       str == "wasser" )) return 0;

      write(break_string("Du trinkst ein wenig Wasser aus der Karaffe. Brrr, "
      +"ist das kalt!\nDu frierst ein wenig.", 78,0,1));

      TO->Message(BS(TP->Name(WER, 1)+" trinkt etwas von dem Wasser aus "
      +"der Karaffe."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      return 1;
}
