#include "../def.h"
#include <laden.h>

inherit "std/laden";

//--Variablen&Defines------------------------------------------------------

int russ;
string str_sound(string key);
string str_geraschel(string key);
string str_kratzen(string key);

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------

  RemoveFixedObject("/obj/boerse");
  RemoveFixedObject("/obj/stempel");
  RemoveItem("/obj/entsorg");

  russ = DA;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einer kleinen Kammer");
  SetProp(P_INT_LONG,
    "Du bist in einer kleinen, von schummrigem Licht erfuellten Kammer "
    "angelangt. Das bei weitem Auffaelligste hier ist der grosse Tisch, "
    "der mitten im Raum steht und von unzaehligen Papieren, Pergamenten "
    "und kleinen Zettelchen bedeckt wird. An den Waenden haengen mehrere, "
    "schon leicht verblichene Karten, auf denen feine, duenne Linien "
    "zu sehen sind. Der Boden ist mit einem weichen, blaugemusterten "
    "Teppich ausgelegt.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_SHOPKEEPER_ID, "alenari");
  SetProp(P_SHOPKEEPER_NAME, "Alenari");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetStorageRoom(ROOM "mg_lagerraum_zeichnerin" );

//--Details----------------------------------------------------------------

  AddDetail( ({ "licht" }),
    "Das gedaempfte Licht, das hier herrscht, geht von den Fackeln aus, "
    "die in eisernen Haltern an den Waenden angebracht sind.");

  AddDetail( ({ "fackel", "fackeln" }),
    "Einige zum Teil schon fast abgebrannte Fackeln stecken in den "
    "Halterungen an den Waenden und erhellen den Raum ein wenig.");

  AddDetail( ({ "teil" }),
    "Die Fackeln sind teilweise schon fast abgebrannt.");

  AddDetail( ({ "kammer", "raum" }),
    "Du befindest Dich in einer kleinen Kammer, die nur von dem gedaempften "
    "Licht der Fackeln an den Waenden erhellt wird.");

  AddDetail( ({ "auffaelligste", "auffaelligstes", "auffaelliges" }),
    "Der grosse Tisch faellt Dir eigentlich nur auf, weil ein unglaubliches "
    "Chaos auf ihm herrscht.");

  AddDetail( ({ "chaos" }),
    "Auf dem Tisch herrscht ein ziemliches Chaos.");

  AddDetail( ({ "fleckchen", "fleck" }),
    "Von der Tischplatte, die sich irgendwo unter den ganzen Papierstapeln "
    "befinden muss, ist nichts zu sehen.");

  AddDetail( ({ "tischplatte", "platte" }),
    "So angestrengt Du auch hinschaust, sie ist einfach nicht zu sehen. "
    "Und eigentlich hast Du auch keine Lust, den ganzen Tisch abzuraeumen, "
    "nur um Dir die Tischplatte anzusehen.");

  AddDetail( ({ "lust" }),
    "Nein, dazu hast Du bestimmt keine Lust.");

  AddDetail( ({ "tisch" }),
    "Der grosse Tisch, der mitten im Raum steht, ist ueber und ueber mit "
    "Papieren, Pergamenten und kleinen Zettelchen ueberhaeuft, "
    "so dass Du kein einziges freies Fleckchen mehr entdecken kannst.");

  AddDetail( ({ "papier", "papiere", "papierstapel", "stapel", "pergament",
  "pergamente" }),
    "Unmengen von Papieren und Pergamenten liegen kreuz und quer ueber "
    "den ganzen Tisch verteilt herum.");

  AddDetail( ({ "unmenge", "unmengen" }),
    "Es sind wirklich sehr viele.");

  AddDetail( ({ "zettel", "zettelchen" }),
    "Lauter kleine Zettel liegen zwischen den anderen Papieren herum. "
    "Auf einigen steht etwas geschrieben, andere sind noch vollkommen "
    "leer. Anscheinend sind das Alenaris Notizen, die sie fuer ihre Arbeit "
    "benoetigt.");

  AddDetail( ({ "notizen" }),
    "Auf einigen der Zettel hat Alenari etwas notiert.");

  AddDetail( ({ "arbeit", "kartenzeichnerin", "alenari", "zeichnerin" }),
    "Alenari ist eine Kartenzeichnerin. Sie fertigt Karten vom Silberland "
    "und seinen zahlreichen Regionen an. Einige davon kannst Du an den "
    "Waenden haengen sehen.");

  AddDetail( ({ "wand", "waende" }),
    "An den Waenden haengen grosse, schon leicht verblichene Karten.");

  AddDetail( ({ "karten", "karte" }),
    "Die Karten sind groesstenteils schon leicht verblichen, so dass die "
    "Linien auf ihnen nur noch sehr schwach zu sehen sind. Dennoch erkennst "
    "Du, dass auf ihnen mehr oder weniger deutliche Grundrisse von "
    "verschiedenen Regionen und Staedten abgebildet sind.");

  AddDetail( ({ "linien", "linie", "grundriss", "grundrisse" }),
    "Die Linien zeigen Grundrisse von den verschiedensten Gegenden. "
    "Teilweise kommen Dir einige davon sogar recht bekannt vor.");

  AddDetail( ({ "gegend", "gegenden" }),
    "Einige kennst Du, andere nicht.");

  AddDetail( ({ "staedte", "stadt", "region", "regionen" }),
    "Du erkennst die Umrisse von Midas, der Hauptstadt der Menschen, die "
    "huegeligen Felder und Wiesen von Derlim, die Handelsstadt Tijara... "
    "ja, eine besonders grosse Karte scheint sogar die Wueste abzubilden.");

  AddDetail( ({ "umriss", "umrisse" }),
    "Auf einer der Karten kannst Du die Umrisse von Midas erkennen.");

  AddDetail( ({ "midas" }),
    "Midas ist die Hauptstadt der Menschen. Du erkennst deutlich die "
    "kleine Strassen und Haeuser und die grosse Kirche auf der Karte.");

  AddDetail( ({ "hauptstadt", "menschen", "mensch" }),
    "Midas ist die Hauptstadt der Menschen.");

  AddDetail( ({ "strasse", "strassen" }),
    "Die verwinkelten Strassen von Midas sind deutlich zu erkennen.");

  AddDetail( ({ "haeuser", "haus" }),
    "Sogar die kleinen Haeuser sind eingezeichnet worden.");

  AddDetail( ({ "kirche", "kirchturm", "turm" }),
    "Midas hat eine grosse Kirche mit einem hohen Kirchturm, von dem "
    "man silberlandweit die Glocken laeuten hoeren kann.");

  AddDetail( ({ "glocken", "glocke" }),
    "Die Glocken der Kirche von Midas kann man bis weit ins Silberland "
    "hoeren.");

  AddDetail( ({ "felder", "wiesen", "wiese", "huegel" }),
    "In Derlim und in seiner Umgebung gibt es wunderschoene gruene Wiesen, "
    "Felder und sanfte Huegel zu bestaunen.");

  AddDetail( ({ "derlim", "heimat", "hobbits", "umgebung" }),
    "Derlim ist die Heimat der Hobbits. Es liegt mitten im Huegelland.");

  AddDetail( ({ "huegelland" }),
    "Dort befindet sich Derlim.");

  AddDetail( ({ "handelsstadt", "handelsstaedte" }),
    "Tijara ist eine der groessten Handelsstaedte im ganzen Silberland. "
    "Von dort aus werden Waren in alle moeglichen Laender verschifft und "
    "fremdartige Gueter eingefahren.");

  AddDetail( ({ "silberland", "welt", "land", "laender" }),
    "Das Silberland ist gross und weit.");

  AddDetail( ({ "waren", "ware", "gueter", "gut"}),
    "Von Tijara aus werden alle moeglichen Waren und Gueter ein- und "
    "ausgeschifft.");

  AddDetail( ({ "tijara" }),
    "Du erkennst deutlich den Hafen von Tijara, die Kuestenwege, die "
    "Wohngebiete und sogar den undurchdringlichen Dschungel auf einer der "
    "Karten.");

  AddDetail( ({ "hafen" }),
    "Tijara hat einen grossen Hafen, von dem aus viele Schiffe in die "
    "ganze Welt reisen.");

  AddDetail( ({ "schiff", "schiffe" }),
    "Zahlreiche Schiffe verlassen Tijara jeden Tag, das ganze Jahr ueber. "
    "Und fast ebenso viele landen Tag fuer Tag an seiner Kueste.");

  AddDetail( ({ "jahr", "tag", "tage" }),
    "Ein Jahr hat viele Tage. Um genau zu sein, sind es meistens etwa um "
    "die 365.");

  AddDetail( ({ "365" }),
    "So viele Tage hat das Jahr.");

  AddDetail( ({ "kuestenwege", "kuestenweg", "kueste" }),
    "Die Kueste vor Tijara ist sicherlich ganz sehenswert.");

  AddDetail( ({ "wohngebiete", "wohngebiet" }),
    "In den Wohngebieten wohnen viele der Einwohner von Tijara.");

  AddDetail( ({ "einwohner" }),
    "Wenn Du welche kennenlernen willst, solltest Du Dich nach Tijara "
    "begeben.");

  AddDetail( ({ "dschungel" }),
    "Suedlich von Tijara siehst Du den undurchdringlichen Dschungel auf "
    "auf der Karte.");

  AddDetail( ({ "wueste", "wuestenkarte" }),
    "Abgesehen von einigen kleineren Puenktchen, die wohl Staedte oder Oasen "
    "darstellen sollen, besteht die Wuestenkarte eigentlich nur aus "
    "einer riesigen, weissen Flaeche.");

  AddDetail( ({ "punkte", "puenktchen" }),
    "Die Punkte sollen wohl die Wuestenstaedte darstellen. Sie scheinen "
    "noch nicht ganz fertig aufgezeichnet worden zu sein.");

  AddDetail( ({ "wuestenstaedte" }),
    "Ja, auch in der Wueste gibt es Staedte.");

  AddDetail( ({ "oasen", "oase" }),
    "Wenn man in der Wueste ist, freut man sich ueber jede Oase, die "
    "einem ueber den Weg laeuft.");

  AddDetail( ({ "weg" }),
    "Nun, sie laufen natuerlich nicht wirklich... Das sagt man nur so.");

  AddDetail( ({ "flaeche" }),
    "Die Wuestenkarte besteht aus einer riesigen weissen Flaeche, auf "
    "der es fast nichts zu geben scheint ausser Sand, Sand und nochmals "
    "Sand.");

  AddDetail( ({ "sand" }),
    "Soviel Sand wie in der Wueste findest Du sonst nirgends.");

  AddDetail( ({ "boden" }),
    "Auf dem blauen Marmorboden liegt ein weicher, blaugemusterter Teppich.");

  AddDetail( ({ "teppich", "teppiche" }),
    "Ein huebscher, blaugemusterter Teppich liegt auf dem ebenfalls blauen "
    "Marmorboden. Er fuehlt sich herrlich weich unter Deinen Fuessen an.");

  AddDetail( ({ "marmorboden" }),
    "Der Boden besteht aus hellblauem, goldgesprenkelten Marmor.");

  AddDetail( ({ "marmor" }),
    "Der Marmor hat eine hellblaue, goldgesprenkelte Faerbung.");

  AddDetail( ({ "faerbung", "farbe" }),
    "Die Farbe des Marmors passt hervorragend zu dem blauen Teppich, der "
    "auf ihm liegt.");

  AddDetail( ({ "fuesse", "fuss", "zeh", "zehen" }),
    "Du wackelst mit Deinem grossen Zeh.");

  AddDetail( ({ "decke" }),
    "Die Decke ist, wie nicht anders zu erwarten, aus blauem Marmor.");

  AddReadDetail( ({ "zettel", "zettelchen", "schrift" }),
    "Die Schrift ist so klein, dass Du sie nicht entziffern kannst.");

  AddSpecialDetail( ({ "halter", "halterung", "halterungen" }),
    "strhalter");

  AddSpecialDetail( ({ "russ" }),
    "strruss");

  AddSpecialDetail( ({ "schicht" }),
    "strschicht");

  AddSound(DEFAULT_SOUND,
    #'str_sound);

  AddSound( ({ "geraschel", "papiergeraschel" }),
    #'str_geraschel);

  AddSound( ({ "kratzen", "feder" }),
    #'str_kratzen);

  AddSmell( DEFAULT_SMELL,
    "Ein schwacher Geruch nach Staub und altem Pergament liegt in der "
    "Luft.");

  AddSmell( ({ "geruch" }),
    "Es riecht ein wenig staubig hier.");

  AddSmell( ({ "pergament" }),
    "Das Pergament riecht ein wenig alt.");

  AddSmell( ({ "luft" }),
    "Die Luft ist ein wenig staubig.");

  AddSmell( ({ "staub" }),
    "Haaaaaa-tschi! Gesundheit!");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", "nach Norden#" + "./mg_gang3" );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "putz", "putze" }), "putzen" );
  AddCmd( ({ "raeum", "raeume" }), "abraeumen" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "zeichnerin", REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer SpecialDetails-----------------------------------------

string strhalter(string str)
{
  string s;

  if(russ == DA)
  {
  	s = "Grosse, schon ein wenig russgeschwaerzte eiserne Halterungen "
  	+"sind an den Waenden befestigt. In jeder von ihnen steckt eine "
  	+"Fackel.";
  }
  else
  {
  	s = "Grosse eiserne Halterungen sind an den Waenden befestigt. "
  	+"In jeder von ihnen steckt eine Fackel.";
  }
  return BS(s);
}

string strruss(string str)
{
  string s;

  if(russ == DA)
  {
  	s = "Die Fackelhalter sind mit einer duennen, schwarzen Schicht Russ "
  	+"ueberzogen.";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

string strschicht(string str)
{
  string s;

  if(russ == DA)
  {
  	s = "Anscheinend sind die Halterungen schon etwas laenger nicht mehr "
  	+"geputzt worden.";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

//Sound:
string str_sound(string key)
{
	if(!present("kartenzeichnerin"))
	{
        return "Es ist vollkommen still hier.\n";
        }
        else
        {
        return BS("Ab und zu ist ein leises Papiergeraschel und das Kratzen "
        "einer Feder zu hoeren.\n");
        }
}

string str_geraschel(string key)
{
	if(!present("kartenzeichnerin"))
	{
        return "Du lauschst, hoerst aber nichts.\n";
        }
        else
        {
        return BS("Alenari raschelt leise mit dem Papier herum.\n");
        }
}

string str_kratzen(string key)
{
	if(!present("kartenzeichnerin"))
	{
        return "Du lauschst, hoerst aber nichts.\n";
        }
        else
        {
        return BS("Du hoerst das leise, beruhigende Kratzen einer Feder.\n");
        }
}

//--Funktionen-------------------------------------------------------------

int putzen(string str)
{
  notify_fail("Was willst Du putzen?\n");

  if(!str || str == "") return 0;

  if(!(str == "halter" ||
       str == "halterung" ||
       str == "halterungen" ||
       str == "fackelhalter" ||
       str == "russ weg" ||
       str == "russ ab" ||
       str == "russ von halter" ||
       str == "russ von halterung" ||
       str == "russ von halterungen" ||
       str == "russ von fackelhalter" )) return 0;

  if(russ == DA)
  {
       write(BS("Du wischt den Russ sorgfaeltig von den Halterungen "
       +"ab."));

       TO->Message(BS(TP->Name(WER, 1)+" fummelt ein wenig an den "
       +"Halterungen herum, die an der Wand angebracht sind."),
       MSGFLAG_VISUAL|MSGFLAG_NO_TP);

       russ = WEG;
       return 1;
  }
  else
  {
       write(BS("Aber die Halterungen sind doch gar nicht schmutzig."));
       return -1;
  }
}

int abraeumen(string str)
{
  notify_fail("Was willst Du abraeumen?\n");

  if(!str || str == "") return 0;

  if(!(str == "tisch ab" ||
       str == "den tisch ab" )) return 0;

  if(!present("kartenzeichnerin"))
  {
       write(BS("Mit einem lauten *WUSCH* schubst Du die unzaehligen "
       +"Papiere, Pergamente und Zettelchen vom Tisch herunter. "
       +"Tatsaechlich, der Tisch hat eine ganz normale, unversehrte "
       +"Tischplatte. Zutiefst beruhigt raeumst Du nach und nach alles "
       +"wieder an seinen vorherigen Platz."));

       TO->Message(break_string("Mit einem lauten *WUSCH* schubst "
       +TP->Name(WER, 1)+" die unzaehligen Papiere, Pergamente und "
       +"Zettelchen von dem Tisch herunter, der mitten im Raum steht, "
       +"betrachtet eine Weile lang nachdenklich die darunter "
       +"befindliche Tischplatte und raeumt dann alles wieder an "
       +"seinen vorherigen Platz.\nDu wunderst Dich.", 78,0,1),
       MSGFLAG_VISUAL);
       return 1;
  }
  else
  {
       write(BS("Als Alenari gerade nicht hinsieht, fegst "
       +"Du mit einem lautem *WUSCH* saemtliche Papiere, Pergamente und "
       +"alles andere vom Tisch und betrachtest die Tischoberflaeche."));

       TO->Message(BS(TP->Name(WER, 1)+" fegt mit einem lauten "
       +"*WUSCH* saemtliche Papiere und Pergamente von dem grossen Tisch "
       +"herunter, der mitten im Raum steht."),
       MSGFLAG_VISUAL|MSGFLAG_NO_TP);
       call_out("seqtisch", 4, TP);
       return -1;
  }
}

//Sequenz fuers Tisch abraeumen:
void seqtisch(object player)
{
    if(!player)                return;
    if(!interactive(player))   return;

    write(break_string("Alenari schimpft: Was soll denn das?! Hoer "
    +"sofort damit auf!\nAlenari verpasst Dir eine schallende Ohrfeige und "
    +"raeumt schnell alles wieder an seinen Platz.", 78,0,1));

    TO->Message(BS("Alenari verpasst "+TP->Name(WER, 1)+" eine "
    +"schallende Ohrfeige und macht sich dann laut schimpfend daran, alles "
    +"wieder an seinen ordnungsgemaessen Platz zu raeumen."),
    MSGFLAG_VISUAL|MSGFLAG_NO_TP);
}

void reset()
{
	::reset();
	russ = DA;
}

//Kein verkaufen hier:
int sell(string str, int f)
{
  string prefix;

  if (!prefix=CheckKeeper(2)) return 0;

  write(capitalize(QueryProp(P_SHOPKEEPER_NAME))+
       " sagt bedauernd: Tut mir leid, aber ich kaufe nichts.\n");
  return -1;
}
