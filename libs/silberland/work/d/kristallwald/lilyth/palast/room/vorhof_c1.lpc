  AddDetail( ({ "himmel" }),
    "Der Himmel ist strahlend blau und die Sonne scheint.");

  AddDetail( ({ "sonne" }),
    "Die Sonne scheint, die Voegel zwitschern...");

  AddDetail( ({ "voegel" }),
    "Hmm, das Vogelgezwitscher hast Du Dir wohl doch nur eingebildet... "
    "Du siehst hier nirgendwo auch nur die Spur eines Vogels.");

  AddDetail( ({ "vogelgezwitscher", "gezwitscher" }),
    "Dabei warst Du Dir so sicher, dass Du gerade ganz deutlich ein "
