#include "../def.h"
#include <laden.h>
#include <food.h>

inherit "std/laden";

//--Variablen&Defines------------------------------------------------------

int gras;
string strzeitung_lesen(string key);

public void init() {
  ::init();
  call_other(ROOM "vorhof_lagerraum_fischstand", "???");
}

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------

  gras = DA;
  RemoveItem("/obj/entsorg"); //Muellschlucker weg
  RemoveFixedObject("/obj/boerse");
  RemoveFixedObject("/obj/stempel");

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Auf einem grossen Vorhof");
  SetProp(P_INT_LONG,
    "Du bist in der oestlichen Ecke des Vorhofs angelangt. Noerdlich "
    "von hier kannst Du die weissen Mauern des gewaltigen Palastes sehen, "
    "der sich dort gegen den strahlend blauen Himmel erhebt. Abgesehen "
    "von dem kleinen Stand, an dem Fische verkauft werden, ist in diesem "
    "Teil des Vorhofs nicht sehr viel los, was bei dem Geruch hier auch "
    "nicht sehr verwunderlich ist.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  SetProp(P_SHOPKEEPER_ID, "fischhaendler");
  SetProp(P_SHOPKEEPER_NAME, "der Fischhaendler");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  call_other(ROOM "vorhof_lagerraum_fischstand", "???");
  SetStorageRoom(ROOM "vorhof_lagerraum_fischstand" );
  SetProp(P_SPECIAL_SHOP, ([P_FOOD_INFO:"Der Fischhaendler sagt: Ich kaufe "
  +"nur essbare Sachen!\n"]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "ecke", "eck" }),
    "Du befindest Dich in der oestlichen Ecke des Vorhofs.");

  AddDetail( ({ "vorhof" }),
    "Du stehst mitten auf dem grossen Vorhof, der sich vor dem Palast "
    "erstreckt.");

  AddDetail( ({ "mauern", "mauer" }),
    "Von hier aus kannst Du die weissen Mauern des Palastes sehen, die "
    "weit bis in den Himmel hineinzuragen scheinen.");

  AddDetail( ({ "palast" }),
    "Der Palast scheint unglaubliche Ausmasse zu besitzen. Zumindest sieht "
    "er von aussen wirklich beeindruckend gross aus.");

  AddDetail( ({ "ausmasse" }),
    "Soweit Du das von hier aus beurteilen kannst, hat der Palast eine "
    "Breite von einigen hundert Metern, und seine Turmspitze reicht bis in "
    "die Wolken hinauf.");

  AddDetail( ({ "breite" }),
    "Er ist jedenfalls ziemlich breit.");

  AddDetail( ({ "meter" }),
    "Genauer kannst Du es von hier aus nicht einschaetzen.");

  AddDetail( ({ "turmspitze", "spitze" }),
    "Die Spitze des einzelnen Turmes, der sich in der Mitte des Palastes "
    "erhebt, ist durch die Wolken nicht genauer zu erkennen.");

  AddDetail( ({ "turm" }),
    "Dir laeuft jetzt schon der Schweiss von der Stirn, wenn Du daran "
    "denkst, wie viele Treppenstufen Du wohl hinaufsteigen musst, um "
    "dort hinaufzugelangen.");

  AddDetail( ({ "schweiss" }),
    "Kleine Schweissperlen rinnen ueber Dein Gesicht.");

  AddDetail( ({ "schweissperlen" }),
    "Du wischst Dir den Schweiss von der Stirn.");

  AddDetail( ({ "stirn" }),
    "Deine Stirn ist von Schweiss bedeckt.");

  AddDetail( ({ "gesicht" }),
    "Dein Gesicht ist leicht erhitzt.");

  AddDetail( ({ "treppenstufen", "stufen" }),
    "Dir wird ein wenig uebel, als Du zu dem hohen Turm hinaufstarrst.");

  AddDetail( ({ "mitte" }),
    "Etwa in der Mitte des Palastes ragt ein einzelner, schmaler Turm "
    "empor.");

  AddDetail( ({ "wolken", "wolke" }),
    "Um die Turmspitze des Palastes herum haben sich ein paar Wolken "
