    "Schwertfisch.");

  AddDetail( ({ "reihen", "reihe" }),
    "Die Fische liegen in mehreren Reihen auf den schmalen Holzbrettern.");

  AddDetail( ({ "blick" }),
    "Na gut, vielleicht auch erst auf den zweiten.");

  AddDetail( ({ "teil" }),
    "Du befindest Dich im oestlichen Teil des Vorhofs.");

  AddDetail( ({ "geruch" }),
    "Es riecht hier sehr stark nach Fisch.");

  AddDetail( ({ "boden" }),
    "Der Boden ist mit hellem Sand ausgestreut.");

  AddDetail( ({ "sand" }),
    "Heller, fast weisser Sand liegt ueberall auf dem Boden.");

  AddDetail( ({ "zeit" }),
    "Apropos Zeit, es ist schon ganz schoen spaet!");

  AddDetail( ({ "besucher", "palastbesucher" }),
    "Ab und zu kommen andere Besucher an Dir vorbei, unterhalten sich oder "
    "kaufen dem Fischhaendler einen seiner Fische ab.");

  AddSound( DEFAULT_SOUND,
    "In dieser Ecke auf dem Vorhof ist es relativ ruhig, nur ab und zu sind "
    "die leisen Stimmen der Besucher zu hoeren, die hier vorbeispazieren.");

  AddSound( ({ "ecke", "vorhof", "teil" }),
    "Du befindest Dich in einem sehr ruhigen Teil des Vorhofs.");

  AddSound( ({ "stimmen" }),
    "Leise Stimmen dringen ab und zu an Dein Ohr.");

  AddSound( ({ "ohr" }),
    "Dein Ohr ist heute wieder mal sehr schweigsam.");

  AddSound( ({ "besucher" }),
    "Du bist nicht alleine hier draussen.");

  AddSmell( DEFAULT_SMELL,
    "Es stinkt ziemlich nach Fisch.");

  AddSmell( ({ "fisch", "gestank", "fische" }),
    "Die ganze Luft ist von einem starken Fischgeruch durchsetzt.");

  AddSmell( ({ "fischgeruch", "geruch" }),
    "Naja, Du wirst Dich schon dran gewoehnen.");

  AddSmell( ({ "luft" }),
    "Ab und zu vertreibt eine schwache Brise den Gestank.");

  AddSmell( ({ "brise" }),
    "Ungeduldig wartest Du auf die naechste frische Brise.");

  AddSpecialDetail( ({ "fischstand", "stand" }),
    "strfischstand");

  AddSpecialDetail( ({ "stuhl", "holzstuhl" }),
    "strstuhl");

  AddSpecialDetail( ({ "zeitung" }),
    "strzeitung");

  AddSpecialDetail( ({ "trolle", "troll" }),
    "strtrolle");

  AddSpecialDetail( ({ "fleck" }),
    "strfleck");

  AddSpecialDetail( ({ "gras", "grasbueschel", "bueschel" }),
    "strgras");

//Fischdetails:
  AddSpecialDetail( ({ "heringe", "hering" }),
    "strheringe");

  AddSpecialDetail( ({ "schuppen" }),
    "strschuppen");

  AddSpecialDetail( ({ "ruecken", "graublau" }),
    "strruecken");

  AddSpecialDetail( ({ "makrelen", "makrele" }),
    "strmakrelen");

  AddSpecialDetail( ({ "grundfarbe", "grundfarben" }),
    "strgrundfarbe");

  AddSpecialDetail( ({ "rueckenzeichnung", "rueckenzeichnungen" }),
    "strrueckenzeichnung");

  AddSpecialDetail( ({ "seezungen", "seezunge" }),
    "strseezungen");

  AddSpecialDetail( ({ "kabeljau" }),
    "strkabeljau");

  AddSpecialDetail( ({ "exemplar" }),
    "strexemplar");

  AddSpecialDetail( ({ "merkmal", "hauptmerkmal" }),
    "strmerkmal");

  AddSpecialDetail( ({ "bartfaden" }),
    "strbartfaden");

  AddSpecialDetail( ({ "unterkiefer" }),
    "strunterkiefer");

  AddSpecialDetail( ({ "schollen", "scholle" }),
    "strschollen");

  AddSpecialDetail( ({ "plattfische", "familie" }),
    "strplattfische");

  AddSpecialDetail( ({ "koerper" }),
    "strkoerper");

  AddSpecialDetail( ({ "flossen", "flossensaum" }),
    "strflossen");

  AddSpecialDetail( ({ "schwertfisch" }),
    "strschwertfisch");

  AddSpecialDetail( ({ "kiefern", "kiefer" }),
    "strkiefern");

  AddSpecialDetail( ({ "schwerter" }),
    "strschwerter");

  AddSpecialDetail( ({ "namen", "name" }),
    "strnamen");

  AddReadDetail( ({ "zeitung" }),
    #'strzeitung_lesen);

//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", "nach Westen#" + "./vorhof_b1" );
  AddExit( "suedwesten", "nach Suedwesten#" + "./vorhof_b2" );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "sieh", "siehe", "seh", "sehe" }), "sehen" );
  AddCmd( ({ "pflueck", "pfluecke", "reiss", "reisse", "rupf", "rupfe" }),
  "pfluecken" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "katze", REFRESH_DESTRUCT);
  AddItem(NPC "fischhaendler", REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer Kommandos----------------------------------------------

//genauer umsehen (Grasbueschel):
int sehen(string str)
{
  notify_fail("Was genau moechtest Du tun?\n");

  if(!str || str == "") return 0;

  if(!(str == "genau um" ||
       str == "genauer um" ||
       str == "noch genauer um" ||
       str == "dich genauer um" ||
       str == "dich noch genauer um" )) return 0;

       write(BS("Du suchst noch einmal jede Ecke des Vorhofs mit den "
       +"Augen ab. Nein, es ist wirklich kein einziger Vogel zu sehen. "
       +"Als Du Dich enttaeuscht abwendest, faellt Dir jedoch ein "
       +"gruener Fleck am Boden auf.\n"));

       TO->Message(BS(TP->Name(WER, 1)+" schaut sich gruendlich auf dem "
       +"Vorhof um.\n"), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;
}

//Grasbueschel pfluecken:
int pfluecken(string str)
{
  object mygras;
  notify_fail("Was willst Du pfluecken oder ausrupfen?\n");

  if(!str || str == "") return 0;

  if(!(str == "gras" ||
       str == "grasbueschel" ||
       str == "bueschel" ||
       str == "gras aus" ||
       str == "grasbueschel aus" ||
       str == "bueschel aus" )) return 0;

       if(gras == DA)
       {
         mygras = clone_object(OBJ "grasbueschel");

         write(BS("Du pflueckst das Grasbueschel."));

         TO->Message(TP->Name(WER, 1)+" scheint etwas gefunden "
         +"zu haben.\n", MSGFLAG_VISUAL|MSGFLAG_NO_TP);

         if(ME_TOO_HEAVY == mygras->move(TP,M_GET|M_SILENT))
         {
           mygras->move(ENV(TP), M_PUT|M_SILENT);

           write(BS("Da Du das Grasbueschel nicht mehr tragen "
           +"kannst, laesst Du es auf den Boden fallen."));

           ENV(TP)->Message(BS(TP->Name(WER, 1)+" laesst etwas "
           +"auf den Boden fallen."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
           return -1;
         }
         gras = WEG;
         return 1;
       }
       else
       {
         write(BS("Da ist doch gar kein Grasbueschel, das Du "
         +"pfluecken koenntest!"));
         return -1;
       }
}

void reset ()
{
  ::reset();
  gras = DA;
}

//--Funktionen fuer Details------------------------------------------------

string strfischstand(string str)
{
  string s;

  s = "Ein kleiner Fischstand befindet sich hier. Eigentlich besteht er nur "
      +"aus einigen Holzbrettern, die ueber zwei dicke Holzkisten gelegt "
      +"wurden. ";

  if(present("\nfischhaendler"))
  {
  	s += "Dahinter steht ein kleiner Holzstuhl, auf dem ein dicker "
  	+"behaebiger Troll sitzt und in einer Zeitung liest. Ausserdem "
  	+"steht neben dem Stuhl ein kleiner Eimer mit Wasser.";
  }
  else
  {
  	s += "Dahinter steht ein kleiner Holzstuhl, auf dem eine "
  	+"aufgeschlagene Zeitung liegt. Ausserdem steht neben dem Stuhl "
  	+"ein kleiner Eimer mit Wasser.";
  }
  return BS(s);
}

string strstuhl(string str)
{
  string s;

  s = "Ein kleiner Holzstuhl steht hinter dem Fischstand. ";

  if(present("\nfischhaendler"))
  {
  	s += "Ein grosser Troll sitzt auf ihm.";
  }
  else
  {
  	s += "Eine Zeitung liegt auf ihm.";
  }
  return BS(s);
}

string strzeitung(string str)
{
  string s;

  if(present("\nfischhaendler"))
  {
  	s = "Du wusstest gar nicht, dass Trolle lesen koennen.";
  }
  else
  {
  	s = "Die Zeitung liegt aufgeschlagen auf dem Stuhl. Du kannst sie "
  	+"ja lesen, wenn Du willst.";
  }
  return BS(s);
}

string strtrolle(string str)
{
  string s;

  if(present("\nfischhaendler"))
  {
  	s = "Ein grosser Troll sitzt hinter dem Fischstand auf einem "
  	+"kleinen Holzstuhl.";
  }
  else
  {
  	s = "Huch, der Fischhaendler scheint gerade nicht da zu sein.";
  }
  return BS(s);
}

string strfleck(string str)
{
  string s;

  if(gras == DA)
  {
  	s = "Huch, direkt vor Deinen Fuessen waechst ein grosses gruenes "
  	+"Grasbueschel aus dem Boden! Seltsam, das hast Du bisher voellig "
  	+"uebersehen.";
  }
  else
  {
  	s = "Hmm, Du hast Dich wohl doch geirrt. Da ist nichts.";
  }
  return BS(s);
}

string strgras(string str)
{
  string s;

  if(gras == DA)
  {
  	s = "Ein grosses saftiges Bueschel Gras waechst hier aus dem "
  	+"Boden.";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

string strzeitung_lesen(string key)
{
  string s;

  if(present("\nfischhaendler"))
  {
  	s = "So nah kommst Du da nicht ran!";
  }
  else
  {
  	s = "Du schnappst Dir unauffaellig die Zeitung von dem Stuhl "
        +"und durchstoeberst sie kurz auf der Suche nach Neuigkeiten. "
        +"Da Dir jedoch keiner der Artikel sonderlich interessant erscheint, "
        +"legst Du sie wieder auf den Stuhl zurueck.";

        TO->Message(TP->Name(WER, 1)+" liest in einer Zeitung.\n",
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  }
  return BS(s);
}

//Funktionen fuer Fischdetails:

string strheringe(string str)
{
  string s;
  object ob;
  ob = find_object(ROOM "vorhof_lagerraum_fischstand");

  if(present("hering", ob))
  {
  	s = "Heringe sind laengliche, schlanke Fische mit silbrigen Schuppen "
  	+"und einem graublau schimmernden Ruecken. Es liegen recht viele "
  	+"davon auf den Holzbrettern.";
  }
  else
  {
  	s = "Hmm, anscheinend sind die frischen Heringe gerade alle "
  	+"ausverkauft. Die wenigen, die Du noch auf den Holzbrettern sehen "
  	+"kannst, scheinen schon laengere Zeit dort zu liegen.";
  }
  return BS(s);
}

