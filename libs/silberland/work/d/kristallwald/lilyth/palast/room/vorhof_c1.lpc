  AddDetail( ({ "zwitschern" }),
    "Merkwuerdig.");

  AddDetail( ({ "spur" }),
    "Du kannst nicht die Spur eines Vogels entdecken.");

  AddDetail( ({ "vogel" }),
    "Auch wenn Du Dich noch genauer umsiehst, wirst Du keinen finden.");

  AddDetail( ({ "holzbretter", "bretter", "holzbrett", "brett" }),
    "Auf den Holzbrettern liegen die Fische zum Verkauf bereit. "
    "Die Oberflaeche der Bretter ist ein wenig feucht.");

  AddDetail( ({ "verkauf" }),
    "Die Fische stehen zum Verkauf bereit.");

  AddDetail( ({ "oberflaeche" }),
    "Die Holzbretter haben sich an einigen Stellen ein wenig dunkel "
    "verfaerbt, was darauf hindeutet, dass sie dort nass geworden sind.");

  AddDetail( ({ "stellen", "stelle" }),
    "Die Holzbretter scheinen an einigen Stellen nass geworden zu sein.");

  AddDetail( ({ "holzkisten", "kisten", "holzkiste", "kiste" }),
    "Die beiden Holzkisten sind in einem Abstand von etwa einer "
    "Zwergenlaenge aufgestellt worden, so dass die schmalen Holzbretter, "
    "die darauf liegen, einen festen Halt haben.");

  AddDetail( ({ "abstand" }),
    "Der Abstand betraegt etwa eine Zwergenlaenge.");

  AddDetail( ({ "zwergenlaenge", "fuss" }),
    ([ 0: "Zwerge sind in der Regel etwa drei bis vier Fuss lang.",
    "zwerg": "Nun, wie gross bist Du denn?" ]) );

  AddDetail( ({ "regel" }),
    ([ 0: "Es gibt auch Ausnahmen.",
    "zwerg": "Sowas siehst Du da nicht!" ]) );

  AddDetail( ({ "ausnahmen", "zwerg" }),
    ([ 0: "Frag lieber einen Zwerg danach.",
    "zwerg": "Na, guck Dich doch mal an!" ]) );

  AddDetail( ({ "halt" }),
    "Die Bretter liegen fest und sicher auf den Holzkisten.");

  AddDetail( ({ "holz" }),
    "Das Holz, aus dem der Fischstand erbaut wurde, hat eine sehr helle "
    "Faerbung, waehrend der Stuhl, der dahinter steht, aus einem dunklerem "
    "Holz geschnitzt wurde.");

  AddDetail( ({ "faerbung" }),
    "Die Holzbretter haben eine hellbraune Farbe.");

  AddDetail( ({ "farbe" }),
    "Eigentlich ist es doch eher beige als braun.");

  AddDetail( ({ "eimer" }),
    "Der Eimer ist mit Wasser gefuellt.");

  AddDetail( ({ "wasser" }),
    "Das Wasser sieht sehr sauber aus.");

  AddDetail( ({ "fische", "fisch" }),
    "Die Fische liegen in drei langen Reihen auf den Holzbrettern zum "
    "Verkauf bereit. Sie sehen allesamt sehr frisch und geniessbar aus. "
    "Viele der hier angebotenen Fische kannst Du auf den ersten Blick "
    "identifizieren, aber es sind auch einige Sorten dabei, die Du noch nie "
    "zuvor gesehen hast.");

  AddDetail( ({ "sorten", "fischsorten", "sorte", "fischsorte" }),
    "Du kannst einige Heringe und Makrelen sehen, Seezungen, einen "
