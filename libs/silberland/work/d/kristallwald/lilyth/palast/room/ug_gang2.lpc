  AddDetail( ({ "blick" }),
    "Nur schwer vermagst Du Deinen Blick von ihr zu loesen.");

  AddDetail( ({ "anblick" }),
    "Dein Atem stockt bei diesem Anblick.");

  AddDetail( ({ "atem" }),
    "Merkst Du nicht, dass Du die ganze Zeit schon die Luft anhaeltst?");

  AddDetail( ({ "zeit" }),
    "Mindestens fuenf Minuten lang schon.");

  AddDetail( ({ "minuten", "minute" }),
    "Naja, vielleicht waren es auch erst drei oder vier Minuten.");

  AddDetail( ({ "luft" }),
    "Langsam erwachst Du wieder aus deinem entrueckten Zustand und atmest "
