  AddDetail( ({ "aquamarine", "aquamarin" }),
    "Aquamarine sind so tiefblau wie das Meer.");

  AddDetail( ({ "meer" }),
    "Zum Beispiel das vor Tijara.");

  AddDetail( ({ "beispiel" }),
    "Das war nur ein Beispiel.");

  AddDetail( ({ "tijara" }),
    "Du bist ziemlich weit davon entfernt.");

  AddDetail( ({ "onyxe", "onyx" }),
    "Tiefschwarze Onyxe glaenzen und schimmern an den Waenden.");

  AddDetail( ({ "rubine", "rubin" }),
    "Man sagt, der Rubin sei der Edelstein des Feuers.");

  AddDetail( ({ "edelstein" }),
    "Der Rubin ist ein sehr wertvoller Edelstein.");

  AddDetail( ({ "feuer" }),
    "Dies ruehrt wohl nicht zuletzt von seiner feuerroten Farbe her.");

  AddDetail( ({ "farbe" }),
    "Rubine sind feuerrot.");

  AddDetail( ({ "topase", "topas" }),
    "Topase sind gelb wie die Sonne.");

  AddDetail( ({ "sonne" }),
    "Hier drinnen siehst Du die Sonne leider nicht. Aber Du kannst sie Dir "
