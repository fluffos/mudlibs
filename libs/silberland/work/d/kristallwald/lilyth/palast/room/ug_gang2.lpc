  AddDetail( ({ "zustand" }),
    "Voellig entrueckt starrst Du auf dieses wunderschoene Bild.");

  AddDetail( ({ "locken", "haare", "haar" }),
    "Lange goldschimmernde Locken umrahmen das bildschoene Gesicht.");

  AddDetail( ({ "huefte" }),
    "Die langen Haare reichen ihr fast bis zur Huefte hinab.");

  AddDetail( ({ "gesicht", "antlitz" }),
    "Das schoene Antlitz des jungen Maedchens wird von langen goldblonden "
