  AddDetail( ({ "perlmutt" }),
    "Helles, schimmerndes Perlmutt ueberzieht hier die Waende.");

  AddDetail( ({ "edelsteine" }),
    "Viele glitzernde Edelsteine sind in Form von Mosaiken an den Waenden "
