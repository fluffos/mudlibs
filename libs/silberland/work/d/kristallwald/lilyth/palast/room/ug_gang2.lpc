  AddDetail( ({ "besucher" }),
    "Ausser Dir halten sich noch andere Besucher hier im Palast auf.");

  AddDetail( ({ "bild" }),
    "Das Bild zeigt das Portrait eines jungen Maedchens, das Dir irgendwie "
