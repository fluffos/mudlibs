  AddDetail( ({ "brunnen" }),
    "Oestlich von hier.");

  AddDetail( ({ "gaenge" }),
    "Reich verzierte Gaenge fuehren durch den Palast.");

  AddDetail( ({ "waende" }),
    "Die Waende sind reichhaltig mit Perlmutt und Edelsteinen verziert. "
