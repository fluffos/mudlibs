  AddDetail( ({ "augen", "auge" }),
    "Die grossen blaugruenen Augen blicken Dich sanft an.");

  AddDetail( ({ "seele", "grund" }),
    "Du hast fast das Gefuehl, als koennte das Maedchen bis auf den Grund "
