  AddDetail( ({ "gefuehl" }),
    "Es ist kein unangenehmes Gefuehl.");

  AddDetail( ({ "abbild" }),
    "Es ist nur ein Portrait von ihr.");

  AddDetail( ({ "wand" }),
    "Ein grosses Bild haengt an einer der Waende.");

  AddDetail( ({ "decke" }),
    "Die leicht gewoelbte, aus hellen weissen Steinen bestehende Decke ist "
    "hier in den Gaengen nicht besonders hoch.");

  AddDetail( ({ "eingangshalle" }),
    "Die befindet sich irgendwo weiter suedlich von hier.");

  AddDetail( ({ "steine", "stein" }),
    "Helle, weisse Steine bilden die Decke ueber Dir.");

  AddSound( DEFAULT_SOUND,
    "Abgesehen von den wenigen, nur gefluesterten Worten der Palastbesucher "
    "ist es hier sehr still.");

  AddSound( ({ "wort", "worte", "worten" }),
    "Du kannst kein Wort verstehen.");

  AddSound( ({ "gang" }),
    "Es ist sehr ruhig hier im Gang.");

  AddSound( ({ "besucher", "palastbesucher" }),
    "Nur fluesternd unterhalten sich die anderen Besucher hier.");

  AddSmell( DEFAULT_SMELL,
    "Du kannst einen sehr schwachen Blumenduft wahrnehmen.");

  AddSmell( ({ "blumenduft" }),
    "Blumen jedoch siehst Du auch hier nirgendwo. Merkwuerdig.");

  AddSmell( ({ "blumen" }),
    "Es sind keine Blumen zu sehen.");

  AddSpecialDetail( ({ "baenke", "bank" }),
    "strbaenke");

//--Ausgaenge--------------------------------------------------------------

  AddExit ("osten", ([ EX_DEST: "./ug_mitte",
                       EX_TESTFUNC: "exit_test",
                       EX_MSG: "nach Osten" ]) );

  AddExit ("westen", ([ EX_DEST: "./ug_bogenladen",
                        EX_TESTFUNC: "exit_test",
                        EX_MSG: "nach Westen" ]) );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "rutsch", "rutsche" }), "marmor_rutschen" );
  AddCmd( ({ "stell", "stelle" }), "sonne_vorstellen" );
  AddCmd( ({ "sitz", "sitze", "setz", "setze" }), "sitzen" );
  AddCmd( ({ "steh", "stehe" }), "aufstehen" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "soldat_ug1", REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer SpecialDetails-----------------------------------------

string strbaenke(string str)
{
  string s;
  s = "";

  if(BANK(TP))
  {
  	bank -= ({ capitalize(getuid(TP)) });

  	if(sizeof(bank) == 0)
  	{
  	        s = "Du sitzt mutterseelenalleine auf einer der Baenke "
  	        +"herum.";
  	}
  	if(sizeof(bank) == 1)
  	{
  	        s = bank[0]+" und Du habt es euch auf einer der Baenke "
  	        +"gemuetlich gemacht.";
  	}
  	if(sizeof(bank) > 1)
  	{
  	        s = "Neben Dir sitzen "+MyCountUp(bank)+" auf den Baenken.";
  	}

  	bank += ({ capitalize(getuid(TP)) });
   }
   else
   {
  	if(sizeof(bank) == 1)
  	{
  	        s = bank[0]+" hat es sich auf einer der Baenke gemuetlich "
  	        +"gemacht.";
  	}
  	if(sizeof(bank) > 1)
  	{
  	        s = "Es sitzen "+MyCountUp(bank)+" auf der Bank.";
  	}
   }
   return BS("Zu beiden Seiten des Ganges stehen kleine huebsche Baenke "
   +"aus schimmerndem weissem Holz. Sie sind fuer die Besucher des Palastes "
   +"gedacht, die sich dort ausruhen oder auch einfach nur die Atmosphaere "
   +"des Palastes geniessen wollen. "+s);
}

//--Funktionen-------------------------------------------------------------

//auf Marmor ausrutschen:
int marmor_rutschen(string str)
{
  notify_fail("Worueber moechtest Du rutschen?\n");

  if(!str || str == "") return 0;

  if(!(str == "ueber marmorboden" ||
       str == "ueber boden" ||
       str == "ueber marmor" ||
       str == "auf boden aus" ||
       str == "auf marmor aus" ||
       str == "auf marmorboden aus")) return 0;

  write(break_string("Du nimmst ein wenig Anlauf und schlitterst vergnuegt "
  +"ueber den glatten Marmor durch den Gang. *PLUMPS*\nUnd schon liegst "
  +"Du mit der Nase nach unten auf dem Boden und merkst, wie Du von allen "
  +"Seiten her missbilligend angestarrt wirst. Verlegen rappelst Du Dich "
  +"wieder auf.", 78,0,1));

  TO->Message(BS(TP->Name(WER, 1)+" schlittert froehlich ueber "
  +"den glatten Marmorboden."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;
}

//sich die Sonne vorstellen
int sonne_vorstellen(string str)
{
  notify_fail("Was moechtest Du Dir vorstellen?\n");

  if(!str || str == "") return 0;

  if(!(str == "sonne vor" ||
       str == "mir die sonne vor" ||
       str == "dir die sonne vor" ||
       str == "die sonne vor")) return 0;

  write(break_string("Du schliesst die Augen...\n\n"
  +"Ploetzlich erscheint ein riesengrosser lodernder gelber Feuerball in "
  +"Deinem Geist. (Das muss die Sonne sein) O o . denkst Du Dir und "
  +"oeffnest Deine Augen wieder, um eine Erfahrung reicher geworden.",
  78,0,1));

  TO->Message(BS(TP->Name(WER, 1)+" schliesst die Augen und scheint ganz in "
  +"Gedanken versunken."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;
}

//auf Bank sitzen:
int sitzen(string str)
{
  notify_fail("Wo moechtest Du Dich hinsetzen?\n");

  if(!str || str == "") return 0;

  if(!(str == "auf bank" ||
       str == "auf baenke")) return 0;

  if(BANK(TP))
  {
    write(BS("Aber Du sitzt doch bereits auf der Bank!"));
    return -1;
  }

  if(sizeof(bank) > 4)
  {
    write(BS("Die Baenke sind leider alle besetzt. Fuer Dich ist kein "
    +"Platz mehr."));
    return -1;
  }

  write(BS("Du machst es Dir auf einer der Baenke gemuetlich."));

  TO->Message(BS(TP->Name(WER, 1)+" macht es sich auf einer Bank "
  +"gemuetlich."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  bank += ({ capitalize(getuid(TP)) });
  return 1;
}

//von Bank aufstehen:
int aufstehen(string str)
{
  notify_fail("Was moechtest Du tun?\n");

  if(!str || str == "") return 0;

  if(!(str == "von bank auf" ||
       str == "auf")) return 0;

  if(BANK(TP))
  {
    write(BS("Du erhebst Dich frisch und ausgeruht wieder von der Bank."));

    TO->Message(BS(TP->Name(WER, 1)+" steht von der Bank auf."),
    MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  }
  else
  {
    write(BS("Aber Du sitzt doch gar nicht auf der Bank!"));
    return -1;
  }

  bank -= ({ capitalize(getuid(TP)) });
  return 1;
}

//Test beim Verlassen des Raumes, ob man auf der Bank sitzt
int exit_test(string dir)
{
  if(BANK(TP))
  {
    write(BS("Dazu solltest Du erstmal von der Bank aufstehen."));
    return 0;
  }
  return 1;
}

//Spieler logt aus waehrend des auf der Bank Sitzens
void BecomesNetDead(object spieler)
{
  if(BANK(spieler))
  bank -= ({ capitalize(getuid(spieler)) });
}

//Spieler stirbt waehrend des Sitzens
void NotifyPlayerDeath(object spieler, object killer, int lost_xp)
{
  if(BANK(spieler))
  bank -= ({ capitalize(getuid(spieler)) });
}
