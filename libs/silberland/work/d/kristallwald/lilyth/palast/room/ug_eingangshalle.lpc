#include "../def.h"

inherit "std/room";

//--Variablen&Defines------------------------------------------------------

int vogel;

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------

  vogel = DA;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Eine praechtige Eingangshalle");
  SetProp(P_INT_LONG,
    "Vor Deinen Augen breitet sich die praechtige Eingangshalle des Palastes "
    "aus. Staunend laesst Du Deinen Blick ueber die reichlich mit Gold und "
    "Silber verzierten Waende, die edlen Wandbehaenge aus hellschimmernder "
    "Seide und die bogenfoermige weisse Decke schweifen. Wunderschoene "
    "Schnitzereien aus Elfenbein schmuecken die Halle grosszuegig aus. "
    "Schneeweisse, flauschige Laeufer bedecken den glaenzenden Marmorboden "
    "und bilden so einen angenehm weichen Untergrund zum Laufen.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "augen", "auge" }),
    "Staunend schaust Du Dich in der praechtigen Halle um, die sich vor Dir "
    "ausbreitet.");

  AddDetail( ({ "eingangshalle", "halle" }),
    "Die Eingangshalle ist wirklich beeindruckend gross und praechtig "
    "geschmueckt.");

  AddDetail( ({ "palast" }),
    "Du befindest Dich im Palast der Voelker.");

  AddDetail( ({ "voelker" }),
    "Viele verschiedene Voelker leben im Silberland.");

  AddDetail( ({ "blick" }),
    "Dein Blick wandert bewundernd ueber die weitlaeufige Eingangshalle und "
    "nimmt nach und nach jede Einzelheit in sich auf.");

  AddDetail( ({ "einzelheit" }),
    "Schau Dich doch um!");

  AddDetail( ({ "gold", "silber" }),
    "Die Waende weisen zahlreiche prunkvolle Verzierungen aus Gold und "
    "Silber auf.");

  AddDetail( ({ "verzierungen", "verzierung" }),
    "Ueberall an den Waenden entdeckst Du groessere und kleinere "
    "Verzierungen aus Gold und Silber.");

  AddDetail( ({ "wand", "waende" }),
    "An den Waenden haengen edle Wandbehaenge aus schimmernder Seide. "
    "Dazwischen siehst Du zahlreiche goldene und silberne Verzierungen "
    "hervorblitzen.");

  AddDetail( ({ "wandbehang", "wandbehaenge", "behang", "behaenge" }),
    "Die Wandbehaenge sind aus feinster Seide gefertigt und weisen "
    "verschiedene Motive auf.");

  AddDetail( ({ "seide" }),
    "Die Seide schimmert in hellen Farben.");

  AddDetail( ({ "farben" }),
    "Wie fast alles in der Eingangshalle wurden auch die Wandbehaenge "
    "in sehr hellen und warmen Farben gehalten.");

  AddDetail( ({ "motive" }),
    "Es haengen insgesamt acht grosse Wandbehaenge an den Waenden, die alle "
    "ein anderes Motiv aufweisen.");

  AddDetail( ({ "motiv" }),
    "Erst jetzt faellt Dir auf, dass auf den Wandbehaengen die verschiedenen "
    "Rassen des Silberlandes abgebildet sind. Was mag das wohl fuer einen "
    "Sinn haben?");

  AddDetail( ({ "sinn" }),
    "Der bleibt Dir bisher noch verborgen.");

  AddDetail( ({ "rassen", "rasse" }),
    "Du siehst einen hochgewachsenen stattlichen Menschen, einen "
    "gemuetlichen pfeiferauchenden Hobbit, einen etwas grimmig blickenden "
    "Zwerg, einen schwerfaellig wirkenden Oger, einen grauslich entstellten "
    "Untoten, einen spitzohrigen Elfen, eine flatternde Fee, einen riesigen "
    "Troll sowie einen hinterhaeltig laechelnden Dunkelelfen von den "
    "Wandbehaengen auf Dich herabsehen.");

  AddDetail( ({ "mensch", "menschen" }),
    "Ernst schaut Dich der Mensch von seinem Wandbehang herab an. Er traegt "
    "eine schon leicht abgenutzte Waldruestung, einfache braune Lederstiefel "
    "und haelt einen grossen Bogen in seinen Haenden. Trotz seiner nicht "
    "sehr schlichten Kleidung macht er einen stattlichen Eindruck.");

  AddDetail( ({ "waldruestung", "ruestung" }),
    "Die Waldruestung sieht schon ein wenig abgenutzt aus.");

  AddDetail( ({ "lederstiefel" }),
    "Einfache, braune Lederstiefel stecken an seinen Fuessen.");

  AddDetail( ({ "fuesse" }),
    "Die Fuesse des Menschen stecken in braunen Lederstiefeln.");

  AddDetail( ({ "bogen" }),
    "Der Bogen ist gespannt.");

  AddDetail( ({ "haende" }),
    "In seinen Haenden haelt der Mensch einen grossen, gespannten Bogen.");

  AddDetail( ({ "kleidung" }),
    "Er ist sehr schlicht und einfach gekleidet.");

  AddDetail( ({ "eindruck" }),
    "Trotz seiner einfachen Kleidung macht er einen besonderen Eindruck "
    "auf Dich.");

  AddDetail( ({ "hobbit" }),
    "Der kleine Hobbit sieht fast taeuschend echt aus, wie er sich da "
    "gemuetlich an sein kleines Haeuschen lehnt und genuesslich Rauchkringel "
    "aus seiner Pfeife in den Himmel blaest.");

  AddDetail( ({ "haeuschen" }),
    "Das Haeuschen ist eher eine kleine Hoehle als ein Haus, die in einen "
    "mit frischem gruenen Gras bewachsenen Huegel hineingegraben wurde. Die "
    "Sonne scheint und Du glaubst fast, die Voegel in dem kleinen Garten vor "
    "dem Haeuschen zwitschern hoeren zu koennen.");

  AddDetail( ({ "behausung", "haeuser" }),
    "Hobbits wohnen gewoehnlich in kleinen, hoehlenaehnlichen Haeusern.");

  AddDetail( ({ "haus" }),
    "Es handelt sich eher um eine kleine Hoehle.");

  AddDetail( ({ "hoehle" }),
    "Die Hoehle wurde in einen grasbewachsenen Huegel hineingegraben.");

  AddDetail( ({ "gras" }),
    "Das Gras sieht richtig frisch und saftig aus.");

  AddDetail( ({ "huegel" }),
    "Der Huegel ist ueber und ueber mit Gras bewachsen.");

  AddDetail( ({ "sonne" }),
    "Die Sonne strahlt Dich froehlich an.");

  AddDetail( ({ "voegel" }),
    "Du kannst die Voegel beinahe zwitschern hoeren.");

  AddDetail( ({ "garten" }),
    "Ein kleiner Garten befindet sich vor dem Haeuschen.");

  AddDetail( ({ "rauchkringel", "kringel" }),
    "Kleine, runde Rauchkringel steigen aus der Pfeife in den Himmel.");

  AddDetail( ({ "pfeife" }),
    "Genuesslich raucht der Hobbit seine Pfeife und schaut Dich freundlich "
    "an.");

  AddDetail( ({ "himmel" }),
    "Die Rauchkringel steigen langsam hoch in den Himmel.");

  AddDetail( ({ "zwerg" }),
    "Der Zwerg hat einen langen Bart und schaut Dich ein wenig grimmig an. "
    "Er hat wohl gerade schlechte Laune.");

  AddDetail( ({ "bart" }),
    "Der Bart reicht fast bis zum Boden herab. Das ist sicherlich auch der "
    "Grund dafuer, dass er ein wenig schmutzig aussieht.");

  AddDetail( ({ "grund" }),
    "Angeblich hegen Zwerge ja auch eine gewisse Antipathie gegenueber dem "
    "kalten Nass.");

  AddDetail( ({ "antipathie" }),
    "Man koennte auch Abneigung sagen.");

  AddDetail( ({ "abneigung" }),
    "Antipathie.");

  AddDetail( ({ "nass" }),
    "Du weisst schon, dieses nasse, kalte, fluessige Zeugs.");

  AddDetail( ({ "zeug", "zeugs" }),
    "Die meisten Zwerge moegen es nicht besonders.");

  AddDetail( ({ "laune" }),
    "Anscheinend war der Zwerg gerade ziemlich schlecht gelaunt, als er fuer "
    "den Wandbehang Modell gestanden hat.");

  AddDetail( ({ "modell" }),
    "Sicher haette er lieber in einem dunklen Stollen nach Edelsteinen "
    "geschuerft, anstatt fuer jemanden Modell zu stehen.");

  AddDetail( ({ "edelsteine" }),
    "In den Stollen kann man nach Edelsteinen schuerfen.");

  AddDetail( ({ "stollen" }),
    "In Felonia gibt es viele unterirdische Stollen.");

  AddDetail( ({ "felonia" }),
    "Dort leben die Zwerge. Zumindest die meisten von ihnen.");

  AddDetail( ({ "zwerge" }),
    "Die meisten Zwerge leben in Felonia.");

  AddDetail( ({ "oger" }),
    "Ein schwerfaellig wirkender Oger starrt Dich von dem Wandbehang aus "
    "an. Er sieht so aus, als ob er ziemlichen Hunger haette.");

  AddDetail( ({ "hunger" }),
    "Oger sind fast immer hungrig. Eigentlich zu jeder Tageszeit.");

  AddDetail( ({ "tageszeit" }),
    "Morgens, mittags, abends...");

  AddDetail( ({ "untoter", "untoten" }),
    "Brrr, als Du das grauenhafte Abbild des Untoten betrachtest, wird Dir "
    "fast ein wenig uebel. Die Gestalt, die darauf abgebildet ist, sieht "
    "wirklich schauderhaft aus. Ein totenkopfaehnlicher Schaedel mit "
    "dunklen Augenhoehlen sitzt auf mageren, knoechernen Schultern und der "
    "lippenlose Mund ist zu einem grausamen Grinsen verzogen.");

  AddDetail( ({ "abbild" }),
    "Es sieht wirklich schauderhaft aus.");

  AddDetail( ({ "gestalt" }),
    "Eine grauenhafte Gestalt ist auf einem der Wandbehaenge abgebildet. "
    "Sie scheint einen Untoten darzustellen.");

  AddDetail( ({ "schaedel" }),
    "Er sieht fast aus wie ein Totenkopf. Schwarze, blicklose Augenhoehlen "
    "starren Dich an.");

  AddDetail( ({ "totenkopf" }),
    "Einfach graesslich.");

  AddDetail( ({ "augenhoehlen", "augenhoehle" }),
    "Du denkst   . o O (Nichts wie weg hier!)");

  AddDetail( ({ "schultern", "schulter" }),
    "Sie scheinen nur noch aus Knochen zu bestehen.");

  AddDetail( ({ "knochen" }),
    "Die ganze Gestalt besteht fast nur noch aus Knochen.");

  AddDetail( ({ "mund", "grinsen" }),
    "Der lippenlose Mund der grauenhaften Gestalt scheint Dich "
    "anzugrinsen.");

  AddDetail( ({ "elf", "elfen" }),
    "Der Elf ist von sehr edler Statur. Er hat ein feines, wohlgeformtes "
    "Gesicht und lange, spitze Ohren und strahlt eine bemerkenswerte Ruhe "
    "aus. Ehrfuerchtig folgst Du seinem weit in die Ferne gerichteten "
    "Blick.");

  AddDetail( ({ "statur" }),
    "Er sieht wirklich sehr edel aus.");

  AddDetail( ({ "gesicht" }),
    "Der Elf hat ein sehr schoenes, feingeformtes Gesicht.");

  AddDetail( ({ "ruhe" }),
    "Du spuerst, wie sich die Ruhe auf Dich uebertraegt.");

  AddDetail( ({ "ohren" }),
    "Elfen haben sehr spitze Ohren.");

  AddDetail( ({ "ferne", "fernen" }),
    "Er scheint in weite Fernen zu blicken.");

  AddDetail( ({ "fee" }),
    "Du siehst eine kleine Fee mit feinen, beinahe durchsichtigen Fluegeln, "
    "die ueber einem Teich mit kristallklarem Wasser umherflattert. Im "
    "Hintergrund kannst Du ein grosses Schloss erkennen.");

  AddDetail( ({ "fluegel" }),
    "Die kleine Fee hat sehr zarte, feingliedrige Fluegel, die sie ueber den "
    "Teich tragen.");

  AddDetail( ({ "teich" }),
    "Es schwimmen einige Seerosen auf dem Teich.");

  AddDetail( ({ "seerosen", "rosen", "seerose", "rose" }),
    "Die Seerosen bluehen in heller Pracht und geben ein herrliches Bild "
    "ab.");

  AddDetail( ({ "pracht", "bild" }),
    "Ach, ist das herrlich!");

  AddDetail( ({ "bild" }),
    "Am liebsten waerst Du jetzt dort.");

  AddDetail( ({ "wasser" }),
    "Das Wasser in dem Teich sieht kristallklar aus.");

  AddDetail( ({ "hintergrund" }),
    "Im Hintergrund kannst Du die Schemen eines grossen Schlosses erkennen.");

  AddDetail( ({ "schemen" }),
    "Du kannst es nur erahnen.");

  AddDetail( ({ "schloss" }),
    "Das scheint das beruehmte Feenschloss zu sein.");

  AddDetail( ({ "feenschloss" }),
    "Das Feenschloss befindet sich nahe des Silberwaldes.");

  AddDetail( ({ "silberwald" }),
    "Du warst bestimmt schon einmal dort.");

  AddDetail( ({ "troll" }),
    "Ein riesiger Troll ist auf einem der Wandbehaenge abgebildet. Er hat "
    "sehr kraeftige Arme und stemmt gerade einen grossen Felsen ueber seinen "
    "Kopf.");

  AddDetail( ({ "arme", "arm" }),
    "Du kannst die kraeftigen Muskeln an seinen Armen deutlich erkennen.");

  AddDetail( ({ "muskeln", "muskel" }),
    "So stark waerst Du auch gerne. Obwohl... sooo huebsch sind diese "
    "riesigen Muskelberge ja nun auch wieder nicht. Eigentlich bist Du mit "
    "Dir selbst auch ganz zufrieden.");

  AddDetail( ({ "muskelberge" }),
    "Sie sind wirklich riesig.");

  AddDetail( ({ "felsen" }),
    "Der Troll stemmt gerade einen grossen Felsen muehelos ueber seinen "
    "Kopf.");

  AddDetail( ({ "kopf" }),
    "Der Felsen schwebt hoch ueber seinem Kopf. Hoffentlich faellt er nicht "
    "runter.");

  AddDetail( ({ "dunkelelf", "dunkelelfen" }),
    "Ein leichtes Schaudern ueberkommt Dich, als Du den Dunkelelfen "
    "betrachtest. Ein hinterhaeltiges und leicht spoettisches Laecheln "
    "umspielt seine Lippen. Er traegt einen dunklen schwarzen Umhang mit "
    "einer weiten Kapuze, unter der nur eine einzelne weisse Straehne "
    "hervorguckt. Ein schwaches Funkeln verraet Dir, wo sich seine "
    "Augen befinden.");

  AddDetail( ({ "schaudern" }),
    "Du froestelst leicht.");

  AddDetail( ({ "laecheln" }),
    "Bei diesem Laecheln fuehlst Du Dich nicht sehr wohl.");

  AddDetail( ({ "lippen" }),
    "Seine Lippen sind zu einem schmalen, hinterhaeltigen Laecheln "
    "verzogen.");

  AddDetail( ({ "umhang" }),
    "Der Umhang huellt den Dunkelelfen voellig ein und schuetzt ihn vor "
    "dem Licht.");

  AddDetail( ({ "licht" }),
    "Dunkelelfen moegen kein Licht.");

  AddDetail( ({ "kapuze" }),
    "Unter der dunklen Kapuze kannst Du nichts erkennen.");

  AddDetail( ({ "straehne", "haarstraehne" }),
    "Eine weisse Haarstraehne schaut unter der Kapuze hervor.");

  AddDetail( ({ "funkeln" }),
    "Obwohl es nur ein Wandbehang ist, fuehlst Du Dich irgendwie beobachtet. "
    "Unbehaglich wendest Du Dich ab.");

  AddDetail( ({ "silberland" }),
    "Das Silberland wird von den unterschiedlichsten Voelkern bewohnt.");

  AddDetail( ({ "decke" }),
    "Die Decke befindet sich etliche Meter ueber Dir. Sie besteht "
    "aus sehr hellen weissen Steinen und ist leicht bogenfoermig.");

  AddDetail( ({ "meter" }),
    "Du schaetzt die Hoehe der Decke auf mindestens fuenfzehn, wenn nicht "
    "gar zwanzig Meter.");

  AddDetail( ({ "hoehe" }),
    "Die Decke befindet sich sehr weit ueber Dir.");

  AddDetail( ({ "steine" }),
    "Die Decke wurde aus weissen Steinen erbaut, so dass die Halle sehr hell "
    "und freundlich wirkt.");

  AddDetail( ({ "schnitzereien", "schnitzerei" }),
    "Ueberall in der Halle siehst Du grosse und kleine Statuen aus Elfenbein "
    "stehen.");

  AddDetail( ({ "statuen", "statue" }),
    "Die Statuen wurden sehr sorgfaeltig und in muehseliger Handarbeit aus "
    "Elfenbein geschnitzt. Zwei Figuren, die in der Naehe des "
    "Eingangsportals stehen, fallen Dir besonders auf.");

  AddDetail( ({ "handarbeit", "arbeit" }),
    "Jede einzelne dieser Statuen wurde in muehsamer Handarbeit geschnitzt.");

  AddDetail( ({ "naehe" }),
    "In der Naehe des Eingangsportals stehen zwei besonders schoene Figuren "
    "aus Elfenbein.");

  AddDetail( ({ "eingangsportal", "portal" }),
    "Durch das Eingangsportal kannst Du den Palast wieder verlassen.");

  AddDetail( ({ "figuren" }),
    "Die Figuren stellen zwei lebensgrosse menschliche Personen dar.");

  AddDetail( ({ "figur" }),
    "Welche der beiden Figuren moechtest Du Dir denn ansehen?");

  AddDetail( ({ "personen" }),
    "Die linke der beiden Figuren stellt ein junges Maedchen dar, die andere "
    "einen Jungen.");

  AddDetail( ({ "linke figur" }),
    "Die linke Figur stellt ein junges Maedchen dar.");

  AddDetail( ({ "rechte figur" }),
    "Die rechte Figur stellt einen Jungen dar.");

  AddDetail( ({ "maedchen" }),
    "Das Maedchen scheint etwas in seiner linken Hand zu halten.");

  AddDetail( ({ "hand", "linke hand" }),
    "Ein kleiner zinnoberroter Stein ruht in der Handflaeche des Maedchens.");

  AddDetail( ({ "handflaeche", "flaeche" }),
    "Der Stein liegt in seiner Handflaeche.");

  AddDetail( ({ "stein" }),
    "Der Stein scheint eine besondere Form zu haben.");

  AddDetail( ({ "form" }),
    "Tatsaechlich, der Stein sieht aus wie ein kleiner roter Vogel.");

  AddDetail( ({ "vogel" }),
    "Irgendjemand hat mit allergroesster Sorgfalt aus diesem kleinen "
    "Stueckchen Stein einen ebenso kleinen Vogel herausgearbeitet. Du "
    "erkennst die winzigen Federn, den Schnabel, sogar die zwei kleinen "
    "Aeuglein blinzeln Dich neugierig an.");

  AddDetail( ({ "sorgfalt" }),
    "Verwundert ueberlegst Du, wer sich wohl diese Muehe gemacht hat.");

  AddDetail( ({ "muehe" }),
    "Es war sicher aeusserst muehsam, solch ein kleines Stueckchen Stein "
    "so sorgfaeltig zu bearbeiten und alle Einzelheiten wirklichkeitsgetreu "
    "wiederzugeben.");

  AddDetail( ({ "einzelheiten" }),
    "Die vielen, sehr wirklichkeitsgetreuen Einzelheiten sind deutlich "
    "zu erkennen.");

  AddDetail( ({ "stueckchen", "stueck" }),
    "Der Stein ist wirklich sehr klein.");

  AddDetail( ({ "federn", "feder" }),
    "Die Federn sind sehr sorgfaeltig aus dem Stein herausgearbeitet und "
    "schimmern leicht roetlich.");

  AddDetail( ({ "schnabel" }),
    "Auch der kleine Schnabel ist deutlich zu erkennen.");

  AddDetail( ({ "junge", "jungen" }),
    "Der Junge blickt zu dem Maedchen hinueber und haelt seine beiden "
    "offenen Handflaechen in die Richtung des Maedchens.");

  AddDetail( ({ "handflaechen", "flaechen" }),
    "Mit offenen Handflaechen zeigt der Junge in Richtung des Maedchens.");

  AddDetail( ({ "richtung" }),
    "Die Handflaechen des Jungen weisen in Richtung des Maedchens.");

  AddDetail( ({ "elfenbein" }),
    "Das Elfenbein hat eine nahezu reine weisse Farbe.");

  AddDetail( ({ "farbe" }),
    "Die Farbe des Elfenbeins ist fast voellig weiss.");

  AddDetail( ({ "laeufer" }),
    "Auf dem Boden liegen flauschige, schneeweisse Laeufer.");

  AddDetail( ({ "marmorboden" }),
    "Zwischen den Laeufern kann man erkennen, dass der Boden aus glaenzendem "
    "weissen Marmor besteht.");

  AddDetail( ({ "marmor" }),
    "Auch der Marmor hat eine sehr schoene weisse Farbe. Da er zum Laufen "
    "jedoch viel zu glatt waere, sind ueberall weiche Laeufer auf dem Boden "
    "ausgelegt.");

  AddDetail( ({ "untergrund" }),
    "Die weichen Laeufer erzeugen ein herrliches Gefuehl, wenn man darueber "
    "geht.");

  AddDetail( ({ "laufen" }),
    "Du hast fast das Gefuehl, ueber dem Boden zu schweben.");

  AddDetail( ({ "boden" }),
    "Fast der gesamte Marmorboden ist mit flauschigen Laeufern ausgelegt.");

  AddDetail( ({ "ohr" }),
    "Du rubbelst kraeftig an Deinem Ohr herum, bis es ganz warm wird.");

  AddDetail( ({ "paerchen" }),
    "Direkt vor Dir steht ein junges Paerchen und fluestert sich leise etwas "
    "zu.");

  AddDetail( ({ "leute" }),
    "Du bist nicht alleine in der Eingangshalle. Staendig kommen Leute von "
    "draussen herein oder verlassen den Palast durch das Eingangsportal.");

  AddDetail( ({ "luft" }),
    "Die Luft in der Halle ist angenehm frisch.");

  AddSound( DEFAULT_SOUND,
    "Ab und zu dringt ein leises Fluestern an Dein Ohr, ansonsten ist es "
    "hier in der grossen Halle ungewoehnlich ruhig, was verwunderlich ist, "
    "da staendig Leute durch das grosse Eingangsportal hereinkommen oder "
    "wieder hinausgehen.");

  AddSound( ({ "fluestern" }),
    "Die Halle floesst den meisten Leuten wohl soviel Ehrfurcht ein, dass "
    "sie nur zu fluestern wagen.");

  AddSound( ({ "ohr" }),
    "Du versuchst vergeblich, an Deinem Ohr zu lauschen. Das wird so wohl "
    "nix.");

  AddSound( ({ "halle", "eingangshalle" }),
    "Hier in der Eingangshalle ist es sehr ruhig.");

  AddSound( ({ "leute" }),
    "Na, na, na. Anderer Leute Gespraeche belauschen gehoert sich doch "
    "nicht!");

  AddSound( ({ "gespraeche" }),
    "Neugierig beugst Du Dich ein wenig nach vorne und versuchst zu hoeren, "
    "was das Paerchen vor Dir sich da gerade zufluestert. Als sich die "
    "beiden ploetzlich zu Dir umdrehen und Dich argwoehnisch anstarren, "
    "schaust Du schnell in Richtung Boden, um zutiefst interessiert den "
    "glaenzenden Marmor und die wundervollen Laeufer zu begutachten und Dein "
    "vor Scham hochrotes Gesicht zu verstecken.");

  AddSound( ({ "ehrfurcht" }),
    "Erfuerchtig lauschst Du eine Weile den leisen Geraeuschen in der "
    "Halle.");

  AddSound( ({ "weile" }),
    "So, genug gelauscht.");

  AddSound( ({ "geraeusche" }),
    "Es ist sehr leise hier.");

  AddSound( ({ "eingangsportal" }),
    "Staendig kommen Leute durch das Eingangsportal herein oder gehen "
    "hinaus.");

  AddSound( ({ "voegel" }),
    "*ZWITSCHER*");

  AddSmell( DEFAULT_SMELL,
    "Frische, wuerzige Luft dringt durch das offene Eingangsportal herein.");

  AddSmell( ({ "luft" }),
    "Ahhh, das riecht guuut. So richtig frisch und wuerzig.");

  AddSmell( ({ "eingangsportal" }),
    "Wenn Du noch mehr von der frischen Luft willst, solltest Du "
    "hinausgehen.");

  AddSpecialDetail( ({ "gefuehl" }),
    "strgefuehl");

  AddSpecialDetail( ({ "koenig", "koenigin" }),
    "strkoenig");

  AddSpecialDetail( ({ "aeuglein" }),
    "straeuglein");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "raus", ([EX_DEST: "./vorhof_b1", EX_MSG: "nach draussen"]) );
  AddExit( "norden", "nach Norden#" + "./ug_gang1" );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "zwinker", "zwinkere" }), "zwinker" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer SpecialDetails-------------------------------------------

string strgefuehl(string str)
{
  string s;

  if(this_player()->QueryProp(P_GENDER) == MALE)
  {
  	s = "Du fuehlst Dich fast wie ein Koenig.";
  }
  else
  {
  	s = "Du fuehlst Dich fast wie eine Koenigin.";
  }
  return BS(s);
}

string strkoenig(string str)
{
  string s;
  s = "Sowas siehst Du da nicht!";

  if(this_player()->QueryProp(P_GENDER) == MALE && str == "koenig")
  {
  	s = "Du bist aber leider keiner. :(";
  }
  if(this_player()->QueryProp(P_GENDER) == FEMALE && str == "koenigin")
  {
  	s = "Du bist aber leider keine. :(";
  }
  return BS(s);
}

string straeuglein(string str)
{
  string s;

  if(vogel == DA)
  {
  	s = "Vergnuegt blinzeln Dich die winzigen kleinen Aeuglein an und "
  	+"zwinkern Dir zu. Moment mal! Zwinkern Dir zu?!";
  }
  else
  {
  	s = "Du hast recht, die kleinen Aeuglein sehen tatsaechlich sehr "
  	+"wirklichkeitsgetreu aus.";
  }
  return BS(s);
}

//--Funktionen-------------------------------------------------------------

//dem Vogel zuzwinkern:
int zwinker(string str)
{
  notify_fail("Wem moechtest Du zuzwinkern?\n");

  if(!str || str == "") return 0;

  if(!(str == "vogel" ||
       str == "vogel zu" ||
       str == "stein" ||
       str == "stein zu")) return 0;

  if(vogel == DA)
  {
  	write(BS("Du zwinkerst dem kleinen Vogel verschwoererisch zu."));

  	TO->Message(BS(TP->Name(WER, 1)+" zwinkert verstohlen jemandem zu."),
  	MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    vogel = WEG;
    call_out("seqvogel", 6 , TP, 1);
    return 1;
  }
  else
  {
  	write(BS("Du zwinkerst dem kleinen Vogel verschwoererisch zu. "
  	+"Stumm starrt Dich der Vogel aus seinen kleinen steinernen Aeuglein "
  	+"an. Was hattest Du denn erwartet, was passiert, wenn Du einem "
  	+"STEIN zuzwinkerst? Etwa, dass er zurueckzwinkert?"));

  	TO->Message(BS(TP->Name(WER, 1)+" zwinkert verstohlen jemandem zu."),
  	MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        return -1;
  }
}

//Sequenz fuers Zwinkern
void seqvogel(object player, int pos)
{
  string s;
    if(!player)                return;
    if(!interactive(player))   return;

  	switch(pos)
    {
      case 1:
      s = "Ploetzlich faengt der kleine Stein an zu gluehen. Seine rote "
      +"Farbe wird immer heller und leuchtender und Du weichst erschrocken "
      +"ein kleines Stueck zurueck.";
      break;

      case 2:
      s = "Als das helle Leuchten wieder verblasst, siehst Du, dass der "
      +"Stein verschwunden ist und an seiner Stelle nun ein aeusserst "
      +"lebendiger winziger Vogel sitzt, der aufgeregt zwitschert und sich "
      +"dann in die Luft erhebt.";
      break;

      case 3:
      s = "Der Vogel kreist fluegelschlagend einige Male um Deinen "
      +"Kopf herum und fliegt dann froehlich zwitschernd durch das "
      +"offene Portal hinaus.";
      break;

      case 4:
      s = "Verwirrt schaust Du Dich um, doch anscheinend hat ausser "
      +"Dir niemand den kleinen Vogel bemerkt.";
      break;

      default:
      return;
      break;
    }

    tell_object(player, BS(s));
    pos = pos + 1;
    call_out("seqvogel", 8 , player, pos);
}

void reset()
{
	::reset();
	vogel = DA;
}

