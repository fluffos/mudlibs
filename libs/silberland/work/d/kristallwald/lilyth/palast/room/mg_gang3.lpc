//=========================================================================

#include "../def.h"

inherit "std/room";

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem Palast");
  SetProp(P_INT_LONG,
    "Der Gang, der sich von Norden nach Sueden durch das Mittelgeschoss "
    "zieht, endet suedlich von hier in einem kleinen, schummrigen Laden. "
    "Der mit blauen Teppichen ausgelegte Marmorboden glaenzt und funkelt "
    "wie frisch geputzt. Eine der Waende wird fast vollstaendig von dem "
    "riesengrossen Gemaelde verdeckt, das dort haengt.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INFO, "Du spuerst, dass an dem Gemaelde mehr dran ist, als "
  "es zunaechst den Anschein hat.");

//--Details----------------------------------------------------------------

  AddDetail( ({ "gang", "gaenge" }),
    "Ein breiter Gang fuehrt von hier nach Norden und nach Sueden.");

  AddDetail( ({ "norden" }),
    "Der Gang fuehrt von Norden nach Sueden.");

  AddDetail( ({ "sueden" }),
    "Im Sueden siehst Du einen kleinen, mit schummrigem Licht erfuellten "
    "Laden.");

  AddDetail( ({ "licht" }),
    "Der Laden ist das Licht ein wenig gedaempft, soweit Du das von hier "
    "aus erkennen kannst.");

  AddDetail( ({ "mittelgeschoss" }),
    "Dort bist Du gerade.");

  AddDetail( ({ "untergeschoss" }),
    "Dort warst Du sicher schon mal.");

  AddDetail( ({ "obergeschoss" }),
    "Sieh es Dir doch mal an, wenn Du es findest.");

  AddDetail( ({ "geschoss" }),
    "Welches Geschoss meinst Du denn?");

  AddDetail( ({ "laden" }),
    "Ein kleiner Laden befindet sich im Sueden. Du kannst ihn betreten, "
    "wenn Du willst.");

  AddDetail( ({ "teppiche", "teppich" }),
    "Die Teppiche, die auf dem Marmorboden liegen, sind hellblau gefaerbt "
    "und am Rand mit langen, goldenen Fransen verziert. Ausserdem sind sie "
    "sehr weich und kuschelig, so dass man angenehm darauf laufen kann.");

  AddDetail( ({ "marmorboden" }),
    "Der blaue Marmor auf dem Boden glaenzt wie frisch poliert.");

  AddDetail( ({ "boden" }),
    "Der Marmorboden ist mit hellblauen Teppichen ausgelegt.");

  AddDetail( ({ "farbe" }),
    "Die Teppiche sind hellblau gefaerbt.");

  AddDetail( ({ "rand", "raender", "teppichraender", "teppichrand" }),
    "Die Raender sind mit goldenen Fransen verziert.");

  AddDetail( ({ "fransen" }),
    "Goldene Fransen zieren die Teppichraender.");

  AddDetail( ({ "waende", "marmorwaende" }),
    "Blaue, mit goldenen Faeden und Sprenkeln durchsetzte Marmorwaende "
    "umgeben Dich.");

  AddDetail( ({ "wand" }),
    "An einer der Waende haengt ein riesengrosses Gemaelde.");

  AddDetail( ({ "faeden", "goldfaeden" }),
    "Der Marmor ist von zarten goldenen Faeden durchzogen.");

  AddDetail( ({ "marmor" }),
    "Blauglaenzender Marmor bildet den Boden unter Deinen Fuessen.");

  AddDetail( ({ "fuesse", "fuss" }),
    "Der Boden unter Deinem Fuessen besteht aus Marmor.");

  AddDetail( ({ "sprenkel" }),
    "Goldene Sprenkel zieren den blauen Marmor.");

  AddDetail( ({ "gemaelde", "bild" }),
    "Es ueberrascht Dich nicht allzusehr, dass auch dieses Gemaelde in einen "
    "breiten, goldenen Rahmen eingelassen ist. Es zeigt eine Szene in "
    "einem Wald, der Dir sehr bekannt vorkommt.");

  AddDetail( ({ "szene" }),
    "Auf dem Bild ist eine grosse Waldlichtung dargestellt, auf eine kleine "
    "Gruppe von Menschen zu sehen ist, die entweder auf der Erde kauern oder "
    "sich an einen der grossen Baeume lehnen. Du erkennst eine junge, "
    "huebsche Frau mit goldblonden Haaren, die Du schon einmal irgendwo "
    "gesehen hast. Sie steht neben einem hochgewachsenen jungen Mann, der "
    "laechelnd auf herabschaut.");

  AddDetail( ({ "waldlichtung", "lichtung" }),
    "Es handelt sich um eine grosse Lichtung im Tethyrwald.");

  AddDetail( ({ "baeume", "baum", "pflanze", "pflanzen" }),
    "Wenn Du nicht bereits durch den Tethyrwald gekommen waerst, waerst "
    "Du sicherlich erstaunt ueber die ungewoehnliche Farbe der Pflanzen, "
    "die auf dem Bild zu sehen sind.");

  AddDetail( ({ "farbe" }),
    "Die Blaetter der Baeume sind nicht gruen, wie man es von normalen "
    "Baeumen erwarten wuerde, sondern haben eine seltsame blaue Faerbung.");

  AddDetail( ({ "blatt", "blaetter" }),
    "Die Blaetter der Baeume sind blau gefaerbt.");

  AddDetail( ({ "faerbung" }),
    "Sie ist blau statt gruen.");

  AddDetail( ({ "frau" }),
    "Du bist Dir ganz sicher, diese Frau zu kennen. Sie lehnt sich "
    "vertrauensvoll an den jungen Mann neben ihr und betrachtet die "
    "Menschen um sie herum.");

  AddDetail( ({ "haare", "haar" }),
    "Die junge Frau hat lange, goldblonde Haare.");

  AddDetail( ({ "mann" }),
    "Der junge Mann hat seinen Arm um die Schultern der Frau neben ihm "
    "gelegt und schaut laechelnd auf sie herab. Seine Augen leuchten "
    "in einem intensiven Gruen und scheinen voellig von ihrem Anblick "
    "gefesselt zu sein.");

  AddDetail( ({ "arm", "schultern", "schulter" }),
    "Er hat seinen Arm um ihre Schultern gelegt, als ob er sie "
    "beschuetzen will.");

  AddDetail( ({ "augen" }),
    "Der Blick seiner gruenen Augen ist unglaublich intensiv. Du fuehlst "
    "Dich unweigerlich von ihnen angezogen.");

  AddDetail( ({ "gruen" }),
    "Der junge Mann hat leuchtende gruene Augen.");

  AddDetail( ({ "blick", "seite" }),
    "Sein Blick ruht auf der jungen Frau an seiner Seite, scheint sich "
    "Dir jedoch kurz zuzuwenden, als Du den jungen Mann betrachtest.");

  AddDetail( ({ "menschen", "gruppe" }),
    "Eine kleine Gruppe von Menschen hat sich auf der Lichtung versammelt. "
    "Die meisten von ihnen haben sich auf der Erde zusammengekauert und "
    "scheinen zu schlafen. Andere versorgen sich gegenseitig ihre "
    "Verletzungen, die sie von einem Kampf davongetragen zu haben scheinen.");

  AddDetail( ({ "erde" }),
    "Die Menschen kauern auf der Erde oder lehnen an den dicken Staemmen "
    "der grossen Baeume.");

  AddDetail( ({ "staemme", "stamm" }),
    "Riesige Staemme ragen von der Erde empor.");

  AddDetail( ({ "verletzungen", "verletzung" }),
    "Viele der Menschen weisen leichtere und teils auch schwere Verletzungen "
    "auf. Dennoch scheinen sie nicht allzu verzweifelt zu sein, sondern "
    "sich einander ruhig und sorgsam zu helfen.");

  AddDetail( ({ "kampf", "kaempfe" }),
    "Sie scheinen schwere Kaempfe hinter sich zu haben.");

  AddDetail( ({ "wald" }),
    "Du erkennst den Tethyrwald, durch den Du hierher gekommen bist. Nur "
    "sieht er auf dem Gemaelde noch wilder und urwuechsiger aus, als er Dir "
    "zuvor erschienen ist.");

  AddDetail( ({ "tethyrwald" }),
    "Ja, der Wald auf dem Gemaelde ist eindeutig der Tethyrwald.");

  AddDetail( ({ "rahmen" }),
    "Der breite Rahmen des Gemaeldes ist vergoldet.");

  AddDetail( ({ "decke" }),
    "Die hohe Marmordecke ist ein wenig nach aussen gewoelbt.");

  AddDetail( ({ "marmordecke" }),
    "Die Decke besteht vollstaendig aus blauem Marmor.");

  AddSpecialDetail( ({ "anblick" }),
    "str_anblick");

  AddSound( DEFAULT_SOUND,
    "Hier im Palast herrscht fast voellige Ruhe.");

  AddSound( ({ "ruhe", "stille" }),
    "Wenn Du es Dir recht ueberlegst, hoerst Du ... eigentlich gar nichts.");

  AddSound( ({ "palast" }),
    "Es ist vollkommen still hier.");

  AddSmell( DEFAULT_SMELL,
    "Du schnueffelst ein wenig herum und willst Dich schon etwas "
    "Interessanterem zuwenden, als ploetzlich ein schwacher, aber "
    "dennoch deutlich wahrnehmbarer Geruch an Deine Nase dringt.");

  AddSmell( ({ "interessanteres", "interessanterem" }),
    "Dir faellt doch bestimmt etwas besseres ein, als hier herumzuforschen.");

  AddSmell( ({ "geruch" }),
    "Hm, es riecht irgendwie nach... Schweiss.");

  AddSmell( ({ "schweiss", "schweissgeruch" }),
    "Neugierig spuerst Du dem Schweissgeruch nach, als Du ploetzlich "
    "innehaeltst. Das kann doch nicht... doch, tatsaechlich, DU bist "
    "das! Baeh!");

  AddSmell( ({ "nase" }),
    "Deine hoechst empfindliche Nase zuckt ein wenig, als Du den Geruch "
    "in Dich aufsaugst.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", "nach Norden#" + "./mg_treppe2" );
  AddExit( "sueden", "nach Sueden#" + "./mg_zeichnerin" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "bild_gang3", REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer SpecialDetails-----------------------------------------

string str_anblick(string str)
{
  string s;

  if(this_player()->QueryProp(P_GENDER) == MALE)
  {
  	s = "Wer kann es ihm verdenken?";
  }
  else
  {
  	s = "Selbst Du musst zugeben, dass sie wirklich aussergewoehnlich "
  	+"huebsch ist.";
  }
  return BS(s);
}
