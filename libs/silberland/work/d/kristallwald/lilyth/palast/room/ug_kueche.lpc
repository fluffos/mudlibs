  AddDetail( ({ "pfeifenkraut" }),
    "Wenn Du eine Pfeife bei Dir hast, kannst Du es rauchen.");

  AddDetail( ({ "pfeife" }),
    "Hast Du eine?");

  AddDetail( ({ "staender" }),
    "Ein kleiner Staender aus Holz steht auf jedem der Tische. Eine kleine "
