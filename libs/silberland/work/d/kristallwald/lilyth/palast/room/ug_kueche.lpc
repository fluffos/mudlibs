  AddDetail( ({ "holz" }),
    "Die Staender bestehen aus bunt lackiertem Holz.");

  AddDetail( ({ "karte" }),
    "Das scheint wohl die Speisekarte zu sein.");

  AddDetail( ({ "raum" }),
    "Neugierig blickst Du Dich in der Kueche um.");

  AddDetail( ({ "kissen" }),
    "Die Baenke sind mit zahlreichen kunterbunten Kissen in allen moeglichen "
