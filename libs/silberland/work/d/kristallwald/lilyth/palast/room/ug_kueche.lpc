#include "../def.h"
#include <pub.h>

inherit "std/pub";

//--Variablen&Defines------------------------------------------------------

int i; //Zaehlvariable fuer Anzahl Suppe
int j; //Zaehlvariable fuer Anzahl Kraut
int kraut;

#define MyCountUp(arg) (sizeof(arg) > 1 ? \
    implode(arg[0..<2], ", ") + " und " + arg[<1] : \
    (sizeof(arg) == 0 ? "niemand" : arg[0]) )

#define BANK(wer) (member(bank, capitalize(getuid(wer)))!=-1)
string *bank=({});

string krautsorte;

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------

  i = 0;
  j = 0;
  kraut = DA;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Eine kleine Kueche");
  SetProp(P_INT_LONG,
    "Du befindest Dich in einer sehr gemuetlichen, wenn auch recht kleinen "
    "Kueche. Mehrere runde Tische sind ueberall im Raum verteilt und die mit "
    "vielen bunten Kissen ausgepolsterten Baenke und Stuehle laden zum "
    "Verweilen ein. An der rechten Wand siehst Du einen grossen Herd, auf "
    "dem dampfende Toepfe, Pfannen und ein runder Kessel stehen.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "linah");
  SetProp(P_PUBKEEPER_NAME, "Linah");
  SetProp(P_PUBMSG_NOKEEPER, "Linah ist leider nicht da.\n");
  SetProp(P_PUBMSG_NOENEMY, BS("Du glaubst doch nicht, dass Linah Dich jetzt "
  +"noch bedient?!"));
  SetProp(P_PUBMSG_NOINVITE, BS("Linah ist gerade in einen Kampf "
  +"verwickelt!"));
  SetProp(P_PUBMSG_FIGHTING, "Linah ist gerade in einen Kampf verwickelt!\n");

