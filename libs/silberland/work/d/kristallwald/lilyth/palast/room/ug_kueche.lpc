  "silbergruengemusterte kissen", "feuerrote kissen", "grasgruene kissen",
  "violettfarbene kissen", "rotweisskariertes kissen",
  "blaugruengepunktetes kissen", "sonnengelbes kissen",
  "lilaweissgestreiftes kissen", "silbergruengemustertes kissen",
