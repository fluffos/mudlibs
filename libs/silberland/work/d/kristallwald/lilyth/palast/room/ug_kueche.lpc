      "starrst Du ein wenig betruebt auf Deinen leeren Teller.\n",
      "&& geniesst eine grosse Portion Rahmschinkenscheiben.\n"}));

  AddFood("Eine riesige Fischplatte", ({"fischplatte", "fisch", "platte"}),
    550, 100, 34,
    ({"Die riesige Fischplatte macht ihrem Namen alle Ehre. Du fragst "
      "Dich allen Ernstes, wer eine solche Portion Fisch jemals "
      "aufessen soll. Irgendwie schaffst Du es trotzdem, Deinen "
      "Teller bis auf die allerletzte Graete leerzufuttern, und laesst "
      "Dich anschliessend voellig erschoepft in die weichen Kissen "
      "zuruecksinken.\n",
      "&& frisst sich durch eine riesige Fischplatte hindurch.\n"}));

//--Ausgaenge--------------------------------------------------------------

  AddExit ("nordosten", ([ EX_DEST: "./ug_mitte",
                           EX_TESTFUNC: "exit_test",
                           EX_MSG: "nach Nordosten" ]) );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "probier", "probiere", "iss", "ess", "esse" }), "suppe" );
  AddCmd( ({ "sitz", "sitze", "setz", "setze" }), "sitzen" );
  AddCmd( ({ "steh", "stehe" }), "aufstehen" );
  AddCmd( ({ "nimm", "nehm", "nehme" }), "nehmen" );
  AddCmd( ({ "oeffne" }), "oeffnen" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "linah", REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer Special Details----------------------------------------

string strspeisekarte(string str)
{
  TP->command_me("menue");
  return"";
}

//Baenke+Stuehle
string strbaenke(string str)
{
  string s;
  s = "";

  if(BANK(TP))
  {
  	bank -= ({ capitalize(getuid(TP)) });

  	if(sizeof(bank) == 0)
  	{
  	        s = "Du sitzt alleine an einem der kleinen runden Tische.";
  	}
  	if(sizeof(bank) == 1)
  	{
  	        s = bank[0]+" und Du sitzt gemuetlich an einem der kleinen "
  	        +"runden Tische beisammen.";
  	}
  	if(sizeof(bank) > 1)
  	{
  	        s = ""+MyCountUp(bank)+" sitzen gemuetlich neben Dir an "
  	        +"einem der kleinen runden Tische.";
  	}

  	bank += ({ capitalize(getuid(TP)) });
   }
   else
   {
  	if(sizeof(bank) == 1)
  	{
  	        s = bank[0]+" hat es sich an einem der Tische gemuetlich "
  	        +"gemacht.";
  	}
  	if(sizeof(bank) > 1)
  	{
  	        s = ""+MyCountUp(bank)+" haben es sich an einem der Tische "
  	        +"gemuetlich gemacht.";
  	}
   }
   return BS("Zahlreiche kunterbunte Kissen liegen auf den Stuehlen und "
   +"Baenken und laden dazu ein, sich eine Weile dort niederzulassen. "+s);
}

string strfaesschen(string str)
{
  string s;

  if(j < 3)
  {
  	s = "Die kleinen Faesschen sind bis obenhin mit einem dunkelbraunen "
  	+"Kraut gefuellt.";
  }
  else
  {
  	s = "Die kleinen Faesschen sind normalerweise bis obenhin mit "
  	+"Pfeifenkraut gefuellt, doch momentan sind sie fast voellig leer.";
  }
  return BS(s);
}

//--Funktionen-------------------------------------------------------------

//Suppe probieren:
int suppe(string str)
{
  notify_fail("Was willst Du probieren?\n");

  if(!str || str == "") return 0;

  if(!(str == "suppe" )) return 0;
  {
    if(QueryProp(P_PUBKEEPER_ID))
    {
      if(!present(QueryProp(P_PUBKEEPER_ID)))
      {
        if(i < 3)
        {
          write(BS("Du probierst ein wenig von der Huehnersuppe. Hmm, "
          +"die ist lecker! Aber sie scheint wirklich noch nicht ganz "
          +"fertig zu sein, denn besonders satt macht sie Dich auch "
          +"nicht."));

          TO->Message(BS(TP->Name(WER, 1)+" probiert ein wenig von "
          +"der Suppe im Kessel."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
          TP->heal_self(10+random(10));
          i++;
          return 1;
        }
        else
        {
          write(BS("Der Kessel mit der Suppe ist schon fast leer, "
          +"daher traust Du Dich nicht, noch mehr davon zu essen."));
          return -1;
        }
      }
      else
      {
        write(BS("Linah klopft Dir mit ihrem Kochloeffel leicht auf "
        +"die Finger und mahnt: Aber die Suppe ist doch noch gar "
        +"nicht fertig. Wenn Du Hunger hast, bestell Dir einfach "
        +"etwas von der Karte."));

        TO->Message(BS(TP->Name(WER, 1)+" versucht, sich dem "
        +"Kessel mit der Suppe zu naehern, wird jedoch von "
        +"Linah dabei aufgehalten."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        return -1;
      }
    }
  }
}

//Kraut nehmen:
int nehmen(string str)
{
  object mykraut;
  notify_fail("Was moechtest Du nehmen?\n");

  if(!str || str == "") return 0;

  if(!(str == "kraut" ||
       str == "pfeifenkraut" ||
       str == "kraut aus faesschen" ||
       str == "pfeifenkraut aus faesschen" )) return 0;

  if(j < 3)
  {
     switch(random(100))
     {
             case 0..40:
              krautsorte = "langgrundblatt";
              break;
             case 41..75:
              krautsorte = "grottenkraut";
              break;
             case 76..94:
              krautsorte = "suedstern";
              break;
             case 95..99:
              krautsorte = "nakrafulpflanze";
              break;
             default:
              break;
     }

     mykraut = clone_object("/d/huegelland/orw/pfeifenladen/obj/"+krautsorte);

     write(BS("Du nimmst Dir ein wenig "+capitalize(krautsorte)+" aus dem "
     +"Faesschen heraus."));

     TO->Message(BS(TP->Name(WER, 1)+" bedient sich am Pfeifenkraut."),
     MSGFLAG_VISUAL|MSGFLAG_NO_TP);

     if(ME_TOO_HEAVY == mykraut->move(TP,M_GET|M_SILENT))
     {
           mykraut->move(ENV(TP), M_PUT|M_SILENT);

           write(BS("Da Du das Kraut nicht mehr tragen kannst, laesst Du "
           +"es auf den Boden fallen."));

           ENV(TP)->Message(BS(TP->Name(WER, 1)+" laesst etwas zu Boden "
           +"fallen."),
           MSGFLAG_VISUAL|MSGFLAG_NO_TP);
           return -1;
     }
     j ++;
     return 1;
  }
  else
  {
  	write(BS("Es ist leider kein Kraut mehr da."));
        return -1;
  }
}

int oeffnen(string str)
{
  notify_fail("Was willst Du oeffnen?\n");

  if(!str || str == "") return 0;

  if(!(str == "klappe" ||
       str == "ofenklappe" )) return 0;

  if(QueryProp(P_PUBKEEPER_ID))
  {
    if(!present(QueryProp(P_PUBKEEPER_ID)))
    {
      write(BS("Du oeffnest die kleine Klappe und blickst in den "
      +"Ofen hinein. Hmm, lecker! Kaesekraenze!\n"
      +"Befriedigt schliesst Du die Klappe wieder."));

      TO->Message(BS(TP->Name(WER, 1)+" schaut neugierig in den Ofen "
      +"hinein."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      return 1;
    }
    else
    {
      write(BS("Linah sagt drohend: Haende weg von meinem Ofen!"));

      TO->Message(BS(TP->Name(WER, 1)+" bekommt von Linah einen "
      +"drohenden Blick zugeworfen, als "
      +(PL->QueryProp(P_GENDER)==MALE?"er":"sie")+" sich am Ofen "
      +"zu schaffen machen will."),
      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      return -1;
    }
  }
}

void reset()
{
	::reset();
	kraut = DA;
	i = 0;
	j = 0;
}

//auf Bank oder Stuhl sitzen:
int sitzen(string str)
{
  notify_fail("Wo moechtest Du Dich hinsetzen?\n");

  if(!str || str == "") return 0;

  if(str == "auf bank" ||
     str == "auf baenke" ||
     str == "auf stuhl" ||
     str == "auf stuehle")
  {
    if(BANK(TP))
    {
      write(BS("Du sitzt doch bereits an einem der Tische!"));
      return -1;
    }
    if(sizeof(bank) > 4)
    {
      write(BS("Die Tische sind leider schon alle besetzt."));
      return -1;
    }

    write(BS("Du laesst Dich an einem der Tische nieder."));

    TO->Message(BS(TP->Name(WER, 1)+" nimmt an einem der Tische Platz."),
    MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    bank += ({ capitalize(getuid(TP)) });
    return 1;
  }
  return 0;
}

//von Bank oder Stuhl aufstehen:
int aufstehen(string str)
{
  notify_fail("Was moechtest Du tun?\n");

  if(!str || str == "") return 0;

  if(!(str == "auf")) return 0;

  if(BANK(TP))
  {
    write(BS("Mit einigem Bedauern erhebst Du Dich wieder. "
    +"Schade, es war doch gerade so gemuetlich."));

    TO->Message(BS(TP->Name(WER, 1)+" erhebt sich von einem der Tische."),
    MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    bank -= ({ capitalize(getuid(TP)) });
    return 1;
  }

  write("Aber Du sitzt doch gar nicht an einem der Tische!\n");
  return -1;
}

//Test beim Verlassen des Raumes, ob man auf Bank od. Stuhl sitzt
//bzw. sich in Linahs Sequenz befindet:
int exit_test(string dir)
{
  object linah;
  linah = present("linah", TO);

  if(!TP) return 0;
  if(!interactive(TP)) return 0;

  if(BANK(TP))
  {
    write(BS("Dazu solltest Du erst einmal aufstehen."));
    return 0;
  }

  if(!linah) return 1;

  if(member(linah->holded(), capitalize(getuid(TP))) != -1)
  {
    write(BS("Aber Linah redet doch gerade mit Dir!"));
    return 0;
  }

  return 1;
}

//Spieler logt aus waehrend des Sitzens
void BecomesNetDead(object spieler)
{
  if(BANK(spieler))
  {
        bank -= ({ capitalize(getuid(spieler)) });
  }

  return;
}

//Spieler stirbt waehrend des Sitzens
void NotifyPlayerDeath(object spieler, object killer, int lost_xp)
{
  if(BANK(spieler))
  bank -= ({ capitalize(getuid(spieler)) });
}
