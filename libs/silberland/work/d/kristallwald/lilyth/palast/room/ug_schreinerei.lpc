  AddDetail( ({ "handsaege", "saege" }),
    "Solch eine Handsaege nennt man auch Fuchsschwanz.");

  AddDetail( ({ "fuchsschwanz" }),
    "Vermutlich, weil das Saegeblatt (mit ein wenig Phantasie) so aussieht "
