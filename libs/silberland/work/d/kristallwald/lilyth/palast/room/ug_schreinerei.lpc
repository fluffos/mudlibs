  AddDetail( ({ "werkstatt" }),
    "Man koennte auch Arbeitsraum dazu sagen.");

  AddDetail( ({ "wand" }),
    "An der linken Wand stehen mehrere Bretter und Holzleisten in "
    "verschiedensten Groessen in unordentlichen Reihen aneinander gelehnt. "
    "Darueber befindet sich ein langes dunkles Regal, das mit allerlei "
    "Dingen gefuellt ist.");

  AddDetail( ({ "bretter", "holzbretter", "holzleisten", "brett", "holzbrett",
  "holzleiste" }),
    "Die Bretter und Holzleisten wurden noch nicht bearbeitet und weisen "
    "daher noch viele scharfkantige Splitter auf.");

  AddDetail( ({ "splitter" }),
    "Fass die Bretter lieber nicht an.");

  AddDetail( ({ "groessen", "groesse" }),
    "Die Bretter und Holzleisten sind alle unterschiedlich lang, breit und "
