#include "../def.h"
#include <laden.h>

inherit "std/laden";

//--Variablen&Defines------------------------------------------------------

string strtafel(string str);

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------

  RemoveCmd( ({"zeige", "zeig"}) );
  RemoveFixedObject("/obj/boerse");
  RemoveFixedObject("/obj/stempel");
  RemoveItem("/obj/entsorg");

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einer unordentlichen Schreinerei");
  SetProp(P_INT_LONG,
    "Ein heilloses Durcheinander umgibt Dich von allen Seiten. Ueberall "
    "stehen hier Schraenke, Kommoden, Tische und Stuehle mitten im Raum "
    "herum. An einer Wand lehnen Bretter und Holzleisten in vielen "
    "verschiedenen Groessen. Die breite Hobelbank, auf der zahlreiche "
    "Werkzeuge liegen, sowie der mit Saegespaenen uebersaehte Holzfussboden "
    "weisen darauf hin, dass dies der Arbeitsraum eines Schreiners ist.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_SHOPKEEPER_ID, "fredolin");
  SetProp(P_SHOPKEEPER_NAME, "Fredolin");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetStorageRoom(ROOM "ug_lagerraum_schreinerei" );

//--Details----------------------------------------------------------------

  AddDetail( ({ "durcheinander" }),
    "Hier herrscht ein absolutes Chaos.");

  AddDetail( ({ "chaos" }),
    "Das Chaos regiert die Welt.");

  AddDetail( ({ "welt" }),
    "Also hier regiert es ganz sicher. ;)");

  AddDetail( ({ "seiten", "seite" }),
    "Durch die vielen mitten im Raum herumstehenden Moebelstuecke ist es "
    "hier ganz schoen eng. Hoffentlich bekommst Du keine Platzangst.");

  AddDetail( ({ "moebelstuecke", "moebelstueck", "stuecke" }),
    "Ueberall stehen hier halbfertige Schraenke, wackelige Kommoden, Tische "
    "und Stuehle mitten im Weg herum.");

  AddDetail( ({ "glueck" }),
    "Du atmest erleichtert auf.");

  AddDetail( ({ "schraenke" }),
    "Die meisten der Schraenke, die hier herumstehen, sind erst halbfertig "
    "und haben noch keine Schranktueren oder warten auf den Anstrich.");

  AddDetail( ({ "schranktueren", "tueren", "schranktuer", "tuer" }),
    "Ein Schrank ohne Schranktueren ist wie ... eine Schreinerei ohne "
    "Schreiner.");

  AddDetail( ({ "schrank" }),
    "Ein guter Schrank besitzt Schranktueren, mit denen man ihn schliessen "
    "kann.");

  AddDetail( ({ "anstrich" }),
    "Erst wenn die Schraenke fertig gezimmert sind, werden sie mit Farbe "
    "angestrichen.");

  AddDetail( ({ "kommoden" }),
    "Naja, eigentlich ist nur eine der Kommoden wackelig.");

  AddDetail( ({ "kommode" }),
    "Versuchsweise tippst Du die Kommode mit einem Finger an und sie beginnt "
    "auch prompt zu wackeln.");

  AddDetail( ({ "finger" }),
    "Mit nur einem Finger kannst Du die Kommode zum Wackeln bringen.");

  AddDetail( ({ "wackeln" }),
    "Jetzt siehst Du auch, warum die Kommode so wackelt. Sie hat nur drei "
    "Fuesse.");

  AddDetail( ({ "fuesse" }),
    "Die Kommode steht sehr wackelig auf ihren drei hoelzernen Fuessen.");

  AddDetail( ({ "tische", "tisch" }),
    "Die Tische scheinen nur noch darauf zu warten, dass sie gestrichen und "
    "ueberlackiert werden, ansonsten sind sie bereits fertiggestellt.");

  AddDetail( ({ "stuehle", "stuhl" }),
    "Die Stuehle sehen nicht besonders vertrauenserweckend aus. Du solltest "
    "Dich lieber nicht draufsetzen.");

  AddDetail( ({ "weg" }),
    "Der Weg durch den Raum wird Dir durch die vielen herumstehenden "
    "Moebelstuecke fast versperrt.");

  AddDetail( ({ "platzangst" }),
    "Hmmm... wieso kommt dieser grosse Schrank da ploetzlich so bedrohlich "
    "auf Dich zu? Und dieses lange dunkle Regal dort hinten schaut auch so "
    "boese herueber... Hilfe!!");

  AddDetail( ({ "hilfe" }),
    "Du schluckst trocken. *GULP*\n"
    "Dann erst faellt Dir ein, dass Du ja gar keine Platzangst hast. "
    "Puh, Glueck gehabt!");

  AddDetail( ({ "raum", "laden" }),
    "Du stehst mitten in der mit zahlreichen Moebelstuecken ueberfuellten "
