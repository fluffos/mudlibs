//--Funktionen fuer SpecialDetails-----------------------------------------

string strtafel(string str)
{
  TP->command_me("zeige");
  return "";
}

string strschreinerei(string str)
{
  string s;

  if(present("fredolin"))
  {
  	s = "Das hier ist eine Schreinerei. Und der Schreiner ist auch "
  	+"gerade da.";
  }
  else
  {
  	s = "So wie diese hier beispielsweise.";
  }
  return BS(s);
}

//--Funktionen-------------------------------------------------------------

//auf Stuhl setzen
int sitzen(string str)
{
  notify_fail("Wo moechtest Du Dich hinsetzen?\n");

  if(!str || str == "") return 0;

  if(!(str == "auf stuhl" ||
       str == "auf stuehle" ||
       str == "dich auf stuhl" ||
       str == "dich auf stuehle" )) return 0;

  write(BS("Mit aeusserster Vorsicht laesst Du Dich auf einem der "
  +"Stuehle nieder, der daraufhin bedenklich zu knarren anfaengt. Da Du hier "
  +"nichts kaputtmachen willst, stehst Du lieber ganz schnell wieder auf."));

  TO->Message(BS(TP->Name(WER, 1)+" laesst sich vorsichtig auf einem der "
  +"Stuehle nieder, springt dann jedoch schnell wieder auf."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;
}

//Bretter anfassen
int bretter(string str)
{
  notify_fail("Was moechtest Du anfassen?\n");

  if(!str || str == "") return 0;

  if(!(str == "bretter an" ||
       str == "holzbretter an" ||
       str == "leisten an" ||
       str == "holzleisten an" ||
       str == "brett an" )) return 0;

  write(BS("Du hebst eines der unbearbeiteten Holzbretter an und "
  +"laesst es dann mit einem leisen Aufschrei wieder fallen. Mit "
  +"wehleidiger Miene ziehst Du einen langen Splitter aus Deinem blutenden "
  +"Zeigefinger."));
  TP->AddHp(-7);

  TO->Message(BS(TP->Name(WER, 1)+" hebt unvorsichtig eines der mit "
  +"Splittern uebersaehten Holzbretter hoch, laesst es dann jedoch mit "
  +"einem leisen Aufschrei wieder fallen."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

int oeffnen(string str)
{
  notify_fail("Was willst Du oeffnen?\n");

  if(!str || str == "") return 0;

  if(!(str == "kaestchen" ||
       str == "kaesten" ||
       str == "holzkaestchen" ||
       str == "holzkaesten" ||
       str == "kasten" ||
       str == "holzkasten" )) return 0;

  write(BS("Du versuchst, eines der Kaestchen zu oeffnen, versagst jedoch "
  +"erbaermlich."));

  TO->Message(BS(TP->Name(WER, 1)+" fummelt an etwas herum.\n"),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

int benutzen(string str)
{
  notify_fail("Was willst Du benutzen?\n");

  if(!str || str == "") return 0;

  if(!(str == "phantasie" ||
       str == "deine phantasie" ||
       str == "meine phantasie" )) return 0;

  write(BS("Du benutzt Deine Phantasie und siehst auf einmal einen grossen, "
  +"roten Fuchs durch die Schreinerei springen. Doch so schnell, "
  +"wie er gekommen ist, verschwindet er auch schon wieder."));

  TO->Message(BS(TP->Name(WER, 1)+" denkt laut ueber Fuechse nach."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

//Kein verkaufen hier:
int sell(string str, int f)
{
  string prefix;

  if (!prefix=CheckKeeper(2)) return 0;

  write(capitalize(QueryProp(P_SHOPKEEPER_NAME))+
       " bedauert: Tut mir leid, aber ich kaufe keine Sachen an.\n");
  return -1;
}

//-------------------------------------------------------------------------

int regale(object ob)
{
  if(ob->id("\n_regal")) return 1;
  return 0;
}

int stuehle(object ob)
{
  if(ob->id("\n_stuhl")) return 1;
  return 0;
}

int tische(object ob)
{
  if(ob->id("\n_tisch")) return 1;
  return 0;
}

int betten(object ob)
{
  if(ob->id("\n_bett")) return 1;
  return 0;
}

int sonstige(object ob)
{
  if(ob->id("\n_sonstige")) return 1;
  return 0;
}

int lagerraum()
{
  int i,k;
  //alle Moebelkategorien bekommen ein eigenes Array + Filter-Funktion oben
  mixed stuehle, tische, regale, betten, sonstige;
  string room, s;
  object lagerraum;

  s = "  *** Zur Zeit habe ich folgende Sachen im Angebot: ***\n\n";

  room = ROOM "ug_lagerraum_schreinerei";
  lagerraum = find_object(room);

  //wenn Lagerraum nicht geladen ist, abbrechen:
  if(!lagerraum) return 0;

  //Kategorie 1: Stuehle, Sessel, Sofas:
  stuehle = filter_array(all_inventory(lagerraum), "stuehle");

  s += "Stuehle, Sessel, Sofas:\n";

  if(!sizeof(stuehle)) { s += "- leider ausverkauft -\n"; }

  if(stuehle)
  {
     for(i=0; i<sizeof(regale);i++)
     {
        s += "- "+(stuehle[i]->QueryProp(P_SHORT)+" "
          +".................................")[0..40];

        if(QueryBuyValue(stuehle[i])<1000) { s += " "; }

        s += " "+QueryBuyValue(stuehle[i])+ " Muenzen.\n";
     }
  }

  //Kategorie 2: Tische:
  tische = filter_array(all_inventory(lagerraum), "tische");

  s += "\n";
  s += "Tische:\n";

  if(!sizeof(tische)) { s += "- leider ausverkauft -\n"; }

  if(tische)
  {
     for(i=0; i<sizeof(tische);i++)
     {
        s += "- "+(tische[i]->QueryProp(P_SHORT)+" "
          +".................................")[0..40];

        if(QueryBuyValue(tische[i])<1000) { s += " "; }

        s += " "+QueryBuyValue(tische[i])+ " Muenzen.\n";
     }
  }

  //Kategorie 3: Schraenke, Regale, Kommoden:
  regale = filter_array(all_inventory(lagerraum), "regale");

  s += "\n";
  s += "Schraenke, Regale, Kommoden:\n";

  if(!sizeof(regale)) { s += "- leider ausverkauft -\n"; }

  if(regale)
  {
     for(i=0; i<sizeof(regale);i++)
     {
        s += "- "+(regale[i]->QueryProp(P_SHORT)+" "
          +".................................")[0..40];

        if(QueryBuyValue(regale[i])<1000) { s += " "; }

        s += " "+QueryBuyValue(regale[i])+ " Muenzen.\n";
     }
  }

  //Kategorie 4: Betten:
  betten = filter_array(all_inventory(lagerraum), "betten");

  s += "\n";
  s += "Betten:\n";

  if(!sizeof(betten)) { s += "- leider ausverkauft -\n"; }

  if(betten)
  {
     for(i=0; i<sizeof(betten);i++)
     {
        s += "- "+(betten[i]->QueryProp(P_SHORT)+" "
          +".................................")[0..40];

        if(QueryBuyValue(betten[i])<1000) { s += " "; }

        s += " "+QueryBuyValue(betten[i])+ " Muenzen.\n";
     }
  }

  //Kategorie 5: Weiteres Hauszubehoer
  sonstige = filter_array(all_inventory(lagerraum), "sonstige");

  s += "\n";
  s += "Weiteres Hauszubehoer:\n";

  if(!sizeof(sonstige)) { s += "- leider ausverkauft -\n"; }

  if(sonstige)
  {
     for(i=0; i<sizeof(sonstige);i++)
     {
        s += "- "+(sonstige[i]->QueryProp(P_SHORT)+" "
          +".................................")[0..40];

        if(QueryBuyValue(sonstige[i])<1000) { s += " "; }

        s += " "+QueryBuyValue(sonstige[i])+ " Muenzen.\n";
     }
  }

  write(break_string(s, 78, 0, 1));
  return 1;
}

//Nachfrage mitloggen, zumindest die erste Zeit
int buy(string str)
{
   PALASTMASTER->Msg("Schreiner: "+TP->Name()+" will '"+str+"' kaufen", 2);
   return ::buy(str);
}

