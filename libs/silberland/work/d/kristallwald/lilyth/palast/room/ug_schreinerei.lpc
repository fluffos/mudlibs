  AddDetail( ({ "reihen", "reihe" }),
    "Die Bretter sind in unordentlichen Reihen an die Wand angelehnt.");

  AddDetail( ({ "hobelbank", "bank" }),
    "Die Hobelbank bildet den eigentlichen Arbeitsbereich des Schreiners. "
    "Hier wird gehobelt, gesaegt, geschliffen... eben alles, was ein "
    "Schreiner so macht.");

  AddDetail( ({ "arbeitsbereich", "bereich" }),
    "Das ist dort, wo gearbeitet wird. ;)");

  AddDetail( ({ "werkzeuge", "werkzeug" }),
    "Viele Werkzeuge liegen auf der Hobelbank herum. Unter anderem "
