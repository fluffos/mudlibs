  AddDetail( ({ "saegespaene" }),
    "Der ganze Boden ist mit Saegespaenen uebersaeht.");

  AddDetail( ({ "arbeitsraum" }),
    "Dies ist eindeutig der Arbeitsraum eines Schreiners. Eines ziemlich "
