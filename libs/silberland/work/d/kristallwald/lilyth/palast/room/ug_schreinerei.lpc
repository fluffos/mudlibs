  AddDetail( ({ "saegeblatt" }),
    "Das Saegeblatt der Handsaege sieht aus wie ein Fuchsschwanz.");

  AddDetail( ({ "phantasie" }),
    "Dafuer reicht Deine Phantasie doch sicherlich aus.");

  AddDetail( ({ "schwanz" }),
    "Man sagt auch Lunte dazu.");

  AddDetail( ({ "lunte" }),
    "Oder Rute.");

  AddDetail( ({ "rute" }),
    "Das alles bezeichnet den Schwanz eines Fuchses.");

  AddDetail( ({ "fuchs" }),
    "Du siehst hier nirgendwo einen Fuchs. Benutze Deine Phantasie.");

  AddDetail( ({ "schraubzwingen", "schraubzwinge", "zwingen", "zwinge" }),
    "Die Schraubzwingen dienen dazu, kleinere Holzstuecke an der Hobelbank "
