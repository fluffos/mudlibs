#include "../def.h"

inherit "std/room";

//--Variablen&Defines------------------------------------------------------

int teufel;
int puzzle;

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------

  teufel = DA;
  puzzle = DA;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem Spielzimmer");
  SetProp(P_INT_LONG,
    "Dieses kleine Zimmer scheint das Spielzimmer fuer die Kinder zu "
    "sein. Ueberall auf dem Boden liegen Spielsachen herum. Der weisse "
    "Holzfussboden ist mit einem flauschigen, weichen Teppich bedeckt. "
    "An einer Wand steht ein Schrank, daneben siehst Du eine kleine "
    "Kommode mit zwei halbgeoeffneten Schubladen.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "zimmer", "spielzimmer" }),
    "Das hier ist das Spielzimmer fuer die Kinder.");

  AddDetail( ({ "kinder" }),
    "Sie halten sich oft hier oben auf.");

  AddDetail( ({ "holzfussboden", "fussboden", "boden" }),
    "Der Fussboden besteht aus weissem Holz. Ein weicher Teppich liegt "
    "darauf. Zudem liegen zahllose Spielsachen ueberall verstreut herum.");

  AddDetail( ({ "teppich" }),
    "Der Teppich ist sehr weich und kuschelig, so dass die Kinder nicht "
    "auf dem harten Holzfussboden spielen muessen.");

  AddDetail( ({ "spielsachen", "sachen" }),
    "Ueberall auf dem Boden verstreut liegen zahlreiche Spielsachen. "
    "Du siehst ein paar Stofftiere, eine Spielzeugeisenbahn, ein "
    "Schaukelpferd, einen kleinen Miniaturbauernhof und ein grosses "
    "Puzzle. Auch einige Kinderbuecher liegen hier herum.");

  AddDetail( ({ "teddybaeren", "teddybaer", "baer", "baeren", "teddy" }),
    "Ein kleiner, hellbrauner Teddy mit schwarzen Knopfaugen sitzt mitten "
    "auf dem Teppich und blinzelt Dir lustig zu.");

  AddDetail( ({ "knopfaugen", "knopfauge" }),
    "Der Teddy hat kleine schwarze Knopfaugen, die Dir froehlich "
    "zublinzeln.");

  AddDetail( ({ "hase", "hasen" }),
    "Der kleine Hase hat ein kuscheliges Fell und kleine, schneeweisse "
    "Pfoten, zwischen denen er ein gruenes Loewenzahnblatt haelt. Mit "
    "seinen langen Hasenzaehnen knabbert er still und gluecklich daran "
    "herum.");

  AddDetail( ({ "fell" }),
    "Das Fell des Hasen ist kuschelig weich.");

  AddDetail( ({ "pfoten", "pfoten" }),
    "Zwischen seinen kleinen Pfoten haelt er ein Loewenzahn.");

  AddDetail( ({ "loewenzahn", "loewenzahnblatt", "blatt" }),
    "Es sieht gruen und saftig aus.");

  AddDetail( ({ "hasenzaehnchen", "hasenzaehne", "hasenzahn", "zahn",
  "zaehne" }),
    "Der Hase hat recht lange Zaehne, mit denen er an dem "
    "Loewenzahn herumknabbert.");

  AddDetail( ({ "drache" }),
    "Der gruene Drache besteht aus weichem Pluesch und hat grosse "
    "dunkle Kulleraugen. Er sieht gar nicht aus wie die grossen boesen "
    "Drachen, denen Du bislang begegnet bist.");

  AddDetail( ({ "pluesch" }),
    "Der Drache besteht aus Pluesch, wie auch die anderen Stofftiere hier.");

  AddDetail( ({ "kulleraugen", "kullerauge" }),
    "Der Drache hat grosse, runde Kulleraugen, die Dich neugierig "
    "anzublicken scheinen.");

  AddDetail( ({ "drachen" }),
    "Du bist schon so manchem Drachen begegnet, aber so niedlich "
    "wie dieser hier sahen die meisten von ihnen eher nicht aus.");

  AddDetail( ({ "spielzeugeisenbahn", "eisenbahn" }),
    "Die Spielzeugeisenbahn besteht aus einer kleinen, roten Lokomotive "
    "und drei kleinen Waggons. Ausserdem sind im ganzen Zimmer schmale "
    "Eisenbahngleise kreisfoermig verlegt worden.");

  AddDetail( ({ "lokomotive" }),
    "Die kleine rote Lokomotive wurde in grossartiger Feinarbeit "
    "handgeschnitzt. Du kannst das kleine Fuehrerhaeuschen und den "
    "Dampfkessel deutlich erkennen. Es reizt Dich irgendwie, damit "
    "zu spielen.");

  AddDetail( ({ "feinarbeit", "arbeit" }),
    "Sie wurde sorgfaeltig handgeschnitzt.");

  AddDetail( ({ "fuehrerhaeuschen", "haeuschen" }),
    "Es wurde originalgetreu nachgebildet.");

  AddDetail( ({ "dampfkessel", "kessel" }),
    "Er wurde originalgetreu nachgebildet.");

  AddDetail( ({ "waggons" }),
    "Drei kleine Waggons sind an die Lokomotive angehaengt worden.");

  AddDetail( ({ "eisenbahngleise", "gleise", "eisenbahngleis",
  "gleise" }),
    "Sie laufen kreuz und quer durch das ganze Zimmer. Sei vorsichtig, "
    "dass Du nicht darueber stolperst.");

  AddDetail( ({ "schaukelpferd", "pferd" }),
    "Das Schaukelpferd sieht fast aus wie ein echtes Pferd, abgesehen "
    "von den abgerundeten Schienen, die es anstatt von normalen Beinen "
    "hat. Es scheint leider kaputt zu sein, denn die eine der beiden "
    "Schienen ist zerbrochen.");

  AddDetail( ({ "schienen", "schiene" }),
    "Das Schaukelpferd hat abgerundete Schienen, auf denen es schaukeln "
    "koennte, wenn nicht eine der beiden Schienen zerbrochen waere.");

  AddDetail( ({ "bein", "beine" }),
    "Es hat keine Beine, sondern Schienen.");

  AddDetail( ({ "bauernhof", "miniaturbauernhof" }),
    "Ein kleiner Miniaturbauernhof steht auf dem Teppich. Er kommt Dir "
    "seltsam bekannt vor, als Du das kleine Bauernhaus und die Staelle "
    "betrachtest. Sogar ein paar Spielfiguren kannst Du sehen.");

  AddDetail( ({ "bauernhaus", "haus" }),
    "Das Bauernhaus ist klein und schlicht eingerichtet. Es kommt Dir sehr "
    "bekannt vor. Du hast irgendwie das Gefuehl, dass Du es schon einmal "
    "gesehen hast.");

  AddDetail( ({ "gefuehl" }),
    "Du bist Dir ziemlich sicher.");

  AddDetail( ({ "staelle", "schweinestaelle", "pferdestaelle" }),
    "Zu einem richtigen Bauernhof gehoeren auch ein paar Schweine- und "
    "Pferdestaelle.");

  AddDetail( ({ "spielfiguren", "figuren" }),
    "Du siehst einen staemmigen Bauern, eine Baeuerin, einen Jungen und "
    "ein Maedchen. Du erkennst sogar eine kleine Katze.");

  AddDetail( ({ "katze" }),
    "Sie sieht ziemlich frech aus.");

  AddDetail( ({ "bauer", "bauern", "junge" }),
    "Er kommt Dir sehr bekannt vor.");

  AddDetail( ({ "baeuerin" }),
    "Sie kommt Dir ziemlich bekannt vor.");

  AddDetail( ({ "maedchen" }),
    "Es kommt Dir irgendwie bekannt vor.");

  AddDetail( ({ "xaver", "hansi", "greti", "sophie" }),
    "Tatsaechlich! Jetzt weisst Du, woran Dich der Bauernhof die ganze Zeit "
    "erinnert hat. Das ist der Bauernhof, der in der Naehe von Midas liegt, "
    "mit Xaver, dem Bauern, seiner Frau Sophie und Hansi und Greti, den "
    "beiden Kindern. Du hast wirklich ein gutes Gedaechtnis!");

  AddDetail( ({ "gedaechtnis" }),
    "Es funktioniert noch einwandfrei.");

  AddDetail( ({ "ansicht" }),
    "Das Puzzle zeigt eine kleinere Ansicht des Palastes, in dem Du Dich "
    "gerade befindest.");

  AddDetail( ({ "palast" }),
    "Dort befindest Du Dich gerade.");

  AddDetail( ({ "maerchenbuecher", "kinderbuecher", "buecher", "buch",
  "maerchenbuch", "kinderbuch" }),
    "Einige, mit bunten Zeichnungen ausgestattete Maerchenbuecher liegen "
    "aufgeschlagen auf dem Boden. Du kannst einige der Titel lesen.");

  AddDetail( ({ "zeichnung", "zeichnungen" }),
    "Die Maerchenbuecher sind mit bunten Zeichnungen versehen.");

  AddDetail( ({ "titel" }),
    "Du kannst sie lesen.");

  AddDetail( ({ "schrank" }),
    "Der Schrank besteht aus hellem Fichtenholz. Er hat zwei grosse "
    "Schranktueren, die im Moment geschlossen sind.");

  AddDetail( ({ "fichtenholz" }),
    "Der Schrank besteht aus hellem Fichtenholz.");

  AddDetail( ({ "schranktueren", "tueren", "schranktuer", "tuer" }),
    "Die Schranktueren sind geschlossen.");

  AddDetail( ({ "moment" }),
    "Im Moment ist der Schrank geschlossen.");

  AddDetail( ({ "moment" }),
    "Der Schrank ist geschlossen.");

  AddDetail( ({ "kommode" }),
    "Die Kommode ist niedrig genug, dass die Kinder problemlos an ihre "
    "beiden Schubladen heranreichen koennen.");

  AddDetail( ({ "schubladen", "schublade" }),
    "Die Schubladen stehen ein wenig offen, so dass Du ihren Inhalt "
    "deutlich sehen kannst.");

  AddDetail( ({ "inhalt" }),
    "Die linke der beiden Schubladen ist leer, doch in der rechten siehst "
    "Du ein paar alte Malstifte liegen.");

  AddDetail( ({ "malstifte", "stifte", "malstift", "stift" }),
    "In der rechten Schublade liegen ein paar bunte Malstifte. Sie "
    "sehen schon ziemlich abgenutzt aus und Du glaubst nicht, dass man "
    "damit noch etwas malen koennte.");

  AddDetail( ({ "waende", "holz" }),
    "Die Waende bestehen aus weissem Holz, ebenso wie die Decke und der "
    "Boden.");

  AddDetail( ({ "wand" }),
    "An einer Wand siehst Du einen Schrank und eine niedrige Kommode "
    "stehen.");

  AddDetail( ({ "decke" }),
    "Die niedrige Decke besteht aus dem gleichen weissen Holz wie der "
    "Fussboden.");

  AddSpecialDetail( ({ "stofftiere", "tiere" }),
    "strstofftiere");

  AddSpecialDetail( ({ "teufel" }),
    "strteufel");

  AddSpecialDetail( ({ "hoerner", "horn" }),
    "strhoerner");

  AddSpecialDetail( ({ "kopf" }),
    "strkopf");

  AddSpecialDetail( ({ "ecke" }),
    "strecke");

  AddSpecialDetail( ({ "puzzle" }),
    "strpuzzle");

  AddSpecialDetail( ({ "ecke" }),
    "strecke");

  AddReadDetail( ({ "titel" }),
    "Du liest 'Maerchen und Sagen aus dem Tethyrwald', "
    "'Der kleine Teufel, mit dem niemand spielen wollte' und "
    "'Die Geschichte vom boesen Fraggle'.");

  AddReadDetail( ({ "maerchen", "sagen", "tethyrwald" }),
    "Du blaetterst ein wenig in dem Maerchenbuch herum und legst es "
    "dann wieder zurueck. Nicht sonderlich interessant.");

  AddReadDetail( ({ "teufel" }),
    "Neugierig nimmst Du das Buch in die Hand und vertiefst Dich in die "
    "Geschichte.\n\nSie handelt von einem kleinen, schwarzen Teufel, der "
    "wegen seines teuflischen Aussehens (zwei rote Hoerner wuchsen aus "
    "seinem Kopf) von den anderen Spielzeugen immer nur gehaenselt oder, "
    "was noch schlimmer war, einfach gemieden wurde. Dabei wuenschte er "
    "sich nichts sehnlicher, als endlich einen Freund zu finden, mit dem "
    "er spielen konnte. Doch eines Tages, nachdem der Junge, der ihn als "
    "Geburtstagsgeschenk bekommen hatte, ihn achtlos mit in den Wald nahm "
    "und dort verlor, fand ihn ein kleines Maedchen. Als der Teufel "
    "bitterlich weinte und dem Maedchen seine Geschichte erzaehlte, hatte "
    "es Mitleid mit ihm und brachte ihn zu sich nach Hause. Lange "
    "Zeit spielte es mit ihm und sie wurden gute Freunde. Zu bald jedoch "
    "wurde das kleine Maedchen aelter, und es verlor das Interesse an "
    "seinen Spielsachen. Schliesslich brachte es den kleinen Teufel in den "
    "Palast, der nahe ihres Zuhauses stand, und ueberliess ihn dort sich "
    "selbst. Seit dieser Zeit versucht der kleine Teufel ohne grosse "
    "Hoffnung, neue Freunde zu finden.\nAls Du an dieser Stelle "
    "angekommen bist, legst Du das Buch traurig zur Seite.\n\n"
    "Du denkst   . o O (Armer kleiner Teufel)");

  AddReadDetail( ({ "geschichte", "fraggle" }),
    "Du liest ein wenig in dem Buch herum, legst es dann jedoch zutiefst "
    "gelangweilt wieder zur Seite.");

  AddSound( DEFAULT_SOUND,
    "Lautes Kinderlachen ist zu hoeren.");

  AddSound( ({ "kinderlachen", "lachen" }),
    "Du laechelst in Dich hinein.");

  AddSound( ({ "kind", "kinder" }),
    "Dies ist das Spielzimmer der Kinder.");

  AddSound( ({ "spielzimmer", "zimmer" }),
    "Du hoerst das froehliche Lachen der Kinder.");

  AddSmell( DEFAULT_SMELL,
    "Seltsam. Es riecht irgendwie nach gar nichts.");

  AddSmell( ({ "nichts" }),
    "Nein, wirklich nicht.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", "nach Westen#" + "./og_treppe" );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "blinzl", "blinzle", "blinzel" }), "blinzeln" );
  AddCmd( ({ "stolper", "stolpere" }), "stolpern" );
  AddCmd( ({ "spiel", "spiele" }), "spielen" );
  AddCmd( ({ "troest", "troeste" }), "troesten" );
  AddCmd( ({ "setz", "setze" }), "setzen" );
  AddCmd( ({ "oeffne" }), "oeffnen" );
  AddCmd( ({ "nimm", "nehm", "nehme" }), "nehmen" );
  AddCmd( ({ "raeum", "raeume" }), "raeumen" );
  AddCmd( ({ "reparier", "repariere" }), "reparieren" );

//--Items & NPCs-----------------------------------------------------------



//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer SpecialDetails-----------------------------------------

string strstofftiere(string str)
{
  string s;

  if(teufel == DA)
  {
  	s = "Unter den vielen Stofftieren kannst Du einen hellbraunen "
  	+"Teddybaeren, einen suessen, kleinen Hasen, einen gruenen Drachen "
  	+"und sogar einen kleinen, gehoernten Teufel erkennen.";
  }
  else
  {
        s = "Unter den vielen Stofftieren kannst Du einen hellbraunen "
  	+"Teddybaeren, einen suessen, kleinen Hasen und einen gruenen "
  	+"Drachen erkennen.";
  }

  return BS(s);
}

string strteufel(string str)
{
  string s;

  if(teufel == DA)
  {
  	s = "Ein kleiner, schwarzer Teufel mit roten Hoernern sitzt ein "
  	+"wenig einsam in einer Ecke auf dem Boden. Er sieht irgendwie "
  	+"traurig aus.";
  }
  else
  {
        s = "Sowas siehst Du da leider nicht!";
  }

  return BS(s);
}

string strhoerner(string str)
{
  string s;

  if(teufel == DA)
  {
  	s = "Der Teufel hat zwei kurze, rote Hoerner, die ihm aus dem Kopf "
    "wachsen.";
  }
  else
  {
        s = "Sowas siehst Du da leider nicht!";
  }

  return BS(s);
}

string strkopf(string str)
{
  string s;

  if(teufel == DA)
  {
  	s = "Aus seinem Kopf wachsen zwei kurze Hoerner heraus.";
  }
  else
  {
        s = "Sowas siehst Du da leider nicht!";
  }

  return BS(s);
}

string strecke(string str)
{
  string s;

  if(teufel == DA)
  {
  	s = "Der kleine Teufel sitzt alleine in einer Ecke des "
  	+"Spielzimmers. Anscheinend will keines der Kinder mit ihm "
  	+"spielen. Das wuerde auch erklaeren, warum er so traurig "
  	+"ausschaut.";
  }
  else
  {
        s = "Sowas siehst Du da leider nicht!";
  }

  return BS(s);
}

string strpuzzle(string str)
{
  string s;

  if(puzzle == DA)
  {
  	s = "Das Puzzle wurde schon fast vollstaendig zusammengesetzt, nur "
  	+"ein paar Teile fehlen noch. Du kannst bereits erkennen, dass es, "
  	+"wenn es fertig ist, eine verkleinerte Ansicht dieses Palastes "
  	+"darstellen soll.";
  }
  else
  {
        s = "Das Puzzle wurde bereits vollstaendig zusammengesetzt. Du "
        +"siehst, dass es eine verkleinerte Ansicht dieses Palastes "
        +"darstellt.";
  }

  return BS(s);
}

string strteile(string str)
{
  string s;

  if(puzzle == DA)
  {
  	s = "Bis auf ein paar Teile ist das Puzzle bereits fertiggestellt "
  	+"worden.";
  }
  else
  {
        s = "Sowas siehst Du da nicht!";
  }

  return BS(s);
}

//--Funktionen-------------------------------------------------------------

int blinzeln(string str)
{
  notify_fail("Wem willst Du zublinzeln?\n");

  if(!str || str == "") return 0;

  if(!(str == "teddy" ||
       str == "teddybaer" ||
       str == "teddy zu" ||
       str == "teddybaer zu")) return 0;

  write(BS("Du blinzelst dem Teddybaeren zu und er grinst Dich froehlich "
  +"an."));

  TO->Message(BS(TP->Name(WER, 1)+" verzieht "
  +(PL->QueryProp(P_GENDER)==MALE?"sein":"ihr")+" Gesicht ein wenig. Ob "
  +(PL->QueryProp(P_GENDER)==MALE?"er":"sie")+" etwas im Auge hat?"),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

int stolpern(string str)
{
  notify_fail("Worueber moechtest Du stolpern?\n");

  if(!str || str == "") return 0;

  if(!(str == "ueber gleis" ||
       str == "ueber gleise" ||
       str == "ueber eisenbahngleis" ||
       str == "ueber eisenbahngleise")) return 0;

  write(BS("Du stolperst ungeschickt ueber die am Boden liegenden "
  +"Eisenbahngleise.\nAlso wirklich, pass doch mal etwas auf!\n"));

  TO->Message(BS(TP->Name(WER, 1)+" stolpert ueber die am Boden liegenden "
  +"Eisenbahngleise."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

int spielen(string str)
{
  notify_fail("Womit oder mit wem moechtest Du spielen?\n");

  if(!str || str == "") return 0;

  if(str == "mit teufel" ||
     str == "mit teufelchen")
  {
       write(BS("Du hockst Dich zu dem kleinen Teufel in die Ecke und "
       +"spielst ein wenig mit ihm. Mit leuchtenden Augen blickt er zu Dir "
       +"auf."));

       TO->Message(BS(TP->Name(WER, 1)+" spielt ein wenig mit dem kleinen "
       +"Teufel."),
       MSGFLAG_VISUAL|MSGFLAG_NO_TP);
       return 1;
  }

  if(str == "mit lokomotive" ||
     str == "mit spielzeugeisenbahn " ||
     str == "mit eisenbahn" ||
     str == "mit lok")
  {
       write(BS("Du stubst die kleine Lokomotive vorsichtig an.\n"
       +"Mit einem leisen *toeff toeff* faehrt sie langsam los und wird "
       +"dann immer schneller. Sie gleitet fast voellig geraeuschlos ueber "
       +"die gut geoelten Gleise, faehrt durch das ganze Zimmer hindurch "
       +"und wird dann wieder langsamer. Schliesslich haelt sie "
       +"direkt vor Dir wieder an."));

       TO->Message(BS(TP->Name(WER, 1)+" laesst die Spielzeuglokomotive "
       +"ein paar Runden drehen."),
       MSGFLAG_VISUAL|MSGFLAG_NO_TP);
       return 1;
  }
}

int troesten(string str)
{
  notify_fail("Wen moechtest Du troesten?\n");

  if(!str || str == "") return 0;

  if(!(str == "teufel" ||
       str == "teufelchen")) return 0;

  write(BS("Du troestest den armen, kleinen Teufel. Traurig blickt er "
  +"Dich an. Dein Herz krampft sich zusammen bei diesem Haeufchen Elend. "
  +"Am liebsten wuerdest Du den Kleinen mitnehmen."));

  TO->Message(BS(TP->Name(WER, 1)+" troestet den kleinen Teufel."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

int setzen(string str)
{
  notify_fail("Was willst Du zusammensetzen?\n");

  if(!str || str == "") return 0;

  if(!(str == "puzzle zusammen" )) return 0;

  if(puzzle == DA)
  {
       write(BS("Du bruetest ein wenig ueber dem Puzzle, schaffst es dann "
       +"aber recht schnell, die noch fehlenden Teile zusammenzusetzen.\n"
       +"Stolz betrachtest Du Dein Werk."));

       TO->Message(BS(TP->Name(WER, 1)+" bruetet ein wenig ueber dem "
       +"Puzzle."),
       MSGFLAG_VISUAL|MSGFLAG_NO_TP);
       puzzle = WEG;
       return 1;
  }
  else
  {
       write(BS("Aber das Puzzle ist doch bereits zusammengesetzt worden."));
       return -1;
  }
}

int oeffnen(string str)
{
  notify_fail("Was willst Du oeffnen?\n");

  if(!str || str == "") return 0;

  if(!(str == "schrank" ||
       str == "schranktuer" ||
       str == "schranktueren")) return 0;

  write(break_string("Du oeffnest den Schrank und blickst neugierig "
  +"hinein.\nOh, der Schrank ist ja voellig leer! Wahrscheinlich werden "
  +"dort abends die ganzen Spielsachen hineingeraeumt.\nDu schliesst "
  +"den Schrank wieder.", 78,0,1));

  TO->Message(BS(TP->Name(WER, 1)+" schaut neugierig in den Schrank "
  +"hinein."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

int nehmen(string str)
{
  object myteufel;

  notify_fail("Was willst Du nehmen?\n");

  if(!str || str == "") return 0;

  if(!(str == "teufel" ||
       str == "teufel mit")) return 0;

  if(teufel == DA)
  {
       myteufel = clone_object(OBJ "teufel");
       write(BS("Du holst den kleinen Teufel aus seiner Ecke heraus."));

       TO->Message(BS(TP->Name(WER, 1)+" nimmt eines der Stofftiere."),
       MSGFLAG_VISUAL|MSGFLAG_NO_TP);

       if(ME_TOO_HEAVY == myteufel->move(TP,M_GET|M_SILENT))
       {
            myteufel->move(ENV(TP), M_PUT|M_SILENT);

            write(BS("Da Du den kleinen Teufel nicht mehr tragen kannst, "
            +"legst Du ihn vorlaeufig auf dem Boden ab."));

            ENV(TP)->Message(BS(TP->Name(WER, 1)+" legt ein Stofftier auf "
            +"dem Boden ab."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
            return -1;
       }

       teufel = WEG;
       return 1;
  }
  else
  {
       write(BS("Das geht nicht!"));
  }
}

int raeumen(string str)
{
  notify_fail("Was willst Du wohin raeumen?\n");

  if(!str || str == "") return 0;

  if(!(str == "spielsachen in schrank" ||
       str == "spielzeug in schrank")) return 0;

  write(BS("Lass die Sachen lieber liegen, die Kinder wollen doch "
  +"bestimmt noch damit spielen."));
  return 1;
}

int reparieren(string str)
{
  notify_fail("Was willst Du reparieren?\n");

  if(!str || str == "") return 0;

  if(!(str == "pferd" ||
       str == "schaukelpferd" ||
       str == "schiene" ||
       str == "schienen")) return 0;

  write(BS("Du betrachtest das kaputte Schaukelpferd skeptisch und kommst "
  +"dann zu dem Schluss, dass es wohl nicht mehr zu reparieren ist."));

  TO->Message(BS(TP->Name(WER, 1)+" begutachtet das kaputte Schaukelpferd "
  +"eingehend und zuckt dann ratlos mit den Schultern."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

void reset()
{
	::reset();
	teufel = DA;
	puzzle = DA;
}
