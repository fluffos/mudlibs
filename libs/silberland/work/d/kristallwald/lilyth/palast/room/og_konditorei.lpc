string streistorte(string str)
{
  string s;
  object ob;
  ob = find_object(ROOM "og_lagerraum_konditorei");

  if(present("eistorte", ob))
  {
  	s = "Eine riesige, herrlich lecker aussehende Eistorte steht unter "
