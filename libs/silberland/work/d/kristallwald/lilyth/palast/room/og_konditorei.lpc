#include "../def.h"
#include <laden.h>

inherit "std/laden";

//--Variablen&Defines------------------------------------------------------

int i; //Zaehlvariable fuer Kekse
int klappe; //Ofenklappe

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------

  i = 3;
  klappe = ZU;

  RemoveFixedObject("/obj/boerse");
  RemoveFixedObject("/obj/stempel");
  RemoveItem("/obj/entsorg");

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einer Konditorei");
//SetProp(P_INT_LONG, --> siehe unten

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_SHOPKEEPER_ID, "thimon");
  SetProp(P_SHOPKEEPER_NAME, "Thimon");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetStorageRoom(ROOM "og_lagerraum_konditorei" );

//--Details----------------------------------------------------------------

  AddDetail( ({ "konditorei" }),
    "Du befindest Dich in einer kleinen Konditorei.");

  AddDetail( ({ "theke", "glastheke" }),
    "Die Theke reicht fast von einer Wand bis an die naechste. Ihre "
    "Oberseite besteht aus Glas, so dass Du die dahinter liegenden "
    "Koestlichkeiten deutlich sehen kannst.");

  AddDetail( ({ "oberseite" }),
    "Eine grosse, gewoelbte Glasscheibe bildet die Oberseite der Theke, "
    "waehrend der Thekenboden aus hellem Holz besteht.");

  AddDetail( ({ "holz" }),
    "Der Thekenboden besteht ebenso wie der Fussboden, die Decke und "
    "die Waende aus hellem Holz.");

  AddDetail( ({ "glas", "glasscheibe", "scheibe" }),
    "Die Glasscheibe ist leicht gewoelbt und sieht frisch geputzt aus, "
    "so dass Du ungehindert auf die vielen, herrlichen Koestlichkeiten "
    "darunter blicken kannst.");

  AddDetail( ({ "thekenboden" }),
    "Auf dem Thekenboden, der sich etwa in Hoehe Deines Bauchnabels "
    "befindet, sind die herrlichsten Backwaren und andere Koestlichkeiten "
    "fein saeuberlich auf kleinen Papptellerchen nebeneinander angeordnet.");

  AddDetail( ({ "hoehe" }),
    "Du wirfst einen kurzen Blick auf Deinen Bauchnabel und schaetzt "
    "den ungefaehren Abstand bis zum Boden. Ja, kommt ungefaehr hin, der "
    "Thekenboden ist nicht sehr viel hoeher.");

  AddDetail( ({ "blick" }),
    "Sicherheitshalber wirfst Du noch einen zweiten Blick hinterher.");

  AddDetail( ({ "abstand" }),
    "Er ist in etwa so gross wie der Abstand zwischen Thekenboden und "
    "Fussboden.");

  AddDetail( ({ "bauchnabel", "nabel" }),
    "Du hast doch wohl einen, oder nicht?");

  AddDetail( ({ "papptellerchen", "tellerchen", "pappteller", "teller" }),
    "All die vielen, suessen Koestlichkeiten sind auf kleinen "
    "Papptellern huebsch angeordnet worden.");

  AddDetail( ({ "anblick", "auge", "augen" }),
    "Du kannst Deine Augen kaum von den herrlichen Leckereien abwenden.");

  AddDetail( ({ "vielfalt", "sachen" }),
    "So viele leckere Sachen hast Du schon lange nicht mehr gesehen.");

  AddDetail( ({ "wasser", "mund" }),
    "Du hast auf einmal einen unheimlichen Appetit auf all diese "
    "leckeren Sachen.");

  AddDetail( ({ "appetit" }),
    "Na los, kauf Dir ruhig etwas davon.");

  AddDetail( ({ "silberland" }),
    "Thimon ist beruehmt fuer seine Backkuenste.");

  AddDetail( ({ "backkuenste", "kuenste" }),
    "Er ist einer der besten Konditoren, die Du kennst.");

  AddDetail( ({ "konditoren" }),
    "Oder etwa der einzige?");

  AddDetail( ({ "konditor" }),
    "Ist er etwa gerade nicht da?");

  AddDetail( ({ "regal" }),
    "Ein schmales Regal haengt an der Wand hinter der Theke. Es ist mit "
    "verschiedenen Backzutaten gefuellt. Unter dem Regal auf einem kleinen "
    "Hocker steht eine Kasse.");

  AddDetail( ({ "backzutaten", "zutaten" }),
    "Du siehst mehrere Zuckertoepfe, einige Tueten Mehl, einen grossen Krug "
    "Milch, einen Karton mit frischen Eiern und kleine Schaelchen mit "
    "Honig, Schokolade und zerkleinerten Nuessen in dem Regal stehen.");

  AddDetail( ({ "zuckertoepfe", "toepfe", "toepfchen", "zuckertopf" }),
    "Es stehen mehrere kleine Toepfchen mit Zucker in dem Regal.");

  AddDetail( ({ "zucker" }),
    "In den Toepfen in den Regalen befindet sich Zucker.");

  AddDetail( ({ "tueten", "mehltueten", "tuete", "mehltuete" }),
    "Eine der Mehltueten hat einen kleinen Riss, durch den Du das "
    "feine, weisse Mehl sehen kannst.");

  AddDetail( ({ "riss" }),
    "Er ist zum Glueck nur sehr klein.");

  AddDetail( ({ "glueck" }),
    "Sonst wuerde das ganze Mehl doch aus der Tuete herausquillen.");

  AddDetail( ({ "mehl" }),
    "Du laesst ein wenig von dem Mehl durch Deine Finger rieseln. Ob es "
    "wohl aus der Muehle beim Fischerdorf stammt?");

  AddDetail( ({ "finger" }),
    "Es war einmal ein kleiner Finger, der sich vorwitzig in eine Mehltuete "
    "wagte...");

  AddDetail( ({ "muehle", "fischerdorf", "dorf", "naehe" }),
    "In der Naehe des Fischerdorfes gibt es eine grosse Muehle.");

  AddDetail( ({ "krug" }),
    "Ein grosser Krug mit frischer Milch steht in dem Regal.");

  AddDetail( ({ "milch" }),
    "Sie sieht sehr frisch aus.");

  AddDetail( ({ "karton" }),
    "In dem Karton stecken sechs frische Eier.");

  AddDetail( ({ "eier" }),
    "Sie sind weiss und oval, so wie Eier nun einmal sind.");

  AddDetail( ({ "schaelchen" }),
    "Ein paar kleine Schaelchen stehen in dem Regal. Sie sind mit Honig, "
    "Schokolade und Nuessen gefuellt.");

  AddDetail( ({ "honig" }),
    "In einem der Schaelchen befindet sich goldgelber, dickfluessiger "
    "Honig.");

  AddDetail( ({ "schokolade", "stueck", "stuecke" }),
    "Einige Stuecke Schokolade befinden sich in einem der Schaelchen.");

  AddDetail( ({ "nuesse", "nuss" }),
    "Eines der Schaelchen ist mit zerkleinerten Nuessen gefuellt.");

  AddDetail( ({ "hocker" }),
    "Ein niedriger Hocker steht unter dem Regal. Auf ihm siehst Du "
    "eine Kasse stehen.");

  AddDetail( ({ "kasse" }),
    "Naja, eigentlich ist es eher eine kleine Holzkiste mit mehreren, "
    "unterschiedlich grossen Faechern, in denen ein paar Muenzen liegen.");

  AddDetail( ({ "holzkiste" }),
    "Thimon benutzt die kleine Holzkiste als Kasse.");

  AddDetail( ({ "faecher", "fach" }),
    "In einigen von ihnen liegen ein paar Muenzen.");

  AddDetail( ({ "muenze", "muenzen" }),
    "Das scheint Thimons gesamtes Einkommen zu sein.");

  AddDetail( ({ "einkommen", "leben" }),
    "Es ist nicht allzuviel, aber es scheint zum Leben zu reichen.");

  AddDetail( ({ "wand" }),
    "Ein schmales Regal wurde hinter der Theke an der Wand angebracht.");

  AddDetail( ({ "stehtische", "tische" }),
    "Vor der grossen Glastheke stehen zwei hohe, runde Tische. Auf "
    "einem von ihnen steht eine flache Schale.");

  AddDetail( ({ "waende" }),
    "Die Waende sind hier recht karg gehalten, nur an der Wand hinter "
    "der Theke siehst Du ein Regal.");

  AddDetail( ({ "boden", "fussboden" }),
    "Der Boden besteht aus ordentlich verlegten, hellweissen Holzlatten.");

  AddDetail( ({ "holzlatten", "latten", "holzlatte", "latte" }),
    "Sie wurden sehr sorgfaeltig verlegt.");

  AddDetail( ({ "decke" }),
    "Die weisse Holzdecke befindet sich nicht weit ueber Dir.");

  AddDetail( ({ "holzdecke" }),
    "An der Decke siehst Du die gleichen weissen Holzlatten, die auch "
    "auf dem Boden verlegt wurden.");

  AddDetail( ({ "ofen" }),
    "Du schaust neugierig hinter die Theke und betrachtest den "
    "Ofen, der dort ziemlich versteckt in einer Ecke steht. Die Klappe "
    "ist gerade geschlossen, so dass Du das Innere des Ofens nicht sehen "
    "kannst.");

  AddDetail( ({ "ecke" }),
    "In einer Ecke hinter der Theke steht ein grosser Ofen.");

  AddDetail( ({ "innere", "inneres" }),
    "Du kannst es leider nicht sehen.");

  AddDetail( ({ "koestlichkeiten", "leckereien", "backwaren",
  "koestlichkeit", "leckerei" }),
    "Beim Anblick der unglaublichen Vielfalt an Koestlichkeiten, die "
    "Du unter der Glastheke sehen kannst, laeuft Dir das Wasser im "
    "Mund zusammen. Du entdeckst frischen Honigkuchen, grosse "
    "Lebkuchenherzen, kleine Karamellbonbons, dunkelbraune "
    "Schokoladenkekse, ein Kaestchen Pralinen, eine grosse Eistorte und "
    "andere leckere Sachen, die "
    "Du noch nie zuvor gesehen hast. Am liebsten wuerdest Du die ganze "
    "Theke auf einmal leerkaufen.");

  AddSpecialDetail( ({ "schale" }),
    "strschale");

  AddSpecialDetail( ({ "plaetzchen", "schokoladenplaetzchen" }),
    "strplaetzchen");

  AddSpecialDetail( ({ "kruemel" }),
    "strkruemel");

  AddSpecialDetail( ({ "schokoladenplaetzchenkruemel" }),
    "strschokoladenplaetzchenkruemel");

  AddSpecialDetail( ({ "ofen" }),
    "strofen");

  AddSpecialDetail( ({ "klappe" }),
    "strklappe");

  AddSpecialDetail( ({ "inneres", "innere" }),
    "strinneres");

  AddSpecialDetail( ({ "backblech", "blech" }),
    "strbackblech");

  AddSpecialDetail( ({ "honigkuchen" }),
    "strhonigkuchen");

  AddSpecialDetail( ({ "lebkuchenherzen", "lebkuchenherz", "herz",
  "herzen" }),
    "strlebkuchenherz");

  AddSpecialDetail( ({ "schokoladenkeks", "schokoladenkekse", "keks",
  "kekse" }),
    "strschokoladenkeks");

  AddSpecialDetail( ({ "karamellbonbons", "karamellbonbon", "bonbons",
  "bonbon" }),
    "strkaramellbonbon");

  AddSpecialDetail( ({ "eistorte", "torte" }),
    "streistorte");

  AddSpecialDetail( ({ "pralinen", "praline", "kaestchen",
  "pralinenkaestchen" }),
    "strpraline");

  AddSpecialDetail( ({ "waerme" }),
    "strwaerme");

  AddSpecialDetail( ({ "zaehne" }),
    "strzaehne");

  AddSpecialDetail( ({ "wuerfel" }),
    "strwuerfel");

  AddSound( DEFAULT_SOUND,
    "Ab und zu dringt lautes Kindergeschrei herein.");

  AddSound( ({ "kindergeschrei", "geschrei" }),
    "Du hoerst lautes Kindergeschrei von draussen.");

  AddSound( ({ "kind", "kinder" }),
    "Die sind sicher gerade bei Mahmud.");

  AddSound( ({ "mahmud" }),
    "Hast Du ihn nicht gesehen?");

  AddSmell( DEFAULT_SMELL,
    "Du schnupperst in der Luft herum. Hmmmmm! Es duftet herrlich nach "
    "allerlei koestlichen Dingen. Du kriegst langsam Hunger.");

  AddSmell( ({ "sachen", "duefte", "duft" }),
    "Es riecht nach leckeren Lebkuchen, frischen Plaetzchen, Honig "
    "und zahlreichen anderen herrlichen Dingen.");

  AddSmell( ({ "luft" }),
    "Die Luft ist erfuellt von den herrlichsten Dueften.");

  AddSmell( ({ "lebkuchen", "plaetzchen", "honig" }),
    "Dir laeuft das Wasser im Mund zusammen.");

  AddSmell( ({ "dinge" }),
    "Du kannst nicht alle Duefte identifizieren, aber es riecht einfach "
    "phantastisch.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "sueden", "nach Sueden#" + "./og_treppe" );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "iss", "ess", "esse", "nasch", "nasche", "probier",
  "probiere" }), "essen" );
  AddCmd( ({ "trink", "trinke" }), "trinken" );
  AddCmd( ({ "nimm", "nehm", "nehme" }), "nehmen" );
  AddCmd( ({ "oeffne" }), "oeffnen" );
  AddCmd( ({ "schliess", "schliesse" }), "schliessen" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "konditor", REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer SpecialDetails-----------------------------------------

string strschale(string str)
{
  string s;

  if(i == 3)
  {
  	s = "Die Schale ist mit frischen Schokoladenplaetzchen gefuellt.";
  }

  if(i == 2)
  {
        s = "Die Schale scheint mit frischen Schokoladenplaetzchen gefuellt "
        +"gewesen zu sein. Leider sind nur noch zwei davon da.";
  }

  if(i == 1)
  {
        s = "Die Schale scheint mit frischen Schokoladenplaetzchen gefuellt "
        +"gewesen zu sein. Leider ist jetzt nur noch einer davon da.";
  }

  if(i == 0)
  {
        s = "Bis auf ein paar vereinzelte, dunkle Kruemel ist die Schale "
        +"leer.";
  }

  return BS(s);
}

string strplaetzchen(string str)
{
  string s;

  if(i > 0)
  {
  	s = "Hmm, die sehen wirklich lecker aus!";
  }
  else
  {
        s = "Es sind leider keine mehr da. Aber Thimon hat sicherlich "
        "schon wieder welche im Ofen und fuellt die Schale bald nach.";
  }

  return BS(s);
}

string strkruemel(string str)
{
  string s;

  if(i > 0)
  {
  	s = "Sowas siehst Du da leider nicht!";
  }
  else
  {
        s = "Sieht aus wie ... Schokoladenplaetzchenkruemel.";
  }

  return BS(s);
}

string strschokoladenplaetzchenkruemel(string str)
{
  string s;

  if(i > 0)
  {
  	s = "Sowas siehst Du da leider nicht!";
  }
  else
  {
        s = "Sie scheinen darauf hinzudeuten, dass in der Schale vor "
        +"kurzem noch Schokoladenplaetzchen waren.";
  }

  return BS(s);
}

string strofen(string str)
{
  string s;

  if(klappe == ZU)
  {
  	s = "Du schaust neugierig hinter die Theke und betrachtest den "
            "Ofen, der dort ziemlich versteckt in einer Ecke steht. Die "
            "Klappe ist gerade geschlossen, so dass Du das Innere des "
            "Ofens nicht sehen kannst.";
  }
  else
  {
        s = "Du schaust neugierig hinter die Theke und betrachtest den "
            "Ofen, der dort ziemlich versteckt in einer Ecke steht. Die "
            "Klappe ist geoeffnet, so dass Du das Innere des "
            "Ofens sehen kannst.";
  }

  return BS(s);
}

string strklappe(string str)
{
  string s;

  if(klappe == ZU)
  {
  	s = "Sie ist geschlossen.";
  }
  else
  {
        s = "Sie ist offen.";
  }

  return BS(s);
}

string strinneres(string str)
{
  string s;

  if(klappe == ZU)
  {
  	s = "Du kannst es leider nicht sehen, da die Klappe zu ist.";
  }
  else
  {
        s = "Im Inneren des Ofens siehst Du ein ganzes Backblech voll "
        "mit frischen, braungebrannten Schokoladenplaetzchen.";
  }

  return BS(s);
}

string strbackblech(string str)
{
  string s;

  if(klappe == ZU)
  {
  	s = "Sowas siehst Du da nicht!";
  }
  else
  {
        s = "Es ist voll mit braungebrannten Schokoladenplaetzchen.";
  }

  return BS(s);
}

string strhonigkuchen(string str)
{
  string s;
  object ob;
  ob = find_object(ROOM "og_lagerraum_konditorei");

  if(present("honigkuchen", ob))
  {
  	s = "Der Honigkuchen sieht sehr frisch und saftig aus.";
  }
  else
  {
  	s = "Hm, der Honigkuchen scheint nicht mehr ganz frisch zu sein.";
  }
  return BS(s);
}

string strlebkuchenherz(string str)
{
  string s;
  object ob;
  ob = find_object(ROOM "og_lagerraum_konditorei");

  if(present("herz", ob))
  {
  	s = "Dunkelbraune, frisch gebackene Lebkuchenherzen. Hmmmm, sehen "
  	+"die lecker aus!";
  }
  else
  {
  	s = "Oh, die Lebkuchenherzen scheinen gerade ausverkauft zu sein.";
  }
  return BS(s);
}

