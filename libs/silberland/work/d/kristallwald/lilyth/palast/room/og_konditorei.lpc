  }
  else
  {
  	s = "Oh, die Eistorte ist ja voellig zerschmolzen. Schade :(";
  }
  return BS(s);
}

string strpraline(string str)
{
  string s;
  object ob;
  ob = find_object(ROOM "og_lagerraum_konditorei");

  if(present("pralinen", ob))
  {
  	s = "Ein kleines Kaestchen mit Pralinen liegt in der Theke.";
  }
  else
  {
  	s = "Huch, das Kaestchen ist ja vollkommen leer! Ob Thimon die "
  	+"waehrend seiner Arbeit alle genascht hat?";
  }
  return BS(s);
}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_int_long()
{
  string txt;
  string s;

  if(QueryProp(P_SHOPKEEPER_ID))
  {
        if(!present(QueryProp(P_SHOPKEEPER_ID)))
        {
                s = "Hinter der Theke steht normalerweise der Konditor, "
                +"der jedoch gerade nicht da zu sein scheint. Stattdessen "
                +"siehst Du nur ein schmales Regal, das dort an der Wand "
                +"haengt. ";
        }
        else
        {
                s = "Hinter der Theke steht der Konditor, der Dich "
                +"erwartungsvoll anblickt. Hinter ihm siehst Du ein "
                +"schmales Regal an der Wand. ";
        }
  }

  txt = "Du hast die kleine Konditorei betreten und stehst nun direkt "
        +"vor einer grossen glaesernen Theke, hinter die herrlichsten "
        +"Koestlichkeiten des Silberlandes zu sehen sind. "+s+"Zwei kleine "
        +"Stehtische stehen vor der Theke.";

   return BS(txt);
}

int essen(string str)
{
  notify_fail("Wovon moechtest Du naschen?\n");

  if(!str || str == "") return 0;

  if(str == "schokoladenplaetzchen" ||
     str == "plaetzchen" )
  {
     if(i > 1)
     {
  	   write(BS("Du nimmst Dir ein Schokoladenplaetzchen aus "
  	   +"der Schale und knabberst froehlich daran herum. Hmm, das "
  	   +"schmeckt lecker!"));

  	   TO->Message(BS(TP->Name(WER, 1)+" nimmt sich ein "
  	   +"Schokoladenplaetzchen aus der Schale und knabbert daran herum."),
  	   MSGFLAG_VISUAL|MSGFLAG_NO_TP);

       i--;
       return 1;
     }

     if(i == 1)
     {
  	   write(BS("Du nimmst Dir das letzte Schokoladenplaetzchen aus "
  	   +"der Schale und knabberst froehlich daran herum. Hmm, das "
  	   +"schmeckt lecker!"));

  	   TO->Message(BS(TP->Name(WER, 1)+" nimmt sich ein "
  	   +"Schokoladenplaetzchen aus der Schale und knabbert daran herum."),
  	   MSGFLAG_VISUAL|MSGFLAG_NO_TP);

       i--;
       return 1;
     }

     if(i == 0)
     {
  	   write(BS("Es sind leider keine Schokoladenplaetzchen mehr da. :("));
       return -1;
     }
  }

  if(str == "schokolade")
  {
     write(BS("Du stibitzt ein grosses Stueck Schokolade aus dem Regal "
     +"und knabberst selig daran herum."));

     TO->Message(BS(TP->Name(WER, 1)+" stibitzt ein Stueck Schokolade "
     +"aus dem Regal."),
     MSGFLAG_VISUAL|MSGFLAG_NO_TP);
     return 1;
  }

  if(str == "nuesse")
  {
     write(break_string("Du greifst in eines der Schaelchen, holst eine "
     +"Handvoll Nuesse heraus und stopfst sie Dir alle auf einmal in den "
     +"Mund.\nDann kaust Du gemaechlich vor Dich hin.", 78,0,1));

     TO->Message(BS(TP->Name(WER, 1)+" langt in eines der Schaelchen im "
     +"Regal."),
     MSGFLAG_VISUAL|MSGFLAG_NO_TP);
     return 1;
  }

  if(str == "honig")
  {
     write(BS("Ein wenig schuldbewusst tauchst Du Deinen Finger "
     +"in das Honigschaelchen und schleckst ihn dann genuesslich ab."));

     TO->Message(BS(TP->Name(WER, 1)+" langt in eines der Schaelchen im "
     +"Regal."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
     return 1;
  }

  if(str == "zucker")
  {
     write(BS("Du steckst Deinen Finger tief in den Zuckertopf "
     +"hinein und leckst ihn dann froehlich grinsend ab."));

     TO->Message(BS(TP->Name(WER, 1)+" langt in eines der Schaelchen im "
     +"Regal."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
     return 1;
  }

  if(str == "mehl")
  {
     write(BS("Du weisst doch, wonach Mehl schmeckt. Nach nichts. "
     +"Also lass es lieber dort stehen."));
     return 1;
  }
}

int trinken(string str)
{
  notify_fail("Was moechtest Du trinken?\n");

  if(!str || str == "") return 0;

  if(!(str == "milch" ||
       str == "milch aus krug" )) return 0;

  if(present(QueryProp(P_SHOPKEEPER_ID)))
  {
        write(BS("Gerade, als Du nach dem Krug Milch greifen "
        +"willst, faellt Dir Thimons unheilvoller Blick auf. Spontan "
        +"entscheidest Du Dich dafuer, die Milch lieber doch nicht "
        +"anzuruehren."));
        return -1;
  }
  else
  {
        write(BS("Du nimmst einen kleinen Schluck aus dem grossen "
        +"Milchkrug und wischt Dir anschliessend zufrieden mit dem Aermel "
        +"ueber den Mund. Lecker!"));

        TO->Message(BS(TP->Name(WER, 1)+" nimmt einen Schluck aus dem "
        +"grossen Milchkrug im Regal."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        return 1;
  }
}

int nehmen(string str)
{
  notify_fail("Was moechtest Du nehmen?\n");

  if(!str || str == "") return 0;

  if(str == "ei" ||
     str == "eier"||
     str == "ei aus regal" ||
     str == "eier aus regal" ||
     str == "ei aus karton" ||
     str == "eier aus karton" )
  {
     write(BS("Nein, die Eier sehen viel zu zerbrechlich aus!"));
     return -1;
  }

  if(str == "muenze aus kasse" ||
     str == "muenzen aus kasse" ||
     str == "geld aus kasse" ||
     str == "muenze aus holzkiste" ||
     str == "muenzen aus holzkiste" ||
     str == "geld aus holzkiste")
  {
     write(BS("Also wirklich, Du willst doch wohl nicht einem armen "
     +"Hobbit sein schwerverdientes Geld wegnehmen wollen!"));
     return 1;
  }

  return 0;
}

int oeffnen(string str)
{
  notify_fail("Was willst Du oeffnen?\n");

  if(!str || str == "") return 0;

  if(!(str == "klappe" ||
       str == "ofenklappe" )) return 0;

  if(klappe == ZU)
  {
  	write(BS("Du oeffnest die Klappe.\n"));

  	TO->Message(BS(TP->Name(WER, 1)+" oeffne die Ofenklappe.\n"),
  	MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    klappe = AUF;

    call_out("klappeoeffnen", 10+random(5));
    return 1;
  }
  else
  {
    write(BS("Die Klappe ist doch schon offen."));
    return -1;
  }
}

void klappeoeffnen()
{
  object konditor;
  konditor = present("thimon", TO);

  if(konditor)
  {
    call_other(konditor, "klappeauf", 0);
  }

  return;
}

int schliessen(string str)
{
  notify_fail("Was willst Du schliessen?\n");

  if(!str || str == "") return 0;

  if(!(str == "klappe" ||
       str == "ofenklappe" )) return 0;

  if(klappe == AUF)
  {
  	write(BS("Du schliesst die Ofenklappe wieder."));

  	TO->Message(BS(TP->Name(WER, 1)+" schliesst die Ofenklappe "
  	+"wieder."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    klappe = ZU;
    return 1;
  }
  else
  {
    write(BS("Die Klappe ist doch gar nicht offen."));
    return -1;
  }
}

ofenklappe()
{
  return klappe;
}

reset()
{
	::reset();

	if(i < 3 || (present(QueryProp(P_SHOPKEEPER_ID))))
	{
	  TO->Message(BS("Thimon fuellt eine Schale mit frischen "
	  +"Schokoladenplaetzchen und stellt sie auf einen der "
	  +"Stehtische."), MSGFLAG_VISUAL);
	  i = 3;
  }
}

//Kein verkaufen hier:
int sell(string str, int f)
{
  string prefix;

  if (!prefix=CheckKeeper(2)) return 0;

  write(capitalize(QueryProp(P_SHOPKEEPER_NAME))+
       " sagt: Es tut mir leid, aber ich kaufe nichts.\n");
  return -1;
}
