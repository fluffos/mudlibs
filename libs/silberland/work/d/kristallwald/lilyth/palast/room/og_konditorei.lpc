  	+"Waerme.";
  }
  else
  {
  	s = "Die Schokoladenkekse sehen nicht mehr ganz frisch aus. Warte "
  	+"lieber, bis Thimon neue gebacken hat.";
  }
  return BS(s);
}

string strwaerme(string str)
{
  string s;
  object ob;
  ob = find_object(ROOM "og_lagerraum_konditorei");

