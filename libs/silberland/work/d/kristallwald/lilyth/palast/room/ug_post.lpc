#include "../def.h"

inherit "std/post";

//--Variablen&Defines------------------------------------------------------

string player;
int fass;

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------

  player = "";
  fass = VOLL;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Eine Poststelle");
  SetProp(P_INT_LONG,
    "Wie Du unschwer erkennen kannst, befindest Du Dich hier in einer "
    "Poststelle. Auf einem kleinen Tisch an der Dir gegenueberliegenden "
    "Wand liegen ein grosser Stapel leerer Blaetter, Schreibfedern sowie "
    "ein grosses Tintenfass fuer Dich bereit. Rechts und links von Dir "
    "befinden sich zwei kleine abgeschirmte Schreibkabinen, in denen Du "
    "in aller Ruhe Nachrichten verfassen und versenden kannst, ohne von "
    "jemandem gestoert zu werden.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "poststelle" }),
    "Dies ist die Poststelle des Palastes.");

  AddDetail( ({ "palast" }),
    "Dass Du Dich in einem Palast befindest, hast Du sicherlich schon "
    "gemerkt.");

  AddDetail( ({ "tisch" }),
    "Ein kleiner runder Tisch steht an der Dir gegenueberliegenden Wand. "
    "Auf ihm liegen ein grosser Stapel leerer Blaetter sowie mehrere "
    "Schreibfedern in verschiedenen Formen fuer Dich bereit. "
    "Auch ein grosses Tintenfass steht dort.");

  AddDetail( ({ "wand" }),
    "An der Dir gegenueberliegenden Wand steht ein kleiner runder Tisch.");

  AddDetail( ({ "stapel" }),
    "Ein grosser Stapel loser Blaetter liegt auf dem Tisch.");

  AddDetail( ({ "blaetter", "blatt" }),
    "Die Blaetter sind allesamt unbeschrieben. Sie scheinen nur darauf zu "
    "warten, dass jemand sie mit Worten fuellt.");

  AddDetail( ({ "worte", "wort" }),
    "Die groesste Macht hat das richtige Wort zur richtigen Zeit.");

  AddDetail( ({ "macht" }),
    "Worte besitzen sehr viel Macht.");

  AddDetail( ({ "zeit" }),
    "Vielleicht ist jetzt die richtige Zeit?");

  AddDetail( ({ "schreibfedern", "formen", "schreibfeder", "form" }),
    "Auf dem Tisch liegen runde, spitze und gebogene Schreibfedern "
    "ordentlich nebeneinander aufgereiht.");

  AddDetail( ({ "runde schreibfedern", "runde schreibfeder",
  "runde federn", "runde feder" }),
    "Mit den abgerundeten Federn hat man ein sehr angenehmes Gefuehl beim "
    "Schreiben.");

  AddDetail( ({ "gefuehl" }),
    "Man hat das Gefuehl, sehr 'weich' zu schreiben.");

  AddDetail( ({ "spitze schreibfedern", "spitze schreibfeder",
  "spitze federn", "spitze feder" }),
    "Die spitzen Schreibfedern kratzen ein wenig auf dem Papier und "
    "verursachen ein eher unangenehmes Geraeusch beim Schreiben.");

  AddDetail( ({ "geraeusch" }),
    "Schon beim Gedanken daran laeuft es Dir kalt den Ruecken hinunter.");

  AddDetail( ({ "gedanke", "gedanken" }),
    "Du magst gar nicht daran denken");

  AddDetail( ({ "ruecken" }),
    "Dein Ruecken schmerzt ein wenig vom vielen Herumstehen.");

  AddDetail( ({ "herumstehen" }),
    "Du schaust Dich suchend um, doch hier drin kannst Du leider keine "
    "Sitzgelegenheit sehen. Vielleicht hast Du draussen ja mehr Glueck.");

  AddDetail( ({ "sitzgelegenheit" }),
    "Ein Stuhl oder etwas Aehnliches wuerde Dir schon reichen.");

  AddDetail( ({ "stuhl", "stuehle" }),
    "Du siehst hier leider keinen Stuhl.");

  AddDetail( ({ "aehnliches" }),
    "Oder eine Bank.");

  AddDetail( ({ "bank" }),
    "Hattest Du draussen nicht irgendwo Baenke gesehen?");

  AddDetail( ({ "baenke" }),
    "Draussen in den Gaengen.");

  AddDetail( ({ "gaenge" }),
    "Du koenntest schwoeren, dass dort irgendwo Baenke standen.");

  AddDetail( ({ "glueck" }),
    "Du hast bestimmt welches.");

  AddDetail( ({ "gebogene schreibfedern", "gebogene schreibfeder",
  "gebogene federn", "gebogene feder" }),
    "Mit den leicht gebogenen Federn hat man eine besonders schoene "
    "Handschrift.");

  AddDetail( ({ "handschrift" }),
    "Auch wenn man normalerweise keine sehr schoene Handschrift hat, sehen "
    "Schriftstuecke, die mit solchen Federn geschrieben wurden, immer "
    "sauber und ordentlich aus.");

  AddDetail( ({ "schriftstueck", "schriftstuecke", "beispiel" }),
    "Briefe zum Beispiel.");

  AddDetail( ({ "schreiben", "federn", "feder" }),
    "Es liegen verschiedene Schreibfedern zum Schreiben bereit.");

  AddDetail( ({ "glas" }),
    "Das Tintenfass besteht aus einem sehr dicken Glas. Es ist im unteren "
    "Bereich stark gewoelbt und laeuft nach oben hin etwas enger zu.");

  AddDetail( ({ "bereich" }),
    "Der untere Bereich des Tintenfasses ist fast kugelrund. Nur die "
    "Unterseite wurde flach gehalten, damit das Glas nicht umkippen und die "
    "Fluessigkeit herauslaufen kann.");

  AddDetail( ({ "fluessigkeit" }),
    "Vermutlich handelt es sich um Tinte.");

  AddDetail( ({ "tinte" }),
    "Ja, Du hast Dich nicht geirrt. In dem Glas befindet sich dickfluessige "
    "schwarze Tinte.");

  AddDetail( ({ "schreibkabinen", "kabinen" }),
    "Die Kabinen sind eigentlich nur kleine, durch bunte gemusterte "
    "Vorhaenge abgeschirmte Bereiche in der Poststelle, in denen man in "
    "aller Ruhe Briefe und Nachrichten an all seine Freunde und Bekannten "
    "schicken kann.");

  AddDetail( ({ "nachrichten", "nachricht" }),
    "Wenn Du jemandem eine kurze Nachricht hinterlassen willst, kannst Du "
    "dies in einer der beiden Schreibkabinen tun.");

  AddDetail( ({ "freunde" }),
    "Du hast sicherlich schon einige Freunde hier. Und falls nicht, wirst "
    "Du bestimmt frueher oder spaeter welche finden. :)");

  AddDetail( ({ "bekannte", "bekannter", "bekannten" }),
    "Auch im Silberland trifft man immer wieder auf alte Bekannte.");

  AddDetail( ({ "silberland" }),
    "Auch wenn das Silberland sehr gross ist, trifft man immer mal wieder "
    "auf den einen oder anderen Bekannten.");

  AddDetail( ({ "vorhaenge", "vorhang" }),
    "Die Vorhaenge sind mit huebschen bunten Mustern verziert.");

  AddDetail( ({ "muster", "blumenmuster" }),
    "Bunte Blumen zieren die Vorhaenge.");

  AddDetail( ({ "blumen", "blume" }),
    "Seltsam, Du bekommst richtig gute Laune beim Anblick dieser bunten "
    "Vorhaenge.");

  AddDetail( ({ "laune" }),
    "Du freust Dich.");

  AddDetail( ({ "anblick" }),
    "Du befuehlst die Vorhaenge neugierig und bewunderst die wunderschoenen "
    "Blumenmuster auf ihnen.");

  AddDetail( ({ "bereiche" }),
    "Die Kabinen sind kleine Bereiche in der Poststelle, die durch bunte "
    "Vorhaenge vom restlichen Raum abgeschirmt sind.");

  AddDetail( ({ "raum" }),
    "Du befindest Dich hier in einer Poststelle.");

  AddDetail( ({ "ruhe" }),
    "In den Kabinen hat man seine Ruhe.");

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus hellem Marmor.");

  AddDetail( ({ "marmor" }),
    "Wie fast ueberall im Palast liegt auch hier weisser Marmor aus.");

  AddDetail( ({ "waende" }),
    "An der Dir gegenueberliegenden Wand befindet sich ein kleiner runder "
    "Tisch, direkt daneben in der Ecke steht ein Papierkorb.");

  AddDetail( ({ "ecke" }),
    "Neben dem Tisch steht ein kleiner Papierkorb in der Ecke.");

  AddDetail( ({ "papierkorb", "korb" }),
    "Der Papierkorb ist - wie es der Name schon sagt - bis obenhin voll "
    "mit zusammengeknuelltem Papier.");

  AddDetail( ({ "name" }),
    "Papierkorb.");

  AddDetail( ({ "papier" }),
    "Die zerknuellten Blaetter im Papierkorb sind alle bereits beschrieben. "
    "Auf vielen ist die Schrift jedoch sehr verschmiert und kaum noch "
    "lesbar, die anderen weisen soviele Schreibfehler auf, dass es einem "
    "fast unmoeglich erscheint, die Texte zu entziffern. Nur ein einziger "
    "Brief scheint noch halbwegs lesbar zu sein.");

  AddDetail( ({ "brief" }),
    "Du koenntest versuchen, ihn zu lesen.");

  AddDetail( ({ "schrift", "schriften" }),
    "Die Schriften sind sehr unterschiedlich und wirken teilweise aeusserst "
    "fremdartig und seltsam.");

  AddDetail( ({ "schreibfehler" }),
    "Auch Typos genannt.");

  AddDetail( ({ "typos", "typo" }),
    "Siehst Du hier irgendwo welche?");

  AddDetail( ({ "texte", "text" }),
    "Viele der Texte sind so unleserlich, dass Du sie kaum entziffern "
    "kannst. Das macht aber eigentlich auch nichts, denn es gehoert sich "
    "nicht, die Post anderer zu lesen.");

  AddDetail( ({ "post" }),
    "Du solltest nur Deine eigene lesen.");

  AddDetail( ({ "decke" }),
    "Die Decke besteht aus hellen weissen Steinen.");

  AddDetail( ({ "steine", "stein" }),
    "Die Decke wurde aus weissen Steinen gefertigt.");

  AddSpecialDetail( ({ "tintenfass", "fass" }),
    "strtintenfass");

  AddSpecialDetail( ({ "hand" }),
    "strhand");

  AddSpecialDetail( ({ "schmierfink" }),
    "strschmierfink");

  AddSpecialDetail( ({ "unterseite" }),
    "strunterseite");

  AddSpecialDetail( ({ "briefe" }),
    "strbriefe");

  AddSpecialDetail( ({ "freund", "freundin" }),
    "strfreund");

  AddSpecialDetail( ({ "haelfte" }),
    "strhaelfte");

  AddSound( DEFAULT_SOUND,
    "Leise, gedaempfte Geraeusche dringen von draussen herein. Ansonsten "
    "herrscht voellige Stille.");

  AddSound( ({ "geraeusche", "geraeusch" }),
    "Die Geraeusche von draussen hoerst Du hier drinnen nur gedaempft.");

  AddSound( ({ "stille" }),
    "Es ist angenehm ruhig hier.");

  AddSmell( DEFAULT_SMELL,
    "Ein schwacher Geruch von Papier und Tinte schwebt im Raum.");

  AddSmell( ({ "geruch" }),
    "Nur schwach kannst Du den Geruch von Papier und Tinte wahrnehmen.");

  AddSmell( ({ "papier" }),
    "Das Papier riecht nach ... Papier.");

  AddSmell( ({ "tinte" }),
    "Ein etwas strenger Geruch geht von dem grossen Tintenfass aus.");

  AddSmell( ({ "tintenfass" }),
    "Die Tinte verstroemt einen etwas strengen, dennoch aber nicht sehr "
    "unangenehmen Geruch.");

  AddSmell( ({ "raum" }),
    "Es riecht schwach nach Papier und Tinte.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "nordwesten", "nach Nordwesten#" + "./ug_mitte" );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "lies", "les", "lese" }), "lesen" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer SpecialDetails-----------------------------------------

string strunterseite(string str)
{
  string s;

  if(fass == VOLL)
  {
  	s = "Du hebst das Tintenfass kurz hoch und betrachtest interessiert "
  	+"seine Unterseite. Huch, Du Tollpatsch! Jetzt ist Dir doch glatt "
  	+"ein grosser Teil der schwarzen Fluessigkeit aus dem Glas ueber "
  	+"Deine Hand gelaufen. Vielleicht haettest Du es nicht so schraeg "
  	+"halten sollen.";
  	fass = LEER;
  	player = getuid(TP);
  }
  else
  {
        if(getuid(TP) == player)
        {
                s = "Nein, Du hast aus Deinem Fehler gelernt und laesst das "
                +"das Tintenfass lieber dort stehen, wo es ist.";
        }
        else
        {
                s = "Lass das Tintenfass lieber stehen. Du koenntest sonst "
                +"womoeglich etwas von der kostbaren Tinte verschuetten.";
        }
  }
  return BS(s);
}

void reset()
{
	::reset();
	fass = VOLL;
	player = "";
}

string strtintenfass(string str)
{
  string s;

  if(fass == VOLL)
  {
  	s = "Das grosse Tintenfass ist fast bis obenhin mit einer "
  	    +"tiefschwarzen Fluessigkeit gefuellt.";
  }
  else
  {
  	s = "Das grosse Tintenfass ist fast bis zur Haelfte hin mit einer "
  	    +"tiefschwarzen Fluessigkeit gefuellt.";
  }
  return BS(s);
}

string strhaelfte(string str)
{
  string s;

  if(fass == VOLL)
  {
  	s = "Sowas siehst Du da nicht!";
  }
  else
  {
  	s = "Es ist etwa halbvoll.";
  }
  return BS(s);
}

string strhand(string str)
{
  string s;

  if(fass == LEER)
  {
  	s = "Deine ganze Hand ist mit schwarzer Tinte beschmiert.\n"
  	+"Du kleiner Schmierfink!";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

string strschmierfink(string str)
{
  string s;

  if(fass == LEER)
  {
  	s = "Ja genau, Du bist gemeint.";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

string strbriefe(string str)
{
  string s;
  s = "Sowas siehst Du da nicht!";

  if(this_player()->QueryProp(P_GENDER) == MALE)
  {
  	s = "Du solltest endlich mal wieder einen richtig schoenen langen "
  	+"Brief an Deinen besten Freund schreiben.";
  }
  if(this_player()->QueryProp(P_GENDER) == FEMALE)
  {
  	s = "Du solltest endlich mal wieder einen richtig schoenen langen "
  	+"Brief an Deine beste Freundin schreiben.";
  }
  return BS(s);
}

string strfreund(string str)
{
  string s;
  s = "Sowas siehst Du da nicht!";

  if(this_player()->QueryProp(P_GENDER) == MALE && str == "freund")
  {
  	s = "Du hast ihm bestimmt schon ewig nicht mehr geschrieben.";
  }
  if(this_player()->QueryProp(P_GENDER) == FEMALE && str == "freundin")
  {
  	s = "Du hast ihr bestimmt schon ewig nicht mehr geschrieben.";
  }
  return BS(s);
}

//--Funktionen-------------------------------------------------------------

int lesen(string str)
{
  notify_fail("Was moechtest Du lesen?\n");

  if(!str || str == "") return 0;

  if(!(str == "brief")) return 0;

  write("Liebe Lin.h,\n\n"
+"n.ch nie hat jema.d der.rt.ge Gefu.hle in mir gew.ckt wie Ihr. Se.tdem\n"
+"ich Eu.h das erste Mal s.h, ka.n ich an nichts anderes me.r de.ken als\n"
+"an Euch u.d Eu.r wunde.sch..nes Lae..eln, das he.ler st.ahlt als di. \n"
+"S.nne .m Hi.m.l. Ich wu.rde .uch so gerne sage., w.s ich fu.r Euch \n"
+"empf.nde, doch jedes.al, w.nn ich Eu.h s.he, f.hlt mir de. Mut dazu.\n"
+"Aus di..em Grunde versu.he ich nu. mit di.sem Bri.f, m..nen Gefu.hl.n\n"
+"fuer E.ch Ausdr.ck zu g.ben, in d.r Hoffn.ng, da.s au.h Ihr vielleic.t\n"
+"ei. wenig mehr fu.r mi.h empfind.t.\n\n"
+"In Lie.e un. ti.fster Fre.ndschaft,\n"
+"Eu.r T..gd.l\n\n\n"
+"Du wunderst Dich ein wenig. Entweder war der Absender dieses Briefes\n"
+"mit seinem Geschriebenen nicht zufrieden und hat ihn deshalb weggeworfen,\n"
+"oder er hat sich einfach nicht getraut, ihn abzuschicken.\n");

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" wuehlt im Papierkorb herum."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}
