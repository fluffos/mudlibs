}

//--Funktionen fuer SpecialDetails-----------------------------------------

string strtheke(string str)
{
  string s;

  if(QueryProp(P_SHOPKEEPER_ID))
  {
  	if(!present(QueryProp(P_SHOPKEEPER_ID)))
        {
              s = "Die Ladentheke ist sehr niedrig. Vor ihr auf dem Boden "
              "steht eine grosse Tafel und auf der Rueckseite hat sie zwei "
              "kleine Schubladen.";
        }
        else
        {
              s = "Die Ladentheke ist sehr niedrig. Vor ihr auf dem Boden "
              "steht eine grosse Tafel und auf der Rueckseite hat sie zwei "
              "kleine Schubladen. Hinter der Theke steht ein winziger "
              "Gnom, den Du fast voellig uebersehen haettest. Ob das der "
              "Ladeninhaber ist?";
        }
  }
  return BS(s);
}

//--Funktionen-------------------------------------------------------------

//Finger in Frettchenkaefig stecken:
int stecken(string str)
{
  notify_fail("Wo moechtest Du Deinen Finger hinein- oder hindurchstecken?\n");

  if(!str || str == "") return 0;

  if(!(str == "finger in drahtkaefig" ||
       str == "finger in kaefig" ||
       str == "kleinen finger in drahtkaefig" ||
       str == "kleinen finger in kaefig" ||
       str == "finger in zwischenraum" ||
       str == "finger in zwischenraeume" ||
       str == "kleinen finger in zwischenraum" ||
       str == "kleinen finger in zwischenraeume" ||
       str == "finger zwischen drahtstreben" ||
       str == "finger zwischen streben" ||
       str == "kleinen finger zwischen drahtstreben" ||
       str == "kleinen finger zwischen streben" )) return 0;

       write(BS("Du steckst Deinen kleinen Finger versuchsweise "
       +"in den Kaefig hinein und freust Dich, dass er wirklich "
       +"hindurchpasst. Der Bewohner des Kaefigs scheint Dein Experiment "
       +"jedoch gar nicht so lustig zu finden, denn er kommt ploetzlich auf "
       +"Dich zugeschossen und zwickt Dich in Deinen kleinen Finger hinein. "
       +"Aua! Schnell ziehst Du ihn wieder heraus.\n"));

       TO->Message(BS(TP->Name(WER, 1)+" fummelt an einem der Drahtkaefige "
       +"herum und zuckt dann ploetzlich zusammen."),
       MSGFLAG_VISUAL|MSGFLAG_NO_TP);

       TP->AddHp(-1-random(14));
       return 1;
}

//Tuer vom Frettchenkaefig oeffnen:
int oeffnen(string str)
{
  notify_fail("Was willst Du oeffnen?\n");

  if(!str || str == "") return 0;

  if(str == "tuerchen" ||
     str == "kaefigtuerchen" ||
     str == "kaefigtuer" )
  {
        if(QueryProp(P_SHOPKEEPER_ID))
        {
             if(!present(QueryProp(P_SHOPKEEPER_ID)))
             {
                  write(BS("Nein, das lass mal lieber bleiben. Gordrogh "
                  +"waere sicher nicht sonderlich erfreut, wenn er "
                  +"wiederkommt und all seine Frettchen auf und davon "
                  +"sind."));
                  return 1;
             }
             else
             {
                  write(BS("Als Du Dich anschickst, das Tuerchen eines der "
                  +"Drahtkaefige zu oeffnen, wirft Dir Gordrogh einen "
                  +"drohenden Blick zu, so dass Du Dich lieber doch "
                  +"entschliesst, Deinen Plan aufzugeben und die Frettchen "
                  +"Frettchen sein zu lassen."));

                  TO->Message(BS(TP->Name(WER, 1)+" naehert sich kurz den "
                  +"Drahtkaefigen, wird aber von Gordrogh aufgehalten."),
                  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
                  return -1;
             }
        }
  }

  if(str == "tuer" ||
     str == "hintertuer" ||
     str == "gruene tuer" )
   {
        if(QueryProp(P_SHOPKEEPER_ID))
        {
             if(!present(QueryProp(P_SHOPKEEPER_ID)))
             {
                  write(BS("Du oeffnest die Hintertuer und siehst "
                  +"in dem kleinen Raum dahinter einen grossen Kaefig "
                  +"mit einem riesigen, haarigen Ungetuem darin. "
                  +"Schnell machst Du die Tuer wieder zu, bevor es "
                  +"noch auf Dich aufmerksam wird."));

                  TO->Message(BS(TP->Name(WER, 1)+" wirft einen kurzen "
                  +"Blick durch die Hintertuer."),
                  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
                  return 1;
             }
             else
             {
                  write(break_string("Du oeffnest die Hintertuer und "
                  +"schaffst es gerade noch, einen kurzen Blick auf den "
                  +"grossen Kaefig und das riesige Ungetuem darin zu werfen, "
                  +"bevor Gordrogh Dir die Tuer wuetend vor der Nase "
                  +"zuschlaegt.\nGordrogh sagt: Da gehst Du besser nicht "
                  +"hinein!\n", 78,0,1));

                  TO->Message(BS(TP->Name(WER, 1)+" wirft einen kurzen "
                  +"Blick durch die Hintertuer."),
                  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
                  return -1;
             }
        }
  }

    if(str == "schublade" ||
       str == "schubladen" )
    {
    	write(BS("Du ruettelst ein wenig an der Schublade herum, "
    	+"bekommst sie aber leider nicht auf."));

      TO->Message(BS(TP->Name(WER, 1)+" ruettelt an einer Schublade herum."),
      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      return 1;
    }
}

//in Waschbaerenkiste schauen:
int schauen(string str)
{
  notify_fail("Wo moechtest Du hineinschauen?\n");

  if(!(str == "in holzkiste" ||
       str == "in holzkisten" ||
       str == "in kiste" ||
       str == "in kisten" )) return 0;

       write(BS("Du beugst Dich ueber eine der grossen Holzkisten und "
       +"blickst auf einen kleinen Waschbaeren herab, der sich dort "
       +"gemuetlich auf dem mit Stroh ausgepolsterten Kistenboden "
       +"zusammengerollt hat und zu schlafen scheint."));

       TO->Message(BS(TP->Name(WER, 1)+" schaut neugierig in eine der "
       +"grossen Holzkisten hinein."),
       MSGFLAG_VISUAL|MSGFLAG_NO_TP);
       return 1;
}

//Waschbaer wecken:
int wecken(string str)
{
  notify_fail("Wen moechtest Du aufwecken?\n");

  if(!str || str == "") return 0;

  if(!(str == "waschbaer" ||
       str == "waschbaeren" )) return 0;

  write(BS("Vorsichtig stubst Du den kleinen Waschbaeren an. Ploetzlich "
  +"faengt seine rechte Pfote leicht an zu zucken und er schlaegt seine "
  +"noch babyblauen Augen auf. Verwundert blickt der kleine Baer Dich an, "
  +"gaehnt ausgiebig und rollt sich dann wieder zusammen, um selig "
  +"weiterzuschlummern."));

  TO->Message(BS(TP->Name(WER, 1)+" beugt sich ueber eine der Holzkisten."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

//dem Klopfen nachgehen:
int gehen(string str)
{
  notify_fail("Wem oder was moechtest Du nachgehen?\n");

  if(!(str == "klopfen nach" ||
       str == "dem klopfen nach" ||
       str == "klopfgeraeusch nach" ||
       str == "dem klopfgeraeusch nach" ||
       str == "klopfgeraeuschen nach" ||
       str == "den klopfgeraeuschen nach" )) return 0;

       write(BS("Du wirfst einen schnellen Blick hinter die "
       +"Ladentheke und entdeckst ploetzlich in einer dunklen Ecke "
       +"dahinter einen grossen, wolfsaehnlichen Hund, der es sich "
       +"dort auf einer alten Wolldecke gemuetlich gemacht hat. "
       +"Das seltsame Klopfgeraeusch wird dadurch verursacht, dass er "
       +"mit seinem langen, buschigen Schwanz auf den Boden klopft."));

       TO->Message(BS(TP->Name(WER, 1)+" wirft einen schnellen Blick "
       +"hinter die Theke."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
       return 1;
}

//Wolfshund streicheln:
int streicheln(string str)
{
  notify_fail("Wen willst Du streicheln?\n");

  if(!(str == "hund" ||
       str == "wolfshund" )) return 0;

       write(BS("Du naeherst Dich dem Wolfshund vorsichtig und "
       +"kraulst ihn ein wenig hinter den Ohren. Freudig schleckt er Dir "
       +"ueber Deine Hand. Anscheinend gefaellt es ihm, gestreichelt zu "
       +"werden."));

       TO->Message(BS(TP->Name(WER, 1)+" verschwindet kurz hinter "
       +"der Theke."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
       return 1;
}

//Kein verkaufen hier:
int sell(string str, int f)
{
  string prefix;

  if (!prefix=CheckKeeper(2)) return 0;

  write(capitalize(QueryProp(P_SHOPKEEPER_NAME))+
       " knurrt: Ich kaufe nichts von Dir!\n");
  return -1;
}
