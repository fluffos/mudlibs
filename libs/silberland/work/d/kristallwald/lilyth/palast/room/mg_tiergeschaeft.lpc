#include "../def.h"
#include <laden.h>
#include "/p/service/angel/haustiere/std_pet.h"

inherit "/p/service/angel/haustiere/std_petshop";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"In einem kleinen Geschaeft");
  SetProp(P_INT_LONG,
    "Du hast das kleine Geschaeft betreten und findest Dich nun in einem mit "
    "zahlreichen Gegenstaenden ueberfuellten Raum wieder. Ueberall auf dem "
    "Boden stehen kleinere und groessere Kaefige herum. In den Regalen an "
    "den Waenden liegen mehrere kleine Kartons ordentlich aufgereiht "
    "nebeneinander und an einer Wand steht ein seltsames Geruest. Direkt "
    "vor Dir befindet sich eine niedrige Ladentheke, an der eine grosse "
    "Tafel auf dem Boden lehnt.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_SHOPKEEPER_ID, "gordrogh");
  SetProp(P_SHOPKEEPER_NAME, "Gordrogh");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  catch(call_other(ROOM "mg_lagerraum_tiergeschaeft", "???"));
  SetStorageRoom(ROOM "mg_lagerraum_tiergeschaeft");

  SetProp(P_PET_KONFIG_TOOL,
    "/d/kristallwald/lilyth/palast/obj/haustiere/stab");

  AddPet("zebramaus",
    "/p/service/angel/haustiere/npc/kwlil_zebramaus");
  AddPet("waldkauz",
    "/p/service/angel/haustiere/npc/kwlil_waldkauz");
  AddPet("frettchen",
    "/p/service/angel/haustiere/npc/kwlil_frettchen");
  AddPet("waschbaer",
    "/p/service/angel/haustiere/npc/kwlil_waschbaer");
  AddPet("schleiereule",
