  AddDetail( ({ "gesichter" }),
    "Sie sind nur zu erahnen.");

  AddDetail( ({ "schutz" }),
    "Die Umhaenge schuetzen sie vor der Sonne.");

  AddDetail( ({ "zwerge", "zwerg" }),
    "Eine Gruppe von Zwergen hat sich ein kleines Stueck vom Portal entfernt "
