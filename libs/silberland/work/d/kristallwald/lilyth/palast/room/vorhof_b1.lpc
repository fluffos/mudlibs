  AddDetail( ({ "sand", "sandschicht", "schicht" }),
    "Eine helle Sandschicht bedeckt den gesamten Boden.");

  AddDetail( ({ "fussspuren", "spuren", "fusspuren" }),
    "Unzaehlige Fussspuren sind im Sand zu erkennen.");

  AddDetail( ({ "vorhof" }),
    "Du befindest Dich hier auf dem Vorhof des Palastes.");

  AddDetail( ({ "zwergenjunge", "junge" }),
    "Der ist schon laengst ueber alle Berge.");

  AddDetail( ({ "herr" }),
    "Er ist in dem Gewuehl untergetaucht.");

  AddSound( DEFAULT_SOUND,
