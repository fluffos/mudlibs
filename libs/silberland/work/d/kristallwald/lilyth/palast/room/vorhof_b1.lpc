  AddSound( ({ "unterhaltungen", "unterhaltung" }),
    "Du hoerst nichts, was Dir sonderlich interessant erscheint.");

  AddSound( ({ "leute", "besucher", "palastbesucher" }),
    "Die Besucher um Dich herum unterhalten sich leise.");

  AddSound( ({ "dinge", "dingen" }),
    "Dingen, die Du nicht hoeren kannst.");

  AddSound( ({ "rufen" }),
    "Es scheint aus dem Westen zu kommen.");

  AddSound( ({ "westen" }),
    "Ab und zu dringt ein lautes Rufen aus dem Westen hierher.");

  AddSound( ({ "vorhof" }),
    "Lautes Kindergeschrei und leise Gespraechsfetzen dringen an Dein Ohr.");

  AddSound( ({ "ohr" }),
    "Du kannst an Deinem eigenen Ohr nicht lauschen.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft ist angenehm frisch hier draussen.");

  AddSmell( ({ "luft" }),
    "Du laesst die frische Luft in Deine Lungen stroemen. Ah, tut das gut!");

  AddSmell( ({ "lungen" }),
    "Du atmest tief ein und aus.");

  AddSpecialDetail( ({ "trolle" }),
    "strtrolle");

  AddRoomMessage(
    ({ BS("Ein kleiner Zwergenjunge stuermt an Dir vorueber und rempelt "
