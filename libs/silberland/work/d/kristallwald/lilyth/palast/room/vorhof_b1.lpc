  AddDetail( ({ "gewuehl" }),
    "Hier vor dem Palastportal ist ziemlich viel los.");

  AddDetail( ({ "erwachsene", "erwachsenen" }),
    "Gemuetlich unterhalten sich die Erwachsenen miteinander.");

  AddDetail( ({ "geschehen", "treiben" }),
    "Auf dem Vorhof herrscht ein reges Treiben.");

  AddDetail( ({ "menschen" }),
    "Auch einige Menschen siehst Du auf dem Vorhof vor dem Portal stehen.");

  AddDetail( ({ "umhaenge", "kapuzen" }),
    "Die Umhaenge der Dunkelelfen haben weite Kapuzen, hinter denen ihre "
