       BS("Von irgendwoher hoerst Du ein lautes Rufen."),
       BS("Ein etwas verwirrt aussehender aelterer Herr stolpert an Dir "
          "vorbei.") }), 100, "func");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", "nach Westen#" + "./vorhof_a1" );
  AddExit( "sueden", "nach Sueden#" + "./vorhof_b2" );
  AddExit( "osten", "nach Osten#" + "./vorhof_c1" );
  AddExit( "rein", ([ EX_DEST:     "./ug_eingangshalle",
                      EX_MSG:      "in den Palast",
                      EX_TESTFUNC: "exit_test" ]) );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "schliess", "schliesse" }), "portal_schliessen" );
  AddCmd( ({ "oeffne" }), "portal_oeffnen" );
  AddCmd( ({ "zaehl", "zaehle" }), "zaehlen" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "trollwaechter", REFRESH_DESTRUCT);
  AddItem(NPC "trollwaechter", REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Langbeschreibung-------------------------------------------------------

string _query_int_long()
{
  string txt;
  string s;
  object *trollwaechter;
  trollwaechter = all_inventory(TO);
  trollwaechter = filter_objects(trollwaechter,"id","trollwaechter");

   switch(sizeof(trollwaechter))
   {
        case 0:
          s = "Es scheint vollkommen unbewacht zu sein.";
        break;

        case 1:
          s = "Es wird von einem kraeftig aussehenden Trollwaechter "
              +"bewacht.";
        break;

        default:
          s = "Es wird von zwei kraeftig aussehenden Trollwaechtern "
              +"bewacht.";
        break;
   }

   txt = "Vor Dir erhebt sich ein grosses praechtiges Portal, das in das "
    "Innere des Palastes hineinzufuehren scheint. "+s+" Breite Steinstufen "
    "fuehren zu den beiden weit geoeffneten Portaltueren hinauf, durch die "
    "zahlreiche Besucher alleine oder in kleinen Grueppchen in den Palast "
    "hineinstroemen oder gerade herauskommen.";

   return BS(txt);
}

//--Funktion fuer Ausgang--------------------------------------------------

int exit_test(string dir)
{
  object mywaechter;

  if(!TP||!interactive(TP)) return 1;
  mywaechter=present("\ntrollwaechter");

  if(mywaechter)
  {
    if(TP->QueryProp(P_WEAPON) != 0)
    {
      write(BS("Der kraeftige Trollwaechter haelt Dich mit strengem Blick "
      +"zurueck und sagt: Niemand darf den Palast mit gezueckter Waffe "
      +"betreten!"));

      TO->Message(BS("Der kraeftige Trollwaechter haelt "+TP->Name(WEN, 1)
      +"mit strengem Blick zurueck, als "
      +(PL->QueryProp(P_GENDER)==MALE?"er":"sie")+" den Palast betreten "
      +"will."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      return 0;
    }

    if(PALASTMASTER->IsEnemy(TP))
    {
      write(BS("Der kraeftige Trollwaechter herrscht Dich an: "
      +"Nichts da, Freundchen, Du bist ein Feind des Palastes und "
      +"kommst hier nicht rein!"));

      TO->Message(BS("Der kraeftige Trollwaechter herrscht "
      +TP->Name(WEN, 1)+" an: Nichts da, Freundchen, Du bist "
      +"ein Feind des Palastes und kommst hier nicht rein!"),
      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      return 0;
    }
  }
  return 1;
}

//--Funktionen fuer Kommandos----------------------------------------------

//Portal schliessen
int portal_schliessen(string str)
{
  notify_fail("Was moechtest Du schliessen?\n");

  if(!str || str == "") return 0;

  if(!(str == "portal" ||
       str == "tuer" ||
       str == "tueren" ||
       str == "portaltuer" ||
       str == "portaltueren" )) return 0;

  write(BS("Mit aller Kraft stemmst Du Dich gegen eine der "
  +"riesigen Portaltueren, doch nichts passiert. Die Tuer bewegt "
  +"sich keinen Millimeter von der Stelle."));

  TO->Message(BS(TP->Name(WER, 1)+" versucht, das Portal zu schliessen, "
  +"scheitert jedoch klaeglich.\n"), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

int portal_oeffnen(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");

  if(!str || str == "") return 0;

  if(!(str == "portal" ||
       str == "tuer" ||
       str == "tueren" ||
       str == "portaltuer" ||
       str == "portaltueren" )) return 0;

  write(BS("Aber die Portaltueren stehen doch bereits weit offen!"));
  return 1;
}

int zaehlen(string str)
{
  notify_fail("Was willst Du zaehlen?\n");

  if(!str || str == "") return 0;

  if(!(str == "fussspuren" ||
       str == "spuren" ||
       str == "fusspuren" )) return 0;

  write(BS("Du versuchst, die Fussspuren zu zaehlen, gibst es "
  +"jedoch bald wieder auf, da sie sich frueher oder spaeter alle "
  +"im Sande verlaufen und Du sie nicht mehr voneinander unterscheiden "
  +"kannst."));

  TO->Message(BS(TP->Name(WER, 1)+" scheint sich ueber irgendetwas "
  +"den Kopf zu zerbrechen."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

//--Funktionen fuer SpecialDetails-----------------------------------------

string strtrolle(string str)
{
  string s;
  object *trollwaechter;
  trollwaechter = all_inventory(TO);
  trollwaechter = filter_objects(trollwaechter,"id","trollwaechter");

  if(TP->QueryProp(P_RACE) == "Troll")
  {
    switch(sizeof(trollwaechter))
    {
      case 0:
        s = "Ausser Dir selbst siehst Du noch einige andere Vertreter "
           +"Deiner Rasse auf dem Vorhof.";
        break;

      case 1:
        s = "Ausser dem Trollwaechter und Dir selbst siehst Du "
           +"noch einige andere Vertreter Deiner Rasse auf dem Vorhof.";
        break;

      default:
        s = "Ausser den beiden Trollwaechtern und Dir selbst siehst Du "
           +"noch einige andere Vertreter Deiner Rasse auf dem Vorhof.";
        break;
    }
  }
  else
  {
    switch(sizeof(trollwaechter))
    {
      case 0:
        s = "Du siehst einige Vertreter dieser Rasse auf dem Vorhof.";
        break;

      case 1:
      s = "Ausser dem Trollwaechter siehst Du noch einige andere "
         +"Vertreter dieser Rasse auf dem Vorhof.";
      break;

      default:
      s = "Ausser den beiden Trollwaechtern siehst Du noch einige "
         +"andere Vertreter dieser Rasse auf dem Vorhof.";
      break;
    }
  }
  return BS(s);
}
