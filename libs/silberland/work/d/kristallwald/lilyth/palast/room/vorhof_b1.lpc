  AddDetail( ({ "waerme" }),
    "Dein Gesicht wird schon ganz warm.");

  AddDetail( ({ "gesicht" }),
    "Die Sonne brennt auf Deinem Gesicht.");

  AddDetail( ({ "sonne" }),
    "Die Sonne scheint vom Himmel auf Dich herab.");

  AddDetail( ({ "wolke", "wolken" }),
    "Es sind nur wenige Wolken am Himmel zu sehen.");

  AddDetail( ({ "meter" }),
