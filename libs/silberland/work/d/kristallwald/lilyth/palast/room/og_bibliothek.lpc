#include "../def.h"

inherit "std/room";

//--Variablen&Defines------------------------------------------------------

int elf;
int zwerg;

#define SESSEL(wer) (member(sessel, capitalize(getuid(wer)))!=-1)
string *sessel=({});

string str_sound(string key);
string str_rascheln(string key);
string str_schnarchen(string key);

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------

  elf = DA;
  zwerg = DA;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einer Bibliothek");
  SetProp(P_INT_LONG,
    "Du befindest Dich in der Bibliothek des Palastes. Warmes Kerzenlicht "
    "erfuellt diesen Raum und beleuchtet die hohen, mit zahlreichen "
    "Buechern gefuellten Regale an den Waenden. Bequeme Polstersessel "
    "stehen vor einem grossen Kamin, in dem ein kleines Feuer brennt. "
    "An einer Wand steht eine grosse Standuhr aus hellem Holz und auf "
    "dem weissen Holzfussboden liegt ein weicher Teppich.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "bibliothek" }),
    "Aus den hohen Buecherregalen, die fast die gesamten Waende einnehmen "
    "und mit zahlreichen Buechern gefuellt sind, schliesst Du, dass es "
    "sich bei diesem Raum um eine Bibliothek handelt.");

  AddDetail( ({ "palast", "raum" }),
    "Du befindest Dich in der Bibliothek des Palastes.");

  AddDetail( ({ "kerzenlicht", "licht", "kerzenschein", "schein" }),
    "Die Bibliothek wird von einem warmen Kerzenlicht erfuellt.");

  AddDetail( ({ "kerzen" }),
    "Du blickst Dich suchend um und entdeckst ploetzlich einen kleinen "
    "Tisch, auf dem eine Kerze steht.");

  AddDetail( ({ "tisch" }),
    "Der Tisch steht halb hinter einem der beiden Sessel verborgen, deshalb "
    "hast Du ihn nicht gleich gesehen. Eine einzelne Kerze steht auf ihm.");

  AddDetail( ({ "kerze" }),
    "Die Kerze leuchtet sehr hell und spendet genuegend Licht, um den "
    "gesamten Raum ausreichend zu erhellen. Es ist sicherlich auf magische "
    "Weise verstaerkt worden.");

  AddDetail( ({ "weise" }),
    "Das wirst Du wohl nie herausfinden.");

  AddDetail( ({ "buecher" }),
    "Zahlreiche Buecher stehen in den Regalen und scheinen nur darauf zu "
    "warten, von Dir gelesen zu werden.");

  AddDetail( ({ "buecherregale", "buecherregal", "regale", "regal" }),
    "Die hohen Buecherregale reichen fast bis an die Decke. Sie sind "
    "mit zahlreichen Buechern bestueckt.");

  AddDetail( ({ "waende" }),
    "Die hohen Waende sind vor lauter Buecherregalen kaum zu sehen. Die "
    "einzige regalfreie Stelle wird von einer grossen Standuhr "
    "eingenommen.");

  AddDetail( ({ "stelle" }),
    "Nur an einer Stelle befindet sich kein Regal an der Wand. Dafuer steht "
    "dort eine grosse Standuhr aus hellem Holz.");

  AddDetail( ({ "polstersessel" }),
    "Zwei gepolsterte Sessel stehen vor dem Kamin. In einem von ihnen "
    "sitzt ein hochgewachsener Elf, der voellig vertieft in einem grossen "
    "Buch liest. Der andere Sessel wird von einem baertigen Zwerg "
    "eingenommen, der zu schlafen scheint.");

  AddDetail( ({ "kamin" }),
    "Der grosse Kamin befindet sich an der Dir gegenueberliegenden Wand. "
    "Ein kleines Feuer prasselt darin und fuellt die Bibliothek mit einer "
    "angenehmen Waerme.");

  AddDetail( ({ "waerme" }),
    "Es ist angenehm warm hier drinnen.");

  AddDetail( ({ "feuer" }),
    "Ein kleines Feuer prasselt lustig im Kamin vor sich hin.");

  AddDetail( ({ "wand" }),
    "An einer Wand steht eine hohe Standuhr.");

  AddDetail( ({ "standuhr", "uhr" }),
    "Die Standuhr besteht aus einem laenglichen, im unteren Bereich "
    "offenen Holzgehaeuse, in dem ein langes Pendel langsam hin und her "
    "schwingt. Das runde Ziffernblatt schimmert hell im Kerzenlicht.");

  AddDetail( ({ "bereich" }),
    "Der untere Bereich des Uhrengehaeuses ist offen, so dass Du das "
    "Pendel deutlich erkennen kannst. Doch halt, ploetzlich siehst Du "
    "ein schwaches Aufblitzen im Kerzenschein und bemerkst dann die duenne "
    "Glasplatte, die sich zwischen Dir und dem Pendel befindet.");

  AddDetail( ({ "aufblitzen" }),
    "Es ist schon wieder verschwunden.");

  AddDetail( ({ "glasplatte", "platte" }),
    "Das Gehaeuse ist doch nicht ganz offen, wie Du zunaechst angenommen "
    "hattest. Das Pendel wird durch eine duenne Glasplatte vor neugierigen "
    "Besucherhaenden geschuetzt.");

  AddDetail( ({ "besucherhaende", "besucherhand" }),
    "Solchen wie den Deinen zum Beispiel.");

  AddDetail( ({ "beispiel", "beispiele" }),
    "Deine Haende sind ein geradezu perfektes Beispiel dafuer.");

  AddDetail( ({ "gehaeuse", "holzgehaeuse", "uhrengehaeuse" }),
    "Das Gehaeuse besteht aus weissem Holz.");

  AddDetail( ({ "pendel" }),
    "Das Pendel schwingt langsam hin und her.");

  AddDetail( ({ "ziffernblatt", "blatt" }),
    "Das Ziffernblatt der Uhr hat eine kreisrunde Form. Es schimmert "
    "ein wenig im Kerzenlicht, als ob es aus einem sehr edlen Material "
    "bestehen wuerde. Deutlich kannst Du die beiden Zeiger sehen, die "
    "Dir die Zeit anzeigen.");

  AddDetail( ({ "form" }),
    "Es ist kreisrund.");

  AddDetail( ({ "material" }),
    "Ob das Elfenbein ist?");

  AddDetail( ({ "elfenbein" }),
    "Ja, Du bist Dir ziemlich sicher, dass das Ziffernblatt aus "
    "Elfenbein besteht.");

  AddDetail( ({ "zeiger" }),
    "Die beiden Zeiger der Uhr zeigen Dir die Zeit an.");

  AddDetail( ({ "zeit" }),
    "Du koenntest sie ablesen.");

  AddDetail( ({ "holz" }),
    "Das Holz, aus dem die Standuhr besteht, hat fast die gleiche Farbe "
    "wie der Boden unter Deinen Fuessen.");

  AddDetail( ({ "fuesse" }),
    "Die sind noch da.");

  AddDetail( ({ "farbe" }),
    "Das Holz hat eine hellweisse Farbe.");

  AddDetail( ({ "holzfussboden", "boden", "fussboden" }),
    "Der Holzfussboden besteht aus weissen Holzlatten, die mit "
    "groesster Sorgfalt verlegt worden sind. Der groesste Teil des Bodens "
    "wird von einem weichen, ebenfalls hellfarbigen Teppich bedeckt.");

  AddDetail( ({ "holzlatten", "latten" }),
    "Helle, weisse Holzlatten wurden auf dem Boden verlegt.");

  AddDetail( ({ "sorgfalt" }),
    "Die Holzlatten wurden mit aeusserster Sorgfalt verlegt. Du siehst "
    "keine einzige Fuge oder Spalte.");

  AddDetail( ({ "fuge", "fugen" }),
    "Keine zu sehen.");

  AddDetail( ({ "spalte", "spalten" }),
    "Nein, keine einzige.");

  AddDetail( ({ "teil" }),
    "Ein grosser, weicher Teppich bedeckt den groessten Teil des "
    "Holzfussbodens.");

  AddDetail( ({ "teppich" }),
    "Der Teppich ist hellweiss und fuehlt sich herrlich weich unter Deinen "
    "Fuessen an.");

  AddDetail( ({ "decke" }),
    "Die helle Holzdecke befindet sich hoch ueber Deinem Kopf.");

  AddDetail( ({ "holzdecke" }),
    "Auch die Decke besteht hier aus Holz.");

  AddDetail( ({ "kopf" }),
    "Ein gutes Stueck ueber Deinem Kopf kannst Du die Decke sehen.");

  AddDetail( ({ "stueck" }),
    "Du schaetzt es auf etwa zwei gute Elfenlaengen.");

  AddDetail( ({ "elfenlaenge", "elfenlaengen", "laenge", "laengen" }),
    "Das ist ziemlich lang.");

  AddSpecialDetail( ({ "sessel", "polstersessel" }),
    "strsessel");

  AddSpecialDetail( ({ "elf" }),
    "strelf");

  AddSpecialDetail( ({ "haar", "haare" }),
    "strhaare");

  AddSpecialDetail( ({ "ohr", "ohren" }),
    "strohren");

  AddSpecialDetail( ({ "gesicht" }),
    "strgesicht");

  AddSpecialDetail( ({ "platz" }),
    "strplatz");

  AddSpecialDetail( ({ "buch", "goldenes buch" }),
    "strbuch");

  AddSpecialDetail( ({ "haende", "hand" }),
    "strhaende");

  AddSpecialDetail( ({ "zwerg" }),
    "strzwerg");

  AddSpecialDetail( ({ "bart" }),
    "strbart");

  AddSound(DEFAULT_SOUND,
    #'str_sound);

  AddSound( ({ "rascheln", "papier", "elf", "buch" }),
    #'str_rascheln);

  AddSound( ({ "geraeusch", "schnarchen", "zwerg" }),
    #'str_schnarchen);

  AddSound( ({ "prasseln" }),
    "Du kannst das leise Prasseln des Feuers hoeren.");

  AddSound( ({ "feuer", "kamin" }),
    "Das Feuer im Kamin prasselt leise vor sich hin.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach alten Buechern und ein wenig nach Rauch.");

  AddSmell( ({ "buecher", "buch" }),
    "Der Geruch von alten Buechern umgibt Dich.");

  AddSmell( ({ "rauch" }),
    "Ein schwacher Geruch von Rauch kommt von dem Feuer im Kamin.");

  AddSmell( ({ "geruch" }),
    "Er ist nur sehr schwach und stoert Dich nicht weiter.");

  AddSmell( ({ "feuer", "kamin" }),
    "Das Feuer im Kamin riecht ein wenig nach Rauch.");

//--Ausgaenge--------------------------------------------------------------

  AddExit ("osten", ([ EX_DEST: "./og_treppe",
                       EX_TESTFUNC: "exit_test",
                       EX_MSG: "nach Osten" ]) );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "weck", "wecke" }), "wecken" );
  AddCmd( ({ "bitt", "bitte" }), "bitten" );
  AddCmd( ({ "sitz", "sitze", "setz", "setze" }), "sitzen" );
  AddCmd( ({ "steh", "stehe" }), "aufstehen" );
  AddCmd( ({ "lies", "les", "lese" }), "lesen" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(OBJ "regal", REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer SpecialDetails-----------------------------------------

string strsessel(string str)
{
  string s;

  s = "Zwei gepolsterte Sessel stehen vor dem Kamin. ";

  if(elf == WEG && zwerg == WEG && sizeof(sessel) == 0)
  {
  	s += "Sie laden geradezu dazu ein, es sich in ihnen bequem zu "
  	+"machen und ein wenig zu lesen.";
  }

  if(elf == DA && zwerg == DA)
  {
  	s += "In einem von ihnen sitzt ein hochgewachsener Elf, der voellig "
  	+"vertieft in einem grossen Buch liest. Der andere Sessel wird von "
  	+"einem baertigen Zwerg eingenommen, der zu schlafen scheint. ";
  }

  if(elf == DA && zwerg == WEG)
  {
        s += "In einem von ihnen sitzt ein hochgewachsener Elf, der voellig "
             +"vertieft in einem grossen Buch liest. ";
  }

  if(zwerg == DA && elf == WEG)
  {
        s += "Einer der Sessel wird von einem baertigen Zwerg eingenommen, "
        +"der zu schlafen scheint. ";
  }

  if((elf == DA || zwerg == DA) && sizeof(sessel) == 1)
  {
        if(SESSEL(TP))
        {
           s += "In dem anderen Sessel sitzt Du.";
        }
        else
        {
           s += "In dem anderen Sessel sitzt "+capitalize(sessel[0])+".";
        }
  }

  if(zwerg == WEG && elf == WEG && sizeof(sessel) == 1)
  {
        if(SESSEL(TP))
        {
           s += "In einem der Sessel sitzt Du, waehrend der andere noch "
               +"frei zu sein scheint.";
        }
        else
        {
           s += "In einem der Sessel sitzt "+capitalize(sessel[0])+". Der "
               +"andere scheint noch frei zu sein.";
        }
  }

  if(zwerg == WEG && elf == WEG && sizeof(sessel) == 2)
  {
        if(SESSEL(TP))
        {
           sessel -= ({ capitalize(getuid(TP)) });
           s += "Du und "+capitalize(sessel[0])+" sitzt darin.";
           sessel += ({ capitalize(getuid(TP)) });
        }
        else
        {
           s += "In ihnen sitzen "+capitalize(sessel[0])+" und "
                +capitalize(sessel[1])+".";
        }
  }

  return BS(s);
}


string strelf(string str)
{
  string s;

  if(elf == DA)
  {
  	s = "Der Elf hat lange, silbrigblonde Haare, spitze Ohren und "
  	+"ein freundliches, offenes Gesicht. Er scheint Dich jedoch gar "
  	+"nicht zu bemerken, so vertieft ist er in das grosse goldene "
  	+"Buch, das er in seinen Haenden haelt.";
  }
  else
  {
        s = "Sowas siehst Du da nicht!";
  }

  return BS(s);
}

