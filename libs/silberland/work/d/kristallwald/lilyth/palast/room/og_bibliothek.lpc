//Sound:
string str_sound(string key)
{
	if(zwerg == WEG && elf == WEG)
	{
           return BS("Du hoerst nur das leise Prasseln des Feuers im "
           +"Kamin.\n");
        }

        if(zwerg == WEG && elf == DA)
        {
           return BS("Du hoerst das Prasseln des Feuers im Kamin und "
           "ab und zu ein leises Rascheln, wenn der Elf eine Seite seines "
           "Buches umschlaegt.\n");
        }

        if(zwerg == DA && elf == WEG)
        {
           return BS("Du hoerst das leise Prasseln des Feuers im Kamin und "
           "ab und zu ein seltsames Geraeusch.\n");
        }

        if(zwerg == DA && elf == DA)
        {
           return BS("Du hoerst das Prasseln des Feuers im Kamin und "
           "ab und zu ein leises Rascheln, wenn der Elf eine Seite seines "
           "Buches umschlaegt. Ausserdem dringt ab und zu ein seltsames "
           "Geraeusch an Dein Ohr.\n");
        }
}

string str_rascheln(string key)
{
	if(elf == DA)
	{
          return BS("Du hoerst das leise Rascheln von Papier, wenn der Elf "
          +"in seinem Buch blaettert.\n");
        }
        else
        {
          return "Du lauschst, hoerst aber nichts.\n";
        }
}

string str_schnarchen(string key)
{
	if(zwerg == DA)
	{
          return BS("Das seltsame Geraeusch kommt von dem schlafenden Zwerg "
          +"im Sessel. Er schnarcht leise vor sich hin.\n");
        }
        else
        {
          return "Du lauschst, hoerst aber nichts.\n";
        }
}

//--Funktionen-------------------------------------------------------------

int lesen(string str)
{
  string *zeit;
  zeit = explode( dtime(), ", ");

  notify_fail("Was moechtest Du lesen oder ablesen?\n");

  if(!str || str == "") return 0;

  if(!(str == "zeit" ||
       str == "zeit ab" ||
       str == "zeit von uhr ab" ||
       str == "die zeit" ||
       str == "die zeit ab" ||
       str == "die zeit von uhr ab" ||
       str == "zeit von standuhr ab" ||
       str == "die zeit von standuhr ab" )) return 0;

  	write(break_string("Du betrachtest die Zeiger der Standuhr.\n"
  	+"Es ist jetzt genau "+zeit[sizeof(zeit)-1]+" Uhr.\n",
  	78,0,1));

  	TO->Message(BS(TP->Name(WER, 1)+" schaut auf die Uhr."),
  	MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        return 1;
}

int wecken(string str)
{
  notify_fail("Wen willst Du wecken?\n");

  if(!str || str == "") return 0;

  if(!(str == "zwerg" ||
       str == "zwerg auf" )) return 0;

  if(zwerg == DA)
  {
  	write(break_string("Du ruettelst den friedlich schlummernden Zwerg "
  	+"unsanft an der Schulter.\nErschrocken faehrt er hoch und stiert "
  	+"Dich mit wildem Blick an. Dann murmelt er ein paar unfeine Worte "
  	+"und stapft mit finsterem Blick aus dem Zimmer.\n",
  	78,0,1));

  	TO->Message(break_string(TP->Name(WER, 1)+" beugt sich ueber einen "
  	+"der beiden Polstersessel.\nKurz darauf springt der Zwerg, der "
  	+"dort seelenruhig geschlafen hat, auf, wirft "+TP->Name(WER, 1)+" "
  	+"noch einen finsteren Blick zu und stapft dann aus dem Zimmer.\n",
  	78,0,1), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        zwerg = WEG;
        return 1;
  }
  else
  {
  	write(BS("Siehst Du hier irgendwo einen Zwerg? Nein? Wieso willst "
  	+"Du dann einen wecken, wo hier doch gar keiner ist?"));
        return -1;
  }
}

int bitten(string str)
{
  notify_fail("Wen moechtest Du worum bitten?\n");

  if(!str || str == "") return 0;

  if(!(str == "elf um platz" ||
       str == "elf freundlich um platz" ||
       str == "elf um sessel" ||
       str == "elf freundlich um sessel" ||
       str == "elf darum, platz zu machen" ||
       str == "elf darum, mir platz zu machen" ||
       str == "elf freundlich darum, platz zu machen" ||
       str == "elf freundlich darum, mir platz zu machen" )) return 0;

  if(elf == DA)
  {
  	write(break_string("Durch den wohlwollenden Blick des Elfen "
  	+"ermutigt, fragst Du ihn, ob er fuer Dich Platz machen wuerde.\n"
  	+"Er legt sein Buch beiseite, erhebt sich aus dem Sessel, "
  	+"nickt Dir freundlich zu und verlaesst dann die Bibliothek.\n",
  	78,0,1));

  	TO->Message(break_string(TP->Name(WER, 1)+" spricht leise mit einem "
  	+"Elfen, der bis eben noch in einem der Sessel sass, nun aber "
  	+"aufsteht, "+TP->Name(WER, 1)+" freundlich zunickt und dann die "
  	+"Bibliothek verlaesst.\n",
  	78,0,1), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    elf = WEG;
    return 1;
  }
  else
  {
  	return 0;
  }
}

int sitzen(string str)
{
  notify_fail("Wo moechtest Du Dich hinsetzen?\n");

  if(!str || str == "") return 0;

  if(!(str == "auf sessel" ||
       str == "in sessel")) return 0;

  if(SESSEL(TP))
  {
        write(BS("Du sitzt doch schon in einem der beiden Sessel."));
        return -1;
  }

  //2 Spieler od. Elf+Zwerg sitzen im Sessel
  if((sizeof(sessel) > 1) || (elf == DA && zwerg == DA))
  {
        write(BS("Leider sind beide Sessel schon besetzt."));
        return -1;
  }

  //1 Spieler + Elf od. Zwerg sitzen im Sessel
  if((elf == DA || zwerg == DA) && sizeof(sessel)>0)
  {
        write(BS("Leider sind beide Sessel schon besetzt."));
        return -1;
  }

  write(break_string("Du machst es Dir in dem Sessel gemuetlich.\n"
  +"Jetzt fehlt eigentlich nur noch ein gutes Buch.", 78,0,1));

  TO->Message(BS(TP->Name(WER, 1)+" setzt sich in einen der Sessel."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  sessel += ({ capitalize(getuid(TP)) });
  return 1;
}

int aufstehen(string str)
{
  notify_fail("Was moechtest Du tun?\n");

  if(!str || str == "") return 0;

  if(!(str == "von sessel auf" ||
       str == "aus sessel auf" ||
       str == "auf")) return 0;

  if(SESSEL(TP))
  {
        write(BS("Du stehst wieder auf."));

        TO->Message(BS(TP->Name(WER, 1)+" erhebt sich aus einem der "
        +"Sessel."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  }
  else
  {
        write(BS("Aber Du sitzt doch gar nicht in einem der Sessel."));
        return -1;
  }

  sessel -= ({ capitalize(getuid(TP)) });
  return 1;
}

//Test beim Verlassen des Raumes, ob man im Sessel sitzt
int exit_test(string dir)
{
        if(SESSEL(TP))
        {
                write(BS("Dazu solltest Du erstmal aufstehen."));
                return 0;
        }

        return 1;
}

//Spieler logt aus waehrend des Sitzens
void BecomesNetDead(object spieler)
{
  if(SESSEL(spieler))
  sessel -= ({ capitalize(getuid(spieler)) });
}

//Spieler stirbt waehrend des Sitzens
void NotifyPlayerDeath(object spieler, object killer, int lost_xp)
{
  if(SESSEL(spieler))
  sessel -= ({ capitalize(getuid(spieler)) });
}

void reset()
{
   if(zwerg == WEG)
   {
      if(sizeof(sessel) > 1 || (sizeof(sessel) > 0 && elf == DA))
      {
          TO->Message(BS("Ein Zwerg wirft einen kurzen Blick in die "
          +"Bibliothek, sieht, dass alle Sessel bereits belegt sind und "
          +"verschwindet wieder."),
          MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      }
      else
      {
          TO->Message(BS("Ein Zwerg betritt die Bibliothek, laesst sich "
          +"schwerfaellig in einen der Sessel fallen und schlaeft fast "
          +"augenblicklich ein."),
          MSGFLAG_VISUAL|MSGFLAG_NO_TP);
          zwerg = DA;
      }
   }

   if(elf == WEG)
   {
      if(sizeof(sessel) > 1 || (sizeof(sessel) > 0 && zwerg == DA))
      {
          TO->Message(BS("Ein hochgewachsener Elf kommt herein, schaut "
          +"sich kurz um und verlaesst die Bibliothek wieder."),
          MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      }
      else
      {
          TO->Message(BS("Ein hochgewachsener Elf betritt die Bibliothek, "
          +"nimmt sich ein Buch aus einem der Regale und setzt sich in "
          +"einen der beiden Sessel."),
          MSGFLAG_VISUAL|MSGFLAG_NO_TP);
          elf = DA;
      }
   }

   return ::reset();
}
