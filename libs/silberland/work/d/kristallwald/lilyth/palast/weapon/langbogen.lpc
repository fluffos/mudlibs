#include "../def.h"

inherit "std/weapon";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Langbogen");
  SetProp(P_LONG,
    "Dieser Langbogen besteht aus einem elastischen, laenglich "
    "geschnitzten Stueck Holz, dessen abgerundete Enden mit einer "
    "seidig schimmernden Bogensehne verbunden sind. In der Mitte ist "
    "das Holz mit weichem Leder umwickelt.");

  AddDetail( ({ "stueck", "holz", "holzstueck", "eschenholz" }),
    "Der Bogen besteht aus hellem Eschenholz.");

  AddDetail( ({ "enden", "ende" }),
    "Die beiden abgerundeten Enden des Holzstuecks sind ueber die "
    "Bogensehne miteinander verbunden.");

  AddDetail( ({ "bogensehne", "sehne" }),
    "Sie besteht aus Seide.");

  AddDetail( ({ "seide" }),
    "Die Bogensehne besteht aus Seide.");

  AddDetail( ({ "mitte" }),
    "In der Mitte des Holzstueckes befindet sich der mit weichem Leder "
    "umwickelte Griff.");

  AddDetail( ({ "leder" }),
    "Das Leder ist angenehm weich und rutschfest.");

  AddDetail( ({ "griff" }),
    "Er ist mit weichem Leder umwickelt, so dass einem der Bogen nicht "
    "so leicht aus der Hand rutschen kann.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Langbogen");
  SetProp(P_GENDER, MALE);
  AddId( ({"bogen", "langbogen"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_ASH_WOOD: 80, MAT_SILK: 20 ]));
  SetProp(P_WEIGHT, 950);
  SetProp(P_SIZE, 110);
  SetProp(P_VALUE, 750);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_BOW);
  SetProp(P_WC, 130);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 2);

  SetProp(P_WC_BONUS, (["Bogenkaempfer":50, "Bogenexperte":150,
  "Bogenmeister":200 ]) );

//--Create Ende------------------------------------------------------------

}
