#include "../def.h"

inherit "std/weapon";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Kompositbogen");
  SetProp(P_LONG,
    "Dieser Kompositbogen besteht im Gegensatz zu normalen Lang- oder "
    "Kurzboegen aus mehreren verschiedenen Materialien. Er ist nicht "
    "sehr viel groesser als ein Kurzbogen und um einiges stabiler als "
    "herkoemmliche Boegen.");

  AddDetail( ({ "gegensatz" }),
    "Kurz- und Langboegen werden normalerweise nur aus Holz angefertigt.");

  AddDetail( ({ "materialien", "material" }),
    "Dieser Bogen besteht aus mehreren Schichten verschiedener Holzarten, "
    "Horn und Knochen. Zudem besitzt er eine sehr stabile Bogensehne, "
    "die aus Tiersehnen angefertigt wurde.");

  AddDetail( ({ "schichten", "holzschichten", "hornschichten",
    "knochenschichten", "holz", "horn", "knochen", "schicht", "holzschicht",
    "hornschicht", "knochenschicht" }),
    "Der Bogen besteht aus mehreren duennen Holz-, Horn- und "
    "Knochenschichten.");

  AddDetail( ({ "bogensehne", "sehne", "tiersehnen", "tiersehne" }),
    "Die Sehne des Bogens besteht aus Tiersehnen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Kompositbogen");
  SetProp(P_GENDER, MALE);
  AddId( ({"bogen", "kompositbogen"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_MISC_WOOD: 65, MAT_HORN: 25, MAT_BONE: 5,
  MAT_MISC: 5 ]));
  SetProp(P_WEIGHT, 1050);
  SetProp(P_SIZE, 100);
  SetProp(P_VALUE, 950);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_BOW);
  SetProp(P_WC, 150);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 2);

  SetProp(P_WC_BONUS, (["Bogenkaempfer":50, "Bogenexperte":150,
  "Bogenmeister":200 ]) );

//--Create Ende------------------------------------------------------------

}
