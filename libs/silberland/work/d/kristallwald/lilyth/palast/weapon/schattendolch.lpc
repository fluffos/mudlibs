#include "../def.h"

inherit "std/weapon";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Schattendolch");
  SetProp(P_LONG,
    "Der Dolch, den Du in Deinen Haenden haeltst, hat eine graeulich "
    "schimmernde Klinge, die vor Deinen Augen fast zu verschwimmen scheint. "
    "Der kurze Griff wurde mit dunklem, geschmeidigem Leder umwickelt, so "
    "dass er angenehm und fest in der Hand liegt.");

  AddDetail( ({ "klinge" }),
    "Die Klinge wurde aus Schatten geformt.");

  AddDetail( ({ "schatten" }),
    "Die schimmernde Klinge besteht aus Schatten.");

  AddDetail( ({ "augen", "raender" }),
    "Du kannst die Raender der Klinge nicht genau ausmachen, denn sie "
    "verschwimmen vor Deinen Augen.");

  AddDetail( ({ "griff" }),
    "Der Griff ist mit dunklem Leder umwickelt.");

  AddDetail( ({ "leder", "halt" }),
    "Geschmeidiges dunkles Leder wurde zum besseren Halt um den Griff "
    "gewickelt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schattendolch");
  SetProp(P_GENDER, MALE);
  AddId( ({"dolch", "schattendolch"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_SHADOW: 65, MAT_MISC_UNHOLY: 35 ]));
  SetProp(P_WEIGHT, 350);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 300);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 90);
  SetProp(P_WC_FIX, 70);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_UNHOLY}) );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_WC_BONUS, (["Messerkaempfer":50, "Messerexperte":120,
  "Messermeister":180 ]) );

//--Create Ende------------------------------------------------------------

}
