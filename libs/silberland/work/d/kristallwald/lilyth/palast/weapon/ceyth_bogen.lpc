#include "../def.h"

inherit "std/weapon";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein silberner Langbogen");
  SetProp(P_LONG,
    "Du haeltst einen grossen silbernen Langbogen in Deinen Haenden. Die "
    "breite Sehne besteht aus einem weissschimmernden Material und der "
    "hoelzerne Rahmen hat einen leicht silbernen Glanz. Der Handgriff ist "
    "mit hellem Leder umwickelt. Ceyth hat diesen Bogen selbst angefertigt.");

  AddDetail( ({ "sehne", "enden", "ende" }),
    "Zwischen die beiden aeusseren Enden ist eine breite Sehne aus einem "
    "weissen, schimmernden Material gespannt.");

  AddDetail( ({ "material" }),
    "Ob das Seide ist?");

  AddDetail( ({ "seide" }),
    "Du bist Dir ziemlich sicher, dass die Bogensehne aus einem "
    "seidenaehnlichen, wenn auch sehr flexiblen Material besteht.");

  AddDetail( ({ "rahmen" }),
    "Der Rahmen besteht aus silbrig bemaltem Holz und ist sehr nachgiebig.");

  AddDetail( ({ "holz", "farbe" }),
    "Das Holz wurde mit silberner Farbe sorgfaeltig uebergemalt.");

  AddDetail( ({ "glanz" }),
    "Der Rahmen hat einem silbrigen Glanz.");

  AddDetail( ({ "handgriff", "griff" }),
    "Der Griff ist mit hellem Leder umwickelt.");

  AddDetail( ({ "leder" }),
    "Das Leder ist sehr weich und anschmiegsam.");

  AddDetail( ({ "ceyth" }),
    "Ceyth hat diesen Bogen in jahrelanger Arbeit selbst angefertigt und er "
    "haette ihn sicherlich niemals freiwillig aus der Hand gegeben.");

  AddDetail( ({ "arbeit" }),
    "Jahrelange Handarbeit steckt in diesem Bogen.");

  AddDetail( ({ "hand" }),
    "Niemals haette Ceyth diesen Bogen freiwillig fortgegeben.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Langbogen");
  SetProp(P_NAME_ADJ, "silbern");
  AddAdjective( ({ "silberner", "silbernen" } ));
  SetProp(P_GENDER, MALE);
  AddId( ({"bogen", "langbogen"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_YEW_WOOD: 75, MAT_SILK: 20, MAT_SILVER: 5 ]));
  SetProp(P_WEIGHT, 350);
  SetProp(P_SIZE, 120);
  SetProp(P_VALUE, 800);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_BOW);
  SetProp(P_WC, 140);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 2);

  SetProp(P_WC_BONUS, (["Bogenkaempfer":50, "Bogenexperte":150,
  "Bogenmeister":200 ]) );

//--Create Ende------------------------------------------------------------

}
