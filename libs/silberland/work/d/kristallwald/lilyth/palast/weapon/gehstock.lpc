#include "../def.h"

inherit "std/weapon";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Gehstock");
  SetProp(P_LONG,
    "Dieser Gehstock wurde sorgfaeltig aus dunkelbraunem, "
    "leicht schimmernden Holz handgeschnitzt. Er hat einen grossen, "
    "vergoldeten Knauf und sieht sehr wertvoll und edel aus.");

  AddDetail( ({ "holz" }),
    "Das Holz, aus dem der Gehstock besteht, ist dunkelbraun und "
    "schimmert ein wenig, wenn Du ihn im Licht hin- und herdrehst.");

  AddDetail( ({ "knauf" }),
    "Der Knauf hat die Form eines Loewenkopfes. Er wurde vergoldet.");

  AddDetail( ({ "form" }),
    "Der Knauf des Gehstocks sieht aus wie der Kopf eines goldenen "
    "Loewen.");

  AddDetail( ({ "kopf", "loewenkopf", "loewe", "loewen" }),
    "Sein Maul ist weit aufgerissen und seine goldenen Augen glitzern "
    "im Licht. Er sieht sehr naturgetreu aus.");

  AddDetail( ({ "maul" }),
    "Es ist weit geoeffnet.");

  AddDetail( ({ "augen" }),
    "Sie glitzern gefaehrlich im Licht. Du bist froh, dass es sich nur um "
    "eine Nachbildung und nicht um einen echten Loewen handelt.");

  AddDetail( ({ "nachbildung", "bildung" }),
    "Nein, der Loewe ist nicht echt. Er wurde aus Holz geschnitzt und "
    "anschliessend vergoldet.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Gehstock");
  SetProp(P_GENDER, MALE);
  SetProp(P_INFO, "Er gehoert Mahmud.");
  AddId( ({"stock", "gehstock"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_WOOD);
  SetProp(P_WEIGHT, 600);
  SetProp(P_SIZE, 22);
  SetProp(P_VALUE, 120);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 40);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_NR_HANDS, 1);

//--Create Ende------------------------------------------------------------

}
