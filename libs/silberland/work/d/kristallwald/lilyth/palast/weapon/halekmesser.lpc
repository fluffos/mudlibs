#include "../def.h"

inherit "std/weapon";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Halekmesser");
  SetProp(P_LONG,
    "Dieses Kristallmesser ist eine sehr seltene und ungewoehnliche Waffe. "
    "Seine Klinge wurde aus reinem Bergkristall geschliffen und zu einem "
    "schimmernden tiefblauen Glanz poliert. Der kurze Griff wurde aus "
    "Elfenbein gefertigt und mit feinen roetlichen Linien kunstvoll "
    "verziert.");

  AddDetail( ({ "klinge" }),
    "Die Klinge wurde aus blaeulich schimmerndem Bergkristall geschliffen.");

  AddDetail( ({ "bergkristall", "kristall", "glanz" }),
    "Der Kristall schimmert leicht blaeulich.");

  AddDetail( ({ "griff" }),
    "Der Griff besteht aus Elfenbein. Feine rote Linien sind in ihn "
    "eingelassen.");

  AddDetail( ({ "elfenbein" }),
    "Der Griff besteht aus edlem Elfenbein.");

  AddDetail( ({ "linien" }),
    "Ein sonderbares Gefuehl erfasst Dich, als Du die roetlichen Linien "
    "mit Deinen Fingern nachzeichnest. Eine unbestimmbare Macht scheint "
    "von ihnen auszugehen.");

  AddDetail( ({ "macht" }),
    "Die Linien scheinen der Klinge eine besondere Macht zu verleihen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Halekmesser");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"halekmesser", "messer", "kristallmesser"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_CRYSTAL: 85, MAT_IVORY: 15 ]));
  SetProp(P_WEIGHT, 700);
  SetProp(P_SIZE, 40);
  SetProp(P_VALUE, 1700);
  SetProp(P_NOBUY, 1);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 125);
  SetProp(P_WC_FIX, 60);
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 1);

  SetProp(P_WC_BONUS, (["Messerkaempfer":50, "Messerexperte":150,
  "Messermeister":250]) );

  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1, A_DEX:17 ]) );

//--Create Ende------------------------------------------------------------

}
