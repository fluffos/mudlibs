#include "../def.h"

inherit "std/weapon";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Kochloeffel");
  SetProp(P_LONG,
    "Ein einfacher, schlichter Kochloeffel aus hellem Holz. Als Waffe ist "
    "er wohl eher nicht zu gebrauchen.");

  AddDetail( ({ "holz" }),
    "Der Kochloeffel besteht aus hellem Holz.");

  AddDetail( ({ "waffe" }),
    "Als Waffe ist dieser Kochloeffel ziemlich unbrauchbar.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Kochloeffel");
  SetProp(P_GENDER, MALE);
  AddId( ({"loeffel", "kochloeffel"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_WOOD);
  SetProp(P_WEIGHT, 100);
  SetProp(P_SIZE, 22);
  SetProp(P_VALUE, 30);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 30);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_NR_HANDS, 1);

//--Create Ende------------------------------------------------------------

}
