#include "../def.h"

inherit "std/weapon";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Kurzbogen");
  SetProp(P_LONG,
    "Dieser Kurzbogen ist um einiges kuerzer als ein Langbogen und damit "
    "auch etwas einfacher zu handhaben. Er wurde aus hellem Eschenholz "
    "geschnitzt und seine Sehne besteht aus Seide. Der Griff ist mit "
    "Leder umwickelt.");

  AddDetail( ({ "holz", "eschenholz" }),
    "Dieser Kurzbogen besteht aus Eschenholz.");

  AddDetail( ({ "sehne", "bogensehne", "seide" }),
    "Die Bogensehne besteht aus hellschimmernder Seide.");

  AddDetail( ({ "mitte" }),
    "In der Mitte des Holzstueckes befindet sich der mit weichem Leder "
    "umwickelte Griff.");

  AddDetail( ({ "griff", "leder", "stueck" }),
    "Der Griff wurde mit einem weichen Stueck Leder umwickelt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Kurzbogen");
  SetProp(P_GENDER, MALE);
  AddId( ({"bogen", "kurzbogen"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_ASH_WOOD: 75, MAT_SILK: 25 ]));
  SetProp(P_WEIGHT, 750);
  SetProp(P_SIZE, 85);
  SetProp(P_VALUE, 650);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_BOW);
  SetProp(P_WC, 120);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 2);

  SetProp(P_WC_BONUS, (["Bogenkaempfer":50, "Bogenexperte":150,
  "Bogenmeister":200 ]) );

//--Create Ende------------------------------------------------------------

}
