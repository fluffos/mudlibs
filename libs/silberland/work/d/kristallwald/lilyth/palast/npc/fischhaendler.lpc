#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Fischhaendler");
  SetProp(P_LONG,
    "Verwundert betrachtest Du den grossen behaebigen Troll, der hinter "
    "dem Fischstand sitzt und leise grunzend eine Zeitung liest. Ab und zu "
    "schiebt er seinen Kopf ueber den Zeitungsrand und wartet darauf, "
    "dass ihm einer der Besucher, die ueber den Hof spazieren, ein paar "
    "Fische abkauft.");

  AddDetail( ({ "fischstand" }),
    "Er sitzt seelenruhig hinter seinem Fischstand und liest Zeitung.");

  AddDetail( ({ "zeitung" }),
    "Du wusstest gar nicht, dass Trolle lesen koennen.");

  AddDetail( ({ "trolle" }),
    "Vielleicht ist dieser hier ja nur eine Ausnahme.");

  AddDetail( ({ "kopf" }),
    "Der Kopf ist hinter der grossen Zeitung versteckt.");

  AddDetail( ({ "zeitungsrand", "rand" }),
    "Ab und zu erscheint der Kopf hinter dem Rand der Zeitung und schaut "
    "kurz in die Runde. Dann verschwindet er wieder spurlos dahinter.");

  AddDetail( ({ "runde" }),
    "Du schaust in die Runde. Hmm, sehr viel ist hier am Fischstand gerade "
    "nicht los.");

  AddDetail( ({ "besucher" }),
    "Du bist nicht der einzige hier.");

  AddDetail( ({ "hof" }),
    "Schau Dich doch mal genau um.");

  AddDetail( ({ "fische" }),
    "Der Troll verkauft seine Fische hier auf dem Hof.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Fischhaendler");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"fischhaendler", "haendler", "troll", "\nfischhaendler"}));
  AddClass( ({CL_TROLL}) );
  SetProp(P_ARTICLE, 1);

//set_living_name("");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(20);

  SetProp(P_HANDS, ({ " mit seinen Haenden", 200, DT_BLUDGEON }) );

  SetProp(P_RACE, "Troll");
  SetProp(P_SIZE, 210);
  SetProp(P_WEIGHT, 185000);
  SetProp(P_ALIGN, 40);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" grunzt: Behalt das mal lieber selbst.\n" }) );

  SetProp(P_LOG_INFO, "/lilyth/palast/fischhaendler");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE: 0.5,
       DT_AIR: -0.2,
       DT_LIGHTNING: 0.3,
       DT_LIGHT: 0.3,
       DT_TERROR: -0.3,
       DT_MAGIC: 0.2,
       DT_MIND: 0.2,
       DT_SLASH: -0.05,
       DT_BLUDGEON: -0.05,
       DT_PIERCE: -0.05,
       DT_SQUEEZE: -0.05,
       DT_WHIP: -0.05,
       DT_RIP: -0.05 ]));

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "stapft schnaufend herein");
  SetProp(P_MSGOUT, "stapft schnaufend");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Fischhaendler");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "ist in seine Zeitung vertieft.\n",
            "grunzt vor sich hin.\n",
            "mustert Dich kurz.\n"}));

  AddInfo( ({"zeitung"}),
  "Auch ein Troll muss wissen, was im Silberland so vor sich geht, oder?",
  "grunzt: ");

  AddInfo( ({"troll"}),
  "Nur weil ich ein Troll bin, heisst das nicht, dass ich nicht lesen kann.",
  "grunzt: ");

  AddInfo( ({"silberland"}),
  "Dass Du im Silberland bist, weisst Du doch wohl, oder?",
  "blickt kurz hinter seiner Zeitung hervor: ");

  AddInfo( ({"fisch", "fische", "fischstand", "stand"}),
  "schweigend auf die ausliegenden Fische.",
  "deutet ");

  AddInfo( ({"katze"}),
  "Die ist mir irgendwann zugelaufen.",
  "zuckt mit den Schultern: ");

  AddInfo( ({"yoshy"}),
  "Solange er meiner Katze nichts tut, tu ich ihm auch nichts.",
  "grunzt: ");

  AddInfo( ({"palast"}),
  "Wenn Du nicht gerade blind bist, solltest Du ihn von hier aus sehen "
  "koennen.",
  "grunzt: ");

  AddInfo( ({"hering", "kabeljau", "schwertfisch"}),
  "Du kannst gerne einen kaufen, wenn Du willst.",
  "sagt: ");

  AddInfo( ({"heringe", "makrelen", "seezungen", "schollen"}),
  "Du kannst gerne welche kaufen, wenn Du willst.",
  "sagt: ");

  AddInfo( ({"makrele", "seezunge"}),
  "Du kannst gerne eine kaufen, wenn Du willst.",
  "sagt: ");

  AddInfo( ({"schwertfische"}),
  "Leider habe ich nur einen einzigen.",
  "sagt bedauernd: ");

  AddInfo( ({"wasser"}),
  "Das kalte Wasser haelt die Fische schoen frisch.",
  "grunzt: ");

  AddInfo( ({"trollwaechter", "waechter"}),
  "Sie bewachen das Portal.",
  "grunzt: ");

  AddInfo( ({"portal", "palastportal"}),
  "Das liegt westlich von hier.",
  "sagt kurzbuendig: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

  AddDefaultSpell(3, 1, DS_POISON,
    Name(WER, 1)+" stopft Dir einen verfaulten Fisch in den Mund!\n",
    Name(WER, 1)+" stopft @WEM einen verfaulten Fisch in den Mund!\n");

  AddSpell(4,350,
    Name(WER, 1)+" pruegelt mit seinen kraeftigen Faeusten auf Dich ein!\n",
    Name(WER, 1)+" pruegelt mit seinen kraeftigen Faeusten auf @WEN ein!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" blickt kurz hinter seiner Zeitung hervor.\n",
    Name(WER, 1)+" vertieft sich wieder in seine Zeitung.\n",
    Name(WER, 1)+" fragt Dich: Magst Du keinen Fisch?\n",
    Name(WER, 1)+" grunzt vor sich hin.\n",
    Name(WER, 1)+" wartet auf neue Kunden.\n",
    Name(WER, 1)+" wirft der Katze einen kleinen Hering zu.\n",
    BS(Name(WER, 1)+" bespritzt die auf dem Holzbrett ausliegenden Fische "
    +"mit kaltem Wasser, um sie frisch zu halten.") }) );

  SetAttackChats(10,
  ({Name(WER, 1)+" wirft Dir einen grossen Fisch an den Kopf!\n",
    Name(WER, 1)+" haut Dich mit seiner Zeitung!\n",
    Name(WER, 1)+" grunzt veraergert.\n" }));

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt den Fischhaendler.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
    case "traurig":
      call_out("reaction", 0, TP,
        "zwinkert Dir kurz zu und vertieft sich dann wieder in seine "
        +"Zeitung.",
        "zwinkert "+TP->name(WEM)+" kurz zu und vertieft sich dann wieder "
        +"in seine Zeitung.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "grunzt veraergert.",
        "grunzt veraergert.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "grunzt vergnuegt.",
        "grunzt vergnuegt.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "haut Dir erbost seine Zeitung um die Ohren!",
        "haut "+TP->name(WEM)+" erbost seine Zeitung um die Ohren!");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "schaut gar nicht von seiner Zeitung auf.",
        "schaut gar nicht von seiner Zeitung auf.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "schaut kurz hinter seiner Zeitung hervor und zwinkert Dir zu.",
        "schaut kurz hinter seiner Zeitung hervor und zwinkert "
        +""+TP->name(WEM)+" zu.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "grunzt Dich belustigt an.",
        "grunzt "+TP->name(WEN)+" belustigt an.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "deutet auf die ausliegenden Fische.",
        "deutet auf die ausliegenden Fische.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "ist in seine Zeitung vertieft.",
        "ist in seine Zeitung vertieft.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}
