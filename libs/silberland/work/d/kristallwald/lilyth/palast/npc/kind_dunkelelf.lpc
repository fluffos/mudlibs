#include "../def.h"

inherit "std/mnpc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleiner Dunkelelfenjunge");
  SetProp(P_LONG,
    "Der kleine Dunkelelfenjunge hat ein schmales, dunkles Gesicht. Seine "
    "ungewoehnlich langen Haare sind schneeweiss und seine Augen ein wenig "
    "geroetet. Anscheinend vertraegt er das helle Licht nicht sonderlich "
    "gut.");

  AddDetail( ({ "gesicht" }),
    "Sein schmales Gesicht ist sehr dunkel, man koennte fast sagen, "
    "schwarz.");

  AddDetail( ({ "haare", "haar" }),
    "Er hat glatte, schneeweisse Haare, die fuer einen Jungen "
    "ungewoehnlich lang sind.");

  AddDetail( ({ "augen", "auge" }),
    "Seine Augen sind ein wenig geroetet.");

  AddDetail( ({ "licht" }),
    "Hier drinnen ist es zwar nicht ganz so hell wie draussen, aber fuer "
    "einen Dunkelelfen ist es dennoch fast zu hell.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Dunkelelfenjunge");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"dunkelelf", "dunkelelfenjunge", "junge", "kind"}));
  AddClass( ({CL_DARKELF}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(8);

  SetProp(P_HANDS, ({ " mit seinen Haenden", 80, DT_BLUDGEON }) );

  SetProp(P_RACE, "Dunkelelf");
  SetProp(P_SIZE, 120);
  SetProp(P_WEIGHT, 43);
  SetProp(P_ALIGN, -210);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" sagt: Das will ich nicht haben!\n" }) );

  SetProp(P_LOG_INFO, "/lilyth/palast/kinder");

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht nach Hause");

  SetProp(P_MNPC_AREA, ({ ROOM "og_treppe", ROOM "og_konditorei",
                          ROOM "og_spielzimmer", ROOM "og_bibliothek" }) );

  SetProp(P_MNPC_DEFAULTROOM, ROOM "og_treppe");
  SetProp(P_MNPC_WAIT, ({ 25, 40, 50 }));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " wird nie wieder spielen.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MURDER_MSG, "Na warte, das kriegst Du wieder! *schmoll*");
  SetProp(P_KILL_NAME, "Ein kleiner Dunkelelfenjunge");
  SetProp(P_KILL_MSG, "Aetsch!!!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "sagt: Das weiss ich nicht.\n",
            "denkt nach.\n",
            "blickt Dich stumm an.\n"}));

  AddInfo( ({"dunkelelf", "dunkelelfen"}),
    "Ich bin ein Dunkelelf.",
    "sagt stolz: ");

  AddInfo( ({"palast"}),
    "Du siehst doch, dass das hier ein Palast ist!",
    "mustert Dich: ");

  AddInfo( ({"mahmud"}),
    "Mahmud ist sehr nett. Er erzaehlt uns immer Geschichten.",
    "sagt: ");

  AddInfo( ({"geschichte", "geschichten"}),
    "Mahmud erzaehlt uns immer tolle Geschichten!",
    "sagt: ");

  AddInfo( ({"augen", "licht"}),
    "Das Licht ist doof! Das brennt mir immer in den Augen!",
    "grummelt: ");

  AddInfo( ({"unterwelt"}),
    "In der Unterwelt ist es richtig schoen. Und vor allem dunkel, nicht so "
    "eklig hell wie hier oben.",
    "sagt: ");
    
//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

  AddDefaultSpell(1,250,DS_SLOW,
    Name(WER, 1)+" stellt Dir ein Bein und Du stuerzt hart zu Boden.\n",
    Name(WER, 1)+" stellt @WEM hinterhaeltig ein Bein!\n",3);

//--Chats------------------------------------------------------------------

  SetChats(2,
  ({Name(WER, 1)+" reibt sich die Augen.\n",
    Name(WER, 1)+" mustert die anderen Kinder.\n",
    Name(WER, 1)+" fragt Dich: Warst Du schon mal in der Unterwelt?\n",
    Name(WER, 1)+" starrt Dich an.\n",
    Name(WER, 1)+" mustert Dich stumm.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" versucht, einen dunklen Zauber zu sprechen.\n",
    Name(WER, 1)+" murmelt ein paar boese Worte.\n",
    Name(WER, 1)+" starrt Dich wuetend an.\n" }));

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt einen kleinen Dunkelelfenjungen.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "grinst haemisch.",
        "grinst haemisch.");
      break;

    case "aergerlich":
    case "fies":
      call_out("reaction", 0, TP,
        "sagt: Hey, lass das!",
        "sagt: Hey, lass das!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "grinst Dich an.",
        "grinst "+TP->name(WEN)+" an.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "blickt Dich finster an.",
        "blickt "+TP->name(WEN)+" finster an.");
      break;

    case "froh":
    case "nett":
      call_out("reaction", 0, TP,
        "mustert Dich argwoehnisch.",
        "mustert "+TP->name(WEN)+" argwoehnisch.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "starrt Dich an.",
        "starrt "+TP->name(WEN)+" an.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "gruebelt vor sich hin.",
        "gruebelt vor sich hin.");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich scheinheilig.",
        "troestet "+TP->name(WEN)+" scheinheilig.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}

void give_notify(object was)
{
    if(was->id("\nsuesses"))
    {
        write(break_string("Der kleine Dunkelelfenjunge sagt: "
        +"Danke, "+this_player()->Name()+"!\nDer kleine "
        +"Dunkelelfenjunge laesst sich "+was->name(WEN)+" schmecken.\n",
        78, 0, BS_LEAVE_MY_LFS));
        
        ENV(TO)->Message(break_string("Der kleine Dunkelelfenjunge sagt: "
        +"Danke, "+this_player()->Name()+"!\nDer kleine "
        +"Dunkelelfenjunge laesst sich "+was->name(WEN)+" schmecken.\n",
        78, 0, BS_LEAVE_MY_LFS),
        MSGFLAG_SOUND|MSGFLAG_NO_TP);
        was->remove();
        return;
    }
    
    return ::give_notify(was);
}
