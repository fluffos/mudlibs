#include "../def.h"

inherit "std/mnpc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleiner Trolljunge");
  SetProp(P_LONG,
    "Der kleine Trolljunge hat kurze, schwarze Haare, rote Pausbacken und "
    "froehliche blaue Augen, mit denen er Dich neugierig von oben bis "
    "unten betrachtet. Er ist recht gross im Gegensatz zu den anderen "
    "Kindern.");

  AddDetail( ({ "haare", "haar" }),
    "Sie sind kurz und schwarz und ein wenig gelockt.");

  AddDetail( ({ "pausbacken", "pausbacke", "backen", "backe", "wangen", 
  "wange" }),
    "Der kleine Trolljunge hat ganz rote Wangen.");

  AddDetail( ({ "augen", "auge", "paar" }),
    "Ein Paar froehlicher blauer Augen blickt Dich neugierig an.");

  AddDetail( ({ "gegensatz" }),
    "Im Gegensatz zu den anderen Kindern ist er ziemlich gross. Aber er "
    "ist ja schliesslich auch ein Troll.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Trolljunge");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"troll", "trolljunge", "junge", "kind"}));
  AddClass( ({CL_TROLL}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(8);

  SetProp(P_HANDS, ({ " mit seinen Haenden", 80, DT_BLUDGEON }) );

  SetProp(P_RACE, "Troll");
  SetProp(P_SIZE, 165);
  SetProp(P_WEIGHT, 65);
  SetProp(P_ALIGN, -40);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" sagt: Das will ich nicht haben!\n" }) );

  SetProp(P_LOG_INFO, "/lilyth/palast/kinder");

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht nach Hause");

  SetProp(P_MNPC_AREA, ({ ROOM "og_treppe", ROOM "og_konditorei",
                          ROOM "og_spielzimmer", ROOM "og_bibliothek" }) );

  SetProp(P_MNPC_DEFAULTROOM, ROOM "og_treppe");
  SetProp(P_MNPC_WAIT, ({ 60, 40, 50 }));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " wird nie wieder spielen.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MURDER_MSG, "Das sage ich meinem Papa! *schluchz*");
  SetProp(P_KILL_NAME, "Ein kleiner Trolljunge");
  SetProp(P_KILL_MSG, "Aetsch!!!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "hat keine Lust, darueber nachzudenken.\n",
            "gruebelt vor sich hin.\n",
            "fragt: Woher soll ich das wissen?\n"}));

  AddInfo( ({"troll"}),
    "Ich bin bald ein grosser starker Troll!",
    "prahlt: ");

  AddInfo( ({"palast"}),
    "Du bist hier in einem grossen Palast!",
    "sagt: ");

  AddInfo( ({"mahmud"}),
    "Mahmud ist sehr nett. Er erzaehlt uns immer Geschichten.",
    "strahlt: ");

  AddInfo( ({"geschichte", "geschichten"}),
    "Mahmud erzaehlt uns immer ganz tolle Geschichten!",
    "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

  AddSpell(1,250,
    Name(WER, 1)+" zieht Dich schmerzhaft an den Haaren!\n",
    Name(WER, 1)+" zieht @WEN schmerzhaft an den Haaren!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(2,
  ({Name(WER, 1)+" laeuft froehlich um Dich herum.\n",
    Name(WER, 1)+" schaut Dich von oben bis unten an.\n",
    Name(WER, 1)+" kichert leise.\n",
    Name(WER, 1)+" will eine Geschichte hoeren.\n",
    Name(WER, 1)+" kratzt sich am Kopf.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" jammert laut.\n",
    Name(WER, 1)+" tritt nach Dir.\n",
    Name(WER, 1)+" schlaegt mit seinen kleinen Faeusten auf Dich ein.\n" }));

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt einen kleinen Trolljungen.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "blickt Dich verwundert an.",
        "blickt "+TP->name(WEN)+" verwundert an.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "schmollt: Du bist gemein, "+TP->name(WER)+"!",
        "schmollt: Du bist gemein, "+TP->name(WER)+"!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "grinst Dich an.",
        "grinst "+TP->name(WER)+" an.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "verzieht schmollend den Mund.",
        "verzieht schmollend den Mund.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "schaut Dich frech an.",
        "schaut "+TP->name(WEM)+" frech an.");
      break;

    case "froh":
    case "nett":
      call_out("reaction", 0, TP,
        "grinst Dich an.",
        "grinst "+TP->name(WEM)+" an.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Lass das!",
        "sagt: Lass das!");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "gruebelt vor sich hin.",
        "gruebelt vor sich hin.");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "versucht, Dich zu troesten.",
        "versucht, "+TP->name(WEN)+" zu troesten.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}

//Suessigkeiten geben:
void give_notify(object was)
{
    if(was->id("\nsuesses"))
    {
        write(break_string("Der kleine Trolljunge freut sich: "
        +"Danke, "+this_player()->Name()+"!\nDer kleine "
        +"Trolljunge laesst sich "+was->name(WEN)+" schmecken.\n",
        78, 0, BS_LEAVE_MY_LFS));
        
        ENV(TO)->Message(break_string("Der kleine Trolljunge freut sich: "
        +"Danke, "+this_player()->Name()+"!\nDer kleine "
        +"Trolljunge laesst sich "+was->name(WEN)+" schmecken.\n",
        78, 0, BS_LEAVE_MY_LFS),
        MSGFLAG_SOUND|MSGFLAG_NO_TP);
        was->remove();
        return;
    }
    
    return ::give_notify(was);
}
