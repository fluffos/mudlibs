#include "../def.h"

inherit "std/mnpc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleines Ogermaedchen");
  SetProp(P_LONG,
    "Das kleine Ogermaedchen ist fuer einen Oger eigentlich ganz huebsch. "
    "Sie ist ziemlich kraeftig, hat aber ein freundliches Gesicht und "
    "leuchtend gruene Augen.");

  AddDetail( ({ "gesicht" }),
    "Sie hat ein freundliches, offenes Gesicht.");

  AddDetail( ({ "augen", "auge" }),
    "Ihre Augen haben eine schoene gruene Farbe.");

  AddDetail( ({ "farbe" }),
    "Sie sind leuchtend gruen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Ogermaedchen");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"oger", "ogermaedchen", "maedchen", "kind"}));
  AddClass( ({CL_OGRE}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(7);

  SetProp(P_HANDS, ({ " mit seinen Haenden", 70, DT_BLUDGEON }) );

  SetProp(P_RACE, "Oger");
  SetProp(P_SIZE, 122);
  SetProp(P_WEIGHT, 56000);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" sagt: Ich nehme nichts von Fremden an!\n" }) );

  SetProp(P_LOG_INFO, "/lilyth/palast/kinder");

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht nach Hause");

  SetProp(P_MNPC_AREA, ({ ROOM "og_treppe", ROOM "og_konditorei",
                          ROOM "og_spielzimmer", ROOM "og_bibliothek" }) );

  SetProp(P_MNPC_DEFAULTROOM, ROOM "og_treppe");
  SetProp(P_MNPC_WAIT, ({ 60, 10, 40 }));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " wird nie wieder spielen.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MURDER_MSG, "Das sage ich meiner Mama! *schluchz*");
  SetProp(P_KILL_NAME, "Ein kleines Ogermaedchen");
  SetProp(P_KILL_MSG, "Aetsch!!!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "sagt: Das weiss ich nicht.\n",
            "denkt angestrengt nach.\n",
            "gruebelt vor sich hin.\n"}));

  AddInfo( ({"oger"}),
    "fragend auf sich.",
    "deutet ");

  AddInfo( ({"palast"}),
    "Du bist hier in einem grossen Palast!",
    "sagt: ");

  AddInfo( ({"mahmud"}),
    "Mahmud ist lieb!",
    "strahlt: ");

  AddInfo( ({"geschichte", "geschichten"}),
    "Mahmud erzaehlt uns immer ganz tolle Geschichten!",
    "sagt: ");

  AddInfo( ({"mutter"}),
    "Hast Du sie gesehen?",
    "fragt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

  AddSpell(1,250,
    Name(WER, 1)+" pruegelt verzweifelt auf Dich ein.\n",
    Name(WER, 1)+" pruegelt verzweifelt auf @WEN ein.\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(2,
  ({Name(WER, 1)+" schaut Dich freundlich an.\n",
    Name(WER, 1)+" spielt mit den anderen Kindern.\n",
    Name(WER, 1)+" mustert Dich neugierig.\n",
    Name(WER, 1)+" sucht nach seiner Mutter.\n",
    Name(WER, 1)+" bleibt kurz stehen und laeuft dann weiter.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" jammert laut.\n",
    Name(WER, 1)+" weint ein wenig.\n",
    Name(WER, 1)+" versucht, nach Dir zu schlagen.\n" }));

//--Ausruestung------------------------------------------------------------


//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt ein kleines Ogermaedchen.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "blickt Dich verwundert an.",
        "blickt "+TP->name(WEN)+" verwundert an.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "schmollt: Du bist gemein, "+TP->name(WER)+"!",
        "schmollt: Du bist gemein, "+TP->name(WER)+"!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "grinst Dich an.",
        "grinst "+TP->name(WER)+" an.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "verzieht schmollend den Mund.",
        "verzieht schmollend den Mund.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "schaut Dich frech an.",
        "schaut "+TP->name(WEM)+" frech an.");
      break;

    case "froh":
    case "nett":
      call_out("reaction", 0, TP,
        "grinst Dich an.",
        "grinst "+TP->name(WEM)+" an.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Lass das!",
        "sagt: Lass das!");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "gruebelt vor sich hin.",
        "gruebelt vor sich hin.");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "versucht, Dich zu troesten.",
        "versucht, "+TP->name(WEN)+" zu troesten.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}
