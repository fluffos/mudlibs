#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Gemaelde");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({ "junge", "knabe", "gemaelde", "NOT_LIVING" }));
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(1);

  SetProp(P_HANDS, ({" mit bildlicher Kraft"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })  );

  SetProp(P_RACE, "Gemaelde");
  SetProp(P_SIZE, 400);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NOATTACK, "kann nicht angegriffen werden!");
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_LOG_INFO, "/lilyth/palast/gemaelde");

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "erscheint an der Wand");
  SetProp(P_MSGOUT, "verschwindet ploetzlich spurlos");
  SetProp(P_MMSGIN, "erscheint an der Wand");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich spurlos");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Ein Gemaelde");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "seufzt nur leise.\n",
            "gibt ein qualvolles Stoehnen von sich.\n",
            "schweigt vor sich hin.\n"}));

  AddInfo( ({"krieg", "kriege", "land"}),
    "Damals herrschten schreckliche Kriege im ganzen Land. Besonders "
    "Menschen und Orks lieferten sich blutige Schlachten.",
    "seufzt: ");

  AddInfo( ({"kaempfe", "kampf", "schlachten", "schlacht"}),
    "Die Kaempfe waren schrecklich. Sie forderten sehr viele Opfer.",
    "seufzt: ");

  AddInfo( ({"opfer"}),
    "Viele Menschen und auch Angehoerige anderer Rassen sind damals "
    "umgekommen.",
    "seufzt: ");

  AddInfo( ({"angehoerige", "rassen", "voelker"}),
    "Es kaempften nicht nur Menschen in diesem Krieg. Auch viele Elfen, "
    "Zwerge und sogar Halblinge standen ihnen in diesen schweren Zeiten "
    "zur Seite und unterstuetzten sie, wo es nur ging.",
    "seufzt: ");

  AddInfo( ({"elfen", "zwerge", "halblinge", "hobbits"}),
    "Sie kaempften Seite an Seite mit den Menschen. Doch auch sie hatten "
    "viele Opfer zu beklagen.",
    "seufzt: ");

  AddInfo( ({"seite"}),
    "Sie alle kaempften gemeinsam gegen die Orks.",
    "seufzt: ");

  AddInfo( ({"zeiten", "zeit"}),
    "Es ist schon sehr lange Zeit her.",
    "seufzt: ");

  AddInfo( ({"menschen"}),
    "Die Menschen aus Tethyr waren den Orks zahlenmaessig und auch vom "
    "Kampfgeschick her weit unterlegen. Es bestand kaum Hoffnung fuer sie.",
    "seufzt: ");

  AddInfo( ({"kampfgeschick", "geschick", "staerke"}),
    "Die Orks waren ausgebildete Kaempfer und ihr Hass auf die Menschen "
    "gab ihnen zusaetzliche Kraft.",
    "seufzt: ");

  AddInfo( ({"hass"}),
    "Ein unglaublicher Hass trieb die Orks voran.",
    "seufzt: ");

  AddInfo( ({"orks", "orkscharen", "scharen", "angriff", "angriffe", 
  "angreifer"}),
    "Riesige Scharen von Orks ueberfielen die Menschen in ihren "
    "Heimatdoerfern, aus Neid und Rachsucht.",
    "seufzt: ");

  AddInfo( ({"neid", "rachsucht"}),
    "Sie neideten den Menschen ihre grossen Staedte und ihren "
    "Einfluss auf die anderen Voelker.",
    "seufzt: ");

  AddInfo( ({"einfluss"}),
    "Die Menschen waren damals sehr zahlreich und hatten einen nicht zu "
    "unterschaetzenden Einfluss auf die anderen Voelker.",
    "seufzt: ");

  AddInfo( ({"heimatdoerfer", "heimatdoerfern", "menschenstadt", 
  "menschenstaedte", "menschenstaedten", "staedte", "siedlungen"}),
    "In allen Menschenstaedten wueteten die Orks auf grauenvolle Weise. "
    "Auch das ruhige Tal von Tethyr und die praechtige Stadt Avir blieben "
    "nicht von ihnen verschont.",
    "seufzt: ");

  AddInfo( ({"tal", "tethyr"}),
    "Die Menschen, die im Tal von Tethyr lebten, wurden von den "
    "Angriffen der Orks ueberrascht, denn sie lebten damals noch fast "
    "voellig abgeschieden von den anderen menschlichen Siedlungen und "
    "wussten nichts von dem drohenden Krieg. Sie waren auf die Staerke "
    "der Angreifer und die Gefahr, in die sie geraten wuerden, nicht "
    "vorbereitet.",
    "seufzt: ");

  AddInfo( ({"gefahr"}),
    "Die drohende Gefaehr wurde ihnen erst bewusst, als es schon fast "
    "zu spaet war.",
    "seufzt: ");

  AddInfo( ({"avir"}),
    "Avir war eine grosse, praechtige Stadt, doch auch sie wurde nicht "
    "verschont.",
    "seufzt: ");

  AddInfo( ({"verwundete", "verwundeten"}),
    "Es gab zahlreiche Verwundete, die unter den Angriffen leiden "
    "mussten. Viele von ihnen haben den Krieg nicht ueberlebt.",
    "seufzt: ");

  AddInfo( ({"kameraden"}),
    "Viele meiner Kameraden sind gefallen.",
    "seufzt: ");

  AddInfo( ({"grauen"}),
    "Es war wirklich grauenvoll.",
    "seufzt: ");

  AddInfo( ({"scharen", "orkscharen"}),
    "Es waren ihrer einfach zu viele.",
    "seufzt: ");

  AddInfo( ({"hilflosigkeit", "verzweiflung"}),
    "Die Menschen waren damals voellig verzweifelt. Sie kaempften ohne "
    "jegliche Hoffnung, doch sie gaben nicht auf.",
    "seufzt: ");

  AddInfo( ({"hoffnung"}),
    "Es bestand kaum Hoffnung, die Angreifer zurueckzudraengen.",
    "seufzt: ");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------



//--Funktionen-------------------------------------------------------------

//Wegwerf-Meldung unterdruecken:
void give_notify(object was)
{
        write(BS("Du kannst dem Gemaelde nichts geben und legst "
        +""+was->name()+" stattdessen auf dem Boden ab.\n"));
        
        ENV(TO)->Message(BS(TP->Name(WER, 1)+" legt "+was->name()+" auf "
        +"dem Boden ab."),  	       
  	MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  	
        was->move(ENV(TO), M_SILENT|M_PUT);
        return;
}
