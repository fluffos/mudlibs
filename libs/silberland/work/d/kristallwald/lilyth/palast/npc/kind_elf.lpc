#include "../def.h"

inherit "std/mnpc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine junge Elfenmutter");
  SetProp(P_LONG,
    "Die junge Elfenmutter hat lange, goldblonde Haare und ist "
    "aussergewoehnlich huebsch. Sie hat sich ein grosses, hellblaues "
    "Tuch um die Schultern geschlungen und traegt ein kleines Baby darin "
    "mit sich herum.");

  AddDetail( ({ "haare", "haar" }),
    "Sie sind goldblond und fallen offen ueber ihre Schultern.");

  AddDetail( ({ "schultern" }),
    "Die Haare fallen offen ueber ihre Schultern.");

  AddDetail( ({ "farbe" }),
    "Die Haare sind goldblond.");

  AddDetail( ({ "baby" }),
    "Du kannst nur das kleine Koepfchen des Babys sehen, der Rest "
    "verschwindet unter dem hellblauen, weichen Tuch, in dem es "
    "eingewickelt ist.");

  AddDetail( ({ "koepfchen", "kopf" }),
    "Das Baby scheint wirklich noch sehr klein zu sein. Als Du neugierig "
    "in das Tuch hineinschaust, verzieht es das kleine Gesichtchen und "
    "faengt bitterlich an zu weinen. Doch schnell wird es von seiner Mutter "
    "wieder getroestet.");

  AddDetail( ({ "gesichtchen" }),
    "Das kleine Baby hat grosse, blaue Augen und eine winzige kleine "
    "Stupsnase.");

  AddDetail( ({ "augen" }),
    "Die Augen des Babys sind blau.");

  AddDetail( ({ "stupsnase", "nase", "nasenspitze", "spitze" }),
    "Du stipst dem kleinen Baby vorsichtig auf die Nasenspitze, und seine "
    "kleine Stupsnase kraeuselt sich ein wenig.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Elfenmutter");
  SetProp(P_NAME_ADJ, "jung");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"elfe", "mutter", "elfenmutter"}));
  AddClass( ({CL_ELF}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(10);

  SetProp(P_HANDS, ({ " mit ihren Haenden", 100, DT_BLUDGEON }) );

  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 179);
  SetProp(P_WEIGHT, 70);
  SetProp(P_ALIGN, 400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" fragt erstaunt: Was soll ich denn damit?\n" }) );

  SetProp(P_LOG_INFO, "/lilyth/palast/kinder");

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt die Treppe hinauf");
  SetProp(P_MMSGOUT, "geht nach Hause");

  SetProp(P_MNPC_AREA, ({ ROOM "og_treppe", ROOM "og_konditorei",
                          ROOM "og_spielzimmer", ROOM "og_bibliothek" }) );

  SetProp(P_MNPC_DEFAULTROOM, ROOM "og_treppe");
  SetProp(P_MNPC_WAIT, ({ 30, 50,40 }));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MURDER_MSG, "Wer sorgt jetzt fuer mein Baby?");
  SetProp(P_KILL_NAME, "Eine junge Elfenmutter");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "seufzt: Das weiss ich leider nicht.\n",
            "blickt Dich fragend an.\n",
            "hat nur Augen fuer ihr Baby.\n"}));

  AddInfo( ({"baby"}),
    "Ist es nicht suess?",
    "sagt voll Mutterstolz: ");

  AddInfo( ({"elf", "elfe"}),
    "Ich bin eine Elfe.",
    "sagt laechelnd: ");

  AddInfo( ({"mahmud"}),
    "Mahmud ist ein netter, aelterer Herr. Er erzaehlt den Kindern immer "
    "viele Geschichten.",
    "sagt: ");

  AddInfo( ({"kinder", "kind"}),
    "Die Kinder sind hier gut aufgehoben.",
    "beteuert: ");

  AddInfo( ({"palast"}),
    "Dort befindest Du Dich gerade.",
    "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

  AddSpell(1,320,
    Name(WER, 1)+" tritt Dich schmerzhaft.\n",
    Name(WER, 1)+" tritt @WEN schmerzhaft.\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,420,
    Name(WER, 1)+" trifft Dich mit einem Elfenzauber.\n",
    Name(WER, 1)+" trifft @WEN mit einem Elfenzauber.\n",
    DT_MAGIC,([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(2,
  ({Name(WER, 1)+" schaukelt ihr Baby sachte.\n",
    Name(WER, 1)+" summt ein leises Wiegenlied.\n",
    Name(WER, 1)+" zeigt Dir freudestrahlend ihr Baby.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" murmelt einen elfischen Zauberspruch.\n",
    Name(WER, 1)+" ruft: Lass mein Baby in Ruhe!\n",
    Name(WER, 1)+" weint: Mein armes Baby!\n" }));

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME(ARMOUR "tuch");
  command("trage alles");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt eine junge Elfenmutter.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "blickt Dich etwas verwirrt an.",
        "blickt "+TP->name(WEN)+" etwas verwirrt an.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "sagt: Lass das, "+TP->name(WER)+"!",
        "sagt: Lass das, "+TP->name(WER)+"!");
      break;

    case "albern":
    case "frech":
      call_out("reaction", 0, TP,
        "sagt freundlich: Bitte weck mein Baby nicht auf.",
        "sagt freundlich: Bitte weck mein Baby nicht auf.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "sagt: Hoer auf damit, sonst muss ich die Wachen holen!",
        "sagt: Hoer auf damit, sonst muss ich die Wachen holen!");
      break;

    case "froh":
    case "nett":
      call_out("reaction", 0, TP,
        "laechelt Dir zu.",
        "laechelt "+TP->name(WEN)+" zu.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "erroetet und blickt verlegen zu Boden.",
        "erroetet und blickt verlegen zu Boden.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "zeigt Dir freudestrahlend ihr Baby.",
        "zeigt "+TP->name(WEM)+" freudestrahlend ihr Baby.");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "sagt: Ach, sei nicht traurig, "+TP->name(WER)+".",
        "sagt: Ach, sei nicht traurig, "+TP->name(WER)+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}
