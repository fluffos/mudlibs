#include "../def.h"

inherit "std/mnpc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleines Hobbitmaedchen");
  SetProp(P_LONG,
    "Das kleine Hobbitmaedchen hat halblange, kastanienbraune Haare, eine "
    "kleine Stupsnase und grosse braune Augen, die Dich ein wenig "
    "schuechtern anblicken.");

  AddDetail( ({ "haare", "haar" }),
    "Sie sind kastanienbraun.");

  AddDetail( ({ "stupsnase", "nase" }),
    "Es hat eine kleine, rundliche Stupsnase.");

  AddDetail( ({ "augen", "auge" }),
    "Die braunen Augen blicken Dich etwas schuechtern an.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Hobbitmaedchen");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"hobbit", "hobbitmaedchen", "maedchen", "kind"}));
  AddClass( ({CL_HOBBIT}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(7);

  SetProp(P_HANDS, ({ " mit seinen Haenden", 70, DT_BLUDGEON }) );

  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 45);
  SetProp(P_WEIGHT, 27000);
  SetProp(P_ALIGN, 150);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" sagt: Ich darf nichts von Fremden annehmen!\n" }) );

  SetProp(P_LOG_INFO, "/lilyth/palast/kinder");

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt schuechtern herein");
  SetProp(P_MSGOUT, "geht schuechtern");
  SetProp(P_MMSGIN, "kommt schuechtern herein");
  SetProp(P_MMSGOUT, "geht schuechtern nach Hause");

  SetProp(P_MNPC_AREA, ({ ROOM "og_treppe", ROOM "og_konditorei",
                          ROOM "og_spielzimmer", ROOM "og_bibliothek" }) );

  SetProp(P_MNPC_DEFAULTROOM, ROOM "og_treppe");
  SetProp(P_MNPC_WAIT, ({ 60, 10, 40 }));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " wird nie wieder spielen.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MURDER_MSG, "Das sage ich meiner Mama! *schluchz*");
  SetProp(P_KILL_NAME, "Ein kleines Hobbitmaedchen");
  SetProp(P_KILL_MSG, "Aetsch!!!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "starrt schuechtern zu Boden.\n",
            "sagt leise: Das weiss ich nicht.\n",
            "fuerchtet sich zu sehr vor Dir.\n"}));

  AddInfo( ({"hobbit"}),
    "Ich bin ein Hobbit.",
    "sagt schuechtern: ");

  AddInfo( ({"palast"}),
    "Der Palast ist ganz schoen gross!",
    "sagt: ");

  AddInfo( ({"mahmud"}),
    "Mahmud ist immer lieb und freundlich zu mir!",
    "sagt freudig: ");

  AddInfo( ({"geschichte", "geschichten"}),
    "Mahmud erzaehlt uns immer ganz tolle Geschichten!",
    "strahlt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

  AddSpell(1,250,
    Name(WER, 1)+" zwickt Dich schmerzhaft ins Bein.\n",
    Name(WER, 1)+" zwickt @WEN schmerzhaft ins Bein.\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(2,
  ({Name(WER, 1)+" schaut Dich ein wenig aengstlich an.\n",
    Name(WER, 1)+" lutscht an seinem Daumen herum.\n",
    Name(WER, 1)+" traut sich nicht, mit den anderen Kindern zu spielen.\n",
    Name(WER, 1)+" steckt seinen Finger in den Mund.\n",
    Name(WER, 1)+" betrachtet Dich schuechtern.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" schluchzt herzzerreissend.\n",
    Name(WER, 1)+" bricht in Traenen aus.\n",
    Name(WER, 1)+" wehrt sich verzweifelt.\n" }));

//--Ausruestung------------------------------------------------------------


//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt ein kleines Hobbitmaedchen.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "starrt Dich verwirrt an.",
        "starrt "+TP->name(WEN)+" verwirrt an.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "schnieft leise.",
        "schnieft leise.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "kichert verlegen.",
        "kichert verlegen.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "bricht in Traenen aus und faengt bitterlich an zu weinen.",
        "bricht in Traenen aus und faengt bitterlich an zu weinen.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "schaut Dich aengstlich an.",
        "schaut "+TP->name(WEN)+" aengstlich an.");
      break;

    case "froh":
    case "nett":
      call_out("reaction", 0, TP,
        "laechelt Dich schuechtern an.",
        "laechelt "+TP->name(WEN)+" schuechtern an.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "blickt Dich entsetzt an.",
        "blickt "+TP->name(WEN)+" entsetzt an.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "mustert Dich stumm.",
        "mustert "+TP->name(WEN)+" stumm.");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich unbeholfen.",
        "troestet "+TP->name(WEN)+" unbeholfen.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}
