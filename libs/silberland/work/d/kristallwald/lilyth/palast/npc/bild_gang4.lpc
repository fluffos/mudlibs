#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Gemaelde");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({ "kobold", "gemaelde", "NOT_LIVING" }));
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(1);

  SetProp(P_HANDS, ({" mit bildlicher Kraft"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })  );

  SetProp(P_RACE, "Gemaelde");
  SetProp(P_SIZE, 400);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NOATTACK, "kann nicht angegriffen werden!");
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_LOG_INFO, "/lilyth/palast/gemaelde");

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "erscheint an der Wand");
  SetProp(P_MSGOUT, "verschwindet ploetzlich spurlos");
  SetProp(P_MMSGIN, "erscheint an der Wand");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich spurlos");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Ein Gemaelde");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "schweigt vielsagend.\n",
            "scheint nachzudenken.\n",
            "bleibt stumm.\n"}));

  AddInfo( ({"palast"}),
    "Gegen Ende des Krieges, als die Angriffe der Orks nur noch vereinzelt "
    "stattfanden und die Menschen wieder friedlicheren Zeiten "
    "entgegenblickten, wurde aus dem Lager im Wald, das urspruenglich als "
    "Zufluchtsort fuer die vielen Opfer des Krieges diente, dieser Palast "
    "errichtet.",
    "schnarrt: ");

  AddInfo( ({"ende", "zeiten", "jahre"}),
    "Lange Jahre wurde das Land von Krieg und Zerstoerung gebeutelt, doch "
    "endlich begann sich ein Ende der staendigen Angriffe abzuzeichnen, und "
    "die Menschen fanden langsam wieder in ihr normales Leben zurueck. ",
    "schnarrt: ");

  AddInfo( ({"land", "kaempfe", "angriffe", "orks", "krieg", "zerstoerung",
  "kriege", "kampf", "angriff"}),
    "Das ganze Land litt unter den schweren Kaempfen und den Angriffen "
    "der Orks.",
    "schnarrt: ");

  AddInfo( ({"bau"}),
    "Der Palast wurde in erster Linie von den Menschen errichtet, doch auch "
    "viele der anderen Rassen haben daran mitgewirkt.",
    "schnarrt: ");

  AddInfo( ({"menschen"}),
    "Am Ende des Krieges errichteten die Menschen einen prachtvollen "
    "Palast, als Zeichen des Zusammenhalts und der Zusammengehoerigkeit "
    "aller Rassen. Viele derer, die ihnen im Krieg beigestanden hatten, "
    "blieben noch lange Zeit dort.",
    "schnarrt: ");

  AddInfo( ({"zeichen", "zusammenhalt", "zusammengehoerigkeit", "hilfe",
  "wirken", "rassen"}),
    "Ohne die Hilfe der Elfen, der Zwerge, der Hobbits und vieler anderer "
    "Rassen waeren die Menschen den Orks erlegen gewesen. Nur durch "
    "das gemeinschaftliche Wirken konnten die Angriffe zurueckgeschlagen "
    "und der Krieg beendet werden.",
    "schnarrt: ");

  AddInfo( ({"wald", "tethyrwald", "tethyr", "stelle"}),
    "An der gleichen Stelle, an der vormals das Lager der Verletzten "
    "war, wurde ein Palast im Wald errichtet.",
    "schnarrt: ");

  AddInfo( ({"lager", "zufluchtsort", "opfer", "verletzte", "verletzten",
  "heilung", "ort"}),
    "Das Lager war ein Zufluchtsort und ein Ort der Heilung fuer die "
    "vielen Opfer des Krieges.",
    "schnarrt: ");

  AddInfo( ({"hobbits", "elfen", "trolle", "oger", "zwerge", "dunkelelfen", 
  "feen", "untote"}),
    "Sie alle haben zum Sieg ueber die Orks beigetragen.",
    "schnarrt: ");

  AddInfo( ({"sieg"}),
    "Die Orks wurden besiegt und ihre Angriffe zurueckgeschlagen.",
    "schnarrt: ");

  AddInfo( ({"brunnen"}),
    "Der alte Brunnen blieb bestehen, und noch heute kommen Angehoerige "
    "aller Rassen dorthin, um der zahlreichen Opfer des Krieges zu "
    "gedenken, aber auch, um in schweren Zeiten den Rat und die Hilfe ihrer "
    "Goetter zu erflehen.",
    "schnarrt: ");

  AddInfo( ({"angehoerige"}),
    "Angehoerige aller Rassen kehren auch heute noch immer wieder zum "
    "Palast zurueck und gedenken der alten Zeiten.",
    "schnarrt: ");

  AddInfo( ({"rat", "goetter", "ruf"}),
    "Oftmals stehen die Goetter den Sterblichen mit gutem Rat zur Seite. "
    "Doch nicht jeder vernimmt ihren Ruf.",
    "schnarrt: ");

  AddInfo( ({"sterblich", "sterbliche", "sterblichen"}),
    "doch Du glaubst, ein leises Lachen zu hoeren.",
    "schweigt, ");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------



//--Funktionen-------------------------------------------------------------

//Wegwerf-Meldung unterdruecken:
void give_notify(object was)
{
        write(BS("Du kannst dem Gemaelde nichts geben und legst "
        +""+was->name()+" stattdessen auf dem Boden ab.\n"));
        
        ENV(TO)->Message(BS(TP->Name(WER, 1)+" legt "+was->name()+" auf "
        +"dem Boden ab."),  	       
  	MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  	
        was->move(ENV(TO), M_SILENT|M_PUT);
        return;
}
