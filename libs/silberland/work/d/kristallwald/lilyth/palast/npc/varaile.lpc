#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Varaile, die Haendlerin");
  SetProp(P_LONG,
    "Varaile ist eine sehr junge Elfe. Lange hellblonde Locken umrahmen ihr "
    "huebsches Gesicht und ihre strahlenden blaugruenen Augen blicken Dich "
    "mit einem freundlichen Laecheln an.");

/*
  SetProp(P_LONG,
    "Varaile ist eine sehr junge Elfe. Lange hellblonde Locken umrahmen ihr "
    "huebsches Gesicht und ihre strahlenden blaugruenen Augen blicken Dich "
    "mit einem freundlichen Laecheln an. Um ihr rechtes Handgelenk hat "
    "sie ein schmales goldenes Band gewickelt.");
*/

  AddDetail( ({ "locken", "schultern" }),
    "Die langen hellblonden Locken fallen locker ueber ihre Schultern "
    "und umrahmen das huebsche Gesicht.");

  AddDetail( ({ "gesicht" }),
    "Varaile ist wirklich aussergewoehnlich huebsch.");

  AddDetail( ({ "augen" }),
    "Ihre blaugruenen Augen strahlen wie zwei helle Sterne.");

  AddDetail( ({ "sterne" }),
    "Die siehst Du hier drinnen nicht.");

  AddDetail( ({ "laecheln" }),
    "Mit einem zauberhaften Laecheln blickt sie Dich froehlich an.");

/*
  AddDetail( ({ "handgelenk" }),
    "Ihr rechtes Handgelenk ist mit einem schmalen goldenen Armband "
    "umwickelt.");

  AddDetail( ({ "band", "armband" }),
    "Vielleicht erzaehlt sie Dir ein wenig mehr darueber, wenn Du sie "
    "danach fragst.");
*/

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Varaile");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"varaile", "elfe", "haendlerin"}));
  AddClass( ({CL_ELF}) );
  SetProp(P_ARTICLE, 0);

  set_living_name("varaile");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(20);

  SetProp(P_HANDS, ({ " mit elfischer Magie", 200, ({DT_MAGIC, DT_BLUDGEON}) }) );

  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 176);
  SetProp(P_WEIGHT, 47000);
  SetProp(P_ALIGN, 700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" fragt verwundert: Was soll ich denn damit?\n" }) );

  SetProp(P_LOG_INFO, "/lilyth/palast/varaile");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_HOLY:   0.1,
       DT_UNHOLY: 0.1,
       DT_MAGIC: -0.2,
       DT_MIND:  -0.1 ]));

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt laechelnd herein");
  SetProp(P_MSGOUT, "geht leise summend");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Varaile");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "schaut Dich fragend an.\n",
            "sagt: Das weiss ich leider nicht.\n",
            "faengt an, nachzudenken.\n"}));
/*
  AddInfo( ({"band","armband"}),
    "Das gehoerte meiner Mutter.",
    "sagt ein wenig traurig: ");
*/

  AddInfo( ({"tafel"}),
    "auf die kleine Tafel.",
    "deutet ");

  AddInfo( ({"vitrinen", "vitrine", "ware", "waren", "sachen",
  "kerze", "kerzen", "windlicht", "windlichter", "schneekugel",
  "schneekugeln", "spieluhr", "spieluhren", "luftballon", "luftballons",
  "luftschlange", "luftschlangen", "tabakbeutel", "drache", "drachen",
  "taschentuch", "taschentuecher"}),
    "In den Vitrinen kannst Du sehen, was ich gerade verkaufe.",
    "sagt freundlich: ");

  AddInfo( ({"kugel"}),
    "Die Kugel habe ich von meiner Mutter geschenkt bekommen. Ich finde "
    "sie sehr huebsch.",
    "sagt wehmuetig: ");

  AddInfo( ({"musik"}),
    "nur.",
    "laechelt ");

  AddInfo( ({"tuecher", "seidentuecher", "waende", "decke"}),
    "Ich fand die weissen Waende und die Decke so karg, daher habe ich die "
    "Tuecher aufgehaengt. So ist es hier doch viel schoener, oder?",
    "sagt verlegen: ");

  AddInfo( ({"mutter"}),
    "Sie ist vor vielen Jahren gestorben.",
    "sagt leise: ");

  AddInfo( ({"jahre", "jahren"}),
    "Es ist schon sehr lange her.",
    "sagt: ");

  AddInfo( ({"vater"}),
    "Ich habe ihn leider nie kennengelernt. Mahmud hat fuer mich gesorgt, "
    "nachdem meine Mutter gestorben war.",
    "seufzt: ");

  AddInfo( ({"mahmud"}),
    "Er war immer wie ein Vater fuer mich. Du findest ihn sicher oben bei "
    "den Kindern.",
    "laechelt: ");

  AddInfo( ({"kinder"}),
    "Er liebt Kinder ueber alles.",
    "sagt: ");

  AddInfo( ({"thimon", "konditorei"}),
    "Schau mal weiter noerdlich nach.",
    "laechelt: ");

  AddInfo( ({"laden"}),
    "Wie gefaellt er Dir?",
    "strahlt: ");

  AddInfo( ({"palast"}),
    "Ich habe mein ganzes Leben hier verbracht.",
    "sagt nachdenklich: ");

  AddInfo( ({"leben"}),
    "Das Leben ist etwas sehr Kostbares, also achte gut darauf.",
    "sagt ernst: ");

  AddInfo( ({"kostbares"}),
    "Das Leben ist das Kostbarste auf der Welt.",
    "sagt: ");

  AddInfo( ({"welt"}),
    "Ich habe leider noch nicht sehr viel von ihr gesehen, aber Mahmud "
    "hat frueher, als er noch etwas juenger war, viele fremde Orte bereist "
    "und kann Dir sicher mehr darueber erzaehlen.",
    "laechelt: ");

  AddInfo( ({"orte"}),
    "Frag ihn lieber selbst danach.",
    "sagt: ");

  AddInfo( ({"waren"}),
    "Wenn Du etwas kaufen moechtest, kannst Du das mit 'kaufe gegenstand' "
    "tun. Mein Angebot kannst Du Dir mit 'zeige' anschauen'. Vielleicht "
    "ist ja etwas fuer Dich dabei. Falls nicht, solltest Du ein wenig "
    "spaeter wiederkommen, denn mein Angebot wechselt immer mal von Zeit "
    "zu Zeit.",
    "sagt freundlich: ");

  AddInfo( ({"angebot"}),
    "Mein Angebot wechselt von Zeit zu Zeit ein wenig. Du kannst es Dir in "
    "aller Ruhe ansehen.",
    "sagt laechelnd: ");

  AddInfo( ({"ruhe"}),
    "Solange wie Du moechtest.",
    "sagt: ");

  AddInfo( ({"elfe"}),
    "Ja, ich bin eine Elfe. Das hast Du gut erkannt.",
    "kichert leise: ");

  AddInfo( ({"silberland"}),
    "Das Silberland ist sehr gross.",
    "sagt ein wenig stolz: ");

  AddInfo( ({"melodie"}),
    "Diese Melodie hat mir meine Mutter frueher immer vorgesungen.",
    "sagt verlegen: ");

//-------------------------------------------------------------------------

  AddInfo( ({"yoshy", "hund"}),
    "Yoshy laeuft meistens draussen irgendwo herum. Er ist ein lieber "
    "kleiner Hund. Er begleitet mich immer ein Stueck nach Hause.",
    "laechelt: ");

  AddInfo( ({"hause", "zuhause"}),
    "Mein Zuhause ist der Wald.",
    "laechelt geheimnisvoll: ");

  AddInfo( ({"wald", "tethyrwald"}),
    "Schau Dich draussen mal genauer um.",
    "sagt: ");

  AddInfo( ({"katze"}),
    "Draussen vor dem Palast findest Du sicher eine.",
    "gruebelt: ");
    
  AddInfo( ({"fischhaendler", "fisch"}),
    "Draussen vor dem Palast ist ein Fischhaendler.",
    "nickt: ");

  AddInfo( ({"obstverkaeufer", "obst"}),
    "Draussen vor dem Palast ist ein Obstverkaeufer.",
    "nickt: ");

  AddInfo( ({"trollwaechter", "waechter"}),
    "Die sind draussen vor dem Palast und bewachen das Eingangsportal.",
    "sagt: ");

  AddInfo( ({"portal", "eingangsportal"}),
    "Das grosse Eingangsportal zum Palast wird von Trollwaechtern "
    "bewacht.",
    "erklaert: ");

  AddInfo( ({"kobold", "brunnen"}),
    "Den findest Du im Untergeschoss.",
    "sagt: ");
  
  AddInfo( ({"linah", "koechin", "kueche"}),
    "Linah befindet sich im Untergeschoss. Sie kocht einfach phantastisch.",
    "sagt laechelnd: ");
  
  AddInfo( ({"tungdil", "schmied", "schmiede"}),
    "Die Schmiede ist unten im Untergeschoss.",
    "sagt: ");
  
  AddInfo( ({"velg'larn", "velglarn"}),
    "Sein Laden befindet sich im Untergeschoss.",
    "wird etwas blass um die Nase: ");

  AddInfo( ({"ceyth", "bogenhaendler", "bogenladen"}),
    "Den Bogenhaendler findest Du irgendwo unten.",
    "sagt: ");

  AddInfo( ({"fredolin", "schreiner", "schreinerei"}),
    "Die Schreinerei befindet sich unten im Untergeschoss.",
    "denkt kurz nach: ");

  AddInfo( ({"soldat", "soldaten"}),
    "Die Soldaten sorgen fuer die Sicherheit der Gaeste und Besucher des "
    "Palastes.",
    "laechelt: ");

  AddInfo( ({"sicherheit"}),
    "Hier im Palast befindest Du Dich in Sicherheit.",
    "sagt: ");

  AddInfo( ({"kartenzeichnerin", "zeichnerin", "alenari"}),
    "Die Kartenzeichnerin findest Du im Mittelgeschoss.",
    "sagt: ");

  AddInfo( ({"tierhaendler", "gordrogh", "tierhandlung"}),
    "Die Tierhandlung befindet sich im Mittelgeschoss.",
    "sagt: ");

  AddInfo( ({"kellnerin", "teestube"}),
    "Die Teestube liegt im Mittelgeschoss.",
    "sagt: ");

  AddInfo( ({"untergeschoss"}),
    "Das liegt weiter unten.",
    "sagt: ");

  AddInfo( ({"mittelgeschoss"}),
    "Das liegt weiter unten.",
    "sagt: ");

  AddInfo( ({"obergeschoss"}),
    "Da befindest Du Dich gerade.",
    "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,40);

  AddSpell(3,450,
    Name(WER, 1)+" zerschmettert eine grosse Glasvase auf Deinem Kopf!\n",
    Name(WER, 1)+" zerschmettert eine grosse Glasvase auf @WESSEN Kopf!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(4,520,
    Name(WER, 1)+" trifft Dich mit einem elfischen Zauber!\n",
    Name(WER, 1)+" trifft @WEN mit einem elfischen Zauber!\n",
    DT_MAGIC,([SP_SHOW_DAMAGE:1]));

  AddSpell(4,350,
    Name(WER, 1)+" bewirft Dich mit einem schweren Paeckchen.\n",
    Name(WER, 1)+" bewirft @WEN mit einem schweren Paeckchen.\n",
    DT_MAGIC,([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" fragt Dich: Moechtest Du nicht etwas kaufen?\n",
    Name(WER, 1)+" sortiert neue Waren in die Vitrinen ein.\n",
    Name(WER, 1)+" schaut Dich erwartungsvoll an.\n",
    Name(WER, 1)+" laechelt Dir freundlich zu.\n",
    Name(WER, 1)+" wartet auf neue Kundschaft.\n",
    Name(WER, 1)+" summt eine leise Melodie.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" stoehnt, als eine der Vitrinen zu Bruch geht.\n",
    Name(WER, 1)+" spricht ein paar geheimnisvolle Worte.\n",
    Name(WER, 1)+" ruft laut nach den Wachen!\n",
    Name(WER, 1)+" versucht, Dich aus ihrem Laden zu werfen.\n" }));

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME("/p/armour/armour/bluse");
  CLONEME("/p/armour/trousers/rock");
//CLONEME(ARMOUR "armband");
  command("trage alles");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt Varaile.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": Varaile hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "sagt laechelnd: Hab doch keine Angst.",
        "sagt laechelnd: Hab doch keine Angst.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "blickt Dich traurig an.",
        "blickt "+TP->name(WEN)+" traurig an.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "kichert albern.",
        "kichert albern.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "sagt: Du bist gemein!",
        "sagt: Du bist gemein!");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "mahnt: Lass das lieber sein.",
        "mahnt: Lass das lieber sein.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "zwinkert Dir froehlich zu.",
        "zwinkert "+TP->name(WEM)+" froehlich zu.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "knuddelt Dich.",
        "knuddelt "+TP->name(WEN)+".");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "erroetet leicht.",
        "erroetet leicht.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "schaut Dich freundlich an.",
        "schaut "+TP->name(WEN)+" freundlich an.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "versucht, Dich aufzumuntern.",
        "versucht, "+TP->name(WEN)+" aufzumuntern.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}
