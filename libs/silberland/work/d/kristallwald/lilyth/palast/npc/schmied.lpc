//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt Tungdil.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "kratzt sich am Kopf.",
        "kratzt sich am Kopf.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "mustert Dich finster.",
        "mustert "+TP->name(WEN)+" finster.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "schmunzelt leise in seinen Bart hinein.",
        "schmunzelt leise in seinen Bart hinein.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "deutet drohend auf seinen Schmiedehammer.",
        "deutet drohend auf seinen Schmiedehammer.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "brummt missmutig.",
        "brummt missmutig.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "grinst in seinen Bart.",
        "grinst in seinen Bart.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt unwirsch: Fuer so etwas habe ich keine Zeit!",
        "sagt unwirsch: Fuer so etwas habe ich keine Zeit!");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "gruebelt vor sich hin.",
        "gruebelt vor sich hin.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "runzelt die Stirn.",
        "runzelt die Stirn.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "klopft Dir troestend auf die Schulter.",
        "klopft "+TP->name(WEM)+" troestend auf die Schulter.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Hilfe anbieten:
int hilfe(string str)
{
  object myring;

  notify_fail("Wem moechtest Du Deine Hilfe anbieten?\n");

  if(!str || str == "") return 0;
  if(!(str == "tungdil hilfe an" ||
       str == "schmied hilfe an" ||
       str == "hilfe an")) return 0;

  if(!RING(TP))
  {
        myring = clone_object(ARMOUR "tungdil_ring");

        if(ME_TOO_HEAVY == myring->move(TP,M_GET|M_SILENT))
        {
               write(BS("Tungdil seufzt: Du kannst den Ring leider nicht "
               +"mehr tragen."));
               myring->remove();
               return -1;
        }
        else
        {
               write(BS("Tungdil ueberreicht Dir einen wunderschoenen "
               +"kleinen Ring und bittet Dich, ihn Linah so schnell wie "
               +"wie moeglich zu bringen."));

               ENV(TO)->Message(BS(Name(WER, 1)+" bekommt etwas von "
               +"Tungdil zugesteckt."),
               MSGFLAG_VISUAL|MSGFLAG_NO_TP);

               ring += ({ capitalize(getuid(TP)) });
               PALASTMASTER->Msg(TP->Name()+" bekommt den Ring von "
               +"Tungdil.", 2);
               return 1;
        }
  }
  else
  {
        write(BS("Tungdil sagt: Ich habe Dir den Ring doch bereits "
        +"gegeben."));
        return -1;
  }
}


void reset()
{
  ::reset();
  ring = ({ });
  einladung = ({ });
  darf_belohnung = ({ });
  hat_belohnung = ({ });
}

//Tungdil die Einladung geben:
void give_notify(object was)
{
  if(was->id("\neinladung"))
  {
     if(EINLADUNG(TP))
     {
        write(BS("Tungdil sagt: Du hast mir die Einladung doch "
        +"bereits gegeben."));
        return;
     }

     if(beschaeftigt == NEIN)
     {
        ENV(TO)->Message(BS("Entzueckt liest Tungdil, was auf der Karte "
        +"geschrieben steht.\n"), MSGFLAG_VISUAL);
        beschaeftigt = JA;
        einladung += ({ capitalize(getuid(TP)) });
        was->remove();
        SetChats(0, ({""})); //Chats ausschalten waehrend Sequenz
        call_out("seqeinladung", 5 , TP, 1);
        PALASTMASTER->Msg(TP->Name()+" ueberreicht Tungdil die Einladung."
        +"(MINIQUEST GELOEST).", 2);
        return;
     }
     else
     {
        write(BS("Tungdil ist gerade beschaeftigt."));
        return;
     }
  }

  if(was->id("tungdil_ring"))
  {
     write(BS("Tungdil gibt Dir den Ring zurueck und sagt ein wenig "
     +"enttaeuscht: Du wolltest doch Linah den Ring geben.\n"));
     was->move(TP,M_GET|M_SILENT);
     return;
  }

  if(HAT_BELOHNUNG(TP))
  {
      return::give_notify(was);
  }

  if(DARF_BELOHNUNG(TP))
  {
     if(!(was->QueryProp(P_WEAPON_TYPE) ||
          was->QueryProp(P_ARMOUR_TYPE)) ||
          was->id("geld"))
     {
         write(BS("Tungdil gruebelt: "+was->Name(WEN)+" kann ich leider "
         +"nicht aendern."));
         return::give_notify(was);
     }
     else
     {
         if(was->QueryProp(P_ARTICLE) == 1)
         {
             was->SetProp(P_ARTICLE, 0);
             was->SetProp(P_SHORT, TP->Name(WESSEN)+" "+was->name(WER));
             was->SetProp(P_ARTICLE, 1);
         }
         else
         {
             was->SetProp(P_SHORT, TP->Name(WESSEN)+" "+was->name(WER));
         }

         write(BS("Tungdil begutachtet "+was->name(WEN)+" eine Weile und "
         +"gruebelt ein wenig vor sich hin. Dann fummelt er mit ein paar "
         +"raschen Handgriffen daran herum, wirft noch einen abschaetzenden "
         +"Blick auf sein Werk und gibt Dir "+was->name(WEN)+" dann wieder "
         +"zurueck."));

         ENV(TO)->Message(BS("Tungdil begutachtet "+was->name(WEN)+" eine "
         +"Weile und scheint dann etwas damit zu machen. Anschliessend gibt "
         +"er "+TP->Name(WEM)+" "+was->name(WEN)+" wieder zurueck."),
         MSGFLAG_VISUAL|MSGFLAG_NO_TP);

         hat_belohnung += ({ capitalize(getuid(TP)) });
         darf_belohnung -= ({ capitalize(getuid(TP)) });
         was->move(TP,M_GET|M_SILENT);

         PALASTMASTER->Msg(TP->Name()+" laesst sich "+was->name(WEN)+" von "
         +"Tungdil gravieren.", 2);
         return;
     }
  }

  return::give_notify(was);
}

int fktdienst()
{
   if(DARF_BELOHNUNG(TP))
   {
        write(BS("Tungdil erklaert: Ich kann eine Waffe oder eine Ruestung "
        +"Deiner Wahl mit Deinem Namen versehen. So sieht jeder, wem sie "
        +"gehoert, wenn Du sie mal irgendwo verloren hast. Du brauchst mir "
        +"den gewuenschten Gegenstand nur zu geben, dann werde ich sehen, "
        +"was ich tun kann."));

        ENV(TO)->Message(BS("Tungdil antwortet "+TP->Name(WEM)+" etwas."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        return -1;
   }

   if(HAT_BELOHNUNG(TP))
   {
        write(BS("Tungdil sagt: Du hast Deinen Dienst bereits in Anspruch "
        +"genommen."));

        ENV(TO)->Message(BS("Tungdil antwortet "+TP->Name(WEM)+" etwas."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        return 1;
   }

   write(BS("Tungdil blickt Dich schweigend an."));

   ENV(TO)->Message(BS("Tungdil blickt "+TP->Name(WEN)+" schweigend an."),
   MSGFLAG_VISUAL|MSGFLAG_NO_TP);
   return -1;
}

//Sequenz:
void seqeinladung(object player, int pos)
{
  string s;
  string s2;

    if(!player || ENV(player) != ENV(TO))
    {
        set_back();
        return;
    }

    	switch(pos)
        {
        case 1:
        s = "Er strahlt bis ueber beide Ohren und freut sich wie "
        +"ein kleines Kind.";
        s2 = "Er strahlt bis ueber beide Ohren und freut sich wie "
        +"ein kleines Kind.";
        break;

        case 2:
        s = "Dann umarmt er Dich voellig unzwergisch und bedankt sich "
        +"wortreich bei Dir.";
        s2 = "Dann umarmt er "+player->Name()+" voellig unzwergisch und "
        +"bedankt sich wortreich bei "+player->QueryPronoun(WEM)+".";
        break;

        case 3:
        s = "Tungdil strahlt: Du hast mir sehr geholfen, "+player->Name()+"! "
        +"Als Dank dafuer moechte ich Dir gerne einen kleinen Dienst "
        +"anbieten, auch wenn es wirklich nur eine Kleinigkeit ist und kaum "
        +"den Wert dessen zu bemessen vermag, was Du fuer mich getan hast.";
        s2 = "Tungdil strahlt: Du hast mir sehr geholfen, "
        +""+player->Name()+". Als Dank dafuer moechte ich Dir gerne einen "
        +"kleinen Dienst anbieten, auch wenn es wirklich nur eine "
        +"Kleinigkeit ist und kaum den Wert dessen zu bemessen vermag, was "
        +"Du fuer mich getan hast.";
        break;

        case 4:
        s = "Tungdil zwinkert Dir zu: Frag mich einfach nach 'dienst', wenn "
        +"Du mehr darueber wissen moechtest.";
        s2 = "Tungdil fluestert "+player->Name()+" etwas zu.";
        darf_belohnung += ({ capitalize(getuid(TP)) });
        break;

        default:
          return;
          break;
        }

        tell_object(player, BS(s));
        ENV(TO)->Message(BS(s2), MSGFLAG_VISUAL,
        ([MSGFLAG_EXCLUDE: ({ player })]));
        pos = pos + 1;
        call_out("seqeinladung", 7, player, pos);
}

//alles zuruecksetzen, wenn Spieler waehrend Sequenz aus dem Raum rennt
void set_back()
{
  beschaeftigt = NEIN;
  SetChats(5,
  ({Name(WER, 1)+" haemmert auf einem Stueck Metall herum.\n",
    Name(WER, 1)+" grunzt unzufrieden.\n",
    Name(WER, 1)+" hebt eine heruntergefallene Zange vom Boden auf.\n",
    Name(WER, 1)+" arbeitet konzentriert vor sich hin.\n",
    Name(WER, 1)+" blickt kurz auf und brummt etwas in seinen Bart.\n",
    Name(WER, 1)+" wischt sich die Haende an seiner Schuerze ab.\n",
    Name(WER, 1)+" betaetigt den Blasebalg und laesst das Feuer hoch "
    +"auflodern.\n",
    Name(WER, 1)+" erhitzt ein Stueck Eisen im Feuer.\n",
    Name(WER, 1)+" taucht ein gluehendes Metallstueck mit einem lauten "
    +"Zischen in den Wassertrog.\n" }));
   return;
}

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}

//Reparaturen:
int rep_auswahl(object ob)
{
  //Metall - ja oder nein?
  if(!ob->QueryMaterialGroup(MATGROUP_METAL))
  {
    TP->Message(BS(Name(WER,1)+" sagt: Tut mir leid, aber ich kann nur "
    +"Sachen aus Metall reparieren!"), MSGFLAG_SOUND);
    return 0;
  }

  return 1;
}
