#include "../def.h"

inherit "/std/npc/spells";
inherit "/std/repair";
inherit "/std/npc/compare";

//--Variablen&Defines------------------------------------------------------

string *ring;
#define RING(wer) (member(ring, capitalize(getuid(wer)))!=-1)

string *einladung;
#define EINLADUNG(wer) (member(einladung, capitalize(getuid(wer)))!=-1)

string *hat_belohnung;
#define HAT_BELOHNUNG(wer) (member(hat_belohnung,capitalize(getuid(wer)))!=-1)

string *darf_belohnung;
#define DARF_BELOHNUNG(wer) (member(darf_belohnung,capitalize(getuid(wer)))!=-1)

int beschaeftigt;
void set_back();

int fktdienst();

//--Create-----------------------------------------------------------------

