#include "../def.h"

inherit "std/npc";
//inherit "std/mnpc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleines Feenmaedchen");
  SetProp(P_LONG,
    "Ein kleines suesses Feenmaedchen steht vor Dir. Es hat sehr kurze, "
    "roetliche Haare und grosse blaue Augen, mit denen es Dich neugierig "
    "ansieht.");

  AddDetail( ({ "haare", "haar" }),
    "Die Haare sind kurz geschnitten und haben einen sehr warmen, "
    "roetlichen Farbton.");

  AddDetail( ({ "farbton", "ton", "farbe" }),
    "Seine Haare haben eine roetliche Farbe.");

  AddDetail( ({ "augen", "auge" }),
    "Seine grossen blauen Augen blicken Dich neugierig und zugleich ein "
    "wenig aengstlich an.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Feenmaedchen");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"fee", "feenmaedchen", "maedchen", "kind"}));
  AddClass( ({CL_FAIRY}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(6);

  SetProp(P_HANDS, ({ " mit Feenmagie", 60, ({DT_MAGIC, DT_BLUDGEON}) }) );

  SetProp(P_RACE, "Fee");
  SetProp(P_SIZE, 30);
  SetProp(P_WEIGHT, 10000);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" sagt: Das will ich nicht haben!\n" }) );

  SetProp(P_LOG_INFO, "/lilyth/palast/kinder");

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "hopst froehlich herein");
  SetProp(P_MSGOUT, "hopst froehlich");
  SetProp(P_MMSGIN, "hopst froehlich herein");
  SetProp(P_MMSGOUT, "hopst froehlich nach Hause");

  SetProp(P_MNPC_AREA, ({ ROOM "og_treppe", ROOM "og_konditorei",
                          ROOM "og_spielzimmer", ROOM "og_bibliothek" }) );

  SetProp(P_MNPC_DEFAULTROOM, ROOM "og_treppe");
  SetProp(P_MNPC_WAIT, ({ 10, 40, 30 }));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " wird nie wieder spielen.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MURDER_MSG, "Das sage ich meiner Mama! *schluchz*");
  SetProp(P_KILL_NAME, "Ein kleines Feenmaedchen");
  SetProp(P_KILL_MSG, "Aetsch!!!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "sagt: Haeh? Versteh ich nicht!\n",
            "runzelt die Stirn und denkt angestrengt nach.\n",
            "schaut Dich mit grossen Augen an.\n"}));

  AddInfo( ({"fee"}),
    "Jawohl, ich bin eine Fee!",
    "sagt stolz: ");

  AddInfo( ({"suesses"}),
    "Hast Du was fuer mich??",
    "fragt neugierig: ");

  AddInfo( ({"palast"}),
    "Den kannst Du doch sehen!",
    "sagt altklug: ");

  AddInfo( ({"mahmud"}),
    "Ich hab Mahmud lieb!",
    "strahlt: ");

  AddInfo( ({"geschichte", "geschichten"}),
    "Mahmud erzaehlt uns immer ganz tolle Geschichten!",
    "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

  AddSpell(1,230,
    Name(WER, 1)+" trifft Dich mit einem schwachen Feenzauber!\n",
    Name(WER, 1)+" trifft @WEN mit einem schwachen Feenzauber!\n",
    DT_MAGIC,([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(2,
  ({Name(WER, 1)+" singt leise vor sich hin.\n",
    Name(WER, 1)+" huepft durch die Gegend.\n",
    Name(WER, 1)+" fragt Dich: Spielst Du mit mir???\n",
    Name(WER, 1)+" schaut Dich mit grossen Augen an.\n",
    Name(WER, 1)+" fragt Dich: Hast Du was Suesses fuer mich?\n",
    Name(WER, 1)+" zupft an Deinem Aermel herum.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" kratzt und beisst wild um sich.\n",
    Name(WER, 1)+" versucht, Dir zu entwischen.\n",
    Name(WER, 1)+" jammert laut: Du tust mir weh!\n" }));

//--Ausruestung------------------------------------------------------------


//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt ein kleines Feenmaedchen.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "schaut Dich belustigt an.",
        "schaut "+TP->name(WEN)+" belustigt an.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "schnieft: Du bist gemein, "+TP->name(WER)+"!",
        "schnieft: Du bist gemein, "+TP->name(WER)+"!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "kichert albern.",
        "kichert albern.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "bricht in Traenen aus und faengt bitterlich an zu weinen.",
        "bricht in Traenen aus und faengt bitterlich an zu weinen.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "streckt Dir die Zunge raus.",
        "streckt "+TP->name(WEM)+" die Zunge raus.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "huepft froehlich um Dich herum.",
        "huepft froehlich um "+TP->name(WEN)+" herum.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "starrt Dich verwundert an.",
        "starrt "+TP->name(WEN)+" verwundert an.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "lacht Dich froehlich an.",
        "lacht "+TP->name(WEN)+" froehlich an.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "flattert mit ihren winzigen Fluegeln.",
        "flattert mit ihren winzigen Fluegeln.");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "versucht Dich lieb zu troesten.",
        "versucht "+TP->name(WEN)+" lieb zu troesten.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}

//Suessigkeiten geben:
void give_notify(object was)
{
    if(was->id("\nsuesses"))
    {
        write(break_string("Das kleine Feenmaedchen strahlt: "
        +"Danke, "+this_player()->Name()+"! Du bist aber lieb!\nDas kleine "
        +"Feenmaedchen laesst sich "+was->name(WEN)+" schmecken.\n",
        78, 0, BS_LEAVE_MY_LFS));
        
        ENV(TO)->Message(break_string("Das kleine Feenmaedchen strahlt: "
        +"Danke, "+this_player()->Name()+"! Du bist aber lieb!\nDas kleine "
        +"Feenmaedchen laesst sich "+was->name(WEN)+" schmecken.\n",
        78, 0, BS_LEAVE_MY_LFS),
        MSGFLAG_SOUND|MSGFLAG_NO_TP);
        was->remove();
        return;
    }
    
    return ::give_notify(was);
}
