#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Gemaelde");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({ "frau", "heilerin", "gemaelde", "NOT_LIVING" }));
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(1);

  SetProp(P_HANDS, ({" mit bildlicher Kraft"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })  );

  SetProp(P_RACE, "Gemaelde");
  SetProp(P_SIZE, 400);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NOATTACK, "kann nicht angegriffen werden!");
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_LOG_INFO, "/lilyth/palast/gemaelde");

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "erscheint an der Wand");
  SetProp(P_MSGOUT, "verschwindet ploetzlich spurlos");
  SetProp(P_MMSGIN, "erscheint an der Wand");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich spurlos");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Ein Gemaelde");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "seufzt leise.\n",
            "bleibt stumm.\n",
            "scheint lautlos zu weinen.\n"}));

  AddInfo( ({"avir", "stadt"}),
    "Die Stadt Avir wurde zum letzten Zufluchtsort der Menschen. Alle, "
    "die zu alt oder zu jung zum Kaempfen waren, blieben in der Stadt "
    "und kuemmerten sich um die vielen Verwundeten, die Tag fuer Tag "
    "dort ankamen oder von ihren Kameraden hergebracht wurden.",
    "sagt traurig: ");

  AddInfo( ({"felsen", "fels"}),
    "Die Stadt Avir liegt hoch oben auf einem grossen Felsen.",
    "sagt traurig: ");

  AddInfo( ({"turm", "turm der kuenste", "kuenste"}),
    "Der Turm der Kuenste liegt ueber der Stadt Avir.",
    "sagt traurig: ");

  AddInfo( ({"krieg", "kriege", "kaempfe", "kampf", "angriff", "angriffe"}),
    "Schreckliche Kaempfe wurden in diesen Tagen des Krieges gefuehrt.",
    "sagt traurig: ");

  AddInfo( ({"zufluchtsort", "zuflucht"}),
    "Es war der letzte Zufluchtsort.",
    "sagt traurig: ");

  AddInfo( ({"menschen"}),
    "Die Menschen suchten Schutz und Heilung in der Stadt Avir, ihrer "
    "letzten Zuflucht.",
    "sagt traurig: ");
    
  AddInfo( ({"schutz", "stadtmauern", "stadtmauer", "mauern", "mauer"}),
    "Die hohen Stadtmauern boten den Menschen ein wenig Schutz vor den "
    "Angriffen.",
    "sagt traurig: ");

  AddInfo( ({"kaempfen", "kaempfer"}),
    "Nicht alle Menschen waren in der Lage, zu kaempfen. Und es wurden "
    "von Tag zu Tag immer weniger. Und die, die kaempfen konnten, wurden "
    "durch den Anblick ihrer schwerverletzen Kameraden und die "
    "Hoffnungslosigkeit in ihren Augen entmutigt.",
    "sagt traurig: ");

  AddInfo( ({"anblick", "heilung"}),
    "Die wenigen Heiler der Stadt kamen gegen den grossen Strom der "
    "Verwundeten nicht an. Viele blieben ohne Heilung und starben "
    "langsam und unter schrecklichen Qualen vor den hilflosen Augen "
    "ihrer Familien.",
    "sagt traurig: ");

  AddInfo( ({"heilerin"}),
    "Es war nicht leicht fuer uns Heiler, den vielen Verwundeten zu "
    "helfen. Viele von ihnen starben nicht an den Verletzungen, die "
    "ihre Koerper davongetragen hatten, sondern an der Angst und der "
    "Verzweiflung, die sie selbst verspuerten und die sie ueberall umgab.",
    "sagt traurig: ");

  AddInfo( ({"verletzungen", "koerper"}),
    "Viele von ihnen waren schwer verletzt.",
    "sagt traurig: ");

  AddInfo( ({"qualen", "augen", "familien", "anblick", "leid", "elend"}),
    "Es war einfach schrecklich.",
    "sagt traurig: ");

  AddInfo( ({"verwundete", "verwundeten", "tag", "kameraden", "strom"}),
    "Jeden Tag wurden neue Verwundete in die Stadt gebracht. Nicht viele "
    "von ihnen ueberlebten.",
    "sagt traurig: ");

  AddInfo( ({"hoffnungslosigkeit", "hoffnung", "angst", "verzweiflung",
  "schmerz"}),
    "Die Menschen hatten kaum noch Hoffnung angesichts all des Leids und "
    "des Elends, das sie umgab, und sie fuerchteten sich.",
    "sagt traurig: ");

  AddInfo( ({"gasse", "gassen", "strasse", "strassen"}),
    "Ueberall auf den Strassen der Stadt lagen die Verwundeten und auch "
    "die Toten. Es war ein schrecklicher Anblick, besonders fuer die "
    "Kinder.",
    "sagt traurig: ");

  AddInfo( ({"kind", "kinder"}),
    "Die Kinder mussten mitansehen, wie ihre Brueder, ihre Vaeter "
    "und Grossvaeter vor ihren Blicken starben und wie ihre Muetter "
    "verzweifelten.",
    "sagt traurig: ");

  AddInfo( ({"vaeter", "vater", "grossvater", "grossvaeter", "muetter", 
  "mutter"}),
    "Viele Kinder verloren ihre Vaeter und Grossvaeter und standen dem "
    "Schmerz und der Verzweiflung ihrer Muetter hilflos gegenueber.",
    "sagt traurig: ");

  AddInfo( ({"tote", "toten", "leben"}),
    "Viele verloren ihr Leben in diesem Krieg.",
    "sagt traurig: ");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------



//--Funktionen-------------------------------------------------------------

//Wegwerf-Meldung unterdruecken:
void give_notify(object was)
{
        write(BS("Du kannst dem Gemaelde nichts geben und legst "
        +""+was->name()+" stattdessen auf dem Boden ab.\n"));
        
        ENV(TO)->Message(BS(TP->Name(WER, 1)+" legt "+was->name()+" auf "
        +"dem Boden ab."),  	       
  	MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  	
        was->move(ENV(TO), M_SILENT|M_PUT);
        return;
}
