#include "../def.h"

inherit "std/mnpc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleiner Zwergenjunge");
  SetProp(P_LONG,
    "Der kleine Zwergenjunge hat kurze, roetliche Haare und tiefblaue "
    "Augen. Da er noch ein Kind ist, hat er noch gar keinen Bart. Aber wenn "
    "er groesser wird, waechst ihm bestimmt bald einer.");

  AddDetail( ({ "haare", "haar" }),
    "Sie haben eine roetliche Farbe, wie es bei Zwergen sehr oft der Fall "
    "ist.");

  AddDetail( ({ "farbe" }),
    "Sie sind roetlich.");

  AddDetail( ({ "zwerge", "fall" }),
    "Zwerge haben oft roetliches Haar.");

  AddDetail( ({ "augen" }),
    "Er hat tiefblaue Augen, mit denen er Dich ein wenig naseweis ansieht.");

  AddDetail( ({ "bart", "flaum" }),
    "Es ist noch nicht einmal ein leichter Flaum zu sehen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Zwergenjunge");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"zwerg", "zwergenjunge", "junge", "kind"}));
  AddClass( ({CL_DWARF}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(7);

  SetProp(P_HANDS, ({ " mit seinen Haenden", 70, DT_BLUDGEON }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 67);
  SetProp(P_WEIGHT, 45);
  SetProp(P_ALIGN, -40);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" sagt: Das will ich nicht haben!\n" }) );

  SetProp(P_LOG_INFO, "/lilyth/palast/kinder");

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "laeuft herein");
  SetProp(P_MSGOUT, "laeuft");
  SetProp(P_MMSGIN, "laeuft herein");
  SetProp(P_MMSGOUT, "laeuft nach Hause");

  SetProp(P_MNPC_AREA, ({ ROOM "og_treppe", ROOM "og_konditorei",
                          ROOM "og_spielzimmer", ROOM "og_bibliothek" }) );

  SetProp(P_MNPC_DEFAULTROOM, ROOM "og_treppe");
  SetProp(P_MNPC_WAIT, ({ 15, 50, 20 }));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " wird nie wieder spielen.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MURDER_MSG, "Das sage ich meinem Papa! *schluchz*");
  SetProp(P_KILL_NAME, "Ein kleiner Zwergenjunge");
  SetProp(P_KILL_MSG, "Aetsch!!!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "sagt: Das weiss ich doch nicht!\n",
            "gruebelt vor sich hin.\n",
            "starrt Dich verwirrt an.\n"}));

  AddInfo( ({"zwerg"}),
    "Ich bin ein Zwerg!",
    "sagt stolz: ");

  AddInfo( ({"palast"}),
    "Du bist hier in einem grossen Palast!",
    "sagt: ");

  AddInfo( ({"mahmud"}),
    "Mahmud ist lieb!",
    "strahlt: ");

  AddInfo( ({"geschichte", "geschichten"}),
    "Mahmud erzaehlt uns immer ganz tolle Geschichten!",
    "sagt: ");

  AddInfo( ({"bart"}),
    "Bald waechst mir einer!",
    "hofft: ");

  AddInfo( ({"papa"}),
    "Hast Du ihn gesehen?",
    "fragt: ");

  AddInfo( ({"felonia"}),
    "Da komm ich her!",
    "sagt stolz: ");

  AddInfo( ({"schluckauf"}),
    "*Hick*.",
    "macht ");



//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);
  
  AddSpell(1,250,
    Name(WER, 1)+" tritt nach Dir!\n",
    Name(WER, 1)+" tritt nach @WEM!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(2,
  ({Name(WER, 1)+" laeuft hinter den anderen Kindern her.\n",
    Name(WER, 1)+" blickt Dich naseweis an.\n",
    Name(WER, 1)+" schaut Dich neugierig an.\n",
    Name(WER, 1)+" bekommt ploetzlich Schluckauf.\n",
    Name(WER, 1)+" fragt Dich: Hast Du meinen Papa gesehen?\n",
    Name(WER, 1)+" fragt Dich: Warst Du schon mal in Felonia?\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" ruft verzweifelt um Hilfe.\n",
    Name(WER, 1)+" faengt an zu weinen.\n",
    Name(WER, 1)+" versucht, Dich zu treten.\n" }));

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt einen kleinen Zwergenjungen.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "stupst Dich verwundert an.",
        "stupst "+TP->name(WEN)+" verwundert an.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "schmollt: Du bist gemein, "+TP->name(WER)+"!",
        "schmollt: Du bist gemein, "+TP->name(WER)+"!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "grinst Dich an.",
        "grinst "+TP->name(WER)+" an.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "faengt an zu weinen.",
        "faengt an zu weinen.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "streckt Dir die Zunge raus.",
        "streckt "+TP->name(WEM)+" die Zunge raus.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "freut sich mit Dir.",
        "freut sich mit "+TP->name(WEM)+".");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "kratzt sich am Kopf.",
        "kratzt sich am Kopf.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "lacht Dich an.",
        "lacht "+TP->name(WEN)+" an.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "mustert Dich stumm.",
        "mustert "+TP->name(WEN)+" stumm.");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich unbeholfen.",
        "troestet "+TP->name(WEN)+" unbeholfen.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}

//Suessigkeiten geben:
void give_notify(object was)
{
    if(was->id("\nsuesses"))
    {
        write(break_string("Der kleine Zwergenjunge freut sich: "
        +"Danke, "+this_player()->Name()+"!\nDer kleine "
        +"Zwergenjunge laesst sich "+was->name(WEN)+" schmecken.\n",
        78, 0, BS_LEAVE_MY_LFS));
        
        ENV(TO)->Message(break_string("Der kleine Zwergenjunge freut sich: "
        +"Danke, "+this_player()->Name()+"!\nDer kleine "
        +"Zwergenjunge laesst sich "+was->name(WEN)+" schmecken.\n",
        78, 0, BS_LEAVE_MY_LFS),
        MSGFLAG_SOUND|MSGFLAG_NO_TP);
        was->remove();
        return;
    }
    
    return ::give_notify(was);
}
