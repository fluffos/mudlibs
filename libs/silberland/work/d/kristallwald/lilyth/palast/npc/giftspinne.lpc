#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine kleine Giftspinne");
  SetProp(P_LONG,
    "Diese kleine Giftspinne sieht trotz ihrer geringen Groesse wirklich "
    "fies aus. Sie hat acht lange, haarige Beine und einen dicken schwarzen, "
    "ebenfalls leicht behaarten Koerper. Sie ist extrem giftig, also reize "
    "sie lieber nicht.");

  AddDetail( ({ "groesse" }),
    "Sie ist relativ klein.");

  AddDetail( ({ "beine" }),
    "Sie hat ihre acht langen, haarigen Beine weit von sich ausgestreckt.");

  AddDetail( ({ "koerper" }),
    "Ihr Koerper ist leicht behaart.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Giftspinne");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"spinne", "giftspinne", "\ngiftspinne"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(3);

  SetProp(P_HANDS, ({ " mit ihren haarigen Beinen", 30, DT_BLUDGEON }) );

  SetProp(P_RACE, "Spinne");
  SetProp(P_SIZE, 3);
  SetProp(P_WEIGHT, 5);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP, "" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE: 0.1 ]));

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "krabbelt aus einem der Regale");
  SetProp(P_MSGOUT, "krabbelt in eines der Regale");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Eine kleine Giftspinne");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

  AddDefaultSpell(1, 1, DS_POISON,
    "Die kleine Giftspinne vergiftet Dich!\n",
    "Die kleine Giftspinne vergiftet @WEN!\n");

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" krabbelt herum.\n",
    Name(WER, 1)+" beaeugt Dich wachsam.\n",
    Name(WER, 1)+" bewegt eines ihrer acht Beine in Deine Richtung.\n",
    Name(WER, 1)+" krabbelt langsam auf Dich zu.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" versucht, Dich zu vergiften.\n",
    Name(WER, 1)+" krabbelt wuetend herum.\n" }));

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

void init()
{
        ::init();
        if(TP && TP->id("\nvelglarn")) AddDefender(TP);
        if(TP && TP->id("\ngiftspinne")) AddDefender(TP);
}

void InformDefend(object enemy)
{
        Kill(enemy);
}
