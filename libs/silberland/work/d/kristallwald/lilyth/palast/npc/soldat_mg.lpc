#include "../def.h"
#include <combat.h>

inherit "std/mnpc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------

string *players;

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  players = ({});

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Soldat");
  SetProp(P_LONG,
    "Dieser Soldat patrouilliert durch die Gaenge des Palastes und achtet "
    "aufmerksam darauf, dass niemand von den Besuchern oder Ladeninhabern "
    "belaestigt oder gar koerperlich angegriffen wird. Seine rechte Hand "
    "liegt stets griffbereit auf dem lose in seiner Guertelschnalle "
    "baumelnden Kriegsflegel, um notfalls schnell fuer Ruhe und Ordnung "
    "sorgen zu koennen.");

  AddDetail( ({ "gaenge", "palast" }),
    "Er patrouilliert durch die Gaenge des Palastes.");

  AddDetail( ({ "besucher" }),
    "Die Besucher sollen sich im Palast sicher fuehlen.");

  AddDetail( ({ "ladeninhaber" }),
    "Auch die Ladeninhaber sollen in ihrer Arbeit nicht von aufruehrerischen "
    "Besuchern gestoert werden.");

  AddDetail( ({ "hand" }),
    "Die rechte Hand ruht griffbereit auf dem Kriegsflegel.");

  AddDetail( ({ "guertelschnalle" }),
    "Den Kriegsflegel hat er sich locker in seine Guertelschnalle gesteckt, "
    "so dass er ihn schnell herausziehen und im Notfall Gebrauch davon "
    "machen kann.");

  AddDetail( ({ "kriegsflegel", "waffe" }),
    "So nahe kommst Du an den Soldaten nicht heran!");

  AddDetail( ({ "gebrauch" }),
    "Sollte wirklich ein Notfall auftreten, wird er sich nicht scheuen, "
    "seinen Kriegsflegel als Waffe einzusetzen.");

  AddDetail( ({ "notfall" }),
    "Nur im Notfall macht der Soldat von seinem Kriegsflegel Gebrauch.");

  AddDetail( ({ "ruhe", "ordnung" }),
    "Der Soldat sorgt fuer Ruhe und Ordnung im Palast.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Soldat");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"soldat", "mensch"}));
  AddClass( ({CL_HUMAN}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(25);

  SetProp(P_HANDS, ({ " mit seinen Haenden", 250, DT_BLUDGEON }) );

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 182);
  SetProp(P_WEIGHT, 78000);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" hat Wichtigeres zu tun, als Deine Sachen zu tragen.\n" }) );

  SetProp(P_LOG_INFO, "/lilyth/palast/soldat");

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt eilig herein");
  SetProp(P_MSGOUT, "geht eilig");
  SetProp(P_MMSGIN, "sorgt hier fuer Recht und Ordnung");
  SetProp(P_MMSGOUT, "wird woanders gebraucht");

  SetProp(P_MNPC_AREA, ({ ROOM "mg_treppe1", ROOM "mg_gang3",
                          ROOM "mg_treppe2", ROOM "mg_gang2",
                          ROOM "mg_gang1",   ROOM "mg_gang4" }) );

  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);
  SetProp(P_MNPC_DEFAULTROOM, ROOM "mg_treppe2");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Soldat");
  SetProp(P_KILL_MSG, "Ich dulde keinen Aufruhr!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "runzelt unglaeubig die Stirn.\n",
            "starrt Dich nervoes an.\n",
            "fragt Dich nervoes: Was meinst Du denn damit?\n"}));

  AddInfo("lilyth", "Ist sie etwa hier?","fragt nervoes: ");

  AddInfo( ({"palast", "ruhe", "ordnung"}),
    "Ich sorge fuer Ruhe und Ordnung im Palast.",
    "sagt nervoes: ");

  AddInfo( ({"ceyth", "bogenhaendler", "bogenladen", "velg'larn", "velglarn",
             "brunnen", "tungdil", "schmied", "fredolin"}),
  "Den findest Du irgendwo im Untergeschoss.",
  "sagt nervoes: ");

  AddInfo( ({"linah", "koechin", "schreinerei"}),
  "Die findest Du irgendwo im Untergeschoss.",
  "sagt nervoes: ");

  AddInfo( ({"alenari", "zeichnerin", "kartenzeichnerin", "teestube", 
  "kellnerin", "tierhandlung"}),
    "Die findest Du irgendwo hier oben.",
    "sagt: ");

  AddInfo( ({"gordrogh", "tierhaendler"}),
    "Den findest Du irgendwo hier oben.",
    "sagt: ");

  AddInfo( ({"mahmud", "geschichtenerzaehler", "erzaehler", "thimon",
  "konditor"}),
    "Den findest Du irgendwo im Obergeschoss.",
    "sagt: ");

  AddInfo( ({"varaile", "haendlerin"}),
    "Die findest Du irgendwo im Obergeschoss.",
    "sagt: ");

  AddInfo( ({"untergeschoss"}),
  "Um ins Untergeschoss zu gelangen, brauchst Du nur die Treppe "
  "hinabzugehen.",
  "sagt: ");

  AddInfo( ({"treppen", "treppe"}),
  "Es gibt zwei Treppen auf dieser Ebene, eine fuehrt ins Untergeschoss, "
  "die andere ins Obergeschoss.",
  "erklaert: ");

  AddInfo( ({"obergeschoss"}),
  "Das befindet sich oberhalb dieser Ebene.",
  "sagt: ");

  AddInfo( ({"mittelgeschoss"}),
  "Da befindest Du Dich gerade.",
  "sagt nervoes: ");

  AddInfo( ({"ebene", "ebenen"}),
  "Du befindest Dich momentan im Mittelgeschoss.",
  "sagt: ");

  AddInfo( ({"geschoss"}),
  "Welches Geschoss meinst Du denn?",
  "fragt nervoes: ");

  AddInfo( ({"laden"}),
  "Welchen Laden meinst Du denn jetzt?",
  "fragt nervoes: ");

  AddInfo( ({"fischhaendler"}),
  "Der ist irgendwo draussen auf dem Vorhof und verkauft dort seine Fische.",
  "sagt: ");

  AddInfo( ({"fische", "fisch"}),
  "Beim Fischhaendler draussen kannst Du frische Fische kaufen.",
  "sagt: ");

  AddInfo( ({"obstverkaeufer"}),
  "Er verkauft Obst draussen auf dem Vorhof.",
  "sagt: ");

  AddInfo( ({"vorhof"}),
  "Den hast Du doch sicher schon gesehen, draussen vor dem Palast.",
  "sagt tadelnd: ");

  AddInfo( ({"yoshy", "hund"}),
  "Der laeuft draussen irgendwo herum.",
  "sagt: ");

  AddInfo( ({"katze"}),
  "Ja, eine Katze habe ich draussen auf dem Vorhof schon mal gesehen.",
  "gruebelt: ");

  AddInfo( ({"kobold"}),
  "Den findest Du sicherlich unten irgendwo.",
  "sagt nervoes: ");

  AddInfo( ({"trollwaechter", "waechter", "aerger"}),
  "Die Waechter achten darauf, dass niemand in den Palast kommt und hier "
  "Aerger macht.",
  "sagt nervoes: ");

  AddInfo( ({"soldat"}),
  "Als Soldat lebt man ganz schoen gefaehrlich!",
  "sagt nervoes: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

  AddSpell(4,700,
    Name(WER, 1)+" laesst seinen Kriegsflegel auf Dich niedersausen!\n",
    Name(WER, 1)+" laesst seinen Kriegsflegel auf @WEN niedersausen!\n",
    ({ DT_BLUDGEON, DT_PIERCE }),([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(3, 120, DS_DISARM,
    Name(WER, 1)+" trifft Dich hart am Arm, so dass Du Deine Waffe "
    "fallenlaesst!\n",
    Name(WER, 1)+" trifft @WEN hart am Arm, so dass @WER die Waffe "
    "fallenlaesst!\n");

  AddDefaultSpell(2, 1, DS_ANTIMAGIC,
    Name(WER, 1)+" wirbelt seinen Kriegsflegel blitzschnell um Dich "
    "herum und verwirrt Dich damit voellig!\n",
    Name(WER, 1)+" wirbelt seinen Kriegsflegel blitzschnell um Dich "
    "herum und verwirrt Dich damit voellig!\n");

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" sorgt fuer Ruhe und Ordnung im Palast.\n",
    Name(WER, 1)+" starrt nervoes den Gang hinunter.\n",
    Name(WER, 1)+" macht einen unruhigen Eindruck.\n",
    Name(WER, 1)+" raeuspert sich nervoes.\n",
    Name(WER, 1)+" tritt unruhig von einem Bein aufs andere.\n",
    Name(WER, 1)+" mustert Dich nervoes.\n",
    Name(WER, 1)+" laeuft unruhig hin und her.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" wirbelt seinen Kriegsflegel herum.\n",
    Name(WER, 1)+" ruft laut um Unterstuetzung!\n",
    Name(WER, 1)+" versucht, Dich an die Wand zu draengen.\n" }));

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME("/p/weapon/chain/kriegsflegel");
  command("zuecke kriegsflegel");

  clone_object("/p/armour/boots/lederstiefel")->move(TO);
  clone_object("/p/armour/armour/messingruestung")->move(TO);
  clone_object("/p/armour/belt/guertel")->move(TO);

  if(!random(4))
  {
        clone_object("/p/armour/bracers/lederarmschienen")->move(TO);
  }

  if(!random(5))
  {
        clone_object("/p/armour/trousers/lederbeinschienen")->move(TO);
  }

  command("zieh alles an");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt einen Soldaten.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "taetschelt Dir nervoes den Kopf.",
        "taetschelt "+TP->name(WEM)+" nervoes den Kopf.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "starrt Dich nervoes an.",
        "starrt "+TP->name(WEN)+" nervoes an.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "kichert nervoes.",
        "kichert nervoes.");
      break;

    case "fies":
        if(member(players, getuid(TP)) == -1)
        {
                call_out("reaction", 0, TP,
                "warnt Dich nervoes: Lass das lieber bleiben!",
                "warnt "+TP->name(WEN)+" nervoes: Lass das lieber bleiben!");
                players += ({ getuid(TP) });
        }
        else
        {
                TO->reaction(TP,
                "seufzt: Du wolltest ja nicht hoeren!",
                "seufzt: Du wolltest ja nicht hoeren!");
                Kill(TP);
        }
        break;

    case "frech":
      call_out("reaction", 0, TP,
        "runzelt die Stirn.",
        "runzelt die Stirn.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "grinst ein wenig nervoes.",
        "grinst ein wenig nervoes.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "stottert: Wwwas wird ddddenn ddas???",
        "stottert: Wwwas wird ddddenn ddas???");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "laechelt Dich ein wenig nervoes an.",
        "laechelt "+TP->name(WEN)+" ein wenig nervoes an.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "laeuft unruhig den Gang entlang.",
        "laeuft unruhig den Gang entlang.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "sagt nervoes: Das wird schon wieder!",
        "sagt nervoes: Das wird schon wieder!");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Master:
void angriff(object pl)
{
  string shouter;

  if(!ENV(TO))           return;
  if(!interactive(pl))   return;
  if(ENV(TO) != ENV(pl)) return;

  shouter = pl->CannotSee(1) ? "Jemand ruft: "
                             : Name(WER,1)+" ruft: ";

  tell_room(ENV(TO),
     ""+break_string(pl->Name(WER)+" hat den Frieden im Palast gestoert, "
     +"haltet "+pl->QueryPronoun(WEN)+" auf!!!", 78, shouter+"", 1));

  Kill(pl);

  return;
}

//Master:
void init()
{
  ::init();

  if(!TP)                        return;
  if(!interactive(TP))           return;
  if(TP->QueryProp(P_GHOST))     return;
  if(!PALASTMASTER->IsEnemy(TP))   return;

  call_out("angriff", 0, TP);
}

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}

void reset()
{
        ::reset();
        players = ({ });
}