#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"

inherit "/p/service/angel/haustiere/std_petshop_vendor";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Gordrogh, der Tierhaendler");
  SetProp(P_LONG,
    "Fast haettest Du den winzigen Gnom, der hinter der Ladentheke steht, "
    "uebersehen. Er ist so klein, dass er fast vollstaendig dahinter "
    "verschwindet, nur seine bemerkenswert lange Nasenspitze ragt vorwitzig "
    "ueber den Thekenrand hinaus. Das Sonderbarste an ihm ist wohl seine "
    "Kleidung, denn er hat sich eine riesige Pudelmuetze tief in die Stirn "
    "gezogen, so dass Du seine Augen kaum erkennen kannst. Ein paar duenne, "
    "weissblonde Haare lugen darunter hervor.");

  AddDetail( ({ "ladentheke", "theke", "thekenrand", "rand" }),
    "Er verschwindet fast voellig hinter der Ladentheke, die im "
    "Gegensatz zu ihm nahezu riesig wirkt.");

  AddDetail( ({ "gegensatz" }),
    "Im Gegensatz zu dem kleinen Gnom wirkt die Theke riesenhaft gross.");

  AddDetail( ({ "nasenspitze", "spitze", "nase" }),
    "Ausser seiner langen Nasenspitze kannst Du von dem Gnom nicht sehr "
    "viel erkennen.");

  AddDetail( ({ "sonderbarste", "sonderbarstes", "sonderbares", "kleidung",
  "geschmack" }),
    "Du zweifelst ein wenig an dem guten Geschmack Gordroghs, was "
    "seine Kleidung angeht.");

  AddDetail( ({ "pudelmuetze", "muetze" }),
    "Die Pudelmuetze sieht lustig aus, besonders da sie dem Gnom eindeutig "
    "viel zu gross ist. Wenn er nicht so eine lange Nase haette, wuerde "
    "sie ihm wohl bis auf die mageren Schultern hinabrutschen.");

  AddDetail( ({ "schultern", "schulter" }),
    "Der Gnom ist ziemlich mager.");

  AddDetail( ({ "stirn" }),
    "Er hat sich die Muetze tief in die Stirn gezogen.");

  AddDetail( ({ "augen", "auge" }),
    "Unter der riesigen Pudelmuetze kannst Du sie kaum erkennen.");

  AddDetail( ({ "haare", "haar" }),
    "Du siehst ein paar spaerliche, weissblonde Haare unter der Muetze "
    "hervorlugen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Gordrogh");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"gnom", "gordrogh", "haendler", "tierhaendler", "ladeninhaber",
  "inhaber", "\npetshop_vendor", "NOWIMPY"}));
  AddClass( ({CL_GNOME}) );
  SetProp(P_ARTICLE, 0);

  set_living_name("gordrogh");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(13);

  SetProp(P_HANDS, ({ " mit seinen langen Fingern", 130, DT_BLUDGEON }) );

  SetProp(P_RACE, "Gnom");
  SetProp(P_SIZE, 65);
  SetProp(P_WEIGHT, 30000);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" kreischt: Was soll ich denn damit?!\n" }) );

  SetProp(P_LOG_INFO, "/lilyth/palast/tierhaendler");

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "erscheint, um seine Tiere zu versorgen");
  SetProp(P_MSGOUT, "geht eilig");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Gordrogh");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "starrt Dich eindringlich an.\n",
            "zetert rum: Du weisst auch gar nichts, oder?\n",
            "fragt Dich: Was willst Du eigentlich?!\n"}));

  AddInfo( ({"pudelmuetze", "muetze"}),
    "Die kriegst Du nicht, die gehoert mir!!!",
    "kreischt: ");

  AddInfo( ({"frau", "kinder", "kind", "familie"}),
    "Das geht Dich gar nichts an!",
    "sagt empoert: ");

  AddInfo( ({"gnom", "gnome"}),
    "Hast Du etwa was gegen Gnome?!",
    "zetert: ");

  AddInfo( ({"tiere", "tier", "haustier", "haustiere"}),
    "Willst Du eines kaufen?",
    "starrt Dich an: ");

  AddInfo( ({ "tierhaendler", "tierhandlung" }),
    "Das hier ist meine Tierhandlung!",
    "schnarrt: ");

  AddInfo( ({"zebramaus", "zebramaeuse"}),
    "Davon habe ich fast immer welche auf Lager. Die vermehren sich ja "
    "wie die Karnickel!",
    "schnarrt: ");

  AddInfo( ({"lager"}),
    "Auf der Tafel steht, welche Tiere ich Dir momentan anbieten kann.",
    "brummt: ");

  AddInfo( ({"tafel"}),
    "auf eine Tafel.",
    "deutet ");

  AddInfo( ({"karnickel", "plage"}),
    "Eine regelrechte Plage ist das!",
    "knurrt: ");

  AddInfo( ({"frettchen"}),
    "schweigend auf die Drahtkaefige.",
    "deutet ");

  AddInfo( ({"waschbaer", "waschbaeren"}),
    "Meine Waschbaeren sind noch sehr jung, daher brauchen sie sehr viel "
    "Pflege und Zuwendung. Aber wenn Du einen willst, schau mal in die "
    "Holzkisten dort.",
    "brummt: ");

  AddInfo( ({"holzkisten", "kisten", "holzkiste", "kiste", "drahtkaefig",
  "drahtkaefige", "kaefig", "kaefige", "karton", "kartons"}),
    "Ja, bist Du denn blind? Da stehen sie doch!",
    "zetert: ");

  AddInfo( ({"pflege", "aufwendung"}),
    "Du solltest es Dir gut ueberlegen, wenn Du Dir ein Haustier anschaffen "
    "willst, denn sie brauchen sehr viel Pflege und Zuwendung.",
    "starrt Dich an: ");

  AddInfo( ({"waldkauz", "kauz"}),
    "Der Kauz ist noch ein wenig scheu, da er recht jung ist. Aber wenn "
    "Du ihn gut behandelst, wird er sicherlich schnell Zutrauen zu Dir "
    "fassen.",
    "gruebelt: ");

  AddInfo( ({"zutrauen"}),
    "Tiere spueren es schnell, ob sie Dir vertrauen koennen oder nicht.",
    "schnarrt: ");

  AddInfo( ({"schleiereule", "schleiereulen"}),
    "Die Schleiereule waere doch genau das Richtige fuer Dich. "
    "Sie ist recht pflegeleicht, sieht gut aus, und das Futter ist auch "
    "nicht allzu teuer.",
    "schnarrt: ");

  AddInfo( ({"futter", "tierfutter"}),
    "Wenn Du Dir ein Haustier anschaffen willst, musst Du es regelmaessig "
    "und ausgewogen fuettern. Ich habe fuer jedes meiner Tiere eine "
    "eigene Mischung erstellt. Ich will schliesslich, dass sie sich "
    "wohlfuehlen.",
    "schnarrt: ");

  AddInfo( ({"mischung"}),
    "Niemand stellt so gutes und vollwertiges Tierfutter her wie ich!",
    "behauptet: ");

  AddInfo( ({"eulen", "eule"}),
    "Eulen sind eigentlich recht pflegeleicht. Vielleicht genau das "
    "Richtige fuer Dich.",
    "mustert Dich: ");

  AddInfo( ({"wolfshund", "hund"}),
    "Den gebe ich nur ungerne her. Irgendwie mag ich ihn, obwohl er den "
    "ganzen Tag lang nur faul in der Ecke rumliegt, anstatt nervige "
    "Besucher wie Dich zu verscheuchen.",
    "schnarrt: ");

  AddInfo( ({"ecke"}),
    "stumm in eine dunkle Ecke.",
    "deutet ");

  AddInfo( ({"besucher"}),
    "Die koennen ganz schoen nervig sein!",
    "knurrt missmutig: ");

  AddInfo( ({"schwarzbaer", "baer"}),
    "Der ist jetzt im Hinterzimmer, weil er frueher immer die Besucher "
    "abgeschreckt hat.",
    "schnarrt: ");

  AddInfo( ({"hinterzimmer", "zimmer", "hintertuer", "tuer"}),
    "Da kommst Du nicht rein!",
    "schreit: ");

  AddInfo( ({"varaile"}),
    "Die findest Du im Obergeschoss.",
    "schnarrt: ");
    
//-------------------------------------------------------------------------

  AddInfo( ({"silberland"}),
    "Du befindest Dich im Silberland.",
    "schnarrt: ");

  AddInfo( ({ "palast" }),
  "rundherum.",
  "deutet ");

  AddInfo( ({"yoshy", "hund", "katze"}),
  "Dich missmutig an.",
  "starrt ");

  AddInfo( ({"fischhaendler"}),
  "Ich mag keinen Fisch, daher interessiert es mich nicht, ob es hier "
  "einen Fischhaendler gibt oder nicht.",
  "schnarrt: ");

  AddInfo( ({"fisch"}),
  "angewidert die Nase.",
  "ruempft ");

  AddInfo( ({"obstverkaeufer"}),
  "Obstverkaeufer? Siehst Du hier irgendwo einen Obstverkaeufer? Nein? "
  "Na, warum fragst Du mich dann?!!",
  "zetert: ");

  AddInfo( ({"trollwaechter", "waechter"}),
  "Die bewachen den Palast.",
  "brummt: ");

  AddInfo( ({"kobold", "brunnen"}),
  "Oh, Du meinst sicher meinen Cousin! Der ist im Untergeschoss beim "
  "Brunnen.",
  "schnarrt: ");

  AddInfo( ({"cousin"}),
    "Er ist mein Cousin muetterlicherseits. Er ist eigentlich ganz in "
    "Ordnung, auch wenn ich einfach nicht begreifen kann, wie meine "
    "Grossmutter einen Kobold heiraten konnte!",
    "knurrt: ");

  AddInfo( ({"grossmutter"}),
    "Meine Grossmutter stammte aus einer ehrbaren Gnomfamilie, und dann "
    "geht sie einfach hin und sucht sich diesen... diesen... KOBOLD aus, "
    "der sie doch nur des Goldes wegen geheiratet hat!",
    "zetert: ");

  AddInfo( ({"kobolde"}),
    "Ich mag keine Kobolde. Punktum. Auch wenn mein Cousin einer ist.",
    "verschraenkt seine Arme: ");

  AddInfo( ({"gold"}),
    "Pah, er hat sie doch nicht wirklich geliebt! Er wollte nur das viele "
    "Gold, das unserer Familie schon seit Jahrhunderten rechtmaessig "
    "gehoerte, mehr nicht!",
    "knurrt: ");

  AddInfo( ({"jahrhunderte", "jahrhundert", "gnomfamilien", "gnomfamilie"}),
    "Meine Familie ist eine der aeltesten Gnomfamilien im ganzen "
    "Silberland!",
    "prahlt: ");

  AddInfo( ({"linah", "tungdil", "thimon", "konditor", "konditorei"}),
    "Nun frag mich doch nicht dauernd sowas! Schau Dich lieber mal "
    "genauer im Palast um!",
    "knurrt: ");

  AddInfo( ({"velg'larn", "velglarn"}),
    "Sein Laden befindet sich im Untergeschoss.",
    "schnarrt: ");

  AddInfo( ({"ceyth", "bogenhaendler"}),
  "Den Bogenhaendler findest Du hier oben nicht.",
  "knurrt: ");

  AddInfo( ({"bogenladen", "schreinerei"}),
  "Guck doch mal im Untergeschoss nach!",
  "brummt: ");

  AddInfo( ({"fredolin", "schreiner", "schreinerei"}),
  "Den Schreiner findest Du im Untergeschoss. Und jetzt stoer mich nicht "
  "laenger, ich habe zu arbeiten!",
  "schnarrt: ");

  AddInfo( ({"soldat", "soldaten"}),
  "Die Soldaten sollten dafuer sorgen, dass Gaeste wie Du mich nicht "
  "dauernd stoeren.",
  "zetert: ");

  AddInfo( ({"kartenzeichnerin", "zeichnerin", "alenari"}),
  "Alenari findest Du irgendwo hier in diesem Geschoss.",
    "schnarrt: ");

  AddInfo( ({"kellnerin", "teestube"}),
  "Die Teestube ist hier oben in diesem Geschoss.",
    "schnarrt: ");

  AddInfo( ({"mahmud", "geschichtenerzaehler"}),
  "Mahmud findest Du im Obergeschoss.",
    "brummt: ");

  AddInfo( ({"kinder"}),
  "Die kleinen Goeren sind meistens oben bei Mahmud.",
    "schnarrt: ");

  AddInfo( ({"goeren", "unsinn"}),
  "Pah, Kinder haben doch nur Unsinn im Kopf!",
    "zetert: ");

  AddInfo( ({"untergeschoss"}),
    "Das liegt weiter unten.",
    "sagt: ");

  AddInfo( ({"mittelgeschoss"}),
    "Da befindest Du Dich gerade.",
    "sagt: ");

  AddInfo( ({"obergeschoss"}),
    "Das liegt weiter oben.",
    "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

  AddSpell(5,350,
    Name(WER, 1)+" schubst Dich gegen die Ladentheke.\n",
    Name(WER, 1)+" schubst @WEN gegen die Ladentheke.\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(3,250,
    Name(WER, 1)+" zerkratzt Dein Gesicht mit seinen spitzen Fingernaegeln.\n",
    Name(WER, 1)+" zerkratzt @WESSEN Gesicht mit seinen spitzen Fingernaegeln.\n",
    DT_RIP,([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(4,
  ({Name(WER, 1)+" beobachtet Dich misstrauisch.\n",
    Name(WER, 1)+" fuettert eines der Tiere.\n",
    Name(WER, 1)+" wuehlt in einer Schublade herum.\n",
    Name(WER, 1)+" kratzt sich nachdenklich an seiner Nasenspitze.\n",
    Name(WER, 1)+" spricht leise mit sich selbst.\n",
    Name(WER, 1)+" murmelt etwas vor sich hin.\n",
    Name(WER, 1)+" verschwindet kurz durch eine Hintertuer und erscheint "
    "gleich darauf wieder.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" bewirft Dich mit Tierfutter.\n",
    Name(WER, 1)+" zetert laut herum.\n",
    Name(WER, 1)+" schreit seinen Wolfshund an: Los, fass! Beiss!\n",
    BS(Name(WER, 1)+" pruegelt mit seinen kleinen Faeusten auf Dich ein.\n") }));

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME("/p/armour/helm/pudelmuetze");
  command("trage alles");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt Gordrogh.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": ""Gordrogh hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "starrt Dich an.",
        "starrt "+TP->name(WEN)+" an.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "schmollt beleidigt.",
        "schmollt beleidigt.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "schnarrt: Kauf lieber was!",
        "schnarrt: Kauf lieber was!");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "schreit: Lass das sofort sein!",
        "schreit: Lass das sofort sein!");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "deutet auf die Kaefige und knurrt: Kauf was oder geh wieder!",
        "deutet auf die Kaefige und knurrt: Kauf was oder geh wieder!");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "piekst Dich mit seinen langen Fingern in die Seite.",
        "piekst "+TP->name(WEN)+" mit seinen langen Fingern in die Seite.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "kreischt laut: Hey, ich habe Frau und Kinder!",
        "kreischt laut: Hey, ich habe Frau und Kinder!");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "gruebelt vor sich hin.",
        "gruebelt vor sich hin.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "runzelt die Stirn.",
        "runzelt die Stirn.");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "grinst haemisch.",
        "grinst haemisch.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}
