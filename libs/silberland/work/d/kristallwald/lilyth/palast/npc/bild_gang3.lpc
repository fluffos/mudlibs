#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Gemaelde");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({ "mann", "gemaelde", "NOT_LIVING" }));
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(1);

  SetProp(P_HANDS, ({" mit bildlicher Kraft"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })  );

  SetProp(P_RACE, "Gemaelde");
  SetProp(P_SIZE, 400);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NOATTACK, "kann nicht angegriffen werden!");
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_LOG_INFO, "/lilyth/palast/gemaelde");

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "erscheint an der Wand");
  SetProp(P_MSGOUT, "verschwindet ploetzlich spurlos");
  SetProp(P_MMSGIN, "erscheint an der Wand");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich spurlos");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Ein Gemaelde");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "haengt stumm an der Wand.\n",
            "weiss darauf keine Antwort.\n",
            "schweigt vor sich hin.\n"}));

  AddInfo( ({"wald", "tethyrwald"}),
    "Als die vielen Opfer, die in den Kaempfen und Schlachten verwundet "
    "wurden, sahen, dass es in den Strassen der Stadt keine Hoffnung fuer "
    "sie gab, blieben sie im Wald. Und dort, auf einer kleinen Lichtung, "
    "fanden sie die Ruhe und die Kraft, die sie zur Heilung brauchten.",
    "sagt: ");

  AddInfo( ({"ruhe", "abgeschiedenheit"}),
    "Der Wald gab ihnen die Ruhe und Abgeschiedenheit, die sie brauchten.",
    "sagt: ");

  AddInfo( ({"pflanzen", "blau", "farbe", "baeume", "blaetter"}),
    "Die Pflanzen, die im Tethyrwald wachsen, haben keine gewoehnliche "
    "Farbe. Sie sind leuchtend blau.",
    "sagt: ");

  AddInfo( ({"lichtung", "waldlichtung", "sammelplatz"}),
    "Die Waldlichtung wurde schon bald zu einem Sammelplatz fuer all die "
    "vielen Verwundeten des Krieges. Dort konnten sie in der Ruhe und "
    "Abgeschiedenheit des Waldes geheilt und mit neuem Mut wieder in den "
    "Kampf geschickt werden.",
    "sagt: ");

  AddInfo( ({"mut", "kraft"}),
    "Sie hatten ihren Mut fast voellig verloren, doch der Wald gab ihnen "
    "neue Kraft.",
    "sagt: ");

  AddInfo( ({"frau", "heilerin"}),
    "Sie war eine Heilerin aus Avir, die dem Ruf ihres Schicksals in "
    "den Wald hinein folgte.",
    "sagt: ");

  AddInfo( ({"ruf", "schicksal"}),
    "Es war ihr Schicksal.",
    "sagt: ");

  AddInfo( ({"heiler"}),
    "Einige von ihnen blieben in der Stadt, um den Menschen dort Beistand "
    "zu leisten, doch viele folgten den Verletzten in den Wald, wo die "
    "Hoffnung auf Heilung groesser war.",
    "sagt: ");

  AddInfo( ({"staedte", "stadt", "avir", "strassen", "strasse"}),
    "Die Strassen von Avir, die von unzaehligen Verletzen und auch Toten "
    "ueberquollen, wurden langsam leerer, und die Menschen schoepften "
    "neue Hoffnung.",
    "sagt: ");

  AddInfo( ({"hoffnung"}),
    "Langsam bekamen die Menschen wieder Hoffnung und fassten neuen Mut.",
    "sagt: ");

  AddInfo( ({"verletzte", "verletzten", "tote", "toten", "verwundete",
  "verwundeten", "opfer"}),
    "Viele wurden in den Kaempfen verletzt.",
    "sagt: ");

  AddInfo( ({"gruppe", "menschen", "lager"}),
    "Anfangs war es nur eine kleine Gruppe von Menschen, die sich in den "
    "Wald zurueckzog, um dort ihre Verletzungen zu kurieren. Doch schon "
    "bald folgten weitere, und die Lichtung wuchs langsam zu einem "
    "immer groesser werdenden Lager heran, das die vielen Verletzten "
    "aus den Staedten aufnahm.",
    "sagt: ");

  AddInfo( ({"kaempfe", "kampf", "krieg", "kriege", "schlacht",
    "schlachten"}),
    "Sie waren schrecklich.",
    "sagt: ");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------



//--Funktionen-------------------------------------------------------------

//Wegwerf-Meldung unterdruecken:
void give_notify(object was)
{
        write(BS("Du kannst dem Gemaelde nichts geben und legst "
        +""+was->name()+" stattdessen auf dem Boden ab.\n"));

        ENV(TO)->Message(BS(TP->Name(WER, 1)+" legt "+was->name()+" auf "
        +"dem Boden ab."),
  	MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        was->move(ENV(TO), M_SILENT|M_PUT);
        return;
}
