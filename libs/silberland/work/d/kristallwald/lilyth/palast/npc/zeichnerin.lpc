#include "../def.h"
#include <combat.h> 

inherit "std/npc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------

int ausweichen;

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  ausweichen = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Alenari, die Kartenzeichnerin");
  SetProp(P_LONG,
    "Alenari ist eine kleine Fee mit hellroten Haaren, violetten Augen "
    "und einer riesigen Brille auf der Nase. Sie schwebt ueber einem "
    "grossen Tisch, auf dem zahlreiche Papiere und Pergamente "
    "ausgebreitet sind, und malt ab und zu ein paar feine Linien auf eines "
    "der Blaetter.");

  AddDetail( ({ "haar", "haare" }),
    "Sie hat hellrote, glaenzende Haare, die bis knapp ueber ihre Schultern "
    "reichen.");

  AddDetail( ({ "schulter", "schultern" }),
    "Ihre Haare sind gerade schulterlang.");

  AddDetail( ({ "auge", "augen" }),
    "Ihre seltsamen, violetten Augen sind konzentriert auf die zahlreichen "
    "Pergamente vor ihr gerichtet.");

  AddDetail( ({ "brille", "gegensatz" }),
    "Im Gegensatz zu ihrem kleinen Gesichtchen wirkt die Brille "
    "riesengross.");

  AddDetail( ({ "gesicht", "gesichtchen" }),
    "Sie hat ein huebsches, fein geschnittenes Gesicht, das zum Teil "
    "jedoch von der riesigen Brille verdeckt wird, die sie traegt.");

  AddDetail( ({ "nase" }),
    "Sie hat eine viel zu grosse Brille auf ihrer Nase sitzen.");

  AddDetail( ({ "tisch", "papier", "papiere", "pergament", "pergamente",
  "blatt", "blaetter" }),
    "Auf dem grossen Tisch unter ihr sind zahlreiche Blaetter "
    "ausgebreitet.");

  AddDetail( ({ "linie", "linien" }),
    "Ab und zu malt sie auf einem der Pergamente herum und kritzelt feine "
    "Linien darauf.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Alenari");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"kartenzeichnerin", "zeichnerin", "alenari", "fee", "NOWIMPY"}));
  AddClass( ({CL_FAIRY}) );
  SetProp(P_ARTICLE, 0);

  set_living_name("alenari");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(17);

  SetProp(P_HANDS, ({ " mit Feenmagie", 170, ({DT_MAGIC, DT_BLUDGEON}) }) );

  SetProp(P_RACE, "Fee");
  SetProp(P_SIZE, 62);
  SetProp(P_WEIGHT, 20000);
  SetProp(P_ALIGN, 600);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" fragt: Was soll ich damit?\n" }) );

  SetProp(P_LOG_INFO, "/lilyth/palast/zeichnerin");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_AIR:      -0.3,
       DT_TERROR:    0.5,
       DT_HOLY:     -0.2,
       DT_UNHOLY:    0.2,
       DT_MAGIC:    -0.2 ]));

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Eine Kartenzeichnerin");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "mustert Dich durch ihre Brille hindurch.\n",
            "ist gerade viel zu konzentriert, um Dir zuzuhoeren.\n",
            "denkt kurz nach: Hm, das weiss ich leider nicht.\n"}));

  AddInfo( ({"karten", "karte", "staedte", "stadt", "region", "regionen"}),
    "Mit 'zeige' siehst Du, welche Karten ich bereits fertiggestellt habe "
    "und zum Verkauf bereitstehen. ",
    "laechelt: ");

  AddInfo( ({"kartenzeichnerin", "zeichnen", "zeichnerin"}),
    "Ich zeichne bereits seit einigen Jahren Karten von allen Regionen "
    "des Silberlandes. Frueher hab ich das nur fuer mich selbst gemacht, "
    "weil ich immer ueberall verlaufen habe. Aber nachdem mich meine "
    "Freunde und Bekannten immer wieder darum gebeten haben, habe ich "
    "mich nun dazu entschlossen, sie zu verkaufen.",
    "sagt: ");

  AddInfo( ({"silberland", "land"}),
    "Das Silberland ist sooo gross und weit, da kann man sich schnell mal "
    "verlaufen.",
    "seufzt: ");

  AddInfo( ({"freunde", "bekannte"}),
    "Sie haben mich dazu ueberredet, mich hier niederzulassen und meine "
    "Karten an die vielen Abenteurer zu verkaufen, die durch das Land "
    "streifen.",
    "sagt: ");

  AddInfo( ({"abenteurer"}),
    "Nun, Du bist doch auch schon recht weit gekommen.",
    "mustert Dich kurz: ");

  AddInfo( ({"unterwelt", "kristallwald", "wueste", "gebirge", "ebene",
  "huegelland", "dschungel", "polar"}),
    "Ja, ich glaube, davon habe ich auch irgendwo eine Karte.",
    "denkt nach: ");

  AddInfo( ({"feenschloss"}),
    "Da komme ich her.",
    "zwinkert: ");

  AddInfo( ({"fee", "fluegel", "feenfluegel"}),
    "mit ihren Fluegeln.",
    "flattert ");

  AddInfo( ({"papier", "papiere", "zettel", "stapel", "pergament", 
  "pergamente", "notizen", "zettelchen", "tinte", "tintenfass"}),
    "Das brauche ich alles fuer meine Arbeit.",
    "sagt: ");

  AddInfo( ({"arbeit"}),
    "Ich bin eine Kartenzeichnerin!",
    "sagt stolz: ");

  AddInfo( ({"strasse", "strassen"}),
    "nur.",
    "seufzt ");

//--------------------------------------------------------------------------

  AddInfo( ({"palast"}),
    "Ich bin noch nicht sehr lange hier. Mir gefaellt es im Feenschloss "
    "eigentlich viel besser, aber hier kann ich wenigstens meine Karten "
    "verkaufen.",
    "sagt: ");

  AddInfo( ({"yoshy", "hund"}),
    "Yoshy ist ein Hund, der meistens draussen irgendwo herumlaeuft. "
    "Ich habe ein wenig Angst vor ihm, seitdem er mir einmal fast meinen "
    "linken Fluegel zerrissen hat.",
    "sagt: ");

  AddInfo( ({"angst"}),
    "Naja, er ist doch so viel groesser als ich!",
    "zittert: ");

  AddInfo( ({"katze"}),
    "Die Katze findest Du irgendwo draussen vor dem Palast.",
    "sagt: ");

  AddInfo( ({"fischhaendler", "fisch"}),
    "Den Fischhaendler findest Du draussen vor dem Palast.",
    "sagt: ");

  AddInfo( ({"obstverkaeufer", "obst"}),
    "Den Obstverkaeufer findest Du draussen vor dem Palast.",
    "sagt: ");

  AddInfo( ({"trollwaechter", "waechter"}),
    "Die sind draussen vor dem Palast und bewachen das Eingangsportal.",
    "sagt: ");

  AddInfo( ({"portal", "eingangsportal"}),
    "Das grosse Eingangsportal zum Palast wird von Trollwaechtern "
    "bewacht.",
    "erklaert: ");

  AddInfo( ({"kobold", "brunnen"}),
    "Der ist im Untergeschoss.",
    "sagt: ");
  
  AddInfo( ({"linah", "koechin", "kueche"}),
    "Linah findest Du unten im Untergeschoss.",
    "sagt: ");
  
  AddInfo( ({"tungdil", "schmied", "schmiede"}),
    "Den findest Du irgendwo im Untergeschoss.",
    "sagt: ");

  AddInfo( ({"velg'larn", "velglarn"}),
    "Sein Laden befindet sich im Untergeschoss. Aber ich war dort noch nie "
    "drin.",
    "erbleicht: ");

  AddInfo( ({"ceyth", "bogenhaendler"}),
    "Ceyth findest Du irgendwo unten im Untergeschoss. Er ist der "
    "Bogenhaendler hier.",
    "sagt: ");

  AddInfo( ({"bogenladen"}),
    "Der befindet sich im Untergeschoss.",
    "sagt: ");

  AddInfo( ({"fredolin", "schreiner", "schreinerei"}),
    "Die Schreinerei befindet sich im Untergeschoss.",
    "sagt: ");

  AddInfo( ({"soldat", "soldaten"}),
    "Die Soldaten sorgen fuer die Sicherheit der Gaeste und Besucher des "
    "Palastes.",
    "sagt: ");

  AddInfo( ({"sicherheit"}),
    "Hier im Palast befindest Du Dich in Sicherheit.",
    "behauptet: ");

  AddInfo( ({"tierhaendler", "gordrogh"}),
    "Der befindet sich ganz hier in der Naehe.",
    "sagt: ");

  AddInfo( ({"kellnerin", "teestube"}),
    "Die Teestube ist hier oben in diesem Geschoss.",
    "sagt: ");

  AddInfo( ({"mahmud", "geschichtenerzaehler"}),
    "Mahmud findest Du im Obergeschoss.",
    "sagt: ");

  AddInfo( ({"kinder"}),
    "Die Kinder sind meistens oben bei Mahmud.",
    "sagt: ");

  AddInfo( ({"varaile"}),
    "Varaile findest Du oben im Obergeschoss. Sie hat dort einen tollen "
    "Laden!",
    "zwinkert: ");

  AddInfo( ({"thimon", "konditorei"}),
    "Die Konditorei befindet sich im Obergeschloss.",
    "sagt: ");

  AddInfo( ({"geschoss"}),
    "Welches Geschoss meinst Du denn jetzt?",
    "fragt: ");

  AddInfo( ({"untergeschoss"}),
    "Das liegt weiter unten.",
    "sagt: ");

  AddInfo( ({"mittelgeschoss"}),
    "Das liegt weiter unten.",
    "sagt: ");

  AddInfo( ({"obergeschoss"}),
    "Da befindest Du Dich gerade.",
    "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,50);

  AddSpell(4,1,
    Name(WER, 1)+" weicht Dir flink aus.\n",
    Name(WER, 1)+" weicht @WEM flink aus.\n",
    DT_MAGIC, "take_over");

  AddSpell(2,270,
    Name(WER, 1)+" piekst Dich mit einem spitzen Stift!\n",
    Name(WER, 1)+" piekst @WEN mit einem spitzen Stift!\n",
     DT_WATER,([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(3,1,DS_ANTIMAGIC,
    Name(WER, 1)+" hindert Dich daran, Deine Magie zu nutzen.\n",
    "@WER wird von Alenari am Zaubern gehindert.\n", 3);

//--Chats------------------------------------------------------------------

  SetChats(5,
  ({Name(WER, 1)+" rueckt ihre Brille gerade.\n",
    Name(WER, 1)+" beugt sich ueber ein grosses Blatt Pergament.\n",
    Name(WER, 1)+" runzelt nachdenklich die Stirn.\n",
    Name(WER, 1)+" spitzt eine Feder an.\n",
    Name(WER, 1)+" kritzelt auf einem Stueck Pergament herum.\n",
    Name(WER, 1)+" verschuettet ein wenig Tinte und flucht leise.\n",
    Name(WER, 1)+" murmelt etwas von Staedten und Fluessen.\n",
    Name(WER, 1)+" flattert ein wenig mit ihren Fluegeln.\n",
    BS(Name(WER, 1)+" denkt   . o O (Verlief die Strasse nicht weiter "
    +"oestlich?)\n") }));

  SetAttackChats(10,
  ({Name(WER, 1)+" flattert blitzschnell um Dich herum.\n",
    Name(WER, 1)+" bespritzt Dich mit Tinte.\n",
    Name(WER, 1)+" murmelt ein paar magische Worte.\n" }));

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME(ARMOUR "brille");
  command("trage alles");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt eine Kartenzeichnerin.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "blickt Dich verwundert an.",
        "blickt "+TP->name(WEN)+" verwundert an.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "klopft Dir warnend mit ihrer Feder auf die Finger.",
        "klopft "+TP->name(WEM)+" warnend mit ihrer Feder auf die Finger.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "kichert albern.",
        "kichert albern.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "seufzt: Warum bist Du so auf Aerger aus?",
        "seufzt: Warum bist Du so auf Aerger aus?");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "sagt: Hey, lass das!",
        "sagt: Hey, lass das!");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "zwinkert Dir froehlich zu.",
        "zwinkert "+TP->name(WEM)+" froehlich zu.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt empoert: Also fuer SO etwas habe ich jetzt keine Zeit!",
        "sagt empoert: Also fuer SO etwas habe ich jetzt keine Zeit!");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "nickt Dir freundlich zu.",
        "nickt "+TP->name(WEM)+" freundlich zu.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "mustert Dich kurz unter ihrer Brille hindurch.",
        "mustert "+TP->name(WEN)+" kurz unter ihrer Brille hindurch.");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich laechelnd.",
        "troestet "+TP->name(WEN)+" laechelnd.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Ausweichzauber:
void take_over(object enemy,int damage,string damtype)
{
        if(!ausweichen)
        {
                ausweichen = 3+random(5);
        }
        return;
}

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  if (ausweichen)
  {
        ausweichen--;
        return ::Defend(0, dam_type, spell, enemy);
  }
  return ::Defend(dam, dam_type, spell, enemy);
}
