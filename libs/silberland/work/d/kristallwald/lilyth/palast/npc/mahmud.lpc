#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";
inherit "/d/kristallwald/lilyth/palast/npc/seq/sm";

//--Variablen&Defines------------------------------------------------------

int fktpuck();
int fktpferd();
int fktirrlicht();
void set_back(object who);

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Mahmud, der Geschichtenerzaehler");
  SetProp(P_LONG,
    "Mahmud ist ein liebenswuerdiger aelterer Herr mit schneeweissem Haar. "
    "Er liebt Kinder ueber alles und erzaehlt ihnen im Palast den ganzen "
    "Tag lang viele Maerchen oder Geschichten, die er frueher auf seinen "
    "Reisen gehoert oder erlebt hat. Er sieht ein wenig traurig aus.");

  AddDetail( ({ "herr" }),
    "Mahmud ist ein liebenswuerdiger aelterer Herr. Sein Gesicht ist mit "
    "vielen duennen Faeltchen ueberzogen, doch seine leuchtenden blauen "
    "Augen verraten Dir, dass dieser Mann aeusserlich wesentlich aelter "
    "aussieht, als er eigentlich ist");

  AddDetail( ({ "gesicht" }),
    "Sein Gesicht ist mit unzaehligen duennen Faeltchen ueberzogen.");

  AddDetail( ({ "faeltchen", "falten", "falte" }),
    "Unzaehlige Faeltchen ueberziehen Mahmuds Gesicht.");

  AddDetail( ({ "augen", "auge" }),
    "Mit seinen leuchtenden blauen Augen sieht Mahmud Dich gutmuetig an.");

  AddDetail( ({ "haar", "haare" }),
    "Sein Haar ist schneeweiss.");

  AddDetail( ({ "kinder" }),
    "Er liebt Kinder mehr als alles andere.");

  AddDetail( ({ "palast" }),
    "Mahmud hat sich vor einiger Zeit hier im Palast niedergelassen und "
    "geniesst es sehr, den Kindern seine zahlreichen Geschichten zu "
    "erzaehlen.");

  AddDetail( ({ "geschichten", "geschichte", "maerchen", "abenteuer" }),
    "Auf seinen Reisen hat Mahmud viele interessante Abenteuer erlebt und "
    "vieles gehoert.");

  AddDetail( ({ "reisen", "reise" }),
    "Bevor er sich im Palast niedergelassen hat, hat Mahmud viele Reisen in "
    "ferne Laender und Kontinente unternommen.");

  AddDetail( ({ "land", "laender", "kontinent", "kontinente", "gegend", 
  "gegenden" }),
    "Mahmud kann Dir sicherlich viel ueber die fernen Gegenden erzaehlen, "
    "die er frueher bereist hat.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Mahmud");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"mahmud", "geschichtenerzaehler", "erzaehler", "mensch", "mann"}));
  AddClass( ({CL_HUMAN}) );
  SetProp(P_ARTICLE, 0);

  set_living_name("mahmud");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(17);

  SetProp(P_HANDS, ({ " mit seinen Haenden", 170, DT_BLUDGEON }) );

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 178);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" fragt verdutzt: Was soll ich damit?\n" }) );
  
  SetProp(P_LOG_INFO, "/lilyth/palast/mahmud");

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "schlurft langsam herein");
  SetProp(P_MSGOUT, "schlurft langsam");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Hat Dir meine Geschichte nicht gefallen?");
  SetProp(P_KILL_NAME, "Ein Geschichtenerzaehler");
  SetProp(P_KILL_MSG, "Jetzt kannst Du Deine Geschichte Lars erzaehlen!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "gruebelt vor sich hin.\n",
            "zwinkert Dir zu.\n",
            "sagt: Das kann ich Dir leider nicht sagen.\n"}));

//-------------------------------------------------------------------------

  AddInfo( ({"reise", "reisen", "laender", "gegenden", "abenteuerlust"}),
    "Frueher, als ich noch so jung war wie Du, bin ich viel durch das "
    "ganze Land gereist. Ich habe recht viel von der Welt gesehen und kann "
    "Dir sicher einiges darueber berichten.",
    "sagt: ");

  AddInfo( ({"midas", "heimatstadt", "heimat"}),
    "Midas ist meine Heimatstadt. Ich habe viele lange Jahre dort "
    "verbracht, bis mich die Abenteuerlust packte und ich anfing, auf "
    "Reisen zu gehen.",
    "laechelt: ");

  AddInfo( ({"jahre"}),
    "Ich habe viele Jahre dort gelebt.",
    "laechelt: ");

  AddInfo( ({"derlim", "hobbingen", "huegelland"}),
    "Oft bin ich auf meinen Reisen in diese schoene Gegend gekommen, und "
    "immer tat es mir leid, sie wieder verlassen zu muessen. Die Halblinge, "
    "oder auch Hobbits, wie man sie nennt, sind wirklich sehr freundlich "
    "und einem froehlichen, geselligen Abend niemals abgeneigt.",
    "laechelt: ");

  AddInfo( ({"halblinge", "hobbits"}),
    "Sie sind sehr gastfreundlich und haben mich stets gern bei sich "
    "aufgenommen.",
    "laechelt: ");

  AddInfo( ({"abend", "abendessen"}),
    "Nichts geht doch ueber ein gemuetliches Abendessen mit guten "
    "Freunden.",
    "sagt froehlich: ");

  AddInfo( ({"freunde"}),
    "Es ist wichtig, gute Freunde zu haben.",
    "sagt: ");

  AddInfo( ({"elessar"}),
    "Oft, wenn ich von einer beschwerlichen Reise wiederkam, bin ich in "
    "dem schoenen Elfendorf eingekehrt und habe mich dort von den Strapazen "
    "erholt. Allerdings war ich jetzt schon eine ganze Weile lang nicht "
    "mehr dort.",
    "laechelt: ");

  AddInfo( ({"elfendorf"}),
    "Das Dorf, in dem die Elfen leben, heisst Elessar. Es liegt in der "
    "Naehe des Kristallwaldes.",
    "sagt: ");

  AddInfo( ({"elfen", "elf", "elfe"}),
    "Ich mag die Elfen sehr gerne. Sie waren immer freundlich zu mir.",
    "laechelt: ");

  AddInfo( ({"naehe"}),
    "Es liegt ganz in der Naehe.",
    "bestaetigt: ");

  AddInfo( ({"kristallwald"}),
    "Der Kristallwald liegt noerdlich des Huegellandes. Dort ganz in der "
    "Naehe findest Du auch das Elfendorf Elessar. Es ist eine sehr "
    "schoene Gegend.",
    "sagt: ");

  AddInfo( ({"felonia"}),
    "Die Stadt der Zwerge liegt unter dem harten Fels des Gebirges und "
    "ist nicht ganz leicht zu finden.",
    "sagt laechelnd: ");

  AddInfo( ({"gebirge"}),
    "Das Gebirge liegt ein wenig noerdlich des Silberwaldes. Es ist eine "
    "ziemlich rauhe Gegend und es gibt viele Woelfe dort.",
    "sagt: ");

  AddInfo( ({"woelfe", "silberwoelfe"}),
    "Sie koennen recht gefaehrlich werden, wenn man nicht achtgibt.",
    "sagt: ");

  AddInfo( ({"fels"}),
    "Die Zwerge lieben das Gebirge und haben es mit viel Geschick zu einem "
    "grossen Teil unterhoehlt. Dort in den dunklen Stollen fuehlen sie sich "
    "richtig wohl.",
    "laechelt: ");

  AddInfo( ({"geschick"}),
    "Die meisten Zwerge sind sehr geschickt.",
    "bestaetigt: ");

  AddInfo( ({"stollen"}),
    "Ich fuehle mich immer ein wenig eingeengt dort unten, aber die Zwerge "
    "fuehlen sich dort so richtig zuhause.",
    "sagt: ");

  AddInfo( ({"zwerge", "zwerge"}),
    "Die meisten Zwerge sind sehr freundlich, wenn sie erstmal ihren "
    "Argwohn Fremden gegenueber ueberwunden haben. Ich habe einige gute "
    "Freunde unter ihnen gefunden.",
    "laechelt: ");

  AddInfo( ({"argwohn", "fremde"}),
    "Viele Zwerge sind Fremden gegenueber ein wenig... nun ja, stur, "
    "moechte man fast sagen. Doch wenn man sie erst ein wenig naeher "
    "kennengelernt hat, kann man sehr gut mit ihnen auskommen.",
    "erklaert: ");

  AddInfo( ({"trolle", "troll"}),
    "Die Trolle leben in einem kleinen Lager mitten im Gebirge.",
    "sagt: ");

  AddInfo( ({"lager", "trolllager"}),
    "Wenn Du das Trolllager meinst: das findest Du mitten im Gebirge. Es "
    "wird sehr gut bewacht, also solltest Du Dir dort moeglichst keinen "
    "Aerger einhandeln.",
    "sagt: ");

  AddInfo( ({"aerger"}),
    "Dich mit hochgezogenen Augenbrauen.",
    "mustert ");

  AddInfo( ({"oger"}),
    "Oestlich von Midas leben einige Oger in einem kleinen Waldstueck. "
    "Sie sind ziemlich angriffslustig und fragen meistens nicht erst, "
    "bevor sie Eindringlinge vertreiben.",
    "sagt: ");

  AddInfo( ({"waldstueck"}),
    "Die Oger leben in einem kleinen Waldstueck oestlich von Midas.",
    "sagt: ");

  AddInfo( ({"eindringlinge"}),
    "Sie moegen keine Eindringlinge.",
    "sagt: ");

  AddInfo( ({"untote"}),
    "nur.",
    "erbleicht ");

  AddInfo( ({"dhrkion"}),
    "Dhrkion ist die Stadt der Dunkelelfen, und auch nur solche sollten "
    "sich dorthin wagen.",
    "sagt: ");

  AddInfo( ({"dunkelelfen", "dunkelelf"}),
    "Nun ja, es gibt solche und solche.",
    "sagt ausweichend: ");

  AddInfo( ({"unterwelt"}),
    "Ich war nur ein einziges Mal dort, und das nicht einmal freiwillig. "
    "Es ist sehr gefaehrlich dort unten und es gibt viele boese Geschoepfe, "
    "die nur darauf lauern, ihr Unheil mit jedem zu treiben, der sich "
    "dorthin wagt.",
    "schaudert: ");

  AddInfo( ({"geschoepfe", "unheil"}),
    "Es gibt viele boesartige Geschoepfe in der Unterwelt. Nimm Dich vor "
    "ihnen in acht, wenn Du in die tiefe Dunkelheit hinabsteigst.",
    "sagt eindringlich: ");

  AddInfo( ({"dunkelheit", "finsternis"}),
    "Unten, in den Tiefen der Unterwelt, herrscht ewige Finsternis.",
    "sagt unheilvoll: ");

  AddInfo( ({"tiefe", "tiefen", "erde"}),
    "Die Unterwelt liegt tief unter der Erde.",
    "schaudert: ");

  AddInfo( ({"zombieinsel"}),
    "Um die Zombieinsel habe ich immer einen grossen Bogen gemacht. Man "
    "erzaehlt sich schlimme Dinge von dort.",
    "erschrickt: ");

  AddInfo( ({"bogen"}),
    "Ich war nie dort.",
    "sagt: ");

  AddInfo( ({"dinge"}),
    "Man sagt, wer einmal dort war, kommt meist nicht wieder zurueck!",
    "fluestert: ");

  AddInfo( ({"polar"}),
    "Die eisigen Berge des Kymora-Gebirges liegen in einer wunderschoenen, "
    "eisigen Landschaft. Es ist nicht ungefaehrlich dort, und man sollte "
    "nie die unbarmherzige Kaelte unterschaetzen, die dort herrscht.",
    "sagt: ");

  AddInfo( ({"kymora", "kymora-gebirge", "kymoragebirge", "landschaft",
  "berge"}),
    "Es lohnt sich wirklich, die Gegend dort mal ein wenig genauer zu "
    "erkunden.",
    "beteuert: ");

  AddInfo( ({"kaelte"}),
    "Glaube mir, es ist wirklich SEHR kalt dort!",
    "sagt eindringlich: ");

  AddInfo( ({"smoersky"}),
    "Smoersky ist ein sehr kleines Dorf, das mitten im ewigen Eis liegt. "
    "Es gibt dort eine grosse Eishoehle, doch ich habe sie nie betreten.",
    "gruebelt: ");

  AddInfo( ({"eis", "norden"}),
    "Im hohen Norden herrscht das ewige Eis.",
    "sagt: ");

  AddInfo( ({"eishoehle"}),
    "Ich war noch nie dort drinnen und kann Dir daher leider nicht viel "
    "mehr dazu sagen, ausser dass es vermutlich unwahrscheinlich kalt "
    "dort ist.",
    "bedauert: ");

  AddInfo( ({"yiqanuk"}),
    "Yiqanuk ist ein grosses Xandim-Dorf, das hoch im Norden in einer "
    "eisigen, recht unwirtlichen Gegend liegt. Es ist nicht ganz einfach, "
    "dort hinzugelangen, doch ein Besuch lohnt sich bestimmt auch fuer "
    "Dich.",
    "sagt: ");

  AddInfo( ({"xandim-dorf", "xandim", "xandims", "xandimdorf"}),
    "Die Xandims leben in Yiqanuk.",
    "sagt: ");

  AddInfo( ({"besuch"}),
    "Es ist sicherlich einen Besuch wert.",
    "sagt: ");

  AddInfo( ({"arrakeen"}),
    "Arrakeen ist eine grosse Wuestenstadt. Es lohnt sich, dort einmal "
    "vorbeizuschauen. Doch es ist nicht einfach, dorthin zu gelangen.",
    "sagt: ");

  AddInfo( ({"wuestenstadt"}),
    "Es liegt mitten in der Wueste.",
    "sagt: ");

  AddInfo( ({"wueste"}),
    "Einmal war ich mit einer kleinen Gruppe von Abenteurern dort. Es war "
    "sehr heiss und nicht alle von uns sind wieder zurueckgekehrt. Du "
    "solltest Dir unbedingt etwas gegen die Hitze mitnehmen, wenn Du "
    "vorhast, Dich in die Wueste zu begeben.",
    "sagt: ");

  AddInfo( ({"gruppe", "abenteurer"}),
    "Die Gruppe bestand aus einigen guten Freunden von mir und mir selbst. "
    "Wir haben einige von ihnen verloren.",
    "seufzt: ");

  AddInfo( ({"feenschloss", "schloss"}),
    "Das Schloss der Feen ist ziemlich gross und wirklich sehenswert. "
    "Es liegt westlich von Midas und ist nur mit einem kleinen Boot zu "
    "erreichen.",
    "sagt: ");

  AddInfo( ({"feen", "fee"}),
    "Die Feen leben in einem grossen Schloss westlich von Midas. Sie sind "
    "sehr liebenswuerdige Wesen und haben mir schon so manchen guten "
    "Dienst geleistet.",
    "laechelt: ");

  AddInfo( ({"wesen"}),
    "Sie sind wirklich sehr nett.",
    "bestaetigt: ");

  AddInfo( ({"dienst"}),
    "Sie haben mir schon oft geholfen.",
    "sagt: ");

  AddInfo( ({"boot"}),
    "Wenn Du Dich ein wenig umschaust, wirst Du es sicherlich finden.",
    "sagt: ");

  AddInfo( ({"silberwald"}),
    "Der Silberwald liegt westlich von Midas. Ich gehe gerne dort "
    "spazieren, wenn ich ein wenig Zeit und Ruhe zum Nachdenken brauche.",
    "sagt: ");

  AddInfo( ({"zeit", "ruhe"}),
    "Jeder braucht mal ein wenig Ruhe und Zeit fuer sich selbst.",
    "sagt freundlich: ");

  AddInfo( ({"nachdenken"}),
    "Ich kann am besten nachdenken, wenn ich ein wenig spazieren gehe.",
    "laechelt: ");

  AddInfo( ({"dschungel"}),
    "Der Dschungel birgt so manche Gefahr fuer denjenigen, der unachtsam "
    "und unvorsichtig ist. Doch gibt es auch viele faszierende Sachen dort "
    "zu entdecken.",
    "denkt nach: ");

  AddInfo( ({"gefahr"}),
    "Auch im Dschungel kann Dir die eine oder andere Gefahr begegnen.",
    "warnt: ");

  AddInfo( ({"sachen"}),
    "Im Dschungel gibt es einiges zu entdecken, nicht zuletzt die "
    "Hauptstadt dort, Tijara.",
    "laechelt: ");

  AddInfo( ({"tijara"}),
    "Tijara ist eine grosse Siedlung im Dschungel. Es liegt sehr weit "
    "im Sueden und man kann nur mit dem Schiff dorthin gelangen.",
    "sagt: ");

  AddInfo( ({"siedlung"}),
    "Tijara ist eine grosse Siedlung mitten im Dschungel.",
    "sagt: ");

  AddInfo( ({"schiff", "schiffe"}),
    "Wenn Du mit dem Schiff fahren willst, solltest Du Dich ins "
    "Fischerdorf begeben.",
    "raet: ");

  AddInfo( ({"fischerdorf"}),
    "Suedwestlich von Midas liegt ein kleines Fischerdorf, von dem aus "
    "sehr viele Schiffe in See stechen.",
    "sagt: ");

  AddInfo( ({"see", "meer", "wasser"}),
    "Ich liebe das Meer. Es ist so herrlich, rund um sich herum nur das "
    "blauschimmernde Wasser zu sehen und sich den Wind der weiten Welt um "
    "die Nase wehen zu lassen.",
    "laechelt: ");

  AddInfo( ({"wind"}),
    "Es ist einfach herrlich!",
    "sagt: ");

  AddInfo( ({"sueden"}),
    "Es ist ziemlich warm dort unten.",
    "sagt: ");

  AddInfo( ({"silberland", "land", "welt"}),
    "Das Silberland ist sehr gross.",
    "laechelt freundlich: ");

  AddInfo( ({"palast", "zuhause"}),
    "Der Palast ist mein Zuhause. Hier fuehle ich mich wohl.",
    "erklaert: ");

  AddInfo( ({"yoshy", "hund"}),
    "Yoshy ist ein kleiner Hund, der sich meistens draussen vor dem Palast "
    "aufhaelt.",
    "laechelt: ");

  AddInfo( ({"katze"}),
    "Ja, eine Katze befindet sich draussen vor dem Palast.",
    "gruebelt: ");
    
  AddInfo( ({"fischhaendler", "fisch", "obstverkaeufer", "obst"}),
    "Draussen vor dem Palast findest Du einen Fischhaendler und einen "
    "Obstverkaeufer.",
    "sagt: ");

  AddInfo( ({"trollwaechter", "waechter"}),
    "Die sind draussen vor dem Palast und bewachen das Eingangsportal.",
    "sagt: ");

  AddInfo( ({"portal", "eingangsportal"}),
    "Das grosse Eingangsportal zum Palast wird von Trollwaechtern "
    "bewacht.",
    "erklaert: ");

  AddInfo( ({"kobold", "brunnen"}),
    "Den findest Du im Untergeschoss.",
    "sagt: ");
  
  AddInfo( ({"linah", "koechin", "kueche"}),
    "Linah befindet sich im Untergeschoss. Sie kocht wirklich hervorragend.",
    "laechelt: ");
  
  AddInfo( ({"tungdil", "schmied", "schmiede"}),
    "Die Schmiede ist unten im Untergeschoss.",
    "sagt: ");
  
  AddInfo( ({"velg'larn", "velglarn"}),
    "Sein Laden befindet sich im Untergeschoss.",
    "sagt: ");

  AddInfo( ({"ceyth", "bogenhaendler", "bogenladen"}),
    "Den Bogenhaendler findest Du irgendwo unten.",
    "gruebelt: ");

  AddInfo( ({"fredolin", "schreiner", "schreinerei"}),
    "Die Schreinerei befindet sich unten im Untergeschoss.",
    "sagt: ");

  AddInfo( ({"soldat", "soldaten"}),
    "Die Soldaten sorgen fuer die Sicherheit der Gaeste und Besucher des "
    "Palastes.",
    "sagt: ");

  AddInfo( ({"sicherheit"}),
    "Hier im Palast befindest Du Dich in Sicherheit.",
    "sagt beruhigend: ");

  AddInfo( ({"kartenzeichnerin", "zeichnerin", "alenari"}),
    "Eine Kartenzeichnerin findest Du im Mittelgeschoss.",
    "sagt: ");

  AddInfo( ({"tierhaendler", "gordrogh", "tierhandlung"}),
    "Die Tierhandlung befindet sich im Mittelgeschoss.",
    "sagt: ");

  AddInfo( ({"kellnerin", "teestube"}),
    "Die Teestube befindet sich Mittelgeschoss.",
    "sagt: ");

  AddInfo( ({"kinder"}),
    "Ich habe Kinder sehr gern. Oft lauschen sie meinen Geschichten "
    "und bestuermen mich mit Fragen zu all den Orten, die ich auf meinen "
    "Reisen besucht habe. Sie geben mir das Gefuehl, nicht voellig "
    "wertlos zu sein.",
    "laechelt: ");

  AddInfo( ({"fragen", "frage",}),
    "Was moechtest Du mich denn fragen?",
    "sagt aufmunternd: ");

  AddInfo( ({"ort", "orte", "gegend", "gegenden", "land", "laender"}),
    "Ich habe schon viele Orte und Gegenden auf dieser Welt gesehen.",
    "sagt nachdenklich: ");

  AddInfo( ({"welt"}),
    "Nun, das Silberland meine ich natuerlich.",
    "wundert sich: ");

  AddInfo( ({"reise", "reisen"}),
    "Frueher, als ich noch juenger war, bin ich sehr viel im ganzen Land "
    "umhergereist. Mich haben ferne Laender und die Lebewesen dort immer "
    "fasziniert. Heute bin ich leider zu alt fuer solche Strapazen.",
    "sagt: ");

  AddInfo( ({"lebewesen"}),
    "Es gibt so viele verschiedene Lebewesen im Silberland. Viele habe "
    "ich bereits getroffen, von anderen habe ich nur gehoert.",
    "sagt: ");

  AddInfo( ({"strapazen", "strapaze"}),
    "Reisen koennen sehr anstrengend sein. Aber das hast Du sicherlich "
    "auch schon gemerkt.",
    "schmunzelt: ");

  AddInfo( ({"thimon", "konditor", "konditorei"}),
    "Die Konditorei von Thimon findest Du hier im Norden.",
    "sagt: ");

  AddInfo( ({"spielzimmer"}),
    "laechelnd nach Osten.",
    "deutet ");

  AddInfo( ({"bibliothek"}),
    "Die befindet sich im Westen.",
    "sagt: ");

  AddInfo( ({"varaile"}),
    "Varaile ist ein liebes Maedchen. Ihre Mutter ist schon sehr frueh "
    "gestorben, deshalb habe ich fuer sie gesorgt, solange sie noch "
    "klein war. Sie besitzt einen kleinen Laden hier oben im Palast und "
    "verkauft dort allerlei schoene Dinge.",
    "laechelt: ");

  AddInfo( ({"mutter"}),
    "Ich kannte sie recht gut, sie war eine sehr gute Freundin von mir.",
    "sagt traurig: ");

  AddInfo( ({"freundin"}),
    "Wir haben oft zusammengesessen und uns lange unterhalten. Sie war ein "
    "sehr freundlicher Mensch.",
    "sagt nachdenklich: ");

  AddInfo( ({"mensch", "menschen"}),
    "Wie Du siehst, bin ich ein Mensch.",
    "laechelt: ");

  AddInfo( ({"laden"}),
    "laechelnd nach Sueden.",
    "deutet ");

  AddInfo( ({"dinge"}),
    "Schau doch einfach mal bei ihr rein.",
    "sagt: ");

  AddInfo( ({"untergeschoss", "mittelgeschoss"}),
    "Das liegt weiter unten.",
    "sagt: ");

  AddInfo( ({"obergeschoss"}),
    "Da befindest Du Dich gerade.",
    "sagt: ");

  AddInfo( ({"geschichten", "geschichte", "maerchen", "sage", "sagen"}),
    "Hmm, welche Geschichte moechtest Du denn gerne hoeren? Ich koennte Dir "
    "die Geschichte vom kleinen Puck erzaehlen, das Maerchen vom betrogenen "
    "Irrlicht oder auch die Sage vom geheimnisvollen Wasserpferd.",
    "gruebelt: ");

  AddInfo( ({"puck", "geschichte vom kleinen puck"}),
    #'fktpuck);

  AddInfo( ({"wasserpferd", "sage vom geheimnisvollen wasserpferd"}),
    #'fktpferd);

  AddInfo( ({"irrlicht", "maerchen vom betrogenen irrlicht"}),
    #'fktirrlicht);

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,37);

  AddSpell(1,470,
    Name(WER, 1)+" laesst seinen Gehstock auf Dich niedersausen!\n",
    Name(WER, 1)+" laesst seinen Gehstock auf @WEN niedersausen!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,350,
    Name(WER, 1)+" tritt Dir schmerzhaft vors Schienbein.\n",
    Name(WER, 1)+" tritt @WEM schmerzhaft vors Schienbein.\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,510,
    Name(WER, 1)+" pruegelt mit seinem Gehstock auf Dich ein!\n",
    Name(WER, 1)+" pruegelt mit seinem Gehstock auf @WEN ein!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" schaut den Kindern laechelnd beim Spielen zu.\n",
    Name(WER, 1)+" erzaehlt den Kindern eine Geschichte.\n",
    Name(WER, 1)+" nimmt ein weinendes Kind troestend auf den Schoss.\n",
    Name(WER, 1)+" fragt: Soll ich Dir eine Geschichte erzaehlen?\n",
    Name(WER, 1)+" laechelt Dir zu.\n",
    Name(WER, 1)+" seufzt leise.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" fuchtelt mit seinem Gehstock in der Luft herum.\n",
    Name(WER, 1)+" fragt traurig: Warum tust Du das?\n",
    Name(WER, 1)+" ruft erbost: Tu ja den Kindern nichts!\n" }));

//--Ausruestung------------------------------------------------------------

    SUID;
    CLONEME(WEAPON "gehstock" );
    command("zuecke gehstock");

    CLONEME("/p/armour/boots/lederstiefel");
    CLONEME("/p/armour/trousers/wollhose" );
    CLONEME("/p/armour/cloak/umhang" );
    command("trage alles");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt Mahmud.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "taetschelt Dir belustigt den Kopf.",
        "taetschelt "+TP->name(WEM)+" belustigt den Kopf.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "sagt tadelnd: Sei doch nicht so gemein.",
        "sagt tadelnd: Sei doch nicht so gemein.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "grinst Dich an.",
        "grinst "+TP->name(WEN)+" an.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "droht Dir mit seinem Gehstock.",
        "droht "+TP->name(WEM)+" mit seinem Gehstock.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "schaut Dich stumm an.",
        "schaut "+TP->name(WEN)+" stumm an.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "freut sich mit Dir.",
        "freut sich mit "+TP->name(WEM)+".");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt gutmuetig: Ich bin doch viel zu alt fuer Dich.",
        "sagt gutmuetig: Ich bin doch viel zu alt fuer Dich.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "laechelt Dich an.",
        "laechelt "+TP->name(WEN)+" an.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "schaut Dich nachdenklich an.",
        "schaut "+TP->name(WEN)+" nachdenklich an.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "sagt troestend: Ist doch alles halb so schlimm.",
        "sagt troestend zu "+TP->name(WEM)+": Ist doch alles halb so "
        +"schlimm.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}

//Geschichten:

int fktpuck()
{
   if(find_call_out("NextSequence") != -1)
   {
        write(BS("Aber Mahmud erzaehlt doch gerade eine Geschichte! "
        "Hoer lieber zu!\n"));
        return -1;
   }
   else
   {
        //Chats aus und unangreifbar waehrend des Erzaehlens
        SetChats(0, ({""})); 
        SetProp(P_NOATTACK, "erzaehlt doch gerade eine Geschichte!");
        PALASTMASTER->Msg(TP->Name()+" hoert sich die Geschichte vom "
        +"Puck an.", 2);
        StartSequence(NPC "seq/seqpuck", TP, "set_back");
        return 1;
   }
}

