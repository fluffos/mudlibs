void set_back(object who)
{
  SetChats(3,
  ({Name(WER, 1)+" schaut den Kindern laechelnd beim Spielen zu.\n",
    Name(WER, 1)+" erzaehlt den Kindern eine Geschichte.\n",
    Name(WER, 1)+" nimmt ein weinendes Kind troestend auf den Schoss.\n",
    Name(WER, 1)+" fragt: Soll ich Dir eine Geschichte erzaehlen?\n",
    Name(WER, 1)+" laechelt Dir zu.\n",
    Name(WER, 1)+" seufzt leise.\n" }));
    
