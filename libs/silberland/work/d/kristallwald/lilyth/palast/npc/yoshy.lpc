#include "../def.h"

inherit "std/mnpc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------

int begruessung;

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  begruessung = WEG;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Yoshy, der kleine Hund");
  SetProp(P_LONG,
    "Yoshy ist ein kleiner Hund mit lustigen hochstehenden Ohren und "
    "wuscheligem Fell. Er hat grosse haselnussbraune Augen und eine feuchte "
    "kleine Nase. Treuherzig schaut er Dich an und wedelt froehlich mit dem "
    "Schwanz.");

  AddDetail( ({ "ohren" }),
    "Yoshy hat zwei lustige hochstehende Ohren, wovon das eine "
    "tiefschwarz und das andere erstaunlicherweise schneeweiss ist.");

  AddDetail( ({ "ohr" }),
    "Welches Ohr meinst Du denn?");

  AddDetail( ({ "tiefschwarzes ohr", "linkes ohr" }),
    "Sein linkes Ohr ist tiefschwarz.");

  AddDetail( ({ "schneeweisses ohr", "rechtes ohr", "kontrast" }),
    "Das rechte Ohr ist schneeweiss und bildet einen starken Kontrast "
    "zu dem ansonsten voellig schwarzen Fell.");

  AddDetail( ({ "fell" }),
    "Sein tiefschwarzes Fell glaenzt in der Sonne. Es sieht seidig weich "
    "und sehr gepflegt aus, auch wenn es jetzt gerade ein wenig "
    "verwuschelt ist.");

  AddDetail( ({ "augen" }),
    "Vertrauensvoll blickt der kleine Hund mit seinen grossen "
    "haselnussbraunen Augen zu Dir auf und wedelt mit dem Schwanz.");

  AddDetail( ({ "nase" }),
    "Seine Nase ist ein wenig feucht.");

  AddDetail( ({ "schwanz" }),
    "Yoshy wedelt froehlich mit dem Schwanz.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Yoshy");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({ "yoshy", "hund", "\nyoshy", "FELL_WUSCHEL" }));
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(10);

  SetProp(P_HANDS, ({" mit seinen Pfoten"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })  );

  SetProp(P_RACE, "Hund");
  SetProp(P_SIZE, 37);
  SetProp(P_WEIGHT, 15000);
  SetProp(P_ALIGN, 350);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NOATTACK, "springt geschickt aus Deiner Reichweite.");
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "laeuft froehlich wedelnd herein");
  SetProp(P_MSGOUT, "laeuft aufgeregt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, ({ ROOM "vorhof" }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "vorhof_a1");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Yoshy");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "legt seinen Kopf schief.\n",
            "will gestreichelt werden.\n",
            "winselt leise.\n"}));

  AddInfo("lilyth", "wedelt freudig mit dem Schwanz.");
  AddInfo("torian", "WUFF!! WUFF!!","bellt aufgeregt: ");

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" wedelt froehlich mit dem Schwanz.\n",
    Name(WER, 1)+" bellt aufgeregt.\n",
    Name(WER, 1)+" schnueffelt ruhelos auf dem Boden herum.\n",
    Name(WER, 1)+" springt um Dich herum.\n",
    Name(WER, 1)+" winselt leise.\n",
    Name(WER, 1)+" knabbert spielerisch an Deinem Hosenbein herum.\n",
    Name(WER, 1)+" haelt seine Nase witternd in die Luft.\n",
    Name(WER, 1)+" stellt aufmerksam seine Ohren auf.\n" }));

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "schleckt froehlich Deine Hand ab.",
        "schleckt froehlich "+TP->name(WESSEN)+" Hand ab.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "bellt laut.",
        "bellt laut.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "wirft sich auf den Ruecken und will von Dir gestreichelt werden.",
        "wirft sich auf den Ruecken und will von "+TP->name(WEM)+" "
        +"gestreichelt werden.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "verzieht sich winselnd in eine Ecke.",
        "verzieht sich winselnd in eine Ecke.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "knurrt leise.",
        "knurrt leise.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "springt schwanzwedelnd um Dich herum.",
        "springt schwanzwedelnd um "+TP->name(WEN)+" herum.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "schleckt Dein Gesicht ab.",
        "schleckt "+TP->name(WESSEN)+" Gesicht ab.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "drueckt sich vertrauensvoll an Dein Bein.",
        "drueckt sich vertrauensvoll an "+TP->name(WESSEN)+" Bein.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "wedelt mit dem Schwanz.",
        "wedelt mit dem Schwanz.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "winselt leise und leckt troestend Deine Hand ab.",
        "winselt leise und leckt troestend "+TP->name(WESSEN)+" Hand ab.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Reaktion auf Katze in vorhof_c1:
void init()
{
  ::init();

  if(ENV(TO) && present("katze", ENV(TO)))
  {
        if(begruessung == WEG)
        {
                begruessung = DA;
                if(find_call_out("init_hallo") != -1) return;
                call_out("init_hallo",5);
                return;
        }
        return;
  }

  begruessung = WEG;
  return;
}

void init_hallo()
{
  ENV(TO)->Message(BS("Als Yoshy die kleine Katze unter dem Fischstand "
  +"sitzen sieht, laeuft er zu ihr und beschnueffelt sie neugierig."),
  MSGFLAG_VISUAL);
}


//Knochen geben:
void give_notify(object was)
{
    if(was->id("\nknochen"))
    {
        write(break_string("Yoshy schnueffelt neugierig an dem Knochen "
        +"herum und nimmt ihn dann vorsichtig aus Deinen Haenden entgegen. "
        +"Dann schleppt er den Knochen in eine Ecke, laesst sich daneben "
        +"nieder und faengt zufrieden an, daran herumzunagen.\n", 
        78, 0, BS_LEAVE_MY_LFS));
     
        ENV(TO)->Message(break_string("Yoshy nimmt den Knochen vorsichtig "
        +"zwischen seine Zaehne und schleppt ihn in eine Ecke. Dann "
        +"laesst er sich behaglich daneben nieder und faengt an, an dem "
        +"Knochen herumzunagen.\n", 78, 0, BS_LEAVE_MY_LFS),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        if(find_call_out("knochen_entfernen") == -1)
        {
            call_out("knochen_entfernen", 30+random(5));
        }
    }
    else
    {
        write(break_string("Yoshy will nichts von Dir annehmen und laesst "
        +was->name(WEN)+" zu Boden fallen.\n", 78, 0, BS_LEAVE_MY_LFS));
        
        ENV(TO)->Message(break_string("Yoshy will nichts von "
        +this_player()->Name()+" annehmen und laesst "+was->name(WEN)+ " zu "
        +"Boden fallen.\n", 78, 0, BS_LEAVE_MY_LFS),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        was->move(ENV(TO), M_PUT|M_SILENT);
    }
    
    return;
}

void knochen_entfernen()
{
   int i;
   object *inv;
   inv = all_inventory(TO);

   if(sizeof(inv))
   {
        for(i=0; i < sizeof(inv); i++)
        {
           if(inv[i])
           {
              inv[i]->remove();
           }
        }
        
        if(ENV(TO)) ENV(TO)->Message(BS("Yoshy vergraebt etwas im "
        +"Boden.\n"), MSGFLAG_VISUAL);
    }
    
    return;
}
