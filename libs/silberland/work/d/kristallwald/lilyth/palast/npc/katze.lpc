#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine kleine Katze");
  SetProp(P_LONG,
    "Eine kleine, schwarzweiss gefleckte Katze sitzt unter dem Stand des "
    "Fischhaendlers und beaeugt gierig die Fische, die auf dem Holzbrett "
    "angepriesen werden. Sie hat hellblaue Augen, etwas strubbeliges Fell "
    "und eine winzige rosa Nase, die leicht hin- und herzuckt, als sie den "
    "intensiven Fischgeruch wittert.");

  AddDetail( ({ "augen", "fische" }),
    "Die kleine Katze laesst die Fische auf dem Holzbrett nicht aus den "
    "Augen.");

  AddDetail( ({ "fell" }),
    "Das Fell sieht ein wenig strubbelig aus.");

  AddDetail( ({ "nase" }),
    "Die winzige hellrosa Nase zuckt leicht hin und her.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Katze");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({ "katze", "FELL_WUSCHEL" }));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(7);

  SetProp(P_HANDS, ({ " mit ihren Krallen", 70, DT_BLUDGEON }) );

  SetProp(P_RACE, "Katze");
  SetProp(P_SIZE, 20);
  SetProp(P_WEIGHT, 1700);
  SetProp(P_ALIGN, 250);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SUID;

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "tapst herein");
  SetProp(P_MSGOUT, "tapst");
  SetProp(P_MMSGIN, "laeuft herein");
  SetProp(P_MMSGOUT, "laeuft weg");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Eine Katze");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "hat nur Augen fuer den Fisch.\n");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

  AddSpell(1,0,
    Name(WER, 1)+" zerkratzt schmerzhaft Dein Gesicht!\n",
    Name(WER, 1)+" zerkratzt schmerzhaft @WESSEN Gesicht!\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" beaeugt gierig den Fisch.\n",
    Name(WER, 1)+" miaut leise.\n",
    Name(WER, 1)+" wittert den Fischgeruch.\n",
    Name(WER, 1)+" streicht schnurrend um den Fischstand herum.\n",
    Name(WER, 1)+" schnuppert an Dir herum.\n",
    Name(WER, 1)+" laesst den Fisch nicht aus den Augen.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" faucht wuetend.\n",
    Name(WER, 1)+" maunzt klaeglich.\n",
    Name(WER, 1)+" faehrt ihre Krallen aus!\n" }));

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt die kleine Katze.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "schleckt Deine Haende mit ihrer winzigen Zunge ab.",
        "schleckt "+TP->name(WESSEN)+" Haende mit ihrer winzigen Zunge ab.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "verkriecht sich fauchend unter dem Fischstand.",
        "verkriecht sich fauchend unter dem Fischstand.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "spielt Katz und Maus mit Deinem Schnuersenkel.",
        "spielt Katz und Maus mit "+TP->name(WESSEN)+" Schnuersenkel.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "faucht Dich an und fuegt Dir mit ihren Krallen einige schmerzhafte "
        "Kratzer zu! Autsch!",
        "faucht und zerkratzt "+TP->name(WEN)+" mit ihren scharfen Krallen!");
        TP->AddHp(-10);
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "faucht leise.",
        "faucht leise.");
      break;

    case "froh":
    case "nett":
      call_out("reaction", 0, TP,
        "streicht schnurrend um Deine Beine.",
        "streicht schnurrend um "+TP->name(WESSEN)+" Beine.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "schnurrt zufrieden.",
        "schnurrt zufrieden.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "hat nur Augen fuer den Fisch.",
        "hat nur Augen fuer den Fisch.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "schleckt troestend Deine Haende mit ihrer winzigen Zunge ab.",
        "schleckt troestend "+TP->name(WESSEN)+" Haende mit ihrer winzigen "
        +"Zunge ab.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Wegwerf-Meldung unterdruecken:
void give_notify(object was)
{
        if(was->id("\nfisch"))
        {
        command_me("iss fisch");
        return;
        }

        write("Die kleine Katze will nichts von Dir annehmen und laesst "
        +was->name()+" fallen.\n");

        ENV(TO)->Message(BS("Die kleine Katze will nichts von "
        +this_player()->Name()+" annehmen."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        was->move(ENV(TO), M_SILENT|M_PUT);
        return;
}
