#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Thimon, der Konditor");
  SetProp(P_LONG,
    "Thimon ist ein kleiner Hobbit mit einem froehlichen Gesicht, "
    "freundlichen braunen Augen und roten Wangen. Man sieht ihm seinen "
    "Beruf sehr leicht an, denn selbst die grosse Schuerze, die er sich "
    "umgebunden hat, schafft es nicht ganz, die leichte Woelbung darunter "
    "zu verbergen. Aber wer koennte schon den vielen Leckereien, die "
    "er herstellt, widerstehen? Er selber zumindest versucht es erst "
    "gar nicht mehr.");

  AddDetail( ({ "gesicht" }),
    "Thimon hat ein froehliches, offenes Gesicht.");

  AddDetail( ({ "augen", "auge" }),
    "Seine freundlichen, braunen Augen blicken Dich neugierig an.");

  AddDetail( ({ "wange", "wangen" }),
    "Seine Wangen sind leicht geroetet.");

  AddDetail( ({ "beruf" }),
    "Thimon ist Konditor von Beruf.");

  AddDetail( ({ "schuerze" }),
    "Thimon hat sich eine grosse, weisse Schuerze umgebunden.");

  AddDetail( ({ "woelbung" }),
    "Thimon hat selbst fuer einen Hobbit einen recht betraechtlichen "
    "Umfang. Aber das scheint ihn selbst kein bisschen zu stoeren.");

  AddDetail( ({ "umfang" }),
    "Er ist ziemlich betraechtlich.");

  AddDetail( ({ "leckerei", "leckereien" }),
    "Nun, schau Dich doch einmal hier um.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Thimon");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"thimon", "konditor", "hobbit", "NOWIMPY"}));
  AddClass( ({CL_HOBBIT}) );
  SetProp(P_ARTICLE, 0);

  set_living_name("thimon");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(17);

  SetProp(P_HANDS, ({ " mit mehlbestaeubten Haenden", 170, DT_BLUDGEON }) );

  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 65);
  SetProp(P_WEIGHT, 56000);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" fragt: Was soll ich denn damit?\n" }) );

  SetProp(P_LOG_INFO, "/lilyth/palast/konditor");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_LIGHTNING: 0.1,
       DT_SOUND:     0.2,
       DT_POISON:    0.1,
       DT_TERROR:   -0.1,
       DT_MAGIC:    -0.1 ]));

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "eilt herbei");
  SetProp(P_MSGOUT, "eilt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Ein Konditor");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "sagt: Nimm Dir lieber einen Schokoladenkeks.\n",
            "schnauft: Dafuer hab ich jetzt keine Zeit!\n",
            "haelt Dir ein paar frische Nuesse unter die Nase.\n"}));

  AddInfo( ({"theke", "glastheke"}),
  "auf die Glastheke.",
  "deutet ");

  AddInfo( ({"konditorei", "konditor", "backen"}),
  "Ich liebe es, zu backen und leckere Dinge anzufertigen!",
  "strahlt: ");

  AddInfo( ({"kinder"}),
  "Die Kleinen kommen oft hierher und druecken sich die Nasen an meiner "
  "Theke platt. Ab und zu bekommen sie auch ein paar Schokoladenplaetzchen "
  "von mir.",
  "grinst: ");

  AddInfo( ({"angebot", "waren", "koestlichkeiten", "backwaren", "dinge"}),
  "Mein Angebot kannst Du Dir mit 'zeige' anzeigen lassen.",
  "sagt froehlich: ");

  AddInfo( ({"ceyth", "bogenhaendler", "bogenladen"}),
  "Ceyths Bogenladen? Den solltest Du im Untergeschoss suchen.",
  "sagt: ");

  AddInfo( ({"schreinerei"}),
  "Hmm, ich glaube, die ist irgendwo im Untergeschoss.",
  "gruebelt: ");

  AddInfo( ({"fischhaendler", "obstverkaeufer"}),
  "Da schau am besten mal draussen nach.",
  "sagt: ");

  AddInfo( ({"teestube", "kellnerin"}),
  "Schau mal im Mittelgeschoss nach.",
  "gruebelt: ");

  AddInfo( ({"yoshy", "hund"}),
  "Der ist irgendwo draussen.",
  "kichert: ");

  AddInfo( ({"katze"}),
  "Die ist irgendwo draussen.",
  "kichert: ");

  AddInfo( ({"velg'larn", "velglarn"}),
  "Der hat seinen finsteren Laden irgendwo unten.",
  "haelt kurz inne: ");

  AddInfo( ({"fredolin", "schreiner", "schreinerei"}),
  "Fredolin findest Du im Untergeschoss.",
  "sagt: ");

  AddInfo( ({"trollwaechter", "waechter"}),
  "Die bewachen den Palast.",
  "erklaert: ");

  AddInfo( ({"palast"}),
    "Da befindest Du Dich gerade.",
    "sagt froehlich: ");

  AddInfo( ({"soldat", "soldaten"}),
  "Die Soldaten sorgen dafuer, dass sich die Gaeste von niemandem "
  "gestoert fuehlen.",
  "erklaert: ");

  AddInfo( ({"kartenzeichnerin", "zeichnerin", "alenari", "teestube"}),
    "Lass mich mal ueberlegen... Ja, ich glaube, die habe ich mal "
    "irgendwo im Mittelgeschoss gesehen.",
    "gruebelt: ");

  AddInfo( ({"gordrogh", "tierhaendler", "tierhandlung"}),
  "Die Tierhandlung findest Du im Mittelgeschoss.",
  "erklaert: ");
  
  AddInfo( ({"kobold", "brunnen"}),
  "Der befindet sich im Untergeschoss.",
  "sagt: ");

  AddInfo( ({"linah", "koechin"}),
  "Linah ist die beste Koechin des Silberlandes. Du findest sie unten im "
  "Untergeschoss.",
  "grinst: ");

  AddInfo( ({"tungdil", "schmied", "schmiede"}),
  "Die Schmiede befindet sich im Untergeschoss.",
  "sagt: ");

  AddInfo( ({"kundschaft", "kunden", "kunde"}),
  "grinsend auf Dich.",
  "deutet ");

  AddInfo( ({"mahmud"}),
    "Schau mal im Sueden nach.",
    "sagt: ");

  AddInfo( ({"varaile", "haendlerin"}),
    "Varaile findest Du etwas weiter im Sueden.",
    "sagt: ");

  AddInfo( ({"untergeschoss"}),
    "Das liegt weiter unten.",
    "sagt: ");

  AddInfo( ({"mittelgeschoss"}),
    "Das liegt weiter unten.",
    "sagt: ");

  AddInfo( ({"obergeschoss"}),
    "Da befindest Du Dich gerade.",
    "sagt: ");

  AddInfo( ({"eistorte", "torte"}),
    "Ich habe gerade eine frische Eistorte im Angebot.",
    "sagt: ");

  AddInfo( ({"pralinen", "praline", "pralinenkaestchen"}),
    "Wenn Du einer guten Freundin oder einem Freund etwas schenken "
    "willst, ist ein Kaestchen Pralinen doch sicher nicht verkehrt.",
    "grinst: ");

  AddInfo( ({"freund", "freundin", "freunde"}),
    "Du hast doch sicher einige Freunde hier.",
    "sagt: ");

  AddInfo( ({"honigkuchen"}),
    "Den Honigkuchen habe ich gerade frisch gebacken.",
    "sagt: ");

  AddInfo( ({"schokoladenkeks", "schokoladenkekse", "schokoladenplaetzchen",
  "keks", "kekse", "plaetzchen"}),
    "Die Schokoladenplaetzchen kommen gerade frisch aus dem Ofen.",
    "sagt: ");

  AddInfo( ({"lebkuchenherz", "lebkuchenherzen", "herz", "herzen", 
  "lebkuchen"}),
    "So ein Lebkuchenherz ist etwas ganz besonderes!",
    "beteuert: ");

  AddInfo( ({"karamellbonbon", "karamelbonbon", "karamellbonbons",
  "karamelbonbons", "karamell", "karamel", "bonbon", "bonbons"}),
    "Ein wenig klebrig sind sie ja, aber sie schmecken einfach gut!",
    "grinst: ");

  AddInfo( ({"honig", "milch", "nuesse", "eier", "mehl", "schokolade",
  "zucker"}),
    "Das brauche ich zum Backen!",
    "sagt: ");

  AddInfo( ({"backzutaten", "zutaten"}),
    "auf das Regal.",
    "deutet ");

  AddInfo( ({"schale"}),
    "Sind die Plaetzchen etwa schon wieder leer?",
    "seufzt: ");

  AddInfo( ({"stehtisch", "stehtische", "tisch", "tische"}),
    "auf die beiden Stehtische.",
    "deutet ");

  AddInfo( ({"kasse"}),
    "Das ist mein Einkommen.",
    "sagt: ");

  AddInfo( ({"einkommen"}),
    "Nun ja, von irgendetwas muss man ja leben.",
    "grinst: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

  AddDefaultSpell(3, 100, DS_BLIND,
    Name(WER, 1)+" wirft Dir eine grosse Torte ins Gesicht!",
    Name(WER, 1)+" wirft @WEM eine grosse Torte ins Gesicht!", 2);
    
  AddSpell(3,430,
    Name(WER, 1)+" schlaegt mit einer Backform nach Dir!\n",
    Name(WER, 1)+" schlaegt mit einer Backform nach @WEM!\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3,430,
    Name(WER, 1)+" zerschlaegt eine Kuchenschuessel auf Deinem Kopf!\n",
    Name(WER, 1)+" zerschlaegt eine Kuchenschuessel auf @WESSEN Kopf!\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
    
//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" traellert ein lustiges Liedchen.\n",
    Name(WER, 1)+" schiebt etwas in den Ofen.\n",
    Name(WER, 1)+" haelt nach Kundschaft Ausschau.\n",
    Name(WER, 1)+" sagt froehlich: Kauf doch etwas!\n",
    Name(WER, 1)+" holt etwas aus dem Ofen.\n",
    Name(WER, 1)+" wischt die Theke saeuberlich ab.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" sucht nach etwas, mit dem er Dich bewerfen kann.\n",
    Name(WER, 1)+" wuehlt hastig im Regal herum.\n",
    Name(WER, 1)+" bewirft Dich mit harten Eiern.\n" }));

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME(ARMOUR "schuerze");
  command("trage alles");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt den Konditor.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+"Der Konditor hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "zwinkert Dir aufmunternd zu.",
        "zwinkert "+TP->name(WEM)+" aufmunternd zu.");
      break;

    case "aergerlich":
    case "frech":
      call_out("reaction", 0, TP,
        "schaut Dich vorwurfsvoll an.",
        "schaut "+TP->name(WEN)+" vorwurfsvoll an.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "grinst Dich an.",
        "grinst "+TP->name(WEN)+" an.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "ruft empoert: Hey, hoer sofort damit auf!",
        "ruft empoert: Hey, hoer sofort damit auf!");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "freut sich mit Dir.",
        "freut sich mit "+TP->name(WEM)+".");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "murmelt verlegen etwas von 'Ofen' und rueckt von Dir ab.",
        "murmelt verlegen etwas von 'Ofen' und rueckt von "+TP->name(WEM)+" ab.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "grinst froehlich.",
        "grinst froehlich.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "nickt Dir froehlich zu.",
        "nickt "+TP->name(WEM)+" froehlich zu.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich freundschaftlich.",
        "troestet "+TP->name(WEN)+" freundschaftlich.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}

void klappeauf()
{
        if(ENV(TO) && ENV(TO)->ofenklappe())
        {
                sage("Hey, die Plaetzchen sind doch noch gar nicht fertig!");
                command_me("schliesse klappe");
                return;
        }
        return;
}
