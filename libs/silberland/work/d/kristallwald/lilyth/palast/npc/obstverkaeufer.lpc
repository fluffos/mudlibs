#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------

object obstkorb;
#define HEAL 70

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Obstverkaeufer");
  SetProp(P_LONG,
    "Dieser noch sehr junge Oger verkauft frisches Obst auf dem Vorhof des "
    "Palastes. Er haelt einen grossen geflochtenen Korb in seinen Haenden, "
    "in dem Du die verschiedensten Obstsorten erkennen kannst. Spitzbuebisch "
    "grinst er Dich an, als er Deinen neugierigen Blick bemerkt, und haelt "
    "Dir den Korb auffordernd unter die Nase.");

  AddDetail( ({ "obst" }),
    "Das Obst sieht wirklich sehr frisch aus.");

  AddDetail( ({ "vorhof" }),
    "Der junge Oger steht in einer Ecke auf dem Vorhof des Palastes und "
    "verkauft frisches Obst.");

  AddDetail( ({ "palast" }),
    "Du befindest Dich auf dem Vorhof des Palastes.");

  AddDetail( ({ "korb" }),
    "Der Korb ist randvoll gefuellt mit den schoensten Fruechten, die Du "
    "jemals gesehen hast.");

  AddDetail( ({ "haende" }),
    "Er haelt einen geflochtenen Korb in seinen grossen und etwas "
    "tollpatschigen Haenden.");


  AddDetail( ({ "obstsorten", "sorten", "fruechte" }),
    "Frag ihn doch mal, welche Sorten er Dir anbieten kann.");

  AddDetail( ({ "blick" }),
    "Verlegen senkst Du Deinen Blick etwas.");

  AddDetail( ({ "nase" }),
    "Das Obst riecht genauso frisch und lecker, wie es aussieht.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Obstverkaeufer");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"obstverkaeufer", "verkaeufer", "oger"}));
  AddClass( ({ CL_OGRE }) );
  SetProp(P_ARTICLE, 1);

  set_living_name("obstverkaeufer");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(17);

  SetProp(P_HANDS, ({ " mit seinen Haenden", 170, DT_BLUDGEON }) );

  SetProp(P_RACE, "Oger");
  SetProp(P_SIZE, 198);
  SetProp(P_WEIGHT, 170000);
  SetProp(P_ALIGN, 40);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" hat keine Hand mehr frei.\n" }) );

  SetProp(P_LOG_INFO, "/lilyth/palast/obstverkaeufer");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_WATER: -0.2,
       DT_TERROR: 0.3 ]));

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "bietet Dir frisches Obst an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Obstverkaeufer");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "sagt: Kauf lieber etwas von meinem Obst.\n");
  AddInfo("lilyth", "Lilyth sollte viel mehr Obst essen!","seufzt: ");

  AddInfo( ({"brueder"}),
    "Meine grossen Brueder leben ziemlich zurueckgezogen in unserem "
    "Heimatwald. Aber wenn ich Hilfe brauche, kann ich mich immer auf "
    "sie verlassen.",
    "prahlt: ");

  AddInfo( ({"heimatwald", "wald"}),
  "Unser Wald liegt ungefaehr oestlich von Midas.",
  "kratzt sich am Kopf: ");

  AddInfo( ({"hilfe"}),
  "Meine Brueder helfen mir im Notfall immer aus der Patsche.",
  "sagt gewichtig: ");

  AddInfo( ({"notfall", "patsche"}),
  "Ich kann mich immer auf sie verlassen.",
  "sagt: ");

  AddInfo( ({"midas"}),
  "Midas ist die Hauptstadt der Menschen.",
  "sagt: ");

  AddInfo( ({"hauptstadt", "stadt"}),
  "Die meisten Menschen leben in Midas.",
  "sagt: ");

  AddInfo( ({"menschen", "menschlein"}),
  "Nun ja, manche von ihnen sind ja ganz nett. Auch wenn die meisten von "
  "ihnen so schrecklich duerr und schwaechlich aussehen und Angst vor uns "
  "Ogern haben.",
  "fluestert Dir zu: ");

  AddInfo( ({"angst"}),
  "Frueher haben ich und meine Brueder sie immer erschreckt, wenn sie "
  "sich versehentlich in unseren Wald verlaufen haben. Das hat immer "
  "richtig Spass gemacht!",
  "grinst: ");

  AddInfo( ({"oger"}),
  "Ich bin ein Oger. Das sieht man doch wohl, oder?",
  "klopft sich auf die Brust: ");

  AddInfo( ({"spass"}),
  "Wir haben uns hinter den Baeumen versteckt und sind dann mit lautem "
  "Gebruell dahinter hervorgesprungen, wenn so ein kleines Menschlein "
  "des Weges kam. Du haettest sie dann mal sehen sollen, wie sie vor "
  "Angst geschlottert haben! Es war immer sooo lustig!",
  "kichert: ");

  AddInfo( ({"baeume"}),
  "Bei uns im Wald stehen sehr viele davon.",
  "gruebelt: ");

  AddInfo( ({"gebruell"}),
  "GRRRRRRRRRROOOOOOOOOARRRRRRR!!!",
  "bruellt Dir laut ins Ohr: ");

  AddInfo( ({"freundin"}),
  "Sie lebt bei meinen Bruedern im Wald.",
  "erroetet ein wenig: ");

  AddInfo( ({"banane", "bananen", "apfel", "aepfel", "kirsche", "kirschen",
  "birne", "birnen", "weintraube", "weintrauben", "zitrone", "zitronen",
  "orange", "orangen", "apfelsine", "apfelsinen", "mandarine", "mandarinen",
  "himbeere", "himbeeren", "erdbeere", "erdbeeren", "kokosnuss",
  "kokosnuesse", "nektarine", "nektarinen", "grapefruit", "grapefruits",
  "sauerkirsche", "sauerkirschen"}),
  "Das ist sehr gesund!",
  "beteuert: ");

  AddInfo( ({"obstkorb", "korb"}),
  "Dir wortlos seinen Obstkorb unter die Nase.",
  "haelt ");

  AddInfo( ({"obst", "fruechte", "frucht"}),
  "Obst ist sooooo gesund!",
  "fluestert eindringlich: ");

  AddInfo( ({"sorten", "obstsorten", "angebot"}),
  "Mit 'zeige' kannst Du sehen, welche Obstsorten ich heute im Angebot habe.",
  "sagt froehlich: ");

  AddInfo( ({"palast"}),
  "Den siehst Du doch von hier aus.",
  "kichert: ");

  AddInfo( ({"fischhaendler", "fisch", "fische"}),
  "Pah, wer braucht schon Fische? Die stinken so eklig, und ausserdem ist "
  "Obst ist viel gesuender!",
  "sagt wegwerfend: ");

  AddInfo( ({"trollwaechter", "waechter"}),
  "Die zwei bewachen das Portal.",
  "grinst froehlich: ");

  AddInfo( ({"portal"}),
  "Na, das Palastportal natuerlich!",
  "seufzt: ");

  AddInfo( ({"palastportal"}),
  "Das Portal, das in den Palast fuehrt.",
  "erklaert: ");

  AddInfo( ({"yoshy", "hund", "kerl"}),
  "Yoshy ist ein suesser kleiner Kerl.",
  "grinst: ");

  AddInfo( ({"katze", "katzen"}),
  "Hier auf dem Vorhof ist irgendwo eine.",
  "gruebelt: ");

  AddInfo( ({"pferde", "pferd"}),
  "auf die Unterstaende.",
  "deutet ");

  AddInfo( ({"unterstaende"}),
  "Mach doch die Augen auf!",
  "sagt ungeduldig: ");

  AddInfo( ({"tiere"}),
  "Ich mag Tiere, Du auch?",
  "sagt froehlich: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

  AddSpell(3,370,
    Name(WER, 1)+" zerschlaegt eine grosse Kokosnuss auf Deinem Kopf!\n",
    Name(WER, 1)+" zerschlaegt eine grosse Kokosnuss auf @WESSEN Kopf!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(4,250,
    Name(WER, 1)+" haut Dir seinen Obstkorb um die Ohren!\n",
    Name(WER, 1)+" haut @WEM seinen Obstkorb um die Ohren!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(3,1,
    Name(WER, 1)+" greift in seinen Obstkorb.\n",
    Name(WER, 1)+" greift in seinen Obstkorb.\n",
    DT_BLUDGEON, "selbstheilung");

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" ruft laut ueber den ganzen Hof: Obst! Frisches Obst!\n",
    Name(WER, 1)+" haelt Dir seinen Obstkorb unter die Nase.\n",
    Name(WER, 1)+" bietet Dir frisches Obst an.\n",
    Name(WER, 1)+" fluestert Dir zu: Obst ist sehr gesund.\n",
    Name(WER, 1)+" stopft sich genuesslich eine saftige Birne in den Mund.\n",
    Name(WER, 1)+" seufzt: Die Leute sollten mehr Obst essen.\n"
    "Der Obstverkaeufer seufzt: Das macht gross und stark!\n",
    Name(WER, 1)+" haelt Dir eine Handvoll dunkelroter Kirschen hin.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" bewirft Dich mit einer Handvoll Kirschkerne!\n",
    Name(WER, 1)+" stopft Dir eine alte Banane in den Mund!\n",
    Name(WER, 1)+" ruft empoert: Das sag ich meinen grossen Bruedern!\n" }));

//--Ausruestung------------------------------------------------------------

  SUID;
  obstkorb = clone_object(OBJ "obstkorb");
  obstkorb->move(TO);
  clone_object(OBJ "banane" )->move(obstkorb);
  clone_object(OBJ "birne" )->move(obstkorb);
  clone_object(OBJ "nektarine" )->move(obstkorb);
  clone_object(OBJ "sauerkirsche" )->move(obstkorb);
  clone_object(OBJ "grapefruit" )->move(obstkorb);

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt den Obstverkaeufer.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "verwuschelt gutmuetig Deine Haare.",
        "verwuschelt gutmuetig "+TP->name(WESSEN)+" Haare.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "sagt empoert: Hey, lass das!",
        "sagt empoert: Hey, lass das!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "grinst Dich an und zeigt dabei seine vom vielen Obst rotgefaerbten "
        "Zaehne.",
        "grinst "+TP->name(WEN)+" an und zeigt dabei seine vom vielen Obst "
        +"rotgefaerbten Zaehne.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "grunzt veraergert.",
        "grunzt veraergert.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "sagt: Hey, jetzt haette ich fast das Obst fallen lassen!",
        "sagt: Hey, jetzt haette ich fast das Obst fallen lassen!");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "freut sich mit Dir und fragt: Moechtest Du etwas Obst?",
        "freut sich mit "+TP->name(WEM)+" und fragt: Moechtest Du etwas "
        +"Obst?");
      break;

    case "intim":
        if(this_player()->QueryProp(P_GENDER) == MALE)
        {
                call_out("reaction", 0, TP,
                "taetschelt Deinen Kopf und sagt: Ich steh nicht auf "
                +"Maenner!",
                "taetschelt "+TP->name(WESSEN)+" Kopf und sagt: Ich steh "
                +"nicht auf Maenner!");
        }
        else
        {
                call_out("reaction", 0, TP,
                "sagt bedauernd: Ich habe schon eine Freundin...",
                "sagt bedauernd: Ich habe schon eine Freundin...");
        }
        break;

    case "nett":
      call_out("reaction", 0, TP,
        "deutet auf seinen Obstkorb.",
        "deutet auf seinen Obstkorb.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "sagt: Kauf lieber etwas Obst!",
        "sagt: Kauf lieber etwas Obst!");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "bietet Dir troestend eine Nektarine an.",
        "bietet "+TP->name(WEM)+" troestend eine Nektarine an.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}

//Spell (mit Obst heilen):
void selbstheilung(object enemy,int damage,string damtype)
{
  //erst ab Haelfte LPs heilen
  if(TO->QueryProp(P_HP) > TO->QueryProp(P_MAX_HP)/2)
  {
        return;
  }

  if(present("\nobst", obstkorb))
  {
     command("nimm obst aus korb");
     command("iss obst");
     AddHp(HEAL);
  }

  return;
}
