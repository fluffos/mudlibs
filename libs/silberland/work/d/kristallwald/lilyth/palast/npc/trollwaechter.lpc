#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------

string *players;

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  players = ({});

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kraeftiger Trollwaechter");
  SetProp(P_LONG,
    "Dieser kraeftige Trollwaechter bewacht das grosse Portal, das in den "
    "Palast fuehrt. Sein Blick ist streng geradeaus gerichtet, doch Du "
    "bemerkst, dass er jeden Besucher, der den Palast betreten will, von "
    "oben bis unten genauestens mustert und ihn erst dann passieren laesst.");

  AddDetail( ({ "portal" }),
    "Er steht direkt neben dem grossen Portal, das in den Palast "
    "hineinfuehrt.");

  AddDetail( ({ "palast" }),
    "Das Portal fuehrt in den Palast hinein.");

  AddDetail( ({ "blick" }),
    "Mit strengem Blick betrachtet der Trollwaechter jeden, der den Palast "
    "betreten will.");

  AddDetail( ({ "besucher" }),
    "Es gehen immer wieder Besucher des Palastes durch das grosse Portal "
    "hinein oder hinaus.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Trollwaechter");
  SetProp(P_NAME_ADJ, "kraeftig");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"trollwaechter", "waechter", "troll", "\ntrollwaechter",
  "Messermeister", "NOWIMPY"}));
  AddClass( ({CL_TROLL}) );
  SetProp(P_ARTICLE, 1);

//set_living_name("trollwaechter");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(27);

  SetProp(P_HANDS, ({" mit seinen kraeftigen Haenden"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })  );

  SetProp(P_RACE, "Troll");
  SetProp(P_SIZE, 200+random(70));
  SetProp(P_WEIGHT, 100000+random(50000));
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" grunzt: Was soll ich damit?\n" }) );

  SetProp(P_LOG_INFO, "/lilyth/palast/trollwaechter");

  SetProp(P_RESISTANCE_STRENGTHS,
    ([ DT_FIRE:        0.5,
       DT_AIR:        -0.2,
       DT_LIGHTNING:   0.3,
       DT_LIGHT:       0.3,
       DT_TERROR:     -0.3,
       DT_MAGIC:       0.2,
       DT_MIND:        0.2,
       DT_SLASH:      -0.05,
       DT_BLUDGEON:   -0.05,
       DT_PIERCE:     -0.05,
       DT_SQUEEZE:    -0.05,
       DT_WHIP:       -0.05,
       DT_RIP:        -0.05 ]));

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "marschiert herein");
  SetProp(P_MSGOUT, "marschiert");
  SetProp(P_MMSGIN, "bewacht das Palastportal");
  SetProp(P_MMSGOUT, "wird woanders gebraucht");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Ein kraeftiger Trollwaechter");
  SetProp(P_KILL_MSG, "Dein Gesicht merke ich mir!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "beachtet Dich gar nicht.\n",
            "hat keine Zeit, um Deine Fragen zu beantworten.\n",
            "mustert Dich stumm.\n"}));

  AddInfo( ({"palast","aerger", "vorhof", "portal", "palastportal"}),
  "Ich bewache das Portal und achte darauf, dass niemand hier draussen "
  "Aerger macht.",
  "sagt kurz: ");

  AddInfo( ({"waffe", "waffen"}),
  "Niemand kommt mit gezueckter Waffe in den Palast hinein.",
  "knurrt: ");

  AddInfo( ({"besucher", "palastbesucher"}),
  "Hier ist meistens recht viel los.",
  "deutet ueber den Vorhof: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,40);

  AddSpell(3,450,
    Name(WER, 1)+" schleudert Dich zu Boden!\n",
    Name(WER, 1)+" schleudert @WEN zu Boden!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(5,550,
    Name(WER, 1)+" rammt Dir seine Faust ins Gesicht!\n",
    Name(WER, 1)+" rammt @WEM seine Faust ins Gesicht!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" wirft Dir einen misstrauischen Blick zu.\n",
    Name(WER, 1)+" laesst eine Gruppe laut schwatzender Elfen vorbei.\n",
    Name(WER, 1)+" laesst eine grosse Hobbitfamilie passieren.\n",
    Name(WER, 1)+" wechselt ein paar Worte mit einem der Besucher.\n",
    Name(WER, 1)+" blickt kurz zu einer Gruppe Dunkelelfen hinueber.\n",
    Name(WER, 1)+" verweigert einem Zwerg mit gezueckter Axt den Einlass.\n",
    Name(WER, 1)+" blickt wachsam geradeaus.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" grunzt veraergert auf.\n",
    Name(WER, 1)+" versucht, Dich mit seinen kraeftigen Haenden zu "
    +"erwuergen.\n",
    Name(WER, 1)+" bruellt laut: Verschwinde von hier!!!" }));

//--Ausruestung------------------------------------------------------------

  SUID;
  if(!random(5))
  {
        clone_object(WEAPON "halekmesser")->move(TO);
        command("zuecke messer");

        AddSpell(4,850,
        Name(WER, 1)+" sticht mit dem Halekmesser auf Dich ein!\n",
        Name(WER, 1)+" sticht mit dem Halekmesser auf @WEN ein!\n",
        DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  }
  else
  {
        clone_object("/p/weapon/knife/hiebdolch")->move(TO);
        command("zuecke dolch");

        AddSpell(4,850,
        Name(WER, 1)+" sticht mit dem Hiebdolch auf Dich ein!\n",
        Name(WER, 1)+" sticht mit dem Hiebdolch auf @WEN ein!\n",
        DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  }

  clone_object("/p/armour/helm/kettenhaube")->move(TO);
  clone_object("/p/armour/trousers/kettenhose")->move(TO);
  clone_object("/p/armour/boots/kampfstiefel")->move(TO);

  if(!random(4))
  {
        clone_object("/p/armour/armour/kettenpanzer")->move(TO);
  }

  if(!random(5))
  {
        clone_object("/p/armour/gloves/kettenhandschuhe")->move(TO);
  }

  if(!random(5))
  {
        clone_object(ARMOUR "waffengurt" )->move(TO);
  }

  command("zieh alles an");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt einen kraeftigen Trollwaechter.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "mustert Dich argwoehnisch.",
        "mustert "+TP->name(WEN)+" argwoehnisch.");
      break;

    case "aergerlich":
    case "fies":
        if(member(players, getuid(TP)) == -1)
        {
                call_out("reaction", 0, TP,
                "warnt Dich: Mach das nicht noch mal!",
                "warnt "+TP->name(WEN)+": Mach das nicht noch mal!");
                players += ({ getuid(TP) });
        }
        else
        {
                TO->reaction(TP,
                "knurrt: Ich habe Dich gewarnt!",
                "knurrt: Ich habe Dich gewarnt!");
                Kill(TP);
        }
        break;

    case "albern":
      call_out("reaction", 0, TP,
        "runzelt die Stirn.",
        "runzelt die Stirn.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "schaut Dich warnend an.",
        "schaut "+TP->name(WEN)+" warnend an.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "wundert sich ueber Dich.",
        "wundert sich ueber "+TP->name(WEN)+".");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "grunzt: Ich bin im Dienst!",
        "grunzt: Ich bin im Dienst!");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "beachtet Dich gar nicht.",
        "beachtet "+TP->name(WEN)+" gar nicht.");
      break;

    case "traurig":
    case "nett":
      call_out("reaction", 0, TP,
        "blickt stumm geradeaus.",
        "blickt stumm geradeaus.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Master:
void angriff(object pl)
{
  string shouter;

  if(!ENV(TO))           return;
  if(!interactive(pl))   return;
  if(ENV(TO) != ENV(pl)) return;

  shouter = pl->CannotSee(1) ? "Jemand ruft: "
                             : Name(WER,1)+" ruft: ";

  tell_room(ENV(TO),
     ""+break_string(pl->Name(WER)+" hat den Frieden im Palast gestoert, "
     +"haltet "+pl->QueryPronoun(WEN)+" auf!!!", 78, shouter+"", 1));

  Kill(pl);

  return;
}

//Master:
void init()
{
  ::init();

  if(TP && TP->id("\ntrollwaechter")) AddDefender(TP);

  if(!TP)                        return;
  if(!interactive(TP))           return;
  if(TP->QueryProp(P_GHOST))     return;
  if(!PALASTMASTER->IsEnemy(TP))   return;

  call_out("angriff", 0, TP);
}

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}


void InformDefend(object enemy)
{
        Kill(enemy);
}
