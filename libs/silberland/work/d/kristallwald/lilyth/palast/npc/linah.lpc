  SetProp(P_SHORT, "Linah, die Koechin");
  SetProp(P_LONG,
    "Linah ist eine rundliche kleine Hobbitdame mit einem freundlichem "
    "Gesicht. Sie freut sich ueber jeden, der sich von ihr bekoestigen "
    "laesst und mit dem sie sich ein wenig unterhalten kann. Sie weiss "
    "ueber fast alles, was im Palast vor sich geht, Bescheid.");

  AddDetail( ({ "hobbitdame" }),
    "Selbst fuer einen Hobbit ist Linah ganz schoen rundlich. Aber so gut, "
    "wie sie kochen kann, ist das wohl auch kein Wunder.");

  AddDetail( ({ "wunder" }),
    "Bei ihren Kochkuensten ist es kein Wunder, dass Linah im Laufe der "
