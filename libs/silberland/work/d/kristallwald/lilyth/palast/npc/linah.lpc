//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt Linah.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+"Linah hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "wuschelt Dir froehlich durch die Haare.",
        "wuschelt "+TP->name(WEM)+" froehlich durch die Haare");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "deutet drohend auf ihren Kochloeffel.",
        "deutet drohend auf ihren Kochloeffel.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "grinst froehlich.",
        "grinst froehlich.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "haut Dir mit ihrem Kochloeffel auf die Finger und sagt: Lass das "
        +"lieber!",
        "haut "+TP->name(WEM)+" mit ihrem Kochloeffel auf die Finger und "
        +"sagt: Lass das lieber!");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "stupst Dich vorwurfsvoll an.",
        "stupst "+TP->name(WEN)+" vorwurfsvoll an.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "freut sich mit Dir.",
        "freut sich mit "+TP->name(WEM)+".");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "zwinkert Dir verschwoererisch zu.",
        "zwinkert "+TP->name(WEM)+" verschwoererisch zu.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "schaut Dich freundlich an.",
        "schaut "+TP->name(WEN)+" freundlich an.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "wartet auf Deine Bestellung.",
        "wartet auf "+TP->name(WESSEN)+" Bestellung.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "bietet Dir troestend eine Tasse heissen Kakao an.",
        "bietet "+TP->name(WEM)+" troestend eine Tasse heissen Kakao an.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//dem Spieler Einladung fuer Tungdil geben:
int fkteinladung()
{
  object myeinladung;

  if(!EINLADUNG(TP))
  {
        myeinladung = clone_object(OBJ "einladung");

        if(ME_TOO_HEAVY == myeinladung->move(TP,M_GET|M_SILENT))
        {
               TP->Message("Linah sagt: Hm, Du kannst die Einladung leider "
               +"nicht mehr tragen.\n",
               MSGFLAG_SOUND);
               myeinladung->remove();
               set_back();
               return -1;
        }
        else
        {
               TP->Message("Linah gibt Dir eine Einladung.\n",
               MSGFLAG_VISUAL);

               ENV(TO)->Message("Linah gibt "+TP->Name(WER, 1)+" eine "
               +"Karte.\n",
               MSGFLAG_VISUAL|MSGFLAG_NO_TP);
               einladung += ({ capitalize(getuid(TP)) });
               set_back();
               PALASTMASTER->Msg(TP->Name()+" bekommt die Einladung von "
               +"Linah.", 2);
               return 1;
        }
  }
  else
  {
        TP->Message("Linah sagt: Ich habe Dir die Karte doch bereits "
        +"gegeben.\n",
        MSGFLAG_SOUND);
        set_back();
        return -1;
  }
}

void reset()
{
  ::reset();
  einladung = ({ });
  knochen = ({});
}

//Linah den Ring geben:
void give_notify(object was)
{
  if(was->id("tungdil_ring"))
  {
     if(EINLADUNG(TP))
     {
        write(BS(Name(WER, 1)+" fragt hoffnungsvoll: Hast Du Tungdil "
        +"meine Einladung schon ueberbracht?"));
        return;
     }

     if(beschaeftigt == NEIN)
     {
        write(break_string(Name(WER, 1)+" fragt verwirrt: Huch, was gibst "
        +"Du mir denn da Schoenes?\nVerwundert betrachtet sie den Ring "
        +"eine Weile lang.\n", 78, 0, 1));

        beschaeftigt = JA;
        was->remove();
        SetChats(0, ({""})); //Chats ausschalten waehrend Sequenz
        call_out("seqring", 4 , TP, 1);
        PALASTMASTER->Msg(TP->Name()+" gibt Linah den Ring von Tungdil.", 2);
        return;
     }
     else
     {
        write(BS(Name(WER, 1)+" ist gerade beschaeftigt."));
        was->move(TP,M_GIVE);
        return;
     }
  }

  if(was->id("\neinladung"))
  {
     write(BS(Name(WER, 1)+" bittet Dich nochmals, Tungdil die "
     +"Einladung zu bringen, und gibt sie Dir zurueck."));
     was->move(TP,M_GIVE);
     return;
  }

  return::give_notify(was);
}

//anschliessende Sequenz:
void seqring(object player, int pos)
{
  string s;
  string s2;

    if(!player || ENV(player) != ENV(TO))
    {
        set_back();
        return;
    }

    	switch(pos)
        {
        case 1:
        s = "Ploetzlich erstarrt sie, und ihre Augen werden kugelrund.";
        s2 = "Ploetzlich erstarrt sie, und ihre Augen werden kugelrund.";
        seq += ({ capitalize(getuid(TP)) });
        break;

        case 2:
        s = "Linah murmelt leise: Dieser wunderschoene Edelstein... das "
        +"glattpolierte Silber... Es gibt nur einen im Silberland, der "
        +"etwas derartig Schoenes anfertigen kann.";
        s2 = "Linah murmelt leise: Dieser wunderschoene Edelstein... das "
        +"glattpolierte Silber... Es gibt nur einen im Silberland, der "
        +"etwas derartig Schoenes anfertigen kann.";
        break;

        case 3:
        s = "Sie schaut Dich mit grossen Augen an und fragt leise, fast "
        +"fluesternd: Ist er wirklich von ihm? Hast Du diesen Ring von "
        +"Tungdil?";
        s2 = "Sie schaut "+player->Name()+" mit grossen Augen an und fragt "
        +"leise, fast fluesternd: Ist er wirklich von ihm? Hast Du diesen "
        +"Ring von Tungdil?";
        break;

        case 4:
        s = "Als Du ihr bestaetigst, dass der Ring von Tungdil stammt, "
        +"erbleicht Linah, und einen Moment lang hast Du fast das Gefuehl, "
        +"als wuerde sie gleich in Ohnmacht fallen.";
        s2 = "Als "+player->Name()+" ihr bestaetigt, dass der Ring von "
        +"Tungdil stammt, erbleicht Linah, und einen Moment lang hast Du "
        +"fast das Gefuehl, als wuerde sie gleich in Ohnmacht fallen.";
        break;

        case 5:
        s = "Doch gleich darauf fasst sie sich wieder, faellt Dir auf "
        +"einmal voellig unerwartet freudestrahlend um den Hals und tanzt "
        +"mit Dir durch die ganze Kueche hindurch, so dass die Gaeste, "
        +"die gerade gemuetlich dort speisen, erstaunt aufblicken.";
        s2 = "Doch gleich darauf fasst sie sich wieder, faellt "
        +""+player->Name()+" auf einmal voellig unerwartet freudestrahlend "
        +"um den Hals und tanzt mit "+player->QueryPronoun(WEM)+" durch die "
        +"ganze Kueche hindurch, so dass die Gaeste, die gerade gemuetlich "
        +"dort speisen, erstaunt aufblicken.";
        break;

        case 6:
        s = "Schliesslich bleibt sie schwer atmend wieder stehen und "
        +"wird auf einmal ganz ruhig und nachdenklich. Ploetzlich flitzt sie "
        +"blitzschnell aus der Kueche und kommt kurze Zeit spaeter atemlos "
        +"wieder zurueck.";
        s2 = "Schliesslich bleibt sie schwer atmend wieder stehen und "
        +"wird auf einmal ganz ruhig und nachdenklich. Ploetzlich flitzt sie "
        +"blitzschnell aus der Kueche und kommt kurze Zeit spaeter atemlos "
        +"wieder zurueck.";
        break;

        case 7:
        s = "Linah fragt Dich verlegen: Ich weiss, Du hast sicher nicht "
        +"sehr viel Zeit, aber darf ich Dich dennoch um einen grossen "
        +"Gefallen bitten? Es waere sehr wichtig fuer mich. Flehentlich "
        +"schaut sie Dich an.";
        s2 = "Linah fragt "+player->Name()+" verlegen: Ich weiss, Du hast "
        +"sicher nicht sehr viel Zeit, aber darf ich Dich dennoch um einen "
        +"grossen Gefallen bitten? Es waere sehr wichtig fuer mich. "
        +"Flehentlich schaut sie "+player->Name()+" an.";
        break;

        case 8:
        s = "Als Du zustimmend nickst, strahlt sie Dich an und faehrt dann "
        +"fort: Oh bitte, gib Tungdil diese Karte von mir. Ich moechte ihm "
        +"fuer dieses herrliche Geschenk danken und mich mit einem Essen bei "
        +"ihm revanchieren.";
        s2 = "Als "+player->Name()+" zustimmend nickt, strahlt "
        +"sie "+player->QueryPronoun(WEN)+" an und faehrt dann fort: "
        +"Oh bitte, gib Tungdil diese Karte von mir. Ich moechte ihm "
        +"fuer dieses herrliche Geschenk danken und mich mit einem Essen bei "
        +"ihm revanchieren.";
        break;

        default:
          fkteinladung();
          seq -= ({ capitalize(getuid(TP)) });
          return;
          break;
        }

        tell_object(player, BS(s));

        ENV(TO)->Message(BS(s2),
        MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

        pos = pos + 1;
        call_out("seqring", 8, player, pos);
}

//alles zuruecksetzen, wenn Spieler waehrend der Sequenz aus dem Raum rennt
void set_back()
{
   beschaeftigt = NEIN;

   SetChats(3,
     ({Name(WER, 1)+" ruehrt in einem grossen Kessel herum.\n",
       Name(WER, 1)+" summt froehlich vor sich hin.\n",
       Name(WER, 1)+" eilt geschaeftig hin und her.\n",
       Name(WER, 1)+" fragt Dich: Darf ich Dir etwas zu essen bringen?\n",
       Name(WER, 1)+" ruft erschrocken: Huch, die Suppe kocht ja schon!\n",
       Name(WER, 1)+" deutet auf eine der Baenke und sagt freundlich: Nimm "
       +"doch Platz.\n" }));
   return;
}

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}

//Knochen fuer Yoshy:
int fktzeit()
{
  object myknochen;

  if(!KNOCHEN(TP))
  {
        myknochen = clone_object(OBJ "knochen");

        if(ME_TOO_HEAVY == myknochen->move(TP,M_GET|M_SILENT))
        {
               tell_object(TP, BS(Name(WER, 1)+" sagt: Du kannst den "
               +"Knochen leider nicht mehr tragen."));
               myknochen->remove();
               return -1;
        }
        else
        {
               tell_object(TP, BS(Name(WER, 1)+" drueckt Dir einen "
               +"grossen Knochen in die Hand."));

               ENV(TO)->Message(BS(TP->Name(WER, 1)+" nimmt einen grossen "
               +"Knochen von Linah in Empfang."),
               MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ TP })]));

               knochen += ({ capitalize(getuid(TP)) });
               return 1;
        }
  }
  else
  {
        tell_object(TP, BS(Name(WER, 1)+" sagt laechelnd: Ich habe Dir "
        +"den Knochen doch bereits gegeben."));
        return -1;
  }
}

//Test beim Verlassen des Raumes, ob man noch in der Sequenz steckt:
int exit_test(string dir)
{
        if(SEQ(TP))
        {
                write(BS("Aber Linah redet doch gerade mit Dir!"));
                return 0;
        }

        return 1;
}

//Inhalt des Arrays zurueckgeben an ug_kueche.c
string *holded()
{
  return seq;
}

//Spieler logt aus waehrend der Sequenz
void BecomesNetDead(object spieler)
{
  if(SEQ(spieler))
  {
        seq -= ({ capitalize(getuid(spieler)) });
  }

  return;
}
