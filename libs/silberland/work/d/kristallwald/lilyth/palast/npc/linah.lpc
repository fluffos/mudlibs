string *seq=({});
#define SEQ(wer) (member(seq, capitalize(getuid(wer)))!=-1)

int beschaeftigt;
void set_back();

string *knochen;
int fktzeit();
#define KNOCHEN(wer) (member(knochen, capitalize(getuid(wer)))!=-1)

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

