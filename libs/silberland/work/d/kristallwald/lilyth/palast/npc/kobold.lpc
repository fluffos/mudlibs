  AddInfo( ({"hobbits", "hobbit"}),
  "Hobbits sind lustige Geschoepfe.",
  "grinst: ");

  AddInfo( ({"geschoepfe"}),
  "Nun ja, sie denken fast immerzu nur ans Essen und rauchen dauernd diese "
