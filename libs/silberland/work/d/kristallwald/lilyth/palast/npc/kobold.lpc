  AddInfo( ({"velg'larn", "velglarn"}),
  "Er hat dort seinen Laden.",
  "deutet nach Nordwesten: ");

  AddInfo( ({"laden"}),
  "Hier gibt es viele Laeden, welchen meinst Du denn?",
