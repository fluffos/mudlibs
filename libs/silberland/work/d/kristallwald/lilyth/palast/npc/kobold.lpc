#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------

int uhrzeit();
int ausweichen;

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  ausweichen = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleiner Kobold");
  SetProp(P_LONG,
    "Der kleine Kobold ist gerade mal eineinhalb Fuss hoch. Er steht neben "
    "dem Brunnen und schaut alle paar Minuten nervoes auf die Uhr.");

  AddDetail( ({ "fuss" }),
    "Der Kobold ist wirklich ziemlich klein.");

  AddDetail( ({ "minuten" }),
    "Nervoes schaut der Kobold auf die Uhr.");

  AddDetail( ({ "uhr" }),
    "Du kannst ihn ja mal nach der Uhrzeit fragen.");

  AddDetail( ({ "uhrzeit" }),
    "Frag ihn halt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Kobold");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"kobold"}));
  AddClass( ({CL_GNOME}) );
  SetProp(P_ARTICLE, 1);

