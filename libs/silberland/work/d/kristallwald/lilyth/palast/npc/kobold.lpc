  "schimpft: ");

  AddInfo( ({"lilyth", "torian", "dinin"}),
  "etwas, das nach 'faules Magierpack!' klingt.",
  "murmelt ");

  AddInfo( ({"woody", "dusty"}),
    "vor Ehrfurcht.",
    "erstarrt ");

  AddInfo( ({"delgo"}),
  "vor Schreck fast in Ohnmacht.",
  "faellt ");

  AddInfo( ({"experimente"}),
  "Darueber will ich nicht sprechen.",
  "erbleicht und fluestert: ");

  AddInfo( ({"haende"}),
  "Wenn Du einem Magier in die Haende faellst, dann ist es aus mit Dir!",
  "jammert: ");

  AddInfo( ({"wunsch"}),
  "etwas von einer Schmiede.",
  "murmelt ");

  AddInfo( ({"spass"}),
  "Oh ja, Magier haben richtig Spass an so etwas, das kannst Du mir glauben!",
  "schnieft: ");

  AddInfo( ({"linah", "koechin"}),
  "Linah ist sehr lieb, und sie kocht absolut phantastisch!",
  "huepft froehlich herum: ");

  AddInfo( ({"kueche"}),
  "Linah's Kueche ist direkt hier im Suedwesten.",
  "sagt: ");

  AddInfo( ({"trollwaechter", "waechter", "soldat", "soldaten"}),
  "Die achten darauf, dass niemand hier Aerger macht.",
  "sagt: ");

  AddInfo( ({"aerger"}),
  "Im Palast soll niemand belaestigt werden.",
  "sagt: ");

  AddInfo( ({"heilerin", "ork", "orks", "krieg", "kriege", "hueter"}),
  "Die Geschichte des Palastes kannst Du in dem goldenen Buch nachlesen.",
  "sagt ehrfuerchtig: ");

  AddInfo( ({"buch", "goldenes buch", "goldenem buch"}),
  "stumm nach Sueden.",
  "deutet ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,50);

  AddSpell(5,1,
    Name(WER, 1)+" zaubert seinen Schabernackzauber auf Dich!\n",
    Name(WER, 1)+" zaubert seinen Schabernackzauber auf @WEN!\n",
    DT_MAGIC, "chaos_spell");

  AddSpell(5,1,
    Name(WER, 1)+" weicht Dir blitzschnell aus.\n",
    Name(WER, 1)+" weicht @WEM blitzschnell aus.\n",
    DT_MAGIC, "take_over");

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" schaut angespannt auf die Uhr.\n",
    Name(WER, 1)+" raeuspert sich leise.\n",
    Name(WER, 1)+" scheint auf etwas zu warten.\n",
    Name(WER, 1)+" blickt sich nervoes um.\n",
    Name(WER, 1)+" macht einen unruhigen Eindruck.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" pruegelt mit seinem Gloeckchen auf Dich ein!\n",
    Name(WER, 1)+" wehrt sich verzweifelt.\n",
    Name(WER, 1)+" versucht, Dich zu verzaubern!\n"  }));

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME(OBJ "gloeckchen");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt den kleinen Kobold.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "taetschelt Dir beruhigend den Arm.",
        "taetschelt "+TP->name(WEM)+" beruhigend den Arm.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "herrscht Dich an: Hey, lass das!",
        "herrscht "+TP->name(WEN)+" an: Hey, lass das!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "kichert ein wenig nervoes.",
        "kichert ein wenig nervoes.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "schreit: Pass bloss auf, sonst hole ich die Wachen!",
        "schreit: Pass bloss auf, sonst hole ich die Wachen!");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "schaut Dich finster an.",
        "schaut "+TP->name(WEN)+" finster an.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "grinst Dich an und freut sich.",
        "grinst "+TP->name(WEN)+" an und freut sich.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt empoert: Hey, ich bin verheiratet!",
        "sagt empoert: Hey, ich bin verheiratet!");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "schaut Dich freundlich an.",
        "schaut "+TP->name(WEN)+" freundlich an.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "fragt Dich nervoes: Ist es schon so spaet?",
        "fragt "+TP->name(WEN)+" nervoes: Ist es schon so spaet?");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        "troestet "+TP->name(WEN)+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  if (ausweichen)
  {
        ausweichen--;
        return ::Defend(0, dam_type, spell, enemy);
  }
  return ::Defend(dam, dam_type, spell, enemy);
}

//nach Zeit fragen:
int uhrzeit()
{
        string *zeit;
        zeit = explode( dtime(), ", ");
	ENV(TO)->Message("Der kleine Kobold sagt aufgeregt: Es ist "
	+"schon "+zeit[sizeof(zeit)-1]+" Uhr!\n",
	MSGFLAG_SOUND);
	return 1;
}

//Schabernackzauber:
void chaos_spell(object enemy,int damage,string damtype)
{
  switch(random(100))
  {
        case 0..32:
         enemy->SetProp(P_FROG, 1);
         break;
        case 33..66:
         enemy->SetProp(P_DEAF, 10 + random(20));
         break;
        case 67..99:
         enemy->SetProp(P_BLIND, 10 + random(20));
         break;
        default:
         break;
  }
  return;
}

//Ausweichzauber:
void take_over(object enemy,int damage,string damtype)
{
        if(!ausweichen)
        {
                ausweichen = 2+random(4);
        }
        return;
}
