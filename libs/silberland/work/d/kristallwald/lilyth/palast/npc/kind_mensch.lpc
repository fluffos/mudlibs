#include "../def.h"

inherit "std/mnpc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleiner Menschenjunge");
  SetProp(P_LONG,
    "Der kleine Menschenjunge hat blonde Haare, blaue Augen und sieht "
    "eigentlich ganz nett aus. Er traegt eine dunkelblaue Latzhose und "
    "gruene Turnschuhe.");

  AddDetail( ({ "haare", "haar" }),
    "Seine Haare sind hellblond und recht kurz geschnitten.");

  AddDetail( ({ "augen", "auge" }),
    "Er hat dunkelblaue Augen, mit denen er Dich neugierig ansieht.");

  AddDetail( ({ "latzhose", "hose", "traeger" }),
    "Er traegt eine dunkelblaue Latzhose mit langen Traegern.");

  AddDetail( ({ "turnschuhe", "schuhe" }),
    "Die Turnschuhe sind gruen und sehen noch recht neu aus.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Menschenjunge");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"mensch", "menschenjunge", "junge", "kind"}));
  AddClass( ({CL_HUMAN}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(7);

  SetProp(P_HANDS, ({ " mit seinen Haenden", 70, DT_BLUDGEON }) );

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 62);
  SetProp(P_WEIGHT, 41);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" sagt: Das will ich nicht haben!\n" }) );

  SetProp(P_LOG_INFO, "/lilyth/palast/kinder");

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "laeuft lachend herein");
  SetProp(P_MSGOUT, "laeuft lachend");
  SetProp(P_MMSGIN, "laeuft lachend herein");
  SetProp(P_MMSGOUT, "laeuft lachend nach Hause");

  SetProp(P_MNPC_AREA, ({ ROOM "og_treppe", ROOM "og_konditorei",
                          ROOM "og_spielzimmer", ROOM "og_bibliothek" }) );

  SetProp(P_MNPC_DEFAULTROOM, ROOM "og_treppe");
  SetProp(P_MNPC_WAIT, ({ 15, 50, 20 }));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " wird nie wieder spielen.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MURDER_MSG, "Das sage ich meinem Papa! *schluchz*");
  SetProp(P_KILL_NAME, "Ein kleiner Menschenjunge");
  SetProp(P_KILL_MSG, "Aetsch!!!");

  AddInfo( ({"mensch"}),
    "Das kannst Du doch sehen!",
    "sagt: ");

  AddInfo( ({"palast"}),
    "Du bist hier in einem grossen Palast!",
    "sagt: ");

  AddInfo( ({"mahmud"}),
    "Ich hab Mahmud lieb!",
    "strahlt: ");

  AddInfo( ({"geschichte", "geschichten"}),
    "Mahmud erzaehlt uns immer ganz tolle Geschichten!",
    "sagt: ");

  AddInfo( ({"turnschuhe"}),
    "Die hab ich gerade neu bekommen. Sind toll bequem!",
    "sagt stolz: ");

  AddInfo( ({"latzhose"}),
    "Guck mal, die hat ganz viele Taschen!",
    "prahlt: ");

  AddInfo( ({"tasche", "taschen"}),
    "Meine Latzhose hat ganz viele Taschen. Da kann man alles moegliche "
    "reinstecken.",
    "sagt: ");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "kratzt sich am Kopf.\n",
            "blickt Dich verwirrt an.\n",
            "sagt: Frag lieber jemand anders danach!\n"}));

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

  AddSpell(1,250,
    Name(WER, 1)+" schubst Dich tuechtig zu Boden!\n",
    Name(WER, 1)+" schubst @WEN tuechtig zu Boden!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(2,
  ({Name(WER, 1)+" wartet auf eines der anderen Kinder.\n",
    Name(WER, 1)+" mustert Dich kurz und laeuft dann weiter.\n",
    Name(WER, 1)+" schaut Dich neugierig an.\n",
    Name(WER, 1)+" will eine Geschichte hoeren.\n",
    Name(WER, 1)+" lacht froehlich.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" wehrt sich mit aller Kraft.\n",
    Name(WER, 1)+" pruegelt mit seinen kleinen Faeusten auf Dich ein.\n",
    Name(WER, 1)+" versucht, Dich an den Haaren zu ziehen.\n" }));

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt einen kleinen Menschenjungen.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "fragt Dich: Warum hast Du denn Angst vor mir?",
        "fragt "+TP->name(WEN)+": Warum hast Du denn Angst vor mir?");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "geht in die Ecke und schmollt.",
        "geht in die Ecke und schmollt.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "grinst Dich an.",
        "grinst "+TP->name(WER)+" an.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "ruft laut nach seinem Papa!",
        "ruft laut nach seinem Papa!");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "streckt Dir die Zunge raus.",
        "streckt "+TP->name(WEM)+" die Zunge raus.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "grinst Dich froehlich an.",
        "grinst "+TP->name(WEM)+" an.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt empoert: Fuer sowas bin ich noch zu jung!",
        "sagt empoert: Fuer sowas bin ich noch zu jung!");
      break;

    case "nett":
    case "neutral":
      call_out("reaction", 0, TP,
        "grinst Dich froehlich an.",
        "grinst "+TP->name(WEN)+" froehlich an.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich lieb.",
        "troestet "+TP->name(WEN)+" lieb.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}

//Suessigkeiten geben:
void give_notify(object was)
{
    if(was->id("\nsuesses"))
    {
        write(break_string("Der kleine Menschenjunge jubelt: "
        +"Danke, "+this_player()->Name()+"! Ich mag Dich!\nDer kleine "
        +"Menschenjunge laesst sich "+was->name(WEN)+" schmecken.\n",
        78, 0, BS_LEAVE_MY_LFS));
        
        ENV(TO)->Message(break_string("Der kleine Menschenjunge jubelt: "
        +"Danke, "+this_player()->Name()+"! Ich mag Dich!\nDer kleine "
        +"Menschenjunge laesst sich "+was->name(WEN)+" schmecken.\n",
        78, 0, BS_LEAVE_MY_LFS),
        MSGFLAG_SOUND|MSGFLAG_NO_TP);
        was->remove();
        return;
    }
    
    return ::give_notify(was);
}
