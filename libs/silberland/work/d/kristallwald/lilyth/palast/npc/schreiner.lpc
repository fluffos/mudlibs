#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Fredolin, der Schreiner");
  SetProp(P_LONG,
    "Fredolin ist ein staemmiger kleiner Hobbit mit einem stets leicht "
    "verwirrten Gesichtsausdruck. Er ist Schreiner von Beruf und den ganzen "
    "Tag lang damit beschaeftigt, fuer seine Kunden die allerbesten "
    "Holzarbeiten herzustellen. Seine Ordnungsliebe scheint nicht sehr "
    "ausgepraegt zu sein, doch seine Arbeiten sind von unuebertreffbarer "
    "Qualitaet.");

  AddDetail( ({ "hobbit" }),
    "Wie Du deutlich erkennen kannst, ist Fredolin ein Hobbit.");

  AddDetail( ({ "gesichtsausdruck" }),
    "Er wirkt ein wenig verwirrt.");

  AddDetail( ({ "schreiner" }),
    "Fredolin ist der beste Schreiner weit und breit, auch wenn er "
    "eigentlich gar nicht danach aussieht.");

  AddDetail( ({ "beruf", "herz", "herzen" }),
    "Er liebt seinen Beruf von ganzem Herzen und wuerde nie etwas anderes "
    "tun wollen.");

  AddDetail( ({ "tag" }),
    "Den ganzen Tag lang arbeitet Fredolin in seiner Werkstatt.");

  AddDetail( ({ "werkstatt" }),
    "Schau Dich mal um.");

  AddDetail( ({ "kunden", "kunde" }),
    "Fredolin hat bereits viele treue Kunden, die von seiner guten Arbeit "
    "ueberzeugt sind.");

  AddDetail( ({ "holzarbeiten", "holzarbeit", "arbeiten", "arbeit" }),
    "All seine Arbeiten sind von groesster Qualitaet.");

  AddDetail( ({ "ordnungsliebe" }),
    "Besonders ordentlich ist Fredolin wahrlich nicht. Sein schon ziemlich "
    "altes Hemd ist voellig verrutscht und seine Hose muesste auch mal "
    "wieder geflickt werden.");

  AddDetail( ({ "hemd" }),
    "Das Hemd scheint schon so manches Jahr auf dem Buckel zu haben. Es "
    "steckt unordentlich und voellig schief in der loechrigen Wollhose.");

  AddDetail( ({ "hose", "flicken", "loecher", "wollhose" }),
    "Die Hose weist zahlreiche bunte Flicken und ebenso viele noch "
    "ungeflickte Loecher auf.");

  AddDetail( ({ "qualitaet", "wert" }),
    "Auf eine gute Qualitaet seiner Arbeiten legt Fredolin grossen Wert.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Fredolin");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"fredolin", "schreiner", "hobbit", "ladeninhaber", "inhaber",
  "NOWIMPY"}));
  AddClass( ({CL_HOBBIT}) );
  SetProp(P_ARTICLE, 0);

  set_living_name("fredolin");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(18);

  SetProp(P_HANDS, ({ " mit seinen Haenden", 180, DT_BLUDGEON }) );

  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 61);
  SetProp(P_WEIGHT, 41000);
  SetProp(P_ALIGN, 130);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" fragt verwirrt: Was soll ich denn damit?\n" }) );

  SetProp(P_LOG_INFO, "/lilyth/palast/schreiner");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_LIGHTNING:  0.1,
       DT_SOUND:      0.2,
       DT_POISON:     0.1,
       DT_TERROR:    -0.1,
       DT_MAGIC:     -0.1 ]));

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "stolpert herein");
  SetProp(P_MSGOUT, "stolpert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Fredolin");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "ist gerade sehr beschaeftigt.\n",
            "kratzt sich nachdenklich am Kopf.\n",
            "schaut Dich voellig verwirrt an.\n"}));

  AddInfo( ({"palast"}),
    "Welcher Palast? Ach so... der Palast... nun ja, ich habe vor einiger "
    "Zeit meine Schreinerei hier eroeffnet.",
    "sagt verwirrt: ");

  AddInfo( ({"schreinerei"}),
    "Aber da befindest Du Dich doch gerade.",
    "wundert sich: ");

  AddInfo( ({"zeit"}),
    "So genau weiss ich das gar nicht mehr.",
    "schnauft: ");

  AddInfo( ({"angebot", "waren", "lager", "moment"}),
    "Mein aktuelles Angebot kannst Du der Tafel dort entnehmen. Es "
    "koennte sich allerdings lohnen, oefters mal vorbeizuschauen, da ich "
    "stets bemueht bin, mein Sortiment zu erweitern.",
    "sagt: ");

  AddInfo( ({"sortiment"}),
    "Mein Angebot wird hoffentlich bald noch groesser werden. Wenn Du einen "
    "speziellen Wunsch hast, solltest Du Dich allerdings an Lilyth wenden, "
    "die ueberwacht naemlich meine Lieferungen sehr kritisch.",
    "sagt: ");

  AddInfo( ({"wunsch"}),
    "Da solltest Du Dich an Lilyth wenden.",
    "sagt: ");

  AddInfo( ({"lilyth"}),
    "Kennst Du sie etwa?",
    "fragt erstaunt: ");

  AddInfo( ({"ceyth", "bogenhaendler"}),
    "Ceyth ist ein guter Freund von mir.",
    "strahlt: ");

  AddInfo( ({"freund"}),
    "Er hat mir einmal das Leben gerettet.",
    "sagt ehrfurchtsvoll: ");

  AddInfo( ({"leben"}),
    "Einmal, als ich mit einer Holzlieferung auf dem Weg zum Palast "
    "war, wurde ich von einem schrecklichen Ungeheuer angegriffen. Zum "
    "Glueck kam Ceyth gerade zufaellig dort vorbei und hat mich gerettet.",
    "erinnert sich: ");

  AddInfo( ({"ungeheuer"}),
    "Ich glaube, es war ein Nekromant!",
    "schaudert: ");

  AddInfo( ({"nekromant"}),
    "W-w-w-w-weil e-e-er so.. so... so sch-schrecklich d-dunkle Augen "
    "u-u-und g-ganz ver-verfaulte Ha-Haut ha-hatte.",
    "faengt an zu zittern: ");

  AddInfo( ({"augen", "haut"}),
    "Dich voellig veraengstigt an.",
    "starrt ");

  AddInfo( ({"holzlieferung", "lieferung", "holz"}),
    "Ich bestelle mein Holz immer bei Sawer.",
    "sagt: ");

  AddInfo( ({"sawer"}),
    "Du findest ihn im Holzfaellerlager nordoestlich von Derlim.",
    "sagt nachdenklich: ");

  AddInfo( ({"holzfaellerlager", "lager"}),
    "Das Holzfaellerlager liegt nordoestlich von Derlim.",
    "denkt kurz nach: ");

  AddInfo( ({"derlim"}),
    "Das ist meine Heimat.",
    "strahlt: ");

  AddInfo( ({"heimat"}),
    "Derlim ist meine Heimat.",
    "sagt froehlich: ");

  AddInfo( ({"fischhaendler", "obstverkaeufer"}),
    "Ich glaube, ich habe hier schon mal irgendwo einen gesehen...",
    "kratzt sich am Kopf: ");

  AddInfo( ({"kobold"}),
    "Er ist immer beim Brunnen zu finden.",
    "sagt: ");

  AddInfo( ({"velg'larn", "velglarn"}),
    "Sein Laden ist irgendwo beim Brunnen.",
    "sagt aengstlich: ");

  AddInfo( ({"brunnen"}),
    "Der Brunnen liegt westlich von hier.",
    "gruebelt: ");

  AddInfo( ({"tungdil", "schmied"}),
    "Tungdil ist der Schmied hier im Palast. Ich arbeite manchmal mit ihm "
    "zusammen.",
    "sagt: ");

  AddInfo( ({"schmiede"}),
    "Die Schmiede befindet sich in der Naehe des Brunnens.",
    "gruebelt: ");

  AddInfo( ({"linah", "koechin", "kueche"}),
    "Linah hat eine kleine Kueche in der Naehe des Brunnens.",
    "gruebelt: ");

  AddInfo( ({"trollwaechter", "waechter"}),
    "Ich glaube, draussen vor dem Palast stehen zwei.",
    "denkt nach: ");

  AddInfo( ({"soldat", "soldaten"}),
    "Ja, ich glaube, es laufen ein paar Soldaten im Palast herum und passen "
    "auf, dass niemandem etwas geschieht.",
    "kratzt sich am Kopf: ");

  AddInfo( ({"yoshy", "hund", "katze"}),
    "Schau mal draussen nach.",
    "denkt nach: ");

  AddInfo( ({"alenari", "kartenzeichnerin", "zeichnerin", "kellnerin",
  "teestube", "varaile", "haendlerin", "tierhandlung", "konditorei"}),
    "Hmm, ich glaube, die ist oben irgendwo...",
    "sagt verwirrt: ");

  AddInfo( ({"gordrogh", "tierhaendler", "mahmud", "geschichtenerzaehler",
  "thimon"}),
    "Ich glaube, der ist irgendwo oben.",
    "kratzt sich am Kopf: ");

  AddInfo( ({"buecherregal"}),
    "In das Buecherregal passen nicht ganz so viele Buecher hinein wie in "
    "den Schrank. Aber vielleicht reicht es Dir ja.",
    "sagt: ");

  AddInfo( ({"buecherschrank"}),
    "Wenn man sehr viele Buecher hat, kann man sie doch gut in einem "
    "solchen Schrank unterbringen. Dann hat man alles auf einen Blick "
    "zusammen.",
    "sagt: ");

  AddInfo( ({"schaukelpferd"}),
    "Das ist eines meiner Lieblingsstuecke.",
    "sagt stolz: ");

  AddInfo( ({"lieblingsstuecke"}),
    "Das Schaukelpferd ist eines meiner Lieblingsstuecke. Ich habe sehr "
    "lange daran gearbeitet und gebe es eigentlich nur ungerne her.",
    "sagt: ");

  AddInfo( ({"waffenstaender", "staender"}),
    "Der Waffenstaender ist ideal, um darin Waffen aufzubewahren.",
    "nickt: ");

  AddInfo( ({"ofen", "holzofen"}),
    "Der Holzofen verwandelt jedes Seherhaus in einen gemuetlichen Ort.",
    "beteuert: ");

  AddInfo( ({"seherhaus"}),
    "Hast Du etwa noch keines?",
    "fragt: ");

  AddInfo( ({"brennholz"}),
    "Ich habe meistens genuegend Brennholz da.",
    "kratzt sich am Kopf: ");

  AddInfo( ({"waffen", "waffe"}),
    "Ich habe keine Waffen hier!",
    "erschrickt: ");

  AddInfo( ({"spiegel"}),
    "Nun, einen Spiegel kann man doch immer gebrauchen, oder?",
    "sagt verwirrt: ");

  AddInfo( ({"betten"}),
    "Ich habe stets einige Betten in meinem Angebot, es schlaeft ja "
    "niemand gerne auf dem Boden.",
    "schnauft: ");

  AddInfo( ({"boden"}),
    "Schlaefst Du gerne auf dem Boden?",
    "fragt verwundert: ");

  AddInfo( ({"himmelbett"}),
    "Meinst Du jetzt das weisse oder das schwarze Himmelbett?",
    "fragt verwirrt: ");

  AddInfo( ({"weisses himmelbett", "weisses bett", "weissem himmelbett",
  "weissem bett"}),
    "Das weisse Himmelbett habe ich extra fuer Elfen angefertigt.",
    "sagt stolz: ");

  AddInfo( ({"elfen", "hobbits", "zwerge", "trolle", "oger", "menschen"}),
    "Dich gruebelnd.",
    "mustert ");

  AddInfo( ({"bluetenbett"}),
    "In das Bluetenbett passt leider nur eine Fee hinein.",
    "sagt bedauernd: ");

  AddInfo( ({"fee"}),
    "Bist Du eine?",
    "fragt verwirrt: ");

  AddInfo( ({"holzbett"}),
    "Fuer Zwerge oder Hobbits wie mich ist das Holzbett genau richtig. "
    "Ich habe auch so eins.",
    "beteuert: ");

  AddInfo( ({"riesiges bett", "riesigem bett"}),
    "Das war vielleicht eine Arbeit, kann ich Dir sagen! So ein grosses "
    "Bett habe ich noch nie zuvor angefertigt. Aber auch Trolle und Oger "
    "wollen ja irgendwo schlafen.",
    "schnauft: ");

  AddInfo( ({"grosses bett", "grossem bett"}),
    "Das grosse Bett ist fuer Menschen gemacht.",
    "sagt: ");

  AddInfo( ({"schwarzes bett", "schwarzes himmelbett", "schwarzem bett",
  "schwarzem himmelbett"}),
    "Das wollte Lilyth unbedingt haben. Sie meinte irgendetwas von wegen "
    "'stilvoll schlafen' und so... Nun ja, und ich muss ja nun einmal "
    "auf sie hoeren. Auch wenn ich wohl niemals begreifen werde, wie man "
    "in so etwas schrecklich Finsterem schlafen kann.",
    "gruebelt: ");

  AddInfo( ({"finsteres", "finsterem"}),
    "Nun, sieh es Dir doch an! Es ist komplett schwarz! Aber Dunkelelfen "
    "scheinen sowas ja zu moegen.",
    "sagt vorwurfsvoll: ");

  AddInfo( ({"dunkelelfen"}),
    "Fuer die ist das schwarze Bett wohl gut geeignet.",
    "sagt ratlos: ");

  AddInfo( ({"arbeiten", "arbeit", "beruf", "schreiner"}),
    "Ich bin Schreiner von Beruf.",
    "erklaert: ");

  AddInfo( ({"werkzeug", "werkzeuge"}),
    "Ohne mein Werkzeug kann ich nicht arbeiten.",
    "sagt verwirrt: ");

  AddInfo( ({"leim", "fuchsschwanz", "winkel"}),
    "Den brauche ich zum Arbeiten.",
    "kratzt sich am Kopf: ");

  AddInfo( ({"hobelbank", "farbtoepfe", "farbe", "farben", "naegel", 
  "schrauben", "handsaege", "schraubzwinge", "schraubzwingen"}),
    "Die brauche ich fuer meine Arbeit.",
    "sagt: ");

  AddInfo( ({"schleifpapier", "schnitzmesser"}),
    "Das brauche ich zum Arbeiten.",
    "sagt: ");

  AddInfo( ({"qualitaet"}),
    "Ich hoffe, Du bist mit der Qualitaet meiner Arbeiten zufrieden.",
    "sagt verunsichert: ");

  AddInfo( ({"unordnung", "ordnung"}),
    "Nun ja, ich bin einfach nicht so ordentlich wie andere Hobbits. Aber "
    "bei meiner Arbeit lege ich sehr grossen Wert auf hoechste Qualitaet.",
    "seufzt: ");

  AddInfo( ({"wert"}),
    "Ich lege sehr grossen Wert auf eine gute Qualitaet meiner Waren.",
    "beteuert: ");

  AddInfo( ({"stuehle"}),
    "Im Moment kann ich Dir leider keine Stuehle anbieten. Komm einfach "
    "spaeter nochmal wieder.",
    "bedauert: ");

  AddInfo( ({"kommode"}),
    "Die ist noch nicht fertig.",
    "sagt: ");

  AddInfo( ({"schraenke"}),
    "Hmm, meinst Du den grossen Buecherschrank?",
    "sagt verwirrt: ");

  AddInfo( ({"saegespaene", "spaene"}),
    "auf den Boden.",
    "deutet ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

  AddDefaultSpell(2, 1, DS_BLIND,
    BS(Name(WER, 1)+" kippt einen Farbeimer ueber Deinem Kopf aus, so dass "
    +"Du einen Moment lang blind umhertaumelst!"),
    BS(Name(WER, 1)+" kippt einen Farbeimer ueber @WESSEN Kopf aus!"), 3);

  AddSpell(4,350,
    Name(WER, 1)+" schlaegt Dir eine grosse Holzleiste ueber den Kopf!\n",
    Name(WER, 1)+" schlaegt @WEM eine grosse Holzleiste ueber den Kopf!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" laeuft geschaeftig durch die Werkstatt.\n",
    Name(WER, 1)+" kratzt sich verwirrt am Kopf.\n",
    Name(WER, 1)+" schaut Dich ein wenig verwundert an.\n",
    Name(WER, 1)+" zersaegt eine der langen Holzleisten.\n",
    BS(Name(WER, 1)+" schleppt schnaufend ein paar Bretter zur Hobelbank.\n"),
    BS(Name(WER, 1)+" streicht eine Kommode mit leuchtend bunten Farben "
    "an.\n"),
    BS(Name(WER, 1)+" wischt achtlos einen Haufen Saegespaene von der "
    "Hobelbank auf den Boden.\n"),
    BS(Name(WER, 1)+" schnitzt froehlich pfeifend an einem kleinen Stueck "
    "Holz herum.\n") }));

  SetAttackChats(10,
  ({Name(WER, 1)+" jammert laut vor sich hin.\n",
    Name(WER, 1)+" wirft Dir eine Handvoll Saegespaene ins Gesicht.\n",
    Name(WER, 1)+" ruft laut um Hilfe!\n" }));

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME("/p/armour/armour/hemd");
  CLONEME("/p/armour/trousers/wollhose");
  CLONEME("/p/armour/boots/sandalen");
  command("trage alles");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt Fredolin.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "taetschelt Dir ein wenig verwirrt den Kopf.",
        "taetschelt "+TP->name(WEM)+" ein wenig verwirrt den Kopf.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "schaut Dich voellig verstoert an.",
        "schaut "+TP->name(WEN)+" voellig verstoert an.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "zwinkert Dir albern zu.",
        "zwinkert "+TP->name(WEM)+" albern zu.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "schnieft: Ich habe Dir doch gar nichts getan.",
        "schnieft: Ich habe Dir doch gar nichts getan.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "runzelt leicht die Stirn.",
        "runzelt leicht die Stirn.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "kratzt sich verwirrt am Kopf.",
        "kratzt sich verwirrt am Kopf.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "raeuspert sich verlegen.",
        "raeuspert sich verlegen.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "klopft Dir auf die Schulter.",
        "klopft "+TP->name(WEM)+" auf die Schulter.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "schaut Dich mit grossen Augen an.",
        "schaut "+TP->name(WEN)+" mit grossen Augen an.");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "fragt Dich besorgt: Och, was hast Du denn?",
        "fragt "+TP->name(WEN)+" besorgt: Was hast Du denn?");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}
