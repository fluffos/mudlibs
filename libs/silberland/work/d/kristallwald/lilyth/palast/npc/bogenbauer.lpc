#include "../def.h"

//inherit "std/npc";
inherit "/std/npc/spells";
inherit "std/repair";

//--Variablen&Defines------------------------------------------------------

int ausweichen;

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  ausweichen = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ceyth, der Bogenbauer");
  SetProp(P_LONG,
    "Vor Dir steht ein hochgewachsener Halbelf mit langen schwarzglaenzenden "
    "Haaren und unergruendlichen meeresgruenen Augen. In seiner linken Hand "
    "haelt er einen grossen Langbogen, in der rechten einen Koecher mit "
    "Pfeilen. Mit ruhigem Blick schaut er Dich aufmerksam an, als Du den "
    "Laden betrittst.");

  AddDetail( ({ "halbelf", "elf" }),
    "Ceyth ist ein Halbelf, was Du an seinen nicht sehr spitzen Ohren, den "
    "tiefschwarzen Haaren und der fuer einen Elfen ein wenig zu kraeftigen "
    "Figur erkennen kannst.");

  AddDetail( ({ "ohren", "ohr" }),
    "Die fuer Elfen so typischen spitzen Ohren sind bei Ceyth fast "
    "menschenaehnlich rund geformt.");

  AddDetail( ({ "haare", "haar" }),
    "Ein wenig verwundert betrachtest Du die langen tiefschwarzen Haare "
    "des Halbelfs.");

  AddDetail( ({ "figur" }),
    "Fuer einen Elfen ist Ceyth ein wenig zu kraeftig gebaut.");

  AddDetail( ({ "augen", "auge" }),
    "Als Du dem ruhigen Blick seiner gruenen Augen begegnest, hast Du das "
    "Gefuehl, dass Ceyth bereits alles ueber Dich weiss, obwohl Du ihm noch "
    "nie zuvor begegnet bist.");

  AddDetail( ({ "hand" }),
    "In der linken Hand haelt Ceyth einen grossen, glaenzenden Bogen.");

  AddDetail( ({ "langbogen", "bogen" }),
    "Dieser Bogen wurde wohl gerade von Ceyth fertiggestellt. Er betrachtet "
    "ihn gruendlich von allen Seiten und prueft sein Gewicht.");

  AddDetail( ({ "koecher" }),
    "In seiner rechten Hand haelt er einen Koecher mit Pfeilen darin.");

  AddDetail( ({ "pfeile", "pfeil" }),
    "Eine Handvoll gefiederter Pfeile steckt in dem Koecher.");

  AddDetail( ({ "blick" }),
    "Mit ruhigem Blick schaut Dich der Halbelf an.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Ceyth");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"ceyth", "bogenbauer", "halbelf", "Bogenmeister", "NOWIMPY"}));
  AddClass( ({CL_ELF}) );
  SetProp(P_ARTICLE, 0);

  set_living_name("ceyth");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(20);

  SetProp(P_HANDS, ({ " mit seinen Haenden", 200, DT_BLUDGEON }) );

  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 193);
  SetProp(P_WEIGHT, 70000);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" sagt: Das brauchst Du doch sicher selbst.\n" }) );

  SetProp(P_LOG_INFO, "/lilyth/palast/ceyth");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_HOLY:    0.1,
       DT_UNHOLY:  0.1,
       DT_MAGIC:  -0.2,
       DT_MIND:   -0.1 ]));

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt leisen Schrittes herein");
  SetProp(P_MSGOUT, "geht leise");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ceyth");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "blickt Dich schweigend an.\n");

  AddInfo( ({"bogenladen"}),
  "Ja, dies ist ein Bogenladen. Wenn Du auf der Suche nach einem "
  "Bogen bist, bist Du hier richtig.",
  "nickt: ");

  AddInfo( ({"suche"}),
  "Wir sind doch alle auf der Suche nach irgend etwas, oder?",
  "laechelt Dir zu: ");

  AddInfo( ({"angebot"}),
  "Du kannst Dir mein Angebot mit 'zeige' ansehen.",
  "sagt: ");

  AddInfo( ({"fredolin","schreiner"}),
  "Fredolin ist ein kleiner Hobbit, der eine Schreinerei hier im Palast "
  "besitzt. Ich bin seit einem kleinen Zwischenfall mit ihm befreundet.",
  "laechelt: ");

  AddInfo( ({"hobbit", "hobbits"}),
  "Hobbits sind sehr liebenswuerdige Geschoepfe.",
  "sagt laechelnd: ");

  AddInfo( ({"halbelf"}),
  "Ja, ich bin ein Halbelf. Meine Mutter war eine Elfe und mein Vater "
  "gehoerte der menschlichen Rasse an.",
  "sagt ruhig: ");

  AddInfo( ({"elfen", "elfe"}),
  "Meine Mutter war eine Elfe...",
  "sagt leise: ");

  AddInfo( ({"eltern"}),
  "Sie sind bei einem Ueberfall von Orks umgekommen.",
  "seufzt: ");

  AddInfo( ({"ueberfall", "orks"}),
  "Ich war noch sehr jung, vielleicht acht oder neun Jahre alt, als es "
  "geschah.",
  "erinnert sich: ");

  AddInfo( ({"mutter"}),
  "Sie war wunderschoen, so wie es alle Elfen sind...",
  "erinnert sich wehmuetig: ");

  AddInfo( ({"vater"}),
  "Mein Vater war ein sehr edler und tapferer Mensch. Ich habe ihn "
  "als Kind sehr verehrt.",
  "laechelt traurig: ");

  AddInfo( ({"mensch", "menschen"}),
  "Auch ich habe menschliches Blut in mir, denn mein Vater war einer von "
  "ihnen.",
  "laechelt: ");

  AddInfo( ({"kind"}),
  "Es ist schon sehr lange her.",
  "laechelt: ");

  AddInfo( ({"zwischenfall"}),
  "Nun ja, er war einmal unterwegs zum Palast und wurde von einem "
  "Unterweltwesen angegriffen. Gluecklicherweise hatte ich ebenfalls gerade "
  "in der Gegend zu tun und konnte ihm helfen.",
  "sagt verlegen: ");

  AddInfo( ({"unterweltwesen", "nekromant", "nekromanten"}),
  "Es handelte sich vermutlich um einen Nekromanten.",
  "sagt nachdenklich: ");

  AddInfo( ({"gegend"}),
  "Ich war zufaellig gerade dort unterwegs.",
  "sagt: ");

  AddInfo( ({"schreinerei"}),
  "Sie liegt oestlich des Brunnens.",
  "sagt: ");

  AddInfo( ({"brunnen"}),
  "Der Brunnen befindet sich etwas weiter oestlich von hier.",
  "sagt: ");

  AddInfo( ({"palast"}),
  "Du befindest Dich hier in einem Palast.",
  "laechelt: ");

  AddInfo( ({"fischhaendler", "obsthaendler"}),
  "Den findest Du sicher draussen auf dem Vorhof.",
  "sagt: ");

  AddInfo( ({"yoshy", "hund"}),
  "Der laeuft meistens draussen irgendwo herum.",
  "laechelt: ");

  AddInfo( ({"katze"}),
  "Draussen auf dem Vorhof ist eine.",
  "sagt laechelnd: ");

  AddInfo( ({"kobold"}),
  "Der ist immer beim Brunnen zu finden.",
  "laechelt: ");

  AddInfo( ({"velg'larn", "velglarn"}),
  "Velg'larns Laden findest Du in der Naehe des Brunnens.",
  "sagt: ");

  AddInfo( ({"laden"}),
  "Nun, welchen Laden meinst Du denn genau?",
  "fragt ruhig: ");

  AddInfo( ({"naehe"}),
  "Es ist ganz in der Naehe.",
  "sagt: ");

  AddInfo( ({"tungdil", "schmied", "schmiede"}),
  "Die Schmiede befindet sich nahe beim Brunnen.",
  "sagt: ");

  AddInfo( ({"linah", "koechin", "kueche"}),
  "Linahs Kueche findest Du in der Naehe des Brunnens.",
  "sagt: ");

  AddInfo( ({"alenari", "kartenzeichnerin"}),
    "Alenari findest Du irgendwo oben im Palast.",
    "sagt: ");

  AddInfo( ({"gordrogh", "tierhaendler", "tierhandlung"}),
    "Gordrogh hat seine Tierhandlung oben im Palast.",
    "sagt: ");

  AddInfo( ({"teestube", "kellnerin"}),
    "Die Teestube befindet sich weiter oben im Palast.",
    "sagt: ");

  AddInfo( ({"mahmud", "geschichtenerzaehler"}),
    "Mahmud ist sicherlich oben bei den Kindern.",
    "gruebelt: ");

  AddInfo( ({"kinder", "kind"}),
    "Schau mal oben im Palast nach.",
    "sagt: ");

  AddInfo( ({"varaile"}),
    "Varaile hat einen kleinen Laden oben im Palast. Geh ruhig mal hin, "
    "es lohnt sich bestimmt.",
    "sagt: ");

  AddInfo( ({"thimon", "konditorei"}),
    "Die Konditorei liegt oben im Palast.",
    "sagt: ");

  AddInfo( ({"trollwaechter", "waechter"}),
  "Sie bewachen das Portal draussen vor dem Palast.",
  "erklaert: ");

  AddInfo( ({"portal"}),
  "Das Portal drausen vor dem Palast wird von Trollwaechtern bewacht.",
  "sagt: ");

  AddInfo( ({"soldat", "soldaten"}),
  "Die Soldaten achten darauf, dass keiner der Besucher im Palast belaestigt "
  "wird.",
  "sagt: ");

  AddInfo( ({"besucher", "palastbesucher"}),
  "Solche wie Du.",
  "laechelt Dir zu: ");

  AddInfo( ({"boegen", "bogen", "lager", "langbogen", "kurzbogen", 
  "kompositbogen", "langboegen", "kurzboegen", "kompositboegen"}),
  "Ich habe immer einige Boegen auf Lager.",
  "sagt: ");

  AddInfo( ({"zielscheibe", "scheibe"}),
    "Die Zielscheibe dient mir zum Ueben und zum Ausprobieren neuer Boegen.",
    "laechelt: ");

  AddInfo( ({"ueben", "ausprobieren", "uebung"}),
    "Ein wenig Uebung hat noch niemandem geschadet.",
    "sagt laechelnd: ");

  AddInfo( ({"koecher"}),
    "Darin bewahrt man seine Pfeile auf.",
    "erklaert geduldig: ");

  AddInfo( ({"pfeil", "pfeile"}),
    "Dir einen nagelneuen Pfeil.",
    "zeigt ");

//genauere Infos bezueglich der untersch. Boegen und so kommen erst spaeter

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

  AddSpell(4,750,
    Name(WER, 1)+" schiesst einen Pfeil auf Dich ab und trifft Dich "
    +"schmerzhaft!\n",
    "@WER wird von einem Pfeil getroffen!\n",
    DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(5,1,
    Name(WER, 1)+" weicht Dir geschickt aus.\n",
    Name(WER, 1)+" weicht @WEM geschickt aus.\n",
    DT_MAGIC, "take_over");

//--Chats------------------------------------------------------------------

  SetChats(2,
  ({Name(WER, 1)+" haelt pruefend einen Bogen in die Luft.\n",
    Name(WER, 1)+" repariert eine zerrissene Sehne.\n",
    Name(WER, 1)+" betrachtet Dich aufmerksam.\n",
    Name(WER, 1)+" nimmt ein paar Pfeilspitzen aus einem der Regale.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" spannt seinen Bogen und zielt auf Dich.\n",
    Name(WER, 1)+" verteidigt sich fast voellig geraeuschlos.\n",
    Name(WER, 1)+" bewegt sich blitzschnell um Dich herum.\n",
    Name(WER, 1)+" versucht, den Abstand zu Dir zu vergroessern.\n" }));

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME(WEAPON "ceyth_bogen");
  command("zuecke bogen");

  CLONEME("/p/armour/cloak/umhang");
  CLONEME("/p/armour/trousers/seidenhose");
  CLONEME("/p/armour/boots/lederstiefel");
  command("trage alles");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt Ceyth.\n");

 ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "laechelt Dir beruhigend zu.",
        "laechelt "+TP->name(WEM)+" beruhigend zu.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "sagt: Das wuerde ich an Deiner Stelle lieber sein lassen.",
        "sagt: Das wuerde ich an Deiner Stelle lieber sein lassen.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "blickt Dich schweigend an.",
        "blickt "+TP->name(WEN)+" schweigend an.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "deutet mit einem ueberlegenen Laecheln auf seinen Bogen.",
        "deutet mit einem ueberlegenen Laecheln auf seinen Bogen.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "wirft Dir einen tadelnden Blick zu.",
        "wirft "+TP->name(WEM)+" einen tadelnden Blick zu.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "schmunzelt leise.",
        "schmunzelt leise.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "runzelt ein wenig die Stirn.",
        "runzelt ein wenig die Stirn.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "nickt Dir freundlich zu.",
        "nickt "+TP->name(WEM)+" freundlich zu.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "deutet schweigend auf die Regale.",
        "deutet schweigend auf die Regale.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "mustert Dich mitleidig.",
        "mustert "+TP->name(WEN)+" mitleidig.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Ausweichzauber:
void take_over(object enemy,int damage,string damtype)
{
        if(!ausweichen)
        {
                ausweichen = 2+random(4);
        }
        return;
}

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  if (ausweichen)
  {
        ausweichen--;
        return ::Defend(0, dam_type, spell, enemy);
  }
  return ::Defend(dam, dam_type, spell, enemy);
}

//Reparaturen:
int rep_auswahl(object ob)
{
  //Bogen - ja oder nein?
  if(!(ob->QueryProp(P_WEAPON_TYPE) == "bow"))
  {
    TP->Message(BS(Name(WER,1)+" sagt entschuldigend: Ich kann leider nur "
    +"Boegen reparieren!"),
    MSGFLAG_SOUND);
    return 0;
  }

  return 1;
}
