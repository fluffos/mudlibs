            "scheint zu ueberlegen.\n",
            "laechelt nur.\n"}));

  AddInfo("lilyth", "Sie ist mir ein wenig unheimlich...","sagt verlegen: ");

  AddInfo( ({"teestube", "stube"}),
    "Das hier ist eine Teestube. Hier kannst Du viele verschiedene Sorten "
    "von Tee trinken. Meistens haben wir auch eine kleine Auswahl an "
    "frischen Teeblaettern zum Mitnehmen im Angebot.",
    "sagt laechelnd: ");

  AddInfo( ({"sorte", "sorten", "teesorte", "teesorten"}),
    "Schau Dir doch mal die Teekarte an, dort sind alle Tees, die Du hier "
    "bestellen kannst, zu finden.",
    "sagt freundlich: ");

  AddInfo( ({"teekarte"}),
    "Auf jedem Tisch findest Du eine Teekarte. Du solltest sie Dir mal "
    "ansehen, wenn Du Tee trinken moechtest.",
    "sagt: ");

  AddInfo( ({"tisch", "tische", "platz", "sessel", "sofa", "sofas"}),
    "Es ist bestimmt noch irgendwo Platz fuer Dich an einem der Tische.",
    "sagt: ");

  AddInfo( ({"auswahl"}),
    "Wir haben stets eine kleine, aber sorgfaeltig zusammengestellte "
    "Auswahl an frischen Teeblaettern im Angebot.",
    "sagt: ");

  AddInfo( ({"teeblaetter", "blaetter"}),
    "Nun, wenn Du Dir selbst Tee kochen moechtest, brauchst Du dazu wohl "
