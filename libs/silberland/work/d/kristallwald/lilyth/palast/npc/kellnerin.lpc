#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine junge Kellnerin");
  SetProp(P_LONG,
    "Ein junges Maedchen mit hellbraunen Haaren bedient hier die "
    "Palastbesucher. Leise und aufmerksam eilt sie von einem zum "
    "naechsten und bleibt ab und zu stehen, um ein paar freundliche "
    "Worte mit jemandem zu wechseln.");

  AddDetail( ({ "haare", "haar" }),
    "Sie hat halblange, hellbraune Haare, die sie locker zu einem einfachen "
    "Zopf zusammengebunden hat.");

  AddDetail( ({ "zopf" }),
    "Ihre Haare sind zu einem lockeren Zopf zusammengebunden.");

  AddDetail( ({ "palastbesucher", "besucher" }),
    "Sie bedient die Palastbesucher, die sich hier aufhalten.");

  AddDetail( ({ "worte" }),
    "Ab und zu wechselt sie ein paar leise Worte mit einem der Besucher.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Kellnerin");
  SetProp(P_NAME_ADJ, "jung");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"kellnerin", "maedchen", "mensch"}));
  AddClass( ({CL_HUMAN}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(16);

  SetProp(P_HANDS, ({ " mit ihren Haenden", 160, DT_BLUDGEON }) );

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170);
  SetProp(P_WEIGHT, 50000);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" wundert sich: Was soll ich denn damit?\n" }) );

  SetProp(P_LOG_INFO, "/lilyth/palast/kellnerin");

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Ein junge Kellnerin");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
