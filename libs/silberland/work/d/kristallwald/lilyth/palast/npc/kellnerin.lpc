    "sagt: ");

  AddInfo( ({"teeservice", "service"}),
    "Ich glaube, wir haben heute eines im Angebot.",
    "sagt: ");

  AddInfo( ({"tee", "teetasse", "teekanne", "teekaennchen"}),
