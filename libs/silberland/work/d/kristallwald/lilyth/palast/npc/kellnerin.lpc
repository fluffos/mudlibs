  AddInfo( ({"lieblingstee", "lieblingstees"}),
    "Ich mag am liebsten den Weihnachtstee!",
    "sagt: ");

  AddInfo( ({"weihnachten"}),
    "Ich liebe Weihnachten!",
    "strahlt wie ein kleines Kind: ");

  AddInfo( ({"zimt", "aepfel", "apfel", "nuesse", "nuss"}),
    "Das erinnert mich immer an Weihnachten.",
    "sagt: ");

  AddInfo( ({"sachen", "verbindung"}),
    "Nun, alles, was man so mit Weihnachten in Verbindung bringt.",
    "sagt: ");

  AddInfo( ({"sonderaktion", "aktion", "sonderaktionen", "aktionen",
  "taefelchen"}),
    "schweigend auf ein Taefelchen.",
    "deutet ");

  AddInfo( ({"mensch"}),
    "Ich stamme aus Midas, der Menschenstadt.",
    "sagt froehlich: ");

  AddInfo( ({"midas"}),
    "Da komme ich her.",
    "laechelt: ");

  AddInfo( ({"menschenstadt", "hauptstadt"}),
    "Midas ist die Hauptstadt meiner Rasse.",
    "erklaert: ");

  AddInfo( ({"rasse"}),
    "Also, dass ich keine Zwergin bin, kannst Du doch wohl erkennen, oder?",
