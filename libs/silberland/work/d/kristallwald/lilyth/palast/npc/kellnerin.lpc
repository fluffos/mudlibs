    "schnauft: ");

  AddInfo( ({"zeit", "plauderei", "plaudereien"}),
    "Ich sollte lieber die Gaeste bewirten, statt hier mit Dir zu plaudern.",
    "seufzt: ");




//-------------------------------------------------------------------------

  AddInfo( ({"silberland"}),
    "Das alles hier gehoert zum Silberland.",
    "sagt: ");

  AddInfo( ({"palast"}),
    "Dort befindest Du Dich doch gerade.",
    "wundert sich: ");

  AddInfo( ({"yoshy", "hund"}),
    "Yoshy ist ein kleiner Hund, der meistens draussen irgendwo "
    "herumlaeuft.",
    "sagt: ");

  AddInfo( ({"katze"}),
    "Die Katze findest Du irgendwo draussen vor dem Palast.",
    "sagt: ");

  AddInfo( ({"fischhaendler", "fisch"}),
    "Den Fischhaendler findest Du draussen vor dem Palast.",
    "sagt: ");

  AddInfo( ({"obstverkaeufer", "obst"}),
    "Den Obstverkaeufer findest Du draussen vor dem Palast.",
    "sagt: ");

  AddInfo( ({"trollwaechter", "waechter"}),
    "Die sind draussen vor dem Palast und bewachen das Eingangsportal.",
    "sagt: ");

  AddInfo( ({"portal", "eingangsportal"}),
    "Das grosse Eingangsportal zum Palast wird von Trollwaechtern "
    "bewacht.",
    "erklaert: ");

  AddInfo( ({"kobold", "brunnen"}),
    "Der ist im Untergeschoss.",
    "sagt: ");

  AddInfo( ({"linah", "koechin", "kueche"}),
    "Linah findest Du unten im Untergeschoss.",
    "sagt: ");

  AddInfo( ({"tungdil", "schmied", "schmiede"}),
    "Den Schmied findest Du irgendwo im Untergeschoss.",
    "sagt: ");

  AddInfo( ({"velg'larn", "velglarn"}),
  "Den findest Du wohl unten im Untergeschoss. Bist Du sicher, dass Du "
  "wirklich zu ihm willst?!",
  "fluestert erschrocken: ");

  AddInfo( ({"ceyth", "bogenhaendler"}),
    "Ceyth findest Du irgendwo unten im Untergeschoss. Er ist der "
    "Bogenhaendler hier.",
    "sagt: ");

  AddInfo( ({"bogenladen"}),
    "Der befindet sich im Untergeschoss.",
    "sagt: ");

  AddInfo( ({"fredolin", "schreiner"}),
  "Fredolin ist ein sehr guter Schreiner. Bei ihm habe ich fast meine "
  "ganze Ausstattung fuer mein kleines Haeuschen bestellt. Wenn Du zu ihm "
  "willst, solltest Du mal im Untergeschoss nachsehen.",
  "laechelt: ");

  AddInfo( ({"schreinerei"}),
    "Die Schreinerei befindet sich im Untergeschoss.",
    "sagt: ");

  AddInfo( ({"ausstattung"}),
    "Nun ja, sehr viel besitze ich leider nicht...",
    "sagt verlegen: ");

  AddInfo( ({"haeuschen", "haus"}),
    "Ich habe ein kleines Haeuschen in Avir. Aber meistens bleibe ich "
    "hier im Palast, da ich oft bis spaet abends hier zu tun habe.",
    "sagt: ");

  AddInfo( ({"avir"}),
    "Avir liegt ein wenig suedlich des Palastes im Tethyrwald.",
    "erklaert: ");

  AddInfo( ({"tethyrwald", "wald"}),
    "Dieser Palast befindet sich in einem grossen Wald, das sollte Dir doch "
    "schon aufgefallen sein, oder?",
    "sagt: ");

  AddInfo( ({"soldat", "soldaten"}),
    "Die Soldaten sorgen fuer die Sicherheit der Gaeste und Besucher des "
    "Palastes.",
    "sagt: ");

  AddInfo( ({"sicherheit"}),
    "Hier im Palast befindest Du Dich in Sicherheit.",
    "behauptet: ");

  AddInfo( ({"kartenzeichnerin", "zeichnerin", "alenari"}),
    "Alenari findest Du irgendwo hier in diesem Geschoss.",
    "sagt: ");

  AddInfo( ({"tierhaendler", "gordrogh"}),
    "Der befindet sich ganz hier in der Naehe.",
    "sagt: ");

  AddInfo( ({"tierhandlung"}),
    "Die befindet sich ganz hier in der Naehe.",
    "sagt: ");

  AddInfo( ({"mahmud", "geschichtenerzaehler"}),
    "Mahmud findest Du im Obergeschoss.",
    "sagt: ");

  AddInfo( ({"kinder"}),
    "Die Kinder sind meistens oben bei Mahmud und spielen dort.",
    "laechelt: ");

  AddInfo( ({"varaile"}),
    "Varaile findest Du oben im Obergeschoss.",
    "laechelt: ");

  AddInfo( ({"thimon", "konditorei"}),
    "Die Konditorei liegt im Obergeschoss.",
    "sagt: ");

  AddInfo( ({"untergeschoss"}),
    "Das liegt weiter unten.",
    "sagt: ");

  AddInfo( ({"mittelgeschoss"}),
    "Da befindest Du Dich gerade.",
    "sagt: ");

  AddInfo( ({"obergeschoss"}),
    "Das liegt weiter oben.",
    "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

  AddSpell(5,550,
    Name(WER, 1)+" verbrueht Dich mit heissem Tee!\n",
    Name(WER, 1)+" verbrueht @WEN mit heissem Tee!\n",
    DT_FIRE,([SP_SHOW_DAMAGE:1]));

  AddSpell(3,350,
    Name(WER, 1)+" tritt Dir kraeftig vors Schienbein!\n",
    Name(WER, 1)+" tritt @WEM kraeftig vors Schienbein!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" bedient einen der Besucher.\n",
    Name(WER, 1)+" eilt hin und her.\n",
    Name(WER, 1)+" blickt aufmerksam umher.\n",
    Name(WER, 1)+" laechelt Dir schuechtern zu.\n",
    Name(WER, 1)+" bringt ein grosses Tablett mit Tassen an einen Tisch.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" jammert laut.\n",
    Name(WER, 1)+" schluchzt vor sich hin.\n",
    Name(WER, 1)+" fleht die Gaeste an: So helft mir doch!\n" }));

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME("/p/armour/amulet/amulett");
  command("trage alles");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt eine junge Kellnerin.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
 if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+"hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "laechelt Dir aufmunternd zu.",
        "laechelt "+TP->name(WEM)+" aufmunternd zu.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "schaut Dich erschrocken an.",
        "schaut "+TP->name(WEN)+" erschrocken an.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "kichert leise.",
        "kichert leise.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "blickt die anderen Gaeste hilfesuchend an.",
        "blickt die anderen Gaeste hilfesuchend an.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "tadelt Dich: Jetzt haette ich fast den Tee fallenlassen!",
        "tadelt "+TP->name(WEN)+": Jetzt haette ich fast den Tee "
        +"fallenlassen!");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich freundlich an.",
        "laechelt "+TP->name(WEN)+" freundlich an.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "erroetet zutiefst verlegen.",
        "erroetet zutiefst verlegen.");
      break;

    case "nett":
    case "neutral":
      call_out("reaction", 0, TP,
        "laechelt Dir zu.",
        "laechelt "+TP->name(WEM)+" zu.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "sagt erschrocken: Och, seid doch nicht traurig, "+TP->name(WER)+".",
        "sagt erschrocken: Och, seid doch nicht traurig, "+TP->name(WER)+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}

void init()
{
  ::init();
  call_out("begruessung", 0, TP);
}

void begruessung(object player)
{
  if(TP)
  {
    TP->Message(break_string("Die junge Kellnerin kommt mit einem "
    +"freundlichen Laecheln auf Dich zu.\n\n"
    +"Guten Tag, "+TP->Name(WER, 1)+"!\n\n"
    +"Wenn Ihr Euch ein wenig ausruhen wollt, seid Ihr hier genau richtig.\n"
    +"Setzt Euch doch, trinkt einen von unseren silberlandweit bekannten "
    +"Tees und erholt Euch von den Muehen und Strapazen dieses anstrengenden "
    +"Tages.\n", 78, 0, BS_LEAVE_MY_LFS), MSGFLAG_SOUND);

    ENV(TO)->Message("Die junge Kellnerin begruesst "+TP->Name(WEN, 1)+" "
    +"freundlich.\n",
    MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  }
   return;
}
