  AddInfo( ({"zwergin"}),
    "Ich bin jedenfalls keine!",
    "sagt: ");

  AddInfo( ({"gaeste", "besucher", "gast", "palastbesucher"}),
    "Hier ist meistens recht viel los, ich habe eigentlich gar keine "
