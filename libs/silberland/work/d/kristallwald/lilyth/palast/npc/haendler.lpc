#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------

#define SP_KOSTEN 90
int IsDrow(object player);

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

//  begruessung = WEG;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Velg'larn, der Haendler");
  SetProp(P_LONG,
    "Das ist Velg'larn, der Besitzer dieses kleinen Ladens. Er hat die "
    "fuer einen Dunkelelfen typischen langen weissen Haare und ist in einen "
    "dunklen Umhang gehuellt, um sich vor dem Licht zu schuetzen. Als Du "
    "dem stechenden Blick seiner gluehenden roten Augen begegnest, laeuft "
    "Dir ein eiskalter Schauer ueber den Ruecken.");

  AddDetail( ({ "haare", "haar" }),
    "Lange weisse Haare schauen unter dem Umhang hervor.");

  AddDetail( ({ "umhang" }),
    "Ein weiter dunkler Umhang umhuellt seinen Koerper und schuetzt ihn "
    "vor dem wenigen Licht, das hier von draussen hereindringt.");

  AddDetail( ({ "koerper" }),
    "Er wird von dem weiten Umhang verdeckt.");

  AddDetail( ({ "licht", "tageslicht" }),
    "Velg'larn hasst nichts so sehr wie das helle Tageslicht.");

  AddDetail( ({ "blick" }),
    "Mit stechendem Blick betrachtet Velg'larn Dich von oben bis unten.");

  AddDetail( ({ "augen" }),
    "Rotgluehende Augen mustern Dich kaltbluetig.");

  AddDetail( ({ "schauer" }),
    "Du fuehlst Dich aeusserst unbehaglich unter seinem Blick.");

  AddDetail( ({ "ruecken" }),
    "Pass nur auf, dass Dir nicht ploetzlich jemand einen Dolch in den "
    "Ruecken stoesst!");

  AddDetail( ({ "dolch" }),
    "Viele Dunkelelfen hegen eine gewisse Vorliebe fuer so etwas.");

  AddDetail( ({ "vorliebe" }),
    "Jemandem einen Dolch in den Ruecken zu stossen, wenn er gerade am "
    "wenigsten damit rechnet.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Velg'larn");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"haendler", "velg'larn", "velglarn", "dunkelelf", "besitzer",
  "ladenbesitzer", "Messermeister", "\nvelglarn", "NOWIMPY"}));
  AddClass( ({CL_DARKELF}) );
  SetProp(P_ARTICLE, 0);

  set_living_name("velglarn");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(22);

  SetProp(P_HANDS, ({ " mit seinen Haenden", 220, DT_BLUDGEON }) );

  SetProp(P_RACE, "Dunkelelf");
  SetProp(P_SIZE, 192);
  SetProp(P_WEIGHT, 69000);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" faucht Dich an: Was soll ich damit?!\n" }) );

  SetProp(P_LOG_INFO, "/lilyth/palast/velglarn");

  SetProp(P_RESISTANCE_STRENGTHS,
    ([ DT_LIGHT:    0.5,
       DT_HOLY:     0.4,
       DT_UNHOLY:  -0.2 ]));

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "schleicht leise herein");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Velg'larn");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "schaut Dich boese an.\n",
            "runzelt die Stirn.\n",
            "mustert Dich finster.\n"}));

  AddInfo( ({"gestalt", "paeckchen"}),
  "Das geht Dich ueberhaupt nichts an!",
  "knurrt: ");

  AddInfo( ({"lilyth"}),
  "Lilyth war mal eine richtige boese Dunkelelfe und hat unserem Volke "
  "Ehre gemacht. Aber mittlerweile ist sie kaum noch in der Lage, jemanden "
  "mal hinterruecks zu erdolchen.",
  "sagt veraechtlich: ");

  AddInfo( ({"volk", "volke", "ehre", "dunkelelfen"}),
  "Wir Dunkelelfen sind ein sehr stolzes Volk.",
  "sagt: ");

  AddInfo( ({"lage"}),
  "Heutzutage schafft sie es kaum noch, ihre eigenen Sklaven auszupeitschen, "
  "wenn diese sich gegen sie auflehnen. Pah!!",
  "knurrt: ");

  AddInfo( ({"sklave", "sklaven"}),
  "Torian ist Lilyths Sklave, auch wenn er sich immer etwas anderes "
  "einzureden versucht.",
  "fluestert Dir zu: ");

  AddInfo( ({"torian"}),
  "Torian ist auch nicht mehr der boese Dunkelelf, der er mal war.",
  "seufzt: ");

  AddInfo( ({"delgo"}),
    "Delgo ist ein richtig schoen boeser, gemeiner und hinterhaeltiger "
    "Dunkelelf, wie es sich gehoert. Da sollte sich so manch anderer mal "
    "ein Beispiel dran nehmen.",
    "grinst: ");

  AddInfo( ({"regal"}),
    "Ach, das sind nur meine kleinen Freunde.",
    "sagt mit glitzernden Augen: ");

  AddInfo( ({"freunde"}),
    "Na, Du weisst schon...",
    "zwinkert Dir zu: ");

  AddInfo( ({"spinne", "spinnen"}),
    "So eine kleine Giftspinne, die ueberzeugt die Kunden meistens sehr "
    "schnell vom wirklichen Wert meiner Waren.",
    "beugt sich vertraulich zu Dir rueber: ");

  AddInfo( ({"waren", "angebot"}),
  "Mit 'zeige' kannst Du Dir mein Angebot ansehen.",
  "sagt gelangweilt: ");

  AddInfo( ({"giftspinne", "giftspinnen", "gift"}),
  "In hoher Menge kann ihr Gift toedlich sein.",
  "laechelt boshaft: ");

  AddInfo( ({"menge"}),
  "Du kannst ja mal austesten, wieviel Gift Du ertraegst.",
  "betrachtet Dich eingehend: ");

  AddInfo( ({"laden"}),
  "Du stehst gerade darin...",
  "zischt: ");

  AddInfo( ({"dhrkion"}),
  "Dhrkion ist die Stadt der Dunkelelfen.",
  "sagt: ");

  AddInfo( ({"unterwelt", "heimat", "gaenge"}),
  "Die dunklen Gaenge der Unterwelt sind meine Heimat.",
  "sagt: ");

  AddInfo( ({"oberwelt"}),
  "veraechtlich aus.",
  "spuckt ");

  AddInfo( ({"palast"}),
  "Ich bin nur hier, weil meine Goettin es mir befohlen hat.",
  "knurrt: ");

  AddInfo( ({"goettin"}),
  "Sie wird sicher ihre Gruende dafuer haben.",
  "knurrt: ");

  AddInfo( ({"gruende", "grund"}),
  "Das weiss niemand ausser Lloth selbst.",
  "knurrt: ");

  AddInfo( ({"lloth"}),
  "Lloth ist die einzig wahre Goettin!",
  "zischt drohend: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

  AddSpell(1,850,
    Name(WER, 1)+" stoesst Dir seinen Dolch in den Ruecken!\n",
    Name(WER, 1)+" stoesst @WEM seinen Dolch in den Ruecken!\n",
    DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(6,300,
    Name(WER, 1)+" schleudert eine Hoellenfackel nach Dir!\n",
    Name(WER, 1)+" schleudert eine Hoellenfackel nach @WEM!\n",
    DT_TERROR,([SP_SHOW_DAMAGE:1]));

  AddSpell(4,1,
    Name(WER, 1)+" ruft seine Spinnen zu Hilfe!\n",
    Name(WER, 1)+" ruft seine Spinnen zu Hilfe!\n",
    DT_BLUDGEON, "call_help");

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" mustert Dich veraechtlich.\n",
    Name(WER, 1)+" beobachtet Dich misstrauisch.\n",
    Name(WER, 1)+" wirft Dir einen finsteren Blick zu.\n",
    Name(WER, 1)+" fluestert drohend: Fass hier ja nichts an.\n",
    Name(WER, 1)+" wirft einen ungeduldigen Blick nach draussen.\n",
    Name(WER, 1)+" scheint auf jemanden zu warten.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" zischt wuetend: Das wirst Du bereuen!\n",
    Name(WER, 1)+" funkelt Dich boese an.\n",
    Name(WER, 1)+" droht Dir mit seinem Dolch!\n" }));

//--Ausruestung------------------------------------------------------------

  SUID;

  if(!random(3))
  {
        clone_object(WEAPON "schattendolch")->move(TO);
        command("zuecke schattendolch");
  }
  else
  {
        clone_object("/p/weapon/knife/obsidiandolch")->move(TO);
        command("zuecke obsidiandolch");
  }

  CLONEME(ARMOUR "schattenumhang");
  CLONEME(ARMOUR "schattenstiefel");
  command("trage alles");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt Velg'larn.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": "+"Velg'larn hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "schaut Dich veraechtlich an.",
        "schaut "+TP->name(WEN)+" veraechtlich an.");
      break;

    case "fies":
    case "aergerlich":
      call_out("reaction", 0, TP,
        "fluestert leise: Nun gut, Du hast es so gewollt.",
        "zischt veraergert und greift "+TP->name(WEN)+" an!");
      Kill(TP);
      break;
    default :
    	call_out("reaction", 0, TP,
    	  "sagt drohend: Mach das nicht noch einmal!",
    	  "zischt drohend: Mach das nicht noch einmal!");

    case "frech":
      call_out("reaction", 0, TP,
        "runzelt die Stirn.",
        "runzelt die Stirn.");
      break;

    case "froh":
    case "albern":
      call_out("reaction", 0, TP,
        "guckt Dich finster an.",
        "guckt "+TP->name(WEN)+" finster an.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Kauf lieber etwas und dann verschwinde!",
        "sagt: Kauf lieber etwas und dann verschwinde!");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "wirft Dir einen unergruendlichen Blick zu.",
        "wirft "+TP->name(WEM)+" einen unergruendlichen Blick zu.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "deutet auf die Regale.",
        "deutet auf die Regale.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "mustert Dich stumm.",
        "mustert "+TP->name(WEN)+" stumm.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

//Giftspinne rufen:
void call_help(object enemy,int damage,string damtype)
{
  object giftspinne;

  if(QueryProp(P_SP) < SP_KOSTEN)
  {
  	return; // zu wenig MP
  }

  AddSp(-SP_KOSTEN);

  giftspinne=clone_object(NPC "giftspinne");

  if(giftspinne && ENV(TO))
  {
    giftspinne->move(ENV(TO),M_GO|M_SILENT);
    giftspinne->Kill(enemy);
  }
  else
  {
    giftspinne->remove();
  }

  return;
}

//Drow begruessen:
int IsDrow(object player)
{
  if(player->QueryProp(P_RACE) == "Dunkelelf") { return 1; }
  return 0;
}

void init()
{
  ::init();

  if(TP && TP->id("\ngiftspinne")) AddDefender(TP);

  if(!TP)              return;
  if(!interactive(TP)) return;

  call_out("begruessung", 0, TP);
}

void begruessung(object player)
{
  if(IsDrow(player))
  {
     if(player->QueryProp(P_GENDER) == FEMALE)
     {
        TP->Message("Velg'larn verneigt sich vor Euch: Seid gegruesst, "
        +"Herrin "+TP->Name(WER, 1)+".\n",
        MSGFLAG_SOUND);

        ENV(TO)->Message("Velg'larn verneigt sich vor "+TP->Name(WEM, 1)+": "
        +"Seid gegruesst, Herrin.\n",
        MSGFLAG_SOUND|MSGFLAG_NO_TP);
     }
     else
     {
        TP->Message("Velg'larn neigt leicht den Kopf: Seid gegruesst, "
        +TP->Name(WER, 1)+".\n",
        MSGFLAG_SOUND);

        ENV(TO)->Message("Velg'larn neigt leicht den Kopf: Seid gegruesst, "
        +TP->Name(WER, 1)+".\n",
        MSGFLAG_SOUND|MSGFLAG_NO_TP);
     }
  }
  return;
}

//Master:
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  PALASTMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}