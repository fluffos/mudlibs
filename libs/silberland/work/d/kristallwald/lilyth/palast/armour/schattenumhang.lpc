#include "../def.h"

inherit "std/armour";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Schattenumhang");
  SetProp(P_LONG,
    "Dieser Umhang besteht aus einem weichen grauschimmernden Material. "
    "Er reicht bis zum Boden herab und besitzt eine besonders weite Kapuze, "
    "die den Traeger ein wenig vor dem grellen Tageslicht schuetzt.");

  AddDetail( ({ "material" }),
    "Du kannst nicht genau bestimmen, aus welchem Material der Umhang "
    "angefertigt wurde.");

  AddDetail( ({ "kapuze", "tageslicht" }),
    "Die Kapuze ist weit und schuetzt den Traeger ein wenig vor dem "
    "Tageslicht.");

  AddDetail( ({ "traeger" }),
    "Besonders bei Dunkelelfen ist dieser Umhang recht beliebt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schattenumhang");
  SetProp(P_GENDER, MALE);
  AddId( ({"umhang", "schattenumhang"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_SHADOW: 55, MAT_MISC_UNHOLY: 45 ]));
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 700);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 7);
  SetProp(P_QUALITY_DECAY, 100);

//--Create Ende------------------------------------------------------------

}
