#include "../def.h"

inherit "std/armour";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleiner Ring");
  SetProp(P_LONG,
    "Diesen wunderschoenen Ring hat Tungdil fuer Linah angefertigt. "
    "Er besteht zum groessten Teil aus Silber und besitzt eine kleine, "
    "runde Fassung, in der ein winziger rosafarbener Edelstein steckt.");

  AddDetail( ({ "tungdil" }),
    "Tungdil hat diesen Ring angefertigt.");

  AddDetail( ({ "linah" }),
    "Fuer sie ist dieser Ring bestimmt.");

  AddDetail( ({ "teil" }),
    "Zum groessten Teil besteht der Ring aus reinem Silber.");

  AddDetail( ({ "silber" }),
    "Das Silber glaenzt so, als ob es gerade frisch poliert wurde.");

  AddDetail( ({ "fassung" }),
    "In der runden Fassung steckt ein winziger Edelstein.");

  AddDetail( ({ "edelstein" }),
    "Ein winziger Rosenquarz steckt in der Fassung. Als Du ihn etwas naeher "
    "betrachtest, faellt Dir auf, dass er die Form einer Rose hat.");

  AddDetail( ({ "rosenquarz" }),
    "Ein winziger Rosenquarz steckt in der Fassung.");

  AddDetail( ({ "form" }),
    "Der Edelstein hat die Form einer Rose.");

  AddDetail( ({ "rose" }),
    "Die winzige Rose wurde in vollendeter Perfektion geschaffen. "
    "Tungdil muss etliche Stunden damit verbracht haben, diesen Ring "
    "anzufertigen.");

  AddDetail( ({ "perfektion" }),
    "Die Rose ist absolut makellos.");

  AddDetail( ({ "stunden" }),
    "Er hat sich wirklich sehr viel Muehe gegeben.");

  AddDetail( ({ "muehe" }),
    "Diese Muehe sollte belohnt werden, findest Du nicht?");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Ring");
  SetProp(P_NAME_ADJ, "klein");
  AddAdjective( ({ "kleiner", "kleinen" } ));
  SetProp(P_GENDER, MALE);
  AddId( ({"ring", "tungdil_ring"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_SILVER: 90, MAT_MISC_JEWEL: 10 ]));
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, 1);
  SetProp(P_QUALITY_DECAY, 100);

//--Create Ende------------------------------------------------------------

}
