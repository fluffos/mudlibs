#include "../def.h"

inherit "std/armour";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein weisse Schuerze");
  SetProp(P_LONG,
    "Diese Schuerze ist hellweiss und noch voellig sauber. Sie ist recht "
    "gross und daher sicherlich sehr praktisch, wenn man etwas backen oder "
    "kochen und dabei seine Kleidung nicht beschmutzen will.");

  AddDetail( ({ "kleidung" }),
    "Die Schuerze schuetzt Deine Kleidung beim Kochen oder Backen vor "
    "unliebsamen Flecken.");

  AddDetail( ({ "flecken", "fleck" }),
    "Auf der Schuerze sind noch keine Flecken zu sehen.");

  AddDetail( ({ "kochen", "backen" }),
    "Beim Kochen ebenso wie beim Backen kann schnell mal etwas daneben "
    "gehen. Und dann ist man sicherlich froh ueber eine solche Schuerze.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schuerze");
  SetProp(P_NAME_ADJ, "weiss");
  AddAdjective( ({ "weisse" } ));
  SetProp(P_GENDER, FEMALE);
  AddId( ({"schuerze"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_CLOTH);
  SetProp(P_WEIGHT, 170);
  SetProp(P_VALUE, 170);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 3);
  SetProp(P_QUALITY_DECAY, 75);

//--Create Ende------------------------------------------------------------

}
