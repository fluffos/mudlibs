#include "../def.h"

inherit "std/armour";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Schattenstiefel");
  SetProp(P_LONG,
    "Diese Stiefel bestehen aus einem grauschimmernden Material. Sie reichen "
    "fast bis zum Knie hinauf und haben eine duenne weiche Sohle, die den "
    "Traeger vor rauhen Untergruenden schuetzen und es ihm dennoch "
    "ermoeglichen, Unebenheiten unter seinen Fuessen zu spueren und sich "
    "voellig lautlos fortbewegen zu koennen.");

  AddDetail( ({ "material" }),
    "Du kannst nicht genau bestimmen, aus welchem Material die Stiefel "
    "angefertigt wurden.");

  AddDetail( ({ "knie" }),
    "Sie reichen fast bis zum Knie hinauf.");

  AddDetail( ({ "sohle" }),
    "Die Sohle ist angenehm weich und sehr duenn.");

  AddDetail( ({ "traeger" }),
    "Vorzugsweise tragen Dunkelelfen solche Stiefel.");

  AddDetail( ({ "untergruende", "untergrund", "beweglichkeit", "fuesse" }),
    "Die Fuesse werden vor rauhen Untergruenden geschuetzt und bleiben "
    "trotzdem voellig flexibel in ihrer Beweglichkeit.");

  AddDetail( ({ "unebenheiten" }),
    "Der Traeger kann Unebenheiten genau spueren und sich somit voellig "
    "an den jeweiligen Untergrund anpassen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schattenstiefel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"stiefel", "schattenstiefel"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_SHADOW: 55, MAT_MISC_UNHOLY: 45 ]));
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 1000);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 6);
  SetProp(P_QUALITY_DECAY, 100);

//--Create Ende------------------------------------------------------------

}
