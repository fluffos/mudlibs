#include "../def.h"
#include <container.h>

inherit "std/armour";
inherit "std/container";

//--Variablen&Defines------------------------------------------------------

object rechts, links, mitte;

//--Create-----------------------------------------------------------------

void create()
{
 if( !is_clone(TO) ) return;

  armour::create();
  container::create();

//--Initialisierungen------------------------------------------------------

  rechts = links = mitte = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein lederner Waffengurt");
  SetProp(P_LONG,
    "Dieser besonders breite, mit mehreren unterschiedlich grossen Laschen "
    "ausgestattete Guertel dient zum Aufbewahren von kleineren Waffen wie "
    "zum Beispiel Messern oder Dolchen. Er besteht aus einem anschmiegsamen "
    "weichen Leder. Nur die Laschen sind an der Unterseite zusaetzlich "
    "verstaerkt worden, so dass nicht die Gefahr besteht, sich unabsichtlich "
    "an einer der darin enthaltenen Waffen zu verletzen.");

  AddDetail( ({ "guertel" }),
    "Der Waffengurt ist eigentlich nichts anderes als ein normaler breiter "
    "Guertel, nur dass mehrere Lederlaschen an ihm befestigt sind.");

  AddDetail( ({ "laschen", "lederlaschen", "lasche", "lederlasche" }),
    "Mehrere laengliche Laschen befinden sich ein wenig seitlich an dem "
    "Gurt, so dass sie den Traeger im Kampf und beim Fortbewegen nicht "
    "in seinen Bewegungen einschraenken. Sie bestehen, wie der gesamte "
    "Guertel, aus Leder.");

  AddDetail( ({ "leder" }),
    "Der Waffengurt sowie die Laschen bestehen aus einem besonders "
    "weichen, anschmiegsamen Leder, so dass man ihn beim Tragen kaum "
    "spuert.");

  AddDetail( ({ "tragen" }),
    "Du kannst ihn tragen, wenn Du willst.");

  AddDetail( ({ "traeger" }),
    "Momentan bist Du der einzige potentielle Traeger dieses Gurtes.");

  AddDetail( ({ "kampf", "fortbewegen", "bewegungen" }),
    "Der Waffengurt schraenkt seinen Traeger in seinen Bewegungen ueberhaupt "
    "nicht ein.");

  AddDetail( ({ "aufbewahren" }),
    "Kleinere Waffen koennen in diesem Guertel aufbewahrt und bei Bedarf "
    "sehr schnell wieder aus den Laschen entnommen werden.");

  AddDetail( ({ "bedarf" }),
    "Im Kampf ist es wichtig, jederzeit blitzschnell seine Waffe ziehen "
    "oder auch wechseln zu koennen.");

  AddDetail( ({ "waffen", "beispiel", "waffe" }),
    "Messer oder Dolche zum Beispiel.");

  AddDetail( ({ "messer", "dolche", "dolch" }),
    "Hast Du welche bei Dir?");

  AddDetail( ({ "unterseite" }),
    "Die Lederlaschen sind an der Unterseite zusaetzlich verstaerkt worden, "
    "damit sich an den darin befindlichen Waffen niemand verletzen kann.");

  AddDetail( ({ "gefahr" }),
    "Diese Gefahr ist aeusserst gering.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Waffengurt");
  SetProp(P_NAME_ADJ, "ledern");
  AddAdjective( ({ "lederner", "ledernen" } ));
  SetProp(P_GENDER, MALE);
  AddId( ({"gurt", "waffengurt"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_LEATHER);
  SetProp(P_WEIGHT, 40);
  SetProp(P_VALUE, 900);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_BELT);
  SetProp(P_AC, 1);
  SetProp(P_QUALITY_DECAY, 0);

//--Behaeltereigenschaften-------------------------------------------------

  SetProp(P_CONTAINER, 1);
  SetProp(P_MAX_WEIGHT, 10000);
  SetProp(P_WEIGHT_PERCENT, 33);
  SetProp(P_TRANSPARENT, 1);

  SetProp(P_WEAR_TEXT, ({ "Du legst Dir den Waffengurt um.\n",
  " legt sich einen Waffengurt um.\n" }));
  SetProp(P_UNWEAR_TEXT, ({ "Du ziehst den Waffengurt aus.\n",
  " zieht einen Waffengurt aus.\n" }));

  SetProp(P_INFO, BS("Mit 'stecke <waffe> in waffengurt' kannst Du eine "
  "Waffe in eine der Laschen stecken. Mit 'waehle links|rechts|mitte' "
  "kannst Du schnell eine andere Waffe aus dem Gurt nehmen und gleichzeitig "
  "zuecken."));

//--Kommandos--------------------------------------------------------------

  AddCmd( ({"waehl", "waehle" }), "waffenwechsel");

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

int change_weapon(object weapon1, object weapon2)
{
  object wer;

  wer = QueryProp(P_WORN);

  if( weapon1 && (weapon1->QueryProp(P_NODROP) || weapon1->QueryProp(P_CURSED)) )
  {
    write("Du kannst "+weapon1->name(WEN,1)+" nicht in den Waffengurt "
        "stecken!\n");
    return -4;
  }

  if( weapon1 ) weapon1->DoUnwield(1);
  if( weapon1 && weapon1->QueryProp(P_WIELDED) )
  {
    write("Du kannst "+weapon1->name(WEN,1)+" nicht wegstecken.\n");
    return -1;
  }

  if( (weapon2->move(wer, M_GET)) == ME_TOO_HEAVY )
  {
    write("Du kannst "+weapon2->name(WEN,1)+" nicht mehr tragen.\n");
    if(weapon1) weapon1->wield_me(1);
    return -2;
  }

  if( weapon1 )
    weapon1->move(TO, M_PUT);
  if( weapon2->wield_me(1) != 1 )
  {
    write("Du kannst "+weapon2->name(WEN,1)+" nicht zuecken.\n");
    return -3;
  }

  if( weapon1 )
  {
    write(BS("Du steckst "+weapon1->name(WEN,1)+" in den Waffengurt und "
      "zueckst "+weapon2->name(WEN,1)+"."));
    say(BS(wer->Name(WER)+" steckt "+weapon1->name(WEN)+" in "+
      wer->QPP(NEUTER,WEN,SINGULAR)+" Waffengurt und zueckt "+
      weapon2->name(WEN)+"."), ({wer}) );
  }
  else
  {
    write(BS("Du nimmst "+weapon2->name(WEN,1)+" aus dem Waffengurt und "
      "zueckst "+weapon2->QueryPronoun(WEN)+"."));
    say(BS(wer->Name(WER)+" nimmt "+weapon2->name(WEN)+" aus "+
      wer->QPP(NEUTER,WEM,SINGULAR)+" Waffengurt und zueckt "+
      weapon2->QueryPronoun(WEN)+"."), ({wer}) );
  }
  return 1;
}

int waffenwechsel(string str)
{
  object weapon1, weapon2;

  notify_fail("SYNTAX: waehle <rechts|links|mitte>\n");

  if( !str ) return 0;
  if( !QueryProp(P_WORN) ) return 0;

  weapon1 = QueryProp(P_WORN)->QueryProp(P_WEAPON);

  if( str == "links" )
  {
    if( weapon2 = links )
      change_weapon(weapon1, weapon2);
    else
      write("Du hast keine Waffe in der linken Lasche.\n");
    return 1;
  }
  else if( str == "rechts" )
  {
    if( weapon2 = rechts )
      change_weapon(weapon1, weapon2);
    else
      write("Du hast keine Waffe in der rechten Lasche.\n");
    return 1;
  }
  else if( str == "mitte" )
  {
    if( weapon2 = mitte )
      change_weapon(weapon1, weapon2);
    else
      write("Du hast keine Waffe in der mittleren Lasche.\n");
    return 1;
  }

  return 0;
}

varargs int PreventInsert(object ob)
{
  string weapontype;
  weapontype = ob->QueryProp(P_WEAPON_TYPE);

  if ( !(TO->QueryWorn()) )
  {
    write("Du musst den Waffengurt zuerst anziehen.\n");
    return 1;
  }

  if (file_name(ob)[0..32] == "/p/daemon/itemd/charge_functions/")
    return ::PreventInsert(ob);

  if ( !weapontype || weapontype != WT_KNIFE)
  {
    write("Du kannst nur Messer oder Dolche in den Waffengurt stecken!\n");
    return 1;
  }

  if( rechts && links && mitte)
  {
    write("Mehr als drei Waffen passen nicht in den Waffengurt.\n");
    return 1;
  }

  if( rechts )
  {
    if (mitte)
    {
      links=ob;
      write(ob->Name(WER,1)+ " findet in der linken Lasche Platz.\n");
    }
    else
    {
      mitte=ob;
      write(ob->Name(WER,1)+ " findet in der mittleren Lasche Platz.\n");
    }
  }
  else
  {
    rechts=ob;
    write(ob->Name(WER,1)+ " findet in der rechten Lasche Platz.\n");
  }

  return ::PreventInsert(ob);
}

varargs int PreventLeave(object ob, mixed dest)
{
  if( ob==links )
  {
    links=0;
  }

  if( ob==rechts )
  {
    rechts=0;
  }

  if( ob==mitte )
  {
    mitte=0;
  }

  if (file_name(ob)[0..32] == "/p/daemon/itemd/charge_functions/")
  {
    write( "BUG!!!!! "+ob->Name()+" darf gar nicht im Waffengurt sein!\n");
    DB( "BUG!!!!! "+ob->Name()+" darf gar nicht im Waffengurt sein!\n");
  }

  return ::PreventLeave(ob, dest);
}

void init()
{
  container::init();
  armour::init();
}

varargs int remove(int silent)
{
  DoUnwear(silent);
  if (!QueryProp(P_WORN))
    return container::remove(silent);
}

varargs move(mixed dest, int method)
{
  DoUnwear(method & M_SILENT);
  if ((method & M_NOCHECK) || (!QueryProp(P_WORN)))
    return ::move(dest, method);
}

varargs string long()
{
  string descr;

  descr = process_string(armour::long());
  descr += "Die rechte Lasche "+
    (rechts?"enthaelt "+rechts->name(WEN):"ist leer")+".\n"+
    "Die mittlere Lasche "+
    (mitte?"enthaelt "+mitte->name(WEN):"ist leer")+".\n"+
    "Die linke Lasche "+
    (links?"enthaelt "+links->name(WEN):"ist leer")+".\n";
  return descr;
}
