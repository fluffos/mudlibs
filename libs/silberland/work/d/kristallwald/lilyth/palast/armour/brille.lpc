#include "../def.h"

inherit "std/armour";

//--Variablen&Defines------------------------------------------------------

string farbe;
string form;
int aufsetzen_called;

//--Create-----------------------------------------------------------------

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  switch(random(3))
  {
    case 1:
      farbe = "kunterbunt";
      AddAdjective( ({ "kunterbunte" }) );
      SetProp(P_MATERIAL, ([ MAT_GLASS: 25, MAT_PLASTIC: 75 ]));
      break;
    case 2:
      farbe = "golden";
      AddAdjective( ({ "goldene" }) );
      SetProp(P_MATERIAL, ([ MAT_GLASS: 25, MAT_GOLD: 75 ]));
      break;
    default:
      farbe = "silbern";
      AddAdjective( ({ "silberne" }) );
      SetProp(P_MATERIAL, ([ MAT_GLASS: 25, MAT_SILVER: 75 ]));
      break;
  }

  switch(random(3))
  {
    case 1:
      form = "rund";
      break;
    case 2:
      form = "oval";
      break;
    default:
      form = "viereckig";
      break;
  }

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine "+farbe+"e Nickelbrille");
  SetProp(P_LONG,
    "Du siehst eine "+farbe+"e Nickelbrille mit "+form+"en Glaesern und "
    "langen, gebogenen Buegeln vor Dir. Sie sieht sehr schick aus. Ob "
    "sie Dir wohl stehen wuerde?");

  AddDetail( ({ "glaeser", "glas", "brillenglaeser", "brillenglas" }),
    "Die Brillenglaeser sind "+form+" und sehr fein geschliffen.");

  AddDetail( ({ "buegel" }),
    "Die Buegel dienen dazu, die Brille hinter den Ohren zu befestigen.");

  AddDetail( ({ "ohr", "ohren" }),
    "Wenn Du Dir die Buegel hinter den Ohren festklemmst, kann die Brille "
    "nicht so leicht von Deiner Nase herunterrutschen.");

  AddDetail( ({ "nase" }),
    "Auch die Nase gibt der Brille ein wenig Halt.");

  AddDetail( ({ "halt" }),
    "So eine Brille muss schliesslich gut sitzen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Nickelbrille");
  SetProp(P_NAME_ADJ, ({ farbe }));
  SetProp(P_GENDER, FEMALE);
  AddId( ({"brille", "nickelbrille"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_WEIGHT, 100+random(50));
  SetProp(P_VALUE, 50+random(100));
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAR_FUNC, this_object());

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "setz", "setze" }), "aufsetzen" );
  aufsetzen_called = 0;

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

int WearFunc(object me)
{
  if(aufsetzen_called)
  {
        aufsetzen_called = 0;
        return 1;
  }
  else
  {
        write(BS("So geht das doch nicht."));
        return 0;
  }
}

int aufsetzen(string str)
{
  notify_fail("Was moechtest Du auf- oder absetzen?\n");

  if(!str || str == "") return 0;

  if(str == "brille auf" ||
     str == "brille auf nase")
  {
      if(QueryProp(P_WORN))
      {
  	  write(BS("Aber Du hast doch bereits eine Brille auf der Nase!"));
  	  return -1;
      }
      else
      {
          write(BS("Du setzt Dir die Brille auf."));
          aufsetzen_called = 1;
          DoWear(1,0);

  	  ENV(TP)->Message(BS(TP->Name(WER, 1)+" setzt "
  	  +(PL->QueryProp(P_GENDER)==MALE?"seine":"ihre")+" Brille auf."),
  	  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  	  return 1;
      }
  }

  if(str == "brille ab" ||
     str == "brille von nase ab")
  {
      if(QueryProp(P_WORN))
      {
          write(BS("Du setzt Deine Brille ab."));
          aufsetzen_called = 1;
          DoUnwear(1,0);

  	  ENV(TP)->Message(BS(TP->Name(WER, 1)+" setzt "
  	  +(PL->QueryProp(P_GENDER)==MALE?"seine":"ihre")+" Brille ab."),
  	  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  	  return 1;
      }
      else
      {
  	  write(BS("Aber Du hast doch gar keine Brille auf."));
  	  return -1;
      }
  }

  return 0;
}

string extra_look()
{
   if(!ENV(TO)) return "";
   if(QueryProp(P_WORN))
   {
      switch(random(5))
      {
        case 1:
          return "Mit der Brille auf "
          +((TO->QueryProp(P_WORN))->QueryProp(P_GENDER)==MALE?"seiner":"ihrer")
          +" Nase sieht "
          +((TO->QueryProp(P_WORN))->QueryProp(P_GENDER)==MALE?"er":"sie")
          +" wirklich schick aus.\n";
          break;
        case 2:
          return ((TO->QueryProp(P_WORN))->QueryProp(P_GENDER)==MALE?"Er":"Sie")
          +" hat sich eine "+farbe+"e Nickelbrille aufgesetzt.\n";
          break;
        default:
          return ((TO->QueryProp(P_WORN))->QueryProp(P_GENDER)==MALE?"Seine":"Ihre")
          +" "+farbe+"e Nickelbrille steht "
          +((TO->QueryProp(P_WORN))->QueryProp(P_GENDER)==MALE?"ihm":"ihr")
          +" wirklich gut.\n";
          break;      
       }
   }
   return "";
}
