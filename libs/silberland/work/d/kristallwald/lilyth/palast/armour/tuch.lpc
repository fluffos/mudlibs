#include "../def.h"

inherit "std/armour";

//--Variablen&Defines------------------------------------------------------

int wickeln_called;

//--Create-----------------------------------------------------------------

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein hellblaues Tuch");
  SetProp(P_LONG,
    "Dieses hellblaue Tuch fuehlt sich herrlich weich und anschmiegsam an. "
    "Es wurde aus feinster Seide handgefertigt und mit huebschen "
    "Stickereien verziert.");

  AddDetail( ({ "seide" }),
    "Die Seide fuehlt sich herrlich weich an.");

  AddDetail( ({ "stickereien", "stickerei" }),
    "Huebsche Stickereien sind in das Tuch eingestickt worden.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Tuch");
  SetProp(P_NAME_ADJ, "hellblau");
  AddAdjective( ({ "hellblaues" } ));
  SetProp(P_GENDER, NEUTER);
  AddId( ({"tuch"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "Du kannst es Dir um die Schultern binden oder wickeln.");
  SetProp(P_MATERIAL, MAT_SILK);
  SetProp(P_WEIGHT, 120);
  SetProp(P_VALUE, 350);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 3);
  SetProp(P_QUALITY_DECAY, 100);

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "wickel", "wickle", "wickl", "wickele",
  "bind", "binde" }), "wickeln" );
  wickeln_called = 0;

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

int WearFunc(object me)
{
  if(wickeln_called)
  {
        wickeln_called = 0;
        return 1;
  }
  else
  {
        write(BS("So geht das doch nicht."));
        return 0;
  }
}

int wickeln(string str)
{
  notify_fail("Was moechtest Du Dir um- oder abbinden bzw. -wickeln?\n");

  if(!str || str == "") return 0;

  if(str == "tuch um" ||
     str == "tuch um schulter" ||
     str == "tuch um schultern" )
  {
      if(QueryProp(P_WORN))
      {
          write(BS("Du hast Dir das Tuch doch bereits umgebunden."));
          return 0;
      }
      else
      {
          write(BS("Du wickelst Dir das Tuch um und drapierst es um "
          +"Deine Schultern."));
          wickeln_called = 1;
          DoWear(1,0);

  	  ENV(TP)->Message(BS(TP->Name(WER, 1)+" wickelt sich ein Tuch "
  	  +"um."),
  	  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
          return 1;
      }
  }
  
  if(str == "tuch ab" )
  {
      if(QueryProp(P_WORN))
      {
          write(BS("Du wickelst das Tuch ab."));
          wickeln_called = 1;
          DoUnwear(1,0);

  	  ENV(TP)->Message(BS(TP->Name(WER, 1)+" wickelt "
  	  +(PL->QueryProp(P_GENDER)==MALE?"sein":"ihr")+" Tuch ab."),
  	  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  	  return 1;
      }
      else
      {
  	  write(BS("Aber Du hast doch gar kein Tuch um."));
  	  return 0;
      }
  }

  return 0;
}

string extra_look()
{
   if(!ENV(TO)) return "";
   if(QueryProp(P_WORN))
   {
      return ""
      +((TO->QueryProp(P_WORN))->QueryProp(P_GENDER)==MALE?"Er":"Sie")
      +" hat sich ein hellblaues Tuch um die Schultern geschlungen.\n";
   }
   return "";
}
