#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

int i;

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  i = 10;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Kaestchen Pralinen");
  SetProp(P_LONG,
    "Dieses kleine, goldene Kaestchen enthaelt eine erlesene Auswahl "
    "allerfeinster Pralinen. Es ist mit einer kleinen, silbernen Schleife "
    "verziert und auf dem Deckel steht in geschwungenen, goldenen "
    "Lettern:\n'Mit den besten Wuenschen, Ihre silberlaend'sche "
    "Confisserie'.");

  AddDetail( ({ "auswahl" }),
    "Du laesst Deinen Blick ueber die verschiedenen Pralinensorten "
    "schweifen. Da ist sicherlich einiges dabei, was Du magst.");

  AddDetail( ({ "pralinensorten", "pralinensorte", "sorten", "sorte" }),
    "Es befinden sich verschiedene Sorten an Pralinen in dem Kaestchen.");

  AddDetail( ({ "schleife" }),
    "Eine kleine, silberne Schleife verziert das kleine Pralinenkaestchen.");

  AddDetail( ({ "deckel", "lettern" }),
    "Auf dem Deckel siehst Du ein paar goldene Lettern.");

  AddDetail( ({ "confisserie" }),
    "Diese Pralinen stammen aus der beruehmten silberlaend'schen "
    "Confisserie.");

  AddSpecialDetail( ({ "pralinen", "praline" }),
    "strpralinen");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Kaestchen Pralinen");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "kaestchen", "pralinen", "pralinenkaestchen" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "Du kannst sie jemandem schenken oder die Pralinen "
  "auch einfach selber essen.");
  SetProp(P_MATERIAL, ([ MAT_CARTON: 45, MAT_MISC_FOOD: 55 ]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 220);

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "schenk", "schenke" }), "schenken" );
  AddCmd( ({ "nimm", "nehm", "nehme" }), "nehmen" );
  AddCmd( ({ "iss", "ess", "esse" }), "essen" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer SpecialDetails-------------------------------------------

string strpralinen(string str)
{
  string s;

  if(i >= 2)
  {
       s = "Es befinden sich noch "+i+" Pralinen in dem Kaestchen.";
  }
  else
  {
  	s = "Es befindet sich nur noch eine einzige Praline in dem "
  	"Kaestchen. :(";
  }
  return BS(s);
}

//--Funktionen-------------------------------------------------------------

//verschenken
int schenken(string str)
{
  string wer, was;
  object player;

  notify_fail("Wem moechtest Du die Pralinen schenken?\n");

  if(!str || str == "")
  {
        return (notify_fail ("WEM moechtest Du WAS schenken?\n"),0);
  }

  //Syntaxcheck
  if( sscanf(str, "%s %s", wer, was) == 2 && id(was) )
  {
     player = find_player(wer);

     //Spieler ist nicht eingelogt
     if(!player)
     {
          write(BS("Aber "+CAP(wer)+" ist doch gar nicht anwesend."));
          return -1;
     }

     //Spieler ist nicht im gleichen Raum
     if(ENV(TP) != ENV(player))
     {
          write(BS("Aber "+player->name(WER, 1)+" ist doch gar nicht hier!"));
          return -1;
     }

     //zu schwer
     if(ME_TOO_HEAVY == this_object()->move(player,M_GET|M_SILENT))
     {
          write(BS(player->Name(WER, 1)+" kann das Pralinenkaestchen "
          +"leider nicht mehr tragen, daher behaeltst Du es lieber."));
          return -1;
     }
     else
     {
          //Schenken klappt
          write(BS("Du schenkst "+player->Name()+" die Pralinen."));
          
          tell_object(player,BS(TP->Name(WER)+" schenkt Dir ein "
          +"Kaestchen Pralinen."));

          tell_room(ENV(TP),BS(TP->Name()+" schenkt "+player->Name()
          +" ein Kaestchen Pralinen."), ({ TP, player })); 
          return 1;
     }
  }
  
  return 0;
}

//eine Praline nehmen
int nehmen(string str)
{
  object mypraline;
  
  notify_fail("Was willst Du wo herausnehmen?\n");

  if(!str || str == "") return 0;

  if(str == "praline aus kaestchen" ||
     str == "praline aus pralinenkaestchen" )
  {
     if(i >= 2)
     {
  	write(BS("Vorsichtig loest Du eine Praline aus dem Kaestchen "
  	+"heraus."));

  	ENV(TP)->Message(BS(TP->Name(WER, 1)+" fummelt an einem "
  	+"Pralinenkaestchen herum."),
  	MSGFLAG_VISUAL|MSGFLAG_NO_TP);  	

  	mypraline=clone_object(OBJ "konditorei/praline");
  	        
  	if(ME_TOO_HEAVY == mypraline->move(TP,M_GET|M_SILENT))
        {
            mypraline->move(ENV(TP), M_PUT|M_SILENT);

            write(BS("Da Du die Praline nicht mehr tragen kannst, "
            +"legst Du sie auf dem Boden ab."));

            ENV(TP)->Message(BS(TP->Name(WER, 1)+" legt eine "
            +"Praline auf dem Boden ab."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
            return -1;
        }
        
        i--;
        return 1;
     }
     
     if(i == 1)
     {
  	write(BS("Vorsichtig loest Du die letzte Praline aus dem Kaestchen "
  	+"heraus."));

  	ENV(TP)->Message(BS(TP->Name(WER, 1)+" fummelt an einem "
  	+"Pralinenkaestchen herum."),
  	MSGFLAG_VISUAL|MSGFLAG_NO_TP);  	

  	mypraline=clone_object(OBJ "konditorei/praline");
  	        
  	if(ME_TOO_HEAVY == mypraline->move(TP,M_GET|M_SILENT))
        {
            mypraline->move(ENV(TP), M_PUT|M_SILENT);

            write(BS("Da Du die Praline nicht mehr tragen kannst, "
            +"legst Du sie auf dem Boden ab."));

            ENV(TP)->Message(BS(TP->Name(WER, 1)+" legt eine "
            +"Praline auf dem Boden ab."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
            return -1;
        }
     
        TO->remove();
  	return 1;
     }
  }
}

int essen(string str)
{
  notify_fail("Was moechtest Du essen?\n");

  if(!str || str == "") return 0;

  if(!(str == "praline" ||
       str == "pralinen")) return 0;

  write(BS("Um eine der Pralinen zu essen, solltest Du sie erstmal aus "
  +"dem Kaestchen nehmen.\n"));
  
  return 1;
}
