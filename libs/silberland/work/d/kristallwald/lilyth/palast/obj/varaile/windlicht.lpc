inherit "/std/lightsource";
#include "/d/kristallwald/lilyth/palast/def.h"

#include <lightsource.h>
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <material.h>

//--Variablen&Defines------------------------------------------------------

int windlicht;
string farbe;

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  windlicht = AUS;

  switch(random(4))
  {
    case 1:
      farbe = "rot";
      AddAdjective( ({ "rotes" }) );
      break;
    case 2:
      farbe = "blau";
      AddAdjective( ({ "blaues" }) );
      break;
    case 3:
      farbe = "gruen";
      AddAdjective( ({ "gruenes" }) );
      break;
    default:
      farbe = "gelb";
      AddAdjective( ({ "gelbes" }) );
      break;
  }

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleines Windlicht");
  //Long siehe weiter unten

  AddDetail( ({ "wachs" }),
    "Das Windlicht besteht aus "+farbe+"em Wachs.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Windlicht");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARTICLE, 1);
  AddId( ({"windlicht", "licht"}) );
  SetProp(P_INFO, "Es kann Dir die dunkle Nacht erhellen.");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_WAX);
  SetProp(P_WEIGHT, 10);
  SetProp(P_SIZE, 7);
  SetProp(P_VALUE, 75);
  SetProp(P_FUEL, 1200);

  SetProp(P_LIGHTDESC,
  ({ "schwach glimmend", "flackernd", "leicht flackernd", "brennend",
     "hell leuchtend", "frisch angezuendet" }) );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;

  txt = "Eine kleines, "+farbe+"es Windlicht. ";

  //ist das Windlicht an oder aus?
  if (_query_lighted())
  {
        txt +=  "Es wurde angezuendet und wirft einen hellen Lichtschein vor "
        +"Dir auf den Weg.";
  }
  else
  {
        txt +=  "Es hat einen kurzen, schwarzen Docht, an dem Du es "
        +"anzuenden kannst.";
  }
  return BS(txt);
}
