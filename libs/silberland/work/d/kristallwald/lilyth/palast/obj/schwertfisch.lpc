#include "../def.h"
#include <food.h>
#include <properties.h>

inherit "/std/food";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Schwertfisch");
  SetProp(P_LONG,
    "Dieser riesige Schwertfisch hat lange knoecherne Kiefer, die wie zwei "
    "Schwerter aussehen. Ihnen verdankt dieser Fisch seinen Namen.");

  AddDetail( ({ "kiefer" }),
    "Dieser Fisch hat lange, schwertartig geformte Kiefer.");

  AddDetail( ({ "schwerter" }),
    "Seine Kiefer sehen wie kleine Schwerter aus.");

  AddDetail( ({ "name", "namen" }),
    "Es handelt sich um einen Schwertfisch.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schwertfisch");
  SetProp(P_GENDER, MALE);
  AddId( ({"\nfisch", "fisch", "schwertfisch"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

  SetProp (P_FOOD_INFO, ([
    F_HEAL     : ({6,6}),
    F_SOAK: 3,
    F_MSG      : "Du beisst voller Elan in den riesigen Schwertfisch hinein "
                 "und knabberst ihn bis auf die Graeten ab und wirfst die "
                 "beiden schwertfoermigen Kieferknochen dann fort.",
    F_MSG_ROOM : "isst einen riesigen Schwertfisch.",
    F_MSG_DECAY: "Ein Schwertfisch beginnt langsam zu verschimmeln.\n",
    F_MSG_REMOVE: "Der Schwertfisch ist voellig verschimmelt und Du entsorgst "
                  "ihn ordentlich.\n",
    F_VERB     : "essen" ]) );

  start_decay(1800, 900);

//--Create Ende------------------------------------------------------------

}
