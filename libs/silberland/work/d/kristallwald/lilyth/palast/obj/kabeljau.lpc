#include "../def.h"
#include <food.h>
#include <properties.h>

inherit "/std/food";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Kabeljau");
  SetProp(P_LONG,
    "Du siehst ein besonders praechtiges Exemplar eines Kabeljaus vor Dir. "
    "Er besitzt einen langen Bartfaden an seinem Unterkiefer.");

  AddDetail( ({ "exemplar" }),
    "Er ist besonders gross und dick.");

  AddDetail( ({ "bartfaden", "faden", "merkmal" }),
    "Sein langer Bartfaden ist das eigentliche Merkmal dieses Fisches.");

  AddDetail( ({ "kiefer", "unterkiefer" }),
    "Du kannst einen langen Bartfaden vorne an seinem etwas zurueckstehenden "
    "Unterkiefer sehen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Kabeljau");
  SetProp(P_GENDER, MALE);
  AddId( ({"\nfisch", "fisch", "kabeljau"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 170);
  SetProp(P_VALUE, 80);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

  SetProp (P_FOOD_INFO, ([
    F_HEAL     : ({4,4}),
    F_SOAK: 2,
    F_MSG      : "Mit leichtem Bedauern isst Du den Kabeljau restlos auf.",
    F_MSG_ROOM : "isst einen ganzen Kabeljau auf.",
    F_MSG_DECAY: "Ein Kabeljau beginnt langsam zu verschimmeln.\n",
    F_MSG_REMOVE: "Der Kabeljau ist voellig verschimmelt und Du entsorgst "
                  "ihn ordentlich.\n",
    F_VERB     : "essen" ]) );

  start_decay(1800, 900);

//--Kommandos--------------------------------------------------------------

//AddCmd( ({ "", "" }), "" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------
