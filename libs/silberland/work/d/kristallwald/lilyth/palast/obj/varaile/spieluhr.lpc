inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <material.h>

#include "/d/kristallwald/lilyth/palast/def.h"

//--Create-----------------------------------------------------------------

void create()
{
  if( !is_clone(this_object()) ) return;
  
  ::create();
  
//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine kleine Spieluhr");
  SetProp(P_LONG,  "Diese kleine Spieluhr hat Varaile extra fuer Dich "
  "angefertigt. Sie ist aus Glas, und wenn man hineinschaut, kann man eine "
  "kleine Fee sehen. An der Seite ist ein kleiner Hebel, an dem man die "
  "Spieluhr aufziehen kann.");
  
  AddDetail(({"fee","gestalt"}),
  "Die Fee hat hell leuchtende Schmetterlingsfluegel und eine zierliche "
  "Gestalt. Ihr Haar schimmert seidig im Licht und irgendwie wirkt sie "
  "ungewoehnlich lebendig, aber auch ein wenig zerbrechlich.");

  AddDetail(({"hebel"}),
  "Der Hebel ist zierlich und verziert. Nur zu, zieh ruhig die Spieluhr "
  "auf.");

  AddDetail(({"seite"}),
  "Da ist ein Hebel.");  

  AddDetail( ({ "glas" }),
    "Die Spieluhr ist aus Glas.");

//-------------------------------------------------------------------------

  SetProp(P_INFO, "Diese Spieluhr wurde mit viel Liebe angefertigt und "
 		  "ist limitiert. :)" );
  SetProp(P_NAME, "Spieluhr");
  SetProp(P_NAME_ADJ, "klein");
  AddAdjective( ({ "kleine" } ));
  SetProp(P_GENDER, FEMALE);
  AddId( ({"uhr", "spieluhr"}) );
  SetProp(P_MATERIAL, ([MAT_GLASS:70, MAT_MISC_MAGIC:30]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1050);
  SetProp(P_NOBUY, 1);

//--Kommandos--------------------------------------------------------------

  AddCmd(({"ziehe","zieh"}),"ziehe");

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

int ziehe(string str)
{
   notify_fail("Was moechtest Du aufziehen?\n");
   
   if(!str || str == "") return 0;
   
   if(!(str == "spieluhr auf" ||
        str == "uhr auf"))   return 0;

   if(find_call_out("seqspieluhr") != -1)
   {
	write(BS("Aber die Spieluhr laeuft doch bereits! Warte noch "
	+"ein wenig."));
	return -1;
   }
   else
   {        
	write(BS("Du greifst mit den Fingern beherzt zu und ziehst die "
	+"Spieluhr auf."));
	
	ENV(TP)->Message(BS(TP->Name(WER, 1)+" zieht eine kleine "
	+"Spieluhr auf."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        
        call_out("seqspieluhr", 5 , TP, 1);
        return 1;
   }
}

void seqspieluhr(object player, int pos)
{
  string s;

    if(!player || player != ENV(TO))
    {
        return;
    }

    switch(pos)
    {
        case 1:
           s = "Du hoerst das leise Knacken der Zahnraeder...\n\n";
           break;
        
        case 2:
           s = "Die kleine Fee in der Spieluhr beginnt zu tanzen.\n\n";
           break;

        case 3:
           s = "Eine sehr alte Melodie klingt aus der Spieluhr.\n\n";
           break;

        case 4:
           s = "Die Fee scheint Dich anzulaecheln.\n\n";
           break;

        case 5:
           s = "Du hebst die Spieluhr hoeher.\n\n";
           break;

        case 6:
           s = "Die Fee pustet Dir etwas Feenstaub ins Gesicht und "
           "ploetzlich fuehlst Du Dich richtig wohl.\n\n";
           break;

        default:
          return;
          break;
    }

    tell_object(player, break_string(s, 78, 0, BS_LEAVE_MY_LFS));
    pos = pos + 1;
    call_out("seqspieluhr", 5, player, pos);
}
