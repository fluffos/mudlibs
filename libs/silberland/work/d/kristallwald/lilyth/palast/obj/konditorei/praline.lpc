#include "/d/kristallwald/lilyth/palast/def.h"
#include <food.h>
#include <properties.h>

inherit "/std/food";

//--Variablen&Defines------------------------------------------------------

string name;
string t;
string fuellung;

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  name = "";
  t = "";
  fuellung = "";

  switch(random(16))
  {
    case 1:
      name = "Rumtrueffel";
      t = "feinster Schokolade mit einer leckeren Rumtrueffelfuellung";
      fuellung = "Rumtrueffelfuellung";
      AddId( ({ "praline", "rumtrueffel", "rumtrueffelpraline", 
      "\nsuesses" }) );
      break;
    case 2:
      name = "Nussnougat";
      t = "feinster Schokolade mit einer leckeren Nussnougatcremefuellung";
      fuellung = "Nussnougatcremefuellung";
      AddId( ({ "praline", "nussnougat", "nussnougatpraline", 
      "\nsuesses" }) );
      break;
    case 3:
      name = "Orangenlikoer";
      t = "feinster Schokolade mit einer leckeren Orangenlikoerfuellung";
      fuellung = "Orangenlikoerfuellung";
      AddId( ({ "praline", "orangenlikoer", "orangenlikoerpraline",
      "\nsuesses" }) );
      break;
    case 4:
      name = "Kaffeesahne";
      t = "feinster Schokolade mit einer leckeren Kaffeesahnefuellung";
      fuellung = "Kaffeesahnefuellung";
      AddId( ({ "praline", "kaffeesahne", "kaffeesahnepraline",
      "\nsuesses" }) );
      break;
    case 5:
      name = "Traubennuss";
      t = "feinster Schokolade mit einer leckeren Traubennussfuellung";
      fuellung = "Traubennussfuellung";
      AddId( ({ "praline", "traubennuss", "traubennusspraline",
      "\nsuesses" }) );
      break;
    case 6:
      name = "Champagnertrueffel";
      t = "feinster Schokolade mit einer edlen Champagnertrueffelfuellung";
      fuellung = "Champagnertrueffelfuellung";
      AddId( ({ "praline", "champagnertrueffel", "champagnertrueffelpraline",
      "\nsuesses" }) );
      break;
    case 7:
      name = "Kirschmandel";
      t = "feinster Schokolade mit einer hellen Kirschmandelfuellung";
      fuellung = "Kirschmandelfuellung";
      AddId( ({ "praline", "kirschmandel", "kirschmandelpraline",
      "\nsuesses" }) );
      break;
    case 8:
      name = "Schokosahne";
      t = "feinster Schokolade mit einer cremigen Sahnefuellung";
      fuellung = "Sahnefuellung";
      AddId( ({ "praline", "schokosahne", "schokosahnepraline",
      "\nsuesses" }) );
      break;
    case 9:
      name = "Nougat";
      t = "feinster Schokolade mit einer leckeren Nougatfuellung";
      fuellung = "Nougatfuellung";
      AddId( ({ "praline", "nougat", "nougatpraline", "\nsuesses" }) );
      break;
    case 10:
      name = "Moccasahne";
      t = "feinster Schokolade mit einer dunklen Moccasahnefuellung";
      fuellung = "Moccasahnefuellung";
      AddId( ({ "praline", "moccasahne", "moccasahnepraline", "\nsuesses" }) );
      break;
    case 11:
      name = "Zartbitter";
      t = "feinster Zartbitterschokolade mit einer leckeren "
      +"Schokoladenfuellung";
      fuellung = "Schokoladenfuellung";
      AddId( ({ "praline", "zartbitter", "zartbitterpraline", "\nsuesses" }) );
      break;
    case 12:
      name = "Amarettomarzipan";
      t = "feinster Schokolade und einer leckeren Amarettomarzipanfuellung";
      fuellung = "Amarettomarzipanfuellung";
      AddId( ({ "praline", "amarettomarzipan", "amarettomarzipanpraline",
      "\nsuesses" }) );
      break;
    case 13:
      name = "Cappucinotrueffel";
      t = "feinster Schokolade mit einer dunklen Cappucinotrueffelfuellung";
      fuellung = "Cappucinotrueffelfuellung";
      AddId( ({ "praline", "cappucinotrueffel", "cappucinotrueffelpraline",
      "\nsuesses" }) );
      break;
    case 14:
      name = "Orangentrueffel";
      t = "feinster Schokolade mit einer leckeren Orangentrueffelfuellung";
      fuellung = "Orangentrueffelfuellung";
      AddId( ({ "praline", "orangentrueffel", "orangentrueffelpraline",
      "\nsuesses" }) );
      break;
    case 15:
      name = "Buttertrueffel";
      t = "feinster Schokolade mit einer hellen Buttertrueffelfuellung";
      fuellung = "Buttertrueffelfuellung";
      AddId( ({ "praline", "buttertrueffel", "buttertrueffelpraline",
      "\nsuesses" }) );
      break;
    default:
      name = "Vollmilchhaselnuss";
      t = "feinster Vollmilchschokolade mit einer feinen "
      +"Schokohaselnussfuellung";
      fuellung = "Schokohaselnussfuellung";
      AddId( ({ "praline", "vollmilchhaselnuss", "vollmilchhaselnusspraline",
      "\nsuesses" }) );
      break;
  }

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine "+name+"praline");
  SetProp(P_LONG,
    "Diese kleine Praline sieht wirklich lecker aus. Sie besteht aus "
    "allerfeinster edler Schokolade und einer leckeren Fuellung. "
    "Du kannst es kaum abwarten, sie aufzuessen.");

  AddDetail( ({ "schokolade", "herstellung", "vollmilchschokolade", 
  "zartbitterschokolade" }),
    "Nur die allerfeinste und edelste Schokolade wurde zur Herstellung "
    "dieser Praline verwendet.");

  AddSpecialDetail( ({ "fuellung" }),
    "strfuellung");

  AddSpecialDetail( ({ fuellung }),
    "strfuellungspec");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Praline");
  SetProp(P_GENDER, FEMALE);
  
//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 5);

  SetProp (P_FOOD_INFO, ([
    F_MSG      : "Du beisst ein winziges Stueckchen von der Praline ab und "
    "laesst es genussvoll auf der Zunge zergehen. Dann laesst Du schnell "
    "auch den Rest der Praline in Deinem Mund verschwinden und schliesst "
    "voll Hochgenuss die Augen. Mhhhhhh, lecker!",
    F_MSG_ROOM : "isst mit sichtbarem Genuss eine leckere "+name+"praline.\n",
    F_MSG_DECAY: "Die "+name+"praline zerschmilzt langsam.\n",
    F_MSG_REMOVE : "Die "+name+"praline ist nun voellig zerschmolzen.\n",
    F_VERB     : "essen" ]) );

  start_decay(3500, 300);

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer SpecialDetails-------------------------------------------

string strfuellung(string str)
{
  string s;

  if(name == "Rumtrueffel")
  {
  	s = "Eine leckere Rumtrueffelfuellung, umhuellt von feinster "
  	+"Schokolade.";
  }
  if(name == "Nussnougat")
  {
  	s = "Eine leckere Nussnougatfuellung, umhuellt von feinster "
  	+"Schokolade.";
  }
  if(name == "Orangenlikoer")
  {
  	s = "Eine leckere Orangenlikoerfuellung, umhuellt von feinster "
  	+"Schokolade.";
  }
  if(name == "Kaffeesahne")
  {
  	s = "Eine leckere Kaffeesahnefuellung, umhuellt von feinster "
  	+"Schokolade.";
  }
  if(name == "Traubennuss")
  {
  	s = "Eine leckere Traubennussfuellung, umhuellt von feinster "
  	+"Schokolade.";
  }
  if(name == "Champagnertrueffel")
  {
  	s = "Eine leckere Champagnertrueffelfuellung, umhuellt von feinster "
  	+"Schokolade.";
  }
  if(name == "Kirschmandel")
  {
  	s = "Eine leckere Kirschmandelfuellung, umhuellt von feinster "
  	+"Schokolade.";
  }
  if(name == "Schokosahne")
  {
  	s = "Eine leckere Sahnefuellung, umhuellt von feinster "
  	+"Schokolade.";
  }
  if(name == "Nougat")
  {
  	s = "Eine leckere Nougatfuellung, umhuellt von feinster "
  	+"Schokolade.";
  }
  if(name == "Moccasahne")
  {
  	s = "Eine leckere Moccasahnefuellung, umhuellt von feinster "
  	+"Schokolade.";
  }
  if(name == "Zartbitter")
  {
  	s = "Eine leckere Schokoladenfuellung, umhuellt von feinster "
  	+"Zartbitterschokolade.";
  }
  if(name == "Amarettomarzipan")
  {
  	s = "Eine leckere Amarettomarzipanfuellung, umhuellt von feinster "
  	+"Schokolade.";
  }
  if(name == "Cappucinotrueffel")
  {
  	s = "Eine leckere Cappucinotrueffelfuellung, umhuellt von feinster "
  	+"Schokolade.";
  }
  if(name == "Orangentrueffel")
  {
  	s = "Eine leckere Orangentrueffelfuellung, umhuellt von feinster "
  	+"Schokolade.";
  }
  if(name == "Buttertrueffel")
  {
  	s = "Eine leckere Buttertrueffelfuellung, umhuellt von feinster "
  	+"Schokolade.";
  }
  if(name == "Vollmilchhaselnuss")
  {
  	s = "Eine leckere Schokohaselnussfuellung, umhuellt von feinster "
  	+"Vollmilchschokolade.";
  }

  return BS(s);
}

string strfuellungspec(string str)
{
  string s;

  s = "Diese Praline hat eine leckere "+fuellung+".";
  
  return BS(s);
}
