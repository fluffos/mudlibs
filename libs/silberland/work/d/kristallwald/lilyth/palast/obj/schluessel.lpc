#include "../def.h"

inherit "std/thing";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein winziger Schluessel");
  SetProp(P_LONG,
    "Dieser winzige, goldglaenzende Schluessel ist gerade einmal halb so "
    "lang wie Dein kleiner Finger. Es gibt sicherlich nicht sehr viele "
    "Schloesser, in welche er hineinpassen wuerde.");

  AddDetail( ({ "finger" }),
    "Er ist nur halb so lang wie Dein kleiner Finger.");

  AddDetail( ({ "schloss", "schloesser" }),
    "Wenn Du richtig suchst, wirst Du es bestimmt finden.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schluessel");
  SetProp(P_NAME_ADJ, "winzig");
  AddAdjective( ({ "winziger", "winzigen", "winzigem" } ));
  SetProp(P_GENDER, MALE);
  AddId( ({"schluessel", "\ntraumseherschluessel"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_GOLD);
  SetProp(P_WEIGHT, 10);
  SetProp(P_SIZE, 4);
  SetProp(P_VALUE, 5);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Create Ende------------------------------------------------------------

}
