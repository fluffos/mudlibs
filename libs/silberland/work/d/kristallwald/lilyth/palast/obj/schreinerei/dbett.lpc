#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

string name;
int vorhang;
int paralyze (int zeit, object player);

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  name = 0;
  vorhang = AUF;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein schwarzes Himmelbett");
//SetProp(P_LONG, --> siehe weiter unten

  AddDetail( ({ "ebenholz", "holz" }),
    "Das Himmelbett besteht aus schwarzem Ebenholz.");

  AddDetail( ({ "ecken", "ecke" }),
    "An jeder Ecke des Bettes ist eine lange, schwarze Stange befestigt.");

  AddDetail( ({ "stangen", "stange" }),
    "An den Stangen sind schwarze Seidenvorhaenge befestigt worden.");

  AddDetail( ({ "kissen" }),
    "Die dunklen Kissen bestehen ebenso wie die Vorhaenge aus schwarzer "
    "Seide.");

  AddDetail( ({ "seide" }),
    "Schwarze Seide, wohin Du nur schaust.");

  AddDetail( ({ "bettlaken", "laken" }),
    "Selbst das Bettlaken ist schwarz.");

  AddDetail( ({ "dunkelelf", "dunkelelfen", "richtige", "richtiges" }),
    "Dieses Bett ist genau das Richtige fuer einen Dunkelelfen.");

  AddDetail( ({ "seiten", "seite" }),
    "Von allen Seiten wird das Bett von tiefschwarzen, seidenen "
    "Vorhaengen umgeben.");

  AddSpecialDetail( ({ "seidenvorhaenge", "seidenvorhang", "vorhaenge", 
  "vorhang" }),
    "strvorhaenge");
    
//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Himmelbett");
  SetProp(P_NAME_ADJ, "schwarz");
  AddAdjective( ({ "schwarzes" } ));
  SetProp(P_GENDER, NEUTER);
  AddId( ({"\nmoebel", "bett", "himmelbett", "\n_bett"}) );
//SetProp(P_INFO, "");

//--Eigenschaften----------------------------------------------------------
  
  SetProp(P_MATERIAL, ([ MAT_EBONY: 85, MAT_SILK: 15 ]));
  SetProp(P_MATERIAL, MAT_EBONY);
  SetProp(P_WEIGHT, 9000);
  SetProp(P_VALUE, 1300);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "lieg", "liege", "leg", "lege" }), "legen" );
  AddCmd( ({ "steh", "stehe" }), "aufstehen" );
  AddCmd( ({ "zieh", "ziehe" }), "ziehen" );
  AddCmd( ({ "stell", "stelle" }), "abstellen" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen fuer Special Details----------------------------------------

string strvorhaenge(string str)
{
  string s;

  if(vorhang == AUF)
  {
  	s = "Bodenlange Vorhaenge aus tiefschwarzer Seide umgeben das Bett "
  	+"von allen Seiten. Sie sind zur Seite gezogen.";
  }
  else
  {
  	s = "Bodenlange Vorhaenge aus tiefschwarzer Seide umgeben das Bett "
  	+"von allen Seiten. Sie sind zugezogen.";
  }
  return BS(s);
}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;
  
  txt = "Das grosse Himmelbett wurde vollstaendig aus schwarzem Ebenholz "
       +"angefertigt. An seinen vier Ecken ragen lange Stangen empor, an "
       +"denen dunkle Seidenvorhaenge befestigt sind. Schwarze Kissen "
       +"polstern das Bett von innen aus. Selbst das Bettlaken ist schwarz. "
       +"Das scheint genau das richtige Bett fuer einen Dunkelelfen zu sein.";

  //liegt jemand im Bett?
  if(name != 0)
  {
        if(TP->Name() == name)
        {
             if(vorhang == ZU)
             {
                 txt += " Du liegst gerade darin und hast die Vorhaenge "
                 +"um Dich herum zugezogen.";
             }
             else
             {
                 txt += " Du liegst gerade darin.";
             }
        }
        else
        {
             if(vorhang == ZU)
             {
                 txt += " Irgendwer scheint gerade in dem Bett zu "
                 +"schlafen, denn die Vorhaenge sind zugezogen.";
             }
             else
             {
                 txt +=  " "+name+" liegt gerade darin.";
             }
        }
  }
  
  return BS(txt);
}

//reinlegen:
int legen(string str)
{
  mixed res;

  notify_fail("Wo moechtest Du Dich hineinlegen?\n");

  if(!str || str == "") return 0;

  if(!(str == "in bett" ||
       str == "in himmelbett" )) return 0;

  if(ENV(TO) != ENV(TP))
  {
      write(BS("Stell das Bett doch erstmal irgendwo ab."));
      return -1;
  }
  else
  {
    if(TP->QueryProp(P_RACE) == "Dunkelelf" ||
       TP->QueryProp(P_RACE) == "Untoter")
    {
      if(vorhang == ZU)
      {
         write(BS("Zieh doch erstmal die Vorhaenge auf."));
         return -1;
      }
      else
      {
         if(name == 0)
         {
   	    if(res=TP->QueryProp(P_TMP_MOVE_HOOK))
            {
              if ( pointerp(res) && sizeof(res) >= 3
                   && intp(res[0]) && time() < res[0]
                   && objectp(res[1]) && stringp(res[2]) )
              {
                if (res[1] == TO)
                {
                  notify_fail("Das geht jetzt gerade nicht. Du wirst schon "
                +"wissen, warum.\n");
                  return 0;
                }
                else
                {
                  notify_fail("Das geht jetzt gerade nicht. Du wirst schon "
                +"wissen, warum.\n");
                  return 0;
                }
              }
            }
            
            write(break_string("Du legst Dich in das grosse Himmelbett "
            +"hinein und machst es Dir bequem. Die Seide raschelt leise und "
            +"umspielt sanft Deinen Koerper. Ah, das tut gut!",
            78, 0, BS_LEAVE_MY_LFS));

            ENV(TP)->Message(BS(TP->Name(WER, 1)+" macht es sich in dem "
            +"Himmelbett bequem."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
            name = TP->Name(WER);
            
            paralyze (999, TP);
            call_out("seqbett", 900, TP);
            return 1;
         }
         else
         {
            if(TP->Name() == name)
            {
                write(BS("Aber Du liegst doch bereits in dem Himmelbett."));
            }
            else
            {
                write(BS("Aber "+name+" liegt doch gerade in dem Himmelbett."));
            }
           
            return -1;
         }
      }
    }

    if(TP->QueryProp(P_RACE) == "Elf" ||
       TP->QueryProp(P_RACE) == "Hobbit" ||
       TP->QueryProp(P_RACE) == "Fee" ||
       TP->QueryProp(P_RACE) == "Mensch" ||
       TP->QueryProp(P_RACE) == "Zwerg")
    {
        write(break_string("Nein, in dieses Bett willst Du Dich lieber "
        +"nicht legen.\nEs ist Dir viel zu duester und unheimlich.",
        78, 0, BS_LEAVE_MY_LFS));
        return -1;
    }
    
    if(TP->QueryProp(P_RACE) == "Oger" ||
       TP->QueryProp(P_RACE) == "Troll")
    {
        write(break_string("Das Himmelbett ist fuer Dich leider zu klein.",
        78, 0, BS_LEAVE_MY_LFS));
        return -1;
    }
  }
}

void seqbett(object player)
{
    mixed res;
    
    if(player)
    {
       tell_object(player, "Es wird Dir allmaehlich zu langweilig im Bett "
       +"und Du stehst wieder auf.\n");

       ENV(TO)->Message(BS(player->Name(WER)+" erhebt sich anmutig aus dem "
       +"grossen Himmelbett.\n"),
       MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

       if(res=player->QueryProp(P_TMP_MOVE_HOOK))
       {
           if ( pointerp(res) && sizeof(res) >= 3
                && intp(res[0]) && time() < res[0]
                && objectp(res[1]) && stringp(res[2]) )
           {
                if (res[1] == TO)
                {
                     player->SetProp(P_TMP_MOVE_HOOK, 0);
                     if(find_call_out("seqbett") != -1)
                     remove_call_out("seqbett");
                }
           }
       }
    }
        
    vorhang = AUF;
    name = 0;
    return;
}

void BecomesNetDead(object player)
{
  mixed res;

  if(player && player->name() == name)
  {
    ENV(TO)->Message(BS(player->Name(WER)+" purzelt aus dem Bett heraus.\n"),
    MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

    if(res=player->QueryProp(P_TMP_MOVE_HOOK))
    {
        if ( pointerp(res) && sizeof(res) >= 3
             && intp(res[0]) && time() < res[0]
             && objectp(res[1]) && stringp(res[2]) )
        {
             if (res[1] == TO)
             {
                  player->SetProp(P_TMP_MOVE_HOOK, 0);
                  if (find_call_out("seqbett") != -1)
                     remove_call_out("seqbett");
             }
       }
    }
    vorhang = AUF;
    name = 0;
    return;
  }
}

void NotifyPlayerDeath(object player, object killer, int lost_xp)
{
  mixed res;

  if(player && player->name() == name)
  {
    ENV(TO)->Message(BS(player->Name(WER)+" purzelt aus dem Bett heraus.\n"),
    MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

    if(res=player->QueryProp(P_TMP_MOVE_HOOK))
    {
        if ( pointerp(res) && sizeof(res) >= 3
             && intp(res[0]) && time() < res[0]
             && objectp(res[1]) && stringp(res[2]) )
        {
             if (res[1] == TO)
             {
                  player->SetProp(P_TMP_MOVE_HOOK, 0);
                  if (find_call_out("seqbett") != -1)
                     remove_call_out("seqbett");
              }
        }
    }

    vorhang = AUF;
    name = 0;
    return;
  }
}

int aufstehen(string str)
{
  mixed res;
  
  notify_fail("Was willst Du tun?\n");

  if(!str || str == "") return 0;

  if(!(str == "aus bett auf" ||
       str == "aus himmelbett auf" ||
       str == "auf")) return 0;

  if(TP->Name() == name)
  {
     if(vorhang == ZU)
     {
        write(BS("Du ziehst die Vorhaenge beiseite und erhebst Dich "
        +"anmutig aus den seidenen Kissen."));
        
        ENV(TP)->Message(BS(TP->Name(WER, 1)+" erhebt sich anmutig aus dem "
        +"grossen Himmelbett."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        vorhang = AUF;
        name = 0;

        if(res=TP->QueryProp(P_TMP_MOVE_HOOK))
        {
            if ( pointerp(res) && sizeof(res) >= 3
                 && intp(res[0]) && time() < res[0]
                 && objectp(res[1]) && stringp(res[2]) )
            {
                 if (res[1] == TO)
                 {
                      TP->SetProp(P_TMP_MOVE_HOOK, 0);
                      if(find_call_out("seqbett") != -1)
                      remove_call_out("seqbett");
                 }
            }
        }
     
        return 1;
     }
     else
     {
        write(BS("Du erhebst Dich anmutig aus den Seidenkissen und "
        +"verlaesst das Himmelbett mit einigem Bedauern."));

        ENV(TP)->Message(BS(TP->Name(WER, 1)+" erhebt sich anmutig aus dem "
        +"grossen Himmelbett."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        name = 0;

        if(res=TP->QueryProp(P_TMP_MOVE_HOOK))
        {
            if ( pointerp(res) && sizeof(res) >= 3
                 && intp(res[0]) && time() < res[0]
                 && objectp(res[1]) && stringp(res[2]) )
            {
                 if (res[1] == TO)
                 {
                      TP->SetProp(P_TMP_MOVE_HOOK, 0);
                      if(find_call_out("seqbett") != -1)
                      remove_call_out("seqbett");
                 }
            }
        }

        return 1;
     }
  }
  else
  {
     write(BS("Aber Du liegst doch gar nicht in dem Himmelbett."));
     return -1;
  }
}

int ziehen(string str)
{
  notify_fail("Was willst Du auf- oder zuziehen?\n");

  if(!str || str == "") return 0;

  if(str == "vorhang auf" ||
     str == "vorhaenge auf" )
  {
      if(vorhang == AUF)
      {
          write(BS("Aber die Vorhaenge sind doch bereits zur Seite "
          +"gezogen."));
          return -1;
      }
      else
      {
         if(name != 0)
         {
            if(TP->Name() == name)
            {
                write(BS("Du ziehst die Vorhaenge auf und blinzelst ein "
                +"wenig. Es war doch gerade so schoen dunkel."));
                
                ENV(TP)->Message(BS("Jemand fummelt an den Bettvorhaengen "
                +"herum und sie lichten sich ploetzlich."),
                MSGFLAG_VISUAL|MSGFLAG_NO_TP);
                vorhang = AUF;
                return 1;
            }
            else
            {
                write(BS("Das lass mal lieber bleiben, "+name+" faende das "
                +"sicherlich gar nicht so lustig, wenn Du jetzt an den "
                +"Vorhaengen rumfummelst."));
                return -1;
            }
         }
         else
         {
            write(BS("Du ziehst die Vorhaenge des Bettes ein wenig zur "
            +"Seite."));

            ENV(TP)->Message(BS(TP->Name(WER, 1)+" zieht die Vorhaenge "
            +"des Bettes zur Seite."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
            vorhang = AUF;
            return 1;
         }
      }
  }

  if(str == "vorhang zu" ||
     str == "vorhaenge zu" )
  {
      if(vorhang == ZU)
      {
          write(BS("Aber die Vorhaenge sind doch bereits zugezogen."));
          return -1;
      }
      else
      {
         if(name != 0)
         {
            if(TP->Name() == name)
            {
                write(break_string("Du ziehst die Vorhaenge zu und es wird "
                +"ein wenig dunkler um Dich herum.\nAhhh, herrlich!",
                78, 0, BS_LEAVE_MY_LFS));
                
                ENV(TP)->Message(BS(TP->Name(WER, 1)+" fummelt an den "
                +"Bettvorhaengen herum."),
                MSGFLAG_VISUAL|MSGFLAG_NO_TP);
                vorhang = ZU;
                return 1;
            }
            else
            {
                write(BS("Das lass mal lieber bleiben. "+name+" faende das "
                +"sicherlich gar nicht so lustig, wenn Du jetzt an den "
                +"Vorhaengen rumfummelst."));
                return -1;
            }
         }
         else
         {
            write(BS("Du ziehst die Vorhaenge des Bettes zu."));

            ENV(TP)->Message(BS(TP->Name(WER, 1)+" fummelt an den "
            +"Bettvorhaengen herum."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
            vorhang = ZU;
            return 1;
         }
      }
  }
}

//Funktion zum Festhalten beim Liegen
int paralyze (int zeit, object player)
{
  if (objectp(player))
     player->SetProp(P_TMP_MOVE_HOOK, ({time()+zeit, TO, 
     "freeze_in_place"}) );
}

//Hilfsfunktion fuer Move_Hook
string freeze_in_place()
{
  return "Das geht jetzt gerade nicht. Du wirst schon wissen, warum.\n";
}

//Bett abstellen:
int abstellen(string str)
{
  notify_fail("Was willst Du abstellen?\n");

  if(!str || str == "") return 0;

  if(!(str == "bett ab" ||
       str == "himmelbett ab")) return 0;

  if(ENV(TO) != TP)
  {
        write(BS("Aber Du traegst das Himmelbett doch gar nicht mehr bei "
        +"Dir!"));
        return -1;
  }
  else
  {
        write(BS("Du stellst das schwarze Himmelbett ab."));

        ENV(TP)->Message(BS(TP->Name(WER, 1)+" stellt ein schwarzes "
        +"Himmelbett ab."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        
        move(ENV(TP), M_SILENT); 
        return 1;
  }
}

//wenn jemand versucht, das Bett zu nehmen, und es liegt wer drin
varargs int move(mixed dest,int method)
{
  if(objectp(dest))
  {
    if(name != 0)
    {
       write(BS("Aber es liegt doch noch jemand im Bett!\n"));
       return ME_CANT_LEAVE_ENV;
    }
  }
  return ::move(dest, method);
}
