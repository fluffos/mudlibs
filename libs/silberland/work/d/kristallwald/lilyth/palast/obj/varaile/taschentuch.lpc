#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

string farbe;
string name;
int tuch;

#define UNBENUTZT 1
#define BENUTZT 0

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  tuch = UNBENUTZT;
  name = 0;

  switch(random(7))
  {
    case 1:
      farbe = "rotkariert";
      AddAdjective( ({ "rotkariertes" }) );
      break;
    case 2:
      farbe = "blaugepunktet";
      AddAdjective( ({ "blaugepunktetes" }) );
      break;
    case 3:
      farbe = "rotgelbgestreift";
      AddAdjective( ({ "rotgelbgestreiftes" }) );
      break;
    case 4:
      farbe = "gruengetupft";
      AddAdjective( ({ "gruengetupftes" }) );
      break;
    case 5:
      farbe = "bunt";
      AddAdjective( ({ "buntes" }) );
      break;
    case 6:
      farbe = "schneeweiss";
      AddAdjective( ({ "schneeweisses" }) );
      break;
    default:
      farbe = "rosarot";
      AddAdjective( ({ "rosarotes" }) );
      break;
  }

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein "+farbe+"es Taschentuch");
  //Long siehe weiter unten

  AddDetail( ({ "seide" }),
    "Das Taschentuch besteht aus feinster Seide.");

  AddDetail( ({ "nase" }),
    "Nun, was macht man sonst mit einem Taschentuch?");

  AddDetail( ({ "hand" }),
    "Das Taschentuch wurde handgefertigt.");

  AddSpecialDetail( ({ "ecke" }),
    "strecke");

  AddSpecialDetail( ({ "name" }),
    "strname");

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "Du kannst Dich darin schneuzen oder Dir damit "
  +"die Nase putzen. Ausserdem koenntest Du Deinen Namen hineinsticken, "
  +"damit jeder sieht, wem das Taschentuch gehoert.");
  SetProp(P_NAME, "Taschentuch");
  SetProp(P_NAME_ADJ, ({ farbe }));
  SetProp(P_GENDER, NEUTER);
  AddId( ({"taschentuch", "tuch"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_SILK);
  SetProp(P_WEIGHT, 5);
  SetProp(P_SIZE, 25);
  SetProp(P_VALUE, 75);

//--Kommandos-------------------------------------------------------------

  AddCmd( ({ "schneuz", "schneuze" }), "schneuzen" );
  AddCmd( ({ "putz", "putze" }), "putzen" );
  AddCmd( ({ "wasch", "wasche" }), "waschen" );
  AddCmd( ({ "stick", "sticke" }), "sticken" );
  AddCmd( ({ "lies", "les", "lese" }), "lesen" );

//--Create Ende-----------------------------------------------------------

}

//--Funktionen fuer SpecialDetails-------------------------------------------

string strecke(string str)
{
  string s;

  if(name != 0)
  {
  	s = "In eine Ecke des Tuches wurde fein saeuberlich ein Name "
  	+"eingestickt.";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

string strname(string str)
{
  string s;

  if(name != 0)
  {
  	s = "In einer Ecke des Taschentuchs steht: "+name+".";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;

  txt = "Das "+farbe+"e Taschentuch besteht aus feinster Seide und wurde "
  +"von Hand gefertigt. Es ist gross genug, um sich ausgiebig die Nase "
  +"darin schneuzen zu koennen. ";

  //ist ein Name eingestickt?
  if(name != 0)
  {
        txt +=  "In eine Ecke des Tuches wurde ein Name eingestickt. ";
  }

  //ist das Tuch benutzt?
  if(tuch == BENUTZT)
  {
        txt +=  "Das Tuch koennte allerdings mal wieder gewaschen werden. ";
  }
  else
  {
        txt +=  "Das Tuch sieht frisch und sauber aus. ";
  }
  return BS(txt);
}


int schneuzen(string str)
{
  notify_fail("Wo hinein willst Du Dich schneuzen?\n");

  if(!str || str == "") return 0;

  if(!(str == "in tuch" ||
       str == "in taschentuch" ||
       str == "in "+farbe+"es tuch" ||
       str == "in "+farbe+"es taschentuch")) return 0;

  if(tuch == UNBENUTZT)
  {
      write(BS("Du schneuzt Dich kraeftig in Dein "+farbe+"es "
      +"Taschentuch.\n"));

      ENV(TP)->Message(BS(TP->Name(WER, 1)+" schneuzt sich kraeftig in "
      +(TP->QueryProp(P_GENDER) == MALE ? "sein": "ihr")+" "+farbe+"es "
      +"Taschentuch."),
      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      tuch = BENUTZT;
      return 1;
  }
  else
  {
      write(break_string("Ihhh, das Taschentuch ist doch schon mal benutzt "
      +"worden!\nWasche es lieber erstmal aus.\n", 78, 0, BS_LEAVE_MY_LFS));
      return -1;
  }
}

int putzen(string str)
{
  notify_fail("Womit willst Du Dir die Nase putzen?\n");

  if(!str || str == "") return 0;

  if(!(str == "nase mit tuch" ||
       str == "nase mit taschentuch" ||
       str == "nase mit "+farbe+"em tuch" ||
       str == "nase mit "+farbe+"em taschentuch" ||
       str == "nase")) return 0;

  if(tuch == UNBENUTZT)
  {
      write(break_string("Du putzt Dir mit Deinem "+farbe+"em Taschentuch "
      +"die Nase.\n", 78, 0, BS_LEAVE_MY_LFS));

      ENV(TP)->Message(BS(TP->Name(WER, 1)+" putzt sich mit "
      +(TP->QueryProp(P_GENDER) == MALE ? "seinem": "ihrem")+" "+farbe+"em "
      +"Taschentuch die Nase."),
      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      tuch = BENUTZT;
      return 1;
  }
  else
  {
      write(break_string("Ihhh, das Taschentuch ist doch schon mal benutzt "
      +"worden!\nWasche es lieber erstmal aus.\n", 78, 0, BS_LEAVE_MY_LFS));
      return -1;
  }
}

int waschen(string str)
{
  object raum;
  raum = ENV(TP);
  
  notify_fail("Was willst Du waschen?\n");

  if(!str || str == "") return 0;

  if(!(str == "tuch" ||
       str == "taschentuch" ||
       str == farbe+"es tuch" ||
       str == farbe+"es tuch")) return 0;

  if(member(raum->QueryProp(P_DETAILS), "wasser")  ||
     member(raum->QueryProp(P_DETAILS), "quelle")  ||
     member(raum->QueryProp(P_DETAILS), "bach")    ||
     member(raum->QueryProp(P_DETAILS), "see")     ||
     member(raum->QueryProp(P_DETAILS), "fluss")   ||
     member(({TT_WATER,TT_UNDERWATER}),
     raum->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN])!=-1) 
  {
      write(break_string("Du waeschst das "+farbe+"e Taschentuch gruendlich "
      +"aus und laesst es ein wenig in der Sonne trocknen.\n",
      78, 0, BS_LEAVE_MY_LFS));

      ENV(TP)->Message(BS(TP->Name(WER, 1)+" waescht "
      +(TP->QueryProp(P_GENDER) == MALE ? "sein": "ihr")+" "+farbe+"es "
      +"Taschentuch aus."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  
      tuch = UNBENUTZT;
      return 1;
  }
  else
  {
      write(break_string("Du kannst Dein Taschentuch hier nicht waschen.\n"
      +"Es ist weit und breit kein Wasser zu sehen.\n",
      78, 0, BS_LEAVE_MY_LFS));
      return -1;
  }
}

//Namen reinsticken
int sticken(string str)
{
  notify_fail("Worauf moechtest Du Deinen Namen sticken?\n"
  +"(Syntax: <sticke name auf taschentuch>)\n");

  if(!str || str == "") return 0;

  if(name == 0)
  {
      write(BS("Mit feinen Stichen stickst Du Deinen Namen auf das "
      +"Taschentuch."));
           
      ENV(TP)->Message(BS(TP->Name(WER, 1)+" stickt "
      +(TP->QueryProp(P_GENDER) == MALE ? "seinen": "ihren")+" "
      +"Namen auf ein Taschentuch."),  	       
      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
             
      name = TP->Name(WER);
      return 1;
  }
  else
  {
      if(TP->Name() == name)
      {
          write(BS("Aber Dein Name steht doch bereits auf dem "
          +"Taschentuch."));
          return -1;
      }
      else
      {
          write(BS("Aber das Taschentuch gehoert Dir doch gar nicht."));
          return -1;
      }
  }
}

int lesen(string str)
{
  notify_fail("Was moechtest Du lesen?\n");

  if(!str || str == "") return 0;

  if(!(str == "name")) return 0;

  if(name != 0)
  {
      write(BS(name+".\n"));
      return 1;
  }
  else
  {
      write(BS("Was moechtest Du lesen?\n"));
      return -1;
  }
}
