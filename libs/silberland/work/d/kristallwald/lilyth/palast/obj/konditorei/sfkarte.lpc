#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine magische Karte");
//SetProp(P_LONG, --> siehe unten

  AddDetail( ({ "schokofroesche", "schokofroeschen", "sammelkarten" }),
    "Diese Sammelkarten findet man nur in echten Schokofroeschen.");

  AddSpecialDetail( ({ "bild" }),
    "strbild");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Karte");
  SetProp(P_NAME_ADJ, "magisch");
  AddAdjective( ({ "magische" } ));
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "magic_card", "karte", "sammlerkarte", "sammelkarte" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_CARTON: 90, MAT_SILVER: 10 ]));
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 100);

//--Spezial----------------------------------------------------------------

  SetProp(P_MAGIER_NAME, "Unbekannt");
  SetProp(P_MAGIER_TITEL, "Magier");
  SetProp(P_MAGIER_GENDER, "MALE");

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;
  string s;

  txt = "In Deinen Haenden haeltst Du eine der magischen Sammlerkarten, "
  +"die normalerweise nur in Schokofroeschen zu finden sind. Diese hier "
  +"zeigt ein Bild von "+QueryProp(P_MAGIER_NAME)+".";

   return BS(txt);
}

//Detail Bild:
string strbild(string str)
{
  string s;
  string t;

  if(QueryProp(P_MAGIER_NAME) == "Woody")
    t = "Er ist der EINE, der wahre Gott des Silberlandes, der von allen "
       +"Lebewesen im Land, ob gross oder klein, geliebt und verehrt "
       +"wird. Diese Karte ist sicherlich die wertvollste und seltenste "
       +"Sammelkarte im ganzen Silberland und Du kannst stolz darauf "
       +"sein, dass sie sich in Deinem Besitz befindet.";
    else
      t = "Sie ist die Goettin des Silberlandes und wird besonders von "
         +"den Paladinen sehr verehrt. Diese Karte ist sicherlich eine "
         +"der wertvollsten und seltensten Sammelkarten im ganzen "
         +"Silberland und Du kannst stolz darauf sein, dass sie sich in "
         +"Deinem Besitz befindet.";

  if(QueryProp(P_MAGIER_TITEL) == "Erzmagier")
  {
    if(QueryProp(P_MAGIER_GENDER) == "MALE")
      t = "Er ist einer der Erzmagier hier im Silberland. ";
      else  t = "Sie ist eine der Erzmagierinnen hier im Silberland. ";

    t += "Diese Sammelkarte ist sicher sehr wertvoll, denn sie ist "
        +"aeusserst selten.";
  }

  if(QueryProp(P_MAGIER_TITEL) == "Weiser")
  {
    if(QueryProp(P_MAGIER_GENDER) == "MALE")
      t = "Er ist einer der Weisen hier im Silberland. ";
      else  t = "Sie ist eine der Weisen hier im Silberland. ";

    t += "Diese Sammelkarte ist sicher recht wertvoll, denn sie ist "
        +"ziemlich selten.";
  }

  if(QueryProp(P_MAGIER_TITEL) == "Regionsmagier")
  {
    if(QueryProp(P_MAGIER_GENDER) == "MALE")
      t = "Er ist einer der Regionsmagier hier im Silberland.";
      else  t = "Sie ist eine der Regionsmagierinnen hier im Silberland.";
  }

  if(QueryProp(P_MAGIER_TITEL) == "Magier fuer besondere Aufgaben")
  {
    if(QueryProp(P_MAGIER_GENDER) == "MALE")
      t = "Er ist Magier fuer besondere Aufgaben hier im Silberland.";
      else  t = "Sie ist Magierin fuer besondere Aufgaben hier im Silberland.";
  }

  if(QueryProp(P_MAGIER_TITEL) == "Vollmagier")
  {
    if(QueryProp(P_MAGIER_GENDER) == "MALE")
      t = "Er ist einer der Vollmagier hier im Silberland.";
      else  t = "Sie ist eine der Vollmagierinnen hier im Silberland.";
  }

  if(QueryProp(P_MAGIER_TITEL) == "Regionsmitarbeiter")
  {
    if(QueryProp(P_MAGIER_GENDER) == "MALE")
      t = "Er ist einer der Regionsmitarbeiter hier im Silberland.";
      else  t = "Sie ist eine der Regionsmitarbeiterinnen hier im Silberland.";
  }

  if(QueryProp(P_MAGIER_TITEL) == "Jungmagier")
  {
    if(QueryProp(P_MAGIER_GENDER) == "MALE")
      t = "Er ist einer der hoffnungsvollen Jungmagier hier im Silberland "
         +"und wird mit Sicherheit noch Grosses vollbringen.";
      else
        t = "Sie ist eine der hoffnungsvollen Jungmagierinnen hier im "
       +"Silberland und wird mit Sicherheit noch Grosses vollbringen.";
  }

  if(QueryProp(P_MAGIER_TITEL) == "Altmagier")
  {
    if(QueryProp(P_MAGIER_GENDER) == "MALE")
      t = "Er ist einer der Altmagier hier im Silberland.";
      else  t = "Sie ist eine der Altmagierinnen hier im Silberland.";
  }

  s = "Die Karte zeigt ein besonders gut gelungenes Bild von "
      +QueryProp(P_MAGIER_NAME)+". "+t;

  return break_string(s, 78, 0, BS_LEAVE_MY_LFS);
}
