#include "/d/kristallwald/lilyth/palast/def.h"
#include "/d/kristallwald/lilyth/ansi.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Karte der Ebene");  
//SetProp(P_LONG, -> siehe unten

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Karte");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"karte", "ebenenkarte", "ebene"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_PERGAMENT);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 350);
  SetProp(P_NOBUY, 1);

//--Create Ende------------------------------------------------------------

}

