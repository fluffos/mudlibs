#include "../def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Einladungskarte");
  SetProp(P_LONG,
    "Du siehst eine Einladungskarte mit einem huebschen Motiv vor Dir. "
    "Auf ihrer Rueckseite steht etwas geschrieben." );

  AddDetail( ({ "motiv" }),
    "Auf der Vorderseite der Karte ist eine einzelne, rote Blume "
    "abgebildet.");

  AddDetail( ({ "blume" }),
    "Du vermutest, dass es sich um eine Rose handelt.");

  AddDetail( ({ "rose" }),
    "Eine rote Rose ziert die Vorderseite der Karte.");

  AddDetail( ({ "vorderseite" }),
    "Die Vorderseite der Karte zeigt ein huebsches Motiv.");

  AddDetail( ({ "rueckseite" }),
    "Auf der Rueckseite der Karte steht in ordentlicher Schrift etwas "
    "geschrieben.");

  AddDetail( ({ "schrift" }),
    "Linah hat in ordentlicher Schrift etwas auf die Karte geschrieben.");

  AddDetail( ({ "linah" }),
    "Von ihr kommt diese Karte.");

  AddReadDetail( ({ "karte", "einladung", "einladungskarte", "rueckseite" }),
    "Lieber Tungdil,\n"
    "vielen Dank fuer diesen wunderschoenen Ring.\n"
    "Ich habe mich sehr ueber Dein Geschenk gefreut und moechte Dich "
    "als Dank dafuer heute abend zu einem gemuetlichen Hobbitmahl "
    "einladen.\n"
    "Ich wuerde mich sehr freuen, wenn Du gegen 20 Uhr herueberkommen "
    "wuerdest.\n"
    "Liebe Gruesse, Deine Linah\n");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Einladung");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"einladung", "einladungskarte", "karte", "\neinladung"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_PAPER);
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 5);

//--Create Ende------------------------------------------------------------

}
