#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Spiegel");
  SetProp(P_LONG,
    "Ein grosser blankgeputzter Spiegel. Sein heller Holzrahmen ist mit "
    "huebschen Verzierungen versehen und seine Oberflaeche glaenzt "
    "wie frisch poliert.");

  AddDetail( ({ "holzrahmen", "rahmen" }),
    "Der Rahmen besteht aus hellem Holz und ist huebsch verziert.");

  AddDetail( ({ "holz" }),
    "Das Holz hat eine gleichmaessige helle Farbe.");

  AddDetail( ({ "farbe" }),
    "Es ist hellbraun.");

  AddDetail( ({ "verzierungen", "verzierung" }),
    "Huebsche blumenartige Verzierungen schmuecken den Rahmen aus.");

  AddDetail( ({ "oberflaeche" }),
    "In der blank geputzten Oberflaeche kannst Du Dein Spiegelbild "
    "klar und deutlich sehen.");

  AddDetail( ({ "spiegelbild", "bild" }),
    "Du koenntest in den Spiegel hineinblicken.");

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "Mit 'blicke in spiegel' kannst Du Dich in dem "
  "Spiegel betrachten.");
  SetProp(P_NAME, "Spiegel");
  SetProp(P_GENDER, MALE);
  AddId( ({"spiegel", "\nmoebel", "\n_sonstige"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_MISC_WOOD: 55, MAT_GLASS: 45 ]));
  SetProp(P_WEIGHT, 1000);
  SetProp(P_SIZE, 70);
  SetProp(P_VALUE, 710);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "blick", "blicke" }), "blicken" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//in Spiegel blicken:
int blicken(string str)
{
  string *antworten;

  antworten = ({
  "Haaach, Du siehst aber auch wieder einmal gut aus heute!\n",
  "Oje, man sieht, dass Du noch nicht so richtig ausgeschlafen bist.\n",
  "Du solltest Dich dringend mal wieder kaemmen.\n",
  "und entdeckst eine weitere Falte in Deinem Gesicht.\n",
  "Huch, da waechst ja ein graues Haar auf Deinem Kopf!\n",
  "Vielleicht solltest Du den Friseur wechseln.\n",
  "Hm, Du bist ein bisschen blass um die Nase.\n",
  "Hauptsache, Du magst Dich so, wie Du bist.\n",
  "Eigentlich bist Du ganz zufrieden mit Deinem Aeusseren.\n",
  "Wie hiess noch dieser nette Friseur, dem Du letztens begegnet bist?\n",
  "Deine Frisur sitzt absolut perfekt.\n",
  "Iiiih, da sitzt ein dicker fetter Pickel mitten auf Deiner Nase!\n",
  "Deine letzte Diaet ist auch schon eine ganze Weile her.\n"});

  switch(TP->QueryProp(P_RACE))
  {
    case "Elf": antworten += ({"Eigentlich brauchst Du doch gar keinen "
      +"Spiegel, um zu wissen, dass Du gut aussiehst.\n", "Deine "
      +"Ohren sind noch genauso spitz wie frueher.\n", "Du wirst von "
      +"Deiner Schoenheit fast geblendet.\n"});
      break;
    case "Zwerg": antworten += ({"Naja, Zwerge legen ja zum Glueck nicht so "
      +"viel Wert auf Aeusserlichkeiten.\n", "Im dunklen Bergwerk sieht Dich "
      +"ja gluecklicherweise kaum jemand.\n", "Du solltest Deinen Bart "
      +"mal wieder ein wenig stutzen.\n"});
      break;
    case "Oger": antworten += ({"Naja, so richtig gut aussehen tust Du ja "
      +"nicht... Aber welcher Oger tut das schon?\n", "Seit wann "
      +"interessieren sich Oger dafuer, wie sie aussehen?\n", "Du koenntest "
      +"wirklich ein wenig mehr fuer Dein Aussehen tun, auch als Oger.\n"});
      break;
    case "Troll": antworten += ({"Naja, so richtig gut aussehen tust Du ja "
      +"nicht... Aber welcher Troll tut das schon?\n", "Seit wann "
      +"interessieren sich Trolle dafuer, wie sie aussehen?\n", "Du "
      +"koenntest wirklich ein wenig mehr fuer Dein Aussehen tun, auch als "
      +"Troll.\n"});
      break;
    case "Fee": antworten += ({"Huch, Dein rechter Fluegel ist ein wenig "
      +"eingeknickt. Schnell streichst Du ihn wieder glatt.\n", "Irgendwie "
      +"sieht Dein Spiegelbild groesser aus als Du.\n", "Deine Fluegel "
      +"stehen Dir richtig gut.\n"});
      break;
    case "Dunkelelf": antworten += ({"Ein wenig Sonnenlicht wuerde Dir "
      +"sicher mal ganz gut tun.\n", "Weisse Haare koennen richtig "
      +"vorteilhaft aussehen.\n", "Ob die ewige Dunkelheit wirklich so "
      +"gesund fuer Deine Haut ist?\n"});
      break;
    case "Hobbit": antworten += ({"Vielleicht solltest Du in Zukunft eine "
      +"der sieben Mahlzeiten am Tag weglassen?\n", "Fuer einen Hobbit "
      +"siehst Du ausgesprochen gut aus.\n", "Ein froehliches Hobbitgesicht "
      +"blickt Dir aus dem Spiegel entgegen.\n"});
      break;
    case "Untoter": antworten += ({"Hui, Du siehst richtig "
      +"furchteinfloessend aus!\n", "Wenn Du nicht bereits so gut wie tot "
      +"waerst, wuerdest Du vor Schreck tot umfallen.\n", "Bleichgesichtig "
      +"starrt Dich Dein Spiegelbild aus dem Spiegel heraus an.\n"});
      break;
    default: antworten += ({"Was auch immer Du bist, Du siehst wirklich "
      +"gut aus!\n", "Eigentlich stehst Du doch ueber diesen "
      +"Dingen.\n", "Bist Du sicher, dass Du DAS sehen willst?\n"});
      break;
  }

  notify_fail("Wo moechtest Du hineinblicken?\n");

  if(!str || str == "") return 0;

  if(!(str == "in spiegel" ||
       str == "in spiegel hinein")) return 0;

  	write(("Du betrachtest Dich eingehend im Spiegel...\n"
  	""+antworten[random(sizeof(antworten)-1)]));

  	ENV(TP)->Message(BS(TP->Name(WER, 1)+" betrachtet sich eingehend "
  	+"im Spiegel."),
  	MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  	return 1;
}
