#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

string* goetter;
string* erzmagier;
string* weise;
string* regionsmagier;
string* sondermagier;
string* vollmagier;
string* regionsmitarbeiter;
string* jungmagier;
string* altmagier;

string name;
string titel;
string gender;
int value;

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  goetter       = ({"Woody", "Dusty"});
  erzmagier     = ({"Angrox", "Cirion", "Feyaria", "Zordan"});
  weise         = ({"Protheg", "Rage"});
  regionsmagier = ({"Dante", "Iwo", "Malar", "Sargola", "Torian"});
  sondermagier  = ({"Gwenshara", "Thor"});
  vollmagier    = ({"Aaliyah", "Andyl", "Angel", "Archon", "Chivas", "Eros",
                    "Hiri", "Hotaru", "Stahldorn", "Wraz", "Xorgan"});

  regionsmitarbeiter = ({"Anatol", "Azrael", "Carador", "Debugger",
                         "Delgo",  "Hactar", "Hasibaerchi", "Hicks",
                         "Kia", "Kolmey", "Lamuerte", "Lilyth",
                         "Muaddib", "Raballion", "Roc", "Trintrasil",
                         "Verdandi", "Yara", "Zaknafein", "Zuni"});

  jungmagier = ({"Arc", "Dinin", "Drogo", "Eldoril", "Jarel",
                 "Jorinde", "Kailani", "Koomi", "Lathspell",
                 "Libella", "Lilea", "Marco", "Purpur", "Rait",
                 "Serdor", "Sourcerer", "Xeen"});

  altmagier = ({"Amazora", "Arthoas", "Banshee", "Berx", "Bez",
                "Buzzom", "Caradhras", "Charon", "Claudius",
                "Embee", "Escubar", "Eumel", "Fidget", "Gladstone",
                "Joscherl", "Juckos", "Kal", "Kampfbesen", "Kermet",
                "Kurti", "Lamyra", "Lexana", "Lostboy", "Lupus",
                "Magi", "Manitu", "Mephisto", "Moira", "Mond",
                "Monimor", "Nostromo", "Omrani", "Orw", "Rohkopfrex",
                "Rootcute", "Speedy", "Tantor", "Tilly", "Trantor",
                "Wuschel"});

name = "Unbekannt";
titel = "Magier";
gender = "MALE";

  switch(random(100))
  {
    case 0..24:
      name = altmagier[random(sizeof(altmagier))];
      if(name = "Amazora"  ||
         name = "Lamyra"   ||
         name = "Lexana"   ||
         name = "Moira"    ||
         name = "Omrani"   ||
         name = "Rootcute" ||
         name = "Wuschel") gender = "FEMALE";
      titel = "Altmagier";
      value = 50;
      break;

    case 25..46:
      name = jungmagier[random(sizeof(jungmagier))];
      if(name == "Jorinde"  ||
         name == "Kailani"  ||
         name == "Libella"  ||
         name == "Lilea") gender = "FEMALE";
      titel = "Jungmagier";
      value = 100;
      break;

    case 47..66:
      name = regionsmitarbeiter[random(sizeof(regionsmitarbeiter))];
      if(name == "Hasibaerchi" ||
         name == "Hicks"       ||
         name == "Kia"         ||
         name == "Lilyth"      ||
         name == "Verdandi"    ||
         name == "Yara"        ||
         name == "Zuni") gender = "FEMALE";
      titel = "Regionsmitarbeiter";
      value = 150;
      break;

    case 67..76:
      name = vollmagier[random(sizeof(vollmagier))];
      if(name == "Aaliyah" ||
         name == "Angel"   ||
         name == "Hiri"    ||
         name == "Hotaru") gender = "FEMALE";
      titel = "Vollmagier";
      value = 200;
      break;

    case 77..84:
      name = sondermagier[random(sizeof(sondermagier))];
      if(name == "Thor" ||
         name == "Gwenshara") gender = "FEMALE";
      titel = "Magier fuer besondere Aufgaben";
      value = 250;
      break;

    case 85..90:
      name = regionsmagier[random(sizeof(regionsmagier))];
      //if(name == "") gender = "FEMALE";
      titel = "Regionsmagier";
      value = 300;
      break;

    case 91..95:
      name = weise[random(sizeof(weise))];
      //if(name == "") gender = "FEMALE";
      titel = "Weiser";
      value = 500;
      break;

    case 96..98:
      name = erzmagier[random(sizeof(erzmagier))];
      if(name == "Feyaria") gender = "FEMALE";
      titel = "Erzmagier";
      value = 750;
      break;

    case 99:
      name = goetter[random(sizeof(goetter))];
      if(name == "Dusty") gender = "FEMALE";
      titel = "Gott";
      value = 1000;
      break;
  }

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine blaue Schachtel");
  SetProp(P_LONG,
    "Die Schachtel besteht aus einem festen, blauen Karton, auf dem kleine "
    "gruene und gelbe Froesche abgebildet sind. Um die Schachtel wurde eine "
    "rosafarbene Schleife gebunden.");

  AddDetail( ({ "karton" }),
    "Der blaue Karton sieht recht stabil aus. Sein Inhalt scheint gut "
    "geschuetzt zu sein.");

  AddDetail( ({ "inhalt" }),
    "Was mag sich wohl in der Schachtel befinden?");

  AddDetail( ({ "froesche" }),
    "Kleine gruene und gelbe Froesche sind auf der Schachtel abgebildet.");

  AddDetail( ({ "schleife", "schleifenband", "band" }),
    "Feines, rosafarbenes Schleifenband wurde um die Schachtel "
    "gebunden. Du erkennst eine kleine Aufschrift darauf.");

  AddDetail( ({ "aufschrift", "schrift" }),
    "Lies sie.");

  AddReadDetail( ({ "aufschrift", "schrift" }),
    "SCHOKOFROESCHE");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schachtel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, "blau");
  AddAdjective( ({ "blaue" } ));
  AddId( ({ "schachtel", "schokofroesche", "froesche" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_CARTON: 45, MAT_MISC_FOOD: 55 ]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 120);

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "oeffne", "reiss", "reisse" }), "oeffnen" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

int oeffnen(string str)
{
  int i;
  object myfrosch;
  object mykarte;

  notify_fail("Was willst Du oeffnen?\n");

  if(!str || str == "") return 0;

  if(!(str == "schachtel" ||
       str == "schachtel auf" )) return 0;

  write(break_string("Du reisst die Schachtel mit einem Ruck auf und "
  +"findest darin fuenf kleine Schokofroesche sowie eine seltsame "
  +"Karte.\n", 78, 0, BS_LEAVE_MY_LFS));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" reisst eine Schachtel "
  +"Schokofroesche auf."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  i = 4;

  while(i--)
  {
    myfrosch=clone_object(OBJ "konditorei/sffrosch");

    if(ME_TOO_HEAVY == myfrosch->move(TP,M_GET|M_SILENT))
    {
      myfrosch->move(ENV(TP), M_PUT|M_SILENT);

      write(BS("Da Du den Schokofrosch nicht mehr tragen kannst, "
      +"legst Du ihn kurzerhand auf den Boden."));
      return -1;

      ENV(TP)->Message(BS(TP->Name(WER, 1)+" legt einen Schokofrosch ab."),
      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    }
  }

  mykarte=clone_object(OBJ "konditorei/sfkarte");
  mykarte->SetProp(P_MAGIER_NAME, name);
  mykarte->SetProp(P_MAGIER_TITEL, titel);
//  mykarte->SetProp(P_MAGIER_MITARBEIT, mitarbeit);
//  mykarte->SetProp(P_MAGIER_REGION, region);
  mykarte->SetProp(P_MAGIER_GENDER, gender);
  mykarte->SetProp(P_VALUE, value);

  if(ME_TOO_HEAVY == mykarte->move(TP,M_GET|M_SILENT))
  {
    mykarte->move(ENV(TP), M_PUT|M_SILENT);

    write(BS("Da Du die Karte nicht mehr tragen kannst, legst Du sie "
    +"kurzerhand auf den Boden."));
    return -1;

    ENV(TP)->Message(BS(TP->Name(WER, 1)+" legt eine Karte ab."),
    MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  }

  TO->remove();
 	return 1;
}


