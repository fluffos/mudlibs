#include "../def.h"
#include <food.h>
#include <properties.h>

inherit "/std/food";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Sauerkirsche");
  SetProp(P_LONG,
   "Eine kleine, runde Sauerkirsche. Sie hat eine schoene, dunkelrote "
   "Farbe und sieht eigentlich gar nicht so sauer aus.");

  AddDetail( ({ "farbe" }),
    "Die Sauerkirsche ist dunkelrot.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Sauerkirsche");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"\nobst", "obst", "kirsche", "sauerkirsche"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 90);
  SetProp(P_VALUE, 25);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

  SetProp (P_FOOD_INFO, ([
    F_HEAL     : ({-1,-1}),
    F_SOAK: 1,
    F_ALCOHOL: -1,
    F_MSG      : "Du steckst Dir die Sauerkirsche in den Mund. Buaeeh, die "
                 "ist ja wirklich sauer!",
    F_MSG_ROOM : "isst eine Sauerkirsche und verzieht dann angewidert das "
                 "Gesicht.",
    F_MSG_DECAY: "Eine Sauerkirsche beginnt langsam zu verfaulen.\n",
    F_MSG_REMOVE: "Die Sauerkirsche ist voellig verfault und Du wirfst sie "
                  "weg.\n",
    F_VERB     : "essen" ]) );

  start_decay(1800, 900);

//--Create Ende------------------------------------------------------------

}
