#include "/d/kristallwald/lilyth/palast/def.h"

inherit "obj/entsorg";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Namen------------------------------------------------------------------

  AddId( ({ "\nmoebel", "\n_sonstige" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, break_string("Dieser Muellschlucker ist ein Exemplar der "
  "gleichen Art, wie Du sie auch aus anderen Laeden kennst. Allerdings "
  "frisst dieser hier nur die Sachen, mit denen Du ihn fuetterst, und "
  "raeumt nichts, was lose im Raum herumliegt, einfach auf.\n\n"
  "Achtung: Wenn es sich der Muellschlucker erst einmal in einem Seherhaus "
  "gemuetlich gemacht hat, ist er (zumindest lebendig) nicht wieder von "
  "dort wegzukriegen. Also stell ihn am besten gleich in das richtige "
  "Haus.", 78, 0, 1));
  SetProp(P_VALUE, 675);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

varargs int move(mixed dest,int method)
{
  object prev;

  //Der Laden darf den Muellschlucker moven
  if((prev=previous_object()) && (file_name(prev) == ROOM "ug_schreinerei"))   
  {
    method = method | M_NOCHECK|M_SILENT;
  }

  // Spieler duerfen ihn ablegen
  if((prev=previous_object()) && query_once_interactive(prev))
  {
    if(dest && (file_name(dest)[0..13] == "/d/seher/haus/") )
    {
      method = method | M_NOCHECK|M_SILENT;
    }
    else
    {
      if(!query_once_interactive(dest))
        write(BS("Das ist nur in Seherhaeusern erlaubt!"));
    }
  }
  
  return ::move(dest, method);
}

void reset()
{
  int i;
  object *inv;
  ::reset();
  
  inv=all_inventory(this_object());
  if(inv && sizeof(inv))
    for(i=sizeof(inv)-1;i>=0;i--)
      destruct(inv[i]);
}
