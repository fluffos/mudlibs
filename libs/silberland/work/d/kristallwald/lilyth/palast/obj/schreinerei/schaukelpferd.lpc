#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

string schaukler;
int festgehalten;
int paralyze (int zeit, object player);

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  schaukler = 0;
  festgehalten = NEIN;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein hoelzernes Schaukelpferd");
//SetProp(P_LONG,    "");   -> siehe unten

  AddDetail( ({ "maehne" }),
    "Das Pferdchen hat eine kurzgestutzte dunkelbraune Maehne. Sie fuehlt "
    "sich seidig weich und kuschelig an.");

  AddDetail( ({ "augen", "auge" }),
    "Die beiden Augen des Pferdes blicken Dich gutmuetig an. Sie sehen "
    "fast echt aus, obwohl sie nur aus Glas bestehen.");

  AddDetail( ({ "glas" }),
    "Die Augen bestehen aus schwarzgetoentem Glas.");

  AddDetail( ({ "kissen" }),
    "Ein kleines rotes Kissen liegt auf dem Holzsitz.");

  AddDetail( ({ "sitz", "holzsitz" }),
    "Es ist nur ein einfacher Holzsitz, der mit einem kleinen Kissen "
    "ausgepolstert ist.");

  AddDetail( ({ "holzstangen", "stangen", "holzstange", "stange" }),
    "Zwei kurze abgerundete Holzstangen dienen zum Festhalten beim "
    "Schaukeln.");

  AddDetail( ({ "festhalten", "halten" }),
    "Wenn Du schaukelst, kannst Du Dich an den Holzstangen festhalten, "
    "damit Du nicht herunterfaellst.");

  AddDetail( ({ "schaukeln" }),
    "Du kannst Dich auf das Schaukelpferd setzen und auf ihm schaukeln, "
    "wenn Du Lust hast.");

  AddDetail( ({ "lust" }),
    "Hast Du Lust?");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schaukelpferd");
  SetProp(P_NAME_ADJ, "hoelzern");
  AddAdjective( ({ "hoelzernes" } ));
  SetProp(P_GENDER, NEUTER);
  AddId( ({"\nmoebel", "pferd", "schaukelpferd", "pferdchen", "\n_sonstige"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_MISC_WOOD: 85, MAT_COTTON: 10, MAT_GLASS: 5 ]));
  SetProp(P_WEIGHT, 4000);
  SetProp(P_VALUE, 620);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "sitz", "sitze", "setz", "setze" }), "sitzen" );
  AddCmd( ({ "halt", "halte" }), "festhalten" );
  AddCmd( ({ "schaukel", "schaukele", "schaukle", "schaukl" }), "schaukeln" );
  AddCmd( ({ "steig", "steige" }), "absteigen" );
  AddCmd( ({ "stell", "stelle" }), "abstellen" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;

  txt = "Das kleine Schaukelpferd hat eine kurze wuschelige Maehne, zwei "
    "kreisrunde schwarze Augen, einen einfachen, mit einem duennen roten "
    "Kissen gepolsterten Sitz und zwei kurze Holzstangen, an denen man sich "
    "beim Schaukeln festhalten kann. ";

  if(schaukler)
  {
        if(schaukler == capitalize(getuid(TP)))
        {
                txt += "";
        }
        else
        {
                txt += ""+schaukler+" sitzt gerade darauf.";
        }
   }
   return BS(txt);
}

//sitzen:
int sitzen(string str)
{
  mixed res;

  notify_fail("Worauf moechtest Du Dich setzen?\n");

  if(!str || str == "") return 0;

  if(!(str == "auf pferd" ||
       str == "auf schaukelpferd" ||
       str == "dich auf pferd" ||
       str == "dich auf schaukelpferd" )) return 0;

  if(ENV(TO) != ENV(TP))
  {
      write(BS("Dazu solltest Du das Schaukelpferd erst einmal hinstellen."));
      return -1;
  }
  else
  {
      if(schaukler)
      {
          if(schaukler == capitalize(getuid(TP)))
          {
              write(BS("Aber Du sitzt doch bereits auf dem Schaukelpferd!"));
          }
          else
          {
              write(BS("Aber "+schaukler+" sitzt doch gerade auf dem "
              +"Schaukelpferd!"));
          }

      return -1;
      }
      else
      {
  	  if(res=TP->QueryProp(P_TMP_MOVE_HOOK))
          {
            if ( pointerp(res) && sizeof(res) >= 3
                 && intp(res[0]) && time() < res[0]
                 && objectp(res[1]) && stringp(res[2]) )
            {
              if (res[1] == TO)
              {
                notify_fail("Das geht jetzt gerade nicht. Du wirst schon "
                +"wissen, warum.\n");
                return 0;
              }
              else
              {
                notify_fail("Das geht jetzt gerade nicht. Du wirst schon "
                +"wissen, warum.\n");
                return 0;
              }
            }
          }
          
          write(BS("Du laesst Dich auf dem einfachen, aber bequemen "
          +"Holzsitz des Schaukelpferdes nieder."));

  	  ENV(TP)->Message(BS(TP->Name(WER, 1)+" setzt sich auf das "
  	  +"Schaukelpferd."),
  	  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  	  schaukler = capitalize(getuid(TP));
  	  
          paralyze (999, TP);
          call_out("seqhook", 900, TP);
  	  return 1;
      }
  }
}

//festhalten:
int festhalten(string str)
{
  notify_fail("Woran moechtest Du Dich festhalten?\n");

  if(!str || str == "") return 0;

  if(!(str == "fest" ||
       str == "an stangen fest" ||
       str == "an stange fest" ||
       str == "dich fest" ||
       str == "dich an stangen fest" ||
       str == "dich an stange fest" )) return 0;

  if(schaukler == capitalize(getuid(TP)))
  {
        if(festgehalten == JA)
        {
                write(BS("Noch mehr kannst Du Dich nicht festhalten, "
                +"sonst kriegst Du noch Blasen an den Fingern."));
                return -1;
        }
        else
        {
                write("Aengstlich klammerst Du Dich an den Holzstangen "
                +"fest.\n");

                ENV(TP)->Message(BS(TP->Name(WER, 1)+" klammert sich mit "
                +"aengstlichem Blick an den Holzstangen fest."),
                MSGFLAG_VISUAL|MSGFLAG_NO_TP);
                festgehalten = JA;
                return 1;
        }
  }
  else
  {
        write(BS("Willst Du Dich nicht lieber erst einmal auf das "
        +"Schaukelpferd draufsetzen?"));
        return -1;
  }
}

//schaukeln:
int schaukeln(string str)
{
  notify_fail("Worauf moechtest Du schaukeln?\n");

  if(!str || str == "") return 0;

  if(!(str == "auf pferd" ||
       str == "auf schaukelpferd")) return 0;

  if(schaukler == capitalize(getuid(TP)))
  {
        write("Du beginnst langsam zu schaukeln.\n\n");

        ENV(TP)->Message(BS(TP->Name(WER, 1)+" beginnt langsam zu "
        +"schaukeln."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        call_out("seqpferd", 5 , TP, 1);
        return 1;
  }
  else
  {
        write(BS("Dazu musst Du Dich erst einmal auf das Schaukelpferd "
        +"setzen!"));
        return -1;
  }
}

//Schaukel-Sequenz:
void seqpferd(object player, int pos)
{
  mixed res;
  string s;
  string s2;

    if(!player || ENV(player) != ENV(TO))
    {
        return;
    }

    	switch(pos)
        {
        case 1:
        s = "Du schaukelst und schaukelst...\n\n";
        s2 = ""+player->Name()+" schaukelt und schaukelt...";
        break;

        case 2:
        s = "und schaukelst...\n\n";
        s2 = "und schaukelt...";
        break;

        case 3:
        s = "Hach ja. So ein Schaukelpferd ist doch etwas Schoenes.\n\n";
        s2 = ""+player->Name()+" schaukelt froehlich herum.";
        break;

        case 4:
            if(festgehalten == NEIN)
            {
                s = "Das Schaukelpferd schaukelt immer mehr.\n\n";
                s2 = ""+player->Name()+" schaukelt immer mehr.";
                break;
            }
            else
            {
                s = "Du beginnst Dich an Deine Kindheit zu erinnern.\n\n";
                s2 = ""+player->Name()+" scheint in Kindheitserinnerungen zu "
                "schwelgen.";
                break;
            }

        case 5:
            if(festgehalten == NEIN)
            {
                s = "Ploetzlich merkst Du, wie Du vom Sitz "
                "herunterzurutschen drohst.\n\n";
                s2 = "Ploetzlich beginnt "+player->Name()+", unruhig "
                "herumzurutschen.";
                break;
            }
            else
            {
                s = "Damals hattest Du auch solch ein Schaukelpferd.\n\n";
                s2 = "Du denkst   . o O (Ich will auch mal schaukeln)";
                break;
            }

        case 6:
            if(festgehalten == NEIN)
            {
                s = "Verzweifelt versuchst Du, Dich an der Maehne des "
                "Pferdes festzuhalten, doch zu spaet.\n\n";
                s2 = ""+player->Name()+" versucht verzweifelt, sich "
                "an der Maehne des Pferdes festzuhalten, doch es ist bereits "
                "zu spaet.";
                break;
            }
            else
            {
                s = "Es war dunkelbraun mit einer hellen Maehne und hiess "
                "Ferdinand.\n\n";
                s2 = ""+player->Name()+" schaukelt immer weiter...";
                break;
            }

        case 7:
            if(festgehalten == NEIN)
            {
                s = "Mit einem lauten *PLUMPS* faellst Du vom Schaukelpferd "
                "herunter.\n\n";
                s2 = "Mit einem lauten *PLUMPS* faellt "+player->Name()+" "
                "vom Schaukelpferd herunter.";
                schaukler = 0;
                festgehalten = NEIN;
                
                if(res=player->QueryProp(P_TMP_MOVE_HOOK))
                {
                    if ( pointerp(res) && sizeof(res) >= 3
                         && intp(res[0]) && time() < res[0]
                         && objectp(res[1]) && stringp(res[2]) )
                    {
                         if (res[1] == TO)
                         {
                             player->SetProp(P_TMP_MOVE_HOOK, 0);
                             if (find_call_out("seqhook") != -1)
                                 remove_call_out("seqhook");
                         }
                    }
                }

                break;
            }
            else
            {
                s = "Du denkst noch ein wenig ueber Ferdinand nach, waehrend "
                "Du froehlich weiterschaukelst.\n\n";
                s2 = ""+player->Name()+" schaukelt froehlich herum.";
                break;
            }

        case 8:
            if(schaukler == capitalize(getuid(TP)))
            {
                s = "Langsam hast Du genug von der Schaukelei.\n\n";
                s2 = ""+player->Name()+" scheint endlich genug von der "
                "Schaukelei zu haben.";
                break;
            }

        case 9:
            if(schaukler == capitalize(getuid(TP)))
            {
                s = "Du schaukelst immer langsamer.\n\n";
                s2 = ""+player->Name()+" hoert langsam wieder auf zu "
                "schaukeln.";
                break;
            }

        case 10:
            if(schaukler == capitalize(getuid(TP)))
            {
                s = "Schliesslich steht das Schaukelpferd wieder ganz "
                "still.\n";
                s2 = "Schliesslich steht das Schaukelpferd wieder ganz "
                "still.";
                break;
            }

        default:
          return;
          break;
        }

        tell_object(player, break_string(s, 78, 0, BS_LEAVE_MY_LFS));
        ENV(TO)->Message(BS(s2), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        pos = pos + 1;
        call_out("seqpferd", 5, player, pos);
}

//aufstehen:
int absteigen(string str)
{
  mixed res;
  
  notify_fail("Von wo moechtest Du absteigen?\n");

  if(!str || str == "") return 0;

  if(!(str == "ab" ||
       str == "von pferd ab" ||
       str == "von schaukelpferd ab" )) return 0;

  if(schaukler == capitalize(getuid(TP)))
  {
        write(BS("Du steigst von dem Schaukelpferd ab."));

        ENV(TP)->Message(BS(TP->Name(WER, 1)+" klettert vom "
        +"Schaukelpferd herunter."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        festgehalten = NEIN;
        schaukler = 0;

        if(res=TP->QueryProp(P_TMP_MOVE_HOOK))
        {
            if ( pointerp(res) && sizeof(res) >= 3
                 && intp(res[0]) && time() < res[0]
                 && objectp(res[1]) && stringp(res[2]) )
            {
                 if (res[1] == TO)
                 {
                      TP->SetProp(P_TMP_MOVE_HOOK, 0);
                      if (find_call_out("seqhook") != -1)
                          remove_call_out("seqhook");
                 }
           }
        }

        return 1;
  }
  else
  {
        write(BS("Aber Du sitzt doch gar nicht auf dem Schaukelpferd!"));
        return -1;
  }
}

//Funktion zum Festhalten beim Schaukeln
int paralyze (int zeit, object player)
{
  if (objectp(player))
     player->SetProp(P_TMP_MOVE_HOOK, ({time()+zeit, this_object(), 
     "freeze_in_place"}) );
}

//Hilfsfunktion fuer Move_Hook
string freeze_in_place()
{
  return "Das geht jetzt gerade nicht. Du wirst schon wissen, warum.\n";
}

//Spieler logt aus, waehrend er auf dem Pferd sitzt
void BecomesNetDead(object player)
{
  mixed res;

  if(player && player->name() == schaukler)
  {
    ENV(TO)->Message(BS(player->Name(WER)+" rutscht von dem Schaukelpferd "
    +"herunter.\n"),
    MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

    if(res=player->QueryProp(P_TMP_MOVE_HOOK))
    {
        if ( pointerp(res) && sizeof(res) >= 3
             && intp(res[0]) && time() < res[0]
             && objectp(res[1]) && stringp(res[2]) )
        {
             if (res[1] == TO)
             {
                  player->SetProp(P_TMP_MOVE_HOOK, 0);
                  if (find_call_out("seqhook") != -1)
                      remove_call_out("seqhook");
             }
       }
    }
    schaukler = 0;
    festgehalten = NEIN;
    return;
  }
}

//Spieler stirbt, waehrend er auf dem Pferd sitzt
void NotifyPlayerDeath(object player, object killer, int lost_xp)
{
  mixed res;

  if(player && player->name() == schaukler)
  {
    ENV(TO)->Message(BS(player->Name(WER)+" rutscht von dem Schaukelpferd "
    +"herunter.\n"),
    MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

    if(res=player->QueryProp(P_TMP_MOVE_HOOK))
    {
        if ( pointerp(res) && sizeof(res) >= 3
             && intp(res[0]) && time() < res[0]
             && objectp(res[1]) && stringp(res[2]) )
        {
             if (res[1] == TO)
             {
                  player->SetProp(P_TMP_MOVE_HOOK, 0);
                  if (find_call_out("seqhook") != -1)
                      remove_call_out("seqhook");
              }
        }
    }

    schaukler = 0;
    festgehalten = NEIN;
    return;
  }
}

void seqhook(object player)
{
    mixed res;
    
    if(player)
    {
       tell_object(player, "Es wird Dir allmaehlich zu langweilig auf dem "
       +"Schaukelpferd und Du steigst wieder ab.\n");

       ENV(TO)->Message(BS(player->Name(WER)+" steigt von dem Schaukelpferd "
       +"ab.\n"),
       MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

       if(res=player->QueryProp(P_TMP_MOVE_HOOK))
       {
           if ( pointerp(res) && sizeof(res) >= 3
                && intp(res[0]) && time() < res[0]
                && objectp(res[1]) && stringp(res[2]) )
           {
                if (res[1] == TO)
                {
                     player->SetProp(P_TMP_MOVE_HOOK, 0);
                     if (find_call_out("seqhook") != -1)
                     remove_call_out("seqhook");
                }
           }
       }
    }
        
    schaukler = 0;
    festgehalten = NEIN;
    return;
}

//wenn jemand versucht, das Pferd zu nehmen, und es sitzt wer drauf
varargs int move(mixed dest,int method)
{
  if(objectp(dest))
  {
    if(schaukler != 0)
    {
       write(BS("Aber es sitzt doch noch jemand auf dem Schaukelpferd!\n"));
       return ME_CANT_LEAVE_ENV;
    }
  }
  return ::move(dest, method);
}

int abstellen(string str)
{
  notify_fail("Was willst Du abstellen?\n");

  if(!str || str == "") return 0;

  if(!(str == "pferd ab" ||
       str == "schaukelpferd ab")) return 0;

  if(ENV(TO) != TP)
  {
        write(BS("Aber Du traegst das Schaukelpferd doch gar nicht bei Dir!"));
        return -1;
  }
  else
  {
        write(BS("Du stellst das Schaukelpferd ab."));

        ENV(TP)->Message(BS(TP->Name(WER, 1)+" stellt ein Schaukelpferd ab."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        
        move(ENV(TP), M_SILENT); 
        return 1;
  }
}

