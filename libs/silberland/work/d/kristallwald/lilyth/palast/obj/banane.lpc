#include "../def.h"
#include <food.h>
#include <properties.h>

inherit "/std/food";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Banane");
  SetProp(P_LONG,
   "Die Banane ist krumm und gelb, wie es Bananen nun einmal sein sollten.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Banane");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"\nobst", "obst", "banane"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 45);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

  SetProp (P_FOOD_INFO, ([
    F_HEAL     : ({2,2}),
    F_SOAK: 1,
    F_MSG      : "Du isst die Banane restlos auf und wirfst die Schale "
                 "anschliessend weg.",
    F_MSG_ROOM : "isst eine gelbe Banane.",
    F_MSG_DECAY: "Eine Banane beginnt langsam zu verfaulen.\n",
    F_MSG_REMOVE: "Die Banane ist voellig verfault und Du wirfst sie weg.\n",
    F_VERB     : "essen" ]) );

  start_decay(1800, 900);

//--Create Ende------------------------------------------------------------

}
