#include "../def.h"
#include <food.h>
#include <properties.h>

inherit "/std/food";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Grapefruit");
  SetProp(P_LONG,
   "Diese Grapefruit hat eine roetlichgelbe, recht duenne Schale und einen "
   "leicht bittersuessen Geruch.");

  AddDetail( ({ "schale" }),
    "Die Schale hat eine roetlichgelbe Faerbung und ist duenner als "
    "bei Zitronen.");

  AddDetail( ({ "zitrone", "zitronen" }),
    "Zitronen haben dickere Schalen. Ausserdem sind sie gelb oder gruen "
    "gefaerbt.");

  AddDetail( ({ "faerbung" }),
    "Die Schale hat eine roetlichgelbe Faerbung.");

  AddDetail( ({ "geruch" }),
    "Du schnupperst an der Grapefruit herum und merkst, dass sie ein wenig "
    "bitter, gleichzeitig aber auch irgendwie suesslich riecht.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Grapefruit");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"\nobst", "obst", "grapefruit"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 220);
  SetProp(P_VALUE, 45);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

  SetProp (P_FOOD_INFO, ([
    F_HEAL     : ({-1,-1}),
    F_SOAK: 1,
    F_ALCOHOL: -1,
    F_MSG      : "Du isst die Grapefruit und verziehst angesichts "
                 "des leicht saeuerlichen Geschmacks das Gesicht.",
    F_MSG_ROOM : "isst mit leicht saeuerlichem Gesichtsausdruck eine "
                 "Grapefruit.",
    F_MSG_DECAY: "Eine Grapefruit beginnt langsam zu verfaulen.",
    F_MSG_REMOVE: "Die Grapefruit ist voellig verfault und Du wirfst sie "
                  "weg.",
    F_VERB     : "essen" ]) );

  start_decay(1800, 900);

//--Create Ende------------------------------------------------------------

}
