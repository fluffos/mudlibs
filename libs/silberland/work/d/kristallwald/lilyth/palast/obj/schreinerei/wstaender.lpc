#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/container";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Waffenstaender");
  SetProp(P_LONG, "Dieser grosse Waffenstaender eignet sich hervorragend "
  "dazu, all die vielen verschiedenen Waffen, die sich im Laufe eines "
  "abenteuerlichen Lebens so ansammeln koennen, darin aufzubewahren. Er "
  "besteht aus einem recht schlichten, einfachen Holzgestell, macht aber "
  "einen sehr stabilen und soliden Eindruck.");

  AddDetail( ({ "waffe", "waffen" }),
    "Dieser Waffenstaender ist dazu da, um Waffen in ihm aufzubewahren.");

  AddDetail( ({ "lauf", "laufe", "leben" }),
    "Nun, wie viele Waffen besitzt Du denn so?");

  AddDetail( ({ "holzgestell", "gestell" }),
    "Der Waffenstaender ist ein einfaches, aber stabiles Holzgestell, "
    "in dem Platz fuer einige grosse oder auch kleinere Waffen ist.");

  AddDetail( ({ "platz" }),
    "In dem Staender ist Platz fuer mehrere Waffen.");

  AddDetail( ({ "eindruck" }),
    "Der Waffenstaender macht einen sehr stabilen Eindruck. Du bist Dir "
    "ziemlich sicher, dass er auch unter dem Gewicht schwerer Waffen nicht "
    "so schnell zusammenbrechen wuerde.");

  AddDetail( ({ "gewicht" }),
    "Auch das Gewicht schwerer Aexte oder Keulen haelt dieser Staender "
    "muehelos aus.");

  AddDetail( ({ "aexte", "keulen" }),
    "Wenn Du welche hast, kannst Du sie ruhig in den Waffenstaender "
    "stellen, dann brauchst Du sie nicht immer mit Dir herumzuschleppen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Waffenstaender");
  SetProp(P_GENDER, MALE);
  AddId( ({"\nmoebel", "staender", "waffenstaender", "\n_sonstige"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_OAK);
  SetProp(P_WEIGHT, 7000);
  SetProp(P_VALUE, 1040);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Behaeltereigenschaften-------------------------------------------------

  SetProp(P_CONTAINER, 1);
  SetProp(P_MAX_WEIGHT, 125000);
  SetProp(P_WEIGHT_PERCENT, 33);
  SetProp(P_TRANSPARENT, 1);

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//nur Waffen reinstellen:
varargs int PreventInsert(object ob)
{
  if(ob->id("Waffe"))
  {
     return ::PreventInsert(ob);
  }
  return 1;
}
