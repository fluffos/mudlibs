#include "/d/kristallwald/lilyth/palast/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

inherit "/std/thing.lpc";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Hundefutter");
  SetProp(P_LONG,
    "Leckeres, schmackhaftes Hundefutter. Es besteht aus grossen, "
    "nicht mehr genauer definierbaren Fleischbrocken und schmeckt "
    "sicherlich auch Wolfshunden hervorragend.");

  AddDetail( ({ "fleischbrocken", "fleisch", "brocken" }),
    "Du kannst (und willst) gar nicht naeher herausfinden, woher dieses "
    "Fleisch stammt.");

  AddDetail( ({ "wolfshunde", "wolfshund" }),
    "Auch Wolfshunden duerfte dieses Futter hervorragend schmecken.");

  AddDetail( ({ "hund", "hunde", "art", "arten" }),
    "Dieses Hundefutter ist fuer alle Arten von Hunden geeignet.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Hundefutter");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"hundefutter", "futter"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 40);
  SetProp(P_SMELL, "Das Hundefutter riecht nach frischem Fleisch.\n");
  
//--Create Ende------------------------------------------------------------

}
