#include "/d/kristallwald/lilyth/palast/def.h"
#include <container.h>

inherit "std/container";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Tabakbeutel");
  SetProp(P_LONG,
    "Dieses kleine, aus feinstem Leder gefertigte Beutelchen ist gerade "
    "richtig, um eine gute Tagesration Pfeifenkraut darin aufzubewahren. "
    "Es wurde sicherlich von einem Hobbit angefertigt.");

  AddDetail( ({ "leder" }),
    "Der Tabakbeutel wurde aus feinstem dunkelbraunen Leder handgefertigt "
    "und mit kleinen Perlen huebsch verziert.");

  AddDetail( ({ "perlen", "perle" }),
    "Winzige, in hellen Farben schimmernde Perlen zieren das feine Leder.");

  AddDetail( ({ "farben", "farbe" }),
    "Die Perlen schimmern in hellen Farben.");

  AddDetail( ({ "tagesration", "ration" }),
    "Eine Tagesration passt sicherlich in den Beutel hinein.");

  AddDetail( ({ "pfeifenkraut", "kraut" }),
    "Wenn Du welches hast, kannst Du es in den Beutel hineinstecken.");

  AddDetail( ({ "hobbit", "hobbits", "muss" }),
    "Fuer einen pfeiferauchenden Hobbit (und welcher Hobbit ist das nicht?) "
    "sollte dieser edle Tabakbeutel ein absolutes Muss sein.");

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "In diesem Beutel kannst Du Dein Pfeifenkraut aufbewahren, "
  "sofern Du welches besitzt.");
  SetProp(P_NAME, "Tabakbeutel");
  SetProp(P_GENDER, MALE);
  AddId( ({"tabakbeutel", "beutel", "beutelchen"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_LEATHER);
  SetProp(P_WEIGHT, 50);
  SetProp(P_SIZE, 17);
  SetProp(P_VALUE, 120);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Behaeltereigenschaften-------------------------------------------------

  SetProp(P_CONTAINER, 1);
  SetProp(P_MAX_WEIGHT, 180);
  SetProp(P_WEIGHT_PERCENT, 33);
  SetProp(P_TRANSPARENT, 1);

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

varargs int PreventInsert(object ob)
{
        int i;
        string *mykraut;
        mykraut = ({ "kraut", "pfeifenkraut", "langgrundblatt", "suedstern",
        "grottenkraut", "nakrafulpflanze" });

        for(i = 0; i < sizeof(mykraut); i++)
        {
          if(ob->id(mykraut[i]))
          {
            return ::PreventInsert(ob);
          }
        }
        return 1;
}
