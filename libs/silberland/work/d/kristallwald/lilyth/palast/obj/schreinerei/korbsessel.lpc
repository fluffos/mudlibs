#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

string name;
int paralyze (int zeit, object player);

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  name = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein bequemer Korbsessel");
//SetProp(P_LONG, --> siehe weiter unten

  AddDetail( ({ "baumwollkissen", "kissen" }),
    "Ein dickes, buntgemustertes Baumwollkissen polstert den Korbsessel "
    "weich aus.");

  AddDetail( ({ "baumwolle", "wolle" }),
    "Das Kissen besteht aus herrlich weicher Baumwolle. Es ist "
    "buntgemustert.");

  AddDetail( ({ "sitzflaeche", "flaeche" }),
    "Die Sitzflaeche wird von dem grossen Baumwollkissen verdeckt, das "
    "auf ihr liegt.");

  AddDetail( ({ "armlehnen", "lehnen" }),
    "Die Armlehnen haben genau die richtige Hoehe, um dort bequem seine "
    "Arme abstuetzen zu koennen.");

  AddDetail( ({ "hoehe" }),
    "Sie ist genau richtig.");

  AddDetail( ({ "arme" }),
    "Hui, Du hast sogar zwei davon! Welch eine Ueberraschung! ;)");

  AddDetail( ({ "ueberraschung" }),
    "Ach, gib's doch zu, so ueberrascht warst Du jetzt gar nicht darueber. "
    "Oder etwa doch?");

  AddDetail( ({ "naturholz", "holz" }),
    "Der Korbsessel wurde aus einem besonders weichen, hellen Naturholz "
    "geflochten. Es sieht wirklich sehr huebsch aus und ist noch dazu "
    "unheimlich bequem.");

  AddDetail( ({ "rueckenlehne", "lehne" }),
    "Die Rueckenlehne ist leicht abgerundet und passt sich durch das "
    "weiche Holz hervorragend an den Koerper an.");

  AddDetail( ({ "koerper" }),
    "Auch an Deinen.");

  AddDetail( ({ "fussbank", "bank" }),
    "An der Unterseite des Sessels befindet sich eine kleine, "
    "ausziehbare Fussbank, auf der man beim Sitzen seine Fuesse "
    "ablegen und so richtig entspannen kann.");

  AddDetail( ({ "unterseite" }),
    "Die Fussbank befindet sich an der Unterseite des Korbsessels.");

  AddDetail( ({ "sitzen" }),
    "Dieser Korbsessel ist dazu gedacht, um darin zu sitzen. Aber darauf "
    "bist Du sicherlich auch schon von selbst gekommen.");

  AddDetail( ({ "fuesse", "fuss" }),
    "Auf der Fussbank kann man bequem seine Fuesse ablegen.");

  AddDetail( ({ "sitzkomfort", "komfort" }),
    "Viel bequemer geht es eigentlich gar nicht.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Korbsessel");
  SetProp(P_NAME_ADJ, "bequem");
  AddAdjective( ({ "bequemer", "bequemen", "bequemem" } ));
  SetProp(P_GENDER, MALE);
  AddId( ({"\nmoebel", "\n_stuhl", "sessel", "korbsessel"}) );
//SetProp(P_INFO, "");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_COTTON: 20, MAT_WOOD: 80 ]));
  SetProp(P_WEIGHT, 6000);
  SetProp(P_VALUE, 925);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "sitz", "sitze", "setz", "setze" }), "sitzen" );
  AddCmd( ({ "steh", "stehe" }), "aufstehen" );
  AddCmd( ({ "stell", "stelle" }), "abstellen" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;
  
  txt = "Der Korbsessel sieht sehr schlicht, aber dennoch umheimlich "
  +"bequem aus, was wohl hauptsaechlich an dem dicken Baumwollkissen liegt, "
  +"das die gesamte Sitzflaeche ausfuellt. Hohe Armlehnen, die aus "
  +"weichem Naturholz geflochtene Rueckenlehne und eine kleine "
  +"ausziehbare Fussbank sorgen fuer den bestmoeglichen Sitzkomfort.";

  //sitzt jemand im Sessel?
  if(name != 0)
  {
        if(TP->Name() == name)
        {
             txt += " Du hast es Dir bereits auf dem Sessel gemuetlich "
             +"gemacht.";
        }
        else
        {
             txt += " "+name+" hat es sich in dem Sessel gemuetlich "
             +"gemacht.";
        }
  }
  
  return BS(txt);
}

//hinsetzen:
int sitzen(string str)
{
  mixed res;
  
  notify_fail("Worauf willst Du Dich setzen?\n");

  if(!str || str == "") return 0;

  if(!(str == "auf sessel" ||
       str == "auf korbsessel" ||
       str == "in sessel" ||
       str == "in korbsessel")) return 0;

  if(ENV(TO) != ENV(TP))
  {
      write(BS("Stell den Korbsessel doch erst einmal ab."));
      return -1;
  }
  else
  {
     if(name == 0)
     {
        if(res=TP->QueryProp(P_TMP_MOVE_HOOK))
        {
           if ( pointerp(res) && sizeof(res) >= 3
                && intp(res[0]) && time() < res[0]
                && objectp(res[1]) && stringp(res[2]) )
           {
             if (res[1] == TO)
             {
               notify_fail("Das geht jetzt gerade nicht.\n");
               return 0;
             }
             else
             {
               notify_fail("Das geht jetzt gerade nicht.\n");
               return 0;
             }
           }
        }
                
        write(break_string("Du machst es Dir in dem Korbsessel "
        +"gemuetlich.\n",
        78, 0, BS_LEAVE_MY_LFS));

        ENV(TP)->Message(BS(TP->Name(WER, 1)+" macht es sich in "
        +"dem Korbsessel gemuetlich."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        name = TP->Name(WER);
        paralyze (999, TP);
        call_out("seqsessel", 900, TP);
        return 1;
     }
     else
     {
        if(TP->Name() == name)
        {
            write(BS("Aber Du sitzt doch schon in dem Korbsessel."));
        }
        else
        {
            write(BS("Der Korbsessel ist leider schon von "+name+" "
            +"besetzt."));
        }
           
        return -1;
     }
  }
}

void seqsessel(object player)
{
    mixed res;
    
    if(player)
    {
       tell_object(player, "Du fuehlst Dich vollkommen ausgeruht und "
       +"erhebst Dich aus dem Korbsessel.\n");

       ENV(TO)->Message(BS(player->Name(WER)+" erhebt sich aus dem "
       +"Korbsessel.\n"),
       MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

       if(res=player->QueryProp(P_TMP_MOVE_HOOK))
       {
           if ( pointerp(res) && sizeof(res) >= 3
                && intp(res[0]) && time() < res[0]
                && objectp(res[1]) && stringp(res[2]) )
           {
                if (res[1] == TO)
                {
                     player->SetProp(P_TMP_MOVE_HOOK, 0);
                     if(find_call_out("seqsessel") != -1)
                     remove_call_out("seqsessel");
                }
           }
       }
    }

    name = 0;
    return;
}

void BecomesNetDead(object player)
{
  mixed res;

  if(player && player->name() == name)
  {
    ENV(TO)->Message(BS(player->Name(WER)+" rutscht aus dem Korbsessel.\n"),
    MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

    if(res=player->QueryProp(P_TMP_MOVE_HOOK))
    {
        if ( pointerp(res) && sizeof(res) >= 3
             && intp(res[0]) && time() < res[0]
             && objectp(res[1]) && stringp(res[2]) )
        {
             if (res[1] == TO)
             {
                  player->SetProp(P_TMP_MOVE_HOOK, 0);
                  if (find_call_out("seqsessel") != -1)
                     remove_call_out("seqsessel");
             }
       }
    }

    name = 0;
    return;
  }
}

void NotifyPlayerDeath(object player, object killer, int lost_xp)
{
  mixed res;

  if(player && player->name() == name)
  {
    ENV(TO)->Message(BS(player->Name(WER)+" rutscht aus dem Korbsessel.\n"),
    MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

    if(res=player->QueryProp(P_TMP_MOVE_HOOK))
    {
        if ( pointerp(res) && sizeof(res) >= 3
             && intp(res[0]) && time() < res[0]
             && objectp(res[1]) && stringp(res[2]) )
        {
             if (res[1] == TO)
             {
                  player->SetProp(P_TMP_MOVE_HOOK, 0);
                  if (find_call_out("seqsessel") != -1)
                      remove_call_out("seqsessel");
              }
        }
    }

    name = 0;
    return;
  }
}

int aufstehen(string str)
{
  mixed res;
  
  notify_fail("Was willst Du tun?\n");

  if(!str || str == "") return 0;

  if(!(str == "von sessel auf" ||
       str == "von korbsessel auf" ||
       str == "aus sessel auf" ||
       str == "aus korbsessel auf" ||
       str == "auf")) return 0;

  if(TP->Name() == name)
  {
     write(BS("Du erhebst Dich ein wenig muehsam aus dem Korbsessel."));

     ENV(TP)->Message(BS(TP->Name(WER, 1)+" erhebt sich ein wenig muehsam "
     +"aus dem Korbsessel."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
     name = 0;

     if(res=TP->QueryProp(P_TMP_MOVE_HOOK))
     {
         if ( pointerp(res) && sizeof(res) >= 3
              && intp(res[0]) && time() < res[0]
              && objectp(res[1]) && stringp(res[2]) )
         {
              if (res[1] == TO)
              {
                   TP->SetProp(P_TMP_MOVE_HOOK, 0);
                   if(find_call_out("seqsessel") != -1)
                   remove_call_out("seqsessel");
              }
         }
     }

     return 1;
  }
  else
  {
     write(BS("Aber Du sitzt doch gar nicht in dem Korbsessel."));
     return -1;
  }
}


//Funktion zum Festhalten beim Sitzen
int paralyze (int zeit, object player)
{
  if (objectp(player))
     player->SetProp(P_TMP_MOVE_HOOK, ({time()+zeit, TO, 
     "freeze_in_place"}) );
}

//Hilfsfunktion fuer Move_Hook
string freeze_in_place()
{
  return "Das geht jetzt gerade nicht. Du wirst schon wissen, warum.\n";
}

//den Sessel abstellen:
int abstellen(string str)
{
  notify_fail("Was willst Du abstellen?\n");

  if(!str || str == "") return 0;

  if(!(str == "sessel ab" ||
       str == "korbsessel ab")) return 0;

  if(ENV(TO) != TP)
  {
        write(BS("Aber Du traegst den Korbsessel doch gar nicht bei Dir!"));
        return -1;
  }
  else
  {
        write(BS("Du stellst den Korbsessel ab."));

        ENV(TP)->Message(BS(TP->Name(WER, 1)+" stellt einen Korbsessel ab."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        
        move(ENV(TP), M_SILENT); 
        return 1;
  }
}

//wenn jemand versucht, den Sessel zu nehmen, und es sitzt wer drauf
varargs int move(mixed dest,int method)
{
  if(objectp(dest))
  {
    if(name != 0)
    {
       write(BS("Aber in dem Korbsessel sitzt doch noch jemand!\n"));
       return ME_CANT_LEAVE_ENV;
    }
  }
  return ::move(dest, method);
}
