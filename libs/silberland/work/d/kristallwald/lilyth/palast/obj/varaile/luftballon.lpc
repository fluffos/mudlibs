#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

string farbe;
string name;
string zetteltext;
string strzettel(string str);

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  name = "";

  switch(random(23))
  {
    case 1:
      farbe = "rot";
      AddAdjective( ({ "roten", "roter" }) );
      break;
    case 2:
      farbe = "blau";
      AddAdjective( ({ "blauen", "blauer" }) );
      break;
    case 3:
      farbe = "gelb";
      AddAdjective( ({ "gelben", "gelber" }) );
      break;
    case 4:
      farbe = "himmelblau";
      AddAdjective( ({ "himmelblauen", "himmelblauer" }) );
      break;
    case 5:
      farbe = "weinrot";
      AddAdjective( ({ "weinroten", "weinroter" }) );
      break;
    case 6:
      farbe = "violettfarben";
      AddAdjective( ({ "violettfarbenen", "violettfarbener" }) );
      break;
    case 7:
      farbe = "blaugruen";
      AddAdjective( ({ "blaugruenen", "blaugruener" }) );
      break;
    case 8:
      farbe = "schneeweiss";
      AddAdjective( ({ "schneeweissen", "schneeweisser" }) );
      break;
    case 9:
      farbe = "hellgruen";
      AddAdjective( ({ "hellgruenen", "hellgruener" }) );
      break;
    case 10:
      farbe = "feuerrot";
      AddAdjective( ({ "feuerroten", "feuerroter" }) );
      break;
    case 11:
      farbe = "grasgruen";
      AddAdjective( ({ "grasgruenen", "grasgruener" }) );
      break;
    case 12:
      farbe = "rosafarben";
      AddAdjective( ({ "rosafarbenen", "rosafarbener" }) );
      break;
    case 13:
      farbe = "lilafarben";
      AddAdjective( ({ "lilafarbenen", "lilafarbener" }) );
      break;
    case 14:
      farbe = "dunkelblau";
      AddAdjective( ({ "dunkelblauen", "dunkelblauer" }) );
      break;
    case 15:
      farbe = "sonnengelb";
      AddAdjective( ({ "sonnengelben", "sonnengelber" }) );
      break;
    case 16:
      farbe = "tiefschwarz";
      AddAdjective( ({ "tiefschwarzen", "tiefschwarzer" }) );
      break;
    case 17:
      farbe = "silbern";
      AddAdjective( ({ "silbernen", "silberner" }) );
      break;
    case 18:
      farbe = "golden";
      AddAdjective( ({ "goldenen", "goldener" }) );
      break;
    case 19:
      farbe = "bonbonrosafarben";
      AddAdjective( ({ "bonbonrosafarbenen", "bonbonrosafarbener" }) );
      break;
    case 20:
      farbe = "orangefarben";
      AddAdjective( ({ "orangefarbenen", "orangefarbener" }) );
      break;
    case 21:
      farbe = "tuerkisfarben";
      AddAdjective( ({ "tuerkisfarbenen", "tuerkisfarbener" }) );
      break;
    case 22:
      farbe = "kupferfarben";
      AddAdjective( ({ "kupferfarbenen", "kupferfarbener" }) );
      break;
    default:
      farbe = "gruen";
      AddAdjective( ({ "gruenen", "gruener" }) );
      break;
  }

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein "+farbe+"er Luftballon");
  //Long siehe weiter unten

  AddDetail( ({ "schnur" }),
    "Der Ballon ist an einer duennen Schnur befestigt, so dass er Dir nicht "
    "wegfliegen kann. Es sei denn, Du laesst die Schnur los, aber das "
    "willst Du ja sicher nicht.");

  AddDetail( ({ "zettel" }),
    "Ein kleiner Zettel haengt unten an der Schnur. Du kannst lesen, was "
    "auf ihm steht.");

  AddReadDetail("zettel", #'strzettel);

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "Du kannst ihn jemandem schenken, wenn Du magst. Oder "
  "Du schreibst eine Nachricht auf den Zettel, der an der Schnur haengt, "
  "und laesst den Ballon dann fliegen, vielleicht findet ihn ja "
  "irgend jemand. Wenn Du ihn loswerden moechtest, kannst Du ihn auch "
  "einfach zerplatzen lassen.");

  SetProp(P_NAME, "Luftballon");
  SetProp(P_NAME_ADJ, ({ farbe }));
  SetProp(P_GENDER, MALE);
  AddId( ({"luftballon", "ballon"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_AIR: 85, MAT_MISC_FLEXIBLE: 15 ]));
  SetProp(P_WEIGHT, 1);
  SetProp(P_SIZE, 37);
  SetProp(P_VALUE, 10);

//--Kommandos-------------------------------------------------------------

  AddCmd( ({ "schenk", "schenke" }), "schenken" );
  AddCmd( ({ "beschrifte" }), "beschriften" );
  AddCmd("lass|lasse&ballon|luftballon&fliegen", "fliegen",
     "Was genau moechtest Du tun?");
  AddCmd("lass|lasse&ballon|luftballon&platzen|zerplatzen", "zerplatzen",
     "Was genau moechtest Du tun?");

//--Create Ende-----------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;

  txt = "Ein prall gefuellter "+farbe+"er Luftballon schwebt an einer "
  "duennen Schnur ueber Deinem Kopf. ";

  //wurde der Ballon verschenkt oder nicht?
  if(name == "")
  {
        return BS(txt);
  }
  else
  {
        txt +=  name+ " hat Dir den Ballon geschenkt.";
  }
  return BS(txt);
}

//Detail "Zettel":
string strzettel(string str)
{
  string s;

  if(!zetteltext)
  {
  	s = "Der Zettel ist leer. Mit 'beschrifte zettel mit <text>' kannst "
  	+"Du eine kurze Nachricht darauf notieren.";
  }
  else
  {
  	s = "Auf dem Zettel steht: "+zetteltext+"";
  }
  return BS(s);
}

//Ballon verschenken
int schenken(string str)
{
  string wer, was;
  object player;

  notify_fail("Wem moechtest Du den Luftballon schenken?\n");

  if(!str || str == "")
  {
        return (notify_fail ("WEM moechtest Du WAS schenken?\n"),0);
  }

       //Syntaxcheck
       if( sscanf(str, "%s %s", wer, was) == 2 && id(was) )
       {
        player = find_player(wer);

          //Spieler ist nicht eingelogt
          if(!player)
          {
                write(BS("Aber "+CAP(wer)+" ist doch gar nicht anwesend."));
                return -1;
          }

          //Spieler ist nicht im gleichen Raum
          if(ENV(TP) != ENV(player))
          {
                write(BS("Aber "+player->name(WER, 1)+" ist doch gar nicht "
                +"hier!"));
                return -1;
          }

          //Ballon ist zu schwer
          if(ME_TOO_HEAVY == this_object()->move(player,M_GET|M_SILENT))
          {
                write(BS(player->Name(WER, 1)+" kann den Luftballon leider "
                +"nicht mehr tragen, daher behaeltst Du ihn lieber."));
                return -1;
          }
          else
          {
                //Schenken klappt
                write(BS("Du schenkst "+player->Name()+" den Luftballon."));

                tell_object(player,BS(TP->Name(WER)+" schenkt Dir einen "
                +"Luftballon."));

                tell_room(ENV(TP),BS(TP->Name()+" schenkt "+player->Name()
                +" einen Luftballon."), ({ TP, player }));

                name = TP->Name(WER);
                return 1;
          }
       }
       return 0;
}

//Zettel beschriften
int beschriften(string str)
{
  notify_fail("Was moechtest Du womit beschriften?\n");

  if(!str || str == "") return 0;

  if( strstr(str, "zettel mit ", 0) != -1 )
  {
        if(!zetteltext)
        {
                write(BS("In Deiner allerschoensten Sonntagsschrift "
                +"schreibst Du eine Nachricht auf den Zettel."));
                str=this_player()->_unparsed_args();
                zetteltext = str[11..];
                return 1;
        }
        else
        {
                write(BS("Aber auf dem Zettel steht doch schon etwas "
                +"geschrieben!"));
                return -1;
        }
  }
}

//Ballon wegfliegen lassen
int fliegen(string str)
{
       if(ENV(TP)->QueryProp(P_INDOORS) == 0)
       {
           write(BS("Du laesst die Schnur mit dem Ballon los und schaust "
           +"ein wenig wehmuetig zu, wie er langsam in den Himmel aufsteigt "
           +"und schliesslich in den Wolken verschwindet."));

           ENV(TP)->Message(BS(TP->Name(WER, 1)+" laesst einen "+farbe+"en "
  	   +"Luftballon in die Luft steigen."),
  	   MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  	   TO->remove();
  	   return 1;
       }
       else
       {
           write(BS("Willst Du das nicht lieber irgendwo draussen machen?"));
           return -1;
       }
}

//Ballon platzen lassen
int zerplatzen(string str)
{
  	write(BS("Mit einem gemeinen Grinsen ziehst Du eine Stecknadel aus "
  	+"Deiner Hosentasche und piekst in den Ballon hinein... "
  	+"*PEEEEENGGG*"));

  	ENV(TP)->Message(TP->Name(WER, 1)+" laesst direkt neben Dir einen "
  	+"Luftballon zerplatzen. *PEEEEENGGG*\n"
  	+"Du erschrickst fuerchterlich.\n",
  	MSGFLAG_SOUND|MSGFLAG_NO_TP);

  	TO->remove();
  	return 1;
}
