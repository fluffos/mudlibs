#include "../def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Grasbueschel");
  SetProp(P_LONG,
    "Du siehst ein frisches, gruenes Grasbueschel vor Dir. Wozu mag das nur "
    "gut sein?");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Grasbueschel");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"gras", "bueschel", "grasbueschel", "\ngrasbueschel"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_HERBAL);
  SetProp(P_WEIGHT, 2);
  SetProp(P_VALUE, 0);

//--Create Ende------------------------------------------------------------

}
