#include "../def.h"

inherit "std/container";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Obstkorb");
  SetProp(P_LONG,
    "Ein huebscher, geflochtener Obstkorb. In ihm lassen sich allerlei "
    "Fruechte aufbewahren." );

  AddDetail( ({ "fruechte" }),
    "Wie zum Beispiel Aepfel, Bananen oder Kirschen.");

  AddDetail( ({ "aepfel", "bananen", "kirschen" }),
    "Das ist nur ein Beispiel.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Obstkorb");
  SetProp(P_GENDER, MALE);
  AddId( ({"korb", "obstkorb"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_WOOD);
  SetProp(P_WEIGHT, 250);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 200);
  SetProp(P_MAX_WEIGHT, 3000);
  SetProp(P_WEIGHT_PERCENT, 35);
  SetProp(P_TRANSPARENT, 1);

}

//--Funktionen-------------------------------------------------------------

varargs int PreventInsert(object ob)
{
        int i;
        string *myobst;
        myobst = ({ "\nobst" });

        for(i = 0; i <= sizeof(myobst); i++)
        {
          if(ob->id(myobst[i]))
          {
            return ::PreventInsert(ob);
          }
          else
          {
            return 1;
          }
        }
}
