#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

string name;
int bett;
int paralyze (int zeit, object player);

#define GEMACHT 1
#define UNGEMACHT 0

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  name = 0;
  bett = GEMACHT;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleines Holzbett");
//SetProp(P_LONG, --> siehe weiter unten

  AddDetail( ({ "holzgestell", "gestell" }),
    "Das kleine Bett wurde aus hellem Fichtenholz geschnitzt und "
    "sorgfaeltig zusammengeleimt. Es macht einen recht stabilen Eindruck "
    "und scheint genau die richtige Groesse fuer einen Hobbit oder Zwerg "
    "zu haben.");

  AddDetail( ({ "holz", "fichtenholz" }),
    "Das Holzbett besteht - wie sollte es auch anders sein - aus Holz. "
    "Genauer gesagt, aus hellem Fichtenholz.");

  AddDetail( ({ "eindruck" }),
    "Das Bett sieht recht stabil aus. Allerdings ist es wohl nur fuer "
    "kleinere Rassen wie Hobbits, Zwerge oder Feen geeignet.");

  AddDetail( ({ "hobbits", "zwerge", "hobbit", "zwerg", "rasse", "feen",
  "fee", "rassen", "schwierigkeiten" }),
    "Andere Rassen werden Schwierigkeiten damit haben, sich in das "
    "Bett hineinzuzwaengen.");

  AddDetail( ({ "groesse" }),
    "Das Bett hat genau die richtige Groesse fuer einen Hobbit oder "
    "auch einen Zwerg.");

  AddDetail( ({ "laken" }),
    "Die Matratze ist mit einem blauen, sauberen Laken bespannt worden.");

  AddDetail( ({ "matratze" }),
    "Eine mit einem blauen Laken bespannte Matratze liegt in dem Bett. "
    "Sie sieht einladend weich aus.");

  AddDetail( ({ "kissen" }),
    "Das Bett ist mit ein paar dicken, bunten Kissen ausgepolstert.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Holzbett");
  SetProp(P_NAME_ADJ, "klein");
  AddAdjective( ({ "kleines" } ));
  SetProp(P_GENDER, NEUTER);
  AddId( ({"\nmoebel", "bett", "holzbett", "\n_bett"}) );
//SetProp(P_INFO, "");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_FIR);
  SetProp(P_WEIGHT, 7000);
  SetProp(P_VALUE, 1075);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "lieg", "liege", "leg", "lege" }), "legen" );
  AddCmd( ({ "steh", "stehe" }), "aufstehen" );
  AddCmd( ({ "schuettle", "schuettel", "schuettl" }), "aufschuetteln" );
  AddCmd( ({ "stell", "stelle" }), "abstellen" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;
  
  txt = "Das kleine Bett besteht aus einem einfachen, schlichten "
       +"Holzgestell, in dem eine weiche, mit einem blauen Laken bespannte "
       +"Matratze liegt. Sie hat genau die richtige Groesse fuer einen "
       +"Hobbit oder einen Zwerg. Das Bett ist mit zahlreichen bunten "
       +"Kissen ausgepolstert und sieht sehr bequem und einladend aus.";

  //liegt jemand im Bett?
  if(name != 0)
  {
        if(TP->Name() == name)
        {
             txt += " Du hast es Dir darin gemuetlich gemacht.";
        }
        else
        {
             txt +=  " "+name+" hat es sich darin gemuetlich gemacht.";
        }
  }
  
  //ist das Bett nicht gemacht?
  if(bett == UNGEMACHT && name == 0)
  {
        txt += " Allerdings sind die Kissen ein wenig zerwuehlt. "
        +"Du koenntest sie mal wieder aufschuetteln.";
  }

  return BS(txt);
}

//reinlegen:
int legen(string str)
{
  mixed res;
  
  notify_fail("Wo moechtest Du Dich hineinlegen?\n");

  if(!str || str == "") return 0;

  if(!(str == "in bett" ||
       str == "in holzbett")) return 0;

  if(ENV(TO) != ENV(TP))
  {
      write(BS("Stell das Bett doch erstmal irgendwo ab."));
      return -1;
  }
  else
  {
    if(TP->QueryProp(P_RACE) == "Hobbit" ||
       TP->QueryProp(P_RACE) == "Zwerg"||
       TP->QueryProp(P_RACE) == "Fee")
    {
      if(bett == UNGEMACHT)
      {
         write(BS("Nein, in so ein zerwuehltes Bett willst Du Dich nicht "
         +"legen."));
         return -1;
      }
      else
      {
         if(name == 0)
         {
   	    if(res=TP->QueryProp(P_TMP_MOVE_HOOK))
            {
              if ( pointerp(res) && sizeof(res) >= 3
                   && intp(res[0]) && time() < res[0]
                   && objectp(res[1]) && stringp(res[2]) )
              {
                if (res[1] == TO)
                {
                  notify_fail("Das geht jetzt gerade nicht. Du wirst schon "
                +"wissen, warum.\n");
                  return 0;
                }
                else
                {
                  notify_fail("Das geht jetzt gerade nicht. Du wirst schon "
                +"wissen, warum.\n");
                  return 0;
                }
              }
            }
            
            write(break_string("Du machst es Dir in dem kleinen Holzbett "
            +"gemuetlich. Ahh, ist das herrlich!\nDu kuschelst Dich in die "
            +"weichen Kissen hinein und machst die Augen zu.",
            78, 0, BS_LEAVE_MY_LFS));

            ENV(TP)->Message(BS(TP->Name(WER, 1)+" macht es sich in dem "
            +"kleinen Holzbett gemuetlich."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
            name = TP->Name(WER);
            
            paralyze (999, TP);
            call_out("seqbett", 900, TP);
            return 1;
         }
         else
         {
            if(TP->Name() == name)
            {
                write(BS("Aber Du liegst doch bereits in dem Bett."));
            }
            else
            {
                write(BS("Aber "+name+" liegt doch gerade in dem Bett."));
            }
           
            return -1;
         }
      }
    }
    else
    {
        write(BS("Das Bett ist leider viel zu klein fuer Dich."));
        return -1;
    }
  }
}

void seqbett(object player)
{
    mixed res;
    
    if(player)
    {
       tell_object(player, "Es wird Dir allmaehlich zu langweilig im Bett "
       +"und Du stehst wieder auf.\n");

       ENV(TO)->Message(BS(player->Name(WER)+" reibt sich die Augen, gaehnt "
       +"noch einmal ausgiebig und erhebt sich dann aus dem kleinen "
       +"Holzbett.\n"),
       MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

       if(res=player->QueryProp(P_TMP_MOVE_HOOK))
       {
           if ( pointerp(res) && sizeof(res) >= 3
                && intp(res[0]) && time() < res[0]
                && objectp(res[1]) && stringp(res[2]) )
           {
                if (res[1] == TO)
                {
                     player->SetProp(P_TMP_MOVE_HOOK, 0);
                     if(find_call_out("seqbett") != -1)
                     remove_call_out("seqbett");
                }
           }
       }
    }

    name = 0;
    bett = UNGEMACHT;
    return;
}

void BecomesNetDead(object player)
{
  mixed res;

  if(player && player->name() == name)
  {
    ENV(TO)->Message(BS(player->Name(WER)+" purzelt aus dem Bett heraus.\n"),
    MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

    if(res=player->QueryProp(P_TMP_MOVE_HOOK))
    {
        if ( pointerp(res) && sizeof(res) >= 3
             && intp(res[0]) && time() < res[0]
             && objectp(res[1]) && stringp(res[2]) )
        {
             if (res[1] == TO)
             {
                  player->SetProp(P_TMP_MOVE_HOOK, 0);
                  if (find_call_out("seqbett") != -1)
                     remove_call_out("seqbett");
             }
       }
    }
    bett = UNGEMACHT;
    name = 0;
    return;
  }
}

void NotifyPlayerDeath(object player, object killer, int lost_xp)
{
  mixed res;

  if(player && player->name() == name)
  {
    ENV(TO)->Message(BS(player->Name(WER)+" purzelt aus dem Bett heraus.\n"),
    MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

    if(res=player->QueryProp(P_TMP_MOVE_HOOK))
    {
        if ( pointerp(res) && sizeof(res) >= 3
             && intp(res[0]) && time() < res[0]
             && objectp(res[1]) && stringp(res[2]) )
        {
             if (res[1] == TO)
             {
                  player->SetProp(P_TMP_MOVE_HOOK, 0);
                  if (find_call_out("seqbett") != -1)
                     remove_call_out("seqbett");
              }
        }
    }

    bett = UNGEMACHT;
    name = 0;
    return;
  }
}

int aufstehen(string str)
{
  mixed res;
  
  notify_fail("Was willst Du tun?\n");

  if(!str || str == "") return 0;

  if(!(str == "aus bett auf" ||
       str == "aus holzbett auf" ||
       str == "auf")) return 0;

  if(TP->Name() == name)
  {
     write(BS("Seufzend reibst Du Dir die Augen, gaehnst noch einmal "
     +"ausgiebig und stehst dann wieder auf. Dabei war es doch gerade so "
     +"gemuetlich."));

     ENV(TP)->Message(BS(TP->Name(WER, 1)+" reibt sich die Augen, gaehnt "
     +"noch einmal ausgiebig und erhebt sich dann aus dem kleinen "
     +"Holzbett."),
     MSGFLAG_VISUAL|MSGFLAG_NO_TP);
     name = 0;
     bett = UNGEMACHT;

     if(res=TP->QueryProp(P_TMP_MOVE_HOOK))
     {
         if ( pointerp(res) && sizeof(res) >= 3
              && intp(res[0]) && time() < res[0]
              && objectp(res[1]) && stringp(res[2]) )
         {
              if (res[1] == TO)
              {
                   TP->SetProp(P_TMP_MOVE_HOOK, 0);
                   if(find_call_out("seqbett") != -1)
                   remove_call_out("seqbett");
              }
         }
     }

     return 1;
  }
  else
  {
     write(BS("Aber Du liegst doch gar nicht in dem Bett."));
     return -1;
  }
}

int aufschuetteln(string str)
{
  notify_fail("Was willst Du aufschuetteln?\n");

  if(!str || str == "") return 0;

  if(!(str == "kissen" ||
       str == "kissen auf" ||
       str == "kissen aus")) return 0;

  if(name != 0)
  {
      if(TP->Name() == name)
      {
          write(BS("Aber Du liegst doch gerade so gemuetlich im Bett. "
          +"Wenn Du die Kissen aufschuetteln willst, solltest Du erstmal "
          +"wieder aufstehen."));
      }
      else
      {
          write(BS("Das geht jetzt nicht, "+name+" liegt doch noch im "
          +"Bett!"));
      }
      return -1;
  }
  else
  {
       if(bett == UNGEMACHT)
       {
            write(BS("Du schuettelst die Kissen kraeftig aus und glaettest "
            +"auch das Laken ein wenig. So, jetzt ist alles wieder schoen "
            +"ordentlich, wie es sich gehoert."));

            ENV(TP)->Message(BS(TP->Name(WER, 1)+" richtet das Bett wieder "
            +"ordentlich her."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
            bett = GEMACHT;
            return 1;
       }
       else
       {
            write(break_string("Die Kissen sind bereits ordentlich "
            +"aufgeschuettelt worden.\nDu scheinst eine gute Hausfee zu "
            +"haben. :)\n", 78, 0, BS_LEAVE_MY_LFS));
            return -1;
       }
   }
}

//Funktion zum Festhalten beim Liegen
int paralyze (int zeit, object player)
{
  if (objectp(player))
     player->SetProp(P_TMP_MOVE_HOOK, ({time()+zeit, TO, 
     "freeze_in_place"}) );
}

//Hilfsfunktion fuer Move_Hook
string freeze_in_place()
{
  return "Das geht jetzt gerade nicht. Du wirst schon wissen, warum.\n";
}

//Bett abstellen:
int abstellen(string str)
{
  notify_fail("Was willst Du abstellen?\n");

  if(!str || str == "") return 0;

  if(!(str == "bett ab" ||
       str == "holzbett ab")) return 0;

  if(ENV(TO) != TP)
  {
        write(BS("Aber Du traegst das kleine Holzbett doch gar nicht mehr "
        +"bei Dir!"));
        return -1;
  }
  else
  {
        write(BS("Du stellst das kleine Holzbett ab."));

        ENV(TP)->Message(BS(TP->Name(WER, 1)+" stellt ein kleines Holzbett "
        +"ab."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        
        move(ENV(TP), M_SILENT); 
        return 1;
  }
}

//wenn jemand versucht, das Bett zu nehmen, und es liegt wer drin
varargs int move(mixed dest,int method)
{
  if(objectp(dest))
  {
    if(name != 0)
    {
       write(BS("Aber es liegt doch noch jemand im Bett!\n"));
       return ME_CANT_LEAVE_ENV;
    }
  }
  return ::move(dest, method);
}
