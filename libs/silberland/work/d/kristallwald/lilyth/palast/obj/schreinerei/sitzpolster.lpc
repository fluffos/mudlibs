#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

string farbe;
string name;
string sitzer;
int paralyze (int zeit, object player);

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  farbe = "";
  name = "";
  sitzer = 0;

  switch(random(5))
  {
    case 1:
      farbe = "rot";
      AddAdjective( ({ "rotes", "roter", "roten" }) );
      break;
    case 2:
      farbe = "blau";
      AddAdjective( ({ "blaues", "blauer", "blauen" }) );
      break;
    case 3:
      farbe = "gelb";
      AddAdjective( ({ "gelbes", "gelber", "gelben" }) );
      break;
    case 4:
      farbe = "gruen";
      AddAdjective( ({ "gruenes", "gruener", "gruenen" }) );
      break;
    default:
      farbe = "bunt";
      AddAdjective( ({ "buntes", "bunter", "bunten" }) );
      break;
  }

  switch(random(2))
  {
    case 1:
      name = "Sitzpolster";
      AddId( ({ "\nmoebel", "\n_stuhl", "sitzpolster", "polster" }) );
      break;
    default:
      name = "Sitzkissen";
      AddId( ({ "\nmoebel", "\n_stuhl", "sitzkissen", "kissen" }) );
      break;
  }

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein "+farbe+"es "+name);
//SetProp(P_LONG, --> siehe unten

  AddSpecialDetail( ({ "baumwolle" }),
    "strbaumwolle");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, name);
  SetProp(P_NAME_ADJ, ({ farbe }));
  SetProp(P_GENDER, NEUTER);

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_COTTON);
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 230);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "sitz", "sitze" }), "sitzen" );
  AddCmd( ({ "steh", "stehe" }), "stehen" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;

  txt = "Ein "+farbe+"es "+name+", auf dem Du es Dir gemuetlich machen "
  +"kannst. Es besteht aus weicher Baumwolle und sieht sehr bequem aus. ";

  if(sitzer != 0)
  {
        if(TP->Name() == sitzer)
        {
             txt += "Du sitzt gerade darauf.";
        }
        else
        {
             txt +=  sitzer+" sitzt gerade darauf.";
        }
  }
  return BS(txt);
}

string strbaumwolle(string str)
{
  string s;

  s = "Das "+name+" besteht aus kuscheliger, "+farbe+"er Baumwolle.";

  return BS(s);
}

//Hinsetzen:
int sitzen(string str)
{
  mixed res;
  string was;
  
  notify_fail("Worauf moechtest Du sitzen?\n");

  if(!str || str == "") return 0;

  if( sscanf(str, "auf %s", was) == 1 && id(was) )
  {
    if(ENV(TO) != ENV(TP))
    {
       write(BS("Du solltest das "+name+" zuerst irgendwo ablegen."));
       return -1;
    }

    if(sitzer == 0)
    {
      if(res=TP->QueryProp(P_TMP_MOVE_HOOK))
      {
        if ( pointerp(res) && sizeof(res) >= 3
             && intp(res[0]) && time() < res[0]
             && objectp(res[1]) && stringp(res[2]) )
        {
             if (res[1] == TO)
             {
                notify_fail("Das geht jetzt gerade nicht.\n");
                return 0;
             }
             else
             {
                notify_fail("Das geht jetzt gerade nicht.\n");
                return 0;
             }
        }
      }                
                
     write(BS("Du machst es Dir auf dem "+name+" gemuetlich."));

     ENV(TP)->Message(BS(TP->Name(WER, 1)+" macht es sich auf dem "+name+" "
     +"gemuetlich."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
     
     sitzer = TP->Name(WER);
            
     paralyze (999, TP);
     call_out("seqsitzen", 900, TP);
     return 1;
    }
    else
    {
      if(TP->Name() == sitzer)
      {
         write(BS("Du sitzt bereits auf dem "+name+"."));
      }
      else
      {
         write(BS("Aber "+sitzer+" sitzt doch gerade darauf."));
      }
           
      return -1;
    }
  }
}

void seqsitzen(object player)
{
    mixed res;
    
    if(player)
    {
       tell_object(player, BS("Als Dein Ruecken zu schmerzen anfaengt, "
       +"erhebst Du Dich muehsam von dem "+name+" und streckst Dich ein "
       +"wenig. Ahh, das tut gut!"));

       ENV(TO)->Message(BS(player->Name(WER)+" erhebt sich von dem "
       +name+" und streckt sich ein wenig."),
       MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

       if(res=player->QueryProp(P_TMP_MOVE_HOOK))
       {
           if ( pointerp(res) && sizeof(res) >= 3
                && intp(res[0]) && time() < res[0]
                && objectp(res[1]) && stringp(res[2]) )
           {
                if (res[1] == TO)
                {
                     player->SetProp(P_TMP_MOVE_HOOK, 0);
                     if(find_call_out("seqsitzen") != -1)
                     remove_call_out("seqsitzen");
                }
           }
       }
    }

    sitzer = 0;
    return;
}

void BecomesNetDead(object player)
{
  mixed res;

  if(player && player->name() == sitzer)
  {
    ENV(TO)->Message(BS(player->Name(WER)+" rutscht langsam von dem "+name+" "
    +"herunter."), MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

    if(res=player->QueryProp(P_TMP_MOVE_HOOK))
    {
        if ( pointerp(res) && sizeof(res) >= 3
             && intp(res[0]) && time() < res[0]
             && objectp(res[1]) && stringp(res[2]) )
        {
             if (res[1] == TO)
             {
                  player->SetProp(P_TMP_MOVE_HOOK, 0);
                  if (find_call_out("seqsitzen") != -1)
                  remove_call_out("seqsitzen");
             }
       }
    }
    sitzer = 0;
    return;
  }
}

void NotifyPlayerDeath(object player, object killer, int lost_xp)
{
  mixed res;

  if(player && player->name() == sitzer)
  {
    ENV(TO)->Message(BS(player->Name(WER)+" rutscht langsam von dem "+name+" "
    +"herunter."), MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

    if(res=player->QueryProp(P_TMP_MOVE_HOOK))
    {
        if ( pointerp(res) && sizeof(res) >= 3
             && intp(res[0]) && time() < res[0]
             && objectp(res[1]) && stringp(res[2]) )
        {
             if (res[1] == TO)
             {
                  player->SetProp(P_TMP_MOVE_HOOK, 0);
                  if (find_call_out("seqsitzen") != -1)
                  remove_call_out("seqsitzen");
             }
        }
    }

    sitzer = 0;
    return;
  }
}

int stehen(string str)
{
  mixed res;
  string was;
  
  notify_fail("Was willst Du tun?\n");

  if(!str || str == "") return 0;

  if( (sscanf(str, "von %s auf", was) == 1 && id(was)) ||
       str == "auf" )
  {

    if(TP->Name() == sitzer)
    {
      write(BS("Obwohl es gerade so gemuetlich war, erhebst Du Dich wieder "
      +"von dem "+name+" und streckst Dich ein wenig. Ahh, das hat gutgetan!"));

      ENV(TP)->Message(BS(TP->Name(WER, 1)+" erhebt sich von dem "+name+" "
      +"und streckt sich ein wenig."),
      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      sitzer = 0;

      if(res=TP->QueryProp(P_TMP_MOVE_HOOK))
      {
         if ( pointerp(res) && sizeof(res) >= 3
              && intp(res[0]) && time() < res[0]
              && objectp(res[1]) && stringp(res[2]) )
         {
              if (res[1] == TO)
              {
                   TP->SetProp(P_TMP_MOVE_HOOK, 0);
                   if (find_call_out("seqsitzen") != -1)
                   remove_call_out("seqsitzen");
              }
         }
      }

      return 1;
    }
    else
    {
      write(BS("Aber Du sitzt doch gar nicht auf dem "+name+"."));
      return -1;
    }
  }
}

//Funktion zum Festhalten beim Sitzen
int paralyze (int zeit, object player)
{
  if (objectp(player))
     player->SetProp(P_TMP_MOVE_HOOK, ({time()+zeit, TO, 
     "freeze_in_place"}) );
}

//Hilfsfunktion fuer Move_Hook
string freeze_in_place()
{
  return "Das geht jetzt gerade nicht.\n";
}

//nicht aufheben, wenn jemand drauf sitzt
varargs int move(mixed dest,int method)
{
  if(objectp(dest))
  {
    if(sitzer != 0)
    {
       write(BS("Aber es sitzt doch gerade jemand auf dem "+name+"!\n"));
       return ME_CANT_LEAVE_ENV;
    }
  }
  return ::move(dest, method);
}
