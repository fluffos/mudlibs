#include "../def.h"
#include <food.h>
#include <properties.h>

inherit "/std/food";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Birne");
  SetProp(P_LONG,
   "Die Birne hat eine schoene, gleichmaessig gelbe Farbe und sieht sehr "
   "saftig aus. Am liebsten wuerdest Du gleich hineinbeissen.");

  AddDetail( ({ "farbe" }),
    "Die Birne ist gleichmaessig gelb gefaerbt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Birne");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"\nobst", "obst", "birne"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 75);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

  SetProp (P_FOOD_INFO, ([
    F_HEAL     : ({3,3}),
    F_SOAK: 2,
    F_MSG      : "Du beisst mit Hochgenuss in die saftige Birne hinein. "
                 "Hmm, das ist lecker!",
    F_MSG_ROOM : "isst eine saftige Birne.",
    F_MSG_DECAY: "Eine Birne beginnt langsam zu verfaulen.\n",
    F_MSG_REMOVE: "Die Birne ist voellig verfault und Du wirfst sie weg.\n",
    F_VERB     : "essen" ]) );

  start_decay(1800, 900);

//--Create Ende------------------------------------------------------------

}
