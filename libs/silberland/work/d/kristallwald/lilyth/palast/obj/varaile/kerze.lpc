#include "/d/kristallwald/lilyth/palast/def.h"
#include "lightsource.h"

inherit "std/lightsource";

//--Variablen&Defines------------------------------------------------------

int kerze;
string farbe;

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  kerze = AUS;

  switch(random(3))
  {
    case 1:
      farbe = "schneeweiss";
      AddAdjective( ({ "schneeweisse" }) );
      break;
    case 2:
      farbe = "nachtschwarz";
      AddAdjective( ({ "nachtschwarze" }) );
      break;
    default:
      farbe = "weinrot";
      AddAdjective( ({ "weinrote" }) );
      break;
  }

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine "+farbe+"e Kerze");
  //Long siehe weiter unten

  AddDetail( ({ "wachs", "kerzenwachs" }),
    "Die Kerze besteht aus "+farbe+"em Kerzenwachs.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Kerze");
  SetProp(P_NAME_ADJ, ({ farbe }));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE,1);
  AddId("kerze");
  SetProp(P_INFO, "Sie kann Dir an dunklen Orten Licht spenden.");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_WAX);
  SetProp(P_WEIGHT, 15);
  SetProp(P_SIZE, 17);
  SetProp(P_VALUE, 100);
  SetProp(P_FUEL, 1500);

  SetProp(P_LIGHTDESC,
  ({ "glimmend","flackernd","leicht flackernd","brennend","hell leuchtend",
     "frisch angezuendet" }) );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;

  txt = "Eine Kerze aus "+farbe+"em Kerzenwachs. ";

  //Kerze an oder aus?
  if (_query_lighted())
  {
        txt +=  "Sie brennt lustig vor sich hin und spendet Dir Licht.";
  }
  else
  {
        txt +=  "Sie hat einen langen, schwarzen Docht, an dem Du sie "
        +"anzuenden kannst, wenn Du willst.";
  }
  return BS(txt);
}
