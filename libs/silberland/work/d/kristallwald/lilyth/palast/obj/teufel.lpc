#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

string freund;

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  freund = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleiner Teufel");
//SetProp(P_LONG, -> siehe unten

  AddDetail( ({ "hoerner", "horn", "kopf" }),
    "Kurze, rote Hoerner wachsen ihm aus dem Kopf heraus.");

  AddDetail( ({ "freunde", "freund" }),
    "Der kleine Teufel scheint nur schwer neue Freunde zu finden. Das "
    "liegt sicher nur daran, dass er nicht so suess und "
    "niedlich ist wie all die anderen Stofftiere. Dabei ist er so "
    "ein lieber, netter Kerl.");

  AddDetail( ({ "stofftiere" }),
    "Die meisten Stofftiere sehen niedlich aus und werden von allen "
    "liebgehabt.");

  AddDetail( ({ "kerl" }),
    "Der kleine Teufel ist wirklich sehr lieb, er ist nur ein wenig "
    "schuechtern.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Teufel");
  SetProp(P_NAME_ADJ, "klein");
  AddAdjective( ({ "kleiner", "kleinen" } ));
  SetProp(P_GENDER, MALE);
  AddId( ({ "teufel" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "Du kannst mit dem kleinen Teufel spielen, ihn knuddeln "
  "und an Dich druecken oder ihn auch mal troesten, wenn er traurig ist.\n");
  SetProp(P_MATERIAL, MAT_COTTON);
  SetProp(P_WEIGHT, 100);
  SetProp(P_SIZE, 25);
  SetProp(P_VALUE, 110);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "knuddel", "knuddl", "knuddle", "knuddele" }), "knuddeln" );
  AddCmd( ({ "drueck", "druecke" }), "druecken" );
  AddCmd( ({ "troest", "troeste" }), "troesten" );
  AddCmd( ({ "spiel", "spiele" }), "spielen" );
  AddCmd("biet|biete&teufel&freundschaft&an", "bieten",
         "Wem moechtest Du die Freundschaft anbieten?\n");

//--Create Ende------------------------------------------------------------

}

//--Funktionen----------------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;

  txt = "Der kleine Teufel ist komplett schwarz, bis auf seine "
  "kurzen, roten Hoerner, die aus seinem Kopf wachsen. ";

  //hat ihm jmd. Freundschaft angeboten?
  if(freund == 0)
  {
        txt +=  "Er sieht ein wenig einsam und liebebeduerftig aus. "
        +"Anscheinend hat er bislang nicht sehr viele Freunde "
        +"gehabt. Aber vielleicht kannst Du das ja aendern.\n";
  }

  if(freund != 0)
  {
        txt +=  "Er sieht sehr gluecklich und zufrieden aus. Er ist "
        +"mit "+freund+" befreundet.\n";
  }
  return BS(txt);
}

//knuddeln:
int knuddeln(string str)
{
  notify_fail("Wen moechtest Du knuddeln?\n");

  if(!str || str == "") return 0;

  if(!(str == "teufel"))  return 0;

  write(break_string("Du knuddelst den kleinen Teufel ganz lieb.\n"
  +"Dankbar knuddelt er Dich und blickt dann vertrauensvoll zu Dir auf.\n",
  78, 0, BS_LEAVE_MY_LFS));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" knuddelt "
  +(TP->QueryProp(P_GENDER) == MALE ? "seinen": "ihren")+" kleinen Teufel."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

//druecken:
int druecken(string str)
{
  notify_fail("Wen willst Du an Dich druecken?\n");

  if(!str || str == "") return 0;

  if(!(str == "teufel")) return 0;

  write(break_string("Du drueckst den kleinen Teufel fest an Dich. "
  +"Gluecklich kuschelt er sich an Dich an.",
  78, 0, BS_LEAVE_MY_LFS));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" drueckt "
  +(TP->QueryProp(P_GENDER) == MALE ? "seinen": "ihren")+" kleinen Teufel "
  +"fest an sich."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

//troesten:
int troesten(string str)
{
  notify_fail("Wen willst Du troesten?\n");

  if(!str || str == "") return 0;

  if(!(str == "teufel"))  return 0;

  write(break_string("Du troestest den kleinen Teufel liebevoll.\n"
  +"Leise schnieft er noch ein wenig vor sich hin und beruhigt sich dann "
  +"wieder.",
  78, 0, BS_LEAVE_MY_LFS));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" troestet "
  +(TP->QueryProp(P_GENDER) == MALE ? "seinen": "ihren")+" kleinen Teufel "
  +"liebevoll."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

//troesten:
int spielen(string str)
{
  string spiel;

  switch(random(8))
  {
    case 1:
      spiel = "'Schnick-Schnack-Schnuck'";
      break;
    case 2:
      spiel = "'Mau-Mau'";
      break;
    case 3:
      spiel = "'Poker'";
      break;
    case 4:
      spiel = "'Schach'";
      break;
    case 5:
      spiel = "'Backgammon'";
      break;
    case 6:
      spiel = "'Maexchen'";
      break;
    case 7:
      spiel = "'Teufel aerger Dich nicht'";
      break;
    default:
      spiel = "'Fang den Fraggle'";
      break;
  }
   
  notify_fail("Mit wem willst Du spielen?\n");

  if(!str || str == "") return 0;

  if(!(str == "mit teufel")) return 0;

  write(break_string("Du spielst mit dem kleinen Teufel eine Runde "
  +spiel+".",
  78, 0, BS_LEAVE_MY_LFS));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" spielt mit "
  +(TP->QueryProp(P_GENDER) == MALE ? "seinem": "ihrem")+" kleinen Teufel "
  +"eine Runde "+spiel+"."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

int bieten(string str)
{
     tell_object(TP, "Du bietest dem kleinen Teufel die Freundschaft an.\n"
     "Jubelnd huepft er um Dich herum und strahlt Dich freudig an.\n"
     "Der kleine Teufel freut sich: Nun sind wir Freunde fuers Leben!\n");
     freund = TP->Name(WER);
     return 1;
}

varargs int move(mixed dest,int method)
{
    if(objectp(dest))
    {
        if(dest->id("Raum"))
        {
            write(BS("Der kleine Teufel faengt bitterlich an zu "
            +"weinen.\n"));
        }
    }
    return ::move(dest, method);
}
