#include "../def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein grosser Knochen");
  SetProp(P_LONG,
    "An dem grossen, laenglichen Knochen haengen noch ein paar kleinere "
    "Fleischreste dran. Hmm, es gibt bestimmt irgendjemanden, der sich "
    "ueber einen solch leckeren Knochen freuen wuerde.");

  AddDetail( ({ "fleischreste", "reste", "fleisch" }),
    "Es sieht nicht sehr appetitlich aus.");

  AddDetail( ({ "irgendjemand", "irgendjemanden", "hund" }),
    "Vielleicht ein Hund?");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Knochen");
  SetProp(P_NAME_ADJ, "gross");
  AddAdjective( ({ "grosser", "grossen" } ));
  SetProp(P_GENDER, MALE);
  AddId( ({"knochen", "\nknochen"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "Linah hat Dir diesen Knochen fuer Yoshy mitgegeben.");
  SetProp(P_MATERIAL, MAT_BONE);
  SetProp(P_WEIGHT, 120);
  SetProp(P_SIZE, 32);
  SetProp(P_VALUE, 5);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------
