#include "../def.h"
#include <food.h>
#include <properties.h>

inherit "/std/food";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Makrele");
  SetProp(P_LONG,
    "Diese kleine Makrele hat eine schoene tiefblaue Grundfarbe und eine "
    "dunkle Rueckenzeichnung.");

  AddDetail( ({ "grundfarbe", "farbe", "blau" }),
    "Die Makrele schimmert in einem tiefen Blau.");

  AddDetail( ({"rueckenzeichnung", "ruecken", "zeichnung"}),
  "Der laengliche Ruecken der Makrele ist mit einer dunklen Zeichnung "
  "versehen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Makrele");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"\nfisch", "fisch", "makrele"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 45);
  SetProp(P_VALUE, 25);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

  SetProp (P_FOOD_INFO, ([
    F_HEAL     : ({2,2}),
    F_SOAK: 1,
    F_MSG      : "Du knabberst gelangweilt an der kleinen Makrele herum.",
    F_MSG_ROOM : "knabbert gelangweilt an einer Makrele herum.",
    F_MSG_DECAY: "Eine Makrele beginnt langsam zu verschimmeln.\n",
    F_MSG_REMOVE: "Die Makrele ist voellig verschimmelt und Du entsorgst "
                  "sie ordentlich.\n",
    F_VERB     : "essen" ]) );

  start_decay(1800, 900);

//--Kommandos--------------------------------------------------------------

//AddCmd( ({ "", "" }), "" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------
