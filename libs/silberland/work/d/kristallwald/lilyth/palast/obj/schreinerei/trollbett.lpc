#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

string name;
int bett;
int paralyze (int zeit, object player);

#define GEMACHT 1
#define UNGEMACHT 0

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  name = 0;
  bett = GEMACHT;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein riesiges Bett");
//SetProp(P_LONG, --> siehe weiter unten

  AddDetail( ({ "holz", "eichenholz" }),
    "Das Bett wurde aus dunklem Eichenholz gezimmert und sieht sehr "
    "stabil aus.");

  AddDetail( ({ "oger" }),
    "Ein Oger kann sich voellig bedenkenlos in dieses Bett legen.");

  AddDetail( ({ "troll" }),
    "Ein Troll kann sich voellig bedenkenlos in dieses Bett legen.");

  AddDetail( ({ "matratze" }),
    "Die Matratze ist ungewoehnlich gross und mit einem dicken "
    "Laken bespannt.");

  AddDetail( ({ "laken" }),
    "Es ist recht dick und hat eine ziemlich dunkle Farbe.");

  AddDetail( ({ "farbe" }),
    "Du bist Dir nicht ganz sicher, ob es schwarz, dunkelblau oder "
    "eher graubraun sein soll.");

  AddDetail( ({ "kopfkissen", "kissen" }),
    "Ein grosses, dick gepolstertes Kopfkissen liegt auf der Matratze.");

  AddDetail( ({ "bettdecke", "decke", "fuss", "fuesse" }),
    "Die Bettdecke ist riesengross und waermt auch dem laengsten "
    "Troll oder Oger die Fuesse.");
    
//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Bett");
  SetProp(P_NAME_ADJ, "riesig");
  AddAdjective( ({ "riesiges" } ));
  SetProp(P_GENDER, NEUTER);
  AddId( ({"\nmoebel", "bett", "\n_bett"}) );
//SetProp(P_INFO, "");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_OAK);
  SetProp(P_WEIGHT, 10000);
  SetProp(P_VALUE, 1400);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "lieg", "liege", "leg", "lege" }), "legen" );
  AddCmd( ({ "steh", "stehe" }), "aufstehen" );
  AddCmd( ({ "schuettle", "schuettel", "schuettl" }), "aufschuetteln" );
  AddCmd( ({ "stell", "stelle" }), "abstellen" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;
  
  txt = "Ein so grosses Bett hast Du noch nie zuvor gesehen. Es besteht "
        "aus dunklem Holz und sieht besonders stabil aus. Da koennte sich "
        "sicherlich sogar ein Oger oder ein Troll bedenkenlos hineinlegen. "
        "Die Matratze ist mit einem dicken Laken bespannt, auf der ein "
        "grosses Kopfkissen und eine riesige Bettdecke liegen.";

  //liegt jemand im Bett?
  if(name != 0)
  {
        if(TP->Name() == name)
        {
             txt += " Du hast es Dir darin gemuetlich gemacht.";
        }
        else
        {
             txt +=  " "+name+" hat es sich darin gemuetlich gemacht.";
        }
  }
  
  //ist das Bett nicht gemacht?
  if(bett == UNGEMACHT && name == 0)
  {
        txt += " Das Bettzeug sieht ein wenig zerknautscht aus. "
        +"Du solltest es mal wieder aufschuetteln.";
  }

  return BS(txt);
}

//reinlegen:
int legen(string str)
{
  mixed res;
  
  notify_fail("Wo moechtest Du Dich hineinlegen?\n");

  if(!str || str == "") return 0;

  if(!(str == "in bett" ||
       str == "in riesiges bett")) return 0;

  if(ENV(TO) != ENV(TP))
  {
      write(BS("Stell das Bett doch erstmal irgendwo ab."));
      return -1;
  }
  else
  {
    if(TP->QueryProp(P_RACE) == "Troll" ||
       TP->QueryProp(P_RACE) == "Oger")
    {
      if(bett == UNGEMACHT)
      {
         write(BS("Nein, in so ein zerwuehltes Bett willst Du Dich nicht "
         +"legen."));
         return -1;
      }
      else
      {
         if(name == 0)
         {
   	    if(res=TP->QueryProp(P_TMP_MOVE_HOOK))
            {
              if ( pointerp(res) && sizeof(res) >= 3
                   && intp(res[0]) && time() < res[0]
                   && objectp(res[1]) && stringp(res[2]) )
              {
                if (res[1] == TO)
                {
                  notify_fail("Das geht jetzt gerade nicht. Du wirst schon "
                +"wissen, warum.\n");
                  return 0;
                }
                else
                {
                  notify_fail("Das geht jetzt gerade nicht. Du wirst schon "
                +"wissen, warum.\n");
                  return 0;
                }
              }
            }
            
            write(break_string("Du laesst Dich schwerfaellig auf das "
            +"Bett sinken, boxt das dicke Kopfkissen noch ein wenig "
            +"zurecht, ziehst Dir die Bettdecke bis an die Nasenspitze "
            +"und schliesst dann voellig entspannt die Augen.",
            78, 0, BS_LEAVE_MY_LFS));

            ENV(TP)->Message(BS(TP->Name(WER, 1)+" legt sich in das "
            +"riesige Bett."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
            name = TP->Name(WER);
            
            paralyze (999, TP);
            call_out("seqbett", 900, TP);
            return 1;
         }
         else
         {
            if(TP->Name() == name)
            {
                write(BS("Aber Du liegst doch bereits in dem Bett."));
            }
            else
            {
                write(BS("Aber "+name+" liegt doch gerade in dem Bett."));
            }
           
            return -1;
         }
      }
    }

    if(TP->QueryProp(P_RACE) == "Dunkelelf" ||
       TP->QueryProp(P_RACE) == "Elf" ||
       TP->QueryProp(P_RACE) == "Mensch")
    {
        write(BS("Dieses Bett ist Dir doch viel zu gross und gefallen tut "
        +"es Dir auch nicht wirklich. Da willst Du Dich nicht reinlegen."));
        return -1;
    }
    
    if(TP->QueryProp(P_RACE) == "Hobbit" ||
       TP->QueryProp(P_RACE) == "Zwerg" ||
       TP->QueryProp(P_RACE) == "Fee")
    {
        write(BS("In dem riesigen Bett wuerdest Du Dich doch voellig "
        +"verloren fuehlen. Such Dir lieber ein anderes."));
        return -1;
    }
  }
}

void seqbett(object player)
{
    mixed res;
    
    if(player)
    {
       tell_object(player, "Es wird Dir allmaehlich zu langweilig im Bett "
       +"und Du stehst wieder auf.\n");

       ENV(TO)->Message(BS(player->Name(WER)+" steigt gaehnend aus dem "
       +"riesigen Bett heraus.\n"),
       MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

       if(res=player->QueryProp(P_TMP_MOVE_HOOK))
       {
           if ( pointerp(res) && sizeof(res) >= 3
                && intp(res[0]) && time() < res[0]
                && objectp(res[1]) && stringp(res[2]) )
           {
                if (res[1] == TO)
                {
                     player->SetProp(P_TMP_MOVE_HOOK, 0);
                     if(find_call_out("seqbett") != -1)
                     remove_call_out("seqbett");
                }
           }
       }
    }

    name = 0;
    bett = UNGEMACHT;
    return;
}

void BecomesNetDead(object player)
{
  mixed res;

  if(player && player->name() == name)
  {
    ENV(TO)->Message(BS(player->Name(WER)+" purzelt aus dem Bett heraus.\n"),
    MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

    if(res=player->QueryProp(P_TMP_MOVE_HOOK))
    {
        if ( pointerp(res) && sizeof(res) >= 3
             && intp(res[0]) && time() < res[0]
             && objectp(res[1]) && stringp(res[2]) )
        {
             if (res[1] == TO)
             {
                  player->SetProp(P_TMP_MOVE_HOOK, 0);
                  if (find_call_out("seqbett") != -1)
                     remove_call_out("seqbett");
             }
       }
    }
    bett = UNGEMACHT;
    name = 0;
    return;
  }
}

void NotifyPlayerDeath(object player, object killer, int lost_xp)
{
  mixed res;

  if(player && player->name() == name)
  {
    ENV(TO)->Message(BS(player->Name(WER)+" purzelt aus dem Bett heraus.\n"),
    MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

    if(res=player->QueryProp(P_TMP_MOVE_HOOK))
    {
        if ( pointerp(res) && sizeof(res) >= 3
             && intp(res[0]) && time() < res[0]
             && objectp(res[1]) && stringp(res[2]) )
        {
             if (res[1] == TO)
             {
                  player->SetProp(P_TMP_MOVE_HOOK, 0);
                  if (find_call_out("seqbett") != -1)
                     remove_call_out("seqbett");
              }
        }
    }

    bett = UNGEMACHT;
    name = 0;
    return;
  }
}

int aufstehen(string str)
{
  mixed res;
  
  notify_fail("Was willst Du tun?\n");

  if(!str || str == "") return 0;

  if(!(str == "aus bett auf" ||
       str == "aus riesigem bett auf" ||
       str == "auf")) return 0;

  if(TP->Name() == name)
  {
     write(BS("Du gaehnst noch einmal ausgiebig und wuehlst Dich dann aus "
     +"dem riesigen Bett heraus."));

     ENV(TP)->Message(BS(TP->Name(WER, 1)+" gaehnt noch einmal ausgiebig "
     +"und wuehlt sich dann aus dem riesigen Bett heraus."),
     MSGFLAG_VISUAL|MSGFLAG_NO_TP);
     name = 0;
     bett = UNGEMACHT;

     if(res=TP->QueryProp(P_TMP_MOVE_HOOK))
     {
         if ( pointerp(res) && sizeof(res) >= 3
              && intp(res[0]) && time() < res[0]
              && objectp(res[1]) && stringp(res[2]) )
         {
              if (res[1] == TO)
              {
                   TP->SetProp(P_TMP_MOVE_HOOK, 0);
                   if(find_call_out("seqbett") != -1)
                   remove_call_out("seqbett");
              }
         }
     }

     return 1;
  }
  else
  {
     write(BS("Aber Du liegst doch gar nicht in dem riesigen Bett."));
     return -1;
  }
}

int aufschuetteln(string str)
{
  notify_fail("Was willst Du aufschuetteln?\n");

  if(!str || str == "") return 0;

  if(!(str == "bettzeug" ||
       str == "bettzeug auf")) return 0;

  if(name != 0)
  {
      if(TP->Name() == name)
      {
          write(BS("Aber Du liegst doch gerade so gemuetlich im Bett. "
          +"Wenn Du das Bettzeug aufschuetteln willst, solltest Du erstmal "
          +"wieder aufstehen."));
      }
      else
      {
          write(BS("Das geht jetzt nicht, "+name+" liegt doch noch im "
          +"Bett!"));
      }
      return -1;
  }
  else
  {
       if(bett == UNGEMACHT)
       {
            write(BS("Du schuettelst die Kissen kraeftig aus und glaettest "
            +"auch das Laken ein wenig. So, jetzt ist alles wieder schoen "
            +"ordentlich, wie es sich gehoert."));

            ENV(TP)->Message(BS(TP->Name(WER, 1)+" richtet das Bett wieder "
            +"ordentlich her."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
            bett = GEMACHT;
            return 1;
       }
       else
       {
            write(break_string("Das Bett sieht doch voellig ordentlich "
            +"aus.\nDu scheinst einen guten Hauszwerg zu haben. :)\n", 
            78, 0, BS_LEAVE_MY_LFS));
            return -1;
       }
   }
}

//Funktion zum Festhalten beim Liegen
int paralyze (int zeit, object player)
{
  if (objectp(player))
     player->SetProp(P_TMP_MOVE_HOOK, ({time()+zeit, TO, 
     "freeze_in_place"}) );
}

//Hilfsfunktion fuer Move_Hook
string freeze_in_place()
{
  return "Das geht jetzt gerade nicht. Du wirst schon wissen, warum.\n";
}

//Bett abstellen:
int abstellen(string str)
{
  notify_fail("Was willst Du abstellen?\n");

  if(!str || str == "") return 0;

  if(!(str == "bett ab" ||
       str == "riesiges bett ab")) return 0;

  if(ENV(TO) != TP)
  {
        write(BS("Aber Du traegst das Bett doch gar nicht mehr bei Dir!"));
        return -1;
  }
  else
  {
        write(BS("Du stellst das riesige Bett ab."));

        ENV(TP)->Message(BS(TP->Name(WER, 1)+" stellt ein riesiges Bett ab."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        
        move(ENV(TP), M_SILENT); 
        return 1;
  }
}

//wenn jemand versucht, das Bett zu nehmen, und es liegt wer drin
varargs int move(mixed dest,int method)
{
  if(objectp(dest))
  {
    if(name != 0)
    {
       write(BS("Aber es liegt doch noch jemand im Bett!\n"));
       return ME_CANT_LEAVE_ENV;
    }
  }
  return ::move(dest, method);
}
