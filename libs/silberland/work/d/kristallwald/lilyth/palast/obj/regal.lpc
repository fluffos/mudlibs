#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/container";
inherit "std/room/items";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  items::create();
  container::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Buecherregal");
//SetProp(P_LONG, --> siehe unten

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Buecherregal");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"regal", "buecherregal"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_BEECH);
  SetProp(P_WEIGHT, 100000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_NOGET, "Nein, das Regal lass mal lieber hier stehen.\n");

//--Behaeltereigenschaften-------------------------------------------------

  SetProp(P_CONTAINER, 1);
  SetProp(P_MAX_WEIGHT, 10000);
  SetProp(P_WEIGHT_PERCENT, 33);
  SetProp(P_TRANSPARENT, 0);

//--Items------------------------------------------------------------------

  AddItem(OBJ "buecher/palast", REFRESH_REMOVE);

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

string getName(object obj)
{
  return obj->name();
}

//Langbeschreibung:
string _query_long()
{
  int i;
  string txt;
  string s;
  string t;
  string *buecher;
  object *buch;
  buch = all_inventory(TO);
  buch = filter_objects(buch,"id","\nbuch");

   switch(sizeof(buch))
   {
      case 0:
        s = "Huch, das Buecherregal ist ja vollkommen leer!\nAnscheinend "
        +"sind alle Buecher gerade ausgeliehen.\n";
        break;

      case 1:
        s = "Seltsam, nur ein einziges Buch steht in dem Buecherregal:\n"
        +buch[0]->QueryProp(P_SHORT)+".\n";
        break;

      default:
        buecher = map_array(buch, #'getName);
        t = implode(buecher[0..<2], ", ") + " und " + buecher[<1];
        s = "In dem Buecherregal stehen "+t+".\n";

        break;
   }

   txt = "Das Buecherregal fuellt fast die gesamte Wand aus.\n"+s;

   return break_string((txt), 78, 0, BS_LEAVE_MY_LFS);
}

//nur Buecher reinstellen:
varargs int PreventInsert(object ob)
{
        int i;
        string *mybuch;
        mybuch = ({ "\nbuch" });

        for(i = 0; i < sizeof(mybuch); i++)
        {
          if(ob->id(mybuch[i]))
          {
            return ::PreventInsert(ob);
          }
          else
          {
            return 1;
          }
        }
}

void init()
{
  items::init();
  container::init();
}

void reset()
{
  items::init();
  container::init();
}
