#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  call_out("remove", 15+random(45));

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( ({"\nfluch"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

//--Kommandos--------------------------------------------------------------

  AddCmd ( ({"sag","sage","ruf","rufe","frag","frage","red","rede",
  "antwort", "antworte","fluester","fluestere", "'",}),"sagen");

//--Create Ende------------------------------------------------------------

}

int sagen(string str)
{
  if(!IS_WIZARD(TP))
  {
    write(break_string("Du versuchst verzweifelt, etwas zu sagen, doch "
    +"Deine Zaehne kleben zusammen.\nVielleicht haettest Du das "
    +"Karamellbonbon lieber nicht essen sollen.\n",
    78, 0, BS_LEAVE_MY_LFS));
      
    ENV(TP)->Message(BS(TP->Name(WER, 1)+" versucht, etwas zu sagen, doch "
    +"irgendetwas scheint "+(PL->QueryProp(P_GENDER)==MALE?"ihn":"sie")+" "
    +"daran zu hindern.\n"),
    MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;
  }
  
  return 0;
}

int remove()
{
     write(BS("Endlich bekommst Du Deine Zaehne wieder frei.\n"));
     return ::remove();
}
