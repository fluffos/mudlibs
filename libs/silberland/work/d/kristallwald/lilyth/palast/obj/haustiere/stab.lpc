inherit "/p/service/angel/haustiere/std_pet_item.lpc";

#include "/d/kristallwald/lilyth/palast/def.h"
#include <properties.h>
#include <moving.h>
#include "/p/service/angel/haustiere/std_pet.h"

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein magischer Holzstab");
  SetProp(P_LONG,
    "Du haeltst einen blauen, magisch schimmernden Holzstab in Deinen "
    "Haenden. Mit ihm kannst Du Dein Haustier jederzeit zu Dir rufen.");

  AddDetail( ({ "holz" }),
    "Der Stab besteht aus einem seltsam schimmernden, blauen Holz. Es "
    "stammt sicherlich aus dem Tethyrwald.");

  AddDetail( ({ "tethyrwald", "wald" }),
    "Du warst bestimmt schon einmal dort.");

  AddDetail( ({ "haustier" }),
    "Du hast doch eines, oder?");

//--Namen------------------------------------------------------------------

   SetProp(P_INFO,
     "Mit diesem Holzstab kannst Du folgendes tun:\n"
    +"---------------------------------------------\n"
    +"schwingen: Damit kannst Du Dein Haustier zu Dir holen.\n"
    +"pethelp:   Dieses Kommando zeigt Dir einen Hilfetext an.\n"
    +"petconfig: Damit kannst Du Dein Haustier veraendern.\n\n"
    +"entlasse <haustiername> fuer immer:\n"
    +"(WARNUNG: laesst sich nicht wieder rueckgaengig machen!)\n\n" );

  SetProp(P_NAME, "Holzstab");
  SetProp(P_NAME_ADJ, "magisch");
  AddAdjective( ({ "magischer", "magischen" } ));
  SetProp(P_GENDER, MALE);
  AddId( ({"holzstab", "stab"}) );
  seteuid(getuid(this_object()));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_WOOD);
  SetProp(P_WEIGHT, 5);

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "schwing", "schwinge" }), "BringPetBack" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

void _delay(string args)
{
	::BringPetBack(args);
}

int BringPetBack(string args)
{
   if(args == "stab" || 
      args == "holzstab" )
   {
   	write(BS("Du schwingst den magischen Holzstab hin und her.\n"));
   	
        TO->Message(TP->Name(WER, 1)+" schwingt einen magischen Holzstab.\n",
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        call_out("_delay", 2, args);
        return 1;
   }
   
   notify_fail ("Was moechtest Du schwingen?\n");
   return 0;
}
