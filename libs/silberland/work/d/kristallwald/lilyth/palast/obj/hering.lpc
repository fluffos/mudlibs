#include "../def.h"
#include <food.h>
#include <properties.h>

inherit "/std/food";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Hering");
  SetProp(P_LONG,
    "Dieser kleine Hering ist ein laenglicher, schlanker Fisch mit silbrigen "
    "Schuppen und einem graublau schimmernden Ruecken.");

  AddDetail( ({ "schuppen" }),
    "Der Hering hat silbrig glaenzende Schuppen.");

  AddDetail( ({"ruecken"}),
  "Der Ruecken schimmert in einem huebschen Graublau.");

  AddDetail( ({ "graublau" }),
    "Es sieht wirklich huebsch aus.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Hering");
  SetProp(P_GENDER, MALE);
  AddId( ({"\nfisch", "fisch", "hering"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 75);
  SetProp(P_VALUE, 35);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

  SetProp (P_FOOD_INFO, ([
    F_HEAL     : ({2,2}),
    F_SOAK: 1,
    F_MSG      : "Mit einem Bissen futterst Du den kleinen Hering auf.",
    F_MSG_ROOM : "isst einen kleinen Hering.",
    F_MSG_DECAY: "Ein Hering beginnt langsam zu verschimmeln.\n",
    F_MSG_REMOVE: "Der Hering ist voellig verschimmelt und Du entsorgst "
    "ihn ordentlich.\n",
    F_VERB     : "essen" ]) );

  start_decay(1800, 900);

//--Kommandos--------------------------------------------------------------

//AddCmd( ({ "", "" }), "" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------
