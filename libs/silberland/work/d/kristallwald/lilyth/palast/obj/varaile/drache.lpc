#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

string besitzer;
string name;

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  besitzer = 0;
  name = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein gruener Plueschdrache");
//SetProp(P_LONG, --> siehe unten

  AddDetail( ({ "pluesch" }),
    "Der kleine Drache besteht vollstaendig aus weichem, kuscheligem "
    "Pluesch. Dennoch sieht er fast wie echt aus. Am liebsten wuerdest Du "
    "ihn die ganze Zeit knuddeln und an Dich druecken.");

  AddDetail( ({ "kulleraugen", "augen", "kullerauge", "auge" }),
    "Mit seinen grossen, dunklen Kulleraugen blickt Dich der kleine "
    "Drache vertrauensvoll an. Er scheint irgendwie zu spueren, dass Du "
    "ihm niemals ein Leid zufuegen wuerdest.");

  AddDetail( ({ "leid" }),
    "Nein, dafuer ist er einfach zu niedlich.");

  AddDetail( ({ "nuestern", "nuester" }),
    "Aus seinen Nuestern steigen ab und zu kleine Rauchwoelkchen empor.");

  AddDetail( ({ "rauch", "rauchwoelkchen", "woelkchen", "rauchwolken",
  "wolken", "rauchwolke" }),
    "Winzige kleine Rauchwoelkchen steigen aus seinen Nuestern empor.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Plueschdrache");
  SetProp(P_NAME_ADJ, "gruen");
  AddAdjective( ({ "gruener", "gruenen" } ));
  SetProp(P_GENDER, MALE);
  AddId( ({ "drache", "plueschdrache", "drachen", "plueschdrachen" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "Du kannst Deinem Plueschdrachen einen Namen geben "
  "(taufe drache <name>), mit ihm kuscheln, ihn knuddeln, wuscheln und "
  "an Dich druecken und Dich auch mal bei ihm ausweinen, wenn Du traurig "
  "bist. Du kannst ihn aber auch an jemanden verschenken, dem Du eine "
  "Freude machen willst.\n");
  SetProp(P_MATERIAL, MAT_COTTON);
  SetProp(P_WEIGHT, 100);
  SetProp(P_SIZE, 32);
  SetProp(P_VALUE, 125);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "schenk", "schenke" }), "schenken" );
  AddCmd( ({ "tauf", "taufe" }), "taufen" );
  AddCmd( ({ "knuddel", "knuddl", "knuddle", "knuddele" }), "knuddeln" );
  AddCmd( ({ "drueck", "druecke" }), "druecken" );
  AddCmd( ({ "wein", "weine" }), "weinen" );
  AddCmd( ({ "kuschl", "kuschle", "kuschel", "kuschele" }), "kuscheln" );
  AddCmd( ({ "wuschl", "wuschle", "wuschel", "wuschele" }), "wuscheln" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen----------------------------------------------------------

//Kurzbeschreibung:
string _query_short()
{
  string s;

  s = "Ein gruener Plueschdrache";

  if(besitzer != 0 && name != 0)
  {
        s =  name+", der Plueschdrache von "+besitzer;
  }
  return s;
}

//Langbeschreibung:
string _query_long()
{
  string txt;

  txt = "Ein kleiner, gruener Drache aus weichem Pluesch, der Dir mit "
    "seinen grossen, dunklen Kulleraugen vertrauensvoll entgegenblickt. "
    "Aus seinen Nuestern steigt ab und zu ein wenig Rauch auf.\n";

  //gehoert der Drache jemandem?
  if(besitzer == 0)
  {
        txt +=  "Er sieht ein wenig einsam aus.\n";
  }

  if(besitzer != 0 && name != 0)
  {
        txt +=  "Er heisst "+name+" und gehoert "+besitzer+".\n";
  }
  return BS(txt);
}

//den Drachen jmd. schenken
int schenken(string str)
{
  string wer, was;
  object player;

  notify_fail("Wem moechtest Du den Plueschdrachen schenken?\n");

  if(!str || str == "")
  {
        return (notify_fail ("WEM moechtest Du WAS schenken?\n"),0);
  }

  //Syntaxcheck
  if(sscanf(str, "%s %s", wer, was) == 2 && id(was))
  {
      if(TP->Name() == besitzer || !besitzer)
      {
         player = find_player(wer);

         //Spieler ist nicht eingelogt
         if(!player)
         {
              write(BS("Aber "+CAP(wer)+" ist doch gar nicht anwesend."));
              return -1;
          }

          //Spieler ist nicht im gleichen Raum
          if(ENV(TP) != ENV(player))
          {
              write(BS("Aber "+player->name(WER, 1)+" ist doch gar nicht "
              +"hier!"));
              return -1;
          }

          //der Drache ist zu schwer
          if(ME_TOO_HEAVY == this_object()->move(player,M_GET|M_SILENT))
          {
              write(BS(player->Name(WER, 1)+" kann den Plueschdrachen "
              +"leider nicht mehr tragen, daher behaeltst Du ihn lieber."));
              return -1;
          }
          else
          {
              //Schenken klappt
              write(BS("Du schenkst "+player->Name()+" den gruenen "
              +"Plueschdrachen."));

              tell_object(player,BS(TP->Name(WER)+" schenkt Dir einen "
              +"gruenen Plueschdrachen."));
  
              tell_room(ENV(TP),BS(TP->Name()+" schenkt "+player->Name()
              +" einen gruenen Plueschdrachen."), ({ TP, player }));

              besitzer = player->Name(WER);
              return 1;
          }
     }
     else
     {
          write(BS("Aber der Plueschdrache gehoert Dir doch gar nicht!\n"));
          return -1;
     }
  }
  return 0;
}

//dem Drachen einen Namen geben
int taufen(string str)
{
  string wer, was;
  
  notify_fail("Wen oder was moechtest Du wie taufen?\n"
  +"(Syntaxhilfe: taufe drache <name>)\n");

  if(!str || str == "") return 0;

  if( sscanf(str, "%s %s", wer, was) == 2 && id(wer) )
  {
     if(TP->Name() == besitzer || !besitzer)
     {
         if(!name)
         {
             name = capitalize(was);
             
             write(BS("Du taufst Deinen Plueschdrachen auf den "
             +"Namen "+name+"."));
             
             ENV(TP)->Message(BS(TP->Name(WER, 1)+" tauft "
  	     +(TP->QueryProp(P_GENDER) == MALE ? "seinen": "ihren")+" "
  	     +"Plueschdrachen auf den Namen "+name+"."),  	       
  	     MSGFLAG_VISUAL|MSGFLAG_NO_TP);
             
             besitzer = TP->Name(WER);
             AddId(was);
             return 1;
         }
         else
         {
             write(BS("Aber Dein Plueschdrache hat doch schon einen "
             +"Namen."));
             return -1;
         }
     }
     else
     {
        write(BS("Aber der Plueschdrache gehoert Dir doch gar nicht!"));
        return -1;
     }
  }
}

//knuddeln:
int knuddeln(string str)
{
  notify_fail("Wen moechtest Du knuddeln?\n");

  if(!str || str == "") return 0;

  if(!id(str)) return 0;

  write(break_string("Du knuddelst den kleinen Plueschdrachen liebevoll.\n"
  +"Mit einem leisen Schnauben laesst er ein paar kleine, lustige "
  +"Rauchkringel durch seine Nuestern aufsteigen.\n",
  78, 0, BS_LEAVE_MY_LFS));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" knuddelt "
  +(TP->QueryProp(P_GENDER) == MALE ? "seinen": "ihren")+" gruenen "
  +"Plueschdrachen liebevoll."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

//druecken:
int druecken(string str)
{
  notify_fail("Wen willst Du an Dich druecken?\n");

  if(!str || str == "") return 0;

  if(!id(str)) return 0;

  write(break_string("Du drueckst Deinen Plueschdrachen fest an Dich.\n"
  +"Gluecklich schmiegt sich der kleine Drache an Dich an und brummt "
  +"dabei leise.",
  78, 0, BS_LEAVE_MY_LFS));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" drueckt "
  +(TP->QueryProp(P_GENDER) == MALE ? "seinen": "ihren")+" gruenen "
  +"Plueschdrachen fest an sich."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

//knuddeln:
int weinen(string str)
{
  notify_fail("Bei wem willst Du Dich ausweinen?\n");

  if(!str || str == "") return 0;

  if(!id(str)) return 0;

  switch(random(100))
  {
    case 0..65:
      write(break_string("Du weinst Dich bei Deinem Plueschdrachen aus.\n"
      +"Troestend kuschelt sich der kleine Drache an Dich an und pustet Dir "
      +"sanft in Dein Ohr.",
      78, 0, BS_LEAVE_MY_LFS));
      break;
    case 66..100:
      write(break_string("Du weinst Dich bei Deinem Plueschdrachen aus.\n"
      +"Troestend pustet Dir der kleine Drache sanft in Dein Ohr und "
      +"versengt Dir dabei mit einem kleinen Feuerstoss ein wenig die "
      +"Haare.\n"
      +"Der kleine Drache schaemt sich in Grund und Boden.",
      78, 0, BS_LEAVE_MY_LFS));
  }
  ENV(TP)->Message(BS(TP->Name(WER, 1)+" weint sich bei "
  +(TP->QueryProp(P_GENDER) == MALE ? "seinem": "ihrem")+" Plueschdrachen "
  +"aus."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

//druecken:
int kuscheln(string str)
{
  notify_fail("An wen willst Du Dich ankuscheln?\n");

  if(!str || str == "") return 0;

  if(!id(str)) return 0;

  write(break_string("Du kuschelst Dich an Deinen Plueschdrachen an.\n"
  +"Der kleine Drache blinzelt Dir erfreut zu und macht es sich dann in "
  +"Deiner Armbeuge bequem.\n",
  78, 0, BS_LEAVE_MY_LFS));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" kuschelt sich an "
  +(TP->QueryProp(P_GENDER) == MALE ? "seinen": "ihren")+" gruenen "
  +"Plueschdrachen an."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

//wuscheln:
int wuscheln(string str)
{
  notify_fail("Wen willst Du denn wuscheln?\n");

  if(!str || str == "") return 0;

  if(!id(str)) return 0;

  write(break_string("Du verwuschelst Deinem kleinen Plueschdrachen die "
  +"Haare.\nDer kleine Drache knabbert spielerisch an Deinem Ohr herum.\n",
  78, 0, BS_LEAVE_MY_LFS));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" verwuschelt "
  +(TP->QueryProp(P_GENDER) == MALE ? "seinem": "ihrem")+" gruenen "
  +"Plueschdrachen die Haare."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}
