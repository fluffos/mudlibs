//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;

  txt = "Die kleine Schneekugel ist eigentlich nur eine glaeserne Kugel, "
       +"die mit Schnee und einer durchsichtigen Fluessigkeit gefuellt ist. "
       +"Im Inneren der Kugel kannst Du "+figur+" sehen.";

  return BS(txt);
}

int schuetteln(string str)
{
  notify_fail("Was moechtest Du schuetteln?\n");

  if(!str || str == "") return 0;

  if(!(str == "schneekugel" ||
       str == "kugel")) return 0;

  if(find_call_out("seqkugel") != -1)
  {
     write(BS("Der Schnee in der Schneekugel wirbelt doch noch herum, "
     +"warte lieber ein wenig."));
     return -1;
  }
  else
  {
     write(break_string("Du schuettelst die kleine Schneekugel und wartest "
     +"gespannt...\n\n", 78, 0, BS_LEAVE_MY_LFS));

     ENV(TP)->Message(BS(TP->Name(WER, 1)+" schuettelt eine kleine "
     +"Schneekugel."),
     MSGFLAG_VISUAL|MSGFLAG_NO_TP);

     call_out("seqkugel", 5 , TP, 1);
     return 1;
  }
}

void seqkugel(object player, int pos)
{
  string s;

    if(!player || player != ENV(TO))
    {
        return;
    }

    	switch(pos)
        {
        case 1:
        s = "Der Schnee in der Kugel wird aufgewirbelt...\n\n";
        break;

        case 2:
        if(figur == "eine kleine Fee")
        {
            s = "Die kleine Fee kichert leise und beginnt dann, "
            "sich im Schnee zu drehen und zu tanzen.\n\n";
        }
        else
        {
            s = "Der kleine Weihnachtszwerg blickt ein wenig verdutzt "
            "drein.\n\n";
        }
        break;

        case 3:
        if(figur == "eine kleine Fee")
        {
            s = "Froehlich greift die kleine Fee nach den um sie "
            "herumwirbelnden Schneeflocken.\n\n";
        }
        else
        {
            s = "Als dem kleinen Zwerg eine grosse Schneeflocke auf der "
            +"Nase haengenbleibt, lacht er froehlich auf.\n\n";
        }
        break;
        
        case 4:
        s = "Es faellt immer weniger Schnee herab...\n\n";
        break;

        case 5:
        s = "Schliesslich liegen alle Schneeflocken wieder auf dem "
        "Boden der Glaskugel.\n\n";
        break;

        case 6:
        if(figur == "eine kleine Fee")
        {
            s = "Die kleine Fee ruft freudig: Nochmal, nochmal!\n";
        }
        else
        {
            s = "Der kleine Weihnachtszwerg ruft froehlich: Nochmal, "
            "nochmal!\n";
        }
        break;

        default:
          return;
          break;
        }

        tell_object(player, break_string(s, 78, 0, BS_LEAVE_MY_LFS));
        pos = pos + 1;
        call_out("seqkugel", 5, player, pos);
}
