#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

string figur;

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  figur = "";

  switch(random(3))
  {
    case 1:
      figur = "eine kleine Fee";
      break;
    default:
      figur = "einen kleinen Weihnachtszwerg";
      break;
  }

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine kleine Schneekugel");
//SetProp(P_LONG, -> siehe unten

  AddDetail( ({ "glas" }),
    "Die Schneekugel besteht aus Glas.");

  AddDetail( ({ "schnee", "schneeflocken", "flocken", "schneeflocke", 
  "flocke" }),
    "Winzige weisse Schneeflocken kannst Du in der Kugel sehen.");

  AddDetail( ({ "fluessigkeit" }),
    "Sie ist mit einer durchsichtigen Fluessigkeit gefuellt.");

  AddDetail( ({ "innere", "inneres", "inneren" }),
    "Im Inneren der Kugel siehst Du "+figur+".");

  AddSpecialDetail( ({ "fee" }),
    "strfee");

  AddSpecialDetail( ({ "gesicht" }),
    "strgesicht");

  AddSpecialDetail( ({ "augen", "auge" }),
    "straugen");

  AddSpecialDetail( ({ "fluegel" }),
    "strfluegel");

  AddSpecialDetail( ({ "weihnachtszwerg", "zwerg" }),
    "strzwerg");

  AddSpecialDetail( ({ "muetze", "pudelmuetze" }),
    "strmuetze");

  AddSpecialDetail( ({ "bart", "rauschebart" }),
    "strbart");

  AddSpecialDetail( ({ "fellanzug", "anzug" }),
    "stranzug");

  AddSpecialDetail( ({ "bommel" }),
    "strbommel");

  AddSpecialDetail( ({ "fellrand", "rand" }),
    "strrand");

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "Du kannst sie schuetteln.");
  SetProp(P_NAME, "Schneekugel");
  SetProp(P_NAME_ADJ, "klein");
  AddAdjective( ({ "kleine" } ));
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kugel", "schneekugel"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_GLASS: 70, MAT_MISC_FLUID: 5, MAT_MISC_MAGIC: 25]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 175);

//--Kommandos-------------------------------------------------------------

  AddCmd( ({ "schuettel", "schuettle", "schuettl", "schuettele" }), "schuetteln" );

//--Create Ende-----------------------------------------------------------

}

//--Funktionen fuer SpecialDetails-------------------------------------------

string strfee(string str)
{
  string s;

  if(figur == "eine kleine Fee")
  {
  	s = "Die winzige Fee hat ein huebsches Gesicht mit grossen, gruenen "
  	"Augen und sehr zerbrechlich aussehende Fluegel. Sie sieht einfach "
  	"wunderschoen aus.";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

string strgesicht(string str)
{
  string s;

  if(figur == "eine kleine Fee")
  {
  	s = "Sie ist wirklich sehr huebsch.";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

