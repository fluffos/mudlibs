#include "/d/kristallwald/lilyth/palast/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

inherit "/std/thing.lpc";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Baerenfutter");
  SetProp(P_LONG,
    "Das Baerenfutter besteht hauptsaechlich aus den verschiedstenen "
    "Wurzeln, Knollen und Beeren. Auch ein paar kleinere Nuesse und "
    "Fruechte kannst Du erkennen. Es riecht sogar ein wenig nach Honig.");

  AddDetail( ({ "wurzeln", "wurzel", "knollen", "knolle" }),
    "Die Wurzeln und Knollen verschiedener Pflanzen sind in dem "
    "Baerenfutter enthalten.");

  AddDetail( ({ "pflanzen", "pflanze" }),
    "Die kannst Du leider nicht mehr genau identifizieren.");

  AddDetail( ({ "beeren", "beere" }),
    "Du erkennst verschiedene Beeren von verschiedenen Pflanzen.");

  AddDetail( ({ "nuesse", "fruechte", "nuss", "frucht", "stueckchen",
  "fruchtstueckchen", "fruchtstuecke", "stuecke" }),
    "Kleine Nuesse und Fruchtstueckchen sind unter das Futter gemischt "
    "worden.");

  AddDetail( ({ "honig" }),
    "Das Baerenfutter riecht ein wenig nach Honig. Sicherlich wird sich "
    "jeder Baer riesig freuen, wenn Du ihn damit fuetterst.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Baerenfutter");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"baerenfutter", "futter"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 50);
  SetProp(P_SMELL, "Das Baerenfutter riecht ein wenig nach Beeren, "
  "Nuessen und Honig.\n");

//--Create Ende------------------------------------------------------------

}
