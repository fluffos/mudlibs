#include "/d/kristallwald/lilyth/palast/def.h"
#include <food.h>
#include <properties.h>

inherit "/std/food";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Schokoladenkeks");
  SetProp(P_LONG,
    "Dieser kleine, runde Schokoladenkeks wurde aus einem leckeren, dunklen "
    "Schokoladenteig gebacken. Er scheint gerade frisch aus dem Ofen zu "
    "kommen, denn er ist sogar noch ein wenig warm.");

  AddDetail( ({ "schokoladenteig", "teig" }),
    "Er ist schokoladenbraun.");

  AddDetail( ({ "ofen" }),
    "Der Schokoladenkeks ist noch warm. Er kommt wohl gerade frisch aus "
    "dem Ofen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schokoladenkeks");
  SetProp(P_GENDER, MALE);
  AddId( ({"keks", "schokoladenkeks", "\nsuesses"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 10);
  SetProp(P_SMELL, "Der Schokoladenkeks riecht herrlich nach Schokolade.\n");

  SetProp (P_FOOD_INFO, ([
    F_MSG      : "Du knabberst genussvoll an dem kleinen Schokoladenkeks "
    "herum und verdrehst verzueckt die Augen. Lecker! Am liebsten haettest "
    "Du noch einen solchen Keks.\n",
    F_MSG_ROOM : "knabbert an einem Schokoladenkeks herum.\n",
    F_VERB     : "essen" ]) );

//--Create Ende------------------------------------------------------------

}
