#include "../def.h"
#include <food.h>
#include <properties.h>

inherit "/std/food";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Nektarine");
  SetProp(P_LONG,
   "Die Nektarine hat eine schoene, gelbroetliche Farbe und sieht sehr "
   "suess und saftig aus.");

  AddDetail( ({ "farbe" }),
    "Sie ist gelbroetlich gefaerbt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Nektarine");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"\nobst", "obst", "nektarine"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 210);
  SetProp(P_VALUE, 95);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

  SetProp (P_FOOD_INFO, ([
    F_HEAL     : ({3,3}),
    F_SOAK: 2,
    F_MSG      : "Du isst die Nektarine und freust Dich ueber den suessen, "
                 "saftigen Geschmack.",
    F_MSG_ROOM : "isst eine Nektarine und sieht dabei sehr gluecklich aus.",
    F_MSG_DECAY: "Eine Nektarine beginnt langsam zu verfaulen.\n",
    F_MSG_REMOVE: "Die Nektarine ist voellig verfault und Du wirfst sie "
                  "weg.\n",
    F_VERB     : "essen" ]) );

  start_decay(1800, 900);

//--Create Ende------------------------------------------------------------

}
