#include "/d/kristallwald/lilyth/palast/def.h"
#include <food.h>
#include <properties.h>

inherit "/std/food";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Stueck Eistorte");
  SetProp(P_LONG,
    "Dieses grosse Tortenstueck sieht einfach phantastisch aus. Es besteht "
    "fast vollstaendig aus halbgefrorenem, leckeren Eis und ist mit "
    "Sahne, kleinen Schokostueckchen und bunten Streuseln verziert. Du "
    "kannst Dich kaum davon abhalten, es sofort aufzuessen, und das "
    "solltest Du auch bald tun, bevor es noch schmilzt.");

  AddDetail( ({ "eis", "teil" }),
    "Die Eistorte besteht zum groessten Teil aus leckerem Eis.");

  AddDetail( ({ "sahne", "sahnetupferl", "tupferl" }),
    "Ein kleiner, lustiger Sahnetupferl sitzt oben auf dem Tortenstueck.");

  AddDetail( ({ "schokostueckchen", "stueckchen", "schokoladenstuecke", 
  "stuecke", "streusel" }),
    "Kleine, kunstvoll geformte Schokoladenstuecke und bunte Streusel "
    "verziert das Tortenstueck.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Stueck Eistorte");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"stueck", "torte", "eistorte", "eistortenstueck", "tortenstueck",
  "\nsuesses"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_ICE: 50, MAT_MISC_FOOD: 50 ]));
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 5);

  SetProp (P_FOOD_INFO, ([
    F_MSG      : "Du futterst das Stueck Eistorte blitzschnell auf. "
    "Mhh, ist das leeeeecker! Genuesslich reibst Du Dein nun etwas "
    "kaltes Baeuchlein und denkst bereits hoffnungsvoll an das naechste "
    "Stueck Torte.\n",
    F_MSG_ROOM : "futtert genuesslich ein Stueck Eistorte.\nDir laeuft "
    "das Wasser im Mund zusammen.\n",
    F_MSG_DECAY: "Das Stueck Eistorte beginnt langsam zu schmelzen.\n",
    F_MSG_REMOVE: "Das Stueck Eistorte ist nun voellig zerschmolzen.\n",
    F_VERB     : "essen" ]) );

  start_decay(1500, 300);

//--Create Ende------------------------------------------------------------

}
