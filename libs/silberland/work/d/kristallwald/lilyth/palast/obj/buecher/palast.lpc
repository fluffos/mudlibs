inherit "players/lilyth/std/std_buch";

#include "/players/lilyth/std/std_buch.h"
#include "/d/kristallwald/lilyth/palast/def.h"

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein goldenes Buch");
  SetProp(P_LONG,
    "Dieses Buch scheint eine kleinere Ausgabe von dem grossen, goldenen "
    "Buch zu sein, das im Palast der Voelker fuer die Besucher ausgestellt "
    "ist. Obwohl es nur vergoldet wurde und nicht wirklich aus Gold "
    "besteht, sieht es sehr wertvoll aus. In grossen, silbernen Lettern "
    "prangt der Titel des Buches auf seiner Vorderseite." );

  AddDetail( ({ "ausgabe" }),
    "Es scheint eine etwas kleinere Ausgabe von dem aus echtem Gold "
    "bestehenden grossen Buch im Palast zu sein.");

  AddDetail( ({ "palast", "voelker", "geschichte" }),
    "Die Geschichte des Palastes steht in einem grossen, goldenen Buch "
    "geschrieben, das fuer die Besucher dort ausgestellt ist.");

  AddDetail( ({ "gold" }),
    "Dieses Buch besteht leider nicht aus echtem Gold, sondern ist "
    "nur mit einer duennen goldenen Schicht ueberzogen worden.");

  AddDetail( ({ "schicht" }),
    "Sie ist sehr duenn.");

  AddDetail( ({ "letter", "lettern", "vorderseite" }),
    "Grosse, silberne Lettern zieren das Buch auf seiner Vorderseite.");

  AddDetail( ({ "titel" }),
    "Der Titel des Buches steht in silbernen Lettern auf seiner "
    "Vorderseite geschrieben. Du koenntest ihn lesen.");

  AddReadDetail( ({ "titel" }),
    "'Der Palast der Voelker'");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Buch");
  SetProp(P_NAME_ADJ, "golden");
  AddAdjective( ({ "goldenes" } ));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_BUCH, "/d/kristallwald/lilyth/palast/obj/buecher/palast.buch");
  AddId( ({"\nbuch", "buch"}) );  

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_PAPER: 60, MAT_GOLD: 30, 
                         MAT_SILK: 10 ]));
  SetProp(P_WEIGHT, 100);
  SetProp(P_SIZE, 15);
  SetProp(P_VALUE, 250);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 0);
  
//--Create Ende------------------------------------------------------------

}
