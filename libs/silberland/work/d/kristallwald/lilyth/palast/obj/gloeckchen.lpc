#include "../def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein silbernes Gloeckchen");
  SetProp(P_LONG,
    "Du haeltst ein kleines silbernes Gloeckchen in Deiner Hand. Wenn Du "
    "willst, kannst Du es ja einmal laeuten.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Gloeckchen");
  SetProp(P_NAME_ADJ, "silbern");
  AddAdjective( ({ "silbernes" } ));
  SetProp(P_GENDER, NEUTER);
  AddId("gloeckchen");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_SILVER);
  SetProp(P_WEIGHT, 7);
  SetProp(P_VALUE, 10);

//--Kommandos--------------------------------------------------------------

AddCmd( ({ "laeut", "laeute" }), "laeuten" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

int laeuten(string str)
{
  notify_fail("Womit moechtest Du laeuten?\n");

  if(!str || str == "") return 0;

  if(!(str == "gloeckchen" ||
       str == "mit gloeckchen" )) return 0;

  	write(BS("Du laeutest leise mit Deinem Gloeckchen. PLING!"));

  	ENV(TP)->Message(BS(TP->Name(WER, 1)+" laeutet leise mit "
  	+(TP->QueryProp(P_GENDER) == MALE ? "seinem": "ihrem")+" "
  	+"Gloeckchen. PLING!"),
  	MSGFLAG_SOUND|MSGFLAG_NO_TP);
  	return 1;
}
