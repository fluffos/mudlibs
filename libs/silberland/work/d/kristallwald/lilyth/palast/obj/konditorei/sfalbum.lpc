#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

int inhalt;

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  inhalt == 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein magisches Sammelalbum");
//SetProp(P_LONG, --> siehe unten

  AddDetail( ({ "anzahl" }),
    "In dieses Sammelalbum kannst Du eine grosse Anzahl magischer "
    "Sammelkarten hineinkleben.");

  AddDetail( ({ "seiten", "seite" }),
    "Das Sammelalbum hat mehrere Seiten, die in den verschiedensten "
    "Farben schimmern und mit einem silbrigen Rand verziert sind.");

  AddDetail( ({ "farben" }),
    "Einige schimmern leicht blaeulich, andere gruenlich, wiederum andere "
    "rosafarben...");

  AddDetail( ({ "rand" }),
    "Der Rand jeder einzelnen Seite glaenzt silbrig.");

  AddSpecialDetail( ({ "schokofroschkarten", "sammelkarten",
  "sammlerkarten", "karten" }),
    "strkarten");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Sammelalbum");
  SetProp(P_NAME_ADJ, "magisch");
  AddAdjective( ({ "magisches", "magischen", "magischem" } ));
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "album", "sammelalbum" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "In dieses Sammelalbum kannst Du die magischen Karten "
  +"hineinkleben, die normalerweise in Schokofroschpackungen enthalten "
  +"sind. Und wenn Du es einmal voll hast... nun, wer weiss, was dann wohl "
  +"passieren mag? :)");

  SetProp(P_MATERIAL, ([MAT_PAPER: 55, MAT_MISC_MAGIC: 40, MAT_SILVER: 5]));
  SetProp(P_WEIGHT, 50);

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "kleb", "klebe" }), "kleben" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;
  string s;

  switch(inhalt)
  {
    case 0:        s = "Es scheint noch vollkommen leer zu sein.";
                   break;
    case 1:        s = "Es wurde erst eine einzige Karte in ihm eingeklebt.";
                   break;
    case 2..9:     s = "Es befinden sich erst wenige Karten in ihm.";
                   break;
    case 10..29:   s = "Es befinden sich bereits einige Karten in ihm.";
                   break;
    case 30..54:   s = "Es sind schon recht viele Karten in ihm eingeklebt worden.";
                   break;
    case 55..69:   s = "Es ist schon bis ueber die Haelfte mit Karten gefuellt.";
                   break;
    case 70..89:   s = "Es befinden sich bereits sehr viele Karten in ihm.";
                   break;
    case 90..100:  s = "Es passen nicht mehr sehr viele Karten hinein.";
                   break;
    default:       s = "Es ist schon fast voll!";
                   break;
  }

  txt = "Dieses magische Sammelalbum ist hervorragend dazu geeignet, eine "
    "grosse Anzahl an Schokofroschkarten in sich aufzunehmen. Es besteht "
    "aus vielen farbig schimmernden Seiten, die sorgsam gebunden wurden und "
    "mit einem silbrigen Rand versehen sind. "+s;

  return BS(txt);
}

string strkarten(string str)
{
  string s;

  if(inhalt == 0)
  {
  	s = "Das Sammelalbum ist noch voellig leer.";
  }
  if(inhalt == 1)
  {
        s = "Es befindet sich erst eine einzige Karte in dem Sammelalbum.";
  }
  if(inhalt > 1)
  {
  	s = "Rasch zaehlst Du die eingeklebten Karten nach und kommst auf "
  	+"insgesamt "+inhalt+".";
  }
  if(inhalt > 50)
  {
  	s = "Rasch zaehlst Du die eingeklebten Karten nach und kommst auf "
  	+"insgesamt "+inhalt+". Eine starke Leistung, weiter so!";
  }
  if(inhalt > 75)
  {
  	s = "Rasch zaehlst Du die eingeklebten Karten nach und kommst auf "
  	+"insgesamt "+inhalt+". Du hast es bald geschafft! Nicht aufgeben!";
  }
  if(inhalt > 100)
  {
  	s = "Rasch zaehlst Du die eingeklebten Karten nach und kommst auf "
  	+"insgesamt "+inhalt+". Bravo, das Album ist fast bis obenhin voll! "
  	+"Endspurt!";
  }
  return BS(s);
}

int kleben(string str)
{
  object karte;
  karte = present("magic_card", TP);

  notify_fail("Was willst Du wo hineinkleben?\n");

  if(!str || str == "") return 0;

  if(!(str == "karte in album" ||
       str == "sammelkarte in album" ||
       str == "sammlerkarte in album" ||
       str == "karte in sammelalbum" ||
       str == "sammelkarte in sammelalbum" ||
       str == "sammlerkarte in sammelalbum" )) return 0;

  if(karte)
  {
/*    if(karte doppelt)
      {
          write(BS("Schade, genau diese Karte befindet sich bereits in "
          +"Deinem Sammelalbum. Aber vielleicht kannst Du sie ja mit "
          +"jemandem tauschen."));
          return -1;
      }
      else
      {
*/
          write(BS("Du klebst die Karte in Dein Sammelalbum."));

          ENV(TP)->Message(BS(TP->Name(WER, 1)+" klebt eine Karte in "
          +TP->QueryPossPronoun(NEUTER, WEN, SINGULAR)+" Sammelalbum."),
          MSGFLAG_VISUAL|MSGFLAG_NO_TP);

          karte->remove();
          inhalt++;
          return 1;
//    }
  }
  else
  {
      write(BS("Aber Du hast doch gar keine Sammelkarte bei Dir."));
      return -1;
  }
}
