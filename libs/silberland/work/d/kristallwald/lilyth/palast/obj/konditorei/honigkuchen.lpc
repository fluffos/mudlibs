#include "/d/kristallwald/lilyth/palast/def.h"
#include <food.h>
#include <properties.h>

inherit "/std/food";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Honigkuchen");
  SetProp(P_LONG,
    "Dieser herrlich duftende Honigkuchen sieht wirklich sehr lecker aus. "
    "Eine hauchduenne Zuckerglasur umgibt den goldbraun gebackenen "
    "Lebkuchen und bewahrt ihn davor, zu schnell trocken zu werden.");

  AddDetail( ({ "zuckerglasur", "glasur", "zucker", "schicht" }),
    "Eine hauchduenne Schicht aus geschmolzenem Zucker umgibt den "
    "Kuchen.");

  AddDetail( ({ "lebkuchen", "art" }),
    "Der Honigkuchen ist eigentlich eine Art Lebkuchen, nur dass er viel "
    "mehr Honig enthaelt, als der 'normale' Lebkuchen.");

  AddDetail( ({ "honig" }),
    "Daher hat der Honigkuchen seinen Namen.");

  AddDetail( ({ "name", "namen" }),
    "Der Honigkuchen heisst so, weil er mit sehr viel Honig gemacht wird.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Honigkuchen");
  SetProp(P_GENDER, MALE);
  AddId( ({"honigkuchen", "kuchen", "\nsuesses"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 95);
  SetProp(P_SMELL, "Er duftet herrlich nach Honig und Lebkuchen.\n");

  SetProp (P_FOOD_INFO, ([
    F_MSG      : "Du beisst voller Genuss in den Honigkuchen hinein und "
    "faengst unwillkuerlich an zu grinsen, so lecker schmeckt er nach "
    "Honig, frischem Lebkuchen und anderen herrlichen Dingen.\n",
    F_MSG_ROOM : "schiebt sich ein grosses Stueck Honigkuchen in den Mund "
    "und grinst ploetzlich wie ein Honigkuchenpferd.\n",
    F_MSG_DECAY: "Der Honigkuchen vertrocknet langsam.\n",
    F_MSG_REMOVE : "Der Honigkuchen ist voellig vertrocknet und Du "
    "entsorgst ihn rasch.\n",
    F_VERB     : "essen" ]) );

  start_decay(3500, 300);

//--Create Ende------------------------------------------------------------

}
