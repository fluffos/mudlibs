#include "/d/kristallwald/lilyth/palast/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

inherit "/std/thing.lpc";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Maeusefutter");
  SetProp(P_LONG,
    "Dieses Maeusefutter besteht aus einer ausgewogenen Mischung aus den "
    "verschiedensten Koernern, Beeren und Nuessen. Das schmeckt sicherlich "
    "auch der waehlerischsten Maus hervorragend.");

  AddDetail( ({ "mischung", "futtermischung" }),
    "Die Mischung von Koernern, Beeren und Nuessen ist ausgewogen und "
    "sehr gesund.");

  AddDetail( ({ "koerner" }),
    "Verschiedene Koerner sind in dem Maeusefutter enthalten.");

  AddDetail( ({ "beeren", "beere" }),
    "Du kannst die verschiedenen Sorten leider nicht genauer definieren.");

  AddDetail( ({ "sorte", "sorten" }),
    "Es sind verschiedene Sorten Beeren und Nuesse beigemengt worden.");

  AddDetail( ({ "nuesse", "nuss" }),
    "Du kannst kleingehackte Nuesse in der Futtermischung erkennen.");

  AddDetail( ({ "maus" }),
    "Wenn Dir eine ueber den Weg laeuft, kannst Du sie ja hiermit "
    "fuettern.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Maeusefutter");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"maeusefutter", "futter"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 10);
  SetProp(P_SMELL, "Das Maeusefutter riecht nach verschiedenen Koernern, "
  "Beeren und Nuessen.\n");

//--Create Ende------------------------------------------------------------

}
