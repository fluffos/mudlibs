#include "/d/kristallwald/lilyth/palast/def.h"
#include <food.h>
#include <properties.h>

inherit "/std/food";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleiner Schokofrosch");
  SetProp(P_LONG,
    "Dieser Schokofrosch sieht eigentlich genauso aus wie ein richtiger "
    "Frosch, nur dass er nicht gruen ist, sondern aus feinster, hellbrauner "
    "Schokolade besteht. Du solltest ihn schnell essen, bevor er "
    "womoeglich noch schmilzt.");

  AddDetail( ({ "schokolade" }),
    "Der Schokofrosch besteht, wie sein Name schon sagt, aus feiner "
    "Schokolade.");

  AddDetail( ({ "name" }),
    "Der Schokofrosch heisst so, weil er aus Schokolade besteht.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schokofrosch");
  SetProp(P_NAME_ADJ, "klein");
  AddAdjective( ({ "kleiner", "kleinen" } ));
  SetProp(P_GENDER, MALE);
  AddId( ({ "frosch", "schokofrosch", "\nsuesses" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 3);
  SetProp(P_VALUE, 15);

  SetProp (P_FOOD_INFO, ([
    F_MSG      : "Du knabberst ein wenig an dem Schokofrosch herum. "
    "Als Du die zartschmelzende Schokolade auf Deiner Zunge spuerst, "
    "schliesst Du voellig entzueckt die Augen. Als Du sie schliesslich "
    "wieder oeffnest, merkst Du, dass Du den ganzen Schokofrosch schon "
    "aufgefuttert hast. Ein wenig enttaeuschst laesst Du Deinen Blick "
    "durch den Raum schweifen, in der Hoffnung, irgendwo noch eines von "
    "diesen leckeren Froeschlein zu finden.",
    F_MSG_ROOM : "knabbert genuesslich an einem Schokofrosch herum. Ein "
    "wenig neidisch schaust Du zu. Eigentlich haettest Du auch gerne so "
    "einen leckeren Schokofrosch.",
    F_VERB     : "essen" ]) );

//--Create Ende------------------------------------------------------------

}
