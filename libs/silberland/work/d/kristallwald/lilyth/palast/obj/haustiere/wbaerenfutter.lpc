#include "/d/kristallwald/lilyth/palast/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

inherit "/std/thing.lpc";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Waschbaerenfutter");
  SetProp(P_LONG,
    "Das Waschbaerenfutter besteht aus einer gesunden und "
    "abwechslungsreichen Mischung von Fruechten, Nuessen und "
    "Getreide. Es sieht eigentlich recht lecker aus.");

  AddDetail( ({ "mischung", "futtermix", "mix" }),
    "Das schmeckt sicherlich jedem Waschbaer.");

  AddDetail( ({ "waschbaer", "waschbaeren" }),
    "Ein Waschbaer wuerde sich ueber diesen leckeren Futtermix sicherlich "
    "freuen.");

  AddDetail( ({ "fruechte", "frucht" }),
    "Du kannst die einzelnen Fruechte nicht mehr genau identifizieren, "
    "da sie in sehr kleine, waschbaermundgerechte Stuecke geschnitten "
    "wurden.");

  AddDetail( ({ "stueck", "stuecke" }),
    "Die Fruechte wurden kleingeschnitten.");

  AddDetail( ({ "nuesse", "nuss" }),
    "Verschiedene Sorten von Nuessen sind in dem Futter enthalten.");

  AddDetail( ({ "sorte", "sorten" }),
    "Du kannst sie nicht mehr genau erkennen.");

  AddDetail( ({ "getreide" }),
    "Frisches, gesundes Getreide wurde dem Futter beigemengt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Waschbaerenfutter");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"waschbaerenfutter", "futter"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 30);
  SetProp(P_SMELL, "Das Waschbaerenfutter riecht nach verschiedenen "
  "Fruechten, Nuessen und Getreide.\n");
  
//--Create Ende------------------------------------------------------------

}
