#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/container";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein grosser Buecherschrank");
//SetProp(P_LONG, --> siehe weiter unten

  AddDetail( ({ "richtig",  }),
    "Ob er fuer Dich das Richtige ist, wirst Du wohl selbst am besten "
    "wissen.");

  AddDetail( ({ "buecherfreund" }),
    "Bist Du einer?");

  AddDetail( ({ "eichenholz", "holz" }),
    "Der Schrank besteht aus dunklem Eichenholz.");

  AddDetail( ({ "platz" }),
    "Dieser Schrank bietet Platz fuer unzaehlige grosse und kleine Buecher.");

  AddDetail( ({ "lauf", "laufe", "leben" }),
    "In einem so langen Leben wie dem Deinen kann sich schon so manches "
    "ansammeln.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Buecherschrank");
  SetProp(P_NAME_ADJ, "gross");
  AddAdjective( ({ "grosser", "grossen" } ));
  SetProp(P_GENDER, MALE);
  AddId( ({"\nmoebel", "schrank", "buecherschrank", "\n_regal"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_OAK);
  SetProp(P_WEIGHT, 10000);
  SetProp(P_VALUE, 1350);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Behaeltereigenschaften-------------------------------------------------

  SetProp(P_CONTAINER, 1);
  SetProp(P_MAX_WEIGHT, 20000);
  SetProp(P_WEIGHT_PERCENT, 33);
  SetProp(P_TRANSPARENT, 0);

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

string getName(object obj)
{
  return obj->name();
}

//Langbeschreibung:
string _query_long()
{
  int i;
  string txt;
  string s;
  string t;
  string *buecher;
  object *buch;
  buch = all_inventory(TO);
  buch = filter_objects(buch,"id","\nbuch");

   switch(sizeof(buch))
   {
      case 0:
        s = "Es befinden sich momentan keine Buecher in dem Schrank.\n";
        break;

      case 1:
        s = "Du siehst nur ein einziges Buch im Schrank stehen: "
        +buch[0]->QueryProp(P_SHORT)+".\n";
        break;

      default:
        buecher = map_array(buch, #'getName);
        t = implode(buecher[0..<2], ", ") + " und " + buecher[<1];
        s = "Zur Zeit siehst Du "+t+" im Schrank stehen.\n";

        break;
   }

   txt = "Dieser grosse Buecherschrank ist genau das Richtige fuer jeden "
   +"wahren Buecherfreund. Er besteht aus dunklem Eichenholz und bietet "
   +"reichlich Platz fuer die unzaehligen schriftlichen Werke, die sich im "
   +"Laufe eines erfahrungsreichen Lebens so ansammeln koennen.\n"+s;

   return break_string((txt), 78, 0, BS_LEAVE_MY_LFS);
}

//nur Buecher reinstellen:
varargs int PreventInsert(object ob)
{
        int i;
        string *mybuch;
        mybuch = ({ "\nbuch", "buch" });

        for(i = 0; i < sizeof(mybuch); i++)
        {
          if(ob->id(mybuch[i]))
          {
            return ::PreventInsert(ob);
          }
          else
          {
            return 1;
          }
        }
}
