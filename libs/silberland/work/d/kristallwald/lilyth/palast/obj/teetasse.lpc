#include "../def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

int i; // Anzahl Zucker
int j; // Zucker
int k; // Milch
string sorte; //Teesorte

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  j=0;
  k=0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine kleine Teetasse");
//SetProp(P_LONG,   -> siehe unten

  AddDetail( ({ "blueten" }),
    "Winzige rosa Blueten schmuecken die kleine Teetasse.");

  AddDetail( ({ "dampf" }),
    "Der Tee ist noch frisch und heiss. Verbrenn Dir nicht den Mund beim "
    "Trinken. Am besten ruehrst Du ihn erst ein wenig um, bevor Du ihn "
    "trinkst.");

  AddDetail( ({ "trinken" }),
    "Du kannst den Tee ruhig trinken, wenn Du magst.");

  AddSpecialDetail( ({ "tee" }),
    "strtee");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Teetasse");
  SetProp(P_NAME_ADJ, "klein");
  AddAdjective( ({ "kleine" } ));
  SetProp(P_GENDER, FEMALE);
  AddId( ({"tasse", "teetasse"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_CERAMIC: 40, MAT_MISC_FLUID: 60 ]));
  SetProp(P_WEIGHT, 15);
  SetProp(P_SIZE, 7);
  SetProp(P_VALUE, 100);

//--Kommandos-------------------------------------------------------------

  AddCmd( ({ "trink", "trinke" }), "trinken" );
  AddCmd( ({ "ruehr", "ruehre" }), "umruehren" );

//--Create Ende-----------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;

  txt = "Eine kleine, mit zarten rosa Blueten verzierte Teetasse. Sie ist "
        "mit heissem, herrlich duftendem "+sorte+" gefuellt. ";

  return BS(txt);
}

//Detail Tee:
string strtee(string str)
{
  string s;

  s = "Frischer heisser "+sorte+" befindet sich in der Tasse. Leichter Dampf "
      "steigt von ihm auf.";

  return BS(s);
}

//Tee trinken:
int trinken(string str)
{
  string s;
  s = "Vorsichtig, um Dir nicht den Mund zu verbrennen, trinkst Du ein paar "
  "Schlucke von dem heissen "+sorte+". Hmmmm, der schmeckt richtig lecker! "
  "Ein wohliges Gefuehl breitet sich langsam in Deinem ganzen Koerper aus. ";

  notify_fail("Was moechtest Du trinken?\n");

  if(!str || str == "") return 0;

  if(!(str == "tee")) return 0;

  if(str == "tee" || str == lower_case(sorte))
  {
    if(i < 3)
    {
        write(BS(s));

        ENV(TP)->Message(BS(TP->Name(WER, 1)+" schluerft genuesslich eine "
        +"Tasse heissen "+sorte+"."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        i++;
        return 1;
    }
    else
    {
        write(BS(s+"Schade, nun ist der ganze leckere Tee leider schon "
        +"ausgetrunken. :("));

        ENV(TP)->Message(BS(TP->Name(WER, 1)+" schluerft genuesslich eine "
        +"Tasse heissen "+sorte+"."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        TO->remove();
        return -1;
    }
  }
}

//Tee umruehren:
int umruehren(string str)
{
  notify_fail("Was moechtest Du umruehren?\n");

  if(!str || str == "") return 0;

  if(str == "tee um" || str == "tee mit loeffel um" ||
     str == lower_case(sorte)+" um" ||
     str == lower_case(sorte)+" mit loeffel um")
  {
       write(BS("Du ruehrst den "+sorte+" mit einem kleinen Silberloeffel "
       +"um."));

       ENV(TP)->Message(BS(TP->Name(WER, 1)+" ruehrt den "+sorte+" mit "
       +"einem kleinen Silberloeffel um."),
       MSGFLAG_VISUAL|MSGFLAG_NO_TP);
       return 1;
  }

  return 0;
}

int SetZucker()
{
        j++;
        return j;
}

int SetMilch()
{
        k++;
        return k;
}

void SetSorte(string str)
{
        sorte = str;
        return;
}
