#include "../def.h"
#include <food.h>
#include <properties.h>

inherit "/std/food";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Seezunge");
  SetProp(P_LONG,
    "Diese kleine Seezunge hat kurze Flossen, die saumfoermig um ihren "
    "flachen Koerper angeordnet sind.");

  AddDetail( ({ "koerper" }),
    "Seezungen haben einen sehr flachen Koerper, aehnlich wie Schollen.");

  AddDetail( ({"scholle", "schollen"}),
  "Dies hier ist eine Seezunge, keine Scholle.");

  AddDetail( ({ "flossen" }),
    "Die kurzen Flossen sind saumfoermig um ihren Koerper angeordnet.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Seezunge");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"\nfisch", "fisch", "seezunge"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 120);
  SetProp(P_VALUE, 30);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

  SetProp (P_FOOD_INFO, ([
    F_HEAL     : ({3,3}),
    F_SOAK: 2,
    F_MSG      : "Du isst die Seezunge auf und wunderst Dich ein wenig "
                 "ueber den fischigen Geschmack.",
    F_MSG_ROOM : "knabbert an einer Seezunge herum.",
    F_MSG_DECAY: "Eine Seezunge beginnt langsam zu verschimmeln.\n",
    F_MSG_REMOVE: "Die Seezunge ist voellig verschimmelt und Du entsorgst "
                  "sie ordentlich.\n",
    F_VERB     : "essen" ]) );

  start_decay(1800, 900);

//--Kommandos--------------------------------------------------------------

//AddCmd( ({ "", "" }), "" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------
