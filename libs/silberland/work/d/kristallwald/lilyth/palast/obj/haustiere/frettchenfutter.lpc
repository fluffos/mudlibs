#include "/d/kristallwald/lilyth/palast/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

inherit "/std/thing.lpc";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Frettchenfutter");
  SetProp(P_LONG,
    "Das Frettchenfutter sieht recht lecker aus. Es besteht aus frischem "
    "Obst, ein wenig Getreide und kleingehacktem Fleisch, das Du allerdings "
    "nicht genauer definieren kannst.");

  AddDetail( ({ "obst" }),
    "Das Frettchenfutter besteht teilweise aus frischem Obst.");

  AddDetail( ({ "getreide" }),
    "Frisches Obst und Getreide ist in dem Futter enthalten.");

  AddDetail( ({ "fleisch", "stueckchen", "stuecke" }),
    "Kleine Fleischstueckchen, die Du aber nicht weiter definieren kannst.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Frettchenfutter");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"frettchenfutter", "futter"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 30);
  SetProp(P_SMELL, "Das Frettchenfutter riecht nach Obst und Getreide.\n");
  
//--Create Ende------------------------------------------------------------

}
