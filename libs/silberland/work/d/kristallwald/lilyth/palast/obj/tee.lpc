#include "../def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

string s; //Sorte
string t; //Geruch
int k;  //Zaehlvariable fuer Anzahl Tassen
mapping anzahl; //Anzahl der noch vorhandenen Tassen

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  anzahl = ([ 1: "eine Tasse",
              2: "zwei Tassen",
              3: "drei Tassen",
              4: "vier Tassen",
              5: "fuenf Tassen" ]);

  k = 5;

  switch(random(11))
  {
    case 1:
      s = "Apfeltee";
      t = "Aepfeln";
      SetProp(P_MATERIAL, MAT_FRUIT);
      AddId( ({"\ntee", "tee", "apfeltee", "paeckchen"}) );
      break;
    case 2:
      s = "Holunderbeerentee";
      t = "Holunderbeeren";
      SetProp(P_MATERIAL, MAT_FRUIT);
      AddId( ({"\ntee", "tee", "holunderbeerentee", "paeckchen"}) );
      break;
    case 3:
      s = "Fencheltee";
      t = "Fenchel";
      SetProp(P_MATERIAL, MAT_MISC_HERBAL);
      AddId( ({"\ntee", "tee", "fencheltee", "paeckchen"}) );
      break;
    case 4:
      s = "Brennesseltee";
      t = "Brennesseln";
      SetProp(P_MATERIAL, MAT_MISC_HERBAL);
      AddId( ({"\ntee", "tee", "brennesseltee", "paeckchen"}) );
      break;
    case 5:
      s = "Hagebuttentee";
      t = "Hagebutten";
      SetProp(P_MATERIAL, MAT_FRUIT);
      AddId( ({"\ntee", "tee", "hagebuttentee", "paeckchen"}) );
      break;
    case 6:
      s = "Lindenbluetentee";
      t = "Lindenblueten";
      SetProp(P_MATERIAL, MAT_MISC_HERBAL);
      AddId( ({"\ntee", "tee", "lindenbluetentee", "paeckchen"}) );
      break;
    case 7:
      s = "Ringelblumentee";
      t = "Ringelblumen";
      SetProp(P_MATERIAL, MAT_MISC_HERBAL);
      AddId( ({"\ntee", "tee", "ringelblumentee", "paeckchen"}) );
      break;
    case 8:
      s = "Brombeertee";
      t = "Brombeeren";
      SetProp(P_MATERIAL, MAT_FRUIT);
      AddId( ({"\ntee", "tee", "brombeertee", "paeckchen"}) );
      break;
    case 9:
      s = "Sonnenblumentee";
      t = "Sonnenblumen";
      SetProp(P_MATERIAL, MAT_MISC_HERBAL);
      AddId( ({"\ntee", "tee", "sonnenblumentee", "paeckchen"}) );
      break;
    case 10:
      s = "Orangenbluetentee";
      t = "Orangenblueten";
      SetProp(P_MATERIAL, MAT_MISC_HERBAL);
      AddId( ({"\ntee", "tee", "orangenbluetentee", "paeckchen"}) );
      break;
    default:
      s = "Vanilletee";
      t = "Vanille";
      SetProp(P_MATERIAL, MAT_MISC_HERBAL);
      AddId( ({"\ntee", "tee", "vanilletee", "paeckchen"}) );
      break;
  }

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Paeckchen "+s+"");
//SetProp(P_LONG, -> siehe unten

  AddDetail( ({ "teeblaetter", "blaetter", "teeblatt", "blatt",
  "teepaeckchen"}),
    "Die Teeblaetter sind noch ganz frisch. Sie duften herrlich "
    "nach "+t+".");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Paeckchen " +s);
  SetProp(P_GENDER, NEUTER);

//--Eigenschaften----------------------------------------------------------

  SetProp(P_WEIGHT, 10+random(25));
  SetProp(P_SIZE, 10+random(5));
  SetProp(P_VALUE, 50+random(70));
  SetProp(P_SMELL, "Ahhhh, das riecht einfach herrlich!\n");
  SetProp(P_INFO, "Wenn Du jetzt noch ein Teeservice dazu haettest, "
  "koenntest Du Dir einen leckeren "+s+" zubereiten.");

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;

  txt = "Ein kleines Paeckchen mit "+s+". Es befinden sich noch "
        "Teeblaetter fuer etwa "+anzahl[k]+" darin.";

  return BS(txt);
}

void SetTeeblaetter()
{
        k--;
        if(!k) remove();
}

string QuerySorte()
{
        return s;
}
