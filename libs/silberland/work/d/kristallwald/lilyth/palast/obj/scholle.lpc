#include "../def.h"
#include <food.h>
#include <properties.h>

inherit "/std/food";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Scholle");
  SetProp(P_LONG,
    "Diese Scholle hat kurze, saumfoermig um ihren Koerper angeordnete "
    "Flossen. Irgendwie sieht sie ziemlich geplaettet aus.");

  AddDetail( ({ "koerper" }),
    "Schollen haben einen sehr flachen, ja geradezu platten Koerper.");

  AddDetail( ({ "flossen" }),
    "Die Flossen sind saumfoermig um ihren Koerper angeordnet.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Scholle");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"\nfisch", "fisch", "scholle"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 130);
  SetProp(P_VALUE, 35);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

  SetProp (P_FOOD_INFO, ([
    F_HEAL     : ({3,3}),
    F_SOAK: 2,
    F_MSG      : "Du isst die Scholle bis auf die Graeten auf und fuehlst "
                 "Dich leicht geplaettet.",
    F_MSG_ROOM : "isst eine Scholle und sieht ploetzlich leicht geplaettet "
                 "aus.",
    F_MSG_DECAY: "Eine Scholle beginnt langsam zu verschimmeln.\n",
    F_MSG_REMOVE: "Die Scholle ist voellig verschimmelt und Du entsorgst "
                  "sie ordentlich.\n",
    F_VERB     : "essen" ]) );

  start_decay(1800, 900);

//--Kommandos--------------------------------------------------------------

//AddCmd( ({ "", "" }), "" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------
