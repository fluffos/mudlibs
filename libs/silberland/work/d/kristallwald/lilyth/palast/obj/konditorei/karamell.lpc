#include "/d/kristallwald/lilyth/palast/def.h"
#include <food.h>
#include <properties.h>

inherit "/std/food";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Karamellbonbon");
  SetProp(P_LONG,
    "Ein leckeres, klebriges Karamellbonbon. Es hat eine sehr schoene, "
    "hellbraune Farbe und fuehlt sich ein wenig weich an. Du koenntest es "
    "essen.");

  AddDetail( ({ "farbe" }),
    "Das Karamellbonbon hat eine gleichmaessige hellbraune Farbe.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Karamellbonbon");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"bonbon", "karamellbonbon", "karamell", "karamelbonbon", "karamel"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 3);
  SetProp(P_VALUE, 7);
  SetProp(P_SMELL, "Es riecht lecker nach Karamell.\n");

  SetProp (P_FOOD_INFO, ([
    F_MSG      : "Du steckst Dir das Karamellbonbon in den Mund und "
    "kaust froehlich darauf herum.\n",
    F_MSG_ROOM : "steckt sich ein Karamellbonbon in den Mund und kaut "
    "mit einem etwas seltsamen Gesichtsausdruck darauf herum.\n",
    F_VERB     : "essen" ]) );

//--Create Ende------------------------------------------------------------

}

BeimEssen()
{
    clone_object(OBJ "konditorei/karamell_fluch")->move(TP,M_NOCHECK|M_SILENT);
}
