#include "/d/kristallwald/lilyth/palast/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

inherit "/std/thing.lpc";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eulenfutter");
  SetProp(P_LONG,
    "Das Eulenfutter besteht aus kleinen, in schnabelgerechte Haeppchen "
    "zerteilten Fleischstueckchen, die Du lieber gar nicht so genau "
    "identifizieren willst. Aber einer Eule schmeckt das merkwuerdige "
    "Zeug sicherlich ganz gut.");

  AddDetail( ({ "fleischstueckchen", "stueckchen", "fleisch" }),
    "Du willst eigentlich gar nicht wissen, woher dieses Fleisch stammt. "
    "Aber Du musst zugeben, dass es eine gewisse Aehnlichkeit mit "
    "Maeuseueberresten hat.");

  AddDetail( ({ "aehnlichkeit", "haeppchen" }),
    "Die Fleischstueckchen sind in kleine, schnabelgerechte Haeppchen "
    "zerteilt worden.");

  AddDetail( ({ "maeuseueberreste", "ueberreste" }),
    "Nein, DAS willst Du nun wirklich nicht genauer wissen.");

  AddDetail( ({ "eule", "mahlzeit" }),
    "Fuer eine Eule stellt das hier sicher eine leckere Mahlzeit dar.");

  AddDetail( ({ "zeug" }),
    "Wenn Du das Eulenfutter so betrachtest, bist Du ganz froh, dass Du "
    "keine Eule bist.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Eulenfutter");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"eulenfutter", "futter"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 20);
  SetProp(P_SMELL, "Das Eulenfutter riecht nach Fleisch... und Maeusen.\n");
  
//--Create Ende------------------------------------------------------------

}
