#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

int i;
mapping anzahl;

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  anzahl = ([ 1: "eine einzige Anwendung",
              2: "wenige Anwendungen",
              3: "wenige Anwendungen",
              4: "einige Anwendungen",
              5: "einige Anwendungen",
              6: "einige Anwendungen",
              7: "mehrere Anwendungen",
              8: "mehrere Anwendungen",
              9: "mehrere Anwendungen",
             10: "mehrere Anwendungen" ]);

  i = 10;
  
//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Etwas Brennholz");
//SetProp(P_LONG, --> siehe unten

  AddDetail( ({ "feuer" }),
    "Um ein Feuer zu entfachen, benoetigt man ausser einem Ofen auch "
    "ein wenig Holz wie dieses.");

  AddDetail( ({ "ofen" }),
    "Wenn Du einen hast, wirst Du das Brennholz sicherlich gut "
    "gebrauchen koennen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Brennholz");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "brennholz", "holz", "holzscheite", "holzscheit", "scheite",
  "scheit", "\nbrennholz", "\n_sonstige" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "Jeder stolze Ofenbesitzer benoetigt frueher oder spaeter "
  "auch Brennholz.");
  SetProp(P_MATERIAL, MAT_MISC_WOOD);
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;

  txt = "Ein paar grob geschnitzte Holzscheite, mit denen man ein Feuer "
        "in einem Ofen machen kann. Es ist noch genuegend Holz fuer "
        +anzahl[i]+" vorhanden.";

  return BS(txt);
}

void SetHolz()
{
        i--;
        if(!i) remove();
}
