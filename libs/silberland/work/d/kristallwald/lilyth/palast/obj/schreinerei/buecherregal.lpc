#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/container";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleines Buecherregal");
//SetProp(P_LONG, --> siehe weiter unten

  AddDetail( ({ "holzbrett", "brett" }),
    "Das Regal besteht aus einem etwa einen halben Meter langen Brett aus "
    "hellem Buchenholz.");

  AddDetail( ({ "meter" }),
    "Das Buecherregal ist etwa einen halben Meter lang.");

  AddDetail( ({ "buchenholz", "holz" }),
    "Das Regal wurde aus hellem Buchenholz angefertigt.");

  AddDetail( ({ "enden", "holzleisten", "holzleiste", "leisten", "leiste",
  "ende" }),
    "Die beiden Enden des Holzbrettes sind mit schmalen Holzleisten "
    "versehen, die als Halt fuer die Buecher dienen sollen.");

  AddDetail( ({ "halt" }),
    "Die Holzleisten sorgen dafuer, dass die Buecher nicht aus dem Regal "
    "fallen.");

  AddDetail( ({ "buecher", "buch" }),
    "Wie der Name schon sagt, koennen in dem Regal Buecher aufbewahrt "
    "werden.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Buecherregal");
  SetProp(P_NAME_ADJ, "klein");
  AddAdjective( ({ "kleines" } ));
  SetProp(P_GENDER, NEUTER);
  AddId( ({"\nmoebel", "regal", "buecherregal", "\n_regal"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_BEECH);
  SetProp(P_WEIGHT, 5000);
  SetProp(P_VALUE, 950);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Behaeltereigenschaften-------------------------------------------------

  SetProp(P_CONTAINER, 1);
  SetProp(P_MAX_WEIGHT, 10000);
  SetProp(P_WEIGHT_PERCENT, 33);
  SetProp(P_TRANSPARENT, 0);

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

string getName(object obj)
{
  return obj->name();
}

//Langbeschreibung:
string _query_long()
{
  int i;
  string txt;
  string s;
  string t;
  string *buecher;
  object *buch;
  buch = all_inventory(TO);
  buch = filter_objects(buch,"id","\nbuch");

   switch(sizeof(buch))
   {
      case 0:
        s = "Es befinden sich momentan keine Buecher in dem Regal.\n";
        break;

      case 1:
        s = "Du siehst nur ein einziges Buch in dem Regal stehen: "
        +buch[0]->QueryProp(P_SHORT)+".\n";
        break;

      default:
        buecher = map_array(buch, #'getName);
        t = implode(buecher[0..<2], ", ") + " und " + buecher[<1];
        s = "Zur Zeit siehst Du "+t+" in dem Regal stehen.\n";

        break;
   }

   txt = "Das Buecherregal ist recht klein und ziemlich schlicht gehalten. "
   +"Eigentlich handelt es sich nur um ein einfaches Holzbrett, an dessen "
   +"Enden schmale Leisten angesetzt wurden, damit die darin "
   +"stehenden Buecher nicht umkippen und herunterfallen koennen.\n"+s;

   return break_string((txt), 78, 0, BS_LEAVE_MY_LFS);
}

//nur Buecher reinstellen:
varargs int PreventInsert(object ob)
{
        int i;
        string *mybuch;
        mybuch = ({ "\nbuch", "buch" });

        for(i = 0; i < sizeof(mybuch); i++)
        {
          if(ob->id(mybuch[i]))
          {
            return ::PreventInsert(ob);
          }
          else
          {
            return 1;
          }
        }
}
