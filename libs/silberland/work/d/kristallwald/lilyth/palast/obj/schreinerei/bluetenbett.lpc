#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

string name;
int bett;
int paralyze (int zeit, object player);

#define GEMACHT 1
#define UNGEMACHT 0

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  name = 0;
  bett = GEMACHT;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleines Bluetenbett");
//SetProp(P_LONG, --> siehe weiter unten

  AddDetail( ({ "bluete", "rosenbluete" }),
    "Das kleine Bett ist wie eine halb geoeffnete Bluete geformt worden.");

  AddDetail( ({ "holz" }),
    "Das Holz sieht sehr hell aus.");

  AddDetail( ({ "matratze" }),
    "Die Matratze ist sonnengelb und herrlich weich.");

  AddDetail( ({ "platz" }),
    "Fuer eine Fee ist das Bett ausreichend gross.");

  AddDetail( ({ "fee" }),
    "In dieses kleine Bett passt nur eine Fee hinein.");

  AddDetail( ({ "kissen" }),
    "Bunte Kissen polstern das kleine Bett weich aus. Sie sehen fast "
    "so aus wie echte Blumen.");

  AddDetail( ({ "blumen", "blume" }),
    "Die Kissen sehen wirklich sehr echt aus. Sie duften sogar nach "
    "frischen Blumen.");

  AddDetail( ({ "innere", "inneres" }),
    "Im Inneren des Bettes liegt eine winzige, sonnengelbe Matratze und "
    "ein paar bunte, bluetenfoermige Kissen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Bluetenbett");
  SetProp(P_NAME_ADJ, "klein");
  AddAdjective( ({ "kleines" } ));
  SetProp(P_GENDER, NEUTER);
  AddId( ({"\nmoebel", "bett", "bluetenbett", "\n_bett"}) );
//SetProp(P_INFO, "");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_ASH_WOOD);
  SetProp(P_WEIGHT, 6000);
  SetProp(P_VALUE, 925);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "lieg", "liege", "leg", "lege" }), "legen" );
  AddCmd( ({ "steh", "stehe" }), "aufstehen" );
  AddCmd( ({ "schuettle", "schuettel", "schuettl" }), "aufschuetteln" );
  AddCmd( ({ "stell", "stelle" }), "abstellen" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;
  
  txt = "Dieses winzige Bett ist wie eine halb geoeffnete Rosenbluete "
       +"geformt. Es ist kunstvoll aus hellem Holz geschnitzt worden. In "
       +"ihm liegt eine kleine, sonnengelbe Matratze, die gerade genug "
       +"Platz fuer eine Fee bietet. Bunte, blumenartige Kissen polstern "
       +"das Innere des Bettes weich aus.";

  //liegt jemand im Bett?
  if(name != 0)
  {
        if(TP->Name() == name)
        {
             txt += " Du hast es Dir darin gemuetlich gemacht.";
        }
        else
        {
             txt +=  " "+name+" hat es sich darin gemuetlich gemacht.";
        }
  }
  
  //ist das Bett nicht gemacht?
  if(bett == UNGEMACHT && name == 0)
  {
        txt += " Allerdings sind die Kissen ein wenig zerwuehlt. "
        +"Du koenntest sie mal wieder aufschuetteln.";
  }

  return BS(txt);
}

//reinlegen:
int legen(string str)
{
  mixed res;
  
  notify_fail("Wo moechtest Du Dich hineinlegen?\n");

  if(!str || str == "") return 0;

  if(!(str == "in bett" ||
       str == "in bluetenbett")) return 0;

  if(ENV(TO) != ENV(TP))
  {
      write(BS("Stell das Bett doch erstmal irgendwo ab."));
      return -1;
  }
  else
  {
    if(TP->QueryProp(P_RACE) == "Fee")
    {
      if(bett == UNGEMACHT)
      {
         write(BS("Nein, in so ein zerwuehltes Bett willst Du Dich nicht "
         +"legen."));
         return -1;
      }
      else
      {
         if(name == 0)
         {
   	    if(res=TP->QueryProp(P_TMP_MOVE_HOOK))
            {
              if ( pointerp(res) && sizeof(res) >= 3
                   && intp(res[0]) && time() < res[0]
                   && objectp(res[1]) && stringp(res[2]) )
              {
                if (res[1] == TO)
                {
                  notify_fail("Das geht jetzt gerade nicht. Du wirst schon "
                +"wissen, warum.\n");
                  return 0;
                }
                else
                {
                  notify_fail("Das geht jetzt gerade nicht. Du wirst schon "
                +"wissen, warum.\n");
                  return 0;
                }
              }
            }                
                
            write(break_string("Du kuschelst Dich in das kleine Bettchen "
            +"hinein. Hach, ist das herrlich!\nLaechelnd schliesst Du die "
            +"Augen und traeumst ein wenig vor Dich hin.\n",
            78, 0, BS_LEAVE_MY_LFS));

            ENV(TP)->Message(BS(TP->Name(WER, 1)+" kuschelt sich in das "
            +"kleine Bett hinein."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
            name = TP->Name(WER);
            
            paralyze (999, TP);
            call_out("seqbett", 900, TP);
            return 1;
         }
         else
         {
            if(TP->Name() == name)
            {
                write(BS("Aber Du liegst doch bereits in dem Bett."));
            }
            else
            {
                write(BS("Aber "+name+" liegt doch gerade in dem Bett."));
            }
           
            return -1;
         }
      }
    }
    else
    {
        write(BS("Das Bett ist leider viel zu klein fuer Dich."));
        return -1;
    }
  }
}

void seqbett(object player)
{
    mixed res;
    
    if(player)
    {
       tell_object(player, "Es wird Dir allmaehlich zu langweilig im Bett "
       +"und Du stehst wieder auf.\n");

       ENV(TO)->Message(BS(player->Name(WER)+" reibt sich die Aeuglein, "
       +"gaehnt noch einmal ausgiebig und erhebt sich dann aus dem kleinen "
       +"Bluetenbett.\n"),
       MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

       if(res=player->QueryProp(P_TMP_MOVE_HOOK))
       {
           if ( pointerp(res) && sizeof(res) >= 3
                && intp(res[0]) && time() < res[0]
                && objectp(res[1]) && stringp(res[2]) )
           {
                if (res[1] == TO)
                {
                     player->SetProp(P_TMP_MOVE_HOOK, 0);
                     if(find_call_out("seqbett") != -1)
                     remove_call_out("seqbett");
                }
           }
       }
    }

    name = 0;
    bett = UNGEMACHT;
    return;
}

void BecomesNetDead(object player)
{
  mixed res;

  if(player && player->name() == name)
  {
    ENV(TO)->Message(BS(player->Name(WER)+" purzelt aus dem Bett heraus.\n"),
    MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

    if(res=player->QueryProp(P_TMP_MOVE_HOOK))
    {
        if ( pointerp(res) && sizeof(res) >= 3
             && intp(res[0]) && time() < res[0]
             && objectp(res[1]) && stringp(res[2]) )
        {
             if (res[1] == TO)
             {
                  player->SetProp(P_TMP_MOVE_HOOK, 0);
                  if (find_call_out("seqbett") != -1)
                     remove_call_out("seqbett");
             }
       }
    }
    bett = UNGEMACHT;
    name = 0;
    return;
  }
}

void NotifyPlayerDeath(object player, object killer, int lost_xp)
{
  mixed res;

  if(player && player->name() == name)
  {
    ENV(TO)->Message(BS(player->Name(WER)+" purzelt aus dem Bett heraus.\n"),
    MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

    if(res=player->QueryProp(P_TMP_MOVE_HOOK))
    {
        if ( pointerp(res) && sizeof(res) >= 3
             && intp(res[0]) && time() < res[0]
             && objectp(res[1]) && stringp(res[2]) )
        {
             if (res[1] == TO)
             {
                  player->SetProp(P_TMP_MOVE_HOOK, 0);
                  if (find_call_out("seqbett") != -1)
                     remove_call_out("seqbett");
              }
        }
    }

    bett = UNGEMACHT;
    name = 0;
    return;
  }
}

int aufstehen(string str)
{
  mixed res;
  
  notify_fail("Was willst Du tun?\n");

  if(!str || str == "") return 0;

  if(!(str == "aus bett auf" ||
       str == "aus bluetenbett auf" ||
       str == "auf")) return 0;

  if(TP->Name() == name)
  {
     write(BS("Seufzend reibst Du Dir die Aeuglein, gaehnst noch einmal "
     +"ausgiebig und stehst dann mit leisem Bedauern wieder auf. Dabei war "
     +"es doch gerade so herrlich gemuetlich."));

     ENV(TP)->Message(BS(TP->Name(WER, 1)+" reibt sich die Aeuglein, gaehnt "
     +"noch einmal ausgiebig und erhebt sich dann aus dem kleinen "
     +"Bluetenbett."),
     MSGFLAG_VISUAL|MSGFLAG_NO_TP);
     name = 0;
     bett = UNGEMACHT;

     if(res=TP->QueryProp(P_TMP_MOVE_HOOK))
     {
         if ( pointerp(res) && sizeof(res) >= 3
              && intp(res[0]) && time() < res[0]
              && objectp(res[1]) && stringp(res[2]) )
         {
              if (res[1] == TO)
              {
                   TP->SetProp(P_TMP_MOVE_HOOK, 0);
                   if(find_call_out("seqbett") != -1)
                   remove_call_out("seqbett");
              }
         }
     }

     return 1;
  }
  else
  {
     write(BS("Aber Du liegst doch gar nicht in dem Bett."));
     return -1;
  }
}

int aufschuetteln(string str)
{
  notify_fail("Was willst Du aufschuetteln?\n");

  if(!str || str == "") return 0;

  if(!(str == "kissen" ||
       str == "kissen auf" ||
       str == "kissen aus")) return 0;

  if(name != 0)
  {
      if(TP->Name() == name)
      {
          write(BS("Aber Du liegst doch gerade so gemuetlich im Bett. "
          +"Wenn Du die Kissen aufschuetteln willst, solltest Du erstmal "
          +"wieder aufstehen."));
      }
      else
      {
          write(BS("Das geht jetzt nicht, "+name+" liegt doch noch im "
          +"Bett!"));
      }
      return -1;
  }
  else
  {
       if(bett == UNGEMACHT)
       {
            write(BS("Du schuettelst die Kissen kraeftig aus und glaettest "
            +"auch das Laken ein wenig. So, jetzt ist alles wieder schoen "
            +"ordentlich, wie es sich gehoert."));

            ENV(TP)->Message(BS(TP->Name(WER, 1)+" richtet das Bett wieder "
            +"ordentlich her."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
            bett = GEMACHT;
            return 1;
       }
       else
       {
            write(break_string("Die Kissen sind bereits ordentlich "
            +"aufgeschuettelt worden.\nDu scheinst einen guten Hauswicht zu "
            +"haben. :)\n", 78, 0, BS_LEAVE_MY_LFS));
            return -1;
       }
   }
}

//Funktion zum Festhalten beim Liegen
int paralyze (int zeit, object player)
{
  if (objectp(player))
     player->SetProp(P_TMP_MOVE_HOOK, ({time()+zeit, TO, 
     "freeze_in_place"}) );
}

//Hilfsfunktion fuer Move_Hook
string freeze_in_place()
{
  return "Das geht jetzt gerade nicht. Du wirst schon wissen, warum.\n";
}

//Bett abstellen:
int abstellen(string str)
{
  notify_fail("Was willst Du abstellen?\n");

  if(!str || str == "") return 0;

  if(!(str == "bett ab" ||
       str == "bluetenbett ab")) return 0;

  if(ENV(TO) != TP)
  {
        write(BS("Aber Du traegst das Bett doch gar nicht mehr bei Dir!"));
        return -1;
  }
  else
  {
        write(BS("Du stellst das kleine Bluetenbett ab."));

        ENV(TP)->Message(BS(TP->Name(WER, 1)+" stellt ein kleines Bett ab."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        
        move(ENV(TP), M_SILENT); 
        return 1;
  }
}

//wenn jemand versucht, das Bett zu nehmen, und es liegt wer drin
varargs int move(mixed dest,int method)
{
  if(objectp(dest))
  {
    if(name != 0)
    {
       write(BS("Aber es liegt doch noch jemand im Bett!\n"));
       return ME_CANT_LEAVE_ENV;
    }
  }
  return ::move(dest, method);
}
