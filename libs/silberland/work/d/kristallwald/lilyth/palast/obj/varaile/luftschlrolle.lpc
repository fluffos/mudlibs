#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

int i; //Zaehlvariable fuer Roellchen

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  i = 5;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Rolle Luftschlangen");
  //Long siehe weiter unten

  AddDetail( ({ "farben", "farbe" }),
    "Die enthaltenen Luftschlangen haben verschiedene Farben.");

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "Nun, was koennte man mit Luftschlangen wohl machen?");
  SetProp(P_NAME, "Rolle Luftschlangen");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"luftschlangen", "rolle", "schlangen"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_PAPER);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 20);

//--Kommandos-------------------------------------------------------------

  AddCmd( ({ "wirf", "werf", "werfe" }), "werfen" );

//--Create Ende-----------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;

  if(i == 1)
  {
      txt = "Eine kleine, runde Rolle mit bunten Luftschlangen in den "
            "verschiedensten Farben. Sie enthaelt noch eine einzige "
            "Luftschlange, die nur darauf wartet, geworfen zu werden.";
  }
  else
  {
      txt = "Eine kleine, runde Rolle mit bunten Luftschlangen in den "
            "verschiedensten Farben. Sie enthaelt noch "+i+" Luftschlangen, "
            "die nur darauf warten, geworfen zu werden. ";
  }
  
  return BS(txt);
}

int werfen(string str)
{
  object myschlange;
    
  notify_fail("Was moechtest Du in die Luft werfen?\n");

  if(!str || str == "") return 0;

  if(!(str == "luftschlangen" ||
       str == "luftschlange" ||
       str == "mit luftschlangen" ||
       str == "mit luftschlange" ||
       str == "luftschlangen in luft" ||
       str == "luftschlange in luft")) return 0;

  if(i > 1)
  {
      myschlange = clone_object(OBJ "/varaile/luftschlange");
      
      write(BS("Du nimmst eine der Luftschlangen aus der Rolle und "
      +"wirfst sie hoch in die Luft. Hurra!!!"));
           
      ENV(TP)->Message(BS(TP->Name(WER, 1)+" wirft eine Luftschlange "
      +"in die Luft. Hurra!!!"),  	       
      MSGFLAG_VISUAL|MSGFLAG_NO_TP);

      myschlange->move(ENV(TP), M_PUT|M_SILENT);
      i--;
      return 1;
  }
  
  if(i == 1)
  {
      myschlange = clone_object(OBJ "/varaile/luftschlange");
      
      write(BS("Du nimmst die letzte Luftschlange aus der Rolle, entsorgst "
      +"die leere Rolle und wirfst die Luftschlange hoch in die Luft. "
      +"Hurra!!!"));
           
      ENV(TP)->Message(BS(TP->Name(WER, 1)+" wirft eine Luftschlange "
      +"in die Luft. Hurra!!!"),  	       
      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      
      myschlange->move(ENV(TP), M_PUT|M_SILENT);
      TO->remove();
      return 1;
  }
}
