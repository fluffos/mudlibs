#include "/d/kristallwald/lilyth/palast/def.h"
#include <food.h>
#include <properties.h>
#include <ansi.h>

inherit "/std/food";

//--Variablen&Defines------------------------------------------------------

string text;
string name;
int i; //Zaehler fuer Anzahl Essen

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  text = 0;
  name = 0;
  i = 3;
  
  switch(random(7))
  {
    case 1:
      text = "Viel Glueck!";
      break;
    case 2:
      text = "Hab Dich lieb!";
      break;
    case 3:
      text = "Ich denk an Dich!";
      break;
    case 4:
      text = "Danke!";
      break;
    case 5:
      text = "Alles Gute!";
      break;
    case 6:
      text = "Alles Liebe!";
      break;
    default:
      text = "Herzlichen Glueckwunsch!";
      break;
  }
  
//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein grosses Lebkuchenherz");
//SetProp(P_LONG, --> siehe unten

  AddDetail( ({ "lebkuchen" }),
    "Der Lebkuchen ist noch ganz frisch und warm.");

  AddDetail( ({ "zuckerguss", "guss" }),
    "Das grosse Lebkuchenherz ist mit farbigem Zuckerguss kunstvoll "
    "verziert worden.");

  AddDetail( ({ "herzchen", "zuckergussherz", "zuckergussherzchen" }),
    "Ein paar kleine, suesse Herzen aus buntem Zuckerguss sind auf das "
    "grosse Lebkuchenherz aufgesetzt worden.");

  AddSpecialDetail( ({ "zuckergussschrift", "schrift" }),
    "strschrift");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Lebkuchenherz");
  SetProp(P_NAME_ADJ, "gross");
  AddAdjective( ({ "grosses" } ));
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "herz", "lebkuchen", "lebkuchenherz" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "Du kannst es jemandem schenken.");
  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 35);
  SetProp(P_SMELL, "Es riecht herrlich nach frischem Lebkuchen.\n");

  SetProp (P_FOOD_INFO, ([
    F_MSG      : "Obwohl Du es fast zu schade zum essen findest, "
    "knabberst Du ein wenig an dem Lebkuchenherz herum. Mhhh, der frische "
    "Lebkuchen schmeckt einfach herrlich!\n",
    F_MSG_ROOM : "knabbert an einem grossen Lebkuchenherz herum.\n",
    F_VERB     : "essen" ]) );

//--Kommandos-------------------------------------------------------------

  AddCmd( ({ "schenk", "schenke" }), "schenken" );
  
//--Create Ende------------------------------------------------------------

}

//-------------------------------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;

  //wurde das Herz verschenkt oder nicht?
  if(name == 0)
  {
        txt = "Dieses grosse Lebkuchenherz ist eigentlich viel zu schade, "
        +"um es aufzuessen. ";
  }
  else
  {
        txt = "Dieses grosse Lebkuchenherz hat Dir "+name
        +"geschenkt. Eigentlich ist es viel zu schade, um es "
        +"aufzuessen. ";
  }

  txt += "Es wurde aus dunkelbraunem Lebkuchen gebacken, der frisch "
    "und sogar noch ein wenig warm ist. Es ist kunstvoll mit farbigem "
    "Zuckerguss verziert und mit kleinen, bunten Herzchen versehen worden. "
    "In roter Zuckergussschrift steht etwas auf ihm geschrieben. ";

  return BS(txt);
}

//Detail Schrift:
string strschrift(string str)
{
  string s;

  s = "Auf dem Lebkuchenherz steht in roter Zuckergussschrift: "
  +"\n\n                "+ANSI_RED+text+ANSI_NORMAL+"\n\n";
      
  return break_string(s, 78, 0, BS_LEAVE_MY_LFS);
}

//--Funktionen-------------------------------------------------------------

int schenken(string str)
{
  string wer, was;
  object player;

  notify_fail("Wem moechtest Du das Lebkuchenherz schenken?\n");

  if(!str || str == "")
  {
        return (notify_fail ("WEM moechtest Du WAS schenken?\n"),0);
  }

       //Syntaxcheck
       if( sscanf(str, "%s %s", wer, was) == 2 && id(was) )
       {
        player = find_player(wer);

          //Spieler ist nicht eingelogt
          if(!player)
          {
                write(BS("Aber "+CAP(wer)+" ist doch gar nicht anwesend."));
                return -1;
          }

          //Spieler ist nicht im gleichen Raum
          if(ENV(TP) != ENV(player))
          {
                write(BS("Aber "+player->name(WER, 1)+" ist doch gar nicht "
                +"hier!"));
                return -1;
          }

          //Herz ist zu schwer
          if(ME_TOO_HEAVY == this_object()->move(player,M_GET|M_SILENT))
          {
                write(BS(player->Name(WER, 1)+" kann das Lebkuchenherz "
                +"leider nicht mehr tragen, daher behaeltst Du es vorerst "
                +"lieber."));
                return -1;
          }
          else
          {
                //Schenken klappt
                write(BS("Du schenkst "+player->Name()+" das grosse "
                +"Lebkuchenherz."));

                tell_object(player,BS(TP->Name(WER)+" schenkt Dir ein "
                +"grosses Lebkuchenherz."));

                tell_room(ENV(TP),BS(TP->Name()+" schenkt "+player->Name()
                +" ein Lebkuchenherz."), ({ TP, player }));

                name = TP->Name(WER);
                return 1;
          }
       }
       return 0;
}

int second_life(object player)
{
     i--;
     
     if(!i)
     {
        tell_object(player, BS("Enttaeuscht bemerkst Du, dass Du das ganze "
        "schoene Lebkuchenherz nun restlos aufgefuttert hast. :("));
     }
     return i;
}
