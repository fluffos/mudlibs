#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

string besitzer;
string name;

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  besitzer = 0;
  name = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein rosa Plueschhase");
//SetProp(P_LONG, --> siehe unten

  AddDetail( ({ "pluesch" }),
    "Der kleine Hase besteht aus kuscheligem rosa Pluesch.");

  AddDetail( ({ "knopfaugen", "augen", "knopfauge", "auge" }),
    "Mit seinen kleinen, dunklen Knopfaugen schaut der kleine Plueschhase "
    "vertrauensvoll zu Dir auf. Er scheint Dich wohl zu moegen.");

  AddDetail( ({ "ohren", "hasenohren", "ohr", "hasenohr" }),
    "Der kleine Hase hat lange, flauschige Hasenohren, die fast so gross "
    "sind wie er selbst.");

  AddSpecialDetail( ({ "besitzer" }),
    "strbesitzer");

  AddSpecialDetail( ({ "name", "namen" }),
    "strnamen");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Plueschhase");
  SetProp(P_NAME_ADJ, "rosafarben");
  AddAdjective( ({ "rosa", "rosafarbener", "rosafarbenes" } ));
  SetProp(P_GENDER, MALE);
  AddId( ({ "hase", "plueschhase" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "Du kannst Deinem rosa Plueschhasen einen Namen geben "
  "(taufe hase <name>), mit ihm kuscheln, ihn knuddeln, wuscheln und "
  "an Dich druecken und Dich auch mal bei ihm ausweinen, wenn Du traurig "
  "bist. Du kannst ihn aber auch an jemanden verschenken, dem Du eine "
  "Freude machen willst.\n");
  SetProp(P_MATERIAL, MAT_COTTON);
  SetProp(P_WEIGHT, 100);
  SetProp(P_SIZE, 27);
  SetProp(P_VALUE, 125);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "schenk", "schenke" }), "schenken" );
  AddCmd( ({ "tauf", "taufe" }), "taufen" );
  AddCmd( ({ "knuddel", "knuddl", "knuddle", "knuddele" }), "knuddeln" );
  AddCmd( ({ "drueck", "druecke" }), "druecken" );
  AddCmd( ({ "wein", "weine" }), "weinen" );
  AddCmd( ({ "kuschl", "kuschle", "kuschel", "kuschele" }), "kuscheln" );
  AddCmd( ({ "wuschl", "wuschle", "wuschel", "wuschele" }), "wuscheln" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen----------------------------------------------------------

//Kurzbeschreibung:
string _query_short()
{
  string s;

  s = "Ein rosa Plueschhase";

  if(besitzer != 0 && name != 0)
  {
        s =  name+", der Plueschhase von "+besitzer;
  }
  return s;
}

//Langbeschreibung:
string _query_long()
{
  string txt;

  txt = "Dieser kleine suesse Plueschhase besteht vollstaendig aus weichem, "
    "kuscheligen rosa Pluesch. Seine langen Hasenohren sind fast genauso "
    "gross wie er selbst und herrlich weich. Mit seinen kleinen dunklen "
    "Knopfaugen blickt er Dich treuherzig an. ";

  //gehoert der Hase jemandem?
  if(besitzer == 0)
  {
        txt +=  "Anscheinend hat er noch gar keinen richtigen Besitzer, "
        +"denn er sieht ein wenig einsam aus.\n";
  }

  if(besitzer != 0 && name != 0)
  {
        txt +=  "Er heisst "+name+" und gehoert "+besitzer+".\n";
  }
  return BS(txt);
}

string strbesitzer(string str)
{
  string s;

  if(besitzer == 0)
  {
  	s = "Vielleicht kannst Du ja sein neuer Besitzer werden. Dann "
  	+"solltest Du dem kleinen Hasen aber zuallerst mal einen Namen "
  	+"geben.";
  }
  else
  {
  	s = "Der kleine Plueschhase gehoert "+besitzer+".";
  }
  return BS(s);
}

string strnamen(string str)
{
  string s;

  if(name == 0)
  {
  	s = "Der kleine Plueschhase hat noch gar keinen Namen.";
  }
  else
  {
  	s = "Der kleine Plueschhase heisst "+name+".";
  }
  return BS(s);
}

//den Hasen jmd. schenken
int schenken(string str)
{
  string wer, was;
  object player;

  notify_fail("Wem moechtest Du den Plueschhasen schenken?\n");

  if(!str || str == "")
  {
        return (notify_fail ("WEM moechtest Du WAS schenken?\n"),0);
  }

  //Syntaxcheck
  if(sscanf(str, "%s %s", wer, was) == 2 && id(was))
  {
      if(TP->Name() == besitzer || !besitzer)
      {
          player = find_player(wer);

          //Spieler ist nicht eingelogt
          if(!player)
          {
              write(BS("Aber "+CAP(wer)+" ist doch gar nicht anwesend."));
              return -1;
          }

          //Spieler ist nicht im gleichen Raum
          if(ENV(TP) != ENV(player))
          {
              write(BS("Aber "+player->name(WER, 1)+" ist doch gar nicht "
              +"hier!"));
              return -1;
          }

          //der Hase ist zu schwer
          if(ME_TOO_HEAVY == this_object()->move(player,M_GET|M_SILENT))
          {
              write(BS(player->Name(WER, 1)+" kann den Plueschhasen "
              +"leider nicht mehr tragen, daher behaeltst Du ihn lieber."));
              return -1;
          }
          else
          {
              //Schenken klappt
              write(BS("Du schenkst "+player->Name()+" den rosa "
              +"Plueschhasen."));

              tell_object(player,BS(TP->Name(WER)+" schenkt Dir einen "
              +"rosa Plueschhasen."));
  
              tell_room(ENV(TP),BS(TP->Name()+" schenkt "+player->Name()
              +" einen rosa Plueschhasen."), ({ TP, player }));

              besitzer = player->Name(WER);
              return 1;
          }
     }
     else
     {
          write(BS("Aber der rosa Plueschhase gehoert Dir doch gar nicht!"));
          return -1;
     }
  }
  return 0;
}

//dem Hasen einen Namen geben
int taufen(string str)
{
  string wer, was;
  
  notify_fail("Wen oder was moechtest Du wie taufen?\n"
  +"(Syntaxhilfe: taufe hase <name>)\n");

  if(!str || str == "") return 0;

  if( sscanf(str, "%s %s", wer, was) == 2 && id(wer) )
  {
     if(TP->Name() == besitzer || !besitzer)
     {
         if(!name)
         {
             name = capitalize(was);
             
             write(BS("Du taufst Deinen rosa Plueschhasen auf den "
             +"Namen "+name+"."));
             
             ENV(TP)->Message(BS(TP->Name(WER, 1)+" tauft "
  	     +(TP->QueryProp(P_GENDER) == MALE ? "seinen": "ihren")+" "
  	     +"rosa Plueschhasen auf den Namen "+name+"."),  	       
  	     MSGFLAG_VISUAL|MSGFLAG_NO_TP);
             
             besitzer = TP->Name(WER);
             AddId(was);
             return 1;
         }
         else
         {
             write(BS("Aber Dein rosa Plueschhase hat doch schon einen "
             +"Namen."));
             return -1;
         }
     }
     else
     {
        write(BS("Aber der rosa Plueschhase gehoert Dir doch gar nicht!"));
        return -1;
     }
  }
}

//knuddeln:
int knuddeln(string str)
{
  notify_fail("Wen moechtest Du knuddeln?\n");

  if(!str || str == "") return 0;

  if(!id(str)) return 0;

  write(break_string("Du knuddelst Deinen rosa Plueschhasen liebevoll.\n"
  +"Der kleine Hase strahlt vor Freude und knuddelt Dich froehlich "
  +"zurueck.\n", 78, 0, BS_LEAVE_MY_LFS));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" knuddelt "
  +(TP->QueryProp(P_GENDER) == MALE ? "seinen": "ihren")+" rosa "
  +"Plueschhasen liebevoll."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

//druecken:
int druecken(string str)
{
  notify_fail("Wen willst Du an Dich druecken?\n");

  if(!str || str == "") return 0;

  if(!id(str)) return 0;

  write(break_string("Du drueckst Deinen rosa Plueschhasen fest an Dich.\n"
  +"Uebergluecklich schmiegt sich der kleine Hase an Dich an.",
  78, 0, BS_LEAVE_MY_LFS));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" drueckt "
  +(TP->QueryProp(P_GENDER) == MALE ? "seinen": "ihren")+" rosa "
  +"Plueschhasen fest an sich."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

//knuddeln:
int weinen(string str)
{
  notify_fail("Bei wem willst Du Dich ausweinen?\n");

  if(!str || str == "") return 0;

  if(!id(str)) return 0;

  write(break_string("Du weinst Dich bei Deinem rosa Plueschhasen aus.\n"
  +"Troestend kuschelt sich der kleine Hase an Dich an und fluestert "
  +"Dir ein paar aufmunternde Worte ins Ohr.",
  78, 0, BS_LEAVE_MY_LFS));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" weint sich bei "
  +(TP->QueryProp(P_GENDER) == MALE ? "seinem": "ihrem")+" rosa "
  +"Plueschhasen aus."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

//druecken:
int kuscheln(string str)
{
  notify_fail("An wen willst Du Dich ankuscheln?\n");

  if(!str || str == "") return 0;

  if(!id(str)) return 0;

  write(break_string("Du kuschelst Dich an Deinen rosa Plueschhasen an.\n"
  +"Erfreut wackelt der kleine Hase mit seinen langen Plueschohren.\n", 
  78, 0, BS_LEAVE_MY_LFS));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" kuschelt sich an "
  +(TP->QueryProp(P_GENDER) == MALE ? "seinen": "ihren")+" rosa "
  +"Plueschhasen an."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

//wuscheln:
int wuscheln(string str)
{
  notify_fail("Wen willst Du denn wuscheln?\n");

  if(!str || str == "") return 0;

  if(!id(str)) return 0;

  write(break_string("Du zerzaust Deinem rosa Plueschhasen liebevoll die "
  +"langen Hasenohren.\nDer kleine Hase quietscht vergnuegt auf und "
  +"strahlt Dich froehlich an.\n",
  78, 0, BS_LEAVE_MY_LFS));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" zerzaust "
  +(TP->QueryProp(P_GENDER) == MALE ? "seinem": "ihrem")+" rosa "
  +"Plueschhasen liebevoll die langen Hasenohren."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}
