#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

int i;

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  i = 6;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine grosse Eistorte");
  SetProp(P_LONG,
    "Diese grosse Eistorte sieht einfach absolut phantastisch aus. Sie "
    "besteht fast vollstaendig aus halbgefrorenem, leckeren Eis und ist mit "
    "viel Sahne, kleinen Schokostueckchen und bunten Streuseln verziert. "
    "Sie sieht zum Reinbeissen lecker aus. Dennoch solltest Du schoen "
    "ordentlich ein Stueck nach dem anderen abschneiden, wenn Du sie "
    "wirklich geniessen willst.");

  AddDetail( ({ "eis", "teil" }),
    "Die Eistorte besteht zum groessten Teil aus leckerem Eis.");

  AddDetail( ({ "sahne", "sahnetupferl", "tupferl" }),
    "Kleine, lustige Sahnetupferl verzieren die Eistorte.");

  AddDetail( ({ "schokostueckchen", "stueckchen", "schokoladenstuecke", 
  "stuecke", "streusel" }),
    "Kleine, kunstvoll geformte Schokoladenstuecke und bunte Streusel "
    "verzieren die Torte.");

  AddDetail( ({ "reinbeissen" }),
    "Am liebsten wuerdest Du die ganze Torte auf einmal auffuttern.");

  AddDetail( ({ "stueck" }),
    "Schneide doch einfach ein Stueck ab, wenn Du die Torte probieren "
    "willst.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Eistorte");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, "gross");
  AddAdjective( ({ "grosse" } ));
  AddId( ({"torte", "eistorte"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_ICE: 50, MAT_MISC_FOOD: 50 ]));
  SetProp(P_WEIGHT, 60);
  SetProp(P_VALUE, 170);

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "schneid", "schneide" }), "schneiden" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

int schneiden(string str)
{
  object mytorte;
  
  notify_fail("Wovon willst Du ein Stueck abschneiden?\n");

  if(!str || str == "") return 0;

  if(str == "torte" ||
     str == "eistorte" ||
     str == "stueck von torte ab" ||
     str == "stueck von eistorte ab" ||
     str == "tortenstueck ab" ||
     str == "eistortenstueck ab" ||
     str == "ein stueck von torte ab" ||
     str == "ein stueck von eistorte ab" ||
     str == "ein tortenstueck ab" ||
     str == "ein eistortenstueck ab" ||
     str == "stueck ab" )
  {
     if(i >= 2)
     {
  	write(BS("Vorsichtig schneidest Du ein grosses Stueck von der "
  	+"Eistorte ab."));

  	ENV(TP)->Message(BS(TP->Name(WER, 1)+" schneidet vorsichtig ein "
  	+"grosses Stueck Eistorte ab."),
  	MSGFLAG_VISUAL|MSGFLAG_NO_TP);  	
  	
        mytorte = clone_object(OBJ "konditorei/tortenstueck");
  	        
  	if(ME_TOO_HEAVY == mytorte->move(TP,M_GET|M_SILENT))
        {
            mytorte->move(ENV(TP), M_PUT|M_SILENT);

            write(BS("Da Du das Stueck Eistorte nicht mehr tragen kannst,"
            +"legst Du es vorsichtig auf dem Boden ab."));
            
            ENV(TP)->Message(BS(TP->Name(WER, 1)+" legt ein "
            +"Tortenstueck auf dem Boden ab."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
            return -1;
        }

        i--;
        return 1;
     }
        
     if(i == 1)
     {
  	write(BS("Vorsichtig schneidest Du das letzte Stueck "
  	+"Eistorte ab."));

  	ENV(TP)->Message(BS(TP->Name(WER, 1)+" schneidet vorsichtig ein "
  	+"grosses Stueck Eistorte ab."),
  	MSGFLAG_VISUAL|MSGFLAG_NO_TP);  	

        mytorte = clone_object(OBJ "konditorei/tortenstueck");
  	        
  	if(ME_TOO_HEAVY == mytorte->move(TP,M_GET|M_SILENT))
        {
            mytorte->move(ENV(TP), M_PUT|M_SILENT);

            write(BS("Da Du das Stueck Eistorte nicht mehr tragen kannst, "
            +"legst Du es vorsichtig auf dem Boden ab."));
            
            ENV(TP)->Message(BS(TP->Name(WER, 1)+" legt ein "
            +"Tortenstueck auf dem Boden ab."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
            return -1;
        }
        
        TO->remove();
        return 1;
     }
  }
}
