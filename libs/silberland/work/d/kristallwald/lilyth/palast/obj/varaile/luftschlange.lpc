#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

string farbe;

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  switch(random(9))
  {
    case 1:
      farbe = "kanarienvogelgelb";
      AddAdjective( ({ "kanarienvogelgelbe" }) );
      break;
    case 2:
      farbe = "grasgruengetupft";
      AddAdjective( ({ "grasgruengetupfte" }) );
      break;
    case 3:
      farbe = "rotblaugestreift";
      AddAdjective( ({ "rotblaugestreifte" }) );
      break;
    case 4:
      farbe = "blaugruengeringelt";
      AddAdjective( ({ "blaugruengeringelte" }) );
      break;
    case 5:
      farbe = "rosarotgebluemt";
      AddAdjective( ({ "rosarotgebluemte" }) );
      break;
    case 6:
      farbe = "orangegruen";
      AddAdjective( ({ "orangegruene" }) );
      break;
    case 7:
      farbe = "meerwasserblau";
      AddAdjective( ({ "meerwasserblaue" }) );
      break;
    case 8:
      farbe = "pastellgruen";
      AddAdjective( ({ "pastellgruene" }) );
      break;
    default:
      farbe = "lilagruengepunktet";
      AddAdjective( ({ "lilagruengepunktete" }) );
      break;
  }

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine "+farbe+"e Luftschlange");
  SetProp(P_LONG, "Eine kleine, halb zusammengerollte Luftschlange. "
  "Anscheinend hat hier jemand ein rauschendes Fest gefeiert.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Luftschlange");
  SetProp(P_NAME_ADJ, ({ farbe }));
  SetProp(P_GENDER, FEMALE);
  AddId( ({"luftschlange", "schlange"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_PAPER);
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 3);

//--Create Ende-----------------------------------------------------------

}
