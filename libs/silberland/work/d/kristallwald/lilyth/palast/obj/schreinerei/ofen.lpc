#include "/d/kristallwald/lilyth/palast/def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------

int feuer;
int klappe;
int holz_in_ofen;

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  feuer = AUS;
  klappe = ZU;
  holz_in_ofen = NEIN;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleiner Holzofen");
//SetProp(P_LONG, --> siehe unten

  AddDetail( ({ "brennholz", "holz" }),
    "Hast Du welches? Falls nicht, solltest Du mal Fredolin danach fragen.");

  AddDetail( ({ "fredolin" }),
    "Fredolin ist der Schreiner im Palast der Voelker. Er hat diesen "
    "Ofen angefertigt und kann Dir sicherlich auch mit Brennholz "
    "weiterhelfen.");

  AddDetail( ({ "schreiner" }),
    "Fredolin hat diesen Ofen gebaut.");

  AddDetail( ({ "palast", "palast der voelker" }),
    "Du weisst doch bestimmt, wo das ist, oder?");

  AddSpecialDetail( ({ "feuer" }),
    "strfeuer");

  AddSpecialDetail( ({ "waerme", "gemuetlichkeit" }),
    "strwaerme");

  AddSpecialDetail( ({ "klappe", "ofenklappe" }),
    "strklappe");

  AddSpecialDetail( ({ "holzscheite", "scheite", "inneres", "inneren" }),
    "strscheite");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Holzofen");
  SetProp(P_NAME_ADJ, "klein");
  AddAdjective( ({ "kleiner", "kleinen" } ));
  SetProp(P_GENDER, MALE);
  AddId( ({ "holzofen", "ofen", "\n_sonstige" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "Wenn Du Brennholz hast, kannst Du in diesem Ofen ein "
  "Feuer entfachen und damit zum Beispiel Dein Seherhaus ein wenig "
  "gemuetlicher gestalten.");
  SetProp(P_MATERIAL, ([MAT_MISC_METAL: 75, MAT_GLASS: 25]) );
  SetProp(P_WEIGHT, 9000);
  SetProp(P_VALUE, 1150);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
  
  SetProp(P_MAX_WEIGHT, 9000);
  SetProp(P_WEIGHT_PERCENT, 35);
  SetProp(P_TRANSPARENT, 0);

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "entfach", "entfache" }), "entfachen" );
  AddCmd( ({ "loesch", "loesche" }), "loeschen" );
  AddCmd( ({ "oeffne" }), "oeffnen" );
  AddCmd( ({ "schliess", "schliesse" }), "schliessen" );
  AddCmd( ({ "leg", "lege" }), "legen" );
  AddCmd( ({ "stell", "stelle" }), "abstellen" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_long()
{
  string txt;
  string f;
  string k;
  string h;
  
  //Feuer an oder aus?
  if(feuer == AN)
  {
       f = "das gerade in ihm brennt";
  }
  else
  {
       f = "wenn eines in ihm brennt";
  }
  
  //Klappe auf oder zu?
  if(klappe == AUF)
  {
       k = "gerade geoeffnet";
  }
  else
  {
       k = "geschlossen";
  }

  //Holz drin oder nicht?
  if(holz_in_ofen == JA)
  {
       if(klappe == AUF)
       {
            h = " und im Inneren des Ofens kannst Du ein paar Holzscheite "
               +"erkennen";
       }
       else
       {
            h = "";
       }
  }
  else
  {
       h = "";
  }

  txt = "Der kleine Holzofen dient dazu, ein Feuer in ihm zu entfachen. "
       +"Er besitzt eine kleine, durchsichtige Klappe, durch die Du das "
       +"Feuer sehen kannst, "+f+". Ausserdem kann man durch sie das "
       +"Brennholz in den Ofen hineinlegen. Die Ofenklappe ist "+k+""+h+".";

  return BS(txt);
}


string strfeuer(string str)
{
  string s;

  if(feuer == AN)
  {
  	s = "Ein kleines Feuer brennt in dem Ofen und erfuellt den Raum "
  	+"mit angenehmer Waerme und Gemuetlichkeit.";
  }
  else
  {
  	s = "Es brennt gerade kein Feuer im Ofen.";
  }
  return BS(s);
}

string strwaerme(string str)
{
  string s;

  if(feuer == AN)
  {
  	s = "Es ist warm und gemuetlich hier.";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

string strklappe(string str)
{
  string s;

  if(klappe == AUF)
  {
  	s = "Die Klappe ist geoeffnet.";
  }
  else
  {
  	s = "Die Klappe ist geschlossen.";
  }
  return break_string(s, 78, 0, BS_LEAVE_MY_LFS);
}

string strscheite(string str)
{
  string s;

  if(holz_in_ofen == JA && klappe == AUF)
  {
  	s = "Ein paar Holzscheite liegen ordentlich uebereinandergestapelt "
  	+"in dem Holzofen.";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return break_string(s, 78, 0, BS_LEAVE_MY_LFS);
}

//-------------------------------------------------------------------------

//Feuer entfachen:
int entfachen(string str)
{
  notify_fail("Was willst Du wo entfachen?\n");

  if(!str || str == "") return 0;

  if(!(str == "feuer in ofen" ||
       str == "feuer im ofen" ||
       str == "feuer" ||
       str == "ein feuer in ofen" ||
       str == "ein feuer im ofen" ||
       str == "ein feuer")) return 0;

  if(ENV(TO) != ENV(TP))
  {
      write(BS("Stell den Ofen lieber erstmal irgendwo ab."));
      return -1;
  }
  else
  {
    if(feuer == AUS)
    {
      if(holz_in_ofen == JA)
      {
        write(break_string("Du entfachst ein kleines Feuer in dem "
        +"Holzofen.\nSogleich wird es angenehm warm und richtig gemuetlich.",
        78, 0, BS_LEAVE_MY_LFS));

        ENV(TP)->Message(break_string(TP->Name(WER, 1)+" entzuendet ein "
        +"kleines Feuer im Ofen.\nEs wird angenehm warm und richtig "
        +"gemuetlich.", 78, 0, BS_LEAVE_MY_LFS), 
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        feuer = AN;
        call_out("prasseln", 5);
        return 1;
      }
      else
      {
         write(BS("Um ein Feuer zu entfachen, musst Du zuerst Brennholz in "
         +"in den Ofen legen."));
         return -1;
      }
    }
    else
    {
     write(BS("Es brennt bereits ein Feuer im Ofen."));
     return -1;
    }
  }
}

//Feuer loeschen:
int loeschen(string str)
{
  notify_fail("Was willst Du loeschen?\n");

  if(!str || str == "") return 0;

  if(!(str == "feuer in ofen" ||
       str == "feuer im ofen" ||
       str == "feuer" ||
       str == "das feuer im ofen" ||
       str == "das feuer")) return 0;

  if(feuer == AN)
  {
     write(break_string("Du loeschst das Feuer sorgfaeltig wieder.\n"
     +"Sofort wird es ein wenig kuehler.", 78, 0, BS_LEAVE_MY_LFS));

     ENV(TP)->Message(break_string(TP->Name(WER, 1)+" loescht das Feuer "
     +"im Ofen.\nEs wird ein wenig kuehler.", 78, 0, BS_LEAVE_MY_LFS), 
     MSGFLAG_VISUAL|MSGFLAG_NO_TP);
     feuer = AUS;
     holz_in_ofen = NEIN;
     remove_call_out("prasseln");
     return 1;
  }
  else
  {
     write(BS("Aber es brennt doch gar kein Feuer im Ofen."));
     return -1;
  }
}

//Klappe oeffnen:
int oeffnen(string str)
{
  notify_fail("Was willst Du oeffnen?\n");

  if(!str || str == "") return 0;

  if(!(str == "klappe" ||
       str == "ofenklappe")) return 0;

  if(klappe == ZU)
  {
     write(BS("Du oeffnest die Klappe vom Ofen."));

     ENV(TP)->Message(BS(TP->Name(WER, 1)+" oeffnet die Klappe vom Ofen."), 
     MSGFLAG_VISUAL|MSGFLAG_NO_TP);
     klappe = AUF;
     return 1;
  }
  else
  {
     write(BS("Die Ofenklappe ist bereits geoeffnet."));
     return -1;
  }
}

//Klappe schliessen:
int schliessen(string str)
{
  notify_fail("Was willst Du schliessen?\n");

  if(!str || str == "") return 0;

  if(!(str == "klappe" ||
       str == "ofenklappe")) return 0;

  if(klappe == AUF)
  {
     write(BS("Du schliesst die Ofenklappe wieder."));

     ENV(TP)->Message(BS(TP->Name(WER, 1)+" schliesst die Ofenklappe "
     +"wieder."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
     klappe = ZU;
     return 1;
  }
  else
  {
     write(BS("Die Ofenklappe ist doch bereits geschlossen."));
     return -1;
  }
}

//Brennholz in Ofen legen:
int legen(string str)
{
  object myholz;
  
  notify_fail("Was willst Du wohin legen?\n");

  if(!str || str == "") return 0;

  if(!(str == "holz in ofen" ||
       str == "brennholz in ofen" ||
       str == "holzscheit in ofen" ||
       str == "holzscheite in ofen" ||
       str == "scheit in ofen" ||
       str == "scheite in ofen")) return 0;

  myholz = present("\nbrennholz", TP);
  if(!myholz) myholz = present("\nbrennholz", ENV(TO));

  if(ENV(TO) != ENV(TP))
  {
      write(BS("Stell den Ofen lieber erstmal irgendwo ab."));
      return -1;
  }
  else
  {
     if(myholz)
     {
        if(klappe == AUF)
        {
           if(feuer == AN)
           {
              write(BS("Du legst ein Holzscheit in das brennende Feuer, "
              +"das daraufhin kurz aufflackert."));
        
              TO->Message(break_string(TP->Name(WER, 1)+" legt ein "
              +"Holzscheit nach.\nDas Feuer im Ofen flackert kurz auf.", 
              78, 0, BS_LEAVE_MY_LFS), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
           
              myholz->SetHolz();
              holz_in_ofen = JA;
              return 1;
           }
           else
           {
              write(BS("Du legst ein Holzscheit in den Ofen."));
        
              TO->Message(BS(TP->Name(WER, 1)+" legt ein Holzscheit in den "
              +"Ofen."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
           
              myholz->SetHolz();
              holz_in_ofen = JA;
              return 1;
           }
        }
        else
        {
           write(BS("Du solltest zuerst die Ofenklappe oeffnen."));
           return -1;
        }
     }
     else
     {
        write(BS("Aber Du hast doch gar kein Brennholz bei Dir."));
        return -1;
     }
   }
}

//Ofen abstellen:
int abstellen(string str)
{
  notify_fail("Was willst Du abstellen?\n");

  if(!str || str == "") return 0;

  if(!(str == "ofen ab" ||
       str == "holzofen ab")) return 0;

  if(ENV(TO) != TP)
  {
        write(BS("Aber Du traegst den Ofen doch gar nicht bei Dir."));
        return -1;
  }
  else
  {
        write(BS("Du stellst den Holzofen auf dem Boden ab."));

        ENV(TP)->Message(BS(TP->Name(WER, 1)+" stellt einen Holzofen ab."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        
        move(ENV(TP), M_SILENT); 
        return 1;
  }
}

//wenn jemand versucht, den Ofen zu nehmen, waehrend ein Feuer darin brennt
varargs int move(mixed dest,int method)
{
  if(objectp(dest))
  {
    if(feuer == AN)
    {
       write(BS("Aber es brennt doch gerade ein Feuer im Ofen!"));
       return ME_CANT_LEAVE_ENV;
    }
  }
  return ::move(dest, method);
}

//"Roommessages", wenn das Feuer brennt
int prasseln()
{
   string txt;

   switch(random(3))
   {
    case 1:
      txt = "Das Feuer prasselt lustig vor sich hin.";
      break;
    case 2:
      txt = "Das Feuer knistert leise.";
      break;
    default:
      txt = "Eine angenehme Waerme erfuellt den Raum.";
      break;
   }
     
   if(find_call_out("prasseln") != -1)
   {
      return 0;
   }

   ENV(TO)->Message(BS(txt));

   call_out("prasseln", 5+random(25));
   return 1;
}
