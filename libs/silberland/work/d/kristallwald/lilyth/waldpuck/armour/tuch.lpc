#include "../def.h"

inherit "std/armour";

//--Variablen&Defines------------------------------------------------------

int binden_called;

//--Create-----------------------------------------------------------------

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein buntes Tuch");
  SetProp(P_LONG,
    "Dieses hauchduenne, in leuchtenden Farben gehaltene Tuch besteht "
    "aus feiner Seide. Es ist dazu gedacht, dass man es sich um die "
    "Huefte bindet und als eine Art Guertel traegt.");

  AddDetail( ({ "farbe", "farben" }),
    "Das Tuch ist in leuchtenden, bunten Farben gehalten. Es sieht wirklich "
    "sehr huebsch und zudem auch noch recht wertvoll aus.");

  AddDetail( ({ "seide" }),
    "Die Seide glaenzt und schillert in leuchtenden Farben.");

  AddDetail( ({ "huefte", "hueften" }),
    "Du kannst Dir das Tuch einfach um die Huefte binden.");

  AddDetail( ({ "art", "guertel" }),
    "Man traegt das Tuch wie einen Guertel um die Huefte.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Tuch");
  SetProp(P_NAME_ADJ, "bunt");
  AddAdjective( ({ "buntes", "bunten", "buntem" } ));
  SetProp(P_GENDER, NEUTER);
  AddId( ({"tuch", "seidentuch"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_SILK: 75, MAT_MISC_MAGIC: 25 ]));
  SetProp(P_WEIGHT, 70);
  SetProp(P_VALUE, 200);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_BELT);
  SetProp(P_AC, 3);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WORN_TEXT, "umgebunden");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "bind", "binde" }), "binden" );
  binden_called = 0;

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

int WearFunc(object me)
{
  if(binden_called)
  {
        binden_called = 0;
        return 1;
  }
  else
  {
        write(BS("So geht das leider nicht."));
        return 0;
  }
}

int binden(string str)
{
  notify_fail("Was willst Du Dir um- oder abbinden?\n");

  if(!str || str == "") return 0;

  if(str == "tuch um" ||
     str == "tuch um huefte" ||
     str == "tuch um hueften" )
  {
      if(QueryProp(P_WORN))
      {
          write(BS("Du hast Dir das Tuch doch bereits umgebunden."));
          return 0;
      }
      else
      {
          write(break_string("Du bindest Dir das bunte Tuch locker um die "
          +"Hueften.\nDas sieht aber schick aus. :)", 
          78, 0, BS_LEAVE_MY_LFS));
          binden_called = 1;
          DoWear(1,0);

  	  ENV(TP)->Message(BS(TP->Name(WER, 1)+" bindet sich ein Tuch "
  	  +"um die Hueften."),
  	  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
          return 1;
      }
  }
  
  if(str == "tuch ab" ||
     str == "tuch von huefte ab" ||
     str == "tuch von hueften ab" )
  {
      if(QueryProp(P_WORN))
      {
          write(BS("Du loest das bunte Tuch von Deinen Hueften und legst es "
          +"ordentlich zusammen."));
          binden_called = 1;
          DoUnwear(1,0);

  	  ENV(TP)->Message(BS(TP->Name(WER, 1)+" loest ein buntes Tuch von "
  	  +(PL->QueryProp(P_GENDER)==MALE?"seinen":"ihren")+" Hueften."),
  	  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  	  return 1;
      }
      else
      {
  	  write(BS("Aber Du hast das bunte Tuch doch gar nicht umgebunden."));
  	  return 0;
      }
  }

  return 0;
}
