#include "../def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Etwas Juckpulver");
  SetProp(P_LONG, "Eine kleine Tuete mit einer weisslichen Substanz darin, "
  "bei der es sich um Juckpulver zu handeln scheint. Hyara hat es "
  "hergestellt.");

  AddDetail( ({ "tuete", "papiertuete" }),
    "Das Juckpulver befindet sich in einer kleinen Papiertuete. Darueber "
    "solltest Du sehr froh sein, denn es ist mit Sicherheit aeusserst "
    "unangenehm, wenn man es auf der nackten Haut zu spueren bekommt.");

  AddDetail( ({ "papier" }),
    "Die Tuete besteht aus Papier.");

  AddDetail( ({ "sicherheit" }),
    "Da bist Du Dir ziemlich sicher.");

  AddDetail( ({ "haut" }),
    "Du willst das Pulver lieber nicht am eigenen Leib zu spueren bekommen.");

  AddDetail( ({ "leib" }),
    "Wenn Du natuerlich jemand anderes aergern moechtest...");

  AddDetail( ({ "substanz" }),
    "Bei der weisslichen Substanz handelt es sich um Juckpulver.");

  AddDetail( ({ "hyara" }),
    "Sie hat dieses Juckpulver hergestellt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Juckpulver");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "juckpulver", "pulver", "tuete", "\nhyara_juckpulver" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "Nun ja, Du koenntest das Juckpulver vielleicht ueber "
  "jemandem ausschuetten. Aber das waere wirklich sehr gemein.");
  SetProp(P_MATERIAL, MAT_MISC_HERBAL);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 30);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Kommandos-------------------------------------------------------------

  AddCmd( ({ "schuett", "schuette", "kipp", "kippe" }), "schuetten" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

int schuetten(string str)
{
  string was, wer;
  object opfer;
  object myjuckreiz;
  
  notify_fail("WAS willst Du ueber WEM ausschuetten?\n");

  if(!str || str == "")
  {
        return (notify_fail ("WAS willst Du ueber WEM ausschuetten?\n"),0);
  }

  //Syntaxcheck
  if( sscanf(str, "%s ueber %s aus", was, wer) == 2 && id(was) )
  {
     opfer = present(wer, ENV(TP));

     //das Opfer ist nicht eingelogt
     if(!opfer)
     {
          write(BS("Aber "+CAP(wer)+" ist doch gar nicht anwesend."));
          return -1;
     }

     //Spieler ist nicht im gleichen Raum
     if(ENV(TP) != ENV(opfer))
     {
          write(BS("Aber "+CAP(wer)+" steht doch gar nicht neben Dir."));
          return -1;
     }

     if(present("\njuckreiz", opfer))
     {
          write(BS(opfer->Name(WER, 1)+" wird bereits von heftigem "
          +"Juckreiz geplagt, daher laesst Du Dein Vorhaben lieber "
          +"bleiben."));
          return -1;
     }
     
     write(BS("Mit einem hinterhaeltigen Grinsen schleichst Du Dich an "
     +opfer->name(WEN)+" an und schuettest "+opfer->QueryPronoun(WEM)+" "
     +"das Juckpulver heimlich in den Nacken."));

     tell_object(opfer, BS(TP->Name(WER)+" schleicht sich hinterhaeltig "
     +"an Dich an und schuettet Dir blitzschnell etwas in den Nacken!"));

     tell_room(ENV(TP),BS(TP->Name()+" schleicht sich hinterhaeltig an "
     +opfer->name(WEN)+" an und schuettet "+opfer->QueryPronoun(WEM)+" "
     +"heimlich Juckpulver in den Nacken."),
     ({ TP, opfer }));

     myjuckreiz=clone_object("/d/kristallwald/lilyth/waldpuck/obj/juckreiz");
     myjuckreiz->move(opfer, M_GET|M_SILENT);
     call_other(myjuckreiz, "kratzen", opfer);

     TO->remove();
     return 1;
     
  }
  
  return 0;
}
