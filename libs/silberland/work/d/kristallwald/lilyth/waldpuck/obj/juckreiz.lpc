#include "../def.h"

inherit "std/thing";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  call_out("remove", 100+random(200));

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( ({"\njuckreiz"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

int kratzen(object player)
{
   string text;
   string text2;

   switch(random(11))
   {
    case 1:
      text = "ausgiebig";
      text2 = "wie von tausend Floehen geplagt";
      break;
    case 2:
      text = "am rechten Fuss";
      text2 = "am rechten Fuss";
      break;
    case 3:
      text = "am linken Fuss";
      text2 = "am linken Fuss";
      break;
    case 4:
      text = "am rechten Arm";
      text2 = "am rechten Arm";
      break;
    case 5:
      text = "am linken Arm";
      text2 = "am linken Arm";
      break;
    case 6:
      text = "am Bauch";
      text2 = "am Bauch";
      break;
    case 7:
      text = "hinterm linken Ohr";
      text2 = "hinterm linken Ohr";
      break;
    case 8:
      text = "hinterm rechten Ohr";
      text2 = "hinterm rechten Ohr";
      break;
    case 9:
      text = "am linken Bein";
      text2 = "am linken Bein";
      break;
    case 10:
      text = "am rechten Bein";
      text2 = "am rechten Bein";
      break;
    default:
      text = "unauffaellig an Deinem Allerwertesten";
      text2 = "unauffaellig am Allerwertesten";
      break;
  }
     
  if(find_call_out("kratzen") != -1)
  {
     return 0;
  }

  if(!player) return 0;

  tell_object(player, BS("Du kratzt Dich "+text+".\n"));
     
  ENV(player)->Message(break_string(player->Name(WER)+" kratzt sich "
  +text2+".", 78, 0, BS_LEAVE_MY_LFS), 
  MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]) );

  call_out("kratzen", 5+random(25), player);
  return 1;
}

int remove()
{
     object player;
     
     if(!is_clone(TO)) return ::remove();
     
     player = ENV(TO);
     
     if(player && query_once_interactive(player))
     {
       tell_object(player, BS("Erleichtert bemerkst Du, dass das Jucken "
       +"wieder nachgelassen hat."));
     }
     
     remove_call_out("kratzen");
     return ::remove();
}
