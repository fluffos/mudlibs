#include "../def.h"

inherit "std/unit";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Juckbohne");
  SetProp(P_LONG,
    "Dies ist ein dicker, bohnenaehnlicher Samen der seltenen Mucuna "
    "Pruriens, die man im allgemeinen Sprachgebrauch auch einfach nur "
    "Juckbohne nennt. Eigentlich sieht er recht harmlos aus, doch mit der "
    "richtigen Anwendung wird der Samen sicherlich schnell seine "
    "unangenehmen Eigenschaften zu Tage foerdern.");

  AddDetail( ({ "samen" }),
    "Dieser Samen stammt eindeutig von einer Juckbohne.");

  AddDetail( ({ "mucuna", "pruriens", "mucuna pruriens" }),
    "So nennt man die Juckbohne im Fachjargon.");

  AddDetail( ({ "fachjargon", "jargon" }),
    "Ein Jargon ist ein Jargon ist ein Jargon... Und ein Fachjargon ist "
    "auch nicht viel was anderes. Na gut, um es einfacher zu sagen: Es "
    "ist ein Fachwort.");

  AddDetail( ({ "fachwort", "wort" }),
    "Mucuna Pruriens ist so eines.");

  AddDetail( ({ "sprachgebrauch" }),
    "Interessiert Dich das wirklich?");

  AddDetail( ({ "anwendung", "eigenschaften" }),
    "Hyara kann Dir sicherlich mehr dazu sagen.");

  AddDetail( ({ "hyara" }),
    "Warst Du schon bei ihr?");

  AddDetail( ({ "tage" }),
    "Das sagt man nur so.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, ({"Juckbohne", "Juckbohnen"}));
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "juckbohne", "bohne", "\nhyara_juckbohne" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "Was koennte man mit dieser Juckbohne bloss anfangen?");
  SetProp(P_MATERIAL, MAT_MISC_HERBAL);
  SetProp(P_SIZE, 2+random(5));
  SetProp(P_VALUE, 20);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

  AddSingularId( ({ "juckbohne", "bohne" } ));
  AddPluralId( ({ "juckbohnen", "bohnen" } ));
  SetGramsPerUnits(50, 1);
  SetCoinsPerUnits(10, 1);
  //SetAmount(1); ?

//--Create Ende------------------------------------------------------------

}
