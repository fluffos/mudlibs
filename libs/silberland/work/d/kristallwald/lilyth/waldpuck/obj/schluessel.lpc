#include "../def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein glaenzender Schluessel");
  SetProp(P_LONG,
    "Ein silbrig glaenzender, kleiner Schluessel. Welches Schloss mag er "
    "nur aufsperren?");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schluessel");
  SetProp(P_NAME_ADJ, "glaenzend");
  AddAdjective( ({ "glaenzender", "glaenzenden" } ));
  SetProp(P_GENDER, MALE);
  AddId( ({"schluessel", "\npuck_unlock"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_SILVER);
  SetProp(P_WEIGHT, 10);
  SetProp(P_SIZE, 4);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 0);

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------
