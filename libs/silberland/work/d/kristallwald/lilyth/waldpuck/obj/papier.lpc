#include "../def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------



//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------



//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine leeres Stueck Papier");
  SetProp(P_LONG, "Du haeltst eine leere Seite in Deiner Hand, die "
  "scheinbar aus einem Buch herausgerissen wurde. Na, ob die noch fuer "
  "irgendetwas gut ist?");

  AddDetail( ({ "buch" }),
    "Dieses Stueck Papier ist eine Seite, die aus einem Buch "
    "herausgerissen wurde.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Stueck Papier");
  SetProp(P_NAME_ADJ, "leer");
  AddAdjective( ({ "leeres", "leeren" } ));
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "papier", "stueck", "stueck papier", "seite", "buchseite",
  "\npapier" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_INFO, "Es ist eigentlich ziemlich unnuetz.");
  SetProp(P_MATERIAL, MAT_PAPER);
  SetProp(P_WEIGHT, 5);
  SetProp(P_SIZE, 15);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Create Ende------------------------------------------------------------

}
