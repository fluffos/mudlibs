#include "../def.h"

inherit "std/thing";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  call_out("remove", 120+random(300));

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( ({"\nungeschick"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

//--Besonderheiten---------------------------------------------------------

  SetProp(P_X_ATTR_MOD,([A_DEX:-1-random(3)]));

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

int remove()
{
     object player;
     
     if(!is_clone(TO)) return ::remove();
     
     player = ENV(TO);
     
     tell_object(player, BS("Du fuehlst Dich wieder so geschickt wie eh und "
     +"je.\n"));
     return ::remove();
}
