#include "../def.h"

inherit "std/container";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  //notwendig fuer volle Abschliessfunktionen etc.:
  add_openclose_commands();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine kleine Holzkiste");
  SetProp(P_LONG,
    "Eine kleine Holzkiste steht in einer Ecke auf dem Boden. Obwohl sie "
    "nicht sehr gross ist, sieht sie unheimlich schwer aus. Zudem ist sie "
    "mit einem dicken Schloss gesichert. Was da wohl drin sein mag?");

  AddDetail( ({ "ecke", "boden" }),
    "Die Kiste steht in einer dunklen Ecke auf dem Boden.");

  AddDetail( ({ "schloss" }),
    "Das Schloss sieht ziemlich unnachgiebig aus. Das bekommst Du wohl nur "
    "mit dem dazugehoerigen Schluessel auf.");

  AddDetail( ({ "schluessel" }),
    "Wo sollst Du den bloss herbekommen?");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Holzkiste");
  SetProp(P_NAME_ADJ, "klein");
  AddAdjective( ({ "kleine", "kleinen" } ));
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kiste", "holzkiste", "\npuck_kiste"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_WOOD);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_SIZE, 45);
  SetProp(P_VALUE, 700);
  SetProp(P_MAX_WEIGHT, 100000);
  SetProp(P_WEIGHT_PERCENT, 35);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_NOGET, BS("Du versuchst, die Kiste hochzuheben, doch sie ist "
  "einfach zu schwer, so dass Du Dein Vorhaben enttaeuscht wieder "
  "aufgibst."));
  SetProp(P_CNT_STATUS, CNT_STATUS_LOCKED);
  SetProp(P_CNT_FLAGS, CNT_RESET_LOCK);
  SetProp(P_CNT_KEY, "\npuck_unlock");

}

//--Funktionen-------------------------------------------------------------

