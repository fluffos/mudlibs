#include "../def.h"

inherit "std/thing";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  call_out("remove", 100+random(200));

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( ({"\nschluckauf"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

int hick(object player)
{
     if(find_call_out("hick") != -1)
     {
        return 0;
     }
     
     tell_object(player, BS("Du machst: <Hick!>\n"));
     
     ENV(player)->Message(break_string(player->name(WER)+" scheint "
     +"Schluckauf zu haben. <Hick!>\n", 78, 0, BS_LEAVE_MY_LFS), 
     MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]) );

     call_out("hick", 5+random(25), player);
     return 1;
}

int remove()
{
     object player;
     
     if(!is_clone(TO)) return ::remove();
     
     player = ENV(TO);
     
     tell_object(player, BS("Dein Schluckauf laesst langsam wieder "
     +"nach.\n"));
     return ::remove();
}
