#include "../def.h"

inherit "std/thing";

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleiner Zettel");
  SetProp(P_LONG, "Das ist ein kleiner Zettel, auf dem etwas geschrieben "
  "steht.");

  AddReadDetail( ({ "zettel" }),
    "Du liest:\n\n"
    "           EN FAMUL PUCRE\n\n"
    "Was fuer eine seltsame Sprache. Du hast absolut keine Ahnung, "
    +"was das wohl bedeuten soll.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Zettel");
  SetProp(P_NAME_ADJ, "klein");
  AddAdjective( ({ "kleiner", "kleinen", "kleinem" } ));
  SetProp(P_GENDER, MALE);
  AddId( ({ "zettel", "\nhyara_zettel" }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_PAPER);
  SetProp(P_WEIGHT, 1);
  SetProp(P_SIZE, 5);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);

//--Create Ende------------------------------------------------------------

}
