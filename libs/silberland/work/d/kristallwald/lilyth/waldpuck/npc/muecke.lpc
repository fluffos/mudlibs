#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------

string art;
object player;

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  switch(random(4))
  {
    case 1:
      art = "winzig";
      AddAdjective( ({ "winzige" }) );
      create_default_npc(1);
      SetProp(P_HANDS, ({ " mit ihrem Stachel", 10, DT_BLUDGEON }) );
      SetProp(P_SIZE, 1);
      SetProp(P_WEIGHT, 1);
      break;
    case 2:
      art = "klein";
      AddAdjective( ({ "kleine" }) );
      create_default_npc(2);
      SetProp(P_HANDS, ({ " mit ihrem Stachel", 20, DT_BLUDGEON }) );
      SetProp(P_SIZE, 2);
      SetProp(P_WEIGHT, 2);
      break;
    case 3:
      art = "gross";
      AddAdjective( ({ "grosse" }) );
      create_default_npc(3);
      SetProp(P_HANDS, ({ " mit ihrem Stachel", 30, DT_BLUDGEON }) );
      SetProp(P_SIZE, 3);
      SetProp(P_WEIGHT, 3);
      break;
    default:
      art = "riesig";
      AddAdjective( ({ "riesige" }) );
      create_default_npc(4);
      SetProp(P_HANDS, ({ " mit ihrem Stachel", 40, DT_BLUDGEON }) );
      SetProp(P_SIZE, 4);
      SetProp(P_WEIGHT, 4);
      break;
  }
  
//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine "+art+"e Muecke");
//SetProp(P_LONG, -> siehe unten

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Muecke");
  SetProp(P_NAME_ADJ, ({ art }));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"muecke"}));
  AddClass( ({CL_ANIMAL, CL_FLYING}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  SetProp(P_RACE, "Insekt");
  SetProp(P_ALIGN, -199);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp( P_REJECT, ({ REJECT_DROP, "" }) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "surrt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "surrt herein");
  SetProp(P_MMSGOUT, "fliegt davon");
  
//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " wird niemanden mehr quaelen.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Eine "+art+"e Muecke");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "fliegt um Deinen Kopf herum.\n"}));

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,35);

  AddSpell(1,90,
    Name(WER, 1)+" zapft Dir ein wenig Blut ab.\n",
    Name(WER, 1)+" zapft @WEM ein wenig Blut ab.\n",
    DT_PIERCE,([SP_SHOW_DAMAGE:1]));

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" summt boesartig.\n",
    Name(WER, 1)+" surrt ueber Deinem Kopf herum.\n",
    Name(WER, 1)+" sticht Dich schmerzhaft. Autsch!\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" sucht nach einer Stelle, an der sie Dich stechen kann.\n",
    Name(WER, 1)+" surrt wuetend hin und her.\n" }));

//--Create Ende------------------------------------------------------------

}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aergerlich":
    case "fies":
    case "frech":
      call_out("reaction", 0, TP,
        "sticht Dich schmerzhaft. AUTSCH!",
        "sticht "+TP->name(WEN)+" boshaft.");
      break;

    case "albern":
    case "aengstlich":
    case "intim":
      call_out("reaction", 0, TP,
        "setzt sich auf Deine Nase.",
        "setzt sich auf "+TP->name(WESSEN)+" Nase.");
      break;

    case "froh":
    case "nett":
    case "neutral":
      call_out("reaction", 0, TP,
        "surrt drohend ueber Deinem Kopf herum.",
        "surrt drohend ueber "+TP->name(WESSEN)+" Kopf herum.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Funktionen-------------------------------------------------------------

void SetName(object spieler)
{
        player = spieler;
        SetProp(P_MSGOUT, "fliegt hinter "+player->Name()+" her");
        return;
}

//Langbeschreibung:
string _query_long()
{
  string txt;

  if(!player)
  {
      return "Fehler!\n";
  }
  
  txt = "Diese "+art+"e Muecke sieht richtig fies und blutruenstig aus. "
    +"Sie scheint es auf "+player->Name()+" abgesehen zu haben, denn sie "
    +"fliegt immerzu um "+player->QueryPossPronoun(MALE, WEN, SINGULAR)+" "
    +"Kopf herum.";

  return BS(txt);
}

