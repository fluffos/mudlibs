#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------

int verfolgt;
void items_lagern();
int beschaeftigt;  //fuer die Sequenz
object *ROOMS;

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  verfolgt = NEIN;
  beschaeftigt = NEIN;
  ROOMS = ({ P1,P2,P3,P4,P5 });

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleiner Waldpuck");
  SetProp(P_LONG,
    "Vor Dir steht ein kleiner, listiger Waldpuck und starrt Dir frech "
    "ins Gesicht. Seine feuerroten Haare stehen ihm wild vom Kopf ab "
    "und seine gruenen Augen funkeln belustigt. Er scheint gerade zu "
    "ueberlegen, was er Dir fuer einen gemeinen Streich spielen koennte.");

  AddDetail( ({ "haar", "haare", "kopf", "durcheinander" }),
    "Seine Haare sind feuerrot und sie stehen ihm in einem wilden "
    "Durcheinander vom Kopf ab.");

  AddDetail( ({ "auge", "augen", "blick" }),
    "Seine gruenen Augen starren Dich frech an und funkeln belustigt, "
    "als sie Deinem etwas verwirrten Blick begegnen.");

  AddDetail( ({ "streich", "streiche" }),
    "Dieser freche Waldpuck tut nichts lieber, als arglosen Abenteurern, "
    "die im Wald umherwandern, boese Streiche zu spielen.");

  AddDetail( ({ "abenteurer" }),
    "Solche wie Dich.");

  AddDetail( ({ "wald" }),
    "Der Waldpuck fuehlt sich nur in einem Wald wie diesem so richtig "
    "wohl.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Waldpuck");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"puck", "waldpuck"}));
  AddClass( ({CL_GNOME}) );
  SetProp(P_ARTICLE, 1);

//set_living_name("waldpuck");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(10);

  SetProp(P_HANDS, ({" mit seinen Haenden"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })  );

  SetProp(P_RACE, "Waldpuck");
  SetProp(P_SIZE, 42);
  SetProp(P_WEIGHT, 25000);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_NOATTACK, "kichert: Du kannst mich nicht toeten!");
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    Name(WER,1)+" kichert: Danke, das kann ich gut gebrauchen!\n" }) );

//SetProp(P_LOG_INFO, "/lilyth/waldpuck/waldpuck");

  SetProp(P_RESISTANCE_STRENGTHS,
    ([ DT_MAGIC: -0.5 ]));

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "steht ploetzlich vor Dir");
  SetProp(P_MSGOUT, "huscht davon");
  SetProp(P_MMSGIN, "steht ploetzlich vor Dir");
  SetProp(P_MMSGOUT, "verschwindet zwischen den Baeumen");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Ein kleiner Waldpuck");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "starrt Dich neugierig an.\n",
            "kichert: Ich weiss es, aber ich sag es Dir nicht!\n",
            "grinst Dich schelmisch an.\n"}));

  AddInfo( ({"waldpuck", "puck"}),
    "Das bin ich!",
    "kichert: ");

  AddInfo( ({"wald", "tethyrwald", "tethyr", "zuhause"}),
    "Der Wald ist mein Zuhause!",
    "grinst: ");

  AddInfo( ({"streich", "streiche"}),
    "lauthals an zu kichern.",
    "faengt ");

  AddInfo( ({"abenteurer"}),
    "Bist Du einer?!",
    "fragt Dich: ");

  AddInfo( ({"kuh", "fliegende kuh"}),
    "Siehst Du hier irgendwo eine??",
    "kichert: ");

  AddInfo( ({"mutter", "vater"}),
    "ploetzlich ganz still und nachdenklich.",
    "wird ");

  AddInfo( ({"hyara", "zauberin", "hexe"}),
    "Hast Du sie gesehen?? Sie wohnt in einer kleinen Huette irgendwo im "
    "Wald!",
    "fragt furchtsam: ");

  AddInfo( ({"baum", "baeume"}),
    "Ich liebe die Baeume hier im Wald! Da kann man herrlich drauf "
    "herumklettern!",
    "kreischt froehlich: ");

  AddInfo( ({"erdhoehle", "hoehle"}),
    "Da wohne ich!",
    "grinst: ");

  AddInfo( ({"holzkiste", "kiste"}),
    "Das geht Dich gar nichts an, was da drin ist!",
    "kichert: ");

  AddInfo( ({"schluessel"}),
    "Das verrate ich Dir doch nicht!",
    "grinst: ");

  AddInfo( ({"zeichnung"}),
    "verlegen mit seinen Fuessen auf und ab.",
    "wippt ");

  AddInfo( ({"kerze"}),
    "In meiner Hoehle habe ich eine, aber die gehoert mir!",
    "sagt misstrauisch: ");

//--Chats------------------------------------------------------------------

  SetChats(10, ({ "@@ChatFunc@@" }) );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "sag", "sage" }), "magic_words" );

//--Create Ende------------------------------------------------------------

}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "schneidet eine fuerchterliche Grimasse und schreit: BUH!",
        "schneidet eine fuerchterliche Grimasse und schreit: BUH!");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "verzieht beleidigt das Gesicht.",
        "verzieht beleidigt das Gesicht.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "faengt lauthals an zu kichern.",
        "faengt lauthals an zu kichern.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "schreit erbost: Was soll denn das?!",
        "schreit erbost: Was soll denn das?!");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "streckt Dir die Zunge heraus.",
        "streckt "+TP->name(WEM)+" die Zunge heraus.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "kichert belustigt.",
        "kichert belustigt.");
      break;

    case "froh":
    case "nett":
      call_out("reaction", 0, TP,
        "grinst Dich schelmisch an.",
        "grinst "+TP->name(WEN)+" schelmisch an.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "kichert leise.",
        "kichert leise.");
     break;

    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich und faengt dann an zu lachen.",
        "troestet "+TP->name(WEN)+" und faengt dann an zu lachen.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

//--Chatfunktion-----------------------------------------------------------

//Hilfsfunktion: alle Spieler im Raum suchen
int filter_player(object ob)
{
  //alle Spieler
  if(query_once_interactive(ob) && !find_netdead(getuid(ob))) return 1;

  //Rest wird aussortiert
  return 0;
}

//Chatfunktion
string ChatFunc()
{
  object *inhalt;
  object player;
  inhalt = all_inventory(ENV(TO)); //Wer ist alles im Raum?
  inhalt = filter_array(inhalt, "filter_player"); // nur Spieler behalten

  if(!sizeof(inhalt)) return ""; //kein Spieler anwesend?

  if(beschaeftigt == JA); return "";  // Erloesungssequenz laeuft

  player = inhalt[random(sizeof(inhalt))]; //einen beliebigen Spieler waehlen

  switch(random(16))
  {
    case 1:
      call_out("reaction", 0, player,
      "streckt Dir die Zunge raus.\n",
      "streckt "+player->name(WEM)+" die Zunge heraus.\n");
      break;
    case 2:
      call_out("reaction", 0, player,
      "bricht in lautes Gelaechter aus.\n",
      "bricht in lautes Gelaechter aus.\n");
      break;
    case 3:
      call_out("reaction", 0, player,
      "zieht Dich an den Haaren und kichert vor sich hin.\n",
      "zieht "+player->name(WEN)+" an den Haaren und kichert albern.\n");
      break;
    case 4:
      call_out("reaction", 0, player,
      "scheint sich ueber Dich lustig zu machen.\n",
      "scheint sich ueber "+player->name(WEN)+" lustig zu machen.\n");
      break;
    case 5:
      call_out("reaction", 0, player,
      "schneidet Dir eine freche Grimasse.\n",
      "schneidet "+player->name(WEM)+" eine freche Grimasse.\n");
      break;
    case 6:
      call_out("reaction", 0, player,
      "zeigt Dir einen Vogel.\n",
      "zeigt "+player->name(WEM)+" einen Vogel.\n");
      break;
    /************ Streiche *****************************************/
    case 7:
      call_out("ItemKlauen", 0, player);
      break;
    case 8:
      if(verfolgt==NEIN) { call_out("Verfolgen", 0, player); }
      break;
    case 9:
      call_out("Ausziehen", 0, player);
      break;
    case 10:
      call_out("Mueckenschwarm", 0, player);
      break;
    case 11:
      call_out("Schwaeche", 0, player);
      break;
    case 12:
      call_out("Ungeschicklichkeit", 0, player);
      break;
    case 13:
      call_out("Schluckauf", 0, player);
      break;
    case 14:
      call_out("Stein", 0, player);
      break;
    case 15:
      call_out("Haare_ziehen", 0, player);
      break;
    default:
      call_out("reaction", 0, player,
      "starrt Dich an.\n",
      "starrt "+player->name(WEN)+" an.\n");
      break;
   }

   return "";
}

//--Funktionen fuer Streiche-----------------------------------------------

//Hilfsfunktion: ItemKlauen() (filtern)
int filter_items(object ob)
{
  //keine Sachen klauen, die verflucht oder nodrop sind
  if(ob->QueryProp(P_CURSED) ||
     ob->QueryProp(P_NEVERDROP) ||
     ob->QueryProp(P_NODROP)) return 0;

  //Rest darf geklaut werden
  return 1;
}

//Item aus dem Inv klauen
int ItemKlauen(object player)
{
   object *inventar;
   object item;
   int k;
   inventar = all_inventory(player); //was hat der Spieler im Inv?
   inventar = filter_array(inventar, "filter_items"); //was davon ist brauchbar?

   if(!sizeof(inventar)) return 0; //Spieler hat nix Brauchbares dabei

   item = inventar[random(sizeof(inventar))]; //waehle beliebiges Item
   k = item->move(TO,M_GET|M_SILENT);

   if(k == ME_TOO_HEAVY) return -1;
   if(k == ME_CANT_BE_TAKEN) return -1;

   tell_object(player, break_string("Der kleine Waldpuck ruft aufgeregt: "
   +"Guck mal da, eine fliegende Kuh!\nNeugierig schaust Du zum Himmel, "
   +"doch es ist nichts zu sehen.\n\nPloetzlich hast Du das Gefuehl, dass "
   +"Dein Gepaeck leichter geworden ist.", 78, 0, BS_LEAVE_MY_LFS));

   ENV(TO)->Message(break_string("Der kleine Waldpuck ruft aufgeregt: Guck "
   +"mal da, eine fliegende Kuh!\nNeugierig schaust Du zum Himmel, doch es "
   +"ist nichts zu sehen. Seltsam.\n", 78, 0, BS_LEAVE_MY_LFS),
   MSGFLAG_SOUND, ([MSGFLAG_EXCLUDE: ({ player })]) );

   WALDPUCKMASTER->Msg("Der Waldpuck beklaut "+player->name(WEM)+": "+item->Name(), 2);

   return 1;
}

//Verfolgen
int Verfolgen(object player)
{
   tell_object(player, BS("Der kleine Waldpuck scheint Dich irgendwie "
   +"zu moegen, denn er folgt Dir nun auf Schritt und Tritt."));

   ENV(TO)->Message(BS("Der kleine Waldpuck scheint "+player->name(WEN)+" "
   +"zu moegen, denn er folgt "+player->QueryPronoun(WEM)+" auf Schritt und "
   +"Tritt."), MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]) );

   player->AddPursuer(TO);
   verfolgt = JA;
   SetProp(P_MSGIN, "folgt "+player->name(WEM)+" auf Schritt und Tritt");
   SetProp(P_MSGOUT, "laeuft kichernd hinter "+player->name(WEM)+" her");
   call_out("Verfolgen_aus", 120+random(480), player);
   return 1;
}

int PreventFollow(object dest)
{
  if(member(ROOMS, file_name(dest)) == -1) return 0;

  return 2;
}

//Verfolgen stoppen
int Verfolgen_aus(object player)
{
   tell_object(player, BS("Der kleine Waldpuck langweilt sich und hoert "
   +"auf, Dir zu folgen."));

   ENV(TO)->Message(BS("Der kleine Waldpuck langweilt sich und hoert auf, "
   +player->name(WEM)+" zu folgen."),
   MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]) );

   player->RemovePursuer(TO);
   verfolgt = NEIN;
   SetProp(P_MSGIN, "steht ploetzlich vor Dir");
   SetProp(P_MSGOUT, "huscht davon");
   return 1;
}

//eine Ruestung ausziehen
int Ausziehen(object player)
{
   object item;
   object *sachen;
   sachen = player->QueryArmours( ({ AT_ARMOUR, AT_BOOT, AT_HELMET,
    AT_SHIELD, AT_AMULET, AT_TROUSERS, AT_RING, AT_BELT, AT_GLOVE,
    AT_BRACERS, AT_CLOAK }) );
   if(!sizeof(sachen)) return 0;
   item = sachen[random(sizeof(sachen))];

   tell_object(player, break_string("Der kleine Waldpuck zupft an Deiner "
   +"Kleidung herum.\n", 78, 0, BS_LEAVE_MY_LFS));

   ENV(TO)->Message(break_string("Der kleine Waldpuck zupft an "
   +player->name(WESSEN)+" Kleidung herum.\n", 78, 0, BS_LEAVE_MY_LFS),
   MSGFLAG_SOUND, ([MSGFLAG_EXCLUDE: ({ player })]) );

   item->DoUnwear();

   return 1;
}

//Mueckenschwarm... naja, eigentlich nur eine einzige ;)
int Mueckenschwarm(object player)
{
   object mymuecke;

   tell_object(player, BS("Der kleine Waldpuck murmelt leise etwas und "
   +"grinst Dich dann haemisch an.\nPloetzlich ertoent ein leises Surren "
   +"hinter Dir.\n"));

   ENV(TO)->Message(BS("Der kleine Waldpuck murmelt leise etwas und "
   +"grinst "+player->name(WEN)+" dann haemisch an. Ploetzlich hoerst Du "
   +"ein leises Surren.\n"),
   MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]) );

   mymuecke=clone_object("/d/kristallwald/lilyth/waldpuck/npc/muecke");
   mymuecke->move(ENV(TO), M_GO|M_SILENT);
   mymuecke->SetName(player);
   player->AddPursuer(mymuecke);
   return 1;
}

//Schwaeche
int Schwaeche(object player)
{
   object myschwaeche;

   if(present("\nschwaeche", player)) return 0;

   tell_object(player, break_string("Der kleine Waldpuck starrt Dich "
   +"eindringlich an.\nPloetzlich fuehlst Du Dich irgendwie kraftlos und "
   +"etwas geschwaecht.\n", 78, 0, BS_LEAVE_MY_LFS));

   ENV(TO)->Message(BS("Der kleine Waldpuck starrt "+player->name(WEN)+" "
   +"eindringlich an.\n"),
   MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]) );

   myschwaeche=clone_object("/d/kristallwald/lilyth/waldpuck/obj/schwaeche");
   myschwaeche->move(player, M_GET|M_SILENT);
   return 1;
}

//Ungeschicklichkeit
int Ungeschicklichkeit(object player)
{
   object myungeschick;

   if(present("\nungeschick", player)) return 0;

   tell_object(player, break_string("Der kleine Waldpuck starrt Dich "
   +"eindringlich an.\nDu spuerst, wie Dich Deine Geschicklichkeit "
   +"im Stich zu lassen scheint.\n", 78, 0, BS_LEAVE_MY_LFS));

   ENV(TO)->Message(BS("Der kleine Waldpuck starrt "+player->name(WEN)+" "
   +"eindringlich an.\n"),
   MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]) );

   myungeschick=clone_object("/d/kristallwald/lilyth/waldpuck/obj/ungeschick");
   myungeschick->move(player, M_GET|M_SILENT);
   return 1;
}

//Schluckauf
int Schluckauf(object player)
{
   object myschluckauf;

   if(present("\nschluckauf", player)) return 0;

   tell_object(player, break_string("Du bekommst ploetzlich Schluckauf.\n",
   78, 0, BS_LEAVE_MY_LFS));

   ENV(TO)->Message(BS(player->name(WER)+" bekommt ploetzlich Schluckauf.\n"),
   MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]) );

   myschluckauf=clone_object("/d/kristallwald/lilyth/waldpuck/obj/schluckauf");
   myschluckauf->move(player, M_GET|M_SILENT);
   call_other(myschluckauf, "hick", player);
   return 1;
}

//Stein im Schuh
int Stein(object player)
{
   object *schuhe;
   object mystein;

   schuhe = player->QueryArmours(AT_BOOT);

   if(!sizeof(schuhe)) return 0;
   if(present("\nstein", player)) return 0;

   tell_object(player, BS("Der kleine Waldpuck zaubert Dir einen kleinen "
   +"Stein in "+schuhe[0]->Name(WEN)+" und grinst dann hinterhaeltig.\n"));

   ENV(TO)->Message(BS("Der kleine Waldpuck grinst "+player->name(WEN)+" "
   +"hinterhaeltig an.\n"),
   MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]) );

   mystein=clone_object("/d/kristallwald/lilyth/waldpuck/obj/stein");
   mystein->SetProp(P_SHORT, "Ein Stein im "+schuhe[0]->QueryProp(P_NAME));
   mystein->move(player, M_GET|M_SILENT);
   return 1;
}

//an den Haaren ziehen und wegrennen - Spieler folgt
void Haare_ziehen(object player)
{
  object *raeume;

  if(!player || player->QueryProps(P_GHOST)) return;

  raeume = m_values(ENV(TO)->QueryProp(P_EXITS));

  if(!sizeof(raeume)) return;

  tell_object(player, BS("Der kleine Waldpuck zieht Dich frech an den "
  +"Haaren."));

  ENV(TO)->Message(BS("Der kleine Waldpuck zieht "+player->name(WEN)+" "
  +"frech an den Haaren."),
  MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]) );

  TO->move(raeume[random(sizeof(raeume))], M_GO|M_NO_SHOW,
    "lachend im dichten Wald", "verschwindet",
    "huscht kichernd herein");

  tell_object(player, BS("Erbost folgst Du ihm."));

  player->move(raeume[random(sizeof(raeume))], M_GO|M_NO_SHOW,
    "dem kleinen Waldpuck erbost", "folgt",
    "stuermt herein und schaut sich mit wildem Blick um");
}

void items_lagern()
{
   int i;
   object *inv;
   object kiste;
   object raum;
   inv = all_inventory(TO);

   call_other(ROOM "hoehle", "???", 0);
   raum = find_object(ROOM "hoehle");
   if(!raum) return;
   kiste = present("\npuck_kiste", raum);

   if(sizeof(inv))
   {
        if(!kiste) return;

        for(i=0; i < sizeof(inv); i++)
        {
           if(inv[i])
           {
                  inv[i]->move(kiste, M_TPORT|M_SILENT);
           }
        }

        if(ENV(TO)) ENV(TO)->Message(BS("Der kleine Waldpuck verschwindet "
        +"irgendwo im Wald, steht jedoch kurz darauf wieder neben Dir."),
        MSGFLAG_VISUAL);

        raum->Message(break_string("Der kleine Waldpuck huscht leise herein "
        +"und verstaut etwas in der Holzkiste.\nDann verschwindet er "
        +"blitzschnell wieder im Wald.", 78, 0, BS_LEAVE_MY_LFS),
        MSGFLAG_VISUAL);
   }

   return;
}

//die magischen Worte sprechen
int magic_words(string str)
{
  object myring;

  notify_fail("Was willst Du sagen?\n");

  if(!str || str == "") return 0;

  if(!(lower_case(str) == "en famul pucre!" ||
       lower_case(str) == "en famul pucre")) return 0;

  if(present("\njuckreiz"))
  {
     write(break_string("Du sprichst die magischen Worte, die die alte Zauberin "
     +"Dir gesagt hat...\n\n", 78,0,1));

     call_out("seqerloesung", 8 , TP, 1);
     beschaeftigt = JA;
     SetChats(0, ({""}));
     return 1;
  }
  else
  {
     write(break_string("Du sprichst die magischen Worte, die die alte Zauberin "
     +"Dir gesagt hat...\n\n", 78,0,1));

     ENV(TO)->Message(BS(TP->Name(WER, 1)+" spricht ein paar magische "
     +"Worte."), MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ TP })]));

     call_out("seqfehlschlag", 6 , TP, 1);
     return -1;
  }
}

void seqfehlschlag(object player, int pos)
{
  string s;

  if(!player || ENV(player) != ENV(TO))
  {
     return;
  }

  switch(pos)
  {
     case 1:
     s = "Hmm. Du scheinst irgendetwas Wichtiges vergessen zu haben.";
     break;

     default:
     return;
     break;
  }

  tell_object(player, BS(s));

  pos = pos + 1;
  call_out("seqfehlschlag", 3, player, pos);
}

void seqerloesung(object player, int pos)
{
  string s;

  if(!player || ENV(player) != ENV(TO))
  {
     TO->remove();
     return;
  }

  switch(pos)
  {
    case 1:
    s = Name(WER, 1)+" stutzt ploetzlich.\n\n";
    present("\njuckreiz")->remove();
    break;

    case 2:
    s = Name(WER, 1)+" sagt verwirrt: Du hast es geschafft, mir einen Streich\n"
       +Name(WER, 1)+" sagt verwirrt: zu spielen...\n\n";
    break;

    case 3:
    s = Name(WER, 1)+" jubelt laut: Ich bin erloest! Du hast mich befreit!\n"
       +Name(WER, 1)+" jubelt laut: Ich bin frei!!!\n\n";
    break;

    case 4:
    s = Name(WER, 1)+" huepft und springt wie verrueckt herum.\n\n";
    break;

    case 5:
    s = "Ploetzlich wird "+name(WER, 1)+" wieder ganz still und ruhig.\n\n";
    break;

    case 6:
    s = Name(WER, 1)+" schliesst die Augen und Du hoerst noch ein leises\n\n"
    +"         'Danke, vielen Dank...'\n\n";
    break;

    default:
    ENV(TO)->Message(break_string(Name(WER, 1)+" verschwindet spurlos.",
    78, 0, 1), MSGFLAG_VISUAL);
    TO->remove();
    return;
    break;
  }

  ENV(TO)->Message(break_string(s, 78, 0, 1), MSGFLAG_VISUAL);

  pos = pos + 1;
  call_out("seqerloesung", 6, player, pos);
}

void reset()
{
   items_lagern();
   ::reset();
}
