//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt leise summend herein");
  SetProp(P_MSGOUT, "geht leise summend");
  SetProp(P_MMSGIN, "kommt von ihrem Spaziergang im Wald zurueck");
  SetProp(P_MMSGOUT, "geht ein wenig im Wald spazieren");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " stirbt vor Deinen Augen.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Hyara");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO,
         ({ "blickt Dich schweigend an.\n",
            "laechelt geheimnisvoll.\n",
            "seufzt leise.\n"}));

  AddInfo( ({"tethyr", "wald", "tethyrwald", "zuhause"}),
