    "deutet hinaus: ");

  AddInfo( ({"jahre"}),
    "Ich habe schon lange aufgehoert zu zaehlen.",
    "laechelt: ");

  AddInfo( ({"alter"}),
    "Du wirst doch eine alte Frau nicht nach ihrem Alter fragen.",
