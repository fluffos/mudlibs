  AddInfo( ({"magie", "alte magie", "alter magie", "uralte magie",
  "uralter magie"}),
    "Ich kann und darf mein Wissen leider nicht an Dich weitergeben.",
    "sagt entschuldigend: ");

  AddInfo( ({"wissen", "sprache"}),
    "nur geheimnisvoll.",
    "laechelt ");

  AddInfo( ({"huette", "holzhuette", "heim"}),
    "Diese Huette ist mein Heim, hier lebe ich.",
    "deutet rundherum: ");

  AddInfo( ({"zauberin", "hexe"}),
    "Nun, ich schaetze, man koennte mich so nennen... ja.",
    "sagt nachdenklich: ");

  AddInfo( ({"spaziergang", "spaziergaenge"}),
    "Ein schoener langer Spaziergang nach einem anstrengenden Tag ist "
    "wirklich eine wahre Freude.",
    "laechelt: ");

  AddInfo( ({"freude"}),
    "Bereitet es Dir etwa keine Freude? Nun, vielleicht bist Du "
    "einfach noch zu jung, um derlei Dinge wirklich schaetzen zu koennen.",
    "schmunzelt: ");

  AddInfo( ({"dinge"}),
    "Nun, ein langer Spaziergang durch den Wald, zum Beispiel.",
    "laechelt freundlich: ");

  AddInfo( ({"beispiel", "beispiele"}),
    "Du bist ganz schoen hartnaeckig, weisst Du das?",
    "seufzt: ");

  AddInfo( ({"notizbuch", "buch"}),
    "Ach ja, mit dem Alter nimmt leider auch die Vergesslichkeit zu... "
    "Deswegen schreibe ich mir vieles in mein Notizbuch, Sachen, an die "
    "ich denken muss oder die ich nicht vergessen darf.",
    "seufzt leicht: ");

  AddInfo( ({"vergesslichkeit"}),
    "Das wirst auch Du noch frueh genug bemerken.",
    "zwinkert: ");

  AddInfo( ({"sachen"}),
    "Alles moegliche eben.",
    "sagt: ");

  AddInfo( ({"tuch"}),
    "Ich habe es von einer guten Freundin geschenkt bekommen, als ich "
    "noch sehr jung war. Es ist eine liebe Erinnerung an sie.",
    "sagt: ");

  AddInfo( ({"freundin"}),
    "Sie weilt schon sehr lange nicht mehr unter uns.",
    "seufzt leise: ");

  AddInfo( ({"erinnerung"}),
    "Ich moechte jetzt nicht darueber reden.",
    "sagt traurig: ");

  AddInfo( ({"puck", "waldpuck"}),
    "Vielleicht bist Du ihm schon einmal begegnet. Es lastet ein schwerer "
    "Fluch auf ihm.",
    "sagt: ");

  AddInfo( ({"streich", "streiche"}),
    "Der Waldpuck muss allen Abenteurern, die ihm begegnen, seine "
    "gemeinen Streiche spielen. Es ist eine Art Fluch, der auf ihm liegt.",
    "erklaert: ");

  AddInfo( ({"abenteurer"}),
    "Auch Du bist ein Abenteurer, oder nicht?",
    "fragt: ");

  AddInfo( ({"fluch"}),
    "Frueher, als der Waldpuck noch ein Kind war, ein Menschenkind, war "
    "er so voller Bosheit, dass er sich immerzu neue hinterhaeltige "
    "Streiche ausdachte, die er den Menschen spielen konnte. Als seine "
    "arme Mutter zu mir kam und um Hilfe bat, blieb mir nichts anderes "
    "uebrig, als einen Fluch ueber ihn zu legen. Dieser Fluch wurde bis "
    "heute nicht gebrochen, und so ist er weiterhin seinem Schicksal "
    "unterworfen.",
    "erzaehlt: ");

  AddInfo( ({"kind", "menschenkind"}),
    "Nun, auch Du warst mal ein Kind, oder nicht?",
    "sagt: ");

  AddInfo( ({"bosheit"}),
    "Er war wirklich boshaft. Und so etwas sage ich nicht leichtfertig, "
    "erst recht nicht ueber ein unschuldiges Kind.",
    "sagt: ");

  AddInfo( ({"mutter"}),
    "Sie war voellig verzweifelt, als sie zu mir kam. Alle Bemuehungen, "
    "aus dem Jungen einen guten Menschen zu machen, blieben fruchtlos. "
    "Und so konnte ich nur eines tun.",
    "seufzt: ");

  AddInfo( ({"hilfe"}),
    "Wobei willst Du mir denn helfen?",
    "fragt: ");

  AddInfo( ({"schicksal"}),
    "Sein Schicksal ist es, auf ewig durch den Wald zu irren und "
    "Fremden seine Streiche zu spielen... solange, bis er von "
    "jemandem erloest wird.",
    "erklaert: ");

  AddInfo( ({"fremde", "fremden"}),
    "Fremden Abenteurern wie Dir.",
    "sagt: ");

  AddInfo( ({"erloesen"}),
    "Die einzige Moeglichkeit, ihn zu erloesen, ist es, es ihm gleichzutun "
    "und ihm einen hinterlisten Streich zu spielen. Das ist nicht ganz "
    "leicht, doch... ich haette da eine Idee...",
    "erklaert: ");

  AddInfo( ({"moeglichkeit"}),
    "Es gibt nur diese eine Moeglichkeit.",
    "sagt: ");

  AddInfo( ({"idee"}),
    "Ich kann Dir zeigen, wie Du dem Waldpuck einen Streich spielen "
    "kannst... dafuer musst Du mir allerdings den Samen einer bestimmten "
    "Pflanze bringen, die hier im Wald waechst.",
    "denkt nach: ");

  AddInfo( ({"samen"}),
    "Ich brauche mehrere Samen dieser recht seltenen Pflanze.",
    "sagt: ");

  AddInfo( ({"pflanze"}),
    "Es handelt sich um die sogenannte Juckbohne, die hier im Wald waechst. "
    "Du kannst sie an der intensiven, violettaehnlichen Faerbung ihrer "
    "Blaetter erkennen.",
    "sagt: ");

  AddInfo( ({"faerbung", "blaetter"}),
    "Die Blaetter der Pflanze sehen violettfarben aus.",
    "sagt: ");

  AddInfo( ({"samen"}),
    "Die Juckbohne ist der Samen einer seltenen Pflanze, die hier im Wald "
    "waechst.",
    "sagt: ");

  AddInfo( ({"juckbohne", "juckbohnen"}),
    "Die Juckbohne ist recht selten, also schau Dich am besten gut im "
    "Wald um, damit Du sie nicht uebersiehst. Bring mir ein paar dieser "
    "Samen, dann koennen wir weitersehen.",
    "sagt: ");

  AddInfo( ({"juckpulver"}),
    "Damit kannst Du den Waldpuck von seinem Schicksal erloesen.",
    "zwinkert: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,45);

  AddSpell(1,0,
    BS(Name(WER, 1)+" wird ploetzlich von einem gleissenden Licht "
    +"umgeben, so dass Du sie kaum noch erkennen kannst.\n"),
    BS(Name(WER, 1)+" wird ploetzlich von einem gleissenden Licht "
    +"umgeben, so dass Du sie kaum noch erkennen kannst.\n"),
    DT_MAGIC, "licht_spell");

  AddSpell(2,350,
    Name(WER, 1)+" hebt ein Holzscheit auf und wirft es nach Dir!\n",
    Name(WER, 1)+" hebt ein Holzscheit auf und wirft es nach @WEM!\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(3,1,DS_ANTIMAGIC,
    BS(Name(WER, 1)+" murmelt ein paar leise Worte und Du fuehlst, "
    +"wie Deine Konzentration nachlaesst.\n"),
    "@WER kann sich nicht mehr auf den Kampf konzentrieren.\n", 3);

  AddDefaultSpell(2,1,DS_DRAIN_MANA,
    BS(Name(WER, 1)+" entzieht Dir einen Teil Deiner Magie!\n"),
    "Hyara entzieht @WEM etwas Magie!\n");

//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" summt leise vor sich hin.\n",
    Name(WER, 1)+" blickt kurz aus dem Fenster.\n",
    Name(WER, 1)+" betrachtet Dich von oben bis unten.\n",
    Name(WER, 1)+" schreibt etwas in ihr Notizbuch.\n",
    Name(WER, 1)+" gruebelt vor sich hin.\n",
    Name(WER, 1)+" runzelt nachdenklich die Stirn.\n" }));

  SetAttackChats(10,
  ({Name(WER, 1)+" spricht einen alten Zauberspruch.\n",
    Name(WER, 1)+" blickt Dich zornig an.\n",
    Name(WER, 1)+" droht: Gib lieber auf, solange Du noch kannst!\n",
    Name(WER, 1)+" ruft: Hast Du keinen Respekt vor einer alten Frau?!\n" }));

//--Ausruestung------------------------------------------------------------

  SUID;

  CLONEME(ARMOUR "tuch");
  command("trage alles");

//--Create Ende------------------------------------------------------------

}

//--Logs-------------------------------------------------------------------

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt Hyara.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
      ctime()+": Hyara hat gerade "+CAP(getuid(player))
                  +" umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "laechelt gutmuetig.",
        "laechelt gutmuetig.");
      break;

    case "aergerlich":
    case "frech":
      call_out("reaction", 0, TP,
        "runzelt die Stirn.",
        "runzelt die Stirn.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "schmunzelt ein wenig.",
        "schmunzelt ein wenig.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "warnt Dich: Lass das lieber!",
        "warnt "+TP->name(WEN)+": Lass das lieber!");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dir zu.",
        "laechelt "+TP->name(WEM)+" zu.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "zwinkert Dir zu.",
        "zwinkert "+TP->name(WEM)+" zu.");
      break;

    case "nett":
    case "neutral":
      call_out("reaction", 0, TP,
        "nickt Dir freundlich zu.",
        "nickt "+TP->name(WEM)+" freundlich zu.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "laechelt Dir troestend zu.",
        "laechelt "+TP->name(WEM)+" troestend zu.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));

  ENV(TO)->Message(BS(Name(WER, 1)+" "+andere),
  MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ pl })]));
}

//--Funktionen-------------------------------------------------------------

void licht_spell(object enemy, int damage, mixed dam_type)
{
  if(!licht)
  {
     licht = 1 + random(3);
  }
  return;
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if(licht)
  {
     licht--;
     return ::Defend(0, dam_type, spell, enemy);
  }
  return ::Defend(dam, dam_type, spell, enemy);
}

//Juckbohne geben:
void give_notify(object was)
{
  if(was->id("\nhyara_juckbohne"))
  {
     if(beschaeftigt == NEIN)
     {
        ENV(TO)->Message(BS(Name(WER, 1)+" sagt: Zeig mal her, was haben "
        +"wir denn da..."), MSGFLAG_SOUND);

        if(was->QueryProp(P_AMOUNT) < 3)
        {
            call_out("seqnachfrage", 4 , TP, 1);
            return;
        }

        if(was->QueryProp(P_AMOUNT) >= 3)
        {
            beschaeftigt = JA;
            SetChats(0, ({""}));
            call_out("seqpulver", 4 , TP, 1);
            return;
        }
     }
     else
     {
        write(BS("Hyara ist gerade beschaeftigt."));
        return;
     }
  }

  return::give_notify(was);
}

//Sequenz, wenns zu wenig Juckbohnen waren:
void seqnachfrage(object player, int pos)
{
  string s;
  string s2;

  if(!player || ENV(player) != ENV(TO))
  {
     set_back();
     return;
  }

  switch(pos)
  {
     case 1:
     command("sage Oh, eine Juckbohne, vielen Dank! Ohje, ich fuerchte, "
     +"das reicht noch nicht ganz, ich benoetige noch mehr davon.");
     break;

     case 2:
     s = Name(WER, 1)+" blickt Dich abwartend an.";
     s2 = Name(WER, 1)+" blickt "+player->Name()+" abwartend an.";
     break;

     default:
     set_back();
     return;
     break;
  }

  tell_object(player, break_string(s, 78, 0, 1));

  ENV(TO)->Message(break_string(s2, 78, 0, 1),
  MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

  pos = pos + 1;
  call_out("seqnachfrage", 3, player, pos);
}

//Sequenz, wenns ausreichend Juckbohnen sind:
void seqpulver(object player, int pos)
{
  string s;
  string s2;

  if(!player || ENV(player) != ENV(TO))
  {
     set_back();
     return;
  }

  switch(pos)
  {
     case 1:
     command("sage In Ordnung, das reicht nun. Warte bitte kurz.");
     break;

     case 2:
     s = Name(WER, 1)+" oeffnet den Vorratsschrank, nimmt eine kleine "
     +"blaue Schuessel sowie einen Moerser aus ihm heraus und stellt "
     +"beides vor sich auf den Tisch.";
     s2 = Name(WER, 1)+" oeffnet den Vorratsschrank, nimmt eine kleine "
     +"blaue Schuessel sowie einen Moerser aus ihm heraus und stellt "
     +"beides vor sich auf den Tisch.";
     break;

     case 3:
     s = "Sie entfernt die hauchduenne Schale der Juckbohnen und legt die "
     +"uebrig gebliebenen weisslichen Kerne in die Schuessel hinein.";
     s2 = "Sie entfernt die hauchduenne Schale der Juckbohnen und legt die "
     +"uebrig gebliebenen weisslichen Kerne in die Schuessel hinein.";
     break;

     case 4:
     s = "Dann zerstampft sie die Kerne mit dem Moerser, fuegt noch einige "
     +"scharf riechende Kraeuter hinzu und verruehrt das Ganze ein paar "
     +"Minuten lang.";
     s2 = "Dann zerstampft sie die Kerne mit dem Moerser, fuegt noch einige "
     +"scharf riechende Kraeuter hinzu und verruehrt das Ganze ein paar "
     +"Minuten lang.";
     break;

     case 5:
     s = "Schliesslich fuellt sie die entstandene pulverartige Substanz in "
     +"eine kleine Tuete und verschliesst sie sorgfaeltig.";
     s2 = "Schliesslich fuellt sie die entstandene pulverartige Substanz in "
     +"eine kleine Tuete und verschliesst sie sorgfaeltig.";
     break;

     case 6:
     s = Name(WER, 1)+" erklaert: Schuette dem Waldpuck einfach dieses "
     +"Pulver ueber den Kopf\n"+Name(WER, 1)+" erklaert: und sage dabei "
     +"die Worte, die ich Dir auf diesem Zettel\n"+Name(WER, 1)+" erklaert: "
     +"aufgeschrieben habe.";
     s2 = Name(WER, 1)+" erklaert "+player->Name(WEM)+" etwas.";
     break;

     case 7:
     s = Name(WER, 1)+" drueckt Dir die kleine Tuete und einen Zettel "
     +"in die Hand.";
     s2 = Name(WER, 1)+" drueckt "+player->Name(WEM)+" die kleine Tuete "
     +"und einen Zettel in die Hand.";
     fktjuckpulver(player);
     fktzettel(player);
     break;

     case 8:
     s = Name(WER, 1)+" sagt: Wenn Du alles richtig gemacht hast, wird der "
     +"Waldpuck von seinem\n"+Name(WER, 1)+" sagt: Fluch erloest werden.";
     s2 = Name(WER, 1)+" nickt "+player->Name(WEM)+" noch einmal "
     +"freundlich zu.";
     break;

     default:
     present("\nhyara_juckbohne")->AddAmount(-3);
     set_back();
     return;
     break;
  }

  tell_object(player, break_string(s, 78, 0, 1));

  ENV(TO)->Message(break_string(s2, 78, 0, 1),
  MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE: ({ player })]));

  pos = pos + 1;
  call_out("seqpulver", 8, player, pos);
}

//Chats zuruecksetzen:
void set_back()
{
  beschaeftigt = NEIN;

  SetChats(3,
  ({Name(WER, 1)+" summt leise vor sich hin.\n",
    Name(WER, 1)+" blickt kurz aus dem Fenster.\n",
    Name(WER, 1)+" betrachtet Dich von oben bis unten.\n",
    Name(WER, 1)+" schreibt etwas in ihr Notizbuch.\n",
    Name(WER, 1)+" gruebelt vor sich hin.\n",
    Name(WER, 1)+" runzelt nachdenklich die Stirn.\n" }));

   return;
}

//Juckpulver aushaendigen:
int fktjuckpulver(object player)
{
  object myjuckpulver;

  myjuckpulver = clone_object(OBJ "juckpulver");

  if(ME_TOO_HEAVY == myjuckpulver->move(player, M_GET|M_SILENT))
  {
      tell_object(player, BS("Das Juckpulver wird Dir zu schwer und Du "
      +"laesst es auf den Boden fallen."));

      myjuckpulver->move(ENV(TO), M_PUT|M_SILENT);
      return -1;
  }
  else
  {
      return 1;
  }
}

//Zettel aushaendigen:
int fktzettel(object player)
{
  object myzettel;

  myzettel = clone_object(OBJ "zettel");

  if(ME_TOO_HEAVY == myzettel->move(player, M_GET|M_SILENT))
  {
      tell_object(player, BS("Der Zettel wird Dir zu schwer und Du legst "
      +"ihn auf dem Boden ab."));

      myzettel->move(ENV(TO), M_PUT|M_SILENT);
      return -1;
  }
  else
  {
      return 1;
  }
}
