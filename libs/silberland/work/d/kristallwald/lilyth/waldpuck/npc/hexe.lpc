#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

//--Variablen&Defines------------------------------------------------------

int licht;  //Zaehlvariable fuer Licht-Spell
int beschaeftigt;  //fuer die Sequenz
int fktjuckpulver(object player);  //Juckpulver rausruecken
int fktzettel(object player);  //Zettel aushaendigen
void set_back();  //Chats zuruecksetzen

//--Create-----------------------------------------------------------------

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  licht = 0;
  beschaeftigt = NEIN;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Hyara, die weise Zauberin");
  SetProp(P_LONG,
    "Hyara ist eine weise, alte Frau, die sich vor langer Zeit im "
    "Tethyrwald niedergelassen hat. Sie hat lange, schneeweisse Haare und "
    "runzelige Haut, die von ihrem hohen Alter zeugt. Doch ihre tiefblauen "
    "Augen blicken Dich mit hellwacher Aufmerksamkeit an und registrieren "
    "jede noch so kleine Bewegung von Dir. Du solltest sie lieber nicht "
    "unterschaetzen, denn sie ist sehr bewandert in der alten Magie.");

  AddDetail( ({ "zeit", "jahre", "jahren" }),
    "Hyara lebt schon seit vielen Jahren in ihrer kleinen Huette im "
    "Wald von Tethyr.");

  AddDetail( ({ "huette" }),
    "Vermutlich stehst Du gerade in ihr, denn Hyara verlaesst ihr Heim "
    "nicht sehr haeufig.");

  AddDetail( ({ "heim" }),
    "Hyara wohnt in einer kleinen Huette im Tethyrwald.");

  AddDetail( ({ "tethyrwald", "tethyr", "wald" }),
    "Du befindest irgendwo mittendrin.");

  AddDetail( ({ "haare", "haar" }),
    "Ihre Haare sind schneeweiss.");

  AddDetail( ({ "haut", "faeltchen", "falten" }),
    "Ihre Haut ist schon sehr runzlig und zahlreiche Faeltchen schmuecken "
    "ihr Gesicht.");

  AddDetail( ({ "gesicht", "schoenheit" }),
    "Obwohl man Hyara nicht unbedingt huebsch nennen kann, strahlt ihr "
