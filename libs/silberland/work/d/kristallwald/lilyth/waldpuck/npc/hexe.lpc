  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"hyara", "zauberin", "hexe", "frau", "NOWIMPY"}));
  AddClass( ({CL_HUMAN}) );
  SetProp(P_ARTICLE, 0);

  set_living_name("hyara");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(28);

  SetProp(P_HANDS, ({ " mit uralter Magie", 280, DT_MAGIC }) );

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 165);
  SetProp(P_WEIGHT, 62000);
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
