#include "../def.h"
#include <ansi.h>

//--Variablen&Defines------------------------------------------------------

int messagelevel;

//--Create-----------------------------------------------------------------

void create()
{
  if(is_clone(this_object()))
  {
    destruct(this_object());
    return;
  }

  seteuid(getuid(this_object()));

  return;

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

int lvl_sort(object ob1, object ob2)
{
  if (query_wiz_level(ob1)<query_wiz_level(ob2)) return 1;
  if (query_wiz_level(ob1)>query_wiz_level(ob2)) return 0;
  if ((ob1->query_real_name())<(ob2->query_real_name())) return 1;
  return 0;
}

// Wer befindet sich gerade in der Hexenhuette/in der Hoehle vom Waldpuck?
int puckwho()
{
  string s,fn;
  object *us;
  object ob,env;
  int i,sz;

  s="";

  sz=strlen(ROOM)-1;

  if (!TP || !IS_WIZARD(TP)) return 0;

  us=users();
  us=sort_array(us,"lvl_sort",ME);

  s="-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*"
   +"\n\n                             "
   +ANSI_BOLD+ANSI_YELLOW+"Waldpuck"+ANSI_NORMAL+"\n\n";

  s+="Wizlevel\tLevel\t\Name\tRoom\n\n";

  for (i=0;i<=sizeof(us)-1;i++)
  {
    ob=us[i];
    env=environment(ob);

    if (!env) continue;

    fn=file_name(env);

    if (fn[0..sz]!= ROOM ) continue;
    fn="~"+fn[28..];
    s+=extract(sprintf("   %d ",query_wiz_level(ob)),-4,-1)+"\t\t";
    s+=ob->QueryProp(P_LEVEL)+"\t";
    s+=ANSI_YELLOW+(capitalize(ob->query_real_name())+ANSI_NORMAL" ...........")[0..10];
    s+=(" ["+fn+"]");
    s+="\n";
  }

  s+="\n-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*"
    +"\n\n";

  write(s);

  return 1;
}

//Messages
void Msg(string s, int level)
{
  object pl;
  int i;
  string str;

  write_file(LOG "waldpuck.log",ctime()+": "+s+"\n");

  pl = find_player("lilyth");

  if(objectp(pl) && interactive(pl) && IS_WIZARD(pl) && (level <= messagelevel))
  {
    str = BSI(s+"","WALDPUCK: ");
    if(pl->QueryProp(P_TTY)) str = ANSI_BOLD+ANSI_RED+str+ANSI_NORMAL;
    tell_object(pl,str);
  }
}

//Message Level setzen und abfragen
void SetLevel(int level)
{
  messagelevel = level;
}

int QueryLevel()
{
  return messagelevel;
}

//Waldpuck randommaessig in einen der Waldwegraeume setzen
void SetWaldpuck()
{
  object puck;
  object raum;
  object *ROOMS;
  ROOMS = ({ P1,P2,P3,P4,P5 });

  if(!random(10))
  {
    raum = ROOMS[random(sizeof(ROOMS))];

    if(puck=clone_object(NPC"puck"))
    {
      puck->move(raum, M_GO);
    }
  }

  return;
}
