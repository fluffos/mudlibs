#include "../def.h"

inherit "std/room";

//--Variablen&Defines------------------------------------------------------

int kerze;
int schluessel;

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------

  kerze = AUS;
  schluessel = DA;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Eine kleine Erdhoehle");
//SetProp(P_INT_LONG, --> siehe unten

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "erdhoehle", "hoehle" }),
    "Du befindest Dich in einer kleinen, dunklen Erdhoehle.");

  AddDetail( ({ "haufen", "lumpen", "lumpenhaufen" }),
    "An einer Wand liegen einige alte Lumpen unordentlich auf einem "
    "Haufen auf dem Boden. Sie scheinen eine Art Schlaflager darzustellen "
    "denn in der Mitte des Haufens ist eine kleine, rundliche Mulde zu "
    "sehen.");

  AddDetail( ({ "schlaflager", "lager", "art" }),
    "Der Bewohner dieser Hoehle scheint die Lumpen als Schlaflager zu "
    "benutzen.");

  AddDetail( ({ "bewohner" }),
    "Wer mag das nur sein?");

  AddDetail( ({ "mitte" }),
    "In der Mitte des Lumpenhaufens ist eine kleine, runde Mulde zu sehen.");

  AddDetail( ({ "mulde" }),
    "Sie ist rundlich und recht klein. Sie fuehlt sich sogar "
    "noch ein wenig warm an. Verwundert streichst Du mit Deinen Haenden "
    "ueber den warmen Stoff.");

  AddDetail( ({ "haende", "hand" }),
    "Du streichst mit Deinen Haenden gedankenvoll ueber die noch warme "
    "Mulde, als Du ploetzlich glaubst, einen kleinen Gegenstand unter "
    "all den Lumpen fuehlen zu koennen.");

  AddDetail( ({ "stoff", "kleidung" }),
    "Die Lumpen bestehen aus ziemlich schmuddeligen, alten "
    "Kleidungsstuecken.");

  AddDetail( ({ "kleidungsstuecke", "kleidungsstueck" }),
    "Sie sind sehr schmutzig und verdreckt und kaum noch als Kleidung "
    "erkennbar.");

  AddDetail( ({ "gegenstand" }),
    "Irgendetwas scheint in dem Haufen versteckt zu sein.");

  AddDetail( ({ "ecke" }),
    "In einer dunklen Ecke auf dem Boden steht eine kleine Holzkiste.");

  AddDetail( ({ "holzkiste", "kiste" }),
    "Eine kleine Holzkiste steht in einer Ecke auf dem Boden. Obwohl sie "
    "nicht sehr gross ist, sieht sie unheimlich schwer aus. Zudem ist sie "
    "mit einem dicken Schloss gesichert. Was da wohl drin sein mag?");

  AddDetail( ({ "schloss" }),
    "Das Schloss sieht ziemlich unnachgiebig aus. Das bekommst Du wohl nur "
    "mit dem dazugehoerigen Schluessel auf.");

  AddDetail( ({ "schluessel" }),
    "Wo sollst Du den bloss herbekommen?");

  AddDetail( ({ "holz" }),
    "Das einzige, was hier unten aus Holz besteht, ist die kleine "
    "Holzkiste.");

  AddDetail( ({ "erde" }),
    "Die Waende um Dich herum, die Decke, der Boden... alles hier besteht "
    "aus dunkler Erde. Darum heisst diese Hoehle uebrigens auch Erdhoehle.");

  AddDetail( ({ "boden" }),
    "Der Boden der Hoehle besteht aus kahler, dunkler Erde, die schon "
    "ziemlich festgetreten ist.");

  AddDetail( ({ "waende", "wand" }),
    "Die Waende bestehen aus dunkler, trockener Erde. An einer der Waende "
    "liegt ein Haufen Lumpen auf dem Boden. Darueber kannst Du ein paar "
    "seltsame Striche in der Wand sehen.");

  AddDetail( ({ "striche" }),
    "Als Du naeher hinsiehst, merkst Du, dass die Striche in der Wand "
    "eine etwas krakelige Zeichnung darstellen, die jemand dort in die "
    "Erde eingeritzt hat.");

  AddDetail( ({ "zeichnung" }),
    "Die Zeichnung scheint ein Menschenkind darzustellen, das mitten in "
    "einem grossen Wald steht.");

  AddDetail( ({ "menschenkind", "kind", "junge", "jungen" }),
    "Bei dem Kind auf der Zeichnung handelt sich um einen menschlichen "
    "Jungen, der von Wald und Baeumen umringt wird. Du kannst nicht genau "
    "sagen, warum, doch er macht irgendwie einen sehr ungluecklichen "
    "Eindruck.");

  AddDetail( ({ "baeume", "baum" }),
    "Auf der Zeichnung sind einige Baeume dargestellt.");

  AddDetail( ({ "eindruck" }),
    "Er laechelt zwar, doch seine Augen wirken kummervoll und sehr "
    "traurig.");

  AddDetail( ({ "augen" }),
    "Du bekommst fast Mitleid mit ihm.");

  AddDetail( ({ "mitleid" }),
    "Auch wenn es nur eine Zeichnung ist, empfindest Du fast ein wenig "
    "Mitleid fuer den Jungen, der darauf abgebildet ist.");

  AddDetail( ({ "decke" }),
    "In der Decke ueber Dir siehst Du das kleine Loch, durch das Du "
    "hier herunter in die Hoehle gelangt bist.");

  AddDetail( ({ "loch" }),
    "Durch das Loch in der Decke kommst Du wieder zurueck in den Wald.");

  AddDetail( ({ "wald", "tethyrwald" }),
    "Der befindet sich irgendwo ueber Dir.");

  AddDetail( ({ "tageslicht" }),
    "Von draussen dringt ein wenig Tageslicht herein, doch es alleine "
    "reicht nicht aus, um die Hoehle zu erhellen.");

  AddDetail( ({ "vorhaben" }),
    "Was hast Du denn nun vor?");

  AddSpecialDetail( ({ "kerze" }),
    "strkerze");

  AddSpecialDetail( ({ "licht", "kerzenlicht" }),
    "strlicht");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Hier unten in der Hoehle riecht es irgendwie nach Erde.");

  AddSmell( ({ "hoehle" }),
    "Es riecht erdig.");

  AddSmell( ({ "erde" }),
    "Ob das wohl damit zusammenhaengt, dass die gesamte Hoehle aus Erde "
    "besteht? Wer weiss...");

//--Ausgaenge--------------------------------------------------------------

//AddExit( "raus", "nach draussen#" + "./waldraum" );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "zuend", "zuende" }), "anzuenden" );
  AddCmd( ({ "loesch", "loesche", "pust", "puste" }), "loeschen" );
  AddCmd( ({ "wuehl", "wuehle", "durchwuehl", "durchwuehle", "durchsuch",
  "durchsuche" }), "wuehlen" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(OBJ "kiste", REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_int_long()
{
  string txt;
  string s;
  
  if(kerze == AN)
  {
        s = "Daneben steht eine kleine, brennende Kerze, die ein wenig "
           +"Licht spendet.";
  }
  else
  {
        s = "Daneben steht eine kleine Kerze, die jedoch "
           +"sorgsam geloescht wurde.";
  }

  txt = "Ein wenig verwundert fragst Du Dich, wo Du denn nun wohl gelandet "
       +"sein magst. Als Du Dich genauer umschaust, merkst Du, dass Du Dich "
       +"in einer kleinen Erdhoehle befindest, die anscheinend von "
       +"irgend jemandem bewohnt wird. An einer Wand entdeckst Du einen "
       +"Haufen alter Lumpen auf dem Boden, die wohl ein Schlaflager "
       +"darstellen sollen. "+s+" Ansonsten ist die Hoehle sehr karg und es "
       +"gibt scheinbar nicht viel mehr zu entdecken, bis auf die kleine "
       +"Holzkiste, die in einer Ecke auf dem Boden steht.";

  return BS(txt);
}

//Kerze anzuenden:
int anzuenden(string str)
{
  notify_fail("Was moechtest Du anzuenden?\n");

  if(!str || str == "") return 0;

  if(!(str == "kerze an" )) return 0;

  if(kerze == AUS)
  {
        write(BS("Du zuendest die Kerze vorsichtig an.\n"));

        TO->Message(BS(TP->Name(WER, 1)+" zuendet vorsichtig die Kerze an."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        SetProp(P_LIGHT, 1);
        kerze = AN;
        return 1;
  }
  else
  {
        write(BS("Aber die Kerze brennt doch bereits!\n"));
        return -1;
  }
}

//Kerze loeschen:
int loeschen(string str)
{
  notify_fail("Was moechtest Du loeschen?\n");

  if(!str || str == "") return 0;

  if(!(str == "kerze" ||
       str == "kerze aus" )) return 0;

  if(kerze == AN)
  {
        write(BS("Du pustest die Kerze aus.\n"));

        TO->Message(BS(TP->Name(WER, 1)+" pustet die Kerze aus."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        SetProp(P_LIGHT, 0);
        kerze = AUS;
        return 1;
  }
  else
  {
        write(BS("Aber die Kerze brennt doch gar nicht!\n"));
        return -1;
  }
}

//Lumpen durchwuehlen:
int wuehlen(string str)
{
  object myschluessel;
  
  notify_fail("Worin moechtest Du herumwuehlen?\n");

  if(!str || str == "") return 0;

  if(!(str == "in lumpen" ||
       str == "in lumpen herum" ||
       str == "lumpen" ||
       str == "haufen" ||
       str == "in haufen" ||
       str == "in haufen herum" ||
       str == "in schlaflager" ||
       str == "in schlaflager herum" )) return 0;

  if(schluessel == DA)
  {
        myschluessel = clone_object(OBJ "schluessel");
        
        write(BS("Du durchwuehlst das Schlaflager und findest tatsaechlich "
        +"einen kleinen, silbrig glaenzenden Schluessel unter all den "
        +"Lumpen versteckt."));

        TO->Message(BS(TP->Name(WER, 1)+" wuehlt in den Lumpen herum und "
        +"scheint tatsaechlich etwas gefunden zu haben."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        if(ME_TOO_HEAVY == myschluessel->move(TP,M_GET|M_SILENT))
        {
             myschluessel->move(ENV(TP), M_PUT|M_SILENT);

             write(BS("Da Du den Schluessel nicht mehr tragen "
             +"kannst, legst Du ihn auf den Boden."));

             TO->Message(BS(TP->Name(WER, 1)+" legt einen Schluessel "
             +"auf dem Boden ab."),
             MSGFLAG_VISUAL|MSGFLAG_NO_TP);
             return -1;
        }

        schluessel = WEG;
        return 1;
  }
  else
  {
        write(BS("Du durchwuehlst das Schlaflager, doch es ist nichts zu "
        +"finden. Schade."));
        
        TO->Message(BS(TP->Name(WER, 1)+" wuehlt in den Lumpen herum, "
        +"scheint jedoch nichts zu finden."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        return -1;
  }
}

reset()
{
	::reset();
	
	schluessel = DA;
	
	if(kerze == AN)
	{
	    TO->Message(BS("Ein frischer Windzug dringt in die Hoehle und "
	    +"die Kerze auf dem Boden erlischt."),
	    MSGFLAG_VISUAL);
	    kerze = AUS;
	    SetProp(P_LIGHT, 0);
	}
}

//--Funktionen fuer SpecialDetails-----------------------------------------

string strkerze(string str)
{
  string s;

  if(kerze == AN)
  {
  	s = "Die Kerze brennt und erhellt die Hoehle ein wenig. Anscheinend "
  	+"hat jemand vergessen, sie zu loeschen.";
  }
  else
  {
  	s = "Die Kerze wurde sorgsam von jemandem ausgeloescht. Wenn es Dir "
  	+"hier unten zu dunkel ist, solltest Du sie einfach wieder "
  	+"anzuenden.";
  }
  return BS(s);
}

string strlicht(string str)
{
  string s;

  if(kerze == AN)
  {
  	s = "Die Kerze spendet ein wenig Licht, so dass Du alles in der "
  	+"Hoehle gut erkennen kannst.";
  }
  else
  {
  	s = "Das wenige Tageslicht, dass von draussen hereindringt, reicht "
  	+"nicht aus, um die Hoehle zu erhellen.";
  }
  return BS(s);
}
