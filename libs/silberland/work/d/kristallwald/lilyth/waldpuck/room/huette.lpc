      D_NAME,         "Holztuer",
      D_GENDER,       FEMALE,
      D_SHORT,        "Eine kleine, gruene Holztuer. Sie ist %s.",
      D_LONG,         "Durch diese Tuer gelangst Du zurueck in den Wald.",
      D_TESTFUNC,     "exit_test",
      D_MSGS,         ({"die Huette",
                        "verlaesst",
                        "kommt aus der Huette heraus"}),
      D_OPENMSG,      ({"Du oeffnest die gruene Holztuer.",
                        "%s oeffnet die gruene Holztuer.",
                        " wird von draussen geoeffnet."}),
      D_CLOSEMSG,     ({"Du schliesst die Holztuer.",
                        "%s schliesst die Holztuer.",
                        " wird von draussen geschlossen."}),
      D_RESET_CLOSEMSG, " wird durch einen Windstoss geschlossen." }) );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "zuend", "zuende", "entfach", "entfache" }), "zuenden" );
  AddCmd( ({ "loesch", "loesche" }), "loeschen" );
  AddCmd( ({ "leg", "lege" }), "legen" );
  AddCmd( ({ "blick", "blicke" }), "blicken" );
  AddCmd( ({ "reiss", "reisse" }), "reissen" );
  AddCmd( ({ "zieh", "ziehe" }), "ziehen" );
  AddCmd( ({ "oeffne" }), "oeffnen" );
  AddCmd( ({ "sitz", "sitze" }), "sitzen" );
  AddCmd( ({ "steh", "stehe" }), "aufstehen" );
  AddCmd( ({ "lieg", "liege" }), "liegen" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(NPC "hexe", REFRESH_DESTRUCT);

//--Create Ende------------------------------------------------------------

