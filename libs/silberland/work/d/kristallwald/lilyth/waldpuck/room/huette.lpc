//--Funktionen fuer SpecialDetails-----------------------------------------

string strkamin(string str)
{
  string s;

  if(feuer == AN)
  {
  	s = "Noerdlich von Dir siehst Du einen kleinen, offenen Kamin, in "
  	   +"dem ein Feuer brennt.";
  }
  else
  {
     if(papier_in_kamin == JA)
     {
        if(holz_in_kamin == NEIN)
        {
            s = "Noerdlich von Dir siehst Du einen kleinen, offenen Kamin. "
               +"Ein kleines, zusammengeknuelltes Stueck Papier liegt in "
               +"ihm. Anscheinend will da gerade jemand ein Feuer "
               +"entzuenden.";
        }
        else
        {
            s = "Noerdlich von Dir siehst Du einen kleinen, offenen Kamin. "
               +"Ein zusammengeknuelltes Stueck Papier sowie ein paar "
               +"Holzscheite liegen in ihm. Anscheinend will da gerade "
               +"jemand ein Feuer entzuenden.";
        }
     }
     else
     {
  	s = "Noerdlich von Dir siehst Du einen kleinen, offenen Kamin. "
  	   +"Gerade, als Du Dich darueber zu wundern beginnst, dass gar "
  	   +"kein Feuer in dem Kamin brennt, faellt Dein Blick auf ein paar "
  	   +"grob geschnitzte Holzscheite, die vor dem Kamin auf dem Boden "
  	   +"liegen.";
     }
  }
  return BS(s);
}

string strpapier(string str)
{
  string s;

  if(papier_in_kamin == JA)
  {
  	s = "Ein kleines, zusammengeknuelltest Stueck Papier liegt im "
  	+"Kamin, bereit, angezuendet zu werden.";
  }
  else
  {
        s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

string strfeuer(string str)
{
  string s;

  if(feuer == AN)
  {
  	s = "Ein kleines Feuer prasselt im Kamin und fuellt die kleine "
  	   +"Huette mit behaglicher Waerme.";
  }
  else
  {
  	s = "Es brennt kein Feuer im Kamin. Aber vielleicht koenntest Du "
  	   +"ja eines entfachen?";
  }
  return BS(s);
}

string strwaerme(string str)
{
  string s;

  if(feuer == AN)
  {
  	s = "Es ist angenehm warm hier drinnen.";
  }
  else
  {
  	s = "Es ist gerade warm genug, dass Du nicht zu frieren brauchst.";
  }
  return BS(s);
}

string strschuhe(string str)
{
  string s;

  if(fackel == DA)
  {
  	s = "Ein Paar gruene Hausschuhe steht vor dem Bett auf dem Boden, "
  	+"so dass Hyara morgens nach dem Aufstehen schnell hineinschluepfen "
  	+"kann. Hinter den Schuhen siehst du etwas Laengliches unter dem "
  	+"Bett hervorlugen.";
  }
  else
  {
        s = "Ein Paar gruene Hausschuhe steht vor dem Bett auf dem Boden, "
  	+"so dass Hyara morgens nach dem Aufstehen schnell hineinschluepfen "
  	+"kann.";
  }
  return BS(s);
}

