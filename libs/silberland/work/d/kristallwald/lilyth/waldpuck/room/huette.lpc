  AddSpecialDetail( ({ "kamin" }),
    "strkamin");

  AddSpecialDetail( ({ "feuer" }),
    "strfeuer");

  AddSpecialDetail( ({ "papier", "stueck" }),
    "strpapier");

  AddSpecialDetail( ({ "paar", "hausschuhe", "schuhe" }),
    "strschuhe");

  AddSpecialDetail( ({ "unter bett", "unter das bett" }),
    "strbett");

  AddSpecialDetail( ({ "interessantes" }),
    "strinteressantes");

  AddSpecialDetail( ({ "laengliches" }),
    "strlaengliches");

  AddSpecialDetail( ({ "fackel" }),
    "strfackel");

  AddSpecialDetail( ({ "stuhl", "holzstuhl" }),
    "strstuhl");

  AddSound(DEFAULT_SOUND,
    #'str_sound);

  AddSound( ({ "prasseln", "feuer" }),
    #'str_feuer);

  AddSound( ({ "kamin" }),
    #'str_kamin);

  AddSmell( DEFAULT_SMELL,
    "Die ganze Huette wird von einem intensiven Kraeutergeruch erfuellt. "
    "Ausserdem kannst Du einen schwachen Blumenduft wahrnehmen.");

  AddSmell( ({ "huette", "geruch", "kraeutergeruch" }),
    "Hier drinnen riecht es nach den verschiedensten Kraeutern.");

  AddSmell( ({ "kraeuter", "kraut" }),
    "Du kannst sie nicht einzeln bestimmen, doch der Geruch ist nicht "
    "unangenehm.");

  AddSmell( ({ "blumenduft", "duft", "blumen", "strauss", "blumenstrauss" }),
    "Der Blumenstrauss auf dem Tisch riecht herrlich nach Wald und Wiesen.");

  AddSmell( ({ "wald", "wiese", "wiesen" }),
    "Du hast fast das Gefuehl, mitten im Wald zu stehen.");

  AddSmell( ({ "gefuehl" }),
    "Nun ja, genaugenommen befindest Du Dich ja auch mitten in einem Wald.");

//--Ausgaenge--------------------------------------------------------------

  NewDoor( ({"raus"}), ROOM "waldraum_prov", ({"tuer","holztuer"}),
