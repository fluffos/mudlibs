#include "../def.h"

inherit "std/room";

//--Variablen&Defines------------------------------------------------------

int feuer; //Feuer an oder aus?
int papier; //Papier da, ja oder nein?
int fackel; //Fackel da, ja oder nein?
int papier_in_kamin; //ist Papier im Kamin?
int holz_in_kamin; //ist Holz im Kamin?
int i; //Zaehlvariable fuer Papier finden

string str_sound(string key);
string str_feuer(string key);
string str_kamin(string key);

#define STUHL(wer) (member(stuhl, capitalize(getuid(wer)))!=-1)
string *stuhl=({});

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------

  feuer = AUS;
  papier = DA;
  fackel = DA;
  papier_in_kamin = NEIN;
  holz_in_kamin = NEIN;
  i = 1;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Eine kleine Huette im Wald");
//SetProp(P_INT_LONG, --> siehe unten

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "huette" }),
    "Du befindest Dich mitten im Tethyrwald in einer kleinen Huette. "
    "Sie gehoert Hyara, der weisen Zauberin.");

  AddDetail( ({ "tethyrwald", "wald", "tethyr" }),
    "Wenn Du den Wald sehen willst, solltest Du entweder vor die Tuer "
    "gehen oder aus dem Fenster blicken.");

  AddDetail( ({ "sueden", "suedwand" }),
    "Im Sueden fuehrt eine kleine, gruene Holztuer wieder hinaus in den "
    "Wald.");

  AddDetail( ({ "hyara", "zauberin", "weise zauberin" }),
    "Meistens ist sie hier zu finden.");

  AddDetail( ({ "anschein" }),
    "Von draussen sah die Huette viel kleiner aus als von hier drinnen.");

  AddDetail( ({ "raum" }),
    "Die Huette hat nur diesen einzigen Raum, in dem Du jetzt gerade "
    "stehst.");

  AddDetail( ({ "fenster" }),
    "Durch das Fenster im Westen kannst Du den Tethyrwald sehen, der sich "
    "draussen rings um die Huette herum erstreckt.");

  AddDetail( ({ "tisch" }),
    "Ein kleiner, runder Tisch steht unter dem Fenster. Eine hohe Vase mit "
    "frischen Blumen befindet sich darauf. Daneben siehst Du ein kleines, "
    "rotes Buechlein liegen.");

  AddDetail( ({ "vase" }),
    "In der glaesernen Vase, die auf dem Tisch steht, steckt ein kleiner "
    "Strauss Blumen.");

  AddDetail( ({ "glas" }),
    "Die Vase besteht aus durchsichtigem Glas.");

  AddDetail( ({ "strauss", "blumen", "blumenstrauss" }),
    "Ein bunter Blumenstrauss steckt in der Vase. Er sieht sehr frisch "
