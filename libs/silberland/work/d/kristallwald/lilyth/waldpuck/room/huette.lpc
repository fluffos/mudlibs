string strfackel(string str)
{
  string s;

  if(fackel == DA)
  {
  	s = "Vielleicht kannst Du sie unter dem Bett hervorziehen?";
  }
  else
  {
        s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

string strstuhl(string str)
{
  string s;

  s = "Ein einzelner Holzstuhl steht einsam und alleine vor dem Tisch. ";

  if(sizeof(stuhl) == 1)
  {
     if(STUHL(TP))
     {
  	s += "\nDu sitzt gerade darauf.";
     }
     else
     {
        s += "\n"+capitalize(stuhl[0])+" sitzt gerade auf ihm.";
     }
  }
  else
  {
  	s += "\nHyara scheint nicht sehr haeufig Besuch zu empfangen.";
  }

  return break_string(s, 78, 0, BS_LEAVE_MY_LFS);
}

//--Sound------------------------------------------------------------------

string str_sound(string key)
{
  if(feuer == AN)
  {
    return "Du hoerst das leise Prasseln des Feuers.";
  }
  else
  {
    return BS("Es ist sehr still hier.");
  }
}

string str_feuer(string key)
{
  if(feuer == AN)
  {
    return "Das Feuer im Kamin prasselt leise vor sich hin.";
  }
  else
  {
    return BS("Du kannst nichts Besonderes hoeren.");
  }
}

string str_kamin(string key)
{
  if(feuer == AN)
  {
    return "Der Kamin selbst ist ziemlich schweigsam, aber das Feuer in "
    +"ihm prasselt munter vor sich hin.";
  }
  else
  {
    return BS("Der Kamin schweigt mucksmaeuschenstill vor sich hin.");
  }
}

//--Funktionen-------------------------------------------------------------

//Langbeschreibung:
string _query_int_long()
{
  string txt;
  string s;

  if(feuer == AN)
  {
        s = ", in dem ein Feuer brennt.";
  }
  else
  {
        s = ".";
  }

  txt = "Seltsam, von innen wirkt die kleine Huette, in der Du Dich nun "
       +"befindest, um einiges groesser, als es von aussen den Anschein "
       +"hatte. Sie besteht aus nur einem einzigen Raum, der jedoch sehr "
       +"gemuetlich und liebevoll eingerichtet wurde. Unter dem Fenster an "
       +"der westlichen Wand steht ein kleiner, runder Tisch mit einem "
       +"einzelnen Stuhl davor. An der gegenueberliegenden Wand siehst Du "
       +"ein ordentlich gemachtes Bett. Im Norden steht ein Vorratsschrank, "
       +"daneben befindet sich ein offener Kamin"+s;

  if (QueryProp(P_DOOR_INFOS))
  return BS(txt)+(string)call_other(DOOR_MASTER,"look_doors");

  return BS(txt);
}

//Feuer entfachen:
int zuenden(string str)
{
  object myfackel;
  myfackel = present("fackel",TP);

  notify_fail("Was willst Du wo entfachen?\n");

  if(!str || str == "") return 0;

  if(!(str == "feuer" ||
       str == "feuer in kamin" ||
       str == "feuer im kamin" ||
       str == "ein feuer im kamin" ||
       str == "feuer an" )) return 0;

  if(feuer == AN)
  {
        write(BS("Es brennt doch bereits ein Feuer im Kamin."));
        return -1;
  }

  if(papier_in_kamin == NEIN)
  {
    write(BS("Hmm, irgendetwas fehlt dafuer aber noch. Vielleicht findest "
    +"Du ja irgendwo ein wenig Papier, das Du als Brennmaterial verwenden "
    +"kannst."));
    return -1;
  }

  if(!myfackel)
  {
    write(BS("Um das Feuer im Kamin zu entfachen, brauchst Du eine Fackel."));
    return -1;
  }

  if(!(myfackel->_query_lighted()))
  {
    write(BS("Wie waer's, wenn Du die Fackel vorher anzuendest?"));
    return -1;
  }

  if(holz_in_kamin == NEIN)
  {
    write(BS("Vorsichtig zuendest Du das Papier im Kamin an und es faengt "
    +"an zu brennen. Kurz darauf ist das Papier voellig verbrannt und "
    +"es liegt nur noch Asche im Kamin. Vielleicht haettest Du noch ein "
    +"wenig Holz dazulegen sollen?"));

    TO->Message(break_string(TP->Name(WER, 1)+" versucht, ein Feuer im "
    +"Kamin zu entfachen, doch irgendetwas scheint "
    +(TP->QueryProp(P_GENDER)==MALE?"er":"sie")+" wohl vergessen zu haben, "
    +"denn das Feuer erlischt sofort wieder."),
    MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    papier_in_kamin = NEIN;
    return -1;
  }

  write(BS("Du zuendest das zusammengeknuellte Papier im Kamin vorsichtig "
  +"an und schaust neugierig zu, wie die Feuerzungen langsam auf den Stapel "
  +"Holzscheite uebergreifen. Endlich weiten sich die Flaemmchen zu einem "
  +"kleinen Feuer im Kamin aus, das froehlich vor sich hinprasselt und die "
  +"Huette mit einer angenehmen Waerme erfuellt."));

  TO->Message(break_string(TP->Name(WER, 1)+" entfacht gekonnt ein kleines "
  +"Feuer im Kamin.\nEs wird angenehm warm in der Huette."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  feuer = AN;
  papier_in_kamin = NEIN;
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );
  AddRoomMessage( ({"Das Feuer prasselt leise vor sich hin.\n"}), 10);
  init();
  return 1;
}

//Feuer loeschen:
int loeschen(string str)
{
  notify_fail("Was moechtest Du loeschen?\n");

  if(!str || str == "") return 0;

  if(!(str == "feuer" ||
       str == "feuer in kamin" ||
       str == "feuer im kamin" )) return 0;

  if(feuer == AN)
  {
        write(BS("Du loeschst das Feuer im Kamin."));

        TO->Message(BS(TP->Name(WER, 1)+" loescht das Feuer im Kamin."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);

        feuer = AUS;
        SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
        SetProp(P_ROOM_MSG, 0);
        return 1;
  }
  else
  {
        write(BS("Aber es brennt doch ueberhaupt kein Feuer im Kamin!"));
        return -1;
  }
}

//Brennmaterial (Papier + Holz) in Kamin legen:
int legen(string str)
{
  object mypapier;

  notify_fail("Was willst Du wohin legen?\n");

  if(!str || str == "") return 0;

  if(str == "papier in kamin" ||
     str == "papier in kamin hinein" ||
     str == "seite in kamin" ||
     str == "buchseite in kamin" ||
     str == "stueck papier in kamin" ||
     str == "seite in kamin hinein" ||
     str == "buchseite in kamin hinein" ||
     str == "stueck papier in kamin hinein")
  {
     mypapier = present("\npapier",TP);

     if(mypapier)
     {
        if(feuer == AN)
        {
           write(BS("Du knuellst das Stueck Papier zusammen und wirfst es "
           +"in das Feuer hinein, das daraufhin ein wenig aufflackert."));

           TO->Message(break_string(TP->Name(WER, 1)+" wirft etwas in den "
           +"Kamin.\nDas Feuer flackert ein wenig auf."),
           MSGFLAG_VISUAL|MSGFLAG_NO_TP);

           mypapier->remove();
           return 1;
        }
        else
        {
           if(papier_in_kamin == NEIN)
           {
              write(BS("Du knuellst das Stueck Papier zusammen und legst "
              +"es in den Kamin."));

              TO->Message(BS(TP->Name(WER, 1)+" knuellt ein Stueck Papier "
              +"zusammen und legt es dann in den Kamin."),
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);

              papier_in_kamin = JA;
              mypapier->remove();
              return 1;
           }
           else
           {
              write(BS("Es liegt schon ausreichend Papier im Kamin."));
              return -1;
           }
        }
     }
  }

  if(str == "holzscheit in kamin" ||
     str == "holzscheite in kamin" ||
     str == "holzscheit in kamin hinein" ||
     str == "holzscheite in kamin hinein" ||
     str == "scheit in kamin" ||
     str == "scheite in kamin" ||
     str == "scheit in kamin hinein" ||
     str == "scheite in kamin hinein" ||
     str == "holz in kamin" ||
     str == "holz in kamin hinein")
  {
     if(feuer == AN)
     {
        write(BS("Du legst ein grosses Holzscheit in das Feuer und es "
        +"faengt laut an zu prasseln."));

        TO->Message(break_string(TP->Name(WER, 1)+" wirft ein Holzscheit "
        +"in das flackernde Feuer hinein und es faengt laut an zu "
        +"prasseln."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        return 1;
     }
     else
     {
        if(papier_in_kamin == JA)
        {
           if(holz_in_kamin == NEIN)
           {
              write(BS("Du nimmst Dir ein paar Holzscheite vom Boden und "
              +"stapelst sie ordentlich im Kamin auf. So, das sollte fuer "
              +"ein ordentliches Feuerchen genuegen."));

              TO->Message(BS(TP->Name(WER, 1)+" legt ein paar Holzscheite "
              +"in den Kamin."),
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);

              holz_in_kamin = JA;
              return 1;
           }
           else
           {
              write(BS("Es liegen schon genug Holzscheite im Kamin."));
              return -1;
           }
        }
        else
        {
           write(BS("Hm, ein wenig Papier wuerde als Grundlage fuer das "
           +"Feuer sicherlich gute Dienste leisten. Schau Dich mal um, "
           +"vielleicht findest Du ja irgendwo etwas, was Du verwenden "
           +"kannst."));
           return -1;
        }
     }
  }
}

//aus dem Fenster blicken:
int blicken(string str)
{
  notify_fail("Wo moechtest Du hindurchblicken?\n");

  if(!str || str == "") return 0;

  if(!(str == "durch fenster" ||
       str == "durch das fenster" ||
       str == "durch fenster hindurch" ||
       str == "durch das fenster hindurch" ||
       str == "aus fenster" ||
       str == "aus fenster hinaus" ||
       str == "aus dem fenster" ||
       str == "aus dem fenster hinaus")) return 0;

  write(BS("Du schaust neugierig aus dem Fenster und betrachtest "
  +"den riesigen Wald, der sich dort um die Huette herum erstreckt."));

  TO->Message(BS(TP->Name(WER, 1)+" blickt aus dem Fenster hinaus."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;
}

//Seite aus Buch reissen:
int reissen(string str)
{
  object myseite;

  notify_fail("Was willst Du wo herausreissen?\n");

  if(!str || str == "") return 0;

  if(!(str == "seite aus buch" ||
       str == "seiten aus buch" ||
       str == "seite aus buch heraus" ||
       str == "seiten aus buch heraus" ||
       str == "seite aus notizbuch" ||
       str == "seite aus notizbuch heraus")) return 0;

  if(i<4)
  {
     myseite = clone_object(OBJ "papier");

     write(BS("Unauffaellig reisst Du eine der noch unbeschriebenen Seiten "
     +"aus dem Buch heraus. Na, hoffentlich bemerkt Hyara das nicht, sie "
     +"waere sicherlich nicht sehr erfreut darueber, dass Du ihr Eigentum "
     +"beschaedigst."));

     TO->Message(break_string(TP->Name(WER, 1)+" reisst eine Seite aus dem "
     +"Buch heraus, das auf dem Tisch liegt.\nDu denkst   . o O (Ganz "
     +"schoen unverschaemt.)", 78, 0, BS_LEAVE_MY_LFS),
     MSGFLAG_VISUAL|MSGFLAG_NO_TP);

     if(ME_TOO_HEAVY == myseite->move(TP,M_GET|M_SILENT))
     {
           myseite->move(ENV(TP), M_PUT|M_SILENT);

           write(BS("Du kannst die leere Seite nicht mehr tragen und "
           +"legst sie auf dem Boden ab."));

           ENV(TP)->Message(BS(TP->Name(WER, 1)+" legt etwas auf dem Boden "
           +"ab."),
           MSGFLAG_VISUAL|MSGFLAG_NO_TP);
     }

     i++;
     return 1;
  }
  else
  {
     write(BS("Aber die wenigen, noch vorhandenen Seiten des Buches sind "
     +"doch allesamt beschrieben! Lass sie lieber darin, womoeglich steht "
     +"noch etwas Wichtiges darauf."));
     return -1;
  }
}

//Fackel unter Bett hervorziehen:
int ziehen(string str)
{
  object myfackel;

  notify_fail("Was willst Du von wo hervorziehen?\n");

  if(!str || str == "") return 0;

  if(!(str == "fackel unter bett hervor" ||
       str == "die fackel unter dem bett hervor")) return 0;

  if(fackel == DA)
  {
     myfackel = clone_object("/obj/fackel");

     write(BS("Du greifst unter das Bett und ziehst die Fackel naeher zu "
     +"Dir heran. Dann steckst Du sie freudig ein."));

     TO->Message(BS(TP->Name(WER, 1)+" greift unter das Bett."),
     MSGFLAG_VISUAL|MSGFLAG_NO_TP);

     if(ME_TOO_HEAVY == myfackel->move(TP,M_GET|M_SILENT))
     {
           myfackel->move(ENV(TP), M_PUT|M_SILENT);

           write(BS("Du kannst die Fackel nicht mehr tragen und "
           +"legst sie auf dem Boden ab."));

           ENV(TP)->Message(BS(TP->Name(WER, 1)+" legt eine Fackel auf dem "
           +"Boden ab."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
     }

     fackel = WEG;
     return 1;
  }
  else
  {
     write(BS("Wie willst Du etwas unter dem Bett hervorziehen, das gar "
     +"nicht dort liegt?"));
     return -1;
  }
}

//Vorratsschrank oeffnen
int oeffnen(string str)
{
  notify_fail("Was willst Du oeffnen?\n");

  if(!str || str == "") return 0;

  if(!(str == "vorratsschrank" ||
       str == "schrank" ||
       str == "vorratsschraenkchen" ||
       str == "schraenkchen")) return 0;

  write(BS("Der Vorratsschrank ist fest verschlossen. Den bekommst Du nicht "
  +"auf."));

  TO->Message(BS(TP->Name(WER, 1)+" versucht vergeblich, den Vorratsschrank "
  +"zu oeffnen."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;
}

//auf Stuhl sitzen:
int sitzen(string str)
{
  notify_fail("Wo moechtest Du sitzen?\n");

  if(!str || str == "") return 0;

  if(!(str == "auf stuhl" ||
       str == "auf holzstuhl" ||
       str == "an tisch" ||
       str == "am tisch")) return 0;

  if(sizeof(stuhl)>0)
  {
     if(STUHL(TP))
     {
        write("Du sitzt doch bereits auf dem Stuhl.\n");
     }
     else
     {
        write(BS("Der Stuhl ist leider schon besetzt.\n"));
     }
     return -1;
  }

  TP->Message(BS("Du setzt Dich auf den Holzstuhl.\n"),
  MSGFLAG_VISUAL);

  TO->Message(TP->Name(WER, 1)+" setzt sich auf den Holzstuhl.\n",
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  stuhl += ({ capitalize(getuid(TP)) });
  return 1;
}

//vom Stuhl aufstehen:
int aufstehen(string str)
{
  notify_fail("Von wo willst Du aufstehen?\n");

  if(!str || str == "") return 0;

  if(!(str == "von stuhl auf" ||
       str == "vom stuhl auf" ||
       str == "von holzstuhl auf" ||
       str == "vom holzstuhl auf" ||
       str == "auf")) return 0;

  if(STUHL(TP))
  {
        TP->Message(BS("Du erhebst Dich von dem Holzstuhl.\n"),
        MSGFLAG_VISUAL);

        TO->Message(TP->Name(WER, 1)+" erhebt sich von dem Holzstuhl.\n",
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  }
  else
  {
        write("Aber Du sitzt doch gar nicht auf dem Stuhl.\n");
        return -1;
  }

  stuhl -= ({ capitalize(getuid(TP)) });
  return 1;
}

//Test beim Verlassen des Raumes, ob man auf dem Stuhl sitzt
int exit_test(string dir)
{
        if(STUHL(TP))
        {
                write("Aber Du sitzt doch noch auf dem Stuhl. Steh erstmal "
                +"auf.\n");
                return -1;
        }

        return 0;
}

//Spieler logt aus waehrend des Sitzens
void BecomesNetDead(object spieler)
{
  if(STUHL(spieler))
  stuhl -= ({ capitalize(getuid(spieler)) });
}

//Spieler stirbt waehrend des Sitzens
void NotifyPlayerDeath(object spieler, object killer, int lost_xp)
{
  if(STUHL(spieler))
  stuhl -= ({ capitalize(getuid(spieler)) });
}

//im Bett liegen:
int liegen(string str)
{
  notify_fail("Wo willst Du Dich hineinlegen?\n");

  if(!str || str == "") return 0;

  if(!(str == "in bett" ||
       str == "im bett")) return 0;

  write(BS("Aber das Bett ist doch so schoen ordentlich gemacht. Wenn "
  +"Du Dich da jetzt einfach hineinlegen wuerdest, waere Hyara bestimmt "
  +"gar nicht erfreut. Also lass es lieber."));

  TO->Message(BS(TP->Name(WER, 1)+" macht Anstalten, sich in das Bett zu "
  +"legen, ueberlegt sich dann aber wohl doch wieder anders."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;
}

reset()
{
  ::reset();

  papier = DA;
  fackel = DA;
  i = 1;

  if(feuer == AN)
  {
    TO->Message(BS("Das Feuer im Kamin erlischt."), MSGFLAG_VISUAL);
    feuer = AUS;
    SetProp(P_ROOM_MSG, 0);
  }
}
