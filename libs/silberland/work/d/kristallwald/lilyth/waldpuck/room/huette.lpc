  AddDetail( ({ "art", "notizbuch" }),
    "Hyara benutzt das Buch fuer wichtige (oder auch unwichtige) Notizen.");

  AddDetail( ({ "notizen" }),
    "Sie sind in einer Dir voellig unverstaendlichen Sprache geschrieben.");

  AddDetail( ({ "sprache" }),
    "Du kennst sie leider nicht.");

  AddDetail( ({ "hand" }),
    "Du hast doch wohl eine, oder? Wenn Du Glueck hast, hast Du vielleicht "
    "sogar zwei davon.");

  AddDetail( ({ "haende" }),
    "Tatsaechlich, Du hast wirklich zwei Haende!\nDu freust Dich ueber "
    "diese aussergewoehnliche Entdeckung.");

  AddDetail( ({ "entdeckung", "entdeckungen" }),
    "Man macht immer wieder neue Entdeckungen, nicht wahr? :)");

  AddDetail( ({ "glueck" }),
    "Hast Du welches?");

  AddDetail( ({ "seiten" }),
    "Von den hinteren Seiten sind einige herausgerissen. Seltsam...");

  AddDetail( ({ "besuch" }),
    "Wenn die Huette nicht so abgelegen im Wald stuende, wuerde Hyara "
    "sicherlich mehr Besuch bekommen. Aber vielleicht will sie das ja "
    "auch gar nicht.");

  AddDetail( ({ "bett" }),
    "An der Ostwand steht ein kleines, gemuetliches Bett, dessen Kissen "
    "und Laken ordentlich glattgestrichen wurden. Hyara scheint eine "
    "ordentliche Hausfrau zu sein. Auf dem Boden vor dem Bett steht ein "
    "Paar Hausschuhe bereit.");

  AddDetail( ({ "kissen", "laken" }),
    "Die Kissen und das Laken wurden sorgsam glattgestrichen.");

  AddDetail( ({ "hausfrau" }),
    "Es sieht hier ueberall sehr ordentlich und gepflegt aus.");

  AddDetail( ({ "aufstehen", "fuesse" }),
    "Nach dem Aufstehen hat man oft kalte Fuesse, da ist so ein Paar "
    "Hausschuhe genau das Richtige.");

  AddDetail( ({ "richtige", "richtiges" }),
    "Zumindest Hyara scheint es zu gefallen.");

  AddDetail( ({ "norden" }),
    "Im Norden befindet sich ein offener Kamin in der Wand, daneben "
    "steht ein Vorratsschrank.");

  AddDetail( ({ "vorratsschrank", "schrank", "schraenkchen",
  "vorratsschraenkchen" }),
    "An der Nordwand steht ein kleines Schraenkchen, in dem Hyara wohl "
    "ihre Vorraete aufbewahrt. Er ist verschlossen.");

  AddDetail( ({ "vorraete" }),
    "Alles, was man so zum Kochen (oder vielleicht auch zum Zaubern?) "
    "braucht.");

  AddDetail( ({ "kochen" }),
    "Zum Kochen benoetigt man meist so einiges an Vorraeten.");

  AddDetail( ({ "zaubern" }),
    "Hyara ist eine weise alte Zauberin.");

  AddDetail( ({ "blick" }),
    "Du blickst voellig in Gedanken versunken vor Dich hin.");

  AddDetail( ({ "gedanken" }),
    "Du denkst   . o O (                  )");

  AddDetail( ({ "wand", "waende" }),
    "Welche Wand meinst Du denn?");

  AddDetail( ({ "ostwand", "osten" }),
    "An der oestlichen Wand steht ein kleines, ordentlich gemachtes Bett.");

  AddDetail( ({ "nordwand" }),
    "In der Nordwand befindet sich ein offener Kamin. Daneben steht "
    "ein kleiner Vorratsschrank.");

  AddDetail( ({ "westwand", "westen" }),
    "An der Westwand siehst Du ein Fenster, unter dem ein Tisch und ein "
    "einzelner Stuhl stehen.");

  AddDetail( ({ "holz", "holzscheite", "holzscheit", "scheit", "scheite" }),
    "Ein paar Holzscheite liegen vor dem Kamin auf dem Boden. Sie sind "
    "sehr grob geschnitzt.");

  AddDetail( ({ "boden" }),
    "Der Holzfussboden sieht sauber und gepflegt aus. Ein bunter "
    "Flickenteppich liegt auf ihm.");

  AddDetail( ({ "holzfussboden", "fussboden", "holzboden" }),
    "Der Boden der Huette besteht aus dunklen Holzlatten.");

  AddDetail( ({ "holzlatten", "latten", "holzlatte", "latte" }),
    "Dunkle Holzlatten wurde auf dem Boden der Huette verlegt.");

  AddDetail( ({ "flickenteppich", "teppich" }),
    "Der Teppich wurde aus vielen verschiedenfarbigen und unterschiedlich "
    "grossen Stoffstueckchen zusammengenaeht. Weil sich "
    "'Stoffstueckchenteppich' jedoch gar nicht gut anhoeren wuerde, heisst "
