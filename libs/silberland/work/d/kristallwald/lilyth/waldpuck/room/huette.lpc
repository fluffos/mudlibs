  AddDetail( ({ "stoffstueckchenteppich" }),
    "Nein, das hoert sich wirklich nicht schoen an.");

  AddDetail( ({ "stoffstueckchen", "stoffstuecke", "stoffstueck",
  "flicken" }),
    "Sie haben alle eine andere Farbe und Groesse.");

  AddDetail( ({ "farbe", "farben" }),
    "Alle moeglichen Farben.");

  AddDetail( ({ "groesse" }),
    "Von daumennagelklein bis handtellergross.");

  AddDetail( ({ "daumennagelkleine stoffstueckchen", "daumennagel",
  "daumennagelklein" }),
    "Ja, einige der Flicken sind tatsaechlich nur so gross wie Dein "
    "Daumennagel.");

  AddDetail( ({ "handtellergrosse stoffstueckchen", "handtellergross" }),
    "Du legst Dich lang auf den Boden und misst einen der Flicken nach. "
    "Er ist wirklich handtellergross. Grandios. :)");

  AddDetail( ({ "decke", "holzdecke" }),
    "Die niedrige Holzdecke befindet sich ueber Dir. Sie sieht eigentlich "
    "recht langweilig aus.");

  AddReadDetail( ({ "notiz", "notizen", "buch", "buechlein", "notizbuch" }),
    "Du versuchst, die Notizen in dem Buch zu lesen, doch es gelingt Dir "
