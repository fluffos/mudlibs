#include "../def.h"

inherit "std/room";

//--Variablen&Defines------------------------------------------------------

int feuer;

//--Create-----------------------------------------------------------------

void create()
{
  ::create();

//--Initialisierungen------------------------------------------------------

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Im Wald");
  SetProp(P_INT_LONG, "Ein provisorischer Waldraum.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "" }),
    "");

  AddDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");

//--Ausgaenge--------------------------------------------------------------

  NewDoor( ({"haus"}), ROOM "huette", ({"tuer","holztuer"}),
   ({ D_FLAGS,DOOR_CLOSED|DOOR_RESET_CL,
      D_NAME,         "Holztuer",
      D_GENDER,       FEMALE,
      D_SHORT,        "Eine kleine, gruene Holztuer. Sie ist %s.",
      D_LONG,         "Durch diese Tuer kannst Du die kleine Huette betreten.",
      D_OPENTESTFUNC, "tueroeffnen",
      D_MSGS,         ({"in die Huette",
                        "geht",
                        "kommt herein"}),
      D_OPENMSG,      ({"Du oeffnest die gruene Holztuer.",
                        "%s oeffnet die gruene Holztuer.",
                        " wird von innen geoeffnet."}),
      D_CLOSEMSG,     ({"Du schliesst die Holztuer.",
                        "%s schliesst die Holztuer.",
                        " wird von innen geschlossen."}),
      D_RESET_CLOSEMSG, " wird durch einen Windstoss geschlossen." }) );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "klopf", "klopfe" }), "klopfen" );

//--Create Ende------------------------------------------------------------

}

//Die Tuer laesst sich nur von innen oder ueber anklopfen oeffnen
int tueroeffnen()
{
  object room;
  room = find_object(ROOM "huette");

  if(room && !present("hyara", room) &&
     DOOR_MASTER->QueryDoorStatus(ROOM "huette") == D_STATUS_CLOSED)
  {
    return 0;
  }
  else
  {
    write(BS("Vorsichtig ruettelst Du an der Tuer, doch sie scheint von "
    +"innen verschlossen zu sein. Vielleicht solltest Du einfach mal "
    +"anklopfen?"));

    TO->Message(BS(TP->Name(WER, 1)+" ruettelt an der Holztuer herum."),
    MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;
  }
}

int klopfen(string str)
{
  notify_fail("Was willst Du tun? Vielleicht an der Tuer anklopfen?\n");

  if(!str || str == "") return 0;

  if(!(str == "an" ||
       str == "an tuer" ||
       str == "an tuer an" ||
       str == "an holztuer" ||
       str == "an holztuer an" ||
       str == "an huette" ||
       str == "an huette an" )) return 0;

  if(DOOR_MASTER->QueryDoorStatus(ROOM "huette") == D_STATUS_CLOSED)
  {
      write(BS("Du klopfst an die Holztuer und wartest."));
      TO->Message(BS(TP->Name(WER, 1)+" klopft an die Holztuer."),
      MSGFLAG_VISUAL|MSGFLAG_NO_TP);

      if(find_call_out("tuer_anklopfen") == -1)
      {
        call_out("tuer_anklopfen", 4);
      }

      return 1;
  }
  else
  {
      write(BS("Aber die Holztuer steht doch weit offen, wozu willst Du da "
      +"anklopfen?"));
      return -1;
  }
}

void tuer_anklopfen()
{
  object room;
  room = find_object(ROOM "huette");
  
  if(room && present("hyara", room))
  {
    //Vielleicht hat mittlerweile jemand aufgemacht:
    if (DOOR_MASTER->QueryDoorStatus(ROOM "huette")==D_STATUS_CLOSED)
    {
      TO->Message(break_string("Ploetzlich wird die Holztuer von innen "
      +"geoeffnet.\nEine leise Stimme ertoent: Komm doch herein...",
      78, 0, BS_LEAVE_MY_LFS), MSGFLAG_VISUAL|MSGFLAG_SOUND);
      
      DOOR_MASTER->SetDoorStatus(ROOM "huette", D_STATUS_OPEN);
    }
  }
  else
  {
    write(BS("Seltsam, es scheint niemand da zu sein."));
  }
  return;
}
