//von Aaliyah - Kristallwald
//
// Amalia, die Zauberfee




inherit "std/npc";
inherit "std/npc/spells";


#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Amalia, die Zauberfee");
  SetProp(P_LONG,
    "Amalia ist eine zarte, kleine Fee mit meerblauen Augen und bonbonrosa "
    "Haaren. Sie ist von einer merkwuerdigen hellen Aura umgeben. Sie ist "
    "nicht groesser als 20 cm und ist somit eines der kleinsten Wesen ihrer "
    "Art. Trotz ihrer zarten Statur sollte man sie aber trotzdem nicht "
    "unterschaetzen. Sie kann ganz schoen austeilen wenn sie will. Ansonsten "
    "ist sie aber eine sehr freundliche und hilfsbereite Person.");
    
  SetProp(P_NAME, ({"Amalia, die Zauberfee",
                    "Amalia, der Zauberfee", 
                    "Amalia, der Zauberfee",
                    "Amalia, die Zauberfee"}));
   
  SetProp(P_GENDER, FEMALE);
  AddId(({"amalia", "fee", "zauberfee"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("amalia");

  create_default_npc(30,3500);
  SetProp(P_HANDS, ({" mit ihren magischen Haenden",300,DT_MAGIC}));
  SetProp(P_RACE, "Fee");
  SetProp(P_SIZE, 20);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 10);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      0.1, DT_WATER:  -1.0, DT_AIR:   0.0, 
      DT_LIGHTNING: -1.0, DT_EXPLOSION: 0.1, DT_SOUND:  0.2, DT_LIGHT:  0.0,
      DT_ELECTRIC:  -1.0, DT_ACID:      0.2, DT_POISON: 0.2, DT_TERROR: 0.1,
      DT_HOLY:      -1.0, DT_UNHOLY:    0.1, DT_MAGIC:  -1.0, DT_MIND:   0.2,
      DT_BLUDGEON:   0.1 ,DT_PIERCE: -1.0,   DT_SLASH:  0.1]) );

  SetProp(P_MSGIN, "flirrt von Kristallstaub umgeben herein");
  SetProp(P_MSGOUT, "bestaeubt Dich mit Kristallstaub und flirrt");
  SetProp(P_MMSGIN, "flattert herunter");
  SetProp(P_MMSGOUT, "flattert davon");
  SetProp(P_DIE_MSG,  " zerbricht in lauter Kristallstaub.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Mit meinem Tod stirbt auch die Liebe!");
  SetProp(P_KILL_NAME, "Amalia, die Zauberfee");
  SetProp(P_KILL_MSG, "Ruh in Frieden Du Ruepel!");

  AddInfo(DEFAULT_INFO, "sagt: Frag mich nicht soviel, ich habe Arbeit!");

  AddInfo( ({"lovetah"}),
     "Eigentlich mag ich ja nicht so gerne Zwerge. Sie sind meistens schmutzig "
     "und stinken. Aber Lovetah ist da gaaaanz anders!. Er duftet himmlisch "
     "und ist noch dazu auch ein aeusserst huebscher Zwerg.","sagt: ");
  
 
  
  AddInfo( ({"kerze"}), 
    "Kerzen sind ein gutes Mittel, um einen Raum besonders romantisch zu "
    "gestalten.", "sagt: ");
  
  AddInfo( ({"teelicht","teelichter","meer"}),
    "Ein Meer aus Teelichtern ist doch was wunderbares!","sagt: ");
  
  AddInfo( ({"rosenblaetter","herz aus rosenblaetter"}),
     "Die Rosenblaetter auf den Boden gestreut, sehen wirklich super "
     "aus. Das Herz aus Rosenblaettern hat auch noch in der Mitte einen "
     "Schriftzug. 'Ich liebe Dich', steht da drauf.","sagt: ");
  
  AddInfo( ({"schale","kristallschale"}),
     "In die Kristallschale kann man Schokoerdbeeren hineinlegen!","sagt: ");
 
  AddInfo( ({"wasserblumen","wasserblumenstrauss"}),
     "Die Wasserblumen sind blau und bestehen voellig aus Wasser. Man findet "
     "sie nicht so leicht.","sagt: ");

  AddInfo( ({"wolkenblume"}),
     "Eine schoene silberne Wolkenblume. Im Haar sieht sie sicherlich toll "
     "aus. Sie stammt aus der Wolkenstadt.","sagt: ");

  AddInfo( ({"rosen","rosenstrauss"}),
     "Wunderschoene rote Rosen zu einem praechtigen Strauss gebunden!","sagt: ");

  AddInfo( ({"eisblumen","eisblumenstrauss"}),
     "Die Eisblumen sind filigrane Blumen die an Fenstern und so wachsen. Sie "
     "sind sehr fein und man muss aufpassen, dass sie nicht kaputt werden. "
     "Aber Du passt doch sicherlich gut auf.","sagt: ");

  AddInfo( ({"kristallblumenstrauss","kristallblumen"}),
     "Die Kristallblumen stammen aus dem Kristallwald. Aber nur ich weiss, "
     "wo sie sich befinden!","sagt: ");
  
  AddInfo( ({"feuerblumen","feuerblumenstrauss"}),
     "Die Feuerblumen sind grosse, rote Blumen. Sie wurden im Zauberwald "
     "gepflueckt!","sagt: ");

  AddInfo( ({"zauberwald"}),
     "Der Zauberwald ist meine Heimat. Aber da kannst Du noch nicht hin. Es "
     "gibt noch keinen Zugang fuer Fremde!","sagt: ");
  
  AddInfo( ({"kristallrose"}),
     "Ein huebscher Verlobungsring kommt in der Kristallrose sicherlich "
     "gut zur Geltung.","sagt: ");
  
  AddInfo( ({"verlobungsring"}),
     "Hier kann man Verlobungsringe kaufen.","sagt: ");
  
  AddInfo( ({"herzkarton"}), 
     "Der Herzkarton ist eine huebsche Verpackungsvariante.","sagt: ");
  
  AddInfo( ({"kristallherz"}),
     "Das Kristallherz kann man gravieren.","sagt: ");
  
  AddInfo( ({"lebkuchenherz"}),
     "Kauf doch eines. So knausrig wirst ja wohl nicht sein.","sagt: ");
  
  AddInfo( ({"kristallkette","silberkette","goldkette","kette"}),
     "Fuer jedes Herz gibt es eine passende Kette.","sagt laechelnd: ");
  
  AddInfo( ({"plueschherz"}),
     "Ein kuschliges Plueschherz, in das man sich kuscheln kann, wenn man "
     "seinen Liebling vermisst.","sagt: ");
  
  AddInfo( ({"goldherz"}),
     "Schenk es jemand, der fuer Dich ein Herz aus Gold hat.","sagt: ");
  
  AddInfo( ({"schokoerdbeeren"}),
     "Das sind frische, knackige Erdbeeren mit einer leckeren Glasur aus "
     "feinster Derlimschokolade.","sagt: ");
  
  AddInfo( ({"geschenkskarton","schillernder geschenkskarton"}),
     "Der ist etwas fuer Leute, die es gerne freakig haben ;)."," sagt: ");
     
  AddInfo( ({"parfuem","parfum"}),
     "Es gibt zwei Arten von Parfum. Elbenstein und Morgentau.","sagt: ");
 
  AddInfo( ({"duftoel","oel"}),
     "Das Duftoel macht eine herrlich geschmeidige Haut.","sagt: ");

     
  AddInfo( ({"elbenstein"}),
     "Elbenstein ist ein extrem maennlicher Duft. Ich habe ihn aus Moos, "
     "wuerzigen Kraeutern, edlen Holzen und ein klein wenig Moschus "
     "hergestellt.","sagt: ");

     
  AddInfo( ({"moschus"}),
     "Irgendein Zwerg hat mir mal Moschus verkauft. Er riecht zwar sehr "
     "komisch aber in Verbindung mit Kraeutern wird es ein exzellenter "
     "Duft.","sagt: ");

  AddInfo( ({"morgentau"}),
     "Morgentau ist ein sehr edler, femininer Duft. Morgentau riecht "
     "etwas suess, nicht zu sehr suess, sondern edel. Weisst du wie ich dass "
     "meine? Ich hab aus Rosenblueten, Orchideenblueten, Veilchen, Erdbeeren "
     "und Maigloeckchen einen Brei gemacht und ihn mit Morgentau angesetzt. "
     "Das ist eine schwere Prozedur.","sagt: ");

  AddInfo( ({"wolkenblume","wolkenstadt"}),
	"In der Wolkenstadt wachsen viele Wolkenblumen.","schmachtet: ");


  AddInfo( ({"rosenblaetterherz"}),
	"Das ist ein Herz aus Rosenblaettern. Eigentlich ist es fast dasselbe "
	"wie das andere Herz, nur steht halt 'Ich hab Dich lieb', in der "
	"Mitte. Es ist fuer diejenigen gedacht, die den Schritt der magischen "
	"drei Worte noch nicht gehen moechten.","sagt: ");



  AddInfo( ({"fenris"}),
     "Fenris ist der schoenste Elfenmann, den es gibt. Und er wohnt gleich "
     "hier um die Ecke. Ja da werd ich sicherlich nach Feierabend mal mit "
     "einem guten Schlueckchen Wein vorbeischauen.","kichert: ");
  
  AddInfo( ({"andruil","rambo"}),
	"Der ist ja sowas von sueeeeeeeeeeeeeeeess.","schmachtet: ");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Amalia sagt: Behaltet das mal schoen. Ich brauche es nicht.\n" }) );

  SetProp(P_SPELLRATE, 90);
  
  AddSpell(4,500,
   "Amalia schlitzt Dir mit dem Sternenstab die Brust auf.\n",
   "Amalia schlitzt @WEM mit ihrem Sternenstab die Brust auf.\n",
   DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(5,700,
  "Amalia beisst Dir in die Nase.\n",
  "Amalia beisst @WEM in die Nase.\n",
  DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(8,300,		  
  "Amalia reisst Dir ein grosses Bueschel Haare aus.\n",
  "Amalia reisst @WEM ein grosses Bueschel Haare aus.\n",
  DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(5,1000,
  "Amalia ueberschuettet Dich mit Kristallstaub.\n",
  "Amalia ueberschuettet @WEN mit Kristallstaub.\n",
  DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(5,900,
  "Amalia murmelt einige magische Formeln und ein Lichtstrahl verbrennt Dich.\n",
  "Amalia verbrennt @WEN mit einem gigantischen Lichtstrahl.\n",
  DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(3, 450, DS_BLIND);
    

  SetChats(1, ({"Amalia fragt Dich: Riechst Du auch den Duft des Waldes?\n",
		"Amalia flirrt vergnuegt durch den Raum.\n",
		"Amalia pustet Dir etwas Kristallstaub auf die Nase.\n",
		"Amalia sagt: So such Dir doch was Nettes aus.\n",
		"Amalia singt froehliche Lieder.\n",
		"Amalia zaubert ein paar Gegenstaende hervor.\n",
		"Amalia zaubert ein Herz aus Kristallstaub.\n",
		"Amalia setzt sich auf Deine Schulter.\n",
		"Amalia wackelt mit ihren Fluegeln.\n"}));
 
  
  SUID;
  CLONEME( "/d/wasser/aaliyah/hexenstadt/weapon/sternenstab.lpc" );
  command("zuecke stab");
  CLONEME( "/d/wasser/aaliyah/hexenstadt/armour/skleidchen.lpc" );
  CLONEME( "/d/wasser/aaliyah/hexenstadt/armour/sstiefel.lpc" );
  CLONEME( "/d/wasser/aaliyah/hexenstadt/armour/blumenkranz.lpc" );
  command("trage alles");

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
  case "fies":
      if( random(2) )
        call_out("react", 0, "sagt: Ihr habt keine Manieren Fremder!",
          "sagt: "+TP->name(WER)+" hat keine Manieren");
      else
        call_out("angriff",0);
      break;
  case "aergerlich":
      call_out("react", 0, "fragt: Warum geht Ihr nicht spielen, "+TPN+"?",0);
      break;
  case "traurig":
      call_out("react", 0, "nimmt Dich troestend in die Arme.",
             "troestet "+TP->name(WEN)+" sanft.");
      break;
  case "albern":
      call_out("react", 0, "laechelt.",0);
       break;
  case "neutral":
      call_out("react", 0, "ignoriert Dich.", "beachtet "+TP->name(WEN)+
		      " nicht.");
      break;
  case "intim":
      call_out("react", 0, "haut Dich.", "schlaegt "+TP->name(WEN)+" fest.");
      break;
  case "froh":
      call_out("react", 0, "laechelt Dich froehlich an.",
             "laechelt "+TP->name(WEN)+" froehlich an.");
      break;
    case "aengstlich":
      call_out("react", 0, "legt beschuetzend ihre Arme um Dich.",
             "umarmt "+TP->name(WEN)+" beschuetzend.");
      break;
  case "frech":
      call_out("react", 0, "grummelt Dich an.", "grummelt "+TP->name(WEN)+" an.");
      break;
  case "nett":
	          call_out("react", 0, "knuddelt Dich.", "knuddelt "
				  +TP->name(WEN)+" lieb.");
      break;
  }
}
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}

  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
    tell_room(ENV(TO), Name(WER, 1)+" seufzt: Nun musst Du sterben.\n");
    Kill(TP);
  }
}

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

