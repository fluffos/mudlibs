inherit "std/npc";
inherit "std/npc/spells";

#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Amor, der Liebesengel");
  SetProp(P_LONG,
    "Amor ist ein sehr gross gewachsener Engel. Lange, schwarze Haare wallen "
    "ueber seinen muskuloesen, nackten Oberkoerper. Seine grossen, weissen "
    "Fluegel liegen am Ruecken an, da er sie im Moment ja nicht benoetigt. "
    "Grosse, himmelblaue Augen strahlen Dich aus seinem zarten Gesicht an.");
    
   SetProp(P_NAME, ({"Amor, der Liebesengel",
                  "Amor, des Liebesengel", 
                  "Amor, dem Liebesengel",
                  "Amor, den Liebesengel"}));
   
  SetProp(P_GENDER, MALE);
  AddId(({"amor", "elf", "wirt","liebesengel","Speermeister"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("Amor");

  create_default_npc(29,1500);
  SetProp(P_HANDS, ({" mit unglaublicher Magie",300,DT_MAGIC}));
  SetProp(P_RACE, "Engel");
  SetProp(P_SIZE, 60);
  SetProp(P_WEIGHT, 20000);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,40);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      0.1, DT_WATER:  0.1, DT_AIR:   -1.0, 
      DT_LIGHTNING: -1.0, DT_EXPLOSION: 0.5, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  -1.0, DT_ACID:      0.5, DT_POISON: 0.3, DT_TERROR: 0.1,
      DT_HOLY:      -1.0, DT_UNHOLY:    0.2, DT_MAGIC:  -1.0, DT_MIND:   0.2,
      DT_SLASH:     0.1, DT_PIERCE:   0.1, DT_BLUDGEON: 0.1]) );

  SetProp(P_MSGIN, "schreitet majestaetisch herein");
  SetProp(P_MSGOUT, "oeffnet seine Fluegel und fliegt");
  SetProp(P_MMSGIN, "fliegt herunter");
  SetProp(P_MMSGOUT, "fliegt davon und winkt Dir zu");
  SetProp(P_MNPC_DEFAULTROOM, ROOM "bar.lpc");
  SetProp(P_DIE_MSG,  " zerbricht in lauter Kristallstaub.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Wer soll sich jetzt um die Liebe kuemmern?!!");
  SetProp(P_KILL_NAME, "Amor, der Liebesengel");
 
  AddInfo(DEFAULT_INFO, "sagt laechelnd: Trink doch etwas und frag nicht soviel.");
  
 
   
  AddInfo( ({"caribbean night"}),
     "Wenn man Caribbean night trinkt, hat man das Gefuehl im Urlaub zu "
     "sein.","sagt: ");
     
     
  AddInfo( ({"indian summer"}),
     "Ja! Indian Summer ist eine wirklich grosse Versuchung.","sagt: ");
     
  AddInfo( ({"midnight dreams"}),
     "Dieser Cocktail ist wirklich unbeschreiblich.","sagt: ");
      
       
  AddInfo( ({"blue lagoon"}),
     "Blue Lagoon macht Euch sicher schoen betrunken.","kichert: ");
  
  AddInfo( ({"caipirinha"}),
     "Probier doch mal meinen Caipirinha. Die Limetten darin sind frisch und "
     "sehr fruchtig.","sagt laechelnd: ");
     
  AddInfo( ({"pina colada"}),
     "Pina Colada ist eine Mischung aus Ananassaft, Creme de Coco und noch "
     "einigen Dingen. Schmeckt aber sehr sehr lecker.","sagt: ");
 
  AddInfo( ({"long silberland icetea","icetea"}),
     "Uii der ist stark. Der besteht aus vielen scharfen Sachen.","sagt: ");
   
  AddInfo( ({"melonen daiquiri"}),
     "Moechtet Ihr was Erfrischendes? Dann ist Melonendaiquiri genau das "
     "Richtige!","sagt: ");
     
    
  AddInfo( ({"heisse liebe","vanilleeis","eis","himbeeren"}),
      "Leckeres Vanilleeis mit heissen Himbeeren.","sagt: ");
      
  AddInfo( ({"coconut dream"}),
      "Das ist ein Cocktail mit Kokosnuss und vielen anderen Zutaten. "
      "Er schmeckt wirklich vorzueglich.","sagt: ");
      
  AddInfo( ({"fenris"}),
      "Fenris ist der Schoenste aller Elfenmaenner."," sagt: ");
      
  AddInfo( ({"andruil"}),
      "Andruil war eine Legende."," seufzt: ");
      
  AddInfo( ({"cocktail","drink","getraenk","alkohol"}),
      "Welchen Cocktail meint Ihr?"," fragt: ");
      
  AddInfo( ({"vanilla sky"}),
      "Vanilla Sky besteht hauptsaechlich aus Vanilla."," erklaert: ");
      
       
  AddInfo( ({"tequila sunrise","tequila"}),
      "Ich mache meinen Tequila Sunrise immer etwas staerker.","schwaermt: ");
      
       
  AddInfo( ({"green tropical"}),
      "Sehr sehr exotisches Getraenk.","sagt: ");
      
 

   SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Amor zerstoert Dein Geschenk.\n" }) );

  SetProp(P_SPELLRATE, 99);
  AddSpell(4,550,
    "Amor brennt Dir mit Flammenzunge seinen Namen in den Bauch.\n",
    "Amor brennt @WEN mit Flammenzunge seinen Namen in den Bauch.\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,1200,
  "Amor dringt in Deine Gedanken.\n",
  "Amor dringt in die Gedanken von @WEM.\n",
  DT_MIND,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,800,
  "Amor schlaegt wild mit seinen Fluegeln um sich.\n",
  "Amor schlaegt @WEN mit seinen Fluegeln.\n",
  DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(4,1000,
  "Amor beschwoert goettliche Magie.\n",
  "Amor vernichtet @WEN mit unglaublicher Magie.\n",
  DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  
      
  AddDefaultSpell(3, 1000, DS_FROG);

  AddDefaultSpell(3, 1000, DS_BLIND);
   
  SetChats(1, ({"Amor fragt Dich: Darf ich Dir etwas bringen?\n",
     "Amor mixt einen Cocktail.\n",
     "Amor bedient ein paar Gaeste.\n",
     "Amor fragt Dich: Darf ich bitten?.\n"
     "Amor nimmt Dich bei der Hand und tanzt mit Dir.\n",
     "Amor dekoriert einen Cocktail.\n"}));
  
  SUID;
  CLONEME("/d/astral/feyaria/inferno/weapon/flammenzunge" );
  command("zuecke speer");
  CLONEME("/p/armour/trousers/lendenschurz" );
  CLONEME("/gilden/bardengilde/instrument/engelsharfe");
  command("trage alles");
}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
   case "fies":
      if( random(2) )
        call_out("react", 0, "sagt: Kannst Du mich nicht arbeiten lassen?",
          "schreit "+TP->name(WEN)+" an");
      else
        call_out("angriff",0);
      break;
   case "aergerlich":
      call_out("react", 0, "fragt: Hast Du nichts besseres zu tun %s, "+TPN+"?",0);
      break;
   case "traurig":
      call_out("react", 0, "nimmt Dich troestend in die Arme.",
             "troestet "+TP->name(WEN)+" sanft.");
      break;
   case "albern":
      call_out("react", 0, "laechelt.",0);
       break;
    case "neutral":
      call_out("react", 0, "ignoriert Dich.", "beachtet "+TP->name(WEN)+
		      " nicht.");
      break;
    case "intim":
      call_out("react", 0, "haut Dich.", "schlaegt "+TP->name(WEN)+" fest.");
      break;
    case "froh":
      call_out("react", 0, "laechelt Dich froehlich an.",
             "laechelt "+TP->name(WEN)+" froehlich an.");
      break;
    case "aengstlich":
      call_out("react", 0, "legt beschuetzend seine Arme um Dich.",
             "umarmt "+TP->name(WEN)+" beschuetzend.");
      break;
    case "frech":
      call_out("react", 0, "grummelt Dich an.", "grummelt "+TP->name(WEN)+" an.");
      break;
    case "nett":
	          call_out("react", 0, "knuddelt Dich.", "knuddelt "
				  +TP->name(WEN)+" lieb.");
      break;
  }
}
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}

  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
    tell_room(ENV(TO), Name(WER, 1)+" seufzt: Nun muesst Du sterben.\n");
    Kill(TP);
  }
}

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

