// Bar - Kristallwald

inherit "std/pub";
#include "../def.h"
#include <pub.h>
#include "/gilden/bardengilde/barden_extern.h"



void create()

{
  ::create();

  SetProp( P_INT_SHORT, "Love and Harmony");
          
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "amor");
  SetProp(P_PUBKEEPER_NAME, "amor");
  SetProp(P_PUBMSG_NOKEEPER, "Amor ist wohl ausgeflogen.\n");
  SetProp(P_PUBMSG_NOENEMY, BS(
      "Amor bedient seine Feinde nicht."));
  SetProp(P_PUBMSG_NOINVITE, BS(
      "Amor kaempft gerade um sein Leben und hat daher keine Zeit."));
  SetProp(P_PUBMSG_FIGHTING, "Amor kaempft gerade.\n");
  
//-----Details Anfang-----
  
  AddDetail( ({"raum","raumes","bar"}), QueryProp(P_INT_LONG) );


  AddDetail( ({"cocktail","cocktails"}),
	    "Bestell doch auch einen.");

  AddDetail( ({"fruechte"}),
	    "Sehen kannst Du sie nicht, lediglich riechen.");

  AddDetail( ({"wachs"}),
	    "Etwas geschmolzenes Wachs rinnt bei den Kerzen hinunter.");

  AddDetail( ({"lust","moegliche"}),
	    "Du bekommst hier auf alles Moegliche eine enorme Lust.");

  AddDetail( ({"gaeste"}),
	    "Als Du Dich genauer umsiehst bemerkst Du einige Gaeste, die "
	    "entweder tanzen oder an einem Cocktail schluerfen.");

  AddDetail( ({"prioritaet","prioritaeten","mancher"}),
	    "So Mancher setzt seine Prioritaeten falsch, aber Amor weiss "
	    "wie er sie setzen muss.");

  AddDetail( ({"kissen"}),
	    "Viele grosse weisse Kissen befinden sich auf der Couch. Sie sind "
	    "richtig schoen plueschig und weich.");

  AddDetail( ({"couch","westwand"}),
	    "An der Westwand befindet sich eine grosse, rote Couch mit vielen "
	    "weichen Kissen. Wenn Du magst, kannst Du dich doch darauf "
	    "kuscheln.");

  AddDetail( ({"herz"}),
	    "Du hast doch eines?");

  AddDetail( ({"person"}),
	    "Du kennst doch sicher wen, der Dir am Herz liegt.");
            
  AddDetail( ({"abend","ruhe"}),
	    "Wenn Du in Ruhe einen romantischen Abend verbringen moechtest, "
	    "schnapp Dir doch einfach eine liebe Person und bring sie hier her.");

  AddDetail( ({"verliebte","treffpunkt","paerchen"}),
	    "Diese Bar ist ein beliebter Treffpunkt fuer verliebte Paerchen. "
	    "Sie koennen hier, umgeben von einer romantischen Atmosphaere, in "
	    "Ruhe tanzen oder einfach einen netten Abend verbringen.");

  AddDetail( ({"amor","wirt"}),
	    "Amor ist der Wirt hier.");
  
  AddDetail( ({"rosenblueten","blueten"}),
	    "Rote Rosenblueten liegen hier ueberall am Boden.");
  
  AddDetail( ({"tanzflaeche","flaeche"}),
	    "Rund um die Tanzflaeche wurden Teelichter gestellt. Ausserdem "
	    "hat Amor einige Rosenblueten gestreut um das ganze noch etwas "
	    "huebscher zu gestalten.");
	    
  AddDetail( ({"barhocker","hocker","barhockern","hockern"}),
            "Wenn Du moechtest kannst Du Dich gerne auf einen dieser Barhocker "
	    "setzen.");

    
  AddDetail( ({"bar","kristallbar"}),
	   "Unmittelbar vor Dir befindet sich die Bar. Sie besteht aus purem "
	   "Kristall. Einige Teelichter stehen darauf und flackern romantisch "
	   "vor sich hin.");

    
  AddDetail( ({"atmosphaere"}),
	   "Du fuehlst Dich hier sehr wohl.");

    
  AddDetail( ({"kerzenlicht","kerzen","teelichter","licht"}),
	   "Unzaehlige Kerzen und Teelichter wurden hier aufgestellt und "
	   "tauchen den Raum in eine romantische Atmosphaere.");

    
  AddDetail( ({"musik","ohren","tanzen","klaenge"}),
	   "Lausche der Musik und tanz doch ein bisschen.");

    
  AddDetail( ({"kristall"}),
	   "Der Kristall ist aeusserst edel und reflektiert wunderbar das "
	   "viele Kerzenlicht.");

  AddDetail( ({"waenden","wand","waende","boden","decke"}),
	   "Hier besteht restlos alles aus Kristall.");
  
  AddSmell(DEFAULT_SMELL, "Es duftet hier nach Kerzen und nach den vielen "
		  "Fruechten, mit denen die Cocktails gemixt werden.");  
 
  AddSmell( ({"fruechte","fruechten","cocktails"}),
	   "Die Fruechte duften herrlich suess und frisch und Du bekommst so "
	   "richtig Lust auf so einen fruchtigen Cocktail.");

  AddSmell( ({"kerzen","wachs"}),
	   "Die Kerzen riechen einfach nach geschmolzenem Wachs.");
	 

   
   
  AddSound(DEFAULT_SOUND, "Leise Klaenge ruhiger Musik umschmeicheln Deine "
		  "Ohren.");

  AddSound( ({"klaenge","musik"}),
	   "Die Musik hier wirkt sehr beruhigend und laedt zum romantischen "
	   "Tanzen ein.");
  
  //-----Details Ende-----
 
   AddCmd( ({ "sitz", "setz","sitze","setze" }), "c_sitzen");
   AddCmd( ({ "kuschel", "kuschle" }), "c_kuscheln");




  
  AddDrink("Coconut Dream", ({"coconut dream","coconut", "dream"}),
           100,({30,10,0}), 0, 5,
           ({"Amor bringt Dir flink einen dekorierten Cocktail.\n",
             "&& geniesst zufrieden ein Glas Coconut Dream.\n"}));

  AddDrink("Vanilla Sky", ({"vanilla sky", "vanilla", "vanilla"}),
            250, 30, 3, 5,
           ({"Amor serviert Dir eine Kristallkaraffe mit Vanilla Sky.\n"
            +"Hmmmmmmmmmmmmm!!!! Der schmeckt kaum nach Alkohol!!\n",
             "&& geniesst ein Glas Vanilla Sky und laechelt.\n"}));
  
  AddDrink("Melonen Daiquiri", ({"daiquiri","melonen daiquiri"}),
           700,({100,0,0}), 7, 6,
           ({"Amor bringt Dir emsig Dein Getraenk.\n",
             "&& leert das Glas mit einem Zug.\n"}));

  AddDrink("Long Silberland Icetea", ({"icetea", "long silberland icetea"}),
            830, 88, 18, 3,
           ({"Amor serviert Dir laechelnd Deinen Cocktail.\n"
            +"ROECHEL!!!! Der hat es aber ganz schoen auf sich!!\n",
             "&& trinkt zuviel Long Silberland Icetea.\n"}));

   
  AddDrink("Pina Colada", ({"pina colada","pina","pina colada"}),
           1100, 150, 0, 19,
           ({"Amor ueberreicht Dir einen schoen dekorierten Cocktail.\n",
             "&& nippt genuesslich an einer Pina Colada.\n"}));

  AddDrink("Caipirinha", ({"caipirinha"}),
            950, 40, 0, 4,
           ({"Amor serviert Dir zwinkernd Deinen Cocktail.\n"
            +"WOW!!!! Schmeckt die lecker!!\n",
             "&& trinkt einen huebsch dekorierten Cocktail.\n"}));

  AddDrink("Tequila Sunrise", ({"tequila sunrise","sunrise","tequila"}),
            600,({0,70,0}), 7, 7,
           ({"Amor bringt Dir emsig Dein Getraenk.\n"
            +"SCHLUCK!!!! Viel war da nicht drin!!\n",
             "&& trinkt einen Tequila Sunrise.\n"}));

   
  AddDrink("Green Tropical", ({"green tropical","tropical","green"}),
           1200, 150, 0, 19,
           "drink_green_tropical");

   
  AddDrink("Caribbean Night", ({"caribbean night","night","caribbean"}),
           1200, 150, 0, 19,
           ({"Amor ueberreicht Dir einen schoen dekorierten Cocktail.\n",
             "&& trinkt verzueckt einen Caribbean Night.\n"}));

   
  AddDrink("Blue Lagoon", ({"blue","lagoon","blue lagoon"}),
           1200, 150, 0, 19,
           ({"Amor serviert Dir einen schoen dekorierten Cocktail.\n",
             "&& geniesst einen Blue Lagoon.\n"}));

  AddDrink("Indian Summer", ({"indian","indian summer","summer"}),
           900, 150, 0, 19,
           ({"Amor serviert Dir einen schoen dekorierten Cocktail.\n",
             "&& geniesst einen heissen Indian Summer.\n"}));

  AddDrink("Midnight Dreams", ({"midnight","midnight dreams","dreams"}),
           1000, 150, 0, 19,
           ({"Amor serviert Dir einen schoen dekorierten Cocktail.\n",
             "&& geniesst einen huebsch dekorierten Cocktail.\n"}));

   AddDrink("Sex on the Beach", ({"sex","sex on the beach"}),
           666,({66,66,0}), 6, 6,
           ({"Amor schneidet einige Fruechte klein und beginnt Dir einen "
	    "bunten Cocktail zu mixen. Flink stellt er Dir ein grosses "
	    "Glas vor die Nase. Du trinkst es zufrieden aus und denkst Dir, "
	    "dass es irgendetwas mit Cherub zu tun haben koennte.\n",
             "&& zittert bei einem Glas Sex on the Beach.\n"}));



  
// ----------------------------------------------

  
  AddFood("Erdbeeren mit Sahne", ({"erdbeeren", "erdbeeren mit sahne"}),
		  33, 15, 6,
           ({"Amor serviert Dir laechelnd eine Kristallschale mit Erdbeeren. "
            +"\nHmmmm, die schmecken lecker! Sie sind total suess und die "
            "Sahnehaube passt perfekt dazu.\n",
             "&& nascht eine Schale mit Erdbeeren und Sahne.\n"}));
 
  AddFood("Heisse Liebe", ({"heisse liebe", "liebe"}), 400, 100, 29,
           ({"Amor bringt Dir eine grosse Schuessel mit Vanilleeis.\n"
            +BS("Hmmmm, die heissen Himbeeren bringen das Eis zum Schmelzen "
		    "und es schmeckt herrlich."),
             "&& geniesst eine Eisschale mit heisser Liebe.\n"}));

  
  
  AddExit("norden", ROOM "shop");
  AddItem(NPC "amor.lpc", REFRESH_DESTRUCT);

  }

public void drink_green_tropical() {
  object task;

  write(BS("Amor ueberreicht Dir einen schoen dekorierten Cocktail."));
  say(BS(TPN+" nippt genuesslich an einem Green Tropical."));

  if(objectp(task=present(BARD_ID_GS10_TASK, TP))) {
    task->MarkFood(1);
  }
}

 string _query_int_long()
 {
   if (present("amor"))
   return BS(
	"Du befindest Dich in einer romantischen Bar. Leise Klaenge "
	"umschmeicheln Deine Ohren. Unzaehlige Kerzen und Teelichter wurden "
	"hier aufgestellt und spiegeln sich in den kristallinen Waenden wieder. "
	"Unmittelbar vor Dir befindet sich eine grosse Kristallbar mit "
	"einigen Barhockern davor. Ausserdem erkennst Du auch noch eine kleine "        "Tanzflaeche, auf der einige Paerchen engumschlungen tanzen. An der "
	"Westwand befindet sich eine grosse rote Couch mit vielen Kissen "
	"darauf. Das schummrige Licht der Kerzen verleiht dem Raum eine ganz "
	"besondere Atmosphaere. Bleib doch ein bisschen hier, und lass Dich "
	"von Amor bewirten, dessen erste Prioritaet es ist, seine Gaeste "
	"zufrieden zu sehen.");
      

   else
   return BS(
   	"Du befindest Dich in einer romantischen Bar. Leise Klaenge "
	"umschmeicheln Deine Ohren. Unzaehlige Kerzen und Teelichter wurden "
	"hier aufgestellt und spiegeln sich in den kristallinen Waenden wieder. "
	"Unmittelbar vor Dir befindet sich eine grosse Kristallbar mit "
	"einigen Barhockern davor. Ausserdem erkennst Du auch noch eine kleine "        "Tanzflaeche, auf der einige Paerchen engumschlungen tanzen. An der "
	"Westwand befindet sich eine grosse rote Couch mit vielen Kissen "
	"darauf. Das schummrige Licht der Kerzen verleiht dem Raum eine ganz "
	"besondere Atmosphaere.");
       
}
    int c_sitzen(string str)
{
    notify_fail(BS("Wohin moechtest Du Dich setzen?"));
    if(!((str == "mich auf barhocker") || (str == "auf barhocker")))
    {
      return 0;
    }
    write(BS("Du setzt Dich bequem auf den Barhocker."));
    tell_room(ENV(TP), TPN+" setzt sich bequem auf den Barhocker.\n", ({TP}));
      return 1;
}

     int c_kuscheln(string str)
{
    notify_fail(BS("Worauf moechtest Du Dich kuscheln?"));
    if(!((str == "mich auf couch") || (str == "auf couch")))
    {
      return 0;
    }
    write(BS("Du kuschelst Dich gemuetlich auf die weiche Couch. *Aaahh* "
	     "Das tut gut. Du legst die Fuesse hoch und fuehlst Dich wie "
	     "daheim."));
    tell_room(ENV(TP), TPN+" kuschelt sich gemuetlich auf die Couch.\n", ({TP}));
      return 1;
}
 
