// Love and Harmony

#include "../def.h" 
#include <laden.h>

#define KRISTALLWALD "/d/kristallwald/sargola/see/room/0905"

inherit "std/laden";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Schloss der Zauberfee");
  SetProp(P_INT_LONG,
	"Du befindest Dich hier in einem wunderschoenen, kleinen Schloss. "
	"Sofort wirst Du von einer sanften, harmonischen Atmosphaere umhuellt. "
	"Der ganze Raum besteht aus rosa Kristall, welcher funkelt und glitzert "
	"wenn sich die Sonne darin bricht. In der Mitte des Raumes erkennst Du "
	"einen edlen, mit vielen Perlen verzierten Verkaufstresen. Weiters steht "
	"in einer Ecke ein kleiner Kristalltisch mit einem schoenen Stuhl dahinter. "
	"Schoene weisse, bodenlange Seidenvorhaenge, wallen um ein grosses Fenster, "
	"durch das die frische Waldluft nach Innen stroemt.");
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1 );
  SetStorageRoom(ROOM "megastore.lpc" );
  SetProp(P_SHOPKEEPER_ID, "amalia");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
  SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_NAME, "Amalia");
  SetProp(P_NOSELL, 1);
  

//----------Details Anfang---------------------------------

  AddDetail( ({"raum","raumes","schloss","schlosses"}), QueryProp(P_INT_LONG) );

  AddDetail( ({"wand","waende"}),
   "Der Raum hat vier Waende. Etwas haben sie alle gemeinsam. Sie bestehen "
   "aus rosa Kristall. Fuer naehere Details, musst Du sie wohl einzeln "
   "untersuchen.");

  AddDetail( ({"waldluft","luft","wald"}),
   "Riech mal wie der Wald duftet!");

  AddDetail( ({"mitte"}),
   "In der Mitte des Raumes befindet sich der Verkaufstresen.");


  AddDetail( ({"innen"}),
   "Du befindest Dich innerhalb des Schlosses.");


  AddDetail( ({"atmosphaere"}),
   "Die Atmosphaere hier ist traumhaft. Irgendwie fuehlst Du dich beruhigt, "
   "gluecklich und zufrieden zugleich.");

  AddDetail( ({"sonne"}),
   "Durch das geoeffnete Fenster dringt viel Sonne herein und durchflutet "
   "den Raum mit ihren warmen Strahlen.");

  AddDetail( ({"strahlen","kristall","sonnenstrahlen","kristallen"}),
   "Die Sonnenstrahlen brechen sich in den unzaehligen rosa Kristallen und "
   "lassen den Raum so richtig glitzern und funkeln.");

  AddDetail( ({"perlen"}),
   "Die Perlen werden anscheinend sehr oft poliert, so wie sie funkeln und "
   "glaenzen.");

  AddDetail( ({"ostwand"}),
   "Die Ostwand ist nicht besonders interessant. Bis auf einen grossen Spiegel "
   "kannst Du hier nichts besonderes erkennen.");

  AddDetail( ({"westwand"}),
   "An der Westwand befindet sich ein grosses Fenster.");
 
  AddDetail( ({"kasse","kassa"}),
   "Vergiss die Kassa. Die geht Dich nichts an.");

  
  AddDetail( ({"suedwand"}),
   "Die Suedwand wird von einem Tuerbogen eingenommen.");

  AddDetail( ({"portal","kristallportal"}),
   "Durch das Kristallportal gelangst Du wieder nach draussen.");

  AddDetail( ({"nordwand"}),
   "In der Nordwand befindet sich ein Portal, durch dass Du wieder nach "
   "draussen gelangst.");

  AddDetail( ({"detail","details"}),
   "Hier gibt es genuegend davon.");

  AddDetail( ({"fenster","ausblick","ueberblick"}),
   "Durch das wunderschoen geschwungene Fenster kannst Du fast den ganzen "
   "See ueberblicken. Ausserdem hast Du auch einen tollen Ueberblick auf das "
   "Gebirge und den Kristallwald.");

  AddDetail( ({"kristallwald","wald"}),
   "Man munkelt, dass sich Protheg dort versteckt haelt.");

  AddDetail( ({"protheg"}),
   "Finger Protheg.");

  AddDetail( ({"finger"}),
   "Du hast zehn Finger. Falls Dir mal einer fehlt, geh zu Shardin, die naeht "
   "ihn Dir flux wieder an.");

  AddDetail( ({"shardin","heilerin"}),
   "Das ist die Heilerin hier.");

  AddDetail( ({"gebirge"}),
   "Majestaetisch ragt das Gebirge empor und wirft einen Schatten ueber "
   "den Kristallwald.");

  AddDetail( ({"schatten"}),
   "Das Gebirge ist schuld daran, dass es hier soviel Schatten gibt.");



  AddDetail( ({"tuerbogen","durchgang","bogen"}),
   "Ein grosser bogenfoermiger Durchgang, der in die Bar fuehrt. Er ist mit "
   "einigen Edelsteinen verziert und ist so ein wahrlicher Hingucker.");

  AddDetail( ({"edelsteinen","edelsteine","art"}),
   "Fast alles hier wurde mit bunten Edelsteinen aller Art geschmueckt.");

  AddDetail( ({"bar"}),
   "Geh doch hin! Trink etwas und ruh Dich aus, es wird Dir gewiss guttun.");

  AddDetail( ({"hingucker","blick"}),
   "Du kannst Deinen Blick nicht von diesem Prunk abwenden.");

  AddDetail( ({"prunk"}),
   "Irgendwie findest Du hier alles etwas zu pompoes und kitschig. Aber das "
   "Schloss der Zauberfee muss wohl so sein.");

  AddDetail( ({"zauberfee","fee"}),
   "Wenn sie nicht da ist, badet sie sicher im See von Rhondonit.");

  AddDetail( ({"see","see von rhondonit","rhondonit"}),
   "Durch das Fenster hast Du einen wundervollen Ausblick auf den See von "
   "Rhondonit. Das Wasser glitzert kristallklar und verleitet richtig zum "
   "Baden. Ausserdem kannst Du noch eine kleine Insel erkennen, die sich "
   "mitten im See befindet.");

  AddDetail( ({"insel"}),
   "Man munkelt sie sei etwas fuer Verliebte.");

  AddDetail( ({"besonderes","spiegel"}),
   "Du blickst in den Spiegel, zupfst etwas an Deinen Haaren herum und findest "
   "dass Du extremst gut aussiehst!");

   AddDetail( ({"haare","haaren"}),
   "Deine Haare sind toll!");



  AddDetail( ({"verliebte","liebe"}),
   "Die Liebe kommt, die Liebe geht, doch solang sie da ist, geniess sie!");

  AddDetail( ({"wasser","haut"}),
   "Das Wasser wuerde sicher angenehm auf Deiner heissen Haut prickeln.");

  AddDetail( ({"vorhaenge","seidenvorhaenge"}),
   "Die bluetenweissen Seidenvorhaenge, wurden wunderschoen drapiert und "
   "werden von kleinen, perlenverzierten Kordeln zusammengehalten.");
 
  AddDetail( ({"kordeln","kordel","perlenstraengen","perlenstraenge"}),
   "Die Kordeln bestehen aus einigen Perlenstraengen.");


  AddDetail( ({"ecke"}),
   "Ein schoener Kristalltisch mit einem kleinen Stuhl steht in einer Ecke.");

  AddDetail( ({"kristalltisch","tisch"}),
   "Der Tisch besteht aus zart geschliffenem Kristall. Die Tischbeine sind "
   "geschwungen und die Tischplatte hat die Form einer Rose. Eine kleine "
   "Vase steht darauf.");

  AddDetail( ({"tischplatte","platte","form","rose","rosenform"}),
   "Die Rosenform der Tischplatte ist wirklich bewundernswert.");

  AddDetail( ({"tischbeine","beine"}),
   "Zart geschwungen.");

  AddDetail( ({"vase","kristallvase","kristallorchidee","orchidee"}),
   "Eine einfache Kristallvase mit einer Kristallorchidee darin.");

  AddDetail( ({"stuhl"}),
   "An dem Stuhl ist nichts besonderes, ausser dass er aus rosa Kristall "
   "besteht.");

  AddDetail( ({"decke","boden"}),
   "Die Decke und der Boden besteht aus rosa funkelndem Kristall.");

  AddDetail( ({"verkaufstresen","tresen"}),
   "Der Tresen wurde mit vielen Perlen und Edelsteinen verziert. Lediglich "
   "eine durchsichtige Kristallkugel befindet sich darauf.");

  AddDetail( ({"kugel","kristallkugel","kassa","muenzen"}),
   "Die Kristallkugel dient hier anscheinend als Kasse. Unzaehlige Muenzen "
   "befinden sich darin.");

  
  AddDetail( ({"kraeuter","kraeutern"}),
   "Sehen kannst Du sie nicht, nur riechen.");

  AddDetail( ({"ufer","wellen","plaetschern","geraeusch"}),
   "Lauschen!");

   
  AddSmell(DEFAULT_SMELL, "Es duftet herrlich nach frischer Waldluft, die "
		  "durch das geoeffnete Fenster stroemt.");
                        
 
  AddSmell( ({"waldluft","luft"}),
	   "Die Waldluft riecht frisch und nach wuerzigen Kraeutern.");

  
  AddSmell( ({"kraeutern","kraeuter"}),
	   "Du kannst nicht genau feststellen nach welchen Kraeutern es hier "
	   "riecht.");
  
  AddSound(DEFAULT_SOUND, "Du hoerst hier das leise Plaetschern der Wellen "
		  "vom See.");
	   

  AddSound( ({"wellen","plaetschern","see","geraeusch"}),
	   "Die Wellen plaetschern an das Ufer und erzeugen ein beruhigendes "
	   "Geraeusch.");

  AddSound( ({"ufer"}),
	    "Du lauschst und hoerst wie die Wellen gegen das Ufer schlagen.");



//-----------Details Ende--------------------------------


  AddExit("sueden", ROOM "bar");
  AddExit("norden", KRISTALLWALD);
  
  AddItem(NPC "amalia.lpc", REFRESH_DESTRUCT);

}

    int sell(string str, int f)
   
{
  notify_fail("Amalia sagt: Tut mir leid, ich kaufe nichts!\n");
  return 0;
}

  int force_sell(string str) { return sell(); }
  int evaluate(string str) { return sell(); }

