inherit "std/thing"; 

#include "../def.h"

int ladungen = 10;

void create()
{ 
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Elbenstein");
  SetProp(P_LONG, 
    "Ein kleiner Kristallflakon mit duftendem Parfuem. Er ist sechseckig und "
    "nachtschwarz. An der Oberseite befindet sich ein kleiner Zerstaeuber mit "
    "dem Du das Parfuem auftragen kannst. Du kannst Dich mit dem Kommando "
    "'spruehe mich mit parfum ein' einparfuemieren."); 
  SetProp(P_NAME, "Flakon");
  SetProp(P_GENDER, MALE);
  AddId (({"flakon","elbenstein","kristallflakon","parfuem","parfum"}));

  SetProp(P_VALUE, 1000);
  SetProp(P_WEIGHT, 10);

  AddCmd( ({"sprueh", "spruehe"}), "cmd_spruehen" );
}

int cmd_spruehen(string str)
{
  notify_fail("Wen willst Du einspruehen?\n");
  if (str != "mich mit parfum ein")
    return 0;
  write("Du spruehst Dich mit Parfum ein.\n");
  say(CAP(TPN) + " sprueht sich mit Parfum ein.\n");
  if(!present( "\nparfum", TP))
	  CLONE( "/d/kristallwald/aaliyah/schloss/obj/parfum", TP);
  if (--ladungen <= 0)
  {
    write("Der Flakon ist nun leer. Veraegert wirfst Du ihn weg.\n");
    remove();
  }
  return 1;
}

string _query_long()
{
  return BS(sprintf("Ein kleiner Kristallflakon mit duftendem Parfuem. "
		"Er ist sechseckig und nachtschwarz. An der Oberseite "
		"befindet sich ein kleiner Zerstaeuber mit dem Du dich "
		"einparfuemieren kannst. Mit dem Befehl 'spruehe mich mit "
		"parfum ein' kannst Du dich einspruehen. Es ist noch genug "
		"fuer %d Anwendungen uebrig.", ladungen));
}
