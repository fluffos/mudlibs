#include "../def.h"
#include <properties.h>
#include <properties.h>
inherit "/std/container";
#include <wizlevels.h>
#include <food.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Eine schoene Kristallrose");
  SetProp(P_LONG, BS("Diese Rose ist ein maerchenhaftes Gebilde aus Kristall. "
  "Ihre filigranen Bluetenblaetter bilden in der Mitte eine kleine Woelbung. "
  "Am zarten Stiel der Rose haben sich zwei Rosenblaetter gebildet und sehen "
  "so zerbrechlich aus, dass Du Sorge hast, sie wuerde in Deiner Hand "
  "zerbrechen."));
  AddId(({"rose", "kristallrose","gebilde"}));
  SetProp(P_NAME, "Kristallrose");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 150);
  SetProp(P_MAX_WEIGHT, 1200);
  SetProp(P_VALUE, 800);
  SetProp(P_INFO, BS("Diese Rose erfuellt einen ganz besonderen Zweck."));
  SetProp(P_MATERIAL, MAT_CRYSTAL);

  AddDetail(({"woelbung","zweck","mitte"}),
   "In die kleine Woelbung kann man einen Ring oder eine Kette stecken und sie "
   "somit sehr schoen verpackt an eine liebe Person schenken.");

  AddDetail(({"bluetenblaetter"}),
   "Die Bluetenblaetter sind wohlgeformt und bilden in der Mitte eine kleine "
   "Woelbung.");

  AddDetail(({"stiel","rosenblaetter"}),
   "Der Stiel der Rose ist nicht viel dicker als ein Elfenhaar. Und auch die "
   "Bluetenblaetter, die sich darauf gebildet haben, sind so zart, dass Du "
   "Angst hast, du wuerdest sie zerbrechen.");

}

   int inname(object ob, string thestring)
{
        if (strstr(ob->QueryProp(P_SHORT),thestring,0) == -1)
                return 0;
        return 1;

}


int PreventInsert(object ob)
     {
       if ((ob->QueryProp(P_ARMOUR_TYPE) == "Ring") || (ob->QueryProp(P_ARMOUR_TYPE) == "Amulett") 
	|| (ob->QueryProp(P_ARMOUR_TYPE) == "Misc" && inname(ob,"ring")) || (ob->QueryProp(P_ARMOUR_TYPE) == "Misc" &&
		inname(ob,"kette")) || 
			(ob->QueryProp(P_ARMOUR_TYPE) == "Misc" && inname(ob,"amulett")))
         return 0;
       else
         return 1;
     }
 
