inherit "std/thing"; 

#include "../def.h"

int ladungen = 10;

void create()
{ 
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Morgentau");
  SetProp(P_LONG, 
    "Ein kleiner, zartrosa Kristallflakon. Er ist mit einem sehr edlen "
    "Parfum gefuellt und somit unter den Damen des Landes heissbegehrt. "
    "Weiters ist mit praechtigen Edelsteinen verziert und hat an der Oberseite "
    "eine Zerstaeuber. Mit dem Befehl 'spruehe mich mit parfum ein' kannst Du "
    "Dich einparfuemieren."); 
  SetProp(P_NAME, "Flakon");
  SetProp(P_GENDER, MALE);
  AddId (({"flakon","morgentau","kristallflakon","parfuem","parfum"}));

  SetProp(P_VALUE, 1000);
  SetProp(P_WEIGHT, 10);

  AddCmd( ({"sprueh", "spruehe"}), "cmd_spruehen" );
}

int cmd_spruehen(string str)
{
  notify_fail("Wen willst Du einspruehen?\n");
  if (str != "mich mit parfum ein")
    return 0;
  write("Du spruehst Dich mit Parfum ein.\n");
  say(CAP(TPN) + " sprueht sich mit Parfum ein.\n");
  if(!present( "\nparfum", TP))
  CLONE( "/d/kristallwald/aaliyah/schloss/obj/parfum2", TP);
  if (--ladungen <= 0)
  {
    write("Der Flakon ist nun leer. Traurig wirfst Du ihn weg.\n");
    remove();
  }
  return 1;
}

string _query_long()
{
  return BS(sprintf("Ein kleiner, zartrosa Kristallflakon. Er ist mit sehr "
		"edlem Parfum gefuellt und somit unter den Damen des Landes "
		"heissbegehrt. Weiters ist er mit vielen Edelsteinen verziert "
		"und hat auf der Oberseite einen Zerstaeuber. Mit dem Befehl "
		"'spruehe mich mit parfum ein' kannst Du dich einspruehen. "
		"Es ist noch genug fuer %d Anwendungen uebrig.", ladungen));
}
