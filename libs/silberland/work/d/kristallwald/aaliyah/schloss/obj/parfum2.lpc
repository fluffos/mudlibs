inherit "std/thing"; 

#include "../def.h"


void create()
{ 
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 
    "Parfumgeruch."); 
  SetProp(P_NAME, "Parfum");
  SetProp(P_GENDER, NEUTER);
  AddId (({"\nparfum"}));

  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_INVIS, 1);

}

void BecomesNetDead(object wer)
{
  while(remove_call_out("duften") != -1);
  remove();
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  if (victim == environment())
    remove();
}

void duften()
{
  object wer;
  if (!interactive(wer = MENV))
    return;
  if (!ENV(wer))
    return;

  switch(random(2))
  {
    case 0:
      tell_room(ENV(wer), wer->Name() + " stroemt einen edlen, weiblichen Duft aus.\n", ({wer}) );
      tell_object(wer, "Du stroemst einen edlen, weiblichen Duft aus.\n");
      break;

    case 1:
      tell_room(ENV(wer), wer->Name() + " duftet herrlich.\n", ({wer}) );
      tell_object(wer, "Du duftest herrlich.\n");
      break;
  }

  call_out("duften", 10 + random(20));

}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
  if (environment() && interactive(environment()))
    tell_object(environment(), "Dein Duft verfluechtigt sich.\n");
  remove();
}

void init()
{
  ::init();
  call_out("duften", 7 + random(8));
}

string extra_look()
{
  return environment()->Name() + " duftet unglaublich feminin.\n";
}
