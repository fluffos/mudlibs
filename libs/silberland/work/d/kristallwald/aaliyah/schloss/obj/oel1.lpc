// Love Creations 

#include "../def.h"
inherit "std/thing";
#include <properties.h>
#include <language.h>
#include <moving.h>

int anwendungen = 5;
int duftoel = 0;

void create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein wohlriechendes Duftoel");
  SetProp(P_NAME, "Duftoel");
  SetProp(P_LONG, BS(
   "Ein 25ml Kristallflakon mit wohlriechendem Duftoel. Es wurde eigens "
   "von den Waldfeen hergestellt. Du kannst Deinen Koerper einschmieren "
   "indem Du 'trage duftoel auf' tippst. Es reicht noch fuer @@QueryAnw@@ "
   "Anwendungen."));
  SetProp(P_GENDER, NEUTER);
  AddId( ({"kristallflakon", "duftoel", "oel", "flakon"}));

  SetProp(P_MATERIAL, ({ MAT_CRYSTAL, MAT_PLANT }) );
  SetProp(P_WEIGHT, 25);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_SMELL, "Das Duftoel duftet herrlich nach Rosen und Jasmin.\n");
  AddCmd( ({"trage", "trag"}), "auftragen");
}

int auftragen(string str)
{ 
  object *obs;

  if (str != "duftoel auf") return 0;

  if (sizeof(obs=TP->QueryArmours( ({ AT_ARMOUR,AT_GLOVE })))) 
  { 
    write("Du solltest " +  implode( map_objects(obs,  "name", WEN), " und ") + 
        " vorher ausziehen!\n");

    return 1; 
  }

  if(present("\nliebe", TP))
  {
    write("Du hast schon genuegend Duftoel aufgetragen!\n");
    return 1;
  }
  
  write("Du laesst etwas Duftoel auf Deine Hand traeufeln und schmierst\n"
	"Dich damit ein. Deine Haut fuehlt sich auf einmal so geschmeidig an.\n");
  say(TP->Name()+" reibt sich mit Duftoel ein.\n");
  if(!--anwendungen) 
  {
    write(BS("Da der Flakon nun leer ist, loest er sich auf. Wenn Du mit "
	     "diesem Produkt zufrieden warst, kannst Du es jederzeit bei "
	     "Amalia kaufen."));
    remove();
  }
  
  return 1;
}

string QueryAnw() {return ""+anwendungen+"";}

 string extra_look()
 {
  object player;
  if (!player = environment()) return "";
  if (duftoel == 1)
    return player->Name() + " hat wunderbar geschmeidige Haut.\n";
  else
    return "";  
  }


 
