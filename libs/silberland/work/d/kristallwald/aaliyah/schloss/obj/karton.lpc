#include "../def.h"
#include <properties.h>
#include <properties.h>
inherit "/obj/container";
#include <wizlevels.h>
#include <food.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein schillernder Geschenkskarton");
  SetProp(P_LONG, BS("Dieser bunte schillernde Karton ist eine nette "
		"Verpackungsmoeglichkeit fuer allerlei Geschenke. Eine grosse "
		"Schleife wurde daran befestigt."));
  AddId(({"geschenkskarton","karton","schachtel"}));
  SetProp(P_NAME, "Geschenkskarton");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 150);
  SetProp(P_MAX_WEIGHT, 1200);
  SetProp(P_VALUE, 200);
  SetProp(P_INFO, BS("Mit diesem Karton kannst Du Geschenke verpacken."));
  SetProp(P_MATERIAL, MAT_PAPER);
  SetProp(P_NAME_ADJ, "schillernd");

  AddDetail( ({"schleife"}),
   "Am Deckel des Kartons wurde eine grosse schillernde Schleife befestigt. "
   "Sie dient lediglich der Dekoration und behindert in keinster Weise das "
   "oeffnen der Schachtel.");
  
  
 
 
}


