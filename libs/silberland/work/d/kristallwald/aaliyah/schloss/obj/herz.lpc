inherit "std/thing";
#include "../def.h"
#include <properties.h>



create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Herz aus Rosenblaettern");
  SetProp(P_LONG, 
    "Ein wunderschoenes Herz aus Rosenblaettern. In der Mitte steht in grossen "
    "Buchstaben -> Ich liebe Dich <-.");
  SetProp(P_NAME, "Herz aus Rosenblaettern");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"herz"}) );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 300);
  SetProp(P_MATERIAL, ([MAT_PLANT:100]));
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 100);
  SetProp(P_ARTICLE, 1);
  
 
}  
   
