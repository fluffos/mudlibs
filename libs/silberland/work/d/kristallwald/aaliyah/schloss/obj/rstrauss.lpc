// Love Creations - Blumenstrauss

inherit "std/thing";
#include "../def.h"
#include <properties.h>



create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Rosenstrauss");
  SetProp(P_LONG, 
    "Ein wunderschoener Strauss aus langstieligen roten Rosen. Die Blueten "
    "haben eine praechtige kirschrote Farbe und duften herrlich. Sie werden "
    "von einer weissen Satinschleife zusammengehalten.");
  SetProp(P_NAME, "Rosenstrauss");
  SetProp(P_GENDER, MALE);
  AddId( ({"strauss","rosenstrauss"}) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 700);
  SetProp(P_MATERIAL, ([MAT_PLANT:100]));
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 50);
  SetProp(P_ARTICLE, 1);

  AddDetail( ({"blueten","rosen"}),
	"Die Blueten sind wunderbar kirschrot und keine Einzige ist "
	"verwelkt.");

  AddDetail( ({"farbe"}),
	"Ein tiefes Kirschrot oder auch Blutrot.");

  AddDetail( ({"satinschleife","schleife"}),
	"Eine schoene weisse Satinschleife ziert den Blumenstrauss.");
  
 
}  
   
