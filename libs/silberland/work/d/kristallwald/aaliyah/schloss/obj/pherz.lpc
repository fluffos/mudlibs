inherit "std/thing";
#include "../def.h"
#include <properties.h>



create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein rotes Plueschherz");
  SetProp(P_LONG, 
    "Das rote Plueschherz ist wunderbar weich und plueschig. Es ist das "
    "Geschenk der Person, die Dich von Herzen lieb hat.");
  SetProp(P_NAME, "Plueschherz");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"herz"}) );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 250);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]));
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 10);
  SetProp(P_NAME_ADJ, "rot");
  SetProp(P_ARTICLE, 1);
  
 
}  
   
