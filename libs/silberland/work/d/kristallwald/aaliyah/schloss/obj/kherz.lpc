inherit "std/thing";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>

string *text, line, signatur;
int line_length, length, i, j, k, space; 

void gravur(string str, int flag);
void makeSpaces(int spaces);

// closure, die die signatur zurückgibt
string show() {
	gravur(signatur,1);
	return "\n";
}


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein huebsches Kristallherz");
  SetProp(P_LONG, 
    "Ein huebsches, glitzerndes Herz aus purem Kristall. In der Mitte befindet "
    "sich ein kleines Feld, in das man etwas hineingravieren kann. Das kleine "
    "Herz kommt besonders gut zur Geltung, wenn man es an einer Kette "
    "befestigt.");
  SetProp(P_NAME, "Kristallherz");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"herz","kristall_herz","herzanhaenger","anhaenger","kristallherz"}) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 5000);
  SetProp(P_NAME_ADJ, "huebsch");
  SetProp(P_MATERIAL, ([MAT_CRYSTAL:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_SIZE, 20);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  
  AddDetail(({"signatur","gravur"}),#'show);
  
  AddCmd(({"signiere","graviere"}),"signieren");
}  

// das Kommando, das die funktion gravur(string,int) aufruft   
signieren(string str) {
	notify_fail("Was moechtest Du signieren?\n");
	if(!str) return 0;
	if(str == "herzanhaenger" || str == "kristallherz" || str == "herz" || str == "anhaenger") {
		write("Deine Gravur (q = Abbruch, max 40 Zeichen pro Wort -> fallend):\n");
		input_to("gravur",0);
		return 1;
	} else return 0;
}

// 1. schreibt den string in das Herz
// 2. gibt das herz für die closure aus
void gravur(string str, int flag) {
	length = 50;
	line_length = 40;
	space = 0;
	j = 0;
	if( (!str && flag == 0) || (strlen(str) == 0 && flag == 0) ) { 
		write("Deine Gravur (q = Abbruch, max 39 Zeichen pro Wort -> fallend):\n");
		input_to("gravur",0);
	} else {
		if(str == "q")
			write("Du brichst das Gravieren ab.\n");
		else {
			text = explode(str," ");
			for(i = 0; i < sizeof(text); i++) {
				if(strlen(text[i]) >= line_length) {
					write("Folgendes Wort ist zu lang: "+text[i]+" = "+strlen(text[i])+" Zeichen\n");
					write("Deine Gravur (q = Abbruch, max 39 Zeichen pro Wort -> fallend):\n");
					flag = 2;
					input_to("gravur",0);
					break;
				}
			}
			if(flag != 2) {
				write("            H H                    H H\n");
				write("          H     H                H     H\n");
				write("        H         H           H          H\n");
				write("      H              H     H               H\n");
				write("    H                   H                    H\n");
				write("   H                                          H\n");
				write("  H                                            H\n");
				write(" H                                              H\n");
				write("H                                                H\n");
				write("H                                                H\n");
				for(i = 0; i < 11; i++) {
					if( (j+1) <= sizeof(text)) {
						line = "";
						for(j; j < sizeof(text); j++) {
							if(strlen(line) < line_length && (strlen(line)+strlen(text[j])) < line_length) {
								if(strlen(line) != 0)
									line += " " + text[j];
								else 
									line += text[j];
							} else {
								if(strlen(text[j]) > line_length)
									flag = 2;
								break;
							}
						}
						if(flag == 2){
							write("Folgendes Wort ist mit "+line_length+" Zeichen in der entsprechenden Zeile zu lang: "+text[j]+"\n");
							write("Deine Gravur (q = Abbruch, max 39 Zeichen pro Wort -> fallend):\n");
							input_to("gravur",0);
							break;
						}	
						space ++;
						switch(i) {
							case 0 : write("H");
											 makeSpaces((length - strlen(line)) / 2);
											 write(line);
											 makeSpaces((length - strlen(line)) / 2);
											 // falls das ergebnis der aufteilung ungerade ist...Modulo
											 if( (length - strlen(line))%2 != 0 )
											 		write(" ");
											 write("H\n");
											 break;
							case 1 : makeSpaces(space);
											 write("H");
											 makeSpaces( ((length - strlen(line)) / 2) -1);
											 write(line);
											 makeSpaces( ((length - strlen(line)) / 2) -1);
											 // falls das ergebnis der aufteilung ungerade ist...Modulo
											 if( (length - strlen(line))%2 != 0 )
											 		write(" ");
											 write("H\n");
											 break;
							case 2 : makeSpaces(space);
											 write("H");
											 makeSpaces( ((length - strlen(line)) / 2) -2);
											 write(line);
											 makeSpaces( ((length - strlen(line)) / 2) -2);
											 // falls das ergebnis der aufteilung ungerade ist...Modulo
											 if( (length - strlen(line))%2 != 0 )
											 		write(" ");
											 write("H\n");
											 break;
							case 3 : makeSpaces(space);
											 write("H");
											 makeSpaces( ((length - strlen(line)) / 2) -3);
											 write(line);
											 makeSpaces( ((length - strlen(line)) / 2) -3);
											 // falls das ergebnis der aufteilung ungerade ist...Modulo
											 if( (length - strlen(line))%2 != 0 )
											 		write(" ");
											 write("H\n");
											 break;
							case 4 : makeSpaces(space);
											 write("H");
											 makeSpaces( ((length - strlen(line)) / 2) -4);
											 write(line);
											 makeSpaces( ((length - strlen(line)) / 2) -4);
											 // falls das ergebnis der aufteilung ungerade ist...Modulo
											 if( (length - strlen(line))%2 != 0 )
											 		write(" ");
											 write("H\n");
											 break;
							case 5 : makeSpaces(space);
											 write("H");
											 makeSpaces( ((length - strlen(line)) / 2) -5);
											 write(line);
											 makeSpaces( ((length - strlen(line)) / 2) -5);
											 // falls das ergebnis der aufteilung ungerade ist...Modulo
											 if( (length - strlen(line))%2 != 0 )
											 		write(" ");
											 write("H\n");
											 break;
							case 6 : makeSpaces(space);
											 write("H");
											 makeSpaces( ((length - strlen(line)) / 2) -6);
											 write(line);
											 makeSpaces( ((length - strlen(line)) / 2) -6);
											 // falls das ergebnis der aufteilung ungerade ist...Modulo
											 if( (length - strlen(line))%2 != 0 )
											 		write(" ");
											 write("H\n");
											 break;
							case 7 : makeSpaces(space);
											 write("H");
											 makeSpaces( ((length - strlen(line)) / 2) -7);
											 write(line);
											 makeSpaces( ((length - strlen(line)) / 2) -7);
											 // falls das ergebnis der aufteilung ungerade ist...Modulo
											 if( (length - strlen(line))%2 != 0 )
											 		write(" ");
											 write("H\n");
											 break;
							case 8 : makeSpaces(space);
											 write("H");
											 makeSpaces( ((length - strlen(line)) / 2) -8);
											 write(line);
											 makeSpaces( ((length - strlen(line)) / 2) -8);
											 // falls das ergebnis der aufteilung ungerade ist...Modulo
											 if( (length - strlen(line))%2 != 0 )
											 		write(" ");
											 write("H\n");
											 break;
							case 9 : makeSpaces(space);
											 write("H");
											 makeSpaces( ((length - strlen(line)) / 2) -9);
											 write(line);
											 makeSpaces( ((length - strlen(line)) / 2) -9);
											 // falls das ergebnis der aufteilung ungerade ist...Modulo
											 if( (length - strlen(line))%2 != 0 )
											 		write(" ");
											 write("H\n");
											 break;
							case 10 : makeSpaces(space);
											 write("H");
											 makeSpaces( ((length - strlen(line)) / 2) -10);
											 write(line);
											 makeSpaces( ((length - strlen(line)) / 2) -10);
											 // falls das ergebnis der aufteilung ungerade ist...Modulo
											 if( (length - strlen(line))%2 != 0 )
											 		write(" ");
											 write("H\n");
											 break;
							case 11 : makeSpaces(space);
											 write("H");
											 makeSpaces( ((length - strlen(line)) / 2) -11);
											 write(line);
											 makeSpaces( ((length - strlen(line)) / 2) -11);
											 // falls das ergebnis der aufteilung ungerade ist...Modulo
											 if( (length - strlen(line))%2 != 0 )
											 		write(" ");
											 write("H\n");
											 break;
						}
						line_length -= 2;
					} else break;
				}
				while( (length - (2 * space)) > 0 && flag != 2) {
					space++;
					makeSpaces(space);
					write("H");
					makeSpaces( length - (2 * space)+1);
					write("H\n");
				}
				if(flag == 0){
					RemoveCmd(({"signiere","graviere"}));
					signatur = str;
				}
			}
		}
	}
}

// fuegt Leerzeichen ein
void makeSpaces(int spaces) {
	for(k = 1; k < spaces; k++) {
		write(" ");
	}
}
