#include "../def.h"
#include <properties.h>
#include <properties.h>
inherit "/obj/container";
#include <wizlevels.h>
#include <food.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein huebscher Herzkarton");
  SetProp(P_LONG, BS("Ein huebscher roter Karton in der Form eines Herzens. "
		"Er besteht aus rotem Samt und ist eigentlich sehr schlicht. "
		"Eine grosse goldene Schleife ist die einzige Dekoration, "
		"laesst ihn dafuer aber sehr edel wirken."));
  AddId(({"geschenkskarton","karton","schachtel","herzkarton"}));
  SetProp(P_NAME, "Herzkarton");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 150);
  SetProp(P_MAX_WEIGHT, 1200);
  SetProp(P_VALUE, 200);
  SetProp(P_INFO, BS("Mit diesem Karton kannst Du Geschenke verpacken."));
  SetProp(P_MATERIAL, MAT_SILK);
  SetProp(P_NAME_ADJ, "huebsch");

  AddDetail( ({"schleife"}),
   "Am Deckel des Kartons wurde eine grosse goldene Schleife befestigt. "
   "Sie dient lediglich der Dekoration und behindert in keinster Weise das "
   "Oeffnen der Schachtel.");
  
  
 
 
}


