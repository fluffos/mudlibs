// Love Creations - Blumenstrauss

inherit "std/thing";
#include "../def.h"
#include <properties.h>



create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Wasserblumenstrauss");
  SetProp(P_LONG, 
    "Ein wunderschoener Strauss aus Wasserblumen. Die Blueten sehen wie "
    "Orchideen aus, nur bestehen sie voellig aus Wasser. Sie schimmern "
    "in allen erdenklichen Blautoenen. Der Strauss wird von einer weissen "
    "Satinschleife zusammengehalten und sieht wirklich huebsch aus.");
  SetProp(P_NAME, "Wasserblumenstrauss");
  SetProp(P_GENDER, MALE);
  AddId( ({"strauss","wasserblumenstrauss","blumenstrauss"}) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 4000);
  SetProp(P_MATERIAL, ([MAT_WATER:100]));
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 50);
  SetProp(P_ARTICLE, 1);
   SetProp(P_SMELL, BS("Du riechst an dem Wasserblumenstrauss und er "
		"erinnert Dich an einen lauen Sommernachtsabend am Strand. "
		"Du siehst Dich im Sand sitzen, vor Dir ein Lagerfeuer, "
		"neben Dir ein leckerer Cocktail. Vom Pier droehnt tolle "
		"Partymusik und eine leichte salzige Meeresbrise weht "
		"Dir durch die Haare.") );
  

  AddDetail( ({"blueten","orchideen"}),
	"Die Blueten aehneln denen, einer Orchidee. nur sind sie blau und "
	"bestehen voellig aus Wasser.");

  AddDetail( ({"blautoene","blautoenen","blau","toene"}),
	"Von Dunkelblau bis zu Himmelblau, ueber Hellblau und Eisblau, bis "
	"zu tiefem Azurblau und auch Babyblau, nicht zu vergessen "
	"Aquamarinblau und Marineblau und das knallige Blitzblau. Einfach "
	"in jedem Blau schimmern sie.");
  
 
}  
   
