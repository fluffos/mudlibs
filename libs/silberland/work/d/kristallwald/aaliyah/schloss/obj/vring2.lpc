inherit "std/armour";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein schimmernder Verlobungsring");
  SetProp(P_LONG, 
    "Ein wunderschoener Verlobungsring mit einer grossen Fassung, in der sich "
    "ein magischer Diamant befindet. An einem zarten Frauenfinger sieht "
    "dieser Ring gewiss ganz toll aus.");
  SetProp(P_NAME, "Verlobungsring");
  SetProp(P_GENDER, MALE); 
  AddId( ({"ring","verlobungsring"}) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 5000);
  SetProp(P_MATERIAL, ([MAT_MAGIC:100]));
  SetProp(P_NAME_ADJ, "schimmernd");
  SetProp(P_LIGHT, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
 
			  
  
    
 }  
   
