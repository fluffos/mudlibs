// Love Creations - Blumenstrauss

inherit "std/thing";
#include "../def.h"
#include <properties.h>



create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Eisblumenstrauss");
  SetProp(P_LONG, 
    "Ein prachtvoller Strauss aus zarten Eisblumen. Ihre filigranen Blueten "
    "haben sternfoermige Muster und sind einfach wundervoll. Der Strauss ist "
    "so zart, dass man Angst bekommt ihn zu zerbrechen. Eine hellblaue "
    "Satinschleife ziert den Strauss und vollendet das Gesamtbild.");
  SetProp(P_NAME, "Eisblumenstrauss");
  SetProp(P_GENDER, MALE);
  AddId( ({"strauss","Eisblumenstrauss","blumenstrauss"}) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 500);
  SetProp(P_MATERIAL, ([MAT_ICE:100]));
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 30);
  SetProp(P_ARTICLE, 1);
  SetProp(P_SMELL, BS("Der Duft der Eisblumen erinnert Dich an einen schoenen "
                  "Winterabend. Du stellst Dir vor, dass Du in einer "
                  "lauschigen Winterhuette vor einem gemuetlichen Kamin "
                  "sitzt, umgeben von verschneiten Bergen und grossen "
                  "Tannen. Einen leckeren Bratapfel isst und heissen Tee "
                  "schluerfst.") );
  
  AddDetail( ({"blueten","eisblumen"}),
	"Wunderschoene Gebilde sind entstanden und sich zu filigranen "
	"Blueten gebildet.");

  AddDetail( ({"farbe"}),
	"Weiss mit einem eisblauen Schimmer.");

  AddDetail( ({"satinschleife","schleife"}),
	"Eine schoene weisse Satinschleife ziert den Blumenstrauss.");
  
 
}  
   
