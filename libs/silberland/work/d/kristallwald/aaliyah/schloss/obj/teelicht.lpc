inherit "std/lightsource";

#include "../def.h"
#include <properties.h>
#include <lightsource.h>


create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Teelicht");
  SetProp(P_LONG, 
    "Ein einfaches Teelicht, mit dem man einen Raum sehr stimmungsvoll "
    "gestalten kann. Du kannst es anzuenden und auch wieder loeschen.");
  SetProp(P_NAME, "Teelicht");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"teelicht"}) );
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 100);
  SetProp(P_MATERIAL, ([MAT_WAX:100]));
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 30);
  SetProp(P_FUEL, 1500);
  SetProp(P_ARTICLE, 1);
  SetProp(P_LIGHTDESC,
      ({ "glimmend","flackernd","leicht flackernd","brennend",
         "hell lodernd","frisch angezuendet" }) );
 
}  
   
