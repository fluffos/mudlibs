inherit "std/armour";
#include "../def.h"

int herz_drauf;
void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine funkelnde Kristallkette");
  SetProp(P_LONG, 
    "Aus vielen Kristallen des Silberlandes wurde diese Kette erschaffen. Sie "
    "wurden zu huebschen kleinen Perlen geschliffen und auf ein Elfenhaar "
    "gefaedelt. Mit einem kleinen Anhaenger aus Gold oder Kristall wuerde "
    "die Kette noch viel huebscher aussehen.");
  SetProp(P_NAME, "funkelnde Kristallkette");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"kette","kristallkette"}) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 10000);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_CRYSTAL:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_PLURAL, 0);

  AddDetail( ({"kristalle","kristallen","perlen"}),
    "Die Kristallperlen der Kette glitzern und funkeln und es erfreut Dich, "
    "dass Du so eine tolle Kette besitzt.");

  AddCmd( ({ "steck", "stecke", "befestige", "befestig" }), "c_befestigen");

 }

 int c_befestigen(string str)
 {
object ob;

  notify_fail(BS("Was moechtest Du woran befestigen?"));
   if (str == "herz an kette" || str == "herz an goldkette" || 
    str == "kristallherz an kette" || str == "goldherz an kette" ||
    str == "herzanhaenger an kette" || str == "herzanhaenger an goldkette" ||
    str == "kristallherz an goldkette" || str == "goldherz an goldkette")
 {
    if (herz_drauf) {
      write(BS("Aber es steckt ja schon ein Anhaenger auf der Kette!"));
      return -1;
    }
    if (!(ob = present("shop_herz", TP)) && !(ob = present("kristall_herz",
 TP))) {
      write(BS("Aber Du hast doch gar keinen passenden Herzanhaenger!"));
      return -1;
    }

    if (ob->id("shop_herz")) {
      write(BS("Du befestigst das Herz an der Kristallkette."));
      SetProp(P_MATERIAL, ([MAT_CRYSTAL:90, MAT_GOLD:10]));
     SetProp(P_LONG,
        "Eine filigrane Kette aus funkelndem Kristall. Ein kleines Herz aus "
        "Gold wurde daran befestigt und glaenzt leicht im Sonnenlicht. Diese "
        "Kette war gewiss ein Geschenk und hat somit einen ganz besonderen Wert.");
    }
    else {
      write(BS("Du befestigst das Kristallherz an der Kristallkette."));
     
      SetProp(P_LONG,
       "Eine filigrane Kette aus funkelndem Kristall. Ein kleines Kristallherz "
       "wurde daran befestigt. Diese Kette war gewiss ein Geschenk und hat "
       "somit einen besonderen Wert.");
    }

    herz_drauf = 1;
    ob->remove();
    return 1;
  }

  return 0;
}
      
