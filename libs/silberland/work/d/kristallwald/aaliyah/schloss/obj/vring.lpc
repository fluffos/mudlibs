inherit "std/armour";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein funkelnder Verlobungsring");
  SetProp(P_LONG, 
    "Ein wunderschoener Verlobungsring mit einer elipsenfoermigen Fassung, in "
    "der sich ein glaenzender Diamant befindet. Irgendwie scheint es so, als "
    "wuerde im Diamant ein kleines rosa Herz pulsieren.");
  SetProp(P_NAME, "Verlobungsring");
  SetProp(P_GENDER, MALE); 
  AddId( ({"ring","verlobungsring"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 5000);
  SetProp(P_MATERIAL, ([MAT_DIAMOND:100]));
  SetProp(P_NAME_ADJ, "funkelnd");
  SetProp(P_LIGHT, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
 
			  
  
    
 }  
   
