inherit "std/armour";

#include "../def.h"

int blume = 0;
void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine silberne Wolkenblume");
  SetProp(P_LONG, 
    "Die Wolkenblume sieht wattig weich aus. Viele Glitzerpartikel schimmern "
    "auf ihren grossen Bluetenblaettern. Ins Haar gesteckt, ist sie sicher "
    "ein sehr nettes Accessoire. Du kannst sie in Deine Haare stecken und "
    "sie auch wieder entfernen.");
  SetProp(P_NAME, "Wolkenblume");
  SetProp(P_INFO, "Steck sie Dir doch einfach in Dein Haar.");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"blume","wolkenblume"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 800);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]));
  SetProp(P_NAME_ADJ, "silbern");
  SetProp(P_LIGHT, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
 
 
//---------------KOMMANDOS------------------------------ 

  AddCmd( ({ "stecke", "steck" }), "c_stecken" );
  AddCmd( ({ "entferne", "entfern" }), "c_entfernen");

  
}  
  int c_stecken(string str)
  
  {
   notify_fail(BS("Was moechtest Du Dir ins Haar stecken?"));
   if(!(str == "blume ins haar"))
   {
     return 0;
   }
   if (blume == 1)
   {
	  
   write(BS("Du hast doch schon eine Blume im Haar. Wenn Du jetzt noch mehr "
	    "dazusteckst, kannst Du einen Blumenladen auf deinem Kopf "
	    "eroeffnen."));
    say(TPN +" haette gerne einen Blumenladen auf dem Kopf.\n", ({TP}) );
     return 1;
   }
   
   write(BS("Du nimmst die Blume und steckst sie Dir verzueckt in Deine "
	    "wunderschoenen Haare."));
   say(TPN +" steckt sich eine Blume ins Haar.\n", ({TP}) );
   blume = 1;
   return 1;
  }
  string extra_look()
 {
  object player;
  if (!player = environment()) return "";
  if (blume == 1)
    return player->Name() + " hat eine wunderschoene Blume ins Haar gesteckt.\n";
  else
    return "";  
  }
  int c_entfernen(string str)
  
  {
   notify_fail(BS("Was moechtest Du denn entfernen?"));
   if(!(str == "blume aus haar"))
   {
    
     return 0;
   }
    if (blume == 0)
   {
	  
   write(BS("Du hast nichts in den Haaren, was Du entfernen koenntest."));
    say(TPN +" zerzaust sich die Haare.\n", ({TP}) );
     return 1;
   }
   
   write(BS("Du entfernst sanft die Blume aus deinen Haaren."));
   say(TPN +" entfernt eine Blume aus den Haaren.\n", ({TP}) );
   blume = 0;
   return 1;
  }

