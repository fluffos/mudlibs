// Love Creations - Blumenstrauss

inherit "std/thing";
#include "../def.h"
#include <properties.h>



create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Kristallblumenstrauss");
  SetProp(P_LONG, 
    "Ein wunderschoener Strauss aus Kristallblumen. Die Blueten aehneln "
    "denen, einer Sonnenblume nur dass sie voellig aus Kristall bestehen. "
    "Der ganze Strauss glitzert kristallin und wird von einer schoenen "
    "rosa Satinschleife zusammengehalten.");
  SetProp(P_NAME, "Kristallblumenstrauss");
  SetProp(P_GENDER, MALE);
  AddId( ({"strauss","kristallblumenstrauss","blumenstrauss"}) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 6000);
  SetProp(P_MATERIAL, ([MAT_CRYSTAL:100]));
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 50);
  SetProp(P_ARTICLE, 1);
  SetProp(P_SMELL, BS("Du riechst an dem Kristallblumenstrauss und er erinnert "
		"Dich an einen wundervollen Fruehlingsmorgen. Frischer "
		"Morgentau schimmert auf den Blumen und der ganzen Wiese. "
		"Rund um Dich stehen Obstbaeume, deren Blueten vom Wind in "
		"Deine Haare geweht werden. Die ganze Luft ist von Bluetenduft "                "erfuellt.") );
  

  AddDetail( ({"blueten","sonnenblume"}),
	"Die Blueten aehneln denen, einer Sonnenblume nur glitzern sie "
	"in allen Spektralfarben und bestehen voellig aus Kristall.");

  AddDetail( ({"spektralfarben","farben"}),
	"Rot, blau, violett, gelb, gruen und rosa zum Beispiel.");

  AddDetail( ({"satinschleife","schleife"}),
	"Eine schoene rosa Satinschleife ziert den Blumenstrauss.");
  
 
}  
   
