inherit "std/food";
#include <properties.h>
#include <food.h>
#include "../def.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Erdbeere mit Schokoglasur");
  SetProp (P_LONG, "Eine schoene rote Erdbeere, die in Schokolade getuncht "
		  "wurde. Sie sieht lecker aus und laesst Dir das Wasser im "
		  "Mund zusammenlaufen.");
     
  SetProp (P_NAME, "Erdbeere mit Schokoglasur");
  SetProp (P_GENDER, FEMALE);
  AddId (({"beere", "frucht","erdbeere","erdbeere mit schokoglasur"}));
  SetProp (P_INFO, ("Die Erdbeere schmeckt sicher vorzueglich."));
  SetProp (P_ARTICLE, 1);
  SetProp (P_VALUE, 50);
  SetProp (P_WEIGHT, 10);
  SetProp (P_NOBUY, 0);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL: 10, F_SOAK: 1, F_ALCOHOL: 0, F_POISON:0,
  F_MSG: "Du verspeist die Erdbeere mit grossem Genuss.\n",
  F_MSG_ROOM: "nascht genuesslich eine Schokoerdbeere.\n"]));
 
}

