inherit "std/armour";
#include "../def.h"

int herz_drauf;
void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine edle Silberkette");
  SetProp(P_LONG, 
    "Diese antike Silberkette wurde vor vielen Jahren von den Zwergen im "
    "Bergwerk erschaffen. Sie haben sehr viel Arbeit investiert um sie so "
    "zart und schoen wie moeglich zu schmieden. Und ihre Arbeit kann sich "
    "sehen lassen. Die vielen, ineinander verschlungenen Silberschnoerkel sind "    "ein Gedicht.");
  SetProp(P_NAME, "edle Silberkette");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"kette","silberkette"}) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 5000);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_SILVER:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_PLURAL, 0);

  AddDetail( ({"silberschnoerkel","schnoerkel"}),
    "Die vielen Silberschnoerkel sind ineinander verschlungen und bilden "
    "eine schoene Kette.");

  AddCmd( ({ "steck", "stecke", "befestige", "befestig" }), "c_befestigen");

 }

 int c_befestigen(string str)
 {
object ob;

  notify_fail(BS("Was moechtest Du woran befestigen?"));
  if (str == "herz an kette" || str == "herz an silberkette") {
    if (herz_drauf) {
      write(BS("Aber es steckt ja schon ein Anhaenger auf der Kette!"));
      return -1;
    }
    if (!(ob = present("shop_herz", TP)) && !(ob = present("kristall_herz",
 TP))) {
      write(BS("Aber Du hast doch gar keinen Anhaenger!"));
      return -1;
    }

    if (ob->id("shop_herz")) {
      write(BS("Du befestigst das Herz an der Silberkette."));
      SetProp(P_MATERIAL, ([MAT_SILVER:90, MAT_GOLD:10]));
     SetProp(P_LONG,
        "Eine filigrane Kette aus leuchtendem Silber. Ein kleines Herz aus "
        "Gold wurde daran befestigt und glaenzt leicht im Sonnenlicht. Diese "
        "Kette war gewiss ein Geschenk und hat somit einen ganz besonderen Wert.");
    }
    else {
      write(BS("Du befestigst das Kristallherz an der Silberkette."));
      SetProp(P_MATERIAL, ([MAT_SILVER:90, MAT_CRYSTAL:10]));
      SetProp(P_LONG,
       "Eine filigrane Kette aus leuchtendem Silber. Ein kleines Kristallherz "
       "wurde daran befestigt. Diese Kette war gewiss ein Geschenk und hat "
       "somit einen besonderen Wert.");
    }

    herz_drauf = 1;
    ob->remove();
    return 1;
  }

  return 0;
}
      
