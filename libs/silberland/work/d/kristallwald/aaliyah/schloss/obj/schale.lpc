#include "../def.h"
#include <properties.h>
#include <properties.h>
inherit "/std/container";
#include <wizlevels.h>
#include <food.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Eine Kristallschale");
  SetProp(P_LONG, BS("Eine wunderschoene Kristallschale, die nicht nur eine "
  "schoene Dekoration fuer ein Seherhaus ist, sondern sich auch noch "
  "hervorragend zum Aufbewahren von Obst eignet."));
  AddId(({"schale", "kristallschale"}));
  SetProp(P_NAME, "Kristallschale");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 150);
  SetProp(P_MAX_WEIGHT, 1200);
  SetProp(P_VALUE, 400);
  SetProp(P_INFO, BS("Aus dieser Schale kannst Du mit dem Befehl ´nasche "
  "aus schale' etwas Obst naschen."));
  SetProp(P_MATERIAL, MAT_CRYSTAL);

  AddDetail(({"dekoration"}),
   "Die Schale ist sicher eine huebsche Dekoration fuer Dein Seherhaus.");
 
  AddCmd(("nasche"), "proviant");
}

int proviant(string str) {
object essen;

   notify_fail("Woraus willst Du gerne naschen?\n");

   if(str=="aus schale") {



if( TP && environment(TO) && interactive(environment(TO)) )  {
say(BS(
CAP_TPN+" nascht aus der Kristallschale."));

write(BS(
"Du moechtest aus der Kristallschale naschen."));        

essen=first_inventory(TO);

if(! essen )  {
        
        write(BS(
                "Die Kristallschale ist leider leer."));
                return 1; }
else {

TP->command_me( "nimm "+essen->name()+" aus kristallschale");
TP->command_me( "iss "+essen->name()+"");
if(IS_WIZARD(TP))  {
        write(BS(
        "Ein Magier soll programmieren und nicht naschen."));
        }
        
           return 1;}

return 0;
}
return 0; }
return 0; }


varargs int PreventInsert(object ob) {

if( !ob->id("PB_PERMISSION")&&!ob->QueryProp(P_FOOD_INFO) ) {

write(
""+CAP(ob->name(WER))+" ist doch nicht essbar!\n");
                return 1;
        } 

        else {        
          return ::PreventInsert(ob);
} }


   
