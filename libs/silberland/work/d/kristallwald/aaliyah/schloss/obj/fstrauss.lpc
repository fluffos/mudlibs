// Love Creations - Blumenstrauss

inherit "std/thing";
#include "../def.h"
#include <properties.h>



create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Feuerblumenstrauss");
  SetProp(P_LONG, 
    "Ein sensationeller Strauss aus Feuerblumen. Die Blueten zuengeln "
    "in einer tiefen blutroten Farbe empor und sind einfach praechtig. "
    "Seltsamerweise verbrennt man sich daran nicht die Finger. Diese "
    "Blumen sind sehr selten und wachsen nur in gefaehrlichen Gegenden.");
  SetProp(P_NAME, "Feuerblumenstrauss");
  SetProp(P_GENDER, MALE);
  AddId( ({"strauss","feuerblumenstrauss","blumenstrauss"}) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 3000);
  SetProp(P_MATERIAL, ([MAT_FIRE:100]));
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 30);
  SetProp(P_ARTICLE, 1);
  SetProp(P_SMELL, BS("Du riechst an dem Feuerblumenstrauss und er erinnert "
		"Dich an einen schoenen Herbstnachmittag. Du gehst inmitten "
		"von Baeumen spazieren. Der Boden ist voll von bunten, "
		"abgefallenen Blaettern und Du riechst den Duft von "
		"verbranntem Holz. Leicht lichtet sich der Nebel und doch "
		"tritt kein Sonnenstrahl an Dich heran. Dich froestelt es, "
		"aber trotzdem geniesst Du jede einzelne dieser Minuten.") );
  

  AddDetail( ({"blueten","feuerblumen"}),
	"Heiss schlaengeln sich die Feuerblueten in die Luefte.");

  AddDetail( ({"farbe"}),
	"Ein tiefes Kirschrot oder auch Blutrot.");

  AddDetail( ({"satinschleife","schleife"}),
	"Eine schoene weisse Satinschleife ziert den Blumenstrauss.");
  
 
}  
   
