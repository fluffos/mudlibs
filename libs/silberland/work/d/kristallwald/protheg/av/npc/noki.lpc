/*
** Noki, der Starke
**
** Dridergebrueder Noki und Woki, bewachen das Portal
*/

#include "../def.h"

inherit MOST "mynpc";

#define AI(x,y) AddInfo(x, y, "sagt: ")

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Noki, der Starke");
  SetProp(P_LONG,
	  BS("Das ist Noki, der Starke. Sein Bruder Woki und er wurden "
	     "lange Jahre von den Dunkelelfen nur fuer einen Zweck "
	     "ausgebildet und zwar, die Bewachung eines Dimensionsportales. "
	     "Noki ist ein sehr stark gebauter Drider, jedoch fehlt ihm "
	     "seit einem heftigen Kampf eines seiner spinnenartigen Beine."));
  
  SetProp(P_ARTICLE, 0);

  SetProp(P_NAME, "Noki");
  SetProp(P_GENDER, MALE);
  AddId(({"drider", "\ndrider","Schwertexperte", "waechter", "noki"}));
  
  create_default_npc(30);
  
  SetProp(P_HANDS, ({" mit seinen Spinnenbeinen",
		       QueryProp(P_HANDS)[1]+30, DT_PIERCE}));
  SetProp(P_RACE, "Drider");
  SetProp(P_SIZE, 210);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 7);
  SetProp(P_BODY, QueryProp(P_BODY)+100);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.1, DT_COLD:      0.1, DT_WATER:  -0.1, DT_AIR:    0.0,
      DT_LIGHTNING: -0.1, DT_EXPLOSION: 0.1, DT_SOUND:  0.0, DT_LIGHT:  0.1,
      DT_ELECTRIC:  0.1, DT_ACID:      0.1, DT_POISON: -0.8, DT_TERROR: -0.2,
      DT_HOLY:      0.2, DT_UNHOLY:    -0.2, DT_MAGIC:  -0.2 ]));

  SetProp(P_NOMAGIC, 10);

  SetProp(P_MSGIN, "kommt hereingekrabbelt");
  SetProp(P_MSGOUT, "krabbelt");

  SetProp(P_DIE_MSG,  " sackt in sich zusammen.\n");

  AddInfo(DEFAULT_INFO, "schweigt Dich nur an.\n");
  SetProp(P_LOG_INFO, "protheg/noki");

  AI(({"abloese","abloesung"}),
     "Ich werde hier niemals abgeloest werden.");
  
  AI(({"feind","feinde"}),
     "Ich halte Ausschau nach Feinden und vernichte sie!");
  
  AI(({"drider"}),
     "Ich bin Noki, der Starke! Ein gefuerchteter Drider!");
  
  AI(({"name","noki"}),
     "Ich heisse Noki, ich bin der Bruder von Woki.");
  
  AI(({"bruder","woki"}),
     "Mein Bruder heisst Woki, der Flinke! Manche nennen ihn auch Woki, den "
     "Stummen, da er seit seinem Unfall nicht mehr sprechen kann. Gemeinsam "
     "bewachen wir das Dimensionsportal.");

  AI(({"unfall","stumm","stummer bruder"}),
     "Woki ist seit dem Unfall mit seiner Waffe stumm. Damals hat er sich "
     "den Hals aufgeschnitten und waere beinahe verblutet *g*");

  AddInfo(({"hals"}),
	  "kichert.");
  
  AI(({"portal","dimensionsportal","wache"}),
     "Mein Bruder und Ich, wir bewachen das Dimensionsportal!");
  
  AddInfo(({"bein","spinnenbein"}),
     "blickt seine Spinnenbeine an und grummelt.");

  AI(({"dhrkion"}),
     "Dhrkion hat uns beauftragt hier Wache zu halten!");

  AI(({"ardulvhier"}),
     "Durch dieses Portal gelangt man nach Ardulvhier!");

  SetProp(P_REJECT, 
	  ({REJECT_DROP, "Noki sagt: Keine Bestechungsversuche!\n"}));

  SetProp(P_SPELLRATE, 30);

  AddSpell(3, 220,
	   "Noki reisst Dir das Gesicht auf.\n",
	   "Noki reisst @WEM das Gesicht auf.\n",
	   DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,280,
	   "Noki zerfetzt Dich mit einem seiner Beine.\n",
	   "Noki zerfetzt @WEN mit einem seiner Beine.\n",
	   DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(3,320,
	   "Noki bespritzt Dich mit Gift.\n",
	   "Noki bespritzt @WEN mit Gift.\n",
	   DT_POISON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,380,
	   "Noki trifft Dich mit seinem Giftstachel mitten ins Herz.\n",
	   "Noki trifft @WEN mit seinem Giftstachel mitten ins Herz.\n",
	   DT_POISON,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Noki sagt: Verschwinde hier!\n",
      "Noki schaut Dich laessig an.\n",
      "Noki sagt: Mach hier bloss keinen Aerger.\n",
      "Noki fragt: Willst Du mich abloesen?\n",
      "Noki haelt nach Feinden ausschau.\n",
      "Noki kratzt sich mit einem seiner Beine.\n",
      "Noki schaut Dich an und wendet sich ab.\n",
      "Noki kontrolliert das Portal.\n"}));

  SetAttackChats(10, ({
    "Noki tritt Dich unfair.\n",
      "Noki sagt: Du bist doch kein Gegner fuer mich.\n",
      "Noki ruft um Hilfe.\n",
      "Noki haut Dir mitten ins Gesicht.\n",
      "Noki spuckt Dich an.\n",
      "Noki umschlingt Dich mit seinen Beinen.\n",
      "Noki windet sich geschickt in Deinen Ruecken.\n"}));

  SUID;
  
  CLONEME("/p/weapon/sword/bastardschwert");
  
  CLONEME("/p/armour/armour/kettenhemd");
  CLONEME("/p/armour/helm/kettenhaube");

  command("trage alles");
}

void init()
{
  ::init();
  if(TP && TP->id("\ndrider")) AddDefender(TP);
  if(TP && TP->is_class_member(CL_DARKELF)) AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  switch (gruppe) 
    {
    case "aengstlich":
      call_out("reaction", 0, TP,
	       "sagt: Man bist Du eine Memme, "+TPN+"!",
	       "sagt: Man bist Du eine Memme, "+TPN+"!");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
	       "haut Dir eine runter.",
	       "haut "+TPN+" eine runter.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
	       "schaut Dich nur an und reagiert nicht.",
	       "schaut "+TPN+" nur an und reagiert nicht.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
	       "sagt: Lass das "+TPN+" oder ich werde Dich vernichten!",
	       "sagt: Lass das "+TPN+" oder ich werde Dich vernichten!");
      break;
    case "frech":
      call_out("reaction", 0, TP,
	       "sagt: Mach das noch einmal "+TPN+" und ich toete Dich!",
	       "sagt: Mach das noch einmal "+TPN+" und ich toete Dich!");
      break;
    case "froh":
      call_out("reaction", 0, TP,
	       "sagt: Schoen fuer Dich, "+TPN+".",
	       "sagt: Schoen fuer Dich, "+TPN+".");
      break;
    case "intim":
      call_out("reaction", 0, TP,
	       "schreit: Hoer auf damit, "+TPN+"!",
	       "schreit: Hoer auf damit, "+TPN+"!");
      break;
    case "nett":
      call_out("reaction", 0, TP,
	       "sagt: Ich mag soetwas nicht, "+TPN+"!",
	       "sagt: Ich mag soetwas nicht, "+TPN+"!");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
	       "schaut Dich nur an.",
	       "schaut "+TPN+" nur an.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
	       "sagt: Pfffff.",
	       "sagt: Pfffff.");
      break;
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    }
}

int Defend(int dam, string *dam_type_list, mixed spell, object enemy)
{
  if(!QueryProp(P_WEAPON))
    command("zuecke schwert");

  return ::Defend(dam, dam_type_list, spell, enemy);
}

void Attack(object enemy)
{
  if(!QueryProp(P_WEAPON))
    command("zuecke schwert");

  ::Attack(enemy);
}

varargs int StopHuntFor(object arg, int silent)
{
  int tmp;

  if(tmp=::StopHuntFor(arg, silent))
    call_out("weapon_check", 5);

  return tmp;
}

varargs mixed StopHuntingMode(int silent)                                      
{
  call_out("weapon_check", 5);

  return ::StopHuntingMode(silent);
}

weapon_check()
{
  if(!m_sizeof(GetEnemies()))
    command("stecke schwert weg");
}
