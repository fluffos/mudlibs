/*
** Woki, der Flinke
**
** Dridergebrueder Noki und Woki, bewachen das Portal
*/

#include "../def.h"

inherit MOST "mynpc";

#define AI(x,y) AddInfo(x, y, "sagt: ")

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Woki, der Flinke");
  SetProp(P_LONG,
	  BS("Das ist Woki, der Flinke. Sein Bruder Noki und er wurden "
	     "lange Jahre von den Dunkelelfen nur fuer einen Zweck "
	     "ausgebildet und zwar, die Bewachung eines Dimensionsportales. "
	     "Woki ist ein eher schmaechtigerer Drider, doch das kann "
	     "taeuschen..."));
  
  SetProp(P_ARTICLE, 0);

  SetProp(P_NAME, "Woki");
  SetProp(P_GENDER, MALE);
  AddId(({"drider", "\ndrider","Kettenexperte", "waechter", "woki"}));
  
  create_default_npc(21);
  
  SetProp(P_HANDS, ({" mit seinen Spinnenbeinen",
		       QueryProp(P_HANDS)[1], DT_PIERCE}));

  SetProp(P_RACE, "Drider");
  SetProp(P_SIZE, 170);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 8);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.1, DT_COLD:      0.1, DT_WATER:  -0.1, DT_AIR:    0.0,
      DT_LIGHTNING: -0.1, DT_EXPLOSION: 0.1, DT_SOUND:  0.0, DT_LIGHT:  0.1,
      DT_ELECTRIC:  0.1, DT_ACID:      0.1, DT_POISON: -0.8, DT_TERROR: -0.2,
      DT_HOLY:      0.2, DT_UNHOLY:    -0.2, DT_MAGIC:  -0.2 ]));

  SetProp(P_NOMAGIC, 30);

  SetProp(P_MSGIN, "kommt hereingekrabbelt");
  SetProp(P_MSGOUT, "krabbelt");

  SetProp(P_DIE_MSG,  " sackt in sich zusammen.\n");

  AddInfo(DEFAULT_INFO, "schweigt Dich nur an.\n");

  AI(({"abloese","abloesung"}),
     "grummelt Dich an.");
  
  AI(({"feind","feinde"}),
     "deutet grinsend auf seine Waffe.");
  
  AI(({"drider","woki"}),
     "deutet stolz auf sich.");
  
  AI(({"name"}),
     "nickt nur.");

  AddInfo(({"bruder","noki"}),
	  "nickt nur.");
  
  AddInfo(({"portal","dimensionsportal","wache"}),
	  "deutet auf das Portal und dann auf sich.");
  
  AI(({"ardulvhier"}),
     "deutet auf das Portal.");
  
  AddInfo(({"heimat","stadt","heimatstadt","dhrkion"}),
	  "seufzt.");
  
  SetProp(P_REJECT, 
	  ({REJECT_DROP, "Woki blickt Dich veraechtlich an.\n"}));

  SetProp(P_SPELLRATE, 60);

  AddSpell(3, 220,
	   "Woki reisst Dir das Gesicht auf.\n",
	   "Woki reisst @WEM das Gesicht auf.\n",
	   DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,280,
	   "Woki zerfetzt Dich mit einem seiner Beine.\n",
	   "Woki zerfetzt @WEN mit einem seiner Beine.\n",
	   DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(3,320,
	   "Woki bespritzt Dich mit Gift.\n",
	   "Woki bespritzt @WEN mit Gift.\n",
	   DT_POISON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,380,
	   "Woki trifft Dich mit seinem Giftstachel mitten ins Herz.\n",
	   "Woki trifft @WEN mit seinem Giftstachel mitten ins Herz.\n",
	   DT_POISON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,420,
	   "Woki jagt Dir seinen Giftstachel in den Hals!\n",
	   "Woki jagt @WEM seinen Giftstachel in den Hals!\n",
	   DT_POISON, "gift");

  SetChats(1, ({
    "Woki deutet auf Dich und dann nach Sueden.\n",
      "Woki schaut Dich laessig an.\n",
      "Woki haelt nach Feinden ausschau.\n",
      "Woki kratzt sich mit einem seiner Beine.\n",
      "Woki schaut Dich an und wendet sich ab.\n",
      "Woki kontrolliert das Portal.\n"}));

  SetAttackChats(10, ({
    "Woki tritt Dich unfair.\n",
      "Woki lacht Dich aus.\n",
      "Woki haut Dir mitten ins Gesicht.\n",
      "Woki spuckt Dich an.\n",
      "Woki umschlingt Dich mit seinen Beinen.\n",
      "Woki windet sich geschickt in Deinen Ruecken.\n"}));

  SUID;
  
  CLONEME("/p/weapon/chain/doppelstern");
  
  CLONEME("/p/armour/armour/kettenhemd");
  CLONEME("/p/armour/helm/kettenhaube");
  CLONEME(ARMOUR "hkrause");

  command("trage alles");
}

void init()
{
  ::init();
  if(TP && TP->id("\ndrider")) AddDefender(TP);
  if(TP && TP->is_class_member(CL_DARKELF)) AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  switch (gruppe) 
    {
    case "aengstlich":
      call_out("reaction", 0, TP,
	       "lacht ueber Dich.",
	       "lacht ueber "+TPN+".");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
	       "haut Dir eine runter.",
	       "haut "+TPN+" eine runter.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
	       "schaut Dich nur an und reagiert nicht.",
	       "schaut "+TPN+" nur an und reagiert nicht.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
	       "grummelt Dich an.",
	       "grummelt "+TPN+" an.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
	       "tritt Dich.",
	       "tritt "+TPN+".");
      break;
    case "intim":
    case "nett":
      call_out("reaction", 0, TP,
	       "stoesst Dich weg.",
	       "stoesst "+TPN+" weg.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
	       "schaut Dich nur an.",
	       "schaut "+TPN+" nur an.");
      break;
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    }
}

int Defend(int dam, string *dam_type_list, mixed spell, object enemy)
{
  if(!QueryProp(P_WEAPON))
    command("zuecke doppelstern");

  if(QuerySkillAttribute(SA_SPEED)<=100)
    {
      tell_room(MENV, BS(Name()+" wirkt ploetzlich schneller."));

      TO->ModifySkillAttribute(TO, SA_SPEED, 150+random(30), 500);
    }

  return ::Defend(dam, dam_type_list, spell, enemy);
}

void Attack(object enemy)
{
  if(!QueryProp(P_WEAPON))
    command("zuecke doppelstern");

  ::Attack(enemy);
}

varargs int StopHuntFor(object arg, int silent)
{
  int tmp;

  if(tmp=::StopHuntFor(arg, silent))
    call_out("weapon_check", 5);

  return tmp;
}

varargs mixed StopHuntingMode(int silent)                                      
{
  call_out("weapon_check", 5);

  return ::StopHuntingMode(silent);
}

weapon_check()
{
  if(!m_sizeof(GetEnemies()))
    command("stecke doppelstern weg");
}

varargs void die(int pd)
{
  catch(present("\nzechpreller_quest_11", QueryProp(P_KILLER))->Mark());
  
  ::die(pd);
}
