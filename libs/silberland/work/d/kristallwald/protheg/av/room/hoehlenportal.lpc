/*
  Zugang zu ArdulVhier, Hoehlenportal fuer Drow billiger
*/

#pragma strong_types;

#include "../def.h"

inherit MOST "std_room";

#define ANSCHLUSS "/d/unterwelt/protheg/avmitte/room/portal"
#define DHRKION "/d/unterwelt/zordan/dhrkion/master/dhrkion"

nosave int next;

string zeichen(string str);

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Vor einem antiken Portal");
  SetProp(P_INT_LONG,
          BS("Du findest Dich in einer kreisrunden Hoehle wieder, in deren "
	     "Mitte sich ein rundes Portal aus Obsidian befindet. "
	     "Der Rest der Hoehle schimmert in einem angenehmen Blau. "
	     "Der Boden ist mit seltsamen Kratzspuren uebersaeht."));
  
  AddDetail(({"hoehle","raum"}),
	    QueryProp(P_INT_LONG));
  
  AddDetail(({"steinboden","boden"}),
	    "Der steinerne Boden ist uebersaeht mit Kratzspuren!?");

  AddDetail(({"spuren","kratzspuren"}),
	    "Der Boden ist uebersaeht mit Kratzspuren. Anscheinend halten "
	    "sich hier oft irgendwelche Lebewesen auf...");
  
  AddDetail(({"wesen","lebewesen"}),
	    "Vielleicht die Waechter des Portals?");

  AddDetail(({"waechter"}),
	    "Scheinbar sind keine Waechter da...");

  AddDetail(({"decke","steindecke"}),
	    "Die steinerne Decke ist seltsamer Weise total glatt. "
	    "Normalerweise haengen in solchen Hoehlen immer Stalaktiten.");
  
  AddDetail("stalagmiten",
	    "Stalagmiten scheint es hier nicht zu geben, dafuer ist der Boden "
	    "mit Kratzspuren uebersaeht.");

  AddDetail("stalaktiten",
	    "Seltsamerweise ist die Hoehle total stalagmiten- und "
	    "stalaktitenfrei.");

  AddDetail(({"steinwaende","waende"}),
	    "Die steinernen Waende sind teilweise mit blau schimmernden "
	    "Moosen uebersaeht.");

  AddDetail("wand",
	    "Welche Wand meinst Du denn?");

  AddDetail(({"moos","moose", "blau"}),
	    "Einige Moose wachsen hier an den Waenden. Sie schimmern in "
	    "einem angenehmen Blau und tauchen die Hoehle somit in eine "
	    "recht angenehme Atmosphaere.");

  AddDetail(({"atmosphaere","atmosfaere"}),
	    "Die blaue Atmosphaere hat etwas angenehmes an sich...");

  AddDetail(({"rest","granit"}),
	    "Die gesamte Hoehle besteht aus hartem Granit.");

  AddDetail(({"kreis","obsidiankreis","portal","mitte","hoehlenmitte"}),
	    "Ein uralter, mit Schriftzeichen ueberzogener Kreis aus purem "
	    "Obsidian steht mitten in der Hoehle. Du siehst keinerlei "
	    "Mechanismus, vielleicht muss man ihn einfach nur betreten...");

  AddDetail(({"obsidian"}),
	    "Das Portal scheint aus purem Obsidian zu bestehen.");

  AddDetail(({"magie","mechanismus"}),
	    "Du kannst keinen offensichtlichen Mechanismus erkennen, da muss "
	    "wohl Magie im Spiel sein...");

  AddDetail("spiel",
	    "Ist doch nur ein Spiel!");

  AddDetail(({"zeichen","schriftzeichen"}),
	    "Vielleicht kannst Du sie ja lesen...");
  
  AddReadDetail(({"zeichen","schriftzeichen"}),
		CLOSURE(zeichen));

  AddSound(DEFAULT_SOUND,
	   "Du hoerst nur das Pochen Deines Herzens.");

  AddSound(({"herz","pochen","herzpochen","schlag","herzschlag"}),
	   "*poch* *poch*");

  AddSmell(DEFAULT_SMELL,
	   "Es riecht nach frischem Moos.");

  AddSmell(({"moos","frisches moos","frischem moos"}),
	   "Es riecht wie... frisches Moos!");

  AddCmd(({"betrete","betritt"}), "portal");
  AddCmd(({"reiss","reisse"}), "ausreissen");
  AddCmd(({"iss","esse","friss"}), "essen");

  AddExit("sueden", "nach Sueden#"+ROOM "hoehle");

  Licht("duester");
  Umgebung("kuehl", TT_CAVE, 1);
  
  next=0;
  
  AddItem(NPC "noki", REFRESH_DESTRUCT);
  AddItem(NPC "woki", REFRESH_DESTRUCT);
}

nosave int essen(string str)
{
  notify_fail(BS("Was willst Du denn essen?"));
  if(!str) return 0;
  
  if(str=="moos"||str=="moose")
    return notify_fail("Moos essen? Direkt von der Wand?\n"
		       "Nein, das muss anders gehen!\n"), 0;

  return 0;
}

nosave int ausreissen(string str)
{
  notify_fail(BS("Was willst Du denn ausreissen?"));
 if(!str) return 0;
  
  if(str=="moos aus"||str=="moose aus")
     return write(BS("Das Moos ist ziemlich festgewachsen, so wirst Du es "
		     "nicht bekommen!")), 1;
  
  return 0;
}

nosave int portal(string str)
{
  object wae;

  notify_fail(BS("Was willst Du denn betreten?"));
  if(!str) return 0;
  
  if(str=="portal"||str=="antikes portal")
    {
      if(TP->InFight())
	return write(BS("Darauf kannst Du Dich jetzt nicht konzentrieren")), 1;

      if(TP->QueryProp(P_SP)<=20)
        return write(BS("Du naeherst Dich dem Portal, doch es passiert "
			"nichts...")+
                     BS("Du bist wohl nicht maechtig genug!")),1;
      
      if(next>time())
	return write(BS("Das Portal ist vor kurzem benutzt worden.")+
		     BS("Du musst Dich kurz gedulden, bis sich die Magie "
			"erholt hat!")), 1;
      
      if(TP->QueryProp(P_ALIGN)>500)
        {
          write(BS("Du naeherst Dich dem Portal, als es ploetzlich zu "
		   "pulsieren beginnt!")+
		BS("Dann hoerst Du einen Knall und spuerst nur noch, wie "
		   "Dich die Druckwelle hinauskatapultiert..."));

          say(BS(TP->Name()+" will das Portal betreten, doch eine gewaltige "
		 "Druckwelle befoerdert "+TP->QueryPronoun(WEN)+
		 " aus der Hoehle hinaus..."), ({TP}));

          TP->SetProp(P_HP, 5+random(5));
	  
	  call_other(ROOM "hoehle", "???");
	  
          tell_room(find_object(ROOM "hoehle"),
		    BS(TP->Name()+" kommt aus dem Norden geflogen und bleibt "
		       "liegen..."));
	  
          TP->SetProp(P_DEAF, 
		      ([DEAF_TIME: 5, 
			DEAF_MSG: "%s ist etwas benommen...\n"]));
	  
          TP->move(ROOM "hoehle", M_NOCHECK|M_SILENT|M_NO_SHOW);

	  if(wae=present("\ndrider"))
	    wae->Kill(TP);
          
	  next=time()+4+random(3);
	  
	  return 1;                 
        }

      if(DHRKION->getfeindkills(TP) >= 500)
	{
	  write(BS("Du naeherst Dich dem Portal, doch es passiert "
		   "nichts...")+
		BS("Rein instinktiv weisst Du, dass Du als ewiger "
		   "Feind von Dhrkion auch in ArdulVhier nicht "
		   "willkommen bist!"));
	  
	  if(wae=present("\ndrider"))
	    wae->Kill(TP);
	  
	  return 1;
	}
      
      if(TP->QueryProp(P_RACE)=="Dunkelelf")
        TP->AddSp(-5);
      else
        TP->AddSp(-20);

      write(BS("Du naeherst Dich dem Portal, als es ploetzlich aufleuchtet. "
	       "In der Mitte bildet sich ein waberndes Etwas, doch das "
	       "kuemmert Dich nicht mehr, denn Du betrittst gerade das "
	       "Portal und laesst Dich von ihm in eine andere Dimension "
	       "saugen..."));

      say(BS(TP->Name()+" durchschreitet das Portal..."), ({TP}));

      TP->move(ANSCHLUSS, M_NOCHECK|M_TPORT|M_NO_ATTACK);

      next=time()+4;

      return 1;
    }

  return 0;       
}

string zeichen(string str)
{
  if((TP) && TP->QueryProp(P_RACE)=="Dunkelelf")
    return "Die Schriftzeichen sind uralt, dennoch erkennst Du ein Wort: "
      "ArdulVhier!\n";
  
  return "Sie sind zu alt, Du kannst sie leider nicht entziffern.\n";
}
