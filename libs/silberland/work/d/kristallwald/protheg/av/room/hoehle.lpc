#pragma strong_types;

#include "../def.h"

inherit MOST "std_room";

#define SEE "/d/kristallwald/sargola/see/room/0507"

nosave string *gewarnt;

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Hoehleneingang");
  SetProp(P_INT_LONG,
          BS("Du findest Dich in einer kleinen Hoehle wieder...\n"
	     "Hinter Dir faellt noch der Lichtschein aus dem Kristallwald "
	     "herein, doch weiter vor Dir erkennst Du ein seltsames Blau. "
	     "Was da wohl im Norden ist?"));

  AddDetail(({"hoehle","eingang","hoehleneingang","raum"}),
	    QueryProp(P_INT_LONG));

  AddDetail(({"steinboden","boden"}),
	    "Der steinerne Boden unter Dir wirkt spiegelglatt! Als ob er "
	    "blank poliert wurde...");

  AddDetail(({"decke","steindecke"}),
	    "Die steinerne Decke ueber Dir wirkt wie blank poliert...\n"
	    "Keine Furchen, keine Risse, keine Stalaktiten... nicht einmal "
	    "Moos siehst Du da.");

  AddDetail(({"furche","furchen","riss","risse"}),
	    "Der Hoehleneingang wirkt makellos bearbeitet, nur das Loch in "
	    "der Suedwand wurde mit roher Gewalt geoeffnet.");

  AddDetail(({"stelle","stellen"}),
	    "Einige Stellen an der Suedwand wurden mit scharfen Werkzeugen "
	    "bearbeitet. Anscheinend wurde so die Wand durchbrochen, um "
	    "einen Durchgang in den Kristallwald hinaus zu schaffen. ");

  AddDetail(({"gang","durchgang","zeit"}),
	    "Scheinbar wurde hier vor nicht langer Zeit ein Durchgang "
	    "in den Kristallwald angelegt.");

  AddDetail(({"gewalt"}),
	    "Die Suedwand wurde vor nicht langer Zeit scheinbar gewaltsam "
	    "durchbrochen.");

  AddDetail(({"werkzeug","werkzeuge","meissel","meisseln"}),
	    "Die Suedwand wurde wahrscheinlich mit scharfen Meisseln "
	    "bearbeitet, um in den Kristallwald durchzubrechen.");

  AddDetail("stalagmiten",
	    "Stalagmiten siehst Du hier keine... Der Boden ist dafuer viel "
	    "zu glatt.");

  AddDetail("stalaktiten",
	    "Stalaktiten? Wo?");

  AddDetail(({"steinwaende","waende","hoehlenwaende"}),
	    "Die steinernen Waende sind kahl und total glattgeschliffen. "
	    "Nur Zwerge koennen Hoehlenwaende so makellos bearbeiten!");
  
  AddDetail(({"zwerg","zwerge","zwergenarbeit"}),
	    "Der Hoehleneingang wirkt makellos bearbeitet. Eigentlich "
	    "koennen nur Zwerge so sorgfaeltig eine Hoehle bearbeiten.");

  AddDetail(({"wald","kristallwald"}),
	    "Durch das Loch in der Suedwand gelangst Du wieder hinaus in "
	    "den Kristallwald.");

  AddDetail(({"schein","lichtschein"}),
	    "Durch das Loch in der Suedwand faellt ein fahler Lichtschein "
	    "herein.");

  AddDetail(({"suedwand","loch","ausgang"}),
	    "In der Suedwand befindet sich ein Loch, durch das Du wieder "
	    "hinausgelangen kannst. Es scheint, als wurde die Suedwand von "
	    "innen her durchbrochen, da die Wand eindeutige Stellen aufweist, "
	    "die mit scharfen Werkzeugen bearbeitet wurden.");

  AddDetail(({"hoehlenwand","steinwand","wand"}),
	    "Welche Wand meinst Du denn?");

  AddDetail(({"rest","granit"}),
	    "Die gesamte Hoehle besteht aus hartem Granit.");

  AddDetail(({"schimmern","blau"}),
	    "Weiter im Norden vernimmst Du ein seltsames blaues Schimmern...");

  AddSound(DEFAULT_SOUND,
	   "Du lauscht etwas... War da nicht ein Geraeusch?");

  AddSound(({"geraeusch","scharren"}),
	   "War da nicht ein Scharren im Norden?");

  AddSound(({"norden"}),
	   "Jetzt ist es im Norden ploetzlich wieder still...");

  AddSmell(DEFAULT_SMELL,
	   "Aus dem Norden her, stroemt Dir ein etwas seltsamer Geruch "
	   "entgegen.");

  AddSmell(({"geruch","moos","frisches moos","frischem moos"}),
	   "Es riecht wie... frisches Moos!");

  AddExit("raus", "aus der Hoehle raus#"+SEE);
  AddExit("norden", ([EX_DEST:ROOM "hoehlenportal", EX_TESTFUNC:"warnung"]));

  Licht("duester");
  Umgebung("kuehl", TT_CAVE, 1);

  gewarnt=({});
}

int warnung()
{
  if((TP) && (TP->QueryProp(P_LEVEL) < 15))  
    if(member(gewarnt, getuid(TP))==-1)
      {
	gewarnt+=({getuid(TP)});
	
	return write(BS("Da im Norden koennte es gefaehrlich werden!!")+
		     BS("Du haelst kurz inne...")), 0;
      }
    else 
      gewarnt-=({getuid(TP)});
  
  return 1;
}
