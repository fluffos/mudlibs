#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Eine staehlerne Halskrause");
  SetProp(P_LONG, 
	  BS("Das ist eine Halskrause aus hartem Stahl. Sie scheint zwar "
	     "etwas unbequem, aber durchaus effektiv zu sein. Sie wird an "
	     "der Seite von einer kleinen Schnalle zusammengehalten."));
  
  SetProp(P_INFO,
	  BS("Die Halskrause kann bei schnellen Kopfbewegungen zwicken..."));
  
  SetProp(P_NAME, "Halskrause");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({"staehlern"}));
  AddAdjective(({"staehlerne","staehlern","staehlernen"}));

  AddId(({"halskrause","krause","stahlkrause","stahlhalskrause"}));

  SetProp(P_ARMOUR_TYPE, AT_AMULET);
  SetProp(P_AC, 4);

  SetProp(P_MATERIAL, ([MAT_STEEL:99, MAT_SILVER:1]));
  SetProp(P_WEIGHT, 401);
  SetProp(P_VALUE, 700);
  SetProp(P_QUALITY_DECAY, 300);

  AddDetail(({"silber","silberschnalle","schnalle"}),
	    "Die kleine Silberschnalle haelt die Halskrause zusammen.");
  
  AddDetail(({"seite"}),
	    "An der Seite ist eine kleine Silberschnalle befestigt, mit "
	    "der man die Halskrause oeffnen kann.");
  
  AddDetail(({"stahl","schalen","schalenhaelften","schalenhaelfte"}),
	    "Die Halskrause besteht aus zwei harten Schalenhaelften, die "
	    "von einer Silberschnalle gehalten werden.");

  AddCmd(({"ja","nick","nicke"}), "nickenfkt");
  AddCmd(({"oeffne"}), "oeffnenfkt");
}

nosave int oeffnenfkt(string str)
{
  notify_fail(BS("Was willst Du oeffnen?"));
  if(!str) return 0;

  if(!id(str)) return 0;
  
  if(QueryProp(P_WORN)==TP)
    return write(BS("Einfach ausziehen reicht...")), 1;
}

nosave int nickenfkt(string str)
{
  if(QueryProp(P_WORN)!=TP) return 0;

  write(BS("Deine Halskrause zwickt Dich etwas."));
  
  TP->AddHp(-1);
  
  return 0;    
}

string extra_look()
{
  if(QueryProp(P_WORN)==MENV)
    return BS(CAP(MENV->QueryPronoun())+" sieht mit der Halskrause etwas "
	      "steif aus.");
  return "";
}
