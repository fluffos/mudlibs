/*
** Xulias Smaragdkleid
**
*/

#include "../def.h"

inherit "/std/armour";

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein halblanges, smaragdfarbenes Kleid");
  SetProp(P_LONG,
	  BS("Das ist ein halblanges Kleid aus gruener Seide, in das einige "
	     "kleinere Smaragde eingearbeitet wurden. Es hat kurze Aermel und "
	     "einen weiten V-Ausschnitt. Eine smaragdfarbene Rose ist auf "
	     "dem Bauch eingestickt."));
  SetProp(P_NAME, "Smaragdkleid");
  SetProp(P_GENDER, NEUTER);
  AddId(({"kleid","smaragdkleid"}));
  
  AddAdjective(({"halblang","halblanges","halblangen","smaragdfarben",
		   "smaragdfarbenes", "smaragdfarbenen"}));
  
  SetProp(P_NAME_ADJ, ({"halblang"}));
  
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_SILK:85, MAT_EMERALD:15]));
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 999);
  SetProp(P_WEAR_RESTRICTIONS, 
	  ([P_GENDER:FEMALE, SR_INCLUDE_RACE:({"Elf","Dunkelelf","Mensch"})]));
  
  AddDetail(({"seide"}),
	    "Das Kleid besteht hauptsaechlich aus exquisiter Seide.");
  
  AddDetail(({"smaragd","smaragde"}),
	    "In das Kleid wurden einige kleinere und auch mittelgrosse "
	    "Smaragde eingearbeitet.");
  
  AddDetail(({"aermel","aermeln"}),
	    "Die Aermel des Smaragdkleides sind kurz, aber weit geschnitten.");
  
  AddDetail(({"bauch","rose","smaragdrose"}),
	    "Auf den Bauch ist eine smaragdfarbene Rose gestickt worden.");
  
  AddDetail(({"ausschnitt","vausschnitt","v-ausschnitt"}),
	    "Das Kleid besitzt einen weiten V-Ausschnitt");
}
