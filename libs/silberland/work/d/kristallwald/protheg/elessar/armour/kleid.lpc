/*
** Culfeniels Kleid
**
*/

#include "../def.h"

inherit "/std/armour";

void create()
{
  string farb, laenge, muster;
  
  if(!is_clone(ME)) return;
  ::create();
  
  farb=({"rot","blau","gelb","violett","gruen"})[random(5)];
  laenge=({"kurz","lang","halblang","aermellos"})[random(4)];
  muster=({"Blumenmuster","Rueschenmuster","Spitzenmuster",
	     "Herzchenmuster"})[random(4)];
  
  SetProp(P_SHORT, "Ein "+farb+"es, "+laenge+"es Kleid");
  SetProp(P_LONG,
	  "Ein "+farb+"es, "+laenge+"es Kleid aus weicher Baumwolle, mit "
	  "einem wunderschoenen "+muster+".");
  SetProp(P_NAME, "Kleid");
  SetProp(P_GENDER, NEUTER);
  AddId(({"kleid"}));
  
  AddAdjective(({laenge, laenge+"es", laenge+"en", farb, farb+"es", 
		   farb+"en"}));
  
  SetProp(P_NAME_ADJ, ({farb, laenge}));
  
  SetProp(P_INFO, "Das "+farb+"e, "+laenge+"e Kleid stammt aus dem Besitz "
	  "der Elfe Culfeniel.");

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]));
  SetProp(P_WEIGHT, 350+random(150));
  SetProp(P_VALUE, 300+random(50));
  SetProp(P_WEAR_RESTRICTIONS, 
	  ([P_GENDER:FEMALE, SR_INCLUDE_RACE:({"Elf","Dunkelelf","Mensch"})]));
  
  AddDetail(({lower_case(muster), "muster"}),
	    "Das Kleid hat ein schoenes "+muster+".");
  AddDetail(({"baumwolle"}),
	    "Das Kleid besteht aus weicher Baumwolle.");
}
