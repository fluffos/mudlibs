#include "../def.h"

inherit MOST "mynpc";

#define FRUITS ({"banane", "orange", "erdbeere", "mango", "birne", \
  "grapefruit", "maracuja", "apfel", "marille",	"himbeere", "weintraube", \
  "weintrauben", "ribisel", "stachelbeere", "zwetschge", "walderdbeere", \
  "ananas", "zwergananas", "papaya", "karotte", "zwetschge"})

#define PREIS 149

nosave mapping drinks;

string saft_spool()
{
  string *spool;
  int i;

  if(sizeof(drinks))
    if(sizeof(drinks) == 1)
      return "Ich bereite gerade einen Obstsaft vor fuer "+
	CAP(m_indices(drinks)[0])+".\n";
    else
      {
	spool=m_indices(drinks);
	for(i=sizeof(spool)-1;i>=0;i--) spool[i]=CAP(spool[i]);
	spool=sort_array(spool, CLOSURE(<));
	
	return "Ich bereite gerade einen Obstsaft vor fuer "+
	  implode(spool[0..<2], ", ")+" und "+spool[<1]+".\n";
      }
  else
    return "Ich bereite gerade Obstsaefte und Muesli vor.\n";
}

string aerendil()
{
  if(present("aerendil", MENV))
    return "Frag ihn doch selbst, er ist gerade hier auf einen Saft.\n";
  
  return "Aerendil der alte Bibliothekar schaut hier hin und wieder "
    "auf einen Obstsaft vorbei.\n";
}

