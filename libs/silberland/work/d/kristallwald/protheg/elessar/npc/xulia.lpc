void init()
{
  if(!is_clone(TO)) return;
  ::init();
  
  if(!TP) return;
  
  if(!MENV) return; 
  
  if(!interactive(TP)) return;
  
  if(file_name(MENV)!=ROOM "reformladen") return;
  
  if(MENV->query_ban(getuid(TP))) return;
  
  if(WMASTER->is_elessar_enemy(TP))
    MENV->set_ban(getuid(TP));
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if (find_call_out("reaction") != -1) return;

  switch (gruppe) 
    {
    case "albern":
      call_out("reaction", 0, TP,
	       "kichert Dich an.",
	       "kichert.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
	       "pfffftet Dich an.",
	       "pffftet.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
	       "grinst Dich an.",
	       "grinst "+TP->name(WEN)+" an.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
	       "huepft um Dich herum.", 
	       "huepft um "+TP->name(WEN)+" herum.");
      break;
    case "intim":
      if(TP->QueryProp(P_GENDER)==FEMALE)
	call_out("reaction", 0, TP,
		 "blickt Dich entsetzt an.",
		 "blickt "+TP->name(WEN)+" entsetzt an.");
      else
	call_out("reaction", 0, TP,
		 "blickt erroetet zu Boden.",
		 "blickt erroetet zu Boden.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
	       "knuddelt Dich ganz lieb.",
	       "knuddelt "+TP->name(WEN)+" ganz lieb.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
	       "laechelt Dich an.",
	       "laechelt "+TP->name(WEN)+" an.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
	       "versucht Dich zu troesten.",
	       "versucht "+TP->name(WEN)+" zu troesten.");
      break;
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    }
}

varargs void zurueckgeben(object what, object whom, string msg)
{
  if(!objectp(what)) return;
  
  if((!objectp(whom)) || ENV(whom)!=MENV)
    {
      drop_obj(what);
      
      return;
    }
  
  if(stringp(msg))
    command_me("sag "+msg);
  
  if(!give_obj(what, whom))
    what->move(whom, M_NOCHECK);
}

void give_notify(object frucht)
{
  object saft;
  string who, tmp;

  if(!objectp(frucht)) return;
  if(!TP) return;
  
  if(!frucht->id("Nahrung"))
    {
      call_out("zurueckgeben", 1, frucht, TP, "Das sieht mir aber nicht wie "
	       "Obst aus!");

      return;
    }
  
  if(!sizeof(FRUITS & frucht->QueryProp(P_IDS)))
    {
      call_out("zurueckgeben", 1, frucht, TP, "Mit dem kann ich leider nichts "
	       "anfangen, tut mir leid.");
      
      write_file(LOG "fruitlog", CAP(getuid(TP))+" - "+frucht->Name()+" - "+
		 file_name(frucht));
      
      return;
    }
  
  if(InFight())
    {
      call_out("zurueckgeben", 1, frucht, TP, "Aeh, ich bin gerade beschaeftigt.");
      
      return;
    }
  
  if(!member(drinks, who=getuid(TP)))
    {
      if(TP->QueryMoney() < PREIS)
	{
	  call_out("zurueckgeben", 1, frucht, TP, "Ohne die "+PREIS+" Muenzen "
		   "kann ich fuer Dich nichts machen.");
	  
	  return;
	}
      
      drinks+=([who:({frucht->name(RAW)});5]);
      
      command_me("sag Ah, ich soll Dir also einen Obstsaft pressen? Dann "
		 "brauche ich jetzt noch zwei Fruechte von Dir.");
      
      tell_room(MENV, BS("Xulia legt "+frucht->name(WEN)+" auf die Seite."));
      
      frucht->remove(1);

      TP->AddMoney(-PREIS);

      return;
    }
  
  if(sizeof(drinks[who]+=({frucht->name(RAW)})) < 3)
    {
      command_me("sag Danke, aber eine Frucht brauche ich noch fuer den "
		 "Saft.");
      
      tell_room(MENV, BS("Xulia legt "+frucht->name(WEN)+" auf die Seite."));
      
      frucht->remove(1);
      
      return;
    }
  
  command_me("sag Ah, Die letzte Zutat fuer Deinen Obstsaft, "+CAP(who)+".");
  
  tell_room(MENV, 
	    BS("Xulia nimmt zwei Fruechte aus einem Regal und "+
	       frucht->name(WEN)+" dazu, legt die Fruechte in eine Schale und "
	       "spricht einige magische Worte, woraufhin die Fruechte "
	       "zerquetscht werden und nur der Saft uebrigbleibt."));
  
  tell_room(MENV,
	    BS("Xulia giesst den Saft in einen verschliessbaren Becher und "
	       "uebergibt den Becher an "+CAP(who)+"."), ({TP}));
  
  write(BS("Xulia giesst den Saft in einen verschliessbaren Becher und "
	   "uebergibt ihn Dir anschliessend."));
  
  saft=clone_object(OBJ "obstsaft");
  
  tmp=drinks[who][0];
  
  if(tmp!=drinks[who][1])
    tmp+="-"+drinks[who][1];
  
  if((drinks[who][0]!=drinks[who][2]) && 
     (drinks[who][1]!=drinks[who][2]))
    tmp+="-"+drinks[who][2];
  
  saft->SetProp(P_SHORT, "Ein '"+tmp+"' Obstsaft");

  saft->SetProp(P_LONG, 
		BS("Ein von Xulia aus Elessar frisch gepresster Obstsaft "
		   "mit '"+tmp+"'. Du solltest ihn bald trinken, denn lange "
		   "haelt er nicht."));
  
  if(saft->move(TP, M_GIVE)==ME_TOO_HEAVY)
    {
      command_me("sag Oh, Du kannst den Saft nicht mehr tragen! Dann trink "
		 "ihn doch gleich.");
      write(BS("Du oeffnest den Becher und trinkst den Saft in einem Zug aus."));
      tell_room(MENV, BS(CAP(who)+" nimmt den Saft und trinkt ihn in einem "
			 "Zug aus."), ({TP}));
      
      saft->remove(1);
    }
  else
    command_me("sag Hier, bitteschoen ein frischer '"+tmp+"' Saft. Trink "
	       "ihn aber bald, denn er haelt nicht lange.");

  drinks=m_delete(drinks, who);
}

void reset()
{
  int i;
  string *ind;

  if(!is_clone(TO)) return;
  ::reset();
  
  if(sizeof(ind=m_indices(drinks)))
    for(i=sizeof(ind)-1;i>=0;i--)
      {
	drinks[ind[i], 1]--;
	
	if(drinks[ind[i], 1] < 1)
	  drinks=m_delete(drinks, ind[i]);
      }
}

_query_noattack()
{
  if(InFight()) return 0;
  
  if(sizeof(drinks))
    return "meint: Nicht doch! Ich bin gerade beschaeftigt.\n";

  if(present("aerendil", MENV))
    return "meint: Nicht doch! Ich habe gerade Besuch.\n";
}

varargs void die(int poisondeath)
{ 
  WMASTER->killed_by(QueryProp(P_KILLER), 1);

  ::die(poisondeath);
}

int Defend(int dam, string dam_type, mixed spell, object enemy)  
{ 
  WMASTER->ruf_um_hilfe(enemy); 

  return ::Defend(dam, dam_type, spell, enemy);
}

mapping dump()
{
  return drinks;
}
