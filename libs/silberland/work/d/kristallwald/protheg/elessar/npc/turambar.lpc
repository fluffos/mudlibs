#include "../def.h"
#include <exploration.h>

inherit MOST "mynpc";
inherit "std/orakel";

#define AI(x,y) AddInfo(x, y, "spricht: ")

#define ELFENKETTENHEMD "/d/dschungel/feyaria/dorf/armour/elfenkettenhemd"

string gilden_info();

string quest_ausgabe(string str)
{
  string ret;
  
  ret=break_string(all_quests(), 78, Name(WER,1)+" spricht: ", 
		   BS_LEAVE_MY_LFS+BS_NO_PARINDENT);
  
  call_out("alle_quests",0,ret, TP);

  return "gruebelt kurz.\n";
}

void alle_quests(string ret, object pl)
{
  if(!pl) return;
  if(!present(pl, MENV)) return;
  
  pl->More(ret);
}

void create()
{
  if(!is_clone(TO)) return;
  mynpc::create();
  
  SetProp(P_NAME, "Turambar");
  SetProp(P_ARTICLE, 0);

  AddId(({"turambar","elf","goldelf","elfenmeister","meister",
	    "Schwertmeister", "NOWIMPY", "NOCONTROL"}));
  
  if(!random(7))
    {
      create_default_elf(39, MALE);
      CLONEME("/p/magic/msack");
    }
  else
    create_default_elf(33, MALE);

  SetProp(P_SHORT, "Goldelf Turambar, Meister der Elfengilde");
  SetProp(P_LONG, 
	  BS("Turambar wurde vom Rat von Elessar zum Meister der Elfengilde "
	     "ernannt, um junge Elfenabenteurer auf das Leben vorzubereiten. "
	     "Er lehrt sie den Aufstieg in der Gilde und den Umgang mit den "
	     "Zaubern.")+
	  BS("Obwohl sein Gesicht bereits recht mitgenommen aussieht, ist "
	     "der Rest von ihm in bester Verfassung, man sollte ihn nicht "
	     "unterschaetzen.")+
	  BS("Er traegt ein"+
	     (QueryProp(P_LEVEL)==39 ? " wunderschoenes Kettenhemd ":
	      "en, fuer Elfen aus Elessar typischen, Kristallpanzer")+
	     ", dazu Leggings und sehr bequem aussehende Ledermokassins. "
	     "An seiner Seite haengt ein Bastardschwert, eine "
	     "beeindruckende Waffe!"));

  SetProp(P_HANDS, ({" mit geschickten Haenden", 333, DT_RIP}));
  SetProp(P_XP, QueryProp(P_XP)+5000*100);
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 211);
  SetProp(P_ALIGN, 250);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 35);

  SetProp(P_TRANSPARENT, 0);
  
  SetProp(P_MSGIN, "betritt die Gilde");
  SetProp(P_MSGOUT, "geht");
  
  SetGuardProtection(100, GUARD_LOCATION);
  
  AddInfo(DEFAULT_INFO,
	  ({"laechelt freundlich.\n",
	      "nickt nur.\n",
	      "grinst wissend.\n",
	      "gruebelt vor sich hin.\n",}));

  AI(({"name", "elf", "goldelf", "turambar", "elfenmeister",
