  AI(({"dasein","abenteurerdasein"}),
     "Na wozu bist Du denn hier?");
  
  AI(({"ranadrion","haendler"}),
     "Ranadrion ist noch nicht lange in Elessar, aber soweit ich weiss, "
     "hat er sich hier niedergelassen und ein kleines Geschaeft gegruendet.");
  
  AI(({"aerendil","bibliothekar"}),
     "Aerendil versteckt sich in Elessars Bibliothek hinter seinen Buechern.");
  
  AI(({"buecher","buch","bibliothek"}),
     "Die Bibliothek wird von Aerendil verwaltet. Wenn Du ein Buch suchst, "
