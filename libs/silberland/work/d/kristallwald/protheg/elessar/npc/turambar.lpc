    Name(WER,1)+" spricht: Hier kannst Du Deine Stufe erhoehen.\n",
      Name(WER,1)+" spricht: Hier kannst Du neue Zaubersprueche lernen.\n",
      Name(WER,1)+" spricht: Hier kannst Du Deine Attribute erhoehen.\n",    
      Name(WER,1)+" spricht: Kannst Du schon den Feuerball-Zauber?\n",
      Name(WER,1)+" spricht: Kannst Du schon den Pfeil-Zauber?\n",
      Name(WER,1)+" spricht: Kannst Du schon den Schaetz-Zauber?\n",
      Name(WER,1)+" spricht: Kannst Du schon den Blitz-Zauber?\n",
      Name(WER,1)+" spricht: Kannst Du schon den Identifiziere-Zauber?\n",
      Name(WER,1)+" spricht: Kannst Du schon den Ausweichen-Zauber?\n",
      Name(WER,1)+" spricht: Kannst Du schon den Schnell-Zauber?\n",
      Name(WER,1)+" spricht: Du kannst mich nach Deinen Faehigkeiten fragen.\n",
      Name(WER,1)+" fragt Dich: Wieviele Aufgaben hast Du schon geloest?\n",
      Name(WER,1)+" spricht: Ich kann Dir viel ueber Quests verraten.\n",
      Name(WER,1)+" spricht: Wenn Du eine Quest loest, bekommst Du viel Erfahrung!\n",
      Name(WER,1)+" erleuchtet mit einem hellen Blitz kurzfristig den Raum.\n",
      Name(WER,1)+" schaetzt Dich erfolgreich ein.\n"}));
  
  SUID;

  CLONEME("/d/kristallwald/sargola/dorf/armour/mokassins");

  if(QueryProp(P_LEVEL)==39)
    CLONEME(ELFENKETTENHEMD);
  else
    CLONEME("/d/kristallwald/sargola/dorf/armour/kpanzer");

  CLONEME("/d/kristallwald/sargola/dorf/armour/leggings");

  command("trage alles");

  CLONEME("/p/weapon/sword/bastardschwert");
}	

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("react")!= -1) return;
  
  if(gruppe=="fies" || gruppe=="frech" || gruppe=="gemein")
    return call_out("react",0, 
		    "zeigt sich unbeeindruckt.\n", 
		    "zeigt sich unbeeindruckt.\n");
  
  if(touch)
    return call_out("react", 0, 
		    "beginnt ploetzlich leicht zu knistern!\n"
		    "Seine astrale Energie muss gewaltig sein!\n",
		    "beginnt ploetzlich seltsam zu knistern!\n");  
}

void react(string victim, string others)
{
  if(present(TP, ENV(TO))) 
  {
    if(TP->QueryProp(P_RACE)!="Elf" && !IS_WIZARD(TP) )
      tell_room(MENV, Name(WER,1)+" spricht: Du hast hier in der Gilde der "
		"Elfen nichts zu suchen!\n");
    else
      {
	tell_object(TP, Name(WER, 1) + " "+victim);
	tell_room(ENV(TO), Name(WER, 1)+" "+others, ({TP,TO}));
      }
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

int Defend(int dam, mixed dam_types, mixed spell, object enemy)
{
  if(!QueryProp(P_WEAPON))
    command("zuecke schwert");

  WMASTER->ruf_um_hilfe(enemy);
  
  if(!random(3))
    {
      tell_room(MENV, Name(WER,1)+" weicht dem Angriff "+
		(random(3) ? "geschickt ":"")+"aus.\n");
      return ::Defend(dam/5, dam_types, spell, enemy);
    }

  return ::Defend(dam, dam_types, spell, enemy);
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  if(killer==ME)
    WMASTER->player_killed(victim);
}

void reset()
{ 
  ::reset();
  if(!is_clone(ME)) return ;

  // Quest Infos aktualisieren
  // (koennte ja ne neue Quest angeschlossen worden sein ;) )
  AI(ME->QuestIDs(), symbol_function("quest_info",ME));
}

string a2s(int abil)
{
  switch (abil)
  {
    case 0..999 : return "hundsmiserabel schlecht";
    case 1000..1499 : return "miserabel";
    case 1500..1999 : return "uebel";
    case 2000..2499 : return "unheimlich schlecht";
    case 2500..2999 : return "sehr schlecht";
    case 3000..3499 : return "schlecht";
    case 3500..3999 : return "maessig";
    case 4000..4499 : return "unterdurchschnittlich";
    case 4500..4999 : return "durchschnittlich";
    case 5000..5499 : return "ueberdurchschnittlich";
    case 5500..5999 : return "befriedigend";
    case 6000..6499 : return "sehr befriedigend";
    case 6500..6999 : return "recht gut";
    case 7000..7499 : return "ganz gut";
    case 7500..7749 : return "gut";
    case 7750..7999 : return "wirklich gut";
    case 8000..8249 : return "sehr gut";
    case 8250..8499 : return "unglaublich gut";
    case 8500..8749 : return "ausserordentlich gut";
    case 8750..8999 : return "phantastisch gut";
    case 9000..9249 : return "ausgezeichnet";
    case 9250..9499 : return "hervorragend";
    case 9500..9749 : return "beinahe meisterhaft";
    case 9750..9899 : return "meisterhaft";
    case 9900..9999 : return "beinahe perfekt";
    default : return "absolut perfekt";
  }
}

string gilden_info()
{
  int i,abil,s;
  mapping b;
  string *bl;
  object who;
  string ret;

  if(TP->QueryProp(P_RACE)!="Elf")
    return "Ich habe nur fuer Elfen aus Elessar Informationen!";
  
  if(!sizeof(b=TP->QueryProp(P_NEWSKILLS)))
    return "Du hast Dir noch keine Zauber angeeignet.";

  bl=sort_array(m_indices(b),CLOSURE(<));
  
  if(TP->QueryProp(P_GUILD)=="abenteurer")
    ret="Du bist bereits Stufe "+TP->QueryProp(P_LEVEL)+" und ...\n";
  else
    ret="";

  for(i=sizeof(bl)-1;i>-1;i--)
    if(CAP(bl[i])==bl[i]) continue;
    else
      if(intp(b[bl[i]])) // Wenn der Spell noch nie gesprochen wurde ist er int
	ret+=sprintf("%s beherrscht Du %s.\n", CAP(bl[i]), 
		     a2s(b[bl[i]]));
		     else
	ret+=sprintf("%s beherrscht Du %s.\n", CAP(bl[i]), 
		     a2s(b[bl[i]]["si_abil"]));

  return ret;
}

varargs int StopHuntFor(object arg, int silent)
{
  int tmp;

  if(tmp=::StopHuntFor(arg, silent))
    call_out("waffen_check", 5);

  return tmp;                                                                  
}

varargs mixed StopHuntingMode(int silent)
{
  call_out("waffen_check", 5);

  return ::StopHuntingMode(silent);
}

void waffen_check()
{
  if(!m_sizeof(GetEnemies()))
    command("stecke schwert weg");
}

int level_check(object pl)
{
  if(pl->QueryProp(P_LEVEL)< 15) return 1;
  return 0;
}

string _query_noattack()
{
  string *inv;
  
  inv=filter_array(all_inventory(MENV), CLOSURE(interactive))-({TP});
  
  if(sizeof(inv=filter_array(inv, CLOSURE(level_check))))
    return "blockt ab.\n"+
      Name(WER,1)+" spricht: Nein, die jungen Elfen hier koennten Hilfe "
      "brauchen!";
}

void init()
{
  ::init();
  
  if((TP) && (interactive(TP)) && (TP->QueryProp(P_RACE)=="Elf") && 
     (!IsEnemy(TP)))
    call_out("begruessung", 2, TP);
}

void begruessung(object pl)
{
  if(!pl) return;
  if(!present(pl, MENV)) return;
  
  
  
  if(lower_case(pl->QueryProp(P_GUILD))=="abenteurer")
    command_me("sage Ah, "+CAP(getuid(pl))+"! "+
	       (pl->QueryProp(P_GENDER)==FEMALE ? "Eine Abenteurerin":
		"Ein Abenteurer")+" nach meinem Geschmack.");
  else
    command_me("sage Sei gegruesst, Elf"+
	       (pl->QueryProp(P_GENDER)==FEMALE ? "e":"")+" "+CAP(getuid(pl))+
	       "!");
}

varargs void die(int pd)
{
  WMASTER->killed_by(QueryProp(P_KILLER), 1);
  
  catch(present("\nzechpreller_quest_11", QueryProp(P_KILLER))->Mark());
  
  ::die(pd);
}
