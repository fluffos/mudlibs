  AI(({"ausdauer", "konstitution", "lebenspunkte"}),
     "Je groesser Deine Ausdauer, desto mehr Lebenspunkte hast Du.");

  AI(({"intelligenz", "magie", "magiepunkte"}),
     "Je groesser Deine Intelligenz, desto mehr Magiepunkte hast Du.");
  
