	   Name(WER,1)+" wirft einen gewaltig grossen Feuerball auf @WEN.\n",
	   DT_FIRE, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1,500,
	   Name(WER,1)+" wirft einen grossen Feuerball auf Dich.\n",
	   Name(WER,1)+" wirft einen grossen Feuerball auf @WEN.\n",
	   DT_FIRE, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1,300,
	   Name(WER,1)+" feuert einen magischen Pfeil auf Dich ab.\n",
	   Name(WER,1)+" feuert einen magischen Pfeil auf @WEN ab.\n",    
