/*
**  Ein kristalliner Gigant
**
**  2002-08-22  PROtheG  Erstmal als no_attack-npc im Kristallwald rumlaufen
**                       lassen.
**
**  2002-10-18  PROtheG  Jetzt kommt er ins Gefaengnis!
*/

#include "../def.h"

inherit MOST "mynpc";

void create() 
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein gigantisches Kristallinwesen tobt hier herum");
  SetProp(P_LONG,
	  BS("Vor Dir steht ein gewaltiges Wesen, das komplett aus Kristall "
	     "zu bestehen scheint. Wuerde es nicht wuetend herumstapfen, "
	     "koennte man es glatt fuer einen Kristallberg halten! Seine "
	     "gewaltigen Faeuste schwingen bedrohlich ueber Deinem Kopf."));
  SetProp(P_NAME, "Kristallinwesen");
  SetProp(P_NAME_ADJ, "gigantisch");
  AddAdjective(({"gigantisches","gigantischer","gigantische","gigantischen"}));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:100]));
  AddId(({"wesen", "kristallwesen", "kristallinwesen","gigant",
	    "kristallgigant","NOWIMPY","NOCONTROL"}));

  SetProp(P_MATERIAL, MAT_CRYSTAL);

  create_default_npc(35);
  
  SetAttribute(A_STR, 50);
  
  SetProp(P_HANDS, ({" mit seinen Kristallfaeusten",
		       QueryProp(P_HANDS)[1]+200+random(200), DT_BLUDGEON}));
  SetProp(P_MAX_HP, 2999);
  SetProp(P_MAX_SP, 1);
  SetProp(P_BODY, 200);
  SetProp(P_XP, QueryProp(P_XP)+300000); // Bonus fuer Spells
  SetProp(P_RACE, "Gigant");
  SetProp(P_SIZE, 850);
  SetProp(P_WEIGHT, 12000000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -300);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:   -0.1, DT_COLD:  -0.3, DT_WATER:  -0.1, DT_AIR:    -0.2, 
      DT_SOUND:  -0.9, DT_LIGHT: -0.9, DT_ACID:    0.2, DT_POISON: -0.9,
      DT_TERROR: -0.8, DT_HOLY:  -0.8, DT_UNHOLY: -0.8]));

  SetProp(P_TRANSPARENT, 0);

  SetGuardProtection(100, GUARD_THING);
  
  SetProp(P_NOMAGIC, 1);
  
  SetProp(P_MSGIN, "stapft wuetend herein");
  SetProp(P_MSGOUT, "stapft wuetend");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " zerspringt in hunderttausende Kristallsplitter.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_KILL_MSG, "Schwaechling!");
  
  AddInfo(DEFAULT_INFO, ({"bruellt Dich an.\n",
			    "stoesst Dich brutal um.\n"}));
  
  SetProp(P_REJECT, ({ REJECT_DROP,
	  "Das Kristallinwesen interessiert sich dafuer nicht!\n"}));
  
  SetProp(P_SPELLRATE, 60);
  
  AddSpell(2,600,
	   "Das Kristallinwesen laesst seine Faeuste auf Dich herabkrachen.\n",
	   "Das Kristallinwesen laesst seine Faeuste auf @WEN herabkrachen.\n",
	   DT_SLASH,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,700,
	   "Das Kristallinwesen versucht Dich zu zertrampeln...\n",
	   "Das Kristallinwesen versucht @WEN zu zertrampeln...\n",
	   DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 900,
	   "Ploetzlich rast eine gewaltige Faust auf Dich zu...\n",
	   "Ploetzlich rast eine gewaltige Faust auf @WEN zu...\n",
	   DT_SLASH, "knockout", ([SP_SHOW_DAMAGE:0]));

  AddSpell(1, 900,
	   "Das Kristallinwesen trifft Dich voll am Kopf.\n",
	   "Das Kristallinwesen trifft @WEN voll am Kopf.\n",
	   ({DT_MIND,DT_SLASH}),([SP_SHOW_DAMAGE:1]));
  
  AddSpell(1, 0,
	   "Das Kristallinwesen springt hoch und landet hart auf dem Boden.\n",
	   "Das Kristallinwesen springt hoch und landet hart auf dem Boden.\n",
	   DT_SLASH, "umfallt", ([SP_SHOW_DAMAGE:0]));

  SetAttackChats(10, ({
    "Das Kristallinwesen schwingt seine Faeuste.\n",
      "Das Kristallinwesen stampft hart mit dem Fuss auf.\n"
      "Die Erde unter Dir bebt!\n",
      "Das Kristallinwesen streift Dich leicht.\n",
      "Das Kristallinwesen laesst einen Regen aus Kristallsplittern herab.\n",
      "Das Kristallinwesen bruellt Dich an.\n"}));

  SUID;
}

void knockout(object enemy, int damage, mixed dam_type)
{
  if(enemy->QueryProp(P_PARALYZED)) return;
  
  if(random(enemy->QueryAttribute(A_DEX)) > 20) return;
  
  tell_object(enemy, 
	      BS("Die Faust erwischt Dich mit voller Wucht!!")+
	      BS("Du faellst nach hinten..."));
  
  enemy->SetProp(P_PARALYZED, 
		 ([PARALYZE_TIME: 3+random(3),
		   PARALYZE_MSG: "Dein Kopf dreht sich...\n",
		   PARALYZE_MSG_OTHER: "",
		   PARALYZE_END: "So langsam kommst Du wieder zu Dir...\n",
		   PARALYZE_END_OTHER: "%s blickt kurz verwirrt umher.\n"]));
}

void umfallt(object enemy, int damage, mixed dam_type)
{
  object *inv;
  int i;
  
  if(!sizeof(inv=filter_array(all_inventory(MENV), CLOSURE(interactive))))
    return;

  for(i=sizeof(inv)-1;i>=0;i--)
    if((random(inv[i]->QueryAttribute(A_DEX))<=10) &&
       (!inv[i]->QueryProp(P_DISABLE_ATTACK)))
      {
	tell_object(inv[i], 
		    BS("Durch die Erschuetterung verlierst Du das "
		       "Gleichgewicht und stuerzt."));
	inv[i]->SetProp(P_DISABLE_ATTACK, 2+random(2));
	inv[i]->AddHp(-5);
      }
}

int Defend(int dam, string *dtype, mixed spell, object enemy)
{
  object w;

  if(!pointerp(dtype))
    dtype=({ dtype });
  
  if(sizeof(dtype & m_indices(PHYSICAL_DAMAGE_TYPES)) && !spell)
    return ::Defend(dam/4, dtype, spell, enemy);

  if(sizeof(dtype & ({DT_MAGIC})))
    {
      tell_object(enemy,
		  BS("Deine Magie bricht sich im Kristall des Wesens..."));
      
      tell_room(MENV,
		BS("Das Kristallinwesen leuchtet seltsam auf."));
      
      heal_self(50+random(51));
      
      return ::Defend(1, dtype, spell, enemy);
    }
  
  if((sizeof(spell)) && (spell[SP_NAME]) && (w=enemy->QueryProp(P_WEAPON)))
    if((lower_case(spell[SP_NAME])=="spalten") ||
       (lower_case(spell[SP_NAME])=="zielattacke"))
      {
	if((w->QueryProp(P_CURSED)) || (w->QueryProp(P_NODROP)) || 
	   (w->QueryProp(P_NEVERDROP)))
	  tell_object(enemy,
		      BS("Dein Schlag kratzt nur an der kristallinen "
			 "Oberflaeche..."));
	else
	  {
	    tell_object(enemy,
			BS("Deine Waffe keilt sich im Kristall fest..."));
	    
	    tell_room(MENV, BS(enemy->Name(WESSEN)+" Waffe keilt sich im "
			       "Kristall fest."), ({enemy}));
	    
	    w->move(ME, M_PUT);
	    
	    call_out("fallen_lassen", 2, w);
	  }
	
	if(dam > 20) dam=20;
	
	return ::Defend(dam, dtype, spell, enemy);
      }
  
  return ::Defend(dam, dtype, spell, enemy);
}

void fallen_lassen(object was)
{
  if((objectp(was)) && (present(was)) && (MENV))
    {
      was->move(MENV, M_NOCHECK);
      tell_room(MENV, BS(was->Name()+" faellt zu Boden."));
    }
}

varargs void die( int poisondeath )
{
  object ob;
  
  if(!poisondeath)
    if(objectp(ob=find_object(ITEMD)->GenerateUnique(ARMOUR "tkpanzer",1,1)))
      ob->move(ME);
	       
  ::die(poisondeath);
}

int _query_wimpy() { return 0; }

/*

>Alae mellyn,
:
:Aufgrund der hohen Gefahr, die das seit geraumer Zeit herumlaufende 
:Kristallinwesen darstellt,  wurde auf Erlass des Rates von  Elessar
:ein Stosstrupp ausgesandt, um das Wesen einzufangen.
:
:Ich freue mich nun, die Entwarnung fuer den Kristallwald aussprechen
:zu koennen,  da es nun gelungen ist,  dieses Wesen in ein Gefaengnis
:aus Stein, welches sich im Kristallwald befindet zu verbannen.
:
:Fuer junge Spieler besteht nun keine Gefahr mehr, da das Gefaengnis
:nur fuer hoeherstufige Spieler betretbar ist.
:
:Betreten auf eigene Gefahr, da hier starke Magie eingesetzt wurde
:und das Kristallinwesen ausserordentlich stark ist.
:
:Dennoch wird keinem hoeheren Spieler der Eintritt verwehrt, der
:sein Glueck herausfordern will...                                             
:

*/
