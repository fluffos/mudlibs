/*
** Culfeniel, die Elfin aus Elessars Tierheim
**
**
*/

#include "../def.h"
#include <npcmaster.h>

inherit "/p/service/angel/haustiere/std_petshop_vendor";

void create()
{
  ::create();

  SetProp(P_NAME, "Culfeniel");
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Elf");
  SetProp(P_GENDER, FEMALE);

  AddId(({"leiterin","heimleiterin","tierheimleiterin","besitzerin",
	    "culfeniel","elfe","NOCONTROL"}));

  SetProp(P_SHORT, "Elfe Culfeniel, die Leiterin des Tierheims");
  SetProp(P_LONG, 
	  BS("Vor Dir steht Culfeniel, die Leiterin des Tierheims von "
	     "Elessar. Obwohl sie noch sehr jung zu sein scheint, kuemmert "
	     "sie sich um alle Tiere hier im Heim und versucht fuer sie "
	     "ein neues Zuhause zu finden.")+
	  BS("Sie traegt ein huebsches Kleid und dazu passende bequeme "
	     "Mokassins."));
  
  SetProp(P_ALIGN, 600);
  
  create_default_npc(13);
  
  SetProp(P_HANDS, ({" mit ihren kleinen Haenden", 110, DT_RIP}));
  
  set_living_name("culfeniel");
  enable_commands();
  
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_NO_SCORE, 1);
  
  SetChats(1,({
    Name()+" blickt Dich erwartungsvoll an.\n",
      Name()+" fragt: Willst Du nicht einem meiner Tiere ein neues Zuhause\n"+
      Name()+" fragt: geben?\n",
      Name()+" seufzt: Was mache ich mit den vielen Tieren?\n",
      Name()+" fragt Dich: Bist Du wegen einem meiner Tiere hier?\n",
      Name()+" betreut eines der Tiere in seinem Kaefig.\n",
      Name()+" meint: schaue Dir doch einmal die Tafel an!\n"+
      Name()+" meint: Die Tiere sind ganz guenstig abzugeben.\n"}));

  AddInfo(DEFAULT_INFO, ({ 
    "seufzt nur und blickt zu den vielen Kaefigen hinueber.\n",
      "blickt Dich mit ihren grossen Augen an.\n",
      "meint: Willst Du mir eines meiner Tiere abnehmen?\n"}));
  
  AddInfo(({"tier","tiere","haustier","haustiere"}), 
	  "Ich helfe verletzten und verwaisten Tieren indem ich ihnen hier "
	  "im Heim Asyl gewaehre. Doch es sind einfach zuviele und ich habe "
	  "nicht genug Geld fuer all das Futter.",
	  "sagt: ");
  
  AddInfo(({"preis","preise"}), 
	  "Leider muss ich fuer die Tiere Geld verlangen, denn sonst kann ich "
	  "mir das viele Futter fuer all die Tiere nicht leisten. Da jedoch "
	  "jeder das Geld tragen kann, loese ich auch Gutscheine ein.",
	  "seufzt: ");
  
  AddInfo(({"gutschein","gutscheine"}), 
	  "Mit Gutscheinen kannst Du Dir eines meiner Tiere kaufen. "
	  "Gutscheine gelten nicht fuer Futter und Zubehoer.",
	  "sagt: ");

  AddInfo(({"portionen","portion"}),
	  "Nur kleinere Portionen!",
	  "meint: ");

  AddInfo(({"portionen","portion","fuettern","futter"}), 
	  "Um Dein Tier bei Laune zu halten, musst Du es regelmaessig "
	  "fuettern, aber nicht alles auf ein Mal, lieber kleinere "
	  "Portionen.",
	  "sagt: ");
  
  AddInfo("zubehoer", 
	  "meint: Zubehoer kannst Du hier bei mir kaufen.");
  
  AddInfo(({"heim","tierheim","tierasyl"}), 
	  "Ja, das hier ist das Tierheim. Hier gewaehre ich allen Tieren, "
	  "die Hilfe benoetigen, Asyl.",
	  "sagt: ");
  
  AddInfo(({"loyalitaet","laune"}),
	  "Es ist wichtig auf die Loyalitaet Deines Tieres zu achten, wenn "
	  "Du nicht willst, dass es Dir eines Tages weglaeuft.", 
	  "sagt: ");
  
  AddInfo(({"schmetterlinge","schmetterling"}),
	  "Auf der Lichtung westlich von Elessar finde ich hin und wieder "
	  "verletzte Schmetterlinge, die ich hier dann gesund pflege.",
	  "sagt: ");
  
  AddInfo(({"lichtung","waldlichtung"}),
	  "Die befindet sich westlich von hier.",
	  "sagt: ");
  
  AddInfo(({"elessar","elfenstadt"}),
	  "Ja, Du befindest Dich hier in Elessar.",
	  "sagt: ");
  
  AddInfo(({"onyxschnabler","schnabler"}),
	  "Hin und wieder finde ich einen verletzten Onyxschnabler hier in "
	  "Elessar, da sie sehr unvorsichtige Tiere sind und oft von den "
	  "Abenteurern gerempelt, oder getreten werden.",
	  "sagt: ");

  AddInfo(({"abenteurer","abenteuer"}),
	  "seufzt schwaermend.");
  
  AddInfo(({"schroeter","quarzschroeter","kaefer"}),
	  "Hin und wieder finde ich einen schoenen Quarzschroeter weiter "
	  "noerdlich im Kristallwald. Ich mag die Kaefer.",
	  "grinst: ");
  
  AddInfo(({"fuechse","schwarzfuechse","fuchs","schwarzfuchs"}),
	  "Die Schwarzfuechse im noerdlichen Kristallwald werden oft von "
	  "den dortigen, wilden Keilern angegriffen und verletzt. Ich "
	  "versuche sie dann immer gesund zu pflegen.",
	  "sagt: ");

  AddInfo(({"keiler","keilern"}),
	  "Die Keiler sind die gefaehrlichsten Tiere im Kristallwald!",
	  "warnt: ");
  
  AddInfo(({"schwan","schwaene"}),
	  "Hin und wieder finde ich an den Ufern des Rhondonitsees einen "
	  "gestrandeten Schwan und pflege ihn wieder gesund.",
	  "sagt: ");
  
  AddInfo(({"ufer","seeufer","ufern","seeufern","see","rhondonitsee",
	      "rhondonitseeufer","rhondonitseeufern"}),
	  "Der Rhondonitsee befindet sich noerdlich von hier. Ich gehe da "
	  "oft an seinen Ufern spazieren.",
	  "sagt: ");
  
  AddInfo(({"adler","kristalladler"}),
	  "Den Kristalladler habe ich im Norden bei einer gewaltigen Eiche "
	  "gefunden. Scheinbar ist der dort irgendwo aus dem Nest gefallen.",
	  "sagt: ");
  
  AddInfo(({"eiche","kristalleiche","eichen","baeume","baum",
	      "kristalleichen"}),
	  "Der Kristallwald ist voll damit.",
	  "grinst: ");
  
  AddInfo(({"nest","vogelnest"}),
	  "Der Kristalladler ist vermutlich aus seinem Nest gefallen.",
	  "seufzt: ");
  
  AddInfo(({"wald","kristallwald"}),
	  "Elessar befindet sich mitten im Kristallwald!",
	  "meint: ");
  
  AddInfo(({"hilfe"}),
	  "Du willst mir helfen? Dann kaufe mir doch bitte ein Tier ab!",
	  "laechelt: ");
  
  AddInfo(({"asyl","tierasyl"}),
	  "Ich gewaehre hier vielen Tieren Asyl.");
  
  AddInfo(({"geld","muenzen"}),
	  "seufzt nur.");

  AddInfo(({"xelindo","wirt","schluckspecht","dorfwirt"}),
	  "Hihi, der alte Schluckspecht! Aber ich kenne seine Tochter Xulia "
	  "sehr gut.",
	  "sagt: ");
  
  AddInfo(({"xulia","tochter"}),
	  "Xulia ist Xelindos Tochter. Wir haben damals immer miteinander "
	  "gespielt, als wir noch jung wahren.",
	  "erzaehlt: ");
  
  AddInfo(({"aerendil","bibliothekar"}),
	  "Aerendil besuche ich oft, um bei ihm Buecher zu lesen.",
	  "erzaehlt: ");
  
  AddInfo(({"buch","buecher"}),
	  "Ich lese sehr gerne, daher borge ich mir von Aerendil immer ein "
	  "paar Buecher aus.",
	  "erzaehlt: ");
  
  AddInfo(({"baaleth"}),
	  "meint nur: Die ist seltsam...");
  
  AddInfo(({"lexin"}),
	  "erbleicht...");
  
  AddInfo(({"ranadrion","haendler"}),
	  "Ranadrion ist noch nicht lange in Elessar, ich hatte noch nicht "
	  "die Zeit, ihn genauer kennenzulernen.",
	  "seufzt: ");
  
  AddInfo(({"zeit"}),
	  "seufzt nur.");
  
  AddInfo(({"serona","musiklehrerin","schule","musikschule","lehrerin"}),
	  "Serona hat mir alles ueber die Musik beigebracht, was ich wissen "
	  "muss!",
	  "verkuendet stolz: ");

  AddInfo(({"musik","tanzen","tanz"}),
	  "taenzelt singend um Dich herum...");
  
  SetAttackChats(5,({
    Name()+" ruft: Hilfe! So helft mir doch jemand!\n",
      Name()+" versucht Dir auszuweichen.\n",
      Name()+" schlaegt wild auf Dich ein.\n"}));
  
  SetProp(P_SPELLRATE, 25);
  
  AddSpell(3, 200,
           Name()+" kratzt Dich im Gesicht!\n",
           Name()+" kratzt @WEN im Gesicht.\n",
	   ({DT_RIP}),([SP_SHOW_DAMAGE:0]));
  
  AddSpell(2, 300,
           Name()+" tritt Dich kraeftig.\n",
           Name()+" tritt @WEN kraeftig.\n",
	   ({DT_BLUDGEON}),([SP_SHOW_DAMAGE:0]));
  
  CLONEME("/d/kristallwald/sargola/dorf/armour/mokassins");
  CLONEME(ARMOUR "kleid");
  command("trage alles");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("react")!= -1) return;
  
  switch(gruppe)
  {
  case "fies":
    call_out("react", 0, 
	     "sagt: Geh weg, Lass mich in Ruhe, "+TPN+"!");
    break;
  case "traurig":
    call_out("react", 0, 
	     "troestet Dich.", 
	     "troestet "+TP->name(WEN));
    break;
  case "albern":
    call_out("react", 0, 
	     "grinst breit.");
    break;
  case "neutral":
    call_out("react", 0, 
	     "grinst Dich an.", 
	     "grinst "+TP->name(WEN)+" an.");
    break;
  case "intim":
    if(TP->QueryProp(P_GENDER)==FEMALE)
      call_out("react", 0, 
	       "sieht Dich misstrauisch an.",
	       "sieht "+TP->name(WEN)+" misstrauisch an.");
    else
      call_out("react", 0, 
	       "erroetet sichtlich und blickt zu Boden.");
    break;
  case "froh":
    call_out("react", 0, 
	     "freut sich mit Dir.",
             "freut sich mit "+TP->name(WEM)+".");
    break;
  case "aengstlich":
    call_out("react", 0, 
	     "stuppst Dich an und meint: nur Mut, "+TPN,
	     "stuppst "+TP->name(WEN)+" aufmunternd an.");
    break;
  case "frech":
    call_out("react", 0, 
	     "huepft grinsend um Dich herum.", 
	     "huepft grinsend um "+TP->name(WEN)+" herum.");
    break;
  case "nett":
    call_out("react", 0, "umarmt Dich.", "umarmt "+TP->name(WEN)+".");
    break;
  }
}

varargs void react(string victim, string others)
{
  if(present(TP, ENV(TO)))
    {
      if(!stringp(others)) others = victim;
      
      tell_object(TP, BS(Name(WER, 1) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void GiveIntroduction()
{
  write("Culfeniel gibt Dir noch einen kleinen Kristall und meint:\n"+
	BS("'Sei nett zu Deinem Tier, denn selbst der treueste Gefaehrte "
	   "vertraegt nicht alles. Futter und sonstiges Zubehoer kannst Du "
	   "hier bei mir kaufen.'"));

  say("Culfeniel gibt "+TP->name(WEM)+" noch einen kleinen Kristall und "
      "meint:\n"+
      BS("'Sei nett zu Deinem Tier, denn selbst der treueste Gefaehrte "
	 "vertraegt nicht alles. Futter und sonstiges Zubehoer kannst Du "
	 "hier bei mir kaufen.'"), ({TP}));
}

varargs void die(int poisondeath)
{
  WMASTER->killed_by(QueryProp(P_KILLER), 1);

  ::die(poisondeath);
}

int Defend(int d, mixed dtl, mixed s, object e)
{
  WMASTER->ruf_um_hilfe(e);
  
  return ::Defend(d, dtl, s, e);
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  if(killer==ME)
    WMASTER->player_killed(victim);
}

_query_noattack()
{
  object *inv;
  int i;
  
  if(InFight()) return 0;
  
  inv=filter_array(all_inventory(MENV), CLOSURE(interactive));
  
  inv-=({TP});
  
  for(i=sizeof(inv)-1; i >=0 ; i--)
    if(inv[i]->QueryProp(P_RACE)=="Elf")
      return "meint: Nicht doch! Da ist doch Kundschaft!\n";
}

