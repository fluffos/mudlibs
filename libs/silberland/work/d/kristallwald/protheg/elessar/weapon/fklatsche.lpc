/*
** Eine Feenklatsche ;)
**
**
*/

#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Feenklatsche");
  SetProp(P_LONG,  
	  BS("Die Feenklatsche besteht aus einem langen Lederstab mit einem "
	     "kleinen Stueck Leder am oberen Ende."));
  SetProp(P_INFO,
	  BS("Die Feenklatsche trifft Feen und andere Insekten besonders "
	     "hart."));
  SetProp(P_NAME, "Feenklatsche");
  SetProp(P_GENDER, FEMALE);
  AddId(({"klatsche","feenklatsche"}));

  SetProp(P_WEAPON_TYPE, WT_WHIP);
  SetProp(P_WC, 100);
  SetProp(P_WC_FIX, 10);
  SetProp(P_DAM_TYPE, DT_SLASH);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_LEATHER:98,MAT_BLOOD:2]));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 20);
  SetProp(P_SIZE, 100);
  SetProp(P_QUALITY_DECAY, 80);
  
  SetProp(P_HIT_FUNC, TO);
}

int HitFunc( object enemy ) 
{
  object pl;

  if(!pl=QueryWielded()) return 0;
  
  if((enemy->is_class_member(CL_FAIRY)) ||
     (lower_case(enemy->QueryProp(P_RACE))=="insekt") ||
     (enemy->id("fliege")))
    if(!query_once_interactive(pl))
      return 50+random(50);
    else
      return 5+random(10);
  
  return 0;
}
