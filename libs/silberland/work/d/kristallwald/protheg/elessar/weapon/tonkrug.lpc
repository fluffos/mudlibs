
#include "../def.h"

inherit "std/weapon";

#define MAX_HEAL 5

void create() 
{
  if(!is_clone(TO))  return;
  ::create();

  SetProp(P_SHORT, "Ein kristallener Krug");
  SetProp(P_LONG,
	  BS("Dieser kristallene Krug stammt aus Xulias Reformkostladen. "
	     "die Form eines rundgeschliffenen Diamanten, nur dass er innen "
	     "hohl ist. An der einen Seite befindet sich ein Henkel"));

  SetProp(P_NAME, "Krug");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME_ADJ, "kristallen");
  AddAdjective(({"kristallen","kristallener","kristallenen"}));
  AddId(({"kristallkrug", "krug"}));

  SetProp(P_WEAPON_TYPE, WT_MISC);
  SetProp(P_WC, 100);
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_CRYSTAL:90, MAT_HEAL:10]));
  SetProp(P_WEIGHT, 250+random(51));
  SetProp(P_VALUE, 100+random(101));

  SetProp(P_WC_BONUS, (["xulia": 150,]));
}
