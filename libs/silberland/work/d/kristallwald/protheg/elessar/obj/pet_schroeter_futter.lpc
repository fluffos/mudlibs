/*
** Schroeterfutter fuer den Petshop
**
**
*/

inherit "/std/thing";

#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void create()
{
  ::create();
  
  SetProp(P_SHORT, "Etwas Quarzsand");
  SetProp(P_NAME, "Quarzsand");
  SetProp(P_LONG, 
	  BS("Du haelst etwas Quarzsand in der Hand. Das ist das ideale "
	     "Futter fuer einen Quarzschroeter."));
  
  SetProp(P_VALUE, 20);
  SetProp(P_WEIGHT, 100);
  
  AddDetail(({"schroeter","quarzschroeter"}),
            "Einem Quarzschroeter wird der Quarzsand sicher gut schmecken.");

  SetProp(P_SMELL, 
	  "Der Quarzsand riecht irgendwie nach nichts.");

  AddId(({"quarzsand","sand","schroeterfutter", "futter"}));
}
