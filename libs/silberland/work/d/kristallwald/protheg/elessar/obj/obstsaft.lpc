/*
**  Obstsaft von Xulia
*/

#include "../def.h"
#include <food.h>

inherit "std/food";

void create()
{
  if(!is_clone(ME)) return;
  ::create(({"trink","trinke"}));
  
  SetProp(P_SHORT, "Ein frischer Obstsaft");
  SetProp(P_LONG,
	  BS("Ein frischer Obstsaft."));
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Obstsaft");
  AddId(({"saft", "obstsaft","\nxulia_obstsaft"}));
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 5);
  SetProp(P_MATERIAL,({MAT_FRUIT}));
  SetProp(P_FOOD_INFO, 
	  ([F_HEAL: ({4+random(3), 15+random(6)}), F_SOAK: 6,
	    F_MSG: "Du trinkst den Obstsaft aus und fuehlst Dich gestaerkt. "
	    "Der nun leere Becher loest sich magisch auf...",
	    F_MSG_ROOM: "trinkt einen von Xulias beruehmten Obstsaeften.\n"]));
}

void reset()
{
  SetProp(P_FOOD_INFO, 
	  ([F_HEAL: ({0, 0}), F_SOAK: 6,
	    F_MSG: "Du trinkst den Obstsaft aus, doch er war schon ziemlich "
	    "abgestanden, Du haettest auf Xulia hoeren sollen!!\n"
	    "Der nun leere Becher loest sich magisch auf...",
	    F_MSG_ROOM: "trinkt einen von Xulias beruehmten Obstsaeften.\n"]));
}
