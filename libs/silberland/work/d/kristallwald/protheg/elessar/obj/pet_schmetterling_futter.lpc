/*
** Schmetterlingsfutter fuer den Petshop
**
**
*/

inherit "/std/thing";

#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void create()
{
  ::create();

  SetProp(P_SHORT, "Etwas Morgentau auf einem Blatt");
  SetProp(P_NAME, "Morgentau");
  SetProp(P_LONG, 
	  BS("Das ist etwas Morgentau, auf einem Blatt gesammelt. Das ideale "
	     "Futter fuer Schmetterlinge."));
  
  SetProp(P_VALUE, 3);
  SetProp(P_WEIGHT, 40);

  AddDetail(({"blatt"}),
	    "Der Morgentau wurde auf dem Blatt gesammelt, damit er nicht "
	    "verrinnt.");

  SetProp(P_SMELL, 
	  "Der Morgentau riecht irgendwie nach nichts.");

  AddId(({"tau","morgentau","schmetterlingfutter", "futter"}));
}
