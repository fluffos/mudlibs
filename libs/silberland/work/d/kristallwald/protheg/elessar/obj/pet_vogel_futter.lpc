/*
** Vogelfutter fuer den Petshop
**
**
*/

inherit "/std/thing";

#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void create()
{
  ::create();

  SetProp(P_SHORT, "Etwas Vogelfutter");
  SetProp(P_NAME, "Vogelfutter");

  SetProp(P_LONG, 
	  BS("Es handelt sich eindeutig um Vogelfutter. Es besteht aus den "
	     "verschiedensten Koernern und Samen."));
  
  SetProp(P_VALUE, 20);
  SetProp(P_WEIGHT, 100);
  
  AddDetail(({"haufen","korn","koerner","same","samen"}), 
	    BS("Ein Haufen voller Koerner und Samen, also genau das richtige "
	       "fuer einen Vogel."));
  
  AddDetail(({"muesli"}),
	    "Sicher kann man das Vogelfutter auch als Muesli verspeisen, doch "
	    "dazu ist es nicht gedacht.");
  
  SetProp(P_SMELL, 
	  "Das Vogelfutter riecht irgendwie nach Muesli");

  AddId(({"vogelfutter", "futter"}));
}
