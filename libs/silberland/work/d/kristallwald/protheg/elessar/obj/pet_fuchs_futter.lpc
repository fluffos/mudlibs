/*
** Fuchsfutter fuer den Petshop
**
**
*/

inherit "/std/thing";

#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void create()
{
  ::create();

  SetProp(P_SHORT, "Eine tote Maus");
  SetProp(P_NAME, "Maus");
  SetProp(P_NAME_ADJ, ({"tot"}));
  AddAdjective(({"tote","toten","toter","tot"}));
  SetProp(P_LONG, 
	  BS("Du haelst eine tote Maus in Deiner Hand. Die wuerde sich "
	     "doch prima als Fuchs- oder Katzenfutter eignen."));

  SetProp(P_GENDER, FEMALE);
  SetProp(P_VALUE, 8);
  SetProp(P_WEIGHT, 50);
  AddId(({"maus","katzenfutter","raubkatzenfutter","fuchsfutter", "futter"}));

  SetProp(P_SMELL, Name()+" riecht irgendwie tot.");
}
