/*
**  Ein kleiner Beutel fuer Anfaenger
**
**  2002-06-04  PROtheG  Originalbeutel aus dem Gebirge
*/

#include "../def.h"

inherit "/std/container";


void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Bauschbeutel");
  SetProp(P_LONG, 
	  BS("Ein kleiner Beutel aus Bausch mit einer feinen Schnur, um ihn "
	     "zuziehen zu koennen. Viel wirst Du da nicht hineinstecken "
	     "koennen, doch fuer den Anfang wird es reichen."));
  AddId(({"beutel", "bauschbeutel"}));
  SetProp(P_NAME, "Bauschbeutel");
  SetProp(P_GENDER, MALE);

  SetProp(P_WEIGHT, 100);
  SetProp(P_MAX_WEIGHT, 5000);
  SetProp(P_WEIGHT_PERCENT, 60);
  SetProp(P_VALUE, 10);
  
  SetProp(P_MATERIAL, MAT_BAUSCH);

  AddDetail(({"material","bausch"}), 
	    "Der Beutel besteht aus feinem Bausch.");

  AddDetail(({"schnur"}),
	    "Die Schnur haelt den Bauschbeutel zusammen.");
}
