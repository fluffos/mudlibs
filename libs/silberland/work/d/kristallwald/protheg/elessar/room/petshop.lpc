/*
** Tierhandlung im Elessar
**
** (Bugfix by Angel 08.02.2003)
*/

#include "../def.h"

inherit "/p/service/angel/haustiere/std_petshop";

#include "/p/service/angel/haustiere/std_pet.h"
#include "laden.h"

// Added by Angel 08.02.2003
#define PET_NPC "/p/service/angel/haustiere/npc/"

#define ANSCHLUSS "/d/kristallwald/sargola/dorf/room/1_0516"

string query_pet_sound()
{
  return ({
    "Das Knirschen eines fressenden Quarzschroeters.",
      "Das Jaulen eines Fuches.",
      "Das Schnattern eines Schwanes.",
      "Das Schnattern eines Onyxschnablers.",
      "Das Kreischen eines Kristalladlers." })[random(5)]+"\n";
}

// Changed by Angel 08.02.2003
// kw_ fuer Kristallwald
void Angebot()
{
  RemovePet("all");

  if(random(100) <= 90)
    AddPet("schmetterling", PET_NPC "kw_schmetterling");
  //  AddPet("schmetterling", NPC "pet_schmetterling");


  if(random(100) <= 85)
    AddPet("onyxschnabler", PET_NPC "kw_onyxschnabler");
  //  AddPet("onyxschnabler", NPC "pet_onyxschnabler");


  if(random(100) <= 85)
    AddPet("quarzschroeter", PET_NPC "kw_gschroeter");
  //  AddPet("quarzschroeter", NPC "pet_gschroeter");


  if(random(100) <= 70)
    AddPet("schwarzfuchs", PET_NPC "kw_fuchs");
  //  AddPet("schwarzfuchs", NPC "pet_fuchs");

  if(random(100) <= 70)
    AddPet("schwan", PET_NPC "kw_schwan");
  //  AddPet("schwan", NPC "pet_schwan");

  if(random(100) <= 55)
    AddPet("kristalladler", PET_NPC "kw_adler");
  //  AddPet("kristalladler", NPC "pet_adler");
}

void create()
{
  ::create();

  // Laden-Konstanten:
  SetProp(P_SHOPKEEPER_NAME, "Culfeniel");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
  SetProp(P_SHOPKEEPER_ID, "culfeniel");

  catch(call_other(ROOM "pet_store", "???"));
  SetStorageRoom(ROOM "pet_store");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);

  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]));

  SetProp(P_INT_SHORT, "Elessars Tierheim");
  SetProp(P_INT_LONG,
	  BS("Das hier ist das Tierheim von Elessar. Culfeniel, die "
	     "Besitzerin kuemmert sich hier um verletzte, ausgesetzte oder "
	     "einfach alleingelassene Tiere und versucht neue Besitzer fuer "
	     "sie zu finden. An den Waenden des Talans sind Kaefige voller "
	     "Tiere aufgetuermt, nur ein Fenster bleibt an der Rueckwand "
	     "frei. In der Mitte des Raumes befindet sich ein kleiner Tisch "
	     "mit einem Hocker. Neben dem Tisch befindet sich eine Kiste "
	     "mit der Aufschrift 'Nahrung'. Vorne am Tisch haengt eine "
	     "grosse Tafel."));

  SetProp(P_PET_KONFIG_TOOL, OBJ "pet_kristall");

  SetRaceRestriction(({"Elf"}));

  AddReadDetail(({"tafel", "preistafel"}), CLOSURE(GetPriceList));

  AddDetail(({"tafel","preistafel"}),
	    "Hier sind scheinbar die Preise der Tiere notiert.");

  AddDetail(({"aufschrift"}),
	    "'Nahrung'");

  AddReadDetail(({"aufschrift"}),
		"'Nahrung'");

  AddDetail(({"kiste"}),
	    "In der Kiste befinden sich einige Quarzgesteine. Vermutlich "
	    "das Futter fuer die Quarzschroeter.");

  AddDetail(({"gestein","gesteine","quarz","quarzgesteine","quarze"}),
	    "In der Kiste neben dem Tisch werden Quarzgesteine aufbewahrt.");

  AddDetail(({"mitte","talanmitte","raummitte"}),
	    "Die Talanmitte wird von einem grossen Tisch eingenommen.");

  AddDetail(({"boden","talanboden"}),
	    "Der Boden des Talans besteht aus einem soliden Geflecht aus "
	    "Aesten. Du fragst Dich, ob der Boden die vielen Kaefige noch "
	    "lange tragen kann.");

  AddDetail(({"aeste","ast","astgeflecht","geflecht"}),
	    "Der ganze Talan scheint aus einem einzigen Astgeflecht zu "
	    "bestehen. Scheinbar ist der Talan so gewachsen.");

  AddDetail(({"schroeter","quarzschroeter"}),
	    "In einigen der Kaefige sitzen Quarzschroeter. Ob sich die als "
	    "Haustier eigenen?");

  AddDetail(({"decke"}),
	    "Die Decke besteht, wie auch der Boden und die Waende, aus "
	    "demselben Geflecht aus Aesten.");

  AddDetail(({"holz"}),
	    "Es ist das Holz aus dem ganz Elessar besteht.");

  AddDetail(({"elessar"}),
	    "Um nach Elessar zurueckzugelangen musst Du nur nach Osten "
	    "gehen.");

  AddDetail(({"besitzer"}),
	    "Jemanden wie Dich z.B.");

  AddDetail(({"besitzerin","culfeniel"}),
	    "Hm, Culfeniel scheint nicht da zu sein.");

  AddDetail(({"raum","heim","tierheim","talan"}),
	    QueryProp(P_INT_LONG));

  AddDetail(({"tierfutter","futter","zubehoer","nahrung"}),
	    "Vielleicht moechtest Du ja davon etwas kaufen?");

  AddDetail(({"kristallwald","wald"}),
	    "Durch das Fenster kannst Du hinaus nach Westen den Kristallwald "
	    "ueberblicken.");

  AddDetail(({"lichtung"}),
	    "Durch das Fenster erkennst Du im Westen eine Lichtung im "
	    "Kristallwald.");

  AddDetail(({"hocker"}),
	    "Dieser Hocker scheint, als waere er direkt aus dem Talanboden "
	    "gewachsen. Eine kuschelige Wolldecke ist daruebergehaengt, um "
	    "das Sitzen angenehmer zu gestalten.");

  AddDetail(({"wolldecke","sitzen"}),
	    "Eine kuschelige Wolldecke macht das Sitzen auf dem Hocker viel "
	    "bequemer.");

  AddDetail(({"tiere","tier","haustier","haustiere"}),
	    "Auf der Tafel sind die Tiere, die Du erfragen kannst "
	    "aufgelistet.");

  AddDetail(({"tisch"}),
	    "Wie auch der Hocker scheint der Tisch direkt aus dem Talanboden "
	    "gewachsen zu sein. Er ist ueber und ueber mit Papieren bedeckt.");

  AddDetail(({"papiere","rechnung","rechnungen","papier"}),
	    "Du bist Dir nicht ganz sicher, was da fuer Papiere auf dem Tisch "
	    "liegen, aber Du glaubst, dass es Rechnungen sein koennten.");

  AddDetail(({"preis","preise"}),
	    "Die Preise kannst Du der Tafel entnehmen, die vorne am Tisch "
	    "haengt.");

  AddDetail(({"kaefige","tierkaefige"}),
	    "An den Waenden sind Kaefige in den verschiedensten Groessen "
	    "aufgetuermt. Beinahe jeder der Kaefige ist mit einem Tier "
	    "gefuellt.");

  AddDetail(({"tierkaefig","kaefig"}),
	    "Hier stehen haufenweise Tierkaefige herum, welchen meinst Du?");

  AddDetail(({"uebersicht"}),
	    "Lies einfach die Tafel.");

  AddDetail(({"geld"}),
	    "Davon braucht man leider eine Menge, um sich so ein Tier "
	    "leisten zu koennen.");

  AddDetail(({"menge"}),
	    "Kommt darauf an welches Tier Du moechtest, je groesser und "
	    "staerker es ist, desto teurer ist es auch.");

  AddDetail(({"groessen","groesse"}),
	    "Jedes Tier hat einen Kaefig mit angemessener Groesse.");

  AddDetail(({"wand","waende"}),
	    "Von den Waenden ist nicht viel zu erkennen, da die vielen "
	    "Tierkaefige davor stehen.");

  AddDetail(({"fenster"}),
	    "Durch das Fenster siehst Du weiter im Westen eine wunderschoene "
	    "Lichtung im Kristallwald.");

  AddDetail(({"rueckwand"}),
	    "An der Rueckwand ist ein Fenster frei geblieben, durch welches "
	    "genug Licht in den Talan gelangt.");

  AddDetail(({"licht"}),
	    "Der Talan wird nur durch das Fenster in der Rueckwand erhellt.");

  AddDetail(({"talantuer","tuer"}),
	    "Tuer hat der Talan keine, dafuer jedoch einen Vorhang.");

  AddDetail(({"vorhang","bast"}),
	    "Ein schoener Vorhang aus Bast haengt vor dem Ausgang.");

  AddDetail(({"eingang","ausgang"}),
	    "Der Ausgang ist von einem Vorhang aus Bast verdeckt.");

  AddSmell(DEFAULT_SMELL,
	   "Hier riecht es nach den verschiedensten Tieren.");

  AddSmell("tiere",
	   "Eingesperrte Tiere riechen nicht besonders angenehm.");

  AddSound(DEFAULT_SOUND,
	   "Du hoerst die verschiedensten Tierstimmen.");

  AddSound(({ "stimme", "stimmen", "tierstimme", "tierstimmen" }),
	     CLOSURE(query_pet_sound));

  AddSound(({"fuchs","fuechse","jaulen"}),
	   "Einer der Fuechse jault gerade herum.");

  AddSound(({"schroeter","quarzschroeter","knirschen"}),
	   "In einem der Kaefige knirscht ein Quarzschroeter leise vor sich "
	   "hin.");

  AddSound(({"onyxschnabler","schnabler","schwaene","schwan","schnattern"}),
	   "In einem der Kaefige schnattert ein Schwan und gleich daneben "
	   "ein Onyxschnabler.");

  AddSound(({"adler","kristalladler","kreischen"}),
	   "Ein grosser Kristalladler hat in seinem Kaefig gerade gekreischt.");
  AddSound(({"schmetterling","schmetterlinge"}),
	   "Hm, Du hoerst die Schmetterlinge eigentlich gar nicht.");

  Angebot();

  AddItem(NPC "culfeniel", REFRESH_DESTRUCT);

  RemoveItem("/obj/entsorg");

  AddExit("osten", "nach Elessar hinaus#" ANSCHLUSS);
}

void reset()
{
  ::reset();

  call_out("Angebot", 10+random(10));
}

int sell(string str, int f)
{
  if(present("culfeniel"))
    return write(BS("Culfeniel sagt: Tut mir leid, aber ich kaufe nichts "
		    "an!")), 1;

  return ::sell(str, f);
}

string GetExits(object viewer)
{
  string ret;

  if(strlen(ret=::GetExits(viewer)))
    return "Nach Osten hin kannst Du das Tierheim wieder verlassen.\n";

  return ret;
}
