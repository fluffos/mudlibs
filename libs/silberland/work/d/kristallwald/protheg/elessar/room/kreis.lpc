/*
** Ein Gefaengnis aus Stein...
** Gefangen ist ein kristalliner Gigant
**
** 2002-10-16  PROtheG  Shifting Exits;
*/

#include "../def.h"

inherit MOST "std_room";

#define ANSCHLUSS "/d/kristallwald/sargola/wald/room/0604"
#define AUSGAENGE ({"norden","nordosten","osten","suedosten","sueden","suedwesten","westen","nordwesten"})

nosave int position;

varargs nosave void shift_exit(int bla)
{
  position++;
  position=position%8;
  
  RemoveExit(0);

  AddExit(AUSGAENGE[position], 
	  ([EX_DEST:ANSCHLUSS,
	    EX_TESTFUNC:"festhalten"]));
}

int festhalten(string str)
{
  if(present("kristallinwesen"))
    if(random(TP->QueryAttribute(A_DEX)) < 3)
      return write(BS("Das Kristallinwesen erwischt Dich noch bevor Du den "
		      "Steinkreis verlassen kannst und wirft Dich zurueck.")),
	0;
  
  return 1;
}

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Ein steinernes Gefaengnis");
  SetProp(P_INT_LONG,
	  BS("Rings um Dich herum ragen meterhohe Steinbloecke in den "
	     "Himmel und versperren jegliche Sicht auf den Kristallwald. "
	     "Irgendwie erinnert Dich der Ort eher an ein Gefaengnis, "
	     "als an einen Steinkreis. Der einzige Ausweg fuer Dich, ist "
	     "wohl das seltsame Spiegelportal neben Dir."));

  AddDetail(({"boden"}),
	    "Der Boden ist vollkommen glattgetreten, als waere hier etwas "
	    "sehr schweres auf und abmarschiert...");

  AddDetail(({"himmel"}),
	    "Der strahlend blaue Himmel ueber Dir wird von den hohen "
	    "Steinbloecken zu einem blauen Kreis zugeschnitten.");

  AddDetail(({"ausweg"}),
	    "Das Spiegelportal scheint der einzige Ausweg zu sein.");

  AddDetail(({"spiegel","portal","spiegelportal"}),
	    "Das Portal besteht aus einem Kreis, der die Umgebung von "
	    "Draussen wiederspiegelt.");
  
  AddDetail(({"draussen","umgebung"}),
	    "Draussen befindet sich der Kristallwald.");

  AddDetail(({"sicht","wald","kristallwald"}),
	    "Vom Kristallwald bekommt man hier drinnen nicht viel mit...");

  AddDetail(({"ort","gefaengnis","gefaengniss"}),
	    "Waere das Spiegelportal nicht da, koennte man den Ort hier glatt "
	    "fuer ein Gefaengnis halten.");

  AddDetail(({"kreis","steinkreis"}),
	    "Die gewaltigen Steinbloecke bilden einen steinernen Kreis um "
	    "Dich herum. Hinter Dir entdeckst Du ein Spiegelportal, durch "
	    "das Du den Steinkreis verlassen kannst.");

  AddDetail(({"waende","steinwaende","wand","steinwand"}),
	    "Die Steinwaende sind ueber und ueber von tiefen Furchen "
	    "uebersaeht.");
  
  AddDetail(({"furche","furchen"}),
	    "Die Steinwaende weisen tiefe Furchen auf, als ob sie von "
	    "scharfen Krallen bearbeitet wurden!");
  
  AddDetail(({"krallen"}),
	    "Was es auch war, Du moechtest dem nicht begegnen!");

  AddDetail(({"bloecke","steinbloecke","block","steinblock"}),
	    "Die einzelnen Steinbloecke bilden einen perfekten Kreis und "
	    "verhindern somit, dass etwas hereingelangt, oder doch heraus?!");

  AddDetail(({"ohr","ohren"}),
	    "Ja, die sind beide noch da.");

  AddDetail(({"oeffnung"}),
	    "Die Steinbloecke sind so fest miteinander verbunden, dass nur "
	    "eine einzige Oeffnung nach oben offen bleibt.");
  
  AddDetail(({"ausgang","richtung"}),
	    "Der Ausgang war doch vor kurzem noch woanders...");
  
  AddDetail(({"bewegung"}),
	    "Hm, da war wohl doch nichts...");
  
  AddSound(DEFAULT_SOUND,
	   "Durch die obere Oeffnung gelangen die Geraeusche aus dem "
	   "Kristallwald an Dein Ohr");

  AddSound(({"geraeusch","geraeusche","wald","kristallwald"}),
	   "Du vernimmst die Geraeusche aus dem Kristallwald.");
  
  AddSmell(DEFAULT_SMELL,
	   "Es riecht nach Erde.");
  
  AddSmell(({"erde"}),
	   "Naja, wie Erde halt so riecht... erdig eben.");

  Umgebung("warm", TT_CAVE, 0);
  Licht("hell");

  position=-1;

  shift_exit();
  
  AddRoomMessage(({
    "Ploetzlich scheinen sich die Waende zu bewegen!\n",
      "","","","",""
      "Hat der Ausgang nicht gerade in eine andere Richtung gezeigt?\n",
      "","","","",""
      "Der Ausgang befindet sich ploetzlich ganz woanders!\n",
      "","","","",""
      "Aus Deinen Augenwinkeln bemerkst Du eine seltsame Bewegung.\n",
      "","","","",""}), 30, "shift_exit");
  
  AddItem(NPC "kgig" , REFRESH_DESTRUCT);
}
