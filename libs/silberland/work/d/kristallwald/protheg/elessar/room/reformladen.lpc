/*
** Talan der Reformkost, von Xelindos Tochter Xulia
** 
**
** 2002-10-30  PROtheG  Details...
*/

#include "../def.h"
#include <pub.h>

inherit "std/pub";
inherit MOST "std_room";

#define ANSCHLUSS "/d/kristallwald/sargola/dorf/room/kneipe"

void create() 
{
  ::create();
  
  SetProp(P_INT_SHORT, "Xulias Obsttheke");
  SetProp(P_INT_LONG,
	  BS("Du findest Dich in einem schlicht wirkenden, sehr "
	     "naturbelassenen Talan wieder. Aus dem Boden, aus den Waenden, "
	     "ja sogar von der Decke herab, wachsen hunderte Aeste, die "
	     "allerlei Kruege und bunte Glaeser halten. Einige Koerbe mit "
	     "frischem Obst befinden sich weiter hinten in einer Ecke."));
  
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER | PUB_NEEDSKEEPER | PUB_NOMULTFACTOR);
  SetProp(P_PUBKEEPER_ID, "xulia");
  SetProp(P_PUBKEEPER_NAME, "Xulia");
  SetProp(P_PUBKEEPER_GENDER, FEMALE);
  SetProp(P_PUBMSG_NOKEEPER, "Hier herrscht keine Selbstbedienung!\n");
  
  AddDetail(({"talan","baum","raum","elfentalan","theke","obsttheke"}),
