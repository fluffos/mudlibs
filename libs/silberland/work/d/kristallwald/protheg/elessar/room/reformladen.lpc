string det_obst()
{
  return BS("In einem der Koerbe erkennst Du "+({
    "ein paar Bananen", "ein paar Orangen", "ein paar Erdbeeren", "ein paar "
      "Birnen", "einige Mangos", "einige Grapefruits", "ein paar Maracujas",
      "ein paar Aepfel", "Weintrauben", "etwas Ribisel",
      "ein paar Marillen","Himbeeren", "Stachelbeeren","ein paar Zwetschgen"
      })[random(14)]+".");
} 

string det_saft()
{
  return BS("In einem der Glaeser erkennst Du "+({
    "frisch gepressten ", "ganz frischen ",""})[random(3)]+({
      "Bananensaft", "Orangensaft", "Erdbeersaft", "Mangosaft", "Birnensaft",
	"Grapefruitsaft", "Maracujasaft", "Apfelsaft", "Marillensaft",
	"Himbeersaft", "Weintraubensaft", "Ribiselsaft", "Stachelbeersaft",
	"Zwetschgensaft"})[random(14)]+".");
}

int menue()
{                                                                              
  int i;
  string ret;
  
  if(!present("xulia")) return write(BS("Ohne Xulia laeuft hier nichts.")), 0;
  
  // speisen und getraenke
  ret="Xulia haelt Dir eine Karte unter die Nase.\n"
    "=======================================+"
    "=======================================\n"
    "Obstsaefte (frisch gepresst) Kal Preis | "
    "Reformkost                   Kal Preis\n"
    "---------------------------------------+"
    "---------------------------------------\n";
  for (i=0; i<sizeof(drink) || i<sizeof(food); i++) 
    {
      if(i<sizeof(drink))
	if(!(i%2))
	  ret+=sprintf("%-28.28s %3.3d %5.5d | ", drink[i][0], drink[i][5]*7, calc_price(drink[i]));
	else
	  ret+=sprintf("%-29.29'.'s%3.3'.'d.%5.5'.'d | ", drink[i][0], drink[i][5]*7, calc_price(drink[i]));
      else
	ret+="                                       | ";
      
      if (i<sizeof(food))
	if(!(i%2))
	  ret+=sprintf("%-28.28s %3.3d %5.5d",food[i][0], food[i][4]*7, calc_price(food[i]));
	else
	  ret+=sprintf("%-29.29'.'s%3.3'.'d.%5.5'.'d",food[i][0], food[i][4]*7, calc_price(food[i]));
      
      ret+="\n";
    }

  ret+="=======================================+"
    "=======================================\n";
  
  TP->More(ret);
  
  tell_room(ME, BS(TPN+" laesst sich von Xulia die Karte zeigen."), ({TP}));
  
  return 1;
}

/*
  eine Banane, Bananensaft.
  eine Orange, Orangensaft.
  ein paar Erdbeeren, Erdbeersaft.
  eine Mango, Mangosaft.
  eine Grapefruit, Grapefruitsaft.
  eine Maracuja, Maracujasaft.
  einen Apfel, Apfelsaft.
  ein paar Weintrauben, Traubensaft.
  etwas Ribisel, Ribiselsaft.
*/
