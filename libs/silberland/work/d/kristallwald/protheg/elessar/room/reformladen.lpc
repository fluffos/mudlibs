  AddDetail(({"boden","talanboden"}),
	    "Der Talanboden besteht aus einem festen Geflecht aus Aesten. Du "
	    "erkennst an einigen Stellen den Boden weit unter Dir.");
  
  AddDetail(({"geflecht","astgeflecht","aestegeflecht"}),
	    "Das Geflecht ist so fest, dass es Dich locker tragen kann. "
	    "Nur an ein paar Stellen kannst Du auf den Waldboden hinabsehen.");
  
  AddDetail(({"waldboden","wald","kristallwald"}),
	    "Der Waldboden scheint an einigen Stellen im Talanboden durch, "
	    "mehr siehst Du hier vom Kristallwald nicht.");
  
  AddDetail(({"stelle","stellen"}),
	    "An einigen Stellen im Talanboden kannst Du bis hinab auf den "
	    "Waldboden sehen.");
  
  AddDetail(({"himmel"}),
	    "Der Himmel wird durch das dichte Blaetterdach des Talans "
	    "verdeckt.");
  
  AddDetail(({"decke","dach","blaetterdach"}),
	    "Ein sehr dichtes Blaetterdach bildet hier die Decke des Talans.");
  
  AddDetail(({"waende","wand"}),
	    "Ueberall aus den Waenden ragen dicht verwachsene Aeste, die als "
	    "Regale dienen und allerlei Kruege und Karaffen tragen.");
  
  AddDetail(({"krug","kruege"}),
	    "Einige der Kruege sind mit allerlei Getraenken gefuellt, andere "
