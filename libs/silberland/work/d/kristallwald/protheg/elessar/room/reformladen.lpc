  AddDetail(({"getraenk","getraenke"}),
	    "Welche Getraenke Du hier bekommen kannst, siehst Du sicher auf "
	    "der Menuekarte.");
  
  AddDetail(({"regal","regale"}),
	    "Die Regale sind voll mit verschiedenen Kruegen und Karaffen und "
	    "auch einige Schuesseln stehen da herum.");
  
  AddDetail(({"kristallschuessel","kristallschuesseln","schuessel",
		"schuesseln"}),
	    "Die Schuesseln bestehen aus blauem Kristall und enthalten "
	    "allerlei Nuesse und getrocknete Fruechte.");
  
  AddDetail(({"kristall"}),
	    "Die Schuesseln in den Regalen bestehen aus einem blauen "
	    "Kristall.");
  
  AddDetail(({"nuss"}),
	    "Meinst Du eine bestimmte? Hier gibt es so viele verschiedene "
	    "Nuesse.");
  
  AddDetail(({"nuesse"}),
	    "Bei den Nuessen in den Kristallschuesseln handelt es sich "
	    "hauptsaechlich um Walnuesse, Haselnuesse und Mandeln.");
  
  AddDetail(({"walnuss","walnuesse"}),
	    "Die groessten und schoensten Walnuesse, die Du je gesehen hast.");
  
  AddDetail(({"haselnuss","haselnuesse"}),
	    "Aussergewoehnlich grosse Haselnuesse, Du wuesstest gern, wo "
	    "Xulia die her hat.");
  
  AddDetail(({"mandel","mandeln"}),
	    "So grosse und wohlgeformte Mandeln hast Du ja noch nie gesehen!");
  
  AddDetail(({"fruechte","frucht","trockenfruechte","trockenfrucht",
