/*
**  Nimrondels Quelle
**
**  2002-06-01  PROtheG  Jaja... Details
**  
*/

#pragma strong_types;

#include "../def.h"

inherit MOST "std_room";

#define DRINK 5
#define ELFENTOOL "/p/service/protheg/rt/obj/nimrondel"

nosave string *getrunken;

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Nimrondels Quelle");
  SetProp(P_INT_LONG,
          BS("Du findest Dich in einer Felsspalte wieder, die ueber und "
	     "ueber mit Moosen bedeckt ist. Frisches Gebirgswasser "
	     "plaetschert aus einer Quelle etwas oberhalb und muendet "
	     "neben Dir in einer tiefen Furche im Fels.")+
	  BS("Die Atmosphaere hier hat etwas trauriges, wie Du findest... "
	     "Die Szene vor Dir wirkt, als wuerde die Felswand weinen."));

  AddDetail(({"spalt","felsspalt"}),
	    QueryProp(P_INT_LONG));

  AddDetail(({"boden","felsboden","furchen","risse"}),
	    "Der Felsboden ist uebersaeht mit Rissen und Furchen. Glitschig "
	    "ist er ebenfalls durch das viele Wasser, das hier fliesst. "
	    "Einige Blumen liegen verwelkt auf dem Boden.");
  
  AddDetail(({"blume","blumen"}),
	    "Einige verwelkte Blumen liegen verstreut auf dem Boden herum. "
	    "Welchen Zweck sie wohl erfuellt haben moegen?");
  
  AddDetail(({"zweck"}),
	    "Ob man die Blumen fuer ein bestimmtes Ritual gebraucht hat?");
  
  AddDetail(({"ritual"}),
	    "Scheinbar hatte das Ritual etwas mit der Nordwand zu tun, denn "
	    "dort liegen die meisten Blumen.");
  
  AddDetail(({"riss"}),
	    "Welchen Riss meinst Du? Es gibt hier so viele!");
  
  AddDetail(({"furche"}),
	    "Welche Furche meinst Du? Es gibt hier so viele!");

  AddDetail(({"suedwand","westwand","ostwand","waende","felswaende"}),
	    "Die Felswaende sind ueber und ueber mit Moosen bedeckt. "
	    "Aus einem Loch weiter oben in der Nordwand ergiesst sich "
	    "frisches Gebirgswasser ueber das Moos, bis es in einer der "
	    "vielen Furchen unter Dir verschwindet...");
  
  AddDetail(({"wand","felswand","nordwand"}),
	    "Frisches Gebirgswasser fliesst an der moosbedeckten Nordwand "
	    "herab.");
  
  AddDetail(({"moos","feuchtigkeit"}),
	    ([
	      0: "Durch die viele Feuchtigkeit hat sich hier sehr viel Moos "
	      "angesammelt.",
	      "elf": "Sehr viel Moos waechst hier. Einiges davon ist von dem "
	      "herabfliessenden Wasser seltsam blaeulich verfaerbt worden. "
	      "Vielleicht ist das ein spezielles Moos? Was wohl passiert, "
	      "wenn Du es beruehrst?"]));

  AddDetail(({"berg","gebirge"}),
	    "Du befindest Dich hier in einer recht schmalen Felsspalte, daher "
	    "siehst Du nicht viel vom Gebirge.");
  
  AddDetail(({"decke","himmel","blau"}),
	    "Durch den relativ engen Felsspalt siehst Du oben den Himmel "
	    "nur schwach durchschimmern.");
  
  AddDetail(({"wasser","gebirgswasser","quellwasser"}),
	    ([
	      0: "Das Wasser fliesst aus einem Loch weiter oben ueber die "
	      "moosbedeckte Felswand herab und verschwindet in den Furchen im "
	      "Felsboden.",
	      "elf": "Das Wasser fliesst aus einem Loch weiter oben ueber "
	      "die moosbedeckte Felswand herab und verschwindet in den "
	      "Furchen im Felsboden. Es fliesst dabei ueber das Moos, das "
	      "dadurch eine seltsame blaue Farbe angenommen hat."]));

  AddDetail(({"atmosphaere","szene"}),
	    "Die Atmosphaere hat etwas trauriges... Es ist, als wuerde die "
	    "Felswand weinen.");
  
  AddDetail(({"fels"}),
	    "Welchen Fels? Du bist umgeben von Felsen!");
  
  AddDetail(({"loch"}),
	    "Weiter oben in der Nordwand ist ein Loch aus dem Wasser "
	    "fliesst.");
  
  AddDetail(({"quelle"}),
	    "Du kannst sie nicht erkennen. Vermutlich entspringt sie "
	    "irgendwo im Berg und fliesst ueber das Loch in der Nordwand "
	    "ueber das viele Moos hinab und verschwindet in den Furchen im "
	    "Boden...");
  
  AddDetail(({"spalte","felsspalte"}),
	    "Durch die Felsspalte kommst Du wieder zurueck.");
  
  AddSound(DEFAULT_SOUND,
	   "Du hoerst nur das gemuetliche Plaetschern des Wassers.");

  AddSound(({"plaetschern","wasser","gebirgswasser"}),
	   "*plaetscher* *plaetscher*");

  AddSmell(DEFAULT_SMELL,
	   "Es riecht nach frischem Moos.");

  AddSmell(({"geruch","moos","frisches moos","frischem moos"}),
	   "Es riecht wie... frisches Moos!");

  Licht("hell");
  Umgebung("kuehl", TT_MOUNTAIN, 0);

  SUID;

  getrunken=({});

  AddCmd(CMD_TRINKEN, "trinken");
  AddCmd(({"beruehr","beruehre"}), "beruehren");
  AddCmd(CMD_KLETTERN+({"zwaenge","zwaeng"}), "klettern");
}

nosave int klettern(string str)
{
  notify_fail(BS("Willst Du wieder zurueckklettern?"));
  if(!str) return 0;
  
  if(member(({"zurueck","raus","durch spalt","durch spalte","durch felsspalt",
		"durch felsspalte","durch spalt zurueck", "durch spalt durch",
		"durch felsspalte durch","durch spalte durch",
		"in spalt","in spalte","in felsspalt","in felsspalte",
		"durch spalte zurueck","durch felsspalt zurueck",
		"durch felsspalte zurueck","durch felsspalt durch"}), str)==-1)
    return 0;
  
  if(TP->QueryProp(P_SIZE)>=140)
    write(BS("Du versucht Dich so schmal wie moeglich zu machen und "
	     "kletterst durch die Felsspalte..."));
  else
    write(BS("Die Felsspalte scheint fuer Dich breit genug zu sein, also "
	     "kletterst Du einfach durch..."));
  
  tell_room(ME, 
	    BS(TPN+" klettert wieder zurueck durch die Felsspalte."), ({TP}));
  
  tell_room(ROOM "vorraum",
	    BS(TPN+" steht ploetzlich hinter Dir."), ({TP}));

  TP->move(ROOM "vorraum", M_GO|M_SILENT);
  
  return 1;
}

nosave int trinken(string str)
{
  notify_fail(BS("Was willst Du trinken?"));
  if(!str) return 0;

  if(str=="wasser"||str=="quellwasser"||str=="gebirgswasser"||
     str=="gebirgsquellwasser")
    {
      if(!TP->drink_soft(DRINK, 1))
	return write(BS("Soviel trinken kannst Du nicht mehr!")), 1;
      
      write(BS("Du naeherst Dich der noerdlichen Felswand und haeltst Deine "
	       "Haende auf, um etwas Wasser aufzufangen, welches Du in "
	       "einem Zug austrinkst..."));

      tell_room(ME, BS(TPN+" trinkt etwas von dem Wasser."), ({TP}));
      
      if(member(getrunken, getuid(TP))==-1)
	{
	  TP->heal_self(40+random(11));
	  
	  write(BS("Du fuehlst Dich erfrischt."));
	  
	  if(!random(3))
	    getrunken+=({getuid(TP)});
	}
      
      return 1;
    }
  
  return 0;
}

nosave int beruehren(string str)
{
  object traene;
  int renew;

  notify_fail(BS("Was willst Du beruehren?"));
  if(!str) return 0;
  
  if(str=="moos"||str=="moos aus"||str=="moos ab"||str=="moos von wand"||
     str=="moos von wand ab"||str=="moos von felswand"||
     str=="moos von felswand ab")
    if(TP->QueryProp(P_RACE)=="Elf")
      {
	if(traene=present("\nPROtheG_Racetool", TP))
	  if((traene->QueryProp(P_CLONE_TIME)+20) > time())
	    return write(BS("Als Du das Moos beruehrst, passiert nichts.")+
			 BS("Vielleicht solltest Du es etwas spaeter "
			    "wieder versuchen.")), 1;
	  else
	    {
	      traene->remove();
	      renew=1;
	    }

	write(BS("Als Du das Moos beruehrst, beginnt es kurz zu pulsieren "
		 "und ein angenehmes Kribbeln macht sich in Deiner Hand "
		 "breit, als das Wasser darueberrinnt...")+
	      BS("Ploetzlich waechst eine wunderschoene Blume aus dem "
		 "Moos heraus. Du pflueckst die Blume, doch sie verwelkt "
		 "augenblicklich...")+
	      BS("Als Du die verwelkte Blume ablegst, haeltst Du ploetzlich "
		 "eine eigenartige Wasserperle in der Hand."));
	
	tell_room(ME, BS(TPN+" beruehrt kurz das Moos und zuckt wieder weg."),
		  ({TP}));
	
	CLONE(ELFENTOOL, TP);
	
	if(renew)
	  write_file(LOG "elfentool_get", dtime()+": "+CAP(getuid(TP))+
		     " holt sich eine Traene (Renew).\n");
	
	return 1;
      }
    else
      return write(BS("Nein, Du willst das glitschige Moos nicht angreifen.")),
	1;

  return 0;
}

varargs string GetExits(object viewer)
{
  return "";
}

void reset()
{
  ::reset();
  
  getrunken=({});
}
