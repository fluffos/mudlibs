/*
**  Ein halbverschuettetes Plateau
**
**  2002-06-09  PROtheG  Jaja... Details
**
*/

#pragma strong_types;

#include "../def.h"

inherit MOST "std_room";

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Ein halbverschuettetes Plateau");
  SetProp(P_INT_LONG,
          BS("Du befindest Dich nun auf dem halbverschuetteten Plateau. Eine "
	     "Feuerstelle befindet sich gleich neben Dir und dahinter steht "
	     "ein zerfetztes, halbverschuettetes Zelt."));
  
  AddDetail(({"plateau"}),
	    QueryProp(P_INT_LONG));
  
  AddDetail(({"boden","felsboden"}),
	    "Der Felsboden, der noch nicht verschuettet ist, ist ueber und "
	    "ueber mit kleinen Kieselsteinen uebersaeht.");
  
  AddDetail(({"pfad","weg"}),
	    "Der Pfad scheint Dir doch etwas sicherer, als hier auf dem "
	    "verschuetteten Plateau herumzustehen...");

  AddDetail(({"himmel","wolke","wolken"}),
	    "Der wolkenlose Himmel erstreckt sich weit ueber Dir.");

  AddDetail(({"sonne"}),
	    "Die Sonne scheint freundlich auf das verwuestete Plateau herab.");
  
  AddDetail(({"fels","felsen","gestein","felsengestein","felsgestein","stein",
		"steine"}),
	    "Das Plateau ist ueber und ueber mit Steinen verschuettet. Nur "
	    "die Feuerstelle neben Dir und ein zerstoertes Zelt sind noch "
	    "sichtbar.");
  
  AddDetail(({"kieselstein","kiesel","kieselsteine"}),
	    "Die Kieselsteine knirschen unter Dir.");
  
  AddDetail(({"hang","steinhang","felshang","berghang"}),
	    "Der Hang wird von einigen Latschenkiefern gehalten, doch "
	    "scheinbar waren sie nicht stark genug, um die Steine "
	    "aufzuhalten.");
  
  AddDetail(({"zelt"}),
	    "Zelt kann man es eigentlich nicht mehr nennen... Es sind "
	    "eigentlich nur noch Fetzen, die entfernt an die Form eines "
	    "Zeltes erinnern.");
  
  AddDetail(({"form"}),
	    "Urspruenglich schien das Zelt rechteckig gewesen zu sein.");
  
  AddDetail(({"fetzen","lederfetzen","zeltfetzen"}),
	    "Die ledernen Fetzen erinnern nur noch entfernt an das Zelt, das "
	    "hier gestanden hat.");

  AddDetail(({"stelle","feuerstelle"}),
	    "Eigentlich ist die Feuerstelle nur noch ein dunkler Fleck, da "
	    "der Wind bereits die ganze Asche weggefegt hat.");
  
  AddDetail(({"fleck"}),
	    "Ein grosser, runder und schwarzer Fleck.");

  AddDetail(({"asche"}),
	    "Der Wind hat bereits die ganze Asche aus der Feuerstelle "
	    "weggefegt.");

  AddDetail(({"wind"}),
	    "Sehen kann man den nicht...");
  
  AddSound(DEFAULT_SOUND,
	   "Da das Plateau recht offen ist, heult hier der Wind ziemlich "
	   "laut.");
  
  AddSound(({"wind","heulen"}),
	   "*heuuuuuul*");

  AddSmell(DEFAULT_SMELL,
	   "Die Latschenkiefern verbreiten einen angenehmen Geruch.");

  AddSmell(({"harz","geruch","kiefer","latsche","latschenkiefer","duft",
	       "harzduft"}),
	   "Die Latschenkiefern riechen angenehm nach frischem Harz.");
  
  Licht("hell");
  Umgebung("kuehl", TT_MOUNTAIN, 0);
  
  AddExit("zurueck", ROOM "aufstieg");

  AddItem(NPC "oschnabl", REFRESH_DESTRUCT);
}
