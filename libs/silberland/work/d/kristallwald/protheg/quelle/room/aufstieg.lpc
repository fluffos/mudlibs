#pragma strong_types;

#include "../def.h"

inherit MOST "std_room";

#define ANSCHLUSS "/d/kristallwald/sargola/see/room/0510"

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Ein schmaler Gebirgspfad");
  SetProp(P_INT_LONG,
          BS("Du hast ein kleines Plateau erreicht. Es scheint, als waere "
	     "hier frueher ein Lager gewesen. Du kannst ein zerfetztes Zelt "
	     "und eine Feuerstelle erkennen. Einige Latschenkiefern sichern "
	     "den Hang vor Muren, doch genutzt haben sie wohl nicht, da das "
	     "halbe Plateau mit Steinen verschuettet ist."));

  AddDetail(({"boden","felsboden"}),
	    "Der Felsboden, der noch nicht verschuettet ist, ist ueber und "
	    "ueber mit kleinen Kieselsteinen uebersaeht.");
  
  AddDetail(({"pfad","weg"}),
	    "Der Pfad fuehrt vom Osten her steil bergauf nach Westen weiter.");
  
  AddDetail(({"kieselstein","kieselsteine"}),
	    "Viele kleine Kieselsteine liegen auf dem Felsboden. Pass auf, "
	    "dass Du nicht ausrutschst!");
  
  AddDetail(({"wald","kristallwald"}),
	    "Weiter unten im Tal erkennst Du den Kristallwald.");
  
  AddDetail(({"see","rhondonitsee"}),
	    "Weiter unten im Tal siehst Du das Glitzern auf der Oberflaeche "
	    "des Rhondonitsees.");
  
  AddDetail(({"glitzern"}),
	    "Von hier aus erkennst Du den Rhondonitsee nur an dem Glitzern "
	    "auf dessen Oberflaeche.");
  
  AddDetail(({"himmel","wolken"}),
	    "Der wolkenlose Himmel erstreckt sich weit ueber Dir.");
  
  AddDetail(({"sonne"}),
	    "Die Sonne scheint freundlich auf das verwuestete Plateau herab.");
  
  AddDetail(({"felsen","steine"}),
	    "Die gibts hier ueberall...");
  
  AddDetail(({"steinschlag"}),
	    "Anscheinend ist das Gebirge hier nicht sonderlich stabil...");
  
  AddDetail(({"baeume"}),
	    "Du siehst einige kleine Latschenkiefern die den Hang abstuetzen "
	    "sollen.");

  AddDetail(({"kiefer","kiefern","latschenkiefern","baeume","latschenkiefer",
		"baum"}),
	    "Einige kleine Latschenkiefer wachsen hier im Hang, doch die "
	    "vielen Steine koennen sie nicht aufhalten. Das halbe Plateau "
	    "ist bereits verschuettet.");

  AddDetail(({"gebirge","berg","berge"}),
	    "Das Gebirge steigt gen Westen hin noch weiter hinauf.");

  AddDetail(({"stelle","feuerstelle","feuer"}),
	    "Die Feuerstelle ist von hier nicht so genau erkennbar.");
  
  AddDetail(({"zelt","zeltplatz","lager"}),
	    "Mitten auf dem Plateau befindet sich ein recht zerfetzt "
	    "aussehendes Zelt.");
  
  AddDetail(({"plateau"}),
	    "Das Plateau liegt halb verschuettet vor Dir.");
  
  AddDetail(({"hang"}),
	    "Der steinerne Hang wird teilweise von Latschenkiefern gestuetzt. "
	    "Jedoch scheint trotzdem eine gewaltige Mure herabgekommen zu "
	    "sein, denn der halbe Hang und ein Grossteil des Plateaus sind "
	    "verschuettet.");
  
  AddDetail(({"teil","grossteil"}),
	    "Ein Grossteil der Plateaus ist verschuettet!");
  
  AddDetail(({"geroellawine","lawine","geroell","mure","muren"}),
	    "Eine gewaltige Mure ist hier herabgekommen und hat einen "
	    "Grossteil des Plateaus unter sich begraben.");
  
  AddSound(DEFAULT_SOUND,
	   "Da das Plateau recht offen ist, heult hier der Wind ziemlich "
	   "laut.");
  
  AddSound(({"wind","heulen"}),
	   "*heuuuuuul*");

  AddSmell(DEFAULT_SMELL,
	   "Die Latschenkiefern verbreitet einen angenehmen Geruch.");

  AddSmell(({"harz","geruch","kiefer","latsche","latschenkiefer","duft",
	       "harzduft"}),
	   "Die Latschenkiefern riechen angenehm nach frischem Harz.");
  
  Licht("hell");
  Umgebung("kuehl", TT_MOUNTAIN, 0);
  
  AddExit("westoben", ROOM "vorraum");
  AddExit("plateau", ROOM "plateau");
  AddExit("ostunten", ANSCHLUSS);
}
