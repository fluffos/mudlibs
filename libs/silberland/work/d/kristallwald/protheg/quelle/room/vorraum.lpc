#pragma strong_types;

#include "../def.h"

#define ANSCHLUSSRAUM "/d/kristallwald/chivas/zentauren/room/zen50"

inherit MOST "std_room";

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Ein schmaler Gebirgspfad");
  SetProp(P_INT_LONG,
          BS("Der schmale Pfad, dem Du hier folgst macht hier einen "
	     "Knick. Dieser Durchgang scheint frueher durch einen "
	     "Steinschlag verschuettet gewesen zu sein, denn am Wegrand "
	     "bemerkst Du noch einiges an Geroell und Steinen. Eine "
	     "einsame Latschenkiefer waechst seitlich des Pfades. "
	     "Eine seltsame Aura umgibt Deine Umgebung..."));
  
  AddDetail(({"umgebung"}),
	    QueryProp(P_INT_LONG));
  
  AddDetail(({"aura"}),
	    "Du kannst es Dir nicht erklaeren, aber eine magische Aura "
	    "durchfliesst Deine Umgebung.");
  
  AddDetail(({"boden","felsboden","geroell"}),
	    "Der Felsboden ist ueber und ueber mit kleinen Kieselsteinen "
	    "uebersaet, die von der ehemaligen Blockade herabrieselten.");
  
  AddDetail(({"blockade"}),
	    "Scheinbar wurde die Blockade von ein paar mutigen Abenteurern "
	    "entfernt.");
  
  AddDetail(({"abenteuer", "abenteurer"}),
	    "Worauf wartest Du noch? Folge ihnen...");
  
  AddDetail(({"pfad","weg","knick","durchgang"}),
	    "Der Pfad macht hier einen scharfen Knick. Du kannst nach Osten "
	    "den Berg hinab, oder nach Nordwesten den Berg hinauf gehen.");
  
  AddDetail(({"kieselstein","kieselsteine","wegrand","rand"}),
	    "Viele kleine Kieselsteine liegen hier auf dem Felsboden. "
	    "Pass auf, dass Du nicht ausrutschst!");
  
  AddDetail(({"wald","kristallwald"}),
	    "Weiter unten im Tal erkennst Du den Kristallwald.");
  
  AddDetail(({"see","rhondonitsee"}),
	    "Weiter unten im Tal siehst Du das Glitzern auf der Oberflaeche "
	    "des Rhondonitsees.");
  
  AddDetail(({"glitzern"}),
	    "Von hier aus erkennst Du den Rhondonitsee nur an dem Glitzern "
	    "auf dessen Oberflaeche.");
  
  AddDetail(({"himmel","wolken"}),
	    "Der wolkenlose Himmel erstreckt sich weit ueber Dir.");
  
  AddDetail(({"sonne"}),
	    "Du siehst die Sonne nicht, da die Felsen hier recht hoch sind, "
	    "aber Du weisst, dass sie da sein muss.");
  
  AddDetail(({"felsen","steine"}),
	    "Die gibts hier ueberall...");
  
  AddDetail(({"steinschlag"}),
	    "Anscheinend ist das Gebirge hier nicht sonderlich stabil...");
  
  AddDetail(({"baeume"}),
	    "Du siehst nur die kleine Latschenkiefer hier.");

  AddDetail(({"kiefer","latschenkiefer","baum"}),
	    "Eine einsame, kleine Latschenkiefer steht hier abseits des "
	    "Pfades und verbreitet einen angenehmen Harzduft.");

  AddDetail(({"gebirge","berg","berge"}),
	    "Das Gebirge steigt gen Westen hin noch weiter hinauf.");
  
  AddDetail(({"spalte","felsspalte"}),
	    "Tatsaechlich! Rechts von Dir ist eine recht schmale Felsspalte.");
  
  AddSound(DEFAULT_SOUND,
	   "Dir war so, als haettest Du gerade ein plaetscherndes Geraeusch "
	   "gehoert...");

  AddSound(({"geraeusch"}),
	   "Doch! Nun hoerst Du es etwas lauter, klingt irgendwie nach "
	   "einem Plaetschern...");

  AddSound(({"plaetschern","geplaetscher","wasser","gebirgswasser"}),
	   "Dir war, als komme das Plaetschern aus der Felsspalte rechts "
	   "von Dir.");

  AddSmell(DEFAULT_SMELL,
	   "Die Latschenkiefer verbreitet einen angenehmen Geruch.");

  AddSmell(({"harz","geruch","kiefer","latsche","latschenkiefer","duft",
	       "harzduft"}),
	   "Die Latschenkiefer riecht angenehm nach frischem Harz.");
  
  Licht("hell");
  Umgebung("kuehl", TT_MOUNTAIN, 0);
  
  AddRoomMessage(({"Hast Du da nicht soeben ein Plaetschern vernommen?\n",
		     "Was plaetschert denn da?\n"}), 45);
  
  AddExit("ostunten", ROOM "aufstieg");
  AddExit("nordwestoben", ANSCHLUSSRAUM);  
  
  AddCmd(CMD_KLETTERN+({"zwaenge","zwaeng"}), "klettern");
}

nosave int klettern(string str)
{
  notify_fail(BS("Wohin willst Du klettern?"));
  if(!str) return 0;

  if(member(({"in spalt","in spalte","in spalt rein","in spalte rein",
		"in spalt hinein","in spalte hinein","in felsspalt",
		"durch spalt","durch spalte","durch felsspalt",
		"durch felsspalte durch","durch spalt durch",
		"durch spalte durch","durch felsspalt durch",
		"durch felsspalte durch","in felsspalte",
		"in felsspalt rein","in felsspalte rein",
		"in felsspalt hinein","in felsspalte hinein"}),
	    str)==-1) return 0;

  if(TP->QueryProp(P_SIZE)>=140)
    write(BS("Du versucht Dich so schmal wie moeglich zu machen und "
	     "kletterst in die Felsspalte hinein..."));
  else
    write(BS("Die Felsspalte scheint fuer Dich breit genug zu sein, also "
	     "kletterst Du einfach hinein..."));
  
  tell_room(ME,
	    BS("War "+TPN+" nicht gerade noch hier?"), ({TP}));

  tell_room(ROOM "quelle",
	    BS(TPN+" klettert herein."), ({TP}));
  
  TP->move(ROOM "quelle", M_GO|M_SILENT);
  
  return 1;
}
