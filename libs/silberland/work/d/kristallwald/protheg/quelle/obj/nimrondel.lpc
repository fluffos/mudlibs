/*
**  Nimrondel, Master fuer die Elfen
**
*/

#pragma strong_types;

#include "../def.h"

#define HISTSIZE 10
#define VER OBJ "nimrondel_save"
#define ELFLISTENER "tmp_elf_listener"

int version;
nosave string *history;

nomask int query_prevent_shadow() { return 1; }

nomask nosave int allowed()
{
  if(!PO) return 0;
  if(!TP) return 0;

  if((TP) && (interactive(TP)) && (getuid(TP)=="protheg")) return 1;

  if(explode(file_name(PO), "#")[0]==OBJ "elfentool")
    return 1;

  DB("*** NIMRONDEL: "+sprintf("PO:%O TP:%O TI:%O [%s]", PO, TP, TI, 
			       getuid(TP))+"\n");

  return 0;
}

nomask void create()
{
  SUID;
  
  history=({});
  
  restore_object(VER);

  DB("*** NIMRONDEL create() by "+
     sprintf("%O [%O]",PO,PO->QueryProp(P_CLONER))+"\n");
}

nomask public void AddHistory(string what)
{
  if(!allowed()) return;  
  
  history+=({"<"+dtime(time())[<8..<1]+">\n"+what});
  
  if(sizeof(history) > HISTSIZE)
    history-=({history[0]});
}

nomask public string QueryHistory()
{
  if(!allowed()) return "";
  
  return implode(history, "");
}

nomask nosave int is_listening(object who)
{
  if(who->QueryProp(ELFLISTENER)) 
    return 1;
  else 
    return 0; 
}

nomask public object *QueryListeners()
{
  return filter_array(users(), "is_listening");
}

nomask public int GetCurrentVersion()
{
  return version;
}

nomask public varargs int UpdateCurrentVersion(int flag)
{
  object *pls;
  object tr;
  int i;

  if(!allowed()) return 0;
  
  if(!flag) version++;
  save_object(VER);

  if(sizeof(pls=QueryListeners()))
    for(i=sizeof(pls)-1;i>=0;i--)
      if(tr=present("\nelfentool", pls[i]))
	tr->erneuern(1);

  return version;
}

nomask public int SetCurrentVersion(int i)
{
  if(!allowed()) return 0;

  version=i;
  save_object(VER);
  return version;
}
