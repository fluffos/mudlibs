/*
**  Roomspell vom Schwarzmagier
**
**  Fuer einige Zeit schiessen Stacheln aus dem Boden
*/

#include "../def.h"

inherit "std/thing";

nosave int activated;

void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "");
  SetProp(P_NAME, "Stachel");
  SetProp(P_GENDER, MALE);
  SetProp(P_KILL_NAME, "Eine Stachelfalle");
  SetProp(P_KILL_MSG, "*stichel* *stichel*");

  AddId("\nstachel_roomspell");

  SetProp(P_WEIGHT, 10340240);
  SetProp(P_NOGET, 1);
  //SetProp(P_INVIS, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
}

void init()
{
  ::init();
  
  if(activated) return;
  
  activated=5+random(6);

  //DB("*** Starting Stachel_Roomspell with "+activated+".\n");
  
  call_out("sticheln", 2+random(3));
}

void sticheln()
{
  object *pls;
  object spidermage;
  int i;

  activated--;
  
  if(activated < 0)
    return call_out("wegmitdir", 0);
  
  pls=filter_array(all_inventory(MENV), CLOSURE(living));
  
  if(objectp(spidermage=present("\nschwarzmagier", MENV)))
    pls-=({spidermage});
  else
    activated--;
  
  if(sizeof(pls))
    for(i=sizeof(pls)-1;i>=0;i--)
      {
	if(interactive(pls[i]))
	  tell_object(pls[i], 
		      BS("Ploetzlich schiessen Stacheln aus dem Boden."));
	
	pls[i]->Defend(100+random(300), ({DT_PIERCE}), 0, ME);
      }
  
  call_out("sticheln", 3+random(3));
}

void wegmitdir()
{
  tell_room(MENV, BS("Die Spitzen im Boden loesen sich langsam auf..."));
  
  remove();
  if(ME) destruct();
}

void reset()
{
  if(!is_clone(TO)) return;
  ::reset();
  
  remove();
  if(ME) destruct();
}
