/*
**  Der Turm eines Schwarzmagiers - Erdgeschoss
**
**  2002-01-10  PROtheG  Blabla, Details
**  
*/

#pragma strong_types;

#include "../def.h"

inherit MOST "std_room";

nosave int touched;

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Schwarzmagierturm (Erdgeschoss)");
  SetProp(P_INT_LONG,
          BS("Du findest Dich im kreisrunden Erdgeschoss des Turmes wieder. "
	     "Die Waende werden von einer gewaltigen Steintreppe eingenommen, "
	     "die sich, wie eine gewaltige Schlange spiralfoermig nach oben "
	     "schlaengelt.")+
	  BS("Einige Fackeln versuchen den Raum zu erhellen, doch er wirkt "
	     "trotzdem sehr duester und gefaehrlich.")+
	  BS("Ansonsten ist der Raum bis auf das grosse Podest in der Mitte "
	     "leer."));
  
  AddDetail(({"raum","erdgeschoss"}),
	    QueryProp(P_INT_LONG));
  
  AddDetail(({"magier","schwarzmagier"}),
	    "Er scheint nicht hier zu sein, vielleicht ist er weiter oben.");
  
  AddDetail(({"turm","magierturm","schwarzmagierturm"}),
	    "Du befindest Dich hier im Erdgeschoss des Turmes, wie viele "
	    "Stockwerke er hat und was Dich weiter oben erwartet kannst Du "
	    "von hier aus nicht sagen.");
  
  AddDetail(({"stock","stockwerk","stoecke","stockwerke"}),
	    "Das hier ist das Erdgeschoss.");

  AddDetail(({"steinboden","boden"}),
	    "Der Boden ist mit einer dicken Schicht Dreck ueberzogen. "
	    "Nur an manchen Stellen erkennst Du das Muster der "
	    "darunterliegenden Steinbloecke.");
  
  AddDetail(({"bloecke","block","steinbloecke","steinblock"}),
	    "Die Steinbloecke, die den Boden bilden sind fast vollstaendig "
	    "mit einer dicken Dreckschicht ueberzogen.");
  
  AddDetail(({"dreck","dreckschicht","schicht"}),
	    "Eine dicke Schicht aus undefinierbarem Dreck bedeckt hier "
	    "den Boden. An einigen Stellen wurde der Dreck jedoch "
	    "abgekratzt und man erkennt die darunterliegenden Steinbloecke.");
  
  AddDetail(({"decke","steindecke"}),
	    "Die steinerne Decke ueber Dir ist schwarz.\n"
	    "Du kannst nichts Interessantes entdecken, einfach nur schwarz.");
  
  AddDetail(({"interessante","interessantes"}),
	    "Das einzig interessante hier im Erdgeschoss ist wohl der "
	    "Podest in dessen Mitte.");
  
  AddDetail(({"fackeln"}),
	    "An den Waenden stecken einige Fackeln in ihren Halterungen. "
	    "Obwohl sie recht hell brennen, schaffen sie es dennoch "
	    "nicht, den Raum genuegend zu erhellen.");
  
  AddDetail(({"halterungen","halter","fackelhalter","fackelhalterungen"}),
	    "Die Fackelhalterungen bestehen aus seltsam geformeten "
	    "Metallbaendern, die mit der Zeit jedoch schon einiges an Rost "
	    "angesetzt haben.");
  
  AddDetail(({"geflecht","baender","metallbaender"}),
	    "Die Metallbaender bilden ein seltsames Geflecht, welches "
	    "wiederrum eine Fackelhalterung bildet.");
  
  AddDetail(({"rost","zeit"}),
	    "Die Fackelhalterungen sind schon ziemlich angerostet.");
  
  AddDetail(({"schlange"}),
	    "Die Steintreppe windet sich wie eine Schlange die Wand entlang "
	    "bis ins oberste Stockwerk.");
  
  AddDetail(({"treppe","steintreppe"}),
	    "Eine schmale steinerne Treppe windet sich die Wand entlang "
	    "hinauf und bildet somit die Verbindung der einzelnen "
	    "Stockwerke. Obwohl sie kein Gelaender hat, scheint es "
	    "dennoch relativ gefahrlos sie hinaufzusteigen.");
  
  AddDetail(({"verbindung"}),
	    "Die Steintreppe bildet die Verbindung zwischen den einzelnen "
	    "Stockwerken.");
  
  AddDetail(({"gelaender","treppengelaender","steintreppengelaender"}),
	    "Die Steintreppe hat kein Gelaender.");
  
  AddDetail(({"steinwand","steinwaende","wand","waende"}),
	    "Die steinernen Waende werden fast vollstaendig von der "
	    "Treppe eingenommen. Einige Fackeln sind in Nischen aufgehaengt, "
	    "um das Erdgeschoss zu erhellen.");
  
  AddDetail(({"wandnische","wandnischen","nischen","nische"}),
	    "Die Nischen in den Waenden werden durch Fackeln erleuchtet.");
  
  AddDetail(({"mitte","geschossmitte","erdgeschossmitte","raummitte"}),
	    "In der Mitte des Raumes befindet sich ein seltsames Podest, "
	    "auf dem sich eine glaeserne Kugel zu befinden scheint.");
  
  AddDetail(({"podest","marmorpodest","steinpodest"}),
	    "Ein Podest aus hellem, fast schon weissem, Marmor steht genau "
	    "in der Mitte des Raumes. Es ist komplett von dornenbesetzten "
	    "Ranken umgeben, die am oberen Ende eine glaeserne Kugel "
	    "einschliessen.\n"
	    "Ploetzlich bemerkst Du, dass sich hinter dem Podest ein "
	    "Abgang zu befinden scheint. Seltsam, dass er Dir nicht schon "
	    "vorher aufgefallen ist.");
  
  AddDetail(({"abgang"}),
	    "Tatsaechlich, hinter dem Podest befindet sich ein dunkler "
	    "Abgang.\nWohin er Dich wohl fuehrt, wenn Du nach unten gehst?!");
  
  AddDetail(({"ende","oberes ende"}),
	    "Am oberen Ende des Podests befindet sich eine glaeserne Kugel.");
  
  AddDetail(({"unteres ende","untere ende"}),
	    "Das untere Ende des Podests ist komplett von Ranken umgeben und "
	    "somit unerkennbar.");
  
  AddDetail(({"marmor"}),
	    "Das Podest scheint aus einem sehr hellen Marmor zu bestehen, "
	    "allerdings ist das auch das einzige Besondere an dem Podest.");
  
  AddDetail(({"besondere","besonderes"}),
	    "Das einzig Besondere hier, scheint die glaeserne Kugel auf dem "
	    "Podest zu sein.");
  
  AddDetail(({"ranken","ranke","pflanze"}),
	    "Eine Dir unbekannte Pflanze hat ihre dornigen Ranken rund um den "
	    "Marmorpodest geschlungen.\nWas sie wohl beschuetzt?");
  
  AddDetail(({"dorn","dornen"}),
	    "Die Dornen sehen schmerzhaft spitz aus!!");
  
  AddDetail(({"tuer","ausgang","eingang"}),
	    "Durch die Tuer hinter Dir gelangst Du wieder hinaus aus dem "
	    "Turm.");
  
  AddSpecialDetail(({"kugel","glaskugel","inneren","inneres","kugelinneres",
		       "glaeserne kugel"}), "kugel_det");
  
  AddSpecialDetail(({"mechanismus","schiebemechanismus"}), "mechanismus_det");
  
  AddSound(DEFAULT_SOUND,
	   "Ein seltsames Surren umgibt Dich.");

  AddSound(({"geraeusch","surren"}),
	   "Du kannst das Surren nicht genau lokalisieren...");

  AddSmell(DEFAULT_SMELL,
	   "Von der Dreckschicht auf dem Boden scheint ein extremer "
	   "Gestank aufzusteigen.");

  AddSmell(({"gestank","dreck","dreckschicht","boden","schicht"}),
	   "Dir wird uebel bei dem Gestank!\n"
	   "Du faengst an zu wuergen.");

  AddExit("tuer", "aus dem Turm raus#" ROOM "turm_anteroom");
  AddExit(({"hinunter","unten"}), "den Abgang hinab#" ROOM "turm_orakel");
  AddExit("hinauf", 
	  ([EX_DEST: ROOM "turm_first",
	  EX_MSG: "die Treppe hinauf",
	  EX_TESTFUNC: "nach_oben"]));
  
  SetProp(P_HIDE_EXITS, ({"unten","hinunter"}));
  
  touched=0;
  
  AddCmd(({"drueck","druecke"}), "kugel_druecken");
  
  Licht("duester");
  Umgebung("kuehl", TT_HOUSE, 1);
  
  AddItem(NPC "riesenspinne", REFRESH_DESTRUCT, ([P_AGGRESSIVE:0]));
}

string kugel_det()
{
  if(touched)
    return BS("Eine seltsame glaeserne Kugel befindet sich vor Dir auf dem "
	      "Podest. In ihrem Inneren leuchtet ein merkwuerdiges Licht, "
	      "welches im Moment jedoch etwas geschwaecht zu sein scheint...");

  return BS("Eine seltsame glaeserne Kugel befindet sich vor Dir auf dem "
	    "Podest. In ihrem Inneren leuchtet recht stark ein merkwuerdiges "
	    "Licht, welches nur magischen Ursprung haben kann. Unter der "
	    "Kugel bemerkst Du einen Mechanismus...");
}

string mechanismus_det()
{
  if(touched)
    return BS("Die Kugel wurde heruntergedrueckt und verdeckt somit den "
	      "Mechanismus komplett.");
  
  return BS("Unter der Kugel befindet sich ein Schiebemechanismus, der nach "
	    "Oben oder nach Unten funktioniert. Die Kugel befindet sich jetzt "
	    "Oben, vielleicht kann man sie ja runterdruecken?");
}

int nach_oben()
{
  if(!TP) return 0;
  
  if(present("\nprotheg_turm_spinne"))
    return write(BS("Du kommst an der Riesenspinne nicht vorbei!")), 0;
  
  if(!touched)
    return write(BS("Als Du die Steintreppe hochsteigen willst, bemerkst Du, "
		    "dass die Stufen nach unten geklappt sind und somit der "
		    "Weg nach oben verwehrt wird.")+
		 (TP->QueryProp(P_RACE)=="Fee" ? 
		  BS("Dir als Fee ist das jedoch ziemlich egal, denn Du "
		     "kannst ja hinauffliegen.")+
		  BS("Du bist schon fast oben angelangt, da schnalzt Dir "
		     "etwas ins Gesicht und Du rutschst den ganzen Weg "
		     "wieder hinunter.") : "")), 0;
  
  return 1;
}

nosave int kugel_druecken(string str)
{
  notify_fail(BS("Was willst Du denn druecken?"));
  if(!str) return 0;
  
  if(member(({"kugel","glaskugel","glaeserne kugel","kugel runter",
		"kugel hinunter","glaskugel runter","glaskugel hinunter",
		"glaeserne kugel runter","glaeserne kugel hinunter"}), 
	    str)==-1) return 0;
  
  if(touched)
    return write(BS("Die glaeserner Kugel bewegt sich kein Stueck. Scheinbar "
		    "ist sie bereits eingerastet.")), 1;
  
  if(TP->QueryAttribute(A_DEX) < 2+random(5))
    {
      write(BS("Ungeschickt wie Du bist, rutschen Deine Haende ab...")+
	    BS("Du stichst Dich an den Dornen der Pflanze."));
      
      TP->AddHp(-1-random(2));
      
      return 1;
    }
  
  write(BS("Du drueckst die glaeserne Kugel hinunter...")+
	BS("Mit einem leisen Klick rastet die Kugel ein."));
  
  tell_room(ME,
	    BS(TP->Name(WER)+" fummelt am Podest in der Raummitte herum..."),
	    ({TP}));
  
  tell_room(ME,
	    BS("Ploetzlich hoerst Du ein Rumpeln von der Steintreppe her.")+
	    BS("Der Weg scheint nun frei zu sein."));
  
  touched=time();

  return 1;
}

void reset()
{
  ::reset();
  
  if((touched) && (time() > touched+900))
    {
      tell_room(ME,
		BS("Ploetzlich hoerst Du ein Rumpeln von der Steintreppe "
		   "her."));
      touched=0;
    }
}
