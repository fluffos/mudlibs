/*
**  Der Turm eines Schwarzmagiers - 1. Stock
**
**  2003-13-01  PROtheG  Blabla, Details
**  
*/

#pragma strong_types;

#include "../def.h"

inherit MOST "std_room";

nosave int fackeln, activated;

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Schwarzmagierturm (1. Stock)");
  SetProp(P_INT_LONG,
          BS("Du befindest Dich nun im 1. Stock des Turmes. Die Waende werden "
	     "von einer gewaltigen Steintreppe eingenommen, die sich, wie "
	     "eine gewaltige Schlange spiralfoermig nach oben schlaengelt. "
	     "Einige Fackeln versuchen den Raum zu erhellen, doch er wirkt "
	     "trotzdem sehr duester und gefaehrlich.")+
	  BS("In der Mitte des Raumes befindet sich ein gewaltiger Haufen "
	     "von undefinierbarem Zeugs..."));
  
  AddDetail(({"raum"}),
	    QueryProp(P_INT_LONG));
  
  AddDetail(({"magier","schwarzmagier"}),
	    "Er scheint nicht hier zu sein, vielleicht ist er weiter oben.");
  
  AddDetail(({"turm","magierturm","schwarzmagierturm"}),
	    "Du befindest Dich hier im 1. Stock des Turmes, wie viele "
	    "Stockwerke er hat und was Dich weiter oben erwartet kannst Du "
	    "von hier aus nicht sagen.");
  
  AddDetail(({"stock","stockwerk","stoecke","stockwerke"}),
	    "Das hier ist der 1. Stock");
  
  AddDetail(({"stein","steine"}),
	    "Alles hier scheint irgendwie aus Steinen zu bestehen.");
  
  AddDetail(({"ritze","ritzen","fugen","fuge","spalte","spalten"}),
	    "Der Steinboden ist uebersaeht damit.");
  
  AddDetail(({"steinboden","boden"}),
	    "Der steinerne Boden ist total sauber, Du kannst jede einzelne "
	    "Ritze im Stein erkennen.");
  
  AddDetail(({"decke","steindecke"}),
	    "Die steinerne Decke ueber Dir ist schwarz.\n"
	    "Du kannst nichts Interessantes entdecken, einfach nur schwarz.");
  
  AddDetail(({"interessante","interessantes"}),
	    "Interessant findest Du hier nicht wirklich was, maximal dieser "
	    "seltsame Haufen Zeugs in der Raummitte.");
  
  AddSpecialDetail(({"fackeln"}), "fackeln_det");
  
  AddDetail(({"halterungen","halter","fackelhalter","fackelhalterungen"}),
	    "Die Fackelhalterungen bestehen aus einem primitiven, "
	    "schmucklos gehaltenen Metallgeflecht. Sie sind bereits etwas "
	    "angerostet.");
  
  AddDetail(({"geflecht","metallgeflecht"}),
	    "Das schmucklose und schon leicht angerostete Metallgeflecht "
	    "haelt eine leicht flackernde Fackel.");
  
  AddDetail(({"rost","zeit"}),
	    "Die Fackelhalterungen sind schon ziemlich angerostet. An einigen "
	    "Stellen befinden sich aber recht merkwuerdige Kratzspuren.");
  
  AddDetail(({"spuren","kratzspuren"}),
	    "Seltsam die Kratzspuren deuten darauf hin, dass die "
	    "Fackelhalterungen einmal seitlich gestanden haben.");
  
  AddDetail(({"schlange"}),
	    "Die Steintreppe windet sich wie eine Schlange die Wand entlang "
	    "bis ins oberste Stockwerk.");
  
  AddDetail(({"stufen","stufe","treppe","steintreppe"}),
	    "Eine schmale steinerne Treppe windet sich die Wand entlang "
	    "hinauf und bildet somit die Verbindung der einzelnen "
	    "Stockwerke. Obwohl sie kein Gelaender hat, scheint es "
	    "dennoch relativ gefahrlos sie hinaufzusteigen.");
  
  AddDetail(({"verbindung"}),
	    "Die Steintreppe bildet die Verbindung zwischen den einzelnen "
	    "Stockwerken.");
  
  AddDetail(({"gelaender","treppengelaender","steintreppengelaender"}),
	    "Die Steintreppe hat kein Gelaender.");
  
  AddDetail(({"steinwand","steinwaende","wand","waende"}),
	    "Die steinernen Waende werden fast vollstaendig von der "
	    "Treppe eingenommen. Zwei Fackeln versuchen den 1. Stock zu "
	    "erhellen.");
  
  AddDetail(({"mitte","geschossmitte","erdgeschossmitte","raummitte"}),
	    "In der Mitte des Raumes befindet sich ein grosser Haufen "
	    "seltsamen Zeugs...");
  
  AddDetail(({"haufen"}),
	    "Ein grosser, dunkler Haufen voll seltsamem, undefinierbaren "
	    "Zeugs. Du bist Dir ziemlich sicher, dass Du nicht wissen willst, "
	    "was das ist.");
  
  AddDetail(({"zeugs","zeug"}),
	    "Du wuehlst kurz in dem Haufen und findest alte, verrottete "
	    "Ruestungen teilweise noch mit Inhalt *wuerg* und einige "
	    "zerbrochene und somit wertlose Waffen.");
  
  AddDetail(({"inhalt"}),
	    "Du schauderst.");
  
  AddDetail(({"waffe","waffen"}),
	    "Die sind alle zerbrochen und wertlos...");
  
  AddDetail(({"ruestung","ruestungen"}),
	    "Die sind alle schon alt und verrottet, teilweise vergammelt "
	    "noch der Inhalt darin.");
  
  AddSound(DEFAULT_SOUND,
	   "Ein seltsames Surren umgibt Dich.");

  AddSound(({"geraeusch","surren"}),
	   "Du kannst das Surren nicht genau lokalisieren...");

  AddSmell(DEFAULT_SMELL,
	   "Von dem Haufen Zeugs auf dem Boden scheint ein extremer "
	   "Gestank aufzusteigen.");

  AddSmell(({"gestank","dreck","dreckschicht","boden","schicht"}),
	   "Dir wird uebel bei dem Gestank!\n"
	   "Du faengst an zu wuergen.");

  AddExit("hinunter", "die Treppe hinunter#" ROOM "turm_base");
  AddExit("hinauf", 
	  ([EX_DEST: ROOM "turm_second",
	  EX_MSG: "die Treppe hinauf",
	  EX_TESTFUNC: "nach_oben"]));
  
  AddCmd(({"dreh","drehe"}), "noturn");
  AddCmd(({"zieh","ziehe"}), "fackel_ziehen");
  
  Licht("duester");
  Umgebung("kuehl", TT_HOUSE, 1);

  fackeln=0;
  activated=0;
  
  AddItem(NPC "riesenspinne", REFRESH_DESTRUCT);
  AddItem(NPC "riesenspinne", REFRESH_DESTRUCT);
  AddItem(NPC "riesenspinne", REFRESH_DESTRUCT);
}

string fackeln_det()
{
  string ret;

  ret="An der Wand, die nicht von der Treppe eingenommen wird, "
    "befinden sich zwei Fackelhalterungen mit leicht flackernden "
    "Fackeln.";

  if(!fackeln)
    return BS(ret);
  else
    return BS(ret)+
      (fackeln==1 ? 
       BS("Eine der Fackeln haengt schief.") : 
       BS("Beide Fackeln haengen schief."));
}

int nach_oben()
{
  if(!TP) return 0;
  
  if(present("\nprotheg_turm_spinne"))
    return write(BS("Du kommst an der Riesenspinne nicht vorbei!")), 0;
  
  if(fackeln < 2)
    return write(BS("Als Du die Steintreppe hochsteigen willst, bemerkst Du, "
		    "dass die Stufen nach unten geklappt sind und somit der "
		    "Weg nach oben verwehrt wird.")+
		 (TP->QueryProp(P_RACE)=="Fee" ? 
		  BS("Dir als Fee ist das jedoch ziemlich egal, denn Du "
		     "kannst ja hinauffliegen.")+
		  BS("Du bist schon fast oben angelangt, da schnalzt Dir "
		     "etwas ins Gesicht und Du rutschst den ganzen Weg "
		     "wieder hinunter.") : "")+
		 (fackeln==1 ? 
		  BS("Du hast das Gefuehl, noch etwas vergessen zu haben...") :
		  "")), 0;
  
  return 1;
}

nosave int noturn(string str)
{
  if(!str) return 0;
  
  if(strstr(str, "fackel")!=-1)
    return write(BS("Die Fackel laesst sich nicht drehen, aber vielleicht "
		    "ziehen?")), 1;
  
  return 0;
}

nosave int fackel_ziehen(string str)
{
  notify_fail(BS("Woran willst Du denn ziehen?"));
  if(!str) return 0;
  
  if(str!="fackel" && str!= "fackeln" && 
     str!="halterung" && str!="an halterung" &&
     str!="fackelhalterung" && str!="an fackelhalterung")
    return 0;
  
  if(activated)
    return write(BS("Beide Fackeln haengen bereits schief!")), 1;
  
  if(present("\nprotheg_turm_spinne"))
    return write(BS("Die Riesenspinne stoesst Dich brutal zurueck.")), 1;
  
  if(TP->QueryAttribute(A_STR) < 2+random(5))
    return write(BS("Du schaffst es nicht genuegend Kraft aufzubringen...")+
		 BS("Vielleicht klappts beim naechsten Versuch.")), 1;
  
  if(!fackeln)
    {
      write(BS("Du ziehst an einer der Fackeln, worauf die Fackelhalterung "
	       "ein leises Quietschen von sich gibt und die Fackel "
	       "anschliessend schief haengt."));

      tell_room(ME, BS(TPN+" fummelt an einer der Fackeln herum."), ({TP}));
      
      fackeln++;
      
      return 1;
    }
  
  write(BS("Du ziehst an der geraden Fackel, worauf die Fackelhalterung "
	   "ein leises Quietschen von sich gibt und nun auch die zweite "
	   "Fackel schief haengt."));

  tell_room(ME, BS(TPN+" fummelt an einer der Fackeln herum."), ({TP}));

  tell_room(ME, BS("Du hoerst ein leises Klick."));
  
  activated=time();
  fackeln++;
  
  return 1;
}

void reset()
{
  ::reset();
  
  if((fackeln) && (time() > activated+900))
    {
      tell_room(ME,
		BS("Ploetzlich hoerst Du ein Rumpeln von den Waenden "
		   "her."));
      fackeln=0;
      activated=0;
    }
}
