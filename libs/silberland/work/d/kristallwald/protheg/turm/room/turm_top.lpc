/*
**  Der Turm eines Schwarzmagiers - Labor
**
**  2002-01-10  PROtheG  Blabla, Details
**  
*/

#pragma strong_types;

#include "../def.h"

inherit MOST "std_room";

nosave int window_closed;

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Schwarzmagierturm (Labor)");
  SetProp(P_INT_LONG,
          BS("Du hast nun das oberste Stockwerk des Turmes betreten. "
	     "Der Raum scheint eine Bibliothek zu sein, denn die Waende "
	     "sind vollkommen von uebervollen Buecherregalen eingenommen. "
	     "In der Mitte des Raumes befindet sich ein massiver Tisch, der "
	     "ueber und ueber mit allerlei seltsamen Apparaturen bestueckt "
	     "ist."));
  
  AddDetail(({"raum","geschoss","obergeschoss","labor"}),
	    QueryProp(P_INT_LONG));
  
  AddDetail(({"bibliothek","labor"}),
	    "Die vielen Buecherregale lassen den Raum wie eine Bibliothek "
	    "aussehen, mit dem grossen Holztisch in der Mitte koennte es "
	    "sich aber auch um ein Labor handeln.");
  
  AddDetail(({"tapete"}),
	    "Du kannst nicht erkennen, ob sich hinter den Buecherregalen "
	    "eine Tapete befindet.");
  
  AddDetail(({"regal","regale","buecherregal","buecherregale"}),
	    "Die Waende sind voll mit Buecherregalen, welche wiederum "
	    "uebervoll mit Buechern beladen sind. Es sind so viele, dass "
	    "Du nicht weisst wo du anfangen sollst...");
  
  AddDetail(({"buch","buecher"}),
	    "Buecher! Buecher! Die Regale sind alle voll damit. Leider "
	    "scheinen sie alle in einer Dir unbekannten Sprache verfasst "
	    "zu sein, denn so sehr Du auch suchst, Du findest keinen Titel, "
	    "den Du verstehst! Wahrscheinlich ist das eine geheime Schrift, "
	    "die nur die Schwarzmagier lesen koennen, oder die Schrift ist "
	    "magisch versiegelt worden, sodass sie keiner lesen kann...");

  AddDetail(({"sprache","schrift"}),
	    "So sehr Du Dich auch anstrengst, Du kannst sie nicht "
	    "entziffern...");
  
  AddDetail(({"titel","buchtitel"}),
	    "Die einzelnen Buchtitel sind in einer, Dir unbekannten "
	    "Sprache verfasst...");
  
  AddDetail(({"tisch","holztisch"}),
	    "Die Mitte des Raumes wird von einem gewaltigen Holztisch "
	    "eingenommen, der voll mit den seltsamsten Apparaturen "
	    "bestueckt ist.");
  
  AddDetail(({"apparatur","apparaturen"}),
	    "Allerlei seltsame Apparaturen, die hauptsaechlich aus "
	    "halbgefuellten Glaskolben, Schlaeuchen und glaesernen "
	    "Spiralen zu bestehen scheinen. Hie und da koechelt eine "
	    "Fluessigkeit ueber einer kleinen Flamme und aus einer "
	    "der Spiralen dampft es heraus...");
  
  AddDetail(({"experiment","experimente"}),
	    "Du bist Dir nicht sicher, ob Du wissen willst, was fuer "
	    "Experimente hier vor sich hin koecheln...");
  
  AddDetail(({"flamme"}),
	    "Einige der Kolben werden ueber einer kleinen Flamme erhitzt.");
  
  AddDetail(({"spiralen","glasspiralen"}),
	    "Scheinbar kondensiert der Dampf in den Glasspiralen und "
	    "tropft anschliessend in irgendwelche Auffangbehaelter.");
  
  AddDetail(({"schlauch","schlaeuche"}),
	    "Alle Glaskolben und Glasspiralen sind ueber Schlaeuche "
	    "miteinander verbunden.");
  
  AddDetail(({"behaelter","auffangbehaelter"}),
	    "In denen sammeln sich die ganzen kondensierten Fluessigkeiten.");
  
  AddDetail(({"dampf"}),
	    "Der Dampf sammelt sich in den Spiralen und kondensiert dort.");
  
  AddDetail(({"kolben","glaskolben"}),
	    "Die Glaskolben sind teilweise gefuellt und werden von unten "
	    "mit einer Flamme erhitzt.");
  
  AddDetail(({"fluessigkeit"}),
	    "Viele bunte Fluessigkeiten fliessen in diesen Apparaturen.");
  
  AddDetail(({"kondensat"}),
	    "Du willst lieber nicht wissen, was das fuer Fluessigkeiten sind, "
	    "die da kondensieren...");
  
  AddDetail(({"teppich"}),
	    "Ein sehr dicker und dunkler, aber doch auch sehr gemuetlich "
	    "aussehender Teppich liegt auf dem Boden ausgebreitet. An "
	    "einigen Stellen, speziell in der Naehe des Holztisches findest "
	    "Du einige dunkle Flecken, vermutlich Brandflecken.");
  
  AddDetail(({"stellen","stelle","naehe"}),
	    "Die Flecken treten hauptsaechlich in der Naehe des Holztisches "
	    "auf.");
  
  AddDetail(({"flecken","brand","brandflecken","saeureflecken"}),
	    "Der Teppich ist in der Naehe des Tisches mit Flecken uebersaeht. "
	    "Du vermutest, dass es sich dabei um Brand- oder Saeureflecken "
	    "handelt, die von den Experimenten stammen, die der Schwarzmagier "
	    "auf dem Tisch gemacht hat.");
  
  AddDetail(({"magier","schwarzmagier"}),
	    "Er scheint nicht hier zu sein...");
  
  AddDetail(({"turm","magierturm","schwarzmagierturm"}),
	    "Du befindest Dich hier im obersten Geschoss des Turmes. Da von "
	    "dem Raum aus keine sichtbare Treppe nach oben weiterfuehrt, "
	    "nimmst Du an, dass es der oberste Raum ist.");
  
  AddDetail(({"stock","stockwerk","stoecke","stockwerke"}),
	    "Das hier ist das oberste Geschoss.");

  AddDetail(({"steinboden","boden"}),
	    "Der Boden ist hier mit einem dicken, dunklen Teppich ueberzogen, "
	    "der den Raum nicht ganz so kuehl wirken laesst. An einigen "
	    "Stellen weist der Teppich jedoch einige Brandflecken auf.");
  
  AddDetail(({"decke","steindecke"}),
	    "Die steinerne Decke ueber Dir ist schwarz.\n"
	    "Du kannst nichts Interessantes entdecken, einfach nur schwarz.");
  
  AddDetail(({"interessante","interessantes"}),
	    "Es gibt hier viel Interessanteres als die Decke...");
  
  AddDetail(({"interessanteres"}),
	    "Schau Dich doch einmal um!");
  
  AddDetail(({"waende","wand"}),
	    "Die Waende sind vollkommen von Buecherregalen verdeckt, man "
	    "kann nichtmal erkennen ob die Wand eine Tapete hat, oder ob "
	    "sie einfach kahl ist. Lediglich ein grosses Fenster ist "
	    "freigeblieben.");
  
  AddDetail(({"ende","oberes ende","treppenende","steintreppenende","treppe",
		"steintreppe"}),
	    "Von hier aus erkennst Du nur noch das obere Ende der "
	    "Steintreppe. ");
  
  AddDetail(({"gelaender","treppengelaender","steintreppengelaender"}),
	    "Die Steintreppe hat kein Gelaender.");
  
  AddDetail(({"mitte","geschossmitte","obergeschossmitte","raummitte"}),
	    "In der Mitte des Raumes befindet sich ein massiver Holztisch, "
	    "der mit allerlei seltsamen Apparaturen beladen ist...");
  
  AddDetail(({"tuer","ausgang","eingang"}),
	    "Durch die Tuer hinter Dir gelangst Du wieder hinunter in den "
	    "2. Stock.");
  
  AddSpecialDetail(({"fenster","turmfenster"}), "fenster_det");
  
  AddSound(DEFAULT_SOUND,
	   "Hier herrscht eine angenehme Stille.");

  AddSound(({"stille","gurgeln","tisch"}),
	   "Du vernimmst ein leises Gurgeln vom Tisch her. Vermutlich "
	   "ein paar koechelnde Experimente.");
  
  AddSmell(DEFAULT_SMELL,
	   "Von den seltsamen Apparaturen auf dem Tisch weht ein recht "
	   "eigenartiger Geruch herueber...");

  AddSmell(({"chemikalien","gestank","geruch","experiment","experimente"}),
 	   "Ein sehr seltsamer Gestank nach Chemikalien umfaengt Dich...");

  AddExit("fenster", 
	  ([EX_DEST:ROOM "turm_anteroom",
	    EX_MSG: "aus dem Fenster",
	    EX_TESTFUNC: "fenster_offen",
	    EX_FUNC: "fenster_sprung"]));
  
  AddExit("hinunter", ROOM "turm_second");
  
  AddCmd(CMD_OEFFNEN, "fenster_oeffnen");
  AddCmd(({"schliess","schliesse","verschliess","verschliesse"}), 
	 "fenster_schliessen");
  
  window_closed=0;
  
  Licht("duester");
  Umgebung("warm", TT_HOUSE, 1);
  
  AddItem(NPC "schwarzmagier", REFRESH_DESTRUCT);
}

string fenster_det()
{
  if(window_closed)
    return "Ein hoelzernes Turmfenster. Es ist geschlossen.\n";
  
  return "Das Turmfenster ist weit geoeffnet und du siehst, wie sich rings "
    "um den Turm der Kristallwald erstreckt. Du siehst kurz hinunter und "
    "schauderst, weil da geht es weit in die Tiefe...\n";
}

int fenster_offen()
{
  if(window_closed)
    return write(BS("Aber das Turmfenster ist doch fest verschlossen!")), 0;
  
  return 1;
}

int fenster_sprung()
{
  if(!TP) return 0;
  
  if(TP->QueryProp(P_RACE)=="Fee")
    {
      write("\n\n\n\n\n"+
	    BS("Nichts boeses ahnend flatterst Du aus dem Fenster, als Dich "
	       "ploetzlich von Oben etwas erfasst und voll nach unten "
	       "drueckt...")+
	    "\n\n\n"+
	    BS("Das letzte was Du hoerst, ist das Knirschen Deiner Knochen..."));
      SetProp(P_KILL_NAME, "*Klatsch*");
      
      catch(call_other(ROOM "turm_anteroom", "???"));
      
      tell_room(find_object(ROOM "turm_anteroom"),
		BS("Mit einem grauenerregenden Geraeusch schlaegt "+
		   TP->name(WER)+"neben Dir auf dem Boden auf..."));
      
      TP->move(ROOM "turm_anteroom", M_NOCHECK|M_SILENT|M_NO_SHOW);
      
      TP->do_damage(200000);
      
      return 0;
    }

  write("\n\n\n\n"+
	BS("Du Trottel springst doch tatsaechlich aus dem Fenster!!!")+"\n\n"+
	BS("Du bruellst: UUUUUAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA..."));
  
  SetProp(P_KILL_NAME, "Der Sturz aus dem Fenster");
  
  catch(call_other(ROOM "turm_anteroom", "???"));
  
  tell_room(find_object(ROOM "turm_anteroom"),
	    BS("Mit einem grauenerregenden Geraeusch schlaegt "+TP->name(WER)+
	       "neben Dir auf dem Boden auf..."));
  
  TP->move(ROOM "turm_anteroom", M_NOCHECK|M_SILENT|M_NO_SHOW);
  
  TP->do_damage(200000);
  
  return 0;
}

nosave int fenster_schliessen(string str)
{
  notify_fail(BS("Was willst Du denn verschliessen?"));
  if(!str) return 0;
  
  if(str!="fenster" && str!="turmfenster")
    return 0;
  
  if(window_closed)
    return write(BS("Aber das Fenster ist doch geschlossen?!")), 1;
  
  TP->do_exhaust(50, 1);
  
  if(TP->QueryAttribute(A_STR) < 2+random(5))
    return write(BS("Du schaffst es nicht, genug Kraft dafuer aufzubringen! "
		    "Vielleicht klappts beim naechsten Versuch...")), 1;
  
  write(BS("Mit einem gekonnten Wink verschliesst Du das Fenster."));
  
  tell_room(ME, BS(TPN+" verschliesst das Fenster."), ({TP}));
  
  RemoveExit("fenster");
  
  window_closed=1;
  
  return 1;
}

nosave int fenster_oeffnen(string str)
{
  notify_fail(BS("Was willst Du denn oeffnen?"));
  if(!str) return 0;
  
  if(str!="fenster" && str!="turmfenster")
    return 0;
  
  if(!window_closed)
    return write(BS("Aber das Fenster ist doch bereits offen?!")), 1;
  
  TP->do_exhaust(50, 1);
  
  if(TP->QueryAttribute(A_STR) < 2+random(5))
    return write(BS("Du schaffst es nicht, genug Kraft dafuer aufzubringen! "
		    "Vielleicht klappts beim naechsten Versuch...")), 1;
  
  write(BS("Mit einem kraeftigen Ruck oeffnest Du das Fenster."));
  
  tell_room(ME, BS(TPN+" oeffnet das Fenster."), ({TP}));
  
  AddExit("fenster", 
	  ([EX_DEST:ROOM "turm_anteroom",
	    EX_MSG: "aus dem Fenster",
	    EX_TESTFUNC: "fenster_offen",
	    EX_FUNC: "fenster_sprung"]));
  
  window_closed=0;
  
  return 1;
}

void reset()
{
  ::reset();
  
  if((window_closed) && (time() > window_closed+900))
    {
      tell_room(ME,
		BS("Ploetzlich ruckelt ein Windzug an dem Fenster und "
		   "oeffnet es ruckartig..."));

      AddExit("fenster", 
	      ([EX_DEST:ROOM "turm_anteroom",
		EX_MSG: "aus dem Fenster",
		EX_TESTFUNC: "fenster_offen",
		EX_FUNC: "fenster_sprung"]));
      
      window_closed=0;
    }
}
