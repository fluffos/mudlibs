/*
**  Der Turm eines Schwarzmagiers - 2. Stock
**
**  2003-13-01  PROtheG  Blabla, Details
**  
*/

#pragma strong_types;

#include "../def.h"

inherit MOST "std_room";

nosave int swinging;

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Schwarzmagierturm (2. Stock)");
  SetProp(P_INT_LONG,
          BS("Du befindest Dich nun im 2. Stock des Turmes wieder. "
	     "Die Waende werden von einer gewaltigen Steintreppe eingenommen, "
	     "die sich, wie eine gewaltige Schlange spiralfoermig nach oben "
	     "schlaengelt. Der Raum scheint ein einziger Spiegel zu sein. "
	     "Ober und unter Dir spiegeln sich der Boden und die Decke bis "
	     "in die Unendlichkeit und projizieren die seltsamsten Bilder.")+
	  BS("Die Raummitte wird von einem grossen Pendel eingenommen."));
  
  AddDetail(({"raum"}),
	    QueryProp(P_INT_LONG));
  
  AddDetail(({"spiegel","verspiegelung","spiegeln","verspiegelungen"}),
	    "Es scheint, als wuerde der gesamte Raum aus Spiegeln bestehen. "
	    "Ueberall wo Du hinsiehst, siehst Du Dein Gesicht. ;-)");
  
  AddDetail(({"unendlichkeit"}),
	    "Der Raum wirkt durch die Spiegel, als waere er unendlich hoch "
	    "und unendlich tief.");
  
  AddDetail(({"gesicht"}),
	    "Ist es nicht wunderschoen? Dein Gesicht?");
  
  AddDetail(({"bild","bilder"}),
	    "Die Bilder wirken alle recht verwirrend auf Dich...");
  
  AddDetail(({"magier","schwarzmagier"}),
	    "Er scheint nicht hier zu sein, vielleicht ist er weiter oben.");
  
  AddDetail(({"turm","magierturm","schwarzmagierturm"}),
	    "Du befindest Dich hier im 2. Stock des Turmes, wie viele "
	    "Stockwerke er hat und was Dich weiter oben erwartet kannst Du "
	    "von hier aus nicht sagen.");
  
  AddDetail(({"stock","stockwerk","stoecke","stockwerke"}),
	    "Das hier ist der 2. Stock.");

  AddDetail(({"spiegelboden","boden"}),
	    "Der Boden ist total verspiegelt. Du bist Dir nicht sicher, ob "
	    "Du nun den Boden oder ein Abbild der Decke siehst.");
  
  AddDetail(({"spiegeldecke","decke"}),
	    "Die Decke ist total verspiegelt. Du bist Dir nicht sicher, ob "
	    "Du nun die Decke oder ein Abbild des Bodens siehst.");
  
  AddDetail(({"abbild"}),
	    "Ist es nun echt oder nur ein Abbild?");
  
  AddDetail(({"schlange"}),
	    "Die Steintreppe windet sich wie eine Schlange die Wand entlang "
	    "bis ins oberste Stockwerk.");
  
  AddDetail(({"treppe","steintreppe"}),
	    "Eine schmale steinerne Treppe windet sich die Wand entlang "
	    "hinauf und bildet somit die Verbindung der einzelnen "
	    "Stockwerke. Obwohl sie kein Gelaender hat, scheint es "
	    "dennoch relativ gefahrlos sie hinaufzusteigen.");
  
  AddDetail(({"verbindung"}),
	    "Die Steintreppe bildet die Verbindung zwischen den einzelnen "
	    "Stockwerken.");
  
  AddDetail(({"gelaender","treppengelaender","steintreppengelaender"}),
	    "Die Steintreppe hat kein Gelaender.");
  
  AddDetail(({"spiegelwand","spiegelwaende","wand","waende"}),
	    "Die verspiegelten Waende lassen die Steintreppe fast unsichtbar "
	    "erscheinen.");

  AddDetail(({"mitte","geschossmitte","stockmitte","raummitte"}),
	    "In der Mitte des Raumes befindet sich ein recht grosses Pendel.");
  
  AddDetail(({"weg"}), 
	    "Der Weg nach oben wird durch ein Kraftfeld blockiert.");
  
  AddDetail(({"seil"}),
	    "Das Seil haelt ein grosses, steinernes Pendel. Wie es befestigt "
	    "ist, kannst Du nicht sehen, da das Seil ploetzlich in der Decke "
	    "zu verschwinden scheint.");
  
  AddDetail(({"stamm","pendelstamm","steinpendelstamm"}),
	    "Der zylinderfoermige Stamm des Steinpendels laeuft unten in "
	    "eine kegelfoermige Spitze ueber und ist oben an einem Seil "
	    "befestigt.");
  
  AddDetail(({"spitze","pendelspitze","steinpendelspitze"}),
	    "Die kegelfoermige Spitze des Pendels zeigt nach unten, aber sie "
	    "scheint keinen bestimmten Punkt anzuvisieren.");
  
  AddDetail(({"punkt"}),
	    "Du kannst keinen erkennen.");
  
  AddSpecialDetail(({"kraftfeld","feld", "tuer"}), "kraftfeld_det");
  AddSpecialDetail(({"pendel","steinpendel"}), "pendel_det");
  
  AddSound(DEFAULT_SOUND,
	   "Ein seltsames Surren umgibt Dich.");
  
  AddSound(({"geraeusch","surren"}),
	   "Du kannst das Surren nicht genau lokalisieren...");
  
  AddSmell(({"nichts",DEFAULT_SMELL}),
	   "Hier riecht es total nach... aeh... Nichts!");

  AddExit("hinunter", "die Treppe hinunter#" ROOM "turm_first");
  AddExit("hinauf", 
	  ([EX_DEST: ROOM "turm_top",
	  EX_MSG: "die Treppe hinauf",
	  EX_TESTFUNC: "nach_oben"]));
  
  AddCmd(({"schwing","schwinge"}), "pendel_schwingen");
  AddCmd(({"dreh","drehe"}), "noturn");
  AddCmd(({"zieh","ziehe"}), "nopull");
  AddCmd(({"drueck","druecke"}), "nopush");
  
  
  Licht("hell");
  Umgebung("kuehl", TT_HOUSE, 1);
  
  AddItem(NPC "riesenspinne", REFRESH_DESTRUCT);
  AddItem(NPC "riesenspinne", REFRESH_DESTRUCT);
  AddItem(NPC "riesenspinne", REFRESH_DESTRUCT);
  AddItem(NPC "riesenspinne", REFRESH_DESTRUCT);
  AddItem(NPC "riesenspinne", REFRESH_DESTRUCT);
}

string kraftfeld_det()
{
  return BS("Ein leicht blaeulich schimmerndes Kraftfeld blockiert den Weg "
	    "nach oben.")+
    (swinging ? "Es scheint im Moment jedoch etwas instabil zu sein...\n":"");
}

string pendel_det()
{
  return BS("In der Raummitte ist ein grosses, steinernes Pendel aufgehaengt "
	    "worden. Es besteht aus einem zylinderfoermigen Stamm mit einer "
	    "kegelfoermigen Spitze unten und ist an einem Seil befestigt, "
	    "welches irgendwo oben in der Decke verschwindet.")+
    (swinging ? "Das Pendel schwingt heftig hin und her...\n":"");
}

int nach_oben()
{
  if(!TP) return 0;
  
  if(present("\nprotheg_turm_spinne"))
    return write(BS("Du kommst an der Riesenspinne nicht vorbei!")), 0;
  
  if(!swinging)
    return write(BS("Als Du die Steintreppe hochsteigen willst, bemerkst Du, "
		    "dass die Tuer von einem starken Kraftfeld geschuetzt "
		    "wird.")), 0;
  
  return 1;
}

nosave int noturn(string str)
{
  if(!str) return 0;
  
  if(str=="pendel" || str=="mit pendel" || str=="das pendel" ||
     str=="mit dem pendel")
    return write(BS("Drehen? Ein Pendel?")), 1;
  
  return 0;
}

nosave int nopull(string str)
{
  if(!str) return 0;
  
  if(str=="pendel" || str=="mit pendel" || str=="das pendel" ||
     str=="mit dem pendel")
    return write(BS("Ziehen? Ein Pendel? Warum nicht gleich schwingen?")), 1;
  
  return 0;
}

nosave int nopush(string str)
{
  if(!str) return 0;
  
  if(str=="pendel" || str=="mit pendel" || str=="das pendel" ||
     str=="mit dem pendel")
    return write(BS("Druecken? Ein Pendel? Warum nicht gleich schwingen?")), 1;
  
  return 0;
}


nosave int pendel_schwingen(string str)
{
  notify_fail(BS("Was willst Du denn schwingen?"));
  if(!str) return 0;
  
  if(str!="pendel" && str!="mit pendel" && str!="das pendel" && 
     str!="mit dem pendel")
    return 0;

  if(swinging)
    return write(BS("Du willst das Pendel nicht noch mehr in Schwingung "
		    "versetzen...")), 1;
  
  if(find_call_out("schwingen_voll")!=-1)
    return write(BS("Das Pendel wurde gerade in Schwingung versetzt...")), 1;
  
  TP->do_exhaust(200, 1);
  
  if(TP->QueryAttribute(A_STR) < 2+random(5))
    {
      write(BS("Du kannst nicht genug Kraft aufbringen, um das Pendel "
	       "in Schwingung zu versetzen...")+
	    BS("Beim naechsten Mal schaffst Du es bestimmt!"));
      
      return 1;
    }
  
  write(BS("Du versetzt das Pendel in eine leichte Schwingung..."));
  
  tell_room(ME, BS(TPN+" spielt sich mit dem Pendel herum."), ({TP}));
  
  call_out("schwingen_voll", 2+random(3));

  return 1;
}

void schwingen_voll()
{
  tell_room(ME, BS("Das Pendel schwingt nun heftig hin und her..."));
  swinging=1;

  call_out("schwingen_aus", 5+random(3));
}

void schwingen_aus()
{
  tell_room(ME, BS("Das Pendel hat sich wieder eingependelt und schwingt "
		   "nicht mehr."));
  swinging=0;
}
