/*
**  Der Turm eines Schwarzmagiers - Vorraum
**
**  2002-10-10  PROtheG  Blabla, Details
**  
*/

#pragma strong_types;

#include "../def.h"

inherit MOST "std_room";

#define KW "/d/kristallwald/sargola/wald/room/0802"

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Vor einem hohen Turm");
  SetProp(P_INT_LONG,
	  BS("Ploetzlich befindest Du Dich vor einem gewaltigen, dunklen "
	     "Turm. Seltsam, dass Du den erst jetzt bemerkst, denn so hoch, "
	     "wie er in den Himmel ragt, sollte er eigentlich vom ganzen "
	     "Kristallwald aus sichtbar sein.")+
	  BS("Durch eine Tuer, die von zwei Waechterstatuen bewacht wird, "
	     "kann man in den Turm gelangen.")+
	  BS("Zurueck gelangst Du scheinbar nur wieder ueber den Durchschlupf "
	     "nach Suedosten, da der Platz hier von Straeuchern regelrecht "
	     "umringt ist."));

  AddDetail(({"turm","magierturm","saeule","schwarzmagierturm"}),
	    "Ein gewaltiger Turm steht hier mitten im Wald herum. Du wunderst "
	    "Dich, wie Du ihn nur uebersehen konntest. Er ist wohl magisch "
	    "abgeschirmt. In seine Basis ist eine recht hohe Tuer "
	    "eingelassen, die von zwei Waechterstatuen bewacht wird. Der "
	    "Rest des Turmes besteht aus einer hohen, dunklen und "
	    "fensterlosen Saeule.");
  
  AddDetail(({"basis","turmbasis"}),
	    "Die Basis des Turmes besteht aus einem seltsamen, dunklen "
	    "Material. Direkt in die Basis ist eine massive Tuer "
	    "eingearbeitet, die links und rechts von je einer Waechterstatue "
	    "bewacht wird.");
  
  AddDetail(({"material"}),
	    "So ein Material hast Du noch nie gesehen... Es ist so dunkel, "
	    "dass es fast schon bedrohlich wirkt!");
  
  AddDetail(({"tuer","eingang"}),
	    "Eine massive Tuer, die in die Basis des Turmes eingelassen ist "
	    "bildet den Eingang in den Turm. Weiters stehen links und rechts "
	    "vom Eingang zwei Waechterstatuen.");
  
  AddDetail(({"statue","statuen","waechterstatue","waechterstatuen"}),
	    "Die Waechterstatuen stellen Minotauren dar. Sie bewachen den "
	    "Eingang in den Turm.");
  
  AddDetail(({"minotaurus","minotauren","minotaurenstatuen",
		"minotaurusstatue","mensch","stier"}),
	    "Trollhohe Statuen, halb Mensch, halb Stier mit langen Piken "
	    "bewaffnet.");
  
  AddDetail(({"pike","piken"}),
	    "Die Piken sehen sehr echt aus.");

  AddDetail(({"baum","baeume","kristallbaum","kristallbaeume"}),
	    "Die Kristallbaeume stehen in einem grossen Bogen um den "
	    "dunklen Turm herum. Sie wirken fast, als wuerden sie sich von "
	    "ihm abwenden...");
  
  AddDetail(({"boden"}),
	    "Der Boden rund um den Turm ist total schwarz und wirkt tot. "
	    "Nicht ein einziger Grashalm ist darauf zu sehen.");
  
  AddDetail(({"halm","grashalm","gras"}),
	    "Rund um den Turm waechst nichts! Nicht einmal ein einziger "
	    "Grashalm.");
  
  AddDetail(({"himmel"}),
	    "Der Himmel ist blau und beinahe wolkenlos, denn ueber Dir nehmen "
	    "dunkle Wolken die Turmspitze ein.");
  
  AddDetail(({"spitze","turmspitze"}),
	    "Von der Turmspitze kannst Du nicht viel erkennen, da sie "
	    "beinahe vollstaendig von dunklen Wolken umschlossen ist.");
  
  AddDetail(({"wolke","wolken"}),
	    "Hoch ober Dir konzentrieren sich dunkle Wolken um die "
	    "Turmspitze. Ansonsten ist der Himmel schoen blau und wolkenfrei.");
  
  AddDetail(({"sonnenschein","sonne"}),
	    "Die Sonne scheint vom Turm verdeckt zu sein.");
  
  AddDetail(({"bogen"}),
	    "Die Baeume stehen in einem grossen Bogen um den dunklen Turm "
	    "herum.");
  
  AddDetail(({"wald","kristallwald"}),
	    "Rings um Dich herum befindet sich der Kristallwald.\n"
	    "Der Platz hier kommt Dir jedoch sehr seltsam vor...");
  
  AddDetail(({"platz","ort","umgebung"}),
	    "Irgendetwas stimmt hier nicht...\n"
	    "Es ist so ruhig...\n"
	    "Ob das an dem Turm liegt?");
  
  AddDetail(({"strauch","straeucher"}),
	    "Der Platz ist von den Straeuchern regelrecht umzingelt. Nur ein "
	    "kleiner Durchschlupf nach Suedosten faellt Dir auf.");
  
  AddDetail(({"durchschlupf"}),
	    "Der Durchschlupf in den Straeuchern fuehrt nach Suedosten.");
  
  AddSound(({DEFAULT_SOUND, "stille","ruhe"}),
	   "Eine sehr eigenartige Stille umgibt Dich...\n"
	   "Weder Voegel noch andere Insekten sind hier im Wald zu hoeren.");

  AddSound(({"vogel","voegel","vogelgesang","gesang","insekten","insekt",
	       "waldvogel","waldvoegel","waldvogelgesang","waldvoegelgesang",
	       "waldinsekten","waldinsekt"}),
	   "Absolute Stille! Wie seltsam...");

  AddSmell(({DEFAULT_SMELL,"geruch","turm"}),
	   "Ein seltsamer, undefinierbarer Geruch weht vom Turm her...");

  Licht("hell");
  Umgebung("warm", TT_FOREST);
  
  AddCmd(({"betret","betrete","betritt"}), "cmd_betreten");
  
  AddExit("durchschlupf", 
	  ([EX_DEST:KW, EX_MSG: "zurueck in den Kristallwald"]));
}

nosave int cmd_betreten(string str)
{
  notify_fail(BS("Was willst Du betreten?"));
  if(!str) return 0;
  
  if(member(({"turm","tuer","eingang","magierturm","schwarzmagierturm"}),
	    str)==-1) return 0;
  
  write(BS("Du versuchst die massive Tuer zu oeffnen..."));
  
  if(!TP->do_exhaust(50)) return 0;
  
  write(BS("Die Tuer gibt lautlos nach und Du betrittst das Innere des "
	   "Turmes."));
  
  TP->move(ROOM "turm_base", M_GO, "den Turm", "betritt", "kommt herein");
  
  return 1;
}
