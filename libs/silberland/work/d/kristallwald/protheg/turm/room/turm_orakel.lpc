#pragma strong_types;

#include "../def.h"

inherit MOST "std_room";

#define DAUER 300

nosave int pressed, used;

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Schwarzmagierturm (Orakelaltar)");
  SetProp(P_INT_LONG,
          BS("Du findest Dich in einem pechschwarzen Raum wieder, der von "
	     "unzaehligen Kerzen erleuchtet wird. Den Grossteil des Bodens "
	     "nimmt ein Pentagramm ein, dessen Ecken mit grossen "
	     "Kerzenhaltern gekennzeichnet sind. Dahinter an der Wand "
	     "befindet sich ein massiver Thron aus seltsam glitzernden "
	     "Stein.")+
	  BS("Der Raum scheint eine Art Altar zu sein, doch wofuer?"));
  
  AddDetail(({"raum","keller"}),
	    QueryProp(P_INT_LONG));
  
  AddDetail(({"magier","schwarzmagier"}),
	    "Er scheint nicht hier zu sein, vielleicht ist er weiter oben.");
  
  AddDetail(({"turm","magierturm","schwarzmagierturm"}),
	    "Du befindest Dich hier im Keller des Turmes, wie viele "
	    "Stockwerke er hat und was Dich weiter oben erwartet kannst Du "
	    "von hier aus nicht sagen.");
  
  AddDetail(({"altar","art"}),
	    "Der Thron, das Pentagramm, die vielen, brennenden Kerzen...\n"
	    "Das Alles erinnert Dich irgendwie an einen grossen Altar.");
  
  AddDetail(({"platz","waende","wand"}),
	    "Die Waende sind glatt und schwarz und bieten somit genug "
	    "Platz fuer die Schattenspiele der davor aufgestellten Kerzen.");
  
  AddDetail(({"schatten","schattenspiel","schattenspiele"}),
	    "Fast koennte man meinen, dass sich der Raum bewegt, doch es "
	    "sind nur die Schattenspiele der vielen brennenden Kerzen hier "
	    "im Raum.");
  
  AddDetail(({"schein","kerzenschein","feuer"}),
	    "Der Schein der Kerzen verleiht dem Raum etwas mystisches, "
	    "etwas geheimnisvolles...");
  
  AddDetail(({"mosaik","bodenmuster","muster"}),
	    "Das Mosaik am Boden stellt ein beinahe raumfuellendes Pentagramm "
	    "dar, welches von konzentrischen Kreisen eingeschlossen wird. "
	    "Es wirkt fast als wuerde es sich bewegen, doch das sind nur "
	    "die tanzenden Schatten der aufgestellten Kerzen.");
  
  AddDetail(({"russ","kerzenruss"}),
	    "Der viele Kerzenruss hat die Decke bis zur Unkenntlichkeit "
	    "eingeschwaerzt.");
  
  AddDetail(({"unkenntlichkeit"}),
	    "Die Decke ist einfach total schwarz!");
  
  AddDetail(({"pentagramm"}),
	    "Das Mosaik am Boden stellt ein grosses Pentagramm dar. An den "
	    "fuenf Eckpunkten steht je ein grosser Kerzenhalter, sodass "
	    "sich der Kerzenschein genau im Mittelpunkt des Pentagrammes "
	    "trifft.");
  
  AddDetail(({"punkt","mittelpunkt"}),
	    "Scheinbar hat der Mittelpunkt des Pentagrammes eine wichtige "
	    "Rolle...\nAls Du den Mittelpunkt naeher betrachtest, faellt "
	    "Dir doch tatsaechlich eine kleine Unebenheit auf.");
  
  AddDetail(({"unebenheit"}),
	    "Eine kleine, runde Unebenheit...");
  
  AddDetail(({"rolle","ahnung"}),
	    "Du hast keine Ahnung welche...");
  
  AddDetail(({"ecken","ecke","eckpunkt","eckpunkte"}),
	    "Die Eckpunkte des Pentagrammes werden mit grossen Kerzenhaltern "
	    "markiert.");
  
  AddDetail(({"halter","kerzenhalter","kerzen"}),
	    "Fuenf grosse Kerzenhalter markieren jeweils die Eckpunkte "
	    "des grossen Pentagramms auf dem Boden. Sie sind mit besonders "
	    "grossen Kerzen bestueckt, die allerdings schon weit "
	    "herabgebrannt sind und die Halter fast vollstaendig mit "
	    "Kerzenwachs ueberdeckt haben.");
  
  AddDetail(({"wachsklumpen","kerzenwachsklumpen","klumpen","wachs",
		"kerzenwachs"}),
	    "Das Kerzenwachs hier ist allgegenwaertig, unter jeder Kerze "
	    "hier im Raum haben sich Klumpen von Wachs angesammelt.");
  
  AddDetail(({"stock","stockwerk","stoecke","stockwerke"}),
	    "Das hier ist der Keller.");

  AddDetail(({"boden","teil","grossteil"}),
	    "Der Boden wird vollstaendig von einem Mosaik eingenommen. Den "
	    "groessten Teil davon stellt ein Pentagramm dar, der Rest wird "
	    "von konzentrischen Kreisen ausgefuellt.");
  
  AddDetail(({"kreis","kreise","rest"}),
	    "Einfache, konzentrische Kreise fuellen das Muster rund um "
	    "das Pentagramm...");
  
  AddDetail(({"decke","steindecke"}),
	    "Die Decke ueber Dir ist total schwarz.\n"
	    "Wahrscheinlich hat der Kerzenruss die Decke mit der Zeit total "
	    "verfaerbt.");
  
  AddDetail(({"zeit","jahr","jahre"}),
	    "Ueber die Jahre hinweg, hat der viele Kerzenruss die Decke "
	    "vollkommen geschwaerzt.");
  
  AddDetail(({"nase"}),
	    "Ja, die scheint noch da zu sein.");
  
  AddDetail(({"thron","steinthron"}),
	    "Ein schlichter, schmuckloser, jedoch aeusserst massiv wirkender "
	    "Thron aus Stein befindet sich an der gegenueberliegenden Wand. "
	    "Du findest, dass er hier etwas deplaziert wirkt.");
  
  AddDetail(({"adamant","stein"}),
	    "So glitzert eigentlich nur Adamant!");
  
  AddDetail(({"treppe"}),
	    "Die Treppe fuehrt hinauf in das Erdgeschoss.");
  
  AddDetail(({"hinauf","oben","erdgeschoss"}),
	    "Das Erdgeschoss erreichst Du ueber die Treppe.");
  
  AddSound(({"stille",DEFAULT_SOUND}),
	   "Es herrscht eine feierliche Stille...");

  AddSmell(DEFAULT_SMELL,
	   "Es riecht nach warmem Wachs.");

  AddSmell(({"kerze","kerzen","wachs","kerzenwachs"}),
	   "Das Wachs der Kerzen verstroemt einen etwas seltsamen Geruch.");
  
  AddSmell(({"geruch"}),
	   "Du kannst den Geruch nicht genau definieren, aber je oefter Du "
	   "ihn riechst, desto angenehmer geht es Dir.");
  
  AddExit("hinauf", "hinauf ins Erdgeschoss#" ROOM "turm_base");
    
  Licht("hell");
  Umgebung("warm", TT_HOUSE, 1);
  
  AddRoomMessage(({
    "Ein seltsamer Geruch steigt Dir in die Nase.\n",
      "","","",
      "Du fuehlst Dich besser.\n",
      "","","",
      "Du beobachtest vergnuegt das Feuer der Kerzen.\n"}), 15, "healing");
  
  pressed=0;
  used=3;
  
  AddCmd(CMD_DRUECKEN, "cmd_druecken");
  
  AddItem(NPC "yuknok", REFRESH_DESTRUCT);
}

nosave int cmd_druecken(string str)
{
  if(!str) return 0;
  
  if(str!="unebenheit") return 0;
  
  if(pressed)
    return write(BS("Die Unebenheit scheint im Moment fixiert zu sein.")), 1;
  
  write(BS("Du bueckst Dich kurz und drueckst auf die Unebenheit.")+
	BS("Die Unebenheit rastet mit einem Click ein."));
  
  tell_room(ME, BS(TPN+" bueckt sich kurz..."), ({TP}));
  
  pressed=time()+DAUER;
  
  return 1;
}

int P()
{
  if(pressed) return 1;
  else return 0;
}

void healing(int bla)
{
  object *pls;
  int i;
  
  if(pressed)
    if(pressed <= time())
      {
	pressed=0;
	used--;
	if(used < 0 ) used=0;
      }
  
  if(!sizeof(pls=filter_array(all_inventory(ME), CLOSURE(interactive))))
    return;
  
  for(i=sizeof(pls)-1;i>=0;i--)
    if(random(100) >= 95) pls[i]->AddPoison(-1-P());
    else
      switch(random(5))
	{
	case 0 .. 1: pls[i]->AddSp(1+random(8)+P()*used*random(5)); break;
	  
	case 2     : pls[i]->heal_self(1+random(8)+P()*used*random(5)); break;
	  
	case 3 .. 4: pls[i]->AddHp(1+random(8)+P()*used*random(5)); break;
	}
}

varargs string GetExits(object viewer)
{
  return BS("Ueber die Treppe kannst Du wieder 'hinauf' gelangen.");
}

void reset()
{
  ::reset();
  
  if(!pressed)
    used=3;
  else
    used++;
}
