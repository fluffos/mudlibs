#pragma strong_types;

#include "../def.h"

#define TREASURESAVE LOG "treasure"

int treasure;

void create()
{
  if(is_clone(ME)) return destruct();

  SUID;
  
  treasure=0;
  restore_object(TREASURESAVE);
}

varargs public void PayIn(int amount)
{
  if(!PO) return;
  if(explode(file_name(PO), "#")[0]!=NPC "yuknok") return;
  
  if(amount < 1) return;
  
  treasure+=amount;
  
  save_object(TREASURESAVE);
}

public QueryTreasure()
{
  return treasure;
}
