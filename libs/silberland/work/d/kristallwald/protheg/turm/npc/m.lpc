#pragma strong_types;

#include "../def.h"

mapping sk, extsk;
string guild;

void create()
{
  if(is_clone(ME)) return destruct();

  SUID;
  
  sk=([]);
  extsk=([]);
  guild="";
}

varargs public void Save(object pl, int flag)
{
  if(!objectp(pl)) return;
  if(!PO) return;
  if(explode(file_name(PO), "#")[0]!=NPC "yuknok") return;
  
  if(file_size(SKILLSAVE+getuid(TP)+".o") >= 0)
    restore_object(SKILLSAVE+getuid(pl));
  
  if(flag!=EXTERNALSKILLS) 
    {
      sk=copy_mapping(pl->QueryProp(P_NEWSKILLS));
      guild=pl->QueryProp(P_GUILD);
    }
  
  if(flag!=GUILDSKILLS) 
    extsk=copy_mapping(pl->QueryProp(P_EXTERNAL_SKILLS));
  
  save_object(SKILLSAVE+getuid(pl));
}

public mapping Restore(object pl, int flag)
{
  if(!objectp(pl)) return 0;
  if(!PO) return 0;
  if(explode(file_name(PO), "#")[0]!=NPC "yuknok") return 0;
  if(!flag) return ([]);
  if(file_size(SKILLSAVE+getuid(TP)+".o") <= 0) return 0;

  restore_object(SKILLSAVE+getuid(pl));
  
  if(flag==GUILDSKILLS)
    return sk;
  else 
    return extsk;
}

public int New_Guild(object pl)
{
  int ret;

  if(!objectp(pl)) return 0;
  if(!PO) return 0;
  if(explode(file_name(PO), "#")[0]!=NPC "yuknok") return 0;
  
  if(file_size(SKILLSAVE+getuid(TP)+".o") <= 0) return 0;
  
  restore_object(SKILLSAVE+getuid(pl));
  
  if(guild!=pl->QueryProp(P_GUILD)) return 1;

  return 0;
}
