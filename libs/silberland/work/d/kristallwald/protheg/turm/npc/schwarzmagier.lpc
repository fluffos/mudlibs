/*
** Ein boesartiger Schwarzmagier
**
** traegt einen magischen Knochenhelm
*/

#include "../def.h"

inherit MOST "mynpc";

nosave int schutzaura;

void create()
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein wuetender Schwarzmagier kreischt Dich an");
  SetProp(P_LONG,
	  BS("Die seltsame Gestalt vor Dir scheint keine scharfen Umrisse "
	     "zu haben, fast scheint es, als waere sie ein Geist...")+
	  BS("Die Gestalt ist in ein grosses, schwarzes Etwas gekleidet und "
	     "hat einen seltsamen Knochenhelm aufgesetzt.")+
	  BS("Scheinbar haelt sie nicht viel von Deiner Anwesenheit, denn "
	     "sie ist sehr wuetend und funkelt Dich mit ihren roten Augen "
	     "boese an."));
  
  SetProp(P_NAME, "Schwarzmagier");
  SetProp(P_GENDER, MALE);
  
  SetProp(P_NAME_ADJ, "wuetend");
  AddAdjective(({"wuetender","wuetenden","wuetend"}));
  
  AddId(({"\nschwarzmagier","schwarzmagier", "magier", "NOWIMPY", "NOCONTROL",
	      "NO_MUMMY"}));
  
  create_default_mensch(20);
  
  SetProp(P_XP, QueryProp(P_XP)+666666);
  
  SetProp(P_ALIGN, -600);
  
  SetProp(P_TRANSPARENT, 0);
  
  SetProp(P_AGGRESSIVE, 1);
  
  SetProp(P_NOMAGIC, 25);
  
  SetProp(P_MSGIN, "erscheint in einer dunklen Rauchwolke");
  SetProp(P_MSGOUT, "huscht");
  
  SetProp(P_DIE_MSG, " loest sich in Rauch auf.\n");
  
  SetProp(P_REJECT, 
	  ({REJECT_DROP, "Der Schwarzmagier holt sich alles, wenn Du tot "
	      "bist.\n"}));
  
  //AddDetail(({""}), "");
  
  AddInfo(DEFAULT_INFO, ({
    "bruellt: Raus hier!\n",
      "kreischt: Hau ab!\n",
      "bruellt: Verschwinde!\n",
      "kreischt nur.\n",
      "fuchtelt wie wild mit seinen Armen umher.\n"}));
  
  SetProp(P_HANDS, ({
    " mit seinen eisigen Krallen", QueryProp(P_HANDS)[1]+100, DT_COLD}));
  
  AddProp(P_BODY, 50); //Stoneskin
  
  SetAttribute(A_INT, 35);
  
  AddProp(P_MAX_SP, 600);
  AddProp(P_SP, 600);
  
  SetProp(P_RESISTANCE_STRENGTHS ,
  ([DT_FIRE:      -0.4, DT_COLD:   -0.9, DT_WATER:  -0.4, DT_AIR:    -0.4,
    DT_EXPLOSION:  0.1, DT_ACID:   -0.1, DT_POISON: -0.2, DT_TERROR: -0.2, 
    DT_HOLY:       0.1, DT_UNHOLY: -0.2, DT_MAGIC:  -0.6]));
    
  SetProp(P_SPELLRATE, 80);

  AddSpell(2, 333,
	   "Der Schwarzmagier beschwoert ueber Dir ein paar dunkle Wolken...\n"
	   "Ploetzlich trifft Dich ein Blitz...\n",
	   "@WER wird ploetzlich von einem Blitz getroffen!\n",
	   ({DT_LIGHTNING}),([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2, 666,
	   "Der Schwarzmagier hebt seine Arme...\n"
	   "Ploetzlich schiessen Eiszapfen aus seinen Fingern auf Dich zu!\n",
	   "Der Schwarzmagier hebt seine Arme...\n"
	   "Ploetzlich schiessen Eiszapfen aus seinen Fingern auf @WEN zu!\n",
	   ({DT_COLD}),([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 666,
	   "Der Schwarzmagier hebt seine Arme...\n"
	   "Seltsame Gedanken formen sich in Deinem Geist...\n",
	   "Der Schwarzmagier hebt seine Arme...\n"
	   "@WER bekommt einen seltsamen Gesichtsausdruck...\n",
	   ({DT_MIND}),([SP_SHOW_DAMAGE:0]));

  AddSpell(2, 1,
	   "Der Schwarzmagier hebt seine Arme...\n",
	   "Der Schwarzmagier hebt seine Arme...\n",
	   ({DT_MAGIC}),"stachel_roomspell",([SP_SHOW_DAMAGE:0]));

  AddSpell(2, 1,
	   "Der Schwarzmagier hebt seine Arme...\n",
	   "Der Schwarzmagier hebt seine Arme...\n",
	   ({DT_MAGIC}),"aura_aufbauen",([SP_SHOW_DAMAGE:0]));

  AddSpell(1, 1,
	   "Der Schwarzmagier blickt Dich an und spricht: 'Quak'\n",
	   "Der Schwarzmagier blickt @WEN an und spricht: 'Quak'\n",
	   ({DT_MAGIC}),"froschi",([SP_SHOW_DAMAGE:0]));

  SetAttackChats(2, ({
    "Der Schwarzmagier tobt umher.\n",
      "Der Schwarzmagier springt um Dich herum.\n",
      "Der Schwarzmagier murmelt seltsame Formeln...\n",
      "Der Schwarzmagier verflucht Dich.\n",
      "Der Schwarzmagier funkelt Dich boese an.\n",
      "Der Schwarzmagier spricht einen dunklen Fluch ueber Dich.\n"}));

  SUID;
  
  CLONEME(ARMOUR "knochenhelm");
  command("trage helm");

  if(random(100) > 60)
    CLONEME("/d/dschungel/feyaria/tijara/obj/wbalsam");
  else
    CLONEME("/d/dschungel/feyaria/tijara/obj/rbalsam");
  
  AddMoney(1000+random(501));
}

void stachel_roomspell(object enemy, int damage, mixed d_type)
{
  if(present("\nstachel_roomspell", MENV)) return;
  
  CLONE(OBJ "stachel_roomspell", MENV);
}

void aura_aufbauen(object enemy, int damage, mixed d_type)
{
  if(!random(2)) 
    return;

  if(!schutzaura)
    tell_room(MENV,
	      BS("Um den Schwarzmagier bildet sich eine schuetzende Aura."));
  else
    tell_room(MENV,
	      BS("Die Aura um den Schwarzmagier wird staerker."));
  
  schutzaura+=10+random(5);  
}

void froschi(object enemy, int damage, mixed d_type)
{
  if(enemy->QueryProp(P_FROG)) 
    if(random(100) > 50) return;
    else
      {
	tell_object(enemy,
		    BS("Da Du bereits ein Frosch bist, scheint der Zauber nun "
		       "das Gegenteil zu bewirken..."));
	
	tell_room(ENV(enemy),
		  BS(enemy->Name(WER, 1)+" wird durch einen Fehlzauber "
		     "entfroscht."), ({enemy}));
	enemy->SetProp(P_FROG, 0);
	return;
      }
  
  if(random(enemy->QueryAttribute(A_DEX)) > 15) 
    tell_object(enemy, BS("Du wehrst den Spruch ab."));
  else
    {
      tell_object(enemy,
		  BS("Ploetzlich wird die Welt so gross..."));

      tell_room(ENV(enemy),
		BS(enemy->Name(WER,1)+" wird ploetzlich ganz klein und "
		   "gruen."), ({enemy}));

      enemy->SetProp(P_FROG, 1);
    }
}

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if(touch) call_out("kaelte", 0, TP);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void kaelte(object ob)
{
  if(present(ob, ENV(TO))) 
    {
      tell_object(ob, 
		  BS("Eine seltsame Kaelte ueberkommt Dich, als Du den "
		     "Schwarzmagier beruehrst."));
      
      tell_room(ENV(TO), 
		BS(ob->Name(WER,1)+" beginnt ploetzlich seltsam zu "
		   "zittern."), ({ob}));

      ob->AddHp(-3-random(3));
    }
}

int Defend(int dam, string *dtype, mixed spell, object e)
{
  if(!pointerp(dtype))
    dtype=({dtype});
  
  if(sizeof(dtype & m_indices(PHYSICAL_DAMAGE_TYPES)))
    dam=dam*2/3;
  
  if(sizeof(dtype & m_indices(MAGICAL_DAMAGE_TYPES)))
    if(schutzaura > 0)
      {
	schutzaura--;
	
	tell_room(MENV, 
		  BS("Die Schutzaura um den Schwarzmagier verdunkelt sich kurz."));
	
	return ::Defend(dam/2, dtype, spell, e);
      }
  
  return ::Defend(dam, dtype, spell, e);
}

void init()
{
  ::init();
  
  if((TP) && (interactive(TP)))
    call_out("nerv", 1, TP);
}

void nerv(object pl)
{
  if((pl) && (present(pl, MENV)))
    tell_object(pl, BS("Der Schwarzmagier bruellt Dich an: Verschwinde!"));
}
