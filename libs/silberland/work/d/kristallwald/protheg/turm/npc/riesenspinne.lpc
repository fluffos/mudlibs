/*
** Eine Riesenspinne
**
** Spells von der Farbe abhaengig
*/

#include "../def.h"

inherit MOST "mynpc";

nosave string color;

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  color=({"rote","braune","gruene","violette","schwarze"})[random(5)];

  SetProp(P_SHORT, "Eine "+color+" Riesenspinne");
  SetProp(P_LONG,
	  BS("Vor Dir krabbelt eine gewaltige "+color+" Spinne umher. "
	     "Der gewaltige "+color+" Rumpf der Spinne wird von acht haarigen "
	     "Beinen gestuetzt, die mit lautem Geklicker ueber den Boden "
	     "huschen. Aus dem Spinnenmaul rinnt gruener Speichel, der auf "
	     "dem Boden zischende Flecken zuruecklaesst.")+
	  BS("Dir wird schlecht bei dem Gedanken mit diesem Monster zu "
	     "kaempfen."));
  
  SetProp(P_INFO,
	  BS("Die Haare von Riesenspinnen sind oftmals giftgetraenkt!"));
  
  SetProp(P_NAME, "Riesenspinne");
  SetProp(P_GENDER, FEMALE);

  SetProp(P_NAME_ADJ, color[0..<2]);
  AddAdjective(({color,color[0..<2],color+"n",color+"r"}));

  AddId(({"NOWIMPY","spinne", "riesenspinne","\nprotheg_turm_spinne"}));
  
  SetGuardProtection(90, GUARD_LOCATION);
  
  create_default_npc(19+random(3));
  
  SetProp(P_RACE, "Spinne");
  SetProp(P_SIZE, 150+random(50));
  SetProp(P_ALIGN, -400);
  SetProp(P_MAX_HANDS, 8);
  
  SetProp(P_AGGRESSIVE, 0.99);
		     
  SetProp(P_NOMAGIC, 10);

  SetProp(P_MSGIN, "kommt hereingekrabbelt");
  SetProp(P_MSGOUT, "krabbelt");

  SetProp(P_DIE_MSG,  " sackt in sich zusammen.\n");

  SetProp(P_REJECT, 
	  ({REJECT_DROP, "Die Riesenspinne will Dein Zeug nicht.\n"}));

  AddInfo(DEFAULT_INFO, 
	  ({"bruellt auf.\n",
	      "kreischt nur.\n",
	      "fuchtelt wie wild mit ihren Spinnenbeinen.\n",
	      "kreischt herum.\n"}));

  SetProp(P_HANDS, ({" mit ihren spitzen Spinnenbeinen",
		       QueryProp(P_HANDS)[1], DT_PIERCE}));
  
  SetProp(P_RESISTANCE_STRENGTHS ,
  ([DT_FIRE:      -0.1, DT_COLD:   -0.1, DT_WATER: -0.1, DT_AIR:    -0.1,
    DT_EXPLOSION:  0.1, DT_SOUND:  -0.4, DT_LIGHT:  0.1, DT_ACID:   -0.8, 
    DT_POISON:    -1.0, DT_TERROR: -0.2, DT_HOLY:   0.2, DT_UNHOLY: -0.2, 
    DT_MAGIC:     -0.3]));
    
  SetProp(P_SPELLRATE, 30);

  switch(color)
    {
    case "rote":
      AddSpell(3, 220,
	       "Die "+color+" Riesenspinne reisst Dir das Gesicht auf.\n"
	       "Dein Gesicht beginnt zu brennen...\n",
	       "Die "+color+" Riesenspinne reisst @WEM das Gesicht auf.\n",
	       ({DT_RIP,DT_FIRE,DT_POISON}),([SP_SHOW_DAMAGE:0]));
      break;
    case "braune":
      AddSpell(3, 220,
	       "Die "+color+" Riesenspinne rammt Dir ein Spinnenbein in den "
	       "Unterleib.\n",
	       "Die "+color+" Riesenspinne rammt @WEM ein Spinnenbein in den "
	       "Unterleib.\n",
	       ({DT_PIERCE,DT_POISON}),([SP_SHOW_DAMAGE:1]));

      break;
    case "gruene": 
      AddSpell(3, 220,
	       "Die "+color+" Riesenspinne spuckt Dir in das Gesicht.\n"
	       "Dein Gesicht beginnt zu brennen...\n",
	       "Die "+color+" Riesenspinne spuckt @WEM in das Gesicht.\n",
	       ({DT_POISON}),([SP_SHOW_DAMAGE:0]));

      break;
    case "violette":
      AddSpell(3, 220,
	       "Die "+color+" Riesenspinne versucht Dich zu rammen.\n"
	       "Die "+color+" Riesenspinne versucht @WEN zu rammen.\n",
	       ({DT_RIP,DT_BLUDGEON,DT_POISON}),([SP_SHOW_DAMAGE:1]));

      break;
    case "schwarze":
      AddSpell(3, 220,
	       "Die "+color+" Riesenspinne kreischt Dich an.\n"
	       "In Deinen Ohren droehnt es...\n",
	       "Die "+color+" Riesenspinne kreischt @WEN an.\n",
	       ({DT_SOUND}),([SP_SHOW_DAMAGE:0]));

      break;
    }

  SetAttackChats(2, ({
    "Die "+color+" Riesenspinne krabbelt umher.\n",
      "Die "+color+" Riesenspinne springt um Dich herum.\n",
      "Die "+color+" Riesenspinne bespuckt Dich mit ihrem Gift.\n",
      "Die "+color+" Riesenspinne springt Dich an.\n",
      "Die "+color+" Riesenspinne springt hoch und landet hinter Dir!\n",
      "Die "+color+" Riesenspinne zuckt mit ihren Spinnenbeinen.\n"}));

  SUID;
}

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if(touch) call_out("vergiften", 0, TP);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void vergiften(object ob)
{
  if(present(ob, ENV(TO))) 
    {
      if(random(ob->QueryAttribute(A_DEX))> 10) return;

      tell_object(ob, 
		  BS("Du stichst Dich an den seltsamen Haaren der "
		     "Riesenspinne."));
      
      tell_room(ENV(TO), 
		BS(ob->Name(WER,1)+" sticht sich an den seltsamen Haaren "
		   "der Riesenspinne"), ({ob}));

      ob->AddPoison(random(2));
    }
}

int Defend(int dam, string *dam_type_list, mixed spell, object e)
{
  if(((!e->QueryProp(P_WEAPON)) && (!sizeof(e->QueryArmours(AT_GLOVE)))) &&
     (random(e->QueryAttribute(A_DEX))> 10))
    {
      tell_object(e, 
		  BS("Du stichst Dich an den seltsamen Haaren der "
		     "Riesenspinne."));
      
      tell_room(ENV(TO), 
		BS(e->Name(WER,1)+" sticht sich an den seltsamen Haaren "
		   "der Riesenspinne"), ({e}));
      
      e->AddPoison(random(2));

      return ::Defend(dam*4/5, dam_type_list, spell, e);
    }
  
  return ::Defend(dam, dam_type_list, spell, e);
}
