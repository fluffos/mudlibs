	"Orakel!"
	]);

nosave int busy;
nosave string *fpquestions;

varargs nosave void no_more_busy(int msg)
{
  busy=0;
  
  if(msg)
    tell_room(MENV, BS(Name()+" versinkt wieder in Meditation."));
}

nosave void get_busy() { busy=time(); }

nosave int f_filter(int flag, int skill)
{
  switch(flag)
    {
    case 0: return 1;
      break;

    case 1: if(skill < 5000) return 1; 
      break;

    case 2: if((skill > 5000) && (skill < 8000)) return 1;
      break;

    case 3: if((skill > 8000) && (skill < 9900)) return 1;
      break;

    default: if(skill >= 9900) return 1;
    }
  
  return 0;
}

nosave string flag2str(int flag)
{
  switch(flag)
    {
    case 1: return "unterdurchschnittlich";
    case 2: return "ueberdurchschnittlich";
    case 3: return "hervorragend";
    case 4: return "perfekt";
    }
  return "blubb";
}

varargs nosave string skill2str(int skill, int maxskill)
{
  if(!maxskill) maxskill=10000;
  
  switch(skill*100/maxskill) 
    {
    case 1 .. 3 : return "gar nicht.";
    case 4 ..17 : return "fast gar nicht.";
    case 18..30 : return "sehr miserabel.";
    case 31..33 : return "ziemlich schlecht.";
    case 34..37 : return "schlecht.";
    case 38..40 : return "maessig.";
    case 41..43 : return "unterdurchschnittlich.";
    case 44..47 : return "fast schon durchschnittlich.";
    case 48..53 : return "durchschnittlich.";
    case 54..57 : return "fast schon ueberdurchschnittlich.";
    case 58..60 : return "ueberdurchschnittlich.";
    case 61..63 : return "fast schon gut.";
    case 64..67 : return "gut.";
    case 68..70 : return "wirklich gut.";
    case 71..73 : return "fast schon sehr gut.";
    case 74..77 : return "sehr gut.";
    case 78..80 : return "unglaublich gut.";
    case 81..83 : return "phantastisch gut.";
    case 84..87 : return "ausgezeichnet.";
    case 88..90 : return "hervorragend.";
    case 91..93 : return "meisterhaft.";
    case 94..98 : return "nahezu perfekt.";
    case 99     : return "perfekt.";
    case 100    : return "absolut perfekt.";
    default     : return "ueberhaupt nicht.";
    }
}

varargs nosave string int2adv(int a, int b, int c)
{
  int diff;
  
  if(!c) c=10000;
  
  diff=((a*100)/c)-((b*100)/c);
  
  switch(diff)
    { 
    case    0         : return "gar nicht"; //sollte nie der fall sein
    case    1 ..    3 : return "nur sehr wenig";
    case    4 ..    6 : return "wenig";
    case    7 ..    9 : return "doch etwas";
    case   10 ..   14 : return "deutlich";
    case   15 ..   25 : return "sehr deutlich";
    case   26 ..   30 : return "um vieles";
    case   31 ..   40 : return "um sehr viel";
    case   41 ..   75 : return "massivst!";
    default           : return "unglaublich viel!";
    }
}

nosave string int2str(int z)
{
  switch(z)
    {
    case 0  : return "keine";
    case 1  : return "eine";
    case 2  : return "zwei";
    case 3  : return "drei";
    case 4  : return "vier";
    case 5  : return "fuenf";
    case 6  : return "sechs";
    case 7  : return "sieben";
    case 8  : return "acht";
    case 9  : return "neun";
    case 10 : return "zehn";
    case 11 : return "elf";
    case 12 : return "zwoelf";
    case 13 : return "dreizehn";
    case 14 : return "vierzehn";
    case 15 : return "fuenfzehn";
    case 16 : return "sechzehn";
    case 17 : return "siebzehn";
    case 18 : return "achtzehn";
    case 19 : return "neunzehn";
    case 20 : return "zwanzig";
    case 21 : return "einundzwanzig";
    case 22 : return "zweiundzwanzig";
    case 23 : return "dreiundzwanzig";
    case 24 : return "vierundzwanzig";
    case 25 : return "fuenfundzwanzig";
    case 26 : return "sechsundzwanzig";
    case 27 : return "siebenundzwanzig";
    case 28 : return "achtundzwanzig";
    case 29 : return "neunundzwanzig";
    case 30 : return "dreissig";
    case 31 : return "einunddreissig";
    case 32 : return "zweiunddreissig";
    case 33 : return "dreiunddreissig";
    case 34 : return "vierunddreissig";
    case 35 : return "fuenfunddreissig";
    case 36 : return "sechsunddreissig";
    case 37 : return "siebenunddreissig";
    case 38 : return "achtunddreissig";
    case 39 : return "neununddreissig";
    case 40 : return "vierzig";
    default : return "viele";
    }
}

varargs nosave void sfkt(string str, int flag)
{
  command_me("sage "+str);
  
  no_more_busy(flag);
}


nosave int no_skill(string what)
{
  if(CAP(what)==what) return 0;

  return 1;
}

nosave int is_skill(string what)
{
  if(CAP(what)==what) return 1;

  return 0;
}

nosave int sortskills(string a, string b)
{
  int i,l;
  string as, bs;
  
  if(a==b) return 1;
  
  as=skill2name(a);
  bs=skill2name(b);
  
  if(strlen(as) <= strlen(bs))
    l=strlen(as);
  else
    l=strlen(bs);

  for(i=0 ; i < l ; i++)
    if(as[i]==bs[i])
      continue;
    else
      if(as[i] < bs[i])
	return 1;
      else
	return 0;
}

nosave nomoney(int preis)
{
  call_out("sfkt", 2, 
	   "Ihr habt die erforderlichen "+preis+" Muenzen nicht!");

  no_more_busy();
}

nosave pay_me(object pl, int preis)
{
  if(pl->QueryMoney() < preis)
    return nomoney(preis), 0;
  
  pl->AddMoney(-preis);
  
  tell_object(pl, BS("Du gibst Yuknok, dem Orakel "+preis+" Muenzen."));
  tell_room(MENV, BS(pl->Name(WER)+" bezahlt Yuknok, das Orakel."), ({pl}));
  
  TREASURE->PayIn(preis);
  
  return 1;
}

void advance_new(object pl)
{
  no_more_busy();

  if((!objectp(pl)) || (!MENV) || (!present(pl, MENV))) return;
  if((!PO) || (PO!=ME)) return;
  
  if(!pay_me(pl, PREIS_ADVANCE)) return 0;
  
  SAVER->Save(pl);
  
  sfkt("Gut, das wars.");
  sfkt("Wenn Ihr wieder kommt, kann ich Euch dann mitteilen, um wieviel "
       "Ihr Eure Zauber gesteigert habt.", 1);
}

void advance_external_output(object pl)
{
  int i, tmpo, tmpn, flag;
  mapping skill_new, skill_old;
  string *spells, *spellsn;
  
  no_more_busy();
    
  if((!objectp(pl)) || (!MENV) || (!present(pl, MENV))) return;
  if((!PO) || (PO!=ME)) return;
  
  if(!pay_me(pl, PREIS_ADVANCE)) return 0;
  
  if(!(skill_old=SAVER->Restore(pl,EXTERNALSKILLS))) return;
  
  skill_new=pl->QueryProp(P_EXTERNAL_SKILLS);

  sfkt("Seit der letzten Beurteilung habt Ihr...");
  
  spells=m_indices(skill_new);
  spells=sort_array(spells, CLOSURE(sortskills));
  
  spellsn=m_indices(skill_old);
  spellsn=sort_array(spellsn, CLOSURE(sortskills));

  if((!sizeof(spellsn)) && (!sizeof(spells)))
    return sfkt("Keine neuen Fertigkeiten hinzugelernt.", 1);
  
  for(i=sizeof(spells)-1;i>=0;i--)
    {
      if(!member(skill_new, spells[i]))
	tmpn=0;
      else
	if(intp(skill_new[spells[i]]))
	  tmpn=skill_new[spells[i]];
	else
	  tmpn=skill_new[spells[i]][SI_SKILLABILITY];
      
      if(!member(skill_old, spells[i]))
	tmpo=0;
      else
	if(intp(skill_old[spells[i]]))
	  tmpo=skill_old[spells[i]];
	else
	  tmpo=skill_old[spells[i]][SI_SKILLABILITY];
      
      if(tmpn > tmpo)
	{
	  flag=1;

	  if(!tmpo)
	    sfkt(CAP(skill2name(spells[i]))+" neu hinzugelernt.");
	  else
          {
	    sfkt(CAP(skill2name(spells[i]))+" "+
		 int2adv(tmpn, tmpo, skill_new[spells[i],3])+
		 " gesteigert.");
          }
	}
      else
	if(tmpn < tmpo)
	  {
	    flag=1;
	    
	    if(!tmpn)
	      sfkt(CAP(skill2name(spells[i]))+" komplett verlernt.");
	    else
	      sfkt(CAP(skill2name(spells[i]))+" "+
		   int2adv(tmpo, tmpn, skill_new[spells[i],3])+
		   " verlernt.");
	  }
    }
  
  if(!flag) sfkt("rein gar nichts dazugelernt!");
  
  SAVER->Save(pl, EXTERNALSKILLS);

  no_more_busy(1);
}

void advance_guild_output(object pl)
{
  int i, tmpn, tmpo, flag;
  mapping skill_new, skill_old;
  string *spells, *spellsn;
  
  no_more_busy();
  
  if((!objectp(pl)) || (!MENV) || (!present(pl, MENV))) return;
  if((!PO) || (PO!=ME)) return;
  
  if(!pay_me(pl, PREIS_ADVANCE)) return 0;
  
  if(SAVER->New_Guild(pl))
    {
      SAVER->Save(pl,GUILDSKILLS);

      sfkt("Ah, Ihr habt also die Gilde gewechselt! Nun, dann muss ich Euch "
	   "neu beurteilen...");
      call_out("sfkt", 1, "Gut, das wars.");
      no_more_busy(1);
      return;
    }

  if(!(skill_old=SAVER->Restore(pl,GUILDSKILLS))) return;
  
  skill_new=copy_mapping(pl->QueryProp(P_NEWSKILLS));

  sfkt("Seit der letzten Beurteilung habt Ihr...");
  
  spells=m_indices(skill_old);
  spells=filter_array(spells, "no_skill");

  spellsn=m_indices(skill_new);
  spellsn=filter_array(spellsn, "no_skill");

  if((!sizeof(spellsn)) && (!sizeof(spells)))
    return sfkt("Keine neuen Gildenfertigkeiten hinzugelernt.", 1);

  spells=sort_array(spells, CLOSURE(<));
  
  flag=0;
  
  for(i=sizeof(spells)-1;i>=0;i--)
    {
      if(!member(skill_new, spells[i]))
	tmpn=0;
      else
	if(intp(skill_new[spells[i]]))
	  tmpn=skill_new[spells[i]];
	else
	  tmpn=skill_new[spells[i]][SI_SKILLABILITY];
      
      if(!member(skill_old, spells[i]))
	tmpo=0;
      else
	if(intp(skill_old[spells[i]]))
	  tmpo=skill_old[spells[i]];
	else
	  tmpo=skill_old[spells[i]][SI_SKILLABILITY];
      
      if(tmpn > tmpo)
	{
	  flag=1;

	  if(!tmpo)
	    sfkt(CAP(spells[i])+" neu hinzugelernt.");
	  else
	    sfkt(CAP(spells[i])+" "+int2adv(tmpn, tmpo)+" gesteigert.");
	}
      else
	if(tmpn < tmpo)
	  {
	    flag=1;

	    if(!tmpn)
	      sfkt(CAP(spells[i])+" komplett verlernt.");
	    else
	      sfkt(CAP(spells[i])+" "+int2adv(tmpo, tmpn)+" verlernt.");
	  }
    }
  
  if(!flag) sfkt("rein gar nichts dazugelernt!");
  
  SAVER->Save(pl, GUILDSKILLS);

  no_more_busy(1);
}

void advance_guild_special_output(object pl)
{
  int i, tmpn, tmpo, flag;
  mapping skill_new, skill_old;
  string *spells, *spellsn;
  
  no_more_busy();
  
  if((!objectp(pl)) || (!MENV) || (!present(pl, MENV))) return;
  if((!PO) || (PO!=ME)) return;
  
  if(!pay_me(pl, PREIS_ADVANCE)) return 0;
  
  if(SAVER->New_Guild(pl))
    {
      SAVER->Save(pl,GUILDSKILLS);

      sfkt("Ah, Ihr habt also die Gilde gewechselt! Nun, dann muss ich Euch "
	   "neu beurteilen...");
      call_out("sfkt", 1, "Gut, das wars.");
      no_more_busy(1);
      return;
    }

  if(!(skill_old=SAVER->Restore(pl,GUILDSKILLS))) return;
  
  skill_new=copy_mapping(pl->QueryProp(P_NEWSKILLS));

  sfkt("Seit der letzten Beurteilung habt Ihr...");
  
  spells=m_indices(skill_old);
  spells=filter_array(spells, "is_skill");

  spellsn=m_indices(skill_new);
  spellsn=filter_array(spellsn, "is_skill");
  
  if((!sizeof(spellsn)) && (!sizeof(spells)))
    return sfkt("Keine neuen Kampfkuenste hinzugelernt.", 1);
  
  if(sizeof(spellsn) > sizeof(spells))
    spells=spellsn;
  
  spells=sort_array(spells, CLOSURE(sortskills));
  
  for(i=sizeof(spells)-1;i>=0;i--)
    {
      if(!member(skill_new, spells[i]))
	tmpn=0;
      else
	if(intp(skill_new[spells[i]]))
	  tmpn=skill_new[spells[i]];
	else
	  tmpn=skill_new[spells[i]][SI_SKILLABILITY];
      
      if(!member(skill_old, spells[i]))
	tmpo=0;
      else
	if(intp(skill_old[spells[i]]))
	  tmpo=skill_old[spells[i]];
	else
	  tmpo=skill_old[spells[i]][SI_SKILLABILITY];
      
      if(tmpn > tmpo)
	{
	  flag=1;
	  
	  if(!tmpo)
	    sfkt(skill2name(spells[i])+" neu hinzugelernt.");
	  else
	    sfkt(skill2name(spells[i])+" "+int2adv(tmpn, tmpo)+" gesteigert.");
	}
      else
	if(tmpn < tmpo)
	  {
	    flag=1;
	    
	    if(!tmpn)
	      sfkt(skill2name(spells[i])+" komplett verlernt.");
	    else
	      sfkt(skill2name(spells[i])+" "+int2adv(tmpo, tmpn)+" verlernt.");
	  }
    }
  
  if(!flag) sfkt("rein gar nichts dazugelernt!");
  
  SAVER->Save(pl, GUILDSKILLS);  

  no_more_busy(1);
}

varargs void tell_guild_output(object pl, int flag)
{
  int i, sk, count, average;
  mapping s;
  string *spells;
  
  no_more_busy();
    
  if((!objectp(pl)) || (!MENV) || (!present(pl, MENV))) return;
  if((!PO) || (PO!=ME)) return;
  
  if(!pay_me(pl, PREIS_ALLE)) return 0;
  
  s=copy_mapping(pl->QueryProp(P_NEWSKILLS));
  
  spells=m_indices(s);
  spells=filter_array(spells, "no_skill");
  spells=sort_array(spells, CLOSURE(<));
  
  count=0;
  average=0;
  
  for(i=sizeof(spells)-1;i>=0;i--)
    if(f_filter(flag, sk=(intp(s[spells[i]]) ? s[spells[i]] : 
			 s[spells[i]][SI_SKILLABILITY])))
      {
	count++;
	average+=sk;

	tell_room(MENV, 
		  BS("  "+CAP(spells[i])+" beherrscht Ihr "+skill2str(sk)));
      }
  
  if(!flag && !count)
    sfkt("Ihr habt Euch ja noch gar keine Gildenfertigkeiten angeeignet!");
  
  if(flag && !count)
    sfkt("Ihr beherrscht keine der Gildenfertigkeiten "+flag2str(flag)+".");
  
  if(!flag && count)
    {
      sfkt("Ihr beherrscht "+int2str(count)+" Gildenfertigkeit"+
	   (count==1 ? "":"en")+".");
      sfkt("Insgesamt beherrscht Ihr diese "+skill2str(average/count));
    }
  
  if(flag && count)
    sfkt("Ihr beherrscht "+int2str(count)+" Gildenfertigkeit"+
	 (count==1 ? " ":"en ")+flag2str(flag)+".");

  no_more_busy(1);
}

varargs void tell_guild_special_output(object pl, int flag)
{
  int i, sk, count, average;
  mapping s;
  string *spells;
  
  no_more_busy();
  
  if((!objectp(pl)) || (!MENV) || (!present(pl, MENV))) return;
  if((!PO) || (PO!=ME)) return;
  
  if(!pay_me(pl, PREIS_ALLE)) return 0;
  
  s=copy_mapping(pl->QueryProp(P_NEWSKILLS));
  
  spells=m_indices(s);
  spells=filter_array(spells, "is_skill");
  spells=sort_array(spells, CLOSURE(sortskills));

  count=0;
  average=0;

  for(i=sizeof(spells)-1;i>=0;i--)
    if(f_filter(flag, sk=(intp(s[spells[i]]) ? s[spells[i]] : 
			 s[spells[i]][SI_SKILLABILITY])))
      {
	count++;
	average+=sk;
	
	tell_room(MENV, 
		  BS("  "+skill2name(spells[i])+" beherrscht Ihr "+
		     skill2str(sk)));
      }
  
  if(!flag && !count)
    sfkt("Ihr habt Euch ja noch gar keine Kampffertigkeiten angeeignet!");
  
  if(flag && !count)
    sfkt("Ihr beherrscht keine der Kampffertigkeiten "+flag2str(flag)+".");
  
  if(!flag && count)
    {
      sfkt("Ihr beherrscht "+int2str(count)+" Kampffertigkeit"+
	   (count==1 ? "":"en")+".");
      sfkt("Insgesamt beherrscht Ihr diese "+skill2str(average/count));
    }
  
  if(flag && count)
    sfkt("Ihr beherrscht "+int2str(count)+" Kampffertigkeit"+
	 (count==1 ? " ":"en ")+flag2str(flag)+".");

  no_more_busy(1);
}

varargs void tell_external_output(object pl, int flag)
{
  int i, count, average;
  mapping es;
  string *spells;
  
  no_more_busy();
  
  if((!objectp(pl)) || (!MENV) || (!present(pl, MENV))) return;
  if((!PO) || (PO!=ME)) return;
  
  if(!pay_me(pl, PREIS_ALLE)) return 0;
  
  count=0;
  average=0;

  if(mappingp(es=pl->QueryProp(P_EXTERNAL_SKILLS))) // Bugfix Feyaria, es gibt auch spieler ohne external_skills
  { 
    spells=m_indices(es);
    spells=sort_array(spells, CLOSURE(sortskills));

    for(i=sizeof(spells)-1;i>=0;i--)
      if(f_filter(flag, es[spells[i]]))
      {
        count++;
        average+=es[spells[i]];

        tell_room(MENV, 
            BS("  "+CAP(skill2name(spells[i])+" beherrscht Ihr "+
              skill2str(es[spells[i]]))));
      }
  } 

  if(!flag && !count)
    sfkt("Ihr habt Euch ja noch gar keine Fertigkeiten angeeignet!");
  
  if(flag && !count)
    sfkt("Ihr beherrscht keine der Fertigkeiten "+flag2str(flag)+".");
  
  if(!flag && count)
    {
      sfkt("Ihr beherrscht "+int2str(count)+" Fertigkeit"+
	   (count==1 ? "":"en"));
      sfkt("Insgesamt beherrscht Ihr diese "+skill2str(average/count));
    }
  
  if(flag && count)
    sfkt("Ihr beherrscht "+int2str(count)+" Fertigkeit"+
	 (count==1 ? " ":"en ")+flag2str(flag)+".");
  
  no_more_busy(1);
}

