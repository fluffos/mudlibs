nosave string advance_guild(string str)
{
  if(busy) return 0;

  get_busy();

  if(file_size(SKILLSAVE+getuid(TP)+".o") > 0)
    return call_out("advance_guild_output", 4, TP), 
      "meint: Mal sehen was sich geaendert hat...\n";
  else
    call_out("advance_new", 4, TP);

  return "meint: Euch habe ich ja noch nie eingeschaetzt...\n";
}

