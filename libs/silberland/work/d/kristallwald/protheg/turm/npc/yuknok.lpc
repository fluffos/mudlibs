#define PREIS_EINZELN 100
#define PREIS_ADVANCE 1000
#define PREIS_FP 200
#define PREIS_FP_EINZELN 1000

#define TREASURE NPC "t"

nosave mapping name_2_skill= NAME2SKILL + ([
        "zweihandkampf":SK_TWOHANDED, 
        "bihandkampf":SK_TWOHANDED, 
        "zaubern":SK_CASTING, 
        "nachtsicht":SK_NIGHTVISION, 
        "alkoholtrinken":SK_BOOZE, 
        "saufen":SK_BOOZE, 
        "schleichen":SK_QUIETWALK, 
        "handkampf":FIGHT(WT_HANDS),
        "axtkampf":FIGHT(WT_AXE),
        "schwertkampf":FIGHT(WT_SWORD),
        "keulenkampf":FIGHT(WT_CLUB),
        "peitschenkampf":FIGHT(WT_WHIP),
        "speerkampf":FIGHT(WT_SPEAR),
        "messerkampf":FIGHT(WT_KNIFE),
	      "kettenkampf":FIGHT(WT_CHAIN),
	      "bogenkampf":FIGHT(WT_BOW),
        "singen":SK_SINGING,
        "musizieren":SK_MUSIC,
        "kaempfen":SK_FIGHT
	]);

nosave mapping skill_2_name= SKILL2NAME + ([ 
        FIGHT(WT_HANDS):"Handkampf", 
        FIGHT(WT_AXE):"Axtkampf", 
        FIGHT(WT_SWORD):"Schwertkampf", 
        FIGHT(WT_CLUB):"Keulenkampf", 
        FIGHT(WT_WHIP):"Peitschenkampf", 
        FIGHT(WT_SPEAR):"Speerkampf", 
        FIGHT(WT_KNIFE):"Messerkampf", 
        FIGHT(WT_CHAIN):"Kettenkampf", 
        FIGHT(WT_BOW):"Bogenkampf", 
        SK_TWOHANDED:"Zweihandkampf", 
        SK_CASTING:"Zaubern", 
        SK_MAGIC_ATTACK:"Magische Attacken", 
        SK_MAGIC_DEFENSE:"Magische Abwehr", 
        SK_NIGHTVISION:"Nachtsicht", 
        SK_BOOZE:"Alkoholtrinken", 
        SK_QUIETWALK:"Schleichen",
        SK_SINGING:"Singen",
        SK_MUSIC:"Musizieren",
        SK_FIGHT:"Kaempfen"
	]);

public string skill2name(string skill) {
  if(member(skill_2_name, skill)) return skill_2_name[skill];

  if(skill[0..9] == "Heldentum_") return "Verkoerperung der Helden";
  return "Irgendetwas";
}

