  get_busy();
  
  call_out("tell_fp_percentage_output", 4, TP, str);
  
  return "denkt kurz nach.\n";
}

nosave string einzeln(string str)
{
  string arg0, arg1;

  if(!str) return 0;
  
  if(busy) return 0;
  
  str=implode(explode(TP->_unparsed_args(), " ")[2..<1], " ");
  
  str=lower_case(str);
  
  if(member(({"gildensteigerung","gildenfaehigkeitensteigerung",
		"gildenfertigkeitensteigerung"}), str)!=-1)
    return advance_guild(str);

  if(member(({"faehigkeitensteigerung","fertigkeitensteigerung"}), str)!=-1)
    return advance_external(str);
  
  if(member(({"kampfkunststeigerung","kampffertigkeitensteigerung",
		"kampffaehigkeitensteigerung","kampfsteigerung"}), str)!=-1)
    return advance_guild_special(str);  

  if(member(({"gildenfaehigkeiten","gildenfertigkeiten"}), str)!=-1)
    return tell_guild(str);

  if(member(({"faehigkeiten","fertigkeiten"}), str)!=-1)
    return tell_external(str);
  
  if(member(({"kampfkunst","kampffaehigkeiten","kampffertigkeiten"}), str)!=-1)
    return tell_guild_special(str);
  
  if(member(fpquestions, str)!=-1)
    return tell_fp_percentage(str);
  
  if(member(({"forscherpunkte","forscherpunkt","forschen","fp","fps"}), 
	    str)!=-1)
    return tell_fp_all_questions(str);
  
  if(sizeof(explode(str, " "))==2)
    {
      arg1=explode(str, " ")[1];
      arg0=explode(str, " ")[0];

      switch(arg1)
	{
	case "unterdurchschnittlich":
	  if(member(({"gildenfaehigkeiten","gildenfertigkeiten"}), 
		    arg0)!=-1)
	    return tell_guild(arg0, 1);

	  if(member(({"faehigkeiten","fertigkeiten"}), 
		    arg0)!=-1)
	    return tell_external(arg0, 1);
  
	  if(member(({"kampfkunst","kampffaehigkeiten","kampffertigkeiten"}), 
		    arg0)!=-1)
	    return tell_guild_special(arg0, 1);

	case "ueberdurchschnittlich":
	  if(member(({"gildenfaehigkeiten","gildenfertigkeiten"}), 
		    arg0)!=-1)
	    return tell_guild(arg0, 2);

	  if(member(({"faehigkeiten","fertigkeiten"}), 
		    arg0)!=-1)
	    return tell_external(arg0, 2);
  
	  if(member(({"kampfkunst","kampffaehigkeiten","kampffertigkeiten"}), 
		    arg0)!=-1)
	    return tell_guild_special(arg0, 2);

	case "hervorragend":
	  if(member(({"gildenfaehigkeiten","gildenfertigkeiten"}), 
		    arg0)!=-1)
	    return tell_guild(arg0, 3);

	  if(member(({"faehigkeiten","fertigkeiten"}), 
		    arg0)!=-1)
	    return tell_external(arg0, 3);
  
	  if(member(({"kampfkunst","kampffaehigkeiten","kampffertigkeiten"}), 
		    arg0)!=-1)
	    return tell_guild_special(arg0, 3);

	case "perfekt":
	  if(member(({"gildenfaehigkeiten","gildenfertigkeiten"}), 
		    arg0)!=-1)
	    return tell_guild(arg0, 4);

	  if(member(({"faehigkeiten","fertigkeiten"}), 
		    arg0)!=-1)
	    return tell_external(arg0, 4);
  
	  if(member(({"kampfkunst","kampffaehigkeiten","kampffertigkeiten"}), 
		    arg0)!=-1)
	    return tell_guild_special(arg0, 4);
	}
    }
  
  call_out("einzeln_output", 2, TP, str);	   
  
  get_busy();
  
  return "beugt sich vor...\n";
}

void einzeln_output(object pl, string spell)
{
  mapping s,es;
  
  no_more_busy();
  
  if((!objectp(pl)) || (!MENV) || (!present(pl, MENV))) return;
  if((!PO) || (PO!=ME)) return;

  s=pl->QueryProp(P_NEWSKILLS);
  es=pl->QueryProp(P_EXTERNAL_SKILLS);
  spell=lower_case(spell);
  
  if(member(m_indices(s), spell)!=-1)
    {
      if(!pay_me(pl, PREIS_EINZELN)) return; 
      
      sfkt(CAP(spell)+" beherrscht Ihr "+
	   skill2str((intp(s[spell]) ? 
		      s[spell] : s[spell][SI_SKILLABILITY])));
      
      if((mappingp(s[spell])) && (s[spell][SI_USR]))
	sfkt(CAP(spell)+" habt Ihr bereits "+s[spell][SI_USR]+" mal gesprochen.");
      no_more_busy(1);
      
      return;
    }
  
  if(member(m_indices(name_2_skill), spell)!=-1)
    if(IS_VALID_SKILL(name_2_skill[spell]))
      {
	if(!pay_me(pl, PREIS_EINZELN)) return; 
	
	sfkt(CAP(spell)+" beherrscht Ihr "+skill2str(es[name_2_skill[spell]]));
	
	no_more_busy(1);
	
	return;
      }
    else
      if(member(m_indices(s), name_2_skill[spell])!=-1)
	{
	  if(!pay_me(pl, PREIS_EINZELN)) return; 
	  
	  sfkt(CAP(spell)+" beherrscht Ihr "+
	       skill2str(s[name_2_skill[spell]][SI_SKILLABILITY]));
	  
	  no_more_busy(1);
	  return;
	}

  if(member(m_indices(inf), spell)!=-1)
    {
      sfkt(inf[spell], 1);
      
      return;
    }
    
  sfkt(({"Stoert meine Meditation nicht.",
	   "Habt Ihr nichts besseres zu tun?",
	   "Wollt Ihr etwas ueber Euch erfahren?",
	   "Und deswegen stoert Ihr mich?!",
	   "Ooooohmmmmm..."})[random(3)], 1);
}

void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Yuknok, das Orakel sitzt auf dem Thron");
  SetProp(P_LONG,
	  BS("Das is Yuknok, das maechtige Orakel!")+
	  BS("Es sitzt hier auf seinem Steinthron und meditiert nur vor sich "
	     "hin. Eine grosse dunkle Kutte verdeckt seinen Koerper und Kopf "
	     "daher kannst Du sonst nicht viel erkennen."));
  
  SetProp(P_NAME, ({"Yuknok, das Orakel","Yuknok, des Orakels",
		      "Yuknok, dem Orakel","Yuknok, das Orakel"}));
  SetProp(P_GENDER, NEUTER);
  
  AddDetail(({"kutte"}),
	    "Das Orakel ist beinahe vollstaendig von einer Kutte umgeben.");

  AddDetail(({"kopf"}),
	    "Der gesamte Kopf ist von der Kutte bedeckt.");
  
  AddDetail(({"koerper"}),
	    "Der gesamte Koerper ist von der Kutte bedeckt.");
  
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-10,T_RANGE_MAX:40]));

  AddId(({"yuknok", "orakel", "\nskill_orakel", "NOWIMPY", "NOCONTROL"}));
  set_living_name("yuknok");

  create_default_human(40);
  SetAttribute(A_INT, 75);
  
  SetProp(P_MAX_SP, QueryProp(P_MAX_SP) * 2);
  SetProp(P_SP, QueryProp(P_MAX_SP));

  SetProp(P_HANDS, ({" mit seinen Haenden", QueryProp(P_HANDS)[1], DT_RIP}));
  
  SetProp(P_BODY, QueryProp(P_BODY)+10);
  SetProp(P_XP, 0);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC, 40);
  SetProp(P_NOATTACK, "meditiert einfach weiter.");

  SetProp(P_MSGIN, "materialisiert sich aus einem Schatten und setzt sich auf "
	  "seinen Thron");
  SetProp(P_MSGOUT, "verschwindet in den Schatten");
  
  SetProp(P_NOCORPSE, 1);
  
  AddInfo(DEFAULT_INFO, CLOSURE(einzeln));
  
  AddInfo(({"altar","kutte","spinne","riesenspinne","thron","steinthron",
	      "silberland","sex"}),
	  "meditiert weiter.");
  
  AddInfo("bla bla", "grinst.");
  
  SetProp(P_REJECT, ({ REJECT_KEEP, "Das Orakel steckt Dein Geschenk ein.\n"}));

  busy=0;
  fpquestions=QueryQuestions();

  SUID;
}

void reset()
{
  if(!is_clone(TO)) return;
  ::reset();
  
  if(busy> time()+10)
    no_more_busy(1);
  
  fpquestions=QueryQuestions();
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if(find_call_out("reaction") != -1) return;

  if(touch)
    if(random(2))
      call_out("reaction", 0, TP,
	       "Als Du das Orakel beruehrst, leuchtet Yuknok kurz auf...",
	       "Als "+TPN+" das Orakel beruehrt, leuchtet Yuknok kurz auf...");
    else
      call_out("reaction", 0, TP,
	       "Als Du das Orakel beruehrst, springt ploetzlich ein Funken "
	       "auf Dich ueber...",
	       "Als "+TPN+" das Orakel beruehrt, springt ploetzlich ein "
	       "Funken ueber...");
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

varargs void reaction(object ob, string macher, string andere)
{
  if (present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(macher));
      tell_room(ENV(TO), BS(andere), ({ob}));
      ob->AddSp(-10-random(6));
    }
}
