/*
** Eine kleine Lichtung mit einem Baum in der Mitte
**
**
*/

#include "../def.h"

inherit "std/room";

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einer kleinen Lichtung");
  SetProp(P_INT_LONG,
	  BS("Du findest Dich auf einer kleinen Lichtung wieder. Niemals "
	     "haettest Du gedacht, dass es hier im Kristallwald so ein "
	     "schoenes Plaetzchen gibt. Das Gras sieht sehr gesund aus... "
	     "Muss wohl an der guten Erde liegen. In der Mitte der Lichtung "
	     "steht majestaetisch eine Eiche aus Kristall, die eine magische "
	     "Aura auszustrahlen scheint. Der Rand des Platzes wird von "
	     "kristallenen Bueschen umgeben und dahinter ragen die Baeume "
	     "des Kristallwaldes in den Himmel. "
	     "Eigentlich willst Du den Wald erst gar nicht betreten, da es "
	     "hier so gemuetlich erscheint. Hier ist genau der richtige "
	     "Platz, um etwas zu verweilen..."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_FOREST]));
  
  AddDetail(({"platz","plaetzchen","lichtung"}),
	    QueryProp(P_INT_LONG));
  
  AddDetail(({"boden","gras","wiese"}),
	    "Das Gras sieht sehr gesund aus, anscheinend wird es von "
	    "Irgendwem gepflegt. Die Erde muss aus gutem Humus bestehen.");
  
  AddDetail(({"erde"}),
	    "Dem Gras nach zu urteilen, scheint die Erde hier sehr "
	    "fruchtbar zu sein.");
  
  AddDetail(({"mitte"}),
	    "In der Mitte der Lichtung ragt eine gewaltige Eiche aus Kristall "
	    "empor.");
  
  AddDetail(({"humus"}),
	    "Humus wird von den Druiden als Element bezeichnet.");
  
  AddDetail(({"druiden","druide"}),
	    "Angeblich wohnt hier ein Druide...\n"
	    "Eventuell sogar da oben auf dem Baum?");
  
  AddDetail(({"element","elemente"}),
	    "Die Druiden haben mehrere Elemente.");
  
  AddDetail(({"baum", "eiche", "kristalleiche"}),
	    "Der Baum ist von einer magischen Aura umgeben. Er wirkt sehr "
	    "beeindruckend auf Dich. Um den Baum wickelt sich eine riesige "
	    "Ranke, die fast wie eine Wendeltreppe aussieht...");
  
  AddDetail(({"treppe","wendeltreppe","ranke"}),
	    "Diese Ranke ist wirklich sehr merkwuerdig gewachsen. Du glaubst "
	    "Stufen zu erkennen!");
  
  AddDetail(({"stufe","stufen"}),
	    "Ob Du ueber die Stufen nach oben gelangen kannst?");
  
  AddDetail(({"aura"}),
	    "Anscheinend wird der Baum von einem maechtigen Zauber "
	    "geschuetzt.");
  
  AddDetail(({"zauber"}),
	    "Druiden sind sehr eng mit der Natur verbunden.");
  
  AddDetail(({"natur"}), 
	    "Na du wirst doch wohl wissen, was die Natur ist!");
  
  AddDetail(({"rand"}),
	    "Am Rand der Lichtung wachsen einige Buesche, dahinter beginnt "
	    "der Wald.");
  
  AddDetail(({"busch","buesche"}),
	    "Die Buesche tragen keine Beeren, sehen aber trotzdem "
	    "gesund aus.");
  
  AddDetail(({"beeren"}),
	    "Anscheinend hat sie Irgendwer bereits gepflueckt.");
  
  AddDetail(({"baeume","zaun"}),
	    "Die Baeume schuetzen die Lichtung wie ein Zaun.");
  
  AddDetail(({"kristall"}),
	    "Im Kristallwald besteht praktisch jeder Baum, jede Pflanze "
	    "aus Kristall...");
  
  AddDetail(({"pflanze","pflanzen"}),
	    "Welche Pflanze suchst Du denn? Hier gibt es so viele!");
  
  AddDetail(({"kristallwald","wald"}),
	    "Der Kristallwald ist wirklich gross! Du befindest Dich schon "
	    "lange in Ihm.");
  
  AddDetail(({"wald"}),
	    "Der Wald um die Lichtung ist sehr dicht. Du kannst nur ein paar "
	    "Meter weit in ihn hineinsehen...");
  
  AddDetail(({"meter"}), 
	    "Du solltest wissen was ein Meter ist :)");
  
  AddDetail(({"himmel"}),
	    "Du siehst keine Wolke am Himmel, heute ist echt super Wetter.");
  
  AddDetail(({"wolke", "wolken"}),
	    "Der Himmel ist vollkommen wolkenfrei.");
  
  AddDetail(({"wetter"}),
	    "Das Wetter ist heute perfekt!");
  
  AddSound(({"stille", DEFAULT_SOUND}),
	   "Hier auf der Lichtung herrscht eine andaechtige Stille...");
  
  AddSmell(({"waldluft","luft", DEFAULT_SMELL}),
	   "Es liegt der angenehme Geruch des Waldes in der Luft.");
  
  AddSmell(({"geruch","wald"}),
	   "Du atmest die Waldluft tief ein und erfreust Dich am Geruch "
	   "des Waldes.");

  AddCmd(CMD_KLETTERN, "raufklettern");

  AddExit("osten", ([ EX_DEST: LUMIN_SEE, EX_MSG: "nach Osten"]));
  AddExit("lumin", 
	  ([ EX_DEST: "/d/seher/haus/lumin:00:00", 
	     EX_MSG: "in Lumins Seherhaus"]));
  SetProp(P_HIDE_EXITS, ({"oben"}));
}

nosave int raufklettern(string str)
{
  notify_fail(BS("Wo willst Du denn raufklettern?"));
  if(!str) return 0;
  
  if(str=="auf baum"||str=="auf baum rauf"||str=="auf baum hinauf"||
     str=="auf eiche"||str=="auf eiche rauf"||str=="auf eiche hinauf"||
     str=="nach oben"||str=="rauf")
    return write(BS("Du kannst einfach ueber die Treppe nach 'oben' "
		    "gehen.")), 1;
  return 0;
}
