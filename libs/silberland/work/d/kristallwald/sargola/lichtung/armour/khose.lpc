#include "../def.h"

inherit "std/armour";

void create()
{
  if (!is_clone(this_object())) return;   ::create();
  
  SetProp(P_SHORT, "Eine Filzhose");
  SetProp(P_LONG,
	  BS("Eine dunkelgruen-braune Hose aus schwerem, widerstandsfaehigem "
	     "Filz. Die Hose ist an den Knien schon sehr ausgebeult."));
  
  AddDetail("filz",
	    "Der Filz ist sehr dick und um die Knie ausgebeult.");
  
  SetProp(P_NAME, "Filzhose");
  
  AddId(({"filzhose", "hose"}));
  
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 440);
  SetProp(P_VALUE, 300);
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_MATERIAL, MAT_FELT);
  SetProp(P_AC, 3);  
}
