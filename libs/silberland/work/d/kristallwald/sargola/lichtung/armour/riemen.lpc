inherit "std/armour";
#include <properties.h>


void create()
{
   if (!is_clone(this_object())) return;   ::create();

   SetProp(P_SHORT, "Ein Lederriemen");
   SetProp(P_LONG,
      "Ein alter, schon speckiger Lederriemen, der wohl als Guertel "
	+"gute Dienste geleistet hat.\n");

   SetProp(P_NAME, "Lederriemen");

   AddId(({ "lederriemen", "guertel","riemen"}));

   SetProp(P_GENDER, MALE);
   SetProp(P_WEIGHT, 200);
   SetProp(P_VALUE, 75);
   SetProp(P_ARMOUR_TYPE, AT_BELT );

   SetProp(P_AC, 1);
}
