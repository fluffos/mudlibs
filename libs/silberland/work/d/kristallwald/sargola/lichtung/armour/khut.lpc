#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Filzhut");
  SetProp(P_LONG,
	  BS("Ein schwerer, breitkrempig und gegen Regen schuetzender "
	     "Hut aus gruenem Filz."));
  
  AddDetail("filz",
	    "Der Filz ist sehr stark und schuetzt sicher gegen starken "
	    "Regen.");
  
  SetProp(P_NAME, "Filzhut");
  AddId(({"filzhut", "hut"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 100);
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, MAT_FELT);
}

