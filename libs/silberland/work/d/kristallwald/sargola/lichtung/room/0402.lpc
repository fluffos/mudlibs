#include "../def.h"
#include "lichtung.h"

inherit "std/room";

#define RICHTUNG  "Suedwesten"

nosave int mohnblumenanzahl;
nosave int kornblumenanzahl;
nosave int gaensebluemchenanzahl;

void create()
{
  ::create();
  
  kornblumenanzahl=0;
  mohnblumenanzahl=1;
  gaensebluemchenanzahl=1;
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]) );
  
  SetProp(P_INT_SHORT, "Eine Lichtung");
  SetProp(P_INT_LONG,
	  BS("Du befindest Dich auf einer Lichtung westlich von Elessar. "
	     "Um Dich herum siehst Du im "+RICHTUNG+" einen umgestuerzten "
	     "Baum. In der Wiese bluehen vielerlei Blumen und die Sonne "
	     "scheint warm auf Dich herab. Im Norden befindet sich dichter "
	     "Wald."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail("lichtung",
	    "Die Lichtung breitet sich nach "+RICHTUNG+" aus "
	    "und ist vom dichten Kristallwald umgeben.");
  
  STANDARD
  SS

  AddDetail("wald",
	    "Der Wald ist hier zu dicht, um weiter vordringen zu koennen.");
  
  AddCmd(({"pfluecke","pflueck"}), "pfluecken");

  AddExit("westen",ROOM "0302");
  AddExit("sueden",ROOM "0403");
  AddExit("suedosten",ROOM "0503");

  AddItem(NPC "biene", REFRESH_DESTRUCT);
  AddItem(NPC "biene", REFRESH_DESTRUCT);
}

void reset()
{
  ::reset();
  
  kornblumenanzahl=0;
  mohnblumenanzahl=1;
  gaensebluemchenanzahl=1;
}

BLUMEN
