#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Eine Lichtung im Dickicht");
  SetProp(P_INT_LONG,
	  BS("Du stehst in einer kleinen Lichtung mitten im Dickicht. Endlich "
	     "kannst Du wieder den Himmel sehen und frische Luft riechen. "
	     "Rundherum stehen dicht gedraengt Baeume und bilden eine "
	     "undurchlaessige Wand. "));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);

  AddDetail("wand",
	    "Sie wird von Baeumen gebildet und niemand kommt da durch.");
  
  AddDetail("lichtung",
	    "Die Lichtung ist so in etwa 4 mal 4 Meter gross und wird "
	    "von dicht wachsenden Baeumen umschlossen.");
  
  AddDetail("dickicht",
	    "Du stehst ja mitten in Straeuchern.");
  
  AddDetail("boden",
	    "Der Boden ist mit abgebrochenen Zweigen und Blaettern "
	    "bedeckt. Wenn Du gehst, daempft er Deine Schritte sanft.");
  
  AddDetail("blaetter",
	    "Die Blaetter liegen am Boden.");
  
  AddDetail("schritte",
	    "Deine Schritte kann man durch die Eindruecke auf dem Boden "
	    "noch gut erkennen.");
  
  AddDetail("eindruecke",
	    "Die unterschiedlich tiefen Eindruecke zeigen deutlich, dass "
	    "hier vor kurzem jemand gegangen ist. Ob das etwa Du warst?");
  
  AddDetail("tiefe",
	    "Die Eindruecke sind alle etwa gleich tief, nur einer weist eine "
	    "seltsame Woelbung auf.");
  
  AddDetail("woelbung",
	    "Die Woelbung ist gleichmaessig rund. Das solltest Du Dir "
	    "vielleicht naeher ansehen.");

  AddDetail(({"straeucher","baeume"}),
	    "Sie stehen um Dich herum und verbergen die Sicht.");
  
  AddDetail("sicht",
	    "Du hast keine.");
  
  AddDetail("luft",
	    "Riech doch mal!");
  
  AddSmell("luft",
	   "Sie riecht frisch, nicht so schal wie im Dickicht vorhin.");

  AddDetail("dickicht",
	    "Unter den vielen Straeuchern.");
  
  AddDetail(({"zweige","aeste"}),
	    "Wenn Du zu schnell gehst, schlagen sie Dir ins Gesicht.");
  
  AddDetail("gesicht",
	    "Wow! Ein derart wunderschoens Gesicht hast du selten gesehen!");
  
  AddDetail(({"strahl","sonnenstrahl", "strahlen","sonnenstrahlen"}),
	     "Im Gegensatz zu dem duesteren Gang ist es hier angenehm hell.");
  
  AddDetail("himmel",
	    "Ueber Dir liegt der tiefblaue Himmel.");
  
  AddDetail("wald",
	    "Hmm...Du weisst gar nicht, wo Du hier anfangen sollst vor "
	    "lauter Wald...");
  
  AddItem(NPC "d", REFRESH_DESTRUCT);

  AddExit("osten", ROOM "gang1");
}

void init()
{
  ::init();

  if(!TP) return;
  if(!TP->query_once_interactive()) return;
 
  call_out("level_check", 1, TP);
}

void level_check(object pl)
{ 
  if(!pl) return;
  if(!present(pl)) return;

  if(pl->QueryProp(P_LEVEL) > 20) return;

  tell_room(TO, 
	    BS("Als "+TPN+" den Raum betritt verschlingt der Drache "+
	       CAP(TP->query_real_name())+" mit Haut und Haaren! Als "
	       "er merkt, wie winzig die Mahlzeit war, spuckt er " +
	       CAP(TP->query_real_name())+ " gleich wieder in weitem "
	       "Bogen aus.\n"), ({TP}));
  
  tell_object(TP, 
	      BS("Als Du den Raum betrittst verschlingt Dich der Drache "
		 "gierig mit Haut und Haaren!!")+
	      BS("Doch als er sieht, wie wenig an Dir dran ist, spuckt "
		 "er Dich in weitem Bogen wieder aus!")+"\n");
  
  TP->move(ROOM "0314", M_GO|M_NO_SHOW,"in weitem Bogen fort",
	   "fliegt","kommt in weitem Bogen angeflogen");
  
  TP->do_damage(20);
}
