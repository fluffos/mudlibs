#include "../def.h"
#include "lichtung.h"

inherit "std/room";

#define QUESTKEY "Die alte Zeder"

#define RICHTUNG "um Dich herum"

#define CHK_TIME 15		//alle 15 secs wird kontrolliert, ob wer idelt...
#define MAX_CHK_TIME 180	//solang wird kontrolliert, ob wer idelt...
#define MAX_IDLE_TIME 150	//nach 150 secs ist man nuts ;)

nosave mapping entered = ([]);
nosave int lastmed =0;

get_nuts();		//Setzt den player auf P_ISNUT :))

nosave mixed messages=({
  "Du fuehlst Dich hier nicht sicher.\n",
    "Du hast das Gefuehl einer Bedrohung.\n",
    "Dir steigt Angstschweiss ins Gesicht...\n", 
    "Du merkst intuitiv, dass Du hier schnell verschwinden solltest...\n",
    "Du blickst Dich eingeschuechtert um.\n"});

nuts1();
nuts2();
nuts3();

loch();
beobachtung1();
beobachtung2();
beobachtung3();

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Eine Lichtung");
  SetProp(P_INT_LONG,
	  BS("Du befindest Dich im Zentrum der Lichtung, genau bei dem Baum. "
	     "Er liegt umgestuerzt vor Dir. Die Wurzeln des Baumes haben "
	     "einen grossen Krater in die Wiese gerissen. Du fuehlst Dich "
	     "hier sehr unwohl - weisst aber nicht genau, warum..."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]) );
  
  STANDARD
  SS
  
  AddDetail(({"zentrum","lichtung"}),
	     "Du stehst genau im Zentrum der Lichtung.");	

  AddDetail(({"zeder","baum"}),
	    "Du stehst vor einer riesigen, alten Zeder, die sicher schon "
	    "einige hundert Jahre alt ist. Ihr Stamm ist wohl von "	
	    "einem Blitz gespalten, fast alle Aeste sind abgebrochen. "	
	    "Ihre Wurzeln liegen komplett im Freien. Der Baum muss "
	    "wohl in einem verheerenden Sturm von einem Blitz zersch"	
	    "mettert worden sein.");
  
  AddDetail("himmel",
	    "Der Himmel leuchtet tiefblau ueber Dir. Die Sonne strahlt "
	    "und verbreitet eine sanfte Waerme.");
  
  AddDetail("stamm",							
	    "Der Stamm ist durch einen Blitz gespalten. Und durch den "	
	    "Sturm wurde der Baum aus dem Boden gerissen. Er liegt nun "
	    "brach und fahl vor Dir. Die meisten Aeste sind durch den "	
	    "Sturz abgebrochen.");
  
  AddDetail("blitz",							
	    "Von dem Blitz sind nur mehr die Auswirkungen zu sehen. Der "
	    "Stamm ist bis zum Boden gespalten.");
  
  AddDetail(({"ast","aeste"}),						
	    "Die meisten Aeste sind geknickt und abgestorben. Obwohl "	
	    "es vermutlich gar nicht so lang her ist, dass ein "
	    "Sturm diese Wurzeln freigelegt hat.");			
  
  AddDetail("sturm",							
	    "Du kannst nur die Folgen des Sturmes erkennen - der Stamm "
	    "spricht Baende...");
  
  AddDetail(({"wurzel","wurzeln"}),					
	    "Die Wurzeln sind definitiv nicht mehr dort, wo sie "
	    "normalerweise hingehoeren. Durch den Sturm wurde ein grosser "
	    "Teil von ihnen aus dem Erdreich gerissen. Sie sind schon "	
	    "vertrocknet. Es muss ein gewaltiger Wind gewesen sein, "	
	    "der diesen Baum entwurzelte.");				
  
  AddDetail("teil",							
	    "Die freigelegten Wurzeln haben sicher einen Durchmesser "	
	    "von 3-4 Metern.");						
  
  AddDetail("durchmesser",					
	    "Naja, wie gesagt... 3-4 Meter halt.");    
  
  AddDetail(({"krater","erdreich"}),
	    "Du huepfst in den kleinen Krater hinunter, der so einein"	
	    "halb Meter tief ist. Das Erdreich hier war einmal sehr "	
	    "gesund, wie Du an den vielen kleinen Loechern von Regen-"	
	    "und Erdwuermern. Du entdeckst auch ein groesseres Loch "	
	    "im unteren Bereich.");
  
  AddDetail("bereich",							
	    "Im unteren Bereich siehst Du ein groesseres Loch.");
  
  AddDetail("loecher",							
	    "Eine Unzahl von kleinen, unregel maessig verteilten "
	    "Loechern zeugen von einst regen Leben unter dem Baum.");	
  
  AddDetail("unzahl",
	    "Eine Unzahl ist eine grosse Menge.");
  
  AddDetail("menge",
	    "Eine Menge ist eine Unzahl.");
  
  AddDetail("leben",
	    "Nun ist ausser den Loechern nicht mehr viel davon zu "
	    "sehen.");
  
  AddDetail(({"erdwuermer","regenwuermer","wuermer"}),
	    "Die sind hier nicht mehr zu sehen. Aber deren Wohnungen "
	    "sind noch ganz deutlich zu erkennen...");
  
  AddDetail(({"wohnung","wohnungen"}),
	    "Die Loecher waren wohl so eine Art Wohnung fuer die Wuermer...");
  
  /*
    AddDetail("loch",
	"Das Loch hier ist kein uebliches Loch, wie Du es sonst hier "
	"ueberall finden kannst. Es ist frisch gegraben, vermutlich "
	"stammt es von der eigenartigen Person... Was hier wohl "
	"einmal gelegen hat?");
  */
  
  AddDetail("loch", CLOSURE(loch));	
  
  RemoveSound(0);
  RemoveSmell(0);
  
  AddSound(DEFAULT_SOUND,
	   "Hier herrscht Stille.");
  
  AddSound(({"stille","geraeusche"}),
	   "Hier herrscht Stille, alle ueblichen Geraeusche des Waldes "
	   "hoerst Du hier seltsamerweise nicht...");
  
  AddSound(({"wald"}),
	   "Nein, Du hoerst definitiv nichts...");
  
  AddSmell(({"moder", DEFAULT_SMELL}),
	   "Es riecht hier sehr modrig...");
  
  AddCmd(({"grabe","grab"}),"grabe");
  
  AddExit("norden", ROOM "0302");
  AddExit("osten",  ROOM "0403");
  AddExit("sueden", ROOM "0304");
  AddExit("westen", ROOM "0203");
}

void init()
{	
  //***************************
  //Ob er die Sequenz sieht....
  //***************************
	
  object ob;
  
  ::init();

  if(ob=present("\nzedernquestobject",TP))
    {
      if(!present("\nscript_lexana",TP) && (!ob->frage_zaehler()))
	CLONE(OBJ "scr_lex", TP);
      
      if((find_call_out("beobachtung1")==-1) &&
	 (find_call_out("beobachtung2")==-1) &&
	 (find_call_out("beobachtung3")==-1) &&
	 (objectp(ob)) && (!ob->frage_zaehler()))
	call_out("beobachtung1", 0);
    }

  //*****************************
  //Ob er verrueckt wird...
  //*****************************
  
  if((!TP) || (!query_once_interactive(TP))) return ;

  if(find_call_out("chk_idle")==-1)
    call_out("chk_idle", CHK_TIME);

  entered[getuid(TP)]=lastmed=time();
}

void chk_idle()
{
  int *ind;
  int i;
  object player;
  
  while(remove_call_out("chk_idle")!=-1);
  
  //**************************************
  //Nach 3 Minuten hoert er auf zu checken,
  //ob jemand verrueckt wird...
  //***************************************
  if(time()-lastmed > MAX_CHK_TIME)
    {
      entered = ([]);
      return;
    }
  
  ind = m_indices(entered);
  
  for(i=sizeof(ind)-1;i>=0;i--)
    {
      //**********************************
      //Der Spieler ist schon weitergegangen..
      //***********************************
      player=find_player(ind[i]);
      
      if(!objectp(player)) 
	{ 
	  entered=m_delete(entered, ind[i]);
	  return ; 
	}
		
      if(!present(player, TO) )
	entered=m_delete(entered,ind[i]);
      else
	if(time()-entered[ind[i]] >MAX_IDLE_TIME)
	  {
	    entered = m_delete(entered,ind[i]);

	    if(!present("\nbesessenheit", TP))
	      get_nuts(TP);
	  }
	else
	  write(messages[random(sizeof(messages))]);
    }
  
  call_out("chk_idle",CHK_TIME);
}

void get_nuts(object pl)
{	
  if(!pl) return;
  if(!present(pl)) return;
  if(pl->QueryProp(P_LEVEL)<=4) return;

  if(TP->QueryQuest(QUESTKEY)) return;

  if(IS_WIZARD(TP)) return;

  if(!present("\nscript_nuts", TP))
    CLONE(OBJ "scr_nuts", TP);
  
  call_out("nuts1", 0, pl);
}

void nuts1(object pl)
{
  if(!pl) return;
  if(!present(pl)) return;

  tell_object(pl, BS("Ein leichter Wind beginnt sich zu heben..."));

  call_out("nuts2", 3, pl);
}

void nuts2(object pl)
{
  if(!pl) return;
  if(!present(pl)) return;

  tell_object(pl,
	      BS("Du merkst, wie eine fremde Macht versucht, sich zu mani"
		 "festieren. Sie dringt in Deinen Koerper ein..."));
  
  call_out("nuts3", 3, pl);
}

void nuts3(object pl)
{
  if(!pl) return;
  if(!present(pl)) return;
  
  tell_object(pl,
	      BS("Die Macht ergreift von Deinem Geist besitz!")+
	      BS("Du bist von der Macht besessen..."));
  
  if(!present("\nbesessenheit", TP))
    CLONE(OBJ "besessen", TP);
  
  PRO("*** Kristallwald: "+TPN+" wird besessen!\n");
  
  catch(present("\nscript_nuts",TP)->remove());
}
	
void beobachtung1()
{
  if((!TP) || (!present(TP))) return;
  
  write("\n"+
	BS("Du gehst auf den Baum zu und bemerkst eine Person, die "
	   "sich gerade an den Wurzeln zu schaffen macht. Intuitiv gehst Du "
	   "einige Schritte zurueck, duckst Dich und beobachtest..."));
  call_out("beobachtung2",3);
}

void beobachtung2()
{
  if((!TP) || (!present(TP))) return ;
  write("\n"+
	BS("Du kannst die Person nicht erkennen, nur dass sie weiblich ist. "
	   "Sie scheint etwas zu suchen und graebt verbissen im Erdreich."));

  call_out("beobachtung3",3);
}

void beobachtung3()
{
  object ob;
  if(!present(TP, TO)) return ;

  ob=present("\nzedernquestobject",TP);

  if(!ob->frage_zaehler())
    {
      write("\n"+
	    BS("Dann scheint sie zu finden, was sie sucht. Es sind Knochen! "
	       "Sie steckt mehrere Knochen in einen Sack und verschwindet "
	       "dann. Du solltest Baaleth auf jeden Fall von der seltsamen "
	       "Person erzaehlen!"));

      ob->erhoehe_zaehler(1);

      catch(deep_present("\nscript_lexana",TP)->remove());
    }
}

string loch()
{
  if(present("\nzedernquestobject",TP))
    return BS("Das Loch hier ist kein uebliches Loch, wie Du es sonst hier "
	      "ueberall finden kannst. Es ist frisch gegraben, vermutlich "
	      "stammt es von der eigenartigen Person... Was hier wohl "
	      "einmal gelegen hat? Irgendwie fuehlst Du Dich hier unwohl...");

  return BS("Dir faellt an dem Loch nichts auf.");
}

nosave int grabe(string str)
{
  object ob;
  int z;
  notify_fail(BS("Was moechtest Du denn graben?"));

  if(!ob=present("\nzedernquestobject",TP)) return 0;

  z=ob->frage_zaehler();
  
  switch(z)
    {
    case 0:
    case 1:
    case 2:
    case 3:
      {
	tell_object(TP, 
		    BS("Du hast besseres zu tun als sinnlos Loecher "
		       "zu graben."));
	return 1;
      }
    case 4:
      {
	tell_object(TP, 
		    BS("Baaleth hatte doch gesagt, Du solltest "
		       "die Zeder westlich von hier pflanzen, oder?"));
	return 1;
      }
    }
  return 0;
}
