inherit "std/room";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include "../def.h"
#include "lichtung.h"

#define RICHTUNG  "Nordwesten"


int nimm(string str);
int kratze(string str);
int harz;

create()
{
	::create();

	harz = 1;
	SetProp(P_INT_SHORT, "Eine Lichtung");
	SetProp(P_INT_LONG,
	"Du befindest Dich auf einer Lichtung westlich von Elessar. "
	+"Um Dich herum siehst Du im "+RICHTUNG+" einen umgestuerzten "
	+"Baum. In der Wiese bluehen vielerlei Blumen und die Sonne "
	+"scheint warm auf Dich herab. Im Sueden beginnt dichter Wald.");


     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]) );
     
	
	SetProp(P_LIGHT, 1);
	SetProp(P_INDOORS, 0);
	
	AddDetail("lichtung",
		"Die Lichtung breitet sich nach "+RICHTUNG+" aus "
		+"und ist vom dichten Kristallwald umgeben.");

	STANDARD
	SS
	
	AddDetail("wald",
		"Die Staemme sind viel zu dicht, um weiter vordringen zu koennen.");

	AddDetail( ({"stamm","staemme","blaetter"}),
		"Die Staemme und Blaetter sind mit einer Schicht Kristall "
		+"ueberzogen.");

	AddDetail("schicht",
		"Durch die Kristallschicht, die hier Staemme und Zweige "
		+"ueberzieht, wirkt es maerchenhaft schoen.");

	AddDetail("zweige",
		"Auch die Zweige sind, bis auf eine kleine Unebenheit, "
		+"weisslich bedeckt.");

	AddDetail("unebenheit",
		"An einem Zweig faellt dir eine Stelle auf, die nicht so "
		+"glitzert wie die anderen.");

	AddDetail("stelle",
		"Es ist ein kleiner Huegel aus Baumharz, das aus dem "
		+"Zweig quillt.");

	AddDetail( ({"haufen","huegel"}),
		"Ein kleiner, bernsteinfarbener Haufen aus Baumharz.");

	AddDetail( ({"harz","baumharz"}),
		"Das Harz scheint noch nicht sehr alt zu sein.");

	AddItem(NPC+"hummel",REFRESH_DESTRUCT);
	AddItem(NPC+"hummel",REFRESH_DESTRUCT);
	
	AddItem(WEAPON+"wurzel");

	AddCmd( ({"nimm"}), "nimm" );
	AddCmd( ({"kratz","kratze"}) , "kratze" );

	AddExit("westen",ROOM+"0304.lpc");
	AddExit("nordosten",ROOM+"0503.lpc");
	AddExit("norden",ROOM+"0403.lpc");
	
}


reset()
{
	::reset();
	harz = 1;
}

int nimm(string str)
{
	notify_fail("Was moechtest Du nehmen?\n");
	if(!str) return 0;

	if(str=="harz"||str=="harz von baum"||str=="harz von baum")
	{
	   tell_object(TP, "Du kannst das Harz nicht einfach vom Baum "
		+"nehmen. Es ist ziemlich klebrig.\n");
	   return 1;
	}
	return 0;
}

int kratze(string str)
{
	object haare;

	notify_fail("Wie bitte?\n");
	if(!str) return 0;

	if(str=="harz von baum" || str== "harz vom baum"||str=="harz von zweig"||str=="harz von ast")
	{
	   if(harz == 1)
	   {
		if(random(2) == 1)
		{
		   tell_object(TP, "Du kratzt mit Deinen Naegeln das Harz "
			+"vom Baum.\n");
		   (clone_object(OBJ+"harz"))->move(TP);
		   harz = 0;
		   return 1;
		}
		else
		{
		   tell_object(TP, "Du versuchst, das Harz vom Baum zu kratzen, "
			+"es ist jedoch zaeher. Als Du dachtest.\nDu wirst wild "
			+"und kratzt verbissen daran herum. Ploetzlich rutscht "
			+"Du unerwartet ab und knallst mit dem Kopf genau in das "
			+"das Harz!\n\nSchmerzeverzerrt reisst Du Dich wieder los. "
			+"Nicht, ohne ein grosses Bueschel Haare verloren zu haben.\n"
			+"Du nimmst ein Bueschel Haare.\n");
		   (clone_object(OBJ+"khaare"))->move(TP);
		   haare = clone_object(OBJ+"haare");
		   haare->move(TP);
		   haare->set_name(capitalize(TPN));
		   harz = 0;
		   return 1;
		}
	   }
	   else
	   {
		tell_object(TP, "Du kratzt daran herum, aber Du entdeckst "
			+"nichts ausser klebrigen Fingern.\n");
		return 1;
	   }
	}
	return 0;
}


