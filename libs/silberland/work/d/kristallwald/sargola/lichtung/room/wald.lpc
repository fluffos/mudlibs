** Dickicht 
**
** man kann im Boden etwas vergraben...
**
** date: 10-05-97
***********************************************************************
**
** STANDARD
**
*/


inherit "std/room";

#include <properties.h>
#include <combat.h>
#include <moving.h>

#include "../def.h"
#include "lichtung.h"

int erde;

int nimm(string str);
int hebe(string str);
int schiebe(string str);
int grabe(string str);
int versteck(string str);
int erde();


create()
{
	::create();
	erde = 0;
	SetProp(P_INT_SHORT, "Im Dickicht");
	SetProp(P_INT_LONG,
	"Du stehst inmitten von dichten, kaum durchdringbaren Baeumen "
	+"und Straeuchern. Mit jeder Bewegung schlagen Dir die Zweige und "
	+"Aeste ins Gesicht, welche aussergewoehnlich dicht sind. Kaum "
	+"ein Sonnenstrahl verirrt sich hierher. Im Suedosten scheint das "
	+"Dickicht zu enden.");
	
	SetProp(P_LIGHT, 1);
	SetProp(P_INDOORS, 0);
	

	AddDetail("lichtung",
		"Die Lichtung kannst Du kaum mehr erkennen.");
		
	AddDetail("boden",
		"Der Boden ist mit abgebrochenen Zweigen und Blaettern "
		+"bedeckt. Wenn Du Dich bewegst, daemft er Deine Schritte sanft.");
		
	AddDetail(({"straeucher","baeume"}),
		"Sie stehen um Dich herum und verbergen die Sicht.");
		
	AddDetail(({"zweige","aeste"}),
		"Wenn Du zu schnell gehst, schlagen sie Dir ins Gesicht.");
		
	AddDetail( ({"strahl","sonnenstrahl"}),
		"Es ist ziemlich duester hier, da die Strahlen kaum bis zu "
		+"Dir vordringen.");
	
	AddDetail("blaetter",
		"Davon liegen viele am Boden herum. Was sich wohl unter ihnen "
		+"befindet?.");

	AddSpecialDetail("erde", "erde");

	AddDetail("himmel",
		"Der Himmmel ist komplett von Zweigen verdeckt.");
		
	AddDetail("dickicht",
		"Im Suedosten scheint eine Lichtung durch die Zweige. "
		+"Vielleicht kannst Du ja durchklettern.");
		
	AddCmd( ({"biege","bieg"}),"biege");
	AddCmd( ({"vergrabe","vergrab","grabe","grab"}), "grabe");
	AddCmd( ({"verstecke","versteck"}), "versteck");
	AddCmd( ({"nimm"}), "nimm");
	AddCmd( ({"heb","hebe"}), "hebe");
	AddCmd( ({"schieb","schiebe"}), "schiebe");
}

int versteck(string str)
{
	notify_fail("Was moechtest Du denn verstecken?\n");
	if(!str) return 0;

	tell_object(TP, "Verstecken, schoen und gut. Aber wie...");
	return 1;
}


int schiebe(string str)
{
	notify_fail("Was moechtest Du denn schieben?");
	if(!str) return 0;

	if(str=="blaetter")
	{
		tell_object(TP, "Du schiebst wild die Blaetter durch die "
		+"Gegend. Aber Du siehst immer noch nicht, was denn darunter "
		+"sein koennte.");
		return 1;
	}
	if(str=="blaetter zur seite")
	{
		tell_object(TP, "Du schiebst die Blaetter zur Seite und siehst "
		+"... Erde! Unglaublich, was fuer Ueberraschungen die Natur doch "
		+"fuer Dich bereithaelt! Kuehle, weiche, schwarze Erde.");
		erde = 1;
		return 1;
	}
	return 0;
}

int hebe(string str)
{
	notify_fail("Was moechtest Du aufheben?");
	if(!str) return 0;

	if(str=="blaetter auf" ||str=="blaetter von boden auf")
	{
		tell_object(TP, "Du willst die Blaetter ja gar nicht "
		+"mitnehmen. Du willst ja nur wissen, was darunter ist "
		+"ist, oder?");
		return 1;
	}
	return 0;
}

int nimm(string str)
{
	notify_fail("Was moechtest Du nehmen?");
	if(!str) return 0;

	if(str=="blaetter"||str=="nimm blaetter von boden")
	{
		tell_object(TP, "Du willst die Blaetter ja gar nicht "
			+"nehmen. Du willst ja nur wissen, was darunter "
			+"ist, oder?");
		return 1;
	}
	return 0;
}




int grabe(string str)
{
	notify_fail("Was moechtest Du denn graben?\n");
	if(!str) return 0;

	if(str=="loch")
	{
		if(!present("\nzedernquestloch"))
		{
		   if(!present("schaufel", TP))
		   {
			tell_object(TP, "Du beginnst, kommst aber mit der "
			+"blossen Hand nicht sehr tief in die Erde.");
			return 1;
		   }
		   else
		   {
			tell_object(TP, "Du zueckst die Schaufel und graebst "
			+"ein herrliches Loch. Ob man da etwas verstecken "
			+"koennte?");
			(clone_object(OBJ+"loch"))->move(TO);
			return 1;
		   }
		}
		else
		{
		   tell_object(TP, "Da ist ja schon ein Loch gegraben!");
		   return 1;
		}
	}
	return 0;
}


int schluepfe(string str)
{
	notify_fail("Wodurch moechtest Du denn schluepfen?\n");
	if(!str) return 0;
	
	if(str=="durch loch"||str=="durch zweige"||str=="durch wald"||str=="durch die zweige")
	{
		tell_object(TP, "Du findest kein Loch, das gross genug waere, "
			+"hier einfach durchzuschluepfen.");
		return 1;
	}
	return 0;
}

int biege(string str)
{
	notify_fail("Was willst Du denn biegen?\n");
	if(!str) return 0;
	
	if(str=="zweige zur seite"||str=="zweige auf die seite")
	{
	    if(TP->QueryProp(P_LEVEL)<12)
	    {
	        tell_object(TP, "Du weisst ja gar nicht, was Dich dort erwartet..."
	        +"Du beschliesst, es lieber bleiben zu lassen.\n");
	        return 1;
	    }
	    else
	    {
	        tell_object(TP, "Du schiebst die Zweige zur Seite und kannst weiter nach norden gehen.\n");
		TP->move(ROOM+"gang1", M_GO);
	        return 1;
	    }
	}
	return 0;
}


reset()
{
	::reset();
	erde = 0;
}