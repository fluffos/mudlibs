inherit "std/room";

#include <properties.h>
#include <combat.h>
#include <moving.h>

#include "../def.h"
#include "lichtung.h"

#define RICHTUNG  "Suedosten"


create()
{
	::create();

	SetProp(P_INT_SHORT, "Eine Lichtung");
	SetProp(P_INT_LONG,
	BS("Du befindest Dich auf einer Lichtung westlich von Elessar. "
	+"Um Dich herum siehst Du im "+RICHTUNG+" einen umgestuerzten "
	+"Baum. In der Wiese bluehen vielerlei Blumen und die Sonne "
	+"scheint warm auf Dich herab. Im Norden beginnt der dichte "
	+"Wald."));
     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]) );
     

	
	SetProp(P_LIGHT, 1);
	SetProp(P_INDOORS, 0);
	
	AddDetail("lichtung",
		"Die Lichtung breitet sich nach "+RICHTUNG+" aus "
		+"und ist vom dichten Kristallwald umgeben.");

	STANDARD
	SS
	
	AddDetail("wald",
		BS("Der Wald ist um die ganze Lichtung herum sehr dicht. "
		+"Viele dichte Aeste hindern Dich am Weiterkommen."));

	AddDetail("weiterkommen",
		"Das Weiterkommen ist durch die Aeste sehr erschwert.");
		
	AddDetail(({"ast","zweig","zweige","aeste"}),	
		"Die weisslichen, dicht gewachsenen Aeste bieten kaum "
		+"Loecher, durch welche man eventuell durchschluepfen koennte.");
		
	AddDetail("loecher",
		"Du entdeckst ein paar Loecher, aber man kann da nicht so "
		+"einfach durchschluepfen."); 
	
		
	AddItem("/d/ebene/Park/npc/frosch.lpc",REFRESH_DESTRUCT);
	
	AddCmd( ({"biege","bieg"}),"biege");
	AddCmd( ({"schluepf","schluepfe"}), "schluepfe");
	
	AddExit("suedwesten",ROOM+"0103.lpc");
	AddExit("sueden",ROOM+"0203.lpc");
	AddExit("osten",ROOM+"0302.lpc");
	
}

int schluepfe(string str)
{
	notify_fail("Wodurch moechtest Du denn schluepfen?\n");
	if(!str) return 0;
	
	if(str=="durch loch"||str=="durch loecher" || str=="durch zweige"||str=="durch wald"||str=="durch die zweige")
	{
		tell_object(TP, BS("Du versuchst, Dich mit aller Anstrengung "
		+"durch die Zweige zu zwaengen, aber es gelingt Dir nicht. Die "
		+"Loecher sind dazu zu klein.\n"));
		return 1;
	}
	return 0;
}

int biege(string str)
{
	notify_fail("Was willst Du denn wie biegen?\n");
	if(!str) return 0;
	
	if(str=="zweige zur seite"||str=="zweige auf die seite"||str=="zweige weg"
           ||str=="aeste zur seite"||str=="aeste auf die seite"||str=="aeste weg")
	{	    	
	        //if(TP->QueryProp(P_TESTPLAYER) == 0)
	        //{ 
	        //	tell_object(TP, "Du versuchst vergeblich, die Zweige zur Seite zu schieben.\n");
		//        return 1;
		//}
		//else
		//{
	                tell_object(TP, "Du schiebst die Zweige zur Seite und gehst weiter nach Norden.\n");
			TP->move(ROOM+"gang1", M_GO, "in den Wald","geht");
		        return 1;
		//}
	}
	return 0;
}


reset()
{
	::reset();
}


