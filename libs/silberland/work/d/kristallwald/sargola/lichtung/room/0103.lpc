#include "../def.h"
#include "lichtung.h"

inherit "std/room";

#define RICHTUNG  "Osten"
#define SCHMETTERLING "/d/ebene/Park/npc/schmetterling"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Lichtung");
  SetProp(P_INT_LONG,
	  BS("Du befindest Dich auf einer Lichtung westlich von Elessar. "
	     "Um Dich herum siehst Du im "+RICHTUNG+" einen umgestuerzten "
	     "Baum. In der Wiese bluehen vielerlei Blumen und die Sonne "
	     "scheint warm auf Dich herab. Um Dich herum siehst Du nur "
	     "dichtesten Wald."));

  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
     

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail("lichtung",
	    "Die Lichtung breitet sich nach "+RICHTUNG+" aus "
	    "und ist vom dichten Kristallwald umgeben.");
  
  AddDetail(({"knacken"}), 
	    "Das Knacken direkt ist nicht zu sehen.\n");
  
  AddSound("knacken",
	   "Du hoerst angestrengt, aber nun ist wieder alles still. "
	   "Ob hier jemand durch den Wald hirscht? Vielleicht kannst "
	   "Du Dich ja auf die Lauer legen?");
  
  STANDARD
  SS	
	
  AddDetail("wald",
	    "Ausser im Osten wirst Du von dichtem Wald umgeben.");
  
  AddRoomMessage(({
    "Du hoerst ein Knacken im Wald.\n",
      "Eine Biene summt irgendwo im Osten.\n",
      "Auf der Lichtung fuehlst Du Dich richtig wohl.\n",
      "Ein leises Knacken dringt an Dein Ohr.\n"}));
  
  AddCmd(({"lege","leg"}), "lege");
  
  AddExit("nordosten", ROOM "0202");
  AddExit("suedosten", ROOM "0204");
  AddExit("osten", ROOM "0203");

  AddItem(SCHMETTERLING, REFRESH_DESTRUCT);	
}

nosave int lege(string str)
{
  if(!str) return 0;

  if(str=="auf lauer"||str=="lege auf die lauer")
    {
      write(BS("Du biegst ein paar Zweige zur Seite und legst "
	       "Dich leise auf den Boden. Du kannst alles gut beobachten " 
	       "und wartest gespannt, was passiert."));

      TP->move(ROOM"lauer", M_GO|M_NO_SHOW, "in den Wald", "schluepft");

      if(find_call_out("kommen_gnom")==-1)
	call_out("kommen_gnom", 30, TP);

      return 1;
    }
  
  return 0;
}

void kommen_gnom(object who)
{
  object room;

  room = find_object(ROOM "lauer");
  
  if(!objectp(who)) return;
  
  if(present(who, room))
    if(room->query_gnom_anz()>0 && !present("gnom",room))
      {
	tell_object(who, 
		    BS("Du siehst, wie ein gut getarntes, kleines "
		       "Maennchen zwischen den Baeumen hin und her huepft."));

	CLONE(NPC"gnom", ROOM"lauer");

	room->set_gnom_anz(room->query_gnom_anz()-1);
	
	return;
      }
    else
      return tell_object(who, 
	     BS("Du liegst auf der Lauer, aber nichts passiert."));
  
  return;
}

