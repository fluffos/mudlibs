#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Im Magen eines Drachen");
  
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_NOQUIT, "Nein! So einfach kommst Du hier nicht raus!\n");
  SetProp(P_NOREST, "Rasten? Hier? Bist Du wahnsinnig?\n");
  
  AddDetail("drache",
	    "Den wuerdest Du lieber von aussen sehen.");

  AddDetail(({"inneren","inneres"}),
	    "Mitten drin sozusagen...");

  AddDetail("boden",
	    "Den kannst Du nicht sehen, der Magen ist ja mit Magensaeure "
	    "gefuellt! Vielleicht sind ja Gegenstaende von anderen "
	    "Abenteurer zu Boden gesunken...");
  
  AddDetail(({"gegenstand","gegenstaende"}),
	    "Durchsuch die Magensaeure danach - dann findest Du vielleicht "
	    "was.");
  
  AddDetail(({"saeure","magensaeure","fluessigkeit","magenfluessigkeit"}),
	    "Der Magen ist von einer gelblichen, beissenden Fluessigkeit "
	    "gefuellt. Du merkst, wie sich deine Ruestungsteile immer "
	    "mehr zersetzen. Ausserdem siehst Du eine gruene Pflanze.");
  
  AddDetail("pflanze",
	    "Es sind schon ziemlich zersetzte Kraeuter, die "
	    "in seinem Magen herumschwimmen. Wie die da reinkommen?");
  
  AddDetail("kraeuter",
	    "Sie sind schon ganz zersetzt.");
  
  AddDetail("decke",
	    "Es ist ziemlich daemmrig, aber Du kannst hin und wieder "
	    "seine Muskulatur ueber und neben Dir sehen. Vom Hals kommt "
	    "ein kleiner Lichtstrahl.");

  AddDetail(({"muskeln","muskulatur"}),
	    "Die Magenwaende und die Decke sind mit starken Muskelstraehnen "
	    "durch zogen.");

  AddDetail(({"straehnen","muskelstraehnen"}),
	    "Du moechtest gar nicht wissen, was der Drache schon so alles "
	    "verdaut hat...");

  AddDetail("hals",
	    "Der Hals fuehrt steil nach oben ... vielleicht kann man da "
	    "ja wieder nach oben klettern? Der einzige Lichtschein, den "
	    "Du hast, kommt von dort.");
		
  AddDetail(({"licht","lichtschein","schein","strahl","lichtstrahl"}),
	    "Nur sehr selten, wenn der Drache sein Maul oeffnet, dringt ein "
	    "Lichtstrahl zu Dir herunter und Du geraetst bei dem Anblick "
	    "gleich noch mehr in Panik.");
  
  AddDetail("maul",
	    "Durch den Hals kannst Du zwar das Maul sehen, aber es ist zu "
	    "weit weg...");
  
  AddDetail("ding",
	    "Du kannst es nicht erkennen.");
	
  AddDetail("magen",
	    "Was glaubst Du, wo Du hier bist? :))");

  AddDetail("freie",
	    "Das ist weit oben ...");

  AddDetail("gaumen",
	    "Hmm... vielleicht kann man den mit irgendwas kitzeln, was "
	    "den Gaumen reizen koennte. Vielleicht was pflanzliches...");

  AddDetail("panik",
	    "Gleich bricht sie aus...");

  AddDetail("anblick",
	    "Damit Du nicht vollends in Panik ausbrichst, be"
	    "schreib ich das lieber nicht.");
		
  AddDetail(({"waende","magenwaende","wand","magenwand"}),
	    "Die mit starken Muskeln durchzogenen Magenwaende reiben "
	    "bedrohlich hin und her ... vielleicht zerquetschen sie Dich "
	    "bald ...");

  AddSmell(DEFAULT_SMELL,
	   "Dir ist schon uebel, so ekelerregend riecht es hier. Besonders "
	   "die Saeure stinkt.");
  
  AddSmell(({"saeure","gestank"}),
	   "Der Gestank ist wirklich penetrant.");

  AddSound(DEFAULT_SOUND,
	   "Du hoerst ein Gurgeln der Saeure und den Atem des Drachen.");

  AddSound("gurgeln",
	   "Die aufsteigenden Gasblasen in der Magenfluessigkeit gurgeln "
	   "munter vor sich hin.");

  AddSound(({"atemzuege","zuege","atem"}),
	   "Tiefe, lange Atemzuege, die Dein Haar verwuscheln.");

  AddRoomMessage(({
    "Die Magensaeure blubbert etwas staerker.\n",
      "Du denkst . o 0 (Meine Ruestung loest sich bald auf...)\n",
      "Du merkst, wie die Fluessigkeit Deine Haut zersetzt.\n",
      "Der Drache bruellt aus voller Kehle.\n",
      "Du schwimmst eine Runde, weil Dir fad ist.\n",
      "Der Drache quetscht Dich zwischen den Magenwaenden ein.\n",
      "Durch den Hals des Drachen stroemt ein Lichtstrahl.\n"
      }),5, "funcs" );

  AddCmd(({"raus"}),"raus");
  AddCmd(({"toete","toet"}), "toete");
  AddCmd(({"kitzel","kitzl","kitzle"}), "kitzel");
  AddCmd(({"durchsuche","durchsuch"}), "durchsuche");
  AddCmd(({"kletter","klettere"}), "kletter");
  AddCmd(({"wirf","werf","werfe","lass","leg","lege"}), "wirf");
}

nosave int wirf(string str)
{
  return write(BS("Du wirst doch nicht Deine Sachen in die Saeure werfen "
		  "oder?")),1 ;
}

nosave int kletter(string str)
{
  notify_fail(BS("Wohin moechtest Du hochklettern?"));
  if(!str) return 0;
  
  if(str=="hals hoch"  || str=="hals rauf"    || str=="an hals hoch" ||
     str=="durch hals" || str=="an hals hoch" || str=="an hals rauf" || 
     str=="rauf"       || str=="nach oben"    || str=="raus")
    {
      write(BS("Du beginnst beherzt mit einem Versuch, durch den Hals "
	       "des Drachen wieder ins Freie zu klettern. Du kommst sogar "
	       "am Gaumen vorbei, kitzelst den Drachen dadurch nur und "
	       "faellst wieder zurueck. Hmm...."));
      tell_room(TO, BS(TPN+" versucht durch den Hals des Drachen zu klettern, "
		       "faellt aber wieder zurueck."), ({TP}));
      return 1;
    }
  
  return 0;
}

nosave int durchsuche(string str)
{
  notify_fail(BS("Was moechtest Du durchsuchen?"));
  if(!str) return 0;
  
  if(str=="magensaeure"  || str=="saeure" || 
     str=="fluessigkeit" || str=="magenfluessigkeit")
    return write(BS("Du wuehlst ganz wild in der Magensaeure herum, kannst "
		    "ein Ding auch fast fassen... aber es flutscht wieder "
		    "weg.")), 1;
  
  return 0;
}

nosave int kitzel(string str)
{  
  object kr;
  int z;
  
  notify_fail(BS("Wen willst Du kitzeln?"));
  if(!str) return 0;
  
  if(str=="drachen"||str=="drache"||str=="gaumen")
    return write(BS("Womit willst Du denn den Drachen kitzeln?")), 1;

  if(str=="gaumen")
    return write(BS("Womit willst Du denn den Drachen kitzeln?")), 1;

  notify_fail("Wen willst Du womit kitzeln?\n");

  if(str=="drache mit kraeutern"  || str=="drache mit kraeuter"  ||
     str=="drachen mit kraeutern" || str=="drachen mit kraeuter" ||
     str=="drache mit bueschel"	  || str=="drachen mit bueschel" ||
     str=="gaumen mit bueschel"   || str=="gaumen mit kraeutern" ||
     str=="gaumen mit kraeuter")
    if(!objectp(kr=present("\ngnomkraeuter", TP)))
      return write(BS("Du hast nichts Passendes dabei, um den "
		      "Drachen zu kitzeln. Vielleicht waeren ein Paar herbe "
		      "Gnomkraeuter hier richtig...")), 1;
    else
      {
	write(BS("Du zueckst Deine Kraeuter und beginnst den Drachen damit "
		 "gemein am Gaumen zu kitzeln."));
	
	if(random(TP->QueryAttribute(A_DEX)) < 10)
	  {
	    write(BS("Ungeschickt wie Du bist, laesst Du die Kraeuter "
		     "dabei fallen..."));

	    kr->remove(1);
	  }

	tell_room(TO, 
		  BS(TPN+" beginnt mit Kraeutern den Gaumen des Drachen zu "
		     "kitzeln."), ({TP}));
	
	if(find_call_out("kitzel_drache") == -1)
	  call_out("kitzel_drache", 5 );
	
	return 1;
      }
  
  return 0;
}

void kitzel_drache()
{
  tell_room(TO, BS("Der Drache muss fuerchterlich husten..."));

  if(find_call_out("kitzel_drache1") == -1) 
    call_out("kitzel_drache1",3);
}

void kitzel_drache1()
{
  object *players, obs;
  int i;
	
  tell_room(TO, 
	    BS("Der Drache wuergt Dich mit einem kraeftigen HATSCHIIIII "
	       "wieder an die freie Luft."));
  
  players=filter_array(all_inventory(), CLOSURE(interactive));
  
  for(i=sizeof(players)-1;i>-1;i--)
    players[i]->move(ROOM "gang2", M_GO, "wird aus dem Hals gehustet","",
		     "wird vom Drachen ausgehustet");
}

nosave int raus()
{
  return write(BS("Das waere doch zu einfach!")), 1;
}

nosave int toete(string str)
{
  if(str=="drache")
    return write(BS("Die Magenwaende sind von der Saeure derart "
		    "resistent, Du wuerdest keinen Schaden ausrichten.")), 1;
  
  return 0;
}

void funcs(int msg)
{
  int i;
  object *ar, *players;
  object was;
  int anz, wieviel;

  players=filter_array(all_inventory(), CLOSURE(interactive));
  
  catch(call_other(ROOM "gang2", "???"));
  
  if(!present("STD_Dragon", find_object(ROOM "gang2")))
    for(i=sizeof(players)-1;i>-1;i--)
      {
	tell_object(players[i],
		    BS("Der Drache ist tot!")+
		    BS("Der Weg ist nun frei und Du kletterst sofort durch "
		       "den Hals ins Freie..."));
	
	players[i]->move(ROOM "gang2", M_GO, "klettert aus dem toten Drachen "
			 "heraus","", "klettert raus");
      }
  
  switch(msg)
    {
    case 1:
    case 2:
    case 3:
      for(i=sizeof(players)-1;i>=0;i--)
	if(sizeof(ar=players[i]->QueryArmours()))
	  ar[random(sizeof(ar))]->TakeFlaw(random(5));
	else
	  players[i]->do_damage(20);	     

      break;
    case 4:
    case 5:
    case 6:
      for(i=sizeof(players)-1;i>=0;i--)
	players[i]->do_damage(random(20),TO);
    
      break;
    case 7:
      for(i=sizeof(players)-1;i>=0;i--)
	players[i]->AddHp(-random(20));
    }
}

void init()
{
  ::init();
	
  if(getuid(TP)=="fenris")
    tell_object(TP, 
		"\n\nFenris!\nBist also doch noch gekommen....\n"
		"Du hoerst ein irres Lachen von Sargola aus der Ferne.\n\n\n");
}

string _query_int_long()
{
  return BS("Du befindest Dich im Inneren des Drachen. Genauer gesagt ist das "
	    "hier wohl sein Magen. Es riecht absolut widerlich und Dir "
	    "wird schlecht. Nur sehr spaerliches Licht dringt manchmal vom "
	    "Hals zu Dir nach unten. "+
	    (TP->QueryProp(P_SIZE) < 150 ? 
	     "Du stehst bis zum Hals in einer aetzenden Fluessigkeit." :
	     "Du stehst bis zu den Hueften in einer aetzenden Fluessigkeit."));
}

varargs string GetExits(object viewer)
{
  return "";
}
