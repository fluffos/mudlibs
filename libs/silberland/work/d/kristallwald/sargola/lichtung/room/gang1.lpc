#include "../def.h"

inherit "std/room";

#include "lichtung.h"

#define RICHTUNG  "Suedosten"

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Im Dickicht");
  SetProp(P_INT_LONG,
	  BS("Du stehst inmitten von dichten, kaum durchdringbaren Baeumen "
	     "und Straeuchern. Mit jedem Schritt schlagen Dir die Zweige und "
	     "Aeste ins Gesicht. Du brauchst lang, um vorwaerts zu kommen. "
	     "Kaum ein Sonnenstrahl verirrt sich hierher. Im Suedosten "
	     "scheint das Dickicht zu enden. Von Westen her hoerst Du "
	     "seltsame Geraeusche."));
	  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail("lichtung",
	    "Die Lichtung kannst Du nicht mehr erkennen.");
  
  AddDetail(({"geraeusche","geraeusch"}),
	    "Lausch doch mal!");
  
  AddDetail("boden",
	    "Der Boden ist mit abgebrochenen Zweigen und Blaettern "
	    "bedeckt. Wenn Du gehst, daempft er Deine Schritte sanft.");
  
  AddDetail("blaetter",
	    "Sie liegen am Boden.");	
  
  AddDetail(({"straeucher","baeume"}),
	    "Sie stehen um Dich herum und verbergen die Sicht.");
  
  AddDetail(({"zweige","aeste"}),
	    "Wenn Du zu schnell gehst, schlagen sie Dir ins Gesicht.");
  
  AddDetail(({"strahl","sonnenstrahl"}),
	     "Es ist ziemlich duester hier, da die Strahlen kaum bis zu "
	     "Dir vordringen.");
  
  AddDetail("himmel",
	    "Der Himmel ist komplett von Zweigen verdeckt.");
  
  AddDetail("dickicht",
	    "Im Suedosten scheint eine Lichtung durch die Zweige. "
	    "Vielleicht kannst Du ja die Zweige zur Seite biegen.");
  
  AddSound(({"geraeusche","geraeusch",DEFAULT_SOUND}), 
	   "Du hoerst ein leises, gleichmaessiges Schnaufen.");
  
  AddSound("schnaufen",
	   "Es kommt vom Westen her und stammt sicherlich von einem "
	   "groesseren Tier.");
  
  AddSound("tier",
	   "Es scheint im Westen zu sein.");
  
  AddCmd(({"biege","bieg"}),"biege");

  AddExit("westen", ROOM "gang2");
}

nosave int schluepfe(string str)
{
  notify_fail(BS("Wodurch moechtest Du denn schluepfen?"));
  if(!str) return 0;
  
  if(str=="durch loch"||str=="durch zweige"||str=="durch wald"||
     str=="durch die zweige")
    {
      tell_object(TP, 
		  BS("Du findest kein Loch, das gross genug waere, "
		     "hier einfach durchzuschluepfen."));
      return 1;
    }

  return 0;
}

nosave int biege(string str)
{
  notify_fail(BS("Was willst Du denn wie biegen?"));
  if(!str) return 0;
  
  if(str=="zweige zur seite"||str=="zweige auf die seite"||str=="zweige weg"
     ||str=="aeste zur seite"||str=="aeste auf die seite"||str=="aeste weg")
    {
      tell_object(TP, 
		  BS("Du schiebst die Zweige zur Seite und kannst wieder "
		     "zurueck auf die Lichtung gehen."));

      TP->move(ROOM "0202", M_GO, "auf die Lichtung");

      return 1;
    }
  
  return 0;
}
