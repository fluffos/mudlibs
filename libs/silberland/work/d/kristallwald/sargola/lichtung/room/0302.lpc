#include "../def.h"
#include "lichtung.h"

inherit "std/room";

#define RICHTUNG  "Sueden"

nosave int mohnblumenanzahl;
nosave int kornblumenanzahl;
nosave int gaensebluemchenanzahl;

void create()
{
  ::create();
	
  mohnblumenanzahl=0;
  kornblumenanzahl=1;
  gaensebluemchenanzahl=1;
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  
  SetProp(P_INT_SHORT, "Eine Lichtung");
  SetProp(P_INT_LONG,
	  BS("Du befindest Dich auf einer Lichtung westlich von Elessar. "
	     "Um Dich herum siehst Du im "+RICHTUNG+" einen umgestuerzten "
	     "Baum. In der Wiese bluehen vielerlei Blumen und die Sonne "
	     "scheint warm auf Dich herab Im Norden ist dichter Wald."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail("lichtung",
	    "Die Lichtung breitet sich nach "+RICHTUNG+" aus "
	    "und ist vom dichten Kristallwald umgeben.");
  
  STANDARD
  SS
  
  AddDetail("wald",
	    "Der Wald ist um die ganze Lichtung herum sehr dicht und "
	    "nirgends kann man sich einen Weg nach Norden bahnen.");
  
  AddDetail("moeglichkeit",
	    "Du kannst hier einfach nicht mehr weiter, der Wald ist zu "
	    "dicht.");
  
  AddItem(NPC "eule", REFRESH_DESTRUCT);
  
  AddCmd(({"pfluecke","pflueck"}), "pfluecken");
  
  AddExit("westen", ROOM "0202");
  AddExit("sueden", ROOM "0303");
  AddExit("osten",  ROOM "0402");
}

void reset()
{
  ::reset();
	
  kornblumenanzahl=1;
  gaensebluemchenanzahl=1;
  mohnblumenanzahl=0;
}

BLUMEN
