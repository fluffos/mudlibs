#include "../def.h"
#include "lichtung.h"

inherit "std/room";

#define RICHTUNG  "Osten"

loch();

lege(string str);
grabe(string str);
pflanze(string str);
grabe_loch();
int reisse(string str);

nosave int halm;
nosave int mohnblumenanzahl;
nosave int gaensebluemchenanzahl;
nosave int kornblumenanzahl;

void create()
{
  ::create();
	
  halm = 1;
  kornblumenanzahl =0;
  gaensebluemchenanzahl = 0;
  mohnblumenanzahl = 0;
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  
  SetProp(P_INT_SHORT, "Eine Lichtung");
  SetProp(P_INT_LONG,
	  BS("Du befindest Dich auf einer Lichtung westlich von Elessar. "
	     "Um Dich herum siehst Du im "+RICHTUNG+" einen umgestuerzten "
	     "Baum. In der Wiese bluehen vielerlei Blumen und die Sonne "
	     "scheint warm auf Dich herab."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail("lichtung",
	    "Die Lichtung breitet sich nach "+RICHTUNG+" aus "
	    "und ist vom dichten Kristallwald umgeben.");
  
  STANDARD
  SS
  
  AddDetail("wiese",
	    "Sie wuchert hier ueberall und bedeckt den Boden. Manchmal "
	    "waechst die Wiese sogar in ganz langen Halmen.");
  
  AddSpecialDetail( ({"halme","halm"}),"halm");
  
  AddDetail("loch", CLOSURE(loch));
  AddDetail("boden", CLOSURE(grabe_loch));

  AddCmd(({"grab","grabe"}),"grabe");
  AddCmd(({"wirf","werfe","pflanz","pflanze","setz","setze"}),"pflanze");
  AddCmd(({"vergrabe","vergrab", "lege","leg"}),"lege");
  AddCmd(({"pfluecke","pflueck"}),"pfluecken");
  AddCmd(({"reiss","reisse"}), "reisse");

  AddExit("westen", ROOM "0103");
  AddExit("norden", ROOM "0202");
  AddExit("sueden", ROOM "0204");
  AddExit("osten",  ROOM "0303");
}

nosave int reisse(string str)
{
  object ob;

  notify_fail(BS("Was moechtest Du ausreisen?"));
  if(!str) return 0;
  
  if(str=="grashalm"||str=="halm"||str=="halm aus"||str=="grashalm aus")
    if(halm)
      {
	ob=clone_object(OBJ "grashalm");
	if(ob->move(TP, M_GET)==ME_TOO_HEAVY)
	  {
	    ob->remove(1);
	    return write(BS("Der Grashalm wuerde Dir zu schwer werden!")), 1;
	  }
	
	write(BS("Du reisst sorgsam den langen Halm aus."));

	halm=0;

	return 1;
      }
    else
      return write(BS("Du reisst zu heftig an und reisst den "
		      "schoenen langen Halm ab.")), 1;
  
  return 0;
}	


string halm()
{
  if(halm)
    return "Ein Halm ist besonders lang.\n";

  return "Tja, im Grunde nur normale Wiese.\n";
}

nosave int lege(string str)
{
  object quest, knochen;
  
  notify_fail("Was moechtest Du wohin legen?\n");
  if(!str) return 0;
  
  if(str=="knochen in loch" || str=="knochen in das loch"||str=="knochen weg"
     || str == "knochen")
    {
      quest=present("\nzedernquestobject",TP);
      knochen=present("\nxalgurknochen",TP);
      
      if(!objectp(quest)) return 0;
      
      if(!objectp(knochen))
	return write(BS("Welche Knochen willst Du denn in das Loch"
			" legen??")), 1;

      if(quest->frage_zaehler()<4)
	return write(BS("Du solltest die Knochen wohl noch besser "
			"behalten.")), 1;

      if(!present("\nzedernquestloch"))
	return write(BS("In welches Loch willst Du denn die Knochen "
			"legen?")), 1;
	
      //**********************************
      // Jetzt darf man endlich...
      //**********************************
      write(BS("Du legst alle Knochen sorgfaeltig in das Loch hinein."));

      knochen->move(ME, M_NOCHECK);

      return 1;
   }
   
  if(str=="setzling"||str=="setzling in das loch" || str=="setzling in loch"||
     str=="setzling weg")
    return write(BS("Du solltest den Setzling einpflanzen, damit "
		    "er auch sicher Wurzeln fassen kann.")), 1;

  notify_fail(BS("Was willst Du wo vergraben?"));
  return 0;
}

nosave int grabe(string str)
{
  object ob;
  
  if(!str || str!="loch")
    return write(BS("Was moechtest Du graben?")), 1;
  
  ob=present("\nzedernquestobject",TP);
  
  if(!present("schaufel", TP))
    return write(BS("Du hast ja gar nichts zum Graben dabei!")), 1;

  if(objectp(ob))
    if(ob->frage_zaehler()<4)
      return write(BS("Du kannst hier nicht graben.")), 1;
    else
      if(!present("\nzedernquestloch"))
	{
	  write(BS("Du graebst ein kleines Loch, in das der Setzling "
		   "hineinpasst."));
	  CLONEME(OBJ "loch");
	  return 1;
	}
      else
	return write(BS("Du hast ja schon ein Loch gegraben!")), 1;

  return write(BS("Du kannst hier nicht graben.")), 1;
}

nosave int pflanze(string str)
{
  object ob;
  
  notify_fail("Was moechtest Du pflanzen?\n");
  if(!str && str!="setzling"&&str!="setzling in loch" &&str!="zeder"&&
     str!="zeder in loch")
    return write(BS("Was moechtest Du pflanzen?")), 1;

  ob=present("\nzedernquestobject",TP);
  
  if(!present("zedernsetzling",TP))
    return write(BS("Du hast ja gar keinen Setzling!")), 1;

  if(!present("\nzedernquestloch"))
    return write(BS("In welches Loch willst Du die Setzlinge denn "
		    "setzen?")), 1;

  if(!present("\nxalgurknochen",environment(TP)))
    return write(BS("Vergiss nicht, die Knochen muessen unter der Zeder "
		    "begraben sein!")), 1;
  
  if(!objectp(ob))
    return write(BS("Was willst Du denn setzen?")), 1;
  else
    if(ob->frage_zaehler()<4)
      return write(BS("Nein, Du fuehlst Dich noch nicht bereit, um Xalgur "
		      "gegenueberzutreten. Du solltest vorher Deine Seele "
		      "im Wald durch Meditation und im See durch ein Bad "
		      "reinigen.")), 1;
    else
      {
	write(BS("Als Du den Setzling zu pflanzen beginnst, kommt ein herber "
		 "Wind auf. Die Aeste der alten Zeder rascheln laut im Wind. "
		 "Ploetzlich beginnt der Wind die Form einer Person "
		 "anzunehmen. Immer deutlicher erkennst Du einen "
		 "hochgewachsenen, hageren Mann mit starren Gesichtszuegen. "
		 "Das muss die Seele von Xalgur sein!")+
	      BS("Nimm Dich in Acht!"));
	ob=present("zedernsetzling",TP);
	ob->remove();
	ob=clone_object(NPC "xalgur");
	ob->move(TO, M_GO | M_NOCHECK);
	ob->Kill(TP);
	ob->Attackedby(TP);
	return 1;
      }
  return 1;
}

loch()
{
  if(present("\nzedernquestloch"))
    return "Du siehst ein kleines Loch im Boden.\n";

  return "Sowas siehst Du hier nicht.\n";
}

string grabe_loch()
{
  if(present("\nzedernquestobject",TP))
    return "Der Boden ist mit einer dichten dunkelgruenen Wiese be"
      "deckt. Hin und wieder siehst Du einige Blumen bluehen. "
      "Der Boden ist hier sehr weich, Du kannst hier sicher "
      "leicht ein Loch graben.\n";
	
  return "Der Boden ist mit einer dichten dunkelgruenen Wiese be"
    "deckt. Hin und wieder siehst Du einige Bluemchen bluehen.\n";
}

void reset()
{
  ::reset();
	
  halm = 1;
  kornblumenanzahl =0;
  mohnblumenanzahl =0;
  gaensebluemchenanzahl =0;
}

BLUMEN
