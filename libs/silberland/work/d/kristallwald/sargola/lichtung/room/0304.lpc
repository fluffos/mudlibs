inherit "std/room";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include "../def.h"
#include "lichtung.h"

#define RICHTUNG  "Norden"


int mohnblumenanzahl;
int kornblumenanzahl;
int gaensebluemchenanzahl;

create()
{
	::create();

	mohnblumenanzahl=0;
	kornblumenanzahl=0;
	gaensebluemchenanzahl=0;

     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]) );
     
	
	SetProp(P_INT_SHORT, "Eine Lichtung");
	SetProp(P_INT_LONG,
	"Du befindest Dich auf einer Lichtung westlich von Elessar. "
	+"Um Dich herum siehst Du im "+RICHTUNG+" einen umgestuerzten "
	+"Baum. In der Wiese bluehen vielerlei Blumen und die Sonne "
	+"scheint warm auf Dich herab. Dichter Wald im Sueden hindert "
	+"Dich daran, weiter vorzudringen.");
	
	SetProp(P_LIGHT, 1);
	SetProp(P_INDOORS, 0);
	
	AddDetail("lichtung",
		"Die Lichtung breitet sich nach "+RICHTUNG+" aus "
		+"und ist vom dichten Kristallwald umgeben.");

	STANDARD
	SS
	
	AddDetail("wald",
		"Der Wald ist ausserordentlich dicht hier.");
	
	AddItem("/d/ebene/Park/npc/salamander.lpc",REFRESH_DESTRUCT);

	AddCmd ( ({"pfluecke","pflueck"}),"pfluecken");
	AddExit("westen",ROOM+"0204.lpc");
	AddExit("norden",ROOM+"0303.lpc");
	AddExit("osten",ROOM+"0404.lpc");
	
}

reset()
{
	::reset();
	mohnblumenanzahl=0;
	kornblumenanzahl=0;
	gaensebluemchenanzahl=0;
	
}


BLUMEN