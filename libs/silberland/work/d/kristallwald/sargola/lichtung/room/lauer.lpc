#include "../def.h"
#include "lichtung.h"

inherit "std/room";

#define RICHTUNG  "Osten"

nosave int gnom_anz;
int set_gnom_anz(int anz);
int query_gnom_anz();

void create()
{
  ::create();
	
  gnom_anz = 3;
  
  SetProp(P_INT_SHORT, "Im Dickicht");
  SetProp(P_INT_LONG,
	  BS("Du stehst inmitten von dichten, kaum durchdringbaren Baeumen "
	     "und Straeuchern. Starke Zweige verhindern, dass Du weiter in "
	     "den Wald vordringst. Kaum ein Sonnenstrahl verirrt sich "
	     "hierher. Im Osten scheint das Dickicht zu enden."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail("lichtung",
	    "Die Lichtung kannst Du nicht mehr erkennen.");
  
  AddDetail("boden",
	    "Der Boden ist mit abgebrochenen Zweigen und Blaettern "
	    "bedeckt. Wenn Du gehst, daempft er Deine Schritte sanft.");
  
  AddDetail(({"straeucher","baeume"}),
	    "Sie stehen um Dich herum und verbergen die Sicht.");
  
  AddDetail(({"zweige","aeste"}),
	    "Wenn Du zu schnell gehst, schlagen sie Dir ins Gesicht.");
  
  AddDetail(({"strahl","sonnenstrahl"}),
	     "Es ist ziemlich duester hier, da die Strahlen kaum bis zu "
	     "Dir vordringen.");
  
  AddDetail("himmel",
	    "Der Himmmel ist komplett von Zweigen verdeckt.");
  
  AddDetail("dickicht",
	    "Im Osten scheint die Lichtung durch die Zweige.");
  
  AddSound(({"geraeusch",DEFAULT_SOUND}), 
	    "Du hoerst nichts Besonderes.");
  AddSound("knacken",
	   "Es ist kein Knacken mehr zu hoeren.");
  
  AddRoomMessage(({
    "Du liegst ungeduldig auf der Lauer.\n"
      "Wann passiert hier nur was?\n",
      "Ob das Knacken nur Einbildung war?\n",
      "Vielleicht solltest Du besser wieder gehen.\n"}));
  
  AddExit("raus", ROOM "0103");
}

reset()
{
  ::reset();
  gnom_anz = 1;
}

int set_gnom_anz(int anz)
{
  gnom_anz = anz;
}

int query_gnom_anz()
{
  return gnom_anz;
}
