inherit "std/room";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include "../def.h"
#include "lichtung.h"

#define RICHTUNG  "Nordosten"

int mohnblumenanzahl;
int kornblumenanzahl;
int gaensebluemchenanzahl;


create()
{
	::create();
	
	mohnblumenanzahl=1;
	kornblumenanzahl=0;
	gaensebluemchenanzahl =0;

     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]) );
     
	
	SetProp(P_INT_SHORT, "Eine Lichtung");
	SetProp(P_INT_LONG,
	"Du befindest Dich auf einer Lichtung westlich von Elessar. "
	+"Um Dich herum siehst Du im "+RICHTUNG+" einen umgestuerzten "
	+"Baum. In der Wiese bluehen vielerlei Blumen und die Sonne "
	+"scheint warm auf Dich herab. Im Sueden beginnt dichter Wald.");
	
	SetProp(P_LIGHT, 1);
	SetProp(P_INDOORS, 0);
	
	AddDetail("lichtung",
		"Die Lichtung breitet sich nach "+RICHTUNG+" aus "
		+"und ist vom dichten Kristallwald umgeben.");
	
	STANDARD
	SS	

	AddDetail("wald",
		"Der Wald ist zu dicht, um ihn naeher erforschen zu koennen.");

	AddItem(OBJ+"haufen");
	AddItem(NPC+"ameisenbaer",REFRESH_DESTRUCT);

	AddCmd ( ({"pfluecke","pflueck"}),"pfluecken");

	AddExit("nordwesten",ROOM+"0103.lpc");
	AddExit("norden",ROOM+"0203.lpc");
	AddExit("osten",ROOM+"0304.lpc");
	
}

reset()
{
	::reset();
	kornblumenanzahl =0;
	mohnblumenanzahl=1;
	gaensebluemchenanzahl=0;
}



BLUMEN