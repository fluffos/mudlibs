#include "../def.h"
#include "lichtung.h"

inherit "std/room";

#define RICHTUNG  "Westen"

nosave int erdbeere_da;
nosave int mohnblumenanzahl;
nosave int kornblumenanzahl;
nosave int gaensebluemchenanzahl;

void create()
{
  ::create();

  erdbeere_da = 1;
  mohnblumenanzahl=1;
  kornblumenanzahl=0;
  gaensebluemchenanzahl=0;
	
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));

  SetProp(P_INT_SHORT, "Eine Lichtung");
  SetProp(P_INT_LONG,
	  BS("Du befindest Dich auf einer Lichtung westlich von Elessar. "
	     "Um Dich herum siehst Du im "+RICHTUNG+" einen umgestuerzten "
	     "Baum. In der Wiese bluehen vielerlei Blumen und die Sonne "
	     "scheint warm auf Dich herab."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail("lichtung",
	    "Die Lichtung breitet sich nach "+RICHTUNG+" aus "
	    "und ist vom dichten Kristallwald umgeben.");

  STANDARD
  SS

  AddDetail("boden",							
	    "Der Boden ist mit einer dichten, dunkelgruenen Wiese be"	
	    "deckt. Hin und wieder siehst Du einige Blumen bluehen. "	
	    "Einen Weg kannst Du hier nicht erkennen. Du kannst "
	    "einen roten Schimmer in der Wiese entdecken.");
  
  AddDetail("schimmer",
	    "Du kannst nicht erkennen, was das sein soll. Die Wiese "
	    "verdeckt alles. Du koenntest mal die Wiese zur Seite "
	    "schieben.");			

  AddSpecialDetail(({"beere","erdbeere","walderdbeere"}), "erdbeeren_det");

  AddExit("westen", ROOM "0303");
  AddExit("sueden", ROOM "0404");
  AddExit("osten", ROOM "0503");
  AddExit("norden", ROOM "0402");
  
  AddCmd(({"schiebe","schieb"}) ,"schiebe");	
  AddCmd(({"pflueck","pfluecke"}),"pflueck");
}

string erdbeeren_det(string str)
{
  if(erdbeere_da)
    return BS("Eine knallrote, grosse Walderdbeere.");

  return BS("Eine knallrote, grosse Walderdbeere, die von Schnecken "
	    "zerfressen ist.");
}

void reset()
{
  ::reset();

  erdbeere_da= 1;
  mohnblumenanzahl=1;
  kornblumenanzahl=0;
  gaensebluemchenanzahl=0;
	
}

nosave int schiebe(string str)
{
  notify_fail(BS("Was moechtest Du zur Seite schieben?"));
  if(!str) return 0;

  if(str=="wiese"||str=="wiese zur seite"||
     str=="gras" ||str=="gras zur seite" ||
     str=="wiese weg" || str=="gras weg")
    if(erdbeere_da)
      {
	write(BS("Du schiebst die Wiese zur Seite und entdeckst "
		 "eine hellrote, reife Erdbeere.")+
	      BS("Ob man die pfluecken kann?"));
	
	tell_room(TO, BS(TPN+" entdeckt etwas in der Wiese."), ({TP}));
	
	return 1;
      }
    else
      return write(BS("Bei genauem Hinsehen siehst Du eine Beere, die von "
		      "Schnecken ganz zerfressen ist. Du laesst sie daher "
		      "liegen.")), 1;
  
  return 0;
}

nosave int pflueck(string str)
{
  object beere;

  notify_fail(BS("Was moechtest Du pfluecken?"));
  if(!str) return 0;

  if(str=="beere"||str=="erdbeere")
    if(erdbeere_da)
      {
	beere=clone_object(OBJ "erdbeere");
	
	if(beere->move(TP, M_GET)==ME_TOO_HEAVY)
	  {
	    beere->remove(1);
	    
	    return write(BS("Die Erdbeere waere Dir zu schwer...")), 1;
	  }
	
	write(BS("Du pflueckst die Erdbeere."));

	tell_room(TO, BS(TPN+" pflueckt eine Erdbeere."), ({TP}));
	      
	erdbeere_da=0;

	return 1;
      }
    else
      return write(BS("Die Erdbeere ist wirklich zu zerfressen.")), 1;
  
  return 0;
}

BLUMEN
