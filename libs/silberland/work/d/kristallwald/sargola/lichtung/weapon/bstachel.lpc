#include "../def.h"

inherit "std/weapon";

void create()
{
   if(!is_clone(ME)) return;
   ::create();

   SetProp(P_SHORT, "Ein Bienenstachel");
   SetProp(P_LONG,
	   BS("Ein gewoehnlicher Stachel einer Biene, der Dir aber "
	      "nun nicht mehr gefaehrlich werden kann. Er hat einen "
	      "bemerkenswerten Widerhaken."));

   AddDetail("biene",
	     "Es war wohl eine Biene, die den Stachel vor Dir besessen hat.");
   
   AddDetail( ({"widerhaken","haken"}),
	      "Schafft es die Biene, den Stachel wieder rauszuziehen, ist es "
	      "fuer ihr Opfer umso schmerzvoller.");

   SetProp(P_NAME, "Bienenstachel");
   
   AddId(({"stachel","bienenstachel"}));

   SetProp(P_WEIGHT, 20);
   SetProp(P_SIZE, 2);
   SetProp(P_VALUE, 8);
   SetProp(P_GENDER, MALE);
   SetProp(P_MATERIAL, ({MAT_CHITIN}));
   SetProp(P_WEAPON_TYPE, WT_KNIFE);
   SetProp(P_WC, 20+random(10));
   SetProp(P_NR_HANDS, 1);
   SetProp(P_DAM_TYPE, DT_PIERCE);
   SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:2]));

   SetProp(P_WC_BONUS, (["biene":10]));
}
