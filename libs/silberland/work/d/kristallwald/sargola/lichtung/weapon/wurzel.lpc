inherit "std/weapon"; 
#include <properties.h> 
#include <combat.h> 
#include <language.h> 
#include <new_skills.h>
#include "../def.h" 
 
      create()       
{        if (!is_clone(this_object()))           return; 
        ::create(); 
             AddId (({"knolle", "wurzel","wurzelknolle"})); 
        SetProp (P_SHORT, "Eine Wurzelknolle"); 
        SetProp (P_LONG, BS("Eine schwere Wurzel, welche am Ende eine "
	+"dicke Knolle hat. Sicher kann man sie gut als Waffe verwenden.")); 
        SetProp (P_NAME, "Wurzelknolle"); 
        SetProp (P_GENDER, FEMALE);  

        SetProp (P_WEIGHT, 350); 
        SetProp (P_VALUE, 30); 
        SetProp (P_MATERIAL, ({MAT_WOOD}) ); 
        SetProp (P_WEAPON_TYPE, WT_CLUB); 
        SetProp(P_DAM_TYPE, DT_BLUDGEON); 
        SetProp(P_WC, 50+random(30)); 
        SetProp(P_NR_HANDS, 1); 
	SetProp(P_WIELD_RESTRICTIONS, ([P_LEVEL:5]) );
}   

