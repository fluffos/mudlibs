inherit "std/weapon";
#include <properties.h>
#include "../def.h"
#include <combat.h>

void create()
{
   if (!is_clone(this_object())) return;
   ::create();

   SetProp(P_SHORT, "Ein Hummelstachel");
   SetProp(P_LONG,
	   BS("Ein gewoehnlicher Stachel einer Hummel, der Dir aber "
	      "nun nicht mehr gefaehrlich werden kann."));

   AddDetail("hummel",
	"Es war wohl eine Hummel, die den Stachel vor Dir besessen hat.");

   SetProp(P_NAME, "Stachel");
   SetProp(P_GENDER, MALE);
   AddId(({ "stachel","hummelstachel"}));

   SetProp(P_WEIGHT, 200);
   SetProp(P_SIZE, 5);
   SetProp(P_VALUE, 85);
   
   SetProp(P_MATERIAL, MAT_CHITIN);
   SetProp(P_WC, 20+random(10));
   SetProp(P_WEAPON_TYPE, WT_KNIFE);
   SetProp(P_DAM_TYPE, DT_SLASH);
   SetProp(P_NR_HANDS, 1);

   SetProp(P_WC_BONUS, (["hummel":10]));
}
