inherit "std/weapon"; 
#include <properties.h> 
#include <combat.h> 
#include <language.h> 
#include "../def.h" 
 
      create()       
{        if (!is_clone(this_object()))           return; 
        ::create(); 
             AddId (({"schlegel"})); 
        SetProp (P_SHORT, "Ein Schlegel"); 
        SetProp (P_LONG, BS("Ein dreckiger, abgegriffener Schlegel.")); 
        SetProp (P_NAME, "Schlegel"); 
        SetProp (P_GENDER, MALE);  

        SetProp (P_WEIGHT, 450); 
        SetProp (P_VALUE, 40); 
        SetProp (P_MATERIAL, ({MAT_IRON}) ); 
        SetProp (P_WEAPON_TYPE, WT_KNIFE); 
        SetProp(P_DAM_TYPE, DT_PIERCE); 
        SetProp(P_WC, 60+random(20)); 
        SetProp(P_NR_HANDS, 1); 
}   
