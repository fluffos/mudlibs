** date: 23-07-97
********************************************
*/

inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Meise");
  SetProp (P_LONG, BS("Eine froehlich auf der Lichtung herumflatternde "
	+"Meise."));
  SetProp (P_NAME, "Meise");
  SetProp (P_GENDER, FEMALE);
  AddId ( ({"Meise" }) );
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 18);
  create_default_npc (6);
 
  SetProp (P_HANDS, ({" mit ihrem Schnabel", 25, DT_SQUEEZE}));
  SetProp (P_ALIGN, 120);
  SetProp (P_MSGOUT, "fliegt weiter");
  SetProp (P_MSGIN, "fliegt herein");
  SetProp(P_MMSGIN, "fliegt munter herein");
  SetProp(P_MMSGOUT, "fliegt munter weiter");



  //********************
  //Props zum moving NPC
  //********************
  SetProp(P_MNPC_AREA, ROOM+"0");
  SetProp (P_MNPC_DEFAULTROOM, ROOM+"0203");
  SetProp (P_MNPC_WAIT, ({30,40,40}));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS+MOV_MOVES);


  CLONEME(OBJ+"feder");

}
