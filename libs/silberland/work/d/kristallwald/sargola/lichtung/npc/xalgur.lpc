#include "../def.h"

inherit "std/npc";

fertig();

nosave object goal;
nosave int timeout;

create()
{
  if(!is_clone(this_object())) return;
  ::create();
  
  SetProp (P_SHORT, "Der Geist Xalgurs");
  SetProp (P_LONG, 
	   BS("Der Geist Xalgurs scheint aus Wind und Nebel zu bestehen. "
	      "Doch trotz dem kann man sein boeses Antlitz erkennen. Obwohl"
	      " er keine materielle Gestalt hat, versucht er Dich zu "
	      "toeten."));
  
  SetProp(P_DIE_MSG, " loest sich in kleine Wirbel auf und verschwindet.\n");
  SetProp(P_NAME, "Xalgurs Geist");
  SetProp(P_ARTICLE, 0);
  //SetProp(P_AGGRESSIVE,1);
  SetProp(P_GENDER, MALE);
  AddId(({"geist","xalgurs geist","xalgur"}));
  create_default_npc(10);

  SetProp(P_BODY, 60);
  SetProp(P_HANDS, ({" mit einem Windstoss", 54,DT_AIR }));
  SetProp(P_ALIGN, -500);
  SetProp(P_RACE, "Elf");
  SetProp(P_HP, 90);
  SetProp(P_SIZE, 200);
  SetProp(P_XP, 0);
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "blustet sich noch mehr auf.\n");
  AddInfo("sargola", "Sargola, dieser Wurst-Magier!","blaest: ");

  SetAttackChats(25, 
		 ({"Xalgur blickt Dich furcherregend an.\n",
		     "Xalgur jagt Dir Angst und Schrecken ein.\n"
		     }));
       
  SetProp(P_SPELLRATE, 75);

  AddSpell(5,5,
  	"Xalgur wirbelt Dich durch die Luefte.\n",
  	"Xalgur wirbelt @WEN durch die Luefte.\n",
  	DT_AIR,([SP_SHOW_DAMAGE:1]));

  AddSpell(5,5,
  	"Xalgur laesst einen grossen Wirbel entstehen.\n",
  	"Xalgur laesst einen grossen Wirbel entstehen.\n",
  	DT_AIR,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,5,
  	"Xalgur blaesst Dir eisigen Wind ins Gesicht.\n",
  	"Xalgur blaesst @WEM eisigen Wind ins Gesicht.\n",
  	DT_AIR,([SP_SHOW_DAMAGE:1]));
  
  timeout=3;
}

void Attackedby(object ob)
{
  goal=ob;
  DB(BS("*** Got goal: "+sprintf("%O", goal)));
}

int Defend(int d, string *dt, mixed s, object e)
{
  if(e==goal)
    return ::Defend(d, dt, s, e);
  
  if(!random(3))
    tell_object(e, BS("Der Geist lacht Dich nur aus."));
  
  return ::Defend(0, dt, s, e);
}

void die(int arg)
{
  object ob;
  
  if(!objectp(goal)) return ::die(arg);
  
  if(objectp(ob=present("\nxalgurknochen",MENV)))
    ob->remove();
  
  if(objectp(ob=present("\nzedernquestloch",MENV)))
    ob->remove();
  
  ob=present("\nzedernquestobject",goal);
  if(objectp(ob) && ob->frage_zaehler() == 4)
    ob->fertig(goal);	
  //	WLOG("/log/quests/zeder", "bannte Xalgur");
  ::die(arg);
}

void reset()
{
  if(!is_clone(this_object())) return;
  ::reset();
  
  timeout--;
  
  if(timeout < 1)
    call_out("remove", 5);
}
