#include "../def.h"

inherit "/p/std/dragons/dragon";
inherit "/gilden/bardengilde/obj/std_spellprovider";

nosave int sleeping;

nosave string *schlaflied = ({
  "Schlaf, Drache, schlaf!",
  "Der Woody huetet die Schaf,",
  "Die Dusty schuettelt das Baeumelein",
  "Da faellt herab ein Traeumelein",
  "Schlaf, Drache, schlaf!",

  "Schlaf, Drache, schlaf!",
  "Am Himmel ziehen die Schaf",
  "Die Sterne sind die Laemmerlein",
  "Der Angrox ist das Schaeferlein",
  "Schlaf, Drache, schlaf!",

  "Schlaf, Drache, schlaf!",
  "Ich fuetter dir ein Schaf",
  "Auf einer goldnen Schale fein",
  "Das soll deine Abendmahlzeit sein",
  "Schlaf, Drache, schlaf!"
});
private int currentLine;

void go_to_sleep()
{
  SetProp(P_LONG, 
	  BS("Du siehst Thaliongalenedhel, den riesigen, gruenen Drachen "
	     "in der Mitte der Lichtung liegen. Sein Schwanz ist um seinen "
	     "Koerper gerollt und sein Kopf ruht darauf. Seine Augen sind "
	     "geschlossen, er scheint Dich nicht zu bemerken. Oder doch?"));
  
  SetProp(P_SHORT, "Thaliongalenedhel, der weise, gruene Drache schlaeft auf "
	  "dieser Lichtung");
  
  AddDetail("schwanz",
	    "Der mit gruenlichen Schuppen bedeckte Schwanz ist um seinen "
	    "ganzen Koerper gerollt. Auf ihm liegt der Kopf des Drachen.");
  
  AddDetail("kopf",
	    "Der Kopf liegt ruhig auf dem Schwanz, die Nuestern sind aufge"
	    "blaeht und gehen ein wenig auf und ab.");
  
  AddDetail("nuestern",
	    "Sie bewegen sich mit dem Atem des Drachen auf und ab.");
  
  AddDetail("atem",
	    "Den Atem moechtest Du nicht im Kampf gegen Dich gerichtet "
	    "sehen.");
  
  AddDetail("augen",
	    "Die Augen sind wohl geschlossen, aber Du bist Dir nicht sicher, "
	    "ob er Dich nicht doch beobachtet. Immerhin heisst es ja, dass "
	    "Drachen nicht so leicht zu erlegen sein sollen. Und schon gar "
	    "nicht im Schlaf...");

  sleeping=1;

  SetProp(P_AGGRESSIVE, 0);
}

varargs void wake_up(object victim)
{
  tell_room(MENV, 
	    BS("Die Erde rund um Dich herum erbebt, als der Drache "
	       "vollends wach wird..."));

  
  SetProp(P_LONG,
	  BS("Du siehst Thaliongalenedhel den riesigen, gruenen Drachen "
	     "in der Mitte der Lichtung aufgeregt mit dem Schwanz "
	     "herumfuchtelnd. Seine Augen funkeln wie zwei Diamanten, "
	     "scheinbar hat ihn jemand aus seinem Schlaf gerissen!"));
  
  SetProp(P_SHORT, "Thaliongalenedhel, der weise, gruene Drache blickt Dich "
	  "wuetend an");
  
  AddDetail("schwanz",
	    "Der mit gruenlichen Schuppen bedeckte Schwanz schwingt "
	    "bedrohlich hin und her...");
  
  AddDetail("kopf",
	    "Der Kopf wippt auf und ab und aus den Nuestern lodert das "
	    "Feuer heraus!");
  
  AddDetail("nuestern",
	    "Die Nuestern sind aufgeblaeht und warten nur darauf "
	    "das Feuer auf Dich herabzupusten...");
  
  AddDetail("atem",
	    "Der heisse Atem raubt Dir fast die Sinne!");
  
  AddDetail("augen",
	    "Seine Augen funkeln Dich wie zwei Diamanten an...");

  SetProp(P_DISABLE_ATTACK, 0); //Absicht
  SetProp(P_DISABLE_SPELLS, 0); 
  
  sleeping=0;
  currentLine = 0;
  
  if(objectp(victim) && victim->QuerySkill("abendstille ueberall") != 0)
    if(present(victim, MENV))
      Kill(victim);
}

void create()
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Thaliongalenedhel, der weise, gruene Drache");
  SetProp(P_NAME, "Thaliongalenedhel");
  SetProp(P_GENDER, MALE);
  AddId(({"elfendrache","thaliongalenedhel"}));

  set_living_name("thaliongalenedhel");  

  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME_ADJ, ({}));

  create_default_dragon(3,7,0,20);

  go_to_sleep();
  
  AddSpell(1, 200,
	   Name(WER,1)+" schnappt nach Dir.\n",
	   Name(WER,1)+" schnappt nach @WEM.\n",
	   DT_SQUEEZE, "verschluckt", ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3, 500,
	   Name(WER,1)+" zerstoert Deine Ruestung!\n",
	   Name(WER,1)+" zerstoert die Ruestung von @WEM!\n",
	   DT_BLUDGEON, "ruestung_kaputt", ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(10, 850,
	   Name(WER,1)+" streift Dich mit seinem Odem!\n",
	   Name(WER,1)+" streift @WEN mit seinem Odem!\n",
	   ({DT_FIRE, DT_POISON}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(10, 725,
	   Name(WER,1)+" reisst Dich mit seinen Krallen auf.\n",
	   Name(WER,1)+" reisst @WEN mit seinen Krallen auf.\n",
	   ({DT_RIP, DT_POISON}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 250,
	   Name(WER,1)+" packt Dich mit seinem gewaltigen Maul.\n",
	   Name(WER,1)+" packt @WEN mit seinem gewaltigen Maul.\n",
	   DT_SQUEEZE, "maul", ([SP_SHOW_DAMAGE:1]));

  AddCmd(({"sing", "singe"}), "cmd_singen");
}

public void get_angry_and_kill(object victim) {
  if(!present(victim, ENV(TO))) {
    tell_room(ENV(TO), BS(Name(WER) + " blickt sich wuetend um, findet aber " + QueryPossPronoun(WER) + " Opfer nicht."));
    return;
  }

  tell_room(ENV(TO), BS(Name(WER) + " stuerzt sich wuetend auf " + victim->Name(WEN, 1) + "."), ({victim}));
  tell_object(victim, BS(Name(WER) + " stuerzt sich wuetend auf Dich."));
  Kill(victim);
  return;
}

public string GetSchlaflied(int from, int to) {
  int i;
  string str;

  str = "";
  for(i=from;i<to;i++) {
    str += schlaflied[i] + "\n";
  }

  return str;
}

public int cmd_singen(string str) {
  string line;

  if(sleeping) return 0;
  if(TP->QueryProp(P_GUILD) != "bardengilde") return 0;
  if(TP->QuerySkill("abendstille ueberall") != 0) {
    write("Das bringt nichts! Den Trick kennt der Drache schon!!\n");
    return -1;
  }

  if(str == 0 || str == "") str = "Oh sole mio!";
  else str = TP->_unparsed_args();

  // ggf. fehler ausbessern
  while(find_call_out("get_angry_and_kill")!=-1) remove_call_out("get_angry_and_kill");

  line = lowerstring(regreplace(schlaflied[currentLine], "[,!.]", "", 1));
  str  = lowerstring(regreplace(str, "[,!.]", "", 1));
  
  if(str != line) {
    tell_object(TP, BS(sprintf("Du singst: '%s'", str)));
    tell_room(ENV(TP), BS(sprintf("%s singt: '%s'", TP->Name(WER, 1), str)), ({TP}));
    tell_room(ENV(TO), BS(Name(WER) + " knurrt boesartig. Ohje! Irgendwas war wohl falsch an dem Lied!"));
    call_out("get_angry_and_kill", 5, TP);
    return -1;
  }
  
  tell_object(TP, BS(sprintf("Du singst: '%s'", schlaflied[currentLine])));
  tell_room(ENV(TP), BS(sprintf("%s singt: '%s'", TP->Name(WER, 1), schlaflied[currentLine])), ({TP}));

  currentLine++;
  if(currentLine%5==0) {
    tell_room(ENV(TO), BS(Name(WER)+ " gaehnt und wird mueder."));
  }
  if(currentLine >= sizeof(schlaflied)) {
    call_out("schlafen_check", 2);
    call_out("LearnBardSpell", 4, TP, "abendstille ueberall",
              "Mit diesem Lied machst du deine Feinde muede und sie "
              "werden langsamer.",
              "spiele 'abendstille ueberall'");
    currentLine = 0;
  }
  return 1;
}

void init()
{
  ::init();
  
  if(!sleeping)
    command_me("nimm alles");
}

void maul(object enemy, int damage, mixed dam_type)
{
  object *ar;
  
  if (!objectp(enemy) || !present(enemy, environment()))
    return;
  if((!random(11-sizeof(QueryEnemies()))) && 
     (random(enemy->QueryAttribute(A_DEX)) < 15))
    {
      tell_object(enemy, 
		  Name(WER,1)+" verschluckt Dich und Du landest im "
		  "Magen.\n");
      
      tell_room(MENV, 
		Name(WER,1)+" verschluckt "+enemy->name(WEN,2)+"!\n",
		({TO, enemy}) );
      
      enemy->move(ROOM "magen", M_GO);
      
      StopHuntFor(enemy, 1);
    }
  else
    {
      tell_room(MENV, 
		Name(WER,1)+ " zerbeisst "+enemy->name(WEN,2)+
		" beinahe.\n", ({TO, enemy}) );
      
      if(sizeof(ar=enemy->QueryArmours()))
	{
	  tell_object(enemy, BS(Name(WER,1)+" beisst fest zu und zerstoert "
				"dadurch Deine Ruestung."));
	  
	  ar[random(sizeof(ar))]->TakeFlaw(1+random(5));
	}
      else
	{
	  tell_object(enemy, BS(Name(WER,1)+" beisst fest in Deine "
				"ungeschuetzte Haut."));
	  
	  enemy->Defend(300+random(400),DT_RIP,
			([SP_NAME:"Drachenbiss", SP_SHOW_DAMAGE:1]),TO);
	}
    }
}

void give_notify(object ob)
{ 
  if(ob->id("\ngnomkraeuter"))
    { 
      catch(call_other(ROOM "magen", "???"));
      
      tell_room(find_object(ROOM "magen"),
		BS("Du siehst, wie ein Bueschel Kraeuter vom "
		   "Hals des Drachen zu Dir herunterfaellt."));
      ob->move(find_object(ROOM "magen"));
      
      return;
    }
  
  tell_object(TP, 
	      "Der Drache verschlingt "+ob->QueryProp(P_NAME)+" gierig.\n");

  ob->remove();
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if((interactive(enemy)) && (enemy->QueryProp(P_LEVEL)<20))
    {
      tell_object(enemy, 
		  BS("Der Drache blickt Dich finster an.")+
		  BS("Du solltest schnell das Weite suchen."));
      
      enemy->StopHuntFor(ME, 1);
      StopHuntFor(enemy, 1);
      
      enemy->command_me("osten");
      
      return 0;
    }

  if(sleeping)
    {
      tell_room(MENV, BS("Der Drache beginnt aufzuwachen..."));

      sleeping=0;

      SetProp(P_DISABLE_ATTACK, 4); //Absicht
      SetProp(P_DISABLE_SPELLS, 4); 

      call_out("wake_up", 3+random(2));
    }
  
  return ::Defend(dam, dam_type, spell, enemy);
}

void ruestung_kaputt(object enemy, int damage, mixed dam_type)
{
  object *ar;

  if(sizeof(ar=enemy->QueryArmours()))
    ar[random(sizeof(ar))]->TakeFlaw(1+random(5));
  else 
    enemy->do_damage(20);
}

void verschluckt(object enemy, int damage, mixed dam_type)
{
  if (!objectp(enemy) || !present(enemy, environment()))
    return;
  if((!random(3)) && (random(enemy->QueryAttribute(A_DEX)) > 18))
    if(interactive(enemy))
      {
	tell_object(enemy, 
		  BS(Name(WER,1)+" verschluckt Dich und Du landest im "
		     "Magen."));
	
	tell_room(MENV, 
		  BS(Name(WER,1)+" verschluckt "+enemy->name(WEN,2)+"!"),
		  ({TO, enemy}) );
	
	enemy->move(ROOM "magen", M_GO);
	
	StopHuntFor(enemy, 1);
      }
    else
      enemy->do_damage(30);
  else
    {
      tell_object(enemy,
		  BS("Im letzten Moment schaffst Du es, dem Drachenkopf "
		     "auszuweichen, doch einer der giftigen Zaehne streift Dich..."));
      enemy->AddPoison(1);
    }
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  WLOG("/d/kristallwald/sargola/log/dragon.kill", 
       " wurde vom Drachen gekillt" );

  heal_self(500);

  tell_room(MENV, BS(Name()+" wird kurz von einer Aura eingehuellt!"));

  command_me("nimm alles aus leiche");
  command_me("iss leiche");
}

void die(int death)
{
  object *player;
  int zaehler;
  
  //sollte niemand verschluckt worden sein :)
  call_other(ROOM "magen", "???");
  
  WLOG("/d/kristallwald/sargola/log/dragon.dead", 
       " killt den gruenen Drachen");

  player = all_inventory(find_object(ROOM "magen"));

  if(sizeof(player))
    for(zaehler=sizeof(player)-1;zaehler >-1;zaehler--)
      {
	if(player[zaehler]->query_once_interactive())
	  tell_object(player[zaehler], 
		      BS("Der Drache wird toedlich getroffen und "
			 "Du kannst endlich wieder ins Freie."));
	
	player[zaehler]->move(ROOM "gang2", M_GO);
      }
  
  catch(present("\nzechpreller_quest_11", QueryProp(P_KILLER))->Mark());
  
  ::die(death);	
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if(find_call_out("reaction") != -1) return;

  if(touch)
    call_out("reaction", 0, TP, 
	     "beginnt, ob Deiner Beruehrung aufzuwachen...",
	     "beginnt, ob "+TP->Name(WESSEN)+" Beruehrung aufzuwachen.");
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if(present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
      call_out("wake_up", 2+random(2), ob);
    }
}

varargs int StopHuntFor(object arg, int silent)
{
  int tmp;

  if(tmp=::StopHuntFor(arg, silent))
    call_out("schlafen_check", 5);
  
  return tmp;                                                                  
}

varargs mixed StopHuntingMode(int silent)
{
  call_out("schlafen_check", 5);
  
  return ::StopHuntingMode(silent);
}

void schlafen_check()
{
  if(m_sizeof(GetEnemies())) return;
  
  tell_room(MENV, BS("Der gruene Drache legt sich wieder schlafen..."));

  go_to_sleep();
  
  heal_self(500);
}
