/*
*********************************************
** Anfaengermonster
** bei hohem seher, hummelschwarm
**
*********************************************
*/
#include "../def.h"

inherit "std/mnpc";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Eine Hummel");
  SetProp(P_LONG, 
	  BS("Die Hummel brummt laut beim Fliegen. Sie ist fuer "
	     "eine Hummel recht gross."));
  SetProp(P_NAME, "Hummel");
  SetProp(P_GENDER, FEMALE);
  AddId(({"hummel"}));
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 10);
  SetProp(P_WEIGHT, 40);
  create_default_npc(3);

  SetProp(P_HANDS, ({" mit ihrem Stachel", 30,DT_POISON}));
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_HEAL,0);

  SetProp(P_MSGOUT, "brummt weiter");
  SetProp(P_MSGIN, "brummt herein");
  SetProp(P_MMSGIN, "brummt munter herein");
  SetProp(P_MMSGOUT, "brummt munter weiter");

  AddInfo(DEFAULT_INFO, "brummt herum.\n");

  SetProp( P_REJECT, ({REJECT_DROP,
		       "Wie soll das eine Hummel tragen koennen?\n"}));
  SUID;
  CLONEME(WEAPON "hstachel");
  command_me("zuecke stachel");

  //********************
  //Props zum moving NPC
  //********************
  SetProp(P_MNPC_AREA, ROOM+"0");
  SetProp(P_MNPC_DEFAULTROOM, ROOM+"0404");
  SetProp(P_MNPC_WAIT, ({20,30,30}));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS+MOV_MOVES);

  SetChats(3, ({
    "Die Hummel brummt von einer Blume zur naechsten.\n",
      "Die Hummel brummt um Dich herum.\n",
      "Die Hummel brummt auf und ab.\n"}));

  SetAttackChats(10, ({
    "Die Hummel brummt Dich boese an.\n",
      "Die Hummel kommt Dir mit ihrem Stachel gefaehrlich nahe!\n",
      "Die Hummel brummt um Dich herum.\n"}));

  SetProp(P_SPELLRATE, 5);

  AddSpell(2, 60,
	   "Die Hummel will Dich mit ihrem Stachel stechen.\n",
	   "Die Hummel will "+TP->Name(WEN)+" mit ihrem Stachel stechen.\n",
	   ({DT_POISON, DT_PIERCE}),([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 90,
	   "Die Hummel piekst Dich.\n",
	   "Die Hummel piekst "+TP->Name(WEN)+".\n",
	   ({DT_POISON, DT_PIERCE}),([SP_SHOW_DAMAGE:1]));
}
