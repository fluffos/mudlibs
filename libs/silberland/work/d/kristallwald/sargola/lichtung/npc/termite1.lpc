inherit "std/npc"; 


#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>

#include "../def.h"
     
      create()
      {
      if (!is_clone(TO)) return;
       ::create();
     
        AddId ( ({"termite"}) );
        SetProp (P_GENDER, FEMALE);
     
        //P_NAME wird im Satz verwendet und soll aus einem Wort bestehen
        SetProp (P_NAME, "Termite");
        SetProp (P_SHORT, "Eine Termite");         // zB Ein Erdmaennchen...
     
        SetProp (P_ARTICLE, 1);
        SetProp(P_RACE, "Insekt");
        SetProp(P_SIZE, 2);
     
        SetProp (P_LONG,BS("Du siehst eine kleine, boese Termite.\n"));
     
        create_default_npc(2);
        SetProp (P_ALIGN, -100);
     
}
