inherit "std/room";

#include <properties.h>
#include <combat.h>
#include <moving.h>

#include "../def.h"

funcs(int msg);
string blabla();
int toete(string str);
raus();
check(object ob);
ruest(object ob);
int kitzel(string str);
int durchsuche(string str);
int kletter(string str);
int wirf(string str);

create()
{
	::create();
	
	SetProp(P_INT_SHORT, "Im Magen eines Drachen");

	
	SetProp(P_LIGHT, 1);
	SetProp(P_INDOORS, 1);
	SetProp(P_NOQUIT, 1);
	

	AddDetail("drache","Den wuerdest Du lieber von aussen sehen.");
	AddDetail(({"inneren","inneres"}),"Mitten drin sozusagen...");
	AddDetail("boden",
		"Den kannst Du nicht sehen, der Magen ist ja mit Magensaeure "
		+"gefuellt! Vielleicht sind ja Gegenstaende von anderen Aben"
		"teurer zu Boden gesunken...");
		
	AddDetail("gegenstaende","Durchsuch die Magensaeure danach - dann findest "
		"Du vielleicht was. ");

	AddDetail( ({"saeure","magensaeure","fluessigkeit","magenfluessigkeit"}),
		"Der Magen ist von einer gelblichen, beissenden Fluessigkeit "
		+"gefuellt. Du merkst, wie sich deine Ruestungsteile immer "
		+"mehr zersetzen. Ausserdem siehst Du eine gruene Pflanze.");		

	AddDetail("pflanze","Es sind schon ziemlich zersetzte Kraeuter, die "
		"in seinem Magen herumschwimmen. Wie die da reinkommen?");
	AddDetail("kraeuter","Sie sind schon ganz zersetzt.");

	AddDetail("decke",
		"Es ist ziemlich daemmrig, aber Du kannst hin und wieder "
		+"seine Muskulatur ueber und neben Dir sehen. Vom Hals kommt "
		"ein kleiner Lichtstrahl.");

	AddDetail(({"muskeln","muskulatur"}),
		"Die Magenwaende und die Decke sind mit starken Muskelstraehnen "
		"durch zogen.");

	AddDetail(({"straehnen","muskelstraehnen"}),
		"Du moechtest gar nicht wissen, was der Drache schon so alles "
		+"verdaut hat...");

	AddDetail("hals",
		"Der Hals fuehrt steil nach oben ... vielleicht kann man da "
		+"ja wieder nach oben klettern? Der einzige Lichtschein, den "
		+"Du hast, kommt von dort.");
		
	AddDetail(({"licht","lichtschein","schein","strahl","lichtstrahl"}),
		"Nur sehr selten, wenn der "
		"Drache sein Maul oeffnet, dringt ein Lichtstrahl zu Dir herunter "
		"und Du geraetst bei dem Anblick gleich noch mehr in Panik.");
		
	AddDetail("maul","Durch den Hals kannst Du zwar das Maul sehen, aber es "
		"ist zu weit weg...");

	AddDetail("ding","Du kannst es nicht erkennen.");
	
	AddDetail("magen","Was glaubst Du, wo Du hier bist? :))");

	AddDetail("freie","Das ist weit oben ...");
	AddDetail("gaumen","Hmm... vielleicht kann man den mit irgendwas kitzeln, was "
		"den Gaumen reizen koennte. Vielleicht was pflanzliches...");

	AddDetail("panik","Gleich bricht sie aus...");
	AddDetail("anblick","Damit Du nicht vollends in Panik ausbrichst, be"
		"schreib ich das lieber nicht.");
		
	AddDetail(({"waende","magenwaende","wand","magenwand"}),
		"Die mit starken Muskeln durchzo"
		"genen Magenwaende reiben bedrohlich hin und her ... vielleicht "
		"zerquetschen sie Dich bald ...");

	AddSmell(DEFAULT_SMELL,
		"Dir ist schon uebel, so ekelerregend riecht es hier. Besonders "
		+"die Saeure stinkt.");

	AddSmell( ({"saeure","gestank"}),
		"Der Gestank ist wirklich penetrant.");

	AddSound(DEFAULT_SOUND,
		"Du hoerst ein Gurgeln der Saeure und den Atem des Drachen.");

	AddSound("gurgeln",
		"Die aufsteigenden Gasblasen in der Magenfluessigkeit gurgeln "
		+"munter vor sich hin.");

	AddSound( ({"atemzuege","zuege","atem"}),
		"Tiefe, lange Atemzuege, die Dein Haar verwuscheln.");

	AddRoomMessage ( ({
		"Die Magensaeure blubbert etwas staerker.\n",
		"Du denkst . o 0 (Meine Ruestung loest sich bald auf...)\n",
		"Du merkst, wie die Fluessigkeit Deine Haut zersetzt.\n",
		"Der Drache bruellt aus voller Kehle.\n",
		"Du schwimmst eine Runde, weil Dir fad ist.\n",
		"Der Drache quetscht Dich zwischen den Magenwaenden ein.\n",
		"Durch den Hals des Drachen stroemt ein Lichtstrahl.\n"
		}),5, "funcs" );


	AddCmd( ({"raus"}),"raus");
	AddCmd( ({"toete","toet"}), "toete");
	AddCmd( ({"kitzel","kitzl","kitzle"}), "kitzel");
	AddCmd( ({"durchsuche","durchsuch"}), "durchsuche");
	AddCmd( ({"kletter","klettere"}), "kletter");
	AddCmd( ({"wirf","werf","werfe","lass","leg","lege"}), "wirf");
}

int wirf(string str)
{
  tell_object(TP, BS("Du wirst doch nicht Deine Sachen in die Saeure werfen oder?"));
  return 1;
}

int kletter(string str)
{
  notify_fail("Wohin moechtest Du hochklettern?\n");
  if(!str) return 0;
  
  if(str=="hals hoch"
	|| str=="hals rauf"
	|| str=="an hals hoch"
	|| str=="durch hals"
	|| str=="an hals hoch"
	|| str=="an hals rauf"
	|| str=="rauf"
	|| str=="nach oben")
  {
    tell_object(TP, BS("Du beginnst beherzt mit einem Versuch, durch den Hals "
      "des Drachen wieder ins Freie zu klettern. Du kommst sogar am Gaumen "
      "vorbei, kitzelst den Drachen dadurch nur und faellst wieder zurueck. "
      "Hmm...."));
    tell_room(TO, BS(TPN+" versucht durch den Hals des Drachen zu klettern, "
      "faellt aber wieder zurueck."), ({TP}));
    return 1;
  }
  return 0;
}

int durchsuche(string str)
{
  notify_fail("Was moechtest Du durchsuchen?\n");
  if(!str) return 0;
  
  if(str=="magensaeure"||str=="saeure"||str=="fluessigkeit"||str=="magenfluessigkeit")
  {
    tell_object(TP, BS("Du wuehlst ganz wild in der Magensaeure herum, kannst ein "
      "Ding auch fast fassen... aber es flutscht wieder weg."));
    return 1;
  }
  return 0;
}


int kitzel(string str)
{  object kr;
   int z;

	notify_fail("Wen willst Du kitzeln?\n");
	if(!str) return 0;

	if(str=="drachen"||str=="drache"||str=="gaumen")
	{
	  tell_object(TP, "Womit willst Du denn den Drachen kitzeln?\n");
	  return 1;
	}
	if(str=="gaumen")
	{
	  tell_object(TP, "Womit willst Du denn den Drachen kitzeln?\n");
	  return 1;
	}
	notify_fail("Wen willst Du womit kitzeln?\n");
	if(  str=="drache mit kraeutern"
	   ||str=="drache mit kraeuter"
	   ||str=="drachen mit kraeutern"
	   ||str=="drachen mit kraeuter"
	   ||str=="drache mit bueschel"
	   ||str=="drachen mit bueschel"
	   ||str=="gaumen mit bueschel"
	   ||str=="gaumen mit kraeutern")
	{
		if(!present("\ngnomkraeuter", TP))
		{
			tell_object(TP, "Du hast nichts Passendes dabei, um den "
			   +"Drachen zu kitzeln. Vielleicht waeren ein Paar herbe "
			   "Kraeuter hier richtig...\n");
			return 1;
		}
		else
		{
		   tell_object(TP, "Du zueckst Deine Kraeuter und beginnst den Drachen damit "
		      +"gemein am Gaumen zu kitzeln.\n");
		   kr = present("\ngnomkraeuter",TP);
		   if(objectp(kr))
		   {
		      z = kr->QueryProp(P_AMOUNT);
		      if(z>1)
			kr->SetProp(P_AMOUNT, kr->QueryProp(P_AMOUNT)-1);
		      else
			kr->remove();
		   }
		   tell_room(TO, TPN+" beginnt mit Kraeutern den Gaumen des Drachen zu kitzeln.\n",({TP}) );
		   if(find_call_out("kitzel_drache") == -1)
		   	call_out("kitzel_drache", 5 );
		   return 1;
		}
	}
	return 0;
}

kitzel_drache()
{
	tell_room(TO, "Der Drache muss fuerchterlich husten...\n");
	if(find_call_out("kitzel_drache1") == -1) call_out("kitzel_drache1",3);
}

kitzel_drache1()
{
	object *players;
	int i;
	tell_room(TO, "Der Drache wuergt euch mit einem kraeftigen HATSCHIIIII wieder an die "
		+"freie Luft.\n");
	players = filter_array(all_inventory(TO), "check");	
	for(i = sizeof(players)-1;i>-1;i--)
	{
		tell_object(players[i], "Der Drache hustet Dich lauthals wieder in die "
		+"Freiheit.\n");
		players[i]->move(ROOM+"gang2", M_GO, "wird aus dem Hals","wunder","wird aus dem Hals gehustet");
	}
}

raus()
{
	tell_object(TP, "Das waere doch zu einfach!\n");
	return 1;
}

int toete(string str)
{
	notify_fail("Wie bitte?\n");
	if(!str) return 0;

	if(str=="drache")
	{
		tell_object(TP, "Die Magenwaende sind von der Saeure derart "
		+"resistent, Du wuerdest keinen Schaden ausrichten.\n");
		return 1;
	}
	return 0;
}


funcs(int msg)
{
	int i;
	object *ruestungen, *players;
	object was;
	int anz, wieviel;
	players = filter_array(all_inventory(TO), "check");	

	switch(msg)
	{
	case 1:
	case 2:
	case 3:

	{  object rues;
	for(i=sizeof(players)-1;i>=0;i--)
	{	
	    rues = players[i]->QueryProp(P_ARMOURS);
	    anz = sizeof(rues);
	    if(anz) 
	    {
		was= rues[random(anz)];
		wieviel = was->QueryProp(P_DAMAGED) + random(5);
   		was->SetProp(P_DAMAGED, wieviel);
	    } 
	    else
		players[i]->do_damage(20);	     
	}
	}
	case 4:
	case 5:
	case 6:
	{
	   for(i=sizeof(players)-1;i>=0;i--)
	   {
	   	players[i]->do_damage(random(20),TO);
	   }
	}
	case 7:
	{
	   for(i=sizeof(players)-1;i>=0;i--)
		players[i]->reduce_hit_point(random(20));
	}
	}
	return 1;
}

init()
{
	::init();
	if(TPN == "Fenris")
	{
	   tell_object(TP, "\n\nFenris!\nBist also doch noch gekommen....\nDu hoerst ein irres Lachen von Sargola aus der Ferne.\n\n\n");
	}
}

_query_int_long()
{
	string ret;
	ret = 
	"Du befindest Dich im Inneren des Drachen. Genauer gesagt ist das "
	+"hier wohl sein Magen. Es riecht absolut widerlich und Dir "
	+"wird schlecht. Nur sehr spaerliches Licht dringt manchmal vom "
	+"Hals zu Dir nach unten.\n";

	if(TP->QueryProp(P_SIZE) < 150)
	{
		ret+="Du stehst bis zum Hals in einer aetzenden Fluessigkeit.\n";
	}
	else
	{
		ret+="Du stehst bis zu den Hueften in einer aetzenden Fluessigkeit.\n";
	}
	return BS(ret);
}


check(object ob)
{
	if(environment(ob) == TO )
		return 1;
	else
		return 0;
}

ruest(object ob)
{
	if(ob->id("ruestung"))
		return 1;
	return 0;
}