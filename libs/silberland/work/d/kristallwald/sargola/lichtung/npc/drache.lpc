inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include "../def.h"

//void clone(object enemy, int damage, mixed dam_type);

create()
      {
      if (!is_clone(TO)) return;
       ::create();
        AddId ( ({"walddrache","drache"}) );
        SetProp (P_GENDER, MALE);
        SetProp (P_RACE, "Drache");
   SetProp (P_NAME, "Drache");
        SetProp (P_SHORT, "Ein Drache"); 
        SetProp (P_ARTICLE, 1);
        
        SetProp (P_LONG,BS("Du siehst einen riesigen, uralten Walddrachen, "
        	+"der sicher schon hunderte Jahre alt ist. Er hat gewaltige "
        	+"durchschimmernde Fluegel und seine Krallen koennen sicherlich "
        	+"schweren Schaden zufuegen.\n"));

   AddDetail( "fluegel", BS("Er besitzt vier Fluegel - zwei grosse und zwei "
   	+"kleinere. Die groesseren dienen, um genuegend Aufwind zu schaffen. Die "
   	+"kleineren benoetigt der Drache, um zu navigieren. Die Fluegel sind aus "
   	+"seltsam durchscheinendem Material und haben an den Enden lange Baelle. "
   	+"Wozu die dienen, ist Dir ein Raetsel.\n") );
   	
  AddDetail("aufwind",
  	"Den Aufwind schafft sich der Drache durch die grossen Fluegel.");

   AddDetail( ({"material"}), BS("Du kannst Licht durch die Fluegel durchscheinen "
   	+"sehen. Irgendwie erinnern Dich die Fluegel an die von Fliegen. Nur dass "
   	+"sie wesentlich groesser sind. Sie haben eine Spannweite von guten vier "
   	+"Metern.\n") );
        
   AddDetail( "licht", BS("Das Licht scheint verschwommen durch die duennen "
   	+"Fluegel des Drachen. Es bricht sich in die Regenbogenfarben.\n") );
   
   AddDetail( ({"regenbogenfarben","farben"}),
        	BS("Die Fluegel schimmern in vielen Farben - der Drache wirkt "
        	+"dadurch noch maechtiger..\n") );
        	
   AddDetail( "fliege", BS("Eine Fliege kannst Du hier nich sehen, aber die "
   	+"Fluegel erinnern Dich an die von Fliegen.\n") );
   	
   AddDetail( ({"spannweite","weite"}), BS("Sie ist schon gewaltig. Du hast "
   	+"noch nie so einen Drachen gesehen.\n") );
   	

	SetProp (P_ALIGN, -200);
	SetProp (P_LEVEL, 36);
	SetProp (P_RACE, "Vogel");
	SetProp (P_MAX_HP, 1500);
	SetProp (P_MAX_SP, 1500);
	SetProp (P_XP,1600000);
	SetProp (P_BODY, 400);
	SetProp (P_MAX_HANDS, 4);
	SetProp (P_SIZE, 700);
	SetProp (P_HANDS, ({" mit seinen scharfen Krallen", 320, DT_RIP}) );

    SetProp(P_RESISTANCE_STRENGTHS, 
    ([DT_MAGIC:-0.5,
       DT_ACID:-0.5,
       DT_POISON:-0.6,
       DT_COLD:1.4,
       DT_TERROR:-0.2,
       DT_FIRE: -0.6
       ]) );
       
	set_living_name("walddrache"); 
	SetProp(P_SPELLRATE, 95);
	                  
/*	AddSpell(12,950,
	"Der Drache speit seinen Odem auf Dich!\n",
        "Der Drache speit seinen Odem auf @WEN.\n",
	DT_MAGIC, ([SP_SHOW_DAMAGE:1]));

	AddSpell(5,250,
	"Der Drache schleudert Dich mit einem maechtigen Schlag zurueck.\n",
	"Der Drache schleudert @WEN mit einem maechtigen Schlag zurueck.\n",
	DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
	                              
	AddSpell(5,300,
	"Der Drache schlitzt Dir mit seinen scharfen Krallen die linke Hand auf.\n",
	"Der Drache schlitz  @WEM mit seinen scharfen Krallen die linke Hand auf.\n",
	DT_MAGIC, ([SP_SHOW_DAMAGE:1]));
	         
*/	         
	AddSpell(1 ,1,
	"################Der Drache bruellt markerschuetternd.\n",
	"################Der Drache bruellt markerschuetternd.\n",
	 DT_MAGIC,"spell_clone");

	AddSpell(1,1,
	"$$$$$$$$$$$$$$$$$$$$$$$Der Drache verschluckt Dich.\n",
	"$$$$$$$$$$$$$$$$$$$$$$$Der Drache verschluckt @WEN.\n",
	DT_MAGIC,"spell_verschlucken");	
	                                 
	SetAttackChats(30, ({
	"Der Drache baeumt sich zu unheimlicher Groesse auf.\n",
	"Dem Drachen stroemen dichte Daempfe aus den Nuestern.\n",
	"Der Drache schreit aus tiefer Kehle.\n",
	"Der Drache zeigt Dir seine scharfen Zaehne.\n",
	}) );
	                                                                         	                      
}

void spell_clone(object enemy, int damage, mixed dam_type)
{
	write("\nDu hoerst ein Rascheln um dich herum. Ploetzlich stuerzt "
	+"ein kleiner Drache aus dem Gebuech und greift Dich an!");
	if(!present("babydrache",environment(enemy)))
		(clone_object(NPC+"babydrache.lpc"))->move(environment(enemy));
}
void spell_verschlucken(object enemy, int damage, mixed dam_type)
{
	write("FAJSFLJAFJASF");
	
}	