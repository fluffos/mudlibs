/*
** Eine kleine aggressive Termite
**
**  2002-05-07  PROtheG  Neuueberarbeitung
*/

#include "../def.h"

inherit "std/npc"; 

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine aggressive Termite");
  SetProp(P_LONG,
	  BS("Du siehst eine kleine, boese Termite."));

  SetProp(P_NAME, "Termite");
  AddId(({"termite"}));
  SetProp(P_GENDER, FEMALE);
  
  SetProp(P_NAME_ADJ, "aggressiv");
  AddAdjective(({"aggressive","aggressiven"}));
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 2);
  SetProp(P_WEIGHT, 20);

  SetProp(P_MAX_HANDS, 6);
  SetProp(P_HEAL, 5);
  
  create_default_npc(4);

  SetProp(P_HANDS,({" mit ihrem kleinen Gebiss", QueryProp(P_HANDS)[1], 
		      DT_SQUEEZE}));
  SetProp(P_ALIGN, 100);  

  SetProp(P_MSGIN, "krabbelt Dir ueber den Fuss");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG, " wird zerquetscht.\n");
  SetProp(P_REJECT, ({ REJECT_DROP,
    "Wie soll denn das die kleine Termite tragen koennen?\n"}));

  SetProp(P_AGGRESSIVE, 1);
  
  SetProp(P_SPELLRATE, 5);

  AddSpell(1, 40,
	   "Die Termite zwickt Dich fest.\n",
	   "Die Termite zwickt "+TP->name(WEN)+" fest.\n",
	   DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));
}
