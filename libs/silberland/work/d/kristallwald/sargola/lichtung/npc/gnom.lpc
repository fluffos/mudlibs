#include "../def.h"

inherit "std/npc";

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein kleiner, runzeliger Waldgnom");
  SetProp(P_LONG, 
	  BS("Ein kleiner, runzeliger Waldgnom steht vor "
	     "Dir. Er hat einen dicken, breitkrempigen Hut auf und "
	     "eine markante, knollenartige Nase. Durch seine kleinen "
	     "und dunklen Augen sieht er alles."));

  SetProp(P_DIE_MSG, " verendet stumm.\n");
  SetProp(P_NAME, "Waldgnom");
  SetProp(P_GENDER, MALE);

  AddId(({"maennchen","gnom", "waldgnom"}));

  create_default_npc(28);

  SetProp(P_HANDS,({" mit winzigen Haenden", 200,DT_BLUDGEON}));
  SetProp(P_ALIGN, -100);
  SetProp(P_RACE, "Gnom");
  SetProp(P_SIZE, 110);
  SetProp(P_WEIGHT, 35109);

  SetProp(P_MSGOUT, "trampelt weiter");
  SetProp(P_MSGIN, "trampelt herein");
   
  SUID;  

  CLONEME(ARMOUR "khut");
  CLONEME(ARMOUR "khose");

  if(random(5)) CLONEME(OBJ "kraeuter");
  if(random(3)) CLONEME(OBJ "kraeuter");

  command_me("trage alles");
    
  AddInfo("gnom",
	  "blickt Dich fragend an.\n");

  AddInfo(({"schoepfer","sargola"}),
	  "Sargola ist der Schoepfer dieses herrlichen Waldes..",
	  "sagt: ");

  AddInfo("feyaria",
	  "Ich habe gehoert, dass es eine solche Elfe geben soll.", 
	  "sagt: ");

  AddInfo("kraeuter",
	  "Die hab ich hier im Wald gefunden. Aber sie sind sehr selten "
	  "und man braucht grosse Erfahrung, um sie zu finden. Also "
	  "ehrlich gesagt, ich traue es Dir nicht zu. *zwinker*",
	  "sagt: ");

  AddInfo("erfahrung",
	  "Wenn einer damit Erfahrung hat, dann ich und die alte Shardin.",
	  "sagt: ");

  AddInfo("shardin",
	  "Shardin ist eine maechtig weise Frau. Ich habe sie allerdings "
	  "schon lange nicht mehr gesehen. Sie kommt nicht mehr in diese "
	  "Gebiete.",
	  "sagt: ");

  AddInfo("gebiete",
	  "Ich meine den Wald hier um die Lichtung.", 
	  "sagt: ");

  AddInfo(({"lichtung","wald"}),
	  "Frag mich nicht so triviale Sachen.", 
	  "sagt: ");

  AddInfo("hut",
	  "Mein Hut ist toll nicht?", 
	  "sagt stolz:");

  AddInfo("elessar",
	  "Ich kenne Elessar, obwohl ich mich selten an elfische Orte heran"
	  "traue.", 
	  "sagt: ");

  AddInfo("baaleth",
	  "Ich glaub ich weiss, wen Du meinst. Sie kommt hin und wieder und "
	  "sieht sich auf der Lichtung die alte Zeder an.",
	  "sagt: ");

  AddInfo("zeder",
	  "In der Mitte der Lichtung, es ist Dir sicher schon aufgefallen, "
	  "ist eine alte Zeder.", 
	  "sagt: ");
  
  SetAttackChats(10,({
    "Der Gnom funkelt Dich boese an.\n",
      "Der Gnom ruft seine Freund aus dem Wald zu Hilfe.\n",
      "Der Gnom kneift Dich in die Wade.\n",
      "Der Gnom zieht verbissen seinen Hut tiefer ins Gesicht!\n",
      "Der Waldgnom baeumt sich auf und wird zum Berserker!\n"}));
  
  SetProp(P_SPELLRATE, 70);
  
  AddSpell(2, 300,
	   "Der Gnom schleudert Dir juckende Kraeuter ins Gesicht!\n",
	   "Der Gnom schleudert @WEM juckende Kraeuter ins Gesicht!\n",
	   DT_ACID, "kraeuter");
  
  AddSpell(5,140,
	   "Der Gnom springt dir wutentbrannt an die Gurgel!\n",
	   "Der Gnom springt @WEM wutentbrannt an die Gurgel!\n",
	   DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(5,170,
	   "Der Gnom tritt Dir gegen das Schienbein.\n",
	   "Der Gnom tritt @WEN gegen das Schienbein.\n",
	   DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(1,1,
	   "Der Gnom murmelt: \"Balsam!\".\n",
	   "Der Gnom murmelt: \"Balsam!\".\n",
	   DT_MAGIC, "balsam");
}

void die(int arg)
{
  WLOG("/d/kristallwald/sargola/log/gnom", "killt den Gnom");
  
  ::die(arg);
}

void balsam(object enemy, int damage, mixed dam_type)
{
  heal_self(100+random(100));
}

void kraeuter(object enemy, int damage, mixed dam_type)
{
  tell_object(enemy, 
	      BS("Du wirst von einem schrecklichen Juckreiz gequaelt."));

  enemy->AddHp(-10);

  if(find_call_out("kraeuter1")==-1)
    call_out("kraeuter1", 10, enemy);
}

void kraeuter1(object enemy)
{
  tell_object(enemy, 
	      BS("Du kratzt Dir vor lauter Jucken das ganze Gesicht auf."));

  enemy->AddHp(-25);
}
