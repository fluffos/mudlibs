inherit "std/unit";
#include <properties.h>
#include "../def.h"

int essen();

void create()
{
   if (!is_clone(this_object())) return;
   ::create();

   SetProp(P_SHORT, "Ein Bueschel Kraeuter");
   SetProp(P_LONG,
	"Ein Bueschel Kraeuter, welches Du nicht genauer bestimmen "
	+"kannst.");
   SetProp(P_GENDER, NEUTER);
   SetProp(P_ARTICLE, 0);
   SetProp(P_NAME, "Bueschel Kraeuter");
   AddId(({ "kraeuter","bueschel","kraut", "\ngnomkraeuter"}));
   AddSingularId(({"kraut","bueschel"}));
   AddPluralId("bueschel kraeuter");
   AddPluralId("kraeuter");
   SetCoinsPerUnits(10,1);
   SetCoinsPerUnits(1,1);
   SetProp(P_WEIGHT, 100);
   SetProp(P_VALUE, 100);
   SetProp(P_MATERIAL, MAT_PLANT);  
   AddCmd("iss","essen");
}


essen(string str)
{
   tell_object(TP, "Du verspeist die trockenen Kraeuter.\n");
   tell_room(MENV, TPN+" beginnt die trockenen Kraeuter zu kauen.", ({TP})
);
  return 1;
}

