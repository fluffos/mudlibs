inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include "../def.h"

clone();		//hier clont er seine Baby-Drachen


create()
      {
      if (!is_clone(TO)) return;
       ::create();
        AddId ( ({"walddrachenbaby","drachenbaby","baby"}) );
        SetProp (P_GENDER, MALE);
        SetProp (P_RACE, "Drachenbaby");
   SetProp (P_NAME, "Drache");
        SetProp (P_SHORT, "Ein Drachenbaby"); 
        SetProp (P_ARTICLE, 1);
        
        SetProp (P_LONG,BS("Du siehst ein junges, stuermisches Walddrachenbaby, das "
        	+"von seiner Mutter gerufen wurde. Auch wenn seine Fluegel und sein "
        	+"Schwanz nicht so maechtig wie die seiner Mutter sind, kann er doch "
        	+"auch sehr gefaerhlich werden.\n"));

   AddDetail( "fluegel", BS("Er besitzt, wie seine Mutter, vier Fluegel, welche "
   	+"der Jungdrache jedoch noch sehr ungeschickt einsetzt.\n") );
   	
   

	SetProp (P_ALIGN, -200);
	SetProp (P_LEVEL, 16);
	SetProp (P_RACE, "Vogel");
	SetProp (P_MAX_HP, 700);
	SetProp (P_MAX_SP, 700);
	SetProp (P_XP,700000);
	SetProp (P_BODY, 300);
	SetProp (P_MAX_HANDS, 4);
	SetProp (P_SIZE, 700);
	SetProp (P_HANDS, ({" mit seinen scharfen Krallen", 320, DT_RIP}) );

/*    SetProp(P_RESISTANCE_STRENGTHS, 
    ([DT_MAGIC:-0.5,
       DT_ACID:-0.5,
       DT_POISON:-0.6,
       DT_COLD:1.4,
       DT_TERROR:-0.2,
       DT_FIRE: -0.6
       ]) );
  */     
	SetAttackChats(30, ({
	"Der Drache baeumt sich zu unheimlicher Groesse auf.\n",
	"Dem Drachen stroemen dichte Daempfe aus den Nuestern.\n",
	"Der Drache schreit aus tiefer Kehle.\n",
	"Der Drache zeigt Dir seine scharfen Zaehne.\n",
	}) );
	                                                                         	                      
}

