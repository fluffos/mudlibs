/*
** Eine Biene
**
**  2002-04-22  PROtheG  Neuueberarbeitung
*/

#include "../def.h"

inherit "std/mnpc";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Eine Biene");
  SetProp(P_LONG, 
	  BS("Die Biene schwirrt mit surrenden Fluegeln in der Wiese umher, "
	     "wandert von Bluete zu Bluete und sammelt Bluetenstaub."));

  AddDetail("fluegel",
	    "Sie sind durch den schnellen Fluegelschlag kaum zu sehen.");

  SetProp(P_NAME, "Biene");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_RACE, "Biene");

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));

  AddId(({"biene"}));

  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 4);
  SetProp(P_WEIGHT, 10+random(5));
  
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_HEAL, 20);

  create_default_npc(1);
  
  SetProp(P_HANDS, ({" mit ihrem Stachel", 30, DT_POISON}));

  SetProp(P_ALIGN, 50);

  SetProp(P_MSGOUT, "brummt weiter");
  SetProp(P_MSGIN, "brummt herein");

  SetProp(P_MMSGIN, "brummt munter herein");
  SetProp(P_MMSGOUT, "brummt munter weiter");

  AddInfo(DEFAULT_INFO, "summt herum\n");

  SUID;

  //********************
  //Props zum moving NPC
  //********************
  SetProp(P_MNPC_AREA, ROOM "0");
  SetProp(P_MNPC_DEFAULTROOM, ROOM "0402");
  SetProp(P_MNPC_WAIT, ({1,30,30}));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS+MOV_BACKWARDS+MOV_MOVES);
  
  CLONEME(WEAPON "bstachel");
  
  command_me("zuecke stachel");
}
