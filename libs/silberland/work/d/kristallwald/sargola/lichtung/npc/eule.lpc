#include "../def.h"

inherit "std/npc";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Eine Waldeule");
  SetProp(P_LONG, 
	  BS("Eine grau-schwarze Eule mit sehr weichem, grau-schwarzem "
	     "Gefieder. Sie hat grosse, dunkle Augen, die Dich anstarren."));

  SetProp(P_NAME, "Eule");
  SetProp(P_GENDER, FEMALE);
  AddId(({"vogel","eule", "waldeule" }) );

  create_default_npc(10);

  SetProp(P_HANDS, 
	  ({" mit ihrem starken Schnabel", QueryProp(P_HANDS)[1], DT_PIERCE}));
  
  SetProp(P_SIZE, 34);
  SetProp(P_WEIGHT, 3592);
  SetProp(P_WIMPY, 10);
  SetProp(P_RACE, "Vogel");
  
  AddDetail("augen",
  	"Sie sind gross, dunkel und wirken irgendwie bedrohlich. Damit "
  	+"ist es der Eule moeglich, auch im Dunkeln sehr gut zu sehen.");
  AddDetail("gefieder",
  	"Das Gefieder ist von grau-schwarzer Faerbung und besonders "
  	+"weich, damit die Opfer ihren Flug nicht hoeren koennen.");
  	
  AddDetail("opfer",
  	"Pass nur auf, dass Du keines wirst....der Eule entgeht keine "
  	+"Deiner Bewegungen.");
  	
  AddDetail("bewegungen",
  	"Verhalte Dich lieber unauffaellig.");
  	
  AddDetail("flug",
  	"Noch sitzt sie ruhig auf einem Ast.");
  
  AddDetail(({"faerbung","maserung"}),
  	"Es ist eine graue bis schwarze Maserung.");
  
  SetProp(P_MSGOUT, "fliegt weiter");
  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MMSGIN, "fliegt herein");
  SetProp(P_MMSGOUT, "fliegt weiter");
  SetProp(P_DIE_MSG, " faellt tot zu Boden.\n");
  
  SetProp(P_REJECT, 
	  ({REJECT_DROP, "Wie soll denn eine Eule das tragen koennen?\n"}));
  
  SetChats(5, ({
    "Die Eule dreht ihren Kopf um 360 Grad.\n",
      "Die Eule blickt Dich aus ihren dunklen Augen an.\n",
      "Die Eule beobachtet alles in ihrer Umgebung.\n",
      "Die Eule fliegt zu einem anderen Ast.\n"}));
}
