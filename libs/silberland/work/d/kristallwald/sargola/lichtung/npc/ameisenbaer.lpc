/*
** Eine kleine aggressive Termite
**
**  2002-05-07  PROtheG  Neuueberarbeitung
*/

#include "../def.h"

inherit "std/npc";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Ein Ameisenbaer");
  SetProp(P_LONG, 
	  BS("Du siehst einen alten Ameisenbaer. Sein Fell besteht aus "
	     "glatten, steifen Haaren. Sie sind 5 cm lang und dach"
	     "schindelartig. Er scheint nicht mehr so jung und vital zu sein "
	     "und hat Probleme, sich Nahrung zu suchen."));

  AddDetail("fell",
	    "Es glaenzt glatt, ist aber an manchen Stellen auch schon sehr "
	    "stumpf.");

  AddDetail("haare",
	    "Die Haare sind ziemlich steif und bieten durch ihre schindel"
	    "artige Form guten Schutz vor Angreifern.");
  
  AddDetail(({"stelle","stellen"}),
	    "Hier ist sein Fell schon abgenutzt und oft beansprucht worden.");
  
  AddDetail("form",
	    "Seine Haare sind schindelartig angeordnet.");
  
  AddDetail("schutz",
	    "Sein Fell bietet davon genug."); 

  SetProp(P_NAME, "Ameisenbaer");
  SetProp(P_GENDER, MALE);
  AddId(({"baer","ameisenbaer"}));
  create_default_npc(10);
  SetProp(P_BODY, 25);
  SetProp(P_SIZE, 90);
  SetProp(P_WEIGHT, 91240);
  SetProp(P_RACE, "Ameisenbaer");

  SetProp(P_HANDS, ({" mit seinem Ruessel", 60, DT_SLASH}));

  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 5);

  SetProp(P_MSGOUT, "schlurft weiter");
  SetProp(P_MSGIN, "schlurft herein");
  SetProp(P_MMSGIN, "schlurft herein");
  SetProp(P_MMSGOUT, "schlurft weiter");

  SetProp(P_ALIGN, 100);

  SetChats(5, ({
    "Der Ameisenbaer versucht verzweifelt, eine Termite zu entdecken.\n",
      "Der Ameisenbaer schnofelt mit seinem Ruessel in dem Huegel.\n",
      "Der Ameisenbaer blickt sich traurig um.\n",
      "Der Ameisenbaer haette so gern wieder Termiten.\n",
      "Der Ameisenbaer bettelt Dich um eine Termite an.\n",
      "Der Ameisenbaer schleicht gruebelnd um den Huegel.\n"}));
}

void init()
{
  object ob;
	
  ::init();

  if(ob=present("termite", MENV))
    call_out("fressen", 1, ob);
  
  if(ob=present("ameise", MENV))
    call_out("fressen", 1, ob);
}

void fressen(object ob)
{
  if((!objectp(ob)) || (!present(ob, MENV))) return;

  tell_room(MENV, 
	    BS("Der Ameisenbaer freut sich unheimlich, wieder etwas "
	       "zu Essen gefunden zu haben."));

  call_out("fressen2",2,ob);
}

void fressen2(object ob)
{
  if((!objectp(ob)) || (!present(ob, MENV))) return;

  tell_room(MENV,
	    BS("Mit einem grossen, lauten Schlurp saugt er "+
	       ob->name(WEN)+" ein."));
  
  ob->remove(1);
}

void give_notify(object ob)
{
  if(ob->id("termit"))
    {
      write(BS("Der Ameisenbaer sagt: Danke fuer die herrlichen, kleinen "
	       "Termiten."));
      ob->remove(1);
    }
  else
    {
      write(BS("Der Ameisenbaer weiss offensichtlich nicht, was er damit tun "
	       "soll."));
      
      give_obj(ob,TP);		
    }
}
