/*
*********************************************
** Anfaengermonster
** bei hohem seher, hummelschwarm
**
*********************************************
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>
#include <combat.h>
#include "../def.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Hummel");
  SetProp (P_LONG, BS("Die Hummel brummt laut beim Fliegen. Sie ist fuer "
  	+"eine Hummel recht gross."));
  SetProp (P_NAME, "Hummel");
  SetProp (P_GENDER, FEMALE);
  AddId ( ({"hummel" }) );
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 10);
  create_default_npc (3);
 
  SetProp (P_HANDS, ({" mit ihrem Stachel", 30,DT_POISON}));
  SetProp (P_ALIGN, 50);


  SetProp (P_MSGOUT, "brummt weiter");
  SetProp (P_MSGIN, "brummt herein");
  SetProp(P_MMSGIN, "brummt munter herein");
  SetProp(P_MMSGOUT, "brummt munter weiter");



  //********************
  //Props zum moving NPC
  //********************
  SetProp(P_MNPC_AREA, ROOM+"0");
  SetProp (P_MNPC_DEFAULTROOM, ROOM+"0404");
  SetProp (P_MNPC_WAIT, ({20,30,30}));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS+MOV_MOVES);



}



