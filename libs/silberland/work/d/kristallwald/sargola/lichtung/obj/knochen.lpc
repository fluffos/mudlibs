inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

string owner;

      create()      
{        if (!is_clone(this_object()))           return;
        ::create();
   
        AddId ( ({"\nxalgurknochen","knochen"}) );
        SetProp(P_SHORT, "Xalgurs Knochen");
        SetProp(P_LONG, BS("Dies sind die halb verwesten Knochen von Xalgur.\n"));
        SetProp(P_NAME, "Xalgurs Knochen");
        SetProp(P_ARTICLE, 0);
        SetProp (P_GENDER, MALE); 
        SetProp (P_WEIGHT, 300);
        SetProp (P_VALUE, 0);
        SetProp (P_NOBUY, 1);
        SetProp(P_NOSELL, 1);
	    SetProp(P_MATERIAL, MAT_BONE);
} 
 
set_owner(arg)
{
   if (owner ==0)
   {      
      return owner = arg;
   }
}

query_owner()
{
   return owner;
} 