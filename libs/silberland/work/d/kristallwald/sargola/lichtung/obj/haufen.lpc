#include "../def.h"

inherit "std/thing";

#pragma strong_types

nosave int termitenanzahl;

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  termitenanzahl = 3;

  SetProp(P_SHORT, "Ein Termitenhaufen");
  SetProp(P_LONG, 
	  BS("Vor Dir auf dem Boden befindet sich ein gut ein Meter hoher "
	     "Termitenhaufen. Du hoerst leises Geraeusch aus dem Haufen."));
  SetProp(P_NAME, "Termitenhaufen");
  SetProp(P_GENDER, MALE);
  AddId(({"termitenhaufen","haufen"}));
  SetProp(P_MATERIAL, ({MAT_EARTH}));
  SetProp(P_WEIGHT, 10000000);
  SetProp(P_NOGET, "Du kannst den Termitenhaufen nicht nehmen.\n");

  AddCmd(({"stachel","stocher","stochere"}),"stocher");
  AddCmd(({"wuehl","wuehle","greif","greife"}),"greif");
}

void reset()
{
  ::reset();
	
  termitenanzahl = 3;
}

nosave int greif(string str)
{
  notify_fail(BS("Wo willst Du denn reingreifen?"));
  if(!str) return 0;
	
  if(str=="in huegel"||str=="in haufen")
    {
      write(BS("Du greifst mit der blossen Hand in den Haufen "
	       "und ziehst sie schnell wieder raus! AUTSCH!"));

      tell_room(MENV, 
		BS(TPN+" greift mit der blossen Hand in den Haufen und "
		   "zieht sie mit schmerzverzerrtem Gesicht wieder heraus."),
		({TP}));

      TP->AddHp(-10);

      return 1;
    }
  
  return 0;
}

nosave int stocher(string str)
{
  notify_fail(BS("Worin willst Du denn stochern?"));
  if(!str) return 0;
  
  if(str=="in huegel"||str=="in huegel herum"||str=="mit stock in huegel"
     ||str=="mit stock in huegel"||str=="in haufen"||str=="in haufen herum"
     ||str=="mit stock in haufen"||str=="mit stock in haufen")
      if(present("stock",TP))
	if(termitenanzahl)
	  {
	    write(BS("Du stocherst mit dem Stock in dem Haufen "
		     "herum und stoeberst tatsaechlich eine Termite auf."));

	    tell_room(MENV, 
		      BS(TPN+" stochert in dem Haufen und "
			 "stoebert eine Termite auf."));

	    CLONE(NPC "termite", MENV);
	    
	    termitenanzahl--;

	    return 1;
	  }
	else
	  {
	    write(BS("Du wuehlst, aber die Termiten scheinen sich "
		     "schon alle tief unten versteckt zu haben."));
	    tell_room(MENV, 
		      BS(TPN+" stochert in dem Termitenhaufen, "
			 "aber es kommt keine Termite zum Vorschein."),
		      ({TP}));
	    return 1;
	  }
      else
	return write(BS("Du hast keinen Stock dabei, um damit zu wuehlen.")), 
	  1;
  
  return 0;
}
