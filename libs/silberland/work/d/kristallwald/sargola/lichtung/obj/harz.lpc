inherit "std/thing";
#include <properties.h>
#include "../def.h"


void create()
{
   if (!is_clone(this_object())) return;
   ::create();

  SetProp(P_SHORT, "Ein Klumpen Harz");
   SetProp(P_LONG,
	"Ein bernsteinfarbener Klumpen von frischem Baumharz.\n");
   SetProp(P_GENDER, MALE);
   AddDetail("klumpen",
	"Der Klumpen ist in etwa faustgross.");
   SetProp(P_ARTICLE, 1);
   SetProp(P_NAME, "Klumpen Harz");
   AddId(({ "klumpen","harz", "klumpen harz"}));
   SetProp(P_VALUE, 100);
   SetProp(P_WEIGHT, 70);     
   SetProp(P_MATERIAL, MAT_HAIR);
   
}
