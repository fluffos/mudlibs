inherit "std/thing";

#include <properties.h>
#include "../def.h"



void create()
{
   if (!is_clone(this_object())) return;
   ::create();

   SetProp(P_SHORT, "Ein Wiesenblumenstrauss");
   SetProp(P_LONG,
      "Ein huebscher Strauss aus Wiesenblumen, der mit einem langen "
	+"Grashalm zusammengebunden wurde. Kornblumen, Mohnblumen und "
	+"Gaensebluemchen wurden in den huebschen Strauss verarbeitet. "
	+"Man sieht dem Strauss an, dass er mit viel Liebe gemacht wurde.\n");
	
	
   AddDetail("wiesenblumen",
   	"Du erkennst Gaensebluemchen, Mohnblumen und Kornblumen.");
   AddDetail("gaensebluemchen",
   	"Es ist klein, scheint aber wegen seiner strahlend weissen Farbe "
   	+"im Strauss hervor.");
   AddDetail("farbe",
   	"Du kannst blaue, weisse und rote Blumen erkennen.");
   	
   AddDetail( ({"kornblume","kornblumen"}),
   	"Die herrliche Musterung der Kornblume macht den Strauss interessant.");
   	
   AddDetail("musterung",
   	"Die Musterung im Zentrum der Kornblume.");
   	
   AddDetail ( ({"mohnblume","mohnblumen"}),
   	"Rote Mohnblumen verleihen dem Strauss irgendwie einen laendlichen "
   	+"Charm.");
   	
   AddDetail("charm",
   	"Den muss man nicht extra untersuchen.");
   SetProp(P_GENDER, MALE);
   SetProp(P_NAME, "Wiesenblumenstrauss");
   AddId(({ "blumenstrauss","strauss","wiesenblumenstrauss"}));
   SetProp(P_WEIGHT, 40);
   SetProp(P_VALUE, 40);
   SetProp(P_MATERIAL, MAT_PLANT);
}