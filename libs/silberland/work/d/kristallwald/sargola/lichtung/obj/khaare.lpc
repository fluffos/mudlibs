inherit "std/thing";
#include <properties.h>
#include "../def.h"

int plopp;
int set_plopp(int p);


void create()
{
   if (!is_clone(this_object())) return;
   ::create();

   plopp = 0;
   SetProp(P_SHORT, 0);
   AddId(({ "\nhaare"}));
   SetProp(P_NODROP,1);
}



string extra_look()
{
   if(plopp == 0)
   {
	if(TP->QueryProp(P_GENDER) == 2)
		return BS("Ihr fehlt ein grosses Bueschel Haare am Kopf.");
	return BS("Ihm fehlt ein grosses Bueschel Haare am Kopf.");
   }
   else
   {
	if(TP->QueryProp(P_GENDER) == FEMALE)
		return BS("Ihr klebt ein grosser Klumpen Harz auf dem Kopf.");
	return BS("Ihm klebt ein grosser Klumpen Harz auf dem Kopf.");
   }
}

int set_plopp(int p)
{
	plopp = plopp;
}
