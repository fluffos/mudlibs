#include "../def.h"
#include <food.h>

inherit "std/food";

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Walderdbeere");
  SetProp(P_LONG,
	  BS("Eine praechtige, wunderbar rote Walderdbeere."));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Walderdbeere");
  AddId(({"walderdbeere", "erdbeere","beere"}));
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 5);
  SetProp(P_MATERIAL,({MAT_PLANT}));
  SetProp(P_FOOD_INFO, ([
     F_HEAL: ({12, 0}), F_SOAK: 2,
     F_MSG: "Du verspeist genuesslich die Erdbeere.\n",
     F_MSG_ROOM: "verspeist genuesslich eine Erdbeere.\n"]));
}
