#include "../def.h"
#include <food.h>

inherit "std/food";

void create()
{
   if(!is_clone(ME)) return;
   ::create();
   
   SetProp(P_SHORT, "Ein langer Grashalm");
   SetProp(P_LONG,
	   BS("Ein langer, kraeftiger Grashalm."));
   SetProp(P_INFO,
	   BS("So kraeftige Grashalme werden oft verwendet, um "
	      "Blumenstraeusse zusammenzubinden."));
   SetProp(P_GENDER, MALE);
   SetProp(P_NAME, "Grashalm");
   AddId(({"grashalm","halm"}));

   SetProp(P_WEIGHT, 10);
   SetProp(P_VALUE, 5);
   SetProp(P_NOBUY, 1);

   SetProp(P_FOOD_INFO, ([F_HEAL : ({1, 0}), F_SOAK : 1]));
   SetProp(P_MATERIAL, MAT_PLANT);
   AddCmd(({"binde","bind"}), "binde");
}

void BeimEssen()
{
   tell_object(TP, "Der Grashalm ist nicht besonders geschmackvoll.\n");
   tell_room(MENV, TPN+" verspeist widerwillig einen Grashalm.", ({TP}));
}

nosave int binde(string str)
{
  object g, m, k;
  
   notify_fail("Was moechtest Du denn binden?");
   if(!str) return 0;

   if(str=="strauss"||str=="blumenstrauss")
     if(objectp(g=present("gaensebluemchen", TP)) &&
	objectp(m=present("mohnblume",TP))        &&
	objectp(k=present("kornblume",TP)))
       {
	 write(BS("Du nimmst Deine Blumen und bindest "
		  "sie mit dem Halm zu einem huebschen Strauss zusammen."));
	 
	 k->remove();
	 g->remove();
	 m->remove();
	 CLONE(OBJ "strauss", TP);
	 
	 RemoveCmd(({"binde","bind"}));
	 call_out("remove", 0);
	 return 1;
       }
     else
       return write(BS("Du hast noch zuwenig Blumen, um einen "
		       "ordentlichen Strauss daraus zu machen.")), 1;

   return 0;
}
