#include "../def.h"

inherit "std/thing";

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, 0);
  SetProp(P_WEIGHT, 0);
  SetProp(P_NAME, "");
  AddId(({"\nscript_nuts","QUESTOBJ"}));
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  AddCmd("", "nix", 1);

  call_out("remove", 600);
}

nosave int nix(string str)
{
  write(BS("Du spuerst seltsame Kraefte um Dich herum..."));
  return 1;
}

void reset()
{
  if(!is_clone(ME)) return;
  ::reset();
  
  call_out("remove", 1);
}
