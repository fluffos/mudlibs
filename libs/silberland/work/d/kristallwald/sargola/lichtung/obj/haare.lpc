inherit "std/thing";
#include <properties.h>
#include "../def.h"

string name;

set_name(string str);
string query_name(string str);

int pflanz(string str);
int plopp;

void create()
{
   if (!is_clone(this_object())) return;

   ::create();
    plopp = 0;
   SetProp(P_SHORT, "Ein Bueschel Haare");
   SetProp(P_LONG,
	"Ein dichtes Bueschel Haare von ...");
   SetProp(P_GENDER, NEUTER);
   AddDetail("harz",
	"Der Besitzer dieser Haare scheint wohl am Harz haengengeblieben "
	+"zu sein.");
   SetProp(P_ARTICLE, 1);
   SetProp(P_NAME, "Bueschel Kraeuter");
   AddId(({ "haare","bueschel","haar", "bueschel haare"}));
   SetProp(P_VALUE, 10);
   SetProp(P_WEIGHT, 20);     
   SetProp(P_NODROP,1);
   SetProp(P_MATERIAL, MAT_HAIR);
   AddCmd( ({"pflanze","pflanz"}), "pflanz");

}



int pflanz(string str)

{

	notify_fail("Was moechtst Du denn wohin einpflanzen?\n");

	if(!str) return 0;



	if(str=="haare auf kopf ein")

	{

	   if(!plopp)

	   {

		tell_object(TP, "Du nimmst den Klumpen Harz in dem Deine "

		+"Haare kleben und drueckst ihn auf die kahle Stelle auf "

		+"Deinem Kopf. Nun hast Du den Klumpen sehr dekorativ "

		+"am Kopf kleben...Ob das eine gute Idee war....");

		plopp = 1;

		(present("\nhaare", TP))->set_plopp(1);

		return 1;

	   }

	   else

	   {

		tell_object(TP, "Der Klumpen klebt Dir ja schon dekorativ "

		+"am Kopf.");

		return 1;

	   }

	}

	return 0;

}



set_name(string str)

{

	name = str;

   SetProp(P_SHORT, name+"`s"+" Haare" );

   SetProp(P_LONG,

	"Ein dichtes mit Harz verklebtes Bueschel Haare von ..."+name+".\n");

   SetProp(P_GENDER, NEUTER);

   SetProp(P_NAME, name+"ïs"+" Haare" );





}



string query_name(string str)

{

	if(str)

		return name;

	return "";

}







