#include "../def.h"
#include <food.h>

inherit "std/food";

void create()
{
   if (!is_clone(this_object())) return;
   ::create();

   SetProp(P_SHORT, "Ein Bueschel Kraeuter");
   SetProp(P_LONG,
	   BS("Ein Bueschel Kraeuter, welches Du nicht genauer bestimmen "
	      "kannst."));
   SetProp(P_GENDER, NEUTER);

   SetProp(P_NAME, "Bueschel Kraeuter");
   AddId(({"kraeuter","bueschel","kraut", "\ngnomkraeuter"}));
   
   SetProp(P_INFO,
	   BS("Du glaubst, dass es sich bei diesen Kraeutern um Gnomkraeuter "
	      "handelt. Gnomkraeuter sind ziemlich herbe Kraeuter."));
   
   SetProp(P_WEIGHT, 100);
   SetProp(P_VALUE, 100);
   SetProp(P_NOBUY, 1);
   SetProp(P_MATERIAL, MAT_PLANT);  

   SetProp(P_FOOD_INFO, ([
	  F_HEAL: ({2, 25}), F_SOAK: 4,
	  F_MSG: BS("Du verspeist die trockenen Kraeuter."),
	  F_MSG_ROOM: "beginnt die trockenen Kraeuter zu kauen.\n"]));
}
