#include "../def.h"
#include <food.h>

inherit "std/food";

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Kornblume");
  SetProp(P_LONG,
	  BS("Eine blaue Kornblume, wie Du sie auf Lichtungen finden "
	     "kannst."));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Kornblume");
  AddId(({ "blume","kornblume"}));
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 12);
  SetProp(P_FOOD_INFO, ([F_HEAL : ({-5, 0}), F_SOAK : 1, F_POISON: 0]));
  SetProp(P_MATERIAL, ({MAT_MISC_PLANT}));
}

void BeimEssen()
{
  tell_object(TP, BS("Die Kornblume schmeckt ziemlich bitter."));
  tell_room(MENV, BS(TPN+" verspeist mit verzerrtem Gesicht eine Kornblume."),
	    ({TP}));
}

