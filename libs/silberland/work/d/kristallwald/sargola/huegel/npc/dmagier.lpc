inherit "std/inpc";  
#include <properties.h>  
#include <language.h>  
#include <combat.h>  
#include <new_skills.h>  
#include <moving.h>

#include "../def.h"  


create()  
{  
     if (!is_clone(TO)) return;  
     ::create();   
     SetProp(P_SHORT, "Ein Dunkelmagier");  
     SetProp(P_LONG, BS("Du siehst einen in eine schwarze Kutte gehuellte "
	+"Gestalt, welche eine Kutte ueber den Kopf gezogen hat. Darunter "
	+"funkeln Dich boese Augen an. Beide Haende sind in der Kutte "
	+"vergraben und Du kannst nicht erkennen, ob er eine Waffe bei "
	+"sich traegt."));  

     AddDetail("gestalt",
	"Sie entspricht einem durchschnittlichen gebauten Menschen.");
     AddDetail("kopf",
	"Der Kopf wird von der Kutte verhuellt.");
     AddDetail("augen",
	"Du siehst sie nur boese funkeln...");
     AddDetail("waffe",
	"Unter der weiten Kutte koennten allerhand Waffen stecken.\n");

     SetProp(P_GENDER, MALE);  
     SetProp(P_NAME, "Dunkelmagier");  
     SetProp(P_ARTICLE, 1);  
     AddId (({"magier","dunkelmagier"}));  
     SetProp(P_DIE_MSG, " zerfaellt und nur die Kutte bleibt.\n");  
     SetProp(P_NOCORPSE, 1);
     create_default_npc (35);  
     SetProp(P_HANDS, ({" mit dunkler Magie", 270, DT_TERROR}));  
     SetProp(P_AGGRESSIVE, 0);
   
     SetProp(P_RACE, "Mensch");  
     SetProp(P_ALIGN, -800);  
     SetProp(P_SIZE, 173);
     SetProp(P_BODY, 130);
     
     
     SetProp(P_RESISTANCE_STRENGTHS, 
     	([DT_MAGIC:-0.5,
     	  DT_ACID:-0.5,
     	  DT_POISON:-0.5,
     	  DT_COLD:-0.5,
     	  DT_TERROR:-0.5,
     	  DT_FIRE: -0.5,
	  DT_WATER: -0.5
     	]) );


	SUID;
	clone_object(ARMOUR+"kutte")->move(TO);
	//clone_object(ARMOUR+"iring")->move(TO);
	command_me("ziehe alles an");
     
     SetProp(P_NOMAGIC, 65);
     SetProp(P_SPELLRATE, 70); 

     SetAttackChats( ({
	"Der Dunkelmagier funkelt Dich boese an!\n",
	"Der Dunkelmagier murmelt etwas Unverstaendliches.\n",
	"Der Dunkelmagier fuchtelt mit den Haender.\n",
	"Der Dunkelmagier klaut Dir 200.000 Erfahrungspunkte!\n",
	"Ein Dunkelmagier kommt an.\n",
	"Der Dunkelmagier lacht ueber Dich!\n" }),50 );   

     AddSpell(2,600,
	"Der Dunkelmagier huellt Dich in schwaerzeste Nacht!\n",
	"Der Dunkelmagier huellt @WEN in schwaerzeste Nacht!\n",
	DT_MAGIC, ([SP_SHOW_DAMAGE:1]) );

     AddSpell(4,1,
	"Der Dunkelmagier haucht eine schwarze Wolke in den Raum.\n",
	"Der Dunkelmagier haucht eine schwarze Wolke in den Raum.\n",
	DT_AIR, "wolke" );

     AddSpell(3,1,
	"Der Dunkelmagier funkelt Dich aus kalten Augen an.\n",
	"Der Dunkelmagier funkelt @WEN aus kalten Augen an.\n",
	DT_TERROR, "auge");

     AddSpell(3,1,
	"Der Dunkelmagier schuechtert Dich komplett ein!\n",
	"Der Dunkelmagier schuechtert @WEN komplett ein!\n",
	DT_TERROR, "furcht");

     AddSpell(2,1,
	"Der Dunkelmagier formt eine Huelle aus gleissender Magie.\n",
	"Der Dunkelmagier formt eine Huelle aus gleissender Magie.\n",
	DT_MAGIC, "schutz");


     AddSpell(2,1,
	"Der Dunkelmagier verwandelt seine Kutte in Eisen.\n",
	"Der Dunkelmagier verwandelt seine Kutte in Eisen.\n",
	DT_MAGIC, "eisenhaut");

     AddSpell(3,1,
	"Der Dunkelmagier spricht aus Versehen einen Heilzauber!\n",
	"Der Dunkelmagier spricht aus Versehen einen Heilzauber!\n",
	DT_MAGIC, "heilung");


     AddSpell(8,1,
	"Der Dunkelmagier verwirrt Dich.\n",
	"Der Dunkelmagier verwirrt @WEN.\n",
	DT_MAGIC, "verwirrung");
}

_query_wimpy()
{
	return 0;
}


verwirrung(object enemy, int damage, mixed dam_type)
{
	object *enemies;
	object b;
	enemies = PresentEnemies();

	// Wenn sonst keiner da ist: 20 Schaden
	if(sizeof(enemies)==0)
	{
	   tell_object(enemy, "In Deiner Verwirrung schlaegst Du Dir selbst eines ueber die Ruebe!\n");
	   enemy->reduce_hit_point(20+random(20));
	   return ;
	}

	// Wenn wer da ist, verfolgt man den ... ;)
	b = enemies[random(sizeof(enemies))];
	tell_object(b, "In Deiner Verwirrung schlaegst Du Dir selbst eines ueber die Ruebe!\n");
	tell_room(environment(b), "In grosser Verwirrung schlaegt sich "+b->QueryProp(P_NAME)+" selbst eins ueber die Ruebe!\n", ({b}) );
	b->reduce_hit_point(20+random(20));
	return ;
}


heilung(object enemy, int damage, mixed dam_type)
{
	object *enemies;
	object b;

	enemies = PresentEnemies();

	// Wenn sonst keiner da ist: 20 Schaden
	if(sizeof(enemies)==0)
	{
	   enemy->heal_self(40+random(40));
	   tell_object(enemy, "Der Dunkelmagier heilt Dich ungewollt.\n");
	   return ;
	}

	// Wenn wer da ist, verfolgt man den ... ;)
	b = enemies[random(sizeof(enemies))];
	b->heal_self(40+random(40));
	tell_object(b, "Der Dunkelmagier heilt Dich ungewollt.\n");
	tell_room(environment(b), "Der Dunkelmagier heilt "+b->QueryProp(P_NAME)+" ungewollt.\n", ({b}) );
	return ;
}


eisenhaut(object enemy, int damage, mixed dam_type)
{
	SetProp(P_BODY, 180);
	if(find_call_out("regain_body")==-1)
		call_out("regain_body", 20+random(30));
	else
	{
		remove_call_out("regain_body");
		call_out("regain_body", 20+random(30));
	}
}

regain_body()
{
	SetProp(P_BODY, 140);
}



schutz(object enemy, int damage, mixed dam_type)
{
	if(!enemy) return ;
	
     SetProp(P_RESISTANCE_STRENGTHS, 
     	([DT_MAGIC:-0.8,
     	  DT_ACID:-0.8,
     	  DT_POISON:-0.8,
     	  DT_COLD:-0.8,
     	  DT_TERROR:-0.8,
     	  DT_FIRE: -0.8,
	  DT_WATER: -0.8
     	]) );



	if(find_call_out("regain_spellrate")==-1)
		call_out("regain_spellrate", 40+random(20) );
	else
	{
		remove_call_out("regain_spellrate");
		call_out("regain_spellrate", 40+random(20));
	}
}


regain_spellrate()
{
	
     SetProp(P_RESISTANCE_STRENGTHS, 
     	([DT_MAGIC:-0.5,
     	  DT_ACID:-0.5,
     	  DT_POISON:-0.5,
     	  DT_COLD:-0.5,
     	  DT_TERROR:-0.5,
     	  DT_FIRE: -0.5,
	  DT_WATER: -0.5
     	]) );
}


wolke(object enemy, int damage, mixed dam_type)
{
	object *enemies;
	object buesser;
	string bname, ename;
	int i, red;
	
	red = 20 + random(20);
	enemies = PresentEnemies();
	tell_object(find_player("sargola"), sprintf("%O\n",enemies));
	
	if(sizeof(enemies)==0) return ;

	for(i=sizeof(enemies)-1; i>-1;i--)
	{
	   tell_object(find_player("sargola"), sprintf("%O\n",enemies[i]) );
	   tell_object(enemies[i], "Die Wolke entzieht Dir magische Kraft...\n");
	   enemies[i]->SetProp(P_SP, enemies[i]->QueryProp(P_SP)-red);
	}
	return ;
}


furcht(object enemy, int damage, mixed dam_type)
{

	object *enemies;
	object buesser;
	string bname, ename;
	if(!enemy) return;
	enemies = PresentEnemies();

	// Wenn sonst keiner da ist: 20 Schaden
	if(sizeof(enemies)==0) return 200;

	// Wenn wer da ist, verfolgt man den ... ;)
	do {
	buesser = enemies[random(sizeof(enemies))];
	} while (buesser == enemy);
	buesser->AddPursuer(enemy);
	ename = enemy->QueryProp(P_NAME);
	bname = buesser->QueryProp(P_NAME);
	tell_object(buesser, ename +" ist derartig "
		+"von dem Dunkelmagier eingeschuechtert, dass er nicht "
		+"mehr von Deiner Seite weicht!\n");
	tell_object(enemy, "Du weichst aus Furcht nicht mehr von der Seite von "
		+bname+".\n");
	tell_room(environment(TO), ename + " weicht vor lauter Angst nicht "
		+"mehr von der Seite von "+bname+".\n", ({buesser, enemy}) );

	if(find_call_out("regain_pursuer")==-1)
		call_out("regain_pursuer", 120, buesser, enemy);

	return 0;
}


regain_pursuer(object buesser, object enemy)
{
	if(!buesser || !enemy) return ;
	buesser->RemovePursuer(enemy);
}
	


auge(object enemy, int damage, mixed dam_type)
{
	if(!enemy) return;
	
	if(random(10)==1)
	{
	   enemy->SetProp(P_BLIND, 1);
	   return;
	}
	tell_object(enemy, "In der Dunkelheit siehst Du den maechtigen Schlag nicht kommen...\n");
	return 150;
}

