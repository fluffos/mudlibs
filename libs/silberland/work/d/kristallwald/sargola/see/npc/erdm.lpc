inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>     
#include <moving.h>
#include <new_skills.h>
#include "/d/kristallwald/sargola/def_kristall.h"
           create()      {
       if (!is_clone(TO)) return;
    ::create();             

   AddId ( ({"maennchen","erdmaennchen"}) );
        SetProp (P_GENDER, NEUTER);
        SetProp (P_RACE, "Erdmaennchen");
        
        SetProp (P_NAME, "Erdmaennchen");
        SetProp (P_SHORT, "Ein Erdmaennchen");
        
        SetProp (P_ARTICLE, 1);
        
        SetProp (P_LONG,BS("Selten hast Du so ein aufgebrachtes Erdmaennchen gesehen! Du "
      +"wuerdest gern mit ihm Frieden schliessen und das flauschige braune Fell "
      +"streicheln. Schon bereust Du Deinen Fehler mit der Fackel.\n"));
      //SetProp (P_SOUND, BS("Knabber, knabber...\n"));

        create_default_npc(8);
        SetProp (P_ALIGN, 200);
        SetProp (P_SIZE, 20 );
        SetProp (P_HEAL, 20);
        SetProp (P_MSGIN, "stuermt herein");
        SetProp (P_MSGOUT, "stuermt weiter");
        SetProp (P_WIMPY,20);
  
        SetProp (P_MAX_HANDS, 4);

   SetProp (P_HANDS, ({" mit seinen kleinen Krallen",20,DT_BLUDGEON}) );
        
        SUID;
        //clone_object("/d/ebene/obj/div/haselnuss.lpc")->move(TP);
        
   SetProp(P_SPELLRATE, 15);
        
        AddSpell(2,10,        
      "Das Erdmaennchen zwickt Dich in die Wade.\n",
           "Das Erdmaennchen zwickt @WEN in die Wade.\n",
      DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));
        
   SetAttackChats(3, ({
           "Das Erdmaennchen springt Dir auf das Knie.\n",
           "Das Erdmaennchen zueckt sein Mordorschwert und trennt Dir den Arm ab.\n",
           "Das Erdmaennchen zermermelt Deine rechte kleine Zehe.\n"     }) );
        
   SetProp (P_DIE_MSG,        " knabbert nie mehr.\n");
        SetProp (P_DEFAULT_INFO,        "Das Erdmaennchen sucht neue Aeste.\n");
        AddInfo ("sargola",        "Sargola ist mein Erschoepfer!");

   SetProp( P_REJECT, ({REJECT_DROP,  
      "Was soll den das kleine Tier damit machen?\n" }) );
   SetChats (2, ({
      "Das Erdmaennchen laeuft lustig durch die Gegend.\n",
      "Das Erdmaennchen knabbert hingebungsvoll an einem Ast.\n",
      "Das Erdmaennchen haelt nach seinen Freunden ausschau.\n",
      "Das Erdmaennchen verstaerkt den Huegel um sein loch.\n",
           }) );                
 }                                                                                                    
 

