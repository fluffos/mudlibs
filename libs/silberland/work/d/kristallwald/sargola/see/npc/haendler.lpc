/*
**  Ein fahrender Haendler
**
**  2002-05-08  PROtheG  Neuueberarbeitung
*/

#include "../def.h"

inherit "std/mnpc";

#define DORF "/d/kristallwald/sargola/dorf/room/"

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Ein elfischer Haendler");
  SetProp(P_LONG, 
	  BS("Das ist ein typischer fahrender Haendler, der "
	     "Waren in die Staedte liefert..."));
  SetProp(P_DIE_MSG, " liefert heute nicht mehr.\n");
  SetProp(P_NAME, "Haendler");
  SetProp(P_GENDER, MALE);

  AddId(({"haendler", "elf"}));
  create_default_npc(17);
   
  SetProp(P_BODY, 70);
  SetProp(P_HANDS, ({" mit blossen Haenden", QueryProp(P_HANDS)[1], 
		       DT_BLUDGEON}));
  SetProp(P_ALIGN, 400);
  SetProp(P_ARTICLE, 1);
  SetProp(P_RACE, "Elf");
  //SetProp(P_XP, 0);
  SetProp(P_SIZE, 178);
  SetProp(P_WEIGHT, 71293);
  SetProp(P_MSGOUT, "schiebt seinen Karren weiter");
  SetProp(P_MSGIN, "schiebt seinen Karren herein");
  SetProp(P_MMSGIN, "schiebt seinen Karren herein");
  SetProp(P_MMSGOUT, "schiebt seinen Karren weiter");

  SetProp(P_HEAL, 50);

  SetProp(P_NOMAGIC, 5);

  SetProp(P_REJECT, ({ REJECT_KEEP,
	 "Der Haendler bedankt sich fuer Dein Geschenk.\n"}));

  SetChats(10,({
    "Der Haendler setzt den Karren kurz ab.\n",
      "Der Haendler schnauft laut.\n",
      "Der Haendler zerrt an dem Karren.\n"}));

  AddInfo(DEFAULT_INFO, 
	  "Darueber kann ich Dir nichts sagen.", 
	  "sagt: ");

  AddInfo(({"felonia","zwergenstadt"}) ,
	  "Das ist die Stadt der Zwerge unter der Erde.",
	  "sagt: ");

  AddInfo("karren",
	  "Mit ihm transportiere ich die Waren hin und her.", 
	  "sagt: ");
  
  AddInfo(({"stadt", "staedte"}),
	  "Puh! Da kenn ich einige...", 
	  "sagt: ");

  AddInfo(({"zwerge"}),
	  "Mit Zwergen will ich nichts zu tun haben.", 
	  "sagt: ");

  AddInfo(({"wesen","elfen"}),
	  "Nette, zuvorkommende Wesen, die zurueckgezogen im Wald leben.", 
	  "sagt: ");

  AddInfo(({"geschaeftspartner","menschen"}),
	  "Die Menschen sind angenehmen Geschaeftspartner.", 
	  "sagt: ");

  AddInfo(({"hobbits"}),
	  "Hobbit kenne ich keinen persoenlich.", 
	  "sagt: ");

  AddInfo(({"hauptstadt","midas"}),
	  "Midas ist die Hauptstadt der Menschen. Dorthin liefere ich aber "
	  "nicht oft.",
	  "sagt: ");

  AddInfo(({"tijara"}),
	  "Tijara ist viel zu weit weg, als dass ich dort liefern wuerde.", 
	  "sagt: ");

  AddInfo(({"haendler","name"}),
	  "Ich bin nur ein einfacher Haendler.",
	  "sagt: ");

  AddInfo(({"kristall","kristallwald","wald", "gegend"}),
	  "Du bist hier im Kristallwald", 
	  "sagt: ");

  AddInfo(({"waren","waffen","ruestungen","ruestung","waffe"}),
	  "Ich liefere Waffen und Ruestungen von Eesthil in die Elfenstadt. "
	  "Hin und wieder fahre ich auch nach Midas. Nur in letzter Zeit ist "
	  "es etwas gefaehrlich geworden.",
	  "sagt: ");

  AddInfo(({"elessar","elfenstadt"}),
	  "Sie liegt im suedlichen Teil des Kristallwaldes. Wo genau, musst "
	  "Du schon selbst herausfinden.",
	  "sagt: ");

  AddInfo(({"zeit","gefaehrlich"}),
	  "Nun ja, es haeufen sich die Geruechte, dass Wegelagerer und "
	  "Raeuber die Gegend unsicher machen. Ich selbst bin vorige Woche "
	  "ueberfallen worden", 
	  "sagt: ");

  AddInfo(({"geruechte","geruecht"}),
	  "Man munkelt, sie halten sich oestlich des Elfendorfes versteckt.",
	  "sagt: ");

  AddInfo(({"schmied","eesthil"}),
	  "Seine Waren bringe ich regelmaessig ins Elfendorf. Nur seit dem "
	  "Eesthil kristallin ist, kann ich nicht mehr liefern. Salina, seine "
	  "Frau sucht verzweifelt nach Hilfe.",
	  "erzaehlt: ");

  AddInfo(({"woche"}),
	  "Ja, genau vorige Woche bin ich ueberfallen worden!", 
	  "sagt: ");

  AddInfo("ueberfall",
	  "In der Naehe der Kreuzung, oestlich des Elfendorfes bin ich letzte "
	  "Woche ueberfallen worden! Mein Karren voll frisch geschmiedeter "
	  "Waffen - alles weg!",
	  "sagt: ");

  AddInfo(({"dolch","messer"}) ,
	  "Meinst Du die von Eesthil?", 
	  "sagt: ");

  AddInfo(({"wegelagerer"}),
	  "Von denen bin ich ueberfallen worden!!! In der Naehe der Kreuzung "
	  "im Wald! Feig von hinten sind sie gekommen...alles haben sie "
	  "genommen. Aber dort irgendwo muss ihr Versteck sein...", 
	  "sagt: ");

  AddInfo(({"raeuber"}),
	  "Gesehen hab ich noch keine...", 
	  "sagt: ");

  AddInfo(({"kreuzung"}),
	  "Du kennst sie sicher.", 
	  "sagt: ");

  AddInfo(({"versteck"}),
	  "Wenn ich wuesste, wo es ist, haette ich es schon lange mit den "
	  "Waechtern ausgerottet!", 
	  "sagt: ");

  AddInfo(({"waechter","elfenwaechter"}),
	  "Die Elfenwaechter warten nur darauf, dieses Gesindel endlich ding"
	  "fest zu machen.", 
	  "sagt: ");

  AddInfo(({"frau","schmiedin","salina"}),
	  "Oh ja. Eine traurige Sache mit ihrem Mann. Sie ist meist im "
	  "noerdlichen Teil des Waldes und sucht nach Hilfe.", 
	  "erzaehlt: ");
  
  //Props zum moving NPC  
  SetProp(P_MNPC_AREA, ({
     DORF "1014", DORF "1113", DORF "1212", ROOM "1311", ROOM "1210",
     ROOM "1109", ROOM "1108", ROOM "1107", ROOM "1207" }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "1210");
  SetProp(P_MNPC_WAIT, ({10,30,30}));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS+MOV_MOVES);

  SUID;
  CLONEME("/d/kristallwald/sargola/dorf/armour/leggings");
  command("trage alles");
}
