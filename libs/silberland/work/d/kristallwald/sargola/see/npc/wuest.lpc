#include "../def.h"

inherit "std/npc";

int gefangen ();         //Oops! schon ist es passiert :)

string *lauf = ({"nordosten","nordosten","osten","osten","osten","suedosten",
	"suedosten","sueden","sueden","sueden","suedwesten","westen",
	"nordwesten","suedwesten","westen","westen"});

string *lauf_zurueck=({"suedwesten","suedwesten","westen","westen","westen",
	"nordwesten","nordwesten","norden","norden","norden","nordosten",
	"osten","suedosten","nordosten","osten","osten"});

nosave int gefangen;         //Nun ist er gefangen und hilflos
nosave int akt_move;
nosave int richtung; 		//0=runter, 1=rauf;

void create()
{
  
  if(!is_clone(TO)) return;
  ::create();
  
  gefangen = 0;
  akt_move = 0;		//wo ist er gerade im lauf-array?
  richtung = 0;
  
  enable_commands();
  
  set_heart_beat(1);
  
  SetProp(P_SHORT, "Ein Wuestling");
  SetProp(P_LONG, BS(
    "Von Wuestlingen hast Du immer nur in Sagen und Erzaehlungen gehoert. "
    "Endlich siehst Du einen lebenden. Wuestlinge sind friedliebende "
    "Geschoepfe die mit groesster Begeisterung durch die Gegend wetzen. "
    "Pass auf, dass er Dir nicht wieder davonlaeuft."));
  
  SetProp(P_NAME, "Wuestling");
  
  SetProp(P_GENDER, MALE);

  AddId(({"hobbit","wuestling", "NOCONTROL", "NOWIMPY"}));

  create_default_npc(6);
  SetProp(P_HANDS, ({" mit seinen kleinen Haenden", 60, DT_RIP}));
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 100);
  SetProp(P_WEIGHT, 50245);
  SetProp(P_ALIGN, 450);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_MSGIN, "wuselt herein");
  SetProp(P_MSGOUT, "wuselt weiter");
  SetProp(P_MMSGIN, "wuselt herein");
  SetProp(P_MMSGOUT, "wuselt weit weg");

  AddInfo(DEFAULT_INFO, "Der Wuestling schreit: Bin schon wieder weg...");

  AddInfo("sargola", 
	  "ruft: \"Der ist noch schneller als ich!\"");
  AddInfo(({"rennen","wuseln","wetzen","begeisterung"}), 
	  "ruft: \"Wuseln ist mein Leben!\"\n");

  SetProp(P_REJECT, ({ REJECT_KEEP, "Danke, tschuess...\n"}));

  SetChats(100, ({
    "Der Wuestling blickt sich rasch um.\n",
    "Der Wuestling wuselt hektisch durch die Gegend.\n",
    "Der Wuestling hat es wieder sehr eilig.\n",
    "Der Wuestling ist schon viel zu lange hier.\n",
    "Der Wuestling murmelt: \"...muss schnell weg...\"\n",
    "Der Wuestling sagt: \"Ich bin der Schnellste!\"\n",
    "Der Wuestling ist komplett ausser Atem.\n",
    "Der Wuestling ruft: \"Fang mich doch!\"\n",
    "Der Wuestling zappelt ungeduldig mit den Fuessen umher.\n",
    "Der Wuestling fragt Dich: \"Spielen wir fangen?\"\n",
    "Der Wuestling ruft: \"Hasch mich!\"\n",
    "Den Wuestling wirst Du wohl nie erwischen...\n" }) );
    
    SetAttackChats(40, ({
   "Der Wuestling rennt um Dich herum.\n",
   "Der Wuestling wetzt so schnell durch die Gegend - Du siehst ihn gar nicht.\n",
   "Der Wuestling weicht Deinem Schlag blitzschnell aus.\n"
    })  );
    
    SUID;
}

void reset()
{
  ::reset();
  
  if (!is_clone(TO)) return;  // Blueprint verursacht ansonsten Bugs (Feyaria)

  akt_move=0;
  gefangen = 0;
  richtung=0;

  move(ROOM "0507", M_GO);
}

//*******************************************
//Nur unverwundbar, wenn er frei ist :)
//man wird ziemlich boese, wenn man mit ihm kaempft :)
//*******************************************
int Defend(int dam, string dam_type, int spell, object enemy)
{
  if(!gefangen)
    {
      tell_object(enemy, 
		  BS("Der Wuestling ist so schnell weg, Du kommst "
		     "gar nicht zum kaempfen."));

      SetProp(P_HP, TO->QueryProp(P_MAX_HP));

      StopHuntFor(enemy, 1);

      enemy->StopHuntFor(TO, 1);

      return 0;
    }

  return ::Defend(dam,dam_type,spell,enemy);
}

void heart_beat()
{  
  ::heart_beat();
	
  if(present("falle", MENV))
    {
      gefangen = 1;
      gefangen();
    }
	
  if(!richtung)	//runter
    {
      command_me(lauf[akt_move]);
      
      if(akt_move<15)
	akt_move+=1;
      else
	richtung=1;
      
    }
  else			//wieder rauf
    {
      command_me(lauf_zurueck[akt_move]);
      
      if(akt_move>0)
	akt_move-=1;
      else
	richtung =0;
		
    }
  //call_out("run",1);
}
  
int gefangen()
{
   object ob;
   
   
   tell_room(MENV,
	     BS("Als der Wuestling wieder weiterlaufen will, bricht er durch "
		"die Decke aus Aesten und Blaettern ein!"));
   
   move(ROOM "loch.lpc", M_GO, "nach unten","faellt", 
	"kommt von oben reingefallen");   

   SetProp(P_SHORT, "Ein gefangener Wuestling");

   SetChats(30, ({
       "Der Wuestling rast in der Grube herum.\n",
       "Der Wuestling versucht verzweifelt, rauszuklettern.\n",
       "Der Wuestling wird wahnsinnig, wenn er so lange an einem Ort bleibt.\n",
       "Der Wuestling bittet Dich um Hilfe.\n",
       "Der Wuestling schluchzt herzzerreissend...\n",
       "Der Wuestling hat panische Angst.\n",
       "Der Wuestling sagt: Bitte hilf mir hier wieder raus.\n" }) );

   return 1;
}

befreit()
{
  SetChats(100, ({
    "Der Wuestling blickt sich rasch um.\n",
    "Der Wuestling wuselt hektisch durch die Gegend.\n",
    "Der Wuestling hat es wieder sehr eilig.\n",
    "Der Wuestling ist schon viel zu lange hier.\n",
    "Der Wuestling murmelt: \"...muss schnell weg...\"\n",
    "Der Wuestling sagt: \"Ich bin der Schnellste!\"\n",
    "Der Wuestling ist komplett ausser Atem.\n",
    "Der Wuestling ruft: \"Fang mich doch!\"\n",
    "Der Wuestling zappelt ungeduldig mit den Fuessen umher.\n",
    "Der Wuestling fragt Dich: \"Spielen wir fangen?\"\n",
    "Der Wuestling ruft: \"Hasch mich!\"\n",
    "Den Wuestling wirst Du wohl nie erwischen...\n" }) );
  
  richtung =0;
  akt_move=0;

  SetProp(P_SHORT, "Ein Wuestling");
  
  gefangen = 0;
  
  return 1;
}

void die(string arg)
{
  object ob, room;
	
  if(objectp(room=find_object(ROOM "0606")))
    {
      if(ob = present("ublaetter", room))
	if(objectp(ob)) ob->remove();
      
      if(ob = present("ugras", room))
	if(objectp(ob)) ob->remove();

      if(ob = present("uast", room))
	if(objectp(ob)) ob->remove();
      
      if(ob = present("falle", room))
	if(objectp(ob)) ob->remove();

      if(ob = present("\nloch", room))
	if(objectp(ob)) ob->remove();
  
      room->RemoveExit("runter");
    }
  
  WLOG(KLOG "zt", "killt den Wuestling");
  
  ::die();
} 


_query_wimpy() { return 0; }
