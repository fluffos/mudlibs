#include "../def.h"

inherit "std/npc"; 
 
create() 
{ 
  if(!is_clone(TO)) return; 
  ::create();              
  
  AddId(({"schmied","geesthil","eesthil","mensch"}) ); 
  SetProp(P_GENDER, MALE); 
  SetProp(P_RACE, "Mensch"); 
  
  SetProp(P_NAME, "Eesthil"); 
  SetProp(P_SHORT, "Der Schmied Eesthil"); 
  
  SetProp(P_ARTICLE, 0); 
  
  SetProp(P_LONG,
	  BS("Eesthil steht neben seinem Amboss und ist mit " 
	     "einer feinen Schicht Kristall ueberzogen. "
	     "Er ist ein muskuloeser, staemmiger Mann, der gut 1.9 m gross " 
	     "ist. Langes schwarzes Haar faellt ueber seine Schultern. Er " 
	     "traegt eine Schuerze aus Wildleder.\n")); 
  
  create_default_npc(2); 

  SetProp(P_ALIGN, 200); 
  SetProp(P_SIZE, 180 ); 
  SetProp(P_WEIGHT, 81821);
  SetProp(P_NOATTACK, "ist doch versteinert!");         

  SetProp(P_XP, 0);

  SUID; 

  CLONEME("/p/armour/cloak/lederschuerze");
  command("trage alles");
  
  SetProp(P_DEFAULT_INFO,        
	  "kann Dich nicht hoeren.\n"); 

  AddInfo("sargola",        
	  "Du glaubst eine feine Regung zu bemerken!"); 
  
  SetProp(P_REJECT,({
    REJECT_DROP, "Eesthil kann das nicht nehmen!\n"})); 

  SetChats(2,({
    "Eesthil knirscht leise.\n", 
      "Eesthils Arm hat sich leicht bewegt!\n", 
      "Ein leises Knacksen kommt aus der Richtung von Eesthil.\n", 
      "Ein kleiner Kristall broeckelt vom Schmied ab.\n"}));
  
  AddCmd(({"kitzel","stups","trete","kitzle"}), "toete"); 
}

int toete(string str)
{
  if(id(str) )
    {
    } 
  return 1;	  
}  

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if(find_call_out("reaction") != -1) return;

  if(touch)
    switch(random(5))
      {
      case 0:
	call_out("reaction", 0, TP, 
		 "Eesthil kann Dir doch nichts tun!!!");
	break;
	
      case 1:
	call_out("reaction", 0, TP, 
		 "Lass doch den armen Eesthil in Ruhe!");
	break; 
	
      case 3:
	call_out("reaction", 0, TP, 
		 "Du hast das Gefuehl, dass Eesthil Dich boese ansieht..."); 
	break; 
	
      default:  
	call_out("reaction", 0, TP, 
		 "Dass Dich nur keiner dabei sieht...");
	break; 
      } 
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher)
{
  if(present(ob, MENV)) 
    tell_object(ob, BS(macher));
}
