inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>     
#include <moving.h>
#include "/d/kristallwald/sargola/def_kristall.h"

int toete(string str);


void create()
{
  if (!is_clone(TO)) return;
  ::create();             

   AddId ( ({"schmied","eesthil","mensch"}) );
   SetProp (P_GENDER, MALE);
   SetProp (P_RACE, "Mensch");
        
   SetProp (P_NAME, "Eesthil");
   SetProp (P_SHORT, "Der Schmied Eesthil");
        
   SetProp (P_ARTICLE, 0);
       
   SetProp (P_LONG,BS("Eesthil steht neben seinem Amboss und wollte "
           +"vermutlich gerade ein Jagdmesser schmieden. "
           +"Er ist ein muskuloeser, staemmiger Mann, der gut 1.9 m gross "
           +"ist. Langes schwarzes Haar faellt ueber seine Schultern. Er "
           +"traegt eine Schuerze aus Wildleder.\n"));

   create_default_npc(20);
   SetProp (P_ALIGN, 200);
   SetProp (P_XP, 0);
   SetProp (P_SIZE, 180 );
   SetProp(P_NOATTACK, "will nicht mit Dir kaempfen!");     
        
   SUID;
   clone_object("/p/armour/cloak/lederschuerze")->move(TP);
        
   SetProp (P_DEFAULT_INFO,        "kann Dich nicht hoeren.\n");
   AddInfo ("sargola", "Du glaubst eine feine Regung zu bemerken!");

   SetProp( P_REJECT, ({REJECT_DROP,  
      "Eesthil kann das nicht nehmen!\n" }) );
   SetChats (2, ({
      "Eesthil knirscht leise.\n",
      "Eesthils Arm hat sich leicht bewegt!\n",
      "Ein leises Knacksen kommt aus der Richtung von Eesthil.\n",
      "Ein kleiner Kristall broeckelt vom Schmied ab.\n",
           }) );                

   AddCmd( ({"kitzel","stups","trete","kitzle"}), "toete");
 }                                                                                                    


int toete(string str)
{
   switch( random(4))
   {
   case 0:   
   {   write(BS("Eesthil kann Dir doch nichts tun!!!\n"));
      break;
   }
   case 1: 
   {
      write(BS("Lass doch den armen Eesthil in Ruhe!\n"));
      break;
   }
   case 2: 
   {
      write(BS("Du hast das Gefuehl, dass Eesthils Dich boese ansieht...\n"));
      break;
   }
   case 4: 
   {
      write(BS("Die Goetter erzuernen ueber Dein Vorhaben!\n"));
      break;
   }
   default: 
   {
      write(BS("Dass Dich nur keiner sieht...\n"));
      break;
   }
   
   }
   return 1;
} 

