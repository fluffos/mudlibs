inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>     
#include <moving.h>
#include "/d/kristallwald/sargola/def_kristall.h"

           create()      {
       if (!is_clone(TO)) return;
    ::create();             

   AddId ( ({"schmied","meesthil","eesthil","mensch"}) );
        SetProp (P_GENDER, MALE);
        SetProp (P_RACE, "Mensch");
        
        SetProp (P_NAME, "Eesthil");
        SetProp (P_SHORT, "Der Schmied Eesthil");
        
        SetProp (P_ARTICLE, 0);
        
        SetProp (P_LONG,BS("Eesthil ist ein muskuloeser, staemmiger Mann, "
           +"der gut 1.9 m gross ist. Langes schwarzes Haar faellt "
           +"ueber seine Schultern. Er traegt eine Schuerze aus "
           +"Wildleder.\n"));
        AddDetail("haar", BS("Er traegt langes, schwarzes Haar, das bis ueber "
           +"seine Schultern reicht.\n"));
        AddDetail("schultern", BS("Solch wuchtige Schultern haettest Du auch "
           +"gern...\n"));
        AddDetail("mann", BS("Eesthil ist ein wirklich ein stattlicher Mann.\n"));
        

        create_default_npc(18);
        SetProp (P_ALIGN, 200);
        SetProp (P_XP, 0);
        SetProp (P_MAX_HP, 500 );
        SetProp (P_MAX_SP, 500 );
        SetProp (P_SP, 500 );   
        SetProp (P_HP, 500 );
        SetProp (P_SIZE, 179 );
        
        SetProp(P_HANDS, ({" mit seinem Schmiedehammer",130,DT_SQUEEZE}) );
        
        SUID;
        clone_object("/p/armour/cloak/lederschuerze")->move(TO);
	clone_object("/p/weapon/club/schmiedehammer")->move(TO);
        TO->command("ziehe schuerze an");
        TO->command("zuecke hammer");
        
   SetProp (DEFAULT_INFO, "Ich habe gerade viel zu tun.", "sagt: ");
        AddInfo ("sargola",        "Du kennst Sargola?");

   SetProp( P_REJECT, ({REJECT_KEEP,  
      "Eesthil bedankt sich bei Dir.\n" }) );
   SetChats (2, ({
      "Eesthil haemmert auf dem Amboss herum.\n",
      "Eesthil schmiedet ein Messer.\n",
      "Eesthil bringt die Kohlen wieder zum Gluehen.\n",
      "Eesthil schwingt den Schmiedehammer als haette er kein Gewicht.\n",
           }) );                

   
 }                                                                                                    


 

