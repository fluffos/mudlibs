#include "../def.h"

inherit "std/thing";

void create()      
{    
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"\nupflock","\neesthilpflock"}));
  SetProp(P_SHORT, 0);
  SetProp(P_NAME, "");
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, NEUTER); 
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
} 
 
void reset()
{
  if(!is_clone(ME)) return;
  ::reset();
  
  if((!MENV) || (!query_once_interactive(MENV)))
    remove(1);
}
