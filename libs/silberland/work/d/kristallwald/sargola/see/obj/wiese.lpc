#include "../def.h"

inherit "std/thing";

void create()      
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"gras","halme","grashalme","grasbueschel","bueschel"}));

  SetProp(P_SHORT, "Ein Bueschel Gras");
  SetProp(P_LONG, 
	  BS("Ein Haufen gruener, langer Grashalme."));
  SetProp(P_NAME, "Gras");
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, NEUTER); 
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, ({MAT_MISC_PLANT}));
}
