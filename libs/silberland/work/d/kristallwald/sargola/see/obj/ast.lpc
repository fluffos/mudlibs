#include "../def.h"

inherit "std/thing";

create()      
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"ast"}));
  SetProp(P_SHORT, "Ein Ast");
  SetProp(P_LONG, 
	  BS("Ein gewoehnlicher Ast mit einer Menge Blaettern."));
  SetProp(P_NAME, "Ast");

  SetProp(P_GENDER, MALE); 
  SetProp(P_MATERIAL, ([MAT_OAK:60, MAT_MISC_PLANT:20, MAT_CRYSTAL:20]));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
} 
