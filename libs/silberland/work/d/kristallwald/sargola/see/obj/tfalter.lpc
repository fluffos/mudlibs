inherit "std/npc"; 


#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>

#include <mnpc.h>
#include <moving.h>
     
     
//spezielles Include-File fuer die Region/Quest angeben!
#include "/d/kristallwald/sargola/def_kristall.h"
     
      create()
      {
      if (!is_clone(TO)) return;
       ::create();
     
        AddId ( ({"falter","tuerkisfalter"}) );
        AddDetail("faerbung", BS("Der Falter hat eine hell-gruenliche Faerbung.\n"));
        SetProp (P_GENDER, MALE);
        SetProp (P_RACE, "Falter");
     
        //P_NAME wird im Satz verwendet und soll aus einem Wort bestehen
        SetProp (P_NAME, "Tuerkisfalter");
        SetProp (P_SHORT, "Ein Tuerkisfalter");         // zB Ein Erdmaennchen...
     
        //P_ARTICLE gibt an, ob in der Beschreibung Artikel ausgegeben werden soll 0 oder 1
        SetProp (P_ARTICLE, 1);
     
        //P_NAME_ADJ wird bei name() mitbenutzt

        SetProp (P_LONG,BS("Der Falter wird wohl wegen seiner Faerbung "
      +"Tuerkisfalter genannt.\n"));
     
        //AddSound (DEFAULT_SOUND, BS("Du kannst nichts hoeren.\n"));
        //AddSmell (DEFAULT_SMELL, BS("So ein Falter pflegt nicht zu riechen...\n"));
     
        //Standardwerte fuer NPC festlegen...
        create_default_npc(2);
        SetProp (P_ALIGN, 100);
     
        //sollte sein MAX_HP *P_HANDS*5
        SetProp (P_XP, 20000);
     
        SetProp (P_MAX_HP, 60 );      // MAX_HP = level * 8 + 42
        SetProp (P_MAX_SP, 60 );      // MAX_SP = level * 8 + 42
        SetProp (P_SP, 60 );         // P_SP = Maximalwert
        SetProp (P_HP, 60 );         // P_HP = Maximalwert
     
        SetProp (P_SIZE, 10 );      // P_SIZE = groesse des NPC in cm
        SetProp (P_HEAL, 10);
     
        SetProp (P_MSGIN, "flattert herein");
        SetProp (P_MSGOUT, "flattert weiter");
        SetProp (P_WIMPY, 10);
        //SetProp (P_MAX_KILL_LEV, 8);
   //SetProp (P_NOKILL_MSG, ({BS("Der Tuerkisfalter fliegt wie der Blitz um Dich herum."),
   //       BS("Der Tuerkisfalter fliegt um @@WEN@@ herum.\n")} ));

     
        SetProp (P_BODY, 14);         //sollte sein LEVEL*20/3
     
        //sollte sein Menschen 2, Insekten 6, Schlangen 0
        SetProp (P_MAX_HANDS, 6);
        //" mit blossen Haenden", level*10,DT_BLDUGEON, DT_FIRE, DT_COLD,DT_PIERCE
        SetProp (P_HANDS, ({" mit filigranen Fuehlern",20,DT_PIERCE}) );

        //sollte man nur bei wichtigen Personen machen

     
     
   SetAttackChats(3, ({
        "Der Tuerkisfalter fliegt um Dich herum und verfehlt Dich trotzdem.\n",
        "Der Tuerkisfalter weicht Deinem Schlag aus.\n",
        "Der Tuerkisfalter schreit um Hilfe.\n",
     }) );
     
        SetProp (P_DIE_MSG, " sinkt langsam zu Boden.\n");
        SetProp(P_MURDER_MSG, "Einen hilflosen Falter angreifen!");
        SetProp (P_DEFAULT_INFO,   "Beachtet Dich gar nicht.");
        SetProp(P_NOCORPSE, 0);


        AddInfo("sargola", "Sargola ist mein Schoepfer.","sagt: ");
        AddInfo (({"falter", "turkies"}),
              "Man nennt mich Tuerkisfalter, weil meine Fluegel an Tuerkis erinnern.", "meint: ");
     
        AddInfo (({"wald","kristallwald"}),
        "Dies ist meine Heimat auch wenn sie mir ohne Kristalle lieber war.", "sagt: ");
       
       SetChats (3, ({
       "Der Tuerkisfalter sucht nach Blueten.\n",
       "Der Tuerkisfalter setzt sich auf Deine rechte Schulter.\n",
       "Der Tuerkisfalter kitzelt Dich mit seinen Fluegeln.\n",
       "Der Tuerkisfalter mustert Dich respektvoll.\n",
           }) );
     
       }
      
   
     
     
     
     
     
     
     
     
     
     
     
     
     

 

