*/inherit "std/weapon"; 
#include <properties.h> 
#include <combat.h> 
#include <language.h> 
#include "/d/kristallwald/sargola/def_kristall.h" 
 
      create()       
{        if (!is_clone(this_object()))           return; 
        ::create(); 
             AddId ( ({"eesthildolch","dolch","\neesthildolch"}) ); 
        SetProp (P_SHORT, "Ein Dolch"); 
        SetProp (P_LONG, BS("Der Dolch scheint eine ganz gewoehnlicher Waffe " 
           +"zu sein. Bis auf die Tatsache, dass er blaeulich schimmert.\n")); 
        SetProp (P_NAME, "Dolch"); 
        SetProp (P_GENDER, MALE);  
     SetProp(P_WEAPON_TYPE, WT_KNIFE ); 
   SetProp(P_DAM_TYPE, DT_PIERCE); 
   SetProp(P_WC, 60); 
   SetProp(P_NR_HANDS, 1); 
   SetProp(P_MATERIAL, MAT_METAL ); 
   SetProp(P_WEIGHT, 60); 
   SetProp(P_VALUE, 300); 
   SetProp(P_NOBUY, 1); 
 
   SetProp(P_WIELD_FUNC, TO ); 
}  
 
 
int WieldFunc(object waffe) 
{ 
   write(BS("Den kannst Du nicht zuecken. Der Dolch hat eine "
+"andere Bestimmung.\n")); 
   //command ("stecke dolch weg"); 
   return 0; 
} 
  

