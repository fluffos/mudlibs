/************************************************
** Allgemeiner Heiltrank - mit Ablaufdatum	*
** pro Reset					*
**						*
** date: 06-09-97 by Sargola@Silberland     	*
** Email: a9504778@unet.univie.ac.at         	*
*************************************************
**      
**      
** set_values(int typ, int hp, int sp, int drink, int decr)
**
**		setzt heilungs-werte (lp/mp)      
** 		muss nach dem clonen ausgefuehrt werden
**		da sonst standard-werte ;)
**
**		int typ:	milar, palantar, santar
**		int hp:		hp-heilung zu beginn
**		int sp:		sp-heilung zu beginn
**		int drink:	trink-saettigung
**		int decr:	wert, um den hp/sp 
**				pro reset reduziert werden ;)
*/

#include "../def.h"

inherit "std/thing";


#define MAX_RESET_ZAEHLER 5
nosave int reset_zaehler;
nosave int typ, hp, sp, drink, decr;

int set_values(int ltyp, int lhp, int lsp, int ldrink, int ldescr);

void create()      
{
  if(!is_clone(ME)) return;
  ::create();
  
  // Standard-Werte
  typ = 2;
  hp = 10;
  sp = 10;
  decr = 5;
  drink = 5;
  reset_zaehler = 5;	
  
  AddId(({"flaeschchen","trank","heiltrank" }));
  
  SetProp(P_KILL_NAME, "Ein verdorbener Heiltrank");
  SetProp(P_GENDER, MALE); 
  SetProp(P_WEIGHT, 300);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL,1);
  SetProp(P_NODROP, "Du willst doch einen so wertvollen Trank nicht "
	  "hergeben, oder?\n");
	
   AddDetail("flaeschchen",
	     "Es ist ein wunderschoen verziertes Flaeschchen, ca 10 cm hoch "
	     "und mit einem Korken verschlossen. Das robust wirkende Glas "
	     "zeigt auf kleinen Reliefes verschiedene Szenen.");
   
   AddDetail(({"reliefs","relief"}),
	     "An der Aussenseite des Flaeschchens befinden sich rundherum "
	     "einige plastisch wirkende Reliefs.");
   
   AddDetail("szenen",
	     "Sie stellen alle Symbole der Natur dar. Du kannst Blaetter, "
	     "Fruechte und andere Pflanzen erkennen.");
   	
   AddDetail(({"blaetter"}),
	     "Sie sind klein und doch gut erkennbar. An den Ecken sind sie "
	     "gezackt. Von welchem Baum die wohl stammen moegen?");
   
   AddDetail("ecken",
	     "Die Ecken der Blaetter sind gezackt.");
   
   AddDetail("fruechte",
	     "Du kannst nicht erkennen, was es fuer welche sind. Du siehst "
	     "nur, dass sie rund sind.");
   	
   AddDetail("pflanzen",
	     "Sie sind nur angedeutet, und es geht ja auch nicht darum zu "
	     "zeigen, welche Pflanzen es genau sind. Vielmehr sollen sie "
	     "symbolisch die Verbundenheit zur Natur zeigen.");
   
   AddDetail("korken",
	     "Der Korken ist hellbraun kraeftig in die Flasche gepfropft."); 
   	
   AddDetail("glas",
	     "Einfaches, jedoch mit Reliefs verziertes Glas.");

   AddDetail("fluessigkeit",
	     "Sie ist schimmert auffaellig aus dem Flaeschchen. Wie sie wohl "
	     "schmeckt...?");
   
   AddCmd(({"trink","trinke"}),"trinke");
} 


/*
*******************************************************************
** set_values(int typ, int hp, int sp, int drink, int decr)
**
**		setzt heilungs-werte(lp/mp)      
** 		muss nach dem clonen ausgefuehrt werden
**		da sonst standard-werte ;)
**
**		int typ:	milar, palantar, santar
**		int hp:		hp-heilung zu beginn
**		int sp:		sp-heilung zu beginn
**		int drink:	trink-saettigung
**		int decr:	wert, um den hp/sp 
**				pro reset reduziert werden ;)
*******************************************************************
*/
void set_values(int ltyp, int lhp, int lsp, int ldrink, int ldecr)
{
  
  hp = lhp;
  sp = lsp;
  decr = ldecr;
  typ = ltyp;
  drink = ldrink;
  
  switch(ltyp)
    {
    case 1:
      {
	SetProp(P_SHORT, "Ein kleiner Milar");
	SetProp(P_NAME, "Milar");
	AddId(({"kleiner milar","milar"}) );
	break;
      }

    case 2:
      {
	SetProp(P_SHORT, "Ein grosser Milar");
	SetProp(P_NAME, "Milar");
	AddId(({"grosser milar","milar"}) );
	break;
      }

    case 3:
      {
	SetProp(P_SHORT, "Ein kleiner Palantar");
	SetProp(P_NAME, "Palantar");
	AddId(({"kleiner palantar","palantar"}) );
	break;
      }

    case 4:
      {
	SetProp(P_SHORT, "Ein grosser Palantar");
	SetProp(P_NAME, "Palantar");
	AddId(({"grosser palantar","palantar"}) );
	break;
      }
      
    case 5:
      {
	SetProp(P_SHORT, "Ein kleiner Sandar");
	SetProp(P_NAME, "Sandar");
	AddId(({"sandar","kleiner sandar"}) );
	break;
      }

    case 6:
      {
	SetProp(P_SHORT, "Ein grosser Sandar");
	SetProp(P_NAME, "Sandar");
	AddId(({"sandar","grosser sandar"}) );
	break;
      }		
    }
}

nosave int trinke(string str)
{
  notify_fail(BS("Was willst Du trinken?"));
  if(!str) return 0;

  if(!id(str)) return 0;

  if(!TP->drink_soft(drink, 1))
    return write(BS("Soviel kannst Du nicht mehr trinken!")), 1;

  if(TP->InFight())
    if(TP->QueryProp(P_ATTACK_BUSY))
      return write(BS("Dazu bist Du viel zu beschaeftigt!")), 1;
    else
      TP->SetProp(P_ATTACK_BUSY, 1+(hp+sp)/50);

  write(BS("Du ploppst den Korken aus der Flasche, setzt "
	   "sie an die Lippen und trinkst die Fluessigkeit auf einen Zug "
	   "aus."));
  
  tell_room(ENV(TP), BS(TPN+" trinkt ein kleines Flaeschchen."), ({TP}));

  switch(reset_zaehler)
    {
    case 0:
    case 1:
      { 
	write(BS("WAEH! Was war das fuer ein Zeugs!?!"));
	break;
      }
      
    case 2:
      {
	write(BS("Dir ist ein wenig uebel."));
	break; 
      }
	   
    case 3:
      {
	write(BS("Du fuehlst keine nennenswerte Wirkung."));
	break;
      }
      
    case 4:
      {
	write(BS("Du fuehlst Dich etwas besser."));
	break;
      }
      
    case 5:
      {
	write(BS("Du fuehlst Dich deutlich besser."));
	break;
      }
      
    }

  TP->AddHp(hp);
  TP->AddSp(sp);

  RemoveCmd(0);
  call_out("remove", 0);

  return 1;
}

void reset()
{
  if(!is_clone(ME)) return;
  ::reset();
  
  if(reset_zaehler>0)
    {
      reset_zaehler--;
      
      if(typ == 1|| typ==2)	//LP-Trank
	hp-=decr;
      else 
	if(typ ==3||typ==4)	// SP-Trank
	  sp-=decr;
      else 			// LP,SP-Trank
	{	
	  hp-=decr;
	  sp-=decr;
	}
    }
}

_query_long()
{
  string long;
  
  switch(typ)
    {
    case 1:
    case 2:
      long="Ein kleines Flaeschchen gefuellt mit einer roetlichen "
	"trueben Fluessigkeit.\n"; 
      break;
    case 3:
    case 4:
      long="Ein kleines Flaeschchen gefuellt mit einer blaeulich "
	"trueben Fluessigkeit.\n";
      break;
    case 5:
    case 6:
      long="Ein kleines Flaeschchen gefuellt mit einer gelblich "
	"trueben Fluessigkeit.\n";
      break;
    }
  
  switch(reset_zaehler)
    {
    case 5:
    case 4:
      long+="Der Trank scheint frisch zu sein.\n"; 
      break;
    case 3:
      long+="Der Trank ist schon etwas aelter.\n"; 
      break;
    case 2:
      long+="Der Trank ist knapp am Verfallsdatum.\n";
      break;
    case 1:
      long+="Der Trank hat vor kurzem das Verfallsdatum ueberschritten.\n";
      break;
    case 0:
      long+="Der Trank hat das Verfallsdatum weit ueberschritten.\n"; 
      break;
    }
  
  return long;
}
