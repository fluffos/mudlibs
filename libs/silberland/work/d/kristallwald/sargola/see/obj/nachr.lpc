inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/d/kristallwald/sargola/def_kristall.h"

      create()      
{        if (!is_clone(this_object()))           return;
        ::create();
   
        AddId ( ({"pergament","stueck","rolle","nachricht","nachr"}) );
        SetProp(P_SHORT, "Eine Nachricht");
 	SetProp(P_LONG, BS("Ein kleines, zusammengerolltes Stueck Pergament, "
 		+"das an den Ecken schon vergilbt ist. Du kannst es lesen. Mit "
 		+"\"zerknuelle pergament\" kannst Du sie wegwerfen.\n"));               
	SetProp(P_NAME,"Rolle Pergament");
        SetProp(P_ARTICLE, 1);
        SetProp (P_GENDER, FEMALE); 
        SetProp (P_WEIGHT, 0);
	SetProp (P_VALUE, 0);
        SetProp (P_NOBUY, 1);
	AddDetail(({"rolle","pergament"}), BS("Du siehst ein kleines, saeuberlich "
		+"zusammengerolltes Stueck Pergament. Es hat eine gelbliche Faerbung."));
	AddDetail("faerbung", BS("Sie ist gelblich und an den Ecken ist "
		+"das Pergament schon fast braeunlich."));
	AddDetail("ecken", BS("Sie sind abgestumpft vom Transport in dem "
		+"Kaestchen des Falken.")); 
	AddCmd ( ({"zerknuelle"}), "zerknuelle");
} 
 

set(string str)
{
	AddReadDetail( ({"rolle","pergament","brief","inhalt","nachricht"}), BS(str+"\n"));
}


zerknuelle(string str)
{
	notify_fail("Was willst Du denn zerknuellen?\n");
	if(!str) return 0;

	if(str=="pergament"||str=="nachricht"||str=="rolle"||str=="brief")
	{
		TO->remove();
		tell_object(TP, "Du zerknuellst das Pergament.\n");
		return 1;
	}
	return 0;
}
