#include "../def.h"

inherit "std/thing";

#define KRISTALLQUEST "Eesthils Befreiung"
#define KRISTALLQUESTLOG "/log/quests/eesthil"

#define BELOHNUNG "/d/kristallwald/sargola/wald/obj/degen"

int query_fertigkeit();
int set_fertigkeit();
int set_uebung();
int query_uebung();
nosave string owner;         //Eigentuemer
nosave int fertigkeit;         //Wie gut kann man schon spielen?
int spiele_floete(string str);
int learn();
nosave int uebung;         //wie oft war man bei serona

nosave int auszeit;

int befreiung(object who);         //Ende der Quest :)
int uebung();

void create()
{
  if(!is_clone(this_object())) return;
  ::create();
  
  uebung = 0;
  fertigkeit = 0;
  auszeit = 0;

  SetProp(P_SHORT, "Eine Floete");
  SetProp(P_LONG,
	  BS("Sie sieht aus, wie eine normale Holzfloete. Du kannst nichts "
	     "besonderes an ihr erkennen."));
  SetProp(P_NAME, "Floete");
  AddId(({"eesthilfloete","\neesthilfloete","\nfloete","floete",
	    "holzfloete"}));
  SetProp(P_GENDER, FEMALE);
  
  SetProp(P_INFO,
	  BS("Nur mit dieser Floete kann man Eesthil von seinem Fluch "
	     "befreien!"));

  SetProp(P_VALUE, 140);
  SetProp(P_WEIGHT, 500);
  SetProp(P_NOBUY, 1);
  
  SetProp(P_MATERIAL, ({MAT_MISC_WOOD}));
  
  AddCmd(({"spiel","spiele"}), "spiele_floete");
  AddCmd(({"ueb","uebe"}),"uebe");
}

nosave int uebe()
{
  return notify_fail(BS("Du willst wohl mit der Floete spielen, richtig?")), 0;
}

public string set_owner(string arg)
{
  if(!stringp(owner))
    {
      PRO(sprintf("<%s> - <%s>\n", geteuid(PO), getuid(PO)));
      
      if((geteuid(previous_object())!="d.kristallwald.sargola") &&
	 (getuid(PO)!="protheg"))
	return owner = 0;

      return owner = arg;
    }
  
  return owner;
}

public string query_owner()
{
  return owner;
}

public int set_uebung()
{
  return ++uebung;   
}

public int query_uebung()
{   
  return uebung;
}

public int set_fertigkeit()
{   
  return ++fertigkeit;
}

public int query_fertigkeit() 
{   
  return fertigkeit>37 ? 37 : fertigkeit;
}

nosave int spiele_floete(string str)
{
  int wie_gut;
  
  notify_fail(BS("Was willst Du spielen?"));
  if(!str) return 0;
 
  if((str!="floete") && (str!="mit floete")) return 0;

  // Ist man bei Eesthil
  
  if((ENV(TP)) && (file_name(ENV(TP))==ROOM "schmiede"))
    {
      befreiung(TP);
      return 1;
    }

  // ist nicht seine :)
  if(query_owner() != TP->query_real_name() )
    {
      write(BS("Hmm. Das Mundstueck ist ja ganz und gar unpassend fuer Dich. "
	       "Die Floete ist sicher nicht fuer Dich geschnitzt worden!"));
      remove();
      return 1;
    }
  
  // Player kann noch ueberhaupt nicht spielen :)
  if(!query_uebung())
    return write(BS("Du hast doch noch gar keine Ahnung, wie man so eine "
		    "Floete spielt...")), 1;
  
  // Zeitkontrolle - man kann nicht zu schnell ueben...
  if(auszeit > time())
    return write(BS("Du bist noch ein wenig ausser Atem vom Spielen. Warte "
		    "lieber noch ein wenig.")), 1;
  
  auszeit=time()+5;
  
  wie_gut = query_fertigkeit();
  wie_gut = wie_gut + random(10);
  
  if(wie_gut<=10)
    {
      write(BS("Du quietschst schrecklich!"));
      tell_room(ENV(TP), 
		BS(TPN+" quietscht schrecklich auf "+
		   TP->QueryPossPronoun(FEMALE, WEM)+" Floete."), ({TP}));
      set_fertigkeit();
      return 1;
    }
  
  if(wie_gut>10 && wie_gut<=20)
    {
      write(BS("Es ist fuerchterlich, was Du da spielst."));
      tell_room(ENV(TP), 
		BS(TPN+" spielt fuerchterlich auf "+
		   TP->QueryPossPronoun(FEMALE, WEM)+" Floete."), ({TP}));
      set_fertigkeit();
      return 1;
    }
  
  if(wie_gut>20 && wie_gut<=30)
    {
      write(BS("Es ist nicht schoen, aber es geht."));
      tell_room(ENV(TP), 
		BS(TPN+" spielt irgendwas auf "+
		   TP->QueryPossPronoun(FEMALE, WEM)+" Floete."), ({TP}));
      set_fertigkeit();
      return 1;
    }
  
  if(wie_gut>30 && wie_gut<=40)
    {
      write(BS("Ein schoenes Lied entspringt der Floete."));
      tell_room(ENV(TP), 
		BS(TPN+" spielt ein schoenes Lied auf "+
		   TP->QueryPossPronoun(FEMALE, WEM)+" Floete."), ({TP}));
      set_fertigkeit();
      return 1;
    }
  
  if(wie_gut>=40)
    return write(BS("Du findest, dass Du gut genug Floete spielen "
		    "kannst.")), 1;
  
  return 0;      
}

int befreiung(object who)
{  
  int i,j;
  object ob, esthil;
   
  notify_fail("Eesthil ist nicht hier...\n");
  if(!ob=present("eesthil", ENV(who))) return 0;
  
  if(!uebung)
    return write(BS("Du nimmst die Floete in die Hand, versuchst hinein"
		    "zublasen. Doch kein Ton erschallt...hmmm... Vielleicht"
		    " solltest Du Dir das mal erklaeren lassen...")), 1;
  
  if(uebung==1)
    return write(BS("Du spielst ein schoenes elfisches Lied, aber nichts "
		    "passiert. Du kannst der Floete wohl doch noch nicht "
		    "die richtigen Schwingungen entlocken...")), 1;
  
  if(uebung>=2)
   {
     if(present("meesthil",environment(who)) )
      {
         write(BS("Du hast Eesthil ja schon geholfen!\n"));
         return 1;
      }
      write(BS("Du spielst die schoensten, aeltesten Lieder, die Du "
	       "von Serona gelernt hast. Mit jedem Deiner Toene "
	       "broeckelt die Kristallschicht von Eesthil mehr und "
	       "mehr ab!! Am Ende steht ein verwirrter, aber froher "
	       "Eesthil vor Dir."));
      write("\n\n");
      write(BS("Eesthil ist Dir zutiefst dankbar und schenkt Dir "
	       "einen kostbaren Degen, welcher in kaltem Feuer "
	       "geschmiedet wurde. Es ist das Meisterwerk von "
	       "Eesthil und soll Dich an seine Dankbarkeit erinnern."));

      ob = clone_object(BELOHNUNG);
      
      if(ob->move(who, M_GET)==ME_TOO_HEAVY)
	{
	  tell_object(who, BS("Du kannst den Degen nicht mehr tragen."));
	  ob->move(ENV(who));
	}
      
      esthil=clone_object(NPC "esthil");
      esthil->move(environment(who),M_SILENT|M_NOCHECK);
      
      if(objectp(ob=present("\neesthilquest", who)))
	ob->remove();
      
      if(objectp(ob=present("geesthil", ENV(who))))
	{
	  map_objects(deep_inventory(ob), "remove");
	  ob->remove();
	}

     i = who->GiveQuest("Eesthils Befreiung"); 

     if(i == 1 )
       {
	 WLOG(KRISTALLQUESTLOG, "hat Eesthil befreit");
	 domainshout(CAP(getuid(who))+" hat Eesthil von seiner Gefangenschaft "
		     "im Kristall befreit!\n");
       }
            
      remove();
      return 1;
      
   }
  return 0;
} 

