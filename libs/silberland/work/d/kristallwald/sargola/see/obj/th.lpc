inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/d/kristallwald/sargola/def_kristall.h"

int sa ();

      create()      
{        if (!is_clone(this_object()))           return;
        ::create();
   
        AddId ( "th");
   SetProp(P_SHORT, "Ein Knochen");
   SetProp(P_LONG, BS("Ein ellenbogenlanger Knochen, der in erstaunlich "
   	+"gutem Zustand ist."));
	SetProp(P_NAME, "Knochen");
        SetProp (P_GENDER, MALE); 
        SetProp (P_WEIGHT, 300);
        SetProp (P_VALUE, 100);
        SetProp (P_NOBUY, 0);
        
        AddCmd("sa","sa");

} 
 
int sa()
{
	object ob;
	ob = clone_object("/d/kristallwald/sargola/see/obj/trank");
	ob->set_values(1,50,0,8,15);
	ob->move(TP);
	ob = clone_object("/d/kristallwald/sargola/see/obj/trank");
	ob->set_values(3,05,0,8,15);
	ob->move(TP);
	ob = clone_object("/d/kristallwald/sargola/see/obj/trank");
	ob->set_values(5,50,0,8,15);
	ob->move(TP);
	ob = clone_object("/d/kristallwald/sargola/see/obj/trank");
	ob->set_values(2,25,0,4,8);
	ob->move(TP);
	return 1;
		
}
