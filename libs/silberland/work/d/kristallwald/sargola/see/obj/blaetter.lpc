#include "../def.h"

inherit "std/thing";

void create()      
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"blaetter","haufen","blaetterhaufen"}));
  SetProp(P_SHORT, "Ein Haufen Blaetter");
  SetProp(P_LONG, 
	  BS("Ein Haufen Blaetter von der grossen Eiche im "
	     "Nordwesten des Kristallwaldes."));
  SetProp(P_NAME, "Blaetterhaufen");
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, MALE); 
  SetProp(P_MATERIAL, ([MAT_MISC_PLANT:80, MAT_CRYSTAL:20]));
  SetProp(P_WEIGHT, 600);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
}
