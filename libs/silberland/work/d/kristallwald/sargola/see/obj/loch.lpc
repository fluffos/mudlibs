nosave int timeout;

#include "../def.h"

inherit "std/thing";

void create()      
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId("\nloch");
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_NAME, "");

  SetProp(P_GENDER, NEUTER); 
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOGET, "");

  timeout=0;
} 
 
void reset()
{
  if(!is_clone(ME)) return;
  ::reset();                                                                   
  
  timeout++;
  
  if(timeout>2)
    call_out("remove",0);
}

varargs int remove(int silent)
{
  catch(ROOM "0606"->RemoveExit("runter"));
  
  ::remove();
}
