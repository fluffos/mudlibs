#include "../def.h"

inherit "std/thing";

void create()      
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId("knochen");
  SetProp(P_SHORT, "Ein Knochen");
  SetProp(P_LONG, 
	  BS("Ein ellenbogenlanger Knochen, der in erstaunlich "
	     "gutem Zustand ist."));
  SetProp(P_NAME, "Knochen");
  SetProp(P_MATERIAL, MAT_BONE);
  SetProp(P_GENDER, MALE); 
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
} 
 

