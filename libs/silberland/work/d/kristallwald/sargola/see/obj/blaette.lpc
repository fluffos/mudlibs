inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/d/kristallwald/sargola/def_kristall.h"

      create()      
{        if (!is_clone(this_object()))           return;
        ::create();
   
        AddId ( ({"blatt","blaetter","haufen" }) ) ;
        SetProp(P_SHORT, "Ein Haufen Blaetter");
        SetProp(P_LONG, BS("Ein Haufen Blaetter von der grossen Eiche im "
           +"Nordwesten des Kristallwaldes.\n"));
        SetProp(P_NAME, "Blaetter");
        SetProp(P_ARTICLE, 1);
        SetProp (P_GENDER, FEMALE); 
        SetProp (P_WEIGHT, 0);
        SetProp (P_VALUE, 0);
        SetProp (P_NOBUY, 1);
} 
 
