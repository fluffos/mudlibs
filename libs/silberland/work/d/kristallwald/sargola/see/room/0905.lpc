#include "../def.h"
#include "see.h"

#define AALIYAH_SCHLOSS "/d/kristallwald/aaliyah/schloss/room/shop"

inherit "std/room";

#define DIR_VON "westen"
#define DIR_BIS "suedosten"
#define SCHWIMMEN_TEXT_ICH "Du legst Deine Sachen und begiebst Dich ins kuehle Nass. Das glitzernde Wasser perlt an Deiner Haut ab und erfrischt Dich."
#define SCHWIMMEN_TEXT_ANDERE " zieht seine Sachen aus und schwimmt eine im See."

int quest_schwimmen(string str, object ob);
schwimmen1();
schwimmen2();
schwimmen3();

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:18]));
  
  SetProp(P_INT_SHORT, "Am See von Rhondonit");
  SetProp(P_INT_LONG, 
	  BS("Du stehst am Ufer vom See von Rhondonit und kannst nach Osten "
	     "und Westen am Ufer, welches von einer eigenartigen Wiese "
	     "bedeckt ist, entlanggehen. Die Idylle hier bewirkt innere "
	     "Ruhe. Im Nordosten liegt der Kristallwald. Nach Sueden hin "
	     "gelangst Du zu einem Schloesschen."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail("idylle", 
	    "Untersuchen kann man die nicht.");
  
  AddDetail(({"schloss","schloesschen"}),
	    "Im Sueden erkennst Du ein kleines Schloesschen.");
  
  STANDARD1
  STANDARD2
  GEBIRGE_FERN	
    
  AddCmd(({"bade", "baden", "schwimme", "schwimmen"}), "baden_gehen");
  AddCmd(({"springe", "spring"}), "springe");
   
  AddExit("suedosten", ROOM "1006");
  AddExit("westen", ROOM "0805");
  AddExit("sueden", AALIYAH_SCHLOSS);
}

SCHWIMMEN
