#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:13]));
  
  SetProp(P_INT_SHORT, "Bei Shardin");
  SetProp(P_INT_LONG, 
	  BS("Hier herrscht ploetzlich ein komplett anderes Bild. "
	     "Der Gang im Osten ist steinig, staubig und muffig wie die "
	     "vielen, die Du schon zur Genuege kennst. Jedoch diese Halle "
	     "und der Weg nach Westen machen einen ausgesprochen sauberen "
	     "Eindruck. Solltest Du es geschafft haben, dem Labyrinth zu "
	     "entkommen? Die Decke ist hier hoeher und gleichmaessiger "
	     "gearbeitet. Den Gang im Westen versperrt jedoch eine Tuere."));

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  
  AddDetail("eindruck", 
	    "Ja, es wird ein wirklich sauberer Eindruck vermittelt.");

  AddDetail(({ "grinsen" }),
	    "Es soll ja aufmunternd sein denkst Du.");

  AddDetail(({ "strichmaennchen", "maennchen" }), 
	    "So eines mit einem grossen Kopf und einem netten "
	    "Grinsen.");

  AddDetail("kopf", 
	    "Der Kopf grinst Dich lieb an.");

  AddDetail("grinsen", 
	    "Es ist wirklich lieb.");

  AddDetail(({"wand","waende"}),
	    "Auch die Waende sind glatt und eben gearbeitet.");     

  AddDetail(({ "staub" }), 
	    "Du zeichnest einige liebe Strichmaennchen. Fuer andere "
	    "Abenteurer denkst Du...");

  AddDetail(({ "halle", "hallen" }), 
	    "Du verfluchst die Hallen hier. Sie sind kuehl, "
	    "feucht, sie stinken und Du moechtest viel eher ins Dorf.");

  AddDetail("mief", "Riech doch mal genauer!");
  
  AddDetail(({"labyrinth"}), 
	    "Ein anderer Ausdruck dafuer faellt Dir nicht ein.");

  AddDetail(({"weg"}), 
	    "Er ist kaum staubig oder erdig und wird nach Norden hin "
	    "immer heimeliger.");

  AddDetail(({"gaenge","gang", "stollen"}), 
	    "Es sind fein gearbeitete Stollen, komplett das Gegenteil der "
	    "Gaenge, die weiter im Osten liegen.");

  AddDetail("boden", 
	    "Der Boden ist fast eben und kaum von Staub bedeckt.");

  AddDetail(({"handschrift","decke"}), 
	    "Die Decke ist ordentlich glatt gearbeitet - deutlich die "
	    "Handschrift eines begabten Zwergs.");

  AddDetail("zwerg", 
	    "Nur Zwerge koennen so glatte Stollen schaffen.");
  AddDetail(({"eichentuere","eichentuer","tuer", "tuere"}), 
	    "Es ist eine robuste Eichentuere, die in schweren Angeln haengt. "
	    "Du siehst einen Klopfer.");

  AddDetail(({"angel", "angeln"}), 
	    "Sie sind so robust, dass Du es sicher nicht schaffen wuerdest, "
	    "die Tuere einzutreten.");

  AddDetail("klopfer", 
	    "Es ist eigentlich ein grosser, schwerer Ring aus Eisen, der an "
	    "der Tuere haengt. Schwingt man ihn gegen die Tuer, erklingt "
	    "sicherlich ein lautes BUMMMMM...");

  AddDetail("eisen", 
	    "Der Ring ist aus derb gegossenem Eisen.");

  AddDetail("ring", 
	    "So einen Ring benutzt man normalerweise, um an eine "
	    "Tuer anzuklopfen.");

  AddSound("bummmmm", 
	   "Wenn mal ein BUMMMMM da war, jetzt ist es verhallt.");

  AddCmd(({"klopfe", "klopf", "betaetige", "benutze"}), "klopfen");

  AddCmd(({"schwing","schwinge"}), "klopfen");
  
  AddExit("osten", ROOM "s_0301");
}

nosave int klopfen(string str)
{
  notify_fail(BS("WOMIT willst Du klopfen?"));
  if(!str) return 0;
  
  if(str=="an tuer"||str=="auf tuer"||str=="an tuere"||str=="auf tuere")
    {
      write(BS("Du klopfst, aber Dein Klopfen ist kaum hoerbar bei der "
	       "massiven Tuer."));
      return 1;
    }
  
  if(str=="auf klopfer"||str=="auf tuerklopfer"||
     str=="an klopfer"||str=="an tuerklopfer")
    {
      write(BS("Du klopfst mit der blossen Hand auf den Klopfer, "
	       "tust Dir aber nur weh dabei. Man klopft ja auch "
	       "nicht AUF einen Klopfer..."));

      TP->AddHp(-2-random(2));

      return 1;
    }
	
  if(str=="klopfer"||str=="tuerklopfer"||
     str=="mit klopfer"||str=="mit klopfer an tuer"||
     str=="mit tuerklopfer"||str=="mit tuerklopfer an tuer")
    {
      write(BS("Durch Dein Klopfen ertoent ein dumpfes BUMM und Du wartest "
	       "erst einmal.")+"\n");

      say(BS(TPN+" klopft heftig an die Tuere und wartet erst einmal."), 
	  ({TP}));
      
      if(find_call_out("tuercheck")==-1) 
	call_out("tuercheck", 2, TP, 1);

      return 1;
    }

  return 0;
}

void tuercheck(object pl, int i)
{
  //Wenn Person schon rausgegangen ist keine Meldung...
  if(!present(pl)) return;

  switch(i)
    {
    case 1:
      {
 	tell_object(pl,"Du wartest...\n");
	//tell_room(this_object(),capitalize etc...,({pl}));
	break;
      }	
      
    case 2:
      {	
	tell_object(pl, "\n\nDu stehst Dir die Fuesse in den Bauch...\n");
	//tell_room(this_object(),capitalize(this_player()->name
	//+" steht sich die Fuesse in den Bauch...\n");
	break;
      }
	
    case 3:
      {	
	tell_object(pl, "\n\nOb da ueberhaupt jemand zu Hause ist?\n");
	//tell_room(this_object(),capitalize(this_player()->name
	//+" steht sich die Fuesse in den Bauch...\n");
	break;
      }
	
    case 4:
      {
	tell_object(pl, 
	    BS("Du drehst Dich gerade um und willst gehen, als Du "
	       "ein Knarren hoerst. Endlich geht die Tuere langsam auf "
	       "und eine Frau erscheint in der Tuere. Sie mustert Dich "
	       "eingehend und laesst Dich dann wortlos eintreten."));

	pl->move(ROOM "arbeitsz", M_GO, "in Shardins Arbeitsraum");

	return;
      }
      
    default: return;
    }

  i++;
  
  call_out("tuercheck", 4, pl, i);

  return;
}
