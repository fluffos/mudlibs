/*
***********************************************
** 0101.c               		      *
** Gang zur Hoehle			      *
** date: 10.02.1998     		      *
***********************************************
*/

inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../def.h"


create()
      {
        ::create();


        SetProp( P_INT_SHORT, "Ein schmaler Gang" );
        SetProp( P_INT_LONG, 
	      "Du befindest Dich in einem schmalen, finsteren Gang. "
		+"Schoen langsam ueberlegst Du Dir, ob die Entscheidung "
		+"richtig war diese Hoehle zu betreten. Von der Decke "
		+"haengen spitze Felszacken herunter und du musst "
		+"aufpassen das du dir nicht den Kopf anstoesst. "
		+"Selbst der Boden ist hart und felsig und es bereitet "
		+"Dir Muehe voranzukommen. Am Ende des Ganges kannst Du "
		+"eine Weggabelung erkennen.\n");

        SetProp( P_LIGHT, 0 );
        SetProp( P_INDOORS, 1 );
	SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
	
	AddDetail("hoehle", QueryProp(P_INT_LONG) );

	AddDetail("gang",
		  "Der Gang ist wirklich finster und ohne einer "
		  +"Lichtquelle waerst Du hier wohl verloren da Du "
	     	  +"staendig darauf achten musst das Du Dich an den "
	     	  +"scharfen Kanten der Felsen nicht verletzt.\n");
	  
	AddDetail( ({"licht","lichtquelle"}), 
		"Wenn Du keine mithaettest koenntest Du dieses "
		  +"Detail gar nicht untersuchen!\n");

	AddDetail( ({"detail","details"}),
		"Konzentrier Dich lieber auf die wichtigen Details!\n");

	AddDetail( ({"kante","kanten"}),
		"Vorsichtig beruehrst Du eine der Kanten. Der Stein "
		  +"ist hart und kalt und Du fragst Dich wer oder was "
		  +"hier wohl leben koennte. Ein Schauer faehrt durch "
		  +"Deinen Koerper.\n");
	
	AddDetail("schauer",
		"Eigentlich willst Du gar nicht wissen wer oder was "
		  +"hier wohnt. Angst steigt in Dir empor.\n");

	AddDetail("angst",
		"Wenn Du keine hast kannst du ja weitergehen.\n");
		  
	AddDetail( ({"koerper","statur"}),
		"Vielleicht solltest Du noch etwas trainieren, bevor "
		  +"Du Dich weiter in die Hoehle wagst!\n");

	AddDetail( ({"stein","gestein"}),
		BS("Du glaubst das es sich hier um Schiefer handelt, bist "
		  +"Dir aber nicht ganz sicher.\n"));

	AddDetail("schiefer",
		BS("Beim genauern hinsehen erkennst Du die typischen "
		  +"Merkmale von Schiefer und fuehlst Dich in Deiner "
		  +"Theorie bestaetigt.\n"));

	AddDetail( ({"merkmal","merkmale","platte","platten"}),
		BS("Schiefer ist ein in duennen, ebenen Platten brechendes "
		  +"Gestein.\n"));
		
	AddDetail("theorie",
		BS("Du hattest doch hoffentlich eine und hast nicht nur "
		  +"geraten!!.\n"));
		
	AddDetail( ({"wand","waende"}),
		BS("Die Waende sind mit Rissen und Spalten durchzogen "
		  +"und es bilden sich abstrakte Formen. Spitze Zacken "
		  +"heben sich von der Wand ab und Du kannst eigentlich "
		  +"keine glatte Flaeche erkennen.\n"));
	
	AddDetail( ({"riss","risse","spalt","spalten","spalte"}),
		BS("Die ganze Wand ist damit durchzogen. Du kannst aber "
		  +"sonst nichts besonderes daran erkennen.\n"));
		  	
	AddDetail( ({"form","formen","schauspiel","natur"}),
		BS("Selten zuvor hast Du solch ein Schauspiel der Natur "
		  +"gesehen.\n"));
		
	AddDetail("zacken",
		BS("Sowohl von der Decke als auch von den Waenden "
		  +"stehen immer wieder spitze Zacken hervor und "
		  +"erschweren Dein vorankommen.\n"));
	
	AddDetail( ({"flaeche","flaechen"}),
		BS("Da die Wand mit keine Flaechen hat siehst du jetzt "
		  +"auch keine.\n"));
		 
	
	AddDetail("decke",
		BS("Da dieser Gang nicht sehr hoch ist hast Du kein "
		  +"Problem die Decke genau zu erkennen. Viele spitze "
		  +"Zacken haengen herunter und ab und zu befinden sich "
		  +"kleine Spinnennetze dazwischen.\n"));

	AddDetail( ({"netz","netze","spinnennetze","spinne","spinnen"}),
		BS("Du hoffst sehr das sich hier keine Spinnen befinden.\n"));

	AddDetail("boden",
         	BS("Selbst der Boden ist hart und felsig. Beim genaueren "
        	  +"untersuchen glaubst du Schleifspuren zu erkennen. "
		  +"Irgendetwas kommt Dir hier merkwuerdig vor.\n"));
			
	AddDetail( ({"spur","spuren","schleifspuren"}),
         	BS("Jetzt weisst Du was hier nicht stimmt. Der Boden "
        	  +"hat lange nicht soviel spitze Kanten und Zacken "
	 	  +"wie die Wand oder die Decke. Dir kommt es so vor "
		  +"als haette ein grosses Tier hier seine Beutestuecke "
		  +"hereingezogen und dadurch den Boden glattgeschliefen.\n"));

	AddDetail("tier",
         	BS("Sei froh das es gerade nicht hier ist!\n"));
        	 
	AddDetail( ({"beute","beutestuecke"}),
         	BS("Vielleicht solltest Du Dich beeilen damit es Dir " 
        	  +"nicht auch so ergeht!\n"));

	AddDetail("kopf",
         	BS("Pass nur auf das Du ihn hier nicht verlierst!\n"));

	AddDetail("muehe",
         	BS("Du kommst nur sehr langsam voran.\n"));

	AddDetail("entscheidung",
         	BS("Schoen langsam steigen Zweifel in Dir auf ob Du "
        	  +"ueberhaupt noch weitergehen willst.\n"));

	AddDetail("zweifel",
         	BS("Du laesst Dir auch alles einreden oder?\n"));
		 
	AddDetail("ende",
         	BS("Dort siehst Du die Weggabelung.\n"));

	AddDetail("weggabelung",
         	BS("Hier teilt sich der Gang und es bilden sich zwei "
        	  +"Hoehlen. Du kannst komische Geraeusche hoeren und "
		  +"es kommt auch ein eigenartiger Geruch aus den Hoehlen. "
		  +"Du kannst aber nicht genau sagen aus welcher.\n"));
		  
	AddDetail( ({"geraeusch","geraeusche"}),
         	BS("Normalerweise lauscht man jetzt!\n"));
        
	AddDetail("geruch",
		BS("Normalerweise riecht man jetzt!\n"));	  

	AddDetail("ueberreste",
		BS("Du siehst sie nicht sondern glaubst nur sie zu riechen."));
	
	AddSound (({"geraeusch","geraeusche"}),
   		BS("Du kannst das Geraeusch nicht zuordnen aber "
	  	  +"es macht Dir Angst und Du willst nur noch "
		  +"raus hier.\n"));   
	
	AddSmell("geruch", 
		BS("Riecht das nicht nach halbverwesten Ueberresten?"));
	
	
AddExit( "raus", ROOM+"0100.lpc" );
AddExit( "nordwesten", ROOM+"0102.lpc" );
AddExit( "suedwesten", ROOM+"0103.lpc" );
}