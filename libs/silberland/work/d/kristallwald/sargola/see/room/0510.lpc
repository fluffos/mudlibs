#include "../def.h"

inherit "std/room";

#define ANSCHLUSS "/d/kristallwald/protheg/quelle/room/aufstieg"

int quest_schwimmen(string str, object ob);
schwimmen1();
schwimmen2();
schwimmen3();

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Im Gebirge von Almandin");
  SetProp(P_INT_LONG, 
	   BS("Du stehst auf einem ansteigenden Weg, der nach Westen ins "
	      "Gebirge fuehrt. Hier ist alles nicht mehr so kristallin, wie "
	      "im Tal unter Dir. Im Osten unter Dir liegt der See umrandet "
	      "vom Kristallwald. Ein Hoehleneingang faellt Dir etwas weiter "
	      "weg vom Weg auf. Weiters steht hier ein hoelzernes Schild."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail(({"schild","holzschild","wegweiser"}),
	    "Das Schild scheint ein Wegweiser zu sein, denn darauf ist ein "
	    "grosser Pfeil gemalt, der zu dem Hoehleneingang zeigt und "
	    "darunter steht\n\"Zur Heilerin Shardin\".");

  AddReadDetail(({"schild","holzschild","wegweiser"}),
		"Auf dem Schild steht \"Zur Heilerin Shardin\".");

  AddDetail(({"pfeil"}),
	    "Der Pfeil deutet zum Hoehleneingang hinueber.");
  
  AddDetail(({"shardin","heilerin"}),
	    "Wer das wohl ist?");

  AddDetail(({"tal"}), 
	    "Es breitet sich in Richtung Osten unter Dir malerisch aus.");

  AddDetail(({"oberflaeche"}), 
	    "Du kannst sie von hier aus nicht so gut sehen.");

  AddDetail(({"gebirge"}), 
	    "Es erhebt sich weiter im Westen.");

  AddDetail(({"eingang","hoehleneingang"}), 
	    "Er fuehrt direkt in den Berg und wirkt dunkel und bedrohlich.");

  AddDetail("berg",
	    "Der Berg wirkt erdrueckend von hier.");
  
  AddDetail(({"pfad","weg"}), 
	    "Er wird gen Westen hin immer steiler und ist ausserdem teilweise "
	    "durch eine Geroellawine versperrt.");

  AddDetail(({"lawine","geroell","geroellawine","geroelllawine"}),
	    "Scheinbar hat sich Jemand die Muehe gemacht und Teile des "
	    "Weges freigelegt..."); 
  
  AddDetail("boden", 
	    "Du befindest Dich auf einem Pfad, der nach Westen ansteigend "
	    "ins Gebirge fuehrt und nach Osten hinunter in das Tal. Hier "
	    "merkt man recht wenig vom kristallenen Charakter.");
  
  AddDetail("himmel", 
	    "Kleine Wolken ziehen ueber Dir vorbei.");
  
  AddDetail("wolken", 
	    "Herrliche Schaefchen-Wolken praegen das Firmament.");

  AddDetail("schaefchenwolken", 
	    "Das sind die, welche wie Daunenkissen aussehen "
	    "gutes Wetter vorhersagen, oder...?");

  AddDetail("wetter", 
	    "Es ist einfach herrlich!");
  
  AddDetail("firmament", 
	    "Es wird nur im Westen vom Gebirge und sonst vom Wald begrenzt.");
  
  AddDetail(({"kristallwald","wald", "waelder"}), 
	    "Du siehst im Norden hinter dem See Waelder, "
	    "aber auch im Sueden wachsen die typischen Kristalleichen.");

  AddDetail(({"eiche", "eichen","kristalleichen","kristalleiche"}), 
	    "Du hast doch schon so viele davon gesehen...");       
  
  AddDetail(({"blumen", "blume"}), 
	    "Alle moeglichen Sorten von Blueten mit roten, gelben und "
	    "orangen Blueten findest Du hier ebenso wie Farne.");

  AddDetail(({"welle","wellen"}), 
	    "Die Wellen schlagen sanft am Ufer auf.");

  AddDetail("wiese", 
	    "Ein gemuetlicher Platz, um auszuspannen."); 

  AddDetail("see", 
	    "Der See liegt oestlich im Tal. Seine Oberflaeche funkelt sanft.");
  
  AddSound(({"wind",DEFAULT_SOUND}), 
	   "Leise pfeift der Wind.\n");
  
  AddSmell(DEFAULT_SMELL, 
	   "Du ziehst die frische Bergluft in Deine Nase.\n");
  
  AddCmd(({"betret", "betrete", "betritt"}), "betrete");
  
  AddExit("ostunten", ROOM "0610");
  AddExit("westoben", ([EX_DEST:ANSCHLUSS, EX_MSG:"ins Gebirge"]));
}

nosave int betrete(string str)
{
  notify_fail(BS("Was willst Du denn betreten?"));
  if(!str) return 0;
  
  if(str=="in hoehle"||str=="hoehle")
    {
      TP->move(ROOM "s_0306", M_GO, "verschwindet in die Hoehle");
      return 1;
    }

  return 0;
}
