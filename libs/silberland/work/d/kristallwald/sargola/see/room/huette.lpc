#include "def.h"

inherit "std/room";

#define ANSCHLUSS "/d/kristallwald/sargola/dorf/room/1315"
#define DOLCH "/d/kristallwald/sargola/see/obj/dolch"

nosave int kiste_voll;
nosave int kiste_offen;

string kiste();

void create()
{
  ::create();
  
  kiste_voll  = 1;
  kiste_offen = 0;
  
  SetProp(P_INT_SHORT, "Eine schmutzige und unordentliche Huette");
  SetProp(P_INT_LONG, 
	   BS("Es ist recht dunkel hier, das Licht dringt spaerlich durch die "
	      "Tuer. Trotzdem kannst Du die Unordnung erkennen. Waffen, Esse"
	      "nsreste und Beutestuecke liegen ueberall verteilt."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);

  AddDetail("boden", 
	    "Der ist notduerftig mit ein paar Holzplanken aus"
	    "gelegt. Meistens ist er ohnehin mit allerhand Beutestuecken "
	    "bedeckt.");

  AddDetail(({"wand","waende"}),
	    "Die Waende sind aus Holzplanken gezimmert.");

  AddDetail(({"planken","holzplanken","planke","holzplanke"}), 
	    "Sie sind nur auf den nackten Boden gelegt und wackeln beim "
	    "Gehen.");

  AddDetail("decke", 
	    "Die Decke ist, wie alles hier, aus schlecht gezimmerten "
	    "Planken gemacht.");

  AddDetail("geraffel", 
	    "Naja, nichts, was Du brauchen koenntest...");

  AddDetail("ordnung", 
	    "Genau die siehst Du hier nicht!");

  AddDetail(({"verstrebungen","eisenverstrebungen"}), 
	    "Sie verstreben die Kiste derartig, dass Du sie sicher nicht "
	    "mit roher Gewalt aufbrechen kannst.");

  AddDetail("licht", 
	    "Das Licht scheint von der Tuere her und erhellt den Raum.");

  AddDetail(({"tuere","tuer"}),
	    "Die liegt im Norden und fuehrt aus dem Saustall hier raus.");

  AddDetail(({"zeugs","waffen","essensreste","beutestuecke"}), 
	    "Allerhand Geraffel liegt hier herum - aber alles wertloses "
	    "Zeugs.");

  AddDetail("unordnung",
	    "Alles liegt am Boden verteilt und ohne eine "
	    "offensichtliche Ordnung. Dir faellt eine Kiste auf.");

  //AddDetail("kiste","Die Kiste scheint aus robustem Holz mit Eisenver"
  //   +"strebungen zu sein. Auf der Vorderseite befindet sich ein "
  //   +"stabiles, grosses Schloss. Probier doch mal, sie zu "
  //   +"oeffnen!");

  AddDetail("kiste", CLOSURE(kiste));

  AddDetail("holz", 
	    "Das Holz ist leider nirgends morsch.");

  AddDetail("schloss", 
	    "Scharf folgerst Du: Da muss ein Schluessel rein!!");

  AddDetail("schluessel", 
	    "Tja! So leicht ist es nun auch wieder nicht...");

  AddDetail("vorderseite", 
	    "Das ist die vordere Seite der Kiste.");

  AddDetail("saustall",
	    "Anders kann man das nicht bezeichnen!");
        
  AddCmd(CMD_OEFFNEN, "oeffne");
  AddCmd(({"knacke","knack"}), "knacke");
  AddCmd(({"breche","brich"}), "brich");
  AddCmd(({"sperre", "sperr", "schliesse", "steck","stecke"}), "sperr");

  AddExit("raus", ANSCHLUSS);
}

string kiste()
{
  if(kiste_offen)
    return BS("Die Kiste scheint aus robustem Holz mit Eisenverstrebungen zu "
	      "sein. Auf der Vorderseite befindet sich ein stabiles, grosses "
	      "Schloss. Bei genauem Untersuchen der Kiste stellst Du fest, "
	      "dass sie schon offen und leider auch leer ist.");

  return BS("Die Kiste scheint aus robustem Holz mit Eisenverstrebungen zu "
	    "sein. Auf der Vorderseite befindet sich ein stabiles, grosses "
	    "Schloss. Probier doch mal, sie zu oeffnen.");
}

nosave int oeffne(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");
  if(!str) return 0;
   
  if(kiste_offen)
    return notify_fail(BS("Die Kiste ist doch schon offen!")), 0;

  if(str[0..4]=="kiste")
    if(!objectp(deep_present("\nquestschluessel", TP)))
      return write(BS("Du versuchst mit aller Kraft den Deckel zu heben - "
		      "aber er ruehrt sich keinen Millimeter! Vielleicht "
		      "gibt es ja einen Schluessel zum Aufsperren...")), 1;
    else
      return write(BS("Du kannst auch nach dem Aufbieten aller "
		      "Deiner Kraefte die Kiste nicht aufbringen. "
		      "Sperr die Kiste doch einfach auf!")), 1;

  return 0;
}

nosave int knacke(string str)
{
  notify_fail("Was moechtest Du knacken?\n");
  if(!str) return 0;

  if(kiste_offen)
    return notify_fail(BS("Die Kiste ist doch schon offen!")), 0;
   
  if(str[0..4]=="kiste")
    return write(BS("Du hast doch nichts, womit man Kisten knacken "
		    "koennte...Haettest Du bloss den Schluessel...")), 1;
  
  return 0;
}

nosave int brich(string str)
{
  notify_fail("Was moechtest Du denn aufbrechen?\n");
  if(!str) return 0;

  if(kiste_offen)
    return notify_fail(BS("Die Kiste ist doch schon offen!")), 0;
   
  if(str[0..4]=="kiste")
    return write(BS("Du hebelst mit allem, was Du hast, doch der Deckel "
		    "sitzt fest. Ein Schluessel koennte Dir helfen...")), 1;
  
  return 0;
}

nosave int sperr(string str)
{
  object ob;
  int check;

  notify_fail("Was moechtest Du denn aufsperren?\n");
  if(!str) return 0;

  if(kiste_offen)
    return notify_fail(BS("Die Kiste ist doch schon offen!")), 0;
   
  if(str=="kiste"||str=="kiste auf"||
     str=="schluessel in schloss"||str=="schluessel in das schloss")
    if(deep_present("\nquestschluessel",TP))
      if((kiste_voll) && present("\neesthilquest", TP))
	{
	  write(BS("Du nimmst den Schluessel, und siehe da: er passt "
		   +"genau! Du findest einen Dolch und so an die 3000 "
		   +"Muenzen."));
	  
	  ob=clone_object(DOLCH);
	  
	  if(ob->move(TP, M_GET)==ME_TOO_HEAVY)
	    {
	      write(BS("Du kannst den Dolch nicht mehr tragen! Und laesst ihn "
		       "daher in der Kiste liegen."));
	      ob->remove(1);

	      return 1;
	    }
	  
	  TP->AddMoney(2900+random(200));
	  
	  kiste_voll=0;
	  kiste_offen=1;
	  
	  ob=deep_present("\nquestschluessel",TP);
	  ob->remove(1);
	  
	  return 1;
	}
      else
	{
	  write(BS("Die Kiste ist leer..."));
	  
	  ob=deep_present("\nquestschluessel",TP);
	  ob->remove(1);
	  
	  return 1;
	}
    else
      return write(BS("Du hast ja keinen Schluessel mit, der passen wuerde!")),
	1;
  
  return 0;
}

void reset()
{
  kiste_voll = 1;
  kiste_offen=0;

  ::reset();
} 

