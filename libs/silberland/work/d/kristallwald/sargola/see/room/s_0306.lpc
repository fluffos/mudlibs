#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:13]));
  
  SetProp(P_INT_SHORT, "Die 100 Hallen der Shardin");
  SetProp(P_INT_LONG,
	   BS("Du stehst im vorderen Teil der Hoehle. Sie ist grob aus dem "
	      "Stein gehauen und fuehrt weiter ins Innere des Berges. Die "
	      "Decke ist recht niedrig und der Wind pfeift von draussen "
	      "herein. Hier war sicher schon seit langer Zeit keiner "
	      "mehr. Der Boden kommt Dir seltsam vor."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  
  AddDetail(({"wand","waende","stein"}),
	    "Grauer, rauher Stein...");
  
  AddDetail(({"innere","berg"}),
	    "Das Innere eines Berges ist wohl eine Hoehle, oder?");
  
  AddDetail("hoehle",
	    "Die Hoehle ist grob gehauen und wirkt bedrohlich. Vielleicht "
	    "schaust Du schnell wieder, dass Du raus kommst.");
  
  AddDetail("boden", 
	    "Der Boden ist uneben und steinig. Eine Schicht von Staub bedeckt "
	    "ihn. Ist da nicht eine Erhebung mitten am Weg?");
  
  AddDetail("weg",
	    "Ein staubiger Weg fuehrt ins Innere des Berges. Eine kleine "
	    "Erhebung faellt Dir auf.");
  
  AddDetail("erhebung", 
	    "Tatsaechlich! Du wischst den Staub weg und hast eine in den "
	    "Boden eingelassene Tafel vor Dir. Du kannst sie lesen.");
  
  AddDetail("tafel",
	    "Du kannst sie lesen.");
  
  AddReadDetail("tafel", 
		"Waehle den Weg, den andere schon beschritten!");
  
  AddDetail(({"schicht", "staubschicht","staub"}),
	    "Hier war schon laenger niemand...");
  
  AddDetail(({"decke"}), 
	    "Die Decke haengt unregelmaessig herunter - Du musst aufpassen, "
	    "dass Du Dir nicht den Kopf stoesst!");
  
  AddDetail(({"kopf"}), 
	    "Ja, Du bist Dir sicher - es ist Dein Kopf.");
  
  AddDetail("wind",
	    "Den kann man nicht untersuchen!");
  
  AddDetail("zeit",
	    "Zeit - wie willst Du die denn untersuchen?");
  
  AddSmell(DEFAULT_SMELL, 
	   "Vom Inneren der Hoehle dringt ein eigenartiger Mief hierher.");
  
  AddSmell("mief",
	   "Na sowas! Das riecht wie - nun ja - Mief!");
  
  AddSound(DEFAULT_SOUND, 
	   "Nur das Pfeifen des Windes hoerst Du hier.");
  
  AddSmell("staub", 
	   "HUST! Am Staub riechen! Was fuer eine Idee!");
  
  AddExit("raus", ROOM "0510");
  AddExit("westen", ROOM "s_0305");
}
