#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));
  
  SetProp(P_INT_SHORT, "In Shardins Arbeitszimmer");
  SetProp(P_INT_LONG, 
	  BS("Du stehst in einem angenehm warmen Zimmer. Links siehst Du "
	     "einen Buecherschrank mit alten und vor allem dicken Buechern, "
	     "in der Mitte steht ein grosser Tisch, auf dem allerhand "
	     "Kraeuter und Zutaten liegen."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  
  AddDetail(({ "handschrift" }), 
	    "Ohne die Hilfe eines Zwergs hat Shardin die Hoehle "
	    "sicher nicht geschaffen.");

  AddDetail("hoehle",
	    "Du stehst in der Hoehle.");

  AddDetail(({ "zaubertrank", "zaubertraenke" }), 
	    "Du suchst alles ab - hier ist keiner!");

  AddDetail(({ "werk", "werke", "magiewerk", "magiewerke" }), 
	    "Du verstehst sie ohnehin nicht.");

  AddDetail(({ "mief", "gang", "gaenge" }), 
	    "Die kennst Du wirklich schon.");

  AddDetail(({ "labyrinth", "irrgarten" }), 
	    "Davon hast Du genug - die dunklen Gaenge, der Mief....");

  AddDetail("zimmer", 
	    "Obwohl es tief im Berg liegen muss, fuehlst Du Dich hier wohl.");

  AddDetail("berg", 
	    "Sicher bist Du tief unter ihm.");

  AddDetail(({"schrank", "buecherschrank"}), 
	    "Du laesst die Buecher lieber stehen - wer weiss, wie Shardin "
	    "darauf reagiert.");

  AddDetail(({"buch","buecher"}), 
	    "Magiewerke vermutest Du.");

  AddDetail(({"holztisch","tisch"}), 
	    "Ein grosser, stabiler Holztisch befindet sich im Zentrum "
	    "des Zimmers.");

  AddDetail("zentrum", 
	    "Da steht der Tisch.");

  AddDetail("mitte", 
	    "Du siehst eine seltsame Apparatur stehen.");

  AddDetail("apparatur", 
	    "Du kannst nicht erkennen, was es sein soll...");

  AddDetail("kraeuter", 
	    "Das meiste ist Dir unbekannt - Du bist ja auch kein Heiler.");

  AddDetail("zutaten", 
	    "Du vermutest, dass hier Zaubertraenke gebraut werden...");
  
  AddDetail("boden", 
	    "Der Boden ist sauber mit Holzbrettern ausgelegt.");

  AddDetail(({"holz","holzbrett","holzbretter","bretter"}),
	    "Die Bretter sind aus weisslichem Holz und genau geschnitten und "
	    "verlegt.");

  AddDetail("berg", 
	    "Sicher bist Du tief unter ihm..");

  AddDetail(({"wand","waende"}),
	    "Die Waende sind glatt und mit wirklicher Liebe aus dem Berg "
	    "gearbeitet.");

  AddDetail("liebe",
	    "An den glatten Waenden erkennst Du die Hingabe, mit der hier "
	    "gearbeitet wurde.");

  AddDetail("hingabe", 
	    "Beachte doch nur mal die Waende!");         	

  AddDetail("decke", 
	    "Sie ist ordentlich glatt gearbeitet - deutlich die Handschrift "
	    "eines begabten Zwergs.");

  AddDetail("zwerg", 
	    "Nur Zwerge koennen so schoen gearbeitete Raeume schaffen.");

  AddDetail(({"raum","raeume"}), 
	    "Du stehst in ihm.");
  
  AddDetail(({"tuer", "tuere"}), 
	    "Es ist eine robutste Eichentuere, die in schweren Angeln "
	    "haengt.");

  AddDetail(({"angel", "angeln"}), 
	    "Sie sind so robust, dass Du es sicher nicht schaffen wuerdest, "
	    "sie einzutreten.");
  
  AddItem(NPC "shardin", REFRESH_DESTRUCT);     
  
  AddExit("osten", ROOM "vorraum");
}
