inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/kristallwald/sargola/def_kristall.h"

int ist_tier_da;

      create()
      {
        ::create();

     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:20]) );
     

   ist_tier_da = 1;

     
        SetProp( P_INT_SHORT, "Ein Waldweg" );
        SetProp( P_INT_LONG, 
      BS("Du befindest Dich auf einem Waldweg. Er macht hier einen scharfen Knick nach "
      +"suedwesten. Der Wald wird hier ziemlich dicht und du bist froh, den Weg "
      +"so klar vor Dir zu sehen.") );
     
        SetProp( P_LIGHT, 1 );
        SetProp( P_INDOORS, 0 );
    
	AddDetail("knick", BS("Die Richtung des Weges aendert sich hier."));
   AddDetail (({"weg","waldweg"}), BS("Links und rechts saeumen Baeume den Weg, kleine "
	+"Steine liegen auf dem Boden und die Sonne scheint durch das Blaetterdach."));
   AddDetail("sonne", BS("Sie kaempft sich tapfer durch die Blaetter."));
   AddDetail( ({"blatt","blaetter","blaetterdach"}), BS("Fast glaeserne Blaetter "
	+"wachsen ueber Dir."));

        AddDetail( "boden", BS("Der Boden besteht aus niedergetretenen Erde.\n"));
   AddDetail ("erde", BS("Sie ist trocken und hart.\n"));
       AddDetail( "himmel", BS("Den Himmel kannst Du nur mehr ueber dem Dach der Baeume "
      +"erahnen.")   );

       AddDetail( ({"kristallwald","wald"}), BS("Du stehst genau drin.")   );
       
        
      
   AddSound (DEFAULT_SOUND, BS("Du kannst nichts besonderes Hoeren."));
   
   AddSmell(DEFAULT_SMELL, BS("Die Pflanzen sind leider geruchslos."));



        AddExit( "suedwesten", ROOM_SEE+"1113.lpc" );

        AddExit( "nordosten", ROOM_SEE+"1311.lpc" );

      }

