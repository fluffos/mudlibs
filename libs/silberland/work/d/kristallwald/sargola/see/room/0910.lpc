#include "../def.h"
#include "see.h"

inherit "std/room";

#define DIR_VON "osten"
#define DIR_BIS "nordwesten"
#define SCHWIMMEN_TEXT_ICH "Hier am Ufer liegen viele spitze Steine. Du beschliesst, doch nicht Schwimmen zu gehen. Die zarte Haut Deiner Fussohlen koennte aufgerauht werden!"
#define SCHWIMMEN_TEXT_ANDERE " geht auf Grund der vielen spitzen Steine am Ufer doch nicht schwimmen."

int quest_schwimmen(string str, object ob);
schwimmen1();
schwimmen2();
schwimmen3();

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:18]));
  
  SetProp(P_INT_SHORT, "Seepromenade");
  SetProp(P_INT_LONG, 
	   BS("Du gehst die Promenade am See entlang, die nach "+CAP(DIR_BIS)+
	      " und "+CAP(DIR_VON)+" fuehrt. Das Ufer ist hier ziemlich "
	      "steinig. Noerdlich liegt der See von Rhondonit und "
	      "im Westen erhebt sich das Almandin-Gebirge."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddDetail(({"promenade","seepromenade"}), 
	    "Sie fuehrt im Westen auf eine kleine Halbinsel und geht im "
	    "Osten weiter.");

  AddDetail("halbinsel", 
	    "Geh doch hin und sieh sie Dir an.");
  
  STANDARD1
  STANDARD2
  GEBIRGE_FERN
    
  AddCmd(({"bade", "baden", "schwimme", "schwimmen"}), "baden_gehen");
  AddCmd(({"springe", "spring"}), "springe");

  AddExit("osten", ROOM "1010");
  AddExit("nordwesten", ROOM "0809");
}

SCHWIMMEN
