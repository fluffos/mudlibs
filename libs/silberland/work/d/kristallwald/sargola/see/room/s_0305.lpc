#include "../def.h"

inherit "std/room";

#include "hallen.h"

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:13]));
  
  SetProp(P_INT_SHORT, "Die 100 Hallen der Shardin");
  SetProp(P_INT_LONG, 
	  BS("Pass auf, dass Du Dich nicht verlaeufst. Du stehst in einer "
	     "kleinen Halle, die Decke ist recht niedrig und es herrscht ein "
	     "starker Mief hier drin. In alle vier Himmelsrichtungen gehen "
	     "Gaenge, die zu weiteren Hallen fuehren. Alles sieht hier "
	     "gleich aus. Hier war sicher schon seit langer Zeit Keiner "
	     "mehr."));
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);

  HALLEN
  KEINE_SPUREN    
     
  AddExit("norden", ROOM "s_0405");
  AddExit("osten" , ROOM "s_0306");
  AddExit("sueden", ROOM "s_0205");
  AddExit("westen", ROOM "s_0305");
}
