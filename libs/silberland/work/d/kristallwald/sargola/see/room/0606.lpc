#include "../def.h"
#include "see.h"

inherit "std/room";

#define DIR_VON "suedwesten"
#define DIR_BIS "nordosten"
#define SCHWIMMEN_TEXT_ICH "Autsch! Die spitzen Steine haettest Du vorher beachten sollen."
#define SCHWIMMEN_TEXT_ANDERE " schneidet sich an den spitzen Steinen."


int quest_schwimmen(string str, object ob);
void schwimmen1();
void schwimmen2();
void schwimmen3();

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:18]));
     
  SetProp(P_INT_SHORT, "Am See von Rhondonit");
  SetProp(P_INT_LONG, 
	  BS("Du stehst am Ufer vom See von Rhondonit und kannst am Ufer "
	     "entlanggehen. Im Westen ragt das Almandin-Gebirge in die "
	     "Hoehe. Eine angenehme Ruhe ergreift Dich. Der See ist in "
	     "der Mitte tiefblau - scheint also recht tief zu sein. Im "
	     "Nordosten liegt der Kristallwald. Ein besonders grosser Baum "
	     "ragt im Norden aus dem Wald."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  STANDARD1
  STANDARD2
  GEBIRGE_NAH
  
  AddDetail("ufer",
	    "Am Ufer liegen nur spitze Steine herum. Das Wasser plaetschert "
	    "leise gegen das Ufer.");
  AddDetail("steine",
	    "Hmm, einfach spitze Steine. Sonst nix.");
  
  RemoveDetail("boden");
  
  AddDetail("boden",
	    "Der Boden ist mit einer Art Wiese bedeckt. Die Erde ist hier "
	    "aus irgendeinem Grund besonders locker. Im Norden wachsen "
	    "viele Blumen und Farne. Zum Ufer hin geht die Wiese in Steine "
	    "ueber. Weiters siehst Du einen Weg am Ufer entlang.");

  AddDetail("erde",
	    "Hmm, hier koennte man sicher leicht ein Loch graben.");
  
  AddCmd(({"grab","grabe","buddel","buddle","buddele"}), "grabe");
  AddCmd(({"lege","leg","wirf"}), "lege");
  AddCmd(({"bade", "baden", "schwimme", "schwimmen"}), "baden_gehen");
  AddCmd(({"springe", "spring"}), "springe");
  
  AddExit("suedwesten", ROOM "0507");
  AddExit("nordosten", ROOM "0705");
}

SCHWIMMEN

nosave int grabe(string str)
{
  notify_fail(BS("Was moechtest Du denn graben?"));
  if(!str) return 0;
  
  if(str=="loch"||str=="ein loch")
    if(!present("schaufel", TP))
      return write(BS("Du hast ja nichts zum Graben dabei!")), 1;
    else
      if(present("\nloch"))
	return write(BS("Da hat schon jemand ein Loch gegraben...")), 1;
      else
      {
	write(BS("Du graebst ein wunderschoenes Loch."));

	TP->do_haust(200, 1);
        
	CLONEME(OBJ "loch");
	
	AddExit("runter", ROOM "loch");
	return 1;
      }
  
  return 0;
}

nosave int lege(string str)
{
  object ob;
  
  notify_fail(BS("Was willst Du denn wohin legen?"));
  if(!str) return 0;

  if(strstr(str, "loch")>-1)
    if(!present("\nloch"))
      return write(BS("Worueber willst Du denn etwas legen?")), 1;
  
  if(str=="ast auf loch"||str=="ast auf das loch")
    if(ob=present("ast",TP))
      {
	write(BS("Du legst den Ast sorgfaeltig ueber das Loch. "
		 "Trotzdem sieht man das Loch von weitem."));
	
	if(!present("uast")) CLONEME(OBJ "uast");
	
	ob->remove(1);
	
	return 1;
      }
    else
      return write(BS("Du hast nichts, das Du auf das Loch legen "
		      "koenntest...")), 1;
  
  if(str=="blaetter auf loch"||str=="blaetter auf das loch")
    if(present("uast"))
      if(ob=present("blaetter",TP))
	{
	  write(BS("Du trapierst die Blaetter auf dem Ast, doch "
		   "noch immer schimmert das dunkle Loch durch."));

	  if(!present("ublaetter")) CLONEME(OBJ "ublaette");

	  ob->remove(1);
	  
	  return 1;
	}
      else
	return write(BS("Du hast ja keine Blaetter!")), 1;
    else
      return write(BS("Du versuchst, die Blaetter ueber das Loch zu legen..."
		      "Sowas Dummes auch! Die fallen ja ganz rein!")), 1;
    
  if(str=="gras auf loch"||str=="gras auf das loch")
    if(ob=present("gras",TP))
      if(present("uast"))
	if(present("ublaetter"))
	  {
	    write(BS("Du streust noch Grashalme ueber das Ganze und siehe da: "
		     "nun kann man das Loch nicht mehr sehen!"));
	    
	    if(!present("falle")) CLONEME(OBJ "falle");
	    
	    ob->remove(1);
	    present("uast")->remove(1);
	    present("ublaetter")->remove(1);
	    
	    return 1;
          }
	else
	  return write(BS("Du willst das Gras auf den Ast legen, aber die "
			  "Halme fallen in das Loch rein...")), 1;
      else
	return write(BS("Du wirfst das Gras in das Loch rein - toll! Und "
			"jetzt? Glaubst Du, dass der Wuestling freiwillig "
			"in das Loch huepft??")), 1;
    else 
      return write(BS("Wo soll denn das Gras sein, das Du auf das Loch "
		      "legen willst?")), 1;
  
  return 0;
}
