inherit "std/room";

#include <properties.h>
#include <language.h>
#include <player.h>
#include <moving.h>
#include "../../files.h"

int goldnugget;


void create()
{
  ::create();
  goldnugget = 1;
 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT,
		 "Eine Hoehle"
	 );
  SetProp( P_INT_LONG,BS(
		 "Hier schuerfen die Zwerge nach Gold und den anderen Schaetzen "
	 +   "der Erde. Die ganze Hoehle ist von Fackeln hell erleuchtet. Der "
	 +   "Boden ist mit Staub und kleinen Steinchen uebersaeht. Hier und da "
	 +   "vermeinst du ein goldenes Funkeln zu erkennen. Ein kleiner, "
	 +   "schmaler Spalt fuehrt weiter nach Osten. Dort haben sich die Zwerge "
	 +   "weitergearbeitet, und von dort kommt auch das ohrenbetaeubende "
	 +   "Klopfen.\n")
		 );


  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  AddDetail ( ({"raum", "hoehle", "felshoehle"}),BS(
		 "Die Hoehle wurde von Zwergen aus dem Fels herausgebrochen. Ein "
	 +	 "kleiner Spalt fuehrt nach Osten weiter, woher auch das laute "
	 +	 "Haemmern kommt. Der Spalt ist sehr klein und gehoert schon einiges "
	 +   "an Mut dazu, um da durchzukommen.\n")
		);
  
  AddDetail ( ({"spuren", "schuerfspuren"}),
		 "Die Zwerge graben hier nach Gold.\n"
		);

  AddDetail ( "funkeln",
		 "Hmm ... dieses Funkeln koennte durchaus Gold sein.\n"
		);


  AddDetail ( "gold",BS(
		 "Wenn du nur die richtige Ausruestung haettest, dann koenntest "
	 +   "du durchaus nach Gold graben ...\n")
			);

  AddDetail ( "boden",BS(
		 "Der Boden besteht aus kahlen Fels und ist mit Felsbrocken "
	 +   "uebersaeht.\n")
		);

  AddDetail ( "fels",
		 "Der Fels ist rauh und fuehlt sich kalt an.\n"
		);

  AddDetail ( ({"brocken", "steine", "felsbrocken"}),BS(
		 "Die Felsbrocken sind ganz schoen gross und gefaehrlich kantig. "
	  +  "Du beschliesst mehr aufzupassen, um dir nicht wehzutun.\n")
		);


  AddDetail ("spalt",BS(
		 "Der Spalt geht nach Osten weiter. Wie du ihn so betrachtest bist "
	 +   "du dir sicher: DA wirst du NIEMALS und um nichts in der Welt "
	 +   "durchklettern.\n")
			);

  AddDetail ( "fackeln",BS(
		 "Die Fackeln strahlen ein beruhigendes, warmes Licht und flackern "
	 +   "leicht. Sie sind an Fackelhaltern befestigt.\n")
	 );

  AddDetail ( ({"halter", "fackelhalter"}),BS(
		 "Die Fackelhalter sind fix an der Wand befestigt. In ihnen stecken "
	 +   "Fackeln.\n")
	 );


  AddSound ( DEFAULT_SOUND,
		 "WAS? WAS HAST DU GESAGT?\n"
	 +   "ACHSO, JA, RICHTIG. DAS HAEMMERN HIER IST OHRENBETAEUBEND!\n"
		   );


  AddItem("/d/gebirge/angrox/npc/zarbeit", REFRESH_DESTRUCT);

  AddCmd(({ "grabe", "grab"}), "grabe");
  
  AddExit( "westen", EBENE1("bergwerk_r6.lpc"));


}



reset()
{
    ::reset();
    goldnugget = 1;
}

create_nugget()
{
    object a;
    a = clone_object(OBJ("nugget"));
    return a;
}


grabe( str )
{   

    notify_fail("Nach was willst du graben?\n");
    if (!present("spitzhacke",TP))
      {
       write("Du hast nichts zum Graben dabei.\n");
       return 1;
      }
    if (str == "nach gold")
      {
       if (!goldnugget)
	 {
        write("Du graebst und graebst, findest aber nichts.\n");
        say(TPN+" graebt im Stein, scheint aber nix zu finden.\n");
        return 1;
         }
      
        
          write(
            "Du nimmst die Spitzhacke und beginnst zu graben. Nach\n"
            +"einiger Zeit graebst du einen goldenen Klumpen aus, den du\n"
            +"sogleich einsteckst.\n");
        say(TPN+" beginnt mit einer Spitzhacke zu arbeiten.\n");
          
        nugget_nehmen();
        return 1;
        }
     
    return 0;
}


nugget_nehmen()
  {
    object a;
    int ret;
    a = create_nugget();
    ret = a->move(this_player());
    if (ret == ME_TOO_HEAVY)
    {
      write("Du versuchst den Goldnugget zu nehmen, aber er ist Dir zu "+
      "schwer.\n");
      a->remove();
      return 1;
    }
    else
    {  
     goldnugget = 0;
     return 1;
    }

  }






