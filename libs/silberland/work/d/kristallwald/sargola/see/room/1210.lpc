inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/kristallwald/sargola/def_kristall.h"

int ist_tier_da;

      create()
      {
        ::create();

     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:20]) );
     

   ist_tier_da = 1;     
     
        SetProp( P_INT_SHORT, "Ein Waldweg" );
        SetProp( P_INT_LONG, 
      BS("Hier fuehrt ein breiter, ausgetretener Weg nach Suedosten in "
         +"den Wald rein. Die Sonne scheint froehlich. Der Wald wird "
         +"im Suedosten dichter, und Du bist froh, den Weg klar vor "
         +"Dir zu sehen. Im Nordwesten liegt ein stiller See.") );
     
        SetProp( P_LIGHT, 1 );
        SetProp( P_INDOORS, 0 );
     
   AddDetail( ({"teil","see"}),
   	BS("Du kannst nur einen Teil des Sees von hier aus sehen."));   
   	
   AddDetail("weg",
   	BS("Der Weg ist eben, eine Menge Leute muessen hier "
      	+"schon druebergelaufen sein."));
      	
   AddDetail( ({"menge","leute"}),
   	BS("Der plattgetretenen Erde nach zu schliessen ziemlich viele..."));
   	
   AddDetail("sonne",
   	BS("Du blickst nach oben und wuenscht, dass das Wetter immer so "
   	+"schoen bleibt."));
   	
   AddDetail("wetter",
   	BS("Es ist einfach herrlich!"));
   	
   AddDetail("wald",
   	BS("Weiter im Sueden werden die Staemme wieder dichter."));
   	
   AddDetail( ({"stamm","staemme"}),
   	BS("Weissliche, starke Staemme siehst Du im Sueden."));
   	
   AddDetail( "boden",
   	BS("Der Boden besteht aus niedergetretener Erde. Es scheinen "
   	+"viele Fuesse diesen Weg benutzt zu haben."));
   	
   AddDetail ("erde",
   	BS("Sie ist trocken und hart.")); 
   	
   AddDetail( "himmel",
   	BS("Der Himmel liegt tiefblau ueber Dir. Wenn Du weiter nach "
   	+"Suedosten gehst wirst Du ihn bald nicht mehr bewundern koennen.")); 

   AddDetail( ({"kristallwald","wald"}),
   	BS("Von aussen hat er fast eine majestaetische Schoenheit. Doch "
   	+"genauso schoen wie er ist, so gefaehrlich kann er auch "
      	+"sein.")   );
      	
   AddDetail("schoenheit",
   	BS("Er ist in der Tat ein beeindruckender Wald."));       
        
   AddDetail( ({"blueten","farne"}),
   	BS ("Du bist leider in der Fauna nicht so bewandert.") );
      
   AddSound (({DEFAULT_SOUND,"wellen","gurgeln"}) ,
   	BS("Sanft schlagen die Wellen an das Ufer."));   

   AddSmell( ({"luft","waldluft",DEFAULT_SMELL}),
   	BS("Du riechst nur die reine Waldluft."));

   AddItem(NPC_SEE+"haendler.lpc", REFRESH_DESTRUCT);


   AddExit( "suedosten", ROOM_SEE+"1311.lpc" );

   AddExit( "nordwesten", ROOM_SEE+"1109.lpc" );

}
