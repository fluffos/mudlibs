inherit "std/room";

#include <properties.h>
#include <language.h>

#include "/d/kristallwald/sargola/def_kristall.h"
#include "hallen.h"

#define DIR_ZURUECK	"sueden"
#define DIR_VOR		"norden"


  create()
  {
	::create();

     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:13]) );
     
     
  SetProp( P_INT_SHORT, "Die 100 Hallen der Shardin" );
  SetProp( P_INT_LONG, BS("Du hast Dich wohl komplett verlaufen. Du stehst in "
	+"einer kleinen Halle, die Decke ist recht niedrig und es herrscht ein "
	+"starker Mief hier drin. In alle vier Himmelsrichtungen gehen Gaenge, "
	+"die zu weiteren Hallen fuehren. Hier war sicher schon seit langer Zeit "
	+"kein Mensch mehr.") );
     
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17]) );        
   

  HALLEN
  SPUREN

     
  AddExit( "norden", ROOM_SEE+"s_0403.lpc" );
  AddExit( "osten",  ROOM_SEE+"s_0304.lpc" );
  AddExit( "sueden", ROOM_SEE+"s_0203.lpc" );
  AddExit( "westen", ROOM_SEE+"s_0303.lpc" );
        
     
      }
     
 

