** Nordwestliche Hoehle			      *
** date: 10.02.1998     		      *
***********************************************
*/

inherit "/std/room";
#include "../def.h"
#include "properties.h"
#include "moving.h"

int moos(string str);
string moos_da();

int fleisch(string str);
string fleisch_da();

int moos;
int fleisch;

create()
      {
        ::create();
	
	fleisch = 1;
	moos = 1;

        SetProp( P_INT_SHORT, "In einer Hoehle" );
        SetProp( P_INT_LONG, 
      BS("Die Hoehle in der Du Dich befindest ist wirklich nicht "
	+"gross. Die Waende und die Decke sind noch immer mit "
	+"mit den spitzen Kanten und Zacken durchzogen und Du "
	+"fuehlst Dich hier sehr unwohl. Ein beissender Gestank "
	+"faehrt Dir in die Nase und Du blickst Dich unruhig um.\n"));
	
        SetProp( P_LIGHT, 0 );
        SetProp( P_INDOORS, 1 );
	SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10]));
	
	AddDetail("hoehle",
		BS("Man koennte es auch als Nische bezeichnen, so klein"
		  +"ist die Hoehle. Die Geraeusche sind hier nicht mehr"
		  +"so laut dafuer riecht es vermodert und nach Verwesung.\n"));	
	
	AddDetail( ({"gestank","verwesung"}),
		BS("Riech doch lieber mal dran."));
		 
	AddDetail("geraeusche",
		BS("Wie waers mit lauschen?!?"));
		 
	AddDetail("nische",
		BS("Du kannst es ruhig auch weiterhin Hoehle nennen "
		  +"wenn Dir das besser gefaellt!\n"));

	AddDetail( ({"wand","waende"}),
		BS("Die Hoehle besteht auch hier aus dem selben Gestein und "
		  +"ist noch immer mit scharfen Kanten durchzogen.  "));	
	
	AddDetail( ({"gestein","schiefer","fels"}),
		BS("Auch hier besteht alles aus Schiefer.\n"));

	AddDetail( ({"kante","kanten","zacken","zacke"}),
		BS("Genau wie im Gang davor stehen hier unzaelige Kanten "
		  +"und Zacken aus Wand und Decke. Einen kleinen Unterschied " 
		  +"gibt es aber!\n"));

	AddDetail("unterschied",
		BS("Manche Kanten sind mit einer Schicht Moos ueberzogen."
		  +"Hier duerfte es feuchter sein als im Gang. Vielleicht "
		  +"kommt daher der Gestank?\n"));

	AddDetail("schicht",
		BS("Es ist nur eine kleine Schicht mit Moos.\n"));
	
	AddDetail( ({"stelle","stellen"}),
		BS("An manchen Stellen ist der Fels mit Moos bewachsen. "));
	

	AddDetail("boden",
		BS("Igitt. Als Du Dir den Boden genauer ansiehst, erkennst"
		  +"halbverweste Leichen. Teilweise haengen noch verfaulte "
		  +"Fleischstuecke an den Knochen.\n"));

	AddDetail("knochen",
		BS("Die Knochen sehen aus als waeren sie von grossen Tieren "
		  +"abgenagt worden. Panik steigt in Dir auf bei dem Gedanken "
		  +"das Du hier auch so enden koenntest.\n"));

	AddDetail("panik",
		BS("Du beruhigst Dich langsam wieder den noch ist ja alles in"
		  +"Ordnung. Oder?\n"));

	AddDetail("ordnung",
		BS("Sei Dir da mal nicht so sicher!\n"));
	
	AddDetail("gedanken",
		BS("An so etwas solltest Du nicht denken!!"));
	
	AddSpecialDetail("moos","moos_da");
	AddSpecialDetail("fleisch","fleisch_da");

	AddExit( "suedosten", ROOM+"0101.lpc" );

	AddCmd( ({"nimm"}),"moos");
	AddCmd( ({"iss"}),"fleisch");
}

moos_da()
{
   if(moos == 1)
   {
	return BS("Du siehst Moos an der Wand.");
   }
   else
   {
	return BS("Du siehst eine Stelle, an der einmal Moos gewesen ist.");
   }
}
	


reset()
{
   ::reset();
   moos = 1;
   fleisch = 1;
}


int moos(string str)
{
   object ob;
   int i;

   notify_fail("Was moechtest Du nehmen?\n");

   if(str=="") return 0;

   if(str=="moos" || str=="moos von wand")
   {
	if(moos == 1)
	{

	   tell_object(TP, BS("Du nimmst das Moos.\n"));
	   tell_room(TO, TPN+" nimmt das Moos.\n", ({TP}));
	   TP->heal_self(20);
	   //TP->restore_hit_points(20);
	   //TP->restore_spell_points(20);

	   moos = 0;
	   return 1;
	}
	else
	{
	   tell_object(TP, BS("Da ist kein Moos mehr."));
	   return 1;
	}
   }
}

fleisch_da()
{
   if(fleisch == 1)
   {
	return BS("Vielleicht kannst du es ja essen?.");
   }
   else
   {
	return BS("Hier ist kein Fleisch mehr an den Knochen.");
   }
}
	



int fleisch(string str)
{
   object ob;
   int i;

   notify_fail("Was moechtest Du essen?\n");

   if(str=="") return 0;

   if(str=="fleisch")
   {
	if(fleisch == 1)
	{

	   tell_object(TP, BS("Langsam schluckst du das verfaulte Fleisch hinunter.\n"));
	   tell_room(TO, TPN+" schluckt das verfaulte Fleisch hinunter.\n", ({TP}));
	   TP->heal_self(10);
	   fleisch = 0;
	   return 1;
	}
	else
	{
	   tell_object(TP, BS("Du siehst hier kein Fleisch mehr."));
	   return 1;
	}
   }
   return 0;
}