#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:20]));
  
  SetProp(P_INT_SHORT, "Ein Waldweg");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich auf einem Waldweg der von Straeuchern "
	     "gesaeumt wird. Der Weg verzweigt sich hier in drei "
	     "Richtungen. Der Wald ist ziemlich dicht und Du bist froh, "
	     "den Weg so klar vor Dir zu sehen. Eine kleine Lichtung "
	     "zweigt nach Westen hin ab. ")+
	  BS("Am Wegesrand siehst Du eine Holztafel stehen."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail(({"lichtung"}),
	    "Weiter im Westen scheint eine kleine Lichtung zu liegen...");

  AddDetail(({"rand","wegesrand"}), 
	    "Der Wegesrand wird von Straeuchern gesaeumt.");
  
  AddDetail(({"holztafel","tafel"}), 
	    "Ein verrottetes, durch die Witterung stark mitgenommenes "
	    "Brett ist hier an einen Pflock genagelt. Du kannst sie "
	    "lesen.");
  
  AddDetail("witterung", 
	    "Das Brett ist von der Witterung gezeichnet.");
  
  AddDetail("brett", 
	    "Auf ihm stehen Ortsangaben.");
  
  AddDetail("ortsangaben", 
	    "LIES es doch einfach!");
  
  AddDetail("pflock", 
	    "Auch der Pflock ist in ziemlich schlechtem Zustand.");
  
  AddDetail("zustand",
	    "Er ist ziemlich verwittert und morsch.");
  
  AddReadDetail(({"holztafel","tafel"}), "Du liest : \n\n"
		"     Nordwesten:     See von Rhondonit\n"
		"     Suedwesten:     Elessar\n");
  
  AddDetail(({"waldweg","weg"}), 
	    "Ein typischer Waldweg mit Zweigen, abgefallenen Blaettern und "
	    "Erde.");
  
  AddDetail(({"zweig","zweige"}), 
	    "Trockene Zweige liegen hie und da auf dem Weg.");
  
  AddDetail(({"blatt","blaetter"}), 
	    "Sie bedecken die Erde am Boden.");
  
  AddDetail("boden", 
	    "Der Boden besteht aus niedergetretener Erde.");
  
  AddDetail(({"strauch", "straeucher"}),
	    "Hagebutten, oder doch ein Himbeerstrauch? In solchen Dingen "
	    "warst Du noch nie ein Meister...");
  
  AddDetail(({"himbeerstrauch","hagebutten","hagebuttenstrauch"}),
	    "Hmm... das wirst Du wohl nie erfahren...");
  AddDetail(({"richtungen","richtung", "verzweigung"}),
	    "Der Weg hat hier eine Verzweigung nach Nordwesten, "
	    "Suedwesten und Westen.");
  
  AddDetail("erde",
	    "Sie ist trocken und hart.");
  
  AddDetail("himmel",
	    "Den Himmel kannst Du nur mehr ueber dem Dach der Baeume "
	    "erahnen.");
  
  AddDetail("baeume",
	    "Links und rechts des Weges kannst Du einige davon entdecken.");
  
  AddDetail("dach",
	    "Weit ueber Dir schimmert der Himmel durch die Zweige durch.");
  
  AddDetail(({"kristallwald","wald"}),	
	    "Du stehst genau drin.");
  
  AddSound(DEFAULT_SOUND, "Du kannst nichts Besonderes hoeren.");
  
  AddSmell(DEFAULT_SMELL, "Die Pflanzen sind leider geruchslos.");
  
  AddExit("suedwesten", SEE_DORF);
  AddExit("nordwesten", ROOM "1210");
  AddExit("westen", SEE_LUMIN);
}
