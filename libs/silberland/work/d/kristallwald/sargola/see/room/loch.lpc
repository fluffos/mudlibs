#include "../def.h"

inherit "std/room";

rauf();
int knochen;
string knochen();
clean();

void create()
{
  ::create();
  
  knochen = 1;
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:13]));
     
  SetProp(P_INT_SHORT, "Ein Erdloch" );
  SetProp(P_INT_LONG, 
	  BS("Du stehst in einem feuchten Loch. Um Dich herum ragen die "
	     "Erdwaende in die Hoehe. Wuermer und anderes Getier wurden "
	     "durch das Graben hier aufgescheucht."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_TRANSPARENT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail(({"wurm","wuermer","getier"}),
	    "Igitt! Lass die lieber in Ruhe...");
  AddDetail(({ "loch" }), 
	    "Ein herrliches Loch, um einen Wuestling zu fangen...hehe...");
  
  AddDetail("hoehe", 
	    "Die Waende sind sicher 2 Meter hoch.");

  AddDetail(({"wand","waende","erdwaende","erdwand"}), 
	    "Feuchte, leicht abbroeckelnde Erde, welche mit Wuermern "
	    "durchsetzt ist.");

  AddDetail("erde", 
	    "Du kannst zwei Arten von Erde entdecken. Dunkelbraune, "
	    "feuchte Erde und etwas hellere, fast schon tonartige Erde. Du "
	    "kannst eine Menge Steine, Wurzeln und etwas Eigenartiges "
	    "erkennen.");
  
  AddDetail("eigenartiges", 
	    "Eine halb verwesten Leiche eines Tieres muesste das sein!");
  
  AddDetail(({"tier","leiche"}), 
	    "Sieht aus wie ein Hund oder sowas aehnliches...");

  AddDetail("fuchs", 
	    "Das einzige was noch uebrig und identifizierbar ist, sind "
	    "ein paar Knochen.");
  
  AddDetail("knochen", CLOSURE(knochen));
  
  AddSound(DEFAULT_SOUND, 
	   "Hier drin ist kein Laut zu hoeren.");
  
  AddSmell(DEFAULT_SMELL, 
	   "Du riechst gute, humusreiche Erde.");
  
  AddCmd(({"helfe","hilf","rette"}), "hilf");
  AddCmd(CMD_NEHMEN, "nimm");

  AddSpecialExit("rauf", "rauf");
}

void reset()
{
  ::reset();
  
  knochen = 1;
}

int rauf()
{
  if(TP->QueryProp(P_SIZE)<144)
    return write(BS("Du versuchst wieder aus dem Loch zu klettern, aber "
		    "Du bist zu klein dafuer!! Du musst wohl warten, bis Dir "
		    "jemand hilft...")), 1;
  else
    {
      write(BS("Du kletterst wieder aus dem Loch raus."));
      
      TP->move(ROOM "0606", M_GO);
      
      return 1;
    }
}

nosave int hilf(string str)
{
  object player;
  int align;

  notify_fail(BS("Wem moechtest Du helfen?"));
  if(!str) return 0;

  if(str=="wuestling")
    if(player=present("wuestling"))
    {
      write(BS("Du beschliesst, dem armen Wuestling wieder aus der "
        "Grube zu helfen. Es tut Dir leid, dass Du den armen Kerl "
        "in diese fiese Falle gelockt hast.\n"));

      player->move(ROOM "0606", M_GO, "unten rauf",
           "klettert mit der Hilfe von " +TPN+" von", 
           "kommt mit der Hilfe von "+TPN+" von unten raufgeklettert");

      TP->move(ROOM "0606", M_GO);

      write("Der Wuestling sagt: Du hast ein grosses Herz bewiesen - ich "
           "danke Dir.\nDann macht er eine magische Handbewegung und ein "
           "leichter Schauer durchfaehrt\nDeinen Koerper.\n");

      TP->FindPotion(BS("Zum Dank drueckt Dir der Wuestling ein Flaeschchen "
             "Zaubertrank in die Hand, dass Du sofort austrinkst."));
      
      WLOG(KLOG "zt", "befreit den Wuestling");
      
      align = TP->QueryProp(P_ALIGN);
      
      align>800 ? align = 1000 : align+=200;
      
      TP->SetProp(P_ALIGN, align);
      
      player->befreit();
      
      clean();
      
      return 1;
      
    }
    else
      return write(BS("Aber hier ist gar kein Wuestling.")), 1;
  
  if((player=find_living(str)) && (present(player)))
    if(TP->QueryProp(P_SIZE)>144)
    {
      write(BS("Du hilfst "+CAP(str)+" aus der Grube raus und "
	       "kletterst dann selbst nach oben."));
      
      TP->move(ROOM "0606", M_GO, "nach oben", " hilft "+CAP(str), 
	       "kommt mit der Hilfe von "+TPN+" raufgeklettert");

      player->move(ROOM "0606", M_GO);

      return 1;
    }
    else
      return write(BS("Du bist ja selbst zu klein, um hier wieder "
		      "raus zu kommen!")), 1;
  
  return 0;
}

nosave int nimm(string str)
{
  object kn;

  notify_fail(BS("Was moechtest Du nehmen?"));
  if(!str) return 0;
  
  if(str=="knochen"||str=="den knochen")
    if(knochen)
      {
	kn=clone_object(OBJ "knochen");

	if(kn->move(TP, M_GET)==ME_TOO_HEAVY)
	  {
	    kn->remove(1);
	    return write(BS("Der Knochen ist Dir viel zu schwer...")), 1;
	  }
	
	write(BS("Du nimmst den Knochen und steckst ihn ein."));

	knochen = 0;

	return 1;
      }
    else
      return write(BS("Welchen Knochen denn? Hier ist keiner, der Dir "
		      "nuetzlich erscheint.")), 1;
  
  return 0;
} 

string knochen()
{
  if(knochen)
    return BS("Ein Knochen, sicher so lang wie Dein Unterarm. Er "
	      "ist in gutem Zustand.");

  return BS("Die Knochen sind vom Verrotten unter der Erde ganz "
	    "sproede geworden.");
}

clean()
{
   object ob, room;

   if(!objectp(room=find_object(ROOM "0606"))) return;

   if(ob = present("ublaetter", room))
     if(objectp(ob)) ob->remove();
   
   if(ob = present("ugras", room))
     if(objectp(ob)) ob->remove();
   
   if(ob = present("uast", room))
     if(objectp(ob)) ob->remove();

   if(ob = present("falle", room))
     if(objectp(ob)) ob->remove();

   if(ob = present("\nloch", room))
     if(objectp(ob)) ob->remove();
  
   room->RemoveExit("runter");
}
