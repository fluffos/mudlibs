#include "../def.h"
#include "see.h"

inherit "std/room";

#define DIR_VON "suedwesten"
#define DIR_BIS "suedosten"
#define SCHWIMMEN_TEXT_ICH "Hier am Ufer liegen viele spitze Steine. Du beschliesst, doch nicht Schwimmen zu gehen. Die zarte Haut Deiner Fussohlen koennte aufgerauht werden!"
#define SCHWIMMEN_TEXT_ANDERE " geht auf Grund der vielen spitzen Steine am Ufer doch nicht schwimmen."

int quest_schwimmen(string str, object ob);
schwimmen1();
schwimmen2();
schwimmen3();

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:18]));
  
  SetProp(P_INT_SHORT, "Seepromenade");
  SetProp(P_INT_LONG, 
	   BS("Du stehst auf einer kleinen Halbinsel am See von Rhondonit. "
	      "Das Ufer ist hier ziemlich steinig. Im Westen kannst Du "
	      "das Gebirge von Almandin sehen, hinter dem See im Norden "
	      "liegt der Kristallwald. Der See gurgelt leise."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  STANDARD1
  STANDARD2
  GEBIRGE_FERN
    
  AddDetail(({"seepromenade","promenade"}), 
	    "Die Promenade macht hier einen Knick auf die Halbinsel, auf "
	    "der Du gerade stehst.");
  
  AddDetail("halbinsel", 
	    "Du stehst auf ihr - sie ragt in den See hinein.");
  
  AddDetail("insel",
	    "Das ist keine ganze Insel, sondern eine Halbinsel!");
  
  AddDetail("steine", 
	    "Sie sind ziemlich spitz und bedecken das Ufer.");
  
  AddCmd(({"bade", "baden", "schwimme", "schwimmen"}), "baden_gehen");
  AddCmd(({"springe", "spring"}), "springe");
  
  AddExit("suedosten", ROOM "0910");
  AddExit("suedwesten", ROOM "0710");
}

SCHWIMMEN
