#include "../def.h"
#include "see.h"

inherit "std/room";

#define DIR_VON "nordwesten"
#define DIR_BIS "suedosten"
#define SCHWIMMEN_TEXT_ICH "Du legst Deine Sachen ab und begibst Dich ins kuehle Nass. Das glitzernde Wasser perlt an Deiner Haut ab und erfrischt Dich."
#define SCHWIMMEN_TEXT_ANDERE " zieht seine Sachen aus und schwimmt eine im See."

int quest_schwimmen(string str, object ob);
schwimmen1();
schwimmen2();
schwimmen3();
nosave int ist_tier_da;

void create()
{
  ::create();

  ist_tier_da=1;
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:18]));
  
  SetProp(P_INT_SHORT, "Am See von Rhondonit");
  SetProp(P_INT_LONG, 
	  BS("Du stehst am Ufer vom See von Rhondonit und kannst nach "
	     "Suedosten und Nordwesten am Ufer entlanggehen. Die Idylle hier "
	     "bewirkt innere Ruhe. Du siehst einige kleine Erdhuegel "
	     "verstreut etwas weiter weg vom Ufer. Im Nordosten liegt der "
	     "Kristallwald. Im Suedosten siehst Du eine Huette."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  STANDARD1
  STANDARD2
  GEBIRGE_FERN
     
  AddDetail("baeume",
	    "Dicht wachsende Baeume beginnen im Norden.");
  
  AddDetail("huette", 
	    "Am besten Du gehst mal dorthin.");

  AddDetail("idylle", 
	    "Na die wunderschoene Stimmung hier! Du bist "
	    "ja ueberhaupt kein Romantiker, wenn Du das nicht bemerkst!");
  
  AddDetail("stimmung",
	    "Hier wuerdest Du Dich gern niederlassen.");
  
  AddDetail(({"erdhuegel","huegel"}), 
	    "Was das wohl sein kann? Am ehesten noch der Huegel eines "
	    "Maulwurfes.");
  
  AddDetail("erde",
	    "Die Erdhuegel sind genaugenommen ein Haufen schwarzer Erde.");

  AddDetail("Maulwurf", 
	    "Den siehst Du zwar nicht, aber ein Loch, das in seine "
	    "Hoehle fuehrt. Ob man ihn da raus bekommt?");

  AddDetail("hoehle", 
	    "Viel kannst Du nicht sehen - sie ist ja dunkel.");
  
  AddDetail("loch", 
	    "Das Loch dient dem Maulwurf als Eingang.");
  
  AddDetail("eingang", 
	    "Der Eingang ist doch das schmucklose Loch!");
  
  AddDetail(({ "blumen","blume" }), 
	    "Ihre Blueten leuchten in allen erdenklichen Farben.");

  AddDetail("farben", 
	    "Besonders die violett-weissen Feldstiefmuetterchen sind "
	    "stark vertreten.");

  AddDetail(({"stiefmuetterchen","feldstiefmuetterchen"}), 
	    "Das ist eine klein wachsende Blume, welche violette und weisse "
	    "Blueten mit einer schwarzen Zeichnung traegt.");

  AddDetail("blueten", 
	    "Viele Blueten von Feldstiefmuetterchen beherrschen das Bild.");

  AddDetail("zeichnung", 
	    "Es sind gerade, schwarze Striche die ins Zentrum "
	    "der Bluete fuehren.");

  AddDetail("zentrum", 
	    "Das ist dort, wo die Bluetenblaetter beginnen.");

  AddDetail("bluetenblaetter", 
	    "Davon gibt es violette und weisse.");

  AddDetail("striche", 
	    "Sie fuehren ins Zentrum der Bluete.");

  AddDetail("teile", 
	    "Es gibt violette und weisse Bluetenblaetter.");
  
  AddCmd(({"bade","baden","schwimme","schwimmen"}), "baden_gehen");
  AddCmd(({"springe","spring"}), "springe");
  AddCmd(({"stecke","druecke","drueck","steck","stoss","stosse"}), "stecke");
  
  AddExit("suedosten",  ROOM "1107");
  AddExit("nordwesten", ROOM "0905");
}

SCHWIMMEN

nosave int stecke(string str)
{
  object *fackel;
  object ob;
  
  if(!str) return 0;
  notify_fail("Was willst Du tun?");
   
  if(str=="fackel in loch" || str =="fackel ins loch")
    if(present("fackel", TP))
      if(!present("erdmaennchen"))
	if(ist_tier_da)
	  {
	    write(BS("Du steckst mutig die Fackel in das Loch und hoffst, "
		     "dass sie nicht ausgeht. Es dauert nicht lange, und Du "
		     "siehst von einem weiter entfernten Loch ein wildes "
		     "Erdmaennchen auf Dich zurasen!"));
	    ob=clone_object(NPC "erdm");
	    ob->move(TO, M_GO);
	    ob->SetProp(P_AGGRESSIVE, 1);
	    ist_tier_da =0;
	    return 1;
	  }
	else 
	  return write(BS("Du steckst die Fackel rein und nichts "
			  "passiert.")), 1;
      else
	return write(BS("Du kaempfst ja grad mit ihm!")), 1;
    else
      return write(BS("Du hast ja keine Fackel!")), 1;
  
  return 0;
}

void reset()
{   
  ::reset();

  ist_tier_da=1;
}
 

