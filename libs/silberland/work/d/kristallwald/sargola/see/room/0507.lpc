#include "../def.h"
#include "see.h"

inherit "std/room";

#define HOEHLE "/d/kristallwald/protheg/av/room/hoehle"

#define DIR_VON "nordosten"
#define DIR_BIS "nordosten"
#define SCHWIMMEN_TEXT_ICH "Nein, hier ist es zu steinig. Probier dein Glueck doch woanders..."
#define SCHWIMMEN_TEXT_ANDERE " will hier schwimmen gehen, beschliesst aber, das doch nicht zu tun."

int quest_schwimmen(string str, object ob);

void create()
{
  ::create();

  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:18]));
     
     
  SetProp(P_INT_SHORT, "Am See von Rhondonit");
  SetProp(P_INT_LONG, 
	  BS("Du stehst am Ufer des Sees von Rhondonit und kannst es "
	     "entlanggehen. Im Westen ragt das Almandin-Gebirge in die "
	     "Hoehe. Deswegen ist es hier auch schon ein wenig steinig. "
	     "In der Mitte ist der See tiefblau - scheint also recht tief "
	     "zu sein. Im Nordosten liegt der Kristallwald.")+
	  BS("Ein besonders grosser Baum liegt im Norden."));
     
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  STANDARD1
  STANDARD2
  GEBIRGE_NAH
	
  AddDetail("promenade",
	    "Sie ist deutlich in der Wiese zu sehen. Du bist offenbar "
	    "nicht der Erste, der hier geht. Sie fuehrt nach Nordosten.");

  AddDetail(({"berge","gebirge","almandin-gebirge","almandin"}),
	    "Maechtig und beeindruckend hoch ragt das Gebirge neben "
	    "Dir in den Himmel. Weit oben siehst du karstartige Gipfel, "
	    "vom Nebel halb verdeckt. Wieviele Abenteurer sind schon "
	    "losgezogen um die Berge zu erkunden und sind nie wieder "
	    "zurueckgekehrt...\n"
	    "In einige Entfernung kannst Du einen seltsamen Schatten an "
	    "einer Felswand entdecken.");

  AddDetail(({"wand","felswand","entfernung"}),
	    "In einiger Entfernung erkennst Du einen seltsam geformten "
	    "Schatten an einer Felswand.");
  
  AddDetail(({"schatten"}),
	    "Der Schatten sieht fast wie ein Loch aus...");

  AddDetail(({"loch"}),
	    "Oder doch eher wie ein Hoehleneingang?");
  
  AddDetail(({"hoehle", "eingang", "hoehleneingang"}),
	    "Tatsaechlich, da befindet sich doch unweit von Dir in der "
	    "Felswand ein dunkler Eingang. Vielleicht in eine Hoehle?");

  AddDetail("ufer",
	    "Es ist ziemlich steinig. Kleinere und groessere Felsen "
	    "liegen hier im Wasser.");

  AddDetail(({"steine","felsen","brocken","felsbrocken"}),
	    "Spitze, scharfkantige Felsbrocken und kleinere Steine "
	    "bilden das Ufer hier.");
  
  AddItem(NPC "wuest", REFRESH_DESTRUCT);

  AddCmd(({"bade", "baden", "schwimme", "schwimmen"}), "baden_gehen");
  AddCmd(({"springe", "spring"}), "springe");

  AddCmd(CMD_BETRETEN, "betreten");
  
  AddExit("nordosten", ROOM "0606");
}

SCHWIMMEN

nosave int betreten(string str)
{
  notify_fail(BS("Was willst Du denn betreten?"));
  if(!str) return 0;
  
  if(str=="hoehle"||str=="loch"||str=="schatten"||str=="hoehleneingang"||
     str=="eingang")
    {
       write(BS("Du naeherst Dich der Felswand und betrittst die kuehle "
		"Hoehle."));

       tell_room(ME, 
		 BS("Du achtest einen Moment nicht auf "+TP->name(WEN)+
		    " als "+TP->QueryPronoun(WER)+" ploetzlich verschwunden "
		    "ist."), ({TP}));

       tell_room(HOEHLE, BS(TP->Name()+" betritt die Hoehle."));
       
       TP->move(HOEHLE, M_NOCHECK|M_SILENT);

       return 1;
    }

  return 0;
}
