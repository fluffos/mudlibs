#include "../def.h"
#include "see.h"

inherit "std/room";

#define DIR_VON "nordosten"
#define DIR_BIS "westen"
#define SCHWIMMEN_TEXT_ICH "Hier am Ufer liegen viele spitze Steine. Du beschliesst, doch nicht Schwimmen zu gehen. Die zarte Haut Deiner Fussohlen koennte aufgerauht werden!"
#define SCHWIMMEN_TEXT_ANDERE " geht auf Grund der vielen spitzen Steine am Ufer doch nicht schwimmen."

nosave int da;

string blumen();

int quest_schwimmen(string str, object ob);
schwimmen1();
schwimmen2();
schwimmen3();

void create()
{
  ::create();

  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:18]));
     
  da=1;
    
  SetProp(P_INT_SHORT, "Seepromenade");
  SetProp(P_INT_LONG, 
	  BS("Du gehst die Promenade am See entlang, die nach "+CAP(DIR_BIS)+
	     " und "+CAP(DIR_VON)+" fuehrt. Das Ufer ist hier ziemlich "
	     "steinig. Noerdlich liegt der See von Rhondonit und weiter im "
	     "Westen erhebt sich das Almandin-Gebirge."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  STANDARD1
  STANDARD2
  GEBIRGE_FERN

  AddDetail(({"kristallwald","wald"}), 
	    "Du siehst im Norden hinter dem See Waelder, aber auch im "
	    "Sueden wachsen die typischen kristallenen Eichen.");
  
  AddDetail(({"eiche", "eichen","kristalleichen","kristalleiche"}), 
	    "Du hast doch schon so viele davon gesehen...");

  AddDetail(({ "blumen", "blume" }), CLOSURE(blumen));

  AddDetail("steine", 
	    "Das Ufer ist von spitzen Steinen bedeckt.");
  
  AddCmd(({"bade", "baden", "schwimme", "schwimmen"}), "baden_gehen");
  AddCmd(({"springe", "spring"}), "springe");

  AddExit("nordosten", ROOM "1109");
  AddExit("westen", ROOM "0910");
}

SCHWIMMEN

string blumen()
{
  if(da)
    {
      write(BS("Du betrachtest eine der Blumen naeher und schreckst dabei "
	       "einen Falter auf!"));
      CLONEME(NPC "tfalter");
      da=0;
      return "";
    }

  return "Du betrachtest die Blumen und kannst nichts wesentliches "
    "feststellen.\n";
}

reset()
{
  da=1;

  ::reset();
}

