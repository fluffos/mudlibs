#include "../def.h"
#include "see.h"

inherit "std/room";

#define DIR_VON "suedwesten"
#define DIR_BIS "osten"
#define SCHWIMMEN_TEXT_ICH "Du legst Deine Sachen und begibst Dich ins kuehle Nass. Das glitzernde Wasser perlt an Deiner Haut ab und erfrischt Dich."
#define SCHWIMMEN_TEXT_ANDERE " zieht seine Sachen aus und schwimmt eine Runde im See."

int quest_schwimmen(string str, object ob);
void schwimmen1();
void schwimmen2();
void schwimmen3();

create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:18]));
  
  SetProp(P_INT_SHORT, "Am See von Rhondonit");
  SetProp(P_INT_LONG, 
	  BS("Du stehst am Ufer vom See von Rhondonit und kannst nach Osten "
	     "und Suedwesten am Ufer entlanggehen. Eine angenehme Ruhe "
	     "ergreift Dich. Im Nordosten liegt der Kristallwald. Dir "
	     "faellt ein besonders grosser Baum im Norden auf."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  STANDARD1
  STANDARD2
  GEBIRGE_NAH
    
  AddCmd(({"bade", "baden", "schwimme", "schwimmen"}), "baden_gehen");
  AddCmd(({"springe", "spring"}), "springe");

  AddExit("osten", ROOM "0805");
  AddExit("suedwesten", ROOM "0606");
  AddExit("nordwesten", SEE_WALD);
}

SCHWIMMEN
