#include "../def.h"
#include "see.h"

inherit "std/room";

int quest_schwimmen(string str, object ob);
schwimmen1();
schwimmen2();
schwimmen3();

#define DIR_VON "westen"
#define DIR_BIS "osten"
#define SCHWIMMEN_TEXT_ICH "Du legst Deine Sachen ab und begibst Dich ins kuehle Nass. Das glitzernde Wasser perlt an Deiner Haut ab und erfrischt Dich."
#define SCHWIMMEN_TEXT_ANDERE " zieht die Sachen aus und schwimmt eine Runde im See."

void create()
{
  ::create();

  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:18]));
     
     
  SetProp(P_INT_SHORT, "Am See von Rhondonit");
  SetProp(P_INT_LONG, 
	  BS("Vor Dir liegt der tiefblaue See von Rhondonit. Nach "+
	     CAP(DIR_VON)+" und "+CAP(DIR_BIS)+" kannst Du weiter am Ufer "
	     "entlang gehen, im Norden beginnt der dichte Kristallwald "
	     "waehrend sich im Westen ein Gebirge erhebt."));
     
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  STANDARD1
  STANDARD2
  GEBIRGE_NAH

  AddCmd(({"bade", "baden", "schwimme", "schwimmen"}), "baden_gehen");
  AddCmd(({"springe", "spring"}), "springe");

  AddExit("osten", ROOM "0905");
  AddExit("westen", ROOM "0705");
  AddExit("norden", SEE_WALD_2);
}

SCHWIMMEN 
