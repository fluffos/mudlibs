#include "../def.h"
#include "see.h"

inherit "std/room";

#define DIR_VON "nordwesten"
#define DIR_BIS "sueden"
#define SCHWIMMEN_TEXT_ICH "Du steigst vorsichtig ins Wasser.. HUCH! Etwas Glitschiges beruehrt Deinen Fuss und Du stuerzt wieder ans Ufer!\n"
#define SCHWIMMEN_TEXT_ANDERE " steigt ins Wasser und stuermt nach kurzer Zeit wie von einem wilden Affen gebissen wieder raus.\n"

int quest_schwimmen(string str, object ob);
schwimmen1();
schwimmen2();
schwimmen3();

void create()
{
  ::create();
 
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:18]));
  
  SetProp(P_INT_SHORT, "Am See von Rhondonit");
  SetProp(P_INT_LONG, 
	   BS("Du stehst am Ufer vom See von Rhondonit. Hier beginnt eine "
	      "Promenade nach Sueden, im Osten siehst Du ein Haus. Eine "
	      "schiefe, hoelzerne Tafel steckt hier im Boden. Nach Norden "
	      "hin erstreckt sich der Kristallwald."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail("tafel", 
	    "Du kannst sie lesen.");       

  AddReadDetail("tafel", 
		"In einfacher, unbeholfener Schrift steht da: "
		"Eesthil's Schmiede.");
  
  AddDetail("haus", 
	    "Es wirkt irgendwie verlassen auf Dich. Eine naehere Untersuchung "
	    "bringt vielleicht mehr Hinweise...");

  AddDetail(({"hinweis","hinweise"}), 
	    "Du kannst hier keine Hinweise erkennen.");

  AddDetail("untersuchung", 
	    "Du faules Etwas!! Geh doch hin, wenn Du was wissen willst!");
  
  AddDetail(({"kreatur","glitschiges"}), 
	    "Was es auch immer war, Du bist froh, an Land zu sein.");
  
  AddSpecialDetail("schwan", "schwan_det");

  STANDARD1
  STANDARD2
  GEBIRGE_FERN
    
  AddRoomMessage(({
    "Du siehst einen Schwan am See schwimmen.\n",
      "Ein weisser, schoener Schwan schwimmt am See.\n",
      "Der Schwan schwimmt majestaetisch auf dem Wasser.\n"}), 60);
  
  AddCmd(({"bade", "baden", "schwimme", "schwimmen"}), "baden_gehen");
  AddCmd(({"springe", "spring"}), "springe");
  AddCmd(({"lock","locke"}), "locke");
  
  AddExit("sueden", ROOM "1108");
  AddExit("osten", ROOM "wohnr");
  AddExit("nordwesten", ROOM "1006");
}

string schwan_det(string str)
{
  if(!present("\n_insel_schwan"))
    return "Er ist zu weit weg, als dass Du etwas erkennen koenntest.\n";

  return "Ein wunderschoener Schwan schwimmt hier herum.\n";
}

nosave int locke(string str)
{
  notify_fail("Wen moechtest Du womit anlocken?\n");
  if(!str) return 0;
  
  if(str=="schwan"|| str=="schwan an")
    return write(BS("Womit willst Du denn den Schwan anlocken?")), 1;

  if(present("\n_insel_schwan"))
    return write(BS("Viel naeher kannst Du den Schwan nicht mehr "
		    "heranlocken.")), 1;

  if((str=="schwan mit semmel") || (str=="schwan mit semmel an"))
    if(present("semmel", TP))
      {
	write(BS("Du schaffst es tatsaechlich und lockst den Schwan mit "
		 "der Semmel ans Ufer heran."));

	CLONEME(SCHWAN);
	
	call_out("remove_schwan", 60);
	
	return 1;
      }
    else
      return write(BS("Wenn Du sowas bei Dir haettest...")), 1;

  if((str=="schwan mit brot") || (str=="schwan mit brot an") ||
     (str=="schwan mit johannisbrot") || (str=="schwan mit johannisbrot an"))
    if(present("johannisbrot", TP))
      {
	write(BS("Du schaffst es tatsaechlich und lockst den Schwan mit "
		 "dem Johannisbrot ans Ufer heran."));

	CLONEME(SCHWAN);
	
	call_out("remove_schwan", 60);
	
	return 1;
      }
    else
      return write(BS("Wenn Du sowas bei Dir haettest...")), 1;


  notify_fail(BS("Schwaene lockt man am Besten mit einer Semmel, "
		 "oder mit Johannisbrot."));
  return 0;
}
	   

void remove_schwan()
{
  object schwan;

  if(schwan=present("\n_insel_schwan"))
    {
      tell_room(ME, BS("Der Schwan schwimmt gelangweilt wieder weiter."));
      schwan->remove(1);
    }
}

SCHWIMMEN
