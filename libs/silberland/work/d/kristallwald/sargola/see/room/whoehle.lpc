inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../def.h"



int moos(string str);
string moos_da();

int moos;

create()
      {
        ::create();

	moos = 1;

        SetProp( P_INT_SHORT, "in einer Hoehle" );
        SetProp( P_INT_LONG, 
      BS(" "
	+" "
	+" "
	+" "
	+" "
	+" "
	+" "
	+"\n"));

        SetProp( P_LIGHT, 0 );
        SetProp( P_INDOORS, 0 );
	SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));

	AddSpecialDetail("moos","moos_da");

	AddRoomMessage( 3,({
		"Vielleicht solltest Du die Woelfe lieber in Ruhe lassen.\n"
		"Ob der Vater hier in der Naehe ist?\n",
		"Die Mutter wird ihre Jungen sicher mit aller Kraft verteidigen!\n",
		}) );	

	AddExit( "nordosten", ROOM+"0101.lpc" );

	AddCmd( ({"nimm"}),"moos");

}

moos_da()
{
   if(moos == 1)
   {
	return BS("Du siehst ein Bueschel Moos.");
   }
   else
   {
	return BS("Du siehst eine Stelle, an der einmal Moos gewesen ist.");
   }
}
	


reset()
{
   ::reset();
   moos = 1;
}


int moos(string str)
{
   object ob;
   int i;

   notify_fail("Was moechtest Du nehmen?\n");

   if(str=="") return 0;

   if(str=="moos" || str=="moos von boden")
   {
	if(moos == 1)
	{

	   tell_object(TP, BS("Du nimmst das Moos."));
	   tell_room(TO, TPN+" nimmt das Moos.");
	   TP->heal_self(20);
	   //TP->restore_hit_points(20);
	   //TP->restore_spell_points(20);

/*
	   ob = clone_object(OBJ+"moos");
	   i = ob->move(TP);	   
	   if(i==ME_TOO_HEAVY)
	   {
		tell_object(TP, BS("Du kannst das Moos nicht mehr tragen."));
		ob->move(environment(TP));
	   }
*/

	   moos = 0;
	   return 1;
	}
	else
	{
	   tell_object(TP, BS("Da ist kein Moos mehr."));
	   return 1;
	}
   }
}

