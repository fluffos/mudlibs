#include "../def.h"
#include "see.h"

inherit "std/room";

#define DIR_VON "westen"
#define DIR_BIS "nordosten"
#define SCHWIMMEN_TEXT_ICH "Du gehst auf Grund der vielen Steine doch nicht schwimmen."
#define SCHWIMMEN_TEXT_ANDERE " geht auf Grund der vielen Steine doch nicht schwimmen."

int quest_schwimmen(string str, object ob);
schwimmen1();
schwimmen2();
schwimmen3();

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:18]));
  
  SetProp(P_INT_SHORT, "Seepromenade");
  SetProp(P_INT_LONG, 
      BS("Hier endet oder beginnt die Promenade - je nachdem wie Du es "
         "betrachtest. Im Westen steigt der Boden gen Gebirge an. "
         "Ab hier gibt es keine befestigten Wege mehr."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  STANDARD1
  STANDARD2
  GEBIRGE_NAH
     
  AddDetail(({ "gebirge", "berge", "almandin-gebirge" }), 
	    "Es tuermt sich im Westen und erdrueckt Dich mit seiner "
	    "Maechtigkeit.");

  AddDetail("maechtigkeit", 
	    "Du bist schwer beeindruckt.");

  AddDetail(({ "weg" }), 
	    "Im Osten siehst Du die Promenade, ein Weg rund um den "
	    "See. Im Westen fuehrt ein Weg ins Gebirge, der aber bald "
	    "aufhoert, ein Weg zu sein.");

  AddDetail(({ "promenade" }), 
	    "Die Promenade geht im Osten weiter um den See.");

  AddDetail("boden", 
	    "Du siehst einen Pfad, der entlang des Ufers laeuft. Eigentlich "
	    "ist es nur harte Erde. Gen Wald siehst Du eine Unmenge von "
	    "Blumen und Farnen.");

  AddDetail("unmenge", 
	    "Ueberall blitzen die Blumen zwischem dem Gras hervor.");

  AddDetail("gras", 
	    "Es wuchert hier ueberall am Boden.");
  

  AddDetail("pfad", 
	    "Er schlingt sich am See entlang, einige Steine liegen auf ihm.");

  AddDetail(({"kieselsteine","stein","steine"}), 
	    "Kleine Kieselsteine liegen hie und da herum.");

  AddDetail("erde", 
	    "Von vielen Fuessen getretene Erde...");

  AddDetail("himmel", 
	    "Der Himmel liegt tiefblau ueber Dir. Du legst Dich in die "
	    "Wiese und versinkst in den unendlichen Tiefen.");
  
  AddDetail(({"tiefen","tiefe"}), 
	    "Am liebsten wuerdest Du noch viele Stunden hier "
	    "liegen und Wolken deuten.");

  AddDetail("wolken", 
	    "Herrliche Schaefchen-Wolken praegen das Firmament.");

  AddDetail("schaefchenwolken", 
	    "Das sind die, welche wie Daunenkissen aussehen "
	    "gutes Wetter vorhersagen, oder...?");

  AddDetail("wetter", 
	    "Es ist einfach herrlich!");
  
  AddDetail("firmament", 
	    "Es wird nur im Westen vom Gebirge und sonst vom Wald "
	    "begrenzt.");
  
  AddDetail(({"kristallwald","wald"}), 
	    "Du siehst im Norden hinter dem See Waelder, "
	    "aber auch im Sueden wachsen die typischen kristallenen Eichen.");

  AddDetail(({"eiche", "eichen","kristalleichen","kristalleiche"}), 
	    "Du hast doch schon so viele davon gesehen...");       
  
  AddDetail(({ "blumen", "blume" }), 
	    "Alle moeglichen Sorten von Blumen mit roten, gelben und "
	    "orangen Blueten findest Du hier ebenso wie Farne.");

  AddDetail(({"welle","wellen"}), 
	    "Die Wellen schlagen sanft am Ufer auf.");

  AddDetail("wiese", 
	    "Ein gemuetlicher Platz, um auszuspannen und einmal mit "
	    "einer Person, die Du sehr magst, hierher zu kommen....");
  
  AddDetail("person", 
	    "Wer das ist, das musst schon Du wissen...");

  AddDetail("oberflaeche", 
	    "Sie ist leicht von den Wellen gekraeuselt.");
  
  AddDetail("see", 
	    "Vor Dir breitet sich der See aus. Leichte Wellen bringen die "
	    "Oberflaeche zum funkeln.");

  AddDetail("mitte", 
	    "Du kannst nichts Genaues ueber die Mitte des Sees sagen...");
  
  AddDetail("ufer", 
	    "Es geht leicht abwaerts ins Wasser und ist hier steinig.");

  AddDetail("wasser", 
	    "Das Wasser scheint zwar nicht kristallin wie alles andere hier "
	    "zu sein, ist aber eigenartig blaeulich-silbrig gefaerbt. Ob Du "
	    "darin baden kannst?");

  AddDetail(({"flora","blueten","bluete","farne"}), 
	    "Du bist leider in der Flora nicht so bewandert.");
  
  AddDetail("steine", 
	    "Die Steine, die das Ufer bedecken, sind recht spitz.");
  
  AddSound(({"see", DEFAULT_SOUND}), 
	   "Nur das leise Gurgeln der Wellen ist zu hoeren.");

  AddSound(({"wellen","gurgeln"}) , 
	   "Sanft schlagen die Wellen an das Ufer.");
  
  AddSmell(DEFAULT_SMELL, "Die Pflanzen sind leider geruchslos.");
  
  AddCmd(({"bade", "baden", "schwimme", "schwimmen"}), "baden_gehen");
  AddCmd(({"springe", "spring"}), "springe");
  
  AddExit("osten", ROOM "0710");
  AddExit("westoben", ROOM "0510");
}

nosave int springe(string str)
{
  if(!str) return 0;
  
  notify_fail(BS("Wohin willst Du denn springen?"));
  
  if(str=="see"||str=="in den see"||str=="in see")
    return write(BS("Hier liegen am Ufer viele spitze Steine.")+
		 BS("Du beschliesst, das doch nicht zu machen.")), 1;
  
  return 0;
}

nosave int baden_gehen(string str)
{
  notify_fail("Wo willst Du denn schwimmen gehen?\n");
  if(!str) return 0;
  
  if(str=="im see"||str=="im wasser"||str=="in wasser"||str=="in see")
    return write(BS("Hier liegen am Ufer viele spitze Steine.")+
		 BS("Du beschliesst, das doch nicht zu machen.")), 1;
  
  return 0;
}
 

