#include "../def.h"
#include "see.h"

inherit "std/room"; 

#define DIR_VON "norden"
#define DIR_BIS "sueden"
#define SCHWIMMEN_TEXT_ICH "Du steigst vorsichtig ins Wasser.. HUCH! Etwas Glitschiges beruehrt Deinen Fuss und Du stuerzt wieder ans Ufer!"
#define SCHWIMMEN_TEXT_ANDERE " steigt ins Wasser und stuermt nach kurzer Zeit wie von einem wilden Affen gebissen wieder raus."

int quest_schwimmen(string str, object ob);
schwimmen1();
schwimmen2();
schwimmen3();

void create() 
{ 
  ::create(); 
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:18]));
  
  SetProp(P_INT_SHORT, "Seepromenade");
  SetProp(P_INT_LONG,  
	   BS("Du gehst die Promenade am See entlang, die nach Norden und "
	      "Sueden fuehrt. Noerdlich siehst Du ein Haus etwas weiter weg "
	      "vom Ufer. Im Norden liegt der Kristallwald.")); 
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  STANDARD1
  STANDARD2
  GEBIRGE_FERN
        
  AddDetail("haus", 
	    "Es wirkt irgendwie verlassen auf Dich. Eine naehere Untersuchung "
	    "bringt vielleicht mehr Hinweise, wenn Du hingehst.");
  
  AddDetail(({"hinweis","hinweise"}), 
	    "Du kannst hier keine Hinweise erkennen."); 

  AddDetail(({"etwas","untersuchung"}), 
	    "Du faules Etwas!! Geh doch hin, wenn Du was wissen willst!.");
  
  AddDetail(({"kreatur","glitschiges"}), 
	    "Du bist froh, nicht naeher in Kontakt mit dieser Kreatur "
	    "gekommen zu sein.");
  
  AddCmd(({"bade", "baden", "schwimme", "schwimmen"}), "baden_gehen"); 
  AddCmd(({"springe", "spring"}), "springe"); 
  
  AddExit("sueden", ROOM "1109"); 
  AddExit("norden", ROOM "1107"); 
} 

SCHWIMMEN

