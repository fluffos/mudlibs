inherit "std/room";



#include <properties.h>

#include <language.h>



#include "/d/kristallwald/sargola/def_kristall.h"



      create()

      {

     	::create();

     

     	SetProp( P_INT_SHORT, "Am See von Rhondonit" );

     	SetProp( P_INT_LONG, 

	   BS("Du stehst am Ufer vom See von Rhondonit und kannst am Ufer entlanggehen. "

		+"Im Westen ragt das Almandin-Gebirge in die Hoehe. Eine angenehme Ruhe ergreift "

		+"Dich. Der See ist in der Mitte tiefblau - scheint also recht tief zu "

		+"sein. Im Nordosten liegt der Kristallwald. Ein besonders grosser Baum "

		+"liegt im Norden. \n") );

     

     	SetProp( P_LIGHT, 1 );

     	SetProp( P_INDOORS, 0 );

     



     	AddDetail( "boden", BS("Eine Art Wiese die leicht knistert wenn Du gehst bildet"

		+" das Ufer hier. Gen Wald siehst Du eine Unmenge von Blumen und Farnen.\n")	);

    	AddDetail( "himmel", BS("Der Himmel liegt tiefblau ueber Dir. Du legst Dich in die "

	        +"Wiese und versinkst in den unendlichen Tiefen.\n")	);



    	AddDetail( ({"tiefen","tiefe"}), BS("Am liebsten wuerdest Du noch viele Stunden hier "

		+"liegen und Wolken deuten.\n")	);

    	AddDetail( "wolken", BS("Herrliche Schaefchen-Wolken praegen das Firmament.\n")	);

    	AddDetail( "schaefchenwolken", BS("Das sind die, welche wie Daunenkissen aussehen "

		+"gutes Wetter vorhersagen, oder...?\n")	);

    	AddDetail( "wetter", BS("Es ist einfach herrlich!\n")	);



    	AddDetail( "firmament", BS("Es wird nur im Westen vom Gebirge und sonst vom Wald "

		+"begrenzt.\n")	);



    	AddDetail( ({"kristallwald","wald"}), BS("Von aussen hat er fast eine majestaetische Schoenheit. Doch "

		+"genauso schonen wie er ist, so gefaehrlich kann er auch sein.\n")	);

    	

     	AddDetail( ({ "blumen", "blume" }), BS("Alle moeglichen Sorten von Blueten "

		+"mit roten, gelben und orangen Blueten findest Du hier ebenso wie Farne.\n" ));

     	AddDetail( ({"welle","wellen"}), BS ("Die Wellen schlagen sanft am Ufer auf.\n") );

     	AddDetail( "wiese", BS("Ein gemuetlicher Platz, um auszuspannen und einmal mit "

		+"einer Person, die du sehr magst, hierherzukomemn....\n") );



    	AddDetail( "person", BS("Wer das ist, das musst schon Du wissen...\n")	);



     	AddDetail( "oberflaeche", BS ("Sie ist leicht von den Wellen gekraeuselt.\n") );



     	AddDetail( ({"rhondonit","see"}), BS("Vor Dir breitet sich der See aus. Leichte Wellen bringen die "

		+"Oberflaeche zum funkeln.\n") );

     	AddDetail( "mitte", BS("Du kannst nichts Genaues ueber die Mitte des Sees sagen...\n") );



	AddDetail( "ufer", BS("Es geht leicht abwaerts ins Wasser.\n") );

     	AddDetail( "wasser", BS("Das Wasser scheint zwar nicht kristallin wie alles andere hier "

		+"zu sein, ist aber auf eigenarteige Weise blaeulich-silbrige gefaerbt. Ob Du "

		+"darin baden kannst?\n") );

     	AddDetail( ({"blueten","farne"}), BS ("Du bist leider in der Fauna nicht so "

		+"bewandert.\n") );



     	AddDetail( "baum", BS ("Weit im Norden ragt er ueber alle anderen Baeume.\n") );

     	AddDetail( ({"gebirge","almandin-gebirge"}), BS ("Es baut sich bedrohlich vor Dir auf.\n") );



	AddSound (DEFAULT_SOUND, "Nur das leise Gurgeln der Wellen ist zu hoeren.\n");

	AddSound (({"wellen","gurgeln"}) , "Sanft schlagen die Wellen an das Ufer.\n");

	

	AddSmell(DEFAULT_SMELL, "Die Pflanzen sind leider geruchslos\n");







	AddCmd ( ({"grab","grabe"}), "grabe");
	AddCmd ( ({"lege"}), "lege");
	AddCmd ( ({"bade", "baden", "schwimme", "schwimmen"}), "baden_gehen");

	AddCmd ( ({"springe", "spring"}), "springe");



     	AddExit( "suedwesten", ROOM_SEE+"0507.lpc" );

     	AddExit( "nordosten", ROOM_SEE+"0705.lpc" );



      }





int springe (string str)

{

	if (!str) return 0;



	notify_fail ("Wohin willst Du denn springen?\n");



	if (str =="see" || str =="in den see" || str =="in see" )

	{

		write ( BS("AUTSCH! Die Spitzen Steine haettest Du vorher beachten sollen!\n"));

		this_player()->reduce_hit_point(10);

		say(this_player()->name(WER,2)+" schneidet sich an den spitzen Steinen.\n");

		return 1;

	}

	return 0;

}

     





int baden_gehen (string str)

{

	if (!str) return 0;



	notify_fail ("Wo willst Du denn schwimmen gehen?\n");



	if (str =="im see" || str =="im wasser" || str=="in wasser" || str =="in see")

	{

		write ( BS("AUTSCH! Die Spitzen Steine haettest Du vorher beachten sollen!\n"));

		this_player()->reduce_hit_point(10);

		say(this_player()->name(WER,2)+" schneidet sich an den spitzen Steinen.\n");

		return 1;

	}

	return 0;

}

int grabe(string str)
{
	notify_fail("Was moechtest Du denn graben?\n");
	if (!str) return 0;
	
	if(str=="loch")
	{
	
	if(!present("schaufel", TP))
	{
		write(BS("Du hast ja nichts zum Graben dabei!\n"));
		return 1;
	}
	else
	{
		if(present("\nloch"))
		{
			write(BS("Da hat schon jemand ein Loch gegraben...\n"));
			return 1;
		}
		else
		{
			write(BS("Du graebst ein Loch in das ein Wuestling genau "
				+"reinpasst.\n"));
			(clone_object(OBJ_SEE+"loch.lpc"))->move(environment(TP));
			return 1;
		}
	}
	}
	else
	{
		write(BS("Was willst Du graben?\n"));
		return 1;
	}
	return 0;
}

int lege(string str)
{
	
	notify_fail("Was willst Du denn wohin legen?\n");
	if (!str) return 0;
	
	if(!present("loch"),environment())
	{
		write(BS("Worueber willst Du denn etwas legen?\n"));
		return 1;
	}
	
	if(str=="ast auf loch"||str=="ast auf das loch")
	{
		
	   	if(present("ast",TP))
		{
			write(BS("Du legst den Ast sorgfaelltig ueber das Loch. "
				+"Trotzdem sieht man das Loch von weitem.\n"));
			clone_object(OBJ_SEE+"uast")->move(environment(TP));
			//(clone_object(OBJ_SEE+"falle.lpc"))->move(environment(TP)); 
			return 1;
		}
		else
		{
			write(BS("Du hast nichts, das Du auf das Loch legen koenntest...\n"));
			return 1;
		}
		
	}
	
	
	if(str=="blaetter auf loch"||str=="blaetter auf das loch")
	{
	    if(present("uast"))
	    {
	    	if(present("blaetter",TP))
	    	{
	    		write(BS("Du trapierst die Blaetter auf dem Ast, doch "
	    			+"noch immer schimmert das dunkle Loch durch.\n"));
	    		clone_object(OBJ_SEE+"ublaetter")->move(environment(TP));
	    		return 1;
	    	}
	    	else
	    	{
	    		write(BS("Du hast ja keine Blaetter!\n"));
	    		return 1;
	    	}
	    }
	    else
	    {
	        write(BS("Du versuchst, die Blaetter ueber das Loch zu legen..."
	        +"Sowas Dummes auch! Die fallen ja ganz rein!\n"));
	        return 1;
	    }
	}
	
	
	if(str=="gras auf loch"||str=="gras auf das loch")
	{
	   if(!present("loch"),environment())
	   {
	   	write(BS("Welches Loch?\n"));
	   	return 1;
	   }
	   if(!present("gras",TP))
	   {
	   	write(BS("Wo soll denn das Gras sein, das Du auf das Loch "
	   		+"legen willst?\n"));
	   	return 1;
	   }	
	   
	   if(present("uast"))
	   {
	      if(present("ublaetter"))
	      {
	          
	           write(BS("Du streust noch Grashalme ueber das Ganze und siehe da: "
	         	+"nun kann man das Loch nicht mehr sehen!\n"));
	           clone_object(OBJ_SEE+"falle.lpc")->move(environment(TP));
	           return 1;
	       }
	          
	      
	      else
	      {
	        
	          write(BS("Du willst das Gras auf den Ast legen, aber die Halme "
	          	+"fallen in das Loch rein...\n"));
	          return 1;
	        
	      }
	   }
	   else
	   {
	      write(BS("Du wirfst das Gras in das Loch rein - toll! Und jetzt? Glaubst "
	      	+"Du, dass der Wuestling freiwillig in das Loch huepft??\n"));
	      return 1;
	     
	   }
	 }
	
	
	
	return 0;
	    	
}