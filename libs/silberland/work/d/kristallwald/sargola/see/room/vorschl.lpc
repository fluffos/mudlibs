AddCmd ( ({"grabe", "grab"}), "grabe");

AddCmd ( ({"lege", "leg"}), "lege");

AddCmd ( ({"spring","springe","huepf","huepfe"}), "springe");

AddCmd ( "unt loch", "unt_loch");

Addcmd ("unt falle", "unt_falle");



string o_long;		//Originale Beschreibung des Raumes ;)



o_long = QueryProp(P_LONG);





string unt_falle(string str)

{

	if(present("fallenloch") == 1)	

	{

		if(!str) return BS("Du siehst eine gut verborgene, fiese Falle.\n");

		return 1;

	}

	else

	{

		return BS("Sowas siehst Du hier nicht.\n");

		return 1;

	}

	return 0;

}









string unt_loch(string str)

{

	if(present("loch") == 1)	

	{

		if(!str) return BS("Du siehst ein Loch, das 2 Meter tief ist.\n");

		return 1;

	}

	else

	{

		return BS("Sowas siehst Du hier nicht.\n");

		return 1;

	}

	return 0;

}



int grabe(string str)

{	

	object loch;



	notify_fail("Was willst Du denn graben?");

	if(!str) return 0;



	if( (present("schaufel")==1) || (present("hacke") ==1) )	

	{

		if(str=="loch" ||str=="falle")

		{

			write(BS("Du beginnst zu graben und graebst ein Loch, in das ein "

				+"Wuestling genau reinpasst.\n"));

			loch = clone_object(OBJ_WALD+"loch.lpc");

			loch->move(environment(TP), M_SILENT);

			SetProp(P_LONG, o_long+" Weiters siehst Du ein Loch im Boden.\n");

			AddDetail("loch",  BS("Du siehst ein Loch, das 2 Meter tief ist.\n");

						

			return 1;

		}

		else

		{

			write(BS("Was willst Du graben?\n"));

			return 1;

		}

	}	

	else

	{

		write(BS("Du hast nichts zu Graben dabei!\n"));

		return 1;

	}

	return 0;

}





int lege(string str)

{

	object falle;

	notify_fail("Was willst Du denn legen?\n");

	if(!str) return 0;





	if(str=="aeste")

	{

		if(present("fallenloch")== 1)

		{

			if( (present("ast1")==1) && (present("ast2")==1) && (present("ast3")==1) )

			{

				write(BS("Du trapierst die Aeste ueber dem Loch. Es ist nun "

					+"fast nicht mehr zu sehen.\n"));

				falle = clone_object(OBJ_WALD+"falle.lpc");

				falle->move(environment(TP), M_SILENT);

				SetProp(P_LONG, o_long+" Weiters glaubst Du eine Falle zu sehen.\n");

				AddDetail("falle",  BS("Gut versteckt siehst Du eine fiese Falle.));

				RemoveDetail("loch");

				return 1;

			}

			else

			{

				write(BS("Du hast nicht genug Aeste mit, um das Loch abzudecken.\n"));

				return 1;

			}

		}

		else

			write(BS("Von welchem Loch sprichst Du?\n"));

	else

	{

		write(BS("Was willst Du denn legen?\n"));

		return 1;

	}

	return 0;

}





int springe(string str)

{

	notify_fail("Wohin willst Du springen?\n"));

	if(!str) return 0;

	

	if(str=="ins loch"||str=="in das loch"||str=="in loch"||str=="in falle"||str=="in die falle"||str=="in falle")

	{

		TP->move(ROOM_WALD+"falle.lpc", M_GO);

		return 1;

	}

	else

	{

		write(BS("Wohin willst Du springen?\n"));

		return 1;

	}

	return 0;



}