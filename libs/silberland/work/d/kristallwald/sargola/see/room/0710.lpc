#include "../def.h"
#include "see.h"

inherit "std/room";

#define DIR_VON "westen"
#define DIR_BIS "nordosten"
#define SCHWIMMEN_TEXT_ICH "Du gehst auf Grund der vielen Steine doch nicht schwimmen."
#define SCHWIMMEN_TEXT_ANDERE " geht auf Grund der vielen Steine doch nicht schwimmen."

int quest_schwimmen(string str, object ob);
schwimmen1();
schwimmen2();
schwimmen3();

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:18]));
  
  SetProp(P_INT_SHORT, "Seepromenade" );
  SetProp(P_INT_LONG, 
	  BS("Du gehst die Promenade um den See entlang. Sie fuehrt von "+
	     CAP(DIR_BIS)+" nach "+CAP(DIR_VON)+". Im Westen beginnt der "
	     "Boden leicht zu steigen. Der Weg verliert sich weiter im "
	     "Westen. Der See liegt ruhig vor Dir."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  STANDARD1
  STANDARD2
  GEBIRGE_NAH
    
  RemoveDetail("baum");
  
  AddDetail("halbinsel", 
	    "Geh doch einfach hin und sieh sie Dir an.");
  
  AddDetail("steine", 
	    "Die Steine bedecken das Ufer und sind sehr spitz.");
  
  
  AddCmd(({"bade", "baden", "schwimme", "schwimmen"}), "baden_gehen");
  AddCmd(({"springe", "spring"}), "springe");
  
  AddExit("nordosten", ROOM "0809" );
  AddExit("westen", ROOM "0610" );
  
}

SCHWIMMEN
