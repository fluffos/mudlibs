#include "../def.h"

inherit "std/room"; 
inherit "/gilden/bardengilde/obj/std_spellprovider";

void create() 
{ 
  ::create(); 
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));

  SetProp(P_INT_SHORT, "Eesthils Schmiede"); 
  SetProp(P_INT_LONG,  
	  BS("Du betrittst ein geraeumiges Haus, das in zwei Raeume geteilt "
	     "ist. Durch eine Tuere siehst Du im Norden die Arbeitsstaette, "
	     "offensichtlich die eines Schmiedes. Der Raum, in dem Du "
	     "stehst, dient wohl als Wohnraum. Dir faellt ein Bett "	     
	     "fuer 2 Personen und ein Tisch in der Mitte des Raumes auf.")); 

  SetProp(P_LIGHT, 1); 
  SetProp(P_INDOORS, 1); 

  AddDetail("mitte",
	    "Da siehst Du einen Tisch stehen.");

  AddDetail(({"haus"}),  
	    "In diesem Haus wohnt sicher ein Schmied."); 

  AddDetail(({"schmied"}),  
	    "Du vermutest wenigstens, dass es ein Schmied sein muesste."); 

  AddDetail(({"raum","raeume"}),  
	    "Im Norden der Arbeitsraum und hier der Wohnraum bilden zwei "
	    "Raeume."); 
  
  AddDetail(({"arbeitsraum","arbeitsstaette","staette"}), 
	    "Durch die Tuere kannst Du nicht alles sehen...");      
  
  
  AddDetail(({"tuer","tuere"}) ,
	    "Eine fuehrt aus dem Haus raus, die andere in den Raum "
	    "noerdlich."); 
  
  AddDetail("wohnraum", 
	    "Hier ist es recht gemuetlich. Zwei Fenster erhellen den Raum, " 
	    "Du siehst ein grosses Bett, eine Feuerstelle und einen schweren "
	    "Eichentisch."); 
  
  AddDetail(({"tisch","eichentisch"}), 
	    "Der Tisch steht auf 4 schweren gedrechselten Beinen und ist "
	    "extrem massiv gebaut."); 
  
  AddDetail("beine", 
	    "Es sind 4 Stueck und sie tragen den Tisch."); 
  
  AddDetail("stueck",
	    "Es gibt 4 Stueck.");
  
  AddDetail(({"feuerstelle","stelle"}), 
	    "Die Feuerstelle ist erloschen und diente vermutlich zum "
	    "Garen und Braten."); 
  
  AddDetail("personen",
	    "Der Schmied und seine Frau vielleicht??");
  
  AddDetail("fenster", 
	    "Durch die Fenster dringt sanftes Licht in den Raum und " 
	    "man kann die wunderschoene Gegend draussen sehen."); 
  
  AddDetail("gegend", 
	    "Die Schmiede liegt im Sueden des Waldes direkt am See.");
  
  AddDetail("licht",
	    "Es wirkt weiss-milchig durch die Reflektionen der Baeume."); 
  
  AddDetail(({"reflektion","reflektionen"}), 
	    "Das Licht wird hier im Kristallwald tausendfach von Aesten "
	    "und Straeuchern gebrochen. Irgendwie schimmert alles " 
	    "auf eine eigenartige Weise."); 
  
  AddDetail(({"straeucher","aeste"}), 
	    "Die kannst Du von draussen besser sehen."); 
  
  AddDetail(({"wald","kristallwald"}), 
	    "Die Gegend hier nennt man Kristallwald."); 
  
  AddDetail(({"baum","baeume"}), 
	    "Du kannst durch die Fenster weisse Baeume erkennen."); 
  
  AddDetail("bett", 
	    "In einer Ecke siehst Du ein grosses Bett mit einer dicken Daunen" 
	    "decke und zwei riesigen Polstern."); 
  
  AddDetail("ecke", 
	    "Davon siehst Du hier vier..."); 
  
  AddDetail(({"decke","daunendecke"}), 
	    "Du weisst schon - so eine kuschelige, weiche Decke, in der "
	    "man so richtig versinken kann..."); 
  
  //AddDetail("versinken", #'versinken); 
  
  AddDetail("polster", "Weisse, kuschelige Polster."); 
  
  AddDetail("boden",  
	    "Dicke Holzplanken bilden den Boden hier."); 
  
  AddDetail(({"wand","waende","planken","planke", "holzplanken"}),  
	    "Sie sind, wie alles in der Gegend hier, aus weisslichem Holz."); 
  
  AddDetail("holz",
	    "Fein geschnittene Holzplanken."); 
  
  AddDetail("decke", 
	    "Auch an der Decke siehst Du die Holzplanken."); 
  
  AddSound(DEFAULT_SOUND, "Hier drin ist kein Laut zu hoeren."); 
  
  AddSmell(DEFAULT_SMELL, "Ein wenig staubig riecht es hier."); 
  
  AddCmd(({"versink","versinke"}),"versinke");
  
  AddExit("westen", ROOM "1107"); 
  AddExit("norden", ROOM "schmiede");
} 

nosave int versinke(string str) 
{
  notify_fail("Worin willst Du versinken?\n");
  if(!str) return 0;   
  
  if(str=="in decke"||str=="in bett")
    {
      write(BS("Vorsichtig blickst Du Dich um - Die Besitzer des Hauses "
	       "sind nicht da...")+
	    BS("Mit vollem Anlauf springst Du in das kuschelige Bett und " 
	       "schmiegst Dich in die grossen Kissen!"));

      tell_room(ENV(TP), 
		BS(TPN+" springt in das Bett und kuschelt sich in die "
		   "Kissen."),({TP})); 

      return 1;
    }

  return 0; 
}

public void init() {
	::init();
	call_out("check_learn_song", 2);
}

public void check_learn_song() {
	if(!objectp(this_player())) return;
	if(this_player()->QueryProp(P_GUILD) != "bardengilde") return;
	if(this_player()->QuerySkill("das geborstene schwert") != 0) return;
	if(!this_player()->QueryQuest("Eesthils Befreiung")) return;

	LearnBardSpell(this_player(), "das geborstene schwert", 
	               "Diese Arie repariert die Ausruestung deiner Zuhoerer.",
				   "spiele 'das geborstene schwert'");
	return;
}
