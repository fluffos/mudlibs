#include "../def.h"
#include "see.h"

inherit "std/room";

#define DIR_VON "norden"
#define DIR_BIS "suedwesten"
#define SCHWIMMEN_TEXT_ICH "Du nimmst ein angenehmes Bad im See."
#define SCHWIMMEN_TEXT_ANDERE " steigt ins Wasser und nimmt ein angenehmes Bad im See."

int quest_schwimmen(string str, object ob);
schwimmen1();
schwimmen2();
schwimmen3();

nosave int wiese_da;         //Ob das Bueschel schon weg ist :)

string bueschel();
string halme();
string wiese();

void create()
{
  ::create();

  wiese_da = 1;
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:18]));
  
  SetProp(P_INT_SHORT, "Seepromenade");
  SetProp(P_INT_LONG, 
	  BS("Du gehst die Promenade am See entlang, die nach "+CAP(DIR_BIS)+
	     " und "+CAP(DIR_VON)+" fuehrt. Eine schoen angelegte Promenade "
	     "fuehrt entlang am Ufer von Norden nach Suedwesten."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  STANDARD1
  STANDARD2
  GEBIRGE_FERN
    
  AddDetail("wiese",CLOSURE(wiese));
  
  AddDetail("oberflaeche", 
	    "Sie ist leicht von den Wellen gekraeuselt.");
  
  AddDetail("bueschel", CLOSURE(bueschel));

  AddDetail("knie", 
	    "Meinst Du das rechte oder das linke?");
  
  AddDetail("rechtes knie",
	    "Das ist ein wenig hoeher als Dein linkes - Oh Gott! Du bist ja "
	    "entstellt!");
  
  AddDetail("linkes knie",
	    "Dein linkes Knie sitzt etwas tiefer als das rechte. Ob das "
	    "einen tieferen Sinn hat?");

  AddDetail("sinn",
	    "Du wirst ihn wohl nie erfahren...");
  
  AddDetail(({"halme","grashalme"}), CLOSURE(halme)); 
  
  AddCmd(({"reiss","reisse"}), "reiss");
  AddCmd(({"bade", "baden", "schwimme", "schwimmen"}), "baden_gehen");
  AddCmd(({"springe", "spring"}), "springe");
  
  AddExit("suedwesten", ROOM "1010");
  AddExit("suedosten", ROOM "1210");
  AddExit("norden", ROOM "1108");
}

void reset()
{
  ::reset();
  wiese_da = 1;
}

nosave int reiss(string str)
{
  object gras;
  
  notify_fail(BS("Was willst Du denn abreissen?"));
  if(!str) return 0;
  
  notify_fail(BS("Die ganze Wiese willst Du abreissen??"));
  if(str=="wiese ab"||str=="wiese") return 0;

  notify_fail(BS("Was willst Du denn abreissen?"));
  
  if(str=="bueschel ab"||str=="bueschel aus"||str=="bueschel"||
     str=="grasbueschel aus"||str=="grasbueschel ab"||str=="grasbueschel"||
     str=="halme"||str=="grashalme"||
     str=="halme ab"||str=="halme aus"||
     str=="grashalme ab"||str=="grashalme aus")
    {
      if(wiese_da)
	{
	  gras=clone_object(OBJ "wiese.lpc");

	  if(gras->move(TP, M_GET)==ME_TOO_HEAVY)
	    {
	      gras->remove(1);
	      return write(BS("Da Dir das Grasbueschel wahrscheinlich zu "
			      "schwer waere, reisst Du es erst garnicht "
			      "aus...")), 1;
	    }

	  write(BS("Du reisst das Bueschel aus und steckst "
		   "es ein. Gras kann man schliesslich in jeder "
		   "Lebenslage brauchen!"));
	  
	  tell_room(ME, 
		    BS(TPN+" reisst ein Bueschel Gras aus. "
		       "Man weiss ja nie, wozu man das mal brauchen kann."), 
		    ({TP}));
	  
	  wiese_da =0;
	  return 1;
	}
      else
	return write(BS("Irgendwie kannst Du Dich nicht fuer eines der "
			"vielen Grasbueschel entscheiden und beschliesst, "
			"es spaeter nochmal zu versuchen.")), 1;
    }
  
  return 0;
} 


string bueschel()
{
  if(wiese_da)
    return BS("Grashalme, die Dir fast bis zu den den Knien gehen, wachsen "
	      "hier.");
  
  return BS("Du siehst hier kein Bueschel.");
}

string halme()
{
  if(wiese_da) 
    return BS("Sie sind gruen. Ob Du die mal brauchen kannst?");
  
  return BS("Sowas siehst Du hier nicht."); 
}

string wiese()
{
  if(wiese_da)
    return BS("Die Wiese erstrahlt in saftigem, "
	      "tiefen Gruen. Ein Bueschel mit besonders langen Halmen "
	      "faellt Dir auf.");

  return BS("Die Wiese erstrahlt in saftigem, tiefen Gruen.");
} 

SCHWIMMEN
