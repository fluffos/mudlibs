inherit "std/room";

#include <properties.h>
#include <language.h>

#include "/d/kristallwald/sargola/def_kristall.h"

      create()
      {
        ::create();
     
        SetProp( P_INT_SHORT, "Am See von Rhondonit" );
        SetProp( P_INT_LONG, 
      BS("Du stehst am Ufer des Sees von Rhondonit und kannst es entlanggehen. "
      +"Im Westen ragt das Almandin-Gebirge in die Hoehe. Deswegen ist es hier "
      +"auch schon ein wengig steinig. In der Mitte ist der See ist tiefblau - "
      +"scheint also recht tief zu sein. Im Nordosten liegt der Kristallwald. "
      +"Ein besonders grosser Baum liegt im Norden.") );
     
        SetProp( P_LIGHT, 1 );
        SetProp( P_INDOORS, 0 );
        SetProp(P_EXITS, ({"nordnosten"}));
	AddDetail("hoehe", BS("Das Gebirge ist sicher so an die - naja, so genau kannst "
		+"Du das auch nicht sagen..."));
        AddDetail( "boden", BS("Eine Art Wiese, die aber immer mehr in felsigen Untergrund " 
      +"uebergeht. In Richtung Wald nehmen wieder Blumen und Farnen ueberhand.")   );
       AddDetail( "himmel", BS("Der Himmel liegt tiefblau ueber Dir. Du legst Dich in die "
           +"Wiese und versinkst in den unendlichen Tiefen.")   );

       AddDetail( ({"tiefen","tiefe"}), BS("Am liebsten wuerdest Du noch viele Stunden hier "
      +"liegen und Wolken deuten.")   );
       AddDetail( "wolken", BS("Herrliche Schaefchen-Wolken praegen das Firmament.")   );
       AddDetail( "schaefchenwolken", BS("Das sind die, welche wie Daunenkissen aussehen "
      +"gutes Wetter vorhersagen, oder...?")   );
       AddDetail( "wetter", BS("Es ist einfach herrlich!")   );

       AddDetail( "firmament", BS("Es wird nur im Westen vom Gebirge und sonst vom Wald "
      +"begrenzt.")   );

       AddDetail( ({"kristallwald","wald"}), BS("Von hier aus siehst Du "   
          +"nur die kristall-artigen, weisslichen Baeume.")   );
       
        AddDetail( ({ "blumen", "blume" }), BS("Alle moeglichen Sorten von Blueten "
      +"mit roten, gelben und orangen Blueten findest Du hier ebenso wie Farne." ));
        AddDetail( ({"welle","wellen"}), BS ("Die Wellen schlagen sanft am Ufer auf.") );
        AddDetail( "wiese", BS("Ein gemuetlicher Platz, um auszuspannen und einmal mit "
      +"einer Person, die Du sehr magst, hierherzukomemn....") );

       AddDetail( "person", BS("Wer das ist, das musst schon Du wissen...")   );

        AddDetail( "oberflaeche", BS ("Sie ist leicht von den Wellen gekraeuselt.") );

        AddDetail( ({"rhondonit","See"}), BS("Vor Dir breitet sich der See aus. Leichte Wellen bringen die "
      +"Oberflaeche zum funkeln.") );
        AddDetail( "mitte", BS("Du kannst nichts Genaues ueber die Mitte des Sees sagen...") );

   AddDetail( "ufer", BS("Es geht leicht abwaerts ins Wasser.") );
        AddDetail( "wasser", BS("Das Wasser scheint zwar nicht kristallin wie alles andere hier "
      +"zu sein, ist aber auf eigenarteige Weise blaeulich-silbrige gefaerbt. Ob Du "
      +"darin baden kannst?") );
        AddDetail( ({"blueten","farne"}), BS ("Tja, welche das genau sind, weisst "
           +"Du auch nach intensivem Studium nicht.") );

        AddDetail( ({"baeume","baum"}), BS ("Er liegt weit im Norden und trotzdem kannst Du ihn sehen.") );
        AddDetail( ({"gebirge","almandin-gebirge","almandin"}), BS ("Es baut sich bedrohlich vor Dir auf.") );

   AddSound (DEFAULT_SOUND, "Nur das leise Gurgeln der Wellen ist zu hoeren.");
   AddSound (({"wellen","gurgeln"}) , "Sanft schlagen die Wellen an das Ufer.");
   
   AddSmell(DEFAULT_SMELL, "Die Pflanzen sind leider geruchslos.");

   AddItem(NPC_SEE+"wuest.c",REFRESH_DESTRUCT);

   AddCmd ( ({"bade", "baden", "schwimme", "schwimmen"}), "baden_gehen");
   AddCmd ( ({"springe", "spring"}), "springe");
   AddCmd ( "exit", "exit");
   AddExit( "nordosten", ROOM_SEE+"0606.c" );

      }


int springe (string str)
{
   if (!str) return 0;

   notify_fail ("Wohin willst Du denn springen?\n");

   if (str =="see" || str =="in den see" || str =="in see" )
   {
      write ( BS("Nein, nein! Hier gehst Du sicher nicht schwimmen - bei den Felsen?!?"));
      say(this_player()->name(WER,2)+" ueberlegt es sich anders und geht nicht "
         +"schwimmen.\n");
      return 1;
   }
   return 0;
}
     


int baden_gehen (string str)
{
   if (!str) return 0;

   notify_fail ("Wo willst Du denn schwimmen gehen?\n");

   if (str =="im see" || str =="im wasser" || str=="in wasser" || str =="in see")
   {
      write ( BS("Nein, nein! Hier gehst Du sicher nicht schwimmen - bei den Felsen?!?"));
      say(this_player()->name(WER,2)+" ueberlegt es sich anders und geht nicht "
         +"schwimmen.\n");
      return 1;
   }
   return 0;
}

exit(string str)
{
   mapping exits;
   object room;
   room = environment (TP);
   write(room);
   exits = room->QueryProp(P_EXITS);
   write(exits);
   return 1;
} 

