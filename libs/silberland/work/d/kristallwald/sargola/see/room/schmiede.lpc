#include "../def.h"

inherit "std/room";

int spiel(string str);		//Floetenspiel :)

string versinken(string str);

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  
  SetProp(P_INT_SHORT, "Eesthils Schmiede");
  SetProp(P_INT_LONG, 
	  BS("Du stehst in dem Arbeitsraum eines Schmiedes. Ein grosser "
	     "Amboss, eine Feuerstelle, einige sonderlich anmutende "
	     "Werkzeuge, ein paar Waffen liegen hier herum. Drei Fenster "
	     "erhellen den Raum."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  AddDetail(({"wand","waende"}),
	    "Die Waende sind aus schlichtem Holz.");
  AddDetail(({ "zimmer","arbeitszimmer" }), 
	    "Es ist schrecklich unordentlich hier. Alles liegt durcheinander.");
  AddDetail(({ "stelle","feuerstelle","feuer" }), 
	    "Sie ist schon lange erloschen - nur weissliche, verbrannte Kohle "
	    "zeigt, dass sie einmal gluehte.");

  AddDetail(({"kohlestuecke","kohle"}), 
	    "Kalte, weissliche Kohlestuecke liegen in dem Becken.");

  AddDetail(({"becken","kohlebecken"}), 
	    "Das Kohlebecken dient zum Erhitzen der Rohlinge.");

  AddDetail(({"rohling","rohlinge","eisenrohling"}), 
	    "Rohlinge sind die Ausgangsstoffe, um Waffen zu schmieden.");

  AddDetail(({"ausgangsstoffe","stoffe"}),
	    "Meist wird ein Eisenrohling als Ausgangsstoff verwendet.");

  AddDetail("erhitzen",
	    "Um den Rohling zu formen, muss das Eisen stark erhitzt sein.");
  
  AddDetail(({"waffen"}), 
	    "Du siehst einige Dolche, Schwerter, einen groesseren "
	    "Bi-Haender und eine Sense. Aber die Beschaffenheit dieser "
	    "Klingen ist seltsam...");
  
  AddDetail(({"sense","bi-haender","schwert","schwerter","dolch","dolche"}), 
	    "Sie lehnen an der Wand und wurden nie verwendet. Ihre Klingen "
	    "sind seltsam.");

  AddDetail(({"beschaffenheit","klinge","klingen"}), 
	    "Sie sind eigenartig grau. So als ob sie nicht "
	    "richtig erhitzt wurden. Seltsam...");

  AddDetail("grau", 
	    "Das muss das Schmieden mit kaltem Feuer sein.");

  AddDetail(({"werkzeug","werkzeuge"}), 
	    "Vermutlich sind das Formrohre.");

  AddDetail(({"rohre","formrohre"}), 
	    "Man benutzt sie, um die Rohlinge zu formen. Danach kann man "
	    "dann, nachdem man den Rohling zum Gluehen gebracht hat, "
	    "diesen mit Schmiedehammer und Amboss formen.");
  
  AddDetail("gluehen",
	    "Das Feuer glueht schon lange nicht mehr.");

  AddDetail(({"hammer","schmiedehammer"}), 
	    "Der Schmiedehammer ist ein besonders wichtiges Werkzeug beim "
	    "Schmieden von gluehendem Eisen.");

  AddDetail(({"rohstoff","eisen"}), 
	    "Eisen ist der Rohstoff um Waffen zu schmieden.");
  
  AddDetail(({ "raum","raeume" }), 
	    "Der Schmiederaum hier und der Wohnraum im Sueden.");
  
  AddDetail(({"schmiederaum","arbeitsraum"}),
	    "Da stehst Du gerade.");
  
  AddDetail(({"wohnraum","wohnstaette"}), 
	    "Durch die Tuere kannst Du nur einen Teil sehen...");     

  AddDetail(({"tuer","tuere"}) ,
	    "Sie fuehrt in den Wohnraum.");
  
  AddDetail("fenster", 
	    "Durch die Fenster dringt sanftes Licht in den Raum und "
	    "man kann die wunderschoene Gegend draussen sehen.");

  AddDetail("gegend",
	    "Von draussen siehst Du sie besser.");
  
  AddDetail("licht",
	    "Es wirkt weiss-milchig durch die Reflektionen der Baeume.");

  AddDetail(({"reflektion","reflektionen"}), 
	    "Das Licht wird hier im Kristallwald tausendfach von Aesten "
	    "gebrochen. Irgendwie schimmert alles auf eine eigenartige "
	    "Weise.");

  AddDetail(({"ast","aeste"}),
	    "Durch das Fenster kannst Du einige sehen.");
  
  AddDetail(({"wald","kristallwald"}), 
	    "Die Gegend hier nennt man Kristallwald.");

  AddDetail(({"baum","baeume"}), 
	    "Du kannst durch die Fenster weisse Baeume erkennen.");
  
  AddDetail("amboss", 
	    "Auf ihm wird immer nur herumgeschlagen...");

  AddDetail("instrument", 
	    "Wie sollte er wohl sonst den Rohlingen die richtige Form "
	    "geben?");

/*
  AddDetail("person", 
	    "Das muss der Schmied sein. Doch ist sein ganzer Koerper mit "
	    "Kristall ueberzogen!! Seine Haut hat eine silbrig-weissliche "
	    "Faerbung, und ist steinhart.");

  AddDetail(({"koerper","faerbung"}),
	    "Der Koerper ist zur Gaenze glaesern.");
  
  AddDetail("haut", 
	    "Sie ist komplett mit der Kristallschicht ueberzogen.");

  AddDetail(({"kristallschicht","schicht","kristall"}),
	    "Wie alles hier scheint auch Eesthils zu Kristall geworden zu "
	    "sein. Wie Du ihm wohl helfen koenntest...?");
*/
  
  AddDetail("boden", 
	    "Dicke Holzplanken bilden den Boden hier.");

  AddDetail(({"planken","planke","holzplanken"}), 
	    "Sie sind, wie alles in der Gegend hier, aus weisslichem Holz.");

  AddDetail("holz",
	    "Fein geschnittene Holzplanken.");

  AddDetail("decke", 
	    "Auch an der Decke siehst Du die Holzplanken.");
  
  AddSound(DEFAULT_SOUND, 
	   "Hier drin ist kein Laut zu hoeren.");
  
  AddSmell(DEFAULT_SMELL, 
	   "Ein wenig staubig riecht es hier.");
  
  AddItem(NPC "geesthil", REFRESH_DESTRUCT);
  
  AddExit("sueden", ROOM "wohnr");
}

void reset()
{
  object ob;

  ::reset();

  if(ob=present("meesthil")) ob->remove();
  if(ob=present("schuerze")) ob->remove();
  if(ob=present("schmiedehammer")) ob->remove();
}
