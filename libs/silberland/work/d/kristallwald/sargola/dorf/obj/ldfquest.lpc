/*
**************************************************
** 
** Quest-Item von der Land der Ferne Quest
**
**
**************************************************
*/


#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "ldfquest.h"


int zaehler;		

int setze_wert(int place, int value);
int frage_wert(int place);
void print();
void finish_quest();


create() {
  if (!is_clone(TO)) return;
  ::create();
  
  zaehler = 0;
  
  SetProp(P_SHORT, 0);
  SetProp(P_LONG,  0);
  SetProp(P_NAME, "");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"\nldfquest","abc"}) );

  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
}

void finish_quest()
{
  object ob, pl;
  pl = environment(TO);
  ob = deep_present("\nldfschwert",pl);
  tell_object(pl,
	"Du schnellst vor und rammst Ritter Kato das Schwert genau dort rein, wo Du\n"
	"sein Herz vermutest. Du spuerst fast keinen Widerstand - doch an den Augen\n"
	"von Kato kannst Du erkennen, dass Du wohl getroffen hast. Mit einem lauten -\n"
	"aber auch irgendwie erleichterten Seufzen - sackt Kato in sich zusammen.\n\n"
	"Die traurigen Raben verwandeln sich in die entfuehrten Kinder und Tiere und\n"
	"auch die ganze Burg und der See werden freundlicher und immer heller.\n\n"
	"Aus der Ferne siehst Du den Dschinn zu Dir fliegen, er nimmt Dich auf den\n"
	"Arm und fliegt zum Koenig zurueck.\n\n"
	"Der Koenig sagt uebergluecklich: Ich wusste, Du schaffst es!\n"
	"Der Koenig bedankt sich bei Dir aus vollem Herzen.\n"
	"Der Koenig sagt: Nun kann unser Land in Frieden leben.\n"
	"Der Dschinn nimmt Dich grinsend wieder auf den Arm und fliegt mit Dir wieder\n"
	"zu Lundin ins Silberland zurueck.\n"); 

  /*
  if( pl->GiveQuest("Land der Ferne") == 1)
  {
    write_file ("/d/kristallwald/sargola/log/ldfquest",
    sprintf ("%s  %s hat die LDF-Quest.\n",dtime(time()),CAP(pl->query_real_name())));
  }
  */
  ob->remove();
  ob = present("kato",find_object("/d/kristallwald/sargola/ldf/room/kato"));
  if(objectp(ob)) ob->remove();
  pl->move("/d/kristallwald/sargola/dorf/room/hlundin",M_SILENT|M_GO,"fliegt mit einem Dschinn",
   "weg","kommt mit einem Dschinn angeflogen");
  TO->remove();
}


//Initialisierung der Quest
int startquest(object ob)
{ 
  write_file(LOG "ldfquest.log",
    ctime()+": "+CAP(getuid(ob))+" beginnt die LDF-Quest.\n");
  return 1;
}


init()
{
  ::init();
  if (MENV && !query_once_interactive(MENV)) call_out("remove",0);
}



int frage_wert(int place)
{
  return wert[place];
}
int setze_wert(int place, int value)
{
  if(getuid(previous_object())!= getuid() )
  {
	write("Du bist nicht berechtigt, das zu tun...\n");
	return 0;
  }
  SetProp(P_NAME, "");
  wert[place] = value;
}

//zur Kontrolle :)
void print()
{
  int i;
  for(i=0;i<=(sizeof(wert)-1);i++)
  {
    printf("%O: %O\n",beschreibungen[i], wert[i]);
  }
}
