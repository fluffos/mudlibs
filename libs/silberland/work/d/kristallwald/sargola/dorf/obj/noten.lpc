#include "../def.h"

inherit "std/thing";

#define INSTRUMENTE ({"floete","querfloete","blockfloete","panfloete"})

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"noten","notenheft","heft","\nnotenheft"}));
  SetProp(P_SHORT, "Ein Notenheft");
  SetProp(P_LONG, 
	  BS("Dies ist ein klassisches Notenheft, mit dem der "
	     "geuebte Spieler sicherlich viel anfangen kann."));

  SetProp(P_NAME, "Notenheft");
  SetProp(P_GENDER, NEUTER);

  SetProp(P_MATERIAL, ({MAT_PAPER}));
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 1);
  
  AddReadDetail(({"heft","notenheft","lieder","lied","noten"}),
		"Das Notenheft ist randvoll elfischen Liedern und den "
		"dazugehoerenden Noten. Mit dem geeigneten Musikinstrument "
		"bringt man sicher wunderschoene Lieder hervor.");
  AddSpecialDetail(({"instrument","musikinstrument"}), "instrument");
  AddSpecialDetail(INSTRUMENTE, "floete");
}

string instrument(string key)
{
  return BS("Mit einer "+CAP(INSTRUMENTE[random(sizeof(INSTRUMENTE))])+
	    " vielleicht?");
}

string floete(string key)
{
  return BS("Oder doch lieber eine "+
	    CAP((INSTRUMENTE-({key}))[(random(sizeof(INSTRUMENTE)-1))])+
	    "?");
}
