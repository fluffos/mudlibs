#include "../def.h"

inherit "std/thing";

void create()      
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"tafel"}));
  SetProp(P_SHORT, "Eine Tafel");
  SetProp(P_LONG, "Auf der Tafel steht:\n\n"
	  "Ankunft des Pferdewagens alle 3-4 Minuten\n\n"
	  "Route:  Derlim - Elessar - Midas\n\n");
  AddReadDetail("tafel", QueryProp(P_LONG));
  SetProp(P_NAME, "Tafel");
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, FEMALE); 
  SetProp(P_WEIGHT, 2000);
  SetProp(P_NOGET, "Du laesst die Tafel lieber fuer andere "
	  "Abenteurer stehen.\n");
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
} 
 
