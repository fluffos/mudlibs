inherit "/std/thing";

#include <properties.h>
#include <language.h>

#include "../def.h"

#define MAXFILL 10

int fill;

create()
{
  //if (!is_clone(this_object())) return;
  ::create();

  //Beim Erschaffen Maximum-Fill !!
  fill = MAXFILL;
  SetProp(P_SHORT, "Eine Flasche Hirter Pils");
  SetProp(P_LONG, BS(
    "Dies ist eine Flasche besten Hirter Pilses. Du bemerktst das typische gold-braune Etikett und eine kleine Inschrift am Boden der Flasche. Diese Flasche ist noch @@fuellstand@@.\n"));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 10*MAXFILL);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NAME, "Flasche Hirter Pils");
  AddId (({"flasche", "bier", "hirter bier", "pils", "hirter pils", "flasche bier","hirter", "flasche hirter", "flasche pils"})); 

  AddDetail ( ({"etikett", "etikette"}), BS("Hirter Privat Pils ist eine nach alten boehmischen Rezepturen gebraute Bierspezialitaet der Privatbrauerei Hirt. Anders als die ueblichen bitteren Pilsbiere praesentiert sich das Hirter Privat Pils im Antrunk w
eich und schlank und ist im Abgang harmonisch zartbitter.\n"));
  AddDetail ("sargola", BS("Sargola wacht darueber, dass die wichtigen Dinge im Leben auch ihren Platz im Mud finden!\n"));
  AddDetail ("inschrift", BS("Du kannst sie lesen.\n"));
  AddReadDetail ("inschrift", BS("Diese Flasche ist speziell fuer MuddyMud gemacht! ;)\n"));
  AddDetail ("boden","Du kannst nur eine Inschrift entdecken.\n");
  AddDetail ("rezeptur", BS("Die wuerden viel gern wissen...\n"));
  AddDetail ("spezialitaet", BS("Das Hirter Privat Pils ist wahrlich eine Gaumenfreude.\n"));
  AddDetail ("brauerei", BS("Die Brauerei Hirt stellt seit 1270 feinste Biere her.\n"));  AddDetail (({"pilsbier","pilsbiere"}), BS("Das Hirter Pils hast 12,3 % Stammwuerze und 5,2 % vol. Alkohol.\n"));  AddDetail ("antrunk", BS("Der Antrunk des Hirter Pi
lses ist besonders sanft. Es umschmeichelt schier den Gaumen mit seinem excellenten Geschmack.\n"));
  AddDetail ("abgang", BS("Der Abgang des Hirter Pilses gestaltet sich, wie es sich fuer ein zuenftiges Pils-Bier gehoert, leicht bitter.\n"));
  AddDetail ("gaumen", BS("Du bemuehst Dich wirklich, schaffst es aber nicht, Deinen Gaumen naeher zu untersuchen.\n"));
  AddDetail ("geschmack", BS("Sowas sollte man nicht untersuchen!. ;)\n"));
  AddDetail (({"stammwuerze","wuerze"}), BS("Die Stammwuerze ist der Gehalt an Extrakt (Maltose, Dextrose,u.a.) in der Wuerze vor der Gaehrung.\n"));
  AddDetail ( "gaehrung", BS("Die Gaehrung ist der Prozess, der das Bier so sympathisch alkoholhaltig macht.\n"));
  AddDetail ( ({"maltose"}), BS("Maltose wird durch Spaltung von Staerke mit Hilfe des im Malz enthaltenen Fermentkomplexes Diastase gebildet.\n"));
  AddDetail ( "malz", BS("Malz ist angekeimtes Getreide (meist Gerste, auch Roggen), das vor dem Maelzen erste eingequollen und nach einiger Zeit wieder getrocknet wird. Zweck des Keimens ist die Umwandlung der Staerke in Maltose durch die Diastase.\n"));

  AddDetail ( "dexstrose", BS("Dexstrose wird auch Glucose oder Traubenzucker genannt.\n"));
  AddDetail ( "diastase", BS("Das ist ein staerkeabbauendens Enzym.\n"));
  AddDetail ( "enzym", BS("Enzyme, auch Fermente genannt, ermoeglichen chemische Umwandlungen im Organisamus.\n"));
  AddDetail ( ({"fermente","ferment"}), BS("Ein anderer Name fuer Enzyme.\n"));
  AddDetail ( "staerke", BS("Staerke ist ein hochmolekulares Polysaccharid, das den Chloroplasten der Pflanzen gebildet und in Knollen und Wurzeln in Form von kleinen, runden Koernchen gespeichert wird.\n"));
  AddDetail ( ({"korn","koernchen"}), BS("Na was Koernchen sind wirst Du ja wohl wissen!\n"));
  AddDetail ( "wurzel", BS("Das ist der Ort, wo sie gespeichert werden.\n"));
  AddDetail ( ({"chloroplaste","chloroplasten"}), BS("Dies sind die gruenen Farbkoerperchen in der Pflanze.\n"));  
  AddDetail ( "polysaccharid", BS("Das ist stinknormaler Mehrfachzucker! Zum Beispiel Staerke.\n"));  
 

  AddCmd ( ({"trinke","schlucke", "trink"}),"trinken");
}

string fuellstand()
{
  return (fill == MAXFILL ? "ganz voll" : "zu "+ 100*fill/MAXFILL +"% gefuellt");
}



int trinken(string was)
{	

	int alc;


  notify_fail( "Hmm. So wird das nix. Wenn Du einen Schluck Hirter zu Dir nehmen\n"+
    "willst, tippe 'trinke bier'.\n");


  if (!was) return 0;


  if (was=="bier" || was =="hirter"||was=="pils"||was=="hirter pils" || was=="hirter bier")
  {


   if (fill >0)
   {
    write( BS("Du setzt die kuehle Flasche an Deine Lippen und nimmst einen kraeftigen Schluck. Jetzt hast du Deinen Level endlich wieder.\n"));
    say( BS(TP->name(WER)+" nimmt einen Schluck Hirter und sieht befriedigt aus.\n"));
    
    alc = TP->QueryProp(P_ALCOHOL);
    TP->SetProp(P_ALCOHOL, alc+20);

    fill--;
   }
   
   if (fill == 0)
    {
      write(BS("Du hast die Flasche bis zur Neige genossen und musst etwas warten, bis sie sich etwas erholt hat...\n"));
    }

    SetProp(P_WEIGHT, 10*fill);
    return 1;
  }

  return 0;

}

reset()
{	
	::reset();
	fill=1;
}
