/*
** Besessenheit - wenn man zu lange bei der alten Zeder steht...
**
** Man wird zu zufaelligen verben und wegen gezwungen...
**
*/

inherit "std/thing";
#include <properties.h>
#include "/d/kristallwald/sargola/def_kristall.h"


	
	
void create()
{
	
   if (!is_clone(this_object())) return;
   ::create();

   SetProp(P_SHORT, 0);
   SetProp(P_WEIGHT, 0);
   AddId(({"b","\nbesessenheit"}));
   AddCmd("liebe","liebe");
}
liebe(string str)
{
  if(str=="abc")
  {
    TP->command_me("jubel");
    return 1;
  }
  else
   return 0;
}

string extra_look()
{
	if(TP->QueryProp(P_GENDER) == MALE)
		return BS("Er ist von einer fremden Macht besessen.");
	return BS("Sie ist von einer fremden Macht besessen.");
}


