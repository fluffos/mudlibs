inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"


      create()      
{        if (!is_clone(this_object()))           return;
        ::create();
   
        AddId ( ({"setzling","zedernsetzling"}) );
        SetProp(P_SHORT, "Zedern-Setzling");
        SetProp(P_LONG, BS("Das ist ein Setzling, aus dem, wenn man ihn ein"
        	+"pflanzt, eine Zeder entsteht.\n"));
        SetProp(P_NAME, "Setzling");
        SetProp(P_ARTICLE, 1);
        SetProp(P_MATERIAL, MAT_MISC_DECIDUOUS_WOOD );
        SetProp (P_GENDER, MALE); 
        SetProp (P_WEIGHT, 200);
        SetProp (P_VALUE, 0);
        SetProp (P_NOBUY, 1);
        SetProp(P_NOSELL, 1);

} 
 
