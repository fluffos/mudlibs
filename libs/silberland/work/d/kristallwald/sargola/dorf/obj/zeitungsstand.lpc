/*
**  Uebernommen aus /obj/zeitungsautomat.c
**
**  2002-08-22  PROtheG  Zeitung am Boden liegend is pfui,
**                       Jetzt haengt sie an einem Staender
*/

inherit "/std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include <config.h>
#include <www.h>

#define SLP "/p/service/obj/zeitung/slp"
#define RENEW_NEWS

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT,"Ein Zeitungsstaender");
  SetProp(P_LONG, 
	  BS("Du siehst einen Zeitungsstaender, an dem Exemplare der "+
	     MUDNAME+"-Presse, kurz SLP, der Zeitung des "+MUDNAME+"s "
	     "haengen. ")+
	  BS("Hier stehen immer die neuesten Nachrichten und Geruechte "
	     "drin. Die Zeitung kostet nichts, daher kannst Du Dir einfach "
	     "eine nehmen 'nimm zeitung'."));

  SetProp(P_NAME,"Zeitungsstaender");
  AddId(({"zeitung","staender","zeitungsstaender","slp"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_NOGET, "");
  SetProp(P_MATERIAL, ([MAT_PAPER:95,MAT_MISC_WOOD:5]));
  SetProp(P_WWWINFO, "Man kann die Zeitung auch "+
      "<A HREF=\"http://"+SERVER+MUDWWW+"?"+REQ+"="+R_NEWS+"\">lesen</A>.\n");
  
  AddCmd(({"nehm","nimm","nehme"}), "zeitung_nehmen");
}

nosave int zeitung_nehmen(string str)
{
  if(!str) return 0;
  
  if(str=="zeitung von staender" || str=="zeitung von zeitungsstaender" ||
     str=="zeitung vom staender" || str=="zeitung vom zeitungsstaender")
    return write(BS("Es reicht wenn Du die Zeitung einfach nimmst "
		    "'nimm zeitung'.")), 1;
  
  return 0;
}

int get(mixed targ)
{
  object ob;
  if(!targ || !interactive(targ) || targ != TP) return 0;

  if (ob=present("zeitung", targ))
  {
#ifdef RENEW_NEWS
    ob->remove();

    clone_object(SLP)->move(targ, M_GET);

    write(BS("Du wirfst Deine alte Zeitung weg und "
	     "nimmst Dir ein neues Exemplar vom Zeitungsstaender."));

    say((targ->Name(WER)+" wirft "+targ->QueryPossPronoun(FEMALE,WEN,SINGULAR)+
	 " alte Zeitung weg und nimmt sich ein neues Exemplar vom "
	 "Zeitungsstaender."));

    return 1;
#else
    write(BS("Du hast bereits eine Zeitung."));

    return ME_CANT_BE_TAKEN;
#endif
  }

  clone_object(SLP)->move(targ, M_GET);

  write(BS("Du nimmst Dir eine Zeitung vom Zeitungsstaender."));

  say(BS(targ->Name(WER) + " nimmt sich eine Zeitung vom Zeitungsstaender."));

  return 1;
}

int move(mixed target, int method, string mess)
{
  if ((method & M_GET) && living(target))
    // Da sich das Objekt (der Automat) nach dem Nehmen nicht
    // im Inventory des Nehmers befindet, nimmt put_and_get::pick_obj()
    // an, dass das Nehmen nicht erfolgreich war. Wir bestaetigen das
    // hier einfach, da aber P_NOGET=="" ist, merkt der Spieler nix :)
    return get(target), ME_CANT_BE_TAKEN;
  else
    return ::move(target,method,mess);
}
