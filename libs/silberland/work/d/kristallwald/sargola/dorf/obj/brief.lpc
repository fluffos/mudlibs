 
inherit "/std/thing";
inherit "/mail/nedit";
inherit "/std/more";
#include <properties.h>
#include <language.h>
#include "../def.h"

int lies(string str);
int sende(string str);

adresse();

create()      
{        if (!is_clone(this_object()))           return;
	::create();

  AddId ( ({"brief","\nldfquestbrief"}) );
  SetProp (P_SHORT, "Lundins Brief");
  SetProp (P_LONG, "Das ist der Brief, den Du fuer Lundin zur Post bringen "
  	"sollst. Er ist verschlossen, aber Du kannst eine Adresse erkennen.");
  AddDetail("adresse","Du kannst sie lesen.");
  AddReadDetail("adresse",#'adresse);
  
  
  SetProp (P_NAME, "Brief");
  SetProp (P_GENDER, MALE); 
  SetProp (P_WEIGHT, 5);
  SetProp (P_VALUE, 3);
  SetProp (P_MATERIAL, ({MAT_PAPER}));
  SetProp (P_NODROP,1);
  SetProp (P_NOSELL,1);
  SetProp (P_NOBUY,1);
  
  SetProp( P_INFO, BS("Auch mit solch fiesen Tricks bekommst Du nicht "
  		"raus, was Lundin geschrieben hat!"));

AddCmd( ({"lies"}),"lies");
AddCmd( ({"sende"}), "sende");
}  


int sende(string str)
{
  notify_fail("Was moechtst Du senden?\n");
  if(!str || str!="brief") return 0;
  
  if(!TP) return 0;
  
  if( environment(TP) != find_object("/d/kristallwald/sargola/dorf/room/post"))
  {
    write("Du bist doch gar nicht in der elfischen Post!\n");
    return 1;
  }
  
  write("Gerade als Du den Brief aufgeben willst, merkst Du, dass die Adresse "
  "flammend zu leuchten beginnt. Eine lodernde Flammenschrift. Und Du bemerkst "
  "auch, dass der Apfel zu Gold geworden war ... Du begreifst gar nichts mehr. "
  "\n\n"
  "Ploetzlich hebt sich der Wind und ein imposanter Geist entsteht vor Dir.\n"
  "\n"
  "Seine Stimme ist ein einziges Brausen:\n"
  "\n"
  "Du traegst das Zeichen in Deiner Hand!\n"
  "Du bist "+((TP->QueryProp(P_GENDER) == MALE) ? "der":"die")+", den ich holen soll!"
  "Der Geist nimmt Dich auf seinen starken Arm und es droehnt und singt um Dich\n"
  "herum.\n\n"
  "Er fliegt mit Dir los ..\n");
  if(find_call_out("fliegen")==-1)
  	call_out("fliegen",4); 
  return 1; 
}  

fliegen()
{
  write("Du fliegst durch durch Tag und Nacht weit ueber den Wolken.");
  call_out("fliegen1",4);
}

fliegen1()
{
  write("Um Dich leuchten Sonne, Mond und Sterne ...\n");
  call_out("fliegen2",4);
}

fliegen2()
{
  write("Weit in der Ferne kannst Du etwas Gruenes erkennen das in blauem klaren Wasser\n"
  "daliegt. Das muss das Land der Ferne sein.\n");
  write("Du schwebst mit dem Geist hinab und landest auf einem Strand.\n");
  TP->move("/d/kristallwald/sargola/ldf/room/strand3", M_GO|M_SILENT);
  TO->remove();
}
  
int lies(string str)
{
  tell_object(TP, BS("Ob Du das wirklich willst? Du solltest ihn einfach mit 'sende brief' aufgeben."));
  return 1;
}


adresse()
{
  string gs;
  if(TP->QueryProp(P_GENDER)==MALE) gs = "er";
  else gs = "sie";
  
  return (
  "Du liest: \n"
  "\n"
  "An den\n"
  "\n"
  "    KOENIG\n"
  "    LAND DER FERNE\n"
  "\n"
  "\n"+
  CAP(gs)+ "ist auf dem Weg, "+gs+", den DU so lange\n"
  "gesucht hast. "+CAP(gs)+" reist durch Tag und Nacht,\n"
  "und "+gs+" haelt in seiner Hand ein Zeichen,\n"
  "den goldenen Apfel.\n");
}
