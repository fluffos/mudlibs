#include "../def.h"

inherit "std/thing";

void create()      
{    
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"schluessel","\nquestschluessel"}));
  SetProp(P_SHORT, "Ein grosser Schluessel");
  SetProp(P_LONG, 
	  BS("Der Schluessel ist ziemlich gross und schwer. "
	     "Wohl aus Eisen gefertigt."));
  SetProp(P_NAME, "Schluessel");
  SetProp(P_GENDER, MALE); 

  SetProp(P_MATERIAL, MAT_IRON);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);
}  

