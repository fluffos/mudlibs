inherit "std/thing";
#include <properties.h>
#include <language.h>
#include <defines.h>

void create()
{
   if (!is_clone(this_object())) return;
      ::create();

     SetProp(P_SHORT, "Ein Buch ueber Elessar");
     SetProp(P_LONG,    "Dies ist ein Buch mit der Geschichte der Stadt Elessar. Es ist eine schoene 
Abschrift "
      +"und hat einige hundert Seiten. Du kannst es lesen.\n");
     SetProp(P_NAME, "Buch");
          SetProp (P_NOBUY, 1);
     AddId ( ({"buch","geschichtsbuch"}) );
     AddReadDetail ("buch", 
      "\n"
      +"\n"
      +"\n"
      +"\n"
      +"                      Geschichte und Werdegang                  \n"
      +"                          der Stadt Elessar                    \n"
      +"\n"
      +"\n"
      +"     Die Geschichte und insbesondere die Entstehung der Stadt       \n"
      +"     haengt eng mit der Entwicklung der Waldelfen zusammen. Vor     \n"
      +"     langer Zeit, als die Elfen noch mit den Zwergen im Streit      \n"
      +"     lagen, entschieden die Aeltesten, weiter nach Norden zu        \n"
      +"     ziehen. Sie ueberquerten das Gebirge suedlich von Elessar      \n"
      +"     und entdeckten dieses Tal.                                     \n"
      +"     Sie fanden hier eine neue Heimat und lebten in Eintracht       \n"
      +"     mit der Natur - fanden hier alles, um das Ueberleben des       \n"
      +"     Stammes zu sichern. Einige Gruppen Elfen wanderten weiter      \n"
      +"     nach Norden. Anfangs unterhielten die Siedlungen durch         \n"
      +"     Boten Kontakt, doch der brach im Laufe der Zeit ab. Das        \n"
      +"     war zu der Zeit, als die Geruechte kursierten, Wesen aus       \n"
      +"     dem polaren Norden wuerden immer weiter in den Sueden vor-     \n"
      +"     dringen.                                                       \n"
      +"     Heute haben die Waldelfen von Elessar keine Feinde. Sie        \n"
      +"     unterhalten Handelsbeziehungen mit Menschen aus Midas und      \n"
      +"     sogar Zwergen aus Felonia.                                     \n"
      +"     Viele Winter und Sommer lang herrschte hier Frieden. Doch      \n"
      +"     vor einigen Jahren kam ein Magier aus den Gebieten weiter      \n"
      +"     im Westen und siedelte sich im Gebirge an. Keiner wusste       \n"
      +"     genau, was der dort eigentlich trieb. Es haeuften sich Erd-    \n"
      +"     beben und Steinschlaege, aber vorerst wurde das nicht dem      \n"
      +"     Magier zugeschrieben. Sein Ziel war, das ganze Tal in Stein    \n"
      +"     zu verwandeln. Der Himmel wurde dunkel, es begann zu regnen    \n"
      +"     Steinschlaege und Lawinen vom Gebirge - es war das Armaged-    \n"
      +"     don. Die Elfen fluechteten weit in den Sueden.                 \n"
      +"     Erst nach 3 Tagen wurden die mutigsten als Boten geschickt     \n"
      +"     um zu erkunden, was passiert sei. Der ganze Wald und der See   \n"
      +"     sind so, wie sie sich heute dem Abenteurer zeigen. Es war      \n"
      +"     ein Schock, aber schliesslich war das unser zu Hause und wir   \n"
      +"     beschlossen, hier zu leben. Wir lernten schnell, uns zurecht   \n"
      +"     zu finden.\n");

     SetProp(P_GENDER, NEUTER);
     SetProp(P_VALUE, 350);
     SetProp(P_WEIGHT, 300);
}
 
