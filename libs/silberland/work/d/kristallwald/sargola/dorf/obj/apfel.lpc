inherit "std/food";
#include <properties.h>
#include <food.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

int gold;
int set(int i);
int get();

string detail_gold();

int iss(string str);

      create()      
{        if (!is_clone(this_object()))           return;
        ::create();
	gold = 0;
        AddId (({"apfel","\nldfapfel"}));

        
        SetProp (P_NAME, "Apfel");
        SetProp (P_GENDER, MALE);
	SetProp (P_FOOD_INFO, ([F_HEAL:0, F_SOAK:0, F_DRINK:0]) ); 
        SetProp (P_WEIGHT, 200);
        SetProp (P_VALUE, 10);
        SetProp (P_NOBUY, 1);
        SetProp (P_NOSELL,1);
        SetProp (P_NODROP,1);
	AddCmd(({"iss","esse","verspeise","ess","verspeis"}),"iss");
        AddDetail("gold",#'detail_gold);
        
}  

_query_short()
{
  if(gold)
    return "Ein goldener Apfel";
  return "Ein roter Apfel";
}
  
_query_long()
{
  if(gold)
    return BS("Ein goldener Apfel, der schwer in Deiner Hand liegt. Aber "
      "irgendwie hast Du das Gefuehl, dass es kein echtes Gold ist.");

  return BS("Ein saftiger, roter Apfel der Dich zum Reinbeissen anregt.");
}

string detail_gold()
{
  if(gold)
  {
    return BS("Es scheint nur magisches zu sein - also nicht soviel Wert, "
      "wie echtes Gold ... schade.");
  }
  return BS("Du kannst an dem Apfel nichts goldenes entdecken.");
}

int set(int i)
{
  if(i != 1 && i!=0) return 0;
  
  //goldener Apfel
  if(i==1)
  {
    TO->SetProp(P_VALUE, 100);
  }
  else if(i==0)
  {
    TO->SetProp(P_VALUE,10);
  } 
  gold = i;
  return 1;
}
int get()
{
  return gold;
}


int iss(string str)
{
  notify_fail("Was moechtest Du essen?\n");
  if(str!="apfel") return 0;
  if(gold)
  {
    tell_object(TP, BS("Du kannst doch keinen goldenen Apfel essen!"));
    return 1;
  }    
  tell_object(TP, BS("Du bist so stolz auf den Apfel, den isst Du sicher nicht!"));
  return 1;
}
