#include "../def.h"

#define RASTEN 0
#define NACH_ELESSAR 1
#define NACH_MIDAS 2
#define NACH_DERLIM 3

#define ELE "/d/kristallwald/sargola/dorf/room/0714"
#define MID "/d/ebene/Midas/room/room_d5"
#define DER "/d/huegelland/raballion/hobbits/room/hauptplatz"

inherit "std/transport";

nosave int rasten;

void create()
{
  ::create();
  
  SetProp(P_NAME, "Pferdewagen");
  SetProp(P_GENDER, MALE);
  
  SetProp(P_INT_SHORT, "Im Pferdewagen");
  SetProp(P_INT_LONG, 
	  BS("Du sitzt in einem leicht wankenden Pferdewagen. Rechts und "
	     "links befinden sich Baenke, in der Mitte kannst Du Dein "
	     "Gepaeck abstellen. Zwei alte, aber dennoch stabil wirkende "
	     "Raeder, welche mit eisernen Streben verstaerkt wurden, "
	     "tragen den Wagen sicher ueber das Land. Zwei hellbraune, "
	     "zottelige Haflinger sind vor dem Wagen eingespannt."));

  AddId(({"wagen", "pferdewagen"}));

  SetProp(P_SHORT, "Ein Pferdewagen macht hier Rast");
  SetProp(P_LONG, 
	  BS("Du siehst einen leicht wankenden Pferdewagen. Zwei alte, aber "
	     "dennoch stabil wirkende Raeder, welche mit eisernen Streben "
	     "verstaerkt wurden, tragen den Wagen sicher ueber das Land. "
	     "Zwei hellbraune, zottelige Haflinger sind vor dem Wagen "
	     "eingespannt."));
  
  AddDetail("baenke",
	    "Die Baenke sind links und rechts und dienen wohl, um sich "
	    "waehrend der Fahrt zu regenerieren.");

  AddDetail("mitte",
	    "In der Mitte ist genug Platz, um Dein Gepaeck abzustellen.");

  AddDetail("platz",
	    "In der Mitte ist genug Platz.");

  AddDetail("gepaeck",
	    "Du hast keines dabei, aber wenn Du eines haettest, haettest "
	    "Du hier genug Platz.");

  AddDetail(({"rad","raeder"}),
	    "Die Raeder sind zwar alt, aber sie wirken trotzdem stabil und "
	    "scheinen auch einigermassen rund zu sein. Eiserne Streben "
	    "verhindern, dass sie bald auseinanderbrechen.");

  AddDetail("streben",
	    "Die Streben sind aus massivem, dickem Eisen und stabilisieren "
	    "das Rad des Pferdewagens.");

  AddDetail(({"pferd","pferde","haflinger"}),
	    "Die zwei staemmigen, hellbraunen Haflinger sind laengere "
	    "Ritte sicherlich gewohnt und freuen sich schon darauf, "
	    "Dich durch das halbe Silberland zu kutschieren.");
  
  AddSmell(({DEFAULT_SMELL,"pferd","pferde","haflinger","pferdewagen","wagen"}), 
	   "Hier riecht es stark nach Pferd.");
  
  SetProp(P_NOREST, 1);
  SetProp(P_TRANSPARENT, 1);
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE:20, ENV_TERRAIN:TT_OTHER]));
  SetProp(P_DEPARTMSG,({
    "Der Pferdewagen faehrt los.\n\n",
    "Die Haflinger beginnen ihren Trab.\n"}));

  SetProp(P_ARRIVEMSG,({
      "Der Pferdewagen macht in @@QueryArrived@@ Rast.\n"
      "Die Haflinger bleiben stehen und warten geduldig, bis Du aus"
      "gestiegen bist.\n",
      "Ein Pferdewagen kommt an.\n" }));

  SetProp(P_ENTERMSG,({
      "betritt den Pferdewagen",
      "steigt auf den Pferdewagen auf",
      "klettert auf den Pferdewagen"}));

  SetProp(P_LEAVEMSG,({
      "verlaesst den Pferdewagen",
      "klettert vom Pferdewagen herunter"}));

  SetProp(P_MAX_PASSENGERS, 4);

  SetProp(P_LEAVEFAIL, "Der Wagen ist gerade in voller Fahrt...");

  SetProp(P_ENTERFAIL, 
	  "Leider koennen immer nur 4 Leute von den Haflingern "
	  "befoerdert werden.");
  
  AddSound(DEFAULT_SOUND, "Du hoerst das Trampeln der Haflinger.\n");
  
  AddCmd(({"steig", "steige", "spring", "springe",
	     "besteig", "besteige", "betritt", "betrete"}), "steige");
  
  AddFun("rasten", 0);
  
  AddRoute(ELE, 30, 0, "Elessar", 
	   ({"elessar","elfendorf","kristallwald"}), "in den Kristallwald");
  
  AddFun("nachmidas", 4);
  
  AddMsg("Der Pferdewagen zieht mit einem gewaltigen Tempo durch den "
	 "Kristallwald.\n\n", 4);
  AddMsg("Du siehst die kristallenen Eichen vorbeirauschen.\n\n", 8);
  AddMsg("Der Pferdewagen schlaengelt sich einen engen Pfad entlang, in das "
	 "Gebirge hinauf.\n\n", 8);
  AddMsg("Der Pferdewagen rumpelt ueber grobe Steine und es geht wieder "
	 "bergab.\n\n", 6);
  AddMsg("Der Pferdewagen faehrt nun durch den legendaeren Silberwald.\n\n", 6);
  AddMsg("Der Pferdewagen passiert nun das Stadttor von Midas.\n", 6);
  
  AddFun("rasten", 0);
  
  AddRoute(MID, 30, 0, "Midas",
	   ({"midas","menschenstadt","silberwald"}), "nach Midas");
  
  AddFun("nachelessar", 4);
  
  AddMsg("Der Pferdewagen verlaesst Midas und faehrt in Richtung "
	 "Silberwald los.\n\n", 6);
  AddMsg("Der Pferdewagen schlaengelt sich einen engen Pfad hinauf "
	 "ins Gebirge.\n\n", 8);
  AddMsg("Aus dem Fenster siehst Du einen grossen Steinadler, der ueber "
	 "dem Pferdewagen kreist.\n\n", 8);
  AddMsg("Das Gelaende wird wieder etwas ebener.\n\n", 3);
  AddMsg("Die weissen Baeume des Kristallwaldes beginnen hier.\n\n", 8);
  
  AddFun("rasten", 0);
  
  AddRoute(ELE, 30, 0, "Elessar",
	   ({"elessar","elfendorf","kristallwald"}), "in den Kristallwald");  

  AddFun("nachderlim", 4);
  
  AddMsg("Der Pferdewagen richtet sich nach Sueden.\n\n", 4);
  AddMsg("Der Pferdewagen verlaesst den Wald und beginnt, das Huegelland "
	 "zu durchqueren.\n\n", 8);
  AddMsg("Du siehst draussen friedliche Weiden und Wiesen.\n\n",8);
  AddMsg("Die Haeuser von Derlim kommen langsam in Sicht.\n\n", 4);
  
  AddFun("rasten", 0);
  
  AddRoute(DER, 30, 0, "Derlim",
	   ({"derlim","hobbingen","hobbitdorf"}), "nach Derlim");
  
  AddFun("nachelessar", 4);
  
  AddMsg("Der Pferdewagen verlaesst Derlim und faehrt nach Norden.\n\n", 6);
  AddMsg("Draussen rauschen saftige, gruene Wiesen und Weiden vorbei.\n\n", 8);
  AddMsg("Am Horizont erkennst Du bereits die Umrisse des Kristallwaldes.\n\n",
	 8);
  AddMsg("Die weissen Baeume des Kristallwaldes beginnen hier.\n\n", 8);
  
  Start();
}

varargs string GetExits(object viewer)
{
  if(rasten)
    return "Du kannst vom Pferdewagen absteigen, wenn Du willst.\n";

  return "";
}

void nachmidas()  
{ 
  rasten=0;
  SetProp(P_INT_SHORT, "Im Pferdewagen unterwegs nach Midas");
}

void nachelessar()
{ 
  rasten=0;
  SetProp(P_INT_SHORT, "Im Pferdewagen unterwegs nach Elessar");
}

void nachderlim() 
{ 
  rasten=0;
  SetProp(P_INT_SHORT, "Im Pferdewagen unterwegs nach Derlim");
}

void rasten()     
{ 
  rasten=1;
  SetProp(P_INT_SHORT, "Im Pferdewagen");
}

nosave int steige(string str)
{
  string arg, arg2;

  if(MENV != ENV(TP) && ENV(TP) != this_object()) return 0;

  notify_fail("Willst Du auf oder aus dem Pferdewagen steigen?\n");

  if(!str) return 0;

  if((sscanf(str, "%s %s", arg, arg2) != 2) && !id(str)) return 0;

  if(!id(str) && !id(explode(arg2, " ")[0])) return 0;

  if(TP->QueryGuest()) 
    {
      notify_fail("Du traust Dich nicht auf eine so lange Reise zu gehen!\n");
      return 0;
    }

  if(id(str) || arg=="auf")
    return notify_fail("Aber der Pferdewagen ist doch gar nicht hier!\n"), 
      Enter();

  if(arg=="von" || arg=="aus")
    return notify_fail("Aber der Pferdewage ist doch gar nicht hier!\n"), 
      Leave();
  
  return 0;
}
