#include "../def.h"

inherit "std/mnpc";
inherit "std/player/moneyhandler";

void create()
{   
  string n;

  if(!is_clone(ME)) return;
  ::create();
  
  n=WMASTER->GetEWName(MALE);

  SetProp(P_SHORT, "Elf "+n+", ein Waechter Elessars");
  SetProp(P_LONG, 
	  BS("Ein Elfenwaechter von kraeftiger Statur und von stattlicher "
	     "Koerpergroesse steht vor Dir. Er ist fuer die Sicherheit von "
	     "Elessar verantwortlich. Er traegt einen Kristallpanzer und "
	     "Stiefel. Ein Dolch steckt in einem Lederschaft an seiner "
	     "Huefte."));

  SetProp(P_ARTICLE, 1);

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:40]));

  SetProp(P_DIE_MSG, 
	  " sagt: \"Ich habe doch Frau und Kind!\" und verendet dann.\n");
  SetProp(P_NAME, ({"Elfenwaechter "+n, "Elfenwaechters "+n, 
		      "Elfenwaechter "+n, "Elfenwaechter "+n}));
  SetProp(P_GENDER, MALE);

  AddId(({"waechter","elfenwaechter","elf", lower_case(n), "NOCONTROL", 
	    ELESSARELF}));

  create_default_npc(19+random(3));

  SetProp(P_HANDS,({" mit blossen Haenden", QueryProp(P_HANDS)[1],
		      DT_BLUDGEON}));

  SetProp(P_AGGRESSIVE, ([P_GUILD:(["Nekromanten":0.3])]));
  
  SetProp(P_RESISTANCE_STRENGTHS, // siehe spielershell
      ([ DT_MAGIC : -0.2,
         DT_MIND  : -0.1,
         DT_HOLY  :  0.1,
         DT_UNHOLY:  0.1 ]) );
    
  SetGuardProtection(50, GUARD_LOCATION);

  SetProp(P_ALIGN, 400+random(100));

  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 180+random(20));
  SetProp(P_WEIGHT, 65000+random(8000));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  
  SetProp(P_REJECT, ({ REJECT_DROP,
	 n+"meint: Trag das doch selber!\n"}));

  SetProp(P_MSGOUT, "entdeckt keine Feinde und geht weiter");
  SetProp(P_MSGIN, "kommt nach Feinden suchend herein");
 
  SetChats(5,({
    n+" rueckt sich seinen Panzer zurecht.\n",
      n+" beobachtet genau das Dickicht unter ihm.\n",
      n+" sagt: \"Geh woanders hin - ich muss arbeiten!\"\n",
      BS(n+" glaubt sich unbeobachtet und nimmt einen "
	 "Schluck Elfenschnaps zu sich.")}));

  AddDetail("koerper", 
	    "Fuer einen Elfen ist er wirklich staemmig.");

  AddDetail(({"wams","lederwams"}), 
	    "Er schuetzt den Waechter vor Angriffen.");

  AddDetail(({"dolch"}), 
	    "Es ist ein schmaler Dolch, der in einem Lederschaft steckt.");

  AddDetail(({"schaft","lederschaft"}), 
	    "An seiner linken Huefte ist ein Schaft ange"
	    "bracht, in dem der Dolch steckt.");

  AddDetail(({"panzer","kristallpanzer"}), 
	    "So einen Panzer hast Du noch nie gesehen. Er ist aus weissem, "
	    "glaenzenden Material, das sehr leicht zu sein scheint.");

  AddDetail("material", 
	    "Es scheint so beschaffen zu sein wie der Kristallwald - eine "
	    "Art Kristallpanzer.");
  
  AddInfo(DEFAULT_INFO, 
	  "sagt: Da fragst Du am besten Aerendil.\n");

  AddInfo(({"elessar","elfendorf", "elfenstdt"}) , 
	  "Das schoenste aller Doerfer.",
	  "nickt: ");

  AddInfo("waechter", 
	  "Wir sind hier, um Elessar vor den hinterhaeltigen Angriffen der "
	  "Wegelagerer zu schuetzen.",
	  "sagt: ");

  AddInfo(({lower_case(n), "name"}), 
	  "Es geht nicht um mich, sondern um Elessar!",
	  "sagt: ");

  AddInfo(({"wegelagerer","feinde"}), 
	  "Irgendwo haben diese Kroeten ein Versteck und "
	  "lauern uns des oefteren aus dem Hinterhalt auf.",
	  "sagt: ");

  AddInfo(({"kristall","kristallwald"}), 
	  "Aerendil kann Dir hier weiterhelfen.",
	  "sagt: ");

  AddInfo("doore", 
	  "Im Nordwesten der Stadt wirst Du den Doore finden.", 
	  "sagt: ");

  AddInfo("sargola", 
	  "Sargola - hach, das ist ein wahrlich guter Kaempfer.", 
	  "sagt: ");

  AddInfo("aerendil", 
	  "Du wirst ihn in der Bibiliothek im Nordosten der Stadt finden.",
	  "sagt: ");

  AddInfo("post", 
	  "Sie ist im suedlichen Zentrum der Stadt.",
	  "sagt: ");

  AddInfo(({"zwerge","felonia","zwerg"}), 
	  "Dieses goldgierige Pack! Ich habe zu tun!",
	  "sagt: ");

  AddInfo("goblins",
	  "Die Goblins stellen, wie die Wegelagerer, eine Gefahr fuer "
	  "unser Dorf dar.",
	  "sagt: "); 

  AddInfo(({"haendler","ranadrion","laden"}),
	  "Wir bewachen natuerlich auch den Laden von Ranadrion.",
	  "meint: ");

  //********************  
  //Props zum moving NPC  
  //********************
  SetProp(P_MNPC_AREA, ROOM "1_");
  SetProp(P_MNPC_DEFAULTROOM, ROOM "1_0614");
  // (Zeit bis erster Schritt, mindestens zeit aller weiteren schritte, wird zu zahl 2 addiert
  SetProp(P_MNPC_WAIT, ({30,40,40}));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS+MOV_INDOORS+MOV_BACKWARDS+MOV_MOVES);
  
  //***********  
  //Nur, wenn die euid gesetzt ist, kann geclont werden  
  //***********
  SUID;

  CLONEME(ARMOUR "kpanzer");

  CLONEME("/p/armour/boots/lederstiefel");

  if(!random(4))
    CLONEME(ARMOUR "leggings");

  if(!random(4))
    CLONEME(ARMOUR "handschuhe");

  if(!random(4))
    CLONEME(ARMOUR "umhang");

  if(!random(5))
    CLONEME(ARMOUR "armschienen");

  if(!random(6))
    CLONEME(ARMOUR "ring");
  
  if(!random(3))
    AddMoney(100+random(200));

  command("ziehe alles an");
  
  CLONEME(WEAPON "kdolch");

  SetProp(P_SPELLRATE,35);
  SetProp(P_NOMAGIC, 10);

  AddSpell(1, 250,
   n+" blendet Dich mit gleissenden Blitzen.\n",
   n+" blendet @WEN mit gleissenden Blitzen.\n",
   ({DT_LIGHT,DT_LIGHTNING}), ([SP_SHOW_DAMAGE:0]));

  AddSpell(2, 270,
    n+" zerschnetzelt Dich in winzige Stuecke.\n",
    n+" zerschnetzelt @WEN in winzige Stuecke.\n",
    DT_SLASH, ([SP_SHOW_DAMAGE:0]));

  SetAttackChats(30, ({
   n+" ruft laut um Hilfe.\n",
   n+" kreischt: 'Das war Dein letzter Fehler!'\n",
   n+" wehrt geschickt einen Schlag ab.\n",
   n+" schleift seinen Dolch noch schaerfer.\n" }));
}
 
int Defend(int dam, string dam_type, int spell, object enemy)
{
  WMASTER->ruf_um_hilfe(enemy);
  
  if(!QueryProp(P_WEAPON))
    command("zuecke dolch");
  
  return ::Defend(dam, dam_type,spell,enemy); 
}

varargs int remove(int silent)
{
  WMASTER->FreeEWName(QueryProp(P_NAME));
  
  return ::remove(silent);
}

varargs void die(int poisondeath)
{
  WMASTER->killed_by(QueryProp(P_KILLER));
  WMASTER->FreeEWName(QueryProp(P_NAME));

  ::die(poisondeath);
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  if(killer==ME)
    WMASTER->player_killed(victim);
}

varargs int StopHuntFor(object arg, int silent)
{
  int tmp;

  if(tmp=::StopHuntFor(arg, silent))
    call_out("waffen_check", 5);

  return tmp;
}

varargs mixed StopHuntingMode(int silent)
{
  call_out("waffen_check", 5);

  return ::StopHuntingMode(silent);
}

void waffen_check()
{
  if(!m_sizeof(GetEnemies()))
    command("stecke dolch weg");
}

public int geh_weg(int wann)
{
  if(wann <= 0) return 0;

  if(find_call_out("schleich_dich")!=-1) return 0;

  call_out("schleich_dich", wann);
}

void schleich_dich()
{
  map_objects(all_inventory(), "remove");
  
  move(ROOM "lagerrau", M_NOCHECK);

  remove(1);
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if(find_call_out("reaction") != -1) return;

  if(touch)
    if(TP->QueryProp(P_RACE)=="Elf")
      call_out("reaction", 0, TP,
	       "sagt: Hilf mir lieber das Dorf zu verteidigen!",
	       "sagt: Hilf mir lieber das Dorf zu verteidigen!");
    else
      call_out("reaction", 0, TP,
	       "sagt: Ich kann jetzt nicht! Ich bin auf Patrouille",
	       "sagt zu "+TPN+": Ich kann jetzt nicht!"); 
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if(present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    }
}

void init()
{
  ::init();
  
  command_me("nimm alles");
  
  if(TP->id(ELESSARELF))
    TP->AddDefender(ME);

  if(!interactive(TP)) return;

  if(IS_WIZARD(TP)) return;
  
  call_out("begruessung", 0, TP);
}

void begruessung(object who)
{
  if((!objectp(who)) || (!present(who, MENV))) return;

  if(WMASTER->is_elessar_enemy(who))
    if(!IsEnemy(who))
      {
	command_me("sage Stirb! Feind der Elfen!");

	Kill(who);

	return;
      }

  if(present("\nbesessenheit", who))
    command_me("sage Ein"+(who->QueryProp(P_GENDER)==FEMALE ? "e Besessene":
			   " Besessener")+
	       "! Geh schnell zu Shardin und lasse Dich heilen!");
  
  if(who->QueryProp(P_WEAPON))
    command_me("sage In Elessar ist es nicht erlaubt, mit gezueckter Waffe "
	       "herumzulaufen!");
  
  if((who->QueryProp(P_RACE)=="Dunkelelf") && (!IsEnemy(who)))
    {
      command_me("sage HA! Ein Spion aus Dhrkion!");
      if(random(3))
	command_me("sage Verschwinde aus Elessar!");
      else
	if(IS_SEER(who))
	  Kill(who);
    }
  
  if(who->QueryProp(P_RACE)=="Zwerg")
    switch(random(6))
      {
      case 4: command_me("sage Verschwinde Du Zwerg!");
	break;
      case 3: command_me("sage Ieeh! Ein Zwerg!");
	command_me("emote ruempft die Nase.");
	break;
      case 2: tell_object(who, BS(Name()+" tritt Dich."));
	tell_room(MENV, BS(Name()+" tritt "+CAP(getuid(who))+"."), ({who}));
	break;
      case 1: tell_object(who, BS(Name()+" zwickt Dich."));
	tell_room(MENV, BS(Name()+" zwickt "+CAP(getuid(who))+"."), ({who}));
	break;
      default: command_me("sage Rette sich wer kann! Ein stinkender Zwerg!");
	break;
      }
}

void InformDefend(object enemy)
{
  if(!IsEnemy(enemy))
    command_me("sage Wirst Du das wohl sein lassen!");

  Kill(enemy);
}

varargs string name(int casus, int demon)
{
  if(casus!=RAW)
    return ::name(casus, 1);
  
  return ::name(casus, demon);
}
