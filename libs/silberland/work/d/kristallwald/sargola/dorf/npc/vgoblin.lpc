inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>

#include "../def.h"

create()
{
    if (!is_clone(this_object())) return;
       ::create();
  SetProp (P_SHORT, "Ein Goblinveteran"); 
  SetProp (P_LONG, BS("Der Goblinveteran hat sichtlich schon viele Kaempfe "
  	+"hinter sich. Mit ihm ist ohne Zweifel nicht gut Kirschen essen. "
  	+"Er ist aussergewoehnlich muskuloes und seine Bewegungen sind "
  	+"trotzdem geschmeidig.\n"));
  SetProp (P_DIE_MSG, " grunzt ohrenbetaeubend, dann entschlummert er sanft.\n");
  SetProp (P_NAME, "Goblinveteran");
  SetProp (P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  AddId ( ({"goblinveteran", "goblin", "veteran"}) );
   create_default_npc (20);

  SetProp (P_BODY, 120);
  //SetProp(P_AGGRESSIVE, 1);
  SetProp (P_HANDS, ({" mit blossen Haenden", 160,DT_BLUDGEON}));
  SetProp (P_ALIGN, -350);
  SetProp (P_RACE, "Goblin");
  SetProp (P_SIZE, 160);
  SetProp (P_HP, 650);
  SetProp (P_SP, 650);
  SetProp (P_XP, 450000);
  SetProp (P_MSGOUT, "trampelt weiter");
  SetProp (P_MSGIN, "trampelt herein");
   

  SUID;  
  clone_object("/d/kristallwald/sargola/dorf/armour/kpanzer")->move(TO);
  clone_object("/p/weapon/sword/saebel")->move(TO);
  clone_object("/d/kristallwald/sargola/dorf/armour/gschild")->move(TO);
  command ("ziehe alles an");
  command ("zuecke saebel");

  AddInfo ("goblin","grunzt laut.");
  AddInfo("sargola", "Sargola ist mein Meister.","zischt: ");


  SetAttackChats(15, ({
   "Der Goblinveteran stuermt auf Dich los!\n",
   "Der Goblinveteran schlaegt Dich zu Brei.\n",
   "Der Goblinveteran stoesst Dich brutal nieder."
       }) );

}

 
