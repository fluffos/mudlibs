#include "../def.h"

inherit "std/npc";

#define AI(x, y) AddInfo(x, y, "sagt: ")

void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Goldelf Ranadrion, der Haendler");
  SetProp(P_LONG,
	  BS("Ranadrion ist schon etwas in die Jahre gekommen, daher hat er "
	     "sich hier in Elessar nieder gelassen und bietet hier einige "
	     "Waren an. Er traegt einen typischen waldgruenen Umhang und "
	     "stuetzt sich gelegentlich auf seinen Wanderstab.")+
	  BS("Ranadrion laechelt Dich freundlich an."));

  SetProp(P_NAME, "Ranadrion");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"ranadrion", "\nhaendler", "elf", "Keulenexperte", "NOWIMPY",
	    "haendler","NOCONTROL"}));

  set_living_name("ranadrion");

  create_default_npc(25);

  SetProp(P_HANDS, 
	  ({" mit seinen Haenden", QueryProp(P_HANDS)[1], DT_BLUDGEON}));

  SetProp(P_XP, QueryProp(P_XP)+10000); // Bonus fuer Spells
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 201);
  SetProp(P_WEIGHT, 65341);
  SetProp(P_ALIGN, 400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 20);

  SetProp(P_RESISTANCE_STRENGTHS , 
	  ([DT_HOLY: 0.1, DT_UNHOLY: 0.3, DT_MAGIC: -0.2]));

  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC, 20);

  SetProp(P_MSGIN, "schreitet herein");
  SetProp(P_MSGOUT, "schreitet");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  AddInfo(DEFAULT_INFO, ({
    "nickt Dir freundlich zu.\n",
      "fragt: Willst Du etwas kaufen?\n",
      "fragt: Willst Du etwas verkaufen?\n",
      "laechelt Dich freundlich an.\n"}));

  AI(({"mokassins","schuhe","umhang","hut","filzhut"}),
     "Das sind nur ein paar Kleidungsstuecke, die ich aus meinem Lager "
     "behalten habe.");
  
  AI(({"lager"}),
     "Alles, was ich ankaufe, lege ich in mein Lager. Mit 'zeige' kannst "
     "Du Dir ansehen, was ich habe.");
  
  AI(({"stab","wanderstab"}),
     "Oh, mein Wanderstab! Ich habe ihn nun schon so lange, ich kann mich "
     "kaum erinnern wo ich ihn damals gefunden habe.");

  AI(({"wald","kristallwald"}),
     "Bei all den Laendern und Orten, die ich besucht habe, ist mir "
     "der Kristallwald doch der liebste Ort.");

  AI(({"laender","land","orte"}),
     "Ach, ich habe schon sehr viele Orte und Laender besucht, doch nirgends "
     "gefaellt es mir so sehr, wie hier im Kristallwald.");
  
  AI(({"ort"}),
     "Der Kristallwald ist mir der liebste Ort, daher habe ich mich hier "
     "niedergelassen.");

  AI(({"elf","elfen","elfenvolk","volk"}),
     "Hier in Elessar wirst Du viele von uns Elfen antreffen.");

  AI(({"ranadrion","name"}),
     "Ich heisse Ranadrion und komme aus einer sehr weit entfernten Gegend. "
     "Da mir der Kristallwald aber so gut gefaellt, habe ich beschlossen, "
     "mich hier niederzulassen.");
  
  AI(({"gegend"}),
     "Darueber darf ich Dir nichts erzaehlen!");
  
  AI(({"elessar","elfendorf","dorf"}),
     "Ich bin noch nicht lange hier in Elessar und kenne daher nicht alle "
     "aus dem Dorf. Doch eigentlich lebe ich lieber fuer mich alleine, also "
     "stoert es mich nicht.");
  
  AI(({"lexin"}),
     "Lexin kenne ich persoenlich nicht, jedoch wurde mir gesagt, dass sie "
     "etwas seltsam ist und ich sie eher meiden soll.");

  AI(({"urgrossvater","xalgur"}),
     "Ist Xalgur nicht der Urgrossvater von Lexin?");
  
  AI(({"aerendil","bibliothekar"}),
     "Aerendil ist der Bibliothekar hier in Elessar. Abends wenn keiner mehr "
     "etwas kaufen will, gehe ich manchmal zu ihm hinueber, um zu plaudern. ");
  
  AI(({"bibliothek"}),
     "Elessars Bibliothek ist sehr gross und wird von Aerendil verwaltet. "
     "Er ist ein sehr netter Elf und ich mag es, mit ihm zu plaudern.");
  
  AI(({"baaleth"}),
     "Baaleth ist eine wunderschoene, aber etwas seltsame, junge Elfe. Ich "
     "hatte bereits das Vergnuegen mit ihr zu reden, sie scheint irgendein "
     "Problem zu haben...");

  AI(({"vergnuegen"}),
     "Ja, einmal suchte ich einen ruhigen Ort fuer meine Meditiation und "
     "habe sie westlich der Stadt auf einer Lichtung getroffen.");
  
  AI(({"problem"}),
     "Da musst Du schon Baaleth fragen.");

  AI(({"lorendiel"}),
     "Der Name sagt mir nichts...");

  AI(({"schnabler","onyxschnabler","vogel"}),
     "Der Onyxschnabler ist echt ein laestiger Vogel. Er stoert mich immer "
     "in meiner Meditation.");

  AI(({"meditation","meditieren"}),
     "Ich meditiere hin und wieder, doch der Onyxschnabler stoert mich "
     "immer dabei.");

  AI(({"serona","musiklehrerin"}),
     "Serona ist die hiesige Musiklehrerin. Wir kennen uns recht gut, ich "
     "habe ihr frueher von meinen Reisen oft Musikinstrumente mitgebracht.");
  
  AI(({"musikinstrument","musikinstrumente","instrument","instrumente"}),
     "Serona hat einige wirklich schoene Musikinstrumente bei sich.");

  AI(({"reisen","reise"}),
     "Frueher habe ich viele Reisen unternommen und habe viele Laender und "
     "Orte besucht.");

  AI(({"xelindo","wirt","doore","alhaskindoore","haskindoore"}),
     "Xelindo ist der Wirt im Doore. Ein sehr freundlicher Elf, doch scheint "
     "er dem Alkohol etwas zu sehr angetan zu sein.");
  
  AI(({"xulia","obsttheke","theke"}),
     "Xulia hat sich gleich neben Xelindos Doore eine Obsttheke eingerichtet, "
     "ich bin selbst hin und wieder dort.");
  
  AI(({"culfeniel","heim","tierheim"}),
     "Culfeniel ist weiter westlich im Tierheim, wir haben uns noch nicht "
     "wirklich kennenlernen koennen.");
  
  AI(({"alkohol","kneipe"}),
     "Da musst Du zu Xelindo ins Doore gehen.");
  
  AI(({"waechter","waechterin","waechterinnen","elfenwaechter",
	 "elfenwaechterin","elfenwaechterinnen"}),
     "Die Elfenwaechter patrouillieren hier staendig herum und bekaempfen "
     "die Feinde von Elessar.");
  
  AI(({"feinde","feind"}),
     "Hin und wieder passiert es, dass irgendwelche Feinde versuchen, Elessar "
     "zu stuermen. Sie werden dann oft von den Elfenwaechtern "
     "zurueckgeschlagen.");
  
  AI(({"muellschlucker","schlucker"}),
     "Ich mag es nicht, wenn man meinen Muellschlucker toetet.");

  AI(({"kaufen","waren","angebot","ware","angebote","preis","preise",
	 "artikel"}),
     "Mit 'zeige' kannst Du Dir mein Angebot ansehen.");

  AI(({"laden","elfenladen"}),
     "Ist er nicht nett, mein Laden?\n"
     "Mit 'zeige' kannst Du Dir mein Angebot ansehen.");

  AddInfo(({"zwerg","zwerge"}),
	  "ruempft die Nase.");

  SetProp(P_LOG_INFO, "elessar/ranadrion");
  
  SetProp(P_REJECT, ({ 
    REJECT_GIVE, BS("Ranadrion meint: Willst Du das verkaufen?")}));
  
  SetGuardProtection(50, GUARD_LOCATION);
  
  SetProp(P_SPELLRATE, 30);
  
  AddSpell(2,300,
	   "Ranadrion landet einen harten Schlag an Deiner Schulter.\n",
	   "Ranadrion landet einen harten Schlag an @WESSEN Schulter.\n",
	   DT_BLUDGEON,([SP_SHOW_DAMAGE:0]));

  AddSpell(2,320,
	   "Ranadrions Wanderstab trifft Dich hart in den Bauch.\n",
	   "Ranadrions Wanderstab trifft @WEN hart in den Bauch.\n",
	   DT_BLUDGEON,([SP_SHOW_DAMAGE:0]));

  AddSpell(2,290,
	   "Ranadrions Wanderstab sticht Dir in die Seite.\n",
	   "Ranadrions Wanderstab sticht @WEM in die Seite.\n",
	   DT_PIERCE,([SP_SHOW_DAMAGE:0]));

  AddSpell(1,450,
	   "Ranadrion ist ploetzlich weg...\n"
	   "Ranadrions Wanderstab trifft Dich hart am Ruecken.\n",
	   "Ranadrions Wanderstab trifft @WEN hart am Ruecken.\n",
	   DT_BLUDGEON,([SP_SHOW_DAMAGE:0]));
  
  AddSpell(1,0,
	   "Ranadrion wirbelt seinen Wanderstab herum.\n",
	   "Ranadrion wirbelt seinen Wanderstab herum.\n",
	   DT_TERROR, "spell_disarm");
  
  AddSpell(1,420,
	   "Ranadrions Wanderstab trifft Dich hart am Kopf.\n",
	   "Ranadrions Wanderstab trifft @WEN hart am Kopf.\n",
	   DT_BLUDGEON, "spell_confuse");

  AddSpell(1,430,
	   "Ranadrions Wanderstab faehrt in Deine Kniekehle.\n",
	   "Ranadrions Wanderstab fegt @WEN von den Fuessen.\n",
	   DT_BLUDGEON, "spell_knockout");

  SetChats(2, ({
    "Ranadrion laechelt Dich freundlich an.\n",
      "Ranadrion bietet Dir etwas aus seinem Laden an.\n",
      "Ranadrion lehnt sich kurz an einen Ast.\n",
      "Ranadrion bietet Dir seine Waren an.\n",
      "Ranadrion fragt Dich: Willst Du etwas kaufen?\n"}));
  
  SetAttackChats(10, ({
    "Ranadrion bewegt sich elegant wie ein Wiesel.\n",
      "Ranadrion springt geschickt auf die Seite.\n",
      "Ranadrion duckt sich weg.\n"}));
  
  SUID;

  CLONEME("/p/weapon/club/wanderstab");
  command("zuecke stab");

  CLONEME(ARMOUR "umhang");
  CLONEME(ARMOUR "mokassins");
  CLONEME("/p/armour/helm/hut");
  command("trage alles");
}

void spell_disarm(object e,int d, mixed dt)
{
  object w;

  if(!objectp(e)) return;
  
  if(!objectp(w=e->QueryProp(P_WEAPON)))
    {
      tell_object(e, 
		  BS("Ranadrion schlaegt Dir mit dem Wanderstab hart auf die "
		     "Finger."));
      tell_room(MENV, 
		BS("Ranadrion schlaegt "+e->name(WEM)+" hart auf die "
		   "Finger."), ({e}));

      e->Defend(200, ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:0]), ME);
      
      return;
    }

  if(random(3)) return;
  
  tell_object(e, 
	      BS("Ranadrion schlaegt mit dem Wanderstab hart auf "+
		 (w->QueryProp(P_ARTICLE) ? w->name(WEN) : "D"+w->name(WEN))+
		 "."));
  tell_room(MENV, 
	    BS("Ranadrion versucht "+e->name(WEM)+" die Waffe aus der "
	       "Hand zu schlagen."), ({e}));
  
  e->Defend(150, ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:0]), ME);
  
  if(w->move(ENV(e), M_PUT)==ME_CANT_BE_DROPPED) return;
  
  tell_object(e, 
	      BS((w->QueryProp(P_ARTICLE) ? w->Name(WEN) : "D"+w->name(WEN))+
		 " faellt Dir aus der Hand."));
}

void spell_confuse(object e,int d, mixed dt)
{
  e->SetProp(P_DISABLE_SPELLS, 
	     e->QueryProp(P_DISABLE_SPELLS)+1+random(2));
}

void spell_knockout(object e,int d, mixed dt)
{
  e->SetProp(P_DISABLE_ATTACK,
	     e->QueryProp(P_DISABLE_ATTACK)+1+random(2));
}

int Defend(int d, mixed dtl, mixed s, object e)
{
  WMASTER->ruf_um_hilfe(e);

  if(sizeof(s))
    if(s[SP_NAME])
      if(lower_case(s[SP_NAME])=="spalten")
	{
	  tell_object(e, 
		      BS("Ranadrion grinst Dich nur an und tritt beiseite."));
	  tell_room(MENV, BS("Ranadrion lacht "+e->name(WEN)+" aus."), ({e}));

	  return ::Defend(0, dtl, s, e);
	}
  
  if((!random(3)) && 
     (random(e->QueryAttribute(A_DEX)) < random(QueryAttribute(A_DEX))))
    {
      tell_object(e, BS("Ranadrion duckt sich unter Deiner Attacke weg."));
      tell_room(MENV, 
		BS("Ranadrion weicht "+e->name(WEM)+" geschickt aus."),
		({e}));
      return ::Defend(0, dtl, s, e);
    }
  
  return ::Defend(d, dtl, s, e);
}

int _query_wimpy() { return 0; }

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if(find_call_out("reaction") != -1) return;

  if(touch)
    if(random(2))
      call_out("reaction", 0, TP,
	       "sagt: Bitte nicht!",
	       "sagt zu "+TPN+": Bitte nicht!");
    else
      call_out("reaction", 0, TP,
	       "sagt: Lass das bitte!",
	       "sagt zu "+TPN+": Lass das bitte!");
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if(present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    }
}

varargs void die(int poisondeath)
{
  WMASTER->killed_by(QueryProp(P_KILLER), 1);

  ::die(poisondeath);
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  if(killer==ME)
    WMASTER->player_killed(victim);
}

void init()
{
  ::init();

  if((TP) && (MENV) && (interactive(TP)))
    call_out("begruessung", 0, TP);
}

void begruessung(object who)
{
  if((!objectp(who)) || (!present(who, MENV))) return;
  
  if(WMASTER->is_elessar_enemy(TP))
    {
      tell_object(who, ({
	BS("Soso, ein Feind von Elessar!"),
	  BS("Hau bloss ab Du Feind der Elfen!"),
	  BS("Verschwinde, mit Dir handle ich nicht!")})[random(3)]);
      
      return;
    }

  if(lower_case(who->QueryProp(P_RACE))=="zwerg")
    tell_object(who, ({
      BS("Ranadrion ruempft Dir gegenueber die Nase."),
	BS("Ranadrion blickt Dich nur kurz an."),
	BS("Ranadrion meint abfaellig: Ein Zwerg...")})[random(3)]);
  else
    tell_object(who, ({
      BS("Ranadrion begruesst Dich hoeflich in seinem Laden."),
	BS("Ranadrion laechelt Dich hoeflich an."),
	BS("Ranadrion heisst Dich in seinem Laden willkommen."),
	BS("Ranadrion gruesst Dich hoeflich.")})[random(4)]);
}
