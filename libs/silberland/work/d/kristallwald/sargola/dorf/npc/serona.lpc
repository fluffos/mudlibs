#include "../def.h"

inherit "std/npc";

#define KOSTEN 200

string stunden();

void create()
{
  if(!is_clone(TO)) return;
  ::create(); 
  
  SetProp(P_SHORT, "Hochelfe Serona, die Lehrerin der Musikschule");
  SetProp(P_LONG, 
	  BS("Das ist die Elfin Serona. Sie steht aufrecht "
	     "und gut gekleidet vor Dir und blickt Dich aus schoenen, "
	     "tiefblauen Augen an."));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Serona");
  SetProp(P_ARTICLE, 0);
  AddId(({"serona", "lehrerin","hochelfe","elfe","NOCONTROL"}));
  SetProp(P_DIE_MSG, " spielt das Lied vom Tod.\n");
  create_default_npc(15);
  SetProp(P_HANDS, ({" mit ihren Haenden", 100, DT_BLUDGEON}));
  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht weiter.");
  SetProp(P_HEAL, 20);
  SetProp(P_RACE, "Elf");
  SetProp(P_ALIGN, 150);
  SetProp(P_SIZE, 197);
  SetProp(P_WEIGHT, 65012);

  AddInfo(({"ranadrion","haendler"}),
	  "Ah, mein guter Ranadrion! Nach seinen jahrelangen Reisen hat er "
	  "schliesslich doch noch beschlossen sesshaft zu werden und hat "
	  "hier den Laden uebernommen. Dank ihm habe ich meine grosse "
	  "Sammlung an Musikinstrumenten, denn er hat mir immer welche von "
	  "seinen Reisen mitgebracht.",
	  "singt: ");
  
  AddInfo(({"sammlung"}),
	  "Ich habe dank Ranadrion eine beeindruckende Sammlung an "
	  "verschiedenen Musikinstrumenten.",
	  "singt stolz: ");
  
  AddInfo(({"musikinstrumente","instrumente"}),
	  "Viele meiner wunderschoenen Musikinstrumente habe ich von "
	  "Ranadrion, da er mir von seinen Reisen immer die kostbarsten "
	  "Instrumente mitgebracht hat.",
	  "singt: ");
  
  AddInfo(({"reisen"}),
	  "Nein, nein, ich darf leider nicht reisen, da ich hier die Schule "
	  "betreuen muss, doch ich habe viel ueber das Silberland gehoert "
	  "durch Ranadrions Erzaehlungen.",
	  "singt: ");
  
  AddInfo(({"erzaehlung","erzaehlungen"}),
	  "Ranadrion und ich plaudern recht oft ueber seine Reisen.",
	  "singt: ");
  
  AddInfo("serona", 
	  "Ja, das ist mein Name.",
	  "singt: ");
  
  AddInfo("sargola",
	  "Der goettlichste aller Musiker!",
	  "singt: ");
  
  AddInfo("uebung",
	  "Um der Floete Lieder zu entlocken braucht es eine Menge Uebung.",
	  "singt: ");
  
  AddInfo(({"noten", "notenheft"}), 
	  "Die Noten kannst Du bei mir kaufen. Sie kosten "
	  "allerdings "+KOSTEN+" Muenzen.", 
	  "singt: ");
  
  AddInfo("elessar",
	  "Das ist die Elfenstadt, in der Du stehst.",
	  "singt: ");
  
  AddInfo(({"floetenspielen","lerne","lern","lernen","lied","lieder","spiel",
	      "musik","spielen","floetenspiel","floetenspielen"}),
	  "Ich unterrichte die schoensten Lieder, die Elfen gern Abends "
	  "vortragen. Ich geb Dir gern Stunden, wenn Du willst.", 
	  "singt: ");
  
  AddInfo("floete", 
	  "Wenn Du bei mir das Spielen lernen willst, musst Du Dir Noten und "
	  "eine Floete besorgen. Danach kannst Du Stunden bei mir nehmen.",
	  "singt: ");
  
  AddInfo("melodie",
	  "Viele Melodien wurden von uns von Generation zu Generation weiter"
	  "gegeben.",
	  "singt: ");
  
  AddInfo("emthal",
	  "Den kenne ich nur fluechtig.",
	  "singt: ");
  
  AddInfo("baaleth",
	  "Baaleth ist eine nette, zuvorkommende Elfin, die im suedlichen "
	  "Teil der Stadt wohnt.",
	  "singt: ");
  
  AddInfo("aerendil",
	  "Aerendil ist der Bibliothekar, der im Norden von hier seine "
	  +"Bibliothek hat.",
	  "singt: ");
  
  AddInfo("bibliothek",
	  "Sie befindet sich im Norden von hier.",
	  "singt: ");
  
  AddInfo(({"wirt","xelindo"}),
	  "Das ist der Wirt, der den Doore verwaltet.",
	  "singt: ");
  
  AddInfo("doore",
	  "Der Doore ist ein Ort, wo Elfen sich zusammensetzen und "
	  "sich die Erlebnisse des Tages berichten.",
	  "singt: ");

  AddInfo(({"erlebnisse","tag"}),
	  "Ich glaube, am Besten gehst Du in den Doore und siehst es "
	  "Dir an.",
	  "singt: ");
  
  AddInfo("culfeniel",
	  "Culfeniel habe ich in der Musik unterrichtet, als sie noch eine "
	  "ganz junge Elfe war. Nun hat sie sich entschieden, hier in Elessar "
	  "ein Tierheim zu gruenden.",
	  "singt: ");
  
  AddInfo(({"heim","tierheim"}),
	  "Im Suedwesten der Stadt befindet sich das Tierheim von Culfeniel.",
	  "singt: ");
  
  AddInfo(({"xulia", "obsttheke", "theke"}),
	  "Erinnere mich bitte nicht an sie... *winsel* Sie hat neuerdings "
	  "eine Obsttheke gleich neben ihrem Vater Xelindo errichtet, wie ich "
	  "gehoert habe.",
	  "meint: ");
  
  AddInfo("waechter",
	  "Die Waechter halten uns unliebsames Gesindel vom Leib.",
	  "singt: ");

  AddInfo("gesindel",
	  "Speziell die Goblins treiben sich gern in unserem Gebiet umher.",
	  "singt: ");

  AddInfo("goblins",
	  "Ich selbst habe gottseidank noch keine gesehen. Aber frag doch "
	  "die Waechter, die koennen Dir bestimmt mehr erzaehlen.",
	  "singt: ");
  
  AddInfo(({"heft","notenheft"}),
	  "Ohne ein Notenheft wirst Du kaum Erfolge auf der Floete erzielen.",
	  "singt: ");     
  
  AddInfo("unterricht",
	  "Du willst also Stunden bei mir nehmen?",
	  "singt: ");
  
  AddInfo("sex",
	  "Da bist Du bei mir an der falschen Adresse!",
	  "faucht: ");
  
  AddInfo(({"elfenstadt","stadt","elessar"}),
	  "Elessar ist die Elfenstadt, in dem Du gerade bist.",
	  "singt: ");
  
  AddInfo(({"stunden","stunde"}), CLOSURE(stunden), "singt: ");
  
  AddInfo("liebe",
	  "Ich bin Musiklehrerin!",
	  "singt: ");

  AddInfo("eesthil",
	  "Ich kenne ihn kaum. Du solltest lieber Aerendil fragen.",
	  "singt: ");

  AddInfo(({"barden", "bardengilde", "zaubersaenger"}),
	  "Die Bardengilde hat sich im Kristallwald niedergelassen, ganz in der Naehe "
	  "des Sees von Rhodonit. Der Meisterbarde Artyrian bildet dort die groessten "
	  "Zaubersaenger des Silberlands aus. Um ihnen beizutreten benoetigt man die "
	  "Fuersprache eines bekannten Barden.", "singt: ");

  AddInfo(({"fuersprache", "empfehlung", "empfehlungsschreiben"}),
	  "Du willst also den Barden beitreten? Nun gut. Fuer einen kleinen Gefallen "
	  "werde ich meine Empfehlung fuer dich aussprechen.", "sagt: ");

  AddInfo(({"gefallen"}),
	  "Um meine besondere Floete zu oelen, benoetige ich die Schale einer besonderen "
	  "Frucht: Einer Mango. Sie verleiht der Floete einen angenehmen Duft, den "
	  "richtigen Glanz, und auch einen guten Ton. Wenn du mir eine Mango bringst, "
	  "will ich Artyrian meine Empfehlung fuer dich geben.", "sagt: ");

  AddInfo(({"artyrian", "meisterbarde"}), 
	  "Artyrian ist der Meisterbarde des Silberlands. Er hat sich im Kristallwald "
	  "niedergelassen um andere in der Kunst der Zaubersaenger zu unterrichten.", "singt: ");
  
  AddCmd(CMD_KAUFEN, "kaufe");
}

nosave int kaufe(string str)
{   
  object noten;
  
  notify_fail("Was willst Du kaufen?\n");
  if(!str) return 0;
  
  if(str=="floete")
    return write(BS("Serona singt: Eine Floete musst Du Dir selbst "
		    "besorgen.")), 1;
  
  if(str=="noten"||str=="notenheft"||str=="heft")
    {  
      if(present("notenheft", TP))
	return write(BS("Serona singt: Du hast ja schon ein Heft!")), 1;
      
      if(!TP->QueryMoney())
	return write(BS("Serona singt: Du hast ja gar kein Geld hier!")), 1;
      
      if(TP->QueryMoney() < KOSTEN)
	return write(BS("Serona singt: Du hast leider zuwenig Geld hier. "
			"Ich muss fuer das Notenheft")+
		     BS("Serona singt: "+KOSTEN+" Muenzen verlangen.")), 1;
      
      noten=clone_object(OBJ "noten");
      
      if(noten->move(TP, M_GET)==ME_TOO_HEAVY)
	{
	  noten->remove(1);
	    
	  return write(BS("Serona singt: Die Noten kannst Du nicht mehr "
			  "tragen!")), 1;
	}
      
      write(BS("Serona singt: Hier sind die Noten, die Du brauchst, um "
	       "das Floetenspiel zu")+
	    BS("Serona singt: erlernen."));
 
      tell_room(MENV,
		BS(TPN+" kauft Serona ein Notenheft ab."), ({TP}));
     
      TP->AddMoney(-KOSTEN);
      
      return 1;
    }
  
  return 0;
}

string stunden()
{
  object floete, noten;
  
  if(!present("\neesthilquest",TP))
    return "Ich habe zuviele Schueler und kann Dich leider nicht mehr "
      "aufnehmen.";
  
  if(!objectp(floete=present("floete",TP)))
    return "Dir fehlt ja noch eine Floete.";
  
  if(!objectp(noten=present("notenheft",TP)))
    return "Du musst Dir vorher Noten bei mir kaufen.";
  
  // OK - alle Voraussetzungen fuer die Stunden erfuellt

  if(!floete->query_uebung())
    {
      if(find_call_out("lernen1")==-1)
	call_out("lernen1",3, TP);
      
      floete->set_uebung();
      
      return "Ah! Schoen, fangen wir an. Setz Dich bitte kurz hin, "
	"ich bin gleich bei Dir.";
    }
  
  if(floete->query_uebung() && floete->query_fertigkeit()==37)
    {
      if(find_call_out("lernen7")==-1)
	call_out("lernen7", 3, TP);
      
      floete->set_uebung();
      
      return "Gut, ich sehe Du hast viel geuebt. Machen wir uns an "
	"eine neue Lektion.";
    }
  
  if(floete->query_uebung()==2)
    return "Ich habe Dir schon alles gezeigt, was ich weiss.";
  
  return "Du musst mehr ueben, um Fortschritte zu machen.";
}


//***********************************
// Erste Uebungsstunde
//***********************************
void lernen1(object who)
{
  if((!objectp(who)) || (!present(who, MENV))) return;

  tell_object(who,
	      "\n\nSerona singt: Schlag Dein Notenheft auf. Wir beginnen mit "
	      "den Noten.\n");
  
  call_out("lernen2", 3, who);
}

void lernen2(object who)
{
  if((!objectp(who)) || (!present(who, MENV))) return;

  tell_object(who,
	       "\n\nSerona erklaert Dir allerhand Noten und Zeugs...\n");
  
  call_out("lernen3",3, who);
}
void lernen3(object who)
{
  if((!objectp(who)) || (!present(who, MENV))) return;

  tell_object(who,
	      "\n\nEigentlich moechtest Du nur raus, wie in der Schule...\n");
  
  call_out("lernen4", 3, who);
}

void lernen4(object who)
{
  if((!objectp(who)) || (!present(who, MENV))) return;

  tell_object(who,
	      "\n\nSerona zeigt Dir nun die Haltung der Finger auf der "
	      "Floete.\n");
  
  call_out("lernen5", 3, who);
}

void lernen5(object who)
{
  if((!objectp(who)) || (!present(who, MENV))) return;

  tell_object(who,
	      "\n\nSerona erklaert Dir die richtige Atemtechnik beim "
	      "Spielen.\n");
  
  call_out("lernen6",3, who);
}

void lernen6(object who)
{
  if((!objectp(who)) || (!present(who, MENV))) return;

  tell_object(who,
	      "\n\nSerona singt: Ok, fuer heute ist es genug. Uebe fleissig "
	      "und aus Dir wird ein\n"
	      "Serona singt: guter Barde.\n");
}

//******************************************
// Zweite uebungsstunde ;)
//*******************************************

void lernen7(object who)
{
  if((!objectp(who)) || (!present(who, MENV))) return;
    
  tell_object(who,
	      "\n\nSerona spielt Dir wunderschoene elfische Weisen vor.\n");

  call_out("lernen8",3, who);
}

void lernen8(object who)
{
  if((!objectp(who)) || (!present(who, MENV))) return;

  tell_object(who,
	      "\n\nSerona zeigt Dir nun die schwierigsten, aber auch "
	      "schoensten Melodien der\n"
	      "Elfenkultur.\n");
  
  call_out("lernen9",3, who);
}

void lernen9(object who)
{
  if((!objectp(who)) || (!present(who, MENV))) return;
  
  tell_object(who,
	      "\n\nSerona singt: Du hast nun genug gelernt - ich kann Dir "
	      "nichts neues mehr\n"
	      "Serona singt: zeigen. Geh und zeige der Welt die Schoenheit "
	      "unserer Lieder.\n");
} 

varargs void die(int poisondeath)
{
  WMASTER->killed_by(QueryProp(P_KILLER), 1);

  ::die(poisondeath);
}

int Defend(int d, mixed dtl, mixed s, object e)
{
  WMASTER->ruf_um_hilfe(e);
  
  return ::Defend(d, dtl, s, e);
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  if(killer==ME)
    WMASTER->player_killed(victim);
}

private void gibEmpfehlung(object pl) {
	object ob;

	command_me("sag Wunderbar! Genau so eine habe ich gesucht.");
	tell_room(environment(this_object()), BS("Serona reibt ihre Floete mit der Schale einer Mango ein."));

	if(this_player()->QueryProp(P_GUILD) == "bardengilde") {
		command_me("sag Richte Artyrian meine besten Gruesse aus!");
		return;
	}

	if(objectp(present("\nbarden_empfehlung", this_player()))) {
		command_me("sag Danke! Meine Empfehlung hast du ja bereits erhalten.");
		return;
	}

	ob = clone_object("/gilden/bardengilde/obj/empfehlung");
	if(ob->move(this_player(), M_GIVE) != 1) {
		command_me("sag Ohje! Leider kannst du meinen Brief ja gar nicht tragen. Komm ein andermal wieder.");
		ob->remove(1);
	}
	tell_object(this_player(), BS("Serona gibt dir einen Brief."));
	tell_room(environment(this_player()), BS(sprintf("Serona gibt %s einen Brief.", this_player()->Name(WEM))), ({this_player()}));
	return;
}

public void give_notify(object ob) {
	if(ob->id("mango")) {
		gibEmpfehlung(this_player());
		ob->remove(1);
	}
}
