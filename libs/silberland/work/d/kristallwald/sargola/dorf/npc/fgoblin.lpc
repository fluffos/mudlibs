inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>

#include "../def.h"

create()
{
    if (!is_clone(this_object())) return;
       ::create();
  SetProp (P_SHORT, "Ein Goblinfuehrer");
  SetProp (P_LONG, BS("Ein beeindruckend grosses Exemplar von einem Goblin steht vor Dir. Er "
      +"knurrt und grummelt gefaehrlich, ist bereit, Dich ohne Vorwarnung "
      +"anzugreifen. Er haelt einen schartigen Saebel in der einen Hand, "
      +"einen Schild in der anderen.\n"));
  SetProp (P_DIE_MSG, " grunzt ohrenbetaeubend, dann entschlummert er sanft.\n");
  SetProp (P_NAME, "Goblinfuehrer");
  SetProp (P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  AddId ( ({"goblinfuehrer", "goblin", "fuehrer"}) );
   create_default_npc (19);

  SetProp (P_BODY, 70);
  SetProp(P_AGGRESSIVE, 1);
  SetProp (P_HANDS, ({" mit blossen Haenden", 70,DT_BLUDGEON}));
  SetProp (P_ALIGN, -150);
  SetProp (P_RACE, "Goblin");
  SetProp (P_SIZE, 160);
  SetProp (P_MSGOUT, "trampelt weiter");
  SetProp (P_MSGIN, "trampelt herein");
   

  SUID;  
    clone_object("/p/armour/armour/lederruestung")->move(TO);
  clone_object(WEAPON+"gsaebel")->move(TO);
  clone_object(ARMOUR+"gschild")->move(TO);
  command ("ziehe alles an");
  command ("zuecke saebel");

  AddInfo ("goblin","grunzt laut.");
  AddInfo("sargola", "Sargola ist mein Meister.","zischt: ");


  SetAttackChats(15, ({
   "Der Goblinfuehrer holt zu einem wuchtigen Schlag aus - und verfehlt!\n",
   "Der Goblinfuehrer ueberrumpelt Dich!\n",
   "Der Goblinfuehrer bruellt: \"Zu den Waffen!\"\n"
       }) );

}

