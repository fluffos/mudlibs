inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <moving.h>

#include "../def.h"

hilfe();
int reise();

create()
{
  if (!is_clone(TO)) return;
     ::create();

  SetProp(P_SHORT, "Tante Lundin");
  SetProp(P_LONG,
	"Tante Lundin wird von allen so genannt, weil sie fuer alle "
	"Elfen immer da ist und sich alle Geschichten anhoert. Elfenkinder "
	"lieben sie, weil Tante Lundin die tollsten Geschichten erzaehlen "
	"kann und immer einen Apfel fuer sie uebrig hat. Sie hat schon "
	"weisses Haar, eine Brille aber muntere Augen. Ein einfacher "
	"Elfenkittel ziert sie. ");


  SetProp(P_NAME, "Lundin");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE,0);
  AddId( ({"lundin", "tante lundin","elfe","elfin"}));

  create_default_npc(12);
  SetProp(P_HANDS, ({" mit gebrechlichen Haenden",QueryProp(P_HANDS)[1],
  	DT_PIERCE}));
  SetProp(P_RACE, "Elf");
  SetProp(P_LOG_INFO, "sargola/lundin.log");
  SetProp(P_NOATTACK, "Das ist doch nicht Dein Ernst, oder?\n");

  
  AddInfo(DEFAULT_INFO, 
  	({"blickt Dich stauend an.\n",
  	  "gruebelt lange.\n",
  	  "denkt nochmal scharf nach.\n",
  	  "fragt Dich: Bist Du Dir sicher?\n",
  	  "versteht kein Wort.\n"}) );
  AddInfo("sargola", "Kaum jemand weiss naeheres ueber ihn.","sagt: ");
  AddInfo("gridi", "Sie ist wohl die einzige, die ihn genauer kennt.",
  	"schmunzelt: ");
  AddInfo("land der ferne", "Woher weisst Du denn davon?","gruebelt: ");
  AddInfo(({"geschichte","geschichten"}),
  	"Ach, Du bist doch schon viel zu alt ... Ich erzaehle doch nur "
	"Geschichten ueber Drachen und verwegene Helden, die gegen sie "
	"antreten.","kichert: ");
  AddInfo("drachen","Hast Du etwa nie einen gesehen?","fragt: ");
  AddInfo("helden","Hmm...ob Du einer bist? Ich kenne nur einen, der einen "
    "Helden wirklich erkennt - und das ist der Heldentoeter!","sagt: ");
  AddInfo("heldentoeter","Er wandert durch das ganze Silberland und "
    "fordert die groessten Helden zum Kampf heraus!","sagt: ");
  AddInfo("kampf","Das musst Du schon wissen.","kichert: ");
  AddInfo("silberland","Ich komme nur wenig herum.","seufzt: ");
  AddInfo("apfel","Du moechtest also einen Apfel? Den kann ich Dir aber "
  	"nur geben, wenn Du mir einen Gefallen tust. Ich bin zu alt um "
  	"noch zur Post zu laufen - wuerdest Du fuer mich einen Brief "
  	"aufgeben? Wenn ja, dann biete mir Deine Hilfe an.","fragt Dich: ");
  AddInfo("hilfe","Ich bin zu alt, um noch zur Post zu laufen - wuerdest "
  	"Du fuer mich einen Brief aufgeben? Wenn ja, dann biete mir Deine "
  	"Hilfe an.","fragt Dich: ");
  AddInfo("brief","Es waere toll, wenn Du mir helfen koenntest.",
  	"sagt: ");
  AddInfo("post","Sie befindet sich in der Naehe des Doore. Doch kann "
        "ich keinen Brief mehr aufgeben - der "
  	"Weg ist fuer mich zu beschwerlich.","seufzt: ");
  AddInfo("weg","Warte nur, bis Du so alt bist wie ich!","grummelt: ");
  AddInfo(({"kneipe","doore"}),"Das ist die Kneipe in Elessar.","sagt: ");
  AddInfo("aerendil","Das ist der Bibliothekar in Elessar.","sagt: ");
  AddInfo(({"dorf","elessar"}),"Das ist das Elfendorf.","sagt: ");
  AddInfo(({"elfenkinder","kinder"}),"Hach, ich liebe es, wenn die "
    "suessen Elfenkinder zu mir kommen und mit ihren grossen Glueck "
    "fuer mich.","sagt: ");
  AddInfo("glueck","Glueck ist, wenn die Zwergenkinder nicht zu oft "
    "kommen.","grinst: ");
  AddInfo("zwergenkinder","Die kommen selten zu mir.","grinst: ");
  AddInfo("belohnung","Wenn Du mir den Brief aufgibst, bekommst Du ja "
    "einen Apfel als Belohnung.","sagt: ");
  AddInfo("reise",#'reise);  
  AddInfo("alter","schaut Dich entruestet an!");
 
  SetProp(P_CHAT_CHANCE,35);

  SetChats(10,
  ({"Lundin seufzt: Wenn ich nicht so alt waere.\n",
    "Lundin sagt: Wenn die Post doch nicht so weit weg waere...\n",
    "Lundin fragt: Kannst Du mir helfen?\n"
    "Lundin fragt Dich: Ich haette einen Brief der zur Post getragen gehoert..\n",
    "Lundin beginnt eine Geschichte zu erzaehlen.\n",
    "Lundin fluestert dem Elfenjungen etwas zu.\n",
    "Lundin erfindet eine neue Geschichte.\n"}) );

  
  
  
  AddCmd("biete","biete");

}

int reise()
{  object ob;
  ob = deep_present("\nldfquest",TP);
  if( objectp(ob) && ob->frage_wert(0) )
  {
     tell_object(TP, break_string("Du bist ja gar nicht mehr im Land der Ferne. "
       "Warte kurz, ich rufe den Dschinn zu mir.",78,"Lundin sagt: "));
     tell_object(TP, "Ploetzlich erscheint der Dschinn und traegt Dich ins Land der Ferne.\n");
     TP->move("/d/kristallwald/sargola/ldf/room/r2",M_GO,"weg","fliegt mit einem Dschinn","fliegt mit "
       "einem Dschinn weg");
  }
  else
  {
    tell_object(TP,break_string("Eine Reise ... hmm...",78,"Lundin sagt: "));
  }
  return 1;
}

int biete(string str)
{
  object ob;
  int ret;
  
  notify_fail("Wem moechtest Du was anbieten?\n");
  if(!str) return 0;
  if(str=="lundin hilfe an"||str=="hilfe an")
  {
    if(!TP) return 0;
    ob = deep_present("\nldfquest",TP);
  
    if(objectp(ob))
    {
  	write("Lundin sagt: Du hast doch schon einen Brief von mir.\n");
  	return 1;
    }
  
    write("Lundin sagt: Hier hast Du den Brief und den Apfel als Belohnung.\n");
    write("Lundin sagt: Bitte gib ihn mit \"sende brief\" fuer mich auf der elfischen Post auf.\n");
  
    ob = clone_object(OBJ+"apfel");
    ret = ob->move(TP);
    if(ret==ME_TOO_HEAVY)
    {
      write("Lundin sagt: Der Apfel ist zu schwer fuer Dich.\n");
      ob->move(environment(TP));
     }
    ob = clone_object(OBJ+"brief");
    ret = ob->move(TP);
    if(ret==ME_TOO_HEAVY)
    {
  	write("Lundin sagt: Der Brief ist zu schwer fuer Dich.\n");
  	ob->move(environment(TP));
    }
    clone_object(OBJ+"ldfquest")->move(TP);
    ob->startquest(TP);
    return 1;
}
return 0;
}
