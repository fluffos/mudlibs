#include "../def.h"

inherit "std/npc";

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Wegelagerer");
  SetProp(P_LONG, 
	  BS("Ein dreckiger, ungepflegter Wegelagerer steht vor Dir. Er "
	     "blickt bedrohlich in Deine Richtung und ist bereit, Dich "
	     "anzugreifen, wenn Du eine falsche Bewegung machst. Er haelt "
	     "eine gezackte Klinge in der einen Hand und ein Schild in der "
	     "anderen."));

  SetProp(P_DIE_MSG, 
	  " bruellt ohrenbetaeubend, dann entschlummert er sanft.\n");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));

  SetProp(P_SIZE, 169);
  SetProp(P_WEIGHT, 70000+random(8000));

  SetProp(P_NAME, "Wegelagerer");
  SetProp(P_RACE, "Mensch");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_GENDER, MALE);

  AddId(({"wlag","wegelagerer", "Schwertkaempfer"}));
  create_default_npc(17);

  SetProp(P_HANDS,({" mit blossen Haenden", 170, DT_BLUDGEON}));
  SetProp(P_ALIGN, -100);

  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 10);

  SetProp(P_MSGOUT, "trampelt weiter");
  SetProp(P_MSGIN, "trampelt herein");

  SUID;  
  CLONEME("/p/armour/armour/lederruestung");
  CLONEME("/p/weapon/sword/florett");
  CLONEME("/p/armour/shield/holzschild");

  command("ziehe alles an");
  command("zuecke florett");

  AddInfo("wegelagerer",
	  "sagt stolz: Ja, das bin ich.");
  AddInfo("sargola", 
	  "Sargola ist mein Meister.",
	  "sagt: ");

  SetAttackChats(15, ({
    "Der Wegelagerer duckt sich geschickt.\n",
      "Der Wegelagerer greift Dich hinterhaeltig von hinten an.\n",
      "Der Wegelagerer schreit: \"Du bist mein naechstes Opfer!\"\n"}));

}
 
