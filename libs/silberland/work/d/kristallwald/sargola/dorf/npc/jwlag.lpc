#include "../def.h"

inherit "std/npc";

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein junger Wegelagerer");
  SetProp(P_LONG, 
	  BS("Ein junger Wegelagerer steht vor Dir. Man sieht sofort, "
	     "dass er noch keine harten Kaempfe bestanden hat. Er haelt "
	     "einen schartigen Saebel."));

  SetProp(P_DIE_MSG, " schreit: 'Mammmmiiiii!!' und rennt weg.\n");
  
  SetProp(P_NAME, "Wegelagerer");
  SetProp(P_NAME_ADJ, "jung");
  AddAdjective(({"jung","jungen"}));
  SetProp(P_GENDER, MALE);

  SetProp(P_SIZE, 145);
  SetProp(P_WEIGHT, 65490);

  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 20);
  AddId(({"junger wegelagerer","wegelagerer","jwlag"}));

  create_default_npc(14);

  SetProp(P_HANDS, ({" mit blossen Haenden", 140, DT_BLUDGEON}));
  SetProp(P_ALIGN, -100);
  SetProp(P_ARTICLE, 1);
  SetProp(P_RACE, "Mensch");
  SetProp(P_NOCORPSE, 1);

  SetProp(P_MSGOUT, "laeuft weiter");
  SetProp(P_MSGIN, "laeuft herein");
  
  SUID;  

  CLONEME("/p/armour/armour/lederruestung");
  CLONEME("/p/weapon/sword/florett");
  CLONEME(ARMOUR "gschild");

  command("ziehe alles an");
  command("zuecke florett");

  AddInfo("wegelagerer",
	  "weiss, dass er damit gemeint ist.");
  AddInfo("sargola", 
	  "Sargola ist mein Meister.",
	  "sagt: ");

  SetAttackChats(10, ({
    "Der Wegelagerer holt zu einem verpatzten Schlag aus.\n",
      "Der Wegelagerer greift Dich hinterhaeltig von hinten an.\n",
      "Der Wegelagerer schreit: \"Wir geben niemals auf!\"\n"}));
}

 
