inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>

#include "../def.h"

create()
{
    if (!is_clone(this_object())) return;
       ::create();
  SetProp (P_SHORT, "Ein Goblin");
  SetProp (P_LONG, BS("Ein schleimiger, gruenhaeutiger Goblin steht vor Dir. Er fletscht "
      +"seine Zaehne und blitzt Dich aus dunklen Augen an. Er haelt eine "
      +"gezackte Klinge in der einen Hand und ein Schild in der anderen.\n"));
  SetProp (P_DIE_MSG, " grunzt ohrenbetaeubend, dann entschlummert er sanft.\n");
  SetProp (P_NAME, "Goblin");
  SetProp(P_ARTICLE, 1);
  SetProp(P_AGGRESSIVE,1);
  SetProp (P_GENDER, MALE);
  AddId ( "goblin" );
   create_default_npc (16);

  SetProp (P_BODY, 60);
  SetProp (P_HANDS, ({" mit blossen Haenden", 70,DT_BLUDGEON}));
  SetProp (P_ALIGN, -100);
  SetProp (P_AGGRESSIVE, 1);
  SetProp (P_RACE, "Goblin");
  SetProp (P_SIZE, 150);
  SetProp (P_MSGOUT, "trampelt weiter");
  SetProp (P_MSGIN, "trampelt herein");
   

  SUID;  
  clone_object("/p/armour/armour/lederruestung")->move(TO);
  clone_object(WEAPON+"gsaebel")->move(TO);
  clone_object(ARMOUR+"gschild")->move(TO);
  command ("ziehe alles an");
  command ("zuecke saebel");

  AddInfo ("goblin","grunzt laut.\n");
  AddInfo("sargola", "Sargola ist mein Meister.","zischt: ");


  SetAttackChats(25, ({
   "Der Goblin fuchtelt wild und unkontrolliert mit seinem Saebel herum.\n",
   "Der Goblin zischt: \"Meine Freunde sind schon auf dem Weg!\"\n"
       }) );

}
