inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "/d/kristallwald/sargola/def_kristall.h"

create()
{
     if (!is_clone(TO)) return;
     ::create();
     SetProp(P_SHORT, "Rhondur");
     SetProp(P_LONG, BS("Das ist Rhondur, der Wirt hier. Genauer kannst Du ihn nicht "
      +"untersuchen, da er immer sehr geschaeftig unterwegs ist und keine Zeit "
      +"fuer Dich hat. Was anderes ist es allerdings, wenn Du etwas bestellen "
      +"willst. Er wirkt recht kraeftig fuer einen Elfen und ist fast 2 Meter "
      +"gross schaetzt Du.\n")); 
   SetProp(P_GENDER, MALE);
   SetProp(P_RACE, "Elf");
     AddId (({"rhondur", "wirt","elf"}));
     SetProp(P_DIE_MSG, " trinkt noch einen und geht dann..\n");
     create_default_npc (15);
   SetProp(P_SIZE, 178);
   SetProp(P_HANDS, ({" mit seinen kraeftigen Armen", 100, DT_BLUDGEON}));
     SetProp(P_MSGIN, "kommt herein");
     SetProp(P_MSGOUT, "geht weiter.");
   SetProp(P_HEAL, -10);
     AddInfo("sargola","sagt: Der hat mich programmiert!");
} 
