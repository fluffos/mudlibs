public string barden_song_info() {
	if(TP->QueryProp(P_GUILD) == "bardengilde" && 
       call_other("/gilden/bardengilde/master/bardenmaster", "GetBardGroup", TP) == BARD_GROUP_TIRENA &&
       TP->QuerySkill("vana-o isil ar elena") == 0) {
		return " Ich kann dir dieses Lied gerne heraussuchen. Allerdings wurde mir meine "
		       "Brille von einigen Wegelagerern gestohlen. Kannst du sie mir zurueckbringen?";
	}
	return "";
}

public void give_notify(object ob) {
	if(ob->id(BARD_ID_GS8_BRILLE)) {
		command_me("sag Danke! Endlich!");
		call_out("LearnBardSpell", 0, TP, "vana-o isil ar elena", 
		         "Dieses Lied laesst in dich die Schoenheit von Mond und Sternen fahren, und "
			     "deine Feinde daran verzweifeln!",
				 "spiele 'vana-o isil ar elena' auf <ziel>");
		ob->remove(1);
	} else {
		command_me("sag Dank, das brauche ich nicht!");
		ob->move(ENV(TO), M_PUT);
	}
}
 
//Soll nicht getoetet werden koennen 
// von Fey abgesehen - hoffentlich ist das wenigstens gut geproggt :)) 
// Hi Fey! Und sag jetzt nicht, das ist nicht gut! ;)) 

// ist gut geproggt :) (bis auf das bloede 8-zeichen einruecken :((( ) 
// Feyaria. 

int Defend(int dam, string dam_type, mixed spell, object enemy) 
{
  object ob; 

  WMASTER->ruf_um_hilfe(enemy);

  if(zaehler <6) 
    { 
      tell_room(MENV, 
		BS("Aerendil ruft: Wachen! "+enemy->Name()+
		   " will mich toeten!")+
		BS("Aerendil wirft Dir erbost ein Buch an den Kopf!"));
      
      if(!present("elfenwaechter", MENV)) 
	{ 
	  ob=clone_object(NPC "waechter");
	  ob->move(MENV, M_NOCHECK); 
	  ob->Kill(enemy); 
	  ob->SetProp(P_MNPC_FLAGS, 0);
	  ob->geh_weg(600);
	  
	  zaehler++;
	}

      enemy->StopHuntFor(ME, 1);
      StopHuntFor(enemy, 1);

      return 0;
    } 

  if(!QueryProp(P_WEAPON))
    command("zuecke stock");
  
  return ::Defend(dam, dam_type, spell, enemy);     
} 

void obsttheke()
{
  object tmp;
  
  if(!MENV) return;
  if(InFight()) return;

  if((file_name(MENV)==BIB) && (random(100) < 33))
    {
      call_other(THEKE, "???");
      
      if(!present("xulia", find_object(THEKE))) return;
      
      tell_room(MENV, 
		BS("Aerendil beschliesst, Xulia auf einen Obstsaft zu "
		   "besuchen."));
      
      if(objectp(tmp=present("aerendil", find_object(THEKE))))
	{
	  tmp->move(find_object("/room/npcasylraum"), M_NOCHECK);

	  tmp->remove(1);
	}
      
      MENV->SetProp("xulia", 1);
      
      move(find_object(THEKE), M_NOCHECK);
      
      SetChats(5, ({ 
	"Aerendil kichert vor sich hin.\n",
	  "Aerendil trinkt einen Schluck Obstsaft.\n",
	  "Aerendil knabbert an ein paar Honigmandeln.\n",
	  "Aerendil goennt sich einen Fruechtebecher.\n",
	  "Aerendil trinkt einen Schluck Obstsaft.\n",
	  "Aerendil grinst Xulia an.\n"}));
      
      AddInfo(DEFAULT_INFO, "ist viel zu sehr mit Lesen beschaeftigt.\n"); 

      
      return;
    }

  if(file_name(MENV)==THEKE)
    {
      tell_room(MENV,
		BS("Aerendil verabschiedet sich von Xulia und geht "
		   "zurueck in seine Bibliothek."));
      
      call_other(BIB, "???");

      if(objectp(tmp=present("aerendil", find_object(BIB))))
	{
	  move(find_object("/room/npcasylraum"), M_NOCHECK);

	  remove(1);
	  
	  return;
	}
      
      move(find_object(BIB), M_NOCHECK);

      MENV->SetProp("xulia", 0);

      SetChats(5, ({ 
	"Aerendil vertieft sich in ein Buch.\n",  
	  "Aerendil schlurft zu einem Regal.\n",  
	  "Aerendil sagt: Tststs...das wusste ich noch nicht!\n",  
	  "Aerendil staubt ein besonders altes Buch ab.\n",  
	  "Aerendil murmelt: ....zur Zeit der Kriege....\n",  
	  "Aerendil staubt ein Buch ab.\n" }));  
      
      AddInfo(DEFAULT_INFO, "nickt nur und trinkt weiter an seinem Obstsaft.\n");
    }
}

void reset() 
{
  if(!is_clone(ME)) return; 
  ::reset(); 

  zaehler = 0; 
  
  call_out("obsttheke", 10);
}

varargs int StopHuntFor(object arg, int silent)
{
  int tmp;

  if(tmp=::StopHuntFor(arg, silent))
    call_out("waffen_check", 5);

  return tmp;
}

varargs mixed StopHuntingMode(int silent)
{
  call_out("waffen_check", 5);

  return ::StopHuntingMode(silent);
}

waffen_check()
{
  if(!m_sizeof(GetEnemies()))
    command("stecke stock weg");
}

varargs void die(int poisondeath)
{
  WMASTER->killed_by(QueryProp(P_KILLER), 1);

  ::die(poisondeath);
}

_query_noattack() 
{ 
  string *inv;
  int i;
  
  if(InFight()) return 0; 
  
  if(file_name(MENV)==THEKE)
    return "meint: Nein, jetzt nicht! Ich will hier was trinken!\n";
  
  if(sizeof(inv=filter_array(all_inventory(MENV), 
			     CLOSURE(interactive))-({TP, ME})))
    for(i=sizeof(inv)-1;i>=0;i--)
      if(present("\n_insel_quest", inv[i]) ||
	 present("\nzedernquestobject", inv[i]) ||
	 present("\nosterhasenquest", inv[i]))
	return "meint: Ich kann jetzt nicht!\n";
} 
 
