#include "../def.h"  
#include "/gilden/bardengilde/barden_extern.h"
 
inherit "std/npc"; 
inherit "/gilden/bardengilde/obj/std_spellprovider";

#define BIB ROOM "biblio"
#define THEKE "/d/kristallwald/protheg/elessar/room/reformladen"
 
nosave int zaehler; 

string tinte()
{
  object tinte;

  if(present("\n_insel_quest",TP))
    if(tinte=present("\n_insel_tinte",TP))
	{
	  tinte->setze_tinte(1);
	  command_me("sage Ah, ich soll Dir also ein wenig Tinte geben.");
	  return "fuellt Dir Dein Flaeschchen auf.";
	}
    else
      {
	command_me("sage Wo willst Du die Tinte denn hinein haben?");
	return "schaut fragend."; 
      }
  
  return "schaut Dich fragend an.";
}
 
void create() 
{ 
  if(!is_clone(ME)) return; 
  ::create(); 
  
  zaehler = 0; 
  
  SetProp(P_SHORT, "Hochelf Aerendil, der Bibliothekar von Elessar"); 
  SetProp(P_LONG, 
	  BS("Vor Dir steht ein alter, gebeugter Elf, der sich mit einem "
	     "Stock Halt verschafft. Er traegt eine lange, weisse Robe, die " 
	     "mit herrlichen Stickereien auf der Brust und den "
	     "Schulterblaettern verziert ist. Er hat lange, silberne Haare "
	     "- auch wenn sie ein wenig spaerlich sind.")); 
  SetProp(P_NAME, "Aerendil"); 
  SetProp(P_SIZE, 183); 
  SetProp(P_GENDER, MALE); 
  AddId(({"bibliothekar","aerendil","dorfaeltester","aeltester","elf",
	    "hochelf"})); 

  create_default_npc(18);

  set_living_name("aerendil"); 
  SetProp(P_BODY, 100); 
  SetProp(P_HANDS,({" mit schwachen Haenden", 70,DT_BLUDGEON})); 
  SetProp(P_ALIGN, 600);
  SetProp(P_ARTICLE, 0); 
  SetProp(P_RACE, "Elf"); 
  SetProp(P_XP, 0);

  SetChats(5, ({
    "Aerendil vertieft sich in ein Buch.\n", 
      "Aerendil schlurft zu einem Regal.\n", 
      "Aerendil sagt: Tststs...das wusste ich noch nicht!\n", 
      "Aerendil staubt ein besonders altes Buch ab.\n", 
      "Aerendil murmelt: ....zur Zeit der Kriege....\n", 
      "Aerendil staubt ein Buch ab.\n"  })); 
  
  AddDetail("elf",
  	"Er wirkt schon sehr alt, doch seine Augen machen einen " 
  	"gegensaetzlichen Eindruck."); 
 
  AddDetail(({"schulterblaetter","schulterblatt","brust"}),
	"Sie ist von der Robe verdeckt.");

  AddDetail("eindruck",  
  	"Durch seine wachsamen Augen wirkt Aerendil aufgeweckt - ja fast " 
  	"schelmisch."); 
 
  AddDetail(({"auge","augen"}),  
  	"Sie sind sehr dunkel - fast schwarz. Ihnen scheint nichts zu " 
  	"entgehen."); 
 
  AddDetail("halt",  
  	"Durch den Stock findet Aerendil genug Halt um herumzuschlurfen."); 
 
  AddDetail(({"haar","haare"}),  
  	"Aerendil hat lange, wallend weisse Haare, die ihm bis zur " 
   	"Schulter reichen. Doch waren es in frueheren Zeiten sicher einmal " 
   	"mehr..."); 
 
  AddDetail(({"schulterblaetter","schulter"}),  
  	"Seine Schultern sind von seinen Haaren bedeckt."); 
  
  //SetProp(P_LOG_INFO, "aerendil"); 

  AddInfo(DEFAULT_INFO, "ist viel zu sehr mit Lesen beschaeftigt.\n"); 
  
  AddInfo(({"aerendil","name","bibliothekar"}),
	  "Ich bin Aerendil der Bibliothekar und Du?",
	  "sagt: ");
  
  AddInfo(({"haendler","ranadrion"}),
	  "Ranadrion hat sich erst vor kurzem hier niedergelassen. Er meinte, "
	  "dass es ihm hier so gut gefiehle wie noch nirgends zuvor. Er hat "
	  "den Elfenladen uebernommen und kommt aber trotzdem hin und wieder "
	  "zum Plaudern herueber.");
  
  AddInfo(({"floetenspielen","spielen","musik","lied"}),
	  "Die Elfen sitzen gerne abends zusammen und spielen Lieder. Darin "
	  "erzaehlen sie gerne Geschichten. Serona ist eine ausgezeichnete "
	  "Lehrerin.", 
	  "erzaehlt: ");
  
  AddInfo(({"serona","lehrerin"}),
	  "Serona lehrt Dir das Floetenspiel und alte elfische Melodien. Sie "
	  "wohnt direkt suedoestlich von der Bibliothek.", 
	  "sagt: ");
  
  AddInfo("geschichten",
	  "Geschichten von frueheren Zeiten.", 
	  "erzaehlt: ");

  AddInfo(({"elf","elfen","elfe", "elbe", "elben"}) ,  
	  "Die Geschichte der Elfen ist eine lange und nicht immer "
	  "ruhmreiche. Sie geht zurueck in die Zeit, in der noch Zwist "
	  "zwischen Zwergen und Elfen bestand.",
	  "sagt: "); 
 
  AddInfo(({"elessar","stadt", "siedlung", "elfensiedlung", "elfenstadt"}),  
	  "Die Stadt Elessar hat eine bewegte Geschichte hinter sich. Sie " 
	  "wurde von unseren Urahnen vor langer Zeit errichtet.", 
	  "sagt: "); 
 
  AddInfo("urahnen",  
	  "Es waren Soehne von Aurunda und Nesino, die sich dem staendigen " 
	  "Zwist mit den Zwergen aus Felonia entziehen wollten und fort " 
	  "zogen. Sie gruendeten hier Elessar.", 
	  "sagt: "); 
 
  AddInfo(({"zwerge", "zwergen"}),  
	  "Diese goldgierigen Zwerge, ha! Sie moegen uns sowenig, wie wir " 
	  "sie.", 
	  "sagt: "); 
 
  AddInfo("zwist",  
	  "Es war eine tiefe Feindschaft, die von beiden Seiten nicht "
	  "beendet wurde. Es war die Zeit, als Aurunda und Nesino "
	  "beschlossen, sich eine neue Heimat zu suchen.", 
	  "sagt: "); 
 
  AddInfo("heimat",  
	  "Wo die genau sein sollte, wussten sie damals noch nicht.", 
	  "sagt: "); 
  
  AddInfo(({"krieg","kriege","feindschaft"}),  
	  "Ja, bittere Feindschaft zwischen Zwergen und Elfen.", 
	  "sagt: "); 
  
  AddInfo("felonia",  
	  "Felonia ist die Stadt der Zwerge. Sie liegt weit im Suedosten, "
	  "im Gebirge und besteht aus unterirdischen Stollen.", 
	  "sagt: "); 
 
  AddInfo(({"stollen", "geschoepfe"}),  
	  "Wenn Du darueber mehr wissen willst, musst Du die Zwerge fragen. " 
	  "Ich habe keine Lust, ueber derart dickkoepfige Geschoepfe zu " 
	  "reden.", 
	  "sagt: "); 
 
  AddInfo(({"aurunda","nesino"}),  
	  "Sie sind die Gruender der Stadt Elessar und errichteten " 
	  "viel von dem, was Du hier heute siehst. Doch waren sie nicht die " 
	  "Einzigen, welche vom Sueden kamen.", 
	  "sagt: "); 
  
  AddInfo("einzigen",  
	  "Es gab weitere Gruppen von Elfen, die noch weiter in den Norden " 
	  "zogen. Weit ueber den Wald noerdlich des Sees hinaus.", 
	  "sagt: "); 
 
  AddInfo("wald",  
	  "Ja, hier und in Norden des Sees von Rhondonit gib es dichten " 
	  "Wald.", 
	  "sagt: "); 
 
  AddInfo(({"see","see von rhondonit"}),  
	  "Geh den Weg im Osten aus dem Dorf und bei der Abzweigung nach " 
	  "Nordwesten. Dort wirst Du ihn finden.", 
	  "sagt: "); 
 
  AddInfo("abzweigung",  
	  "Sie ist leicht zu finden - es ist eine Tafel dort.", 
	  "sagt: "); 
 
  AddInfo("tafel",  
	  "Naja ein Wegweiser!", 
	  "sagt: "); 
 
  AddInfo(({"gruppe","gruppen"}),  
	  "Anfangs wurde reger Kontakt durch Kuriere mit ihnen gehalten. Doch "
	  "man hoerte immer weniger von ihnen. Es war die Zeit, als seltsames "
	  "Treiben aus den kalten Regionen im Norden berichtet wurde.", 
	  "sagt: "); 
   
  AddInfo("kontakt",  
	  "Reisende und Boten verkehrten und ueberbrachten Neuigkeiten und " 
	  "tauschten Waren.", 
	  "sagt: "); 
 
  AddInfo(({"neuigkeit","neuigkeiten"}),  
	  "Zum Beispiel, wer heiratete, wer gestorben war, Geburten und sowas "
	  "halt...", 
	  "sagt: "); 
 
  AddInfo(({"geburt","geburten"}),  
	  "Naja, das erklaer ich Dir, wenn Du groesser bist.", 
	  "sagt: "); 
 
  AddInfo(({"bote","boten", "kurier", "kuriere", "volk"}),  
	  "Reisendes und handelndes Volk.",
	  "sagt: "); 
 
  AddInfo(({"region","regionen"}),  
	  "Ich habe leider keine Karten aus den Regionen weiter im Norden. " 
	  "Seit den seltsamen Ereignissen wanderte kein Elf mehr gen Norden. " 
	  "Elfen stuerzen sich nicht in ein Abenteuer, wenn es sich vermeiden "
	  "laesst.", 
	  "sagt: "); 
 
  AddInfo(({"ereignis","ereignisse"}),  
	  "Niemand weiss, was wirklich passierte - man munkelt, dass Tiere "
	  "aus der polaren Gegend weiter nach Sueden zogen und die Elfen " 
	  "vertrieben oder toeteten.", 
	  "sagt: "); 
 
  AddInfo("tiere",  
	  "Leider kenn ich auch keines der Lebewesen der polaren Gegend.", 
	  "sagt: "); 
 
  AddInfo(({"gegend","polare gegend"}),  
	  "Weit im Norden ist sie zu finden.", 
	  "sagt: "); 
 
  AddInfo(({"karte","karten"}),  
	  "Die Karten muesste ich mal raussuchen - aber ich kann " 
	  "Dir einiges ueber die Gebiete im Silberland erzaehlen.", 
	  "sagt: "); 
 
  AddInfo(({"gebiet","gebiete"}),  
	  "Es gibt: die Ebene, das Gebirge, den Kristallwald, den " 
	  "Dschungel, die Unterwelt und das Meer.", 
	  "sagt: "); 
 
  AddInfo("unterwelt",  
	  "Ueber sie weiss ich am wenigsten. Kein Abenteurer kann erzaehlen, " 
	  "was es dort gibt.", 
	  "sagt: "); 
 
  AddInfo("ebene",  
	  "Sie liegt im Osten, und es leben Menschen dort.", 
	  "sagt: "); 
 
  AddInfo(({"mensch","menschen"}),  
	  "Sie handeln mit uns.", 
	  "sagt: "); 
 
  AddInfo("gebirge",  
	  "Die Heimat der Zwerge!", 
	  "sagt mit verzogenem Gesicht: "); 
  
  AddInfo(({"kristallwald","wald"}),  
	  "Das ist hier. Seit dem Argoth ist das der Kristallwald.",
	  "sagt: "); 
 
  AddInfo("argoth",
	  "So nennen wir Elfen den Tag, an dem das ganze Tal hier mit "
	  "Kristall ueberzogen wurde.", 
	  "sagt: "); 
  
  AddInfo("tag", 
	  "Ja, der Tag des Argoth.", 
	  "sagt: "); 
 
  AddInfo("kristall",  
	  "Vor dem Argoth war das hier ein normaler Wald wie um Midas. "
	  "Schuld hat nur der Archmage im Gebirge.", 
	  "sagt: "); 
 
  AddInfo("archmage",  
	  "Er kam aus dem Westen und siedelte sich im Gebirge an. Dort trieb " 
	  "er Versuche und Zauber der Klassen Beherrschung und Verwandlung.", 
	  "sagt: "); 
 
  AddInfo(({"klasse","klassen"}),  
	  "Die Magie ist in mehrere Bereiche geteilt: es gibt da Kampf, " 
	  "Beschwoerung, Heilung, Verwandeln, Illusion um nur einige zu " 
	  "nennen.", 
	  "erklaert: "); 
 
  AddInfo("bereiche",  
	  "Dies sind die Klassen von denen ich sprach. Man koennte auch " 
	  "Schulen dazu sagen.", 
	  "erklaert: "); 
 
  AddInfo(({"schule","schulen"}),  
	  "Jeder dieser Bereiche wird an anderen Schulen gelehrt.",
	  "erklaert: "); 
 
  AddInfo("kampf",  
	  "Hier finden sich die Sprueche des Kampfes.", 
	  "sagt: "); 
 
  AddInfo("beschwoerung",  
	  "Diese Schule ruft Geister, Daemonen aber auch Kraehen und Kobolde " 
	  "zu Hilfe.", 
	  "sagt: "); 

  AddInfo("beherrschung",
	  "Die Beherrschung dient der Kontrolle ueber Tiere.",
	  "sagt: "); 

  AddInfo("heilung",  
	  "Heilung ist die Schule der Regeneration von Koerper und Geist.", 
	  "sagt: "); 
 
  AddInfo(({"verwandlung","verwandeln"}),  
	  "Man unterscheidet hier zwischen Verwandeln von Lebewesen und " 
	  "von Unbelebtem.", 
	  "sagt: "); 
 
  AddInfo(({"lebewesen","unbelebtem"}),  
	  "Das erklaert sich doch von selbst.", 
	  "herrscht Dich an: "); 
 
  AddInfo("illusion",  
	  "Manch Blendwerk wird damit gebrieben.", 
	  "sagt: "); 
 
  AddInfo("blendwerk",  
	  "Dies ist nicht meine Richtung.", 
	  "sagt: "); 
 
  AddInfo(({"geister","daemonen", "kraehen", "kobolde"}),  
	  "Sie werden von der Schule der Beschwoerung hervorgebracht.", 
	  "sagt: "); 
 
  AddInfo("zeit",  
	  "Zeit ist immer etwas relatives...", "sagt: "); 
 
  AddInfo(({"versuche","versuch"}),  
	  "Niemand kannte den Archmage. Seine Spielereien mit der Magie " 
	  "aeusserten sich anfangs nur in leichten, kaum merkbaren Erdbeben "
	  "und Steinschlaegen, die ohnehin nur im Gebirge merkbar waren. "
	  "Bis er seinen uebelsten Spruch sprach...", 
	  "erzaehlt: "); 
  
  AddInfo(({"erdbeben","beben"}),  
	  "Man brachte das anfangs nicht in Verbindung mit dem Magier.", 
	  "erzaehlt: "); 
   
  AddInfo(({"schlaege","steinschlaegen", "steinschlag", "schlag"}),  
	  "Man hoerte dann ein Grollen vom Berg her.", 
	  "erzaehlt: "); 
  
  AddInfo("grollen",  
	  "Ein Grollen, das vom Steinschlag verursacht wurde.", 
	  "erzaehlt: "); 
 
  AddInfo("spruch",  
	  "Es verdunkelte sich der Horizont, Stuerme fegten ueber den See, " 
	  "und der Berg tobte. Wir waren gezwungen, Elessar in Richtung "
	  "Sueden zu verlassen. Erst nach 3 Tagen wagten sich die Mutigsten "
	  "hierher zurueck.", 
	  "erzaehlt: "); 
   	 
  AddInfo("horizont",  
	  "Er war dunkelblau - ja fast schwarz.", 
	  "erzaehlt: "); 
  	 
  AddInfo(({"sturm","stuerme"}),  
	  "Sie rissen alles nieder, was ihnen Widerstand bot.", 
	  "erzaehlt: "); 
  	 
  AddInfo(({"see","berg"}),  
	  "Die Naturgewalten spielten verrueckt.", 
	  "erzaehlt: "); 
  
  AddInfo("mutigsten",  
	  "Sie wurden vom Wald empfangen, wie Du ihn hier siehst: alles " 
	  "war aus Kristall. Kleine Dinge ganz, groessere waren mit einer " 
	  "Kruste aus Kristall ueberzoegen. Wir mussten eine Entscheidung " 
	  "treffen.", 
	  "erzaehlt: "); 

  AddInfo(({"naturgewalt","naturgewalten"}),  
	  "Stuerme, Regen, Winde - ein Chaos...", 
	  "erzaehlt: "); 
  	 
  AddInfo("chaos",  
	  "Ein Chaos, der der Archmage zu verantworten hat!",
	  "erzaehlt: "); 
  	 
  AddInfo(({"ding","dinge"}),  
	  "Einfach alles hier...", 
	  "erzaehlt: "); 
   
  AddInfo("entscheidung",  
	  "Lange Zeit war hier unsere Heimat - sollten wir sie aufgeben? " 
	  "Doch wohin sollten wir gehen? In das Gebirge - zu den Zwergen? " 
	  "Nein! Weiter in den Norden - ins polare Gebiet? Nein! Die " 
	  "Aeltesten entschieden, hier zu bleiben und unser Leben anzupassen. "
	  "Wenn Du naeheres wissen willst, lies das Buch 'Der Tag des " 
	  "Wandels'. Es ist ein sehr ausfuehrliches Werk, fesselnd " 
	  "geschrieben und ueberaus informativ. Uebrigens ist es von mir.", 
	  "erzaehlt: "); 
  
  AddInfo("midas",  
	  "Dies ist die Hauptstadt der Menschen.", 
	  "sagt: "); 
  	 
  AddInfo(({"altes buch","buch","werk"}),  
	  "Es muss irgendwo rumliegen.", 
	  "sagt: "); 

  AddInfo("buecher",
	  "Du musst schon etwas genauer fragen.",
	  "sagt: ");

  AddInfo(({"eesthil","schmied"}),
	  "Der Schmied Eesthil lebt etwas ausserhalb von Elessar beim "
	  "See von Rhondonit.",
	  "sagt: ");

  AddInfo("salina",
	  "Salina ist die Frau des Schmiedes.",
	  "sagt: ");

  AddInfo("befreiung",
	  "Salina versucht seit langer Zeit schon ihren Mann vom Kristall "
	  "zu befreien.",
	  "sagt: ");

  AddInfo(({"kristalldolch","dolch"}),
	  "Wenn Du Waffen benoetigst, geh Dir doch welche kaufen.",
	  "sagt: ");

  AddInfo(({"shardin", "heilerin"}),
	  "Die Heilerin Shardin wohnt irgendwo in der Naehe des Sees, ich "
	  "weiss aber nicht genau, wo.",
	  "sagt: ");

  AddInfo("haendler",
	  "Fahrende Haendler liefern Waffen, Ruestungen und andere Dinge "
	  "von Stadt zu Stadt.",
	  "sagt: ");

  AddInfo("floete",
	  "Wenn Du Floete lernen willst, schaust Du am Besten zu Serona.",
	  "sagt: ");
  
  AddInfo("versteck",
	  "Keiner weiss genau, wo sich die Wegelagerer oder Goblins "
	  "verstecken.",
	  "sagt: ");

  AddInfo(({"wegelagerer","goblins"}),
	  "Die Goblins und Wegelagerer fallen von Zeit zu Zeit ueber uns "
	  "Elfen her. ",
	  "sagt: ");

  AddInfo(({"bollwerk","waechter"}),
	  "Die Waechter sind unser Bollwerk gegen die Goblins und "
	  "Wegelagerer.",
	  "sagt: ");

  AddInfo("zaubertrank",
	  "Deren soll es viele geben...",
	  "murmelt: ");
  
  AddInfo("bibliothek",
	  "Viele, viele Buecher und ein Bibliothekar, das macht eine "
	  "Bibliothek aus...",
	  "grinst: ");

  AddInfo(({"feylinchen","orakel"}),
	  "Das Quest-Orakel befindet sich auf Tijara.",
	  "sagt: ");

  AddInfo("tijara",
	  "Den Weg dorthin musst Du Dir selbst suchen.",
	  "sagt: ");

  AddInfo("wuestling",
	  "Wuestlinge sind seltsame Wesen und kaum jemand kennt sie naeher.",
	  "sagt: ");
  
  AddInfo("culfeniel",
	  "Die kleine Culfeniel kommt oft in die Bibliothek, um sich ein Buch "
	  "auszuborgen. Sie betreibt das Tierheim hier in Elessar.",
	  "sagt: ");
  
  AddInfo(({"heim","tierheim"}),
	  "Elessars Tierheim befindet sich im Suedwesten der Stadt und "
	  "wird von Culfeniel geleitet.");
  
  AddInfo(({"xulia"}),
	  "Ah Xulia, bei ihr in der Obsttheke verbringe ich immer meine "
	  "Pausen und goenne mir einen Obstsaft.",
	  "seufzt: ");
  
  AddInfo(({"pause","pausen"}),
	  "seufzt nur.");
  
  AddInfo(({"entspannung","theke","obsttheke"}),
	  "Die Obsttheke ist der beste Ort zur Entspannung in Elessar.",
	  "meint: ");
  
  AddInfo(({"obstsaft","saft","mandeln","honigmandeln"}),
	  "sabbert Dich an.");
  
//************************************************************************
// Quest-Info fuer die Zedern-Quest
//************************************************************************
  AddInfo(({"aufgabe","quest","problem"}),
	  "Ich weiss jetzt nicht genau, wovon Du sprichst. Unser Dorf ist "
	  "sehr friedlich und hat keine Probleme. Bis auf ... naja ... "
	  "eines haben wir schon. Seit einiger Zeit erkranken die Bewohner "
	  "von Elessar an einer seltsamen Krankheit.",
	  "sagt: ");
	
  AddInfo(({"baum","zeder"}),
	  "Es wuchs einst eine uralte, maechtige Zeder mitten in der Lichtung "
	  "westlich von hier. Doch durch einen Sturm wurde sie zerstoert.",
	  "sagt: ");
	
  AddInfo("sturm",
	  "Waehrend des Sturmes wurde die Zeder von einem Blitz getroffen "
	  "und gespalten. Der Baum stuerzte um und liegt jetzt entwurzelt "
	  "auf der Lichtung.",
	  "sagt: ");
	
  AddInfo("blitz",
	  "Du wirst doch wohl wissen, was ein Blitz ist, oder??",
	  "fragt erzuernt: ");
  
  AddInfo("lichtung",
	  "Ja, die Lichtung westlich von Elessar. Eigentlich eine beschau"
	  "liche Lichtung, aber manche Elfen kommen mit seltsamen "
	  "Krankheiten von dort zurueck.",
	  "sagt: ");
	
  AddInfo(({"krankheiten","eingenart","krank","krankheit","verhalten"}),
	  "In den letzten Wochen wurden viele Elfen von seltsamen Krankheiten "
	  "befallen. Ihr ganzes Leben lang nette und zuvorkommende Bewohner "
	  "von Elessar begannen zu stehlen, rauben und sogar ein Mord "
	  "geschah. Einige verloren ganz den Verstand. Keiner weiss genau, "
	  "was mit den Elfen geschah. Baaleth, die junge Ur-Ur-...-Ur-Enkelin "
	  "des einst maechtigen Elfenmagiers Lorendiel kann Dir vielleicht "
	  "weiterhelfen.",
	  "erzaehlt: ");
  
  AddInfo(({"zeit","woche","wochen"}),
	  "Ja, das alles passierte in den letzten Wochen.",
	  "sagt: ");
  
  AddInfo("leben",
	  "Ihr Leben lang waren sie normale Bewohner von Elessar. Irgendetwas "
	  "veraenderte ihr Leben schlagartig. Was das nur sein koennte?",
	  "sagt: ");
  
  AddInfo("bewohner",
	  "Die verrueckten Elfen sind alle Bewohner von Elessar.",
	  "sagt: ");
  
  AddInfo(({"sache","mord"}),
	  "Das ist eine ganz traurige Sache. Ein Mord! Und das in unserer "
	  "friedlichen Stadt! Sowas ist in der Geschichte der Elfen "
	  "einzigartig.",
	  "sagt: ");

  AddInfo("geschichte",
	  "Die Geschichte der Elfen ist lang und reich an Abenteuern.",
	  "sagt: ");
  
  AddInfo("abenteuer",
	  "Da gibt es eine ganze Menge an Abenteuern...",
	  "sagt: ");

  AddInfo("verstand",
	  "Aus irgendeinem Grund wurden einige Leute aus Elessar verrueckt.",
	  "sagt: ");
  
  AddInfo("grund",
	  "Ja wenn ich den bloss wuesste...",
	  "jammert: ");

  AddInfo(({"enkelin","baaleth","nachfahrin"}),
	  "Baaleth ist eine Nachfahrin von Lorendiel, der einst den Rat der "
	  "Aeltesten in Elessar anfuehrte. Sie hat wie er eine starke "
	  "magische Begabung und man munkelt, dass sie mehr wuesste...",
	  "sagt: ");
  
  AddInfo("lorendiel",
	  "Lorendiel war einst ein Fuehrer des Rates der Aeltesten. Mehr "
