#include "../def.h"


inherit "std/mnpc";

#undef TPN
#define TPN capitalize(TP->query_real_name())


void tanz();

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Die Schnecke Emma");
  set_living_name("emma");
  SetProp(P_LONG, 
	  BS("Du siehst eine kleine, alte Schnecke. Sie "
	     "hat einen gutmuetigen Gesichtsausdruck und laechelt Dich durch "
	     "antik wirkende Nickelbrillen an. Sie schleppt ein riesiges "
	     "Haus auf ihrem Ruecken mit. Vier Fuehler stehen in alle "
	     "Richtungen weg. Du fuehlst, dass Emma schon sehr alt ist "
	     "und von einer magischen Aura umgeben ist."));
  
  AddDetail("fuehler",
	    "Die Schnecke besitzt 4 Fuehler. Zwei kuerzere und zwei laengere. "
	    "Mit ihnen kann sie sich besser zurechtfinden, ihre Augen "
	    "streiken ja schon ein wenig.");
  
  AddDetail(({"ausdruck","gesichtsausdruck"}),
	    "Der Gesichtsausdruck von Emma verraet Dir, dass sie sehr alt "
	    "sein muss und sicherlich sehr weise ist. Ob sie was ueber diese "
	    "Gegend weiss?");

  AddDetail(({"brille","nickelbrille"}),
	    "Die Nickelbrille braucht Emma wohl, weil sie sonst nichts sehen "
	    "wuerde. Durch sie wirken ihre kleinen Augen etwas groesser.");
  
  AddDetail("augen",
	    "Die Augen sind durch die Brille etwas groesser und blicken Dich "
	    "interessiert an. Obwohl einige Faeltchen rund um die Augen sind, "
	    "wirkt Emma froehlich und lustig.");
  
  AddDetail("faeltchen",
	    "Die Faeltchen sind kein Zeichen von Alter sondern Lachfalten.");
  
  AddDetail("lachfalten",
	    "Emma sieht damit richtig nett aus.");
  
  AddDetail(({"schneckenhaus","haus"}),
	    "Ob Emma das Haus wohl freiwillig mit sich herumschleppt? Es ist "
	    "auf jeden Fall wohl gemuetlich - fuer eine kleine Schnecke. Es "
	    "hat zwei kleine Fenster und eine Tuere. Komisch...");

  AddDetail("fenster",
	    "Warum hat ein Schneckenhaus Fenster? Du versuchst ins Innere zu "
	    "blicken, erkennst aber nichts.");

  AddDetail("innere",
	    "Am Besten, das fragst Du Emma einmal.");
  
  AddDetail("aura",
	    "Die kannst Du nicht sehen oder untersuchen. Man kann sie nur "
	    "fuehlen.");
  
  AddDetail("tuere",
	    "Die Tuere ist auch klein und Du fragst Dich, warum es die Tuere "
	    "ueberhaupt gibt. Schliesslich braucht Emma sie ganz sicher nicht "
	    "selbst...");
  
  AddDetail("ruecken",
	    "Auf ihm lastet ein Schneckenhaus.");
  
  
  AddInfo("schnecke",
	  "Ich bin eine Schnecke. Das erkennt man doch!", 
	  "sagt: ");

  AddInfo("sargola",
	  "Mit Sargola und seinen Freunden kann ich stundenlang plaudern.",
	  "sagt: ");

  AddInfo("freunde",
	  "Frag mich einmal nach ein paar Namen, vielleicht kenn ich sie.",
	  "sagt: ");

  AddInfo("fenris",
	  "Du meinst Fenris, das Seicherl? Klar kenn ich den!",
	  "grinst: ");

  AddInfo("seicherl",
	  "Du bist noch zu jung, als dass ich Dir das erklaeren koennte.",
	  "sagt: ");

  AddInfo("vivienne",
	  "Ich weiss, es klingt unglaublich, aber es gibt nette "
	  "Zwergen-Maedchen! Nur die Verwandlung, die sie in letzter Zeit "
	  "durchgemacht hat...",
	  "sagt: ");

  AddInfo("verwandlung",
	  "Ich weiss auch nicht... sie ist immer schwarz angezogen, hat "
	  "blutrote Lippen und schaut so komisch auf die Haelse der Leute. "
	  "Ich meine, mir persoenlich ist das ja egal, in meinen schleimigen "
	  "Hals beisst sie sicher nicht.",
	  "sagt: ");
  
  AddInfo("lippen",
	  "Die Lippen Viviennes sind immer blutrot. Warum wohl?",
	  "sagt: ");

  AddInfo(({"hals","haelse"}),
	  "Es erinnert mich irgendwie an einen Vampir...",
	  "sagt: ");

  AddInfo("vampir", CLOSURE(tanz));

  AddInfo("monimor",
	  "Der ist kaum hier.",
	  "seufzt: ");

  AddInfo("gridi",
	  "Sie ist ein arrogantes, kleines ..... (naja, ich hab sie "
	  "trotzdem sehr lieb).",
	  "sagt: ");

  AddInfo("verdandi",
	  "Verdandi haette ich so gerne das Gewissen geschult, aber sie "
	  "hat sich immer geweigert.",
	  "sagt: ");

  AddInfo("feyaria",
	  "Feyaria ist eine ganz fleissige Elfe und die Mutter von Sargola.",
	  "sagt: ");

  AddInfo("zordan",
	  "War Zordan nicht der, der sich an einem Fraggle umbringen wollte?",
	  "fragt: ");

  AddInfo("fraggle",
	  "Ich habe noch nie einen gesehen.",
	  "sagt: ");

  AddInfo("lostboy",
	  "Lostboy waere so gern Testi fuer die Wandler-Gilde, aber Sargola "
	  "ist ja so faul...",
	  "sagt traurig: ");

  AddInfo(({"wandler","wandler-gilde","wandlergilde"}),
	  "Die kommt vielleicht irgendwann mal...","sefuzt: ");
  
  AddInfo("sefuz",
	  "Das Verb kommt von Nostromo.",
	  "grinst: ");
  
  AddInfo("nostromo",
	  "Nostromo ist auch selten hier...",
	  "sefuzt: ");

  AddInfo("woody",
	  "Woody ... hmm ... ist das nicht der, der nicht wuzzeln kann?",
	  "schmunzelt: ");

  AddInfo("dusty",
	  "Dusty ist eine nette Goettin.",
	  "sagt: ");

  AddInfo("emma",
	  "Ich heisse Emma, ja und?", 
	  "fragt: ");

  AddInfo(({"nickelbrille","brille","brillen","nickelbrillen"}),
	  "Tja leider brauch ich die, sonst seh ich nichts mehr.",
	  "seufzt: ");

  AddInfo(({"schneckenhaus","haus"}),
	  "Mein Haus ist wunderschoen nicht? Nur ein wenig schwer.",
	  "sagt: ");

  AddInfo(({"fenster","tuere"}),
	  "laechelt gemeimnisvoll.");

  AddInfo("inneres",
	  "Mein Haus reicht fuer mich. Ich habe zwar ein Gaestezimmer, aber "
	  "ich weiss nicht, ob Du da reinpassen wuerdest.",
	  "schmunzelt: ");

  AddInfo("zimmer",
	  "Ich habe einige davon, aber die werden Dir wohl zu eng sein.",
	  "schmunzelt: ");

  AddInfo("gaestezimmer",
	  "Wenn Du wirklich willst, kannst Du es Dir ja einmal ansehen. "
	  "Du musst allerdings ziemlich klein werden...", 
	  "sagt: ");
  
  AddInfo("aura",
	  "Ich vermag viele Dinge, das mag auf den ersten Blick nicht so "
	  "wirken...", 
	  "sagt: ");
  
  AddInfo("dinge",
	  "Im rechten Moment wirst Du erkennen, was ich vermag.", 
	  "sagt: ");

  AddInfo("moment",
	  "Der Moment ist noch nicht gekommen.", 
	  "sagt: ");

  AddInfo(({"gegend","geschichte"}),
	  "Ich kenne die Gegend kaum - kein Wunder, ich komme ja nicht unbe"
	  "dingt herum. Aber ich kann Dir viel ueber die Zeit erzaehlen.",
	  "sagt: ");

  AddInfo("zeit",
	  "Du bist noch jung, aber glaub mir, die Zeit verging viel schneller "
	  "als Du es dir traeumen lassen wuerdest. Dabei gibt es so viele "
	  "schoene Dinge, die man vielleicht versaeumt. Wenn Du magst, kann "
	  "ich Dein Gewissen schulen und Dir zeigen, wie Du weniger Zeit im "
	  "Silberland verbringen kannst.",
	  "erzaehlt: ");

  AddInfo("silberland",
	  "Du musst selbst fuer Dich beantworten, was das Silberland fuer "
	  "Dich ist.",
	  "sagt: ");

  AddInfo("dinge",
	  "Du allein kannst wissen, was Du gerne tun wuerdest.",
	  "raet Dir: ");
  
  AddInfo(({"heilen","heilung","krankheit","krankheiten"}),
	  "Heilung kann ich Dir nicht bringen. Suche Shardin - sie kann Dir "
	  "in diesen Belangen sicher weiterhelfen.",
	  "raet Dir: ");

  AddInfo("shardin",	
	  "Ich bin leider zu langsam, um Dir den Weg zu Shardin zu zeigen. In "
	  "frueheren Zeiten war ich viel forscher.",
	  "sagt: "); 

  AddInfo("belange",
	  "Sie betreffen das Heilen.",
	  "sagt: ");
  
  AddInfo(({"heilen","heilung"}),
	  "Shardin kann Dich von fast allen Krankheiten heilen.",
	  "sagt: ");

  AddInfo("hunger",
	  "Ich brauche immer sehr lange, bis ich etwas Essbares gefunden "
	  "haben. Ich vertrage ja nur Fruechte.",
	  "seufzt: ");
  
  AddInfo("magen",
	  "Ich bin ziemlich hungrig.",
	  "seufzt: ");
  
  AddInfo("fruechte",
	  "Am liebsten esse ich Erdbeeren, obwohl ich auch andere Fruechte "
	  "nicht verachte.","sagt: ");
  
  AddInfo(({"erdbeeren","erdbeeren"}),
	  "Erdbeeren  findest Du auf der Lichtung westlich von Elessar.",
	  "sagt: ");
  
  AddInfo("lichtung",
	  "Die Lichtung ist gemuetlich und ruhig. Ich bin gerne dort, nur "
	  "der Weg ist fuer mich recht weit.",
	  "sagt: ");

  AddInfo(({"aerendil","bibliothekar"}),
	  "In Elessar wirst Du ihn in der Bibliothek finden. Er ist ein "
	  "weiser Mann, der Dir viele Fragen ueber den Kristallwald "
	  "beantworten kann.",
	  "sagt: ");

  AddInfo("bibliothek",
	  "Sie befindet sich in Elessar.",
	  "sagt: ");

  AddInfo("elessar",
	  "Der Weg dorthin ist zwar immer ein wenig muehsam, wegen der "
	  "steilen Baeume, aber ich gehe gern dort spazieren.", 
	  "sagt: ");

  AddInfo("baeume",
	  "Tja, frueher war ich immer dabei, wenn junge Buben auf Baeume "
	  "kraxelten. Aber das ist schon lange her...",
	  "sagt: ");

  AddInfo(({"schneckenbuben","schnecken-buben","buben"}),
	  "Ich war frueher immer mit den forschesten und wildesten "
	  "Schnecken-Buben unterwegs! So manchen Streich haben wir "
	  "gespielt...",
	  "sagt stolz: ");

  AddInfo("streich",
	  "laechelt verschmitzt.");
	
  AddInfo("gewissen",
	  "Dein Gewissen wird Dir nach dem Unterricht  nur mehr eine "
	  "bestimmte Frist pro Tag geben, in der Du im Silberland sein "
	  "darfst.",
	  "sagt: ");
  	
  AddInfo(({"unterricht","frist","art","arten"}),
	  "Ich kann Dir zwei Arten des Unterrichtes anbieten: <schule hart> "
	  "gibt Dir eine Stunde pro Tag im Silberland, <schule weich> gibt "
	  "Dir zwei Stunden. Aber ueberleg es Dir gut! Es ist schwierig, das "
	  "Gewissen wieder loszuwerden!",
	  "sagt: ");
  	
  SetProp(P_NOATTACK, "blickt dich friedlich an und Du verwirfst den Gedanken sofort.\n");  
  SetProp(P_NAME, ({"die Schnecke Emma","der Schnecke Emma",
		      "der Schnecke Emma","die Schnecke Emma"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  
  AddId(({"\nschneckengewissen","schnecke", "emma","schnecke emma"}));
  create_default_npc(8);

  SetProp(P_HANDS,({" mit schwachen Fuehlern", 70, DT_BLUDGEON}));
  SetProp(P_ALIGN, 800);
  SetProp(P_RACE, "Schnecke");
  SetProp(P_SIZE, 20);
  SetProp(P_WEIGHT, 100);

  SetProp(P_DEFAULT_INFO, ({
    "wackelt fragend mit ihren Fuehlern.\n",
      "blickt verdutzt.\n",
      "schaut Dich fragend an.\n",
      "weiss offensichtlich nicht genau, wovon Du sprichst.\n",
      "fragt: Was meinst Du genau?\n",
      "sagt: Davon weiss ich nichts.\n",
      "uebergeht Deine Frage einfach.\n",
      "sagt: Frag bitte Aerendil oder Shardin.\n"}) );
  
  SetProp(P_MSGOUT, "kriecht langsam weiter" );
  SetProp(P_MSGIN, "kriecht langsam herein");
  
  SetProp(P_MNPC_AREA, 
	  ({"/d/kristallwald/sargola/lichtung/room/",
	      "/d/kristallwald/sargola/dorf/room"}) );
  SetProp(P_MNPC_WAIT, ({ 120, 120, 120 }));
  SetProp(P_MNPC_DEFAULTROOM, "/d/kristallwald/sargola/dorf/room/1_0514");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);
   
  SetChats(({
    "Emma wackelt interessiert mit ihren Fuehlern.\n",
      "Emma zwinkert Dir freundlich zu.\n",
      "Emma kommt langsam ein wenig naeher.\n",
      "Emma sagt: Ich plauder gern mit Dir.\n",
      "Emma staunt nicht schlecht.\n",
      "Emma blinzelt Dich durch ihre Nickelbrille an.\n",
      "Emma wirkt irgendwie hungrig.\n",
      "Emmas Magen knurrt.\n",
      "Emma fragt Dich: Hast du etwas zu essen fuer mich?\n" }) );

  AddCmd("schule","schule");
}

void give_notify(object given)
{
  if(!TP) return;
  if(!objectp(given)) return;
	
  if(!given->id("erdbeere"))
    {
      tell_object(TP, BS("Emma hat riesigen Hunger, aber das mag "
			 "sie nicht."));
      give_obj(given, TP);
      return;
    }

  tell_object(TP, 
    "Emma blickt Dick dankbar und froh durch ihre Nickelbrille an und beginnt "
    "genuesslich, sich den Magen vollzuschlagen.\n"	
    "Emma sagt: Als Dank fuer Deine Muehe darfst Du Dir mein Gaestezimmer\n"
    "ansehen.\n"
    "Emma schliesst die Augen, ihre Fuehler beginnen wild zu rotieren.\n"
    "Du fuehlst eine Kraft wirken und schrumpfst ploetzlich zusammen!\n\n"
    "Du kannst Emma nun gerade in die Augen blicken.\n "
    "Emma sagt: Tritt ein, Freund.\n");

  given->remove(1);
  
  tell_room(MENV, BS(TPN+" wird ploetzlich winzig."),({TP}));

  TP->move(ROOM "gaestehaus", M_GO, "ins Schneckenhaus","geht", 
	   "kommt von draussen rein");
}

nosave int schule(string str)
{
  object ob;
  notify_fail(BS("Emma fragt: Wie soll ich Dich schulen?"));
  if(!str) return 0;

  if((str!="hart") && (str!="weich")) return 0;
  
  if(TP->QueryProp(P_FROG))
    return write(BS("Emma sagt: Froesche kann ich das Gewissen nicht "
		    "schulen.")), 1;
  
  if(present("gewissen",TP))
    return write(BS("Du hast doch schon ein Gewissen, das gut auf Dich "
		    "aufpasst.")), 1;

  ob=clone_object(OBJ "b");
  ob->move(TP, M_NOCHECK);

  if(str=="hart")
    ob->set_period(3600,60);
  else 
    if(str=="weich")
      ob->set_period(7200,120);
  
  tell_object(TP, 
	      BS("Emma nimmt Dich zur Seite, wie es Deine "
		 "Mutter auch frueher getan hat, und beginnt Dir "
		 "alles ueber Gott und die Welt zu erklaeren. Du "
		 "beginnst immer mehr zu verstehen, was wirklich "
		 "wichtig ist im Leben..."));
  
  tell_room(MENV, BS(TPN+" laesst sich von Emma das Gewissen schulen."),
	    ({TP}));
  WLOG("/d/kristallwald/sargola/log/gewissen", " kauft ein Gewissen");
  return 1;
}

void tanz()
{
  string str;
  tell_object(TP, BS("Emma reisst Dich an sich und tanzt mit Dir den Tanz der "
		     "Vampire."));
  str =(TP->QueryProp(P_GENDER) == 2 ? "ihr":"ihm");
  tell_room(MENV, BS("Emma reisst "+TPN+" an sich und tanzt "
		     "mit "+str+" den Tanz der Vampire."),
	    ({TP}));
}  
