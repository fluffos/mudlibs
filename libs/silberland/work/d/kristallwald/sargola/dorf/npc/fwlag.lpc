#include "../def.h"
#include "/gilden/bardengilde/barden_extern.h"
#define AERENDIL_BRILLE "/gilden/bardengilde/obj/quest/gs8_tirena_task"

inherit "std/npc";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Ein Fuehrer der Wegelagerer");
  SetProp(P_LONG, 
	  BS("Ein staemmiger, breitschultriger Wegelagerer steht vor Dir. Er "
	     "knurrt und grummelt gefaehrlich. An seinem Gesicht erkennst Du, "
	     "dass er schon einige Kaempfe bestritten hat."));

  SetProp(P_DIE_MSG, " stirbt ploetzlich!\n");

  SetProp(P_NAME, 
	  ({"Fuehrer der Wegelagerer","Fuehrers der Wegelagerer", 
	      "Fuehrer der Wegelagerer","Fuehrer der Wegelagerer"}));

  SetProp(P_GENDER, MALE);

  AddId(({"fwlag","fuehrer","wegelagererfuehrer","wegelagerer",
	    "fuehrer der wegelagerer", "Schwertkaempfer"}));

  create_default_npc(20);

  SetProp(P_AGGRESSIVE, 1);

  SetProp(P_HANDS, ({" mit blossen Haenden", 200, DT_BLUDGEON}));
  SetProp(P_ALIGN, -150);
  SetProp(P_RACE, "Mensch");
  //SetProp(P_HP, 400);
  //SetProp(P_XP, 45000);
  SetProp(P_SIZE, 171);   
  SetProp(P_WEIGHT, 77893);

  SetProp(P_MSGOUT, "stampft weiter");
  SetProp(P_MSGIN, "stampft herein");
  
  AddDetail("gesicht",
	    "Es ist von vielen Scharten entstellt.");

  AddDetail("scharten",
	    "Sie stammen sicher von bitteren Kaempfen.");

  SUID;  

  CLONEME(ARMOUR "lederr");
  CLONEME("/p/weapon/sword/florett");
  CLONEME("/p/armour/shield/holzschild");

  command("ziehe alles an");
  command("zuecke florett");

  AddInfo("wegelagerer",
	  "nickt grimmig.");
  AddInfo("sargola", 
	  "Sargola ist mein Meister.",
	  "sagt: ");

  SetAttackChats(15, ({
    "Der Wegelagerer holt zu einem wuchtigen Schlag aus!\n",
      "Der Wegelagerer stoesst Dich einen Meter zurueck.\n"}));
}
 
void init()
{
  ::init();

  command_me("nimm alles");
}

public void die(int pd) {
  object killer, ob;

  killer = QueryProp(P_KILLER) || TP;
  if(!objectp(killer)) return;

  if(killer->QueryProp(P_GUILD) == "bardengilde" && 
      call_other("/gilden/bardengilde/master/bardenmaster", "GetBardGroup", killer) == BARD_GROUP_TIRENA &&
      killer->QuerySkill("vana-o isil ar elena") == 0 &&
      !present(BARD_ID_GS8_BRILLE, killer)) {
        ob = clone_object(AERENDIL_BRILLE);
        if(ob->move(killer, M_GET) != 1) {
          write(BS("In der Leiche findest du noch eine Brille, die du leider nicht mehr tragen kannst."));
        } else {
          write(BS("In der Leiche findest du noch eine Brille, die du sofort einsteckst."));
        }
  }

  ::die(pd);
}
