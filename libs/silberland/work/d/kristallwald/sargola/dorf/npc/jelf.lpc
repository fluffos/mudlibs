inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"

create()
{
     if (!is_clone(TO)) return;  
     ::create();   
     SetProp(P_SHORT, "Ein elfischer Junge");  
     SetProp(P_LONG, BS("Ein junger Elf, der zusammengekauert auf einem "
       "kleinem Polster sitzt und wie gebannt mit grossen, staunenden "
       "Augen den Geschichten und Maerchen von Lundin lauscht. Nicht"
       "mal die Haare sind gekaemmt."));
    
    AddDetail("augen","Sie sind vor Staunen und Erwartung ganz gross.");
    AddDetail("haare","Sie sind strubbelig. Scheinbar kuemmert er sich "
      "nicht darum - die Maerchen sind wohl faszinierender.");
        
    SetProp(P_GENDER, MALE);  
     SetProp(P_NAME, ({"Junge","Jungen","Jungen","Jungen"}));  
     SetProp(P_ARTICLE, 1);  
     AddId (({ "junge","jungen","elf"}));  
     create_default_npc (4);  
   SetProp(P_HANDS, ({" mit kleinen Haenden", QueryProp(P_HANDS)[1], DT_BLUDGEON}));  
   
     SetProp(P_MSGIN, "kommt hereingerannt");  
     SetProp(P_MSGOUT, "rennt nach draussen.");  
     SetProp(P_RACE, "Elf");  
     SetProp(P_ALIGN, 550);  
     SetProp(P_SIZE, 131);
     SetProp(P_BODY, 60);
     SetProp(P_XP, 0);		//Quest-NPC :)
     SetProp(P_NOATTACK,"nimmt Dich sowieso nicht wahr.");
     SetProp(P_REJECT,
       ({REJECT_DROP,"Der Junge laesst @WEN achtlos fallen.\n"}) );
     
     CLONEME(ARMOUR+"hemd");    

     AddLibrary(NPC+"dorf.lib",1);
     
     AddInfo(DEFAULT_INFO,
     	"Psssst! Sei leise! Sonst verpass ich noch etwas.","grummelt: ");
     AddInfo("sargola","Er kann so herrliche Geschichten erzaehlen.","schwaermt: ");
     AddInfo("gridi","Sie ist die wunderbarste Geschichte, die Sargola je "
       "passiert ist.","grinst breit: ");
     AddInfo( ({"geschichte","geschichte","maerchen"}),
       "Da fragst Du lieber Lundin, die kennst soooo viele davon. Und manche "
       "sollen sogar wahr sein!","berichtet: ");
     AddInfo("lundin","Du kannst dumme Fragen stellen.","aergert sich: ");

} 
