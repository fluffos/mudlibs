//Quest-Objekt von Baaleth


int zaehler;		//Zaehlt die wichtigen Punkte der Quest mit :)
			//damit kann man nicht mehr schummeln
/*
************************************************************
** Folgende Stationen und die Zaehler-Werte
** 1: 	Man hat das Skript einmal bei der Zeder gesehen.
** 2:	Man hat Lexin getoetet
** 3:	Man hat meditiert
** 4:	Man war schwimmen
** 5:	Man ist fertig ;)
**
**
*/

erhoehe_zaehler(int z);
frage_zaehler();
fr();
fertig(object ob);


meditation1();
meditation2();
meditatio3();

//int schwimm(string str);
schwimmen1();
schwimmen2();
schwimmen3();

inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include "/d/kristallwald/sargola/def_kristall.h"


void create()
{
   zaehler =0;
   if (!is_clone(this_object())) return;
   ::create();

   SetProp(P_SHORT, 0);
   SetProp(P_WEIGHT, 0);
   SetProp(P_NODROP,1);
   AddId(({"quest","\nzedernquestobject"}));
  AddCmd(({"meditier","meditiere"}),"meditiere");
  AddCmd(({"bade","bad","schwimme","schwimm"}),"schwimm");
  AddCmd("fr","fr");
  AddCmd("er","er");
}
er()
{
	zaehler+=1;
}

fr()
{
	write(zaehler);
}

meditiere()
{
	object *leute;
	switch(zaehler)
	{
	case 0:
	case 1:
	{
		write("Wie bitte?\n");
		break;
	}
	case 2:
	{
	if(environment(environment())->QueryProp(P_INT_SHORT) =="Der Kristallwald")
	{	//leute = filter_array(all_inventory(environment(TP)),#'living);
		//write(leute);
		//if(leute)
		//{
		//	write("Du kannst in Gegenwart von Leuten nicht so gut meditieren...");
		//	return "";
		//}
		
		if(!present("\nscript_meditation",TP))
			clone_object(OBJ_LICHTUNG+"scr_med.lpc")->move(TP, M_NOCHECK);

		if( (find_call_out("meditation1")==-1) &&
		    (find_call_out("meditation2")==-1) &&
		    (find_call_out("meditation3")==-1) )
		 	call_out("meditation1",0);
		break;
	}
	else
	{
		write(
"Du befindest Dich nicht an der richtigen Stelle, um in Ruhe meditieren zu\n"
+"koennen.\n");
		break;
	}
	}
	case 4:
	{
		write("Du warst schon meditieren. Einmal reicht.\n");
		break;
	}
	
	}	//ENDE SWITCH

	return "";	
}



meditation1()
{
	write(
"\n\nDu setzt Dich auf den weichen, duftenden Boden, riechst die intensive\n"
+"Waldluft und gehst tief in Dich hinein.\n\n");
	call_out("meditation2",6);
}

meditation2()
{
	write(
"\n\nDu bist im Inneren ganz still, gelassen ... und beginnst zum ersten Mal, Dich\n"
+"selbst zu erleben und zu erfassen...\n");
	call_out("meditation3",6);
}

meditation3()
{
	object ob;
	write(
"\n\nDu bist immer ruhiger, ruhst in Dir selbst. Keine Hektik der Welt kann Dich\n"
+"nun mehr aus der Ruhe bringen. Du bist innerlich ganz still und bereit fuer das\n"
+"reinigende Bad im See.\n");
	erhoehe_zaehler(3);		//*** er war nun meditieren
	ob = present("\nscript_meditation",TP);
	ob->remove();
	return "";
}

schwimm(str)
{
	if(!str=="in see" || !str=="in wasser" || !str )
	{
		write("Worin willst Du baden?\n");
		return 1;
	}
	if(zaehler<3)
	{
		write("Du hast wichtigeres zu tun, als hier baden zu gehen.\n");
		return 1;
	}

	switch(zaehler)
	{
	case 0:
	case 1:
	case 2:
	{
		write("Wie bitte?");
		break;
	}
	case 3:
	{
	if(environment(TP)->QueryProp(P_INT_SHORT) =="Am See von Rhondonit")
	{
		if(!present("\nscript_schwimmen",TP))
			clone_object(OBJ_LICHTUNG+"scr_schw.lpc")->move(TP, M_NOCHECK);

		if( (find_call_out("schwimmen1")==-1) &&
		    (find_call_out("schwimmen2")==-1) &&
		    (find_call_out("schwimmen3")==-1))
		 	call_out("schwimmen1",0);
		break;
	}
	else
	{
		write(
"Du befindest Dich nicht an der richtigen Stelle, um schwimmen zu koennen.\n");
		break;
	}
	}
	case 4:
	{
		write("Du warst schon bade. Einmal baden reicht.\n");
		break;
	}
	}	//ENDE SWITH
	
	

	return 1;

}

schwimmen1()
{
	write(
"\n\nDu legst alle Deine Sachen ab und gehst langsam in den See. Du spuerst das\n"
+"kuehle Wasser, wie es Deine Beine und schliesslich Deinen ganzen Koerper umgibt.\n\n");
	call_out("schwimmen2",6);
}

schwimmen2()
{
	write(
"\n\nDu schwimmst raus auf den See. Du spuerst, wie alle Lasten und Alltagsprobleme\n"
+"von Dir fallen. Du bist nur mehr ganz Du selbst. Alle deine kleinen Probleme,\n"
+"Selbstzweifel verschwinden...");
	call_out("schwimmen3",6);
}

schwimmen3()
{
	object ob;
	write(
"\n\nLangsam schwimmst Du zurueck ans Ufer, ziehst, noch immer tief in Dir selbst\n"
+"ruhend, Deine Sachen wieder an und bist nun bereit, um Xalgur gegenueberzu-\n"
+"treten.\n");
	ob = present("\nscript_schwimmen",TP);
	ob->remove();
	erhoehe_zaehler(4);		//*** war schwimmen auch
	return "";
}


erhoehe_zaehler(z)
{
	if(getuid(previous_object())!= getuid() )
	{
		write("Du bist nicht berechtigt, das zu tun...\n");
		return 0;
	}
	zaehler = z;
}

frage_zaehler()
{
	return zaehler;
}

fertig(object ob)
{
	call_out("fertig1",2, ob);
}
fertig1(object ob)
{	object ob1;
	if(!objectp(ob)) return ;

	tell_object(ob, "Du hast es tatsaechlich geschafft! Schnell "
	+"schuettest Du das Loch zu.\nXalgur ist nun wieder durch "
	+"die junge Zeder gebannt!\n");
	//give_quest("Die alte Zeder");
	ob1 = present("\nzedernquestloch", environment(ob));
	write(ob1);
	if(objectp(ob1)) { write("im ob2!...\n"); ob1->remove();}
	ob1 = present("xalgurknochen" ,environment(ob));
	write(ob1);
	if(objectp(ob1)) ob1->remove();
	remove();
}
