#include "../def.h"

inherit "std/npc";

void grab();
void person();
void knochen();
void zeder();

void create()
{
  if(!is_clone(TO)) return;  
  ::create();   

  SetProp(P_SHORT, "Elfe Baaleth");
  SetProp(P_LONG, 
	  BS("Baaleth ist eine junge, sehr huebsche Elfe, die "
	     "wohl nicht aelter als 30 Jahre ist. Fuer eine Elfe also recht "
	     "jung. Eine seltsame Aura umgibt sie. Du merkst, dass sie keine "
	     "gewoehnliche Elfe ist."));  

  set_living_name("baaleth");

  SetProp(P_GENDER, FEMALE);  

  SetProp(P_NAME, "Baaleth");  
  SetProp(P_ARTICLE, 0);  

  AddId(({"baaleth", "enkelin","elfe"}));  

  SetProp(P_DIE_MSG, " verschwindet in einem hellen Blitz.\n");  
  SetProp(P_NOCORPSE, 1);

  create_default_npc (20);  

  SetProp(P_HANDS, ({" mit ihren Haenden", QueryProp(P_HANDS)[1], 
		       DT_BLUDGEON}));  
  SetAttribute(A_INT, 25);
  
  SetProp(P_MSGIN, "kommt herein");  
  SetProp(P_MSGOUT, "geht weiter.");  

  SetProp(P_HEAL, 20);  

  SetProp(P_RACE, "Elf");  
  SetProp(P_ALIGN, 550);  
  SetProp(P_SIZE, 181);
  SetProp(P_BODY, 90);
  SetProp(P_XP, 0); //Quest-NPC :)
  
  SetGuardProtection(100, GUARD_QUEST);
  
  SetProp(P_RESISTANCE_STRENGTHS, 
	  ([DT_MAGIC:-0.8,  DT_ACID:-0.8,
	    DT_POISON:-0.9, DT_COLD:-0.5,
	    DT_TERROR:-0.3, DT_FIRE: -1]));
  
  switch(random(3))
    {
    case 0:
      CLONEME(ARMOUR "hemd");    
    case 1: 
      CLONEME(ARMOUR "leggings");
    case 2:
      CLONEME(ARMOUR "armschienen");
      break;
    }
  
  SetProp(P_NOMAGIC, 65);
  
  AddInfo(({"haendler","kautz","kauz","ranadrion"}),
	  "Ja, den habe ich bereits gesehen. Er ist erst seit kurzem hier und "
	  "kuemmert sich nun um den Laden. Er ist ein etwas seltsamer, alter "
	  "Kautz, finde ich. Er meditiert oft stundenlang und ist auch sonst "
	  "bei Aktivitaeten in Elessar nicht anzutreffen.",
	  "sagt: ");
  
  AddInfo(({"culfeniel","tierheim","heim"}),
	  "Culfeniel betreut das Tierheim hier in Elessar.",
	  "meint: ");  
  
  AddInfo(({"xulia"}),
	  "Xulia? Das ist doch die aus der Obsttheke, nicht?",
	  "meint: ");
  
  AddInfo(({"obsttheke","theke"}),
	  "Die Obsttheke befindet sich hinten bei Xelindo.",
	  "sagt: ");
  
  AddInfo(({"aktivitaeten","feste","feiern","fest","feier"}),
	  "Hier in Elessar werden oft Feste gefeiert. Sie finden oft drueben "
	  "bei Xelindo statt.",
	  "sagt: ");

  AddInfo(({"wirt","xelindo"}),
	  "Xelindo ist der Wirt im Doore, ein echt netter Elf, wenn er nicht "
	  "dauernd nach Gluehwein riechen wuerde!",
	  "sagt: ");
  
  AddInfo(({"wein","gluehwein","bier","rum","alkohol"}),
	  "Ich trinke keinen Alkohol!",
	  "sagt: ");

  AddInfo("elfen",
	  "Also wenn Du das nicht weisst...",
	  "staunt: ");
     
  AddInfo(({"stadt","elessar"}),
	  "Du befindest Dich direkt in Elessar.", 
	  "sagt: ");
  
  AddInfo(({"fluch","besessenheit"}),
	  "Du bist besessen von Xalgurs Geist?! Ohje-ohje....Am Besten, "
	  "Du gehst zu Shardin, sie soll Dich heilen.",
	  "schaudert: ");
  
  AddInfo("magie",
	  "Lorendiel, ein Vorfahre von mir, war sehr bewandert in "
	  "der Magie.",
	  "sagt: ");
  
  AddInfo(({"vorfahr","lorendiel"}),
	  "Lorendiel ist ein Vorfahre von mir.",
	  "sagt: ");
  
  AddInfo("baaleth", 
	  "staunt: Woher kennst Du meinen Namen?");
  
  AddInfo("sargola",
	  "sagt: Sargola ist ein wahrhaft edler Magier!");  
  
  AddInfo("lexin",
	  "Sie ist die Nachfahrin von Xalgur, eine zutiefst boese Person.",
	  "sagt: ");
  
  AddInfo("kraeuter",
	  "Da musst Du am besten Shardin fragen, sie kennt sich bei "
	  "Kraeutern gut aus.",
	  "sagt: ");
  
  AddInfo("shardin",
	  "Sie lebt versteckt im Westen des Sees von Rhondonit.",
	  "sagt: ");
  
  AddInfo(({"see","see von rhondonit","rhondonit"}),
	  "Er liegt noerdlich von Elessar.",
	  "sagt: ");
  
  AddInfo(({"aufgabe","quest","problem"}),
	  "Hmm. Fuer solche Dinge ist meistens Aerendil zustaendig.",
	  "sagt: ");
  
  AddInfo(({"aerendil","bibliothekar"}),
	  "Aerendil ist der Bibliothekar und befindet sich im Nordosten von "
	  "Elessar.",
	  "sagt: ");
  
  AddInfo(({"baum","zeder"}), CLOSURE(zeder));
  
  /*
    AddInfo(({"baum","zeder"}),
        "Es wuchs einst eine uralte, maechtige Zeder mitten in der Lichtung "
	"westlich von hier. Doch durch einen Sturm wurde sie zerstoert.",
	"sagt: ");
  */	

  AddInfo("sturm",
	  "Waehrend des Sturmes wurde die Zeder von einem Blitz getroffen "
	  "und gespalten. Der Baum stuerzte um, seine Wurzeln liegen "
	  "jetzt frei.",
	  "sagt: ");
  
  AddInfo(({"wurzel","wurzeln"}),
	  "Ich vermute, die freiliegenden Wurzeln oeffneten das Grab von "
	  "Xalgur.",
	  "sagt: ");
  
  AddInfo("blitz",
	  "macht eine Handbewegung und ein greller Blitz entsteht.");
  
  AddInfo("lichtung",
	  "Ja, die Lichtung westlich von Elessar.",
	  "sagt: ");
  
  AddInfo("hilfe",
	  "Wenn mir doch jemand sagen koennte, was der Grund fuer die "
	  "seltsamen Erkrankungen ist...",
	  "seufzt: ");
  
  AddInfo("grund",
	  "Ja wenn ich den wuesste...",
	  "sagt: ");
  
  AddInfo(({"krankheiten","eigenart","krank","krankheit","verhalten",
	      "erkrankungen"}),
	  "In den letzten Wochen wurden viele Elfen von seltsamen Krankheiten "
	  "befallen. Ihr ganzes Leben lang nette und zuvorkommende Bewohner "
	  "von Elessar begannen zu stehlen, rauben und sogar ein Mord "
	  "geschah. Einige verloren ganz den Verstand. Keiner weiss genau, "
	  "was mit den Elfen geschah. Ich habe da eine schreckliche "
	  "Vermutung...",
	  "sagt: ");
  
  AddInfo("vermutung",
	  "Meine Eltern haben mir erzaehlt, dass es frueher, als "
	  "Lorendiel im Rat der Aeltesten war, einen abtruennigen Elfenmagier "
	  "gab, der sich der boesen Seite der Macht verschrieben hatte. Sein "
	  "Name war Xalgur und er richtete grossen Schaden an. Der Rat "
	  "beschloss, sich seiner zu entledigen. Doch Xalgur konnte nicht "
	  "einfach getoetet werden. Man befuerchtete, dass seine Seele nach "
	  "dem Tod in einen anderen Koerper wanderte. Die einzige "
	  "Moeglichkeit war, ihn lebendig zu begraben und auf seinem Grab "
	  "eine junge Zeder zu pflanzen. Durch die Kraft der Zeder wuerde "
	  "seine Seele am Weiterwandern gehindert werden.", 
	  "sagt: ");
  
  AddInfo("kraft",
	  "Die Kraft der Zeder ist in der Lage, die Seele am Wandern zu "
	  "hindern.",
	  "sagt: ");
  
  AddInfo("weiterwandern",
	  "Manche glauben, die Seele wandert nach dem Tode in fremde Koerper.",
	  "sagt: ");
  
  AddInfo("eltern",
	  "Ich denke nicht, dass Du sie kennst.",
	  "sagt: ");
  
  AddInfo(({"elfenmagier","abtruenniger","xalgur"}),
	  "Durch die Magie des abtruennigen Elfenmagiers Xalgur wurden viele "
	  "Elfen krank, starben oder wurden verrueckt. Der Rat der Aeltesten "
	  "konnte nichts unternehmen.",
	  "sagt: ");
  
  AddInfo("seele",
	  "Die Seele konnte, wenn man die Faehigkeit hatte, nach dem Tod, "
	  "weiterwandern.",
	  "sagte: ");
  
  AddInfo(({"ende","tod"}),
	  "Der Tod ist nur fuer normale Sterbliche das Ende.",
	  "sagt: ");
  
  AddInfo("koerper",
	  "Es soll moeglich sein, dass die Seele sich einen neuen Koerper "
	  "sucht.",
	  "sagt: ");
  
  AddInfo("sterbliche", 
	  "Ja, auch Du bist sterblich.",
	  "sagt: ");
  
  AddInfo("grab", CLOSURE(grab));
  
  AddInfo(({"reste","knochen"}), CLOSURE(knochen));
 
  AddInfo(({"gestalt","person"}), CLOSURE(person));
  
  AddInfo(({"zeit","woche","wochen"}),
	  "Ja, das alles passierte in den letzten Wochen.",
	  "sagt: ");
  
  AddInfo("leben",
	  "Ihr Leben lang waren sie normale Bewohner von Elessar. Irgendetwas "
	  "veraenderte ihr Leben schlagartig. Was das nur sein koennte?",
	  "sagt: ");
  
  AddInfo("bewohner",
	  "Die verrueckten Elfen sind alle Bewohner von Elessar.",
	  "sagt: ");
  
  AddInfo(({"sache","mord"}),
	  "Das ist ein ganz dunkles Kapitel in unserer Geschichte...",
	  "sagt: ");
  
  AddInfo("geschichte",
	  "Die Geschichte der Elfen ist lang und nicht immer ruhmreich.",
	  "sagt: ");
  
  AddInfo("verstand",
	  "Aus irgendeinem Grund wurden einige Leute aus Elessar verrueckt.",
	  "sagt: ");
  
  AddInfo("grund",
	  "Ja wenn ich den bloss wuesste... "
	  "Obwohl ich da eine Vermutung habe...",
	  "jammert: ");
  
  AddInfo(({"enkelin","baaleth","nachfahrin"}),
	  "Ich bin eine Nachfahrin von Lorendiel, der einst den Rat der "
	  "Aeltesten in Elessar anfuehrte.",
	  "sagt: ");
  
  AddInfo("lorendiel",
	  "Lorendiel war einst ein Fuehrer des Rates der Aeltesten.",
	  "sagt: ");
  
  AddInfo(({"rat","rat der aeltesten","aeltesten","geschick","geschicke"}),
	  "Der Rat der Aeltesten beschliesst die Geschicke des Stammes.",
	  "sagt: ");
  
  AddInfo("meditation",
	  "Du musst in Deiner Meditation die Stille des Waldes und die "
	  "Kraft der Natur spueren. Dann bist Du bereit fuer den zweiten "
	  "Teil, das reinigende Bad.",
	  "sagt: ");
  
  AddInfo("bad",
	  "Wenn Du in der Stille des Waldes Dich selbst erfahren hast, "
	  "kannst Du durch ein Bad im See von Rhondonit eine Seele "
	  "gaenzlich von Unreinheiten und Selbstzweifeln befreien. Erst "
	  "dann bist Du wirklich bereit, um mit Xalgur zusammenzutreffen.",
	  "sagt: ");
  
  AddInfo("wald",
	  "Am besten, Du gehst in den Wald noerdlich des Sees.",
	  "sagt: ");
  
  AddInfo(({"see","see von rhondonit","rhondonit"}),
	  "Der See liegt noerdlich von Elessar. Du kannst ihn nicht "
	  "verfehlen.",
	  "sagt: ");
  
  AddInfo("selbstzweifel",
	  "Die Selbstzweifel kannst Du durch Meditation in der Stille der "
	  "Natur, am Besten im Wald, bewaeltigen.",
	  "sagt: ");
  
  AddInfo("unreinheiten",
	  "Die Unreinheit Deiner Seele kannst Du nur durch ein reinigendes "
	  "Bad im See von Rhondonit erreichen.",
	  "sagt: ");
  
  AddInfo("seele",
	  "Ueber die Seele ist schon so viel geschrieben worden...",
	  "sagt: ");
  
  AddInfo("setzling",
	  "Den Setzling musst Du westlich der alten Zeder pflanzen. Und "
	  "vergiss vorher nicht, die Knochen darunter zu vergraben.",
	  "sagt: ");
  
  AddSpell(1,290,    
	   "Baaleth trifft Dich mit einem feuerroten Ball.\n",
	   "Baaleth trifft @WEN mit einem feuerroten Ball.\n",
	   DT_FIRE,  ([SP_SHOW_DAMAGE:1]) );
  
  AddSpell(2,210,    
	   "Baaleth fuegt Dir mit ihrem Blick Schmerzen zu.\n",
	   "Baaleth fuegt @WEM mit ihrem Blick Schmerzen zu.\n",
	   DT_FIRE,  ([SP_SHOW_DAMAGE:1]) );
  
  
  SetAttackChats(10, ({   
    "Baaleth wird noch wilder.\n",
      "Baaleth beginnt mit einer Kampf-Meditation.\n",
      "Baaleth erschafft um sich eine magische Aura.\n"}));
} 

nosave void sfkt(string str)
{
  command_me("sage "+str);
}

void give_notify(object ob)
{
  if(ob->query_owner()!=TP->query_real_name() )
    {
      sfkt("Was sind denn das fuer seltsame Knochen? Die sind sicher "
	   "nicht von Xalgur. Besorg mir die richtigen Knochen.");

      ob->remove();

      return;
    }

  if(!ob->id("\nxalgurknochen"))
    {
      write("Baaleth fragt: Wozu soll ich das brauchen?\n");

      give_obj(ob, TP);

      return;
    }
  else
    {
      if(ob->query_owner() !=TP->query_real_name() )
	return sfkt("Hmm... die Knochen sind wohl nicht die, die ich suche.");

      sfkt("Also hatte ich doch recht! Lexin hatte ich schon lange im Auge. "
	   "Nun sollte Ruhe einkehren. Die Knochen muessen nun neu "
	   "vergraben werden und eine neue Zeder muss gepflanzt werden. Doch "
	   "wird das nicht ungefaehrlich sein. Xalgurs Seele ist frei und "
	   "wird versuchen, Dich daran zu hindern. Ich habe herausgefunden,"
	   "dass Du Deine Seele reinigen musst, um Xalgurs Seele "
	   "gegenueberzutreten. Das geschieht durch Meditation im Wald und ein"
	   " Bad in einem See. Ist Deine Seele bereit, dann pflanze westlich "
	   "der alten Zeder eine neue. Hier hast Du den jungen Setzling "
	   "einer Zeder.");

      give_obj(ob,TP);

      if(!present("setzling", TP)) 
	CLONE(OBJ "setzling", TP);
    }
}

void zeder()
{
  if(!present("\nzedernquestobject",TP))
    CLONE(OBJ "quest", TP);
  
  sfkt("Es wuchs einst eine uralte, maechtige Zeder mitten in der "
       "Lichtung westlich von hier. Doch durch einen Sturm wurde sie "
       "zerstoert.");

  return ;
}

void grab()
{
  if(!present("\nzedernquestobject",TP))
    {
      sfkt("Seine Knochen wurden unter der alten Zeder begraben. Doch ich "
	   "befuerchte, dass durch den Sturm, der die Wurzeln freilegte, "
	   "die Seele entweichen konnte. Ich bitte Dich, sieh zur Zeder "
	   "und versuche herauszufinden, ob die Reste seiner Knochen noch "
	   "dort sind.");

      CLONE(OBJ "quest", TP);
      
      return ;
    }
  else
    {
      sfkt("Bitte untersuche die Wurzeln der Zeder. Die Zeit draengt!");

      return ;
    }
}

void person()
{
  object ob;
  
  ob=present("\nzedernquestobject", TP);
  if((!objectp(ob)) || (objectp(ob) && !ob->frage_zaehler()))
    {	
      return write(BS("Baaleth fragt: Was soll ich dann darueber wissen?"));
      //return ;
    }	
  else
    {
      sfkt("Hmm, ich hab es befuerchtet! Du musst folgendes wissen: Die "
	   "Urenkelin von Xalgur mit dem Namen Lexin wohnt abgeschieden im "
	   "Nordwesten unseres Dorfes. Ich vermute, dass sie die Knochen "
	   "gestohlen hat. Besuch sie bitte und versuche herauszufinden, "
	   "was sie mit den Knochen vorhat.");

      return ;
    }
}

void knochen()
{
  object ob, ob1;

  ob=present("\nxalgurknochen",TP);
  
  if(ob1 = present("\nzedernquestobject",TP))	//*** er macht die Quest
    {
      if(ob1->frage_zaehler() == 1)
	{
	  return sfkt("Ob Lexin die Knochen genommen hat?");
	  //return;
	}
      
      if(deep_present("\nxalgurknochen",TP))	//*** er war schon bei Lexin
	{
	  return sfkt("Gib sie mir doch mal.");
	  //return ;
	}
      else
	sfkt("Die Reste mit seinen Knochen muessten sich unter den Wurzeln "
	     "finden lassen.");
    }
  else
    sfkt("Darueber weiss ich nichts.");
}
