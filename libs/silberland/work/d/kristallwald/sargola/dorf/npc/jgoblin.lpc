inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>

#include "../def.h"

create()
{
    if (!is_clone(this_object())) return;
       ::create();
  SetProp (P_SHORT, "Ein Junggoblin");
  SetProp (P_LONG, BS("Ein junger, schneidiger Goblin steht vor Dir. Er mag zwar noch nicht "
      +"sehr kampferfahren sein, aber trotzdem kann er durch seine Hinterhaeltigkeit "
      +"und List gefaehrlich werden. Er haelt einen schartigen Saebel.\n"));
  SetProp (P_DIE_MSG, " grunzt ohrenbetaeubend, dann entschlummert er sanft.\n");
  SetProp (P_NAME, "Junggoblin");
  SetProp (P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_AGGRESSIVE,1);
  AddId ( ({"goblin", "junggoblin"}) );
  create_default_npc (13);

  SetProp (P_HANDS, ({" mit blossen Haenden", 70,DT_BLUDGEON}));
  SetProp (P_ALIGN, -100);
  SetProp (P_RACE, "Goblin");
  SetProp (P_SIZE, 140);
  SetProp (P_MSGOUT, "trampelt weiter");
  SetProp (P_MSGIN, "trampelt herein");
   

  SUID;  
  //clone_object("/d/ebene/obj/ruestung/lederruestung.lpc")->move(TO);
  clone_object(WEAPON+"gsaebel.lpc")->move(TO);
  //clone_object(OBJ+"gschild.lpc")->move(TO);
  command ("ziehe alles an");
  command ("zuecke saebel");

  AddInfo ("goblin","grunzt laut.\n");
  AddInfo("sargola", "Sargola ist mein Meister.","zischt: ");


  


  SetAttackChats(10, ({
   "Der Goblin kommt aus dem Gleichgewicht.\n",
   "Der Goblin kann Deinen Schlaegen nicht ausweichen.\n",
   "Der Goblin wirft Dir einen boesen Blick zu.\n"
       }) );

}
