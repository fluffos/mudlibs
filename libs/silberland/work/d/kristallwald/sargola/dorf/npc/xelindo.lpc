#include "../def.h"

inherit "std/npc";

#define AI(x, y) AddInfo(x, y, "lallt: ")

void create()
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Hochelf Xelindo, der Wirt vom Al Haskin-Doore");
  SetProp(P_LONG, 
	  BS("Das ist Xelindo, der hiesige Wirt. Er passt auf, dass hier "
	     "keiner randaliert und alle genug zu essen und zu trinken haben. "
	     "Er wuselt geschaeftig hin und her.")+
	  BS("Sonderlich nuechtern scheint er nicht zu sein.")); 

  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  SetProp(P_NAME, "Xelindo");
  SetProp(P_ARTICLE, 0);
  AddId(({"xelindo","wirt","hochelf","elf", ELESSARELF}));
  SetProp(P_DIE_MSG, " trinkt noch einen und geht dann..\n");
  SetProp(P_MURDER_MSG, "PROOOOOOOOOOOOOOOSCHT!!");
  create_default_npc (17);

  SetProp(P_HANDS, ({" mit seinen kraeftigen Armen", 190, DT_BLUDGEON}));
  SetProp(P_BODY, QueryProp(P_BODY)+30);

  SetProp(P_MSGIN, "wankt herein");
  SetProp(P_MSGOUT, "wankt weiter.");
  SetProp(P_HEAL, 10);
  SetProp(P_RACE, "Elf");
  SetProp(P_ALIGN, 300);
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 73284);

  SetProp(P_REJECT, ({REJECT_KEEP, "Xelindo ruelpst: Danke!\n"}));

  SetProp(P_NOMAGIC, 10);
  
  SetProp(P_SPELLRATE, 30);

  AddSpell(3,220,
	   "Xelindo zieht Dir mit einer Flasche eins ueber.\n",
	   "Xelindo zieht @WEM mit der Flasche eins ueber.\n",
	   DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,333,
	   "Xelindo ruelpst Dir voll ins Gesicht!!\n"
	   "Dir wird schlecht...\n",
	   "Xelindo ruelpst @WEM voll ins Gesicht!!\n",
	   DT_POISON, ([SP_SHOW_DAMAGE:0]));

  AI(({"wasser","rhondonitwasser"}),
     "Frischesch Wascher ausch dem Rhondonitschee, aber ich trinke lieber den "
     "Gluehwein...");
  
  AI(({"see","rhondonitsee"}),
     "Der See befindet schich im Norden. Meine Frau und meine Kinder gehen "
     "dort oft hin, um tschu baden.");
  
  AI(({"kinder","kind"}),
     "Die Kinder schbielen meischd oben im Krischdallwald.");

  AI(({"frau","ehefrau"}),
     "Die ischd hinten und bereitet die Schbeischen vor.");
  
  AI(({"heim","talan"}),
     "Ahja, mein Talan, mein Heim...");
  
  AI(({"beerensaft","extrakt","beerenextrakt"}),
     "Der beschde Beerenextrakt den Du im gantschen Krischdallwald "
     "findeschd.");

  AddInfo(({"wald","kristallwald"}),
	  "deutet ungefaehr nach Norden.");
  
  AI(({"saft","traubensaft"}),
     "Schehr guter Traubenschaft ausch den beschden Trauben von Derlimsch "
     "Weinbergen.");
  
  AI(({"traube","trauben"}),
     "Die Trauben fuer meinen Traubenschaft kommen alle ausch Derlim");
  
  AI(({"derlim","weinberg","weinberge"}),
     "Von Derlimsch Weinbergen bekomme ich immer die guten Trauben fuer "
     "meinen Traubenschaft, oder den Wein.");
  
  AI(({"sirup","weizensirup"}),
     "Schehr schuesch, der Weitschenschirup. Ich trinke den nicht, ich mag da "
     "eher den Gluehwein.");
  
  AI(({"wein","gluehwein"}),
     "Aaah! Der Gluehwein! Mein Lieblingschgetraenk... Ausch den beschden "
     "Trauben von Derlimsch Weinbergen hergeschdellt und unter den "
     "wachschamen Augen der Hobbitsch vergoren ischd der Gluehwein dasch "
     "beschde Getraenk, dasch esch nur geben kann. Schnell! Beschdell Dir "
     "gleich einen!");
  
  AddInfo(({"alkohol"}),
	  "strahlt Dich an.");
  
  AI(({"hobbit","hobbits"}),
     "Die Hobbitsch wohnen in Derlim und tschuechten aufd ihren Weinbergen "
     "die Trauben fuer meinen Gluehwein *schabber*");

  AI(({"getraenk","getraenke","angebot","angebote","menue"}),
     "Mit 'menue' schiehschd Du mein Angebot.");

  AI(({"muesliriegel","riegel","muesli"}),
     "Meine Mueschliriegeln schind die Beschden weit und breit.");

  AI(({"bruehe","gemuesebruehe","eintopf","gemueseeintopf"}),
     "Esch geht doch nichtsch ueber einen kraeftigen Gemuescheeintopf.");
  
  AI(({"salat","vogerlsalat"}),
     "Dasch ischd gantsch frischer Vogerlschalat mit schelbergemachtem "
     "Knoblauchdresching, nach eigenem Retschept.");
  
  AI(({"dressing","knoblauchdressing","knoblauch"}),
     "Meine Frau macht ein schupergutesch Knoblauchdresching! Nach einem "
     "eigenen, uralten Retschept.");
  
  AI(({"rezept","geheimrezept","dressingrezept","knoblauchdressingrezept"}),
     "PSCHT! Dasch ischd geheim!");

  AI(({"forelle","blauforelle","forelle blau"}),
     "Frische Forellen ausch dem Rhondonitschee, aber ich esche schie nicht "
     "scho oft, wegen der vielen Graeten.");
  
  AI(({"graeten","graete"}),
     "Die Blauforellen schind voll davon *g*");

  AI(({"braten","hirschbraten"}),
     "Beschder Hirschbraten, den Du hier im Krischdallwald bekommen "
     "kannschd!");

  AddInfo(({"dorf","siedlung","elfendorf","elfensiedlung","elessar"}),
	  "Nur wenige Leute wischen, wo schich Eleschar befindet.",
	  "lallt verschmitzt: ");
  
  AI(({"speisen","getraenke"}),
     "Schieh Dir mal dasch Menue an.");
  
  AI("doore",
     "Der Doore dient Elfen um Neuigkeiten auschdschutauschen und "
     "abendsch ein wenig auschdschuschbannen.");

  AI("emthal",
     "Emthal war einer meiner beschden Gaeschde. Tschumindeschd vor "
     "einiger Tscheit...");

  AI(({"besuche","gast"}),
     "Emthal war jeden Abend hier, ertschaehlte Geschichten.");

  AI("geschichten",
     "Scheine Geschichten waren vielleicht nicht immer wahr aber schie "
     "schorgten immer fuer gute Laune unter den Gaeschden. Er konnte "
     "wahrlich gut Geschichten ertschaehlen.");

  AI("zeit",
     "Esch ischd lange her, dasch ich Emthal dasch lettschde Mal "
     "geschehen habe.");

  AI(({"letztes mal","mal"}),
     "Bei scheinen letschden Beschuchen war er verschloschener alsch "
     "schonschd. Er machte blosch scheltschame Andeutungen.");

  AI("andeutungen",
     "Keiner wuschde genau, wovon er schbrach. Einer der Waechter "
     "schasch einige Tscheit bei ihm. Frag doch den mal.");

  AI("waechter",
     "Welcher esch war, weisch ich leider auch nicht mehr.");
  
  AI("sargola", 
     "Der hat mich brogrammiert!");
  
  AI(({"xulia","tochter"}),
     "Kschulia ischd meine Dochder. Schie ischd vermudlich irgendwo hinden "
     "und schbield mid ihrem Obschd.");
  
  AI(({"obst","obsttheke","theke"}),
     "Kschulia had da hinden ihre Obschddhege, die had dord gargeinen "
     "Algohol!");     
  
  AI("culfeniel",
     "Jo, die schuesche Culfeniel had jedschd dasch Dierheim uebernommen. "
     "Frueher had schie immer mid meiner Dochder Kschulia geschbield.");
  
  AI(({"heim","tierheim"}),
     "Dasch befindet schich im Schuedweschden von Elessar.");
  
  SetChats(2, ({
    "Xelindo trinkt ein Glaeschen Gluehwein.\n",
      "Xelindo prostet Dir zu.\n",
      "Xelindo grinst Dich an.\n",
      "Xelindo trinkt ein Glaeschen mit einem anderen Elf.\n",
      "Xelindo bringt Jemandem einen Teller mit Gemueseeintopf.\n",
      "Xelindo bringt Jemandem eine frische Blauforelle.\n",
      "Xelindo bringt Jemandem einen frischen Hirschbraten.\n",
      "Xelindo reicht einem kleinen Elfenkind ein Glas Traubensaft.\n",
      "Xelindo ruelpst.\n"}));

  SetAttackChats(10, ({
    "Xelindo wankt bedenklich.\n",
      "Xelindo greift nach der naechstbesten Flasche.\n",
      "Xelindo wankt herum.\n"}));

  SUID;

  CLONEME(WEAPON "krug");
  command("zuecke krug");

  CLONEME("/p/armour/cloak/schuerze");
  command("trage alles");

  AddCmd(({"proste","prost"}), "zuprosten");
}

nosave int zuprosten(string str)
{
  notify_fail(BS("Wem willst Du zuprosten?"));
  if(!str) return 0;
  
  if(!id(str)) return 0;
  
  write(BS("Du prostest Xelindo zu.")+
	BS("Xelindo prostet zurueck.")+
	BS("Xelindo meint ploetzlich: Du haschd ja garniksch tschu drinken!")+
	BS("Xelindo meint: Losch! Beschdell wasch!"));
  
  tell_room(MENV, 
	    BS(TPN+" prostet Xelindo zu.")+
	    BS("Xelindo prostet zurueck."), ({TP}));
  
  return 1;
}

int _query_alcohol()
{
  return QueryProp(P_MAX_ALCOHOL)/2;
}

void init()
{
  if(!is_clone(TO)) return;
  ::init();
  
  if(!TP) return;

  if(TP->id(ELESSARELF))
    TP->AddDefender(ME);

  if(!MENV) return; 

  if(!interactive(TP)) return;

  if(file_name(MENV)!=ROOM "kneipe") return;

  call_out("begruessung", 0, TP);

  if(MENV->query_ban(getuid(TP))) return;
  
  if(WMASTER->is_elessar_enemy(TP))
    MENV->set_ban(getuid(TP));
}

void begruessung(object who)
{
  if((!objectp(who)) || (!present(who, MENV))) return;

  if(MENV->query_ban(getuid(TP)))
    tell_object(who, ({
      BS("Xelindo grummelt Dich an."),
	BS("Xelindo meint: Rausch ausch meiner Kneipe!"),
	BS("Xelindo meint: Verschwinde!")})[random(3)]);
  else
    if(lower_case(who->QueryProp(P_RACE))=="zwerg")
      tell_object(who,
		  BS("Xelindo meint: Na, fuer Dich gibsch hier kein Bier!"));
    else
      tell_object(who, ({
	BS("Xelindo prostet Dir zu."),
	  BS("Xelindo blickt Dich erfreut an."),
	  BS("Xelindo meint: Tritt herein, der Gluehwein wartet schon!"),
	  BS("Xelindo ruelpst und grinst.")})[random(4)]);
}

void InformDefend(object enemy)
{
  if(!MENV) return; 

  if(file_name(MENV)!=ROOM "kneipe") return;

  if(!query_once_interactive(enemy)) return;

  if(MENV->query_ban(getuid(enemy))) return;
  
  tell_object(enemy, 
	      BS("Xelindo erteilt Dir ob Deines Frevels Lokalverbot!!"));
  tell_room(MENV,
	    BS("Xelindo erteilt "+enemy->name(WEM)+" Lokalverbot!"), 
	    ({enemy}));

  MENV->set_ban(getuid(enemy));
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  WMASTER->ruf_um_hilfe(enemy);

  if(!pointerp(dam_type))
    dam_type=({dam_type});
  
  if((query_once_interactive(enemy)) && (MENV) && 
     (file_name(MENV)==ROOM "kneipe") && (!MENV->query_ban(getuid(enemy))))
    {
      tell_object(enemy, 
		  BS("Xelindo erteilt Dir ob Deines Frevels Lokalverbot!!"));
      tell_room(MENV,
		BS("Xelindo erteilt "+enemy->name(WEM)+" Lokalverbot!"), 
		({enemy}));
      
      MENV->set_ban(getuid(enemy));
    }

  return ::Defend(dam, dam_type, spell, enemy);
}

varargs void die(int poisondeath)
{
  WMASTER->killed_by(QueryProp(P_KILLER), 1);

  ::die(poisondeath);
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  if(killer==ME)
    WMASTER->player_killed(victim);
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {     
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
	       "sagt: Ah! Keine Angschd! Komm und trink nen Schluck!",
	       "sagt zu "+TPN+": Ah! Keine Angschd! Komm und trink nen "
	       "Schluck!");
      break;
    case "albern":
      call_out("reaction", 0, TP,
	       "kichert albern.",
	       "kichert albern.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
	       "grummelt Dich an.",
	       "grummelt "+TPN+" an.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
	       "ruelpst Dich an.",
	       "ruelpst "+TPN+" an.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
	       "prostet Dir zu.", 
	       "prostet rum");
      break;
    case "intim":
      call_out("reaction", 0, TP,
	       "sagt: He! Ich bin verheiradet!",
	       "sagt: He! Ich bin verheiradet!");
      break;
    case "nett":
      call_out("reaction", 0, TP,
	       "sagt: Komm und beschdell wasch!",
	       "sagt zu "+TPN+": Komm und beschdell wasch!");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
	       "meint: Isch doch wurscht! Bestell einen Gluehwein!",
	       "meint zu "+TPN+": Isch doch wurscht! Bestell einen Gluehwein!");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if(present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    }
}
