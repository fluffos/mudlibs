inherit "std/room";





#include <properties.h>


#include <language.h>


#include <moving.h>





#include "/d/kristallwald/sargola/def_kristall.h"








      create()


      {


        ::create();


	SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST,ENV_TEMPERATURE:20]) );     


        SetProp( P_INT_SHORT, "Im Kristallwald" );


        SetProp( P_INT_LONG, 


      BS("Um Dich breiten sich maechtige Baeume aus, die "


         +"den von Osten nach Westen fuehrenden Weg ueberdachen. "


         +"Der Weg, mit weissen Steinen gepflastert, fuehrt durch "


         +"die dichten Baeume.") );


     


        SetProp( P_LIGHT, 1 );


        SetProp( P_INDOORS, 0 );


     


        AddDetail( ({"ast","aeste"}), BS("Du entdeckst eine Art Holzboden in den Aesten.\n"));


        AddDetail( ({"boden","holzboden"}), BS("Er ist ziemlich weit oben in "


           +"den Aesten versteckt, kaum zu sehen. Leider sind die Aeste "


           +"zu weit vom Boden entfernt, als dass Du raufklettern "


           +"koenntest...\n"));





        AddDetail( ({"weg","boden"}), BS("Der Weg ist mit weissen Steinen gepflastert. "


           +"Links und rechts waechst Wiese.\n"));


   AddDetail ( ({"steine", "stein","pflasterstein","pflastersteine"}), BS("Es scheinen Pflastersteine "      +"zu sein.\n"));


   AddDetail( "himmel", BS("Den Himmel kannst Du nur mehr ueber dem Dach der Baeume "


      +"erahnen.\n")   );


   AddDetail ("wiese", BS("In kleinen, struppigen Buescheln saeumt sie den Weg.\n"));


   AddDetail ( ({"bueschel","buescheln"}), BS("Faustgrosse, fast halbrunde Bueschel.\n"));





   AddDetail( ({"blatt","blaetter"}), BS("Weissliche, fast durchsichtigen Blaetter bilden "


	+"ein Dach ueber Dir."));


   AddDetail("dach", BS("Ein wunderschoenes Dach aus Blaettern durch welches Sonnenstrahlen "


	+"bis zum Boden dringen."));


   AddDetail( ({"strahlen","sonnenstrahlen"}), BS("Sie dringen durch die dichten Aeste bis "


	+"zu Dir hier unten durch."));


   AddDetail("lauf", BS("Sie wachsen kerzengerade in den Himmel."));


   AddDetail("art", BS("Du bist Dir nicht ganz sicher..."));


       AddDetail( ({"kristallwald","wald"}), BS("Du stehst genau drin.\n")   );


   AddDetail ( ({"baum","baeume"}), BS("Maechtige, starke Staemme, die gerade in den "


      +"Himmel ragen.\n"));       


   AddDetail ( ({"stamm","staemme"}), BS("Du verfolgst ihren Lauf und kannst ein eigen"


      +"artiges Konstrukt zwischen den Blaettern entdecken.\n"));


   AddDetail( "konstrukt",BS("Es scheint eine Art Holzboden zu sein.\n"));


      


   AddSound (({DEFAULT_SOUND, "voegel"}), "Du hoerst Voegel in den Baeumen zwitschern.\n");


   


   AddSmell(DEFAULT_SMELL, "Du kannst auch nach ausgedehntem Riechen "


      +"nichts erschnuppern.\n");


      





        AddExit( "osten", ROOM_DORF+"0914.lpc" );





        AddExit( "westen", ROOM_DORF+"0714.lpc" );





} 


