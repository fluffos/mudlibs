#include "../def.h"
#include "dorf.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]));
  
  SetProp(P_INT_SHORT, "Elessar");
  SetProp(P_INT_LONG, 
	   BS("Du stehst hier auf der westlichsten Plattform. Unter Dir "
	      "fuehrt der Waldweg weiter von Westen nach Osten. Im Norden "
	      "siehst Du ein einfaches Haus. Eine Haengebruecke fuehrt nach "
	      "Suedwesten zu einem Aussichtsposten. Das Dorf breitet sich "
	      "nach Osten hin weiter aus."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail("haus", 
	    "Es ist einfach gehalten und auf einem kleinen Talan errichtet. "
	    "Scheinbar ist es ein privates Haus eines Elfen.");

  AddDetail(({"elessar","dorf","elfendorf"}), 
	    "Du stehst hier in Elessar, dem Dorf der Waldelfen.");

  AddDetail(({"elfen","waldelfen"}),
	    "Geschaeftig huschen sie hie und da vorbei.");
  
  AddDetail(({"posten","aussichtsposten"}),
	    "Im Suedwesten befindet sich ein Aussichtsposten.");
  
  AddDetail(({"bruecke","haengebruecke"}),
	    "Nach Suedwesten fuehrt eine Haengebruecke zu einem "
	    "Aussichtsposten.");
  
  STANDARD1
  STANDARD2
  BODEN_WEG
    
  AddRoomMessage(({
    "Eine sanfte Brise Wind faehrt durch die Baeume.\n",
      "Ein Blatt faellt genau auf Deine Nase!\n",
      "Irgendetwas raschelt unter Dir in den Straeuchern.\n" }), 100);

  AddItem(({NPC "waechter", NPC "waechtr1"}), REFRESH_DESTRUCT);
  
  AddExit("norden", ROOM "1_0513");
  AddExit("osten", ROOM "1_0614");
  AddExit("suedwesten", ROOM "1_0415");
  AddExit("runter", ROOM "0514");
}

void init()
{	
  ::init();
	
  if((interactive(TP)) && (TP->QueryProp(P_RACE)!="Elf"))
    {
      if((TP->QueryAttributes(A_DEX)<15) && (random(15)==1))
	call_out("runter", 0);
      else
	if(random(25)==1)
	  call_out("runter", 0);
    }
}

void runter()
{
  if(!TP) return;
  if(!present(TP)) return;
  
  tell_room(TO, BS(TPN+" versucht, sich auf den Talan zu retten, schafft es "
		   "aber nicht ganz und plumpst nach unten."),({TP}));
  
  tell_object(TP, 
	      BS("Gerade, als Du glaubst, sicher angekommen zu sein, "
		 "verlierst Du das Gleichgewicht...")+
	      BS("Und faellst durch die Zweige nach unten!"));
  
  TP->move(ROOM "0514", M_GO,"nach unten", "faellt", "faellt von oben herein");

  TP->AddHp(-10);
}
