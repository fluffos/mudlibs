#include "../def.h"
#include "dorf.h"

inherit "std/room";

#define TIERHEIM "/d/kristallwald/protheg/elessar/room/petshop"

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]));
  
  SetProp(P_INT_SHORT, "Elessar");
  SetProp(P_INT_LONG,
	  BS("Du stehst in einem ruhigeren Teil des Dorfes. Hier herrscht "
	     "nicht so hektisches Treiben. Eine Haengebruecke fuehrt nach "
	     "Nordwesten. Im Westen befindet sich Elessars Tierheim. Hier "
	     "wird das Dorf offenbar noch vergroessert."));
  
  AddDetail(({"dorf"}),
	    "Ja was glaubst Du denn, wo Du bist?");
  
  AddDetail(({"elf","treiben"}),
	    "Nur hin und wieder huscht ein Elf vorbei.");
  
  AddDetail(({"bruecke","haengebruecke"}),
	    "Eine Haengebruecke fuehrt nach Nordwesten zu einem "
	    "Aussichtsposten.");
  
  AddDetail(({"posten","aussichtsposten"}),
	    "Der liegt im Nordwesten.");
  
  AddDetail(({"heim","tierheim"}),
	    "Das befindet sich hier gleich im Westen.");
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  STANDARD1
  STANDARD2
  BODEN_WEG
    
  AddExit("nordwesten", ROOM "1_0415");
  AddExit("osten", ROOM "1_0616");
  AddExit("westen", TIERHEIM);

  AddItem("/gilden/bardengilde/obj/ehrenstatue", REFRESH_DESTRUCT, (["hero": "zafira"]));
}
