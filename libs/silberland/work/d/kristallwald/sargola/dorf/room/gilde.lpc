inherit "std/room";



#include <properties.h>

#include "/players/sargola/def_kristall.h"



create()

{

  ::create();

  SetProp (P_LIGHT,1);

  SetProp (P_INDOORS, 1);

  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));

  SetProp (P_INT_LONG, BS(

    "Dies ist ein Raum, der fuer eine Gilde freigehalten wird.\n"));

  SetProp (P_INT_SHORT,"Gilde");



  AddExit ("sueden", "./1_0914.lpc");

}



 

