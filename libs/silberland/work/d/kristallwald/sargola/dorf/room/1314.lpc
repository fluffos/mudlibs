#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
  
  
  SetProp(P_INT_SHORT, "Ein Waldweg");
  SetProp(P_INT_LONG, 
	   BS("Du befindest Dich auf einem schmalen, aber gut angelegten "
	      "Weg zwischen Mauern von Straeuchern. Ein gerader Gang "
	      "fuehrt in Richtung Sueden, wo es auch eine Art Lichtung zu "
	      "geben scheint. Du glaubst leises Murmeln zu hoeren."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail(({"mauer","mauern"}), 
	    "So dicht waechst das Gestruepp hier...");

  AddDetail("gang", 
	    "Er fuehrt nach Sueden, wo Du eine Lichtung vermutest...");

  AddDetail("lichtung", 
	    "Du kannst von hier aus nichts Genaues erkennen.");

  AddDetail("murmeln", 
	    "Sowas kann man doch nicht untersuchen!");

  AddDetail(({"weg","boden"}), 
	    "Der Boden besteht aus niedergetretener Erde und "
	    "niedergetretenen Zweigen.");

  AddDetail("zweige", 
	    "Sie sind schon trocken und rascheln beim Gehen.");

  AddDetail("erde", 
	    "Sie ist trocken und hart.");

  AddDetail("himmel", 
	    "Den Himmel kannst Du ueber den Straeuchern durchleuchten sehen.");

  AddDetail(({"strauch","straeucher", "gestruepp"}), 
	    "Undurchdringliche Straeucher befinden sich neben Dir. "
	    "Ein Gang fuehrt von Norden nach Sueden.");
  
  AddDetail(({"kristallwald","wald"}), 
	    "Du stehst genau drin.");

  AddSound(DEFAULT_SOUND, 
	   "Leises Murmeln dringt an Dein Ohr. Oder war es Einbildung?");

  AddSound("murmeln", 
	   "Jetzt ist es verstummt - wirst Du langsam verrueckt?");
  
  AddSmell(DEFAULT_SMELL, 
	   "Du glaubst ein Feuer riechen zu koennen.");

  AddSmell("feuer", 
	   "Der Geruch von verbranntem Holz ist unverkennbar.");
  
  AddExit("sueden", ROOM "1315");
  AddExit("norden", ROOM "1313");
}
