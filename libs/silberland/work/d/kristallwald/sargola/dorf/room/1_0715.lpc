inherit "std/room";

#include <properties.h>
#include <language.h>

#include "../def.h"
#include "dorf.h"

      create()
      {
        ::create();
     
     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]) );
     

        SetProp( P_INT_SHORT, "Elessar" );
        SetProp( P_INT_LONG, 
      BS("Du befindest Dich auf einem kleinen Talan, der nur einen Weg "
      +"weiter nach Sueden ermoeglicht. Neben Dir ragen dichte Kapseln "
      +"aus Aesten in den Himmel. Weitere Talane siehst Du im Sueden.") );
     
        SetProp( P_LIGHT, 1 );
        SetProp( P_INDOORS, 0 );
     
    
    STANDARD1
    STANDARD2
    BODEN_OHNE_WEG

        AddExit( "norden", ROOM+"1_0714.lpc" );
        AddExit( "sueden", ROOM+"1_0716.lpc" );
        
      }
 

