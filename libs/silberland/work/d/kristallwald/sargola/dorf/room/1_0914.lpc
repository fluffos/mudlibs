inherit "std/room"; 
 
#include "../def.h" 
#include "dorf.h" 

#define ELFENGILDE "/gilden/abenteurer/elfengilde"
 
void create() 
{ 
  ::create(); 
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]));
  
  SetProp(P_INT_SHORT, "Elessar"); 
  SetProp(P_INT_LONG,  
	   BS("Du stehst am oestlichen Ende von Elessar, der Elfenstadt. Sie " 
	      "liegt zur Gaenze in Aesten und besteht aus vielen Talanen, " 
	      "die durch Seilbruecken verbunden sind. Unter Dir siehst Du " 
	      "den Waldweg. Noerdlich von Dir scheint oberhalb ein "
	      "Gildengebaeude zu sein.")+
	  BS("Es fuehren weitere Bruecken nach Westen und Sueden."));
  
  SetProp(P_LIGHT, 1); 
  SetProp(P_INDOORS, 0); 

  AddDetail(({"gilde","gildengebaeude"}), 
	    "Es handelt sich um die neue Gilde der Elfen!"); 

  STANDARD1 
  STANDARD2 
  BODEN_WEG 
     
  AddItem(({NPC "waechter", NPC "waechtr1"}), REFRESH_DESTRUCT); 
 

  AddExit("nordoben", ELFENGILDE);

  AddExit("westen", ROOM "1_0814"); 
  AddExit("sueden", ROOM "1_0915"); 

  AddExit("runter", ROOM "0914"); 
} 
 

