#include "../def.h"
#include "dorf.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]));
  
  SetProp(P_INT_SHORT, "Elessar");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich auf einem kleinen Talan, der nur die Wege "
	     "nach Westen, Norden und Sueden ermoeglicht. Nach Nordosten "
	     "hin fuehrt ein Ast in den Elfenschrein. Neben Dir ragen "
	     "dichte Kapseln aus Aesten in den Himmel. Die Sonne scheint "
	     "durch die Decke aus Aesten. Eine Reihe weiterer Talane liegen "
	     "weiter im Westen. Nach Ostoben hin gelangt man in eine "
	     "Faerberei."));
     
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  STANDARD1
  STANDARD2
  BODEN_WEG
    
  AddDetail(({"faerberei"}),
	    "Nach Ostoben hin gelangst Du in die Faerberei.");
  
  AddDetail(({"schrein","elfenschrein"}),
	    "Der Elfenschrein befindet sich im Nordosten und ist ueber einen "
	    "dicken Ast erreichbar.");
  AddDetail(({"aeste"}),
	    "Die Aeste treiben waagrecht aus dem Stamm, wachsen aber bald in "
	    "den Himmel und bilden so eine schuetzende Kapsel. Ein besonders "
	    "starker Ast fuehrt nach Nordosten in den Elfenschrein.");
  AddDetail(({"ast"}),
	    "Nach Nordosten hin fuehrt ein besonders starker Ast in den "
	    "Elfenschrein.");

  AddExit("norden", ROOM "1_0715");
  AddExit("westen", ROOM "1_0616");
  AddExit("ostoben", ROOM "faerberei");
  AddExit("sueden", ROOM "1_0717");
  AddExit("nordosten", ROOM "kapelle");
}
 

