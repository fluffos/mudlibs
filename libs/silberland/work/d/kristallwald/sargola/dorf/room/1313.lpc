#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
  
  SetProp(P_INT_SHORT, "Ein Waldweg");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich auf einem schmalen, aber gut angelegten "
	     "Weg zwischen Mauern von Straeuchern. Ein gerader Gang "
	     "fuehrt in Richtung Sueden."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail(({"mauer","mauern"}), 
	    "So dicht wie Mauern sind die Straeucher hier gewachsen.");
  
  AddDetail("gang", 
	    "Er kommt direkt aus dem Strauch und fuehrt nach Sueden.");
  
  AddDetail(({"weg","boden"}), 
	    "Der Boden besteht aus niedergetretener Erde und "
	    "niedergetretenen Zweigen.");

  AddDetail("zweige", 
	    "Sie sind schon trocken und rascheln beim Gehen.");

  AddDetail("erde", 
	    "Sie ist trocken und hart.");
  
  AddDetail("himmel", 
	    "Den Himmel kannst Du ueber den Straeuchern durchleuchten sehen.");

  AddDetail(({"strauch","straeucher"}), 
	    "Beinahe undurchdringliche Straeucher befinden sich neben Dir. "
	    "Ein Gang fuehrt weiter nach Sueden.");
   
  AddDetail(({"kristallwald","wald"}), 
	    "Du stehst genau drin.");
   
  AddSound(DEFAULT_SOUND, 
	   "Leises Murmeln dringt an Dein Ohr. Oder war es Einbildung?");

  AddSound("murmeln", 
	   "Jetzt ist es verstummt - wirst Du langsam verrueckt?");
      
  AddSmell(DEFAULT_SMELL, 
	   "Du glaubst ein Feuer riechen zu koennen.");

  AddSmell("feuer", 
	   "Der Geruch von verbranntem Holz dringt in Deine Nase.");

  AddCmd(({"zwaenge", "schluepfe"}), "zwaenge");

  AddExit("sueden", ROOM "1314");
}

nosave int zwaenge(string str)
{
  notify_fail(BS("Wo willst Du Dich denn durchzwaengen?"));
  if(!str) return 0;
   
  if(str=="durch zweige"||str=="durch strauch"||str=="strauch"||
     str=="durch straeucher"||str=="straeucher")
    {
      if(!TP->do_exhaust(100)) 
	return 1;

      TP->move(ROOM "1212", M_GO, "direkt in den Strauch");
      return 1;
    }
  
  return 0;
} 

