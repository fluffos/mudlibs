#include "../def.h"
#include "/d/huegelland/feyaria/osterhase/oh.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
     
  
  SetProp(P_INT_SHORT, "In Elessars Faerberei");
  SetProp(P_INT_LONG, BS(
    "Du befindest Dich in einer verfallenen Holzhuette. Der Boden ist voll "
    "mit bunten Farbflecken. An einer Wand steht ein Tisch mit mehreren "
    "Toepfen. In einer Ecke liegt ein Haufen Geruempel herum. Im Westen "
    "fuehrt eine Tuer wieder auf den Talan hinaus."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  
  AddDetail(({"huette", "holzhuette", "wohnhaus"}),
    "Die Huette macht einen verlassenen Eindruck. Sie hat sicher niemals als "
    "Wohnhaus gedient sondern eher als eine Art Werkstatt.");
  AddDetail(({"werkstatt", "werkstaette", "faerberei", "art", "eindruck"}),
    "Wegen der vielen Farbtoepfe schliesst Du, dass es sich hier um eine "
    "Faerberei handeln muss.");
  AddDetail("boden",
    "Der Boden ist voll mit Farbflecken in allen Farben, die man sich nur "
    "vorstellen kann.");
  AddDetail(({"fleck", "flecken", "farbflecken", "farbfleck", "farbflecke"}),
    "Es gibt hier Farbflecken in den verschiedensten Farben. In den Flecken "
    "am Boden kann man ganz schwach Spuren erkennen.");
  AddDetail(({"spuren", "spur"}),
    "Bei den Spuren handelt es sich nicht um menschliche b.z.w. um elfische "
    "Spuren, wie man zuerst vermuten wuerde, sondern eindeutig um Tierspuren.");
  AddDetail(({"tierspuren", "tierspur"}),
    "Da Du ein geuebter Faehrtensucher bist, kannst Du die Spuren als "
    "Hasenspuren identifizieren.");
  AddDetail( ({"faehrtensucher", "faehrte"}),
    "Um die richtige Faehrte zu finden, kann man auch Details untersuchen, "
    "die aus mehr als einem Wort bestehen." );
  AddDetail( ({"wort", "woerter", "details"}),
    "Woerter wie zB 'schwarze Farbe'.");  
  AddDetail( ({"schwarze farbe", "beispiel"}),
    "Schwarze Farbe gibt es hier nicht, war ja nur ein Beispiel.");  
  AddDetail(({"hasenspuren", "hasenspur", "wesen"}),
    "Du beginnst zu kombinieren: Ein Hase, der was mit Farben zu tun hat. "
    "Welches Wesen koennte das wohl sein ?");
  AddDetail(({"osterhase", "osterhasenspuren", "osterhasenspur"}),
    "RICHTIG!!!! Hier hat frueher der Osterhase seine beruehmten Eier gefaerbt. "
    "Wahrscheinlich hat er sich hier im Elfendorf in der Umgebung von anderen "
    "'Langohren' besonders wohlgefuehlt.");
  AddDetail( ({"langohren", "elfen", "hase", "hasen", "elf"}),
    "Elfen und Hasen gehoeren zu den Langohren.");  
  AddSpecialDetail(({"eck", "ecke", "geruempel", "haufen", "sachen"}), 
      "geruempel");
  AddDetail("altwarenhaendler"
    "Sowas siehst Du hier nicht. Und auch Du bist sicher kein Altwarenhaendler.");
  AddDetail("tuer",
    "Die Tuer ist auch schon sehr alt, sie laesst sich kaum mehr bewegen, so "
    "stark ist sie durch Wind und Wetter verzogen. Zum Glueck ist sie offen, "
    "denn sonst muesste man sich hier mit Gewalt Zutritt verschaffen.");
  AddDetail( ({"wind", "wetter"}),
    "Wind und Wetter haben die Tuer stark verzogen.");  
  AddDetail( ({"glueck"}),
    "Glueck gehabt.");
  AddDetail( ({"gewalt", "zutritt"}),
    "Du bist froh, dass Du keine Gewalt anwenden musstest.");  
  AddDetail("talan",
    "Zum Talan kommst Du durch die Tuer im Westen. Viel kann man von hier "
    "nicht erkennen."); 
  AddDetail("decke",
    "An der Decke sind nur sehr wenige Farbflecken.");
  AddDetail(({"waende", "wand", "tisch"}), 
    "Auf dem Tisch an der Wand stehen mehrere Toepfe.");
  AddDetail( ({"farben", "farbe"}),
    "Rot, Blau, Gruen, Gelb, Orange, Rosa, Violett, Braun, Tuerkis, Schwarz. "
    "All das sind Farben (und es gibt noch viele mehr!)");
  AddDetail(({"orange", "rosa", "violett", "braun", "tuerkis", "schwarz"}),
    "Diese Farbe ist nicht vorhanden. Moeglicherweise kann man sie aus den "
    "Grundfarben durch Mischen erzeugen.");
  AddDetail(({"toepfe","farbtoepfe","grundfarben", "mischen"}),
    "Es gibt vier Farbtoepfe mit den Farben Gelb, Rot, Gruen und Blau. "
    "Leider sind die Farben eingetrocknet und somit unbrauchbar.");
  AddDetail(({"gelb", "gelber topf", "gelber farbtopf", "gelbe farbe"}),
    "Eine dottergelbe Farbe, ideal zum Eierfaerben.");
  AddDetail(({"dottergelb", "dottergelbe farbe"}),
    "Die Farbe riecht wirklich so, als wuerde sie aus Eidotter hergestellt. "
    "Leider ist die Farbe eingetrocknet und somit unbrauchbar. Vielleicht "
    "weiss aber der Osterhase mehr ueber diese Farbe.");
  AddDetail(({"rot", "roter topf", "roter farbtopf", "rote farbe"}),
    "Eine blutrote Farbe, ideal zum Eierfaerben.");
  AddDetail(({"blutrot", "blutrote farbe"}), 
    "Die Farbe schaut aus, als waere sie wirkliches Blut. *grusel* "
    "Leider ist die Farbe eingetrocknet und somit unbrauchbar. Vielleicht "
    "weiss aber der Osterhase mehr ueber diese Farbe.");
  AddDetail(({"gruen", "gruener topf", "gruener farbtopf", "gruene farbe"}),
    "Eine grasgruene Farbe, ideal zum Eierfaerben.");
  AddDetail(({"grasgruen", "grasgruene farbe"}),
    "Du fragst Dich, ob diese Farbe wirlich aus Gras gemacht wird. "
    "Leider ist die Farbe eingetrocknet und somit unbrauchbar. Vielleicht "
    "weiss aber der Osterhase mehr ueber diese Farbe.");
  AddDetail(({"blau", "blauer topf", "blauer farbtopf", "blaue farbe"}),
    "Eine himmelblaue Farbe, ideal zum Eierfaerben.");
  AddDetail(({"himmelblau", "himmelblaue farbe"}),
    "Es ist fast so, als ob ein Stueck des Himmels in diesem Topf steckt. "
    "Leider ist die Farbe eingetrocknet und somit unbrauchbar. Vielleicht "
    "weiss aber der Osterhase mehr ueber diese Farbe.");
  AddDetail(({"eierfarben", "eierfaerben"}),
    "Diese vier Farben eigen sich ideal zum Eierfaerben, man kann scheinbar "
    "jede beliebige Farbe aus diesen Grundfarben mischen.");
  AddDetail(({"flasche", "entfaerbungsmittel"}),
    "Mit diesem Entfaerbungsmittel kann man sicher angemalte Sachen "
    "entfaerben.");
  
  AddSmell(({DEFAULT_SMELL,"farbe","entfaerbungsmittel"}),
    "Hier riecht es recht streng nach Farbe und Entfaerbungsmittel.");
  
  AddCmd(({"entfaerbe", "entfaerb"}), "entfaerben");
  
  AddExit("westunten", ROOM "1_0716");
}

string geruempel()
{
  if(present(OSTERHASENQUEST_ID, TP))
    return BS(
      "Ein Haufen Geruempel liegt in diesem Eck, das einzige was brauchbar "
      "aussieht, ist eine Flasche mit Entfaerbungsmittel.");
  else
    return BS(
      "Ein Haufen Geruempel liegt in diesem Eck, Du kannst nichts Besonderes "
      "finden. Man muss schon ein Altwarenhaendler sein, um an solchen alten "
      "und kaputten Sachen Interesse zu haben.");
}

nosave int entfaerben(string str)
{
  object ei;

  if(!present(OSTERHASENQUEST_ID, TP)) return 0;

  notify_fail(BS("Was willst Du entfaerben?"));
  if(!str) return 0;

  if(ei=present(str, TP))
    if(ei->id(OSTERHASENQUEST_EI))
      {
	write(BS("Du entfaerbst "+ei->name(WEN,1)+" und es wird wieder "
		 "weiss."));
	say(BS(CAP_TPN+" entfaerbt "+ei->name(WEN)+"."), ({TP}));
	ei->faerben("weiss");
	return 1;
      }
    else
      notify_fail(BS("Das kannst Du hier nicht entfaerben!"));
  else
    notify_fail(BS("So etwas hast Du doch gar nicht!"));

  return 0;
}

    
