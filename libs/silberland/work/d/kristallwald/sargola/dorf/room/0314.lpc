#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:20]));
  SetProp(P_INT_SHORT, "Im Kristallwald");
  SetProp(P_INT_LONG, 
	  BS("Die Baeume hoeren hier auf und im Westen erstreckt sich eine "
	     "grosse Wiese. Wer weiss, was da auf Dich wartet...")+
	  BS("Im Norden und Nordosten liegt der Kristallwald."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail(({"baum","baeume"}), 
	    "Hier endet der Wald und mit ihm die weissen Staemme "
	    "der Baeume, die Dich bisher sicher umgeben haben.");
  
  AddDetail(({"wald","kristallwald"}), 
	    "So nennt man den Wald, der sich im Osten und Norden "
	    "erstreckt.");
  
  AddDetail("boden",
	    "Der Boden ist hier schon mit Wiese bewachsen, von einem "
	    "Weg wie weiter im Osten kann man nicht mehr sprechen.");
  
  AddDetail("weg",
	    "Im Osten kannst Du ihn genauer untersuchen.");
  
  AddDetail("himmel", 
	    "Er scheint deutlich zwischen den Baeumen durch.");
  
  
  AddDetail("wiese", 
	    "Von hier kannst Du nur mit Sicherheit sagen, "
	    "dass sie saftig gruen ist.");
  
  AddExit("westen", DORF_LICHTUNG);  
  AddExit("osten", ROOM "0414");
}
