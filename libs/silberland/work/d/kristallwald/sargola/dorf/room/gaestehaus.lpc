#include "../def.h"

inherit "std/room";

nosave int besucher;

create()      
{
   ::create();

   SetProp(P_INT_SHORT, "Im Schneckenhaus von Emma" );
   SetProp(P_INT_LONG, 
	   BS("Du staunst nicht schlecht, als Du "
	      "Dich umsiehst. Das hast Du Dir aber ganz anders vor"
	      "gestellt. Der Boden ist mit dicken, weichen Teppichen "
	      "ausgelegt, es gibt einen Tisch, Sessel und an den "
	      "Waenden haengen Bilder. Auch ein Bett wartet auf Dich."));

   AddDetail("decke",
	     "Die Decke der Schneckenhauses ist weiss gestrichen.");

   AddDetail(({"halme","aeste",}),
	     "Die kannst Du nicht so genau erkennen.");

   AddDetail("boden",
	     "Der Boden ist mit weichen und dicken Teppichen ausgelegt.");

   AddDetail(({"teppich","teppiche"}),
	     "Es ist ein hellbrauner Teppich, der Dir bis zu den Knoecheln "
	     "reicht.");

   AddDetail("knoechel",
	     "Sie sind vom Teppich fast verdeckt.");

   AddDetail("tisch",
	     "Ein rustikaler Tisch aus starker Eiche. Auf ihm befindet sich "
	     "eine Vase. Weiters findest Du zwei Teller und zwei Becher.");

   AddDetail("teller",
	     "Die Teller sind, wie die Vase, aus grobem Ton. Darauf findest "
	     "Du Bluetenstaub.");

   AddDetail(({"staub","bluetenstaub"}),
	     "Du kostest vorsichtig davon und es schmeckt Dir sofort. Der "
	     "suesse Geschmack ist einfach koestlich.");

   AddDetail("becher",
	     "Die toenernen Becher sind klein und enthalten eine duftende "
	     "Fluessigkeit.");

   AddDetail(({"tau","fluessigkeit"}),
	     "Es ist morgenfrischer Tau von Halmen. Herrlich!");

   AddDetail("eiche",
	     "Komisch, wie Emma solche Moebel hier hereingebracht hat. Und "
	     "wozu sie sowas ueberhaupt braucht!?");

   AddDetail("moebel",
	     "Du kannst Dir keinen Reim darauf machen. Aber vielleicht war "
	     "es ja auch nur Gastfreundschaft.");

   AddDetail("gastfreundschaft",
	     "Das ganze Zimmer hier strahlt Dir Gastfreundschaft entgegen.");

   AddDetail("zimmer",
	     QueryProp(P_INT_LONG));

   AddDetail("vase",
	     "Auf dem Tisch steht eine schwere und dicke Vase aus grobem Ton. "
	     "Sie ist ungleichmaessig geformt aber passt gut in das Ambiente "
	     "des Zimmers hier.");

   AddDetail("ton",
	     "Lausch doch mal! *grins* Nein Spass, der Ton ist luftgetrocknet "
	     "und hat eine rauhe Oberflaeche.");

   AddDetail("ambiente",
	     "Das ganze Zimmer hier wirkt sehr rustikal, und das gefaellt "
	     "Dir.");

   AddDetail("sessel",
	     "An dem Tisch stehen 2 Sessel, welche im gleichen Stil gezimmert "
	     "sind, wie der Tisch. An der Sessellehne befindet sich ein "
	     "Loch.");

   AddDetail("stil",
	     "Der gleiche, wie auch beim Tisch.");

   AddDetail(({"lehne","sessellehne"}),
	     "Du kannst ein Loch in der Lehne erkennen.");

   AddDetail("loch",
	     "Bei genauer Betrachtung erkennst Du, dass es sich um ein wohlge"
	     "formtes Herz handelt!");

   AddDetail("herz",
	     "Es ist wohl haendisch aus der Lehne geschnitzt worden. Welches "
	     "Liebespaar das wohl war...");

   AddDetail("liebespaar",
	     "Du kannst nur mehr das Zeichen ihrer Liebe erkennen.");

   AddDetail(({"zeichen","liebe"}),
	     "Mann, bist Du unromantisch! Na das Herz ist gemeint! ;) ");

   AddDetail(({"wand","waende"}),
	     "Die Waende sind rundlich geformt. Das liegt sicher daran, dass "
	     "Du eigentlich in einem Schneckenhaus bist.");

   AddDetail(({"schneckenhaus","haus"}),
	     "Du bist in dem Haus von Emma gelandet.");

   AddDetail("emma",
	     "Du siehst, wie Emma Dich von draussen anzwinkert.");

   AddDetail(({"kristallwald","wald"}),
	     "Den kannst Du nur durch das Fenster erkennen.");
   
   AddSpecialDetail("fenster","fenster");
   
   AddDetail("gegend",
	     "Mit der Zeit wird es aber fad, aus dem Fenster zu sehen, weil "
	     "Emma nicht die schnellste ist.");

   AddDetail("zeit",
	     "Die siehst Du draussen kaum verrinnen.");

   AddDetail(({"landschaftsbilder","bilder"}),
	     "Sie zeigen wunderschoene Fruehlings- Sommerlandschaftsbilder.");

   AddDetail(({"fruehlingsbilder","fruehlingslandschaftsbilder"}),
	     "Die Bilder zeigen den See von Rhondonit im Morgennebel.");

   AddDetail(({"rhondonit","see"}),
	     "Der See liegt ruhig im weisslichen Nebel.");

   AddDetail(({"morgennebel","nebel"}),
	     "Er liegt ueber dem majestaetisch schoenen See.");

   AddDetail(({"sommerbilder","sommerlandschaftsbilder"}),
	     "Das Bild zeigt eine Sommerlandschaft. Du erkennst die Gegend "
	     "aber nicht.");

   AddDetail("bett",
	     "Das Bett ist wohl fuer Dich gemacht, aber Du traust Dich nicht, "
	     "es zu benuetzen. Die Decke liegt herrlich aufgeschuettelt "
	     "zwischen vier stabilen Holzpfeilern.");

   AddDetail(({"bettdecke","daunendecke"}),
	     "Die Daunendecke ist extrem flauschig und weich. Darin liegen "
	     "waere ein Traum.");

   AddDetail(({"pfeiler","holzpfeiler"}),
	     "Auch die Holzpfeiler, wie die anderen Moebel auch, sind sehr "
	     "massiv und halten sicherlich eine Menge aus.");

   AddDetail("menge",
	     "Tja, das musst Du Dir schon selbst wissen...");
   
   AddSmell(DEFAULT_SMELL, 
	    "Du riechst vom Tisch her einen suesslichen Geruch.");

   AddSmell("geruch",
	    "Von den Bechern und den Tellern stroemt der Duft intensiv zu "
	    "Dir.");

   AddSmell("becher",
	    "Du riechst frischen Morgentau in den Bechern.");

   AddSmell("teller",
	    "Auf den Tellern ist kraeftig duftender Bluetenstaub.");

   AddSmell(({"staub","bluetenstaub"}),
	    "Der suessliche Duft laesst Dich im siebenden Himmel schweben.");

   AddDetail("himmel",
	     "Den kannst Du hier nicht einfach untersuchen.");

   AddSmell("himmel",
	    "Er riecht verfuehrerisch suesslich.");

   AddSmell("morgentau",
	    "Der Geruch des Morgentaues erfrischt Dich.");
   
   AddSound(DEFAULT_SOUND, 
	    "Du hoerst nur ein leises Rascheln.");

   AddSound("rascheln",
	    "Das wird wohl Emma sein, die sich langsam fortbewegt.");

   AddSound("emma",
	    "Du hoerst, wie sich Emma wacker vorankaempft.");
   
   SetProp(P_LIGHT, 1);
   SetProp(P_INDOORS, 0);

   SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_HOUSE,ENV_TEMPERATURE:21]));

   AddCmd(({"huepfe","huepf"}),"huepf");
   
   AddSpecialExit ("raus","raus");
}

nosave int huepf(string str)
{
  notify_fail(BS("Wo moechtest Du hinhuepfen?"));
  if(!str) return 0;
  
  if(str=="in bett"||str=="bett"||str=="ins bett")
    return write(BS("Du huepfst froehlich ins frisch gemachte "
		    "Bett und bringst damit alles durcheinander. Aber das ist "
		    "Dir egal. Hauptsache, du kuschelst Dich in die weiche "
		    "Daunendecke.")), 1;
  
  return 0;
}

int raus(string str)
{
  object ob;
  ob=find_living("die schnecke emma");
  
  if(objectp(ob))
    TP->move(ENV(ob), M_GO);
  else
    TP->move(ROOM "1_0514", M_GO);
  
  return 1;
}

string fenster()
{
  object ob;
  ob=find_living("die schnecke emma");
  
  if(objectp(ob))
    return  "Draussen siehst Du: \n"+ENV(ob)->QueryProp(P_INT_LONG);
  else
    return  BS("Die Gegend huscht draussen sehr langsam vorbei.");
}
