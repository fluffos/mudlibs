/*
**   Al Haskin-Doore
**   Kneipe im Elfendorf
**   
**   Kneipe der Elfen
*/

inherit "std/pub";

#include <moving.h>
#include <player.h>
#include <properties.h>
//#include "/d/kristallwald/sargola/def_kristall.h"
#include "../def.h"

create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
       SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]) );
       
  SetProp (P_INT_SHORT, "Al Haskin-Doore");
  SetProp (P_INT_LONG, BS(
  "Du stehst im Doore, einem Ort, an dem Elfen gern des abends "
  +"zusammen sitzen, sich am Feuer Geschichten erzaehlen und traurige, "
  +"aber auch liebliche Lieder singen. Ein grosser Tisch steht im Zentrum "
  +"des Talans, durch den der maechtige Stamm fuehrt. Ringsum stehen "
  +"Sessel fuer Einkehrer, die gerne ihren Koerper staerken und den Geist "
  +"erfreuen moechten. Am Stamm eine Tafel angebracht, die Du mit \"menue\" "+
  "lesen kannst. Nach Sueden kannst Du den Doore verlassen."));

  AddDetail( ({"braten","hirschbraten", "tiere", "beerensaft", "gluehwein"}), 
     BS("Am besten tippst Du einmal \"menue\"."));
  AddDetail("elessar", BS("In Elessar wohnen die Waldelfen."));
  AddDetail( ({"wesen","elfen","waldelfen"}), BS("Sie sind zurueckgezogene Wesen, die "
	+"ihre Doerfer recht versteckt in Baeumen haben."));
  AddDetail("doerfer", BS("Elessar ist das groesste von ihnen."));
  AddDetail(({"gefuehle","erinnerungen"}), BS("Von schoenen und schlechten Erinnerungen fassen die Elfen "
	+"in ihre Lieder."));
 AddDetail( ({"baeume","baum"}),
	BS("Du stehst gerade auf einem."));
  AddDetail ( "doore", BS(
    "Hier findet das gesellschaftliche Leben der Waldelfen statt. Gern "
    +"sitzen sie hier und tauschen Neuigkeiten aus."));
  AddDetail( ({"geschichten","neuigkeiten","leben"}), BS("Geschichten aus Elessar "
     +"und anderen Gegenden werden hier erzaehlt."));
  AddDetail("ort", BS("Hier fuehlst Du Dich sofort zu Hause."));
  AddDetail(({"feuerstelle","feuer"}), BS("Das Feuer lodert im hinteren Teil und dient zum Braten "
     +"von Wildschweinen und anderen Tieren."));
  AddDetail("teil", BS("Hinter dem zentralen Tisch befindet sich die Feuer"
  	+"stelle."));
  AddDetail(({"schweine","schwein","wildschweine"}), BS("Bestell Dir doch was!"));
  AddDetail("lieder", BS("Es ist alte Tradition bei den Elfen, Geschichten "
     +"oder Gefuehle in Lieder zu fassen und vorzutragen."));
  AddDetail("tradition", BS("Selbst in den Erinnerungen der aeltesten Elfen "
     +"wurden immer Lieder, froehliche aber auch traurige, gesungen."));
  AddDetail("tisch",BS("An dem Tisch sitzen einige Elfen und verzehren "
     +"einen saftigen Hirschbraten."));
  AddDetail("zentrum", BS("Im Zentrum fuehrt der weiss-blasse Stamm nach oben "
     +"und um ihn ist ein Tisch errichtet."));
  AddDetail("talan", BS("Der Talan ist der Holzboden, auf dem Du stehst."));
  AddDetail("stamm", BS("Er verjuengt sich immer mehr in Richtung Himmel."));
  AddDetail ("sessel", BS("Sie stehen um den Tisch verteilt."));
  AddDetail("einkehrer", BS("Besucher, die sich an regen Gespraechen beteiligen, "
     +"sind hier gern gesehen."));
  AddDetail("gespraeche", BS("Du solltest nicht so auffaellig andere Elfen belauschen!"));
  AddDetail( ({"koerper","geist"}), BS("Hier kannst Du Dir ein gutes Glas "
     +"Beerensaft oder einen Krug Gluehwein kommen lassen."));
  AddDetail( ({"krug","glas"}), BS("Dazu musst Du erst mal was bestellen."));
  AddDetail ( ({"wand","waende"}), BS(
    "Waende siehst Du hier keine, nur einen leichten, geflochtenen Schirm, "
    +"der gegen Wind schuetzt."));
  AddDetail("schirm", BS("Er dient wohl zum Schutz."));
  AddDetail("schutz", BS("Dem Schutz vor Wind."));
  AddDetail("wind", BS("Wind weht hier keiner."));
  AddDetail ( ({"holzboden", "boden"}), BS(
    "Der Boden besteht aus exakt verarbeiteten Holzbalken."));
  AddDetail ( ({"holzbalken","balken"}), BS(
    "Sie sind so genau verlegt, dass Du keinen Spalt nach unten siehst."));
  AddDetail("spalt", BS("Kein einziger ist hier zu sehen."));
  AddDetail ("decke", BS("Weiss und blaeulich leuchten die Blaetter ueber Dir."));
  AddDetail("blaetter", BS("Sie sind so dicht gewachsen, dass man den Himmel nicht "
	+"erkennen kann."));
  AddDetail("himmel", BS("Er ist hier drin nicht zu sehen."));
  AddDetail ( "tafel", BS(
    "Du kannst die Tafel am Stamm mit dem Befehl <menue> lesen."));
  AddSmell ( ({ DEFAULT_SMELL, "geruch" }), BS("Der Dunst von Bier und "
   +"anderen Getraenken vermischt sich mit dem scharfen Geruch von "
   +"gebratenem Fleisch."));
  AddSmell("bier", BS("Da wird man ja nur vom Riechen schon betrunken!"));
  AddSmell("getraenke", BS("Hier vermengen sich so viele verschiedene "
  	+"Gerueche, Du kannst unmoeglich sagen, was hier alles duftet."));
  AddSmell( ({"braten","hirschbraten","fleisch"}), BS("Hmm! Du meinst, Hirschbraten zu riechen."));
  
  AddSound (DEFAULT_SOUND, BS(
    "Die Kneipe wird von leisem Stimmengemurmel erfuellt."));
  AddSound ( ({ "stimmen", "stimmengemurmel", "gemurmel", "saetze" }),
    BS("Du kannst nur zusammenhanglose Saetze erkennen."));

  AddDrink("Rhondonitwasser", ({"rhondonitwasser", "wasser"}),
           1, ({1,0}), 0, 1,
           ({
             BS("Xelindo erscheint mit einem Glas Rhondonitwasser, das Du rasch "
             +"runterwuergst. Bah! Kauf doch den Gluehwein!"),
             "&& wuergt ein Glas Rhondonitwasser runter."}));

  AddDrink("Beerenextrakt", ({"extrakt", "beerenextrakt"}),
           35, ({17,1}), 0, 4,
           ({
             "Xelindo schiebt ein Glas Beerenextrakt ueber den Tisch, das "+
             "genau vor Dir\nstehen bleibt .... BOAH! Du bist beeindruckt.",
             "&& bekommt ein Glas Beerenextrakt."}));

  AddDrink("Traubensaft", ({"saft","traubensaft"}),      // Name, IDs,
           33, 8, 0, 3,                       // Preis, LP, Alk, Saettigung,
           ({"Xelindo bringt Dir ein Glas dunkelroten Traubensaft, das Du sofort "+
             "genuesslich\naustrinkst. Dabei kleckerst Du Dich natuerlich "+
             "an... wie ungeschickt!",
             "&& trinkt genuesslich ein Glas mit dunkelrotem Traubensaft.\n"+
             "Natuerlich kleckert &1 sich dabei an..."}));

  AddDrink("Weizensirup", ({"sirup", "weizensirup"}),
           56, ({12,30}), 0, 8,
           ({"Xelindo braucht etwas laenger - der Sirup wird frisch herge"+
             "stellt. Als Du ihn\nkostest, merkst Du, dass es doch nicht so ganz "+
		"Dein Geschmack ist. Aber gesund!",
		"&& schluerft mit verzogenem Gesicht einen Weizensirup."}));

  AddDrink("Gluehwein", ({"gluehwein","wein"}), 100, 20, 7, 3,
           ({"Xelindo bringt Dir ein Dein Glaeschen Gluehwein. "+
		"Bis auf die Tatsache, dass die Zimtstange noch drin schwimmt, ist er"+
		" eigentlich ok.",
             "&& geniesst ein Glaeschen Gluehwein."}));

 AddFood("Gemueseeintopf", ({"bruehe","gemuesebruehe","eintopf","gemueseeintopf"}),
	29,11,6,
	({"Du isst einen dampfenden Teller mit duenner Gemuesebruehe.",
	"Xelindo bringt && einen Teller mit duenner Gemuesebruehe."}) );
	
  AddFood ("Forelle blau", ({"forelle", "forelle blau"}),
           225, 22,7,
	({"Obwohl Du mit den Graeten raufst, ist die Forelle sehr saettigend.",
	  "&& wird trotz des Kampfes mit den Graeten von der Forelle satt."}) );
	
  AddFood("Hirschbraten",({"braten","hirschbraten"}),
  	288, ({27,49}),16,
  	({"Xelindo braet Dir ein schoen angebratenes Stueck Hirschfleisch.",
  	"&& bestellt einen saftigen Hirschbraten."}) );




  AddCmd (({"kauf","kaufe","bestell","bestelle"}),"bestelle");
  AddCmd (({"spendier","spendiere"}),"spendiere");
  AddCmd ("","able",1);

  AddItem (NPC+"xelindo.lpc", REFRESH_REMOVE);

  AddExit ("sueden", ROOM+"1_0614.lpc");
}

bestelle (str)
{
  object ob, *list;
  int i;

  notify_fail ("Xelindo kann Dich nicht bedienen - er ist nicht da!\n");
  if (ob = find_living("xelindo")) {
    notify_fail (BS("Xelindo kaempft gerade!! Der bringt Dir jetzt "
       +"sicher nichts!!"));
    if (ob->InFight()) return 0; else return ::bestelle(str);
  } else
    return 0;
}

spendiere (str)
{
  string *tmp;
  object pl;
  object ob;

  notify_fail ("Xelindo kann Dich nicht bedienen - er ist nicht da!\n");
  if (ob=present ("xelindo"))
  {
    tmp=explode(str," ");
    if (sizeof(tmp)<2) return ::spendiere(str);
    if ((pl=present(tmp[0])) && living (pl))
    {
      notify_fail (BS("Xelindo weigert sich, "+pl->name()+" etwas zu bringen, "+
        "da er gerade mit "+pl->QueryPronoun(WEM)+" kaempft.\n"));
      if (ob->InFight()) return 0;
    }
    return ::spendiere(str);
  }
  else
    return 0;
}

 drink_drink(mixed drink, object zahler, object empfaenger)
{
  int price, soak, strength;
  mixed res;

//*******************************
// Hier ist die Geburtstagsaktion :))
//*******************************/
  if(zahler->QueryProp(P_RACE) =="Elf" && present("xelindo",TO))
  {
	tell_object(zahler, BS("Xelindo sagt: Heut ist mein Geburtstag! Alle "
	"Elfen sollen heute bei mir billiger Saufen koennen!\n"));
	price = to_int(drink[2]*0.7);  
  }
  else price = drink[2];
  strength=drink[4];
  soak=drink[5];
  if (!zahler) zahler=this_player();
  if (!empfaenger) empfaenger=this_player();
  if ((zahler!=empfaenger) && pointerp(res=empfaenger->QueryProp(P_IGNORE))) {
    if (member(res,"spendiere")>=0 ||
        member(res,"spendiere.getraenke")>=0 ||
        ((member(res,"spendiere.alkohol")>=0) && (strength>0))) {
      tell_object(zahler, empfaenger->Name(WER)+" will das nicht.\n");
      return 1;
    }
  }
  if (zahler->QueryMoney()<price) {
    tell_object(zahler,"Das kostet "+price+
        " Muenzen, und Du hast nicht so viel!\n");
    return 1;
  }
  if (empfaenger!=zahler)
  {
    say(zahler->Name()+" spendiert "+empfaenger->name(WEM)+" einen Drink.\n",
        ({zahler, empfaenger}));
    tell_object(empfaenger,zahler->Name()+" spendiert Dir einen Drink.\n");
    tell_object(zahler,"Du spendierst "+empfaenger->name(WEM)+
        " einen Drink.\n");
  }

  if ((soak || strength) && !empfaenger->drink_drink(soak, strength))
    return 1;
  zahler->AddMoney(-price);
  sum+=price;
  return drink_it(drink, zahler, empfaenger);
}

