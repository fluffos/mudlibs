inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "dorf.h"

bewohnerin();


create()
{
  ::create();
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 1);
       SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]) );
       
  SetProp (P_INT_LONG, BS(
    "Du befindest in einfacher, schlichter Umgebung. Grobe, aber stabile "
    +"Holzmoebel und ein Bett fallen Dir auf. Links siehst Du einen Schrank "
    +"voller Buecher, der zum Bersten voll gestopft ist. Rechts siehst Du "
    +"ein seltsames Bild."));
  SetProp (P_INT_SHORT,"Bei Baaleth");

  AddDetail("elfen",
  	BS("Du bist hier in Elessar, dem Walddorf der Elfen. Du darfst "
  	+"Dich also nicht wundern, wenn Dir viele Elfen hier begegnen."));	

  AddDetail("boden",
  	BS("Der Boden ist ein stabiler Talan."));
  	
  AddDetail(({"holzplattform","talan"}),
  	BS("Die Holzplattform, auf der Du stehst, nennen die Elfen Talan."));
  
  AddDetail ( ({"dunkelheit","licht"}), BS("Du brauchst eine Weile, bis Du Dich an die "
  	+"Dunkelheit gewoehnt hast."));
  
  AddDetail( ({"tisch","tische","holztisch"}),
  	BS("Ein stabil wirkender Holztisch."));
  	
  AddDetail(({"buch","buecher"}),
  	BS("So viele Buecher hast Du nur in der Bibliothek gesehen!"));
  	
  AddDetail("decke",
  	BS("Eine Decke siehst Du hier nicht. Die Aeste formen den Raum."));
  
  AddDetail(({"eigentuemerin","bewohnerin"}),#'bewohnerin );
  
  AddDetail(({"dorf","walddorf","elessar"}),
  	BS("Elessar ist das Walddorf der Elfen."));
  	
  AddDetail("aeste",
  	BS("Sie sind sehr dicht und lassen kaum Licht in den Raum."));
  
  AddDetail(({"umgebung","raum"}),
  	BS("Was willst Du denn hier genau untersuchen?"));
  	
  AddDetail("himmel",
  	BS("Der Himmel ist nicht zu sehen."));
  	
  AddDetail( ({"wand","waende"}),
  	BS("Waende als solches gibt es hier nicht. Es sind vielmehr "
  	+"dichte Aeste, die den Raum hier bilden."));
  	
  AddDetail(({"moebel","holzmoebel"}),
  	BS("Einen Tisch, zwei Sessel und das Bett."));
  
  AddDetail("sessel",
  	BS("Auch nach genauester Untersuchung faellt Dir nichts "
  	+"Besonderes an dem Sessel auf."));
  	
  AddDetail("bett",
  	BS("Das Bett ist einfach und ohne Schnoerksel. Doch kann man "
  	+"darin sicherlich gut schlafen."));
  	
  AddDetail("schnoerksel",
  	BS("Das Bett hat keine unnoetigen, pompoesen Schnoerksel."));
  	
  AddDetail("schrank",
  	BS("Der Schrank ist komplett vollgeraeumt mit Buechern und Papieren. "
  	+"Da kriegt man nichts mehr hinein."));
  	
  AddDetail( ({"papiere","papier"}),
  	BS("Du traust Dich nicht, sie anzusehen. Es ist ja nicht Deine Wohnung."));
  	
  AddDetail("bersten",
  	BS("Hmm. Das Wort ist zwar grossgeschrieben, aber deswegen kannst Du hier "
  	+"das Bersten als Solches auch nicht sehen..."));
  	
  AddDetail("bild",
  	BS("Du kannst beim besten Willen nicht herausfinden, was Dir das Bild "
  	+"sagen will..."));

  AddSound(DEFAULT_SOUND, 
	"Du hoerst nichts Besonderes im Heim von Baaleth.");

  AddSound("heim",
	"Wie gesagt, Du hoerst nichts.");

  AddSound(({"geraeusche","baaleth"}),
	"Baaleth gibt keine Geraeusche von sich.");

  AddSmell(DEFAULT_SMELL,
	"Du kannst nur den Staub riechen, der auf den Buechern liegt.");

  AddSmell("buecher",
	"Auf ihnen liegt der Staub.");

  AddSmell("staub",
	"Du musst kraefig husten!");
  
  AddItem (NPC+"baaleth.lpc", REFRESH_DESTRUCT);
  
  AddExit ("westen", ROOM+"1_0717.lpc");
}


bewohnerin()
{
	if(present("baaleth",environment(TP)))
	{
		write("Sie steht hier in diesem Raum - sprich halt mir ihr "
		+"darueber.\n");
		return "";
	}
	else
	{
		write("Der ist offensichtlich gerade nicht hier.\n");
		return "";
	}
}
