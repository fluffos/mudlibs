inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "../def.h"
#include "dorf.h"

      create()
      {
        ::create();
     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]) );
     
     
        SetProp( P_INT_SHORT, "Elessar" );
        SetProp( P_INT_LONG, 
      BS(   "Du stehst auf einem kleinen Talan und geniesst die Aussicht. "
         +"Unter Dir schlaengelt sich der Waldweg durch die Baeume. "
         +"Es fuehren Bruecken nach Westen und Osten.\n") );
     
        SetProp( P_LIGHT, 1 );
        SetProp( P_INDOORS, 0 );
     
        
STANDARD1
STANDARD2
BODEN_WEG
   AddDetail( ({"sicht","aussicht"}),BS("Du hast eine phantastische Sicht auf das "
      +"Dorf der Waldelfen.\n"));

        AddExit( "osten", ROOM+"1_0914.lpc" );
        AddExit( "westen", ROOM+"1_0714.lpc" );

      }
 
init()
{	
	::init();
	if(!TP->QueryProp(P_RACE)=="Elf" && !TP->id("elfenwaechter") )
	{		
		if(TP->QueryAttributes(A_DEX)<15 && random(15)==1)
			call_out("runter",1);
		else
			if(random(25)==1)
				call_out("runter",1);	
	}

}
                                                                         
    runter()
    {
    tell_room(TO, BS(TPN+" versucht, sich auf den Talan zu retten, schafft "
    +"aber nicht ganz und plumpst nach unten."), ({TP}) );
                                                                          
    tell_object(TP, "Gerade, als Du glaubst, sicher ange"
    +"kommen zu sein, verlierst Du das Gleichgewicht..."
    +"und faellst durch die Zweige nach unten!\n");
    TP->move("/d/kristallwald/sargola/dorf/room/0614.lpc",M_GO,
             "nach unten", "faellt","faellt von oben herein");
    TP->restore_hit_points(-10);
    }
                                                                                                                                                                                                                 
