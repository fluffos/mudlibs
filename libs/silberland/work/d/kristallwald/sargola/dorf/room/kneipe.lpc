#include "../def.h"
#include <pub.h>
#include "/gilden/bardengilde/barden_extern.h"

#define DELAY_TIME 2
#define REFORMKOSTLADEN "/d/kristallwald/protheg/elessar/room/reformladen"

inherit "std/pub";
inherit "/gilden/bardengilde/obj/quest/reiselied_functions";

nosave int lastorder;
nosave object lastcustomer;

void create()
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
       
  SetProp(P_INT_SHORT, "Al Haskin-Doore");
  SetProp(P_INT_LONG, 
	  BS("Du stehst im Doore, einem Ort, an dem Elfen gern des abends "
	     "zusammen sitzen, sich am Feuer Geschichten erzaehlen und "
	     "traurige, aber auch liebliche Lieder singen. Ein grosser "
	     "Tisch steht im Zentrum des Talans, durch den der maechtige "
	     "Stamm fuehrt. Ringsum stehen Sessel fuer Einkehrer, die "
	     "gerne ihren Koerper staerken und den Geist erfreuen moechten. "
	     "Am Stamm ist eine Tafel angebracht, die Du mit \"menue\" "
	     "lesen kannst. Nach Sueden kannst Du den Doore verlassen."));

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER | PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "xelindo");
  SetProp(P_PUBKEEPER_NAME, "Xelindo");
  SetProp(P_PUBKEEPER_GENDER, MALE);
  SetProp(P_PUBMSG_NOKEEPER, "Xelindo kann Dich nicht bedienen - er ist nicht da!\n");
  
  AddDetail(({"braten","hirschbraten", "tiere", "beerensaft", "gluehwein"}), 
	    "Am besten tippst Du einmal \"menue\".");

  AddDetail("elessar", 
	    "In Elessar wohnen die Waldelfen.");

  AddDetail(({"wesen","elfen","waldelfen"}), 
	    "Sie sind zurueckgezogene Wesen, die "
	    "ihre Doerfer recht versteckt in Baeumen haben.");

  AddDetail("doerfer", 
	    "Elessar ist das groesste von ihnen.");

  AddDetail(({"gefuehle","erinnerungen"}), 
	    "Von schoenen und schlechten Erinnerungen fassen die Elfen "
	    "in ihre Lieder.");

  AddDetail(({"baeume","baum"}),
	    "Du stehst gerade auf einem.");

  AddDetail("doore", 
	    "Hier findet das gesellschaftliche Leben der Waldelfen statt. "
	    "Gern sitzen sie hier und tauschen Neuigkeiten aus.");

  AddDetail(({"geschichten","neuigkeiten","leben"}), 
	    "Geschichten aus Elessar "
	    "und anderen Gegenden werden hier erzaehlt.");

  AddDetail("ort", 
	    "Hier fuehlst Du Dich sofort zu Hause.");

  AddDetail(({"feuerstelle","feuer"}), 
	    "Das Feuer lodert im hinteren Teil und dient zum Braten "
	    "von Wildschweinen und anderen Tieren.");

  AddDetail("teil", 
	    "Hinter dem zentralen Tisch befindet sich die Feuer"
	    "stelle.");

  AddDetail(({"schweine","schwein","wildschweine"}), 
	    "Bestell Dir doch was!");

  AddDetail("lieder", 
	    "Es ist alte Tradition bei den Elfen, Geschichten "
	    "oder Gefuehle in Lieder zu fassen und vorzutragen.");

  AddDetail("tradition", 
	    "Selbst in den Erinnerungen der aeltesten Elfen "
	    "wurden immer Lieder, froehliche aber auch traurige, gesungen.");

  AddDetail("tisch",
	    "An dem Tisch sitzen einige Elfen und verzehren "
	    "einen saftigen Hirschbraten.");

  AddDetail("zentrum", 
	    "Im Zentrum fuehrt der weiss-blasse Stamm nach oben "
	    "und um ihn ist ein Tisch errichtet.");

  AddDetail("talan", 
	    "Der Talan ist der Holzboden, auf dem Du stehst.");

  AddDetail("stamm", 
	    "Er verjuengt sich immer mehr in Richtung Himmel.");

  AddDetail("sessel", 
	    "Sie stehen um den Tisch verteilt.");

  AddDetail("einkehrer", 
	    "Besucher, die sich an regen Gespraechen beteiligen, "
	    "sind hier gern gesehen.");

  AddDetail("gespraeche", 
	    "Du solltest nicht so auffaellig andere Elfen belauschen!");

  AddDetail(({"koerper","geist"}), 
	    "Hier kannst Du Dir ein gutes Glas "
	    "Beerensaft oder einen Krug Gluehwein kommen lassen.");

  AddDetail(({"krug","glas"}), 
	    "Dazu musst Du erst mal was bestellen.");

  AddDetail(({"wand","waende"}), 
	    "Waende siehst Du hier keine, nur einen leichten, "
	    "geflochtenen Schirm, der gegen Wind schuetzt.");

  AddDetail("schirm", 
	    "Er dient wohl zum Schutz.");

  AddDetail("schutz", 
	    "Dem Schutz vor Wind.");

  AddDetail("wind", 
	    "Wind weht hier keiner.");

  AddDetail(({"holzboden", "boden"}), 
	    "Der Boden besteht aus exakt verarbeiteten Holzbalken.");

  AddDetail(({"holzbalken","balken"}), 
	    "Sie sind so genau verlegt, dass Du keinen Spalt nach unten "
	    "siehst.");

  AddDetail("spalt", 
	    "Kein einziger ist hier zu sehen.");

  AddDetail("decke", 
	    "Weiss und blaeulich leuchten die Blaetter ueber Dir.");

  AddDetail("blaetter", 
	    "Sie sind so dicht gewachsen, dass man den Himmel nicht "
	    "erkennen kann.");

  AddDetail("himmel", 
	    "Er ist hier drin nicht zu sehen.");

  AddDetail("tafel", 
	    "Du kannst die Tafel am Stamm mit dem Befehl <menue> lesen.");

  AddSmell(({DEFAULT_SMELL, "geruch" }), 
	   "Der Dunst von Gluehwein und anderen Getraenken vermischt sich mit "
	   "dem scharfen Geruch von gebratenem Fleisch.");

  AddSmell(({"wein","gluehwein"}), 
	   "Da wird man ja nur vom Riechen schon betrunken!");

  AddSmell("getraenke", 
	   "Hier vermengen sich so viele verschiedene "
	   "Gerueche, Du kannst unmoeglich sagen, was hier alles duftet.");

  AddSmell(({"braten","hirschbraten","fleisch"}), 
	   "Hmm! Du meinst, Hirschbraten zu riechen.");
  
  AddSound(DEFAULT_SOUND, 
	   "Die Kneipe wird von leisem Stimmengemurmel erfuellt.");

  AddSound(({"stimmen", "stimmengemurmel", "gemurmel", "saetze"}),
	   "Du kannst nur zusammenhanglose Saetze erkennen.");
  
  AddDrink("Rhondonitwasser",({"rhondonitwasser", "wasser"}),
           10, ({3,3}), 0, 1, 
	   ({BS("Xelindo erscheint mit einem Glas Rhondonitwasser, das Du "
		"rasch runterwuergst. Bah! Kauf doch den Gluehwein!"),
	       "&& wuergt ein Glas Rhondonitwasser runter."}));

  AddDrink("Beerenextrakt", ({"extrakt", "beerenextrakt", "beerensaft"}),
           35, ({17,1}), 0, 4,
           ({BS("Xelindo schiebt ein Glas Beerenextrakt ueber den Tisch, das "
		"genau vor Dir stehen bleibt ... BOAH! Du bist beeindruckt."),
	       "&& bekommt ein Glas Beerenextrakt."}));

  AddDrink("Traubensaft", ({"saft","traubensaft"}),
           33, 8, 0, 3,
           ({BS("Xelindo bringt Dir ein Glas dunkelroten Traubensaft, das Du "
		"sofort genuesslich austrinkst. Dabei kleckerst Du Dich "
		"natuerlich an... wie ungeschickt!"),
	       "&& trinkt genuesslich ein Glas mit dunkelrotem Traubensaft.\n"
	       "Natuerlich kleckert &1 sich dabei an..."}));

  AddDrink("Weizensirup", ({"sirup", "weizensirup"}),
           56, ({12,30}), 0, 8,
           ({BS("Xelindo braucht etwas laenger - der Sirup wird frisch "
		"hergestellt. Als Du ihn kostest, merkst Du, dass es doch "
		"nicht so ganz Dein Geschmack ist. Aber gesund!"),
		"&& schluerft mit verzogenem Gesicht einen Weizensirup."}));

  AddDrink("Gluehwein", ({"gluehwein","wein"}), 100, 20, 7, 3,
           ({BS("Xelindo bringt Dir ein Dein Glaeschen Gluehwein. "
		"Bis auf die Tatsache, dass die Zimtstange noch drin "
		"schwimmt, ist er eigentlich ok."),
	       "&& geniesst ein Glaeschen Gluehwein."}));

  AddFood("Muesliriegel", ({"riegel","muesliriegel"}), 10, 5, 2,
	  ({"Genuesslich verzehrst Du einen von Xelindos beruehmten "
	      "Muesliriegeln.",
	      "&& verzehrt einen Muesliriegel."}));
  
  AddFood("Gemueseeintopf", ({"bruehe","gemuesebruehe","eintopf",
				"gemueseeintopf"}), 29,11,6,
	  ({"Du isst einen dampfenden Teller mit duenner Gemuesebruehe.",
	      "Xelindo bringt && einen Teller mit duenner Gemuesebruehe."}));

  AddFood("Vogerlsalat", ({"vogerlsalat","salat"}), 30, 15, 5,
	  ({"Du verspeist einen frischen, knackigen Vogerlsalat mit "
	      "Knoblauchdressing.",
	      "&& verspeist einen frischen Vogerlsalat mit "
	      "Knoblauchdressing."}));
  
  AddFood("Forelle blau", ({"forelle", "forelle blau"}),
	  225, 22,7,
	  ({"Obwohl Du mit den Graeten raufst, ist die Forelle sehr saettigend.",
	      "&& wird trotz des Kampfes mit den Graeten von der Forelle satt."}));
	
  AddFood("Hirschbraten",({"braten","hirschbraten"}),
	  288, ({27,49}),16, "hirsch_braten_essen");
  
  lastorder=0;
  
  AddExit("sueden", ROOM "1_0614");
  AddExit("hinten", REFORMKOSTLADEN);

  AddItem(NPC "xelindo", REFRESH_REMOVE);
}

public void hirsch_braten_essen() {
  object task;

  write(BS("Xelindo braet Dir ein schoen angebratenes Stueck Hirschfleisch."));
  say(BS(TPN+" bestellt einen saftigen Hirschbraten."));

  if(objectp(task=present(BARD_ID_GS10_TASK, TP))) {
    task->MarkFood(2);
  }
}

int keine_spieler(string dir)
{
  if(!IS_WIZARD(TP))
    return write(BS("Du vernimmst eine Stimme von hinten: 'Noch nicht!'")+
		 BS("Du haelst inne.")), 0;
  
  return 1;
}

void ban_msg(object pl)
{
  if(present(QueryProp(P_PUBKEEPER_ID)))
    {
      tell_object(pl, BS("Xelindo bedient keine Feinde!"));
      tell_room(ME, BS("Xelindo bedient "+pl->name(WEN)+" nicht!"), ({pl}));
    }
}

int search_what(string str, object zahl, object sauf)
{
  string pref;
  object k;

  if(lastorder > time())
    {
      if(!zahl) zahl=TP;

      if(k=present(QueryProp(P_PUBKEEPER_ID)))
	pref=k->Name()+" lallt: ";
      else
	pref=CAP(QueryProp(P_PUBKEEPER_NAME))+" lallt: ";
      
      if((objectp(lastcustomer)) && (lastcustomer==zahl))
	return tell_object(zahl, 
	  pref+"Aber "+zahl->Name(WER)+", Du haschd doch gerade wasch "
			   "beschdelld\n"+({
	  pref+"Hetsch mich doch nischt scho!\n",
	  pref+"Nur die Ruhe!\n",
	  pref+"Bischd Du in Eile?\n",
	  pref+"Vorschischt, schonscht verschluckscht Du nich noch!\n"
	    })[random(4)]), 1;
      /*
	else
	return tell_object(zahl, ({
	  pref+"Hetsch mich doch nischt scho!\n",
	  pref+"Nur die Ruhe!\n",
	  pref+"Bischd Du in Eile?\n",
	  pref+"Vorschischt, schonscht verschluckscht Du nich noch!\n"
	  })[random(4)]),1;
      */
  }
  
  return ::search_what(str, zahl, sauf);
}

int drink_it(mixed drink, object zahler, object empfaenger)
{
  if(QueryProp(P_PUB_FLAGS) & PUB_HASKEEPER)
    {
      lastorder=time()+random(DELAY_TIME);
      lastcustomer=empfaenger;
    }

  return ::drink_it(drink, zahler, empfaenger);
}

int eat_food(mixed food, object zahler, object empfaenger)
{
  if(QueryProp(P_PUB_FLAGS) & PUB_HASKEEPER)
    {
      lastorder=time()+random(DELAY_TIME);
      lastcustomer=empfaenger;
    }
  
  return ::eat_food(food, zahler, empfaenger);
}

public void init() {
	::init();
  
	if(interactive(this_player())) {
	  check_bard_awf_quest(this_player());
	}
  }
