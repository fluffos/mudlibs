inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "../def.h"
#include "dorf.h"

      create()
      {
        ::create();

     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]) );
     
     
        SetProp( P_INT_SHORT, "Elessar" );
        SetProp( P_INT_LONG, 
      BS("Du stehst auf einem mittleren Talan, unter Dir ist der "
         +"Waldweg. Im Sueden siehst Du eine Post, im Norden liegt "
         +"ein groesserer Talan, auf dem im Feuer duftende Gerichte "
         +"zubereitet werden.\n") );
     
        SetProp( P_LIGHT, 1 );
        SetProp( P_INDOORS, 0 );
 STANDARD1
 STANDARD2
 BODEN_WEG

   AddDetail("post", BS("Dass es eine Post sein muss, erkennst Du daran, dass "
	+"das gelbe Posthorn ueber dem Eingang der Post haengt."));
   AddDetail("eingang", BS("Er fuehrt ohne Umschweife geradewegs in die "
	+"Post!"));


   AddDetail("feuer", BS("Es flackert munter vor sich hin.\n"));
  AddSmell(DEFAULT_SMELL, BS("Du riechst die saubere Waldluft und den "
	+"Geruch, der von dem Feuer im Norden kommt."));
	
   AddSmell ( ({"gericht","gerichte"}),
   	BS("Hmm... Dir laeuft das Wasser im Mund zusammen."));
   AddSound("feuer",
   	BS("Es knister leise im Norden."));
   
   AddSmell("feuer",
   	BS("Du kannst den Geruch von Fleisch riechen."));
   AddSmell("fleisch",
   	BS("Geh doch einfach mal hin und schau Dich dort um."));
   			
   AddRoomMessage ( 
      ({    "Von Norden dringt Gemurmel an Dein Ohr.\n",
            "Du hoerst ein lautes \"PROST!\".\n",
            "Du siehst eine Gruppe Elfen nach Norden verschwinden.\n",
            "Du spaehst vorsichtig ueber den Rand des Talans.\n" }), 60 );


        AddExit( "norden", ROOM+"kneipe.lpc" );
        AddExit( "osten", ROOM+"1_0714.lpc" );
        AddExit( "sueden", ROOM+"post.lpc" );
        AddExit( "westen", ROOM+"1_0514.lpc" );
      }
      

init()
{	
	::init();
	if(!TP->QueryProp(P_RACE)=="Elf" && !TP->id("elfenwaechter") )
	{		
		if(TP->QueryAttributes(A_DEX)<15 && random(15)==1)
			call_out("runter",1);
		else
			if(random(25)==1)
				call_out("runter",1);	
	}

}
                                                                         
    runter()
    {
    tell_room(TO, BS(TPN+" versucht, sich auf den Talan zu retten, schafft "
    +"aber nicht ganz und plumpst nach unten."), ({TP}) );
                                                                          
    tell_object(TP, "Gerade, als Du glaubst, sicher ange"
    +"kommen zu sein, verlierst Du das Gleichgewicht..."
    +"und faellst durch die Zweige nach unten!\n");
    TP->move("/d/kristallwald/sargola/dorf/room/0614.lpc",M_GO,
             "nach unten", "faellt","faellt von oben herein");
    TP->restore_hit_points(-10);
    }
                                                                                                                                                                                                                 
 