#include "../def.h"
#include "dorf.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]));
  
  SetProp(P_INT_SHORT, "Elessar");
  SetProp(P_INT_LONG,
	  BS("Du stehst auf einer Verbindungsbruecke in einem ruhigeren Teil "
	     "des Dorfes. Ein kleiner Aussichtsposten befindet sich hier, "
	     "ansonsten ist es sehr ruhig. Eine Haengebruecke fuehrt nach "
	     "Nordosten und die andere nach Suedosten. Weiter im Sueden "
	     "siehst Du einen relativ jungen Talan. Hier wird das Dorf "
	     "offenbar noch vergroessert."));
  
  AddDetail(({"dorf"}),
	    "Ja was glaubst Du denn, wo Du bist?");
  
  AddDetail(({"posten","aussichtsposten"}),
	    "Dieser Platz hier dient als Aussichtsposten fuer die Waechter "
	    "von Elessar.");
  
  AddDetail(({"platz"}),
	    QueryProp(P_INT_LONG));
  
  AddDetail(({"waechter","waechterin"}),
	    "Die Waechter patroullieren hier hin und wieder.");
  
  AddDetail(({"bruecken","haengebruecken","bruecke","haengebruecke",
		"verbindungsbruecke"}),
	    "Du stehst auf einer Verbindungsbruecke, die den Nordosten mit "
	    "dem Suedosten verbindet.");
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  STANDARD1
  STANDARD2
  BODEN_WEG
    
  AddExit("nordosten", ROOM "1_0514");
  AddExit("suedosten", ROOM "1_0516");
}
