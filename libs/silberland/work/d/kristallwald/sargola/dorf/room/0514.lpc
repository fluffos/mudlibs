#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
 	
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:20]));    
  
  SetProp(P_INT_SHORT, "Im Kristallwald");
  SetProp(P_INT_LONG, 
	  BS("Um Dich breiten sich maechtige Baeume aus, die "
	     "den von Osten nach Westen fuehrenden Weg ueberdachen. Die "
	     "Aeste sind hier nicht sehr weit vom Boden entfernt. Dieser "
	     "Teil des Waldes ist atemberaubend schoen.""@@sicht@@"));

  AddDetail("dorf",
	    (["elf":"Du kannst es durch die Zweige gut erkennen.\n", 
	      0:"Sowas siehst Du hier doch gar nicht!\n"]));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddDetail("teil", 
	    "Es gibt ja auch noch andere Teile des Waldes...");     

  AddDetail(({"ast","aeste"}), 
	    "Du kannst fast nach ihnen greifen. "
	    "Du entdeckst eine Art Holzboden in den Aesten.");

  AddDetail(({"weg","boden"}), 
	    "Der Weg ist mit weissen Steinen gepflastert. "
	    "Links und rechts davon waechst etwas Wiese.");

  AddDetail(({"steine", "stein","pflastersteine"}), 
	    "Es scheinen Pflastersteine zu sein. Doch wo ist hier eine "
	    "Stadt.");

  AddDetail("stadt", 
	    "Die suchst Du schon verzweifelt!");

  AddDetail("himmel", 
	    "Den Himmel kannst Du nur mehr ueber dem Dach der Baeume "
	    "erahnen.");

  AddDetail("wiese", 
	    "In kleinen, struppigen Buescheln saeumt sie den Weg.");

  AddDetail(({"bueschel","buescheln"}), 
	    "Faustgrosse, fast halbrunde Bueschel.");

  AddDetail(({"kristallwald","wald"}), 
	    "Du stehst genau drin.");

  AddDetail(({"baum","baeume"}), 
	    "Maechtige, starke Staemme, die gerade in den Himmel ragen.");

  AddDetail(({"stamm","staemme"}), 
	    "Du verfolgst ihren Lauf und kannst ein eigenartiges Konstrukt "
	    "zwischen den Blaettern entdecken.");

  AddDetail(({"blatt","blaetter"}), 
	    "Weissliche, fast durchsichtigen Blaetter bilden ein Dach ueber "
	    "Dir.");

  AddDetail("dach", 
	    "Ein wunderschoenes Dach aus Blaettern durch welches "
	    "Sonnenstrahlen bis zum Boden dringen.");

  AddDetail(({"strahlen","sonnenstrahlen"}), 
	    "Sie dringen durch die dichten Aeste bis zu Dir hier unten "
	    "durch.");

  AddDetail("konstrukt",
	    "Es scheint eine Art Holzboden zu sein.");

  AddDetail(({"holzboden"}),
	    "Von hier aus kannst Du nicht besonders viel "
	    "sehen. Du solltest mal hochklettern.");
  
  AddSound(({DEFAULT_SOUND, "voegel"}), 
	   "Du hoerst Voegel in den Baeumen zwitschern.");
   
  AddSmell(DEFAULT_SMELL, 
	   "Riecht es hier nicht nach gegrilltem Fleisch?");

  AddSmell("fleisch", 
	   "Ja, Du riechst es deutlich. Wo das wohl herkommt?");

  AddCmd(({"klettere","kletter","klettre"}), "kletter");
  AddCmd(CMD_GREIFEN,"greife");

  AddExit("osten", ROOM "0614");
  AddExit("westen", ROOM "0414");

  AddItem(NPC "schnecke", REFRESH_DESTRUCT);
}

nosave int kletter(string str)
{
  string race;

  notify_fail(BS("Wohin willst Du klettern?"));
  if(!str) return 0;
      
  if(str=="nach oben"||str=="oben" ||str=="rauf"||str=="hoch"||
     str=="in das dorf"||str=="in elfendorf"||str=="elfendorf"||
     str=="dorf"||str=="in dorf"||str=="ins dorf")
    {
      race=TP->QueryProp(P_RACE);
      
      switch(race)
	{
	case "Mensch":
	  write(BS("Du blickst noch einmal nach oben und "
		   "beginnst dann ohne Furcht zu klettern."));
	break;

	case "Zwerg":
          if((random(100)<50) && (TP->QueryAttribute(A_DEX)<22))
            return write(BS("Nur mit groesster Ueberwindung beginnst Du "
                            "langsam den Baum zu ersteigen. Du murmelst "
                            "gerade einen Fluch ueber die Elfen, als Du "
                            "ploetzlich den Halt verlierst und wieder "
                            "hinabfaellst...")), 1;
          write(BS("Nur mit groesster Ueberwindung beginnst Du "               
                   "langsam und vorsichtig den Baum zu "
                   "ersteigen. Wenn Deine Ahnen das sehen "
                   "wuerden!"));

	  break;

	case "Hobbit":
	  write(BS("Frohen Mutes beginnst Du den riesigen Baum "
		   "zu erklettern. Obwohl es nicht leicht ist "
		   "fuer einen Hobbit, kommst Du gut voran"));

	  break;

	case "Elf":
	  write(BS("Froehlich steigst Du auf die ersten Aeste. "
		   "Hier fuehlst Du Dich zuhause."));
	  
	  break;

	default:
	  write(BS("Du beginnst ohne Furcht nach oben zu klettern."));
	  
	  break;
	}

      TP->move(ROOM "1_0514", M_GO, "klettert nach oben");
      
      return 1;
    }
  
  return 0;
}

nosave int greife(string str)
{
  string race;
  
  notify_fail("Wonach willst Du denn greifen?\n");
  if(!str) return 0;
  
  if(str=="nach ast" || str=="ast")
    {
      race = TP->QueryProp(P_RACE);
      
      switch(race)
        {
        case "Mensch":                                                         
          write(BS("Du blickst noch einmal nach oben und "
                   "beginnst dann ohne Furcht zu klettern.\n"));
          break;
        case "Zwerg":
          if((random(100)<50) && (TP->QueryAttribute(A_DEX)<22))
            return write(BS("Nur mit groesster Ueberwindung beginnst Du "
                            "langsam den Baum zu ersteigen. Du murmelst "
                            "gerade einen Fluch ueber die Elfen, als Du "
                            "ploetzlich den Halt verlierst und wieder "
                            "hinabfaellst...")), 1;
          write(BS("Nur mit groesster Ueberwindung beginnst Du "
                   "langsam und vorsichtig den Baum zu "
                   "ersteigen. Wenn Deine Ahnen das sehen "
                   "wuerden!\n"));
          break;     
        case "Hobbit":
          write(BS("Frohen Mutes beginnst Du den riesigen Baum "
                   "zu erklettern. Obwohl es nicht leicht ist "
                   "fuer einen Hobbit, kommst Du gut voran\n"));
          break;      
	  
	case "Elf":
          write(BS("Froehlich steigst Du auf die ersten Aeste. "
                   "Hier fuehlst Du Dich zuhause.\n"));
          break;

        default:
          write(BS("Du beginnst ohne Furcht nach oben zu klettern.\n"));
          break;
        }

      TP->move(ROOM "1_0514", M_GO, "klettert nach oben");
      
      return 1;
    }

  return 0;
}

string sicht()
{
  if(TP->QueryProp(P_RACE))
    return "\nDu kannst hier ins Elfendorf klettern.";                         
  
  return "";
}
