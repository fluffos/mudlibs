inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/kristallwald/sargola/def_kristall.h"

oeffne(string str);
wecke();


create()
{
	::create();
	SetProp(P_LIGHT, 1);
	SetProp(P_INDOORS,1);
     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]) );
     
	
	SetProp(P_INT_SHORT, "Ar-Thoas' Seherhaus");
	SetProp(P_INT_LONG,
		"In der Mitte des Raumes kannst Du eine Feuerstelle erkennen, "
		+"die als Lichtquelle dient, und im Winter dafuer zu sorgen hat, dass "
		+"es Arth schoen warm hat. Noerdlich erkennst Du einen Kamin, im "
		+"nordoestlichen Teil einen Kleiderschrank, an der Westwand "
		+"steht ein Bett, im suedosten befindet sich der Eszplatz, in "
		+"der Ostwand ein Fenster und in der suedoestlichen Ecke befindet "
		+"sich das Wichtigste, die Bar.");
	
AddDetail( ({"dankesschreiben","dankschreiben","schreiben"}),
	BS("Du kannst es lesen."));
	
AddReadDetail(({"schreiben","dankesschreiben","dankschreiben"}),
"Hail to thee Sargola, holy mage of Crystal-Forest!\n"
+"You've done more than only proven your might, by casting this house, as a\n"
+"man of honor and pride. I'm very grateful, that you spent your valuable\n"
+"time on building a home for me, so I'm no longer a homeless, a hiker, at\n"
+"home everywhere and anywhere. Special thanks for the workroom, it fits my\n"
+"need perfectly. As the midnight-sun rises, I'll gonna slay a lamb as an\n"
+"offering to raise your skills.\n"
+"Onwards to thy greater glories...\n"
+"It's an honor to me!\n"
+"             the seer, Ar-Thoas\n");


AddDetail("winter",
BS("Zur Zeit herrscht der Gott des Sommers."));

AddDetail("fenster",
BS("Eingentlich handelt es sich blosz um eine Oeffnung, "
+"die eine Luftzirkulation im Raum, und den Einfall "
+"von Tageslicht, ermoeglicht."));

AddDetail("raum",
BS("Da befindest Du Dich zur Zeit."));

AddDetail(({"zirkulation","luftzirkulation"}),
BS("Zwecks Frischluft."));

AddDetail("frischluft",
BS("Natuerlich ist die Luft hier frisch, wie koennte "
+"es denn auch anders sein, wenn das Fenster sowieso "
+"nicht geschlossen werden kann!"));

AddDetail(({"kleiderschrank", "schrank"}),
BS("Ein voellig harmloser Schrank, darin verstaut "
+"Arth sicher bloss sein unnuetzes Geruempel, oder "
+"etwa nicht?"));

AddDetail("geruempel",
BS("Vermutlich im Schrank, aber um das herauszufinden, "
+"braeuchtest Du schon einen Schluessel."));

AddDetail("schluessel",
BS("Den traegt Ar-Thoas bestimmt bei sich. Schade."));


AddDetail("bett",
BS("Das Bett ist in ordentlichem Zustand, es erweckt "
+"fast den Anschein, als wuerde darin gar ueberhaupt "
+"nichts Aufregendes stattfinden. Ausserdem erkennst "
+"Du ein eigenartiges Geraet am Nachtkaestchen."));


AddDetail("aufregendes",
	"Das wuerdest Du jetzt gerne wissen, ha?");
	
AddDetail("nachtkaestchen",
BS("Sieh Dir lieber das Geraet an, das sich darauf "
+"befindet."));

AddDetail("geraet",
BS("Es sieht wie ein Wecker aus - eigenartig, es "
+"gibt hier ja gar keinen Strom."));

AddDetail("wecker",
BS("Bei genauerer Betrachtung stellst Du fest, "
+"dass es sich um eine Art Sonnenuhr handelt; "
+"das Licht faellt durch das Fenster in der "
+"Ostwand."));

AddDetail("licht",
BS("Es scheint durch das Fenster in der Ostwand."));



AddDetail("sonnenuhr",
BS("Die Funktionsweise einer Sonnenuhr sollte Dir "
+"klar sein!"));

AddDetail("essplatz",
BS("Du siehst einen Tisch und vier Sessel. Auf dem "
+"Tisch haeuft sich das benutzte Geschirr seit vier "
+"Wochen. Unter dem Geschirr erkennst Du ein "
+"Dankschreiben, das Du unbedingt lesen solltest."));

AddDetail("tisch",
BS("Alles vorhanden, das einen Tisch ausmacht: "
+"eine Tischplatte und vier Tischfuesse - "
+"abgesehen davon, dass er ziemlich angeraeumt ist."));

AddDetail( ({"tischfuesse","fuesse","tischplatte", "platte"}),
BS("Perfekt verarbeitete Eiche."));

AddDetail("eiche",
BS("War frueher bestimmt mal ein Baum."));

AddDetail("sessel",
BS("Vier Fuesse, eine Sitzflaeche und eine "
+"Lehne. Im uebrigen sehen die Sessel nicht "
+"sehr bequem aus."));

AddDetail("geschirr",
BS("Ein paar Teller und viele Glaeser."));

AddDetail("teller",
BS("Du siehst tiefe und flache Teller ohne "
+"Muster, dafuer mit Essensresten."));

AddDetail( ({"essensreste","reste"}),
BS("Sie befinden sich auf den Tellern."));

AddDetail("glaeser",
BS("Bierglaeser, Wasserglaeser, Weinglaeser, "
+"Schnapsglaeser, Cognacglaeser, Whiskyglaeser, "
+"udergl."));

AddDetail("udergl",
BS("...und der gleichen."));

AddDetail("bierglaeser",
BS("Glaeser fuer Bier?"));

AddDetail("wasserglaeser",
BS("Glaeser fuer Wasser?"));

AddDetail("weinglaeser",
BS("Glaeser fuer Wein?"));

AddDetail("schnapsglaeser",
BS("Glaeser fuer Schnaps?"));

AddDetail("cognacglaeser",
BS("Glaeser fuer Cognac?"));

AddDetail("whiskyglaeser",
BS("Glaeser fuer Whisky?"));

AddDetail(({"bier", "wein", "schnaps", "cognac", "whisky"}),
BS("Du findest bestimmt an der Bar, was du suchst!"));

AddDetail("wasser",
BS("Das findest Du garantiert nicht an der Bar!!!"));

AddDetail("kamin",
BS("Dieser Kamin bringt Dich zum Gruebeln, "
+"schliesslich befindet sich mitten im Raum eine "
+"Feuerstelle. Ob da wohl mehr DAHINTER steckt?"));

AddDetail("dahinter",
BS("Dir bleibt aber auch nichts verborgen, ob Du nun "
+"auch den Mechanismus findest?"));

AddDetail("mechanismus",
BS("Auf dem Kamin kannst Du ein kleine Statue "
+"erkennen - sehr verdaechtig."));

AddDetail("statue",
BS("Vielleicht ist sie ja der Schluessel..."));

/* kippe Statue -> A) Zwerge: Schade! Leider ist ein Zwerg
zu klein, um die Statue zu
erreichen, aber vielleicht
versuchst Du es morgen ja
nochmal - irgendwann
musz die Wachstumsphase
schlieszlich auch bei Euch
eintreten, ihr Elfenquaeler!
B) elseDie Rueckwand des Kamins
wird durch ein mechanisches
Wunderwerk der Technik hoch
gezogen, und gibt einen
Durchgang frei.


gehe durch Durchgang -> Du befindest Dich ein einem kleinen
Raum, der Dir nicht einmal die Moeglichkeit bietet, Deine Arme
auszustrecken. -> Die Rueckwand schlieszt sich. -> Ein Brummen
erfuellt den Raum. Du fuehlst, wie Dein Koerper sich in seine
atomaren Bestandteile aufloest. -> Dir gefaellt das Gefuehl der
Geborgenheit und Waerme, das Dir dieser Zustand vermittelt. Du
bist nun Teil des ewigen Kontinuums. -> Die Twilight Zone.
Sichtbare Ausgaenge: keine.
Ploetzlich erscheint Ar-Thoas. -> Er blaettert ganz aufgeregt in
einem seiner arkanen Buecher, und zeichnet dabei eigenartige,
geometrische Figuren in der Luft. -> Daraufhin beginnt sich Dein
Materiestrom zu verdichten, Du nimmst wieder Deine
urspruengliche Form an. ->  Raumbeschreibung fuer Raum 2.

*/

AddDetail("Bar",
BS("Vor der Theke befinden sich zahlreiche Hocker, "
+"dahinter findest Du all die Koestlichkeiten, "
+"die in einer Bar ueblicherweise zu finden sind."));

AddDetail("Theke",
BS("Eine Theke eben, zwar nichts Besonderes, aber "
+"praktisch."));

AddDetail("Hocker",
BS("Von diesen Hockern ist schon so mancher "
+"Gast in seiner Trunkenheit gefallen."));

AddDetail("Trunkenheit",
BS("Aber, aber, da stehst du doch drueber, oder?"));

AddDetail("Gast",
BS("Falls Arth sich dazu durchringen kann eine "
+"housewarmingparty zu veranstalten bist Du "
+"sicher auch geladen."));

AddDetail("Koestlichkeiten",
BS("Njam, njam - SaurerApfel, WilliamsBirne, "
+"4Rosen und ein Berg Zigarrettenschachteln. "
+"Leider stehen die Flaschen in Kaesten, die "
+"verschlossen sind."));

AddDetail(({"Kiste", "Hirter"}),
BS("20 Buddeln koestliches Hirter. Obey your thirst!"));

AddDetail("Kaesten",
BS("Genau, da ist der Alk drin, und blosz Arth hat "
+"den Schlue."));

AddDetail("Flaschen",
BS("Leider sind alle in Kaesten, aber sind wirklich "
+"alle dort?"));

AddDetail(({"Berg", "Zigarrettenschachteln", "Zigarretten",
"Schachteln"}),
BS("Ich glaube nicht, dasz Ar-Thoas es auffaellt, "
+"wenn Du Dir ein nimmst, und falls doch: er gibt gern!"));

AddDetail(({"SaurerApfel", "WilliamsBirne", "4Rosen"}),
BS("Noe!, Noe!, das gibts NUR an Fasttagen."));


AddDetail(({"Fasttag", "Fasttage", "Fasttagen"}),
BS("Damit rechtfertigt Arth immer seinen "
+"Gute-Nacht-Trunk: ui, ist schon wieder Fast "
+"ein tag vorueber."));

AddDetail("Feuerstelle",
BS("Steine sind kreisfoermig aufgelegt, damit "
+"sich das darin lodernde Feuer nicht auf den "
+"Rest des Raumes ausbreiten kann."));

AddDetail(({"Stein", "Steine"}),
BS("Perfekt bearbeitete Steine, die stammen bestimmt "
+"von der Gefaengnisinsel, wo kleine ? -aehm, wie "
+"heiszen die Dinger doch schnell, ach ja genau- "
+"Zwerge; also wo kleine Zwerge unter Beaufsichtigung "
+"Felsbrocken in regelmaeszige Bloecke verarbeiten. "
+"Selbstverstaendlich unter Aufsicht der Elfen, "
+"schlieszlich sind die Kleinen noch nicht in der Lage "
+"sich auf der groszen, weiten Welt allein zu recht zu "
+"finden."));

AddDetail("Feuer",
BS("Im Winter sicher angenehm warm, ansonsten recht "
+"praktisch zum Kochen."));

AddDetail(({"Zwerge", "Zwerg"}),
BS("Klein, schmutzig, weil sie unter der Erde leben, "
+"haeszlich, laestig, wie Gelsen, und vor allem "
+"viel zu viel auf der Welt, naja, sie vermehren "
+"sich halt eben wie Unkraut, beziehungsweise "
+"ist die hohe Geburtenrate ein Zeichen fuer ihre "
+"primitivitaet bezueglich ihrer Entwicklung, in "
+"der dritten Welt vermehren sie sich schlieszlich "
+"auch dermaszen stark..."));

AddSmell("???",
BS("Mmh, duftet das aber gut, der Geruch kommt Dir "
+"irgendwie bekannt vor."));

AddSmell("Geruch",
BS("Scheint aus dem Suedosten zu kommen."));

AddSmell("Suedosten",
BS("Im Suedosten befindet sich die Bar!"));

AddSmell("Bar",
BS("Genaugenommen duerfte sich die Quelle des "
+"Duftes unter der Theke befinden."));

AddSmell(({"Quelle", "Theke"}),
BS("Vielleicht solltest Du mal unter der Theke "
+"suchen."));

//suche unter Theke -> Du findest eine Kiste Hirter.
//(Detailbeschreibung zu Kiste Hirter oben im Text)

//moeglichkeit bieten, bier zu trinken

AddSound("???",
BS("Entweder bist Du taub, oder aber hier "
+"erklingt nicht mal das leiseste Toenchen. "
+"Ist aber auch kein Wunder, schlieszlich "
+"gibts hier ja auch kein Radio, und an das "
+"Vogelgezwitscher hast Du Dich bereits gewoehnt, "
+"das faellt Dir garnicht mehr auf!"));

AddDetail("Waende",
BS("An den Waenden haengen unzaehlige Schwerter, "
+"ein Schwert fasziniert Dich besonders."));

AddDetail("Schwert",
BS("Ein maechtiger Bihaender, wie Du seines "
+"gleichen noch niemals zuvor gesehen hast. "
+"Die Klinge ist vielfach gefaltet, und der "
+"Griff besongers praechtig verziert. "
+"Das ist das Schwert, mit dem Ar-Thoas kaempfen "
+"wird, wenn das Ragnaroek uber die Welt "
+"hereinbricht. Es ist so alt wie die Welt selbst, "
+"es wurde vom Demiurgen im goettlichen Feuer "
+"geschmiedet, und ist daher voller Magie, "
+"auszerdem gehorcht es blosz Arth, denn ihm "
+"wurde es geweiht, von Anbeginn an, so lautete die "
+"Prophezeihung, so steht es geschrieben, und so "
+"ist es geschehen. Denn Ar-Thoas ist nicht blosz "
+"der Sohn des Lichtes, sondern auch Guenstling der "
+"Goetter, und blutsverwandt mit Odin."));

AddDetail("Ragnaroek",
BS("Wenn es an der Zeit ist, so wird Ar-Thoas eine "
+"Gruppe von vier Kriegern anfuehren: "
+"a rider from the north, holding a sword of steel, "
+"another from the south, bearing a battle ax, a "
+"third, from the east, holding a spiked club, and "
+"finally, from the west, a rider who wields a "
+"great hammer of war. Maybe now you'll ask yourself "
+"who are those four men? -Who are they? -They are "
+"the METAL KINGS!!!. On their hands they have the "
+"blood of the kings and they pray the warriors "
+"prayer and all the time, they are fighting the world. "
+"The clash of honor calls, louder than hell, and they "
+"seek vengeance, not only for the unavenged, but "
+"for the lost souls, like the defender, they ride "
+"hard, on the top of the will of the people. Kingdom "
+"come! Hail to them without end, and the voices of "
+"victory, will carry long and far throughout the "
+"land."));

AddDetail("Klinge",
BS("Die Klinge ist 1m20 lang, und das erste drittel "
+"besteht aus einem Schwertbrecher, also zackenfoermige "
+"Gebilde, die es im Kampf ermoeglichen, bei einer "
+"Parade die gegnerische Klinge zu brechen, und einer "
+"hervorragend ausgebildeten Blutrinne, der nach diesem "
+"Lebenssaft nur so duerstet."));


AddDetail("Griff",
BS("Der Griff ist mit Schlangen verziert, die sich "
+"um ihn schlaengeln, und bis zur Klinge reichen. "
+"Als Verbindung zwischen Klinge und Griff fungieren "
+"zwei gehoernte Gargoylkoepfe, also Koenigsgargoyls, "
+"die wohl maechtigsten Feinde der Elfen und Menschen."));



AddCmd("oeffne","oeffne");
AddCmd("kippe","kippe");

}

kippe(string str)
{
	notify_fail("Was willst Du denn kippen?\n");
	if(!str) return 0;
	
	
}

oeffne(string str)
{
	notify_fail("Was willst Du denn oeffnen?\n");
	if(!str) return 0; 
	if(str=="schrank"||str=="wandschrank")
	{
		tell_object(TP,"Der Schrank gehoert ArThoas. Du hast leider "
		+"keinen Schluessel fuer den Schrank.\n");
		return 1;
	}
}

init()
{
	call_out("wecker",10);
	::init();
}

wecker()
{
	write(
		"Ploetzlich geht der Wecker auf dem Nachtkaestchen los!");
	write("\n");
	write("
		+"Ein nobel aussehender Elf trommelt mit kleinen Staebchen "
		+"auf den hohlen Kopf eines Zwergen. Der Klang weckt ArThoas "
		+"jeden Morgen.");
	return 1;
}
