inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "../def.h"

int ist_tier_da;

      create()
      {
        ::create();

   ist_tier_da = 1;

     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]) );
          
        SetProp( P_INT_SHORT, "Ein Waldweg" );
        SetProp( P_INT_LONG, 
      BS("Du gehst einen gut ausgebauten Weg Richtung Suedwesten entlang. Vor Dir "
      +"beginnen sich maechtige Baeume auszubreiten und den Pfad zu ueberdachen.") );
     
        SetProp( P_LIGHT, 1 );
        SetProp( P_INDOORS, 0 );
     

   AddDetail( ({"pfad","weg","waldweg"}), BS("Ein breiter Weg, der schon oft benuetzt "
	+"wurde."));
        AddDetail( "boden", BS("Der Weg ist mit Steinen gesaeumt und deshalb schoen zu sehen. "
      +"Der Boden besteht aus niedergetretenen Erde. Links und rechts waechst "
      +"wieder Wiese."));
   AddDetail ("erde", BS("Sie ist trocken und hart."));
       AddDetail( "himmel", BS("Den Himmel kannst Du nur mehr ueber dem Dach der Baeume "
      +"erahnen.")   );
   AddDetail("dach", BS("Das Dach der Baeume liegt weit ueber Dir und verdeckt den Himmel."));
   AddDetail ("wiese", BS("In kleinen, struppigen Buescheln saeumt sie den Weg."));
   AddDetail ( ({"bueschel","buescheln"}), BS("Faustgrosse, fast halbrunde Bueschel."));

   AddDetail( ({"kristallwald","wald"}), BS("Du stehst genau drin.")   );
   AddDetail ( ({"baum","baeume"}), BS("Maechtige, starke Staemme, die kerzengerade in den "
      +"Himmel ragen."));       
   AddDetail ( ({"stamm","staemme"}), BS("Du verfolgst soweit Du kannst ihren Lauf."));
   AddDetail("lauf", BS("Selten hast Du so gerade gewachsene Baeume gesehen."));
   
      
   AddSound (DEFAULT_SOUND, "Alles ist still hier.\n");
   
   AddSmell(DEFAULT_SMELL, "Du kannst nichts Auffaelliges riechen.\n");


   AddItem("/d/kristallwald/sargola/wald/npc/gkroete.lpc", REFRESH_DESTRUCT);

        AddExit( "suedwesten", ROOM+"1014.lpc" );

        AddExit( "nordosten", ROOM+"1212.lpc" );

      }
 

