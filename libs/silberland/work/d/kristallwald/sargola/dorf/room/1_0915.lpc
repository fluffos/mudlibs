#include "../def.h"
#include "dorf.h"

inherit "std/room";

#define SPENDER "/d/kristallwald/protheg/elessar/obj/spender"

void create()
{
  ::create();

  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]));
  
  SetProp(P_INT_SHORT, "Elessar");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich auf einem kleinen Talan. Im Norden ist "
	     "ein grosser, von Waechtern bewachter Talan, waehrend im "
	     "Westen ein einfacher Talan ist, in dem es seltsam "
	     "ruhig ist."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  STANDARD1
  STANDARD2
  BODEN_OHNE_WEG     
   
  AddItem(SPENDER, REFRESH_REMOVE);

  AddExit("norden", ROOM "1_0914");
  AddExit("westen", ROOM "kapelle");
}

