inherit "std/room";

#include <properties.h>
#include <language.h>

#include "../def.h"
#include "dorf.h"

      create()
      {
        ::create();

     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]) );
     
     
        SetProp( P_INT_SHORT, "Elessar" );
        SetProp( P_INT_LONG, 
      BS(   "Du befindest Dich auf einem kleinen Talan. Im Norden scheint ein grosser "
      +"und gut geschuetzter Talan zu sein, waehrend im Osten ein einfacher Talan "
      +"ist. \n") );
     
        SetProp( P_LIGHT, 1 );
        SetProp( P_INDOORS, 0 );
     

	STANDARD1
	STANDARD2
	BODEN_OHNE_WEG
   

        AddExit( "norden", ROOM+"biblio.lpc" );
        AddExit( "osten", ROOM+"mschule.lpc" );
        AddExit( "sueden", ROOM+"1_0714.lpc" );

      }
 
