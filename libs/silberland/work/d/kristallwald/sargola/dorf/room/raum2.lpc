//wichtigeres im Kopf (maybe mudden?)."))


AddDetail("Tintenfasz",
BS("Sieht wie ein herkoemmliches Tintenfasz "
+"aus, allerdings verwundert Dich die intensiv "
+"rote Faerbung, die mitnichten harmlos wirkt."));
// Es ist leer.

AddDetail("Feder",
BS("Ob diese Feder wohl einst dem Vogel-Rok "
+"gehoerte? Eines steht fest, jetzt sicher "
+"nicht mehr, sie wurde zu einem Schreibwerkzeug "
+"umfunktioniert."));

AddDetail("Pergament",
BS("Hier liegt blosz unbeschriebenes Pergament "
+"aufgestapelt. Ar-Thoas wuerde sich ueber "
+"eine Nachricht, in der Du Wuensche, Beschwerden "
+"und Anregungen mitteilen kannst, sicher freuen."));

AddDetail("Faerbung",
BS("Ein sehr dunkles Rot, nach genauerem "
+"Hinsehen erkennst Du, dasz es getrocknetes "
+"Blut ist - auf einen Schlag wird Dir auch "
+"klar, warum Arth immer so blasz ist."));

AddDetail("Blut",
BS("Mit spende Blut kannst Du das Fasz "
+"fuellen."));

