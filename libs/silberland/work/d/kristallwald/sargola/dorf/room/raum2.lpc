
RAUM 2

RAUMBESCHREIBUNG FUER RAUM 2

Du hast Ar-Thoas' Geheimkammer entdeckt, den Raum der
Beschwoerung. Allerdings ist es kein Raum, wie man ihn 
sich eigentlich vorstellt, er hat keine Waende und keine 
Decke; zu Deinem Glueck hat er eine Art Fuszboden.
Buecherregale befinden sich je eines im westen und einer im
osten und ein Schreibtisch im norden. Besonders auffaellig ist
der Drudenfusz im Fuszboden.
Ausgang: keine.

// Ausgang erfolgt durch Syntax:  betritt Drudenfusz.

AddDetail("Kerzen",
BS("Du siehst 5 Kerzen, je eine an den Ecken "
+"des Drudenfuszes. Seltsam, Du stellst fest, "
+"sie nicht abbrennen, offensichtlich dienen sie "
+"nicht blosz dazu, den Raum zu beleuchten."));

AddDetail(({"Regale", "Buecherregale",  "Regal"}),
BS("In ihnen stehen hunderte Buecher, die schon "
+"sehr alt aussehen."));

AddDetail("Schreibtisch",
BS("Der Schreibtisch ist fast leer, dadurch auch "
+"sehr ordentlich. Auf ihm befindet sich blosz "
+"ein Notizzettel, ein Tintenfasz, eine Feder "
+"und Pergament."));

AddDetail("Drudenfusz",
BS("Auch bekannt als Femstern, Pentagramm, "
+"das wohl bekannteste Symbol in der Magie. "
+"Du bist erleichtert, als Du erkennst, dass "
+"er nicht auf dem Kopf steht, daher als "
+"Schutzsymbol fungiert, und nicht zur "
+"Beschwoerung von Daemonen udergl. dient. "
+"- oder ist das blosz eine Frage des Standpunktes? "
+"Ueber dem Zentrum des Sterns kannst Du kleine "
+"Rechtecke erkennen. An jeder Ecke kannst Du "
+"Kerzen erkennen, ausserdem stellst Du fest, "
+"dasz sich die Seiten in einem besonderen "
+"mathematischen Verhaeltnis schneiden. "
+"-ach, wenn Du blosz wuesztest in welchem!"));

AddDetail(({"Boden", "Fuszboden"}),
BS("Schwarzer Marmor, sehr exklusiv - aber "
+"hauptsaechlichst pflegeleicht. Roter Marmor "
+"in Form eines Drudenfusses ist in den "
+"Boden eingearbeitet."));

AddDetail("Rechtecke",
BS("Als Du naeher heran trittst stellst Du "
+"fest, dasz es sich um Runensteine handelt."));


AddDetail("Runensteine",
BS("Es sind 24 Runen deren Namen Du "
+"bestimmt kennst, oder?"));

AddDetail("Namen",
BS("Korrekt! Du erkennst: "
+"FEHU, URUZ, THURISAZ, ANSUZ, RAIDO, KAUNAZ, "
+"GEBO, WUNJO, HAGALAZ, NAUTHIZ, ISA, JERA, "
+"EIHWAZ, PERTHO, ALGIZ, SOWULU, TEIWAZ, "
+"BERKANA, EHWAZ, MANNAZ, LAGUZ, INGUZ, OTHILA "
+"und DAGAZ."));

AddDetail("Runen",
BS("Archaeologische Forschung definiert den "
+"Zeitraum ihrer Verwendung von 200 v.Chr. "
+"bis zum Mittelalter, in einer geographischen "
+"Ausbreitung, die das Gebiet von Island bis "
+"Rumaenien und vom Balkan bis zum Mittelmeer "
+"umfaszte. -Drei erscheinen Dir von wesentlicher "
+"Bedeutung zu sein!"));

AddDetail("Bedeutung",
BS("RAIDO: reise "
+"  ALGIZ: Schutz - Unter dem Schutz "
+"  SOWULU:Sonne "));

AddDetail("Buecher",
BS("Hier findest Du die cream de la cream der "
+"occulten Literatur; ua. Das Necronomicon "
+"und RunarRadhRedhRadh, verfaszt von den "
+"beruehmtesten Kapazitaeten auf diesem Gebiet, "
+"Meister ihres Faches wie Eliphas Levi, um "
+"blosz einen zu nennen."));

AddDetail("Necronomicon",
BS("Wohl eines der aeltesten Buecher ueberhaupt, "
+"es beschreibt detailliert die Beschwoerung "
+"und Beherrschung von Daemonen, Toten udergl."));

AddDetail("RunarRadhRedhRadh",
BS("Es behandelt die Magie der Runen und ihre "
+"Nutzung zum Zwecke der Divinatorik."));

AddDetail("Divinatorik",
BS("Weiszt Du zu ritzen? Weiszt Du zu raten?"
+"Weiszt Du zu faerben? Weiszt Du zu forschen?"
+"Weiszt Du zu bitten? Weiszt Du zu weihen?"
+"Weiszt Du zu schicken? Weiszt Du zu toeten?"
+"Besser ungebetet, als uebermaessig geopfert. "
+"Die Gabe will stets Vergeltung. Besser "
+"ungesendet, als zuviel getoetet; So ritzt es "
+"Thund zur Richtschnur den Voelkern: Da erhob "
+"er sich wohin er heimgekehrt war."));





AddDetail("Notizzettel",
BS("Ein bereits vergilbter Zettel den Du "
+"bestimmt lesen kannst."));

