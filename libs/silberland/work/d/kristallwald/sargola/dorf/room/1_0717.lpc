#include "../def.h"
#include "dorf.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]));
  
  SetProp(P_INT_SHORT, "Elessar");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich auf einem kleinen Talan. Neben Dir ragen "
	     "dichte Kapseln aus Aesten in den Himmel. Im Osten siehst Du "
	     "einen freundlichen, privaten Talan. Die Sonne scheint durch "
	     "die Decke aus Aesten und strahlt sanft auf die Aeste. Im "
	     "Norden siehst eine Reihe weiterer Talane. "));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  STANDARD1
  STANDARD2
  BODEN_OHNE_WEG
    
  AddExit("norden", ROOM "1_0716");
  AddExit("osten", ROOM "hbaaleth");
}
