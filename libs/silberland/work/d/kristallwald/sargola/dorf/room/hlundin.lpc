inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "dorf.h"

bewohnerin();


create()
{
  ::create();
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_LONG, "Im Inneren wirkt der Talan genauso wie von "
    "aussen sehr einfach. Du kannst kaum etwas erkennen, es ist einfach "
    "zu dunkel hier. Doch in der Mitte des Raumes kannst Du eine Art "
    "Sessel erkennen. Drumherum liegen viele Polster am Boden herum. "
    "In dem Sessel wird die Bewohnerin wohl viel Zeit zubringen. Sonst "
    "gibt es nur eine einfache Feuerstelle.");
  SetProp (P_INT_SHORT,"In Lundins Talan");

  AddDetail("feuerstelle","Sie ist unscheinbar und sauber. Hier werden "
    "wohl nur kleine Speisen zubereitet und der Talan erwaermt.");
  AddDetail("speisen","Du kannst in der Naehe der Feuerstelle keine "
    "entdecken.");
  AddDetail("mitte","Dort steht der Sessel.");

  AddDetail("boden",
  	BS("Der Boden ist ein stabiler Talan."));
  AddDetail(({"holzplattform","talan"}),
  	BS("Die Holzplattform, auf der Du stehst, nennen die Elfen Talan."));
  AddDetail ( ({"dunkelheit","licht"}), BS("Du brauchst eine Weile, bis Du Dich an die "
  	+"Dunkelheit gewoehnt hast."));
  AddDetail( ({"tisch","tische","holztisch"}),
  	BS("Ein stabil wirkender Holztisch."));
  AddDetail("decke",
  	BS("Eine Decke siehst Du hier nicht. Die Aeste formen den Raum."));
  AddDetail(({"eigentuemerin","bewohnerin"}),#'bewohnerin );
  AddDetail(({"dorf","walddorf","elessar"}),
  	BS("Elessar ist das Walddorf der Elfen."));
  AddDetail("aeste",
  	BS("Sie sind sehr dicht und lassen kaum Licht in den Raum."));
  AddDetail(({"umgebung","raum"}),
  	BS("Was willst Du denn hier genau untersuchen?"));
  AddDetail("himmel",
  	BS("Der Himmel ist nicht zu sehen."));
  AddDetail( ({"wand","waende"}),
  	BS("Waende als solches gibt es hier nicht. Es sind vielmehr "
  	+"dichte Aeste, die den Raum hier bilden."));
  	
  AddDetail(({"moebel","holzmoebel"}),
  	BS("Kaum Moebel, nur der Sessel ist da."));
  
  AddDetail("sessel",
  	BS("Auch nach genauester Untersuchung faellt Dir nichts "
  	+"Besonderes an dem Sessel auf."));
  AddDetail(({"stuhl","schaukelstuhl","sessel"}),
    "Es ist so ein alter Schaukelstuhl, wie Du ihn "
    "von Deiner Grossmutter sicher kennst. Lundin verbringt viel Zeit "
    "in dem Sessel und erzaehlt hier ihre Geschichten den jungen "
    "Elfen.");  	
  AddDetail("grossmutter","Nunja, in diesem Fall ist das Lundin.");
  AddDetail("zeit","Ist die nicht relativ?");
  AddDetail(({"maerchen","geschichten","geschichte"}),
    "Frag Lundin doch einfach danach.");
  AddDetail("polster","Viele Polster liegen am Boden wirr verstreut." 
    "Hier lassen sich wohl oft junge Elfen nieder, um Lundins Geschichten "
    "zu lauschen. Sie hat sicher viele Maerchen zu erzaehlen.");
    

  AddSound(DEFAULT_SOUND, 
	"Du hoerst nichts Besonderes.");

  AddSound(({"geraeusche","lundin"}),
	"Lundin macht gerade eine Pause beim Erzaehlen.");

  AddItem (NPC+"lundin.lpc", REFRESH_DESTRUCT);
  AddItem (NPC+"jelf.lpc",REFRESH_DESTRUCT); 
  AddExit ("westen", ROOM+"1_0717.lpc");
}


bewohnerin()
{
	if(present("lundin",environment(TP)))
	{
		write("Sie steht hier in diesem Raum - sprich halt mit ihr.\n");
		return "";
	}
	else
	{
		write("Die ist offensichtlich gerade nicht hier.\n");
		return "";
	}
}
