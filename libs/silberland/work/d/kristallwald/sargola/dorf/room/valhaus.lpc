inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <room.h>
#include "../def.h"



create()
{
	::create();
	
	SetProp(P_INT_SHORT, "Das Seherhaus von Valeria");
	SetProp(P_INT_LONG, BS("Du stehst im Seherhaus von Valeria, "
			+"das sie mit Morano bewohnt. Du bist erstaunt. "
			+"Ein solches Haus hast Du noch nie gesehen. "
			+"Boden, Waende - einfach alles hier, scheint "
			+"von so gewachsen zu sein. So sehr Du dich auch "
			+"umsiehst, Du findest nichts, dass man als "
			+"gezimmert bezeichnen koennte. 'So muss eine richtige"
			+"Waldelfe wohnen!' kommt es Dir in den Sinn.\n"
			+"Dies scheint der Wohnbereich zu sein. Du siehst "
			+"einen Tisch, zwei seltsame Gehaenge, eine Feuerstelle "
			+"und ein Regal. Licht faellt durch eine Oeffnung, "
			+"die wohl das Fenster darstellt."));

	SetProp(P_LIGHT, 1 );
	SetProp(P_INDOORS, 1 );

		AddDetail("waende","Jeweils zwei Waende sind aus Aesten, "
			+"Zweigen und anderen Pflanzen geformt, die anderen "
			+"beiden sind Baumstaemme.");

		AddDetail("wand","Welche Wand meinst Du? Es gibt vier davon.");

		AddDetail("vier","Na, eine noerdliche, ein suedliche, eine "
			+"westliche und eine oestliche Wand.");

		AddDetail("noerdliche wand","Die noerdliche Wand ist eine der "
			+"beiden aus Pflanzen gebildeten Waende. Sie beinhaltet "
			+"den Eingang. Zwei Fotos haengen hier und die Feuerstelle "
			+"ist im Eck.");

		AddDetail(({"eck","ecke"}),"Die noerdliche und westliche Wand "
			+"bilden die Ecke, wo die Feuerstelle ist.");

		AddDetail("suedliche Wand","Auch diese Wand wird aus Pflanzen "
			+"geformt. Hier ist die Oeffnung, die man mit etwas Fantasy "
			+"fuer ein Fenster halten koennte. Ausserdem haengen da noch "
			+"ein Regal und ein Bild.");

		AddDetail(({"oestliche wand","buchenstamm"}),"Ein massiver Stamm "
			+"einer wohl maechtigen Buche. Eine Ausbuchtung faellt Dir auf.");

		AddDetail(({"westliche Wand","eichenstamm"}),"Ein Stamm einer "
			+"maechtigen Eiche. "
			+"Dieser Stamm hat ein Loch, das ins Innere des Baumes zu "
			+"fuehren scheint. In der Ecke ist die Feuerstelle.");

		AddDetail("ausbuchtung","Als Du genauer hinsiehst, stellst Du fest, "
			+"dass es sich um einen Pilz handelt, der am Stamm des Baumes "
			+"waechst.");

		AddDetail("pilz","Der Pilz ist trichterfoermig, mit dem Stamm "
			+"verwachsen. In seinem Trichter steht eine Fluessigkeit.");

		AddDetail("trichter",BS("Der Pilz bildet mit dem Stamm einen "
			+"Trichter."));

		AddDetail("fluessigkeit","Es ist eindeutig Wasser.");

		AddDetail("wasser","Merkwuerdig. Der Pilz scheint das Wasser im "
			+"Trichter zu speichern. Das erinnert Dich an etwas.");

		AddDetail("etwas","Genau. Du hast schon von solchen Pilzen "
			+"gehoert, die dem Baum, auf dem sie leben, Wasser entziehen "
			+"und es in ihren Trichter absondern. Sie sind sehr selten. "
			+"'Ein kleiner Brunnen.' denkst Du begeistert.");

		AddDetail("fotos","Die Fotos zeigen Morano und Valeria bei ihrer "
			+"Hochzeit zusammen mit ihren Gaesten.");

		AddDetail("gaeste","Du erkennst Persoenlichkeiten wie Zordan und "
			+"Verdandi. Natuerlich auch den Trauzeugen Godan.");

		AddDetail("bild","Genaugenommen ist es kein Bild. Vielmehr die "
			+"Verewigung eines Gegenstandes.");

		AddDetail("gegenstand","Es handelt sich dabei um eine rote Rose, "
			+"die liebevoll gepresst und hinter Glass eingerahmt worden "
			+"ist.");

		AddDetail("rose","Eine Notiz darunter besagt, dass Morano diese "
			+"Rose Valeria an ihrem Hochzeitstag schenkte.");

		AddDetail("fenster","Es ist wohl eher ein Oeffnung, die mit Ranken "
			+"umrahmt ist. Komischerweise ist kein luftzug zu spueren.");

		AddDetail("oeffnung","Sie soll wohl das Fenster darstellen.");

		AddDetail("luftzug","Du spuerst keinen. Ob das Fenster doch "
			+"irgendwie verschlossen ist? Du koenntest versuchen durch "
			+"das Fenster hinaus zu greifen.");

		AddDetail("barriere","Solch Barriere sin fas immer magisch. Sei "
			+"bloss vorsichtig!");

		AddDetail("feuerstelle","Die Feuerstelle befindet sich im Eck. "
			+"Sie aehnelt einem kleinen Kamin, der aber voellig aus "
			+"Pflanzen geformt ist, wie der Rest des Hauses auch. Auch "
			+"ein Abzug ist vorhanden."); 

		AddDetail("kamin","Im Kamin flackert ein Feuer. Seltsamerweise verbrennt "
			+"es den Kamin nicht, der doch nur aus Pflanzen gebildet wird.");

		AddDetail("feuer","Das Feuer ist warm und scheint auch gut zum Kochen "
			+"von Speisen geeignet zu sein, und doch.... Wenn Du ganz mutig bist "
			+"koenntest Du ja versuchen ins Feuer zu greifen.");
 
		AddDetail("regal","Das Regal scheint aus der Wand gewachsen zu sein "
			+"und genau wie diese, ist es aus Pflanzen geformt. Auf ihm "
			+"befinden sich einige Buecher.");

		AddDetail("buecher","Valeria scheint ein Fan von Fantasy und Science-"
			+"Fiction Geschichten zu sein. Es befinden sich ausschliesslich "
			+"solche Titel im Regal.");

		AddDetail("titel","Du kannst sie lesen.");

		AddDetail(({"stamm","baumstamm"}),"Meinst Du den Eichen-, oder den "
			+"Buchenstamm?");

		AddDetail("pflanzen","Aeste, Zweige von Baeumen, Flechten, Moose, "
			+"Efeu....\n Pflanzen die im Wald wachsen eben.");

		AddDetail(({"aeste","zweige","flechten","moose"}),"Du siehst sie "
			+"ueberall hier. Das Haus ist daraus geformt.");

		AddDetail("efeu","Seine Ranken sind ueberall zu finden.");

		AddDetail("ranken","Die Ranken des Efeu.");

		AddDetail("loch","Ein Loch im Baumstamm. Du kannst in eine kleine "
			+"Hoehle sehen.");

		AddDetail(({"schlafraum","hoehle"}),"Dies ist der Schlafraum. "
			+"Er ist mit Decken und Poelstern ausgelegt.");

		AddDetail(({"decken","poelster"}),"Die Decken und Poelster sehen "
			+"sehr weich und kuschlig aus. Es muss herrlich sein, darauf "
			+" zu schlafen.");

		AddDetail("eingang","Ein Vorhang aus Kletterpflanzen tarnt den "
			+"Eingang. Durch ihn kannst Du das Haus wieder verlassen.");

		AddDetail("vorhang","Der Eingang ist durch einen Vorhang aus "
			+"Kletterpflanzen getarnt.");

		AddDetail("kletterpflanzen","Efeu, Windling, ...");

		AddDetail("windling","Der Windling kann schoene Blueten tragen.");

		AddDetail("boden","Der Boden ist mit einem Teppich aus Moosen und "
			+"Flechten ueberzogen.");

		AddDetail("teppich","Er besteht aus Moosen und Flechten und "
			+"fuehlt sich ganz weich an.");

		AddDetail("tisch","Der Tisch ist mit dem Boden fest verwachsen. "
			+"Er ist wohl aus diesem herausgewachsen. Auf ihm steht eine "
			+"Vase.");

		AddDetail("vase","In der Vase stehen frische Blumen.");

		AddDetail("blumen","Es sind normale Wald- und Wiesenblumen.");
		
		AddDetail("gehaenge","Eine Art Korbsessel, wuerdest Du sagen. "
			+"Sie sind an Ranken mit der Decke verbunden und haengen so "
			+"relativ frei im Raum.");

		AddDetail("korbsessel","Es sind zwei. Einer fuer eine, der andere "
			+"fuer zwei Personen. Sie sind an Ranken mit der Decke verbunden "
			+"und um den Tisch angeordnet.");
		
		AddDetail("decke","Die Decke ist aus Aesten und Flechten gebildet. "
			+"Deshalb ist sie auch nicht wirklich eben.");

		AddReadDetail("titel","Der kleine Hobbit, Der Herr der Ringe, ZBV, "
			+"Perry Rhodan, Der Marskrieger, Der ewige Held, Die Macht der Ringe, "
			+"Der Bronzedrache, ...");
	


		AddSound(DEFAULT_SOUND,"Es ist angenehm ruhig hier. Nur ab und "
			+"zu hoerst Du den Gesang eines Vogels.");

		AddSound(({"lerche","gesang","lied","vogel"}),"Du lauscht dem wunderschoenen "
			+"Lied eine Lerche.");





		AddSmell(DEFAULT_SMELL,"Du riechst die reine Luft das Waldes.");

		AddSmell("luft","Die Luft riecht frisch und klar.");

		AddSmell("wald","Der Duft von Tannen, Harz und frischer Erde "
			+"steigt dir in die Nase");

		AddSmell("blumen","Hmm.... die duften herrlich!!");



		AddCmd(({"setz","setze","sitze","sitz"}),"setze"); 
/* Man soll sich auf/in einen der beiden Korbsessel setzen koennen. */

		AddCmd(({"kletter","klettere"}),"kletter");
/* Man soll durch das Loch in die Schlafhoehle klettern koennen. */

		AddCmd(({"schaukel","schaukle"}),"schaukel"); 
/* Man soll - im Korbsessel sitzend - ein wenig vor und rueckwaerts schaukeln koennen. */

		AddCmd(({"trink","trinke"}),"trinke");
/* Man soll etwas Wasser aus dem Trichter des Pilzes trinken koennen. */

		AddCmd(({"steh auf","stehe auf"}),"steh auf"); 
/* Man soll vom sessel aufstehen koennen. */

		AddCmd(({"greif in","greife in"}),"greif in");		
/* Man soll ins Feuer greifen keonnen. */


		AddExit("raus",ROOM+""); 

}

/* Folgende Aussagen, wenn die Aktion (Taetigkeit) gelingt:
setze:
("Als Du Dich in den Korbsessel setzt, schwingt dieser ein bisschen. Ob man damit schaukeln kann?")

kletter:
("Du kletterst durch das Loch im Stamm in die Schlafhoehle.")

schaukel:
("Uuuuuuiiiiiii...... Du schaukelst froehlich vor und zurueck.")

trinke:
("Du beugst Dich ueber den Pilz und trinkst etwas Wasser. Wirklich erfrischend!")

steh auf:
("Du erhebst Dich wieder aus dem Korbsessel.")

greif in:
("Du greifst wagemutig ins Feuer ... und bist voellig ueberrascht! Das Feuer ist kalt!")

*/
