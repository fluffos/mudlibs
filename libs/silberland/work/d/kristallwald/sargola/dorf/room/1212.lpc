#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
  
  SetProp(P_INT_SHORT, "Ein Waldweg");
  SetProp(P_INT_LONG, 
	  BS("Du stehst auf einem breiten Waldweg, der von Straeuchern "
	     "gesaeumt wird und der, trotz des dichten Waldes, schoen "
	     "begehbar ist. Es geht leicht bergab."));
     
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail(({"weg","waldweg"}), 
	    "Ein breiter Weg, der schon oft benuetzt wurde.");
  
  AddDetail("boden", 
	    "Der Boden besteht aus niedergetretener Erde.");
  
  AddDetail("erde", 
	    "Sie ist trocken und hart.");
  
  AddDetail("himmel", 
	    "Den Himmel kannst Du nur mehr ueber dem Dach der Baeume "
	    "erahnen.");
  
  AddDetail(({"baum","baeume"}),
	    "Sie saeumen den Weg zu beiden Seiten.");
  
  AddDetail(({"strauch","straeucher"}), 
	    "Mannshohe Straeucher fassen den Weg rechts und links ein. "
	    "Sie sind fast undurchdringlich dicht. Die Zweige mal "
	    "dichter, mal weniger dicht.");
  
  AddDetail("zweige", 
	    "An einer Stelle sind die Zweige besonders durchlaessig.");
  
  AddDetail("stelle", 
	    "Hier sind die Zweige nicht so dicht wie sonst. "
	    "Ob man sich da wohl durchzwaengen kann?");
  
  AddDetail(({"kristallwald","wald"}), 
	    "Du stehst genau drin.");
  
  AddSound(DEFAULT_SOUND, "Du kannst nichts besonderes hoeren.");
  
  AddSmell(DEFAULT_SMELL, "Die Umgebung hier ist leider geruchslos.");
  
  AddCmd(({"zwaenge", "zwaeng", "schluepf", "schluepfe"}), "zwaenge");
  
  AddExit("suedwesten", ROOM "1113");
  AddExit("nordosten", DORF_SEE);
}

nosave int zwaenge(string str)
{
  notify_fail(BS("Wo willst Du denn durch?"));
  if(!str) return 0;
   
  if(str=="durch strauch"||str=="strauch"||str=="durch straeucher"||
     str=="straeucher"||str=="durch zweige")
    {
      if(!TP->do_exhaust(100)) 
	return 1;

      TP->move(ROOM "1313", M_GO, "direkt in den Strauch");
      return 1;
    }

  return 0;
} 
