#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));

  SetProp(P_INT_SHORT, "Eine Lichtung" );
  SetProp(P_INT_LONG,
	   BS("Du stehst mitten in einem Lager von Wegelagerern. In der "
	      "Mitte siehst Du eine kleine Feuerstelle und eine kleine "
	      "Huette im Sueden."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddDetail("lager", 
	    "Hier muss wohl ihr geheimes Versteck sein.");

  AddDetail("versteck", 
	    "Durch die umgebenden, dichten Straeucher kann man wirklich "
	    "nicht weit sehen.");

  AddDetail(({"strauch","straeucher",}), 
	    "Sie umgeben hier alles...");

  AddDetail("mitte", 
	    "Boah! Sie befindet sich exakt im Zentrum der Lichtung.");

  AddDetail(({"feuer","stelle","feuerstelle"}),
	    "Holzstuecke gluehen sanft und verbreiten einen angenehmen "
	    "Geruch.");

  AddDetail("geruch", 
	    "Den kann man nur riechen!");

  AddDetail(({"stuecke","holzstuecke"}),
	    "Viel ist von ihnen nicht mehr uebrig.");   

  AddDetail("huette",
	    "Eine niedrige, ungeschickt gezimmerte Huette befindet sich im "
	    "Sueden.");

  AddDetail("boden",
	    "Der Boden besteht aus niedergetretenen Erde und "
	    "niedergetretenen Zweigen.");

  AddDetail("zweige",
	    "Sie sind schon trocken und rascheln beim Gehen.");

  AddDetail("erde", 
	    "Sie ist trocken und hart.");

  AddDetail("himmel", 
	    "Der Himmel ist klar ueber Dir zu sehen.");
  
  AddDetail(({"kristallwald","wald"}), 
	    "Du stehst genau drin.");

  AddSound(DEFAULT_SOUND, 
	   "Leises Knistern des Feuers ist zu hoeren.");

  AddSound(({"feuer","knistern"}), 
	   "Das Feuer prasselt leise vor sich hin.");

  AddSmell(DEFAULT_SMELL, 
	   "Der Geruch von verbranntem Holz ist unverkennbar.");

  AddSmell("feuer", 
	   "Der Geruch von verbranntem Holz ist unverkennbar.");
  
  AddCmd(({"betritt","betrete"}), "betrete");
  
  AddExit("norden", ROOM "1314");
  
  AddItem(NPC "wlag",  REFRESH_DESTRUCT);
  AddItem(NPC "fwlag", REFRESH_DESTRUCT);
  AddItem(NPC "jwlag", REFRESH_DESTRUCT);
}

nosave int betrete(string str)
{
  object ob;
  int da;
  da=0;

  notify_fail(BS("Was moechtest Du denn betreten?"));
  if(!str) return 0;
  
  if(str=="huette"||str=="die huette")
    {
      if(ob=present("wlag")) 
	{ ob->Kill(TP); da=1; }

      if(ob=present("jwlag")) 
	{ ob->Kill(TP); da=1; }

      if(ob=present("fwlag")) 
	{ ob->Kill(TP); da=1; }
      
      
      if(!da) 
	TP->move(ROOM "huette", M_GO, "in das Haus");
      else
	write(BS("Die Wegelagerer werden das niemals zulassen!"));

      return 1;
    }
  
  return 0;
} 
