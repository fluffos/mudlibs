inherit "std/room";



#include <properties.h>

#include <language.h>

#include <moving.h>



#include "/d/kristallwald/sargola/def_kristall.h"





      create()

      {

        ::create();


     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]) );
     
     

        SetProp( P_INT_SHORT, "Im Kristallwald" );

        SetProp( P_INT_LONG, 

      BS("Die starken Staemme am Wegesrand werden zusehends lichter. "

         +"Im Westen scheint der Wald zu enden und eine Wiese breitet "

         +"sich aus. Es ist schon deutlich heller hier.\n") );

     

        SetProp( P_LIGHT, 1 );

        SetProp( P_INDOORS, 0 );

     

        AddDetail( ({"stamm","staemme"}), BS("Sie sind hier nicht mehr so "

           +"stark wie die Staemme weiter im Osten.\n"));

        AddDetail( ({"weg","rand", "wegesrand"}), BS("Der Weg ist mit weissen Steinen gepflastert. "           +"Links und rechts waechst Wiese. Im Westen endet er.\n"));

   AddDetail("boden", BS("Der Boden ist von einem gut gepflegten Weg "

      +"dominiert.\n"));

   AddDetail( ({"krone","baumkrone","baumkronen","kronen"}), BS("Du "

      +"siehst weit ueber Dir durch viele Aeste verdeckt die Kronen "

      +"der Staemme links und rechts von Dir.\n"));

   AddDetail ( ({"ast","aeste"}), BS("Nicht sonderlich starke Aeste praegen "

      +"das Bild.\n"));

   AddDetail ( ({"pflastersteine","steine", "stein"}), BS("Es scheinen Pflastersteine "

      +"zu sein.\n"));

   AddDetail( "himmel", BS("Er scheint deutlich zwischen den lichten "

      +"Baumkronen durch.\n")   );

   AddDetail ("wiese", BS("In kleinen, struppigen Buescheln saeumt sie "

      +"den Weg. Im Westen siehst Du nur mehr Wiese.\n"));

   AddDetail ( ({"bueschel","buescheln"}), BS("Faustgrosse, fast "

      +"halbrunde Bueschel.\n"));



       AddDetail( ({"kristallwald","wald"}), BS("Du stehst doch im Kristallwald!\n")   );

   AddDetail ( ({"baum","baeume"}), BS("Maechtige, starke Staemme, die gerade in den "

      +"Himmel ragen.\n"));       

      

   AddSound (({DEFAULT_SOUND, "voegel", "kehlchen", "rotkehlchen"}), "Ein "

      +"laut zwitscherndes Rotkehlchen dringt an Dein Ohr.\n");

   

   AddSmell(DEFAULT_SMELL, "Wenn Du es genau nimmst, riechst Du nichts "

      +"Besonderes.\n");

   

        AddExit( "osten", ROOM_DORF+"0514.lpc" );



        AddExit( "westen", ROOM_DORF+"0314.lpc" );



      }

