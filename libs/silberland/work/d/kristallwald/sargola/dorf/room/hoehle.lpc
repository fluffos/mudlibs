inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"


create()
      {
        ::create();
	
        SetProp( P_INT_SHORT, "In einer Grotte");
        
        SetProp(P_INT_LONG, BS("Du befindest Dich in einer kleinen Grotte hinter "
        	+"dem Wasserfall, der von der Klippe nach unten fliesst. Das "
        	+"hereinfallende Licht bricht sich an den feinen Wassertroepfchen, "
        	+"die durch die Luft schweben in alle Farben des Regenbogens. "
        	+"Der Boden ist aus sandiger Erde, sonst gibt es hier keinerlei "
        	+"Annehmlichkeiten. Ein Weg fuehrt weiter nach hinten in die "
        	+"Grotte."));
        	
        AddDetail("weg", BS("Er fuehrt weiter in die Grotte. Du traust Dich aber "
        	+"nicht weiter."));
        	
        AddDetail(({"tag","regenbogen"}),BS("Hier kann man den Regenbogen den ganzen Tag "
        	+"lang sehen."));
        
        AddDetail("annehmlichkeiten", BS("Naja, sowas wie Sessel oder ein Bett zB."));
        
        AddDetail( ({"sessel","bett"}), BS("Sowas siehst Du hier eben nicht."));
        
        AddDetail("boden",BS("Der Boden ist aus sandiger Erde und wird nach hinten "
        	+"immer trockener."));
        	
        AddDetail("farben", BS("Du kannst alle Spektralfarben schoen erkennen."));
        
        AddDetail("spektralfarben", BS("Sie reichen von Violett ueber Indigo, blau, "
        	+"Gruen, Gelb, Orange bis Rot."));
        	
        AddDetail( ({"violett","indigo","blau","gruen","gelb","orange","rot"}),
        	BS("An den feinen Wassertropfen bricht sich das Sonnenlicht beeindruckend "
        	+"in seine Spektralfarben."));
        
        AddDetail("klippe", BS("Du kannst sie schemenhaft hinter dem Wasserfall erkennen."));
        
        AddDetail("wasserfall", BS("Er stuerzt von noch hoeheren Felsen vor dem "
        	+"Eingang der Grotte vorbei in die Tiefe."));
        	
        AddDetail("eingang", BS("Dort, wo der Wasserfall vorbeibraust."));
        
        AddDetail("erde", BS("Sie ist von der Feuchtigkeit weich und feucht."));
        
        AddDetail("feuchtigkeit", BS("Es wundert Dich aber nicht ernsthaft, dass hier "
        	+"alles feucht ist, oder?"));
        
        AddDetail("felsen", BS("Die Waende und die Decke bestehen aus Felsen."));
        
        AddDetail( ({"waende","wand","decke"}), BS("Die Waende und die Decke bestehen "
        	+"aus Felsen."));
        
        AddDetail(({"sonnenlicht","licht"}), BS("Es ist kein einheitlicher Lichtstrahl, er bricht sich "
        	+"vielmehr an feinen Wassertroepfchen und erleuchtet die Grotte hier mit mystischer "
        	+"Schoenheit."));
        	
        AddDetail("schoenheit", BS("Sowas ist schwierig zu beschreiben."));
        
        AddDetail("tiefe", BS("Wie tief es ist, kannst Du von hier aus nicht erkennen."));
        	
        AddDetail( ({"wassertropfen","wassertroepfchen"}),
        	BS("Sie sind ziemlich feind aber gegen das Sonnenlicht aber gut zu sehen."));
        AddDetail("lichtstrahl", BS("Er ist wie schon gesagt eher diffus."));
        
        AddDetail("waser", BS("Es rauscht am Eingang der Grotte vorbei."));
        
        AddDetail("grotte",BS(TO->QueryProp(P_INT_LONG)));
        
        SetProp( P_LIGHT, 1 );
        SetProp( P_INDOORS, 1 );
        SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE,ENV_TEMPERATURE:15]) );

	AddExit("raus",ROOM+"wasserfall");


}


init()
	{
	object ob,ob1,umhang;
	object * anwesende;
	object * armours;
	object hs;	
	int angst,i;

        ::init();

	if(find_call_out("holen")==-1)
		call_out("holen",60);


	hs = find_living("hoehlenschuechtling");
	//hs = present("hoehlenschuechtling",TO);	

	if(!TP) return ;
	angst = 0;	


	//Abchecken, ob jemand zum Fuerchten da ist ...
	anwesende = filter_array(all_inventory(), #'query_once_interactive);
	
	for(i = sizeof(anwesende)-1;i>=0;i--)
	{  
	     ob = present("algenumhang",anwesende[i]);  
	     //printf("%O\n",ob);
	     if(!objectp(ob)) angst = 1;
	     if(objectp(ob) && ob->QueryProp(P_WORN) != anwesende[i])
	     	angst = 1;
	}

	
	//Wenn kein Schuechtling
	if(!hs)
	{
		hs = clone_object(NPC+"hoehlens");
		hs->move(ROOM+"dummy", M_GO);
		return ;
	}
	
	
	//wenn er keine angst haette und nicht da ist ;)
	if(!angst && environment(hs) == find_object("/d/kristallwald/sargola/insel/room/dummy") )
	{
		hs->move(TO, M_GO);
		return ;
	}
		
	if(!angst)
		return ;
	//Schuechtling removen
       call_out("remsch", 0, hs);
   	
   	

}	   		

remsch(object o)
{
  o->move(ROOM+"dummy",M_GO);
}

t_r()
{
  tell_room(TO, BS("Der Hoehlenschuechtling wird derart "
		+"eingeschuechtert, dass er in hintere Bereiche der "
		+"Hoehle flieht. Deine Gestalt scheint ihn sehr er"
		+"schreckt zu haben. Vielleicht lags ja an Deiner "
		+"Kleidung...\n") );

}

//vom dummy-raum herholen
holen()
{
  object o;
  o = find_living("hoehlenschuechtling");  

  if(environment(o)==find_object("/d/kristallwald/sargola/insel/room/wasserfall"))
    return ;

  if(environment(o) != TO) {
          o->move(TO, M_GO);
  }
  if(find_call_out("holen")==-1)
	call_out("holen",20);
}

