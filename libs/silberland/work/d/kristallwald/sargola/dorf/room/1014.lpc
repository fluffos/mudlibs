inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "../def.h"

int ist_tier_da;

      create()
      {
        ::create();

   ist_tier_da = 1;

     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]) );
          
        SetProp( P_INT_SHORT, "Ein Waldweg" );
        SetProp( P_INT_LONG, 
      BS(   "Du stehst auf einem breiten Waldweg, der von Straeuchern "
         +"gesaeumt wird und der, trotz des dichten Waldes, schoen "
         +"begehbar ist. Es geht leicht bergab.\n") );
     
        SetProp( P_LIGHT, 1 );
        SetProp( P_INDOORS, 0 );
     
   AddDetail( ({"weg","waldweg"}), BS("Ein breiter Weg, der schon oft benuetzt "
	+"wurde."));
   AddDetail( "boden", BS("Der Boden besteht aus niedergetretener Erde.\n"));
   AddDetail ("erde", BS("Sie ist trocken und hart.\n"));
   AddDetail( "himmel", BS("Den Himmel kannst Du nur mehr ueber dem Dach der Baeume "
      +"erahnen.\n")   );
   AddDetail( ({"strauch","straeucher"}), BS("Sie fassen den Weg links und "
      +"rechts ein.\n"));
   AddDetail( ({"baum","baeume","stamm","staemme"}),
	BS("Es sind die typischen weisslichen Staemme, die die ganze Gegend "
	+"charakterisieren." ));

       AddDetail( ({"kristallwald","wald"}), BS("Du stehst genau drin.\n")   );
       
        
      
   AddSound (DEFAULT_SOUND, "Du kannst nichts Besonderes hoeren.\n");
   
   AddSmell(DEFAULT_SMELL, "Hier ist alles geruchlos.\n");



        AddExit( "nordosten", ROOM+"1113.lpc" );
	AddExit("suedosten", "/d/kristallwald/muaddib/weg/room/weg7");
        AddExit( "westen", ROOM+"0914.lpc" );

      }
 
