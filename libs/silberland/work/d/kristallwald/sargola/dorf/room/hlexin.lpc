#include "../def.h"
#include "dorf.h"

inherit "std/room";

#include <properties.h>

string bewohnerin(string str);

create()
{
  ::create();

  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  
  SetProp(P_INT_SHORT,"Bei Lexin");
  SetProp(P_INT_LONG, 
	   BS("Du befindest Dich in dem sicherlich duestersten und dunkelsten "
	      "Talan in ganz Elessar. Es dringt kaum Licht durch die Aeste. "
	      "Ein strenger Geruch dringt in Deine Nase. Du erkennst einige "
	      "Apparaturen und seltsame Werkzeuge auf zwei Tischen. Drei "
	      "schwarze Buecher liegen aufgeschlagen auf dem einen Tisch."));

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS, 1);

  AddDetail("elfen",
	    "Du bist hier in Elessar, dem Walddorf der Elfen. Du darfst "
	    "Dich also nicht wundern, wenn Dir viele Elfen hier begegnen.");
  
  AddDetail("boden",
	    "Der Boden ist ein stabiler Talan.");
  
  AddDetail(({"holzplattform","talan"}),
	    "Die Holzplattform, auf der Du stehst, nennen die Elfen Talan.");
   
  AddDetail("Geruch", 
	    "Es ist nur eine Vermutung, aber Du koenntest ja mal riechen...");
  
  AddDetail(({"dunkelheit","licht"}), 
	    ([ 0: "Du brauchst eine Weile, bis Du Dich an die "
	       "Dunkelheit gewoehnt hast.",
	       "dunkelelf": "Hier ist es ertraeglich dunkel."]));
  
  AddDetail(({"apparatur","apparaturen"}), "Du siehst eine glaeserne "
	    "Karaffe mit einer blauen Fluessigkeit, darunter eine kleine "
	    "Flamme. Weiters findest Du eine Schuessel, daneben "
	    "auf dem Tisch einen Haufen braunen Pulvers.");
  
  AddDetail(({"tisch","tische","holzisch","holztische"}),
	    "Naja, einfache Holztische halt.");
  
  AddDetail(({"buch","buecher"}),
	    "Du glaubst nicht, dass die Eigentuemerin erlaubt, dass Du ihre "
	    "Buecher liest. Der Titel des einen Buches faellt Dir aber auf.");
  
  AddDetail("decke",
	    "Eine Decke siehst Du hier nicht. Die Aeste formen den Raum.");
  
  AddDetail("titel",
	    "Das Buch handelt ueber die Wanderung der Seelen.");
 
  AddDetail("karaffe",
	    "Sie ist halbvoll und dampft zischend.");
  
  AddDetail("fluessigkeit",
	    "Die Fluessigkeit ist sicher sehr heiss - pass lieber auf. "
	    "Vielleicht ist sie ja auch aetzend...");
  
  AddDetail("flamme",
	    "Eine kleine, blaeuliche Flamme zuengelt unter der Karaffe.");
  
  AddDetail("schuessel",
	    "Die aus weisser Keramik hergestellte Schuessel enthaelt "
	    "fein gerebelte Kraeuter.");
  
  AddDetail("kraeuter",
	    "Du denkst: Da kann Dir Shardin sicher weiterhelfen.");
  
  AddDetail(({"haufen","pulver"}),
	    "Du kannst nicht erkennen, was das fuer ein Pulver sein soll. Am "
	    "Besten, Du laesst es einfach liegen.");
  
  AddDetail(({"apparate","werkzeuge"}),
	    "Du erkennst sehr fremd anmutende Apparate. Wozu diese dienen, "
	    "weiss wohl nur die Bewohnerin.");
  
  AddDetail(({"eigentuemerin","bewohnerin"}), CLOSURE(bewohnerin));
  
  AddDetail(({"dorf","walddorf","elessar"}),
	    "Elessar ist das Walddorf der Elfen.");
  
  AddDetail("aeste",
	    "Sie sind sehr dicht und lassen kaum Licht in den Raum.");
  
  AddDetail("raum",
	    "Was willst Du denn hier genau untersuchen?");
  
  AddDetail("himmel",
	    "Der Himmel ist nicht zu sehen.");
  
  AddDetail(({"wand","waende"}),
	    "Waende als solches gibt es hier nicht. Es sind vielmehr "
	    "dichte Aeste, die den Raum hier bilden.");
  
  AddDetail("keramik",
	    "Die Schuessel ist aus feiner, weissen Keramik.");
  
  AddSmell(DEFAULT_SMELL,
	   "Dir steigt ein strenger Geruch in die Nase.");

  AddSmell("geruch",
	   "Genau kannst Du den Geruch nicht lokalisieren...");
  
  AddSmell("apparaturen",
	   "Deren gibt es hier viele...");

  AddSmell("karaffe",
	   "Die Karaffe selbst ist wohl geruchlos, aber die Fluessigkeit "
	   "darin solltest Du mal naeher untersuchen.");
  
  AddSmell("fluessigkeit",
	   "Von der Fluessigkeit stammt also der stechende Geruch in dem "
	   "Raum hier. Du veraetz Dir noch die Nase, wenn Du "
	   "noch laenger daran riechst...");
  
  AddSmell("flamme",
	   "Du traust Dich nicht, naeher an der Flamme zu riechen.");
  
  AddSmell(({"kraeuter","schuessel"}),
	   "Die Kraeuter in der Schuessel riechen nicht mehr so frisch. Es "
	   "sind wohl schon getrocknete Kraeuter.");
  
  AddSmell(({"haufen","pulver"}),
	   "Das Pulver hat einen absolut unbekannten Geruch. Du hast keine "
	   "Ahnung, was das sein soll...");  
  
  AddCmd(CMD_TRINKEN,"trinke");
  AddCmd(CMD_LESEN,"lies");
  
  AddExit("osten", ROOM "1_0513");
  
  AddItem(NPC "lexin", REFRESH_DESTRUCT);
}

nosave int lies(string str)
{
  notify_fail(BS("Was moechtest Du lesen?"));
  if(!str) return 0;
  
  if(str=="buch")
    {
      write(BS("Du beginnst das Buch zu lesen und erfaehrst, dass die "
	       "Wanderung der Seele durch das Pflanzen einer Zeder "
	       "verhindert werden kann. Durch alte, laengst vergessene "
	       "Rituale ist es moeglich, den Koerper wieder zum Leben "
	       "zu erwecken."));

      tell_room(TO, BS(TPN+" liest ein Buch."),({TP}));

      return 1;
    }

  return 0;
}

nosave int trinke(string str)
{
  notify_fail("Was moechtest Du trinken?\n");
  if(!str) return 0;
	
  if(str=="fluessigkeit")
    {
      write(BS("Du setzt die Karaffe an Deine Lippen und nimmst einen "
	       "langen Schluck...")+
	    BS("Die Fluessigkeit veraetzt Dir den ganzen Hals!"));
      
      tell_room(TO, BS(TPN+" trinkt die Fluessigkeit aus der Karaffe."),
		({TP}));

      TP->AddHp(-5);

      return 1;
    }
  
  return 0;
}

string bewohnerin(string str)
{
  if(present("lexin"))
    return "Sie steht hier in diesem Raum - sprich halt mit ihr "
      "darueber.\n";

  return "Die ist offensichtlich gerade nicht hier.";
}
