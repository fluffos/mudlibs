#include "../def.h"
#include "dorf.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]));
  
  SetProp(P_INT_SHORT, "Eine Seitengasse in Elessar");
  SetProp(P_INT_LONG, 
	  BS("Du stehst hier auf einer Plattform, die sich ganz im Westen "
	     "von Elessar befindet. Im Westen siehst Du einen dunklen, etwas "
	     "abgelegenen Talan. Die Wohnung wirkt wenig einladend. Wer da "
	     "wohl wohnt?"));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail("wohnung", 
	    "Der Talan ist nicht gerade einladend. Sie ist einfach gehalten "
	    "und duerfte wohl eine private Wohnung eines Elfen sein.");
   
  STANDARD1
  STANDARD2
  BODEN_WEG
   
  AddSound("stimme",
	   "Du kannst eine leise Stimme von Westen her vernehmen.");
  AddSmell(DEFAULT_SMELL,
	   "Reine Waldluft, die durch einen stinkenden, beissenden Geruch "
	   "gestoert wird.");
  
  AddSmell("geruch",
	   "Es beisst nun gewaltig in Deiner Nase!");
  
  AddRoomMessage(({
    "Ein strenger Geruch dringt von Westen her in Deine Nase.\n",
      "Du hoerst eine leise Stimme im Westen.\n",
      "Irgendetwas raschelt unter Dir in den Straeuchern.\n" }), 100);
  
  AddExit("westen", 
	  ([EX_DEST: ROOM "hlexin", EX_TESTFUNC:"westen",
	  EX_MSG:"nach Westen in den Talan"]));
  
  AddExit("sueden", ROOM "1_0514");
}

int westen()
{
  if(TP->QueryQuest("Die alte Zeder"))
    return write(BS("Seitdem Du Lexin getoetet hast und damit die "
		    "Reinkarnation von Xalgur verhindert hast, ist der "
		    "Talan verlassen und leer.")+
		 BS("Du beschliesst, draussen zu bleiben.")), 0;
  else
    if(present("\nzedernquestobject",TP))
      return 1;
  
  write(BS("Du traust Dich nicht, private Gemaecher zu stoeren."));
  
  return 0;
}
