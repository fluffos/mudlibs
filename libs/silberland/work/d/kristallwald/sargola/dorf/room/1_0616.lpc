#include "../def.h"

inherit "std/room";

#include "dorf.h"

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]));
  
  SetProp(P_INT_SHORT, "Elessar");
  SetProp(P_INT_LONG,
	   BS("Du stehst auf einem kleinen, fast schon abgelegenen Talan. "
	      "Es ist angenehm ruhig hier. Hier ist wohl eine abgeschiedene "
	      "Ecke in Elessar. Im Norden siehst Du seltsame Umrisse."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  STANDARD1
  STANDARD2
  BODEN_WEG

  AddDetail(({"tuere","tuer", "umrisse"}),
	    "Du kannst die Umrisse einer Tuer erkennen, aber "
	    "Dir ist nicht bekannt wo und wie sie zu oeffnen ist. "
	    "Dir faellt ein dunkler Fleck an der Tuer auf.");
  
  AddDetail("fleck",
	    "Bei genauerer Untersuchung stellst Du fest, "
	    "dass es sich um den Abdruck einer Hand handelt.");
  
  AddDetail("hand",
	    "Genaugenommen ist es der Abdruck einer "
	    "rechten Hand. Eigenartig, was das wohl zu "
	    "bedeuten hat?");
  
  AddDetail("abdruck",
	    "Ein Negativ von einem Gegenstand, das entsteht, "
	    "wenn man selbigen in eine plastisch verformbare "
	    "Masse drueckt.");
  
  AddDetail("gegenstand",
	    "In diesem Fall offensichtlich die rechte Hand.");
  
  AddCmd(({"lege","leg","druecke","drueck"}), "lege");
  
  AddItem(NPC "waechtr1", REFRESH_DESTRUCT);
  
  AddExit("osten",  ROOM "1_0716");
  AddExit("westen", ROOM "1_0516");
  AddExit("sueden", ROOM "laden");
}

nosave int lege(string str)
{
  string race;
  
  notify_fail(BS("Was moechtest Du wo hineinlegen?"));
  if(!str) return 0;
  
  if(str=="hand in abdruck")
    {
      race = TP->QueryProp(P_RACE);
      
      switch(race)
	{
	case "Mensch":
	case "Dunkelelf":
	case "Elf":
	  {
	    tell_object(TP, 
			BS("Du legst Die Hand in den Abruck "
			   "welcher in etwa in Augenhoehe ist. Tja, entweder "
			   "Du hast Dir in der Kneipe einen Krug Bier zuviel "
			   "genehmigt, oder Du wirst ohnmaechtig..."));

	    tell_object(TP, 
			BS("Nach einiger Zeit wachst Du wieder auf. Du bist "
			   "Dir nicht sicher, wie lange Du ohne Bewusstsein "
			   "warst."));

	    TP->move("/d/seher/haus/subsonic:00:00.lpc", M_GO|M_SILENT);

	    return 1;
	  }
	
	case "Hobbit":
	case "Zwerg":
	  {
	    tell_object(TP, 
			BS("Du stellst Dich auf die Zehenspitzen um Deine "
			   "Hand in den Abdruck legen zu koennen. Tja, "
			   "entweder Du hast Dir in der Kneipe einen Krug "
			   "Bier zuviel genehmigt, oder Du wirst "
			   "ohnmaechtig..."));

	    tell_object(TP, 
			BS("Nach einiger Zeit wachst Du wieder auf. Du bist "
			   "Dir nicht sicher, wie lange Du ohne Bewusstsein "
			   "warst."));

	    TP->move("/d/seher/haus/subsonic:00:00.lpc", M_GO|M_SILENT);

	    return 1;
	  }
	
	default:
	  {		   
	    tell_object(TP, 
			BS("Du legst Die Hand in den Abruck welcher in etwa "
			   "in Augenhoehe ist. Tja, entweder Du hast Dir in "
			   "der Kneipe einen Krug Bier zuviel genehmigt, oder "
			   "Du wirst ohnmaechtig..."));
	    
	    tell_object(TP, 
			BS("Nach einiger Zeit wachst Du wieder auf. Du bist "
			   "Dir nicht sicher, wie lange Du ohne Bewusstsein "
			   "warst."));

	    TP->move("/d/seher/haus/subsonic:00:00.lpc", M_GO|M_SILENT);			
	    return 1;
	  }
	}
    }
  
  return 0;
}

