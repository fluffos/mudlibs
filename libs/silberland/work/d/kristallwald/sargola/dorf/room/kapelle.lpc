#include "../def.h"

inherit "std/room";

#define MAX_WAECHTER 3

nosave int zaehler;

int ruf(string str);
string gestalt(string str);
string tafel(string str);

void create()
{
  ::create();

  zaehler = 0;

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS, 1);
  
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]) );
  
  SetProp(P_INT_SHORT, "Im heiligen Schrein der Elfen");

  SetProp(P_INT_LONG, 
	  BS("Hier, im heiligen Schrein der Elfen kannst Du beten, um "
	     "wieder Deine natuerliche Gestalt zu erhalten. Am westlichen "
	     "Ende steht ein Altar, auf dem sich zwei silberne Schalen "
	     "befinden. Neben dem Altar haengt eine Heldentafel. "
	     "Durch zahlreiche Fenster dringt Licht in den Raum, wodurch er "
	     "eine sakrale Ausstrahlung erhaelt. Nach Osten und nach "
	     "Suedwesten hin kannst Du den Schrein verlassen."));

  AddDetail("raum", 
	    "Du stehts im Schrein der Elfen.");

  AddDetail("ausstrahlung", 
	    "Du bist lieber leise hier drin...");

  AddDetail(({"waldelfen","elfen"}), 
	    "Obwohl Du Dich hier in der Elfenstadt Elessar befindest, "
	    "siehst Du hier keine Elfen.");

  AddDetail("gestalt", CLOSURE(gestalt));

  AddDetail("schrein", 
	    "Das ist hier.");

  AddDetail("altar", 
	    "Er ist aus Holz, wirkt aber trotzdem erhaben schoen. "
	    "Zwei Schalen stehen auf ihm.");

  AddDetail("elessar",
	    "Elessar ist die Stadt der Waldelfen.");

  AddDetail("stadt", 
	    "Ja, hier ist Elessar.");

  AddDetail(({"schale", "schalen"}), 
	    "Eine der Schalen steht links, die andere rechts. In ihnen "
	    "liegt ein Stein und eine Bluete.");

  AddDetail("bluete", 
	    "Eine feine, silberne Bluete liegt in der Schale. Sie "
	    "symbolisiert die Verbundenheit der Elfen zur lebenden Natur.");

  AddDetail("stein", 
	    "Ein faustgrosser, kristallener Stein, der die "
	    "Verbundenheit der Elfen zur unbelebten Natur symbolisiert.");

  AddDetail("natur", 
	    "Wenn eine Rasse mit der Natur verbunden wird, dann sind "
	    "es die Elfen.");

  AddDetail("holz", 
	    "Sehr robust verarbeitet, der Altar.");

  AddDetail(({"durchlaesse","fenster"}), 
	    "Es sind Durchlaesse in den Waenden und keine Fenster. "
	    "Das Licht stroemt milchig herein und bildet Saeulen, die "
	    "am Boden reflektiert werden.");

  AddDetail("saeulen", 
	    "Es wirkt irgendwie unwirklich schoen hier...");

  AddDetail("licht", 
	    "Von beiden Seiten ergiesst es sich in auf den Boden.");

  AddDetail(({"wand", "waende"}), 
	    "Sie sind einfach gehalten, wie alles hier.");

  AddDetail("boden", 
	    "Es ist blank und bietet keine weiteren Besonderheiten.");

  AddDetail("besonderheiten", 
	    "Doch warte: Da ist doch was! Bei genauerer Betrachtung "
	    "faellt Dir auf, dass die Latten mit einer Art Dichtungsmasse "
	    "bearbeitet wurden.");

  AddDetail("decke", 
	    "Nur Holzlatten, die das Hereinregnen verhindern.");

  AddDetail(({"regnen","hereinregnen"}), 
	    "Es regnet nicht, jedenfalls merkst Du es hier drin nicht..");

  AddDetail(({"masse","dichtungsmasse"}), 
	    "Du kratzt sie mit den Fingernaegeln heraus. Iiiihh.");

  AddDetail("naegel" , 
	    "Sie eignen sich ob der Laenge gut zum Rauskratzen der "
	    "Dichtungsmasse");

  AddDetail("laenge", 
	    "Die gehoeren eigentlich wieder mal geschnitten...");

  AddDetail(({"latte","latten","holzlatten","holzlatte"}), 
	    "Blank polierte Holzlatten.");

  AddDetail("bretter", 
	    "Der Boden besteht aus ihnen.");

  AddDetail(({"tafel", "heldentafel"}),
	    "Die Heldentafel haengt neben dem Altar. Auf ihr sind die "
	    "groessten elfischen Helden vermerkt. Du kannst sie lesen.");

  AddReadDetail(({"heldentafel", "tafel"}), CLOSURE(tafel));

  //AddItem("/obj/zeitungsautomat", REFRESH_REMOVE);
  AddItem(OBJ "zeitungsstand", REFRESH_REMOVE);
  AddItem("/p/service/obj/zettel/zettelmaschine", REFRESH_REMOVE);

  AddCmd("bete","beten_fkt");
  AddCmd(({"ruf","rufe"}), "rufen_check");
  AddExit("osten", ROOM "1_0915");
  AddExit("suedwesten", ROOM "1_0716");
}

nosave int beten_fkt(string str)
{
  write(BS("Du faellst auf die Knie und sprichst innig zu Deinem Gott."));

  if(TP->QueryProp(P_GHOST))
  {
    say(BS("Der Geist von "+TPN+" kniet nieder und betet innig."), ({TP}));

    write(BS("Eine sehr starke Kraft saugt Dich auf und spuckt Dich wieder "
	     "aus.")+
	  BS("Du spuerst langsam wieder, wie Blut Deinen Koerper von neuem "
	     "durchstroemt."));
    
    say(BS(TPN+" erscheint ploetzlich wieder in koerperlicher Form."), ({TP}));
    
    TP->SetProp(P_GHOST, 0);
    
    if(TP->QueryProp(P_RACE)=="Elf")
      TP->heal_self(5+random(5));
  }
  else
    say(BS(TPN+" kniet nieder und betet zu "+TP->QueryPossPronoun(MALE, WEM)+
	   " Gott."));

  return 1;
}

nosave int rufen_check(string str)
{
  object waechter;
  
  notify_fail(BS("Was willst Du rufen?"));
  if(!str) return 0;

  if(zaehler > MAX_WAECHTER) return 0;

  if(IS_WIZARD(TP)) return 0;
  
  if((TP->QueryProp(P_LEVEL)<5) || (TP->QueryProp(P_GHOST)))
    return write(BS("Vorsicht! Hier solltest Du nicht so "
		    "herumschreien!")), 0;
    
  write(BS("Ohh! Das haettest Du nicht tun sollen! Im Schrein macht man "
	       "keine Laerm!"));
  
  waechter=clone_object(NPC "waechter");
  waechter->move(ME, M_NOCHECK);
  waechter->Kill(TP);
  waechter->geh_weg(600);
  
  zaehler+=1;
  
  return 0;
}

string gestalt(string str)
{
  if(TP->QueryProp(P_GHOST))
    return BS("Gestalt als solche hast Du ja gerade keine...");
  
  return BS("Du kannst hier beten, wenn Du aus unerfindlichen "
	    "Gruenden mal ein Geist bist.");
}

string tafel(string str)
{
  TP->more("/etc/topelfen.read", 1);
  return "";
}
