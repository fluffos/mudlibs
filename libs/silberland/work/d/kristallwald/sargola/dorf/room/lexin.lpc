inherit "std/npc";  
#include <properties.h>  
#include <language.h>  
#include <combat.h>  
#include <new_skills.h>  
#include <moving.h>

#include "../def.h"  
//object ob;
knochen();

create()  
{  
     if (!is_clone(TO)) return;  
     ::create();   
     SetProp(P_SHORT, "Lexin");  
     SetProp(P_LONG, BS("Lexin ist eine Elfin mit langen, braunen Haaren. Sie ist die Urenkelin von "
	+"Xalgur und hat einen fiesen Ausdruck im Gesicht. Ich wuerde ihr nich trauen."));  
    set_living_name("lexin");
    SetProp(P_GENDER, FEMALE);  
     SetProp(P_NAME, "Lexin");  
     SetProp(P_ARTICLE, 0);  
     AddId (({"lexin", "elfe"}));  
     SetProp(P_DIE_MSG, " sackt lautlos in sich zusammen.\n");  
     SetProp(P_NOCORPSE, 1);
     create_default_npc (10);  
   SetProp(P_HANDS, ({" mit ihren Haenden", 45, DT_BLUDGEON}));  
   SetProp(P_LOG_INFO, "lexin");
      SetAttribute(A_INT, 25);
   
   SetProp(P_HEAL, 20);  
     SetProp(P_RACE, "Elf");  
     SetProp(P_ALIGN, -300);  
     SetProp(P_SIZE, 173);
     SetProp(P_XP, 0);		//Quest-NPC :)
     
     
     SetProp(P_RESISTANCE_STRENGTHS, 
     	([DT_MAGIC:-0.5,
     	  DT_ACID:-0.5,
     	  DT_POISON:-0.6,
     	  DT_COLD:-0.4,
     	  DT_TERROR:-0.2,
     	  DT_FIRE: -0.6
     	]) );
     
     SetProp(P_NOMAGIC, 65);
     
     SetProp(P_LOG_INFO, "lexin.log"); 
     
     
     switch(random(2))
     {
     	case 0:
     		CLONEME(ARMOUR+"hemd");
     	case 1:
     		CLONEME(ARMOUR+"leggings");
     	break;
     }
     
//   clone_object("/d/kristallwald/sargola/lichtung/obj/knochen")->move(TO);     
     
    AddInfo("lexin","Das ist mein Name! Und nun stoer mich nicht weiter!", "sagt: ");
     AddInfo("sargola","Dieses Kretin Sargola glaubt, ein Magier zu sein!\n", "sagt: ");  
     
 AddInfo( ({"elfenstadt","elessar"}),
 	"Das ist die Elfenstadt, Elessar.\n", "sagt: ");   

 AddInfo("magier",
 	"Kennst Du denn einen guten Magier?\n", "fragt: ");
AddInfo("kraeuter",
	"Wozu ich die brauche geht Dich nichts an.","sagt: ");
	
AddInfo("shardin",
	"Was soll ich denn ueber sie wissen?", "herrscht Dich an: ");
	
AddInfo( ({"see","see von rhondonit","rhondonit"}) ,
	"Der See liegt noerdlich des Dorfes hier. Und jetzt stoer "
	+"mich nicht weiter.","sagt: ");
	
AddInfo("hilfe",
	"Du kannst mir nicht helfen.","sagt: ");


AddInfo("elfen",
	"Ich habe keine Zeit, dir solche Fragen zu beantworten.","sagt: ");

AddInfo( ({"aufgabe","quest","problem"}),
	"Meine Probleme gehen Dich nichts an!","sagt: ");
	
AddInfo( ({"aerendil","bibliothekar"}),
	"Aerendil ist der Bibliothekar und befindet sichim Nordosten von "
	+"Elessar.","sagt: ");
	
AddInfo( ({"sturm","lichtung","blitz","baum","zeder"}),
	"Warum sollte ich darueber etwas wissen??",
	"fragt: ");
	
AddInfo(({"grab","knochen"}),#'knochen);
	
AddInfo( ({"enkelin","nachfahrin"}),
	"Ich bin eine Nachfahrin von Xalgur, dem letzten wahren Elfenmagier!","sagt: ");

AddInfo( ({"elfenmagier","xalgur"}) ,
	"Xalgur beherrste die Magie vortrefflich. Die anderen Elfen "
	+"fuerchteten sich vor ihm und entledigten sich seiner in einer "
	+"Nacht-und-Nebel Aktion!","sagt: ");

AddInfo("magie",
	"Mit Magie kann man Menschen beherrschen, ihren Willen brechen, "
	+"Krankheiten ausloesen und andere Dinge vollbringen.","sagt: ");
	
AddInfo("lorendiel",
	"Lorendiel, diese Bastard! Er hat Xalgur toeten lassen.","flucht: ");

AddInfo( ({"rat","rat der aeltesten","aeltesten","geschick","geschicke"}),
	"Der Rat der Aeltesten beschliesst die Geschicke des Stammes. Leider "
	+"sind meist Feiglinge und verlogenen Gestalten im Rat.","sagt: ");

AddInfo(({"wurzeln"}),
	"schaut Dich mit misstrauischen Augen an.\n");
	
AddInfo("baaleth",
	"Baaleth, die Moechte-Gern-Magiern!","lacht: ");
	
AddInfo( ({"magierin","moechte-gern-magierin"}),
	"Baaleth waere gern so wissend wie ich.","sagt: ");
}
knochen()
{
	write(
"Lexin schaut Dich finster an, durchbohrt Dich mit ihren Blicken.\n"
+"Lexin ruft: Ja, "+TPN+", ich habe die Knochen von seinem Grab! Mit ihrer\n"
+"Lexin ruft: Hilfe werde ich Xalgur zu einem neuen Koerper verhelfen! Er wird\n"
+"Lexin ruft: in einem Ritual in meinen Koerper wandern und weiterleben!\n\n");

write("Lexin gibt dir eine schallende Ohrfeige!\n\n");
	TP->do_damage(5);
}



die(int arg)
{
	object ob;
	

	ob = present("\nzedernquestobject",TP);
	if(objectp(ob))
	{
	ob->erhoehe_zaehler(2);	//zaehler = 2; baum untersucht, lexin getoetet :)
	ob = clone_object("/d/kristallwald/sargola/lichtung/obj/knochen.lpc");
	ob->move(TO, M_NOCHECK);
	write("Die Leiche von Lexin verschwindet in einem hellen Licht, nur die "
	+"Knochen bleiben liegen.\n");
	ob->set_owner(TP->query_real_name() );
	}
	::die();
		
}



