#include "../def.h"

inherit "std/room";

string tod(string str)
{
  //Sollte fuer den kraeftigsten Adventurer reichen :)
  TP->do_damage(500);
  
  return "Jemand kichert hinter Deinem Ruecken.\n";
}

string aerendil_weg()
{
  if(QueryProp("xulia")) return "\nEin kleines Schild haengt an einem "
			   "Regal beim Eingang.";
  
  if(!TP) return "";
  
  if(!present("aerendil"))
    if(present("\n_insel_quest", TP) ||
       present("\nzedernquestobject", TP) ||
       present("\nosterhasenquest", TP))
      return "\nAerendil ist gerade nicht da, aber Du kannst ihn mit der "
	"Klingel herbeirufen.";
  
  return "";
}

string schild_det()
{
  if(QueryProp("xulia")) return "Auf dem Schild steht: \"Bin bei Xulia\"\n";
  
  return 0;
}

void create()
{
  ::create();

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS, 1);
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]) );
       
  SetProp(P_INT_SHORT,"Die Bibliothek von Elessar");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich in der Bibliothek von Elessar. Hier werden "
	     "alle Faksimile und Originale von Buechern und anderen "
	     "Schriftstuecken aufbewahrt. Du siehst riesige Stapel von "
	     "Buechern. Dazwischen schlurft meist der Bibliothekar "
	     "schmoekernd hin und her.@@aerendil_weg@@"));
  
  AddDetail(({"eingang", "ausgang"}),
	    "Der Eingang, der gleichzeitig auch der Ausgang ist, befindet "
	    "sich hinter Dir.");
  
  AddSpecialDetail(({"schild"}), "schild_det");

  AddReadDetail(({"schild"}), CLOSURE(schild_det));
  
  AddDetail("bibliothek", 
	    "Das ist hier.");

  AddDetail(({"originale", "faksimile"}), 
	    "Du kennst den Unterschied sowieso nicht...");

  AddDetail("unterschied", 
	    "Der UNTERSCHIED zum Original...");

  AddDetail(({"elessar","elbenstein","stadt"}), 
	    "So nennt man die Stadt der Elfen - Du befindest Dich in ihr.");

  AddDetail(({"schriftstueck", "schriftstuecke"}), 
	    "Hier findest Du sicher Antworten auf deine brennendsten Fragen.");

  AddDetail(({"stapel","buecher"}), 
	    "Du wuerdest nie etwas finden in dieser Unordnung.");

  AddDetail("unordnung", 
	    "Vielleicht ist es ja gar nicht so unordentlich. Moeglicherweise "
	    "weiss der Bibliothekar mehr ueber die Elfen oder Elessar....");
  
  AddDetail("fenster", 
	    "Es sind Durchlaesse in den Waenden und keine Fenster. Das Licht "
	    "stroemt milchig herein und bildet Saeulen, die sich am Boden"
	    "reflektiert werden.");
  
  AddDetail("licht", 
	    "Von beiden Seiten ergiesst es sich in auf den Boden.");

  AddDetail(({"wand", "waende"}), 
	    "Sie sind mit Buecherschraenken voll.");

  AddDetail(({"buecherschrank","buecherschraenke","schrank","schraenke"}),
	    "Sie biegen sich gewaltig unter der Last der Waelzer.");
  
  AddDetail("waelzer", 
	    "Es gibt duenne, dicke, golden beschlagene, staubige und "
	    "zerrissene...");

  AddDetail("boden", 
	    "Er besteht aus blanken Brettern und biete keine weitern "
	    "Besonderheiten.");

  AddDetail("besonderheiten", 
	    "Ich sage doch: KEINE Besonderheiten!");

  AddDetail("keine", 
	    "Na sowas! Untersuchst Du auch etwa Xksdfasdfjlks?");

  AddDetail("xksdfasdfjlks", 
	    "Holla! Ein Script! Merke, Abenteurer: untersuchst Du "
	    "Selbstmoerder dann spricht das fuer dich...");
  
  // HIER KOMMT DER TOD !!!!!!!!!!!!!!!!!!!!!!!!!!!
  AddDetail("selbstmoerder", CLOSURE(tod));

  AddDetail(({"holzlatten","latten","decke"}), 
	    "Nur Holzlatten, die das Hereinregnen verhindern.");

  AddDetail(({"platten","holzplatten"}), 
	    "Sauber und genau geschnittene Bretter aus kristallener Eiche "
	    "wurden zum Zimmern des Bodens verwendet.");

  AddDetail(({"regnen","hereinregnen"}), 
	    "Es regnet gerade nicht...");

  AddDetail(({"brett","bretter"}), 
	    "Der Boden und die Decke besteht aus Brettern.");
  
  AddDetail(({"klingel"}),
	    "Ha, da steht doch tatsaechlich eine Klingel herum.\nWas wohl "
	    "passiert, wenn man mit ihr klingelt?");
  
  AddDetail(({"bibliothekar","aerendil"}),
	    "Er scheint gerade nicht da zu sein.");
  
  AddExit("sueden", ROOM "1_0713");
  
  AddCmd(({"klingle","klingel","klingele"}), "klingeln");
  
  AddItem(NPC "aerendil", REFRESH_DESTRUCT);
}

nosave int klingeln(string str)
{
  notify_fail(BS("Womit willst Du denn klingeln?"));
  if(str && str!="klingel" && str!="mit klingel") return 0;
  
  write(BS("Du klingelst mit der Klingel..."));
  
  if(present("aerendil"))
    return write(BS("Aerendil schimpft: Lass das! Ruhe!")), 1;
  
  if(QueryProp("xulia"))
    return write(BS("Hm, es tut sich nichts...")+
		 BS("Du siehst Dich etwas um und bemerkst ein Schild...")), 1;

  if(present("\n_insel_quest", TP) || 
     present("\nzedernquestobject", TP) || 
     present("\nosterhasenquest", TP)) 
    {
      RemoveItem(NPC "aerendil");
      AddItem(NPC "aerendil", REFRESH_DESTRUCT);
      write(BS("Aerendil blickt Dich an und fragt: Ja? Was gibt es denn?"));
    }
  
  return 1;
}
