/**
* Post in Elessar*
*---*/


inherit "/std/post";
#include <properties.h>
#include "../def.h"
create(){
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
       SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]) );
       
  SetProp (P_INT_SHORT, "Post in Elessar");
  SetProp (P_INT_LONG, BS("Dies ist die Post von Elessar. "+
    "Hier kannst Du Briefe an Deine Mitspieler schicken und "+
    "Briefe von ihnen lesen. Wenn Du das willst, tippe 'post'. "+
    "Ruhe vor anderen Anwesenden und dem typischen Stimmengemurmel in "+
    "einer Post hast Du, wenn Du eine der Ein-Personen-Kabinen betrittst.\n"+
    "Nach Norden kannst Du die Post wieder verlassen. \n"));
  AddDetail( ({"personen","anwesende"}), BS("Du bist nicht der Einzige, der Nachrichten an "
	+"Freunde schicken will."));
  AddDetail("post", BS("Du befindest Dich genau in ihr."));
  AddDetail ( "decke", "Die Decke besteht aus Zweigen.\n");
  AddDetail("zweige", BS("Sie bilden die Kapseln, die so charakteristisch hier in "
	+"diesem Dorf sind."));
  AddDetail("kapsel", BS("Sie schuezten vor Regen und Kaelte."));
  AddDetail( ({"regen","kaelte"}), BS("Regen und Kaelte werden durch die Kapseln ab"
	+"gehalten."));
  AddDetail ( "boden", "Der Boden ist, wie ueberall hier, ein Talan.\n");
  AddDetail("talan", BS("Ein Talan ist ein Boden aus Holzbrettern."));
  AddDetail( ({"holz","bretter","holzbretter"}), BS("Sie bilden den Boden."));
  AddDetail( ({"wand","waende"}), BS("Die Kapsel bildet die Waende hier."));
  AddExit("norden", ROOM+"1_0614.lpc");

}
