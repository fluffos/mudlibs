#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  
  SetProp(P_INT_SHORT, "Elessars Schule der Musik");
  SetProp(P_INT_LONG, 
	  BS("Das ist die Musikschule in Elessar. Hier lernt man die "
	     "beruehrenden und schoenen Lieder der Elfen, die sie singen, "
	     "wenn sie am Feuer sitzen."));

  AddDetail(({"dorf","elfendorf","elessar"}),
	    "Elessar ist der Name des Elfendorfes, in dem Du stehst.");
  
  AddDetail("lieder", 
	    "Weisen, die von aelteren Elfen den jungen gelernt "
	    "werden, und so die Tradition erhalten.");
  
  AddDetail("tradition", 
	    "Die Elfen pflegen das Wissen um ihre Herkunft mit grosser "
	    "Liebe.");
  
  AddDetail(({"musikschule","schule"}), 
	    "Junge Elfen lernen hier hauptsaechlich das Spielen der Floete.");
  
  AddDetail(({"zeiten","herkunft"}), 
	    "Wenn Du mehr wissen willst, frag doch Aerendil.");
  
  AddDetail(({"wand","waende","decke"}), 
	    "Die Decke und die Waende bestehen aus Holzbrettern.");
  
  AddDetail("wissen", 
	    "Das Wissen der Elfen um die frueheren Zeiten ist enorm.");
  
  AddDetail("elfen", 
	    "Ja, die Lieder der Elfen. Du stehst ja nicht in Felonia!");
  
  AddDetail("feuer", 
	    "Gern tragen Elfen beim Feuer ihre Lieder vor.");
  
  AddDetail("boden", 
	    "Saubere Holzbretter und ein geflochtener Teppich bilden den "
	    "Boden.");
  
  AddDetail(({"holzbretter","bretter"}), 
	    "So, wie alle Bretter im Dorf sind sie weisslich und stabil.");
  
  AddDetail("teppich", 
	    "Der Teppich zeigt ein Elf mit einer Floete. Er gibt dem "
	    "Raum hier eine angenehme Ausstrahlung.");
  
  AddDetail("ausstrahlung", 
	    "Du fuehlst Dich hier sofort wohl.");
  
  AddDetail("floete", 
	    "Die Floete beherrscht fast jeder Elf.");
  
  AddSound(({DEFAULT_SOUND, "lieder"}), 
	   "Du hoerst wunderschoene Weisen der Elfen.");
  
  AddExit("westen", ROOM "1_0713");

  AddItem(NPC "serona", REFRESH_DESTRUCT);
}
