#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"kristallpanzer", "panzer"}));
  SetProp(P_SHORT, "Ein Kristallpanzer");
  SetProp(P_LONG, 
	  BS("Ein silbern schimmernder Panzer, der ganz aus Kristall zu sein "
	     "scheint. Er ist unglaublich leicht und hindert kaum im Kampf."));

  SetProp(P_INFO, 
	  BS("Der Kristallpanzer ist perfekt an die elfische Koerperform "
	     "angepasst, darum koennen ihn auch nur Elfen verwenden."));

  SetProp(P_NAME, "Kristallpanzer");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 850);
  SetProp(P_VALUE, 1200);
  SetProp(P_MATERIAL, MAT_QUARTZ);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 23+random(10));

  SetProp(P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE:({"Elf","Dunkelelf"})]));  
}

 
