#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein waldgruener Umhang");
  SetProp(P_LONG, 
	  BS("Mit diesem waldgruenen Umhang ist ein Elf im Wald fast "
	     "unsichtbar."));
  
  SetProp(P_INFO, 
	  BS("Der Umhang ist fuer andere Rassen viel zu lang."));

  SetProp(P_NAME, "Umhang");
  SetProp(P_NAME_ADJ, "waldgruen");
  AddAdjective(({"waldgruen", "waldgruenen", "waldgruener"}));
  SetProp(P_GENDER, MALE);
  AddId(({"umhang"}));
  
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, MAT_CLOTH);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 50);

  SetProp(P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE:({"Elf","Dunkelelf"})]));
}

