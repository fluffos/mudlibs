//  Ein Rock aus Bausch fuer Elfen
// 1997-04-14  Feyaria@SilberLand
#include "../def.h"
inherit "std/armour";
#include <properties.h>
#include <combat.h>
#include <language.h>
create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein kurzer Rock aus Bausch");
  SetProp(P_LONG, BS( 
    "Diese kurze Rock aus Bausch ist bei jungen Elfinnen sehr beliebt. "
    "Er ist mit gruenen Symbolen bestickt.") );
  SetProp(P_NAME, "Bauschrock" );
  SetProp(P_GENDER, MALE);
  SetProp(P_INFO, "Natuerlich tragen nur Frauen so einen Rock.\n");
  AddId( ({"rock", "bauschrock"}) );
  AddAdjective( ({"kurz", "kurzer"}) );
  AddDetail( ({"symbole", "symbol"}),
    "Symbole wie sie die Elfen oft auf Kleidungstuecke sticken.");
  AddDetail( ({"bausch"}),
    "Bausch ist ein weicher, aber widerstandsfaehiger Stoff, den nur die "
    "Elfen verwenden.");

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_BAUSCH:100]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 50);
  SetProp(P_NOBUY, 0);

  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER:FEMALE ]) );
  
}
