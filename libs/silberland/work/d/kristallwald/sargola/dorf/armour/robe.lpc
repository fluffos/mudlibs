#include "../def.h"

inherit "std/armour";

void create()      
{
  if(!is_clone(ME)) return;
  ::create();
             
  AddId("robe");

  SetProp(P_SHORT, "Eine Robe");
  SetProp(P_LONG, 
	  BS("Eine typische Robe, wie sie von vielen Moenchen und Priestern " 
	     "verwendet wird. Doch unterscheidet sich diese durch die " 
	     "wunderschoenen, farbigen Stickereien. Du kannst viele Motive "
	     "erkennen."));
  SetProp(P_NAME, "Robe");
  SetProp(P_GENDER, FEMALE); 
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 3);
  
  AddDetail(({"stickerei","stickereien"}),  
	    "Zu beiden Seiten siehst Du herrliche Ornamente, die "
	    "verschiedene Szenen im Leben eines Elfen zeigen.");
 
  AddDetail(({"szene","szenen"}),  
	    "Die Stickerei auf seiner Brust zeigt einen Elfen, der mit einem " 
	    "Kurzbogen ein Reh erlegt. Die zweite auf dem Ruecken zeigt eine " 
	    "Gruppe von Elfen, die im Kreis um ein Feuer sitzen und Lieder " 
	    "singen."); 
  
  AddDetail(({"bogen","kurzbogen"}),  
	    "Die ist die bevorzugte Waffe eines Elfen."); 
  
  AddDetail(({"waffe","waffen"}),  
	    "Der Elf ist meist mit Kurzbogen und Pfeilen bewaffnet."); 
  
  AddDetail(({"pfeil","pfeile"}),  
	    "Pfeile gehoeren natuerlich zum Kurzbogen dazu..."); 
  
  AddDetail(({"reh","rehe"}),  
	    "Das Reh wird oft von Elfen gejagd."); 
  
  AddDetail(({"kreis","kreise", "feuer"}),  
	    "Abens sitzen die Elfen oft am Feuer und die Alten erzaehlen den " 
	    "Jungen Geschichten."); 
  
  AddDetail("alten",  
	    "Die Alten sind die aelteren Elfen, die im Rat der Aeltesten " 
	    "zusammentreten."); 
 
  AddDetail(({"rat","rat der aeltesten"}),  
	    "Hier werden die Entscheidungen getroffen, die den ganzen Stamm " 
	    "betreffen."); 
 
  AddDetail("stamm",  
	    "Der Stamm der Waldelfen ist gemeint."); 
 
  AddDetail("jungen",  
	    "Sie lernen von den Alten alles, was sie wissen muessen, um zu " 
	    "ueberleben."); 
 
  AddDetail(({"lied","lieder"}),  
	    "Gern singen die Elfen abends im Schein des Feuers Lieder."); 
 
  AddDetail(({"ornament","ornamente"}),  
	    "Sie umranden die herrlich gewebten Szenen."); 

  SetProp(P_MATERIAL, ({MAT_LEATHER}));
  
  SetProp(P_INFO, 
	  BS("Die Robe ist aus einfachem, groben Leinen und dunkelbraun. "
	     "Sie faellt wallend zu Boden und wird durch den Guertel "
	     "tailliert."));
}
