#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"schild","holzschild"}));

  SetProp(P_SHORT, "Ein Holzschild");
  SetProp(P_LONG, 
	  BS("Der Schild besteht aus dickem Holz und ist somit recht schwer. "
	     "Trotz der vielen eingekerbten Schnitte bietet es Schutz."));

  SetProp(P_NAME, "Holzschild");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 1100);
  SetProp(P_VALUE, 200);

  SetProp(P_ARMOUR_TYPE, AT_SHIELD);
  SetProp(P_AC, 13);

  SetProp(P_MATERIAL, MAT_OAK);
  AddDetail("holz",
	    "Der Schild besteht aus hartem Eichenholz.");
  
  AddDetail("schnitte",
	    "Dieses Schild hat ohne Zweifel schon viele Schlaege abgewehrt.");
}
