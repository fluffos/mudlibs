#include "../def.h"

inherit "std/armour";

string schicht(string str);

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  AddId(({"wams","lederwams","fgoblinwams"}));
  SetProp(P_SHORT, "Ein Lederwams");
  SetProp(P_LONG,
	  BS("Das Lederwams bewahrt seinen Traeger vor leichteren Schlaegen. "
	     "Eine kleine Auswoelbung faellt Dir auf.\n"));
  SetProp(P_NAME, "Lederwams");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 15);

  SetProp(P_MATERIAL, MAT_LEATHER);

  AddDetail("auswoelbung", 
	    "Da scheint etwas hinter der aeussersten Lederschicht "
	    "versteckt zu sein.");

  AddDetail(({"schicht","lederschicht"}), CLOSURE(schicht));
}

schicht(string str)
{ 
  object ob;

  write(BS("Du trennst sorgfaeltig das Leder auseinander und findest "
	   "in das Futter eingenaeht einen Schluessel, den Du sofort "
	   "an Dich nimmst. Das Wams ist jetzt allerdings kaputt."));

  RemoveDetail(({"lederschicht","schicht"}));
  
  call_out("remove", 0);
  
  ob=clone_object(OBJ "schlue");

  if(objectp(ob))
    if(ob->move(TP)==ME_TOO_HEAVY)
       {
         tell_object(TP, BS("Der Schluessel ist Dir zu schwer und faellt "
               "auf den Boden."));
         ob->move(ENV(TP));
       }

  return "";
}
