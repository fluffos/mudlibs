#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Leggings aus Hirschleder");
  SetProp(P_LONG, 
	  BS("Diese Leggings sind bei jungen Waldelfen sehr beliebt. Sie "
	     "sind aus dem weichen Leder einer Hirschkuh gefertigt und mit "
	     "gruenen Symbolen bestickt."));
  SetProp(P_NAME, "Leggings");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL,1);
  AddId(({"leggings"}));

  SetProp(P_INFO, 
	  BS("Diese Leggings passen nur Elfen.")); 
  
  AddDetail(({"symbole", "symbol"}),
	    "Symbole wie sie die Elfen oft auf Kleidungstuecke sticken.");
  
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, MAT_LEATHER);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 50);
  SetProp(P_NOBUY, 0);

  SetProp(P_WEAR_RESTRICTIONS, 
	  ([SR_INCLUDE_RACE: ({"Elf","Dunkelelf","Mensch"})]));
}
