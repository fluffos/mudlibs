#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Duenne Lederhandschuhe");
  SetProp(P_LONG, 
	  BS("Diese duennen Lederhandschuhe sind aus dem weichen Leder "
	     "eines Rehs gefertigt. Sicher koennen sie die zarten Haende "
	     "eines Elfs gut schuetzen."));

  SetProp(P_INFO, 
	  BS("Nur die Haende von Elfen sind schlank genug um in diese "
	     "Handschuhe zu passen."));

  SetProp(P_NAME, "Lederhandschuhe");
  SetProp(P_NAME_ADJ, "duenn");
  AddAdjective(({"duenne", "duenn"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId(({"lederhandschuhe", "handschuhe"}));

  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, MAT_LEATHER);
  SetProp(P_WEIGHT, 80);
  SetProp(P_VALUE, 30);

  SetProp(P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE: ({"Elf", "Dunkelelf"})]));
}

