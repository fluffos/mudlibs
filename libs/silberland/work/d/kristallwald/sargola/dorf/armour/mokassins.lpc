#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Lederne Mokassins");
  SetProp(P_LONG, 
	  BS("Diese Mokassins sind aus feinem Leder gefertigt und mit "
	     "bunten Perlen verziert. Sicher ist jeder Elf stolz darauf, "
	     "so ein Schuhwerk zu besitzen."));

  SetProp(P_INFO, 
	  BS("Diese Mokassins sind perfekt an die Fuesse von Elfen "
	     "angepasst."));

  SetProp(P_NAME, "Mokassins");
  SetProp(P_NAME_ADJ, "ledern");
  AddAdjective(({"lederne","ledernen","lederner"}));

  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId(({"mokassins"}));

  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, MAT_LEATHER);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 40);

  SetProp(P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE: ({"Elf", "Dunkelelf"})]));
}

