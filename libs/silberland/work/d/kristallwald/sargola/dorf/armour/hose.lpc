/*
** Eine Hose fuer Elfen-Anfaenger
** Eine 'mini'-Version der Bauschhose aus dem Dschungelelfendorf
**
**  2002-08-27  PROtheG  Die Anfaenger bekommen neben dem Hemd auch eine Hose.
*/

#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  AddId(({"elfenhose","hose","bauschhose"}));

  SetProp(P_SHORT, "Eine kleine Bauschhose");

  SetProp(P_LONG,
	  BS("Diese Hose ist aus Bausch gefertigt und fuer die Proportionen "
	     "eines sehr jungen Elfen geschneidert."));

  SetProp(P_NAME, "Bauschhose");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 10);

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);  // siehe sys/combat.h
  SetProp(P_AC, 3);

  SetProp(P_MATERIAL, MAT_BAUSCH);
  SetProp(P_WEAR_RESTRICTIONS, 
	  ([SR_INCLUDE_RACE: ({"Elf","Dunkelelf","Mensch"}), SR_MAX_LEVEL:5]));
  
  AddProp(P_DAM_PROTECTION, ([DT_WATER:1]));
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:0, T_HEAT_PROT:1]));

  AddDetail(({"bausch"}),
	    "Bausch, wie ihn nur die Elfen verwenden.");
}
