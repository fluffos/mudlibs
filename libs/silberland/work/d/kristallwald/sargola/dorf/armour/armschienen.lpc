#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Lederne Armschienen");
  SetProp(P_LONG, 
	  BS("Diese Armschienen aus Leder schuetzen die Unterarme "
	     "vor Schaden."));
  SetProp(P_NAME, "Armschienen");
  SetProp(P_NAME_ADJ, "ledern");
  AddAdjective(({"lederne","ledernen"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId(({"armschienen", "lederarmschienen"}));

  SetProp(P_INFO, 
	  BS("Diese Armschienen scheinen nur Elfen zu passen.")); 

  AddDetail(({"leder", "hirschleder"}),
	    "Bei dem Leder handelt es sich um strapazierfaehiges "
	    "Hirschleder.");
  
  SetProp(P_ARMOUR_TYPE, AT_BRACERS); 
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_LEATHER);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 350);

  SetProp(P_WEAR_RESTRICTIONS, 
	  ([SR_INCLUDE_RACE: ({"Elf","Dunkelelf","Drider", "Mensch"})]));
}
