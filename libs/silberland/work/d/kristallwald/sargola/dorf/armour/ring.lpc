#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Kristallring");
  SetProp(P_LONG, 
	  BS("Dieser Ring besteht aus natuerlichem Kristall und wurde von "
	     "den Elfen auf wunderbare Weise bearbeitet. Er glaenzt in "
	     "allen Regenbogenfarben, man koennte fast meinen, er sei "
	     "magisch."));

  SetProp(P_NAME, "Kristallring");
  SetProp(P_GENDER, MALE);
  AddId(({"ring", "kristallring"}));
  SetProp(P_INFO, 
	  BS("Dieser Ring ist so schmal, dass er wohl nur auf die "
	     "schlanken Finger eines Elfen passt.")); 

  AddDetail("regenbogenfarben",
	    "Der Ring glaenzt in allen Regenbogenfarben. Er ist einfach "
	    "wunderschoen.");
      
  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, MAT_MISC_JEWEL);
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 300);

  SetProp(P_WEAR_RESTRICTIONS, 
	  ([SR_INCLUDE_RACE: ({"Elf","Dunkelelf","Fee"}) ]) );
}
