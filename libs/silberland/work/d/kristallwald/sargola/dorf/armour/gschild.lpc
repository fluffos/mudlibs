/*
  Ein Goblinschild
*/

#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  AddId(({"schild","goblinschild"}));
  SetProp(P_SHORT, "Ein Goblinschild");
  SetProp(P_LONG, 
	  BS("Der Schild gehoerte einmal einem Goblin. Er scheint aus "
	     "massivem Eisen zu bestehen."));

  SetProp(P_NAME, "Goblinschild");
  SetProp(P_GENDER, MALE);

  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 600);
  SetProp(P_SIZE, 40);

  SetProp(P_ARMOUR_TYPE, AT_SHIELD);
  SetProp(P_AC, 16);
  SetProp(P_MATERIAL, MAT_IRON);

  AddDetail("goblin",
	    "Der wird hoechstwahrscheinlich tot sein...");
  AddDetail("eisen",
	    "Eisen, wie Du es schon oft gesehen hast.");
}
 
