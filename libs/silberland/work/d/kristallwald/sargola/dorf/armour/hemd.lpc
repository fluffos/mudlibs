#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  AddId (({"elfenhemd","hemd"}));

  SetProp(P_SHORT, "Ein elfisches Hemd");

  SetProp(P_LONG,
	  BS("Das Hemd ist aus weissem, leichtem Stoff und bietet kaum "
	     "Schutz vor Hieben."));
  SetProp(P_NAME, "Elfenhemd");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 10);

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);  // siehe sys/combat.h
  SetProp(P_AC, 10);

  SetProp(P_MATERIAL, MAT_CLOTH);
  SetProp(P_WEAR_RESTRICTIONS, 
	  ([SR_INCLUDE_RACE: ({"Elf","Dunkelelf","Mensch"}), SR_MAX_LEVEL:5]));
  
  AddDetail(({"leinen","stoff"}), 
	    "Das Hemd ist aus leichten Leinen.");
}
