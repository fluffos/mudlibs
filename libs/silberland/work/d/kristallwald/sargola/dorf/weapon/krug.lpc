/*
**  Xelindos Krug
**
**  2002-05-31  PROtheG  Xelindo kriegt auch eine Waffe
*/

#include "../def.h"

inherit "std/weapon";

void create() 
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein massiver Weinkrug");
  SetProp(P_LONG,
	  BS("Das ist ein massiver Weinkrug, in dem Xelindo in seiner Kneipe "
	     "in Elessar seinen Gluehwein ausschenkt. Er fasst ungefaehr "
	     "einen halben Liter und hat einen schoen geschwungenen Henkel "
	     "an der Seite."));
  SetProp(P_INFO, 
	  BS("Unter Umstaenden kann man den Weinkrug auch zum Pruegeln "
	     "verwenden."));
  SetProp(P_NAME, "Weinkrug");
  SetProp(P_GENDER, MALE);

  AddId(({"krug", "weinkrug"}));

  SetProp(P_NAME_ADJ, ({"massiv"}));
  AddAdjective(({"massiver","massiven"}));
  
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 80);
  SetProp(P_WC_FIX, 25);
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ({MAT_CERAMIC}));
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE, 20);
  SetProp(P_VALUE, 50);
  SetProp(P_QUALITY_DECAY, 20);
  
  SetProp(P_HIT_FUNC, TO);

  SetProp(P_WC_BONUS, (["xelindo":150]));

  SetProp(P_WIELD_RESTRICTIONS, ([A_CON:3]));
}

int HitFunc(object enemy)
{
  if(random(1000)==666)
    call_out("zerbroeckeln", 0);
  
  return 0;
}

void zerbroeckeln()
{
  object pl;

  if(pl=QueryProp(P_WIELDED))
    tell_object(pl, 
		BS("Ploetzlich zerbroeckelt Dir der Weinkrug in Deinen "
		   "Haenden!"));
  
  SetProp(P_CURSED, 0);
  DoUnwield(1);
  call_out("remove", 0, 1);
}
