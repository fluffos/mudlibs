#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO))  return;
  ::create();

  SetProp(P_SHORT, "Ein elfischer Jagdbogen");
  SetProp(P_LONG, 
	  BS("Dieser Jagdbogen wird von Elfen verwendet, die sich auf "
	     "den weiten Weg in die Wildnis wagen. Man kann damit fast "
	     "jedes wilde Tier erlegen. Der Bogen ist aus den Hoernern "
	     "des Kristallbocks gefertigt."));

  SetProp(P_INFO, 
	  BS("Nur Elfen beherrschen den Umgang mit einem Bogen."));
  SetProp(P_NAME, "Jagdbogen");
  SetProp(P_GENDER, MALE);
  AddId(({"jagdbogen", "bogen"}));

  SetProp(P_WEAPON_TYPE, WT_BOW);
  SetProp(P_WC, 100+random(10));
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ({MAT_HORN, MAT_QUARTZ}));
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 300);

  SetProp(P_WC_BONUS, (["elfenwaechterin":90,
			"elfenwaechter":90]));
  SetProp(P_WIELD_RESTRICTIONS, 
	  ([SR_INCLUDE_RACE: ({"Elf","Dunkelelf"}), A_DEX: 5,A_STR: 5]));
}

