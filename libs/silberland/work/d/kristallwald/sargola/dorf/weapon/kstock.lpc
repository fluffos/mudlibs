#include "../def.h"

inherit "std/weapon";

void create()      
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"krueckstock","stock"}));
  SetProp(P_SHORT, "Ein langer Stock");
  SetProp(P_LONG, 
	  BS("Der Stock scheint wegen seines silbernen Knaufes recht wertvoll "
	     "zu sein. Der Knopf hat die Form eines Adlers."));
  SetProp(P_NAME, "Stock");
  SetProp(P_GENDER, MALE); 
  SetProp(P_WEIGHT, 950);
  SetProp(P_VALUE, 900);
  SetProp(P_NOBUY, 1);
  SetProp(P_SIZE, 150);

  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 90);


  AddDetail(({"knauf", "knopf", "form"}),
	    "Er ist aus silber und sicher sehr wertvoll. Der Knauf "
	    "hat die Form eines Adlers.");

  AddDetail("adler",
	    "Es ist ein maechtiger Adler mit ausgebreiteten Schwingen.");

  AddDetail(({"adlerschwingen","schwingen"}),
	    "Sie sind so geformt, dass man den Stock gut halten kann.");
  
  SetProp(P_MATERIAL, ([MAT_OAK:90, MAT_SILVER:10]));
}  
