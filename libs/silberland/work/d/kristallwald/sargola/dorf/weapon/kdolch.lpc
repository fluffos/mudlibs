#include "../def.h" 
 
inherit "std/weapon"; 
 
void create()       
{    
  if(!is_clone(ME)) return; 
  ::create(); 
  
  AddId (({"\kdolch","dolch", "kristalldolch"})); 
  SetProp(P_SHORT, "Ein Kristalldolch"); 
  SetProp(P_LONG, 
	  BS("Ein weisser Dolch aus Quarz oder aehnlichem Material.")); 
  SetProp(P_NAME, "Kristalldolch");
  SetProp(P_GENDER, MALE);  
  SetProp(P_WEIGHT, 650); 
  SetProp(P_SIZE, 25);
  SetProp(P_VALUE, 400); 
  //SetProp (P_NOBUY, 1);    
  SetProp(P_MATERIAL, ({MAT_QUARTZ})); 
  SetProp(P_WEAPON_TYPE, WT_KNIFE); 
  SetProp(P_DAM_TYPE, DT_PIERCE); 
  SetProp(P_WC, 70); 
  SetProp(P_WC_BONUS, (["elfenwaechter":100]));
  SetProp(P_NR_HANDS, 1); 
}   
