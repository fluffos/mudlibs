#include "../def.h" 
 
inherit "std/weapon"; 

void create()       
{    
  if(!is_clone(ME)) return; 
  ::create();
  
  AddId(({"elfenmesser","messer"})); 
  SetProp(P_SHORT, "Ein elfisches Messer"); 
  SetProp(P_LONG, 
	  BS("Ein gewoehnliches Messer fuer Elfen. Das erkennst Du an "
	     "der gebogenen Form.")); 
  SetProp(P_NAME, "Elfenmesser"); 
  SetProp(P_GENDER, NEUTER);  
  AddDetail("form",
	    "Die Form von des Messers ist eigenartig gebogen. Damit "
	    "koennen die Elfen das Messer besser fuehren.");
  SetProp(P_WEIGHT, 450); 
  SetProp(P_SIZE, 20);
  SetProp(P_VALUE, 2); 
  SetProp(P_MATERIAL, ({MAT_IRON})); 
  SetProp(P_WEAPON_TYPE, WT_KNIFE); 
  SetProp(P_DAM_TYPE, DT_PIERCE); 
  SetProp(P_WC, 60); 
  SetProp(P_NR_HANDS, 1); 
  SetProp(P_WIELD_RESTRICTIONS, 
	  ([SR_INCLUDE_RACE:({"Elf","Dunkelelf"}), SR_MAX_LEVEL:5]));
  SetProp(P_HIT_FUNC, ME);
}   

int HitFunc(object enemy)
{
  if(enemy->QueryProp(P_LEVEL)<5)
    return random(20);
}

