#include "../def.h"

inherit "std/weapon"; 
 
void create() 
{ 
  if(!is_clone(ME)) return; 
  ::create(); 
  
  SetProp(P_SHORT,"Ein Goblinsaebel"); 
  SetProp(P_LONG, 
	  BS("Der Saebel ist so lang wie ein gestreckter Arm und seine "
	     "Klinge ist abgenutzt und stumpf. Der Saebel ist wohl schon "
	     "oft benuetzt worden."));
 
  SetProp(P_NAME, "Goblinsaebel"); 
  AddId(({"saebel","goblinsaebel"})); 
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, MALE); 

  SetProp(P_MATERIAL, ([MAT_STEEL:99, MAT_BLOOD:1]));
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 300);
  SetProp(P_SIZE, 75);

  SetProp(P_WEAPON_TYPE, WT_SWORD); 
  SetProp(P_WC, 121);
  SetProp(P_WC_BONUS, (["goblin":100]));
  
  SetProp(P_DAM_TYPE, DT_SLASH);
  SetProp(P_NR_HANDS, 1);

  AddDetail(({"klinge"}),
	    "Die Klinge ist schon sehr stumpf!\n");
}
 
