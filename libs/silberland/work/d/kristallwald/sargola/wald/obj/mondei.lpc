#include "../def.h"

inherit "std/thing";

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Mondsteinei");
  SetProp(P_LONG,
	  "Ein rundes Mondsteinei, das im Inneren blaeulich schimmert.\n");
  SetProp(P_NAME, "Mondsteinei");
  SetProp(P_INFO, 
	  BS("Das Mondsteinei ist sehr geheimnisvoll. Ob Du je das Raetsel "
	     "loesen wirst, das auf diesem Ei liegt?"));
  AddId(({"mondsteinei", "ei"}));
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 900);
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_JEWEL);
  SetProp(P_NOBUY, 1);
}


