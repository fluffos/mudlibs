//#pragma strong_types

inherit "std/food";
#include <properties.h>
#include <food.h>



void create()
{
   if (!is_clone(this_object())) return;
   ::create();

   SetProp(P_SHORT, "Ein Opalei");
   SetProp(P_LONG,
      "Ein Ei aus Opal, das im Inneren blaeulich schimmert.\n");
   SetProp(P_NAME, "Opalei");
   AddId(({"ei", "opal", "opalei"}));
   SetProp(P_WEIGHT, 100);
   SetProp(P_VALUE, 1500);
   SetProp(P_FOOD_INFO, ([F_HEAL : ({0, 0}), F_SOAK : 0]));
}
void BeimEssen()
{
   write("So ein Ei aus Stein solltest Du nicht essen.\n");
   say(this_player()->name()+" versucht ein Ei aus Stein zu essen.\n");
}

