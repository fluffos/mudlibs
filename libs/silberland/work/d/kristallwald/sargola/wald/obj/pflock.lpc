#include "../def.h"

inherit "std/thing";

nosave string owner;

void create()
{
   if(!is_clone(ME)) return;
   ::create();

   SetProp(P_SHORT, "Ein Pflock");
   SetProp(P_LONG, 
	   BS("Dies ist ein Holzpflock aus gewoehnlichem Holz. Normalerweise "
	      "ist das nichts Besonderes, aber hier doch eine Seltenheit. "
	      "Er ist aus einem speziellen, magieresistenten Material."));

   AddDetail("material", 
	     BS("Das Holz des Pflockes ist offensichtlich immun "
		"gegen den Kristallspruch."));

   SetProp(P_NAME, "Pflock");

   AddId(({"eesthilpflock","\nsalinapflock","pflock","holzpflock"}));

   SetProp(P_GENDER, MALE);
   SetProp(P_VALUE, 25);
   SetProp(P_WEIGHT, 300);

   SetProp(P_NOBUY, 1);
   SetProp(P_NOSELL, "Und was ist mit Eesthil?!\n");

   SetProp(P_MATERIAL, MAT_MISC_WOOD);
   SetProp(P_MAGIC, 1);
}


public int set_owner(string arg)
{
  if(!stringp(owner))
    {
      owner = arg;
      return 1;
    }
  
  return 0;
}

public string query_owner()
{
  return owner;
} 
