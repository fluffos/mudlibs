/*
**  Rindenstaub - ist fuer nix gut
** 
**  2002-04-16  PROtheG  Neuueberarbeitet
**  2002-05-14  PROtheG  Schnupfen ;)
*/

nosave int counter;

#include "../def.h"
#include <food.h>

inherit "std/food";

void create()
{
   if(!is_clone(ME)) return;
   ::create(({"schnupf","schnupfe"}));

   SetProp(P_SHORT, "Ein Haufen Rindenstaub");
   SetProp(P_LONG,
	   BS("Ein Haufen Rindenstaub, so in etwa 90 Gramm."));

   SetProp(P_NAME, "Rindenstaub");
   AddId(({"rindenstaub", "staub"}));
   
   SetProp(P_MATERIAL, MAT_MISC_WOOD);
   SetProp(P_GENDER, MALE);
   SetProp(P_WEIGHT, 90);
   SetProp(P_VALUE, 30);
   SetProp(P_NOBUY, 1);
   SetProp(P_MAGIC, 1);
   
   SetProp(P_FOOD_INFO, ([F_HEAL:({1,15}), F_SOAK:3, F_VERB:"schnupfen",
   F_MSG:BS("Du portionierst den Rindenstaub professionell auf Deinem "
	    "Zeigefinger und ziehst ihn Dir mit einem Zug tief in die "
	    "Nase hinein..."),
   F_MSG_ROOM:"zieht sich gekonnt eine Strasse Rindenstaub...\n"]));

   counter=0;
}

void BeimEssen()
{
  TP->command_me("rufe I am the greeeeat Cornholio!");
}

void reset()
{
  ::reset();

  counter++;
  
  if(counter > 5+random(3))
    call_out("remove", 0);
}
