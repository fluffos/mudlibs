#include "../def.h"

inherit "std/weapon";

//#include "/d/kristallwald/sargola/def_kristall.h"

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"degen", "kristalldegen"}));

  SetProp(P_SHORT, "Ein prunkvoll verzierter Degen");
  SetProp(P_LONG, 
	  BS("Dieser Degen ist eine mit Edelsteinen verzierte, prunkvolle "
	     "Waffe, mit einer schlanken, geraden Klinge."));
  SetProp(P_NAME, "Kristalldegen");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 2500);
  SetProp(P_WEIGHT, 1750);
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_WC, 180);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, 
	  ([MAT_MISC_METAL:80, MAT_OPAL:5, MAT_DIAMOND:5, MAT_MISC_JEWEL:10]));
  SetProp(P_QUALITY_DECAY, 1000);

  AddDetail(({ "stein","edelsteine","steine", "edelstein"}), 
	    "Du erkennst Opale, Mondsteine, Diamanten und andere wertvolle "
	    "Steine.");
  
  AddDetail("klinge", 
	    "Sie besteht zur Gaenze aus kristallinem Metall und ist bestimmt "
	    "sehr gefaehrlich.");
}

