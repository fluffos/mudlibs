#include "../def.h"

inherit "std/thing";

void create()      
{    
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"blatt","blaetter","blaetterhaufen","haufen"})) ;
  SetProp(P_SHORT, "Ein Blaetterhaufen");
  SetProp(P_LONG, 
	  BS("Ein Haufen Blaetter von der grossen Eiche im "
	     "Nordwesten des Kristallwaldes."));
  SetProp(P_NAME, "Blaetterhaufen");
  SetProp(P_GENDER, MALE); 

  SetProp(P_MATERIAL, MAT_MISC_HERBAL);
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
} 
