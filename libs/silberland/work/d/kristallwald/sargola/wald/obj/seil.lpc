#pragma strict_types

#include "../def.h"

inherit "std/thing";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  AddId(({"Seil", "kristallseil", "seil"}));
  
  SetProp(P_SHORT, "Ein Kristallseil");
  SetProp(P_LONG,
	  BS("Ein Seil, welches zwar einen kristallinen Glanz aufweist, "
	     "sich aber schoen verknuepfen laesst..."));
  SetProp(P_NAME, "Seil");
  
  SetProp(P_GENDER, NEUTER);
  SetProp(P_VALUE, 35);
  SetProp(P_WEIGHT, 300);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, "Aber das Kristallseil gehoert doch Salina!\n");

}
