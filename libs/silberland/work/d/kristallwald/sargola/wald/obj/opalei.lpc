#include "../def.h"
#include <food.h>

inherit "std/food";

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Opalei");
  SetProp(P_LONG,
	  BS("Ein Ei aus Opal, das im Inneren blaeulich schimmert."));
  SetProp(P_NAME, "Opalei");
  AddId(({"ei", "opalei"}));

  SetProp(P_MATERIAL, MAT_JEWEL);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 1500);
  SetProp(P_NOBUY, 1);
  SetProp(P_FOOD_INFO, 
	  ([F_HEAL:({0, 0}), 
	    F_SOAK:5,
	    F_MSG:"So ein Ei aus Stein solltest Du besser nicht essen.\n",
	    F_MSG_ROOM:"wuergt ein Opalei hinunter.\n"]));
}
