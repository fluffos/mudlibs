#include "../def.h"

inherit "std/thing";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, 0);
  AddId(({"\neesthilquest"}));
  SetProp(P_NEVERDROP,1);
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
}

void reset()
{
  if(!is_clone(ME)) return;
  ::reset();
  
  if(!MENV) call_out("remove");
}
