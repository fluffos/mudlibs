#include "../def.h"

inherit "std/armour";

void create()      
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"fell","fuchsfell","schwarzfuchsfell","\nfell_is_gerb_able"}));
  SetProp(P_SHORT, "Das Fell eines Schwarzfuchses");
  SetProp(P_LONG, 
	  BS("Das ist ein schoenes, makelloses Fuchsfell. Es ist tiefschwarz "
	     "und von silbernen Faeden und Streifen durchwoben."));
  SetProp(P_NAME, "Fuchsfell");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 1);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_PELT:90, MAT_ONYX:10]));
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:3, T_HEAT_PROT:-3]));
  SetProp(P_INFO, 
	  BS("Du kannst nichts neues herausfinden."));

  AddDetail(({"faden","faeden","silberfaden","silberfaeden"}),
	    "Das Fell ist mit zahlreichen silbrigglaenzenden Faeden "
	    "durchzogen.");

  AddDetail(({"streifen","silberstreifen"}),
	    "Das Fell weist schoene, silbrige Streifen auf...");
} 

