inherit "std/armour";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/sargola/def_kristall.h"


      create()
      {
        if (!is_clone(this_object()))
           return;
        ::create();
     
        AddId (({"tigeraugenrobe","robe"}));
       SetProp (P_SHORT, "Eine Tigeraugenrobe");

       SetProp (P_LONG, BS("Dies ist eine klassische Robe, wie sie Magier des Kristallwaldes zu tagen pflegen. 
Sie ist braenliche mit hellen Flecken und verleiht dem Traeger ein machtvolles Aussehen.\n"));
      SetProp (P_NAME, "Tigeraugenrobe");
        SetProp (P_GENDER, FEMALE);
        SetProp (P_WEIGHT, 200);
        SetProp (P_VALUE, 4000);
        SetProp (P_NOBUY, 1);
        SetProp (P_ARMOUR_TYPE, AT_CLOAK);      // AT_RING
        SetProp (P_AC, 5);
//   SetProp (P_KILL_NAME, "     ");
//   SetProp (P_KILL_MSG, "     \n");
        SetProp (P_MATERIAL, ({MAT_CLOTH }));    //MAT_GLASS
        SetProp(P_INFO, BS("Die Tigeraugenrobe hilft Dir bei Gegner, die das Element des Feuers gegen Dich 
verwenden. \n"));
        AddDetail ("magier", BS("Jawohl! Sargola ist einer von ihnen...\n"));
        AddDetail ("traeger", BS("Wer wuerde nicht gern der stolze Traeger dieser Robe sein?\n"));
    

   }

