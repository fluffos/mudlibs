//#pragma strong_types

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/kristallwald/sargola/def_kristall.h"		

void create()
{
  ::create();
  

  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Der Kristallwald" );
  SetProp( P_INT_LONG, BS("Du stehst mitten im Kristallwald. Neben Dir ragen ueberall "
		+"starke Staemme in die Hoehe und Straeucher erschweren Dir das Fortkommen. "
		+"Pass auf, dass Du Dich hier nicht verlaeufst!\n") );

  SetProp(P_INDOORS,0);
  
  AddSound(DEFAULT_SOUND,"Du hoerst das Klingen der Blaetter im Wind.");
  AddSound (({"singen", "blaetter", "blatt","klingen"}), BS("Die Blaetter schwingen sanft mit "
		+"dem Wind und verursachen dadurch ein leises Singen.\n"));

  AddSmell (DEFAULT_SMELL, BS("Es riecht hier nach - eigentlich nach nichts!\n"));

  AddDetail( "boden",BS( "Der Boden ist mit Graesern ueberzogen, die leise knirschen, wenn Du"
	+"sie zertrittst. Weiters entdeckst Du Blaetter, Zweige und kristallines Gestein."));
  AddDetail( "himmel",BS( "Hie und da scheint das Blau des Himmels durch. Meist jedoch wird"
	+"es von den Aesten verdeckt. Durch die Loecher faellt das Licht wie Saeulen auf "
	+"den Boden.\n"));
  AddDetail( "blau",BS( "Es ist aber nicht immer blau - durch Wolken scheint es manchmal"
	+"eher weiss durch.\n"));
  AddDetail( ({"wolke","wolken"}),BS( "Genaueres kannst Du von hier nicht ersehen.\n"));
  AddDetail( ({"loch","loecher"}),BS( "Obwohl der Wald hier sehr dich ist, gibt es doch"
	+"kleine Durchlaesse.\n"));
  AddDetail( ({"durchlass","durchlaesse"}),BS( "Hier dringt das Licht bis auf den Boden "
	+"durch.\n"));
  AddDetail( "weg",BS( "Von einem Weg kann man eigentlich nicht sprechen. In alle Himmels"
	+"richtungen fuehren hier die Wege.\n"));
  AddDetail( ({"saeule","saeulen"}),BS( "Weisse Lichtkegel, die sehr unterschiedliche"
	+" Durchmesser haben.\n"));
  AddDetail( ({"kegel","lichtkegel"}),BS( "Es wirkt schoen hier, in dieser mystisch "
	+"erleuchteten Gegend.\n"));
  AddDetail( "gegend",BS( "Na der Kristallwald!\n"));
  AddDetail( "durchmesser",BS( "Manchmal sind die Kegel so stark wie ein Tisches, manchmal "
	+"aber so duenn wie ein glaeserner Dolch, der sich in den Boden rammt.\n"));
  AddDetail( ({"tisch","tische"}),BS( "So ein bis 2 Meter halt.\n"));
  AddDetail( ({"dolch","dolche"}),BS( "Es sieht aus, als wuerden sie direkt vom Himmel"
	+"hier in den Boden schiessen...\n"));
  AddDetail( ({"strauch","straeucher"}),BS( "Die stehen hier ueberall herum und versperren"
	+"dir den Weg.\n"));
  AddDetail( "fortkommen",BS( "Dein Erkundungsgang durch den Wald ist damit gemeint.\n"));
  AddDetail( ({"gras","graeser"}),BS( "Es ist die Sorte von Gras, mit der man so schoen Hahn " 
	+"und Henne spielen kann.\n"));
  AddDetail( ({"hahn","henne", "hahn und henne"}),BS( "Du nimmst ein Gras, ziehst es so "
	+"zwischen Deinen Fingern durch und schaust dann, ob es eine runde Kuppe geworden ist."
	+" Dann ist es Henne, wenn es einen Schweif hat, ist es Hahn. Probier es doch "
	+"einmal.\n"));
  AddDetail("erkundungsgang", BS("Damit ist wohl dein Erkundungsgang durch den Kristallwald "
  	+"gemeint.\n"));
  AddDetail("himmelsrichtungen",BS("Das sind: Norden, Sueden, Osten und Westen.\n"));
  AddDetail( ({"finger","finger"}),BS( "Du musst sie zusammenpressen, sonst wird das nix.\n"));
  AddDetail( ({"kuppe","schweif"}),BS( "Wenn Du es nicht ausprobierst, wirst Du auch keine"
	+"Kuppe und keinen Schweif sehen!\n"));
  AddDetail( ({"blatt","blaetter"}),BS( "Abgefallene Blaetter, weiter nichts.\n"));
  AddDetail( ({"zweige","zweig"}),BS( "Kleinere Zweige liegen auch vereinzelt herum.\n"));
  AddDetail( ({"wald","stamm","staemme"}),BS( "Du siehst den Wald vor lauter Staemmen nicht mehr - "
	+" oder irgendwie so heisst das doch...\n"));
  AddDetail( "hoehe",BS( "Die Staemme sind gut und gern 10 Meter hoch.\n"));
  AddDetail( ({"",""}),BS( "\n"));
  AddDetail( ({"",""}),BS( "\n"));





  AddCmd( ({ "springe" }), "springe" ); 
  AddCmd( ({ "greife" }), "greife" ); 
  AddCmd( ({ "benutz", "benutze"}), "benutze");
  AddCmd( ({ "knuepf", "knuepfe"}), "knuepfe");



    AddExit ("osten",ROOM_WALD+"0903.lpc");
    AddExit("norden",ROOM_WALD+"0802.lpc");
    AddExit("westen",ROOM_WALD,"0703.lpc");
    AddExit("nordosten",ROOM_WALD,"0902.lpc");
    AddExit("suedosten",ROOM_WALD, "0904.lpc");
    AddExit("sueden",ROOM_WALD,"0804.lpc");

}  



int greife (string str)
{
	notify_fail ("Wonach willst Du denn greifen?\n");
	if (!str) return 0;

	if (str=="nach ast"||str=="ast")
	{
		write ("Der Ast ist zu weit weg um ihn anzugreifen!\n");
		say(this_player()->name(WER,2)+" kommt nicht an den Ast ran.\n");
		return 1;
	}
	return 0;
}

int springe( string str)
{
	notify_fail( "Wohin willst Du denn springen?\n" );
	if (!str) return 0;

	if( str == "auf baum" || str == "baum")
	{	

		write ("Du kannst nicht auf den Baum springen! Du erreichst ja nicht mal der ersten Ast!\n");
		say(this_player()->name(WER,2)+" versucht ohne Erfolg auf den Baum zu springen.\n");
		
		return 1;
	}

	if (str =="auf ast" || str =="ast")
	{
		write ("Du kannst nicht auf den Ast springen! Der ist doch zu hoch! Vielleicht kannst Du Dich 
ja irgendwie raufziehen...\n");
		say(this_player()->name(WER,2)+" versucht auf den Ast zu springen - wie lustig!\n");	
	
		return 1;
	}
	
	if (str =="nach ast")
	{
		write ("Du kannst nicht bis zum Ast. Hmmm, was braucht man in so einem Fall?\n");	
	
		say(this_player()->name(WER,2)+" springt vergeblich in die Luft.\n");		
		return 1;
	}
	return 0;
}

int knuepfe (string str)
{
	notify_fail ("WAS willst Du denn WORAN knuepfen?\n");
	if (!str) return 0;


	//*******************
	//Yep - er hat ein seil
	//*******************
	if (present("seil", TP) )
	{ 
		//********************
		// Yep - richtiger string
		//********************
		if (str =="seil an ast" || str =="seil auf ast")
		{
			write (break_string("Du wirfst das Seil auf den Ast und verknotest es fest. Nun ist es 
ein leichtes fuer Dich, raufzuklettern. Das Seil nimmst Du sicherheitshalber mit - man weiss ja nie...",78));
			say (break_string(this_player()->name(WER,2)+"wirft das Seil um den Ast, verknotet 
es und klettert ohne Probleme rauf. Du siehst, wie "+this_player()->Name(WER,2)+" das Seil oben wieder 
loest.",78));
			this_player()->move(ROOM_WALD+"1_0803.lpc",M_GO, "nach oben", "kommt von 
unter herauf");
			return 1;
		}
		else
		{
			write ("Woran willst Du das Seil knuepfen?\n");
			//say(this_player()->name(WER,2)" weiss nicht genau, woran man so ein Seil 
knuepft...\n");
			return 1;
		}
	}
	else
	{
		write ("Du hast ja nichts, womit man raufklettern koennte.\n");
		say (this_player()->name(WER,2)+" hat nichts, womit man raufklettern koennte.\n");
		return 1;
	}
	return 0;
}

int benutze (string str)
{
	notify_fail ("WAS willst Du denn WOMIT benutzen?\n");
	if (!str) return 0;

	write ("Ein Seil kann man sooo schoen verknuepfen...\n");
	say ("Ein Seil kann man sooo schoen verknuepfen...");
	return 1;	
}



