inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/kristallwald/sargola/def_kristall.h"

int kiste_voll;

oeffne(string str);
knacke(string str);
brich(string str);
sperr(string str);


      create()
      {
        ::create();
       kiste_voll = 1;
        SetProp( P_INT_SHORT, "Eine schmutzige und unordentliche Huette" );
        SetProp( P_INT_LONG, 
      BS("Es ist recht dunkel hier, das Licht dringt spaerlich durch die "
         +"Tuer. Trotzdem kannst Du die Unordnung erkennen. Waffen, Esse"
         +"nsreste und Beutestuecke liegen ueberall verteilt.") );
     
        SetProp( P_LIGHT, 1 );
        SetProp( P_INDOORS, 1 );
	AddDetail("boden", BS("Der ist notduerftig mit ein paar Holzplanke aus"
		+"gelegt. Meistens ist er ohnehin mit allerhand Beutestuecken "
		+"bedeckt."));
	AddDetail( ({"wand","waende"}),
		BS("Die Waende sind aus Holzplanken gezimmert."));
	AddDetail( ({"planken","holzplanken","planke","holzplanke"}), BS("Sie sind nur auf den "
		+"nackten Boden gelegt und wackeln beim Gehen."));
	AddDetail("decke", BS("Die Decke ist, wie alles hier, aus schlecht gezimmer"
		+"ten Planken gemacht."));
	AddDetail("geraffel", BS("Naja, nichts, was Du brauchen koenntest..."));
	AddDetail("ordnung", BS("Genau die siehst Du hier nicht!"));
	AddDetail( ({"verstrebungen","eisenverstrebungen"}), BS("Sie verstreben die Kiste "
		+"derartig, dass Du sie sicher nicht mit roher Gewalt aufbrechen kannst."));
        AddDetail( "licht", BS("Das Licht scheint von der Tuere her und "
           +"erhellt den Raum."));
        AddDetail( ({"tuere","tuer"}),BS("Die liegt im Norden und fuehrt aus "
           +"dem Saustall hier raus."));
        AddDetail( ({"zeugs","waffen","essensreste","beutestuecke"}), BS("Allerhand "
           +"Geraffel liegt hier herum - aber alles wertloses Zeugs."));
        AddDetail( "unordnung",BS("Alles liegt am Boden verteilt und ohne eine "
           +"offensichtliche Ordnung. Dir faellt eine Kiste auf."));
        AddDetail( "kiste",BS("Die Kiste scheint aus robustem Holz mit Eisenver"
           +"strebungen zu sein. Auf der Vorderseite befindet sich ein "
           +"stabiles, grosses Schloss. Probier doch mal, sie zu "
           +"oeffnen!"));
        AddDetail("holz", BS("Das Holz ist leider nirgends morsch."));
	AddDetail("schloss", BS("Scharf folgerst Du: Da muss ein Schluessel rein!!"));
	AddDetail("schluessel", BS("Tja! So leicht ist es nun auch wieder nicht..."));
	AddDetail("vorderseite", BS("Das ist die vordere Seite der Kiste."));
        AddDetail( "saustall",BS("Anders kann man das nicht bezeichnen!"));
        
        AddCmd( "oeffne", "oeffne");
        AddCmd( ({"knacke","knack"}), "knacke");
        AddCmd( ({"breche","brich"}), "brich");
        AddCmd( ({"sperre", "sperr", "schliesse", "steck","stecke"}), "sperr");
        AddExit( "raus", ROOM_DORF+"1315.lpc" );

      }

oeffne(string str)
{
   notify_fail("Was moechtest Du oeffnen?\n");
   if(!str) return 0;
   
   if(str=="kiste"||str=="kiste auf")
   {
      if(!present("\nquestschluessel", TP))
      {
          write(BS("Du versuchst mit aller Kraft den Deckel zu heben - "
         +"aber er ruehrt sich keinen Millimeter! Vielleicht "
         +"gibt es ja einen Schluessel zum Aufsperren..."));
           return 1;
       }
       else
      {
         write(BS("Du kannst auch nach dem Aufbieten aller "
            +"Deiner Kraefte die Kiste nicht aufbringen. "
            +"Sperr die Kiste doch einfach auf!"));
         return 1;
      }
   }
   
   return 0;
}

knacke (string str)
{
   notify_fail("Was moechtest Du knacken?\n");
   if (!str) return 0;
   
   if(str=="kiste")
   {
      write(BS("Du hast doch nichts, womit man Kisten knacken "
         +"koennte...Haettest Du bloss den Schluessel..."));
      return 1;
   }
   return 0;
}

brich(string str)
{
   notify_fail("Was moechtest Du denn aufbrechen?\n");
   if(!str) return 0;
   
   if(str=="kiste"||str=="kiste auf")
   {
      write(BS("Du hebelst mit allem, was Du hast, doch der Deckel "
         +"sitzt fest. Ein Schluessel koennte Dir helfen..."));
      return 1;
   }
   return 0;
}


sperr(string str)
{
   object money;
   notify_fail("Was moechtest Du denn aufsperren?\n");
   if(!str) return 0;
   
   if(str=="kiste"||str=="kiste auf"||str=="schluessel in schloss"||str=="schluessel in das schloss")
   {
      if(deep_present("\nquestschluessel",TP))
      {
      
      if(kiste_voll ==1)
      {
      write(BS("Du nimmst den Schluessel, und siehe da: er passt "
         +"genau! Du findest einen Dolch und so an die 3000 "
         +"Muenzen."));
      clone_object(OBJ_SEE+"dolch.lpc")->move(TP);
      money = clone_object("/obj/money.lpc");
      money->SetProp(P_AMOUNT, 2900+random(200));
      money->move(TP);
      kiste_voll = 0;
      return 1;
      }
      else
      {
         write(BS("Die Kiste ist leer..."));
         return 1;
      }
      
      }
      else
      {
      write(BS("Du hast ja keinen Schluessel mit, der passen wuerde!"));
      return 1;
      }
   }
   return 0;
}

reset()
{
   kiste_voll = 1;
   ::reset();
} 

