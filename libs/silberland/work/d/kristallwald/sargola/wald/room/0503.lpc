#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]) );
  
  SetProp(P_INT_SHORT, "Der Kristallwald" );
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich im hintersten Winkel des Kristallwaldes - "
	     "so stellst Du ihn Dir jedenfalls vor. Es ist ziemlich dunkel, "
	     "da die Zweige der Eiche im Nordwesten wenig Licht durch die "
	     "Baumkronen lassen und Du auch schon ziemlich nahe beim Gebirge "
	     "bist."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddDetail("himmel",
	    "Der Himmel ist von der Eiche voellig verdeckt.");
  
  AddDetail(({"ast","aeste" }), 
	    "Sie sind hier recht robust und beginnen erst in einigen "
	    "Metern Hoehe zu wachsen. Sie verhindern, dass die "
	    "Sonnenstrahlen diesen Platz hier erhellen.");
  
  AddDetail("baum", 
	    "Er ist wesentlich groesser als alle anderen hier.");

  AddDetail("eiche", 
	    "Sie muss wohl etwas Besonderes sein. Vielleicht solltest Du "
	    "einmal raufklettern und sie Dir genauer ansehen.");

  AddDetail(({"kristallwald","wald"}), 
	    "Wie gesagt: Du siehst hier, abgesehen vom riesigen Baum "
	    "vor Dir, wenig vom Kristallwald.");

  AddDetail("wipfel", 
	    "Die Wipfel sind sehr weit weg und schwer durch die Zweige zu "
	    "erkennen.");

  AddDetail(({"gebirge","fels"}), 
	    "Du fuehlst Dich richtig klein wenn die Naturgewalten sich "
	    "neben Dir aufbaeumen.");
  
  AddDetail("winkel", 
	    "Im Osten liegt der dichteste Teil des Waldes. Die weissen "
	    "Staemme sind dort ziemlich dicht.");     
  AddDetail("nahe", 
	    "Im Westen beginnt der Boden Richtung Gebirge schon anzusteigen.");

  AddDetail("naturgewalten", 
	    "Dieses Gebirge war sicherlich schon lange vor jedem "
	    "Menschen hier.");
  
  AddDetail(({"blatt","blaetter"}), 
	    "Sie verursachen durch das Aneinanderschlagen ein leises, "
	    "beruhigendes Klingen.");

  AddDetail("boden", 
	    "Der Boden wird von Zweigen und Blaettern verdeckt.");

  AddDetail("zweige",
	    "Sie stammen von der Eiche.");

  AddDetail(({"blaetter","blatt"}), 
	    "Es wird wohl die Eiche neben Dir gewesen sein, die die "
	    "Blaetter abwarf.");

  AddDetail(({"krone","baumkrone"}), 
	    "Wenn Du die sehen willst, dann musst Du schon weiter nach "
	    "oben klettern!");

  AddDetail("licht", 
	    "Es scheint schwach und diffus durch die Zweige.");
  
  AddExit("norden",    ROOM "0502");
  AddExit("osten",     ROOM "0603");
  AddExit("suedosten", ROOM "0604");    

  AddItem(NPC "gkroete", REFRESH_DESTRUCT);     
}
