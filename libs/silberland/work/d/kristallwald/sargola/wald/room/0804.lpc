#include "../def.h"
#include "wald.h"

inherit "std/room";

#define DESTINATION "1_0804"

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
     
  SetProp(P_INT_SHORT, "Der Kristallwald");
  SetProp(P_INT_LONG, 
	  BS("Hier beginnt im Norden der Wald. Es ragen ueberall "
	     "starke Staemme in die Hoehe und Straeucher erschweren Dir das "
	     "Fortkommen. Ein Weg nach Sueden fuehrt zum Ufer des Sees."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS,0);
  
  AddDetail(({"rhondonit","ufer", "see", "see von rhondonit" }), 
	    "Das Ufer des Sees von Rhondonit breitet sich weiter im "
	    "Sueden aus.");
  
  STANDARD1
  STANDARD2
  AESTE_RAUF
  COMMANDS
  
  AddExit("osten",ROOM "0904");
  AddExit("norden",ROOM "0803");
  AddExit("nordosten",ROOM "0903");
  AddExit("nordwesten",ROOM "0703");
  AddExit("sueden", WALD_SEE_2);
  
}

RAUF
