#pragma strong_types

#include "../def.h"
#include "wald.h"

inherit "std/room";

#define DESTINATION "1_1103"

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
  
  SetProp(P_INT_SHORT, "Der Kristallwald");
  SetProp(P_INT_LONG, 
	  BS("Du stehst mitten im Kristallwald. Neben Dir ragen ueberall "
	     "starke Staemme in die Hoehe und Straeucher erschweren Dir "
	     "das Fortkommen. Im Westen scheint eine kleine Lichtung zu "
	     "liegen."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS,0);

  STANDARD1
  STANDARD2
  AESTE_RAUF

  AddDetail("lichtung",
	    "Zu viele Straeucher und Baeume versperren Dir die Sicht.");

  AddDetail("sicht",
	    "Sie ist eben verdeckt...");
	
  COMMANDS

  AddExit("norden", ROOM "1102");
  AddExit("westen", ROOM "1003");
  AddExit("nordwesten", ROOM "1002");
  AddExit("suedwesten", ROOM "1004");
  AddExit("sueden", ROOM "1104");
}  

RAUF
