inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/kristallwald/sargola/def_kristall.h"

int blaetter_da;

string blaetter();


      create()
      {
        ::create();
   blaetter_da = 1;     

     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]) );
     

        SetProp( P_INT_SHORT, "Der Kristallwald" );
        SetProp( P_INT_LONG, BS("Du befindest Dich im hintersten Winkel des Kristall"
      +"waldes - so stellst Du ihn Dir jedenfalls vor. Es ist ziemlich dunkel, "
      +"da die Zweige der Eiche im Westen wenig Licht durch die Baumkronen lassen "
      +"und Du auch schon recht nahe beim Gebirge bist.") );
     
        SetProp( P_LIGHT, 1 );
        SetProp( P_INDOORS, 0 );

	AddDetail("himmel",
		BS("Der Himmel ist von der Eiche voellig verdeckt."));
	AddDetail("winkel", 
		BS("Im Osten liegt der dichteste Teil des Waldes. Die weissen "
		+"Staemme sind dort ziemlich dicht."));     
        AddDetail( ({"stamm","staemme"}),
        	BS("Sie haben eine weissliche Rinde und sind ziemlich rauh."));
        
        AddDetail( ({"ast","aeste" }), 
        	BS("Sie sind hier recht robust und beginnen erst in "
	      +"einigen Metern Hoehe zu wachsen. Sie verhindern, dass das Sonnenstrahlen"
      		+"diesen Platz hier erhellen.") );

	AddDetail("nahe", 
		BS("Im Westen beginnt der Boden Richtung Gebirge schon anzusteigen."));
        AddDetail( "baum", 
        	BS ("Er ist wesentlich groesser als alle anderen hier.") );
        AddDetail( "eiche", 
        	BS("Sie muss wohl etwas Besonderes sein. Vielleicht solltest Du "
	      +"einmal raufklettern und sie Dir genauer ansehen.") );
        AddDetail( ({"kristallwald","wald"}), BS("Wie gesagt: Du siehst hier, abgesehen "
		+"vom riesigen Baum vor Dir, wenig vom Kristallwald.") );
        AddDetail( "wipfel", BS("Die Wipfel sind sehr weit weg und schwer durch die Zweige zu "
      +"erkennen.") );
        AddDetail( ({"gebirge","fels"}), BS("Du fuehlst Dich richtig klein wenn die "
      +"Naturgewalten sich neben Dir aufbaeumen.") );
	AddDetail("naturgewalten", BS("Dieses Gebirge war sicherlich schon lange vor jedem "
	+"Menschen hier."));

         AddDetail( ({"blatt","blaetter"}), BS("Sie verursachen durch das Aneinanderschlagen ein leises, "
		+"beruhigendes Klingen.") );
   AddDetail("boden", #'blaetter );
   AddDetail("baeume", BS("Du bist umgeben von Baeumen."));
   
   AddDetail("zweige",BS("Sie stammen von der Eiche."));
   AddDetail ( ({"blaetter","blatt"}), (blaetter_da) ? BS("Es wird wohl "
      +"die Eiche sein, die die Blaetter abwarf, folgerst Du scharf"
      +"sinnig. Die Blaetter sind noch frisch.") :  BS("Sowas "
      +"siehst Du hier nicht.") );
   AddDetail ( ({"krone","baumkrone","baumkronen"}), BS("Wenn Du die sehen willst, dann musst Du schon"
      +"weiter nach oben klettern!"));
   AddDetail("licht", BS("Es scheint diffus und schwach durch die Zweige."));

        AddExit( "sueden", ROOM_WALD+"0503.c" );
        AddExit( "osten", ROOM_WALD+"0602.c" );
    
       AddCmd("nimm", "nimm");
     
      }
     

reset()
{
   ::reset();
   blaetter_da = 1;
}

string blaetter()
{
	if(blaetter_da==1) return "Der Boden wird von Zweigen und einer Menge Blaetter bedeckt.\n";
	if(blaetter_da==0) return "Der Boden wird von herabgefallenen Zweigen bedeckt.\n" ;
}

int nimm(string str)
{
   notify_fail("Was moechtest Du nehmen?\n");
   if(!str) return 0;
   
   if(str=="blaetter")
   {
      if(blaetter_da)
      {
         write(BS("Du schiebst die Blaetter am Boden zusammen "
            +"und steckst den Haufen ein."));
         clone_object(OBJ_SEE+"blaetter.c")->move(TP);
         blaetter_da = 0;
         return 1;
      }
      else
      {
         write(BS("Du findest keine Blaetter am Boden!"));
         return 1;
      }
   }
   return 0;

} 

