#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
  
  SetProp(P_INT_SHORT, "Der Kristallwald");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich auf einer stabil wirkenden "
	     "Eiche und hast Dich fest in einer Astgabel verkeilt. Im Sueden "
	     "siehst Du durch die Zweige den See leuchten. Im Westen beginnt "
	     "sich in der Ferne ein Gebirge zu erheben. Du hoerst "
	     "Vogelgezwitscher."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail("ferne",
	    "Weit im Westen siehst Du ein Gebirge.");
  
  AddDetail(({"gabel","astgabel"}),
	    "Du klammerst Dich an sie fest.");
  
  AddDetail("boden",
	    "Der Boden liegt einige Meter unter Dir.");
  
  AddDetail("himmel",
	    "Ueber Dir kannst Du den Himmel durch die Aeste durchschimmern "
	    "sehen.");
  
  AddDetail(({ "vogelgezwitscher", "gezwitscher" }), 
	    "Der Onyxschnabler singt sein Brunftlied vermutest Du.");
  
  AddDetail(({ "almandin", "almandin-gebirgszug", "gebirgszug" ,"gebirge"}), 
	    "Du hast schon von diesem sagenumwobenen Gebirge gehoert. Aber "
	    "keiner hat es geschafft, dieses Gebirge zu passieren...");

  AddDetail("aeste",
	    "Du stehst auf einem der Kraeftigsten von ihnen.");
  
  AddDetail("weibchen",
	    "Hmm... sehr erfolgreich scheint der Onyxschnabler nicht zu "
	    "sein...");
  
  AddDetail(({"brunftlied","lied"}), 
	    "Das ist ein Lied, um Weibchen anzulocken...");
  
  AddDetail("eiche",
	    "Sie genauso wie die anderen, die Du hier schon gesehen hast.");
  
  AddDetail("zweige",
	    "Neben Dir sind sie schon recht licht, weil die Baeume "
	    "niedriger sind als der, auf dem Du stehst.");
  
  AddDetail("baeume",
	    "Du fuehlst Dich umzingelt von Baeumen...");
  
  AddDetail("see",
	    "Tiefer unten breitet sich der See vor Dir aus.");
  
  AddDetail("gebirge",
	    "Im Westen erhebt sich der Almandin-Gebirgszug.");
  
  AddSound(({DEFAULT_SOUND, "lied","brunftlied","schnabler","onyxschnabler"}),
	   "Du hoerst das Brunftlied eines Onyxschnablers. Das erkennst man "
	   "leicht an dem melodischen Zwitschern.");
  
  AddSound(({"zwitschern"}),
	   "Der Onyxschnabler gibt sanfte, langsame Pfiffe von sich und will "
	   "Weibchen damit einlullen.");
  
  AddSound("pfiffe",
	   "Sie klingen lieblich - kein Weibchen kann da widerstehen.");
  
  AddItem(NPC "schnabler", REFRESH_DESTRUCT);     
  
  AddExit("runter", ROOM "1004");
}
