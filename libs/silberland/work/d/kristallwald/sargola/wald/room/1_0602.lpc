#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
     
  SetProp(P_INT_SHORT, "Eine Eiche im Kristallwald");
  SetProp(P_INT_LONG, 
	  BS("Du stehst auf der untersten Ebene der Eiche und fuehlst Dich "
	     "sicher. Der Stamm hat hier sicher einen Durchmesser von "
	     "mehreren Metern und ist mit glaesernen Flechten und Efeu "
	     "ueberwuchert.")+
	  BS("Die Zweige ragen weit ausladend in alle Himmelsrichtungen."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail("ebene",
	    "Es geht noch ein gutes Stueck weiter nach oben.");
  
  AddDetail("flechten",
	    "Zusammen mit dem Efeu verdecken sie den Stamm fast komplett.");
  
  AddDetail("durchmesser",
	    "Es betraegt einige Meter.");
  
  AddDetail(({"ast","aeste" }), 
	    "Sie sind hier recht robust.");
  
  AddDetail("baum", 
	    "Er ist wesentlich groesser als alle anderen hier. Du glaubst, "
	    "weiter oben etwas Dunkles erkennen zu koennen.");

  AddDetail("eiche", 
	    "Sie muss wohl etwas Besonderes sein. Vielleicht solltest "
	    "Du weiter hinaufklettern und sie Dir genauer ansehen.");

  AddDetail("wald", 
	    "Wie gesagt: Du siehst hier, abgesehen vom riesigen Baum vor Dir, "
	    "wenig vom Kristallwald.");

  AddDetail(({"efeu","flechte"}), 
	    "Die Rinde des Stammes ist gar nicht zu sehen, so stark behangen "
	    "ist der Stamm von Efeu und den Flechten.");

  AddDetail("rinde",
	    "Sie ist weisslich, fast glaesern und rauh.");

  AddDetail(({"stamm","staemme"}),
	     "Der Stamm ist von Efeu und Flechten ueberzogen.");

  AddDetail(({"almandin-gebirge","gebirge","fels"}), 
	    "Du fuehlst Dich richtig klein wenn die Naturgewalten sich neben "
	    "Dir aufbaeumen.");

  AddDetail("zweige", 
	    "Die Zweige der Eiche reichen weit in alle Richtungen und sind "
	    "hier noch sehr stark.");
  
  AddDetail("himmelsrichtung", 
	    "Das sind: Norden, Sueden, Westen und Osten.");
  
  AddExit("rauf", ROOM "2_0602");
  AddExit("runter", ROOM "0602");     
}
