#include "../def.h"

inherit "std/room";

string dsound()
{
  if(present("gsnake"))
    write(BS("Es ist nur das leise Zischen der Schlange zu hoeren."));
  else
    write(BS("Du hoerst nichts wesentliches."));
  return "";
}
	
void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
  
  SetProp(P_INT_SHORT, "Eine Baumhoehle");
  SetProp(P_INT_LONG, 
	   BS("Die Hoehle ist von innen weitaus groesser, als es von aussen "
	      "wirkte. Du kannst aufrecht stehen und siehst eine "
	      "Schlafstaette im suedlichen Teil der Hoehle. Ein kleiner "
	      "Durchlass fuehrt weiter nach unten im Stamm. "
	      "Allerlei Geruempel und Habseligkeiten liegt hier herum."));
  
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  
  SetProp(P_NOQUIT, "HILFEEE! Die Schlange will mir ans Leder!\n");
  
  AddDetail(({ "staette", "schlafstaette", "platz", "schlafplatz" }), 
	    "Sie ist aus Zweigen, Blaettern und Graesern gefertigt und mag "
	    "recht weich sein.");
  
  AddDetail(({ "zweige", "blaetter", "graeser" }), 
	    "Damit wurde ein gemuetlichen Schlafplatz gemacht. Er ist schon "
	    "ganz eingedrueckt.");

  AddDetail("teil", 
	    "Im Norden liegt ein Haufen Geruempel.");

  AddDetail("durchlass", 
	    "Er fuehrt nach unten.");

  AddDetail(({"waffe","waffen"}), 
	    "Von zersplitterten Aexten bis zum abgebrochenen Stab, der wohl "
	    "einem Magier gehoerte, findest Du hier alles.");

  AddDetail(({"gegner","magier"}), 
	    "Die sind wohl schon verwest...");

  AddDetail(({"decke","wand","waende"}), 
	    "Die Decke und die Waende sind aus leicht kristallinem Holz.");

  AddDetail("boden", 
	    "Du siehst ein Loch, das weiter runter in den Stamm fuehrt.");
  
  AddDetail("loch", 
	    "Es fuehrt nach unten.");

  AddDetail(({"habseligkeiten","geruempel", "haufen"}), 
	    "Vielleicht findest Du ja was, wenn Du hier alles genau "
	    "untersuchst.");

  AddDetail("hoehle", 
	    "Gedaempftes Licht dringt durch den Eingang in die Hoehle.");

  AddDetail("eingang", 
	    "Er liegt im Westen.");     

  AddDetail("licht", 
	    "Es dringt von westlichen Eingang her in die Hoehle.");

  AddDetail("stamm", 
	    "Du stehst ziemlich in der Mitte des Stammes. Hier ist das Holz "
	    "schon nicht mehr so weiss, wie die Rinde ausserhalb.");

  AddDetail("holz", 
	    "Der Baum hier ist wohl so stark, dass sein Stamm "
	    "dem Zauberspruch des Magiers teilweise widerstehen konnte.");

  AddDetail("baum", 
	    "Du stehst genau drin!");

  AddDetail("rinde", 
	    "Die Rinde draussen ist komplett kristallin im Gegensatz zu "
	    "hier...");
  
  AddSmell(DEFAULT_SMELL, 
	   "Es riecht uebel hier - wer weiss, wieviele Opfer hier "
	   "gefressen wurden....");
  
  AddSound(DEFAULT_SOUND, #'dsound); // #'
	   
  AddExit("raus", ([EX_DEST:ROOM "3_0602",
		    EX_TESTFUNC: "raus_gehen"]));

  AddGuardedExit("runter", ROOM "2_bhoehl", "gsnake", 
		 BS("Du beginnst vorsichtig durch das Loch zu klettern. "
		    "Ploetzlich schreckt die Schlange auf und zischt "
		    "blitzschnell in Deine Richtung.\n@@attack@@"));
  
  AddRoomMessage(({
    "Dein Magen revoltiert - hier stinkt es fuerchterlich!\n",
      "Du fuehlst Dich hier nicht sehr wohl...\n",
      "Du willst schnell raus.\n",
      "Wer weiss, ob hier nicht noch irgendwo Schlangen lauern...\n"}), 60); 
  
  AddCmd(CMD_DURCHSUCHEN+({"stirl"}), "wuehl");
  AddItem(NPC "gsnake", REFRESH_DESTRUCT);
}

int raus_gehen(string str)
{   
  //int r;
  //Wenn die Schlange mit dir kaempft!

  if(TP->InFight())
    {
      //r = random(15);
      switch(random(15))
	{
	case 0..5:
	  {
	    write("Der Schwanz der Schlange versperrt Dir den Weg nach "
		  "draussen!\n");
	    return 0;
	  }
	case 6..13:
	  {
	    write(BS("Du versuchst vergeblich, nach draussen zu gelangen. "
		     "Die Schlange schmettert Dich zurueck in die Ecke.\n"));
	    return 0;
	  }
	default:
	  return 1;
	}
    }
  
  return 1;
}   

string attack()
{
  object ob;

  if(ob=present("gsnake"))
    ob->Kill(TP);

  return "";
}

nosave int wuehl(string str)
{
  object ob;

  notify_fail("Worin willst Du denn wuehlen?\n");
  if(!str) return 0;

  if(str=="in habseligkeiten"||str=="in geruempel"||str=="geruempel")
    if(ob=present("gsnake"))
      {
	write(BS("Als Du beginnst, im Geruempel zu suchen, weckst "
		 "Du die Schlange auf!"));
	ob->Kill(TP);
	return 1;
      }
    else
      return write(BS("Du suchst alles ab, findest aber nichts, was Dir "
		      "irgendwie weiterhelfen koennte.")), 1;
  
  return 0;
}

