#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
  
  SetProp(P_INT_SHORT, "Der Kristallwald");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich direkt unter der grossen Eiche. Im Westen "
	     "erhebt sich der Kristallwald. Es ist ziemlich dunkel, da die "
	     "Zweige der Eiche vom Nordwesten her wenig Licht durch die "
	     "Baumkronen lassen und Du auch schon ziemlich nahe beim Gebirge "
	     "bist."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddDetail("himmel",
	    "Der Himmel ist wegen der Eiche voellig verdeckt.");
  AddDetail(({"ast","aeste"}),
	    "Sie sind hier recht robust und beginnen erst in "
	    "einigen Metern Hoehe zu wachsen. Sie verhindern, dass das "
	    "Sonnenstrahlen diesen Platz hier erhellen.");

  AddDetail("licht", 
	    "Es wird durch die Zweige vielfach gebrochen und verbreitet "
	    "sich diffus.");
  
  AddDetail("winkel", 
	    "Im Osten liegt der dichteste Teil des Waldes. Die weissen "
	    "Staemme sind dort wirklich dicht.");     

  AddDetail("nahe", 
	    "Im Westen beginnt der Boden Richtung Gebirge schon anzusteigen.");

  AddDetail("naturgewalten", 
	    "Dieses Gebirge war sicherlich schon lange vor jedem "
	    "Elfen hier.");
  
  AddDetail("baum", 
	    "Er ist wesentlich groesser als alle anderen hier.");

  AddDetail("eiche", 
	    "Sie muss wohl etwas Besonderes sein. Vielleicht solltest Du "
	    "einmal raufklettern und sie Dir genauer ansehen.");

  AddDetail(({"kristallwald","wald"}), 
	    "Wie gesagt: Du siehst hier, abgesehen "
	    "vom riesigen Baum vor Dir, wenig vom Kristallwald.");

  AddDetail("wipfel", 
	    "Die Wipfel sind sehr weit weg und schwer durch die Zweige zu "
	    "erkennen.");

  AddDetail(({"gebirge","fels"}), 
	    "Du fuehlst Dich richtig klein wenn die "
	    "Naturgewalten sich neben Dir aufbaeumen.");
  
  AddDetail(({"blatt","blaetter"}), 
	    "Sie verursachen durch das Aneinanderschlagen ein leises, "
	    "beruhigendes Klingen.");

  AddDetail("boden", 
	    "Der Boden wird von Zweigen und Blaettern verdeckt.");

  AddDetail("zweige",
	    "Sie stammen von der Eiche.");

  AddDetail(({"blaetter","blatt"}), 
	    "Es wird wohl die Eiche neben Dir gewesen sein, die "
	    "die Blaetter abwarf.");

  AddDetail(({"krone","baumkrone"}), 
	    "Wenn Du die sehen willst, dann musst Du schon "
	    "weiter nach oben klettern!");

  AddCmd(CMD_KLETTERN, "kletter");
  
  AddExit("sueden", ROOM "0603");
  AddExit("westen", ROOM "0502");
  AddExit("rauf", ROOM "1_0602");     
}

nosave int kletter(string str)
{
  notify_fail(BS("Wohin willst Du klettern?"));
  if(!str) return 0;
  
  if(str=="auf eiche"||str=="eiche"||str=="rauf"||
     str=="hoch"||str=="nach oben")
    {
      TP->move(ROOM "1_0602", M_GO);
      return 1;
    }
  
  return 0;
}


