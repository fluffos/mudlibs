#include "../def.h"

inherit "std/room";

nosave int rinde;

create()
{
  ::create();

  rinde = 1;

  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));

  SetProp(P_INT_SHORT, "Im Kristallwald");
  SetProp(P_INT_LONG, 
	  BS("Du klammerst Dich an den Stamm des Baumes. Um Dich "
	     "herum sind die Baeume so hoch wie der, auf dem Du stehst. "
	     "Im Westen kannst Du eine Lichtung erkennen, im Suedwesten "
	     "schimmert etwas durch die Zweige."));
     
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddDetail("himmel",
	    "Der Himmel schimmert blaeulich durch die Zweige durch.");
  
  AddDetail("lichtung", 
	    "In ihrer Mitte befindet sich ein erloschenes Lagerfeuer.");

  AddDetail("mitte", 
	    "Dort ist das erloschene Lagerfeuer.");

  AddDetail(({"feuer","lagerfeuer"}), 
	    "Es ist leider schon erloschen.");

  AddDetail(({"baum", "baeume" }), 
	    "Sie sind nicht besonders hoch, doch reicht es aus, "
	    "um einen Ueberblick zu bekommen. Ihre weisslich-glaesernen "
	    "Zweige verwandeln alles hier in eine unwirklich und maerchenhaft "
	    "wirkende Gegend.");
  
  AddDetail(({"ueberblick"}), 
	    "Den hat man ja vom Boden aus nicht.");
  
  AddDetail("boden",
	    "Der liegt unter Dir.");

  AddDetail(({"stamm"}), 
	    "Der Stamm wird durch eine weissliche, unebene Rinde bedeckt.");

  AddDetail("rinde", 
	    "Sie laesst sich leicht abreiben und knistert dabei leise.");
  
  AddDetail(({"ast","aeste","zweig","zweige"}), 
	    "Die Zweige und Aeste der Baeume sind komplett "
	    "in Kristall verwandelt.");
  
  AddDetail(({"gegend","kristall"}),
	     "Alles hier ist mit Kristall ueberzogen.");
  
  AddCmd(({"reib","reibe"}),"reibe");
	        
  AddExit("runter", ROOM "1103");
}
    
void reset()
{
  ::reset();

  rinde = 1;
}

nosave int reibe(string str)
{
  object ob;

  notify_fail(BS("Was moechtest Du denn reiben?"));
  if(!str) return 0;

  if(str=="rinde"||str=="an rinde"||str=="baumrinde"||str=="an baumrinde")
    if(rinde)
      {
	ob = clone_object(OBJ "rstaub");
	
	if(ob->move(TP, M_GET)==ME_TOO_HEAVY)
	  {
	    ob->remove(1);
	    
	    return write(BS("Du reibst ein wenig an der Rinde und erhaelst "
			    "feinen Rindenstaub...")+
			 BS("Doch der rieselt Dir wieder aus der Hand.")), 1;
	  }
	
	write(BS("Du reibst ein wenig an der Rinde und erhaeltst "
		 "feinen Rindenstaub."));
	
	rinde = 0;	
	
	return 1;
      }
    else
      return write(BS("Du reibst, aber nichts passiert.")), 1;
  
  return 0;
}
