#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
  
  SetProp(P_INT_SHORT, "Der Kristallwald");
  SetProp(P_INT_LONG, 
	  BS("Du bist zwischen dem Kristallwald im Osten und einer "
	     "kleineren Gruppe von Baeumen etwas abseits im Westen. Dort "
	     "erhebt sich auch die Eiche, die Du schon von weitem gesehen "
	     "hast. Noch weiter im Westen kannst Du das Gebirge sehen."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddDetail("baeume", 
	    "Im Westen steht eine Gruppe von Baeumen, die durch "
	    "einen Weg mit dem restlichen Wald im Osten verbunden ist.");

  AddDetail("gruppe", 
	    "So 3 oder 4 Baeume sind das wohl.");

  AddDetail("weg", 
	    "Er fuehrt von Osten nach Westen.");

  AddDetail(({"ast","aeste" }), 
	    "Sie sind hier recht robust und beginnen erst in einigen Metern "
	    "Hoehe zu wachsen. Sie verhindern, dass das Sonnenstrahlen "
	    "diesen Platz hier erhellen.");
  
  AddDetail("himmel", 
	    "Er blitzt zwischen den Zweigen durch.");

  AddDetail("baum", 
	    "Er ist wesentlich groesser als alle anderen hier.");

  AddDetail("eiche", 
	    "Sie ist um Laengen groesser als alle anderen Baeume hier.");

  AddDetail("laengen", 
	    "Sicher 2 bis 3 Mal so hoch...");

  AddDetail("wald", 
	    "Wie gesagt: Du siehst hier, abgesehen vom riesigen Baum vor Dir, "
	    "wenig vom Kristallwald.");

  AddDetail("kristallwald", 
	    "Du stehst genau zwischen dem westlichen und oestlichen "
	    "Teil des Kristallwaldes.");

  AddDetail("wipfel", 
	    "Die Wipfel sind sehr weit weg und schwer durch die Zweige zu "
	    "erkennen.");

  AddDetail(({"gebirge","fels"}), 
	    "Majestaetisch und gewaltig ragen die Felsen in die Hoehe.");

  AddDetail("felsen", 
	    "Von hier kannst Du nur ansatzweise erkennen, "
	    "wie gewaltig das Gebirge sein muss!");
  

  AddDetail(({"blatt","blaetter"}), 
	    "Sie verursachen durch das Aneinanderschlagen ein leises, "
	    "beruhigendes Klingen.");

  AddDetail("boden", 
	    "Der Boden wird von Zweigen und Blaettern verdeckt.");

  AddDetail("zweige",
	    "Sie stammen von der Eiche.");

  AddDetail(({"blaetter","blatt"}), 
	    "Es wird wohl die Eiche neben Dir gewesen sein, die die "
	    "Blaetter abwarf.");

  AddDetail(({"krone","baumkrone"}), 
	    "Wenn Du die sehen willst, dann musst Du schon weiter nach "
	    "oben klettern!");
  
  AddExit("osten", ROOM "0803");
  AddExit("westen", ROOM "0603");
  AddExit("suedosten", ROOM "0804");     
  AddExit("nordosten", ROOM "0802");
}
