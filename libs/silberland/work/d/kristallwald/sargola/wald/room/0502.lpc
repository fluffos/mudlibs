#include "../def.h"

inherit "std/room";

nosave int blaetter_da;

void create()
{
  ::create();

  blaetter_da=1;
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
  
  
  SetProp(P_INT_SHORT, "Der Kristallwald");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich im hintersten Winkel des Kristallwaldes - "
	     "so stellst Du ihn Dir jedenfalls vor. Es ist ziemlich dunkel, "
	     "da die Zweige der Eiche im Osten wenig Licht durch die "
	     "Baumkronen lassen und Du auch schon recht nahe beim Gebirge "
	     "bist. Im Nordosten kannst Du eine belebte Lichtung erkennen. "
	     "Ein alter, hohler Baum rottet hier vor sich hin."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail("himmel",
	    "Der Himmel ist von der Eiche voellig verdeckt.");

  AddDetail(({"winkel", "teil"}),
	    "Im Osten liegt der dichteste Teil des Waldes. Die weissen "
	    "Staemme sind dort ziemlich dicht.");

  AddDetail(({"lichtung", "nordosten"}),
	    "Im Nordosten befindet sich eine ziemlich belebte Lichtung. "
	    "Was dort wohl gerade gemacht wird?");

  AddDetail(({"stamm","staemme"}),
	    "Sie haben eine weissliche Rinde und sind ziemlich rauh.");

  AddDetail(({"rinde", "farbton"}),
	    "Die Rinde hat einen weisslichen Farbton.");

  AddDetail(({"ast","aeste" }), 
	    "Sie sind hier recht robust und beginnen erst in einigen Metern "
	    "Hoehe zu wachsen. Sie verhindern, dass das Sonnenstrahlen "
	    "diesen Platz hier erhellen.");

  AddDetail(("nahe"), 
	    "Im Westen beginnt der Boden Richtung Gebirge schon anzusteigen.");

  AddDetail("baum", 
	    "Ein alter, hohler Baum steht hier etwas abseits herum.");

  AddDetail(("eiche"), 
	    "Sie muss wohl etwas Besonderes sein. Vielleicht solltest Du "
	    "einmal raufklettern und sie Dir genauer ansehen.") ;

  AddDetail(({"kristallwald","wald"}), 
	    "Wie gesagt: Du siehst hier, abgesehen vom riesigen Baum vor "
	    "Dir, wenig vom Kristallwald.");

  AddDetail(("wipfel"), 
	    "Die Wipfel sind sehr weit weg und schwer durch die Zweige zu "
	    "erkennen.");

  AddDetail(({"gebirge","fels"}), 
	    "Du fuehlst Dich richtig klein wenn die Naturgewalten sich "
	    "neben Dir aufbaeumen.");

  AddDetail(({"naturgewalten", "menschen"}), 
	    "Dieses Gebirge war sicherlich schon lange vor jedem Elf hier.");

  AddSpecialDetail("boden", "boden_schau");

  AddDetail(("baeume"), 
	    "Du bist umgeben von Baeumen.");

  AddDetail(("zweige"),
	    "Sie stammen von der Eiche.");

  AddSpecialDetail (({"blaetter","blatt"}), "blaetter_da"); 

  AddDetail(({"krone","baumkrone","baumkronen"}), 
	    "Wenn Du die sehen willst, dann musst Du schon "
	    "weiter nach oben klettern!");

  AddDetail(("licht"), 
	    "Es scheint diffus und schwach durch die Zweige.");

  AddSound(({DEFAULT_SOUND,}),
	   "Du hoerst das Rauschen des Windes in den Baumwipfeln. Ausserdem "
	   "kannst hoerst Du eine Vielzahl an Geraeuschen von der Lichtung "
	   "im Nordosten.");

  AddSound(({"rauschen", "pfeifen", "wind", "baumwipfel"}),
	   "Sanft pfeift der Wind durch die Baumwipfel.");

  AddDetail(("baumwipfel"),
	    "Es ist so dunkel hier, dass Du die Baumwipfel kaum erkennen "
	    "kannst.");

  AddDetail(({"geraeusche", "vielzahl"}),
	    "Du kannst ihnen lauschen.");

  AddSound(({"geraeusche", "vielzahl"}),
	   "Hoert sich so an als wuerde dort heftig gearbeitet. Vielleicht "
	   "solltest Du Dir dies ja mal naeher ansehen.");

  AddSmell(({DEFAULT_SMELL, "geruch", "wald"}),
	   "Riecht eindeutig nach Wald.");
  
  AddExit("sueden", ROOM "0503");
  AddExit("osten", ROOM "0602");

  AddExit("nordosten", "/gilden/bardengilde");
  
  AddExit("baum", ([EX_DEST: WALD_VILAYBOG, EX_MSG:"in den hohlen Baum"]));
  
  AddCmd(CMD_NEHMEN, "nimm");  
}

void reset()
{
  ::reset();

  blaetter_da = 1;
}

string blaetter_da()
{
  if(blaetter_da) 
    return BS("Es wird wohl die Eiche sein, die die Blaetter abwarf, "
	      "folgerst Du scharfsinnig. Die Blaetter sind noch frisch.");
  else
    return BS("Sowas siehst Du hier nicht.");
}

string boden_schau()
{
  if(blaetter_da)
    return BS("Der Boden wird von Zweigen und einer Menge Blaetter bedeckt.");
  else
    return BS("Der Boden wird von herabgefallenen Zweigen bedeckt.");
}

nosave int nimm(string str)
{
  object blaetter;

  notify_fail(BS("Was moechtest Du nehmen?"));
  if(!str) return 0;
  
  if(str!="blaetter") return 0;

  if(!blaetter_da)
    return write(BS("Du findest keine Blaetter am Boden!")), 1;

  blaetter=clone_object(OBJ "blaetter");

  if(blaetter->move(TP, M_GET)==ME_TOO_HEAVY)
    {
      blaetter->remove(1);
      write(BS("Die Blaetter koenntest Du nicht mehr tragen!"));
      return 1;
    }

  write(BS("Du schiebst die Blaetter am Boden zusammen und steckst den "
	   "Haufen ein."));
  
  blaetter_da = 0;

  return 1;
}
