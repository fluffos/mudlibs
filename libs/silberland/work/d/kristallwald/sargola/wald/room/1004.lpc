#include "../def.h"
#include "wald.h"

inherit "std/room";

#define DESTINATION "1_1004"

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
     
  SetProp(P_INT_SHORT, "Der Kristallwald");
  SetProp(P_INT_LONG,	
	  BS("Du stehst mitten im Kristallwald. Neben Dir ragen ueberall "
	     "starke Staemme in die Hoehe und Straeucher erschweren Dir das "
	     "Fortkommen. Ein verkuemmerter Baum faellt Dir auf. Im Norden "
	     "scheint eine kleine Lichtung zu liegen."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS,0);
  
  STANDARD1
  STANDARD2
  AESTE_RAUF
  COMMANDS
  
  AddDetail("baum",
	    "Er ist verkuemmerter und kleiner als die anderen Baeume hier.");
  
  AddDetail("lichtung", 
	    "Die Lichtung liegt noerdlich von Dir.");
  
  AddExit("osten", ROOM "1104");
  AddExit("norden", ROOM "1003");
  AddExit("westen", ROOM "0904");
  AddExit("nordosten", ROOM "1103");
  AddExit("nordwesten", ROOM "0903");
}  

RAUF
