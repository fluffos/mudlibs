#pragma strong_types 

#include "../def.h"
#include "wald.h" 
 
inherit "std/room"; 

#define DESTINATION "1_0902"

void create() 
{ 
  ::create(); 
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]) );
  
  SetProp(P_INT_SHORT, "Der Kristallwald" ); 
  SetProp(P_INT_LONG, 
	  BS("Du stehst mitten im Kristallwald. Neben Dir ragen " 
	     "ueberall starke Staemme in die Hoehe und Straeucher " 
	     "erschweren Dir das Fortkommen. Pass auf, dass Du Dich hier "
	     "nicht verlaeufst! Im Suedosten scheint eine kleine Lichtung "
	     "zu liegen.")); 
  
  SetProp(P_INDOORS,0); 
  SetProp(P_LIGHT, 1); 
  
  STANDARD1
  STANDARD2
  AESTE_RAUF
  COMMANDS 
  
  AddExit ("osten", ROOM "1002"); 
  AddExit("westen", ROOM "0802"); 
  AddExit("nordosten", ROOM "1001"); 
  AddExit("suedosten", ROOM "1003"); 
  AddExit("suedwesten", ROOM "0803"); 
  AddExit("sueden", ROOM "0903"); 
} 

RAUF 
