//#pragma strong_types

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/kristallwald/sargola/def_kristall.h"      

void create()
{
  ::create();
  
     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]) );
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Am Eingang des Kristallwald" );
  SetProp( P_INT_LONG, BS("Wie der aussehen wird, weiss ich noch nicht. Kann ich erst "
   +"sagen, wenn ich weiss, wo er hinkommt...\n") );

  SetProp(P_INDOORS,0);
  



    AddExit("suedwesten",ROOM_WALD+ "1102.lpc");
    AddExit("workroom","/d/players/sargola/workroom.lpc");
}  


 
