#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]) );
     
  SetProp(P_INT_SHORT, "Eine Lichtung");

  SetProp(P_INT_LONG, 
	  BS("Du stehst auf einer Lichtung im Kristallwald. Hier "
	     "wurden, wie Du an einer alten Feuerstelle erkennen kannst, "
	     "Feste gefeiert. Der Himmel strahlt ueber Dir."));

  SetProp(P_INDOORS,0);
  SetProp(P_LIGHT, 1);
  
  AddSound(DEFAULT_SOUND,
	   "Das Klingen der Blaetter im Wind ist nicht so stark zu hoeren.");
  AddSmell(DEFAULT_SMELL, 
	   "Du kannst hier nichts riechen! Wie denn auch? "
	   "Ist ja alles kristallin.");

  AddDetail(({ "tier", "tiere" }), 
	    "Du siehst hier keine Tiere." );

  AddDetail(({ "bratspiess","spiess" }), 
	    "Hier liegt keiner, aber Du kommst zu der Einsicht, dass "
	    "hier wohl einmal einer gewesen sein muss!" );
  
  AddDetail("einsicht",
	    "Die kann man nicht untersuchen - die muss man haben.");
  
  AddDetail(({ "zweiggabel", "gabel","zweiggabeln","gabeln","zweig" }), 
	    "Das ist ein Zweig, der sich in zwei Teile teilt." );

  AddDetail(({ "himmel" }), 
	    "Er liegt in tiefem Blau ueber Dir.");
  
  AddDetail("blau",
	    "Das kann man nicht naeher untersuchen.");
  
  AddDetail("lichtung", 
	    "Endlich kannst Du Dich wieder frei bewegen, ohne dass Du Dir "
	    "den Weg erkaempfen musst.");

  AddDetail("weg",
	    "Hier gibt es nur eine Lichtung.");

  AddDetail("boden",
	    "Der Boden ist mit weisslichem Gras bedeckt.");

  AddDetail("gras",
	    "An einigen Stellen ist es niedergedrueckt. So als ob hier vor "
	    "kurzem noch Leute rasteten.");

  AddDetail(({"stelle","stellen"}),
	    "Die Stellen liegen alle rund um die Feuerstelle.");

  AddDetail("leute",
	    "Verflixt! Sowas aber auch! Leute findest Du hier keine!");
  
  AddDetail(({"baeume","baum"}), 
	    "Sie sind im Westen dicht wie nie. Doch sind die Aeste "
	    "hier recht nah am Boden.");

  AddDetail("konstruktion", 
	    "Sie besteht aus zwei Zweiggabeln, auf die man einen Bratspiess "
	    "legen kann.");
  
  AddDetail(({"ast","aeste"}),
	    "Die Aeste der umliegenden Baeume sind nicht mehr als 2 Meter vom "
	    "Boden entfernt.");

  AddDetail(({"stelle","feuer","feuerstelle"}),
	    "Du kannst einen Steinkreis in der Mitte der Lichtung erkennen "
	    "und eine Konstruktion, mit der man diverse Tiere braten kann.");

  AddDetail(({"kreis","steinkreis"}),
	    "Na wozu legt man Steine um ein Feuer??");

  AddDetail(({"stein","steine"}),
	    "Sie sind verkohlt.");
  
  AddDetail(({"wald","kristallwald"}),
	    "Du stehst in einer Lichtung des Kristallwaldes.");
  
  AddDetail(({"fest","feste"}),
	    "So verlassen, wie Du denkst, war es hier wohl frueher nicht.");
  
  AddExit("osten",      ROOM "1103");
  AddExit("suedosten",  ROOM "1104");
  AddExit("norden",     ROOM "1002");
  AddExit("nordosten",  ROOM "1102");
  AddExit("sueden",     ROOM "1004");
  AddExit("suedwesten", ROOM "0904");
  AddExit("westen",     ROOM "0903");
  AddExit("nordwesten", ROOM "0902");
}
