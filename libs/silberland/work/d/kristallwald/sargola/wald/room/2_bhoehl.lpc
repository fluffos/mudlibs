inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/kristallwald/sargola/def_kristall.h"


geruempel();
wuehle(string str);
int hat_pflock;
      create()
      {
        ::create();
   
   hat_pflock = 0;     

     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]) );
     

        SetProp( P_INT_SHORT, "Eine Baumhoehle" );
        SetProp( P_INT_LONG, BS("Hier ist die Hoehle noch groesser als die oben. Allerlei "
      +"Geruempel und Habseligkeiten von verblichenen Gegnern liegen hier herum. Die "
      +"Waende hier sind aus braeunlichem Holz.") );
     
        SetProp( P_LIGHT, 0 );
        SetProp( P_INDOORS, 1 );
     
    
   AddDetail(({"habseligkeiten","geruempel"}), #'geruempel);
   AddDetail("eiche", BS("Du stehst in der Eiche."));
   AddDetail( ({"boden","wand","waende"}), BS("Alles hier ist aus Holz - komisch..."));
   AddDetail("schlange", BS("Von hier aus kannst Du sie nicht sehen."));
   AddDetail("decke", BS("In der Decke ist ein Loch, durch das Du nach oben klettern kannst."));
   AddDetail("loch", BS("Das Loch ist die einzige Moeglichkeit, wieder nach oben zu kommen."));
   AddDetail("hoehle", BS("Dunkel ist es hier..."));
   AddDetail( ({"zeugs","habtuemer"}), BS("Alles zerbrochenes, kaputtes "
      +"und wertloses Zeugs..."));
   AddDetail("holz", BS("Die Eiche hat den Kristall-Spruch ab"
      +"wehren koennen. Das Holz hier drin ist wohl von "
      +"besonderem Holze. Du lachst ueber Deinen Schuettel"
      +"reim :)."));
   AddDetail( ({"waende","wand"}), BS("Waende aus stinknormalem Holz - nur hier eine "
      +"Seltenheit!"));
   AddDetail("gegner", BS("Naja Gegner kann man nicht sagen - die "
      +"meisten sind schon verwest..."));
   
           


     AddSmell(DEFAULT_SMELL, BS("Es riecht uebel hier - wer weiss, wieviele Opfer hier "
      +"gefressen wurden....") );
     AddExit( "rauf", ROOM_WALD+"3_bhoehl.lpc" );
   
   AddCmd("nimm","nimm");    
   AddCmd(  ({"schneide", "schnitze", "schneid", "schnitz"}), "schneide");
   AddCmd( "wuehle", "wuehle");

     
      }

int nimm (string str)
{
	notify_fail("Was willst Du denn nehmen?\n");
	if(!str) return 0;

	if(str=="holz"||str=="holz aus wand")
	{
		write(BS("Die Waende bestehen zwar aus Holz, aber nehmen "
		+"kannst Du es trotzdem nicht so einfach."));
		return 1;
	}
	return 0;
}

int schneide (string str)
{
   object gs;
   object pflock;
   notify_fail ("Was moechtest Du denn schneiden?\n");

   if (!str) return 0;

   if(!present("messer", TP))
   {
	write(BS("Du hast ja gar kein Messer, um hier irgendetwas rauszuschneiden..."));
	return 1;
   }

if(str=="holz" || str=="holz aus wand"||str=="holz raus")
{

   if (hat_pflock == 0)
   {
      write(BS("Du schneidest ein grosses Stueck aus dem Stamm "
         +"heraus das moeglichst wenig kristallin ist und "
         +"steckst es ein."));
      pflock = clone_object (OBJ_WALD+"pflock.lpc");
      pflock->move (TP, M_NOCHECK);
      pflock->SetProp(P_LONG, pflock->QueryProp(P_LONG)+"Er gehoert "+TP->name (WEM) +".\n");
      pflock->set_owner(TP->query_real_name());
      hat_pflock = 1;
      return 1;
   }
   else
   {
         write(BS("Mist! Die beste Stelle mit dem frischesten Holz hat schon "
            +"jemand herausgeschnitten!"));
         return 1;
   }

}

}


reset()
{   
   ::reset();
   hat_pflock=0;
}

 
geruempel()
{
	if(present("gsnake", find_object(ROOM_WALD+"3_bhoehl.lpc")))
	{
		write(BS("Du traust Dich nicht, darin herumzuwuehlen. Die Schlange "
		+"koennte ja aufwachen."));
		return "";
	}
	else
	{
		write(BS("Du wuehlst, findest aber nichts besonderes."));
		return "";
	}
	return 0;
}

wuehle(string str)
{
  if(str=="in geruempel"||str=="in habseligkeiten")
  {
	if(present("gsnake", find_object(ROOM_WALD+"3_bhoehl.lpc")))
	{
		write(BS("Du traust Dich nicht, darin herumzuwuehlen. Die Schlange "
		+"koennte ja aufwachen."));
		return "";
	}
	else
	{
		write(BS("Du wuehlst, findest aber nichts Besonderes."));
		return "";
	}
	return 0;
   }
   notify_fail("Worin willst Du wuehlen?\n");
   return 0;
}
