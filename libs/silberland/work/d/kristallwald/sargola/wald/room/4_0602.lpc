#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Auf einer Eiche im Kristallwald");
  SetProp(P_INT_LONG, 
	  BS("Du findest Dich ploetzlich in einem riesigen Nest wieder. "
	     "Das ist der hoechste Punkt im Kristallwald - viel weiter nach "
	     "oben solltest Du nicht mehr gehen. Der Wipfel schwankt schon "
	     "bedenklich im Wind. Hier werden auch die Aeste der maechtigsten "
	     "Eiche duenn. Weiter unten siehst Du einen Hoehleneingang. "
	     "Du kannst den gesamten Kristallwald von hier aus sehen."));
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddDetail("eiche",	
	    "Du klammerst Dich gerade an sie.");

  AddDetail(({"hoehleneingang","eingang"}),
	    "Er liegt dunkel unter Dir - was sich wohl darin verstecken mag?");

  AddDetail("himmel",
	    "Er leuchtet blau ueber Dir.");
  
  AddDetail(({"ast","aeste"}),
	    "Bist Du sicher, dass sie Dich noch laenger tragen koennen?");
  
  AddDetail("nest", 
	    "Du stehst bestimmt im Nest einer Kreatur - nur welcher?");

  AddDetail(({"warten","abwarten","kreatur"}), 
	    "Vielleicht kommt sie ja bald vorbei... Aber ob Du das abwarten "
	    "willst?");
  
  AddDetail(({"wald","Kristallwald"}), 
	    "Alle anderen Baeume sind weit kleiner als der, auf dem Du "
	    "stehst. Von hier aus kannst Du schemenhaft das Ufer des Sees "
	    "erkennen."); 

  AddDetail("ufer",	
	    "Das Ufer siehst Du wirklich nur schemenhaft.");
  
  AddDetail("baeume",
	    "Sie sind sicher nur halb so gross wie der, auf dem Du stehst.");

  AddDetail(({"blatt","blaetter","gestruepp"}), 
	    "Es wurde zu einem stabilen Boden verwoben und fuehrt in die "
	    "Hoehle hinein.");
  
  AddDetail("hoehle",
	    "Nur wenn Du da reingehst, weisst Du, was drinnnen ist..");

  AddDetail("see", 
	    "Er liegt ruhig in Form einer Mondsichel weit im Sueden.");

  AddDetail("mondsichel",
	    "Du kennst doch eine Sichel, oder?");

  AddDetail("wipfel",
	    "Du pendelst durch den leichten Wind einen halben Meter hin und "
	    "her.");

  AddDetail("wind",
	    "Es weht ein leichter Wind hier oben.");

  AddExit("runter", ROOM "3_0602");
}

public void InformBardSongPlayed(object who, int success) {
	object wind;
	if(!objectp(present("\nbard_windflasche", who))) return;
	if(objectp(present("\nbarden_wind"))) return;
  
	if(success < 1000) {
	  tell_object(who, BS("Dein Spiel scheint nicht gut genug zu sein, um einen Wind herbeizurufen."));
	  return;
	}
  
	wind = clone_object("/gilden/bardengilde/npc/westwind");
	wind->move(this_object(), M_GO);
  }
  
