#include "../def.h"
#include "wald.h"

inherit "std/room";

#define DESTINATION "1_0904"
#define AST "/d/kristallwald/sargola/see/obj/ast"

nosave int ast_da;

string ast();
string straeucher();

void create()
{
  ::create();

  ast_da = 1;

  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
  
  SetProp(P_INT_SHORT, "Der Kristallwald");
  SetProp(P_INT_LONG, 
	  BS("Du stehst mitten im Kristallwald. Neben Dir ragen ueberall "
	     "starke Staemme in die Hoehe und Straeucher erschweren Dir "
	     "das Fortkommen. Im Nordosten scheint eine kleine Lichtung "
	     "zu sein."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS,0);
  
  STANDARD1
  STANDARD2
  AESTE_RAUF

  AddDetail("lichtung", 
	    "Geh doch hin, wenn Du darueber was wissen willst!");
  
  
  //AddDetail(({"stamm","staemme"}), 
  //"Sie sind fast voellig weiss und die Rinde ist glashart."));

  AddDetail("rinde", 
	    "Sie ist wirklich hart und unregelmaessig.");

  AddDetail("hoehe",
	    "Die Staemme sind gut und gern zehn Meter hoch.");

  //AddDetail("astgabel", 
  //"Du stehst auf ihr.");

  AddDetail("ferne",
	    "Die ist sooo weit entfernt.");

  AddDetail("ast", CLOSURE(ast));

  AddDetail(({"strauch","straeucher"}), CLOSURE(straeucher));

  COMMANDS

  AddCmd(({"breche","brich","reiss","reisse"}), "brich");

  AddExit("osten",ROOM "1004");
  AddExit("norden",ROOM "0903");
  AddExit("westen",ROOM "0804");
  AddExit("nordosten",ROOM "1003");
  AddExit("nordwesten",ROOM "0803");

  AddItem(NPC "gschroe", REFRESH_DESTRUCT);
}  

RAUF

nosave int brich(string str)
{
  object ast;

  notify_fail("Was willst Du abbrechen?\n");
  if(!str) return 0;
  
  if(str=="ast ab"||str=="ast herunter"||str=="ast von strauch ab"||
     str=="ast von strauch herunter")
    if(ast_da)
      {
	ast=clone_object(AST);
	
	if(ast->move(TP, M_GET)==ME_TOO_HEAVY)
	  {
	    ast->remove(1);
	    return write(BS("Der Ast wuerde Dir viel zu schwer werden, "
			    "daher laesst Du es sein.")), 1;
	  }
	
	write(BS("Du brichst den Ast ab und steckst ihn ein - wer "
		 "weiss, wozu man den brauchen kann..."));
	
	ast_da = 0;

	return 1;
      }
    else
      return write(BS("Der Ast ist zu weit weg und anstregen willst Du "
		      "Dich auch nicht so sehr...")), 1;
  
  return 0;
}

void reset()
{
  ::reset();   

  ast_da = 1;
} 

string ast()
{
  if(ast_da)
    return BS("Er haengt schon halb abgebrochen herunter. Sicher kannst Du "
	      "ihn Dir leicht abbrechen.");

  return BS("Wo siehst Du hier bloss einen Ast??");
}

string straeucher()
{
  if(ast_da)
    return BS("Die stehen hier ueberall herum und versperren Dir den Weg. "
	      "Ein Ast steht unnatuerlich weg.");
  
  return BS("Die stehen hier ueberall herum und hindern Dich am Fortkommen.");
}
