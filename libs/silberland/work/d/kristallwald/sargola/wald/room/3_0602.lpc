#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
  
  SetProp(P_INT_SHORT, "Eine Eiche im Kristallwald");
  SetProp(P_INT_LONG, 
	  BS("Als Du hier ankommst, empfaengt Dich eine Ueberraschung. "
	     "Irgendwas oder Irgendwer hat sich hier ein Nest "
	     "eingerichtet. Vor Dir liegen Blaetter und Gestruepp, das "
	     "eine Art Platz vor einer Hoehle ist, die direkt in den "
	     "Stamm reinfuehrt. Du kannst den gesamten Kristallwald von "
	     "hier aus sehen."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail("himmel",
	    "Er leuchtet blau ueber Dir.");
  
  AddDetail(({"ueberaschung","ueberraschung"}),
	    "Sowas kann man nicht untersuchen - sonst waers ja keine "
	    "Ueberraschung mehr!");
  
  AddDetail(({ "stamm" }), 
	    "Der Stamm ist hohl, dann es fuehrt ein Weg hinein!");
  
  AddDetail(({ "mondsichel", "sichel" ,"form"}), 
	    "Der See hat die Form einer umgekehrten Sichel.");
  
  AddDetail(({ "boden","platz" }), 
	    "Es ist hier wie ein riesiges Nest - Zweige, staerkere Aeste "
	    "und Blaetter bilden einen kleinen Platz vor dem Eingang der "
	    "Hoehle.");
  
  AddDetail(({"eingang","loch"}),
	    "Der Eingang ist nur ein Loch in den Stamm rein.");
  
  AddDetail(({"ast","aeste","zweige"}),
	    "Sie wurden zu dem Nest verarbeitet.");
  
  AddDetail(({"wesen","irgendetwas","irgendwer" }),
	    "Welch Wesen kann sowas erschaffen, raetselt Du, ohne die Hoehle "
	    "aus den Augen zu lassen...");
  
  AddDetail("nest",
	    "Du stehst bestimmt im Nest einer Kreatur - nur welcher?");
  
  AddDetail("kreatur", 
	    "Vielleicht solltest Du Dir die Hoehle genauer ansehen, um das "
	    "herauszufinden?");
  
  AddDetail(({"wald","kristallwald"}), 
	    "Alle anderen Baeume sind weit kleiner als der, auf dem Du "
	    "stehst. Von hier aus kannst Du das Ufer des Sees erkennen, "
	    "das Gebirge im Westen und den Wald, der sich im Westen und "
	    "Sueden ausstreckt.");
  
  AddDetail("gebirge",
	    "Das Gebirge im Westen ist unuebersehbar.");
  
  AddDetail(({"blatt","blaetter","gestruepp"}), 
	    "Das Gestruepp und die vielen Blaetter wurden zu einem stabilen "
	    "Boden verwoben, welcher in die Hoehle hineinfuehrt.");

  AddDetail("hoehle", 
	    "Sie wirkt bedrohlich finster und unheimlich.");

  AddDetail("see", 
	    "Er liegt ruhig in Form einer Mondsichel weit im Sueden.");
  
  AddDetail(({"stamm","staemme", "eiche"}), 
	    "Die riesige Eiche, auf der Du stehst, hat einen enormen "
	    "Stamm, welcher mit einer weisslichen Rinde ueberzogen ist.");
  
  AddDetail("rinde", 
	    "Sie ist gleichmaessig und funkelt.");
  
  AddDetail(({"baum","baeume"}), 
	    "Du siehst viele kleine Baeume im Osten und Sueden.");
  
  AddExit("rauf", ROOM "4_0602");
  AddExit("runter", ROOM "2_0602");
  
  AddCmd(CMD_BETRETEN, "betrete_hoehle");
}

nosave int betrete_hoehle(string str)
{
  notify_fail(BS("Was willst Du betreten?"));
  if(!str) return 0;
  
  if(str=="hoehle"||str=="loch"||str=="baumhoehle")
    {
      write(BS("Du betrittst vorsichtig die Hoehle..."));
      TP->move(ROOM "3_bhoehl", M_GO, "in die Hoehle");
      return 1;
    }
  
  return 0;
}
 

