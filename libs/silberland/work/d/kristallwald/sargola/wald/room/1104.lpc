#include "../def.h"
#include "wald.h"

inherit "std/room";

nosave int anzahl;

void create()
{
  ::create();

  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
  
  anzahl = 1;
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "Der Kristallwald");
  SetProp(P_INT_LONG, 
	  BS("Du stehst mitten im Kristallwald. Neben Dir ragen ueberall "
	     "starke Staemme in die Hoehe und Straeucher erschweren Dir "
	     "das Fortkommen. Im Nordwesten scheint eine kleine Lichtung "
	     "zu liegen."));
  
  SetProp(P_INDOORS,0);
  
  STANDARD1
  STANDARD2
  AESTE_NICHT_RAUF  

  AddDetail(({"gras","graeser"}),
	    "Es knirscht bei jedem Deiner Schritte. Du bemerkst ein Funkeln "
	    "zwischen den Halmen.");
  
  AddDetail(({"grashalme","halme"}),
	    "Es sind schlichte Grashalme.");
	
  AddDetail("funkeln",
	    "Hmm, dem solltest du nachgehen.");
  
  AddItem(NPC "schroe", REFRESH_DESTRUCT);
  AddItem(NPC "schroe", REFRESH_DESTRUCT);
  AddItem(NPC "schroe", REFRESH_DESTRUCT);
  
  AddCmd(CMD_DURCHSUCHEN, "durchsuche");
  
  AddExit("norden", ROOM "1103");
  AddExit("westen", ROOM "1004");
  AddExit("nordwesten", ROOM "1003");
}  

void reset()
{
  ::reset();
  anzahl = 1;
}

nosave int durchsuche(string str)
{
  object ei;

  notify_fail("Was moechtest Du denn durchsuchen?\n");
  if(!str) return 0;

  if(str=="gras")
    if(anzahl)
      if(random(4)==1)
	{
	  ei=clone_object(OBJ "mondei");
	  
	  if(ei->move(TP, M_GET)==ME_TOO_HEAVY)
	    {
	      ei->remove(1);
	      return write(BS("Du beginnst, das Gras zu durchwuehlen und "
			      "findest rasch den Grund fuer das Funkeln. Es "
			      "ist ein Ei aus Kristall! Es ist bestimmt sehr "
			      "wertvoll, nur leider kannst Du es nicht mehr "
			      "tragen und laesst es liegen.")), 1;
	    }

	  write(BS("Du beginnst, das Gras zu durchwuehlen und "
		   "findest rasch den Grund fuer das Funkeln. Es ist "
		   "ein Ei aus Kristall! Der ist bestimmt sehr "
		   "wertvoll!"));

	  anzahl = 0;

	  return 1;
	}
      else
	return write(BS("Du beginnst, das Gras zu durchwuehlen und "
			"stellst enttaeuscht fest, dass es nur das "
			"Sonnenlicht war... Oder etwa doch nicht?")), 1;
    else
      return write(BS("Du wuehlst im Gras herum, findest aber nichts.")), 1;

  return 0;
}	
