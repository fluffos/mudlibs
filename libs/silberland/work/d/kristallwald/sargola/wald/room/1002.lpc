//#pragma strong_types

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/kristallwald/sargola/def_kristall.h"      
#include "wald.h"

void create()
{
  ::create();
  
     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]) );
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Der Kristallwald" );
  SetProp( P_INT_LONG, BS("Du stehst mitten im Kristallwald. Neben Dir ragen ueberall "
      +"starke Staemme in die Hoehe und Straeucher erschweren Dir das Fortkommen. "
      +"Pass auf, dass Du Dich hier nicht verlaeufst! Im Sueden scheint eine kleine "
      +"Lichtung zu liegen.") );

  SetProp(P_INDOORS,0);
  
  STANDARD1
  STANDARD2
  AESTE_NICHT_RAUF
  
    AddExit("norden",ROOM_WALD+"1001.lpc");
    AddExit ("osten",ROOM_WALD+"1102.lpc");
    AddExit("westen",ROOM_WALD+"0902.lpc");
    AddExit("suedosten",ROOM_WALD+ "1103.lpc");
    AddExit("suedwesten",ROOM_WALD+ "0903.lpc");
    AddExit("sueden",ROOM_WALD+"1003.lpc");

    AddItem("/d/unterwelt/clementine/polstadt/npc/anamcara", REFRESH_DESTRUCT);

}