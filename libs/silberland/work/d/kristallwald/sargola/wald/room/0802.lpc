#include "../def.h"
#include "wald.h"

inherit "std/room";

#define TURM "/d/kristallwald/protheg/turm/room/turm_anteroom"

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
     
  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "Der Kristallwald");
  SetProp(P_INT_LONG, 
	  BS("Du stehst mitten im Kristallwald. Neben Dir ragen ueberall "
	     "starke Staemme in die Hoehe und Straeucher versperren Dir den "
	     "Weg. Einer der Straeucher scheint etwas seltsam geformt zu sein."
	     " Pass auf, dass Du Dich hier nicht verlaeufst!"));
  
  SetProp(P_INDOORS,0);

  STANDARD1
  STANDARD2
  AESTE_NICHT_RAUF

  AddDetail(({"strauch","straeucher"}),
	    "Hier stehen ueberall Straeucher herum und versperren Dir den Weg."
	    " Nur ein ganz schmaler Durchschlupf nach Nordwesten scheint frei "
	    "zu sein.");  
  
  AddDetail(({"durchgang","durchschlupf"}),
	    "Tatsaechlich, da befindet sich ein kleiner Durchschlupf nach "
	    "Nordwesten. Was dort wohl ist?");

  AddExit("osten", ROOM "0902");
  AddExit("suedwesten", ROOM "0703");
  AddExit("suedosten", ROOM "0903");
  AddExit("sueden", ROOM "0803");
  
  AddCmd(({"schluepfe","schluepf","schlupf","schlupfe","kletter","klettere",
	     "kriech","krieche"}), "cmd_schluepfen");
  
  AddItem (NPC "fuchs", REFRESH_DESTRUCT);
}

nosave int cmd_schluepfen(string str)
{
  notify_fail(BS("Wo willst Du denn hin?"));
  if(!str) return 0;
  
  if(str=="in durchschlupf"||str=="durch durchschlupf"||str=="nach nordwesten")
    {
      if(TP->QueryProp(P_LEVEL)<=2)
	return write(BS("Du glaubst, dass Du noch viel zu klein bist fuer die "
			"Abenteuer, die Dich hinter dem Strauch erwarten...")), 1;
      
      write(BS("Vorsichtig schluepfst Du durch den Durchschlupf..."));

      TP->move(TURM, M_GO|M_SILENT);

      tell_room(ME, BS(TPN+" verschwindet in einem der Straeucher."));
      
      tell_room(find_object(TURM), BS(TPN+" schluepft herein."), ({TP}));
      
      return 1;
    }

  return 0;
}
