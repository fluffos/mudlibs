#include "../def.h"

inherit "std/room";

nosave int ist_tier_da;   

void create()      
{ 
  ::create();

  ist_tier_da =1;

  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
     
  SetProp(P_INT_SHORT, "Der Kristallwald");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich auf einem Baum, der wohl schon bessere "
	     "Zeiten erlebt hat. Er hat fast keine Aeste mehr, sie sind alle abgestorben. "
	     "Auch die, auf denen Du Dich befindest, sind sehr sproede. Es scheint, als "
	     "waere alles Leben aus ihm gewichen."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail(({"ast","aeste" }), 
	    "Beweg Dich nur nicht zuviel....");

  AddDetail("boden",
	    "Den siehst Du weit unter Dir.");

  AddDetail("himmel",
	    "Der Himmel schimmert blaeulich durch die Zweige der Baeume durch.");

  AddDetail("baeume",
	    "Die stehen hier ueberall herum.");

  AddDetail("zweige",
	    "Sie lassen den blau leuchtenden Himmel durchscheinen.");	

  AddDetail("zeiten", 
	    "Zumindest jetzt geht es ihm nicht so gut...");

  AddDetail("baum", 
	    "Aus irgendeinem Grund scheint er krank zu sein.");

  AddDetail("leben", 
	    "Davon ist hier nichts mehr zu bemerken.");

  AddDetail("grund", 
	    "Vielleicht siehst Du Dir das mal genauer an...");

  AddDetail("stamm", 
	    "Er scheint fast ausgehoehlt zu sein. Bei genauerem "
	    "Hinsehen kannst Du ein Loch an der Rueckseite des Stammes entdecken.");

  AddDetail("loch", 
	    "Ein schwarzes Loch - fast schon eine kleine Hoehle...");

  AddDetail("hoehle", 
	    "Du kannst nur durch Reinstarren nichts weiter entdecken.");

  AddDetail(({"starren","reinstarren"}), 
	    "Richtig! Du fixierst das Loch und "
	    "kommst auch nicht weiter.. hm...");

  AddExit("runter", ROOM "0902");

  AddCmd(({"greif", "greife"}), "greif_stamm");
}

nosave int greif_stamm(string str)
{
  object ob;      
  
  notify_fail(BS("Wo willst Du hingreifen?"));
  if(!str) return 0;

  if(str=="in loch" || str =="ins loch")
    if(ist_tier_da)
      {
	write(BS("Du steckst vorsichtig Deine Hand in das Loch und fuehlst "
		 "etwas Warmes - ein Fell vermutest Du. Gleich darauf "
		 "durchdringt ein fuerchterlicher Schmerz Deine Hand und Du "
		 "ziehst sie hasserfuellt wieder raus."));

	if(!present("teufel")) 
	  {
	    (ob=clone_object(NPC "teufel"))->move(TO, M_GO);
	    
	    if(!IS_LEARNING(TP))             
	      ob->Kill(TP);
	    
	    ist_tier_da =0;
	  }
	
	return 1;
      }
    else
      return write(BS("Du fuehlst Waerme in dem kleinen Loch...")), 1;
  
  return 0;
}

reset()
{   
  ::reset();
  
  ist_tier_da=1;
}
 

