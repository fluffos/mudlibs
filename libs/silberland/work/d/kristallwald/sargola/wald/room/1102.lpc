//#pragma strong_types

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/kristallwald/sargola/def_kristall.h"      
#include "wald.h"

void create()
{
  ::create();
  
     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]) );
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Der Kristallwald" );
  SetProp( P_INT_LONG, BS("Hier stehen die Baeume nicht so gedraengt wie sonst im Kristall"
      +"wald. Straeucher wachsen um Dich herum. Im Suedwesten scheint eine "
      +"Lichtung zu sein. Pass auf, dass Du Dich hier nicht verlaeufst!") );

  SetProp(P_INDOORS,0);

  STANDARD1
  STANDARD2
  AESTE_NICHT_RAUF
  
  AddDetail("lichtung",
  	BS("Mehr, als dass keine Baeume dort sind, kannst Du nicht erkennen."));

  AddItem(NPC_WALD+"gkroete.lpc", REFRESH_DESTRUCT);
  AddItem(NPC_WALD+"gkroete.lpc", REFRESH_DESTRUCT);  



    AddExit("nordwesten",ROOM_WALD+"1001.lpc");
    AddExit("westen",ROOM_WALD+"1002.lpc");
    AddExit("suedwesten",ROOM_WALD+ "1003.lpc");
    AddExit("sueden",ROOM_WALD+"1103.lpc");
    AddExit("osten", "/d/kristallwald/clementine/wassertroepfchen/weg/weg1");
   
    
}  

