#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
  
  SetProp(P_INT_SHORT, "Aeste im Kristallwald");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich auf einer stabil wirkenden Eiche und hast "
	     "Dich fest in einer der Astgabeln verkeilt. Im Sueden siehst Du "
	     "durch die Zweige den See leuchten und im Westen beginnt sich "
	     "in der Ferne ein Gebirge zu erheben. Du hoerst "
	     "Vogelgezwitscher."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail("himmel",
	    "Der Himmel schimmert blaeulich durch die Baeume durch.");
  
  AddDetail("baeume",
	    "Ueberall siehst Du hier die weisslichen Eichen wachsen.");

  AddDetail("gebirge",
	    "Es ist durch die Zweige fast nicht mehr zu erkennen.");

  AddDetail("ferne",
	    "Die ist so weit weg...");
  
  AddDetail(({ "vogelgezwitscher", "gezwitscher" }), 
	    "Der Onyxschnabelweber singt sein Brunftlied vermutest Du.");
  
  AddDetail(({"almandin","almandin-gebirgszug","gebirgszug"}),
	    "Du hast schon von diesem sagenumwobenen Gebirge gehoert. "
	    "Aber keiner hat es geschafft, dieses Gebirges zu passieren...");
  
  AddDetail(({"weibchen","brunftlied","lied"}),
	    "Das ist ein Lied, um Weibchen anzulocken...");
  
  AddDetail(({"ast","astgabel","gabel"}),
	    "Auf ihr kannst Du sicher laengere Zeit bleiben.");
  
  AddDetail("eiche", 
	    "Sie genauso wie die anderen, die Du hier schon gesehen hast.");
  
  AddDetail(({"aeste","zweige"}), 
	    "Neben Dir sind sie schon recht licht, weil die Baeume "
	    "niedriger sind als der, auf dem Du stehst.");
  
  AddDetail("see", 
	    "Tiefer unten breitet sich der See vor Dir aus.");
  
  AddDetail("gebirge", 
	    "Im Westen erhebt sich der Almandin-Gebirgszug.");
  
  AddDetail(({"onyxschnabelweber","schnabelweber"}), 
	    "Er ist ein suesser, kleiner Vogel mit bunt schimmernden "
	    "Fluegeln und einem weiss-silbern glaenzenden Kopf.");
  
  AddSound(({DEFAULT_SOUND, "lied","brunftlied","schnabler","onyxschnabler"}),
	   "Du hoerst das Brunftlied eines Onyxschnablers. Das erkennst man "
	   "leicht an dem melodischen Zwitschern.");
  
  AddSound(({"zwitschern"}),
	   "Der Onyxschnabler gibt sanfte, langsame Pfiffe von sich und "
	   "will Weibchen damit einlullen.");
  
  AddSound("pfiffe",
	   "Sie klingen lieblich - kein Weibchen kann da widerstehen.");
  
  AddExit("runter", ROOM "0904");     
}
