#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
     
  SetProp(P_INT_SHORT, "Eine Eiche im Kristallwald");
  SetProp(P_INT_LONG, 
	  BS("Du bist 10 oder 12 Meter vom Boden entfernt und hast trotzdem "
	     "einen festen Ast zum Sitzen gefunden. Ein grossartiger Ausblick "
	     "erfreut Dich: Im Westen kannst Du das maechtige "
	     "Almandin-Gebirge sehen, das schroff gen Himmel ragt, im Sueden "
	     "kannst Du schemenhaft den See von Rhondonit erkennen. Nach oben "
	     "geht es noch ein gutes Stueck weiter."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
     
  AddDetail(({"ast","aeste" }), 
	    "Obwohl Du schon weit oben bist, sind sie hier ziemlich stark.");

  AddDetail("himmel",
	    "Er leuchtet blau ueber Dir.");

  AddDetail(({"baum","eiche"}), 
	    "Der Baum ist wesentlich groesser als alle anderen hier. Du "
	    "glaubst, weiter oben etwas Dunkles erkennen zu koennen.");

  AddDetail(({"waldboden","boden"}), 
	    "Du haeltst Dich ein wenig fester fest. Die Sicht auf den "
	    "Waldboden ist nichts fuer Hasenfuesse.");
	
  AddDetail(({"ausblick","sicht"}),
	    "Der Ausblick hier ist schon ueberwaeltigend. Nur darfst Du nicht "
	    "nach unten schauen.");

  AddDetail("zweige",
	    "Die Zweige der Eiche ragen in alle Richtungen und sind noch "
	    "recht stark.");

  AddDetail("hasenfuesse",
	    "Oha! Bist Du etwa einer??");

  AddDetail("ausblick", 
	    "Weiter oben muesste man noch weiter sehen koennen...");

  AddDetail(({"efeu","flechte"}), 
	    "Die Rinde des Stammes ist gar nicht zu sehen, so stark behangen "
	    "ist der Stamm von Efeu und den Flechten.");

  AddDetail(({"gebirge","fels", "almandin-gebirge","almandin"}), 
	    "Du fuehlst Dich richtig klein wenn die Naturgewalten sich neben "
	    "Dir aufbaeumen.");

  AddDetail(({"see von rhondonit","rhondonit", "see"}),
	    "Er liegt ruhig in Form einer Mondsichel weit unten im Sueden.");
  
  AddDetail(({"form","sichel","mondsichel"}),
	    "Eine silbern glaenzende Sichel - wunderschoen...");
  
  AddDetail(({"gewalten","naturgewalten"}), 
	    "Das Almandin-Gebirge ist wahrlich imposant.");

  AddDetail("rinde", 
	    "Die Rinde ist kaum zu sehen unter dem Efeu und den vielen "
	    "Flechten.");         
     
  AddExit("rauf", ROOM "3_0602");
  AddExit("runter", ROOM "1_0602");
}
