#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
     
  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "Der Kristallwald");
  SetProp(P_INT_LONG, 
	  BS("Du stehst mitten im Kristallwald. Neben Dir ragen ueberall "
	     "starke Staemme in die Hoehe und Straeucher erschweren Dir "
	     "das Fortkommen. Pass auf, dass Du Dich hier nicht verlaeufst!"));
  
  SetProp(P_INDOORS,0);

  AddDetail("blau",
	    "Das Blau ist ja versteckt! Das kann man nicht so einfach "
	    "untersuchen...");  

  AddSound(DEFAULT_SOUND,
	   "Du hoerst das Klingen der Blaetter im Wind.");

  AddSound(({"singen", "blaetter", "blatt","klingen"}), 
	   "Die Blaetter schwingen sanft mit "
	   "dem Wind und verursachen dadurch ein leises Singen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht hier nach - eigentlich nach nichts!");

  AddDetail("boden",
	    "Der Boden ist mit Graesern ueberzogen, die leise knirschen, wenn "
	    "Du sie zertrittst. Weiters entdeckst Du Blaetter, Zweige und "
	    "kristallines Gestein.");

  AddDetail("himmel",
	    "Hie und da scheint das Blau des Himmels durch. Meist jedoch wird "
	    "es von den Aesten verdeckt. Durch die Loecher faellt das Licht "
	    "wie Saeulen auf den Boden.");

  AddDetail("blau",
	    "Es ist aber nicht immer blau - durch Wolken scheint es manchmal "
	    "eher weiss durch.");

  AddDetail(({"wolke","wolken"}),
	    "Genaueres kannst Du von hier nicht ersehen.");

  AddDetail(({"loch","loecher"}),
	    "Obwohl der Wald hier sehr dicht ist, gibt es doch "
	    "kleine Durchlaesse.");

  AddDetail(({"durchlass","durchlaesse"}),
	    "Hier dringt das Licht bis auf den Boden durch.");

  AddDetail("weg",
	    "Von einem Weg kann man eigentlich nicht sprechen. In alle Himmels"
	    "richtungen fuehren hier die Wege.");

  AddDetail("himmelsrichtungen", 
	    "OK, fuer Anfaenger: Normalerweise fuehren Wege nach: Norden, "
	    "Sueden, Westen, Osten...");

  AddDetail(({"saeule","saeulen"}),
	    "Weisse Lichtkegel, die sehr unterschiedliche "
	    "Durchmesser haben.");

  AddDetail(({"kegel","lichtkegel"}),
	    "Es wirkt schoen hier, in dieser mystisch "
	    "erleuchteten Gegend.");

  AddDetail("gegend",
	    "Na der Kristallwald!");

  AddDetail("durchmesser",
	    "Manchmal sind die Kegel so stark wie der Durchmesser eines "
	    "Tisches, manchmal aber so duenn wie ein glaeserner Dolch, "
	    "der sich in den Boden rammt.");

  AddDetail(({"tisch","tische"}),
	    "So ein bis zwei Meter halt.");

  AddDetail(({"dolch","dolche"}),
	    "Es sieht aus, als wuerden sie direkt vom Himmel "
	    "hier in den Boden schiessen...");

  AddDetail(({"strauch","straeucher"}),
  //ZEILE 100
	    "Die stehen hier ueberall herum und versperren "
	    "dir den Weg.");

  AddDetail(({"erkundungsgang","fortkommen"}),
	    "Dein Erkundungsgang durch den Wald ist damit gemeint.");

  AddDetail(({"gras","graeser"}),
	    "Es ist die Sorte von Gras, mit der man so schoen Hahn "
	    "und Henne spielen kann.\n");

  AddDetail(({"hahn","henne", "hahn und henne"}),
	    "Du nimmst ein Gras, ziehst es so zwischen Deinen Fingern "
	    "durch und schaust dann, ob es eine runde Kuppe geworden ist. "
	    "Dann ist es Henne, wenn es einen Schweif hat, ist es Hahn. "
	    "Probier es doch einmal.");

  AddDetail(({"finger","finger"}),
	    "Du musst sie zusammenpressen, sonst wird das nix.");

  AddDetail(({"kuppe","schweif"}),
	    "Wenn Du es nicht ausprobierst, wirst Du auch keine "
	    "Kuppe und keinen Schweif sehen!");

  AddDetail(({"blatt","blaetter"}),
	    "Abgefallene Blaetter, weiter nichts.");

  AddDetail(({"zweige","zweig"}),
	    "Kleinere Zweige liegen auch vereinzelt herum.");

  AddDetail(({"stamm","staemme"}),
	    "Du siehst den Wald vor lauter Staemmen nicht mehr - "
	    "oder irgendwie so heisst das doch...");

  AddDetail("hoehe",
	    "Die Staemme sind gut und gern 10 Meter hoch.");

  AddDetail(({"wald","kristallwald"}), 
	    "Weissliche Staemme des Kristallwaldes umgeben Dich hier.");

  AddItem(NPC "keiler", REFRESH_DESTRUCT);

  AddExit("suedosten", ROOM "1102");
  AddExit("suedwesten", ROOM "0902");
  AddExit("sueden", ROOM "1002");
}  
 

