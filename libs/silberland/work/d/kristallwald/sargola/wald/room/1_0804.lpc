inherit "std/room";

#include <properties.h>
#include <language.h>

#include "/d/kristallwald/sargola/def_kristall.h"

      create()
      {
        ::create();
     

     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]) );
     
   SetProp( P_INT_SHORT, "Aeste im Kristallwald" );
   SetProp( P_INT_LONG, 
	BS("Dies ist die letzte Eiche vor dem See, der sich suedlich unter "
	+"Dir ausbreitet. Ueberwaeltigt von der Schoenheit des "
	+"Sees bleibst Du erst einmal stehen und staunst. Vom Westen her "
	+"beginnend formt er eine umgedrehte Mondsichel, unter der "
	+"wieder Kristalleichen wachsen."));
     
        SetProp( P_LIGHT, 1 );
        SetProp( P_INDOORS, 0 );
     
   AddDetail("boden",
   	BS("Der Boden liegt einige Meter unter Dir."));
   
   AddDetail("himmel",
   	BS("Ueber Dir kannst Du den Himmel durch die Aeste durch schimmern "
   	+"sehen."));
   
   AddDetail("kristalleichen",
   	BS("Von hier aus kannst Du nichts Genaues erkennen."));
   		
   AddDetail( ({ "almandin", "almandin-gebirgszug", "gebirgszug" }), 
	BS("Du hast schon von diesem sagenumwobenen Gebirge gehoert. Aber "
	+"keiner hat es geschafft, dieses Gebirge zu passieren..." ));

   AddDetail( "lied", 
	BS("Das ist ein Lied, um Weibchen anzulocken..."));

   AddDetail( "eiche", 
	BS("Sie ist genau wie die anderen, die Du hier schon gesehen hast."));

   AddDetail( ({"see von rhondonit","see","rhondonit"}), 
	BS("Suedlich unter Dir breitet sich der See aus. Leichte Wellen "
	+"bringen die Oberflaeche zum Funkeln."));

   AddDetail( "gebirge", 
	BS("Im Westen erhebt sich der Almandin-Gebirgszug."));

   AddDetail( "almandin", 
	BS("Ja so nennt man ihn: Almandin-Gebirgszug."));
        
   AddDetail(({"sichel","mondsichel"}),
	BS("Erstaunlich! Der See hat wirklich die Form einer Sichel."));

   AddDetail("baeume",
	BS("Davon gibt es hier ja wirklich genug."));

   AddDetail("aeste",
   	BS("Sie formen eine schuetzende, geraeumige Kapsel."));
   
   AddDetail("funkeln",
   	BS("Es entsteht durch das Brechen des Sonnenlichtes an den Wellen."));
   
   AddDetail( ({"sonne","licht","sonnenlicht"}),
   	BS("Du solltest nicht direkt in die Sonne schauen!"));
   
   AddDetail("kapsel",
   	BS("Sie wird von den Aesten geformt."));
   
   AddDetail("form",
   	BS("Die Form sieht aus wie eine Sichel."));
   			
   AddDetail( "oberflaeche", 
	BS("Leise und doch immer in Bewegung plaetschert das Wasser gegen "
	+"das Ufer."));

   AddDetail("bewegung",
	BS("Das Wasser stroemt gegen das Ufer, um sich ein paar Sekunden "
	+"spaeter wieder zurueckzuziehen."));

   AddDetail("wasser",
	BS("Es plaetschert in leichten Wellen ans Ufer."));


   AddDetail("ufer", 
	BS("Es liegt unter Dir."));

   AddDetail( ({"wellen","welle"}), 
	BS("Sie gurgeln sanft und gleichmaessig."));

   AddSound( ({"gurgeln","plaetschern"}),
   	BS("Du hoerst ein sanftes Gurgeln vom Ufer."));
   
        AddExit( "runter", ROOM_WALD+"0804.lpc" );

      }
     
 

