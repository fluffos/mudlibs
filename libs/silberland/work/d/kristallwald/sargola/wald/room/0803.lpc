#include "../def.h"
#include "wald.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
     
  SetProp(P_INT_SHORT, "Der Kristallwald");
  SetProp(P_INT_LONG, 
	  BS("Du stehst mitten im Kristallwald. Neben Dir ragen ueberall "
	     "starke, weisse Staemme in die Hoehe und Straeucher "
	     "erschweren Dir das Fortkommen. Pass auf, dass Du Dich hier "
	     "nicht verlaeufst!"));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS,0);
  
  STANDARD1
  STANDARD2
  AESTE_NICHT_RAUF
      
  RemoveDetail(({"gras","graeser"}));
  
  AddDetail(({"gras","graeser"}),
	    "Es ist die Sorte von Gras, mit der man so schoen Hahn " 
	    "und Henne spielen kann.");
	
  AddDetail(({"hahn","henne", "hahn und henne"}),
	    "Du nimmst ein Gras, ziehst es zwischen Deinen Fingern durch "
	    "und schaust dann, ob es eine runde Kuppe geworden ist. Dann ist "
	    "es Henne, wenn es einen Schweif hat, ist es Hahn. Probier es "
	    "doch einmal.");
  
  AddDetail(({"finger","finger"}),
	    "Du musst sie zusammenpressen, sonst wird das nix.");
  	
  AddDetail(({"kuppe","schweif"}),
	    "Wenn Du es nicht ausprobierst, wirst Du auch keine "
	    "Kuppe und keinen Schweif sehen!");
  
  AddCmd(({"spiel", "spiele"}), "spiel");
  
  AddExit("osten",ROOM "0903");
  AddExit("norden",ROOM "0802");
  AddExit("westen",ROOM "0703");
  AddExit("nordosten",ROOM "0902");
  AddExit("suedosten",ROOM "0904");
  AddExit("sueden",ROOM "0804");
}  

nosave int spiel(string str)
{
  notify_fail(BS("Was moechtst Du spielen?"));
  if(!str) return 0;
  
  if(str !="hahn" && str!="henne") 
    return write(BS("Hahn oder Henne musst Du sagen!")), 1;
   
  switch(random(4))
    {
    case 0:      //HENNE
      if(str=="henne")
	return write(BS("Schoen vorgelegt: Du hast wirklich eine Henne!")), 1;

      return write(BS("Schade, verloren. Es ist eine Henne geworden.")), 1;

    case 1:    //HAHN
      if(str=="hahn")
	return write(BS("Schoen vorgelegt: Du hast wirklich einen Hahn!")), 1;
      
      return write(BS("Schade, verloren. Es ist ein Hahn geworden.")), 1;

    default: 

      return write(BS("Komisch - das ist ein seltsames Mittelding zwischen "
		      "Henne und Hahn. Du versuchst es wohl nochmal.")), 1;
    }
}
