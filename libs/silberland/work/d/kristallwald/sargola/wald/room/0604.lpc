#include "../def.h"

inherit "std/room";

#define ANSCHLUSS "/d/kristallwald/protheg/elessar/room/kreis"

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
  
  SetProp(P_INT_SHORT, "Der Kristallwald");
  SetProp(P_INT_LONG, 
	   BS("Du gehst einen kleinen Weg entlang, der vom Wald im Norden "
	      "zum Ufer des Sees fuehrt. Neben dem Weg siehst Du nur mehr "
	      "vereinzelt Baeume stehen. Im Norden siehst Du die grosse "
	      "Eiche, westlich erhebt sich das Gebirge. Etwas abseits vom "
	      "Weg befinden sich einige hohe Felsen."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);  

  AddDetail(({"fels","felsen"}),
	    "Die Felsen ragen recht hoch in den Himmel und scheinen eine "
	    "Art Kreis zu bilden...");
  
  AddDetail(({"steinkreis","felskreis","felsenkreis","kreis"}),
	    "Die Felsen scheinen einen perfekten und undurchdringbaren "
	    "Kreis zu bilden, jedenfalls kannst Du keinen Eingang oder "
	    "sonstiges entdecken.");
  
  AddDetail(({"eingang"}),
	    "Du kannst keinen Eingang erkennen, doch an einem der Felsen "
	    "erkennst Du einen seltsam geformten Fleck.");
  
  AddDetail(({"fleck","form","hand","elfenhand"}),
	    "Der Fleck hat die Form einer elfischen Hand, mehr faellt Dir "
	    "dazu nicht ein.");
  
  AddDetail("boden", 
	    "Hier beginnt allmaehlich eine Art Wiese, in Richtung Wald "
	    "nehmen Blumen und Farne ueberhand.");

  AddDetail("himmel", 
	    "Der Himmel liegt tiefblau ueber Dir.");

  AddDetail("weg", 
	    "Er fuehrt von Nordwesten nach Suedosten zu einem See.");

  AddDetail("eiche", 
	    "So einen riesigen Baum hast Du noch nie gesehen. Du solltest "
	    "ihn Dir mal naeher ansehen.");

  AddDetail("wald", 
	    "Von aussen hat er fast eine majestaetische Schoenheit. Doch "
	    "genauso schoen wie er ist, so gefaehrlich kann er auch sein.");

  AddDetail("schoenheit", 
	    "Mit seinen kristallinen Baeumen wirkt er fast maerchenhaft.");
  
  AddDetail(({"blumen", "blume"}), 
	    "Alle moeglichen Sorten von Blumen mit roten, gelben und "
	    "orangen Blueten findest Du hier ebenso wie Farne.");

  AddDetail(({"welle","wellen"}), 
	    "Die Wellen schlagen sanft am Ufer auf.");

  AddDetail("wiese", 
	    "Ein gemuetlicher Platz, um auszuspannen und einmal mit "
	    "einer Person, die Du sehr magst, hierherzukomemn....\n");

  AddDetail(({"see","ufer"}), 
	    "Einen kleinen Teil davon kannst Du im Suedosten entdecken.");

  AddDetail(({"blueten","farne","flora"}), 
	    "Du bist leider in der Flora nicht so bewandert.\n");

  AddDetail("baeume", 
	    "Sie umzingeln Dich von allen Seiten...");

  AddDetail("baum", 
	    "Imposant ist fast zu schwach, um ihn zu beschreiben.");

  AddDetail(({"gebirge","almandin-gebirge"}), 
	    "Es baut sich bedrohlich vor Dir auf.");
  
  AddSound(DEFAULT_SOUND, 
	   "Du hoerst hin und wieder einen Vogel singen.");

  AddSound(({"wellen","gurgeln"}) , 
	   "Sanft schlagen die Wellen an das Ufer.");
  
  AddSmell(({"pflanzen",DEFAULT_SMELL}),
	   "Die Pflanzen sind leider geruchslos.\n");

  AddCmd(({"leg","lege","drueck","druecke"}), "hand_auflegen");
  
  AddExit("nordwesten", ROOM "0503");
  AddExit("norden", ROOM "0603");
  AddExit("suedosten", WALD_SEE);
}

nosave int hand_auflegen(string str)
{
  notify_fail(BS("Auf was willst Du Deine Hand legen?"));
  if(!str) return 0;
  
  if(str=="hand auf fleck" || str=="hand auf abdruck")
    {
      if(TP->QueryProp(P_LEVEL) < 15)
	return write(BS("Du hebst die Hand, doch dann senkst Du sie wieder, "
			"denn Du fuehlst Dich noch zu jung fuer die Gefahren, "
			"die innerhalb des Felsenkreises auf Dich warten "
			"koennten...")), 1;

      if(TP->QueryProp(P_XP) < 2000000)
	return write(BS("Du hebst die Hand, doch dann senkst Du sie wieder, "
			"denn Du fuehlst Dich nicht erfahren genug fuer die "
			"Gefahren, die innerhalb des Felsenkreises auf Dich "
			"warten koennten...")), 1;
      
      write(BS("Du hebst die Hand und legst sie auf den Fleck...")+
	    BS("In der naechsten Sekunde befindest Du Dich ganz woanders..."));
      
      TP->move(ANSCHLUSS, M_TPORT+M_SILENT+M_NO_SHOW);
      TP->AddSp(-2);

      tell_room(ME, 
		BS(TP->Name(WER)+" legt die Hand auf einen der Felsen und ist "
		   "ploetzlich nicht mehr da..."));

      return 1;
    }
  
  return 0;
}
