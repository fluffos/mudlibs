#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
  
  SetProp(P_INT_SHORT, "Der Kristallwald");
  SetProp(P_INT_LONG, 
	   BS("Direkt im Norden siehst Du eine riesige Eiche. Im Osten "
	      "erhebt sich der Kristallwald. Es ist ziemlich dunkel, da "
	      "die Zweige der Eiche im Nordwesten wenig Licht durch die "
	      "Baumkronen lassen und Du auch schon ziemlich nahe beim "
	      "Gebirge bist."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  AddDetail(({"ast","aeste" }), 
	    "Sie sind hier recht robust und beginnen erst in einigen Metern "
	    "Hoehe zu wachsen. Sie verhindern, dass die Sonnenstrahlen "
	    "diesen Platz hier erhellen.");

  AddDetail("baum", 
	    "Er ist wesentlich groesser als alle anderen hier.");

  AddDetail("eiche", 
	    "Sie muss wohl etwas Besonderes sein. Vielleicht solltest Du "
	    "einmal raufklettern und sie Dir genauer ansehen.");

  AddDetail(({"kristallwald","wald"}), 
	    "Wie gesagt: Du siehst hier, abgesehen vom riesigen Baum vor "
	    "Dir, wenig vom Kristallwald.");

  AddDetail("wipfel", 
	    "Die Wipfel sind sehr weit weg und schwer durch die Zweige zu "
	    "erkennen.");

  AddDetail("himmel",
	    "Den Himmel kannst Du wegen der riesigen Eiche nicht sehen.");

  AddDetail(({"gebirge","fels"}), 
	    "Du fuehlst Dich richtig klein, wenn die Naturgewalten sich "
	    "neben Dir aufbaeumen.");
  
  AddDetail("nahe", 
	    "Im Westen beginnt der Boden Richtung Gebirge schon anzusteigen.");

  AddDetail("naturgewalten", 
	    "Dieses Gebirge war sicherlich schon lange vor jedem Menschen "
	    "hier.");
  
  AddDetail(({"blatt","blaetter"}), 
	    "Sie verursachen durch das Aneinanderschlagen ein leises, "
	    "beruhigendes Klingen.");	

  AddDetail("boden", 
	    "Der Boden wird von Zweigen und Blaettern verdeckt.");

  AddDetail("zweige",
	    "Sie stammen von der Eiche.");

  AddDetail(({"blaetter","blatt"}), 
	    "Es wird wohl die Eiche neben Dir gewesen sein, die "
	    "die Blaetter abwarf.");

  AddDetail(({"kronen","krone","baumkrone","baumkronen"}), 
	    "Wenn Du die sehen willst, dann musst Du schon weiter nach oben "
	    "klettern!");

  AddDetail("licht", 
	    "Die ausladenden Zweige der Eiche im Westen hindern das Licht "
	    "am ungehinderten Scheinen.");
  
  AddExit("norden", ROOM "0602");
  AddExit("osten",  ROOM "0703");
  AddExit("westen", ROOM "0503");
  AddExit("sueden", ROOM "0604");     
}
