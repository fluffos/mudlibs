#include "../def.h"

inherit "std/npc";

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Keiler");
  SetProp(P_LONG, 
	  BS("Ein gewaltiger Keiler steht vor Dir mit leicht geoeffnetem "
	     "Maul und gut sichtbaren Hauern. Er starrt Dich aus boesen "
	     "Augen an."));
  SetProp(P_NAME, "Keiler");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"schwein","wildschwein","keiler"}));
  SetProp(P_RACE, "Wildschwein");
  
  AddDetail(({"auge", "augen"}), 
	    "Er beobachtet Dich aus fast geschlossenen "
	    "Augen. Keine Deiner Bewegungen ist unbeobachtet.");
  AddDetail("bewegung", 
	    "Du solltest vorsichtig sein und Dich nicht schnell bewegen.");

  create_default_npc(11);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_SIZE, 67);
  SetProp(P_WEIGHT, 121342);
  SetProp(P_BODY, 50);
  SetProp(P_HANDS, ({" mit seinen spitzen Hauern", 110, DT_RIP}));
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, 50);

  SetProp(P_MSGIN, "laeuft herein");
  SetProp(P_MSGOUT, "laeuft");

  SetProp(P_DIE_MSG,  " grunzt und stirbt.\n");
  SetProp(P_REJECT, ({REJECT_DROP,
    "Der Keiler will Deine Sachen nicht tragen.\n"}));

  SetAttackChats(10, ({
    "Der Keiler springt wild hin und her.\n",
      "Der Keiler fletscht die Hauer.\n",
      "Der Keiler springt Dich an.\n",
      "Der Keiler grunzt boese.\n"}));
} 
