//      WELCOME!
//   
//   Quarz-Schroeter
//
//   * wenn er stirbt, kommt der
//   grosse Bruder! ;)
//   date: 09-01-96, 22:46
//   versio: 0.2
//   
inherit "std/npc";
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/kristallwald/sargola/def_kristall.h"
string gschroeter (string str);

int gegner;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
   gegner = 0;
  SetProp(P_SHORT, "Ein Quarzschroeter");
  SetProp(P_LONG, BS(
    "Der Schroeter scheint aus reinem Quarz zu bestehen und trotzdem recht lebendig zu sein!"));
  SetProp(P_NAME, "Quarzschroeter");
  SetProp(P_GENDER, MALE);
  AddId( ({"schroeter","quarzschroeter"}) );
  
  create_default_npc(7);
  SetProp(P_BODY,55);
  SetProp(P_HEAL,10);
  SetProp(P_HANDS, ({" mit seinen Zangen", 50, DT_RIP}));
  SetProp(P_RACE, "Kaefer");
  SetProp(P_SIZE, 10);
  SetProp(P_ALIGN, -70);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_DIE_MSG, " sackt in sich zusammen.\n");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "krabbelt herein");
  SetProp(P_MMSGOUT, "krabbelt weit weg");
  AddInfo(DEFAULT_INFO, "knackst nur leise.\n");
  AddInfo("sargola", "teilt Dir mit: Sargola hat mich erschaffen.");
  AddInfo("quarz", "Die Greifzangen des Schroeters glaenzen gefaehrlich.");
  AddInfo(({"zangen","greifzangen"}), "Durch den harten Quarz wirken sich noch spitzer.");
  SetProp(P_REJECT, ({ REJECT_DROP, 
    "Was soll der Schroeter damit?\n"}));
  SetChats(3, ({
    "Der Schroeter kneift Dich.\n",
    "Der Schroeter krabbelt Dein linkes Bein hoch.\n",
    "Der Schroeter beschaeftigt sich mit einem Blatt.\n",
    "Der Schroeter zwickt Dich mit seinen Zangen.\n"}) );
}
die(arg)
 {
  object gschroeter;
  if(gegner == 0)
{
  gschroeter = clone_object(NPC_WALD+"schroe.lpc");
  gschroeter->move(ENV(TO));
  gschroeter->Kill(ME);
  gegner = 1;
}

  ::die(arg);
}

