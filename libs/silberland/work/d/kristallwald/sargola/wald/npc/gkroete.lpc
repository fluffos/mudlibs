#include "../def.h"

inherit "std/npc";

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Granatkroete");
  SetProp(P_LONG, 
	  BS("Die Kroete hat granatartige Woelbungen am Ruecken, die "
	     "eine Art Panzerfunktion zu haben scheinen. Ob das Exemplar wohl "
	     "giftig ist? Durch seinen Panzer kann die Kroete nicht sehr weit "
	     "huepfen."));

  AddDetail(({"exemplar","kroete"}),
	    "Es scheint, als sei die Kroete halb versteinert. Sonst ist es "
	    "eine gewoehnlich Kroete.");

  SetProp(P_NAME, "Kroete");
  SetProp(P_GENDER, FEMALE);

  AddId(({"kroete", "granatkroete"}));

  SetProp(P_INFO, 
	  BS("Diese Kroete ist giftig!"));

  SetProp(P_DIE_MSG, " verschwindet zum Kroetengott.\n");
  
  create_default_npc(3);
  SetProp(P_HANDS, ({" mit ihrer langen Zunge", 
		       QueryProp(P_HANDS)[1]+5, DT_WHIP}));
  
  SetProp(P_RACE, "Kroete");
  SetProp(P_SIZE, 20);
  SetProp(P_WEIGHT, 150);
  SetProp(P_ALIGN, -150);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_MSGIN, "springt herein");
  SetProp(P_MSGOUT, "springt weiter.");

  AddInfo(DEFAULT_INFO, 
	  "lauert nur ahnungslosen Jungfliegen auf.\n");

  SetProp(P_HEAL, -10);

  AddInfo("sargola",
          "quakt: Er gibt mir nie was zu essen!"); 

  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Die Kroete nimmt keine Notiz von Deinem laecherlichen Versuch.\n"}));
}
 
