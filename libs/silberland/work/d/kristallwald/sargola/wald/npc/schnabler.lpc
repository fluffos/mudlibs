#include "../def.h"

inherit "std/npc";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Ein Onyxschnabler");
  SetProp(P_LONG, 
	  BS("Der Onyxschnabler sitzt still auf einem Ast und mustert Dich. "
	     "Sein Federkleid ist, wie der Name schon sagt, onyxfarben."));

  AddDetail(({"federn","federkleid"}),
	    "Seine Federn schimmern graeulich.");
  SetProp(P_NAME, "Onyxschnabler");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"onyxschnabler","schnabler"}));
  create_default_npc(5);
 
  SetProp(P_HANDS, ({" mit seinem kleinen Schnabel", 40, DT_PIERCE}));
  SetProp(P_ALIGN, 50);

  SetProp(P_MSGOUT, "flattert weiter");
  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MMSGIN, "flatter munter herein");
  SetProp(P_MMSGOUT, "flattert munter weiter");

  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 15);
  SetProp(P_WEIGHT, 650);
  SetProp(P_HEAL, 20);

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp(P_REJECT, ({REJECT_DROP,
    "Wie soll denn der Onyxschnabler das tragen koennen?\n"}));
}

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if(find_call_out("reaction") != -1) return;
  
  if(touch)
    call_out("reaction", 0, TP, 
	     "hackt Dir frech ins Bein.",
	     "hackt "+TP->name(WEM)+" frech ins Bein.", 1);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

varargs void reaction(object ob, string macher, string andere, int flag) 
{
  if(present(ob, MENV)) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    }
}
