//      WELCOME!
//   
//   Spinne
//
//   * kann nichts wesentliches ;)
//   * lebt auf Baeumen...
//   date: 11-01-96, 14:26
//   
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/kristallwald/sargola/def_kristall.h"

create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Eine Hoehlenspinne");
  SetProp(P_LONG, BS("Die Spinne, das erkennt man an den kleinen Augen, ist "
    "eine Hoehlenspinne, die selten das Tageslicht erblickt. "
    "Wenn sei im Freien ist, dann nur, um Nahrung zu beschaffen. Als e"
    "inzelnen Exemplar ist sie relativ ungefaehrlich, doch verfuegen "
    "sie ueber ein ausgekluegeltes Kommunikationssystem.\n"));
  AddDetail(({"exemplar","spinne"}),
    ("Sie ist ca. 5 cm gross - also keine direkte Bedrohung fuer Dich. Obwohl "
     "ihr Faden Dich kampfunfaehig machen kann, wenn Du unachtsam bist.\n"));
  AddDetail(({"nahrung","spinne"}),
   ("Ihre Faenge befoerdert sie in ihre Hoehle und verzehrt sie dort. Dabei "
    "wird das Opfer langsam mit zersetzendem Speichel umsabbert. Ihr ist es "
    "egal, ob das Opfer noch lebt. \n"));
 AddDetail(({"opfer","faenge", "fang"}),
    ("Besonders ergiebige Wesen fallen sie im Verband an - dann ist es "
     "meistum das arme Tier geschehen.\n"));
  AddDetail(({"faden","faden"}),
    ("Du wirst doch wohl einen Spinnenfaden kennen?!?\n"));
  AddDetail(({"system","kommunikation", "kommunikationssystem"}),
    ("Sie koordinieren ihre Angriffe ueber Ultraschall. Eine dieserr Spinnen "
      +"angreifen heisst, es mit der ganzen Sippe aufzunehmen.\n"));
  AddDetail( ({"organische","speichel"}),
    ("Der Speichel ist ihre toedlichste Waffe. Alles Organische, was er "
   +"beruehrt wird gandenlos zersetzt.\n"));
  SetProp(P_NAME, "Hoehlenpinne");
  SetProp(P_GENDER, FEMALE);
  AddId (({"hoehlenspinne", "spinne"}));

  SetProp(P_DIE_MSG, " krabbelt an einem Faden gen Himmel.\n");
  create_default_npc (4);
  SetProp(P_HANDS, ({" mit ihren Beinen", 30, DT_BLUDGEON}));
  SetProp(P_BODY, 30);
  SetProp(P_RACE, "Spinne");
  SetProp(P_SIZE, 15);
  SetProp(P_ALIGN, -150);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt weiter.");

  AddInfo(DEFAULT_INFO, ("Die Spinne zermalmt genuesslich einen Kaefer."));
  SetProp(P_HEAL, -20);
  AddInfo("sargola",
          "quiekt: Den wickel ich auch noch ein!\n"); 
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Die Spinne kann das mit ihrem Speichel nicht zersetzen.\n"}));

 SetChats (8, ({
    "Die Hoehlenspinne erwaegt, Dich doch zu fangen.\n",
    "Die Hoehlenspinne ueberlegt, wie sie Dich in ihre Hoehle kriegt.\n",
    "Die Hoehlenspinne beginnt, ein Netz zu stricken.\n",
  }) );
  SetProp(P_SPELLRATE,25);

  AddSpell(1,100,
   "Die Hoehlenspinne malmt mit ihren Fresswerkzeugen an Deinem Bein.\n",
   "Die Hoehlenspinne malmt mit ihren Fresswerkzeugen an @WESSEN Bein.\n",
   DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3,60,
   "Die Hoehlenspinne wickelt Dich in ihr Netz.\n",
   "Die Hoehlenspinne wickelt @WEN in ihr Netz.\n",
   DT_SLASH, ([SP_SHOW_DAMAGE:1]));

  SetAttackChats(15, ({
   "Die Hoehlenspinne schreit: 'Ich hab noch einen grossen Bruder!'\n",
   "Die Hoehlenspinne holt jetzt ihre Freunde zu Hilfe.\n",
   "Die Hoehlenspinne beschliesst, Dich doch gleich zu essen.\n"
                }) );


}

die(string arg)
{
   object ob;
   write(BS("Die Hoehlenspinne laesst einen fuerchterlichen Quietscher "
      +"aus. Vielleicht ruft sie damit andere Spinnen zu Hilfe...\n"));
   if(!present("spinne"))
   {
      ob = clone_object(NPC_WALD+"spinne.lpc");
      ob->move(environment(TP), M_GO);
      //ob->command("toete " +TP->query_real_name());
      ob->SetProp(P_AGGRESSIVE, 1);
   }
}

