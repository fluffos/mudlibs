#include "../def.h"

inherit "std/mnpc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  
  AddId(({"gsnake","gefiederte schlange","schlange"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_RACE, "Schlange");
  SetProp(P_NAME, "Schlange");
  SetProp(P_SHORT, "Eine gefiederte Schlange"); 
  SetProp(P_NAME_ADJ, "gefiedert");
  AddAdjective(({"gefiederte","gefiedert","gefiederter","gefiederten"}));
  
  SetProp(P_LONG,
	  BS("Eine Schlange, wie Du sie noch nie gesehen hast. Mit ihren "
	     "zwei Fluegeln kann sie zwar nicht fliegen, die spitzen Enden "
	     "koennen jedoch sicher grossen Schaden anrichten."));
  
  AddDetail("fluegel", 
	    "Sie sind klein, vermutlich kann sie damit nicht fliegen. In "
	    "frueheren Zeiten konnte das aber gut moeglich sein. An den "
	    "Enden verlaufen die Fluegel zu scharfen Spitzen.");
  
  AddDetail(({"spitze","spitzen"}), 
	    "Auf jedem Fluegel ganz am Ende und in der Mitte zwischen "
	    "Koerper und Fluegelende befinden sich verhaertete Spitzen, die "
	    "im Nahkampf sicher eine toedliche Waffen sein koennen. Sie "
	    "scheinen aus Horn zu bestehen.");
  
  AddDetail("ende", 
	    "Die Fluegel sind so einen Meter lang schaetzt Du.");

  AddDetail("meter", 
	    "Das sind 100 Centimeter.");

  AddDetail("horn", 
	    "Zumindest die Faerbung wuerde dem entsprechen.");

  AddDetail("centimeter", 
	    "Du untersuchst auch alles, richtig?");

  AddDetail("nahkampf", 
	    "Hoffentlich wacht sie nicht auf.");

  AddDetail("waffe", 
	    "Aber nicht nur die Fluegel machen Dir Sorgen. Schlangen haben "
	    "doch meistens auch Giftzaehne oder eine Wuergetechnik, mit der "
	    "sie ihre Opfer zerquetschen....");

  AddDetail(({"zaehne","zahn", "giftzahn", "giftzaehne"}), 
	    "Vor hier aus siehst Du sie nicht. Vielleicht ist es ja eine "
	    "gutmuetige Schlange und sie will gar nichts von Dir.");

  AddDetail(({"technik","wuergetechnik"}), 
	    "Sie schlingen sich dabei um Deinen ganzen Koerper und "
	    "zerdruecken ihn. Dir schaudert, wenn Du daran denkst.");

  AddDetail("koerper", 
	    "Bei den Dimensionen dieses Exemplares ist das kein Problem.");

  AddDetail(({"dimension","dimensionen"}), 
	    "Ob alle ihrer Gattung so riesig sind?");

  AddDetail(({"gattung", "exemplar", "exemplares"}), 
	    "Davon soll es noch mehr geben???");

  AddDetail("opfer", 
	    "An den Haufen von alten Waffen und anderen Habseligkeiten kannst "
	    "leicht absehen, wieviele schon versucht haben, die Schlange zu "
	    "killen.");
  
  create_default_npc(18+random(3));
  SetProp(P_ALIGN, -50);
  SetProp(P_HANDS, ({" mit ihren scharfen Fluegelspitzen",135,DT_RIP}));    
}
