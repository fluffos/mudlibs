#include "../def.h"

inherit "std/mnpc";

#define KRISTALLQUESTKEY "Eesthils Befreiung"

nosave int seil();
nosave string hilf(string str);
nosave string belohnung(string str);
nosave string floete(string str);
nosave string heilerin();

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Die Schmiedin Salina");
  SetProp(P_LONG, 
	  BS("Du siehst eine mittelgrosse Frau mit kraeftiger Statur. "
	     "Sie traegt einen Lederwams, eine Hose und Lederstiefel. "
	     "Dir faellt auf, dass sie einen traurigen Gesichtsausdruck "
	     "hat und sich suchend in der Gegend umblickt."));

  SetProp(P_DIE_MSG, " haucht ihr Leben aus.\n");

  SetProp(P_NAME, "Salina");
  SetProp(P_GENDER, FEMALE);
  AddId(({"salina", "schmiedin"}));
 
  create_default_npc(16);
  set_living_name("salina");
  
  SetGuardProtection(100, GUARD_QUEST);
  
  SetProp(P_BODY, 100);
  SetProp(P_HANDS, ({" mit blossen Haenden", 100, DT_BLUDGEON}));
  SetProp(P_ALIGN, 200);
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Mensch");
  SetProp(P_XP, 0);
  SetProp(P_SIZE, 174);
  SetProp(P_MSGIN, "kommt suchend herein");
  SetProp(P_MSGOUT, "findet hier nichts und sucht weiter");
  SetProp(P_MMSGIN, "kommt suchend herein");
  SetProp(P_MMSGOUT, "findet hier nichts und sucht weiter");
  
  SetChats (5, ({
    "Salina blickt sich suchend um.\n",
    "Salina untersucht die Kristalle.\n",
    "Salina beobachtet Dich kurz und sucht dann weiter.\n",
    "Salina scheint etwas zu suchen.\n",
    "Salina nimmt pruefend einen Stein in die Hand.\n",
    "Salina wirkt sehr bedrueckt.\n",
    "Salina seufzt: Wo kann ich nur solches Holz finden?\n",
    "Salina murmelt: Wenn ich doch nur Hilfe bekaeme...\n",
    "Salina fragt: Kannst Du mir helfen?\n"}));
  
  AddInfo(DEFAULT_INFO, 
	  "Da weiss ich leider auch nicht viel darueber. "
	  "Frag lieber Aerendil aus Elessar.", "sagt: ");

  AddInfo(({"bibliothekar","aerendil"}),
	  "Das ist der Bibliothekar aus Elessar. Er besitzt profundes Wissen "
	  "ueber den Kristallwald.", 
	  "sagt: ");
  
  AddInfo(({"elessar","elfenstadt"}),
	  "So nennt man das Dorf der Elfen in den Baeumen.", 
	  "sagt: ");
  
  AddInfo(({"welt","silberland"}),
	  "Das ist die wundervolle Welt, in der Du Dich gerade befindest.", 
	  "sagt: ");

  AddInfo(({"baumrinde","rinde"}) ,
	   "Die Rinde ist aus Kristall...",
	   "seufzt: ");

  AddInfo("kristall",
	  "Alles ist hier aus Kristall...",
	  "schluchzt: ");

  AddInfo(({"salina","name"}),
	  "Ich heisse Salina und bin die Frau des Schmiedes Eesthil.",
	  "sagt: ");
  
  AddInfo(({"holz","abenteuer","aufgabe","problem"}),
	  "Wenn mein Mann doch nur...", 
	  "sagt: ");
  AddInfo(({"ehemann","mann"}),
	  "Mein Mann wollte den Wald nicht verlassen. Das hat er nun davon! "
	  "Jetzt besteht er auch aus Kristall wie alles andere hier.",
	  "sagt: ");

  AddInfo(({"kristall","kristallwald"}),
	  "Vor vielen Jahren lebte ein Zauberer in den Bergen im Westen. "
	  "Seine Versuche waren gefaehrlich und sie verursachten mehrmals "
	  "Steinschlage und Naturkatastrophen. Nach und nach verliessen "
	  "alle Bewohner den Wald. Nur Eesthil blieb trotzig.",
	  "erzaehlt: ");

  AddInfo(({"naturkatastrophen","steinschlaege","zauberer"}),
	  ({"Hmm, darueber weiss ich nichts genaues. Frag doch Aerendil.",
	  "Wenn Du mehr wissen willst musst Du Aerendil in Elessar fragen."}),
	  "sagt: ");

  AddInfo("eesthil",	
	  "Das ist mein Mann - der beste Schmied von hier bis zum Ende des "
	  "Silberlandes!",
	  "erzaehlt: ");

  AddInfo("schmied",
	  "Mein Mann ist einer der wenigen Schmiede, die noch die alten "
	  "Kenntnisse des Schmiedens mit kaltem Feuer haben!",
	  "erzaehlt: ");

  AddInfo("pflock",
	  "Wenn Du einen hast, gib ihn mir doch mal!", 
	  "sagt: ");

  AddInfo(({"feuer","feuerstelle"}),
	  "Die Feuerstelle im Osten hab ich auch gesehen. Leider weiss ich "
	  "nicht, von wem das Feuer stammt.", 
	  "sagt: ");
  
  AddInfo(({"magier","schwarzmagier","boesmagier"}),
	  "Vor kurzem hat sich hier im Kristallwald ein boeser Schwarzmagier "
	  "mit seinem Turm eingenistet. Er tyranisiert die friedliebenden "
	  "Bewohner des Waldes seither.",
	  "sagt: ");
  
  AddInfo(({"magierturm","schwarzmagierturm","boesmagierturm","turm"}),
	  "Der Turm des Schwarzmagiers befindet sich hier im Kristallwald "
	  "und ist nur ueber einen Durchschlupf in den Straeuchern zu "
	  "erreichen. Ich selber habe mich aber noch nicht hineingewagt.",
	  "sagt: ");
  
  AddInfo(({"durchschlupf"}),
	  "Ich weiss nicht mehr genau, wo der ist...", "seufzt: ");
  
  AddInfo(({"waldbewohner","bewohner"}),
	  "Viele Waldbewohner hat der Kristallwald nicht mehr, jedoch werden "
	  "sie neuerdings von einem boesen Schwarzmagier tyrannisiert.",
	  "sagt: ");
  
  AddInfo("belohnung", CLOSURE(belohnung), "sagt: ");
  AddInfo("seil",      CLOSURE(seil),      "sagt: ");
  AddInfo("floete",    CLOSURE(floete),    "sagt: ");
  AddInfo(({"helfen","hilfe"}),     CLOSURE(hilf),     "sagt: ", 1);
  AddInfo(({"shardin","heilerin"}), CLOSURE(heilerin), "sagt: ", 1);
  
  //SetProp(P_LOG_INFO, "salina.log");
  
  //Props zum moving NPC
  SetProp(P_MNPC_AREA, ROOM "0");
  SetProp(P_MNPC_DEFAULTROOM, ROOM "0903");
  SetProp(P_MNPC_WAIT, ({30,50,50}));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS+MOV_BACKWARDS+MOV_MOVES);
  
  SUID;
  
  CLONEME("/p/armour/armour/lederruestung");
  CLONEME("/p/weapon/club/schmiedehammer");

  command("ziehe ruestung an");
  command("zuecke schmiedehammer");
  
  SetProp(P_SPELLRATE,25);

  AddSpell(3, 170,
	   "Salina rempelt Dich um.\n",
	   "Salina rempelt @WEN um.\n",
	   DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 250,
	   "Salina zerquetscht Dich mit ihrem Hammer.\n",
	   "Salina zerquetscht @WEN mit ihrem Hammer.\n",
	   DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));
  
  SetAttackChats(30, ({
    "Salina schreit Dich wild an: \"Warte nur, bis mein Mann das erfaehrt!\"\n",
      "Salina kreischt: \"Dich zerquetsch ich wie einen Wurm!\"\n",
      "Salina bohrt Dir ein Loch ins Knie und giesst Milch hinein.\n"}));
}

nosave string seil()
{
  object seil;
  
  if(present("kristallseil", TP)) 
    return "Du hast ja schon eines von mir bekommen!";   
  
  seil=clone_object(OBJ "seil");
  
  if(seil->move(TP, M_SILENT)==ME_TOO_HEAVY)
    {
      seil->remove();
      return "Das kannst Du ja nicht mehr tragen!";
    }
  
  return "Hier hast Du mein Seil. Bring es mir aber spaeter wieder!";   
}

nosave string heilerin()
{
  if(present("\neesthilpflock", TP)) 
    return "Die Heilerin Shardin wohnt suedwestlich des Sees. "
      "Zeig ihr Deinen Pflock.";   

  return "Sie soll im Kristallwald oder im Gebirge wohnen. "
    "Genau weiss ich das auch nicht.";   
}

nosave void sfkt(string str)
{
  command_me("sage "+str);
}

void give_notify(object ob)
{
  string ow;

  ow = ob->query_owner(ob);

  if(!ob->id("\nsalinapflock"))
    {	
      sfkt("Was soll ich denn damit?");

      give_obj(ob, TP);

      return;
    }
  
  //Der ist nicht seiner!!!!!!
  if(!stringp(ow))
    {
      write(BS("Oooh! Woher hast du den den???")+
	    BS("Benachrichtige sofort Sargola!"));

      ob->remove();

      return;
    } 
  if(ow!=TP->query_real_name())
    {
      sfkt("Hoppla! Das ist ja ein wunderschoener Pflock!");
      sfkt("Und den hast auch wirklich Du gefunden? Das glaub ich Dir nicht!");
      sfkt("Von "+CAP(ow)+" wurde mir berichtet, dass er so einen "
	   "gefunden habe! Hast Du etwa...");
      
      give_obj(ob, TP);
      
      return;
    }
  else
    {
      sfkt("Das ist genau der richtige Pflock! Gut.");
      sfkt("Die Heilerin wohnt suedwestlich des Sees. Frag sie, wie man "
	   "aus dem Pflock eine Floete macht. Du musst wissen, dass man "
	   "die nicht einfach so schnitzt. Sie muss nach einem strengen "
	   "Ritual gefertigt werden.");
      
      give_obj(ob,TP);
      
      return;
    }
  
  sfkt("Was soll ich denn damit?");
  
  drop_obj(ob);
  
  return;
}

nosave string belohnung(string str)
{
  if(present("\neesthilquest",TP))
    return "Das wirst Du dann schon sehen.";
  else
    return "Wovon sprichst Du?";
}

nosave string hilf(string str)
{
  if(present("\neesthilquest", TP))
    return "Du hilfst mir ja schon!";

  if(TP->QueryQuest(KRISTALLQUESTKEY))
    return "Vielen Dank, Du hast mir bereits geholfen!";

  CLONE(OBJ "quest", TP);

  return "Du wuerdest mir wirklich helfen? Von einer Heilerin habe ich "
    "erfahren, dass eine Floete Eesthil wieder zu einem Menschen "
    "machen koennte. Diese Floete muss aus dem Holz einer Pflanze "
    "sein, die dem Kristall-Spruch widerstehen kann. Wenn es Dir "
    "moeglich ist, finde eine solche Pflanze und bring mir das Holz von "
    "ihrem Stamm. Du kannst Dir einer hohen Belohnung sicher sein! "
    "Komm wieder, wenn Du das Holzstueck hast.";
}

nosave string floete(string str)
{
  if(!present("\neesthilquest", TP))
    return "Da kann ich Dir leider nicht weiterhelfen.";
  
  if(present("\nfloete",TP))
    return "Toll! Du hast eine Floete, um Eesthil zu befreien! Schnell, eile "
      "Dich! Geh in die Schmiede und spiel dort Floete.";

  return "Du musst die Floete von der Heilerin schnitzen lassen.";
}
