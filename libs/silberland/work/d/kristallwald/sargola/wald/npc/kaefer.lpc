//      WELCOME!
//   
//   ein kleiner Kaefer
//
//   * kann nichts wesentliches ;)
//
//   date: 09-01-96, 22:46
//   
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>

#include "/d/kristallwald/sargola/def_kristall.h"
#include <moving.h>

create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Ein schimmernder Kaefer");
  SetProp(P_LONG, BS(
    "Der Kaefer ist klein, hat sechs Beine und sein Ruecken schimmert "
     +"gruenlich.\n"));
  SetProp(P_NAME, "Kaefer");
  SetProp(P_GENDER, MALE);
  AddId( ({"kaefer"}) );
  AddDetail("beine", BS("Davon hat er sechs.\n"));
  AddDetail("ruecken", BS("Der Ruecken des Kaefers schimmert in gruenen und "
     +"blaeulichen Toenen.\n"));
  AddDetail( ({"farbtoene","toene"}), BS("Gruenliche und blaeuliche Farbtoene kennzeichnen "
     +"den Ruecken des Kaefers.\n"));


  create_default_npc(2);

  SetProp(P_HANDS, ({" mit seinen kleinen Zangen", 40, DT_RIP}));
  SetProp(P_RACE, "Kaefer");
  SetProp(P_SIZE, 3);
  SetProp(P_ALIGN, -70);
  SetProp(P_MAX_HANDS, 6);



  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt weiter");
  SetProp(P_MMSGIN, "krabbelt herein");
  SetProp(P_MMSGOUT, "krabbelt weit weg");

  AddInfo(DEFAULT_INFO, "knackst nur leise.");
  AddInfo("sargola", "teilt Dir mit: Sargola hat mich erschaffen.");
  SetProp(P_REJECT, ({ REJECT_DROP, 
    "Was soll der Schroeter damit?\n"}));
  SetChats(3, ({
    "Der Kaefer kneift Dich.\n",
    "Der Kaefer krabbelt Dein linkes Bein hoch.\n",
    "Der Kaefer beschaeftigt sich mit einem Blatt.\n",
    "Der Kaefer zwickt Dich mit seinen Zangen.\n"}) );
}

