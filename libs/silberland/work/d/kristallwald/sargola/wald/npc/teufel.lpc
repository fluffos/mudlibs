inherit "std/npc"; 


#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
     
#include "/d/kristallwald/sargola/def_kristall.h"
     
      create()
      {
      if (!is_clone(TO)) return;
       ::create();
     
        AddId ( ({"dornteufel","teufel","silberdornteufel"}) );
        SetProp (P_GENDER, MALE);
        SetProp (P_RACE, "Hoernchen");
     
        //P_NAME wird im Satz verwendet und soll aus einem Wort bestehen
        SetProp (P_NAME, "Silberdornteufel");
        SetProp (P_SHORT, "Ein Silberdornteufel");
        SetProp (P_AGGRESSIVE,1);
     
        SetProp (P_ARTICLE, 1);
        SetProp (P_LONG,BS("Ein kleiner, aufgescheuchter Silberdornteufel. Er "
      +"gehoert zur Rasse der Hoernchen und ist besonders boesartig. "
      +"Er blitzt Dich angriffslustig aus seinen kleinen Augen an. "
      +"Seine Krallen sind zwar klein, aber umso schaerfer. Dieses "
      +"Exemplar ist gut und gern einen halben Meter gross!\n"));
      
create_default_npc(21+random(3));

       SetProp (P_ALIGN, random (100)-150);
       SetProp (P_SIZE, 50 );      // P_SIZE = groesse des NPC in cm
       SetProp (P_HEAL, -10);
       SetProp (P_MAX_HANDS, 4);
       SetProp (P_HANDS, ({" mit scharfen Krallen",250,DT_PIERCE}) );
       SetProp(P_SPELLRATE, 15);
       
       SUID;
       if(random(4))
	       clone_object(OBJ_WALD+"ei.lpc")->move(TP, M_NOCHECK);
        
       AddSpell(1,350,
        "Der Silberdornteufel reisst Dir mit den Krallen den Arm auf.\n",
        "Der Silberdornteufel reisst @WEM mit den Krallen den Arm auf.\n",
        DT_SLASH, ([SP_SHOW_DAMAGE:1]) );
     
        SetAttackChats(6, ({
        "Der Silberdornteufel teufelt wie wild durch die Gegend.\n",
        "Der Silberdornteufel wiselt flinkt zur Seite.\n",
        "Der Silberdornteufel huepft 2 Meter in die Luft!\n",
        "Der Silberdornteufel kann den plumpen Schlaegen ausweichen.\n",
        "Der Silberdornteufel kreischt ohrenbetaeubend.\n"     }) );
     
        SetProp (P_DIE_MSG, " hatte noch gar nicht vor zu gehen...\n");
         SetProp (P_DEFAULT_INFO,   "wuerdigt Dich keines Blickes.\n");
        SetProp(P_NOCORPSE, 0);
        AddInfo ( "sargola"
           "Knie nieder vor ihm!", "sagt: ");
}

