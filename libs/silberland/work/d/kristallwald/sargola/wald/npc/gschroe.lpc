//      WELCOME!
//   
//   Grosser Quarz-Schroeter
//
//   * kann nichts wesentliches ;)
//   * staerker als normaler Schroeter
//   date: 09-01-96, 22:46
//   

#include "../def.h"

inherit "std/npc";

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein grosser Quarzschroeter");
  SetProp(P_LONG, 
	  BS("Das ist ein grosser Schroeter, wie wir ihn alle aus dem "
	     "Schwarzen Auge kennen. Nur dass dieser hier durchsichtig ist."));

  SetProp(P_NAME, "Quarzschroeter");
  SetProp(P_NAME_ADJ,"gross");
  AddAdjective(({"grosser", "gross", "grossen"}));
  
  SetProp(P_GENDER, MALE);
  AddId(({"schroeter", "quarzschroeter"}));
  create_default_npc(10);
  SetProp(P_BODY, 80);
  SetProp(P_HANDS,({" mit seinen gefaehrlichen Zangen", 90, DT_RIP}));
  SetProp(P_RACE, "Kaefer");
  SetProp(P_SIZE, 25);
  SetProp(P_WEIGHT, 323);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "krabbelt herein");
  SetProp(P_MMSGOUT, "krabbelt weit weg");

  AddInfo(DEFAULT_INFO, "knackst nur leise.\n");

  AddInfo("sargola", 
	  "ruft: Mein Herrscher und Erschaffer!");

  AddInfo(({"auge","schwarzes auge"}), 
	  "ruft: Ja kennst Du denn das Schwarze Auge nicht??");

  AddInfo(({"zange","zangen"}), 
	  "Zwei Zangen mit jeweils einer Art Widerhaken traegt "
	  "der Schroeter vor sich her.");

  AddInfo(({"widerhaken", "haken"}), 
	  "Sie dienen dazu, dem Gegner nach einem schmerzhaftem "
	  "Stich auch noch Schmerzen beim Rausziehen zu bereiten.");

  AddInfo("stich", 
	  "Du hoffst, dass der Schroeter nie seine Zangen in Deinem Koerper "
	  "versenkt!");

  SetProp(P_REJECT,({ REJECT_DROP, "Was soll der Schroeter damit?\n"}));

  SetChats(3,({
    "Der grosse Schroeter kneift Dich.\n",
      "Der grosse Schroeter krabbelt Dein linkes Bein hoch.\n",
      "Der grosse Schroeter beschaeftigt sich mit einem Blatt.\n",
      "Der grosse Schroeter zwickt Dich mit seinen Zangen.\n"}));
  
  SetProp(P_SPELLRATE,25);
  
  AddSpell(9,100,
   "Der grosse Schroeter schleudert Dich mit seinen Zangen durch die Luft.\n",
   "Der grosse Schroeter schleudert @WEN mit seinen Zangen durch die Luft.\n",
	   DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,200,
   "Der grosse Schroeter drueckt Dir die Luftroehre zu.\n",
   "Der grosse Schroeter drueckt @WEM die Luftroehre zu.\n", 
	   DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(20,({
    "Der grosse Schroeter wird jetzt erst richtig aggressiv.\n",
      "Der grosse Schroeter fuchtelt wie wild mit seinen Zangen. \n",
      "Der grosse Schroeter versetzt Dich in Angst und Schrecken.\n"}));
}
