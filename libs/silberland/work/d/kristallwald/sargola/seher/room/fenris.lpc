raus()
{
   object ob;
   if(ob = present("dope", TP))
   {
	tell_object(TP, "Du haettest doch glatt vergessen, das Dope wieder zurueck"
		+"zulegen.");
	ob->remove();
   }
   if(ob = present("bong",TP))
   {
	tell_object(TP, "Der Bong gehoert doch Fenris!\nDu versteckst in wieder im Waeschehaufen.\n");
	ob->remove();
   }

   if(user[TPN]==0)
   {
	tell_object(TP, "Du solltest ein kleines Praesent fuer Fenris dalassen.\n");
	return 1;
   }
   TP->move(ROOM+"0507", M_GO, "ueber die Planke","laeuft","kommt ueber die Planke angelaufen");
   return 1;
}

int log(string str)
{
   notify_fail("Was moechtest Du lesen?\n");
   if(!str) return 0;

   if(TP->QueryProp(P_NAME) != "Fenris" || TP->QueryProp(P_WANTS_TO_LEARN) != 1)
   {
	tell_object(TP, "Tststs, das darf nur Fenris.\n");
	return 1;
   }

   if(str=="alle"||str=="alles")
   {
	TP->more(LOG+"fenris.bett");
	return 1;
   }
   else if(str=="letzte"||str=="letzten")
   {
	TP->tail(LOG+"fenris.bett");
	return 1;
   }
   else
	return 0;
}


int bett_sprung(string str)
{
   object ob, tp;
   string name;
   tp = TP;

   name = tp->QueryProp(P_NAME);
   ob = find_player("fenris");

   notify_fail("Wohin moechtest Du springen?\n");
   if(!str) return 0;

   if(str=="in bett"||str=="ins bett")
   {

	if(tp->QueryProp(P_GENDER) == MALE && ob!=tp)
	{
	   tell_object(tp, "Du denkst . o 0 ( tja, leider ist es das Bett von Fenris.)\n");

	   return 1;
	}
	else
	{
	   tell_object(tp, "Du springst quietschfidel in das Bett von Fenris.\n");
	   if(objectp(ob) && environment(ob) != find_object(ROOM+"bett") )
		tell_object(ob, name +" ist gerade in den Bett gesprungen.\n");
	
	   tp->move(ROOM+"bett", M_GO, "ins Bett","huepft","huepft zu Dir ins Bett" );
	   TP->command_me("rufe Fenris, ich warte in Deinem Bett auf Dich!");
	   //WLOG(LOG+"fenris.bett", "huepfte in Dein Bett");
	   return 1;
	}
   }
   return 0;
}
