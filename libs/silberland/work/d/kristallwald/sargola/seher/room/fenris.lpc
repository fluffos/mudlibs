// syntax "fuelle bong mit wasser" -> raummessage 'name' beugt sich ueber ein Loch und //
// verschwindet fast. Falls kein Bong im inv -> Bist du sicher das du was zum befuellen //
// dabei hast. falsche syntax -> WAS willst Du mit WAS befuellen//

// int bett_sprung -> steht schon ganz am Ende //

// syntax "durchsuche waeschehaufen" -> raummessage 'name' stuerzt sich in den Haufen. Dir
// wird schlecht bei dem Anblick. -> "Was willst du durchsuchen" //
// wenn syntax richtig -> clone bong in besitz von spieler mit message -> "Du //
// hast einen Gegenstand gefunden." //

int bohre(string str)
{
	notify_fail("Womit willst Du wo bohren?\n");
	if(!str) return 0;
	if(str=="mit linken zehe rechten fusses in kleinsten spalte")
	{
	   if(dope>=0)
	   {
		   tell_object(TP, "Du bohrst genussvoll mit der linken Zehe des rechten Fusses "
			+"in der kleinsten Spalte. Du findest dabei doch tatsaechlich ein "
			+"kleines Stueck Dope.\n");
		   tell_room(TO, TPN+" fuehrt akrobatische Verrenkungen aus und stochert in einer "
			+"Spalte herum.\n", ({TP}) );
		   clone_object(OBJ+"dope")->move(TP);
		   dope--;
		   return 1;
	   }
	   else
	   {
		   tell_object(TP, "Du bohrst genussvoll mit der linken Zehe des rechten Fusses "
			+"in der kleinsten Spalte. Ausser einer roetlichen Zehe bringt Dir das "
			+"aber nichts.\n");
		   tell_room(TO, TPN+" fuehrt akrobatische Verrenkungen aus und stochert in einer "
			+"Spalte herum.\n", ({TP}) );
		   return 1;
	   }
	}
	return 0;
}


int hebe(string str)
{
	object ob;
	notify_fail("Was willst Du heben?\n");
	if(!str) return 0;

	if(str=="diele")
	{
	   tell_object(TP, "Du hebst die auffaellige Diele an und merkst, "
	   	+"dass Du darunter das Wasser sehen kannst.\n");
	   if(ob = present("bong",TP))
	   {
	   	tell_object(TP, "Du schliesst haarscharf, dass Du damit doch "
	   		+"den Bong fuellen koenntest. Was Du dann auch tust.\n");
	   	ob->set_fuellstand();
	   }
	   return 1;
	}
	return 0;
}



reset()
{
	::reset();
	bong = 1;
	dope = 3;
}


int wuehle(string str)
{
	notify_fail("Worin willst Du wuehlen?\n");
	if(!str) return 0;

	if(str=="haufen"||str=="in haufen"||str=="waeschehaufen"||str=="in waeschehaufen")
	{
	   if(bong && (TPN=="Fenris"||TPN=="Goettchen") )
	   {
		tell_object(TP, "Du wuehlst im Haufen und findest ein "
			+"seltsames Ding, das Du an Dich nimmst.\n");
		tell_room(TO, TPN+" stuerzt sich in den Waeschehaufen\nDir wird schlecht "
			+"bei dem Anblick.\n", ({TP}) );
		clone_object(OBJ+"bong")->move(TP);
		bong = 0;
		return 1;
	   }
	   else
	   {
		tell_object(TP, "Du wuehlst in dem Haufen, findest aber nichts.\n");
		tell_room(TO, TPN+" wuehlt in dem Haufen, findet aber nichts.\n",({TP}) );
		return 1;
	   }
	}
	return 0;
}


