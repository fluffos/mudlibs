inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

int laufe (string str);
nass_remove();

create()
{
   if (!is_clone(this_object()))
        return;
   ::create();

   SetProp(P_SHORT, "5 Gramm Dope");
   SetProp(P_LONG, 
	BS("Du kannst es kaum glauben. Du haeltst 5 Gramm "
	  +"Dope in Deinen Haenden. Sofort erkennst Du, dass es sich hier "
	  +"um was ganz was feines handelt. Es ist ein ganz heller Charas."
	  +"Die Gier sofort was zu rauchen uebermannt Dich. Wenn du nur was "
	  +"dabei haettest um es zu rauchen. "));
   SetProp(P_NAME,"Dope");
AddDetail("gramm",
	BS("Na das sollte doch reichen oder? "));

AddDetail("gier",
	BS("Also Fenris koennte sich nicht mehr beherschen. "));

AddDetail("haende",
	BS("Die sind noch immer dreckig! "));

AddDetail("charas",
	BS("Oh ja. Charas ist eine hellbraune, fast schon weiche Dopeart die von "
	  +"vielen als das ultimative Dope beschrieben wird. Die Wirkung geht von stark "
	  +"bis sehr stark.\n")); 	

AddDetail("wirkung",
	BS("Na teste doch mal die Wirkung. "));

   AddId (({"dope"}));

}
		