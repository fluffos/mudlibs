inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

//*******************
// VARS
//*******************
int gefuellt;

//*******************
// FUNCS
//*******************
int laufe (string str);
nass_remove();
kammern();



create()
{
   if (!is_clone(this_object()))
        return;
   ::create();
   gefuellt = 0;
   SetProp(P_NAME, "Bong");
   SetProp(P_SHORT, "Ein Bong");
   SetProp(P_LONG, 
	BS("Das ist ein doppellaeufiges, blassblaues Huterl. Es hat zwei Kammern "
	  +"die mit Fluessigkeit gefuellt werden. An der Vorderseite befindet sich "
	  +"das Chilon. Du bist erstaunt wie gross es ist. Hier passt sicherlich "
	  +"massenhaft hinein. Es sieht ziemlich maechtig aus und man sollte "
	  +"keinen Unfug damit treiben. Das koennte ins Auge gehen. "));

 AddSpecialDetail("kammern","kammern");

 AddDetail("mudder",
	BS("Ein solcher bist du. "));
 
 AddDetail("fluessigkeit",
	BS("Schau Dich mal um. Hier gibt es sicher irgendwo eine. "));

 AddDetail("vorderseite",
	BS("An der Vorderseite ist das Chilon angebracht. "));

 AddDetail( ({"huterl","unterschied"}),
	BS("Ein Huterl ist so aehnlich wie eine Wasserpfeife. Der Unterschied "
	  +"besteht darin, dass man an einem Huterl nur einmal anzieht da man "
	  +"nicht soviel Mische in das Chilon geben kann wie bei einer Wasserpfeife. "));

 AddDetail("wasserpfeife",
	BS("Also hier gibt es nur das Huterl. "));

 AddDetail( ({"mische","mischung"}),
	BS("Das ist eine Mischung aus Dope oder Gras mit Tabak. Ein Huterl kann "
	  +"man aber auch getrost pur rauchen. Man sollte halte nicht zuviel reingeben. "));

 AddDetail( ({"gras","graeser"}),
	BS("Schmeckt auch super aber hier findest du sicher keines. Und die Graeser "
	  +"die Du im SL findest sind sicher nicht zum rauchen. Schade gell. "));

 AddDetail("tabak",
	BS("Du Seicherl, pur rauchen rulez :)"));

 AddDetail("seicherl",
	BS("Da fragst Du am besten mal Sargola was das ist. "));

 AddDetail("sargola",
	BS("Sargola == Seicherl :) (Anmerkung von Sargola: "));
 AddDetail("sl",
	BS("Yo da bist du gerade. "));
 AddDetail( ({"aug","auge"}),
	BS("Hm...was hattest Du denn in Biologie ?? "));
 AddDetail("biologie",
	BS("Na sag schon. Was hattest du ?? "));


   AddId (({"bong","pfeife","wasserpfeife"}));

}

int set_fuellstand()
{
	gefuellt = 1;
}
int query_fuellstand()
{
	return gefuellt;
}

kammern()
{
	string txt;
	txt = "Im Gegensatz zu einem normalen Bong hat es zwei Kammern. "
		  +"Daran kannst Du schon erkennen das es nicht fuer zartbeseitete "
		  +"Mudder gedacht ist. Uebertreib es nur ja nicht. ";
	if(gefuellt)
		return BS(txt + "Die Kammern sind mit Wasser gefuellt.");
	return BS(txt);
}