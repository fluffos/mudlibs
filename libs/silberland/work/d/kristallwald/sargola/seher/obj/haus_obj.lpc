inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <language.h>
#include "../def.h"

int laufe (string str);
nass_remove();

create()
{
   if (!is_clone(this_object()))
        return;
   ::create();

   SetProp(P_SHORT, "Fenris´ Seherhaus");
   SetProp(P_LONG, "Das ist die Pflockhuette von Fenris. Sie steht, wie "
	  +"der Name schon sagt auf, auf wie vier Holzpfeilern die sie "
	  +"ueber dem Wasser halten. Du ueberlegst, wie Du wohl dorthin "
	  +"kommen koenntest. ");
   SetProp(P_NOGET, "Du beginnst mit all Deinen Kraefte zu heben,aber das "
	+"Seherhaus von Fenris hebt sich keinen Millimeter.\n");

AddDetail( ({"huette","pflockhuette"}),
	BS("Sie ist ungefaehr 5 Meter vom Ufer entfernt. Sie sieht von "
	  +"aussen eher schlicht und einfach aus. Du erkennst eine Tuer "
	  +"durch die man in die Huette kommt, aber wie du zur Tuer kommst "
	  +"weisst du noch nicht. "));

AddDetail( ({"pfeiler","holzpfeiler"}),
	BS("Die Huette steht auf 4 Pfeilern. Es sieht sehr stabil aus und "
	  +"man braucht sicher keine Angst haben das die Huette irgendwann "
	  +"mal umkippt "));

AddDetail("angst",
	BS("Die brauchst du hier nicht haben. "));

AddDetail("ufer",
	BS("Hier ist wahrscheinlich der schoenste Teil des Ufers. Sicher geniesst "
	  +"Fenris in ein paar metzelfreien Minuten ein erfrischendes Bad im klaren Wasser "
	  +"des Sees. "));

AddDetail("ufer",
	BS("Es ist hier wirklich ein schoenes Ufer. "));

AddDetail("tuer",
	BS("Ja wenn du nur hinkommen wuerdest. Soweit Du das von hier erkennen kannst "
	  +"ist sie nicht abgeschlossen. Du koenntest also ganz leicht in die Huette rein, "
	  +"wenn Du zur Tuer gelangen wuerdest. "));

AddDetail("teil",
	BS("Der See ist ja riesengross und hat somit ein langes Ufer aber hier ist "
	  +"es wohl am schoensten. "));

AddDetail("minuten",
	BS("Sag jetzt 60 mal 21 dann hast du es. "));

AddDetail("bad",
	BS("Koenntest du auch vertragen. "));

AddDetail("wasser",
	BS("Es ist kaum zu glauben wie klar es hier ist. Du kannst fast alles unter Wasser "
	  +"erkennen. Ausser dem ueblichen Zeugs wie Fische, Algen, Steine, Seeungeheuer siehst "
 	  +"Du ausserdem noch eine Planke die vom Ufer aus direkt zur Huette fuehrt. "));

AddDetail( ({"zeug","zeugs"}),
	BS("Fische, Algen, Steine, Seeungeheuer..... "));

AddDetail( ({"fisch","fische","algen","stein","steine"}),
	BS("Ach solche Details hast du ja schon tausendmal untersuchst. Da war ja noch nie "
	  +"was interessantes dabei. "));

AddDetail( ({"ungeheuer","seeungeheuer"}),
	BS("Es scheint, als ob es da unten auf dich warten wuerde. Pass lieber auf! "));

AddDetail("planke",
	BS("Es sieht so aus als ob die Planke die Verbindung zwischen Ufer und der Huette "
	  +"waere. Vielleicht kommt man ja da irgendwie rueber? "));

AddDetail("verbindung",
	BS("Du weisst schon. Von einem Punkt zum anderen "));

AddDetail("punkt",
	BS("."));



   AddId (({"haus","seherhaus","fenris seherhaus"}));
   AddCmd( ({"laufe","lauf"}), "laufe");
}

int laufe(string str)
{
   notify_fail("Worueber moechtest Du laufen?\n");
   if(!str) return 0;

   if(str=="ueber planke"||str=="ueber planken")
   {
	if(TP->QueryProp(P_SIZE)<150)
	{
	   if(random(5) == 1)
	   {
		tell_object(TP, "Du laeufst ueber die Planke, rutscht aber "
		   +"aus und faellst ins Wasser.\n"
		   +"Du kriechst pitschnass wieder ans Ufer.\n");
		tell_room(environment(TO), TPN+" laeuft ueber die Planke, rutscht aber ab "
		   +"und faellt ins Wasser.\n"
		   +TPN+" kommt pitschnass aus dem Wasser angekrochen.\n", ({TP}) );
		if(!present("\nnass", TP))
		   (clone_object(OBJ+"nass"))->move(TP);
		
		return 1;
	   }
	   else
	   {
		tell_object(TP, "Du laeufst ohne Probleme ueber die Planke "
		+"und erreichst sicher Fenris´ Seherhaus.\n");
	   TP->move(ROOM+"fenris", M_GO, "in Fenris´ Seherhaus", "laeuft","kommt angelaufen");
	   return 1;
	   }
	   
	}
	else
	{
	tell_object(TP, "Du laeufst ohne Probleme ueber die Planke "
		+"und erreichst sicher Fenris´ Seherhaus.\n");
	   TP->move(ROOM+"fenris", M_GO, "in Fenris´ Seherhaus", "laeuft","kommt angelaufen");
	   return 1;
	}
	return 1;
   }
   return 0;
}

