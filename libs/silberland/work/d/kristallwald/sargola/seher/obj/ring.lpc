reset()
{
	::reset();
	erlaubt = 1;
	rit =0;
	ritual = 0;
}

int set_ritual(int value)
{
	ritual = value;
}

int query_ritual()
{
	return ritual;
}

int lies(string str)
{
	notify_fail("Was moechtest Du lesen?\n");
	if(!str || str!="gravur" )
		return 0;
		
	tell_object(TP, "Du kannst nichts mehr als \"Warnung\" erkennen...\n");
	return 1;
}

int ziehe(string str)
{
	int result;
	
	notify_fail("Was moechtest Du an- oder ausziehen?\n");
	if(!str) return 0;
	
	if(str=="ring an"||str=="rubinring an")
	{
		result = do_wear("rubinring", 1);
		if(result)
			TL("Du ziehst den huebschen Rubinring an.\n");
		else
			TL("Du kannst den huebschen Rubinring nicht anziehen.\n");
		return 1;
	}
	else if(str == "ring aus"||str=="rubinring aus")
	{
		result = do_unwear("rubinring", 1);
		if(result)
			TL("Du ziehst den Rubinring aus.\n");
		else
			TL("Du kannst den Rubinring nicht ausziehen.\n");
		return 1;
	}	
	return 0;
}



int ritual(string str)
{
	if(!present(find_player(MAENNLEIN), environment(environment(TO))) )
	{	TL ("Du kannst "+capitalize(MAENNLEIN)+" leider nirgends entdecken.\nDu seufzt tief.\n");
		return 1;
	}	
	if(TO->QueryProp(P_WORN) != TP)
	{
		TL("Du traegst den Ring doch gar nicht!\n");
		return 1;
	}
/*
	if(find_call_out("beschraenkung")==-1)
	{
		tell_object(TP, "Du hast erst vor kurzem ein Ritual "
			+"erlebt. Lass Dir noch ein wenig Zeit und "
			+"geniesse die noch immer in Dir wallenden "
			+"Gefuehle.\n");
		return 1;
	}
*/		
	if(rit==1)
	{
		tell_object(TP, "Durch Deine Ungestuemheit verlierst Du die "
			+"Konzentration im laufenden Ritual!\n");
		TP->SetProp(P_SP, TP->QueryProp(P_SP)-5);
	  	return 1;
	}
	
	call_out("beschraenkung",BESCHRAENKUNG_TIME);
	notify_fail("");
	switch(koennen)
	{
		case 0:
		case 1:
		{
			CCALL("beginn",3);break;return 1;
		}
		case 2:
		case 3:
		{
			CCALL("liebe1", 3);break;return 1;
		}
		case 4:
		case 5:
		{
			CCALL("liebe2",3);break;return 1;
		}
		case 6:
		case 7:
		{
			CCALL("liebe3",3);break; return 1;
		}
	}
	return 1;
}







menschen()
{
	return "Du kontrollierst schnell nach - stimmt! "
	+"Es sind 10 Finger!! Ich muss wohl Mensch sein!\n";
}

zwerge()
{
	if(TP->QueryProp(P_NAME) == WEIBLEIN)
	{
	   tell_object(TP, "Es gibt auch liebe Zwerge. Die haben "
		+"aber sicher einen wunderschoenen Garten (mit Mauer).\n");
		return "";
	}
}


collier()
{
	if(TP->QueryProp(P_NAME) == WEIBLEIN)
		return "Ueber Dein Collier weisst Du doch schon alles.\n";
	return "Am Besten, Du fragst Vivienne ueber ihr Collier.\n";
}

form()
{
	int pk;
	pk = TP->QueryProp(P_HP );
	switch (pk)
	{
	case 1..50:
	   return "Dir geht es nicht besonders gut.\n";
	case 51..100:
	   return "Dir geht es einigermassen gut.\n";
	case 101..150:
	   return "Dir geht es ziemlich gut.\n";
	case 151..270:
	   return "Dir geht es phantastisch!\n";
	}
}



beginn()
{
	rit = 1;
   TL (" Du versuchst Dich auf Deine sexuellen und spirituellen "
   	+"Kraefte zu zentrieren. Verliebt blickst Du in Muddymuds Augen. "
   	+"Hingerissen und voll Bewunderung wird Dir seine Schoenheit bewusst, "
   	+"die Dich mit einem ueberwaeltigenden Entzuecken erfuellt. Was in "
   	+"diesem Augenblick mit Dir geschieht, ist mit Worten sehr schwer "
   	+"zu beschreiben.\n\n");
   tell_object(MAENNLEIN, WEIBLEIN+" versucht sich auf ihre sexuellen und "
   	+"spirituellen Kraeft zu konzentrieren. Verliebt blickt sie Dir in "
   	+"die Deine Augen. Hingerissen und voll Bewunderung wird Dir ihre "
   	+"Schoenheit bewusst, die Dich mit einem ueberwaeltigenden Entzuecken "
   	+"erfuellt. Was in diesem Augenblick mit ihr geschieht, ist sehr "
   	+"schwer in Worten zu beschreiben.\n\n");
   		call_out("zweifel1",5);
}


zweifel1()
{	write("\n\n\n");
   TL(" Doch waehrend sich die Vorfreude und Lust auf Euer gemeinsames "
   	+"Ritual zu regen beginnt, ueberkommt Dich auch ein irritierendes "
   	+"Gefuehl - die tiefliegende Furcht, dass es nicht klappen koennte. "
   	+"Da merkst Du, dass die Liebe alles ans Licht bringt, was ihr "
   	+"ungleich ist. Diese sexuellen Blockierungen und negativen "
   	+"Haltungen, die aus der Schattenseite Deines Wesens auftauchen, "
   	+"musst Du erst heilen, wenn Du den Zugang zu Deiner vollen "
   	+"sexuellen Energie und Magie finden willst.\n\n");
	koennen+=1;
	rit = 0;
	return 1;
}

liebe1()
{	
	rit = 1;
   TL("Du entspannst Dich und wendest Dich Muddymud Vivienne zu. Langsam "
	+"geht ihr aufeinander zu, Du breitest Deine Arme aus und ihr "
	+"schenkt Euch eine innige Umarmung. Sanft schlingst Du Deine Arme "
	+"um Deine(n) Liebste(n), waehrend sich Eure Koerper an Brust, "
	+"Bauch, Becken und Oberschenkeln beruehren. Ihr atmet gemeinsam "
	+"in einer entspannten, harmonisch lockeren Weise. Du heisst die "
	+"Liebe Deines Partners willkommen, empfaengst und spuerst, wie "
	+"die Waerme Eurer Verbindung sich in Deiner Brust ausdehnt und "
	+"sich im ganzen Koerper ausbreitet.\n\n");
		call_out("zweifel2",5);
}

zweifel2()
{	write("\n\n\n");
   TL("Aber irgendwie hast Du nicht das Gefuehl, wirklich ganz dabeizusein. "
	+"Wie schoen es auch ist, hast Du doch das Gefuehl, dass Deine "
	+"spirituelle Energie irgendwie gedaempft, gestaut ist. Du bist "
	+"noch geistig und seelisch distanziert. Noch hast Du nicht "
	+"genuegend Vertrauen in Deinen Liebespartner Muddymud, um auf "
	+"eine tiefere spirituelle Ebene vorzudringen.\n\n");
	koennen+=1;
	rit = 0;
	return 1;
}

liebe2()
{	
	rit = 1;
   TL("Du konzentrierst Dich nun, bist voll und ganz gegenwaertig und schenkst "
   	+"dem Atem, den Empfindungen, den Gefuehlen Deine ganze Aufmerksam"
   	+"keit. Muddymud zieht Dich an sich - seine Lippen sind warm und "
   	+"sanft. Ein Schauer ueberlaeuft Dich wie ein Stromstoss, als er "
   	+"Dich noch einmal kuesst, diesmal laenger und leidenschaftlicher. "
   	+"Schliesslich haelt er inne und laechelt Dich an. Der Blick seiner "
   	+"strahlenden, unergruendlichen Augen scheint Dich zu verschlingen.\n\n");
   	call_out("zweifel3",5);
}
   
zweifel3()
{	write("\n\n\n");
      TL("Da entdeckst Du einen Tipfeler und der Gedanke den Typo abzusetzen, "
   	+"lenkt Dich ab, und ploetzlich bricht die ganze elektrische Spannung "
   	+"Eurer vereinigten sexuellen Energien zusammen. Ihr liegt Euch noch "
   	+"in den Armen, doch der Strom ist wie durch eine unsichtbare Hand "
   	+"abgeschaltet. Duch eine anscheinend ganz triviale Ursache hat sich "
   	+"die ganze Stimmung, die ganze sexuelle Atmosphaere ploetzlich "
   	+"verfluechtigt. In einem leichten Hauch von Traurigkeit beschliesst "
   	+"Du, in Zukunft nicht mehr so sehr auf Typos zu achten .... zumindest "
   	+"nicht, wenn es eine so einzigartige Erfahrung wie diese zu erfoschen "
   	+"gilt.\n\n");
   	koennen+=1;
   	rit = 0;
   	return 1;
}

liebe3()
{	
	rit = 1;
  TL("Du vertiefst Deine Atmung und klaerst Deinen Geist. Deine Sinne "
	+"schaerfen sich, Du oeffnest Dein Herz, und Dein Koerper beginnt "
	+"vor Lebendigkeit und Erwartung zu kribbeln. Zaertlich umarmst Du "
	+"Muddymud und vergraebst Deine Haende in seinen Haaren. Seine "
	+"Haende gleiten ueber Deine Haut und Du spuerst eine Welle der "
	+"Kraft ueberspringen, die Dich wie ein Sog erfasst. Wie sich der "
	+"Fluss an das Meer verschenkt, so zieht alles, was in Dir ist, in "
	+"Deinen Liebsten. Eure Koerper verschmelzen, versinken ineinander. "
	+"Du glaubst zu fallen, zu fallen und erkennst, dass Sexualitaet und "
	+"Geist eines sind. In Dir selbst entdeckst Du die Ekstase. Sie ist "
	+"nicht irgendwo ausserhalb, sie ist Deine innerste Bluete. Dein "
	+"Koerper wird zum hoechsten Tempel der Transformation, der Ort an "
	+"dem alle Kraefte des Universums gebuendelt und in eine hoehere "
	+"integrierte Ordnung der Natur und des Geistes verwandelt werden. "
	+"Du bist von der Empfindung der Freude und des tiefsten Glueckes "
	+"durchflutet und hast das Gefuehl keine Grenzen und Schranken mehr "
	+"zu haben.\n\n");
	call_out("vereinigung", 5);
}

vereinigung()
{	write("\n\n\n");
   TL("Kosmische Harmonie durchdringt Dich und erleuchtet Deinen Koerper, "
	+"Deine Seele, Dein Herz und Deinen Geist mit innerem Frieden. "
	+"Du fuehlst zufriedene Verbundenheit und Liebe zu allen anderen "
	+"Menschen, Fabelwesen, der Natur und der ganzen Welt (dem ganzen "
	+"Silberland ;) ).\n\n");
   //(present("\nritual"))->remove();
   TP->SetProp(P_SP, TP->QueryProp(P_SP)+15);
   TP->SetProp(P_HP, TP->QueryProp(P_HP)-20);
   erlaubt = 0;
   koennen+=1;
   rit = 0;
   return 1;
}


int drehe(string str)
{
	notify_fail("Was moechtest Du drehen?\n");
	if(!str) return 0;
	
	if(str=="ring")
	{
		notify_fail("In welche Richtung moechtest Du den Ring drehen?\n");
		return 0;
	}
	
	if(str=="ring nach rechts"||str=="ring nach links"|str=="ring dreimal nach rechts"||str=="ring dreimal nach links")
	{
		tell_object(TP, "Du drehst den Ring langsam und bedaechtig "
			+"dreimal am Finger und wartest...\n");
		CCALL("drehen",5);
		return 1;
	}
	return 0;
}	

drehen()
{
	tell_object(TP, "Tja, Du wartest und wartest, aber es will einfach "
		+"keine huebsche kleine Mauer auftauchen. Ob das ein Bug "
		+"ist?\n");
	return 1;
}


