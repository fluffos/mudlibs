#define CCALL(x,y) if(find_call_out(x)==-1) call_out(x, y)
#define BESCHRAENKUNG_TIME 20
int koennen;
int rit;

object vivi, muddy;

zwerge();
finger();
menschen();
collier();
form();
int lies(string str);
int drehe(string str);

int erlaubt;
int set_ritual(int value);
int query_ritual();
int ritual;

void _set_autoloadobj(int k)
{
	koennen = k;
}

int _query_autoloadobj()
{
	return koennen;
}


