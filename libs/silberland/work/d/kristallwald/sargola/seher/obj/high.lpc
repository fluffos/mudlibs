inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

string * messages = ({
	"asdfadsfdas\n",
	"adslalsfdsjal\n",
	"ljflkasjf\n"});



create()
{
   if (!is_clone(this_object()))
        return;
   ::create();

   SetProp(P_SHORT, 0);
   SetProp(P_WEIGHT, 0);
   SetProp(P_NODROP, 1);
   AddId (({"\nhigh"}));
   
   call_out("get_high",1);
}


get_high()
{
	tell_object(TP, messages[random(sizeof(messages))]);
	call_out("get_high",60);
}
		