inherit "std/thing";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

   string * chats =  ({
	"Du bist klitschnass. Trockne Dich lieber ab.\n",
	"HHHHAAATTSSCCHHIIIIIIIIII!\n",
	"Du erkaeltest Dich noch vor lauter nasser Kleidung.\n",
	"Bei jedem Schritt quatscht es in deinen Schuhen.\n",
	"Waerst Du auf der Planke nur vorsichtiger gewesen.\n",
	"Du bibbberst vor Kaelte.\n" });   
	
  string * chats_room = ({
  	TPN+" ist klitschnass. Vielleicht wuerde abtrocknen helfen?\n",
  	TPN+" muss laut niessen!\n",
  	TPN+" erkaeltet sich noch von der nassen Kleidung.\n",
  	"Bei jedem Schritt quatscht es in den Schuhen von "+TPN+"\n",
  	"Waere "+TPN+" auf der Planke vorsichtiger gewesen.\n",
  	TPN+" bibbert vor Kaelte.\n" });



create()
{
   if (!is_clone(this_object()))
        return;
   ::create();

   SetProp(P_SHORT, 0);
   SetProp(P_WEIGHT, 0);
   AddId (({"\nnass"}));

  call_out("nass",1);
  call_out("remove_nass",300);
}

remove_nass()
{
	if(find_call_out("nass")==1)
		remove_call_out("nass");
	TO->remove();
}


nass()
{
	int i;
	i = random(sizeof(chats));
	tell_object(TP, chats[i]);
	tell_room(environment(TP), chats_room[i] ,({TP}) );
	call_out("nass",30);
}