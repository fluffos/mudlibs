inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../def.h"

zwerge();
finger();
menschen();

create()
{
	if(!is_clone(TO))
		return ;

	SetProp(P_SHORT, "Ein Rubinring");
	SetProp(P_LONG, 
	"Dieser Rubinring ist ein Hochzeitsgeschenk von ganz besonders "
	"lieben Freunden. Passend zu Viviennes Collier wurde dieser Ring"	
	"aus Gold und einem Rubin gefertigt.");
	SetProp(P_INFO,
	"Warnung: Eifersuechtige Naturen seien vor der Verwendung "
	"des Rubins gewarnt, weil er auch das Streben nach Freiheit und "
	"Unabhaengigkeit in einer Partnerschaft foerdert.");


	SetProp(P_MATERIAL, ({MAT_GOLD, MAT_JEWEL}) );
	SetProp(P_VALUE, 10000);
	SetPro(P_NOSELL, 1);
	SetProp(P_NOBUY, 1);
	SetProp(P_GENDER, MALE);
	SetProp(P_WEIGHT, 150);
	SetProp(P_ARMOUR_TYPE, AT_RING);


AddDetail(({"collier"}),
	"Ueber Viviennes Collier weisst Du doch eh schon alles ...");

AddDetail("gold",
	"Es faellt uns schwer zuzugeben: dieses Gold stammt aus Fel"
	"onia. Es ist bis auf eine kleine Stelle ebenmaessig verarb"
	"eitet.");

AddDetail("felonia",
	"Felonia wirst Du wohl kennen. Zur Genuege. Willst Du Dir nicht "
	"mal was anderes ansehen?");

AddDetail(({"genuege", "genug"}),
	"Genug ist genug.");

AddDetail("stelle",
	"Du glaubst einen kleinen Kratzer zu erkennen.");

AddDetail("kratzer",
	"Du glaubst doch nicht wirklich, in diesem schoenen Geschenk "
	"wuerde sich ein Kratzer befinden ?! Nein, es handelt sich viel"
	"mehr um eine Gravur.");

AddDetail("gravur",
	"Sie ist wirklich klitzeklein, und Du glaubst am Beginn das Wort "
	 "\"Warnung\" zu erkennen.");

AddDetail(({"beginn", "wort", "warnung"}),
	"Mehr kannst Du nicht erkennen, diese Gravur ist wirklich klitze"
	"klein.");

AddDetail(({"hochzeitsgeschenk", "geschenk"}),
	"Na, der Rubinring .... (jeden Bloedsinn untersuchen)");

AddDetail("bloedsinn",
	"Du bist so genial, Du untersuchst jeden Bloedsinn. (Das hat "
	"Sargola gesagt.)");

AddDetail(({"freunde"}),
	"Du hast ziemlich viele Freunde, aber zu Deinen besten gehoeren: "
	"Sargola "
	"und Gridi.");

AddDetail(({"sargola", "gridi", "sargola und gridi"}),
	"Sargola und Gridi sind wirklich gute Freunde von Dir, sonst "
	"haetten sie Dir "
	"sicher nicht diesen wunderschoenen und sicherlich sehr kost"
	"baren Ring geschenkt.");

AddDetail(({"rubin", "rubine"}),
	"Der Rubin ist ein Korund, der durch eine Beimengung von "
	+"Chrom-Oxyd tiefrot mit einem Hauch von Blau gefaerbt ist. "
	+"Obgleich es auch hellere und lichtere Vertreter aus der "
	+"Familie der Rubine gibt, stellt der Taubenblutrote die "
	+"begehrteste Form dar.");

AddDetail("familie",
	"Die meisten Vertreter aus der Familie der Rubine sind in "
	"irgendeiner Form rot. (Wer haette das gedacht ... ");

AddDetail("form",
	"Wenn es Dir gerade nicht schlecht geht, ist Deine momentane "
	"Form wahrscheinlich ganz gut.");

AddDetail(({"taubenblutrot", "taubenblutrote", "taubenblut"}),
	"Rot wie Taubenblut.");

AddDetail(({"korund", "korunde"}),
	"Zu den Korunden gehoeren zB der Rubin, der Saphir und der "
	"Padparadscha.");

AddDetail(({"saphir", "padparadscha", "edelstein", "edelsteine" "buch"}),
	"Wenn Du mehr darueber wissen willst, besorg "
	"Dir doch ein Buch ueber Edelsteine.");

AddDetail(({"beimengung", "chrom-oxyd"}),
	"Frag einen Chemiker!");

AddDetail(({"chemiker"}),
	"Manche meinen, ein Chemiker wuerde gar nicht ins Silberland "
	"passen, deswegen gibt es wahrscheinlich auch Regel 39.");

AddDetail(({"silberland", "welt"}),
	"Diese Welt wird Silberland genannt.");

AddDetail(({"regel", "regel 39"}),
	"Regel 39: Ich mudde nicht. (Das gilt gluecklicherweise nicht "
	"fuer uns.)");

AddDetail(({"vertreter"}),
	"Ein Vertreter ist jemand, der im Namen und fuer Rechnung ein"
	"es anderen taetig wird. (Naja, in diesem Zusammenhang ist es "
	"anders gemeint.)");

AddDetail(({"name", "namen"}),
	"Hoffentlich weisst Du selber, wie Du heisst ...");

AddDetail(({"rechnung", "buchhaltung"}),
	"Wir machen jetzt nicht Buchhaltung!");

AddDetail(({"zusammenhang"}),
	"Es geht hier um den Ring, falls Du es vergessen haben soll"
	"test."),

AddDetail(({"hauch","blau", "strahl", "lichtstrahl"}),
	"Durch den blauen Lichtstrahl, den der Rubin reflektiert, wird "
	+"Spiritualitaet auf eine tiefere Ebene gelenkt, um diese zu "
	+"durchdringen.");

AddDetail("ebene",
	"Er bringt er uns mit den hoeheren Idealen der Liebe in "
	+"Verbindung und wird daher bei tantrischen Ritualen haeufig "
	+"angewandt.");

AddDetail(({"ritual", "rituale", "tantrische rituale",
	"tantrisches ritual", "beduerfnis"}),
	"Tantrische Rituale helfen Dir, Dein seelisches Beduerfnis nach "
	"Vereinigung der Spiritualitaet und Sexualitaet mit Deinem "
	"Partner staerker zu entfalten und zu leben.");

AddDetail(({"ideal", "ideale", "schwingung", "einklang"}),
	"Die Schwingung des Rubins unterstuetzt die harmonische Verbi"
	"ndung zwischen koerperlicher und geistiger Liebe und bringt sie "
	"Einklang zueinander.");

AddDetail("liebe",
	"Wenn Du nicht weisst, was die Liebe ist, haettest Du besser "
	"nicht heiraten sollen. ;-)");

AddDetail(({"spiritualitaet"}),
	"Der Rubin foerdert Deine Vorstellungskraft und Erkenntnis"
	"faehigkeit.");

AddDetail(({"vorstellungskraft", "vorstellungen"}),
	"Der Rubin hilft Dir auch, diese Vorstellungen auf materieller "
	"Ebene zu verwirklichen.");

AddDetail(({"erkenntnisfaehigkeit", "erkenntnis", "faehigkeit"}),
	"Du kommst zur Erkenntnis, dass Du mit Deiner Heirat eine "
	"gute Wahl getroffen hast.");
 
AddDetail(({"heirat", "wahl"}),
	"Da Du aus Liebe geheiratet hast, war es eine gute Wahl.");

AddDetail(({"verbindung", "vereinigung"}),
	"Alles nur aus Liebe. Oder hast Du etwa geheiratet um einen "
	"Garten (mit Mauer) zu bekommen?");

AddDetail(({"garten", "mauer"}),
	"So weit Du auch blickst - du siehst weder Garten noch Mauer. "
	"Vielleicht, wenn Du den Ring an Deinen Finger steckst und "
	"dreimal drehst - von links nach rechts? Oder umgekehrt?");

AddDetail(({"finger"}),#'finger );

AddDetail(({"zwerge"}),#'zwerge);
	
AddDetail("menschen",#'menschen);

AddDetail("partner",
	"Du weisst doch noch, wen Du geheiratet hast?");

AddDetail("sexualitaet"
	"Der Ring kann Dein Potential erheblich steigern ... (<- das ist "
	"ein Wink mit dem Zaunpfahl)";

AddDetail(({"zaunpfahl", "zaun"}),
	"Zaunpfahl? Zaun? Garten? Mauer? Noooeeee!");

AddDetail("wink",
	"Sargola und Gridi winken Dir aus der Ferne zu.");

AddDetail("potential",
	"Du denkst . o O ( Was? Noch mehr? )");

}

finger()
{
	if(TP->QueryProp(P_NAME) == "Vivienne")
	{
	   tell_object(TP, "Auch Zwerge haben nur 10 Finger.");
	   return "";
	}
	else
	{
	   tell_object(TP, "Auch Menschen haben nur 10 Finger.");
	   return "";
	}
}

menschen()
{
	tell_object(TP, "Du kontrollierst schnell nach - stimmt! "
	+"Es sind 10 Finger!! Ich muss wohl Mensch sein!");
	return "";
}

zwerge()
{
	if(TP->QueryProp(P_NAME) == "Vivienne)
	{
	   tell_object(TP, "Es gibt auch liebe Zwerge. Die haben "
		+"aber sicher einen wunderschoenen Garten (mit Mauer).");
		return "";
	}
}


