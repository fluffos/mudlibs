#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine dunkelblaue Robe");
  SetProp(P_LONG, BS("Die Robe besteht aus dunkelblauem Samt und ihr "
    "Kragen besteht aus schwarz-weiss gepunktetem Fell.") );
  AddDetail("samt","Der Samt ist dunkelblau und wirkt ziemlich edel.");
  AddDetail("kragen","Er besteht aus schwarz-weiss gepunktetem Fell.");
  AddDetail("fell","Es ist Hermelinfell wie Du unschwer erkennen kannst.");
  AddDetail("hermelinfell","Das erkennt man an den kleinen schwarzen "
    "Spitzen im Fell. Sicherlich ist es sehr wertvoll.");
  AddDetail(({"spitzen","schwanzspitzen"}),"Die Spitzen sind die Schwanzspitzen der armen Hermeline.");
  AddDetail( ({"hermeline","hermelin"}), "Von denen kann man nur mehr "
    "Spitzen erkennen *grins*."); 
  
  
  SetProp(P_NAME, "Robe");
  SetProp(P_NAME_ADJ, "dunkelblau");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"robe"}) );
  AddAdjective( ({"dunkelblau", "dunkelblauen", "dunkelblauer"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 150);

  SetProp(P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE:({"Elf", "Mensch"}) ]) );
}

