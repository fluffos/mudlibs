inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"schild"}));
  SetProp (P_SHORT, "Ein schwarzes Schild");
  SetProp (P_LONG,
      "Es ist ein recht widerstandsfaehiger Schild aus schwarzem Mithril.\n");
  SetProp (P_NAME, "Mithrilschild");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 1750);
  SetProp (P_VALUE, 3000);

  SetProp (P_MATERIAL, MAT_MITHRIL);
  SetProp (P_ARMOUR_TYPE, AT_SHIELD);
  SetProp (P_AC, 29);
  SetProp (P_WEAR_RESTRICTIONS, ([A_STR:15]) );
  SetProp (P_QUALITY_DECAY, 250);
}
