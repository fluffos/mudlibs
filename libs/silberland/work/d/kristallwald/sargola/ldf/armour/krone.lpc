#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Krone");
  SetProp(P_LONG, BS("Die Krone ist zwar klein, dafuer wirkt sie "
    "aber umso wertvoller. Sie braucht nicht mit tausenden Perlen "
    "und Edelsteinen prahlen um dem Traeger ein koenigliches Aus"
    "sehen zu verleihen.") );
  AddDetail("perlen","Perlen kannst Du an der Krone keine finden.");
  AddDetail( ({"steine","edelsteine"}),"Es sind zwar ein paar Edel"
    "steine auf der Krone, aber erstaunlich wenige. Genaugenommen "
    "nur ein grosser roter im Zentrum und ein paar kleine weisse "
    "rundherum.");
  AddDetail("zentrum","Dort ist ein grosser Rubin eingelassen.");
  AddDetail("rubin","Er ist tiefrot und von auffallender Groesse.");
  AddDetail("groesse","Fuer einen Rubin ziemlich gross.");
  
  
  
  SetProp(P_NAME, "Krone");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"krone"}) );

  
  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_GOLD, MAT_JEWEL );
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 1500);

  SetProp(P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE:({"Elf", "Mensch"}) ]) );
}

