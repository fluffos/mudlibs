inherit "std/armour";
#include <properties.h>
#include <combat.h>
#include "../def.h"

string loch();
int loch;
int repariere(string str);

void create()
{
   if (!is_clone(this_object())) return;   ::create();

   loch = 1;
 
   SetProp(P_SHORT, "Ein edler Mantel");
      
   AddDetail("material","Das Material ist ein Gewebe, das man Mondschein"
     "gewebe nennt.");
   AddDetail(({"gewebe","mondscheingewebe"}), "Man sagt, dass dieses "
     "Gewebe Dich vor den Blicken der schwarzen Spaeher schuetzen kann!");
   AddDetail("schimmer","Der Schimmer muss sein, damit der Mantel auch "
     "ein wenig magisch wirkt!");

   AddDetail("loch",#'loch);
 
   SetProp(P_NAME, "Mantel");
   AddId(({ "mantel","\nldfmantel"}));
   SetProp(P_WEIGHT, 400);
   SetProp(P_VALUE, 800);
   SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
   SetProp(P_AC, 2);
   SetProp(P_NOSELL,1);
   SetProp(P_NOBUY,1);  
  SetProp (P_NODROP,1);
  SetProp (P_NEVERDROP,1);

   SetProp(P_GENDER, MALE);
   
   AddCmd(({"reparier","repariere"}),"repariere");
}

int repariere(string str)
{
  tell_object(TP, "Einen Mantel kann man doch nicht reparieren.\n");
  return 1;
}

void setze_loch(int i)
{
  if(getuid(previous_object())!= getuid() )
  {
	write("Du bist nicht berechtigt, das zu tun...\n");
	return 0;
  }
  loch = i;
}

string loch()
{
  if(loch)
  {
    return BS("Das Loch ist mittelmaessig gross und der Mantel wird "
      "damit unbrauchbar, weil er Dich nicht mehr unsichtbar fuer die "
      "schwarzen Spaeher macht.");
  }
  else
  {
    return BS("Du kannst an dem Mantel kein Loch mehr sehen. Obwohl Du "
      "nur schwarzen Stoff eingenaeht hast, ist er ein praechtiger Schutz.");
  }
}

_query_long()
{
  if(!loch)
  {
    return BS("Ein edler, fast nobel wirkender Mantel aus einem sehr seltsam "
      "anmutenden Material. Er wiegt kaum etwas und das Gewebe hat "
      "einen milchigen Schimmer.\n");
  }
  else
  {
    return BS("Ein edler, fast nobel wirkender Mantel aus einem sehr seltsam "
      "anmutenden Material. Er wiegt kaum etwas und das Gewebe hat "
      "einen milchigen Schimmer. Der Mantel hat in der Mitte ein Loch. Da wirst "
      "Du wohl eine kompetente Person fragen muessen, ob sie Dir helfen kann.");
  }
}
