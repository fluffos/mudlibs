inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"panzer","eisenpanzer"}));
  SetProp (P_SHORT, "Ein Eisenpanzer");
  SetProp (P_LONG,
    "Der Panzer ist aus schwerem Eisen und stellt einen guten Schutz dar. "
    "Doch durch die Magie von Ritter Kato ist er teilweise schwarz "
    "geworden.\n");
  AddDetail("magie","Die sieht daran, dass der Panzer so schwarz ist. Da"
    "durch ist er vielleicht auch stabiler als ein normaler Eisenpanzer.");
  SetProp (P_NAME, "Eisenpanzer");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 1650);
  SetProp (P_VALUE, 1300);

  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 33);

  SetProp (P_MATERIAL, MAT_IRON);
  AddDetail ("eisen", "Schweres Eisen bildet die Grundlage fuer den "+
    "Schutz, den dieser Eisenpanzer seinem Traeger bietet. Verstaerkt "
    "durch die Magie");
}
