inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"stiefel","schwarze stiefel","lederstiefel"}));
  SetProp (P_SHORT, "Ein Paar schwarze Stiefel");
  SetProp (P_LONG, "Feste Stiefel aus schwarzem Leder.\n");
  SetProp (P_NAME, "Paar schwarze Lederstiefel");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 250);
  SetProp (P_VALUE, 800);

  SetProp (P_ARMOUR_TYPE, AT_BOOT);
  SetProp (P_AC, 6);
}
