
inherit "/std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"

int betrete(string str);

create()      
{        if (!is_clone(this_object()))           return;
	::create();

  AddId ( ({"\nldfhuette"}) );
  SetProp (P_SHORT, 0);
 

 
  SetProp (P_NOSELL,1);
  SetProp (P_NOBUY,1);
  SetProp (P_NODROP,1);
  SetProp (P_NOGET,1);
  
  AddCmd(({"betrete","betret"}), "betrete");
}  

int betrete(string str)
{
  notify_fail("Was moechtest Du betreten?\n");
  if(!str) return 0;
  
  if(str=="huette"||str=="holzhuette")
  {
    return TP->move(ROOM+"heno", M_GO);
  }
  return 0;
}


