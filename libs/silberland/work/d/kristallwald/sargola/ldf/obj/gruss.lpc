
inherit "/std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"


create()      
{        if (!is_clone(this_object()))           return;
	::create();

  AddId ( ({"gruss","schoenen gruss","\nldfgruss"}) );
  SetProp (P_SHORT, "Ein schoener Gruss");
  SetProp (P_LONG, BS("Ein schoener Gruss fuer den Schmied."));
 
  
  
  SetProp (P_NAME, "Gruss");
  SetProp (P_GENDER, MALE); 
  SetProp (P_WEIGHT, 0);
  SetProp (P_VALUE, 0);
  SetProp (P_MATERIAL, ({MAT_MAGIC}));
  SetProp (P_NOSELL,1);
  SetProp (P_NOBUY,1);

  
  
}  
