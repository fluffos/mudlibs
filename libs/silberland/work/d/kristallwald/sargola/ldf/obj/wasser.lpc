
inherit "/std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"

int trink(string str);

create()      
{        if (!is_clone(this_object()))           return;
	::create();

  AddId ( ({"wasser","wasserflasche","flasche","\nldfwasser"}) );
  SetProp (P_SHORT, "Eine Flasche Wasser");
  SetProp (P_LONG, BS("Eine kleine Flasche, gefuellt mit klarem, "
    "kaltem Wasser das eigenartig sprudelt."));
 
  
  
  SetProp (P_NAME, "Wasser");
  SetProp (P_GENDER, NEUTER); 
  SetProp (P_WEIGHT, 235);
  SetProp (P_VALUE, 10);
  SetProp (P_MATERIAL, ({MAT_WATER}));
  SetProp (P_NOSELL,1);
  SetProp (P_NOBUY,1);
  SetProp (P_NODROP,1);
  SetProp (P_NEVERDROP,1);

  
  AddCmd(({"trink","trinke"}),"trink");
}  

int trink(string str)
{
  notify_fail("Was moechtest Du trinken?\n");
  if(!str) return 0;
  
  if(str=="wasser")
  {
    tell_object(TP , BS("Nein, wer weiss, wofuer Du das noch brauchen kannst."));
    return 1;
  }
  return 0;
}

