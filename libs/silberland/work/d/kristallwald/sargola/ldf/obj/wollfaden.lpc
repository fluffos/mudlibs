
inherit "/std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"


create()      
{        if (!is_clone(this_object()))           return;
	::create();

  AddId ( ({"faden","wollfaden","\nldfwollfaden"}) );
  SetProp (P_SHORT, "Ein Wollfaden");
  SetProp (P_LONG, "Ein extralanger Faden aus schwarzer Wolle.");



  
  
  SetProp (P_NAME, "Wollfaden");
  SetProp (P_GENDER, MALE); 
  SetProp (P_WEIGHT, 555);
  SetProp (P_VALUE, 200);
  SetProp (P_MATERIAL, ({MAT_WOOL}));
  SetProp (P_NOSELL,1);
  SetProp (P_NOBUY,1);
  SetProp (P_NODROP,1);
  

}  


