
inherit "/std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"

int iss(string str);

create()      
{        if (!is_clone(this_object()))           return;
	::create();

  AddId ( ({"zucker","stueck","zuckerstueck","\nldfzucker"}) );
  SetProp (P_SHORT, "Einige Stuecke Zucker");
  SetProp (P_LONG, "Du siehst ein paar Stuecke aus weissem Zucker.");
 

  SetProp (P_NAME, "Zucker");
  SetProp (P_GENDER, MALE); 
  SetProp (P_WEIGHT, 35);
  SetProp (P_VALUE, 40);
  SetProp (P_MATERIAL, ({MAT_FOOD}));
  SetProp (P_NOSELL,1);
  SetProp (P_NOBUY,1);
  SetProp (P_NODROP,1);
  
  AddCmd(({"iss","ess","esse","verspeis","verspeise"}), "iss");
}  

int iss(string str)
{
  notify_fail("Was moechtest Du essen?\n");
  if(!str) return 0;
  
  if(str=="zucker"||str=="zuckerstuecke")
  {
    tell_object(TP,"Du wirst doch nicht den puren Zucker essen wollen!\n");
    return 1;
  }
  return 0;
}


