
inherit "/std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"
#include "../../dorf/obj/ldfquest.h"

int schere(string str);


create()      
{        if (!is_clone(this_object()))           return;
	::create();

  AddId ( ({"schere","scherschere","geraet","schergeraet","\nldfschere"}) );

  SetProp (P_SHORT, "Eine Schere zum Scheren");
  SetProp (P_LONG, "Eine scharfe Schere, mit der man Schafe scheren kann.");

  
  SetProp (P_NAME, "Schere");
  SetProp (P_GENDER, FEMALE); 
  SetProp (P_WEIGHT, 335);
  SetProp (P_VALUE, 90);
  SetProp (P_MATERIAL, ({MAT_METAL}));
  SetProp (P_NOSELL,1);
  SetProp (P_NOBUY,1);
  SetProp (P_NODROP,1);
  
  AddCmd( ({"schere","scher"}), "schere");

}  
int schere(string str)
{
  object ob;
  int val;
  ob = deep_present("\nldfquest",TP);
  if(objectp(ob)) val = ob->frage_wert(WOLLE);
  notify_fail("Was moechtest Du scheren?\n");
  if(!str) return 0;
  
  if(str=="schaf")
  {
    tell_object(TP, BS("Was fuer ein Schaf willst Du scheren? Es gibt "
      "weisse und schwarze."));
    return 1;
  }
  if(str=="weisses schaf")
  {
    tell_object(TP, BS("Hmm... Du willst in eine finstere Gegend.. waere es "
      "da nicht besser, wenn Du einen dunkleren Mantel haettest?"));
    return 1;
  }
  if(str!="schwarzes schaf") return 0;
  
  if(!present("\nldfschaf",environment(TP)))
  {
    tell_object(TP, "Es ist kein schwarzes Schaf in diesem Raum.");
    return 1;
  }
  if(val==1 && present("\nldfwolle",TP))
  {
    tell_object(TP, "Du hast doch schon geschoren!\n");
    return 1;
  }
  
  tell_object(TP, BS("Du beginnst mit der gehoerigen Vorsicht das schwarze "
    "Schaf zu scheren. Eine zeitlang geht das auch gut ... bis Du das Schaf "
    "schneidest und es Dich wutentbrannt tritt!\n\nHauptsache, Du hast die "
    "Wolle."));
  TP->reduce_hit_points(10);
  ob = clone_object(OBJ+"wolle");
  val = ob->move(TP);
  if(val==ME_TOO_HEAVY)
  {
    tell_object(TP, "Die Wolle ist zu schwer fuer Dich.\n");
    ob->move(environment(TP));
  }
  ob = deep_present("\nldfquest",TP);
  if(objectp(ob)) ob->setze_wert(WOLLE,1);
  tell_object(TP,"Du legst die Schere schnell weg.\n");
  TO->remove();
  return 1;
}
  
  
  
  
