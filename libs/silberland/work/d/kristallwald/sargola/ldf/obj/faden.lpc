
inherit "/std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"


create()      
{        if (!is_clone(this_object()))           return;
	::create();

  AddId ( ({"faden","naehfaden","\nldffaden"}) );
  SetProp (P_SHORT, "Eine Naehfaden");
  SetProp (P_LONG, "Ein schwarzer Naehfaden.");
  
  SetProp (P_NAME, "Naehfaden");
  SetProp (P_GENDER, MALE); 
  SetProp (P_WEIGHT, 35);
  SetProp (P_VALUE, 20);
  SetProp (P_MATERIAL, ({MAT_CLOTH}));
  SetProp (P_NOSELL,1);
  SetProp (P_NOBUY,1);
  SetProp (P_NODROP,1);

  

}  


