
inherit "/std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"
#include "../../dorf/obj/ldfquest.h"

int oeffne(string str);
int schliesse(string str);
int fange(string str);
int check();

string klang();
string hoere_klang();

int offen;
int klang;

string hals();
string kork();


create()      
{        if (!is_clone(this_object()))           return;
	::create();

  AddId ( ({"flasche","\nldfflasche"}) );
  offen = 0;
  klang=0;
  
  SetProp (P_SHORT, "Eine einfache Flasche");

  AddDetail("hals",#'hals);
  AddDetail(({"kork","stoepsel","korken"}),#'kork);
  AddDetail("kordel","An ihr befindet sich der Korken.");
  
  SetProp (P_NAME, "Flasche");
  SetProp (P_GENDER, FEMALE); 
  SetProp (P_WEIGHT, 235);
  SetProp (P_VALUE, 100);
  SetProp (P_MATERIAL, ({MAT_GLASS}));
  SetProp (P_NOSELL,1);
  SetProp (P_NOBUY,1);
  SetProp (P_NODROP,1);
  SetProp (P_SOUND, #'hoere_klang);
  
  AddDetail("klang",#'klang);
  
  AddCmd( ({"schliesse","schliess"}),"schliesse");
  AddCmd( ({"oeffne"}), "oeffne");
  AddCmd( ({"fang","fange"}), "fange");
}  

string klang()
{
  if(klang)
  {
    return BS("Der Klang fliesst in der Flasche umher. Eventuell "
      "kann man ihn hoeren.");
  }
  return BS("Sowas siehst Du an der Flasche nicht.");
}
string hoere_klang()
{
  if(klang)
  {
    return BS("Du lauschst an der Flasche und hoerst den wunderschoenen "
      "Klang der Hirtenfloete.");
  }
  return BS("Du hoerst nichts Besonderes an der Flasche.");
}

string hals()
{
  if(offen)
  {
    return "An dem schlanken Hals baumelt ein Korken.\n";
  }
  else
  {
    return "Der schlanke Hals ist mit einem Korken verschlossen.\n";
  }
 
}

string kork()
{
  if(offen)
  {
    return "Der Kork baumelt lose am Hals der Flasche.\n";
  }
  else
    return "Der Kork steckt im Hals der Flasche.\n";
}

_query_long()
{  string * a;
   a = "Eine einfache, rundliche Flasche mit einem langen, schlanken Hals.";
   if(offen)
   {
     a = a + " In ihm steckt ein kleiner Stoepsel aus Kork, der mit "
       "einer Kordel am Hals festgebunden ist.";
   }
   else
   {
     a = a + " In dem Hals steckt ein Korken drin.";
   }
   if(klang)
   {
     a = a + " Im Inneren der Flasche kannst Du eindeutig den Klang einer "
       "Hirtenfloete erkennen.";
   }
   return BS(a);
}
 
 
int oeffne(string str)
{
  notify_fail("Was moechtst Du oeffnen?\n");
  if(str!="flasche") return 0;
  if(offen) {  tell_object(TP, "Die Flasche ist schon offen!\n"); return 1; }
  if(!klang) { tell_object(TP, "Du oeffnest die Flasche.\n"); offen = 1; return 1; }
  
  
  if(klang
     && !(file_name(environment(TP))=="/d/kristallwald/sargola/ldf/room/b2")
     && check())
  {
    tell_object(TP, BS("Das ist nicht der richtige Ort, um den Klang rauszulassen."));
    return 1;
  }
  
  // ok, richtige stelle
  tell_object(TP, BS("Du ziehst den Korken aus der Flasche und sofort "
    "stroemt der Klang und erfuellt den Raum. Sonst ist es im Wald "
    "ja unheimlich ruhig, aber nun klingt es glasklar und Du denkst "
    "wieder an das schoene Land der Ferne. Vor Dir beginnt sich "
    "nach und nach der Stollen zu zeigen! Die Magie von Ritter Kato "
    "ist gebrochen!\nDu wirfst die nutzlose Flasche weg.\n\nDu gehst "
    "ins Innere des Berges..."));
  TP->move(ROOM+"st1",M_GO);
  TO->remove();
  return 1;
}

int schliesse(string str)
{
  notify_fail("Was moechtest Du schliessen?\n"); 
  if(str!="flasche") return 0;
  if(!offen) { tell_object(TP, "Die Flasche ist schon geschlossen!\n"); return 1; }
  
  tell_object(TP, BS("Du verschliesst die Flasche mit dem Korken."));
  offen = 0;
  return 1;
}

int fange(string str)
{
  object ob;
  int val;
  
  ob = deep_present("\nldfquest",TP);
  if(objectp(ob)) val = ob->frage_wert(FLASCHE);
  
  notify_fail("Was moechtest Du fangen?\n");
  if(klang)
  {
    tell_object(TP, BS("Du hast schon einen Klang gefangen."));
    return 1;
  }
  
  /*nicht die eigene flasche*/
  if(val<2)
  {
    tell_object(TP, BS("Das ist aber nicht Deine Flasche!\nDie Flasche "
      "verpufft..."));
    TO->remove();
  }
  
  if(str=="klang ein"||str=="klang")
  {
    if(!present("nonno",environment(environment(TO))))
    {
      tell_object(TP, "Das ist nicht die richtige Stelle.");
      return 1;
    }
    if(find_call_out("nonno_spielt"))
    {
      if(offen)
      {
        tell_object(TP, BS("Du fuchtelst wild mit der Flasche in der Luft herum "
	  "und stoepselst die Flasche schnell wieder zu! Tatsaechlich, in der "
	  "Flasche siehst Du den Klang der Hirtenfloete herumstroemen."));
	ob->setze_wert(FLASCHE,3);
	offen = 0;
	klang = 1;
	return 1;
      }
      else
      {
        tell_object(TP, BS("Du fuchtelst aeusserst wild mit der Flasche herum, "
	  "doch will sich kein Klang in der Flasche fangen - weil sie einfach "
	  "geschlossen ist!"));
	return 1;
      }
    }
    else
    {
      tell_object(TP, "Nonno spielt doch gerade gar kein Hirtenlied.\n");
      return 1;
    }
  }
  return 0;
}

int check()
{
  object ob;
  ob = deep_present("\nldfquest",TP);
  if(objectp(ob))
    return ob->frage_wert(BERGHINWEIS);
}
