
inherit "/std/thing";
inherit "/mail/nedit";
inherit "/std/more";
#include <properties.h>
#include <language.h>
#include "../def.h"


create()      
{        if (!is_clone(this_object()))           return;
	::create();

  AddId ( ({"schraubenzieher","\nldfschraubenzieher"}) );
  SetProp (P_SHORT, "Ein Schraubenzieher");
  SetProp (P_LONG, "Ein abgegriffener, haeufig verwendeter Schrauben"
    "zieher, der dem Rosengaertner gehoert. Er will ihn sicher bald "
    "wiederhaben...");
  AddDetail(({"gravur","rosengaertner"}),"Du entdeckt doch glatt die Gravur: \"Bring "
    "ihn mir ja zurueck!\".");

  
  
  SetProp (P_NAME, "Schraubenzieher");
  SetProp (P_GENDER, MALE); 
  SetProp (P_WEIGHT, 65);
  SetProp (P_VALUE, 30);
  SetProp (P_MATERIAL, ({MAT_METAL}));
  
  SetProp( P_INFO, BS("Der Schraubenzieher hat Sehnsucht nach seinem "
    "RECHTMAESSIGEN Besitzer, dem Rosengaertner."));

}  


