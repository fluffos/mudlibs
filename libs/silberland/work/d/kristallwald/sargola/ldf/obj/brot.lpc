
inherit "/std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"

int iss(string str);

create()      
{        if (!is_clone(this_object()))           return;
	::create();

  AddId ( ({"brot","brotlaib","laib","\nldfbrot"}) );
  SetProp (P_SHORT, "Ein Laib Brot");
  SetProp (P_LONG, BS("Ein kleiner, runder Laib trockenen Brotes."));
 
  
  
  SetProp (P_NAME, "Brot");
  SetProp (P_GENDER, NEUTER); 
  SetProp (P_WEIGHT, 235);
  SetProp (P_VALUE, 10);
  SetProp (P_MATERIAL, ({MAT_FOOD}));
  SetProp (P_NOSELL,1);
  SetProp (P_NOBUY,1);
  SetProp (P_NODROP,1);
  SetProp (P_NEVERDROP,1);

  
  AddCmd(({"iss","ess","esse","verspeis","verspeise"}),"iss");
}  

int iss(string str)
{
  notify_fail("Was moechtest Du essen?\n");
  if(!str) return 0;
  
  if(str=="brot"||str=="laib")
  {
    tell_object(TP , BS("Nein, wer weiss, wofuer Du das noch brauchen kannst."));
    return 1;
  }
  return 0;
}

