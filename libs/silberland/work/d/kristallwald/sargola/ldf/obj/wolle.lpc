
inherit "/std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"
#include "../../dorf/obj/ldfquest.h"


int gekaemmt;
int schmutzig;

int setze_schmutzig(int i);
int setze_gekaemmt(int i);
int frage_schmutzig();
int frage_gekaemmt();

int kaemme(string str);


create()      
{        if (!is_clone(this_object()))           return;
	::create();

  AddId ( ({"wolle","schafwolle","\nldfwolle"}) );
  schmutzig = 1;
  gekaemmt=0;
  
  SetProp (P_SHORT, "Schwarze Wolle");

  
  SetProp (P_NAME, "Wolle");
  SetProp (P_GENDER, FEMALE); 
  SetProp (P_WEIGHT, 135);
  SetProp (P_VALUE, 20);
  SetProp (P_MATERIAL, ({MAT_WOOL}));
  SetProp (P_NOSELL,1);
  SetProp (P_NOBUY,1);
  SetProp (P_NODROP,1);
  
  AddCmd(({"kaemm", "kaemme"}), "kaemme");

}  

int kaemme(string str)
{
  object ob;
  
  notify_fail("Was moechtest Du kaemmen?\n");
  if(!str) return 0;

  if(str=="wolle"||str=="schafwolle"||str=="wolle mit fingern"||str=="schafwolle mit fingern")
  {
    if(gekaemmt)
    {
      tell_object(TP, "Die Wolle ist schon gekaemmt.\n");
      return 1;
    }
    tell_object(TP, BS("Du faehrst eine Zeitlang mit den Fingern durch die "
      "Wolle und kaemmst sie so notduerftig."));
    gekaemmt=1;
    ob = deep_present("\nldfquest",TP);
    if(objectp(ob)) ob->setze_wert(WOLLE,3);
    return 1;
  }
  return 0;
}

_query_long()
{
  string * a;
  a = "Schwarze Wolle, eigenhaendig von einem schwarzen Schaf geschoren.";
  
  if(schmutzig)
  {  a = a + " Leider ist sie ziemlich dreckig - eventuell solltest Du sie waschen."; }
  else
  {
    if(gekaemmt) 
    {
      a = a + " Die Wolle kann man in einem Spinnrad sicher gut verarbeiten.";
    }
    else
    {
      a = a + " Sie muss noch gekaemmt werden, damit sie in einem Spinnrad verarbeitet werden kann.";
    }
  }
  return BS(a);
}	

int setze_schmutzig(int i)
{
  schmutzig = i;
}
int setze_gekaemmt(int i)
{
  gekaemmt=i;
}
int frage_schmutzig()
{
  return schmutzig;
}
int frage_gekaemmt()
{
  return gekaemmt;
} 
