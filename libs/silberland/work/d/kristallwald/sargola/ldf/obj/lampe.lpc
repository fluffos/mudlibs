
inherit "/std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"


create()      
{        if (!is_clone(this_object()))           return;
	::create();

  AddId ( ({"lampe","oellampe","\nldflampe"}) );
  SetProp (P_SHORT, "Eine winzige Lampe");
  SetProp (P_LONG, "Selten hast Du eine praechtigere Lampe in Haenden ge"
     "halten. Sie ist ueber und ueber mit gueldenen Verzierungen geschmue"
     "ckt und hat eine Klappe aus purem Gold. Ausserdem kannst Du einen "
     "durchaus praktischen Griff entdecken.");
  AddDetail("klappe","Die Klappe dient wohl dazu, Oel nachzuleeren.");
  AddDetail("oel","Die Lampe ist komplett trocken - kein Oel zu sehen.");
  AddDetail("verzierungen","Ueberall findest Du fein gearbeitet gueldene "
    "Verzierungen und schnoerkeligen Firlefanz. Hauptsache, der Dschinn "
    "steht auf sowas :).");
  AddDetail("firlefanz","Du bist Dir nicht sicher, ob er echt ist oder "
    "nicht, aber es sieht auf jedenfall prunkvoll aus.");
  AddDetail("griff","Der Griff dient wohl dazu, die Lampe zu halten.");
  AddDetail("gold","Wenn Du die Lampe verkaufen koenntest, koenntest Du "
    "sicher viel Geld damit machen!");
  

  
  
  SetProp (P_NAME, "Oellampe");
  SetProp (P_GENDER, FEMALE); 
  SetProp (P_WEIGHT, 335);
  SetProp (P_VALUE, 5000);
  SetProp (P_MATERIAL, ({MAT_METAL}));
  SetProp (P_NOSELL,1);
  SetProp (P_NOBUY,1);
  

}  


