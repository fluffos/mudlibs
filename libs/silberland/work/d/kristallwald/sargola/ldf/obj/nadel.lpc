
inherit "/std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"


create()      
{        if (!is_clone(this_object()))           return;
	::create();

  AddId ( ({"nadel","naehnadel","\nldfnadel"}) );
  SetProp (P_SHORT, "Eine Naehnadel");
  SetProp (P_LONG, "Du siehst eine stahlharte Naehnadel, die schon "
    "ein wenig gebogen ist. Die Spitze ist aber noch sehr spitz.");
  AddDetail("spitze","Die moechtest Du nicht spueren muessen.");
 

  SetProp (P_NAME, "Naehnadel");
  SetProp (P_GENDER, FEMALE); 
  SetProp (P_WEIGHT, 35);
  SetProp (P_VALUE, 40);
  SetProp (P_MATERIAL, ({MAT_METAL}));
  SetProp (P_NOSELL,1);
  SetProp (P_NOBUY,1);
  SetProp (P_NODROP,1);
  

}  


