
inherit "/std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"
#include "../../dorf/obj/ldfquest.h"

int naehe(string str);


create()      
{        if (!is_clone(this_object()))           return;
	::create();

  AddId ( ({"stoff","stoffstueck","\nldfstueck"}) );
  SetProp (P_SHORT, "Ein Stueck Stoff");
  SetProp (P_LONG, "Ein Stueck Stoff aus schwarzer Wolle.");



  
  
  SetProp (P_NAME, "Stoffstueck");
  SetProp (P_GENDER, NEUTER); 
  SetProp (P_WEIGHT, 355);
  SetProp (P_VALUE, 200);
  SetProp (P_MATERIAL, ({MAT_CLOTH}));
  SetProp (P_NOSELL,1);
  SetProp (P_NOBUY,1);
  SetProp (P_NODROP,1);
  
  AddCmd(({"naeh","naehe"}),"naehe");

}  

int naehe(string str)
{
  object ob;
  int val;
  ob = deep_present("\nldfquest",TP);
  if(objectp(ob)) val = ob->frage_wert(WOLLE);
  
  notify_fail("Was moechtest Du naehen?\n");
  if(!str) return 0;
  
  if(str=="stoff ein"||str=="stoff in loch ein"||str=="stoff an mantel"||str=="stoff in loch"
    || str=="stoff in mantel"||str=="stoff in mantel ein"||str=="loch zu"||str=="loch in mantel zu")
  {
    if(val<3)
    {
      tell_object(TP, "Woher hast Du denn den Stoff?\nDer Stoff zerfaellt ploetzlich.");
      return 1;
    }
    if(!present("\nldfnadel",TP) || !present("\nldffaden",TP))
    {
      tell_object(TP, BS("Du hast noch nicht alles zum Naehen dabei."));
      return 1;
    }
    tell_object(TP, BS("Du nimmst fachmaennisch den Stoff und naehst ihn unter "
      "schmerzverzerrtem Gesicht in den Mantel ein. Was tut man nicht alles..."));
    ob->setze_wert(MANTEL,2);
    ob = deep_present("\nldfmantel",TP);
    if(objectp(ob)) ob->setze_loch(0);
    
    ob = deep_present("\nldfnadel",TP);
    if(objectp(ob)) ob->remove();
    ob = deep_present("\nldffaden",TP);
    if(objectp(ob)) ob->remove();
    TO->remove();
    return 1;
  }
  return 0;
}

