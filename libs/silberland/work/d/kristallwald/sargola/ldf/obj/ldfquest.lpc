/*
**************************************************
** 
** Quest-Item von der Land der Ferne Quest
**
**
**************************************************
*/


#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

int zaehler;	//wird pro zentralpunkt in der quest inkrementiert

/*
***************************************************+
** Stationen
**
** 1   beginn der quest (dschinn traegt dich ins ldf)
** 2.  Auftrag vom Koenig: Mantel und Klang finden
**
**
*/

int erhoehe_zaehler(int i);
int frage_zaehler();



create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,  0);
  SetProp(P_NAME, "");
  SetProp(P_GENDER, NEUTER);
  AddId( "\nldfquest" );

  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
}


//Initialisierung der Quest
int startquest(object ob)
{ 
  write_file(LOG "ldfquest.log",
    ctime()+": "+CAP(getuid(ob))+" beginnt die LDF-Quest.\n");
  return 1;
}


init()
{
  ::init();
  if (MENV && !query_once_interactive(MENV)) call_out("remove",0);
}

erhoehe_zaehler(z)
{
  if(getuid(previous_object())!= getuid() )
  {
	write("Du bist nicht berechtigt, das zu tun...\n");
	return 0;
  }
  if(zaehler<z)
	zaehler = z;
}

frage_zaehler()
{
  return zaehler;
}

