
inherit "/std/thing";
#include <properties.h>
#include <language.h>
#include "../def.h"


create()      
{        if (!is_clone(this_object()))           return;
	::create();

  AddId ( ({"schraube","\nldfschraube"}) );
  SetProp (P_SHORT, "Eine Schraube");
  SetProp (P_LONG, "Du siehst eine gewoehnliche, abgenutzte Schraube.");

  
  
  SetProp (P_NAME, "Schraube");
  SetProp (P_GENDER, FEMALE); 
  SetProp (P_WEIGHT, 35);
  SetProp (P_VALUE, 20);
  SetProp (P_MATERIAL, ({MAT_METAL}));
  

}  


