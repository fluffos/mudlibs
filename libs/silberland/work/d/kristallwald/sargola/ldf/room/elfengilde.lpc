/* Gilde der Elfen - Abenteurer-Gilde-Abwandlun
   22.08.98 - sargola@silberland */


#include "../def.h"

inherit "/gilden/abenteurer";

#include <properties.h>
#include <language.h>

Funktion();

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In der Elfengilde" ); 
  SetProp(P_INT_LONG, BS("Du stehst in der Gilde der Elfen und bist "
    "ziemlich ueberrascht. Sie sieht komplett anders aus, als Du es Dir "
    "von draussen erwartet haettest. Das hier ist nicht der uebliche "
    "Talan mit den durchscheinenden Zweigen. Nein, dieser Raum ist "
    "wesentlich geschuetzter, ruhiger und angenehmer. Es prasselt ein "
    "Feuer in einem Kamin, der Boden ist mit Fellen ausgelegt und ein "
    "interessanter Duft steigt Dir in die Nase. Vor dem Kamin sitzt ein "
    "unglaublich alter Elf. Er scheint nachdenklich einen Stein zu be"
    "trachten. Ueber dem Kamin haengt eine Tafel."));
    
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_HOUSE]) );
  
  /* geerbte Details der Abenteurergilde von Midas weg :))*/
  SetProp(P_DETAILS, ([]) );
  RemoveItem("/p/service/obj/zettel/zettelmaschine");
  RemoveExit("westen");

  AddDetail("boden","Der Boden ist komplett anders als im restlichen "
    "Dorf. Wo sonst nur (im angenehmsten Fall) blankes Holz ist, liegen "
    "hier weiche, fast kuschelige Felle herum.");
  AddDetail("holz","Unter den weichen Fellen ist wohl doch wieder "
    "Holz.");
  AddDetail(({"elessar","dorf","elfendorf"}),"Du befindest Dich in Elessar.");
  AddDetail("felle","Du kannst nicht mehr identifizieren welche Tiere "
    "hier ihr Leben lassen mussten. Die Felle sind zu einem grossen "
    "Fell zusammengeknuepft.");
  AddDetail("fell","Es breitet sich ueber den ganzen Boden aus.");
  AddDetail("tiere","Ihre Felle liegen huebsch aneinandergenaeht am Boden.");
  AddDetail("leben","Du siehst hier kein Leben - ob in dem alten Elf "
    "noch welches steckt?");
  AddDetail("fall","Ja, denn das Holz kann durchaus auch holprig sein "
    "... besonders fuer ungeschickte Rassen ein Aergernis...");
  AddDetail("aergernis",
    (["zwerg": "Fuer Zwerge wie Dich ist das sicherlich ein Aergernis!",
    0: "Da koennen nur Zwerge gemeint sein."]) );
  AddDetail("rassen",
      (["zwerg": "Du gruebelst heftigstens nach, kannst Dir aber nicht "
      "denken, welche Rasse das sein koennte.",
      0: "Zwerge fuehlen sich im Allgemeinen in stickigen Hoehlen wohler."]) );
  AddDetail("hoehlen","Die siehst Du hier ganz sicher nicht.");
  AddDetail("zwerge","Du bist hier im Elfendorf - also such nicht nach "
    "Zwergen :)");
  AddDetail("kamin","Unglaublich! Im Zentrum der Gilde waechst der Baum"
    "stamm direkt gen Himmel. Was an sich ja nichts ungewoehnliches "
    "waere ... wenn nicht exakt im Stamm ein kleines Feuer prasseln "
    "wuere...");
  AddDetail("zentrum","Das ist in der Mitte.");
  AddDetail(({"stamm","baumstamm"}), "Mitten durch den Boden ragt ein "
    "Baumstamm gen Himmel - und im Stamm prasselt lustig ein kleines "
    "Feuer...");
  AddDetail("feuer","Eigentlich wuerdest Du panikartige Zustaende er"
    "warten, hektisches Fliehen weil ja gleich der ganze Wald in Flammen "
    "aufgeht ... aber nichts ... das Feuer flackert lustig im Baumstamm "
    "und scheint ihn nicht zu verletzen.");
  AddDetail("wald","Um Dich herum ist ja nur Wald ... ");
  AddDetail("flammen","Sie tanzen aufgeregt hin und her.");
  AddDetail(({"zustaende","panik","flucht","fliehen"}),
    "Nichtsdergleichen kannst Du beobachten. Hier wirkt offenbar die "
    "starke naturmagische Macht der Elfen...");
  AddDetail(({"naturmagie","magie","macht"}),"Die Naturmagie der Elfen "
    "manifestiert sich in dem Wunder des Feuers im Baumstamm.");
  AddDetail("wunder","Es muss wohl eines sein.");
  AddDetail("duft","Riech doch mal ....");
  AddSmell(DEFAULT_SMELL, "Du riechst einen seltsamen, Dich irgendwie "
    "einlullenden Duft der aus dem Feuer zu kommen scheint.");
  AddSmell("feuer","Es scheint ein ganz normales Feuer zu sein ... bis "
    "auf die Tatsache, dass es in einem Baumstamm brennt. Und doch "
    "stroemt ein fremdlich wirkender Geruch vom Feuer.");
  AddSmell("geruch","Hmmm... Du hast Dich wohl getaeuscht.");
  AddDetail("nase","Lass das lieber ... ");
  AddDetail("stein","Er liegt am Boden, ist ziemlich flach und traegt "
    "seltsame, auf Dich sehr fremdartig wirkende Zeichen.");
  AddDetail("zeichen","Du kannst sie nicht erkennen. Aber als Du genauer "
    "hinblickst, bemerkst Du, dass sich die Zeichen veraendern!! Bis "
    "auf einen Bereich in der Mitte.");
  AddDetail("mitte","Ziemlich in der Mitte des Steines ist seine Mitte.");
  AddSpecialDetail("bereich","zeige_reboot");
  AddDetail(({"talane","talan"}),"Die Elfen nennen den hoelzernen Boden "
    "hier Talan.");
  AddDetail("decke","Die Decke besteht aus Zweigen, welche sich "
    "oben zu einer Spitze vereinen.");
  AddDetail("spitze","Ueber Dir wird von Zweigen eine Spitze gebildet.");
  AddDetail(({"zweige","zweigen","zweig"}),"Sie wachsen aus dem "
    "Baumstamm heraus, der im Zentrum des Talans waechst.");
  AddDetail("zentrum","Dort waechst ein Baumstamm gen Himmel.");
  AddDetail("himmel","Den kannst Du nur undeutlich durch die "
    "Zweige erkennen.");



  AddDetail(({"funktionen", "funktion"}), #'Funktion);
  AddReadDetail(({"funktion", "funktionen", "schild","tafel"}), #'Funktion);
  AddDetail( ({"raum", "gilde"}), QueryProp(P_INT_LONG) ); 


  AddDetail( ({"tafel"}),
    "Auf der Tafel sind alle Funktionen der Gilde erklaert. Du solltest sie "
    "lesen.");
  AddDetail( ({"funktionen", "funktion"}),
    "Du kannst ueber sie auf der Tafel nachlesen.");
  AddDetail( ({"elfe", "elfen","elf"}),
    (["elf": "Elfen sind wahrlich stolz und edel.",
      0: "Die Elfen haben sich hier eine nette Gilde eingerichtet."]) );
  AddDetail( ({"durchlass", "sueden"}),
    "Nach Sueden fuehrt ein Durchlass nach draussen.");
  AddSmell( ({DEFAULT_SMELL}),
    "Es riecht nach Baeumen und Blaettern.");
  AddSmell(({"baeume","blaetter","pflanzen"}), "Sie duften frisch nach "
    "Pflanzen.");
  AddSound( ({DEFAULT_SOUND}),
    "Leise rascheln die Blaetter, der kleine, runde Stein am Boden ratter "
    "irgendwie bedrohlich und das Feuer im Baumstamm flackert und prasselt "
    "auch munter vor sich hin.");
  AddSound("blaetter","Die Blaetter rascheln leise und eintoenig.");
  AddSound("stein","Der Stein selbst bewegt sich zwar nicht, aber er "
    "gibt ein unheimliches Rattern von sich.");
  AddSound("rattern","Ob das Magie ist? Wie kann denn ein Stein rattern...");
  AddSound("magie", "So einfach kann man Magie nicht erkennen.");
  AddDetail("magie","So einfach kann man Magie nicht erkennen.");
  AddSound("boden","Nur der Stein am Boden gibt ein Rattern von sich.");
  AddSound("feuer","Eintoeniges, fast fades Prasseln ertoent vom Feuer.");
  AddSound("prasseln","Oder ist es doch ein Knistern?");
  AddSound("knistern","Vielleicht mehr ein Knacken?");
  AddSound("knacken","Nein! Jetzt hast Du es! Es ist ein Rasseln.");
  AddSound("rasseln","Kein Zweifel, das Rasseln kommt vom Feuer! :))");

  AddCmd( ({"kosten", "wandle", "erhoehe", "lern", "lerne"}), "elfengilde");
  
  AddExit( "sueden", "./1_0914" );
  
}

string GuildName() 
{
  return "abenteurer";
}

elfengilde(string str)
{  
  string race;
  if( (race=this_player()->QueryProp(P_RACE))!="Elf") 
    return notify_fail("Das ist die Elfengilde, da hast Du als "+race+
                       " nichts zu suchen.\n"),0;
  switch(query_verb())
  {
    case "kosten": return kosten(str);
    case "wandle": return change(str);
    case "erhoehe": return advance(str);
    case "lern":
    case "lerne": return OwnLearnSpell(str);
  }
}

