inherit "std/room";

#include <properties.h>
#include "../def.h"

       
                             
create()
{
  ::create();

  
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"In Ritter Katos Zimmer");
  SetProp (P_INT_LONG, "Das Zimmer von Ritter Kato ist riesig und "
    "ueberall siehst Du aufgefaltete Landkarten herumliegen. Auf einem "
    "Tisch siehst Du ein imposantes Modell liegen. Das Zimmer liegt "
    "zwar an der Aussenseite der Burg, Ritte Kato hat aber alle Fenster "
    "verschlossen, sodass kaum Licht in das Zimmer kommt.");

AddDetail("boden","Der Boden besteht aus schwarzen, glatten Felsen, "	
  "zwischen denen kleine Zwischenraeume klaffen.");			
AddDetail("felsen","Die Felsen sind ausgesprochen hart und schwarz "	
  "wie alles andere hier auch. Sie sind ungenau gefertigt, sodass "	
  "zwischen ihnen kleine Zwischenraeume klaffen.");			
AddDetail("zwischenraeume","Du meinst die Spalten?");			
AddDetail("spalten","Zwischen den Felsen findest Du ueberall kleine "	
  "Spalten, in denen sich sicher nur Dreck befindet.");			
AddDetail("dreck","Den kannst Du nicht sehen, weil es in den Spalten "	
  "so unglaublich dunkel ist.");					
AddDetail("decke","Im Gegensatz zum Gang vorhin ist die Decke in diesem "
  "Zimmer schlicht und ohne Verzierungen.");
AddDetail("verzierungen","Die siehst Du hier nicht.");
AddDetail(({"wand","waende"}),"Die Waende sind wie die Decke schmucklos "
  "und aus schwarzem Fels.");
AddDetail("zimmer","Das Zimmer von Ritter Kato ist riesig und "
    "ueberall siehst Du aufgefaltete Landkarten herumliegen. Auf einem "
    "Tisch siehst Du ein imposantes Modell liegen. Das Zimmer liegt "
    "zwar an der Aussenseite der Burg, Ritte Kato hat aber alle Fenster "
    "verschlossen, sodass kaum Licht in das Zimmer kommt.");
AddDetail(({"karten","landkarten"}), "Eine Unmenge von Landkarten "
  "sind in dem Zimmer verstreut. Du erkennst das Schloss des "
  "Koenigs, den Rosengarten, die Weide und viele andere Gegenden, "
  "die Du aber nicht gesehen hast.");
AddDetail("unmenge","Eine Unmenge - ja.");
AddDetail("koenig","Der ist wohl nicht hier.");
AddDetail(({"weide","rosengarten","garten","gegenden"}), "Das ist wo ganz wo anders.");
AddDetail("modell","Auf dem Modell siehst Du das ganze Land der Ferne in "
  "aufwendigstem 3D! Wow! Und darauf stehen lustige kleine Figuren.");
AddDetail(({"zinnfiguren","figuren"}), "Du erkennst boese dreinschauende "
  "Spaeher aus Zinn - obwohl sie hier nicht so furchterregend wirken :). "
  "Ausserdem siehst Du den Koenig, den Gaertner und eine extrem gut "
  "aussehende Figur.");
AddDetail(({"spaeher","zinn"}),"Die kleinen Spaeher sind aus Zinn.");
AddDetail("figur","Ja kann denn das sein?? Das kannst nur Du sein!! "
  "Scheinbar kommst Du nicht ganz unerwartet :)");
AddDetail("schloss","Da waerst Du gerne.");
AddDetail(({"land","land der ferne","ferne"}), "Du bist im schiachn "
  "Teil vom Land der Ferne.");
AddDetail("teil","Jo, und es gibt auch noch den schenen.");
AddDetail("3d","Nicht so schnoede, flache Karten.");
AddDetail("gegensatz","So ganz anders halt.");
AddDetail("gang","Der ist draussen. ");
AddDetail("fenster","Die Fenster sind geschlossen.");
  
  //AddItem(NPC+"kato",REFRESH_DESTRUCT);
  AddExit("sueden",ROOM+"bu4");
   
  

}
