inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>

#include "../def.h"

int fange(string str);
int hebe(string str);
int oeffne(string str);


create()
{
  ::create();


  SetProp (P_LIGHT,0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));

  SetProp(P_INT_SHORT, "In einer chaotischen Burgkueche");
  SetProp(P_INT_LONG, "Um Dich herum herrscht reines Chaos. Wildgewordene Huehner "
    "gackern laut um ihr Leben, ein hektischer Koch rennt mit ins Gesicht gerutschter "
    "Muetze hinter ihnen her. An einem riesigen Herd stehen allerlei Toepfe herum aus "
    "denen es wild brodelt. Maechtige Fleischstuecke haengen von der Decke. In einer "
    "Ecke steht ein Korb mit Gemuese.");


  AddDetail("chaos","Du brauchst Dich nur umzusehen - es ist ueberall.");
  AddDetail("leben","Die Huehner gackern und laufen um ihr Leben - vielleicht endet "
    "ja in einer guten Suppe!");
  AddDetail(({"huehnersuppe","suppe"}),"In den vielen Toepfen, aus denen es "	
    "dampft, ist sicher eine.");
  AddDetail(({"topf","toepfe","unzahl"}), "Die meisten sind leer und auf einem dampfenden "
    "Topf liegt ein Deckel.");
  AddDetail("wasser","Es laeuft Dir im Mund zusammen.");
  AddDetail("deckel","Er liegt unruhig auf einem Topf und hebt und senkt sich mit "
    "dem Dampf.");
  AddDetail("dampf","Aus einem Topf dampft es wild heraus. Vielleicht ist da ja "
    "eine Suppe drin!");
  AddDetail("herd","Auf dem Herd steht eine Unzahl von Toepfen aus denen es wild "
    "brodelt. Aber der Koch scheint sich ja um anderes zu kuemmern! Daher "
    "kommt wohl auch der verbrannte Geruch.");
  AddDetail(({"fleischstuecke", "stuecke", "fleischstueck", "stueck", "fleisch"}),
    "Von der Decke haengen grosse Fleischstuecke vom Rind und auch Schweinshaelften.");    
  AddDetail(({"rind", "schwein", "schweinshaelfte", "schweinshaelften"}), "Von "
    "solchen Vorraeten traeumen Fleischhacker. Aus Ritter Katos Reich koennen sie "
    "jedenfalls nicht stammen.");  
  AddDetail(({"vorraete", "vorrat"}), "Dieser Vorrat wurde sicher vom Viehbestand "
    "vom Land der Ferne gestohlen.");  
  AddDetail(({"viehbestand", "vieh", "reich", "land der ferne", "land", "ferne"}),
    "Da Du im Reich von Ritter Kato keinerlei Vieh gesehen hast, ziehst Du den "
    "Schluss, dass saemtliches Fleisch hier aus dem Land der Ferne gestohlen wurde.");
  AddDetail(({"fleischhacker", "metzger"}), "Fleischhacker werden mitunter auch als "
    "Metzger bezeichnet.");   
  AddDetail("ecke", "In einer Ecke siehst Du einen grossen Korb voller Gemuese.");
  AddDetail("korb", "Der Korb sieht schon aelter und abgenutzt aus. Offensichtlich "
    "wird er schon lange benutzt."); 
  AddDetail("gemuese", "Im Korb befinden sich Kartoffeln, Zwiebeln, Karotten und noch "
    "mehr Gruenzeug.");
  AddDetail(({"kartoffeln", "zwiebeln", "karotten", "gruenzeug"}), "Das Gruenzeug "
    "verarbeitet der Koch zum Beispiel in der Suppe.");
  AddDetail("beispiel", "In der Suppe schwimmt zum Beispiel viel von diesem Gruenzeug "
    "- am Schweinebraten kannst Du nur ein paar Zwiebelringe erkennen.");
  AddDetail(({"schweinebraten", "zwiebelringe", "ringe", "rezepte", "kochrezepte"}),
    "Wenn Du Dich fuer Kochrezepte interessierst, plauder doch mit dem Koch darueber. "
    "Aber bitte erst spaeter - besieg erst mal Ritter Kato!");
  AddDetail(({"ritter", "ritter kato", "kato"}), "Auch der boese Ritter Kato "
    "scheint ordentliches Essen zu schaetzen.");
  AddDetail(({"speisen","essen"}), "Es gibt hier reichlich davon, schau Dich nur um!");
  AddDetail("boden", "Der Boden ist wie ueberall in der Burg aus schwarzen Fels, "
    "vereinzelt siehst Du auch Blutspritzer.");
  AddDetail("burg", "Du befindest Dich immer noch in Ritter Katos Burg. "
     "Den Koch scheint Deine Anwesenheit nicht zu stoeren, aber nimm Dich "
     "in acht vor den Spaehern!");
  AddDetail("anwesenheit", "Aja, Du bist ja immer noch hier? Bist Du noch "
     "immer nicht fort?");
  AddDetail("fels", "Der Fels ist schwarz wie die Nacht und bitterkalt.");
  AddDetail(({"nacht", "tag"}),"Ob es Tag oder Nacht ist, kann man hier nur "
      "schwer erkennen.");
  AddDetail(({"blutspritzer","blut", "spritzer"}),"Der Koch ist wohl "
      "auch schon erfolgreich gewesen. Brauchst Du noch weitere Hinweise?");
  AddDetail("hinweise", "Nein, nein, das waere zu unappetitlich ];)");
  AddDetail(({"waende", "wand"}), "Die Waende sind kalt und schwarz");
  AddDetail("decke", "Die Decke besteht aus schwarzem Fels, von ihr "
      "haengen riesige, saftige Fleischstuecke herunter.");
  AddDetail("mund","Er ist schon ganz waessrig.");
  AddDetail("nase","Du meinst deine grosse?");
  AddDetail(({"ohren","ohr"}),"Du wackelst mit den Ohren.");      
  AddDetail("schluss","Noch ist die Quest nicht zu ende.");
  AddDetail("quest","Du bist mittendrin.");  
      
                 
  AddSmell(DEFAULT_SMELL, "Es riecht nach Suppe, Schweinsbraten, aber irgendwo ist "
    "dem Koch auch etwas angebrannt.");
  AddSmell("suppe","Sie duftet herrlich nach Gemuese und Huehnern...");
  AddSmell("gemuese","Gekocht in der Suppe schmeckt das sicherlich koestlich.");
  AddSmell("huehner","Hmm... nicht alle Huehner scheinen noch so quicklebendig "
    "wie die hier herumzurennen....");
  AddSmell(({"schweinsbraten", "braten"}),"Der Braten riecht so koestlich wuerzig, "
    "dass Dir das Wasser im Mund zusammenlaeuft.");   
  AddSmell("geruch","Neben dem appetitlichen Geruch der Speisen dringt auch ein "
    "leicht angebrannter Geruch an Deine Nase - der Koch scheint sich zu sehr auf "
    "die Hennen zu konzentrieren.");

  AddSound(DEFAULT_SOUND, "Du hoerst das entsetzte Gackern der Huehner, das Fluchen "
    "des Koches, brodelnde Kochtoepfe und von draussen die Schritte der Spaeher.");
  AddSound(({"gackern", "huehner"}), "Die Huehner fluechten aufgeregt vor dem Koch "
    "und Gackern dabei aufgeregt als ginge es um ihr Leben.");
  AddSound(({"fluchen", "koch"}), "Du verstehst nicht viel von den Fluechen des Koches. "
    "Nur \"Merde!\" kannst Du raushoeren.");
  AddSound(({"brodeln", "blubb", "kochtoepfe", "toepfe"}), "Blubb, blubb, "
    "blubb, blubb, blubb, blubb, blubb... ");
  AddSound(({"schritte", "spaeher", "gang"}), "Du hoerst wie draussen am Gang die "
    "Spaeher eifrig nach Dir suchen. Lass Dich bloss nicht erwischen!");

  AddRoomMessage(({
    "Der Koch hechtet mutig hinter einem Huhn hinterher.\n",
    "Schrilles Gackern dringt an Dein Ohr.\n",
    "Der Koch flucht: \"Merde!\".\n",
    "Der Koch schwingt sein blutiges Beil.\n",
    "Einer der Toepfe brennt gerade an.\n",
    "Der Koch murmelt was von: \"Smoerebroed...\".\n",
    "Du riechst den Geruch von schmackhafter Huehnersuppe.\n"}),3);

  AddCmd(({"fange","fang"}), "fange");
  AddCmd(({"hebe","heb"}),"hebe");
  AddCmd(({"oeffne"}), "oeffne");
  
  AddExit("sueden",ROOM+"bu3");
}
int oeffne(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");
  if(!str || str!="topf") return 0;
  
  tell_object(TP, "Dazu musst Du den Deckel heben.\n");
  return 1;
}

int hebe(string str)
{
  notify_fail("Was moechtest Du heben?\n");
  if(!str || str!="deckel") return 0;
  
  tell_object(TP, BS("Du hebst vorsichtig den Deckel an und laesst ihn gleich wieder "
    "mit schmerzverzerrtem Gesicht fallen!"));
  TP->reduce_hit_points(10);
  tell_room(TO, BS(TPN+" hebt den Deckel eines Topfes und verbrennt sich dabei!"),({TP}));
  return 1;
}
int fange(string str)
{
  notify_fail("Was moechtest Du fangen?\n");
  if(!str || (str!="huhn" && str!="huehner")) return 0;
  
  tell_object(TP, BS("Du hechelst eine zeitlang wie der Koch "
    "den Huehnern her, hast aber keine Chance - sie sind "
    "einfach viel zu erfahren im Wegrennen."));
  tell_room(TO, BS(TPN+"hechelt den Huehnern hinterher, doch sind "
    "sie viel zu schnell."),({TP}));
  return 1;
}
