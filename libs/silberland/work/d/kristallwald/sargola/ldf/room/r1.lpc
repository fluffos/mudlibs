inherit "std/room";

#include <properties.h>
#include "../def.h"

        
int gerichtet;        
int schraube;
                             
void norden();                             
void schild();
                             
create()
{
  ::create();
  
  gerichtet = 0;
  schraube = 1;
  
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"Im koeniglichen Rosengarten");
  SetProp (P_INT_LONG, "Du stehst im koeniglichen Rosengarten und bist "
    "einfach ueberwaeltigt von der Schoenheit und vom Duft der Rosen. "
    "Im Norden kannst Du das Schloss erkennen. Es liegt majestaetisch "
    "zwischen alten Baeumen auf einem Huegel. Zwischen Dir und "
    "dem Schloss ist allerdings ein Tor. Wege mit weissen Kieselsteinen "
    "fuehren durch den Garten.");

AddDetail("rosen","Egal wohin Du blickst - Du siehst nur herrliche "	
  "Rosen. Vor allem rote und weisse Rosen beherrschen das Bild. "	
  "Zwischen ihnen wachsen weisse Lilien. Du bist umhuellt von ihrem "
  "herrlichen, blumigen Duft. Ausser den wunderschoenen Blueten "	
  "haben Rosen aber auch Dornen...");					
AddDetail("blueten","Fast alle sind schon aufgeblueht und verbreiten "	
  "einen herrlichen Duft. Egal wo Du hinsiehst, rote und weisse "	
  "Blueten wachsen hier, um den Besucher zu erfreuen.");		
AddDetail("blaetter","Sie wiegen sich sanft im Wind.");
AddDetail("besucher","Das musst wohl Du sein. :)");			
AddDetail("dornen","Die Rosen versinnbildlicht wie kaum eine andere" 
  "Blume Schoenheit und Gefahr. Die Dornen erinnern Dich daran, "	
  "dass Rosen nicht nur einfach schoen sind.");				
AddDetail("schoenheit","Du musst wohl blind sein, wenn Du sie nicht "	
  "erkennst.");								
AddDetail("gefahr","Komisch ... die Rose symbolisiert Gefahr. Hier "	
  "ist es doch so paradiesisch schoen ... Oder doch nicht?");		
AddDetail("paradies","Du denkst . o 0 (Das ist hier)");			
AddDetail("duft","Eigentlich kannst Du den nicht erkennen.");		
AddDetail("bild","Es ist ziemlich romantisch.");			
AddDetail( ({"land","ferne","land der ferne"}), "Dort, wo Du gerade bist.");
AddDetail("lilien","Zwischen den Rosen bluehen weisse Lilien.");



  AddDetail("duft","Schnupper mal...");
  AddDetail(({"garten","rosengarten"}), "Du befindest Dich genau in ihm.");
  
  AddDetail("boden","Der Boden ist mit weissen Kieselsteinen komplett "
    "bedeckt, welche leise knirschen, wenn Du Schritte machst.");
  AddDetail("schritte","Die sieht man gluecklicherweise nicht.");
  AddSound("schritte","Leise knirscht es unter Deinen Fuessen.");
  AddDetail("fuesse","Nein, das lass mal lieber.");                            
  AddDetail("himmel","Ueber Dir leuchtet die Sonne und strahlt warm "
    "auf die Erde. Nur einige kleine Woelkchen wandern sanft vom "
    "Wind getrieben nach Westen.");
  AddDetail("wind","Den kannst Du nur an den vom Wind getriebenen "
    "Woelkchen erkennen.");
  AddDetail("erde","Zwischen den Rosen siehst Du dunkle, gut gegossene "
    "Erde.");
  AddDetail("woelkchen","Kleine, rundliche, weisse Woelkchen.");
  AddDetail(({"praiosscheibe","scheibe","sonne"}),"In anderen Welten "
    "nennt man sie auch die Praios-Scheibe.");
  AddDetail("welten", "Welche kann das denn sein? *grins*");
  AddDetail( ({"kieselsteine","steine"}), "Die Steine sind klein und weisslich.");



  AddDetail("schloss","Du kannst Dir das Schloss mit seinen Tuermen, "
    "Fenstern und Nischen leider nur aus der Ferne ansehen, da das Tor "
    "verschlossen ist.");
  AddDetail(({"tuerme","nischen","fenster"}), "Die kannst Du kaum erkennen.");
  AddDetail("torschloss","Du bist ja wirklich hartnaeckig...");
  AddDetail(({"eisentor","tor"}),"Es ist ein maechtiges Eisentor mit starken Staeben, "
    "die durch viele Schnoerkel verziert sind. Du kannst kein Torschloss "
    "oder sonst etwas aehnliches erkennen. Scheinbar gibt es hier "
    "keinen Durchgang. Daneben haengt ein Schild.");
  AddDetail("schnoerkel","Windungen und andere Stilelemente welche das "	
    "Tor verschoenern.");
  AddDetail( ({"stilelemente","elemente"}), "Gewundete Eisenstaebe, "
    "plattgeschmiedete .... Nunja, genau kennst Du Dich damit ohnehin "
    "nicht aus.");
  AddDetail("windungen","Sie schlaengeln sich um die Staebe und den "	
    "Rahmen des Tores.");
  AddDetail(({"eisenstaebe","staebe"}),"Das sind die stabilsten "
    "Eisenstaebe, die Du jemals gesehen hast.");
  AddDetail("rahmen","Er ist selbst aus wuchtigen Eisenstaeben und be"
    "schreibt oben einen Spitzbogen.");
  AddDetail("spitzbogen","So einer mit einer Spitze oben drauf.");
  AddDetail("spitze","Hoppla! Was haengt denn dort? Etwa ein Schild?");
  AddDetail("schild","Lies es doch!");
  AddDetail("kuppel","Auf ihm befindet sich in majestaetischer "
    "Schoenheit das Schloss.");



  AddReadDetail("schild",#'schild);
  AddDetail("durchgang","Wenn das Tor offen waere .. dann vielleicht :)");
  AddDetail("baeume","Die alten Silberpappeln saeumen die Allee zum "
    "Schloss.");
  AddDetail( ({"pappeln","silberpappeln","pappel","silberpappel"}),
    "Schlanke, unendlich hohe Pappeln mit silbernen Blaettern glaenzen "
    "im Sonnenlicht und verursachen ein unwirkliches Klingen.");
  AddDetail(({"sonnenlicht","licht"}), "Es stroemt langsam auf den "
    "Rosengarten herab.");	
  
  AddDetail("huegel","Auf der Kuppel des Huegels befindet sich das "
    "Schloss.");
  AddDetail("klingen","Das kann man nur hoeren.");
  
  AddDetail(({"messingschraube","schraube"}),"Hmm... die wird wohl runtergefallen sein ...");
  AddDetail("email","Sowas aehnliches wie Post ... oder doch nicht?");
  AddDetail("post","Sowas aehnliches wie Email ... oder verwechselst "
    "Du da jetzt was?");
  						
AddSound(DEFAULT_SOUND, "Im Rosengarten herrscht wundersame Musik, "	
  "so als ob tausend Glocken aus Glas auf einmal ertoenten. "
  "Ueberall zwitschern viele Voegel.");		
AddSound(({"klingen","glocken","musik"}),"Die Blaetter der "		
  "Silberpappeln wiegen sich sanft im Wind und klingen wie viele "	
  "Glocken aus Glas.");							
AddSound("voegel","Von allen Seiten hoerst Du froehliche Voegel "	
  "lustige Lieder zwitschern. Und doch dringt eine traurige Melodie "	
  "an Dein Ohr.");							
AddSound("lieder","Sie machen Dein Herz froh.");			
AddSound("herz","Buummm... Buummm..."); 				
AddSound(({"lied","melodie"}),"Sie kommt von der hoechsten Silberpappel. Auf "	
  "ihr sitzt ein schwarzer Vogel der schon von Weitem zu erkennen "	
  "ist. Er singt ein tieftrauriges Lied. Eigentlich komisch in "	
  "der schoenen Gegend hier.");						
AddSound("vogel","Sein Gesang ist so ganz anders als der der anderen "	
  "Voegel. Er zwitschert ein unwirklich trauriges Lied, das Dich "	
  "betruebt.");								
AddSmell(DEFAULT_SMELL,"Der Duft der Rosen verzaubert Dich voellig.");	
AddSmell("duft","Der Duft der Rosen.");					
AddSmell("rosen","Es ist der feine Duft von bluehenden Rosen, der "	
  "Dich so verzaubert.");						
AddSmell("lilien","Sie verbreiten einen blumigen Duft, der Dich fast "	
  "Deiner Sinne beraubt.");

  AddItem(NPC+"koenig",REFRESH_DESTRUCT);

  AddCmd(({"such","suche"}),"suche");
  AddCmd(({"schraub","schraube"}),"schraube");
  
  AddExit("suedwesten",ROOM+"r2.lpc");
  AddExit("suedosten",ROOM+"r4.lpc");
  AddExit("sueden",ROOM+"r3.lpc");
  AddSpecialExit("norden","norden");
  
}

int schraube(string str)
{  object sz, s;
  s = present("\nldfschraube", TP);
  sz = present("\nldfschraubenzieher", TP);
  
  notify_fail("Was moechtest Du anschrauben?\n");
  if(!str) return 0;
  
  if(str=="schild an" || str=="schild")
  {
     if(objectp(s) && (objectp(sz)) )
     {
        tell_object(TP, BS("Du beginnst in Deinem kindlichen Eifer "
          "das Schild genau so an die Wand zu schrauben, wie es dahaengt ... komplett schief. "
          "Da kommt der Rosengaertner mit vor Aerger rotem Gesicht angeschossen "
          "und flucht \"Was treibst Du da? Eine besonders grosse Hilfe bist Du mir "
          "aber nicht ... das muss doch gerade sein!\"\nDer Rosengaertner geht "
          "kopfschuettelnd weiter."));
        tell_room(TO, BS(TPN+" schraubt das Schild  komplett schief an."), ({TP}) );
          WLOG("/d/kristallwald/sargola/log/schild","schraubt das Schild schief an");

        return 1;
     }
     else
     {
       tell_object(TP, BS("Du hast nicht das noetige Werkzeug dabei.\n"));
        tell_room(TO, BS(TPN+" versucht das Schild zu reparieren, hat aber kein Werkzeug.\n"), ({TP}));
        return 1;
     }
   }
   else
   {
      if(str=="schild gerade an" || str=="schild gerade")
      {
         tell_object(TP, BS("Du gibst Dir alle Muehe, das Schild einigermassen "
         "waagrecht an das Tor zu schrauben und es gelingt Dir auch!\nDer Rosen"
         "gaertner nickt Dir dankbar aus der Ferne zu.\n"));
        tell_room(TO, BS(TPN+" schraubt das Schild  wieder an das Tor."), ({TP}));         
         if(objectp(s)) s->remove();
         gerichtet = 1;
         WLOG("/d/kristallwald/sargola/log/gerade","schraubt das Schild gerade an");
         return 1;
      }
   }
   return 0;
}

int suche(string str)
{
  object ob;
  int ret;
  
  notify_fail("Was moechtest Du suchen?\n");
  if(!str) return 0;
  
  if(str!="schraube") return 0;

     if(!gerichtet && schraube)
     {
          tell_object(TP, BS("Tatsaechlich findest Du am Boden die fehlende "
            "Schraube und hebst sie auf. Eventuell koenntest Du ja nun "
            "das Schild wieder gerade anschrauben."));
          tell_room(TO, TPN+" sucht und findet etwas am Boden.", ({TP}));          
          schraube = 0;
          ob = clone_object(OBJ+"schraube");
          ret = ob->move(TP);
          if(ret==ME_TOO_HEAVY)
          {  tell_object(TP, "Die Schraube ist Dir zu schwer.");
             ob->move(environment(TP));
          }
        return 1;
     }
     else
     {
        tell_object(TP, BS("Du kannst auch nach langem Suchen keine Schraube "
          "entdecken."));
        tell_room(TO, TPN+" sucht vergeblich etwas am Boden.", ({TP}));          
        return 1;
     }
}



int norden()
{
  tell_object(TP, BS("Du kannst nicht nach Norden gehen. Das Tor ist und bleibt "
    "geschlossen.\n")); return 1;
}

string schild()
{
  if(gerichtet)
  {
    return BS("Ein herrliches Schild aus Email auf welchem sich das Wappen "
      "vom Land der Ferne befindet.");
  }
  else
  {
    return BS("Ein herrliches Schild aus Email auf welchem sich das Wappen "
      "vom Land der Ferne befindet. Doch scheint es irgendwie schief zu "
      "haengen. Bei genauer Betrachtung faellt Dir auf, dass die linke "
      "Schraube fehlt.");
  }
}
