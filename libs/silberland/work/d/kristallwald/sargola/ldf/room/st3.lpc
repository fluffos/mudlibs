inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "stollen.h"

string oeffnung();
int oeffnung_zu();
int springe (string str);
                             
create()
{
  ::create();


  SetProp (P_LIGHT,0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"In einem finsteren Stollen");
  SetProp (P_INT_LONG, "Du stehst in grossen Saal dessen "
    "Decke so hoch ist wie ein Kirchenschiff. Im Norden endet der "
    "Stollen. Ein Licht scheint, aber Du kannst nicht lokalisieren, "
    "aus welcher Richtung. In der Mitte faellt Dir eine Erhebung auf.");
    
  STANDARD  
  
  AddDetail("mitte","In der Mitte des Saales ist eine Erhebung.");  
  AddDetail(({"schiff","kirchenschiff"}),"Einfach riesig...");
  AddDetail("saal","Du kannst die genauen Masse nicht exakt be"
    "messen, aber er wirkt recht gross auf Dich.");
  AddDetail("masse","Sie die nun so wichtig?");
  AddDetail("licht","Es schimmert schwach und erhellt den Saal ein "
    "wenig. Aber du kannst nicht erkennen, woher es kommt.");
  AddDetail("richtung","Es schimmert einfach ueberall ohne eine "
    "Richtung zu haben.");
  AddDetail(({"platte","steinplatte","erhebung"}),
    "Es ist eine Steinplatte die in etwa einen "
    "Meter Durchmesser hat. Sie ist leicht erhaben. Ob man da wohl "
    "draufsteigen kann und was dann passiert?");
  AddDetail(({"meter","Durchmesser"}),"Der Durchmesser ist circa einen "
    "Meter.");
  AddDetail("oeffnung",#'oeffnung);
  
  AddCmd(({"steig","steige"}),"steige");
  AddCmd(({"spring","springe","huepf","huepfe"}),"springe");
  AddExit("sueden",ROOM+"st2");



}

int steige(string str)
{
  notify_fail("Worauf moechtest Du steigen?\n");
  if(!str || (str!="auf platte" && str!="auf steinplatte")) return 0;
  
  tell_object(TP, BS("Du steigst vorsichtig auf die Steinplatte und ueber "
    "Dir entsteht eine Oeffnung! Vielleicht kann man da irgendwie rauf."));
  if(find_call_out("oeffnung")==-1)
    call_out("oeffnung_zu",10);
  return 1;
}

string oeffnung()
{
  if(find_call_out("oeffnung_zu")==-1)
    return BS("Sowas siehst Du da nicht.");
  return BS("Ueber Dir ist eine Oeffnung zu sehen. Vielleicht kann man "
    "da irgendwie rauf.");
}

int oeffnung_zu()
{ object ob;
  ob = find_object(ROOM+"st4");
  tell_room(TO, BS("Die Oeffnung schliesst sich wieder. Vorsichtshalber "
    "springst Du zur Seite und auch von der Steinplatte runter."));
  if(objectp(ob))
    tell_room(ob, BS("Die Oeffnung im Boden schliesst "
    "sich wieder."));
}

int springe(string str)
{
  notify_fail("Wohin moechtest Du springen?\n");
  if(!str || (str!="nach oben" && str!="durch oeffnung" && str!="rauf" && str!="hinauf")) return 0;
  
  if(find_call_out("oeffnung_zu")==-1)
  {
    tell_object(TP, BS("Du siehst dort oben keine Oeffnung!"));
    return 1;
  }
  
  tell_object(TP, BS("Du springst beherzt nach oben, haeltst Dich elegant "
    "fest und ziehst Dich nach oben."));
  TP->move(ROOM+"st4",M_GO,"nach oben","huepft","zieht sich von unten herein");
  return 1;
}
    
