inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "weide.h"
#include "../../dorf/obj/ldfquest.h"

int wasch(string str);       
                             
create()
{
  ::create();

  
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"Auf einer gruenen Weide");
  SetProp (P_INT_LONG, "Du stehst mitten in einer Weide mit grasen"
    "den Schafen und Kuehen. Ein wenig gegangener Weg schlaengelt "
    "sich zwischen den sanften Huegeln durch und fuehrt weiter in "
    "die Weide. Neben Dir fliesst ein kleines Baechlein.");

  STANDARD
  STANDARD1

  AddDetail("baechlein","Nun, mehr ist es wirklich nicht. Aber es "
    "reicht, um sich die Haende zu waschen.");  

  AddExit("norden",ROOM+"w8");
  AddExit("suedosten",ROOM+"w6");
  AddItem(NPC+"nonno", REFRESH_DESTRUCT);
  AddCmd(({"wasch","wasche"}), "wasch");

}

int wasch(string str)
{
  object ob;
  ob = deep_present("\nldfwolle",TP);
  
  notify_fail("Was willst Du waschen?\n");
  if(!str) return 0;
    if(str=="haende")
  {
    tell_object(TP, BS("Du waeschst Dir die Haende."));
    return 1;
  }
  
  if(!objectp(ob)) return 0;
  if(ob->frage_schmutzig()==0)
  {
    tell_object(TP, "Die Wolle ist schon sauber.\n");
    return 1;
  }
  

  if(str=="wolle"||str=="schafwolle")
  {
    tell_object(TP, BS("Du tauchst die dreckige Wolle tief in den Bach ein "
     "(soweit das moeglich ist) und waescht sie gruendlich."));
    ob->setze_schmutzig(0);
    ob = deep_present("\nldfquest",TP);
    if(objectp(ob)) ob->setze_wert(WOLLE,2);
    return 1;
  }
}
