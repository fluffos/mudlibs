inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "weide.h"

int tritt(string str);       
int kletter(string str);
string frei();
void set_door(int a);

int weg_frei;

                             
create()
{
  ::create();


  weg_frei = 0;
  
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"Auf einer gruenen Weide");
  SetProp (P_INT_LONG, "Du stehst inmitten einer Weide mit Schafen "
    "und Kuehen, die genuesslich grasen. Ein kaum benutzer Weg "
    "schlaengelt sich zwischen den sanften Huegeln hindurch und "
    "fuehrt weiter in die Weide. Im Norden kannst Du einen Zaun "
    "aus starken Holzbalken erkennen.");

  STANDARD
  STANDARD1
  
  AddDetail("zaun","Dicke Holzbalken bilden im Norden einen recht "
    "hohen Zaun. Wozu der dient, ist Dir nicht ganz klar. "
    "Auf jeden Fall trennt er die Weide in zwei Teile. Der Weg "
    "fuehrt auf jeden Fall auch hinter dem Zaun weiter.");
  AddDetail(({"holzbalken","balken"}),"Die sind aus Holz.");
  AddDetail("holz","Es ist von der Witterung schon ziemlich mit"
    "genommen, aber immernoch stark genug, um als Zaun durchzugehen.");
  AddDetail("witterung","Die Spuren der Witterung sind am manchmal "
    "etwas morschen Holz gut zu erkennen.");
  AddSpecialDetail("spuren","frei");
  AddDetail("fall","Ja genau, in jedem Fall.");
  AddDetail("teile","In den diesseitigen und den jenseitigen Teil.");
  AddExit("suedosten",ROOM+"w2.lpc");
  AddItem(NPC+"kuh", REFRESH_DESTRUCT);
 
  AddCmd(({"tritt","trete","zertrete","zertritt","brich","zerbrich","breche","zerbreche"}),"tritt");
  AddCmd(({"kletter","kletter","klettere"}), "kletter");
}

string frei()
{
    return (weg_frei?BS("Der obere Balken ist, vermutlich weil er "
    "schon so morsch war, gebrochen und gibt den Weg nach Norden frei."):BS("Be"
    "sonders einer der oberen Balken ist wesentlich bruechiger als die anderen."));
}



int kletter(string str)
{
  notify_fail("Zum Drueberklettern ist der Zaun ist zu morsch - Du wuerdest "
    "nur durchbrechen und hinfallen. Vielleicht geht das anders.\n");
  return 0;
}

int tritt(string str)
{
  notify_fail("Was moechtest Du treten?\n");
  if(!str) return 0;
  
  
  if(str=="zaun"||str=="balken"||str=="holzbalken"||str=="holz"||str=="holzzaun")
  { 
    if(weg_frei)
    {
      tell_object(TP, BS("Sinnlose Gewaltanwendung bringt doch nichts - der Weg "
        "ist ja schon frei."));
      return 1;
    }
    else
    {
      weg_frei = 1;
      tell_object(TP, BS("Du trittst mit voller Wucht gegen den Zaun und erwart"
        "ungsgemaess gibt er Dir den Weg nach Norden frei."));
      tell_room(TO, BS(TPN+" tritt mit voller Wucht gegen den Zaun und schafft "
        "damit einen Weg nach Norden."), ({TP}) );
      AddExit("norden",ROOM+"w4");
      (ROOM+"w4")->set_door(1);
      (ROOM+"w4")->AddExit("sueden", ROOM+"w3");
      return 1;
    }
  }
  return 0;
}

void reset()
{
  ::reset();
  weg_frei = 0;
  RemoveExit("norden");
  (ROOM+"w4")->set_door(0);
  (ROOM+"w4")->RemoveExit("sueden");
}

void set_door(int a)
{
  weg_frei = a;
}
