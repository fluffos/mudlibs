inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "stollen.h"


                             
create()
{
  ::create();


  SetProp (P_LIGHT,0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"In einem finsteren Stollen");
  SetProp (P_INT_LONG, "Du stehst in einem schmalen Stollen, der weiter "
    "nach Norden fuehrt. Doch je weiter er fuehrt, desto weiter oeffnet "
    "er sich und wird breiter. Das diffuse Licht im ganzen Inneren ist nun "
    "viel deutlicher und scheint von Norden zu kommen. Es scheint eine "
    "Art Flackern zu sein. ");
    
  STANDARD  
  
  AddDetail("art","Es wirkt so, als ob das Licht flackern wuerde.");
  AddDetail("flackern","Vielleicht ist es ja ein Feuer?");
  AddDetail("feuer","Um das genau zu sehen, musst Du nach Norden "
    "gehen.");
  
  AddDetail("licht","Es kommt eindeutig von Norden und scheint ein Feuer "
    "zu sein.");


  AddExit("norden",ROOM+"hschmied");

}


    
