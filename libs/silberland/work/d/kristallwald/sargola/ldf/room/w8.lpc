inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "weide.h"

       
                             
create()
{
  ::create();

  
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"Auf einer gruenen Weide");
  SetProp (P_INT_LONG, "Du stehst mitten in einer Weide mit grasen"
    "den Schafen und Kuehen. Ein wenig gegangener Weg schlaengelt "
    "sich zwischen den sanften Huegeln durch und fuehrt weiter in "
    "die Weide. Im Norden kannst Du eine riesige Schlucht erkennen "
    "und ueber sie fuehrt die Bruecke des Morgengrauens. "
    "Weiter im Osten befindet sich ein kleines Haus direkt an der "
    "Schlucht.");

  STANDARD
  STANDARD1
  
  AddDetail("schlucht","Du beugst Dich lieber nicht weiter nach "
    "vorn. Es geht so weit in die Tiefe, so weit kannst Du gar "
    "nicht nach unten schaun.");
  AddDetail("tiefe","Du kannst keinen Grund erkennen.");
  AddDetail("grund","Er liegt zu tief unten ... wenn es ueberhaupt "
    "einen gibt.");
  AddDetail(({"bruecke","bruecke des morgengrauens"}), 
    "Sie ueberbrueckt einst die maechtige Schlucht - doch jetzt ist "
    "sie in der Mitte unterbrochen. Zum Schutz gegen Ritter Kato. "
    "Wie man da wohl rueberkommen koennte?");
  AddDetail(({"ritter","kato"}),"Den siehst Du nicht auf der anderen "
    "Seite stehen und auf Dich warten... Sei froh!");
  AddDetail("mitte","So in etwa in der Mitte halt.");
  AddDetail("schutz","Schutz vor Ritter Kato.");
  AddDetail("haus","Im Osten kannst Du ein Haus erblicken, das "
    "aehnlich gebaut ist wie das weiter im Sueden. Es hat ein Stroh"
    "dach und einladend die Tuere offen.");
  AddDetail("tuere","Sie wirkt einladend.");

  
  AddItem(NPC+"miramis",REFRESH_DESTRUCT);
  AddExit("osten",ROOM+"hweberin");
  AddExit("sueden",ROOM+"w7");
   
  

}
