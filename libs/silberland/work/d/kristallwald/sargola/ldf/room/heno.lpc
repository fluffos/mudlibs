inherit "std/room";

#include <properties.h>
#include "../def.h"

                             
create()
{
  ::create();

  
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"In einer Holzhuette");
  SetProp (P_INT_LONG, "Du stehst in einer kleinen, baufaelligen "
    "Holzhuette die gegen den Berg im Norden gelehnt ist. Sehr "
    "sicher fuehlst Du Dich hier nicht. Ein Stuhl, Tisch und auf "
    "ihm eine kleine Lampe findest Du hier. Auf dem Stuhl sitzt "
    "ein alter, gebeugter Mann.");
    
  AddDetail("berg","Den kannst Du besser von draussen sehen.");
  AddDetail("stuhl","Ein simpler Stuhl aus Holz.");
  AddDetail("holz","Der Tisch und der Stuhl sind aus gewoehnlichem "
    "Holz.");
  AddDetail("tisch","In der Mitte der Huette steht ein Tisch auf "
    "dem eine kleine Lampe steht, die die Huette in ein etwas "
    "freundlichered Licht taucht.");
  AddDetail("licht","Es geht von der Lampe aus.");
  AddDetail("lampe","Sie steht auf dem Tisch und erhellt die Huette "
    "ein wenig.");
  AddDetail(({"holzhuette","huette"}),TO->QueryProp(P_INT_LONG));
  AddDetail("mitte","Dort befindet sich ein Tisch.");
  AddDetail("boden","Der Boden ist auch mit Brettern ausgelegt.");
  AddDetail("bretter","Einfache, etwas schief geschnittene Bretter.");
  AddDetail(({"wand","waende","decke"}),"Die untersuchst Du lieber "
    "nicht genauer, wer weiss, ob das ganze nicht einstuerzt...");
  



  AddExit("westen",ROOM+"b4");
  
  AddItem(NPC+"eno", REFRESH_DESTRUCT);
}
