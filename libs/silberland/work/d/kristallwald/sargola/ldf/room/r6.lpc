inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "roseng.h"



create()
{
  ::create();
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_LONG, "");
  SetProp (P_INT_SHORT,"Im koeniglichen Rosengarten");
  SetProp (P_INT_LONG, "Du stehst im Rosengarten des Koenigs vom Land der "
    "Ferne und bist beeindruckt vom Duft und der Schoenheit der Rosen. Im "
    "Norden kannst Du ein Schloss auf einem Huegel erkennen, welches von "
    "alten Baeumen eingefasst ist. Zwischen den Rosen und Lilien fuehren "
    "Wege, die mit weissen Kieselsteinen belegt sind. Ein breiter Weg "
    "fuehrt auch zum Schloss - doch ist da noch ein Tor dazwischen.");



  STANDARD
  STANDARD1




  AddExit("westen",ROOM+"r5");
  AddExit("osten" ,ROOM+"r7");
  AddExit("norden",ROOM+"r3");
  
}
