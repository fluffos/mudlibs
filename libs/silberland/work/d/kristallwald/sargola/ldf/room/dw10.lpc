inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "dwald.h"


int schaerfe(string str);
   
                             
create()
{
  ::create();

  
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"Im dunklen Wald");
  SetProp (P_INT_LONG, "Du stehst am Ende des dunklen Waldes. Im Norden "
    "ist es ein wenig heller als im Sueden. Es wirkt fast freundlich, im "
    "Vergleich zum Wald im Sueden. Ein grosser Berg erhebt sich dort und der "
    "Himmel ist nicht von Baeumen verdeckt.");
  AddDetail("vergleich","Der zwischen Norden und Sueden.");
  AddDetail("ende","Im Norden hoert der Wald auf.");
  AddDetail("berg","Der Berg wirkt sehr gross und hat soweit Du das erkennen "
    "kannst glatte Felswaende, die steil nach oben ragen.");
  AddDetail(({"waende","felswaende"}),"Die solltest Du im Norden genauer "
    "untersuchen.");
  AddDetail("himmel","Er ist nicht mehr von Aesten verdeckt.");
  

  STANDARD
  SOUND
  SMELL

  AddExit("sueden",ROOM+"dw9");
  AddExit("nordwesten",ROOM+"b3");
  AddCmd(({"schaerf","schaerfe"}),"schaerfe");


}

SINNE
