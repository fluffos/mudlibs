inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "berg.h"
#include "../../dorf/obj/ldfquest.h"

string eingang();
string magie();

int versetze(string str);
int check();   
                             
create()
{
  ::create();

  
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"Im dunklen Wald");
  SetProp (P_INT_LONG, "Du stehst auf einem schmalen freien Streifen "
    "zwischen den dichten Baeumen des dunklen Waldes und einer steilen "
    "Felswand. Im Norden ist alles steinig und Geroell liegt am Boden "
    "herum. Nach Westen und Osten setzt sich der freie Streifen fort. "
    "Der Himmel ueber Dir leuchtet dunkelschwarz ohne Sterne.");
    
  AddDetail("streifen","Ein schmaler Streifen Boden fuehrt zwischen "
    "Wald und Berg durch.");
  AddDetail("geroell","Einige kleinere Steinchen, welche sicher vom "
    "Berg kommen liegen am Boden herum.");
  AddDetail("wald","Er befindet sich im Sueden.");
  AddDetail(({"wand","felswand"}),"Du kannst von dem riesigen Berg nur "
    "die Felswand vor Dir sehen.");
  AddDetail("eingang",#'eingang);
  AddDetail("magie",#'magie);
  
  

  STANDARD


  AddExit("suedwesten",ROOM+"b1");
  AddExit("osten",ROOM+"b3");
  AddCmd(({"versetze","versetz"}),"versetze");

}

string eingang()
{
  if(check())
  {
    return BS("Du suchst genau nach einem Eingang und glaubst auch zu ent"
      "decken, dass hie einmal einer war. Nur ist er magisch verschlossen. "
      "Wenn man diese Magie nur brechen koennte...");
  }
  return BS("Sowas siehst Du hier nicht.");
}

string magie()
{
  if(check())
  {
    return BS("Der Eingang ist magisch verschlossen und nur wenn man die "
      "Magie bricht, kann man in den Berg vordringen.");
  }
  return BS("Sowas siehst Du hier nicht.");
}
  

int check()
{
  object ob;
  int berghinweis;
  ob=deep_present("\nldfquest",TP);
  if(objectp(ob)) berghinweis = ob->frage_wert(BERGHINWEIS);
  return berghinweis;
}

VERSETZE
