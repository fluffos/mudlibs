inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "dwald.h"

int pfeiffe(string str);
int schaerfe(string str);  
                             
create()
{
  ::create();

  
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"Im dunklen Wald");
  SetProp (P_INT_LONG, "Du stehst am Beginn des dunklen Wald. Und der hat "
    "seinen Namen nicht von ungefaehr. So ziemlich alles, was vor Du siehst "
    "ist duester und dunkel. Ueberall um Dich herum siehst Du dunkle, fast "
    "schwarze Baeume. Nur noch hinter Dir in Richtung der Bruecke scheint "
    "es wieder freundlicher zu werden.");
  
  AddDetail("beginn","Im Norden erstreckt sich der dunkle Wald.");
  AddDetail("richtung","Du meinst Sueden.");
  AddDetail("bruecke","Die Bruecke des Morgengrauens scheint fast hell "
    "im Vergleich zu diesem Wald.");
  AddDetail("vergleich","Den hast Du hier noch.");

  STANDARD
  SOUND
  SMELL

  AddExit("nordosten",ROOM+"dw2");
  
  AddCmd(({"pfeife","pfeif"}),"pfeiffe");
  AddCmd(({"schaerfe","schaerf"}),"schaerfe");
  

}

int pfeiffe(string str)
{
  notify_fail("Nach wem moechtest Du pfeifen?\n");
  if(!str) return 0;

  if(str=="nach miramis")
  {
    tell_object(TP, BS("Du pfeifst nach Miramis und kurz danach siehst Du ihn "
      "schon mit einem maechtigen Satz von der Bruecke aus auf Dich zukommen. "
      "Du steigst auf und ihr reitet gemeinsam wieder rueber."));
    TP->move(ROOM+"w8", M_GO);
    return 1;
  }
  return 0;
}


SINNE
