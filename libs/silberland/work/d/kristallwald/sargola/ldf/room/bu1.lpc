inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>

#include "../def.h"
#include "burg.h"


int schrecken(string str);

create()
{
  ::create();


  SetProp (P_LIGHT,0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));

  SetProp(P_INT_SHORT, "In einer finsteren Burg");
  SetProp(P_INT_LONG, "Du stehst in einem duesteren Gang "
    "in Ritter Katos Burg, der spaerlich von Fackeln an "
    "den Waenden erhellt wird. Die Waende und der Boden "
    "sind aus kaltem, finsterem Fels. Im Norden liegt die "
    "Schlucht, aus der Du gefluechtet bist.");
  AddDetail("schlucht","Die Schlucht, ueber die Du gefluechtet "
    "gekommen bist, liegt im Norden.");


  STANDARD
  SOUNDS
  SMELLS

 
 AddExit("sueden",ROOM+"bu2");
}
