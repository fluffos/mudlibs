inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "stollen.h"

int norden(); 
string hebel();  
int ziehe(string str);
int druecke(string str); 
int hebel; 
                             
create()
{
  ::create();

  hebel = 0; //oben
  
  SetProp (P_LIGHT,0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"In einem finsteren Stollen");
  SetProp (P_INT_LONG, "Du stehst im grossen Saal dessen "
    "Decke so hoch ist wie ein Kirchenschiff. Im Norden gaehnt wie ein "
    "schwarzes Loch der Stollen und schlaengelt sich weiter. Ein Licht "
    "scheint, aber Du kannst nicht lokalisieren aus welcher Richtung.");
    
  STANDARD  
    
  AddDetail(({"schiff","kirchenschiff"}),"Einfach riesig...");
  AddDetail("saal","Du kannst die genauen Masse nicht exakt be"
    "messen, aber er wirkt recht gross auf Dich.");
  AddDetail("masse","Sie die nun so wichtig?");
  AddDetail("loch","Der sich nach Norden schlaengelnde Stollen "
    "sieht aus wie ein schwarzes Loch.");
  AddDetail("licht","Es schimmert schwach und erhellt den Saal ein "
    "wenig. Aber du kannst nicht erkennen, aus welcher Richtung es kommt.");
  AddDetail("richtung","Es schimmert einfach ueberall ohne eine "
    "Richtung zu haben. Bis auf ein winziges Funkeln.");
  AddDetail("funkeln","Das Funkeln stellt sich als kleiner Hebel "
    "heraus.");
  AddDetail("hebel",#'hebel);					

  AddExit("sueden",ROOM+"st1");
  AddCmd(({"druecke","drueck"}),"druecke");
  AddExit("norden",#'norden);

}

string hebel()
{
  string a;
  a = "Du bemerkst einen kleinen metallenen, in die Wand eingearbeiteten Hebel, den man "
    "sicherlich druecken kann. ";
  if(hebel==0)
    a = a + "Er steht gerade unten.";	
  else a = a + "Er steht gerade oben.";
  
  return BS(a);
}

int norden()
{
  if(hebel)
  {
    TP->move(ROOM+"st3",M_GO);
    return 1;
  }
  TP->move(ROOM+"st2",M_GO);
  return 1;
}

int druecke(string str)
{
  notify_fail("Was moechtest Du druecken?\n");
  if(!str) return 0;
  

  if(str=="hebel") { tell_object(TP, "Wie willst Du den Hebel druecken?\n"); return 1; }
  
  
  if(str=="hebel nach oben")
  {
    if(hebel==1)
    {
      tell_object(TP, "Der Hebel ist doch schon oben!\n");
      return 1;
    }
    else
    {
      tell_object(TP, BS("Du drueckst den Hebel nach oben und hoerst ein "
        "leises Klicken."));
      hebel = 1;
      return 1;
    }
  }
  if(str=="hebel nach unten")
  {
    if(hebel==1	)
    {
      tell_object(TP, BS("Du drueckst den Hebel nach unten und hoerste ein "
        "leises Klicken."));
      hebel = 0;
      return 1;
    }
    else
    {
      tell_object(TP, "Der Hebel ist doch schon unten.\n");
      return 1;
    }
  }
  return 0;
}

reset()
{
  ::reset();
  hebel = 0;
}  
