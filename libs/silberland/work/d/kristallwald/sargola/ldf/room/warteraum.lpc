inherit "std/room";

#include <properties.h>
#include "../def.h"


                             
create()
{
  ::create();
  
  
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"Im koeniglichen Warteraum");
  SetProp (P_INT_LONG, "Nur ein Warteraum.");


  
}
