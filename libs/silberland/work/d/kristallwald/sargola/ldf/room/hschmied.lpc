inherit "std/room";

#include <properties.h>
#include "../def.h"



                             
create()
{
  ::create();


  SetProp (P_LIGHT,0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"Bei einem Schmied");
  SetProp (P_INT_LONG, "Du stehst in einem weiten Raum, fast schon "
    "ein Saal, aber der Raum ist feiner gearbeitet. Im Zentrum "
    "des Saales steht ein grosser Ofen eines Schmiedes, in ihm ein "
    "gleissendes, heisses Feuer. An den Waenden lehnen eine Unmenge "
    "von Speeren, Schwertern und anderen Waffen.");
    
  AddDetail("raum","Er ist so gross, dass es fast ein Saal ist.");
  AddDetail("saal","Er ist nicht so hoch, die die Raeume vorhin, aber "
    "dafuer ist er schoener und glatter aus dem Stein gehauen. In seinem "
    "Zentrum steht ein Schmiedeofen.");
  AddDetail("raeume","Die, von denen Du kamst.");
  AddDetail("stein","Du bist umgeben von Stein, weil Du ja im Berginneren "
    "bist.");
  AddDetail("berginneres","Mitten im Berg sozusagen.");
  AddDetail(({"inneren","berginneren"}),"Genau im Berg drin.");
  AddDetail("zentrum","Im Zentrum des Raumes befindet sich ein imposanter "
    "Ofen eines Schmiedes.");
  AddDetail(({"ofen","schmiedeofen"}),"Der Schmiedeofen ist in der Mitte "
    "des Raumes und in ihm brennt ein gleissendes, weisses und vor allem "
    "heisses Feuer.");
  AddDetail("feuer","Es ist heiss, weil hier ja eigentlich keine Luft "
    "von draussen reinkommen kann, oder doch?");
  AddDetail("luft","Komisch ... irgendwie spuerst Du einen Luftstrom...");
  AddDetail("luftstrom","Woher der wohl kommen kann mitten im Berg?");
  AddDetail("unmenge","Ja, soviel hast Du noch nie gesehen!");
  AddDetail("speere","Solche hast Du schon bei den schwarzen Spaehern "
    "gesehen!");
  AddDetail(({"langschwerter","schwerter"}),"Langschwerter, auch aus schwarzem Metall.");
  AddDetail("metall","Die Schwerter und die Speere sind aus Metall.");
  AddDetail("waffen","Speere, Schwerter und andere noch unfertige "
    "Sachen.");
  AddDetail("sachen","Du bist kein Schmied und kennst Dich damit nicht "
    "aus.");
  AddDetail("steine","Steine, wie sie in einem durchschnittlichen Berg "
    "so ueblich sind.");
  AddDetail(({"wand","waende","boden"}), "Die Waende und der Boden sind "
    "viel liebevoller aus dem Stein gehauen. Aber immernoch ist es Stein. "
    "Obwohl er kaum noch schwarz ist, wie draussen. Hier scheint die "
    "Macht von Ritter Kato klein zu sein. Dicke Steine halten sie auf.");
  AddDetail("macht","Sie wirkt hier nicht mehr stark.");
  AddDetail(({"ritter","kato"}),"Den kannst Du hier gottseidank nicht sehen.");
  AddDetail("decke","Sie ist an den Waenden nicht so weit vom Boden ent"
    "fernt, im Zentrum ist sie sehr weit nach oben gewoelbt.");
  AddDetail("berg","Du bist in ihm drin. Hoffentlich macht Dir das nicht "
    "Angst.");
  AddDetail("angst","Achwas, lass Dir nichts anmerken!!");
  AddDetail("mitte","Du meinst das Zentrum?");
  AddDetail("spaeher","Die siehst Du hier nicht - nur ihre Speere.");

  AddSmell(DEFAULT_SMELL, "Du riechst das Feuer und den Geruch von gluehendem "
    "Metall.");
  AddSmell("feuer","Es riecht wie ein typisches Feuer so riecht.");
  AddSmell("geruch","Gluehendes Metall ist der dominanteste Geruch.");
  AddSmell(({"gluehendes metall","metall"}),"Es ist ein fast aetzender "
    "Geruch - der Schmied muss da einiges aushalten.");
  AddSmell("schmied","Wuah...so nah am Feuer zu stehen...Du riechst da kein "
    "zweites Mal dran.");
    
  AddSound(DEFAULT_SOUND,"Du hoerst das gleichmaessige Klopfen und Schlagen "
    "des Schmiedes auf einer metallenen Klinge und das Knistern des Feuers.");
  AddSound("schmied","Er klopft und haemmert auf eine metallene Klinge.");
  AddSound("klinge","Die Klinge direkt macht kein Geraeusch.");
  AddSound("geraeusch","Es ist ein \"Klopf!\".");
  AddSound("klopf","Das macht die Klinge.");
  AddSound(({"klopfen","schlagen"}),"Der Schmied hat wohl sonst nichts zu "
    "tun.");
  AddSound(({"knistern","feuer"}),"Das Feuer knistert leise.");

  AddItem(NPC+"schmied",REFRESH_DESTRUCT);
  AddExit("sueden",ROOM+"st4");


}


    
