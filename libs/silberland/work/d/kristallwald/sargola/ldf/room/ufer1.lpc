inherit "std/room";

#include <properties.h>
#include "../def.h"

int schwimme(string str);
int kletter(string str);
                             
create()
{
  ::create();


  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"An einem Ufer");
  SetProp (P_INT_LONG, "Du stehst an einem Ufer, neben Dir ragt "
    "keine natuerliche Felswand, sondern eine Mauer auf. "
    "Sie ist aus klotzigen Steinen gebaut ist und steil nach "
    "oben geht. Oben kannst Du Zinnen entdecken - das muss Ritter "
    "Katos Burg sein.");
  AddDetail("felswand","Es ist eine kuenstliche Mauer.");
  AddDetail("lied","Lausch doch mal!");
  AddDetail("wand","Du meinst die senkrechte Mauer.");
  AddDetail(({"steinmauer","mauer"}),"Sie ist aus groben Steinen "
    "gemauert und hat weit oben Zinnen.");
  AddDetail("zinnen","Es duerften maechtige, grosse Zinnen sein "
    "und man hat dort oben sicherlich einen guten Ausblick.");
  AddDetail("ausblick","Noch bist Du unten :)");
  AddDetail("steine","Sie sind gross, klobig und ebenso ungenau "
    "gemauert.");
  AddDetail(({"ritter","kato"}), "Den siehst Du hier gottseidank "
    "(noch) nicht.");
  AddDetail("burg","Die Mauer gehoert sicherlich zur Burg.");
  AddDetail("kreise","Die Voegel ziehen Kreise am Himmel.");
  
    
  AddDetail("boden","Der Boden besteht aus feuchter Erde und steigt "
    "immer mehr an bis er an der Steinmauer endet.");
  AddDetail("erde","Die Erde hier ist feucht und wird zum Ufer hin "
    "immer schlammiger. Sie ist wie auch das Wasser des Sees schwarz. "
    "selbst wenn die braun waere, wuerdest Du es hier nicht erkennen "
    "koennen :)");
  AddDetail("wasser","Es wirkt ziemlich dunkel und kraeuselt leicht "
    "die Oberflaeche. Vielleicht wirkt es auch nur so dunkel, weil "
    "es ueberhaupt dunkel ist. Aber das ist nicht allein der Grund.");
  AddDetail("grund","Den weisst Du nicht genau.");
  AddDetail("oberflaeche","Die Oberflaeche des Sees ist bis auf einige "
    "kleine Wellen ruhig.");
  AddDetail("see","Vor Dir liegt ein grosser, dunkler See. Du kannst "
    "das andere Ufer von hier aus nicht sehen.");
  AddDetail("ufer","Zum einen gibt es das, auf dem Du gerade stehst, "
    "zum anderen gibt es das Ufer auf der anderen Seite.");
  AddDetail("boot","Sowas siehst Du hier nicht ... Du wirst schwimmen "
    "muessen.");
  AddDetail("wellen","Sie sind kaum zu sehen und schlagen sanft ans "
    "Ufer.");
  AddDetail("himmel","Der Himmel liegt friedlich und blauschwarz ueber "
    "Dir. Du kannst keine Sterne erkennen. Undeutlich kannst Du Voegel "
    "am Himmel erkennen.");
  AddDetail("voegel","Es scheinen schwarze Raben zu sein. Wieder "
    "schwarz ... hmm, Dich wundert schoen langsam nichts mehr. Sie "
    "fliegen weite Kreise um den See und singen ein trauriges Lied.");
  AddDetail("raben","Es muessten Raben sein - aber sie sind so weit "
    "weg, sicher bist Du Dir nicht.");    
    
  AddSound(({"voegel","raben"}),"Sie singen ein unendlich trauriges "
    "Lied.");
  AddSound("lied","Sie beklagen etwas ... ob der Schmied mehr weiss?");   
    
  AddDetail("sterne","Es sind einfach keine zu sehen.");
  AddDetail("seite","Du stehst gerade auf der einen.");
  

  AddCmd(({"schwimm","schwimme"}),"schwimme");
  AddCmd(({"kletter","klettere","kraxel","kraxle"}),"kletter");
}

int kletter(string str)
{ 
   
  notify_fail("Worauf moechtest Du klettern?\n");
  if(!str || (str!="rauf" && str!="auf mauer" && str!="mauer"))  return 0;

  if(TP->QueryAttribute(A_DEX)<random(35))
  {
    tell_object(TP, "Du beginnst auf die Mauer zu klettern, faellst aber "
      "gleich wieder runter!");
    TP->reduce_hit_point(5);
    return 1;
  }
  else
  {
    tell_object(TP, BS("Du beginnst auf die Mauer zu klettern und musst Dich "
      "gehoerig anstrengen, dass Du nicht wieder runter faellst! Doch nach "
      "einiger Zeit schaffst Du es und kommst oben an."));
    tell_object(TP, BS("Kaum bist Du oben wirst Du von Spaehern entdeckt! Es "
      "sind vielzuviele und sie ueberwaeltigen Dich! Dann wird Dir schwarz "
      "vor den Augen und Du findest Dich in einer Kerkerzelle wieder!"));
    TP->move(ROOM+"zelle",M_GO,"nach oben","klettert","wird reineskortiert");
    return 1;
  }    
  return 0;
}


int schwimme(string str)
{
  notify_fail("Wohin moechtest Du schwimmen?\n");
  if(!str || (str!="durch see" && str!="durch" && str!="see")) return 0;
  
  tell_object(TP, 
	"Du wirfst Dich furchtlos in die Wellen und schwimmst durch das kalte Wasser\n"
	"auf die andere Seite. Erschoepft kommst Du an.\n");
  TP->move(ROOM+"ufer1",M_GO,"durch den See","schwimmt","kommt angeschwommen");
  return 1;
}
