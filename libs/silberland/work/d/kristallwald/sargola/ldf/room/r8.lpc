inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "roseng.h"

haeuschen();


create()
{
  ::create();
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_LONG, "");
  SetProp (P_INT_SHORT,"Im koeniglichen Rosengarten");
  SetProp(P_INT_LONG, "Du stehst in einem maerchenhaften Haeuschen, wie "
    "man es sich nur vorstellen kann. Ueber Dir kannst Du die Decke aus "
    "Stroh sehen. Der Boden ist mit groben Holzplanken ausgelegt. Du "
    "kannst eine Kochecke, einen groben Tisch mit Sesseln und zwei "
    "gemachte Betten entdecken.");
    
  AddDetail(({"wand","waende"}), "Die Waende sind weisslich und haben "
    "eine rundliche Form.");
  AddDetail("form","Nun sie haben keine Kanten bei den Fenstern und der "
    "Tuer.");
  AddDetail("tuer","Es fuehrt eine Tuer nach draussen.");
  AddDetail("fenster","Ein fast rundliches Fenster fuehrt nach draussen, "
    "durch welches kleine weisse Voegel ein und aus fliegen.");
  AddDetail("voegel","Sie fliegen hier ein und aus als waeren sie hier "
    "zu Hause. Im ganzen Haeuschen zwitschern sie und sitzen ueberall "
    "herum.");
  AddDetail("kanten","Solche siehst Du hier nicht.");
  AddDetail("decke","Sie ist mit Stroh ausgelegt."); 
  AddDetail("boden","Er besteht aus dunklen Planken aus grobem Holz. "
    "Trotzdem wirkt er sehr sauber und ordentlich (nimm Dir ein Beispiel).");
  AddDetail("beispiel","Tja, sieh Dich doch nur um!");
  AddDetail(({"holzplanken","planken"}),"Sie sind aus einem ziemlich dunklen Holz und "
    "alle blank geschliffen.");
  AddDetail("holz","Es ist dunkel - mehr kannst Du nicht feststellen.");
  AddDetail("stroh","Ob das auch bei starkem Regen dicht haelt?");
  AddDetail("regen","Das ist gerade ein schlechter Zeitpunkt um Regen "
    "zu untersuchen...");
  AddDetail("zeitpunkt","Der ist gerade nicht gekommen...");
  AddDetail("haeuschen",#'haeuschen);
  
  AddDetail(({"ecke","kochecke"}), "Im hinteren Teil des Haeuschens kannst "
    "Du einen Ofen erkennen, auf dem gerade eine Pfanne steht.");
  AddDetail("teil","Im hinteren Teil...");
  AddDetail("ofen","Er ist nicht besonders gross, aber damit laesst "
    "es sich sicherlich wunderbar kochen.");
  AddDetail("pfanne","Es ist so eine alte, dicke aus Gusseisen, mit der "
    "man herrliche Palatschinken machen kann.");
  AddDetail(({"eisen","gusseisen"}), "Die Pfannen aus Gusseisen werden "
    "gegossen und sind ungewoehnlich schwer.");
  AddDetail("palatschinken","Und wirklich! Jum-Jums Mutter macht gerade "
    "Palatschinken mit Erdbeerkompott.");
  AddDetail(({"kompott","erdbeerkompott"}),"Auf dem Tisch kannst Du ein "
    "rundliches Glas entdecken, das mit einem Tuch und einem Ring verschl"
    "ossen ist. Und darin befindet sich leckeres Erdbeerkompott.");
  AddDetail("glas","Das Glas ist recht gross, bauchig und mit einem Tuch "
    "verschlossen.");
  AddDetail("tuch","Es wurde ueber das Glas mit Erdbeerkompott gespannt.");
  AddDetail("ring","Er spannt das Tuch auf dem Glas mit Erdbeerkompott.");
  AddDetail("bett","Du kannst zwei Betten erkennen.");
  AddDetail("betten","In dem Haeuschen gibt es zwei Betten. Ein grosses, "
    "das vermutlich Jum-Jums Vater und Mutter gehoert, und ein kleines, "
    "das Jum-Jum gehoert, folgerst Du scharfsinnig.");
  AddDetail("vater","Der ist wohl im Rosengarten zu finden.");
  AddDetail("tisch","Es ist ein einfacher, aber gemuetlich wirkender Tisch "
    "und auf ihm stehen Teller und ein Glas Erdbeerkompott.");  
  AddDetail("teller","Schlichte einfache Teller.");
  AddDetail("sessel","Es gibt 3 Sessel um den Tisch herum.");
  
  AddSound(DEFAULT_SOUND, "Du hoerst die vielen Voegel, die hier ein und aus "
    "fliegen. Draussen hoerst Du den Gaertner herumlatschen und manchmal "
    "ertoent ein lautes \"Platsch!\".");
  AddSound("voegel","Sie flattern aus und ein.");
  AddSound("gaertner","Der stapft unverdrossen durch seine Rosen.");
  AddSound("rosen","Die kannst Du kaum hoeren.");
  AddSound(({"palatschinken","platsch"}),"Palatschinken, die die Mutter von Jum-Jum "
    "durch die Luft wirbelt.");
  AddSound("mutter","Die summt ein gar lustig Lied!");
  
  AddSmell(DEFAULT_SMELL, "Du riechst den intensiven Duft der frischen "
    "Palatschinken und von Erdbeermarmelade.");
  AddSmell("duft","Es riecht hier ganz intensiv nach Palatschinken.");
  AddSmell("palatschinken","Hmm.... ob sie Dir auch welche kosten laesst?");
  AddSmell(({"erdbeermarmelade","marmelade"}), "Dir laeuft das Wasser im "
    "Mund zusammen.");


  AddItem(NPC+"mutter", REFRESH_DESTRUCT);

  AddExit("westen",ROOM+"r7");
  
}

haeuschen()
{ return BS(TO->QueryProp(P_INT_LONG)); }


