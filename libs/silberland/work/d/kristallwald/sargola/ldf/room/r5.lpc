inherit "std/room";

#include <properties.h>
#include "../def.h"

vielzahl();

create()
{
  ::create();
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_LONG, "");
  SetProp (P_INT_SHORT,"Im koeniglichen Rosengarten");
  SetProp (P_INT_LONG, "Du stehst im herrlichsten Rosengarten, den "
    "Du jemals in Deinem kurzen und unbedeutenden Leben gesehen hast. "
    "Eine beeindruckende Vielzahl von Rosen und Lilien bluehen ent"
    "lang der schmalen Wege, die mit weissen Kieselsteinen bedeckt "
    "sind. Im Westen ist der Garten von einer Mauer aus Ziegelsteinen "
    "begrenzt. Sanft erwaermt die Sonne den Boden und ueber Dir "
    "herrscht tiefes Blau am Himmel.");


AddDetail("leben","Es ist so klein, das lohnt nichtmal, es als "
  "Detail zu beschreiben :)");
AddDetail("detail","Sowas siehst Du hier nicht ;)");
AddDetail("vogel","Lausch doch mal!");
AddDetail("blau","Es ist einfach blau.");

AddDetail("vielzahl",#'vielzahl);
AddDetail(({"garten","rosengarten"}),"Das ist der Rosengarten des Koenigs.");					
AddDetail("koenig","So ein herrlicher Rosengarten kann nur dem Koenig "
  "gehoeren.");							
AddDetail(({"land","ferne","land der ferne"}),"Du bist direkt im Land der Ferne.");			
AddDetail("boden","Er besteht aus feucher, aber fester Erde, die "
  "wie geschaffen fuer Rosenstraeucher ist. Viele Wege fuehren "
  "zwischen den Straeuchern hindurch.");
AddDetail("erde","Sie ist feucht und fast schwarz.");
AddDetail("wege","Die Wege zwischen den Rosenstraeuchern fuehren in "
  "alle Richtungen und der breiteste fuehrt zum Schloss im Norden. "
  "Sie sind alle mit weissen Kieselsteinen ausgelegt.");
AddDetail(({"stein","steine","kieselsteine"}), "Die feinen, weissen "
  "Kieselsteine markieren den Weg, damit man nicht versehentlich "
  "in die Rosenstraeucher tritt.");
AddDetail(({"gebaeude","schloss"}),"Selbst von hier in ziemlicher "
  "Entfernung ist es ein beeindruckendes Gebaeude, das viele "
  "Tuerme, Fenster und Nischen hat.");
AddDetail("lilien","Zwischen den Rosenstraeuchern wachsen weisse "
  "Lilien.");
AddDetail(({"pappeln","silberpappeln"}),"Um den Rosengarten herum "
  "wachsen silberne Pappeln, welche sich im Wind wiegen. Dadurch "
  "scheint auch ein feines Klingen zu entstehen, das wie Glocken "
  "klingt. Ausserdem hoerst Du einen Vogel singen." );
AddDetail(({"nischen","fenster"}),"Auf die weite Entfernung kannst "
  "Du nichts mehr erkennen.");
AddDetail("entfernung","Die hat es an sich, dass man nichts mehr "
  "untersuchen kann.");
AddDetail(({"tuerme","turm"}), "Groessere und kleinere Tuerme mit "
  "kleinen Daechlein und spitzen Giebeln schmuecken das Schloss.");
AddDetail("giebel","Sie sind zu weit entfernt um etwas zu erkennen.");
AddDetail(({"daecher","dach","daechlein"}),"Sie reflektieren das "
  "Sonnenlicht und glaenzen wundervoll.");
AddDetail(({"licht","sonnenlicht","sonne"}),"Die Sonne bringt das "	
  "Schloss und den Rosengarten zum Leuchten und Erstrahlen.");		
AddDetail( ({"leuchten","erstrahlen"}),"Hauptwoertlich gebrauchte "	
  "Verben.");								
AddDetail("verben","Ich erstrahle, Du erstrahlst usw ...");		
AddDetail(({"rosenstraeucher","straeucher"}),				
  "Meinst Du etwa die Rosen?");					
AddDetail("rosen","Um Dich herum siehst Du nur Rosen. Rote und "
  "weisse Rosen und zwischen ihnen weisse Lilien. Ihr zarter, blumiger "
  "Duft umhuellt Dich. Doch Rosen haben ausser schoenen Blueten auch "
  "Dornen...");
AddDetail("blueten","Fast alle sind schon aufgeblueht und verbreiten "	
  "einen herrlichen Duft. Egal wo Du hinsiehst, rote und weisse "	
  "Blueten wachsen hier, um den Besucher zu erfreuen.");		
AddDetail("blueten","Du kannst die Blueten roter und weisser Rosen "
  "erkennen, weiters die von weissen Lilien. Und alles (so scheint "
  "es) nur um Besucher zu erfreuen.");
AddDetail("besucher",BS((TP->QueryProp(P_LONG))) );
AddDetail("dornen","Die Rosen versinnbildlicht wie kaum eine andere"		
  "Blume Schoenheit aber auch Gefahr. Die Dornen sollen Dich daran "
  "erinnern, dass Rosen nicht nur einfach schoen sind.");				
AddDetail("schoenheit","Du musst wohl blind sein, wenn Du sie nicht "	
  "erkennst.");								
AddDetail("gefahr","Komisch ... die Rose symbolisiert Gefahr. Hier "	
  "ist es doch so paradiesisch schoen ... Komisch nicht?");		
AddDetail("paradies","Du denkst intuitiv - das muss hier sein!");			
AddDetail("duft","Den kann man nicht untersuchen.");		
AddDetail("bild","Es ist ein ziemlich romantisches Bild.");			
AddDetail("himmel","Abgesehen von ein paar langsam ueber den "
  "Himmel wandernden Schaefchenwolken ist er tiefblau.");						
AddDetail("wolken","So als Laie wuerdest Du einfach mal tippen, "
  "dass es sich um Schaefchenwoelkchen handelt - zumindest sehen "
  "sie wie Schaefchen aus.");							
AddDetail(({"schaefchenwoelkchen","schaefchenwolken"}),
  "Kleine, weisse Wolken, die wie Schaef"	
  "chen aussehen. \nDu kicherst bei dem Gedanken.");			
AddDetail("schaefchen","Ob die Aehnlichkeit Zufall ist?");
AddDetail("laie","In DEM Fall musst Du damit gemeint sein...");
AddDetail("fall","Dieser jenige welcher eben.");
AddDetail("aehnlichkeit","Wirklich verblueffend...");
AddDetail("zufall","Den kannst Du an der Aehnlichkeit von Wolken "
  "und Schaefchen erkennen - oder doch nicht?");							
AddDetail("gedanken","Wie schade ... er ist schon wieder weg...");				
AddDetail("mauer","Rund um den Rosengaerten fuehrt eine Mauer aus "
  "Ziegelsteinen.");	

AddDetail(({"ziegel","ziegelsteine"}),"Sie sind klein und klobig gefertigt. "
  "Es wirkt so, als ob die Ziegel von Hand gefertigt wurden - "
  "so ungleich sind sie. Aber das verstaerkt das romantische "
  "Gefuehl in Dir. Darauf kannst Du manchmal ein Wappen erkennen.");				
AddDetail("hand","Du hast auch zwei davon - hoffentlich.");
AddDetail("gefuehl","Horch einfach in Dich hinein...");			
AddDetail("verputz","Der weisse Verputz ist an einigen Stellen schon "	
  "abgebroeckelt und es scheinen die Ziegel darunter hervor.");		
AddDetail("stelle","Hie und da ist der Verputz schon von der Mauer "	
  "gebroeckelt und man kann die Ziegel darunter erkennen.");		
AddDetail("wappen","Es ist das Wappen vom Land der Ferne.");		








AddSound(DEFAULT_SOUND, "Es klingt wie wundersame Musik um Dich "
  "herum, so als ob tausend glaeserne Glocken gemeinsam ertoenen. "
  "Im ganzen Garten singen Voegel.");
AddSound(({"klingen","glocken","musik"}), "Das wundersame Klingen "
  "stammt von den Blaettern der Silberpappeln, die sich sanft und "
  "gleichmaessig im Wind wiegen. Als waeren sie aus Glas.");
AddSound("blaetter","Die Blaetter der Pappeln verursachen das "
  "seltsame Klingen.");
AddSound(({"pappeln","silberpappeln"}), "So seltsam es klingen mag, "
  "von ihnen geht das Klingen aus.");
AddSound("voegel","Ueberall im Garten zwitschern Voegel froehliche "
  "Lieder. Doch zwischen ihnen erklingt auch eine traurige Melodie.");
AddSound("lieder","Sie machen Dein Herz froh.");			
AddSound("herz","Buummm... Buummm..."); 			

					
AddSound(({"lied","melodie"}),"Nach einiger Zeit kannst Du den Vogel ausmachen, "
  "der das traurige Lied singt. Er sitzt auf der hoechsten Silber"
  "pappel und singt ein tieftrauriges Lied. Du wunderst Dich.");
AddSound("vogel","Er zwitschert ein unwirklich trauriges Lied, das "
   "Dich betruebt. Warum bloss?.");								
AddSmell(DEFAULT_SMELL,"Der Duft der Rosen verzaubert Dich voellig.");	
AddSmell("duft","Der Duft der Rosen und auch jeder der Lilien.");					
AddSmell("rosen","Blumiger Duft umschmeichelt Deine Nase.");						
AddSmell("lilien","Sie verbreiten einen blumigen Duft, der Dich fast "	
  "Deiner Sinne beraubt.");




  AddExit("norden",ROOM+"r2");
  AddExit("osten",ROOM+"r6");
  AddExit("suedwesten",ROOM+"w1");
  AddItem(NPC+"jum-jum",REFRESH_DESTRUCT);
  
}

vielzahl()
{
   string race;
   race = TP->QueryProp(P_RACE);
   switch (race)
   {
   	case "Elf":
	case "Mensch":
	{
	   return BS("Es sind sicher an die 200 Rosenstoecke, "
	   "die hier wachsen.");
	}
	default:
	{
	  return BS("Du kannst nicht soweit zaehlen...");
	}
   }
}
