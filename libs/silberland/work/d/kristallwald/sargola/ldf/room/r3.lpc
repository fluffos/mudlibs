inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "roseng.h"


create()
{
  ::create();
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_LONG, "");
  SetProp (P_INT_SHORT,"Im koeniglichen Rosengarten");
  SetProp(P_INT_LONG, "Du stehst im Rosengarten des Koenigs vom Land der "
    "Ferne und bist beeindruckt vom Duft und der Schoenheit der Rosen. "
    "Im Norden kannst Du ein Schloss auf einem Huegel erkennen - von alten "
    "Baeumen eingefasst. Wege mit weissen Kieselsteinen belegt fuehren "
    "zwischen den Rosenstraeuchern durch und auch nach Norden zum Schloss. "
    "Doch ist davor ein geschlossenes Tor.");
 AddDetail( ({"steine","kieselsteine"}),"Sie bedecken die Wege zwischen "
   "den Rosen und Lilien.");
 AddDetail("huegel","Auf ihm steht das Schloss.");
 AddDetail("weg","Davon siehst Du viele.");
 AddDetail("tor","Wenn Du weiter nach Norden gehen wuerdest, koenntest "
   "Du eventuell mehr erkennen.");
 AddDetail("baeume","Die alten Silberpappeln saeumen die Allee zum "
    "Schloss.");
  AddDetail( ({"pappeln","silberpappeln","pappel","silberpappel"}),
    "Schlanke, unendlich hohe Pappeln mit silbernen Blaettern glaenzen "
    "im Sonnenlicht und verursachen ein unwirkliches Klingen.");
  AddDetail(({"sonnenlicht","licht"}), "Es stroemt langsam auf den "
    "Rosengarten herab.");	

  AddDetail(({"land","land der ferne","ferne"}), "Wo das wohl sein koennte...");

  STANDARD
  STANDARD1




  AddExit("westen",ROOM+"r2");
  AddExit("osten" ,ROOM+"r4");
  AddExit("sueden",ROOM+"r6");
  AddExit("norden",ROOM+"r1");
  
}


