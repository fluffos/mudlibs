inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "weide.h"

       
                             
create()
{
  ::create();

  
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"Auf einer gruenen Weide");
  SetProp (P_INT_LONG, "Du stehst mitten in einer Weide mit grasen"
    "den Schafen und Kuehen. Ein wenig gegangener Weg schlaengelt "
    "sich zwischen den sanften Huegeln durch und fuehrt weiter in "
    "die Weide. Im Nordosten kannst Du weit entfernt ein imposantes "
    "Schloss und davor einen Garten erkennen.");

  STANDARD
  STANDARD1
  
  AddDetail("schloss","Es its zu weit weg, um etwas zu sehen.");
  AddDetail("garten","Vor dem Schloss liegt ein huebscher Garten.");

  AddExit("nordwesten",ROOM+"w3");
  AddExit("nordosten",ROOM+"w1");  
  
  AddItem(NPC+"schaf", REFRESH_DESTRUCT);
}
