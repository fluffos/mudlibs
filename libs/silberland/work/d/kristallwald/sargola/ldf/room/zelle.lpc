inherit "std/room";

#include <properties.h>
#include "../def.h"


                             
create()
{
  ::create();
  
  
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"Auf einem Felsvorsprung");
  SetProp (P_INT_LONG, "Du befindest Dich auf einem kleinen Felsvor"
    "sprung im Inneren von Ritter Katos Burg. Vor Dir gaehnt ein "
    "tiefer Abgrund - der einzige Weg von hier weg ist eine Leiter "
    "die die Spaeher auf die andere Seite gezogen haben! Dreckiges "
    "Stroh liegt am Boden und soll wohl Dein Bett sein. Auf der anderen "
    "Seite des Abgrunds wacht ein Spaeher.");
  AddDetail("boden","Der Boden ist harter Fels - bis auf die zweifel"
    "hafte Erleichterung eines dreckigen Strohhaufens.");
  AddDetail(({"vorsprung","felsvorsprung","fels"}),"Du stehst auf einem "
    "Felsvorsprung, hinter Dir ist nur eine kahle, senkrechte Wand, "
    "vor Dir ein gaehnender Abgrund.");
  AddDetail(({"wand","waende"}),"Hinter Dir ist eine kahle, steile "
    "Wand - alle anderen sind auf der anderen Seite.");
  AddDetail("seite","Auf der waerst Du gerne...");
  AddDetail("erleichterung","Es soll deinen Aufenthalt erleichtern.");
  AddDetail("aufenthalt","Den willst Du so schnell wie moeglich beenden.");
  AddDetail(({"stroh","haufen","strohhaufen"}),"Zusammengeschobenes, dreckiges "
    "Stroh liegt am Boden. Du bist anscheinend nicht der erste hier.");
  AddDetail("leiter","Die ist auf der Seite des Spaehers und er laesst "
    "sie sicher nicht zu Dir runter.");
  AddDetail("bett","Das kann nur ein schlechter Scherz sein!\nDu rufst: "
    "Spaeher, bring mir ein ordentliches Bett!\nDer Spaeher grinst Dich "
    "bloed aus der Ferne an.\n");
  AddDetail("scherz","Das Stroh ist ein Scherz.");
  AddDetail("burg","Du befindest Dich in der Burg.");
  AddDetail(({"ritter","kato","ritter kato"}), "Es ist seine Burg hier.");
  AddDetail("spaeher","Er lungert auf der anderen Seite herum und beobachtet "
    "Dich misstrauisch.");
  AddDetail("weg","Naja, Weg kann man nicht sagen. Aber wenigstens eine "
    "Leiter, ueber die man laufen kann...");
  AddDetail("decke","Du kannst hier keine Decke erkennen.");
  AddDetail("abgrund","Du kannst nicht bis ganz nach unten sehen ... also "
    "muss er ziemlich tief sein. Du willst das nicht testen muessen und "
    "gehst sicherheitshalber ein wenig von der Kante weg.");
  AddDetail("kante","Du blickst an der Kante runter und siehst einen vor"
    "stehenden Felsbrocken.");
  AddDetail(({"felsbrocken","brocken"}),"Er befindet sich in etwa einen "
    "halben Meter unter der Kante. Ob man sich daran festhalten koennte?");
  AddDetail("ferne","Dort ist nur der Spaeher.");
  

  
  AddCmd(({"spring","springe","huepfe","huepf"}),"spring");
  AddCmd(({"halt","halte"}),"halte");
  
}

int halte(string str)
{
  notify_fail("Woran moechtest Du dich festhalten?\n");
  if(!str || (str!="an fels fest" && str!="an brocken fest" &&
      str!="an felsbrocken fest")) return 0;
      
  tell_object(TP, BS("Du laesst Dich zu Boden fallen, waghalsig ueber die "
    "Kante rollen und haeltst Dich gerade noch mit einer Hand an dem "
    "Felsbrocken fest!\nDer Spaeher stoesst lautes, wilde Gebruell aus und "
    "gibt Alarm. Ploetzlich senkt sich die Leiter ueber Dir und der Spaeher "
    "rennt ausser sich vor Wut zu Dir rueber!\n\nSchnell ziehst Du Dich an "
    "der Leiter hoch, rennst auf die andere Seite und stoesst die Leiter in "
    "den Abgrund! Der Spaeher der Dir folgen wollte, faellt mit in den "
    "Abgrund.\n"));
  TP->move(ROOM+"bu1",M_GO,"ueber die Leiter","laeuft",
    "kommt ueber eine Leiter angelaufen");
  return 1;
}

int spring(string str)
{
  notify_fail("Wohin moechtest Du springen?\n");
  if(!str || (str!="rueber" && str!="ueber abgrund" && str!="auf andere seite"))
    return 0;
    
  tell_object(TP, "Das ist doch viel zu weit!!");
  return 1;
}
