inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "weide.h"

       
                             
create()
{
  ::create();

  
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"Auf einer gruenen Weide");
  SetProp (P_INT_LONG, "Du stehst mitten in einer Weide mit grasen"
    "den Schafen und Kuehen. Ein wenig gegangener Weg schlaengelt "
    "sich zwischen den sanften Huegeln durch und fuehrt weiter in "
    "die Weide. Im Suedosten kannst Du ein kleines Haus entdeck"
    "en.");

  STANDARD
  STANDARD1
  
  AddDetail("haus","Es ist ein Haus, genauso, wie es so oft in Maerchen "
    "beschrieben ist - ein kleines, lustiges Haus mit einem Strohdach "
    "und davor bluehen Flieder und Jasmin.");
  AddDetail("maerchen","Du glaubst doch wohl nicht mehr an sowas!"); 
  AddDetail("strohdach","Eine dicke Schichte aus gelbem Stroh bedeckt "
    "das Haus und schuetzt es vor Unwettern.");
  AddDetail("schichte","Ja, und zwar aus gelbem Stroh.");
  AddDetail("stroh","Er ist fast gelb und sicherlich strocken - Unwetter "
    "gibt es hier wohl wenige.");
  AddDetail("unwetter","Weit und breit ist keines zu sehen.");
  


  AddExit("norden",ROOM+"w6");
  AddExit("suedwesten",ROOM+"haus_gm");
  AddExit("suedosten",ROOM+"w4");  
  

}
