inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "weide.h"
#include "../../dorf/obj/ldfquest.h"

string lade_state();   
int spinne(string str);
int webe(string str);    

string garn();

                             
create()
{
  ::create();

  
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"Im Haus einer Weberin");
  SetProp (P_INT_LONG, "Um Dich herum liegt allerhand Zeugs, das Du "
    "auf den ersten Blick nicht identifizieren kannst. Offensichtlich "
    "bist Du in dem Haus einer Weberin. Ueberall liegen Stoffe, "
    "Naehutensilien und Baumwolle. In den Zimmerecken stehen zwei "
    "seltsam wirkende Maschinen. Weiter hinten steht ein Bett und "
    "daneben ein Nachtkaestchen.");
    
  AddDetail("zeugs","Du weisst nicht genau, worum es sich dabei "
    "handelt - also laesst Du es lieber in Ruhe.");
  AddDetail("haus","Darin stehst Du gerade.");
  AddDetail("stoffe","Viele Stoffe in den verschiedensten Farben "
    "und auch zerschnittene Fetzen liegen hier ueberall.");
  AddDetail("farben","Manche sind einfaerbig, manche gemustert.");
  AddDetail("fetzen","Naja...Fetzen. Halt Stoffreste.");
  AddDetail(({"reste","stoffreste"}), "Unfoermige, und zu nichts "
    "mehr zu gebrauchende Stoffreste.");
  AddDetail(({"utensilien","naehutensilien","naehzeugs"}), "Angefangen von "
    "Fingerhueten, einer Strickliesl, einem Garnknaeuel und einer ganzen Menge "
    "Knoepfe.");
  AddDetail(({"knaeuel","garnknaeuel"}), "Ein Knaeuel aus dickem Garn "
    "zusammengerollt.");
  AddDetail("garn",#'garn);
  AddDetail("knoepfe","Sie liegen verstreut herum - dass man hier "
    "den Ueberblick bewahren kann...");
  AddDetail("ueberblick","Schon hast Du ihn verloren.");
  AddDetail("boden","Der Boden ist mit einem gewobenem Teppich aus"
    "gelegt.");
  AddDetail("teppich","Du kannst ein Motiv erkennen.");
  AddDetail("motiv","Es stellt die Bruecke des Morgengrauens dar.");
  AddDetail("bruecke","Die schaust Du Dir am besten vor dem Haus " 
    "genauer an.");
  AddDetail("decke","Die Decke ist niedrig und bietet nichts Auf"
    "regendes zu entdecken.");
  AddDetail(({"hut","fingerhut","huete","fingerhuete"}), "Du "
    "kannst Dir wohl vorstellen, wozu man die kleinen silbernen "
    "Dinger braucht.");
  AddDetail("dinger","Die Fingerhuete meinst Du wohl.");
  AddDetail(({"strickliesl","liesl"}), "Du bist ein Held und gibst "
    "Dich nicht mit solchem Naehzeugs ab!");
  AddDetail("baumwolle","Die Baumwolle wird wohl zu Pullovern und "
    "Maenteln weiterverarbeitet.");
  AddDetail(({"maentel","pullover"}), "Sowas liegt hier nicht herum.");
  AddDetail(({"ecken","zimmerecken"}), "In zwei Ecken stehen Dir "
    "unbekannte Maschinen. In der dritten findest Du ein Bett und "
    "daneben ein Nachtkaestchen.");
  AddDetail("bett","Ein niedriges, einfaches Bett mit Nachtkaestchen.");
  AddDetail(({"kaestchen","nachtkaestchen"}), "Es ist aus hellem, "
    "gefasertem Holz und hat eine kleine Lade.");
  AddDetail("lade",#'lade_state);
  AddDetail("maschinen","Die eine ist vermutlich ein Webstuhl "
    "und die andere eventuell ein Spinnrad. Ausserdem befindet "
    "sich neben der Tuere eine Naehmaschine.");
  AddDetail("tuere","Die ist im Westen.");
  AddDetail("holz","Von welchem Baum es stammt kannst Du nicht sagen - "
    "es ist fuer die Quest aber wohl auch unwichtig.");
  AddDetail(({"baeume","baum"}),"Hier siehst Du nur gefaellte Baeume :)");
  AddDetail("quest","Es ist eine Quest, hier etwas zu finden...");
  AddDetail("ruhe","Die kann man nur fuehlen.");
  AddDetail(({"wand","waende"}),"Schlichte Waende - um nicht zu sagen "
    "fad.");
  AddDetail("blick","Hmm.... eigentlich auch auf den zweiten...");
  AddDetail(({"tretspinnrad","spinnrad","rad"}), "Es handelt sich hier um ein Tret"
    "spinnrad mit dem man sicher herrliche Faeden spinnen kann.");
  AddDetail(({"faden","faeden"}),"Aus vielen kleinen macht ein Spinnrad "
    "einen laengeren und festeren Faden.");                       
  AddDetail("webstuhl","Der Webstuhl besteht aus einem Gestell, zwei "
    "Walzen und dazwischen den Schaeften. Mit ihm laesst es sich sicherlich "
    "vortrefflich weben!");
  AddDetail("schaefte","Die Schaefte heben und senken sich wenn man "
    "den Webstuhl bedient.");
  AddDetail("gestell","Es dient als Aufhaengung der Walzen und Schaefte.");
  AddDetail("walzen","Auf die eine kommen die Faeden, auf die andere "
     "kommt dann der fertige Stoff.");
  AddDetail("stoff","Die zweite Walze ist derzeit leer.");
  
  
  AddItem(NPC+"weberin", REFRESH_DESTRUCT);
  
  AddCmd(({"spinn","spinne"}), "spinne");
  AddCmd(({"web","webe"}),"webe");
  AddExit("westen",ROOM+"w8");

  
}

int webe(string str)
{
  object ob;
  int ret;
  ob = deep_present("\nldfquest",TP);

  notify_fail("Was moechtest Du weben?\n");
  if(!str) return 0;
  
  if(str=="stoff")
  {
    if(deep_present("\nldfwollfaden",TP))
    {
      tell_object(TP, BS("Du setzt Dich an den Webstuhl und webst aus dem "
        "langen Wollfaden im Schweisse Deines Angesichts ein kleines "
	"Stueck Stoff, das in etwa in das Loch des Mantels passt."));
      ob = clone_object(OBJ+"stoff");
      ret = ob->move(TP);
      if(ret==ME_TOO_HEAVY)
      {
        tell_object(TP, BS("Der Stoff ist fuer Dich zu schwer."));
	ob->move(environment(TP));
      }
      ob = deep_present("\nldfwollfaden",TP);
      if(objectp(ob)) ob->remove();
      tell_object(TP, 
"\nAls die Weberin Dich motiviert am Webstuhl sitzen sieht, kramt sie etwas\n"
"hervor.\n"
"Die Weberin sagt: Wenn Du gegen Ritter Kato antrittst, habe ich etwas fuer\n"
"Die Weberin sagt: Dich. Hier hast Du Brot, das den Hunger stillt und Wasser,\n"
"Die Weberin sagt: das den Durst loescht.\n");
      
      ob = clone_object(OBJ+"brot");
      ret = ob->move(TP);
      if(ret==ME_TOO_HEAVY)
      {
        tell_object(TP, BS("Das Brot ist fuer Dich zu schwer."));
	ob->move(environment(TP));
      }
      ob = clone_object(OBJ+"wasser");
      ret = ob->move(TP);
      if(ret==ME_TOO_HEAVY)
      {
        tell_object(TP, BS("Das Wasser ist zu schwer fuer Dich."));
	ob->move(environment(TP));
      }
      

      return 1;
    }
    else
    {
      tell_object(TP, "Welchen Wollfaden willst Du denn weben?\n");
      return 1;
    }
  }
  return 0;
}

int spinne(string str)
{
  object ob;
  int ret;
  ob = deep_present("\nldfquest",TP);
  
  notify_fail("Was moechtst Du spinnen?\n");
  if(!str) return 0;
  
  if(str=="wolle"||str=="schafwolle")
  {
    if(deep_present("\nldfwolle",TP))
    {
      if(objectp(ob) && ob->frage_wert(WOLLE)==3) /*alles ok*/
      {
        tell_object(TP, BS("Du setzt Dich an das Spinnrad und nach "
	  "einigen klaeglichen Versuchen gelingt es Dir aus der "
	  "Wolle einen langen Faden zu machen."));
	ob = clone_object(OBJ+"wollfaden");
	ret = ob->move(TP);
	if(ret==ME_TOO_HEAVY)
	{
	  tell_object(TP, "Der Faden ist zu schwer fuer Dich.\n");
	  ob->move(environment(TP));
	}
	ob = deep_present("\nldfwolle",TP);
	if(objectp(ob)) ob->remove();
	return 1;
      }
      else /*wolle von anderem Spieler*/
      {
        tell_object(TP, BS("Wo kommt ploetzlich die Wolle her? Du wirfst sie "
	  "lieber weg."));
	ob = deep_present("\nldfwolle",TP);
	if(objectp(ob)) ob->remove();
	return 1;
      }
    }
    else /*keine wolle*/
    {
      tell_object(TP, BS("Du hast doch gar keine Wolle bei Dir."));
      return 1;
    }
  }
  return 0;
}
	
	


string lade_state()
{
  object ob;
  int val;
    ob = deep_present("\nldfquest",TP);
    if(objectp(ob))
    { 
      val = ob->frage_wert(FADEN);
      if(val==0)
      {
        ob->setze_wert(FADEN,1);
        
	ob->setze_wert(FADEN,1);
	ob = clone_object(OBJ+"faden");
	val = ob->move(TP);
	if(val==ME_TOO_HEAVY)
	{
	  ob->move(environment(TP));
	  return BS("Du untersuchst die Lade und entdeckst einen Naehfaden, "
          "den Du sofort an Dich nimmst. Der Faden ist fuer Dich nur zu schwer");
	}
	return BS("Du untersuchst die Lade und entdeckst einen Naehfaden, "
          "den Du sofort an Dich nimmst.");
      }
      else if(val ==1)
      {
        return BS("Du hast hier doch schon alles untersucht.");
      }
    }
}


string garn()
{
  object ob;
  int val;
  ob = deep_present("\nldfquest",TP);
  if(objectp(ob)) val = ob->frage_wert(GARN);
  if(val==1)
    return BS("Du hast doch das Garn schon gefunden.");
    
  tell_object(TP, BS("Als Du das Garn naeher untersuchen willst, stichst Du "
    "Dir in den Finger. Im Garn versteckt findest Du eine Naehnadel."));
  TP->reduce_hit_points(10);
  ob->setze_wert(GARN,1);
  ob = clone_object(OBJ+"nadel");
  val = ob->move(TP);
  if(val==ME_TOO_HEAVY)
  {
    tell_object(TP, "Die Nadel ist fuer Dich zu schwer.");
  }
  
  return "Du nimmst eine Nadel an Dich.\n";
}
  
    
    
    
    
