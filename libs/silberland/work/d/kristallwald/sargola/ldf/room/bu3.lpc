inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>

#include "../def.h"
#include "burg.h"


int schrecken(string str);

create()
{
  ::create();


  SetProp (P_LIGHT,0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));

  SetProp(P_INT_SHORT, "In einer finsteren Burg");
  SetProp(P_INT_LONG, "Dieser Gang ist heller als die anderen - und "
    "das liegt daran, dass sich im Norden eine Kueche befindet. Von "
    "dort stroemt auch ein angenehmer Geruch. Der dunkle Gang fuehrt "
    "weiter nach Osten und Westen.");



  STANDARD
  SOUNDS
  SMELLS

 AddItem(NPC+"mspaeher",REFRESH_DESTRUCT); 
 AddExit("osten",ROOM+"bu4");
 AddExit("westen",ROOM+"bu2");
 AddExit("norden",ROOM+"kueche");
}
