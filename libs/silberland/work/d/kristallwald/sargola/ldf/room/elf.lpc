inherit "std/npc";
inherit "std/orakel";

#include "../def.h"
#include <exploration.h>

string gilden_info();

void create()
{
  if (!is_clone(TO)) return;
  npc::create();
  
  SetProp(P_SHORT, "" );
  SetProp(P_LONG, BS(
    "Vor Dir sitz ein unglaublich alter Elf - zumindest sieht er so "
    "aus. Er wuerdigt Dich keines Blickes und starrt nachdenklich auf "
    "einen Stein am Boden. Er traegt ein einfaches Elfenhemd und eine "
    "ebenso schlichte Hose. Eigentlich wirkt er nicht so, als ob er "
    "das Oberhaupt einer Gilde sein koennte. Aber vielleicht Truegt "
    "der Schein ja. Sein Gesicht jedenfalls macht Dir klar, dass Du "
    "es hier mit einem erfahrenem Elf zu tun hast.	"));
  SetProp(P_NAME, "Molkine");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"molkine", "bartbinder", "molkine bartbinder", "hobbit"}));
  AddDetail( ({"haar", "haare", "straehnen", "straehne"}),
    "Molkines Haare sind haselnussbraun mit einigen grauen Straehnen.");

  create_default_npc(30);
  SetProp(P_HANDS, ({" mit vom Kampf geschulten Haenden", 300, DT_PIERCE}));
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 112);
  SetProp(P_ALIGN, 450);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 25);

  AddInfo(DEFAULT_INFO,
    ({"grinst Dich an.\n",
      "sagt: Was Du nicht sagst!\n",
      "sagt: Interessant!\n",
      "sagt: Unglaublich!\n",
      "gruebelt: Das ist mir unbekannt.\n",
      "dreht sich uninteressiert weg.\n",
      "lacht Dich aus.\n",
      "starrt Dich entsetzt an.\n",
      "kichert irre.\n",
      "sagt: Nie davon gehoert.\n",
      "fragt: Woher soll ich das wissen?\n",
      "gruebelt vor sich hin.\n",
      "schaut Dich erstaunt an.\n",
      "wirkt nicht so, als ob er wuesste, wovon Du redest.\n",
      "ist komplett perplex.\n",
      "laechelt verwirrt.\n",
      "schaut verlegen zur Seite.\n",
      "reisst die Augen vor Entzetzen auf!\n",
      "springt verschreckt zur Seite.\n"}) );
  //AddLibrary( NPC "infos.lib",1);
  
  AddInfo("sargola", "Sargola ist der weiseste aller Elfen.","sagt: ");



  AddInfo( ({"name", "hobbit", "molkine", "bartbinder", "molkine bartbinder"}),
    "Ich bin Molkine Bartbinder.", "sagt: ");
  AddInfo( ({"dolch", "langdolche"}),
    "Mit dem Langdolch kann ich sehr gut umgehen, wie fast jeder Hobbit.", 
    "sagt: ");



  AddInfo( ({"gilde", "hobbitgilde"}),
    "Dies ist die Elfengilde. Hier kannst Du Zaubersprueche lernen und "
    "Deine Stufe und Attribute erhoehen. Es gibt hier auch eine Liste mit "
    "allen Quests, die es im SilberLand zu loesen gibt.", "erklaert: ");
  AddInfo( ({"liste"}),
    "Gib mal 'liste' ein.", "raet Dir: ");
  AddInfo( ({"zaubersprueche", "zauberspruch"}),
    "Mach mal 'hilfe zaubern', dann weiss Du sofort mehr ueber die "
    "Zaubersprueche.", "sagt: ");
  AddInfo( ({"blitz", "schaetz", "identifiziere", "pfeil", "feuerball",
             "ausweichen", "schnell"}),
    "Wenn Du mehr ueber die einzelnen Zaubersprueche erfahren willst, "
    "dann mach mal hilfe <zauberspruch>.", "erklaert: ");
  AddInfo( ({"stufe", "stufenpunkte"}),    
    "Wenn Du genuegend Stufenpunkte hast, kannst Du hier Deine Stufe "
    "erhoehen.", "sagt: ");
  AddInfo( ({"erhoehen"}),
    "Du kannst hier Deine Stufe und Deine Attribute erhoehen.", "sagt: ");
  AddInfo( ({"attribute", "attributpunkte", "attributpunkt", "attributen"}),
    "Du kannst hier Deine Attribute erhoehen. Fuer je einen Attributpunkt "
    "bekommst Du einen Punkt bei Kraft, Geschicklichkeit, Ausdauer oder "
    "Intelligenz dazu.", "erklaert: ");
  AddInfo( ({"staerke", "kraft", "koerperkraft"}),
    "Je mehr Staerke Du hast, desto mehr Schaden machst Du beim Kaempfen, "
    "und Du kannst auch mehr Sachen tragen. Es gibt auch viele Waffen, die "
    "man nur mit grosser Koerperkraft zuecken kann.", "erklaert: ");
  AddInfo( ({"geschicklichkeit", "geschick"}),
    "Mit Geschicklichkeit kannst Du Angriffen ausweichen. Auch fuer die "
    "Verwendung von Waffen ist das Geschick sehr wichtig.", "erklaert: ");
  AddInfo( ({"ausdauer", "konstitution", "lebenspunkte"}),
    "Je groesser Deine Ausdauer, desto mehr Lebenspunkte hast Du.", 
    "erklaert: ");
  AddInfo( ({"intelligenz", "magie", "magiepunkte"}),
    "Je groesser Deine Intelligenz, desto mehr Magiepunkte hast Du.",
    "erklaert: ");
  AddInfo(({"aufgabe", "aufgaben", "abenteuer", "quests", "quest", "questen"}),
    "@@all_quests@@", "sagt: ");
  AddInfo(ME->QuestIDs(), symbol_function("quest_info",ME), "sagt: "); 
  AddInfo(({"faehigkeiten", "zaubern"}), "@@gilden_info@@");

  SetProp(P_LOG_INFO, 1);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" sagt: Vielen Dank, aber ich habe alles was ich brauche.\n"
    +Name(WER,1)+" gibt Dir @WEN wieder zurueck.\n" }) );

  SetProp(P_SPELLRATE,90);
  AddSpell(1,600,
    Name(WER,1)+" wirft einen gewaltig grossen Feuerball auf Dich.\n",
    Name(WER,1)+" wirft einen gewaltig grossen Feuerball auf @WEN.\n",    
    DT_FIRE, ([SP_SHOW_DAMAGE:1]) );
  AddSpell(1,300,
    Name(WER,1)+" wirft einen magischen Pfeil auf Dich.\n",
    Name(WER,1)+" wirft einen magischen Pfeil auf @WEN.\n",    
    DT_MAGIC, ([SP_SHOW_DAMAGE:1]) );
  SetAttackChats(5, ({
    Name(WER,1)+" schaetzt Dich erfolgreich ein.\n",
    Name(WER,1)+" identifiziert Dich.\n",
    Name(WER,1)+" bewegt sich ploetzlich viel schneller.\n",
    Name(WER,1)+" fuchtelt wild mit seinen Haenden herum.\n"}) );

  SetChats(2, ({
    Name(WER,1)+" sagt: Hier kannst Du Deine Stufe erhoehen.\n",
    Name(WER,1)+" sagt: Hier kannst Du neue Zaubersprueche lernen.\n",
    Name(WER,1)+" sagt: Hier kannst Du Deine Attribute erhoehen.\n",    
    Name(WER,1)+" sagt: Kannst Du schon den Feuerball-Zauber?\n",
    Name(WER,1)+" sagt: Kannst Du schon den Pfeil-Zauber?\n",
    Name(WER,1)+" sagt: Kannst Du schon den Schaetz-Zauber?\n",
    Name(WER,1)+" sagt: Kannst Du schon den Blitz-Zauber?\n",
    Name(WER,1)+" sagt: Kannst Du schon den Identifiziere-Zauber?\n",
    Name(WER,1)+" sagt: Kannst Du schon den Ausweichen-Zauber?\n",
    Name(WER,1)+" sagt: Kannst Du schon den Schnell-Zauber?\n",
    Name(WER,1)+" sagt: Du kannst mich nach Deinen Faehigkeiten fragen.\n",
    Name(WER,1)+" fragt Dich: Wieviele Quests hast Du schon geloest?\n",
    Name(WER,1)+" sagt: Ich kann Dir viel ueber Quests verraten.\n",
    Name(WER,1)+" sagt: Wenn Du eine Quest loest, bekommst Du viel Erfahrung!\n",
    Name(WER,1)+" sagt: Elessar ist so eine schoene Stadt.\n",
    Name(WER,1)+" erleuchtet mit einem hellen Blitz kurzfristig den Talan.\n",
    Name(WER,1)+" schaetzt Dich erfolgreich ein.\n",
    Name(WER,1)+" identifiziert Dich.\n"}) );

  SUID;
  CLONEME("/p/armour/rock");
  CLONEME("/p/armour/bluse");
  CLONEME("/p/armour/lederschuhe");
  command("trage alles");
  CLONEME("/p/weapon/langdolch");
  command("zuecke dolch");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( !adverb ) adverb ="\b";
  if (find_call_out("react")!= -1) return;
  if( (gruppe=="fies" || gruppe=="frech") && random(2) )  
    call_out("fies",0);
  if( gruppe=="intim" || gruppe=="nett" )
    call_out("react",0, "knuddelt Dich "+adverb+".", "knuddelt "+
      TP->name(WEN)+".");
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    if( TP->QueryProp(P_RACE)!="Hobbit" && !IS_WIZARD(TP) )
      tell_room(MENV, Name(WER,1)+" sagt: Verschwinde, das ist die Gilde "
        "der Hobbits!\n");
    else
    {
      tell_object(TP, BS(Name(WER, 1) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
    }
  }
}

void fies()
{
  if (present(TP, ENV(TO))) 
    tell_room(MENV, Name(WER,1)+" sagt: Hoer auf so gemein zu sein, "+
      TPN+"!\n");
  else
    tell_room(MENV, Name(WER,1)+ " aergert sich ueber "+TPN+".\n");
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

int Defend(int dam, mixed dam_types, mixed spell, object enemy)
{
  if(!random(3) )
  {
    tell_room(MENV, Name(WER,1)+" weicht dem Angriff geschickt aus.\n");
    ::Defend(dam/5, dam_types, spell, enemy);
  }
  else
    ::Defend(dam, dam_types, spell, enemy);
}

void reset()
{ 
  ::reset();
  if(!is_clone(this_object())) return ;
  // Quest Infos aktualisieren
  // (koennte ja ne neue Quest angeschlossen worden sein ;) )
  AddInfo(ME->QuestIDs(), symbol_function("quest_info",ME), "sagt: ");
}

string a2s(int abil)
{
  switch (abil)
  {
    case 0..999 : return "hundsmiserabel schlecht";
    case 1000..1499 : return "miserabel";
    case 1500..1999 : return "uebel";
    case 2000..2499 : return "unheimlich schlecht";
    case 2500..2999 : return "sehr schlecht";
    case 3000..3499 : return "schlecht";
    case 3500..3999 : return "maessig";
    case 4000..4499 : return "unterdurchschnittlich";
    case 4500..4999 : return "durchschnittlich";
    case 5000..5499 : return "ueberdurchschnittlich";
    case 5500..5999 : return "befriedigend";
    case 6000..6499 : return "sehr befriedigend";
    case 6500..6999 : return "recht gut";
    case 7000..7499 : return "ganz gut";
    case 7500..7749 : return "gut";
    case 7750..7999 : return "wirklich gut";
    case 8000..8249 : return "sehr gut";
    case 8250..8499 : return "unglaublich gut";
    case 8500..8749 : return "ausserordentlich gut";
    case 8750..8999 : return "phantastisch gut";
    case 9000..9249 : return "ausgezeichnet";
    case 9250..9499 : return "hervorragend";
    case 9500..9749 : return "beinahe meisterhaft";
    case 9750..9899 : return "meisterhaft";
    case 9900..9999 : return "beinahe perfekt";
    default : return "perfekt";
  }
}

string gilden_info()
{
  string gilde, info, *spells;
  int abil, i, n;
  closure qsa;

  gilde = "/gilden/" + (PL->QueryProp(P_GUILD) || "abenteurer");
  if( gilde!="/gilden/abenteurer" ) 
    return "sagt: Ich kenn mich nur in der Abenteurergilde aus!\n";
  if( PL->QueryProp(P_RACE)!="Hobbit" );
    return "sagt: Du bist ja gar kein Hobbit!\n";
  if (find_object(gilde))
  {
    qsa = symbol_function("QuerySkillAbility", PL);
    spells = sort_array(
        m_indices(gilde->QueryProp(P_GUILD_SKILLS)), #'< );

    n = 0;
    info = "sagt: Hm... wollen mal sehen...\n";
    for (i=sizeof(spells)-1, abil=0; i>=0; i--) {
      if (abil=funcall(qsa, spells[i]))
      {
        info += sprintf(Name(WER,1)+" sagt: Du beherrschst '%s' %s.\n",
                        spells[i], a2s(abil));
        n++;
      }
    }
    if (!n)
      return "sagt: Ohje "+PL->name()+", Du kannst ja kein bisschen zaubern!\n";
    info += sprintf(Name(WER,1)+" sagt: Insgesamt gesehen bist Du %s.\n",
                a2s(gilde->GuildRating(PL) * 10000 / gilde->MaxGuildRating()));
    return info;
  }
  else
    return "fragt: In was fuer einer Gilde bist DU denn??\n";
}

