inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "stollen.h"

       
                             
create()
{
  ::create();

  
  SetProp (P_LIGHT,0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"In einem finsteren Stollen");
  SetProp (P_INT_LONG, "Du stehst in einem finsteren Stollen, in dem "
    "Du gerade aufrecht stehen kannst. Vor Dir gaehnt wie ein schwarz"
    "es Loch der Stollen und schlaengelt sich weiter. Hinter Dir war "
    "die Oeffnung nach Draussen... Nur ist die nun wieder zu. Lang "
    "hat der Klang nicht geholfen.");
    
  AddDetail("loch","Es ist der Stollen, der weiter in den Berg " 
    "fuehrt.");
  AddDetail("oeffnung","Die war genau im Sueden und nun ist sie weg...");
  AddDetail("klang","Der ist leider viel zu schnell verpufft und nun "
    "bist Du eingesperrt!");
  AddDetail("draussen","Draussen waere es jetzt gemuetlicher.");

  STANDARD

  AddExit("norden",ROOM+"st2");

}
