inherit "std/pub";

#include <properties.h>
#include "../def.h"
#include "weide.h"

int oeffne(string str);       
                             
create()
{
  ::create();

  
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:25]));
  SetProp (P_INT_SHORT,"Bei Nonnos Grossmutter");
  SetProp (P_INT_LONG, "Du befindest Dich in einem einfach eingerichteten, "
    "aber gemuetlich wirkenden Haus. Durch das offene Fenster hoert man draussen "
    "die Schafe und Kuehe. Klumpige Holzdielen bilden den Boden. Eine Truhe "
    "in der Ecke faellt Dir auf. An der Wand faellt Dir eine Tafel auf.");
  AddDetail("tafel","Du kannst sie lesen.");
  AddReadDetail("tafel","Sei willkommen, edler Wanderer und labe Dich an "
    "unseren Speisen.");
  AddDetail("boden","Der ist einfach mit Holz ausgelegt.");
  AddDetail("holz","Es sind schwere Holzdielen die den Boden bilden.");
  AddDetail(({"holzdielen","dielen"}),"Sie bilden den Boden.");
  AddDetail("decke","Die Decke ueber Dir besteht aus trockenem Stroh.");
  AddDetail("stroh","Es ist schon fast gelb - wohl vom Licht ausgebleicht.");
  AddDetail("licht","Es stroemt durch die Fenster ins Haus hinein.");
  AddDetail("ecke","Welche meinst Du? Aber in einer steht eine Truhe.");
  AddDetail("truhe","Es ist eine grosse, schwere Truhe mit einem extra"
    "grossen Schloss davor. Auf ihr steht ein Bildnis eines Maedchens.");
  AddDetail("bildnis","Es stellt ein Maedchen dar und drunter steht: \"Lisa\".");
  AddDetail("maedchen","Es wirkt recht huebsch und in jugendlichem Alter.");
  AddDetail("alter","Das sieht man ihr nicht an.");
  AddDetail("lisa","Frag doch Grossmutter mal.");
  AddDetail("wand","Die sind auch aus einfachem Holz.");
  AddDetail("schloss","Es ist fuer die Truhe fast schon ueberdimensioniert. "
    "Seltsam eigentlich ...");
  AddDetail("haus","Es wirkt von innen gemuetlich und einladend durch die "
    "offenen Fenster.");
  AddDetail("fenster","Es sind eigentlich nur Oeffnungen nach draussen.");
  AddDetail("oeffnungen","Sie lassen das Licht von draussen ins Haus herein "
    "und bringen so eine romantische Stimmung, die Dich an Deine Grossmutter "
    "erinnert.");
  AddDetail("stimmung","Hier moechtest Du noch laenger verweilen.");
  AddDetail(({"schafe","kuehe"}),"Die beobachtest Du besser von der Naehe.");
  AddDetail("naehe","Du bist zu weit weg.");
 
  AddSound(DEFAULT_SOUND, "Die Voegel zwitschern draussen auf der Weide.");
  AddSound("voegel","Geh lieber nach draussen - dort hoert man sie besser.");
  AddSound("weide","Weiden hoert man in Haeusern normal nicht so gut.");
 
  AddDrink("Bachwasser", ({"bachwasser", "wasser"}),
           2, ({2,2}), 0, 2,
           ({
             BS("Nonnos Grossmutter bringt Dir ein Glas frisches Bachwasser."),
             "&& trinkt ein Glas frisches Bachwasser."})); 

  AddDrink("Buttermilch", ({"milch", "buttermilch"}),
           56, ({12,30}), 0, 8,
           ({"Nonnos Grossmutter serviert Dir ein leicht ranziges Glas Buttermilch.",
		"&& schluerft ein ranziges Glas Buttermilch."}));
		
  AddDrink("Hollersaft", ({"saft", "hollersaft"}),
           56, ({12,30}), 0, 8,
           ({"Nonnos Grossmutter macht Dir ein Glas mit Hollersaft.",
		"&& bekommt ein Glas mit Hollersaft."}));
		
  AddDrink("Huettenschnaps", ({"schnaps", "huettenschnaps"}),
           100,20,15,3,
           ({"Nonnos Grossmutter schenkt Dir ein Stamperl Huettenschnaps ein.",
		"&& bekommt ein Stamperl Huettenschnaps eingeschenkt."}));


 AddFood("Butterbrot", ({"brot","butterbrot"}),
	29,11,6,
	({"Du bekommst ein riesiges Butterbrot von Nonnos Grossmutter.",
	"Nonnos Grossmutter bringt && ein riesiges Butterbrot."}) );


  AddFood("Lammkotlett",({"kotlett","lammkotlett"}),
  	288, ({35,49}),16,
  	({"Du bekommst ein safties Lammkotlett mit viel Fett!",
  	"&& bekommt ein saftiges Lammkotlett mit viel Fett."}) );
 
  RemoveItem("/obj/topliste");
  AddExit("nordosten",ROOM+"w5");
  AddItem(NPC+"grossm", REFRESH_DESTRUCT);
  AddCmd("oeffne","oeffne");
  

}

int oeffne(string str)
{
  notify_fail(BS("Du darfst die Truhe nicht oeffnen! Ausserdem hast Du keinen "
    "Schluessel!"));
  if(str=="truhe") return 0;
  else 
  {
    notify_fail("Was moechtest Du oeffnen?\n");
    return 0;
  }
}
