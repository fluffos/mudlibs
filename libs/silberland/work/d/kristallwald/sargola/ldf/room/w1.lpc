inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "weide.h"

       
                             
create()
{
  ::create();

  
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"Auf einer gruenen Weide");
  SetProp (P_INT_LONG, "Im Nordosten endet der gepflegte und von "
    "Hand angelegte Rosengarten und veraendert sich im Suedwesten "
    "in eine wilde Weide. Sanft geschwungene Huegel zwischen "
    "denen sich ein einfacher, nicht sehr ausgepraegter Weg "
    "schlaengelt bestimmen die Umgebung hier.");

  STANDARD
  STANDARD1
  
  AddDetail("hand","Der Rosengaertner hat schon ordentliche Arbeit "
    "verrichtet.");
  AddDetail("rosengaertner","Er steckt sicher irgendwo im Rosen"
    "garten.");
  AddDetail("rosengarten","Der befindet sich nordoestlich von Dir.");
  AddDetail("umgebung","Du meinst die Weiden?");

  AddExit("suedwesten",ROOM+"w2");
  AddExit("nordosten",ROOM+"r5");  
}
