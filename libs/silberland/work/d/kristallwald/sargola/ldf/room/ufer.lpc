inherit "std/room";

#include <properties.h>
#include "../def.h"

int schwimme(string str);

                             
create()
{
  ::create();


  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"An einem Ufer");
  SetProp (P_INT_LONG, "Du stehst neben einer steil aufragenden "
    "Felswand an einem Ufer. Der See reicht bis zwei Meter an die "
    "Felswand heran und ist tiefschwarz. Leichte Wellen kraeuseln "
    "seine Oberflaeche. Boot oder aehnliches kannst Du nicht ent"
    "decken.");
    
  AddDetail("boden","Der Boden besteht aus feuchter Erde, zum Ufer "
    "hin wird sie immer schlammiger.");
  AddDetail("erde","Die Erde hier ist feucht und wird zum Ufer hin "
    "immer schlammiger. Sie ist wie auch das Wasser des Sees schwarz.");
  AddDetail("wasser","Es wirkt ziemlich dunkel und kraeuselt leicht "
    "die Oberflaeche. Vielleicht wirkt es auch nur so dunkel, weil "
    "es ueberhaupt dunkel ist. Aber das ist nicht allein der Grund.");
  AddDetail("grund","Den weisst Du nicht genau.");
  AddDetail("oberflaeche","Die Oberflaeche des Sees ist bis auf einige "
    "kleine Wellen ruhig.");
  AddDetail("see","Vor Dir liegt ein grosser, dunkler See. Du kannst "
    "das andere Ufer von hier aus nicht sehen.");
  AddDetail("ufer","Zum einen gibt es das, auf dem Du gerade stehst, "
    "zum anderen gibt es das Ufer auf der anderen Seite. Was wohl "
    "dort auf Dich warten mag?");
  AddDetail("boot","Sowas siehst Du hier nicht ... Du wirst schwimmen "
    "muessen.");
  AddDetail("wellen","Sie sind kaum zu sehen und schlagen sanft ans "
    "Ufer.");
  AddDetail("himmel","Der Himmel liegt friedlich und blauschwarz ueber "
    "Dir. Du kannst keine Sterne erkennen. Undeutlich kannst Du Voegel "
    "am Himmel erkennen.");
  AddDetail("voegel","Es scheinen schwarze Raben zu sein. Wieder "
    "schwarz ... hmm, Dich wundert schoen langsam nichts mehr. Sie "
    "fliegen weite Kreise um den See und singen ein trauriges Lied.");
  AddDetail("raben","Es muessten Raben sein - aber sie sind so weit "
    "weg, sicher bist Du Dir nicht.");
  AddDetail("kreise","Die Raben ziehen Kreise.");
  AddDetail("lied","Lausch doch mal!");
  AddDetail("sterne","Es sind einfach keine zu sehen.");
  AddDetail(({"wand","felswand"}),"Sie ragt steil nach oben.");
  AddDetail("seite","Du stehst gerade auf der einen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst den Tang und die Algen des Sees.");
  AddSmell(({"tang","algen"}),"Hier am Ufer riecht es nach Algen.");
  AddSound(DEFAULT_SOUND, "Du hoerst den Schmied im Westen haemmern und "
    "die Wellen sanft ans Ufer schlagen.");
  AddSound("schmied","Er haemmert fest auf irgendwas herum.");
  AddSound("wellen","Sie schlagen sanft ans Ufer.");
  AddSound("wasser","Es macht kleine plaetschernde Wellen.");
  AddSound(({"voegel","raben"}),"Sie singen ein unendlich trauriges "
    "Lied.");
  AddSound("lied","Sie beklagen etwas ... ob der Schmied mehr weiss?"); 

  AddCmd(({"schwimm","schwimme"}),"schwimme");
  AddExit("westen",ROOM+"hschmied");
}

int schwimme(string str)
{
  notify_fail("Wohin moechtest Du schwimmen?\n");
  if(!str || (str!="durch see" && str!="durch" && 
      str!="see" && str!="rueber" && str!="ans andere ufer" && str!="zur burg")) return 0;
  
  tell_object(TP, 
	"Du wirfst Dich furchtlos in die Wellen und schwimmst durch das kalte Wasser\n"
	"auf die andere Seite. Erschoepft kommst Du an.\n");
  TP->reduce_hit_points(10);
  TP->move(ROOM+"ufer1",M_GO,"durch den See","schwimmt","kommt angeschwommen");
  return 1;
}
