inherit "std/room";

#include <properties.h>
#include "../def.h"
#include "dwald.h"

int norden();
int osten();
int schaerfe(string str);
                       
create()
{
  ::create();

  
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT,"Im dunklen Wald");
  SetProp (P_INT_LONG, "Du stehst im dunklen Wald. Und der hat seinen "
    "Namen nicht von ungefaehr. So ziemlich alles, was Du hier siehst "
    "ist duester und dunkel. Du kannst nicht erkennen, ob es Tag oder "
    "Nacht ist. Ueberall um Dich herum siehst Du dunkle, fast schwarze "
    "Baeume.");
  
  AddDetail(({"tag","nacht"}),"Es scheint zwar ein Licht, ob das von "
    "der Sonne oder dem Mond kommt, kannst Du nicht sagen.");
  

  STANDARD
  SOUND
  SMELL

  AddSpecialExit("norden","norden");
  AddExit("osten",ROOM+"dw4");
  AddItem(NPC+"spaeher",REFRESH_DESTRUCT);
  AddCmd(({"schaerfe","schaerf"}),"schaerfe");


  

}

int norden()
{
  if(TP->InFight())
  {
    notify_fail("Du kannst Dich nicht an dem Spaeher vorbeizwaengen.\n");
    return 0;
  }
  return TP->move(ROOM+"dw5",M_GO);
}


SINNE
