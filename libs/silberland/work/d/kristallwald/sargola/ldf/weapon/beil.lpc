inherit "std/weapon"; 
#include <properties.h> 
#include <combat.h> 
 
create() 
{ 
  if (!is_clone(this_object())) return; 
  ::create(); 
  SetProp(P_SHORT,"Ein blutiges Beil"); 
  SetProp(P_LONG, 
        "Das Beil ist schon laenger "
       "im Einsatz, das erkennt man muehelos an dem vielen Blut und den "
       "kleinen Federn, die daran kleben.\n"); 
  SetProp(P_NAME, "Beil"); 
  AddId( ({"beil" })); 
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, NEUTER); 
  SetProp(P_WC, 151);         
  SetProp(P_WEIGHT, 2000);      // in gramm 
  SetProp(P_VALUE, 700);       // 70<WC<100 ->   Preis = 5*WC 
 
  SetProp(P_WEAPON_TYPE, WT_AXE); 
  SetProp(P_NR_HANDS, 1); 
  
  AddDetail("federn","Wo die jetzt fehlen magst Du sicher nicht wissen.");
  AddDetail("blut","Es ist schon eingetrocknet.");
  AddDetail("einsatz","Das Beil ist schon lange im Einsatz.");
}
 
