inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId( ({"speer"}) );
  SetProp (P_SHORT, "Ein schwarzer Speer");
  SetProp (P_LONG,
    "Ein langer Speer der sich herrlich zum Aufspiessen eignet. "
    "Er besteht eigentlich nur aus einem langen Holzstueck mit einer "
    "metallenen Spitze. Das Holzstueck ist kohlrabenschwarz.");
  AddDetail("aufspiessen","Pass nur auf, dass Du da nicht mal drauf "
    "aufgespiesst bist.");
  SetProp (P_NAME, "Speer");
  SetProp (P_GENDER, MALE);

  SetProp (P_VALUE, 600);
  SetProp (P_WEIGHT, 1000);
  SetProp (P_WEAPON_TYPE, WT_SPEAR);
  SetProp (P_DAM_TYPE, DT_PIERCE);
  SetProp (P_WC, 95);
  SetProp (P_WC_FIXFACTOR, 0.2);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_QUALITY_DECAY, 80 );
  SetProp (P_MATERIAL, ([MAT_ASH_WOOD:80, MAT_IRON:20]) );
}

