inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein besonderes Schwert");
  AddAdjective("besonderes");
  SetProp(P_LONG,  
    "Das ist ein besonderes Schwert von dem Schmied im Berg. Er "
    "hat Tag und Nacht an ihm geschmiedet um es zu haerten. Nun "
    "kann man damit Stein schneiden. Und auch das Herz von Ritter "
    "Kato ...");
  AddDetail("schmied","Es ist vom Schmied hergestellt worden.");
  AddDetail("berg","Der Schmied wohnt im Berg.");
  AddDetail(({"tag","nacht"}), "Er hat lange an dem Schwert geschmieded.");
  AddDetail("stein","Das Schwert soll Stein schneiden koennen.");
  AddDetail("herz","Mit diesem Schwert kann man - wenn es schon "
    "Stein schneiden kann - auch das Herz von Ritter Kato treffen.");
  AddDetail(({"ritter","kato","ritter kato"}), "Den triffst Du "
    "schon frueh genug.");
  
  SetProp(P_NAME, "Schwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schwert","\nldfschwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 180);
  SetProp(P_WC_FIXFACTOR, 0.2);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL:90, MAT_MAGIC:10]) );
  SetProp(P_WEIGHT, 2300);
  SetProp(P_VALUE, 2000);
}

