inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine schwarze Lanze");
  SetProp(P_LONG,  
    "Die Lanze besteht aus einem langen, schwarzen Holzstab mit einer "
    "metallenen Spitze mit zwei scharfen Schneiden.");
  SetProp(P_NAME, "Lanze");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"lanze"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 170);
  SetProp(P_WC_FIXFACTOR, 0.2);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL:10, MAT_OAK:90]) );
  SetProp(P_WEIGHT, 3300);
  SetProp(P_VALUE, 2000);
  SetProp(P_QUALITY_DECAY, 90);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:8, P_SIZE:155]) );  
}

