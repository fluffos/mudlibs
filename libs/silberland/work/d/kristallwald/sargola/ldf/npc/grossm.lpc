inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"
#include "../../dorf/obj/ldfquest.h"


string geschenk();
string mantel();

create()
{
     if (!is_clone(TO)) return;  
     ::create();   
       
     SetProp(P_SHORT, "Die Grossmutter von Nonno");  
     SetProp(P_LONG, BS("Die Grossmutter von Nonno traegt ein durch einfache "
       "Strickmuster verziertes Gewand, das gewoehnlich die Hirten tragen. Ihre "
       "Haare sind trotz des Alters dunkel, fast schwarz und ihre Augen ebenfalls. "
       "Sie strahlen eine seltsame Traurigkeit aus."));
     AddDetail(({"muster","strickmuster"}),"Sie stellen groessere und kleinere "
       "Herden von Schafen und Kuehen dar.");
     AddDetail("gewand","Es ist das traditionelle Leinenkleid, das oft von Hirten "
       "getragen wird.");
     AddDetail(({"kleid","leinenkleid"}), "Obwohl es nur Leinen ist, erfuellt es "
       "wohl gut seinen Zweck.");
     AddDetail("haare","Ihre Haare sind recht dunkel, um nicht zu sagen schwarz.");
     AddDetail("augen","Auch die Augen von Nonnos Grossmutter wirken traurig auf "
       "Dich.");
     AddDetail("traurigkeit","Die sieht man ihr deutlich an.");
     
     
     
    
     SetProp(P_GENDER, FEMALE);  
     SetProp(P_NAME,"Grossmutter");  
     AddId (({ "mutter","grossmutter", "oma"}));  
     create_default_npc (7);  
     SetProp(P_HANDS, ({" mit schwachen Haenden", QueryProp(P_HANDS)[1], DT_BLUDGEON}));  
   
     SetProp(P_RACE, "Mensch");  
     SetProp(P_ALIGN, 850); 
     SetProp(P_SIZE, 170);
     SetProp(P_BODY, 80);
     SetProp(P_XP, 0);		//Quest-NPC :)
     SetProp(P_REJECT,
       ({REJECT_GIVE,"Die Grossmutter kann so etwas nicht brauchen.\n"}) );


     AddInfo("speisen","Tipp doch einfach mal \"menue\".","sagt: ");
     AddInfo("wanderer","Hin und wieder kehren Wanderer bei mir ein.","sagt: ");
     AddInfo(({"pferd","miramis"}),"Ein herrliches Pferd, nicht wahr? Mit ihm kann "
       "man schnell reiten und sicher weit springen!","sagt: ");
     AddInfo(DEFAULT_INFO,
     	"Da kann ich Dir leider nicht weiterhelfen.","sagt: ");
     AddInfo("sargola","Auch er konnte mir noch nicht helfen.","seufzt: ");
     
     AddInfo("dschinn","Ich habe gehoert, es soll so etwas geben.",
        "denkt scharf nach: ");
     AddInfo(({"vogel", "voegel"}), "Ich mag Voegel ... sie vertreiben mir "
       "meine Traurigkeit.","seufzt: ");
     
     AddInfo("koenig","Der Koenig ist im Grunde auch machtlos.", "seufzt: ");
     AddInfo("silberland","In alten Maeren erzaehlt man sich davon. Ich weiss "
       "es besser - es existiert!", "schildert: ");
     AddInfo("maeren","Du musst ja nicht daran glauben - ich tue es!","sagt: ");
     AddInfo(({"land","land der ferne","ferne"}),
       "Das ist hier ueberall.", "sagt: ");
     AddInfo(({"daecher", "dach"}), "Ich liebe es unter dem Stroh zu schlafen.",
       "sagt vertraeumt: ");
     AddInfo("mantel",#'mantel);
     AddInfo("stroh","Damit ist unser Dach gedeckt.","erklaert: ");
     AddInfo("traurigkeit","Ach ... es geht um Lisa.","sagt: ");
     AddInfo("lisa","Sie war meine Lieblingsenkelin. Oft kam sie mich hier be"
       "suchen und begleitete Nonno oft wenn er bei den Tieren war.","schluchzt: ");
     AddInfo("tiere","Nonno passt immer auf sie auf.","sagt: ");
     AddInfo(({"enkelin","lieblingsenkelin"}), "Bis sie eines Tages von Ritter "
       "Kato entfuehrt wurde! Sehr viele wurden entfuehrt und waren nie mehr "
       "gesehen. Aber von Dir hab ich gehoert, dass Du gegen ihn antreten "
       "wirst. Wenn Du das tust, habe ich ein Geschenk fuer Dich.","schluchzt: ");
     AddInfo("geschenk",#'geschenk);
     AddInfo("nonno","Er wird sicherlich auf der Weide sein und auf die Tiere "
       "aufpassen.","sagt: ");
     AddInfo("weberin","Sie wohnt weiter im Norden glaube ich.");
     AddInfo("spaeher","Das sind die Diener von Ritter Kato.","sagt: ");
     AddInfo(({"ritter","kato","ritter kato"}), "Er lebt jenseits der Bruecke "
       "des Morgengrauens und ist durch und durch boese.", "sagt: ");
     AddInfo("bruecke","Sie ist im Norden und in der Mitte klafft ein grosses "
       "Loch.", "sagt: ");
     AddInfo("mitte","In der Mitte der Bruecke.", "sagt: ");
     AddInfo("loch","Na was das ist, weiss Du sicher.", "sagt: ");
     AddInfo(({"kuehe","kuh","schafe","schaf"}), "Auf die passt Nonno auf.", "sagt: ");
     AddInfo("truhe","Ach, in der bewahre ich meine Habseligkeiten auf.","sagt: ");
     AddInfo("habseligkeiten","Nur ein paar Erinnerungsstuecke aus meiner "
       "Vergangenheit.","sagt: ");
     AddInfo(({"stuecke","erinnerungsstuecke"}), "Fuer Dich wertloes Stuecke.", "sagt: ");
     AddInfo("weide","Die liegt vor meinem Haus.","erklaert: ");
     AddInfo("haus","Wir stehen gerade darin.","grummelt: ");
     



     
     
       
     SetChats(3, ({
	"Die Grossmutter schluchzt.\n",
	"Die Grossmutter faselt leise was von \"Lisa\".\n",       
	"Die Grossmutter blickt Dich traurig an.\n",
	"Die Grossmutter wirft sich ein Stamperl ein.\n",
	"Die Grossmutter bietet Dir ein Butterbrot an.\n"}) );
} 

string mantel()
{
  object ob;
  int a;
  ob = deep_present("\nldfquest",TP);
  if(objectp(ob)) a = ob->frage_wert(MANTEL);
  
  if(a==0)
  {
     return BS("sagt: Darueber weiss ich nichts.\n");
  }
  else
  {
    return "sagt: Du hast doch schon einen von mir bekommen.\n";
  }
}

string geschenk()
{
  int a;
  object ob;
  ob = deep_present("\nldfquest",TP);
  if(objectp(ob)) a = ob->frage_wert(MANTEL);
  
  if(a==0)
  {
    tell_object(TP,
"Die Grossmutter schlapft zur Truhe, oeffnet sie kurz und holt was hervor.\n"
"Die Grossmutter sagt: Ich habe fuer Dich einen Mantel - er gehoerte einmal\n"
"Die Grossmutter sagt: Lisa und soll nun Dir dienen. Er ist aus\n"
"Die Grossmutter sagt: Mondscheingewebe! Achte gut auf ihn. Die schwarzen\n"
"Die Grossmutter sagt: Spaeher koennen Dich mit dem Mantel kaum sehen! Obwohl\n"
"Die Grossmutter sagt: er leider ein Loch hat. Damit ist er natuerlich nicht zu\n"
"Die Grossmutter sagt: gebrauchen. Aber vielleicht kann Dir die Weberin helfen.\n");
    ob->setze_wert(MANTEL,1);
    ob = clone_object(ARMOUR+"mantel");
    a = ob->move(TP);
    if(a == ME_TOO_HEAVY)
    {
      tell_object(TP, "Der Mantel ist zu schwer fuer Dich.\n");
      ob->move(environment(TP));
    }
    return 0;
  }
  else if(a ==1)
  {
    tell_object(TP, "Die Grossmutter sagt: Ich habe Dir schon einen Mantel gegeben!\n");
    return 0;
  }
}
     
    
