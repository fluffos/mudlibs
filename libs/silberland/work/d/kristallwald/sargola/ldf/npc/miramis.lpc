// Miramis - Pferd vom Koenig im Land der Ferne
//

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include "../../dorf/obj/ldfquest.h"

int steige(string str);
int blah(string str);
int fuettere(string str);

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Miramis");
  SetProp(P_LONG, BS(
    "Ein wunderschoenes, weiss strahlendes Pferd steht vor Dir. Seine "
    "golden wirkende Maehne strahlt im Sonnenlicht. Es blickt unruhig "
    "mit grossen, dunklen Augen umher als ob es auf etwas warten wuerde. "
    "Miramis Hufe scharren unruhig am Boden."));
  AddDetail("augen","Grosse, dunkle Augen blicken Dich vielsagend an.");
  AddDetail("maehne","Die lange Maehne leuchtet fast im Sonnenlicht und "
    "gibt ihm ein eldles Aussehen.");
  AddDetail("aussehen","Wie es sich fuer ein koenigliches Pferd gehoert.");
  AddDetail(({"licht","sonnenlicht"}), "Es leuchtet und bricht sich in der "
    "Maehne von Miramis.");
  AddDetail("hufe","Miramis scharrt mit den Hufen unruhig am Boden herum.");
 
  
  SetProp(P_NAME, "Miramis");
  SetProp(P_GENDER, MALE);
  AddId( ({"pferd","miramis"}) );


  create_default_npc(17);
  SetProp(P_HANDS, ({" mit maechtigen Hufen", QueryProp(P_HANDS)[1],DT_SQUEEZE}));
  SetProp(P_RACE, "Pferd");
  SetProp(P_ALIGN, 730);
  SetProp(P_MAX_HANDS, 4);

  SetProp(P_MSGIN, "reitet herein");
  SetProp(P_MSGOUT, "reitet weiter");  
 
  AddInfo(DEFAULT_INFO, "wiehert laut.\n");

  SetProp(P_REJECT, ({ REJECT_DROP, 
    "Die Kuh kann mit @WEM nichts anfangen.\n"}));

  SetChats(2, ({
    "Miramis scharrt mit seinen Hufen am Boden.\n",
    "Miramis wirkt sehr unruhig.\n",
    "Miramis wiehert laut.\n",
    "Miramis blickt in die Schlucht hinab.\n",
    "Miramis reitet einen kleinen Kreis.\n",
    "Miramis macht ein Zirkuskunststueck!\n"}) );

  SetProp(P_DIE_MSG,
    " faellt tot zu Boden.\n");


  AddCmd(({"steig","steige","kletter","klettere","sitze","setze","setz"}),"steige");
  AddCmd(({"kletter","klettere","setz","setze","sitz"}),"blah");
  AddCmd(({"fuetter","fuettere"}),"fuettere");
}
int blah(string str)
{
  notify_fail("Worauf moechtest Du steigen?\n");
  if(!str) return 0;
  
  if(str=="auf pferd"||str=="auf miramis")
  {
    tell_object(TP, BS("Du willst auf das Pferd steigen?"));
    return 1;
  }
  return 0;
}


int steige (string str)
{
  object ob;
  int mantel, flasche, erlaubnis,zucker;
  ob = deep_present("\nldfquest",TP);
  if(objectp(ob))
  {
    mantel = ob->frage_wert(MANTEL);
    flasche = ob->frage_wert(FLASCHE);
    erlaubnis = ob->frage_wert(ERLAUBNIS);
    zucker = ob->frage_wert(ZUCKER);
  }
  notify_fail("Worauf moechtest Du steigen?\n");
  if(!str) return 0;
  
  if(str=="auf pferd"||str=="auf pferd auf"||str=="auf miramis"||str=="auf miramis auf")
  {
    /* noch nicht die voraussetzungen */
    if(mantel!=2 || flasche!=3)
    {
      tell_object(TP,BS("Miramis ignoriert Dich."));
      return 1;
    }
    /* erlaubnis vom koenig vorher holen */
    if(erlaubnis!=1)
    {
      tell_object(TP, BS("Miramis erkennt, dass Du gekommen bist, um gegen Ritter "
        "Kato anzutreten, aber Du darfst noch nicht auf ihm reiten."));
      return 1;
    }
    /* mit zucker gefuetter? */
    if(zucker==2)
    {
      tell_object(TP, BS("Daraufhin kletterst Du vorsichtig "
	"auf Miramis Ruecken. Ihr reitet los ... Miramis holt einen langen Anlauf "
	"reitet ueber die Bruecke .. macht einen maechtigen Satz .. und ist auf "
	"der anderen Seite der Schlucht!"));
      tell_object(TP, "Miramis fluestert Dir zu: Wenn Du zurueck willst, pfeif einfach nach mir!\n");
      TP->move(ROOM+"dw1",M_GO);
      return 1;
    }
    else
    {
      tell_object(TP, BS("Du versuchst auf den Ruecken von Miramis zu klettern, aber "
        "er laesst Dich nicht. Ob Du ihn mit irgendetwas milder stimmen koenntest?"));
      return 1;
    }
  }
  return 0;
}

int fuettere(string str)
{
  object ob;
  int val;
  ob = deep_present("\nldfquest",TP);
  if(objectp(ob)) val = ob->frage_wert(ZUCKER);
  
  notify_fail("Was moechtest Du an wen verfuettern?\n");
  if(!str) return 0;
  
  if(str=="brot"||str=="mit brot"||str=="brot miramis"||str=="brot an miramis")
  {
  	tell_object(TP,BS("Das Brot brauchst Du eventuell noch fuer etwas anderes."));
  	return 1;
  }
  if(str=="mit heu"||str=="heu"||str=="mit gras"||str=="gras"||str=="heu an miramis"||str=="gras an miramis")
  {
  	tell_object(TP, BS("Miramis ist ein koenigliches Pferd und gibt sich nicht mit "
  	   "solch schnoedem Zeugs ab."));
  	return 1;
  }
  if(str=="miramis zucker" ||str=="miramis mit zucker"||str=="zucker an miramis"||str=="miramis mit zucker")
  {
  
    if(!deep_present("\nldfzucker",TP))
    {
      tell_object(TP, "Du hast keinen Zucker bei Dir!\n");
      return 1;
    }
  
    tell_object(TP, BS("Du streckst Miramis eine flache Hand mit Zucker aus "
        "und Miramis leckt den Zucker gierig auf. Miramis wirkt daraufhin "
	"wesentlich ruhiger auf Dich."));
    ob->setze_wert(ZUCKER,2);
    ob = deep_present("\nldfzucker",TP);
    if(objectp(ob)) ob->remove();
    return 1;
  }
  return 0;
}
    





void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( touch && find_call_out("react")==-1 )
    call_out("muuhen",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void muuhen()
{
  command_me("emote wiehert laut.");
}


