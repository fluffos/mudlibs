inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"
#include "../../dorf/obj/ldfquest.h"

string berg();
string stollen();
string schmied();
string gruss();



create()
{
     if (!is_clone(TO)) return;  
     ::create();   
    
     
     SetProp(P_SHORT, "Eno");  
     SetProp(P_LONG, BS("Eno ist ein kleiner, elend aussehender "
       "Mann mit grauem Haar. Er wippt immer vor und zurueck "
       "und haelt dabei seine Knie als waere er ein meditierender Guru. "
       "Er wirkt ziemlich untererhaehrt."));
     
     AddDetail(({"gelenke","kniegelenke","knie"}),
       "Die Kniegelenke wirken ziemlich dick - wahrschein"
       "lich, weil das restliche Bein so schmaechtig ist.");
     AddDetail(({"beine","bein"}),"Seine Beine wirken duenn und verdreckt.");
     AddDetail("guru","Er sieht so aus, kann aber keiner sein. Oder "
       "doch?");
     AddDetail("haar","Sein Haar ist grau - kein Wunder, bei dem Alter.");
     AddDetail("alter","Das kann man schwer schaetzen. Auf jeden Fall "
       "ist er flink im Vor-und-Zurueck-Wippen.");
     AddDetail("vor-und-zurueck-wippen","Er mag duenne Beine haben und "
       "elend aussehen, Wippen kann der Mann!");
     AddDetail("mann","Du wirst Eno meinen.");
   
    
     SetProp(P_GENDER, MALE);
     SetProp(P_ARTICLE, 0);  
     SetProp(P_NAME,"Eno");  
     AddId (({ "eno","mann"}));  
     create_default_npc (8);  
     SetProp(P_HANDS, ({" mit schwachen Faeusten", QueryProp(P_HANDS)[1], DT_BLUDGEON}));  
     
     SetProp(P_MSGIN, "wippt herein");  
     SetProp(P_MSGOUT, "wippt");  


     
     SetProp(P_RACE, "Mensch");  
     SetProp(P_ALIGN, 580); 
     SetProp(P_SIZE, 140);
     SetProp(P_BODY, 60);
     SetProp(P_XP, 0);		//Quest-NPC :)
     SetProp(P_NOATTACK,"wippt geschickt an Deinem Schlag vorbei.");

   
     AddInfo(DEFAULT_INFO,
     	({"seufzt: Oohh..oohh.. davon weiss ich nichts.\n",
	  "wippt nur hin und her.\n",
	  "fluestert: Bitte tut mir nichts boeses!\n",
	  "starrt Dich angsterfuellt an.\n",
	  "befuehlt seine Knie.\n",
	  "fluestert etwas unverstaendliches.\n",
	  "wippt wild umher.\n"}));
	
     
     AddInfo("sargola","Frag mich lieber was sinnvolles.","grinst: ");

     AddInfo("dschinn","AIEEEE! Mit einem Irren will ich nichts zu tun haben! AIEEEE!!",
       "bruellt irre: ");
     AddInfo(({"vogel", "voegel"}), "Voegel? Woher hast Du das denn?","gruebelt: ");
 
     AddInfo("koenig","Vor langer Zeit als ich noch im Land der Ferne war, "
       "da gab es einen Koenig. Aber er war sehr jung.", "sagt: ");
     AddInfo(({"humbug","silberland"}),"Alles Humbug!", "erklaert ueberzeugt: ");
     AddInfo("humbug","Na die Existenz des Silberlandes.","erklaert ueberzeugt: ");
     
     
     
     AddInfo("spaeher","Sie laufen ueberall herum und toeten alles, was nicht er"
       "geben Ritter Kato folgt!","fuerchtet sich: ");
     AddInfo(({"boesewicht","ritter","kato"}), BS("Sei still, Dummkopf! Sprich den Namen "
       "nicht so laut aus! Die Spaeher koennten Dich hoeren! Ich hoere niemanden, "
       "aber es kann doch sein."),"sagt voller Furcht: ");
       


     AddInfo(({"land","land der ferne","ferne"}),
       "Es ist schon lange her, dass ich es gesehen habe. Ich habe nur noch "
       "schwache Erinnerungen daran.", "weint: ");
     AddInfo("erinnerungen","An den Rosengarten vor dem Schloss, und an die Weide.",
       "sagt: ");
     AddInfo("weide","Die Weide westlich vom Schloss - dort war ich als kleiens "
       "Kind immer spielen.","sagt :");
     AddInfo(({"koenig","schloss"}),"Der Koenig hat ein praechtiges Schloss.","sagt: ");
     



     AddInfo("wald","Der dunklen Wald im Sueden. Er ist durch Ritter "
       "Katos Einfluss schwarz geworden.","sagt: ");
     AddInfo("einfluss","Den sieht man doch deutlich, oder? Alles ist abge"
       "storben und verdoerrt.","sagt: ");

      
     AddInfo("mondscheingewebe","Davon habe ich noch nicht gehoert.","sagt: ");
     AddInfo("mantel","Du hast einen schoenen Mantel.","bestaetigt: ");
     AddInfo( ({"berg","fels","felswand","bergwand"}),#'berg);
     AddInfo("stollen",#'stollen);
     AddInfo(({"hunger","durst","brot","durst"}),"Hast Du etwas fuer mich?","fleht: ");
     AddInfo("schmied",#'schmied);
     AddInfo("gruss",#'gruss);
     
     
     SetChats(3, ({
	"Eno wippt hektisch nach vorn und hinten.\n",
	"Eno blickt verschreckt um sich.\n",
	"Eno kriecht zu Tuer, lauscht und laechelt erleichtert.\n",
	"Eno sagt: \"Oh...oohh...\"\n",
	"Eno schreckt angsterfuellt zusammen.\n",
	"Eno kriecht unter den Tisch.\n"}));
	
} 

give_notify(object ob)
{
  object a;
  a = deep_present("\nldfquest",TP);
 
  if(!ob) return;
  if(!TP) return;
  
  if(ob->id("\nldfbrot"))
  {
    tell_object(TP,
"Eno greift vorsichtig und mit viel Misstrauen nach dem Brot.\n"
"Eno isst, wie Du noch nie einen Menschen essen gesehen hast!\n"
"Eno bedankt sich bei Dir.\n");
    if(objectp(a)) a->setze_wert(ESSEN,1);
    ob->remove();
  return;
  }
  if(ob->id("\nldfwasser"))
  {
    tell_object(TP,
"Eno nimmt misstrauisch die Flasche Wasser.\n"
"Eno oeffnet sie und beginnt gierig zu trinken\n"
"Eno bedankt sich bei Dir.\n");
    if(objectp(a)) a->setze_wert(TRINKEN,1);
    ob->remove();
  return;
  }
  if(ob->id("Nahrung"))
  {
    tell_object(TP, 
"Eno bemerkt, dass diese Nahrung nicht vom Land der Ferne stammen kann, wird\n"
"misstrauisch und gibt sie Dir wieder.\n");
    ob->move(TP);
  return;
  }
  else
  {
    tell_object(TP, "Eno kann das nicht brauchen und gibt es Dir wieder.\n");
    ob->move(TP);
  }
  
  
}

string stollen()
{
  object ob;
  int essen,trinken;
  ob = deep_present("\nldfquest",TP);
  if(objectp(ob))
  {
    essen = ob->frage_wert(ESSEN);
    trinken = ob->frage_wert(TRINKEN);
  }

  if(essen && trinken)
  {
    ob->setze_wert(BERGHINWEIS,1);
    clone_object(OBJ+"gruss")->move(TP);
    return 
	"sagt: Es fuehrt ein Stollen durch den Berg. Aber der Eingang ist\n"
	"Eno sagt: magisch von Ritter Kato verschlossen worden. Er befand sich\n"
	"Eno sagt: wenn Du von meiner Huette aus ganz nach Westen gehst. Such\n"
	"Eno sagt: dort nach einem Eingang. Im Berg wirst Du einen Schmied\n"
	"Eno sagt: finden, der Dir vielleicht helfen kann. Richte ihm einen\n"
	"Eno sagt: schoenen Gruss von mir aus.\n\n"
	"Eno gibt Dir einen schoenen Gruss fuer den Schmied.\n";
	
  }
  else
    return "fragt: Woher hast Du das denn?\n";
}
  


string berg()
{
  object ob;
  int essen,trinken;
  ob = deep_present("\nldfquest",TP);
  if(objectp(ob))
  {
    essen = ob->frage_wert(ESSEN);
    trinken = ob->frage_wert(TRINKEN);
  }

  if(!essen && !trinken)
    return "fleht: Ich habe soooolchen Hunger...\n";
  
  if(essen && !trinken)
    return "fleht: Ich habe soooolchen Durst...\n";
  
  if(essen && trinken)
  { return
	"sagt: An Ihm kommst Du nicht vorbei, man kann nicht ueber ihn\n"
	"Eno sagt: klettern. Ausser man kennt den Stollen.";
  }
  
}

string schmied()
{
  object ob;
  int essen,trinken;
  ob = deep_present("\nldfquest",TP);
  if(objectp(ob))
  {
    essen = ob->frage_wert(ESSEN);
    trinken = ob->frage_wert(TRINKEN);
  }
  if(essen && trinken)
    return "sagt: Er wohnt im Berg und kann Dir eventuell helfen.\n";
  return "fragt: Woher weisst Du das denn?\n";
}

string gruss()
{
  object ob;
  int essen,trinken;
  ob = deep_present("\nldfquest",TP);
  if(objectp(ob))
  {
    essen = ob->frage_wert(ESSEN);
    trinken = ob->frage_wert(TRINKEN);
  }
  if(essen && trinken)
    return "sagt: Richte den Gruss bitte dem Schmied fuer mich aus.\n";
  return "fragt: Woher weisst Du das denn?\n";
}
  
  
