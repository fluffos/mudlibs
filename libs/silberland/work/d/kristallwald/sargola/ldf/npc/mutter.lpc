inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"
#include "../../dorf/obj/ldfquest.h"


string * namen;
string zucker();

create()
{
     if (!is_clone(TO)) return;  
     ::create();   
     
     namen=({});
     
     SetProp(P_SHORT, "Die Mutter von Jum-Jum");  
     SetProp(P_LONG, BS("Die Mutter von Jum-Jum laechelt Dich freund"
       "lich an. Sie traegt eine lange Schuerze damit sie sich beim "
       "Kochen nicht anpatzt. Seltsamerweise aehnelt sie "
       "Lundin ein wenig - vielleicht ein wenig schoener. Sie hat "
       "naemlich die gleichen Gruebchen in den runden Wangen wie Lundin."));
     
     AddDetail("schuerze","Die Schuerze schuetzt sie vor Flecken und "
       "Spritzern beim Kochen.");
     AddDetail(({"flecken","spritzer"}), "Eigenartigerweise sind auf der "
       "Schuerze keine Flecken und Spritzer.");
     AddDetail("kochen","Die Mutter von Jum-Jum kocht gern und viel fuer "
       "ihre Lieblinge.");
     AddDetail("lieblinge","Das muessen Jum-Jum und ihr Ehemann der Rosen"
       "gaertner sein.");
     AddDetail( ({"rosengaertner","ehemann","gaertner"}), "Der ist wohl "
       "gerade im Rosengarten.");
     AddDetail("lundin","Sie erinnert Dich an Lundin aus dem Elfendorf.");
     AddDetail("gruebchen","Komisch ... die selben, wie die, die Du bei "
       "Lundin bemerkt hast.");
     AddDetail("wangen","In den rundlichen Wangen, die Jum-Jums Mutter ein "
       "freundliches Aussehen geben, siehst Du kleine Gruebchen.");
     AddDetail("aussehen","Es ist ausgesprochen freundlich.");
     
    
     SetProp(P_GENDER, FEMALE);  
     SetProp(P_NAME, ({"Mutter","Mutter","Mutter","Mutter"}));  
     AddId (({ "mutter"}));  
     create_default_npc (9);  
     SetProp(P_HANDS, ({" mit kleinen Haenden", QueryProp(P_HANDS)[1], DT_BLUDGEON}));  
   
     SetProp(P_RACE, "Mensch");  
     SetProp(P_ALIGN, 750); 
     SetProp(P_SIZE, 170);
     SetProp(P_BODY, 80);
     SetProp(P_XP, 0);		//Quest-NPC :)
     SetProp(P_REJECT,
       ({REJECT_DROP,"Die Mutter kann so etwas nicht brauchen."}) );

   
     AddInfo(DEFAULT_INFO,
     	"Willst Du nicht lieber eine Palatschinke kosten?","bietet Dir an: ");
     AddInfo(({"glas","marmelade"}), "Ich brauche massenhaft Glaeser mit "
       "Marmelade fuer meine gute Palatschinken.","erklaert: ");
     AddInfo("sargola","Er kommt oefters zu mir auf ein paar "
     	"Palatschinken.","grinst: ");
     AddInfo("gridi","Jeeeden Tag kommt sie vorbei und beraubt mich meines "
     	"Erdbeerkompottes!","grinst: ");
     
     AddInfo("dschinn","Der mag nichtmal meine Palatschinken! Der muss "
       "doch irre sein!","bruellt: ");
     AddInfo(({"vogel", "voegel"}), "Jaja, immer diese Voegel ... ich kriege "
        "sie einfach nicht aus dem Haeuschen hinaus, wenn ich sie zum Fenster "
	"rausscheuche, kommen sie bei der Tuer wieder herein.","zwinkert "
	"vergnuegt: ");
     AddInfo( ({"teig","rezept"}), "Das Rezept fuer den Teig verrate ich "
       "sicher nicht.","grinst: ") ;    
     AddInfo(({"rosenstraeucher","strauch","straeucher","busch",
	"rosenbusch","buesche","rosenbuesche","rosen","lilien",
	"pappeln","silberpappeln","rosengarten","garten"}),
       "Mein Mann kuemmert sich darum.", "sagt: ");
     AddInfo("koenig","Unser Koenig ist ein guter Koenig. Manchmal koche "
       "ich ihm auch Palatschinken.", "prahlt: ");
     AddInfo("silberland","In alten Maeren erzaehlt man sich davon.", "schildert: ");
     AddInfo("maerchen","Glaubst Du etwa daran?","fragt Dich: ");
     AddInfo(({"land","land der ferne","ferne"}),
       "Sieh Dich doch nur um bei uns.", "sagt: ");
     AddInfo(({"daecher", "dach"}), "Ich liebe es unter dem Stroh zu schlafen.","seufzt vertraeumt: ");
     AddInfo("stroh","Damit ist unser Dach gedeckt.","seufzt vertraeumt: ");
     AddInfo(({"schloss","gebaeude"}),"Das Schloss ist der Wohnsitz unseres guten Koenigs und "
       "liegt im Norden des Rosengartens.","sagt: ");


     AddInfo(({"pappeln","silberpappeln"}),"Ich pflege auch die Silberpappeln "
       "von Zeit zu Zeit. Ihr Klingen macht mich froh im Herzen. Und abends, da sieht "
       "es so aus, als ob ihre Spitzen in den Sternen brennen wuerden.","laechelt: ");


     AddInfo(({"sohn","jum-jum"}),"Hast Du ihn schon kennengelernt? Er stopft immer "
       "unglaublich viele Palatschinken (bis ihm schlecht ist).","grinst: ");
     AddInfo(({"palatschinke","palatschinken"}),"Man sagt, ich mache die Besten im ganzen Land der "
       "Ferne. Ob es wohl daran liegt, dass sonst niemand Palatschinken macht?","kichert: ");
     AddInfo(({"gaertner","rosengaertner","mann"}), "Mein Mann kuemmert sich um den "
       "Rosengarten des Koenigs.","erklaert: ");
     AddInfo(({"garten","rosengarten"}), "Das musst Du meinen Mann fragen.","sagt: ");  

     AddInfo(({"haus","haeuschen"}),"Meine Familie und ich leben hier.","sagt: ");
     AddInfo("familie","Wir wohnen in einem bescheidenen Haeuschen im Sued"
       "osten des Rosengartens.","sagt: ");
     AddInfo("liedchen","Magst Du es?","fragt: ");
     AddInfo("essen","Ich kann gute Palatschinken machen.","erklaert stolz: ");
     AddInfo("zucker",#'zucker);
     
       
     SetChats(3, ({
	"Die Mutter von Jum-Jum schupft gekonnt eine Palatschinke.\n",
	"Die Mutter von Jum-Jum summt ein kleines Liedchen.\n",       
	"Die Mutter von Jum-Jum oeffnet das Glas mit Erdbeermarmelade.\n",
	"Die Mutter von Jum-Jum zuckert eine Palatschinke.\n",
	"Die Mutter von Jum-Jum ruehrt neuen Teig fuer Palatschinken an.\n",
	"Die Mutter von Jum-Jum ruft alle zum Essen.\n",
	"Die Mutter von Jum-Jum isst selbst alle Palatschinken auf!\n"}) );
	
     AddCmd("bitte","bitte");       
} 

string zucker()
{
  object ob;
  int val;
  ob = deep_present("\nldfquest",TP);
  if(objectp(ob)) val = ob->frage_wert(ZUCKER);
  
  if(val==1)
  {
    return "Die Mutter sagt: Du hast schon Zucker von mir bekommen.\n";
  }
  ob->setze_wert(ZUCKER,1);
  ob = clone_object(OBJ+"zucker");
  val = ob->move(TP);
  if(val==ME_TOO_HEAVY)
  {
    ob->move(environment(TP));
    return
	"Die Mutter sagt: Hier hast Du ein paar Stuecke Zucker, nur sind sie fuer Dich\n"
	"Die Mutter sagt: zu schwer.";
  }
  return "sagt: Ich brauche oft Zucker fuer meine Palatschinken.\nDie Mutter sagt: Hier hast Du ein paar Stuecke Zucker.";
}

void reset()
{
  ::reset();
  namen=({});
}

int bitte(string str)
{
  notify_fail("Worum moechtest Du wen bitten?\n");
  if(str=="mutter um eine palatschinke" ||str!="mutter um palatschinken") return 0;
  
} 
  

