inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"
#include "../../dorf/obj/ldfquest.h"

string watschn();


create()
{
     if (!is_clone(TO)) return;  
     ::create();   
    
     
     SetProp(P_SHORT, "Uebeeer, der Burgkoch");  
     SetProp(P_LONG, BS("Das ist Uebeeer (Frevler nennen ihn manchmel "
       "Hubert), der legendaere Koch in "
       "der Burg von Ritter Kato. Er hetzt mit tief ins Gesicht gezogener "
       "Muetze durch die Kueche und hinter Huehnern her. Er fuchtelt wild "
       "mit einem gefaehrlich aussehenden Beil. Vor allem gefaehrlich, weil "
       "es mit Blut ueberstroemt ist."));
     
     AddDetail(({"frevler","hubert"}),
       "Nenn ihn ja nicht Hubert!");
     AddDetail("gesicht","Das ist kaum zu sehen, weil die grosse Koch"
       "muetze tief ins Gesicht haengt.");
     AddDetail(({"muetze","kochmuetze"}),"So eine, wie Du sie eigentlich "
       "schon immer wolltest! Eine von den ganz grossen mit so einem "
       "runden Ding oben!");
     AddDetail("ding","Es ist rund und sicherlich stoerend beim Kochen - "
       "trotzdem hat jeder ordentliche Koch eine solche Muetze!");

    
     SetProp(P_GENDER, MALE);
     SetProp(P_ARTICLE, 0);  
     SetProp(P_NAME,"Uebeeer");  
     AddId (({ "koch","burgkoch","uebeeer"}));  
     create_default_npc (18);  
     SetProp(P_HANDS, ({" mit Faeusten", QueryProp(P_HANDS)[1], DT_BLUDGEON}));  
     
     SetProp(P_MSGIN, "jagt hier ein Huhn");  
     SetProp(P_MSGOUT, "jagt");  


     
     SetProp(P_RACE, "Mensch");  
     SetProp(P_ALIGN, 380); 
     SetProp(P_SIZE, 170);
     SetProp(P_BODY, 90);
     SetProp(P_XP, 0);		//Quest-NPC :)
     //SetProp(P_NOATTACK,"wippt geschickt an Deinem Schlag vorbei.");

     SUID;
     CLONEME(WEAPON+"beil");
     command_me("zuecke beil");

   
     AddInfo(DEFAULT_INFO,
     	({"seufzt: Oohh..oohh.. davon weiss ich nichts.\n",
	  "wippt nur hin und her.\n",
	  "fluestert: Bitte tut mir nichts boeses!\n",
	  "starrt Dich angsterfuellt an.\n",
	  "befuehlt seine Knie.\n",
	  "fluestert etwas unverstaendliches.\n",
	  "wippt wild umher.\n"}));
	
     AddInfo("hubert",#'watschn);
     
     AddInfo("sargola","Isch habe keine Zeit fuer so eine Bloedsinn.","flucht: ");

 
     AddInfo("koenig","Es gibt hier nur Ritter Kato.", "sagt: ");
     AddInfo(({"silberland"}),"Alles Umbug!", "erklaert uebeeerzeugt: ");
     AddInfo("umbug","Na das mit dem Silberland.","erklaert uebeeerzeugt: ");
     
     
     
     AddInfo("spaeher","Sie olen sich immer bei mir ihre Mahlzeiten.","sagt: ");
     AddInfo("mahlzeiten","Sie Dir am Besten meine Menue an.","sagt: ");
     AddInfo("menue","Mein Tipp: tippe \"menue\".","gibt Dir einen Tip: ");
     AddInfo(({"boesewicht","ritter","kato"}), BS("Eeer at mich entfuehrt."),
       "sagt voller Trauer: ");
     AddInfo(({"hennen","huhn","henne","huehner","biester"}),"Die kleinen "
       "Biester die! Abee	er ich kriege sie!","grummelt: ");
       


     AddInfo(({"land","land der ferne","ferne"}),
       "Ich war schon lange nicht mehr dort.", "weint: ");
    
  SetChats(5,({
    "Uebeeer hechtet mutig hinter einem Huhn hinterher.\n",
    "Uebeeer flucht: \"Merde!\".\n",
    "Uebeeer schwingt sein blutiges Beil.\n",
    "Uebeeer murmelt was von: \"Smoerebroed...\".\n",
    "Uebeeer sagt: Wo ist denn bloss Fred Combuese??\n",
    "Uebeeer fluestert gefaehrlich: Du kommst schon noch in meine Rue-de-la-Gack!!\n",
    "Uebeeer sagt: Naaa, kleines Uhn! Komm zu Pappa!\n"}));
	
} 


string watschn()
{
  tell_room(environment(TO), "Uebeeer gibt "+TPN+" eine saftige Watschn.\n",({TP}));
  TO->reduce_hit_points(10);
  tell_object(TP, BS("Uebeeer gibt Dir eine saftige Watschn!\n"));
  return 0;
}