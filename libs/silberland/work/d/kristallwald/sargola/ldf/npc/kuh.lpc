// Kuh - Werte von der kuh aus h/feyaria
//

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Kuh");
  SetProp(P_LONG, BS(
    "Eine haselnussbraune Kuh mit grossen, dunklen Augen und nicht "
    "ungefaehrlich wirkenden Hoernern grast ohne Dich zu beachten "
    "ganz in Deine Naehe."));
  AddDetail("augen","Sie sind gross und dunkel. Oft muss sie sie zu"
    "kneiffen, damit sie sich vor den laestigen Fliegen schuetzen kann.");
  AddDetail("fliegen","Die Kuh ist von ziemlich vielen laestigen Fliegen "
    "umgeben");
  AddDetail("hoerner","Damit legst Du Dich am besten nicht an.");
  AddDetail("naehe","Nicht allzuweit entfernt.");
  AddDetail("schwanz","Was waere eine Kuh ohne einen Schwanz?");
  
  SetProp(P_NAME, "Kuh");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kuh"}) );


  create_default_npc(11);
  SetProp(P_HANDS, ({" mit ihren Hoernern", 110, DT_PIERCE}));
  SetProp(P_RACE, "Kuh");
  SetProp(P_SIZE, 140+random(10));
  SetProp(P_ALIGN, 30);
  SetProp(P_MAX_HANDS, 4);

  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT, "weidet weiter");  
  SetProp(P_MNPC_AREA, ({ ROOM "w2", ROOM "w2", ROOM "w3", ROOM "w4",
                          ROOM "w5", ROOM "w6", ROOM "w7" }));
  SetProp(P_MNPC_WAIT, ({ 30, 50, 50 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "w3");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INFIGHT);

  AddInfo(DEFAULT_INFO, "muuht Dich fragend an.\n");
  AddInfo("sargola", "ist vielzusehr mit Kauen beschaeftigt.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
    "Die Kuh kann mit @WEM nichts anfangen.\n"}));

  SetChats(2, ({
    "Die Kuh laesst einen Kuhfladen fallen.\n",
    "Die Kuh macht: MUUUUH!!!\n",
    "Die Kuh kaut.\n",
    "Die Zaehne der Kuh zermalen das halbverdaute Gras.\n",
    "Die Kuh verscheucht die laestigen Fliegen mit ihrem Schwanz.\n",
    "Die Kuh muuht.\n"}) );

  SetProp(P_DIE_MSG,
    " faellt tot zu Boden.\n");


  AddCmd( ({"melke", "melk"}), "melken");
}

int melken(string str)
{
  notify_fail("Wen willst Du melken?\n");
  if( !str ) return 0;
  if( str=="kuh" )
  {
    write("Die Kuh gibt leider keine Milch mehr.\n");
    return 1;
  }
  return 0;
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( touch && find_call_out("react")==-1 )
    call_out("muuhen",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void muuhen()
{
  command_me("emote muuht Dich laut an.");
}

void init()
{
  ::init();
  if( TP && (TP->id("kuh") || TP->id("schaf")) )
    AddDefender(TP);
}

