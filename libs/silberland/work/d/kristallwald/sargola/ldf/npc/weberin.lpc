inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"
#include "../../dorf/obj/ldfquest.h"

string mantel();


create()
{
     if (!is_clone(TO)) return;  
     ::create();   
    
     
     SetProp(P_SHORT, "Eine Weberin");  
     SetProp(P_LONG, BS("Die Weberin traegt eine Schuerze aus weissem "
       "stoff, grosse, weiche Pantoffeln Sie ist schon etwas aelter "
       "und wuselt immer fleissig naehend, strickend und webend "
       "durch den Raum."));
     
     
    
     SetProp(P_GENDER, FEMALE);  
     SetProp(P_NAME, "Weberin");  
     AddId (({ "weberin"}));  
     create_default_npc (8);  
     SetProp(P_HANDS, ({" mit schwachen Haenden", QueryProp(P_HANDS)[1], DT_BLUDGEON}));  
   
     SetProp(P_RACE, "Mensch");  
     SetProp(P_ALIGN, 450); 
     SetProp(P_SIZE, 160);
     SetProp(P_BODY, 70);
     SetProp(P_XP, 0);		//Quest-NPC :)
     SetProp(P_REJECT,
       ({REJECT_GIVE,"Die Weberin kann soetwas nicht brauchen."}) );
      SetProp(P_NOATTACK,"Als die Weberin derart gellend um Hilfe schreit, "
        "hoerst Du auf zu kaempfen.\n");
  AddInfo("kaemmen","Kaemmen kannst Du einfach mit den Fingern.","sagt: ");  
  AddInfo("loch","Um ein Loch zu stopfen, bedarf es eines Stoffes.","sagt: ");
  AddInfo("miramis","Miramis ist das Pferd des Koenigs - es rast oft auf "
    "der Weide herum.","sagt: ");
  AddInfo(({"fetzen","stofffetzen","stoffetzen"}),"Das ist eine "
    "Quest und keine Idiotenpartie! Das waere ja viel zu einfach. "
    "Nein, nun im Ernst: Der Stoff passt doch farblich gar nicht!",
    "erklaert: ");
  AddInfo("finger","Jaja, normalerweise nimmt man einen Finger"
   "hut...","sagt: ");
  AddInfo(({"partie","idiotenpartie"}), "Das sind die Quests "
    "von Sargola nie!","sagt: ");
  AddInfo("sargola","Der kann sogar stricken!","staunt: ");
  AddInfo("maschine","Welche meinst Du?","fragt: ");
  AddInfo("quest","Deswegen bist Du doch hier, oder?","fragt: ");
  AddInfo("webstuhl","Damit kann man aus duennen Wollfaeden "
    "Stoffe weben.","sagt: ");
  AddInfo(({"faeden","wollfaeden"}), "Mit Faeden aus Wolle kann man dann "
    "Stoffe weben.", "sagt: ");
  AddInfo(({"stoff","stoffe"}), "Aus huebschen Faeden kann man - wenn "
    "man geschickt genug ist - Stoffe weben.","sagt: ");
  AddInfo("wolle","Die Wolle stammt meist von den Schafen auf der "
    "Weide, die Nonno geschoren hat.","sagt: ");
  AddInfo("weide","Dort grasen Kuehe und Schafe herum.","sagt: ");
  AddInfo("nonno","Nonno passt auf die Schafe und Kuehe auf. Und er "
    "schert sie auch oft.","sagt: ");
  AddInfo(({"schafe","kuehe"}), "Die streunen auf der Weide herum.","sagt: ");
  AddInfo(({"flies","wollflies"}), "Ein Wollflies bekommt man, wenn "
    "man ein Schaf schert.","erklaert: ");
  AddInfo("spinnrad", "Mit dem Spinnrad kann man die gewaschene und ge"
    "kaemmte Wolle zu einem Faden spinnen.","erklaert: ");
  AddInfo("mantel",#'mantel);
  AddInfo("nadel","Ich habe hier Nadeln herumliegen - Du musst Dich nur "
    "umsehen.","sagt: ");
  AddInfo("faden","Ich habe hier Faeden herumliegen - Du musst Dich nur "
    "umsehen.","sagt: ");
  AddInfo("fingerhut","I bin a hoarte Sau!","grunzt: ");
  AddInfo("sau","Du weisst schon...","grinst Dich an: ");
  AddInfo("naehmaschine","Die ist leider kaputt. Ich naehe alles mit der "
    "Hand. Falls Du nach der Quest Zeit hast, koenntest Du sie ja fuer "
    "mich reparieren!","grinst: "); 
  AddInfo("hand","Mit der naehe ich.");
  AddInfo("zeit","Du wirst schon noch eine Zeit brauchen, bis Du die "
    "Quest hast.","sagt: ");
  AddInfo("hemd","Das ist nicht fuer Dich.","grinst: ");
  AddInfo(({"kato","ritter","ritter kato"}), "Er tyrannisiert unser "
    "schoenes Land und entfuehrt wahllos Leute.", "sagt: ");
  AddInfo("land","Ja, das Land der Ferne.","sagt: ");
  AddInfo("leute","Hach, es sind schon soo viele verschwunden ... man "
    "kann sie bald gar nicht mehr zaehlen... besonders tragisch war "
    "das Verschwinden von Lisa.","schluchzt: ");
  AddInfo("lisa","Darueber will ich jetzt nicht reden.","seufzt: ");
  
  AddInfo(DEFAULT_INFO,
    ({"kennt sich damit nicht aus.\n",
      "ist nun ganz verwirrt.\n",
      "schuettelt den Kopf."}) );
  
 

   
       
     SetChats(3, ({
	"Die Weberin setzt sich an den Webstuhl.\n",
	"Die Weberin naeht an einem kleinen Hemd.\n",       
	"Die Weberin sticht sich in den Finger!\n",
	"Die Weberin bastelt an der Naehmaschine herum.\n",
	"Die Weberin hantiert mit Wollfaeden.\n"}) );
	
} 

string mantel()
{

  object ob;
  int val;
  ob = deep_present("\nldfquest",TP);
  if(objectp(ob)) 
    val = ob->frage_wert(MANTEL);

  if(val==1)
  {
    return 
            "sagt: Das ist ein huebscher Mantel. Nur leider ist er\n"
"Die Weberin sagt: aufgerissen sehe ich. Ich habe zuviel zu tun, um Dir zu\n"
"Die Weberin sagt: helfen aber Du findest hier alles was Du brauchst, um den\n"
"Die Weberin sagt: Mantel zu reparieren.";
  }
  else if(val==2)
  {
    return BS("sagt: Gratuliere, Dein Mantel ist wieder in Ordnung.");
  }
  else if(val==0)
  {
    return BS("sagt: Darueber weiss ich nichts.");
  }
}
  
  
