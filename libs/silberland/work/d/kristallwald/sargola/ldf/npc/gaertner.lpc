inherit "std/mnpc";
#include <mnpc.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"

vortrag();
lilien();
schraubenzieher();

int schraubenzieher;


create()
{
     if (!is_clone(TO)) return;  
     ::create();   
     
     schraubenzieher = 1;
     
     SetProp(P_SHORT, "Der Rosengaertner");  
     SetProp(P_LONG, BS("Ein noch recht junger Mann (so jung auch wieder nicht) "
       "kuemmert sich hier um den Rosengarten. Er traegt eine gruene, dicke Sch"
       "uerze, damit ihn die Rosen nicht stechen. Weiters steckt er in hohen "
       "Stiefeln aus Leder, die ganz gatschig sind."));
     AddDetail("mann","In den besten Jahren koennte man sagen.");
     AddDetail("jahre","Die besten sind sehr relativ.");
     AddDetail("schuerze","Die Schuerze ist aussergewoehnlich dick um vor den "
       "Stacheln der Rosen zu schuetzen. Und sie ist ziemlich gruen (waeh).");
     AddDetail("stiefel","Sie sind derb und aus starkem Leder gefertigt. Mit ihnen "
       "latscht der Rosengaertner wohl den ganzen Tag durch die Beete. Darum sind "
       "sie so gatschig.");
     AddDetail("leder","Es ist grob gefertigt aber erfuellt seinen Zweck.");
     
     
    
     SetProp(P_GENDER, MALE);  
     SetProp(P_NAME, ({"Rosengaertner","Rosengaertners","Rosengaertner","Rosengaertner"}));  
     AddId (({ "gaertner","rosengaertner"}));  
     create_default_npc (11);  
     SetProp(P_HANDS, ({" mit klobigen Haenden", QueryProp(P_HANDS)[1], DT_BLUDGEON}));  
   
     SetProp(P_MSGIN, "latscht herein");  
     SetProp(P_MSGOUT, "latscht");  
     SetProp(P_RACE, "Mensch");  
     SetProp(P_ALIGN, 650);  
     SetProp(P_SIZE, 175);
     SetProp(P_BODY, 90);
     SetProp(P_XP, 0);		//Quest-NPC :)
    
     //CLONEME(ARMOUR+"schuerze");    


  SetProp (P_MNPC_AREA, ROOM+"r");
  SetProp (P_MNPC_DEFAULTROOM, ROOM+"r2");
  // (Zeit bis erster Schritt, mindestens zeit aller weiteren schritte, wird zu zahl 2 addiert
  SetProp (P_MNPC_WAIT, ({30,40,40}));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS+MOV_MOVES);

     AddInfo("werkzeug","Was brauchst Du denn?","fragt: ");
     AddInfo("miramis","Das ist das weisse Pferd des Koenigs.","sagt: ");
     AddInfo(DEFAULT_INFO,
     	"Soll ich Dir nicht lieber was von meinen wunderschoenen Rosen "
     	"erzaehlen?","grummelt: ");
     AddInfo("sargola","Er versteht nichts von Rosen!","flucht abfaellig: ");
     AddInfo("gridi","Sie bekommt oefters Rosen von mir.","grinst breit: ");
     AddInfo("dschinn","Ich traue ihm nicht - er grinst immer so irre!",
     	"stottert: ");
     AddInfo(({"rosenstraeucher","strauch","straeucher","busch","rosenbusch","buesche","rosenbuesche","rosen"}),
       "Ich pflege die Rosen fuer den Koenig und ich liebe "
       "diese Beschaeftigung. Rosen sind mein Leben.", "schwaermt: ");
     AddInfo("koenig","Unser Koenig ist ein guter Koenig. Der Beste im ganzen "
       "Silberland. Oft wandert er durch den Rosengarten und erfreut "
       "sich an der Pracht.", "prahlt: ");
     AddInfo("pracht","Du musst blind sein, um sie nicht zu erkennen.","sagt: ");
     AddInfo("beschaeftigung","Ich kuemmere mich den ganzen Tag um die "
       "Rosen ... So eine bloede Frage.","kichert: ");
     AddInfo("silberland","Das ist soweit weg von hier ... ich kenne es kaum.", "sagt: ");
     AddInfo("leben","Rosen halt - schlicht Rosen.","erklaert: ");
     AddInfo("lilien",#'lilien);
     AddInfo("vortrag",#'vortrag);
     AddInfo(({"land","land der ferne","ferne"}),
       "Sieh Dich doch nur um bei uns.", "sagt: ");
     AddInfo(({"daecher", "dach"}), "Das ist zu weit weg.");
     AddInfo(({"schloss","gebaeude"}),"Das Schloss ist der Wohnsitz unseres guten Koenigs und "
       "liegt im Norden des Rosengartens.","sagt: ");
     AddInfo( ({"tuerme","fenster","nischen","fenster"}),"Das Schloss sehe ich die "
       "meiste Zeit auch nur von Aussen.");
     AddInfo(({"rosengarten","garten"}), "Ihm widme ich die meiste Zeit.", "sagt: ");
     AddInfo(({"pappeln","silberpappeln"}),"Ich pflege auch die Silberpappeln "
       "von Zeit zu Zeit. Ihr Klingen macht mich froh im Herzen. Und abends, da sieht "
       "es so aus, als ob ihre Spitzen in den Sternen brennen wuerden.","laechelt: ");
     AddInfo("sterne","Wenn es hier abend wird, kann man sie sehen.");
     AddInfo("abend","Das dauert noch lange.","sagt: ");
     AddInfo("spitzen","Seit langer, langer Zeit schon wachsen die Silberpappeln "
       "in den Himmel zu den Sternen.", "sagt: ");
     AddInfo(({"herzen","herz"}),"Es gibt nicht mehr so viele, die noch eines "
       "haben ... ","laechelt traurig: ");
     AddInfo("klingen","Lausch doch mal!","meint: ");
     AddInfo("blueten","Ich liebe es, wenn sich die Luft mit dem Duft der "
       "bluehender Rosen erfuellt.","sagt: ");
     AddInfo("dornen","Nun, zur Schoenheit der Rosen gesellen sich auch "
       "gefaehrliche Dornen. Die Rose symbolisiert wie keine zweite Pflanze "
       "diese Dualitaet.","sagt: ");
     AddInfo("dualitaet","Aehm...was das genau ist, darfst Du mich nicht fragen.","stottert: ");
     AddInfo("mauer","Sie umgibt den Rosengarten.","erklaert: ");
     AddInfo("wappen","Du meinst das Wappen vom Land der Ferne?","fragt: "); 
     AddInfo(({"sohn","jum-jum"}),"Jum-jum? Du kennst ihn? Das ist mein Sohn.","erklaert stolz: ");
     AddInfo("vogel","Er sing schoener und trauriger als alle anderen hier.","seufzt: ");
     AddInfo(({"haus","haeuschen"}),"Meine Familie und ich leben im Suedosten des "
       "in einem bescheidenen Haus.","sagt: ");
     AddInfo("familie","Wir wohnen in einem bescheidenen Haeuschen im Sued"
       "osten des Rosengartens.","sagt: ");
     AddInfo("frau","Sie kocht die wunderbarsten Palatschinken, die Du Dir "
       "vorstellen kannst.", "sagt: ");
     AddInfo(({"gaertner","rosengaertner"}),"Ist das nicht offensichtlich?","gruebelt: ");
     AddInfo("palatschinken","Ach, ich kann sie gar nicht so gut beschreiben, "
       "wie sie wirklich sind. Am Besten, Du gehst sie einfach besuchen - "
       "vielleicht hast Du ja Glueck, und sie macht gerade welche.", "sagt; ");
     AddInfo("schild","Hach! Haengt es etwa schon wieder runter? Mit einem "
       "Schraubenzieher koennte man das eventuell richten.","sagt: ");
     AddInfo("schraubenzieher",#'schraubenzieher);
     AddInfo("schraube","Die muesste irgendwo unter dem Schild am Boden "
       "liegen.","sagt: ");
     AddInfo("vogel","Darueber will ich Dir nichts erzaehlen. Frag Jum-Jum.","seufzt: ");
     AddInfo("voegel","Sie singen verzaubernde Lieder und bereiten Freude im "
       "Herzen.", "sagt: ");
     AddInfo("freude","Schoen, nicht wahr?","jubelt: ");
     AddInfo("unkraut","Das habe ich gut im Griff!","prahlt: ");
     
       
     SetChats(3, ({
       "Der Rosenaertner pflueckt liebevoll eine Rose.\n",
       "Der Rosengaertner schneidet eine Rose zurueck.\n",
       "Der Rosengaertner pfeift ein gar froehliches Lied.\n",
       "Der Rosengaertner nickt Dir freundlich zu.\n",
       "Der Rosengaertner zeigt Dir die Bluete einer jungen Lilie.\n",
       "Der Rosengaertner murmelt etwas in sich hinein.\n",
       "Der Rosengaertner beginnt mit dem Umsetzen eines Rosenbusches.\n",
       "Der Rosengaertner zupft gutgelaunt Unkraut zwischen den Rosen.\n",
       "Der Rosengaertner sagt: Ist es nicht ein schoener Tag?\n",
       "Der Rosengaertner erzaehlt Dir etwas ueber die Kunst des Pflanzens.\n",
       "Der Rosengaertner schneidet wie aus Versehen den Kopf einer Rose ab.\n"}) );
       
       
} 

give_notify(object ob)
{
  if(ob->id("\nldfschraubenzieher")==0)
  {
    tell_object(TP, "Der Rosengaertner kann das nicht brauchen und gibt es Dir wieder.\n");
    ob->move(TP);
  }
  tell_object(TP, "Der Rosengaertner bedankt sich bei Dir.\n");
  schraubenzieher = 1;
}
    

void reset()
{
  ::reset();
  schraubenzieher = 1;
}

schraubenzieher()
{ object ob;
  int ret;
  
  if(!schraubenzieher) return BS("sagt: Leider hab ich gerade keinen.\n");	
  
  tell_object(TP, 
"Der Rosengaertner sagt: Wenn Du willst, borg ich Dir einen. Aber bring ihn mir\n"
"Der Rosengaertner sagt: ja wieder.\n");
  ob = clone_object(OBJ+"schraubenzieher");
  schraubenzieher = 0;
  ret = ob->move(TP);
  if(ret == ME_TOO_HEAVY)
  {
    tell_object(TP, "Der Schraubenzieher ist fuer Dich zu schwer.\n");
    ob->move(environment(TP));
  }
  return "gibt Dir einen Schraubenzieher.\n";
}
  
  
vortrag()
{
  return "lacht haemisch: Willst Du das wirklich wissen?\n";
}

lilien()
{
     return(BS(
"freut sich: Aaaah! Ein geschultes Auge, freut mich!\n"
"Der Rosengaertner freut sich: Ich merke gleich, Du bist ein Kenner! Also\n"
"Der Rosengaertner freut sich: gut, Du wolltest etwas ueber Lilien wissen ...\n\n\n"
"Der Rosengaertner langweilt Dich gute 10 Minuten mit einem Vortrag ueber\n"
"die Kunst des Pflanzens von Lilien.\n\n"
"Muehsam unterdrueckst Du ein Gaehnen.\n"));
}     



