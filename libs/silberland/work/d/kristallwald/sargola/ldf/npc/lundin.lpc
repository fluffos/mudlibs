inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <moving.h>

#include "../def.h"

hilfe();

create()
{
  if (!is_clone(TO)) return;
     ::create();

  SetProp(P_SHORT, "Tante Lundin");
  SetProp(P_LONG,
	"Tante Lundin wird von allen so genannt, weil sie fuer alle "
	"Elfen immer da ist und sich alle Geschichten anhoert. Elfenkinder "
	"lieben sie, weil Tante Lundin die tollsten Geschichten erzaehlen "
	"kann und immer einen Apfel uebrig hat. Sie hat schon weisses Haar, "
	"eine Brille aber muntere Augen. Ein einfacher Elfenkittel ziert "
	"sie. ");


  SetProp(P_NAME, "Lundin");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"lundin", "tante lundin","elfe","elfin"}));

  create_default_npc(12);
  SetProp(P_HANDS, ({" mit gebrechlichen Haenden",QueryProp(P_HANDS)[1],
  	DT_PIERCE}));
  SetProp(P_RACE, "Elf");
  SetProp(P_LOG_INFO, "lundin.log");
  SetProp(P_NOATTACK, "Das ist doch nicht Dein Ernst, oder?\n");

  
  AddInfo(DEFAULT_INFO, 
  	({"blickt Dich stauend an.\n",
  	  "gruebelt lange.\n",
  	  "denkt nochmal scharf nach.\n",
  	  "fragt Dich: Bist Du Dir sicher?\n",
  	  "versteht kein Wort.\n"}) );
  AddInfo("sargola", "Kaum jemand weiss naeheres ueber ihn.","sagt: ");
  AddInfo("gridi", "Sie ist wohl die einzige, die ihn genauer kennt.",
  	"schmunzelt: ");
  AddInfo("land der ferne", "Woher weisst Du denn davon?","gruebelt: ");
  AddInfo(({"geschichte","geschichten"}),
  	"Ach, Du bist doch schon viel zu alt ...","kichert: ");
  AddInfo("apfel","Du moechtest also einen Apfel? Den kann ich Dir aber "
  	"nur geben, wenn Du mir einen Gefallen tust. Ich bin zu alt um "
  	"noch zur Post zu laufen - wuerdest Du fuer mich einen Brief "
  	"aufgeben? Wenn ja, dann biete mir Deine Hilfe an.","fragt Dich: ");
  AddInfo("hilfe","Ich bin zu alt, um noch zur Post zu laufen - wuerdest "
  	"Du fuer mich einen Brief aufgeben? Wenn ja, dann biete mir Deine "
  	"Hilfe an.","fragt Dich: ");
  AddInfo("post","Sie befindet sich in der Naehe des Doore. Doch ist der "
  	"Weg fuer mich zu beschwerlich.","seufzt: ");
  AddInfo("weg","Warte nur, bis Du so alt bist wie ich!","grummelt: ");
  AddInfo("doore","Das ist die Kneipe in Elessar.","sagt: ");
  AddInfo("aerendil","Das ist der Bibliothekar in Elessar.","sagt: ");

  
  
  
  AddCmd("biete","biete");

}


int biete(string str)
{
  object ob;
  int ret;
  
  notify_fail("Wem moechtest Du was anbieten?\n");
  if(!str || str!="hilfe an") return 0;
  
  if(!TP) return 0;
  ob = deep_present("\nldfquest",TP);
  
  if(objectp(ob))
  {
  	write("Lundin sagt: Du hast doch schon einen Brief von mir.\n");
  	return 1;
  }
  
  write("Lundin sagt: Hier hast Du den Brief und als Belohnung den Apfel.\n");
  write("Lundin sagt: Bitte gib ihn mit \"sende brief\" fuer mich auf der Post auf.\n");
  
  ob = clone_object(OBJ+"apfel");
  ret = ob->move(TP);
  if(ret==MEE_TOO_HEAVY)
  {
  	write("Lundin sagt: Der Apfel ist zu schwer fuer Dich.\n");
  	ob->move(environment(TP));
  }
  ob = clone_object(OBJ+"brief");
  if(ret==MEE_TOO_HEAVY)
  {
  	write("Lundin sagt: Der Brief ist zu schwer fuer Dich.\n");
  	ob->move(environment(TP));
  }
  clone_object(OBJ+"ldfquest")->move(TP);
  ob->startquest(TP);
  return 1;
}