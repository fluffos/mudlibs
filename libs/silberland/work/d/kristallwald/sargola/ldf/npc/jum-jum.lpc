inherit "std/mnpc";
#include <mnpc.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"


create()
{
     if (!is_clone(TO)) return;  
     ::create();   
    
     
     SetProp(P_SHORT, "Jum-Jum");  
     SetProp(P_LONG, BS("Das ist Jum-Jum, der Sohn des Rosengaert"
       "ners. Er ist noch ziemlich jung und blickt Dich aus intere"
       "ssierten Augen an. Jum-Jum traegt eine zerfetzte Hose und "
       "ein abgewetztes Hemd. Sein Gesicht ist ganz braun vom vielen "
       "Spielen in der Sonne. "));
     
     AddDetail("sohn","Er ist der Sohn des Rosengaertners.");
     AddDetail(({"augen"}), "Sie blicken Dich offen und interessiert "
       "an.");
     AddDetail("hose","Die Hose, die Jum-Jum traegt ist erstaunlich "
       "abgewetzt. Aber das scheint ihn nicht sonderlich zu stoeren.");
     AddDetail("hemd","Das Hemd ist genauso wie die Hose ziemlich "
       "zerfetzt.");
     AddDetail("gesicht", "Das Gesicht ist ziemlich braun - wohl, weil "
       "Jum-Jum immer im Freien spielt.");       
     
    
     SetProp(P_GENDER, MALE);
     SetProp(P_ARTICLE, 0);  
     SetProp(P_NAME,"Jum-Jum");  
     AddId (({ "jum-jum"}));  
     create_default_npc (7);  
     SetProp(P_HANDS, ({" mit winzigen Faeusten", QueryProp(P_HANDS)[1], DT_BLUDGEON}));  
     
     SetProp(P_MSGIN, "laeuft herein");  
     SetProp(P_MSGOUT, "laeuft");  
  SetProp (P_MNPC_AREA, ({ROOM+"r", ROOM+"w1",ROOM+"w2", ROOM+"w3", ROOM+"w4"}));
  SetProp (P_MNPC_DEFAULTROOM, ROOM+"r2");
  // (Zeit bis erster Schritt, mindestens zeit aller weiteren schritte, wird zu zahl 2 addiert
  SetProp (P_MNPC_WAIT, ({30,40,40}));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS+MOV_MOVES);

     
     SetProp(P_RACE, "Mensch");  
     SetProp(P_ALIGN, 450); 
     SetProp(P_SIZE, 130);
     SetProp(P_BODY, 60);
     SetProp(P_XP, 0);		//Quest-NPC :)
     SetProp(P_NOATTACK,"sieht Dich nur fragend an.");
     SetProp(P_REJECT,
       ({REJECT_DROP,"Damit kann man nicht gut spielen.\n"}) );
   
     AddInfo(({"pferd","miramis"}), "Ich durfte schon mit ihm reiten!","prahlt: ");
     AddInfo(DEFAULT_INFO,
     	"Gehn wir lieber spielen!","ruft begeistert: ");
     AddInfo("mutter","Du findest sie meistens im Haus suedoestlich im "
       "Rosengarten.","sagt: ");
     AddInfo("sargola","Sargola ist so herrlich kindisch - mit ihm kann ich "
       "wunderbar spielen.","grinst: ");
     AddInfo("gridi","Sie stibizt meist das Erdbeerkompott von meiner Mutter.",
       "grinst: ");
     AddInfo("dschinn","Mit ihm kann man nicht gut spielen - der grinst "
       "immer so irre!","sagt: ");
     AddInfo(({"vogel", "voegel"}), "Die Voegel rauben meiner Mutter den letzten "
       "Nerv. Sie fliegen in unserem Haeuschen ein und aus.","kichert: ");
     AddInfo( ({"teig","rezept"}), "Das Rezept fuer den Teig kennt nur meine "
       "Mutter.","erklaert: ") ;    
     AddInfo(({"rosenstraeucher","strauch","straeucher","busch",
       "rosenbusch","buesche","rosenbuesche","rosen","lilien",
       "pappeln","silberpappeln","rosengarten","garten"}),
        "Mein Vater kuemmert sich darum.", "sagt: ");
     AddInfo("vater","Das ist der Rosengaertner.","behauptet: ");
     AddInfo("koenig","Der Koenig ist immer gut zu meinem Vater gewesen.", "sagt: ");
     AddInfo("silberland","Das gibt es doch nicht wirklich! Daran glauben nur "
      "Kinder!", "erklaert ueberzeugt: ");
     AddInfo("kinder","Die, die an das Silberland glauben. Ich aber bin schon "
       "gross! Alt genug, um Abenteuer zu bestehen.","prahlt: ");
     AddInfo("abenteuer","Ach ich wuerde soo gern ein Abenteuer wie Du erleben. "
       "Du wirst gegen Ritter Kato antreten und ich muss wohl hier auf Deine "
       "Rueckkehr warten.","sagt: ");
     AddInfo(({"boesewicht","ritter","kato"}), "Es ist der verschlagenste und uebelste Boese"
       "wicht den ich kenne. Und keiner ist bisher gegen ihn angetreten. "
       "Ich glaube, der Koenig setzt grosse Hoffnungen in Dich.","sagt: ");
     AddInfo(({"hoffnung","hoffnungen"}),"Ich teile diese Hoffnungen!","jubelt Dir zu: ");
      

     AddInfo(({"land","land der ferne","ferne"}),
       "Hier gibt es viel zu entdecken.", "gibt an: ");
     AddInfo("palatschinken","Die besten im ganzen Land macht meine Mutter!",
       "grinst: ");
       

     AddInfo(({"haus","haeuschen"}),"Meine Familie und ich leben hier.","sagt: ");
     AddInfo("familie","Wir wohnen in einem bescheidenen Haeuschen im Sued"
       "osten des Rosengartens.","sagt: ");
     AddInfo("hunger","Wenn ich welchen habe, gehe ich nach Hause und esse "
       "etwas. Was machst Du denn in so einem Fall?","fragt: ");
     AddInfo("fall","Was meinst Du?","fragt: ");
     AddInfo("gegenden","Ich kenne den Rosengarten, das Schloss und die Weide!",
       "fetzt rein: ");
     AddInfo("schloss","Ich durfte nur einmal hinein. Aber es ist wundervoll "
       "prunkvoll dort drinnen.","seufzt: ");
     AddInfo("weide","Die Weide liegt westlich vom Rosengarten.","sagt: ");
     AddInfo("vogel","Ich kenne den Vogel, den Du meinst. Er sitzt immer "
       "auf der hoechsten Silberpappel und singt das traurigste Lied, das "
       "man sich vorstellen kann.","erklaert traurig: ");
     AddInfo("lied","Es ist so unheimlich traurig ... es hat sicher etwas mit "
       "Ritter Kato zu tun.","sagt: ");
     AddInfo("klang","Hmm... Du suchst also einen schoenen Klang ... "
       "den schoensten kann Dir glaube ich Nonno liefern. Frag ihn "
       "doch einmal nach seinen Hirtenliedern!","sagt: ");
     AddInfo("mondscheingewebe","Davon habe ich noch nicht gehoert.","sagt: ");
     AddInfo("mantel","Ich habe leider keinen Mantel fuer Dich.","sagt: ");
     AddInfo("nonno","Er passt oft auf der Weide auf die Schafe und Kuehe auf "
       "und kann herrliche Hirtenlieder spielen.","sagt: ");
     AddInfo(({"schafe","kuehe"}), "Die lungern immer auf der Weide herum.");
     AddInfo(({"lieder","hirtenlieder"}), "Da musst Du Nonno fragen.","sagt: ");
   
     
     
     SetChats(3, ({
	"Jum-Jum ruft: Spielen wir verstecken!\n",
	"Jum-Jum huepft gutgelaunt durch die Rosen.\n",
	"Jum-Jums Magen knurrt - er hat wohl Hunger.\n",
	"Jum-Jum schwaermt von den Palatschinken seiner Mutter.\n",
	"Jum-Jum laechelt Dich an.\n",
	"Jum-Jum erzaehlt Dir von weiter entfernten Gegenden.\n"}));
	
} 

