inherit "std/mnpc";
#include <mnpc.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"
#include "../../dorf/obj/ldfquest.h"


string antritt();
string lampe();
string miramis();


land();

create()
{
     if (!is_clone(TO)) return;  
     ::create();   
     SetProp(P_SHORT, "Der Koenig");  
     SetProp(P_LONG, BS("Der Koenig vom Land der Ferne ist genauso, wie "
       "Du ihn dir vorgestellt hast. An seiner Ausstrahlung merkst Du, "
       "dass er hier wirklich etwas zu sagen hat. Er traegt eine kleine "
       "aber glitzernde Krone am Kopf und hat eine wallende "
       "Robe. Er lustwandelt hier offensichtlich durch die Rosen"
       "gaerten. Ein trauriger Ausdruck in seinen dunklen Augen irri"
       "tiert Dich."));
       
     AddDetail(({"autoritaet","ausstrahlung"}),"Sie kann man nicht "
       "sehen, aber Du spuerst, dass er eine natuerliche Autoritaet hat.");
     AddDetail("krone","Die Krone ist nicht gerade gross und imposant, "
       "aber doch fein gearbeitet und sicherlich sehr, sehr wertvoll.");
     AddDetail("kopf","Auf ihm thront eine Krone.");
     AddDetail("ausdruck","Obwohl es hier doch paradiesisch schoen ist, "
       "bemerkst Du doch einen traurigen Ausdruck in den Augen des "
       "Koenigs.");
     AddDetail("augen","Sie sind erfuellt von tiefer Betruebtheit.");
     AddDetail("betruebtheit","Der Koenig blickt Dich fragend an.");
     AddDetail("gesicht","Das Gesicht des Koenigs ist von seinen hellen, "
       "blauen Augen bestimmt.");
     AddDetail("augen","Die Augen des Koenigs sind hellblau und zwinkern "
       "Dich froehlich an. Und doch glaubst Du tief auf dem Grund "
       "ein Unbehagen zu fuehlen.");
     AddDetail("grund","Er ist blau wie seine Augen.");
     AddDetail("unbehagen","So etwas wie Unbehagen.");    
     
     SetProp(P_GENDER, MALE);  
     SetProp(P_NAME, ({"Koenig","Koenigs","Koenig","Koenig"}));  
     AddId (({ "koenig"}));  
     create_default_npc (20);  
     SetProp(P_HANDS, ({" mit edlen, feinen Haenden", QueryProp(P_HANDS)[1], DT_BLUDGEON}));  
   
     SetProp(P_MSGIN, "spaziert herein");  
     SetProp(P_MSGOUT, "spaziert weiter");  
     SetProp(P_MMSGIN, "spaziert herein");  
     SetProp(P_MMSGOUT, "spaziert weiter"); 
     SetProp(P_RACE, "Mensch");  
     SetProp(P_ALIGN, 850);  
     SetProp(P_SIZE, 175);
     SetProp(P_BODY, 120);
     SetProp(P_XP, 0);		//Quest-NPC :)
     SetProp(P_REJECT,
       ({REJECT_DROP,"Der Koenig hat fuer so etwas keine Verwendung.\n"}) );
     
     CLONEME(ARMOUR+"robe");
     CLONEME(ARMOUR+"krone");
     
  SetProp (P_MNPC_AREA, ({ROOM+"r", ROOM+"warteraum"}));
  SetProp (P_MNPC_DEFAULTROOM, ROOM+"r1");
  // (Zeit bis erster Schritt, mindestens zeit aller weiteren schritte, wird zu zahl 2 addiert
  SetProp (P_MNPC_WAIT, ({10,40,40}));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS+MOV_MOVES);


   
     AddInfo(DEFAULT_INFO,
     	"Ich bin zwar Koenig, ich kann aber nicht alles wissen.","erklaert: ");
     AddInfo("sargola","Wie kommst Du denn gerade auf ihn?","fragt: ");
     AddInfo("gridi","Sie spaziert gern durch den Rosengarten.","sagt: ");
     AddInfo("seufzer","Hach ... *seufz*","seufzt: ");
     AddInfo("dschinn","Er stand frueher in meinen Diensten - bis er irre "
       "wurde. Schade eigentlich...","sefuzt: ");
     AddInfo("rosen","Ich finde Rosen wunderbar, Du nicht auch?.", "schwaermt: ");
     AddInfo("koenig","Der Koenig und ich sind spirituell Eins.", "philosophiert: ");
     AddInfo("eins","Das ist die Zahl vor zwei.","erklaert: ");
     AddInfo("zwei","Noch groesser ist nur Viel ... meinen die Zwerge.","sagt: ");
     AddInfo("viel","Wieviel Viel ist, weiss ich auch nicht genau.","erroetet: ");
     AddInfo("zwerge","Im Land der Ferne kenne ich keinen!","triumphiert: ");
     AddInfo("silberland","Weit entfernt soll es sowas geben - aber ich glaube fast, "
       "das ist ein Maerchen.", "sagt: ");
     AddInfo(({"lied","vogel","melodie"}), "Ja, der Vogel trauert um die vielen Leute, "
       "die von Ritter Kato entfuehrt worden sind.","seufzt: ");
     AddInfo("maerchen","Ob das Silberland eines ist?","denkt: ");

     AddInfo("lilien","Ich mag die weissen Lilien mindestens so wie die Rosen.","sagt:");

     AddInfo(({"land","land der ferne","ferne"}),#'land);

     AddInfo(({"schloss","gebaeude"}),"Im Schloss halte ich mich, obwohl ich mich "
       "darin wohl fuehle, selten auf. Lieber wandere ich durch den Garten oder "
       "spaziere auf der Weide.","sagt: ");
     AddInfo(({"weiden","weide"}),"Im Suedwesten des Gartens fuehrt ein Weg weiter zu den Weiden.",
	"sagt: ");
     AddInfo(({"rosengarten","garten"}), "Gern spaziere ich auf seinen Wegen.", "sagt: ");
     AddInfo(({"pappeln","silberpappeln"}),"Das Klingen der Pappeln macht mich "
	"froh im Herzen. Und abends, da sieht es so aus, als ob ihre Spitzen in "
	"den Sternen brennen wuerden.","laechelt: ");
     AddInfo("sterne","Wenn es hier abend wird, kann man sie sehen.");
     AddInfo("abend","Noch ist es nicht soweit.","sagt: ");
     AddInfo("spitzen","Seit langer, langer Zeit schon wachsen die Silberpappeln "
       "in in den Himmel zu den Sternen.", "sagt: ");
     AddInfo(({"herzen","herz"}),"Pass nur auf, dass Du Deines nicht einbuesst...","fluestert geheimnisvoll: ");
     AddInfo("klingen","Lausch doch mal!","meint: ");
     AddInfo("blueten","Ich liebe es, wenn sich die Luft mit dem Duft der "
       "bluehender Rosen erfuellt.","sagt: ");
     AddInfo("dornen","Die Rosen erfreuen nur mein Auge.","sagt: ");
     AddInfo("auge","Das war nun nicht woertlich gemeint.","grinst: ");
     
     
     AddInfo( ({"traurigkeit","augen"}),"Es gibt einen bestimmten Grund, warum ich "
       "so traurig wirke.","seufzt: ");
     AddInfo("grund","Nunja ... das ist eine lange Geschichte.");
     AddInfo("geschichte","Nun gut, wie Du willst - ich erzaehle Dir die Geschichte "
       "vom grausamen Ritter Kato.","erzaehlt: ");
     AddInfo("ritter","Ja, er nennt sich Ritter, obwohl er keiner ist.", "grummelt. ");
     AddInfo("unzeiten","Solange ich denken kann...","sagt: ");
     AddInfo("angst","Als Koenig hab ich natuerlich keine Angst - aber fuer einen "
       "Kampf bin ich mir zu gut *prahl*. Eventuell koenntest ja Du gegen ihn "
       "antreten.","sagt: ");
     AddInfo(({"kampf","antritt"}),#'antritt);
     
     AddInfo("not","Ja, was glaubst Du, warum ich so traurig bin?","fragt: ");
     AddInfo(({"gaertner", "rosengaertner"}), "Hast Du ihn schon getroffen? Er "
       "kuemmert sich wirklich vorzueglichst um meinen schoenen Garten.",
       "freut sich: "); 




     AddInfo("jum-jum","Jum-jum ist der Sohn des Rosengaertners. Am Besten, Du "
       "fragst ihn nach Jum-jum.","sagt: ");
     AddInfo("vogel","Ich kenne ihn ... Willst Du die Geschichte hoeren?","erklaert lakonisch: ");
     AddInfo("geschichte","Der Vogel trauert den entfuehrten Leuten und Pferden "
       "nach, die von Ritter Kato entfuehrt wurden.","erzaehlt: ");
     AddInfo(({"leute","pferde"}), "Unzaehlige Leute im ganzen Land wurden "
       "von Ritter Kato seit langer Zeit schon heimlich des naechtens ent"
       "fuehrt.","erzaehlt: ");
     AddInfo(({"kato", "ritter kato"}), "Ich habe ihn nie gesehen, "
       "aber er muss sehr gefaehrlich sein. Besonders in der Nacht. Er terrori"
       "siert unser liebliches Land schon seit Unzeiten und alle haben Angst "
       "vor ihm.","seufzt: ");
     AddInfo("nacht","Er ist ein Wesen des Boesen ... besonders maechtig ist "
       "er in der Nacht. Deswegen lassen wir auch die Bruecke des Morgen"
       "grauens abends herunter.", "erzaehlt: ");
     AddInfo("wesen","Ob er ein Mensch ist? Vielleicht ein Monster?","gruebelt: ");
     AddInfo("monster","Achwas, das waere ja dann eine zu schwere "
       "Quest!","grinst: "); 
     AddInfo(({"bruecke","bruecke des morgengrauens"}), "Sie befindet sich noerdlich der "
       "Weiden und ueberbrueckt eine tiefe Schlucht.","erzaehlt: ");
     AddInfo("schlucht","Sie wird von der Bruecke nur teilweise ueberbrueckt. "
       "Man kann nicht so hinuebergehen - die Bruecke hoert in der Mitte auf!","sagt: ");
     AddInfo("morgengrauen","Ich weiss auch nicht, wie sie zu dem Namen kam.",
       "erzaehlt: ");
     AddInfo("mitte","Dort gibt es keine Bruecke - es dient zum Schutz gegen "
       "Ritter Kato.","sagt: ");
     AddInfo("schutz","Wir muessen uns gegen ihn schuetzen.","sagt: ");
     
     
     AddInfo(({"haus","haeuschen"}),"Du meinst das Haus des Rosengaertners und "
       "seiner Familie?.", "fragt: ");
     AddInfo("mantel","Wo Du einen herbekommst, kann ich Dir leider nicht "
       "sagen.","sagt: ");
     AddInfo("mondscheingewebe","Das Mondscheingewebe existiert nur im "
       "Land der Ferne und die Spaeher koennen Dich mit ihm schwieriger "
       "erkennen.","sagt: ");
     AddInfo("spaeher","Die Spaeher dienen Ritter Kato und bekaempfen alles, "
       "was sich ihnen in den Weg stellt.","sagt: ");
     AddInfo("klang","Hmm... da wird Dir schon was einfallen. Auf jeden "
       "Fall musst Du den Klang bis ins Reich von Ritter Kato bringen. Mit "
       "ihm ist es Dir moeglich, seinen Zauber zu brechen. Die Wirkung "
       "beschraenkt sich allerdings nur auf kleine Orte.","erklaert: ");
     AddInfo("reich","Sein Reich ist stark gewachsen.","seufzt: ");
     AddInfo("zauber","Er verfuegt ueber eine maechtige Magie, die alles "
       "in ihrem Umkreis eingehen laesst - Tiere und Pflanzen.","seufzt: ");
     AddInfo("magie","Ritter Kato verfuegt ueber starke Magie.","warnt: ");
     AddInfo("umkreis","Genau weiss ich das auch nicht.","sagt: ");
     AddInfo(({"tiere","pflanzen"}),"Sie verenden unter seiner schreck"
       "lichen Macht.","seufzt: ");
     AddInfo("macht","Seine Macht ist nicht zu unterschaetzen!","warnt Dich: ");
     AddInfo(({"lampe","oellampe"}),#'lampe);
     AddInfo(({"miramis","pferd"}), #'miramis);
     
     
     SetChats(5, ({
       "Der Koenig riecht an der Bluete einer Rose.\n",
       "Der Koenig blickt froehlich und doch traurig um sich.\n",
       "Ein winziger, kaum hoerbarer Seufzer entkommt dem Koenig.\n",
       "Der Koenig lauscht dem Gesang eines Vogels und seufzt.\n",
       "Der Koenig summt melancholisch mit dem Gesang eines Vogels mit.\n",
       "Der Koenig laedt Dich ein, doch noch ein wenig hier zu bleiben.\n"}) );
       
} 

string miramis()
{
  object ob;
  int val,mantel,flasche;
  
  tell_object(TP, 
"Der Koenig sagt: Ein tolles Pferd, nicht? Mit ihm kannst Du ueber die Bruecke\n"
"Der Koenig sagt: springen.\n");
  
  ob = deep_present("\nldfquest",TP);
  if(objectp(ob))
  {
    val = ob->frage_wert(ERLAUBNIS);
    mantel = ob->frage_wert(MANTEL);
    flasche = ob->frage_wert(FLASCHE);
  }
  
  if(val==1)
  {
    return "sagt: Und Du darfst schon mit Miramis reiten.\n";
  }
  else
  {
    if(flasche == 3 && mantel ==2)
    {
      ob->setze_wert(ERLAUBNIS,1);
      return 
"sagt: Ich erlaube Dir, mit Miramis ueber die Bruecke zu springen.\n"
"Der Koenig sagt: Viel Glueck!\n",
"Der Koenig legt Dir die Hand auf die Stirn und segnet Dich ein letztes Mal.\n";
    }
  }
}

string land()
{
  return 
"sagt: \"Dies ist ein wunderschoenes Land, findest Du nicht?\"\n"
"Dir faellt ein seltsam bedrueckter Ausdruck im Gesicht des Koenigs auf.\n";
}

antritt()
{

  object flasche,mantel,ob; 
  int okm, okf;
  mantel = deep_present("\nldfmantel",TP);
  flasche = deep_present("\nldfflasche",TP);
  ob = deep_present("\nldfquest",TP);


  if(objectp(mantel)) okm = ob->frage_wert(MANTEL);
  if(objectp(flasche)) okf = ob->frage_wert(FLASCHE);

  if(okm==1)
  {
    return "sagt: Der Mantel hat leider ein Loch.\n";
  }
  else if(okm==2 && okf==3)	//beides korrekt erledigt
  { ob->setze_wert(ERLAUBNIS,1);
    return
 	"sagt: Toll! Nachdem Du alle Dinge beisammen hast, kannst Du Dich\n"
	"Der Koenig sagt: auf den Weg machen. Du darfst mit Miramis ueber die Bruecke\n"
	"Der Koenig sagt: springen.\n";
	
  } 
  else
  {
  return
	"sagt: Ich hatte gehofft, dass Du Dich bereit erklaeren wuerdest.\n"
	"Der Koenig sagt: Aber ohne gute Vorbereitung lasse ich nicht zu, dass Du\n"
	"Der Koenig sagt: Dein Leben riskierst - unterschaetze Ritter Kato nicht!\n"
	"Der Koenig sagt: Ich kann Dir bei Deinem Kampf nicht helfen, aber ich kann\n"
	"Der Koenig sagt: Dir ein paar wichtige Hinweise mitgeben, die Dir helfen\n"
	"Der Koenig sagt: koennen. Erstens brauchst Du einen Mantel aus Mondschein-\n"
	"Der Koenig sagt: gewebe.Zweitens brauchst Du den lieblichen Klang unseres\n"
	"Der Koenig sagt: Landes. Wenn Du beides beisammen hast, frag mich noch\n"
	"Der Koenig sagt: einmal nach dem Antritt.\n";
  }
}


string lampe()
{
  object ob;
  int val;
  ob = deep_present("\nldfquest",TP);
  if(objectp(ob)) val = ob->frage_wert(FLASCHE);
  if(val==0)
  {
    ob->setze_wert(FLASCHE,1);	//2 = man hat gefragt, 1 = man hat es bekommen
    
    if(find_call_out("koenig_wieder_her")!=-1)
      call_out("koenig_wieder_her",60);
    TO->move(ROOM+"warteraum", M_GO);
    return "sagt: Hmm... ich glaube, ich habe in meinem Schloss irgendwo eine.\n"
      "Der Koenig sagt: Komm spaeter nochmal - ich sehe fuer Dich nach.";
    
  }
  else if(val==2)
  {
    return "sagt: Du hast doch schon eine Oellampe von mir bekommen!";
  }
  else if(val==1)
  {
    if(find_call_out("koenig_wieder_her")>=0)
      return "sagt: Ich muss erst suchen.";
      
    
    ob = clone_object(OBJ+"lampe");
    tell_object(TP, "Der Koenig sagt: Ich habe eine Lampe, die Dir gefallen muesste.\n");
    val = ob->move(TP);
    if(val==ME_TOO_HEAVY)
    {
      tell_object(TP, "Der Koenig sagt: Du kannst die Lampe nicht mehr tragen.");
      ob->move(environment(TP));
    }
    ob = deep_present("\nldfquest",TP);
    if(objectp(ob)) ob->setze_wert(FLASCHE,2);	//lampe bekommen
    return "reicht Dir eine winzige Lampe.";
  }
}

koenig_wieder_her()
{ 
  TO->move(ROOM+"r4", M_GO);
}

