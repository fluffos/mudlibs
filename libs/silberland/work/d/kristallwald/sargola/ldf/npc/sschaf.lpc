

inherit "std/mnpc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>



create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Schaf");
  SetProp(P_LONG, BS(
    "Das Schaf hat ein dickes, schwarzes Fell - sehr ungewoehnlich. Sicher "
    "ist es schon lange nicht mehr geschoren worden.") );
  SetProp(P_NAME, "Schaf");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schaf","\nldfschaf"}) );

  create_default_npc(9);
  SetProp(P_HANDS, ({" mit seinen Hufen", 70, DT_BLUDGEON}));
  SetProp(P_RACE, "Schaf");
  SetProp(P_SIZE, 100+random(10));
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE, ({DT_COLD}) );
  SetProp(P_WIMPY, 50);
  SetProp(P_WIMPY_DIRECTION, "emote bloekt angsterfuellt");
  SetProp(P_HEAL, 5);

  SetProp(P_MSGIN, "kommt bloekend an");
  SetProp(P_MSGOUT, "trottet bloekend");
  SetProp(P_MMSGIN, "kommt bloekend an");
  SetProp(P_MMSGOUT, "trottet weit weg");
  SetProp(P_MNPC_AREA, ROOM );
  SetProp(P_MNPC_WAIT, ({ 10, 40, 35 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "w2");
  SetProp(P_MNPC_FLAGS,
    MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INFIGHT);

  AddInfo(DEFAULT_INFO, "bloekt.\n" );
  AddInfo("sargola", "Den kennst Du auch?", "bloekt fragend: ");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Das Schaf schnuppert nur an Deinen Sachen.\n"}));
  SetProp(P_DIE_MSG, " bloekt das letzte Mal.\n");

  SetChats(2, ({
    "Das Schaf knabbert an dem spaerlichen Gras.\n",
    "Das Schaf schaut Dich daemlich an.\n",
    "Das Schaf schaut dumm durch die Gegend.\n",
    "Das Schaf bettelt nach Salz.\n",
    "Das Schaf laesst einen stinkenden Haufen fallen.\n",
    "Das Schaf trabt ein Stueck weiter.\n",
    "Das Schaf frisst etwas Gras.\n",
    "Das Schaf bloekt laut.\n",
    "Das Schaf bloekt leise.\n",
    "Das Schaf bloekt.\n"}) );

  AddCmd( ({"huete", "huet"}), "hueten");
  AddCmd( ({"schere", "scher"}), "schere");
}

int hueten(string str)
{
  notify_fail("Wen willst Du hueten?\n");
  if( str== "schaf" || str=="schafe" )
  {
    write("Das macht hier sicher ein Anderer!\n");
    return 1;
  }
  return 0;
}

int scheren(string str)
{
  notify_fail("Wen willst Du scheren?\n");
  if( str== "schaf" || str=="schafe" )
  {
    write("Du traust Dich nicht zu, das Schaf fachgerecht zu scheren.\n");
    return 1;
  }
  return 0;
}

void give_notify(object ob)
{
  if( ob->QueryMaterial(MAT_FOOD) )
  {
    tell_room(MENV, "Das hungrige Schaf frisst gierig alles auf.\n");
    ob->remove();
    return;
  }
  ::give_notify(ob);
}


init()
{
  ::init();
  if (TP && TP->id("kuh")) AddDefender(TP);
  if (TP && TP->id("schaf")) AddDefender(TP);
}
