inherit "std/mnpc";
#include <mnpc.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"
#include "../../dorf/obj/ldfquest.h"


string hirtenlieder();
nonno_spielt();
string geraet();

create()
{
     if (!is_clone(TO)) return;  
     ::create();   
    
     
     SetProp(P_SHORT, "Nonno");  
     SetProp(P_LONG, BS("Vor Dir steht Nonno, der Hirtenjunge. "
       "Er ist den ganzen Tag und auch oft die Nacht durch auf "
       "der Weide und passt auf die Schafe und Kuehe auf. Er "
       "traegt zerschlissene Kleidung und hat struppige Haare."));
     
     AddDetail("junge","Er ist noch recht jung.");
     AddDetail(({"tag","nacht"}), "Als echter Hirte muss er auch "
       "waehrend der Nacht auf seine Tiere aufpassen.");
     AddDetail("kleidung","Eine zerschlissene Hose und ein eben "
       "so schlechtes Hemd.");
     AddDetail("hose","Die Hose haettest Du wohl schon lange weg"
       "geworfen. Aber Nonno ist das augenscheinlich egal.");
     AddDetail("hemd","Das Hemd ist genauso wie die Hose ziemlich "
       "lang getragen worden (nett ausgedrueckt).");
     AddDetail("haare","Sieh sie Dir lieber nicht aus der Naehe "
       "an ... wer weiss, was da alles zum Vorschein kommt ...");
     AddDetail("vorschein","Hast Du da nicht gerade eine Laus ge"
       "sehen? ... ");
     AddDetail("laus", " Hmm.... Du kannst keine erkennen.");
            
     
    
     SetProp(P_GENDER, MALE);
     SetProp(P_ARTICLE, 0);  
     SetProp(P_NAME,"Nonno");  
     AddId (({ "nonno","junge"}));  
     create_default_npc (10);  
     SetProp(P_HANDS, ({" mit kleinen Faeusten", QueryProp(P_HANDS)[1], DT_BLUDGEON}));  
     
     SetProp(P_MSGIN, "huetet hier die Schafe");  
     SetProp(P_MSGOUT, "streunt");
      SetProp(P_MNPC_AREA, ({ ROOM "w2", ROOM "w2", ROOM "w3", ROOM "w4",
                          ROOM "w5", ROOM "w6", ROOM "w7" }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM+"w4");
  // (Zeit bis erster Schritt, mindestens zeit aller weiteren schritte, wird zu zahl 2 addiert
  SetProp (P_MNPC_WAIT, ({30,50,50}));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS+MOV_MOVES);  
     
     SetProp(P_RACE, "Mensch");  
     SetProp(P_ALIGN, 450); 
     SetProp(P_SIZE, 130);
     SetProp(P_BODY, 60);
     SetProp(P_XP, 0);		//Quest-NPC :)
     SetProp(P_REJECT,
       ({REJECT_GIVE,"Nonno sagt: Danke, das kann ich nicht brauchen.\n"}) );
   
     AddInfo(DEFAULT_INFO,
     	({"sagt: Darueber mag ich jetzt lieber nicht reden.",
	  "bohrt nachdenklich in der Nase.\n",
	  "kichert verlegen.\n"}) );

     AddInfo(({"wolle","schafswolle","schafwolle"}),"Wenn ich die Schafe schere "
       "erhalte ich die Wolle. Willst Du sie auch scheren?","fragt: ");
     AddInfo(({"hirtenfloete","floete"}),"Damit spiele ich immer meine "
       "Hirtenlieder.");
     AddInfo("jum-jum","Der rennt oft hier oder im Rosengarten herum. Mit "
       "ihm kann man nett spielen und herumtollen.","sagt: ");
     AddInfo("sargola","Sargola kommt selten hier her.","seufzt: ");
     AddInfo("koenig","Unser Koenig ist ein weiser und gerchter Koenig.",
       "erklaert: ");
     AddInfo("weberin","Sie wohnt im Norden bei der Schlucht und kommt "
       "oefters her, wenn ich meine Schafe geschoren haben.","erklaert: ");
     AddInfo("schafe","Ich passe auf sie auf und schere sie von Zeit zu "
       "Zeit.","sagt: ");
     AddInfo("kuehe","Auf die Kuehe muss man kaum aufpassen - die rennen "
       "selten weg.","grinst: ");
     AddInfo("lisa","Lisa war eine gute Freundin von mir ... leider ist "
       "sie vor einiger Zeit verschwunden...","seufzt: ");
     AddInfo("freundin","Ja ... Ritter Kato hat meine beste Freundin ent"
       "fuehrt!","sagt verbittert: ");
     AddInfo(({"ritter","ritter kato","kato"}), "Er entfuehrt immer wieder "
       "Leute in sein dunkles Reich hinter der Schlucht.","schluchzt: ");
     AddInfo("leute","Es waren schon so viele...","seufzt: ");
     AddInfo("reich","Ich mag nicht mehr darueber reden.","seufzt: ");
     AddInfo("schlucht","Die Schlucht findest Du im Norden. Sie wird von "
       "der Bruecke des Morgengrauens ueberbrueckt - aber nicht ganz. In "
       "der Mitte ist sie zu Ende.","erklaert: ");
     AddInfo(({"bruecke","morgengrauen"}), "Sie ueberbrueckt die Schlucht "
       "im Norden.","erzaehlt: ");
     AddInfo("mitte","In der Mitte fehlt ein Stueck - man kann nicht einfach "
       "auf die andere Seite spazieren.");
     AddInfo("seite","Die andere Seite ist viel gefaehrlicher!","erschrickt: ");
     
     
     
     AddInfo("silberland","Das gibt es doch nicht wirklich! Daran glauben nur "
      "Kinder!", "erklaert ueberzeugt: ");
     AddInfo("kinder","Die, die an das Silberland glauben.","prahlt: ");
    
     AddInfo(({"land","land der ferne","ferne"}),
       "Hier gibt es viel zu entdecken.", "gibt an: ");
   
     AddInfo("schloss","Ich durfte nur einmal hinein. Aber es ist wundervoll "
       "prunkvoll dort drinnen.","seufzt: ");
     AddInfo("weide","Das ist hier.","sagt: ");
     AddInfo(({"windrichtung","wind"}), "Ich muss immer wissen, wie das "
       "Wetter wird.","sagt: ");
     AddInfo(({"geraet","schere","schergeraet"}), #'geraet);
       
     AddInfo(({"lieder","lied","hirtenlied","hirtenlieder"}),#'hirtenlieder);

     SetChats(3, ({
	"Nonno holt seine Hirtenfloete hervor.\n",
	"Nonno spielt ein wunderschoenes Lied.\n",
	"Ein Schaf trampelt um Nonno herum.\nNonno grinst das Schaf an.\n",
	"Nonno prueft die Windrichtung.\n",
	"Nonno pfeift ein Schaf zurueck.\n"}));
	
} 

string hirtenlieder()
{
  
  object ob;
  int val;
  ob = deep_present("\nldfquest",TP);
  if(objectp(ob)) val = ob->frage_wert(FLASCHE);
  tell_object(TP, BS("Nonno holt seine Hirtenfloete heraus und "
      "beginnt mit einem wunderschoenen Hirtenlied."));
  if(val == 2)
  {
    if(find_call_out("nonno_spielt")==-1)
      call_out("nonno_spielt",60);
    tell_object(TP, "Das waere eine gute Gelegenheit, einen Klang zu fangen.");
    return "pfeift lustig vor sich hin.\n";
  }
  return "spielt sich die Seele aus dem Leib.\n";
      
}

nonno_spielt()
{
  //blah
}

string geraet()
{
   object ob;
   int a,ret;
   ob = deep_present("\nldfquest",TP);
   if(objectp(ob)) a = ob->frage_wert(SCHERE);
   if(a==0)
{

   tell_object(TP, "Nonno grinst: Du kannst Dich gern an den Schafen versuchen.\n");
   tell_object(TP, "Nonno gibt Dir eine Schere zum scheren der Schafe.\n");
   ob = clone_object(OBJ+"schere");
   ret = ob->move(TP);
   if(ret==ME_TOO_HEAVY)
   {
     tell_object(TP, "Die Schere ist fuer Dich zu schwer.\n");
     ob->move(environment(TP));
   }
   ob = deep_present("\nldfquest",TP);
   if(objectp(ob)) ob->setze_wert(SCHERE,1);
   return "lacht sich ins Faeustchen.\n";
}
else
{
  return " sagt: Du hast doch schon eine von mir bekommen.\n";
  
}


}
   
   
   
   
   
   
   
