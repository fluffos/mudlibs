  if(ob=enemy->QueryProp(P_WEAPON))
    enemy->drop_obj(ob);
}
*/
void DefaultSpell_Fear(object enemy, int damage, mixed dam_type)
{
  enemy->SetProp(P_WIMPY, enemy->QueryProp(P_HP)+1);
  enemy->CheckWimpyAndFlee();
}



void DefaultSpell_CurseArmour(object enemy, int damage, mixed dam_type)
{
  object ob;
  object *armours;
  if( sizeof(armours=enemy->QueryProp(P_ARMOURS)) )
  {
    ob=armours[random(sizeof(armours))];
    ob->SetProp(P_CURSED, 
      ob->Name(WER,1)+" ist verflucht und laesst sich nicht mehr ausziehen\n");
  }
}

      
void Defend(int dam, string dam_type, int spell, object enemy)
{
  object ob;
  ::Defend(dam, dam_type, spell, enemy);	
  if(objectp(enemy))
    ob = enemy->QueryProp(P_WEAPON);
    
  
  // wenn es das richtige schwert ist und man mit chance 1/20 trifft
  // QUEST-ENDE :)
  if(objectp(ob) && ob->id("\nldfschwert")!=0)
  {
  	ob = deep_present("\nldfquest",enemy);
  	if(objectp(ob))
  	  ob->finish_quest();
  }
}

