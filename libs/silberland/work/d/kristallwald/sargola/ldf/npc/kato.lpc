inherit "std/npc";
inherit "std/npc/spells";
#include <properties.h>
#include <language.h>
#include <moving.h>

#include "../def.h"


//void DefaultSpell_Disarm(object enemy, int damage, mixed dam_type);
void DefaultSpell_Fear(object enemy, int damage, mixed dam_type);
void DefaultSpell_Fear(object enemy, int damage, mixed dam_type);
void DefaultSpell_CurseWeapon(object enemy, int damage, mixed dam_type);
void DefaultSpell_CurseArmour(object enemy, int damage, mixed dam_type);
void blah(object ob);

create()
{

  object ob;
  if (!is_clone(TO)) return;
     ::create();

  SetProp(P_SHORT, "Ritter Kato");
  SetProp(P_LONG,
	"Ritter Kato starrt Dich vor Hass und Feindseligkeit bitterboese "
	"an. Seine Augen funkeln und verhuellen kaum den Wunsch, Dich "
	"Dich zu toeten. Er ist in einen schwarzen Umhang aus Samt geklei"
	"det und sogar seine Haare sind schwarz. In seiner Hand funkelt ein "
	"gefaehrlich aussehendes Schwert.");


  SetProp(P_NAME, "Ritter Kato");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE,0);	
  AddId( ({"ritter","kato","ritter kato"}));

  create_default_npc(30);
  SetProp(P_HANDS, ({" mit starken Haenden",QueryProp(P_HANDS)[1],
  	DT_SQUEEZE}));
  SetProp(P_RACE, "Mensch");
  
  AddDetail("augen","Seine Augen funkeln vor Hass und Feindseligkeit "
    "bitterboese. Du kannst leicht daran ablesen, dass er nur einen "
    "Wunsch hat: Dich zu toeten!");
  AddDetail(({"hass","feindseligkeit"}), "Du duckst Dich lieber vor "
    "solcher Feindseligkeit.");
  AddDetail("wunsch","Frag ihn einfach mal danach!");
  AddDetail("haare","Erstaunlicherweise sind sogar seine Haare tiefschwarz! "
    "Doch als Du genauer hinsiehst, faellt Dir am Haaransatz etwas auf.");
    
  AddDetail(({"ansatz","haaransatz"}), "Du kannst es kaum glauben!! "
    "Der Haaransatz von Ritter Kato ist braun! Scheinbar hat sich Ritter "
    "Kato die Haare faerben lassen - sowas aber auch! Der glaubt wohl, "
    "dass er so cooler aussieht.");
    
  SUID;

  SUID;

    clone_object(ARMOUR+"eisenpanzer")->move(TO);
    clone_object(ARMOUR+"stiefel")->move(TO);
    clone_object(ARMOUR+"schild")->move(TO);
    ob = clone_object ("/obj/money");
    ob->SetProp(P_AMOUNT, 300+random(600));
    ob->move(ME);
    command ("ziehe alles an");
    clone_object( WEAPON "lanze")->move(TO);
    command ("zuecke lanze");

  
  AddInfo(DEFAULT_INFO, 
  	({"bruellt erzuernt!\n",
	  "wuerdigt Dich keines Blickes.\n",
	  "kreischt: Verschwinde!\n",
	  "fuchtelt wild herum.\n",
	  "spuckt Dir ins Auge!\n"
	  }) );
  
  AddInfo("miramis","Waere er doch nur schwarz!","seufzt: ");	  
  AddInfo("sargola", "Vergiss den Weichling!","bruellt: ");


  AddInfo("land der ferne", "Bald gehoert alles mir!","lacht: ");

  AddInfo("hilfe","Ha! Ich brauche keine Hilfe von Dir!","sagt: ");
  AddInfo("schmied","Er schmiedet die Waffen, die ich brauche.","sagt: ");
  AddInfo("see","Ich mag den See, er ist so schoen dunkel...","schwaermt: ");
  AddInfo("burg","Ich habe sie erschaffen - nun ja aeh, nicht direkt "
    "ich. Eher meine Sklaven ...","gibt zu: ");
  AddInfo("sklaven","Das sind die Spaeher.","bruellt: ");
  AddInfo("spaeher","Sie dienen nur mir - dafuer habe ich gesorgt.","sagt: ");
  AddInfo("stein","Ich habe ein Herz aus Stein!","sagt laut: ");
  AddInfo("herz","Meines ist aus Stein!","sagt laut: ");
  AddInfo(({"schwaechling","koenig"}),"Er ist ein Schwaechling, bald ist sein "
    "Reich meines!","sagt: ");
  AddInfo("kueche","In der Kueche arbeitet mein begabter Koch Hubert.","sagt: ");
  AddInfo(({"hubert","koch"}), "Er kocht fuer mich - er hat ja auch "
    "keine Wahl!","grinst: ");
  AddInfo("uebeeer","Ja, er nennt sich gerne so.","sagt: ");

  SetAttackChats(30, ({
	"Ritter Kato kreischt: \"Dich zerquetsch ich doch wie nichts!\"\n",
	"Ritter Kato ruft seine Spaeher zu Hilfe!\n",
	"Ritter Kato heilt sich selbst.\n"
					}) );
  SetProp(P_SPELLRATE,23);
  					

/* 
 AddSpell(5, 300,
    capitalize(name(WER,1))+" entwaffnet Dich.\n",
    capitalize(name(WER,1))+" entwaffnet @WEN.\n",
    DT_BLUDGEON, "DefaultSpell_Disarm");
*/    
 AddSpell(5, 1,
    capitalize(name(WER,1))+" erschreckt Dich.\n",
    capitalize(name(WER,1))+" erschreckt @WEN.\n",
    DT_TERROR,"DefaultSpell_Fear");
  
 AddSpell(5, 500,
    capitalize(name(WER,1))+" verflucht Deine Ruestung.\n",
    capitalize(name(WER,1))+" verflucht @WESSEN Ruestung.\n",
    DT_UNHOLY, "DefaultSpell_CurseArmour");

}
