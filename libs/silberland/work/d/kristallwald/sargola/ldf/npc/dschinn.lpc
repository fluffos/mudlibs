inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <moving.h>

#include "../def.h"

int reise();


create()
{
  if (!is_clone(TO)) return;
     ::create();

  SetProp(P_SHORT, "Ein Dschinn");
  SetProp(P_LONG,
	"Holla! Du traust Deinen Augen nicht. Das hier scheint ein echter "
	"und aeusserst lebendinger Dschinn zu sein. Du erkennst ihn wieder - "
	"es ist der, der Dich hierher gebracht hat. Scheinbar gelangweilt "
	"schlendert er hier durch die Gegend. Er scheint aus purer blaeuli"
	"cher Luft zu bestehen - und aus kleinen Wirbeln.");


  SetProp(P_NAME, "Dschinn");
  SetProp(P_GENDER, MALE);
  AddId( ({"dschinn","djinn","geist"}));
  SetProp(P_NOATTACK,"Der Dschinn lacht Dich nur aus.");
  create_default_npc(35);
  SetProp(P_HANDS, ({" mit maechtigen Luftstuermen",QueryProp(P_HANDS)[1],
  	DT_AIR}));
  SetProp(P_RACE, "Geist");
  
  AddDetail("augen","Meinst Du Deine oder seine?");
  AddDetail("seine augen","Es geht hier aber um Deine Augen!");
  AddDetail("meine augen","Du faengst vor dem Dschinn an, in Deinen "
    "Augen herumzufummeln. Der wundert sich nur.");

  
  AddInfo(DEFAULT_INFO, 
  	({"schaut Dich von oben herab an (weil er so gross ist!).\n",
	  "wuerdigt Dich keines Blickes.\n",
	  "spannt seine Luft-Muskeln an.\n",
	  "grinst Dich irre an.\n",
	  "macht nur: Pscht!\n",
	  "murmelt: Jaja...\n",
	  }) );
  AddInfo("miramis","Das ist das Pferd des Koenigs!","erlaeutert: ");	  
  AddInfo("sargola", "Ich habe grosse Ehrfurcht vor ihm.","sagt: ");
  AddInfo("gridi", "Das muss die sein, die immer mit Sargola herumrennt.",
  	"schmunzelt: ");
  AddInfo("irrsinn","nickt Dir wissend zu.");
  AddInfo("land der ferne", "Sag bloss, Du kennst es!","lacht: ");

  AddInfo("hilfe","Ich kann Dir nur dabei helfen, wieder ins schnoede "
    "Silberland zu kommen.","sagt: ");
  AddInfo("post","Ich kenne einige - die huebscheste ist in Elessar.","sagt: ");
  AddInfo("elessar","Dort wohnt die alte und weise Lundin.","sagt: ");
  AddInfo("lundin","Sie ist die einzige, die den Weg ins Land der Ferne "
    "noch kennt.","sagt: ");
  AddInfo("weg","Eigentlich ist es kein Weg - aber ich kann Dich hin und "
    "her tragen.","erklaert: ");
  AddInfo("wuensche","Sicherlich! Sonst noch was? Soll ich Dir etwa "
    "auch Deine Schuhe putzen?? Na Du bist mir einer!","grummelt: ");
  AddInfo(({"flasche","gefaess"}),"Ja sicher hab ich ein Gefaess - wie Du es "
    "nennst. Ich nenne es Zuhause! Aber leider ist es nur eine "
    "einfache Flasche. Wenn Du mir eine edlere, koeniglichere "
    "Oellampe bringst, wuerde ich mit Dir tauschen.","sagt: ");
  AddInfo(({"oellampe","lampe"}),"Sie muss mir angemessen sein, hoerst "
    "Du?","erklaert: ");
  AddInfo("zuhause","Eine Flasche ist das gemuetlichstes Zuhause, das ich mir "
    "vorstellen kann. Bis auf eine Oellampe eventuell.");
  AddInfo("reise",#'reise);
  AddInfo("gaertner","Der buddelt hier nur dumm herum.","groehlt: ");
  AddInfo("koenig","Such ihn einfach, Wicht!","grinst: ");
  AddInfo(({"lausbengel","jum-jum"}),
    "Der kleine Lausbengel spielt mir immer Streiche!","aergert sich: ");
  AddInfo("streiche","Nein, nein! Die erzaehl ich Dir sicher nicht!","sagt: ");
  AddInfo(({"vogel","lied"}), "Seit wann interessiert sich ein wasch"
    "echter Dschinn dafuer??","gruebelt: ");
  SUID;

     CLONEME(OBJ+"flasche");



}

int reise()
{
     tell_object(TP, break_string("Oki, wie Du willst.",78,"Der Dschinn sagt: "));
     tell_object(TP, "Der Dschinn erhebt sich mit Dir und fliegt wieder ins Silberland.\n");
     TP->move("/d/kristallwald/sargola/dorf/room/hlundin",M_GO,"weg","fliegt mit einem Dschinn","fliegt mit "
       "einem Dschinn weg");
     return 1;
}
int give_notify(object ob)
{
  int ret;
  if(ob->id("\nldflampe"))
  {
//    tell_object(TP, 
//"Der Dschinn sagt: Hui, das ist wahrlich eine schoene Oellampe. Fuer sie bin\n"
//"Der Dschinn sagt: ich bereit, meine Flasche - sogar mit Stoepsel - zu\n"
//"Der Dschinn sagt: tauschen.\n"
//"Der Dschinn gibt Dir eine Flasche.\n");
      tell_object(TP, break_string("Hui, das ist wahrscheinlich eine schoene Oellampe. Fuer sie "
		"bin ich bereicht, meine Flasche - sogar mit Stoepsel - zu tauschen",78,"Der Dschinn sagt: "));
    ob->remove();
    ob = clone_object(OBJ+"flasche");

    ret = ob->move(TP);
    if(ret==ME_TOO_HEAVY)
    {
      tell_object(TP,"Der Dschinn sagt: Die Flasche ist fuer Dich zu schwer.\n");
      ob->move(environment(TP));
    }
    return 1;
  }
  tell_object(TP, "Der Dschinn fragt: Seh ich wie ein Altwarentandler aus?\n");
  ob->move(TP);
}
      

