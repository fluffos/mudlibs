inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"
#include "../../dorf/obj/ldfquest.h"


string feuerflamme();

create()
{
     if (!is_clone(TO)) return;  
     ::create();   
    
     
     SetProp(P_SHORT, "Der Schmied von Ritter Kato");  
     SetProp(P_LONG, BS("Der Schmied ist ein Monster von einem Kerl. Den "
       "hast Du lieber nicht zu Deinem Feind. Solche Muskeln ... Er hat "
       "auch den ganzen lieben langen Tag nichts anderes zu tun als zu "
       "schmieden. Er scheint Dich kaum zu bemerken und schmiedet an einem "
       "Schwert. Er hat rotes Haar und einen dichten roten Bart. An seinem "
       "Fuss haengt eine schwere Kette."));
     
     AddDetail("kette","Der Schmied ist mit einer schweren Kette ange"
        "kettet.");
     AddDetail("fuss","An seinem Fuss haengt eine schwere Kette.");
     
     AddDetail(({"haar","haare"}),"Sie sind rot und wirken ungekaemmt.");
     AddDetail("bart","Der Schmied hat einen langen, roten Bart, der "
       "aussergewoehnlich dicht ist.");
     AddDetail("monster","Monster ist er keines, aber er wirkt so.");
     AddDetail("kerl","Nun, wenn man Schmied ist, muss man wohl einen "
       "dementsprechenden Koerperbau haben.");
     AddDetail("koerperbau","Der ist schon imposant. Wie der den Schmiede"
       "hammer schwingt ... Ob Du den ueberhaupt heben koenntest?");
     AddDetail("schmiedehammer","Er schwingt ihn als waere es ein kleines "
       "Haemmerchen.");
     AddDetail("haemmerchen","Das ist der Schmiedehammer gewiss nicht!");
     AddDetail("feind","Der Schmied wirkt nicht feindlich auf Dich, eher "
       "traurig und niedergeschlagen.");
     AddDetail("muskeln","Ehrfurchtsvoll ueberlegst Du, ob Du ihn "
       "ansprechen solltest oder sicherheitshalber gleich verschwindest.");
     AddDetail(({"nacht","tag"}),
       "Hier unten weiss man nicht, ob Tag oder Nacht ist.");
     AddDetail("schwert","An dem schmiedet der Schmied gerade.");
   
    
     SetProp(P_GENDER, MALE);
     SetProp(P_ARTICLE, 1);  
     SetProp(P_NAME,"Schmied");  
     AddId (({ "schmied"}));  
     create_default_npc (20);  
     SetProp(P_HANDS, ({" mit starken Faeusten", QueryProp(P_HANDS)[1], DT_BLUDGEON}));  
     
     SetProp(P_MSGIN, "kommt herein");  
     SetProp(P_MSGOUT, "geht");  


     
     SetProp(P_RACE, "Mensch");  
     SetProp(P_ALIGN, 500); 
     SetProp(P_SIZE, 180);
     SetProp(P_BODY, 100);
     SetProp(P_XP, 0);		//Quest-NPC :)
     SetProp(P_NOATTACK, "zeigt Dir seine Muskeln und Du laesst es.");

   
     AddInfo(DEFAULT_INFO,
     	({"schuettelt den Kopf.\n",
	  "scheint nachzudenken.\n",
	  "weiss nicht so recht, was er nun sagen soll.\n",
	  "kennt sich nicht aus.\n"}));
	
     AddInfo("faeuste","Mit ihnen kann ich gut schmieden.","sagt: ");
     AddInfo("hammer","Ohne Hammer kann ich keine Waffen mehr machen.","sagt: ");
     
     AddInfo("sargola","Der war noch nie hier. Vermutlich hat er nie durch "
       "den Berg gefunden.","sagt: ");

     AddInfo("sachen","Lauter nutzlose Sachen.","sagt: ");
     AddInfo("waffen","Ich muss die Waffen fuer die Spaeher schmieden.","sagt: ");
     AddInfo("berg","Ich bin in ihm gefangen - durch die Kette an meinem Fuss.","sagt: ");
     AddInfo("koenig","Es gab mal einen Koenig im Land der Ferne, ja.", "sagt: ");
     AddInfo(({"humbug","silberland"}),"Ich glaube nicht daran.", "sagt: ");
     
     AddInfo(({"schwert","schwerter","speere"}),"Du meinst die fuer die Spaeher?","fragt: ");
     AddInfo("spaeher","Ich schmiede fuer die Spaeher die Waffen, damit sie "
       "ihr fuerchterliches Werk vollbringen koennen.","seufzt: ");
     AddInfo("werk","Alles, was nicht zu Ritter Kato haelt, zu toeten.","seufzt: ");
     AddInfo(({"boesewicht","ritter","kato","kette"}), "Ritter Kato hat mich hier mit einer "
       "Kette an den Stein geschmiedet. Aber selbst ich bin nicht in der Lage, "
       "die Kette zu schmelzen. Sie besteht aus purem Hass!","schluchzt: ");
     AddInfo("kette","Die Kette hat Ritter Kato persoenlich geschmiedet - und er "
       "hat seinen ganzen Hass in sie geschmiedet.","seufzt: ");
     AddInfo("hass","Ja, Hass hat er genug... Er hat ein Herz aus Stein!","sagt: ");
     AddInfo(({"herz","stein"}),"Ritter Kato hat kein Herz. Sein Herz ist aus "
       "Stein. Totem, kaltem Stein. Und eine Klaue aus Eisen. Du kannst ihn "
       "nicht besiegen! Ausser Du zerstoerst sein Herz.","sagt traurig: ");
     AddInfo("klaue","Er hat eine Klaue aus Eisen, mit der reisst er seinen "
       "Opfern das Herz heraus und setzt ein Herz aus Stein ein!","schreit entsetzt: ");
     AddInfo("opfer","Er hat schon soviele besiegt ...","seufzt: ");
     AddInfo("finger","Was genau willst Du denn da wissen?","fragt: ");
     AddInfo("eisen","Das ist ein Metall.","sagt: ");
     AddInfo("metall","Daraus mach ich die Waffen.","sagt: ");
     

     AddInfo(({"land","land der ferne","ferne"}),
       "Ich weiss nichts mehr davon.", "weint: ");
     AddInfo("see","Auf der anderen Seite ist die Burg von Ritter Kato.","sagt: ");
   
     AddInfo("wald","Der dunkle Wald war frueher wunderschoen und wie jeder "
       "andere Wald. Durch Ritter Kato starb er und wurde schwarz.","sagt: ");
     AddInfo("eno","Hast Du etwas von ihm gehoert?? Er hat mich schon "
       "so lange nicht mehr besucht... Ich kann hier ja nicht weg ... Wenn "
       "ich doch ein Zeichen bekommen koennte, dass er noch lebt.","schluchzt: ");
     AddInfo("feuer","Das Feuer brauche ich zum Schmieden.", "sagt: ");
     AddInfo("schmieden","Das kann ich am besten.","sagt: ");
     AddInfo("feuerflamme",#'feuerflamme);
     
     AddInfo("voegel","Die Voegel sind die verschleppten und entfuehrten "
       "Menschen und Tiere vom Land der Ferne. Ritter Kato hat sie in "
       "Raben verwandelt und nun sind sie verdammt, ueber dem See und "
       "um seine Burg zu kreisen.","seufzt: ");
     AddInfo("burg","Die Burg von Ritter Kato ist am anderen Ufer. Wenn Du "
       "rueberschwimmst, wirst Du sie sehen.","sagt: ");
     AddInfo("tiere","Ja, er hat auch Tiere entfuehrt.","nickt traurig: ");
     

     
     
     SetChats(3, ({
	"Der Schmied schuert das Feuer.\n",
	"Der Schmied spielt mit seinen russigen Fingern.\n",
	"Der Schmied wirft aus Frust den Hammer weg.\n",
	"Der Schmied haemmert wild auf eine Klinge ein.\n"}));
	
	
  SUID;
  //clone_object("/p/weapon/schmiedehammer")->move(TO);
  //command("zuecke hammer");
} 

give_notify(object ob)
{
  object a;
  int ret;
  a = deep_present("\nldfquest",TP);
  
  if(!ob) return;
  if(!TP) return;
  
  if(ob->id("\nldfgruss"))
  {
    tell_object(TP,
"Der Schmied freut sich unheimlich ueber den Gruss von Eno!\n"
"Der Schmied haelt den Gruss an sein Ohr und lauscht aufmerksam.\n"
"Der Schmied nickt in Gedanken und murmelt etwas.\n\n"
"Der Schmied sagt: Danke, Du hast mir eine grosse Freude gemacht. Ich habe\n"
"Der Schmied sagt: ein Schwert gemacht, ein besonderes Schwert. Tage und\n"
"Der Schmied sagt: Naechte habe ich an ihm geschmiedet, an einem Schwert,\n"
"Der Schmied sagt: das Stein schneiden kann!\n\n"
"Der Schmied holt aus einer versteckten Felspalte ein Schwert, hebt es und\n"
"macht mit einem einzigen Schlag eine grosse Wunde in den Berg.\n\n"
"Der Schmied sagt: Du sollst mein Schwert \"Feuerflamme\" haben. Aber achte auf\n"
"Der Schmied sagt: die eiserne Klaue von Ritter Kato!\n\n"
"Der Schmied oeffnet einen versteckten Ausgang.\n");
    environment(TO)->AddExit("osten",ROOM+"ufer");
     
    if(objectp(a)) a->setze_wert(SCHWERT,1);
    ob->remove();
    ob = clone_object(WEAPON+"schwert");
    ret = ob->move(TP);
    if(ret==ME_TOO_HEAVY)
    {
      tell_object(TP, "Der Schmied sagt: Das Schwert ist fuer Dich zu schwer.");
      ob->move(environment(TP));
    }
  }
  else
  {
    tell_object(TP, "Der Schmied kann das nicht brauchen und gibt es Dir wieder.\n");
    ob->move(TP);
    return ;
  }
}

string feuerflamme()
{
  object ob; int val;
  ob = deep_present("\nldfquest",TP);
  if(objectp(ob)) val = ob->frage_wert(SCHWERT);
  if(val)
  {
    return "sagt: Nur mit ihm kannst Du das Herz von Ritter Kato zerstoeren.";
  }
  return "schuettelt den Kopf.";
}
