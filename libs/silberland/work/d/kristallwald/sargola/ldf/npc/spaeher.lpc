inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include "../def.h"

int check(object ob);
object ob;
string a;

create()
{   object ob;
    if (!is_clone(this_object())) return;
    ::create();
  SetProp (P_SHORT, "Spaeher");
  SetProp (P_LONG, BS("Ein dunkler Spaeher von der uebelsten Sorte. Er hat den "
    "Befehl von seinem Herren jeden Eindringling umzubringen und den fuehrt "
    "er auch durch."));

  AddDetail("sorte","Ein ganz uebler sozusagen.");
  

  SetProp (P_DIE_MSG, " schreit umsonst um Hilfe und stirbt.\n");
  SetProp (P_NAME, "Spaeher");
  SetProp(P_ARTICLE, 1);
  SetProp (P_GENDER, MALE);
  AddId ( ({"spaeher","dunkelspaeher"}) );
  create_default_npc (10+random(10));

  SetProp (P_HANDS, ({" mit blossen Haenden", QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp (P_ALIGN, -600-random(100));
  SetProp (P_SIZE, 160+random(20));
  SetProp (P_MSGOUT, "entdeckt keine Feinde und sucht weiter");
  SetProp (P_MSGIN, "kommt nach Feinden suchend herein");

 
  SetChats (5, ({
    "Der Spaeher schaerft seine Waffen.\n",
    "Der Spaeher blickt sich genau um!\n",
    "Der Spaeher schaut hinter einen Baum.\n",
    "Der Spaeher glaubt, etwas gehoert zu haben.\n"
    }) );
  AddInfo (DEFAULT_INFO, "sagt: Lass mich in Ruhe!\n");
  AddInfo(({"ritter","kato","ritter kato","gebieter"}),"Er ist unser Gebieter!",
    "bruellt: ");
  
  SUID;

    clone_object(ARMOUR+"eisenpanzer")->move(TO);
    clone_object(ARMOUR+"stiefel")->move(TO);
    if(!random(5))
       clone_object(ARMOUR+"schild")->move(TO);

     if( !random(3) )
     {
       ob = clone_object ("/obj/money");
       ob->SetProp(P_AMOUNT, 100+random(200));
       ob->move(ME);
     }
     command ("ziehe alles an");
     if( random(2) )
     {
       clone_object( WEAPON "lanze")->move(TO);
       command ("zuecke lanze");
     }
     else
     {
       CLONEME(WEAPON "speer");
       command("zuecke speer");
     }
  

  SetProp(P_SPELLRATE,35);
  AddSpell(1,250,
   "Der Spaeher schleudert eine dunkle Wolke auf Dich.\n",
   "Der Spaeher schleudert eine dunkle Wolke auf @WEN.\n",
   DT_AIR, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2,270,
    "Der Spaeher friert Dich mit kalten Blicken ein.\n",
    "Der Spaeher friert @WEN mit kalten Blicken ein.\n",
    DT_COLD, ([SP_SHOW_DAMAGE:1]));

  SetAttackChats(30, ({
   "Der Spaeher ruft andere Spaeher herbei.\n",
   "Der Spaeher kreischt: 'Das war Dein letzter Fehler!'\n",
   "Der Spaeher weicht Deinem Schlag aus.\n",
   "Der Spaeher lacht Dich aus!\n" }) );
   
}

 
void init()
{
  object ob;
  ::init();
  if(IS_WIZARD(TP)) return;
  ob = present("\nldfmantel",TP);
  if( TP && (TP->id("spaeher") || TP->id("jspaeher")) )
     AddDefender(TP);
   
  //wird spieler erkannt? zu 50% nur wenn mantel anhat
  if(objectp(ob) && ob->QueryProp(P_WORN)==TP && random(6))
      return;
  else
    TO->Kill(TP);
   

}


