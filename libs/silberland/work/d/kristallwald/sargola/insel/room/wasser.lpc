/*
************************************************************
** Einmal jeden 3. raumreset komplett-heilung
**
**
************************************************************
*/

#include "../def.h"

inherit "std/room";

nosave int mantel;
nosave int muschel;

void create()
{
  ::create();
  
  mantel = 1;
  muschel = 1;
  
  SetProp(P_INT_SHORT, "Auf einer romantischen Insel");
  SetProp(P_INT_LONG, 
	   BS("Du befindest Dich im herrlich warmen Wasser "
	      "der abgeschiedenen, windstillen Bucht, die von der Sonne "
	      "angenehm erwaermt wird. Sanfte Wellen schlagen an das "
	      "Ufer, welches aus mehreren kleinen Felsen besteht. Nur "
	      "an wenigen Stellen reicht der Sand bis zum Wasser. Eine "
	      "grosse Klippe ragt neben Dir in die Hoehe. Lustig machst "
	      "Du ein paar Tempi und schwimmst eine Runde."));                        
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_UNDERWATER,ENV_TEMPERATURE:20]));
  
  AddDetail("sonne", 
	    "Sie strahlt angenehm warm vom Himmel erwaermt das Wasser hier "
	    "angenehm.");
  
  AddDetail("himmel", 
	    "Der Himmel ist immer noch strahlend blau. Anscheinend "
	    "herrscht auf dieser Insel immer schoenes Wetter."); 
  
  AddDetail("wasser", "Du beginnst belustigt, ein paar kindische "
	    "Wellen zu schlagen. Unter Dir kannst Du dunkelgruene und "
	    "dunkelblaue Schimmer entdecken. Hin und wieder scheinen "
	    "Fische durch das Wasser zu schwimmen. Langgewachsene "
	    "Algen reichen manchmal fast bis zur Wasseroberflaeche.");
  
  AddDetail("schimmer", "Der Schimmer bewegt sich, wandert hin und "
	    "her ... Manche bleiben auch gleich ... Was sich wohl dahinter "
	    "verbirgt?");
  
  AddDetail("algen", "Du hast keine Ahnung, was das fuer Algen sind, "
	    "sie sind laenglich und wachsen in Richtung Licht. Fast be"
	    "ruehren sie die Oberflaeche. Die koennte man eventuell "
	    "ertauchen...");
  
  AddDetail("richtung", "Die Algen wachsen zur Oberflaeche des "
	    "Wassers.");
		
  AddDetail(({"wasseroberflaeche","oberflaeche"}), "Sie ist sonst ganz ruhig, doch durch "
	    "Dich wird sie ganz unruhig.");
  
  AddDetail("ahnung", "Du hast eben keine Ahnung ...");
  
  AddDetail("fische", "Wenn Du genau hinsiehst, bemerkst Du "
	    "manche blitzschnell, manche bedaechtig "
	    "umherschwimmen.");
  
  AddDetail("bucht", QueryProp(P_INT_LONG));
  
  AddDetail("wellen", "Die Wellen stammen meist von Dir.");
  
  AddDetail("licht", "Das Licht ist wohl die Sonne.");
  
  AddDetail(({"sand","boden"}), "Das Ufer besteht meist aus "
	    "Felsen, teils jedoch auch aus feinkoernigem Sand.");
  
  AddDetail(({"runde","tempi"}), "Du planschst munter vor Dich hin.");
  
  AddDetail("luft", "Die Luft ist angenehm, aber nicht weiter intere"
	    "ssant.");
  
  AddDetail("klippe", "Die Klippe ist ziemlich hoch, Du kannst nicht "
	    "viel mehr feststellen, als dass sie aus Fels besteht. Von "
	    "oben braust ein Wasserfall in die Bucht. Die "
	    "glitschigen Felsen laden nicht gerade zum Klettern ein...");
  
  AddDetail("klettern", "Das ist sicher viieeeel zu gefaehrlich...");
  
  AddDetail(({"fels","felsen"}), "Die Felsen sind glitschnass vom "
	    "Wasserfall und scharfkantig.");
  
  AddDetail("wasserfall", "Er braust von der Klippe oben steil in "
	    "die Bucht.");
  
  AddDetail("hoehe", "Du blickst beeindruckt nach oben.");
  
  AddDetail("donnern", "Hm, Du koenntest dem Donnern ja einmal "
	    "lauschen.");
  
  AddDetail("norden", "Im Norden siehst Du die grosse Klippe.");
  
  AddDetail("vegetation", "Es gibt nur wenig Vegetation. "
	    "Ausser ein paar duerren Graesern und ein wenig Schilf "
	    "waechst am Ufer nichts.");
  
  AddDetail("insel", "Du befindest Dich nun am oestlichen Ende der "
	    "Insel.");
  
  AddDetail("wetter", "Das Wetter ist herrlich! Windstill und "
	    "angenehm warm.");
  
  AddDetail("umgebung", "Du siehst Dir die Umgebung genau an und Du "
	    "siehst ueber Dir den blauen Himmel, unter Deinen Fuessen "
	    "dunkelblaues Wasser, eine grosse Klippe und mehrere Felsen.");
  
  AddDetail("felsen", "Ein paar kleinere Felsen liegen entlang des "
	    "Ufers.");
  
  AddDetail("stellen", "An einigen wenigen Stellen reicht der Sand "
	    "bis ans Ufer, sodass Du bequem ins Wasser gehen und "
	    "schwimmen kannst.");
  
  AddDetail("weile", "Wie lang die Weile dauert haengt von Dir "
	    "ab.");
  
  AddDetail("ufer", "Das Ufer besteht aus einigen kleineren Felsen "
	    "und ein paar Stellen, an denen der Sand bis ans Wasser "
	    "reicht.");
  
  AddDetail("graeser", "Zwischen den Felsen siehst Du ein paar "
	    "duerre Graeser hervorwachsen.");
  
  AddDetail("schilf", "Du siehst einige wenige Schilfrohre "
	    "aus dem Boden wachsen.");
  
  AddDetail(({"schilfrohre","rohre","rohr","schilfrohr"}), "Dicke "
	    "gelbe Rohre aus Schilf.");
  
  AddSound(DEFAULT_SOUND, "Du hoerst ein dumpfes "
	   "Donnern und leises Vogelgezwitscher aus dem Westen.");
  
  AddSound("donnern", "Das Donnern kommt vom Wasserfall, wo sich "
	   "die Klippe befindet.");
  
  AddSound(({"voegel","gezwitscher"}), "Aus dem Westen hoerst Du "
	   "Vogelgezwitscher.");
  
  AddSound("wind", "Du hoerst keinen Wind, weil es hier windstill "
	   "ist.");
  
  AddCmd(({"tauch","tauche"}), "tauche");
  AddCmd(({"bad","bade","schwimm","schwimme"}), "schwimm");
  
  AddCmd(({"kletter","klettere"}), "kletter");

  AddItem(NPC "nymphe", REFRESH_DESTRUCT);

  AddExit("raus", ROOM "3");
}

nosave int schwimm(string str)
{
  return write(BS("Du schwimmst die ganze Zeit, sonst wuerdest "
		  "Du ja untergehen....")), 1;
}

void reset()
{
  ::reset();
	
  mantel = 1;
  muschel = 1;
}

void init()
{
   ::init();

   call_other(ROOM "dummy", "???");
}

int frage_muschel()
{
  return muschel;
}

int setze_muschel(int i)
{
  muschel = 1;
}

int loesche_muschel()
{
  muschel = 0;
}

nosave int tauche(string str)
{
  object ob;
  int ret;
	
  notify_fail(BS("Wohin moechtest Du tauchen?"));
  if(!str) return 0;
  
  if(str=="nach unten"||str=="in wasser"||str=="in das wasser"||
     str=="ein"||str=="ins wasser"||str=="algen"||str=="nach algen"||
     str=="unter"||str=="runter"||str=="unter wasser")
    {
      switch(random(5))
	{
	case 0:
	  return write(BS("Du holst Luft, tauchst ins Wasser und kommst "
			  "kurz darauf tief Luft holend wieder an die "
			  "Oberflaeche. Du hast unter Wasser kaum etwas "
			  "erkennen koennen.")), 1;
	  
	case 1:
	case 2:
	  return write(BS("Du holst tief Luft und schwimmst in die "
			  "Tiefen. Du kannst ein Glitzern entdecken, kommst "
			  "aber nicht so tief.")), 1;
	  
	case 3:
	case 4:
	  if(mantel)
	    {
	      write(BS("Du holst tief Luft und tauchst in die Tiefen. "
		       "Du entdeckst wunderschoen blau-gruenlich "
		       "schimmernde Pflanzen."));
	      
	      ob=clone_object(OBJ "algen");
	      if(ob->move(TP, M_GET)==ME_TOO_HEAVY)
	   	{
		  ob->remove(1);
		  return write(BS("Sie sind Dir zu schwer und Du laesst "
				  "sie liegen.")), 1;
	   	}
	      
	      write(BS("Du tauchst mit den Pflanzen an die Oberflaeche."));

	      mantel = 0;

	      return 1;
	    }
	  else
	    return write(BS("Du holst tief Luft und tauchst nach "
			    "unten. An einigen Stellen scheint es, als ob "
			    "hier frueher Algen oder aehnliches wuchs.")), 1;
	}
    }

  return 0;
}

nosave int kletter(string str)
{
  notify_fail(BS("Wohin moechtest Du klettern?"));
  if(!str) return 0;
  
  if(str=="auf klippe"||str=="zur klippe"||
     str=="auf klippe rauf"||str=="zur klippe rauf"||
     str=="auf klippe hinauf"||str=="zur klippe hinauf")
    {
      write(BS("Du beginnst muehevoll die Felsen zu erklimmen "
	       "und schaffst es tatsaechlich nach einiger Zeit, die "
	       "Klippe zu erreichen. Neben Dir rauscht der Wasserfall."));

      TP->move(ROOM "wasserfall", M_GO, "oben","klettert nach",
	       "kommt von unten angeklettert");
      return 1;
    }

  return 0;
}
