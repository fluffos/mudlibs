#include "../def.h"
#include <questmaster.h>

inherit "std/room";

nosave string * halter;

void durch(object who);

void create()
{
  ::create();
  
  halter=({});
  
  SetProp(P_INT_SHORT, "Neben einem Wasserfall");
  
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich auf einem kleinen, glit"
	     "schigen Felsvorsprung oberhalb der abgeschie"
	     "denen Bucht. Neben Dir braust der Wasserfall von noch hoe"
	     "heren Klippen in die Bucht. Unter Dir siehst Du den grossen "
	     "See von Rhondonit, dessen Wellen in der Sonne glaenzen und "
	     "glitzern."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HILL,ENV_TEMPERATURE:20]));
  
  AddDetail("sonne", 
	    "Sie strahlt angenehm warm vom Himmel.");
  
  AddDetail("himmel", 
	    "Der Himmel ist immer noch strahlend blau. Anscheinend "
	    "herrscht auf dieser Insel immer schoenes Wetter."); 
  
  AddDetail("wasser", 
	    "Unter Dir kannst Du dunkelgruene und "
	    "dunkelblaue Schimmer im Wasser entdecken. Hin und wieder "
	    "scheinen Fische durch das Wasser zu schwimmen. Auch Algen "
	    "glaubst Du erkennen zu koennen. Die Bucht ist wohl tiefer "
	    "als es von unten den Anschein hatte.");
  
  AddDetail("schimmer", 
	    "Der Schimmer bewegt sich und veraendert "
	    "permanent seine Farbe. Aber von hier oben wirst Du ihn "
	    "eher nicht erforschen koennen.");
  
  AddDetail(({"farbe","farben"}),
	    "Von blau bis gruenlich ist alles vertreten.");
  
  AddDetail("algen", 
	    "Du hast keine Ahnung, was das fuer Algen sind, "
	    "sie sind laenglich und wachsen in Richtung Licht. Fast be"
	    "ruehren sie die Oberflaeche.");
  
  AddDetail("richtung", 
	    "Die Algen wachsen zur Oberflaeche des Wassers.");
  
  AddDetail(({"wasseroberflaeche","oberflaeche"}), 
	    "Abgesehen von den Wellen des Wasserfalles ist sie ruhig. "
	    "Keine aussergewoehnlichen, riesigen Ungeheuer zu sehen.");
  
  AddDetail("ungeheuer", 
	    "Oder doch .... ? Was war das bloss fuer "
	    "ein seltsamer Fleck dort im Wasser?");
		
  AddDetail("fleck", 
	    "Hmm... fast sah es so aus, als ob hier kurz "
	    "ein Riesenkrake geschwommen waere...");
  
  AddSpecialDetail(({"krake","riesenkrake"}), "fall");
  
  AddDetail("ahnung", 
	    "Du hast eben keine Ahnung ...");
	
  AddDetail("fische", 
	    "Von der Klippe kannst Du sie nur vage "
	    "durch das Wasser gleiten sehen.");
		
  AddDetail("bucht", 
	    "Sie liegt in warmem Sonnenschein unter Dir.");
	
  AddDetail(({"sonnenschein","schein"}), 
	    "Du spuerst den warmen Schein der Sonne.");

  AddDetail("wellen", 
	    "Die Wellen kommen vom Wasserfall.");

  AddDetail("licht", 
	    "Ja nicht in die Sonne blicken!");
	
  AddDetail(({"sand","boden"}), 
	    "Der Boden besteht aus nassen Felsen.");

  AddDetail("luft", 
	    "Ein leichter, warmer Wind weht hier oben.");

  AddDetail(({"felsvorsprung","klippe","klippen"}), 
	    "Du befindest Dich auf einem vom Wasser "
	    "ziemlich glitschigen Felsvorsprung und blickst vorsichtig ueber "
	    "den Rand selbiger. Unter Dir siehst Du die gemuetliche "
	    "Bucht liegen. Die Felsen beginnen weit ueber Dir, jedoch "
	    "sind sie zu steil, um weiter nach oben klettern zu koennen.");
  
  AddDetail("rand", 
	    "Nachdem Du Dich intensiv mit dem Rand beschaeftigt hast, "
	    "stellst Du enttaeuscht fest, dass er nichts Besonderes ist.");
		
  AddDetail("besonderes", 
	    "Nun, eben nichts Besonderes...");
	
  AddDetail(({"fels","felsen"}), 
	    "Die Felsen sind glitschnass vom Wasserfall und scharfkantig.");
		
  AddDetail("wasserfall", 
	    "Er braust an Dir vorbei in die Bucht.");
		
  AddDetail("hoehe", 
	    "Du blickst beeindruckt nach oben.");
		 
  AddDetail("insel", 
	    "Du siehst noch die Bucht der Insel und dann "
	    "den wunderschoen ruhigen See von Rhondonit.");
		
  AddDetail(({"see","see von rhondonit","rhondonit"}),
	    "Der See umgibt die Insel auf der Du Dich befindest. "
	    "Kleine, glaenzende Wellen branden an die Insel.");

  AddDetail("wetter", 
	    "Das Wetter ist herrlich! Windstill und angenehm warm.");

  AddDetail("umgebung", 
	    "Ein wenig ungenau - was willst Du denn genau untersuchen?");

  AddDetail("stellen", 
	    "An einigen wenigen Stellen reicht der Sand "
	    "bis ans Ufer, sodass Du bequem ins Wasser gehen und "
	    "schwimmen kannst.");

  AddDetail("weile", 
	    "Wie lang die Weile dauert haengt von Dir ab.");

  AddDetail("ufer", 
	    "Das Ufer besteht aus einigen kleineren Felsen "
	    "und ein paar Stellen, an denen der Sand bis ans Wasser reicht.");

  AddDetail("graeser", 
	    "Zwischen den Felsen siehst Du ein paar "
	    "duerre Graeser hervorwachsen.");

  AddDetail("schilf", 
	    "Du siehst einige wenige Schilfrohre aus dem Boden wachsen.");

  AddDetail(({"schilfrohre","rohre","rohr","schilfrohr"}), 
	    "Dicke gelbe Rohre aus Schilf.");

  AddSound(DEFAULT_SOUND, 
	   "Du hoerst ein dumpfes Donnern und leises Vogelgezwitscher.");

  AddSound("donnern", 
	   "Das Donnern kommt vom Wasserfall, der nach unten braust.");

  AddSound(({"voegel","gezwitscher"}), 
	   "Neben dem Wasserfall kannst Du Vogelgezwitscher vernehmen.");

  AddSound("wind", 
	   "Du hoerst keinen Wind, weil es hier windstill ist.");

  AddCmd(({"blick","blicke"}), "blicke");
  AddCmd(({"kletter","klettere"}), "kletter");
  AddCmd(({"gehe","geh"}), "gehe");
  AddCmd(({"lauf","laufe"}), "lauf");
  AddCmd(({"spring","springe"}), "spring");
  AddCmd(({"stups","stupse","stoss","stosse","schubs","schubse"}), "stoss");
  AddCmd(({"halt","halte"}), "halte");
	
  AddSpecialExit("runter","runter");	
}

int runter()
{
  if(member(halter, TP->query_real_name())!=-1)
    halter-=({TP->query_real_name()});
  
  return TP->move(ROOM"wasser", M_GO, "runter","klettert", 
		  "kommt von oben herunter geklettert");
}

nosave int halte(string str)
{
  notify_fail(BS("Was moechest Du tun?"));
  if(!str) return 0;
   
  if(str=="dich fest")
    if(member(halter, TP->query_real_name())==-1)
      {
	write(BS("Du haeltst Dich an einem Felsen ganz fest."));
	
	say(TPN+" haelt sich ganz fest.");
	
	halter+=({TP->query_real_name()});
	
	return 1;
      }
    else
      return write(BS("Du haeltst Dich doch schon ganz fest.")), 1;
  
  return 0;
}

nosave int stoss(string str)
{
  object ob, o;
  int i;
  
  notify_fail(BS("Wen moechtest Du stossen?"));
  if(!str) return 0;
  
  if(str == "hoehlenschuechtling von klippe" 
     ||str=="schuechtling von klippe"
     ||str=="schuechtling nach unten " 
     ||str == "hoehlenschuechtling nach unten"
     ||str =="hoehlenschuechtling"
     ||str=="schuechtling")
    {
      if(ob = present("hoehlenschuechtling"))
   	{ 
	  o = present("\n_insel_quest",TP);
	  
	  if(objectp(o) && o->frage_zaehler()== 4)
	    {
	      write(BS("Gerade als sich der Schuechtling wieder weit nach "
		       "vorne beugt, um Isabella besser beobachten zu "
		       "koennen, gibst Du ihm einen leichten Stups und er "
		       "faellt!!")+"\n"+
		    BS("Kann er denn ueberhaupt schwimmen??")+"\n"+
		    BS("Du springst ihm nach und plumpst neben ihm ins Wasser."
		       " Isabella kommt mit zwei Ringen aufgetaucht, die sie "
		       "Dir aus Dankbarkeit schenkt.")+
		    BS("Danach fluestert sie dem Hoehlenschuechtling etwas "
		       "zu und er blickt dankbar zu Dir.")+
		    BS("Beide winken Dir nochmal und schwimmen dann "
		       "gluecklich und zufrieden weg..."));
	      
	      ob->move(ROOM"dummy", M_GO);
	      
	      ob->SetProp(P_CHAT_CHANCE, 0);

	      if(objectp(ob=present("isabella",find_object(ROOM "wasser"))))
		ob->remove(1);
	      
	      if(objectp(ob=present("\n_insel_liebesbrief",
				    find_object(ROOM "wasser"))))
 		ob->remove(1);
	      
	      TP->move(ROOM "wasser", M_GO|M_SILENT|M_NO_SHOW);
	      
	      ob=clone_object(ARMOUR "ringe");

	      if(ob->move(TP)==ME_TOO_HEAVY)
		{
		  ob->remove(1);
		  
		  return write(BS("Da Du die Ringe nicht mehr tragen kannst, "
				  "beschliesst Du sie Dir spaeter von "
				  "Isabella abzuholen.")),1;
		}
	      
	      o->remove();

	      TP->GiveQuest("Verkupple Isabella");
	      
	      WLOG("/log/quests/insel", "verkuppelt Isabella");
	      
	      return 1;
	    }
	  else
	    {
	      write(BS("Du gibts dem Schuechtling einen Stups und platscht "
		       "unten ins Wasser."));
	      
	      ob->remove(1);
	      
	      return 1;
	    }
   	}
    } 

  return 0;
}

nosave int spring(string str)
{
  notify_fail(BS("Wodurch moechtest Du springen?"));
  if(!str) return 0;
  
  if(str=="durch wasserfall")
    {
      durch(TP);
      return 1;
    }

  if(str=="von klippe")
    {
      write(BS("Du springst beherzt von der Klippe und landest mit einem "
	       "Bauchfleck im Wasser.."));

      TP->move(ROOM "wasser", M_GO, "von der Klippe","springt",
	       "kommt von der Klippe gesprungen");

      SetProp(P_KILL_NAME, "Ein Bauchfleck");

      TP->do_damage(20);

      return 1;
    }
  
  return 0;
}

nosave int lauf(string str)
{
  notify_fail(BS("Wodurch moechtest Du laufen?"));
  if(!str) return 0;
  
  if(str=="durch wasserfall")
    {
      durch(TP);
      return 1;
    }
  
  return 0;
}


void durch(object who)
{
  if(present("\n_insel_quest", who))
    {	   
      tell_object(who,
		  BS("Du nimmst allen Deinen Mut zusammen und mit einem "
		     "kleinen Anlauf springst Du durch den Wasserfall..."));

      who->move(ROOM "hoehle", M_GO, "durch den Wasserfall","springt",
		"kommt durch den Wasserfall gesprungen");

      if(member(halter, who->query_real_name())!=-1)
	halter-=({who->query_real_name()});
    }
  else
    {
      tell_object(who,
		  BS("Du nimmst allen Mut zusammen und mit einem kleinen "
		     "Anlauf springst Du in den Wasserfall ... und prallst "
		     "mit voller Wucht an eine Felswand!"));
      
      SetProp(P_KILL_NAME, "Eine Felswand");

      who->do_damage(15+random(15));
    }
}

nosave int gehe(string str)
{
  notify_fail(BS("Wohin moechtest Du gehen?"));
  if(!str) return 0;
  
  if(str=="durch wasserfall")
    return write(BS("Der Wasserfall ist kein Baechlein, das man langsam und "
		    "bedaechtig durchwandert! Du wirst sicher mitgerissen, "
		    "wenn Du nicht schneller machst!")), 1;
  
  return 0;
}

nosave int blicke(string str)
{
  notify_fail(BS("Wo moechtest Du hinblicken?"));
  if(!str) return 0;
  
  if(str=="in sonne")
    {
      write(BS("Du schaust direkt in die strahlende Sonne ... ")+
	    BS("Du siehst einen hellen Punkt und dann wird alles dunkel..."));

      TP->SetProp(P_BLIND, 
	  ([BLIND_TIME: 50, 
	    BLIND_MSG: "Du bist von der Sonne geblendet!\n",
	    BLIND_END_MSG: "Der Schmerz in Deinen Augen laesst nach.\n"]));
      
      return 1;
    }

  return 0;
}

fall()
{
  object ob;
  
  if(member(halter, TP->query_real_name())!=-1)
    {
      TP->do_damage(10+random(20));
      
      return BS("Du beugst Dich weit vor, haeltst Dich aber "
   		"immernoch gut fest ... Ploetzlich schnellt ein Tentakel "
   		"in Deine Richtung und trifft Dich hart!");
    }
  
  write(BS("Gerade als Du Dich mehr nach vorne beugst, um "
	   "den unglaublichen Riesenkraken besser beobachten zu koennen, "
	   "verlierst Du den Halt und faellst nach unten!"));
  TP->move(ROOM"wasser",M_GO, "unten","faellt nach",
	   "faellt von der Klippe herunter");
  if(member(halter,TP->query_real_name())!=-1)
    halter-=TP->query_real_name();
  
  return BS("Mit einem grossen \"Platsch\" kommst Du unten an.");
}

nosave int kletter(string str)
{
  notify_fail(BS("Wohin moechtest Du klettern?"));
  if(!str) return 0;
  
  if(str=="auf klippe"||str=="zur klippe"||str=="oben"||str=="nach oben")
    return write(BS("Weiter nach oben geht es leider nicht, dazu "
		    "ist es zu steil.")), 1;

  return 0;
}



