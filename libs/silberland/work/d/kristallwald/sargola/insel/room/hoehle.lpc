#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
	
  SetProp(P_INT_SHORT, "In einer Grotte");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich in einer kleinen Grotte hinter "
	     "dem Wasserfall, der von der Klippe nach unten fliesst. Das "
	     "hereinfallende Licht bricht sich an den feinen "
	     "Wassertroepfchen, die durch die Luft schweben in allen Farben "
	     "des Regenbogens. Der Boden ist aus sandiger Erde, sonst gibt "
	     "es hier keinerlei Annehmlichkeiten. Ein Weg fuehrt weiter nach "
	     "hinten in die Grotte."));
  
  AddDetail("luft", 
	    "Durch die Wassertroepfchen siehst Du feine Luftstroeme.");

  AddDetail(({"stroeme","luftstroeme"}), 
	    "Leichte Luftstroeme kommen von draussen rein.");

  AddDetail("weg", 
	    "Er fuehrt weiter in die Grotte. Du traust Dich aber nicht "
	    "weiter.");
        	
  AddDetail(({"tag","regenbogen"}),
	    "Hier kann man den Regenbogen den ganzen Tag lang sehen.");
        
  AddDetail("annehmlichkeiten", 
	    "Naja, sowas wie Sessel oder ein Bett zB.");
        
  AddDetail(({"sessel","bett"}), 
	    "Sowas siehst Du hier eben nicht.");
        
  AddDetail("boden",
	    "Der Boden ist aus sandiger Erde und wird nach hinten immer "
	    "trockener.");
  
  AddDetail("farben", 
	    "Du kannst alle Spektralfarben schoen erkennen.");
  
  AddDetail("spektralfarben", 
	    "Sie reichen von Violett ueber Indigo, Blau, "
	    "Gruen, Gelb, Orange bis Rot.");
        	
  AddDetail(({"violett","indigo","blau","gruen","gelb","orange","rot"}),
	    "An den feinen Wassertropfen bricht sich das Sonnenlicht "
	    "beeindruckend in seine Spektralfarben.");
        
  AddDetail("klippe", 
	    "Du kannst sie schemenhaft hinter dem Wasserfall erkennen.");
        
  AddDetail("wasserfall", 
	    "Er stuerzt von noch hoeheren Felsen vor dem "
	    "Eingang der Grotte vorbei in die Tiefe.");
        	
  AddDetail("eingang", 
	    "Dort, wo der Wasserfall vorbeibraust.");
        
  AddDetail("erde", 
	    "Sie ist von der Feuchtigkeit weich und feucht.");
        
  AddDetail("feuchtigkeit", 
	    "Es wundert Dich aber nicht ernsthaft, dass hier alles feucht "
	    "ist, oder?");
        
  AddDetail("felsen", 
	    "Die Waende und die Decke bestehen aus Felsen.");
        
  AddDetail(({"waende","wand","decke"}), 
	    "Die Waende und die Decke bestehen aus Felsen.");
        
  AddDetail(({"sonnenlicht","licht"}), 
	    "Es ist kein einheitlicher Lichtstrahl, er bricht sich "
	    "vielmehr an feinen Wassertroepfchen und erleuchtet die Grotte "
	    "hier mit mystischer Schoenheit.");
        	
  AddDetail("schoenheit", 
	    "Sowas ist schwierig zu beschreiben.");
        
  AddDetail("tiefe", 
	    "Wie tief es ist, kannst Du von hier aus nicht erkennen.");
        	
  AddDetail(({"troepfchen","wassertropfen","wassertroepfchen"}),
	    "Sie sind ziemlich fein aber gegen das Sonnenlicht doch gut zu "
	    "sehen.");

  AddDetail("lichtstrahl", 
	    "Er ist wie schon gesagt eher diffus.");
        
  AddDetail("waser", 
	    "Es rauscht am Eingang der Grotte vorbei.");
        
  AddDetail("grotte", QueryProp(P_INT_LONG));

  AddSound(({"wasser","wasserfall","rauschen",DEFAULT_SOUND}),
	   "Du hoerst nur das Rauschen des Wasserfalls...");
        
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE,ENV_TEMPERATURE:15]));

  AddExit("raus",ROOM "wasserfall");
}

void init()
{
  object *anwesende;
  object *ar;
  object hs;	
  int angst,i;

  ::init();

  if(find_call_out("holen")==-1)
    call_out("holen",60);

  angst = 0;	

  //Abchecken, ob jemand zum Fuerchten da ist ...
  anwesende=filter_array(all_inventory(), CLOSURE(query_once_interactive));
  
  for(i = sizeof(anwesende)-1;i>=0;i--)
    {
      if(angst) break;
      
      if(IS_WIZARD(anwesende[i])) continue;
      
      if((sizeof(ar=anwesende[i]->QueryArmours(AT_CLOAK))) &&
	 (ar[0]->id("algenumhang")))
	continue;
      else
	angst=1;
    }
  
  //Wenn kein Schuechtling
  if(!objectp(hs=find_living("hoehlenschuechtling")))
    {
      hs = clone_object(NPC "hoehlens");
      
      hs->move(ROOM"dummy", M_GO|M_NOCHECK);
      
      return ;
    }
  
  //wenn er keine angst haette und nicht da ist ;)
  if(!angst && present(hs, find_object(ROOM "dummy")))
    {
      hs->move(ME, M_GO|M_NOCHECK);
      return ;
    }
  
  if(!angst) return;

  //Schuechtling removen

  call_out("remsch", 0, hs);
}	   		

void remsch(object o)
{
  if(!present(o)) return;
  
  o->move(ROOM "dummy",M_GO);

  tell_room(TO, 
	    BS("Vielleicht schuechtert ihn Deine Kleidung ein. Sicherlich "
	       "wuerde ein Aussehen wie Isabellas Dir dabei helfen ... Wenn "
	       "Du wie sie nach Algen schimmern wuerdest."));
}

//vom dummy-raum herholen
void holen()
{
  object o;
  
  if(!objectp(o=find_living("hoehlenschuechtling")))
    o=clone_object(NPC "hoehlens");  

  call_other(ROOM "wasserfall", "???");
  
  if(present(o, find_object(ROOM "wasserfall"))) return ;

  if(!present(o)) 
    o->move(ME, M_GO);
  
  if(find_call_out("holen")==-1)
    call_out("holen",20);
}
