inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include "../def.h"

      create()
      {
        ::create();
	
        SetProp( P_INT_SHORT, "Dummy");
        
        SetProp(P_INT_LONG, BS("Dies ist ein Dummy-raum."));
        
        SetProp( P_LIGHT, 1 );
        SetProp( P_INDOORS, 0 );
        
        SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HILL,ENV_TEMPERATURE:20]) );
	AddItem(NPC+"hoehlens",REFRESH_DESTRUCT);
}