string baum()
{
  if(flechte)
    return  BS("Ein ganz normaler Stamm mit Rinde drumherum. "
	       "Fast haettest Du die seltsame Flechte uebersehen, welche sich "
	       "weiter oben am Stamm befindet.");

  return BS("Ein ganz normaler Stamm mit Rinde drumherum.");
}

string flechte()
{
  if(flechte)
    return BS("Die Flechte ist sehr duenn, fast wie ein Faden und ziemlich "
	      "mit der Rinde verwachsen. Vielleicht kannst Du sie irgendwie "
	      "runterbekommen.");

  return BS("Sowas siehst Du da nicht.");
}

nosave int reiss(string str)
{
  object f;

  notify_fail(BS("Was moechtest Du von wo reissen?"));
  if(!str) return 0;
  
  if(str=="flechte von stamm" || str=="flechte von stamm ab"||
     str=="flechte von baum" || str=="flechte von baum ab"||
     str=="flechte von weide" || str=="flechte von weide ab"||
     str=="flechte von rinde" || str=="flechte von rinde ab")
    if(flechte)
      {
	f=clone_object(OBJ"flechte");
	
	if(f->move(TP, M_GET)==ME_TOO_HEAVY)
	  {
	    f->remove(1);
	    return write(BS("Da Dir die Flechte zu schwer ist, schaffst Du es "
			    "auch nicht, sie abzureissen...")), 1;
	  }

	write(BS("Du reisst die Flechte ab und steckst sie ein. Wer weiss, "
		 "wozu man sowas brauchen kann."));

	flechte = 0;
	
	return 1;
      }
    else
      return write(BS("Du siehst hier keine Flechte.")), 1;
  
  return 0;
}

nosave int locke(string str)
{
  notify_fail("Wen moechtest Du womit anlocken?\n");
  if(!str) return 0;
  
  if(str=="schwan"|| str=="schwan an")
    return write(BS("Womit willst Du denn den Schwan anlocken?")), 1;

  if(present("\n_insel_schwan"))
    return write(BS("Viel naeher kannst Du den Schwan nicht mehr "
		    "heranlocken.")), 1;

  if((str=="schwan mit semmel") || (str=="schwan mit semmel an"))
    if(present("semmel", TP))
      {
	write(BS("Du schaffst es tatsaechlich und lockst den Schwan mit "
		 "der Semmel ans Ufer heran."));

	CLONEME(SCHWAN);
	
	call_out("remove_schwan", 60);
	
	return 1;
      }
    else
      return write(BS("Wenn Du sowas bei Dir haettest...")), 1;

  if((str=="schwan mit brot") || (str=="schwan mit brot an") ||
     (str=="schwan mit johannisbrot") || (str=="schwan mit johannisbrot an"))
    if(present("johannisbrot", TP))
      {
	write(BS("Du schaffst es tatsaechlich und lockst den Schwan mit "
		 "dem Johannisbrot ans Ufer heran."));

	CLONEME(SCHWAN);
	
	call_out("remove_schwan", 60);
	
	return 1;
      }
    else
      return write(BS("Wenn Du sowas bei Dir haettest...")), 1;

  if((str=="schwan mit stangerl") || (str=="schwan mit stangerl an") ||
     (str=="schwan mit salzstangerl") || (str=="schwan mit salzstangerl an"))
    if(present("salzstangerl", TP))
      return write(BS("Du willst doch nicht den armen Schwan mit dem salzigen "
		      "Zeugs fuettern, oder?")), 1;
    else
      return write(BS("Wenn Du sowas bei Dir haettest...")), 1;
  
  notify_fail(BS("Schwaene lockt man am Besten mit einer Semmel, "
		 "oder mit Johannisbrot."));
  return 0;
}

nosave int setze(string str)
{
  notify_fail(BS("Wohin moechtest Du Dich setzen?"));
  if(!str) return 0;
  
  if(str=="auf baenkchen" || str=="auf holzbaenkchen"||
     str=="auf bank" || str=="auf holzbank")
    {
      if(member(sitzend, getuid(TP))!=-1)
	return write(BS("Aber Du sitzt doch schon auf der Bank!")), 1;
      
      sitzend+=({getuid(TP)});
      
      write(BS("Du setzt Dich auf das Baenkchen und fuehlst Dich sofort "
	       "wohl hier im Schatten der Weide. Am liebsten moechtest "
	       "Du gar nicht mehr aufstehen. Du geniesst den traumhaften "
	       "Ausblick auf das Wasser und das Ufer des Sees."));
      return 1;
    }

  return 0;
}

nosave int aufstehen(string str)
{
  notify_fail(BS("Willst Du etwa aufstehen?"));
  if(!str) return 0;
  
  if(str=="auf")
    if(member(sitzend, getuid(TP))!=-1)
      {
	write(BS("Du stehst von dem Baenkchen wieder auf."));
	sitzend-=({getuid(TP)});
	return 1;
      }
    else
      return write(BS("Aber Du sitzt doch garnicht auf dem Baenkchen.")), 1;

  return 0;
}

void reset()
{
  int i;
  string *tmp;

  ::reset();
  
  anz_vergiss =2;
  flechte = 1;
  
  if(random(2))
    rindentext = 0;

  if(!sizeof(tmp=sitzend)) return;

  for(i=sizeof(tmp)-1; i>=0; i--)
    if(!present(tmp[i])) sitzend-=({tmp[i]});
}

nosave int pfluecke(string str)
{
  object blume;

  notify_fail(BS("Was moechtest Du pfluecken?"));
  if(!str) return 0;
  
  switch(str)
    {
    case "vergissmeinnicht":
      if(anz_vergiss==2)
	{
	  blume=clone_object(OBJ"vergissm");
	  
	  if(blume->move(TP, M_GET)==ME_TOO_HEAVY)
	    {
	      blume->remove(1);
	      return write(BS("Das Vergissmeinnicht wuerde Dir vermutlich "
			      "zu schwer werden...")), 1;
	    }
	  write(BS("Du pflueckst das Vergissmeinnicht. Du koenntest es als "
		   "Zeichen Deiner Zuneigung jemandem schenken."));
	  
	  anz_vergiss = 1;
	  
	  return 1;
	  
	}	
      else
	return write(BS("Da waechst doch nur ein Vergissmeinnicht. "
			"Du beschliesst, es stehen zu lassen.")), 1;
      
    case "loewenzahn":
      return write(BS("Du findest den Loewenzahn zu unromantisch und laesst "
		      "ihn stehen. Vielleicht findest Du eine andere Blume, "
		      "die Du pfluecken kannst.")), 1;
      
    case "butterblume":
      return write(BS("Du findest die Butterblume zu langweilig und laesst "
		      "sie stehen. Vielleicht findest Du eine andere Blume, "
		      "die Du pfluecken kannst.")), 1;
      
    case "margerite":
      return write(BS("Du findest die Margerite zu banal und laesst sie "
		      "stehen. Vielleicht findest Du eine andere Blume, "
		      "die Du pfluecken kannst.")), 1;
    }      
  
  return 0;
}

string blaues()
{
  if(anz_vergiss>1)
    return BS("Zwei kleine Bluemchen. Wenn Du wuesstest, wie sie heissen, "
	      "koenntest Du vielleicht welche pfluecken.");

  return BS("Ein kleines Bluemchen. Wenn Du wuesstest, wie es "
	    "heisst, koenntest Du es vielleicht pfluecken.");
}

string bluemchen()
{
  if(anz_vergiss>1)
    return BS("Wenn Du weisst, wie die Bluemchen heissen, kannst Du sie "
	      "pfluecken.");

  return BS("Wenn Du weisst, wie das Bluemchen heisst, kannst Du es "
	    "pfluecken.");
}

string vergissmein()
{
  if(anz_vergiss>1)
    return BS("Unter einer Wurzel der Weide wachsen zwei zierliche, "
	      "blaue Vergissmeinnicht.");

  return BS("Unter einer Wurzel der Weide waechst ein zierliches "
	    "blaues Vergissmeinnicht.");
}

nosave int schnitze(string str)
{
  object ob;

  notify_fail("Was moechtest Du schnitzen?\n");
  if(!str) return 0;

  if(!objectp(ob=TP->QueryProp(P_WEAPON)))
    return write(BS("Du hast ja gar nichts gezueckt, womit Du etwas "
		    "ritzen koenntest.")), 1;

  if(ob->QueryProp(P_WEAPON_TYPE)!=WT_KNIFE)
    return write(BS("Nur mit einem Messer kann man schoen ritzen...")), 1;
  
  if(stringp(rindentext))
    return write(BS("Aber da ist doch bereits etwas eingeschnitzt...")+
		 BS("Versuchs doch spaeter noch einmal!")), 1;
  
  write(BS("Du schnitzt Deinen Text in die Rinde - auf dass "
	   "nach Dir folgende Abenteurer es lesen koennen."));

  setze_text(str);
  
  //tell_object(TP, frage_text());
  write_file("/d/kristallwald/sargola/log/schnitzen",
	     sprintf("%s  %s schnitzt %s.\n",dtime(time()),TPN,str)); 
  return 1;
}

string frage_text()
{
  return rindentext;
}

void setze_text(string str)
{
  rindentext = str;
} 

void remove_schwan()
{
  object schwan;
  
  if(schwan=present("\n_insel_schwan"))
    {
      tell_room(ME, BS("Der Schwan schwimmt gelangweilt wieder weiter."));
      schwan->remove(1);
    }
}

string ttest()
{
  if(stringp(rindentext))
    return BS(rindentext);
  
  return BS("Du kannst nichts mehr erkennen.")+
    BS("Du koenntest aber selber etwas einritzen...");
}

varargs int PreventLeave(object ob, mixed dest)
{
  if(member(sitzend, getuid(ob))!=-1)
    {
      tell_object(ob, "\n"+BS("Du stehst von dem Baenkchen auf.")+"\n");
      sitzend-=({getuid(ob)});
    }

  return 0;
}

public void init() {
  ::init();

  if(interactive(this_player())) {
    check_bard_awf_quest(this_player());
  }
}
