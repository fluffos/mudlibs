  AddDetail("boden", 
	    "Der Boden ist sandig, dennoch waechst hier im Schatten der "
	    "Weide Gras.");
  
  AddDetail("erde", 
	    "Die Erde ist ein wenig sandig.");

  AddDetail("sand", 
	    "Der Boden ist sandig und die Wurzeln der Weide "
	    "sind fest darin verankert.");
  
  AddDetail(({"wurzel","wurzeln"}), 
	    "Die Weide ist mit ihren Wurzeln fest im Boden verankert. Unter "
	    "einer der Wurzeln siehst Du etwas blaues aufblitzen.");
  
  AddSpecialDetail(({"blau","blaues"}), "blaues");
  
  AddSpecialDetail("bluemchen","bluemchen");
  
  AddSpecialDetail("vergissmeinnicht","vergissmein");
  
  AddDetail("gras", 
	    "Herrlich duftendes, grasgruenes Gras mit einigen "
	    "bunten Farbklecksen dazwischen.");
  
  AddDetail(({"farbkleckse","kleckse"}), 
	    "Du siehst einige wenige bunte Blumen, die aus dem saftigen "
	    "Gruen des Grases herausstechen."); 
  
  AddDetail(({"blume","blumen"}), 
	    "Loewenzahn, Butterblumen und Margeriten.");
  
  AddDetail("loewenzahn", 
	    "Normaler, gelber Loewenzahn.");
  
  AddDetail(({"butterblumen","butterblume"}), 
	    "Normale, gelbe Butterblumen.");
  
  AddDetail(({"margerite","margeriten"}), 
	    "Normale, weisse Margeriten.");
  
  AddDetail("ornithologe", 
	    "Du bist keiner, aber wenn Du einer waerst, koenntest Du sicher "
	    "feststellen, ob Du Drosseln, Amseln, Lerchen oder Tauben "
	    "hoerst.");
  
  AddDetail(({"drossel","drosseln","amsel","amseln","lerche","lerchen",
		"taube","tauben"}), 
	    "Sehen kannst Du die Voegel nicht, nur hoeren.");
  
  AddDetail("gurren", 
	    "Wie willst Du etwas untersuchen, das Du nur hoerst?");
  
  AddDetail("luft", 
	    "Du atmest die klare, frische Luft ein und fuehlst Dich "
	    "gestaerkt und befreit.");
  
  AddDetail(({"licht","sonnenlicht"}), 
	    "Strahlend helles Sonnenlicht."); 
  
  AddDetail(({"welle","wellen"}), 
	    "Die Wellen schlagen sanft ans Ufer.");
  
  AddDetail("plaetschern", 
	    "Das hoerst Du nur.");
  
  AddSound(DEFAULT_SOUND,
	   "Du hoerst, wie die Voeglein froehlich ihre Lieder "
	   "zwitschern und das leise Plaetschern der Wellen, die "
	   "ans Ufer schlagen.");
  
  AddSound(({"plaetschern","wellen"}), 
	   "Du hoerst das leise Plaetschern der Wellen, die ans Ufer "
	   "schlagen.");
  
  AddSound(({"voeglein","voegel","vogel"}), 
	   "Da Du kein Ornithologe bist, weisst Du leider nicht, um welche "
	   "Voegel es sich handelt.");
  
  AddSound(({"lied","lieder"}), 
	   "Tirilli, tirilli.");
  
  AddSound(({"zwitschern","gezwitschere"}), 
	   "Twit, twit.");
  
  AddSound(({"drossel","drosseln","amsel","amseln","lerche","lerchen"}),
	   "Du bist Dir nicht sicher, ob Du solche Voegel hier hoerst, "
	   "Du bist schliesslich kein Ornithologe.");
  
  AddSound(({"taube","tauben"}), 
	   "Obwohl Du kein Ornithologe bist, glaubst Du, ganz deutlich ein "
	   "Gurren von Tauben zu hoeren. Allerdings kannst Du hier keine "
	   "Tauben sehen.");
  
  AddSound("gurren", 
	   "Du hoerst das Gurren ganz deutlich, kannst allerdings keine "
	   "einzige Taube sehen. Vermutlich befindet sie sich auf einem "
	   "anderen Teil der Insel.");
  
  AddSound("rauschen", 
	   "Nach angestrengtem Lauschen hoerst Du unter all dem "
	   "Gezwitschere tatsaechlich ein Rauschen, das aus dem Norden "
	   "zu kommen scheint.");
  
  AddSmell(DEFAULT_SMELL,
	   "Du riechst die wuerzige, klare Luft und den Duft der Blumen.");
  
  AddSmell("luft", 
	   "Die Luft riecht klar und frisch.");
  
  AddSmell("bluemchen", 
	   "Du haeltst die Nase ganz nah an das Bluemchen und atmest den "
	   "suessen Duft des Vergissmeinnichts ein.");
  
  AddSmell("duft", 
	   "Das Vergissmeinnicht duftet ganz suess.");
  
  AddSmell(({"blume","blumen"}), 
	   "An welcher Blume moechtest Du riechen?");
  
  AddSmell("loewenzahn", 
	   "Der Loewenzahn riecht wuerzig und frisch.");	
  
  AddSmell(({"margerite","margeriten"}), 
	   "Die Margeriten duften herrlich.");
  
  AddSmell(({"butterblume","butterblumen"}), 
	   "Die Butterblume duften nur wenig.");
  
  AddCmd(({"sitze","sitz","setze","setz"}),"setze");
  AddCmd(({"steh","stehe"}),"aufstehen");
  AddCmd(({"pflueck","pfluecke"}),"pfluecke");
  AddCmd(({"schnitz","schnitze"}),"schnitze");
  AddCmd(({"lock","locke"}), "locke");
  AddCmd(({"reiss","reisse"}), "reiss");
  
