#include "../def.h"

inherit "std/room";
inherit "/gilden/bardengilde/obj/quest/reiselied_functions";

//*************************
// VARS
//*************************
nosave string rindentext;
nosave int anz_vergiss;
nosave int flechte;
nosave string *sitzend;

//*************************
// FUNCTIONS
//*************************
int pfluecke(string str);
int setze(string str);
string bluemchen();
string vergissmeinnicht();
string blaues();
int schnitze (string str);
void setze_text(string str);
string frage_text();
int locke(string str);

ttest();

flechte();
baum();

void create()
{
  ::create();
  
  anz_vergiss = 2;
  flechte = 1;
  rindentext = 0;
  sitzend=({});

  SetProp(P_INT_SHORT, "Auf einer romantischen Insel");
  SetProp(P_INT_LONG, 
	   BS("Du befindest Dich auf einer romantischen "
	      "kleinen Insel. Die Sonne scheint, der Himmel ist strahlend "
	      "blau, die Voeglein zwitschern und alles rund um Dich "
	      "herum gruent und blueht. Direkt vor Dir steht eine grosse, "
	      "alte Weide, in deren Schatten ein Holzbaenkchen steht. "
	      "Suedlich von Dir befindet sich das Ufer, an dem Dich "
	      "der Schwan abgesetzt hat, im Norden siehst Du eine felsige "
