  AddDetail("schatten", 
	    "Es ist angenehm kuehl im Schatten.");
  
  AddDetail(({"baenkchen","holzbaenkchen"}), 
	    "Das Baenkchen scheint zwar schon alt, aber stabil zu sein. "
	    "Es bietet gerade genug Platz fuer zwei. Du koenntest Dich "
	    "ein Weilchen in den Schatten setzen und die herrliche Natur "
	    "geniessen.");
  
  AddDetail("natur", 
	    "Sie ist wirklich ausgesprochen herrlich.");
  
  AddDetail("platz", 
	    "Das Baenkchen bietet Platz zum Sitzen fuer zwei "
	    "- Und zu zweit sitzt es sich doch viel schoener!");
  
  AddDetail("idee", 
	    "Du hattest eine gute Idee - jetzt ist sie Dir wieder entfallen.");
  
  AddDetail(({"ufer","promenade"}), 
	    "Suedlich von Dir befindet sich das Ufer, an dem Dich der Schwan "
	    "abgesetzt hat, am gegenueberliegenden Ufer des Sees siehst Du "
	    "die Promenade vorbeifuehren.");
  
  AddDetail(({"wasser","see","rhondonit"}), 
	    "Das Wasser des Sees ist spiegelglatt und tiefblau.");
  
  AddDetail("ausblick", 
	    "Du fuehlst Dich pudelwohl hier im Schatten der Weide. Die "
	    "Aeste des dicken Stammes haengen romantisch nach unten.");
  
  AddDetail("holz", 
	    "Das Baenkchen ist aus Holz.");
  
  AddDetail(({"aeste","zweige","ast","zweig"}), 
	    "Die Aeste und Zweige sind so lang, dass sie bis auf den Boden "
	    "reichen.");
  
  AddSpecialDetail("stamm", "baum");
  
  AddSpecialDetail(({"flechte","faden"}), "flechte");
  
  AddDetail("rinde", 
	    "Sie geht rund um den Stamm herum. Obwohl -  "
	    "irgendetwas an der Rinde kommt Dir seltsam vor.");
  
  AddDetail(({"blaetter","blatt"}), 
	    "Es handelt sich um kleine, laengliche, dunkelgruene Blaetter.");
  
  AddDetail("irgendetwas", 
	    "Es sieht wie eine Schnitzerei aus.");
  
  AddDetail("schnitzerei", 
	    "Jemand hat mit einem Messer ein Herz in die Rinde geschnitzt. "
	    "Da ist auch ein Text eingeritzt.");
  
  AddDetail("herz",
	    "Ein einfaches, aber von Liebe zeugendes Herz.");
  
  AddDetail("text", 
	    "Du kannst ihn lesen.");
  
  AddReadDetail("text", CLOSURE(ttest));
  
  AddDetail("messer", 
	    "Wenn Du ein Messer haettest, koenntest "
