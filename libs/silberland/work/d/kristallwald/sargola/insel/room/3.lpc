#include "../def.h"

inherit "std/room";

nosave string * ausgeruhte;
nosave int reset_zaehler;
nosave int feder;

void create()
{
  ::create();
  
  ausgeruhte = ({});
  reset_zaehler = 0;
  feder = 1;
  
  SetProp(P_INT_SHORT, "Auf einer romantischen Insel");
  SetProp(P_INT_LONG, 
	   BS("Du befindest Dich in einer abgeschiedenen, "
	      "windstillen Bucht, die von der Sonne angenehm erwaermt wird. "
	      "Die Wellen schlagen sanft an das Ufer, das aus mehreren klei"
	      "nen Felsen besteht. Nur an wenigen Stellen reicht der "
	      "Sand "
	      "bis zum Wasser. Eine grosse Klippe, von der Du nun ein dump"
	      "fes Donnern vernimmst, reicht von der Insel bis in den See hi"
	      "nein und begrenzt die Bucht nach Norden hin. Aufgrund des sa"
	      "ndigen Bodens gibt es nur wenig Vegetation."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN,ENV_TEMPERATURE:25]));
  
  SetProp(P_NOREST, "Entspanne Dich doch einfach auf dem Boden!\n");
  
  AddDetail("sonne", 
	    "Sie strahlt angenehm warm vom Himmel und laedt "
	    "zum Niedersetzen und Entspannen ein.");
  
  AddDetail("himmel", 
	    "Der Himmel ist immer noch strahlend blau. An"
	    "scheinend herrscht auf dieser Insel immer schoenes Wetter."); 
  
  AddDetail("erde", 
	    "Die Erde ist in diesem Fall Sand.");
  
  AddDetail(({"sand","boden"}), 
	    "Der Boden besteht groesstenteils "
	    "aus feinkoernigem Sand, der von der Sonne angenehm warm "
	    "ist und dazu einlaedt, sich eine Weile hinzusetzen, die "
	    "herrliche Umgebung zu geniessen und sich zu entspannen. "
	    "Du siehst die Spuren des Schwans, der sich hier ab und "
	    "zu auch niedergelassen hat.");
  
  AddDetail("spuren", 
	    "Du glaubst zumindest, dass sie vom Schwan stammen. "
	    "Vielleicht hat er hier ja etwas verloren...");
  
  AddDetail("luft", 
	    "Die Luft ist angenehm, aber nicht weiter interessant.");
  
  AddDetail("klippe", 
	    "Die Klippe ist ziemlich hoch, Du kannst nicht "
	    "viel mehr feststellen, als dass sie aus Fels besteht. Ob "
	    "man die naeher untersuchen kann?");
  
  AddDetail("bucht", 
	    "Du befindest Dich in einer abgeschiedenen, "
	    "windstillen Bucht, die von der Sonne angenehm erwaermt wird. "
	    "Die Wellen schlagen sanft an das Ufer, das aus mehreren klei"
	    "nen Felsen besteht. Nur an wenigen Stellen reicht der "
	    "Sand "
	    "bis zum Wasser. Eine grosse Klippe, von der Du nun ein dump"
	    "fes Donnern vernimmst, reicht von der Insel bis in den See hi"
	    "nein und begrenzt die Bucht nach Norden hin. Aufgrund des sa"
	    "ndigen Bodens gibt es nur wenig Vegetation."); 
  
  AddDetail("wasser", 
	    "Das Wasser des Sees scheint angenehm warm "
	    "zu sein. Vielleicht moechtest Du schwimmen?");
  
  AddDetail("see", 
	    "Der See liegt rund um die Insel herum.");
  
  AddDetail("donnern", 
	    "Hm, Du koenntest dem Donnern ja einmal lauschen.");
  
  AddDetail("wellen", 
	    "Die Wellen schlagen sanft ans Ufer.");
  
  AddDetail("norden", 
	    "Im Norden siehst Du eine grosse Klippe. Um mehr zu erkennen "
	    "musst Du naeher an die Klippe herangehen.");
  
  AddDetail("vegetation", 
	    "Es gibt hier nur wenig Vegetation. "
	    "Ausser ein paar duerren Graesern und ein wenig Schilf "
	    "waechst hier nichts.");
  
  AddDetail(({"niedersetzen","entspannen"}), 
	    "Das solltest Du nicht untersuchen, sondern tun!");
  
  AddDetail("insel", 
	    "Du befindest Dich nun am oestlichen Ende der Insel.");
  
  AddDetail("wetter", 
	    "Das Wetter ist herrlich! Windstill und angenehm warm.");
  
  AddDetail("umgebung", 
	    "Du siehst Dir die Umgebung genau an und Du "
	    "siehst ueber Dir den blauen Himmel, unter Deinen Fuessen "
	    "Sand, eine grosse Klippe, mehrere Felsen und das Wasser des "
	    "Sees.");
  
  AddDetail(({"fels","felsen"}), 
	    "Ein paar kleinere Felsen liegen entlang des Ufers.");
  
  AddDetail("stellen", 
	    "An einigen wenigen Stellen reicht der Sand "
	    "bis ans Ufer, so dass Du bequem ins Wasser gehen und "
	    "schwimmen kannst.");
  
  AddDetail("weile", 
	    "Wie lang die Weile dauert haengt von Dir ab.");
  
  AddDetail("ufer", 
	    "Das Ufer besteht aus einigen kleineren Felsen "
	    "und ein paar Stellen, an denen der Sand bis ans Wasser "
	    "reicht.");
  
  AddDetail("graeser", 
	    "Zwischen den Felsen siehst Du ein paar "
	    "duerre Graeser hervorwachsen.");
  
  AddDetail("schilf", 
	    "Du siehst einige wenige Schilfrohre aus dem Boden wachsen.");
  
  AddDetail(({"schilfrohre","rohre","rohr","schilfrohr"}), 
	    "Dicke gelbe Rohre aus Schilf.");
  
  AddSound(DEFAULT_SOUND, 
	   "Du hoerst aus der Ferne ein dumpfes "
	   "Donnern und leises Vogelgezwitscher aus dem Westen.");
  
  AddSound("donnern", 
	   "Das Donnern kommt aus dem Norden, wo sich "
	   "die Klippe befindet. Du kannst die Ursache aber nicht "
	   "erkennen.");
  
  AddSound(({"voegel","gezwitscher"}), 
	   "Aus dem Westen hoerst Du Vogelgezwitscher.");
  
  AddSound("wellen", 
	   "Du hoerst die Wellen leise ans Ufer schlagen.");
  
  AddSound("wind", 
	   "Du hoerst keinen Wind, weil es hier windstill ist.");
  
  
  AddExit("sueden", 
	  ([EX_DEST: ROOM "1", EX_TESTFUNC: "rausgehen"]));

  AddCmd(({"sitz","setze","sitze","setz"}), "setze");
  AddCmd(({"steh","stehe"}), "aufstehen");
  AddCmd(({"entspann","entspanne"}), "entspanne");
  AddCmd(({"bade","bad","schwimm","schwimme"}), "schwimme");
  AddCmd(({"kletter","klettere"}), "kletter");
  AddCmd(({"wuehl","wuehle","durchwuehl","durchwuehle"}), "durchwuehle");
}

nosave int durchwuehle(string str)
{
  object qi, fe;
  
  notify_fail(BS("Was moechtest Du durchwuehlen?"));
  if(!str) return 0;
  
  if(str=="sand")
    if(feder)
      {
	qi=present("\n_insel_quest",TP);
	
	if((objectp(qi) && qi->frage_feder_ort() == 1))
	  {
	    fe=clone_object(OBJ"schwanfeder");
	    
	    if(fe->move(TP, M_GET)==ME_TOO_HEAVY)
	      {
		fe->remove(1);
		
		write(BS("Du wuehlst im Sand und entdeckst doch tatsaechlich "
			 "eine Feder, die der Schwan verloren haben muss! "
			 "Doch leider ist sie Dir zu schwer und Du laesst "
			 "sie liegen."));
		
		return 1;
	      }

	    write(BS("Du wuehlst im Sand und entdeckst doch tatsaechlich "
		     "eine Feder, die der Schwan verloren haben muss!"));

	    tell_room(TO, BS(TPN+" wuehlt im Sand und findet etwas."),({TP}));
	    
	    feder= 0;

	    return 1;
	  }
	else
	  return write(BS("Du wuehlst vergeblich im Sand herum.")), 1;
      }
    else
      {
	write(BS("Du wuehlst vergeblich im Sand herum."));

	tell_room(TO, BS(TPN+" wuehlt vergeblich im Sand herum."),({TP}));

	return 1;
      }
  
  return 0;
}

nosave int kletter(string str)
{
  notify_fail("Wohin moechtest Du klettern?\n");
  if(!str) return 0;
  
  if(str=="auf klippe"||str=="zur klippe")
    return notify_fail(BS("Die Klippe ist zu weit weg, um sie zu "
			  "erklimmen.")), 0;

  return 0;
}

void reset()
{
  ::reset();
	
  reset_zaehler++;
  feder=1;
	
  if(reset_zaehler>=3)
    {
      reset_zaehler = 0;
      ausgeruhte =({});
    }
}

nosave int schwimme(string str)
{
  notify_fail("Worin moechtest Du schwimmen?\n");
  if(!str) return 0;
	
  if(str=="in see" || str=="in bucht" || str=="in wasser"||
     str=="im see" || str=="im bucht" || str=="im wasser")
    {   
      if(sizeof(TP->QueryArmours(({AT_TROUSERS, AT_ARMOUR, AT_BOOT}))))
	return write(BS("Du willst doch nicht mit Deiner Ruestung "
			"schwimmen gehen, oder?")), 1;
      
      TP->move(ROOM "wasser", M_GO, "ins Wasser", "stuerzt sich", 
	       "kommt angeschwommen");
      
      if(!present("isabella", ENV(TP)))
	write(BS("Du stuerzt Dich froh in das klare Wasser "
		 "der Bucht und schwimmst eine Runde. Durch Dein "
		 "Schwimmen stoerst Du allerdings ein Wesen auf!"));
      else
	write(BS("Du stuerzt Dich froh in das klare Wasser "
		 "der Bucht und schwimmst ein paar Runden."));
      
      return 1;
    }
  
  return 0;
}

nosave int setze(string str)
{
  object ob;
  
  notify_fail(BS("Wohin denn setzen? Auf den Boden etwa?"));
  if(!str) return 0;
  
  if(str=="nieder" || str=="dich nieder"||"auf boden"||str=="auf den boden")
    if(TP->QueryProp("sitzen"))
      return write(BS("Du sitzt doch schon ganz entspannt.")), 1;
    else
      {
	TP->SetProp("sitzen",1);
	return write(BS("Du setzt dich gemuetlich auf den Boden.")), 1;
      }
  
  return 0;
}

nosave int aufstehen(string str)
{
  notify_fail(BS("Willst Du etwa aufstehen?")); 
  if(!str) return 0; 
   
  if(str=="auf"||str=="von boden auf"||str=="vom boden auf") 
    if(TP->QueryProp("sitzen"))
      { 
        write(BS("Du stehst wieder auf.")); 
        TP->SetProp("sitzen",0);
        return 1; 
      } 
    else 
      return write(BS("Aber Du sitzt doch garnicht auf dem Boden.")), 1; 
 
  return 0; 
}

int rausgehen()
{
  if(TP->QueryProp("sitzen"))
    write(BS("Du stehst gemuetlich auf..."));

  return 1;
}

nosave int entspanne(string str)
{
  object ob;
  
  if(!TP->QueryProp("sitzen"))
    return write(BS("Willst Du das etwa im Stehen machen?")), 1;
	
  if(member(ausgeruhte, TP->query_real_name())==-1)
    {
      write(BS("Du schliesst die Augen, legst Dich nach hinten und "
	       "geniesst die Stille. Komplett ausgeruht erwachst Du "
	       "und stehst wieder auf."));

      TP->AddHp(100);
      TP->AddSp(100);

      ausgeruhte+=({TP->query_real_name()});

      TP->SetProp("sitzen",0);

      WLOG("/d/kristallwald/sargola/log/entspanne", "entspannt sich");
      return 1;		
    }
  else
    return write(BS("Bist Du nur im Silberland, um Dich auszuruhen? Geh "
		    "doch lieber Forschen oder Metzeln oder ...\n")), 1;
  
  return 0;
}
