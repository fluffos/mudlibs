#include "../def.h"

inherit "std/room";

nosave int feder;
nosave int schluessel;
nosave int tinte;
nosave int taube;
nosave int fenster;
nosave int geschuettelt;

string unterseite();

void create()
{
  ::create();
  
  feder = 1;
  schluessel = 1;
  tinte = 1;
  taube = 1;
  fenster = 0;
  geschuettelt = 0;
  
  SetProp(P_INT_SHORT, "In einem Baumhaus");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich in einem versteckten Baumhaus, "
	     "das so manchem Paerchen als Liebesversteck dient. Das Baumhaus "
	     "besteht gaenzlich aus Holz. An der Nord- und Suedwand siehst Du "
	     "jeweils ein kleines Fenster und am Boden die Luke, durch die Du "
	     "nach oben geklettert bist. Das Mobiliar besteht aus einem Bett "
	     "mit unzaehligen Polstern darauf und einem kleinen Tischchen."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_HOUSE,ENV_TEMPERATURE:25]));
  
  
  AddDetail(({"baumhaus","raum"}), 
	    "Das Baumhaus befindet sich in der Krone des Johannisbrotbaumes. "
	    "Es ist aus Holzbrettern gezimmert und wirkt von Innen "
	    "wesentlich groesser als Du vermutet haettest.");
  
  AddDetail(({"kiefernholz","holz"}), 
	    "Fast alles hier im Baumhaus besteht aus Holz. Du vermutest, "
	    "dass es sich um Kiefernholz handelt.");
  
  AddDetail(({"versteck","liebesversteck"}), 
	    "Aufgrund seiner versteckten Lage ist das Baumhaus ein "
	    "ideales Liebesnest fuer verliebte Paerchen.");
  
  AddDetail("paerchen", 
	    "So manches Paerchen hat hier viele Stunden mit Kuessen und "
	    "Schmusen zugebracht. Bekommst Du nicht Lust, es ihnen "
	    "gleichzutun?");
  
  AddDetail(({"waende","wand"}), 
	    "Welche Wand moechtest Du untersuchen?");
  
  AddDetail("nordwand", 
	    "An der Nordwand befindet sich ein kleines Fenster, "
	    "durch das Licht ins Innere des Baumhauses dringt.");
  
  AddDetail("suedwand", 
	    "An der Suedwand befindet sich ein kleines Fenster, "
	    "durch das Licht ins Innere des Baumhauses dringt.");
  
  AddDetail("westwand", 
	    "Hm... da haengt etwas an der Westwand.");
  
  AddDetail("ostwand", 
	    "Eine ganz normale Ostwand ohne irgendetwas Besonderes.");
  
  AddDetail("fenster", 
	    "An der Nord- und an der Suedwand siehst Du jeweils ein "
	    "kleines Fenster.");
  
  AddDetail(({"kristallwald","wald" }), 
	    "Durch das noerdliche Fenster siehst Du den Kristallwald.");
  
  AddDetail("see", 
	    "Noerdlich des Sees siehst Du den Kristallwald.");
  
  AddDetail(({"ast","aeste"}), 
	    "Auf den Aesten des Johannisbrotbaumes sitzt eine Taube.");
  
  AddDetail("boden", 
	    "Der Boden besteht, wie alles im Baumhaus, aus Holzbrettern "
	    "und ausser einer Luke siehst Du dort nichts Besonderes.");
  
  AddDetail("luke", 
	    "Durch die Luke im Boden kann man das Baumhaus betreten und "
	    "verlassen.");
  
  AddDetail("mobiliar", 
	    "Ein Bett mit Polstern und ein Tischchen sind das gesamte "
	    "Mobiliar hier im Baumhaus.");
  
  AddDetail("bett", 
	    "Das Bett ist aus Holz und von unzaehligen Polstern bedeckt. "
	    "Es sieht sehr weich und kuschelig aus, man liegt sicher sehr "
	    "bequem darin.");
  
  AddSpecialDetail(({"polster","polster"}), "polster_det");
  
  AddDetail(({"feder","federn"}), 
	    "Die Fuellung der Polster besteht aus Federn.");
  
  AddDetail("fuellung", 
	    "Die Fuellung ist schon ziemlich zerknautscht. Woher das "
	    "wohl kommen mag? *grins*");
  
  AddDetail("tischchen", 
	    "Ein kleines Tischchen aus Holz mit einer Schublade.");
  
  AddDetail(({"platte","tischplatte"}), 
	    "Hmm... Eine ganz normale Platte aus Holz. Zumindest die "
	    "Oberseite sieht so aus.");
  
  AddDetail("oberseite",
	    "Die ist ganz normal. Vielleicht betrachtest Du das Tischchen "
	    "mal von unten.");
  
  AddDetail("unterseite",
	    "Du untersuchst die Unterseite und entdeckst mit dem Auge eine "
	    "kleine Unebenheit in der Maserung.");
  
  AddDetail("maserung", 
	    "Die Maserung der Platte ist ungleichmaessig.");

  AddDetail("unebenheit", 
	    "Du gehst mit Deinem Auge ganz nah hin ... und kannst trotzdem "
	    "nichts entdecken. Verwende mal einen anderen Deiner Sinne ...");
  
  AddDetail(({"sehen","fuehlen","schmecken","hoeren","riechen","sinne"}),
	    "Es gibt da Sehen, Fuehlen, Riechen, Schmecken, Hoeren.");
  
  AddDetail("auge", 
	    "Oki, Du bekommst den Forscherpunkt.");
  
  AddDetail("forscherpunkt", 
	    "Tja, man kann nicht ueberall einen bekommen...");

  AddDetail(({"fuesse","tischfuesse"}), 
	    "Du untersuchst die vier Fuesse des Tisches und "
	    "kommst zu keinem ueberwaeltigend neuem Ergebnis.");
  
  AddDetail(({"lade","schublade"}), 
	    "Du koenntest sie oeffnen.");
  
  AddDetail("decke", 
	    "An der Decke siehst Du nichts Besonderes.");
  
  AddDetail(({"krone","johannisbrotbaum","baum"}), 
	    "Das Baumhaus befindet sich in der Krone des Johannisbrotbaumes.");
  
  AddDetail(({"holzbretter","bretter"}), 
	    "Das Baumhaus ist aus Holzbrettern gezimmert.");
  
  AddDetail(({"innen","inneres"}), 
	    "Du befindest Dich nun im Inneren des Baumhauses.");
  
  AddDetail(({"liebesnest","nest"}), 
	    "Das Baumhaus ist ein ideales Liebesnest fuer verliebte "
	    "Paerchen.");
  
  AddDetail(({"stunde","stunden"}), 
	    "Du wirst doch wohl wissen, was eine Stunde ist!");
  
  AddDetail(({"kuessen","schmusen"}), 
	    "Weisst Du wirklich nicht, wie das geht?");
  
  AddDetail("lust", 
	    "Lust kann man nicht naeher untersuchen.");
  
  AddDetail("licht", 
	    "Es dringt durch die Fenster ins Innere des Baumhauses.");
  
  AddDetail("etwas", 
	    "Du hast Dich getaeuscht. Da ist doch nichts.");
  
  AddDetail("besonderes", 
	    "Da ist nichts Besonderes.");
  
  AddDetail(({"loch","schluesselloch"}),
	    "Hmm... was macht man in so einem Fall bloss? Der Schluessel "
	    "muesste doch irgendwo ganz in der Naehe sein.");
  
  AddDetail("schluessel", 
	    "DAS waere ein bisschen zu einfach. :)");
  
  AddSound(DEFAULT_SOUND, 
	   "Es herrscht absolute Stille hier im Baumhaus.");
  
  AddSmell(DEFAULT_SMELL, 
	   "Du kannst nichts Besonderes riechen.");
  
  
  AddCmd(({"blicke","blick"}),"blicke");
  AddCmd(({"oeffne"}), "oeffne");
  AddCmd(({"schuettle","schuettel"}), "schuettel");
  AddCmd(({"fuehle","fuehl","beruehr","beruehre","ertaste","taste"}),"fuehle");

  AddExit("runter", ROOM "2");
}

string polster_det(string str)
{
  if(geschuettelt)
    return "Einige mit Federn gefuellte Polster liegen auf dem Bett.\n"
      "Sie scheinen vor kurzem heftigst durchgeschuettelt worden zu sein.\n";


  return "Einige mit Federn gefuellte Polster liegen auf dem Bett.\n"
    "Obwohl sie ziemlich zerdrueckt und zusammengepresst aussehen.\n";

}

nosave int schuettel(string str)
{
  object ob;
  
  notify_fail(BS("Was moechtest Du aufschuetteln?"));
  if(!str) return 0;
  
  if(str=="polster auf" ||str=="polster aus")
    if(feder && objectp(ob=present("\n_insel_quest",TP)) && 
       ob->frage_feder_ort() == 2)
      {
	write(BS("Du schuettelst die Polster und die Decke gehoerig aus. "
		 "Dabei faellt Dir eine Feder auf, die aus einem der Polster "
		 "schwebt."));

	clone_object(OBJ"schwanfeder")->move(ENV(TP));

	feder = 0;
	geschuettelt = 1;

	return 1;
      }
    else
      {
	write(BS("Du schuettelst die Polster und die Decke gehoerig aus."));
	
	geschuettelt = 1;

	return 1;
      }

  return 0;
}

nosave int oeffne(string str)
{
  object ob;
  int i;

  notify_fail(BS("Was moechtest Du oeffnen?"));
  if(!str) return 0;
  
  switch(str)
    {
    case "fenster":
      return write(BS("Das noerdliche oder das suedliche Fenster?")), 1;
      
    case "noerdliches fenster":
    case "fenster in norden":
      return write(BS("Es laesst sich nicht oeffnen.")), 1;

    case "fenster in sueden":
    case "suedliches fenster":
      {
	if(fenster)
	  return write(BS("Das Fenster ist doch schon offen.")), 1;
	
	if(taube)
	  {
	    if(!present("taube"))
	      {
		write(BS("Du oeffnest das Fenster und die Taube "
			 "kommt von draussen reingeflogen."));

		CLONEME(NPC "taube");
	      }
	    else
	      write(BS("Du oeffnest das Fenster."));
	    
	    tell_room(TO, BS("Die Taube scheint auf irgendetwas zu warten."));
	    
	    fenster++;
	    taube--;
	  }
	else
	  {
	    write(BS("Du oeffnest das Fenster."));
	    fenster++;
	  }
	
	return 1;
      }
    case "schublade":
    case "lade":
    case "schublade mit schluessel":
      if(ob = present("\n_insel_schluessel",TP))
	if(tinte)
	  {
	    write(BS("Du steckst den Schluessel in das kleine Schluesselloch "
		     "und drehst ihn herum. *KNACK* Der Schluessel bricht ab, "
		     "doch die Schublade ist offen. Darin entdeckst Du ein "
		     "Flaeschchen und Papier."));

	    ob->remove(1);

	    ob = clone_object(OBJ "papier");
	    
	    if(ob->move(TP, M_GET)==ME_TOO_HEAVY)
	      {
		write(BS("Du kannst das Papier nicht mehr tragen."));
		ob->move(ENV(TP));
	      }

	    ob = clone_object(OBJ "tinte");

	    if(ob->move(TP, M_GET)==ME_TOO_HEAVY)
	      {
		write(BS("Du kannst das Glaeschen nicht mehr tragen."));
		ob->move(ENV(TP));
	      }
	    
	    tinte--;
	    
	    return 1;
	  }
	else
	  return write(BS("Du steckst den Schluessel in das Schluesselloch "
			  "und oeffnest die Schublade. Schade, sie ist "
			  "leer.")), 1;
      else
	return write(BS("Du bemerkst zaehneknirschend, dass da ein kleines "
			"Schluesselloch ist...")), 1;
    }

  return 0;
}


nosave int blicke(string str)
{
  notify_fail(BS("Wodurch moechtest Du blicken?"));
  if(!str) return 0;
  
  switch(str)
    {
    case "durch fenster":
    case "durch das fenster":
    case "fenster":
      return write(BS("Durch Das noerdliche oder das suedliche Fenster?")), 1;
      
    case "durch noerdliches fenster":
    case "durch das noerdliche fenster":
    case "noerdliches fenster":
      return write(BS("Du blickst durch das noerdliche Fenster und siehst "
		      "den Kristallwald, der sich noerdlich des Sees "
		      "erstreckt.")), 1;

    case "durch suedliches fenster":
    case "durch das suedliche fenster":
    case "suedliches fenster":
      if(taube)
	return write(BS("Du blickst durch das suedliche Fenster und siehst "
			"auf den Aesten des Johannisbrotbaumes, die sich "
			"direkt vor dem Fenster befinden, eine Taube "
			"sitzen.")), 1;
      else
	return write(BS("Du blickst durch das suedliche Fenster und siehst "
			"die Aeste eines Johannisbrotbaumes.")), 1;
    }

  return 0;
}

void reset()
{
  ::reset();

  feder = 1;
  schluessel = 1;
  tinte = 1;
  taube = 1;
  fenster = 0;
  geschuettelt = 0;
}

nosave int fuehle(string str)
{
  object schl;

  notify_fail(BS("Was moechtest Du ertasten?"));
  if(!str) return 0;
  
  if(str=="unebenheit")
    if(schluessel)
      {
	schl=clone_object(OBJ"schluessel");

	if(schl->move(TP, M_GET)==ME_TOO_HEAVY)
	  {
	    schl->remove(1);
	    
	    return write(BS("Du faehrst mit den Fingern an der Unterseite der "
			    "Tischplatte entlang und entdeckst doch glatt ein "
			    "Geheimfach! Du klappst es mit vor Freude "
			    "zitternden auf... Doch Du kannst den Schluessel "
			    "darin nicht mehr tragen. Daher laesst Du ihn "
			    "dort wo er war...")), 1;
	  }

	write(BS("Du faehrst mit den Fingern an der Unterseite der "
		 "Tischplatte entlang und entdeckst doch glatt ein "
		 "Geheimfach! Du klappst es mit vor Freude zitternden "
		 "Haenden auf und ein Schluessel faellt Dir in die Haende."));
	
	schluessel--;
	
	return 1;
      }
    else
      return write(BS("Du faehrst mit den Fingern an der Unterseite der "
		      "Tischplatte entlang und entdeckst doch glatt ein "
		      "Geheimfach! Du klapst es mit vor Freude zitternden "
		      "Haenden auf ... doch es ist leer!")), 1;
  
  return 0;
}
