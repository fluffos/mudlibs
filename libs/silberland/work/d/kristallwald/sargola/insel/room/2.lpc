	AddSmell("duft", BS("Er duftet.")); 
	
	
	AddCmd( ({"pfluecke","pflueck"}), "pfluecke");
	AddCmd( ({"brich","breche"}), "brich");
	AddCmd( ({"kraxel","kraxle","kraxl","kletter","klettere"}), "kraxel");
	AddCmd( ({"schluepfe","schluepf"}), "schluepfe");
	AddCmd( ({"greif","greife"}), "greif");

	AddExit( "suedosten", ROOM+"1.lpc" );


	}


int greif(string str)
{
   object ob;
   int i;
   notify_fail("Wo moechtest Du hineingreifen?\n");
   if(!str) return 0;
   
   if(str=="in stock"||str=="in bienenstock"||str=="in wabe"||str=="in bienenwabe")
   {
   	
      if(wabe)
      {
	tell_object(TP, BS("Du greifst in den Bienenstock und kannst "
   		+"eine Wabe ergattern."));
	ob = clone_object(OBJ+"honigwabe");
	i = ob->move(TP);
	if(i == ME_TOO_HEAVY)
	{
	   tell_object(TP, BS("Du kannst die Wabe nicht mehr tragen."));
	   ob->move(environment(TP));
	}
	wabe = 0;
	return 1;
      }
      else
      {
	tell_object(TP, BS("Du greifst in den Bienenstock und wirst im "
	+"gleichen Augenblick von Bienen gestochen."));
	TP->reduce_hit_point(15);
	return 1;
      }
   }
   return 0;
}



/****************************** 
* kraxel auf Johannisbrotbaum *
******************************/

int kraxel(string str)
{
	notify_fail("Wohin moechtest Du kraxeln?\n");
	if(!str) return 0;

	if(str=="auf johannisbrotbaum" || str=="auf baum")
	{	
	    tell_object(TP, "Du kraxelst auf den Johannisbrotbaum.\n");
	    TP->move(ROOM+"4", M_GO, "oben","kraxelt nach",
	    	"kommt heraufgeklettert");
	   return 1;
	}
	return 0;
}


/*********************************
* schluepfe unter Hecke hindurch *
*********************************/

int schluepfe(string str)
{
	notify_fail("Wohin moechtest Du schluepfen?\n");
	if(!str) return 0;

	if(str=="unter hecke hindurch"||"unter hecke durch")
	{
	   
	   tell_object(TP, BS("Du bemuehst Dich laengere Zeit, "
		+"aber schaffst es nicht, durchzukommen. Vermutlich gehts hier doch "
		+"nicht weiter."));
	   return 1;


	   tell_object(TP, "Du schluepfst unter der Hecke hindurch.\n");
	   TP->move("4.lpc", M_GO, "Norden", 
	   	"schluepft nach "
		+"kommt angekrochen");
	   return 1;
	}
	return 0;
}



reset()
{
	::reset();
	anz_brot =2;
	anz_rosen =2;
	wabe = 1;
	hummel = 3;
	auge = 1;
}


/************************
* pfluecke Johannisbrot *
************************/

int pfluecke(string str)
{
	int ret;
	object ob;

	notify_fail("Was moechtest Du pfluecken?\n");
	if(!str) return 0;

	switch(str)
	{
	case "brot":
	case "johannisbrot":
	{    
	    if(anz_brot>=1)
	    {
		tell_object(TP, "Du pflueckst eine Scheibe (?) Johannisbrot "
		+"vom Baum.\n");
		ob = clone_object(OBJ+"joh-brot");
		ret = ob->move(TP);
		if(ret == ME_TOO_HEAVY)
		{
			tell_object(TP, "Die Scheibe ist Dir zu schwer und "
			+"Du legst sie auf den Boden.\n");
			ob->move(environment(TP));
		}
		anz_brot -=1;
  		return 1;	
	    }
	    else
	    {
		tell_object(TP, "Du versuchst, Johannisbrot zu pfluecken, "
		+"aber so sehr Du Dich auch streckst, es ist ausserhalb Deiner "
		+"Reichweite.\n");
		return 1;
	    }
	}
	case "klee":
	case "butterblume":
	case "margerite":
	case "glockenblume":
	case "gaensebluemchen":
	case "blume":
	case "bluemchen":
	case "kuckucksnelke":
	case "wiesenknotenblume":
	case "loewenzahn":
	{
		tell_object(TP,  BS("Du beschliesst, keine Wiesenblumen zu pfluecken.\n"));
		return 1;

	}
	case "rose":
	{
		tell_object(TP, BS("Du kannst die Rose nicht pfluecken, Du musst sie "
		+"vom Rosenbusch brechen.\n"));
		return 1;
	}
	default:
	{
		return 0;
	}
	}
	return 0;
}


/****************************
* brich Rose von Rosenbusch *
****************************/

int brich(string str)
{
	object ob;
	int ret;

	notify_fail("Was moechtest Du denn von wo brechen?\n");
	if(!str) return 0;

	if(str=="rose von rosenbusch"||str=="rose von busch"|| str=="rose vom rosenbusch"||str=="rose vom busch")
	{
	    if(anz_rosen>0)
	    {
		tell_object(TP, BS("Du brichst eine wunderschoene rote Rose "
		+"vom Rosenbusch. Du koenntest sie einer geliebten Person "
		+"schenken.\n"));
		
		ob = clone_object(OBJ+"rose");
		ret = ob->move(TP);
		if(ret == ME_TOO_HEAVY)
		{
		   tell_object(TP, BS("Du brichst die Rose ab und legst sie auf "
			+"den Boden.\n"));
		   ob->move(environment(TP));
		}
		anz_rosen = anz_rosen - 1;
		return 1;
	    }
	    else
	    {
		tell_object(TP, BS("Als Du versuchst, eine Rose vom Rosenbusch zu "
		+"brechen, stichst Du Dich schmerzhaft an einem Dorn.\n"));
		TP->reduce_hit_point(3);
		return 1;
	    }
	}
	
	return 0;
}
				

wabe()
{
	if(wabe)
		return BS("Der Bienenstock besteht aus mit Honig gefuellten Waben.");
	return BS("Der Bienenstock besteht aus fast leeren Waben.");
}



margeriten()
{
   if(auge>=0)
   {
	clone_object(NPC+"pfaug")->move(TO, M_GO|M_SILENT);
	auge-=1;
	return BS("Gerade als Du die grossen Margeriten mit den weissen Blueten unter"
		+"suchst, kommt ein Tagpfauenauge angeflogen und setzt sich auf die "
		+"Bluete.");
   }
   else
   {
	return BS("Du hast Dich doch verschaut.");
   }
}


hummeln()
{
	object ob;

   if(hummel>0)
   {
	ob = clone_object("/d/kristallwald/sargola/lichtung/npc/hummel");
	ob->move(TO, M_GO|M_SILENT);
	ob->Kill(TP);
	hummel=hummel - 1;
	return BS("Du versuchst, die Hummel naeher zu untersuchen, das hat sie aber "
	+"nicht so gern ...");
        
   }
   else
   {
	return BS("Du hast Dich doch verschaut.");
   }
}
