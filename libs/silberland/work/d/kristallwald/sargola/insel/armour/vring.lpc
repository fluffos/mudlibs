#include "../def.h"

inherit "std/armour";

#define MP_KOSTEN 5

nosave string partner;
nosave int zaehler;

string frage_partner();
int erblicke();
string gravur();

void create()
{
  if(!is_clone(this_object())) return;
  ::create();
  
  zaehler = 5;
  
  AddId(({"\n_insel_liebesring","ring","goldring"}));

  SetProp(P_SHORT, "Ein Goldring");
  
  SetProp(P_INFO, 
        BS("Mit <lokalisiere> kannst Du immer sehen, wo Dein Liebling ist und ihm in "
  	"schwierigen Situationen mit Deiner Kraft zur Seite stehen. Mit "
  	"<sende magie> und mit <sende leben> kannst Du ihm helfen."));
  
  SetProp(P_NAME, "Goldring");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 200);
  SetProp(P_MATERIAL, ({MAT_GOLD}));
  SetProp(P_MAGIC, 1);
  SetProp(P_ITEMD_NO_MAGIC, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_NEVERDROP,1);
  SetProp(P_NODROP,1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);

  SetProp(P_QUALITY_DECAY, 999);
  SetProp(P_NO_DAMAGE_DESTRUCT, 1);

  SetProp(P_KILL_NAME, "Unendliche Liebe");
  
  AddDetail("gold", 
	    "Das Gold ist exzellent verarbeitet und nirgends kannst Du eine "
	    "Unebenheit oder sonstige Makel erkennen. Wunderschoen leuchten "
	    "die vom Gold eingefassten Edelsteine. Es bringt ihr Funkeln "
	    "beeindruckend zu Geltung.");
  
  AddDetail(({"unebenheit","makel","oberflaeche"}), 
	    "Sooft Du den Ring auch drehst und wendest: seine Oberflaeche "
	    "ist einfach makellos. Bis auf eine kleine Gravur.");
  
  AddDetail("gravur", 
	    "Du kannst sie lesen.");
  
  AddReadDetail("gravur", CLOSURE(gravur));
  
  AddDetail(({"steine","edelsteine"}), 
	    "Das Gold umrahmt zwei Edelsteine: Einen Rubin und einen "
	    "Mondstein.");
  	
  AddDetail("funkeln", 
	    "Das Funkeln entsteht durch die glatte Oberflaeche des "
	    "Ringes und der edlen Steine, welche hier verarbeitet wurden.");
  	
  AddSpecialDetail("rubin","rubin");
  AddSpecialDetail("mondstein","mondstein");	
  AddSpecialDetail("halbmond","halbmond");
  AddSpecialDetail("kreis","kreis");	
  
  AddDetail(({"liebe","leidenschaft","lebenskraft","gefuehle"}), 
	    "Der Rubin symbolisiert Liebe, Leidenschaft, Lebenskraft und "
	    "starke Gefuehle. Du fuehlst Dich gut bei dem Gedanken, dass "
	    "Du eine Person hast, mit der Du das alles Teilen und Erleben "
	    "kannst.");
  
  AddDetail(({"bereiche","gedanken"}), 
	    "Deine Gedanken schweifen in Bereiche ab, die wir hier "
	    "besser nicht beschreiben ...");
  	
  AddDetail(({"intuition","traeume"}),
	    "Der Mondstein symbolisiert die Intuition, Traeume und unsere "
	    "emotionale Seite.");
  
  AddDetail("seite", 
	    "Beide Seiten, die des Rubines und des Mondsteins vermenge sich "
	    "zu einem kompletten Kreis. Das Symbol wurde hier mit Bedacht "
	    "gewaehlt."); 
  
  AddDetail("kraft", 
	    "Es ist die Ergaenzung der Kraefte, die in einer Beziehung "
	    "wirken, die durch die Symbole des Halbmondes und des Kreises "
	    "symbolisiert werden.");
  	
  AddDetail(({"symbol","symbole"}),
	    "Die uralten Symbole des Halbmondes und des Kreises werden hier "
	    "versinnbildlicht.");
  
  AddCmd(({"sende","send"}), "sende");
  AddCmd(({"lokalisier","lokalisiere"}),"erblick");
}

string gravur()
{
  return BS("Du liest den Namen "+frage_partner()+".");
}

string frage_partner()
{
  return partner;
}

void setze_partner(string str)
{
  partner = str;
}

nosave int erblick(string str)
{
  object p;
  
  if(!frage_partner())
    return write(BS("Du hast Deinen Partner verloren - bitte verstaendige "
		    "Sargola.")), 1;

  p=find_player(lower_case(frage_partner()));

  if(!objectp(p))
    return write(BS("Du kannst Deinen Liebling nicht lokalisieren.")), 1;
  
  if(TP->QueryProp(P_SP) < MP_KOSTEN)
    return write(BS("Deine Magie reicht dazu nicht aus.")), 1;
  
  TP->AddSp(-MP_KOSTEN);

  tell_object(p, 
	      BS("Du merkst, wie Dich Dein Liebling aus der Ferne erblickt."));
  
  write(BS("Du erblickst Deinen Liebling "+p->query_real_name(WEN)+
	   " aus der Ferne...")+
	(ENV(p)->int_long(this_player(),p,0) || ""));
  
  return 1;
}

void _set_autoloadobj(string p)
{
  partner = p;
}

string  _query_autoloadobj()
{
  return partner;
}


nosave int sende(string str)
{
  string name;
  object p;
  int wieviel;
  
  notify_fail("Wem moechtest Du was senden?\n");
  if(!str) return 0;
	
  if(!frage_partner())
    return write(BS("Hmm... Du hast Deinen Partner verloren. "
		    "Bitte verstaendige Sargola.")), 1;
  
  p = find_player(lower_case(partner));
  
  notify_fail("Dein Partner ist leider nicht im Silberland.\n");
  if(!objectp(p)) return 0;

  notify_fail("Du solltest den Ring nicht zuviel beanspruchen.\n");
  if(!zaehler) return 0;
  
  name = p->query_real_name();
  
  wieviel = 5 + random(10);
  
  if((str=="magie" && TP->QueryProp(P_SP)<wieviel)
     ||(str=="leben" && TP->QueryProp(P_HP)<wieviel))
    return write(BS("Du hast selbst zuwenig Punkte, um Deinem "
		    "Partner helfen zu koennen.")), 1;
  
  write(BS("Du konzentrierst Dich und schwoerst ein Bild von "+CAP(name)+
	   " herauf. Du siehst es ganz lebendig vor Dir und Du laechelst. "
	   "Einen kleinen Teil Deiner Freuden, die Du gerade empfindest, "
	   "schickst Du zu "+p->QueryPronoun(WEM)+" los."));
  
  if(str=="magie")
    {
      tell_object(p,
		  BS("Ein leichtes Kribbeln durchfaehrt Dich, als Deine "
		     "Magie sich mit der von Deine"+
		     (TP->QueryProp(P_GENDER)==FEMALE ? "r Partnerin ":
		      "m Partner ")+CAP(getuid(TP))+
		     " vermischt und Dich etwas erfrischt..."));

      p->AddSp(wieviel);	

      TP->AddSp(-wieviel);

      zaehler--;

      return 1;
    }
  else
    if(str=="leben")
      {
	tell_object(p,
		    BS("Ein warmes, wohliges Gefuehl durchfaehrt Dich, als "
		       "Dir Dein"+(TP->QueryProp(P_GENDER)==FEMALE ? "e Part"
		       "nerin ":" Partner ")+CAP(getuid(TP))+" etwas von "+
		       TP->QueryPossPronoun(FEMALE, WEM)+" Lebensenergie "
		       "uebersendet..."));

	p->AddHp(wieviel);	

	TP->AddHp(-wieviel);

	zaehler--;

	return 1;
      }

  notify_fail("Was moechtest Du senden?\n");
  return 0;
}

string halbkreis()
{
  if(MENV->QueryProp(P_GENDER)==MALE)
    return BS("Der Halbkreis ist bei Deinem Ring aus Rubin.");
  return BS("Der Halbkreis ist bei Deinem Ring aus Mondstein.");
}

string kreis()
{
  if(MENV->QueryProp(P_GENDER)==MALE)
    return BS("Der Kreis ist bei Deinem Ring aus Mondstein.");
  return BS("Der Kreis ist bei Deinem Ring aus Rubin.");
}	

string rubin()
{
  if(MENV->QueryProp(P_GENDER)==MALE)
    return BS("Der Rubin hat die Form eines schlanken, nach rechts offenen "
	      "Halbmondes. In ihm eingebettet ruht der Mondstein, der "
	      "dadurch einen kompletten Kreis formt. Der Rubin steht wohl "
	      "fuer Liebe und Leidenschaft, fuer Lebenskraft und starke "
	      "Gefuehle.");
  
  return BS("Der Rubin liegt von einem in Halbmondform geschliffenen Mond"
	    "stein umrahmt. Beide zusammen ergeben einen perfekten Kreis. Der "
	    "Rubin steht wohl fuer Liebe und Leidenschaft, fuer Lebenskraft "
	    "und starke Gefuehle.");
}

string mondstein()
{
  if(MENV->QueryProp(P_GENDER)==MALE)
    return BS("Der Mondstein liegt von einem in Halbmondform geschliffenen Rubin "
	      "umrahmt. Beiden zusammen ergeben einen perfekten Kreis. Der Mondstein "
	      "steht fuer die Kraft des Mondes, aber auch fuer Intuition und Traeume. "
	      "Zu der maennlichen Seite, symbolisiert durch den rubinernen Halbmond, muss auch "
	      "die weibliche Seite kommen, symbolisiert durch den Kreis aus Mondstein. Nur beide "
	      "zusammen ergeben ein Ganzes.");

  return BS("Der Mondstein liegt von einem in Halbmondform geschliffenen Rubin"
	    "umrahmt. Beide zusammen ergeben einen perfekten Kreis. Der "
	    "Mondstein steht wohl fuer die Kraft des Mondes, gleichzeitig aber "
	    "auch fuer Intuition und Traeume. Zu der weiblichen Seite, symbolisiert "
	    "durch den Halbmond aus Mondstein, muss auch die maennliche Seite kommen, "
	    "symbolisiert durch den Kreis aus Rubin. Nur beide zusammen ergeben ein "
	    "Ganzes.");
}

_query_long()
{
  if(MENV->QueryProp(P_GENDER)==MALE)
    return BS("Ein Ring aus dem glaenzendsten Gold, das Du jemals in Deinem "
	      "Leben gesehen hast. Seine Form ist absolut ohne Makel und schon "
	      "aussergewoehnlicher Eleganz. In der Mitte siehst Du zwei Edelsteine "
	      "verarbeitet. Ein in der Form eines schlanken Halbmondes geschliffener "
	      "Rubin rahmt einen runden, schimmernden Mondstein ein. Beide zusammen "
	      "ergeben einen perfekten Kreis.");

  return BS("Ein Ring aus dem glaenzendsten Gold, das Du jemals in Deinem "
	    "Leben gesehen hast. Seine Form ist absolut ohne Makel und schon "
	    "aussergewoehnlicher Eleganz. In der Mitte siehst Du zwei Edelsteine "
	    "verarbeitet. Ein in der Form eines schlanken Halbmondes geschliffener "
	    "Mondstein rahmt einen runden, tiefroten Rubin ein. Beide zusammen "
	    "ergeben einen perfekten Kreis.");

}

_query_info()
{
   if(MENV->QueryProp(P_GENDER)==MALE)
     return BS("Mit <lokalisiere> kannst Du immer sehen, wo Dein Liebling ist und ihr in "
	       "schwierigen Situationen mit Deiner Kraft zur Seite stehen. Mit "
	       "<sende magie> und mit <sende leben> kannst Du ihr helfen. Doch kann "
	       "blinde Liebe auch den Tod bedeuten ...");

   return BS("Mit <lokalisiere> kannst Du immer sehen, wo Dein Liebling ist und ihm in "
	     "schwierigen Situationen mit Deiner Kraft zur Seite stehen. Mit "
	     "<sende magie> und mit <sende leben> kannst Du ihr helfen. Doch kann "
	     "blinde Liebe auch den Tod bedeuten ..."); 	
}


string extra_look()
{
  string a;
  if(!frage_partner()) a = "";
  if(environment(TO)->QueryProp(P_GENDER) ==MALE)
    a = "Er hat sein Herz an "+frage_partner()+" verloren.";
  else
    a = "Sie hat ihr Herz an "+frage_partner()+" verloren.";
  return BS(a);
}

void reset()
{
  ::reset();
  zaehler = 3;
}
