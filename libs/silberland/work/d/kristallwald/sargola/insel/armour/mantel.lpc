#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(this_object())) return;
  ::create();

  AddId(({"algenumhang", "umhang"}));

  SetProp(P_SHORT, "Ein Umhang aus Moosen und Algen");
  SetProp(P_LONG, 
	  BS("Ein Umhang, welcher aus einer blau-gruenlich "
	     "schimmernden Substanz besteht. Mit jeder leichten Bewegung "
	     "veraendern sich die Farben und verlaufen in immer neue "
	     "Kombinationen von Farben.\n"));

  AddDetail("substanz", 
	    "Du vermutest, dass es sich wohl um Algen handelt.");

  AddDetail("algen", 
	    "Sie schimmern in allen Farben.");

  AddDetail("farben",
	    "Sie veraendern sich permanent. Du kannst keine bestimmte "
	    "erkennen.");

  AddDetail("kombinationen", 
	    "Viele Kombinationen aus glaenzenden und schimmernden Farben.");

  SetProp(P_SMELL, "Der Algenumhang riecht irgendwie nach Fisch.\n");
  
  SetProp(P_NAME, "Algenumhang");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 550);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 1);

  SetProp(P_MATERIAL,([MAT_MISC_PLANT:97, MAT_WATER:3]));
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 10);

  AddProp(P_DAM_PROTECTION, ([DT_WATER:1]));
}

 
