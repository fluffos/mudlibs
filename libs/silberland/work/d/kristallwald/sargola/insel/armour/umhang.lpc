inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <armour.h>
#include <new_skills.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
  AddId (({"algenumhang", "umhang"}));
  SetProp (P_SHORT, "Ein Umhang aus Moosen und Algen");
  SetProp (P_LONG, BS("Ein Umhang, welcher aus einer blau-gruenlich "
  	+"schimmernden Substanz besteht. Mit jeder leichten Bewegung "
  	+"veraendern sich die Farben und verlaufen in immer neue "
  	+"Kombinationen von Farben.\n"));

  AddDetail("substanz", BS("Du vermutest, dass es sich wohl um "
	+"Algen handelt."));
  AddDetail("algen", BS("Sie schimmern in allen Farben."));
  AddDetail("farben",BS("Sie veraendern sich permanent. Du kannst "
	+"keine bestimmte erkennen."));
  AddDetail("kombinationen", BS("Viele Kombinationen aus glaenzen"
	+"den und schimmernden Farben."));
  
  SetProp (P_NAME, "Algenumhang");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 550);
  SetProp (P_VALUE, 200);
  SetProp (P_MATERIAL, ({MAT_PLANT}) );
  SetProp (P_ARMOUR_TYPE, AT_CLOAK);
  SetProp (P_AC, 10);

}

 
