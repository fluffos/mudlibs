#include "../def.h"

inherit "std/thing";

void create()      
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"\n_insel_rose","rose"}));

  SetProp(P_SHORT, "Eine wunderschoene Rose");
  SetProp(P_LONG, "Eine Rose");
  SetProp(P_NAME, "Rose");
  SetProp(P_GENDER, FEMALE); 
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 20);
  SetProp(P_MATERIAL, ({MAT_PLANT}));
  SetProp(P_SMELL, "Die Rose duftet herrlich.\n");

  AddDetail("stiel", 
	    "Ein langer, dunkelgruener Stiel.");

  AddDetail(({"dorn","dornen"}) ,
	    "Es sind Dornen auf der Rose, aber die gehoeren dazu.");
}  

string _query_long()
{
  string a;
  
  a=BS("Du siehst eine wunderschoene, langstielige, "
       "herrlich duftende, rote Rose.");

  if(!MENV) return a;
  
  if(interactive(MENV))
    {
      if(TP->QueryProp(P_GENDER)==FEMALE)
	a+=BS("Du koenntest sie Deinem Liebsten schenken.");
      else
	a+=BS("Du koenntest sie Deiner Liebsten schenken.");
    }

  return a;
}
