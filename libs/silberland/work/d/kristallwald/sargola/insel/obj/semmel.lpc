inherit "std/food";
#include <properties.h>
#include <food.h>
#include "../def.h"



void create()
{
   if (!is_clone(this_object())) return;
   ::create();

   SetProp(P_SHORT, "Eine Semmel");
   SetProp(P_LONG,
      "Eine praechtige, wunderbar rote Walderdbeere.\n");
   SetProp(P_GENDER, FEMALE);
   SetProp(P_NAME, "Semmel");
   AddId(({ "semmel"}));
   SetProp(P_WEIGHT, 10);
   SetProp(P_VALUE, 5);
   SetProp(P_FOOD_INFO, ([F_HEAL : ({4, 0}), F_SOAK : 0]));

}

void BeimEssen()
{
   tell_object(TP, "Du verspeist genuesslich die Erdbeere.\n");
   tell_room(MENV, TPN+" verspeist genuesslich eine Erdbeere.", ({TP}) );
}

