#include "../def.h"

inherit "/std/thing";
inherit "/mail/nedit";
inherit "/std/more";

nosave string nachricht;
nosave int voll;
nosave string owner;

string frage_owner();
string setz_owner(string str);
string lesen(string str);
int beschrieben();

void create()      
{
  if(!is_clone(ME)) return;
  ::create();
  
  owner = "";
  nachricht = "";
  voll = 0;
  
  AddId(({"\n_insel_papier","\n_insel_liebesbrief","briefpapier","papier",
	    "brief","liebesbrief"}));
  SetProp(P_SHORT, "Briefpapier");
  SetProp(P_LONG, "Einfaches Briefpapier.\n");
  
  SetProp(P_NAME, "Briefpapier");
  SetProp(P_GENDER, NEUTER); 
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 3);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, ({MAT_PERGAMENT}));
  
  SetProp(P_INFO, 
	  BS("Los, nutze die Chance und schreib Deinem Schwarm was Liebes!"));
  
  AddDetail("bogen", 
	    "Ein weisser Bogen Briefpapier.");

  AddReadDetail(({"brief","liebesbrief"}), CLOSURE(lesen));
  
  AddCmd(({"schreib","schreibe"}),"schreib");
  AddCmd(({"zerknuell","zerknuelle"}), "zerknuelle");
}  

_query_long()
{
  if(voll)
    return BS("Du siehst ein beschriebenes Blatt Papier. Vielleicht ist es "
	      "ein Liebesbrief fuer Dich? Lies ihn doch mal!")+
      BS("Mit \"zerknuelle\" kannst Du ihn wegwerfen.");

  return BS("Du siehst ein leeres Blatt Papier, das sich hervorragend dazu "
	    "eignet, jemandem einen Liebesbrief zu schreiben.");
}

nosave int zerknuelle(string str)
{
  notify_fail(BS("Was moechest Du zerknuellen?"));

  if(!str) return 0;

  if(member(({"brief","liebesbrief","papier","briefpapier"}), str)==-1)
    return 0;
  
  write(BS("Du nimmst das Papier, zerknuellst es und wirfst es weg."));
  tell_room(ENV(TP), 
	    BS(TPN+" zerknuellt ein Blatt Papier und wirft es weg."), ({TP}));
  remove();

  return 1;
}

string lesen(string str)
{
  if(!strlen(nachricht)) 
    return "Das Blatt ist ja noch leer!\n";
  
  return nachricht;
}

int beschrieben()
{
  return voll;
}

nosave int schreib(string str)
{
  notify_fail(BS("Was moechtest Du schreiben?"));
  
  if(!str) return 0;

  if(str!="brief") return 0;
  
  if(!present("\n_insel_schwanenfeder",TP) || (!present("tinte",TP)) )
    return write(BS("Du brauchst eine Feder, die Du als Kiel verwenden "
		    "kannst und Tinte um einen Brief zu schreiben.")), 1;

  if(voll)
    return write(BS("Der Bogen ist ja schon beschrieben ... *seufz*")), 1;
  
  write(BS("Nimm Dir Zeit und waehle Deine Worte wohl:")+
	BS("(~h Hilfsseite, ~q Abbruch, . wenn fertig)"));
  
  nedit("write_text",
	"\n\n"+CAP(getuid(TP))+" verfasste am "+dtime(time()) +
	" folgenden Brief fuer Dich: \n\n");
  
  return 1;
}

write_text(str)
{	
  if(!str) {
    write("Abbruch. War wohl doch nichts mit literarischen Erguessen? *grins*\n");	
    str +=str;
    return 1;
  }

  nachricht = str;

  write(BS("Zufrieden steckst Du den Kiel weg und betrachtest Dein Werk."));

  voll = 1;

  return 1;
}

string frage_owner()
{
  return owner;
}

string setz_owner(string str)
{
  if(!owner)
    {
      if(getuid(previous_object())!= getuid() )
	return owner = 0;

      return owner = str;
    }
}
