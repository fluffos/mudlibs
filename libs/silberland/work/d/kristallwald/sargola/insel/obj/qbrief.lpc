inherit "/std/thing";
inherit "/mail/nedit";
inherit "/std/more";
#include <properties.h>
#include <language.h>
#include "../def.h"

string nachricht;
int voll;

string owner;
string frage_owner();
string setz_owner(string str);

void create()      
{        if (!is_clone(this_object()))           return;
  ::create();

  nachricht = "";
  voll = 0;
  owner = "";		
  AddId ( ({"\n_insel_liebesbrief","briefpapier","papier","brief","liebesbrief"}) );
  SetProp (P_SHORT, "Ein Liebesbrief");
  SetProp (P_LONG, "Du willst doch nicht etwa den Brief lesen, oder?\n");
  SetProp (P_NAME, "Liebesbrief");
  SetProp (P_GENDER, MALE); 
  SetProp (P_WEIGHT, 5);
  SetProp (P_VALUE, 3);
  SetProp (P_MATERIAL, ({MAT_PAPER}));

  AddDetail( "bogen", "Ein weisser Bogen Briefpapier.\n");

//  AddCmd( ({"schreib","schreibe"}),"schreib");
  AddCmd( ({"lies"}),"lies");
//  AddCmd( ({"zerknuell","zerknuelle"}), "zerknuelle");
}  

int lies(string str)
{
  notify_fail("Was moechtest Du lesen?\n");
  if(str=="brief" || str=="liebesbrief")
  {	
    tell_object(TP, "Du kannst den armen Schuechtling doch nicht so hintergehen!\n");
    return 1;
  }
  return 0;
}

string frage_owner()
{
  return owner;
}

mixed setz_owner(string str)
{
  if(owner == "")
  {
    if(getuid(previous_object())!= getuid() )
      return owner = "";
    return owner = str;
  }
}
