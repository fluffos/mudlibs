#include "../def.h"
#include <food.h>

inherit "std/food";

create()      
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"\n_insel_honigwabe","honigwabe","wabe"}));

  SetProp(P_SHORT, "Eine Honigwabe");
  SetProp(P_LONG, 
	  BS("Du siehst eine mit suessem Honig gefuellte Honigwabe."));
  SetProp(P_NAME, "Honigwabe");
  SetProp(P_GENDER, FEMALE); 
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);

  SetProp(P_MATERIAL, ([MAT_MISC_FOOD:40, MAT_WAX:60]));

  SetProp(P_FOOD_INFO, ([F_HEAL:10, F_SOAK:5]));
  
  SetProp(P_INFO,
	  BS("Das Wachs solcher Honigwaben wird oft zu Kerzen verarbeitet."));
  
  SetProp(P_SMELL, 
	  BS("Der Honig duftet verfuehrerisch lecker."));

  AddDetail("honig", 
	    BS("Die Wabe ist mit suessem, goldgelbem Honig gefuellt."));

  AddDetail(({"wachs","honigwabenwachs","wabenwachs"}),
	    "Diese Wabe wuerde sicher eine huebsche Kerze abgeben.");

  AddDetail(({"biene","bienen"}), 
	    "Du siehst an einer Honigwabe keine Biene - zum Glueck, sonst "
	    "wuerde sie Dich sicher stechen!");
  
  AddCmd(({"drehe","dreh","rolle","roll"}), "rolle");
  AddCmd(({"bastel","bastle","bastele","mache","mach","bau","baue"}), "baun");
}

nosave int baun(string str)
{
  notify_fail(BS("Was moechtst Du worum rollen?"));
  if(!str) return 0;

  if((strstr(str, "kerze")!=-1) ||
     (strstr(str, "wabe")!=-1) ||
     (strstr(str, "flechte")!=-1))
    return notify_fail(BS("Wieso rollst Du nicht einfach die Wabe um die "
			  "Flechte?")), 0;
  return 0;
}

nosave int rolle(string str)
{
  object flechte, ob;
  int i;
	
  notify_fail(BS("Was moechtst Du worum rollen?"));
  if(!str) return 0;

  if(str=="wabe um flechte"||str=="wabe um flechten"||str=="wabe zu kerze"||
     str=="honigwabe um flechte"||str=="honigwabe um flechten"||
     str=="honigwabe zu kerze")
    {
      if(!flechte=present("\n_insel_flechte",TP))
	return write(BS("Du hast nichts bei Dir, das Du als Docht "
			"verwenden koenntest.")), 1;
      
      write(BS("Du legst den Docht in die Mitte der Waben und "
	       "rollst die Honigwaben drumherum. Und schon hast du eine "
	       "fast schon romantisch einfache Kerze gemacht."));
      
      ob=clone_object(OBJ "kerze");
      
      if(ob->move(TP, M_GET)==ME_TOO_HEAVY)
	{
	  write(BS("Wie ungeschickt von Dir, jetzt ist Dir die Kerze doch "
		   "glatt aus der Hand gefallen..."));
	  ob->move(ENV(TP));
	}

      RemoveCmd(0);

      call_out("remove",0);
      
      flechte->remove(1);
      
      return 1;
    }

  return 0;
}  

void BeimEssen()
{
  tell_object(TP, BS("Du leckst genuesslich die Waben aus."));
  tell_room(ENV(TP), BS(TPN+" sabbert an einer Honigwabe herum."));
}
