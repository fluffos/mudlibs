#include "../def.h"

inherit "std/thing";

nosave int anzahl;

void create()      
{    
  if(!is_clone(ME)) return;
  ::create();
  
  anzahl = 3+random(2);
  
  AddId(({"muschel","\n_insel_muschel"}));

  SetProp(P_SHORT, "Eine Muschel");
  SetProp(P_LONG, 
	  BS("Eine kleine halbrunde, faustgrosse Muschel. Auf "
	     "ihrer Rueckseite siehst Du zahlreiche Rillen die alle "
	     "zusammenstreben. Sie fuehlt sich ziemlich rauh an."));
  
  AddDetail(({"rueckseite","seite"}),
	    "Die Rueckseite wird von zahlreichen Rillen geziert, jede "
	    "so in etwa fuenf Millimeter tief. In den Rillen kannst "
	    "Du noch den Schlamm und Dreck des Meeres erkennen. Alle "
	    "Rillen streben einem gemeinsamen Punkt zu.");
  AddDetail(({"rille","rillen"}),
	    "Die Rillen streben alle einem gemeinsamen Punkt zu und "
	    "sind fuenf Millimeter tief. Sie sind erstaunlich gleich"
	    "maessig bis auf eine kleine Unebenheit.");
  
  AddDetail("punkt", 
	    "Alle Rillen streben zu einem Punkt zu, in dem "
	    "sich die Muschel in sich selbst windet. Insofern siehst "
	    "ein gaehnendes Loch an der Muschel.");
  AddDetail("loch", 
	    "Nunja, wo sich die Muschel halt ins Innere kruemmt.");
  AddDetail("innere", 
	    "Viel kannst Du so nicht sehen.");
  AddDetail("millimeter", 
	    "Noe, sowas ist zu muehsam, um es zu beschreiben.");
  AddDetail("schlamm", 
	    "Schlamm und Dreck aus dem Meer hat sich zwischen "
	    "den Rillen verfangen. Aber das stoert die Schoenheit der "
	    "Muschel kaum.");
  AddDetail("schoenheit", 
	    "Bis auf einen kleine Unebenheit ist sie "
	    "wirklich schoen geformt. ");
  AddDetail("unebenheit", 
	    "Auf der Rueckseite hat sich zwischen zwei "
	    "Rillen irgendein Tier ein Zuhause gebastelt.");
  AddDetail("tier", 
	    "Nach der laenglichen Form zu urteilen ist es "
	    "wohl ein winziger Wurm gewesen.");
  AddDetail("wurm", 
	    "Leider siehst Du ihn nirgends, sonst haettest Du "
	    "\"Hallo\" sagen koennen.");
  AddDetail("form", 
	    "Eindeutig laenglich.");
  AddDetail("zuhause", 
	    "Wenn man sowas ueberhaupt als Zuhause bezeichnen "
	    "kann...");
  AddDetail("punkt", 
	    "In dem Punkt woelbt sich die Muschel in sich selbst.");
  
  SetProp(P_INFO, 
	  BS("Du denkst . o 0 (Hmm...sie ist optisch zwar ganz schoen, aber "
	     "ob das alles war?)"));

  SetProp(P_NAME, "Muschel");
  SetProp(P_GENDER, FEMALE); 
  SetProp(P_WEIGHT, 145);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL,({MAT_MISC_DEAD}));
  SetProp(P_ARTICLE, 1);

  SetProp(P_SMELL, BS("Die Muschel riecht irgendwie nach Schlamm.\n"));
  SetProp(P_SOUND, BS("Vielleicht hoerst Du was, wenn Du naeher rangehst..."));

  AddCmd(({"presse","press"}), "press");
}  

nosave int press(string str)
{
  notify_fail(BS("Woran moechtest Du denn die Muschel pressen?"));
  if(!str) return 0;
  
  if(str=="muschel an ohr")
    if(anzahl)
      if(TP->QueryProp(P_DEAF))
	{
	  write(BS("Du legst die Muschel an Dein Ohr und hoerst zuerst "
		   "leise dann immer lauter das Rauschen des Meeres!"));

	  tell_room(ENV(TP), 
		    BS(TPN+" legt eine Muschel an "+
		       (TP->QueryProp(P_GENDER)==MALE ? " sein ":" ihr ")+
		       "Ohr."),({TP}));
	  anzahl--;
	  
	  TP->SetProp(P_DEAF,0);
	  
	  return 1;
	}
      else
   	return write(BS("Du legst die Muschel an Dein Ohr...aber nichts "
			"passiert.")), 1;
    else
      {
	write(BS("Du presst die Muschel viel zu heftig an Dein Ohr und "
		 "zerbrichst sie ... wie ungeschickt!"));
	
	RemoveCmd(0);
	
	call_out("remove",0);
	
	return 1;
      }
  return 0;
}

