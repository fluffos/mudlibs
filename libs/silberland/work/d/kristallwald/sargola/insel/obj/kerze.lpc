inherit "std/thing";
#include <properties.h>
#include <language.h>
#include "../def.h"

      create()      
{        if (!is_clone(this_object()))           return;
	::create();

	AddId ( ({"kerze","\n_insel_kerze"}) );
	SetProp (P_SHORT, "Kerze");
	SetProp(P_LONG, "Eine kleine, haendisch hergestellte Kerze aus Bienenwachs mit "
		+"einer Flechte als Docht.");
	SetProp (P_NAME, "Kerze");
	SetProp (P_GENDER, FEMALE); 
	SetProp (P_WEIGHT, 15);
	SetProp (P_VALUE, 20);
	SetProp (P_MATERIAL, ({MAT_PLANT }));
	SetProp (P_ARTICLE, 1);
	SetProp( DEFAULT_SMELL, "Die Flechte duftet nach nichts Aussergewoehnlichem.\n");
	
}  

