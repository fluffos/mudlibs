inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  AddId (({"algen"}));
  SetProp (P_SHORT, "Ein Haufen Algen");
  SetProp (P_LONG, "Seltsame blau-gruenlich schimmernde Pflanzen. Wenn "
      "Du sie im Licht drehst, veraendern sich die Schimmer in immer "
      "neue Kombinationen von Farben. Sie haben eine eigenartig laeng"
      "liche Form.");

  AddDetail("pflanzen", "Welche Art von Pflanzen es ist, kannst Du nicht "
      "erkennen. Jedoch ist sicher, dass es sich um eine seltene Art von "
      "Algen handelt.");

  AddDetail("art", "Vermutlich sind es Algen.");

  AddDetail("licht", "Die Algen veraendern sich mit unterschiedlichem "
      "Lichteinfall. Immer neue Variationen von Farben und Schimmern "
      "erfreuen Dein Auge.");

  AddDetail( ({"gruentoene","variationen"}),
      "Du drehst fasziniert die Algen hin und her.");

  AddDetail( ({"farben","farbe"}), "Du kannst blaue und rote, meist aber "
      "Gruentoene erkennen.");

  AddDetail("schimmer", "Sie entstehen aus dem Widerspiegeln des Lichtes.");

  AddDetail("form", "Die Algen haben eine laengliche Form. Sie sind in "
      "etwa ein bis zwei Meter lang und sie wirken fast wie ein Umhang.");
  AddDetail("umhang","Ja wie ein Umhang... was sagt uns das nun?");  	


  SetProp (P_NAME, "Haufen Algen");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 550);
  SetProp (P_VALUE, 100);
  SetProp (P_NOBUY, 1);

  AddCmd( ({"ziehe","zieh"}), "ziehe");
  AddCmd( ({"verwend","verwende","benutz","benutze"}), "benutze");
  AddCmd( ({"haenge","haeng","trag","trage"}) , "haenge");
}

int haenge (string str)
{
  object ob;
  int ret;

  notify_fail("Was moechtest Du Dir umhaengen?\n");
  if(!str) return 0;

  if(str=="algen um" || str=="algen")
  {
    tell_object(TP,BS("Du haengst Dir die Algen sorgfaeltig um."));
    ob = clone_object(ARMOUR+"umhang");
    ret = ob->move(TP);
    if(ret == ME_TOO_HEAVY)
    {
      tell_object(TP, BS("Du kannst Deinen neuen Umhang nicht "
            +"mehr tragen."));
      ob->move(environment(TP));
      SetProp(P_COMMANDS, 0);
      call_out("remove", 0);
      return 1;
    }
    TP->command_me("ziehe algenumhang an");
    SetProp(P_COMMANDS, 0);
    call_out("remove", 0);
    return 1;
  }
  return 0;
}


int ziehe(string str)
{
  notify_fail("Was moechtst Du anziehen?\n");
  if(!str) return 0;

  if(str=="algen an")
  {
    tell_object(TP, BS("Du kannst nicht einfach die Algen an"
          "ziehen. Sie haben die Form eines Umhanges."));
    return 1;
  }
  return 0;
}

int benutze(string str)
{
  object ob;
  int ret;

  notify_fail("Was moechtest Du benutzen?\n");
  if(!str) return 0;

  if(str=="algen als umhang"||str=="algen als kleidung")
  {
    tell_object(TP,BS("Du breitest die Algen vor Dir zu einem breiten "
          "Flaeche auf."));
    ob = clone_object(ARMOUR+"umhang");
    ret = ob->move(TP);
    if(ret == ME_TOO_HEAVY)
    {
      tell_object(TP, BS("Du kannst Deinen neuen Umhang nicht "
            +"mehr tragen."));
      ob->move(environment(TP));
      SetProp(P_COMMANDS, 0);
      call_out("remove", 0);
      return 1;
    }
    tell_object(TP, BS("Du wirfst Dir Deinen neuen Umhang ueber die "
          +"Schultern."));
    TP->command_me("ziehe algenumhang an");
    SetProp(P_COMMANDS, 0);
    call_out("remove", 0);
    return 1;
  }
  return 0;
}

