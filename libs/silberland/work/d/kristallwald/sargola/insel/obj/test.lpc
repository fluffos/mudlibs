* VARS
string rindentext;
int anz_vergiss;
object sitzende[2];

* FUNCTIONS
int pfluecke(string str);
int setze(string str);
string bluemchen();
string vergissmeinnicht();
string blaues();
int schnitze (string str);

      create()
      {
        ::create();
	rindentext = "Sargola + Titania\n";
        sitzende[0]=[];
	sitzende[1]=[];
	anz_vergiss = 2;

	AddSpecialDetail("blaues", "blaues");
	AddSpecialDetail("bluemchen","bluemchen");
	AddSpecialDetail("vergissmeinnicht","vergissmeinnicht");
	
int setze(string str)
{
	notify_fail("Wohin moechtest Du Dich setzen?\n");
	if(str=="") return 0;

	if(str=="auf baenkchen")
	{
		tell_object(TP,
			"Du setzt Dich ...");
		return 1;
	}
	return 0;
}	

reset()
{
	::reset();
	anz_vergiss =2;
}

int pfluecke(string str)
{
	notify_fail("Was moechtest Du pfluecken?}\n");
	if(!str) return 0;

	switch(str)
	{
	case "vergissmeinnicht":
	{
	   if(anz_vergiss==2)
	   {
		tell_object(TP, "Du pflueckst das Vergissmeinnicht. Du koenn"
		+"test es als Zeichen Deiner Zuneigung jemandem schenken.");
		clone_object(OBJ+"vergissmein")->move(TP);
		anz_vergiss = 1;
		return 1;
	   }	
	   else
	   {
		tell_object(TP,"Da waechst doch nur ein Vergissmeinnicht. "
		+"Du beschliesst, es stehen zu lassen.");
		return  1;
	   }
	}
	case "loewenzahn":
	{
		return BS("Du findest den Loewenzahn zu unromantisch und laesst ihn stehen. "
		+"Vielleicht findest Du eine andere Blume, die Du pfluecken kannst.");
		return 1;
	}
	case "butterblume":
	{
		return BS("Du findest die Butterblume zu langweilig und laesst sie stehen. "
		+"Vielleicht findest Du eine andere Blume, die Du pfluecken kannst.");
		return 1;
	}
	case "margerite":
		return BS("Du findest die Margerite zu banal und laesst sie stehen. Vielleicht "
		+"findest Du eine andere Blume, die Du pfluecken kannst.");
		return 1;
	}
	default:
	{
		return 0;
	}
	}
}



	return 0;
}


string blaues()
{
	if(anz_vergissmein>1)
		return  BS("Zwei kleine Bluemchen. Wenn Du wuesstest. "
		+"wie sie heissen, koenntest Du vielleicht welche pfluecken. ");
	else
		return BS("Ein kleines Bluemchen. Wenn Du wuesstest, wie es "
		+"heisst, koenntest Du es vielleicht pfluecken.");
}

string bluemchen()
{
	if(anz_vergissmein>1)
		return BS("Wenn Du weisst, wie die Bluemchen heissen, "
		+"kannst Du sie pfluecken. "));
	else
		return BS("Wenn Du weisst, wie das Bluemchen heisst, "
		+"kannst Du es pfluecken. "));
}


string vergissmein()
{
	if(anz_vergissmein>1)
		return BS("Unter einer Wurzel der Weide wachsen zwei zierliche, "
		+"blaue Vergissmeinnicht. "));
	else
		return BS("Unter einer Wurzel der Weide waechst ein zierliches "
		+"blaues Vergissmeinnicht.");
}

int schnitze(string str)
{
	object ob;
	notify_fail("Was moechtest Du schnitzen?\n");
	if(!str) return 0;

	if(!ob = present("messer",TP))
	{
		tell_object(TP, "Du hast doch gar kein Messer bei Dir.");
		return 1;
	}
	if(ob->ids()=="taschenmesser" && !ob->geoeffnet())
	{
		tell_object(TP,"Du solltest das Taschenmesser wenigstens "
		+"aufklappen.");
		return 1;
	}

	if(member(TP->QueryProp(P_WEAPON), ({"messer","taschenmesser"}))<=0)
	{
		tell_object(TP, "Ja hast Du es denn gezueckt?\n");
		return 1;
	}

	if(str=="namen in rinde"||str=="name in rinde")
	{
		tell_object(TP, "Du schnitzt .... in die Rinde.");
	}
}
      create()      
{        if (!is_clone(this_object()))           return;
	::create();

	     AddId ( "liebesbrief","brief" );
	SetProp (P_SHORT, "Liebesbrief");
	SetProp (P_LONG, BS("Du siehst\n"));


	SetProp (P_NAME, "Rose");
	SetProp (P_GENDER, FEMALE); 
	SetProp (P_WEIGHT, 15);
	SetProp (P_VALUE, 20);
	SetProp (P_MATERIAL, ({MAT_PLANT }));

	AddSmell( DEFAULT_SMELL, "Die Rose duftet herrlich.\n");
	AddDetail( "stiel", "Ein langer, dunkelgruener Stiel.\n");
	AddDetail( ({"dorn","dornen"}) ->ZT????)
	
}  
