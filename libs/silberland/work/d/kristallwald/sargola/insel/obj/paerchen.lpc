// Master von Insel
// fuers Management der Paerchen ;)
  
  
int zaehler;		

erhoehe_zaehler(int z);
frage_zaehler();

// sitzt man auf dem baenkchen?
string *baenkchen;
int f_baenkchen(object player);
int s_baenkchen(object player);








inherit "std/thing";
  
#include <properties.h>
#include <moving.h>  
#include "../def.h"
  
  
void create()  
{  
   zaehler =0;
   if (!is_clone(this_object())) return;  
   ::create();  
  
   SetProp(P_SHORT, 0);
   SetProp(P_WEIGHT, 0);
   SetProp(P_NODROP,1);
   AddId(({"\npaerchen_master"}));
}  

erhoehe_zaehler()
{
	if(getuid(previous_object())!="d.kristallwald.sargola")
	{
		write("Du bist nicht berechtigt, das zu tun...\n");
		return 0;
	}
	zaehler = z;
}

frage_zaehler()
{
	return zaehler;
}


int f_baenkchen(object player)
{
	if(member(baenkchen, player)==-1)
		return 0;
	return 1;
}

int s_baenkchen(object player)
{
	if(sizeof(baenkchen)>=2)
		return -1;
	else if(member(baenkchen, player)==-1)
	{
		baenkchen+=player;
		return 1;
	}
	return 0;
}