#include "../def.h"

inherit "std/thing";

void create()      
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"schwanenfeder","feder","\n_insel_schwanenfeder"}) );
  SetProp(P_SHORT, "Eine Schwanenfeder");
  SetProp(P_LONG, 
	  BS("Du siehst eine weisse Schwanenfeder mit langem "
	     "Kiel. Wenn Du Tinte hast, kannst Du sie zum Schreiben "
	     "benutzen."));
  
  SetProp(P_NAME, "Schwanenfeder");
  SetProp(P_GENDER, FEMALE); 
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, ({MAT_BONE}));
  
  AddDetail("kiel", 
	    "Ein langer Kiel. Wenn Du ihn in Tinte tauchst, "
	    "kannst Du mit der Feder schreiben.");
}

nosave int schreibe(string str)
{
  notify_fail("Womit moechtest Du schreiben?\n");
  if(!str) return 0;

  if(str=="mit feder"||str=="mit schwanenfeder")
    {
      if(!deep_present("\nliebes_tinte",TP))
	return write(BS("Du hast doch gar keine Tinte bei Dir.")), 1;

      if(!deep_present("\nliebes_papier",TP))
	return write(BS("Du hast doch gar kein Briefpapier bei Dir.")), 1;
      
      return write(BS("Du schreibst auf das Briefpapier:")), 1;  
    }

  return 0;
}
