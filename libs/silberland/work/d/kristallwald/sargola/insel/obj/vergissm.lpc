inherit "std/thing";
#include <properties.h>
#include <language.h>
#include "../def.h"

void create()      
{
  if (!is_clone(this_object())) return;
  ::create();
  
  AddId(({"vergissmeinnicht","bluemchen","blume"}));
  SetProp(P_SHORT, "Ein Vergissmeinnicht");
  SetProp(P_LONG, BS("Du siehst ein zierliches, blaues Vergissmein"
		     "nicht. Es ist ein ideales Geschenk, um jemandem seine "
		     "Zuneigung zu bekunden."));
  SetProp(P_NAME, "Vergissmeinnicht");
  SetProp(P_GENDER, NEUTER); 
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 10);
  SetProp(P_MATERIAL, ({MAT_PLANT}));
  
  SetProp(P_SMELL, "Das Vergissmeinnicht duftet suess.\n");
}  
