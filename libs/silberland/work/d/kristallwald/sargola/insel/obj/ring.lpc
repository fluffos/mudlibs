inherit "std/thing";
#include <properties.h>
#include <language.h>
#include "../def.h"

string owner;
void set_owner();
string query_owner();
int trenne(string str);



      create()      
{        if (!is_clone(this_object()))           return;
	::create();
	owner = "";

	AddId ( ({"ringe","paar ringe","paar","\n_liebes_ringe"}) );
	SetProp (P_SHORT, "Ein Paar Ringe");
	SetProp (P_LONG, BS("Du siehst ein paar golden glaenzendes Paar "
		+"Ringe. Sie sind magisch miteinander verschlungen. Auf "
		+"beiden kannst Du eine Gravur entdecken.\n"));

	SetProp (P_NAME, "Paar Ringe");
	SetProp (P_GENDER, NEUTER); 
	SetProp (P_WEIGHT, 55);
	SetProp (P_VALUE, 5000);
	SetProp (P_MATERIAL, ({MAT_GOLD }));
	SetProp (P_NODROP,1);
	SetProp (P_NOSELL,1);
	AddDetail( "gravur", "Du kannst sie lesen.\n");
	AddReadDetail( ({"gravur"}) ,"Es ist "+owner+" eingeritzt.\n");
	

	AddCmd( ({"trenn","trenne","zerreiss","zerreisse"}),"trenne");
}  

void set_owner()
{
	if(previous_object()=="sargola")
		owner = TP->query_real_name();
}
string query_owner()
{
	if(previous_object()!="sargola") return;
	return owner;
}


int trenne(string str)
{
	tell_object(TP, "Du versuchst vergeblich, die zwei Ringe auseinander "
	+"zu bringen. Die Magie ist staerker.\n");
	return 1;
}