/*Idee: wer den Apfel isst, verliebt sich fuer 5 Min in das naechste
Lebewesen, dass ihm begegnet (Player, NPC, Tier); -> er knuddelt, kuesst,
streichelt, umarmt, kuschelt... das Lebewesen; eventuell ein Ausruf oder eine
Meldung auf allgemein "Ich bin ja so verliebt in den Schroeter" oder "Ich
finde Xeliondo sexy" oder "Die Biene ist ja so suess."*/


inherit "std/food";
#include <properties.h>
#include <language.h>
#include <food.h>
#include "../def.h"

cclone(object p);
object ver;

      create()      
{        if (!is_clone(this_object()))           return;
	::create();

	     AddId ( ({"liebesapfel","apfel"}) );
	SetProp (P_SHORT, "Ein Liebesapfel");
	SetProp (P_LONG, BS("Du siehst einen knackigen, roter Liebesapfel "
		+"mit glaenzender Schale. Am liebsten moechtest Du sofort "
		+"kraftvoll zubeissen.\n"));
	SetProp (P_NAME, "Liebesapfel");
	SetProp (P_GENDER, MALE); 
	SetProp (P_WEIGHT, 250);
	SetProp (P_VALUE, 30);
	SetProp (P_MATERIAL, ({MAT_FOOD }));
	SetProp (P_FOOD_INFO, ([F_HEAL:({10,10}), F_SOAK:4]) );

	SetProp( DEFAULT_SMELL, "Der Apfel riecht lecker, Du moechtest am "
		+"liebsten sofort hineinbeissen.\n");

	
}  

void BeimEssen()
{
	if(!present("\nverliebt",TP))
	{
	   printf("asdfa");
	   ver = clone_object(OBJ+"verliebt");
	   ver->move(TP);
	   ver->tun();	
	}
	tell_object(TP, "Du isst den Apfel und verspuerst ein merkwuerdiges Gefuehl.\n");
}

cclone(object p)
{
	printf("fasldfj");
	ver = clone_object(OBJ+"verliebt");
	   ver->move(p);
	   ver->tun();
}