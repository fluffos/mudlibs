inherit "/std/thing";
inherit "/mail/nedit";
inherit "/std/more";
#include <properties.h>
#include <language.h>
#include "../def.h"

string * nachricht;
int voll;

string owner;
string frage_owner();
setz_owner(string str);

int beschrieben();

create()      
{        if (!is_clone(this_object()))           return;
	::create();
	owner = "";
	nachricht = "";
	voll = 0;
		
	AddId ( ({"\n_insel_papier","briefpapier","papier","brief","liebesbrief"}) );
	SetProp (P_SHORT, "Briefpapier");


	SetProp (P_NAME, "Briefpapier");
	SetProp (P_GENDER, NEUTER); 
	SetProp (P_WEIGHT, 5);
	SetProp (P_VALUE, 3);
	SetProp (P_MATERIAL, ({MAT_PAPER}));

	SetProp( P_INFO, BS("Los, nutze die Chance und schreib Deinem Schwarm "
		+"was Liebes!"));

	AddDetail( "bogen", "Ein weisser Bogen Briefpapier.\n");
	
	AddCmd( ({"schreib","schreibe"}),"schreib");
	AddCmd( ({"lies"}),"lies");
	AddCmd( ({"zerknuell","zerknuelle"}), "zerknuelle");
}  

_query_long()
{
   if(voll)
   	return BS("Du siehst ein beschriebenes Blatt Papier. Vielleicht ist es "
   		+"ein Liebesbrief fuer Dich? Lies ihn doch mal! Mit \"zerknuelle\" "
   		+"kannst Du ihn wegwerfen.");
   return BS("Du siehst ein leeres Blatt Papier, das sich hervorragend dazu eignet, "
   	+"jemandem einen Liebesbrief zu schreiben.");
}  


int zerknuelle(string str)
{
  notify_fail("Was moechest Du zerknuellen?\n");
  if(!str && str!="brief" && str!="liebesbrief" && str!="papier" && str!="briefpapier")
  	return 0;
  	
  tell_object(TP, BS("Du nimmst das Papier und zerknuellst es."));
  TO->remove();
  return 1;
}



lies(string str)
{
	notify_fail("Was moechtest Du lesen?\n");
	if(str=="brief" || str=="liebesbrief")
	{	
		tell_object(TP, nachricht);
		return 1;
	}
	return 0;
}


int beschrieben()
{
	return voll;
}

int schreib(string str)
{
	notify_fail("Was moechtest Du schreiben?\n");
	if(!str && str!="brief") return 0;

	if(!present("\n_insel_schwanenfeder",TP) || (!present("tinte",TP)) )
	{
	   tell_object(TP, BS("Du brauchst eine Feder, die Du als "
	   	+"Kiel verwenden kannst und Tinte um einen Brief zu schreiben."));
	   return 1;
	}
	if(voll)
	{
		tell_object(TP, BS("Der Bogen ist ja schon beschrieben ... *seufz*"));
		return 1;
	}

	tell_object(TP, "Nimm Dir Zeit und waehle Deine Worte wohl:\n(~h Hilfsseite, ~q Abbruch, . wenn fertig)\n");
		
	nedit("write_text","\n\n"+TPN+" verfasste am "+dtime(time()) +" folgenden Brief fuer Dich: \n\n");
	
	return 1;
}

write_text(str)
{	
	if(!str) {
		write("Abbruch. War wohl doch nichts mit literarischen Erguessen? *grins*\n");	
		str +=str;
		return 1;
	}
	nachricht = str;
	tell_object(TP, BS("Zufrieden steckst Du den Kiel weg und betrachtest Dein Werk."));
	voll = 1;
	return 1;
}


string frage_owner()
{
	return owner;
}

setz_owner(string str)
{
	if(owner == 0)
	{
		if(getuid(previous_object())!= getuid() )
			return owner = 0;
		return owner = str;
	}
}