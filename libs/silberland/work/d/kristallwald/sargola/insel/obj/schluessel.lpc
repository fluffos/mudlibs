#include "../def.h"

inherit "std/thing";

void create()      
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"schluessel","\n_insel_schluessel"}));

  SetProp(P_SHORT, "Ein verzierter Schluessel");
  SetProp(P_LONG, 
	  "Ein kleiner, mit vielen Ornamenten verzierter Schluessel.");
  SetProp(P_NAME, "Schluessel");
  SetProp(P_GENDER, MALE); 
  SetProp(P_WEIGHT, 45);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);

  SetProp(P_MATERIAL, ({MAT_IRON}));

  AddDetail(({"verschnoerkelungen","ornamente"}), 
	    "Einfache, aber nett aussehende Verschnoerkelungen.");
}
