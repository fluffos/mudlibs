*/
  
nosave int zaehler, federort; //Zaehlt die wichtigen Punkte der Quest mit :)

/*
************************************************************
** Folgende Stationen und die Zaehler-Werte
** 1: 	frag nympe nach liebe/liebhaber
** 2:	man bringt nymphe die rose
** 3:	der schuechtling schreibt den brief
** 4:   nymphe liest den brief
** 5:   fertich :)
**
*/

#include "../def.h"

inherit "std/thing";
  
void create()  
{  
   if(!is_clone(ME)) return;  
   ::create();  

   zaehler = 0;
   federort = 1;
     
   SetProp(P_SHORT, 0);
   SetProp(P_WEIGHT, 0);
   SetProp(P_NODROP,1);
   AddId(({"\n_insel_quest"}));
}  

void erhoehe_zaehler(int z)
{
  if(!IS_ARCH(TP) && getuid(PO)!= getuid() && 
     getuid(TP)!="protheg")
    {
      write(BS("Du bist nicht berechtigt, das zu tun..."));
      WLOG("/d/kristallwald/sargola/log/cheat_insel", 
	   "versuchte, den Zaehler zu setzen!");
      return 0;
    }
  
  if(zaehler < z)	
    zaehler = z;
}

int frage_zaehler()
{
  return zaehler;
}

int setze_feder_ort(int a)
{
   return federort = a;
}

int frage_feder_ort()
{
   return federort;
}
