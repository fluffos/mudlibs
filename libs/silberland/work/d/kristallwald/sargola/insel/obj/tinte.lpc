#include "../def.h"

inherit "std/thing";

nosave int tinte;

void create()      
{
  if(!is_clone(ME)) return;
  ::create();
  
  tinte = 0;	
  
  AddId(({"\n_insel_tinte","tinte","flaeschchen","tintenflaeschchen"}));
  SetProp(P_SHORT, "Ein Flaeschchen Tinte");
  SetProp(P_LONG "Ein Flaeschchen Tinte");
  SetProp(P_NAME, "Flaeschchen Tinte");
  SetProp(P_GENDER, NEUTER);

  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 5);
  SetProp(P_NOBUY, 1);

  SetProp(P_MATERIAL, ({MAT_GLASS, MAT_INK}));
}

string _query_long()
{
  if(tinte)
    return BS("Ein kleines Flaeschchen, welches mit schwarzer Tinte "
	      "gefuellt ist.");

  return BS("Ein kleines, leeres Flaeschchen. Du entdeckst Reste einer "
	    "schwarzen Fluessigkeit.");
}

int query_tinte()
{
  return tinte;
}

int setze_tinte(int i)
{
  return tinte=i;
}
