inherit "std/thing";
#include <properties.h>
#include <language.h>
#include "../def.h"

      create()      
{        if (!is_clone(this_object()))           return;
	::create();

	     AddId ( ({"lebkuchenherz","herz"}) );
	SetProp (P_SHORT, "Lebkuchenherz");
	SetProp (P_LONG, BS("Du siehst ein knuspriges Lebkuchenherz mit rosa"
		+"farbener Zuckergussaufschrift.\n"));
	SetProp (P_NAME, "Lebkuchenherz");
	SetProp (P_GENDER, NEUTER); 
	SetProp (P_WEIGHT, 200);
	SetProp (P_VALUE, 20);
	SetProp (P_MATERIAL, ({MAT_FOOD }));
	SetProp (P_LP, 20);

	AddSmell( DEFAULT_SMELL, "Du schnupperst an dem Lebkuchenherz und"
		+"ueberlegst Dir, ob Du hineinbeissen oder es doch lieber"
		+"jemandem schenken sollst, der Dir am Herzen liegt.\n");
	AddDetail( ({"zuckergussaufschrift","aufschrift","zuckerguss"}),
		+"Du kannst die Zuckergussaufschrift lesen\n");
	AddReadDetail( ({"zuckergussaufschrift","aufschrift","zuckerguss"}),({
		"Du liest: Auf Ewig Dein"
		"Du liest: I Love You"
		"Du liest: Dein Ist Mein Ganzes Herz"
		"Du liest: Du Bist Mein Liebstes"});


}  
