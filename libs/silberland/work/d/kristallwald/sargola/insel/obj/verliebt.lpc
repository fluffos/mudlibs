inherit "std/thing";
#include <properties.h>
#include <language.h>
#include "../def.h"

private string *chats= ({
 "Ach liebster Schatz, verdient mein Herz,\n"
+"So hart versucht zu werden?\n"
+"Es leidet ja wohl anderwaerts\n"
+"Vorhin genug Beschwerden;\n"
+"Und dennoch fehlt ihm niemals Lust,\n"
+"Erlaub ihm nur in Deiner Brust\n"
+"Auf kurz genossne Freuden\n"
+"Die Ehre mit zu leiden.\n",

 "Der erste Tag im Monat Mai\n"
+"ist mir der gluecklichste von allen.\n"
+"Dich sah ich und gestand Dir frei,\n"
+"den ersten Tag im Monat Mai,\n"
+"dass Dir mein Herz ergeben sei.\n"
+"Wenn mein Gestaendnis Dir gefallen,\n"
+"so ist der erste Tag im Mai\n"
+"fuer mich der gluecklichste von allen\n",

 "Wuesst' ich, wuesst' ich , dass Du mich\n"
+"Lieb und wert ein bisschen hieltest,\n"
+"Und von dem, was ich fuer Dich,\n"
+"Nur ein Hundertteilchen fuehltest;\n\n"
+"Dass Dein Dank huebsch menen Gruss'\n"
+"Halben Wegs entgegen kaeme,\n"
+"Und Dein Mund den Wechselkuss\n"
+"Gerne gaeb' und wiedernaehme.\n",

 "Sterben wollt'ich im Genusse,\n"
+"Wie ihn Deine Lippe beut,\n"
+"Sterben in dem langen Kusse\n"
+"Wollustvoller Trunkenheit. - \n\n"
+"Komm, o komm, und lass uns sterben!\n"
+"Mir entlodert schon der Geist.\n"
+"Fluch vermachet sei dem Erben,\n"
+"Der uns voneinander reisst!\n",

 "O Lieb, o Lieb!\n"
+"So golden schoen,\n"
+"Wie Morgenwolken\n"
+"Auf jenen Hoehn!\n\n"
+"Wie ich Dich liebe\n"
+"Mit warmem Blut,\n"
+"Die Du mir Jugend\n"
+"Und Freud und Mut\n\n"
+"Zu neuen Liedern\n"
+"Und Taenzen gibst.\n"
+"Sei ewig gluecklich,\n"
+"Wie Du mich liebst!\n",

 "Was alles ich waer,\n"
+"Das goennt ich Dir sehr;\n"
+"Mit fuerstlichen Gaben,\n"
+"Du solltest mich haben.\n"
+"Was alles ich waer,\n"
+"Das goennt ich Dir sehr.\n\n"
+"Doch bin ich wie ich bin,\n"
+"Und nimm mich nur hin!\n"
+"Willst Du Bessre besitzen,\n"
+"So lass sie Dir schnitzen.\n"
+"Ich bin nun wie ich bin;\n"
+"So nimm mich nur hin!\n",

 "Fuehle, was dies Herz empfindet,\n"
+"Reiche frei mir Deine Hand,\n"
+"Und das Band, das uns verbindet,\n"
+"Sei kein schwaches Rosenband\n",

 "Trocknet nicht, trockent nicht\n"
+"Traenen der ewigen Liebe!\n"
+"Ach, nur dem halbgetrockentem Auge\n"
+"Wie oede, wie tot die Welt ihm erscheint!\n"
+"Trocknet nicht, trocknet nicht,\n"
+"Traenen unglueckliche Liebe!\n",

 "Das reinste Glueck, das wir empfunden,\n"
+"Die Wollust mancher reichen Stunden\n"
+"Floh wie die Zeit mit dem Genuss.\n"
+"Was hilft es mir, dass ich geniesse?\n"
+"Wie Traeume fliehn die waermsten Kuesse,\n"
+"Und alle Freude wie ein Kuss.\n",

 "Die Leidenschaft bringt Leiden! - Wer beschwichtigt\n"
+"Beklommnes Herz, das allzuviel verloren?\n"
+"Wo sind die Stunden, ueberschnell verfluechtigt?\n"
+"Vergebens war das schoenste Dir erkoren!\n"
+"Trueb ist der Geist, verworren das Beginnen;\n"
+"Die hehre Welt, wie schwindet sie den Sinnen!\n",

 "Wenn Du Dich im Spiegel besiehst,\n"
+"Denke, dass ich diese Augen kuesste,\n"
+"Und mich mit mir selbst entzweien muesste,\n"
+"Sobalde Du mich fliehst:\n"
+"Denn da ich nur in diesen Augen lebe,\n"
+"Du mir gibst, was ich gebe,\n"
+"So waer ich ganz verloren;\n"
+"Jetzt bin ich immer wie neu geboren.\n",

 "Ich sah Dich, und die milde Freude\n"
+"Floss aus dem suessen Blick auf mich.\n"
+"Ganz war mein Herz an Deiner Seite,\n"
+"Und jeder Atemzug fuer Dich.\n"
+"Ein rosafarbes Fruehlingswetter\n"
+"Lag auf dem lieblichen Gesicht,\n"
+"Und Zaertlichkeit fuer mich, ihr Goetter!\n"
+"Ich hofft' es, ich verdient es nicht.\n",

 "Ich denke Dein, wenn mir der Sonne Schimmer\n"
+"Vom Meere strahlt;\n"
+"Ich denke Dein, wenn sich des Mondes Flimmer\n"
+"In Quellen malt.\n"
+"Ich sehe Dich, wenn auf dem fernen Wege\n"
+"Der Staub sich hebt;\n"
+"In tiefer Nacht wenn auf dem schmalen Stege\n"
+"Der Wandrer bebt\n\n"
+"Ich hoere Dich, wenn dort mit dumpfen Rauschen\n"
+"Die Welle steigt.\n"
+"Im stillen Haine geh ich oft zu lauschen,\n"
+"Wenn alles schweigt.\n\n"
+"Ich bin bei Dir, Du seist auch noch so ferne\n"
+"Du bist mir nah!\n"
+"Die Sonne sinkt, bald leuchten mir die Sterne.\n"
+"O wrst Du da!\n",

 "War unersaettlich nach viel tausend Kuessen,\n"
+"Und musst mit einem Kuss am Ende scheiden.\n"
+"Nach herber Trennung tief empfundenem Leiden\n"
+"War mir das Ufer, dem ich mich entrissen,\n\n"
+"Mit Wohnungen, mit Bergen, Huegeln, Fluessen,\n"
+"Solang ichs deutlich sah, ein Schatz der Freuden;\n"
+"Zuletzt im Blauen blieb ein Augenweiden\n"
+"An fernentwichnen lichten Finsternissen.n\n"
+"Und endlich, als das Meer den Blick umgrenzte,\n"
+"Fiel mir zurueck ins Herz mein heiss Verlangen,\n"
+"Ich suchte mein Verlornes gar verdrossen.\n\n"
+"Da war es gleich, als ob der Himmel glaenzte;\n"
+"Mir schien, als waere nichts mir, nichts entgangen,\n"
+"Als haett ich alles, was ich je genossen.\n",

 "Ein Blick von Deinen Augen in die meinen,\n"
+"Ein Kuss von Deinen Mund auf meinen Munde:\n"
+"Wer davon hat, wie ich, gewisse Kunde,\n"
+"Mag dem was andres wohl erfreulich scheinen?\n"
+"Entfernt von Dir, entfremdet von den Meinen,\n"
+"Fuehr ich stets die Gedanken in die Runde,\n"
+"Und immer treffen sie auf jene Stunde,\n"
+"Die einzige: da fang ich an zu weinen.\n\n"
+"Die Traene trocknet wieder unversehens:\n"
+"Man liebt ja, denk ich, her in diese Stille,\n"
+"Und solltest Du nicht in die Ferne reichen?\n\n"
+"Vernimm das Lispeln dieses Liebeswehens!\n"
+"Mein einzig Glueck auf Erden ist Dein Wille,\n"
+"Dein freundlicher zu mir: gib mir ein Zeichen!\n",

 "Nur wer die Sehnsucht kennt\n"
+"Weiss, was ich leide!\n"
+"Allein und abgetrennt\n"
+"Von aller Freude,\n"
+"Seh ich ans Firmament\n"
+"Nach jener Seite.\n"
+"Ach, wer mich liebt und kennt,\n"
+"Ist in der Weite!\n"
+"Es schwindelt mir, es brennt\n"
+"Mein Eingeweide.\n"
+"Nur wer die Sehnsucht kennt,\n"
+"Weiss, was ich leide!\n",

 "In der Nacht im kalten Winter\n"
+"Wirds so schwarz und graulich nicht,\n"
+"Als in meinem armen Herzen\n"
+"Fern von Deinem Angesicht\n\n"
+"Aber wenn es wieder laechelt\n"
+"In die Seele mir hinein,\n"
+"Werd ich jung und neugeboren,\n"
+"Wie das Feld im Sonnenschein.\n\n"
+"Du allein gibst Trost und Freude;\n"
+"Waerst Du nicht in dieser Welt,\n"
+"Stracks fiel alle Lust zusammen,\n"
+"Wie ein Feuerwerk zerfaellt.\n\n",

 "Selig durch die Liebe\n"
+"Goetter - durch die Liebe\n"
+"Menschen Goettern gleich!\n"
+"Liebe macht den Himmel\n"
+"Himmlischer - die Erde\n"
+"Zu dem Himmelreich.\n",

 "Maechtig durch die Liebe, winden\n"
+"Von der Fessel wir uns los,\n"
+"Und die trunknen Geister schwinden\n"
+"Zu den Sternen, frei und gross!\n"
+"Unter Schwur und Kuss vergessen\n"
+"Wir die traege Flut der Zeit,\n"
+"Und die Seele naht vermessen\n"
+"Deiner Lust, Unendlichkeit!\n",

 "Ich sehe Dich in tausend Bildern,\n"
+"Ach wie lieblich ausgedrueckt,\n"
+"Doch keins von allen kann Dir schildern,\n"
+"Wie meine Seele Dich erblickt.\n\n"
+"Ich weiss nur, dass der Welt Getuemmel\n"
+"Seitdem mir wie ein Traum verweht,\n"
+"Und ein unnennbar suesser Himmel\n"
+"Mir ewig im Gemuete steht.\n",

 "Ach wie ists moeglich dann,\n"
+"Dass ich Dich lassen kann,\n"
+"HAb Dich von Herzen lieb,\n"
+"Das glaube mir!\n"
+"Du hast das Herze mein\n"
+"So sehr genommen ein,\n"
+"Dass ich kein' Andern lieb,\n"
+"Liebe so sehr.\n",

 "Ich wollte, wie gerne, Dich herzen,\n"
+"Dich wiegen in meinen Arm,\n"
+"Dich druecken an meinen Herzen,\n"
+"Dich hegen so traut und warm.\n",

"Wir wollten mit Kosen und Lieben\n"
+"Geniessen der koestlichen Nacht.\n"
+"Wo sind doch die Stunden geblieben?\n"
+"Es ist ja der Hahn schon erwacht.\n\n"
+"Ich wollt, es gaeb keine Sonne,\n"
+"Als eben Dein Auge klar,\n"
+"Wir weilten in Tag und in Wonne,\n"
+"Und schliefe die Welt immerdar.\n",

"Koennt ich Dich in Liedern preisen,\n"
+"Saeng ich Dir das laengste Lied.\n"
+"Ja, ich wuerd in allen Weisen\n"
+"Dich zu singen nimmer mued!\n\n",

 "Verloer' ich ganz der Augen Licht\n"
+"Wuerd' dennoch nicht mich Nacht umgeben\n"
+"Solange Du, mein lichtes Leben,\n"
+"Du, meine Sonne! scheidest nicht.\n"});


create()
{
	if(!is_clone(this_object())) return ;
		::create();
	SetProp(P_WEIGHT, 0);
	SetProp(P_SHORT, 0);
	SetProp(P_NODROP, 1);
	AddId( "\n_verliebt_sein");

	if(find_call_out("verliebt")==-1)
		call_out("verliebt", 5);


}

/********************************
* 0: singen
* 1: sagen
* 2: rufen (stressig)
* 3: groelen
* 4: fluester
* 5: auf [Kultur] :)
*/
verliebt()
{
	int a;
	string str;
	a = random(6);
	str = chats[random(sizeof(chats))];
	environment(TO)->command_me("singe a\nasdfdas\nasldfkjas");
	environment(TO)->command_me( "singe"+str);
	call_out("verliebt",5);
}