#include "../def.h"

inherit "std/thing";

void create()      
{    
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"flechte","\n_insel_flechte"}));

  SetProp(P_SHORT, "Flechte");
  SetProp(P_LONG, 
	  BS("Eine 20 Zentimeter lange, braun-graue Flechte. Man koennte sie "
	     "leicht zu einem duennen Faden oder aehnlichem drehen."));
  SetProp(P_NAME, "Flechte");
  SetProp(P_GENDER, FEMALE); 
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 20);
  SetProp(P_MATERIAL, ({MAT_PLANT }));
  SetProp(P_NOBUY, 1);
  SetProp(P_SMELL, 
	  BS("Die Flechte duftet nach nichts Aussergewoehnlichem."));
}  
