inherit "std/food";
#include <properties.h>
#include <food.h>
#include <language.h>
#include "../def.h"

      create()      
{        if (!is_clone(this_object()))           return;
	::create();

	     AddId ( ({"johannisbrot","brot"}) );
	SetProp (P_SHORT, "Johannisbrot");
	SetProp (P_LONG, BS("Du siehst eine Scheibe Johannisbrot vom "
		+"Johannisbrotbaum. Geniessbar, aber nicht sehr wohl "
		+"schmeckend\n"));
	SetProp (P_NAME, "Johannisbrot");
	SetProp (P_GENDER, NEUTER); 
	SetProp (P_WEIGHT, 100);
	SetProp (P_VALUE, 20);
	SetProp (P_MATERIAL, ({MAT_FOOD }));
	SetProp (P_FOOD_INFO, ([F_HEAL:({3,3}), F_SOAK:1]) );

	AddDetail("scheibe", BS("Du stellst erstaunt fest, dass es sich tat"
		+"saechlich um eine Scheibe handelt... dabei dachtest Du "
		+"immer, Johannisbrot waere eigentlich eine Huelsenfrucht.\n"));
	SetProp( DEFAULT_SMELL, "Das Johannisbrot riecht nicht sehr "
		+"appetitlich - Dir wuerde es wohl nicht so gut schmecken.\n");
	
}  

void BeimEssen()
{
	tell_object(TP, "Du verspeist genuesselich eine Scheibe Johannisbrot.\n");
	tell_room(environment(TP), TPN+" verspeist eine Scheibe Johannisbrot.\n", ({TP}) );
}