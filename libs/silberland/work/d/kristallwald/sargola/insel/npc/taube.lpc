#include "../def.h"   
   
inherit "std/npc";   
 
void create()   
{   
  if(!is_clone(TO)) return;   
  ::create();    
  
  AddId(({"taeubchen","turteltaube","turteltaeubchen","taube"}));
  SetProp(P_SHORT, "Eine Turteltaube");   
  SetProp(P_LONG, 
	  BS("Eine erhabene, stolz dreinblickende Turteltaube. Sie ist am " 
	     "ganzen Koerper weiss und besitzt kleine, schwarze Augen, die "
	     "Dich erwartungsvoll anblicken.")); 

  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 15);
  SetProp(P_WEIGHT, 200);

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  
  AddDetail("koerper", 
	    "Er ist mit weissen, kraeftigen Federn bedeckt."); 
  
  AddDetail("augen", 
	    "Ihre Augen stechen durch das Schwarz hervor und blicken " 
	    "Dich aufgeweckt und interessiert an. Erst jetzt bemerkst Du "
	    "etwas seltsames an ihrem Hals haengen."); 
  
  AddDetail("hals", 
	    "Es ist ein kleines Halsband mit einem Zettel daran haengend."); 
 
  AddDetail("halsband", 
	    "Es ist aus feinem, rotem Samt."); 

  AddDetail("samt", 
	    "Feiner roter Samt eben."); 

  AddDetail("zettel",
	    "Versuch ihn doch einmal zu lesen."); 
 
  AddReadDetail("zettel", 
		"Ich kann Dir helfen, Dinge von Personen " 
		"zu holen. Du musst mir nur mit <hole was von wem> " 
		"auftragen, was ich von wem holen soll."); 
  
  SetProp(P_GENDER, FEMALE);   
  SetProp(P_NAME, "Turteltaube");   
  
  SetProp(P_NOATTACK,"ist Dir doch so friedlich gesinnt!\n"); 
 
  AddCmd(({"bring","bringe","hole","hol"}), "bring"); 
} 
 
nosave int bring(string str) 
{ 
  object ob; 

  notify_fail(BS("Was moechtest der Taube auftragen?"));
  if(!str) return 0; 
  
  if(str!="tinte von aerendil") return 0; 
	 
  if((ob = present("\n_insel_tinte", MENV)) ||
     (ob = present("\n_insel_tinte", TP)))
    { 
      write(BS("Die Taube nimmt mit ihren Krallen das Glaeschen " 
	       "Tinte, fliegt los und kehrt nach kurzer Zeit mit dem "
	       "gefuellten Glaeschen Tinte zurueck."));

      ob->setze_tinte(1); 

      call_out("hau_ab",0);

      return 1; 
    } 
  else 
    return write(BS("Die Taube kann nirgends etwas erkennen, mit " 
		    "dem sie die Tinte holen soll.")), 1;

  return 0;
}	 

void give_notify(object ob)
{
  if(ob->id("\n_insel_tinte")!=0)
    {
      write(BS("Die Taube nimmt mit ihren Krallen das Glaeschen " 
	       "Tinte, fliegt los und kehrt nach kurzer Zeit mit dem "
	       "gefuellten Glaeschen Tinte zurueck."));

      ob->setze_tinte(1);

      give_obj(ob, TP);

      call_out("hau_ab",0);

      return; 
    }

  write(BS("Du Taube kann das nicht gebrauchen und gibt es Dir wieder."));

  give_obj(ob, TP);
}

void hau_ab()
{
  if(MENV)
    tell_room(MENV,
	      BS("Die Taube fliegt wieder davon..."));
  remove(1);
}
