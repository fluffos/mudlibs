// changes by Muaddib, 980807

#include "../def.h"  
  
inherit "std/npc";  

string blumen();
string brief();

void create()  
{  
  if(!is_clone(TO)) return;  
  ::create();   

  set_living_name("hoehlenschuechtling");

  AddId(({"hs","hoehlenschuechtling","schuechtling"}));

  SetProp(P_SHORT, "Ein Hoehlenschuechtling");  
  SetProp(P_LONG, BS("Ein schuechterner Hoehlenbewohner.")); 

  SetProp(P_GENDER, MALE);  
  SetProp(P_NAME, "Hoehlenschuechtling");  
  SetProp(P_NOATTACK, "Lass den armen Schuechtling doch lieber in Ruhe.");
  SetProp(P_MSGIN, "kommt schuechtern um sich blickend herein");
  SetProp(P_MSGOUT, "wird derart von Dir eingeschuechtert, dass er in "
	  "hintere Bereiche der Hoehle flieht");

  AddInfo("brief", CLOSURE(brief)); 
	
  SetChats(0, ({ 
    "Der Hoehlenschuechtling schaut liebevoll nach unten.\n",
      "Der Hoehlenschuechtling wuerde so gern nach unten.\n",
      "Der Hoehlenschuechtling traut sich nicht, nach unten zu klettern.\n",
      "Der Hoehlenschuechtling seufzt: Ach traute ich mich doch nach "
      "unten...\n"}));
  
  AddInfo(({"nymphe","isabella"}), 
	  "Ich beobachte sie seit Jahr und Tag. Ich bin heillos verliebt... "
	  "nur traue ich mich nicht, ihr meine grenzenlose Liebe zu "
	  "gestehen. Vielleicht koennte ich ihr eine Rose schenken.", 
	  "seufzt: ");

  AddInfo(({"rosen","rose","blumen"}), CLOSURE(blumen));

  AddInfo("liebe", 
	  "Ich bin heillos in Isabella verliebt.",
	  "sagt: ");

  AddInfo(DEFAULT_INFO,({
    "blickt Dich schuechtern an.\n",
      "wundert sich ueber Dich!\n",
      "murmelt was von \"ich weiss nicht...\".\n",
      "seufzt nur tief.\n",
      "schuettelt den Kopf.\n"}));
  
  AddInfo(({"sargola","magier" }), 
	  "Sargola kann mir bei ihr auch nicht weiterhelfen.", 
	  "seufzt: ");

  AddInfo(({"see","rhondonit"}), 
	  "Die Insel hier liegt im See von Rhondonit.",
	  "sagt: ");

  AddInfo("name", 
	  "seufzt: Ist der denn wichtig?");

  AddInfo("insel", 
	  "Die Insel ist ein geheimes Liebesversteck. "
	  "Viele verliebte Paerchen kommen hierher.",
	  "seufzt: ");

  AddInfo(({"liebesversteck","versteck"}), 
	  "Die Insel dient vielen Paerchen als geheimes Liebesversteck, weil "
	  "es hier Orte gibt, die man nicht so leicht entdeckt ... und dort "
	  "kann man Dinge tun, die man sonst nirgens tun kann.",
	  "seufzt: ");

  AddInfo("glitzern", 
	  "Man kann von hier oben manchmal ein Glitzern "
	  "sehen, aber das interssiert mich kaum.",
	  "sagt: ");

  AddInfo(({"wasser","element"}), 
	  "Ich liebe Wasser, es ist herrlich, "
	  "hier unter dem Wasserfall zuleben.",
	  "sagt: ");

  AddInfo(({"kristallwald","wald","norden"}), 
	  "Weiter im Norden liegt der Kristallwald.",
	  "sagt: ");

  AddInfo("heimat", 
	  "Der See, die Lagune, der Wasserfall... das alles ist meine Heimat.",
	  "sagt: ");

  AddInfo(({"ringe","ring"}),
	  "Moeglichweise glitzern ja Ringe...",
	  "gruebelt: ");

  AddInfo(({"orte","ort"}), 
	  "Es gibt viele Orte hier auf der Insel, die von den verliebten "
	  "Paerchen als Liebesnester genutzt werden.",
	  "sagt: ");

  AddInfo(({"paerchen","paar"}), 
	  "Es kommen viele Paerchen auf die Insel ... keiner von denen "
	  "ist allein",
	  "seufzt: ");

  AddInfo("schwan",
	  "Der Schwan bringt viele Leute auf die Insel."
	  "Ich seh ihn hin und wieder, wenn er wiedermal Leute "
	  "hergebracht hat.",
	  "sagt: ");

  AddInfo("silberland", 
	  "Solch schwierige Fragen darfst Du mir nicht stellen!",
	  "gruebelt: ");

  AddInfo(({"tauben","taube","taeubchen","turteltaeubchen"}), 
	  "Auf dem Johannisbrotbaum sitzen zwei verliebte Turteltaeub"
	  "chen... sie koennen Botschaften vermitteln.",
	  "sagt: ");

  AddInfo(({"brot","johannisbrot"}), 
	  "Der Schwan liebt das Johannisbrot. Mir schmeckt es nicht so sehr.",
	  "sagt: ");

  AddInfo("feder", 
	  "Der Schwan hat lange, weisse Federn. Vielleicht "
	  "verliert er ja welche.",
	  "sagt: ");
 
  AddInfo("weide", 
	  "Die Weide ist schon sehr alt. Ich hab sie immernur "
	  "von hier oben gesehen.",
	  "seufzt: ");

  AddInfo("baumhaus", 
	  "Das kenn ich nicht.",
	  "sagt: ");

  AddInfo("blumen", 
	  "Es gibt viele Blumen auf der Insel. Ich finde Rosen am schoensten.",
	  "sagt: ");
  
  AddInfo("grotte", 
	  "Das muss wohl hier sein.",
	  "gruebelt: ");

  AddInfo("wasserfall", 
	  "Er schuetzt mich vor den Blicken von... Ach... ",
	  "seufzt: ");

  AddInfo(({"nest","liebesnest"}), 
	  "Es gibt viele geheime Liebesnester hier auf der Insel...",
	  "fluestert: ");

  AddInfo("klippe", 
	  "Manchmal, wenn ich mutig bin, gehe ich an die Klippe und "
	  "beobachte sie ... so wunderschoen ... ",
	  "schwaermt: ");

  AddInfo("woody", 
	  "Der braeuchte nur xcall nymphe->ist_verliebt_in"
	  "(\"schuechtling\") machen... aber er hat ja immer besseres "
	  "zu tun...",
	  "seufzt: ");

  AddInfo("dusty", 
	  "Sprichst du von Staub?",
	  "erbleicht: ");

  AddInfo("lagune",
	  "Man kann die Lagune von hier oben gut sehen. Aber "
	  "trotz der Naturschoenheiten kann ich nur auf Isabella schauen ... ",
	  "sagt: ");

  AddInfo("sand", 
	  "sagt: Den gibts hier oben gottseidank nicht.");

  AddInfo("fische", 
	  "sagt: Ich sehe ziemlich viele herumschwimmen.");

  AddInfo("grund", 
	  "Vom Grund kommt das raetselhafte Glitzern.",
	  "erzaehlt: ");

  AddInfo(({"aepfel","liebesaepfel"}), 
	  "Von solchen Dingen hab ich armer Tropf doch keine Ahnung.",
	  "seufzt: ");

  AddInfo("quest", 
	  "gruebelt: Was meinst Du denn genau?");

  AddInfo("utensilien", 
	  "Naja, was man so braucht um einen Brief zu "
	  "schreiben: Papier, Tinte und einen Federkiel.",
	  "sagt: ");

  AddInfo("tinte", 
	  "Das einzige, was mir einfaellt, waere die Bibliothek in Elessar. "
	  "Dort wird Tinte sicher verwendet.",
	  "sagt: ");
		
  AddInfo(({"dorf","elessar"}), 
	  "Elessar ist das Walddorf der Elfen.",
	  "sagt: ");

  AddInfo("aerendil", 
	  "sagt: Er ist in der Bibliothek zu finden.");

  AddInfo("bibliothek",
	  "sagt: Wo die genau ist, darfst Du mich nicht fragen.\n");

  AddInfo("papier", 
	  "sagt: Es gibt welches hier auf der Insel ...\n");

  AddInfo(({"federkiel","kiel"}),
	   "seufzt: Ich hab leider keinen blassen Schimmer.\n");

  AddInfo("schimmer", 
	  "gruebelt heftig: Wovon redet er jetzt?\n");

  AddInfo("kerze", 
	  "Naja, eine einfache Honigwabe um eine Art Docht gerollt "
	  "wuerde mir ja schon reichen.",
	  "sagt: ");

  AddInfo(({"honig","wabe","honigwabe"}),
	  "Es gibt eine Bienenwabe auf der Insel. Frag mich nur nicht genau "
	  "wo.",
	  "sagt: ");

  AddInfo("docht",
	  "Lass Deine Phantasie ein bisschen spielen.",
	  "grinst: ");

  AddInfo("phantasie",
	  "Die kann man nicht erklaeren.",
	  "grinst: ");
}

int _query_wimpy() { return 0; }

void give_notify(object ob)
{
  object o, que;
  object tinte, feder, papier;
  int i;

  //man spielt die Quest nicht
  if(!objectp(que=present("\n_insel_quest", TP)))
    return write(BS("Der Hoehlenschuechtling schaut Dich fragend an."));

  // 1. Teil der Quest -> Man besorgt die Rose
  if(ob->id("rose")==1)
    {
      write(break_string("Danke! Aber ich traue mich ja nicht, sie\n"
			 "ihr zu geben... Koenntest nicht eventuell ...\n"
			 "unter Umstaenden ... Du das fuer mich erledigen?",
			 78, "Der Hoehlenschuechtling sagt: ", 1)+
	    "Schnell steckt er Dir die Rose wieder zu.\n"
	    "Der Hoehlenschuechtling sieht Dich flehend an.\n");
      
      give_obj(ob, TP);
      
      return ;
    }

  feder = (ob->id("\n_insel_schwanenfeder") ? ob : 
	   deep_present("\n_insel_schwanenfeder",TP));
  tinte = (ob->id("\n_insel_tinte") ? ob : 
	   deep_present("\n_insel_tinte",TP));
  papier = (ob->id("\n_insel_papier") ? ob : 
	    deep_present("\n_insel_papier",TP));
  
  // 3. Teil - man bringt die Kerze
  if(ob->id("\n_insel_kerze")==1)
    {
      if(!objectp(que) || que->frage_zaehler()<2)
	{
	  write(BS("Der Hoehlenschuechtling bedankt sich schuechtern."));
	  if(objectp(ob)) ob->remove();
	  return ;
	}

      if(objectp(tinte) && tinte->query_tinte()!=1)
	{
	  if(objectp(ob)) drop_obj(ob);

	  return write(BS("Der Hoehlenschuechtling sagt: Das Faesschen Tinte "
			"ist leider leer."));
	}

      if(!objectp(papier) || !objectp(tinte) || !objectp(feder)) 
	{
	  if(objectp(ob)) drop_obj(ob);

	  return write(BS("Der Hoehlenschuechtling freut sich zwar ueber die "
			  "nette Kerze, ihm fehlen aber trotzdem noch die "
			  "restlichen Utensilien fuer den Brief."));
	}

      write("Du gibst dem Hoehlenschuechtling die Tinte, das Papier und "
	    "die Feder.\n"
	    "Dann zuendest Du die Kerze mit einem kleinen Feuerball an "
	    "und stellst sie neben\n"
	    "den Hoehlenschuechtling.\n\n"
	    "Der Hoehlenschuechtling bedankt sich schuechtern und kritzelt "
	    "nach ziemlich\n"
	    "langem Gruebeln etwas aufs Papier.\n"
	    "Der Hoehlenschuechtling gibt Dir den Brief.\n");
      
      ob->remove(); //kerze weg     

      if(objectp(papier)) papier->remove();
      if(objectp(feder)) feder->remove();
      if(objectp(tinte)) tinte->remove();

      o = clone_object(OBJ "qbrief");

      o->setz_owner(getuid(TP));

      if(o->move(TP, M_GET)==ME_TOO_HEAVY)
	{
	  tell_object(TP, BS("Der Hoehlenschuechtling legt den Brief "
			     "vor Dir auf den Boden."));
	  o->move(environment(TP));
	}
      o = present("\n_insel_quest",TP);

      if(objectp(o)) o->erhoehe_zaehler(3);

      return ;
    }

  // 2. Teil der Quest -> Papier, Tinte, Feder besorgen
  if((ob->id("\n_insel_tinte")) ||(ob->id("\n_insel_papier")) ||
     (ob->id("\n_insel_schwanenfeder")))
    {
      if(!objectp(que) || que->frage_zaehler() < 2)
	{
	  tell_object(TP, BS("Der Hoehlenschuechtling will das nicht."));
	  if(objectp(ob)) ob->move(TP);
	  return ;
	}

      if(objectp(papier) && objectp(feder) && objectp(tinte))
	{
	  if(papier->beschrieben()==1)
	    return write(BS("Der Hoehlenschuechtling sagt: "
			    "Das Papier ist ja schon beschrieben..."));

	  if(tinte->query_tinte()!=1)
	    {
	      tell_object(TP,
			  "Der Hoehlenschuechtling sagt: "
			  "Das Faesschen Tinte ist leider leer.\n");
	      give_obj(ob, TP);
	      return ;
	    }	   

	  tell_object(TP,
		      "Der Hoehlenschuechtling freut sich alle Dinge beisammen zu haben.\n"
		      "Gerade, als er beginnen will den Brief zu schreiben, merkt er, "
		      "dass es hier\n"  
		      "viel zu dunkel ist, um etwas zu erkennen zu koennen.\n"
		      "Der Hoehlenschuechtling fragt: "
		      "Koenntest Du mir vielleicht eine Kerze besorgen?\n"
		      "Der Hoehlenschuechtling fluestert verlegen: "
		      "Vielleicht kommt ich dann auch in \n"
		      "Der Hoehlenschuechtling fluestert verlegen: "
		      "eine romantische Stimmung ...\n");
	  ob->move(TP);
	  return ;
	}  
      else
	{
	  tell_object(TP, "Der Hoehlenschuechtling wartet noch, "
		      "bis Du alles beisammen hast.\n");
	  ob->move(TP);
	  return ;
	}  
    }
  tell_object(TP, BS("Der Hoehlenschuechtling kann das nicht brauchen."));
  ob->move(TP);
  return ;
}

blumen()
{
  object ob;
  ob = present("\n_insel_quest",TP);
  if(objectp(ob))
    {
      return  
	"sagt: Rosen sind wunderhuebsche Blumen fuer eine\n"
	"Der Hoehlenschuechtling sagt: Person, Die Du sehr gerne magst.\n"
	"Der Hoehlenschuechtling seufzt: Ich traue mich aber aus meiner Grotte nicht \n"
	"Der Hoehlenschuechtling sagt: heraus, um Isabella eine zu pfluecken.\n";
    }
  else
    {
      return 
	"sagt: Rosen sind wunderhuebsche Blumen fuer eine\n"
	"Der Hoehlenschuechtling sagt: Person, die Du sehr gerne magst.\n";
    }
}



brief()
{
  object ob;
  ob = present("\n_insel_quest",TP);

  switch(ob->frage_zaehler())
    {
    case 0:
    case 1:
      {
	return "fragt: Was meinst Du denn?\n";
      }
    case 2:
      {
	return 
	  "jubelt: Oh Gott! Sie will einen Brief von mir?\n"
	  "Der Hoehlenschuechtling jubelt und tanzt wild umher!\n"
	  "Abrupt haelt er ein und starrt Dich entsetzt an.\n\n"
	  "Der Hoehlenschuechtling fragt: Den Brief soll ich schreiben? Ich kann doch\n"
	  "Der Hoehlenschuechtling fragt: keine Briefe schreiben.\n"
	  "Der Hoehlenschuechtling wird kreidebleich im Gesicht.\n\n"
	  "Der Hoehlenschuechtling snieft: Abgesehen davon fehlen mir die noetigen\n"
	  "Der Hoehlenschuechtling snieft: Utensilien.\n";
      }
    case 3:
      {
	return "sagt: Du hast den Brief schon von mir bekommen.\n";
      }
    }
}
