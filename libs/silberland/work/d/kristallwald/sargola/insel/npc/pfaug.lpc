/*
** Ein Tagpfauenauge
**
**  2002-05-10  PROtheG  Neuueberarbeitung
*/

#include "../def.h"

inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moving.h>

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Ein Tagpfauenauge");
  SetProp(P_LONG, 
	  BS("Ein beeindruckendes Exemplar eines Tagpfauenauges. Auf "
	     "seinen breiten Fluegeln kannst Du zwei Augen sehen."));

  SetProp(P_NAME, "Tagpfauenauge");
  SetProp(P_GENDER, NEUTER);
  AddId(({"pfauenauge","tagpfauenauge","schmetterling"}));

  create_default_npc(2);
  SetProp(P_HANDS,({" mit feinen Fuehlern", 30, DT_AIR }));

  SetProp(P_RACE, "Schmetterling");
  SetProp(P_ALIGN, 340);

  SetProp(P_SIZE, 10); 
  SetProp(P_WEIGHT, 5);

  SetProp(P_HEAL, 2);

  SetProp(P_WIMPY, 5);

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");

  SetProp( P_REJECT, ({REJECT_DROP,
			 "Wie soll das denn der Schmetterling tragen?!\n"}));
  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  AddDetail("fluegel",
	    "Sie sind breit und auf ihnen prangen zwei dunkle Augen.");

  AddDetail("augen", 
	    "Tja, das duerfte der Grund fuer den Namen des Schmetterlings "
	    "sein. Die zwei Augen starren Dich doch nicht an ... oder?");
}

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if(find_call_out("reaction") != -1) return;
  
  if(touch)
    call_out("reaction", 0, TP,
	     "Als Du das Tagpfauenauge beruehrst, verwischst Du das Muster "
	     "auf seinen Fluegeln...",
	     "Als "+TPN+" das Tagpfauenauge beruehrt, wird dessen schoenes "
	     "Muster verwischt...", 1);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

varargs void reaction(object ob, string macher, string andere, int flag) 
{
  if(present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(macher));
      tell_room(ENV(TO), BS(andere), ({ob}));
    }
  
  if(flag)
    die();
}
