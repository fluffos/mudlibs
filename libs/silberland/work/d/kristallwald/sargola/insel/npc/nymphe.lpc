#include "../def.h"

#define QUESTKEY "Verkupple Isabella"

inherit "std/npc";

string gestalt(string str);
string liebe(string str);
string belohnung(string str);

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  AddId(({"isabella","nymphe","NOWIMPY","NOCONTROL"}));

  SetProp(P_SHORT, "Die Wassernymphe Isabella plantscht im Wasser herum");
  SetProp(P_LONG, 
	  BS("Eine freche, kleine Wassernymphe mit langem, "
	     "goldenen Haar, leicht schimmernden Schuppen und "
	     "tiefgruenen, wunderschoenen Augen, die Dich "
	     "verwundert und fast kindlich anblicken."));

  SetGuardProtection(100, GUARD_QUEST);  

  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Isabella");
  SetProp(P_ARTICLE, 0);
  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "schwimmt weiter");
  SetProp(P_MMSGIN, "schwimmt herein");
  SetProp(P_MMSGOUT, "schwimmt weiter");


  AddDetail("haar", 
	    "Die Nymphe hat langes, hellblondes Haar, das wie Gold glaenzt.");
  
  AddDetail("augen",
	    "Die Nymphe hat meergruene Augen, mit denen sie Dich verwundert "
	    "anblickt.");
  
  AddDetail(({"gold","hals"}), 
	    "Um den Hals traegt die Nymphe ein Amulett.");
  
  AddDetail(({"goldamulett","amulett"}), 
	    "Das Amulett funkelt und glitzert. Du wuerdest gerne mehr "
	    "darueber erfahren.");
  
  AddDetail(({"flosse"}),
	    "Die Nymphe hat eine wunderschoene Flosse.");
  
  AddDetail(({"schuppe","schuppen"}),
	    "Die Schuppen der Nymphe schimmern leicht im Wasser.");
  
  AddInfo(DEFAULT_INFO,({
    "kichert verlegen und blickt Dich schuechtern an.\n",
      "sagt: Du bist aber neugierig!\n",
      "verschwindet blitzschnell im Wasser und taucht wieder auf.\n",
      "bespritzt Dich kichernd mit Wasser.\n"}));
  
  AddInfo(({"sargola","magier" }), 
	  "Sargola ist ein grosser Magier. Er hat den See hier "
	  "geschaffen, den Kristallwald... und auch die Insel hier "
	  "und vieles mehr!", 
	  "sagt: ");
  
  AddInfo(({"amulett"}), 
	  "Das Amulett habe ich von Sargola bekommen.",
	  "sagt: ");
  
  AddInfo(({"see","rhondonit"}), 
	  "Das hier ist der See von "
	  "Rhondonit. Er ist meine Heimat.",
	  "sagt: ");
  
  AddInfo(({"nymphe","nymphen"}), 
	  "sagt: Ich bin eine Nymphe. *kicher* ");
  
  AddInfo("name", 
	  "grinst: Den verrat ich nicht!");

  AddInfo("insel", 
	  "Die Insel ist ein geheimes Liebesversteck. "
	  "Viele verliebte Paerchen kommen hierher.",
	  "laechelt: ");

  AddInfo(({"liebesversteck","versteck"}), 
	  "Die Insel dient vielen Paerchen als geheimes Liebesversteck, weil "
	  "es hier Orte gibt, die man nicht so leicht entdeckt ... und dort "
	  "kann man Dinge tun, die man sonst nirgens tun kann.",
	  "sagt: ");

  AddInfo("glitzern", 
	  "Hmm... ich denke, Du meinst die zwei Goldringe am Grund.",
	  "gruebelt: ");
	
  AddInfo("gold", 
	  "Ich mach mir nicht viel aus Gold. Aber ihr Landkreaturen nehmt "
	  "es wohl sehr wichtig ... der Zwerg war ganz verrueckt danach!",
	  "sagt: ");

  AddInfo(({"kreaturen","landkreaturen"}), 
	  "Ja, euch mein ich, euch Menschen, Elfen, Zwerge, Hobbits etc...",
	  "sagt: ");

  AddInfo("zwerg", 
	  "Ein reicher, alter Zwerg hat hier einmal "
	  "zwei Ringe verloren ... sie fielen ihm ins Wasser, weil er "
	  "zu unachtsam war. Oh, wie hat der gejammert!", 
	  "erzaehlt: ");

  AddInfo(({"wasser","element"}), 
	  "sagt: Wasser ist mein Element.");

  AddInfo(({"kristallwald","wald","norden"}), 
	  "Weiter im Norden liegt der Kristallwald.",
	  "sagt: ");

  AddInfo("heimat", 
	  "Der See, die Lagune, der Wasserfall... "
	  "das alles ist meine Heimat.",
	  "sagt: ");

  AddInfo(({"ringe","ring","goldringe","goldring","belohnung"}), 
	  CLOSURE(belohnung), "sagt: ");

  AddInfo(({"orte","ort"}), 
	  "Es gibt viele Orte hier auf der die von den verliebten "
	  "Paerchen als Liebesnester genutzt werden.",
	  "sagt: ");

  AddInfo(({"paerchen","paar"}), 
	  "Es kommen viele Paerchen auf die Insel und tun alle "
	  "moeglichen Dinge...",
	  "grinst: ");

  AddInfo("dinge", 
	  "Die Liebespaare auf der Insel tun Dinge wie schmusen, kuscheln, "
	  "kuessen, umarmen, knuddeln, lieben, streicheln, knutschen... ",
	  "grinst: ");

  AddInfo("schwan",
	  "Der Schwan bringt viele Leute auf die Insel "
	  "und ist immer hungrig.",
	  "sagt: ");

  AddInfo("magie", 
	  "sagt: Es gibt viel Magie im Silberland.");

  AddInfo("silberland", 
	  "sagt: Hmmmm...davon hab ich schon gehoert!\n");

  AddInfo(({"honig","biene","bienen","bienenstock","wabe"}), 
	  "Ich liebe Honig! Er schmeckt so suess, aber hier im Wasser "
	  "gibt es leider keinen.", 
	  "sagt: ");

  AddInfo(({"tauben","taube","taeubchen","turteltaeubchen","turteltauben",
	      "turteltaube"}),
	  "Auf dem Johannisbrotbaum sitzen zwei verliebte Turteltaeubchen "
	  "... wenn man ihnen eine Botschaft fuer jemanden mitteilt, "
	  "leiten sie diese weiter.",
	  "sagt: ");

  AddInfo(({"brot","johannisbrot"}), 
	  "Der Schwan liebt das Johannisbrot. Mir schmeckt es nicht so sehr.",
	  "sagt: ");

  AddInfo("feder", 
	  "Der Schwan hat lange, weisse Federn. Manchmal faellt ihm eine "
	  "aus. Vielleicht findest Du eine, wenn Du Dich gruendlich "
	  "umsiehst.",
	  "sagt: ");
 
  AddInfo("weide", 
	  "Die Weide ist schon sehr alt. In ihre Rinde hat jemand was "
	  "eingeritzt. Unter ihren Wurzeln wachsen Bluemchen. Und man "
	  "kann sich auf das Baenkchen setzen, dass "
	  "in ihrem Schatten steht.",
	  "erzaehlt: ");

  AddInfo("bluemchen", 
	  "Ein Vergissmeinnicht, aber sag's nicht weiter!",
	  "fluestert: ");

  AddInfo(({"rose","rosen"}), 
	  "Ja, es gibt hier einen Rosenbusch mit roten Rosen. Wenn Du "
	  "eine Rose vom Rosenbusch brichst, solltest Du sie einer "
	  "Person schenken, die Dir am Herzen liegt.",
	  "sagt: ");

  AddInfo("baumhaus", 
	  "Am besten, Du siehst selbst einmal nach...",
	  "sagt: ");

  AddInfo("blumen", 
	  "Es gibt viele Blumen auf der Insel. Ich mag Rosen am liebsten.",
	  "sagt: ");

  AddInfo(({"papier","tinte"}), 
	  "Im Baumhaus liegen Papier und Tinte rum... Wenn man auch noch "
	  "eine Feder hat, kann man einen Liebesbrief schreiben.",
	  "sagt: ");
	
  AddInfo(({"brief","liebesbrief"}), 
	  "In Briefen kann man gut Gedanken und Gefuehle ausdruecken.",
	  "sagt: ");
		
  AddInfo("gedanken", 
	  "Gedanken und Gefuehle die Du Dich sonst "
	  "nicht zu gestehen getraust.",
	  "fluestert: ");

  AddInfo("grotte", 
	  "Sieh Dir den Wasserfall einmal genauer an.",
	  "fluestert: ");

  AddInfo("wasserfall", 
	  "Ich komm dort nicht rauf, Du vielleicht?",
	  "grinst vielsagend: ");

  AddInfo(({"nest","liebesnest","nester","liebesnester"}),
	  "Es gibt viele geheime Liebesnester hier auf der Insel...",
	  "fluestert: ");

  AddInfo(({"klippen","klippe"}), 
	  "Wenn Du mutig bist, kannst Du versuchen "
	  "auf die Klippe zu klettern.",
	  "sagt: ");

  AddInfo(({"bank","baenkchen"}), 
	  "Hast Du Dich schon auf das Baenkchen gesetzt und den Ausblick "
	  "genossen? Das solltest Du Dir mal ueberlegen. *zwinker* ",
	  "sagt: ");

  AddInfo("woody", 
	  "Bist DU Woody? Dann soll ich Dir sagen: Du bist "
	  "der Boss hier. Ansonsten hat Sargola mir aufgetragen zu "
	  "sagen: Der spielt eine ganz unbedeutende Rolle im Silber"
	  "land.",
	  "grinst: ");

  AddInfo("dusty", 
	  "sagt: Die steht ueber allen...");

  AddInfo(({"liebe","liebhaber"}), CLOSURE(liebe), "sagt: ");

  AddInfo("lichtung", 
	  "Hast Du die geheime Lichtung schon entdeckt? Warst Du mit "
	  "Deinem Schatz dort?",
	  "gruebelt froehlich: ");

  AddInfo("lagune", 
	  "Ich wohne in dieser Lagune. Sie ist wunderschoen. Man kann "
	  "hier in aller Ruhe baden und schwimmen.",
	  "sagt: ");

  AddInfo("sand", 
	  "sagt: Den gibts hier massenweise.");

  AddInfo("fische", 
	  "jubelt: Davon gibts hier viele!");

  AddInfo("flosse", 
	  "Alle Nymphen haben Flossen, sonst koennten "
	  "wir hier im Wasser ja nicht schwimmen.",
	  "grinst: ");

  AddInfo("haar", 
	  "fragt: Gefaellt Dir mein Haar?");

  AddInfo("grund", 
	  "Am Grund des Sees liegen immer noch die "
	  "beiden Ringe, die der alte Zwerg hier einmal verloren hat.",
	  "erzaehlt: ");

  AddInfo("zwerge", 
	  "Ach, Zwerge sind eine seltsame Rasse... "
	  "denken immer nur an Gold!",
	  "schmunzelt: ");

  AddInfo(({"elfe","elfen","elessar","stadt","sueden"}), 
	  "Etwas weiter im Sueden liegt Elessar, die Stadt der Elfen. "
	  "Eigentlich mag ich Elfen.",
	  "sagt: ");

  AddInfo(({"mensch","menschen"}), 
	  "Die sind doch irgendwie langweilig!",
	  "sagt: ");

  AddInfo(({"hobbit","hobbits"}), 
	  "Hobbits sind selten hier... Die moegen das Wasser nicht so sehr.",
	  "sagt: ");

  AddInfo(({"shardin","heilerin"}), 
	  "Shardin ist eine beruehmte Heilerin. Sie lebt in einer Hoehle "
	  "nahe des Sees.",
	  "sagt: ");

  AddInfo("aerendil", 
	  "Der wohnt in Elessar... und liest sehr viel.",
	  "sagt: ");

  AddInfo(({"aepfel","liebesaepfel"}), 
	  "Die Magie von Liebesaepfeln wirkt bei mir nicht.",
	  "seufzt: ");

  AddInfo("quest", 
	  "grinst: Dazu darf ich Dir nichts sagen.");

  AddInfo("gestalt", CLOSURE(gestalt), "sagt: ");

  SetProp(P_NOATTACK, 
	  "weicht erschrocken zurueck.\n"+
	  BS("Du schaemst Dich in Grund und Boden, weil Du an "
	     "einem so friedlichen Ort eine harmlose, kleine Nymphe "
	     "angegriffen hast."));
  
  SetChats(4, ({
    "Isabella seufzt: Ach waere ich doch nicht so allein hier.\n",
      "Isabella fluestert: Das ist die Insel der Liebe.\n",
      "Isabella gruebelt: Warum habe ich keinen Liebhaber?\n",
      "Isabella planscht im Wasser herum.\n",
      "Isabella taucht unter und hinter Dir wieder auf.\n",
      "Isabella blickt Dich fragend an.\n"}));
}

int _query_wimpy() { return 0; }

nosave void sfkt(string str)
{
  command_me("sage "+str);
}

void give_notify(object ob)
{
  object o,rm;
  int i;
  object m;
   
  o=present("\n_insel_quest",TP);
   
  if(ob->id("\n_insel_liebesbrief"))
    if(objectp(o))
      {
	// brief nicht von ihm
	if(ob->frage_owner()!=getuid(TP))
	  {
	      call_out("sfkt", 1, "Was ist das fuer ein seltsamer Brief?");
	      
	      ob->remove(1);
	      
	      return;
	  }
	
	write("Isabella liest geraume Zeit an dem Brief. Sie scheint ihn "
	      "immerwieder zu lesen.\n"
	      "Isabella blickt Dich gluecklich an.\n"
	      "Isabella sagt: Das ist der liebste Brief, den ich jemals "
	      "bekommen habe.\n"
	      "Isabella sagt: Er will mir sein Herz schenken, nur kann ich "
	      "mit meiner Flosse\n"
	      "Isabella sagt: nicht auf die Klippe klettern...\n\n"
	      "Du siehst, wie der Schuechtling auf der Klippe steht und "
	      "alles beobachtet.\n");
	
	o->erhoehe_zaehler(4);
	
	//entweder ist er in der hoehle oder im dummy
	
	call_other(ROOM "hoehle", "???");
	
	rm = find_object(ROOM "hoehle");
	
	if(!objectp(ob=present("hoehlenschuechtling", 
			       find_object(ROOM "dummy"))))
	  ob=present("hoehlenschuechtling", rm);
	
	if(objectp(ob))
	  {
	    ob->move(ROOM"wasserfall",M_GO|M_NOCHECK);
	    
	    ob->SetProp(P_CHAT_CHANCE, 15);
	    
	    if(find_call_out("holen")!=-1)
	      remove_call_out("holen");
	  }
	
	//damit er dort nicht ewig steht
	if(find_call_out("weg_mit_ihm")==-1)
	  call_out("weg_mit_ihm",300,ob);
	
	return;
      }
    else
      {
	call_out("sfkt",1,"Hmm... danke aber damit fange ich gar nichts an.");
	
	ob->remove(1);
	
	return;
      }

  if(ob->id("\n_insel_rose"))
    if(objectp(o))
      {
	write("Isabella freut sich: Danke! Ist die von dem Schuechtling in "
	      "der Grotte oben?\n"
	      "Isabella gruebelt: Ich moechte aber schon gern wissen, was "
	      "er denkt ... \n"
	      "Isabella sagt: Und es mir offen zu gestehen, ist er sicher "
	      "zu feige ...\n"
	      "Isabella sagt: Koennte er mir einen Brief schreiben?\n");
	
	ob->remove(1);
	
	o->erhoehe_zaehler(2);
	
	return;
      }
    else
      {
	sfkt("Die ist schoen, aber ich kann sie nicht brauchen.");

	give_obj(ob, TP);

	return;
      }

  // Kleines praesent fuer forscher ;))
  if(ob->id("\n_insel_honigwabe")==1)
    {
      rm=MENV;
   	
      write(BS("Isabella stuerzt sich auf die Honigwabe und blickt Dich "
	       "dann mit honigverschmiertem, aber gluecklichen Gesicht an."));
      ob->remove(1);   	
      //Geschenk: entweder eine Muschel oder pech gehabt ;)
 
      write(BS("Isabella sagt: Ich moechte Dir auch etwas schenken.")+
	    BS("Isabella taucht ins Wasser ein und ist geraume Zeit "
	       "verschwunden."));

      if(rm->frage_muschel())
   	{
	  write(BS("Isabella taucht wieder auf und ueberreicht Dir eine "
		   "seltsame Muschel."));

	  m = clone_object(OBJ"muschel");

	  if(m->move(TP, M_GET)==ME_TOO_HEAVY)
	    {
	      m->remove(1);

	      write(BS("Als Du nach der Muschel greifst, faellt sie Dir "
		       "ploetzlich aus der Hand und versinkt wieder im "
		       "Wasser..."));
	      return;
	    }

	  rm->loesche_muschel();

	  return ;
	}
      
      write(BS("Isabella taucht fuer geraume Zeit unter und taucht dann "
	       "wieder auf.")+
	    BS("Isabella seufzt: Ich habe eine huebsche Muschel fuer Dich "
	       "gesucht, aber leider keine")+
	    BS("Isabella seuftz: gefunden..."));

      return ;
    }

  sfkt("Ich glaube, dass ich das nicht brauchen kann...");

  give_obj(ob, TP);
}   	

void augenwinkel(object who)
{
  if(present(who, MENV))
    tell_object(who,
		BS("Aus den Augenwinkeln glaubst Du eine Gestalt auf der "
		   "Klippe erkennen zu koennen."));
}

string liebe(string str)
{
  object ob;
  
  call_out("augenwinkel", 2, TP);

  if(!objectp(ob=present("\n_insel_quest", TP)))
    {
      ob = clone_object(OBJ "lquest");
      ob->move(TP);
      ob->erhoehe_zaehler(1);
    }
  else
    ob->erhoehe_zaehler(1);	// die Quest beginnt ...

  // Welche Feder findet man? :)
  if(random(2))
    ob->setze_feder_ort(1);
  else
    ob->setze_feder_ort(2);

  return "Das hier ist die Insel der Liebe. Der romantischste Ort im "
    "ganzen Silberland. Nur ich hab keinen Liebhaber...";
}

string gestalt(string str)
{
  if(present("\n_insel_quest",TP))
    return "Ich weiss nicht, wer sich dort oben an der Klippe befindet. "
      "Schon oefters hab ich bemerkt, dass mich von dort oben "
      "jemand beobachtet.";
  
  return "Davon weiss ich leider nichts.\n";
}

string belohnung(string str)
{
  object belo;

  if((TP) && (TP->QueryQuest(QUESTKEY)))
    if((!present("\n_insel_ringe", TP)) && 
       (!present("\n_insel_liebesring", TP)))
      {
	belo=clone_object(ARMOUR "ringe");
	
	if(belo->move(TP)==ME_TOO_HEAVY)
	  {
	    belo->remove(1);
	    
	    return "Da Du die Ringe nicht mehr tragen kannst, "
	      "werde ich sie Dir auf Anfrage spaeter geben.";
	  }
	
	write(BS("Isabella uebergibt Dir das Paar Ringe, da Du ihr bereits "
		 "geholfen hast.")+"\n");
	
	return "Hier, bitte.";
      }
  
  return "Die beiden Ringe liegen auf dem Grund des Sees herum.";
}


weg_mit_ihm(object ob)
{
  ob->move(ROOM"dummy",M_GO);
  ob->SetProp(P_CHAT_CHANCE, 0);
}
