#include "../def.h"
  
inherit "std/npc"; 

nosave int gefuettert;

void create()  
{  
  if(!is_clone(TO)) return;  
  ::create();
  
  gefuettert =0;
  
  SetProp(P_SHORT, "Ein weisser Schwan steht hier am Ufer");
  SetProp(P_LONG, 
	  BS("Der Schwan ist von beeindruckender Schoenheit. Er "
	     "hat - bis auf die Stelle um seine Augen - strahlend weisses "
	     "Gefieder, einen langen, geschwungenen Hals und "
	     "einen kraeftigen, orangefarbenen Schnabel. Fuer einen "
	     "Schwan ist er von betraechtlicher Groesse.")); 
  
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Schwan");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));

  AddId(({"schwan","\n_insel_schwan"}) );

  create_default_npc(10);

  SetProp(P_XP, 0);
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 112);
  SetProp(P_WEIGHT, 25234);
  SetProp(P_ALIGN, 50);

  SetProp(P_HANDS, ({" mit seinem Schnabel", 250, DT_BLUDGEON}));
  
  SetProp(P_MSGIN, "schwimmt ans Ufer heran");
  SetProp(P_MSGOUT, "schwimmt");

  SetProp(P_NOATTACK,"plustert seine Federn auf und ist ploetzlich "
	  "vier mal\ngroesser als Du!\nDu weichst erschrocken nach hinten.");
  
  SetProp(P_REJECT, 
	  ({REJECT_DROP, "Was sollte der Schwan damit anfangen?\n"}));
  
  AddDetail("schoenheit", 
	    "Du hast noch nie einen so schoenen Schwan gesehen. Er ist "
	    "geradezu ueberirdisch schoen.");
  
  AddDetail("stelle", 
	    "Um Augen und Schnabel herum sind die Federn des Schwans schwarz.");
  
  AddDetail(({"augen","auge"}), 
	    "Der Schwan hat sanfte, tiefschwarze Augen, mit denen er Dich "
	    "erwartungsvoll ansieht.");
  
  AddDetail(({"gefieder","federn"}), 
	    "Der Schwan hat strahlend weisses Gefieder.");
  
  AddDetail("hals", 
	    "Der Hals des Schwans ist ziemlich lang und aeusserst grazioes "
	    "geschwungen.");
  
  AddDetail("schnabel", 
	    "Der Schnabel ist orangefarben und sieht gefaehrlich aus. Wenn "
	    "er damit nach Dir hackt, kann er Dir sicherlich ziemlich weh "
	    "tun.");
  
  AddDetail("groesse", 
	    "Der Schwan ist so gross, das zwei erwachsene Personen leicht "
	    "Platz auf seinem breiten Ruecken faenden.");
  
  AddDetail(({"personen","person","leute"}), 
	    "Wer das ist, musst schon Du wissen.");
  
  AddDetail("ruecken", 
	    "Auf dem Ruecken des Schwans haetten zwei Personen leicht Platz "
	    "- aber Dir kommen Zweifel, ob der Schwan damit einverstanden "
	    "waere, ohne Gegenleistung irgendwelche Leute auf seinen "
	    "Ruecken klettern zu lassen.");
  
  AddDetail("platz", 
	    "Auf dem Ruecken des Schwans ist Platz fuer zwei.");
  
  AddDetail("zweifel", 
	    "Du bezweifelst, dass der Schwan ohne Gegenleistung dazu bereit "
	    "ist, mit irgendwelchen Leuten auf dem Ruecken herumzuschwimmen.");
  
  AddDetail("gegenleistung", 
	    "Was koennte man einem Schwan wohl als Gegenleistung anbieten?");
  
  SetProp(P_SOUND, "Du hoerst den Magen des Schwans knurren.\n");
  SetProp(P_SMELL, 
	  "Der Schwan riecht wie ein typischer Schwan nun mal riecht.\n");

  SetChats(3, ({
    "Der Schwan putzt seine Federn.\n",
      "Der Schwan plustert sich auf und flattert mit den Fluegeln.\n"}));

  
  AddCmd(({"fuetter","fuettere"}),"fuetter");
  AddCmd(({"klettere","kletter"}),"kletter");
}

nosave int kletter(string str)
{
  notify_fail(BS("Wohin moechtest Du klettern?"));
  if(!str) return 0;
  
  if(str=="auf schwan"||str=="auf ruecken"||str=="auf schwan rauf"||
     str=="auf schwan hinauf"||str=="auf ruecken von schwan"||
     str=="auf ruecken von schwan rauf"||str=="auf ruecken von schwan hinauf")
    if(gefuettert)
      {
	write(BS("Du kletterst vorsichtig auf den Ruecken des Schwans."));
	
	if(file_name(MENV)==ROOM "1")
	  {
	    if(find_call_out("reise_back")==-1)
	      call_out("reise_back",0);
	  }
	else
	  {
	    if(find_call_out("reise")==-1)
	      call_out("reise",0);
	  }
	return 1;
      }
    else
      return write(BS("Der Schwan faucht Dich wild an.")), 1;
  
  return 0;
}

nosave int fuetter(string str)
{
  object futter;

  notify_fail("Wen moechtest Du womit fuettern?\n");
  if(!str) return 0;

  if(str=="schwan mit semmel"||str=="schwan mit semmeln")
    if(futter=present("semmel", TP))
      {
	write(BS("Du wirfst die Semmel in kleinen Stueckchen zum Schwan hin "
		 "und er beginnt dankbar danach zu schnappen."));

	futter->remove(1);
	
	gefuettert = 1;
	
	return 1;
      }
    else
      return write(BS("Welche Semmel willst Du denn an den Schwan "
		      "verfuettern?")), 1;
  
  if(str=="schwan mit brot"||str=="schwan mit johannisbrot")
    if(futter=present("johannisbrot", TP))
      {
	write(BS("Du zerteilst das Brot in kleine Stuecke "
		 "und fuetterst den Schwan damit."));

	futter->remove(1);

	gefuettert = 1;

	return 1;
      }
    else
      return write(BS("Mit welchem Brot moechtst Du den Schwan "
		      "fuettern?")), 1;
  
  return 0;
}


void reset()
{
  ::reset();

  if(MENV) call_out("remove",0);
}

void reise()
{
  tell_object(TP, BS("Der Schwan schwimmt mit Dir langsam "
		     "und gleichmaessig ueber den See. Ploetzlich kommt im "
		     "Zentrum des Sees eine Insel in Sicht. Der Schwan "
		     "schwimmt zum Ufer und Du kletterst wieder vom Schwan "
		     "runter.\nDer Schwan verschwindet wieder.\n"));

  TP->move(SCHWAN_INSEL, M_GO|M_SILENT|M_NO_SHOW);

  remove();  
}

void reise_back()
{
  tell_object(TP, BS("Der Schwan schwimmt mit Dir langsam "
		     "und gleichmaessig ueber den See. Langsam kommt "
		     "das Ufer wieder in Sicht. Du kletterst vorsichtig "
		     "vom Schwan runter.\n"
		     "Der Schwan verschwindet wieder.\n"));

  TP->move(SCHWAN_UFER, M_GO|M_SILENT|M_NO_SHOW);

  remove();
  
}
