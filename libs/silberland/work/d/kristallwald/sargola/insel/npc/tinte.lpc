inherit "std/thing";
#include <properties.h>
#include <language.h>
#include "../def.h"

int tinte;

      create()      
{        if (!is_clone(this_object()))           return;
	::create();
	tinte = 0;	
	AddId ( ({"\n_insel_tinte","tinte"}));
	SetProp (P_SHORT, "Ein Flaeschchen Tinte");
	
	SetProp (P_NAME, "Flaeschchen Tinte");
	SetProp (P_GENDER, NEUTER); 
	SetProp (P_WEIGHT, 5);
	SetProp (P_VALUE, 5);
	SetProp (P_MATERIAL, ({MAT_GLASS }));

	AddDetail( ({"glas","flaeschchen"}),
	 "Du siehst ein kleines, bulkiges "
	+"Flaeschchen aus Glas.\n");
	
}  

_query_long()
{
	if(tinte)
		return BS("Ein kleines Flaeschchen, welches mit schwarzer Tinte "
			+"gefuellt ist.");
	return BS("Ein kleines, leeres Flaeschchen. Du entdeckst Reste einer "
		+"schwarzen Fluessigkeit.");
		}

query_tinte()
{
	return tinte;
}

setze_tinte(int i)
{
	tinte = i;
}
