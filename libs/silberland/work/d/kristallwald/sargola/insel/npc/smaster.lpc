/*
*************************************
** Master fuer die Parechen
*************************************
*/

  object *paerchen;

  create()
  {
    if (is_clone(this_object())) return 0;
    paerchen = ({});
  }

  add_paerchen(object *p)
    {
	if(sizeof(paerchen)<3)
	{
	    paerchen += ({ p  });
	    return 1;
	}
	else
	    return 0;
    }

  query_paerchen()
    {
    return paerchen;
    }
  
  remove_paerchen(object *p)
    {
    paerchen -= ({ p  });
    }
    
