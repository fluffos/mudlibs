inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <wizlevels.h>
#include <new_skills.h>
#include "../schatzkristall.h"

void create()
{
 
if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_NAME, "Einsiedlerkrebs");
  SetProp(P_SHORT, "Ein Einsiedlerkrebs");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_LONG,
    "Ein kleiner Einsiedlerkrebs. Er krabbelt mit seinen kleinen "
    "Beinchen im Sand herum und traegt am Ruecken ein Haus.");
  AddId( ({ "einsiedlerkrebs", "krebs"}) );
  
  AddDetail( ({ "beinchen" }),
    "Der Einsiedlerkrebs krabbelt mit seinen kleinen Beinchen im Sand "
    "herum.");
  AddDetail( ({ "ruecken" }),
    "Der Einsiedlerkrebs traegt am Ruecken ein kleines Haus.");
  AddDetail( ({ "haus" }),
    "Der Einsiedlerkrebs traegt am Ruecken ein kleines Haus. Es sieht "
    "so aus, als waere es mit Silber ueberzogen.");
  AddDetail( ({ "silber" }),
    "Das Haus scheint mit etwas Silber ueberzogen zu sein. Es reflektiert "
    "die Sonnenstrahlen und laesst sie funkeln und glitzern.");
  
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  
  create_default_npc(15);
  SetProp(P_NOATTACK, "ist doch viel zu klein.");
}                   