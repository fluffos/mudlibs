inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <wizlevels.h>
#include <new_skills.h>
#include "../schatzkristall.h"
#include "/d/ebene/hotaru/hotaru.h"

varargs void playseq(object ob, mixed sequence);

void init()
{
  ::init();
  if(interactive(TP)) call_out("check", 0);
}

create()
{
  if(!is_clone(TO)) return;  
  ::create();
  
  set_living_name("zauberin");
  AddId(({ "zauberin" }));
   
  SetProp(P_NAME, "Zauberin");
  SetProp(P_SHORT, "Eine Zauberin");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_LONG, 
    "Du erblickst eine kleine, pummelige Gestalt. "
    "Sie traegt einen spitzen Hut und ist in leichte Kleidung "
    "gehuellt. Komisch... Sie schwebt etwas ueber dem Boden. "
    "Das soll die boese Zauberin sein, von der Dir Siilaril "
    "erzaehlt hat?");
  
  AddDetail( ({ "gestalt" }), TO->QueryProp(P_LONG));
  AddDetail( ({ "hut" }),
    "Die Zauberin traegt einen spitzen Hut.");
  AddDetail( ({ "kleidung" }),
    "Die Zauberin ist in leichte Kleidung gehuellt.");
  
  SetProp(P_RACE, "Mensch");
  
  create_default_npc(15);
  
  SetProp(P_ALIGN, 900);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_SIZE, 180);
  SetProp(P_NOATTACK, "schwebt aus Deiner Reichweite.\n");
  
  SetChats(3, ({
    "Die Zauberin schwebt um Dich herum.\n"}) );

  AddCmd( ({ "antworte" }), "cmd_answer");
}

void check()
{
  if(TP->QueryQuest(QUESTKEY))
  {
  TP->SetProp(P_PARALYZED, ([ PARALYZE_TIME: 5,
      PARALYZE_MSG:"Du bist in Trance.\n",
      PARALYZE_MSG_OTHER:"",
      PARALYZE_END:"",
      PARALYZE_END_OTHER:"" ]));
  playseq(TP, ({
    "§@ME sagt: $Huch! Da ist Siilaril wohl ein Fehler unterlaufen! "
    	       "Wir beide kennen uns doch bereits!°°°",
    "§@ME sagt: $Einen Moment! Ich werde Dich gleich wieder zu "
    	       "Siilaril schicken!°",
    "@ME zaubert @NAME weg.§",
    "@@home@@",
    "@@weg@@"}));
  }
  else
  {
    call_out("asking", 0);
  }
}

void check1()
{
  if(present(QUESTKELCH), TP)
  {
  TP->SetProp(P_PARALYZED, ([ PARALYZE_TIME: 5,
      PARALYZE_MSG:"Du bist in Trance.\n",
      PARALYZE_MSG_OTHER:"",
      PARALYZE_END:"",
      PARALYZE_END_OTHER:"" ]));
  playseq(TP, ({
    "§@ME sagt: $Ah, Du hast den Schatzkristall bereits erhalten und "
    	       "Dich dafuer entschieden, im Gedankenreich zu "
    	       "bleiben.°°°",
    "§Mit einem lauten Knall verschwindet die Zauberin.",
    "@@weg@@"}));
  }
  else
  {
    call_out("", 0);
  }
}

void asking()
{	
  if(!(TP->QueryQuest(QUESTKEY))) 
  {
  TP->SetProp(P_PARALYZED, ([ PARALYZE_TIME: 30,
      PARALYZE_MSG:"Du lauscht der Zauberin.\n",
      PARALYZE_MSG_OTHER:"",
      PARALYZE_END:"",
      PARALYZE_END_OTHER:"" ]));
  playseq(TP, ({
    "§Die Zauberin schwebt um Dich herum.°°",
    "§@ME sagt: Sei gegruesst @NAME!°°",
    "§@ME sagt: $Wie Du vielleicht schon bemerkt hast, bin ich die boooese "
    	       "Zauberin, von der Dir Siilaril erzaehlt hat.°°°",
    "§@ME taumelt umher.",
    "§@ME sagt: $Huch! Ich sollte mich besser etwas aufs Fliegen "
    	       "konzentrieren.°°",
    "@ME unterhaelt sich mit @WEM.§",
    "§@ME sagt: $Ich bin im Besitz des Schatzkristalls und werde Dich nun "
    	       "vor eine Wahl stellen!°°°",
    "§@ME richtet sich ihren Hut.°°",
    "§@ME sagt: $Ich wuerde Dir gestatten, das Gedankenreich "
    	       "sofort zu verlassen, nur waerst Du dann nicht mehr in der "
    	       "Lage, den Schatzkristall zu erhalten.°°°°",
    "§@ME sagt: $Antworte mir mit <ich gebe auf> um aufzugeben, oder mit "
    	       "<niemals> um nicht aufzugeben.°°°°",
    "§@ME sagt: $Solltest Du Dich dafuer entscheiden, im Gedankenreich "
    	       "zu bleiben, so werde ich Dir den Schatzkristall "
    	       "ueberlassen.°°°",
    "§@ME sagt: $Aber bedenke! Was Dich noch erwarten wird, kann Dir "
               "niemand sagen, und es koennte sein, dass Du fuer immer "
               "in der Gedankenwelt bleiben musst...°°°°°",
    "§@ME sagt: Nun, so sei es denn, triff Deine Wahl.°"}));
   }
}

int cmd_answer(string str)
{
  notify_fail(BS("Was moechtest Du denn wem antworten?"));
  if(str == "zauberin niemals")
  {
    call_out("weiter", 0);
    write(BS("Du antwortest der Zauberin: Niemals."));
    tell_room(ENV(TP), TPN+" antwortet der Zauberin etwas.\n", ({TP}));
    return 1;
  }
  if(str == "zauberin ich gebe auf")
  {
    call_out("ende", 0);
    write(BS("Du antwortest der Zauberin: Ich gebe auf."));
    tell_room(ENV(TP), TPN+" antwortet der Zauberin etwas.\n", ({TP}));
    return 1;
  }
}

void ende()
{
  TP->SetProp(P_PARALYZED, ([ PARALYZE_TIME: 5,
      PARALYZE_MSG:"Du lauscht der Zauberin.\n",
      PARALYZE_MSG_OTHER:"",
      PARALYZE_END:"",
      PARALYZE_END_OTHER:"" ]));
  playseq(TP, ({ 
    "§@ME sagt: $Oh... Du entschliesst Dich also aus dem Gedankenreich "
    	       "zu entkommen...°°",
    "§@ME sagt: $Nun, wenn das Deine Entscheidung ist, werde ich Dich "
    	       "wieder zu Siilaril schicken.°°",
    "§@ME grinst: $Richte ihr bitte schoene Gruesse aus.°",
    "§@ME macht ein paar komische Bewegungen.",
    "§@ME bringt Dich zu Siilaril zurueck.",
    "@ME bringt @WEN zu Siilaril zurueck.§",
    "@@home@@"}));
}

string home()
{
  TP->move(SIEDLUNG("plattform.lpc"), M_TPORT | M_SILENT);
  return "";
}

void weiter()
{
  TP->SetProp(P_PARALYZED, ([ PARALYZE_TIME: 23,
      PARALYZE_MSG:"Du lauscht der Zauberin.\n",
      PARALYZE_MSG_OTHER:"",
      PARALYZE_END:"",
      PARALYZE_END_OTHER:"" ]));
  playseq(TP, ({ 
    "§@ME sagt: $Du willst tatsaechlich den legendaeren Schatzkristall "
    	       "erhalten?°°",
    "§@ME sagt: $Nun ich will mein Versprechen halten und ihn Dir "
    	       "ueberlassen. Doch lass Dir eins gesagt sein!°°",
    "§@ME sagt: $Ich werde alles daran setzen, dass Du es nicht schaffst, "
    	       "aus dem Schattenreich zu entkommen!°°",
    "§@ME sagt boese: $Viel Spass wuensche ich Dir noch!°°",
    "Mit einem lauten Knall verschwindet die Zauberin.°",
    "§Eine Stimme sagt: Nun, so suche den Weg zurueck.",
    "@@weg@@"}));
}

string weg()
{
  call_out("remove", 0);
  return "";
}

varargs void playseq(object ob, mixed sequence) {
  int trenner, waittime;
  string curline, general, personal;
  if(!ob) return;
  if(present(ob, ENV(TO))) {
    
    if (pointerp(sequence)) {
      if (sizeof(sequence) == 0) return;
      curline = sequence[0];
    } else {
      curline = sequence;
    }
    
    waittime = strstr(curline, "°", 0);
    if (waittime == -1) {
      waittime = 0;
    } else {
      waittime = (strlen(curline) - waittime) * 2;
      curline = curline[0..strstr(curline, "°", 0)-1];
    }
    
    curline  = process_string(curline);
    curline  = regreplace(curline,  "@ME",     TO->Name(WER, 1),    1);
    curline  = regreplace(curline,  "@NAME",   ob->Name(WER, 1),    1);
    
    trenner = strstr(curline, "§", 0);
    if (trenner != -1) {
      general = curline[0..trenner-1];
      personal = curline[trenner+1..];
    } else {
      general = personal = curline;
    }
    
    general  = regreplace(general,  "@WER",    ob->Name(WER, 1),    1);
    general  = regreplace(general,  "@WESSEN", ob->Name(WESSEN, 1), 1);
    general  = regreplace(general,  "@WEM",    ob->Name(WEM, 1),    1);
    general  = regreplace(general,  "@WEN",    ob->Name(WEN, 1),    1);
    
    personal = regreplace(personal, "@WER",    "Du",                1);
    personal = regreplace(personal, "@WESSEN", "Dein",              1);
    personal = regreplace(personal, "@WEM",    "Dir",               1);
    personal = regreplace(personal, "@WEN",    "Dich",              1);

    if (personal != "") tell_object(ob, MyBS(personal));
    if (general  != "") tell_room(ENV(TO), MyBS(general), ({ob,this_object()}));
    
    if (pointerp(sequence)) {
      if (sizeof(sequence) == 1) return;
      call_out("playseq", waittime, ob, sequence[1..]);
    }
  }
}
