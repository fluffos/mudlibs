inherit "std/thing";

#include "../schatzkristall.h"
#include "../def.h"

#define KOEDER "\ngekoedert"

create()
{

if(!is_clone(this_object())) return;
   
::create();

   SetProp(P_NAME, "Schere");
   SetProp(P_SHORT, "Die Schere eines Taschenkrebses");
   SetProp(P_GENDER, MALE);
   SetProp(P_LONG,
     "Die Schere besteht hauptsaechlich aus abgestorbenem Chitin. "
     "Dazwischen befindet sich aber immerhin noch etwas Fleisch.");
   
   AddDetail( ({ "chitin" }),
     "Die Schere besteht hauptsaechlich aus Chitin.");
   AddDetail( ({ "fleisch" }),
     "Ein bisschen Fleisch befindet sich noch zwischen dem Chitin.");
   AddId( ({ "koeder", "schere" "\nkoeder" }) );
   
   SetProp(P_NOBUY, 1);
   SetProp(P_NOSELL);
   SetProp(P_WEIGHT, 100);
   SetProp(P_MATERIAL, ([MAT_CHITIN: 90, MAT_FLESH: 10]));
   
   AddCmd( ({ "befestige", "befestig" }), "cmd_put");
}

int cmd_put(string str)
{
  object angel;
  notify_fail(BS("Was moechtest Du woran befestigen?"));
  if(!(str == "koeder an angel" || str == "koeder an schnur" || 
       str == "schere an angel" || str == "schere an schnur"))
  {
    return 0;
  }
  if(!angel=present(ANGEL, TP))
   return notify_fail(BS("Aber Du hast ja gar keine Angel!")), 0;
  if(angel->id(KOEDER))
   return notify_fail(BS("Du hast schon einen Koeder an der Angel "
  			 "befestigt.")), 0;
  
  write(BS("Du befestigst die Schere an der Angel."));
  
  angel->SetProp(P_WEIGHT, angel->QueryProp(P_WEIGHT)+QueryProp(P_WEIGHT) );
  angel->AddId(KOEDER);
  angel->SetProp(P_SHORT, angel->QueryProp(P_SHORT)+ " und einem Koeder");
  angel->SetProp(P_LONG, angel->QueryProp(P_LONG)+ "Eine Krebsschere wurde "
  						   "an der Schnur "
  						   "befestigt.");
  remove();
  return 1;
}