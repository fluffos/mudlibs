inherit "std/thing";

#include "../def.h"
#include "../schatzkristall.h"

create()
{

if(!is_clone(this_object())) return;
   
::create();

   SetProp(P_NAME, "Kelch der Sinne");
   SetProp(P_SHORT, "Der Kelch der Sinne");
   SetProp(P_GENDER, MALE);
   SetProp(P_LONG,
     "Der Kelch der Sinne besteht aus Stein. Auf ihm sind einige "
     "Verzierungen eingearbeitet worden.");
   
   AddDetail( ({ "stein" }),
     "Der Kelch der Sinne besteht aus Stein.");
   AddDetail( ({ "verzierungen", "muster" }),
     "Schoene Muster wurden in den Kelch eingearbeitet.");
   AddDetail( ({ "aura" }),
     "Der Kelch strahlt eine magische Aura aus.");
   
   SetProp(P_INFO, 
     "Der Kelch der Sinne strahlt eine magische Aura aus.");
   AddId( ({ QUESTKELCH, "kelch" }) );
   
   SetProp(P_NOBUY, 1);
   SetProp(P_NOSELL);
   SetProp(P_WEIGHT, 300);
   SetProp(P_MATERIAL, ([MAT_MISC_STONE: 100]));
}