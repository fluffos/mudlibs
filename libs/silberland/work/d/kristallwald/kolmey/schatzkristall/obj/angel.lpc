inherit "std/thing";

#include "../schatzkristall.h"
#include "../def.h"

void delayedwrite(object spieler, int curpos, mixed *daten);

create()
{

if(!is_clone(this_object())) return;
   
::create();

   SetProp(P_NAME, "Ast mit Schnur");
   SetProp(P_SHORT, "Ein Ast mit Schnur");
   SetProp(P_GENDER, MALE);
   SetProp(P_LONG,
     "Ein Ast, auf dem eine Schnur befestigt ist. Wenn Du einen "
     "Koeder haettest, koenntest Du mit ihm vielleicht sogar etwas "
     "angeln.");
   
   AddDetail( ({ "schnur" }),
     "Eine kleine Schnur ist an den Ast gebunden worden. Vielleicht "
     "koenntest Du damit sogar etwas angeln.");
   
   AddId( ({ "ast", ANGEL }) );
   
   SetProp(P_NOBUY, 1);
   SetProp(P_NOSELL);
   SetProp(P_WEIGHT, 100);
   SetProp(P_MATERIAL, ([MAT_MISC_WOOD: 90, MAT_WOOL: 10]));

   AddCmd( ({ "angel", "angle" }), "cmd_get");
}

int cmd_get(string str)
{
  notify_fail(BS("Mit was moechtest Du denn angeln?"));
  if(!(str == "mit angel" || str == "mit ast"))
  {
    return 0;
  }
  if(!present(ANGEL, TP) && !present(KOEDER, TP))
  {
    write(BS("Aber Du hast ja gar keine Angel!"));
    return 1;
  }
  if(!present(KOEDER, TP))
  {
    write(BS("Du hast doch gar keinen Koeder an dem Ast befestigt!"));
    return 1;
  }
  else
  {
    TP->SetProp(P_PARALYZED, ([ PARALYZE_TIME: 8,
      PARALYZE_MSG:"Du angelst gerade.\n",
      PARALYZE_MSG_OTHER:"",
      PARALYZE_END:"",
      PARALYZE_END_OTHER:"" ]));
   delayedwrite(TP, 0, ({
     0, "Du wirfst Deine improvisierte Angel aus und wartest.",
     4, "#Du wartest...",
     2, "#...und wartest.",
     2, "#Ploetzlich zieht etwas an der Schnur. Es schein ein Fisch "
     	"angebissen zu haben.",
     2, "#Du ziehst mit aller Kraft, doch Du bist zu schwach. Mit einem "
     	"kraeftigen Ruck wird Dir Dein Ast aus der Hand gerissen und "
     	"verschwindet in den weiten des Meers.",
     4, "Das muss wohl ein maechtig grosser Fisch gewesen sein.",
     2, "#Enttaeuscht wendest Du Dich ab.",
     0, "@@weg@@"}));
   return 1;
   }
}

string weg()
{
  call_out("remove", 0);
  return "";
}

void delayedwrite(object spieler, int curpos, mixed *daten)
{
  string output;
  if (!spieler) return;
  
  output = process_string(daten[curpos+1]);
  if (output[0] == 35) {
    tell_object(spieler, "\n");
    tell_object(spieler, BS(output[1..]));
  } else {
    tell_object(spieler, BS(output));
  }
  if (curpos + 2 < sizeof(daten))
    call_out("delayedwrite", daten[curpos+2], spieler, curpos+2, daten);
}