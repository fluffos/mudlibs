inherit "std/thing";

#include "../schatzkristall.h"
#include "../def.h"

create()
{

if(!is_clone(this_object())) return;
   
::create();

   SetProp(P_NAME, "Stein");
   SetProp(P_SHORT, "Ein Stein");
   SetProp(P_GENDER, MALE);
   SetProp(P_LONG,
     "Ein kleiner handlicher Stein.");
   
   SetProp(P_INFO, 
     "Der Stein ist so handlich, den koennte man bestimmt zielgenau "
     "werfen.");
   AddId( ({ QUESTSTEIN, "stein" }) );
   
   SetProp(P_NOBUY, 1);
   SetProp(P_NOSELL);
   SetProp(P_WEIGHT, 100);
   SetProp(P_MATERIAL, ([MAT_MISC_STONE: 100]));
}