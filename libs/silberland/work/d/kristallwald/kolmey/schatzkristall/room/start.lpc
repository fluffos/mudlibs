inherit "std/room";

#include "../schatzkristall.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <verben.h>

void delayedwrite(object spieler, int curpos, mixed *daten);

mapping waehler;

create()
{

::create();

/*-----------------------KURZ UND LANGBESCHREIBUNG-----------------------*/

   SetProp(P_INT_SHORT, "In Gedanken");
   SetProp(P_INT_LONG,
     "Du findest Dich in einem eigenartigen Raum wieder.\n"
     "Helles Licht scheint von allen Seiten aus zu kommen. Bunte "
     "Farben, ein Lachen, ein Wimmern, Gerueche und zahlreiche "
     "andere Einfluesse wirken hier gleichzeitig auf Dich ein. "
     "Du kannst Dich nicht mehr konzentrieren, wirst Du verrueckt?");
   
/*-----------------------RAUMEIGENSCHAFTEN-----------------------*/
   
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );
   SetProp(P_INDOORS, 0);
   SetProp(P_LOG_FILE, "/d/kristallwald/kolmey/kristall_quest.log");

/*-----------------------RAUMDETAILS-----------------------*/
   
   AddDetail( ({ "raum" }),
     "Der Raum hier ist das Erste, dass Du wahrnimmst, seitdem Du das "
     "Wasser der Sinne getrunken hast. Zahlreiche Einfluesse wirken "
     "hier auf Dich ein.");
   AddDetail( ({ "erste" }),
     "Dieser Raum hier ist das Erste, dass Du wahrnimmst, seitdem Du "
     "as Wasser der Sinne getrunken hast.");
   AddDetail( ({ "wasser", "wasser der sinne", "sinne" }),
     "Das Wasser der Sinne erweitert Dein Bewusstsein.");
   AddDetail( ({ "bewusstsein" }),
     "Dein Bewusstsein ist vom Wasser der Sinne erweitert worden.");
   AddDetail( ({ "licht" }),
     "Helles Licht scheint von allen Seiten zu kommen und blendet Dich. "
     "Du kannst garnichts richtig erkennen.");
   AddDetail( ({ "seiten" }),
     "Das Licht scheint von ueberall her zu kommen.");
   AddDetail( ({ "farben" }),
     "Blinkende Farben wirken auf Dich ein. Rot, Blau, Gruen, Schwarz, "
     "alles durcheinander. Wenn das hier so weiter geht, drehst Du noch "
     "durch!");
   AddDetail( ({ "rot" }),
     "Halt! Nein, jetzt ist es wieder Blau!");
   AddDetail( ({ "blau" }),
     "Oh! Nein, jetzt ist es wieder Schwarz.");
   AddDetail( ({ "schwarz" }),
     "Nein! Jetzt ist es wieder Gruen.");
   AddDetail( ({ "gruen" }),
     "Hmpf! Jetzt ist es wieder Rot.");
   AddDetail( ({ "lachen" }),
     "Du bist Dir nicht sicher, ein Geraeusch, es klang wie ein Lachen.");
   AddDetail( ({ "geraeusch" }),
     "Ein Lachen, ein Wimmern, ein Schrei, ein Schluchzen, Gebruell, "
     "Du weisst gar nicht, was Du wahrnimmst, es aendert sich alles so "
     "schnell.");
   AddDetail( ({ "wimmern" }),
     "Nein, es hoert sich doch eher an wie Gebruell.");
   AddDetail( ({ "gebruell" }),
     "Lautes Gebruell ist zu hoeren. Es vermischt sich immer mehr mit "
     "einem Schluchzen.");
   AddDetail( ({ "schluchzen" }),
     "Das Schluchzen uebertoent schon fast das Gebruell. Langsam geht es in "
     "ein Wimmern ueber.");
   AddDetail( ({ "schrei" }),
     "Ein Schrei uebertoent alles.");
   AddDetail( ({ "einfluesse" }),
     "Zahlreiche Einfluesse wirken hier auf Dich ein. "
     "Du weisst nicht einmal mehr, was Du wahrnimmst, denn "
     "es aendert sich staendig alles. Du drehst noch durch hier.");
   AddDetail( ({ "gerueche", "fleischgeruch" }),
     "Gerade riecht es nach Fleisch.");
   AddDetail( ({ "fleisch" }),
     "Zwischen den Fleischgeruch mischt sich schon wieder ein anderer "
     "Duft.");
   AddDetail( ({ "duft" }), 
     "Es duerfte nun nach Blumen riechen.");
   AddDetail( ({ "blumen" }),
     "Die duften herrlich.");
   AddDetail( ({ "boden" }),
     "Den Boden kannst Du aufgrund des hellen Lichts nicht so recht "
     "erkennen. Doch fallen Dir sofort blutige, dreckige, saubere und "
     "nasse Fussabdruecke auf.");
   AddDetail( ({ "fussabdruecke" }),
     "Du entdeckst blutige, dreckige, saubere und nasse Fussabdruecke.");
   AddDetail( ({ "blutige fussabdruecke" }),
     "Die blutigen Fussabdruecke fuehren nach Osten.");
   AddDetail( ({ "osten" }),
     "Dahin fuehren die blutigen Fussabdruecke.");
   AddDetail( ({ "dreckige fussabdruecke" }),
     "Die dreckigen Fussabdruecke fuehren nach Suedosten.");
   AddDetail( ({ "suedosten" }),
     "Dahin fuehren die dreckigen Fussabdruecke.");
   AddDetail( ({ "saubere fussabdruecke" }),
     "Die sauberen Fussabdruecke fuehren nach Norden.");
   AddDetail( ({ "norden" }),
     "Dahin fuehren die sauberen Fussabdruecke.");
   AddDetail( ({ "nasse fussabdruecke" }),
     "Die nassen Fussabdruecke fuehren nach Westen.");
   AddDetail( ({ "westen" }),
     "Dahin fuehren die nassen Fussabdruecke.");
   AddDetail( ({ "himmel" }),
     "Du kannst den Himmel wegen dem grellen Licht nicht so "
     "recht erkennen.");

   AddRoomMessage(({
     "Blinkende Farben, ueberall.\n",
     "Rotblinkendes Licht wirkt auf Dich ein.\n",
     "Blaublinkendes Licht wirkt auf Dich ein.\n", 
     "Gruenblinkendes Licht wirkt auf Dich ein.\n", 
     "Schwarzblinkendes Licht wirkt auf Dich ein.\n", 
     "Ein Schrei erfuellt den Raum.\n",
     "Ein Lachen ist zu hoeren.\n",
     "Ein Wimmern laesst Dich erzittern.\n",
     "Gebruell geht Dir durch Mark und Bein.\n",
     "Leises Schluchzen ist zu hoeren.\n",
     "Ploetzlich stinkt es nach Fleisch.\n",
     "Zarter Blumenduft erfuellt den Raum.\n",
     "Grelles Licht blendet Dich.\n",
     "Du drehst noch durch!\n",
     "Du willst um Hilfe rufen.\n",
     "Du willst nur noch weg hier.\n",
     "Du hast Angst.\n",
     "Was sollst Du nur tun?\n",
     "Du zitterst am ganzen Leib.\n",
     "Du moechtest Dich am liebsten irgendwo verkriechen.\n"}), 15);

/*-----------------------GERAEUSCHE GERUECHE-----------------------*/

   AddSmell(DEFAULT_SMELL,
     "Die verschiedensten Gerueche wirken auf Dich ein.\n");
   AddSmell( ({ "gerueche" }),
     "Du riechst Blumen. Halt, nein, ist es vielleicht doch "
     "Fleisch?");
   AddSmell( ({ "blumen", "blumenduft" }),
     "Blumenduft vermischt sich mit Fleischgeruch.");
   AddSmell( ({ "fleisch", "fleischgeruch" }),
     "Fleischgeruch vermischt mit Blumenduft.");
   
   AddSound(DEFAULT_SOUND,
     "Du kannst die verschiedensten Geraeusche hoeren.");
   AddSound( ({ "geraeusche" }),
     "Ein Lachen, Gebruell, ein Wimmern, ein Schrei, ein Schluchzen, "
     "Du weisst gar nicht mehr was Du hoerst.");
   AddSound( ({ "lachen" }),
     "Zwischen den anderen Geraeuschen mischt sich ein Lachen. "
     "Es scheint aus dem Osten zu kommen.");
   AddSound( ({ "osten" }),
     "Ein Lachen scheint aus dem Osten zu kommen. Weiters kann man "
     "dort noch einige Schreie hoeren.");
   AddSound( ({ "gebruell" }),
     "Das Gebruell ist am lautesten von allen Geraeuschen. Es duerfte "
     "aus dem Norden kommen.");
   AddSound( ({ "norden" }),
     "Aus dem Norden scheint das Gebruell zu kommen.");
   AddSound( ({ "wimmern" }),
     "Leises Wimmern kommt aus dem Suedosten.");
   AddSound( ({ "suedosten" }),
     "Aus dem Suedosten scheint das Wimmern zu kommen.");
   AddSound( ({ "schrei", "schrei" }),
     "Laute Schreie scheinen auch aus dem Osten zu kommen.");
   AddSound( ({ "schluchzen" }),
     "Das Schluchzen kommt bestimmt aus dem Westen");
   AddSound( ({ "westen" }),
     "Aus dem Westen kommt das Schluchzen.");

/*---------------------ITEMS CMDS EXITS UND MAPPINGS---------------------*/

   AddCmd( ({ "suedosten", "so" }), "cmd_so");
   AddCmd( ({ "norden", "n" }), "cmd_n");
   AddCmd( ({ "osten", "o" }), "cmd_o");
   AddCmd( ({ "westen", "w" }), "cmd_w");
   
   waehler = ([]);
}

reset()
{
  ::reset();
  waehler = ([]);
}

int cmd_so(string str)
{
  string spieler;
  spieler=getuid(TP);
  notify_fail(BS("Wohin moechtest Du denn gehen?"));
  
  if(present("zauberin", ENV(TP)))
  {
    write(BS("Du kannst nicht Osten gehen, die Gestalt laesst Dich nicht "
    	     "vorbei!"));
    return 1;
  }
  if(!member(waehler, spieler))
  {
    waehler+=([spieler: 0]);
  }
  if(waehler[spieler, 0]>=1)
  {
    write(BS("Mutig folgst Du den dreckigen Fussabdruecken nach "
    	     "Suedosten."));
    TP->move(ROOM("wald.lpc"), M_SILENT);
    return 1;
  }
  else
  {  
    waehler[spieler, 0]++;
    write(BS("Als Du den dreckigen Fussabdruecken nach Sueosten folgen "
    	     "willst, taucht eine Gestalt vor Dir auf und versperrt Dir "
    	     "den Weg."));
    AddItem(NPC("zauberin"), REFRESH_NONE);
    return 1;
  }
}

