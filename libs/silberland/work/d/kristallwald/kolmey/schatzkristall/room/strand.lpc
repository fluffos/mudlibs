inherit "std/room";

#include "../schatzkristall.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <verben.h>

void delayedwrite(object spieler, int curpos, mixed *daten);

int koeder = 1;
int krebs  = 1;
int sonne  = 1;

mapping schatz;
mapping stein;
mapping burg;

create()
{

::create();

/*-----------------------KURZ UND LANGBESCHREIBUNG-----------------------*/

   SetProp(P_INT_SHORT, "In Gedanken auf einem Strand");
   SetProp(P_INT_LONG,
     "Du befindest Dich auf einmal auf einem wunderschoenen, "
     "reinweissen Sandstrand. Das Meer rauscht leise, Moewen "
     "kraehen und vom Himmel brennt die gelbe Sonne. Im Sueden "
     "wird der Strand von dichtem Urwald begrenzt.");
   
/*-----------------------RAUMEIGENSCHAFTEN-----------------------*/
   
   SetProp(P_LIGHT, 3);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 35, ENV_TERRAIN: TT_JUNGLE]) );
   SetProp(P_INDOORS, 0);
   SetProp(P_LOG_FILE, "/d/kristallwald/kolmey/kristall_quest.log");

/*-----------------------RAUMDETAILS-----------------------*/
   
   AddDetail( ({ "sandstrand", "strand" }),
     "Du befindest Dich auf einem wunderschoenen Sandstrand.");
   AddDetail( ({ "meer" }),
     "Gleich vor Dir breitet sich das weite Meer aus und erfreut Dich "
     "mit seinem Anblick. Das Wasser is so klar, dass Du auch noch weit drausen "
     "den Grund erkennen kannst.");
   AddDetail( ({ "anblick" }),
     "Das Meer bietet Dir einen wunderschoenen Anblick. Grosse und kleine "
     "Wellen, lustige Voegel und vereinzelte Fische sind es, die Dich "
     "erfreuen.");
   AddDetail( ({ "wasser" }),
     "Das Wasser ist so klar, sodass Du auch noch weit draussen den Grund "
     "erkennen kannst.");
   AddDetail( ({ "grund" }),
     "Durch das kristallklare Wasser kannst Du den Grund erkennen. "
     "Doch alles was Du siehst ist noch mehr Sand, ein paar Muscheln "
     "und vereinzelte Fische.");
   AddDetail( ({ "wellen" }),
     "Ein paar kleinere Wellen schlagen immer wieder ans Ufer und erzeugen "
     "leises Rauschen. Jedoch weiter draussen jagt eine grosse Welle "
     "die andere.");
   AddDetail( ({ "rauschen" }),
     "Du kannst ihm lauschen.");
   AddDetail( ({ "ufer" }),
     "Am Ufer ueberschlagen sich immer wieder kleiner Wellen und erzeugen "
     "leises Rauschen. Manchmal bringen sie sogar kleine Muscheln und "
     "anderes Getier mit an den Strand.");
   AddDetail( ({ "welle" }),
     "Du beobachtest die grossen Wellen weit draussen. Ha! Schonwieder "
     "eine kleine Wellenjagd.");
   AddDetail( ({ "wellenjagd" }),
     "Weit draussen so scheint es, jagt eine Welle die andere.");
   AddDetail( ({ "muscheln" }),
     "Weit draussen am Grund kannst Du einige Muscheln entdecken. Sie "
     "schillern im Wasser in allen Farben. "
     "Auch die kleinen Wellen tragen ab und zu die eine oder andere Muschel "
     "an den Strand.");
   AddDetail( ({ "farben", "schillern" }),
     "Die Muscheln schillern in allen moeglichen Farben.");
   AddDetail( ({ "muschel" }),
     "Du suchst das Ufer ab, findest aber leider keine Muschel.");
   AddDetail( ({ "fische", "fisch" }),
     "Draussen im Wasser kannst Du vereinzelte Fische sehen. Ach, hier "
     "waere ja ein echtes Angelparadies.");
   AddDetail( ({ "angelparadies", "paradies" }),
     "Hier ist ein wahrhaftes Paradies fuer Angler!");
   AddDetail( ({ "angler" }),
     "Hier ist niemand ausser Dir!");
   AddDetail( ({ "voegel" }),
     "Lustige Voegel fliegen hier herum. Du kannst Moewen und Pelikane "
     "erkennen.");
   AddDetail( ({ "moewen" }),
     "Einige Moewen fliegen hoch ueber Dir herum.");
   AddDetail( ({ "pelikane", "pelikan" }),
     "Einige Pelikane fliegen hoch ueber Dir herum und warten auf "
     "Beute.");
   AddDetail( ({ "beute" }),
     "Die Pelikane warten bestimmt auf Fische um sie dann zu fangen und "
     "zu verspeisen.");
   AddDetail( ({ "getier" }),
     "Manchmal tragen die kleinen Wellen Getier mit auf den Strand, dass "
     "aber sofort wieder ins Wasser fluechtet. Die Tiere, die es nicht "
     "schaffen ins Wasser zurueck zu kehren, verenden hier und "
     "hinterlassen ihre Kadaver.");
   AddDetail( ({ "tiere" }),
     "Die Tiere, die es nicht schaffen ins Wasser zurueck zu kehren, "
     "verenden hier und hinterlassen ihre Kadaver.");
   AddDetail( ({ "kadaver" }),
     "Als Du den Strand nach Kadavern absuchst, entdeckst Du einen "
     "gestrandeten Taschenkrebs und einen Seestern.");
   AddDetail( ({ "taschenkrebs", "krebs" }),
     "Igitt! Der Kadaver eines Taschenkrebses liegt hier am Strand herum. "
     "An seinen Scheren jedoch faellt Dir etwas auf.");
   AddDetail( ({ "scheren" }),
     "Komisch! Es sieht so aus, als wuerde sich etwas unter den Scheren "
     "bewegen!");
   AddDetail( ({ "seestern" }),
     "Ein kleiner vertrockneter Seestern liegt hier am Boden. "
     "Auch er hat es anscheinend nicht rechtzeitig zurueck ins Wasser "
     "geschafft und ist hier verendet.");
   AddDetail( ({ "himmel" }),
     "Ein wolkenloser, blauer Himmel erstreckt sich ueber dem Meer. "
     "Die hoch erhobene Sonne leuchtet von ihm herab.");
   AddDetail( ({ "sonne" }),
     "Die gelbe Sonne sendet vom wolkenlosen Himmel ihre Strahlen und "
     "laesst das Meer funkeln und glitzern.");
   AddDetail( ({ "strahlen", "sonnenstrahlen" }),
     "Die Sonnenstrahlen erwaeremn Deine Haut. Ein Sonnenbad waere hier "
     "echt ein Hit!");
   AddDetail( ({ "haut" }),
     "Noch ist Deine Haut weiss. Nach einem Sonnenbad koennte sich das "
     "aber drastisch veraendern.");
   AddDetail( ({ "sonnenbad", "hit" }),
     "Einfach in den weissen Sand legen und in der Sonne zu baden waere "
     "jetzt ein Hit!");
   AddDetail( ({ "boden" }),
     "Den Boden hier bildet der reinweisse Sand.");
   AddDetail( ({ "sand" }),
     "Du stehst auf dem reinweissen Sand. Er ist von der Sonne ziemlich "
     "aufgewaermt worden. Was man hier wohl alles machen koennte?");
   AddDetail( ({ "urwald" }),
     "Im Sueden wird der Strand von dichtem Urwald begrenzt. Du kannst "
     "dort nichts anderes als lauter Palmen erkennen.");
   AddDetail( ({ "palmen" }),
     "Du kannst nichts ausser Palmen erkennen.");
   AddDetail( ({ "sueden" }),
     "Im Sueden befidnet sich dichter Urwald.");
   AddDetail( ({ "kopf" }),
     "Huch! Einige Moewen fliegen knapp ueber Deinem Kopf hinweg.");
   AddDetail( ({ "rascheln" }),
     "Du koenntest ihm lauschen.");
   AddDetail( ({ "brise", "kuehlung" }),
     "Ab und zu verschafft Dir eine leichte Brise etwas Kuehlung.");
   
   AddRoomMessage( ({
     "Leises Rauschen wird von den Wellen erzeugt.\n",
     "Einige Moewen fliegen dicht ueber Deinem Kopf hinweg.\n",
     "Aus dem Urwald ist leisches Rascheln zu hoeren.\n",
     "Ein Pelikan faengt einen Fisch.\n",
     "Eine leichte Brise verschafft Dir etwas Kuehlung.\n"}), 50);
      
/*-----------------------GERAEUSCHE GERUECHE-----------------------*/

   AddSmell(DEFAULT_SMELL,
     "Es riecht nach Meer.");
   AddSmell( ({ "meer", "geruch" }),
     "Hm der salzige Geruch des Meeres erfuellt Deine Nase.");
   
   AddSound(DEFAULT_SOUND,
     "Ab und zu vernimmst Du neben dem Kraehen der Moewen auch noch "
     "leises Geraschel aus dem Urwald.");
   AddSound( ({ "kraehen", "moewen" }),
     "KARAEH!");
   AddSound( ({ "geraschel", "urwald" }),
     "Vereinzelt hoerst Du leises Geraschel aus dem Urwald, kannst aber "
     "nichts naeheres erkennen.");

/*---------------------ITEMS CMDS EXITS UND MAPPINGS---------------------*/
   
   AddSpecialDetail( ({ "funkeln", "glitzern" }), "glitzern");
   AddSpecialDetail( ({ "piraten" }), "piraten");
   AddSpecialDetail( ({ "palme" }), "palme");
   AddSpecialDetail( ({ "affe" }), "affe");
   AddSpecialDetail( ({ "grimassen", "grimasse" }), "grimasse");
   
   AddCmd( ({ "hebe", "heb" }), "cmd_find");
   AddCmd( ({ "lege", "leg" }), "cmd_rest");
   AddCmd( ({ "bade", "bad" }), "cmd_rest1");
   AddCmd( ({ "grabe", "grab", "buddel", "buddle" }), "cmd_dig");
   AddCmd( ({ "baue", "bau" }), "cmd_built");
   AddCmd( ({ "wirf", "werfe" }), "cmd_throw");
   
   schatz = ([]);
   stein  = ([]);
   burg   = ([]);
}

reset()
{
  ::reset();
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf einmal auf einem wunderschoenen, "
     "reinweissen Sandstrand. Das Meer rauscht leise, Moewen "
     "kraehen und vom Himmel brennt die gelbe Sonne. Im Sueden "
     "wird der Strand von dichtem Urwald begrenzt.");
  RemoveDetail( ({ "sandburg" }) );
  RemoveDetail( ({ "tuerme" }) );
  krebs  = 1;
  sonne  = 1;
  koeder = 1;
  schatz = ([]);
  stein  = ([]);
  burg   = ([]);
}

int cmd_find(string str)
{
  object ob;
  notify_fail(BS("Was moechtest Du denn anheben?"));
  if(!(str == "scheren an" || str == "schere an" ||
       str == "scheren auf" || str == "schere auf"))
  {
    return 0;
  }
  if(!krebs)
  {
    write(BS("Du hebst die Scheren des Taschenkrebses an. "
    	     "Du hast Dich anscheinend getaeuscht. Unter den Scheren "
    	     "war nichts verborgen... War wohl der Wind."));
  }
  else
  {
    write(BS("Du hebst die Scheren an und hattest recht! Unter den "
             "Scheren des Taschenkrebses scheuchst Du einen kleinen "
             "Einsiedlerkrebs auf! Dabei brichst Du dem Krebs die "
             "Schere ab. Du nimmst sie mit."));
    krebs  = 0;
    koeder = 0;
    ob=clone_object(OBJ("koeder"));
    ob->move(TP, M_GET);
    AddItem(NPC("krebs"));
  }
  return 1;
}

int cmd_rest(string str)
{
  notify_fail(BS("Wohin moechtest Du Dich legen?"));
  if(!(str == "auf sand" || str == "auf sand hin" || 
       str == "in sand"))
  {
    return 0;
  }
  if(!sonne)
  {
    write(BS("Du hast doch gerade in der Sonne gebadet! Zu viel "
    	     "Sonnenbaden ist ungesund! Warte lieber noch ein wenig!"));
    return 1;
  } 
   TP->SetProp(P_PARALYZED, ([ PARALYZE_TIME: 5,
      PARALYZE_MSG:"Du nimmst gerade ein Sonnenbad.\n",
      PARALYZE_MSG_OTHER:"",
      PARALYZE_END:"",
      PARALYZE_END_OTHER:"" ]));
   delayedwrite(TP, 0, ({
     2, "Du legst Dich in den Sand und nimmst ein Sonnenbad.",
     4, "Entspannt schliesst Du Die Augen.",
     2, "Du geniesst das Sonnenbad in allen seinen Zuegen.",
     2, "#Nach einiger Zeit oeffnest Du Deine Augen wieder und "
        "bemerkst, dass sich Deine Haut braun geworden ist.",
     0, "@@haut@@"}));
     return 1;
}

int cmd_rest1(string str)
{
  notify_fail(BS("Was moechtest Du denn machen?"));
  if(!(str == "in sonne"))
  {
    return 0;
  }
  if(!sonne)
  {
    write(BS("Du hast doch gerade in der Sonne gebadet! Zu viel "
    	     "Sonnenbaden ist ungesund! Warte lieber noch ein wenig!"));
    return 1;
  }  
   TP->SetProp(P_PARALYZED, ([ PARALYZE_TIME: 5,
      PARALYZE_MSG:"Du nimmst gerade ein Sonnenbad.\n",
      PARALYZE_MSG_OTHER:"",
      PARALYZE_END:"",
      PARALYZE_END_OTHER:"" ]));
   delayedwrite(TP, 0, ({
     2, "Du legst Dich in den Sand und nimmst ein Sonnenbad.",
     4, "Entspannt schliesst Du Die Augen.",
     2, "Du geniesst das Sonnenbad in allen seinen Zuegen.",
     2, "#Nach einiger Zeit oeffnest Du Deine Augen wieder und "
        "bemerkst, dass sich Deine Haut braun geworden ist.",
     0, "@@haut@@"}));
   return 1;
}

string haut()
{
  TP->SetProp(P_PRESAY, "Sonnengebraeunter");
  sonne = 0;
  return "";
}

int cmd_dig(string str)
{
  object ob;
  string spieler;
  spieler=getuid(TP);
  notify_fail(BS("Worin moechtest Du denn graben?"));
  if(!(str == "in sand" || str == "sand" || str == "in sand herum"))
  {
    return 0;
  }
  if(!member(schatz, spieler))
  {
    schatz+=([spieler: 0]);
  }
  if(schatz[spieler, 0]<=0)
  {
    schatz[spieler, 0]++;
    write(BS("Du buddelst ein wenig im Sand herum. Und siehe da! Du "
    	     "findest einen vergrabenen Schatz! Vielleicht haben den "
    	     "ja mal Piraten hier verbuddelt?"));
    TP->AddMoney(3204);
    return 1;
  }
  if(schatz[spieler, 0]>=1 && stein[spieler, 0]<=0 
    && !present(QUESTSTEIN, TP))
  {
    stein[spieler, 0]++;
    write(BS("Gierig graebst Du noch einmal im Sand herum, in der "
    	     "Hoffnung, noch einen weiteren Schatz zu finden. Doch leider "
    	     "wird Deine Gier nicht gestillt. Du findest lediglich "
    	     "einen kleinen Stein."));
    ob=clone_object(OBJ("stein"));
    ob->move(TP, M_GET);
    return 1;
  }
  else
  {
    write(BS("Gierig graebst Du noch einmal im Sand herum, findest aber "
    	     "leider nichts mehr. Tja, wer vergreaebt schon zwei Schaeetze "
    	     "an einem Ort?"));
    return 1;
  }
}

int cmd_built(string str)
{
  string spieler;
  spieler=getuid(TP);
  notify_fail(BS("Was moechtest Du denn bauen?"));
  if(!(str == "sandburg" || str == "burg"))
  {
    return 0;
  }
  if(!member(burg, spieler))
  {
    burg+=([spieler: 0]);
  }
  if(burg[spieler, 0]>=1)
  {
    write(BS("Aber da steht doch schon eine grosse Burg von Dir!"));
    return 1;
  }
    burg[spieler, 0]++;
    TP->SetProp(P_PARALYZED, ([ PARALYZE_TIME: 4,
      PARALYZE_MSG:"Du baust gerade eine Sandburg.\n",
      PARALYZE_MSG_OTHER:"",
      PARALYZE_END:"",
      PARALYZE_END_OTHER:"" ]));
   delayedwrite(TP, 0, ({
     0, "Vergnuegt wirfst Du Dich in den Sand.",
     2, "#Schnell haeufst Du etwas nassen Sand an und beginnst mit "
     	"blossen Haenden ein Loch zu graben.",
     2, "#Als Du so graebst findest Du einen Ast, auf dem eine Schnur "
     	"befestigt ist. Du steckst den Ast ein und baust weiter.",
     0, "@@ast@@",
     2, "#Du reihst den Sand rund um das Loch auf und glaettest "
     	"ihn.",
     2, "#Du baust und baust. Und nach einiger Zeit betrachtest Du "
     	"Dein Werk.",
     0, "@@sandburg@@"}));
   return 1;
}

string ast()
{
  object ob;
  ob=clone_object(OBJ("angel"));
  ob->move(TP, M_GET);
  return "";
}

string sandburg()
{
  TO->SetProp(P_INT_LONG, TO->QueryProp(P_INT_LONG)+ TPN+" hat hier "
    "eine riesige Sandburg errichtet.");
  AddDetail( ({ "sandburg" }),
    "Eine grosse Sandburg mit vier Tuermen steht hier.");
  AddDetail( ({ "tuerme" }),
    "Vier hohe Tuerme befinden sich auf der Sandburg.");
  return "";
}

string glitzern()
{
  if(!present("krebs", ENV(TP)))
  {
  return BS("Die Sonnenstrahlen lassen das Meer funkeln und "
  	    "glitzern.");
  }
  else
  {
  return BS("Durch das Haus des Krebses werden die Sonnenstrahlen "
  	    "reflektiert und zeigen verdaechtig auf eine Palme "
  	    "im Urwald.");
  }
}

string palme()
{
  if(!present("krebs", ENV(TP)))
  {
  return BS("Du kannst nichts ausser Palmen erkennen.");
  }
  else
  {
  return BS("Ja! Jetzt wo ein paar Sonnenstrahlen direkt auf die "
  	    "Palme zeigen, endeckst Du dort einen Affen!");
  }
}

string affe()
{
  if(!present("krebs", ENV(TP)))
  {
  return BS("Sowas siehst Du da nicht!");
  }
  else
  {
  return BS("Der Affe scheint Dich zu beobachten und schneidet "
  	    "Dir Grimassen! Pah! Am liebsten wuerdest Du ihn "
  	    "mit etwas abwerfen!");
  }
}

string grimasse()
{
  if(!present("krebs", ENV(TP)))
  {
  return BS("Sowas siehst Du da nicht!");
  }
  else
  {
  return BS("Hat man sowas schon gesehen? Der dumme Affe hockt "
  	    "auf seiner Palme und schneidet Dir Grimassen!");
  }
}

string piraten()
{
  string spieler;
  spieler=getuid(TP);
  if(!member(schatz, spieler))
  {
  return BS("Sowas siehst Du da nicht!");
  }
  else
  {
  return BS("Vielleicht haben die Piraten hier noch einen Schatz vergraben? "
  	    "Dem solltest Du besser nachgehen!");
  }
}

int cmd_throw(string str)
{
  object ob;
  notify_fail(BS("Was moechtest Du auf wen werfen?"));
  if(!(str == "stein auf affe" || str == "stein auf affen" ||
       str == "stein nach affe" || str == "stein nach affen"))
  {
    return 0;
  }
  if(!present("krebs", ENV(TP)))
  {
    write(BS("Wie bitte?"));
    return 1;
  }
  if(!present(QUESTSTEIN, TP))
  {
    write(BS("Aber Du hast doch gar keinen Stein!"));
    return 1;
  }
  else
  {
    TP->SetProp(P_PARALYZED, ([ PARALYZE_TIME: 4,
      PARALYZE_MSG:"",
      PARALYZE_MSG_OTHER:"",
      PARALYZE_END:"",
      PARALYZE_END_OTHER:"" ]));
   delayedwrite(TP, 0, ({
     0, "Wuetend wirfst Du den Stein nach dem Affen.",
     2, "#Leider triffst Du ihn nur am Bein.",
     2, "#Der Affe heult kurz auf und sucht erbost etwas um nach Dir "
     	"zu werfen.",
     4, "#Schnell pflueckt er eine Kokosnuss und schleudert sie in "
     	"Deine Richtung.",
     2, "#Du haettest es ahnen koennen, so trifft Dich der Affe direkt "
     	"am Kopf. Bewusstlos brichst Du nieder."}));
   return 1;
  }
}
  
void delayedwrite(object spieler, int curpos, mixed *daten)
{
  string output;
  if (!spieler) return;
  
  output = process_string(daten[curpos+1]);
  if (output[0] == 35) {
    tell_object(spieler, "\n");
    tell_object(spieler, BS(output[1..]));
  } else {
    tell_object(spieler, BS(output));
  }
  if (curpos + 2 < sizeof(daten))
    call_out("delayedwrite", daten[curpos+2], spieler, curpos+2, daten);
}
     
   
   
     
   