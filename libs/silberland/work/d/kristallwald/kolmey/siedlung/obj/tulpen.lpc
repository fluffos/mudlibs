inherit "std/thing";

#include <properties.h>
#include "../siedlung.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Strauss aus Tulpen");
  SetProp(P_LONG, 
    "Dies ist ein wunderschoener Blumenstrauss aus Tulpen. "
    "Den solltest jemand besonderem schenken!");
  SetProp(P_NAME, "Tulpenstrauss");
  SetProp(P_GENDER, MALE);
  AddId( ({"strauss", "tulpenstrauss", "blumenstrauss"}) );
  
  AddDetail( ({ "tulpen", "tulpe" }),
    "Wunderschoene, rote Tulpen wurden fuer den Strauss verwendet.");

  SetProp(P_VALUE, 500);
  SetProp(P_WEIGHT, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, ([MAT_PLANT: 100]));
  SetProp(P_SMELL, "Die Tulpen duften herrlich.");
}