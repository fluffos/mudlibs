/* 
** Die Artilas Pflanze                                 14.01.2002 Kolmey@SL
** Heilt Vergiftungen bis zu einem grad von 3, saettigt 
** dafuer etwas
** Update              Version   Comments
** ------------------------------------------------------------------------
** 0000-00-00            1.0     Release
** 2002-06-09		 1.1	 Name von Koenigskraut auf Artilas Pflanze
**				 geaendert. Vergiftung auf -3 beschraenkt
**				 und remove nach 5-8 resets eingebaut.
**
*/

inherit "std/food";

#pragma strong_types;
#include "../siedlung.h"
#include <properties.h>
#include <food.h>
#include <language.h>

nosave int alter;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Die Artilas Pflanze");
  SetProp(P_LONG,
    "Das ist ein Blatt der seltenen Artilas Pflanze. Angeblich ist es "
    "ziemlich selten und sehr begehrt, da man damit Vergiftungen "
    "heilen kann!");
  SetProp(P_NAME, "Artilas Pflanze");
  AddId( ({ "artilas", "artilas pflanze" }) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1000);
  SetProp(P_FOOD_INFO, ([F_HEAL : ({1, 1}), 
  			 F_SOAK : 20, 
  			 F_POISON: -3]));
  
  alter=5;
}

void BeimEssen()
{
  write(BS("Mit verzerrtem Gesicht wuergst Du die Artilas Pflanze runter. "
  	   "Du fuehlst Dich besser!"));
  tell_room(ENV(TP), TPN+" wuergt mit verzerrtem Gesicht ein seltsames "
  			 "Kraut hinunter.\n", ({TP}));
}

void reset()
{
  ::reset();
  
  alter--;
  
  if(alter <= 0)
  {
    if(MENV && interactive(MENV))
      tell_object(MENV, BS("Die Artilas Pflanze scheint nun "
        		   "endgueltig verwelkt zu sein und hat ihre "
        		   "Heilwirkung verloren. Du wirfst sie weg."));
    call_out("remove",0);
  }
}
