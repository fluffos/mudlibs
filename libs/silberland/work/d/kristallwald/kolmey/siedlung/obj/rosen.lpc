inherit "std/thing";

#include <properties.h>
#include "../siedlung.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Strauss aus Rosen");
  SetProp(P_LONG, 
    "Dies ist ein wunderschoener Blumenstrauss aus Rosen. "
    "Den solltest jemand besonderem schenken!");
  SetProp(P_NAME, "Rosenstrauss");
  SetProp(P_GENDER, MALE);
  AddId( ({"strauss", "rosenstrauss"}) );
  
  AddDetail( ({ "rosen", "rose" }),
    "Der Strauss wurde aus roten, langstiehligen Rosen gebunden.");
  
  SetProp(P_VALUE, 500);
  SetProp(P_WEIGHT, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, ([MAT_PLANT: 100]));
  SetProp(P_SMELL, "Die Rosen haben einen traumhaften Geruch.");
}