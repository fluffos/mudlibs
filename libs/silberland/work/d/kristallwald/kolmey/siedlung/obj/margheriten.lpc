inherit "std/thing";

#include <properties.h>
#include "../siedlung.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Strauss aus Margheriten");
  SetProp(P_LONG, 
    "Dies ist ein wunderschoener Blumenstrauss aus Margheriten. "
    "Den solltest jemand besonderem schenken!");
  SetProp(P_NAME, "Margheritenstrauss");
  SetProp(P_GENDER, MALE);
  AddId( ({"strauss", "feilchenstrauss", "blumenstrauss"}) );
  
  AddDetail( ({ "margheriten" }),
    "Die Margheriten mit ihrer dottergelben Bluetenmitte und den "
    "den schneeweissen Bluetenblaettern sehen wunderschoen aus.");
  AddDetail( ({ "bluetenmitte" }),
    "Die Bluetenmitte der Margheriten ist dottergelb.");
  AddDetail( ({ "bluetenblaetter" }),
    "Schneeweisse Bluetenblaetter zieren die Margheriten.");
  
  SetProp(P_VALUE, 500);
  SetProp(P_WEIGHT, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, ([MAT_PLANT: 100]));
  SetProp(P_SMELL, "Der Duft der Margheriten ist sehr dezent.");
}