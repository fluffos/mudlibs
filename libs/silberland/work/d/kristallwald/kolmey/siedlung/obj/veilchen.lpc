inherit "std/thing";

#include <properties.h>
#include "../siedlung.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Strauss aus Veilchen");
  SetProp(P_LONG, 
    "Dies ist ein wunderschoener Blumenstrauss aus Veilchen. "
    "Den solltest jemand besonderem schenken!");
  SetProp(P_NAME, "Veilchenstrauss");
  SetProp(P_GENDER, MALE);
  AddId( ({"strauss", "veilchenstrauss", "blumenstrauss"}) );
  
  AddDetail( ({ "veilchen" }),
    "Zarte, violette Veilchen wurden fuer den Strauss verwendet.");
  
  SetProp(P_VALUE, 500);
  SetProp(P_WEIGHT, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, ([MAT_PLANT: 100]));
  SetProp(P_SMELL, "Die Veilchen duften suess.");
}