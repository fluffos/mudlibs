inherit "/d/kristallwald/kolmey/siedlung/npc/std_woodelf.lpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../siedlung.h"

#define WMASTER "/d/kristallwald/kolmey/siedlung/npc/woodelf_master"

void init()
{
  ::init();
  if(WMASTER->IsEnemy(TP))
    Kill(TP);
}

create()
{
  if (!is_clone(this_object())) return;

  ::create();
  AddId( ({WALDELF, "waldelfe", "elfe", "waldelfenwaechterin", 
           "waechterin"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Waldelfenwaechterin");
  SetProp(P_SHORT, "Eine Waldelfenwaechterin");
  SetProp(P_LONG, 
    "Diese Waldelfenwaechterin sorgt im Dorf fuer Ruhe und Ordnung. "
    "Durch ihr langes, blondes Haar schimmern ihre blauen Augen "
    "hindurch, ja es scheint, sie fixiert Dich mit ihrem Blick und "
    "beobachtet Dich genau. Mit ihren Ohren nimmt sie jedes auch nur "
    "geringe Geraeusch wahr. Diese Waldelfenwaechterin sieht ziemlich zaeh "
    "aus und es waere bestimmt nicht ratsam hier im Dorf Randale zu "
    "machen.");
  set_living_name("waldelfenwaechterin");
  
  SetProp(P_DIE_MSG, " stirbt unter Deinem letzten Schlag.\n");
  SetProp(P_KILL_NAME, TO->QP(P_SHORT));
  SetProp(P_KILL_MSG, "Naechstes mal laesst Du Deine Agressionen besser "
  		      "wo anders aus!");
  
  SetProp(P_MSGIN, "kommt herein um nach dem Rechten zu sehen");
  SetProp(P_MSGOUT, "geht# um dort nach dem Rechten zu sehen");
  SetProp(P_MMSGIN, "erscheint um nach dem Rechten zu sehen");
  SetProp(P_MMSGOUT, "zueckt ihren Stab und verschwindet");
  
  AddDetail( ({ "ohren" }),
    "Mit ihren Ohren scheint sie jedes auch nur geringe Geraeusch "
    "wahrnehmen zu koennen.");
  AddDetail( ({ "blick" }),
    "Sie scheint Dich mit ihrem Blick zu fixieren und zu beobachten.");
  AddDetail( ({ "augen" }),
    "Ihre blauen Augen leuchten durch das Haar hindurch und scheinen "
    "Dich zu fixieren.");
  AddDetail( ({ "haar", "haare" }),
    "Die Waldelfenwaechterin hat langes, blondes, glattes Haar.");
  AddDetail( ({ "ruhe", "ordnung" }),
    "Diese Waldelfenwaechterin sorgt hier fuer Ruhe und Ordnung. "
    "Und wie man sieht mit grossem Erfolg.");
  AddDetail( ({ "erfolg" }),
    "Na, im Dorf herrscht Ruhe und Ordnung.");
  AddDetail( ({ "kampferfahrung" }),
    "Hm, nein, Du willst es garnicht erst genauer wissen.");
  AddDetail( ({ "randale" }),
    "Wenn Du die friedlichen Buerger oder die Wachen selbst nicht in Ruhe "
    "laesst, bekommst Du sicherlich Aerger.");
  AddDetail( ({ "aerger" }),
    "Das wirst Du dann schon sehen!");
  
  create_default_woodelf(25+random(10));
  

  SUID;
   
   if(random(100) < 20 ) CLONEME("/p/armour/sandalen");
   if(random(100) < 20 ) CLONEME("/p/armour/armour/lederpanzer");
   if(random(100) < 90 ) CLONEME
     ("/d/kristallwald/sargola/dorf/armour/armschienen");
   if(random(100) < 90 ) CLONEME
     ("/d/kristallwald/sargola/dorf/armour/ring");
   CLONEME("/d/kristallwald/kolmey/siedlung/armour/robe");
   CLONEME("/p/weapon/club/kampfstab");
   command("zuecke stab");
   command("ziehe alles an");
   
   AddSpell(3, 500+random(100),
     "Die Waldelfenwaechterin sticht Dir ihren Stab in den Bauch.\n",
     "Die Waldelfenwaechterin sticht @WEM ihren Stab in den Bauch.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]) );

   WMASTER->add_woodelf();
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  WMASTER->ruf_um_hilfe(enemy);
  ::Defend(dam, dam_type, spell, enemy);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  WMASTER->Sieg(player);
}

remove(int arg)
{
  WMASTER->remove_woodelf(this_object());
  ::remove(arg);
}