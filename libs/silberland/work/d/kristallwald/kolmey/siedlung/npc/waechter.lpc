inherit "/d/kristallwald/kolmey/siedlung/npc/std_woodelf.lpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../siedlung.h"

#define WMASTER "/d/kristallwald/kolmey/siedlung/npc/woodelf_master"

void init()
{
  ::init();
  if(WMASTER->IsEnemy(TP))
    Kill(TP);
}

create()
{
  if (!is_clone(this_object())) return;

  ::create();
  AddId( ({WALDELF, "waldelf", "elf", "waldelfenwaechter", "waechter"}) );
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Waldelfenwaechter");
  SetProp(P_SHORT, "Ein Waldelfenwaechter");
  SetProp(P_LONG, 
    "Dieser Waldelfenwaechter sorgt im Dorf fuer Ruhe und Ordnung. "
    "Durch sein langes, schwarzes Haar schimmern seine blauen Augen "
    "hindurch, ja es scheint, er fixiert Dich mit seinem Blick und "
    "beobachtet Dich genau. Mit seinen Ohren nimmt er jedes auch nur "
    "geringe Geraeusch wahr. Dieser Waldelfenwaechter sieht ziemlich zaeh "
    "aus und es waere bestimmt nicht ratsam hier im Dorf Randale zu "
    "machen.");
  set_living_name("waldelfenwaechter");
  
  SetProp(P_DIE_MSG, " stirbt unter Deinem letzten Schlag.\n");
  SetProp(P_KILL_MSG, "Das wird Dich lehren in unserem Dorf keine "
   		      "Randale zu machen!");
  
  SetProp(P_MSGIN, "kommt herein um nach dem Rechten zu sehen");
  SetProp(P_MSGOUT, "geht# um dort nach dem Rechten zu sehen");
  SetProp(P_MMSGIN, "erscheint um nach dem Rechten zu sehen");
  SetProp(P_MMSGOUT, "zueckt sein Schwert und verschwindet");
  
  AddDetail( ({ "ohren" }),
    "Mit seinen Ohren scheint er jedes auch nur geringe Geraeusch "
    "wahrnehmen zu koennen.");
  AddDetail( ({ "blick" }),
    "Er scheint Dich mit seinem Blick zu fixieren und zu beobachten.");
  AddDetail( ({ "augen" }),
    "Seine blauen Augen leuchten durch das Haar hindurch und scheinen "
    "Dich zu fixieren.");
  AddDetail( ({ "haar", "haare" }),
    "Der Waldelfenwaechter hat langes, schwarzes, glattes Haar.");
  AddDetail( ({ "ruhe", "ordnung" }),
    "Dieser Waldelfenwaechter sorgt hier fuer Ruhe und Ordnung. "
    "Und wie man sieht mit grossem Erfolg.");
  AddDetail( ({ "erfolg" }),
    "Na, im Dorf herrscht Ruhe und Ordnung.");
  AddDetail( ({ "randale" }),
    "Wenn Du die friedlichen Buerger oder die Wachen selbst nicht in Ruhe "
    "laesst, bekommst Du sicherlich Aerger.");
  AddDetail( ({ "aerger" }),
    "Das wirst Du dann schon sehen!");
  
  create_default_woodelf(25+random(10));
  

  SUID;
   
   if(random(100) < 20 ) CLONEME("/p/armour/sandalen");
   if(random(100) < 20 ) CLONEME("/p/armour/armour/lederpanzer");
   if(random(100) < 90 ) CLONEME
     ("/d/kristallwald/sargola/dorf/armour/armschienen");
   if(random(100) < 90 ) CLONEME
     ("/d/kristallwald/sargola/dorf/armour/ring");
   CLONEME("/d/kristallwald/kolmey/siedlung/armour/robe");
   CLONEME("/p/weapon/sword/holzschwert");
   CLONEME("/p/armour/shield/holzschild");
   command("zuecke schwert");
   command("ziehe alles an");
   
   AddSpell(3, 500+random(100),
     "Der Waldelfenwaechter rammt Dir seinen Schild in den Bauch.\n",
     "Der Waldelfenwaechter rammt @WEM seinen Schild in den Bauch.\n",
    DT_SQUEEZE, ([SP_SHOW_DAMAGE: 1]) );

  WMASTER->add_woodelf();
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  WMASTER->ruf_um_hilfe(enemy);
  ::Defend(dam, dam_type, spell, enemy);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  WMASTER->Sieg(player);
}

remove(int arg)
{
  WMASTER->remove_woodelf(this_object());
  ::remove(arg);
}