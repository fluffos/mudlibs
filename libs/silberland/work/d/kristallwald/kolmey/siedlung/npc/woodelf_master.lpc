object *waldelfen;
object *feinde;

#include <properties.h>
#include <language.h>
#include "../def.h"

#define KILLLOG "/d/kristallwald/kolmey/siedlung/kill.log"

create()
{
  if(is_clone(TO)) return 0;
  waldelfen = ({});
  feinde = ({});
}

add_woodelf()
{
  waldelfen += ({previous_object()});
}

ruf_um_hilfe(object spieler)
{
  int u;
  if(member(feinde, spieler)==-1)
  {
    feinde+=({spieler});
    domainshout("Ein Waldelfenwaechter ruft: Zu den Waffen! "
    ""+spieler->Name()+" greift uns an!\n", 
    "kristallwald/kolmey/siedlung/room", 1);
  }
}

remove_woodelf()
{
  waldelfen -= ({previous_object()});
}

void reset()
{
  feinde=({});
}

void Sieg(object player)
{
  domainshout("Ein Waldelfenwaechter ruft: Wir haben "+player->Name()+" "
    "besiegt!\n");
  write_file(KILLLOG,
    ctime()+": Ein Waldelfenwaechter hat gerade "+CAP(getuid(player))+" "
      "umgebracht.\n");
  feinde-=({player});
}

int IsEnemy(object enemy)
{
  if(member(feinde, enemy)!=-1 )
    return 1;
  else
    return 0;
}