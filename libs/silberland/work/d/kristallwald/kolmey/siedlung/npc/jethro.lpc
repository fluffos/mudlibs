inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <wizlevels.h>
#include <new_skills.h>
#include "../siedlung.h"

#define KILLLOG "/d/kristallwald/kolmey/siedlung/kill.log"

#define MAGIERNAME "kolmey"

create()
{

  if (!is_clone(this_object())) return;  
  ::create();
   
   set_living_name("jethro");
   AddId(({ "jethro", "waldelf", "meister", "waffenmeister" }));
   SetProp(P_NAME, "Jethro");
   SetProp(P_SHORT, "Jethro, der Waffenmeister");
   SetProp(P_GENDER, MALE);
   SetProp(P_ARTICLE, 0);
   SetProp(P_LONG,
     "Das ist Jethro. Er ist sogar fuer einen Elf ziemlich gross. "
     "Er ist ein grosser Elf, von erstaunlich robuster und muskoloesen "
     "Statur. Seine langen, glatten schwarzen Haare haengen etwas ins "
     "Gesicht hinein, seine gruenen Augen leuchten dennoch hervor. "
     "Das wenige was Du von seinem Gesicht erkennen kannst laesst Dich "
     "darauf schliessen, dass Jethro nicht zu unrecht auch 'Waffenmeister' "
     "genannt wird. In seinem Gesicht steht die Kampferfahrung foermlich "
     "geschrieben. Dennoch macht er einen sanften Eindruck. Ein Kampf mit "
     "ihm sollte dennoch gut ueberlgt sein.");
   SetProp(P_RACE, "Elf");
   SetProp(P_LOG_INFO, "/kolmey/jethro_info.log");
   
   create_default_npc(51);
   SetProp(P_ALIGN, 800);
   SetProp(P_MAX_HANDS, 2);
   SetProp(P_HANDS, ({" mit starken Elfenhaenden", 400, DT_BLUDGEON }) );
   SetProp(P_SIZE, 200);
   SetProp(P_NOATTACK, 0);
   SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.3, DT_COLD:      0.4, DT_WATER:       0.0
     , DT_AIR:       0.1, DT_LIGHTNING: 0.5, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:     -0.5, DT_UNHOLY:    0.5, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.2, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.3]));
   
   SUID;
   CLONEME("/d/dschungel/feyaria/tijara/armour/rueckengehaenge");
   if(random(100) < 20 ) CLONEME( "/p/armour/bracers/mithrilarmschienen");
   if(random(100) < 30 ) CLONEME( "/p/armour/armour/mithrilpanzer");
   if(random(100) < 30 ) CLONEME( "/p/armour/helm/mithrilhelm");
   if(random(100) < 50 ) CLONEME("/d/ebene/lamuerte/burg/obj/kettenhose");
   if(random(100) < 30 ) CLONEME("/p/armour/gloves/panzerhandschuhe");
   if(random(100) < 30 ) CLONEME("d/wasser/stahldorn/knarkh/obj/zahnschutz");
   if(random(100) < 15 ) 
     CLONEME("d/huegelland/zordan/fischerweg/armour/mithrilguertel");
   if(random(100) < 5 ) CLONEME(WEAPON("elfenrache"));
   if(random(100) < 5 ) CLONEME(WEAPON("elfentanz"));
   command("trage alles");
   command("steck axt in gehaenge");
   command("steck schwert in gehaenge");
   
   SetProp(P_SPELLRATE, 50);
   
   SetProp (P_MSGIN, "kommt herein");
   SetProp (P_MSGOUT, "geht #");
   SetProp (P_MMSGIN, "erscheint mit gezueckter Waffe");
   SetProp (P_MMSGOUT, "steckt die Waffe ins Gehaenge und verschwindet");
   
   SetProp(P_DIE_MSG, " bricht tod nieder.\n");
   SetProp(P_KILL_NAME, "Jethro, der Waffenmeister");
   SetProp(P_KILL_MSG, "Ha! Sollte das alles sein?");
   SetProp(P_MURDER_MSG, ({
      "Ich schaerfe schon meine Axt, %s!",
      "%s , naechstes mal lasse ich Dich nicht so leicht "
      "davon!"})[random(2)]);
   
   SetChats(3, ({
    "Jethro lehnt sich auf sein Schwert.\n",
    "Jethro laesst eine Axt pruefend durch die Luft sausen.\n",
    "Jethro ueberpueft den Halt seiner Ruestung.\n",
    "Jethro seufzt: Ach waren das Zeiten...\n"
   }) );
   
   SetAttackChats(8, ({
    "Jethro scheint sich auf den Kampf zu konzentrieren.\n",
    "Jethro kraeftigt seinen Willen.\n",
    "Jethro spielt sich mit Dir.\n",
   }) );
   
   AddLibrary("/d/kristallwald/kolmey/siedlung/npc/waffen.lib",1);
   AddLibrary("/d/kristallwald/kolmey/siedlung/npc/leben.lib",1);
   
   AddInfo(DEFAULT_INFO, ({
    "sagt: Nein, darueber weiss ich nichts.\n",
    "sagt: Aha, achso, sehr interessant!\n",
    "schaut Dich fragend an.\n",
    "kratzt sich am Kopf.\n"}) );
    
   AddSpell(5, 1,
    "Jethro untersucht seine Axt.\n",
    "Jethro untersucht seine Axt.\n",
    DT_MAGIC, "axe_spell1");
   
   
   AddSpell(7, 1,
    "Jethro untersucht sein Schwert.\n",
    "Jethro untersucht sein Schwert.\n",
    DT_MAGIC, "sword_spell1");
   
   
   AddSpell(8, 1,
    "Jethro untersucht sein Schwert.\n",
    "Jethro untersucht sein Schwert.\n",
    DT_MAGIC, "sword_spell2");
    
    
   AddSpell(5, 1,
    "Jethro untersucht sein Schwert.\n",
    "Jethro untersucht sein Schwert.\n",
    DT_MAGIC, "sword_spell3");
   
   
   AddSpell(10, 1,
    "Jethro untersucht seinen Bogen.\n",
    "Jethro untersucht seinen Bogen.\n",
    DT_MAGIC, "bow_spell1");
   
   
   AddSpell(10, 1,
    "Jethro untersucht seinen Bogen.\n",
    "Jethro untersucht seinen Bogen.\n",
    DT_MAGIC, "bow_spell2");
    
   
   AddSpell(10, 1,
    "Jethro untersucht seinen Bogen.\n",
    "Jethro untersucht seinen Bogen.\n",
    DT_MAGIC, "bow_spell3");
   
   
   AddSpell(5, 1,
    "Jethro untersucht seinen Bogen.\n",
    "Jethro untersucht seinen Bogen.\n",
    DT_MAGIC, "bow_spell4");
   
   
   AddSpell(5, 1,
    "Jethro untersucht seinen Bogen.\n",
    "Jethro untersucht seinen Bogen.\n",
    DT_MAGIC, "bow_spell5");
   
   
   AddDefaultSpell(10, 1, DS_DISARM,
     "Jethro verletzt Deine Waffenhand.\n",
     "Jethro verletzt @WEN's Waffenhand.\n");
   
   
   AddDefaultSpell(10, 1, DS_MASS_FEAR,
     "Jethro wuetet wie ein Wilder und schuechtert Dich ein.\n",
     "Jethro wuetet wie ein Wilder und schuechtert Dich ein.\n");
   
   
   AddDefaultSpell(10, 10, DS_MASS_DEAF,
     "Jethro bruellt Dich an.\n",
     "Jethro bruellt Dich an.\n");
   
   
   AddDefaultSpell(5, 1, DS_FROG,
     "Jethro konzentriert sich. Ploetzlich wirst Du von einem gruenen "
     "umgeben und quakst.\n",
     "Jethro konzentriert sich. Ploetzlich wird @WER von einem gruenen "
     "Schimmer umgeben und beginnt zu quaken.\n");
}

void axe_spell1(object enemy, int damage, mixed dam_type)
{
   object waffe;
   waffe = ME->QueryProp(P_WEAPON);
   
   if(!present("langaxt", ME)) CLONEME("/p/weapon/axe/langaxt");
   
   if((!waffe) || (!waffe->id("langaxt"))) command_me("zuecke axt");
   
   tell_object(enemy,
      "Jethro spaltet Dich mit seiner Axt.\n");
   tell_room(ENV(enemy), BS("Jethro spaltet "+enemy->Name(WER, 2)+" mit seiner "
   		      "Axt."), ({enemy}));
   enemy->Defend(400, ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE: 1]));
}

void sword_spell1(object enemy, int damage, mixed dam_type)
{
   object waffe;
   waffe = ME->QueryProp(P_WEAPON);
   
   if(!present("mithrilschwert", ME)) 
     CLONEME("/d/ebene/obj/waffe/mithrilschwert");
   
   if((!waffe) || (!waffe->id("mithrilschwert"))) command_me("zuecke schwert");
   
   tell_object(enemy, BS("Jethro sticht mit seinem Schwert auf Dich ein."));
   tell_room(ENV(enemy), BS("Jethro sticht mit seinem Schwert "
   			    "auf "+enemy->Name(WER, 2)+" ein."), ({enemy}));
   enemy->Defend(300, ({DT_PIERCE}), ([SP_SHOW_DAMAGE: 1]));
}

void sword_spell2(object enemy, int damage, mixed dam_type)
{
   object waffe;
   waffe = ME->QueryProp(P_WEAPON);
   
   if(!present("mithrilschwert", ME)) 
     CLONEME("/d/ebene/obj/waffe/mithrilschwert");
   
   if((!waffe) || (!waffe->id("mithrilschwert"))) command_me("zuecke schwert");
   
   tell_object(enemy, BS("Jethro pariert Deine Attacken mit seinem "
   			 "Schwert."));
   tell_room(ENV(enemy), BS("Jethro pariert "+enemy->Name(WER, 2)+"'s "
   			    "Attacken mit seinem Schwert."), ({enemy}));
   enemy->AddProp(P_DISABLE_ATTACK, 2+random(3));
}

void sword_spell3(object enemy, int damage, mixed dam_type)
{
   object waffe;
   waffe = ME->QueryProp(P_WEAPON);
   
   if(!present("mithrilschwert", ME)) 
     CLONEME("/d/ebene/obj/waffe/mithrilschwert");
   
   if((!waffe) || (!waffe->id("mithrilschwert"))) command_me("zuecke schwert");
   
   tell_object(enemy, BS("Jethro rammt Dir sein Schwert in den Bauch."));
   tell_room(ENV(enemy), BS("Jethro rammt "+enemy->Name(WER, 2)+" sein "
   			    "sein Schwert in den Bauch."), ({enemy}));
   enemy->Defend(400, ({DT_PIERCE}), ([SP_SHOW_DAMAGE: 1]));
}

void bow_spell1(object enemy, int damage, mixed dam_type)
{
   object waffe;
   
   waffe = ME->QueryProp(P_WEAPON);
   
   if(!present("schuetzenbogen", ME)) CLONEME(WEAPON("schuetzenbogen"));
   
   if((!waffe) || (!waffe->id("schuetzenbogen"))) command_me("zuecke bogen");
   
   tell_object(enemy, BS("Jethro schiesst Dir einen Pfeil ins Bein."));
   tell_room(ENV(enemy), BS("Jethro schiesst "+enemy->Name(WER, 2)+" einen "
   		            "Pfeil ins Bein."), ({enemy}));
   enemy->Defend(200, ({DT_PIERCE}), ([SP_SHOW_DAMAGE: 1]));
}

