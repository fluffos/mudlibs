{
   object waffe;
   
   waffe = ME->QueryProp(P_WEAPON);
   
   if(!present("schuetzenbogen", ME)) CLONEME(WEAPON("schuetzenbogen"));
   
   if((!waffe) || (!waffe->id("schuetzenbogen"))) command_me("zuecke bogen");
   
   tell_object(enemy, BS("Jethro schiesst Dir einen Pfeil ins Gesicht."));
   tell_room(ENV(enemy), BS("Jethro schiesst "+enemy->Name(WER, 2)+" einen "
   		            "Pfeil ins Gesicht."), ({enemy}));
   enemy->Defend(600, ({DT_PIERCE}), ([SP_SHOW_DAMAGE: 1]));
