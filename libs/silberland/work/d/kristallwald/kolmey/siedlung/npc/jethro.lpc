   object waffe;
   
   waffe = ME->QueryProp(P_WEAPON);
   
   if(!present("schuetzenbogen", ME)) CLONEME(WEAPON("schuetzenbogen"));
   
   if((!waffe) || (!waffe->id("schuetzenbogen"))) command_me("zuecke bogen");
   
   tell_object(enemy, BS("Jethro laesst einen Pfeil entflammen und schiesst "
   		         "ihn auf Dich."));
   tell_room(ENV(enemy), BS("Jethro schiesst einen Feuerpfeil auf "
   			    ""+enemy->Name(WER, 2)+"."), ({enemy}));
   enemy->Defend(400, ({DT_FIRE}), ([SP_SHOW_DAMAGE: 1]));
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
   if( enemy->QueryProp(P_LEVEL)<50)
   {
   tell_object(enemy, "Jethro sagt: Du bist noch zu schwach, "+TPN+"!\n");
   tell_room(ENV(enemy), "Jethro sagt: Du bist noch zu schwach, "
   			    ""+enemy->Name(WER, 2)+"!\n", ({enemy}));
   enemy->StopHuntFor(ME);
   StopHuntFor(enemy);
   return 0;
   }
  return ::Defend(dam, dam_type, spell, enemy); 
}

void die(int poisondeath)
{
   write_file(KILLLOG, ctime()+": "+CAP(getuid(TP))+" killt Jethro.\n");
   if(!IS_LEARNER(TP))
   domainshout(CAP(TP->Name())+" hat Jethro den Waffenmeister bezwungen.\n");
   ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(KILLLOG, dtime()+": Jethro toetet "+CAP(getuid(player))+" ("+lostexp+")\n");
  
  call_out("nimm_alles_aus_leiche", 0);
}

nimm_alles_aus_leiche()
{ 
  if(present("leiche", environment(TO)))
    command("nimm alles aus leiche");
}