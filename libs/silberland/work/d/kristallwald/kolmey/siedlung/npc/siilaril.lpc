inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <wizlevels.h>
#include <new_skills.h>
#include "../siedlung.h"
#include "/d/ebene/hotaru/hotaru.h"

varargs void playseq(object ob, mixed sequence);

mapping quest;

object humusele;

void init()
{
  object defender;
  ::init();
  if(defender = present("humuselementar")) AddDefender(defender);
  if(interactive(TP)) call_out("checking", 0);
}
create()

{

  if (!is_clone(this_object())) return;  
  ::create();
   
   set_living_name("siilaril");
   AddId(({ "siilaril", "waldelfe", "elfe" }));
   SetProp(P_NAME, "Siilaril");
   SetProp(P_SHORT, "Siilaril, die Waechterin des Waldes");
   SetProp(P_GENDER, FEMALE);
   SetProp(P_ARTICLE, 0);
   SetProp(P_LONG,
     "Das ist Siilaril. Sie ist fuer eine Elfe mittelgross. "
     "Sie ist ein Wesen von entsetzlicher Schoenheit, eingehuellt "
     "in ein weisses Kleid aus reinster Seide. Ihre langen, glatten "
     "blonden Haare haengen ein bisschen in ihr Gesicht hinein und "
     "verdecken trotzdem ihre blitzblauen Augen und ihre wunderschoenen "
     "Elfenohren nicht. Von Siilarils Augen geht eine unheimlich starke "
     "Aura aus die das Wissen vieler Generationen zu tragen scheint. "
     "Sie scheint unheimlich weise zu sein.");
   SetProp(P_RACE, "Elf");
   SetProp(P_LOG_INFO, "/kolmey/siilaril_info.log");
   
   AddLibrary("/d/kristallwald/kolmey/siedlung/npc/geschichte.lib",1);
   AddLibrary("/d/kristallwald/kolmey/siedlung/npc/quest.lib",1);
   
   create_default_npc(51);
   SetProp(P_MAX_HP, 1000);
   SetProp(P_MAX_SP, 5000);
   SetProp(P_ATTRIBUTES, ([A_INT:70, A_DEX:40, A_STR:28, A_CON:99]) );
   SetProp(P_ALIGN, 800);
   SetProp(P_XP, 500000);
   SetProp(P_BODY, 250);
   SetProp(P_MAX_HANDS, 2);
   SetProp(P_HANDS, ({" mit zarten Elfenhaenden", 100, DT_BLUDGEON}) );
   SetProp(P_SIZE, 180);
   SetProp(P_NOATTACK, "fluestert: Du solltest mich nach 'kampf' fragen!\n");
   
   SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.3, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.1, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:     -0.5, DT_UNHOLY:    0.5, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.1, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0]));
   
   
   SetProp(P_SPELLRATE, 80);
   
   SetProp (P_MSGIN, "kommt herein");
   SetProp (P_MSGOUT, "geht #");
   SetProp (P_MMSGIN, "erscheint in einem Meer aus Blaettern");
   SetProp (P_MMSGOUT, "murmelt etwas ueber Waldelfenmagie und verschwindet");
   
   SetProp(P_DIE_MSG, " bricht tod nieder.\n");
   SetProp(P_KILL_NAME, "Siilaril, die Oberin der Waldelfen");
   SetProp(P_KILL_MSG, "Hattest Du etwa geglaubt DU kannst mich "
    	  	       "bezwingen?");
   SetProp(P_MURDER_MSG, ({
      "Die Waldelfenmagie wird Dich noch treffen, %s!",
      "%s , naechstes mal setze ich meine besten Zauber ein!"})[random(2)]);
   
   SetChats(3, ({
    "Siilaril verharrt in einer Position und scheint sich zu "
    "konzentrieren.\n",
    "Siilaril verharrt regungslos.\n",
    "Siilaril fluester elfische Weisen.\n"
   }) );
   
   SetAttackChats(8, ({
    "Siilaril scheint sich auf den Kampf zu konzentrieren.\n",
    "Siilaril kraeftigt ihren Willen.\n",
    "Siilaril murmelt elfische Worte.\n",
   }) );

   AddInfo(DEFAULT_INFO, ({
    "sagt: Nein, darueber weiss ich nichts.\n",
    "fluestert: Niemand weiss das.\n",
    "murmelt elfische Weisen.\n",
    "sagt: Darueber weiss ich nichts.\n"}) );
    
   AddInfo( ({ "kampf" }),
     "Wenn Du wirklich vor hast gegen mich zu kaempfen ist das Kommando "
     "<kaempfe mit siilaril>. Aber ich muss Dich warnen... Bis jetzt ist "
     "es noch keinem gelungen, gegen mich zu schlagen, denn meine "
     "Waldelfenmagie ist extrem stark. Zudem werde ich nicht hier auf "
     "dem Turm kaempfen... Aber das merkst Du schon wenn Du es ernsthaft "
     "versuchen willst. Sag aber nicht, ich haette Dich nicht "
     "gewarnt.", "murmelt: ");
      
   AddCmd( ({ "kaempfe", "kaempf" }), "cmd_kill");
   
   quest = ([]);
   
   AddSpell(6, 600,
     "Siilaril laesst die Erde unter Dir beben.\n",
     "Siilaril laesst die Erde unter @WEM beben.\n",
   DT_SQUEEZE, ([SP_SHOW_DAMAGE: 1]));
   
   
   AddSpell(2, 500,
     "Siilaril beschwoert einen Blitz auf Dich herab.\n",
     "Siilaril beschwoert einen Blitz auf @WEN herab.\n",
   DT_LIGHTNING, ([SP_SHOW_DAMAGE: 1]));
   
   
   AddSpell(2, 1,
    "Siilaril konzentriert sich und scheint die Maechte des Waldes "
    "zu beschwoeren.\n",
    "Siilaril konzentriert sich und scheint die Maechte des Waldes "
    "zu beschwoeren.\n",
    DT_MAGIC, "wood_magic");
}

void wood_magic(object enemy, int damage, mixed dam_type)
{
   AddSpell(10, 1,
    "Siilaril laesst die elementaren Kraefte in ihre Haende fliessen.\n"
    "Siilaril reibt ihre Haende aneinander...\n",
    "Siilaril laesst die elementaren Kraefte in ihre Haende fliessen.\n"
    "Siilaril reibt ihre Haende aneinander...\n",
    DT_MAGIC, "spell_hands");
   
   
   AddSpell(8, 1,
     "Siilaril kniet sich nieder, nimmt etwas Erde in die Hand und scheint "
     "sich zu konzentrieren...\n",
     "Siilaril kniet sich nieder, nimmt etwas Erde in die Hand und scheint "
     "sich zu konzentrieren...\n",
   DT_MAGIC, "help_me");
   
   
   AddSpell(5, 1100,
     "Siilaril murmelt elfische Worte.\n"
     "Kristalline Blaetter schiessen auf Dich zu und schlitzen "
     "Dich auf.\n",
     "Siilaril murmelt elfische Worte.\n"
     "Kristalline Blaetter schiessen auf @WEN zu und schlitzen "
     "@WEN auf.\n",
   DT_RIP, ([SP_SHOW_DAMAGE: 1]) );
   
   
   AddDefaultSpell(5, 1, DS_MASS_POISON);
     
   
   AddDefaultSpell(10, 1, DS_MASS_BLIND);
     
   
   AddSpell(10, 1,
     "Siilaril konzentriert sich und versucht Dich weg zu teleportieren!\n",
     "Siilaril konzentriert sich und versucht @WEN weg zu teleportieren!\n",
   DT_MAGIC, "trans_spell");
   
   
   AddDefaultSpell( 15, 5, DS_SLOW, 
     "Siilaril beschwoert einige Ranken, die Dich behindern.\n",
     "Siilaril beschwoert einige Ranken, die @WEN behindern.\n");
     
   
   AddDefaultSpell(20, 30, DS_ANTIMAGIC,
    "Siilaril verharrt in einer Position und konzentriert sich.\n"
    "Ploetzlich gluehen ihre Augen und sie starrt Dich an...\n"
    "Du wirst von Siilaril Deiner Magie beraubt.\n",
    "Siilaril verharrt in einer Position und konzentriert sich.\n"
    "Ploetzlich gluehen ihre Augen und sie starrt @WEN an...\n"
    "@WER wird von Siilaril seiner Magie beraubt.\n");
   
   
   AddSpell(9, 1,
     "Siilaril konzentriert sich.\n",
     "Siilaril konzentriert sich.\n",
   DT_MAGIC, "body_spell");
   
   
   AddSpell(7, 1,
     "Ein blassgruener Schimmer huellt Siilaril kurz ein.\n",
     "Ein blassgruener Schimmer huellt Siilaril kurz ein.\n",
   DT_MAGIC, "heal_spell");
   
   
   AddSpell(1, 1,
     "Siilaril beginnt etwas ueber dem Boden zu schweben.\n",
     "Siilaril beginnt etwas ueber dem Boden zu schweben.\n",
   DT_MAGIC, "last_spell");
}

void help_me(object enemy, int damage, mixed dam_type)
{  
  
  object humusele;
  if(present("humuselementar 5", MENV))
  {
    tell_room(environment(), 
    BS("Nichts passiert..."));
  }
  else 
  {
    tell_room(environment(), 
    BS("Aus der Erde entsteht eine baumhohe Gestalt aus Erde, Laub und "
       "Holz, umgeben von Dornenranken!"));
    humusele=clone_object(NPC("humusele"));
    humusele->move(MENV, M_GO);
    AddPursuer(humusele);
   } 
}

void spell_hands(object enemy, int damage, mixed dam_type)
{
  
  tell_room(environment(), 
  BS("...und Siilarils Haende sind vollkommen von der Natur umgeben."));
  SetProp(P_HANDS,({" mit Pflanzenhaenden", 650, DT_MAGIC}) );
  SetProp(P_SPELLRATE, 0);
  call_out("end_hands", 15+random(10));
}

void end_hands()
{
  tell_room(environment(), 
  BS("Siilarils Haende werden wieder normal."));
  SetProp(P_HANDS, ({" mit zarten Elfenhaenden", 100, DT_BLUDGEON}) );
  SetProp(P_SPELLRATE, 50);
}

void trans_spell(object enemy, int damage, mixed dam_type)
{
   object ob;
   if(present("humuselementar", ENV(TP)))
   {
   while(ob=present("humuselementar", ENV(TP)))
   {
   ob->move(ROOM("wald02"), M_SILENT);
   }
   tell_object(environment(), 
   BS("Ein Humuselementar schnappt Dich und bringt Dich fort."));
   tell_room(environment(), 
   BS("Ein Humuselementar schnappt "+TPN+" und verschwindet."));
   enemy->move(ROOM("wald02"), M_SILENT);
   }
}

void body_spell(object enemy, int damage, mixed dam_type)
{
  tell_room(environment(), 
  BS("Ploetzlich bildet sich um ihre Haut eine lederartige Substanz. "
     "Ihre Verteidigung scheint zugenommen zu haben."));
  SetProp(P_BODY, 500);
  call_out("end_body", 20+random(10));
}

void end_body()
{
  tell_room(environment(), 
  BS("Die lederartige Substanz verschwindet und Siilarils Verteidigung "
     "laesst wieder nach."));
  SetProp(P_BODY, 250);
}

void heal_spell(object enemy, int damage, mixed dam_type)
{
  tell_room(environment(), 
  BS("Siilaril sieht ploetzlich viel besser aus."));
  ME->AddHp(200);
}

void last_spell(object enemy, int damage, mixed dam_type)
{
  tell_room(environment(), 
    "Siilarils Augen leuchten rot.\n"
    "Siilaril bruellt: Ich bin unbesiegbar!\n");
  ME->SetProp(P_BODY, 750);
  ME->SetProp(P_SPELLRATE, 0);
  ME->SetProp(P_HANDS,({" mit Pflanzenhaenden", 650, DT_MAGIC}) );
  ME->SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -1.0, DT_COLD:     -1.0, DT_WATER:      -1.0
     , DT_AIR:      -1.0, DT_LIGHTNING:-1.0, DT_EXPLOSION:  -1.0
     , DT_SOUND:    -1.0, DT_LIGHT:    -1.0, DT_ELECTRIC:   -1.0
     , DT_ACID:     -1.0, DT_POISON:   -1.0, DT_TERROR:     -1.0
     , DT_HOLY:     -1.0, DT_UNHOLY:   -1.0, DT_MAGIC:      -1.0
     , DT_MIND:     -1.0, DT_SLASH:     1.0, DT_BLUDGEON:    1.0
     , DT_PIERCE:    1.0, DT_SQUEEZE:  -1.0, DT_WHIP:        1.0
     , DT_RIP:       1.0]));
  tell_room(environment(), 
    BS("Siilarils Verteidigung hat zugenommen."));
  tell_room(environment(),
    BS("Siilarils Haende sind vollkommen von der Natur umgeben."));
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
   if( enemy->QueryProp(P_LEVEL)<50)
   {
   tell_object(enemy, "Siilaril sagt: Du bist noch zu schwach, "+TPN+"!\n");
   tell_room(ENV(enemy), "Siilaril sagt: Du bist noch zu schwach, "
   			    ""+enemy->Name(WER, 2)+"!\n", ({enemy}));
   enemy->StopHuntFor(ME);
   StopHuntFor(enemy);
   return 0;
   }
  return ::Defend(dam, dam_type, spell, enemy); 
}

int cmd_kill(string str)
{
   
   notify_fail(BS("Gegen wen moechtest Du denn kaempfen?"));
   if(!str) return 0;
   if(str == "mit siilaril" || str == "mit waldelfe" || 
      str == "mit elfe")
   {
   call_out("seq1", 0);
   }
   return 1;
}

void seq1()
{  
   TP->SetProp(P_PARALYZED, ([PARALYZE_TIME:-1,
   PARALYZE_MSG:"Du beobachtest Siilaril gespannt",
   PARALYZE_MSG_OTHER:"", PARALYZE_END:"",
   PARALYZE_END_OTHER:""]));
   write(BS("Siilaril sagt: Nun, so sei es denn...")+"\n");
   call_out("seq2", 2);
}

void seq2()
{
   write(BS("Siilaril macht ein paar magische Bewegungen und murmelt "
   	    "ein paar unverstaendliche Worte.")+"\n");
   call_out("seq3", 2);
}

void seq3()
{
   TP->move("/d/kristallwald/kolmey/wald/room/wald01", M_TPORT);
   ME->move("/d/kristallwald/kolmey/wald/room/wald01", M_TPORT);
   write(BS("Dir schwinden die Sinne, und Du findest Dich ploetzlich "
   	    "ganz wo anders wieder.")+"\n");
   call_out("seq4", 2);
}

void seq4()
{
   TP->SetProp(P_PARALYZED, ([PARALYZE_TIME: 1,
   PARALYZE_MSG:"", PARALYZE_MSG_OTHER:"", PARALYZE_END:"",
   PARALYZE_END_OTHER:""]));
   write(BS("Siilaril sagt: Nun sei es Dir erlaubt mich anzugreifen.")+"\n");
   ME->SetProp(P_NOATTACK, 0);
}

reset() 
{
  ::reset();
  if(!is_clone(TO)) return;
  if(environment())
    tell_object(environment(TO), 
      "Siilaril verschwindet.\n");
  ME->move("d/kristallwald/kolmey/siedlung/room/plattform.lpc", M_TPORT);
}

void checking()
{
  string spieler;
  spieler=getuid(TP);
  if(!member(quest, spieler))
  {
    quest+=([spieler: 0]);
  }
  if(!(TP->QueryQuest("Der Schatzkristall")) && quest[spieler, 0]<1) 
  {
  quest[spieler, 0]++;
  
  TP->SetProp(P_PARALYZED, ([ PARALYZE_TIME:19,
      PARALYZE_MSG:"Du bist in Trance.\n",
      PARALYZE_MSG_OTHER:"",
      PARALYZE_END:"",
      PARALYZE_END_OTHER:"" ]));
  playseq(TP, ({
    "§Du vernimmst die Gegenwart einer Person, siehst Dich "
    "um und entdeckst Sie. Eine Waldelfe von zauberhafter "
    "Austrahlung, eingekleidet in ein leichtes Kleid aus "
    "weisser Seide.°°°°°",
    "§Die Waldelfe wendet sich Dir zu.°",
    "§@ME sagt: Sei gegruesst @NAME! Mein Name ist Siilaril.°",
    "§@ME sagt: $Ich bin die Waechterin des Waldes und Behueterin des "
  	       "wertvollen Schatzkristalls.°°°°",
    "@ME sagt etwas zu @WEM.§",
    "§@ME sagt: $Ich weiss warum Du gekommen bist, @NAME. "
               "Du kommst, wie so viele Andere mit der Bitte "
  	       "zu mir, den Schatzkristall zu erhalten.°°°°",
    "§@ME sagt: $Doch leider kann ich Dir Deinen Wunsch nicht "
  	       "erfuellen!°°",
    "§@ME sagt: $Vor einigen Tagen hat mir eine boese Zauberin "
  	       "den Schatzkristall gestohlen und ist mit ihm ins "
  	       "Reich der Gedanken geflohen.°°°°",
    "§@ME sagt: $Wenn Du jedoch den Mut besitzt und ins Gedankenreich "
    	       "gehen und den Schatzkristall zurueckholen "
    	       "wuerdest, so waere ich Dir sehr dankbar und wuerde "
    	       "ihn Dir gerne ueberlassen.°°°°",
    "§@ME sagt: $Solltest Du dies versuchen wollen, so frage mich nach "
    	       "dem Gedankenreich und ich werde Dir mehr darueber "
    	       "erzaehlen. Doch solltest Du Dich beeilen, ich weiss "
    	       "nicht was die Zauberin mit dem Schatzkristall vor "
    	       "hat.°°°°°"}));
  }
}

varargs void playseq(object ob, mixed sequence) {
  int trenner, waittime;
  string curline, general, personal;
  if (!ob) return;
  if (present(ob, ENV(TO))) {
    
    if (pointerp(sequence)) {
      if (sizeof(sequence) == 0) return;
      curline = sequence[0];
    } else {
      curline = sequence;
    }
    
    waittime = strstr(curline, "°", 0);
    if (waittime == -1) {
      waittime = 0;
    } else {
      waittime = (strlen(curline) - waittime) * 2;
      curline = curline[0..strstr(curline, "°", 0)-1];
    }
    
    curline  = process_string(curline);
    curline  = regreplace(curline,  "@ME",     TO->Name(WER, 1),    1);
    curline  = regreplace(curline,  "@NAME",   ob->Name(WER, 1),    1);
    
    trenner = strstr(curline, "§", 0);
    if (trenner != -1) {
      general = curline[0..trenner-1];
      personal = curline[trenner+1..];
    } else {
      general = personal = curline;
    }
    
    general  = regreplace(general,  "@WER",    ob->Name(WER, 1),    1);
    general  = regreplace(general,  "@WESSEN", ob->Name(WESSEN, 1), 1);
    general  = regreplace(general,  "@WEM",    ob->Name(WEM, 1),    1);
    general  = regreplace(general,  "@WEN",    ob->Name(WEN, 1),    1);
    
    personal = regreplace(personal, "@WER",    "Du",                1);
    personal = regreplace(personal, "@WESSEN", "Dein",              1);
    personal = regreplace(personal, "@WEM",    "Dir",               1);
    personal = regreplace(personal, "@WEN",    "Dich",              1);

    if (personal != "") tell_object(ob, MyBS(personal));
    if (general  != "") tell_room(ENV(TO), MyBS(general), ({ob,this_object()}));
    
    if (pointerp(sequence)) {
      if (sizeof(sequence) == 1) return;
      call_out("playseq", waittime, ob, sequence[1..]);
    }
  }
}
