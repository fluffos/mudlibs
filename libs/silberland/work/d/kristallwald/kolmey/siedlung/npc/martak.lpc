inherit "/d/kristallwald/kolmey/siedlung/npc/std_woodelf.lpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../siedlung.h"

create()
{
  if (!is_clone(this_object())) return;

  ::create();
  AddId( ({"martak", "waldelf", WIRT}) );
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Martak");
  SetProp(P_SHORT, "Martak der Wirt");
  SetProp(P_ARTICLE, 0);
  SetProp(P_LONG, 
    "Martak, der Wirt, ist ein Waldelf von grosser, kraeftiger Statur. "
    "Er traegt lange schwarze Haare und hat leuchtend blaue Augen. "
    "Martak hat eine gruene Schuerze umgehaengt, wie es fuer Wirten "
    "ueblich ist.");
  set_living_name(WIRT);
  
  create_default_woodelf(20+random(10));
  SetProp(P_SIZE, 210);
  SetProp(P_BODY, 220);
  
  SetProp(P_MNPC_AREA, "/d/kristallwald/kolmey/siedlung/room/kneipe");
    
  SetProp(P_DIE_MSG, " stirbt unter Deinem letzten Schlag.\n");
  SetProp(P_KILL_NAME, TO->QP(P_SHORT));
  SetProp(P_KILL_MSG, "In meiner Kneipe nicht!");
  SetProp(P_MURDER_MSG, ({
      "Na warte! Wenn Du naechstes mal in meine Kneipe kommst, %s!",
      "Naechstes mal verfuettere ich Deine Leiche an meine "
      "Gaeste, %s!"}) [random(2)]); 

  SUID;
  CLONEME("/p/armour/cloak/schuerze");
  command("ziehe alles an");
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{  
   if(!QueryProp(P_WEAPON))
   {
   tell_room(environment(),
   BS("Martak greift hinter die Theke und holt etwas hervor."));
   CLONEME("/p/weapon/sword/holzschwert");
   command("zuecke schwert");
   }
  return ::Defend(dam, dam_type, spell, enemy); 
}
void InformDefend(object enemy)
{
  Kill(enemy);
}
