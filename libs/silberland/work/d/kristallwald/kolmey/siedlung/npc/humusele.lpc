inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "../siedlung.h"

init()
{
  ::init();
  if(TP && (TP->id("siilaril"))) AddDefender(TP);
}

create()
{
  if (!is_clone(this_object())) return;

  ::create();
  AddId( ({"humuselementar", "elementar"}) );
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME, "Humuselementar");
  SetProp(P_SHORT, "Ein Humuselementar");
  SetProp(P_LONG, 
    "Das Humuselementar besteht vollkommen aus Erde, Laub und Dornenranken. "
    "Es ueberragt Dich um Laengen. Eine eigentuemliche Kraft des Lebens "
    "geht von ihm aus, ja Du spuerst diese Kraft sogar.");
  set_living_name("humuselementar");
  
  create_default_npc(15+random(3));
  SetProp(P_ALIGN, 200+random(50));
  SetProp(P_SIZE, 210);
  SetProp(P_RACE, "Elementar");
  SetProp(P_MAX_HANDS, 5);
  SetProp(P_HANDS, ({" mit Giftstacheln", 120, DT_RIP}) );
  SetProp(P_BODY, 260);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.3, DT_COLD:      0.0, DT_WATER:       0.5
     , DT_AIR:       0.1, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.5, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.1, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0]));
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Elementar ignoriert Dich.\n" }) );
  
   SetProp (P_MSGIN, "entsteht");
   SetProp (P_MSGOUT, "geht #");
   SetProp (P_MMSGIN, "ensteht aus dem Boden");
   SetProp (P_MMSGOUT, "versinkt im Boden und ist verschwunden");
   
   SetProp(P_DIE_MSG, " verschwindet in der Erde.\n");
   SetProp(P_KILL_NAME, "Ein Humuselementar");
   SetProp(P_KILL_MSG, "Mein Meister wollte Deinen Tod!");
   
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

reset() 
{
  ::reset();
  if (!is_clone(TO)) return;
  if(environment())
    tell_object(environment(TO), 
      "Das Humuselementar loest sich nach erfuelltem Dienst auf.\n");
  TO->remove();
}
