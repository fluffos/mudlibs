inherit "/d/kristallwald/kolmey/siedlung/npc/std_woodelf.lpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../siedlung.h"

#define WMASTER "/d/kristallwald/kolmey/siedlung/npc/woodelf_master"

void init()
{
  ::init();
  if(WMASTER->IsEnemy(TP))
    Kill(TP);
}

create()
{
  if (!is_clone(this_object())) return;

  ::create();
  AddId( ({WALDELF, "spaeher"}) );
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Spaeher");
  SetProp(P_SHORT, "Ein Waldelfenspaeher");
  SetProp(P_LONG, 
    "Der Waldelfenspaeher blickt hier am Wachturm mit seinen geschulten "
    "Augen in die Ferne um unerwuenschte Gaeste und Probleme schon von "
    "weitem erkennen zu koennen. "
    "Durch sein langes, schwarzes Haar schimmern seine blauen Augen "
    "hindurch, die die umliegenden Gebiete genau zu beobachten scheinen.");
  set_living_name("waldelfenspaeher");
  
  SetProp(P_DIE_MSG, " stirbt unter Deinem letzten Schlag.\n");
  SetProp(P_KILL_MSG, "Naechstes Mal schlage ich Alarm, wenn ich "
  		      "Dich sehe, %!");
  
  AddDetail( ({ "augen" }),
    "Seine blauen Augen leuchten durch das Haar hindurch und scheinen "
    "die umliegenden Gebiete genau zu beobachten.");
  AddDetail( ({ "haar", "haare" }),
    "Der Waldelfenwaechter hat langes, schwarzes, glattes Haar.");
  
  
  create_default_woodelf(20+random(7));
  

  SUID;
   
   if(random(100) < 20 ) CLONEME("/p/armour/sandalen");
   if(random(100) < 20 ) CLONEME("/p/armour/armour/lederpanzer");
   if(random(100) < 90 ) CLONEME
     ("/d/kristallwald/sargola/dorf/armour/armschienen");
   if(random(100) < 90 ) CLONEME
     ("/d/kristallwald/sargola/dorf/armour/ring");
   CLONEME("/d/kristallwald/kolmey/siedlung/armour/robe");
   command("ziehe alles an");
   
   WMASTER->add_woodelf();
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  WMASTER->ruf_um_hilfe(enemy);
  ::Defend(dam, dam_type, spell, enemy);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  WMASTER->Sieg(player);
}

remove(int arg)
{
  WMASTER->remove_woodelf(this_object());
  ::remove(arg);
}