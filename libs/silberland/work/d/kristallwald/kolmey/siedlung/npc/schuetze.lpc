inherit "/d/kristallwald/kolmey/siedlung/npc/std_woodelf.lpc";
inherit "std/npc/spells";

#include <new_skills.h>
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../siedlung.h"

#define WMASTER "/d/kristallwald/kolmey/siedlung/npc/woodelf_master"

void init()
{
  ::init();
  if(WMASTER->IsEnemy(TP))
    Kill(TP);
}

create()
{
  if (!is_clone(this_object())) return;

  ::create();
  AddId( ({WALDELF, "schuetze"}) );
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Waldelfenschuetze");
  SetProp(P_SHORT, "Ein Waldelfenschuetze");
  SetProp(P_LONG, 
    "Der Waldelfenschuetze blickt hier am Wachturm mit seinen geschulten "
    "Augen in die Ferne und hat seinen Bogen griffbereit um Feinde "
    "aus der Ferne abschiessen zu koennen. "
    "Durch sein langes, schwarzes Haar schimmern seine blauen Augen "
    "hindurch, die die umliegenden Gebiete genau zu beobachten scheinen. "
    "Man erzaehlt sich, dass noch kein Pfeil der Waldelfenschuetzen sein "
    "Ziel verfehlt hat.");
  set_living_name("waldelfenschuetze");
  
  SetProp(P_DIE_MSG, " stirbt unter Deinem letzten Schlag.\n");
  SetProp(P_KILL_MSG, "Ich verfehle mein Ziel nie, %!");
  
  AddDetail( ({ "augen" }),
    "Seine blauen Augen leuchten durch das Haar hindurch und scheinen "
    "die umliegenden Gebiete genau zu beobachten.");
  AddDetail( ({ "haar", "haare" }),
    "Der Waldelfenwaechter hat langes, schwarzes, glattes Haar.");
  AddDetail( ({ "pfeil", "ziel" }),
    "Man erzaehlt sich, noch kein Pfeil der Waldelfenschuetzen habe sein Ziel "
    "verfehlt.");
  
  create_default_woodelf(22+random(8));
  

  SUID;
   
   if(random(100) < 20 ) CLONEME("/p/armour/boots/sandalen");
   if(random(100) < 20 ) CLONEME("/p/armour/armour/armour/lederpanzer");
   if(random(100) < 90 ) CLONEME
     ("/d/kristallwald/sargola/dorf/armour/armschienen");
   if(random(100) < 90 ) CLONEME
     ("/d/kristallwald/sargola/dorf/armour/ring");
   CLONEME("/d/kristallwald/kolmey/siedlung/armour/robe");
   CLONEME("/d/kristallwald/kolmey/siedlung/weapon/schuetzenbogen");
   command("ziehe alles an");
   command("zuecke bogen");
   
   SetProp(P_SPELLRATE, 50+random(25));
   
   AddSpell(3, 400+random(100),
     "Der Waldelfenschuetze konzentriert sich.\n"
     "Er laesst einen Pfeil entflammen und schiesst ihn auf Dich ab.\n",
     "Der Waldelfenschuetze konzentriert sich.\n"
     "Er laesst einen Pfeil entflammen und schiesst ihn auf @WEN ab.\n",
    DT_FIRE, ([SP_SHOW_DAMAGE: 1]) );
    
   AddSpell(2, 200+random(100),
     "Der Waldelfenschuetze schiesst Dir einen Pfeil ins Bein.\n",
     "Der Waldelfenschuetze schiesst @WEM einen Pfeil ins Bein.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]) );
   
   AddSpell(2, 200+random(100),
     "Der Waldelfenschuetze schiesst Dir einen Pfeil in den Arm.\n",
     "Der Waldelfenschuetze schiesst @WEM einen Pfeil in den Arm.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]) );
   
   AddDefaultSpell(1, 1, DS_DISARM,
     "Der Waldelfenschuetze schiesst Dir einen Pfeil in die Waffenhand.\n"
     "Du laesst Deine Waffe fallen.\n",
     "Der Waldelfenschuetze schiesst @WEM einen Pfeil in die Waffenhand.\n"
     "@WER laesst die Waffe fallen.\n");
   
   WMASTER->add_woodelf();
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  WMASTER->ruf_um_hilfe(enemy);
  ::Defend(dam, dam_type, spell, enemy);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  WMASTER->Sieg(player);
}

remove(int arg)
{
  WMASTER->remove_woodelf(this_object());
  ::remove(arg);
}