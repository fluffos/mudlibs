inherit "/d/kristallwald/kolmey/siedlung/npc/std_woodelf.lpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../siedlung.h"

create()
{
  if (!is_clone(this_object())) return;

  ::create();
  AddId( ({WALDELF, "waldelf", "elf"}) );
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Waldelf");
  SetProp(P_SHORT, "Ein Waldelf");
  SetProp(P_LONG, 
    "Der Waldelf hat langes, schwarzes Haar das etwas ins Gesicht "
    "hineinhaengt. Seine Ohren schauen hinter dem Haar hervor. "
    "Eingehuellt in eine weisse Robe schlendert er gemuetlich im "
    "Dorf umher.");
  
  AddDetail( ({ "haar", "haare" }),
    "Der Waldelf hat langes, schwarzes Haar das etwas ins Gesicht "
    "hineinhaengt.");
  AddDetail( ({ "ohren" }),
    "Seine wunderschoenen Ohren schauen hinter dem Haar hervor.");
    
  set_living_name("waldelf");
  
  SetProp(P_DIE_MSG, " stirbt unter Deinem letzten Schlag.\n");
  SetProp(P_KILL_NAME, TO->QP(P_SHORT));
  SetProp(P_KILL_MSG, "Warum musstest Du mich auch angreifen?");
  
  SetProp(P_MSGIN, "schlendert herein");
  SetProp(P_MSGOUT, "schlendert#");
  SetProp(P_MMSGIN, "entsteht aus dem Boden");
  SetProp(P_MMSGOUT, "versinkt im Boden und ist verschwunden");
  
  create_default_woodelf(20+random(5));
  
  SUID;
   
  if(random(100) < 20 ) CLONEME("/p/armour/sandalen");
  if(random(100) < 20 ) CLONEME("/p/armour/armour/lederpanzer");
  if(random(100) < 90 ) CLONEME
    ("/d/kristallwald/sargola/dorf/armour/armschienen");
  if(random(100) < 90 ) CLONEME
    ("/d/kristallwald/sargola/dorf/armour/ring");
  CLONEME("/d/kristallwald/kolmey/siedlung/armour/robe");
  CLONEME("/d/kristallwald/sargola/dorf/weapon/bogen");
  command("ziehe alles an");
  command("zuecke bogen");
}