void init()
{ 
  
  ::init();
  if(TP && (TP->id(WALDELF))) AddDefender(TP);
  
  if(interactive(TP)) call_out("reaktion", 0);
  if(interactive(TP)) call_out("greeting", 0);
}

void create_default_woodelf(int level)
{ 
  create_default_npc(level);
  SetProp(P_RACE, "Elf");
  SetProp(P_ALIGN, 300+random(50));
  SetProp(P_SIZE, 200+random(5));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS, ({" mit blossen Haenden", 120+random(15), DT_BLUDGEON}) );
  SetProp(P_BODY, 110+random(50));
  SetProp(P_WEIGHT, 65000+random(2000));
  
  SetProp(P_REJECT, ({ REJECT_DROP,
    CAP(Name(WER, 1))+" sagt: Trag Dir Dein Zeug selber!\n"}) );
  
  AddInfo(DEFAULT_INFO, ({
    "sagt: Aha, interessant!\n",
    "sagt: Frag doch mal Siilaril oder Jethro!\n",
    "schaut in der Gegend umher.\n",
    "sagt: Darueber weiss ich leider nichts!\n",
    "schaut Dich nur fragend an.\n",
    "sagt: Soso ist das also!\n",
    "kratzt sich am Kopf.\n" }));
  
  AddLibrary("/d/kristallwald/kolmey/siedlung/npc/standard.lib",1);
  
  SetProp(P_LOG_INFO, "kolmey/woodelf.log");
  
  SetProp(P_MURDER_MSG, ({
      "Die Boegen sind schon gespannt, %s!",
      "Das wird ein Nachspiel haben, %s!"})[random(2)]);
  
  SetAttackChats(8, ({
    CAP(Name(WER, 1))+" sagt: Du hast keine Chance gegen uns!\n",
    CAP(Name(WER, 1))+" sagt bissig: Ich werde Dich vernichten!\n",
    CAP(Name(WER, 1))+" sagt: Du wirst sterben!\n",
   }) );
  
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.3, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.1, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:     -0.3, DT_UNHOLY:    0.4, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.1, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0]));
  
  SetProp(P_SPELLRATE, 35+random(20));
  
  AddSpell(6, 300+random(100),
    CAP(Name(WER, 1))+" beschwoert einige Ranken, die auf Dich "
    		      "einpeitschen.\n",
    CAP(Name(WER, 1))+" beschwoert einige Ranken, die auf @WEN "
    		      "einpeitschen.\n",
    DT_WHIP, ([SP_SHOW_DAMAGE: 1]) );
  
  AddSpell(4, 300+random(100), 
    CAP(Name(WER, 1))+" beschwoert ein magisches Erdbeben.\n",
    CAP(Name(WER, 1))+" beschwoert ein magisches Erdbeben.\n",
   DT_SQUEEZE, ([SP_SHOW_DAMAGE: 1]) ); 
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{  
   if(find_call_out("reaction") != -1) return;
   switch (gruppe)
{
   case "aengstlich":
   call_out("reaction", 0, TP, "sagt: Vor uns brauchst Du keine Angst zu "
   			       "haben.", 
                               "sagt: "+TPN+", Vor uns brauchst Du keine "
                               "Angst zu haben.");
   break;
   case "aergerlich":
	
   call_out("reaction", 0, TP, "sagt: Lass das!", 
                               "sagt: Lass das "+TPN+"!");
   break;
   case "albern":
	 
   call_out("reaction", 0, TP, "grinst.", 
                               "grinst.");
   break;
   case "fies":
	
   call_out("reaction", 0, TP, "sagt: Hoer auf damit!", 
       	 		       "sagt: Hoer auf damit "+TPN+"!");
   break;
   case "frech":
	
   call_out("reaction", 0, TP, "haut Dich.", 
   			       "haut "+TPN+".");
   break;
   case "froh":
         
   call_out("reaction", 0, TP, "knuddel Dich freundlich.", 
  			       "knuddelt "+TPN+" freundlich.");
   break;
   case "intim":
	
   call_out("reaction", 0, TP, "sagt: Ich bin verheiratet!", 
  			       "sagt: Ich bin verheiratet, "+TPN+"!");
   break;
   case "nett":
	
   call_out("reaction", 0, TP, "knuddelt Dich.", 
  			       "knuddelt "+TPN+".");
   break;
   case "neutral":
	
   call_out("reaction", 0, TP, "schaut dich fragend an.", 
     			       "schaut "+TPN+" fragend an.");
   break;
   case "traurig":
        
   call_out("reaction", 0, TP, "umarmt Dich troestend.", 
  			       "umarmt "+TPN+" troestend.");
   break;
   }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
   return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
  {
  tell_object(ob, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

void greeting() 
{  
   int i;
   if(MENV!=ENV(TP)) return;
   switch(TP->QueryProp(P_RACE))
   {
    case "Mensch":
      command_me("sag "+MENSCH[random(sizeof(MENSCH))]);
      break;
    case "Elf":
      command_me("sag "+ELF[random(sizeof(ELF))]);
      break;    
    case "Zwerg":
      command_me("sag "+ZWERG[random(sizeof(ZWERG))]);
      break;    
    case "Hobbit":
      command_me("sag "+HOBBIT[random(sizeof(HOBBIT))]);
      break;    
    case "Fee":
      command_me("sag "+FEE[random(sizeof(FEE))]);
      break;    
    case "Dunkelelf":
      command_me("sag "+DUNKELELF[random(sizeof(DUNKELELF))]);
      break;    
    case "Troll":
      command_me("sag "+TROLL[random(sizeof(TROLL))]);
      break;    
    case "Oger":
      command_me("sag "+OGER[random(sizeof(OGER))]);
      break;    
    default:
      command_me("sag "+_DEFAULT[random(sizeof(_DEFAULT))]);
      break;
  }	
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

activate_walk()
{
   SetProp(P_MNPC_DEFAULTROOM, ({
     "/d/kristallwald/kolmey/siedlung/room/dorf06",
     "/d/kristallwald/kolmey/siedlung/room/dorf07",
     "/d/kristallwald/kolmey/siedlung/room/laden"})[random(3)]);
   SetProp(P_MNPC_WAIT, ({ 10+random(20), 120, 120 }));
   SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + 
                         MOV_BACKWARDS);
   SetProp(P_MNPC_AREA, "/d/kristallwald/kolmey/siedlung/room/");
}

