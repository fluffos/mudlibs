inherit "std/weapon";

#include "../siedlung.h"
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein elfischer Schuetzenbogen");
  SetProp(P_LONG,
    "Das ist ein Schuetzenbogen, wie ihn Spaeher benutzen. Dieser Bogen "
    "ist speziell fuer das zielgenaue treffen der Feinde aus einer "
    "weiteren Entfernung gefertigt worden. Er wurde aus dem Geweih eines "
    "Hirsches gebaut und mit einer zarten, perfekt gespannten Kristallsehne "
    "bespannt.");
  SetProp(P_NAME, "Schuetzenbogen");
  SetProp(P_GENDER, MALE);
  AddId( ({"schuetzenbogen", "bogen"}) );
  
  AddDetail( ({ "feinde" }),
    "Mit diesem Bogen kann man bestimmt seine Feinde sehr genau treffen.");
  AddDetail( ({ "geweih" }),
    "Der Schuetzenbogen wurde aus dem Geweih eines Hirsches gefertigt.");
  AddDetail( ({ "sehne", "kristallsehne" }),
    "mit einer duennen Kristallsehne wurde der Bogen perfekt bespannt.");
  
  SetProp(P_WEAPON_TYPE, WT_BOW);
  SetProp(P_WC, 150+random(15));
  SetProp(P_WC_FIX, 50);
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_HORN: 80, MAT_CRYSTAL: 20]));
  SetProp(P_WEIGHT, 1100);
  SetProp(P_VALUE, 1500);
  SetProp(P_WC_BONUS, (["schuetze":120]) );
  SetProp(P_WIELD_RESTRICTIONS, ([SR_INCLUDE_RACE: ({"Elf"}),
                                  A_DEX: 12, A_STR: 8]) );
}

