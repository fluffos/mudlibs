inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Elfenrache");
  SetProp(P_LONG,  
    "Elfenrache ist ein maechtiges Schwert, das fuer elfische Paladine "
    "geschmiedet und nur von solchen gezueckt werden kann. Elfenrache "
    "besitzt eine einzigartige Klinge, die einen unterschiedlichen "
    "Schliff aufweist. Die eine Seite ist gezackt, die andere geradlinig "
    "und extrem scharf. So ist es mit Elfenrache moeglich seinen Gegnern "
    "die Haut aufzureissen und gleichzeitig tiefe Wunden zuzufuegen. "
    "Elfenrache besteht aus sehr seltenem weissen Silber, schimmert blau "
    "und scheint so ziemlich die Beste Waffe fuer einen Elfen Paladin "
    "zu sein.");
  
  AddDetail( ({ "silber" }),
    "Elfenrache wurde aus sehr seltenem, weissem Silber gefertigt und "
    "wird von einem blauen, duennen Schimmer umgeben.");
  AddDetail( ({ "schimmer" }),
    "Ein magischer, duenner blauer Schimmer umgibt Elfenrache.");
  AddDetail( ({ "klinge", "teil", "teile" }),
    "Elfenrache's Klinge ist zweiteilig. Der eine Teil, gezackt, mit "
    "extremen Spitzen, zum Aufreissen der Haut, der andere Teil "
    "geradlinig und scharf geschliffen, zum Zufuegen tiefer Wunden.");
  AddDetail( ({ "spitzen" }),
    "In einem Teil wurden extreme Spitzen eingearbeitet, die dazu "
    "dienen, dem Gegner die Haut aufzureissen.");
  AddDetail( ({ "wunden" }),
    "Ein Teil wurde geradlinig geschmiedet und scharf geschliffen. "
    "Man kann damit bestimmt tiefe Wunden zufuegen.");
  
  SetProp(P_INFO, BS(
    "Elfenrache kann nur von maechtigen, elfischen Paladinen gezueckt "
    "werden."));
  SetProp(P_NAME, "Elfenrache");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  AddId( ({"elfenrache", "schwert", "elfenschwert"}) );
  
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 210);
  SetProp(P_WC_FIX, 40);
  SetProp(P_DAM_TYPE, ([DT_RIP, DT_SLASH]) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_SILVER:100]));
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOSELL, 1);
  SetProp(P_QUALITY_DECAY, 150);
  /*SetProp(P_WIELD_RESTRICTIONS, ([ SR_INCLUDE_RACE:({"Elf"}), 
    SR_INCLUDE_GUILD:({"Paladine"}), A_DEX: 20, A_STR: 23, P_LEVEL: 35, 
    P_QP: 800, SR_SEER: 1, P_XP: 8000000]) );*/
  SetProp(P_WC_BONUS, (["elf": 200, "Elfspieler": 150]) );
}

