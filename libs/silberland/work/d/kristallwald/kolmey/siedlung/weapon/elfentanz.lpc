inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

#define KOSTEN 50

int zeit, first_spell;

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Elfentanz");
  SetProp(P_LONG,  
    "Elfentanz ist eine maechtige Axt, die nur fuer Elfen geschmiedet wurde "
    "und nur von diesen gezueckt werden kann. Sie besteht aus sehr seltenem "
    "weissen Silber. Zwei unterschiedliche Axtblaetter. Eins gezackt mit "
    "extremen Spitzen, das andere geradlinig. So ist es nur mit Elfentanz "
    "moeglich dem Gegner die Haut aufzureissen und ihm gleichzeitig enorme "
    "Wunden zuzufuegen. Elfentanz' Stiel besteht ebenfalls aus weissem "
    "Silber und weisst wunderschoene Verzierungen auf. Elfentanz wird von "
    "einem blauen Schimmer umgeben und scheint so ziemlich die Beste Axt "
    "fuer einen elfischen Berserker zu sein.");
  AddDetail( ({ "silber" }),
    "Elfentanz wurde aus sehr seltenem, weissem Silber gefertigt und "
    "wird von einem blauen, duennen Schimmer umgeben.");
  AddDetail( ({ "schimmer" }),
    "Ein magischer, duenner blauer Schimmer umgibt Elfentanz.");
  AddDetail( ({ "axtblaetter", "axtblatt" }),
    "Elfentanz weist unterschiedliche Axtblaetter auf. "
    "Eines gezackt mit extremen Spitzen, zum Aufreissen der Haut, "
    "und eins geradlinig, zum Zufuegen tiefer Wunden.");
  AddDetail( ({ "spitzen" }),
    "In ein Axtblatt wurden extreme Spitzen eingearbeitet, die dazu "
    "dienen, dem Gegner die Haut aufzureissen.");
  AddDetail( ({ "wunden" }),
    "Ein Axtblatt wurde geradlinig geschmiedet und scharf geschliffen. "
    "Man kann damit bestimmt tiefe Wunden zufuegen.");
  AddDetail( ({ "stiel" }),
    "Elfentanz' Stiel besteht aus weissem Silber und weist einige "
    "Verzierungen auf.");
  AddDetail( ({ "verzierungen" }),
    "Wunderschoene elfische Weisen wurden in den Stiel eingearbeitet.");
  AddDetail( ({ "weisen" }),
    "Leider kannst Du die elfischen Weisen, die in Elfentanz' Stiel "
    "eingearbeitet wurden nicht uebersetzen. Sie scheinen schon "
    "sehr alt zu sein.");
  
  SetProp(P_INFO, BS(
    "Elfentanz kann nur von maechtigen, elfischen Kriegern gezueckt "
    "werden."));
  SetProp(P_NAME, "Elfentanz");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId( ({"elfentanz", "axt", "elfenaxt"}) );
  
  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_WC, 240);
  SetProp(P_WC_FIX, 40);
  SetProp(P_MAGIC, 1);
  SetProp(P_DAM_TYPE, DT_RIP);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_SILVER:100]));
  SetProp(P_WEIGHT, 4000);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_WIELD_RESTRICTIONS, ([ SR_INCLUDE_RACE:({"Elf", "Dunkelelf"}), 
    SR_INCLUDE_GUILD:({"Berserker"}), A_DEX: 20, A_STR: 25, P_LEVEL: 40, 
    P_QP: 500, SR_SEER: 1, P_XP: 8000000]) );
  SetProp(P_HIT_FUNC, TO);
  
  AddCmd( ({ "ausloescher" }), "ausloeschen");
  
  SetProp(P_COMBATCMDS, ([ "ausloescher":
    ([ C_MIN:20,
       C_AVG:30,
       C_MAX:40,
       C_DTYPES: ({DT_FIRE}) ]) ]) );
  SetProp(P_WIELD_FUNC, TO);
  
  zeit=time();
}

int WieldFunc(object ob, int silent)
{
  first_spell=time()+15;
  return 1;
}

ausloeschen(string str) 
{
  object enemy; 
  if(QueryProp(P_WIELDED) != TP) 
  {
  notify_fail(BS("Du musst die Axt erst zuecken!"));
  return 0; 
  }
  if(TP->QueryProp(P_SP) < KOSTEN) 
  {
  write(BS("Du hast nicht genuegend magische Energie um Deine Gegner "
  	   "auszuloeschen!"));
  return 1; 
  }
  if(first_spell > time()) 
  {
  write(BS("Elfentanz' Macht ist noch erschoepft."));
  return 1;
  }
  if(str) 
  {
  if(enemy=present(str, ENV(TP)))
    if(!interactive(enemy))
      return feuersturm(enemy);
  }
  if(enemy=TP->SelectEnemy())
   return feuersturm(enemy);
  write(BS("Gegen wen moechtest Du denn den Feuersturm richten?"));
  return 1;
}

feuersturm(object enemy)
{
  mapping spell_info;
  int schaden;
 
  schaden = 1;
  if(zeit > time())
  {
    write(BS("Elfentanz' Macht ist noch erschoepft."));
    return 1;
  }
  if(TP->QueryProp(P_ATTACK_BUSY)) 
  {
  write("Du bist im Moment zu sehr beschaeftigt.\n");
  return 1;
  }
  TP->SetProp(P_ATTACK_BUSY, 5);
  if((TP->QueryProp(P_SP))<KOSTEN)
  {
  write(BS("Du hast nicht genuegend magische Energie!"));
  return 1;
  }
  TP->restore_spell_points(-KOSTEN);
  if(!enemy)
  {
  write(BS("Gewaltige Flammenzuege umgeben Elfentanz' und verschwinden."));
  tell_room(ENV(TP), "Gewaltige Flammenzuege umgeben "+TPN+"'s Axt und "
  		     "verschwinden.\n", ({TP}));
  zeit = 2000+time();
  return 1;
  }
  printf(BS("Gewaltige Flammenzuege umgeben Elfentanz und verbrennen %s.\n"), 
    enemy->name(WEM));
  say(sprintf(BS("Gewaltige Flammenzuege aus "+TPN+"'s Axt treffen %s.\n"), 
    		 CAP(TPN), enemy->name(WEN) ), ({enemy, TP}) );
  tell_object(enemy, BS("Gewaltige Flammenzuege aus "+TPN+"'s Axt "
    		        "treffen Dich.\n"));
  schaden=200+random(200);
  spell_info=([SP_NAME : "feuersturm",
               SP_PHYSICAL_ATTACK : 0,
               SP_SHOW_DAMAGE : 1]);
  enemy->Defend(schaden, ({DT_FIRE}), spell_info, this_player());
  zeit = 2000+time();
  return 1;
}

int HitFunc(object enemy)
{
  int schaden;
  if(enemy->id("zwerg") )
    schaden=random(200);
    if(schaden>100)
      write("Elfentanz entfaltet seine Kraft in Deinen Haenden.\n");
    return 5*enemy->QueryProp(P_LEVEL)+schaden;
  return 0;
} 
