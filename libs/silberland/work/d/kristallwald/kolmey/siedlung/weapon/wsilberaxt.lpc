inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Weisssilberaxt");
  SetProp(P_LONG,  
    "Eine Weisssilberaxt.");
  
  SetProp(P_NAME, "Weisssilberaxt");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);
  AddId( ({"weisssilberaxt", "axt", "silberaxt"}) );
  
  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 280);
  SetProp(P_WC_FIX, 50);
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_SILVER:100]));
  SetProp(P_WEIGHT,4000);
  SetProp(P_VALUE, 5000);
  SetProp(P_QUALITY_DECAY, 20);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX: 28, A_STR: 28, P_LEVEL: 60, P_QP: 800, SR_SEER: 1, 
    P_XP: 50000000]) );
}