inherit "std/room";

#include "../siedlung.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{

::create();

/*-----------------------KURZ UND LANGBESCHREIBUNG-----------------------*/

   SetProp(P_INT_SHORT, "Rechter Wachturm im Waldelfendorf");
   SetProp(P_INT_LONG,
     "Du befindet nun auf dem rechten Wachturm.\n"
     "Um die quadratische Plattform laeuft ein Gelaender. An den Ecken "
     "befinden sich hoelzerne Pfosten, die ein Schutzdach tragen. Du "
     "hast von hier aus einen wunderbaren Ueberblick ueber den ganzen "
     "Kristallwald und das kleine Dorf, das von dem schuetzenden "
     "Wall umgeben ist.");
   
/*-----------------------RAUMEIGENSCHAFTEN-----------------------*/
   
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );
   SetProp(P_INDOORS, 0);
   SetProp(P_LOG_FILE, "/d/kristallwald/kolmey/room.log");

/*-----------------------RAUMDETAILS-----------------------*/
  
   AddDetail( ({ "himmel" }),
     "Wenn Du Dich ein bisschen nach vorne lehnst kannst Du den "
     "wolkenlosen Himmel betrachten, auf dem die Sonne hoch oben steht.");
   AddDetail ( ({ "sonne" }),
     "Die Sonne scheint am wolkenlosen Himmel.");
   AddDetail( ({ "wachturm" }),
     "Du stehst gerade auf dem rechten Wachturm.");
   AddDetail( ({ "boden" }),
     "Der Boden besteht aus einer quadratischen Holzplatte, die an "
     "ihren Ecken mit Holzpfosten bestueckt ist.");
   AddDetail( ({ "holzplatte", "platte", "plattform" }),
     "Eine einfache Platte aus Holz bildet den Boden des Wachturms und "
     "eine weitere Holzplatte, die an den Holzpfosten befestigt wurde "
     "dient als Dach.");
   AddDetail( ({ "holz" }),
     "Es scheint sich um Holz aus dem Wald zu handeln, da es ebenfalls "
     "mit einer duennen Kristallschicht ueberzogen ist.");
   AddDetail( ({ "kristallschicht" }),
     "Eine duenne, weissliche Kristallschicht befindet sich auf dem "
     "Holz.");
   AddDetail( ({ "holzpfosten" }),
     "An jeder Ecke der Holzplatte befindet sich ein Holzpfosten, die "
     "das Dach tragen und an denen das Gelaender befestigt wurde. "
     "an einem Pfosten faellt dir allerdings noch etwas anderes auf.");
   AddDetail( ({ "ecke", "ecken" }),
     "An den Ecken der Holzplatte befinden sich Holzpfosten die das Dach "
     "tragen und an denen das Gelaender befestigt wurde.");
   AddDetail( ({ "dach", "art", "schutzdach" }),
     "Eine weitere Holzplatte wird von den Holzpfosten getragen und dient "
     "als Dach um vor Witterungseinfluessen zu schuetzen.");
   AddDetail( ({ "witterungseinfluesse" }),
     "Regen, Hitze, und Wind halt.");
   AddDetail( ({ "regen" }),
     "Zum Glueck regnet es im Moment nicht, ansonsten wuerde das "
     "Dach zumindest einen Teil des Regens abweisen und so den "
     "Spaeher ein bisschen schuetzen.");
   AddDetail( ({ "glueck" }),
     "Du hast Glueck dass es im Moment schoen ist.");
   AddDetail( ({ "moment" }),
     "Im Moment gibt es weder Regen noch einen Sturm.");
   AddDetail( ({ "wind", "sturm" }),
     "Das Dach schuetzt auch vor Wind.");
   AddDetail( ({ "teil" }),
     "Das Dach wuerde einen Teil des Regens abweisen.");
   AddDetail( ({ "spaeher" }),
     "Jetzt gerade ist der Wachturm unbesetzt.");
   AddDetail( ({ "pfosten" }),
     "An einem Pfosten faellt Dir eine Schnitzerei auf.");
   AddDetail( ({ "schnitzerei" }),
     "Da hat jemand einen Text in einen Pfosten geschnitzt.");
   AddDetail( ({ "text" }),
     "Du koennstest ihn lesen!");
   
   AddReadDetail( ({ "text" }),
     "Hier steht:\n"
     "\n"
     "Tethra + Cute!");
   
   AddDetail( ({ "tethra, cute" }),
     "Die beiden sind wohl verliebt.");
   AddDetail( ({ "gelaender" }),
     "Ein Gelaender wurde an den Holzpfosten befestigt. Es dient "
     "wohl dazu das Runterfallen zu vermeiden.");
   AddDetail( ({ "runterfallen" }),
     "Pass bloss auf dass Du nicht runter faellst. Man kann naemlich "
     "ganz einfach durch das Gelaender hindurchschluepfen!");
   AddDetail( ({ "ueberblick" }),
     "Du hast von hier aus einen fabelhaften Ueberblick ueber den "
     "Kristallwald , das Dorf und dem Eingang. Auch zum linken Wachturm "
     "kannst Du hinueberspaehen.");
   AddDetail( ({ "kristallwald", "wald" }),
     "Du hast hier einen fabelhaften Ueberblick ueber den Kristallwald. "
     "Was ist das? Da hinten scheint eine Wiese zu sein. Die ist Dir "
     "bis jetzt noch garnicht aufgefallen!");
   AddDetail( ({ "wiese" }),
     "Du koenntest von hier aus zu der Wiese hinueberspaehen.");
   AddDetail( ({ "dorf", "waldelfendorf", "marktplatz" }),
     "Du kannst von hier aus auf den Marktplatz hinunterspaehen.");
   AddDetail( ({ "linker turm" }),
     "Du koenntest von hier aus zum linken Turm hinueberspaehen.");
   AddDetail( ({ "wall" }),
     "Rechts von Dir erstreckt sich der Wall aus kristallinen Pflanzen. "
     "Dieser scheint wirklich das ganze Dorf zu umgeben und es zu "
     "schuetzen.");
   AddDetail( ({ "pflanzen" }),
     "Der Wall besteht aus kristallinen Pflanzen.");
   AddDetail( ({ "ohr", "ohren" }), ([ 0: "Deine beiden Ohren sind noch "
   					  "dran.",
   		    "elf": "Du besitzt wunderschoene, zierliche Ohren."]));
   AddDetail( ({ "eingang" }),
     "Du kannst zum Eingang unter Dir hinunterspaehen.");

/*-----------------------GERAEUSCHE-----------------------*/
   
   AddSound(DEFAULT_SOUND,
     "Vom Marktplatz her dringt lautes Stimmenwirrwarr an Dein Ohr.");
   AddSound( ({ "marktplatz", "stimmenwirrwarr" }),
     "Am Marktplatz scheint einiges los zu sein.");

/*---------------------ITEMS CMDS EXITS---------------------*/
   
   AddCmd( ({ "spaehe", "spaeh" }), "cmd_see");
   AddCmd( ({ "schlupfe", "schlupf", "schluepfe", "schluepf" }), "cmd_fall");
              
   AddExit( "runter", "./eingang");

   AddItem(NPC("spaeher"), REFRESH_DESTRUCT);
   AddItem(NPC("schuetze"), REFRESH_DESTRUCT);
}
   
int cmd_see(string str)
{
   //Man kann vom Turm aus ein paar Raeume angucken
   object snoop_room;
   snoop_room=find_object(ROOM("lturm"));
   
   notify_fail(BS("Wohin moechtest Du denn spaehen?"));
   if(str == "zu linkem turm hinueber" || str == "zu linkem turm"
   || str == "zum linken turm hinueber" || str == "zum linken turm")
   {
   tell_object(TP,"\n"+snoop_room->QP(P_INT_SHORT)+".\n");
   tell_object(TP,"\n"+snoop_room->int_long(TP, TO));

   return 1;
}
   
   snoop_room=find_object(ROOM("dorf07"));
   
   notify_fail(BS("Wohin moechtest Du denn spaehen?"));
   if(str == "zu marktplatz hinunter" || str == "zu marktplatz"
   || str == "zum marktplatz hinunter" || str == "zum marktplatz")
   {
   tell_object(TP,"\n"+snoop_room->QP(P_INT_SHORT)+".\n");
   tell_object(TP,"\n"+snoop_room->int_long(TP, TO));

   return 1;
}

   snoop_room=find_object(ROOM("eingang"));
   
   notify_fail(BS("Wohin moechtest Du denn spaehen?"));
   if(str == "zum eingang hinunter" || str == "zum eingang runter"
   || str == "zu eingang hinunter" || str == "zu eingang runter")
   {
   tell_object(TP,"\n"+snoop_room->QP(P_INT_SHORT)+".\n");
   tell_object(TP,"\n"+snoop_room->int_long(TP, TO));

   return 1;
}

   snoop_room=find_object(WALD("wiese"));
   
   notify_fail(BS("Wohin moechtest Du denn spaehen?"));
   if(str == "zu wiese hinueber" || str == "zu wiese"
   || str == "zur wiese hinueber" || str == "zur wiese")
   {
   tell_object(TP,"\n"+snoop_room->QP(P_INT_SHORT)+".\n");
   tell_object(TP,"\n"+snoop_room->int_long(TP, TO));

   return 1;
   }
  return 0;
}

int cmd_fall(string str)
{  
   //Wenn man unbedingt will, kann man zwischen dem Gelaender durchschluepfen
   //faellt runter und tut sich weh... Man kann sogar dran sterben
   notify_fail(BS("Wo moechtest Du durchschlupfen?"));
   if(!(str == "durch gelaender" || str == "durch gelaender durch"))
   {
     return 0;
   }
   write(BS("Du passt nicht auf, schluepfst durch das Gelaender "
   	    "durch und faellst hinunter."));
   TP->move(ROOM("eingang"), M_GO | M_NO_SHOW, 0, 
          "schluepft zwischen dem Gelaender durch und faellt hinunter", 
          "knallt auf den Boden");
   SetProp(P_KILL_NAME, "Jugendlicher Leichtsinn");
   TP->do_damage(20+random(30));
   return 1;
}