inherit "std/room";

#include "../siedlung.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

mapping dieb;
mapping oeffner;

create()
{

::create();

/*-----------------------KURZ UND LANGBESCHREIBUNG-----------------------*/

   SetProp(P_INT_SHORT, "Wachhuette im Waldelfendorf");
   SetProp(P_INT_LONG,
     "Du stehst nun in einer Huette im Waldelfendorf die wohl als "
     "Wachhuette dient. Gegenueber dem Eingang befindet sich ein "
     "grosser Schreibtisch. An der Wand dahinter, neben einem Fenster, "
     "steht ein grosser Waffenstaender. Eine Urkunde haengt an der "
     "Ostwand ueber einer Kommode. Durch das Fenster stroemt das noetige "
     "Licht um den Raum zu erhellen.");
   
/*-----------------------RAUMEIGENSCHAFTEN-----------------------*/
   
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );
   SetProp(P_INDOORS, 1);
   SetProp(P_LOG_FILE, "/d/kristallwald/kolmey/siedlung/log/wachraum.log");
   
/*-----------------------RAUMDETAILS-----------------------*/
   
   AddDetail( ({ "huette", "wachhuette", "raum" }), TO->QP(P_INT_LONG));
   
   AddDetail( ({ "waldelfendorf", "dorf" }),
     "Du befindest Dich gerade im Waldelfendorf.");
   AddDetail( ({ "anschein" }),
     "Allem Anschein nach dient diese Huette als Wachhuette.");
   AddDetail( ({ "schreibtisch" }),
     "Ein grosser Schreibtisch aus Holz, mit zahlreichen Schubladen, "
     "befindet sich gleich gegenueber von Dir. Hinter ihm steht ein "
     "Sessel.");
   AddDetail( ({ "holz" }),
     "Dieses Holz scheint nicht aus dem Kristallwald zu kommen, denn "
     "es traegt keine Kristallschicht, so wie das restliche Holz hier "
     "im Dorf.");
   AddDetail( ({ "kristallwald" }),
     "Der Kristallwald befindet sich ausserhalb des Dorfes. Wenn Du "
     "aus dem Dorf gehst erkennst Du sicher mehr.");
   AddDetail( ({ "kristallschicht" }),
     "Das Holz hier traegt keine Kristallschicht so wie das restliche "
     "Holz dass hier im Dorf verwendet wurde. Ob es wohl aus dem Silberwald "
     "kommt?");
   AddDetail( ({ "silberwald" }),
     "Der Silberwald befindet sich westlich von Midas."
     "Es waere gut moeglich, dass es sich hier um Holz aus dem Silberwald "
     "handelt, denn dieses Holz traegt keine Kristallschicht.");
   AddDetail( ({ "midas", "hauptstadt" }),
     "Midas ist die Hauptstadt des SilberLandes.");
   AddDetail( ({ "silberland" }),
     "Wie? Du weisst nicht was das SilberLand ist??");
   AddDetail( ({ "schubladen" }),
     "Im Schreibtisch sind einige Schubladen. Was da wohl drinnen ist?");
   AddDetail( ({ "sessel" }),
     "Ein hoelzerner Sessel steht hinter dem Schreibtisch und dient "
     "wohl dazu in Ruhe hier arbeiten zu koennen.");
   AddDetail( ({ "ruhe" }),
     "Na, wenn Du hier so laut herumforschst wird der Wachmann bestimmt "
     "nicht in Ruhe arbeiten koennen.");
   AddDetail( ({ "wachmann", "moment", "wache", "wachen" }),
     "Im Moment scheint niemand da zu sein.");
   AddDetail( ({ "nordwand" }),
     "An der Nordwand hinter dem Schreibtisch kannst Du einen grossen "
     "Waffenstaender sehen neben dem ein Fenster in die Wand eingesetzt "
     "wurde.");
   AddDetail( ({ "ostwand" }),
     "An der Ostwand befindet sich eine Kommode ueber der eine Urkunde "
     "haengt.");
   AddDetail( ({ "suedwand" }),
     "In der Suedwand befindet sich ein Durchgang.");
   AddDetail( ({ "westwand" }),
     "An der Westwand befindet sich nichts interessantes.");
   AddDetail( ({ "waende" }),
     "Die Waende hier bestehen aus Holz.");
   AddDetail( ({ "wand" }),
     "Welche Wand meinst Du denn? Es gibt eine Nordwand, eine Suedwand, "
     "eine Ostwand und eine Westwand.");
   AddDetail( ({ "boden" }),
     "Der Boden besteht aus sauber polierten Holzplatten.");
   AddDetail( ({ "holzplatten", "platten" }),
     "Einfache Platten aus Holz bilden den Boden.");
   AddDetail( ({ "decke" }),
     "Die Decke hier besteht aus Holz. An ihr wurde ein Kerzenhalter "
     "befestigt.");
   AddDetail( ({ "kerzenhalter" }),
     "Ein eiserner Kerzenhalter wurde an der Decke befestigt. In ihm "
     "stehen vier Kerzen, die wohl den Raum mit Licht versorgen "
     "sobald Dunkelheit eintritt.");
   AddDetail( "dunkelheit", ([ 0: "Jetzt gerade ist es noch hell.",
    		     "dunkelelf": "Du sehnst Dich schon nach Dunkelheit."]));
   AddDetail( ({ "fenster" }),
     "Ein Fenster befindet sich in der Nordwand neben dem Waffenstaender. "
     "Es versorgt den Raum mit dem noetigen Licht.");
   AddDetail( ({ "licht", "sonnenlicht" }),
     "Sonnenlicht stroehmt durch das Fenster in den Raum und erhellt ihn.");
   AddDetail( ({ "kerzen" }),
     "Vier Kerzen befinden sich in dem Kerzenhalter an der Decke. "
     "Sie versorgen den Raum mit Licht, sobald Dunkelheit eintritt.");
   AddDetail( ({ "waffenstaender" }),
     "Der hoelzerne Waffenstaender befindet sich an der Suedwand. "
     "In ihm sind einige Boegen aufgehaengt worden. Weiters erkennst "
     "Du noch ein paar Schwerter.");
   AddDetail( ({ "boegen" }),
     "Kunstvoll geschnitzte Boegen mit starken Sehnen. Die werden wohl "
     "fuer die Wachen sein, die ihren Dienst erst antreten.");
   AddDetail( ({ "sehnen" }),
     "Die Boegen wurden mit starken Sehnen bespannt. Mit ihnen lassen "
     "sich Pfeile bestimmt kraftvoll und zielgenau abschiessen.");
   AddDetail( ({ "pfeile" }),
     "Pfeile siehst Du hier keine, wo die wohl sind?");
   AddDetail( ({ "schwerter" }),
     "Einige Holzschwerter befinden sich neben den Boegen im "
     "Waffenstaender.");
   AddDetail( ({ "holzschwerter" }),
     "Einige Holzschwerter befinden sich in dem Waffenstaender. "
     "Taeusche Dich nicht! Die Klingen der Holzschwerter sind extrem "
     "scharf geschliffen. Auch wenn diese nur aus Holz bestehen kann "
     "man mit ihnen sicherlich erheblichen Schaden anrichten.");
   AddDetail( ({ "klingen" }),
     "Die Klingen der Holzschwerter sind extrem scharf geschliffen "
     "worden. Drum kann man mit ihnen bestimmt erheblichen Schaden "
     "anrichten.");
   AddDetail( ({ "schaden" }),
     "Du moechtest lieber nicht ausprobieren welchen Schaden die Schwerter "
     "anrichten koennen. Wenn doch musst Du nur eine Wache angreifen.");
   AddDetail( ({ "dienst" }),
     "Es wird bestimmt noch einige Wachen geben, die ihren Dienst erst "
     "antreten.");
   AddDetail( ({ "durchgang", "eingang" }),
     "In der Suedwand befindet sich ein Durchgang der Dich zurueck ins "
     "Dorf fuehrt.");
   AddDetail( ({ "himmel" }), 
     "Sowas siehst Du da nicht!");
   AddDetail( ({ "kommode" }),
     "An der Ostwand befindet sich eine hoelzerne Kommode, doch Deine "
     "Aufmerksamkeit faellt eher auf die Urkunde, die ueber ihr haengt.");
   AddDetail( ({ "aufmerksamkeit" }),
     "Die Urkunde, die ueber der Kommode an der Ostwand haengt erregt "
     "Deine Aufmerksamkeit.");
   AddDetail( ({ "urkunde" }),
     "Eine Urkunde haengt in einem schoenen Bilderrahmen an der Ostwand. "
     "Du koennstest sie lesen.");
   AddDetail( ({ "bilderrahmen", "rahmen" }),
     "Die Urkunde muss wohl etwas besonderes sein, denn sie wurde "
     "in einen hoelzernen Bilderrahmen gesteckt, der schoene "
     "Verzierungen aufweist und ziemlich wertvoll aussieht.");
   AddDetail( ({ "verzierungen" }),
     "Der Bilderrahmen weist schoene Schnitzereien auf. Der, der ihn "
     "gemacht hat muss sein Handwerk sehr gut verstehen.");
   AddDetail( ({ "schnitzereien" }),
     "Es wurden schoene Schwerter und Boegen in den Rahmen geschnitzt. "
     "Er sieht ziemlich wertvoll aus.");
   AddDetail( ({ "handwerk" }),
     "So etwas zu schnitzen kann nicht einfach sein.");
   
   AddReadDetail( ({ "urkunde" }),
     "Hier steht:\n"
     "\n"
     "Fuer Jethro, fuer seine wertvollen Dienste zur Sicherheit\n"
     "unseres schoenen Dorfes.\n"
     "\n"
     "Gezeichnet: Siilaril, die Waldelfe.\n");
   
   AddDetail( ({ "dhala", "waldelfe" }),
     "Dhala scheint eine sehr wichtige Person hier im Dorf zu sein.");
   AddDetail( ({ "person" }),
     "Vielleicht kann Dir ja ein Waldelf etwas ueber Dhala erzaehlen.");
   AddDetail( ({ "jethro" }),
     "Jethro scheint der Oberwachmann zu sein.");
   AddDetail( ({ "oberwachmann" }),
     "Jethro scheint der Oberwachmann zu sein.");
   AddDetail( ({ "sicherheit" }),
     "Nun, die Wachen hier scheinen die Sicherheit des Dorfes zu "
     "gewaehrleisten.");
   AddDetail( ({ "schreibtisch" }),
     "Ein grosser Schreibtisch befindet sich an der Nordwand. Einige "
     "Schubladen befinden sich in ihm.");

/*---------------------ITEMS CMDS EXITS---------------------*/
   
   AddExit( "sueden", "./dorf07");
   
   AddCmd( ({ "oeffne" }), "cmd_open");
   AddCmd( ({ "stehle", "stehl", "stiehl" }), "cmd_steal");
  
   AddItem(NPC("waechter"), REFRESH_DESTRUCT)
     ->SetProp(P_SHORT, "Ein Waldelfenwaechter sitzt gemuetlich "
     			"auf einem Sessel");
   AddItem(NPC("jethro"), REFRESH_DESTRUCT);
   
   dieb    = ([]);
   oeffner = ([]);
}

reset()
{
   ::reset();
   dieb    = ([]);
   oeffner = ([]);
}

int cmd_steal(string str)
{  
   //Man kann einen Bogen stehlen wenn kein Waechter da ist
   object ob;
   string spieler;
   spieler=getuid(TP);
   notify_fail(BS("Was moechtest Du denn stehlen?"));
   if(str == "bogen" || str == "bogen aus staender" || 
   	str == "bogen aus waffenstaender")
   {
   if(present("waechter", (TO)))
   {
      write(BS("Du kannst hier nichts stehlen, solange Dir der "
      	       "Waechter auf die Finger schaut!"));
      return 1;
   }
   if(!member(dieb, spieler))
   {
     dieb+=([spieler: 0]);
   }
   if(dieb[spieler, 0]>=1)
   {
     write(BS("Im moment befindet sich kein Bogen im Waffenstaender!"));
     return 1;
   }
   else
   {
      dieb[spieler, 0]++;
      write(BS("Du stiehlst Dir einen Bogen aus dem Waffenstaender."));
      tell_room(ENV(TP), TPN+" stiehlt einen Bogen aus dem "
      			     "Waffenstaender.\n", ({TP}));
      ob=clone_object(WEAPON("schuetzenbogen"))->move(TP, M_GET);
      return 1;
      }
    }
    if(str == "schwert" || str == "schwert aus staender" || 
   	str == "schwert aus waffenstaender")
    {
    if(present("waechter", (TO)))
    {
      write(BS("Du kannst hier nichts stehlen, solange Dir der "
      	       "Waechter auf die Finger schaut!"));
      return 1;
    }
    else
    {
      write(BS("Die Schwerter sind allesamt befestigt, Du kannst keins "
      	       "stehlen. Die Boegen jedoch scheinen nicht befestigt zu "
      	       "sein."));
      return 1;
      }
    return 0;
    }
}

int cmd_open(string str)
{  
   //Auch die Schubladen kann man oeffnen wenn kein Waechter da
   //ist. Man bekommt random Muenzen daraus
   string spieler;
   spieler=getuid(TP);
   notify_fail(BS("Was moechtest Du den oeffnen?"));
   if(!(str == "schublade" || "lade" ))
   {
     return 0;
   }
   if(present("waechter", (TO)))
   {
      write(BS("Du kannst die Schubladen nicht oeffnen, solange Dir der "
      	       "Waechter auf die Finger schaut!"));
      return 1;
   }
   if(!member(oeffner, spieler))
   {
     oeffner+=([spieler: 0]);
   }
   if(oeffner[spieler, 0]>=1)
   {
     write(BS("Du oeffnest die Schublade. Jedoch ist diese leider "
     	      "leer. Enttaeuscht schliesst Du sie wieder."));
     return 1;
   }
   else
   {
      oeffner[spieler, 0]++;
      write(BS("Du oeffnest die Schublade und entdeckst einige Muenzen, "
      	       "die Du gleich einsteckst. Du schliesst Die Lade wieder."));
      tell_room(ENV(TP), TPN+" oeffnet eine Schublade, nimmt sich grinsend "
      			     "ihren Inhalt und schliesst sie "
      			     "wieder.\n", ({TP}));
      TP->AddMoney(200+random(3000));
      return 1;
    }
}