inherit "std/room";

#include "../siedlung.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

create()

{
::create();

/*-----------------------KURZ UND LANGBESCHREIBUNG-----------------------*/

   SetProp(P_INT_SHORT, "Im Waldelfendorf");
   SetProp(P_INT_LONG,
     "Du stehst auf einer kleinen Strasse mitten im Waldelfendorf.\n"
     "Die Kristallschicht, die auch hier die Strasse ueberzieht "
     "glitzert in zahlreichen Farben. Die Strasse selbst "
     "fuehrt Dich weiter nach Westen zum Marktplatz, nach Sueden "
     "bringt sie Dich zu einem weiteren Platz und nach Nordosten "
     "bringt sie Dich in einen anderen Abschnitt des Dorfes. Dazwischen "
     "verhindert ein dichter Wall aus kristallinen Hecken und Straeuchern "
     "ein Weiterkommen. Gleich neben der Strasse, auf noerdlicher Seite, "
     "steht eine Huette.");
   
/*-----------------------RAUMEIGENSCHAFTEN-----------------------*/
   
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );
   SetProp(P_INDOORS, 0);
   SetProp(P_LOG_FILE, "/d/kristallwald/kolmey/room.log");

/*-----------------------RAUMDETAILS-----------------------*/
   
   AddDetail( ({ "waldelfendorf", "dorf" }),
     "Du stehst mitten drin.");
   AddDetail( ({ "sonne" }),
     "Die Sonne steht hoch am wolkenlosen Himmel und sendet ihre "
     "waermenden Strahlen zu Dir herab.");
   AddDetail( ({ "himmel" }),
     "Von hier aus hast Du einen wunderbaren Blick ueber den blauen, "
     "wolkenlosen Himmel ausdem Dir die Sonne entgegen lacht.");
   AddDetail( ({ "blick" }),
     "Du kannst von hier aus den Himmel wunderbar betrachten.");
   AddDetail( ({ "sonnenlicht", "licht" }),
     "Die Sonne spendet hier ihr waermendes Licht und laesst die Strasse "
     "in zahlreichen Farben funkeln.");
   AddDetail( ({ "strahlen", "sonnenstrahlen" }),
     ([ 0: "Die Sonne schickt ihre Strahlen und erwaermt damit Deine Haut.",
     "dunkelelf": "Igitt! Die Sonnenstrahlen erwaermen Deine Haut! "
     		  "Du solltest besser wieder zurueck in die Unterwelt "
     		  "gehen, ehe Du noch Schaden davon traegst."]));
   AddDetail( "schaden", ([ 0: "Sowas siehst Du da nicht!",
     "dunkelelf": "Naja, man weiss ja nicht was die Sonne so alles "
     	          "aus Deiner weissen Haut machen wird."]));
   AddDetail( "haut", ([ 0: "Deine Haut wird schon etwas braun.",
     "dunkelelf": "Pfoah! Deine Haut wird schon leicht dunkler!"]));
   AddDetail( "unterwelt", ([ 0: "Sowas siehst Du da nicht!",
     "dunkelelf": "Da ist es schoen dunkel, genau das richtige fuer "
     		  "Dich."]));
   AddDetail( ({ "strasse", "boden" }),
     "Eine schmale Strasse fuehrt durch das Dorf. Sie wurde mit weissen "
     "Steinplatten ausgelegt und traegt eine duenne, weissliche "
     "Kristallschicht. Durch das Sonnenlicht hier, "
     "glitzert die Strasse wunderschoen. Ja, es scheint die Steinplatten "
     "selbst wuerden aus Kristall bestehen.");
   AddDetail( ({ "kristallwald" }),
     "Der Kristallwald befindet sich ausserhalb des Dorfes.");
   AddDetail( ({ "steinplatten" }),
     "Die Strasse wurde mit weissen Steinplatten ausgelegt, die mit einer "
     "duennen Kristallschicht ueberzogen sind. Durch das "
     "Sonnenlicht funkelt und glitzert sie in zahlreichen Farben. "
     "Ein wahrhaft wunderschoener Anblick.");
   AddDetail( ({ "kristallschicht" }),
     "Vieles hier traegt eine duenne Kristallschicht und funkelt und "
     "glitzert in den schoensten Farben.");
   AddDetail( ({ "farben" }),
     "Rot, Blau, Gruen und viele mehr.");
   AddDetail( ({ "rot", "blau", "gruen" }),
     "Ein wunderschoener Anblick!");
   AddDetail( ({ "anblick" }),
     "Das funkeln und glitzern des Kristalls durch das Sonnenlicht bietet "
     "einen wunderschoenen Anblick.");
   AddDetail( ({ "kristall" }),
     "Vieles hier wurde vom Kristall ueberzogen. Woher das wohl kommen "
     "mag?");
   AddDetail( ({ "wall" }),
     "Kristalline Straeucher und Hecken bilden einen regelrechten "
     "Wall rund um das Dorf und machen Dir ein Weiterkommen in andere "
     "Richtungen ausser dem Strassenverlauf unmoeglich.");
   AddDetail( ({ "straeucher", "hecken", "teil" }),
     "Die Straeucher und Hecken sind noch Teil des Kristallwaldes, "
     "der sich rund um das Dorf befindet.");
   AddDetail( ({ "weiterkommen" }),
     "Du kannst allerhoechstens der Strasse folgen, denn die Hecken und "
     "Straeucher aus denen der Wall besteht machen ein Weiterkommen "
     "in andere Richtungen unmoeglich.");
   AddDetail( ({ "richtungen"}),
     "Du kannst hier nach Sueden, Nordosten und Westen gehen.");
   AddDetail( ({ "abschnitt" }),
     "Dazu muesstest du schon nach Nordosten gehen, denn Du kannst von "
     "hier aus nicht viel erkennen.");
   AddDetail( ({ "nordosten" }),
     "Du kannst von hier aus nicht viel erkennen.");
   AddDetail( ({ "sueden" }),
     "Im Sueden befindet sich ein weiterer, unscheinbarer Platz.");
   AddDetail( ({ "westen" }),
     "Nach Westen geht es zu einem kleinen Platz, auf dem sich ein "
     "Brunnen zu befinden scheint.");
   AddDetail( ({ "platz" }),
     "Ein Platz ist im Westen und ein weiterer im Sueden, Du kannst aber "
     "von hier aus nicht sehr viel erkennen.");
   AddDetail( ({ "brunnen" }),
     "Der Brunnen befindet sich auf dem Platz im Westen.");
   AddDetail( ({ "seite" }),
     "Neben der Strasse, auf der noerdlichen Seite, steht eine Huette.");
   AddDetail( ({ "waldelfen", "waldelfenfamilie" }),
     "In der Huette lebt bestimmt eine Waldelfenfamilie.");
   AddDetail( ({ "tuer" }),
     "Die Tuer ist geschlossen. Vielleicht koenntest Du sie oeffnen? "
     "Aber waere das nicht Hausfriedensbruch?");
   AddDetail( ({ "hausfriedensbruch" }),
     "Natuerlich waere das Hausfriedensbruch, einfach in eine Huette zu "
     "gehen, die Dir nicht gehoert! Aber das musst Du schon fuer Dich "
     "selbst entscheiden.");
   AddDetail( ({ "strassenverlauf", "verlauf" }),
     "Die Strasse verlaeuft hier von Westen nach Nordosten und hat eine "
     "kleine Abzweigung nach Sueden.");
   AddDetail( ({ "abzweigung" }),
     "Die Strasse zweigt hier nach Sueden, zu einem abgeschiedenen "
     "Platz, ab.");
   AddDetail( ({ "huette" }),
     "Eine Huette steht neben der Strasse auf noerdlicher Seite. "
     "Wahrscheinlich wohnen hier Waldelfen drinnen. Die Tuer ist "
     "geschlossen. Ein kleines Fenster befindet sich neben der Tuer.");
   AddDetail( ({ "seite" }),
     "Neben der Strasse, auf der noerdlichen Seite, steht eine Huette.");
   AddDetail( ({ "waldelfen", "waldelfenfamilie" }),
     "In der Huette lebt bestimmt eine Waldelfenfamilie.");
   AddDetail( ({ "tuer" }),
     "Die Tuer ist geschlossen. Vielleicht koenntest Du sie oeffnen? "
     "Aber waere das nicht Hausfriedensbruch? Neben der Tuer "
     "ist ein kleines Fenster.");
   AddDetail( ({ "hausfriedensbruch" }),
     "Natuerlich waere das Hausfriedensbruch, einfach in eine Huette zu "
     "gehen, die Dir nicht gehoert! Aber das musst Du schon fuer Dich "
     "selbst entscheiden.");
   AddDetail( ({ "fenster" }),
     "Ein kleines Fenster befindet sich neben der Tuer in der Huette. "
     "Vielleicht koenntest Du durch das Fenster ins Innere des Hauses "
     "spaehen?");
   AddDetail( ({ "marktplatz" }),
     "Ein Marktplatz scheint sich im Westen zu befinden.");

/*-----------------------GERAEUSCHE-----------------------*/
   
   AddSound(DEFAULT_SOUND,
     "Im Westen scheint einiges los zu sein.");

/*---------------------ITEMS CMDS EXITS---------------------*/
 
   AddCmd( ({ "spaeh", "spaehe" }), "cmd_see");
   AddCmd( ({ "oeffne" }), "cmd_open");
   
   AddExit( "westen", "./dorf07" );
   AddExit( "sueden", "./dorf09" );
   AddExit( "nordosten", "./dorf04" );   

   AddItem(NPC("waldelf"), REFRESH_DESTRUCT)->activate_walk();
   AddItem(NPC("waldelfe"), REFRESH_DESTRUCT)->activate_walk();
}

int cmd_see(string str)
{
   //Man kann hier in ein Haus hineinspaehen... kleines Feature
   notify_fail(BS("Wodurch moechtest Du denn in was hineinspaehen?"));
   if(str == "durch fenster in huette" || 
      str == "durch fenster in huette hinein")
   {
      write(BS("Viel kannst Du durch das kleine Fenster nicht erkennen. "
               "Du solltest wohl besser in die Huette hinein gehen um mehr "
               "zu sehen. Jedoch waere dass Hausfriedensbruch."));
      return 1;
   }
   return 0;
}

int cmd_open(string str)
{  
   //Das Betreten der Huette ist im Gegenteil zu dorf06
   //Hier nicht moeglich -> Man wird automatisch rausgeworfen
   notify_fail(BS("Was moechtest Du denn oeffnen?"));
   if(!(str == "tuer" || str == "holztuer" || str == "holztuere" || 
      str == "tuere"))
   return 0;
   {
      write(BS("Als Du die Tuer oeffnest und das Haus betrittst, klopft "
      	       "Dir ploetzlich ein Waldelfenwaechter auf die Schulter, "
      	       "packt Dich und befoerdert Dich aus dem Dorf. "
      	       "Da siehst Du, was Du von Hausfriedensbruch hast.")+"\n");
      TP->move(ROOM("eingang"), M_GO);
      }
   return 1;
}
