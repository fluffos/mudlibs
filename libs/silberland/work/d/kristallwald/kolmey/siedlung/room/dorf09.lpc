inherit "std/room";

#include "../siedlung.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

void delayedwrite(object spieler, int curpos, mixed *daten);

mapping quest;

create()
{

::create();

/*-----------------------KURZ UND LANGBESCHREIBUNG-----------------------*/

   SetProp(P_INT_SHORT, "Im Waldelfendorf");
   SetProp(P_INT_LONG,
     "Du befindest Dich auf einem kleinen Platz im Dorf neben einem "
     "ziemlich hohen Baum. Ausser ihm scheint sich hier "
     "nicht viel zu befinden. Der Wall der das Dorf umgibt, versperrt "
     "Dir auch hier den Weg in andere Richtungen als auf der Strasse "
     "die Dich nach Norden wieder ins belebtere Dorf fuehrt. Du hast "
     "auch hier freien Blick auf den Himmel.");
   
/*-----------------------RAUMEIGENSCHAFTEN-----------------------*/
   
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );
   SetProp(P_INDOORS, 0);
   SetProp(P_LOG_FILE, "/d/kristallwald/kolmey/room.log");

/*-----------------------RAUMDETAILS-----------------------*/
   
   AddDetail( "platz", TO->QP(P_INT_LONG));
   
   AddDetail( ({ "waldelfendorf", "dorf" }),
     "Du stehst mitten drin.");
   AddDetail( ({ "sonne" }),
     "Die Sonne steht hoch am wolkenlosen Himmel und sendet ihre "
     "waermenden Strahlen zu Dir herab.");
   AddDetail( ({ "himmel" }),
     "Von hier aus hast Du einen wunderbaren Blick ueber den blauen, "
     "wolkenlosen Himmel ausdem Dir die Sonne entgegen lacht.");
   AddDetail( ({ "blick" }),
     "Du kannst von hier aus den Himmel wunderbar betrachten.");
   AddDetail( ({ "strahlen", "sonnenstrahlen" }),
     ([ 0: "Die Sonne schickt ihre Strahlen und erwaermt damit Deine Haut.",
     "dunkelelf": "Igitt! Die Sonnenstrahlen erwaermen Deine Haut! "
     		  "Du solltest besser wieder zurueck in die Unterwelt "
     		  "gehen, langsam traegst Du schon Schaden davon."]));
   AddDetail( "schaden", ([ 0: "Sowas siehst Du da nicht!",
     "dunkelelf": "Lange wird Deine Haut der Sonne nichtmehr standhalten "
     "koennen."]));
   AddDetail( "haut", ([ 0: "Deine Haut wird schon etwas braun.",
     "dunkelelf": "Pfoah! Deine Haut wird schon leicht dunkler!"]));
   AddDetail( "unterwelt", ([ 0: "Sowas siehst Du da nicht!",
     "dunkelelf": "Da ist es schoen dunkel, genau das richtige fuer "
     		  "Dich."]));
   AddDetail( ({ "strasse", "weg" }),
     "Eine schmale Strasse fuehrt quer durch das Dorf. Sie wurde mit "
     "weissen Steinplatten ausgelegt und traegt eine duenne, weissliche "
     "Kristallschicht. Durch das Sonnenlicht hier, "
     "glitzert die Strasse wunderschoen.");
   AddDetail( ({ "steinplatten" }),
     "Die Strasse und der Platz wurden mit weissen Steinplatten ausgelegt, "
     "die mit einer duennen Kristallschicht ueberzogen sind. Durch das "
     "Sonnenlicht funkelt und glitzert sie in zahlreichen Farben. "
     "Ein wahrhaft wunderschoener Anblick.");
   AddDetail( ({ "kristallschicht" }),
     "Vieles hier traegt eine duenne Kristallschicht und funkelt und "
     "glitzert in den schoensten Farben.");
   AddDetail( ({ "farben" }),
     "Rot, Blau, Gruen und viele mehr.");
   AddDetail( ({ "rot", "blau", "gruen" }),
     "Ein wunderschoener Anblick!");
   AddDetail( ({ "anblick" }),
     "Das funkeln und glitzern des Kristalls durch das Sonnenlicht bietet "
     "einen wunderschoenen Anblick.");
   AddDetail( ({ "kristall" }),
     "Vieles hier wurde vom Kristall ueberzogen. Woher das wohl kommen "
     "mag?");
   AddDetail( ({ "wall" }),
     "Kristalline Straeucher und Hecken bilden einen regelrechten "
     "Wall rund um das Dorf und machen Dir ein Weiterkommen in andere "
     "Richtungen ausser der Strasse unmoeglich.");
   AddDetail( ({ "straeucher", "hecken", "teil" }),
     "Die Straeucher und Hecken sind noch Teil des Kristallwaldes, "
     "der sich rund um das Dorf befindet.");
   AddDetail( ({ "weiterkommen" }),
     "Du kannst allerhoechstens der Strasse folgen, denn die Hecken und "
     "Straeucher aus denen der Wall besteht machen ein Weiterkommen "
     "in andere Richtungen unmoeglich.");
   AddDetail( ({ "richtungen"}),
     "Du kannst hier nach Norden gehen.");
   AddDetail( ({ "norden" }),
     "Im Norden kommst Du ueber die Strasse wieder ins belebtere Dorf "
     "zurueck.");
   AddDetail( ({ "kristallwald" }),
     "Der Kristallwald befindet sich ausserhalb des Dorfes.");
   AddDetail( ({ "sonnenlicht", "licht" }),
     "Die Sonne spendet hier ihr waermendes Licht und laesst die Strasse "
     "und den Platz in zahlreichen Farben funkeln.");
   AddDetail( ({ "boden" }),
     "Der Boden wird hier durch den quadratischen Platz gebildet. "
     "Er wurde mit Steinplatten ausgelegt.");
   AddDetail( ({ "baum" }),
     "Hier auf dem Platz befindet sich ein ziemlich hoher Baum neben Dir. "
     "Er bietet Dir einen seltsamen Anblick. Der Stamm ist so dick, dass Du "
     "ihn niemals umfassen koenntest, hoch, sodass Du sein Ende nicht "
     "entdecken magst und was das merkwuerdigste daran ist, er traegt "
     "keine Aeste, Blaetter oder sonstiges.");
   AddDetail( ({ "stamm" }),
     "Der Stamm des Baumes ist extrem dick, extrem hoch und traegt weder "
     "Aeste noch Blaetter. Rund um ihn fuehrt eine Wendeltreppe nach oben.");
   AddDetail( ({ "wendeltreppe" }),
     "Durch die Wendeltreppe gelangst Du auf den Baum hinauf, "
     "was von hier unten eher unerreichbar zu sein scheint.");
   AddDetail( ({ "aeste", "blaetter" }),
     "Weder Aeste noch Blaetter befinden sich an dem riesigen Stamm.");
   AddDetail( ({ "ende" }),
     "Du kannst das Ende des Baumes nicht erkennen, er ist einfach zu "
     "hoch.");

/*-----------------------GERAEUSCHE-----------------------*/
   
   AddSound(DEFAULT_SOUND,
     "Einige Geraesche dringen von Norden herein.");
   AddSound( ({ "norden" }),
     "Im Norden scheint einiges los zu sein!");

/*---------------------ITEMS CMDS EXITS UND MAPPINGS---------------------*/
   
   AddExit("norden", "./dorf08");
   
   AddSpecialExit("wendeltreppe", "wendeltreppe");
   
   quest = ([]);
}

void reset()
{
   ::reset();
   quest = ([]);
}

int wendeltreppe(string dir)
{  
   if(TP->QP(P_ALIGN)<=500)
   {
   write("Eine leise Stimme fluestert: Um den Turm erklimmen zu koennen musst Du\n"
   	 "Eine leise Stimme fluestert: besserer Gesinnung sein...\n");
   return 1;
   }
   else
   {
   TP->move(ROOM("fake"), M_GO | M_SILENT);
   delayedwrite(TP, 0, ({
     0, "Du beginnst ueber die Wendeltreppe nach oben zu gehen.",
     4, "#Vorsichtig nimmst Du eine Stufe nach der Anderen.",
     2, "#Endlos scheint die Treppe nach oben zu fuehren. "
   	"Kein Ende in Sicht.",
     4, "#Es scheint Dir, als wuerde eine Ewigkeit vergehen, "
   	"doch siehe Da, Du erreichst das Ende der Wendeltreppe...",
     0, "@@moving@@"}));
     return 1;
   }
}

string moving()
{
  TP->move(ROOM("plattform"), M_GO | M_SILENT);
  TP->do_exhaust(200);
  tell_room(ENV(TP), TPN+" kommt von unten herauf.", ({TP}));
  return "";
}

void delayedwrite(object spieler, int curpos, mixed *daten)
{
  string output;
  if (!spieler) return;
  
  output = process_string(daten[curpos+1]);
  if (output[0] == 35) {
    tell_object(spieler, "\n");
    tell_object(spieler, BS(output[1..]));
  } else {
    tell_object(spieler, BS(output));
  }
  if (curpos + 2 < sizeof(daten))
    call_out("delayedwrite", daten[curpos+2], spieler, curpos+2, daten);
}