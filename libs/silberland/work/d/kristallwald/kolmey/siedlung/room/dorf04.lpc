inherit "std/room";

#include "../siedlung.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

create()

{

::create();

/*-----------------------KURZ UND LANGBESCHREIBUNG-----------------------*/

   SetProp(P_INT_SHORT, "Im Waldelfendorf");
   SetProp(P_INT_LONG,
     "Du stehst auf einer kleinen Strasse mitten im Waldelfendorf.\n"
     "Obwohl nur wenige Sonnenstrahlen durch die Blaetter fallen, glitzert "
     "die Kristallschicht, die auf der Strasse liegt, auch hier in allen "
     "Farben. Du wirst von einem Wall aus kristallinen Hecken und "
     "Straeuchern umgeben, der nur auf der Strasse ein Weiterkommen "
     "ermoeglicht. Der Weg selbst fuehrt Dich weiter nach Westen zu "
     "einem kleinen Haus und nach Suedwesten weitet er sich zu einem "
     "Platz aus. Gleich neben der Strasse, oestlich von Dir, steht eine "
     "Huette.");
   
/*-----------------------RAUMEIGENSCHAFTEN-----------------------*/
   
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );
   SetProp(P_INDOORS, 0);
   SetProp(P_LOG_FILE, "/d/kristallwald/kolmey/room.log");

/*-----------------------RAUMDETAILS-----------------------*/
   
   AddDetail( ({ "waldelfendorf", "dorf" }),
     "Ja, Du stehst mitten im Waldelfendorf.");
   AddDetail( ({ "elfendorf" }),
     "Das hier ist das Waldelfendorf! Elessar waere dann das "
     "Elfendorf.");
   AddDetail( ({ "elessar" }),
     "Elessar ist das Elfendorf. Dort wohnt ein weiser Elf.");
   AddDetail( ({ "elf" }),
     "Sein Name ist Aerendil.");
   AddDetail( ({ "aerendil", "name", "bibliothekar" }),
     "Aerendil ist der Bibliothekar in Elessar. Er ist sehr weise "
     "und kann Dir sicher etwas ueber die Elfen erzaehlen.");
   AddDetail( ({ "elfen" }),
     "Aerendil weiss bestimmt was darueber. Vielleicht solltest "
     "Du mal mit ihm sprechen.");
   AddDetail( ({ "sonne" }),
     "Die Baeume ausserhalb des Dorfes reichen hier ihre Aeste noch "
     "schuetzend ueber das Dorf, sodass nicht all zu viel Sonne "
     "durchdringen kann.");
   AddDetail( ({ "baeume" }),
     "Rund um das Dorf befindet sich der Kristallwald und wie es sich "
     "fuer einen echten Wald gehoert, stehen auch in ihm einige Baeume. "
     "Aber von hier kannst Du nicht recht viel erkennen, es waere besser "
     "Du gehst mal in den Wald.");
   AddDetail( ({ "kristallwald" }),
     "Der Kristallwald befindet sich ausserhalb des Dorfes.");
   AddDetail( ({ "wald" }),
     "Meinst Du den Kristallwald?");
   AddDetail( ({ "aeste" }),
     "Starke Aeste mit kristallinen Blaettern reichen etwas ins Dorf herein "
     "und verdecken die Sonne etwas, sodass nicht all zu viel Sonnenlicht "
     "durchkommt.");
   AddDetail( ({ "blaetter" }),
     "Schoene kristalline Blaetter befinden sich auf den Aesten.");
   AddDetail( ({ "sonnenlicht", "licht", "sonnenstrahlen" }),
     "Obwohl die Sonne hoch oben zu stehen scheint, dringt nicht all zu viel "
     "Licht nach unten durch die Blaetter durch.");
   AddDetail( ({ "strasse", "weg" }),
     "Eine schmale Strasse fuehrt durch das Dorf. Sie wurde mit weissen "
     "Steinplatten ausgelegt und traegt eine duenne, weissliche "
     "Kristallschicht. Trotz des spaerlichen Sonnenlichtes hier, "
     "glitzert die Strasse wunderschoen. Ja, es scheint die Steinplatten "
     "selbst wuerden aus Kristall bestehen.");
   AddDetail( ({ "steinplatten" }),
     "Die Strasse wurde mit weissen Steinplatten ausgelegt, die mit einer "
     "duennen Kristallschicht ueberzogen sind. Selbst durch das spaerliche "
     "Sonnenlicht funkelt und glitzert sie in zahlreichen Farben. "
     "Ein wahrhaft wunderschoener Anblick.");
   AddDetail( ({ "kristallschicht" }),
     "Vieles hier traegt eine duenne Kristallschicht und funkelt und "
     "glitzert in den schoensten Farben.");
   AddDetail( ({ "farben" }),
     "Rot, Blau, Gruen und viele mehr.");
   AddDetail( ({ "rot", "blau", "gruen" }),
     "Ein wunderschoener Anblick!");
   AddDetail( ({ "anblick" }),
     "Das funkeln und glitzern des Kristalls durch das Sonnenlicht bietet "
     "einen wunderschoenen Anblick.");
   AddDetail( ({ "kristall" }),
     "Vieles hier wurde vom Kristall ueberzogen. Woher das wohl kommen "
     "mag? Vielleicht weiss ja Aerendil etwas darueber.");
   AddDetail( ({ "wall" }),
     "Kristalline Straeucher und Hecken bilden einen regelrechten "
     "Wall rund um das Dorf und machen Dir ein Weiterkommen in andere "
     "Richtungen ausser dem Strassenverlauf unmoeglich.");
   AddDetail( ({ "straeucher", "hecken", "teil" }),
     "Die Straeucher und Hecken sind noch Teil des Kristallwaldes, "
     "der sich rund um das Dorf befindet.");
   AddDetail( ({ "weiterkommen" }),
     "Du kannst allerhoechstens der Strasse folgen, denn die Hecken und "
     "Straeucher aus denen der Wall besteht machen ein Weiterkommen "
     "in andere Richtungen unmoeglich.");
   AddDetail( ({ "richtungen", "strassenverlauf"}),
     "Du kannst hier nach Suedwesten und Westen gehen.");
   AddDetail( ({ "westen" }),
     "Die Strasse fuehrt Dich nach Westen zu einem kleinen Haus.");
   AddDetail( ({ "suedwesten" }),
     "Die Strasse fuehrt Dich nach Suedwesten weiter ins Dorfinnere.");
   AddDetail( ({ "dorfinnere" }),
     "Im Dorfinneren befindet sich ein Platz.");
   AddDetail( ({ "platz" }),
     "Geh doch ins Dorfinnere, da siehst Du sicher mehr.");
   AddDetail( ({ "huette" }),
     "Eine Huette steht neben der Strasse auf oestlicher Seite. "
     "Wahrscheinlich wohnen hier Waldelfen drinnen. Die Tuer ist "
     "geschlossen. Ein kleines Fenster befindet sich neben der Tuer.");
   AddDetail( ({ "seite" }),
     "Neben der Strasse, auf der oestlichen Seite, steht eine Huette.");
   AddDetail( ({ "waldelfen", "waldelfenfamilie" }),
     "In der Huette lebt bestimmt eine Waldelfenfamilie.");
   AddDetail( ({ "tuer" }),
     "Die Tuer ist geschlossen. Vielleicht koenntest Du sie oeffnen? "
     "Aber waere das nicht Hausfriedensbruch? Neben der Tuer "
     "ist ein kleines Fenster.");
   AddDetail( ({ "hausfriedensbruch" }),
     "Natuerlich waere das Hausfriedensbruch, einfach in eine Huette zu "
     "gehen, die Dir nicht gehoert! Aber das musst Du schon fuer Dich "
     "selbst entscheiden.");
   AddDetail( ({ "fenster" }),
     "Ein kleines Fenster befindet sich neben der Tuer in der Huette. "
     "Vielleicht koenntest Du durch das Fenster ins Innere des Hauses "
     "spaehen? Unter dem Fenster befindet sich ein kleines Blumenkaestchen.");
   AddDetail( ({ "blumenkaestchen", "kaestchen" }),
     "In dem Blumenkaestchen bluehen einige wunderschoene Blumen.");
   AddDetail( ({ "blumen" }),
     "Lauter kristalline Blumen bluehen in dem Blumenkaestchen. "
     "Du erkennst Vergissmeinnichte und Gaensebluemchen.");
   AddDetail( ({ "gaensebluemchen" }),
    "Eine Vielzahl kleiner Gaensebluemchen waechst hier. "
    "Sie schimmern im zarten weiss des Kristalls.");
  AddDetail( ({ "vielzahl" }),
    "Einige Gaensebluemchen gedeien im Kaestchen.");
  AddDetail( ({ "vergissmeinnichte" }),
    "Viele Vergissmeinnichte zieren das Kaestchen. "
    "Sie schimmern im zarten weiss des Kristalls.");
  AddDetail( ({ "haus" }),
    "Die Strasse fuehrt Dich nach Westen hin zu einem Haus. "
    "Ueber der Tuer haengt ein Schild.");
  AddDetail( ({ "schild" }),
    "Du kannst es lesen.");
  
  AddReadDetail( ({ "schild" }),
    "Auf dem Schild steht:\n"
    "\n"
    "--------------------------------\n"
    "Kneipe - zum Waldelfenstammtisch\n"
    "--------------------------------\n");
  
  AddDetail( ({ "kneipe" }),
    "Die Kneipe befindet sich im Westen.");
  AddDetail( ({ "boden" }),
    "Der Boden hier wird von der Strasse gebildet.");
  AddDetail( ({ "himmel" }),
    "Du kannst hier den Himmel nicht so recht erkennen. Die "
    "Baeume aus dem Kristallwald reichen hier ihre Aeste schuetzend "
    "ueber den Wall hinaus ins Dorf hinein und verdecken die Sicht.");
  AddDetail( ({ "sicht", "blick" }),
    "Der Blick auf den Himmel wird Dir hier durch die Aeste verwehrt.");
    
  
  AddRoomMessage(({
     "Ein Stimmenwirrwarr dringt aus dem Haus im Westen.\n"}), 200);

/*-----------------------GERAEUSCHE GERUECHE-----------------------*/
 
  AddSound(DEFAULT_SOUND,
    "Ein Stimmenwirrwarr dringt aus dem Haus im Westen.\n");
  AddSound( ({ "stimmenwirrwarr", "haus" }),
    "In dem Haus scheint einiges los zu sein.");
    
  AddSmell(DEFAULT_SMELL,
    "Du kannst einige Blumen riechen.");
    
  AddSmell( ({ "blumen", "blume" }),
    "Du kannst Vergissmeinnichte und Gaensebluemchen "
    "riechen.");
  AddSmell( ({ "vergissmeinnichte", "vergissmeinnicht" }),
    "Die Vergissmeinnichte riechen zart.");
  AddSmell( ({ "gaensebluemchen", "duft" }),
    "Die Gaensebluemchen duften suess.");

/*---------------------ITEMS CMDS EXITS---------------------*/
  
  AddItem(NPC("waldelf"), REFRESH_DESTRUCT)->activate_walk();
  AddItem(NPC("waldelfe"), REFRESH_DESTRUCT)->activate_walk();
  
  AddCmd( ({ "pfluecke", "pflueck" }), "cmd_pick");
  AddCmd( ({ "spaeh", "spaehe" }), "cmd_see");
  AddCmd( ({ "oeffne" }), "cmd_open");
  
  AddExit( "suedwesten", "./dorf08" );
  AddExit( "westen", "./kneipe" );
}

int cmd_pick(string str)
{
   //Man kann hier nicht wirklich Blumen pfluecken...
   //Fuer Forscher gedacht...	
   notify_fail(BS("Was moechtest Du denn pfluecken?"));
   if(str == "vergissmeinnicht" || str == "gaensebluemchen" || 
      str == "blume")
   {
      write(BS("Du willst doch nicht das schoene Blumenkaestchen "
               "verwuesten? Irgendwo im Kristallwald wachsen bestimmt "
               "auch noch Blumen, die Du ohne Bedenken pfluecken "
               "kannst!"));
      return 1;
   }
   return 0;
}

int cmd_see(string str)
{
   //Man kann wieder ins Haeuschen gucken
   notify_fail(BS("Wodurch moechtest Du denn in was hineinspaehen?"));
   if(str == "durch fenster in huette" || 
      str == "durch fenster in huette hinein")
   {
      write(BS("Viel kannst Du durch das kleine Fenster nicht erkennen. "
               "Du solltest wohl besser in die Huette hinein gehen um mehr "
               "zu sehen. Jedoch waere dass Hausfriedensbruch."));
      return 1;
   }
   return 0;
}

int cmd_open(string str)
{  
   //und wird wieder aus dem Dorf geworfen =)
   notify_fail(BS("Was moechtest Du denn oeffnen?"));
   if(!(str == "tuer" || str == "holztuer" || str == "holztuere" || 
      str == "tuere"))
   return 0;
   {
      write(BS("Als Du die Tuer oeffnest und das Haus betrittst, klopft "
      	       "Dir ploetzlich ein Waldelfenwaechter auf die Schulter, "
      	       "packt Dich und befoerdert Dich aus dem Dorf. "
      	       "Da siehst Du, was Du von Hausfriedensbruch hast.")+"\n");
      TP->move(ROOM("eingang"), M_GO);
      }
   return 1;
}
      
   

