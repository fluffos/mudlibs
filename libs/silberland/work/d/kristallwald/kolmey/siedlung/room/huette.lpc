inherit "std/room";

#include "../siedlung.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

//Ich habe in die Huette ein Sofa hingestellt...
//Hier wird abgefragt ob der Spieler auf dem Sofa sitzt
#define SOFA(wer) (member(sofa, capitalize(getuid(wer)))!=-1)
#define MyCountUp(arg) (sizeof(arg) > 1 ? \
        implode(arg[0..<2], ", ") + " und " + arg[<1] : \
        (sizeof(arg) == 0 ? "niemand" : arg[0]) )

string *sofa=({});

void grundzustand();
int feuerchen;
int fenster;

mapping warmup;

string luftzug(string key);
string feuerchen(string key);
string waerme(string key);
string fenster(string key);
string kamin(string key);

create()

{

::create();

/*-----------------------KURZ UND LANGBESCHREIBUNG-----------------------*/

   SetProp(P_INT_SHORT, "Eine Huette");
   SetProp(P_INT_LONG,
     "Du stehst in einer netten kleinen Huette. Der Boden ist mit einem "
     "selbstgewebten Teppich ausgelegt worden auf dem ein grosses, "
     "gemuetliches Sofa steht. Neben dem Sofa befindet sich ein kleiner "
     "Holztisch. An der Ostwand erkennst Du ein grosses Regal. An der "
     "Westwand befindet sich ein Kamin. Durch ein grosses Fenster an der "
     "Nordwand dringt Licht in den Raum und laesst die Sonnenstrahlen "
     "herein.");
   
/*--------------------------RAUMEIGENSCHAFTEN--------------------------*/
   
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );
   SetProp(P_INDOORS, 1);
   SetProp(P_LOG_FILE, "/d/kristallwald/kolmey/room.log");
   
/*-----------------------RAUMDETAILS-----------------------*/   
   
   AddDetail( ({ "huette" }), TO->QP(P_INT_LONG));
   
   AddDetail( ({ "boden" }),
     "Der Boden wurde mit einem selbstgewebten Teppich ausgelegt.");
   AddDetail( ({ "teppich" }),
     "Dieser, aus Wolle gefertigte Teppich bedeckt fast den ganzen Boden. "
     "Du musstest schon zwei mal hinsehen, um erkennen zu koennen dass er "
     "selbst gewebt wurde. Zweifelsohne ein Meisterwerk.");
   AddDetail( ({ "wolle" }),
     "Da der Teppich fast den ganzen Boden bedeckt, wurden hierfuer bestimmt "
     "einige Schafe geschoren.");
   AddDetail( ({ "schafe" }),
     "Das muessen sehr viele Schafe gewesen sein, die ihr Fell lassen "
     "mussten.");
   AddDetail( ({ "fell" }),
     "Das Fell eines Schafs nennt man Wolle.");
   AddDetail( ({ "meisterwerk" }),
     "Der Teppich ist so schoen gewebt worden, dass Du schon zweimal "
     "hinsehen musstest um erkennen zu koennen dass er handgewebt ist.");
   AddDetail( ({ "mitte" }),
     "In der Mitte des Raumes steht ein grosses Sofa.");
   AddDetail( ({ "leute" }),
     "Du schaetzt dass circa zehn Leute auf dem Sofa Platz finden.");
   AddDetail( ({ "platz" }),
     "Nimm doch mal auf dem Sofa platz. Es sieht wirklich sehr gemuetlich "
     "aus.");
   AddDetail( ({ "tisch", "holztisch" }),
     "Neben dem Sofa steht ein kleiner Tisch aus Holz. Auf "
     "ihm befindet sich eine Vase mit wunderschoenen Blumen.");
   AddDetail( ({ "holz" }),
     "Ganz gewoehnliches Holz.");
   AddDetail( ({ "vase" }),
     "In der Vase kannst Du einige schoene Blumen erkennen. "
     "Sie sehen allesamt noch sehr frisch aus und scheinen "
     "erst kuerzlich gepflueckt worden zu sein.");
   AddDetail( ({ "blumen", "blume" }),
     "Du erkennst Rosen, Mohnblumen, Vergissmeinnichte, Margerithen, "
     "Loewenzaehne und einige Dir unbekannte Blumen.");
   AddDetail( ({ "rosen", "rose" }),
     "Es sind rote, langstielige Rosen.");
   AddDetail( ({ "mohnblumen", "mohnblume" }),
     "Die Blueten der Mohnblumen strahlen Dir in zartem Rot entgegen.");
   AddDetail( ({ "blueten", "bluete" }),
     "Die Blueten sehen wunderschoen aus.");
   AddDetail( ({ "rot" }),
     "Rot ist eine wunderschoene Farbe.");
   AddDetail( ({ "farbe" }),
     "Welche Farbe meinst Du denn?");
   AddDetail( ({ "vergissmeinnichte", "vergissmeinnicht" }),
     "Die Vergissmeinnichte leuchten Dir in zartem Violett entgegen.");
   AddDetail( ({ "violett" }),
     "Die Blueten der Vergissmeinnichte strahlen in zartem violett.");
   AddDetail( ({ "margerithen", "margerithe" }),
     "Die Margerithen sehen fast aus wie ueberdimensionale Gaensebluemchen. "
     "Zarte, weisse Bluetenblaetter und eine knallgelbe Bluetenmitte.");
   AddDetail( ({ "bluetenblaetter" }),
     "Die Bluetenblaetter der Margerithen sind weiss.");
   AddDetail( ({ "bluetenmitte" }),
     "Die Bluetenmitte der Margerithen sind knallgelb.");
   AddDetail( ({ "gaensebluemchen" }),
     "Gaensebluemchen findest Du hier keines, Du hast lediglich die "
