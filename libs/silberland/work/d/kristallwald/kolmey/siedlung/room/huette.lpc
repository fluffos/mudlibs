   AddDetail( ({ "buch" }),
     "Meinst Du das blaue, das rote oder das schwarze Buch?");
   AddDetail( ({ "rotes buch" }),
     "Sein Titel lautet: 'Nuetzliche Tips fuer die Jagd'.");
   AddDetail( ({ "titel" }),
     "Der Titel des roten Buches lautet: 'Nuetzliche Tips fuer die Jagd'. "
     "Hmmm klingt interessant.");
   AddDetail( ({ "blaues buch", "einband" }),
     "Sein Einband besagt: 'Jagen ohne Verletzte'.");
   AddDetail( ({ "schwarzes buch" }),
     "Auf ihm steht: 'Wie unterscheide ich einen Hirsch von einem "
