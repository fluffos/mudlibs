   AddDetail( ({ "hirsch" }),
     "Ein Hirschkopf auf einem Holzbrett festgenagelt. "
     "Das prachtvolle Geweih des Hirsches laesst darauf schliessen, dass "
     "es wohl ein noch recht junger Hirsch gewesen war, den der Jaeger "
     "hier erwischt hat.");
   AddDetail( ({ "hirschkopf" }),
     "Der Hirschkopf wurde an ein Holzbrett genagelt.");
   AddDetail( ({ "geweih" }),
     "Das Geweih des Hirsches ist praechtig. Muss wohl noch ein "
     "junges Tier gewesen sein.");
   AddDetail( ({ "tier", "tiere" }),
     "Du kannst hier einen Hirsch, einen Fasan, einen Hasen und sogar einen "
     "Biber erkennen.");
   AddDetail( ({ "fasan" }),
     "Der Kopf eines Fasans wurde hier an die Wand auf einem Brett "
     "befestigt.");
   AddDetail( ({ "wand" }),
     "Meinst Du die Ostwand, die Westwand, die Suedwand oder die Nordwand?");
   AddDetail( ({ "holzbrett", "holzbretter", "bretter", "brett" }),
     "Auf den Holzbrettern wurden die Tiere befestigt.");
   AddDetail( ({ "hase" }),
     "Ein Hase wurde zur Gaenze ausgestopft und auf dem Brett befestigt.");
   AddDetail( ({ "biber" }),
     "Der Kopf eines Bibers wurde hier auf ein Brett genagelt. "
     "Du wunderst Dich warum man wohl einen Biber jagen sollte.");
   AddDetail( ({ "kopf" }),
     "Meist wurden nur die Koepfe der Tiere ausgestopft und an den "
     "Brettern befestigt. Nur bei dem Hasen hat man den ganzen Koerper "
     "genommen.");
   AddDetail( ({ "koerper", "gaenze", "hasen" }),
     "Bei dem toten Hasen hat man sogar den Koerper ausgestopft. "
     "Wohl wegen seiner Groesse.");
   AddDetail( ({ "groesse" }),
     "Na, ein Hase ist ja nicht recht gross, wahrscheinlich hat man deshalb "
     "auch den Koerper bei ihm auch ausgestopft.");
   AddDetail( ({ "koepfe", "tierkoepfe" }),
     "Du erkennst drei Tierkoepfe. Einen Hirschkopf, einen Fasan und "
     "einen Biber.");
   AddDetail( ({ "jaeger" }),
     "Diese Huette gehoert wohl einem Jaeger. Er muss ziemlich "
     "erfolgreich sein, wenn Du Dir diese ganzen Trophaeen an der "
     "Ostwand so ansiehst.");
   AddDetail( ({ "westwand" }),
     "An der Westwand befindet sich ein Kamin, in dem ein kleines "
     "Feuerchen tanzt. Ober dem Kamin kannst Du ein Bild erkennen.");
   AddDetail( ({ "abenteuer" }),
     "Du bist doch wirklich staendig auf der Suche danach.");
   AddDetail( ({ "suche" }),
     "Wer weiss, vielleicht findest Du sogar hier im Haeuschen ein "
     "Abenteuer.");
   AddDetail( ({ "stein" }),
     "Ganz normaler Stein.");
   AddDetail( ({ "bild" }),
     "Das Bild haengt ober dem Kamin. Es zeigt einen Jaeger und eine "
     "Frau wie die beiden Hand in Hand durch den Kristallwald laufen.");
   AddDetail( ({ "frau" }),
     "Die Frau auf dem Bild ist recht huebsch.");
   AddDetail( ({ "hand" }),
     "Anscheinend sind die Frau und der Jaeger miteinander verheiratet.");
   AddDetail( ({ "kristallwald" }),
     "Der Kristallwald befindet sich ausserhalb des Dorfes. Geh doch mal "
     "hin. Dort gibt es sicher auch einige Abenteuer zu entdecken.");
   AddDetail( ({ "nordwand" }),
     "In der Nordwand befindet sich ein grosses Fenster, durch das "
     "die Sonnenstrahlen ins Haeuschen fallen.");
   AddDetail( ({ "sonnenstrahlen", "strahlen" }),
     "Die Sonnenstrahlen fallen durch das Fenster in der Nordwand in "
     "den Raum herein und spenden Licht.");
   AddDetail( "licht", ([ 0: "Die Sonne und das Feuerchen spenden enorm "
                             "viel Licht, welches den ganzen Raum "
                             "erleuchtet.",
                 "dunkelelf": "Die Sonne und das Feuerchen spenden Licht. "
                              "Du sehnst Dich aber nach der Dunkelheit der "
                              "Unterwelt und verfluchst es."]));
   AddDetail( "unterwelt", ([0: "Sowas siehst Du da nicht!",
                   "dunkelelf": "Du sehnst Dich nach der Unterwelt."]));
   AddDetail( "dunkelheit", ([0: "Sowas siehst Du da nicht!",
  		    "dunkelelf": "Su sehnst Dich nach Dunkelheit."]));
   AddDetail( ({ "sonne" }),
     "Die Sonne steht draussen am Himmel. Ihre Strahlen tanzen lustig "
     "durchs Fenster herein und verleihen dem Raum etwas Licht.");
   AddDetail( ({ "himmel" }),
     "Um den Himmel erkennen zu koennen, solltest Du wirklich besser "
     "hinaus gehen.");
   AddDetail( ({ "sueden", "suedwand" }),
     "Im Sueden befindet sich die Tuer, durch die Du dreist "
     "einfach ins Haeuschen gegangen bist.");
   AddDetail( ({ "waende" }),
     "Die Waende der Huette bestehen aus Holz.");
   AddDetail( ({ "decke" }),
     "Die Decke der Huette besteht ebenfalls aus Holz.");

/*-----------------------GERAEUSCHE GERUECHE-----------------------*/
   
   AddSound(DEFAULT_SOUND,
     "Einige Dorfgeraeusche dringen von draussen herein.\n");
   AddSound( ({ "dorfgeraeusche", "geraeusche" }),
     "Draussen scheint einiges Los zu sein.");
   
   AddSmell(DEFAULT_SMELL,
     "Es duftet nach den Blumen aus der Vase.");
   AddSmell( ({ "blumen", "geruch", "blume" }),
     "Jede Blume hat einen anderen Geruch.");
   AddSmell( ({ "rosen", "rose" }),
     "Die Rosen duften suess.");
   AddSmell( ({ "margerithen", "margerithe" }),
     "Die Margerithen riechen streng.");
   AddSmell( ({ "vergissmeinnichte", "vergissmeinnicht" }),
     "Die Vergissmeinnichte riechen zart.");
   AddSmell( ({ "loewenzaehne", "loewenzahn" }),
     "Die Loewenzaehne duften wuerzig.");
   AddSmell( ({ "mohnblume", "mohnblumen" }),
     "Die Mohnblumen duften wuerzig.");

/*---------------------ITEMS CMDS EXITS UND MAPPINGS---------------------*/

   AddCmd( ({ "setze", "setz", "sitze", "sitz" }), "cmd_sitdown");
   AddCmd( ({ "stehe", "steh" }), "cmd_getup");
   AddCmd( ({ "norden", "n", "gehe", "goto",
              "home" }), "cmd_firststandup");
   AddCmd( ({ "oeffne" }), "cmd_open");
   AddCmd( ({ "zuende", "zuend", "mach", "mache" }), "cmd_makefire");
   AddCmd( ({ "waerme", "waerm", "erwaerme", "erwaerm" }), "cmd_warmup");
   AddCmd( ({ "schliesse", "schliess" }), "cmd_close");

/*---------------------SPECIAL_DETAILS---------------------*/
   
   AddSpecialDetail( ({ "waerme" }), "waerme");
   AddSpecialDetail( ({ "feuerchen" }), "feuerchen");
   AddSpecialDetail( ({ "fenster" }), "fenster");
   AddSpecialDetail( ({ "sofa" }), "sofa" );
   AddSpecialDetail( ({ "kamin" }), "kamin" );
   AddSpecialDetail( ({ "luftzug" }), "luftzug" );
   
   AddExit("raus", "./dorf06");


   NewDoor( "raus", ROOM("dorf06"), ({"tuer", "tuere", "holztuer" }),
     ({ DOOR_OPEN,
        DOOR_RESET_OP,
        D_NAME, "Holztuer",
        D_GENDER, FEMALE,
        D_SHORT, "Im Norden befindet sich eine %se Holztuer.",
        D_LONG, "Eine ganz normale Tuer aus Holz. "
                "Man kann sie oeffnen und schliessen.",
        D_MSGS, ({ "raus", "geht raus", "kommt herein" }),
        D_OPENMSG, ({ "Du oeffnest die Tuer.",
                      "%s oeffnet die Tuer.",
                      " wird von innen geoeffnet." }),
        D_CLOSEMSG, ({ "Du schliesst die Tuer.",
                       "%s schliesst die Tuer.",
                       " wird von innen geschlossen." }),
        D_RESET_CLOSEMSG, " schliesst sich." }) );
   
   grundzustand();
}

reset()
{

  ::reset();
  grundzustand();
}

void grundzustand()
{
  feuerchen=1;
  fenster=1;
  warmup=([]);
}

int cmd_sitdown(string str)
{ 
  //Hier kann man sich aufs Sofa setzen
  notify_fail("Worauf moechtest Du Dich setzen?\n");
  if(!(str == "auf sofa" || str == "auf sofa hin"))
  {
     return 0;
  }
  if (SOFA(TP))
  {
     write (BS("Aber Du sitzt doch schon auf dem Sofa!\n"));
     return 1;
  }
  if(sizeof(sofa)>=4)
  {
     write (BS("Auf dem Sofa sitzen schon zuviele.\n"));
     return 1;
  }
     write (BS("Du machst es Dir auf dem Sofa bequem.\n"));
     tell_room(ENV(TP), TPN+" macht es sich auf dem Sofa bequem.\n",
     ({TP}));
     sofa += ({ capitalize(getuid(TP)) });
     return 1;
}

int cmd_firststandup()
{
  if (SOFA(TP))
  {
     write("Aber Du sitzt doch noch auf dem Sofa!\n");
     return 1;
  }
}

int cmd_getup(string str)
{
  notify_fail("Willst Du etwa aufstehen?\n");
  if (str=="auf")
  {
  if( SOFA(TP) )
  {
     write (BS("Du stehst von dem Sofa auf.\n"));
     tell_room(ENV(TP), TPN+" steht von dem Sofa auf.\n", ({TP}));
     sofa -= ({ capitalize(getuid(TP)) });
     return 1;
     }
  }
  else 0;
}

void BecomesNetDead(object spieler)
{
  
  if(SOFA(spieler))
  sofa -= ({ capitalize(getuid(spieler)) });
}

string sofa()
{
  string sofainfo;
  if(SOFA(TP))
  {
     sofainfo =
     "Du sitzt auf dem grossen Sofa. "+
     "Neben dem Sofa steht ein Tisch.";
  }
  else
  {
     sofainfo =
     "Ein gemuetliches, grosses Sofa steht in der Mitte des Raumes. "
     "Auf dem haben bestimmt vier Leute Platz. Wenn Du willst kannst "
     "Du Dich hier mal ausruhen und hinsetzen. Neben dem Sofa steht ein "
     "kleiner Tisch.";
  if(sizeof(sofa)==1)
     sofainfo += " Im Moment sitzt " + sofa[0] + " auf dem Sofa.";
    
  if(sizeof(sofa)>1)
     sofainfo += " Im Moment sitzen " + MyCountUp(sofa) + " auf dem Sofa.";
  }
  return break_string(sofainfo, 78);
}

int cmd_open(string str)
{
   //kleines Feature, wenn man das Fenster oeffnet wird
   //durch einen Luftzug das Feuer im Kamin geloescht
   notify_fail(BS("Was moechtest Du denn oeffnen?"));
   if(!(str == "fenster")) 
   {
      return 0;
   }
   if(!fenster)
   {
      write(BS("Aber das Fenster ist doch schon geoeffnet!"));
   }
   else
   {
      write(BS("Du oeffnest das Fenster."));
      write(BS("Ein Luftzug faehrt herein und loescht das kleine "
               "Feuerchen."));  
      tell_room(ENV(TP), TPN+" oeffnet ein Fenster und durch einen "
    	       		     "Luftzug wird das Feuerchen im Kamin "
    			     "geloescht.\n", ({TP}));
   fenster=0;
   feuerchen=0;
   }
   return 1;
}

int cmd_makefire(string str)
{
   //Das Feuer kann man jedoch wieder anzuenden -> kostet 5 Mps
   notify_fail(BS( "Was moechtest Du denn anzuenden?"));
   if(!(str == "feuerchen an" || str== "kamin an")) 
   {
      return 0;
   }
   if(feuerchen)
   {
      write(BS("Aber das Feuerchen brennt doch noch!"));
   }
   else
   {
      write(BS("Du entzuendest einen kleinen Feuerball und laesst "
               "das Feuerchen wieder hell lodern."));
      tell_room(ENV(TP), TPN+" entzuendet ein Feuerchen im Kamin.\n", ({TP}));  
   feuerchen=1;
   TP->AddSp(-5);
   }
   return 1;
}

int cmd_warmup(string str)
{  
   //Man kann sich einmal pro reset am Feuer erwaermen
   string spieler;
   spieler=getuid(TP);
   notify_fail(BS("Wo moechtest Du Dich denn aufwaermen?"));
   if(str == "an feuerchen" || str == "an feuerchen auf")
   {
   if(!member(warmup, spieler))
   {
      warmup+=([spieler: 0]);
   }
   if(feuerchen)
   {
   if(warmup[spieler, 0]>=1)
   {
      write(BS("Du waermst Dich etwas am Feuerchen auf. "
    	       "Ahhh tut das gut!"));
      tell_room(ENV(TP), TPN+" waermt sich etwas auf.\n", ({TP}));
   }
   else
   {  
      write(BS("Du waermst Dich etwas am Feuerchen auf. "
    	       "Ahhh tut das gut! Du fuehlst Dich erfrischt!"));
      tell_room(ENV(TP), TPN+" waermt sich etwas auf.\n", ({TP}));
   TP->AddHp(30);
   TP->AddSp(30);
   warmup[spieler, 0]++;
   }
   return 1;
   }
   if(!feuerchen)
   {
      write(BS("Aber es brennt doch gar kein Feuerchen im Kamin!"));
   }
   return 1;
   }
}

string kamin(string key)
{
   if(!feuerchen)
   {
      return BS("Der Kamin befindet sich an der Westwand. "
                "Im moment brennt in ihm kein Feuerchen. Das "
                "koennte sich wohl schnell aendern. "
                "Er besteht aus Stein.");
   }
   else
   {
      return BS("Der Kamin befindet sich an der Westwand. In ihm tanzt ein "
                "kleines Feuerchen, das den Raum mit wohliger Waerme versorgt. "
                "Er besteht aus Stein.");
   }
}

string feuerchen(string key)
{
   if(!feuerchen)
   {
      return BS("Im Kamin brennt gerade kein Feuerchen.");
   }
   else
   {
      return BS("Ein kleines Feuerchen taenzelt im Kamin umher. "
    	        "Es versorgt den Raum mit wohliger Waerme.");
   }
}

string waerme(string key)
{
   if(!feuerchen)
   {
      return BS("Sowas siehst Du hier nicht.");
   }
   else
   {
      return BS("Das Feuerchen im Kamin versorgt den Raum mit wohliger "
    	        "Waerme. Man koennte sich vielleicht daran erwaermen.");
   }
}

string fenster(string key)
{
   if(!fenster)
   {
      return BS("Das grosse Fenster befindet sich in der Suedwand und "
    	        "laesst das Licht der Sonne in den Raum fallen. "
                "Im moment ist es geoeffnet. Du koenntest vielleicht "
                "durchs Fenster nach draussen in den Garten klettern.");
   } 
   else
   {
      return BS("Das grosse Fenster befindet sich in der Suedwand und "
    	        "laesst das Licht der Sonne in den Raum fallen. "
                "Im moment ist es geschlossen.");
   } 
}

string luftzug(string key)
{
   if(!feuerchen)
   {
      return BS("Der leichte Windzug hat das Feuerchen geloescht. "
    	        "Hmmm was kann man da wohl machen?");
   }
   else
   {
      return BS("Sowas siehst Du hier nicht.");
   }
}

int cmd_close(string str)
{
   //Das Fenster kann man auch wieder schliessen
   notify_fail(BS("Was moechtest Du denn schliessen?"));
   if(!(str == "fenster")) 
   {
      return 0;
   }
   if(fenster)
   {
      write(BS( "Aber das Fenster ist doch schon geschlossen!"));
   }
   else
   {
      write(BS( "Du schliesst das Fenster wieder."));
      tell_room(ENV(TP), TPN+" schliesst das Fenster wieder.\n", ({TP}));
   fenster=1;
   }
   return 1;
}
