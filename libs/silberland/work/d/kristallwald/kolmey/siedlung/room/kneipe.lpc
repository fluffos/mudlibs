inherit "std/pub";

#include "../siedlung.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <pub.h>

//Man kann sich auch hier auf einen der
//vier Hocker vor der Theke setzen
#define HOCKER(wer) (member(hocker, capitalize(getuid(wer)))!=-1)
#define MyCountUp(arg) (sizeof(arg) > 1 ? \
        implode(arg[0..<2], ", ") + " und " + arg[<1] : \
        (sizeof(arg) == 0 ? "niemand" : arg[0]) )

string *hocker=({});

create()

{
::create();

/*-----------------------KURZ UND LANGBESCHREIBUNG-----------------------*/

   SetProp(P_INT_SHORT, "Kneipe 'Waldelfen Stammtisch'");
   SetProp(P_INT_LONG,
     "Du befindest Dich inmitten der Kneipe 'Waldelfen Stammtisch'. "
     "Eine grosse Theke befindet sich an der Suedwand, vor der "
     "einige hoelzerne Hocker aufgestellt wurden. An den Tischen, die "
     "im Schankraum verteilt sind, sitzen einige Waldelfen und unterhalten "
     "sich angeregt. Durch Fenster in der Nord- und Westwand faellt "
