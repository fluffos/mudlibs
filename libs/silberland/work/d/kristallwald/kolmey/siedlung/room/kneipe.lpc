   AddDrink("Zwergenschweiss", ({"zwergenschweiss", "schweiss"}),
           350, ({40, 0}), 0, 10,
           ({
           BS("Martak zieht mit verzerrtem Gesicht einen Fetzen unter "
              "Theke hervor. Er haelt ihn ueber ein Glas und windet ihn aus "
