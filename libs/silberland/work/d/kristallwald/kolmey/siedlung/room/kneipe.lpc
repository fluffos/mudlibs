              "trinkst Du ihn aus."),
              "&& trinkt genuesslich einen Kristalldrink aus."}));
   
   AddDrink("Dhalas Geheimnis", ({"dhalas geheimnis", "geheimnis"}),
           750, ({100, 150}), 15, 10,
           ({
           BS("Martak strahlt und wirft Dir eine Flasche mit tuerkiser "
              "Fluessigkeit zu. Anschliessend sagt er Dhala zum Grusse als "
              "Du die Flasche austrinkst."),
              "&& sagt: Dhala zum Grusse! Und trinkt eine Flasche "
              "Dhalas Geheimnis aus."}));
   
   AddFood("Sinusbeerensuppe", ({"sinusbeerensuppe", "sinussuppe", 
                                 "beerensuppe", "suppe"}),
	  50, 15, 4,
	  ({"Du isst einen heissen Teller Sinusbeerensuppe.",
	    "&& isst einen dampfenden Teller Sinusbeerensuppe."}) );
   
   AddFood("Wurzelragout", ({"wurzelragout", "ragout"}),
	  150, 30, 6,
	  ({"Du verzehrst genuesslich einen Teller Wurzelragout.",
	    "&& verzehrt genuesslich einen Teller Wurzelragout."}) );

   AddFood("Blattsalat", ({"blattsalat", "salat"}),
	  175, ({30, 40}), 5,
	  ({"Du isst einen Teller Blattsalat.",
	    "&& isst einen Teller Blattsalat."}) );
   
   AddFood("Dridergulasch", ({"dridergulasch", "gulasch"}),
	  270, 80, 9,
	  ({"Martak nimmt grinsend aus einer Dose kleinzerhackte "
	    "Driderteile, erwaermt sie und giesst eine dampfende "
	    "Sosse drueber und reicht Dir den Teller. Schmatzend "
	    "verzehrst Du das Gulasch.",
	    "&& verzehrt grinsend einen Teller Dridergulasch."}) );
   
   AddFood("Tagesmenue", ({"tagesmenue", "menue"}),
	  400, 150, 15,
	  ({"Martak reicht Dir einen Teller mit dem Tagesgericht "
	    "und erklaert Dir, dass es dieses aber nur von Zeit zu "
	    "Zeit zu kaufen gibt. Dann fuegt er hinzu: Lass Dir "
	    "das Delfengeschnetzelte schmecken! Dankend verzehrst "
	    "Du das Delfengeschnetzelte.",
	    "&& bekommt von Martak einen Teller Tagesmenue serviert "
	    "welches wohl heute 'Delfengeschnetzeltes' ist, und verzehrt "
	    "es genuesslich."}) );

/*--------------------ITEMS CMDS EXITS SPECIAL_DETAILS--------------------*/

   AddSpecialDetail( ({ "hocker" }), "hocker");
   
   AddCmd( ({"kauf", "kaufe", "bestell", "bestelle"}), "bestelle");
   //AddCmd("", "able", 1);
   AddCmd( ({"spendier", "spendiere"}), "spendiere");
   AddCmd( ({ "setze", "setz", "sitze", "sitz" }), "cmd_sitdown");
   AddCmd( ({ "stehe", "steh" }), "cmd_getup");
   AddCmd( ({ "osten", "o", "goto", "home" }), "cmd_firststandup");
   
   AddExit("osten", ROOM("dorf04"));
   
   AddItem(NPC("martak"), REFRESH_DESTRUCT);
   
}

bestelle (str)
{ 
  //Die typischen Cmds fuer Kneipen
  object ob, *list;
  int i;

  notify_fail ("Martak, der Wirt, ist gerade nicht da!\n");
  if(ob = find_living(WIRT)) 
  {
    notify_fail(BS("Martak, der Wirt, kaempft gerade! Er hat jetzt keine "
                   "Zeit fuer Dich!"));
    if (ob->InFight()) return 0; 
    else return ::bestelle(str);
  } 
  else
  return 0;
}

spendiere (str)
{
  string *tmp;
  object pl;
  object ob;

  notify_fail("Martak, der Wirt, ist gerade nicht da!\n");
  if(ob=present(WIRT))
  {
    tmp=explode(str," ");
    if (sizeof(tmp)<2) return ::spendiere(str);
    if ((pl=present(tmp[0])) && living (pl))
    {
      notify_fail(BS("Martak, der Wirt, weigert sich, "+pl->name()+" etwas "
                     "zu bringen, da er gerade mit "
                     ""+pl->QueryPronoun(WEM)+" kaempft.\n"));
      if (ob->InFight()) return 0;
    }
    return ::spendiere(str);
  }
  else
  return 0;
}

int cmd_sitdown(string str)
{
   notify_fail(BS("Wohin moechtest Du Dich setzen?"));
   if(!(str == "auf hocker" || str == "auf hocker hin"))
   {
     return 0;
   }
   if(HOCKER(TP))
   {
   write(BS("Aber Du sitzt doch schon auf einem der Hocker!"));
   return 1;
   }
   if(sizeof(hocker)>=5)
   {
   write(BS("Leider sind schon alle Hocker besetzt."));
   return 1;
   }
   write (BS("Du setzt Dich auf einen der Hocker vor der Theke.\n"));
   tell_room(ENV(TP), TPN+" setzt sich auf einen Hocker.\n", ({TP}));
   hocker += ({ capitalize(getuid(TP)) });
   return 1;
}

int cmd_firststandup(string str)
{
  if(HOCKER(TP))
  {
     write("Du solltest vorher besser aufstehen!\n");
     return 1;
  }
}


int cmd_getup(string str)
{
   notify_fail(BS("Willst Du etwa aufstehen?"));
   if(str == "auf")
   {
   if(HOCKER(TP))
   {
     write(BS("Du stehst von dem Hocker auf."));
     tell_room(ENV(TP), TPN+" steht von dem Hocker auf.\n", ({TP}));	 
     hocker -= ({ capitalize(getuid(TP)) });
     return 1;
     }
  }      
  else 0;
}

void BecomesNetDead(object spieler)
{
  if(HOCKER(spieler))
  hocker -= ({ capitalize(getuid(spieler)) });
}

string hocker()
{
  string hockerinfo;
  if(HOCKER(TP))
  {
     hockerinfo =
     "Du sitzt auf einem der Hocker. "+
     "Direkt vor Dir befindet sich die Theke.";
  }
  else
  {
     hockerinfo =
     "Insgesamt wurden fuenf hoelzerne Hocker vor der Theke aufgestellt. "
     "Du koenntest Dich auch auf einen setzen und etwas bestellen.";
  if(sizeof(hocker)==1 )
     hockerinfo += " Im Moment sitzt " + hocker[0] + " auf einem der "
     		   "Hocker.";
    
  if(sizeof(hocker)>1 )
     hockerinfo += " Im Moment sitzen " + MyCountUp(hocker) + " auf den "
     		   "Hockern.";
  }
  return break_string(hockerinfo, 78);
}



