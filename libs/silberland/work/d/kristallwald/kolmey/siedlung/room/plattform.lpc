inherit "std/room";

#include "../siedlung.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <verben.h>

void delayedwrite(object spieler, int curpos, mixed *daten);

#define QUESTKELCH "\nkelch"
#define QROOM(x) ("/d/kristallwald/kolmey/schatzkristall/room/")+x
#define QOBJ(x) ("/d/kristallwald/kolmey/schatzkristall/obj/")+x

mapping schoepfer;

int offen = 0;
int gegenstand = 1;

create()
{

::create();

/*-----------------------KURZ UND LANGBESCHREIBUNG-----------------------*/

   SetProp(P_INT_SHORT, "Siilarils Turm");
   SetProp(P_INT_LONG,
     "Du stehst nun auf dem hohen Baum auf einer grossen, "
     "runden Plattform aus Stein, deren Abschluss von einem magischen "
     "Kraftfeld umgeben zu sein scheint. In der Mitte steht eine grosse, "
     "mit Wasser gefuellte Schale, daneben steht ein steinerner Sockel. "
     "Weit ober der Schale schwebt eine leuchtende Kristallkugel die die "
     "Umgebung mit blauem Licht erstrahlen laesst. Ueber die Wendeltreppe "
     "gelangst Du wieder zurueck auf sicheren Boden. Du hast hier freien "
     "Blick auf den Himmel.");
   
/*-----------------------RAUMEIGENSCHAFTEN-----------------------*/
   
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );
   SetProp(P_INDOORS, 0);
   SetProp(P_LOG_FILE, "/d/kristallwald/kolmey/room.log");

/*-----------------------RAUMDETAILS-----------------------*/
  
   AddDetail("baum", TO->QP(P_INT_LONG));
   
   AddDetail( ({ "stein" }),
     "Ungewoehnlich fuer das restliche Dorf besteht diese Plattform hier aus "
     "Stein. Es scheint Marmor zu sein.");
   AddDetail( ({ "marmor" }),
     "Die Plattform besteht aus reinweissem Marmor der einige Unebenheiten "
     "aufweist.");
   AddDetail( ({ "dorf" }),
     "Unten kannst Du das Dorf erkennen.");
   AddDetail( ({ "plattform" }),
     "Du stehst auf der Plattform auf einem hohen Baum. "
     "Diese scheint von einem magischen Kraftfeld umgeben zu sein. "
     "In der Mitte kannst Du eine grosse Schale erkennen neben der "
     "ein steinerner Sockel steht.");
   AddDetail( ({ "kraftfeld" }),
     "Ein unsichtbares Kraftfeld scheint die Plattform zu "
     "umgeben und zu schuetzen. Obwohl Du es nicht sehen kannst "
     "nimmst Du das Kraftfeld wahr. Es scheint durch weisse Magie "
     "erschaffen worden zu sein.");
   AddDetail( ({ "magie" }),
     "Die weisse Magie ist hier unter dem Kraftfeld enorm zu spueren. "
     "Sie durflutet alles was sich hier befindet und durchdringt "
     "auch Dich und Deine Seele. Wenn Du den Mut besitzt kannst Du "
     "probieren das Kraftfeld zu beruehren.");
   AddDetail( ({ "seele" }),
     "Du spuerst foermlich wie die weisse Magie in Deine Seele "
     "eindringt und Dich durchflutet.");
   AddDetail( ({ "mut" }),
     "Nicht alle halten der weissen Magie stand. Was passiert wenn "
     "Du das Kraftfeld beruehrst kann Dir niemand sagen.");
   AddDetail( ({ "abschluss" }),
     "Die Plattform ist von einem unsichtbaren Kraftfeld aus weisser "
     "Magie umgeben.");
   AddDetail( ({ "mitte" }),
     "In der Mitte der Plattform befindet sich eine grosse Schale.");
   AddDetail( ({ "schale" }),
     "Eine grosse Schale befindet sich in der Mitte der "
     "Plattform. Sie besteht auch aus reinweissem Marmor und "
     "ist gefuellt mit Wasser.");
   AddDetail( ({ "wasser" }),
     "Die Schale in der Mitte der Plattform ist gefuellt mit Wasser. "
     "Doch es scheint kein normales Wasser zu sein. Von ihm geht "
     "eine unglaublich starke, magische Aura aus.");
   AddDetail( ({ "aura" }),
     "Von dem Wasser in der Schale geht eine unglaublich starke, "
     "magische Aura aus. Wenn Du nur ein Gefaess zum Schoepfen "
     "haettest koenntest Du etwas von dem magischen Wasser trinken.");
   AddDetail( ({ "gefaess" }),
     "Vielleicht ist ja irgendwo hier ein Gefaess verborgen?");
   AddDetail( ({ "schoepfen" }),
     "Du wuerdest ein Gefaess benoetigen um das Wasser trinken "
     "zu koennen.");
   AddDetail( ({ "sockel" }),
     "Ein steinerner Sockel steht am Boden neben der Schale. "
     "Er traegt einige Verzierungen.");
   AddDetail( ({ "verzierungen" }),
     "Wunderschoene Schriften wurden in den Sockel eingearbeitet.");
   AddDetail( ({ "schriften", "schriftzug" }),
     "Elfische Buchstaben wurden in den Sockel eingemeisselt. "
     "Du kannst sie aber nicht entziffern, da sie schon "
     "etwas abgebroeckelt sind. Der Sockel muss schon ziemlich alt "
     "sein.");
   AddDetail( ({ "buchstaben" }),
     "Als Du die Buchstaben naeher untersuchst, faellt Dir ein Satz "
     "auf, den man noch lesen kann.");
   AddDetail( ({ "satz" }),
     "Lies ihn!");
   
   AddReadDetail( ({ "satz" }),
     "Du gruebelst etwas und uebersetzt den Satz:\n"
     "\n"
     "Der, der den Mut besitze, druecke den Knopf\n"
     "und das Gefaess der Sinne wird erscheinen.\n"
     "\n"
     "Ploetzlich entdeckst Du einen unscheinbaren Knopf "
     "auf dem Sockel.");
   
   AddDetail( ({ "kristallkugel" }),
     "Direkt ueber der Schale, weit oben schwebt eine leuchtente "
     "Kristallkugel. Diese Kugel strahlt blaues Licht aus und "
     "erleuchtet den Raum damit.");
   AddDetail( ({ "kugel" }),
     "Die Kugel besteht aus Kristall. Sie spendet dem Raum sanftes, "
     "blaues Licht. Eine unglaublich starke, magische Aura scheint "
     "von ihr auszugehen.");
   AddDetail( ({ "licht" }),
     "Sanftes, blaues Licht wird durch die Kristallkugel verstroemt.");
   AddDetail( ({ "kristall" }),
     "Die Kugel scheint aus magischem Kristall zu bestehen.");
   AddDetail( ({ "umgebung", "raum" }),
     "Das Licht der Kugel laesst die Umgebung erstrahlen.");
   AddDetail( ({ "boden" }),
     "Der Boden wird von der Plattform gebildet.");
   AddDetail( ({ "wendeltreppe" }),
     "Ueber die Wendeltreppe gelangst Du wieder zurueck ins Dorf.");
   AddDetail( ({ "knopf" }),
     "Neben einem Schriftzug entdeckst Du einen unscheinbaren Knopf. "
     "Den koennte man vielleicht druecken?");
   AddDetail( ({ "blick" }),
     "Du hast hier freien Blick auf den Himmel.");
   AddDetail( ({ "himmel" }),
     "Der tiefblaue Himmel erstreckt sich ueber Dir. Die Sonne scheint, "
     "doch trotzdem erreicht das Sonnenlicht nicht die Plattform.");
   AddDetail( ({ "sonne" }),
     "Die Sonne steht hoch oben am Himmel, doch das Sonnenlicht "
     "erreicht die Plattform nicht.");
   AddDetail( ({ "sonnenlicht", "sonnenstrahl" }),
     "Kein einziger Sonnenstrahl erreicht die Plattform. Die "
     "Plattform wird einzig und allein von der Kristallkugel "
     "mit blauem Licht versorgt und erhellt.");
   AddDetail( ({ "unebenheiten" }),
     "Die Unebenheiten ueberziehen die ganze Plattform.");
   
   AddRoomMessage(({
     "Du erbebst bis auf Dein Innerstes.\n",
     "Eine magische Aura liegt in der Luft.\n"}), 240);

/*-----------------------GERAEUSCHE GERUECHE-----------------------*/
   
   AddSmell(DEFAULT_SMELL,
     "Du kannst hier nichts riechen.\n");
   
   AddSound(DEFAULT_SOUND,
     "Du vernimmst eine leise Stimme in Deinem Kopf.\n");
   AddSound( ({ "stimme" }),
     "Du weisst nicht so ganz was Dir die Stimme zu sagen versucht.\n");

/*---------------------ITEMS CMDS EXITS UND MAPPINGS---------------------*/
  
   AddCmd( ({ "druecke", "drueck" }), "cmd_open");
   AddCmd( ({ "nimm", "nehme" }), "cmd_get");
   AddCmd( ({ "schoepfe", "schoepf" }), "cmd_drink");
   AddCmd( ({ "beruehre", "beruehr" }), "cmd_feel");
   
   AddSpecialDetail( ({ "oeffnung" }), "oeffnung");
   AddSpecialDetail( ({ "gegenstand" }), "gegenstand");
   
   AddSpecialExit("wendeltreppe", "wendeltreppe");
   
   AddItem(NPC("siilaril"), REFRESH_DESTRUCT);
   
   schoepfer=([]);
}
reset()

{
  ::reset();
  offen = 0;
  gegenstand = 1;
  schoepfer=([]);
}
int wendeltreppe(string dir)

{
   TP->move(ROOM("fake"), M_GO | M_SILENT);
   delayedwrite(TP, 0, ({
     0, "Du beginnst ueber die lange Wendeltreppe wieder zurueck "
   	"nach unten zu gehen.",
     4, "#Vorsichtig nimmst Du eine Stufe nach der Anderen und "
     	"nach kurzer Zeit schon erreichst Du Dein Ziel.",
     0, "@@moving@@"}));
     return 1;
}

string moving()
{
  TP->move(ROOM("dorf09"), M_GO | M_SILENT);
  tell_room(ENV(TP), TPN+" kommt von oben herab.", ({TP}));
  return "";
}

int cmd_open(string str)
{
   notify_fail(BS("Was moechtest Du denn druecken?"));
   if(!(str == "knopf")) 
   {
      return 0;
   }
   if(offen)
   {
      write(BS("Da ist doch schon die Oeffnung!"));
   }
   else
   {
      write(BS("Du drueckst den Knopf und eine Oeffnung erscheint unterhalb "
      	       "des Satzes."));
   offen = 1;
   }
   return 1;
}

string oeffnung(string key)
{
   if(offen && gegenstand)
   {
      return BS("Eine kleine Oeffnung befindet sich unterhalb des "
      		"Satzes. In ihr liegt ein metallischer Gegenstand.");
   } 
   if(offen && !gegenstand)
   {
      return BS("Eine kleine Oeffnung befindet sich unterhalb des Satzes! "
      		"Sie ist leer.");
   }
   else
   {
      return BS("Sowas siehst Du da nicht!");
   } 
}

string gegenstand(string key)
{
   if(offen)
   {
   if(gegenstand)
   {
      return BS("Ein metallischer Gegenstand liegt in der Oeffnung. "
      		"Vielleicht solltest Du ihn nehmen!");
   } 
   if(!gegenstand)
   {
      return BS("Sowas siehst Du da nicht!");
   } 
   else
   {
      return BS("Sowas siehst Du da nicht!");
   }
  }
}

int cmd_get(string str)
{  
   object ob;
   notify_fail(BS("Was moechtest Du denn nehmen?"));
   if(!(str == "gegenstand" || str == "gegenstand aus oeffnung" || 
   	str == "gegenstand aus oeffnung heraus"))
   {
      return 0;
   }
   if(offen && gegenstand)
   {
      write(BS("Du nimmst den Gegenstand aus der Oeffnung an Dich."));
      gegenstand = 0;
      ob=clone_object(QOBJ("kelch"))->move(TP, M_SILENT);
      return 1;
   }
   else
   {
      return 0;
   }
}

int cmd_drink(string str)
{  
   string spieler;
   spieler=getuid(TP);
   notify_fail(BS("Was moechtest Du denn in was schoepfen?"));
   if(!(str == "wasser in gefaess" || str == "wasser mit gefaess"))
   {
      return 0;
   }
   if(!member(schoepfer, spieler))
   {
      schoepfer+=([spieler: 0]);
   }
   if(!present(QUESTKELCH, TP))
   {
      write(BS("Du brauchst zuerst den Kelch der Sinne!"));
      return 1;
   }
   if(schoepfer[spieler, 0]>=1)
   {
      write(BS("Das Wasser der Sinne kann man nicht so oft hintereinander "
      	       "trinken, warte noch ein wenig!"));
      return 1;
   }
   else
   {  
      schoepfer[spieler, 0]++;
      write(BS("Du schoepfst etwas Wasser in den Kelch und trinkst es. "
               "Ploetzlich wird Dir ganz anders."));
      tell_room(ENV(TP), TPN+" trinkt das Wasser der Sinne und wird "
      			     "Ohnmaechtig.", ({TP}));
      TP->move(QROOM("start1"), M_TPORT);
      return 1;
   }
}

int cmd_feel(string str)
{
   notify_fail(BS("Was moechtest Du denn beruehren?"));
   if(!(str == "kraftfeld"))
   {
     return 0;
   }
   if(TP->QueryProp(P_RACE)=="Dunkelelf")
   {
     write(BS("Du beruehrst das magische Kraftfeld aus weisser Magie. "
     	      "Das unvermeidliche passiert! Du als Dunkelelf haeltst "
     	      "der weissen Magie nicht stand und brichst nieder."));
     tell_room(ENV(TP), TPN+" beruehrt das magische Kraftfeld... Ploetzlich "
        		    "scheint etwas zu geschehen... "+TPN+" "
        		    "bricht nieder.\n", ({TP}));
     TP->AddHp(-50);
     return 1;
   }
   else
   {
     write(BS("Du beruehrst das magische Kraftfeld aus weisser Magie. "
     	      "Du erbebst bis auf Dein Innerstes. Du fuehlst die Waerme "
     	      "in Deiner Seele. Die weisse Magie durchflutet Dich."));
     tell_room(ENV(TP), TPN+" beruehrt das magische Kraftfeld und wird "
     			    "von der weissen Magie durchflutet.\n", ({TP}));
     return 1;
   }
}

void delayedwrite(object spieler, int curpos, mixed *daten)
{
  string output;
  if (!spieler) return;
  
  output = process_string(daten[curpos+1]);
  if (output[0] == 35) {
    tell_object(spieler, "\n");
    tell_object(spieler, BS(output[1..]));
  } else {
    tell_object(spieler, BS(output));
  }
  if (curpos + 2 < sizeof(daten))
    call_out("delayedwrite", daten[curpos+2], spieler, curpos+2, daten);
}

