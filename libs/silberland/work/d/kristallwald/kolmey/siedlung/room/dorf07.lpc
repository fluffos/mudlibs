cmd_break(string str)
{  
	
   //Noch ein kleines Feature... Bringt nur dass man wiedermal aus dem
   //Dorf fliegt =)
   notify_fail(BS("Was moechtest Du denn von wo herrausbrechen?"));
   if(!(str == "stueckchen von Skulptur herraus" ||
   	str == "stueckchen von kinn herraus" || 
   	str == "stueckchen von statue herraus" ||
        str == "stueck von kinn herraus" || 
        str == "stueck von skulptur herraus"
     || str == "stueck von statue herraus"))
   {
      return 0;
   }
   if(GEWUERZ(TP) || BLUME(TP) || GEMUESE(TP) || WILD(TP))
   {
      write(BS("Du stehst noch an einem Verkaufsstand und kommst von "
      	       "hier aus nicht ran!"));
      return 1;
   }
   else
   {
      write(BS("Grinsend brichst Du ein Stueck vom Kinn der Statue ab. "
      	       "Ploetzlich spuerst Du eine Hand auf Deiner Schulter und "
      	       "als Du Dich umdrehst erkennst Du einen Waldelfenwaechter, "
      	       "der Dich im selben Moment aus dem Dorf befoerdert. "
      	       "Das hast Du nun davon!"));
      TP->move(ROOM("eingang"), M_GO);
      return 1;
   }
}

varargs int PreventLeave(object pl, mixed dest)
{ 
  //Wenn man versucht von einem Stand aus woanders hinzukommen 
  //bekommt man eine Meldung, dass man sich vorher auf den Platz
  //zurueckdraengeln muss
  if(GEWUERZ(TP))
  {  
     write(BS("Du stehst noch vor dem Gewuerzstand. Rund um Dich "
     	      "stehen zuviele Leute um weggehen zu koennen, Du solltest "
     	      "Dich besser zurueck auf den Platz draengeln."));
     return 1;
  }
  if(BLUME(TP))
  {
    write(BS("Du stehst noch vor dem Blumenstand. Rund um Dich "
     	     "stehen zuviele Leute um weggehen zu koennen, Du solltest "
     	     "Dich besser zurueck auf den Platz draengeln."));
    return 1;
  }
  if(GEMUESE(TP))
  {
    write(BS("Du stehst noch vor dem Gemuesestand. Rund um Dich "
     	     "stehen zuviele Leute um weggehen zu koennen, Du solltest "
     	     "Dich besser zurueck auf den Platz draengeln."));
    return 1;
  }
  if(WILD(TP))
  {
    write(BS("Du stehst noch vor dem Wildstand. Rund um Dich "
     	     "stehen zuviele Leute um weggehen zu koennen, Du solltest "
     	     "Dich besser zurueck auf den Platz draengeln."));
    return 1;
  }
  return ::PreventLeave(pl);
}






      