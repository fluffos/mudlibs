inherit "std/room";

#include "../siedlung.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

//Hier definiere ich eine Abfrage ob ein Spieler am Stand steht,
//an welchem, oder ob er ueberhaupt an einem steht 
#define GEWUERZ(wer) (member(gewuerz, capitalize(getuid(wer)))!=-1)
#define BLUME(wer) (member(blume, capitalize(getuid(wer)))!=-1)
#define GEMUESE(wer) (member(gemuese, capitalize(getuid(wer)))!=-1)
#define WILD(wer) (member(wild, capitalize(getuid(wer)))!=-1)

//Hier wird abgefragt wer an einem der Staende steht
#define MyCountUp(arg) (sizeof(arg) > 1 ? \
        implode(arg[0..<2], ", ") + " und " + arg[<1] : \
        (sizeof(arg) == 0 ? "niemand" : arg[0]) )

string *gewuerz=({});
string *blume=({});
string *gemuese=({});
string *wild=({});

//Hier gebe ich die einzelnen Preise der Artikel an, die man 
//auf den Staenden kaufen kann
int kkrautpreis   =  3000;
int tomatenpreis  =   500;
int karottenpreis =  1000;
int blumenpreis  =  1500;

//mappings
mapping blumenkaeufer;
mapping krautkaeufer;
mapping karottenkaeufer;
mapping tomatenkaeufer;

create()

{
::create();

/*-----------------------KURZ UND LANGBESCHREIBUNG-----------------------*/

   SetProp(P_INT_SHORT, "Marktplatz im Waldelfendorf");
   SetProp(P_INT_LONG,
     "Du befindest Dich auf einem Platz im Waldelfendorf.\n"
     "Hier herrscht reges Treiben - Ueberall wird gedraengelt und "
     "geschubst. Zwischen Verkaufsstaenden, die rund um den Brunnen "
     "aufgestellt wurden, eilen elfische Haendler herum "
     "und gehen ihren Geschaeften nach. Hier ist kaum noch Platz um sich "
     "frei bewegen zu koennen. Im Sueden und Suedwesten wird das Dorf durch "
     "den Wall begrenzt und nach Westen und Osten fuehrt Dich die Strasse "
     "in andere Teile des Dorfes.");
   
/*-----------------------RAUMEIGENSCHAFTEN-----------------------*/
   
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );
   SetProp(P_INDOORS, 0);
   SetProp(P_LOG_FILE, "/d/kristallwald/kolmey/room.log");

/*-----------------------RAUMDETAILS-----------------------*/
  
   AddDetail( ({ "platz" }),
     "Du befindest Dich gerade auf einem Platz im Waldelfendorf.");
   AddDetail( ({ "treiben" }),
     "Hier auf dem Platz herrscht reges Treiben. Ueberall huschen Leute "
     "zwischen den Verkaufsstaenden herum und kaufen und verkaufen Waren.");
   AddDetail( ({ "waren" }),
     "Meist handelt es sich um Wild, dass die Jaeger auf der Jagd erlegt "
     "haben. Aber auch Gewuerze, Gemuese und Blumen werden hier verkauft.");
   AddDetail( ({ "pfeile", "pfeil", "bogen" }),
     "Die Jaeger jagen das Wild mit Pfeil und Bogen und scheinen sehr "
     "erfolgreich zu sein.");
   AddDetail( ({ "jaeger" }),
     "Die meisten maennlichen Waldelfen sind Jaeger. Darin sind sie "
     "wahrhafte Meister!");
   AddDetail( ({ "meister" }),
     "Die meisten maennlichen Waldelfen sind Meister im Umgang mit "
     "Pfeil und Bogen. Sie kennen den Wald in und auswendig. Was halt "
     "nicht gerade ein Vorteil der Tiere ist.");
   AddDetail( ({ "tiere" }),
     "Tiere die im Wald leben werden auch Wild genannt.");
   AddDetail( ({ "vorteil" }),
     "Die Jaeger sind Meister ihres Fachs und das wiederum ist "
     "nicht gerade ein Vorteil fuer das Wild dass im Wald lebt.");
   AddDetail( ({ "fach", "fachgebiet" }),
     "Das Fachgebiet eines Jaeger ist zweifelsohne das jagen.");
   AddDetail( ({ "umgang" }),
     "Vielleicht solltest Du mit einem Jaeger sprechen.");
   AddDetail( ({ "waldelfen" }),
     "Du befindest Dich hier im Waldelfendorf. Also muesste klar sein "
     "dass hier Waldelfen leben.");
   AddDetail( ({ "wald" }),
     "Ausserhalb des Dorfes befindet sich der Kristallwald.");
   AddDetail( ({ "kristallwald" }),
     "Der Kristallwald befindet sich ausserhalb des Dorfes. Du solltest "
     "ihn Dir mal angucken.");
   AddDetail( ({ "geld" }),
     "Hier wird, wie im ganzen SilberLand, mit Muenzen bezahlt.");
   AddDetail( ({ "muenzen", "muenze" }),
     "Oh! Du hast ja gar keine Muenzen dabei!");
   AddDetail( ({ "silberland", "welt" }),
     "So heisst die Welt hier.");
   AddDetail( ({ "dorf", "waldelfendorf" }),
     "Du befindest Dich gerade im Waldelfendorf.");
   AddDetail( ({ "beute" }),
     "Aufgrund des Wilds dass hier verkauft wird, kannst "
     "Du darauf schliessen, dass die Jaeger in ihrer Arbeit sehr "
     "erfolgreich sind.");
   AddDetail( ({ "arbeit", "jagd" }),
     "Die Arbeit eines Jaegers ist die Jagd. Sich im Wald auf die "
     "Pirsch zu begeben ist bestimmt nicht jedermanns Sache!");
   AddDetail( ({ "pirsch", "sache" }),
     "Anpirschen soll gelernt sein!");
   AddDetail( ({ "leute" }),
     "Ueberall hier huschen Leute ueber den Platz und gehen "
     "ihren Geschaeften nach.");
   AddDetail( ({ "geschaefte" }),
     "Jeder hat seine eigenen Geschaefte. Haendler handeln und "
     "andere wiederrum kaufen ein.");
   AddDetail( ({ "haendler" }),
     "Elfische Haendler eilen zwischen den Verkaufsstaenden herum und "
     "verkaufen ihre Waren.");
   AddDetail( ({ "verkaufsstaende" }),
     "Einige Verkaufsstaende wurden um den Brunnen herum aufgestellt. "
     "Du kannst einen Gewuerzstand, einen Blumenstand, einen "
     "Wildstand und einen Gemuesestand erkennen.");
   AddDetail( ({ "stand", "verkaufsstand" }),
     "Du kannst einen Gewuerzstand, einen Blumenstand, einen "
     "Wildstand und einen Gemuesestand erkennen.");
   AddDetail( ({ "sonne" }),
     "Die Sonne steht hoch am wolkenlosen Himmel und sendet ihre "
     "waermenden Strahlen zu Dir herab.");
   AddDetail( ({ "himmel" }),
     "Von hier aus hast Du einen wunderbaren Blick ueber den blauen, "
     "wolkenlosen Himmel ausdem Dir die Sonne entgegen lacht.");
   AddDetail( ({ "blick" }),
     "Du kannst von hier aus den Himmel wunderbar betrachten.");
   AddDetail( ({ "sonnenlicht", "licht" }),
     "Die Sonne spendet hier ihr waermendes Licht und laesst die Strasse "
     "in zahlreichen Farben funkeln. Jedoch dringt das Funkeln hier "
     "nur an wenigen Stellen vom Boden herauf, da einfach zu viele Leute "
     "hier auf dem Platz herumlaufen.");
   AddDetail( ({ "strahlen", "sonnenstrahlen" }),
     ([ 0: "Die Sonne schickt ihre Strahlen und erwaermt damit Deine Haut.",
     "dunkelelf": "Igitt! Die Sonnenstrahlen erwaermen Deine Haut! "
     		  "Du solltest besser wieder zurueck in die Unterwelt "
     		  "gehen, ehe Du noch Schaden davon traegst."]));
   AddDetail( "unterwelt", ([ 0: "Sowas siehst Du da nicht!",
     "dunkelelf": "Da ist es schoen dunkel, genau das richtige fuer "
     		  "Dich."]));
   AddDetail( "schaden", ([ 0: "Sowas siehst Du da nicht!",
     "dunkelelf": "Naja, man weiss ja nicht was die Sonne so alles "
     	          "aus Deiner weissen Haut machen wird."]));
   AddDetail( "haut", ([ 0: "Deine Haut ist noch weiss.",
     "dunkelelf": "An Deiner Haut hat sich noch nicht viel veraendert!"]));
   AddDetail( ({ "funkeln" }),
     "Das Funkeln ist hier nicht so oft zu sehen wie an anderen, unbelebteren "
     "Stellen des Dorfes.");
   AddDetail( ({ "stellen" }),
     "Da! Du hast fuer einen Moment eine Stelle entdeckt an der das schoene "
     "Funkeln des Kristalls im Sonnenlicht erscheint.");
   AddDetail( ({ "moment" }),
     "Oh! Jetzt kannst Du die Stelle in der Elfenmasse nicht mehr sehen.");
   AddDetail( ({ "elfenmasse" }),
     "Sehr viele Elfen laufen hier umher.");
   AddDetail( ({ "boden" }),
     "Du kannst den Boden vor lauter Leuten kaum sehen, jedoch scheint "
     "er auch hier aus Steinplatten zu bestehen, die mit einer duennen, "
     "weisslichen Kristallschicht ueberzogen sind.");
   AddDetail( ({ "kristall" }),
     "Im Kristallwald traegt einiges eine duenne Kristallschicht und "
     "dieses Dorf befindet sich auch im Kristallwald.");
   AddDetail( ({ "kristallschicht", "schicht" }),
     "Auch hier traegt einiges eine duenne, weissliche Kristallschicht "
     "die in der Sonne funkelt.");
   AddDetail( ({ "steinplatten" }),
     "Der Boden bzw. der Platz ist mit Steinplatten ausgelegt worden, "
     "die eine duenne Kristallschicht tragen.");
   AddDetail( ({ "sueden", "suedwesten" }),
     "Im Sueden und Suedwesten befindet sich ein regelrechter Wall "
     "aus kristallinen Straeuchern und Hecken, der das Dorf zu schuetzen "
     "scheint.");
   AddDetail( ({ "wall" }),
     "Kristalline Straeucher und Hecken bilden einen regelrechten "
     "Wall rund um das Dorf und machen Dir ein Weiterkommen in andere "
     "Richtungen ausser dem Strassenverlauf unmoeglich.");
   AddDetail( ({ "straeucher", "hecken", "teil" }),
     "Die Straeucher und Hecken sind noch Teil des Kristallwaldes, "
     "der sich rund um das Dorf befindet.");
   AddDetail( ({ "weiterkommen" }),
     "Du kannst allerhoechstens der Strasse folgen, denn die Hecken und "
     "Straeucher aus denen der Wall besteht machen ein Weiterkommen "
     "in andere Richtungen unmoeglich.");
   AddDetail( ({ "richtungen"}),
     "Du kannst hier nach Osten und Westen gehen.");
   AddDetail( ({ "teile", "osten", "westen" }),
     "Im Osten und Westen kommst Du in andere Teile des Dorfes.");
   AddDetail( ({ "strasse" }),
     "Die Strasse ist hier eher der Platz.");
   AddDetail( ({ "strassenverlauf", "verlauf" }),
     "Die Strasse verlaeuft von Westen nach Nordosten.");
   AddDetail( ({ "nase" }),
     "Du muesstest schielen um Deine Nase erkennen zu koennen.");
   AddDetail( ({ "holz" }),
     "Es scheint sich um Holz aus dem Kristallwald zu handeln.");
   AddDetail( ({ "brunnen" }),
     "Auf der Mitte des Platzes befindet sich ein runder Brunnen. "
     "Im Brunnen steht eine Skulptur.");
   AddDetail( ({ "mitte" }),
     "In der Mitte des Platzes befindet sich ein runder Brunnen.");
   AddDetail( ({ "skulptur" }),
     "Die Skulptur stellt einen Waldelf dar. In dessen Mund befindet "
     "sich ein kleines Loch, aus dem Wasser herrausspritzt und "
     "das Brunnenbecken fuellt.");
   AddDetail( ({ "waldelf" }),
     "Der Waldelf, der die Skulptur bildet, posiert grazil.");
   AddDetail( ({ "mund" }),
     "Im Mund des Waldelfs befindet sich ein kleines Loch, "
     "aus dem Wasser spritzt.");
   AddDetail( ({ "loch" }),
     "Aus dem Loch spritzt Wasser und fuellt das Brunnenbecken. "
     "Komisch... Unter ihm auf dem Kinn scheint etwas zu sein.");
   AddDetail( ({ "brunnenbecken" }),
     "Das Brunnenbecken bildet den eigentlichen Brunnen. Es ist "
     "mit Wasser gefuellt. In ihm liegen einige Muenzen.");
   AddDetail( ({ "wasser" }),
     "Ganz klares, reines Wasser befindet sich im Brunnen.");
   AddDetail( ({ "muenzen" }),
     "Viele aberglaubische Leute haben anscheinend schon Muenzen in "
     "das Brunnenbecken geworfen.");
   AddDetail( ({ "kinn" }),
     "Als Du Dir das Kinn der Skulptur so naeher betrachtest, faellt Dir "
     "auf, dass da ein Stueckchen schon ziemlich locker dranhaengt. "
     "Vielleicht kannst Du es ja herrausbrechen.");
   AddDetail( ({ "stueckchen" }),
     "Ein Stueckchen des Kinns der Skulptur scheint ziemlich locker "
     "zu sein. Vielleicht kann man es ja herrausbrechen?");

/*-----------------------DIE RANDOM RAUMMELDUNGEN-----------------------*/
   
   AddRoomMessage(({
     "Ein Haendler draengelt sich bei Dir vorbei.\n",
     "Ein Haendler preist lautstark seine Waren an.\n",
     "Ein Frau schubst Dich unabsichtlich.\n"}), 100);

/*-----------------------GERAEUSCHE UND GERUECHE-----------------------*/
  
   AddSound(DEFAULT_SOUND,
     "Einige Haendler preisen lautstark ihre Waren an.");
   AddSound( ({ "haendler" }),
     "FRISCHES GEMUESE, FRISCHES GEMUESE!");
     
   AddSmell(DEFAULT_SMELL,
     "Hier riecht es nach den verschiedensten Dingen.");
   AddSmell( ({ "dinge" }),
     "Du kannst Gewuerze, Fleisch, Gemuese und Blumen riechen.");
   AddSmell( ({ "gewuerze", "fleisch", "gemuese", "blumen" }),
     "Die Gerueche vermischen sich, sodass Du irritiert bist.");
   AddSmell( ({ "gerueche" }),
     "Deine arme Nase. So viele Gerueche, Du kannst keinen einzelnen "
     "selektieren.");

/*-----------------------SPECIAL_DETAILS-----------------------*/

   AddSpecialDetail( ({ "schild" }), "schild");
   AddSpecialDetail( ({ "gewuerzstand" }), "gewuerzstand");
     AddSpecialDetail( ({ "kraut" }), "kraut");
     AddSpecialDetail( ({ "gewuerz", "gewuerze" }), "gewuerze");
     AddSpecialDetail( ({ "frau", "waldelfe" }), "gewuerzfrau");
     AddSpecialDetail( ({ "koenigskraut", "artilas pflanze" }), 
     			  "koenigskraut");
     AddSpecialDetail( ({ "pfeffer" }), "pfeffer");
     AddSpecialDetail( ({ "pfefferschoten", "schoten" }), "schoten");
     AddSpecialDetail( ({ "salz", "saeckchen", "aufschrift" }), "salz");
     AddSpecialDetail( ({ "kuemmel", "kuemmelkoerner" }), "kuemmel");
     
   AddSpecialDetail( ({ "blumenstand" }), "blumenstand");
     AddSpecialDetail( ({ "blumenstraeusse", "straeusse" }), "straeusse");
     AddSpecialDetail( ({ "frau", "waldelfe" }), "blumenfrau");
     AddSpecialDetail( ({ "eindruck", "ausstrahlung" }), "eindruck");
     AddSpecialDetail( ({ "rosenstrauss", "rosen" }), "rosen");
     AddSpecialDetail( ({ "veilchenstrauss", "veilchen" }), "veilchen");
     AddSpecialDetail( ({ "margheritenstrauss", "margheriten", "anblick" }), 
     			  "margheriten");
     AddSpecialDetail( ({ "tulpenstrauss", "tulpen", "blueten" }), "tulpen");
     AddSpecialDetail( ({ "freude" }), "freude");
     
   AddSpecialDetail( ({ "gemuesestand" }), "gemuesestand");
     AddSpecialDetail( ({ "gemuese" }), "gemues");
     AddSpecialDetail( ({ "tomaten", "tomate" }), "tomate");
     AddSpecialDetail( ({ "karotten", "karotte" }), "karotte"); 
     AddSpecialDetail( ({ "mann", "waldelf" }), "gemuesemann");
     AddSpecialDetail( ({ "gesicht", "falten" }), "gesicht");
