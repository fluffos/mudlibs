/*-----------------------SPECIAL_DETAIL-----------------------*/

string schild()
{ 
  string schild;
  if(GEWUERZ(TP) || BLUME(TP) || GEMUESE(TP) || WILD(TP))
  {
     schild =
     "Auf dem Schild steht: Zum Kaufen einfach <kaufe gegenstand> "+
     "benutzen.";
  }
  else
  {
     schild =
     "Sowas siehst Du da nicht!";
  }
  return break_string(schild, 78);
}

//Mit dem Befehl <draengel> kommt man zu den einzelnen 
//Staenden durch
int cmd_gothere(string str)
{
   object ob;
   notify_fail(BS("Wohin moechtest Du Dich draengeln?"));
   if(!str) return 0;
   if(str == "zu gewuerzstand" || str == "zu gewuerzstand durch" ||
      str == "zum gewuerzstand" || str == "zum gewuerzstand durch")
   {
   if(GEWUERZ(TP))
   {
   //Um die SpecialDetails ua. moeglich zu machen, darf natuerlich auch die
   //Abfrage nicht fehlen, ob man schon an einem Stand steht oder nicht
   //Wenn ja muss man sich erst wieder zurueck auf den Platz draengeln
   write(BS("Du stehst schon so nahe wie moeglich am Gewuerzstand!"));
   return 1;
   }
   if(GEMUESE(TP))
   {
   write(BS("Du stehst noch vor dem Gemuesestand!"));
   return 1;
   }
   if(WILD(TP))
   {
   write(BS("Du stehst noch vor dem Wildstand!"));
   return 1;
   }
   if(BLUME(TP))
   {
   write(BS("Du stehst noch vor dem Blumenstand!"));
   return 1;
   }
   //Hier wird geprueft ob sich schon ein Spieler an einem Stand befindet
   //Da hier nur Platz fuer einen ist
   if(sizeof(gewuerz)>=1)
   {
   write(BS("Du schaffst es nicht Dich zum Gewuerzstand "
   	    "durchzudraengeln, da "+CAP(gewuerz[0])+" schon vor dem "
   	    "Stand steht und kein Platz mehr ist."));
   return 1;
   }
   write(BS("Du draengelst Dich durch die Elfenmasse und gelangst "
   	    "vor den Gewuerzstand."));
   tell_room(ENV(TP), TPN+" draengelt sich zum Gewuerzstand "
   			  "durch.\n", ({TP}));
   gewuerz+=({ capitalize(getuid(TP)) });
   return 1;
   }
   if(str == "zu blumenstand" || str == "zu blumenstand durch" ||
      str == "zum blumenstand" || str == "zum blumenstand durch")
   {
   if(GEWUERZ(TP))
   {
   write(BS("Du stehst noch vor dem Gewuerzstand!"));
   return 1;
   }
   if(GEMUESE(TP))
   {
   write(BS("Du stehst noch vor dem Gemuesestand!"));
   return 1;
   }
   if(WILD(TP))
   {
   write(BS("Du stehst noch vor dem Wildstand!"));
   return 1;
   }
   if(BLUME(TP))
   {
   write(BS("Du stehst schon so nahe wie moeglich am Blumenstand!"));
   return 1;
   }
   if(sizeof(blume)>=1)
   {
   write(BS("Du schaffst es nicht Dich zum Blumenstand "
   	    "durchzudraengeln, da "+CAP(blume[0])+" schon vor dem "
   	    "Stand steht und kein Platz mehr ist."));
   return 1;
   }
   write(BS("Du draengelst Dich durch die Elfenmasse und gelangst "
   	    "vor den Blumenstand."));
   tell_room(ENV(TP), TPN+" draengelt sich zum Blumenstand "
   			  "durch.\n", ({TP}));
   blume+=({ capitalize(getuid(TP)) });
   return 1;
   }
   if(str == "zu gemuesestand" || str == "zu gemuesestand durch" ||
      str == "zum gemuesestand" || str == "zum gemuesestand durch")
   {
   if(GEWUERZ(TP))
   {
   write(BS("Du stehst noch vor dem Gewuerzstand!"));
   return 1;
   }
   if(GEMUESE(TP))
   {
   write(BS("Du stehst schon so nahe wie moeglich am Gemuesestand!"));
   return 1;
   }
   if(WILD(TP))
   {
   write(BS("Du stehst noch vor dem Wildstand!"));
   return 1;
   }
   if(BLUME(TP))
   {
   write(BS("Du stehst noch vor dem Blumenstand!"));
   return 1;
   }
   if(sizeof(gemuese)>=1)
   {
   write(BS("Du schaffst es nicht Dich zum Gemuesestand "
   	    "durchzudraengeln, da "+CAP(gemuese[0])+" schon vor dem "
   	    "Stand steht und kein Platz mehr ist."));
   return 1;
   }
   write(BS("Du draengelst Dich durch die Elfenmasse und gelangst "
   	    "vor den Gemuesestand."));
   tell_room(ENV(TP), TPN+" draengelt sich zum Gemuesestand "
   			  "durch.\n", ({TP}));
   gemuese+=({ capitalize(getuid(TP)) });
   return 1;
   }
   if(str == "zu wildstand" || str == "zu wildstand durch" ||
      str == "zum wildstand" || str == "zum wildstand durch")
   {
   if(GEWUERZ(TP))
   {
   write(BS("Du stehst noch vor dem Gewuerzstand!"));
   return 1;
   }
   if(GEMUESE(TP))
   {
   write(BS("Du stehst noch vor dem Gemuesestand!"));
   return 1;
   }
   if(WILD(TP))
   {
   write(BS("Du stehst schon so nahe wie moeglich am Wildstand!"));
   return 1;
   }
   if(BLUME(TP))
   {
   write(BS("Du stehst noch vor dem Blumenstand!"));
   return 1;
   }
   if(sizeof(wild)>=1)
   {
   write(BS("Du schaffst es nicht Dich zum Wildstand "
   	    "durchzudraengeln, da "+CAP(wild[0])+" schon vor dem "
   	    "Stand steht und kein Platz mehr ist."));
   return 1;
   }
   write(BS("Du draengelst Dich durch die Elfenmasse und gelangst "
   	    "vor den Wildstand."));
   tell_room(ENV(TP), TPN+" draengelt sich zum Wildstand "
   			  "durch.\n", ({TP}));
   wild+=({ capitalize(getuid(TP)) });
   return 1;
   }
   if(str == "zurueck" || str == "auf platz zurueck" ||
      str == "zurueck auf platz" || str == "auf platz")
   {
   if(GEWUERZ(TP))
   {
   write(BS("Du draengelst Dich zurueck auf den Platz!"));
   gewuerz-=({ capitalize(getuid(TP)) });
   tell_room(ENV(TP), TPN+" draengelt sich vom Gewuerzstand "
   			  "zurueck auf den Platz.\n", ({TP}));
   return 1;
   }
   if(GEMUESE(TP))
   {
   write(BS("Du draengelst Dich zurueck auf den Platz!"));
   gemuese-=({ capitalize(getuid(TP)) });
   tell_room(ENV(TP), TPN+" draengelt sich vom Gemuesestand "
   			  "zurueck auf den Platz.\n", ({TP}));
   return 1;
   }
   if(WILD(TP))
   {
   write(BS("Du draengelst Dich zurueck auf den Platz!"));
   wild-=({ capitalize(getuid(TP)) });
   tell_room(ENV(TP), TPN+" draengelt sich vom Wildstand "
   			  "zurueck auf den Platz.\n", ({TP}));
   return 1;
   }
   if(BLUME(TP))
   {
   write(BS("Du draengelst Dich zurueck auf den Platz!"));
   blume-=({ capitalize(getuid(TP)) });
   tell_room(ENV(TP), TPN+" draengelt sich vom Blumenstand "
   			  "zurueck auf den Platz.\n", ({TP}));
   return 1;
   }
  }
}

void BecomesNetDead(object spieler)
{
  //Wenn ein Spieler ausloggt etc. Quasi Netztot wird,
  //und an einem Stand steht muss man diesen dann natuerlich 
  //vom Stand entfernen... Dies geschieht hier
  if(GEWUERZ(spieler))
  gewuerz -= ({ capitalize(getuid(spieler)) });
  if(BLUME(spieler))
  blume -= ({ capitalize(getuid(spieler)) });
  if(GEMUESE(spieler))
  gemuese -= ({ capitalize(getuid(spieler)) });
  if(WILD(spieler))
  wild -= ({ capitalize(getuid(spieler)) });
}

