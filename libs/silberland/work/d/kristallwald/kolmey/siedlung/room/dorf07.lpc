/*-----------------------EIN PAAR WEITERE FUNKTIONEN-----------------------*/

int cmd_steal(string str)
{  
   //Der Wildstand ist eigentlich ein reiner Fake... Man kann hier 
   //nichts kaufen, da der Verkaeufer nicht da ist... Also kann man
   //was zu stehlen versuchen, das endet jedoch wie bei der Huette...
   notify_fail(BS("Was moechtest Du denn stehlen?"));
   if(!(str == "wild" || str == "hirschruecken" || str == "rehkeule"
     || str == "wildschweinruessel" || str == "hase" || str == "keule"
     || str == "ruecken" || str == "ruessel"))
   {
      return 0;
   }
   if(!(WILD(TP)))
   {
      write(BS("Du kannst hier nichts stehlen!"));
      return 1;
   }
   else
   {
      if(GEWUERZ(TP))
      gewuerz -= ({ capitalize(getuid(TP)) });
      if(BLUME(TP))
      blume -= ({ capitalize(getuid(TP)) });
      if(GEMUESE(TP))
      gemuese -= ({ capitalize(getuid(TP)) });
      if(WILD(TP))
      wild -= ({ capitalize(getuid(TP)) });
      write(BS("Du versuchst Dir etwas Wild vom Stand zu stehlen. "
      	       "Ploetzlich klopft Dir jemand auf die Schulter. "
      	       "Als Du Dich umdrehst erkennst Du einen Waldelfenwaechter "
      	       "der Dich in dem Moment schnappt und aus dem Dorf "
      	       "befoerdert. Jetzt siehst Du was Du von Diebstahl hast!"));
      tell_room(ENV(TP), TPN+" wird beim Stehlen erwischt und aus dem Dorf "
      			     "geworfen.\n", ({TP}));
      TP->move(ROOM("eingang"), M_GO);
      return 1;
      }
}

int cmd_buy(string str)
{  
	
   //An den restlichen Staenden kann man aber etwas kaufen
   //Das Ganze Sortiment besteht aus 7 Gegenstaenden
   //Alle mehr oder weniger ohne Bedeutung, bis auf das
   //Koenigskraut, dass Spieler von einer Vergiftung bis
   //zum Wert 5 heilen kann
   //siehe /d/kristallwald/kolmey/siedlung/obj/koenigskraut
   object ob1, ob2, ob3, ob4, ob5, ob6, ob7;
   string spieler;	
   spieler=getuid(TP);
   //Ich habe bei den einzelnen Staenden mit mappings gearbeitet
   //um den Speicher zu schonen und ein 1000 faches kaufen zu unterbinden
   //Alles kann nur einmal gekauft werden, bis auf die Blumenstraeusse
   //da es 4 von ihnen gibt habe ich einen mapping Eintrag x4 gewaehrt
   //Es steht dem Spieler frei sich 4 gleiche, oder 4 verschiedene
   //Straeusse zu kaufen, jedoch nicht mehr
   notify_fail(BS("Was moechtest Du denn kaufen?"));
   if(str == "koenigskraut" || str == "kraut" || str == "artilas pflanze")
   {
   if(!(GEWUERZ(TP)))
   {
      write(BS("Sowas kannst Du hier nicht kaufen!"));
      return 1;
   }
   if(!member(krautkaeufer, spieler))
   {
     krautkaeufer+=([spieler: 0]);
   }
   if(krautkaeufer[spieler, 0]>=1)
   {
