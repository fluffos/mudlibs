string gewuerzstand()
{
  string gewuerzinfo;
  if(GEWUERZ(TP))
  {
     gewuerzinfo =
     "Du stehst direkt vor dem Gewuerzstand neben dem ein Schild steht. "+
     "Hinter dem Stand aus Holz steht eine Frau, die "+
     "Dich erwartungsvoll anblickt. Auf ihm sind einige Gewuerze "+
     "aufgelegt. Am meisten aber erregt ein kleines Kraut "+
     "Deine Aufmerksamkeit.";
  }
  else
  {
     gewuerzinfo =
     "Vor dem Gewuerzstand stehen zuviele Leute herum und verdecken "+
     "Dir den Blick auf genaueres. ";
  if(sizeof(gewuerz)==1 )
     gewuerzinfo += "Im Moment steht " + gewuerz[0] + " vor dem Stand.";
    
  if(sizeof(gewuerz)<1 )
     gewuerzinfo += "Vielleicht kannst Du Dich ja zum Stand "+
     		   "durchdraengeln.";
  }
  return break_string(gewuerzinfo, 78);
}

