/*-----------------------CMDS MAPPINGS EXITS UND ITEMS-----------------------*/
   
   AddItem(NPC("waechter"), REFRESH_DESTRUCT);
   AddItem(NPC("waldelfe"), REFRESH_DESTRUCT);
   
   AddCmd( ({ "draengel", "draengle" }), "cmd_gothere");
