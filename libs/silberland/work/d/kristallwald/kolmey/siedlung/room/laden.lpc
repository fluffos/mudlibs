inherit "std/laden";

#include "../siedlung.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

mapping brett;

create()

{

::create();
  
/*-----------------------KURZ UND LANGBESCHREIBUNG-----------------------*/
  
   SetProp (P_INT_SHORT,"Waldelfen Shop");
   SetProp (P_INT_LONG, 
     "Der Holzboden knirscht ein wenig, als Du Dich im Eingangsbereich "
     "des Ladens umsiehst. Von Westen kommt das warme, matte Licht der "
     "Sonne durch ein kleines Fenster herein. An der Dir "
     "gegenueberliegenden Seite ist eine kleine Theke, die sehr schlicht "
     "gehalten wurde, und darueber haengt eine Tafel, auf etwas geschrieben "
     "steht. Schraeg dahinter in der einen Ecke siehst Du einen grossen, "
     "hoelzernen Waffenstaender, an dem zahlreiche Waffen haengen und im "
     "anderen Eck wurden zwei Holzschraenke aufgestellt, deren Tueren "
     "unterschiedlichste Verzierungen aufweisen. Auf einem Regal, das links "
     "von Dir haengt, sind auch noch ein paar Gegenstaende aufgestappelt "
     "worden. Du wirst hier sicher einiges finden, das Du fuer Deine "
     "weitere Abenteuer brauchen kannst.");

/*-----------------------RAUMEIGENSCHAFTEN-----------------------*/

   SetProp(P_LIGHT, 1);
   SetProp(P_INDOORS, 1);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE: 20]) );
   SetProp(P_LOG_FILE, "/d/kristallwald/kolmey/room.log");

/*-----------------------RAUMDETAILS-----------------------*/
   
   AddDetail( ({ "laden", "ueberblick", "raum" }), TO->QP(P_INT_LONG));
   
   AddDetail( ({ "holzboden", "boden" }),
     "Der Boden hier wurde mit Holzplatten ausgelegt. Sie schimmern "
     "im zarten weiss des Kristalls. Die Platten knarren leise, wenn "
     "Du Dich bewegst.");
   AddDetail( ({ "holz" }),
     "Es scheint sich um Holz aus dem Kristallwald zu handeln, denn "
     "es schimmert im zarten weiss des Kristalls.");
   AddDetail( ({ "platten", "holzplatten" }),
     "Der Boden wurde mit Holzplatten ausgelegt. Es scheint sich hier um "
     "Holz aus dem Kristallwald zu handeln. Eine Holzplatte scheint etwas "
     "locker zu sein.");
   AddDetail( ({ "holzplatte", "platte" }),
     "Ja, Du hattest recht, eine Holzplatte ist ziemlich locker und "
     "es sieht fast so aus, als wuerde sich da drunter etwas bewegen. "
     "Vielleicht koenntest Du die Platte entfernen?");
   AddDetail( ({ "kristallwald" }),
     "Rund um das Dorf befindet sich der Kristallwald. Dort soll "
     "alles vom Kristall ueberzogen sein.");
   AddDetail( ({ "dorf" }),
     "Du befindest Dich gerade in einem Laden im Waldelfendorf.");
   AddDetail( ({ "waldelfendorf" }),
     "Du befindest Dich gerade im Waldelfendorf.");
   AddDetail( ({ "kristall" }),
     "Der Kristall schimmert in zartem weiss.");
   AddDetail( ({ "eingangsbereich" }),
     "Du stehst gerade hier im Laden im Eingangsbereich. An der Dir "
     "gegenueberliegenden Seite befindet sich eine schlicht gehaltene "
     "Theke, von der aus die Bestellungen angenommen werden.");
   AddDetail( ({ "bestellungen" }),
     "Bestellungen aller Art koennen von der Theke aus entgegengenommen "
     "werden.");
   AddDetail( ({ "art" }), 
     "Was man hier bestellen kann sagt Dir der Verkaeufer mit <zeig>.");
   AddDetail( ({ "verkaeufer" }),
     "Der Verkaeufer steht stumm hinter der Theke und wartet auf einen "
     "Kunden.");
   AddDetail( ({ "kunde" }),
     "Der Verkaeufer wartet auf einen Kunden, ja vielleicht bist "
     "ja schon sein naechster Kunde?");
   AddDetail( ({ "kunden" }),
     "Viele Kunden hat der Verkaeufer schon bedient und ihnen gebracht "
     "was sie bestellt haben.");
   AddDetail( ({ "westen", "westwand", "fenster" }),
     "In der Westwand befindet sich ein kleines Fenster, durch das "
     "das matte, warme Licht der Sonne hereinstroemt und Dir so einen "
     "Ueberblick ueber den Laden vermittelt. Links von Dir, neben dem "
     "Fenster haengt ein Regal.");
   AddDetail( ({ "sonne" }),
     "Die Sonne schickt ihre warmen Strahlen durch das Fenster in der "
     "Westwand.");
   AddDetail( ({ "strahlen", "sonnenstrahlen" }),
     "Sonnenstrahlen dringen durch das Fenster in der Westwand herein und "
     "erhellen den Raum.");
   AddDetail( ({ "licht" }),
     "Die Sonne spendet dem Raum das noetige Licht.");
   AddDetail( ({ "seite" }),
     "An der Dir gegenueberliegenden Seite befindet sich eine Theke.");
   AddDetail( ({ "theke" }),
     "Eine schlicht gehaltene Theke aus Holz befindet sich auf der Dir "
     "gegenueberliegenden Seite. Von ihr aus werden die Bestellungen "
     "angenommen. Ueber der Theke haengt eine Tafel. Schraeg hinter "
     "der Theke in der einen Ecke siehst Du einen Waffenstaender.");
   AddDetail( ({ "tafel" }),
     "Eine Tafel haengt ueber der Theke. Du kannst es lesen.");
   AddDetail( ({ "waffenstaender" }),
     "Ein hoelzerner Waffenstaender befindet sich schraeg hinter der "
     "Theke in der einen Ecke. Er ist mit zahlreichen Waffen bestueckt.");
   AddDetail( ({ "ecke", "ecken", "eck" }),
     "Der Raum hat vier Ecken. Interessant sind aber nur die Ecken hinter "
     "der Theke. Zum einen befindet sich dort ein Waffenstaender und zum "
     "anderen wurden zwei Holzschraenke dort aufgestellt.");
   AddDetail( ({ "waffen" }),
     "Schwerter, Schilde, Aexte, Boegen, Knueppel, Peitschen, alles was "
     "das Herz begehrt.");
   AddDetail( ({ "herz" }),
     "Dein Herz schlaegt beim Anblick dieser Waffen hoeher.");
   AddDetail( ({ "anblick" }),
     "Fuer so einen Krieger wie Dich laesst der Anblick der Waffen "
     "Dein Herz hoeher schlagen.");
   AddDetail( ({ "krieger" }),
     "Na Du bist damit gemeint!");
   AddDetail( ({ "schwerter", "schilde", "aexte", "boegen", "knueppel",
                 "peitschen" }),
     "Mit <zeig> bekommst Du einen genauen Ueberblick ueber "
     "das Sortiment hier.");
   AddDetail( ({ "ueberblick", "sortiment" }),
     "Mit <zeig> bekommst Du einen genauen Ueberblick.");
   AddDetail( ({ "holzschraenke", "schraenke" }),
     "Zwei Holzschraenke wurden im anderen Eck hinter der Theke "
     "aufgestellt. Die Tueren der Schraenke sehen wunderschoen aus. "
     "In den Schraenken werden anscheinend ein paar Gegenstaende "
     "gelagert.");
   AddDetail( ({ "tueren" }),
     "Die Tueren der Schraenke weisen die unterschiedlichsten "
     "Verzierungen auf.");
   AddDetail( ({ "verzierungen" }),
     "Wunderschoene Verzierungen wurden in die hoelzernen Tueren "
     "der Schraenke eingearbeitet, sodass an manchen Stellen der "
     "Kristall, von dem das Holz ueberzogen war abgetragen wurde und "
     "das urspruengliche Holz zum Vorschein kommt. Eine wunderschoene "
     "Kombination aus dem schimmernden Kristall und dem rohen Holz.");
   AddDetail( ({ "stellen", "vorschein" }),
     "An manchen Stellen der Tueren wurde der Kristall, der das Holz "
     "ueberzog abgetragen und das rohe Holz kommt hier zum Vorschein.");
   AddDetail( ({ "kombination" }),
     "Durch die Verzierungen eintsteht eine wunderschoene Kombination "
     "aus dem rohen Holz und dem Schimmern des Kristalls.");
   AddDetail( ({ "schimmern" }),
     "Der weissliche Kristall schimmert im Licht.");
   AddDetail( ({ "regal" }),
     "Links von Dir, neben dem Fenster haengt ein kleines Regal auf dem "
     "einige Gegenstaende aufgestapelt sind.");
   AddDetail( ({ "gegenstaende" }),
     "Die Gegenstaende gehoeren auch zum Sortiment des Ladens.");
   AddDetail( ({ "abenteuer" }),
     "Du hast bestimmt schon viele Abenteuer geloest. Die Gegenstaende "
     "die es hier zu kaufen gibt werden Dir bestimmt gut dabei behilflich "
     "sein.");
   AddDetail( ({ "decke" }),
     "Die Decke besteht aus Holz. An ihr wurde ein Kerzenhalter befestigt "
     "der dem Laden bei Dunkelheit licht spendet.");
   AddDetail( ({ "kerzenhalter" }),
     "Ein Kerzenhalter befindet sich an der Decke. Er spendet Licht "
     "wenn die Dunkelheit eintritt.");
   AddDetail( "dunkelheit", ([ 0: "Im Moment ist es noch hell.",
   		     "dunkelelf": "Du sehnst Dich nach Dunkelheit!"]));
   AddDetail( ({ "waende" }),
     "Die Waende hier sind aus Holz. An der Westwand "
     "befindet sich ein kleines Fenster, neben dem ein Regal haengt. "
     "An der Nordwand stehen in den Ecken jeweils ein Waffenstaender und "
     "zwei Schraenke und in der Ostwand befindet sich eine Tuer, durch "
     "die Du wieder nach draussen gelangst.");
   AddDetail( ({ "wand" }),
     "Welche Wand meinst Du? Die Westwand, die Nordwand, die Suedwand "
     "oder die Ostwand?");
   AddDetail( ({ "suedwand" }),
     "An der Suedwand befindet sich nichts aufregendes.");
   AddDetail( ({ "nordwand" }),
     "Die Ecken der Nordwand sind interessant.");
   AddDetail( ({ "ostwand" }),
     "In der Ostwand befindet sich eine Tuer, durch die Du wieder nach draussen "
     "gelangst.");
   AddDetail( ({ "tuer", "tuere" }),
     "Eine schlichte Tuere aus Holz befindet sich in der Ostwand.");
   
   AddReadDetail ("tafel",
     "Verfuegbare Befehle:\n"+
     "<zeige>             Gibt eine Uebersicht ueber das Angebot im Laden.\n"+
     "<zeige> rue|ver|waf Uebersicht ueber Ruestungen/Verschiedenes/Waffen\n"
     "<zeige> panzer|helm|umhang|ring|....  \n"
     "<unt> nummer        Gibt eine Beschreibung eines Gegenstands der Liste aus\n"+
     "<kaufe> nummer oder\n"+
     "<kaufe> etwas       Du kaufst einen bestimmten Gegenstand.\n"+
     "<verkaufe> etwas    Du verkaufst einen Gegenstand, den Du bei Dir hast.\n"+
     "<versetze> etwas    Du verkaufst einen Gegenstand, egal wieviel der\n"+
     "                    Haendler dafuer bezahlt.\n"+
     "<schaetz> etwas     Der Haendler sagt Dir, wieviel ihm ein Gegenstand\n"+
     "                    wert waere, wenn Du ihn verkaufen wuerdest.\n");

/*-----------------------GERAEUSCHE-----------------------*/
  
   AddSound(DEFAULT_SOUND,
     "Die Holzplatten knarren leise unter Deinen Bewegungen.");
   AddSound( ({ "knarren", "bewegungen" }),
     "Knnnnnnaaaaaaarrrrrr.");
   
   SetStorageRoom(ROOM("lagerraum"));

/*---------------------CMDS EXITS---------------------*/
   
   AddExit("osten", "./dorf06");
   
   AddCmd( ({ "entferne", "entfern" }), "cmd_happen");

   brett = ([]);
}

reset()
{
  ::reset();
  brett = ([]);
}

int cmd_happen(string str)
{  
   //Man kann hier ein Brett entfernen und wird von einer Ratte
   //attackiert... Fuer Forscher gedacht
   string spieler;
   spieler=getuid(TP);
   notify_fail(BS("Was moechtest Du denn entfernen?"));
   if(!(str == "brett" || str == "holzplatte" || str == "platte" ||
   	str == "lockere platte" || str == "lockere holzplatte"))
   {
     return 0;
   }
   if(!member(brett, spieler))
   {
     brett+=([spieler: 0]);
   }
   if(brett[spieler, 0]>=1)
   {
     write(BS("Du entfernst die lockere Holzplatte und entdeckst darunter "
     	      "ein leeres Loch. Enttaeuscht legst Du die Platte wieder "
     	      "an ihren Platz."));
     return 1;
   }
   else
   {
      brett[spieler, 0]++;
      write(BS("Du entfernst die lockere Holzplatte und legst ein Loch "
               "frei. Ploetzlich springt eine Ratte erbost daraus hervor. "
               "Schnell legst Du die Platte wieder an ihren Platz und "
               "verteidigst Dich gegen die Ratte."));
      tell_room(ENV(TP), TPN+" entfernt eine Platte aus dem Boden und "
      			     "scheucht eine Ratte auf.\n", ({TP}));
      AddItem("/d/ebene/lamuerte/burg/npc/ratte", REFRESH_NONE);
      return 1;
    }
}

  
