inherit "std/room";

#include "../siedlung.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

mapping kobold;

create()
{

::create();

/*-----------------------KURZ UND LANGBESCHREIBUNG-----------------------*/

   SetProp(P_INT_SHORT, "Eingang zum Waldelfendorf");
   SetProp(P_INT_LONG,
     "Du stehst vor einem Wall aus kristallinen Pflanzen "
     "auf einer Strasse die Dich direkt zu einem Dorf zu fuehren scheint. "
     "Die Strasse funkelt und glitzert wegen der Kristallschicht die auf "
     "den Steinplatten liegt im Sonnenlicht und verleiht der Umgebung ein "
     "beinah magisches Aussehen. Rechts und links am Wall befinden sich "
     "zwei hoelzerne Wachtuerme auf denen sich Spaeher und Schuetzen "
     "befinden.");
   
/*-----------------------RAUMEIGENSCHAFTEN-----------------------*/
   
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );
   SetProp(P_INDOORS, 0);
   SetProp(P_LOG_FILE, "/d/kristallwald/kolmey/room.log");

/*-----------------------RAUMDETAILS-----------------------*/

   AddDetail( ({ "wall" }),
     "Ein Wall aus kristallinen Hecken und Straeuchern befindet sich "
     "vor Dir. Der Wall ist so dicht, sodass er ein Durchkommen "
     "unmoeglich macht.");
   AddDetail( ({ "hecken", "straeucher", "pflanzen" }),
     "Kristalline Hecken und Straeucher bilden den undurchdringbaren Wall "
     "der das Dorf zu umgeben scheint. Sie besitzen zahlreiche spitze "
     "Dornen.");
   AddDetail( ({ "durchkommen" }),
     "Ein Durchkommen durch den Wall erscheint Dir unmoeglich, da dieser "
     "ziemlich dicht bewachsen ist. Ausserdem befinden sich auf den "
     "Hecken und Straeuchern spitze Dornen, die Deinen ganzen Koerper "
     "zerschneiden koennten.");
   AddDetail( ({ "dornen" }),
     "Spitze Dornen befinden sich an den Hecken und Straeuchern, die den "
     "Wall bilden. Sie koennten Deinen ganzen Koerper zerschneiden.");
   AddDetail( ({ "koerper" }),
     "Noch ist Dein Koerper nicht zerschnitten. Am besten Du probierst "
     "erst gar nicht aus wie viel er aushaelt.");
   AddDetail( ({ "dorf" }),
     "Hier scheint der Eingang eines Dorfes zu sein.");
   AddDetail( ({ "eingang" }),
     "Der Eingang zum Dorf befindet sich hier.");
   AddDetail( ({ "strasse" }),
     "Eine, mit Steinplatten ausgelegte, Strasse fuehrt Dich an den "
     "Wachtuermen und dem Wall vorbei in Richtung Dorf.");
   AddDetail( ({ "richtung" }),
     "Das Dorf kannst Du im Suedosten betreten.");
   AddDetail( ({ "steinplatten" }),
     "Mit Steinplatten wurde die Strasse bepflastert. Sie funkeln und "
     "glitzern wegen der duennen Kristallschicht im Sonnenlicht in "
     "zahlreichen Farben.");
   AddDetail( ({ "funkeln", "glitzern" }),
     "Alles hier funkelt und glitzert wegen der duennen Kristallschicht "
     "im Sonnenlicht.");
   AddDetail( ({ "kristallschicht" }),
     "Eine duenne, weissliche Kristallschicht befindet sich auf den "
     "Steinplatten, auf dem Holz und den Pflanzen.");
   AddDetail( ({ "farben" }),
     "Alles hier funkelt und glitzert in den Farben des Regenbogens.");
   AddDetail( ({ "regenbogen" }),
     "Tatsaechlich, es sieht so aus, als ob sich am Boden durch das "
     "Sonnenlicht und der Kristallschicht ein kleiner Regenbogen gebildet "
     "hat. Wo mag bloss das Ende sein?");
   AddDetail( ({ "ende" }),
     "Du beginnst das Ende des Regenbogens zu suchen, doch erfolglos, "
     "stattdessen findest Du nur einen kleinen kristallinen Grasbueschel "
     "neben der Strasse.");
   AddDetail( ({ "grasbueschel" }),
     "Ein kleiner Grasbueschel befindet sich neben der Strasse. "
     "Sieht so aus, als waere etwas darin verborgen. Vielleicht "
     "kannst Du ihn ja durchsuchen.");
   AddDetail( ({ "umgebung" }),
     "Die Umgebung hier traegt durch das Glitzern und Funkeln ein "
     "fast magisches Aussehen.");
   AddDetail( ({ "aussehen" }),
     "Das Funkeln und Glitzern verleiht der Umgebung ein magisches "
     "Aussehen.");
   AddDetail( ({ "wachtuerme" }),
     "Jeweils ein Wachturm aus Holz befindet sich direkt an den Seiten "
     "des Walls.");
   AddDetail( ({ "holz" }),
     "Es scheint sich um Holz aus dem Wald zu handeln, da es ebenfalls "
     "mit einer duennen Kristallschicht ueberzogen ist.");
   AddDetail( ({ "wald" }),
     "Der Kristallwald befindet sich hier.");
   AddDetail( ({ "kristallwald" }),
     "Der Kristallwald befindet sich hier. Dort ist einiges mit einer "
     "duennen Kristallschicht ueberzogen.");
   AddDetail( ({ "wachturm" }),
     "Jeweils ein Wachturm befindet sich an den Seiten des Walls. "
     "Auf ihnen befindet sich jeweils ein Spaeher und ein Schuetze. Am "
     "Wachturm wurde eine kleine Leiter befestigt. Vielleicht "
     "koenntest Du versuchen auf den Wachturm zu klettern?");
   AddDetail( ({ "leiter" }),
     "An jedem Wachturm wurde eine kleine Leiter befestigt. An ihr "
     "koennen die Spaeher nach oben bzw. nach unten klettern. Vielleicht "
     "kannst Du das ja auch?");
   AddDetail( ({ "schuetzen", "schuetze" }),
     "Jeweils ein Schuetze befindet sich auf den Wachtuermen. "
     "Sie treffen bestimmt mit ihren Pfeilen auch das noch so kleinste "
     "Ziel.");
   AddDetail( ({ "ziel" }),
     "Die Schuetzen auf den Tuermen treffen bestimmt alles in ihrer "
     "Reichweite.");
   AddDetail( ({ "reichweite" }),
     "Jeder Bogen hat eine gewisse Reichweite.");
   AddDetail( ({ "spaeher" }),
     "Jeweils ein Spaeher befindet sich auf den Wachtuermen. "
     "Sie haben die Aufgabe das Dorf vor drohender Gefahr zu warnen.");
   AddDetail( ({ "aufgabe" }),
     "Die Aufgabe eines Spaehers besteht darin, ausschau zu halten "
     "und bei Gefahr Alarm zu schlagen.");
   AddDetail( ({ "alarm" }),
     "Wie die Spaeher das machen kannst Du von hier unten nicht erkennen.");
   AddDetail( ({ "gefahr" }),
     "Auch die friedlichen Waldelfen haben Feinde, wie zum Beispiel die "
     "Dunkelelfen oder die Zwerge. Auch Trollangriffe sind nicht "
     "auszuschliessen.");
   AddDetail( ({ "waldelfen" }),
     "Die Waldelfen leben hier in diesem Dorf.");
   AddDetail( ({ "feinde" }),
     "Die Urspruenglichen Feinde der Elfen sind mehr oder weniger die "
     "Zwerge. Aber auch die Dunkelelfen sind bei Elfen nicht gerne "
     "gesehen und sollten sich lieber aus dem Dorf fernhalten. "
     "Weiters kommt es auch ab und zu zu Trollangriffen.");
   AddDetail( ({ "zwerge" }),
     "Warum genau Zwerge Feinde der Elfen sind, solltest Du mal "
     "Aerendil fragen.");
   AddDetail( ({ "aerendil" }),
     "Aerendil ist der Bibliothekar in Elessar.");
   AddDetail( ({ "bibliothekar" }),
     "Das ist Aerendil. Er lebt in Elessar.");
   AddDetail( ({ "elessar", "elfenstadt" }),
     "Elessar ist die Elfenstadt und liegt suedlich des Sees von "
     "Rhondonit.");
   AddDetail( ({ "see", "rhondonit" }),
     "Der See von Rhondonit liegt suedlich des Kristallwalds.");
   AddDetail( "dunkelelfen", ([ 0: "Dunkelelfen moegen keine Elfen und "
   				   "umgekehrt ist es genauso.",
   		      "dunkelelf": "Auch Du hasst die Elfen! Da hier "
   		      		   "die Waldelfen leben, solltest Du lieber "
   		      		   "vorsichtig sein."]));
   AddDetail( ({ "trollangriffe" }),
     "Auch einige verruchte Trolle suchen von Zeit zu Zeit das Dorf "
     "hier heim und ueberfallen es.");
   AddDetail( "trolle", ([ 0: "Zum Glueck ist im Moment kein Troll da!",
   		     "troll": "Du bist zwar ein Troll, gehoerst ja aber "
   		     	      "nicht zu der Bande."]));
   AddDetail( ({ "glueck" }),
     "Glueck hat man oder nicht!");
   AddDetail( "bande", ([ 0: "Sowas siehst Du da nicht!",
     		    "troll": "Oder vielleicht gehoerst Du ja doch dazu?"]));
   AddDetail( ({ "beispiel" }),
     "Du wirst doch wohl wissen, was ein Beispiel ist?");
   AddDetail( ({ "boden" }),
     "Der Boden wird hier von der Strasse gebildet.");
   AddDetail( ({ "himmel" }),
     "Ober Dir lacht ein strahlendblauer, wolkenloser Himmel. "
     "Keine einzige Wolke ist hier zu sehen und die Sonne scheint Dir "
     "in hoechster Pracht entgegen.");
   AddDetail( ({ "wolke" }),
     "Du suchst den ganzen Himmel ab, findest aber doch keine Wolke.");
   AddDetail( ({ "sonne" }),
     "Die Sonne scheint Dir vom wolkenlosen Himmel entgegen und waermt "
     "und erhellt die Umgebung.");
   AddDetail( ({ "sonnenlicht" }),
     "Die Sonne sendet von hoch oben ihre Strahlen und laesst die "
     "Umgebung funkeln und glitzern.");
   AddDetail( ({ "strahlen" }),
     "Du kannst die waermenden Strahlen auf Deiner Haut spueren.");
   AddDetail( "haut", ([ 0: "Noch ist Deine Haut weiss.",
   	       "dunkelelf": "An Deiner Haut hat sich noch nicht viel "
   	       		    "veraendert!"]));
   AddDetail( ({ "seiten" }),
     "Rechts und links am Wall befindet sich jeweils ein Wachturm.");
   AddDetail( ({ "zeit" }),
     "Du kannst von Glueck reden dass es im Moment friedlich ist.");
   AddDetail( ({ "pracht" }),
     "Die Sonne scheint Dir von wolkenlosem Himmel entgegen. Welch eine "
     "Pracht!");

/*-----------------------GERAEUSCHE UND GERUECHE-----------------------*/

   AddSound(DEFAULT_SOUND,
     "Einige Geraeusche dringen aus dem Dorf.");
   AddSound( ({ "geraeusche" }),
     "Einige Dorfbewohner scheinen ihren Geschaeften nachzugehen.");
   AddSound( ({ "dorfbewohner", "geschaefte" }),
     "Geh doch mal ins Dorf, da erkennst Du bestimmt mehr...");

/*---------------------ITEMS CMDS EXITS UND MAPPINGS---------------------*/

   AddItem(NPC("waechter"), REFRESH_DESTRUCT);
   AddItem(NPC("waechterin"), REFRESH_DESTRUCT);
   
   AddCmd( ({ "kletter", "klettere" }), "cmd_go");
   AddCmd( ({ "durchsuche", "durchsuch" }), "cmd_get");
   
   AddExit( "suedosten", "./dorf06");
   AddExit( "westen", WALD("wald_06"));
   
   kobold = ([]);
   
}
reset()

{

  ::reset();
  kobold=([]);
}

int cmd_go(string str)
{
   //Man kann von hier aus auf die beiden Wachtuerme klettern	
   notify_fail(BS("Wo, auf welchen Wachturm moechtest Du hinaufklettern?"));
   if(str == "auf linken wachturm" || str == "auf linken wachturm hinauf")
   {
      write(BS("Du kletterst auf den linken Wachturm hinauf."));
      tell_room(ENV(TP), TPN+" klettert auf den linken Wachturm hinauf.\n", 
      ({TP}));
   TP->move(ROOM("lturm"), M_GO | M_SILENT);
   return 1;
}

   if(str == "auf rechten wachturm" || str == "auf rechten wachturm hinauf")
   {
   
      write(BS("Du kletterst auf den rechten Wachturm hinauf."));
      tell_room(ENV(TP), TPN+" klettert auf den rechten Wachturm hinauf.\n", 
      ({TP}));
   TP->move(ROOM("rturm"), M_GO | M_SILENT);
   return 1;
   }
  return 0;
}

int cmd_get(string str)
{  
   
   //Hier habe ich ein kleines Feature eingebaut...
   //Der Spieler kann hier einen Grasbueschel durchsuchen und findet 
   //dann einen kleinen Kobold, von dem er Geld bekommt
   //Geld wird per random einzigartig verwendet
   //Der Spieler kann das nur einmal pro Reset machen -> mapping
   int geld;
   string spieler;
   geld=500+random(3000);
   spieler=getuid(TP);

   notify_fail(BS("Was moechtest Du denn durchsuchen?"));
   if(!(str == "grasbueschel" || str == "bueschel"))
   {
      return 0;
   }
   if(!member(kobold, spieler))
   {
      kobold+=([spieler: 0]);
   }
   if(kobold[spieler, 0]>=1)
   {
      write(BS("Du durchsuchst den Grasbueschel neben der Strasse. Doch "
               "leider da nichts drinnen verborgen zu sein. Enttaeuscht "
               "wendest Du Dich ab."));
      return 1;
   }
   else
   {  
      kobold[spieler, 0]++;
      write(BS("Du durchsuchst den Grasbueschel neben der Strasse und "
      	       "findest dort einen winzig kleinen Kobold. Schnell packst "
      	       "Du ihn am Kragen und schuettelst ihn kraeftig durch. "
      	       "Ploetzlich fallen einige Muenzen aus der Tasche des "
      	       "Kobolds in Deine Tasche. Du laesst den Kobold wieder los "
      	       "und dieser laeuft erbost davon. "
      	       "Ha! Da hattest Du wohl ziemliches Glueck!"));
      TP->AddMoney(geld);
      return 1;
   }
}   

