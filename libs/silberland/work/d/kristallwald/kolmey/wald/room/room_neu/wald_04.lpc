inherit "std/room";

#include "../../kwald.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

#define LOCH(wer) (member(loch, capitalize(getuid(wer)))!=-1)
#define MyCountUp(arg) (sizeof(arg) > 1 ? \
        implode(arg[0..<2], ", ") + " und " + arg[<1] : \
        (sizeof(arg) == 0 ? "niemand" : arg[0]) )

string *loch=({});

void grundzustand();
int muenzen_da;
int kaetzchen_da;
int wind_da;

create()
{
	
::create();
   
   SetProp(P_INT_SHORT, "Im Kristallwald");
   SetProp(P_INT_LONG,
     "Du befindest Dich im Kristallwald und stehst mitten auf einer "
     "Kreuzung die rund um einen kleinen Baum verlaeuft. Der Weg teilt "
     "sich und fuehrt Dich nach Norden, Westen, Suedwesten und Suedosten "
     "durch den Wald und wird am Rand von zahlreichen Baeumen und "
     "Gewaechsen abgegrenzt. Auf oestlicher Seite scheinen die Gewaechse "
     "einen regelrechten Wall zu bilden. Die Sonne schickt zahlreiche "
     "Sonnenstrahlen vom strahlend blauen Himmel und verzaubert die "
     "Umgebung damit. Westlich neben dem Weg steht ein Schild.");

//-------------------RAUMEIGENSCHAFTEN---------------------------------------
   
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_FOREST]) );
   SetProp(P_INDOORS, 0);
   SetProp(NO_TPORT_OUT);
   SetProp(P_LOG_FILE, "/d/kristallwald/kolmey/wroom.log");
   
//-------------------RAUMDETAILS---------------------------------------------

   AddDetail( ({ "umgebung" }), TO->QueryProp(P_INT_LONG));
   
   AddDetail( ({ "kreuzung" }),
     "Du befindest auf einer Kreuzung die mitten um einen kleinen Baum "
     "verlaeuft und Dich nach Norden, Westen, Suedwesten und Suedosten "
     "weiter durch den Wald fuehrt.");
   AddDetail( ({ "norden" }),
     "Nach Norden gelangst Du in weitere Teile des Waldes.");
   AddDetail( ({ "westen" }),
     "Nach Westen gelangst Du in weitere Teile des Waldes.");
   AddDetail( ({ "suedwesten" }),
     "Nach Suedwesten gelangst Du in weitere Teile des Waldes.");
   AddDetail( ({ "suedosten" }),
     "Nach Suedosten gelangst Du in weitere Teile des Waldes.");
   AddDetail( ({ "kristallwald", "wald" }),
     "Du befindest Dich auf einer Kreuzung im legendaeren Kristallwald. "
     "Hier wurde alles vom Kristall ueberzogen und traegt nun eine "
     "duenne Kristallschicht.");
   AddDetail( ({ "kreuzung", "wegkreuzung" }),
     "Eine Wegkreuzung fuehrt Dich hier, rund um einen kleinen Baum, nach "
     "Norden, Westen, Suedwesten und Suedosten.");
   AddDetail( ({ "kristall" }),
     "Hier im Kristallwald wurde alles von einer duennen Kristallschicht "
     "ueberzogen. Hm, merkwuerdig! Der Baum, um den die Kreuzung verlaeuft, "
     "scheint nur am unteren Stamm kristallin zu sein.");
   AddDetail( ({ "kristallschicht", "schicht" }),
     "Beinahe alles hier traegt diese duenne Kristallschicht, welche die "
     "Umgebung aufgrund der reflektierenden Sonnenstrahlen in zartem Weiss "
     "bis Rosa erstrahlen laesst.");
   AddDetail( ({ "sonnenstrahlen", "strahlen" }),
     "Zahlreiche Sonnenstrahlen fallen vom blauen Himmel in die Umgebung "
     "ein und lassen diese funkeln und glitzern.");
   AddDetail( ({ "weiss" }),
     "Das Weiss erinnert Dich irgendwie an Wolken.");
   AddDetail( ({ "rosa" }),
     "Das zarte Rosa erinnert Dich an die Schweine am Bauernhof.");
   AddDetail( ({ "schweine" }),
     "Schweine grunzen und machen Mist.");
   AddDetail( ({ "mist" }),
     "Mist findest Du hier keinen, da solltest Du wohl besser auf dem "
     "Bauernhof nachsehen.");
   AddDetail( ({ "bauernhof" }),
     "Es befindet sich ein Bauernhof suedwestlich von Midas.");
   AddDetail( ({ "midas", "hauptstadt" }),
     "Midas ist die Hauptstadt vom Silberland.");
   AddDetail( ({ "silberland" }),
     "Schau Dich um! Das alles gehoert zum Silberland.");
   AddDetail( ({ "weg", "boden" }),
     "Der Weg besteht aus festgetrampelter, kristalliner Erde und ist "
     "von zahlreichen Kieselsteinen und kristallinen Blaettern uebersaeht.");
   AddDetail( ({ "erde" }),
     "Es handelt sich um gewoehnliche Erde die auch vom Kristall ueberzogen "
     "wurde.");
   AddDetail( ({ "kieselsteine" }),
     "Zahlreiche kristalline Kieselsteine liegen auf dem Weg verstreut.");
   AddDetail( ({ "rand", "wegrand" }),
     "Einige kristalline Baeume und Gewaechse begleiten den Weg am Rand und "
     "verhindern so dass Du diesen verlaesst.");
   AddDetail( ({ "seite" }),
     "Welche Seite meinst Du denn? Die westliche oder die oestliche?");
   AddDetail( ({ "westliche seite" }),
     "Auf der westlichen Seite, neben dem Weg, wurde ein Schild "
     "aufgestellt.");
   AddDetail( ({ "schild" }),
     "Du koenntest es lesen!");
   AddDetail( ({ "oestliche seite" }),
     "Auf der oestlichen Seite, neben dem Weg, scheint es Dir als wuerden "
     "die Gewaechse eine regelrechten kristallinen Wall bilden von dem "
     "eine starke magische Aura auszugehen scheint.");
   AddDetail( ({ "aura" }),
     "Eine starke magische Aura, die Du foermlich spueren kannst, scheint "
     "von dem Wall aus Pflanzen auszugehen. Sein Ursprung ist bestimmt "
     "nicht natuerlich.");
   AddDetail( ({ "ursprung", "weile" }),
     "Du gruebelst eine Weile ueber den Ursprung des Walls und kommst zu "
     "dem Schluss das dieser wohl nicht natuerlich entstanden sein kann.");
   AddDetail( ({ "schluss" }),
     "Nein! Der Wall hat keinen natuerlichen Ursprung.");
   AddDetail( ({ "wall" }),
     "Der Wall besteht aus einer vielzahl von Pflanzen und befindet sich "
     "auf der oestlichen Seite. Eine starke magische Aura scheint von ihm "
     "auszugehen.");
   AddDetail( ({ "baum" }),
     "Es handelt sich um eine Silberweide um die die Kreuzung verlaeuft. "
     "Eigenartigerweise ist diese nur am unteren Stamm kristallin, der Rest "
     "scheint vom Kristall verschont worden zu sein, doch die Frage ist "
     "warum?");
   AddDetail( ({ "silberweide", "weide" }),
     "Die Silberweide ist noch nicht allzu gross, es scheint ein junger "
     "Baum zu sein. Komischerweise wurde die Weide bis auf den unteren "
     "Stamm vom Kristall verschont.");
   AddDetail( ({ "rest" }),
     "Der obere Stamm mit der Rinde, die Aeste, die Blaetter und die "
     "kleinen unscheinbaren Weidenkaetzchen blieben vom Kristall "
     "verschont.");
   AddDetail( ({ "stamm" }),
     "Der untere Stamm und die Wurzeln der Weide sind vom Kristall "
     "ueberzogen, der Rest blieb verschont. Du wunderst Dich warum.");
   AddDetail( ({ "wurzeln" }),
     "Eigentlich ist es eher der Wurzelansatz den Du sehen kannst. Die "
     "eigentlichen Wurzeln sind tief in der Erde verankert.");
   AddDetail( ({ "wurzelansatz", "ansatz" }),
     "Du suchst den Wurzelansatz ab, findest jedoch nichts aufregendes.");
   AddDetail( ({ "rinde" }),
     "Die dunkelgrüne Rinde der Silberweide ist mit tiefen Rillen "
     "versehen.");
   AddDetail( ({ "rillen" }),
     "Zahlreiche tiefe Rillen verlaufen in der Rinde. Eine etwas tiefere "
     "und breitere Rille faellt Dir auf.");
   AddDetail( ({ "rille", "betrachtung" }),
     "Bei naeherer Betrachtung bemerkst Du, dass sich ein nicht "
     "allzugrosses Loch in der Rille befindet.");
   AddDetail( ({ "loch" }),
     "Was da wohl versteckt sein mag?");
   AddDetail( ({ "aeste" }),
     "Die Aeste der Silberweide tragen zahlreiche dunkelgruene "
     "Silberweidenblaetter.");
   AddDetail( ({ "blaetter" }),
     "Einige kristalline Blaetter liegen am Boden verstreut umher und "
     "mischen sich mit den laenglichen dunkelgruenen Blaettern der "
     "Silberweide.");
   AddDetail( ({ "seiten" }),
     "Alles hat mindestens zwei Seiten.");
   AddDetail( ({ "silberweidenblaetter" }),
     "Die Silberweide hat lange, schmale Blaetter, die am Rand scharf "
     "gesaegt sind. Die dunkelgruenen Blaetter sind auf beiden Seiten mit "
     "duennen, silbrigen Haerchen bewachsen. Auf der Unterseite fallen "
     "diese Haerchen besonders auf. Wenn der Wind die Blaetter nur ein "
     "bisschen bewegt, kann man den Baum an seinem Silberglanz schon von "
     "weitem erkennen. Zwischen den Blaettern fallen Dir kleine "
     "Weidenkaetzchen auf.");
   AddDetail( ({ "unterseite" }),
     "Auf der Unterseite der Silberweidenblaetter wachsen besonders viele "
     "Haerchen, deshab fallen diese dort auch mehr auf.");
   AddDetail( ({ "haerchen" }),
     "Zahlreiche silberne Haerchen wachsen auf den Blaettern der "
     "Silberweide, daher wohl auch ihr Name.");
   AddDetail( ({ "name" }),
     "Die Silberweide wurde hier gemeint.");
   AddDetail( ({ "silberglanz", "glanz", "geltung" }),
     "Momentan ist es windstill daher kommt der Glanz wohl nicht so richtig "
     "zur Geltung.");
   AddDetail( ({ "weidenkaetzchen", "kaetzchen" }),
     "Gruene, recht unscheinbare Weidenkaetzchen wachsen zwischen den "
     "Blaettern auf den Aesten der Silberweide. Es duerfte sich wohl um "
     "ein weibliches Exemplar handeln.");
   AddDetail( ({ "exemplar" }),
     "Weibliche Silberweiden tragen gruene unscheinbare Kaetzchen.");
   AddDetail( ({ "frage", "raetsel", "loesung" }),
     "Ein Raetsel dessen Loesung Du gerne kennen wuerdest.");
   AddDetail( ({ "baeume" }),
     "Zahlreiche kristalline Laubbaeume wachsen am Rand des Weges. "
     "Zwischen und hinter diesen wachsen einige Pflanzen.");
   AddDetail( ({ "laubbaeume" }),
     "Zahlreiche kristalline Laubbaeume wachsen am Rand des Weges. "
     "Ihre riesigen Staemme ragen in die Hoehe und bilden mit den "
     "Aesten und Blaettern ein dichtes Blaetterdach. Aufgrund "
     "des Kristalls kannst Du nicht festellen um welche genaue Art von "
     "Laubbaeumen es sich hierbei handelt.");
   AddDetail( ({ "staemme" }),
     "Dicke Staemme der Baeume ragen neben Dir in die Hoehe.");
   AddDetail( ({ "blaetterdach" }),
     "Die Baeume bilden weit oben mit den Aesten und Blaettern "
     "ein dichtes Blaetterdach. Durch den breiten Weg und die noch "
     "junge Silberweide bleibt dennoch ein Streifen frei durch den "
     "du den Himmel sehen kannst.");
   AddDetail( ({ "streifen" }),
     "Zwischen der Silberweide und den Baeumen die am Wegrand wachsen "
     "hast Du mehr oder weniger freien Blick auf den Himmel.");
   AddDetail( ({ "art" }),
     "Du kannst aufgrund des Kristalls nicht festellen welche Laubbaeume "
     "den Weg begleiten.");
   AddDetail( ({ "gewaechse", "pflanzen" }),
     "Zwischen und hinter den Baeumen befinden sich zahlreiche Straeucher, "
     "Buesche und kristalliner Efeu.");
   AddDetail( ({ "straeucher" }), 
     "Zahlreiche kristalline Straeucher wachsen zwischen und hinter den "
     "Baeumen und bilden das dichte Unterholz.");
   AddDetail( ({ "buesche" }),
     "Zahlreiche kristalline Buesche wachsen zwischen und hinter den "
     "Baeumen und bilden das dichte Unterholz.");
   AddDetail( ({ "efeu" }),
     "Zwischen und hinter den Baeumen wuchert kristallines Efeu.");
   AddDetail( ({ "unterholz" }),
     "Das Unterholz hinter den Baeumen ist so dicht das es Dir unmoeglich "
     "scheint den Weg zu verlassen.");
   AddDetail( ({ "himmel" }),
     "Die Sonne sendet zahlreiche Sonnenstrahlen vom wolkenlos blauen "
     "Himmel und laesst die Umgebung funkeln.");
   AddDetail( ({ "sonne" }),
     "Hoch erhoben sendet sie Dir ihre Waerme.");
   AddDetail( ({ "waerme" }),
     "Die kannst Du richtig auf Deiner Haut spueren.");
   AddDetail( ({ "haut" }),
     "Deine Haut ist schon ganz braun von der vielen Sonne hier.");
   AddDetail( ({ "wolken", "wolke" }),
     "Keine Wolke ist am Himmel zu sehen.");
   AddDetail( ({ "teil", "teile" }),
     "Du befindest Dich in einem Teil des Kristallwalds.");
   AddReadDetail( ({ "schild" }),
     "=====================\n"
     "|  ^                |\n"
     "|  | Waldelfendorf  |\n"
     "|  |                |\n"
     "=====================\n"
     "         ||	   \n");
   
//-------------------GERAUESCHE-GERUECHE-------------------------------------

   AddSound(DEFAULT_SOUND,
     "Momentan ist es absolut still hier.");
   
   AddSmell(DEFAULT_SMELL,
     "Du atmest die frische Waldluft ein.");
   AddSmell( ({ "waldluft" }),
     "Ah, tut das gut!");

//-------------------EXITS---------------------------------------------------

   AddExit( "norden", "./wald_23");
   AddExit( "westen", "./wald_03");
   AddExit( "suedosten", "./wald_08");
   AddExit( "suedwesten", "./wald_05");

//-------------------SPECIAL_DETAILS-----------------------------------------
   
   AddSpecialDetail( ({ "wuermchen" }), "wuermchen");
   AddSpecialDetail( ({ "wind" }), "wind");
   
//-------------------KOMMANDOS-----------------------------------------------
  
   AddCmd( ({ "spuere", "spuer" }), "c_spueren");
   AddCmd( ({ "greife", "greif" }), "c_greifen");
   AddCmd( ({ "steige", "steig" }), "c_klettern");
   AddCmd( ({ "norden", "n", "westen", "w", "suedosten", "so", "suedwesten", 
   	      "sw", "goto", "home" }), "c_fussraus");
   AddCmd( ({ "huepfe", "huepf" }), "c_huepfen");
   AddCmd( ({ "pfluecke", "pflueck" }), "c_pfluecken");
   AddCmd( ({ "loese", "loes" }), "c_raetsel");
   
   
   grundzustand();
}

void reset()
{
   ::reset();
   grundzustand();
   call_out("windgeschehen", 0);
}

void grundzustand()
{
   muenzen_da = 1;
   kaetzchen_da = 1;
   wind_da = 0;
}

int c_greifen(string str)
{  
   notify_fail(BS("Wo moechtest Du denn reingreifen?"));
   if(!(str == "in loch" || str == "in loch hinein"))
   {
     return 0;
   }
   if(!muenzen_da)
   {
     write(BS("Du greifst in das Loch hinein doch es ist leider leer."));
     return 1;
   }
   if(sizeof(loch)>=1)
   {
     write(BS("Du kannst nicht in das Loch greifen solang " + loch[0] + ""
              "noch mit dem Fuss im Loch steckt."));
     return 1;
   }
   if(LOCH(TP))
   {
     write(BS("Aber Dein Fuss steckt doch noch in dem Loch!"));
     return 1;
   }
   else
   {
     write(BS("Du greifst in das Loch hinein und findest einen Haufen "
       	      "Muenzen die Du auch gleich voller Freude einsteckst."));
     tell_room(ENV(TP), TPN+" greift in ein Loch und sieht reicher "
     			    "aus.\n", ({TP}));
     muenzen_da = 0;
     TP->AddMoney(2000+random(3000));
     return 1;
  }
}

int c_klettern(string str)
{
   notify_fail(BS("Womit moechtest Du denn wohin steigen?"));
   if(!(str == "mit fuss in loch" || str == "mit fuss in loch hinein"
     || str == "mit rechtem fuss in loch" 
     || str == "mit rechtem fuss in loch hinein"))
   {
     return 0;
   }
   if(LOCH(TP))
   {
     write(BS("Dein rechter Fuss steckt doch schon in dem Loch!"));
     return 1;
   }
   if(sizeof(loch)>=1)
   {
     write(BS("" + loch[0] + " steckt mit seinem rechten Fuss noch in dem "
     	      "Loch!"));
     return 1;
   }
   if(muenzen_da)
   {
     write(BS("Das Loch scheint nicht leer zu sein, da hat Dein Fuss doch "
              "niemals Platz!"));
     return 1;
   }
   else
   {
   write(BS("Du steigst mit Deinem rechten Fuss in das Loch und kletterst "
   	    "etwas hoeher."));
   tell_room(ENV(TP), TPN+" steigt mit dem rechten Fuss in ein Loch und "
   			  "klettert etwas hoeher.\n", ({TP}));
   loch += ({ capitalize(getuid(TP)) });
   return 1;
   }
}

int c_fussraus(string str)
{
  if(LOCH(TP))
  {
     write(BS("Du solltest vorher besser auf den Boden zurueckhuepfen!"));
     return 1;
  }
}

int c_huepfen(string str)
{
   notify_fail(BS("Wohin moechtest Du denn huepfen?"));
   if(str == "auf boden" || str == "auf boden zurueck")
   {
   if(LOCH(TP))
   {
     write(BS("Du huepfst auf sicheren Boden zurueck."));
     tell_room(ENV(TP), TPN+" huepft vom Baum runter auf den sicheren "
     		            "Boden.\n", ({TP}));	 
     loch -= ({ capitalize(getuid(TP)) });
     return 1;
     }
  }      
  else 0;
}

void BecomesNetDead(object spieler)
{
  if(LOCH(spieler))
  loch -= ({ capitalize(getuid(spieler)) });
}

int c_pfluecken(string str)
{
   notify_fail(BS("Was moechtest Du denn pfluecken?"));
   if(!(str == "weidenkaetzchen" || str == "kaetzchen"
     || str == "silberweidenkaetzchen"))
   {
     return 0;
   }
   if(!LOCH(TP))
   {
     write(BS("Die Weidenkaetzchen sind leider zu weit oben. Du kommst von "
     	      "hier nicht an sie heran."));
     return 1;
   }
   if(!wind_da)
   {
     write(BS("Neugierig versuchst Du ein paar Weidenkaetzchen zu "
     	      "pfluecken. Leider sind die Weidenkaetzchen zu unscheinbar, "
     	      "als das Du diese aus der Naehe sehen koenntest."));
     return 1;
   }
   if(!kaetzchen_da)
   {
     write(BS("Leider sind momentan alle Kaetzchen ausserhalb Deiner "
     	      "Reichweite. Komm doch spaeter wieder!"));
     return 1;
   }
   else
   {
   write(BS("Du pflueckst Dir ein Weidenkaetzchen und steckst es voller "
   	    "Freude ein."));
   kaetzchen_da = 0;
   return 1;
   }
}

int c_spueren(string str)
{  
   notify_fail(BS("Was moechtest Du denn spueren?"));
   if(!(str == "aura" || str == "magie"))
   {
     return 0;
   }
    write(BS("Du laesst die magische Aura auf Dich einwirken.\n"
    	  "Du erzitterst erfuehrchtig und fuehlst einen angenehmen Schauer "
    	  "durch Deinen Koerper ziehen."));
    return 1;
}

int c_raetsel(string str)
{  
   notify_fail(BS("Was moechtest Du denn loesen?"));
   if(!(str == "raetsel"))
   {
     return 0;
   }
    write(BS("Du gruebelst und ueberlegst. Dein Kopf beginnt zu rauchen und "
    	     "genau in dem Moment trifft es Dich wie ein Blitz. Die Ursache "
    	     "warum die Silberweide nur am unteren Stamm kristallin ist "
    	     "liegt bestimmt an den Weidenkaetzchen. Diese scheinen die "
    	     "Kristallisierung zu neutralisieren."));
    return 1;
}


string wuermchen()
{
  string wuermchen;
  if(!wind_da)
  {
     wuermchen =
     "Sowas siehst Du da nicht!";
  }
  else
  {
     wuermchen =
     "Durch das Funkeln des Kristalls und dem Glanz der Silberweide sieht "
     "es so aus als wuerden kleine silbrige Wuermchen durch die Luft "
     "fliegen. ";
  }
  return break_string(wuermchen, 78);
}

string wind()
{
  string wind;
  if(!wind_da)
  {
     wind =
     "Momentan ist es windstill.";
  }
  else
  {
     wind =
     "Eine leichte Brise ist zu spueren. ";
  }
  return break_string(wind, 78);
}

void windgeschehen()
{
   object raum1;
   object raum2;
   object raum3;
   call_other("/d/kristallwald/kolmey/wald/room/room_neu/wald_03", "???", 0);
   call_other("/d/kristallwald/kolmey/wald/room/room_neu/wald_05", "???", 0);
   call_other("/d/kristallwald/kolmey/wald/room/room_neu/wald_08", "???", 0);
   raum1 = find_object("/d/kristallwald/kolmey/wald/room/room_neu/wald_03.lpc");
   raum2 = find_object("/d/kristallwald/kolmey/wald/room/room_neu/wald_05.lpc");
   raum3 = find_object("/d/kristallwald/kolmey/wald/room/room_neu/wald_08.lpc");
   raum1->SetWind_an();
   raum2->SetWind_an();
   raum3->SetWind_an();
   tell_room(raum1, "Ein zauberhafter silbriger Glanz erstrahlt "
   		    "ploetzlich von Osten her.\n");
   tell_room(raum2, "Ein zauberhafter silbriger Glanz erstrahlt "
   		    "ploetzlich von Nordosten her.\n");
   tell_room(raum3, "Ein zauberhafter silbriger Glanz erstrahlt "
   		    "ploetzlich von Nordwesten her.\n");
   tell_room((TO), BS("Leichter Wind erfuellt den Raum und zerzaust Dein "
   		      "Haar."));
   wind_da = 1;
   call_out("wind_01", 4);
}

void windgeschehen_1()
{
   object raum1;
   object raum2;
   object raum3;
   call_other("/d/kristallwald/kolmey/wald/room/room_neu/wald_03", "???", 0);
   call_other("/d/kristallwald/kolmey/wald/room/room_neu/wald_05", "???", 0);
   call_other("/d/kristallwald/kolmey/wald/room/room_neu/wald_08", "???", 0);
   raum1 = find_object("/d/kristallwald/kolmey/wald/room/room_neu/wald_03.lpc");
   raum2 = find_object("/d/kristallwald/kolmey/wald/room/room_neu/wald_05.lpc");
   raum3 = find_object("/d/kristallwald/kolmey/wald/room/room_neu/wald_08.lpc");
   raum1->SetWind_aus();
   raum2->SetWind_aus();
   raum3->SetWind_aus();
   tell_room(raum1, "Der silbrige Glanz aus dem Osten erlischt.\n");
   tell_room(raum2, "Der silbrige Glanz aus dem Nordosten erlischt.\n");
   tell_room(raum3, "Der silbrige Glanz aus dem Nordwesten erlischt.\n");
   tell_room((TO), BS("Der Wind laesst wieder nach und der Glanz "
   		      "verblasst."));
   wind_da = 0;
}

void wind_01()
{
   tell_room((TO), BS("Der Wind faehrt durch die Blaetter der Baeume "
    		      "und ein zauberhaftes Gefuehl ueberkommt Dich. Die "
    		      "Weide erstrahlt ploetzlich in silbrigem Glanz, dieser "
    		      "vermischt sich mit dem Funkeln des Kristalls."));
   call_out("wind_02", 6);
}

void wind_02()
{
   tell_room((TO), BS("Dir scheint als wuerdest Du jedes einzelne der "
   		      "vorher so unscheinbaren Weidenkaetzchen auf der "
   		      "Silberweide sehen koennen."));
   call_out("wind_03", 16);
}

void wind_03()
{
   tell_room((TO), BS("Der Glanz der Weide im Wind ist ein "
   		      "unuebertroffener Anblick der Dich entspannt. "
   	              "Du fuehlst Dich besser."));
   call_out("wind_04", 20);
}

void wind_04()
{
   tell_room((TO), BS("Es scheint als wuerden ueberall kleine silbrige "
                      "Wuermchen durch den Raum fliegen."));
   call_out("windgeschehen_1", 10);
}