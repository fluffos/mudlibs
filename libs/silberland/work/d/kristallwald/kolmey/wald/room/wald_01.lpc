inherit "std/room";

#include "../kwald.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

void grundzustand();
int fuchs_da;

create()
{
	
::create();
   
   SetProp(P_INT_SHORT, "Im Kristallwald");
   SetProp(P_INT_LONG,
     "Du befindest Dich im Unterholz des Kristallwalds.\n"
     "Umzingelt von zahlreichen Baeumen und Gewaechsen faellt es Dir "
     "schwer Dich hier zu bewegen. Am von Efeu ueberwucherten Waldboden "
     "liegen einige abgestorbene Aeste kreuz und quer verteilt. Nach "
     "Norden hin lichtet sich das Unterholz jedoch und fuehrt Dich zu einem "
     "erdigen Waldweg hin. Durch das dichte Blaetterdach fallen nur wenige "
     "Sonnenstrahlen ein und verzaubern die Umgebung etwas.");

//-------------------RAUMEIGENSCHAFTEN---------------------------------------
   
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
   SetProp(P_INDOORS, 0);
   SetProp(P_LOG_FILE, "/d/kristallwald/kolmey/wroom.log");

//-------------------RAUMDETAILS---------------------------------------------

   AddDetail( ({ "umgebung" }), TO->QueryProp(P_INT_LONG));
   
   AddDetail( "unterholz",
     "Das dichte Unterholz umgibt Dich hier und laesst Dir keine grosse "
     "Bewegungsfreiheit. Ab und an scheint sich darin etwas zu bewegen.");
   AddDetail( "bewegungsfreiheit",
     "Du kannst Dich hier kaum frei bewegen.");
   AddDetail( ({ "insekten", "tiere" }),
     "Ab und an vernimmst Du leises Rascheln im kristallinen Unterholz und "
     "schliesst daher darauf, dass sich dort Insekten und kleine Tiere "
     "befinden.");
   AddDetail( "rascheln",
     "Lausch ihm!");
   AddDetail( "baeume",
     "Zahlreiche kristalline Laubbaeume befinden sich rings um Dich. "
     "Ihre riesigen Staemme bilden weit oben mit den Aesten und Blaettern "
     "ein dichtes Blaetterdach.");
   AddDetail( "staemme",
     "Riesige Staemme der Laubbaeume ragen rings um Dich in die Hoehe.");
   AddDetail( "hoehe",
     "Boah, das ist schon ziemlich hoch!");
   AddDetail( "laubbaeume",
     "Kristalline Laubbaeume befinden sich rings um Dich. Aufgrund des "
     "Kristalls kannst Du nicht feststellen um welche genaue Art es sich "
     "hierbei handelt.");
   AddDetail( "art",
     "Die genaue Art der Laubbaeume laesst sich aufgrund des Kristalls "
     "nicht feststellen, es ist Dir auch ziemlich egal.");
   AddDetail( "aeste", 
     "Die Aeste der Baeume bilden weit oben mit den Blaettern ein "
     "schuetzendes Blaetterdach. Nur wenige Sonnenstrahlen gelangen "
     "hindurch. Einige abgestorbene Aeste liegen auch noch am Boden "
     "verstreut umher, pass bloss auf dass Du nicht ueber einen von ihnen "
     "stolperst!");
   AddDetail( "blaetter",
     "Kristalline Blaetter wachsen auch den Aesten der Baeume. Diese bilden "
     "ein dichtes Blaetterdach.");
   AddDetail( "blaetterdach",
     "Das dichte Blaetterdach laesst nur wenige Sonnenstrahlen hindurch.");
   AddDetail( ({ "sonnenstrahlen", "strahlen" }),
     "Nur wenige Sonnenstrahlen gelangen durch spaerliche Luecken im "
     "Blaetterdach nach unten durch. Diese wenigen jedoch sorgen fuer das "
     "Licht in der Umgebung und lassen diese funkeln und glitzern.");
   AddDetail( "luecken",
     "Spaerliche Luecken im Blaetterdach sind fuer das Licht in der "
     "Umgebung verantwortlich.");
   AddDetail( "licht",
     "Wenige Sonnenstrahlen erhellen die Umgebung und lassen diese funkeln "
     "und glitzern.");
   AddDetail( ({ "funkeln", "glitzern" }),
     "Die Umgebung hier funkelt und glitzert etwas aufgrund der Reflektion "
     "des Lichts auf dem Kristall.");
   AddDetail( "reflektion",
     "Die Sonnenstrahlen werden vom Kristall reflektiert und lassen die "
     "Umgebung etwas funkeln und glitzern.");
   AddDetail( ({ "boden", "waldboden" }),
     "Der Waldboden ist von kristallinem Efeu ueberwuchert sodass Du nicht "
     "gerade viel erkennen kannst.");
   AddDetail( "efeu",
     "Kristallines Efeu ueberwuchert den Boden.");
   AddDetail( ({ "kristallwald", "wald" }),
     "Du befindest Dich hier im legendaeren Kristallwald. Beihnahe alles "
     "hier traegt diese duenne Kristallschicht.");
   AddDetail( ({ "kristallschicht", "schicht" }),
     "Beinahe alles hier traegt eine duenne, weisslich bis rosarote, "
     "Kristallschicht.");
   AddDetail( "weiss",
     "Zartschimmerndes Weiss, es erinnert Dich irgendwie an Wolken.");
   AddDetail( "wolken",
     "Wolken kannst Du hier keine entdecken. Das Blaetterdach ist zu dicht, "
     "als dass Du den Himmel nach ihnen absuchen koenntest.");
   AddDetail( "himmel",
     "Der Himmel ist durch das dichte Blaetterdach nicht zu entdecken.");
   AddDetail( ({ "rosa", "rosarot" }),
     "Helles, zartschimmerndes Rosa.");
   AddDetail( ({ "gewaechse", "teil" }),
     "Zahlreiche Gewaechse, darunter Straeucher, Buesche, Efeu, Baeume und "
     "Farne, bilden das dichte Unterholz.");
   AddDetail( "straeucher",
     "Das Unterholz wird zum Teil von kristallinen Straeuchern gebildet. "
     "Manche tragen Dornen an ihren Zweigen.");
   AddDetail( "dornen",
     "Manche der kristallinen Straeucher tragen spitze Dornen, die Dich bei "
     "der kleinsten Beruehrung stechen.");
   AddDetail( "beruehrung",
     "Du solltest besser nicht in die Dornen greifen.");
   AddDetail( "zweige",
     "Manche Zweige der kristallinen Straeucher tragen spitze Dornen.");
   AddDetail( "buesche",
     "Das Unterholz wird zum Teil aus kristallinen Bueschen gebildet.");
   AddDetail( "farne",
     "Auch einige kristalline Farne gedeien hier und bilden das dichte "
     "Unterholz. Du kannst vereinzelt kleine und auch grosse Exemplare "
     "entdecken.");
   AddDetail( "exemplare",
     "Bunt gemischt gedeien hier grosse und auch kleine Farnblaetter.");
   AddDetail( ({ "kleine blaetter", "kleine farnblaetter" }),
     "Eins, zwei, drei, ach es sind zuviele kleine Farnblaetter um diese "
     "zu zaehlen.");
   AddDetail( ({ "grosse blaetter", "grosse farnblaetter" }),
     "Ein sehr grosses Farnblatt erregt Deine Aufmerksamkeit. Es scheint "
     "sich unter ihm etwas zu bewegen.");
   AddDetail( ({ "sehr grosses farnblatt", "grosses farnblatt", 
                 "farnblatt" }),
     "Unter einem sehr grossen Farnblatt scheint sich etwas zu bewegen. "
     "Vielleicht koenntest Du einmal darunter schauen?");
   AddDetail( "norden",
     "Im Norden lichtet sich das Unterholz und fuehrt Dich zu einem Waldweg "
     "hin.");
   AddDetail( ({ "weg", "waldweg" }),
     "Im Norden beginnt ein Waldweg.");
   AddDetail( ({ "ohr", "ohren" }), 
     "Mit Deinen Ohren kannst Du lauschen.");
   
//-------------------GERAUESCHE-GERUECHE-------------------------------------
   
   AddSmell(DEFAULT_SMELL,
     "Du riechst die reine Waldluft.");
   AddSmell( "waldluft",
     "Du atmest tief durch.");
   
   AddSound(DEFAULT_SOUND,
     "Leises rascheln dringt aus dem Unterholz an Dein Ohr.");
   AddSound( "unterholz",
     "Im Unterholz raschelt etwas.");
   AddSound( "rascheln",
     "Im Unterholz scheinen sich Insekten und kleine Tiere zu befinden.");
   AddSound( "insekten", "tiere",
     "Insekten und kleine Tiere krabbeln durch das Unterholz. Unter einem "
     "sehr grossen Farnblatt so scheint es Dir, scheint das Rascheln "
     "extrem laut zu sein.");
   AddSound( "farnblatt",
     "Ja! Unter dem sehr grossen Farnblatt scheint sich etwas zu befinden. "
     "Vielleicht solltest Du es einmal genauer untersuchen.");
   
//-------------------EXITS---------------------------------------------------

   AddExit( "norden", "./wald_02");
   AddExit( "westen", KRIROOM("1001"));
   AddExit( "suedwesten", KRIROOM("1002"));
   AddExit( "sueden", KRIROOM("1102"));

//-------------------KOMMANDOS-----------------------------------------------

   AddCmd( ({ "schaue", "schau" }), "c_durchsuchen");
   AddCmd( ({ "stolper", "stolpere" }), "c_stolpern");
   AddCmd( ({ "greife", "greif", "beruehre", "beruehr" }), "c_beruehren");
   
   grundzustand();
}

reset()
{
   ::reset();
   grundzustand();
}

void grundzustand()
{
   fuchs_da = 1;
}

int c_durchsuchen(string str)
{  
   notify_fail(BS("Worunter moechtest Du denn schauen?"));
   if(!(str == "unter farnblatt" || str == "unter sehr grosses farnblatt"
     || str == "unter grosses farnblatt"))
   {
     return 0;
   }
   if(present("schwarzfuchs", ENV(TP)) || (!fuchs_da))
   {
     write(BS("Neugierig schaust Du unter das sehr grosse Farnblatt. "
     	      "Doch darunter war leider nichts aufregendes verborgen, "
     	      "Du scheinst Dich getaeuscht zu haben."));
     return 1;
   }
   else
   {
     write(BS("Neugierig schaust Du unter das sehr grosse Farnblatt. "
    	      "Erbost springt ein Fuchs darunter hervor und greift Dich "
    	      "an."));
     tell_room(ENV(TP), TPN+" scheucht einen Fuchs auf.\n", ({TP}));
     fuchs_da = 0;
     AddItem(KRINPC("fuchs"), REFRESH_REMOVE,
            ([P_AGGRESSIVE: 1]) );
     return 1;
   }
}

int c_stolpern(string str)
{
   notify_fail(BS("Worueber moechtest Du denn stolpern?"));
   if(!(str == "ueber ast" || str == "ueber aeste"))
   {
     return 0;
   }
     write(BS("Du stolperst ueber einen am Waldboden liegenenden Ast und "
     	      "und faellst genau in einen Strauch. Dabei verletzt Du Dich "
     	      "an den Dornen etwas. Du Tollpatsch, pass doch besser auf!"));
     tell_room(ENV(TP), TPN+" stolpert ueber einen Ast.\n", ({TP}));
     TP->AddHp(-5);
     return 1;
}

int c_beruehren(string str)
{
   notify_fail(BS("Wo moechtest Du denn reingreifen?"));
   if(!(str == "in dornen" || str == "in straeucher"))
   {
     return 0;
   }
     write(BS("Du greifst absichtlich in die Dornen der Straeucher und "
     	      "verletzt Dich etwas."));
     tell_room(ENV(TP), TPN+" greift in die Straeucher und schreit auf.\n", 
     	      ({TP}));
     SetProp(P_KILL_NAME, "Blutende Wunden");
     SetProp(P_KILL_MSG, ({ 0, 0, PLURAL }));
     TP->do_damage(5);
     return 1;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(KILLLOG, dtime()+": Die Dornen toeteten "+CAP(getuid(player))+" ("+lostexp+" EXP verloren)\n");
}