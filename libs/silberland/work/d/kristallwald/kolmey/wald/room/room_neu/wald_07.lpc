inherit "std/room";

#include "../../kwald.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

void grundzustand();
int muenzen_da;

create()
{
	
::create();

   SetProp(P_INT_SHORT, "Im Kristallwald");
   SetProp(P_INT_LONG,
     "Du stehst auf einem erdigen Weg im Kristallwald, der Dich nach "
     "Norden, Osten und Westen hin durch den Wald fuehrt. Am Wegrand entdeckst "
     "Du kristallines Gras das beinahe verlaufend mit mannhohen Straeuchern, "
     "Baeumen und anderen Gewaechsen das dichte Unterholz bildet. Auf "
     "nordoestlicher Seite scheinen die Gewaechse einen regelrechten Wall "
     "aus kristallinen Pflanzen zu bilden. Nur wenige Sonnenstrahlen dringen "
     "durch das dichte Blaetterdach in die Umgebung ein und lassen diese "
     "etwas funkeln und glitzern. Im Norden scheint das Gras der Erde zu "
     "weichen.");
     
//-------------------RAUMEIGENSCHAFTEN---------------------------------------
   
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
   SetProp(P_INDOORS, 0);
   SetProp(P_LOG_FILE, "/d/kristallwald/kolmey/wroom.log");

//-------------------RAUMDETAILS---------------------------------------------

   AddDetail( ({ "umgebung" }), TO->QueryProp(P_INT_LONG));
   
   AddDetail( ({ "weg" }),
     "Der Weg besteht aus festgetrampelter, kristalliner Erde, die von "
     "einigen glaenzenden Kieselsteinen bedeckt ist. Er fuehrt Dich nach "
     "Westen, Osten und Norden und wird am Rand von kristallinem Gras, "
     "Baeumen und Gewaechsen begleitet.");
   AddDetail( ({ "erde", "erdboden" }),
     "Der Weg besteht aus gewoehnlicher, festgetrampelter, kristalliner "
     "Erde.");
   AddDetail( ({ "boden", "waldboden" }),
     "Der Waldboden besteht hier aus erdigem Weg, kristallinem Gras, "
     "einigen Gewaechsen und Baeumen.");
   AddDetail( ({ "kieselsteine" }),
     "Einige, in den Erdboden eingetrampelte, Kieselsteine kannst Du am "
     "Boden entdecken. Auch Sie wurden vom Kristall nicht verschont und "
     "glaenzen durch die wenigen Sonnenstrahlen die durch das Blaetterdach "
     "gelangen.");
   AddDetail( ({ "westen" }),
     "Nach Westen gelangst Du in weitere Teile des Waldes.");
   AddDetail( ({ "osten" }),
     "Nach Osten gelangst Du in weitere Teile des Waldes.");
   AddDetail( ({ "norden" }),
     "Nach Norden gelangst Du in weitere Teile des Waldes.");
   AddDetail( ({ "richtungen" }),
     "Du kannst dem Weg hier nach Westen, Norden und Osten folgen.");
   AddDetail( ({ "wegrand" }),
     "Am Wegrand vermischt sich kristallines Gras mit dem erdigen Weg und "
     "den anderen Gewaechsen.");
   AddDetail( ({ "gras" }),
     "Kurzes kristallines Gras waechst am Wegrand und bildet beinahe "
     "verlaufend mit den anderen Gewaechsen das dichte Unterholz. "
     "Im Norden scheint es der Erde zu weichen.");
   AddDetail( ({ "erde" }),
     "Mit kristallinen Kieselsteinen bedeckte Erde bildet hier den Weg "
     "neben kristallinem Gras.");
   AddDetail( ({ "rand" }),
     "Einige kristallines Gras, Baeume und Gewaechse begleiten den Weg am "
     "Rand und verhindern so dass Du diesen verlaesst.");
   AddDetail( ({ "baeume" }),
     "Vorwiegend kristalline Laubbaeume wachsen am Rand des Weges. Zwischen "
     "und hinter diesen kannst Du einige Gewaechse sehen.");
   AddDetail( ({ "laubbaeume" }),
     "Vorwiegend kristalline Laubbaeume wachsen am Rand des Weges. Ihre "
     "riesigen Staemme ragen neben Dir in die Hoehe und bilden weit oben "
     "mit ihren Blaettern und Aesten ein dichtes Blaetterdach. Aufgrund "
     "des Kristalls kannst Du nicht festellen um welche genaue Art von "
     "Laubbaeumen es sich hierbei handelt.");
   AddDetail( ({ "art" }),
     "Du kannst aufgrund des Kristalls nicht festellen welche Laubbaeume "
     "den Weg begleiten.");
   AddDetail( ({ "staemme" }),
     "Riesige Staemme ragen links und rechts am Weg in die Hoehe. Sie sind "
     "von kristallinem Efeu umschlungen und bilden weit oben mit den Aesten "
     "und Blaettern ein dichtes Blaetterdach.");
   AddDetail( ({ "aeste", "zweige" }),
     "Vereinzelt kleine und viele grosse Aeste und Zweige bilden hoch "
     "oben mit Blaettern ein dichtes Blaetterdach.");
   AddDetail( ({ "blaetter" }),
     "Zahlreiche kristalline Blaetter wachsen auf den Aesten der Baeume "
     "weit oben in entfernter Hoehe. Sie verwehren den Sonnenstrahlen ein "
     "durchdringen zum Waldboden.");
   AddDetail( ({ "blaetterdach" }),
     "Hoch oben bilden die Aeste der Laubbaeume mit den Blaettern ein "
     "ziemlich dichtes Blaetterdach das nur wenige Sonnenstrahlen hindurch "
     "laesst.");
   AddDetail( ({ "kristall" }),
     "Hier im Kristallwald traegt alles eine duenne Kristallschicht die das "
     "Licht reflektiert und die Umgebung ein wenig verzaubert.");
   AddDetail( ({ "kristallschicht", "schicht" }),
     "Alles hier traegt diese duenne Kristallschicht und erstrahlt in "
     "zartem Weiss und Rosa.");
   AddDetail( ({ "schimmern" }),
     "Der Kristall schimmert in zarten Weiss und Rosa.");
   AddDetail( ({ "weiss" }),
     "Zartschimmerndes Weiss, es erinnert Dich irgendwie an Bluetenblaetter "
     "eines Gaensebluemchens.");
   AddDetail( ({ "rosa" }),
     "Helles, zartschimmerndes Rosa.");
   AddDetail( ({ "kristallwald", "wald" }),
     "Du befindest Dich hier im legendaeren Kristallwald. Hier traegt alles "
     "eine duenne Kristallschicht. Durch die wenigen Sonnenstrahlen funkelt "
     "und glitzert der Wald hier etwas.");
   AddDetail( ({ "funkeln", "glitzern" }),
     "Das Funkeln und Glitzern entsteht wenn die Sonnenstrahlen auf den "
     "Kristall treffen. Hier funkelt und glitzert es nur ein wenig. Das "
     "Blaetterdach ist einfach zu dicht. Dennoch, ein zauberhafter "
     "Anblick.");
   AddDetail( ({ "anblick" }),
     "Einige Sonnenstrahlen fallen durch das Blaetterdach in die Umgebung "
     "ein und verzaubern den Wald durch reflektieren des Lichts.");
   AddDetail( ({ "sonnenstrahlen", "strahlen" }),
     "Nur wenige Sonnenstrahlen fallen durch vereinzelte Luecken im dichten "
     "Blaetterdach in die Umgebung ein.");
   AddDetail( ({ "blick" }),
     "Der Blick auf den Himmel wird Dir hier nur durch vereinzelte Luecken "
     "im Blaetterdach gewaehrt.");
   AddDetail( ({ "himmel" }),
     "Dur die Luecken erkennst Du den strahlend blauen Himmel.");
   AddDetail( ({ "luecken" }),
     "Durch vereinzelte Luecken im Blaetterdach kannst Du den Himmel "
     "erkennen. Durch diese Luecken fallen auch die wenigen Sonnenstrahlen "
     "in die Umgebung ein, die diese erhellen.");
   AddDetail( ({ "hoehe" }),
     "Die Staemme der Laubbaeume wachsen weit in die Hoehe, so weit, dass "
     "Du gerade noch den Punkt sehen kannst wo die Aeste mit den Blaettern "
     "das dichte Blaetterdach bilden.");
   AddDetail( ({ "punkt" }),
     "Du kannst gerade noch den Punkt erkennen, wo die Aeste der Baeume mit "
     "den Blaettern das Blaetterdach bilden.");
   AddDetail( ({ "gewaechse" }),
     "Zwischen und hinter den Baeumen befinden sich mannhohe Straeucher, "
     "Buesche und kristalliner Efeu.");
   AddDetail( ({ "straeucher" }), 
     "Mannhohe kristalline Straeucher wachsen zwischen und hinter den "
     "Baeumen. Sie wachsen beinahe verlaufend mit dem kristallinen Gras "
     "und anderen Gewaechsen zu dem dichten Unterholz zusammen und scheinen "
     "auf nordoestlicher Seite einen regelrechten magischen Wall zu bilden.");
   AddDetail( ({ "buesche" }),
     "Zahlreiche kristalline Buesche wachsen zwischen und hinter den "
     "Baeumen und bilden das dichte Unterholz.");
   AddDetail( ({ "efeu" }),
     "Zwischen, hinter und auf den Baeumen wuchert kristallines Efeu. "
     "Dazwischen entdeckst Du einen kleinen Baumstumpf, den das Efeu "
     "wohl vollkommen ueberwachsen hat.");
   AddDetail( ({ "baumstumpf" }),
     "Der kleine Baumstumpf ist so unscheinbar, wegen dem ganzen Efeu "
     "haettest Du ihn beinahe uebersehen. Er modert etwas und das Holz "
     "ist wohl schon ziemlich morsch.");
   AddDetail( ({ "holz" }),
     "Das Holz des Baumstumpfes ist schon ziemlich morsch. Man kann darin "
     "schon einige Risse erkennen.");
   AddDetail( ({ "risse" }),
     "Das morsche Holz des Baumstumpfes weisst zahlreiche Risse auf, "
     "in denen sich Ameisen tummeln.");
   AddDetail( ({ "ameisen" }),
     "Unzaehlige Ameisen tummeln sich in den Rissen. Einen groesseren Riss "
     "scheinen sie aber anscheinend zu meiden.");
   AddDetail( ({ "riss" }),
     "Was wohl in dem Riss sein mag, das ihn die Ameisen meiden?");
   AddDetail( ({ "unterholz" }),
     "Das Unterholz hinter den Baeumen ist so dicht das es Dir unmoeglich "
     "scheint den Weg, ausser in die freien Richtungen, zu verlassen.");
   AddDetail( ({ "gaensebluemchen" }),
     "Gaensebluemchen haben kleine weisse Bluetenblaetter. "
     "Zwischen den Gewaechsen kannst Du leider keines ausmachen.");
   AddDetail( ({ "bluetenblaetter" }),
     "Das weissliche Schimmern des Kristalls erinnert Dich an die "
     "Bluetenblaetter eines Gaensebluemchens.");
   AddDetail( ({ "licht" }),
     "Das Licht hier hast Du den Sonnenstrahlen zu verdanken.");
   AddDetail( ({ "pflanzen" }),
     "Auf nordoestlicher Seite scheinen die mannhohen Straeucher beinahe "
     "verlaufend mit kristallinem Gras, den Baeumen und Gewaechsen einen "
     "regelrechten kristallinen Wall zu bilden.");
   AddDetail( ({ "oestliche seite", "noerdliche seite", "seite" }),
     "Auf der oestlichen und noerdlichen Seite, neben dem Weg, scheint es "
     "Dir als wuerden die Gewaechse eine regelrechten kristallinen Wall "
     "bilden von dem eine starke magische Aura auszugehen scheint.");
   AddDetail( ({ "aura" }),
     "Eine starke magische Aura, die Du foermlich spueren kannst, scheint "
     "von dem Wall aus Pflanzen auszugehen. Sein Ursprung ist bestimmt "
     "nicht natuerlich.");
   AddDetail( ({ "ursprung", "weile" }),
     "Du gruebelst eine Weile ueber den Ursprung des Walls und kommst zu "
     "dem Schluss das dieser wohl nicht natuerlich entstanden sein kann.");
   AddDetail( ({ "schluss" }),
     "Nein! Der Wall hat keinen natuerlichen Ursprung.");
   AddDetail( ({ "wall" }),
     "Der Wall besteht aus den hier wachsenden Gewaechsen und befindet sich "
     "auf der nordoestlichen Seite. Eine starke magische Aura scheint von "
     "ihm auszugehen.");
   AddDetail( ({ "luft" }),
     "Die Luft hier ist etwas muffig.");
   AddDetail( ({ "teil", "teile" }),
     "Du befindest Dich in einem Teil des Kristallwalds.");
   
//-------------------GERAUESCHE-GERUECHE-------------------------------------

   AddSound(DEFAULT_SOUND,
     "Momentan ist es absolut still hier.");
   
   AddSmell(DEFAULT_SMELL,
     "Ein modriger Geruch liegt in der Luft.");
   AddSmell( ({ "geruch" }),
     "Der modrige Geruch scheint wohl aus dem Unterholz zu kommen.");

//-------------------EXITS---------------------------------------------------

   AddExit( "norden", "./wald_08");
   AddExit( "westen", "./wald_06");
   AddExit( "osten", "./wald_09");

//-------------------KOMMANDOS-----------------------------------------------
  
   AddCmd( ({ "spuere", "spuer" }), "c_spueren");
   AddCmd( ({ "greife", "greif" }), "c_greifen");

   grundzustand();
}
void reset()
{
   ::reset();
   grundzustand();
}

void grundzustand()
{
   muenzen_da = 1;
}


int c_spueren(string str)
{  
   notify_fail(BS("Was moechtest Du denn spueren?"));
   if(!(str == "aura" || str == "magie"))
   {
     return 0;
   }
    write(BS("Du laesst die magische Aura auf Dich einwirken.\n"
    	  "Du erzitterst erfuehrchtig und fuehlst einen angenehmen Schauer "
    	  "durch Deinen Koerper ziehen."));
    TP->SetProp(P_MV, TP->QueryProp(P_MV)+(200));
    return 1;
}

int c_greifen(string str)
{  
   notify_fail(BS("Wo moechtest Du denn reingreifen?"));
   if(!(str == "in riss" || str == "in riss hinein"))
   {
     return 0;
   }
   if(!muenzen_da)
   {
     write(BS("Du greifst in den Riss hinein und hast Dich getaeuscht, der "
     	      "Riss ist voller Ameisen die jetzt auf Deiner Hand "
     	      "herumkrabbeln. Erschrocken schuettelst Du die Ameisen ab."));
     tell_room(ENV(TP), BS(TPN+" springt wie ein Verrueckter durch den Raum "
     			    "und schuettelt seine Hand."), ({TP}));
     return 1;
   }
   else
   {
     write(BS("Du greifst in den Riss hinein und findest tatsaechlich "
     	      "etwas."));
     tell_room(ENV(TP), BS(TPN+" greift in einen Riss und sieht reicher "
     			    "aus."), ({TP}));
     muenzen_da = 0;
     TP->AddMoney(2000+random(3000));
     return 1;
  }
}