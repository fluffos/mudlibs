inherit "std/room";

#include "../../kwald.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
	
::create();
   
   SetProp(P_INT_SHORT, "Im Kristallwald");
   SetProp(P_INT_LONG,
     "Du stehst auf einem erdigen Weg im Kristallwald, der Dich nach "
     "Nordosten und Sueden weiter durch den Wald, und nach Osten zu einem "
     "Dorf fuehrt. Der Weg wird links und rechts von einigen Baeumen "
     "begleitet die ihn abgrenzen. Zwischen den Baeumen wachsen einige "
     "Gewaechse, die so das verlassen des Weges verhindern. Auf oestlicher "
     "und suedoestlicher Seite wachsen die Gewaechse zu einem regelrechten "
     "Wall zusammen, der sich nach Osten hin oeffnet und eine Art Torbogen "
     "zu bilden scheint. Nur wenige Sonnenstrahlen fallen durch das dichte "
     "Blaetterdach und verzaubern die Umgebung etwas. Im Nordwesten scheint "
     "das Gelaende steiniger zu werden und im Sueden kannst Du eine "
     "Kreuzung sehen.");

//-------------------RAUMEIGENSCHAFTEN---------------------------------------
   
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
   SetProp(P_INDOORS, 0);
   SetProp(P_LOG_FILE, "/d/kristallwald/kolmey/wroom.log");

//-------------------RAUMDETAILS---------------------------------------------

   AddDetail( ({ "umgebung" }), TO->QueryProp(P_INT_LONG));
   
   AddDetail( ({ "oestliche seite", "suedoestliche seite", "seite" }),
     "Auf der oestlichen und suedoestlichen Seite, neben dem Weg, scheint "
     "es Dir als wuerden die Gewaechse eine regelrechten kristallinen Wall "
     "bilden von dem eine starke magische Aura auszugehen scheint. Im "
     "Osten scheint der Wall zu oeffnen und einen Torbogen zu bilden.");
   AddDetail( ({ "kreuzung" }),
     "Im Sueden kannst Du eine Kreuzung sehen die um einen kleinen Baum "
     "zu verlaufen scheint.");
   AddDetail( ({ "baum" }),
     "Der Baum sieht irgendwie anders aus als die restlichen Baeume hier. "
     "Doch naeheres kannst Du von hier aus nicht erkennen. Du solltest "
     "besser im Sueden nachsehen.");
   AddDetail( ({ "torbogen" }),
     "Es sieht so aus als wuerde sich der Wall nach Osten hin oeffnen und "
     "den Eingang zu einem Dorf zu bilden.");
   AddDetail( ({ "eingang" }),
     "Der Eingang zu dem Dorf befindet sich im Osten.");
   AddDetail( ({ "dorf" }),
     "Das Dorf scheint sich im Osten zu befinden.");
   AddDetail( ({ "strasse" }),
     "Nach Osten hin geht der Waldweg beinahe verlaufend zu einer Strasse "
     "ueber und fuehrt zu einem Dorf.");
   AddDetail( ({ "aura" }),
     "Eine starke magische Aura, die Du foermlich spueren kannst, scheint "
     "von dem Wall aus Pflanzen auszugehen. Sein Ursprung ist bestimmt "
     "nicht natuerlich.");
   AddDetail( ({ "ursprung", "weile" }),
     "Du gruebelst eine Weile ueber den Ursprung des Walls und kommst zu "
     "dem Schluss das dieser wohl nicht natuerlich entstanden sein kann.");
   AddDetail( ({ "schluss" }),
     "Nein! Der Wall hat keinen natuerlichen Ursprung.");
   AddDetail( ({ "wall" }),
     "Der Wall besteht aus einer vielzahl von Pflanzen und befindet sich "
     "auf der oestlichen und noerdlichen Seite. Eine starke magische Aura "
     "scheint von ihm auszugehen.");
   AddDetail( ({ "weg", "waldweg" }),
     "Der Weg besteht aus festgetrampelter, kristalliner Erde, die von "
     "einigen glaenzenden Kieselsteinen bedeckt ist. Er fuehrt Dich nach "
     "Sueden, Nordosten und Osten und wird am Rand von Baeumen und "
     "Gewaechsen begleitet. Richtung Osten geht die Erde beinahe verlaufend "
     "zu einer Strasse ueber.");
   AddDetail( ({ "erde", "erdboden" }),
     "Der Weg besteht aus gewoehnlicher, festgetrampelter, kristalliner "
     "Erde und geht Richtung Osten beinahe verlaufend zu einer Strasse "
     "ueber.");
   AddDetail( ({ "boden", "waldboden" }),
     "Der Waldboden besteht hier aus erdigem Weg und einigen Gewaechsen "
     "und Baeumen.");
   AddDetail( ({ "kieselsteine" }),
     "Einige, in den Erdboden eingetrampelte, Kieselsteine kannst Du am "
     "Boden entdecken. Auch Sie wurden vom Kristall nicht verschont und "
     "glaenzen durch die wenigen Sonnenstrahlen die durch das Blaetterdach "
     "gelangen.");
   AddDetail( ({ "nordosten" }),
     "Nach Nordwesten gelangst Du in weitere Teile des Waldes.");
   AddDetail( ({ "sueden" }),
     "Nach Sueden gelangst Du in weitere Teile des Waldes.");
   AddDetail( ({ "osten" }),
     "Nach Osten fuehrt Dich eine Strasse zu einem Dorf hin.");
   AddDetail( ({ "richtungen" }),
     "Du kannst dem Weg hier nach Sueden, Nordosten und Osten folgen.");
   AddDetail( ({ "rand" }),
     "Einige kristalline Baeume und Gewaechse begleiten den Weg am Rand und "
     "verhindern so dass Du diesen verlaesst.");
   AddDetail( ({ "baeume" }),
     "Vorwiegend kristalline Laubbaeume wachsen am Rand des Weges. Zwischen "
     "und hinter diesen kannst Du einige Gewaechse sehen.");
   AddDetail( ({ "laubbaeume" }),
     "Vorwiegend kristalline Laubbaeume wachsen am Rand des Weges. Ihre "
     "riesigen Staemme ragen neben Dir in die Hoehe und bilden weit oben "
     "mit ihren Blaettern und Aesten ein dichtes Blaetterdach. Aufgrund "
     "des Kristalls kannst Du nicht festellen um welche genaue Art von "
     "Laubbaeumen es sich hierbei handelt.");
   AddDetail( ({ "art" }),
     "Du kannst aufgrund des Kristalls nicht festellen welche Laubbaeume "
     "den Weg begleiten.");
   AddDetail( ({ "staemme" }),
     "Riesige Staemme ragen links und rechts am Weg in die Hoehe. "
     "Weit oben bilden sie mit Aesten und Blaettern ein dichtes "
     "Blaetterdach.");
   AddDetail( ({ "aeste", "zweige" }),
     "Vereinzelt kleine und viele grosse Aeste und Zweige bilden hoch "
     "oben mit Blaettern ein dichtes Blaetterdach.");
   AddDetail( ({ "blaetter" }),
     "Zahlreiche kristalline Blaetter wachsen auf den Aesten der Baeume "
     "weit oben in entfernter Hoehe. Sie verwehren den Sonnenstrahlen ein "
     "durchdringen zum Waldboden.");
   AddDetail( ({ "blaetterdach" }),
     "Hoch oben bilden die Aeste der Laubbaeume mit den Blaettern ein "
     "ziemlich dichtes Blaetterdach das nur wenige Sonnenstrahlen hindurch "
     "laesst.");
   AddDetail( ({ "kristall" }),
     "Hier im Kristallwald traegt alles eine duenne Kristallschicht die das "
     "Licht reflektiert und die Umgebung ein wenig verzaubert.");
   AddDetail( ({ "kristallschicht", "schicht" }),
     "Alles hier traegt diese duenne Kristallschicht und erstrahlt in "
     "zartem Weiss und Rosa.");
   AddDetail( ({ "schimmern" }),
     "Der Kristall schimmert in zarten Weiss und Rosa.");
   AddDetail( ({ "weiss" }),
     "Zartschimmerndes Weiss, es erinnert Dich irgendwie an Bluetenblaetter "
     "eines Gaensebluemchens.");
   AddDetail( ({ "rosa" }),
     "Helles, zartschimmerndes Rosa.");
   AddDetail( ({ "kristallwald", "wald" }),
     "Du befindest Dich hier im legendaeren Kristallwald. Hier traegt alles "
     "eine duenne Kristallschicht. Durch die wenigen Sonnenstrahlen funkelt "
     "und glitzert der Wald hier etwas.");
   AddDetail( ({ "funkeln", "glitzern" }),
     "Das Funkeln und Glitzern entsteht wenn die Sonnenstrahlen auf den "
     "Kristall treffen. Hier funkelt und glitzert es nur ein wenig. Das "
     "Blaetterdach ist einfach zu dicht. Dennoch, ein zauberhafter "
     "Anblick.");
   AddDetail( ({ "anblick" }),
     "Einige Sonnenstrahlen fallen durch das Blaetterdach in die Umgebung "
     "ein und verzaubern den Wald durch reflektieren des Lichts.");
   AddDetail( ({ "sonnenstrahlen", "strahlen" }),
     "Nur wenige Sonnenstrahlen fallen durch vereinzelte Luecken im dichten "
     "Blaetterdach in die Umgebung ein.");
   AddDetail( ({ "himmel", "blick" }),
     "Der Blick auf den Himmel wird Dir hier nur durch vereinzelte Luecken "
     "im Blaetterdach gewaehrt.");
   AddDetail( ({ "luecken" }),
     "Durch vereinzelte Luecken im Blaetterdach kannst Du den Himmel "
     "erkennen. Durch diese Luecken fallen auch die wenigen Sonnenstrahlen "
     "in die Umgebung ein, die diese erhellen.");
   AddDetail( ({ "hoehe" }),
     "Die Staemme der Laubbaeume wachsen weit in die Hoehe, so weit, dass "
     "Du gerade noch den Punkt sehen kannst wo die Aeste mit den Blaettern "
     "das dichte Blaetterdach bilden.");
   AddDetail( ({ "punkt" }),
     "Du kannst gerade noch den Punkt erkennen, wo die Aeste der Baeume mit "
     "den Blaettern das Blaetterdach bilden.");
   AddDetail( ({ "gewaechse" , "pflanzen" }),
     "Zwischen und hinter den Baeumen befinden sich zahlreiche Straeucher, "
     "Buesche und kristalliner Efeu.");
   AddDetail( ({ "straeucher" }), 
     "Zahlreiche kristalline Straeucher wachsen zwischen und hinter den "
     "Baeumen und bilden das dichte Unterholz.");
   AddDetail( ({ "buesche" }),
     "Zahlreiche kristalline Buesche wachsen zwischen und hinter den "
     "Baeumen und bilden das dichte Unterholz.");
   AddDetail( ({ "efeu" }),
     "Zwischen und hinter den Baeumen wuchert kristallines Efeu.");
   AddDetail( ({ "unterholz" }),
     "Das Unterholz hinter den Baeumen ist so dicht das es Dir unmoeglich "
     "scheint den Weg zu verlassen.");
   AddDetail( ({ "gaensebluemchen" }),
     "Gaensebluemchen haben kleine weisse Bluetenblaetter. "
     "Zwischen den Gewaechsen kannst Du leider keines ausmachen.");
   AddDetail( ({ "bluetenblaetter" }),
     "Das weissliche Schimmern des Kristalls erinnert Dich an die "
     "Bluetenblaetter eines Gaensebluemchens.");
   AddDetail( ({ "licht" }),
     "Das Licht hier hast Du den Sonnenstrahlen zu verdanken.");
   AddDetail( ({ "teil", "teile" }),
     "Du befindest Dich in einem Teil des Kristallwalds.");
   
//-------------------GERAUESCHE----------------------------------------------

   AddSound(DEFAULT_SOUND,
     "Die Blaetter auf den Baeumen rascheln leise.");
   AddSound( ({ "rascheln" }),
     "Die Blaetter auf den Baeumen rascheln leise.");

//-------------------EXITS---------------------------------------------------
   
   AddExit( "nordosten", "./wald_22");
   AddExit( "sueden", "./wald_04");
}

