inherit "std/room";

#include "../kwald.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

int wind_da;

mapping eierleger;

create()
{
	
::create();
   
   SetProp(P_INT_SHORT, "Im Kristallwald");
   SetProp(P_INT_LONG,
     "Du stehst auf einem erdigen Weg im Kristallwald, der Dich nach "
     "Nordosten und Suedosten durch den Wald fuehrt und rechts und "
     "links von einigen Baeumen, die ihn abgrenzen zu scheinen, begleitet "
     "wird. Zwischen den Baeumen wachsen einige Gewaechse, die so das "
     "verlassen des Weges verhindern. Nur wenige Sonnenstrahlen fallen "
     "durch das dichte Blaetterdach und verzaubern die Umgebung etwas. "
     "Im Nordosten kannst Du eine Kreuzung sehen.");

//-------------------RAUMEIGENSCHAFTEN---------------------------------------
   
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
   SetProp(P_INDOORS, 0);
   SetProp(P_LOG_FILE, "/d/kristallwald/kolmey/wroom.log");

//-------------------RAUMDETAILS---------------------------------------------

   AddDetail( ({ "umgebung" }), TO->QueryProp(P_INT_LONG));
   
   AddDetail( "weg",
     "Der Weg besteht aus festgetrampelter, kristalliner Erde, die von "
     "einigen glaenzenden Kieselsteinen bedeckt ist. Er fuehrt Dich nach "
     "Suedwesten und Osten und wird am Rand von Baeumen und Gewaechsen "
     "begleitet.");
   AddDetail( ({ "erde", "erdboden" }),
     "Der Weg besteht aus gewoehnlicher, festgetrampelter, kristalliner "
     "Erde.");
   AddDetail( ({ "boden", "waldboden" }),
     "Der Waldboden besteht hier aus dem erdigem Weg und einigen Gewaechsen "
     "und Baeumen.");
   AddDetail( "kieselsteine",
     "Du kannst einige, in den Erdboden eingetrampelte, Kieselsteine am "
     "Boden entdecken. Auch Sie wurden vom Kristall nicht verschont und "
     "glaenzen durch die wenigen Sonnenstrahlen die durch das Blaetterdach "
     "gelangen.");
   AddDetail( "kreuzung",
     "Im Nordosten kannst Du eine Kreuzung sehen die um einen Baum "
     "zu verlaufen scheint.");
   AddDetail( "baum",
     "Der Baum sieht irgendwie anders aus als die restlichen Baeume hier. "
     "Doch naeheres kannst Du von hier aus nicht erkennen. Du solltest "
     "besser im Nordosten nachsehen.");
   AddDetail( "nordosten",
     "Nach Nordosten gelangst Du zu einer Kreuzung.");
   AddDetail( "suedosten",
     "Nach Suedosten gelangst Du in weitere Teile des Waldes.");
   AddDetail( "richtungen",
     "Du kannst dem Weg hier nach Nordosten und Suedosten folgen.");
   AddDetail( "rand",
     "Einige kristalline Baeume und Gewaechse begleiten den Weg am Rand und "
     "verhindern so das Du diesen verlaesst.");
   AddDetail( "baeume",
     "Vorwiegend kristalline Laubbaeume wachsen am Rand des Weges. Zwischen "
     "und hinter diesen kannst Du einige Gewaechse sehen.");
   AddDetail( "laubbaeume",
     "Vorwiegend kristalline Laubbaeume wachsen am Rand des Weges. Ihre "
     "riesigen Staemme ragen neben Dir in die Hoehe und bilden weit oben "
     "mit ihren Blaettern und Aesten ein dichtes Blaetterdach. Aufgrund "
     "des Kristalls kannst Du nicht festellen um welche genaue Art von "
     "Laubbaeumen es sich hierbei handelt.");
   AddDetail( "art",
     "Du kannst aufgrund des Kristalls nicht festellen welche Laubbaeume "
     "den Weg begleiten.");
   AddDetail( "staemme",
     "Riesige Staemme ragen links und rechts am Weg in die Hoehe. "
     "Weit oben bilden sie mit Aesten und Blaettern ein dichtes "
     "Blaetterdach.");
   AddDetail( ({ "aeste", "zweige" }),
     "Vereinzelt kleine und viele grosse Aeste und Zweige bilden hoch "
     "oben mit den Blaettern ein dichtes Blaetterdach.");
   AddDetail( "blaetter",
     "Zahlreiche kristalline Blaetter wachsen auf den Aesten der Baeume "
     "weit oben in entfernter Hoehe. Sie verwehren den Sonnenstrahlen ein "
     "durchdringen zum Waldboden.");
   AddDetail( "blaetterdach",
     "Hoch oben bilden die Aeste der Laubbaeume mit den Blaettern ein "
     "ziemlich dichtes Blaetterdach das nur wenige Sonnenstrahlen hindurch "
     "laesst.");
   AddDetail( "kristall",
     "Hier im Kristallwald traegt beinahe alles eine duenne Kristallschicht "
     "die das Licht reflektiert und die Umgebung ein wenig verzaubert.");
   AddDetail( ({ "kristallschicht", "schicht" }),
     "Alles hier traegt diese duenne Kristallschicht und erstrahlt in "
     "zartem Weiss und Rosa.");
   AddDetail( "schimmern",
     "Der Kristall schimmert in zarten Weiss und Rosa.");
   AddDetail( "weiss",
     "Zartschimmerndes Weiss, es erinnert Dich irgendwie an ein Ei.");
   AddDetail( "rosa",
     "Helles, zartschimmerndes Rosa.");
   AddDetail( ({ "kristallwald", "wald" }),
     "Du befindest Dich hier im legendaeren Kristallwald. Hier traegt "
     "beinahe alles eine duenne Kristallschicht. Durch die wenigen "
     "Sonnenstrahlen funkelt und glitzert der Wald hier etwas.");
   AddDetail( ({ "funkeln", "glitzern" }),
     "Das Funkeln und Glitzern entsteht wenn die Sonnenstrahlen auf den "
     "Kristall treffen. Hier funkelt und glitzert es nur ein wenig. Das "
     "Blaetterdach ist einfach zu dicht. Dennoch, ein zauberhafter "
     "Anblick.");
   AddDetail( "anblick",
     "Einige Sonnenstrahlen fallen durch das Blaetterdach in die Umgebung "
     "ein und verzaubern den Wald durch reflektieren des Lichts etwas.");
   AddDetail( ({ "sonnenstrahlen", "strahlen" }),
     "Nur wenige Sonnenstrahlen fallen durch vereinzelte Luecken im dichten "
     "Blaetterdach in die Umgebung ein.");
   AddDetail( ({ "himmel", "blick" }),
     "Der Blick auf den Himmel wird Dir hier nur durch vereinzelte Luecken "
     "im Blaetterdach gewaehrt.");
   AddDetail( "luecken",
     "Durch vereinzelte Luecken im Blaetterdach kannst Du den Himmel "
     "erkennen. Durch diese Luecken fallen auch die wenigen Sonnenstrahlen "
     "in die Umgebung ein, die diese erhellen.");
   AddDetail( "hoehe",
     "Die Staemme der Laubbaeume wachsen weit in die Hoehe, so weit, dass "
     "Du gerade noch den Punkt sehen kannst wo die Aeste mit den Blaettern "
     "das dichte Blaetterdach bilden.");
   AddDetail( "punkt",
     "Du kannst gerade noch den Punkt erkennen, wo die Aeste der Baeume mit "
     "den Blaettern das Blaetterdach bilden.");
   AddDetail( "gewaechse",
     "Zwischen und hinter den Baeumen befinden sich zahlreiche Straeucher, "
     "Buesche und kristalliner Efeu.");
   AddDetail( "straeucher", 
     "Zahlreiche kristalline Straeucher wachsen zwischen und hinter den "
     "Baeumen und bilden das dichte Unterholz.");
   AddDetail( "buesche",
     "Zahlreiche kristalline Buesche wachsen zwischen und hinter den "
     "Baeumen und bilden das dichte Unterholz.");
   AddDetail( "efeu",
     "Zwischen und hinter den Baeumen wuchert kristallines Efeu.");
   AddDetail( "unterholz",
     "Das Unterholz hinter den Baeumen ist so dicht das es Dir unmoeglich "
     "scheint den Weg zu verlassen. Auf oestlicher Seite scheint das "
     "Unterholz etwas zerdrueckt zu sein.");
   AddDetail( "oestliche seite",
     "Auf oestlicher Seite scheint das Unterholz etwas zerdrueckt zu sein. "
     "Es scheint beinahe so als ob sich dort Jemand den Weg durchs Unterholz "
     "gebahnt hat.");
   AddDetail( "jemand", 
     "Vielleicht ein Jaeger? Oder gar ein Monster?");
   AddDetail( "jaeger",
     "Du siehst hier keinen Jaeger.");
   AddDetail( "monster",
     "Vielleicht hat sich ja ein Monster den Weg durchs Unterholz gebahnt "
     "und sich dort versteckt? Dich gruselt.");
   AddDetail( "licht",
     "Das Licht hier hast Du den Sonnenstrahlen zu verdanken.");
   AddDetail( ({ "teil", "teile" }),
     "Du befindest Dich in einem Teil des Kristallwalds.");
   AddDetail( "ei",
     "Eier werden, soweit Du Dich erinnern kannst, von Huehnern gelegt.");
   AddDetail( "huehner",
     "Brave Huehner legen viele Eier.");
   AddDetail( "eier",
     "Versuch doch mal selbst Eier zu legen wenn Du Dich so sehr dafuer "
     "interessierst!");
   
//-------------------GERAUESCHE----------------------------------------------
   
   AddSmell(DEFAULT_SMELL, 
     "Du atmest die frische Waldluft ein.");
   AddSmell( "waldluft",
     "Ah, tut das gut!");
   
   AddSound(DEFAULT_SOUND,
     "Die Blaetter auf den Baeumen rascheln leise.");
   AddSound( "rascheln",
     "Die Blaetter auf den Baeumen rascheln leise.");

//-------------------SPECIAL_DETAILS-----------------------------------------
   
   AddSpecialDetail( "glanz", "glanz");

//-------------------KOMMANDOS-----------------------------------------------

   AddCmd( ({ "lege", "leg" }), "c_eierlegen");
   AddCmd( ({ "bahne", "bahn" }), "c_bahnen");
     
//-------------------EXITS---------------------------------------------------
   
   AddExit( "nordosten", "./wald_04");
   AddExit( "suedosten", "./wald_06");

   eierleger = ([]);
}

void reset()
{
   ::reset();
   wind_da = 0;
   eierleger = ([]);
}

int c_eierlegen(string str)
{  
   string spieler;
   spieler=getuid(TP);
   notify_fail(BS("Was moechtest Du denn legen?"));
   if(!(str == "eier" || str == "ei"))
   {
     return 0;
   }
   if(!member(eierleger, spieler))
   {
     eierleger+=([spieler: 0]);
   }
   if(eierleger[spieler, 0]>=1)
   {
     write(BS("Puh, Du bist noch immer ganz rot von der Anstrengung! "
     	      "Warte besser noch ein wenig, nicht dass Dir noch der "
     	      "Kopf platzt."));
     return 1;
   }
   else
   {
      eierleger[spieler, 0]++;
      write(BS("Angespannt gehst Du in die Knie und versuchst ein "
      	       "Ei zu legen. Dein Kopf wird ganz rot von der vielen "
      	       "Anstrengung. Schwindelig stehst Du wieder auf, ein "
      	       "Ei hast Du trotzdem nicht gelegt."));
      tell_room(ENV(TP), TPN+" scheitert klaeglich daran ein Ei zu "
      			     "legen, tja, scheint wohl doch nicht so "
      			     "einfach zu sein.\n", ({TP}));
      return 1;
   }
}

int c_bahnen(string str)
{
   object ob;
   notify_fail(BS("Wen oder was willst Du bahnen?"));
   if(str == "weg" || str == "weg durch unterholz"
   || str == "weg durch dschungel")
   { 
     if(ob = deep_present("machete", TP))
     {
       if(ob->QueryProp(P_WIELDED) == TP)
       {       
         write(BS("Du bahnst Dir Deinen Weg nach Osten."));
         tell_room(ENV(TP), TPN+" verschwindet ploetzlich im "
     			        "Unterholz.\n", ({TP}));
         TP->move(ROOM("unterholz"), M_GO | M_SILENT);
         return 1;
       }
      notify_fail(BS("Du solltest die Machete zuecken."));
      } 
     notify_fail(BS("Ohne Machete wirst Du hier wohl nicht weit "
     		    "kommen!"));
   }
   return 0; 
}

string glanz()
{
  string glanz;
  if(!wind_da)
  {
     glanz =
     "Sowas siehst Du da nicht!";
  }
  else
  {
     glanz =
     "Ein zauberhafter silbriger Glanz erstrahlt aus dem Nordosten. ";
  }
  return break_string(glanz, 78);
}

void SetWind_an()
{
   wind_da = 1;
}

void SetWind_aus()
{
   wind_da = 0;
}


