inherit "std/room";

#include "../../kwald.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
	
::create();
   
   SetProp(P_INT_SHORT, "Eine Anhoehe im Kristallwald");
   SetProp(P_INT_LONG,
     "Du befindest Dich auf einer Anhoehe im Kristallwald.\n"
     "Der Weg biegt sich hier um einen etwas groesseren, flachen Stein und "
     "fuehrt Dich, stark abfallend, nach Suedwesten und Suedosten zurueck "
     "in den dichteren Wald. Wenige Pflanzen gedeihen hier und machen "
     "Platz fuer Geroell und steiniges Gelaende, welches im Norden stark "
     "ansteigt und beinahe gerade nach oben zu verlaufen scheint. Hinter "
     "dem flachen Stein scheint ein ausgesprochen steiler Hang nach unten "
     "zu fuehren. Die Sonne leuchtet vom strahlend blauen Himmel und "
     "sendet ihre waermenden Strahlen die die Umgebung in zauberhaftem "
     "funkeln und glitzern erstrahlen lassen.");
     
//-------------------RAUMEIGENSCHAFTEN---------------------------------------
   
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
   SetProp(P_INDOORS, 0);
   SetProp(P_LOG_FILE, "/d/kristallwald/kolmey/wroom.log");

//-------------------RAUMDETAILS---------------------------------------------

   AddDetail( ({ "umgebung" }), TO->QueryProp(P_INT_LONG));
   
   AddDetail( ({ "anhoehe" }),
     "Du befindest Dich hier auf einer Anhoehe im Kristallwald. Zahlreiche "
     "Steine und Geroell beherrschen die Umgebung und verdraengen die "
     "Vegetation. Begrenzt wird die Anhoehe direkt auf noerdlicher Seite "
     "da das steinige Gelaende beinahe gerade nach oben verlaufen zu "
     "scheint. Auf suedlicher Seite, hinter dem grossen Stein verlaeuft "
     "ein steiler Hang nach unten, zurueck in den dichteren Wald.");
   AddDetail( ({ "steine" }),
     "Zahlreiche Steine praegen die Umgebung und verdraengen die Vegetation "
     "etwas.");
   AddDetail( ({ "geroell" }),
     "Das Geroell bildet den ueberwiegenden Teil des Bodens. Wahrscheinlich "
     "broeckelt es zeitweise von dem steinigen Gelaende auf noerdlicher "
     "Seite.");
   AddDetail( ({ "vegetation" }),
     "Es gibt hier deutlich weniger Pflanzen als im restlichen Wald. Das "
     "Geroell bildet nicht den richtigen Lebensraum fuer die Pflanzen hier "
     "und die spaerliche Erde bietet nicht genug Platz.");
   AddDetail( ({ "platz" }),
     "Die Pflanzen machen hier dem Geroell Platz.");
   AddDetail( ({ "pflanzen" }),
     "Die spaerliche Vegetation hier wird von ein paar duennen Bueschen, "
     "Straeuchern, etwas Efeu und ein paar Baeumen gebildet.");
   AddDetail( ({ "buesche" }),
     "Kleine, duenne Buesche wachsen hier vereinzelt.");
   AddDetail( ({ "straeucher" }),
     "Wenige karge Straeucher wachsen hier.");
   AddDetail( ({ "efeu" }),
     "Hier und da entdeckst Du etwas Efeu der sich um die groesseren Steine "
     "schlaengelt.");
   AddDetail( ({ "lebensraum" }),
     "Der steinige Boden bildet nicht den richtigen Lebensraum fuer die "
     "Pflanzen des Waldes.");
   AddDetail( ({ "boden" }),
     "Der Boden besteht hier aus dem Weg, Geroell, vereinzelter Erde und "
     "wenigen Pflanzen.");
   AddDetail( ({ "erde" }),
     "Hier und da kannst Du zwischen dem Geroell am Boden vereinzelt etwas "
     "feuchte Erde sehen.");
   AddDetail( ({ "baeume" }),
     "Vereinzelt befinden sich auf der Anhoehe auch ein paar kleinere und "
     "groessere kristalline Laubbaeume deren Staemme in die Hoehe ragen und "
     "dort oben an den Aesten spaerliches Blattwerk tragen. Aufgrund des "
     "Kristalls scheint es Dir unmoeglich herauszufinden um welche genaue "
     "Art es sich hierbei handelt.");
   AddDetail( ({ "staemme" }),
     "Die kristallinen Staemme der Baeume ragen in die Hoehe.");
   AddDetail( ({ "aeste" }),
     "Die Baeume recken ihre Aeste gen Himmel und tragen dort ein "
     "spaerliches Blaetterdach.");
   AddDetail( ({ "blattwerk" }),
     "Das einzige Blattwerk hier ist das spaerliche Blaetterdach.");
   AddDetail( ({ "blaetterdach" }),
     "Durch die wenigen Blaetter auf den Baeumen ist das Blaetterdach hier "
     "sehr unbestaendig und Du hast beinahe freien Blick auf den strahlend "
     "blauen Himmel.");
   AddDetail( ({ "blaetter" }),
     "Wenige kristalline Blaetter wachsen auf den Baeumen.");
   AddDetail( ({ "art" }),
     "Du kannst aufgrund des Kristalls nicht festellen welche Laubbaeume "
     "hier auf der Anhoehe wachsen.");
   AddDetail( ({ "wald", "kristallwald" }),
     "Du befindet Dich im legendaeren Kristallwald auf einer Anhoehe. "
     "Beinahe alles traegt hier eine duenne Kristallschicht.");
   AddDetail( ({ "kristallschicht", "schicht", "kristall" }),
     "Beinahe alles hier wurde vom Kristall ueberzogen.");
   AddDetail( ({ "noerdliche seite" }),
     "Auf der noerdlichen Seite wird die Anhoehe von dem steil nach oben "
     "verlaufenden Gelaende begrenzt.");
   AddDetail( ({ "gelaende" }),
     "Auf noerdlicher Seite steigt das steinige Gelaende steil, beinahe "
     "gerade, nach oben an und begrenzt die Anhoehe.");
   AddDetail( ({ "suedliche seite" }),
     "Auf suedlicher Seite, hinter dem grossen Stein, befindet sich ein "
     "steiler Hang, der nach unten, zurueck in den dichten Wald fuehrt.");
   AddDetail( ({ "hang" }),
     "Ein steiler Hang fuehrt auf suedlicher Seite nach unten wo die "
     "Vegetation wieder zuzunehmen scheint.");
   AddDetail( ({ "seite" }),
     "Meinst Du die suedliche oder die noerdliche Seite?");
   AddDetail( ({ "weg" }),
     "Der steinige Waldweg biegt sich hier um den grossen Stein, der auf "
     "suedlicher Seite knapp vor dem Hang liegt und fuehrt Dich nach "
     "Suedwesten und Suedosten zurueck in den dichteren Wald.");
   AddDetail( ({ "waldweg" }),
     "Der Waldweg besteht hier aus Geroell, vereinzelter Erde und "
     "wenigen Pflanzen.");
   AddDetail( ({ "suedwesten" }),
     "Nach Suedwesten gelangst Du in den dichteren Wald.");
   AddDetail( ({ "suedosten" }),
     "Nach Suedosten gelangst Du in den dichteren Wald.");
   AddDetail( ({ "stein" }),
     "Ein grosser, flacher Stein liegt auf suedlicher Seite knapp vor "
     "dem steilen Hang.");
   AddDetail( ({ "himmel" }),
     "Durch das unbestaendige Blaetterdach hast Du hier beinahe freien "
     "Blick auf den Himmel. Hoch oben strahlt die Sonne, es sind "
     "keine Wolken zu sehen.");
   AddDetail( ({ "wolken" }),
     "Du suchst den Himmel nach Wolken ab und findest tatsaechlich eine "
     "kleine Wolke.");
   AddDetail( ({ "wolke" }),
     "Die kleine Wolke zischt mit einer ziemlichen Geschwindigkeit ueber "
     "den Himmel.");
   AddDetail( ({ "geschwindigkeit" }), 
     "Huch, da ist sie schonwieder weg.");
   AddDetail( ({ "sonne" }),
     "Die Sonne leuchtet am Himmel und sendet Dir ihre waermenden "
     "Strahlen.");
   AddDetail( ({ "strahlen", "sonnenstrahlen" }),
     "Zahlreiche Sonnenstrahlen dringen durch das unbestaendige "
     "Blaetterdach in die Umgebung ein und lassen diese funklen "
     "und glitzern.");
   AddDetail( ({ "funkeln", "glitzern" }),
     "Die Umgebung funkelt und glitzert und bietet einen wahrhaft "
     "zauberhaften Anblick.");
   AddDetail( ({ "anblick" }),
     "Begeistert beobachtest Du das Farbenspiel.");
   AddDetail( ({ "farbenspiel" }),
     "Durch das Brechen des Lichts am Kristall tauchen die "
     "Sonnenstrahlen die Umgebung in alle Farben des Regenbogens ein.");
   AddDetail( ({ "brechen", "licht" }),
     "Die Sonnenstrahlen brechen sich am Kristall und erzeugen eine "
     "funkelnde und glitzernde Umgebung.");
   AddDetail( ({ "farben" }),
     "Die Umgebung funkelt und glitzert in allen Farben des Regenbogens.");
   AddDetail( ({ "regenbogen" }),
     "Hier kannst Du leider keinen Regenbogen entdecken.");
   AddDetail( ({ "blick" }),
     "Du hast hier freien Blick auf den Himmel.");
   AddDetail( ({ "teil", "teile" }),
     "Du befindest Dich in einem Teil des Kristallwalds.");

//-------------------GERAUESCHE----------------------------------------------

   AddSound(DEFAULT_SOUND,
     "Die Blaetter auf den Baeumen rascheln leise.");
   AddSound( ({ "rascheln" }),
     "Die Blaetter auf den Baeumen rascheln leise.");

//-------------------EXITS---------------------------------------------------
   
   AddExit( "suedwesten", "./wald_22");
   AddExit( "suedosten", "./wald_20");
}