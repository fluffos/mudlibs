inherit "std/room";

#include "../../kwald.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
	
::create();

   SetProp(P_INT_SHORT, "Im Kristallwald");
   SetProp(P_INT_LONG,
     "Du befindest Dich auf einem schmalen Weg im Kristallwald, der Dich "
     "nach Norden und Suedwesten weiter durch den Wald fuehrt. Dichte "
     "Vegetation wuchert am Boden und laesst den Weg wie einen Trampelpfad "
     "wirken. Zahlreiche Gewaechse bilden am Wegrand das dichte Unterholz "
     "und verhindern das verlassen des Weges. Auf westlicher Seite jedoch "
     "lichtet sich das Unterholz vor den Baeumen und Du kannst unmittelbar "
     "dahinter einen kleinen Teich erkennen. Wenige Sonnenstrahlen dringen "
     "durch das dichte Blaetterdach in die Umgebung ein und erhellen "
     "diese.");
     
//-------------------RAUMEIGENSCHAFTEN---------------------------------------
   
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
   SetProp(P_INDOORS, 0);
   SetProp(P_LOG_FILE, "/d/kristallwald/kolmey/wroom.log");

//-------------------RAUMDETAILS---------------------------------------------
   
      AddDetail( ({ "umgebung" }), TO->QueryProp(P_INT_LONG));

   AddDetail( ({ "weg" }),
     "Der schmale Weg besteht aus festgetrampelter, kristalliner Erde und "
     "gleicht eher einem Trampelpfad. Zahlreiche Pflanzen gedeihen auf dem "
     "erdigen Waldboden.");
   AddDetail( ({ "erde", "erdboden" }),
     "Der Weg besteht aus gewoehnlicher, festgetrampelter, kristalliner "
     "Erde.");
   AddDetail( ({ "boden", "waldboden" }),
     "Der Waldboden besteht hier aus erdigem Weg, kristallinem Gras, "
     "einigen Gewaechsen und Baeumen.");
   AddDetail( ({ "kieselsteine" }),
     "Einige, in den Erdboden eingetrampelte, Kieselsteine kannst Du am "
     "Boden entdecken. Auch Sie wurden vom Kristall nicht verschont und "
     "glaenzen durch die wenigen Sonnenstrahlen die durch das Blaetterdach "
     "gelangen.");
   AddDetail( ({ "norden" }),
     "Nach Norden gelangst Du in weitere Teile des Waldes.");
   AddDetail( ({ "suedwesten" }),
     "Nach Suedwesten gelangst Du in weitere Teile des Waldes.");
   AddDetail( ({ "richtungen" }),
     "Du kannst dem Weg hier nach Norden und Suedwesten folgen.");
   AddDetail( ({ "trampelpfad" }),
     "Der Weg gleicht hier eher einem Trampelpfad. Zahlreiche Pflanzen, "
     "gedeihen auf dem erdigen Waldboden und bilden den Wegrand.");
   AddDetail( ({ "wegrand" }),
     "Zahlreiche kristalline Pflanzen, darunter Efeu, Haselstraeucher, "
     "vereinzelt kleine Ahornbaeume, kristallines Gras und andere, "
     "Dir unbekannte Straeucher, bilden den Wegrand und wachsen dann "
     "zwischen und hinter den Baeumen zu dem dichten Unterholz zusammen.");
   AddDetail( ({ "gras" }),
     "Kurzes kristallines Gras waechst am Wegrand und bildet beinahe "
     "verlaufend mit den anderen Gewaechsen das dichte Unterholz.");
   AddDetail( ({ "rand" }),
     "Kristallines Gras, Baeume und Gewaechse begleiten den Weg am "
     "Rand und verhindern so dass Du diesen verlaesst.");
   AddDetail( ({ "baeume" }),
     "Vorwiegend kristalline Laubbaeume wachsen am Rand des Weges. "
     "Zwischen, hinter und vor diesen kannst Du einige Gewaechse sehen und "
     "auf westlicher Seite scheint sich hinter ihnen ein kleiner Teich zu "
     "befinden.");
   AddDetail( ({ "laubbaeume" }),
     "Vorwiegend kristalline Laubbaeume wachsen am Rand des Weges. Ihre "
     "riesigen Staemme ragen neben Dir in die Hoehe und bilden weit oben "
     "mit ihren Blaettern und Aesten ein dichtes Blaetterdach. Aufgrund "
     "des Kristalls kannst Du nicht festellen um welche genaue Art von "
     "Laubbaeumen es sich hierbei handelt.");
   AddDetail( ({ "art" }),
     "Du kannst aufgrund des Kristalls nicht festellen welche Laubbaeume, "
     "neben den kleinen Ahornbaeumen, den Weg begleiten.");
   AddDetail( ({ "staemme" }),
     "Riesige Staemme ragen links und rechts am Weg in die Hoehe. Sie sind "
     "von kristallinem Efeu umschlungen und bilden weit oben mit den Aesten "
     "und Blaettern ein dichtes Blaetterdach.");
   AddDetail( ({ "aeste", "zweige" }),
     "Vereinzelt kleine und viele grosse Aeste und Zweige bilden hoch "
     "oben mit Blaettern ein dichtes Blaetterdach.");
   AddDetail( ({ "blaetter" }),
     "Zahlreiche kristalline Blaetter wachsen auf den Aesten der Baeume "
     "weit oben in entfernter Hoehe. Sie verwehren den Sonnenstrahlen ein "
     "durchdringen zum Waldboden.");
   AddDetail( ({ "blaetterdach" }),
     "Hoch oben bilden die Aeste der Laubbaeume mit den Blaettern ein "
     "ziemlich dichtes Blaetterdach das nur wenige Sonnenstrahlen hindurch "
     "laesst.");
   AddDetail( ({ "kristall" }),
     "Hier im Kristallwald traegt alles eine duenne Kristallschicht die das "
     "Licht reflektiert und die Umgebung ein wenig verzaubert.");
   AddDetail( ({ "kristallschicht", "schicht" }),
     "Alles hier traegt diese duenne Kristallschicht und erstrahlt in "
     "zartem Weiss und Rosa.");
   AddDetail( ({ "schimmern" }),
     "Der Kristall schimmert in zarten Weiss und Rosa.");
   AddDetail( ({ "weiss" }),
     "Zartschimmerndes Weiss, es erinnert Dich irgendwie an Bluetenblaetter "
     "eines Gaensebluemchens.");
   AddDetail( ({ "rosa" }),
     "Helles, zartschimmerndes Rosa.");
   AddDetail( ({ "kristallwald", "wald" }),
     "Du befindest Dich hier im legendaeren Kristallwald. Hier traegt alles "
     "eine duenne Kristallschicht. Durch die wenigen Sonnenstrahlen funkelt "
     "und glitzert der Wald hier sehr wenig.");
   AddDetail( ({ "funkeln", "glitzern" }),
     "Das Funkeln und Glitzern entsteht wenn die Sonnenstrahlen auf den "
     "Kristall treffen. Hier funkelt und glitzert es nur sehr wenig. Das "
     "Blaetterdach ist einfach zu dicht. Dennoch, ein zauberhafter "
     "Anblick.");
   AddDetail( ({ "anblick" }),
     "Einige Sonnenstrahlen fallen durch das Blaetterdach in die Umgebung "
     "ein und verzaubern den Wald durch reflektieren des Lichts.");
   AddDetail( ({ "sonnenstrahlen", "strahlen" }),
     "Nur wenige Sonnenstrahlen fallen durch vereinzelte Luecken im dichten "
     "Blaetterdach in die Umgebung ein.");
   AddDetail( ({ "blick" }),
     "Der Blick auf den Himmel wird Dir hier nur durch vereinzelte Luecken "
     "im Blaetterdach gewaehrt.");
   AddDetail( ({ "himmel" }),
     "Dur die Luecken erkennst Du den strahlend blauen Himmel.");
   AddDetail( ({ "luecken" }),
     "Durch vereinzelte Luecken im Blaetterdach kannst Du den Himmel "
     "erkennen. Durch diese Luecken fallen auch die wenigen Sonnenstrahlen "
     "in die Umgebung ein, die diese erhellen.");
   AddDetail( ({ "hoehe" }),
     "Die Staemme der Laubbaeume wachsen weit in die Hoehe, so weit, dass "
     "Du gerade noch den Punkt sehen kannst wo die Aeste mit den Blaettern "
     "das dichte Blaetterdach bilden.");
   AddDetail( ({ "punkt" }),
     "Du kannst gerade noch den Punkt erkennen, wo die Aeste der Baeume mit "
     "den Blaettern das Blaetterdach bilden.");
   AddDetail( ({ "gewaechse", "pflanzen" }),
     "Zahlreiche Pflanzen gedeihen hier. Der Waldboden wird von "
     "kristallinem Efeu, kleinen Ahornbaeumen, kristallinem Gras, "
     "Straeuchern und Bueschen ueberwuchert. Diese Gewaechse bilden "
     "zwischen und hinter den Baeumen das dichte Unterholz welches "
     "sich im Westen, vor den Baeumen, lichtet.");
   AddDetail( ({ "straeucher" }), 
     "Mannhohe, aber auch kleinere kristalline Straeucher wachsen vor, "
     "zwischen und hinter den Baeumen. Sie wachsen beinahe verlaufend "
     "mit dem kristallinen Gras und anderen Gewaechsen zusammen und bilden "
     "das dichte Unterholz.");
   AddDetail( ({ "buesche" }),
     "Zahlreiche kristalline Buesche wachsen vor, zwischen und hinter den "
     "Baeumen und bilden das dichte Unterholz.");
   AddDetail( ({ "efeu" }),
     "Zwischen, vor, hinter und auf den Baeumen wuchert kristallines Efeu.");
   AddDetail( ({ "unterholz" }),
     "Das Unterholz hinter den Baeumen ist so dicht das es Dir unmoeglich "
     "scheint den Weg, ausser in die freien Richtungen, zu verlassen. Im "
     "Westen lichtet sich das Unterholz vor den Baeumen.");
   AddDetail( ({ "gaensebluemchen" }),
     "Gaensebluemchen haben kleine weisse Bluetenblaetter. "
     "Zwischen den Gewaechsen kannst Du leider keines ausmachen.");
   AddDetail( ({ "bluetenblaetter" }),
     "Das weissliche Schimmern des Kristalls erinnert Dich an die "
     "Bluetenblaetter eines Gaensebluemchens.");
   AddDetail( ({ "licht" }),
     "Das Licht hier hast Du den Sonnenstrahlen zu verdanken.");
   AddDetail( ({ "westliche seite", "seite" }),
     "Auf der westlichen Seite, vor den Baeumen, scheint sich das "
     "Unterholz zu lichten und Du kannst einen kleinen Teich sehen.");
   AddDetail( ({ "teil", "teile" }),
     "Du befindest Dich in einem Teil des Kristallwalds.");
   AddDetail( ({ "ahorn", "ahornbaeume" }),
     "Kleine kristalline Ahornbaeume wachsen neben dem Weg.");
   AddDetail( ({ "blickfeld" }),
     "Zahlreiche Aeste und Zweige der Straeucher und der kleinen "
     "Ahornbaeume trueben Dein Blickfeld.");
   AddDetail( ({ "haselstraeucher" }),
     "Ein paar kristalline Haselstraeucher wachsen neben dem Weg.");
   AddDetail( ({ "vegetation" }),
     "Die Vegetation ist hier sehr dicht.");
   AddDetail( ({ "teich" }),
     "Auf westlicher Seite, hinter den Baeumen, kannst Du einen kleinen "
     "Teich sehen. Das Wasser scheint klar und glitzert im Sonnenlicht. "
     "Einige Froesche und Pflanzen schwimmen darin, doch genaueres kannst Du "
     "von hier aus nicht erkennen.");
   AddDetail( ({ "wasser" }),
     "Das klare Wasser des Teichs plaetschert leise.");
   AddDetail( ({ "sonnenlicht" }),
     "Oberhalb des Teiches siehst Du den beinahe strahlend blauen Himmel, von "
     "dem aus die Sonne scheint und den Teich glitzern laesst.");
   AddDetail( ({ "sonne" }),
     "Du kannst die Sonne oberhalb des Teiches am Himmel erkennen.");
   AddDetail( ({ "froesche" }),
     "Du kannst die Froesche nicht genau erkennen, Du kannst sie nur quaken "
     "hoeren.");
   AddDetail( ({ "quaken" }),
     "Lausch ihm.");
   AddDetail( ({ "ferne" }),
     "Du kannst leises Quaken aus der Ferne hoeren.");   

//-------------------GERAUESCHE-GERUECHE-------------------------------------

   AddSound(DEFAULT_SOUND,
     "Leises Quaken ertoent vom Teich her.");
   AddSound( ({ "quaken" }),
     "Um mehr hoeren zu koennen solltest Du besser an den Teich "
     "herantreten.");
   
   AddSmell(DEFAULT_SMELL,
     "Du atmest die frische Waldluft ein.");
   AddSmell( ({ "waldluft" }),
     "Ah, tut das gut!");

//-------------------EXITS---------------------------------------------------

   AddExit( "norden", "./wald_16");
   AddExit( "suedwesten", "./wald_12");
}

/* Anhang
Moeglich waere hier einen Raum im Raum wie im Dorf zu erstellen. Dabei könnte
man den Teich zugaenglich machen und evtl. neue Aktionen (wie fischen zB) 
ermoeglichen... */
