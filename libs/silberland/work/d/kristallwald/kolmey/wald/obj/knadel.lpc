inherit "std/thing";

#include <properties.h>
#include "../kwald.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Kristallnadel");
  SetProp(P_LONG, 
    "Eine kleine Kristallnadel, die ziemlich spitz ist. Am oberen "
    "Ende hat sie auch so eine Art Oese...");
  SetProp(P_NAME, "Kristallnadel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kristallnadel", "nadel", KNADEL}) );

  SetProp(P_VALUE, 1000);
  SetProp(P_WEIGHT, 50);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, MAT_CRYSTAL);
  SetProp(P_NODROP, 1);
  
}