inherit "std/food";

#include "../kwald.h"
#include <properties.h>
#include <food.h>
#include <language.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine eigenartige Kristallfrucht");
  SetProp(P_LONG,
    "Eine eigenartige Frucht aus Kristall. "
    "Es ist nicht mehr festzustellen, welche Beere sich da mal "
    "unter der Kristallschicht befunden hat. Ob die wohl geniessbar ist?");
  SetProp(P_NAME, "Kristallfrucht");
  AddId( ({ "frucht", "kristallfrucht" }) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1);
  SetProp(P_FOOD_INFO, ([F_HEAL : ({30, 20}), F_SOAK : 2]));
}

void BeimEssen()
{
  write(BS("Du beisst in die eigenartige Kristallbeere hinein. "
  	   "Es knackt ziemlich als Du die Kristallschicht durchdringst... "
  	   "Doch die Kristallbeere ist geniessbar und Du fuehlst Dich "
  	   "etwas erfrischt."));
  tell_room(ENV(TP), TPN+" isst eine Kristallfrucht.", ({TP}));
}