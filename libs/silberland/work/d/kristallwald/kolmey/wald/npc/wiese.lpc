inherit "std/room";

#include "../kwald.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

void delayedwrite(object spieler, int curpos, mixed *daten);

#define target find_living("artifoxlas")

mapping reisser;
int drache = 0;

void grundzustand();
int muenzen_da;
int heilung;

create()
{
	
::create();

/*-----------------------KURZ UND LANGBESCHREIBUNG-----------------------*/
	
   SetProp(P_INT_SHORT, "Auf einer kristallinen Wiese");
   SetProp(P_INT_LONG,
     "Du befindest Dich im Kristallwald.\n"
     "Du stehst hier auf einer kreisrunden, kristallinen Wiese, die "
     "von zahlreichen Baeumen und Gewaechsen begrenzt wird. In ihrer "
     "Mitte erhebt sich ein maechtiger Baum. Das Gras funkelt und "
     "glitzert im Sonnenlicht.");

/*-----------------------RAUMEIGENSCHAFTEN-----------------------*/

   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_FOREST]) );
   SetProp(P_INDOORS, 0);
   SetProp(P_LOG_FILE, "/d/kristallwald/kolmey/wroom.log");

/*-----------------------RAUMDETAILS-----------------------*/

  AddDetail( ({ "wiese" }),
    "Du stehst auf der kreisrunden, kristallinen Wiese. "
    "Das kristalline Gras funkelt und glitzert im Sonnenlicht. "
    "In ihrer Mitte erhebt sich ein maechtiger Baum.");
  AddDetail( ({ "gras" }),
    "Die Wiese besteht aus kristallinem Gras. Durch das Sonnenlicht "
    "funkelt und glitzert es. Seltsam ist nur, dass hier keine Blumen "
    "wachsen.");
  AddDetail( ({ "blumen" }),
    "Hier wachsen keine Blumen. Richtig untypisch fuer so eine schoene "
    "Wiese.");
  AddDetail( ({ "sonne" }),
    "Die Sonne sendet Dir ihre Strahlen von dem wunderschoenen blauen "
    "Himmel.");
  AddDetail( ({ "strahlen", "sonnenstrahlen" }),
    "Waermende Strahlen beruehren Deine Haut.");
  AddDetail( ({ "haut" }),
    "Du kannst die Strahlen der Sonne auf Deiner Haut spueren.");
  AddDetail( ({ "sonnenlicht", "licht" }),
    "Die Sonne erleuchtet mit ihren Strahlen den Wald und laesst die "
    "ganze Umgebung funkeln und glitzern.");
  AddDetail( ({ "himmel" }),
    "Du siehst einen strahlend blauen Himmel. Die Sonne lacht von oben "
    "auf Dich herab. Es sind keine Wolken zu sehen.");
  AddDetail( ({ "wolken" }),
    "Du entdeckst nicht eine einzige Wolke.");
  AddDetail( ({ "wolke" }),
    "So sehr Du auch suchst, Du findest keine.");
  AddDetail( ({ "baeume" }),
    "Hohe, kristalline Baeume begrenzen die Wiese neben anderen "
    "Gewaechsen.");
  AddDetail( ({ "gewaechse" }),
    "Einige Gewaechse wachsen zwischen den Baeumen und begrenzen die "
    "Wiese. Du kannst einige Hecken, Straeucher und Farne erkennen.");
  AddDetail( ({ "hecken" }),
    "Einige Hecken mit spitzen Dornen befinden sich zwischen den Baeumen "
    "unter anderen Gewaechsen. Eine Hecke ist es jedoch, die Dir sofort "
    "ins Auge sticht.");
  AddDetail( ({ "dornen" }),
    "Spitze Dornen befinden sich auf den Hecken.");
  AddDetail( ({ "hecke" }),
    "Eine Hecke im Westen sticht Dir sofort ins Auge. Durch sie bist Du "
    "mit der Machete durchgedrungen und es befindet sich dort noch "
    "etwas Freiraum.");
  AddDetail( ({ "freiraum" }),
    "Etwas Freiraum befindet sich in einer Hecke im Westen. Vielleicht "
    "kannst Du durch das Loch wieder zurueckschluepfen?");
  AddDetail( ({ "westen" }),
    "Im Westen befindet sich eine eigenartige Hecke.");
  AddDetail( ({ "umgebung" }),
    "Das Sonnenlicht laesst das kristalline Gras funkeln und glitzern.");
  AddDetail( ({ "funkeln", "glitzern" }),
    "Die ganze Umgebung funkelt und glitzert.");
  AddDetail( ({ "straeucher" }),
    "Zahlreiche kristalline Straeucher wuchern zwischen den Baeumen und "
    "begrenzen die Wiese.");
  AddDetail( ({ "farne" }),
    "Grosse kristalline Farne saeumen die Wiese. Ab und zu haben sich auf "
    "ihnen auch ein paar wenige Tautropfen gesammelt.");
  AddDetail( ({ "tautropfen" }),
    "Vereinzelt haben sich auf den Farnen ein paar Tautropfen gesammelt.");
  AddDetail( ({ "boden" }),
    "Der Boden wird hier von einer schoenen Wiese gebildet.");
  AddDetail( ({ "wald", "kristallwald" }),
    "Rings um Dich befindet sich der legendaere Kristallwald.");
  AddDetail( ({ "mitte" }),
    "In der Mitte der Wiese erhebt sich ein maechtiger Baum.");
  AddDetail( ({ "baum" }),
    "Ein maechtiger Baum erhebt sich in der Mitte der Wiese. Eine "
    "magische Aura scheint von ihm auszugehen. Eine seiner Wurzeln "
    "liegt frei.");
  AddDetail( ({ "aura" }),
    "Der Baum scheint eine magische Aura auszustrahlen. Aber warum nur? "
    "Vielleicht gibt ja die Verzierung in seiner Rinde Aufschluss.");
  AddDetail( ({ "rinde" }),
    "In die Rinde des Baeumes scheint Jemand etwas eingeritzt zu haben.");
  AddDetail( ({ "verzierung" }),
    "Die Verzierung sieht eher aus wie ein schoen eingeritzter Hinweis.");
  AddDetail( ({ "aufschluss" }),
    "Vielleicht erfaehrst Du mehr, wenn Du den Hinweis in der "
    "Rinde des Baumes genauer untersuchst.");
  AddDetail( ({ "hinweis" }),
    "Du koenntest ihn lesen.");
  AddReadDetail( ({ "hinweis" }),
    "\n"
    "Jemand hat sich grosse Muehe gegeben, etwas in die Rinde "
    "des Baumes zu ritzen.\n"
    "Hier steht:\n"
    "Der Drache erwacht, in seiner Brust das Feuer brennt.\n"
    "Beschwoere ihn, locke ihn an,\n"
    "dies sei der Untergang der Welt...\n");
  AddDetail( ({ "jemand" }),
    "Du weisst nicht wer den Hinweis in den Baum geritzt hat.");
  AddDetail( ({ "wurzel" }),
    "Eine Wurzel des Baumes liegt frei.");
  AddDetail( ({ "vogel" }),
    "Du kannst hier keinen Vogel entdecken, Du kannst lediglich ab und zu "
    "einen singen hoeren.");
  AddDetail( ({ "grollen", "gesang" }),
    "Du kannst ihm lauschen!");
  
/*-----------------------GERAEUSCHE UND GERUECHE-----------------------*/

  AddSound(DEFAULT_SOUND,
    "Ab und zu kannst Du einen Vogel singen hoeren.");
  AddSound( ({ "vogel" }),
    "Ab und an kannst Du einen Vogel singen hoeren, doch manchmal "
    "scheint sich ein Grollen unter den Gesang zu mischen.");
  AddSound( ({ "gesang" }),
    "Ab und an vernimmst Du den wunderschoenen Gesang eines Vogels.");
  AddSound( ({ "grollen" }),
    "Vereinzelt scheint sich ein Grollen zwischen den Gesang zu mischen. "
    "Es scheint aus dem Inneren des Baumes zu kommen.");
  
/*---------------------ITEMS CMDS EXITS UND MAPPINGS---------------------*/

  AddCmd( ({ "schluepfe", "schluepf" }), "cmd_go");
  AddCmd( ({ "reisse", "reiss", "zerre", "zerr", "ziehe", "zieh" }),
    "cmd_wakeup");

  grundzustand();
  reisser = ([]);
}

reset()
{
  ::reset();
  reisser = ([]);
  drache  =    0;
  grundzustand();
  call_out("detail_checker", 0);
}

void grundzustand()
{
  muenzen_da =  1;
  heilung    =  1;
}

int cmd_go(string str)
{
  notify_fail(BS("Wohin moechtest Du schluepfen?"));
  if(!(str == "zurueck" || str == "durch loch zurueck"
    || str == "durch loch nach westen" || 
       str == "nach westen" 
    || str == "nach westen zurueck"))
  {
    return 0;
  }
    write(BS("Du schluepfst durch das Loch nach Westen zurueck."));
    TP->move(ROOM("verb_02"), M_GO | M_SILENT);
    tell_room(ENV(TP), TPN+" schluepft durch das Loch nach Westen "
    			   "zurueck.\n", ({TP}));
    return 1;
}

int cmd_wakeup(string str)
{
  string spieler;
  spieler=getuid(TP);
  notify_fail(BS("Woran moechtest Du ziehen?"));
  if(!(str == "an wurzel"))
  {
    return 0;
  }
  if(present("baum_drache", ENV(TP)) || (drache) || reisser[spieler, 0]>=3
    || TP->QueryProp(P_LEVEL)<40)
  {
    write(BS("Du zerrst an der Wurzel herum, doch leider scheint "
    	     "sich nichts zu tun. Vielleicht solltest Du es spaeter "
    	     "nocheinmal versuchen!"));
    return 1;
  }
  if(!member(reisser, spieler))
  {
     reisser+=([spieler: 0]);
  }
  if(reisser[spieler, 0]==0)
  {
    reisser[spieler, 0]++;
    write(BS("Du zerrst an der Wurzel herum, doch leider geschieht "
    	     "nichts! Vielleicht solltest Du es nocheinmal probieren!"));
    tell_room(ENV(TP), TPN+" zerrt an einer Wurzel des Baumes.\n", ({TP}));
    return 1;
  }
  if(reisser[spieler, 0]==1)
  {
    reisser[spieler, 0]++;
    write(BS("Ha! Die Wurzel loest sich etwas! Du solltest es nochmal "
    	     "probieren!"));
    tell_room(ENV(TP), TPN+" zerrt noch einmal an einer Wurzel des "
    			   "Baumes.\n", ({TP}));
    return 1;
  }
  if(reisser[spieler, 0]==2)
  {
    reisser[spieler, 0]++;
    drache = 1;
    TP->SetProp(P_PARALYZED, ([ PARALYZE_TIME: 9,
      PARALYZE_MSG:"Du kannst Dich nicht bewegen!\n",
      PARALYZE_MSG_OTHER:" kann sich nicht bewegen!\n",
      PARALYZE_END:"",
      PARALYZE_END_OTHER:"" ]));
   delayedwrite(TP, 0, ({
     0, "Mit aller Kraft zerrst Du ein letztes Mal an der Wurzel.",
     0, "@@room_msg1@@",
     2, "#Ploetzlich beginnt sich etwas im Inneren des Baumes zu bewegen.",
     0, "@@room_msg2@@",
     4, "#Ein unglaubliches Beben erfuellt den Raum.",
     0, "@@room_msg3@@",
     4, "#Mit einem gewaltigen Knall explodiert der Baum in der Mitte der "
     	"Wiese und ein Drache kommt zum Vorschein.",
     0, "@@room_msg4@@",
     4, "#Du scheinst einen schlafenden Baumdrachen geweckt zu haben.",
     0, "@@room_msg5@@",
     2,	"#Lauf so schnell Du kannst!",
     2, "@@arrive@@"}));
     return 1;
   }
}

string room_msg1()
{
  tell_room(ENV(TP), TPN+" zerrt noch einmal kraeftig an einer Wurzel "
  		         "des Baumes.\n", ({TP}));
  return "";
}

string room_msg2()
{
  tell_room(ENV(TP), "Ploetzlich beginnt sich etwas im Inneren des "
  		     "Baumes zu bewegen.\n", ({TP}));
  return "";
}

string room_msg3()
{
  tell_room(ENV(TP), "Ein unglaubliches Beben erfuellt den Raum.\n", ({TP}));
  return "";
}

string room_msg4()
{
  tell_room(ENV(TP), "Mit einem gewaltigen Knall explodiert der Baum in der "
  		     "Mitte der Wiese und ein Drache kommt zum "
  		     "Vorschein.\n", ({TP}));
  return "";
}

string room_msg5()
{
  tell_room(ENV(TP), TPN+" scheint einen schlafenden Baumdrachen geweckt "
  			 "zu haben.\n", ({TP}));
  return "";
}

string arrive()
{
  TO->SetProp(P_INT_LONG, 
    "Du befindest Dich im Kristallwald.\n"
    "Du stehst hier auf einer kreisrunden, kristallinen Wiese, die "
    "von zahlreichen Baeumen und Gewaechsen begrenzt wird. In ihrer "
    "Mitte kannst du ein tiefes Loch erkennen. Das Gras funkelt "
    "und glitzert im Sonnenlicht.");
  RemoveDetail( ({ "wiese",
   		   "mitte",
   		   "baum",
   		   "aura",
   		   "rinde",
   		   "verzierung",
   		   "aufschluss",
   		   "hinweis",
   		   "jemand",
   		   "wurzel"}));
  RemoveReadDetail( ({ "hinweis" }) );
  AddDetail( ({ "wiese" }),
    "Du stehst auf der kreisrunden, kristallinen Wiese. "
    "Das kristalline Gras funkelt und glitzert im Sonnenlicht. "
    "In ihrer Mitte kannst Du ein tiefes Loch erkennen.");
  AddDetail( ({ "mitte" }),
    "In der Mitte der Wiese befindet sich ein tiefes Loch.");
  AddDetail( ({ "loch" }),
    "In dem Loch scheint einmal ein hoher Baum gestanden zu haben. "
    "Doch jetzt kannst Du nurmehr vereinzelte Wurzelstuecke in der "
    "Erde entdecken.");
  AddDetail( ({ "wurzelstuecke", "stuecke" }),
    "Vereinzelte Wurzelstuecke liegen in der Erde. Eines leuchtet etwas.");
  AddDetail( ({ "erde" }),
    "Ein tiefes Loch befindet sich in der Mitte der Wiese. Tiefbraune "
    "Erde und dazwischen ein paar Wurzelstuecke ist alles was Du "
    "erkennen kannst.");
  AddDetail( ({ "baum" }),
    "Allem Anschein nach hat einmal ein hoher Baum hier in dem Loch "
    "gestanden. Was mit ihm wohl passiert ist?");
  AddDetail( ({ "anschein" }),
    "Es wird wohl so gewesen sein. Anders kannst Du Dir die vereinzelten "
    "Wurzelstuecke nicht erklaeren, die hier so zwischen der Erde im "
    "Loch herumliegen.");
  AddDetail( ({ "stueck", "wurzelstueck" }),
    "Eines der Wurzelstuecke in dem Loch scheint etwas zu leuchten. "
    "Vielleicht solltest Du es mal beruehren.");
  
  AddCmd( ({ "beruehre", "beruehr" }), "cmd_find");
  AddItem(NPC("baum_drache"), REFRESH_NONE);
  return "";
}

void delayedwrite(object spieler, int curpos, mixed *daten)
{
  string output;
  if (!spieler) return;
  
  output = process_string(daten[curpos+1]);
  if (output[0] == 35) {
    tell_object(spieler, "\n");
    tell_object(spieler, BS(output[1..]));
  } else {
    tell_object(spieler, BS(output));
  }
  if (curpos + 2 < sizeof(daten))
    call_out("delayedwrite", daten[curpos+2], spieler, curpos+2, daten);
}

int cmd_find(string str)
{
  notify_fail(BS("Was moechtest Du denn beruehren?"));
  if(!(str == "wurzelstueck" || str == "stueck"))
  {
    return 0;
  }
  if(present("baum_drache", ENV(TP)))
  {
    write(BS("Du kommst nicht an die Wurzel ran, da Dir der Drache "
    	     "den Weg versperrt."));
    return 1;
  }
  if(muenzen_da && heilung)
  {
    write(BS("Du beruehrst die leuchtende Wurzel. Ploetzlich fuehlst "
    	     "Du Dich etwas reicher als zuvor."));
    TP->AddMoney(1+random(50000));
    muenzen_da=0;
    return 1;
  }
  if(!muenzen_da && heilung)
  {
    write(BS("Du beruehrst die leuchtende Wurzel und scheinst Dich "
    	     "vollstaendig zu regenerieren."));
    TP->AddSp(400);
    TP->AddHp(400);
    heilung=0;
    return 1;
  }
  if(muenzen_da && !heilung)
  {
    write(BS("Du beruehrst die leuchtende Wurzel. Ploetzlich fuehlst "
    	     "Du Dich etwas reicher als zuvor."));
    TP->AddMoney(1+random(50000));
    muenzen_da=0;
    return 1;
  }
  if(!muenzen_da && !heilung)
  {
    write(BS("Du beruehrst die leuchtende Wurzel, doch leider "
    	     "scheint nichts zu passieren..."));
    return 1;
  }
}

void detail_checker()
{
  RemoveDetail( ({ "wiese",
  		   "mitte",
  		   "loch",
  		   "wurzelstuecke",
  		   "stuecke",
  		   "baum",
  		   "erde",
  		   "anschein"
  		   "wurzelstueck",
  		   "stueck" }));
  RemoveCmd( ({ "beruehre", "beruehr" }));
  call_out("detail_checker_1", 0);
}

