inherit "p/std/dragons/dragon";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <defines.h>
#include <moredef.h>
#include "../kwald.h"
#include "../def.h"

#define KILLLOG "/d/kristallwald/kolmey/siedlung/kill.log"

create()
{ 
int zufall;
object ob;

if(!is_clone(this_object())) return;
  
::create();    
  
  set_living_name("artifoxlas");
  SetProp(P_NAME, "Artifoxlas");
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME_ADJ, 0);
  create_default_dragon(5,12,1,25);
  SetProp(P_SHORT, "Artifoxlas, der Baumdrache");
  SetProp(P_RESISTANCE_STRENGTHS, QueryProp(P_RESISTANCE_STRENGTHS)+
      ([DT_WATER: -0.5, DT_FIRE: 0.5, DT_HOLY: 1.0, DT_UNHOLY: -1.0]));
  AddId( ({ "artifoxlas", "baum_drache" }) );
  SetProp(P_LONG, 
      "Artifoxlas, der Baumdrache ist ein gewaltiger Drache. "
      "Er scheint schon uralt zu sein, die Lebenserfahrung "
      "steht in seinen Augen wie in einem offenen Buch. Nichts "
      "desto trotz besitzt Artifoxlas gewaltige Klauen mit "
      "messerscharfen Krallen bestueckt und aus seinem Maul funkeln "
      "Dir spitze, scharfe Zaehne entgegen. Artifoxlas scheint Dir "
      "weit ueberlegen zu sein.");
  AddDetail( "drache", TO->QueryProp(P_LONG));
  AddDetail( ({ "lebenserfahrung", "erfahrung" }),
    "Die Lebenserfahrung steht in Artifoxlas' Augen wie in einem "
    "Buch geschrieben.");
  AddDetail( ({ "augen" }),
    "Fuer einen Drachen hat Artifoxlas erstaunlich guetige Augen.");
  AddDetail( ({ "maul", "zaehne" }),
    "Artifoxlas' Maul ist mit spitzen Zaehnen bestueckt.");
  AddDetail( ({ "klauen", "krallen" }),
    "Artifoxlas hat gewaltige Klauen mit scharfen Krallen.");
  
  SetProp(P_SPELLRATE, 45);
  
  //    Beschreibung
 
//    -------------
//    create_default_dragon(a,b,c,d);
//    a...DrachenLevel  Wert:1-5
//    b...DrachenAlter  Wert:1-12
//    c...Alignment     Wert:0/1
//    d...Schuppen      Wert:0-..
//   --------------  
//   
//   zu a,c:
//   
//   Die DrachenLevel sind Alignmentabhaengig (gut/boese) unterteilt in:
//    
//       |   # Gut         |    # Boese
//    *1 | Kupfer Drachen  | Schwarzer Drachen  
//    *2 | Bronze Drachen  | Weisser Drachen
//    *3 | Messing Drachen | Gruener Drachen
//    *4 | Silber Drachen  | Blauer Drachen
//    *5 | Gold Drachen    | Roter Drachen
//  
//     *...Wert a    #...Wert c
//   -------------- 
//   
//   zu b:
//   
//   Weiters gibt es noch 12 Altersabstufungen, und zwar:
//    
//                kundig erfahren weise
//    jung      |   1   |   2    |  3   |
//    erwachsen |   4   |   5    |  6   |
//    alt       |   7   |   8    |  9   |
//    steinalt  |  10   |  11    | 12   | 
//   --------------
//   
//   zu d:
//   
//   Dieser Wert legt fest wieviele Drachenschuppen ein Drache
//   bei sich traegt. (..werden benoetigt um bei Schmieden versch.
//   DrachenRuestungsTeile fertigen zu lassen.)
//  
//   Momentan Beschraenkungen noch nicht festgelegt!
//   (mal schaun...)
//   ----------------
//   
//   Es werden jetzt allerhand Props festgelegt, die auf den Drachen
//   abgestimmt sind. Eigentlich sollte man nur mehr (wenn man will)
//   Die P_LONG umsetzen. 
//   Sollte man Ruestungsteile reinclonen?! Mal ueberlegen...
//   Geld kann man reinclonen wenn man will...
 
}

void die(int poisondeath)
{
   write_file(KILLLOG, ctime()+": "+CAP(getuid(TP))+" killt Artifoxlas.\n");
   if(!IS_LEARNER(TP))
   domainshout(CAP(TP->Name())+" hat Artifoxlas, den Baumdrachen bezwungen.\n");
   ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(KILLLOG, dtime()+": Artifoxlas toetet "+CAP(getuid(player))+" ("+lostexp+")\n");
}

