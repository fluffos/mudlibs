/* 
** Der Chef der Gauklerzwerge                          07.10.2001 Kolmey@SL
** 
** Update              Version   Comments
** ------------------------------------------------------------------------
** 0000-00-00            1.0     Release
**
**
*/

inherit "std/npc";
inherit "std/npc/spells";

#include <npc.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include <mnpc.h>
#include <class.h>


void create()

{
 
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_NAME, "Tilco");
  SetProp(P_SHORT, "Tilco, der Chef der Gauklerzwerge" );
  SetProp(P_LONG,
    "Tilco ist ca. 1.20 gross und traegt wie "
    "die meisten Zwerge einen Bart. Er ist von kraeftiger Statur "
    "und hat in seinen vielen Reisen bestimmt oft genug seine "
    "Kampfkraft unter Beweis stellen muessen.");
  set_living_name("tilco");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"zwerg", "gauklerzwerg", "chef", "tilco"}));
  
  AddDetail( ({ "bart" }),
    "Typisch fuer Zwerge hat auch dieser Gauklerzwerg einen langen Bart.");
  AddDetail( ({ "zwerge" }),
    "Naja, zumindest erkennst Du es schonmal an seinem Geruch.");
  AddDetail( ({ "geruch" }),
    "Zwerge stinken ja im allgemeinen, und dieser hier stinkt auch ziemlich "
    "erbaermlich.");
  AddDetail( ({ "kampfkraft" }),
    "Versuch mal gegen ihn zu kaempfen, dann wirst Du sehen wie stark "
    "er ist.");
  AddDetail( ({ "reisen" }),
    "Die Gauklerzwerge bereisten sicherlich schon das ganze Land.");
  AddDetail( ({ "statur" }),
    "Tilco ist von sehr kraeftiger Statur.");
  
  create_default_npc(25);
  SetProp(P_RACE, "Zwerg");
  SetProp(P_HANDS, ({" mit seinen kleinen, kraeftigen Haenden", 
  		     120, DT_BLUDGEON}));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_BODY, 150);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_ALIGN, 200);
  SetProp(P_WIMPY, 0);
  SetProp(P_HEAL, 0);
  SetProp(P_SIZE, 120);
  
  SetProp(P_DIE_MSG, " stirbt.\n");
  SetProp(P_MURDER_MSG, "Mein Geruch wird Dich verfolgen, "+TPN+"!");
  SetProp(P_KILL_MSG, "Man sollte eben keine Gauklerzwerge unterschaetzen!");
  SetProp(P_KILL_NAME, "Tilco, der Chef der Gauklerzwerge");
  
  SetAttackChats(2, ({
    "Wie willst DU es schaffen mich zu besiegen?\n"
    }) );
  
  AddInfo(DEFAULT_INFO, ({
    "sagt: Leider habe ich auf meinen Reisen nichts darueber gehoert.\n"}) );
  
  AddInfo( ({ "tochter" }),
    "Meine kleine Tochter heisst Felonie.", "sagt: ");
  AddInfo( ({ "felonie" }),
    "Felonie ist meine Tochter. Sie ist nicht mehr die selbe, seit ihre "
    "Mutter vor einiger Zeit starb. Und jetzt hat sie auch noch ihre "
    "um alles in der Welt geliebte Puppe verloren. Ach was soll ich nur "
    "machen", "seufzt: ");
  AddInfo( ({ "puppe" }),
    "Felonies liebstes Spielzeug war ihre Puppe, doch vor zwei Tagen "
    "als wir in den Kristallwald einfuhren, verlor sie ihre Puppe und "
    "niemand hat sie mehr gesehen. Jetzt ist die Kleine ganz traurig "
    "und ich weiss nicht mehr was ich tun soll.", "sagt: ");
  AddInfo( ({ "mutter" }),
    "Felonies Mutter kam bei einem Unglueck um, dass sich vor einiger Zeit "
    "auch hier im Kristallwald ereignete.", "seufzt: ");
  AddInfo( ({ "unglueck" }),
    "Das Unglueck geschah als wir von den gefuerchteten Kristalldieben "
    "angegriffen wurden. Wir konnten sie in die Flucht schlagen, doch "
    "sie haben bei dem Angriff meine Frau und Mutter von Felonie "
    "getoetet.", "erzaehlt: ");
  AddInfo( ({ "diebe", "kristalldiebe" }),
    "Die gefuerchteten Kristalldiebe treiben irgendwo im Kristallwald "
    "versteckt ihr unwesen. Sie sind sehr gut versteckt und noch niemand "
    "hat bisher ihr Versteck entdecken koennen.", "sagt: ");
  AddInfo( ({ "versteck" }),
    "Es gibt niemanden der in der Lage ist, ihr Versteck zu finden. "
    "Sie beherrbergen einen Magier, der es durch Magie verbirgt. "
    "Die einzige die es schaffen koennte, waere Dhala, die Meisterin "
    "der Waldelfen.");
  AddInfo( ({ "magier" }),
    "Ich selbst habe ihn noch nie gesehen. Man erzaehlt sich nur, dass "
    "dieser niemals mit in den Kampf zieht. Er ist einzig und allein "
    "dafuer da, das Versteck zu tarnen.", "erklaert: ");
  AddInfo( ({ "kampf" }),
    "Wir Gauklerzwerge sind ein friedfertiges Voelkchen. Wir kaempfen "
    "nicht gerne, obwohl ich uns nicht unterschaetzen wuerde. Wir haben "
    "viele Kaempfe hinter uns, die auf unseren langen Reisen unvermeidlich "
    "waren.", "sagt: ");
  AddInfo( ({ "reisen" }),
    "Wir waren schon ueberall im Silberland!", "sagt: ");
  AddInfo( ({ "silberland" }),
    "Wir haben schon alle Teile bereist, sag ich Dir!", "sagt: ");
  AddInfo( ({ "teile" }),
    "Tijara, Midas, Kyranda, Felonia, Elessar, Dhrkion und sogar "
    "Smoersky und das Xandim Dorf haben wir bereist.", "erzaehlt stolz: ");
  AddInfo( ({ "tijara" }),
    "Im fernen Tijara ist es sehr heiss, dort befindet sich der Dschungel "
    "und auf den Plantagen des Gouverneurs wachsen herrliche "
    "Fruechte!", "erzaehlt: ");
  AddInfo( ({ "dschungel" }),
    "Dort ist es bestimmt gefaehrlich, wir waren ja nicht direkt drinnen "
    "sind aber daran vorbei gereist.", "sagt: ");
  AddInfo( ({ "plantagen" }),
    "Auf den Plantagen des Gouverneurs gedeien herrliche "
    "Fruechte!", "sagt: ");
  AddInfo( ({ "fruechte" }),
    "Mangos, Bananen, Papayas und sogar die seltene Brotfrucht gedeit "
    "dort!", "sagt: ");
  AddInfo( ({ "mangos", "mango", "bananen", "banane", "papaya", 
  	        "papayas" }),
    "Das sind alles herrliche Fruechte, nur erwischen darf Dich keiner, wenn "
    "Du eine stiehlst", "sagt: ");
  AddInfo( ({ "brotfrucht" }),
    "Das ist eine sehr seltene Frucht, die so aussieht und sogar so schmeckt "
    "wie Brot!", "erklaert: ");
  AddInfo( ({ "brot" }),
    "Ja, genau! Die Brotfrucht!", "sagt: ");
  AddInfo( ({ "gouverneur" }),
    "Der geizige Gouverneur jammert immer wegen der Rattenplage!", 
    "kichert: ");
  AddInfo( ({ "rattenplage" }),
    "Haha geschieht ihm ganz recht!", "lacht: ");
  AddInfo( ({ "midas" }),
    "Midas ist des Silberlands Hauptstadt! Dort wohnen die Menschen und "
    "es herrscht reges Treiben.", "erzaehlt: ");
  AddInfo( ({ "hauptstadt" }),
    "Damit kannst Du nur Midas meinen!", "sagt: ");
  AddInfo( ({ "menschen" }),
    "Ein seltsames Voelkchen!", "sagt: ");
  AddInfo( ({ "voelkchen" }),
    "Welches meinst Du?", "fragt: ");
  AddInfo( ({ "treiben" }),
    "Reger Handel wird in Midas betrieben. Es ist eine sehr turbolente "
    "Stadt!", "sagt: ");
  AddInfo( ({ "stadt" }),
    "Welche Stadt meinst Du?", "fragt: ");
  AddInfo( ({ "handel" }),
    "In Midas wird alles moegliche verkauft.", "erzaehlt: ");
  AddInfo( ({ "kyranda" }),
    "Kyranda ist eine einzige, riesige Burg! Dort werden Soldaten ausgebildet "
    "fuer den Fall das es mal zu einem Krieg zwischen den Menschen "
    "und den Orks kommt.", "erklaert: ");
  AddInfo( ({ "burg" }),
    "Kyranda ist eine Burg.", "sagt: ");
  AddInfo( ({ "soldaten" }),
    "Soldaten von allen Raengen sind dort zu finden.", "sagt: ");
  AddInfo( ({ "raenge" }),
    "Vom Webel bis zum Oberleutnant.", "sagt: ");
  AddInfo( ({ "webel", "oberleutnant" }),
    "So gut kenne ich mich dann damit auch nicht aus.", "sagt: ");
  AddInfo( ({ "krieg", "fall" }),
    "Krieg ist etwas graussames, wo es keine Gewinner gibt.", "erklaert: ");
  AddInfo( ({ "gewinner" }),
    "Die gibt es in einem Krieg nicht!", "sagt: ");
  AddInfo( ({ "orks", "ork" }),
    "Auf meinen zahlreichen Reisen habe ich noch nie einen Ork "
    "gesehen, aber sie sollen brutale Bestien sein!", "erzaehlt: ");
  AddInfo( ({ "bestien" }),
    "Man erzaehlt sich die Orks seien Bestien.", "erklaert: ");
  AddInfo( ({ "felonia" }),
    "Felonia ist unsere Heimatstadt. Die Stadt der Zwerge. Sie liegt "
    "tief unten im Gebirge, halt da wo sich ein Zwerg wohlfuehlt. "
    "In Felonia werden die besten Semmeln und Salzstangerl im ganzen "
    "Land gebacken.", "freut sich: ");
  AddInfo( ({ "heimatstadt" }),
    "Da kannst Du nur Felonia meinen!", "sagt: ");
  AddInfo( ({ "zwerge", "zwerg" }),
    "Wir Zwerge leben in Felonia, einer Stadt die sich im Gebirge "
    "befindet. Wir sind hervorragende Schuerfer und lieben alles "
    "Metall und Gestein. Manche Leute behaupten, wir wuerden stinken, "
    "aber das sind Ignoranten!", "sagt: ");
  AddInfo( ({ "gebirge" }),
    "Das Gebirge befindet sich noerdlich von Midas.", "sagt: ");
  AddInfo( ({ "schuerfer" }),
    "Wir Zwerge lieben es in Minen zu arbeiten.", "erzaehlt: ");
  AddInfo( ({ "minen" }),
    "Im Gebirge gibt es reichlich davon.", "sagt: ");
  AddInfo( ({ "metall" }),
    "Wir lieben alle Arten von Metall, besonders aber Gold!", "sagt: ");
  AddInfo( ({ "gestein" }),
    "Wir lieben alle Arten von Gestein.", "sagt: ");
  AddInfo( ({ "arten" }),
    "Alle Arten davon.", "sagt: ");
  AddInfo( ({ "gold" }),
    "Gold ist ein sehr schoenes und teures Metall.", "strahlt: ");
  AddInfo( ({ "leute", "ignoranten" }),
    "Leute, die behaupten, wir wuerden stinken, sind Ignoranten.",
    "meint: ");
  AddInfo( ({ "elessar" }),
    "In Elessar leben die Astlochfetischisten! Elessar befindet sich "
    "in den Baeumen wo diese Elfen auch hingehoeren!", "sagt: ");
  AddInfo( ({ "astlochfetischisten" }),
    "Damit meine ich die Elfen, die beim blossen Anblick eines Astlochs " 
    "schon die Nerven verlieren und sich den ganzen Tag freuen.", "lacht: ");
  AddInfo( ({ "anblick", "nerven", "tag" }),
    "lacht.");
  AddInfo( ({ "elfen" }),
    "Elfen sind unsere eigentlich Feinde, aber wir haben es geschafft "
    "irgendwie mit ihnen auszukommen.", "erzaehlt: ");
  AddInfo( ({ "feinde" }),
    "Das ist eine lange Geschichte, die Dir der Biblothekar Aerendil in "
    "Elessar sicherlich gerne erzaehlt.", "sagt: ");
  AddInfo( ({ "geschichte" }),
    "Rede mit Aerendil darueber, ich habe keine Lust meine kostbare "
    "Zeit mit Geschichten ueber Elfen zu vergeuden.", "sagt empoert: ");
  AddInfo( ({ "lust", "geschichten" }),
    "Ich habe dazu keine Lust!", "sagt: ");
  AddInfo( ({ "aerendil", "bibliothekar" }),
    "Aerendil der Bibliothekar lebt in Elessar.", "sagt: ");
  AddInfo( ({ "baeume" }),
    "Elessar wurde in den Baeumen errichtet.", "erklaert: ");
  AddInfo( ({ "smoersky", "xandim dorf", "dorf", "xandim" }),
    "Smoersky und das Xandim Dorf befinden sich in der Region Polar. "
    "Dort ist es ziemlich kalt. Wir waren nicht lange dort, weil "
    "wir die Kaelte nicht moegen.", "erzaehlt: ");
  AddInfo( ({ "region", "polar", "kaelte" }),
    "bibbert.");
  
  SUID;
  CLONEME( "/d/gebirge/dusty/zwerge/obj/zkaxt" );
  CLONEME( "/p/armour/lederstiefel" );
  CLONEME( "/d/gebirge/dusty/zwerge/obj/zpanzer" );
  CLONEME( "/d/gebirge/dusty/zwerge/obj/zhose" );
  command("trage alles");
  command("zuecke axt");
  
}                                      