inherit "std/npc";
inherit "std/npc/spells";

#include <npc.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include <mnpc.h>
#include <class.h>


void create()

{
 
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_NAME, "Gauklerzwerg");
  SetProp(P_SHORT, "Ein Gauklerzwerg" );
  SetProp(P_LONG,
    "Ein kleiner Gauklerzwerg. Er ist etwa 1.20 gross und traegt, typisch "
    "fuer einen Zwerg einen langen Bart. Er blickt grimmig drein und "
    "beobachtet das bruzelnde Huehnchen.");
 
  AddDetail( ({ "bart" }),
    "Tapisch fuer Zwerge hat auch dieser Gauklerzwerg einen langen Bart.");
  AddDetail( ({ "zwerge" }),
    "Naja, zumindest erkennst Du es schonmal an seinem Geruch.");
  AddDetail( ({ "geruch" }),
    "Zwerge stinken ja im allgemeinen, und dieser hier stinkt auch ziemlich "
    "erbaermlich.");
  set_living_name("gauklerzwerg");
  
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  AddId(({"zwerg", "gauklerzwerg"}));
  
  create_default_npc(15);
  SetProp(P_RACE, "Zwerg");
  SetProp(P_HANDS, ({" mit seinen kleinen Haenden", 100, DT_BLUDGEON}));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_BODY, 100);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_ALIGN, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_HEAL, 0);
  SetProp(P_SIZE, 120);
  
  SetProp(P_DIE_MSG, " stirbt.\n");
  SetProp(P_MURDER_MSG, "Mein Geruch wird Dich verfolgen, "+TPN+"!");
  SetProp(P_KILL_MSG, "Man sollte eben keine Gauklerzwerge unterschaetzen!");
  SetProp(P_KILL_NAME, "Ein Gauklerzwerg");
  
  SetAttackChats(2, ({
    "Meine Freunde werden mir helfen!\n"
    }) );
  
  SUID;
  CLONEME( "/d/gebirge/angrox/obj/zwergenaxt" );
  CLONEME( "/p/armour/lederstiefel" );
  CLONEME( "/d/gebirge/angrox/obj/kettenhemd" );
  command("trage alles");
  command("zuecke axt");
  
}                                      