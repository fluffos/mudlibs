#include "../kwald.h"

inherit "std/npc";

void create()
{ 
  if(!is_clone(TO)) return;
  ::create();
  
  AddId(({"fuchs","schwarzfuchs"}));

  SetProp(P_SHORT, "Ein Schwarzfuchs");
  SetProp(P_LONG,
	  BS("Vor Dir steht ein Schwarzfuchs. Der hat seinen "
	     "Namen nicht umsonst - sein Fell ist tiefschwarz mit "
	     "metallisch glaenzenden Fasern."));
  
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Fuchs");
  SetProp(P_NAME, "Schwarzfuchs");
  
  SetProp(P_SOUND, BS("Er knurrt leise..."));
  SetProp(P_SMELL, BS("Der Fuchs riecht irgendwie abstossend."));

  create_default_npc(13);
  
  SetProp(P_ALIGN, -150);
  SetProp(P_SIZE, 110);
  SetProp(P_WEIGHT, 35243);
  SetProp(P_HEAL, 10);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_TRANSPARENT, 0);

  SetProp(P_MAX_HANDS, 4);

  SetProp(P_HANDS, ({" mit seinem scharfen Gebiss", 135, DT_RIP}));

  SUID;

  CLONEME("/d/kristallwald/sargola/wald/obj/fuchsf");
  command_me("ziehe fell an");

  SetAttackChats(3, ({
    "Du kannst das Fell des Fuchses nicht durchdringen!\n", 
      "Der Fuchs zischt Dich an.\n",
      "Der Fuchs zerquetscht Dir Deine Wade.\n"}));
  
  SetProp(P_DIE_MSG, " heult markerschuetternd auf und ist dann ruhig.\n");
  
  SetProp(P_DEFAULT_INFO, "beachtet Dich gar nicht.\n");

  AddDetail(({"faser","fasern"}),
	    "Die Fasern geben ihm ein machtvolles, aber auch gefaehrliches "
	    "Aussehen.");
  AddDetail("fell",
	    "Es scheint aus Onyx zu bestehen.\n");
  AddDetail("onyx", 
	    "Onyx ist schwarz mit einem metallischen Glaenzen "
	    "- so wie das Fell des Fuchses.");
  AddDetail("glaenzen", 
	    "Es soll wohl Gegner abschrecken...");

  SetProp(P_REJECT, ({REJECT_DROP,"Der Fuchs hat genug Dinge bei sich.\n" }));
  
  AddInfo("sargola", BS("Der hat mich programmiert."), "grummelt: ");

  SetChats(3, ({ 
    "Der Fuchs schnofelt in Blaettern herum.\n",
      "Der Fuchs schnofelt an Dir herum.\n",
      "Der Fuchs ist auf der Jagd.\n"}));
} 
