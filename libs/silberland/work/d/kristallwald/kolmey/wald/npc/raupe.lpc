inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "../kwald.h"
#include "/d/ebene/hotaru/hotaru.h"

varargs void playseq(object ob, mixed sequence);

init()
{
  ::init();
  if(interactive(TP)) call_out("poison", 6);
}

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  AddId( ({ "raupe" }) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Raupe");
  SetProp(P_SHORT, "Eine kleine Raupe");
  SetProp(P_ARTICLE, 1);
  SetProp(P_LONG, 
    "Du erblickst eine kleine, giftgruene Raupe. Sie ist nicht groesser "
    "als ein Fingernagel und trotzdem entdeckst Du sie sofort. Ihre "
    "giftgruene Farbe laesst sogar das Gruen des Waldes noch verblassen.");
  
  create_default_npc(5);
  SetProp(P_ALIGN, 0+random(50));
  SetProp(P_SIZE, 2);
  SetProp(P_RACE, "Kaefer");
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_HANDS, ({" mit ihrem Giftstachel", 30, DT_POISON}) );
  SetProp(P_BODY, 10);
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.3, DT_COLD:      0.0, DT_WATER:       0.5
     , DT_AIR:       0.1, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.5, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.1, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0]));
  
  SetProp(P_REJECT, ({ REJECT_DROP,
    "Die Raupe kann nichts tragen!\n" }) );
  
  SetProp(P_DIE_MSG, " stirbt.\n");
  SetProp(P_KILL_NAME, "Eine kleine Raupe");
}

void poison()
{	
  if(!present(ENV(TO)))
  {
    return 0;
  }
  playseq(TP, ({ "",
    "$Die kleine Raupe kriecht zu Dir her.°°°°°°",
    "$Die kleine Raupe kommt naeher zu Dir heran.°°°°°°",
    "$Die kleine Raupe krabbelt auf Deinen Zeh.°°°°°°",
    "$Die kleine Raupe sticht Dich mit ihrem Stachel in den grossen Zeh "
    "und vergiftet Dich.",
    "@@vergiften@@"}));
}

string vergiften()
{
  TP->AddPoison(2);
  return "";
}

varargs void playseq(object ob, mixed sequence) {
  int trenner, waittime;
  string curline, general, personal;
  if(!ob) return;
  if(present(ob, ENV(TO))) {
    
    if (pointerp(sequence)) {
      if (sizeof(sequence) == 0) return;
      curline = sequence[0];
    } else {
      curline = sequence;
    }
    
    waittime = strstr(curline, "°", 0);
    if (waittime == -1) {
      waittime = 0;
    } else {
      waittime = (strlen(curline) - waittime) * 2;
      curline = curline[0..strstr(curline, "°", 0)-1];
    }
    
    curline  = process_string(curline);
    curline  = regreplace(curline,  "@ME",     TO->Name(WER, 1),    1);
    curline  = regreplace(curline,  "@NAME",   ob->Name(WER, 1),    1);
    
    trenner = strstr(curline, "§", 0);
    if (trenner != -1) {
      general = curline[0..trenner-1];
      personal = curline[trenner+1..];
    } else {
      general = personal = curline;
    }
    
    general  = regreplace(general,  "@WER",    ob->Name(WER, 1),    1);
    general  = regreplace(general,  "@WESSEN", ob->Name(WESSEN, 1), 1);
    general  = regreplace(general,  "@WEM",    ob->Name(WEM, 1),    1);
    general  = regreplace(general,  "@WEN",    ob->Name(WEN, 1),    1);
    
    personal = regreplace(personal, "@WER",    "Du",                1);
    personal = regreplace(personal, "@WESSEN", "Dein",              1);
    personal = regreplace(personal, "@WEM",    "Dir",               1);
    personal = regreplace(personal, "@WEN",    "Dich",              1);

    if (personal != "") tell_object(ob, MyBS(personal));
    if (general  != "") tell_room(ENV(TO), MyBS(general), ({ob,this_object()}));
    
    if (pointerp(sequence)) {
      if (sizeof(sequence) == 1) return;
      call_out("playseq", waittime, ob, sequence[1..]);
    }
  }
}
