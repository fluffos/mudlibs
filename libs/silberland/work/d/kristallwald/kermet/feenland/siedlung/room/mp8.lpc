#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/kristallwald/kermet/feenland/siedlung/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Auf einer Waldlichtung");
  SetProp (P_INT_LONG,
    "Du stehst am suedlichen Rand einer Lichtung. Rund um dich herum "+
    "hoerst du es rascheln, so, als ob sich viele kleine Kaefer, Ameisen "+
    "und andere Tiere ihren Weg durch das Gras bahnen wuerden.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"rand"}),
    "Suedlicher Rand bedeutet, dass die Lichtung nach Sueden NICHT "+
    "weitergeht.");
  AddDetail ( ({"sueden"}),
    "Im Sueden ist der Wald.");
  AddDetail ( ({"lichtung"}),
    "Eine Lichtung ist ein Platz im Wald, wo die Baeume nicht so dicht "+
    "stehen.");
  AddDetail ( ({"platz"}),
    "Du stehst darauf.");
  AddDetail ( ({"wald"}),
    "Der Wald umgibt die Lichtung.");
  AddDetail ( ({"baeume"}),
    "Baeume umsaeumen die Lichtung auf allen Seiten.");
  AddDetail ( ({"seite", "seiten"}),
    "Alle Seiten der Lichtung kannst du von hier aus erkennen, da die "+
    "Lichtung nicht sehr gross ist.");
  AddDetail ( ({"baum"}),
    "Bei so vielen Baeumen kannst du einen nicht vom anderen "+
    "unterscheiden.");
  AddDetail ( ({"eine", "einen"}),
    "Ja, das ist der Eine. :-)");
  AddDetail ( ({"andere", "anderen"}),
    "Ja, das ist der Andere. :-)");
  AddDetail ( ({"kaefer"}),
    "Du siehst hier Kaefer in unterschiedlichsten Groessen, Farben und "+
    "Formen.");
  AddDetail ( ({"groesse", "groessen"}),
    "Die Groesse der Kaefer ist in allen Variationen vertreten.");
  AddDetail ( ({"variation", "variationen"}),
    "Nun ja, von klein bis mittelgross.");
  AddDetail ( ({"farbe", "farben"}),
    "Die Farbe der Kaefer reicht von einfachem Schwarz bis zu den "+
    "schillerndsten Mustern.");
  AddDetail ( ({"schwarz"}),
    "Schwarz wie die Nacht.");
  AddDetail ( ({"nacht"}),
    "Ja, in der Nacht erkennt man die schwarzen Kaefer fast nicht.");
  AddDetail ( ({"form", "formen"}),
    "Es gibt lange, kurze, dicke, duenne ...");
  AddDetail ( ({"dick", "dicke", "duenn", 
                "duenne", "kurz", "kurze", 
                "lang", "lange"}),
    "Egal, welche Form sie haben, alle sind sie Kaefer.");
  AddDetail ( ({"ameise", "ameisen"}),
    "Sie laufen hier massenhaft herum.");
  AddDetail ( ({"tier", "tiere"}),
    "Ameisen, Kaefer und dergleichen.");
  AddDetail ( ({"weg"}),
    "Einen richtigen Weg gibt es hier auf der Lichtung eigentlich gar "+
    "nicht.");
  AddDetail ( ({"gras"}),
    "Das Gras ist hier ueberall kniehoch.");
  AddDetail ( ({"boden"}),
    "Der Boden ist hier ueberall von Gras bedeckt.");
  AddDetail ( ({"himmel"}),
    "Der Himmel ist strahlend blau.");
  AddDetail ( ({"muster"}),
    "Die Muster auf den Kaefern sehen echt toll aus.");
  AddDetail ( ({"nicht"}),
    "`Nicht` ist hier nur ausnahmsweise gross geschrieben. Man kann es "+
    "also nicht wirklich untersuchen.");
  // DETAILS END

  // EXITS START
  AddExit ("osten", "./mp9");
  AddExit ("westen", "./mp7");
  AddExit ("nordwesten", "./mp4");
  AddExit ("norden", "./mp5");
  AddExit ("nordosten", "./mp6");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
