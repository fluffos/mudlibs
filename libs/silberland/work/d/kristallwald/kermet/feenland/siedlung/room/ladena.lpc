#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/kristallwald/kermet/feenland/siedlung/room/"+x)
#endif

inherit "std/laden";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Ein Laden der Feen.");
  SetProp (P_INT_LONG,
    "Du befindest dich nun in einem Laden der Feen. Er ist ziemlich "+
    "einfach gehalten, schmucklos, aber erfuellt seinen Zweck. Der Zweck "+
    "ist, dass du hier Sachen kaufen und verkaufen kannst. Wenn du "+
    "<zeige> tippst, bekommst du eine Liste der verkaeuflichen Sachen "+
    "ausgegeben.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"laden"}),
    "Du stehst darin.");
  AddDetail ( ({"fee", "feen"}),
    "Feen werden hier bevorzugt bedient. ;-)");
  AddDetail ( ({"zweck"}),
    "Der Zweck diese Ladens ist es, mit Sachen zu handeln, also sie zu "+
    "kaufen und verkaufen.");
  AddDetail ( ({"sachen"}),
    "Welche Sachen du kaufen kannst, erfaehrst du, wenn du `zeige` tippst.");
  AddDetail ( ({"liste"}),
    "Tipp `zeige`, und du wirst sie sehen.");
  AddDetail ( ({"boden"}),
    "Der Boden hier besteht natuerlich aus Holz. Ahhhh, da liegt doch "+
    "ein Zettel herum...");
  AddDetail ( ({"holz"}),
    "Das Holz ist Bestandteil des Baumes, in dem du dich befindest.");
  AddDetail ( ({"baum", "baumes"}),
    "Du befindest dich in einem.");
  AddDetail ( ({"bestandteil", "teil"}),
    "Mmmmm, Holz duerfte der wichtigste Bestandteil eines Baumes sein.");
  AddDetail ( ({"decke"}),
    "Auch die Decke besteht aus Holz, sowie auch der Boden und die Waende.");
  AddDetail ( ({"waende", "wand"}),
    "Die Waende sind auch aus Holz. Seltsamerweise kannst du nicht einmal "+
    "ein Regal sehen. Wo werden hier wohl die Sachen aufbewahrt ?");
  AddDetail ( ({"regal"}),
    "Regal ist hier keines zu sehen.");
  AddDetail ( ({"sache"}),
    "Welche Sachen du kaufen kannst, erfaehrst du, wenn du `zeige` tippst.");
  AddDetail ( ({"zettel"}),
    "Auf dem Zettel steht:\n"+
    "<zeige>     Eine Uebersicht des Angebots.\n"+
    "<zeige>     rue|ver|waf Ruestung|Verschiedenes|Waffen\n"+
    "<zeige>     panzer|helm|umhang|ring|...\n"+
    "<unt>       nummer Eine Beschreibung der genannten Nummer.\n"+
    "<kaufe>     nummer|name Du kaufst diesen Gegenstand.\n"+
    "<verkaufe>  name Du verkaufst diesen Gegenstand.\n"+
    "<versetze>  name Du verkaufst diesen Gegenstand, egal, wieviel "+
    "du kriegen "+
    "            wirst.\n"+
    "<schaetz>   Der Haendler schaetzt einen deiner Gegenstaende.\n");
  AddDetail ( ({"uebersicht"}),
    "Eine Uebersicht der Gegenstaende bekommst du, wenn du <zeige> tippst.");
  AddDetail ( ({"gegenstaende", "gegenstand", "gegenstandes"}),
    "Mit <unt> name kannst du einen Gegenstand genauer betrachten.");
  AddDetail ( ({"angebot", "angebots"}),
    "Das Angebot siehst du, wenn du <zeige> tippst.");
  AddDetail ( ({"beschreibung"}),
    "Mit <unt> name bekommst du eine genaue Beschreibung eines "+
    "Gegenstandes.");
  AddDetail ( ({"name", "nummer"}),
    "Nummer oder Name bezeichnet einen bestimmten Gegenstand.");
  AddDetail ( ({"waffe", "waffen"}),
    "Welche Waffen du kaufen kannst, erfaehrst du, wenn du <zeige> waf "+
    "tippst.");
  AddDetail ( ({"ruestung", "ruestungen"}),
    "Sieh sie dir mit <zeige> rue an.");
  AddDetail ( ({"verschiedenes"}),
    "Verschiedenes siehst du, wenn du <zeige> ver tippst.");
  AddDetail ( ({"haendler"}),
    "Eigentlich siehst du hier keinen. Von wem du wohl die Sachen bekommst "+
    "?");
  // DETAILS END

  // EXITS START
  AddExit ("raus", "raus#"+"./mp4");
  // EXITS END

  // ITEMS START
  AddItem ("/d/ebene/obj/div/teddyautomat", REFRESH_REMOVE);
  AddItem ("/obj/zeitungsautomat", REFRESH_REMOVE);
  // ITEMS END
  
  SetStorageRoom(ROOM("lagerrauma"));

}
