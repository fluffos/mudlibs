#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/kristallwald/kermet/feenland/siedlung/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Auf einer Waldlichtung");
  SetProp (P_INT_LONG,
    "Nun stehst du am oestlichen Rand der Lichtung. Der Wind schmiegt "+
    "sich ueber das Gras, und du fuehlst dich hier richtig wohl.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"himmel"}),
    "Der Himmel ist strahlend blau.");
  AddDetail ( ({"boden"}),
    "Am Boden waechst hier viel Gras.");
  AddDetail ( ({"rand"}),
    "An diesem Rand kommt dir die Luft besonders klar vor.");
  AddDetail ( ({"luft"}),
    "Die Luft hier ist klar und rein.");
  AddDetail ( ({"lichtung"}),
    "Hier am oestlichen Rand der Lichtung kannst du ausser Gras nicht viel "+
    "erkennen.");
  AddDetail ( ({"gras"}),
    "Das Gras ist hier saftig, gruen und tritt in Buescheln auf.");
  AddDetail ( ({"bueschel", "grasbueschel"}),
    "Jedes Bueschel besteht aus vielen Grashalmen.");
  AddDetail ( ({"grashalme", "halme"}),
    "Um die einzelnen Halme untersuchen zu koennen, muesstest du dich "+
    "hinunterbuecken.");
  AddDetail ( ({"wind"}),
    "Der Wind weht hier ganz leicht und schmiegt sich an das Gras an.");
  AddDetail ( ({"wald"}),
    "Inmitten der Baeume kannst du ein einzelnes Gebuesch erkennen.");
  AddDetail ( ({"baeume", "baum"}),
    "Die Baeume stehen hier sehr dicht.");
  AddDetail ( ({"gebuesch"}),
    "Nahe des Gebuesches kannst du einige Spuren erkennen.");
  AddDetail ( ({"spur", "spuren"}),
    "Die Spuren fuehren alle zum Gebuesch und enden dort ganz ploetzlich. "+
    "Ob das etwas zu bedeuten hat ?");
  // DETAILS END

  // EXITS START
  AddExit ("westen", "./mp5");
  AddExit ("suedwesten", "./mp8");
  AddExit ("sueden", "./mp9");
  AddExit ("nordwesten", "./mp2");
  AddExit ("norden", "./mp3");
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"kletter", "krieche", "kriech", "zwaeng", "zwaenge"}), "kletter");
}

int kletter (string str)
{
  notify_fail ("Ok, aber wohin und wie ?\n");
  if (!str) return 0;
  if (str=="durch gebuesch")
  {
  this_player()->move(ROOM("ladenw"),M_GO,"durch das Gebuesch","klettert","kommt an"
);
  return 1;
  }
  return 0;
}
