#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/kristallwald/kermet/feenland/siedlung/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Auf einer Waldlichtung");
  SetProp (P_INT_LONG,
    "Du befindest dich hier im Westen der Lichtung. Von hier aus erkennst "+
    "du, wie sich das Gras der Lichtung im Wind bewegt.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"himmel"}),
    "Der Himmel ist eine grosse blaue Flaeche. Vereinzelt kannst du kleine "+
    "sich bewegende Punkte erkennen. Was das wohl sein mag?");
  AddDetail ( ({"flaeche", "himmelsflaeche"}),
    "Die Himmelsflaeche erscheint dir wie ein strahlend blaues Zeltdach, "+
    "das das ganze Land ueberspannt.");
  AddDetail ( ({"dach", "zeltdach"}),
    "Eine Metapher, denn einen Zirkus kannst du hier nicht sehen.");
  AddDetail ( ({"metapher"}),
    "Eine Metapher ist so etwas wie ein schoeneres Wort, das in einem "+
    "anderen Kontext zur Illustration verwendet wird (einfach "+
    "ausgedrueckt).");
  AddDetail ( ({"circus", "zirkus"}),
    "Ein Zirkus? Wo???????????");
  AddDetail ( ({"land"}),
    "Das Land hier wird als Feenland bezeichnet.");
  AddDetail ( ({"feenland"}),
    "Hier kommen die vielen kleinen Feen auf die Welt.");
  AddDetail ( ({"fee", "feen"}),
    "Die Feen sind eine eigene Rasse. Mach mal `hilfe rasse`.");
  AddDetail ( ({"rasse", "rassen"}),
    "Tipp: hilfe rasse");
  AddDetail ( ({"illustration"}),
    "Dient dazu, wenn man etwas malerischer formulieren moechte.");
  AddDetail ( ({"kontext"}),
    "Kontext=Zusammenhang");
  AddDetail ( ({"zusammenhang"}),
    "Zusammenhang=Kontext ;-)");
  AddDetail ( ({"wort"}),
    "Argl, du wirst doch wohl wissen, was ein Wort ist. Wenn nicht, kram "+
    "mal deine alten Unterlagen aus der Schule hervor...");
  AddDetail ( ({"unterlage", "unterlagen"}),
    "Findest du deine Hefte und Buecher nicht mehr?");
  AddDetail ( ({"buch", "buecher", "heft", 
                "hefte"}),
    "Genau, darin koenntest du alles nachlesen.");
  AddDetail ( ({"schule"}),
    "Du warst doch immer dort, oder?");
  AddDetail ( ({"welt"}),
    "Das hier ist nicht die wirkliche Welt (fuer alle, die das ab und zu "+
    "vergessen).");
  AddDetail ( ({"lichtung"}),
    "Oestlich von hier erstreckt sich eine wunderschoene Lichtung.");
  AddDetail ( ({"gras"}),
    "Das Gras ist hier nicht ganz so hoch wie sonst auf der Lichtung.");
  AddDetail ( ({"boden"}),
    "Der Boden hier ist ziemlich fest. Ob das der Grund ist dafuer, dass "+
    "das Gras hier nicht so hoch waechst?");
  AddDetail ( ({"grund"}),
    "Hmmm, der Grund koennte sein, dass hier vielleicht irgendwer oefters "+
    "das Gras niedertritt.");
  AddDetail ( ({"irgendwer"}),
    "Tja, wer koennte das sein im Feenland?");
  AddDetail ( ({"wind"}),
    "Der Wind weht hier doch ziemlich heftig. Vielleicht bewegen sich "+
    "deshalb die Punkte am Himmel so schnell.");
  AddDetail ( ({"punkt", "punkte"}),
    "Koennten das vielleicht Voegel sein?");
  AddDetail ( ({"voegel", "vogel"}),
    "Soweit du das von hier aus beurteilen kannst, duerfte es sich um "+
    "Schwalben handeln.");
  AddDetail ( ({"schwalbe", "schwalben"}),
    "Du hast tatsaechlich ein gutes Auge, wenn du sie von hier unten "+
    "identifizieren kannst.");
  AddDetail ( ({"auge"}),
    "Dein Auge scheint vom vielen Untersuchen ziemlich geschaerft zu sein.");
  AddDetail ( ({"wald"}),
    "Im Westen der Lichtung befindet sich der Wald.");
  AddDetail ( ({"baeume"}),
    "Die Baeume stehen hier sehr dicht. Einer faellt dir besonders auf: es "+
    "duerfte eine Tanne sein.");
  AddDetail ( ({"baum"}),
    "Ausser einer Tanne siehst du keinen besonderen Baum.");
  AddDetail ( ({"tanne"}),
    "Du siehst Spuren an der Rinde der Tanne, so, als ob jemand "+
    "hinaufgeklettert ist.");
  AddDetail ( ({"spur", "spuren"}),
    "Die Spuren an der Rinde sehen aus wie kleine Tritte.");
  AddDetail ( ({"rinde"}),
    "Die Rinde hat viele kleine Spuren, die wie Tritte aussehen.");
  AddDetail ( ({"tritt", "tritte"}),
    "Die Tritte fuehren nach oben und unten.");
  AddDetail ( ({"untersuche", "untersuchen"}),
    "Untersuchen kann man hier viel: den Wald, die Baeume darin,...");
  AddDetail ( ({"w", "west", "westen"}),
    "Im Westen der Lichtung ist nur Wald.");
  // DETAILS END

  // EXITS START
  AddExit ("sueden", "./mp7");
  AddExit ("suedosten", "./mp8");
  AddExit ("osten", "./mp5");
  AddExit ("norden", "./mp1");
  AddExit ("nordosten", "./mp2");
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"kletter"}), "ladena");
}

int ladena (string str)
{
  notify_fail ("Tja, und wohin willst du klettern?\n");
  if (!str) return 0;
  if (str=="rauf" || str=="tanne" || str=="auf tanne")
  {
  this_player()->move(ROOM("ladena"),M_GO,"auf einen Baum","klettert","kommt an");
  return 1;
  }
  return 0;
}
