#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/kristallwald/kermet/feenland/siedlung/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Auf einer Waldlichtung");
  SetProp (P_INT_LONG,
    "Du stehst hier am suedwestlichen Ende der Lichtung. Auch hier ist "+
    "das Gras kniehoch.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden"}),
    "Der Boden ist ueberall mit Gras bedeckt.");
  AddDetail ( ({"gras"}),
    "Das Gras ist hier besonders saftig und gruen.");
  AddDetail ( ({"himmel"}),
    "Der Himmel ist, wie koennte es anders sein, himmelblau. ;-)");
  AddDetail ( ({"lichtung"}),
    "Die Lichtung hier am suedwestlichen Ende laedt dich foermlich ein, "+
    "hier eine Rast einzulegen.");
  AddDetail ( ({"rast"}),
    "Ja, hier waere ein nettes Plaetzchen dafuer.");
  AddDetail ( ({"plaetzchen", "platz"}),
    "Der Platz hier erscheint dir sehr gemuetlich.");
  AddDetail ( ({"ende"}),
    "An diesem Ende der Lichtung erscheint dir der umliegende Wald nicht "+
    "so dicht zu sein.");
  AddDetail ( ({"wald"}),
    "Der umliegende Wald besteht in erster Linie aus Nadelbaeumen.");
  AddDetail ( ({"baeume", "baum", "nadelbaeume", 
                "nadelbaum"}),
    "Nadelbaeume sind zum Beispiel Tannen, Fichten, Foehren usw.");
  AddDetail ( ({"linie"}),
    "Hmmm, eine Linie sollte immer gerade sein.");
  AddDetail ( ({"beispiel"}),
    "Tannen, Fichten und Foehren sind Beispiele fuer Nadelbaeume. Eichen "+
    "nicht.");
  AddDetail ( ({"tanne", "tannen"}),
    "Tannen erkennst du nur vereinzelt.");
  AddDetail ( ({"fichte", "fichten"}),
    "Die Fichten hier im Wald duerften auf Grund der Bodenqualitaet "+
    "besonders gut gedeihen.");
  AddDetail ( ({"grund"}),
    "Der Grund besteht hier natuerlich aus Erde.");
  AddDetail ( ({"erde"}),
    "Die Erde im angrenzenden Wald duerfte auf Grund ihrer Qualitaet die "+
    "Baeume spriessen und gedeihen lassen.");
  AddDetail ( ({"bodenqualitaet", "qualitaet"}),
    "Die hervorragende Erde hier erscheint dir besonders fruchtbar.");
  AddDetail ( ({"foehre", "foehren"}),
    "Der Wald hier kann durchaus als Foehrenwald bezeichnet werden, da "+
    "diese Baumart in der Ueberzahl ist.");
  AddDetail ( ({"eiche", "eichen"}),
    "Nein, Eichen kannst du hier keine sehen.");
  AddDetail ( ({"foehrenwald"}),
    "Ja, so koennte man den Wald hier bezeichnen. Ueberall stehen "+
    "hier Foehren herum. Du kannst ihre Staemme sehen, ihre Aeste, "+
    "die Nadeln darauf, und vereinzelt auch einige Wurzeln aus dem "+
    "Boden herausragen.");
  AddDetail ( ({"art", "baumart"}),
    "Du erkennst, dass hier nur Nadelbaeume wachsen.");
  AddDetail ( ({"ueberzahl", "zahl"}),
    "Zahlreich sind sie vertreten, die Nadelbaeume. Ihre Zahl ist nicht "+
    "abschaetzbar.");
  AddDetail ( ({"staemme", "stamm"}),
    "Die Staemme der Fichten sind gross und maechtig.");
  AddDetail ( ({"aeste", "ast"}),
    "Die etwa fingerdicken Aeste sind alle nadel-besetzt.");
  AddDetail ( ({"nadel", "nadeln"}),
    "Sei vorsichtig, du koenntest dich an ihnen verletzen.");
  AddDetail ( ({"wurzel", "wurzeln"}),
    "Die Wurzeln ragen alle aus dem Boden heraus, eine davon besonders "+
    "weit. Vielleicht koenntest du unter ihr hindurchkriechen ?");
  // DETAILS END

  // EXITS START
  AddExit ("osten", "./mp8");
  AddExit ("norden", "./mp4");
  AddExit ("nordosten", "./mp5");
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"krieche", "kriech", "robbe", "robb"}), "krieche");
}

int krieche (string str)
{
  notify_fail ("Du waeltzt dich am Boden herum?\n");
  if (!str) return 0;
  if (str=="wurzel" || str=="unter wurzel" || str=="unter wurzel durch" || str=="unter wurzel hindurch")
  {
  this_player()->move(ROOM("kneipe"),M_GO,"unter einer Wurzel durch","kriecht","kommt an");
  return 1;
  }
  return 0;
}
