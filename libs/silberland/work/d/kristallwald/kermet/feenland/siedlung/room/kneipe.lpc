#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/kristallwald/kermet/feenland/siedlung/room/"+x)
#endif

inherit "std/pub";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Die Kneipe `Zum besoffenen Drachen`.");
  SetProp (P_INT_LONG,
    "Du befindest dich hier in der Kneipe `Zum besoffenen Drachen`. Hier "+
    "geht es lustig zu: ueberall sitzen Feen herum und trinken "+
    "Nektarwein. An manchen Tischen werden auch froehlich Lieder "+
    "gesungen. Sofort erkennst du: das ist ein Platz zum Wohlfuehlen. "+
    "Wenn du Lust hast, kannst du dich ja setzen, etwas bestellen "+
    "(wenn du <menue> tippst, kannst du deine Auswahl treffen) "+
    "und an dem lustigen Treiben teilnehmen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"kneipe"}),
    "Hier in der Kneipe kannst du essen und trinken und es dir gutgehen "+
    "lassen.");
  AddDetail ( ({"zum"}),
    "`Zum` ist Teil des Namens dieser Kneipe.");
  AddDetail ( ({"name", "namens"}),
    "Der Name der Kneipe ist: `Zum besoffenen Drachen`.");
  AddDetail ( ({"drache", "drachen"}),
    "Drachen gibt es einige hier im Silberland. Angeblich soll es auch "+
    "hier in der Naehe einen geben...");
  AddDetail ( ({"teil", "teile"}),
    "`Zum`, `besoffenen`, `Drachen` sind Teile des Namens dieser Kneipe.");
  AddDetail ( ({"naehe"}),
    "Tja, genaueres weisst du auch nicht. Vielleicht kannst du dich bei "+
    "jemandem darueber erkundigen.");
  AddDetail ( ({"silberland", "sl"}),
    "Du spielst gerade im Silberland. Los, geh raus und forsche ein wenig, "+
    "dann wirst du sehen, wie schoen es hier ist.");
  AddDetail ( ({"tisch", "tische", "tischen"}),
    "An den Tischen sitzen Feen und trinken Nektarwein.");
  AddDetail ( ({"auswahl", "wahl"}),
    "Tippe <menue>, dann kannst du sie treffen...");
  AddDetail ( ({"lust"}),
    "Hast du Lust ? Hmmm ? Na, wie waers, setz dich und bestell etwas.");
  AddDetail ( ({"fee", "feen"}),
    "Hier sitzen einige herum und trinken und singen.");
  AddDetail ( ({"lied", "lieder"}),
    "Du Lieder klingen sehr schoen. Lausche und staune, welche Geschichten "+
    "sie erzaehlen.");
  AddDetail ( ({"geschichte", "geschichten"}),
    "Die Lieder erzaehlen von Drachen, Feen, von boeser Magie und grossen "+
    "Tieren, und natuerlich von der Feenkoenigin.");
  AddDetail ( ({"magie"}),
    "Magie kommt oft vor in den Liedern, denn gerade Feen verstehen sich "+
    "sehr gut darauf.");
  AddDetail ( ({"tier", "tiere", "tieren"}),
    "Du kannst dir vorstellen, dass es im angrenzenden Wald viele grosse "+
    "Tiere geben koennte.");
  AddDetail ( ({"wald"}),
    "Hier wird wahrscheinlich jener Wald gemeint sein, der die Lichtung "+
    "umgibt.");
  AddDetail ( ({"lichtung"}),
    "Wenn du die Kneipe verlaesst, wirst du sie sehen.");
  AddDetail ( ({"boden"}),
    "Der Boden hier ist sehr sauber, denn Feen sind sehr reinliche Wesen.");
  AddDetail ( ({"wesen"}),
    "Sieh sie dir an, sie sitzen ja rings um dich an den Tischen.");
  AddDetail ( ({"feenkoenigin", "koenigin"}),
    "Sie soll in einem Schloss wohnen, das nicht so leicht zu finden "+
    "ist...");
  AddDetail ( ({"schloss"}),
    "Das Schloss ist durch Magie vor den Blicken von Fremden geschuetzt.");
  AddDetail ( ({"blick", "blicke", "blicken"}),
    "Hier kannst du das Schloss nicht erblicken.");
  AddDetail ( ({"fremd", "fremde", "fremden"}),
    "Wenn du keine Fee bist, bist du hier fremd und kannst das Schloss "+
    "nicht so einfach sehen.");
  AddDetail ( ({"wohlfuehlen"}),
    "Entspannen, relaxen, ... ");
  AddDetail ( ({"treiben"}),
    "Das lustige Treiben hier gefaellt dir sehr.");
  AddDetail ( ({"decke"}),
    "Die Decke wird durch die Wurzel gebildet, durch die du gekrochen "+
    "bist.");
  AddDetail ( ({"wurzel"}),
    "Von draussen kannst du sie besser sehen.");
  AddDetail ( ({"waende", "wand"}),
    "Die Waende hier bestehen aus Holz, wahrscheinlich werden sie "+
    "ebenfalls durch Wurzeln gebildet.");
  AddDetail ( ({"holz"}),
    "Die Feen lieben Holz und aehnliche Materialien, denn sie sind sehr "+
    "naturverbunden.");
  AddDetail ( ({"material", "materialien"}),
    "Holz, Lehm, Steine, auf jeden Fall etwas, das aus der Natur kommt.");
  AddDetail ( ({"lehm"}),
    "Lehm wird aus dem Boden gewonnen.");
  AddDetail ( ({"stein", "steine"}),
    "Steine kann man fast ueberall finden.");
  AddDetail ( ({"faelle", "fall", "falle", 
                "falles"}),
    "Im Falle eines Falles,...");
  AddDetail ( ({"natur"}),
    "Feen fuehlen sich wohl in ihr, und deshalb halten sie sich auch "+
    "meistens dort auf.");
  AddDetail ( ({"nektar", "nektarwein", "wein"}),
    "Nektarwein ist ein sehr beliebtes Getraenk hier. Vielleicht kannst du "+
    "dir ja auch einen bestellen.");
  AddDetail ( ({"getraenk", "getraenke"}),
    "Wenn du <menue> tippst, siehst du, welche es hier gibt.");
  AddDetail ( ({"wurzeln"}),
    "Sieh sie dir besser von draussen an.");
  // DETAILS END

  // EXITS START
  AddExit ("raus", "raus#"+"./mp7");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
