#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/kristallwald/kermet/feenland/siedlung/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Auf einer Waldlichtung");
  SetProp (P_INT_LONG,
    "Du stehst hier am suedoestlichen Rand der Lichtung. Auch hier "+
    "raschelt es ueberall im Gras.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"rand"}),
    "Auch hier ist der Rand der Lichtung die Abgrenzung zum Wald.");
  AddDetail ( ({"lichtung"}),
    "Die Lichtung endet hier im Suedosten.");
  AddDetail ( ({"abgrenzung"}),
    "Eine Abgrenzung ist sowas wie eine Grenzlinie.");
  AddDetail ( ({"grenze", "grenzlinie", "linie"}),
    "Hier ist diese Grenze zwischen Lichtung und Wald.");
  AddDetail ( ({"wald"}),
    "Der Wald beginnt hier am Ende der Lichtung.");
  AddDetail ( ({"ende"}),
    "Nur weil hier die Lichtung zu Ende ist, wirst du doch nicht zum "+
    "Spielen aufhoeren ?");
  AddDetail ( ({"spiel", "spielen"}),
    "Gefaellt dir das Silberland ?");
  AddDetail ( ({"silberland"}),
    "Ein tolles Spiel.");
  AddDetail ( ({"gras"}),
    "Das Gras erreicht hier ungefaehr Kniehoehe.");
  AddDetail ( ({"hoehe", "knie", "kniehoehe"}),
    "Siehst du dein eigenes Knie nicht ?");
  AddDetail ( ({"boden"}),
    "Auch hier ist der Boden voller Gras.");
  AddDetail ( ({"himmel"}),
    "Am Himmel ist kein Woelkchen zu sehen.");
  AddDetail ( ({"woelkchen", "wolke", "wolken"}),
    "Am Himmel sind keine zu sehen.");
  // DETAILS END

  // EXITS START
  AddExit ("westen", "./mp8");
  AddExit ("nordwesten", "./mp5");
  AddExit ("norden", "./mp6");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
