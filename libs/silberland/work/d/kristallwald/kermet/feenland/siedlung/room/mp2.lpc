#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/kristallwald/kermet/feenland/siedlung/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Auf einer Waldlichtung");
  SetProp (P_INT_LONG,
    "Hier, im Norden der Lichtung spuerst du eine ganz besondere Aura. "+
    "Die Luft ist hier besonders frisch und klar, so, als ob das ein "+
    "Platz voll des Friedens und der Besinnung ist.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"himmel"}),
    "Bei einem so strahlend blauen Himmel kommst du in Versuchung, dich "+
    "fuer eine Weile hinzulegen und den Anblick zu geniessen.");
  AddDetail ( ({"lichtung"}),
    "Irgendwie fuehlst du, dass die Lichtung hier ein Ort des Friedens und "+
    "der Harmonie ist.");
  AddDetail ( ({"frieden", "friedens"}),
    "Friedlich koenntest du hier einschlafen, ohne etwas befuerchten zu "+
    "muessen...");
  AddDetail ( ({"ort"}),
    "Dieser Ort hier duerfte etwas besonderes sein.");
  AddDetail ( ({"besonderes"}),
    "Du ueberlegst und ueberlegst...und kommst nicht drauf.");
  AddDetail ( ({"harmonie"}),
    "Harmonie, Stille, Frieden, eins sein mit der Welt...");
  AddDetail ( ({"stille"}),
    "Hier ist es so ruhig, man koennte eine Stecknadel fallen hoeren.");
  AddDetail ( ({"nadel", "stecknadel"}),
    "Wenn du eine haettest, koenntest du es ausprobieren.");
  AddDetail ( ({"welt"}),
    "Die Welt koennte so schoen sein...");
  AddDetail ( ({"versuchung"}),
    "Kannst du ihr widerstehen ?");
  AddDetail ( ({"weile"}),
    "Ewig koenntest du hier liegen und den Anblick geniessen.");
  AddDetail ( ({"anblick"}),
    "Bei diesem Anblick kommen die Erinnerungen hervor: damals, als "+
    "du...*traeum*");
  AddDetail ( ({"erinnerung", "erinnerungen"}),
    "Krame darin und vergiss die schoensten nicht. Sie sind eine "+
    "Bereicherung fuer dein Leben.");
  AddDetail ( ({"bereicherung"}),
    "Ach ja, damals, als du noch jung warst...");
  AddDetail ( ({"leben"}),
    "Dein ganzes Leben zieht an dir vorueber. Du hast dich doch wohl nicht "+
    "zum Sterben hingelegt ? Oder? Hmmmm?");
  AddDetail ( ({"sterben"}),
    "Willst du ?");
  AddDetail ( ({"boden"}),
    "Der Boden hier ist weich und laedt zum Ausruhen ein.");
  AddDetail ( ({"ausruhen", "ruhen"}),
    "Ja, hier koennte es angenehm sein.");
  AddDetail ( ({"platz"}),
    "Dieser Platz hier ist sicherlich etwas besonderes.");
  AddDetail ( ({"luft"}),
    "Die Luft hier ist frisch und klar...und belebt deine Sinne.");
  AddDetail ( ({"sinn", "sinne"}),
    "Dein Sinne sagen dir, dass du hier nichts zu befuerchten hast.");
  AddDetail ( ({"besinnung"}),
    "Du besinnst dich, das man auch ohne metzeln ein schoenes Leben "+
    "fuehren kann.");
  AddDetail ( ({"aura"}),
    "Hier erkennst du, dass jedes Lebewesen, jedes Ding, ja die Natur an "+
    "sich eine eigene, unverwechselbare Ausstrahlung haben.");
  AddDetail ( ({"lebewesen", "wesen"}),
    "Auch du bist ein lebendiges, denkendes und fuehlendes Wesen.");
  AddDetail ( ({"ding", "dinge"}),
    "Koenne wir uns sicher sein, dass nicht auch Dinge ein Bewusstsein "+
    "haben?");
  AddDetail ( ({"natur"}),
    "An diesem herrlichen Ort koenntest du eins sein mit der Natur, wenn "+
    "du dich ihr nur hingibst.");
  AddDetail ( ({"bewusstsein"}),
    "Du spuerst, wie sich dein Bewusstsein hier an der frischen Luft "+
    "erweitert.");
  AddDetail ( ({"ausstrahlung", "strahlung"}),
    "Auch du hast eine ganz bestimmte Ausstrahlung, an der dich sensible "+
    "Wesen erkennen koennen.");
  // DETAILS END

  // EXITS START
  AddExit ("westen", "./mp1");
  AddExit ("suedwesten", "./mp4");
  AddExit ("sueden", "./mp5");
  AddExit ("suedosten", "./mp6");
  AddExit ("osten", "./mp3");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
