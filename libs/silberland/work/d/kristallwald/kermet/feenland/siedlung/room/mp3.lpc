#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/kristallwald/kermet/feenland/siedlung/room/"+x)
#define ROOMA(x) ("/d/kristallwald/kermet/feenland/anfaenger/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Auf einer Waldlichtung");
  SetProp (P_INT_LONG,
    "Der Nordosten der Lichtung scheint anders zu sein: der Wind weht "+
    "hier staerker, du fuehlst, dass es hier auch kaelter ist als auf den "+
    "restlichen Plaetzen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"lichtung"}),
    "Hier am nordoestlichen Rand der Lichtung weht ein starker Wind.");
  AddDetail ( ({"rand"}),
    "Der Wald an diesem Rand erscheint dir nicht so dicht als anderswo.");
  AddDetail ( ({"wald"}),
    "Koennte es sein, dass hinter dem Wald hier ein Weg weiterfuehrt ?");
  AddDetail ( ({"weg"}),
    "Ja, du erkennst deutlich einen Weg. Vielleicht kannst du ihn "+
    "betreten?");
  AddDetail ( ({"boden"}),
    "Der Boden hier siehst aus, als waere er schon oft betreten worden.");
  AddDetail ( ({"himmel"}),
    "Am Himmel kannst du vereinzelt Wolken erkennen, die durch den starken "+
    "Wind weitergetrieben werden.");
  AddDetail ( ({"wolke", "wolken"}),
    "Die Wolken sehen wirklich niedlich aus.");
  AddDetail ( ({"plaetze", "plaetzen", "platz"}),
    "An diesem Platz hier auf der Lichtung fuehlst du dich nicht so wohl. "+
    "Woran koennte das liegen ? Vielleicht am starken Wind?");
  AddDetail ( ({"wind"}),
    "Der Wind kommt von Nordosten, das kannst du spueren.");
  AddDetail ( ({"no", "nordosten"}),
    "Im Nordosten ist der Wald anscheinend durchlaessig fuer den Wind.");
  // DETAILS END

  // EXITS START
  AddExit ("westen", "./mp2");
  AddExit ("suedwesten", "./mp5");
  AddExit ("sueden", "./mp6");
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"betrete", "betritt"}), "betrete");
}

int betrete (string str)
{
  notify_fail ("WAS willst Du betreten?\n");
  if (!str) return 0;
  if (str=="weg" || str=="den weg")
  {
  this_player()->move(ROOMA("a1"),M_GO,"den Weg","betritt","kommt an");
  return 1;
  }
  return 0;
}
