#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/kristallwald/kermet/feenland/siedlung/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "In der Mitte der Lichtung");
  SetProp (P_INT_LONG,
    "Du stehst nun in der Mitte der kleinen Waldeslichtung. Von hier aus "+
    "hast du einen guten Ueberblick und erkennst, dass die Baeume am Rand "+
    "der Lichtung unterschiedlich dicht wachsen. Was wohl der Grund "+
    "dafuer ist ?");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"lichtung", "waldeslichtung"}),
    "Du stehst genau in der Mitte der Lichtung.");
  AddDetail ( ({"mitte"}),
    "Das Zentrum der Lichtung.");
  AddDetail ( ({"zentrum"}),
    "Ja, hier ist wirklich das Zentrum dieser quadratischen Lichtung.");
  AddDetail ( ({"boden"}),
    "Auch hier ist der Boden grasbedeckt.");
  AddDetail ( ({"gras"}),
    "Das Gras waechst hier hoch und sieht gruen und saftig aus.");
  AddDetail ( ({"himmel"}),
    "Vereinzelt kannst du im Nordosten Wolken erkennen.");
  AddDetail ( ({"no", "nordosten"}),
    "Du koenntest hingehen, wenn du willst.");
  AddDetail ( ({"wolke", "wolken"}),
    "Wenn du nach nordosten gehst, kannst du sie vielleicht genauer "+
    "erkennen.");
  AddDetail ( ({"ueberblick"}),
    "Von hier aus kannst du in alle Richtungen sehen.");
  AddDetail ( ({"richtung", "richtungen"}),
    "Die Lichtung erstreckt sich in alle Richtungen weiter (sonst waere "+
    "hier auch nicht die Mitte).");
  AddDetail ( ({"baeume", "baum"}),
    "Wenn du sie naeher betrachten willst, ist es besser, du gehst zu "+
    "ihnen hin.");
  AddDetail ( ({"rand"}),
    "Du kannst den Rand der ganzen Lichtung erkennen. Allerdings, hier in "+
    "der Mitte der Lichtung ist definitiv kein Rand.");
  AddDetail ( ({"grund"}),
    "Vielleicht liegt es daran, dass der Wald nicht ueberall gleich dicht "+
    "waechst. Koennte es da vielleicht Durchgaenge geben?");
  AddDetail ( ({"wald"}),
    "Der Wald ist von hier aus zu weit weg, um ihn genau zu untersuchen.");
  AddDetail ( ({"durchgaenge", "durchgang"}),
    "Es koennte sein, dass man an der einen oder anderen Stelle vielleicht "+
    "durch den Wald durchschluepfen koennte (irgendwie).");
  AddDetail ( ({"irgendwie"}),
    "Wie das funktionieren koennte, musst du selbst ausprobieren.");
  AddDetail ( ({"stelle"}),
    "An welcher Stelle man es probieren koennte, kannst du nicht "+
    "beurteilen. Vielleicht solltest du dir den Rand der Lichtung ueberall "+
    "genauer ansehen ?");
  // DETAILS END

  // EXITS START
  AddExit ("westen", "./mp4");
  AddExit ("sueden", "./mp8");
  AddExit ("suedwesten", "./mp7");
  AddExit ("suedosten", "./mp9");
  AddExit ("osten", "./mp6");
  AddExit ("nordwesten", "./mp1");
  AddExit ("norden", "./mp2");
  AddExit ("nordosten", "./mp3");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
