#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/kristallwald/kermet/feenland/siedlung/room/"+x)
#endif

inherit "std/store";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:0]));
  SetProp (P_INT_SHORT, "Ein Lagerraum.");
  SetProp (P_INT_LONG,
    "Ein einfacher Lagerraum. Als Spieler solltest du gar nicht hiersein. "+
    "Bist also Magier? Ok, dann kann ich mir auch dieDetails ersparen. "+
    ":-)");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  // EXITS END

  // ITEMS START
  AddItem("/obj/fackel", REFRESH_REMOVE);
  AddItem("/obj/fackel", REFRESH_REMOVE);
  AddItem("/obj/schaufel", REFRESH_REMOVE);
  AddItem("/obj/seil", REFRESH_REMOVE);
  AddItem("/obj/stempel", REFRESH_REMOVE);
  // ITEMS END

}
