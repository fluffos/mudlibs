#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/kristallwald/kermet/feenland/siedlung/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Die Feengilde.");
  SetProp (P_INT_LONG,
    "Du befindest dich hier in der Gilde der Feen. Hier koennen sie ihre "+
    "Stufe erhoehen, ihre Attribute veraendern und sonst noch allerlei "+
    "interessantes erfahren.\n"+
    "Der Raum selbst scheint aus reiner Magie zu bestehen: du siehst "+
    "keine Waende, keine Decke,...und auch keinen Boden! Hier wirst du "+
    "rein von Magie getragen. Die Aura, die die Magie verbreitet, "+
    "laesst dich ehrfuerchtig erschaudern.\n"+
    "Einzig der Zettel, der hier im Raum schwebt, erscheint dir "+
    "etwas komisch...");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"gilde", "gilden"}),
    "Wenn du genaueres ueber die Gilden erfahren willst, mach mal `hilfe "+
    "gilden`.");
  AddDetail ( ({"fee", "feen"}),
    "Mach mal `hilfe feen`.");
  AddDetail ( ({"stufe", "stufen"}),
    "Eine Erklaerung zu den Stufen bekommst du ueber `hilfe stufen`.");
  AddDetail ( ({"erklaerung", "erklaerungen"}),
    "Alles kann dir auch nicht verraten werden. ;-)");
  AddDetail ( ({"attribut", "attribute"}),
    "Mach mal `hilfe attribute`, da erfaehrst du mehr.");
  AddDetail ( ({"boden", "decke", "waende", 
                "wand"}),
    "Hier gibt es nur Magie. Sie ist es, die dich hier schweben laesst, "+
    "die dich erfuellt, dich umhuellt und dir Kraft gibt.");
  AddDetail ( ({"kraft"}),
    "Feen beziehen ihre Kraft in erster Linie aus Magie.");
  AddDetail ( ({"raum"}),
    "Ob man diese Ansammlung von Magie hier als Raum bezeichnen kann, ist "+
    "eher fragwuerdig.");
  AddDetail ( ({"ansammlung", "sammlung"}),
    "Magie tritt hier in ihrer reinsten und klarsten Form auf.");
  AddDetail ( ({"form"}),
    "Magie hat an sich keine Form, da sie eigentlich nicht real existent "+
    "ist. Man kann sie nur an ihrer Wirkung erkennen.");
  AddDetail ( ({"wirkung"}),
    "Die Magie wirkt sehr belebend auf dich, du fuehlst dich erfrischt und "+
    "wie neu geboren.");
  AddDetail ( ({"linie"}),
    "Nun, da die Magie keine Form hat, kannst du auch keine Linie "+
    "erkennen.");
  AddDetail ( ({"magie"}),
    "Magie ist etwas wunderbares: sie gibt dir die Moeglichkeit, "+
    "Zaubersprueche zu sprechen, die dir oft sehr hilfreich sein koennen.");
  AddDetail ( ({"moeglichkeit"}),
    "Wenn du viel uebst und lernst, wirst auch du zaubern koennen.");
  AddDetail ( ({"sprueche", "zaubersprueche"}),
    "Welche Sprueche es gibt, kannst du mit `hilfe zauberei` erfahren.");
  AddDetail ( ({"aura"}),
    "Diese magische Aura, die dich einhuellt, wird von der Magie des "+
    "Silberlandes erschaffen.");
  AddDetail ( ({"silberland", "silberlandes"}),
    "Das ist das Spiel, das du gerade spielst...");
  AddDetail ( ({"spiel"}),
    "Du willst doch hier spielen, oder? Los, geh raus und sieh dich um. "+
    ":-)");
  // DETAILS END

  // EXITS START
  AddExit ("raus", "raus#"+"./mp1");
  // EXITS END

  // ITEMS START
  AddItem("/p/service/obj/zettel/zettelmaschine", REFRESH_REMOVE);
  // ITEMS END

}
