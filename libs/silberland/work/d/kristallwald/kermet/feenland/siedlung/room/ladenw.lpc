#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/kristallwald/kermet/feenland/siedlung/room/"+x)
#endif

inherit "std/laden";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Ein Waffenladen.");
  SetProp (P_INT_LONG,
    "Dies ist ein Waffenladen, der auch fuer Feen einiges zu bieten hat. "+
    "Er ist sehr spartanisch eingerichtet, ausser einer Verkaufstheke "+
    "kannst du keine Einrichtung erkennen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"laden", "waffenladen"}),
    "Genau darin befindest du dich jetzt.");
  AddDetail ( ({"fee", "feen"}),
    "Fuer Feen hat dieser Laden einiges zu bieten.");
  AddDetail ( ({"boden"}),
    "Der Boden besteht einfach aus Erde.");
  AddDetail ( ({"erde"}),
    "Die Erde ist hier ziemlich festgetreten.");
  AddDetail ( ({"waende", "wand"}),
    "Eigentlich sind es keine wirklichen Waende, das Gebuesch, durch das "+
    "du gekommen bist, bildet hier einen natuerlichen Schutz.");
  AddDetail ( ({"gebuesch"}),
    "Von draussen kannst du es naeher betrachten.");
  AddDetail ( ({"schutz"}),
    "Das Gebuesch laesst niemand von draussen hereinsehen.");
  AddDetail ( ({"decke"}),
    "Auch die Decke wird aus dem Gebuesch gebildet.");
  AddDetail ( ({"einrichtung"}),
    "Du siehst nur die Theke, sonst nichts.");
  AddDetail ( ({"theke", "verkaufstheke"}),
    "Auf der Theke liegt ein Zettel.");
  AddDetail ( ({"zettel"}),
    "Du kannst ihn lesen.");
  AddReadDetail ( ({"zettel"}),
    "Auf dem Zettel steht:\n"+
    "<zeige>     Eine Uebersicht des Angebots.\n"+
    "<zeige>     rue|waf Ruestung|Waffen\n"+
    "<zeige>     panzer|helm|umhang|ring|...\n"+
    "<unt>       nummer Eine Beschreibung der genannten Nummer.\n"+
    "<kaufe>     nummer|name Du kaufst diesen Gegenstand.\n"+
    "<schaetz>   Der Haendler schaetzt einen deiner Gegenstaende.\n"+
    "<vergleiche> Noch nicht implementiert.\n"+
    "<repariere> Noch nicht implementiert.\n");  

  // DETAILS END

  // EXITS START
  AddExit ("raus", "raus#"+"./mp6");
  // EXITS END

  // ITEMS START
  // ITEMS END

  SetStorageRoom(ROOM("lagerraumw"));

}
