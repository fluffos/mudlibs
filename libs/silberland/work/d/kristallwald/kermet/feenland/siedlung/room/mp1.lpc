#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/kristallwald/kermet/feenland/siedlung/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Auf einer Waldlichtung");
  SetProp (P_INT_LONG,
    "Hier ist das nordwestliche Ende der Lichtung. Als du dich hier "+
    "umschaust, bemerkst du, dass das Rascheln im Gras hier besonders "+
    "laut ist. Was geht hier bloss vor ?");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden"}),
    "Am Boden waechst Gras...und das Gras bewegt sich !");
  AddDetail ( ({"lichtung"}),
    "Hier stehst du nun am nordwestlichen Ende der Lichtung. Sie ist so "+
    "schoen wie ueberall hier.");
  AddDetail ( ({"ende"}),
    "Hier ist das Ende der Lichtung. Dein Ende kommt hoffentlich nicht so "+
    "bald. ;-)");
  AddDetail ( ({"himmel"}),
    "Der Himmel ist wolkenlos.");
  AddDetail ( ({"wolke"}),
    "Hast du hier eine gesehen?");
  AddDetail ( ({"gras"}),
    "Auch hier waechst das Gras nicht so hoch. Wahrscheinlich kommen auch "+
    "hier oefters Tiere oder so vorbei.");
  AddDetail ( ({"tier", "tiere"}),
    "Welche Tiere vorbeikommen, kannst du nur erahnen. Wahrscheinlich sind "+
    "es Tiere des Waldes, wie zum Beispiel Baeren, Woelfe, Fuechse und "+
    "dergleichen.");
  AddDetail ( ({"dergleichen"}),
    "Es koennten auch andere Tiere sein.");
  AddDetail ( ({"wald", "waldes"}),
    "Aus dem angrenzenden Wald duerften sich oefters Tiere hierher auf die "+
    "Lichtung verirren.");
  AddDetail ( ({"beispiel"}),
    "Ist doch da gestanden: Baeren, Woelfe, Fuechse.");
  AddDetail ( ({"baer", "baeren"}),
    "Baeren sind gross, zottelig und hier im Wald fast immer braun.");
  AddDetail ( ({"fuchs", "fuechse"}),
    "Fuechse sind sehr scheue Tiere und meistens nur in der Nacht aktiv.");
  AddDetail ( ({"nacht"}),
    "Im Augenblick ist es Tag. Wenn du also so lange hier warten willst...");
  AddDetail ( ({"augenblick"}),
    "Aeehh, es wird wohl mehr als nur einen Augenblick dauern, bis die "+
    "Nacht herein bricht.");
  AddDetail ( ({"tag"}),
    "Jetzt ist es Tag. Du erkennst es daran, dass es hell ist.");
  AddDetail ( ({"woelfe", "wolf"}),
    "Woelfe sind sehr gefaehrliche Tiere, da sie meist im Rudel jagen.");
  AddDetail ( ({"rudel"}),
    "Ein Rudel ist eine Gruppe von beispielsweise 8-10 Woelfen.");
  AddDetail ( ({"gruppe"}),
    "Eine Gruppe ist immer mehr als nur einer.");
  AddDetail ( ({"rascheln"}),
    "Das Rascheln duerften von kleinen Insekten stammen, die am Boden "+
    "herumkriechen.");
  AddDetail ( ({"insekt", "insekten"}),
    "Als du genauer hinschaust, kannst du einige Kaefer erblicken.");
  AddDetail ( ({"kaefer"}),
    "Igitt, igitt, es sind Mistkaefer.");
  AddDetail ( ({"mistkaefer"}),
    "Mistkaefer sind besonders gross und heissen deshalb so, weil sie den "+
    "Mist zusammenrollen.");
  AddDetail ( ({"mist"}),
    "Du siehst hier keinen Mist. Die Kaefer wahrscheinlich auch nicht, "+
    "deshalb werden sie auch woanders ihr Glueck versuchen muessen.");
  AddDetail ( ({"glueck"}),
    "Wenn man`s hat, erkennt man es meistens nicht...");
  AddDetail ( ({"spur", "spuren"}),
    "Seltsam, die Spuren enden alle an einem grossen Stein...");
  AddDetail ( ({"stein"}),
    "Der Stein ist ziemlich gross, du kannst nicht ueber ihn hinwegsehen. "+
    "Vielleicht kannst du ueber ihn drueber klettern.");
  // DETAILS END

  // EXITS START
  AddExit ("sueden", "./mp4");
  AddExit ("suedosten", "./mp5");
  AddExit ("osten", "./mp2");
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"kletter", "klettere", "kraxl", "kraxel"}), "kletter");
}

int kletter (string str)
{
  notify_fail ("Wohin, bitte?\n");
  if (!str) return 0;
  if (str=="ueber stein")
  {
  this_player()->move(ROOM("gilde"),M_GO,"ueber einen Stein","klettert","kommt an");
  return 1;
  }
  return 0;
}
