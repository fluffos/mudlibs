#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/kristallwald/kermet/feenland/anfaenger/room/"+x)
#define ROOMS(x) ("/d/kristallwald/kermet/feenland/siedlung/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Im Unterholz.");
  SetProp (P_INT_LONG,
    "Du befindest dich hier im Unterholz des Waldes. Schon von hier aus "+
    "kannst du erkennen, dass ueberall kleine Tiere herumlaufen: Ameisen, "+
    "Maeuse, Kaefer,... Wenn du sie fangen willst, musst du ziemlich "+
    "schnell sein, denn alle diese Tiere laufen geschaeftig umher, "+
    "wahrscheinlich auf der Suche nach Futter.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"unterholz", "wald", "waldes"}),
    "Du befindest dich hier im Unterholz des Waldes. Es besteht aus "+
    "heruntergefallenen oder tief wachsenden Aesten, aus Wurzeln und "+
    "kleineren Straeuchern.");
  AddDetail ( ({"aeste", "ast"}),
    "Die herumliegenden Aeste sind alle schon ziemlich morsch. Die aber, "+
    "die tief wachsen, machen einen sehr stabilen Eindruck. Vielleicht "+
    "kannst du ja einen herunterbrechen ?");
  AddDetail ( ({"eindruck"}),
    "Machen die Aeste einen besonderen Eindruck auf dich ?");
  AddDetail ( ({"wurzel", "wurzeln"}),
    "Die Wurzeln ragen zum Teil relativ hoch aus dem Boden heraus.");
  AddDetail ( ({"teil", "teile"}),
    "Die Wurzeln sind an sich jene Teile der Baeume, die unter der Erde "+
    "sein sollten.");
  AddDetail ( ({"baeume", "baum"}),
    "Die Baeume kannst du von hier unten nicht genau ausmachen.");
  AddDetail ( ({"boden", "erde"}),
    "Der Boden hier besteht aus weicher Erde. Die Erde ist feucht hier, "+
    "anscheinend speichert das Unterholz hier die Luftfeuchtigkeit und das "+
    "Regenwasser besonders gut. Du kannst auch den Weg sehen, auf dem "+
    "du gekommen bist.");
  AddDetail ( ({"feuchtigkeit", "luftfeuchtigkeit"}),
    "Sie ist hier sehr hoch, du merkst, wie die schwuele Luft beginnt, dir "+
    "den Schweiss aus den Poren zu treiben.");
  AddDetail ( ({"regenwasser", "wasser"}),
    "Die Erde hier duerfte das Wasser gut speichern, denn sie ist feucht "+
    "und weich.");
  AddDetail ( ({"luft"}),
    "Die Luft ist hier drueckend und schwuel.");
  AddDetail ( ({"schweiss"}),
    "Langsam kommst du wirklich ins Schwitzen.");
  AddDetail ( ({"schwitzen"}),
    "Der Schweiss steht dir auf der Stirn und die fuehlst dich nicht "+
    "gerade wohl.");
  AddDetail ( ({"stirn"}),
    "Deine Stirn ist schon ganz nass, genau wie die Erde hier. ;-)");
  AddDetail ( ({"pore", "poren"}),
    "Deine Poren oeffnen sich und lassen dem Schweiss freien Lauf.");
  AddDetail ( ({"lauf"}),
    "Der Schweiss laeuft dir bereits in grossen Perlen von der Stirn.");
  AddDetail ( ({"perle", "perlen"}),
    "Wenn sie etwas wert waeren, waerst du jetzt reich.");
  AddDetail ( ({"straeucher", "straeuchern", "strauch"}),
    "Die Straeucher bilden gemeinsam mit den Aesten und den Wurzeln das "+
    "Unterholz.");
  AddDetail ( ({"himmel"}),
    "Den Himmel kannst du hier nicht sehen, weil das Unterholz viel zu "+
    "dicht ist.");
  AddDetail ( ({"tier", "tiere"}),
    "Viele kleine Tiere laufen hier herum, ziemlich schnell sogar.");
  AddDetail ( ({"maeuse", "maus"}),
    "Maeuse sind kleine, graue Nagetiere.");
  AddDetail ( ({"nagetier", "nagetiere"}),
    "Nagetiere sind beispielsweise Maeuse, Ratten,...");
  AddDetail ( ({"ratte", "ratten"}),
    "Ratten siehst du hier gottseidank nicht. Waer ja auch schlimm...");
  AddDetail ( ({"ameise", "ameisen"}),
    "Ameisen sind kleine Insekten, die in einem Haufen leben.");
  AddDetail ( ({"insekt", "insekten"}),
    "Ameisen beispielsweise...");
  AddDetail ( ({"ameisenhaufen", "haufen"}),
    "Hier ist keiner zu sehen, aber die Ameisen laufen alle nach "+
    "suedosten.");
  AddDetail ( ({"kaefer"}),
    "Kaefer sind Insekten, genau wie Ameisen.");
  AddDetail ( ({"suche"}),
    "Die Insekten suchen sicher nach Essbarem.");
  AddDetail ( ({"essbarem", "essbares", "futter"}),
    "Du findest hier nichts, was dir schmecken wuerde. ;-)");
  AddDetail ( ({"weg"}),
    "Der Weg fuehrt auf die Lichtung zurueck, von der du gekommen bist.");
  AddDetail ( ({"lichtung"}),
    "Wenn du den Weg betrittst, kommst du dort hin.");
  // DETAILS END

  // EXITS START
  AddExit ("sueden", "./a2");
  AddExit ("suedosten", "./a3");
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"betrete", "betritt"}), "betrete");
}

int betrete (string str)
{
  notify_fail ("Was willst Du machen?\n");
  if (!str) return 0;
  if (str=="weg" || str=="den weg")
  {
  this_player()->move(ROOMS("mp3"),M_GO,"den Weg","betritt","kommt an");
  return 1;
  }
  return 0;
}

