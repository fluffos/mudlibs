#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/kristallwald/kermet/feenland/anfaenger/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Im Unterholz.");
  SetProp (P_INT_LONG,
    "Ach Gott, wo bist du hier hingekommen ? Es ist sehr finster hier, "+
    "das Gestruepp rings herum laesst kein Licht mehr durch. Alles in "+
    "allem macht dieser Ort nicht gerade einen erfreulichen Eindruck auf "+
    "dich, vor allem, als du die Spuren am Boden entdeckst...");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"himmel"}),
    "Es ist so finster hier, wohl auch deshalb, weil kein Licht hier "+
    "hereinkommt. Deshalb kannst du den Himmel auch nicht sehen.");
  AddDetail ( ({"goetter", "goettin", "goettinnen", 
                "gott"}),
    "Woody und Dusty sind Goetter hier.");
  AddDetail ( ({"woody"}),
    "Woody ist Gott hier.");
  AddDetail ( ({"dusty"}),
    "Dusty ist Goettin hier.");
  AddDetail ( ({"gestruepp"}),
    "Das Gestruepp rings um dich waechst so dicht, dass es unmoeglich "+
    "erscheint, hier durchzukommen.");
  AddDetail ( ({"licht"}),
    "Fast kein Licht erreicht diesen Ort, gerade noch genug, dass du etwas "+
    "sehen kannst.");
  AddDetail ( ({"ort"}),
    "Dieser Ort macht nicht gerade einen freundlich Eindruck auf dich. "+
    "Langsam steigt die Furcht in dir hoch...");
  AddDetail ( ({"eindruck"}),
    "Du hast den Eindruck, dass es hier sehr ungemuetlich werden "+
    "koennte...");
  AddDetail ( ({"boden"}),
    "Du siehst Spuren am Boden, was dich auch nicht besonders erfreut...");
  AddDetail ( ({"spur", "spuren"}),
    "Die Spuren scheinen von einem sehr grossen Tier zu stammen.");
  AddDetail ( ({"tier"}),
    "Leider kannst du nicht erkennen, von welchem Tier diese Spuren "+
    "stammen.");
  AddDetail ( ({"furcht"}),
    "Dir wird Angst und Bang hier an diesem graesslichen Ort.");
  AddDetail ( ({"bang"}),
    "Du beginnst, dich ordentlich zu fuerchten...");
  AddDetail ( ({"angst"}),
    "Die Angst steigt langsam in dir hoch, vielleicht solltest du diesen "+
    "Ort schnell wieder verlassen, sonst koennte dir vielleicht Boeses "+
    "zustossen...");
  AddDetail ( ({"boese", "boeses"}),
    "Gleich wirst du es erkennen koennen...fluechte lieber...bevor es zu "+
    "spaet ist.");
  // DETAILS END

  // EXITS START
  // EXITS END

  // ITEMS START
  // ITEMS END

}
