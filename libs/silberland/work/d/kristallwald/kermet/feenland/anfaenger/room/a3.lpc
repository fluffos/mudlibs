#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/kristallwald/kermet/feenland/anfaenger/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Im Unterholz.");
  SetProp (P_INT_LONG,
    "In diesem Teil des Unterholzes kannst du einen kleinen Ameisenhaufen "+
    "sehen. Von ueberall her laufen Ameisen in ihren Bau, auch die "+
    "Gegenrichtung ist stark frequentiert. Was fuer ein Gewurrl !");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden"}),
    "Am Boden kannst du viele Ameisen herumlaufen sehen.");
  AddDetail ( ({"himmel"}),
    "Leider Gottes wird er von den Baeumen ueber dir verdeckt.");
  AddDetail ( ({"goetter", "goettin", "gott", 
                "gottes"}),
    "Mmmm, kennst du Woody und Dusty nicht ?");
  AddDetail ( ({"woody"}),
    "Woody ist ein Gott, und was fuer einer....");
  AddDetail ( ({"dusty"}),
    "Dusty ist eine Goettin, und was fuer eine...");
  AddDetail ( ({"baeume", "baeumen", "baum"}),
    "Die Baeume ueber dir lassen dir keinen Blick auf den Himmel.");
  AddDetail ( ({"blick", "blicke"}),
    "Dein Blick schweift herum, ueber den Boden, die Ameisen,...");
  AddDetail ( ({"teil"}),
    "Wenn du weitergehst, kommst du in einen anderen Teil des Unterholzes.");
  AddDetail ( ({"unterholz", "unterholzes"}),
    "Genau da bist du jetzt gerade.");
  AddDetail ( ({"ameise", "ameisen"}),
    "Ueberall laufen sie herum, fast der ganze Boden ist voll von ihnen. "+
    "Wirklich fleissige kleine Tierchen.");
  AddDetail ( ({"tier", "tierchen", "tiere"}),
    "Tiere gibt es viele, hier kannst du aber nur Ameisen sehen.");
  AddDetail ( ({"ameisenhaufen", "bau", "haufen"}),
    "Du siehst hier einen relativ kleinen Ameisenhaufen. Fuer dich sieht "+
    "er nur aus wie ein Haufen von kleinen Aesten, Graesern und "+
    "dergleichen. Fuer die Ameisen jedoch ist es ihr Zuhause.");
  AddDetail ( ({"dergleichen"}),
    "Dergleichen kann alles moegliche sein, so genau kannst du das nicht "+
    "erkennen.");
  AddDetail ( ({"aeste", "aesten", "ast"}),
    "Die Ameisen haben viele kleine, abgebrochene Aeste zur Errichtung des "+
    "Haufens eingesetzt.");
  AddDetail ( ({"haufens"}),
    "Haufens ist der 2. Fall von Haufen.");
  AddDetail ( ({"fall"}),
    "Erinnere dich zurueck an deine Schulzeit...");
  AddDetail ( ({"schule", "schulzeit", "zeit"}),
    "Jaja, da war alles noch einfach und leicht...");
  AddDetail ( ({"errichtung"}),
    "So genau kannst du das nicht sagen, wann genau sie diesen Bau "+
    "errichtet haben. Allerdings kannst du erkennen, dass die Witterung im "+
    "bereits ordentlich zugesetzt hat.");
  AddDetail ( ({"witterung"}),
    "Vor allem der Regen duerfte einige Schaeden am Bau verursacht haben.");
  AddDetail ( ({"regen"}),
    "Trotz des dichten Unterholzes duerfte er fuer die meisten Schaeden am "+
    "Ameisenhaufen verantwortlich sein.");
  AddDetail ( ({"graeser", "graesern", "gras"}),
    "Auch Graeser wurden zum Bau des Ameisenhaufens verwendet.");
  AddDetail ( ({"zuhause"}),
    "Ja, die Ameisen sehen den Bau als ihr Zuhause an.");
  AddDetail ( ({"schaden", "schaeden"}),
    "Anscheinend duerfte der Bau einige Schaeden davongetragen haben, die "+
    "Ameisen sind naemlich fleissig dabei, den Haufen zu restaurieren.");
  AddDetail ( ({"gegenrichtung"}),
    "Die Ameisen, die nicht zum Bau laufen, werden wahrscheinlich auf der "+
    "Suche nach Futter sein.");
  AddDetail ( ({"richtung"}),
    "Osten waere eine Richtung.");
  AddDetail ( ({"osten"}),
    "Ja, nach Osten kannst du weitergehen.");
  AddDetail ( ({"suche"}),
    "Die Ameisen laufen ueberall herum und suchen wahrscheinlich nach "+
    "Futter.");
  AddDetail ( ({"futter"}),
    "Mmm, wovon ernaehren sich Ameisen bloss ...");
  AddDetail ( ({"gewurrl"}),
    "Die Ameisen laufen kreuz und quer --- das ist ein Gewurrl...");
  // DETAILS END

  // EXITS START
  AddExit ("nordwesten", "./a1");
  AddExit ("sueden", "./a4");
  AddExit ("osten", "./a6");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
