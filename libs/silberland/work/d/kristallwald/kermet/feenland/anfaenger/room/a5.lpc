#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/kristallwald/kermet/feenland/anfaenger/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Im Unterholz.");
  SetProp (P_INT_LONG,
    "Hier befindest du dich offensichtlich im hintersten Teil des "+
    "Unterholzes, der fuer dich noch zugaenglich ist. Rund um dich bilden "+
    "die Pflanzen einen undurchdringlichen Wall, der sogar fast kein "+
    "Sonnenlicht mehr durchlaesst. Irgendwie fuehlst du dich hier "+
    "ziemlich unwohl. Einen Grund dafuer kannst du aber nicht sehen. "+
    "Deine Sinne, dein magisches Gespuer, dein Bauch sagt dir: hier "+
    "solltest du nicht lange bleiben.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"himmel"}),
    "Durch die vielen Pflanzen kannst du den Himmel nicht sehen.");
  AddDetail ( ({"boden"}),
    "Der Boden hier besteht aus nackter Erde und sieht ziemlich "+
    "festgetreten aus, so, als ob hier dauernd jemand darueber laeuft.");
  AddDetail ( ({"erde"}),
    "Die braeunliche Erde ist ziemlich hart.");
  AddDetail ( ({"teil"}),
    "Dieser Teil des Unterholzes erscheint dir unheimlich - keine Laute "+
    "dringen an dein Ohr, die Luft hier ist schwuel und drueckend - kein "+
    "Platz, an dem du lange verweilen moechtest.");
  AddDetail ( ({"unterholz", "unterholzes"}),
    "Das Unterholz besteht hier hauptsaechlich aus Pflanzen, die "+
    "ineinander wachsen und so einen Wall bilden, der fuer dich nicht zu "+
    "ueberwinden sein wird.");
  AddDetail ( ({"pflanzen"}),
    "Die Pflanzen hier wachsen sehr dicht, du siehst keine Moeglichkeit, "+
    "hindurchzukommen.");
  AddDetail ( ({"moeglichkeit", "moeglichkeiten"}),
    "Du gruebelst und gruebelst...und es faellt dir nix ein.");
  AddDetail ( ({"wall"}),
    "Dieser Wall wird aus Pflanzen gebildet - unueberwindlich.");
  AddDetail ( ({"laut", "laute"}),
    "Du hoerst hier nichts - totenstill.");
  AddDetail ( ({"ohr", "ohren"}),
    "Du rubbelst ein bischen darin herum - und hoerst trotzdem nichts. ;-)");
  AddDetail ( ({"luft"}),
    "Die Luft ist hier drueckend und schwuel, richtig unangenehm.");
  AddDetail ( ({"platz"}),
    "Kein Platz wie dieser koennte dir heimelig erscheinen...");
  AddDetail ( ({"licht", "sonnenlicht"}),
    "Fast kein Licht faellt durch den dichten Wall an Pflanzen - ein "+
    "duesterer Platz.");
  AddDetail ( ({"grund"}),
    "Der Grund koennte sein, dass es hier so duester ist.");
  AddDetail ( ({"sinn", "sinne"}),
    "Alle deine Sinne sagen dir: das hier ist kein schoener Platz zum "+
    "Verweilen.");
  AddDetail ( ({"verweilen"}),
    "Verweilen solltest du besser wo anders.");
  AddDetail ( ({"gespuer"}),
    "Dein magisches Gespuer vermittelt dir einen duesteren Eindruck.");
  AddDetail ( ({"bauch"}),
    "Auf seinen Bauch kann man sich meist verlassen.");
  AddDetail ( ({"eindruck"}),
    "Du hast den Eindruck, als koennte dir hier schlimmes zustossen...");
  // DETAILS END

  // EXITS START
  AddExit ("westen", "./a4");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
