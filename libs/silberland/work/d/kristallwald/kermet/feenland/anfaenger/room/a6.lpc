#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/kristallwald/kermet/feenland/anfaenger/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Im Unterholz.");
  SetProp (P_INT_LONG,
    "Du befindest dich hier in einem Bereich des Unterholzes, wo es fast "+
    "kein weiterkommen mehr gibt. Alles, was hier waechst, bildet fuer "+
    "dich eine fast undurchdringliche Mauer. Es scheint, als waere der "+
    "einzige Ausweg hier der Weg zurueck...");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"bereich"}),
    "Dieser Bereich des Unterholzes erscheint dir nicht besonders "+
    "interessant, zumindest kannst du nichts erkennen, was dich "+
    "interessieren wuerde...");
  AddDetail ( ({"unterholz", "unterholzes"}),
    "Das Unterholz hier ist so dicht, dass es fuer dich kein vorankommen "+
    "gibt.");
  AddDetail ( ({"mauer"}),
    "Das Unterholz rings um dich erscheint dir wie eine Mauer, die es dir "+
    "nicht ermoeglicht, weiterzukommen.");
  AddDetail ( ({"ausweg", "weg"}),
    "Zurueck nach Westen.");
  AddDetail ( ({"west", "westen"}),
    "Geh hin, dann siehst du es.");
  AddDetail ( ({"himmel"}),
    "Durch das dichte Unterholz kannst du den Himmel nicht wirklich "+
    "erkennen.");
  AddDetail ( ({"boden"}),
    "Ein paar Grashalme wachsen hier, sonst ist nichts zu erkennen.");
  AddDetail ( ({"gras", "grashalme"}),
    "Die wenigen Grashalme sind schon etwas braeunlich.");
  // DETAILS END

  // EXITS START
  AddExit ("westen", "./a3");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
