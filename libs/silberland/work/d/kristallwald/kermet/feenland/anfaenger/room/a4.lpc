#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/kristallwald/kermet/feenland/anfaenger/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Im Unterholz.");
  SetProp (P_INT_LONG,
    "Das Unterholz ist hier besonders dicht, ueberall wachsen Wurzeln, "+
    "Aeste und Straeucher wirr durcheinander. Einzig eine kleine Schneise "+
    "nach Osten ist hier noch zu sehen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"holz", "unterholz"}),
    "Das dichte Unterholz aus Wurzeln, Aesten und Straeuchern sieht nicht "+
    "so aus, als koenntest du es ueberwinden.");
  AddDetail ( ({"wurzel", "wurzeln"}),
    "Die Wurzeln sind hier sehr dick und machen den groessten Teil des "+
    "Unterholzes aus.");
  AddDetail ( ({"unterholzes"}),
    "Das Unterholz ist hier besonders dicht.");
  AddDetail ( ({"teil", "teile"}),
    "Teile des Unterholzes sind unter anderem die Wurzeln.");
  AddDetail ( ({"aeste", "aesten", "ast"}),
    "Die Aesten liegen hier sicher schon lange herum, denn sie sehen "+
    "ziemlich morsch aus.");
  AddDetail ( ({"straeucher", "strauch"}),
    "Die Straeucher rings um dich stehen so dicht beieinander, sodas es "+
    "praktisch unmoeglich fuer dich ist, dich durchzuzwaengen.");
  AddDetail ( ({"boden"}),
    "Am Boden liegen viele morsche Aeste herum.");
  AddDetail ( ({"himmel"}),
    "Den Himmel kannst du wegen des dichten Unterholzes nicht sehen.");
  AddDetail ( ({"schneise"}),
    "Eine kleine Schneise fuehrt von hier aus nach Osten. Wer sie wohl "+
    "hier ins Unterholz geschlagen hat ?");
  AddDetail ( ({"osten"}),
    "Da die Schneise sehr eng ist, kannst du von hier aus nicht sehen, was "+
    "sich im Osten befindet.");
  // DETAILS END

  // EXITS START
  AddExit ("norden", "./a3");
  AddExit ("nordwesten", "./a2");
  AddExit ("osten", "./a5");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
