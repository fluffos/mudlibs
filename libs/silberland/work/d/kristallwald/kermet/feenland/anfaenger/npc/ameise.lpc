inherit "std/npc";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp (P_SHORT, "Eine Ameise");
  SetProp (P_LONG, "Eine kleine, kleine Ameise.");
  SetProp (P_NAME_ADJ, "klein");
  SetProp (P_NAME, "Ameise");
  SetProp(P_RACE, "Ameise");
  SetProp (P_GENDER, FEMALE);
  AddId ("ameise");
  AddAdjective ( ({"klein", "kleine"}) );
  create_default_npc (1);
  SetProp (P_SIZE, 2);
  SetProp (P_HANDS, ({" mit seinen kleinen Beinen", 10+random(20) }));
  SetProp (P_ALIGN, random(1));

  SetProp(P_KILL_MSG, "Hehe, und tot...");
  SetProp(P_MURDER_MSG, "Argl, ich bin doch noch so klein...");

}

