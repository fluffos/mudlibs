inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../carolina.h"

int anz_flieder;

void reset()
{
  ::reset();
  anz_flieder = 1;
}


void create()
{
  
  ::create();
  anz_flieder = 1;
  SetProp(P_INT_SHORT, "In einem kleinen Garten");
  SetProp(P_INT_LONG, 
     "Du stehst mitten in Wassertroepfchens Garten. "
     "Im Norden befindet sich ihr kleines Domizil. "
     "Unter dem Fenster steht ein Baenkchen, auf das die Sonne "
     "herunterstrahlt. Daneben siehst Du einen grossen Fliederbusch, "
     "der wundervolle lila Blueten traegt, die wirklich toll duften! ");
     
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_PLAIN]) );

  AddExit( "nordwesten", ROOM "garten_a2");
  AddExit( "osten", ROOM "garten_c1");

  AddDetail( ({ "haeuschen", "haus", "domizil" }),
    "Im Norden befindet sich ein weissgestrichenes Haeuschen "
    "mit einem Fenster. ");

  AddDetail( ({ "fenster" }),
    "Das Fenster besitzt Holzlaeden die weit geoeffnet sind. Vielleicht "
    "kann man durch das Fenster ins Innere des Haeuschen blicken. ");

  AddDetail( ({ "holzlaeden", "laeden" }),
    "Die Holzlaeden stehen weit offen, damit das Sonnenlicht auch ins "
    "Innere des Haeuschens gelangt. ");

  AddDetail( ({ "sonne" }),
    "Wie eine grosse gelbe Kugel steht die Sonne am Himmel und laechelt "
    "Dich an. ");

  AddDetail( ({ "kugel" }),
    "Die Sonne sieht aus wie eine grosse gelbe Kugel. ");

  AddDetail( ({ "innere" }),
    "Leider kannst Du das Innere von hier nicht erkennen. ");

  AddDetail( ({ "himmel" }),
    "Hoch am Himmel steht die brennende Sonne und laechelt Dich freundlich "
    "an. Wirklich ein wunderbarer Tag! ");

  AddDetail( ({ "boden" }),
    "Ein kleiner Kiesweg fuehrt direkt bis zu diesem Haeuschen hier. "
    "Alles sieht sehr gepflegt und sauber aus. ");

  AddDetail( ({ "kiesweg", "weg", "kieselweg" }),
    "Du befindest Dich auf einem Kiesweg. Ueberall liegen quer verstreut "
    "kleine Kieselsteinchen und strahlen etwas Einzigartiges aus. ");
 
  AddDetail( ({ "kieselsteinchen", "steinchen" }),
    "Sie haben alle eine andere Form. Manche sind eckig, manche rund, andere "
    "auch oval. ");

  AddDetail( ({ "form", "formen" }),
    "Viele verschiedenen Formen. ");

  AddDetail( ({ "einzigartiges" }),
    "Vollkommene Ruhe und Frieden. ");

  AddDetail( ({ "ruhe", "frieden" }),
    "Wirklich ein schoener Garten! ");

  AddDetail( ({ "garten" }),
    "Du befindest Dich gerade in dem Garten. ");
 
  AddDetail( ({ "fliederbusch", "flieder", "busch" }),
    "Ein Fliederbusch befindet sich direkt neben dem kleinen Holzbaenkchen. "
    "Seine lila Blueten duften einfach herrlich. Zwischen seinen dunklen, "
    "dichten Blaettern tummeln sich viele Insekten. ");

  AddDetail( ({ "insekten" }),
    "Hauptsaechlich Bienen die sich auf der Suche nach Nektar befinden, aber "
    "auch einige Zitronenfalter kannst Du erkennen. ");

  AddDetail( ({ "zitronenfalter", "falter" }),
    "Wunderschoene Schmetterlinge, die sich zwischen den Blaettern des "
    "Flieders anscheinend wohl fuehlen. ");

  AddDetail( ({ "bienen" }),
    "Sie suchen Nektar in den Blueten des Flieders. ");

  AddDetail( ({ "nektar" }),
    "Die Bienen sammeln hier Nektar um einen wunderbaren Honig daraus "
    "gewinnen zu koennen. ");

  AddDetail( ({ "honig" }),
    "Hier kannst Du nirgends welchen entdecken, aber vielleicht wirst Du "
    "ja im Haus fuendig. ");

  AddDetail( ({ "schmetterlinge", "schmetterling" }),
    "Einige Zitronenfalter tummeln sich zwischen den Blaettern des "
    "Flieders. ");

  AddDetail( ({ "suche" }),
    "Einige Bienen haben sich auf die Suche nach Nektar aufgemacht. ");

  AddDetail( ({ "haut" }),
    "Ein angenehmes Gefuehl durchzieht Deinen Koerper. ");

  AddDetail( ({ "gefuehl" }),
    "Das kann man leider gar nicht beschreiben, aber es fuehlt sich "
    "wunderschoen an. ");

  AddDetail( ({ "koerper" }),
    "Alles noch dran. ");

  AddDetail( ({ "tag" }),
    "Ein wirklich wunderbarer Tag! ");

  AddDetail( ({ "blaetter" }),
    "Der Flieder besitzt dunkle grosse Blaetter, die in der Sonne in einem "
    "saftigen Gruen leuchten. ");

  AddDetail( ({ "gruen" }),
    "Strahlendes Gruen. ");

  AddDetail( ({ "hauswand", "wand" }),
    "Das Baenkchen steht direkt an der Hauswand, und kann sich so durch "
    "die Sonneneinstrahlung schoen erwaermen. Ein wunderbarer Ort zum "
    "Entspannen! ");

  AddDetail( ({ "ort" }),
    "Du befindest Dich in einem Garten. ");

  AddDetail( ({ "sonneneinstrahlung", "einstrahlung" }),
    "Die Sonne leuchtet kraeftig vom Himmel und erwaermt alles. ");

  AddDetail( ({ "entspannen" }),
    "Du beschliesst, einmal hier herzukommen um Dich zu entspannen, wenn Du "
    "genuegend Zeit hast. ");

  AddDetail( ({ "zeit" }),
    "Die vergeht leider viel zu schnell. ");

  AddDetail( ({ "blueten", "bluete", "lila blueten" }),
    "Der Flieder hat kleine, zierliche lila Blueten, von denen ein betoerender "
    "Duft ausgeht. ");

  AddDetail( ({ "baenkchen", "holzbaenkchen" }),
    "Ein Holzbaenkchen steht unter dem Fenster an der Hauswand. Es laedt Dich "
    "zum Entspannen ein. Daneben befindet sich ein grosser Fliederbusch, "
    "dessen Blueten einen angenehmen Duft verstroemen. ");

  AddDetail( ({ "duft" }),
    "Probier es doch einmal mit 'riechen' :) ");

  AddDetail( ({ "gras" }),
    "Oestlich und westlich von Dir siehst Du dichtes Gras und viele "
    "Blumen. Um es zu untersuchen, muesstest Du allerdings naeher "
    "heran gehen. ");

  AddDetail( ({ "sonnenlicht" }),
    "Das Sonnenlicht erhellt das Innere des kleinen Haeuschens und strahlt "
    "freundlich und warm auf Deine Haut. ");

  AddDetail( ({ "blumen", "blume" }),
    "Westlich und oestlich von Dir wachsen viele bunte Blumen. Hell und "
    "kraeftig leuchten ihre Farben in der Sonne. ");

  AddDetail( ({ "farbe", "farben" }),
    "Kraeftig und leuchtend sind die Farben der Blumen. ");
 
//SMELLS

  AddSmell(DEFAULT_SMELL, 
    "Die Blumen verstroemen einen wunderbar suesslichen Duft. ");

  AddSmell( ({ "blumen", "blume" }),
    "Du fuehlst Dich wie zu Hause. ");

  AddSmell( ({ "hause" }),
    "Wirklich maerchenhaft. ");

  AddSmell( ({ "duft" }),
    "Traumhaft, nicht wahr? ");

// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Ein Surren und Summen geht vom Flieder aus. ");

  AddSound( ({ "surren", "summen" }),
    "Anscheinend befinden sich in einigen Blueten ein paar Bienen. ");

  AddSound( ({ "bienen", "biene" }),
    "*summ* summ*");

  AddSound( ({ "blueten", "bluete" }),
    "Aus einigen Blueten scheint ein Summen zu kommen. ");

  AddSound( ({ "flieder" }),
    "Tiefe 'Brummgeraeusche' dringen an Dein Ohr. ");

  AddSound( ({ "geraeusche", "brummgeraeusche" }),
    "Das stammt wohl von den Bienen. ");

  AddSound( ({ "ohr" }),
    "Nein, das geht nun wirklich nicht! ");

  

  AddCmd( ({ "blick", "blicke" }), "c_blicken");  
  AddCmd( ({ "setze", "setz", "sitz", "sitze" }), "c_setzen");
  AddCmd( ({ "pflueck", "pfluecke" }), "c_pfluecken");

}


int c_blicken( string str )
{
 if( str != "durch fenster" )
 {
  notify_fail("Wo willst Du durchblicken?\n");
  return 0;
 }
 else
 {
  write("Vorsichtig wagst Du einen Blick durch das Fenster...\n"
        "Huch! Hat sich da nicht gerade jemand bewegt?\n"
        "Erschrocken weichst Du zurueck.\n");
  return 1;
 }
}

int c_setzen( string str )
{
 if(str != "auf baenkchen" && str != "baenkchen" )
 {
  notify_fail("Worauf moechtest Du Dich setzen?\n");
  return 0;
 }
 if( str == "auf baenkchen" ||
     str == "baenkchen"     )
 {
  write("Du setzt Dich auf das kleine Holzbaenkchen, geniesst "
        "die Sonnenstrahlen auf Deiner Haut und den suessen Duft "
        "des Flieders.\n"
        "Doch das Silberland ruft erkundet zu werden und so stehst Du "
        "wieder auf.\n");
  return 1;
 }
}

int c_pfluecken( string str )
{
 object ob;
 if( str != "flieder" &&
     str != "fliederzweige" &&
     str != "zweige" &&
     str != "fliederblueten" &&
     str != "blumen" &&
     str != "blume" )
 {
  notify_fail("Was moechtest Du pfluecken?\n");
  return 0;
 }
 if( str == "blumen" ||
     str == "blume"  )
 {
  write(BS("So schoene Blumen moechtest Du nicht einfach pfluecken."));
  return 1;
 }
 if( str == "flieder"        ||
     str == "fliederzweige"  ||
     str == "zweige"         ||
     str == "fliederblueten" )
 {
  if( anz_flieder < 1 )
  {
   write(BS("Die Fliederzweige bluehen viel zu schoen, und Du moechtest "
            "wirklich keine Zweige pfluecken. "));
   return 1;
  }
  else 
  {
   write(BS("Du pflueckst einige Fliederzweige und machst damit einen "
            "schoenen Strauss. "));
   say(CTPN+ " freut sich.\n");
   ob = clone_object(OBJ "flieder" );
   if(ob->move(this_player(), M_GET) != 1)
   {
    tell_object(this_player(), "Das kannst Du nicht mehr tragen!\n");
    ob->move(this_object(), M_NOCHECK);
   }
   anz_flieder--;
   return 1;
  }
 }
} 
   
 




