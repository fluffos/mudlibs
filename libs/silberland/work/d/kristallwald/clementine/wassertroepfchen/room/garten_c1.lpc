


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../carolina.h"

int anz_grille;

void reset()
{
 ::reset();
 anz_grille = 1;
}


void create()
{
  ::create();
  anz_grille = 1;
  SetProp(P_INT_SHORT, "In einem kleinen Garten");
  SetProp(P_INT_LONG,
    "Du stehst auf einem schmalen Kiesweg, der im Norden an einem "
    "Haus endet und im Sueden zu einem, von Rosen umwachsenen Gartentor "
    "fuehrt. Rechts und links der weissen Kieselsteinchen wechseln sich "
    "farbenfrohe Blueten mit dem frischem "
    "Gruen des Grases ab. Es scheint als wuerde der Garten um das kleine "
    "Haeuschen herumfuehren und voller Leben stecken. Aus dem Augenwinkel "
    "meinst Du sogar etwas durch die Wiese krabbeln zu sehen. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_PLAIN]) );

  AddExit( "osten", ROOM "garten_d1" );
  AddExit( "norden", ROOM "haus1");
  AddExit( "westen", ROOM "garten_b1");
  AddExit( "sueden", ROOM "tor"); 

  AddItem(NPC "kaefer", REFRESH_DESTRUCT); 

// DETAILBEGINN


  AddDetail( ({ "norden" }),
    "Im Norden steht ein kleines Haeuschen. ");

  AddDetail( ({ "haus", "haeuschen"}),
    "Das kleine Haeuschen steht noerdlich von Dir. Die Tuer ist offen, Du "
    "kannst es also mit Sicherheit betreten, wenn Du dazu Lust hast.");

  AddDetail( ({ "sicherheit", "lust" }),
    "Wenn Du neugierig bist und wissen willst, was sich in dem Haeuschen "
    "befindet, dann mach ein paar Schritte nach Norden :)");

  AddDetail( ({ "schritte" }),
    "Tipp: >n< und schon bist Du drinnen.");

  AddDetail( ({ "tuer" }),
    "Die Tuer ist weit geoeffnet und laedt Dich foermlich in das Haeuschen "
    "ein.");

  AddDetail( ({ "kiesweg", "weg" }),
    "Der Kiesweg besteht, wie der Name schon sagt aus Kies. Kleine, dicke, "
    "duenne, grosse, eckige, runde und ovale Kieselsteine, die unter Deinen "
    "Fuessen knirschen.");

  AddDetail( ({ "fuesse", "fuss" }),
    "Deine Fuesse stehen auf einem Kiesweg.");

  AddDetail( ({ "gruen" }),
    "Jemand singt: Es gruuuuuuuuuuuuuuuuuuuent so gruuuuuuuuuuuuuuuen "
    "wenn Spaniens Bluuuuuuuuuuuuuuuuuueten bluuuuuuuuuuuuuuuuuuuuuuuehen.");

  AddDetail( ({ "jemand", "niemand" }),
    "Du blickst etwas paranoid um Dich herum, kannst aber niemanden "
    "entdecken.");

  AddDetail( ({ "steine", "kieselsteine" }),
    "Die Kieselsteine bilden alle zusammen einen Kiesweg. Und auf diesem "
    "stehst Du momentan. Oder moechtest Du Dir vielleicht alle Kieselsteine "
    "einzeln ansehen?");

  AddDetail( ({ "ovale steine", "ovale kieselsteine" }),
    "Du nimmst ein paar ovale Kieselsteine in die Hand und musterst sie "
    "genau. Zu Deiner Ueberraschung sind sie wirklich oval.");

  AddDetail( ({ "stein", "kieselstein" }),
    "Welchen meinst Du genau?");

  AddDetail( ({ "runde steine", "runde kieselsteine" }),
    "Die runden Kieselsteine sind - oh welch Wunder - rund!");

  AddDetail( ({ "wunder" }),
    "Na hoffentlich passiert bald eines...");

  AddDetail( ({ "eckige steine", "eckige kieselsteine" }),
    "Die eckigen Steine sind eckig! Wow!");

  AddDetail( ({ "grosse steine", "grosse kieselsteine" }),
    "Die grossen Kieselsteine sind groesser als die kleinen Kieselsteine.");

  AddDetail( ({ "kleine steine", "kleine kieselsteine" }),
    "Die kleinen Kieselsteine sind kleiner als die grossen!");

  AddDetail( ({ "dicke steine", "dicke kieselsteine" }),
    "Mann, sind die Dickmann....");

  AddDetail( ({ "dickmann" }),
    "Mjam...lecker!");

  AddDetail( ({ "duenne steine", "duenne kieselsteine" }),
    "Auch ein paar duenne Kieselsteine liegen am Weg, zwischen den "
    "grossen, kleinen, dicken, ovalen, eckigen, runden und bunten "
    "Steinen.");

  AddDetail( ({ "bunte steine", "bunte kieselsteine" }),
    "Hmm...seltsam. Mitten zwischen den weissen Steinchen liegt auch ein "
    "bunter...");

  AddDetail( ({ "steinchen" }),
    "Ja, davon gibts hier wirklich massig.");

  AddDetail( ({ "bunter kieselstein", "bunter stein" }),
    "Ob man irgendwas Verruecktes mit dem bunten Stein anstellen kann?");

  AddDetail( ({ "verruecktes" }),
    "Vielleicht solltest Du den Stein einmal anstubsen?"); 

  AddDetail( ({ "kies" }),
    "Damit sind die vielen Steinchen gemeint, die auf dem Boden liegen.");

  AddDetail( ({ "boden" }),
    "Auf dem stehst Du.");

  AddDetail( ({ "ueberraschung" }),
    "Du bist wirklich ueberrascht, dass ovale Steine auch oval sind...");

  AddDetail( ({ "kieselsteinchen" }),
    "Hier gibt es soviele Kieselsteinchen, dass aus ihnen sogar ein Weg "
    "angelegt wurde.");

  AddDetail( ({ "sonne" }),
    "Die ist hoch ueber Dir am Himmel. ");

  AddDetail( ({ "himmel" }),
    "Die Sonne scheint vom Himmel - weit und breit ist nicht mal das "
    "winzigste Woelkchen auszumachen.");

  AddDetail( ({ "woelkchen", "wolke", "wolken" }),
    "Nicht einmal die geringste Spur von einer Wolke heute am Himmel. Der "
    "perfekte Sonnentag!");

  AddDetail( ({ "sonnentag", "tag" }),
    "Heute ist so ein Tag; die Sonne scheint vom Himmel und es sind "
    "nirgends Wolken zu sehen.");

  AddDetail( ({ "spur" }),
    "Nicht die geringste zu sehen!");

  AddDetail( ({ "garten" }),
    "Momentan stehst Du mitten drinnen im Garten. Ob er um das Haeuschen "
    "herumfuehrt? ");

  AddDetail( ({ "spanien", "bluuuuuuuuuuuuuuuuuueten" }),
    "Spanien liegt ausserhalb Deiner Reichweite und das Wort Blueten mit 18 "
    "u ohnehin!");

  AddDetail( ({ "wort", "worte", "woerter" }),
    "Woerter gibt es hier viele. Suchst Du ein bestimmtes?");

  AddDetail( ({ "reichweite" }),
    "Das Wort Reichweite springt aus Deiner Reichweite - untersuchen "
    "zwecklos ,)");

  AddDetail( ({ "name" }),
    "Es gibt viele Namen. Ich heisse z.B. Clementine. Der Kiesweg traegt den "
    "Namen Kiesweg.");

  AddDetail( ({ "clementine" }),
    "Die hat das ganze hier verbrochen...");

  AddDetail( ({ "rosen", "rose" }),
    "Weiter suedlich befindet sich ein Gartentor, dass von Rosen umwachsen "
    "ist. Du hast es bestimmt schon gesehen, denn anders waerst Du hier ja "
    "auch gar nicht hineingekommen.");

  AddDetail( ({ "gartentor", "tor" }),
    "Das Gartentor ist suedlich von Dir - weisst Du doch! Du bist doch "
    "da durchgegangen vorhin!");

  AddDetail( ({ "gras", "grases" }),
    "Rechts und links von Dir waechst gruenes Gras - wie das in einem Garten "
    "so ueblich ist. Wobei ich hab mir sagen lassen, dass es Menschen gibt "
    "die ihren Garten betonieren und dann gruen streichen.");
 
  AddDetail( ({ "menschen", "mensch" }),
    "Der Mensch ist schon eine komische Rasse...");

  AddDetail( ({ "rasse", "rassen" }),
    "Im Silberland gibt es mehrere Rassen -> hilfe rassen");

  AddDetail( ({ "wiese" }),
    "Die Wiese steckt hier bestimmt voller Leben. Man muss sich nur Zeit "
    "lassen und gedulden bzw. ganz genau hinsehen, damit man all die kleinen "
    "Tiere sieht, die in ihr wohnen.");

  AddDetail( ({ "zeit" }),
    "Zeit ist kostbar heisst es... Dabei kann man sie sich ja immer nehmen. ");

  AddDetail( ({ "tiere", "tier" }),
    "Bestimmt findest Du ein paar wenn Du nur genau hinsiehst.");

  AddDetail( ({ "silberland" }),
    "Dunkelheit am Horizont... doch da, ein Silberstreif... SILBERLAND!");

  AddDetail( ({ "dunkelheit", "horizont" }),
    "Die Dunkelheit am Horizont wirst Du hier vergebens suchen.");

  AddDetail( ({ "silberstreif" }),
    "Momentan ist keiner da.");

  AddDetail( ({ "leben" }),
    "Da! Hat sich hier nicht gerade etwas bewegt?! Kuck doch mal!");

  AddDetail( ({ "augenwinkel" }),
    "Jetzt ist es wieder weg... seltsam... War da jetzt etwas, oder doch "
    "nichts?");

  AddDetail( ({ "blueten", "bluete" }),
    "Ueberall in der Wiese sieht man schoene bunte Blueten - blaue, gelbe, "
    "violette, rote. Sie sind wirklich schoen anzusehen.");

  AddDetail( ({ "violette blueten", "violette bluete" }),
    "Violette Bluetenkoepfe wechseln sich mit blauen, gelben und roten ab.");

  AddDetail( ({ "violette bluetenkoepfe", "bluetenkoepfe" }),
    "Sie sehen Veilchen zum Verwechseln aehnlich.");

  AddDetail( ({ "veilchen" }),
    "Tatsaechlich! Es sind Veilchen.");

  AddDetail( ({ "blaue blueten", "blaue bluete" }),
    "Sie sind wirklich schoen!");

  AddDetail( ({ "rote blueten", "rote bluete" }),
    "Die roten Blueten sehen wirklich entzueckend aus. Zu welcher Pflanze "
    "sie wohl gehoeren?");

  AddDetail( ({ "pflanze" }),
    "Dir faellt leider nicht ein, wie sie heisst.");

  AddDetail( ({ "gelbe blueten", "gelbe bluete" }),
    "Die gelben Blueten sehen aus wie Butterblumen.");

  AddDetail( ({ "butterblumen", "butterblume" }),
    "Sie haben kraeftig leuchtende gelbe Blueten.");

  AddDetail( ({ "blumen", "blume" }),
    "Welche meinst Du denn?");

  AddDetail( ({ "nase" }),
    "Deine Nase ist da wo sie sein soll.");


// SMELLS

  AddSmell(DEFAULT_SMELL, 
    "Es duftet herrlich nach Gras und Blumen.");

  AddSmell( ({ "gras" }),
    "Du tunkst Deine Nase ins Gras und riechst daran. Es riecht nach Gras!");

  AddSmell( ({ "blumen", "blueten" }),
    "Die Blumen riechen einfach maerchenhaft.");


// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Manchmal hoerst Du ein Rascheln im Gras. ");

  AddSound( ({ "gras" }),
    "Manchmal raschelt es im Gras.");

  AddSound( ({ "rascheln" }),
    "Jetzt ist es schon wieder weg :(");



// COMMANDS


  AddCmd( ({ "stubs", "stubse" }), "c_stubsen");
  AddCmd( ({ "pflueck", "pfluecke" }), "c_pfluecken");
  AddCmd( ({ "seh", "sehe" }), "c_sehen");
  AddCmd( ({ "schliess", "schliesse" }), "c_schliessen");



}

int c_stubsen(string str)
{
 object ob;
 if( str != "stein an" &&
     str != "bunten stein an" &&
     str != "bunten kieselstein an")
 {
  notify_fail("Stubs was oder wen an?\n");
  return 0;
 }
 else
 {
  if(anz_grille < 1)
  {
   write(BS("Du stubst den bunten Kieselstein an, doch leider passiert "
            "ueberhaupt nichts. Vielleicht solltest Du es spaeter nochmals "
            "probieren."));
   return 1;
  }
  else
  {
   write(BS("Du stubst den bunten Kieselstein an. Ploetzlich beginnt sich "
            "der Stein zu bewegen."));
   say(CTPN+ " kuckt verdutzt.\n");
   ob = clone_object(NPC "grille");
   if(ob->move (ROOM "garten_c1", M_GO, M_SILENT));  
  }
  anz_grille--;
  return 1;
 }
}


int c_pfluecken(string str)
{
 if( str != "veilchen" )
 {
  notify_fail("Was moechtest Du hier pfluecken?\n");
  return 0;
 }
 else
 {
  write(BS("Die Veilchen moechten nicht von Dir gepflueckt werden - "
           "und Wassertroepfchen waere damit bestimmt auch nicht "
           "einverstanden."));
  return 1;
 }
}



int c_sehen(string str)
{
 if( str != "alle kieselsteine einzeln an" &&
     str != "alle steine einzeln an")
 {
  notify_fail("Was moechtest Du Dir ansehen?\n");
  return 0;
 }
 else
 {
  write(BS("Ist Dir etwas langweilig? Wenn Du wirklich alle Steine "
           "genauer ansehen moechtest, dann probiers doch einfach mit "
           "unt ovale kieselsteine, unt runde kieselsteine, ..."));
  return 1;
 }
}


int c_schliessen(string str)
{
 if( str != "tuer")
 {
  notify_fail("Was moechtest Du schliessen?\n");
  return 0;
 }
 else
 {
  write(BS("Die Tuer mag aber nicht geschlossen werden!"));
  return 1;
 }
}

