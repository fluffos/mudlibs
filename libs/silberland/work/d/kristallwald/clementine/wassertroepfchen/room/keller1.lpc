inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../carolina.h"

int anz_stein;

void reset()
{
 ::reset();
 anz_stein = 1;
}

void create()
{
  ::create();
  anz_stein = 1;
  SetProp(P_INT_SHORT, "In einem Keller");
  SetProp(P_INT_LONG,
    "Du befindest Dich in einem Keller. Die Waende bestehen vollkommen aus "
    "Stein. "
    "Von oben kommt etwas Sonnenlicht herein. Sowohl nach Sueden, als auch "
    "nach Osten scheint der Keller in einer Sackgasse zu enden. An der "
    "Westwand siehst Du ein grosses vollgeraeumtes Regal. Ueber die "
    "hoelzerne Treppe kommst Du wieder nach oben in Wassertroepfchens " 
    "Wohnraeume. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);

  AddExit( "osten", ROOM "keller3" );
  AddExit( "sueden", ROOM "keller2" );
  AddExit( "rauf", ROOM "haus2" );


// DETAILBEGINN

  AddDetail( ({ "keller", "raum" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "sonnenlicht", "licht" }),
    "Von oben kommt etwas Sonnenlicht in den Keller, sodass man auch als "
    "Nichtdunkelelf etwas sehen kann. ");

  AddDetail( ({ "nichtdunkelelf" }),
    "Ein Nichtdunkelelf ist jemand, der kein Dunkelelf ist. ");

  AddDetail( ({ "dunkelelf", "dunkelelfen" }),
    "Dunkelelfen sehen auch im Dunklen was :)");

  AddDetail( ({ "dunkel", "dunkle" }),
    "Hier ist es durch das Sonnenlicht, dass von oben hereinkommt nicht "
    "dunkel. ");

  AddDetail( ({ "stein" }),
    "Der Keller wurde aus Stein gebaut und bildet daher wohl auch so ein "
    "stabiles Fundament. ");

  AddDetail( ({ "fundament" }),
    "Aus sehr hartem Stein wurde dieser Keller gebaut. Ob der Stein im "
    "Bergwerk von Felonia abgebaut wurde?");

  AddDetail( ({ "bergwerk" }),
    "In Felonia ist eines!");

  AddDetail( ({ "felonia", "stadt" }),
    "Felonia ist die Stadt der Zwerge und befindet sich im Norden. ");

  AddDetail( ({ "zwerge", "norden" }),
    "Die Zwerge leben im Norden - in Felonia.");

  AddDetail( ({ "westwand" }),
    "An der Westwand tuermt sich ein riesiges Regal, in dem ziemlich viele "
    "beschriftete Glaeser und auch zwei Giesskannen stehen. ");

  AddDetail( ({ "giesskannen", "giesskanne" }),
    "Im Regal an der Westwand befinden sich auch zwei Giesskannen. Eine "
    "ist rosa mit weissen Bluemchen, die andere gelb mit einer Ente "
    "abgebildet. Vermutlich benutzt Wassertroepfchen beide fuers Giessen. ");

  AddDetail( ({ "giessen" }),
    "Normalerweise benoetigt man zum Giessen eine Giesskanne. Andere nehmen "
    "auch einen Schlauch dazu. ");

  AddDetail( ({ "schlauch" }),
    "Hier kannst Du leider keinen entdecken. ");

  AddDetail( ({ "wassertroepfchen" }),
    "Wo Wassertroepfchen schon wieder ist? Am besten suchst Du sie mal im "
    "Haus oben. ");

  AddDetail( ({ "haus" }),
    "Du stehst in Wassertroepfchens Haus. Genauer gesagt stehst Du momentan "
    "im Keller. ");

  AddDetail( ({ "ente" }),
    "Auf der gelben Giesskanne ist eine Ente abgebildet. Sie hat einen "
    "knallroten Schnabel. ");

  AddDetail( ({ "schnabel" }),
    "Der Schnabel der Ente ist wirklich knallig rot. ");

  AddDetail( ({ "rot", "knallrot" }),
    "Ob das etwas zu bedeuten hat?");

  AddDetail( ({ "bluemchen" }),
    "Auf der rosa Giesskanne sind weisse Bluemchen drauf. Etwas skurril oder "
    "wohl eher kindlich, aber sehr huebsch anzusehen. ");

  AddDetail( ({ "sackgasse", "gasse" }),
    "Nach Osten und Sueden geht je ein Raum ab, aber weder beim einen noch "
    "beim anderen kannst Du weitere Durchgaenge ausmachen. ");

  AddDetail( ({ "durchgaenge" }),
    "Hier siehst Du einen Durchgang nach Osten und einen nach Sueden.");

  AddDetail( ({ "durchgang" }),
    "Nach Osten oder nach Sueden gehts weiter in andere Raeume. ");

  AddDetail( ({ "raeume" }),
    "Du musst schon selbst nachkucken gehen.");

  AddDetail( ({ "wand" }), 
    "Meinst Du eine bestimmte?");

  AddDetail( ({ "waende" }),
    "Die einzige Wand, die man untersuchen sollte ist die Westwand.");

  AddDetail( ({ "treppe" }),
    "Sie fuehrt nach oben in die Wohnraeume von Wassertroepfchen.");

  AddDetail( ({ "wohnraeume" }),
    "Am besten Du gehst nach oben und siehst sie Dir selbst an. ");

  AddDetail( ({ "boden" }),
    "Der Boden besteht wie der Rest des Raumes ebenfalls aus festem soliden "
    "Stein. Nichts Aussergewoehnliches. ");

  AddDetail( ({ "aussergewoehnliches" }),
    "Ein schlichter Steinboden.");

  AddDetail( ({ "steinboden" }),
    "Du kannst gerne mal fuehlen. ");

  AddDetail( ({ "decke" }),
    "Die Decke besteht wie der Boden und die Waende aus Stein. Eine "
    "Treppe fuehrt nach oben in die Wohnraeume.");

  AddDetail( ({ "rest" }),
    "Alles besteht hier aus Stein!");

  AddDetail( ({ "regal" }),
    "Das Regal ist riesig und steht direkt an der Westwand. In ihm "
    "befinden sich ganz viele beschriftete Glaeser mit einigen sehr "
    "seltsamen Inhalten.");

  AddDetail( ({ "inhalte", "inhalt" }),
    "Das beste ist sicher, dass Du Dir jedes Glas einzeln ansiehst. ");

  AddDetail( ({ "glas" }),
    "Welches Glas meinst Du denn genau?");

  AddDetail( ({ "glaeser" }),
    "In dem Regal stehen sehr viele Glaeser. Meinst Du vielleicht ein "
    "bestimmtes?");

// alle glaeser einzeln unten, oeffnen, schliessen, getrocknete sachen...

  AddDetail( ({ "glas 1", "glas eins" }),
    "Es traegt die Aufschrift: >Zimt< und hat ein braunes Pulver drinnen. ");

  AddDetail( ({ "zimt" }),
    "Eindeutig Zimt, der da im ersten Glas drinnen ist.");
 
  AddDetail( ({ "glas 2", "glas zwei" }),
    "Das zweite Glas traegt die Aufschrift >Basilikum - getrocknet<. ");

  AddDetail( ({ "basilikum" }),
    "Vielleicht braucht Wassertroepfchen das im Winter, wenn kein frisches "
    "mehr im Garten waechst.");

  AddDetail( ({ "garten" }),
    "Den wirst Du hier im Keller nicht finden.");

  AddDetail( ({ "glas 3", "glas drei" }),
    ">Rosenblueten<");

  AddDetail( ({ "rosenblueten" }),
    "Vielleicht nimmt Wassertroepfchen die immer fuers Badezimmer?");

  AddDetail( ({ "badezimmer" }),
    "Das ist oben!");

  AddDetail( ({ "glas 4", "glas vier" }),
    ">getrocknete Lavendelblueten - 2004<");

  AddDetail( ({ "lavendel", "lavendelblueten" }),
    "Na ob die von 2004 noch gut riechen...");

  AddDetail( ({ "glas 5", "glas fuenf" }),
    "Im fuenften Glas befinden sich komische Wurzeln, die nicht naeher "
    "identifiziert werden wollen.");

  AddDetail( ({ "wurzeln", "wurzel" }),
    "Besonders appetitlich sehen sie nicht gerade aus.");

  AddDetail( ({ "glas 6", "glas sechs" }),
    "Irgendwie erinnert Dich das schleimige Etwas an Blutegeln...");

  AddDetail( ({ "schleimiges etwas", "blutegel", "blutegeln" }),
    "Igiiiiiiiiiiiiiiiiiiiiiiitt!");

  AddDetail( ({ "glas 7", "glas sieben" }),
    "Auf Glas 7 sind ein paar schwarze Kirschen abgebildet... ");

  AddDetail( ({ "schwarze kirschen", "tollkirschen", "kirschen" }),
    "Ein Probieren von schwarzen Kirschen halte ich nicht fuer ratsam... wer "
    "weiss, was da drinnen ist.");

  AddDetail( ({ "probieren" }),
    "Nicht ratsam!");
   
  AddDetail( ({ "glas 8", "glas acht", "glas 9", "glas neun" }),
    "Irgendwie interessiert Dich dieses Glas nicht mehr. "); 
   


// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Es riecht nach frischen Gewuerzen und Blumen. ");

  AddSmell( ({ "gewuerze", "blumen" }),
    "Du kannst nicht genau ausmachen, woher der Geruch kommt. Vermutlich aber "
    "aus dem Haus selbst.");

  AddSmell( ({ "geruch" }),
    "Du versuchst etwas genauer festzustellen, woher der angenehme "
    "Geruch kommt... dabei entdeckst Du ploetzlich eine kleine gelbe "
    "Schachtel im Regal.");

  AddDetail( ({ "schachtel" }),
    "Was meinst Du?");

  AddDetail( ({ "gelbe schachtel" }),
    "Aus ihr duftet es nach frischen Gewuerzen und Blumen. Du koenntest sie "
    "ja oeffnen und nachsehen, was drinnen ist.");

  AddSmell( ({ "gelbe schachtel" }),
    "Aus ihr duftet es herrlich!");


// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Es ist absolut still hier.");

  AddSound( ({ "stille" }),
    "\n");

 
 
// COMMANDS

  AddCmd( ({ "fuehl", "fuehle" }), "c_fuehlen");
  AddCmd( ({ "oeffne" }), "c_oeffnen");


}


int c_fuehlen(string str)
{
 if(str != "steinboden" &&
    str != "boden")
 {
  notify_fail("Was moechtest Du fuehlen?\n");
  return 0;
 }
 else
 {
  write(BS("Du beugst Dich runter und beruehrst mit Deiner Hand den Boden. "
           "Tatsaechlich - er besteht aus Stein!"));
  say(CTPN + " kniet nieder und fuchtelt komisch herum.\n");
  return 1;
 }
}

int c_oeffnen(string str)
{
 object ob;
 if( str != "gelbe schachtel")
 {
  notify_fail("Was moechtest Du hier oeffnen?\n");
  return 0;
 }
 else
 {
  if(anz_stein < 1)
  {
   write(BS("Du oeffnest die gelbe Schachtel.\n"
            "Zu Deiner Enttaeuschung ist sie komplett leer, deswegen schliesst "
            "Du sie wieder."));
   return 1;
  }
  else
  {
   write(BS("Du oeffnest die gelbe Schachtel und findest einen kleinen "
            "Gegenstand, den Du schnell einsteckst. Unauffaellig schliesst "
            "Du die Schachtel wieder."));
   say(CTPN+ " fummelt an sich herum.\n");
   ob = clone_object(OBJ "stein");
   if(ob->move(TP, M_GET) != 1)
   {
    tell_object(TP, "Das kannst Du nicht mehr tragen!\n");
    ob->move(TO, M_NOCHECK);
   }
   anz_stein--;
   return 1;
  }
 }
}


