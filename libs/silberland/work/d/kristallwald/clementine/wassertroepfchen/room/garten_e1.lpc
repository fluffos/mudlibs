

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../carolina.h"

int anz_fisch;

void reset()
{
 ::reset();
 anz_fisch = 1;
}

void create()
{
  ::create();
  anz_fisch = 1;
  SetProp(P_INT_SHORT, "In einem kleinen Garten");
  SetProp(P_INT_LONG, 
     "Du stapfst sanft durch das Gras und lauschst dem Gesang "
     "der Voegel. Es scheint als wuerde Dir die Sonne "
     "richtig vom Himmel herab zuzwinkern. Das Gras ist relativ hoch hier, "
     "im Gegensatz zu anderen Teilen des Gartens, und Du glaubst "
     "Schilf erkennen zu koennen. Ein kleiner "
     "Teich wurde hier angelegt, einige Libellen sonnen sich auf "
     "runden Steinen die am Rand angebracht wurden. In der Luft "
     "liegt der Duft von vielen verschiedenen Blueten. Herrlich! ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_PLAIN]) );

  AddExit( "norden", ROOM "garten_e2" );
  AddExit( "westen", ROOM "garten_d1" );

  AddItem(NPC "libelle", REFRESH_DESTRUCT);

// DETAILBEGINN

  AddDetail( ({ "boden" }),
     "Vor lauter Gras kannst Du kaum den Boden erspaehen. Aber nach "
     "einiger Zeit gruendlicher Anschauung kannst Du etwas Erde "
     "durch das Gras hervorblinzeln sehen. ");

  AddDetail( ({ "gras" }),
     "Das Gras geht Dir hier bestimmt bist zur Huefte, so hoch ist es. "
     "Das verleiht wohl diesem Teil des Gartens und dem Teich seine "
     "ganz persoenliche Atmosphaere. ");

  AddDetail( ({ "erde" }),
     "Sie blinzelt manchmal durch das Gras hervor. ");

  AddDetail( ({ "anschauung" }),
    "Gebannt schaust Du zu Boden. ");

  AddDetail( ({ "zeit" }),
    "Zeit kommt, Zeit geht, aber wenn Du Dich nicht beeilst, wird "
    "Wassertroepfchen nie gesund werden. ");

  AddDetail( ({ "wassertroepfchen", "troepfchen" }),
    "Sie ist nicht hier. ");

  AddDetail( ({ "atmosphaere" }),
     "Du fuehlst Dich rundherum wohl hier und richtig entspannt. "
     "Am liebsten wuerdest Du hier ewig bleiben. ");

  AddDetail( ({ "steine" }),
     "Wassertroepfchen hat hier anscheinend den Teich mit Steinen "
     "umrandet. Einige Libellen sonnen sich mit ihren schillernden "
     "Fluegel auf ihnen. ");

  AddDetail( ({ "libellen", "libelle" }),
     "Die Fluegel der Libellen glitzern direkt in der Sonne. Du bist "
     "von der Schoenheit dieser Geschoepfe wirklich beeindruckt. "
     "Friedlich ruhen sie auf den Steinen. ");

  AddDetail( ({ "fluegel" }),
     "Duenne schlanke Fluegel glitzern in allen Farben des Regenbogens. ");

  AddDetail( ({ "farben" }),
    "Schillernd bunt glitzern die Fluegel der Libellen in der Sonne. ");

  AddDetail( ({ "regenbogen" }),
     "Leider kannst Du momentan keinen sehen. Vielleicht kommst Du ja "
     "ein anderes Mal wieder her. ");

  AddDetail( ({ "mal" }),
     "Irgendwann einmal. ");

  AddDetail( ({ "schilf" }),
     "Tatsaechlich! Um den Teich waechst etwas Schilf. Die braunen "
     "Halme bewegen sich sanft im Wind. ");

  AddDetail( ({ "gesang" }),
     "Du musst schon lauschen damit Du diesen wunderbaren Gesang "
     "vernehmen kannst. ");

  AddDetail( ({ "huefte" }),
     "Also das Gras ist hier wirklich hoch. So richtig verwildert "
     "sieht alles aus, vielleicht findest Du hier ja auch einige "
     "Wildblumen. ");

  AddDetail( ({ "wildblumen" }),
     "Leider kannst Du keine Wildblumen entdecken. Jemand scheint sie "
     "wohl schon gepflueckt zu haben. "); 

  AddDetail( ({ "huefte" }),
     "Das Gras reicht Dir hier bis zur Huefte. Es ist ganz besonders hoch "
     "in diesem Teil des Gartens. ");

  AddDetail( ({ "teil" }),
     "Das Gras ist hier besonders hoch. ");

  AddDetail( ({ "voegel" }),
    "Sehen kannst Du keine, aber ihrem wunderschoenen Gesang lauschen. ");

  AddDetail( ({ "gesang" }),
    "'Gesang' kannst Du nicht sehen, aber ihm vielleicht lauschen? ");

  AddDetail( ({ "himmel" }),
    "Hoch ueber Dir befindet sich die Sonne am Himmel. ");

  AddDetail( ({ "sonne" }),
    "Sie scheint Dir zuzuzwinkern :)");
 
  AddDetail( ({ "halme", "schilfhalme" }),
    "Die Schilfhalme bewegen sich sanft im Wind. ");

  AddDetail( ({ "wind" }),
    "Ein sanfter Wind streift um den Teich und bewegt so die Halme. ");

  AddDetail( ({ "luft" }),
    "Die Luft kannst Du nicht sehen. ");
  
  AddDetail( ({ "gegensatz", "vergleich" }),
    "Das Gras steht hier deutlich hoeher im Vergleich zu anderen Ecken "
    "des Gartens. ");

  AddDetail( ({ "blueten" }),
    "Die Blueten verstroemen einen traumhaften Duft. Du solltest "
    "einmal an ihnen riechen. ");
 
  AddDetail( ({ "ecken" }),
    "Sieh Dich einfach ein wenig um. ");

  AddDetail( ({ "gartens", "garten" }),
    "Du befindest Dich gerade in einem Garten, blick Dich doch einfach "
    "etwas laenger um. ");
 
  AddDetail( ({ "rand" }),
    "Der Teich wurde mit Steinen umrandet, auf denen sich einige Libellen "
    "sonnen. ");

  AddDetail( ({ "teich" }),
    "Ein kleiner Teich befindet sich hier. Das Wasser duerfte nicht allzu tief "
    "sein, da Du bist auf den Grund sehen kannst. In dem Teich tummeln sich "
    "einige Fische. ");

  AddDetail( ({ "grund" }),
    "Du kannst bis auf den Grund des Teiches sehen. ");

  AddDetail( ({ "fisch", "fische" }),
    "Einige orangefarbene Fische tummeln sich im Teich. ");

  AddDetail( ({ "goldfisch", "goldfische" }),
    "Richtig, ein Goldfischteich. Sie tummeln sich vergnuegt im Wasser. ");

  AddDetail( ({ "wasser" }),
    "Das Wasser ist ganz klar und sauber. Ob man es trinken kann? ");

  AddDetail( ({ "goldfischteich" }),
    "Einen so liebevoll gestalteten Teich hast Du noch nie zuvor gesehen. ");

  AddDetail( ({ "schoenheit" }),
    "Sie sind wunderschoen. ");

  AddDetail( ({ "geschoepfe" }),
    "Welch beeindruckende Geschoepfe die Libellen doch sind. Noch nie zuvor "
    "hast Du so ein anmutiges Insekt gesehen. ");

  AddDetail( ({ "insekt", "insekten" }),
    "Die Libellen gehoeren der Rasse der Insekten an. ");

  AddDetail( ({ "duft" }),
    "Probiere es doch einfach mit 'riechen'. ");

  AddDetail( ({ "frosch", "froesche" }),
    "Leider kannst Du keine entdecken.");


// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Ein herrlicher Duft von Blueten liegt in der Luft.");

  AddSmell( ({ "luft" }),
    "Die Luft ist erfuellt vom Duft der Blueten, die ihr wachsen.");

  AddSmell( ({ "duft" }),
    "Riecht das nicht einmalig?! ");

  AddSmell( ({ "bluete", "blueten" }),
    "Du schnupperst an den Blueten - sehr eigenwilliger, wenn auch angenehm "
    "suesser Geruch.");

  AddSmell( ({ "geruch" }),
    "Suess!");


// SOUNDS

  AddSound(DEFAULT_SOUND, 
    "Ein paar Voegel zwitschern und von irgendwoher dringt auch ein Quaken "
    "an Dein Ohr." );

  AddSound( ({ "quaken" }),
    "Quaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaak.");

  AddSound( ({ "froesche", "frosch" }),
    "Quak, quak, quak, quak, quakquakquak.");

  AddSound( ({ "gesang" }),
    "Die Voegel zwitschern vor sich hin.");

  AddSound( ({ "zwitschern", "voegel" }),
    "Du lauscht dem Zwitschern der Voegel - anscheinend haben sie gerade "
    "ihre Paarungszeit.");

  AddSound( ({ "paarungszeit" }),
    "Momentan nimmst Du ausser dem Zwitschern keine sonderbaren Restgeraeusche "
    "wahr.");

  AddSound( ({ "geraeusche", "restgeraeusche" }),
    "Nichts!");



  AddSpecialDetail( ({ "rasse" }), "rasse");
  AddCmd( ({ "zwinker", "zwinkere", "zwinkre" }), "c_zwinkern");
  AddCmd( ({ "fang", "fange" }), "c_fangen"); 
  AddCmd( ({ "fisch", "fische" }), "c_fischen");
  AddCmd( ({ "werf", "werfe", "wirf" }), "c_werfen");

}

int c_werfen(string str)
{
   object goldfisch;
   
   goldfisch = present(GOLDFISCH, TP);

  	if(str != "goldfisch in wasser"  &&
           str != "fisch in wasser" &&
           str != "fisch in see" &&
           str != "fisch in teich" &&
           str != "goldfisch in see" &&
           str != "goldfisch in teich" )
	{
	 notify_fail("Was moechtest Du werfen?\n");
         return 0;
 	}
	else
	{
	 if(!goldfisch)
	 {
	  write("Du hast ja gar keinen Goldfisch dabei!\n");
          return -1;
         }
         else
	 {
	  write(BS("Du wirfst den Goldfisch wieder zurueck in den Teich."));
          goldfisch->remove(M_SILENT); 
	  return 1;
	 }
         
	}
}


int c_zwinkern(string str)
{
 if(str != "sonne zu")
 {
  notify_fail("Zwinker wie? Zwinkere wem zu?\n");
  return 0;
 }
 else
 {
  write(BS("Du zwinkerst der Sonne froehlich zu. "));
  say(CTPN+ " zwinkert lustig.\n");
  return 1;
 }
}


rasse( string str )
{
 return(BS("Du gehoerst der Rasse "+this_player()->QueryProp(P_RACE)+" an.\n"));
}


int c_fangen(string str)
{
 object ob;
 if( str != "goldfisch mit haenden" &&
     str != "goldfisch" )
 {
  notify_fail("Was moechtest Du womit fangen?\n");
  return 0;
 }
 else
 {
  if(anz_fisch < 1)
  {
   write(BS("Du versuchst einen Goldfisch mit Deinen Haenden zu fangen, "
            "doch der kleine Zappler ist bei weitem geschickter als Du!"));
   return 1;
  }
  else
  {
   write(BS("Geschickt faengst Du einen kleinen Goldfisch. "));
   say(CTPN+ " platscht mit den Haenden im Teich.\n");
   ob = clone_object(OBJ "goldfisch");
   if(ob->move(TP, M_GO, "zappelt") != 1)
   {
    tell_object(TP, "Der kleine Fisch springt Dir aus Deinen Haenden.\n");
    ob->move(TO, M_NOCHECK);
   }
   anz_fisch--;
   return 1;
  }
 }
}
  


int c_fischen(string str)
{
 if( str != "in teich" )
 {
  notify_fail("Worin moechtest Du fischen?\n");
  return 0;
 }
 else
 {
  write(BS("In so einem kleinen Teich lohnt das Fischen nicht. Vielleicht "
           "kann man aber einen Goldfisch mit den Haenden fangen?"));
  return 1;
 }
}

