inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../carolina.h"

int anz_zeck = 2;

void reset()
{
  ::reset();
  anz_zeck = 2;
}

void create()
{
  ::create();
  anz_zeck = 2;
  SetProp(P_INT_SHORT, "In einem kleinen Garten");
  SetProp(P_INT_LONG, 
    "Im Norden siehst Du eine Hecke aus Stachelbeerstraeucher, die recht "
    "wild und abenteuerlich wachsen. Davor ist ein kleines Beet "
    "angelegt worden, in dem bereits einige Paradeispflanzen in die "
    "Hoehe ragen. Um das Beet herum hat jemand einige Steine liebevoll "
    "platziert, damit man nicht aus Versehen auf die gesetzten Jungpflanzen "
    "steigt.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_PLAIN]) );
  AddExit( "sueden", ROOM "garten_a3" );
  AddExit( "osten", ROOM "garten_b4" );


// DETAILBEGINN

  AddDetail( ({ "garten", "raum" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "norden" }),
    "Im Norden wachsen einige Stachelbeerstraeucher, die alle zusammen "
    "schon eine recht wilde abenteuerliche und vorallem undurchdringliche "
    "Hecke bilden. ");

  AddDetail( ({ "hecke" }),
    "Im Norden sind einige Stachelbeerstraeucher bereits so ineinander "
    "verwachsen, dass sie eine undurchdringliche Hecke bilden. Nicht einmal "
    "ein Gartenzaun zur Abgrenzung wird hier mehr benoetigt. ");

  AddDetail( ({ "gartenzaun", "zaun" }),
    "Diese Hecke aus Stachelbeerstraeuchern ist besser als jeder Zaun.");

  AddDetail( ({ "abgrenzung" }),
    "Normalerweise benoetigt man einen Gartenzaun als eine Art "
    "Abgrenzung zu anderen Gebieten. Hier ist das aber wirklich nicht mehr "
    "noetig, da die Hecke diese Rolle uebernimmt. ");

  AddDetail( ({ "rolle" }),
    "Die Hecke spielt Zaun!");

  AddDetail( ({ "gebiete" }),
    "Das hier gehoert Wassertroepfchen!");

  AddDetail( ({ "wassertroepfchen", "wasserelfe" }),
    "Wassertroepfchen ist eine kleine Wasserelfe - Du findest sie sicherlich "
    "in ihrem Haus. ");

  AddDetail( ({ "haus" }),
    "Du kannst das Haus von hier aus natuerlich sehen, aber der Eingang "
    "befindet sich auf der anderen Seite.");

  AddDetail( ({ "eingang" }),
    "Hier ist er nicht!");

  AddDetail( ({ "seite" }),
    "Geh mal ein paar Schritte nach Sueden und danach nach Osten, dann "
    "findest Du den Eingang sicher.");

  AddDetail( ({ "versehen" }),
    "Jemand hat Steine um das Beet platziert, damit niemand aus Versehen "
    "in die Jungpflanzen steigt. ");

  AddDetail( ({ "schritte" }),
    "Nur ein paar! Es ist ja wirklich nicht sehr weit!");

  AddDetail( ({ "art" }),
    "Cleme hat keine Lust dieses Wort zu beschreiben.");

  AddDetail( ({ "cleme" }),
    "Das bin ja dann wohl ich?!");

  AddDetail( ({ "wort" }),
    "Welches Wort?!");

  AddDetail( ({ "lust" }),
    "Ich hab total Lust auf ein Erdbeershake! Aber definitiv keine Lus das "
    "Wort Art zu beschreiben!");

  AddDetail( ({ "lus" }),
    "Bei dem Wort Lus handelt es sich um einen clemegraphischen Typofehler. ");

  AddDetail( ({ "typofehler" }),
    "Du untersuchst auch alles, nur damit Du einen Forscherpunkt bekommst!");

  AddDetail( ({ "forscherpunkt" }),
    "Ich entaeusche Dich ja nur ungern, aber hier gibts einfach keine ;)"); 

  AddDetail( ({ "erdbeershake", "shake" }),
    "Ur lecker, gell?!");

  AddDetail( ({ "hoehe" }),
    "Die Paradeispflanzen haben bereits eine recht stattliche Hoehe "
    "erreicht. ");

  AddDetail( ({ "beet" }),
    "In einem kleinen Beet vor Dir wurden einige Paradeispflanzen "
    "eingesetzt. ");

  AddDetail( ({ "paradeispflanzen" }),
    "Noch sind die Paradeiser auf den Pflanzen gruen, aber wenn sie noch "
    "etwas reifen, schmecken sie bestimmt wunderbar suess und vorallem sehr "
    "lecker in einem Salat!");

  AddDetail( ({ "salat" }),
    "Hier siehst Du nur Paradeispflanzen eingepflanzt und keinen Salat. Aber "
    "wenn die Paradeiser erst mal reif sind schmecken sie sicherlich auch "
    "im Salat sehr lecker. ");

  AddDetail( ({ "pflanzen" }),
    "Meinst Du die Paradeispflanzen oder die Jungpflanzen?!");

  AddDetail( ({ "jungpflanzen" }),
    "Damit man nicht aus Versehen auf die kleinen Paradeispflanzen steigt "
    "hat jemand Steine rund um das Beet gelegt. ");

  AddDetail( ({ "himmel" }),
    "Die Sonne scheint vom Himmel direkt auf die Paradeiser hinunter. "
    "Ob sie bald reif sind?!");

  AddDetail( ({ "sonne" }),
    "Die Sonne ist gross, feurig und irgendwie sehr heiss ,)");

  AddDetail( ({ "paradeiser" }),
    "Die Paradeiser auf den Pflanzen sind gruen und brauchen noch "
    "einige Zeit damit sie rot und saftig sind.");

  AddDetail( ({ "steine" }),
    "Die Steine liegen um das Beet herum. Sie sind recht gross und haben "
    "eine graue Farbe. ");

  AddDetail( ({ "farbe" }),
    "Die Steine sind alle grau und liegen um das Beet herum am Boden. "
    "Sicherlich versteckt sich unter ihnen einiges an Krabbelzeugs...");

  AddDetail( ({ "krabbelzeugs" }),
    "Kellerasseln, Ameisen, ... Du willst eigentlich nicht so genau wissen, "
    "was da alles unter den Steinen ist. ");
  
  AddDetail( ({ "ameisen", "kellerasseln", "asseln" }), 
    "So genau willst Du das nicht wissen!");

  AddDetail( ({ "zeit" }),
    "Ein bisserl musst Du noch warten bis es soweit ist.");

  AddDetail( ({ "boden" }),
    "Du stehst hier mitten in einem Garten. Woraus wird der Boden also "
    "bestehen? :)");

  AddDetail( ({ "gras" }),
    "Das Gras ist dicht gereiht und bildet hier den Boden, auf dem Du stehst.");

  AddDetail( ({ "straeucher", "stachelbeerstraeucher" }),
    "Die Stachelbeerstraeucher wachsen hier wirklich sehr wild und "
    "abenteuerlich. Man kann gar nicht mehr genau erkennen, wieviele es "
    "urspruenglich mal waren. Was Du allerdings sehen kannst ist, dass "
    "sich an einigen Aesten noch Stachelbeeren befinden. Mhmm, lecker!");

  AddDetail( ({ "stachelbeeren", "beeren", "stachelbeere", "beere" }),
    "Ob man welche pfluecken kann? Zumindest sehen sie verlockend lecker "
    "aus!");

  AddDetail( ({ "aeste" }),
    "An einigen siehst Du noch Stachelbeeren haengen!");

  AddDetail( ({ "blaetter" }),
    "Die Blaetter der Straeucher sind klein und gruen.");

  AddDetail( ({ "dornen", "stacheln" }),
    "Die Stachelbeere hat ihren Namen aufgrund ihrer Stacheln. Man sollte "
    "beim Pfluecken sehr vorsichtig sein.");

  AddDetail( ({ "name" }),
    "Von ihren Stacheln hat die Stachelbeere ihren Namen.");

  AddDetail( ({ "pfluecken" }),
    "Beim Pfluecken kann man sich ziemlich weh tun, falls man sich an "
    "einem Stachel sticht.");
    
  AddSpecialDetail( ({ "gewicht" }), "gewichtfunc");
 
// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Das Gras raschelt unter Deinem Gewicht. Pass bloss auf, dass Du es nicht "
    "ganz platt trittst!");

  AddSound( ({ "rascheln" }),
    "*raschel* *raschel*");

  AddSound( ({ "gras" }),
    "Das Gras raschelt unter Deinem Gewicht. Erst jetzt faellt Dir auf, "
    "wie schoen das Zwitschern der Voegel ist.");

  AddSound( ({ "zwitschern", "voegel" }),
    "*Tweetilitweetila*");

// SMELLS

  AddSmell(DEFAULT_SMELL, 
    "Du nimmst einen tiefen Atemzug Natur in Dich auf.");

  AddSmell( ({ "atem", "atemzug", "zug" }),
    "Du saugst die Natur vollkommen in Dich auf.");
   
  AddSmell( ({ "natur" }),
    "Einfach traumhaft!");




  AddCmd( ({ "dreh", "drehe" }), "c_drehen");
  AddCmd( ({ "pflueck", "pfluecke" }), "c_pfluecken");
  AddCmd( ({ "steig", "steige" }), "c_steigen");

}

string gewichtfunc()
{
 return(BS("Du wiegst "+TP->QueryProp(P_WEIGHT)+" Gramm.\n"));
}



int c_drehen(string str)
{
 if( str != "stein um"   &&
     str != "steine um"  )
 {
  notify_fail("Was magstn Du hier umdrehen?\n");
  return 0;
 }
 else
 {
  write(BS("Wuah!!! Als Du versuchst einen Stein umzudrehen kriecht "
           "irgendetwas ueber Deine Hand!!!!!!!!!!!!!!! IGITTT !!! "
           "Sofort schuettelst Du Dich und laesst den Stein einfach am "
           "Boden liegen."));
  say(CTPN+ " zappelt seltsam herum.\n");
  return 1;
 }
}

int c_pfluecken(string str)
{
 if(str != "stachelbeeren" &&
    str != "stachelbeere"  )
 {
  notify_fail("Was moechtest Du hier pfluecken?\n");
  return 0;
 }
 else
 {
  write(BS("Beim Versuch eine Stachelbeere zu pfluecken stichst Du Dich "
           "an einem Stachel. AUAAAAAAAAAAAAAA!"));
  TP->do_damage(4);
  say(CTPN+ " sticht sich in den Finger.\n");
  return 1;
 }
}

int c_steigen(string str)
{
 object ob;
 if( str != "mit absicht in beet" )
 {
  notify_fail("Wo moechtest Du mit Absicht hinsteigen?\n");
  return 0;
 }
 else
 {
  if(anz_zeck < 1)
  {
   write(BS("Du bist kurz davor mit Absicht in Wassertroepfchens Beet zu "
            "steigen, traust Dich dann aber nicht."));
   say(CTPN + " will ins Beet steigen, traut sich aber dann doch nicht.\n");
   WLOG(LOG "wassert.log", "steigt ins Beet");
   return 1;
  }
  else
  {
   write(BS("Du bist kurz davor mit Absicht in Wassertroepfchens Beet zu "
           "steigen, als Du in Gedanken Clementines erhobenen Zeigefinger "
           "siehst...Ohoh!!\n"));
   say(CTPN + " wird ploetzlich komisch.\n");
   ob = clone_object(OBJ "zeck");
   ob->move(TP, M_NOCHECK);
   WLOG(LOG "wassert.log", "kriegt nen Zeck");
   }
   anz_zeck--;
   return 1;
  }
 } 


