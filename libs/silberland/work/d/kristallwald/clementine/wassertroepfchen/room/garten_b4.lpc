inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../carolina.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "In einem kleinen Garten");
  SetProp(P_INT_LONG, 
    "Ein kleines Hochbeet wurde hier angelegt. In ihm befinden sich einige "
    "Salatkoepfe, aber auch Erdbeeren kannst Du erkennen. Um das Hochbeet "
    "herum fuehrt ein Weg aus Kieselsteinen, der sehr gepflegt aussieht. "
    "Im restlichen Teil des Gartens waechst natuerlich Gras. Dennoch "
    "bist Du etwas verwundert, da an einigen Stellen die Grashalme "
    "ziemlich geknickt aussehen. "); 
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_PLAIN]) );
  AddExit( "westen", ROOM "garten_a4" );
  AddExit( "osten", ROOM "garten_c4" );


// DETAILBEGINN

  AddDetail( ({ "fenster" }),
    "Durch das Fenster kann man in Wassertroepfchens Schlafzimmer blicken. ");

  AddDetail( ({ "fensterbrett" }),
    "Auf dem Fensterbrett steht eine Vase.");

  AddDetail( ({ "vase" }),
    "In der buntbemalten Vase stecken viele Blumen, die wohl erst kuerzlich "
    "gepflueckt worden sind. ");

  AddDetail( ({ "blumen" }),
    "Sie riechen sicher herrlich!");

  AddDetail( ({ "wassertroepfchen" }),
    "Hier ist sie nicht, aber vielleicht siehst Du sie ja, wenn Du durchs "
    "Fenster blickst.");

  AddDetail( ({ "teil" }),
    "Du stehst im noerdlichen Teil des Gartens. Im Sueden befindet sich "
    "Wassertroepfchens Haus. ");

  AddDetail( ({ "sueden", "haus" }),
    "Im Sueden steht Wassertroepfchens Haus. Durch das Fenster kann man "
    "direkt in ihr Schlafzimmer sehen. ");

  AddDetail( ({ "schlafzimmer" }),
    "Blick doch einfach durch das Fenster!");

  AddDetail( ({ "hochbeet", "beet" }),
    "Das Hochbeet ist ein Beet, dass etwas hoeher angelegt ist. Es ist nicht "
    "direkt unten am Boden, sondern reicht Dir von der Hoehe bis ueber die "
    "Knie. In ihm siehst Du einige Salatkoepfe und Erdbeeren.");

  AddDetail( ({ "erdbeeren", "erdbeerpflanzen" }),
    "Die Erdbeerpflanzen haben zwar schon einige Erdbeeren drauf, diese "
    "sind aber alle noch fast gruen.");

  AddDetail( ({ "salatkoepfe", "salat", "koepfe" }),
    "Die Salatkoepfe im Hochbeet sehen aus wie normaler Blattsalat. "
    "Nicht wirklich sehr interessant fuer Dich... Das einzige was Dir "
    "wirklich auffaellt ist, dass er nicht von Schnecken angeknabbert "
    "wird. ");

  AddDetail( ({ "schnecken", "schnecke" }),
    "Vermutlich kommen die Schnecken nicht in das Hochbeet. ");

  AddDetail( ({ "blattsalat" }),
    "Einige sehr schoene Haeupel Blattsalat gedeihen im Hochbeet und kein "
    "einziger davon wurde von Schnecken angeknabbert. ");

  AddDetail( ({ "haeupel" }),
    "Sie gedeihen wirklich super in dem Hochbeet. ");

  AddDetail( ({ "stellen" }),
    "An einigen Stellen sind die Grashalme geknickt. Woher das wohl "
    "kommt?");

  AddDetail( ({ "grashalme", "halme" }),
    "Einige der Halme sind geknickt worden. Seltsam...");

  AddDetail( ({ "gras" }),
    "Um das Hochbeet und den Kieselweg waechst das Gras und gedeiht. "
    "Nur an einigen Stellen sieht es sonderbar geknickt aus.");

  AddDetail( ({ "garten" }),
    "Du stehst in ihm! :)");

  AddDetail( ({ "weg", "kieselweg" }),
    "Ein kleiner Weg aus Kieselsteinen fuehrt um das Hochbeet herum. "
    "Anscheinend laesst sich das Beet so einfacher bearbeiten, wenn man nicht "
    "immer in die Wiese steigen muss.");

  AddDetail( ({ "kiesweg", "kieselsteine", "steine", "kies" }),
    "Der Weg besteht aus Kieselsteinen. Kleine weisse Kieselsteine, die "
    "sorgfaeltig um das Beet angeordnet wurden. Irgendjemand hat sich hier "
    "sehr viel Muehe gemacht!");

  AddDetail( ({ "muehe" }),
    "Es war sicherlich sehr viel Arbeit, damit alles hier so aussieht "
    "wie es ausieht.");

  AddDetail( ({ "arbeit" }),
    "Sicherlich eine anstrengende Arbeit, wenngleich auch sehr schoen.");

  AddDetail( ({ "himmel" }),
    "Das Detail Himmel plumpst auf Dich herab. Aua!");

  AddDetail( ({ "detail" }),
    "Wenn Du es unbedingt wissen willst: Der Himmel ist von einem "
    "Blauton, dass selbst Dir der Mund offen stehen bleibt.");

  AddDetail( ({ "mund" }),
    "Der ist offen!");

  AddDetail( ({ "blauton", "blau", "ton" }),
    "Der Himmel zeigt sich momentan in einem ganz kraeftigen Blauton.");

  AddDetail( ({ "hoehe" }),
    "Das Hochbeet ist recht hoch. Es reicht Dir mindestens bis zum Knie!");

  AddDetail( ({ "boden" }),
    "Meinst Du die Wiese, in der Du stehst?!");
  
  AddDetail( ({ "wiese" }),
    "Naja so nennt man das, wenn viele Grashalme nebeneinander stehen.");

  AddDetail( ({ "duft" }),
    "Also den Duft kann man nicht sehen, nur riechen!");

  AddDetail( ({ "stelle" }),
    "Meinst Du eine bestimmte?!");


  AddSpecialDetail( ({ "knie" }), "kniefunc");
  

// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Aus Richtung des Fensterbretts kommt ein herrlicher Duft. "); 

  AddSmell( ({ "fensterbrett", "brett", "fenster" }),
    "Aus der Richtung des Fensterbretts kommt ein total herrlicher "
    "Geruch. Vermutlich weil dort eine Vase mit vielen Blumen steht.");

  AddSmell( ({ "vase", "blumen" }),
    "Die Blumen in der Vase riechen einfach bezaubernd. Sie muessen "
    "erst vor kurzem gepflueckt worden sein.");

  AddSmell( ({ "richtung" }),
    "Der Geruch kommt aus suedlicher Richtung.");

  AddSmell( ({ "duft", "geruch" }),
    "Ein blumiger erfrischender Duft kommt aus suedlicher Richtung.");


// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Du haeltst Deine Ohren in die Luft und lauscht angestrengt. Bis auf "
    "ein paar Voegel ist es hier wirklich sehr ruhig. ");

  AddSound( ({ "voegel" }),
    "Ein paar Voegel zwitschern - *tweeeeeeeeet* *tweeeeeeet* tweeeeet* ");

  AddSound( ({ "ohren" }),
    "Es ist so wahnsinnig schwer mit seinen eigenen Ohren an seinen "
    "eigenen Ohren zu lauschen. Andere wuerden meinen es sei sogar "
    "absolut vertrottelt.... such Dir etwas aus...");

  AddSound( ({ "luft" }),
    "Du vernimmst ein leises Zwitschern.");

  AddSound( ({ "zwitschern" }),
    "*tweet* *tweet* *tweet* ");




  AddCmd( ({ "leg", "lege", "lieg", "liege" }), "c_liegen");
  AddCmd( ({ "blick", "blicke" }), "c_blicken");
  AddCmd( ({ "pflueck", "pfluecke" }), "c_pfluecken");


}

string kniefunc(string str)
{
 if(!(TP->QueryProp(P_RACE, "Fee")) ||
    !(TP->QueryProp(P_FROG)) || 
    !(TP->QueryProp(P_RACE, "Zwerg")))
 { 
  return(BS("Das Beet ist ungefaehr so hoch wie Dein Knie. Und das ist ja "
            "nicht niedrig, oder?"));
 }
 else
 {
  return(BS("Das Beet geht Dir sogar ueber den Kopf! "));
 }
}



int c_liegen(string str)
{
 if(str != "in wiese"  &&
    str != "auf wiese"  )
 {
  notify_fail("Wo moechtest Du Dich hinlegen?\n");
  return 0;
 }
 else
 {
  write(BS("Du legst Dich kurz ins Gras, findest es aber ziemlich "
           "unbequem... Als Du wieder aufstehst merkst Du, dass Du "
           "einige Grashalme ganz zerknickt hast. "));
  say(CTPN+ " zerknickt einige Grashalme.\n");
  return 1;
 }
}

int c_blicken(string str)
{
 object ob;
 if(str != "durch fenster" &&
    str != "in schlafzimmer" )
 {
  notify_fail("Wodurch willst Du blicken?\n");
  return 0;
 }
 else
 {
  ob = ROOM "haus4"->int_long(TP, TO, 2);
  write("Du schaust durch das Fenster:\n"+ob);
  say(CTPN+ " schaut durch das Fenster.\n");
  return 1;
 }
}
 

int c_pfluecken(string str)
{
 if(str != "erdbeere"   &&
    str != "erdbeeren"  )
 {
  notify_fail("Was moechtest Du pfluecken?\n");
  return 0;
 }
 else
 {
  write(BS("Nein! Das sind doch Wassertroepfchens Erdbeeren! Ausserdem "
           "sind sie noch nicht ganz so rot, wie sie eigentlich sein "
           "sollten."));
  say(CTPN + " schaut sich die Erdbeeren naeher an.\n");
  return 1;
 }
}

