inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../carolina.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "In einem kleinen Garten");
  SetProp(P_INT_LONG,
    "Hier ist das Gras um einiges hoeher als im restlichen Garten. Vereinzelt "
    "siehst Du zwischen den langen Grashalmen auch ein paar Wildblumen "
    "wachsen. Oestlich von Dir stehen einige Straeucher und Buesche, "
    "die sicherlich schon lang nicht mehr geschnitten wurden. " 
    "Na hoffentlich beisst sich nicht irgendein Zeck an Deinem Bein "
    "fest."); 
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_PLAIN]) );
  AddExit( "sueden", ROOM "garten_e1" );
  AddExit( "norden", ROOM "garten_e3" );
  AddItem(NPC "raupe", REFRESH_DESTRUCT);





  AddDetail( ({ "zeck" }),
    "Sehen tust Du keinen, aber Du spuerst bereits wie irgendetwas an "
    "Deinem Bein hochkrabbelt. ");

  AddDetail( ({ "bein" }),
    "Irgendetwas krabbelt an Dir hoch, Du spuerst es ganz genau!!!");

  AddDetail( ({ "irgendetwas" }),
    "Vielleicht ist es doch ein Zeck? Igitt!!!\n"
    "Du schuettelst Dich und das Krabbeln hoert auf.");

  AddDetail( ({ "krabbeln" }),
    "Jetzt krabbelt nichts mehr - zumindest nichts, was Du spueren "
    "wuerdest... *hrhr*");

  AddDetail( ({ "wildblumen", "blumen" }),
    "Du kannst unter anderem Roten Fingerhut erkennen, aber auch "
    "Wiesen-Augentrost und ein paar Kornblumen wachsen hier. ");

  AddDetail( ({ "roter fingerhut", "fingerhut" }),
    "Der Rote Fingerhut (und nein rot schreibt man nicht klein, weil das "
    "zum Namen der Blume gehoert!), ist eigentlich nicht rot, sondern eher "
    "pink. Durch seine Rachenblueten lockt er immer wieder einige "
    "Hummeln an. ");

  AddDetail( ({ "blueten", "bluete" }),
    "Welche Blueten meinst Du?");

  AddDetail( ({ "rachenblueten" }),
    "Durch die Rachenblueten werden vorallem Hummeln vom Roten Fingerhut "
    "angelockt. ");

  AddDetail( ({ "name" }),
    "Du wirst ja hoffentlich selber wissen, wie Du heisst.");

  AddDetail( ({ "hummeln", "hummel" }),
    "Immer wieder fliegen welche zu den Rachenblueten des Roten Fingerhuts.");

  AddDetail( ({ "wiesen-augentrost", "wiesenaugentrost", "augentrost" }),
    "Der Augentrost ist eine krautige Pflanze mit weiss-violetten Blueten "
    "die auf der Unterseite einen gelben Fleck haben. Irgendwie wirkt sie "
    "sehr zierlich auf Dich. ");

  AddDetail( ({ "unterseite" }),
    "Auf der Unterseite der Bluetenblaetter hat der Augentrost einen "
    "gelben Fleck - wohl damit die Insekten besser landen koennen. ");

  AddDetail( ({ "bluetenblaetter" }),
    "Bluetenblaetter gibt es hier wirklich viele. Meinst Du ein bestimmtes?");

  AddDetail( ({ "bluetenblatt" }),
    "Welches?");

  AddDetail( ({ "insekten" }),
    "Insekten gibt es in einem Garten sehr sehr viele. Vielleicht solltest "
    "Du Dich genauer ausdruecken?");

  AddDetail( ({ "fleck" }),
    "Der gelber Fleck auf der Unterseite der weiss-violetten Bluetenblaetter "
    "macht unter anderem Bienen auf die Pflanze aufmerksam und lockt sie "
    "an.");

  AddDetail( ({ "biene", "bienen" }),
    "Momentan siehst Du hier leider keine.");

  AddDetail( ({ "boden" }),
    "Am Boden befindet sich das Uebliche! Gras, Blumen, Erde, ...");

  AddDetail( ({ "uebliche" }),
    "Ich wiederhole mich nur sehr ungern, aber extra fuer Dich: Erde, Gras "
    "Blumen.");

  AddDetail( ({ "gras" }),
    "Das Gras steht hier hoeher als im restlichen Garten. Hoffentlich "
    "lauern nicht irgendwo kleine Wanzen und warten darauf Dich "
    "auszusaugen.");

  AddSpecialDetail( ({ "wanzen", "wanze" }), "wanzenfunc");


  AddDetail( ({ "korblumen", "kornblume" }),
    "Warum hier vereinzelt auch Kornblumen stehen ist Dir ein Raetsel. "
    "Du haettest sie eher in der Naehe von Felder vermutet.");

  AddDetail( ({ "naehe", "feld", "felder" }),
    "Naja, denkst Du Dir... vielleicht gibt es ja ganz in der Naehe "
    "auch ein paar Felder.");

  AddDetail( ({ "raetsel" }),
    "Du wunderst Dich ueber die Kornblumen.");

  AddDetail( ({ "blume" }),
    "Welche Blume meinst Du denn jetzt?");

  AddDetail( ({ "straeucher", "buesche", "busch", "strauch" }),
    "Oestlich von Dir stehen Straeucher und Buesche dicht gedraengt. "
    "Sie wurden sicherlich schon einige Jahre nicht geschnitten - vielleicht "
    "ist dies aber auch so beabsichtigt. ");

  AddDetail( ({ "jahre" }),
    "Es ist sicherlich schon sehr lange her, dass diese Buesche und "
    "Straeucher einen ordentlichen Schnitt verpasst bekommen haben.");

  AddDetail( ({ "schnitt" }),
    "Sie wurden wirklich schon lange nicht geschnitten. Aber vielleicht "
    "steckt dahinter ja eine bestimmte Absicht.");

  AddDetail( ({ "erde" }),
    "Erde ist braun und der Naehrboden fuer Blumen, Gras und anderes "
    "wachsendes Zeug.");

  AddDetail( ({ "naehrboden" }),
    "Erde! Sagte ich das nicht gerade?");

  AddDetail( ({ "zeug" }),
    "Baeume, Buesche, Straeucher, ... all das, was so aus der Erde kommt und "
    "waechst");
  
  AddDetail( ({ "baeume", "baum" }),
    "Hier sind keine Baeume."); 

  AddDetail( ({ "pflanze", "pflanzen" }),
    "Welche meinst Du denn jetzt schon wieder?");

  AddDetail( ({ "himmel" }),
    "Irgendwann wird Dir der Himmel auf den Kopf fallen. Spaetestens wenn "
    "Du in all den anderen Gartenraeume das Wort ebenfalls untersuchst.");

  AddDetail( ({ "gartenraeume" }),
    "Der Garten ist gross, und das Wort Himmel kommt auch des oefteren "
    "(des Oefteren - neue dt. Rechtschreibung) vor.");

  AddDetail( ({ "oefteren", "oefteres", "rechtschreibung" }),
    "Ich schreibe nach der alten.");

  AddDetail( ({ "wort" }),
    "Welches Wort?");

  AddDetail( ({ "raeume" }),
    "Meinst Du die Raeume im Garten? Gartenraeume!");

  AddDetail( ({ "kopf" }),
    "Der Himmel wird Dir bei soviel Untersuchen auf den Kopf fallen, und "
    "dafuer sorge ich ganz hoechstpersoenlich! Wirst schon sehen!");

  AddDetail( ({ "untersuchen" }),
    "Falls es Dich beruhigt: der Himmel ist auch hier blau.\n"
    "Trotzdem wird er irgendwann auf Dich herunterstuerzen - wirst schon "
    "sehen.");

  AddDetail( ({ "wiesen" }),
    "Wiesen? Meinst Du den Wiesen-Augentrost?");

  AddDetail( ({ "garten" }),
    "Du stehst mitten im Garten von Wassertroepfchen - vielleicht hast "
    "Du das ja bereits vergessen: Wassertroepfchen ist nicht hier, wie "
    "Du unschwer erkennen kannst, und der Garten ist sehr gross, aber Du "
    "darfst Dir natuerlich alles genau ansehen.");

  AddDetail( ({ "wassertroepfchen" }),
    "Nicht hier!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!");

  AddDetail( ({ "grashalme", "halm", "grashalm", "halme" }),
    "Zwischen den hohen Grashalmen stehen auch ein paar Wildblumenen, "
    "vorallem die eine in pinke gefaellt Dir gut. ");

  AddSpecialDetail( ({ "absicht" }), "absichtfunc");
    

// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Ein leichtes Brummen geht von den pinkfarbenen Blumen aus. ");

  AddSound( ({ "blume", "blumen" }),
    "Du lauscht an einem Roten Fingerhut, hoerst aber kein Brummen. "
    "Schliesslich fliegen die Hummeln ja auch umher und bleiben nicht "
    "still irgendwo sitzen, damit ausgerechnet Du an ihnen lauschen kannst.");

  AddSound( ({ "brummen" }),
    "brmmmmbrmmmm - klingt fast wie ein Auto.");

  AddSound( ({ "auto" }),
    "Ein Auto mit Getriebeschaden.");

  AddSound( ({ "getriebeschaden", "schaden" }),
    "Hier ist weder ein Auto noch ein Getriebeschaden. Die einzige, die hier "
    "einen Schaden hat bin ich :)");

  AddSound( ({ "clementine" }),
    "Jemand lacht schadhaft.");

// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Es riecht blumig!");

  AddSmell( ({ "blumen", "augentrost", "fingerhut", "kornblume" }),
    "Herrlich!");
    
   

}

string absichtfunc(string str)
{
 return(BS("Die Absicht kannst Du mit einer Intelligenz von "
           +TP->QueryAttribute(A_INT)+" nicht erkennen...\n"));
}

            

string wanzenfunc(string str)
{
 return(BS("Na Du als "+TP->QueryProp(P_RACE)+" fuerchtest Dich natuerlich "
           "nicht vor irgendwelchen kleinen Wanzen.\n"));
}

  
