inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../carolina.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "In einem kleinen Haeuschen");
  SetProp(P_INT_LONG, 
    "Du befindest Dich im Flur des kleinen Haeuschens. Einige Bilder haengen "      "an den gelb gestrichenen Waenden. Durch das Fenster im Norden scheint "
    "das Sonnenlicht hereinzukommen. Nach Osten kommt man in eine grosse "
    "Kueche, nach Sueden wieder in das Vorzimmer zurueck. Anscheinend kommt "
    "man auch von hier aus, ueber eine Treppe in den Keller. Auf einer "
    "hoelzernen Ablage stehen einige Dosen. ");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_PLAIN]) );

  AddExit( "sueden", ROOM "haus1" );
  AddExit( "osten", ROOM "kueche" );
  AddExit( "runter", ROOM "keller1" );


// DETAILBEGINN

  AddDetail( ({ "zimmer", "raum" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "haeuschen", "haus" }),
    "Da befindest Du Dich doch gerade! ");

  AddDetail( ({ "flur" }),
    "Du stehst mitten im Flur. ");

  AddDetail( ({ "waende" }),
    "Die gelb gestrichenen Waende lassen den Raum noch sonniger erscheinen. "
    "Einige Bilder wurden an ihnen aufgehaengt. ");

  AddDetail( ({ "vorzimmer" }),
    "Nach Sueden kommst Du wieder in das Vorzimmer zurueck. ");

  AddDetail( ({ "ablage" }),
    "Eine Ablage wurde an der Wand montiert, auf ihr befinden sich einige "
    "silbernde Dosen. ");

  AddDetail( ({ "wand" }),
    "Der Raum hat vier Waende. :) ");

  AddDetail( ({ "sueden" }),
    "Nach Sueden kommst Du wieder in das Vorzimmer. Wenn Du Dich dort naeher "
    "umsehen moechtest, so tippe doch einfach: 's' ");

  AddDetail( ({ "osten" }),
    "Im Osten befindet sich eine grosse Kueche, blick Dich doch dort etwas "
    "besser um - vielleicht findest Du dort etwas Wichtiges. ");

  AddDetail( ({ "wichtiges" }),
    "Du musst schon nach Osten gehen, um das zu erforschen. ");

  AddDetail( ({ "kueche" }),
    "Die Kueche befindet sich im Osten, Du musst schon naeher rangehen, um "
    "etwas erkennen zu koennen. ");

  AddDetail( ({ "boden" }),
    "Wie ueberall im Haus besteht auch hier der Boden aus Eichenholz. ");

  AddDetail( ({ "holz", "eichenholz" }),
    "Eichenholz ist sehr widerstandsfaehig, deshalb wurde es hier wohl "
    "im ganzen Haus fuer den Boden benutzt. ");

  AddDetail( ({ "treppe" }),
    "Eine hoelzerne Treppe fuehrt Dich in den Keller hinunter. ");

  AddDetail( ({ "keller" }),
    "Von hier kannst Du kaum sehen, was sich dort abspielt. ");

  AddDetail( ({ "fenster" }),
    "Durch das Fenster im Norden scheint das Sonnenlicht herein. Draussen "
    "muss heute wirklich ein schoener Tag sein, Du fuehlst, wie die Sonne "
    "Deine Haut erwaermt. ");

  AddDetail( ({ "haut" }),
    "Etwas Sonne wuerde Dir sicherlich nicht schaden! ");

  AddDetail( ({ "sonne" }),
    "Um die Sonne zu sehen, solltest Du aber schon hinausgehen, denn von "
    "hier drinnen wirst Du sie kaum deutlich sehen koennen. ");

  AddDetail( ({ "sonnenlicht" }),
    "Warm und freundlich waermt Dich das Sonnenlicht. ");

  AddDetail( ({ "tag" }),
    "So richtig warm und gemuetlich draussen! ");

  AddDetail( ({ "bilder" }),
    "Die Bilder zeigen Wassertroepfchen in ihrem Garten, umgeben von "
    "vielen kleinen Tierchen. ");

  AddDetail( ({ "tierchen" }),
    "Du glaubst Libellen und Raupen naeher erkennen zu koennen. Auch ein "
    "Schmetterling ist auf einem der Bilder. ");

  AddDetail( ({ "garten" }),
    "Der Garten umgibt das Haus, aber hier wirst Du ihn kaum finden. ");

  AddDetail( ({ "wassertroepfchen" }),
    "Wo die wohl steckt? ");

  AddDetail( ({ "libellen" }),
    "Du bist Dir sicher, dass es sich hierbei um Libellen auf dem Bild "
    "handelt. Unverkennbar mit ihren schillernden Fluegel. ");

  AddDetail( ({ "fluegel" }),
    "Die schillernden Fluegel der Libellen spiegeln sich im Sonnenlicht. ");

  AddDetail( ({ "bild" }),
    "Hier haengen viele verschiedene Bilder. ");

  AddDetail( ({ "raupen" }),
    "Auf einem Bild siehst Du, wie viele kleine Raupen sich um "
    "Wassertroepfchen versammelt haben. Es scheint so, als wuerde sie "
    "ihnen gerade eine Geschichte vorlesen. ");

  AddDetail( ({ "geschichte", "geschichten" }),
    "Du wusstest gar nicht, dass kleinen Raupen Geschichten gefallen. ");

  AddDetail( ({ "schmetterling" }),
    "Wenn Du genau hinsiehst, wirst Du vielleicht auch einen im Garten finden "
    "koennen. "); 
 
  AddDetail( ({ "decke" }),
    "Du kannst nichts besonderes an der gelben Decke erkennen. ");

  AddDetail( ({ "dosen" }),
    "Silberne Dosen stehen auf der Ablage, die allesamt verschlossen sind. "
    "Eine unterscheidet sich allerdings etwas von den anderen. ");

  AddDetail( ({ "dose" }),
    "Eine der silbernen Dosen, hat einen roten Rubin auf ihrem Deckel. "
    "Wofuer das gut sein soll? ");

  AddDetail( ({ "deckel" }),
    "Ein praechtiger Rubin wurde in den Deckel eingefasst. ");

  AddDetail( ({ "rubin" }),
    "Beeindruckend. Woher die kleine Wasserelfe wohl solche Schaetze hat? ");

  AddDetail( ({ "schaetze" }),
    "Ein Rubin ist ein sehr wertvoller Edelstein. ");

  AddDetail( ({ "edelstein", "edelsteine" }),
    "Edelsteine koennen angeblich schaedliche Strahlung absorbieren. ");

  AddDetail( ({ "strahlung" }),
    "Da solltest Du besser Failin fragen, die kennt sich mit "
    "Monitorstrahlungsabsorption aus. ");

  AddDetail( ({ "monitorstrahlungsabsorption" }),
    "Sowas siehst Du hier wirklich nicht!!! ");

  AddDetail( ({ "wasserelfe", "wasserelfen" }),
    "Wassertroepfchen ist eine kleine Wasserelfe, sie kann Dir sicherlich "
    "etwas ueber Wasserelfen erzaehlen. ");

// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Hier herrscht eine angenehme Ruhe. Manchmal hoerst Du von draussen "
    "einen Vogel pfeifen.");

  AddSound( ({ "vogel", "pfeifen" }),
    "Manchmal hoert man von draussen ein Pfeifen.");

  AddSound( ({ "ruhe" }),
    "Du fuehlst Dich angenehm entspannt.");


// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Aus dem Osten dringt ein leckerer Duft.");

  AddSmell( ({ "duft" }),
    "Anscheinend befindet sich im Osten die Kueche.... es duftet herrlich.");

  AddSmell( ({ "kueche" }),
    "Am besten gehst Du einen Schritt nach Osten, damit Du die Kueche "
    "genauer inspizieren kannst.");

  AddSmell( ({ "schritt", "osten" }),
    "Geh doch einfach hin!");



  AddCmd( ({ "drueck", "druecke" }), "c_druecken");
  AddCmd( ({ "oeffne" }), "c_oeffnen" );
  AddCmd( ({ "blick", "blicke" }), "c_blicken" );
  AddCmd( ({ "schliesse", "schliess" }), "c_schliessen");

  
}

int c_oeffnen( string str )
{
 if( str != "dose"    &&
     str != "deckel"  && 
     str != "fenster"  )
 {
  notify_fail("Was moechtest Du hier oeffnen?\n");
  return 0;
 }
 if( str == "dose"  ||
     str == "deckel" )
 {
  write(BS("Der Deckel klemmt zu fest. ") );
  return 1;
 }
 if( str == "fenster" )
 {
  write(BS("Aber das Fenster ist doch schon geoeffnet! ") );
  return 1;
 }
}

int c_druecken( string str )
{
 if( str != "auf rubin" )
 {
  notify_fail("Worauf moechtest Du hier druecken?\n");
  return 0;
 }
 else
 {
  write("Du drueckst fest auf den Rubin.\n"
        "Von irgendwoher kannst Du ein leises <Klick> vernehmen.\n");
  return 1;
 }
}

// das Klick bringt genau genommen Nüsse :)

int c_schliessen( string str )
{
 if( str != "fenster" )
 {
  notify_fail("Was moechtest Du hier schliessen?\n");
  return 0;
 }
 else
 {
  write(BS("Da Du nicht weisst, ob Wassertroepfchen das recht ist, "
           "beschliesst Du, das Fenster offen zu lassen. ") );
  return 1;
 }
}

int c_blicken( string str )
{
 if( str != "aus fenster"   &&
     str != "durch fenster" &&
     str != "raus"          &&
     str != "hinaus"        &&
     str != "in garten"      )
 {
  notify_fail("Woraus moechtest Du blicken?\n");
  return 0;
 }
 else
 {
  write(BS("Du wirfst einen Blick durch das Fenster und beobachtest kurz "
           "das friedliche Zusammenleben der Tiere draussen. ") );
  return 1;
 }
}

