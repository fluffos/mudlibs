inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../carolina.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "In einem kleinen Haeuschen");
  SetProp(P_INT_LONG, 
    "Du befindest Dich in Wassertroepfchens Schlafzimmer. Die Waende "
    "erstrahlen in einem zarten Rosa, und ueberall kannst Du irgendwelche "
    "Rosenquarze erkennen. Ein flauschiges Bett steht genau in der Mitte "
    "des Raumes. Neben ihm steht ein Nachtkaestchen auf dem sich eine Kerze "
    "und einige Buecher befinden. Auf dem Fensterbrett steht eine Vase, die "
    "mit frischen Blumen gefuellt ist. Ausserdem kannst Du noch einen Kasten "
    "an der Ostwand erkennen. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_HOUSE]) );

  AddExit( "sueden", ROOM "haus3" );

  AddItem(NPC "wassert", REFRESH_DESTRUCT); 

  AddDetail( ({ "schlafzimmer", "zimmer", "raum" }),
    QueryProp(P_INT_LONG) );

  AddDetail( ({ "waende" }),
    "Die Waende wurden rosa gestrichen. ");

  AddDetail( ({ "wand" }),
    "Welche Wand meinst Du?");

  AddDetail( ({ "nordwand" }),
    "An der Nordwand befindet sich ein Fenster, durch das man in den "
    "Garten blicken kann. ");  

  AddDetail( ({ "ostwand" }),
    "An der Ostwand steht ein alter Kasten aus Eichenholz. ");

  AddDetail( ({ "kasten" }),
    "Ein alter Kasten aus Eichenholz steht an der Ostwand. Er wurde mit "
    "wunderschoenen Ornamenten verziert. Beide Kastentueren sind "
    "verschlossen. ");

  AddDetail( ({ "kastentueren", "kastentuer", "kastentuere", "tuere", 
    "tueren" }),
    "Sie sind beide verschlossen. ");

  AddDetail( ({ "ornamente" }),
    "Schoene Holzschnitzereien befinden sich auf dem Kasten. Ob sie eine "
    "bestimmte Bedeutung haben? ");

  AddDetail( ({ "bedeutung" }),
    "Erkennen kannst Du keine. ");

  AddDetail( ({ "holzschnitzerei", "holzschnitzereien", "schnitzerei",
                "schnitzereien" }),
    "Mit ihnen wurde der Kasten verziert. ");

  AddDetail( ({ "suedwand" }),
    "An der Suedwand befindet sich ein grosses Loch, durch das Du "
    "herein gekommen bist. ");

  AddDetail( ({ "loch" }),
    "Das Loch bildet eine Art Tuere. ");

  AddDetail( ({ "tuere", "tuer" }),
    "So etwas Aehnliches. ");

  AddDetail( ({ "aehnliches" }),
    "Dort wo in normalen Haeusern eine Tuer ist, befindet sich hier nur "
    "ein grosses Loch. Weit und breit keine Tuer zu sehen. ");

  AddDetail( ({ "westwand" }),
    "An der Westwand kannst Du nichts Aussergewoehnliches finden. ");

  AddDetail( ({ "aussergewoehnlich" }),
    "Eine ganz normale, rosa gestrichene Wand. ");

  AddDetail( ({ "rosenquarze", "quarze" }),
    "An duennen Faeden wurden Rosenquarze aufgefaedelt, und "
    "im Zimmer aufgehaengt. ");
   
  AddDetail( ({ "faeden" }),
    "An ihnen wurden Rosenquarze aufgefaedelt. ");
 
  AddDetail( ({ "rosenquarz" }),
    "Der Rosenquarz ist ein rosaroter Stein, der durch seine Farbpracht "
    "wirklich beeindruckt. ");

  AddDetail( ({ "farbpracht", "pracht" }),
    "Irgendwie schaut er sehr exotisch aus. ");

  AddDetail( ({ "rosa" }),
    "Die Waende wurden allesamt rosa gestrichen. Irgendwie hat die "
    "Farbe eine sehr beruhigende Wirkung auf Dich. ");

  AddDetail( ({ "wirkung" }),
    "Rosa scheint eine Farbe zu sein, bei der man sich perfekt entspannen "
    "kann. ");

  AddDetail( ({ "farbe" }),
    "Rosa! ");

  AddDetail( ({ "bett" }),
    "Das Bett sieht furchtbar flauschig aus. Eine dicke Bettdecke liegt "
    "in ihm, und viele einzelne Poelster. Wie gemuetlich hier doch "
    "alles eingerichtet ist. ");

  AddDetail( ({ "mitte" }),
    "In der Mitte des Raumes steht ein grosses Bett. Eine dicke flauschige "
    "Decke und viele Poelster liegen in ihm. Sicherlich waere es sehr "
    "angenehm sich in das Bett zu kuscheln. ");

  AddDetail( ({ "nachtkaestchen", "kaestchen" }),
    "Ein hoelzernes Nachtkaestchen mit drei Laden steht neben dem Bett. "
    "Einige Buecher und eine Kerze befinden sich auf ihm. ");

  AddDetail( ({ "laden" }),
    "Was sich wohl in ihnen befindet?");

  AddDetail( ({ "kerze" }),
    "Die Kerze ist schon etwas abgebrannt, wahrscheinlich zuendet sie "
    "Wassertroepfchen in der Nacht immer zum Lesen an. ");

  AddDetail( ({ "nacht" }),
    "In der Nacht benoetigt Wassertroepfchen wohl eine Kerze zum Lesen. ");

  AddDetail( ({ "lesen" }),
    "Wassertroepfchen liest anscheinend sehr gerne, sonst haette sie wohl "
    "kaum soviele Buecher in ihrem Haus. ");

  AddDetail( ({ "haus", "haeuschen" }),
    "Indem befindest Du Dich doch gerade. ");

  AddDetail( ({ "buecher" }),
    "Einige Buecher liegen auf dem Nachtkaestchen. Du koenntest ja versuchen "
    "ihre Titel zu lesen. ");

  AddDetail( ({ "titel" }),
    "Du koenntest probieren sie zu lesen. ");
 
  AddDetail( ({ "brett", "fensterbrett" }),
    "Auf dem Fensterbrett steht eine buntbemalte Vase, in der sich frische "
    "Blumen befinden. ");

  AddDetail( ({ "vase" }),
    "Eine buntbemalte Vase steht auf dem Fensterbrett. In ihr stecken "
    "viele Blumen. ");

  AddDetail( ({ "blumen" }),
    "Viele verschiedene Blumen stehen in der Vase. Sie scheinen wohl erst "
    "kuerzlich gepflueckt worden zu sein. ");

  AddDetail( ({ "boden", "eichenholzboden" }),
    "Du stehst auf einem alten Eichenholzboden. Er weist bereits tiefe "
    "Furchen und Rillen auf, passt allerdings fabelhaft in diesen Raum, und "
    "verleiht eine vertraute Atmosphaere. ");

  AddDetail( ({ "eichenholz", "holz" }),
    "Es scheint ein sehr widerstandsfaehiges Holz zu sein. ");

  AddDetail( ({ "furchen", "rillen" }),
    "Die Furchen und Rillen sind wohl im Laufe der Zeit, durch das Benutzen "
    "entstanden. ");

  AddDetail( ({ "benutzen" }),
    "Anscheinend hat Wassertroepfchen schon oft Besuch gehabt. ");

  AddDetail( ({ "besuch" }),
    "Bist Du auch ein Besuch? ");

  AddDetail( ({ "atmosphaere" }),
    "Beeindruckend! ");

  AddDetail( ({ "zeit" }),
    "Die Zeit haelt auch vor Dir nicht. ");

  AddDetail( ({ "decke" }),
    "Welche Decke meinst Du? - Bettdecke oder Zimmerdecke? ");

  AddDetail( ({ "bettdecke" }),
    "Eine flauschige Bettdecke liegt in dem Bett. Sie waermt einen sicherlich "
    "einmalig, wenn man sich mit ihr zudeckt. ");

  AddDetail( ({ "poelster" }),
    "Einige kuschelige Poelster liegen in Wassertroepfchens Bett. Wenn Du "
    "mal eine Polsterschlacht machen moechtest, waere dies der passende "
    "Ort dafuer, natuerlich nur wenn Wassertroepfchen gerade nicht da ist. ");

  AddDetail( ({ "polsterschlacht", "schlacht" }),
    "(Hihi!) O o . denkst Du Dir.\n"
    "(Das waere sicherlich lustig!)\n");

  AddDetail( ({ "ort" }),
    "Dieser Ort ist aufgrund seiner vielen Poelster sicherlich perfekt fuer "
    "eine Polsterschlacht geeignet. ");

  AddDetail( ({ "zimmerdecke" }),
    "Die Decke wurde ebenfalls rosa gestrichen. Aus welchem Material sie einst "
    "entstanden ist, kannst Du nicht mehr erkennen. ");

  AddDetail( ({ "material" }),
    "Leider kannst Du es nicht erkennen. ");

  AddDetail( ({ "fenster" }),
    "Das Fenster steht weit geoeffnet und laesst einen herrlichen Blick auf "
    "den Garten zu. Links und rechts wurden Vorhaenge befestigt. ");
  
  AddDetail( ({ "freunde" }),
    "Wir sind alle Deine Freunde. ");

  AddDetail( ({ "gartenlexikon", "befruchtung" }),
    "Uninteressant fuer Dich. ");

  AddDetail( ({ "flieder" }),
    "Gleich neben dem Eingang waechst doch einer. ");

  AddDetail( ({ "eingang" }),
    "Durch ihn bist Du doch herein gekommen. ");

  AddDetail( ({ "ameisen" }),
    "Du glaubst im Garten einige gesehen zu haben. ");

  AddDetail( ({ "wassertroepfchen" }),
    "Sie scheint wohl gerade nicht hier zu sein. ");

  AddReadDetail( ({ "titel" }),
    "*Gartenlexikon von A - Z*\n"
    "*Die Befruchtung des Flieders*\n"
    "*Ameisen sind unsere Freunde*\n"
    "\n"
    "Gelangweilt wendest Du Dich ab.\n");

  AddDetail( ({ "blick" }),
    "Du kannst Du einfach einmal aus dem Fenster gucken... ");


// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Von draussen hoert man ein Vogelpfeifen, sonst ist es hier fast "
    "gaenzlich still. ");

  AddSound( ({ "pfeifen", "vogelpfeifen", "vogel", "voegel" }),
    "Einige Voegel pfeifen draussen ihr Lied. ");

  AddSound( ({ "lied" }),
    "*pfeif* *pfeif* *tweet* *zwitscherdiedu*");


// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Die Blumen in der Vase riechen herrlich! Ihr intensiver Geruch "
    "fuellt fast den ganzen Raum aus. ");

  AddSmell( ({ "geruch" }),
    "Riecht sehr blumig!");

  AddSmell( ({ "vase" }),
    "Die Vase selbst riecht nach Ton.");

  AddSmell( ({ "ton" }),
    "So genau moechtest Du nicht wissen, wie der Ton riecht.");

  AddSmell( ({ "blumen" }),
    "Die Blumen verstroemen einen intensiven Geruch im ganzen Raum.");




//  AddSpecialDetail( ({ "vorhaenge", "vorhang" }), "vorhaenge" );
  AddCmd( ({ "oeffne" }), "c_oeffnen");
  AddCmd( ({ "decke" }), "c_decken");
  AddCmd( ({ "guck", "gucke" }), "c_gucken");
  AddCmd( ({ "mach", "mache" }), "c_machen");
  AddCmd( ({ "nimm", "nehm", "nehme" }), "c_nehmen");
//  AddCmd( ({ "leg", "lege", "liege" }), "c_liegen wenn wt noch krank meldung liegt noch drin

}

int c_nehmen(string str)
{
 if ( str != "blumen aus vase" &&
      str != "blume aus vase"  &&
      str != "blumen aus vase heraus " &&
      str != "blume aus vase heraus"   &&
      str != "blume aus vase raus"     &&
      str != "blumen aus vase raus")
 {
	 notify_fail("Was moechtest Du wo rausnehmen?\n");
	 return 0;
 }
 else
 {
	 write(BS("Aber das tut man doch nicht!"));
	 return 1;
 }
}

int c_machen(string str)
{
 if( str != "polsterschlacht" )
 {
  notify_fail("Was moechtest Du machen?\n");
  return 0;
 }
 else
 {
  write(BS("Mach das doch lieber bei Dir zu Hause... "));
  return 1;
 }
}

// fehlt kastentueren
int c_oeffnen( string str )
{
 if( str != "lade"  &&
     str != "laden"  )
 {
  notify_fail("Was moechtest Du oeffnen?\n");
  return 0;
 }
 if( str == "lade"  ||
     str == "laden"  )
 {
  write(BS("Da Du Dich von Wassertroepfchen beobachtet fuehlst, laesst "
           "Du die Laden lieber verschlossen. ") );
  return 1;
 }
}

int c_decken(string str)
{
 if( str != "mit decke zu"     &&
     str != "mit bettdecke zu" )
 {
  notify_fail("Womit moechtest Du Dich zudecken?\n");
  return 0;
 }
 else
 {
  write(BS("Aber man legt sich doch nicht in fremde Betten und deckt sich "
    "zu! Hilf lieber den armen Tieren im Garten!"));
  return 1;
 }
}


int c_gucken(string str)
{
 if( str != "aus fenster" )
 {
  notify_fail("Woraus moechtest Du gucken?\n");
  return 0;
 }
 else
 {
  write(BS("Wunderschoen bunt strahlt Dir die Farbenpracht des Gartens "
           "entgegen. Du solltest Dich unbedingt einmal dort draussen "
           "in die Wiese legen. ") );
  return 1;
 }
}

