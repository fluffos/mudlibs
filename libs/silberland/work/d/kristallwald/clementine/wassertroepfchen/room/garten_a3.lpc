inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>
#include "../carolina.h"

int anz_hollerblueten = 2;

void reset()
{
        ::reset();
	anz_hollerblueten = 2;
}


void create()
{
  ::create();
  SetProp(P_INT_SHORT, "In einem kleinen Garten");
  SetProp(P_INT_LONG,
    "Wohin das Auge reicht nur Wiese! Nur westlich "
    "beim Gartenzaun steht eine Konstruktion aus Holz auf die eine Art "
    "Korb platziert wurde. Auf einer Seite scheint er eine kleine "
    "Oeffnung zu haben, in die immer wieder einige Bienen hineinfliegen. "
    "Suedlich stehen zwei grosse Obstbaeume, die bereits Fruechte "
    "tragen. Am blauen Himmel kannst Du eine kleine weisse Wolke erkennen. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_PLAIN]) );
  AddExit( "sueden", ROOM "garten_a2" );
  AddExit( "norden", ROOM "garten_a4" );


  AddItem(NPC "biene", REFRESH_DESTRUCT);

  AddDetail( ({ "fruechte" }),
    "Du kannst rote und orange Fruechte auf den Baeumen erkennen. ");

  AddDetail( ({ "marillen", "marille", "kirsche", "kirschen" }),
    "Geh doch nach Sueden, damit Du erkennen kannst, was da genau auf dem "
    "Baum waechst.");

  AddDetail( ({ "sueden" }),
    "Tipp: 's'");

  AddDetail( ({ "obstbaeume", "baeume" }),
    "Im Sueden stehen zwei grosse Obstbaeume, die bereits Fruechte tragen. "
    "Zwischen ihnen siehst Du etwas Tuerkises baumeln. ");

  AddDetail( ({ "tuerkises" }),
    "Was das wohl ist?");

  AddDetail( ({ "haengematte", "etwas" }),
    "Das baumelnde Etwas im Sueden koennte eine Haengematte sein.");

  AddDetail( ({ "auge" }),
    "Wiese, Wiese und nochmal Wiese - ueberall Wiese. Bis auf die recht "
    "eigenwillige Konstruktion mit dem Korb. ");
   
  AddDetail( ({ "konstruktion" }),
    "Die Konstruktion ist eine Mischung aus einem kleinen Tischchen und einem "
    "Hocker. Auf ihr steht ein Korb mit einem Loch. ");

  AddDetail( ({ "mischung" }),
    "Ob es jetzt ein Tisch oder ein Hocker ist kann man nicht genau sagen. "
    "Es ist irgendwie eine Mischung aus beiden.");

  AddDetail( ({ "tisch", "tischchen", "hocker" }),
    "Die recht sonderbar anmutende Konstruktion beim Gartenzaun ist eine "
    "Mischung aus Tisch und Hocker. Auf ihr steht ein Korb.");

  AddDetail( ({ "korb" }),
    "Der Korb auf der Konstruktion hat auf der einen Seite eine Oeffnung, bei "
    "der sich immer wieder einige Bienen tummeln. Natuerlich war Dir sofort "
    "klar, dass es sich um einen Bienenstock handelt. ");

  AddDetail( ({ "bienenstock" }),
    "Der Bienenstock hat auf der einen Seite eine Oeffnung, bei der die "
    "Bienen rein und auch wieder rausfliegen koennen. Ob in dem Stock "
    "leckerer Honig drinnen ist?");

  AddDetail( ({ "honig" }),
    "Von aussen kannst Du nirgends Honig erkennen. Du koenntest ja einmal "
    "hineingreifen, wenn Du mutig genug bist. Aber ob das wirklich zu "
    "empfehlen ist? Da koennten Dich einige Bienen stechen!");

  AddDetail( ({ "bienen", "biene" }),
    "Immer wieder fliegen Bienen in den Korb hinein, und auch wieder "
    "hinaus. Sie bringen sicherlich Bluetennektar in ihren Stock. ");

  AddDetail( ({ "stock" }),
    "Ein Bienenstock!");

  AddDetail( ({ "bluetennektar", "nektar" }),
    "Die fleissigen Bienen sammeln von den Blumen den Nektar, bringen "
    "diesen in den Bienenstock und dort verwandelt er sich fast wie von "
    "Zauberhand in Honig. ");

  AddDetail( ({ "zauberhand" }),
    "Gezaubert wird da zwar nichts, aber natuerlich hat die Natur ihre "
    "Finger im Spiel.");

  AddDetail( ({ "natur", "finger", "spiel" }),
    "Wir leben wirklich in einem ausgekluegeltem System. Die Natur ist "
    "wirklich perfekt. ");

  AddDetail( ({ "system" }),
    "Sehr raffiniert!");

  AddDetail( ({ "blumen" }),
    "Hier siehst Du keine, aber vielleicht findest Du woanders welche.");

  AddDetail( ({ "seite" }),
    "Auf einer Seite hat der Korb eine Oeffnung. ");

  AddDetail( ({ "art" }),
    "Eine Art Korb steht auf der hoelzernen Konstruktion. ");
 
  AddDetail( ({ "holz" }),
    "Die sonderbare Konstruktion besteht aus Holz. Welches es genau ist, "
    "laesst sich fuer Dich nicht erkennen. ");

  AddDetail( ({ "loch", "oeffnung" }),
    "Der Korb hat auf der einen Seite eine Oeffnung, vor der sich immer "
    "wieder einige Bienen tummeln.");

  AddDetail( ({ "boden" }),
    "Du stehst fest mit beiden Beinen auf der Erde, aeh Wiese.");

  AddDetail( ({ "erde" }),
    "Natuerlich stehst Du auf der Wiese.");

  AddDetail( ({ "beine", "bein" }),
    "Huch, natuerlich stehst Du mit den Fuessen in der Wiese und nicht mit "
    "den Beinen. Wobei ich hoffe, dass Du sowohl Fuesse, als auch Beine hast.");

  AddDetail( ({ "fuesse" }),
    "Du betrachtest Deine Fuesse. Irgendwie sahen die auch schon mal besser "
    "aus.");

  AddDetail( ({ "himmel" }),
    "Am Himmel siehst Du eine kleine weisse Wolke. Wirklich nicht gross, aber "
    "gross genug um sie erkennen zu koennen.");

  AddDetail( ({ "wolke" }),
    "Von hier unten sieht die Wolke klein und flauschig aus. Es wird doch "
    "nicht Regen geben? Nein... sicherlich nur eine Schoenwetterwolke.");

  AddDetail( ({ "schoenwetterwolke" }),
    "Die kleine flauschige Wolke traegt sicherlich keinen Regen mit sich. ");

  AddDetail( ({ "regen" }),
    "Du haeltst Deine Zunge in die Luft, es schmeckt absolut nicht nach "
    "Regen. ");

  AddDetail( ({ "zunge" }),
    "Deine Zunge schmeckt keinen Regen, also bist Du beruhigt. ");

  AddDetail( ({ "luft" }),
    "Tut mir leid, aber die Luft kannst Du hier einfach nicht untersuchen. "
    "(Na eigentlich tuts mir nicht leid, aber das geht einfach nicht!)");

  AddDetail( ({ "wiese", "gras" }),
    "Hier eine kleine Kurzform:\n"
    "Wiese: gruen, unter Dir!\n"
    "Gras: gruen, ebenfalls unter Dir!");

  AddDetail( ({ "kurzform" }),
    "Naja... mittlerweile solltest Du schon wissen, wie eine Wiese so "
    "aussieht. "); 

  AddDetail( ({ "gartenzaun", "zaun" }),
    "Die Holzlatten des Gartenzauns im Westen wurde weiss gestrichen. "
    "Sieht wirklich sehr idyllisch aus. In der Naehe des Zauns "
    "steht ein Bienenstock auf einer recht "
    "eigenwilligen Konstruktion. ");

  AddDetail( ({ "latten", "holzlatten" }),
    "Der Gartenzaun besteht aus weiss gestrichenen Holzlatten. Zwischen ihnen "
    "kannst Du recht eigenwilliges Gewaechs erkennen.");

  AddDetail( ({ "gewaechs" }),
    "Bei dem Gewaechs duerfte es sich um einen Hollerbusch handeln. ");

  AddDetail( ({ "busch" }),
    "Meinst Du einen bestimmten?");

  AddDetail( ({ "hollerbusch" }),
    "Tatsaechlich! Bei dem Gewaechs handelt es sich um einen Hollerbusch. "
    "Der kleine Busch traegt sogar noch einige Hollerblueten. ");

  AddDetail( ({ "hollerblueten" }),
    "Ob man sie pfluecken kann?");

  AddDetail( ({ "blueten" }),
    "Welche Blueten meinst Du? Die des Hollerbuschs?");

  AddDetail( ({ "naehe" }),
    "Ganz nah beim Gartenzaun steht das Holzteil. ");

  AddDetail( ({ "holzteil" }),
    "Na Du weisst doch - das HOLZTEIL!");


// SOUNDS

  AddSound(DEFAULT_SMELL,
    "Du hoerst froehlich zu, wie die Bienen vor sich hinsummen. ");

  AddSound( ({ "bienen", "biene" }),
    "Summ, summ, summ.... auf einmal vernimmst Du noch ein anderes seltsames "
    "Geraeusch.");

  AddSound( ({ "geraeusch" }),
    "Irgendjemand singt hier....");

  AddSound( ({ "irgendjemand" }),
    "Du siehst ihn zwar nicht, vernimmst aber eindeutig Justavius Stimme...");

  AddSound( ({ "stimme", "justavius" }),
    "Du hoerst Justavius in etwas schraeger Tonlage 'nothing else matters' "
    "singen.");

  AddSound( ({ "tonlage" }),
    "Etwas schraeg, aber wir wollen ja mal nicht so sein :)");

  AddSound( ( { "lied", "melodie" }),
    "Grusel!");

// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Es riecht nach Blumen, frischem Gras und Honig?!");

  AddSmell( ({ "blumen", "blume" }),
    "Hier ist zwar keine Blume, aber der Duft von Blumen weht durch den "
    "ganzen Garten.");

  AddSmell( ({ "duft", "garten" }),
    "Wirklich maerchenhaft und bezaubernd! Du magst diesen Duft wirklich!");

  AddSmell( ({ "gras" }),
    "Das Gras riecht nach Gras.");

  AddSmell( ({ "honig" }),
    "Irgendwie riechts hier nach Honig. Aber wie riecht Honig?!");


  AddCmd( ({ "greif", "greife" }), "c_greifen");
  AddCmd( ({ "pflueck", "pfluecke" }), "c_pfluecken");  

}

int c_pfluecken(string str)
{
        object holler;
	if(str != "hollerblueten" &&
	   str != "holler"        &&
	   str != "blueten"       )
	{
		notify_fail("Was moechtest Du hier pfluecken?\n");
		return 0;
	}
	else
	{
		if(anz_hollerblueten < 1)
		{
		 write(BS("Momentan kannst Du leider keine der Blueten "
			  "erreichen. Vielleicht solltest Du zu einem "
			  "spaeteren Zeitpunkt wieder kommen."));
		 return 1;
		}
		else
		{
		 write(BS("Geschickt pflueckst Du einige Hollerblueten vom "
			 "Busch."));
                 holler = clone_object(OBJ "holler");
		 if(holler->move(TP, M_GET) != 1)
		 {
		  tell_object(TP, "Das kannst Du nicht mehr tragen!\n");
		  holler->move(TO, M_NOCHECK);
		 }
		 anz_hollerblueten--;
		 return 1;
		}
	}
}


int c_greifen(string str)
{
 if(str != "in bienenstock" && 
    str != "in korb"        )
 {
  notify_fail("Wo moechtest Du reingreifen?\n");
  return 0;
 }
 else
 {
  write(BS("Du greifst mit der Hand in den Bienenstock...\n"
           "\n"
           "Auuuuuuuuuuuuuuuuuuuuuuuutsch!!! Irgendetwas hat Dich "
           "gestochen!!!!\n"));
  TP->do_damage(50);
  say(CTPN + " greift in den Bienenstock und verzieht das Gesicht.\n");
  return 1;
 }
}



