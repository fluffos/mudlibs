inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../carolina.h"


int anz_hagebutte;
int anz_klee;

void reset()
{
  ::reset();
  anz_hagebutte = 3;
  anz_klee = 1;
}


void create()
{
  ::create();
  anz_hagebutte = 3;
  anz_klee = 1;
  SetProp(P_INT_SHORT, "In einem kleinen Garten");
  SetProp(P_INT_LONG, 
    "Du stehst mitten in der Wiese, in der hier, abgesehen von Gras, auch "
    "viel Klee und Loewenzahn waechst. Zusammen gibt diese Kombination "
    "ein buntes froehliches Bild ab. Suedlich von Dir siehst Du das weit "
    "geoeffnete Vorzimmerfenster von Wassertroepfchens Haus. " 
    "Noerdlich von Dir rankt sich ein Strauch am Gartenzaun hoch, zu "
    "dem immer wieder einige Voegel fliegen. ");
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_PLAIN]) );
  AddExit( "westen", ROOM "garten_b4" );
  AddExit( "osten", ROOM "garten_d4" );


  AddItem(NPC "heuschrecke", REFRESH_DESTRUCT);



// DETAILBEGINN

  AddDetail( ({ "fenster", "vorzimmerfenster" }),
    "Durch das Fenster im Sueden kann man direkt in Wassertroepfchens "
    "Vorzimmer sehen. Allerdings findet sich nichts Besonderes in ihm, sodass "
    "Du Deinen Blick abwendest und in der Natur schweifen laesst. ");

  AddDetail( ({ "natur" }),
    "Du bist mitten drin in der Natur - mach die Augen auf!");

  AddDetail( ({ "augen" }),
    "Gut aufpassen und umsehen!");

  AddDetail( ({ "sueden" }),
    "Im Sueden befindet sich ein Fenster, durch das man in das Vorzimmer "
    "sieht.");

  AddDetail( ({ "wassertroepfchen", "wasserelfe" }),
    "Die kleine Wasserelfe ist momentan nicht hier.");

  AddDetail( ({ "besonderes" }),
    "Auf den ersten Blick kannst Du nichts Besonderes erkennen, weswegen "
    "Du auch denselbigen schweifen laesst.");

  AddDetail( ({ "blick" }),
    "Sieh Dir alles nur genau an, vielleicht findest Du ja etwas Wichtiges!");

  AddDetail( ({ "wichtiges" }),
    "Vielleicht gibt es hier etwas, was Du unbedingt brauchst.");

  AddDetail( ({ "etwas" }),
    "Na so waers doch viel zu einfach!");


  AddDetail( ({ "vorzimmer" }),
    "Das befindet sich suedlich von Dir im Haus. Wenn Du es Dir genauer "
    "ansehen moechtest, dann solltest Du schon direkt ins Haus hinein gehen.");

  AddDetail( ({ "haus" }),
    "Das Haus steht suedlich von Dir. Einen Eingang kannst Du hier nicht "
    "erkennen, sondern nur das Fenster, dass in Wassertroepfchens Vorzimmer "
    "fuehrt. ");

  AddDetail( ({ "eingang" }),
    "Eingang ist keiner hier. Vermutlich befindet er sich auf der anderen "
    "Seite. Oder moechtest Du vielleicht durch das Fenster kraxeln?");

  AddDetail( ({ "seite" }),
    "Am besten gehst Du um das Haus herum, damit Du siehst wo sich der "
    "Eingang befindet.");

  AddDetail( ({ "wiese", "boden" }),
    "Du stehst mitten in der Wiese drinnen mit Deinen Fuessen. Abgesehen "
    "von viel Gras siehst Du auch einige gelbe Loewenzahnkoepfe und massig "
    "Klee.");

  AddDetail( ({ "loewenzahnkoepfe", "koepfe" }),
    "Die Loewenzahnkoepfe sind ganz gelb. Man kann mit ihnen sicherlich eine "
    "leckere Loewenzahnbutter herstellen. Mjammm!");

  AddDetail( ({ "loewenzahnbutter", "butter" }),
    "Die schmeckt ausgesprochen lecker! Schade, dass Du momentan dafuer keine "
    "Zeit hast.");

  AddDetail( ({ "zeit" }),
    "Momentan hast Du keine Zeit um Dir ueber Loewenzahnbutter Gedanken "
    "zu machen.");

  AddDetail( ({ "gedanken" }),
    "Deine Gedanken kreisen hoffentlich um das arme Wassertroepfchen. Sie "
    "benoetigt dringend einen Hustensaft!");

  AddDetail( ({ "hustensaft" }),
    "Hast Du schon alle Zutaten zusammen?");

  AddDetail( ({ "zutaten" }),
    "Was da genau hineinkommt in den Hustensaft weiss ich leider selbst "
    "nicht so genau.");

  AddDetail( ({ "fuesse" }),
    "Sie stehen im Gras.");

  AddDetail( ({ "strauch", "heckenrose", "hagebuttenstrauch" }),
    "Der Strauch klettert mithilfe der hakig gekruemmten Stacheln wie eine "
    "Liane am Gartenzaun hoch. Gezackte Blaetter wachsen an den Zweigen, an "
    "deren Ende Du auch noch manchmal kleine rote Fruechte siehst. Deswegen "
    "tummeln sich wohl soviele Voegel hier. ");
   
  AddDetail( ({ "liane" }),
    "Mit seinen Stacheln und Dornen ist es dem Strauch moeglich wie eine "
    "Liane am Zaun hochzuklettern.");

  AddDetail( ({ "zaun", "gartenzaun" }),
    "Der Gartenzaun ist kaum mehr zu erkennen, da er von der Heckenrose "
    "fast voellig umgarnt wird. ");

  AddDetail( ({ "heckenrose" }),
    "Wirklich ein sehr schoener Strauch; Rosenblueten siehst Du allerdings "
    "keine mehr dran, bloss die roten Fruechte. Wofuer sie wohl gut sind?");

  AddDetail( ({ "fruechte", "frucht" }),
    "Die Voegel tummeln sich um die roten Fruechte. Ob sie lecker schmecken? "
    "Wenn Du weisst, wie die Frucht heisst, kannst Du Dir sicher auch eine "
    "pfluecken!");

  AddDetail( ({ "voegel" }),
    "Die Voegel sind ganz gierig auf die roten Fruechte der Heckenrose. "
    "Immer wieder fliegt einer hin und schnappt sich mit seinem Schnabel "
    "eine Frucht.");

  AddDetail( ({ "schnabel", "schnaebel" }),
    "Die Schnaebel der Voegel sind zwar recht klein, dennoch koennen sie "
    "mit ihnen sehr geschickt die roten Fruechte vom Strauch reissen.");

  AddDetail( ({ "himmel" }),
    "Der Himmel strahlt Dich blau an - kein einziges Woelkchen ist zu sehen.");

  AddDetail( ({ "woelkchen", "wolke", "wolken" }),
    "Keine einzige Wolke ist zu sehen. Vermutlich muss man heute wieder viel "
    "giessen, damit der Garten so schoen bleibt.");

  AddDetail( ({ "garten" }),
    "Du stehst mitten in ihm!");
  
  AddDetail( ({ "klee" }),
    "Klee findet man hier wirklich in Massen. Frueher galt der Klee "
    "als Symbol der dreifaeltigen Goettin - ein Blatt war Symbol der jungen "
    "Frau und ihrer Jugend; das zweite die Mutter, Symbol der Fruchtbarkeit "
    "und das dritte, die Greisin, als Symbol des Alters und der Weisheit. "
    "Vielleicht ist er deswegen in diesem Garten so gern gesehen. ");

  AddDetail( ({ "goettin", "blatt", "frau", "Jugend", "mutter", "greisin",
    "alter", "weisheit", "fruchtbarkeit" }),
    "Dem Klee wird viel zugesagt.");

  AddDetail( ({ "symbol" }),
    "Der Klee ist wirklich eine sehr symboltraechtige Pflanze. Man sagt "
    "ausserdem, dass sich der Rotklee gut in Tee macht.");

  AddDetail( ({ "rotklee", "tee" }),
    "Angeblich soll er gegen Halsschmerzen und Kopfweh helfen...");

  AddDetail( ({ "halsschmerzen", "schmerzen", "kopfweh", "halsweh",
    "kopfschmerzen" }),
    "Hals- und Kopfschmerzen sind die normalen Begleiterscheinungen bei "
    "einer Grippe.");

  AddDetail( ({ "grippe" }),
    "Hast Du eine? Oder kennst Du vielleicht jemand der eine hat? Dann "
    "freut er sich sicher ueber einen Tee mit Rotklee.");
 
  AddDetail( ({ "begleiterscheinungen", "erscheinungen" }),
    "Meistens bekommt man Halsweh oder Kopfweh und danach eine Grippe. Oder "
    "oftmals leider auch gleich alles zusammen.");

  AddDetail( ({ "pflanze", "pflanzen" }),
    "In einem Garten wachsen viele Pflanzen. Du musst Dich schon genauer "
    "ausdruecken!");

  AddDetail( ({ "massen" }),
    "Hier waechst wirklich sehr viel Klee!");

  AddDetail( ({ "bild", "kombination" }),
    "Hellgruenes Gras, dunkelgruener Klee, gelber Loewenzahn. Wirklich nett!");

  AddDetail( ({ "rosenblueten", "blueten" }),
    "Keine Rosenblueten zu sehen!");

  AddDetail( ({ "stacheln", "stachel", "dornen" }),
    "Die Dornen sind zwar nicht besonders spitz, man kann sich aber dennoch "
    "ziemlich weh tun, wenn man mitten draufgreift. ");

  AddDetail( ({ "blaetter" }),
    "Die Blaetter des Strauches sind ziemlich klein, dunkelgruen und "
    "gezackt. ");

  AddDetail( ({ "gras" }),
    "Wie auch im restlichen Garten ist das Gras hier ebenfalls gruen und "
    "sieht wie Gras aus.");

  AddDetail( ({ "hagebutte", "hagebutten" }),
    "Einige kannst Du noch am Strauch erkennen. Ob man sie pfluecken kann?");
 
  AddDetail( ({ "loewenzahn" }),
    "Gelber Loewenzahn waechst auf der Wiese. Wenn er sich im Herbst in "
    "Pusteblumen verwandelt solltest Du unbedingt noch mal herkommen!");

  AddDetail( ({ "pusteblume", "pusteblumen" }),
    "Macht irrsinnig viel Spass wenn man die Pusteblumen anpustet :)");

  AddDetail( ({ "spass" }),
    "Pusteblumen pusten macht Spass!");

  AddDetail( ({ "herbst" }),
    "Noch haben wir ja nicht Herbst! ");

  AddDetail( ({ "ende" }),
    "Am Ende siehst Du rote Fruechte.");

  AddDetail( ({ "zweige" }),
    "Die Zweige haben Dornen - auf ihnen wachsen Blaetter.");

 
//SMELLS

  AddSmell(DEFAULT_SMELL,
    "Ein suesser Geruch geht vom Loewenzahn auf der Wiese aus. Riecht halt "
    "so richtig nach Blumen!");

  AddSmell( ({ "loewenzahn" }),
    "Der Loewenzahn riecht angenehm suess!");

  AddSmell( ({ "blumen" }),
    "Blumig!");

  AddSmell( ({ "geruch" }),
    "Traumhaft!");


//SOUNDS

  AddSound(DEFAULT_SOUND,
    "Immer wieder hoerst Du das Zwitschern der Voegel und auch ganz leise "
    "ihre Fluegelschlaege.");

  AddSound( ({ "zwitschern", "voegel" }),
    "Tweet, tweet.");

  AddSound( ({ "fluegelschlaege", "schlaege" }),
    "Ganz leise hoert man manchmal die Fluegelschlaege der Voegel *pock* *pock "
    "wenn sie sich einige Fruechte vom Strauch stibitzen.");

  AddSound( ({ "strauch", "fruechte" }),
    "Weder der Strauch noch seine Fruechte geben Geraeusche von sich.");

  AddSound( ({ "geraeusche" }),
    "Lausch doch mal!");
 

  AddCmd( ({ "greif", "greife" }), "c_greifen");
  AddCmd( ({ "pflueck", "pfluecke" }), "c_pfluecken");
  AddCmd( ({ "kraxl", "kraxle", "kraxel" }), "c_kraxeln");


}

int c_greifen(string str)
{
 if(str != "auf dornen"    &&
    str != "auf stacheln"  )
 {
  notify_fail("Worauf moechtest Du greifen?\n");
  return 0;
 }
 else
 {
  write(BS("Nein. so doof bist Du nicht, dass Du das willst!"));
  say(CTPN+ " ist nicht doof!\n");
  return 1;
 }
}

int c_pfluecken(string str)
{
 object ha;
 object kl;

 if( str != "hagebutte"    &&
     str != "hagebutten"   &&
     str != "rotklee"      &&
     str != "rotkleeblatt" &&
     str != "kleeblatt"    &&
     str != "klee"         )
 {
  notify_fail("Was moechtest Du denn genau pfluecken?\n");
  return 0;
 }
 else
 {
  if( str == "hagebutte" ||
      str == "hagebutten" )
  {
   if(anz_hagebutte < 1)
   {
    write(BS("Leider erreichst Du keine Hagebutte, die Du pfluecken kannst. "
             "Am besten probierst Du es spaeter nochmal!"));
    return 1;
   }
   else
   {
    write(BS("Geschickt pflueckst Du Dir eine rote Hagebutte vom Strauch."));
    say(CTPN+ " werkelt am Strauch rum.\n");
    ha = clone_object(OBJ "hagebutte");
    if(ha->move(TP, M_GET) != 1)
    {
     tell_object(TP, "Das kannst Du nicht mehr tragen!\n");
     ha->move(TO, M_NOCHECK);
    }
    anz_hagebutte--;
    return 1;
   }
  }
   if( str == "rotkleeblatt" ||
       str == "kleeblatt" ||
       str ==  "klee" ||
       str == "rotklee") 
   {
    if(anz_klee < 1)
    {
     write(BS("Du findest momentan kein Kleeblatt, dass Dir wirklich "
              "gefaellt."));
     return 1;
    }
    else
    {
     write(BS("Du pflueckst Dir ein Kleeblatt."));
     say(CTPN+ " wuselt in der Wiese herum und laechelt verschwiegen.\n");
     kl = clone_object(OBJ "klee");
     if(kl->move(TP, M_GET) != 1)
     {
      tell_object(TP, "Das kannst Du leider nicht mehr tragen.\n");
      kl->move(TO, M_NOCHECK);
     }
     anz_klee--;
     return 1;
    }
   }
  }
} 

 
 



int c_kraxeln(string str)
{
 if( str != "durch das fenster" &&
     str != "durch fenster" )
 {
  notify_fail("Wodurch moechtest Du kraxeln?\n");
  return 0;
 }
 else
 {
  write(BS("Du kraxelst durch das Vorzimmerfenster.\n"));
  TP->move(ROOM "haus2", M_GO, "durch das Fenster", "kraxelt", 
     "kraxelt herein" );
  return 1;
 }
}
 
                               

