inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../carolina.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "In einem Keller");
  SetProp(P_INT_LONG,
    "Der ganze Raum wurde mit bunten Mosaikfliesen ausgelegt, selbst "
    "die Waende sind voll mit ihnen. In "
    "der Mitte steht ein seltsames Etwas auf dem Boden, bestehend "
    "aus einem hoelzernen Korb, der seitlich eine Hebelvorrichtung aufweist "
    "und Dich in seiner Erscheinung an eine mittelalterliche Weinpresse "
    "erinnert. Im Gegensatz zu draussen ist es hier angenehm kuehl. "); 

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]));

  AddExit( "norden", ROOM "keller1" );
  AddItem(OBJ "presse");

// DETAILBEGINN

  AddDetail( ({ "etwas" }),
    "Sehr abenteuerliche Erscheinung! Das Etwas besteht aus einem Korb und "
    "einer Hebelvorrichtung. Ob es eine Weinpresse ist?");

  AddDetail( ({ "erscheinung" }),
    "Wahrhaftig abenteuerlich!");

  AddDetail( ({ "korb" }),
    "Der Korb besteht aus Holz und erinnert Dich eher an einen "
    "Auffangbehaelter.");

  AddDetail( ({ "auffangbehaelter", "behaelter" }),
    "Fragt sich nur noch, was der Auffangbehaelter auffangen soll...");

  AddDetail( ({ "holz" }),
    "Du vermutest, dass es sich hierbei um Eichenholz handelt. Sicher bist "
    "Du Dir aber nicht. ");

  AddDetail( ({ "eichenholz", "eiche" }),
    "Vermutlich wurde der Korb aus Eichenholz gefertigt.");

  AddDetail( ({ "mitte" }),
    "Genau in der Mitte steht ein seltsames Etwas auf den bunten "
    "Fliesen.");

  AddDetail( ({ "fliesen", "fliese", "mosaikfliesen" }),
    "Der ganze Raum wurde mit vielen verschiedenen Fliesenteilen gefertigt, "
    "die zusammen ein buntes Mosaik ergeben.");

  AddDetail( ({ "fliesenteile", "teile" }),
    "Ganz viele unterschiedliche Fliesenteile wurden ihr verarbeitet - "
    "grosse, kleine, gelbe, blaue, bunt gemusterte, duenne, dicke.");

  AddDetail( ({ "hebelvorrichtung", "vorrichtung" }),
    "Die Hebelvorrichtung besteht wie der Name schon sagt aus einer "
    "Vorrichtung und einem Hebel. Ob man ihn druecken kann?");

  AddDetail( ({ "hebel" }),
    "Ein Hebel. Ein simpler Hebel. Man kann sicher etwas mit ihm "
    "anstellen - aber was?!");

// druecke hebel, ziehe hebel, ...

  AddDetail( ({ "erscheinung" }),
    "Dieses Ding in der Mitte des Raumes erinnert Dich in seiner "
    "Erscheinung an eine sehr mittelalterliche Weinpresse. Vielleicht sogar "
    "noch ein Relikt aus der Steinzeit.");

  AddDetail( ({ "steinzeit" }),
    "Naja, ob man in der Steinzeit schon Weinpressen hatte?");

  AddDetail( ({ "relikt" }),
    "Vielleicht ist es kein Relikt aus der Steinzeit, aber sicherlich ein "
    "Relikt aus irgendeiner vergangenen Zeit.");

  AddDetail( ({ "zeit" }),
    "Tipp: >zeit< dann siehst Du selbst wie spaet wir es haben.");

  AddDetail( ({ "raum", "keller", "kellerraum" }), QueryProp(P_INT_LONG)); 
 

  AddDetail( ({ "ding" }),
    "Ein wirklich sehr interessantes Ding! Ob es fuer etwas gut ist?");

  AddDetail( ({ "wand", "waende" }),
    "Es ist langweilig die Waende zu untersuchen, aber ich sag Dir dennoch "
    "dass auch sie verfliest sind, falls Du das noch nicht aus der "
    "Raumbeschreibung rausgelesen hast. Sonst findet man nichts "
    "Ungewoehnliches an den Waenden.");

  AddDetail( ({ "ungewoehnliches" }),
    "Es ist nichts Ungewoehnliches an den Waenden.");

  AddDetail( ({ "raumbeschreibung" }),
    "Der ganze Raum wurde mit bunten Mosaikfliesen ausgelegt, selbst "
    "die Waende sind voll mit ihnen. In der Mitte steht ein seltsames "
    "Etwas auf dem Boden, bestehend aus einem hoelzernen Korb, der "
    "seitlich eine Hebelvorrichtung aufweist und Dich in seiner Erscheinung "
    "an eine mittelalterliche Weinpresse erinnert. Im Gegensatz zu draussen "
    "ist es hier angenehm kuehl.\n"
    "Es gibt einen sichtbaren Ausgang: suedwesten.\n" 
    "Clementine zwingt Dich zu: schau\n");
   

  AddDetail( ({ "suedwesten" }),
    "Da ist ein roter Kreis im Suedwesten. So klein, dass Du ihn fast nicht "
    "erkannt haettest. ");

  AddDetail( ({ "kreis" }),
    "Ob man ihn druecken kann?"); // druecke kreis 

  AddDetail( ({ "ausgang", "norden" }),
    "Nach Norden kommt man wieder raus.");

  AddDetail( ({ "gegensatz" }),
    "Im Gegensatz zu draussen ist es hier drinnen angenehm kuehl. Genau "
    "richtig fuer einen Hitzkopf wie Dich.");

  AddDetail( ({ "hitzkopf" }),
    "Immer mit dem Kopf durch die Wand, gell?! :)");

  AddDetail( ({ "kopf" }),
    "Noch dran.");

  AddDetail( ({ "name" }),
    "Ich weigere mich dieses Detail zu beschreiben.");

  AddDetail( ({ "detail" }),
    "Vorschlaege fuer das Detail Name koennen gerne an mich gemailt werden.");

  AddDetail( ({ "vorschlaege" }),
    "Wenn Du einen Vorschlag hast, dann mails mir.");

  AddDetail( ({ "vorschlag" }),
    "mail clementine -> am besten in einer Post, falls Du nicht Seher bist.");

  AddDetail( ({ "seher" }),
    "Wenn Du keiner bist, dann geh in eine Post.");

  AddDetail( ({ "post" }),
    "Von der Gilde in Midas w n o o n.");

  AddDetail( ({ "midas", "gilde" }),
    "Weder die Gilde noch Midas sind hier.");

  AddDetail( ({ "decke" }),
    "Auch die Decke hat ein Mosaikmuster.");

  AddDetail( ({ "mosaikmuster", "muster", "mosaik" }),
    "Lustigbunte zusammengewuerfelte Mosaikfliesen ergeben ein ebenso "
    "seltsames Muster - selbstverstaendlich ohne jegliche Bedeutung - "
    "es sind ja schliesslich auch nur Fliesen die zusammengepanscht wurden.");

  AddDetail( ({ "bedeutung" }),
    "Einfache Fliesenstuecke, die an die Decke geklatscht wurden.");

  AddDetail( ({ "fliesenstuecke", "stuecke" }),
    "Fliesenstuecke, die irgendwann einmal sogar eine ganze Fliese gebildet "
    "haben. Mittlerweile sind es aber wie gesagt nur noch Bruchstuecke von "
    "Fliesen - sonst haette man ja auch kein Mosaik damit legen koennen.");

  AddDetail( ({ "bruchstuecke" }),
    "Einfache ganz simple Bruchstuecke, die frueher ganze Fliesen waren.");

  AddDetail( ({ "boden" }),
    "Der Boden ist verfliest, in seiner Mitte steht ein Etwas.");


// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Es ist absolut still hier - total angenehm!! ");

  AddSound( ({ "stille" }),
    "Es ist ueberhaupt nichts zu hoeren.");

// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Es riecht irgendwie suesslich. Je naeher man zur Presse kommt, desto "
    "intensiver wird der Geruch.");

  AddSmell( ({ "geruch" }),
    "Irgendwie suesslich!");

  AddSmell( ({ "presse" }),
    "Du riechst an der Presse.\n"
    "Ein suesslicher Geruch kommt von dort. Was das wohl ist?");


  AddCmd( ({ "drueck", "druecke" }), "c_druecken");

}

int c_druecken(string str)
{
 if(str != "kreis" )
 {
  notify_fail("Was moechtest Du druecken?\n");
  return 0;
 }
 else
 {
  write(BS("Du drueckst auf den roten Kreis und hoerst ein >Klick<."));
  say(CTPN+ " drueckt irgendwo drauf. Es macht >Klick<.\n");
  return 1;
 }
}


