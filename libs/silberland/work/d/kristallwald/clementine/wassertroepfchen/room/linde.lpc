
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include "../carolina.h"

#define MAX_PERSONEN 1

nosave string rindentext;
string *schaukler;

int schnitze (string str);
void setze_text(string str);
string frage_text();

int anz_bluete;

blub();


void create()
{
  ::create();
  rindentext = 0;
  anz_bluete = 1;
  SetProp(P_INT_SHORT, "Beim Lindenbaum");
  SetProp(P_INT_LONG,
    "Du stehst vor einer grossen Linde, deren dicke Aeste, so scheint es, "
    "direkt in den Himmel fuehren. Das Baenkchen entpuppt sich nun, da Du "
    "vor ihm stehst als eine kleine Schaukel, die mit zwei festen "
    "Seilen an einem Ast festgemacht wurde. Im Westen siehst Du nur ein "
    "undurchdringliches Dickicht. Weiter im Sueden gehts wieder in den "
    "normalen Garten zurueck. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN: TT_PLAIN]) );
  AddExit( "sueden", ROOM "garten_e3");
  SetProp(P_HIDE_EXITS, ({ "sueden" }) );
  schaukler = ({ });

// DETAILBEGINN

  AddDetail( ({ "garten" }),
    "In den Garten kommst Du nach Sueden zurueck. ");

  AddDetail( ({ "sueden" }),
    "Nach Sueden kommst Du wieder in den normalen Garten zurueck. ");

  AddDetail( ({ "westen" }),
    "Im Westen waechst ein undurchdringliches Dickicht - Straeucher und "
    "Buesche. Da sie so dicht wachsen, siehst Du nicht einmal, was sich "
    "dort befindet. ");

  AddDetail( ({ "dickicht" }),
    "Die Straeucher und Buesche im Westen bilden ein undurchdringliches "
    "Dickicht, durch das man nicht mal hindurchsehen kann. ");

  AddDetail( ({ "schaukel" }),
    "Die Schaukel besteht aus einem simplen Holzbrett, in dem sich auf "
    "jeder Seite zwei Loecher befinden. ");

  AddDetail( ({ "loecher" }),
    "Durch die Loecher im Holzbrettchen sind die Seile gezogen, die irgendwo "
    "weit oben an einem dicken Ast festgebunden wurden. ");

  AddDetail( ({ "brett", "holzbrett", "holzbrettchen", "brettchen" }),
    "Auf das kann man sich sicherlich setzen und schaukeln. ");

  AddDetail( ({ "seile", "seil" }),
    "Durch die Loecher im Brett sind Seile gezogen worden, die dann weit "
    "oben auf einem sehr dicken Ast der Linde festgebunden wurden. Ob "
    "sie wirklich fest verknotet sind?");

  AddDetail( ({ "knoten" }),
    "Sieht wie von einem Fachmann aus!");

  AddDetail( ({ "fachmann" }),
    "Irgendwer hat ihr anscheinend wirklich ein paar feste Knoten gemacht.");

  AddDetail( ({ "ast", "aeste" }),
    "Die Linde hat mehrere sehr dicke Aeste. An einem von ihnen wurden "
    "die Seile der Schaukel befestigt. ");

  AddDetail( ({ "seite" }),
    "Auf jeder Seite sind zwei Loecher in das Holz gebohrt worden.");

  AddDetail( ({ "holz" }),
    "Die Linde besteht aus Lindenholz und die Schaukel wohl aus "
    "Nussholz. ");

  AddDetail( ({ "nussholz" }),
    "Sieht wirklich sehr stabil aus!");

  AddDetail( ({ "lindenholz" }),
    "Sieh Dir doch den Stamm der Linde einfach genauer an, dann erfaehrst Du "
    "bestimmt auch mehr ueber das Lindenholz. ");

  AddDetail( ({ "buesche", "straeucher", "busch", "strauch" }),
    "Die Buesche und Straeucher sind schon so dicht zusammengewachsen, dass "
    "man weder Anfang noch Ende eines jeden einzelnen erkennt. ");

  AddDetail( ({ "anfang", "ende" }),
    "Weder Anfang noch Ende kann man erkennen.");

  AddDetail( ({ "baenkchen", "bank" }),
    "Das Baenkchen entpuppt sich, als Du genau vor ihm stehst nicht mehr "
    "als Baenkchen sondern kleine Schaukel. Ob man mit ihr schaukeln kann?");

  AddDetail( ({ "boden" }),
    "Am Boden waechst wie ueberall hier Gras. Nur unter der Schaukel ist es "
    "etwas lichter. Vermutlich ist die Schaukel oft in Verwendung. ");

  AddDetail( ({ "verwendung" }),
    "Sicherlich schaukelt hier oft der ein oder andere Besucher von "
    "Wassertroepfchen oder gar sie selbst. ");

  AddDetail( ({ "besucher" }),
    "Wassertroepfchen bekommt sicherlich viel Besuch. Du bist doch "
    "momentan auch ein Besucher von ihr?!");

  AddDetail( ({ "besuch" }),
    "Freunde und Bekannte kommen Wassertroepfchen oft besuchen, weil sie so "
    "ein sonniges Gemuet hat. ");

  AddDetail( ({ "freunde", "bekannte" }),
    "Die kleine Wasserelfe ist mit vielen gut befreundet. ");

  AddDetail( ({ "gemuet" }),
    "Wassertroepfchen hat ein sehr sonniges Gemuet - vielleicht ist das auch "
    "einer der Gruende warum sie so beliebt ist. ");

  AddDetail( ({ "gruende" }),
    "Mit Sicherheit gibt es mehrere Gruende, warum sie viele so gerne haben. "
    "Einer davon ist aber mit Gewissheit ihr sonniges Gemuet. ");

  AddDetail( ({ "gewissheit" }),
    "Das ist wirklich gewiss!");

  AddDetail( ({ "sicherheit" }),
    "Es gibt garantiert mehrere Gruende, Dir faellt aber momentan keiner "
    "ein. ");

  AddDetail( ({ "wasserelfe" }),
    "Wassertroepfchen ist eine kleine Wasserelfe - aber das wusstest Du "
    "bestimmt schon.");

  AddDetail( ({ "wassertroepfchen" }),
    "Bestimmt kommt Wassertroepfchen hier oft zum Schaukeln her. Momentan "
    "kannst Du sie aber nicht sehen. ");

  AddDetail( ({ "schaukeln" }),
    "Das macht bestimmt wahnsinnig viel Spass!");

  AddDetail( ({ "spass" }),
    "Probiers doch auch einmal!");

  AddDetail( ({ "gras" }),
    "Gruenes - ganz normales Gras. ");

  AddDetail( ({ "himmel" }),
    "Vor lauter Blaetterwerk kann man fast den Himmel nicht sehen. Nur "
    "manchmal blitzt er himmelblau durch. ");

  AddDetail( ({ "blaetterwerk", "blaetter" }),
    "An den Aesten siehst Du kleine Zweige, die wiederum einige gruene "
    "Blaetter tragen. An einem ist sogar eine Lindenbluete dran!");

  AddDetail( ({ "lindenbluete", "bluete" }),
    "Ob man sie pfluecken kann?");

  AddDetail( ({ "zweige" }),
    "Die kleinen Zweige tragen viele Blaetter! Sehr huebsch!");

  AddDetail( ({ "linde" }),
    "Vor Dir waechst eine grosse Linde mit dicken Aesten. ");

  AddDetail( ({ "stamm" }),
    "Der Stamm der Linde ragt vor Dir in die Hoehe. Er ist recht weich im "
    "Vergleich zu anderen Hoelzern und wird deswegen sicherlich gern zum "
    "Schnitzen verwendet. ");

  AddDetail( ({ "schnitzen" }),
    "Moechtest Du etwas schnitzen?");

  AddDetail( ({ "hoelzer", "vergleich" }),
    "Im Vergleich zu anderen Hoelzern gehoert die Linde eher den weicheren "
    "an. ");

  AddDetail( ({ "etwas" }),
    "Meinst Du den Text, den Du in den Stamm geschnitzt hast?");
 
  AddDetail( ({ "text" }), "Du kannst ihn lesen.");

  AddDetail( ({ "wind" }),
    "Wind kann man nicht sehen, hoechstens spueren.");

// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Du hoerst wie der Wind durch die Blaetter streift und sie leise "
    "rascheln.");
  
  AddSound( ({ "blaetter" }),
    "Du hoerst wie die Blaetter sanft im Wind rascheln. ");

  AddSound( ({ "wind" }),
    "Wenn der Wind durch die Blaetter weht, erzeugt das ein leises "
    "Rascheln.");

  AddSound( ({ "rascheln" }),
    "Es klingt fast so, als wuerde jemand Papier zerknuellen.");

  AddSound( ({ "papier" }),
    "*raschel*");

// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Es riecht hier nach vollkommener Natur!");

  AddSmell( ({ "natur" }),
    "Du atmest tief ein und nimmst die Natur in Dich auf.");

  AddSmell( ({ "linde" }),
    "Die Linde riecht nach Linde! Etwas suesslich - vermutlich kommt das "
    "von der Bluete.");


  AddReadDetail( "text", CLOSURE(blub));

  AddCmd( ({ "pflueck", "pfluecke" }), "c_pfluecken");
  AddCmd( ({ "spuer", "spuere" }), "c_spueren");
  AddCmd( ({ "sehe", "seh", "sieh" }), "c_sehen");
  AddCmd( ({ "schnitz", "schnitze" }), "schnitze");
  AddCmd( ({ "schaukel", "schaukle", "schaukl" }), "c_schaukeln");

}

int c_pfluecken(string str)
{
 object ob;
 if( str != "bluete"   &&
     str != "lindenbluete")
 {
  notify_fail("Was moechtest Du hier pfluecken?!\n");
  return 0;
 }
 else
 {
  if(anz_bluete < 1)
  {
   write(BS("Du streckst mit aller Kraft Deine Arme nach der Lindenbluete. "
            "Schade! Sie ist viel zu hoch!"));
   say(CTPN+ " streckt sich in die Hoehe.\n");
   return 1;
  }
  else
  {
   write(BS("Du streckst Dich in die Hoehe und pflueckst die Lindenbluete."));
   say(CTPN+ " streckt sich in die Hoehe und pflueckt irgendetwas.\n");
   ob = clone_object(OBJ "bluete");
   if(ob->move(TP, M_GET) != 1)
   {
    tell_object(TP, "Das kannst Du nicht mehr tragen!\n");
    ob->move(TO, M_NOCHECK);
   }
   anz_bluete--;
   return 1;
  }
 }
}

 



int c_spueren(string str)
{
 if(str != "wind" )
 {
  notify_fail("Was moechtest Du spueren?\n");
  return 0;
 }
 else
 { 
  write(BS("Du streckst Deine Hand in die Luft und spuerst den "
           "Wind auf Deiner Haut."));
  say(CTPN + " streckt die Hand in die Luft.\n");
  return 1;
 }
}
 


int c_sehen(string str)
{
 if( str != "durch dickicht" )
 {
  notify_fail("Wodurch moechtest Du sehen?\n");
  return 0;
 }
 else
 {
  write(BS("Du versuchst durchs Dickicht zu sehen - absolut zwecklos."));
  say(CTPN+ " schaut bloed drein.\n");
  return 1;
 }
}


void reset()
{
 
 ::reset();

 if(random(2))
 rindentext = 0;
 anz_bluete = 1; 
}

nosave int schnitze(string str)
{
 object ob;
 notify_fail("Was moechtest Du schnitzen?\n");
 if(!str)
 return 0;

 if(!objectp(ob=TP->QueryProp(P_WEAPON)))
 return write(BS("Du hast ja gar nichts, womit Du schnitzen kannst.")), 1;

 if(ob->QueryProp(P_WEAPON_TYPE)!=WT_KNIFE)
 return write(BS("Nur mit einem Messer kann man schoen schnitzen!")), 1;

 if(stringp(rindentext))
 return write(BS("Da ist schon etwas eingeschnitzt. Vielleicht solltest Du "
                 "es spaeter nochmal probieren.")), 1;

 write(BS("Du schnitzt etwas in den Stamm."));

 setze_text(str);
 
 WLOG(LOG "wassert.log", "schnitzt "+str);
 return 1;

}

string frage_text()
{
 return rindentext;
}

void setze_text(string str)
{
 rindentext = str;
}

string blub()
{
 if(stringp(rindentext))
 return BS(rindentext);

 return BS("Du kannst nichts mehr erkennen.");

}


// Schaukelsequenz

int c_schaukeln(string str)
{
  notify_fail("Worauf moechtest Du schaukeln?\n");
  if(str != "auf schaukel"  &&
     str != "mit schaukel" )
  return 0;
 
 if(member(schaukler, getuuid(TP)) != -1)
 {
  write("Du schaukelst doch schon!\n");
  return -1;
 } 

 if(sizeof(schaukler) >= MAX_PERSONEN)
 {
 write("Auf der Schaukel schaukelt doch schon wer!\n");
 return -1;
 }
// schaukler += ({ getuuid(TP) });
 schaukler += ({ getuuid(TP) });
 TP->SetProp(P_PARALYZED,
  ([ PARALYZE_TIME: 14,
     PARALYZE_MSG: "Aber Du schaukelst doch!\n",
     PARALYZE_MSG_OTHER: "%s schaukelt.\n",
     PARALYZE_END: "",
     PARALYZE_END_OTHER: ""]) );

  call_out("sum0", 2);
  return 1;
 }


void sum0()
{
 write("\n");
 write(BS("Vorsichtig setzt Du Dich auf die Schaukel.\n"
          "Ah zum Glueck haelt sie Dein Gewicht aus!\n"));
 call_out("sum1", 3);
}

void sum1()
{
 write("\n");
 write(BS("Mit Deinen Fuessen stoesst Du Dich etwas vom Boden ab, damit "
          "Du genug Schwung fuers Schaukeln bekommst."));
 call_out("sum2", 4);
}

void sum2()
{
 write("\n");
 write(BS("Du streckst die Beine aus und ziehst sie wieder ein und "
          "schaukelst dadurch immer hoeher und hoeher."));
 call_out("sum3", 4);
}

void sum3()
{
 write("\n");
 write(BS("Vor.... und zurueck.... und wieder vor.... und zurueck....\n"));
 call_out("sum4", 2);
}

void sum4()
{
 write("\n");
 write(BS("Du fuehlst Dich auf einmal so schwerelos und frei!\n"
          "Ein Gefuehl, dass niemand auf der Welt Dich jetzt stoppen "
          "koennte..."));
 call_out("sum5", 4);
}

void sum5()
{
 write("\n");
 write(BS("Ist das nicht herrlich!!!\n"
          "Die ganze Welt liegt Dir zu Fuessen. "));
 call_out("sum6", 4);

}

void sum6()
{
 write("\n");
 write(BS("Vor und zurueck, vor und zurueck....\n"));
 call_out("sum7", 2);
}

void sum7()
{
 write("\n");
 write(BS("Ploetzlich wirst Du langsamer und verlierst an Schwung..."));
 call_out("sum8", 2);
}

void sum8()
{
 write("\n");
 write(BS("Hach, war das schoen. Zufrieden springst Du von der Schaukel."));
 TP->move(ROOM "linde");
 say(CTPN+ " springt von der Schaukel.\n");
 TP->SetProp(PARALYZE_TIME, 0);
 schaukler -= ({ getuuid(TP) });
}

                  
 	 
 
void BecomesNetDead(object player)
{
  if(member(schaukler, getuuid(player)) != -1)
  {
   schaukler -= ({ getuuid(player) });
   say(CTPN+ " schlaeft ein und plumpst von der Schaukel.\n");
  }
}

void NotifyPlayerDeath(object player, object killer, int lost_xp)
{
  schaukler -= ({ getuuid(player) });
}

