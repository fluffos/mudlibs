inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../carolina.h"

int alle_kraeuter_da();
int anz_murmel;
int kasten_zu;
int boden_sauber;
topffunc();
wasserfunc();
object ob;

string *kraeuter=({ "\nholler", "\nefeu", "\nbluete", "\nbrennessel",
		    "\nklee", "\nschafgarbe", "\nhagebutte", "\nzucker" });

void create()
{
  ::create();
  anz_murmel = 1;
  SetProp(P_INT_SHORT, "In einem kleinen Haeuschen");
  SetProp(P_INT_LONG, 
    "Du stehst inmitten einer riesigen Kueche. Ein grosser Kachelofen steht "
    "an der Wand und strahlt eine angenehmen Waerme aus. An den Waenden "
    "haengen viele Kuechenutensilien, die wohl regelmaessig zum Kochen "
    "benutzt werden. Das Fenster ist weit geoeffnet und bringt frische "
    "Luft herein. In der Mitte des Raumes steht ein grosser Tisch, der wohl "
    "als Arbeitsflaeche dient. Neben einem alten Eichenholzkasten kannst Du "
    "einen Eimer samt Besen erkennen. ");  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );
  AddExit( "westen", ROOM "haus2" );

  AddItem(OBJ "arbeitsflaeche");

// DETAILBEGINN

  AddDetail( ({ "raum", "kueche" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "decke" }),
    "Die Decke ist hoch ueber Dir, Du kannst allerdings keine einzige "
    "Lichtquelle an ihr entdecken.");

  AddDetail( ({ "heferl" }),
    "Da stehen doch tatsaechlich ein paar herum. Aber die interessieren "
    "Dich jetzt wirklich nicht weiter.");

  AddDetail( ({ "licht", "lichtquelle" }),
    "Hier ist nichts zu sehen. Vielleicht macht sich Wassertroepfchen wenn "
    "sie am Abend kocht eine Kerze an.");

  AddDetail( ({ "kerze", "kerzen" }),
    "Sehen kannst Du keine Kerze. Aber Du bist Dir sicher, dass "
    "Wassertroepfchen irgendwo eine hat.");

  AddDetail( ({ "teil" }),
    "Welches Teil meinst Du denn?");

  AddDetail( ({ "kehren" }),
    "Ja, das macht man normalerweise mit einem Besen.");

  AddDetail( ({ "eimer", "kuebel" }),
    "Ein Eimer steht im Eck. Er ist leer und wird wohl nicht allzuoft "
    "verwendet.");

  AddDetail( ({ "abend" }),
    "Der ist noch nicht gekommen.");

  AddDetail( ({ "besen" }),
    "Der Besen ist sicherlich zum Kehren gedacht, wenn man beim Kochen "
    "Schmutz macht.");

  AddDetail( ({ "grosseltern" }),
    "Ja, damals hat man noch anders als heute gekocht.");

  AddDetail( ({ "gemuese" }),
    "Du kannst hier kein Gemuese sichten. Vielleicht solltest Du selbst "
    "einmal eines mitnehmen und Dir etwas leckeres kochen.");

  AddDetail( ({ "leckeres" }),
    "Einen Gemueseauflauf zum Beispiel!");

  AddDetail( ({ "auflauf", "gemueseauflauf" }),
    "Schon beim Gedanken an einen Gemueseauflauf beginnst Du zu sabbern.");

  AddDetail( ({ "gedanken", "gedanke" }),
    "Soviele intelligente Gedanken hast Du ja normalerweise nicht...");

  AddDetail( ({ "schmutz" }),
    "Ja, der Schmutz entsteht wenn man kocht. Zumindest meistens :)");

  AddDetail( ({ "meinung" }),
    "Die kannst Du ja Clementine mailen.");

  AddDetail( ({ "clementine" }),
    "Kennst Du sie?");


  AddDetail( ({ "fenster" }),
    "Das Fenster geht nach Norden raus und ist weit geoeffnet, sodass man "
    "in den Garten blicken kann." );

  AddDetail( ({ "garten" }),
    "Der Garten geht um das Haus herum. Um ihn naeher zu erforschen solltest "
    "Du schon nach draussen gehen!");

  AddDetail( ({ "kachelofen", "ofen" }),
    "Im Kachelofen brennt noch ein Feuer. Pass also auf, dass Du Deine "
    "Finger nicht an der Herdplatte verbrennst. ");

  AddDetail( ({ "tisch" }),
    "Der Tisch steht genau in der Mitte des Raumes. Auf der Arbeitsflaeche "
    "kann man sicherlich prima Sachen abstellen. ");

  AddDetail( ({ "sachen" }),
    "Kraeuter zum Beispiel. ");

  AddDetail( ({ "kraeuter" }),
    "Die koenntest Du prima auf der Arbeitsflaeche ablegen. ");

  AddDetail( ({ "flaeche", "arbeitsflaeche" }),
    "Wenn Du hier keine Arbeitsflaeche siehst, dann stimmt etwas nicht.");

  AddDetail( ({ "utensilien", "kuechenutensilien" }),
    "Ui, sind das aber viele! Bei einigen weisst Du nicht einmal, wofuer sie "
    "benutzt werden... Ein grosses Etwas mit Loechern baumelt von einem Haken, "
    "auf einem anderen siehst Du ebenfalls ein groesseres Ding mit einer "
    "Kurbel... Zum Glueck erkennst Du wenigstens den Schoepfer und die "
    "Topflappen.");

  AddDetail( ({ "ding", "kurbel" }),
    "Das grosse Ding hat eine Kurbel. Wofuer das wohl gut ist? "
    "Irgendetwas sagt Dir, dass Deine Grosseltern mit so einem Teil unter "
    "anderem Gemuese passiert haben.");

  AddDetail( ({ "flotte lotte", "flottelotte", "lotte" }),
    "Mit einem Kennerblick ist Dir natuerlich sofort klar, dass es sich bei "
    "dem grossen Ding mit der Kurbel um eine Flotte Lotte handelt.");

  AddDetail( ({ "etwas" }),
    "Ein grosses bauchiges Etwas mit Loechern baumelt von einem Haken.");

  AddDetail( ({ "haken" }),
    "Davon gibt es hier mehrere.");

  AddDetail( ({ "loecher" }),
    "Das grosse bauchige Etwas hat Loecher wie Du selbstsicher feststellst.");

  AddDetail( ({ "sieb", "kuechensieb" }),
    "Hmm. Ein ganz normales Kuechensieb, wie man es doch des Oefteren beim "
    "Kochen benoetigt. "); 

  AddDetail( ({ "glueck" }),
    "Na WoodyseiDank, dass Du zumindest den Schoepfer und die Topflappen "
    "erkennst.");

  AddDetail( ({ "schoepfer", "kelle", "schopfloeffel", "suppenkelle" }),
    "Der Schoepfer, oder auch Kelle genannt, ist aus Silber gefertigt und "
    "sicherlich schon sehr alt. Ob auch er ein Geschenk der Zwerge an "
    "Wassertroepfchen war?");

  AddDetail( ({ "silber" }),
    "Wie Du sofort erkannt hast ist der Schoepfer aus feinem Silber gefertigt "
    "worden. Seitlich am Stiel erkennst Du eine winzig kleine Inschrift.");

  AddDetail( ({ "stiel" }),
    "Na der, des Schoepfers!");

  AddDetail( ({ "inschrift", "gravur" }),
    "Die Inschrift wurde kunstvoll von Meisterhand in den Schoepfer graviert.");

  AddReadDetail( ({ "inschrift", "gravur" }),
    "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n"
    "| Mit inniger Verbundenheit und tiefster Ergebenheit |\n"
    "|				             Amaliro |\n"
    "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n");

  AddDetail( ({ "zwerge", "zwerg" }),
    "Der meisten von ihnen leben in Felonia.");

  AddDetail( ({ "felonia" }),
    "Felonia liegt etwas versteckt im Gebirge.");

  AddDetail( ({ "gebirge" }),
    "Hier kannst Du keines finden.");

  AddDetail( ({ "amaliro" }),
    "Wer er wohl war?");

  AddDetail( ({ "geschenk" }),
    "Ein sehr schoenes Geschenk, wie Du findest.");

  AddDetail( ({ "beispiel", "beispiele" }),
    "Der Tisch eignet sich sicherlich prima um Kraeuter hier abzulegen.");

  AddDetail( ({ "woodyseidank" }),
    "Du kniest nieder und betest zu Woody.");

  AddDetail( ({ "woody" }),
    "Tipp doch mal finger woody.");

  AddDetail( ({ "stiel" }),
    "Der Stiel des Schoepfers hat eine Inschrift graviert.");

  AddDetail( ({ "topflappen", "lappen" }),
    "Du siehst 2 bunte Topflappen an den Haken haengen. Sie wurden aus "
    "dicker Wolle gehaekelt und schuetzen Wassertroepfchens Finger beim "
    "Kochen vor Verbrennungen.");

  AddDetail( ({ "kochen" }),
    "Kochen kann man in einer Kueche sicher prima, vorallem in dieser.");

  AddDetail( ({ "wolle" }),
    "Die Topflappen wurden aus Wolle gehaekelt. Natuerlich wurde darauf "
    "wert gelegt, dass die Wolle sehr dick ist, damit man sich beim Kochen "
    "nicht verbrennt.");

  AddDetail( ({ "finger" }),
    "Verbrenn sie Dir nicht!");

  AddDetail( ({ "wassertroepfchens finger" }),
    "Die sind sicher noch heil, wenn sie immer die Topflappen beim Kochen "
    "verwendet.");

  AddDetail( ({ "verbrennungen" }),
    "Verbrennungen sind wirklich sehr schmerzvoll, oder nicht?!");

  AddDetail( ({ "wassertroepfchen" }),
    "Die kleine Wasserelfe ist gerade nicht hier.");

  AddDetail( ({ "elfe", "wasserelfe" }),
    "Wo sie bloss steckt?");

  AddDetail( ({ "herdplatte" }),
    "Auf der Herdplatte steht ein Topf. ");

  AddDetail( ({ "topf" }), #'topffunc);
  
  AddDetail( ({ "wasser" }), #'wasserfunc);


  AddDetail( ({ "meisterhand" }),
    "Du bist Dir ganz sicher, dass es von Meisterhand war. Amateure bekommen "
    "so etwas Feines und Kunstvolles garantiert nicht hin.");

  AddDetail( ({ "feines", "kunstvolles" }),
    "Sehr sehr fein und kunstvoll wurde die Inschrift gearbeitet.");
 

  AddDetail( ({ "bohlen", "holzbohle" }),
    "Der Boden besteht aus ihnen - Du stehst auf ihnen :)");

  AddDetail( ({ "pflanzen" }),
    "Meinst Du etwa die gruenen?");

  AddDetail( ({ "gruene pflanzen" }),
    "Vielleicht lohnt es sich, wenn Du sie Dir etwas naeher von draussen "
    "ankuckst.");

  AddDetail( ({ "haus" }),
    "Wo denkst Du stehst Du denn gerade, wenn nicht im Haus?!");

  AddDetail( ({ "waerme" }),
    "Du bist also der Meinung, dass man Waerme sehen kann?! Interessant! "
    "Vielleicht teilst Du mir bei Zeiten einmal mit, wie das gehen soll...");

  AddDetail( ({ "tee", "hustensaft" }),
    "Du siehst hier keinen!");

  AddDetail( ({ "mitte" }),
    "In der Mitte des Raumes steht ein grosser Tisch. Darunter liegen ein "
    "paar Kruemel, die wohl vom Kochen stammen.");

  AddDetail( ({ "kruemel" }),
    "Naja ein paar liegen unter dem Tisch in der Mitte des Raumes. ");
  
  AddDetail( ({ "feuer" }),
    "Das Feuer im Kachelofen brennt noch und erzeugt eine angenehme Waerme "
    "im Raum. ");

  AddDetail( ({ "luft" }),
    "Du tastest die Luft nach Unebenheiten ab.");

  AddDetail( ({ "unebenheiten" }),
    "So eine Luft kann ja manchmal wirklich soooooooo uneben sein...");

  AddDetail( ({ "waende" }),
    "Hier gibt es mehrere Waende.");

  AddDetail( ({ "wand" }),
    "Welche Wand moechtest Du denn naeher untersuchen?");

  AddDetail( ({ "nordwand" }),
    "An der Nordwand faellt Dir vorallem das Fenster auf.");

  AddDetail( ({ "ostwand" }),
    "An der Ostwand steht der grosse Kachelofen.");

  AddDetail( ({ "suedwand" }),
    "An der Suedwand siehst Du diverse Haken, an denen Kuechenutensilien "
    "haengen. Ein Eichenholzkasten steht im Eck. ");

  AddDetail( ({ "westwand" }),
    "An der Westwand ist ein Bogen, durch den man nach Westen gehen kann.");

  AddDetail( ({ "bogen", "tuer" }),
    "Statt einer Tuer befindet sich im Westen lediglich ein Bogen, durch den "
    "man wieder aus der Kueche gelangt.");
 
  AddDetail( ({ "eck" }),
    "In dem Eck zwischen Sued- und Westwand steht ein Eichenholzkasten.");

  AddDetail( ({ "essen" }),
    "Du kannst kein Essen finden, vielleicht aber riechen?");

  AddSpecialDetail( ({ "eichenholzkasten", "eichenkasten", "holzkasten",
			"kasten" }), "detail_kasten");

  AddDetail( ({ "eichenholz" }),
    "Das meiste hier wurde aus Eichenholz gefertigt. ");  

// SMELLS
	
  AddSmell(DEFAULT_SMELL, "Hier duftet es einfach herrlich!");

  AddSmell( ({ "duft" }),
    "Der Duft von frischem Essen liegt in der Luft.");

  AddSmell( ({ "essen" }),
    "Sehen kann man keines mehr, aber der Duft von frischem Essen liegt noch "
    "in der Luft.");

  AddSmell( ({ "luft" }),
    "Ein feiner Duft liegt in der Luft.");

// SOUNDS

  AddSound(DEFAULT_SOUND, "Leise hoerst Du das Knistern des Feuers im Ofen.");

  AddSound( ({ "knistern" }),
    "*knisters* *knister*");

  AddSound( ({ "feuer" }),
    "Das Feuer knistert leise im Ofen.");

  AddSound( ({ "ofen" }),
    "Es ist nicht wirklich ratsam sein Ohr an einen warmen Ofen zu halten, in "
    "dem noch Feuer knistert!");

  AddSound( ({ "ohr" }),
    "Pfui, denk mit!");

  AddSpecialDetail( ({ "boden" }), "detail_boden");
  AddCmd( ({ "putze", "fege", "feg", "putz"," kehr", "kehre" }), "c_putzen");
  AddCmd( ({ "verbrenn", "verbrenne" }), "c_verbrennen");
  AddCmd( ({ "greif", "greife", "fass", "fasse" }), "c_greifen");
  AddCmd( ({ "schau", "schaue", "blick", "blicke" }), "c_schauen");
  AddCmd( ({ "schliess", "schliesse" }), "c_schliessen");
  AddCmd( ({ "fuehl", "fuehle" }), "c_fuehlen");
  AddCmd( ({ "nimm", "nehme", "nehm" }), "c_nehmen");
  AddCmd( ({ "bueck", "buecke" }), "c_buecken");
  AddCmd( ({ "oeffne" }), "c_oeffnen");
  AddCmd( ({ "schliesse", "schliess" }), "c_schliessen");
  AddCmd( ({ "wirf", "werfe" }), "c_werfen");

}

int alle_kraeuter_da()
{
  int i;

  for (i=0; i<sizeof(kraeuter); i++) {
    if(!present(kraeuter[i],TP)) {
      return 0;
    } 
  }
  return 1;
}



void reset()
{
	::reset();
        anz_murmel = 1;
	boden_sauber = 0;
	kasten_zu = 0;
	return;
}

int c_werfen(string str)
{
       object ob;
       object heferl;
       int n;
       int i;
       string was, wovon;  
              
            
       notify_fail("Was moechtest Du werfen und wohin?\n");
       if(!str || str == "") return 0;

	n = sscanf(str, "%s in %s", was, wovon);
	if(n!=2){n=sscanf(str, "%s in %s hinein", was, wovon);}
        if(n!=2){return 0;}	

        if(!((wovon == "topf")))
	{
		return 0;
        }
	else
        {
		if(!present(QUESTITEM, TP))
		{
	          write(BS("Du kannst da nix in den Topf reinwerfen... "
				  "Zumindest noch nicht jetzt..."));
		  return 1;
		}
	        else
		{
		 if(!alle_kraeuter_da())

		 {
			 write(BS("Du hast ja noch nicht mal alle Zutaten "
				  "fuer den Hustensaft zusammen! "
				  "Komm wieder, wenn Du alles "
				  "beisammen hast!"));
			 return -1;
		 }
	         if(!present("\nloeffel", TP))
		 {
			 write(BS("Du hast doch noch gar keinen Loeffel zum "
				  "Umruehren!"));
			 return -1;
		 }
	
		
		  
              write(BS("Du wirfst alle Zutaten fuer Wassertroepfchens "
		       "Hustensaft in den Topf, ruehrst noch mal um und "
		       "giesst ihn schnell in ein Heferl, dass "
		       "Du gerade in der Naehe des Ofens entdeckt hast."));
	      for(i=0;i<sizeof(kraeuter);i++) {
		  if(ob=present(kraeuter[i], TP))		  {
		   ob->remove(M_SILENT);

		  }  
	      }        
	       //   return 1; 
	          
		  
		 
		 heferl = clone_object(OBJ "heferl");
		 heferl->move(TP,M_GET); 
		 return 1;
		}}
	  }	
		
		


int c_buecken(string str)
{
	if(str != "nach kruemel")
	{
		notify_fail("Wonach willst Du Dich buecken?\n");
		return 0;
	}
	else
	{
		write(BS("Du bueckst Dich nach den Kruemeln, ueberlegst es "
			 "Dir dann aber doch anders und stehst wieder auf."));
		say(CTPN+ " robbt auf den Knien.\n");
		return 1;
	}
}


int c_nehmen(string str)
{
	if(str != "kruemel" )
	{
		notify_fail("Was moechtest Du nehmen?\n");
		return 0;
	}
	else
	{
		write(BS("Dafuer solltest Du Dich schon buecken!"));
		return 1;
	}
}

int c_fuehlen(string str)
{
	if(str != "waerme")
	{
		notify_fail("Was moechtest Du hier fuehlen?\n");
		return 0;
	}
	else
	{
		write(BS("Du spuerst die angenehme Waerme die vom "
			 "Kachelofen ausgeht. Geh lieber nicht zu nahe "
			 "hin, damit Du Dich nicht verbrennst."));
		return 1;
	}
}

int c_schliessen(string str)
{
	if(str != "fenster" &&
	   str != "kasten"  &&
	   str != "eichenkasten" &&
	   str != "eichenholzkasten" )
	{
		notify_fail("Was moechtest Du machen?\n");
		return 0;
	}
	if( str == "fenster")
	{
		write(BS("Das Fenster moechte nicht "
			 "von Dir geschlossen werden!!"));
		return 1;
	}
        else
	{
	  if(kasten_zu = 0)
	  {
		  write(BS("Der Kasten ist doch schon zu!"));
	          return -1;
	  }
	  else
	  {
		  write(BS("Du schliesst den alten Eichenkasten."));
		  say(CTPN+ " schliesst den Kasten.\n");
		  kasten_zu = 0;
	          return 1;
	  }
	}
}


int c_schauen(string str)
{
	if(str != "durch fenster" &&
	   str != "bei fenster raus" &&
	   str != "durch fenster hinaus" &&
	   str != "bei fenster hinaus" )
	{
		notify_fail("Wo moechtest Du durchblicken?\n");
		return 0;
	}
	else
	{
		write(BS("Als Du aus dem Fenster blickst, fallen Dir "
			 "sofort einige gruene Pflanzen auf, die dort "
			 "wuchern."));
		return 1;
	}
}


int c_greifen(string str)
{
	if(str != "herdplatte an" &&
	   str != "auf platte"        &&
           str != "platte an"     &&	   
	   str != "auf herdplatte" )
	{
		notify_fail("Was moechtest Du angreifen?\n");
		return 0;
	}
	else
	{
		write(BS("Du greifst wider besseren Wissens auf die "
			 "die Herdplatte und verbrennst Dir freiwillig "
			 "Deine Finger. "
			 "Irgendwie fuehlst Du Dich ganz schoen doof."));
		say(CTPN+ " verzieht das Gesicht und fuehlt sich "
			  "danach ganz schoen doof.\n");
	        TP->do_damage(10), this_object();
		return 1;
	}
}

int c_verbrennen(string str)

{
	if(str != "finger")
	{
		notify_fail("Was moechtest Du verbrennen?\n");
		return 0;
	}
	else
	{
		write(BS("Wenn Du Dir die Finger verbrennen willst, "
			 "dann musst Du schon auf die Herdplatte greifen."));
		return 1;
	}
}

int c_oeffnen(string str)
{
	object ob;
	if(str != "kasten" &&
	   str != "eichenkasten" &&
	   str != "eichenholzkasten" )
	{
		notify_fail("Was moechtest Du hier oeffnen?\n");
		return 0;
	}
        if(kasten_zu != 0)
	{
	 write(BS("Der Kasten ist doch schon offen!"));
	 return -1;
        }
	else
	{
         if(anz_murmel < 1) 
	 {
	 write(BS("Du oeffnest den Kasten, kannst aber nichts darin finden."));
	 say(CTPN+ " oeffnet den Eichenholzkasten.\n");
         kasten_zu = 1;
	 return 1;
         }
	 else 
	 {
	 write(BS("Du oeffnest den Kasten, und steckst einen kleinen "
		  "Gegenstand ein, der Dir entgegenkullert."));
	 say(CTPN+ " oeffnet den Eichenholzkasten.\n");
	 ob = clone_object(OBJ "murmel");
	 ob->move(TP);
         kasten_zu = 1;
	 anz_murmel--;
	 return 1;
         }
	}
}


int c_putzen(string str)
{

	if(str != "boden mit besen")
	{
	 notify_fail("Was moechtest Du womit fegen?\n");
	 return 0;
	}
	if (boden_sauber != 0)
	{
         write(BS("Der Boden wurde gerade erst frisch geputzt. Es zahlt "
		   "sich also nicht aus ihn nochmals zu putzen."));
	 return -1;
	}
	else
	{
	 write(BS("Froehlich pfeifend holst Du Dir den Besen aus dem Eck und "
		  "fegst gruendlich ueber die Holzbohlen bis sie glaenzen."));
         say(CTPN+ " fegt froehlich pfeifend durch die Kueche.\n");
	 boden_sauber = 1;
	 return 1;

        }
}

wasserfunc()
{
 if(!present(QUESTITEM, TP))
 {
   return(BS("Ja, im Topf ist Wasser drinnen. Das interessiert Dich momentan "
	     "aber noch nicht. Vielleicht solltest Du vorher mit "
	     "Wassertroepfchen sprechen"));
 }
 else
 {
   return(BS("Das Wasser im Topf scheint noch warm zu sein. Vielleicht kannst "
	     "Du hier den Hustensaft fuer Wassertroepfchen zubereiten."));
 }
}

topffunc()
{
  if(!present(QUESTITEM, TP))
  {
   return(BS("Der Topf steht hier einfach nur auf dem Herd. "
		   "Wer weiss wofuer er gut ist..."));
  }
  else
  {
	  return(BS("Der Topf der auf dem Herd steht ist mit etwas Wasser "
		   "befuellt. Es scheint sogar noch warm zu sein - sicherlich "
		   "ideal um Tee oder aehnliches zu kochen."));
	  
  }
}

string detail_kasten(string key)
{
	if(kasten_zu != 0)
	{
	 return(BS("Der Eichenholzkasten steht offen, ist aber "
		   "seltsamerweise leer."));
	}
	else
	{
	 return(BS("Der Eichenholzkasten ist geschlossen."));
	}
}

string detail_boden(string key)
{
  if(boden_sauber != 0)
  {	  
   return (BS("Der Boden wurde gerade erst frisch geputzt. Es macht also "
	     "keinen Sinn nochmal zu fegen!"));
  }
  else
  {
   return (BS("Der Boden ist ziemlich schmutzig. " 
	      "Er sollte wirklich einmal gefegt werden."));
  }
}

