inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../carolina.h"

int anz_kirsche = 3;
int anz_marille = 2;

void reset()
{
  ::reset();
  anz_kirsche = 3;
  anz_marille = 2;
}


void create()
{
  ::create();
  anz_kirsche = 3;
  anz_marille = 2;
  SetProp(P_INT_SHORT, "In einem kleinen Garten");
  SetProp(P_INT_LONG, 
    "Huch?! Was ist denn das? Zwischen zwei Obstbaeumen ist eine "
    "tuerkise Haengematte mit lila Punkten gespannt. Sie wirkt so "
    "einladend, dass Du sofort Lust bekommst, Dich hineinzulegen. "
    "An den Obstbaeumen selbst kannst Du orange und rote Fruechte erkennen. "
    "Rund um Dich herum waechst Gras, nur entlang der Hausmauer im Osten "
    "kannst Du auch etwas Helles in der Wiese wachsen sehen. ");
    
 
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_PLAIN]) );
  AddExit( "suedosten", ROOM "garten_b1" );
  AddExit( "norden", ROOM "garten_a3" );


  AddDetail( ({ "fruechte" }),
    "Sie sehen sehr sehr lecker aus!! Auf dem einen Baum wachsen orange, "
    "auf dem anderen rote Fruechte. ");

  AddDetail( ({ "kirschen" }),
    "Die Kirschen haengen weit oben auf dem Baum und leuchten Dich rot "
    "an. Sie schmecken sicher wunderbar!!");

  AddDetail( ({ "baum", "obstbaum" }),
    "Welchen Baum meinst Du denn?");

  AddDetail( ({ "kirschbaum", "kirschenbaum" }),
    "Der Kirschenbaum ist ziemlich hoch und traegt neben vielen "
    "Blaettern auch einige reife Kirschen. Sie schmecken bestimmt "
    "schon sehr suess!");

  AddDetail( ({ "blaetter" }),
    "Die Baeume haben viele gruene Blaetter.");

  AddDetail( ({ "baeume", "obstbaeume" }),
    "Zwei Obstbaeume wachsen hier. Zwischen ihnen wurde eine Haengematte "
    "gespannt. ");
 
  AddDetail( ({ "marillenbaum" }),
    "Der Marillenbaum erscheint Dir auf den ersten Blick etwas "
    "verkrueppelt gewachsen, aber schlau wie Du bist, weisst Du, dass "
    "Marillenbaeume ja generell immer etwas komisch wachsen. Einige "
    "Marillen haengen auf seinen Aesten. Ob man sie pfluecken kann?");

  AddDetail( ({ "marillenbaeume" }),
    "Du siehst hier nur einen Marillenbaum.");

  AddDetail( ({ "marille", "marillen" }),
    "Mjamm... lecker!");

  AddDetail( ({ "blick" }),
    "Du hast natuerlich einen absolut phantastischen Blick fuer "
    "so etwas.");

  AddDetail( ({ "hausmauer", "haus", "mauer" }),
    "Im Osten ist die Hausmauer, entlang derselben siehst Du helle "
    "Koepfe aus der Wiese spriessen.");

  AddDetail( ({ "koepfe", "helle koepfe" }),
    "Die hellen Koepfe gehoeren zu ein paar Wiesenchampignons, die sich hier "
    "angesiedelt haben. ");

  AddDetail( ({ "wiesenchampignons", "champignons" }),
    "Die Champignons haben helle Koepfe, die Du entlang der Hausmauer aus "
    "der Wiese spriessen siehst. Ob sie geniessbar sind? ");

  AddDetail( ({ "haengematte", "matte" }),
    "Eine Haengematte wurde mitten zwei Obstbaeumen gespannt. Sie ist "
    "tuerkis und hat lila Punkte - wirklich sehr sehr huebsch diese "
    "Farbkombination. ");

  AddDetail( ({ "farbkombination" }),
    "Du koenntest Dir nichts schoeneres vorstellen, als tuerkiser "
    "Untergrund mit lila Punkten. ");

  AddDetail( ({ "punkte", "punkt" }),
    "Lila Punkte zieren den tuerkisen Untergrund der Haengematte. Wirklich "
    "ausgesprochen huebsch!");

  AddDetail( ({ "untergrund" }),
    "Die Haengematte ist tuerkis und hat lila Punkte.");

  AddDetail( ({ "lust" }),
    "So eine Haengematte ist doch etwas Nettes! Da bekommt man richtig "
    "Lust sich hineinzulegen. ");

  AddDetail( ({ "nettes" }),
    "Haengematten sind einfach was Tolles!");

  AddDetail( ({ "tolles" }),
    "Sie sind so toll, dass es hier keine Moeglichkeit gibt mehr Details "
    "zu untersuchen. ");

  AddDetail( ({ "details", "moeglichkeit" }),
    "Denk Dir einfach den Rest.");

  AddDetail( ({ "rest" }),
    "Du denkst . o O (REST!)");

  AddDetail( ({ "helles" }),
    "Im Osten blinzelt entlang der Hausmauer etwas Helles aus der Wiese " 
    "hevor. Du bist Dir ganz sicher, dass es sich dabei um kleine Schwammerl "
    "handelt. ");

  AddDetail( ({ "schwammerl" }),
    "Sicherlich ganz normale Wiesenchampignons.");

  AddDetail( ({ "etwas" }),
    "Welches Etwas?");

  AddDetail( ({ "boden" }),
    "Mit dem Boden meinst Du sicherlich die Wiese, oder?!");

  AddDetail( ({ "himmel" }),
    "Der ist ueber Dir :) Natuerlich ist er blau - wie sollte es auch "
    "anders sein - sonst wuerde es vermutlich ja regnen und nicht so "
    "sonnig sein. "); 

  AddDetail( ({ "wiese" }),
    "In der Wiese waechst natuerlich in erster Linie Gras, aber auch ein paar "
    "Champignons kannst Du im Osten ausmachen. Auf einem Grashalm siehst "
    "Du etwas Seltsames sitzen. ");

  AddDetail( ({ "seltsames" }),
    "Es handelt sich um einen gruen schillernden Kaefer, auch unter dem "
    "Namen Junikaefer, oder Rosenkaefer bekannt. Vermutlich rastet sich "
    "der Kaefer nur etwas aus, bevor er wieder zu einem Rundflug "
    "startet. ");

  AddDetail( ({ "rundflug", "flug" }),
    "Der Kaefer rastet sich vermutlich nur etwas aus, bevor er wieder herum "
    "fliegt. ");

  AddDetail( ({ "kaefer" }),
    "Der Kaefer schillert gruen metallisch und Du bist Dir sicher dass es "
    "sich um einen Junikaefer handelt. ");

  AddDetail( ({ "junikaefer", "rosenkaefer" }),
    "Der Rosenkaefer, oder auch Junikaefer genannt hat seinen Namen, da "
    "man ihn haeufig bei Heckenrosen antrifft. Er hat einen gruen metallisch "
    "schimmernden Ruecken und eine rostrote Unterseite. ");

  AddDetail( ({ "unterseite" }),
    "Die ist rostrot.");

  AddDetail( ({ "ruecken" }),
    "Der Ruecken schimmert metallisch gruen. ");

  AddDetail( ({ "linie" }),
    "Wo siehst Du eine Linie? Also ich seh keine!");

  AddDetail( ({ "heckenrosen", "heckenrose", "rose", "rosen" }),
    "Hier waechst keine Heckenrose, vermutlich ruht sich der Kaefer nur "
    "etwas in der Sonne aus um weiterzufliegen.");

  AddDetail( ({ "sonne" }),
    "Die Sonne ist am Himmel und scheint - na no na !");

  AddDetail( ({ "name" }),
    "Der Rosenkaefer hat seinen Namen von der Rose.");

  AddDetail( ({ "gras" }),
    "Auf dem Gras geht man fast wie auf Wolken. Einen schoenen Garten "
    "hat Wassertroepfchen hier!");

  AddDetail( ({ "wolken" }),
    "Am Himmel sind keine, aber Du hast das Gefuehl auf dem Gras wie auf "
    "Wolken zu wandeln.");

  AddDetail( ({ "garten" }),
    "Hier ists sehr gemuetlich! Der ideale Platz zum Entspannen!");

  AddDetail( ({ "platz", "entspannen" }),
    "Vielleicht legst Du Dich einfach mal in die Haengematte und haeltst "
    "ein Nickerchen.");

  AddDetail( ({ "nickerchen" }),
    "Kann ja nicht schaden!");

  AddDetail( ({ "wassertroepfchen" }),
    "Sie liegt sicherlich oft in der Haengematte, ruht sich aus, und "
    "beobachtet ihren schoenen Garten.");

  AddDetail( ({ "grashalm" }),
    "Auf einem Grashalm sitzt ein Tier!");

  AddDetail( ({ "tier" }),
    "Was das wohl fuer eines ist?!");

  AddDetail( ({ "ast", "aeste", "zweige", "zweig" }),
    "Vor lauter Blaettern kann man die Aeste und Zweige gar nicht sehen."); 

  AddDetail( ({ "gefuehl" }),
    "Einfach himmlisch!");


// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Aus der Ferne hoerst Du einige Grillen zirpen. Vermutlich verstecken "
    "sie sich irgendwo im Gras.");

  AddSound( ({ "gras" }),
    "Irgendwie weiter weg sitzen im Gras ein paar Grillen - zumindest hoerst "
    "Du ein Zirpen.");

  AddSound( ({ "zirpen" }),
    "*zirp* *zirp*");

  AddSound( ({ "ferne" }),
    "Aus der Ferne hoerst Du einige Grillen zirpen.");

  AddSound( ({ "grillen" }),
    "Die Grillen zirpen irgendwo in der Ferne *zzzzrp*.");
   
  AddDetail( ({ "grillen" }),
    "Sehen kannst Du keine! Nur hoeren!");

// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Hier duftet es nach reifen Kirschen und Marillen!!! Dir laeuft "
    "das Wasser im Mund zusammen!");

  AddSmell( ({ "kirschen", "marillen", "kirsche", "marille" }),
    "Boah, duftet das herrlich! Du bekommst total Appetit auf Essen!");
    
  AddSmell( ({ "appetit", "wasser", "mund" }),
    "Das kann man nicht riechen!");

  AddSmell( ({ "essen" }),
    "Es riecht nach Marillen und Kirschen!");

  AddCmd( ({ "leg", "lieg", "lege", "liege" }), "c_legen");
  AddCmd( ({ "geniess", "geniesse" }), "c_geniessen");
  AddCmd( ({ "kost", "koste", "probier", "probiere" }), "c_kosten");
  AddCmd( ({ "pflueck", "pfluecke" }), "c_pfluecken");


}

int c_geniessen(string str)
{
 if(str != "wiesenchampignons"   &&
    str != "champignons")
 {
  notify_fail("Was moechtest Du hier geniessen?\n");
  return 0;
 }
 else
 {
  write(BS("Wenn Du mutig genug bist, kannst Du einen kosten."));
  return 1;
 }
}

int c_kosten(string str)
{
 if(str != "wiesenchampignon"  &&
    str != "champignon" )
 {
  notify_fail("Was moechtest Du kosten?\n");
  return 0;
 }
 else
 {
  write(BS("Du kostet ein Stueckerl eines Wiesenchampignon... PFUI!!!! "
           "Irgendwie schmeckt das so ueberhaupt nicht lecker!"));
  say(CTPN + " kostet einen Champignon.\n");
  TP->do_damage(3);
  return 1; 
 }
}



int c_legen(string str)
{
 if(str != "in haengematte" )
 {
  notify_fail("Wohin moechtest Du Dich legen?\n");
  return 0;
 }
 else
 {
  write(BS("Du legst Dich in die Haengematte, und wirst auf einmal sehr sehr "
           "muede... und schlaefst ein."));
  say(CTPN + " wird sehr muede und schlaeft ein.\n");
  TP->command_me("schlaf ein");
  say(CTPN + " plumpst aus der Haengematte.\n");
  return 1;
 }
}


int c_pfluecken(string str)
{
 mixed ob;
 object ma;
 if( str != "kirschen"    &&
     str != "marillen"    &&
     str != "marille"     &&
     str != "kirsche"      )
 {
  notify_fail("Was moechtest Du pfluecken?\n");
  return 0;
 }
 else
 {
  if( str == "kirsche"  ||  str == "kirschen")
  {

   if(anz_kirsche < 1)
   {
    write(BS("Momentan haengt leider keine der Kirschen in Reichweite :("));
    return 1;
   }
   else
   {
    write(BS("Du pflueckst Dir eine dunkelrote Kirsche vom Baum. "));
    say(CTPN+ " pflueckt sich eine Kirsche vom Baum.\n");
    ob=clone_object(OBJ "kirsche");
    if(ob->move(TP, M_GET) != 1)
    {
     tell_object(TP, "Die kleine Kirsche ist viel zu schwer fuer Dich! "
                     "Seicherl!\n");
     ob->move(TO, M_NOCHECK);
    }
    anz_kirsche--;  
    return 1;
    }
   }
  if( str == "marille" || str == "marillen")
  {
   if(anz_marille < 1)
   {
    write(BS("Leider kannst Du momentan keine Marille erreichen. Sie haengen "
             "alle viel zu hoch oben!"));
    return 1;
   }
   else
   {
    write(BS("Du pflueckst Dir eine orange Marille vom Baum. Sie schmeckt "
             "sicher koestlich!"));
    say(CTPN+ " pflueckt eine Marille.\n");
    ma=clone_object(OBJ "marille");
    if(ma->move(TP, M_GET) != 1)
    {
     tell_object(TP, "Du kannst die Marille nicht mehr tragen.\n");
     ma->move(TO, M_NOCHECK);
    }
    anz_marille--;
    return 1;
   }
  }
 }
}
 
