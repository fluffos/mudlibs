inherit "std/room";

#include <properties.h>
#include <language.h>
#include <room/doors.h>
#include "../carolina.h"
#include <moving.h>

int anz_edelstein;
int anz_erdbeeren;

void reset()
{
 ::reset();
 anz_edelstein = 1;
 anz_erdbeeren = 1;
}

void create()
{
  ::create();

  anz_edelstein = 1;
  anz_erdbeeren = 1;
  SetProp(P_INT_SHORT, "In einem kleinen Garten");
  SetProp(P_INT_LONG,
     "Du findest Dich in einem kleinen Garten wieder. "
     "Ueber Dir befindet sich ein "
     "Torbogen, an dem sich rote Rosen hochranken. Im Norden kannst Du "
     "bereits ein kleines Haeuschen erkennen. Rechts und links von "
     "Dir bluehen viele verschiedene Blumen, deren Duft Dir in die "
     "Nase steigt. Der Boden ist mit kleinen Kieselsteinchen bedeckt, die "
     "bei jedem Deiner Schritte leise knirschen. "
     "Vom Himmel strahlt die Sonne auf Dich herab, und gibt Dir "
     "ein Gefuehl der Waerme. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_PLAIN]) );
  SetProp(P_INDOORS, 0);

  AddExit( "norden", ROOM "garten_c1" );
  AddExit( "sueden", WEG "weg6" ); 

  AddItem(NPC "marienkaefer", REFRESH_DESTRUCT);

  NewDoor( "sueden", WEG "weg6", ({ "tor", "gartentor" }),
     ({ DOOR_CLOSED,
        DOOR_RESET_CL,
        D_NAME, "Gartentor",
        D_GENDER, NEUTER,
        D_SHORT, "Im Sueden befindet sich ein %ses Gartentor. ",
        D_LONG, "Ein gruen bemaltes Gartentor befindet sich im Sueden. "
                "Es laesst sich sicherlich leicht oeffnen und schliessen. ",
   //     D_MSGS, ({ "nach Sueden", "geht", "kommt durch das Gartentor" }),
        D_OPENMSG, ({ "Du oeffnest das Gartentor. ",
                      "%s oeffnet das Gartentor. ",
                      " wird geoeffnet. " }),
        D_CLOSEMSG, ({ "Du schliesst das Gartentor sorgfaeltig. ",
                       "%s schliesst sorgfaeltig das Gartentor. ",
                       " wird geschlossen. " }),
        D_RESET_CLOSEMSG, " wird durch einen Windstoss geschlossen. " }) );


  AddDetail( ({ "torbogen" }),
     "Ein runder Bogen aus Holz wurde hier angebracht. Um ihn schlingen "
     "sich rote Rosen. Pass auf, dass Du Dich nicht stichst an ihren Dornen! ");

  AddDetail( ({ "bogen" }),
     "Der Bogen besteht ausschliesslich aus Holz. So ein Holz findest "
     "Du bestimmt nirgends sonstwo im Silberland. ");

  AddDetail( ({ "holz" }),
     "Kleine Edelsteine wurden in das Holz eingefasst, und erzeugen "
     "ein tolles Schimmern. ");

  AddDetail( ({ "schimmern" }),
     "Wie ein Regenbogen strahlt der Torbogen im Sonnenlicht. ");

  AddDetail( ({ "edelsteine", "edelstein" }),
     "Du koenntest ja einmal probieren einen Edelstein herauszuloesen. ");

  AddDetail( ({ "rosen" }),
     "Rote Rosen ranken sich an dem Torbogen hinauf. Ein betoerender Duft "
     "geht von ihnen aus. ");

  AddDetail( ({ "duft" }),
     "Probier es doch einmal mit: riechen! ");

  AddDetail( ({ "silberland" }),
     "Du befindest Dich im Silberland. ");

  AddDetail( ({ "kieselsteine", "kiesel", "steine", "kieselsteinchen",
                "steinchen" }),
     "Kleine Kieselsteine bilden einen Weg der nach Norden fuehrt. Bei "
     "jedem Deiner Schritte knirschen sie leise unter Deinen Fuessen. ");

  AddDetail( ({ "schritte" }),
     "*knirsch* *knirsch* ");

  AddDetail( ({ "fuesse", "fuessen" }),
     "Vorsichtig machst Du einen Schritt nach vorne - *knirsch* ");

  AddDetail( ({ "weg" }),
     "Der Weg fuehrt nach Norden zu einem kleinen Haeuschen. ");

  AddDetail( ({ "norden" }),
     "Geh doch einfach nach Norden wenn Du sehen moechtest, was "
     "sich dort befindet. ");
 
  AddDetail( ({ "haeuschen" }),
     "Du musst schon naeher rangehen, damit Du das Haeuschen untersuchen "
     "kannst. ");

  AddDetail( ({ "gefuehl" }),
     "Ein warmes angenehmes Gefuehl umgibt Dich. ");

  AddDetail( ({ "sonne" }),
     "Hoch am Himmel steht die Sonne und schickt ihre Strahlen aus. ");

  AddDetail( ({ "sonnenstrahlen", "strahlen" }),
     "Ganz warm fuehlt sich Deine Haut an. ");

  AddDetail( ({ "haut" }),
     "Ein bisschen Sonne schadet Deiner Haut sicher nicht. ");
 
  AddDetail( ({ "sonnenlicht", "licht" }),
     "Die Sonne waermt Dich mit ihren Strahlen. ");

  AddDetail( ({ "regenbogen" }),
     "Die Edelsteine glitzern im Sonnenlicht in allen moeglichen "
     "Farben. ");

  AddDetail( ({ "farben" }),
     "Rot, blau, gruen, gelb, violett, rosa, orange, tuerkis, ... ");

  AddDetail( ({ "rot" }),
     "Rot wie eine Mohnblume. ");

  AddDetail( ({ "blau" }),
     "Blau wie eine Glockenblume. ");

  AddDetail( ({ "gelb" }),
     "Gelb wie Sonnenblumen. ");

  AddDetail( ({ "violett" }),
     "Violett wie ein strahlender Amethyst. ");

  AddDetail( ({ "orange" }),
     "Orange wie ein Kuerbis. ");

  AddDetail( ({ "rosa" }),
     "Rosa wie die Blueten eines Kirschenbaums. ");

  AddDetail( ({ "tuerkis" }),
     "Tuerkis wie eine kleine Raupe. ");

  AddDetail( ({ "gruen" }),
     "Gruen wie ein saftiger Apfel. ");

  AddDetail( ({ "raupe", "apfel", "mohnblume", "sonnenblumen", "kirschbaum",
                "amethyst", "glockenblume", "kuerbis" }),
     "Blick Dich doch einfach mal ganz genau im Garten um. ");

  AddDetail( ({ "garten" }),
     "Ein kleiner Garten breitet sich vor Dir aus. ");

  AddDetail( ({ "dornen" }),
     "Du solltest gut aufpassen, denn die Rosen haben spitze Dornen. ");

  AddDetail( ({ "schritt" }),
     "Die Steinchen knirschen unter Deinen Fuessen. ");

  AddDetail( ({ "boden" }),
     "Der Boden ist mit Kieselsteinchen bedeckt und verleiht "
     "eine ganz besondere Atmosphaere. ");

  AddDetail( ({ "atmosphaere" }),
     "Einfach wunderbar! ");

  AddDetail( ({ "nase" }),
     "Es riecht hier einfach fantastisch. ");

  AddDetail( ({ "waerme" }),
     "Die Sonne gibt Dir ein schoenes Gefuehl der Waerme, wenn sie "
     "Dir ihre Strahlen schickt. ");

  AddDetail( ({ "blumen" }),
     "Soviele Blumen hast Du kaum woanders schon einmal gesehen. "
     "Alles um Dich herum blueht. Jemand scheint diesen Garten "
     "sehr lieb zu haben und zu pflegen. ");

  AddDetail( ({ "jemand" }),
     "Dieser Jemand wird wohl Wassertroepfchen sein. Die kleine "
     "Wasserelfe ist die Besitzerin dieses Gartens. ");

  AddDetail( ({ "besitzerin" }),
     "Wassertroepfchen kuemmert sich wohl sehr liebevoll um diesen "
     "Garten. ");

  AddDetail( ({ "wassertroepfchen" }),
     "Sie ist wohl gerade nicht hier. Vielleicht findest Du sie allerdings "
     "in dem kleinen Haeuschen. ");

  AddDetail( ({ "wasserelfe", "wasserelfen" }),
     "Wasserelfen halten sich normalerweise immer in der Naehe von "
     "Teichen oder Gewaessern auf. ");

  AddDetail( ({ "teiche", "gewaesser" }),
     "Vielleicht findest Du einen in der Naehe. ");

  AddDetail( ({ "naehe" }),
     "Kuck Dich einfach genauer hier um. ");

  AddDetail( ({ "himmel" }),
     "Hell leuchtet Dir die Sonne entgegen. Pass lieber auf, dass Du "
     "nicht solange hinaufschaust, denn das tut Deinen Augen sicherlich "
     "nicht so gut. ");

  AddDetail( ({ "augen" }),
     "Du blinzelst. ");
  
  AddDetail( ({ "erdbeeren", "erdbeere" }),
     "Siehst Du denn eine? ");

  AddSmell(DEFAULT_SMELL,
     "Hmmm. Der Duft eines Bluetenmeers stroemt Dir entgegen. Soviele "
     "Blumen auf einmal gibt es wohl sonst nirgends im ganzen Silberland. ");
     
  AddSmell( ({ "bluetenmeer" }),
     "Die einzelnen Blumenarten kannst Du leider nicht herausriechen. "
     "Es sind wohl viel zu viele. ");

  AddSmell( ({ "meer" }),
     "Es riecht hier nirgends nach Meer. ");

  AddSmell( ({ "blumenarten", "arten" }),
     "Einfach herrlich. Einen stechend suessen Geruch nimmst Du ganz "
     "deutlich wahr. ");

  AddSmell( ({ "geruch" }),
     "Er wird wohl von den Rosen kommen. ");

  AddSmell( ({ "rosen" }),
     "Die Rosen duften einfach wunderbar. Eine Rose riecht allerdings etwas "
     "nach Erdbeeren?! ");

  AddSmell( ({ "rose" }),
     "Du schnupperst an der Rose. Tatsaechlich diese eine hier riecht nach "
     "Erdbeeren. Jetzt erst bemerkst Du, dass hier wohl jemand eine "
     "Erdbeere hineingelegt hat. Seltsam. Vielleicht koenntest Du ja einmal "
     "versuchen Dir diese Erdbeere herauszuangeln. ");

  AddSmell( ({ "erdbeeren", "erdbeere" }),
     "Irgendwas riecht hier nach Erdbeeren. ");

  AddSmell( ({ "blumen" }),
     "Die Blumen duften herrlich. ");

  AddSmell( ({ "silberland" }),
     "Das ganze Silberland kannst Du von hieraus nicht riechen. ");

  AddSmell( ({ "duft" }),
     "Es riecht wie in 1001 Nacht. ");

  AddSmell( ({ "nacht" }),
     "Das muss man selbst erleben. ");
 
  AddSound(DEFAULT_SOUND,
     "Das Gezwitscher von Voegeln dringt von irgendwoher. ");

  AddSound( ({ "voegel" }),
     "Leider kannst Du nicht genau erlauschen aus welcher Richtung "
     "das Zwitschern kommt. ");

  AddSound( ({ "zwitschern" }),
     "*fiep* *fiep*");

  AddSound( ({ "richtung"}),
     "Meinst Du, dass das einen Sinn ergibt? ");

  AddSound( ({ "sinn" }),
     "Du versuchst verzweifelt den Sinn heraus zu hoeren, scheiterst aber. ");
     
  AddSound( ({ "gezwitscher" }),
     "*tralallala*");


  AddCmd( ({ "loese", "loes" }), "c_loesen" );  
  AddCmd( ({ "angel", "angle", "angele", "angl" }), "c_angeln" );


 
}

int c_loesen( string str )
{
 if( str != "edelstein aus bogen heraus" &&
     str != "edelstein aus torbogen heraus" && 
     str != "edelstein aus holz heraus" )
 {
  notify_fail("Was moechtest Du wo herausloesen?\n");
  return 0;
 }
 
  if( anz_edelstein < 1 )
  {
   write(BS("Du versuchst einen Edelstein aus dem Holz zu loesen, "
            "doch leider sitzen alle zu fest. Versuch es doch spaeter "
            "noch einmal.\n"));
   return 1;
  }
  
   write(BS("Vorsichtig blickst Du Dich um, um sicher zu gehen dass "
           "Dich niemand beobachtet. Langsam beginnst Du einen Edelstein "
           "aus dem Holz herauszuloesen. Schnell steckst Du ihn danach ein.\n"));
  ("/obj/gemmaster"->DistributeGem(1, 0, 0, this_player(),
                                ({ "amethyst" }) ));
  anz_edelstein--;
  return 1;
}


int c_angeln( string str )
{
 object ob;
 if( str != "erdbeere aus rose heraus"   &&
     str != "erdbeere aus rose raus"     &&
     str != "erdbeere aus rose"          )
 {
  notify_fail("Was moechtest Du wo herausangeln?\n"); 
  return 0;
 }
 
  if( anz_erdbeeren < 1 )
  {
   write(BS("Du versuchst die Erdbeere aus der Rose herauszuangeln, "
            "aber jedesmal, wenn Du glaubst sie erwischt zu haben, "
            "entgleitet sie Dir wieder. "));
   return 1;
  }
  
   write(BS("Du versuchst mit aller Muehe Dir die Erdbeere zu angeln. "
            "Auf einmal kriegst Du sie zu fassen und steckst sie rasch "
            "ein. "));
   say(CTPN+ " strahlt ploetzlich zufrieden.\n");
   ob = clone_object( "/d/kristallwald/sargola/lichtung/obj/erdbeere");
   if(ob->move(this_player(), M_GET) != 1)
   {
    tell_object(this_player(), "Das kannst Du nicht mehr tragen!\n");
    ob->move(this_object(), M_NOCHECK);
   }
    anz_erdbeeren--;
    return 1;
 }


 

