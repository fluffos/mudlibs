inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../carolina.h"

int anz_efeu;

void reset()
{
 ::reset();
 anz_efeu = 2;
}

void create()
{
  ::create();
  anz_efeu = 2;
  SetProp(P_INT_SHORT, "In einem kleinen Garten");
  SetProp(P_INT_LONG, 
    "Ach! Wie herrlich es hier doch ist! Die Sonne strahlt vom Himmel, "
    "die Blumen bluehen, und Du fuehlst Dich rundherum einfach wohl. "
    "Noerdlich von Dir waechst ein grosser Baum, unter dessen "
    "schattenspendender Krone ein kleines Baenkchen steht. Der ideale "
    "Ort um der Natur und ihren Bewohnern etwas zuzusehen. An der "
    "Hauswand im Westen rankt sich wilder Wein hoch. An seinen Reben "
    "haengen sogar noch einige Trauben. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_PLAIN]) );
  AddExit( "sueden", ROOM "garten_e2" );
  AddExit( "nordwesten", ROOM "garten_d4" );
  AddExit( "norden", ROOM "linde");

  SetProp(P_HIDE_EXITS, ({ "norden" }) );

// DETAILBEGINN 

  AddDetail( ({ "garten" }),
    "Du stehst mitten drinnen!");

  AddDetail( ({ "hauswand", "wand" }),
    "An der gemauerten Hauswand rankt wilder Wein, und auch etwas Efeu "
    "kann man erkennen.");

  AddDetail( ({ "efeu" }),
    "Neben dem wilden Wein siehst Du auch einige Efeuranken, die sich ihren "
    "Weg nach oben bahnen.");

  AddDetail( ({ "ranken" }),
    "Sie wachsen an der gemauerten Hauswand hoch.");

  AddDetail( ({ "mauer" }),
    "Die Mauer ist aus alten Ziegelsteinen gefertig worden - sicherlich war "
    "das ein ganz schoenes Stueck Arbeit! Bezahlt gemacht hat es sich aber "
    "auf alle Faelle - sieht wirklich fantastisch aus!");

  AddDetail( ({ "ziegelsteine", "ziegel" }),
    "Die Ziegel wurden sorgfaeltig aufeinander geschlichtet und mit Moertel "
    "fixiert.");

  AddDetail( ({ "putz" }),
    "Die Waende sind nicht verputzt.");

  AddDetail( ({ "moertel" }),
    "Der Moertel befindet sich zwischen den Ziegel und gewaehrleistet, dass "
    "das Haus nicht sofort wieder auseinanderbricht. Mittlerweile sind die "
    "Fugen schon recht dunkel geworden ");

  AddDetail( ({ "fugen", "fuge" }),
    "Sie haben schon eine dunkelgraue Farbe.");

  AddDetail( ({ "farbe" }),
    "Welche meinst Du?");

  AddDetail( ({ "dunkelgrau", "grau" }),
    "Das Dunkelgrau passt gut zu den zinoberroten Ziegelsteinen. Als ob der "
    "Erbauer Ahnung von Feng Shui gehabt haette...");

  AddDetail( ({ "erbauer" }),
    "Ob er irgendwo seine Initialen hinterlassen hat?");

  AddDetail( ({ "initialen" }),
    "Hier findest Du keine... vielleicht aber woanders?"); 

  AddSpecialDetail( ({ "feng shui" }), "fengfunc");

  AddDetail( ({ "steine" }),
    "Welche Steine meinst Du?");

  AddDetail( ({ "efeuranken", "ranken" }),
    "Schoene dichte Ranken wachsen neben dem Wein an der Hauswand hoch. "
    "Du kannst auch einige noch ganz gruene Efeublaetter erkennen.");

  AddDetail( ({ "efeublaetter" }),
    "Du siehst an den Ranken auch einige noch helle Efeublaetter.");

  AddDetail( ({ "blaetter" }),
    "Welche Blaetter meinst Du?");
 
  AddDetail( ({ "wein", "weinranken" }),
    "Wilder Wein rankt sich neben dem Efeu an der Hauswand nach oben. Einige "
    "Trauben haengen sogar noch dran... ob sie gut schmecken?");

  AddDetail( ({ "trauben", "traube" }),
    "Du kannst einige Trauben an den Weinranken erkennen.");

  AddDetail( ({ "ort" }),
    "Unter dem Baum steht ein Baenkchen. Sicher der ideale Ort um sich "
    "etwas auszuruhen und die Natur zu beobachten.");

  AddDetail( ({ "natur" }),
    "Du bist mitten drinnen!");

  AddDetail( ({ "bewohner", "tiere" }),
    "Ameisen, Bienen, Kaefer, Schmetterlinge, ... alle moeglichen Tiere "
    "leben hier. Man muss nur genau hinsehen.");

  AddDetail( ({ "ameisen", "bienen", "kaefer", "schmetterlinge" }),
    "Sieh Dich doch einfach genauer um!");

  AddDetail( ({ "himmel" }),
    "Der Himmel ist hier (wie sollte es auch anders sein) natuerlich "
    "strahlend blau. Die Sonne bildet einen runden leuchtenden gelben "
    "Punkt an ihm.");

  AddDetail( ({ "sonne" }),
    "Die Sonne sieht von hier unten rund, leuchtend und gelb aus :) Wie ein "
    "grosser Punkt.");
 
  AddDetail( ({ "punkt" }),
    "Gibt doch zu, dass Du die Aehnlichkeit zwischen einem Punkt und der "
    "Sonne erkennst.");

  AddDetail( ({ "aehnlichkeit" }),
    "Du nickst.");

  AddDetail( ({ "boden", "gras" }),
    "Du spuerst das warme Gras unter Deinen Fuessen. Zwischendrinnen wachsen "
    "auch hier wieder die verschiedensten Blumen.");

  AddDetail( ({ "fuesse" }),
    "Deine Fuesse sind unter Dir. Waere ja auch seltsam, wenn dem nicht so "
    "waere - oder?");

  AddDetail( ({ "blumen", "bluemchen" }),
    "Hier wachsen vorallem Gaensebluemchen. ");

  AddDetail( ({ "gaensebluemchen" }),
    "Gaensebluemchen gehoeren zu den schoensten Blumen der Welt! Sie sind "
    "klein, weiss und in der Mitte gelb! Sie schmecken auch sehr lecker - "
    "vorallem im Salat.");

  AddDetail( ({ "salat", "gaensebluemchensalat" }),
    "Gerade hast Du nicht so besonders Lust auf einen Gaensebluemchensalat. "
    "Vielleicht spaeter mal irgendwann. ");

  AddDetail( ({ "lust" }),
    "Momentan ist keine vorhanden.");

  AddDetail( ({ "mitte" }),
    "Gaensebluemchen sind in der Mitte gelb und haben weisse Bluetenblaetter.");

  AddDetail( ({ "bluetenblaetter" }),
    "Die sind bei Gaensebluemchen weiss - das solltest Du aber schon wissen!");

  AddDetail( ({ "welt" }),
    "Sie sind wirklich die schoensten Blumen weit und breit!");

  AddDetail( ({ "reben", "weinreben" }),
    "Einige Trauben haengen an den Weinreben.");

  AddDetail( ({ "baenkchen", "bank" }),
    "Ein kleines Baenkchen steht noerdlich unter dem grossen Baum. Schau "
    "doch mal hin!");

  AddDetail( ({ "krone" }),
    "Die Krone des Baumes spendet ziemlich viel Schatten. Sicherlich ist "
    "es sehr angenehm, wenn man sich einfach auf das Baenkchen setzt und "
    "etwas ausruht. Heute ist ja wirklich ein heisser Tag!");

  AddDetail( ({ "tag" }),
    "Es ist ein schoener Tag, wenn auch ziemlich heiss.");

  AddDetail( ({ "schatten" }),
    "Die Krone des Baumes spendet viel Schatten. Wenn Du moechtest kannst "
    "Du Dich unter sie auf das Baenkchen setzen - sofern Du hinkommst.");

  AddDetail( ({ "baum" }),
    "Bei dem Baum scheint es sich um eine Linde zu handeln. Sie waechst "
    "noerdlich von Dir... aber wie kommt man dort hin?");

  AddDetail( ({ "linde" }),
    "Kuck sie Dir doch einmal aus der Naehe an!");

  AddDetail( ({ "naehe" }),
    "Geh einfach hin!");


// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Es duftet nach den schoensten Blumen der Welt.");

  AddSmell( ({ "blumen", "gaensebluemchen", "bluemchen" }),
    "Die Gaensebluemchen riechen einfach herrlich und zum Glueck nicht "
    "so aufdringlich wie andere Blumen!");


// SOUNDS

  AddSound(DEFAULT_SOUND,
    "*summ* *summ* *zwitscher* *raschel*");

  AddSound( ({ "summen" }),
    "SUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUMM");

  AddSound( ({ "zwitschern", "voegel" }),
    "*piep* *piep* *piep*");

  AddSound( ({ "rascheln" }),
    "*krkkkkkschh*");




  AddCmd( ({ "reiss", "reisse" }), "c_reissen");
  AddCmd( ({ "pflueck", "pfluecke" }), "c_pfluecken");


}


string fengfunc(string str)
{
 return(BS("Du als "+TP->QueryProp(P_RACE)+", hast ja nicht den geringsten "
            "Plan von soetwas!"));
}


int c_reissen(string str)
{
 object ob;
 if( str != "efeublaetter ab" &&
     str != "efeublatt ab"    &&
     str != "helles efeublatt ab" &&
     str != "helle efeublaetter ab" &&
     str != "efeu ab" &&
     str != "efeuranke ab" )
 {
  notify_fail("Was moechtest Du abreissen?\n");
  return 0;
 }
 if( str == "efeu ab" && "efeuranke ab")
 {
  write(BS("Was willst Du denn mit einer ganzen Efeuranke????"));
  return 1;
 }
 else
 {
  if(anz_efeu < 1)
  {
   write(BS("Leider sind die hellen Efeublaetter alle so hoch oben. Du "
            "kommst einfach nicht ran."));
   return 1;
  }
  else
  {
   write(BS("Du stellst Dich auf Deine Zehenspitzen und reisst Dir ein "
            "schoenes helles Efeublatt ab."));
   say(CTPN + " stellt sich auf die Zehenspitzen.\n");
   ob = clone_object(OBJ "efeu");
   if(ob->move(TP, M_GET) != 1)
   {
    tell_object(TP, "Das kleine Efeublatt ist viel zu schwer fuer Dich!\n");
    ob->move(TO, M_NOCHECK);
   }
   anz_efeu--;
   return 1;
  }
 }
}

int c_pfluecken(string str)
{
 if( str != "trauben" &&
     str != "traube" )
 {
  notify_fail("Was moechtest Du pfluecken?\n");
  return 0;
 }
 else
 { 
  write(BS("Leider haengen alle Trauben ausserhalb Deiner Reichweite :("));
  return 1;
 }
}

          
