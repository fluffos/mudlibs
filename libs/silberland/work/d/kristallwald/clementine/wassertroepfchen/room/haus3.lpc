  AddReadDetail( ({ "neuntes buch", "buch neun", "buch 9" }),
    "Das Buch ist viel zu schwer um es ueberhaupt aus dem Regal zu bekommen. "
    "Schade!");

  AddDetail( ({ "zehntes buch", "buch 10", "buch zehn" }),
    "+ Moderne Holzverarbeitung - Sawer +");

  AddReadDetail( ({ "zehntes buch", "buch 10", "buch zehn" }),
    "Du blaetterst durch das Holzverarbeitungs Buch, findest aber nur ein "
    "paar seltsame Zeichnungen und stellst es wieder ins Regal.");

  AddDetail( ({ "elftes buch", "buch elf", "buch 11" }),
    "~~ Der Zaubergarten ~~");

  AddReadDetail( ({ "elftes buch", "buch elf", "buch 11" }),
    "In dem Buch findest Du wirklich alles Wissenwertes ueber Pflanzen und den "
    "Garten. Irgendwie interessiert Dich das aber reichlich wenig.");

  AddDetail( ({ "zwoelftes buch", "buch 12", "buch zwoelf" }),
    ".... GeHeImE KoChReZePtE ....");

  AddReadDetail( ({ "zwoelftes buch", "buch 12", "buch zwoelf" }),
    "Das Buch zu Lesen ist Dir noch nicht bestimmt!");

  AddDetail( ({ "dreizehntes buch", "buch dreizehn", "buch 13" }),
    "Beim dreizehnten Buch handelt es sich um ein Fotoalbum. ");

  AddDetail( ({ "fotoalbum" }),
    "Ist ja interessant!");

  AddReadDetail( ({ "fotoalbum", "dreizehntes buch", "buch 13", 
			 "buch dreizehn" }),
    "Du schlaegst das Fotoalbum auf und siehst gleich auf der ersten Seite "
    "Wassertroepfchen mit ihrer Urururoma. ");

  AddDetail( ({ "urururoma" }),
    "Wassertroepfchens Urururoma hat auf dem Foto einen seltsamen Trank "
    "in der einen Hand, und ein seltsames Schriftstueck in der anderen. ");

  AddDetail( ({ "hand" }),
    "Welche Hand?");

  AddDetail( ({ "schriftstueck" }),
    "Auf dem Schriftstueck stehen seltsame Symbole. Ob man sie entziffern "
    "kann?");

  AddDetail( ({ "symbole" }),
    "Entziffer sie doch mal!"); 

  AddDetail( ({ "buch vierzehn", "buch 14", "vierzehntes buch" }),
    "Vegetarische Rezepte von Lamyra");

  AddReadDetail( ({ "buch vierzehn", "buch 14", "vierzehntes buch" }),
    "Du liest:\n"
    "Man nimmt einen Erdaepfel und kocht ihn. Wenn er fertig gekocht ist, "
    "schaelt man ihn ab und kann ihn essen.\n"
    "\n"
    "Du denkst . o O (na sehr ergiebig ist das aber nicht)\n");

  AddDetail( ({ "buch fuenfzehn", "fuenfzehntes buch", "buch 15" }),
    "Das Buch ist schon ganz zerfetzt, aber Du meinst den Schriftzug "
    ">Mein Leben im Nexus< zu sehen - der Autor laesst sich leider nicht mehr "
    "erkennen.");

  AddReadDetail( ({ "buch fuenfzehn", "buch 15", "fuenfzehntes buch" }),
    "Das Buch ist leider schon dermassen abgegriffen, dass Du nichts mehr "
