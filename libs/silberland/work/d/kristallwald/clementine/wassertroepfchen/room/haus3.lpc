  AddDetail( ({ "sechstes buch", "buch 6", "buch sechs" }),
    "..--..Als der Wolf Amnenion verspeiste..--..\n"
    "Na das klingt endlich mal spannend!\n");

  AddReadDetail( ({ " sechstes buch", "buch 6", "buch sechs" }),
    "... Und dann kam der Wolf und frass Amnenion mit einem Haps auf. Ende.");

  AddDetail( ({ "trank" }),
    "Sieht sehr interessant aus!");

  AddDetail( ({ "siebentes buch", "siebtes buch", "buch sieben", "buch 7" }),
    "**..** Lamuertes Ueberlebenstraining **..**");

  AddReadDetail( ({ "siebentes buch", "siebtes buch", "buch sieben", 
                    "buch 7"}),
    "Du liest:\n"
    "\n"
    "Don't eat the yellow snow - Eskimo Lektion 1\n"
    "Irgendwie fad... Du ueberblaetterst einige Seiten und findest dann das:\n"
    "\n"
    "Das Mudalphabet:\n"
    "Angrox angelt Aale\n"
    "Benno braut Bier\n"
    "Crea chiffriert Chipkarten\n"
    "Denti dichtet Dirndlkleider\n"
    "Iwo isst Igel\n"
    "Katrin kackt Kakteen\n"
    "Lamuerte ludelt Lasagne\n"
    "Murtek brtscht\n"
    "Protheg pisst Palmen\n");

  AddDetail( ({ "achtes buch", "buch 8", "buch acht" }),
    "--~~ Sprichworte aus allen Landen ~~--");

  AddReadDetail( ({ "achtes buch", "buch 8", "buch acht" }),
    "Du liest unter andrem:\n"
    "Manchmal glaube ich, dass sicherste Zeichen dafuer, dass es intelligentes "
    "Leben im Universum gibt, ist, dass keiner von ihnen versucht hat, "
    "uns zu kontaktieren - Calvin\n"
    "\n"
    "Gegner glauben uns zu widerlegen, wenn sie ihre Meinung "
