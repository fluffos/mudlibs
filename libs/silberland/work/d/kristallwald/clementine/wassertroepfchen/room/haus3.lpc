inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../carolina.h"


int anz_heilung;

void create()
{
  ::create();
  anz_heilung = 3;
  SetProp(P_INT_SHORT, "In einem kleinen Haeuschen");
  SetProp(P_INT_LONG, 
    "Du findest Dich in einem gemuetlichen Zimmer wieder, dass durch die "
    "Sonne von ausserhalb erhellt wird. "   
    "Direkt am Fenster steht ein kleiner runder Tisch, "
    "ein angenehmer Polstersessel daneben laed zum Entspannen ein. Auf dem "
    "alten Holzboden liegt ein bunter Teppich, der aus den verschiedensten "
    "Materialien gefertigt worden zu sein scheint. An den Waenden des "
    "Zimmers stehen Buecherregale, die eine enorme Sammlung verschiedenster "
    "Werke aufweisen. "); 
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_HOUSE]) );
  AddExit( "osten", ROOM "haus1" );
  AddExit( "norden", ROOM "haus4" );


// DETAILBEGINN

  AddDetail( ({ "zimmer", "raum", "bibliothek" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "teppich" }),
    "Der Teppich auf dem Boden ist total bunt, und fuehlt sich ziemlich "
    "seltsam an, wenn man drueber geht. Wahrscheinlich liegt das an "
    "den verschiedenen Materialien, aus denen er gefertigt wurde. ");

  AddDetail( ({ "material", "materialien" }),
    "Der Teppich besteht unter anderem aus Bast, Bananenblaettern, "
    "Papier, Filz, Stoffresten, Silberfaeden, und vielem mehr. ");

  AddDetail( ({ "blaetter", "bananenblaetter" }),
    "Bananenblaetter eignen sich gut fuers Flechten und Weben. ");

  AddDetail( ({ "flechten", "weben" }),
    "Der Teppich wurde sowohl gewebt, als auch geflechtet. Hier wurden "
    "mehrere Techniken miteinander verknuepft. ");

  AddDetail( ({ "technik", "techniken" }),
    "Vielleicht machen diese verschiedenen Techniken den Teppich so "
    "besonders. ");

  AddDetail( ({ "bast", "stoffreste", "reste", "filz" }),
    "Bast, Filz und Stoffreste wurden in den Teppich eingearbeitet. ");

  AddDetail( ({ "faeden", "silberfaeden" }),
    "Hauchduenne Silberfaeden durchziehen den Teppich und erzeugen "
    "ein leichtes Glitzern. ");

  AddDetail( ({ "glitzern" }),
    "Sieht total toll aus!");

  AddDetail( ({ "papier" }),
    "Das Papier wurde zuerst gut zusammengerollt, damit eine Art Schnur "
    "entsteht, und danach eingewebt. ");

  AddDetail( ({ "art", "schnur" }),
    "Wenn man Papier gut zusammenrollt entsteht eine Art Schnur. ");

  AddDetail( ({ "sessel", "polstersessel" }),
    "Der Sessel sieht ziemlich bequem aus, und laed zum Entspannen ein. "
    "Setz Dich doch einfach mal hinein, und ruh Dich etwas aus. "); //setzen

  AddDetail( ({ "entspannen" }),
    "Entspannen ist immer gut :)");

  AddDetail( ({ "tisch" }),
    "Neben dem Fenster steht ein runder Tisch. Dort legt Wassertroepfchen "
    "sicherlich manchmal noch nicht fertiggelesene Buecher ab. ");

  AddDetail( ({ "wassertroepfchen" }),
    "Hier ist sie leider nicht. ");

  AddDetail( ({ "mitte" }),
    "In der Mitte des Raumes liegt ein Teppich am Boden. ");

  AddDetail( ({ "sonne" }),
    "Die Sonne schenkt Dir ihr Laecheln und erhellt von draussen den "
    "Raum. ");

  AddDetail( ({ "laecheln" }),
    "Die Sonne laechelt von draussen herein. Laechel doch zurueck!"); //laechel

  AddDetail( ({ "boden", "holzboden" }),
    "Der Holzboden scheint schon ziemlich alt zu sein. Zumindest "
    "Knarren die Dielen schon wenn man drueber geht. In der Mitte des "
    "Bodens liegt ein bunter Teppich. ");


  AddDetail( ({ "sammlung", "buechersammlung" }),
    "Wassertroepfchens Buechersammlung ist wirklich riesig. Ob sie all "
