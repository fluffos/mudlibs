  AddDetail( ({ "dielen", "holzdielen" }),
    "Die Holzdielen knarren schon wenn man drueber laeuft. Scheinen wohl "
    "sehr alt zu sein. ");

  AddDetail( ({ "waende" }),
    "Ueberall an den Waenden stehen Buecherregale. Man sieht kaum noch "
    "ein Stueckchen weisse Wand vor lauter Buechern. ");

  AddDetail( ({ "wand" }),
    "Die Wand scheint weiss zu sein, aber vor lauter Buecher kannst Du "
    "das nicht so genau erkennen. ");

  AddDetail( ({ "stueckchen" }), 
    "Kaum ein Stueckchen Wand ist frei geblieben. Ueberall stehen Regale. ");

  AddDetail( ({ "sueden" }),
    "Dort versteckt sich zwischen all den Buechern das Fenster!");

  AddDetail( ({ "fenster" }),
    "Durch das Fenster im Sueden kommen die Sonnenstrahlen herein. ");

  AddDetail( ({ "strahlen", "sonnenstrahlen" }),
    "Sie fuehlen sich herrlich auf Deiner Haut an. ");

  AddDetail( ({ "haut" }),
    "Wie schoen warm sie sich anfuehlt! ");

  AddDetail( ({ "decke" }),
    "Die Decke ist in weiss gehalten. Anscheinend wurde sie erst "
    "kuerzlich neu gestrichen. ");

  AddDetail( ({ "farbe" }),
    "Falls Du die Farbe an der Decke meinst - die ist sicherlich schon "
    "getrocknet. ");

  AddDetail( ({ "werke" }),
    "Hier gibt es hunderte von dicken Werken. ");

  AddDetail( ({ "buecher" }),
    "Hier gibt es ganz viele Buecher, meinst Du vielleicht ein bestimmtes "
    "Buch? ");

  AddDetail( ({ "regale", "buecherregale", "buecherregal", "regal" }),
    "Die Waende sind hier bist oben hin mit Regalen zugestellt, in denen "
    "sich unzaehlige dicke und duenne Buecher befinden. Manche sind "
    "rot, manche gruen, manche haben einen Einband, manche nicht. Es "
    "sind wirklich sehr sehr viele!");

  AddDetail( ({ "einband" }),
    "Nicht alle Buecher haben einen Einband. ");

  AddDetail( ({ "rotes buch", "gruenes buch", "rote buecher", 
    "gruene buecher", "farben" }),
    "Hier gibt es Buecher in den verschiedensten Farben. ");

  AddDetail( ({ "buch" }),
    "Buch 1, Buch 2, ... welches Buch moechtest Du Dir naeher ansehen?!");

  AddDetail( ({ "buch eins", "buch 1", "erstes buch" }),
    "Das erste Buch traegt den Titel: >Lass mich Dein Hausdrache sein<.");

  AddReadDetail( ({ "buch eins", "erstes buch", "buch 1" }),
    "Du schlaegst das Buch auf...\n"
    "Anscheinend handelt es sich um ein Malbuch...\n"
    "Uninteressant!\n");

  AddDetail( ({ "buch zwei", "buch 2", "zweites buch" }),
    ">Wie man aus einem Frosch einen Mann macht<");
   
  AddReadDetail( ({ "zweites buch", "buch 2", "buch zwei" }),
    "Zu Deiner Enttaeuschung ist es ein sehr duennes Buch:\n"
    "Man nehme einen verzauberten Prinzen und kuesse diesen.\n"
    "Danach verwandelt sich dieser umgehend von einem Frosch in den "
    "Prinzen zurueck und mit etwas Glueck sieht er noch halbwegs passabel "
    "aus.\n"
    "Fragt sich ja nur wo man einen Prinzen findet...hier sicher nicht!\n");

  AddDetail( ({ "drittes buch", "buch 3", "buch drei" }),
    ">Helden und Heldinnen im Silberland<");

  AddReadDetail( ({ "drittes buch", "buch 3", "buch drei" }),
    "Das Buch interessiert Dich einfach ueberhaupt nicht.");

  AddDetail( ({ "viertes buch", "buch 4", "buch vier"}),
    "**Was es bedarf um Arnolds Herz zu brechen**");

  AddReadDetail( ({ "viertes buch", "buch 4", "buch vier" }),
    "Du liest:\n"
    "\n"
    "Um Arnold zu erobern, bedarf es wirklich wenig.\n"
    "Man nehme ein grosses Fass Bier und platziere es vor ihm.\n"
    "Wenn es leer ist kann man ihn ganz einfach schultern und mit nach "
    "Hause nehmen.\n"
    "\n"
    "Du denkst . o O (Das ja easy)\n"); 

  AddDetail( ({ "fuenftes buch", "buch 5", "buch fuenf" }),
    "Maerchen als Therapie");

  AddReadDetail( ({ "fuenftes buch", "buch 5", "buch fuenf" }),
    "Da sich der Titel schon so kompliziert anhoert, beschliesst Du Dir "
