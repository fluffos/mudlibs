  AddSpecialDetail( ({"schlaflied", "schlaflied fuer drachen"}), "det_schlaflied");

  AddDetail( ({ "buch 16", "buch sechzehn", "sechzehntes buch" }),
    "*g*g*g*g* Zauberhafte Traenke *g*g*g*g*");

  AddReadDetail( ({ "buch 16", "buch sechzehn", "sechzehntes buch" }),
    "Du findest ein Rezept von Zitronenlikoer:\n"
    "\n"
    "Vier Zitronen schaelen und die klein geschnittene Schale mit 1/2l "
    "Weingeist ansetzen. 3 Tage stehen lassen und dann abseihen.\n"
    "1l Wasser mit 800g Zucker aufkochen und das Angesetzte noch heiss "
    "dazugeben - auskuehlen lassen und in Flaschen abfuellen.\n");

// SOUNDS

  AddSound(DEFAULT_SOUND, 
    "Es ist ziemlich ruhig hier - das sollte es beim Lesen auch sein! "
    "Draussen zwitschern manchmal einige Voegel und die Blaetter "
    "rauschen im Wind. All das vermischt sich allerdings zu einer "
    "netten gleichmaessigen Hintergrundmelodie, die alles andere als "
    "stoerend ist. ");

  AddSound( ({ "lesen" }),
    "Lesen kannst Du nicht hoeren, das kannst Du nur tun!");

  AddSound( ({ "voegel", "zwitschern" }),
    "Die Voegel zwitschern draussen im Garten. ");

  AddSound( ({ "garten" }),
    "Du hoerst die Voegel und die Blaetter im Wind. ");

  AddSound( ({ "blaetter", "wind" }),
    "*raschel* *raschel* Die Blaetter wiegen sich im Wind.");

  AddSound( ({ "melodie", "hintergrundmelodie" }),
    "Sie ist sehr angenehm. ");

  AddSound( ({ "dielen" }),
    "Du bleibst ruhig stehen und lauscht an den Dielen... Nichts zu hoeren!");

  AddSound( ({ "knarren" }),
    "Die Dielen knarren wenn man drueber laeuft. Aber sobald man ruhig "
    "stehen bleibt verstummen sie. ");


// SMELLS  

  AddSmell(DEFAULT_SMELL,
    "Es riecht nach Buechern und Blumen.");

  AddSmell( ({ "blumen", "blume" }),
    "Der Geruch weht von draussen zum Fenster herein. Vielleicht solltest "
    "Du mal in den Garten gehen um an den Blumen zu riechen?!");

  AddSmell( ({ "geruch" }),
    "Riecht gut, nicht wahr?");

  AddSmell( ({ "fenster" }),
    "Das Fenster ist geoeffnet, daran riechen halte ich irgendwie "
    "nicht fuer so sinnvoll... ");

  AddSmell( ({ "garten" }),
    "Du solltest schon nach draussen gehen wenn Du im Garten etwas "
    "riechen willst.");

  AddSmell( ({ "buecher", "buch", "papier" }),
    "Es riecht hier einfach nach Buechern - kein Wunder, stehen ja "
    "einige um Dich herum. Find Dich damit ab :)");

  AddDetail( ({ "wunder" }),
    "Es waere mir neu, wenn man Wunder riechen kann. ");


  AddCmd( ({ "laechl", "laechel", "laechele", "laechle" }), "c_laecheln");
  AddCmd( ({ "roll", "rolle" }), "c_rollen");
  AddCmd( ({ "setz", "setze", "sitz", "sitze" }), "c_setzen");
  AddCmd( ({ "entspann", "entspanne" }), "c_entspannen");
  AddCmd( ({ "entziffer", "entziffre", "entziffere" }), "c_entziffern");


}

public string det_schlaflied() {
  string str, fulltext;
  int i;

  fulltext = call_other("/d/kristallwald/sargola/lichtung/npc/d", "GetSchlaflied", 0, 5);

  str = "Da steht:\n\nSchlaflied fuer einen Drachen I\n\n"+fulltext+"\nDas solltest du dir merken. Koennte mal nuetzlich sein!\n";
  if(TP->QueryProp(P_GUILD) == "bardengilde" && TP->QuerySkill("abendstille ueberall") == 0) {
    str += BS("Wenn du das einen Drachen genau so, Zeile fuer Zeile, vorsingst, wird er wohl einschlafen. Es darf "
           "dir jedoch kein Fehler passieren. Also merke es dir gut!\n");
  }

  return str;
}

int c_laecheln(string str)
{
 if( str != "zurueck"   &&
     str != "sonne an" )
 {
  notify_fail("Was moechtest Du tun?\n");
  return 0;
 }
 else
 {
  write(BS("Du laechst die Sonne an."));
  return 1;
 }
}

int c_rollen(string str)
{
 if( str != "teppich beiseite" )
 {
  notify_fail("Was wie wo?\n");
  return 0;
 }
 else
 {
  write(BS("Du rollst den Teppich beiseite und bestaunst den Holzboden "
           "darunter. Ueberhaupt nichts zu sehen!\n"
           "Du rollst den Teppich wieder zurueck.\n"));
  return 1;
 }
}

int c_entspannen(string str)
{
 if( str != "")
 {
  notify_fail("Was moechtest Du genau tun?\n");
  return 0;
 }
 else
 {
  write(BS("Dann setz Dich doch einfach in den Sessel hin."));
  return 1;
 }
}

int c_setzen(string str)
{
 
 if( str != "in sessel"        &&
     str != "in polstersessel" &&
     str != "auf sessel"       &&
     str != "auf polstersessel" )
 {
  notify_fail("Wo moechtest Du Dich setzen?\n");
  return 0;
 }
 else
 {
  if(anz_heilung < 1)
  {
   write(BS("Du setzt Dich in den Sessel, doch irgendwie passiert gar nix :(\n"
            "So stehst Du einfach wieder auf. Irgendwie war das nicht so "
            "entspannend wie gedacht."));
   return 1;
  }
  else
  { 
   write(BS("Du laesst Dich in den weichen Polstersessel fallen. Er scheint "
           "von Zauberhand gefertigt worden zu sein, denn Du fuehlst Dich "
           "sofort entspannt und erhebst Dich ausgeruht und erfrischt."));
   say(CTPN+ " setzt sich, seufzt kurz und steht wieder auf.\n"); 
   TP->heal_self(15);
   anz_heilung--;
   return 1;
  }
 }
} 

int c_entziffern(string str)
{
 if( str != "symbole" )
 {
  notify_fail("Was moechtest Du hier entziffern?\n");
  return 0;
 }
 else
 {
  write("Du versuchst die Symbole zu entziffern und siehst vor Deinem "
        "geistigen Auge ein paar Zeilen schweben:\n"
        "\n"
        "Geheimer Hustensaft\n"
        "Eine Hagebutte, eine Lindenbluete, ein paar "
        "Hollerblueten, eine Schafgarbe, ein Rotkleeblatt, ein Efeublatt und "
        "eine Brennessel, Wasser, ein Stueck Wuerfelzucker - und natuerlich "
        "ein Loeffel zum Umruehren.\n"
        "Wenn Du alles beisammen hast, wirf die Kraeuter/Zutaten in einen "
	"Topf!\n");
  say(CTPN+ " fuehlt sich wissender.\n");
  return 1;
 }
}

