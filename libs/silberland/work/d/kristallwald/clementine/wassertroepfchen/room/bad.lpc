inherit "std/room";

#include <properties.h>
#include <language.h>
#include <room/doors.h>
#include "../carolina.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "In einem kleinen Haeuschen");
  SetProp(P_INT_LONG, 
    "Du befindest Dich in einem Badezimmer. An der Ostwand steht "
    "ein Kaestchen auf dem eine Schale mit Wasser platziert wurde. "
    "Daneben haengen einige Tuecher an Haken. Eine, aus Korb geflochtene "
    "Truhe, steht an der Nordwand. Die Waende wurden mit einigen Malereien "
    "verschoenert, die Szenen aus dem Tierreich zeigen. Auf dem Fensterbrett "
    "kannst Du ausserdem eine Dose mit frischen Bluetenblaettern, die einen "
    "traumhaften Duft verstroemen, erkennen.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_HOUSE]) );
  AddExit( "westen", ROOM "haus1" );

  NewDoor( "westen", ROOM "haus1", ({ "tuer", "tuere", "eichentuere", 
                                     "eichentuer" }),
     ({ DOOR_CLOSED,
        DOOR_RESET_CL,
        D_NAME, "Eichentuer",
        D_GENDER, FEMALE,
        D_SHORT, "Im Westen befindet sich eine %se Eichentuer.",
        D_LONG, "Eine alte Eichentuer, durch die man anscheinend "
                "ins Vorzimmer gelangt. Sie laesst sich sicherlich "
                "leicht oeffnen und schliessen. ",
        D_MSGS, ({ "nach Westen", "geht", "kommt herein" }),
        D_OPENMSG, ({ "Du oeffnest die Tuere. ",
                      "%s oeffnet die Tuere. "
                      " wird geoeffnet. " }), 
        D_CLOSEMSG, ({ "Du schliesst die Tuere sorgfaeltig. ",
                       "%s schliesst sorgfaeltig die Tuere. ",
                       " wird geschlossen. " }),
        D_RESET_CLOSEMSG, " wird durch einen Windstoss geschlossen. " }) );


// DETAILBEGINN

  AddDetail( ({ "zimmer", "badezimmer", "raum" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "bluetenblaetter", "blueten", "blaetter" }),
    "Frische Bluetenblaetter befinden sich in einer Dose auf dem "
    "Fensterbrett und verstroemen ihren zauberhaften Duft im ganzen Raum. ");

  AddDetail( ({ "dose" }),
    "Eine Dose, die mit vielen bunten und angenehm riechenden Bluetenblaettern "
    "gefuellt wurde, steht auf dem Fensterbrett. Sie ist aus feinstem Silber "
    "und war sicherlich ein Geschenk eines Freundes von Wassertroepfchen. ");

  AddDetail( ({ "wassertroepfchen" }),
    "Du findest sie sicherlich irgendwo im Haus. ");

  AddDetail( ({ "haus" }),
    "Schau Dich doch etwas um hier. ");

  AddDetail( ({ "freunde", "freund" }),
    "Wassertroepfchen hat viele gute Freunde, die sich fuer ihre "
    "Gastfreundschaft und Freundlichkeit mit Geschenken bedanken. ");

  AddDetail( ({ "duft" }),
    "Riechen! ");

  AddDetail( ({ "brett", "fensterbrett" }),
    "Das steinerne Fensterbrett ist weiss bemalt. Auf ihm steht ein silberne "
    "Dose. ");

  AddDetail( ({ "haken" }),
    "Einige Tuecher haengen an Haken ueber der Schale. Sie sind sicherlich "
    "zum Haende und Gesicht abtrocknen gedacht. ");

  AddDetail( ({ "decke" }),
    "Die Decke erstrahlt in hellem Weiss, und befindet sich ziemlich hoch "
    "ueber Dir. ");

  AddDetail( ({ "kaestchen" }),
    "An der Ostwand steht ein hoelzernes Kaestchen mit drei Schubladen. "
    "Auf ihm steht eine Schale mit frischem Wasser, ueber der wiederum "
    "einige Tuecher an Haken haengen. ");

  AddDetail( ({ "malereien" }),
    "Die Waende wurden kunstvoll bemalt. Du siehst unter anderem "
    "ein kleines Eichhoernchen, dass gerade eine Nuss isst. Eine andere "
    "Zeichnung zeigt wie ein Reh aus eine Bach trinkt. ");

  AddDetail( ({ "korb" }),
    "Die Truhe wurde aus Korb geflochten. Vielleicht sogar von "
    "Wassertroepfchen selbst. ");

  AddDetail( ({ "westwand" }),
    "Dort ist die Tuer!");

  AddDetail( ({ "suedwand" }),
    "Im Sueden ist das Fenster. Auf dem Fensterbrett davor steht eine Dose.");

  AddDetail( ({ "nordwand" }),
    "Eine Truhe steht dort.");

  AddDetail( ({ "ostwand" }), 
    "An der Ostwand steht ein Kaestchen mit einer Schale drauf. Einige "
    "Tuecher haengen ebenfalls dort. ");

  AddDetail( ({ "wand" }),
    "Welche Wand meinst Du? ");

  AddDetail( ({ "waende" }),
    "Die Waende sind richtige Kunstwerke! In liebevoller Handarbeit wurden "
    "Szenen aus dem Tierreich aufgemalt. ");

  AddDetail( ({ "kunstwerke", "werke" }),
    "Phantastisch!");

  AddDetail( ({ "handarbeit", "arbeit" }),
    "Alles wurde sehr sehr liebevoll gestaltet. ");

  AddDetail( ({ "schale" }),
    "Die Schale ist aus hauchduennem weissen Porzellan. In ihr befindet "
    "sich Wasser. ");

  AddDetail( ({ "quelle" }),
    "Sie muss kristallklar sein. Wo sie sich wohl befindet?!");

  AddDetail( ({ "porzellan" }),
    "Die Schale ist sicherlich sehr kostbar. ");

  AddDetail( ({ "szenen", "tierszenen" }),
    "Die Malereien und Zeichnungen zeigen verschiedene Tierszenen. ");

  AddDetail( ({ "tierreich", "reich" }),
    "Die Malereien zeigen einige Szenen aus dem Tierreich. ");

  AddDetail( ({ "tuecher" }),
    "Mit den Tuechern kann man sich nach dem Waschen abtrocknen. "); 
 
  AddDetail( ({ "truhe" }),
    "Die Truhe ist aus Korb geflochten und steht an der Nordwand. Was "
    "da wohl drinnen sein mag?!"); 

  AddDetail( ({ "wasser" }),
    "Das Wasser in der Schale ist kristallklar. Aus welcher Quelle es "
    "wohl stammt?! ");

  AddDetail( ({ "fenster" }),
    "Das Fenster steht weit geoeffnet, sodass Du einen herrlichen Ausblick "
    "in den Garten hast. ");

  AddDetail( ({ "weiss" }),
    "Es leuchtet richtig hell! ");

  AddDetail( ({ "ausblick" }),
    "Man hat einen herrlichen Ausblick auf den Garten wenn man hinausschaut. ");

  AddDetail( ({ "garten" }),
    "Im Garten blueht und gedeiht alles...hoffentlich bleibt das so!");

  AddDetail( ({ "freundlichkeit" }),
    "Die kleine Elfe ist wirklich immer freundlich. ");

  AddDetail( ({ "elfe" }),
    "Wo ist sie denn bloss?");

  AddDetail( ({ "gastfreundschaft" }),
    "Jeder ist bei Wassertroepfchen immer herzlich Willkommen.");

  AddDetail( ({ "willkommen", "gaeste" }),
    "Gaeste sind hier immer gerne gesehen. ");

  AddDetail( ({ "reh", "bach" }),
    "Das Reh trinkt gerade aus einem Bach. Wirklich eine sehr "
    "gelungene Zeichnung. ");

  AddDetail( ({ "eichhoernchen", "nuss" }),
    "Ein total niedliches Eichhoernchen knabbert an einer Nuss. ");
 
  AddDetail( ({ "geschenk" }),
    "Die Dose war sicherlich ein Geschenk von jemanden, der Wassertroepfchen "
    "gerne mag. ");

  AddDetail( ({ "silber" }),
    "Die Dose besteht aus feinstem Silber und glaenzt im Sonnenlicht. ");

  AddDetail( ({ "sonnenlicht", "licht", "sonne" }),
    "Von draussen scheint die Sonne herein und laesst alles "
    "erstrahlen. ");

  AddDetail( ({ "vorzimmer" }),
    "Um ins Vorzimmer zu gelangen musst Du durch die Tuer gehen!");

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus hellem Marmor und verleiht dem Raum etwas "
    "Edles. ");

  AddDetail( ({ "marmor" }),
    "Heller Marmor bedeckt den Boden. Sieht total edel aus!");

  AddDetail( ({ "edles" }),
    "Der Boden sieht wirklich toll aus!");

  AddDetail( ({ "haende", "gesicht" }),
    "Mit den Tuecher kann man sich sicherlich Haende und Gesicht "
    "abtrocknen. ");

  AddDetail( ({ "schubladen", "laden" }),
    "Das Kaestchen hat drei Schubladen. Schloesser kannst Du an keiner "
    "von ihnen erkennen. Was da wohl drinnen sein mag?");

  AddDetail( ({ "schloesser" }),
    "Keine zu sehen. Vermutlich braucht man geheime Zauberformeln um die "
    "Schubladen zu oeffnen.");

  AddDetail( ({ "zauberformel", "formel", "zauberformeln", "formeln" }),
    "Da Du sie nicht weisst, bleiben Dir die Schubladen wohl verschlossen.");

  AddDetail( ({ "zeichnung", "zeichnungen" }),
    "Da war wirklich ein Kuenstler am Werk!");

  AddDetail( ({ "kuenstler", "werk" }),
    "Sieht wirklich total toll aus!");

  AddDetail( ({ "waschen" }),
    "Nach dem Waschen sollte man sich immer abtrocknen. Oder willst Du "
    "etwa krank werden?");

  AddDetail( ({ "rosenblaetter", "rosen", "veilchen", "veilchenblueten" }),
    "Ein Gemisch aus Rosenblaetter und Veilchenblueten verstroemt seinen herrlichen Duft.");

// SOUNDS
  
  AddSound(DEFAULT_SOUND, "Eine angenehme Stille durchstroemt den Raum. ");

  AddSound( ({ "stille" }), 
    "Es ist wirklich angenehm ruhig hier - ein wahre Wohlfuehloase.");

  AddSound( ({ "oase", "wohlfuehloase" }),
    "Wenn Du moechtest kannst Du gerne noch etwas hier verweilen oder rumideln.");

  AddSound( ({ "raum" }),
    "Es ist angenehm ruhig hier.");
 
// SMELLS

  AddSmell(DEFAULT_SMELL, "Die Bluetenblaetter verstroemen ihren Duft im ganzen Raum.");

  AddSmell( ({ "blaetter", "blueten", "bluetenblaetter" }),
    "Herrlich! Duerfte sich um eine Mischung aus Rosenblaettern und Veilchen handeln.");

  AddSmell( ({ "mischung" }),
    "Eine wirklich herrliche Duftkombination!");

  AddSmell( ({ "duftkombination", "kombination", "duft" }),
    "Es riecht hier wirklich gut!");

  AddSmell( ({ "rosenblaetter", "rosen", "veilchen", "veilchenblueten" }),
    "Riecht wirklich bezaubernd. Fast zu schoen um wahr zu sein...");



// CMDS

  AddCmd( ({ "trockne" }), "c_trocknen" );
  AddCmd( ({ "oeffne" }), "c_oeffnen" );
  AddCmd( ({ "wasch", "wasche" }), "c_waschen" );
  AddCmd( ({ "streich", "streiche" }), "c_streichen" );


}

int c_waschen(string str)
{
  if(str != "mich" && 
     str != "haende" )
  {
	  notify_fail("Was moechtest Du waschen?\n");
  	  return 0;
  }
  else
  {
	  write(BS("Wieso moechtest Du Dich denn waschen? Schmutzig und eingesaut fuehlst Du Dich doch viel wohler!"));
	  return 1;
  }
}



int c_trocknen(string str)
{
  if(str != "an handtuch ab" &&
     str != "an tuch ab"     &&
     str != "haende an handtuch ab" &&
     str != "haende an tuch ab" )

  {
	notify_fail("Woran moechtest Du Dich abtrocknen?\n");
	return 0;
  }
  else
  {
	write(BS("Wozu abtrocknen? Du hast Dich doch nicht mal gewaschen! "
		  "Wenn Dir soviel an den Handtuechern liegt, "
		  "kannst Du ja gerne mal ueber sie streichen."));
	return 1;
  }
}

int c_oeffnen(string str)
{
  if( str != "truhe" )
  {
	  notify_fail("Was moechtest Du hier oeffnen?\n");
	  return 0;
  }
  else
  {
	  write(BS("Neugierig oeffnest Du die Truhe, aber Du findest "
		   "nur fein saeuberlich gefaltete Handtuecher in ihr, die "
		   "Dich wirklich ueberhaupt nicht interessieren. Klapp - "
		   "Du schliesst sie wieder."));
	  return 1;
  }
}



int c_streichen(string str)
{
  if(str != "ueber handtuch" &&
     str != "ueber handtuecher" )
  {
	  notify_fail("Worueber moechtest Du streichen?\n");
	  return 0;
  }
  else
  {
	  write(BS("Wow, sind die aber kuschelig weich!!"));
	  return 1;
  }
}






