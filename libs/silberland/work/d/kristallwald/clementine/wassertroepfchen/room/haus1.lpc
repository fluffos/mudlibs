      write("Du nimmst "+ob->name(WEN)+" vom Kleiderhaken.\n");
      say(CTPN+" nimmt "+ob->name(WEN)+" von einem " 
          "Kleiderhaken.\n"); 
    }
    return 1;
  }

  write("So etwas haengt nicht an einem Haken.\n");
  return -1;
}

int c_haengen(string str)
{
  object ob;
  int n;
  string was, woran;

  notify_fail("Was willst Du woran aufhaengen?\n");

  if(!str || str == "") return 0;
  n = sscanf(str, "%s an %s", was, woran);
  if(n!=2){n=sscanf(str, "%s an %s auf", was, woran);}
  if(n!=2){n=sscanf(str, "%s am %s", was, woran);}
  if(n!=2){n=sscanf(str, "%s am %s auf", was, woran);}
  if(n!=2){return 0;}

  if( !((woran == "haken") || (woran == "kleiderhaken")) )
  {
    return 0;
  }

  if( (TP->QueryProp(P_SIZE) < 150) || (TP->QueryProp(P_FROG) == 1) )
  {
    write(BS("Du reckst und streckst Dich, aber Du bist zu klein "
                  "um etwas an einen Kleiderhaken zu haengen."));
    return -1;
  }

  if(!ob=present(was,TP))
  {
    write("Sowas hast Du doch gar nicht bei Dir!\n");
    return 1;
  }

  if(sizeof(all_inventory(TO)) >= MAXITEMS)
  {
    write(BS("Die Haken sind schon vollbehangen, da passt "
