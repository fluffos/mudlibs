int c_nehmen(string str)
{
  object ob;
  int i,n;
  string was, wovon;

  notify_fail("Was willst Du wovon nehmen?\n");
  if(!str || str == "") return 0;
  n=sscanf(str, "%s von %s", was, wovon);
  if(n!=2){n=sscanf(str, "%s vom %s", was, wovon);}
