

inherit "std/room";
inherit "std/store";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <room/doors.h>

#include "../carolina.h"


void create()
{
  ::create();
  SetProp(P_INT_SHORT, "In einem kleinen Haeuschen");
  SetProp(P_INT_LONG, 
    "Du stehst inmitten eines kleinem Vorzimmers. Die Waende wurden gelb "
    "gestrichen und mit vielen Bildern versehen. Ausserdem wurden an "
    "den Waenden einige Haken befestigt, an denen man Kleidungsstuecke "
    "aufhaengen kann. Gleich neben der Eingangstuer steht eine grosse Vase, "
    "in der viele kleine lila Fliederzweige stecken. Ein kleines Kaestchen "
    "dient als Schuhablage. Nach Norden geht der Flur weiter, nach Westen "
    "scheinst Du in eine Art Bibliothek zu kommen. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_HOUSE]) );
  AddExit( "raus", ROOM "garten_c1" );
  AddExit( "osten", ROOM "bad" );
  AddExit( "westen", ROOM "haus3" );
  AddExit( "norden", ROOM "haus2" );

  AddItem(OBJ "haken");

  NewDoor( "osten", ROOM "bad", ({ "tuer", "tuere", "eichentuere", 
                                     "eichentuer" }),
     ({ DOOR_CLOSED,
        DOOR_RESET_CL,
        D_NAME, "Eichentuer",
        D_GENDER, FEMALE,
        D_SHORT, "Im Osten befindet sich eine %se Eichentuer. ",
        D_LONG, "Eine alte Eichentuer, durch die man anscheinend "
                "ins Badezimmer gelangt. Sie laesst sich sicherlich "
                "leicht oeffnen und schliessen. ",
        D_MSGS, ({ "nach Osten", "geht", "kommt herein" }),
        D_OPENMSG, ({ "Du oeffnest die Tuere. ",
                      "%s oeffnet die Tuere. "
                      " wird geoeffnet. " }), 
        D_CLOSEMSG, ({ "Du schliesst die Tuere sorgfaeltig. ",
                       "%s schliesst sorgfaeltig die Tuere. ",
                       " wird geschlossen. " }),
        D_RESET_CLOSEMSG, " wird durch einen Windstoss geschlossen. " }) );


// DETAILBEGINN

  AddDetail( ({ "vorzimmer", "zimmer", "raum" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "kleidungsstuecke", "kleidung", "stuecke" }),
    "Auf den Haken kannst Du sie aufhaengen. Es schickt sich ja nicht "
    "besonders, voll zubepackt in fremden Haeusern umherzuwandern. ");

  AddDetail( ({ "haeuser", "haus" }),
    "Gehoert das Haus etwa Dir? ");

  AddDetail( ({ "bibliothek" }),
    "Nach Westen scheinst Du in eine Bibliothek zu kommen. Zumindest befinden "
    "sich dort etliche Regale die mit Buechern vollgestopft sind. ");

  AddDetail( ({ "regale", "buecher" }),
    "Du solltest schon nach Westen gehen um mehr erkennen zu koennen. ");

  AddDetail( ({ "fliederzweige", "zweige", "flieder" }),
    "Lila Fliederzweige stecken in der Vase gleich neben dem Eingang, und "
    "verstroemen einen beruhigenden Duft. ");

  AddDetail( ({ "waende" }),
    "Das ganze Vorzimmer ist in gelb gehalten, was wohl hauptsaechlich "
    "an den gestrichenen Waenden liegt. Neben vielen Bildern kannst Du auch "
    "einige Haken sehen. ");

  AddDetail( ({ "haken" }),
    "An ihnen kann man wohl seine Kleidung aufhaengen. ");

  AddDetail( ({ "flur" }),
    "Nach Norden fuehrt Dich der Flur weiter in einen anderen Raum. ");

  AddDetail( ({ "norden" }),
    "Der Flur fuehrt nach Norden weiter. ");

  AddDetail( ({ "westen" }),
    "Im Westen befindet sich ein weiterer Raum, in dem sich viele Regale "
    "befinden. ");

  AddDetail( ({ "art" }),
    "So etwas Sinnloses kannst Du hier nicht untersuchen! ");
  
  AddDetail( ({ "sinnloses" }),
    "Sinnlos! ");

  AddDetail( ({ "vase" }),
    "Eine grosse Vase steht gleich neben dem Eingang. In ihr stecken "
    "lila Fliederzweige, die erst kuerzlich gepflueckt worden sind. ");

  AddDetail( ({ "bilder" }),
    "Es haengen bestimmt zehn Bilder an den Waenden, Du kannst Dir alle "
    "einzeln ansehen, indem Du z.b. <unt bild 1> eingibst... ");

  AddDetail( ({ "bild 1" }),
    "Dieses Bild zeigt Wassertroepfchen beim Blumengiessen in ihrem Garten. ");

  AddDetail( ({ "bild 2" }),
    "Auf dem zweiten Bild siehst Du eine Raupe, wie sie sich gerade "
    "verpuppt. ");

  AddDetail( ({ "bild 3" }),
    "Wassertroepfchen mit einem Marienkaefer, der ihr um die Nase "
    "herumschwirrt. ");

  AddDetail( ({ "bild 4" }),
    "Ein wunderschoener Fliederstrauss, wie er in seiner vollen Farbpracht "
    "blueht. ");

  AddDetail( ({ "bild 5" }),
    "Auf diesem Bild siehst Du Wassertroepfchen, wie sie gerade einen "
    "Teich anlegt. ");

  AddDetail( ({ "bild 6" }),
    "Bild sechs zeigt Dir die kleine Wasserelfe, umringt von lauter "
    "Libellen. ");

  AddDetail( ({ "bild 7" }),
    "Auf Bild sieben siehst Du Wassertroepfchen beim Unkraut zupfen. "
    "Sie traegt sonderbare Handschuhe. ");

  AddDetail( ({ "bild 8" }),
    "Zwei kleine Kaefer, die sich gerade ihr trautes Heim einrichten. ");

  AddDetail( ({ "bild 9" }),
    "Bluehende rote Rose, wie Du sie schon beim Eingang bewundern konntest. ");

  AddDetail( ({ "bild 10" }),
    "Wassertroepfchen, wie sie gerade in der Kueche etwas zubereitet. ");

  AddDetail( ({ "bild 11" }),
    "Auf diesem Bild siehst Du eine Wiese mit vielen bunten Blumen. ");

  AddDetail( ({ "bild 12" }),
    "Mehr Bilder sind leider nicht da. ");

  AddDetail( ({ "schuhablage", "ablage" }),
     "Gelbe Stieferl stehen auf ihr. Ob sie Dir passen?");

  AddDetail( ({ "wand" }),
    "Welche Wand meinst Du denn? ");

  AddDetail( ({ "kaestchen" }),
     "Das Kaestchen steht direkt an der Wand. Es scheint sich hierbei wohl "
     "um eine Schuhablage zu handeln, da ein Paar Stieferl draufsteht. ");

  AddDetail( ({ "duft" }),
    "Probiers mit riechen! ");

  AddDetail( ({ "badezimmer" }),
    "Das Badezimmer scheint sich im Osten zu befinden. ");

  AddDetail( ({ "boden", "holzboden" }),
     "Der Boden besteht aus Holz und weist bereits einige Dellen und Furchen "
     "auf. ");

  AddDetail( ({ "holz" }),
    "Leider kannst Du nicht erkennen, um welches Holz es sich dabei handelt. ");

  AddDetail( ({ "eichenholz" }),
    "Du tippst auf Eichenholz, sicher bist Du Dir allerdings nicht. ");

  AddDetail( ({ "decke" }),
    "Von der gelb gestrichenen Decke haengt ein Strauss getrocknete Rosen "
    "herunter. Er scheint noch nicht sehr alt zu sein, da die Farbe der "
    "Rosenblaetter noch kaum verblasst scheint. ");

  AddDetail( ({ "eingang" }),
    "Da bist Du doch erst herein gekommen. ");

  AddDetail( ({ "eingangstuer" }),
    "Die Eingangstuer steht weit offen. Du bist sicherlich durch sie "
    "hineingekommen. Von draussen weht Dir ein warmer Wind ins Gesicht. ");

  AddDetail( ({ "tuer" }),
    "Welche Tuer meinst Du? (Die Eingangstuer oder die Eichentuer?) ");

  AddDetail( ({ "farbe" }),
    "Die Rosenblaetter strahlen noch in einem kraeftigem Rot. ");

  AddDetail( ({ "rot" }),
    "Ein sehr kraeftig leuchtendes Rot. ");

  AddDetail( ({ "paar" }),
    "Ein Paar gelbe Stieferl stehen auf dem Kaestchen. ");
 
  AddDetail( ({ "stieferl" }),
    "Ein Paar gelbe Stieferl stehen auf dem Kaestchen. Ob sie Dir passen? ");

  AddDetail( ({ "gesicht" }),
    "Warmer Wind weht Dir von draussen in Dein Gesicht. ");

  AddDetail( ({ "wind" }),
    "Ein warmer Wind kommt von draussen durch die Eingangstuere und blaest "
    "Dir ins Gesicht. ");

  AddDetail( ({ "rosen" }),
    "Die Rosen wurden zu einem Strauss gebunden, und an der Decke zum "
    "Trocknen aufgehaengt. ");

  AddDetail( ({ "rosenblaetter", "blaetter" }),
    "Die Rosenblaetter des Strausses sind kaum verblasst, sie wurden wohl "
    "erst kuerzlich zum Trocknen aufgehaengt. ");

  AddDetail( ({ "trocknen" }),
    "Von hier unten kannst Du leider nicht erkennen, ob die Blaetter schon "
    "trocken sind, oder ob sich in ihren Adern noch Fluessigkeit befindet. ");

  AddDetail( ({ "adern", "ader" }),
    "Pflanzen haben hauchduenne Adern. ");

  AddDetail( ({ "pflanzen" }),
    "Blick Dich doch etwas mehr im Garten um, dann wirst Du sicherlich "
    "so etwas auch sehen. ");

  AddDetail( ({ "fluessigkeit" }),
    "Das Wasser in den Pflanzen muss sich erst verfluechtigen, damit sie "
    "trocken werden. ");

  AddDetail( ({ "wasser" }),
    "Die Fluessigkeit, die sich in den Pflanzen gesammelt hat. ");
  
  AddDetail( ({ "strauss" }),
    "Ein getrockneter Strauss Rosen haengt von der Decke herab. Ob man ihn "
    "irgendwie herunter bekommen kann? ");

  AddDetail( ({ "dellen" }),
    "Die Dellen lassen auf den regen Verkehr hier schliessen. Anscheinend "
    "gehen hier oft Abenteurer ein und aus. ");

  AddDetail( ({ "abenteurer" }),
    "Bist Du auch einer? ");

  AddDetail( ({ "verkehr" }),
    "Die Bewohnerin hier scheint wohl sehr gastfreundliche zu sein. ");

  AddDetail( ({ "bewohnerin" }),
    "Du kannst sie hier nirgends finden. ");

  AddDetail( ({ "furchen" }),
    "Der Boden ist blitzblank geputzt, weist allerdings schon einige Furchen "
    "auf. Er scheint wohl schon sehr alt zu sein. ");
  
  AddDetail( ({ "garten" }),
    "Du musst schon raus gehen, um in den Garten zugelangen. ");


// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Es duftet ganz herrlich nach Flieder.");

  AddSmell( ({ "flieder" }),
    "Scheint wohl von der Vase zu kommen.");

  AddSmell( ({ "vase" }),
    "Du riechst an der Vase. Tatsaechlich! In ihr befinden sich ein paar "
    "Fliederzweige.");

  AddSmell( ({ "zweige", "fliederzweige" }),
    "Die duften einfach herrlich!");

  AddSmell( ({ "duft" }),
    "Bezaubernd!");


// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Es ist angenehm ruhig hier drinnen.");

  AddSound( ({ "ruhe" }),
    "Die Ruhe tut wirklich gut.");



// COMMANDS. Gewand aufhaengen, Stieferl probieren...

  AddCmd( ({ "probier", "probiere" }), "c_probieren");
//  AddCmd( ({ "haeng", "haenge" }), "c_haengen");
//  AddCmd( ({ "nehm", "nehme", "nimm" }), "c_nehmen");

}

int c_probieren(string str)
{
 if( str != "stieferl" &&
     str != "gelbe stieferl" )
 {
  notify_fail("Was moechtest Du denn probieren?\n");
  return 0;
 }
 else
 {
  write(BS("Du versuchst Dich in die gelben Stieferl zu quetschen... Schade! "
           "Sie passen nicht. "));
  return 1;
 }
}


