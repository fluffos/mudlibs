inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../carolina.h"

int anz_loeffel;
int anz_zucker;

void reset()
{
  ::reset();
  anz_loeffel = 1;
  anz_zucker = 1;
}


void create()
{
  ::create();
  anz_loeffel = 1;
  anz_zucker = 1;
  SetProp(P_INT_SHORT, "In einem Keller");
  SetProp(P_INT_LONG,
    "Hier herrscht das Chaos - oder auch nicht. Je nachdem wie man es "
    "betrachtet. Alle Waende, mit Ausnahme der Westwand, sind mit "
    "Regalen zugestellt. In ihnen tuermen sich bunte Kisten, Glaeser, "
    "Dosen und zum Teil sehr skurrile Gegenstaende, die Du auf den ersten "
    "Blick nicht naeher benennen kannst. Ein kleiner violetter Hocker "
    "steht einsam in der Mitte des Raumes. Nach Westen kommt man durch einen "
    "Kellerbogen wieder zur Treppe zurueck. ");
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);

  AddExit( "westen", ROOM "keller1" );

// DETAILBEGINN

  AddDetail( ({ "westwand" }),
    "Nur an der Westwand stehen keine Regale, aber das verwundert Dich auch "
    "nicht weiter, schliesslich kommt man nach Westen durch einen Kellerbogen "
    "wieder zur Treppe zurueck. ");

  AddDetail( ({ "westen" }),
    "Im Westen kommt man durch einen Kellerbogen zur Treppe zurueck, die ins "
    "Obere des Hauses fuehrt. ");

  AddDetail( ({ "haus" }),
    "Du befindest Dich in Wassertroepfchens Haus - genauer gesagt haeltst "
    "Du Dich momentan in ihrem Keller auf. ");

  AddDetail( ({ "raum", "keller" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "bogen", "kellerbogen" }),
    "Durch den Bogen im Westen geht es zurueck zur Treppe.");

  AddDetail( ({ "waende" }),
    "An fast allen Waenden tuermen sich hohe Regale, die mit irgendwelchen "
    "Klumpert vollgeraeumt sind. ");

  AddDetail( ({ "klumpert" }),
    "Das meiste in den Regale ist sicher Klumpert. Vermutlich hat "
    "Wassertroepfchen einfach ein zu gutes Herz um sich von vielen Dingen "
    "zu trennen.");

  AddDetail( ({ "dinge" }),
    "Geschenke oder Erinnerungsstuecke, die man vielleicht gar nicht mehr "
    "benoetigt, weil man gewisse Kapitel in seinem Leben abgeschlossen "
    "hat.");

  AddDetail( ({ "geschenke", "erinnerungsstuecke" }),
    "Sowas kann Wassertroepfchen einfach nicht wegwerfen...");

  AddDetail( ({ "leben", "kapitel", "kapiteln" }),
    "Manchmal schliesst man gewisse Kapitel in seinem Leben ab und moechte "
    "sich dennoch nicht von Erinnerungsstuecke trennen.");

  AddDetail( ({ "chaos" }),
    "Irgendwie sieht hier alles sehr chaotisch aus. Obwohl Du das Gefuehl hast "
    "dass hier auch ein Sinn fuer Ordnung versteckt ist. ");

  AddDetail( ({ "sinn", "ordnung" }),
    "Vermutlich weiss Wassertroepfchen hier unten genau, wo sie was findet. "
    "Ganz im Gegensatz zu Dir.");

  AddDetail( ({ "gegensatz" }),
    "Du durchblickst dieses Chaos irgendwie kaum.");

  AddDetail( ({ "hocker" }),
    "Der Hocker ist ein sehr putziges Teil. Er ist klein und violett und "
    "steht genau in der Mitte des Raumes.");

  AddDetail( ({ "teil" }),
    "Meinst Du den Hocker?");

  AddDetail( ({ "mitte" }),
    "Genau in der Mitte des Raumes steht ein kleiner violetter Hocker. "
    "Irgendwie seltsam. Aber Seltsames bist Du hier ja schon gewohnt.");

  AddDetail( ({ "seltsames" }),
    "Man kann sich an fast alles gewoehnen, nicht wahr?! :)");

  AddDetail( ({ "wassertroepfchen" }),
    "Wassertroepfchen hat einfach ein gutes Herz. Hoffentlich kann sie sich "
    "das noch lange Zeit bewahren.");

  AddDetail( ({ "zeit" }),
    "Die vergeht auch immer viel zu schnell...");

  AddDetail( ({ "herz" }),
    "Du musterst Dein eigenes Herz... naja besonders gut ist es nicht mehr.");

  AddDetail( ({ "obere" }),
    "Oben!");

  AddDetail( ({ "gefuehl" }),
    "Etwas in Dir sagt Dir, dass sich Wassertroepfchen hier auskennt.");

  AddDetail( ({ "etwas" }),
    "Etwas ist wohl Deine innere Stimme, die Du nur zu gerne ueberhoerst.");

  AddDetail( ({ "stimme" }),
    "Nichts mehr zu hoeren.");

  AddSound( ({ "stimme" }),
    "Du hoerst leider gar nichts mehr :(");

  AddDetail( ({ "treppe" }),
    "Sie befindet sich im Westen. Wenn Du sie naeher untersuchen moechtest, "
    "dann geh doch einfach hin.");

  AddDetail( ({ "wand" }),
    "Welche?");

  AddDetail( ({ "suedwand", "nordwand", "ostwand" }),
    "Ueberall stehen lauter Regale - alles sehr chaotisch...");

  AddDetail( ({ "ausnahme" }),
    "Nur bei der Westwand steht kein Regal.");

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus Stein. Genau in der Mitte des Raumes steht ein "
    "Hocker, der Dich fasziniert. ");

  AddDetail( ({ "stein" }),
    "Ganz normaler Stein - nichts Aussergewoehnliches!");

  AddDetail( ({ "aussergewoehnlich", "aussergewoehnliches" }),
    "Nichts was an dem Stein aussergewoehnlich ist - wirklich nicht!");

  AddDetail( ({ "blick" }),
    "Auf den ersten Blick kannst Du einige Gegenstaende hier nicht "
    "benennen. Vielleicht hat Wassertroepfchen ja eine sehr dunkle Seite?");

  AddDetail( ({ "dunkle seite", "seite" }),
    "Ob sie wirklich eine dunkle Seite hat? Wohl eher nicht... aber es gibt "
    "hier einiges, dass Du einfach noch nie zuvor gesehen hast. ");
  
  AddDetail( ({ "decke" }),
    "Genauso wie der Boden besteht auch die Decke aus Stein.");

  AddDetail( ({ "gegenstaende" }),
    "In den Regalen tuermen sich einige skurrile Gegenstaende, Glaeser, "
    "Kisten, Dosen, ... So genau willst Du manches aber auch einfach gar "
    "nicht wissen - ist schliesslich nicht Dein Keller!");

  AddDetail( ({ "glaeser" }),
    "Grosse Glaeser, kleine Glaeser, bauchige Glaeser, einfach alles normale "
    "Glaeser, die Du nicht untersuchen willst und damit basta. (Ich bin "
    "naemlich nicht gewillt sie zu beschreiben!");

  AddDetail( ({ "regal", "regale" }),
    "In den Regalen tuermen sich die verschiedensten Sachen - Glaeser, Kisten "
    "Dosen... alles recht chaotisch.");

  AddDetail( ({ "sachen", "sache" }),
    "Meinst Du eine bestimmte Sache?");

  AddDetail( ({ "kisten" }),
    "Ganz viele verschiedene Kisten stehen in den Regalen. Eine rote faellt "
    "Dir irgendwie besonders auf.");

  AddDetail( ({ "kiste" }),
    "Welche denn?");

  AddDetail( ({ "rote kiste" }),
    "Die rote Kiste lacht Dich irgendwie seltsam an. Vielleicht solltest Du "
    "sie einmal oeffnen?");

  AddDetail( ({ "dosen" }),
    "Einige Dosen stehen in den Regalen. Sie sehen fast alle gleich aus - "
    "Metalldose mit Aufdruck. Nur eine unterscheidet sich irgendwie. ");

  AddDetail( ({ "metalldose", "metall" }),
    "Die Dosen sind alle aus Metall.");

  AddDetail( ({ "aufdruck" }),
    "Auf allen Dosen steht: made in silberland.");

  AddDetail( ({ "dose" }),
    "Eine Dose sieht etwas anders aus, als die anderen. Sie hat einen bunten "
    "Schriftzug drauf. ");

  AddDetail( ({ "schriftzug" }),
    "Man kann ihn sicher lesen!");

  AddReadDetail( ({ "schriftzug" }),
    "\n"
    "*******************************\n"
    "*  S l e l e d s h r  Z c e   *\n"
    "*   i b r a n i c e    u k r  *\n" 
    "*******************************\n"
    "\n");
  
  AddDetail( ({ "zuckerdose" }),
    "Sie ist offen, Du kannst sicher hineinkucken!");


// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Hier riechts irgendwie suess.");

  AddSmell( ({ "suesse" }),
    "Du kannst nicht genau riechen, woher die Suesse kommt.");

  AddSmell( ({ "zuckerdose" }),
    "Ui, na die riecht aber nach Zucker!");

  AddSmell( ({ "zucker" }),
    "Suess!");

// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Hier ist es lautlos!");


  AddCmd( ({ "oeffne" }), "c_oeffnen");
  AddCmd( ({ "kuck", "kucke" }), "c_kucken");
  AddCmd( ({ "stell", "stelle" }), "c_stellen");


}

int c_oeffnen(string str)
{
 object ob;
 if(str != "rote kiste" )
 {
  notify_fail("Was moechtest Du hier oeffnen?\n");
  return 0;
 }
 else
 {
  if(anz_loeffel < 1)
  {
   write(BS("Du oeffnest die rote Kiste - sie ist komplett leer. Angefressen "
            "machst Du sie wieder zu. Das war wohl nichts :("));
   say(CTPN+ " oeffnet eine Kiste.\n");
   return 1;
  }
  else
  {
   write(BS("Du oeffnest die rote Kiste und findest einen Gegenstand, den "
            "Du sofort einsteckst."));
   say(CTPN+ " oeffnet eine Kiste und steckt verstohlen etwas ein.\n");
   ob=clone_object(OBJ "loeffel");
   if(ob->move(TP, M_GET) != 1)
   {
    tell_object(TP, "Das ist ja viel zu schwer fuer Dich!\n");
    ob->move(TO, M_NOCHECK);
   }
   anz_loeffel--;
   return 1;
  }
 }
}

int c_kucken(string str)
{
 object zu;
 if( str != "in zuckerdose" )
 { 
  notify_fail("In welche Dose moechtest Du denn kucken?\n");
  return 0;
 }
 else
 {
  if(anz_zucker < 1)
  {
   write(BS("Du schaust in die Zuckerdose - sie ist absolut leer :( Schade!"));
   say(CTPN+ " ist traurig\n");
   return 1;
  }
  else
  {
   write(BS("Du schaust in die Zuckerdose und findest ein Stueck "
            "Wuerfelzucker, dass Du sofort einsteckst."));
   say(CTPN+ " schaut in eine komische Dose.\n");
   zu=clone_object(OBJ "zucker");
   if(zu->move(TP, M_GET) != 1)
   {
    tell_object(TP, "Das kannst Du nicht mehr tragen!\n");
    zu->move(TO, M_NOCHECK);
   }
   anz_zucker--;
   return 1;
  }
 }
}  


int c_stellen(string str)
{
 if( str != "auf hocker" )
 {
  notify_fail("Worauf moechtest Du Dich stellen?\n");
  return 0;
 }
 else
 {
  write(BS("Warum zur Hoelle willst Du Dich auf einen Hocker stellen?! "
           "Nix da!"));
  say(CTPN+ " verhaelt sich seltsam.\n");
  return 1;
 }
}



