


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../carolina.h"

int anz_schafgarbe;

void reset ()
{
 ::reset();
 anz_schafgarbe = 3;
}

void create()
{
  ::create();
  anz_schafgarbe = 3;
  SetProp(P_INT_SHORT, "In einem kleinen Garten");
  SetProp(P_INT_LONG, 
    "Du stehst mitten im Garten. Alles blueht und gedeiht hier wirklich "
    "praechtig. Vorallem die weissen Bluemchen erwecken hier Deine "
    "Aufmerksamkeit. Noerdlich von Dir siehst Du ein weit offen stehendes " 
    "Fenster mit weissen Fensterlaeden, durch das man sicher einen Blick "
    "ins Innere werfen kann. Weiter oestlich steht das Gras etwas hoeher "
    "und manchmal meinst Du ein Funkeln zu sehen.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_PLAIN]) );
  AddExit( "osten", ROOM "garten_e1" );
  AddExit( "westen", ROOM "garten_c1" );


// DETAILBEGINN


  AddDetail( ({ "garten" }),
    "Genau da stehst Du jetzt - mitten im Garten von Wassertroepfchen.");

  AddDetail( ({ "wassertroepfchen" }),
    "Wassertroepfchen ist eine kleine Wasserelfe. Ihr gehoert hier das "
    "Haeuschen und auch der Garten. Wo sie schon wieder steckt?");

  AddDetail( ({ "wasserelfe" }),
    "Wasserelfen unterscheiden sich von Elfen durch ihre Liebe zum Wasser. "
    "Sie sind nicht so die Baumkraxler, wie normale Elfen.");

  AddDetail( ({ "baumkraxler", "kraxler" }),
    "Wassertroepfchen klettert sicherlich nicht so gerne auf Baeume.");
 
  AddDetail( ({ "baeume", "baum" }),
    "Hier siehst Du keine Baeume, aber vielleicht in einem anderen Teil "
    "des Gartens. ");

  AddDetail( ({ "teil" }),
    "Blick Dich ruhig im Garten etwas genauer um.");

  AddDetail( ({ "liebe" }),
    "Die Liebe von der kleinen Wasserelfe gilt sicher vorallem ihren Garten "
    "und natuerlich auch dem Wasser.");

  AddDetail( ({ "elfen", "elf" }),
    "Die normalen Elfen suchst Du besser in Elessar. ");

  AddDetail( ({ "elessar" }),
    "Elessar ist der Wohnort der Elfen. ");

  AddDetail( ({ "wohnort", "ort" }),
    "Von hier aus haeltst Du Dich immer suedwestlich damit Du nach "
    "Elessar kommst.");

  AddDetail( ({ "wasser" }),
    "Hmm... hier ist keines, aber vielleicht woanders?");

  AddDetail( ({ "haeuschen", "haus" }),
    "Das Haeuschen befindet sich genau vor Dir im Norden. Das Fenster steht "
    "weit offen und ermoeglicht Dir sicher den ein oder anderen Blick. ");

  AddDetail( ({ "blick" }),
    "Du kannst sicher einen Blick ins Haeuschen werfen.");

  AddDetail( ({ "fenster" }),
    "Die weissen Fensterlaeden stehen weit offen und ermoeglichen Dir ins "
    "Haeuschen zu blicken. ");

  AddDetail( ({ "fensterlaeden", "laeden" }),
    "Die Fensterlaeden wurden anscheinend erst kuerzlich weiss gestrichen. Sie "
    "glitzern foermlich im Sonnenlicht. ");

  AddDetail( ({ "glitzern" }),
    "An einer Stelle ist das Glitzern besonders stark ausgeprägt. Seltsam.");

  AddDetail( ({ "stelle" }),
    "Am Rahmen eines Fensterladens gibt es eine Stelle, die besonders stark "
    "glitzert. ");

  AddDetail( ({ "rahmen" }),
    "So wie sie aussehen wurden sie erst vor kurzem neu gestrichen - eine "
    "entsetzliche Arbeit. Zuerst muss man die Laeden abschleifen und danach "
    "in einem Zug fein saeuberlich lackieren.");

  AddDetail( ({ "arbeit" }),
    "Fensterlaeden streichen ist eine ganz schoen muehsame Arbeit - aehnlich "
    "dem Fensterputzen...");

  AddDetail( ({ "putzen", "fensterputzen" }),
    "Zum Glueck gehoert das Haeuschen nicht Dir. Es reicht wenn man in seiner "
    "eigenen Wohnung einmal im Jahr die Fenster putzen muss *gg*");

  AddDetail( ({ "glueck" }),
    "Ausnahmsweise hast Du hier mal wirklich Glueck gehabt. Aber ist es nicht "
    "schon hoechste Zeit in Deinem Seherhaus mal die Fenster zu putzen?");

  AddDetail( ({ "seherhaus" }),
    "Hast Du keines?");

  AddDetail( ({ "fensterladen", "laden" }),
    "Eine bestimmte Stelle des Fensterladens glitzert besonders stark. "
    "Woher das wohl kommt?");

  AddDetail( ({ "bestimmte stelle" }),
    "Es duerfte sich um einen Tautropfen handeln, der das Sonnenlicht "
    "reflektiert.");

  AddDetail( ({ "tropfen", "tautropfen" }),
    "Bloss ein simpler Tautropfen");

  AddDetail( ({ "sonnenlicht", "licht", "sonne" }),
    "Die Sonne ist ganz hoch am Himmel.");

  AddDetail( ({ "boden" }),
    "Du stehst im Gras.");

  AddDetail( ({ "gras" }),
    "Ueberall gruenes Gras, nirgends ein Fleckchen braun. Dazwischen wachsen "
    "einige weisse Blumen.");

  AddDetail( ({ "innere", "inneres" }),
    "Schau doch einfach ins Haus hinein!");

  AddDetail( ({ "himmel" }),
    "Der Himmel ist ganz hellblau - sieht nach einem sehr sonnigen Tag aus.");

  AddDetail( ({ "tag" }),
    "In der Tat - es ist ein ausgesprochen sonniger Tag heute. Sicherlich "
    "muss man abends den Garten ausreichend giessen, damit das Gras "
    "auch weiterhin so gruen bleibt.");

  AddDetail( ({ "tat" }),
    "Es ist wirklich sonnig - ob Dir das jetzt gefaellt oder nicht.");

  AddDetail( ({ "gruen" }),
    "Das Gras strahlt in einem sehr saftigen Gruen. Kein einziger brauner "
    "Fleck ist zu sehen. Anscheinend wird hier immer viel gegossen, damit "
    "alles auch weiterhin so gruen bleibt. ");

  AddDetail( ({ "fleck", "fleckchen" }),
    "Keines zu sehen! Hoffentlich bleibt das auch so!");

  AddDetail( ({ "blumen", "bluemchen" }),
    "Weisse etwas hoehere Blumen wachsen zwischen den Grashalmen.");

  AddDetail( ({ "grashalme", "halme" }),
    "Mehrere Grashalme zusammen bilden das Gras.");

  AddDetail( ({ "weisse blumen", "weisse blume" }),
    "Die weissen Blumen haben doldenartige Blueten und einen zaehen "
    "Staengel. Sie kommen Dir sehr bekannt vor, ob man sie pfluecken kann?");

  AddDetail( ({ "weisse bluemchen" }),
    "Ob es sich hierbei um Schafgarben handelt?");

  AddDetail( ({ "aufmerksamkeit" }),
    "Die Blumen kommen Dir bekannt vor. Ob sie fuer etwas nuetzlich sind?");

  AddDetail( ({ "funkeln" }),
    "Das Funkeln kommt aus dem Osten. Als ob sich irgendetwas im Wasser "
    "spiegeln wuerde. Leider kann man von hier nichts Naeheres erkennen.");

  AddDetail( ({ "naeheres" }),
    "Geh doch mal nach Osten!");


// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Du hoerst ein leises Summen. ");

  AddSound( ({ "summen" }),
    "Vermutlich kommt das Summen von ein paar Bienen.");

  AddDetail( ({ "bienen" }),
    "Sehen kannst Du keine, aber vielleicht hoeren?");

  AddSound( ({ "bienen", "biene" }),
    "*summ* *summ* *summ*\n"
    "Du pfeifst: Summ summ summ Bienchen summ herum.");

  AddSound( ({ "bienchen" }),
    "Du lauscht Deinem eigenen Pfeifen.");

  AddSound( ({ "pfeifen" }),
    "Summ, summ, summ - Bienchen summ herum.");


// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Es riecht nach Gras und Blumen.");

  AddSmell( ({ "gras", "blumen" }),
    "Kurz gesagt: hier riechts einfach nach Garten!");

  AddSmell( ({ "garten" }),
    "Der suesse Geruch der Blumen vermischt sich mit dem kraeftigen des Gras.");

  AddSmell( ({ "geruch" }),
    "Wirklich ein typischer Gartengeruch.");

  AddSmell( ({ "gartengeruch" }),
    "Wenn Du nicht weisst wie es in einem Garten riecht, dann empfehl ich "
    "Dir wirklich, dass Du Deinen Popo mal vom Rechner in die Natur bewegst.");

  AddSmell( ({ "natur" }),
    "Vermutlich wuerd es reichen, wenn Du das Fenster aufmachst, damit Du "
    "die Natur riechen kannst. ");

  AddSmell( ({ "fenster" }),
    "Du riechst am Fenster - es riecht nach Rosen.");

  AddSmell( ({ "rosen" }),
    "Hmmmm... gut!");

  AddSmell( ({ "popo" }),
    "Ich bezweifle dass Du wirklich an Deinem Popo riechen magst.");

  AddSmell( ({ "rechner" }),
    "Clementine hat keine Lust mehr dieses Detail zu beschreiben.");

  AddSmell( ({ "lust", "detail" }),
    "Nope!");
 
  AddSmell( ({ "clementine" }),
    "Clementine riecht immer nach Laura. ");

  AddSmell( ({ "laura", "biagotti" }),
    "Laura Biagotti!"); 


  AddSpecialDetail( ({ "osten" }), "ostfun");

  AddCmd( ({ "pflueck", "pfluecke" }), "c_pfluecken");
  AddCmd( ({ "wirf", "werf", "werfe" }), "c_werfen");
  AddCmd( ({ "blick", "blicke" }), "c_blicken");

}

string ostfun(string str)
{
 TP->command_me("osten");
 return "";
}

int c_pfluecken (string str)
{
 object ob;
 if( str != "schafgarbe" )
 {
  notify_fail("Wie heisst die Pflanze, die Du pfluecken moechtest?\n");
  return 0;
 }
 else
 {
  if(anz_schafgarbe < 1)
  {
   write(BS("Momentan findest Du keine Schafgarbe die Du pfluecken "
            "moechtest. Vielleicht probierst Du es etwas spaeter wieder."));
   return 1;
  }
  else
  {
   write(BS("Vorsichtig pflueckst Du eine Schafgarbe."));
   say(CTPN+ " pflueckt eine weisse Blume.\n");
   ob = clone_object(OBJ "schafgarbe");
   if(ob->move(this_player(), M_GET) != 1)
   {
    tell_object(this_player(), "Das kannst Du nicht mehr tragen!\n");
    ob->move(this_object(), M_NOCHECK);
   }
   anz_schafgarbe--;
   return 1;
  }
 }
}

int c_werfen(string str)
{
 if( str != "blick ins haus" )
 {
  notify_fail("Was moechtest Du wohin werfen?\n");
  return 0;
 }
 else
 {
  write(BS("Wieso Deinen Blick werfen, wenn Du normal ins Haus blicken "
           "kannst?"));
  return 1;
 }
}

int c_blicken(string str)
{
 object ob;
 if( str != "in haus" &&
     str != "durch fenster" &&
     str != "durchs fenster" &&
     str != "ins haus" &&
     str != "ins bad" )
 {
  notify_fail("Wohin moechtest Du blicken?\n");
  return 0;
 }
 else
 {
  ob = ROOM "bad"->int_long(TP, TO, 2);
  write("Du siehst durchs Fenster:\n"+ob);
  say(CTPN + " kuckt sich das Badezimmer an.\n"); 
  return 1;
 }
}
 

