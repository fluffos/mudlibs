
// brennesseln hier fuern tee ,)


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include "../carolina.h"


int anz_brennesseln;

void reset()
{
  ::reset();
  anz_brennesseln = 2;
}


void create()
{
  ::create();
  anz_brennesseln = 2;
  SetProp(P_INT_SHORT, "In einem kleinen Garten");
  SetProp(P_INT_LONG, 
    "Durch ein geoeffnetes Fenster im Sueden kannst Du direkt in "
    "Wassertroepfchens Kueche sehen. Das Dach des Hauses spendet hier etwas "
    "mehr Schatten, als anderswo im Garten. Genau die richtigen Bedingungen "
    "fuer einige wilde Pflanzen um gut zu gedeihen. Weiter im Osten steht "
    "ein grosser Baum, der Deine Aufmerksamkeit erregt. Ein angenehmer Duft "
    "scheint aus dem Haus zu kommen. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_PLAIN]) );
  AddExit( "westen", ROOM "garten_c4" );
  AddExit( "suedosten", ROOM "garten_e3" );
 
  AddItem(NPC "schmetterling", REFRESH_DESTRUCT);

// DETAILBEGINN

  AddDetail( ({ "raum", "garten" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "groesse" }),
    "Ein wirklich praechtiges Exemplar.");

  AddDetail( ({ "exemplar" }),
    "Ein ziemlich grosser Baum!");

  AddDetail( ({ "himmel" }),
    "Noch immer steht die Sonne hoch am Himmel. Hier spendet aber zum "
    "Glueck das Dach des Hauses ein wenig Schatten.");

  AddDetail( ({ "sonne" }),
    "Die Sonne ist ueber Dir und strahlt auf Dich runter.");

  AddDetail( ({ "boden" }),
    "Ueberall waechst das Gras am Boden - gruene lange Halme - Gras!");

  AddDetail( ({ "gras" }),
    "Tausende von Grashalmen bilden den Untergrund unter Deinen Fuessen. "
    "Manche sind etwas laenger, andere kuerzer, aber eines haben sie alle "
    "gemein: die Farbe. ");

  AddDetail( ({ "farbe" }),
    "Die Grashalme sind alle gruen! Grasgruen! ");

  AddDetail( ({ "grasgruen", "gruen" }),
    "Die Halme sind wirklich alle grasgruen!");

  AddDetail( ({ "grashalm", "grashalme", "halme", "halm" }),
    "Viele viele Grashalme stehen auf der Wiese. ");

  AddDetail( ({ "wiese" }),
    "Na wo glaubst Du, dass Du grad stehst?! Auf einem Berg?!");

  AddDetail( ({ "berg" }),
    "Wo ist einer?");




  AddDetail( ({ "brennessel", "brennesseln" }),
    "Erst jetzt fallen Dir die Brennesseln auf, die direkt vor dem "
    "Kuechenfenster wachsen. "); // pfluecken/ausreissen mit handschuhe!

  AddDetail( ({ "duft" }),
    "Sehen kannst Du den Duft nicht, aber wie waers mit riechen?");

  AddDetail( ({ "osten" }),
    "Weiter im Osten steht hinter einem dichten Buschwerk ein grosser Baum. "
    "Ob man durch die dichtwachsenden Buesche kommt?");

  AddDetail( ({ "buschwerk", "buesche" }),
    "Die Buesche sind dicht gedraengt und wachsen teilweise auch ineinander. "
    "Ein Durchzwaengen erscheint Dir ziemlich aussichtslos.");

  AddDetail( ({ "durchzwaengen" }),
    "Du siehst eigentlich keine Moeglichkeit durch die Buesche zu kommen.");

  AddDetail( ({ "moeglichkeit" }),
    "Keine da... oder etwa doch?");

  AddDetail( ({ "schrammen" }),
    "AUA!");

  AddDetail( ({ "aufmerksamkeit" }),
    "Durch seine Groesse ist der Baum im Osten gar nicht zu uebersehen. "
    "Auch wenn Du von hieraus nicht seinen ganzen Stamm sehen kannst, "
    "neugierig bist Du dennoch.");

  AddDetail( ({ "stamm" }),
    "Der Stamm des Baumes wird von dem dichten Buschwerk verdeckt.");

  AddDetail( ({ "fenster", "kuechenfenster" }),
    "Das Fenster im Sueden ist geoeffnet und laesst sicher den einen "
    "oder anderen Blick in Wassertroepfchens Kueche zu." );

  AddDetail( ({ "kueche" }),
    "Die befindet sich suedlich von Dir.");

  AddDetail( ({ "blick" }),
    "Blick doch einfach durch das Fenster!");

  AddDetail( ({ "wassertroepfchen" }),
    "Wo diese kleine Wasserelfe schon wieder ist? Vielleicht solltest Du "
    "sie einfach mal rufen.");

  AddDetail( ({ "wasserelfe" }),
    "Hier ist sie nicht.");

  AddDetail( ({ "dach" }),
    "Das Dach vom Haus steht an diesem Punkt des Gartens etwas ueber und "
    "bietet daher mehr Schatten als in anderen Teilen "
    "des Gartens. Wirklich ideale Bedingungen fuer einige wildwachsende "
    "Pflanzen um hier zu gedeihen.");

  AddDetail( ({ "bedingungen", "bedingung" }),
    "Die Bedingungen sind hier fuer einige Pflanzen ideal, da das Dach "
    "des Hauses in diesem Teil des Gartens mehr Schatten spendet, als in "
    "anderen. ");

  AddDetail( ({ "pflanzen" }),
    "Hier gibt es einige Pflanzen. Suchst Du eine bestimmte?");

  AddDetail( ({ "pflanze", "bestimmte" }),
    "Welche meinst Du?");

  AddDetail( ({ "punkt" }),
    "Du befindest Dich gerade im nordoestlichen Teil des Gartens.");

  AddDetail( ({ "untergrund" }),
    "Damit meinst Du wohl den Boden?!");

  AddDetail( ({ "fuesse", "fuss" }),
    "Keine Sorge! Deine Fuesse stinken wie immer! Vermutlich fluechten "
    "deswegen auch alle Ameisen vor Dir.");

  AddDetail( ({ "ameisen", "ameise" }),
    "Alle auf der Flucht vor Dir!");

  AddDetail( ({ "flucht" }),
    "Beinahe mit Lichtgeschwindigkeit krabbeln die Ameisen vor Dir davon.");

  AddDetail( ({ "lichtgeschwindigkeit", "geschwindigkeit" }),
    "Schwupps, und schon sind alle Ameisen weg.");

  AddDetail( ({ "glueck" }),
    "Glueck hat man, oder nicht. Thats life. Ich hab keines :)");

  AddDetail( ({ "life" }),
    "So schauts halt aus :)");

  AddDetail( ({ "sorge", "sorgen" }),
    "Bloss keine Sorgen haben! Nuetzt ja ohnehin nichts!");

  AddDetail( ({ "baum" }),
    "Der Baum steht im Osten!");

  AddDetail( ({ "osten" }),
    "Von Dir aus: rechts!");

  AddDetail( ({ "schatten" }),
    "Das Dach des Hauses bietet etwas Schatten. Richtig angenehm kuehl ist es "
    "hier! Vielleicht solltest Du etwas rasten, bevor Du zu neuen "
    "Erkundungen aufbrichst.");

  AddDetail( ({ "erkundungen" }),
    "Willst Du nicht den schoenen Garten weiter erkunden?");

  AddDetail( ({ "teil", "teile" }),
    "Der Garten besteht aus mehreren Teilen. Hier ist der nordoestlichste.");

  AddDetail( ({ "nordoestlichste", "nordoestlicher" }),
    "Na hier!");

  AddDetail( ({ "haus" }),
    "Das Haus steht suedlich von Dir.");
    

// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Du vernimmst ein leises Krabbeln im Gras. ");

  AddSound( ({ "krabbeln" }),
    "Vermutlich kommt es von irgendwelchem Kleintier.");

  AddSound( ({ "kleintier" }),
    "Sehen kannst Du nichts, aber Du vermutest, dass Du irgendwelchen "
    "Kaefer aufgeschreckt hast, die nun das Weite suchen.");

  AddSound( ({ "weite" }),
    "Nicht alles was man gross schreibt kann untersucht oder erlauscht "
    "werden!");

  AddSound( ({ "kaefer" }),
    "Wie schon gesagt - geschrieben: Sehen kannst Du nichts, aber Du hoerst "
    "ein Krabbeln.");


// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Ein angenehmer Duft kommt aus dem Haus.");

  AddSmell( ({ "duft" }),
    "Hier riechts nach Essen! Mjamm!");

  AddSmell( ({ "essen" }),
    "Ob ihm Haus gerade gekocht wird? ");

  AddSmell( ({ "haus" }),
    "Am Haus riechen? Sicher? Nein!");


// COMMANDS


  AddCmd( ({ "zwaeng", "zwaenge" }), "c_zwaengen"); 
  AddCmd( ({ "geh", "gehe" }), "c_gehen");
  AddCmd( ({ "blick", "blicke" }), "c_blicken");
  AddCmd( ({ "reiss", "reisse" }), "c_reissen");

}

int c_zwaengen(string str)
{
 if( str != "durch buschwerk" &&
     str != "durch buesche")
 {
  notify_fail("Wodurch moechtest Du Dich zwaengen?\n");
  return 0;
 }
 else
 {
  write(BS("Beim Versuch Dich durch die Buesche zu zwaengen ziehst Du Dir "
           "leider nur einige Schrammen zu."));
  TP->do_damage(20+random(10), TO);
  return 1;
 }
}

int c_gehen(string str)
{
 if( str != "naeher zu fenster"  &&
     str != "naeher an fenster ran" &&
     str != "naeher an fenster"  &&
     str != "naeher zum fenster" )
 {
  notify_fail("Wohin moechtest Du naeher gehen?\n");
  return 0;
 }
 else
 {
  write(BS("AUAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA!\n"
           "Beim Versuch naeher zum Fenster zu gehen steigst Du voll "
           "in die Brennesseln."));
  TP->do_damage(10+random(5), TO);
  return 1;
 }
}

int c_blicken(string str)
{
 if(str != "durch fenster" )
 {
  notify_fail("Wodurch moechtest Du blicken?\n");
  return 0;
 }
 else
 {
  write(BS("Du musst schon naeher zum Fenster gehen um durchblicken zu "
           "koennen."));
  return 1;
 }
}

int c_reissen(string str)
{
 mixed ob;
 object brenn;
 if( str != "brennessel aus"    &&
     str != "brennesseln aus" )
 {
  notify_fail("Was moechtest Du hier ausreissen?\n");
  return 0;
 }
 else
 {
  if(anz_brennesseln < 1)
  {
   write(BS("Momentan ist keine Brennessel da, die Du ausreissen moechtest."));
   return 1;
  }
  else
  {
   ob=TP->QueryArmours(AT_GLOVE);
   if((pointerp(ob)  && sizeof(ob)>0))
   {
    write(BS("Du reisst eine Brennessel aus. "));
    brenn = clone_object(OBJ "brennessel");
    if(brenn->move(TP, M_GET) != 1)
    {
     tell_object(TP, "Das kannst Du nicht mehr tragen!\n");
     brenn->move(TO, M_NOCHECK);
    }
    anz_brennesseln--;
    return 1;
   } 
    
   else 
   {
    write(BS("Du reisst eine Brennessel mit blossen Haenden aus."
             "AUAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA!" ));
    TP->do_damage(29);
    brenn = clone_object(OBJ "brennessel");
    if(brenn->move(TP, M_GET) != 1)
    {
     tell_object(TP, "Das kannst Du nicht mehr tragen!\n");
     brenn->move(TO, M_NOCHECK);
    }
    anz_brennesseln--;
    return 1;
   }
  }
 }
}
 
