inherit "std/mnpc";
inherit "std/npc/spells";

#include <class.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include <combat.h>
#include "../carolina.h"

void create()
{
 if (!is_clone(TO))
 return;

  ::create();

  SetProp(P_SHORT, "Ein Marienkaefer");
  SetProp(P_LONG, 
    "Ein suesser Marienkaefer fliegt vor Dir in der Luft herum. Er hat einen "
    "roten Panzer auf dem sich sieben schwarze Punkte befinden. ");
  SetProp(P_NAME, "Marienkaefer");
  SetProp(P_GENDER, MALE);
  
  create_default_npc(5);
  SetProp(P_HANDS, ({ " mit seinen Beinchen", QueryProp(P_HANDS)[1],
          DT_BLUDGEON }) );
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_ALIGN, 0);
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 1);
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0,
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );
  SetProp(P_REJECT, ({ REJECT_DROP,
    "Der Marienkaefer dreht eine Runde.\n" }) );

  AddId( ({ "marienkaefer", "kaefer" }) );

  SetProp(P_MSGIN, "fliegt herein" );
  SetProp(P_MSGOUT, "fliegt" );
  SetProp(P_MMSGIN, "fliegt herein" );
  SetProp(P_MMSGOUT, "fliegt nach" );

  SetProp(P_MNPC_AREA, ROOM);
  SetProp(P_MNPC_FLAGS,
           MOV_INDOORS+MOV_OUTDOORS+MOV_MOVES+MOV_SPECIAL );
  SetProp(P_MNPC_WAIT, ({40, 30, random(20)}) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "tor" );

  SetChats(3,
    ({ "Der Marienkaefer putzt seine Punkte.\n",
       "Der Kaefer fliegt eine Runde ueber Deinem Kopf.\n",
       "Der Koerper des Marienkaefers schimmert roetlich im Sonnenlicht.\n"
     }) );

  SetProp(P_DEFAULT_INFO, "fliegt eine Runde.\n");

}


