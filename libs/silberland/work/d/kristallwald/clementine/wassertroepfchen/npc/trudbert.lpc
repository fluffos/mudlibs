
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <class.h>
#include "../carolina.h"

void create()
{
 if (!is_clone(TO))
 return;

  ::create();

  SetProp(P_SHORT, "Trudbert, der Maulwurf");
  SetProp(P_LONG, 
    "Das ist Trudbert, der Maulwurf. Er sitzt auf einem Hocker hinter der "
    "Bar, da er nicht unbedingt der Groesste ist. Das markanteste an "
    "Trudbert ist wohl die Brille, die auf seiner Nase thront. "
    "Ausserdem besitzt er zwei Schaufeln, mit denen er immer wieder "
    "ein bisschen Erde beiseite schaufelt, die von der Decke broeckelt. "
    "Sonst nutzt er diese natuerlich, um seine Gaeste zu bedienen. ");
  SetProp(P_NAME, "Trudbert");
  set_living_name( "trudbert");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Maulwurf");
  AddId( ({ "trudbert", "maulwurf" }) );

  create_default_npc(10);
  SetProp(P_ALIGN, 0);
  SetProp(P_FRIEND, 1);
  SetProp(P_SIZE, 20);  
  SetProp(P_NOATTACK, "vergraebt sich in der Erde, und kommt "
     "kurze Zeit spaeter wieder zum Vorschein. ");
  SetProp(P_HANDS, ({ " mit seinen schmutzigen Schaufeln", 
			  QueryProp(P_HANDS)[1], DT_BLUDGEON}) );
  SetProp(P_MURDER_MSG, "Na warte nur bis Du unter der Erde liegst!\n");
  SetProp(P_KILL_NAME, "Trudbert");
  SetProp(P_KILL_MSG, "Unter der Erde, ja da ists fein!\n");  
  SetProp(P_REJECT, ({ REJECT_KEEP,
     "Trudbert nickt Dir freundlich zu.\n"}) );       
  SetProp(P_LOG_INFO, "/clementine/trudbert");  

// INFOS !!!

  SetProp(P_DEFAULT_INFO, ({
    "scheint Dich nicht gehoert zu haben.\n",
    "hoert irgendwie schlecht.\n",
    "wirkt geistig abwesend.\n",
    "sagt: Wos is? Du muast scho lauta redn!\n",
    "sagt: Na wos was i!\n",
    "sagt: Na i hab ka Klo hia! Geh ausse wennst muast!\n",
    "sagt: Jo mei so is Lebn!\n",
    "sagt: Jo gibt hoit vue geistige Nackerbatzerln!\n" }) );

  AddInfo( ({ "schwammerlragout", "ragout" }),
    "sagt: Des wird nach an oidn Maulwurfsrezept gmocht..\n");

  AddInfo( ({ "berta", "frau", "ehefrau", "maulwurfsdame" }),
    "laechelt gequaelt.");

  AddInfo( ({ "geistige nackerbatzerln", "nackerbatzerl" }),
    "sagt: So is es!\n");

  AddInfo( ({ "maulwurfrezept", "rezept", "maulwurfsrezept" }),
    "sagt: Alles strengstens geheim - is eh kloa!\n");

  AddInfo( ({ "clementine" }),
    "tratscht: Na des Weib kann ganz schoe stressn.\n");


  AddInfo( ({ "weib" }),
    "sagt: Nichts fuer ungut, aba mein Fall is ned.\n");

  AddInfo( ({ "sex" }),
    "fragt: Wos is mit meina Ex?\n");

  AddInfo( ({ "ex" }),
    "sagt: Na wennst di host, brauchst kane Feind mehr!\n");

  AddInfo( ({ "feind", "feinde" }),
    "Wos is mit ana Gemeinde?", "fragt: ");

  AddInfo( ({ "gemeinde" }),
    "sagt: Frag wen andan!\n");

  AddInfo( ({ "lebn", "leben" }),
    "sagt: Wos is mit mein Lebn?\n");

  AddInfo( ({ "brille" }),
    "sagt: Na ohne die siech i nix!\n");
 
  AddInfo( ({ "schaufeln", "schaufl", "schaufel" }),
    "sagt: Wofuer brauchstn Du a Schaufl? Magst in da Sandkistn buddln?\n");

  AddInfo( ({ "sandkistn", "sandkiste" }),
    "sagt: Na oiso bei mir unta da Erd is ka Sandkistn!\n");

  AddInfo( ({ "erde", "erd" }),
    "sagt: Wos soi los sein mit da Erd? Erdig is hoit!\n");

  AddInfo( ({ "justavius", "angrox" }),
    "sagt: Jo mei.\n");

  AddInfo( ({ "arnold" }),
    "sagt: Na des is a Gfrastsackl.\n");

  AddInfo( ({ "gfrastsackl" }),
    "sagt: Da Mista Terminaaaeedor.\n");

  AddInfo( ({ "frosch" }),
    "sagt: Wo is a Frosch? I siech bissl schlecht.\n");

  AddInfo( ({ "wasserelfe", "wassertroepfchen" }),
    "schwaermt: Jo des is a liabs Maedl!\n");

  AddInfo( ({ "maedl", "maedchen" }),
    "sagt: So a entzueckendes Puppal.\n");

  AddInfo( ({ "puppe", "puppal", "pupperl" }),
    "sagt: I glaub die is scho vergebn.\n");

  AddInfo( ({ "ausgang" }),
    "sagt: Na da issa eh!\n");

  AddInfo( ({ "grassalat", "salat", "gras" }),
    "sagt: Mei Salat is aus biologischem Gras!\n");

  AddInfo( ({ "nektar" }),
    "sagt: Magst a Glasal?\n");

  AddInfo( ({ "saft", "brennesselsaft" }),
    "sagt: Na der is wirklich lecka!\n");

  AddInfo( ({ "tee", "hagebuttentee" }),
    "sagt: Ja der is ganz heiss!\n");

  AddInfo( ({ "heiss" }),
    "sagt: Wos is mit an Eis?\n");

  AddInfo( ({ "eis" }),
    "sagt: Hab i kans.\n");

  AddInfo( ({ "auflauf", "gaensebluemchenauflauf" }),
    "sagt: Den solltast amoi kostn!\n");

  




}
