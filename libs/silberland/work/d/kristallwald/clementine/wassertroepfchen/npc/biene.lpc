
//***********************************//
//                                   //
// Sargolas Biene entsprechend fuer  //
// Wassertroepfchen abgewandelt.     //
//                                   //
// Clementine@SL                     //
//                                   //
//***********************************//

inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moving.h>
#include <class.h>
#include <mnpc.h>
#include "../carolina.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Eine Biene");
  SetProp(P_LONG, 
     "Die Biene schwirrt mit surrenden Fluegeln von Bluete zu Bluete "
     "und sammelt Bluetenstaub. ");
  SetProp(P_NAME, "Biene");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "biene" }) );

  create_default_npc(4);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HANDS, ({" mit ihrem Stachel", 20, DT_POISON }) );
  SetProp(P_ALIGN, 50);
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 4);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:     -0.2, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:   -0.4, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );

  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
     "Die Biene schwirrt um Deine Nase herum.\n" }) );

  AddClass(CL_FLYING);


  SetProp(P_MSGOUT, "brummt weiter");
  SetProp(P_MSGIN, "brummt herein");
  SetProp(P_MMSGIN, "brummt munter herein");
  SetProp(P_MMSGOUT, "brummt munter weiter");

  SetProp(P_MNPC_AREA, ROOM);
  SetProp(P_MNPC_DEFAULTROOM, ROOM "garten_a3" );
  SetProp (P_MNPC_WAIT, ({1,30,30}));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS+MOV_MOVES);

  SetChats(4,
	({ "Der Biene summt eine lustige Melodie.\n",
	   "Die Biene sucht nach Nektar.\n",
	   "Die Biene schwirrt einmal um Dich herum.\n" }) );
  
  

//  clone_object(WEAPON+"bstachel")->move(TO);
//  command_me("zuecke stachel");

}


