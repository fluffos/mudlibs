inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <class.h>
#include "../carolina.h"

void create()
{
 if (!is_clone(TO))
 return;

  ::create();

  SetProp(P_SHORT, "Eine kleine Libelle");
  SetProp(P_LONG, 
    "Eine kleine Libelle sitzt vor Dir auf einem Stein. ");
  SetProp(P_NAME, "Libelle" );
  set_living_name( "libelle" );
  SetProp(P_NAME_ADJ, "klein" );
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "libelle" }) );
  
  create_default_npc(5);
  AddClass(CL_FLYING);
  SetProp(P_RACE, "Insekt" );
  SetProp(P_ALIGN, 200);
  SetProp(P_HANDS, ({ " mit ihren Fluegeln", QueryProp(P_HANDS)[1],
                      DT_BLUDGEON }) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:   -0.6, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );
  
  SetProp(P_MSGIN, "landet in Deiner Naehe");
  SetProp(P_REJECT, ({ REJECT_DROP,
    "Die kleine Libelle erhebt sich in die Luefte, und landet kurze Zeit "
    "spaeter auf einem Blatt.\n" }) );

  SetChats(4, ({
    "Die kleine Libelle sitzt fast regungslos auf einem Blatt.\n",
    "Die Libelle putzt ihre Fluegel.\n",
    "Die Fluegel der Libelle schimmern bunt im Licht.\n" }) );

  SetProp(P_DEFAULT_INFO, "surrt.\n");
  SetProp(P_SOUND, "Du hoerst ein leises Surren.\n");
}

