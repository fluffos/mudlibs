inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <class.h>
#include "../carolina.h"

void create()
{
 if (!is_clone(TO))
 return;

  ::create();

  SetProp(P_SHORT, "Berta");
  SetProp(P_LONG, 
    "Das ist Berta, Trudberts Frau. Selbst fuer eine Maulwurfdame "
    "ist sie etwas zu gross und breit geraten. Ob das wohl immer schon "
    "so war? Vermutlich bekommt ihr einfach das Essen hier so gut... " 
    "Irgendetwas sagt Dir, dass mit ihr nicht gut Kirschenessen ist. ");
  SetProp(P_NAME, "Berta");
  set_living_name( "berta");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_RACE, "Maulwurf");
  AddId( ({ "berta", "maulwurf", "maulfwurfdamte", "maulwurfsdame", "frau", 
			 "ehefrau" }) );

  create_default_npc(30);
  SetProp(P_ALIGN, 0);

  SetProp(P_FRIEND, 0);
  SetProp(P_SIZE, 20);  
  SetProp(P_HANDS, ({ " mit ihren schmutzigen grossen Schaufeln", 
                          QueryProp(P_HANDS)[1], DT_BLUDGEON}) );
  SetProp(P_MURDER_MSG, "Na warte nur bis Du unter der Erde liegst!\n");
  SetProp(P_KILL_NAME, "Berta");
  SetProp(P_KILL_MSG, "Unter der Erde, ja da ists fein!\n");  
  SetProp(P_REJECT, ({ REJECT_KEEP,
     "Berta nickt Dir freundlich zu.\n"}) );       
  SetProp(P_LOG_INFO, "/clementine/berta");  


// INFOS !!!

 SetProp(P_DEFAULT_INFO, ({
    "stopft sich gerade mit Schwammerlragout voll.\n",
    "schmatzt so laut, dass sie Dich nicht hoert.\n",
    "ist gerade mit Essen beschaeftigt.\n",
    "sagt: Mit Dir Dolm red i ned!\n",
    "sagt: Na wos was i!\n",
    "sagt: Mei Mann, der hert schlecht!\n",
    "sagt: Geh verschwind!\n",
    "sagt: Jo jo! So is des!\n",
    "sagt: Wirst scho recht hobn!\n",
    "sagt: Frog mein Mann!\n" }) );


  SetChats(8, ({
    "Berta sagt: Mei Mann! Der hert scho schlecht!\n",
    "Berta sagt: Kumm, iss wos!\n",
    "Berta sagt: Geh iss wos, schaust schlecht aus!\n",
    "Berta fragt: Mogst nix essen?\n",
    "Berta stopft sich was zum Essen in den Mund.\n",
    "Berta sagt: I hob scho an Hunger!\n",
    "Berta sagt: i kenntat immer essen!\n",
    "Berta sagt: Mei Mann, der hert am goar ned zu!\n",
    "Berta sagt: Jo, jo, frueher woar ois besser!\n",
    "Berta sagt: I glaub Trudbert wue mi goar ned hern!\n",
    "Berta fragt: Heast ma eh zua?\n",
    "Berta sagt: Du solltast scho mehr essen!\n",
    "Berta sagt: Du bist vue zduenn! Iss wos!\n",
    "Berta fragt Trudbert wann das Essen endlich fertig ist.\n",
    "Berta kaut an einem Schwammerl.\n",
    "Berta sagt: Geh Trudbert, moch ma wos zum Essn!\n",
    "Berta sagt: Trudbert wue ma ned zuhern!\n" 
    "Du denkst. o O (i a ned!)\n",
    "Berta sagt: TRUDBERT! HER MA ZUA!\n",
    "Du denkst. o O (armer Trudbert! Bei so einer Frau!)\n" }) );


  AddInfo ( ({ "trudbert", "ehemann" }),
    "sagt: Jo des is mei Mann.");

  AddInfo( ({ "essen" }),
    "sagt: I iss fuer mei Lebn gern.");

  AddInfo( ({ "berta" }),
    "sagt: Des bin i!");

  AddInfo( ({ "zucker", "dose", "zuckerdose" }),
    "sagt: Wos is mim Zucker?");

  AddInfo( ({ "wasserelfe", "wassertroepfchen", "elfe" }),
    "sagt: Die wohnt ganz in da Naehe!");  

  AddInfo( ({ "kirschenessen" }),
    "Mit mir konnst ned Kirschnessn! I tatat da ois wegessn! ",
    "sagt: ");

  AddInfo( ({ "frueher", "alte zeiten", "damals" }),
    "sagt: Frueha woa ois bessa!");


// SPELLDINGENS


  SetProp(P_SPELLRATE, 60);

  AddDefaultSpell(1, 180, DS_POISON,
    "Berta steckt Dir ein giftiges Schwammerl in den Mund!\n",
    "Berta steckt @WEM ein giftiges Schwammerl in den Mund!\n" );  

  AddSpell(6, 380, 
     "Berta haut sich mit ihrem ganzen Koerper auf Dich drauf!\n",
     "Berta zerquetscht @WEM unter ihrem Koerper.\n", DT_SQUEEZE,
     ([SP_SHOW_DAMAGE:1]) );

  AddSpell(7, 120,
      "Berta quatscht Dich fast zu Tode!\n",
      "Berta quatscht @WEM fast zu Tode!\n", DT_SOUND, 
      ([SP_SHOW_DAMAGE:1]) );

  AddSpell(8, 100,
     "Berta wuergt Dich mit ihren dicken Schaufeln!\n",
     "Berta wuergt @WEM mit ihren dicken Schaufeln!\n",
     DT_BLUDGEON,  ([SP_SHOW_DAMAGE:1]) );



  SetAttackChats(4, ({
     "Berta sagt: I zerquetsch Di gleich!\n",
     "Berta haut sich was zum Essen rein!\n",
     "Berta sagt: Los Trudbert huef ma!\n",
     "Berta fragt: Wos wuestn Du klans Froscherl?!\n",
     "Berta fragt: Spinnst?!\n",
     "Berta fragt: Wuest Du ned lieber nua wos essn?\n",
     "Berta sagt: Hea auf mit dem Bledsinn!\n",
     "Berta ruft nach Trudbert.\n",
     "Berta: Trudbert tua wos!\n",
     "Berta isst schnell a Schwammerl.\n",
     "Berta will sich auf Dich draufhauen.\n",
     "Berta fragt: Wos wuestn Du ueberhaupt?\n",
     "Berta sagt: Geh los mi in Ruh!\n",
     "Berta sagt: I wue wos essen, ned umanandabledln.\n",
     "Berta sagt: I bin vue staerka ois Du!\n",
     "Berta sagt: Jetzt los des!\n",
     "Berta sagt: Host Du nix ondas zum tuan?!\n" }) );

  SetProp( P_DIE_MSG, " isst jetzt nix mehr.\n" );
  SetProp( P_NOCORPSE, 1 );


}

