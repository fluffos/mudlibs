
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../carolina.h"

void create()
{
 if (!is_clone(TO))
 return;

  ::create();

  SetProp(P_SHORT, "Eine Schnecke");
  SetProp(P_LONG,
    "Eine Schnecke bahnt sich vor Dir ihren Weg durch das hohe Gras. "
    "Mit ihren Fuehlern tastet sie sich langsam vorwaerts. Auf ihrem "
    "Ruecken traegt sie ihr eigenes Haus mit sich. ");
  SetProp(P_NAME, "Schnecke" );
  set_living_name( "schnecke" );
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "schnecke" }) );
  
  create_default_npc(5);
  SetProp(P_RACE, "Insekt" );
  SetProp(P_SIZE, 4);
  SetProp(P_ALIGN, 200);
  SetProp(P_HANDS, ({ " mit ihren Fuehlern", QueryProp(P_HANDS)[1],
                      DT_BLUDGEON }) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:     -0.4, DT_COLD:      0.0, DT_WATER:  0.4, DT_AIR:   -0.3, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );
 
  SetProp(P_REJECT, ({ REJECT_DROP,
    "Die Schnecke versteckt sich in ihrem Haus.\n" }) );

  SetChats(4, ({
    "Die Schnecke tastet sich langsam vorwaerts.\n",
    "Die Schnecke versteckt sich in ihrem Haus.\n",
    "Die Fuehler der Schnecke tasten die Luft ab.\n" }) );

  SetProp(P_DEFAULT_INFO, "schleimt herum.\n");
  SetProp(P_SOUND, "Du hoerst ein leises Gatschen.\n");


  SetProp(P_MSGIN, "schleimt herein");
  


}

