
inherit "std/mnpc";
inherit "std/npc/spells";

#include <class.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../carolina.h"

void create()
{
 if (!is_clone(TO))
 return;

  ::create();

  SetProp(P_SHORT, "Eine Raupe");
  SetProp(P_LONG, 
    "Eine Raupe kriecht vor Dir in der Wiese und sucht nach Nahrung. Bald "
    "wird sie sich verpuppen, um als Schmetterling weiterzuleben. ");
  SetProp(P_NAME, "Raupe");
  SetProp(P_GENDER, FEMALE);
  
  create_default_npc(4);
  SetProp(P_HANDS, ({ " nimmersatt", QueryProp(P_HANDS)[1],
          DT_BLUDGEON }) );
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_ALIGN, 0);
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 3);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:     -0.2, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:   -0.4, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );
  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
    "Die Raupe frisst @WEN froehlich auf.\n" }) );

  AddId( ({ "raupe" }) );

  

  SetProp(P_MSGIN, "kriecht herein" );
  SetProp(P_MSGOUT, "kriecht" );
  SetProp(P_MMSGIN, "kriecht herein" );
  SetProp(P_MMSGOUT, "kriecht nach" );

  SetProp(P_MNPC_AREA, "/players/clementine/wassertroepfchen/room/" );
  SetProp(P_MNPC_FLAGS,
           MOV_INDOORS+MOV_OUTDOORS+MOV_MOVES+MOV_SPECIAL );
  SetProp(P_MNPC_WAIT, ({40, 30, random(20)}) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "garten_e2" );

  SetChats(2,
    ({ "Die Raupe knabbert an einem Blatt.\n",
       "Die Raupe sucht nach Nahrung.\n",
       "Die Raupe sucht einen Platz, um sich zu verpuppen.\n" }) );

  SetProp(P_DEFAULT_INFO, "raupt.\n");

}

