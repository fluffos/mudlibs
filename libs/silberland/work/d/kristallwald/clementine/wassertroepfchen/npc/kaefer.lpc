
inherit "std/mnpc";
inherit "std/npc/spells";

#include <class.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../carolina.h"

void create()
{
 if (!is_clone(TO))
 return;

  ::create();

  SetProp(P_SHORT, "Ein Kaefer");
  SetProp(P_LONG,
    "Ein schwarzer Kaefer krabbelt im Gras umher. Von seinem festen, runden, "
    "schwarzen Koerper gehen drei Beinpaare aus. Am Ruecken kannst Du noch "
    "rudimentaere Fluegelansaetze erkennen. ");
  SetProp(P_NAME, "Kaefer");
  SetProp(P_GENDER, MALE);
  AddId( ({ "kaefer" }) );
  create_default_npc(4);
  SetProp(P_RACE, "Insekt");
  SetProp(P_ALIGN, 0);
  SetProp(P_HANDS, ({ " mit seinen Beinchen", QueryProp(P_HANDS)[1],
          DT_BLUDGEON }) );
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_SIZE, 3);
  SetProp(P_RESISTANCE_STRENGTHS,
     ([DT_FIRE:      0.3, DT_COLD:      0.0, DT_WATER: -0.1, DT_AIR:   -0.3, 
       DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
       DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
       DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );
 
  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "krabbelt herein");
  SetProp(P_MMSGOUT, "krabbelt nach");
  
  SetProp(P_MNPC_AREA, "/players/clementine/wassertroepfchen/room/");
  SetProp(P_MNPC_FLAGS,
     MOV_INDOORS+MOV_OUTDOORS+MOV_MOVES+MOV_SPECIAL );
  SetProp(P_MNPC_WAIT, ({40, 30, random(20)}) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "garten_c1" );

  AddInfo(DEFAULT_INFO, "sonnt sich.\n");
  
  SetChats(4, 
    ({ "Der Kaefer sucht nach Nahrung.\n",
       "Der Kaefer knabbert an einem Blatt.\n",
       "Der schwarze Kaefer krabbelt ein wenig umher.\n" }) );

}

