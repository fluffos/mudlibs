inherit "std/mnpc";
inherit "std/npc/spells";

#include <class.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../carolina.h"

void create()
{
 if (!is_clone(TO))
 return;

  ::create();

  SetProp(P_SHORT, "Ein Schmetterling flattert herum");
  SetProp(P_LONG,
    "Ein Schmetterling flattert aufgeregt herum. Er hat leuchtend gelbe "
    "Fluegel auf denen sich blitzblaue Tupfen befinden. ");
  SetProp(P_NAME, "Schmetterling");
  SetProp(P_GENDER, MALE);
  AddId("schmetterling");
  create_default_npc( 1 );
  SetProp( P_BODY, 10 );
  SetProp(P_DISABLE_ATTACK, 1 );
  SetProp(P_HANDS, ({" mit seinen Fluegeln", QueryProp(P_HANDS)[1],
                      DT_BLUDGEON }) );
  SetProp(P_MAX_HANDS, 6);
  AddClass(CL_FLYING);
  SetProp(P_ALIGN, 0);
  SetProp(P_RACE, "Schmetterling");
  SetProp(P_SIZE, 7 );
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:20,T_RANGE_MAX:35]) );
  SetProp(P_DEFAULT_INFO, "flattert nervoes durch die Gegend.\n" );
  SetProp(P_MSGIN, "flattert herein" );
  SetProp(P_MSGOUT, "flattert" );
  SetProp(P_MMSGIN, "flattert herein" );
  SetProp(P_MMSGOUT, "flattert nach" );
  
  SetProp(P_MNPC_AREA, "/players/clementine/wassertroepfchen/room/" );
  SetProp(P_MNPC_FLAGS,
           MOV_INDOORS+MOV_OUTDOORS+MOV_MOVES+MOV_SPECIAL );
  SetProp(P_MNPC_WAIT, ({40, 30, random(20)}) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "garten_d4" );
  
  SetChats(10, ({
    "Der Schmetterling schlaegt aufgeregt mit seinen Fluegeln.\n",
    "Der Schmetterling taenzelt um Dich herum.\n",
    "Der kleine Schmetterling laesst sich vom Wind treiben.\n",
    "Der Schmetterling erhebt sich hoch in die Luefte.\n",
    "Das kleine Flatterwesen schnuppert an einer Bluete.\n" }) );

}
