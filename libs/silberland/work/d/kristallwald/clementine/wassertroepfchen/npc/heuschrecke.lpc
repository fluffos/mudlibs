
inherit "std/mnpc";
inherit "std/npc/spells";

#include <class.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../carolina.h"

void create()
{
 if (!is_clone(TO))
 return;

  ::create();

  SetProp(P_SHORT, "Eine Heuschrecke");
  SetProp(P_LONG, 
    "Eine gruene Heuschrecke sitzt im Gras und haelt nach lebender Nahrung "
    "aussschau. ");
  SetProp(P_NAME, "Heuschrecke");
  SetProp(P_GENDER, FEMALE);

  create_default_npc(6);
  SetProp(P_HANDS, ({ " ihren Fluegeln", QueryProp(P_HANDS)[1],
          DT_BLUDGEON }) );
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_ALIGN, -100);
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 10);
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0,
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );
  SetProp(P_NOATTACK, "huepft woanders hin.");
  SetProp(P_REJECT, ({ REJECT_DROP,
    "Die Heuschrecke huepft ein Stueck weiter.\n" }) );

  AddId( ({ "heuschrecke" }) );

  SetProp(P_MSGIN, "huepft herein" );
  SetProp(P_MSGOUT, "huepft" );
  SetProp(P_MMSGIN, "huepft herein" );
  SetProp(P_MMSGOUT, "huepft nach" );

  SetProp(P_MNPC_AREA, "/players/clementine/wassertroepfchen/room/" );
  SetProp(P_MNPC_FLAGS,
           MOV_INDOORS+MOV_OUTDOORS+MOV_MOVES+MOV_SPECIAL );
  SetProp(P_MNPC_WAIT, ({40, 30, random(20)}) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "garten_c4" );

  SetChats(2,
    ({ "Die Heuschrecke putzt ihre Fluegel.\n",
       "Die Heuschrecke nagt an einem Blatt.\n",
       "Die Heuschrecke huepft.\n" }) );

  SetProp(P_DEFAULT_INFO, "huepft ein Stueck weiter.\n");

}


