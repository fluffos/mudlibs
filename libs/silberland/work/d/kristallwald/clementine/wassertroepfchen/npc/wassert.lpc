  AddInfo( ({ "sargola" }),
    "Sargola ist so nett, und laesst mich hier wohnen. ", "sagt: ");

  AddInfo( ({ "stadt" }),
    "Welche Stadt meinst Du denn?", "fragt: ");
 
  AddInfo( ({ "elessar" }),
    "Elessar ist die Stadt der Elfen. ", "sagt: ");

  AddInfo( ({ "elfe", "elfen", "elf" }),
    "Die Elfen leben in Elessar. ", "sagt: ");
  
  AddInfo( ({ "derlim", "hobbingen" }),
    "Derlim ist die Stadt der Hobbits. ", "sagt: ");

  AddInfo( ({ "hobbits", "hobbit" }),
