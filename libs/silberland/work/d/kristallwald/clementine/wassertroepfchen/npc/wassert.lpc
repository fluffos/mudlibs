  AddInfo( ({ "wasser" }),
    "Ich liebe Wasser! ", "sagt: ");

  AddInfo( ({ "hause", "haus" }),
    "Hier fuehl ich mich sehr wohl. ", "sagt: ");

  AddInfo( ({ "tessa" }),
    "Tessa ist eine ganz eine Liebe! ", "sagt: ");

  AddInfo( ({ "moppy" }),
    "Die hab ich auch lieb. ", "sagt: ");

  AddInfo( ({ "dante" }),
    "Dante ist wirklich eine aussergewoehnliche Persoenlichkeit. ", "sagt: ");

  AddInfo( ({ "persoenlichkeit" }),
    "Einmalig! ", "sagt: ");

  AddInfo( ({ "libelle", "libellen", "kaefer", "raupe", "raupen", "schnecke", 
