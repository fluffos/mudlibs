  AddInfo( ({ "herz" }),
    "sagt: Ich hoffe, Deines ist am rechten Fleck. ");

  AddInfo( ({ "wasserelfe" }),
    "sagt: Ich bin eine Wasserelfe, das hast Du gut erkannt. ");

