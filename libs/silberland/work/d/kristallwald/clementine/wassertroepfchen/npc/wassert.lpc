  AddInfo( ({ "dunkelelf", "dunkelelfen", "dunkelelfe" }),
     "Darueber moechte ich nicht sprechen. ", "murmelt: ");

  AddInfo( ({ "knarkh" }),
     "In Knarkh sollen boese Wesen hausen. ", "bibbert" );

  AddInfo( ({ "wesen" }),
     "Zum Glueck kenne ich keine. ", "antwortet: ");

  AddInfo( ({ "schnitzerei", "schnitzereien", "holzschnitzerei",
              "holzschnitzereien" }),
     "Sawer hat extra fuer mich diesen Kasten angefertigt.", "strahlt: ");

  AddInfo( ({ "sawer" }),
     "Er ist Tischler und lebt gar nicht so weit weg von ihr. ", "schwaermt: ");

  AddInfo( ({ "tischler" }),
     "Sawer ist Tischler.", "strahlt: ");

  AddInfo( ({ "failin" }),
     "Failin ist die huebscheste Fee, die mir jemals in meinem ganzen "
     "Leben begegnet ist. ", "luegt: "); 

  AddInfo( ({ "flieder", "fliederbusch" }),
     "Er blueht doch gerade vor meinem Haeuschen. ", "sagt: ");

  AddInfo( ({ "ronja" }),
     "Ronja ist sowieso die Beste!", "sagt: ");

  AddInfo( ({ "katrin" }),
      "schmunzelt wissend. ");

  AddInfo( ({ "hactar" }),
     "Das ist ein kleiner poppeliger Magier.", "schmunzelt: ");

  AddInfo( ({ "dune" }),
     "Dune hab ich sehr gerne!", "sagt: ");
 
  AddInfo( ({ "freundschaft" }),
	 "Freunde sind das Wichtigste im Leben!", "strahlt: ");

  AddInfo( ({ "freunde", "freund" }),
	 "Ich habe viele liebe Freunde!", "laechelt: ");

  AddInfo( ({ "wichtigste", "wichtigstes" }),
	 "Freunde!", "sagt ganz bestimmt: ");

  AddInfo( ({ "rosenquarze", "quarze" }),
	 "Die find ich ganz besonders schoen. ", "sagt: ");

 

  AddCmd( ({ "biet", "biete" }), "c_bieten"); 
}

hustensaft()
{
	if(!present(QUESTITEM, TP))
	{
		write("Wassertroepfchen sagt: Mit einem bestimmten Hustensaft "
		      "waere ich\n"
		      "Wassertroepfchen sagt: sicherlich schnell wieder auf "
                      "den Beinen.\n" 
		      "Wassertroepfchen sagt: Aber hoer gut zu, denn es "
		      "muss ein ganz bestimmter\n"
                      "Wassertroepfchen sagt: Hustensaft sein. Irgendwo gibt "
		      "es noch das Rezept von diesem alten "
                      "Hausmittel.\n"
                      "Wassertroepfchen sagt: Ach, ich waere Dir so dankbar "
		      "wenn Du mir helfen koenntest.\n"
                      "Wassertroepfchen sagt: Biete mir doch einfach Deine "
		      "Hilfe an!\n");
		return 1;

	}
	else
	{
		write("Wassertroepfchen sagt: Hast Du ihn schon fertig?\n");
		return 0;
	}
}



hilfe()
{
	if(!present(QUESTITEM, TP))
	{
		write(BS("Wassertroepfchen sagt: Du koenntest mir " 
			 "tatsaechlich bei etwas behilflich\n"
			 "Wassertroepfchen sagt: sein. Seit einiger Zeit "
			 "plagt mich ein fuerchterlicher\n"
			 "Wassertroepfchen sagt: Husten. "
			 "Ich komm kaum aus meinem Bettchen "
			 "Wassertroepfchen sagt: "
                         "und kann mich nicht um meinen Garten "
			 "und um die, in ihm "
			 "Wassertroepfchen sagt: lebenden Tiere kuemmern. "
			 "Ohne meine Hilfe werden sie "
			 "Wassertroepfchen sagt: bald sterben. "
                         "Um wieder gesund zu werden, wuerde ich "
			 "Wassertroepfchen sagt: einen "
			 "ganz bestimmten Hustensaft brauchen. "));
                 return 1;	 
	}
        else
	{
		write(BS("Wassertroepfchen sagt: "
			 "Aber Du hilfst mir doch schon! "));
		return 0;
	}

}

void give_notify(object was)
{
 object qitem, seq;

 if(!was->id(QUESTSAFT)) return ::give_notify(was);
/* if(qitem=present(QUESTITEM, TP))
 {
	 write(BS("Wassertroepfchen sagt: Oh, herzlichen Dank!"));
	 was->remove();
	 return;
 }
*/ if(!qitem=present(QUESTITEM,TP))
 {
	 write(BS("Wassertroepfchen sagt: Du hilfst mir doch gar nicht!"));
	 return ::give_notify(was);
 }

 /*if(!(was->QueryOwner() == getuuid(TP)))
 {
	 write(BS("Wassertroepfchen sagt: "
		  "Den Hustensaft hast Du gar nicht selbst gemacht! "));
	 return ::give_notify(was);
 }
*/ if(qitem=present(QUESTITEM, TP))
 {
	 write(BS("Wassertroepfchen sagt: Oh, herzlichen Dank!"));
	 was->remove();
 qitem->remove();
 seq = clone_object(OBJ "seq");
 seq->move(TP,M_GET|M_NOCHECK);

 write_file(QUESTLOG "quest.log",
		 dtime(time())+": "+TPUID+" Fertisch!\n");
 return; 
}
}
int c_bieten(string str)
{
	object ob, wasserquestitem;

	notify_fail("Moechtest Du jemandem Deine Hilfe anbieten?\n");

	if(str != "hilfe an" &&
	   str != "wassertroepfchen hilfe an" &&
	   str != "wasserelfe hilfe an"  &&
	   str != "elfe hilfe an" )
	return 0;

	if(present(QUESTITEM,TP))
	{
		write(BS("Wassertroepfchen sagt: "
			 "Aber Du hilfst mir doch schon!" ));
		return 1;
	}
	if(TP->QueryQuest(QUESTNAME))
	{
	 	write(BS("Wassertroepfchen sagt: Du hast mir bereits geholfen. "
			 "Danke Dir vielmals! "));
		return 1;
	}

	wasserquestitem = clone_object(OBJ "wasserquest");
	if(!wasserquestitem)
	{
		write(BS("Die Elfe sagt: Ups da laeuft was schief. "
			 "Nerv Clementine bitte damit! " ));
		write_file(QUESTLOG "quest.log",
		dtime(time())+": "+TPUID+ " Clonen des QItems gescheitert.\n");
		return 1;
	}
	wasserquestitem->move(TP,M_GET|M_SILENT);

	write("Wassertropefchen sagt: Danke "+TP->Name()+"!\n"
	      "Wassertroepfchen sagt: Bitte beeil Dich und komm schnell "
	      "wieder wenn Du den Saft hast!\n" );
	return 1;
}




