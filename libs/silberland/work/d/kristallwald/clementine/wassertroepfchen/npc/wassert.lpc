void create()
{
 if (!is_clone(TO))
 return;

  ::create();

  SetProp(P_SHORT, "Wassertroepfchen, die kleine Wasserelfe");
  SetProp(P_LONG, 
     "Eine kleine Wasserelfe namens Wassertroepfchen steht vor Dir. "
     "Mit ihren tiefblauen Augen strahlt sie Dich an, ihr blondes "
     "Haar wellt sich sanft ueber ihre Schultern. Du erkennst sofort, "
     "dass dieses Wesen ein gutmuetiges Herz hat und nie jemanden "
     "was Boeses tun wuerde. ");
  SetProp(P_NAME, "Wassertroepfchen");
  set_living_name( "wassertroepfchen");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_RACE, "Wasserelfe" );
  AddId( ({ "wassertroepfchen", "wasserelfe", "elfe", "wesen", "elf",
	    "troepfchen" }) );
 
  create_default_npc(35);
  SetProp(P_ALIGN, 0);
  SetProp(P_BODY, 400);
  SetProp(P_FRIEND, 1);
  SetProp(P_SIZE, 163);
  SetProp(P_NOATTACK, "kichert und huepft aus Deiner Reichweite.");
  SetProp(P_REJECT, ({ REJECT_GIVE, 
     "Wassertroepfchen sagt: Danke nein!\n" }) );

  SetProp(P_LOG_INFO, "/clementine/wasserelfe");

  SetProp(P_DEFAULT_INFO, "gruebelt.\n");

