  AddInfo( ({ "hustensaft", "saft" }), #'hustensaft);

  AddInfo( ({ "husten" }),
	"Selbst ich werde davon nicht verschont...", "hustet: ");
 
  AddInfo( ({ "rezept" }),
    "Ach, wenn ich bloss wuesste wo ich das hingegeben habe. "
    "Schau Dich einmal in meinem Haus genauer um, "
    "ich bin ganz sicher, dass Du es irgendwo finden wirst. ", "sagt: ");

  AddInfo( ({ "hausmittel", "mittel" }),
    "sagt: Der Hustensaft ist ein altes Hausmittel. ");

  AddInfo( ({ "garten" }),
    "Er ist wunderschoen nicht wahr?!", "sagt: ");

  AddInfo( ({ "tiere", "tieren", "tier" }),
    "In meinem Garten leben ganz viele verschiedene Tiere. ", "sagt: ");

  AddInfo( ({ "clementine" }),
    "sagt: Dieses Gurkerl hat mich erschaffen. ");

  AddInfo( ({ "gurkerl" }),
    "kichert.\n"
    "Wassertroepfchen sagt: Die isst sie doch so gerne. ");

  AddInfo( ({ "wassertroepfchen" }),
