  AddInfo( ({ "polaris" }),
    "Angeblich wohnen Hexen in Polaris. ", "sagt: ");

  AddInfo( ({ "hexen", "hexe" }),
     "Leider bin ich noch nie einer begegnet. ", "sagt: ");

  AddInfo( ({ "midas" }),
     "Midas ist die Hauptstadt des Silberlandes. Viele Abenteurer "
