inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <class.h>
#include "../carolina.h"

void create()
{
 if (!is_clone(TO))
 return;

  ::create();

  SetProp(P_SHORT, "Eine Grille");
  SetProp(P_LONG, 
    "Ein braune Grille zirpt vor Deinen Fuesse ihr Liedchen.");
  SetProp(P_NAME, "Grille" );
  set_living_name( "grille" );
  SetProp(P_NAME_ADJ, "klein" );
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SIZE, 7);
  AddId( ({ "grille" }) );
  
  create_default_npc(5);
  SetProp(P_RACE, "Insekt" );
  SetProp(P_ALIGN, 200);
  SetProp(P_HANDS, ({ " mit ihren Beinchen", QueryProp(P_HANDS)[1],
                      DT_BLUDGEON }) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER: -0.4, DT_AIR:   -0.3, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );
  
  SetProp(P_MSGIN, "graebt sich aus der Erde aus");
  SetProp(P_REJECT, ({ REJECT_DROP,
    "Die Grille verschwindet in der Erde, und taucht wenige Zeit spaeter "
    "wieder auf.\n" }) );

  SetChats(4, ({
    "Die Grille sonnt sich etwas.\n",
    "Die Grille zirpt ein Liedchen.\n",
    "Die Grille putzt ihre Beinchen.\n" }) );

  SetProp(P_DEFAULT_INFO, "zirpt ihr Lied.\n");
  SetProp(P_SOUND, "Du hoerst ein leises Zirpen.\n");


  AddDetail( ({ "liedchen" }),
    "Dafuer muesstest Du schon an der Grille lauschen. ");

  AddDetail( ({ "fuesse" }),
    "Vor Deinen Fuessen sitzt eine Grille. ");

}


