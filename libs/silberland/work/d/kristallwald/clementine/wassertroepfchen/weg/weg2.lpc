
// fertig!

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../carolina.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Auf einem Waldweg");
  SetProp(P_INT_LONG,
    "Du stehst auf einem kleinen Trampelpfad, an dessen Wegrand viele "
    "Blumen und Straeucher wachsen. Vereinzelt stehen einige Baeume "
    "hier, deren gruene Blaetter im Sonnenlicht funkeln. Weiter im Nordosten "
    "scheint eine richtige Wiesenlandschaft zu beginnen, nach Suedwesten "
    "hingegen wird es zunehmend waldiger. Manchmal streifen Sonnenstrahlen "
    "Deine Haut, und waermen Dich. "); 
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "nordosten", WEG "weg3" );
  AddExit( "suedwesten", WEG "weg1" );


// DETAILBEGINN


  AddDetail( ({ "osten", "norden", "westen", "sueden", "nordosten",
                "nordwesten", "suedwesten", "suedosten" }),
    "Du musst schon selber wissen, wo Du hin moechtest. ");

  AddDetail( ({ "trampelpfad", "pfad", "boden" }),
    "Du stehst auf einem kleinen Trampelpfad, wie Du ihn sicherlich schon "
    "oefter gesehen hast. Rechts und links von Dir wachsen Blumen, Straeucher "
    "und sogar ein paar Baeume. ");

  AddDetail( ({ "weg" }),
    "Wohin Du gehst darfst Du ausnahmsweise einmal alleine entscheiden.");

  AddDetail( ({ "wegrand" }),
    "Neben dem Pfad wachsen viele Blumen, aber auch Straeucher und Baeume. "
    "Alles in allem sieht es hier sehr friedlich aus, und laedt foermlich "
    "zu einer kleinen Entspannungsrunde ein. ");
  
  AddDetail( ({ "entspannungsrunde", "entspannung", "runde" }),
    "Nach groesser Anstrengung waere hier sicherlich der geeignetste Platz "
    "zum ausruhen.");

  AddDetail( ({ "anstrengung" }),
    "Du kannst es ja einfach einmal ausprobieren. ");

  AddDetail( ({ "platz" }),
    "Ist es nicht wunderschoen hier?");

  AddDetail( ({ "wiesenlandschaft", "wiese", "landschaft" }),
    "Die Landschaft im Nordosten wird wiesiger. Im Suedwesten allerdings "
    "meinst Du ein Waeldchen erkennen zu koennen, mit weissen Gewaechsen. ");

  AddDetail( ({ "gewaechse" }),
    "Alle Gewaechse in dem Waeldchen sind mit einer weissen Schicht "
    "ueberzogen. ");

  AddDetail( ({ "schicht" }),
    "Alles ist dort mit einer kristallinen Schicht ueberzogen. ");

  AddDetail( ({ "waeldchen", "wald" }),
    "Das ist sicherlich der Kristallwald. ");

  AddDetail( ({ "kristallwald", "silberland", "waelder", "ferne" }),
    "Seit ich hier im Silberland bin, hat noch keiner ganze Waelder aus "
    "der Ferne abforschen koennen - Du also auch nicht :)");

  AddDetail( ({ "haut" }),
    "Manchmal streifen einige Sonnenstrahlen Deine Haut und huellen Dich fuer "
    "kurze Zeit mit ihrer Waerme ein. ");

  AddDetail( ({ "zeit" }),
    "Zeit ist kostbar, nuetze sie also!");

  AddDetail( ({ "waerme" }),
    "Wohlig warm, wie frueher im Bauch Deiner Mami. ");

  AddDetail( ({ "bauch", "mami" }),
    "Hat Dich der Storch gebracht?");

  AddDetail( ({ "storch" }),
    "Anscheinend :)");

  AddDetail( ({ "sonnenstrahlen", "strahlen" }),
    "Das Blaetterdach der Baeume ist nicht sehr dicht, sodass einige "
    "Sonnenstrahlen immer wieder zu Dir vordringen. ");

  AddDetail( ({ "blumen" }),
    "Tausende von Blumen wachsen am Wegrand - eine bunter und schoener als die "
    "andere. Anscheinend bietet die Erde hier die besten Voraussetzungen "
    "fuer gutes Wachstum. ");

  AddDetail( ({ "voraussetzung", "voraussetzungen" }),
    "Blumen brauchen einen guten Naehrboden um schoen wachsen zu koennen. ");

  AddDetail( ({ "erde" }),
    "Sie hat einen aeusserst dunklen Farbton. ");

  AddDetail( ({ "farbton" }),
    "Genau die richtige Farbe fuer das perfekte Wachsen. ");

  AddDetail( ({ "wachsen" }),
    "Sie gedeihen wirklich praechtig. ");

  AddDetail( ({ "farbe" }),
    "Du bist Dir sicher, dass es eine Mischung zwischen Zinnoberrot, Goldocker, "
    "Rabenschwarz und Tannenblau ist.");
  
  AddDetail( ({ "mischung" }),
    "Du bist sehr stolz auf Dich, weil Du so ein gut geschultes Auge hast. ");

  AddDetail( ({ "auge", "aug" }),
    "Clementine wuerde Dir jetzt sicher Applaus spenden, da Du so toll bist. ");

  AddDetail( ({ "clementine" }),
    "Wo ist sie denn? Immer ist sie weg, wenn man sie mal braucht. ");

  AddDetail( ({ "zinnoberrot", "goldocker", "rabenschwarz", "tannenblau" }),
    "Tolle Farben nicht wahr?!");

  AddDetail( ({ "farben" }),
    "Du bist wahrlich ein Kenner!");

  AddDetail( ({ "applaus", "kenner" }),
    "Bravo! Klatsch! Du bist spiiiiiiiiiiiiiiiiitze!");

  AddDetail( ({ "straeucher", "strauch" }),
    "Gruene Straeucher zieren den Wegrand. Sie haben Zweige und so Dinge, "
    "die Straeucher einfach haben. ");

  AddDetail( ({ "zweige", "zweig" }),
    "Die Zweige der Straeucher sind so braun, und lang, und duenn, und "
    "halt so wie Zweige von Straeuchern sein muessen. ");

  AddDetail( ({ "dinge" }),
    "Naja den ganzen Rest halt :)");

  AddDetail( ({ "rest" }),
    "Was weiss ich... ");

  AddDetail( ({ "naehrboden" }),
    "Du steckst Deinen Finger in den Boden. Danach ziehst Du in wieder heraus "
    "und schiebst ihn in den Mund.\n"
    "Hmm...schmeckt genauso wie ein guter Naehrboden schmecken sollte. ");

  AddDetail( ({ "finger" }),
    "Jetzt ist er wieder schoen sauber. :)");

  AddDetail( ({ "mund" }),
    "War sicherlich ein Genuss fuer Deine Geschmacksnerven. ");

  AddDetail( ({ "geschmacksnerven", "nerven" }),
    "Die freuen sich ganz bestimmt! ");

  AddDetail( ({ "genuss" }),
    "Lecker!");

  AddDetail( ({ "wachstum" }),
    "Ja so Blumen brauchen einiges um gut wachsen zu koennen. ");

  AddDetail( ({ "himmel" }),
    "Der blaue Himmel ueber Dir ist wolkenlos. Nur die Sonne sendet ihr Licht "
    "aus, dass sogar manchmal bis zu Dir vordringt. ");

  AddDetail( ({ "sonne" }),
    "Ein roter runder Feuerball. ");

  AddDetail( ({ "feuerball", "ball" }),
    "Ich hab aufgepasst in der Schule. ");

  AddDetail( ({ "schule" }),
    "Verwundert gell?!");

  AddDetail( ({ "baeume" }),
    "Vereinzelt stehen ein paar Baeume hier. Ihr Blaetterdach ist nicht sehr "
    "dicht, sodass Du ohne Probleme den Himmel ueber Dir erkennen kannst. ");

  AddDetail( ({ "wolke", "wolken" }),
    "Wo?");
 
  AddDetail( ({ "blaetter" }),
    "Die Blaetter der Baeume funkeln im Sonnenlicht. Vielleicht sind es auch "
    "nur die Tautropfen, von denen das Funkeln ausgeht. So genau laesst sich "
    "das leider nicht erkennen von hier unten. ");

  AddDetail( ({ "funkeln" }),
    "Es blitzt und funkelt. ");

  AddDetail( ({ "tautropfen", "tropfen" }),
    "Einige Tautropfen koennten sich auf den Blaettern befinden, sicher bist "
    "Du Dir allerdings nicht. ");

  AddDetail( ({ "sonnenlicht", "licht" }),
    "Ist es nicht herrlich?!");

  AddDetail( ({ "blaetterdach", "dach" }),
    "Das Blaetterdach der Baeume ist nicht besonders dicht. ");

  AddDetail( ({ "probleme", "problem" }),
    "Problemlos kannst Du alles erkennen. ");

  AddDetail( ({ "stamm", "staemme" }),
    "Jeder Baum hier hat natuerlich auch einen Stamm. Ob man mit ihm etwas "
    "machen koennte?");

// SMELLS

  AddSmell(DEFAULT_SMELL, "Hier duftet einfach alles herrlich!");

  AddSmell( ({ "blume", "blumen" }),
    "Die Blumen riechen ganz wunderbar!");

// SOUNDS

  AddSound(DEFAULT_SOUND, "Manchmal laesst der Wind leise die Blaetter "
    "der Baeume und Straeucher rascheln. ");

  AddSound( ({ "blaetter", "straeucher", "wind", "rascheln" }),
    "Momentan ist es windstill, sodass man leider gar nichts hoeren "
    "kann. ");


  AddSpecialDetail( ({ "bravo", "klatsch" }), "applausfunc");
 
  AddCmd( ({ "kletter", "klettere" }), "c_klettern");
  AddCmd( ({ "schuettel", "schuettle" }), "c_schuetteln");
  AddCmd( ({ "ruhe", "ruh", }), "c_ruhen");

}

int c_klettern( string str )
{
 if( str != "auf baum" )
 {
  notify_fail("Worauf moechtest Du klettern?\n");
  return 0;
 }
 else
 {
  write(BS("Du findest keinen Weg um auf den Baum zu gelangen. Vielleicht "
           "solltest Du etwas anderes probieren, wenn Du wissen willst, ob "
           "sich wirklich Tautropfen auf den Blaettern befinden. "));
  say(CTPN+ " beginnt gleich zu weinen.\n");
  return 1;
 }
}

int c_schuetteln( string str )
{
 if( str != "baum"   &&
     str != "baeume" &&
     str != "stamm"   )
 {
  notify_fail("Was moechtest Du schuetteln?\n");
  return 0;
 } 
 else
 {
  write("Du suchst Dir einen schoenen Baum aus, und beginnst mit aller "
        "Kraft an seinem Stamm zu schuetteln.\n"
        "Huch! Ein richtiger Schwall von Wasser ergiesst sich ueber Dir.\n"
	    "War wohl doch mehr Wasser auf den Blaettern, als Du dachtest.\n");
  say(CTPN+ " ist auf einmal platschnass.\n");
  return 1;
 }
}


string applausfunc( string str )
{
 this_player()->command_me("-grats:applaudiert sich selbst fuer sinnlose "
      "Detailuntersuchungen.");
 return "";
}

int c_ruhen( string str )
{
 if( str != "aus" )
 {
  notify_fail("Was moechtest Du machen?\n");
  return 0;
 }
 else
 {
  write(BS("Du ruhst Dich fuer einige Sekunden aus, stellst aber dann fest, "
           "dass Du eigentlich gar nicht erschoepft bist. Vergnuegt ueber "
           "diese Feststellung verspuerst Du nun gewaltige Lust "
           "weiterzuforschen. "));
  say(CTPN+ " sieht ploetzlich ziemlich gierig aus.\n");
  return 1;
 }
}

