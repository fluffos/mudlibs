
//FERTIG!

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../carolina.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Auf einem Weg");
  SetProp(P_INT_LONG, 
    "Hier endet der Weg nach Norden an einem kleinen Gartentor. Ueber ihm "
    "befindet sich ein hoelzerner Torbogen, an dem sich rote Rosen "
    "hochranken. Dahinter kannst Du bereits ein kleines Haeuschen erkennen, "
    "das von bunter Blumenwiese umgeben ist. Die Sonne strahlt froehlich "
    "vom Himmel herab, und erheitert Dein Gemuet. Nach Suedwesten gelangst "
    "Du auf einen kleinen Trampelpfad. Ein kleines Holzschild wurde direkt "
    "neben dem Gartentor angebracht. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "norden", ROOM "tor" );
  AddExit( "suedwesten", WEG "weg5" );

  NewDoor( "norden", ROOM "tor", ({ "tor", "gartentor" }),
     ({ DOOR_CLOSED,
        DOOR_RESET_CL,
        D_NAME, "Gartentor",
        D_GENDER, NEUTER,
        D_SHORT, "Im Norden befindet sich ein %ses Gartentor. ",
        D_LONG, "Ein gruen bemaltes Gartentor befindet sich im Norden. "
                "Es laesst sich sicherlich leicht oeffnen und schliessen. ",
  //      D_MSGS, ({ "nach Norden", "geht", "kommt durch das Gartentor" }),
        D_OPENMSG, ({ "Du oeffnest das Gartentor. ",
                      "%s oeffnet das Gartentor. ",
                      " wird geoeffnet. " }),
        D_CLOSEMSG, ({ "Du schliesst das Gartentor sorgfaeltig. ",
                       "%s schliesst sorgfaeltig das Gartentor. ",
                       " wird geschlossen. " }),
        D_RESET_CLOSEMSG, " wird durch einen Windstoss geschlossen. " }) );

  

// DETAILBEGINN


  AddDetail( ({ "norden" }),
    "Im Norden beginnt ein kleiner Garten. Ein kleines Haeuschen kannst "
    "Du schon von hier aus erkennen. ");

  AddDetail( ({ "torbogen", "bogen" }),
    "Rote Rosen ranken sich an dem Torbogen hoch. Er befindet sich direkt "
    "hinter dem gruengestrichenem Gartentor. Doch bereits jetzt dringt "
    "der suesse Rosenduft an Deine Nase. ");

  AddDetail( ({ "rosenduft", "duft", "duefte" }),
    "Probiers lieber mit 'riechen'. ");

  AddDetail( ({ "rosen" }),
    "Rote Rosen ranken sich an dem Torbogen hoch, und beeindrucken Dich mit "
    "ihrem Aussehen. ");

  AddDetail( ({ "aussehen" }),
    "Wirklich beeindruckend! ");

  AddDetail( ({ "haeuschen" }),
    "Ein kleines Haeuschen befindet sich noerdlich in dem Garten. "
    "Von hier kannst Du noch nicht soviel erkennen, vielleicht solltest "
    "Du naeher rangehen. ");

  AddDetail( ({ "blumenwiese", "wiese" }),
    "Ein grosse Blumenwiese breitet sich noerdlich von Dir aus, und scheint "
    "das kleine Haeuschen zu umgeben. ");

  AddDetail( ({ "sonne" }),
    "Hell und kraeftig scheint die Sonne auf Dich herabzustrahlen. Angenehm "
    "warm empfindest Du ihre Strahlen auf Deiner Haut. ");

  AddDetail( ({ "haut" }),
     "Deine Haut fuehlt sich ganz warm an. ");

  AddDetail( ({ "himmel" }),
    "Wunderschoen blau erstrahlt der Himmel an dem heutigen Tag. Kein "
    "einziges Woelkchen ist zu erkennen, nur die Sonne, wie sie "
    "sanft ihren Strahlen freien Lauf laesst. ");

  AddDetail( ({ "strahlen" }),
    "Sie verursachen ein sanftes Prickeln auf Deiner Haut. ");

  AddDetail( ({ "prickeln" }),
    "Herrlich!");

  AddDetail( ({ "gemuet" }),
    "Dein Gemuet ist ziemlich erheitert momentan :)");

  AddDetail( ({ "suedwesten" }),
    "Nach Suedwesten gelangst Du auf einen kleinen Trampelpfad. ");

  AddDetail( ({ "holzschild", "schild" }),
    "Ein Holzschild haengt direkt neben dem Gartentor. Mit dunklen Lettern "
    "wurde etwas daraufgekritzelt. ");

  AddDetail( ({ "letter" }),
    "Fein saeuberlich geschwungene Letter bilden einen Schriftzug. ");

  AddDetail( ({ "schriftzug" }),
    "Lies es doch einfach :). ");

  AddReadDetail( ({ "holzschild", "schild", "schriftzug" }),
    "*****************************************************\n"
    "*    Herzlich Willkommen in meinem trauten Heim!    *\n"
    "* Moegen sich alle Rassen bei mir zu Hause fuehlen! *\n"
    "*          Alles Liebe, Wassertroepfchen            *\n"
    "*****************************************************\n");

  AddDetail( ({ "boden" }),
    "Auf dem Boden wuchern die verschiedensten Graeser und Blumen. Du solltest "
    "aufpassen, damit Du nicht einen kleinen Wiesenbewohner zertrampelst! ");

  AddDetail( ({ "bewohner", "wiesenbewohner" }),
    "Da und dort krabbelt eine kleine Ameise im hohen Gras. Auch einige "
    "Kaefer kannst Du erkennen, die auf der Suche nach Nahrung sind. ");

  AddDetail( ({ "kaefer", "ameisen", "ameise" }),
    "Du musst nur genauer hinsehen, um welche entdecken zu koennen. ");

  AddDetail( ({ "gras" }),
    "Im hohen Gras bahnen sich einige Insekten, die auf der Suche nach "
    "Nahrung sind, ihren Weg. ");

  AddDetail( ({ "nahrung" }),
    "Vorzugsweise Nektar und andere leckeren suessen Dinge.");

  AddDetail( ({ "dinge" }),
    "Du musst schon etwas Deine Phantasie spielen lassen. ");

  AddDetail( ({ "phantasie" }),
    "Fische sollen sehr viel Phantasie haben. Vielleicht fragst Du mal einen "
    "danach. ");

  AddDetail( ({ "fisch", "fische" }),
    "Du wirst sicherlich bald ein paar finden. ");

  AddDetail( ({ "nektar" }),
    "Der suesse Geschmack von Nektar ist unter den Bewohnern heissbegehrt. ");

  AddDetail( ({ "geschmack" }),
    "Etwas Nektar zu kosten, waere sicherlich ein kleiner Hoehenflug. ");

  AddDetail( ({ "hoehenflug" }),
    "Ob Dir irgendjemand etwas Nektar zum Probieren laesst? ");

  AddDetail( ({ "probieren" }),
    "Tus einfach!!!!!!!!!!!!!");

  AddDetail( ({ "nase" }),
    "Deine Nase fuehlt sich von den vielen verschiedenen Dueften "
    "momentan ziemlich ueberfordert. ");

  AddDetail( ({ "garten" }),
    "Im Norden befindet sich ein Garten, den Du betreten solltest, um "
    "mehr erforschen zu koennen. ");

  AddDetail( ({ "holz" }),
    "Schaut nach Eiche aus. "); 

  AddDetail( ({ "eiche" }),
    "Hier ist keine zu sehen. ");

  AddDetail( ({ "graeser" }),
    "Ueberall wachsen die verschiedensten Graeser, die die Natur entstehen "
    "liess. ");

  AddDetail( ({ "natur" }),
    "Natur umgibt Dich hier vollkommen. ");

  AddDetail( ({ "blumen" }),
    "Bunte Blumen wachsen ueberall, und verleihen diesem Ort Farbe und eine "
    "gewisse Froehlichkeit. ");

  AddDetail( ({ "farbe" }),
    "Die Blumen bluehen in den verschiedensten Farben: rot, gruen, blau, "
    "gelb, weiss, violett, rosa, orange, tuerkis und sogar neonbunt. ");

  AddDetail( ({ "neonbunt" }),
    "Technicolor laesst gruessen. ");

  AddDetail( ({ "rosa", "orange", "weiss", "gelb", "violett", "rot", "gruen", 
                "blau", "tuerkis" }),
    "Alles wunderbare Farben. ");

  AddDetail( ({ "suche" }),
    "Kleine Insekten sind ueberall auf der Suche nach Nahrung. ");

  AddDetail( ({ "insekten", "insekt" }),
    "Kleine Tierchen, die den Boden und die Wiese bewohnen, nennt man "
    "Insekten. ");

  AddDetail( ({ "tierchen" }),
    "Vielleicht solltest Du Dich ein anderes Mal naeher mit den wunderbaren "
    "Dingen beschaeftigen, die die Natur zum Vorschein bringt. ");

  AddDetail( ({ "dinge", "dingen" }),
    "Welche? ");

  AddDetail( ({ "vorschein" }),
    "Da gibt es einiges zum Sehen. ");

  AddDetail( ({ "sehen" }),
    "Schau doch einfach mal genauer hin! ");

  AddDetail( ({ "mal" }),
    "Einfach nicht jetzt. ");

  AddSpecialDetail( ({ "ort" }), "ortfunc" );
   
  AddDetail( ({ "froehlichkeit" }),
    "Man wird einfach froehlich, wenn man hier ist. ");

  AddDetail( ({ "weg" }),
    "Der Weg endet hier im Norden an einem kleinen Gartentor. Nach "
    "Suedwesten kommst Du wieder auf einen kleinen Trampelpfad. ");

  AddDetail( ({ "pfad", "trampelpfad" }),
    "Er beginnt im Suedwesten. ");

  AddDetail( ({ "tag" }),
    "Ein schoener Tag! Kein Woelkchen am Himmel zu sehen, nur die Sonne, "
    "die Dir froehlich zublinzelt. ");

  AddDetail( ({ "woelkchen" }),
    "Kein einziges zu sehen!\n"
    "Du freust Dich. ");

  AddDetail( ({ "lauf" }),
    "Du weisst garantiert, was 'freien Lauf lassen' heisst. ");


// SMELLS

  AddSmell(DEFAULT_SMELL, "Hier duftet es nach den verschiedensten Blumen. ");

  AddSmell( ({ "blumen", "blume" }),
    "Sie riechen alle suesslich - einfach toll! Hier koenntest Du ewig "
    "verweilen. ");

  AddSmell( ({ "rosenduft", "duft", "duefte" }),
    "Es riecht einfach wunderbar!");

// SOUNDS

  AddSound(DEFAULT_SOUND, "Von weiter weg hoerst Du ein paar Voegel "
    "pfeifen und das Summen einiger Insekten. ");

  AddSound( ({ "summen", "insekten" }),
    "*summ* *summ*");

  AddSound( ({ "pfeifen", "voegel" }),
    "Ein paar Voegel pfeifen etwas weiter im Westen. Du solltest vielleicht "
    "etwas naeher rangehen, um alles besser zu hoeren. "); 


  AddCmd( ({ "kost", "koste" }), "c_kosten");

}

int c_kosten(string str)
{
	if(str != "nektar" )
	{
		notify_fail("Was moechtest Du kosten?\n");
		return 0;
	}
	else
	{
		write(BS("Mjamm... lecker suess!"));
		return 1;
	}
}


string ortfunc( string str)
{
 this_player()->command_me("sag Der Ort hier ist wirklich schoen!");
 return "";
}

