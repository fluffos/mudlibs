
// fertig!

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../carolina.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Auf einem Waldweg");
  SetProp(P_INT_LONG,
    "Wohin das Auge reicht, siehst Du nur bunte Blumen und Graeser. Eine "
    "grosse Eiche steht am Wegrand, deren dicke Aeste ihren Schatten "
    "auf den Weg werfen. Ein kleiner Maulwurfshuegel befindet sich links "
    "von ihr. Einige kleine Steinchen liegen verstreut auf dem Weg, dennoch "
    "scheint es, als wollten sie Dich auf irgendetwas Bestimmtes hinweisen. "
    "Der Geruch von Essen liegt in der Luft, von woher der wohl kommen mag?!"); 
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "nordosten", WEG "weg4" );
  AddExit( "suedwesten", WEG "weg2" );

  



// DETAILBEGINN


  AddDetail( ({ "himmel" }),
    "Wenn man nicht gerade genau unter den dicken Aesten der Eiche steht, "
    "kann man muehelos den Himmel ueber einen erkennen. Er erstrahlt in einem "
    "hellen Blau, kein einziges Woelkchen weit und breit. ");

  AddDetail( ({ "woelkchen" }),
    "Du kannst keines erkennen. ");

  AddDetail( ({ "blau" }),
    "Der Himmel ist in ein ganz helles Blau getuencht. ");

  AddDetail( ({ "auge", "aug" }),
    "Dein Auge reicht wirklich sehr weit! ");

  AddDetail( ({ "schatten" }),
    "Die dicken weitreichenden Aeste der Eiche werfen ein lustiges "
    "Schattenmuster auf den Boden. ");

  AddDetail( ({ "schattenmuster", "muster" }),
    "Ueberkreuz, derlaengs und quer. Alle moeglichen Formen haben die "
    "Schatten der Aeste. Sieht wirklich lustig aus. ");

  AddDetail( ({ "formen" }),
    "Wirklich ganz viele verschiedene. ");

  AddDetail( ({ "weg", "pfad", "boden" }),
    "Du trampelst immer noch auf dem Weg entlang. Er ist ziemlich erdig, "
    "und sieht ziemlich benutzt aus. Einige Steinchen erregen Deine "
    "Aufmerksamkeit. ");

  AddDetail( ({ "aufmerksamkeit" }),
    "Du bist schon ziemlich gespannt, was die Steinchen Dir wohl mitteilen "
    "wollen. ");

  AddDetail( ({ "steinchen", "steine" }),
    "Die Steine liegen verstreut auf dem Weg. Eigentlich sieht man sowas ja "
    "oefter, aber dennoch vermutest Du da eine bestimmte Bedeutung "
    "dahinter. ");

  AddDetail( ({ "bedeutung" }),
    "Als Du Dir die Steinchen genauer ankuckst, meinst Du einen Pfeil "
    "erkennen zu koennen. ");
 
  AddDetail( ({ "bestimmtes" }),
    "Die Steine scheinen Dir etwas sagen zu wollen. ");

  AddDetail( ({ "pfeil" }),
    "Tatsaechlich! Ein Pfeil.\n"
    "Jetzt musst Du nur mehr die Pfeilrichtung herausfinden.");

  AddDetail( ({ "pfeilrichtung", "richtung" }),
    "Ganz klar! Die Pfeilspitze deutet in eine ganz bestimmte Richtung. ");

  AddDetail( ({ "pfeilspitze", "spitze" }),
    "Die Pfeilspitze besteht aus genau sieben Steinen. Jetzt wird Dir so "
    "einiges klar. Vor Deinem geistigen Auge erscheint ein Bild. ");

  AddDetail( ({ "bild" }),
    "Das Bild wird immer deutlicher. Jetzt kannst Du es erkennen! Ein "
    "wunderbarer Anblick dieser Pfeil. ");

  AddDetail( ({ "anblick" }),
    "Na, der Pfeil der nach Nordosten zeigt, ist ein wunderbarer Anblick. ");

  AddDetail( ({ "nordosten", "suedwesten" }),
    "Tja, entweder oder. Welchen Weg Du einschlaegst ist Dir ueberlassen. ");

  AddDetail( ({ "geruch", "essen" }),
    "Probiers doch mal mit riechen!");

  AddDetail( ({ "luft" }),
    "Die Luft ist leider unsichtbar fuer Dein Auge. Probiers vielleicht "
    "einmal mit riechen. ");

  AddDetail( ({ "maulwurfshuegel", "huegel" }),
    "Links am Wegrand befindet sich ein kleiner, dennoch nicht uebersehbarer "
    "Maulwurfshuegel. An seiner Oberseite weist er ein ziemlich schmales Loch "
    "auf. ");

  AddDetail( ({ "oberseite" }),
    "Ein ziemlich schmales und enges Loch befindet sich an der Oberseite "
    "des Huegels. Vielleicht solltest Du es einmal naeher unter die Lupe "
    "nehmen. ");

  AddDetail( ({ "lupe" }),
    "Schade, dass Du keine dabei hast. So musst Du Dich wohl auf Deinen "
    "normalen Sehsinn verlassen. ");

  AddDetail( ({ "sehsinn" }),
    "Einer der wichtigsten Sinne, meinst Du nicht? ");

  AddDetail( ({ "sinne" }), 
    "Eigentlich sind ja alle sehr wichtig. ");

  AddDetail( ({ "wegrand" }),
    "Am Wegrand kannst Du abgesehn von den vielen Blumen und Graesern eine "
    "groesse alte Eiche erkennen. ");

  AddDetail( ({ "graeser" }),
    "Viele verschiedene Graeser wachsen hier. Auf einem kannst Du einen "
    "seltsamen schwarzen Punkt erkennen. ");

  AddDetail( ({ "punkt" }),
    "Jetzt ist er nicht mehr zu sehen. War vielleicht nur eine Ameise. ");

  AddDetail( ({ "ameise" }),
    "So eine kleine Ameise kann ganz schoen schnell krabbeln. ");

  AddDetail( ({ "blumen", "blume" }),
    "Bunte Blumen wuchern ueberall. Eigentlich sehen sie eher nach bunten "
    "Farbklecksen aus. ");

  AddDetail( ({ "farbkleckse", "kleckse" }),
    "Vielleicht hat hier ja jemand mit einem Pinsel gemalt. ");

  AddDetail( ({ "pinsel" }),
    "Das war bestimmt der alte Mann...");
 
  AddDetail( ({ "mann" }),
    "Kennst Du die Geschichte nicht?");

  AddDetail( ({ "geschichte" }),
    "Wenn Du sie lesen moechtest, so frag doch einmal Wassertroepfchen "
    "danach. ");

  AddDetail( ({ "wassertroepfchen" }),
    "Sie lebt hier ganz in der Naehe. ");

  AddDetail( ({ "naehe" }),
    "Besuch sie doch! ");

  AddDetail( ({ "eiche", "baum" }),
    "Die Eiche am Wegrand scheint schon sehr alt zu sein. In ihrem Leben "
    "hat sie sicherlich schon mehrere Wesen wie Dich vorbeihuschen gesehen, "
    "und manchmal sogar ihren Worten gelauscht. ");

  AddDetail( ({ "wesen" }),
    "Abenteurer wie Du es bist. ");

  AddDetail( ({ "abenteurer" }),
    "Tja nicht selten passieren solche wie Du diesen Weg. ");

  AddDetail( ({ "worte" }),
    "Sie erzaehlten von Abenteuer, Gefahren und sogar von Liebe...");

  AddDetail( ({ "abenteuer", "gefahren", "liebe" }),
    "Die Eiche hat schon einiges in ihrem langen Leben mitbekommen. ");

  AddDetail( ({ "leben" }),
    "Sie ist bestimmt schon etliche Jahre alt. ");

  AddDetail( ({ "jahre", "alter" }),
    "Da Du sie nicht faellen moechtest, wirst Du das genaue Alter nie "
    "erfahren. ");

  AddDetail( ({ "aeste" }),
    "Die festen Aeste des Baumes werfen ihre Schatten auf den Boden. "); 


// SMELLS

  AddSmell(DEFAULT_SMELL, "Mhmm, hier riecht es nach total leckerem "
    "Essen?!");

  AddSmell( ({ "essen" }),
    "Boah, riecht das lecker! Hunger!!!!!!!!! Woher der Geruch wohl "
    "kommt?");

  AddSmell( ({ "geruch" }),
    "Hmm... der Geruch kommt aus dem Huegel! Vielleicht isst der Maulwurf "
    "gerade zu Mittag?!");

  AddSmell( ({ "huegel" }),
    "Du schnupperst ueber dem Huegel - und wirklich! Dort riecht es nach "
    "Essen!");

  AddSmell( ({ "maulwurf" }),
    "Den Maulwurf kannst Du leider nicht riechen.");



// SOUNDS

  AddSound(DEFAULT_SOUND, "Manchmal hoerst Du ein Klirren. ");

  AddSound( ({ "klirren" }),
    "Klingt als wuerden Glaeser aneinanderstossen. ");

  AddSound( ({ "glaeser" }),
    "*klirr* !!!");
   



  AddSpecialDetail( ({ "loch" }), "lochfunc");
 

  AddCmd( ({ "kletter", "klettere" }), "c_klettern");


}

string lochfunc()
{
 string str;
 str="Das Loch befindet sich ganz oben auf dem Huegel. Es ist ziemlich "
     "eng und klein. ";
 if(!(this_player()->QueryProp(P_FROG)) ||
    !(this_player()->QueryProp(P_RACE, "Fee")) )
 {
  return (BS(str+"Also Du passt hier garantiert nicht durch!"));
 }
 else
 {
  return (BS(str+"Bei Deiner Groesse koenntest Du hier muehelos "
                 "hineinklettern. "));
 }
}

int c_klettern( string str )
{
 if( str != "in huegel"  &&
     str != "in loch hinein" &&
     str != "in huegel hinein" &&
     str != "durch loch" &&
     str != "durch loch durch" &&     
     str != "in loch"    )
 {
  notify_fail("Wohin moechtest Du klettern?\n");
  return 0;
 }
 else
 {
  if(!(this_player()->QueryProp(P_FROG)) &&
     (this_player()->QueryProp(P_RACE) != "Fee") ) 
  {
   notify_fail("Wie willst Du Riese in den kleinen Huegel hinein?!\n");
   return 0;
  }
   return this_player()->move(WEG "kneipe", M_GO,
        "in ein Loch", "klettert", "klettert herein");
     
 }
}

