
// complete


inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../carolina.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Auf einem Waldweg");
  SetProp(P_INT_LONG,
    "Einige Straeucher wachsen rechts und links am Wegrand. "
    "Ein kleiner Trampelpfad fuehrt weiter nach Nordosten, nach Westen "
    "gelangst Du in ein kleines Waeldchen, dass Dich durch ein mystisches "
    "weisses Leuchten magisch anzuziehen scheint. Der ganze Weg ist "
    "durchzogen von Graesern und Blumen, ein etwas groesserer "
    "Stein liegt genau in seiner Mitte. "); 
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "nordosten", WEG "weg2" );
  AddExit( "westen", ANSCHLUSS_KRISTALLWALD );


  AddDetail( ({ "straeucher" }),
    "Straeucher wachsen am Wegrand. Ihre Blaetter sind von einer "
    "feinen Kristallschicht ueberzogen. Dunkelrote Beeren wachsen an ihren "
    "Zweigen. ");

  AddDetail( ({ "zweige" }),
    "Dunkelrote Beeren wachsen an ihnen. Ob sie essbar sind?!\n");

  AddDetail( ({ "blaetter" }),
    "Die Blaetter der Straeucher sind von einer feinen Kristallschicht "
    "ueberzogen. ");

  AddDetail( ({ "beeren" }),
    "Ob die Beeren geniessbar sind?\n"
    "Im Gegensatz zu den Blaettern sind sie naemlich nicht von dieser "
    "weissen Schicht ueberzogen. ");

  AddDetail( ({ "gegensatz", "gegensaetze" }),
    "Gegensaetze ziehen sich an :>");

  AddDetail( ({ "wegrand" }),
    "Rechts und links vom Wegrand wachsen kleine Straeucher, und saeumen "
    "den Weg aus. ");

  AddDetail( ({ "trampelpfad", "pfad" }),
    "Du stehst auf einem kleinen Trampelpfad, der weiter nach Nordosten "
    "fuehrt. Nach Westen hingegen kommst Du in ein kleines Waeldchen. ");

  AddDetail( ({ "waeldchen" }),
    "Es liegt weiter im Westen, versuche dort Dein Glueck, um es naeher "
    "zu erforschen. Sicher birgt es viele Geheimnisse in sich. ");
  
  AddDetail( ({ "geheimnisse" }),
    "Du musst sie erst erforschen. ");

  AddDetail( ({ "glueck" }),
    "Eine kleine Maerchenfee schwebt vorbei und drueckt Dir eine Portion "
    "Glueck in die Hand. ");

  AddDetail( ({ "hand" }),
    "Froehlich steckst Du das Glueck ein, und spuerst wie es ploetzlich "
    "Besitz ueber Deinen Koerper nimmt. ");

  AddDetail( ({ "maerchenfee", "fee" }),
    "Die ist leider schon wieder weg. ");

  AddDetail( ({ "portion" }),
    "Eine kleine Portion Glueck hat Dir eine Fee gerade in die Hand "
    "gedrueckt, und verschwand danach lautlos. ");

  AddDetail( ({ "koerper" }), 
    "Wohlig warm fuehlt er sich nun an. ");

  AddDetail( ({ "leuchten" }),
    "Es kommt aus dem Westen, und scheint Dich magisch anzuziehen. ");

  AddDetail( ({ "graeser" }),
    "Viele verschiedene Graeser wachsen auf Deinem Weg. Alle sind mit "
    "einer zarten weissen Schicht ueberzogen, wie Du sie bereits "
    "aus dem Kristallwald kennst. ");

  AddDetail( ({ "blumen" }),
    "Zarte weisse Blumen wachsen auf Deinem Weg. Ein besonders kleines "
    "Exemplar scheint Dir zuzuzwinkern. ");

  AddDetail( ({ "exemplar" }),
    "Eine kleine weisse Blume scheint Dir zuzuzwinkern.\n"
    "Da! Schon wieder!\n");

  AddDetail( ({ "blume" }),
    "Jetzt zwinkert sie schon wieder!\n"
    "Du kicherst.\n");

  AddDetail( ({ "himmel" }),
    "Der Himmel ist hoch ueber Dir - viel zu weit weg, um irgendetwas "
    "erkennen zu koennen. ");

  AddDetail( ({ "boden" }),
    "Auf dem Boden wuchern Blumen und Graeser der verschiedensten Arten. "
    "Sie sind allesamt mit einer weissen zarten Schicht ueberzogen. ");

  AddDetail( ({ "schicht" }),
    "Eindeutig eine Kristallschicht, wie man sie auch ueberall im Westen "
    "findet. Die Pflanzen scheinen wohl Ueberbleibsel des Kristallwaldes "
    "zu sein. ");

  AddDetail( ({ "ueberbleibsel" }),
    "Geh lieber nach Westen um Naeheres zu erfahren. ");

  AddDetail( ({ "naeheres" }),
    "<-- im Westen! ");

  AddDetail( ({ "kristallschicht" }),
    "Die Blumen und Graeser sind hier von einer zarten Kristallschicht "
    "ueberzogen, wie man sie auch westlich findet. ");

  AddDetail( ({ "wald", "kristallwald" }),
    "Du solltest weiter nach Westen gehen, um mehr ueber den Kristallwald "
    "zu erfahren. ");

  AddDetail( ({ "pflanzen" }),
    "Alles wuchert hier naturbelassen vor sich hin. ");

  AddDetail( ({ "arten" }),
    "Die Natur bringt unendlich viele Arten von Pflanzen hervor. ");

  AddDetail( ({ "natur" }),
    "Verweile einwenig hier, und Du wirst die Wunder der Natur am eigenen "
    "Leib erfahren koennen. ");

  AddDetail( ({ "leib" }),
    "Du musst schon etwas warten. ");

  AddDetail( ({ "wunder" }),
    "Das Wunder des Wachtums zum Beispiel. ");

  AddDetail( ({ "wachstum" }),
    "Alles waechst, um danach wieder abzusterben. So kann neues Leben "
    "entstehen. ");

  AddDetail( ({ "leben" }),
    "Altes Leben stirbt ab - neues entsteht. Das ist der Kreislauf der "
    "Natur. ");

  AddDetail( ({ "kreislauf" }),
    "Alles ist ein Kreislauf. Das ganze Leben. ");

  AddDetail( ({ "leben" }),
    "Du haeltst kurz inne, und freust Dich auf dieser Welt zu sein. ");

  AddDetail( ({ "silberland", "welt" }),
    "Das Silberland ist eine kleine Welt fuer sich. ");

  AddDetail( ({ "weg" }), 
    "Ueberall wachsen Blumen und Graeser. Einen ziemlich grossen Stein "
    "kannst Du in der Mitte des Weges erkennen. ");

  AddDetail( ({ "stein" }),
    "Ein grosser dunkler Stein liegt genau in der Mitte des Weges. Seine "
    "Oberflaeche wirkt schon ziemlich zerschunden und hat tiefe Furchen "
    "und Risse. ");

  AddDetail( ({ "oberflaeche" }),
    "Die Oberflaeche des Steine ist ziemlich zerschunden. Einige tiefe "
    "Furchen und Risse hat die Witterung bereits hinterlassen. ");

  AddDetail( ({ "witterung" }),
    "Die Witterung hat Spuren auf dem Stein hinterlassen. ");

  AddDetail( ({ "spuren" }),
    "Ganz deutlich kannst Du Furchen und Rillen erkennen. ");

  AddDetail( ({ "furchen", "rillen", "furche", "rille", "risse" }),
    "Bei naeherem Hinsehen faellt Dir auf, dass die Furchen und Rillen "
    "anscheinend nicht durch die Natur zustande gekommen sind. ");

  AddDetail( ({ "natur" }),
    "Hier war wohl nicht nur die Natur am Werk. ");

  AddDetail( ({ "werk" }),
    "Hier war nicht nur die Natur am Werk!");

  AddDetail( ({ "spiel" }),
    "Spielen kann man wunderbar in Midas. ");

  AddDetail( ({ "midas" }),
    "Midas, die allseits bekannte Hauptstadt. ");

  AddDetail( ({ "hauptstadt" }),
    "In der Hauptstadt des Silberlandes kannst Du Dich im Gluecksspiel "
    "mit anderen ueben. ");
 
  AddDetail( ({ "gluecksspiel" }),
    "Das musst Du schon selbst herausfinden. ");

  AddDetail( ({ "hinsehen" }),
    "Auf dem Stein scheint jemand einen Text eingeritzt zu haben. ");

  AddDetail( ({ "text" }),
    "Mit etwas Geschick wirst Du ihn sicherlich lesen koennen. ");

  AddDetail( ({ "geschick" }),
    "Probier es einfach. ");

  AddReadDetail( ({ "text" }), 
    "\n"
    "--> Wassertroepfchen\n"
    "\n");

  AddDetail( ({ "wassertroepfchen" }),
    "Anscheind scheint sie weiter oestlich zu wohnen, sonst wuerde "
    "der Wegweiser kaum darauf hinweisen. ");

  AddDetail( ({ "wegweiser" }),
    "Du wirst wohl mehr ueber sie erfahren, wenn Du weiter nach Osten "
    "vordringst. ");

  AddDetail( ({ "osten", "sueden", "westen", "norden", "nordosten", 
                "suedwesten", "suedosten", "nordwesten" }),
    "Du musst Dich schon selbst fuer eine Richtung entscheiden. ");

  AddDetail( ({ "richtung" }), 
    "Sie ist Dir ueberlassen. ");


  AddDetail( ({ "mitte" }),
    "In der Mitte des Weges liegt ein grosser dunkler Stein. ");

     
// SMELLS


  AddSmell(DEFAULT_SMELL, "Es duftet herrlich nach Waldluft und nach "
    "den Blumen am Wegrand. ");

  AddSmell( ({ "waldluft", "luft" }),
    "Herrlich! Du ziehst Dir die frische Waldluft durch die Nase!");

  AddSmell( ({ "nase" }),
    "Das will ich sehen, wie Du an Deiner eigenen Nase riechst!");

  AddSmell( ({ "wegrand", "weg", "rand" }),
    "Am Wegrand duften die Blumen!");

  AddSmell( ({ "blume", "blumen" }),
    "Das duftet einfach ueberwaeltigend!");


// SOUNDS

  AddSound(DEFAULT_SOUND, "Es ist hier sehr ruhig und entspannend. Nur "
    "manchmal rascheln die Blaetter etwas im Wind. ");

  AddSound( ({ "wind" }),
    "Der Wind laesst manchmal die Blaetter rascheln. ");

  AddSound( ({ "blaetter", "rascheln" }),
    "*raschel* *raschel* "); 


// CMDS

  AddCmd( ({ "zwinker", "zwinkere" }), "c_zwinkern");
  AddCmd( ({ "pflueck", "pfluecke" }), "c_pfluecken");
  AddCmd( ({ "ess", "esse", "iss" }), "c_essen");

}


int c_zwinkern(string str)
{
 if( str != "blume zu"     &&
     str != "blume" &&
     str != "exemplar zu"   )
 {
  notify_fail("Wem moechtest Du hier zuzwinkern?\n");
  return 0;
 }
 else
 {
  write(BS("Schelmisch zwinkerst Du der kleinen Blume zu. Sie zwinkert "
           "natuerlich sofort zurueck, und zaubert ein Schmunzeln in "
           "Dein Gesicht."));
  say(CTPN+ " schmunzelt froehlich.\n");
  return 1;
 }
}

int c_pfluecken(string str)
{
 if( str != "beere"  &&
     str != "beeren"  )
 {
  notify_fail("Was moechtest Du hier pfluecken?\n");
  return 0;
 }
 else
 {
  write(BS("Du zerrst an den Beeren, aber anscheinend moechte sich "
           "keine von Dir pfluecken lassen."));
  say(CTPN+ " zerrt an einem Strauch.\n");
  return 1;
 }
}

int c_essen(string str)
{
 if( str != "beere"  &&
     str != "beeren"  )
 {
  notify_fail("Was moechtest Du essen?\n");
  return 0;
 }
 else
 { 
  write(BS("Du solltest die Beeren schon vorher pfluecken, wenn Du sie "
           "essen moechtest."));
  say(CTPN+ " stellt sich ziemlich doof an.\n");
  return 1;
 }
}

