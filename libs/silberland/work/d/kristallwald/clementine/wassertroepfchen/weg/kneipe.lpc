
// FERTIG !

inherit "std/pub";

#include <properties.h>
#include <language.h>
#include "../carolina.h"
#include <pub.h>
#include <moving.h>



string *spieler_frosch;

void create()
{
  ::create();

  SetProp(P_INT_SHORT "Zum lusten Maulwurf");
  SetProp(P_INT_LONG, 
    "Du befindet Dich in der Kneipe 'Zum lustigen Maulwurf', die "
    "direkt in einem Maulwurfshuegel errichtet worden ist. Etwas verwundert "
    "bist Du schon, zumal der Huegel von aussen doch kleiner erschien, als "
    "er in Wirklichkeit ist. Hinter der Theke sitzt ein kleiner Maulwurf "
    "auf einem Hocker und bedient die vorbeieilenden Gaeste. Gleich neben dem "
    "Eingang haengt eine grosse Speisekarte, die Du mit <menue> lesen "
    "kannst. ");

  SetProp(P_LIGHT, 1); //weil man sonst ohne Lichtobj keinen Ausgang findet
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);

  SetProp(P_NOMAGIC, 500); //damit man sich nicht entfroscht

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER | PUB_NEEDSKEEPER );
  SetProp(P_PUBKEEPER_ID, "trudbert" );
  SetProp(P_PUBKEEPER_NAME, "Trudbert" );
  SetProp(P_PUBKEEPER_GENDER, MALE );


  AddItem(NPC "trudbert", REFRESH_DESTRUCT);
  AddItem(NPC "berta", REFRESH_DESTRUCT);
 
// ESSEN UND TRINKEN

  AddDrink( "Nektar", ({ "nektar" }),
    20, 10, 0, 3,
    ({ "Trudbert stellt Dir ein Glas mit frischem Nektar hin. Genussvoll "
       "trinkst Du es aus, und schleckst Dir danach sabbernd Deine Lippen "
       "ab.\n",
       "&& trinkt sabbernd ein Glas Nektar leer.\n" }) );

  AddDrink( "Hagebuttentee", ({ "tee", "hagebuttentee" }),
    50, 20, 0, 5,
    ({ "Trudbert serviert Dir eine Tasse mit heissem Hagebuttentee. Hmm..."
       "das schmeckt aber lecker!\n",
       "&& bekommt frischen Tee serviert.\n" }) );

  AddDrink( "Brennesselsaft", ({ "saft", "brennesselsaft" }),
    100, 50, 0, 10,
    ({ "Rasch trinkst Du ein Glaeschen Brennesselsaft aus, und fuehlst Dich "
       "danach frisch gestaerkt.\n",
       "&& trinkt ein Glaeschen Brennesselsaft.\n" }) );

  AddFood( "Grassalat", ({ "gras", "salat", "grassalat" }),
    35, 7, 2,
    ({ "Angewidert wuergst Du den Grassalat hinunter. Mhmm...gar nicht mal "
       "so schlecht...\n",
       "&& verzieht das Gesicht.\n" }) );

  AddFood( "Gaensebluemchenauflauf", ({ "auflauf", "gaensebluemchenauflauf" }),
    70, 40, 6,
    ({ "Trudbert bereitet Dir einen koestlichen Auflauf aus Gaensebluemchen "
       "zu.\n",
       "&& bekommt einen leckeren Auflauf serviert. *Sabber*\n" }) );

  AddFood( "Schwammerlragout", ({ "ragout", "schwammerlragout" }),
    200, 70, 3,
    ({ "Sabber, so ein koestliches Ragout hast Du noch nie in Deinem Leben "
       "gegessen. Ob Trudbert Dir das Rezept verraet?\n",
       "&& sabbert vor sich hin.\n" }) );


// DETAILBEGINN


  AddDetail( ({ "kneipe", "raum" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "ausgang", "ausgaenge" }),
	"Wie bist Du denn hier hereingekommen? Wo ein Eingang, da ein Ausgang! "
	"Oder bist Du etwa nicht durch das Loch des Huegels gekommen? ");

  AddDetail( ({ "loch" }),
	"Du koenntest Dich bei richtiger Groesse sicherlich durch das Loch "
	"nach draussen zwaengen. ");

  AddDetail( ({ "groesse" }),
	"Besonders gross sieht das Loch nicht aus, das heisst also, dass Du da "
	"nur durchkommst, wenn Du klein bist. Sonst bleibst Du womoeglich noch "
	"stecken!");
  
  AddDetail( ({ "huegel", "maulwurfshuegel" }),
    "Die Kneipe wurde in einem kleinen Maulwurfshuegel errichtet, der nun, "
    "bei naeherem Betrachten, gar nicht mehr so klein erscheint. ");

  AddDetail( ({ "waende", "wand" }),
    "Die Waende der Kneipe bestehen komplett aus Erde, einige Regale befinden "
    "sich hinter der Theke, in denen Glaeser stehen. Gleich neben dem Eingang "
    "haengt eine grosse Speisekarte. ");

  AddDetail( ({ "regal", "regale" }),
    "In den Regalen hinter der Theke befinden sich hauptsaechlich Glaeser. "
    "Aber auch einige Dosen kannst Du erkennen. Was darin wohl versteckt "
    "ist?! ");

  AddDetail( ({ "glaeser" }),
    "Die Glaeser braucht Trudbert um seine Gaeste bedienen zu koennen. ");

  AddDetail( ({ "dosen", "dose" }),
    "Welches Geheimnis die wohl in sich bergen? ");

  AddDetail( ({ "geheimnis" }),
    "Trudbert scheint sie wie seinen Augapfel zu hueten. ");

  AddDetail( ({ "augapfel" }),
    "Der Inhalt der Dosen scheint ziemlich wertvoll zu sein. ");

  AddDetail( ({ "inhalt" }),
    "Wie kommst Du bloss an den heran?! ");

  AddDetail( ({ "speisekarte", "karte" }),
    "Die Speisekarte besteht aus Holz. Du kannst sie mit <menue> lesen, "
    "um zu erfahren, welche Koestlichkeiten es hier gibt. ");

  AddDetail( ({ "eingang" }),
    "Gleich neben dem Eingang haengt eine grosse Speisekarte. ");

  AddDetail( ({ "hocker" }),
    "Ein kleiner Maulwurf sitzt auf einem Hocker aus Holz hinter der Theke, "
    "und bedient die vorbeieilenden Gaeste. ");

  AddDetail( ({ "holz" }), 
    "Du kannst leider nicht erkennen, um welches es sich handelt. ");

  AddDetail( ({ "gast" }),
    "Du bist doch auch ein Gast, oder? ");

  AddDetail( ({ "gaeste" }),
    "Ab und zu kommt ein Gast vorbei, und bestellt sich schnell eine "
    "Kleinigkeit. ");

  AddDetail( ({ "kleinigkeit" }),
    "Kuck Dir doch einfach die Speisekarte an, vielleicht hast Du dann auch "
    "Lust etwas zu Essen, oder zu Trinken. ");

  AddDetail( ({ "essen", "trinken" }),
    "Bei den leckeren Geruechen laeuft Dir schon das Wasser im Mund "
    "zusammen. Du solltest Dir wirklich eine der Koestlichkeiten bestellen. ");

  AddDetail( ({ "gerueche" }),
    "Riech doch einfach einmal! ");

  AddDetail( ({ "mund" }),
    "Ein Schwammerlragout waere jetzt genau das Richtige. ");

  AddDetail( ({ "schwammerlragout", "ragout" }),
    "Bestell Dir doch einfach eines. ");

  AddDetail( ({ "koestlichkeiten" }),
    "Die stehen alle auf der Speisekarte. ");

  AddDetail( ({ "wirklichkeit" }),
    "Der Huegel ist von innen viel groesser als Du anfangs dachtest. Naja, "
    "der Schein truegt manchmal, aber das weisst Du sicherlich selbst. ");

  AddDetail( ({ "schein" }),
    "Manchmal kann das Aussehen wirklich truegen, aber wenn Du so "
    "oberflaechlich bist, dann geschieht Dir das recht. ");

  AddDetail( ({ "aussehen" }),
    "Nichts und niemand ist wirklich so, wie es zu sein scheint. ");

  AddDetail( ({ "decke" }),
    "Die Decke befindet sich hoch ueber Dir. Manchmal broeckelt etwas "
    "Erde von ihr und Trudbert schiebt sie schnell mit seinen Schaufeln "
    "beseite. ");

  AddDetail( ({ "erde" }),
    "Der Huegel besteht aus dunkler fester Erde. ");

  AddDetail( ({ "boden" }),
    "Auf dem erdigen Boden kann man allerlei Fussspuren erkennen. ");

  AddDetail( ({ "spuren", "fusspuren", "fussspuren" }),
    "Sie stammen wohl von den verschiedensten Gaesten. ");

  AddDetail( ({ "wasser" }),
    "*sabber* ");

  AddDetail( ({ "richtige" }),
    "Bestell es Dir doch einfach! ");

  AddDetail( ({ "betrachten" }),
    "Die Kneipe stellte sich um einiges geraeumiger dar, als Du anfangs "
    "dachtest. ");

  AddDetail( ({ "lust" }),
    "Das musst Du schon selbst wissen. ");

  AddDetail( ({ "theke" }),
    "Eine hoelzerne Theke befindet sich an der Rueckwand der Kneipe. Hinter "
    "ihr sitzt ein kleiner Maulwurf und bedient seine Gaeste. ");

  AddDetail( ({ "rueckwand" }),
    "An der Rueckwand steht eine Theke, ueber die taeglich wohl mehrere "
    "Speisen und Getraenke wandern. ");

  AddDetail( ({ "getraenke", "speisen", "speise" }),
    "Wenn Du wissen moechtest, was es hier so gibt, dann lies doch einfach "
    "Die Speisekarte oder fragt Trudbert danach. ");

  AddDetail( ({ "frosch" }),
	"Tja, man muesste schon ein Frosch sein, um hier wieder rauszukommen. "
	"Vielleicht kannst Du Dir es ja wuenschen? ");
  
  AddDetail( ({ "licht", "lampe" }),
	"Jetzt wo Du genauer hinsiehst, siehst Du von der Decke eine "
	"Gluehbirne baumeln.");

  AddDetail( ({ "gluehbirne" }),
	"Obwohl Trudbert kein Licht benoetigt, haben es manche seiner Gaeste "
	"wohl trotzdem gerne hell.");

// DETAILENDE


// SMELLS

  AddSmell(DEFAULT_SMELL, "Mhmm... wie das hier nach Essen duftet! Da "
    "bekommt man richtig Appetit auf ein leckeres Schwammerlragout!");

  AddSmell( ({ "schwammerlragout", "ragout", "schwammerl" }),
    "So wie das duftet, schmeckt es sicherlich koestlich!");

  AddSmell( ({ "essen" }),
    "Da bekommt man ja richtig Hunger!!!");

  AddSmell( ({ "appetit", "hunger", "sicherheit" }),
    "Das kannst Du mit Sicherheit nicht riechen!");


// SOUNDS

  AddSound(DEFAULT_SOUND, "Manchmal hoert man Glaeser klirren. Anscheinend "
    "ist Trudbert nicht der vorsichtigste. ");

  AddSound( ({ "trudbert" }),
    "Trudbert schnauft. ");

  AddSound( ({ "klirren", "glaeser", "glas" }),
    "*klirr* *klirr* ... und wieder ein Glas weniger :)");


// CMDS

  AddCmd( ({ "kuess", "kuesse" }), "c_kuessen"); 
  AddCmd( ({ "zwaenge" }), "c_zwaengen");
  AddCmd( ({ "wuensch", "wuensche" }), "c_wuenschen");
  
  spieler_frosch = ({ }); 
  
}
void reset()
{
    ::reset();

	spieler_frosch = ({ }); 
}

int c_wuenschen(string str)
{
      if( !str )
	  {
		write(BS("Was moechtest Du Dir wuenschen?\n"));
		return 1;
      }

	  if( str != "frosch"  &&
	    ( str != "mich zum frosch" )) 
	  return 0;

	  if(TP->QueryProp(P_FROG))
	    {
		  tell_object(TP,"Aber Du bist doch bereits ein Frosch!\n");
		  return -1;
 	    }

	if(member(spieler_frosch,getuuid(TP)) != -1)
	    {
		  tell_object(TP,"Du kannst Dir momentan nichts wuenschen.\n");
		  return -1;
		}

	TP->SetProp(P_FROG, 1); 
	spieler_frosch += ({ getuuid(TP) }); 

	tell_object(TP,"Huch, alles wirkt auf einmal so groooooss.\n");

    return 1;
}



int c_kuessen( string str ) 
{
 write(BS("Trudbert will nicht, dass Du hier irgendjemand kuesst!"));
 return 1;
}

int c_zwaengen(string str)
{
 if( str != "durch loch" &&
     str != "durch loch hindurch" &&
     str != "durch loch durch" &&
     str != "in loch hinein" &&
     str != "in loch" )
 {
   notify_fail("Wohin des Weges?\n");
   return 0;
 }
 else
 {
  if(!(this_player()->QueryProp(P_FROG)) &&
	  (this_player()->QueryProp(P_RACE) != "Fee") )
  {
	  notify_fail("Wie willst Du Riese durch so einen kleinen Ausgang "
			   "passen?\n");
		        return 0;
  }
      return this_player()->move(WEG "weg3", M_GO,
		         "aus einem Loch", "klettert", "klettert herein");

 }
}

