
// fertig!

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../carolina.h"

create()
{
  ::create();
  SetProp(P_INT_SHORT, "Auf einem Waldweg");
  SetProp(P_INT_LONG,
    "Kleine Waldbewohner tummeln sich, auf der Suche nach Nahrung, zwischen "
    "Blumen und Graesern. Sanft streift der Wind durch die Blaetter der "
    "Baeume, und erzeugt ein leises Rascheln. Vereinzelt liegen auch noch "
    "ein paar kleine Steinchen auf dem Weg. Einige Ameisen haben, am "
    "Wegrand einen riesigen Ameisenhaufen errichtet. Gib bloss Acht, "
    "dass Du nicht hineinsteigst! ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "osten", WEG "weg5" );
  AddExit( "suedwesten", WEG "weg3" );



// DETAILBEGINN


  AddDetail( ({ "waldbewohner", "bewohner", "tierchen" }),
     "Ueberall tummeln sich kleine Tierchen auf der Suche nach Nahrung. "
     "Ueber den Blueten der Blumen schwirren einige Bienen und Hummeln, am "
     "Boden hingegen meinst Du Ameisen und viele verschiedene Kaefer "
     "erkennen zu koennen. ");

  AddDetail( ({ "suche" }),
    "Die kleinen Bewohner sind auf der Suche nach Nahrung. Hoffentlich "
    "werden sie alle fuendig. ");

  AddDetail( ({ "nahrung" }),
    "Auch so Kleine haben manchmal grossen Hunger. ");

  AddDetail( ({ "hunger" }),
    "Hast Du welchen?");

  AddDetail( ({ "kaefer" }),
    "Neben einer Familie von Mistkaefern kannst Du einen Marienkaefer, und "
    "noch ein paar andere erkennen. ");

  AddDetail( ({ "marienkaefer" }),
    "Der krabbelt gerade an einem Grashalm hoch, um neue Laeuse fuer sein "
    "Festmahl zu finden. ");

  AddDetail( ({ "festmahl", "mahl" }),
    "Hmm Laeuse! Lecker!");

  AddDetail( ({ "laeuse" }),
    "Naja, wems schmeckt...");

  AddDetail( ({ "familie" }),
    "Eine Familie Mistkaefer sucht nach neuem Mist. ");

  AddDetail( ({ "mist" }),
    "Sie werden sicherlich bald etwas finden. ");

  AddDetail( ({ "mistkaefer" }),
    "Du erkennst Mamamistkaefer, Papamistkaefer, und Kindmistkaefer. ");

  AddDetail( ({ "mamamistkaefer", "mama" }),
    "Mamamistkaefer ist kleiner als Papamistkaefer, aber groesser als "
    "Kindmistkaefer. ");

  AddDetail( ({ "papamistkaefer", "papa" }),
    "Papamistkaefer ist der Groesste - groesser als Mamamistkaefer und als "
    "Kindmistkaefer. ");

  AddDetail( ({ "kindmistkaefer", "kind" }),
    "Kindmistkaefer ist der Kleinste - kleiner als Mamamistkaefer und viel "
    "kleiner als Papamistkaefer. ");

  AddDetail( ({ "kleinste" }),
    "Kindmistkaefer ist wirklich klein. ");

  AddDetail( ({ "groesste" }),
    "Papamistkaefer ist wirklich sehr gross. ");

  AddDetail( ({ "blumen" }),
    "Ueberall wachsen bunte Blumen, deren Bluetenduft Bienen und Hummeln "
    "anzieht. ");

  AddDetail( ({ "bienen", "hummeln" }),
    "Sie werden von dem suessen Duft der Blueten angezogen, und suchen hier "
    "nach Nektar. ");

  AddDetail( ({ "nektar" }),
    "Ein wahres Schlemmermenue fuer so manche. ");

  AddDetail( ({ "schlemmermenue", "menue" }),
    "Du solltest es bei Zeiten einmal probieren. ");

  AddDetail( ({ "zeit", "zeiten" }),
    "Irgendwann einmal, wenn Du die Gelegenheit hast. ");

  AddDetail( ({ "gelegenheit" }),
    "Jetzt hast Du sie gerade nicht. ");

  AddDetail( ({ "bluetenduft", "duft" }),
    "Riech doch mal!");

  AddDetail( ({ "blueten", "bluete" }),
    "Die Blueten haben alle moegliche Farben. In ihnen befindet sich "
    "der kostbare Nektar. ");

  AddDetail( ({ "farben", "farbe" }),
    "Rosa, rot, gelb, weiss, violett, lila, gruen, blau, muellmannorange, "
    "tuerkis, gold, quietschentengelb, olivgruen, grau, "
    "spinatgruen, raucherbeinschwarz, jauchegrubenocker, pavianhinternpink, "
    "angroxachtzigerjahreneongruen, "
    "dreiwochenaltestomatengruenlichgraubraunschwarz, "
    "omamiederwarenbeige, "
    "mithammergeplaettetesdaumenviolett, und noch viele andere. "); 

  AddDetail( ({ "quietschentengelb" }),
    "Aeusserst quietschig gelb!");

  AddDetail( ({ "mithammergeplaettetesdaumenviolett" }),
    "Na da war der Heimwerkerking hoechstpersoenlich am Werk. ");

  AddDetail( ({ "spinatgruen" }),
    "... mit dem Blubb frischer Sahne!");

  AddDetail( ({ "raucherbeinschwarz" }),
    "Wenn Du weiter so fleissig rauchst, wirst auch Du bald diese "
    "Farbe in Deinen Lungenfluegeln bewundern koennen. ");

  AddDetail( ({ "omamiederwarenbeige" }),
    "Du beschliesst gleich morgen in einen Sanitaetsfachhandel zu gehen, "
    "und Dir ein Hoeschen mit passenden Stuetzstruempfen versteht sich, "
    "in dieser aufreizenden Farbe zu kaufen. ");

  AddDetail( ({ "jauchegrubenocker" }),
    "Dieses Jauchegrubenocker geilt Dich wirklich auf. Vielleicht solltest "
    "Du Deiner besseren Haelfte Unterwaesche in diesem verfuehrerischen "
    "Farbton schenken. ");

  AddDetail( ({ "rosa", "rot", "gelb", "weiss", "violett", "lila", "gruen",
                "blau", "tuerkis", "olivgruen", "grau" }),
    "Alles schoene Farben. ");

  AddDetail( ({ "pavianhinternpink" }),
    "Du beschliesst Dein Seherhaus sofort in dieser wunderbaren Farbe "
    "anzustreichen, wenn Du wieder daheim bist. ");

  AddDetail( ({ "seherhaus", "haus" }),
    "Wenn Du keines hast, solltest Du Dir unbedingt eins zulegen. ");

  AddDetail( ({ "angroxachtzigerjahreneongruen" }),
    "Fesch! Die Farbe hat exakt den gleichen Farbton wie Angrox' Stutzen!");

  AddDetail( ({ "dreiwochenaltestomatengruenlichgraubraunschwarz" }),
    "Ein guter Singlehaushalt weiss, wie so etwas genau aussieht. "
    "Konservierungsstoffe sind hier garantiert auch nicht mehr drinnen. ");

  AddDetail( ({ "gold" }),
    "Ein spezieller Farbwunsch von Andruil. ");

  AddDetail( ({ "andruil" }),
    "Frag ihn einmal wenn er hier ist. ");

  AddDetail( ({ "muellmannorange" }),
    "Das war ein spezieller Wunsch von Libella. ");

  AddDetail( ({ "libella" }),
    "Eine ganz tolle Magierin :)");
 
  AddDetail( ({ "magierin" }),
    "Libella!");

  AddDetail( ({ "wunsch", "wuensche", "farbwunsch" }),
    "Wuensche werden erfuellt!");  

  AddDetail( ({ "acht" }),
    "Hier ist wirklich aufpassen angesagt, damit Du nicht aus Versehen in "
    "den Ameisenhaufen hineintrampelst. ");

  AddDetail( ({ "versehen" }),
    "Sowas waere nicht gerade angenehm. ");

  AddDetail( ({ "steinchen", "steine" }),
    "Ein paar Steinchen liegen hie und da auf dem Weg. Aber Du kannst "
    "wirklich nichts Ungewoehnliches an ihnen erkennen. ");

  AddDetail( ({ "ungewoehnliches" }),
    "Da ist wirklich nichts. ");

  AddDetail( ({ "rascheln" }),
    "Lausch doch mal!");

  AddDetail( ({ "weg", "pfad", "trampelpfad", "boden" }),
    "Einige Steinchen liegen auf dem Weg. Hin und wieder wird er auch von "
    "einigen Tierchen ueberquert. ");

  AddDetail( ({ "ameisenhaufen", "haufen" }),
    ([ 
    0: "Ein dicker fetter Ameisenhaufen, in dem es so richtig schoen wurlt, "
       "befindet sich am Wegrand. Er ist richtig imposant, da er fast die "
       "gleiche Groesse wie Du hat. Hineinsteigen moechtest Du hier wirklich "
       "nicht. ",
    "fee":"Ein riesiger Ameisenhaufen, in dem es so richtig schoen wurlt, "
       "befindet sich am Wegrand. Irgendwie schuechtert er Dich etwas ein, "
       "da er viel viel groesser ist als Du. Naja, bei Deiner Groesse ist "
       "das nicht verwunderlich!" ]) );

  AddDetail( ({ "himmel" }),
    "Vom blauen Himmel strahlt die Sonne herunter. Ein richtig schoener "
    "Tag! ");

  AddDetail( ({ "sonne" }),
    "Die Sonne steht hoch am Himmel. ");

  AddDetail( ({ "tag" }),
    "Ein richtig schoener Tag heute, nicht wahr?!");

  AddDetail( ({ "wind" }),
    "Den Wind kannst Du nicht sehen! Hoechstens spueren oder erlauschen. ");

  AddDetail( ({ "ameisen" }),
    "Die meisten Ameisen tummeln sich auf dem riesigen Ameisenhaufen, da "
    "dieser ja ihr Zuhause ist. Einige suchen aber auch zwischen den Graesern "
    "nach Brauchbarem. ");

  AddDetail( ({ "zuhause" }),
    "Der Ameisenhaufen ist das Zuhause der Ameisen hier. Sie wuerden ihn "
    "sicherlich mit ihrem Leben verteidigen. ");

  AddDetail( ({ "leben" }),
    "Sie wuerden ihr kostbarstes Gut geben, um ihren Haufen zu retten. ");

  AddDetail( ({ "gut" }),
    "Ihr Leben!");

  AddDetail( ({ "brauchbarem" }),
    "Sie suchen nach Nahrung, oder anderen brauchbaren Dingen. ");

  AddDetail( ({ "dinge" }),
    "Kleine Aeste und Zweige fuer ihren Haufen. ");

  AddDetail( ({ "zweige", "aeste" }),
    "Alles moegliche einfach. ");

  AddDetail( ({ "grashalm", "halm" }),
    "Dieser kleine getupfte Freund ist ganz schoen flink. ");

  AddDetail( ({ "freund" }),
    "Na der Marienkaefer! ");

  AddDetail( ({ "wegrand" }),
    "Neben vielen Blumen, Graesern und Baeumen siehst Du auch einen "
    "riesengrossen Ameisenhaufen am Wegrand. ");

  AddDetail( ({ "graeser", "halme" }),
    "Viele verschiedene Graeser wachsen am Wegrand und bieten genug Nahrung "
    "fuer all die kleinen Krabbler. In einer Notsituation wuerden sie "
    "bestimmt auch ein gutes Versteck abgeben. ");

  AddDetail( ({ "versteck" }),
    "Unter den Halmen kann man sich sicherlich einmalig verstecken. ");
 
  AddDetail( ({ "notsituation" }),
    "Zum Glueck ist alles in Ordnung! ");

  AddDetail( ({ "ordnung" }),
    "Alles ist okay. ");

  AddDetail( ({ "glueck" }),
    "Du atmest erleichtert auf. ");

  AddDetail( ({ "krabbler" }),
    "Na kuck sie Dir doch an die Kleinen!");

  AddDetail( ({ "kleine" }),
    "Kleine sind oft lieber als Grosse :)");

  AddDetail( ({ "grosse" }),
    "Die sind natuerlich auch oft sehr lieb. ");

  AddDetail( ({ "baum", "baeume" }),
    "Vereinzelt wachsen einige Baeume entlang des Weges. Manchmal blaest der "
    "Wind durch ihr Blaetterdach und man hoert ein leises Rascheln. ");

  AddDetail( ({ "blaetterdach", "blaetter" }),
    "Das Blaetterdach der Baeume ist nicht sehr dicht. Deutlich kannst Du "
    "die Umrisse der einzelnen Blaetter erkennen. ");

  AddDetail( ({ "umrisse" }),
    "Die Umrisse der Blaetter weisen ein gezacktes Muster auf. Ausserdem "
    "erkennst Du, dass die Unterseite der Blaetter dunkelgruen ist. Welcher "
    "Baum das sein koennte?! ");

  AddDetail( ({ "unterseite" }),
    "Die Unterseite der Blaetter ist dunkelgruen. Zumindest erscheint es "
    "Dir von hier aus so. ");

  AddDetail( ({ "muster" }),
    "Die Raender der Blaetter sind ziemlich gezackt. ");

  AddDetail( ({ "raender" }),
    "-- zick zack zick zack --");

  AddDetail( ({ "zick zack" }),
    "Selbst Clementine weiss nicht mehr welcher Baum das ist.");


// SMELLS

  AddSmell(DEFAULT_SMELL, "Du geniesst die Frische der Natur!");

  AddSmell( ({ "frische" }),
    "Duftet toll!");

  AddSmell( ({ "natur" }),
    "Alles riecht frisch und angenehm. Einfach toll!");

  AddSmell( ({ "blumen", "blume", "blumenduft", "duft" }),
    "Die Blumen riechen herrlich!");

// SOUNDS

  AddSound(DEFAULT_SOUND, "Der Wind laesst die Blaetter der Baeume rascheln. "
    "Ausserdem hoert man ein 'Wurrln'.");

  AddSound( ({ "wurrln" }),
    "Als ob viele Tierchen uebereinander, umeinander, untereinander "
    "rumkrabbeln wuerden. Das kommt wohl von den Ameisen!");

  AddSound( ({ "ameisen", "ameise" }),
    "Die Ameisen sind viel zu schnell, als dass Du an einer lauschen "
    "koenntest. ");

  AddSound( ({ "rascheln", "blaetter", "wind" }),
    "Die Blaetter rascheln im Wind. ");


// CMDS

  AddSpecialDetail( ({ "groesse" }), "groessefunc");   

  AddCmd( ({ "spuer", "spuere" }), "c_spueren");


}

int c_spueren(string str)
{
 if(str != "wind" )
 {
  notify_fail("Was moechtest Du spueren?\n");
  return 0;
 }
 else
 {
  write(BS("Der leichte Windhauch macht Dir eine Gaensehaut an den Armen."));
  say(CTPN + " bekommt eine Gaensehaut.\n");
  return 1;
 }
}


string groessefunc( string str )
{
  write(BS("Du misst ganze "+this_player()->QueryProp(P_SIZE)+" cm. "));
  return "";
}

