
// FERTIG!

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../carolina.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Auf einem Weg");
  SetProp(P_INT_LONG, 
    "Vogelgezwitscher klingt von den Baeumen an Dein Ohr. Irgendwo in "
    "den Baumkronen scheinen sich ein paar Piepmaetze versteckt zu haben, "
    "die nun froehlich ihr Liedchen pfeifen. Hier ist das Gras besonders "
    "hoch, dennoch kannst Du eine kleine Raupe erkennen, die neben dem Wegrand "
    "auf einem rosaroten Pilz sitzt. Ein etwas strenger Geruch scheint von "
    "dem kleinen Gesellen auszugehen. "); 
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_KILL_NAME, "Ohrenlangziehen");
  
  AddExit( "westen", WEG "weg4" );
  AddExit( "nordosten", WEG "weg6" );



// DETAILBEGINN

  
  AddDetail( ({ "vogelgezwitscher", "gezwitscher" }),
     "Na lausch doch mal!");

  AddDetail( ({ "ohr" }),
     "So sehr Du Dich auch verbiegst, aber Dein Ohr kannst Du wirklich "
     "nicht sehen. Aber vielleicht daran ziehen?");

  AddDetail( ({ "lied", "liedchen", "pfeifen" }),
     "Also sowas kannst Du nicht sehen - lausch doch mal!");

  AddDetail( ({ "piepmaetze", "maetze" }),
     "Leider kannst Du keinen entdecken, da die Baumkronen viel zu "
     "dicht sind. Aber lauschen wirst Du ihnen sicherlich koennen. ");

  AddDetail( ({ "geruch" }),
     "Na riech doch mal!");

  AddDetail( ({ "geselle" }),
     "Ein kleiner gruener Geselle sitzt am Wegrand auf einem Pilz und pustet "
     "immer wieder Rauch aus seinem Mund. ");

  AddDetail( ({ "rauch" }),
     "Igitt! Das qualmt hier vielleicht! Pfui!");

  AddDetail( ({ "mund" }),
     "Immer wieder kommen einige Rauchwoelkchen aus dem Mund des kleinen "
     "Gesellens, dessen suffizientes Grinsen Dir doch etwas Seltsam "
     "vorkommt. ");

  AddDetail( ({ "rauchwoelkchen", "woelkchen" }),
     "Sie nebeln Dich manchmal regelrecht ein. Widerlich!");

  AddDetail( ({ "grinsen" }),
     "Wirklich nicht alltaeglich dieses Grinsen. Ob es etwas mit dem Rauch "
     "zu tun hat? ");

  AddDetail( ({ "seltsam" }),
     "Naja vielleicht trifft hier bloss der Satz: In der Kuerze liegt die "
     "Wuerze, in der Breeeeeeeeeeeeeite liegt die Weeeeeeeeeeeeite zu. ");

  AddDetail( ({ "satz", "kuerze", "wuerze", "breite", "weite" }),
     "Also ich glaube das verstehst Du schon ganz alleine. ");

  AddDetail( ({ "breeeeeeeeeeeeeite", "weeeeeeeeeeeeite" }),
     "Wirklich sehr gekonnt wie Du hier die ganzen e's eingetippselt hast. "
     "Aber ob das etwas bringt? ");

  AddDetail( ({ "wegrand", "rand" }),
     "Obwohl das Gras hier besonders hoch ist, erkennst Du am Rand des Weges "
     "einen rosaroten Pilz, auf dem eine Raupe sitzt. ");

  AddDetail( ({ "gras" }),
     "Das Gras wuchert an diesem Wegabschnitt besonders fleissig und hoch. "
     "Vereinzelnd wird es natuerlich auch von einigen Graesern durchzogen. ");

  AddDetail( ({ "graeser" }),
     "Du meinst Spitzwegerich erkennen zu koennen und auch Schafgarbe. ");

  AddDetail( ({ "spitzwegerich" }),
     "Die langen Halme des Spitzwegerichs hast Du sofort erkannt. Er ist auch "
     "unverwechselbar. ");

  AddDetail( ({ "schafgarbe" }),
     "Die grossen weissen Dolden der Schafgarbe gedeihen wunderbar hier. ");

  AddDetail( ({ "halme", "dolden" }),
     "Du bist so ein Kenner, da braucht man Dir das ja wohl auch nicht "
     "erklaeren. ");

  AddDetail( ({ "kenner" }),
     "Biologe trifft es wohl eher. ");

  AddDetail( ({ "biologe" }),
     "Meisterhaft! ");

  AddDetail( ({ "weg", "weges", "wegabschnitt" }),
     "Ein besonders schoener Weg schlaengelt sich hier durch. Das Gras "
     "wuchert nur so, und das Vogelgezwitscher stimmt Dich froehlich. ");

  AddDetail( ({ "baumkronen", "kronen" }),
     "Die Baeume hier haben besonders dicke Baumkronen, sodass es sogar "
     "die Sonnenstrahlen schwer haben sich ihren Weg durchzubahnen. ");

  AddDetail( ({ "sonnenstrahlen", "strahlen", "sonne" }),
     "Die Sonne steht hoch am Himmel und schickt Dir ihre Strahlen. ");

  AddDetail( ({ "himmel" }),
     "Hoch auf diesem wolkenlosen Himmel steht die Sonne, und erwaermt hier "
     "unten alles mit ihren Strahlen. ");

  AddDetail( ({ "wolken" }),
     "Keine einzige weit und breit am Himmel zu sehen. ");

  AddDetail( ({ "boden" }),
     "Der Boden hier ist wild mit Gras ueberwuchert. ");

  AddDetail( ({ "baeume", "baeumen" }),
     "Grosse stramme Baeume wachsen gen Himmel. Dick und kraeftig sind ihre "
     "Aeste und vermoegen sicherlich so einiges zu tragen. ");
  
  AddDetail( ({ "baum" }),
	 "Hier gibts viele davon!");
  
  AddDetail( ({ "aeste", "ast" }),
     "Die Aeste sind dick und kraeftig und vermoegen sicherlich einiges zu "
     "halten. Dir kommt ploetzlich eine Idee. ");

  AddDetail( ({ "idee" }),
     "Ich weiss doch nicht, welche Idee Du hast :)");

  AddDetail( ({ "raupe" }),
    "Irgendwie kommt sie Dir sehr bekannt vor. Sie sitzt einfach auf ihrem "
    "Pilz und raucht Wasserpfeife. ");

  AddDetail( ({ "pilz" }),
    "Ein rosaroter Pilz steht direkt neben dem Wegrand. Eine kleine rauchende "
    "Raupe sitzt auf seiner Kappe, und blinzelt Dich an. ");

  AddDetail( ({ "kappe" }),
    "Die rosarote Kappe des Pilzes verwundert Dich schon ein wenig, aber noch "
    "mehr die kleine Raupe, die auf ihr sitzt, und munter an einer "
    "Wasserpfeife nuckelnd. ");

  AddDetail( ({ "wasserpfeife", "pfeife", "teil" }),
    "Ein wirklich interessantes Teil, was die kleine Raupe da vor sich stehen "
    "hat. Unmengen von Schlaeuchen durchziehen es. An einem von ihnen, zuzelt "
    "immer wieder die kleine Raupe, und blaesst seltsame Ringe in die Luft. ");

  AddDetail( ({ "schlaeuche" }),
    "Unzaehlige Schlaeuche durchziehen die Pfeife. Am Ende von einem zuzelt "
    "und nuckelt immer wieder die kleine Raupe. ");

  AddDetail( ({ "ende" }),
    "Am Ende eines Schlauches nuckelt unsere kleine Raupe. ");

  AddDetail( ({ "schlauch" }),
    "Der Raupe scheint dieses Nuckeln und Zuzeln wirklich viel Spass zu "
    "machen! Probier es doch auch einmal!");

  AddDetail( ({ "nuckeln", "zuzeln" }),
    "Scheint ne tolle Sache zu sein. ");

  AddDetail( ({ "sache" }),
    "Probier es doch einmal aus. ");

  AddDetail( ({ "spass" }),
    "Es scheint sehr entspannend zu sein. ");

  AddDetail( ({ "ringe" }),
    "Kleine Ringe pustet die Raupe immer und immer wieder in die Luft, es "
    "scheint, als waere diese Taetigkeit ziemlich entspannend. ");

  AddDetail( ({ "taetigkeit" }),
    "Nennen wir diese Taetigkeit doch einfach Rauchen. ");

  AddDetail( ({ "rauchen" }),
    "Aufgrund des Untersuchens dieses Details hast Du einen Forscherpunkt "
    "gewonnen.\n"
    "Gratulation!\n");

  AddDetail( ({ "forscherpunkt", "punkt" }),
    "Niemand zuvor hat das Detail Rauchen untersucht! ");

  AddDetail( ({ "detail" }),
    "Gibt viele hier, meinst Du ein bestimmtes? ");

  AddDetail( ({ "gratulation" }),
    "Jemand teilt Dir mit: GRATS!!!!\n"
    "Clementine teilt Dir mit: wirklich gut gemacht! :)\n");

  AddDetail( ({ "untersuchen" }),
    "Das machst Du wirklich unheimlich gut. ");

  AddDetail( ({ "luft" }),
    "Die Raupe blaest kleine Ringe in die Luft. "); 


// SOUNDS

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Vogerl ihr Liedchen "
    "zwitschern. ");

  AddSound( ({ "vogerl", "voegel" }),
    "Ein paar Voegel zwitschern in den Baeumen.");

  AddSound( ({ "baeume", "baum" }),
    "Du streckst Dein Ohr hoch zu den Baeumen und hoerst das Zwitschern nun "
    "noch deutlicher!");

  AddSound( ({ "liedchen" }),
    "*piep* *piep* ");

  AddSound( ({ "zwitschern" }),
    "*Piep* *piep* piep* piiiiiiiiiiiiiiiiiiiiiep* *piep* *piep*, *piep* piep* "
    "*piep* *piiiiiiiiiiiiiiiiiiiiiiiiiep* *piep* *piep*... *PIEP* *piep* "
    "*piep* *piep*....");


// SMELLS

  AddSmell(DEFAULT_SMELL, "Ein etwas sonderbarer Geruch geht von einer "
    "kleinen Raupe aus, die am Wegrand sitzt. ");

  AddSmell( ({ "geruch" }),
    "Nicht wirklich sehr betoerend!");

  AddSmell( ({ "raupe" }),
    "Die Raupe riecht nach Raupe, allerdings riecht ihre Pfeife gar "
    "fuerchterlich - zumindest, das was herauskommt. ");

  AddSmell( ({ "rauch" }),
    "Du musst Dich sehr beherrschen, dass Du Dich nicht uebergibst. ");

  AddSmell( ({ "pfeife" }),
    "Wuerg! Das riecht aber ekelhaft!");


// CMDS
 
  AddCmd( ({ "ziehe", "zieh" }), "c_ziehen" );  
  AddCmd( ({ "nuckel", "nuckele", "zuzele", "zuzle", "nuckle",
	     "saug", "sauge", "zuzel" }), "c_rauchen"); 
  AddCmd( ({ "schaukel", "schaukle", "baumel", "baumle", "haenge" }), 
     "c_schaukeln");  

}

int c_schaukeln(string str)
{
  if( str != "auf ast"  &&
	  str != "an ast"   &&
	  str != "auf aesten" &&
	  str != "an aesten" )
  {
	notify_fail("Was moechtest Du genau machen?\n");
	return 0;
  }
  else
  {
	TP->SetProp(P_PARALYZED,
    ([ PARALYZE_TIME: 10,
	   PARALYZE_MSG: "Du schaukelst doch gerade! Geniess es doch!\n",
	   PARALYZE_MSG_OTHER: "%s rudert wie ein Idiot mit den Beinen.\n",
      PARALYZE_END: "",
      PARALYZE_END_OTHER: ""]));

	  call_out("sp0", 1);
	  return 1;
     }
}

void sp0()
{
   if(!TP) return;
   write("\n");
   write(BS("Elegant huepfst Du in die Hoehe, greifst nach einem "
		 "Ast und beginnst grazil zu schaukeln."));
   call_out("sp1", 3);
   say(CTPN+ " huepft ziemlich unbeholfen zu einem Ast und beginnt seltsame "
	   "Bewegungen auszufuehren.\n");
}

void sp1()
{
   if(!TP) return;
   write("\n");
   write(BS("Diese tolle Aussicht von hier oben... Wie ein Trapezkuenstler "
		 "schaukelst Du auf Deinem Ast..."));
   call_out("sp2", 3);
   say("Ob der Ast das noch lange mitmacht? ;)\n");
}

void sp2()
{
  if(!TP) return;
  write("\n");
  write(BS("RUUUUUMMMMS....DOCH ZU FETT! ;) PLUMPS! AUA!"));
  say("RUUUMPPS!\n");
  say(CTPN+ " landet auf dem Popo.\n");
  TP->SetProp(PARALYZE_TIME, 0); 

}
  

int c_ziehen(string str)
{
  if(str != "an ohr" )
  {
	notify_fail("Woran moechtest Du ziehen?\n");
	return 0;
  }
  else
  {
	write(BS("Du ziehst so richtig fest an Deinen Ohren. AUAAAAA!!!"));
	TP->do_damage(5+random(10), this_object());
	return 1;
  }
}

int c_rauchen(string str)
{
  if(str != "an schlauch" )
  {
	notify_fail("Woran moechtest Du zuzeln?\n");
	return 0;
  }
  else
  {
	write(BS("Du ziehst einmal kraeftig an dem Schlauch...und laeufst "
		  "ziemlich schnell gruen an. *HUST* *HUST* *IGITTIGITT*"));
	say(CTPN+ " macht sich an der Pfeife zu schaffen, und laeuft danach "
		"irgendwie gruen an... Igitt, jetzt wirst Du auch noch angehustet.\n");
	return 1;
  }
}

