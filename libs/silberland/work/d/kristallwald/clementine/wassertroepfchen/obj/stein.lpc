inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../carolina.h"

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein cooler Duftstein");
  SetProp(P_LONG,
   "Boah! Ein Duftstein! Der ist aber cool!!! "
   "Und wie herrlich der erst riecht!");
  SetProp(P_NAME, "Duftstein");
  AddId( ({ "stein", "duftstein" }) );
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_STONE);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);
  SetProp(P_INFO, "Der Stein erinnert Dich an Indien.\n");
  SetProp(P_SMELL, "Irgendwie riecht der Stein doch nicht so umwerfend.\n");

}

string extra_look()
{
 return(environment()->Name(WER))+" stinkt nach billigen indischen "
           "Raeucherstaebchen - pfui!!\n";
}


