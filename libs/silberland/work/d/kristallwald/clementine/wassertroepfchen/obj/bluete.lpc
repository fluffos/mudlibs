
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../carolina.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Lindenbluete");
  SetProp(P_LONG, 
   "Eine Lindenbluete hat schon ein ziemlich eigenwilliges Aussehen. "
   "Seitlich um die Bluete hat sie kugelfoermige Fruechte - in der Mitte "
   "befindet sich eine weisse Bluete mit mehreren laenglichen gelben "
   "Staubblaettern. Da hat sich die Natur aber etwas ganz Besonderes "
   "ausgedacht. ");
  SetProp(P_NAME, "Lindenbluete");
  AddId( ({ "bluete", "lindenbluete", "\nbluete", "\nQUESTKRAUT" }) );
  SetProp(P_MATERIAL, MAT_MISC_HERBAL);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 40);
  SetProp(P_VALUE, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_INFO, "Ein Tee mit Lindenblueten wirkt gut bei Husten.\n");

  AddDetail( ({ "besonderes" }),
    "Sieht wirklich aussergewoehnlich aus. ");

  AddDetail( ({ "natur", "perfektion" }),
    "Die Perfektion der Natur ist unuebertrefflich.");

  AddDetail( ({ "fruechte" }),
    "Die Fruechte sind fast kugelig, sehr duennschalig und zerbrechlich. "
    "Gib also gut auf die Bluete Acht!");

  AddDetail( ({ "acht" }),
    "Wenn Du nicht Acht gibst beschaedigst Du sie vielleicht noch.");

  AddDetail( ({ "staubblaetter" }),
    "Die Staubblaetter sind fast drei Zentimeter lang und gelblich.");

  AddDetail( ({ "zentimeter" }),
    "Fast drei!");

 

}


