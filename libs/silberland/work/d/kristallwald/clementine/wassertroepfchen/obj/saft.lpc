#include "../carolina.h"
#include <properties.h>
#include <language.h>
#include <food.h>

inherit "std/food";

#define MAXITEMS 3

void create()
{
 if(!is_clone(TO)) return;

  ::create(({"trink", "trinke"}));

  SetProp(P_SHORT, "Ein Saft");
  SetProp(P_LONG,
    "Eine ganz normale Saftflasche.");
  SetProp(P_NAME, "Saft");
  SetProp(P_GENDER, MALE);
  AddId( ({ "flasche", "saft" }) );
  SetProp(P_ARTICLE, 1);

//  SetProp(P_INFO,
//      "." );

  SetProp(P_MATERIAL, ([MAT_MISC_FLUID:90, MAT_MAGIC:10]) );
  SetProp(P_WEIGHT, 150);
  SetProp(P_SIZE, 10);
  SetProp(P_VALUE, 1000);

  SetProp(P_FOOD_STATE, F_RAW);
  SetProp(P_FOOD_INFO, ([ F_DRINK: 6,
                          F_MSG: "Du trinkst den Saft aus.\n",
                          F_MSG_ROOM: "trinkt einen Saft.\n",
                          F_MSG_DECAY: "Der Saft vergaehrt.\n",
                          F_VERB: "trinken" ]));

//  start_decay(250000 + random(250000), -1);
    start_decay(10, -1);
}

void initSaft(string *names)
{
  int i;	
  string m_name;
  m_name = "";

  if(!pointerp(names) || (sizeof(names) > MAXITEMS))
    return;


  for(i = 0; i < sizeof(names); ++i)
    m_name += lower_case(names[i]);
  m_name = capitalize(m_name + "saft");

  SetProp(P_NAME, m_name);
  SetProp(P_SHORT, "Ein " + m_name);
}
