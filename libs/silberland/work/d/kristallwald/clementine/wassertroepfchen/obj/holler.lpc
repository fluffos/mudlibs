
inherit "std/food";

#include <properties.h>
#include <language.h>
#include <food.h>
#include "../carolina.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Hollerblueten");
  SetProp(P_LONG,
    "Du haeltst ein paar Hollerblueten in Deiner Hand, die sich sicherlich "
    "wunderbar in einem Tee machen wuerden. Ein intensiver Geruch geht von "
    "ihnen aus, und Du schmeckst so richtig den Fruehling auf Deiner Zunge. ");
  SetProp(P_NAME, "Hollerblueten" );
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "blueten", "holler", "hollerblueten", "\nholler", 
	     "\nQUESTKRAUT" }) );
  SetProp(P_MATERIAL, MAT_MISC_PLANT);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 25);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SMELL, "Die riechen aber gut!\n");
  
  SetProp(P_INFO, "Roh solltest Du sie lieber nicht essen!\n");

  SetProp(P_FOOD_INFO,
     ([ F_HEAL: ({ -10,-10 }),
        F_SOAK: 2,
        F_MSG: "Du stopfst Dir die Hollerblueten in den Mund. Pfui!",
        F_MSG_ROOM: "stopft sich Hollerblueten in den Mund."]) );
}

void BeimEssen()
{ 
 if(random(750)<20)
 SetProp(P_FOOD_INFO, QueryProp(P_FOOD_INFO)+([F_POISON:1]));
}  

  



