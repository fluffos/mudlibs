
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../carolina.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein helles Efeublatt");
  SetProp(P_LONG, "Ein helles Efeublatt. Wofuer es wohl gut ist?");
  SetProp(P_NAME, "Efeublatt");
  AddId( ({ "efeublatt", "blatt", "\nefeu", "\nQUESTKRAUT" }) );
  SetProp(P_MATERIAL, MAT_MISC_HERBAL);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 40);
  SetProp(P_VALUE, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOBUY, 0);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_INFO, "Efeu sagt man eine schleimloesende Wirkung nach.\n");

}

