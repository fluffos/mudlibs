#include "/d/kristallwald/clementine/wassertroepfchen/carolina.h"
#include <container.h>
#include <moving.h>
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <wizlevels.h>

inherit "std/container";

#define MAXITEMS 3
// wir verbieten die id saft, weil troxa sich bloed gespielt hat und 
// mehrzeilige saftitems produziert hat... 10/2011

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,
    "Eine ziemlich alt aussehende Weinpresse steht in der Mitte des Raumes. "
    "Trotz ihres Alters scheint sie allerdings voll funktionstuechtig zu sein. "
    "Sie besteht aus einem grossen oben offenem Fass, in das man alles was "
    "zu pressen ist hineingeben kann. "
    "Seitlich hat sie eine Hebelvorrichtung und einen Auffangbehaelter, der "
    "das Gepresste dann wohl auffaengt. ");
  SetProp(P_NAME, "Weinpresse");
  AddId( ({ "presse", "weinpresse" }) );

  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOGET, 1);
  SetProp(P_MAX_WEIGHT, 10000);

  AddCmd("zieh|ziehe&hebel", "cmd_ziehe", "Was willst Du ziehen?");
//  AddCmd( ({"gib", "geb", "leg", "gebe" }), "c_geben");
}
string short()
{
  return "";
}

varargs string long()
{
  string str;
  string invl;

//  invl = make_invlist(PL, all_inventory(ME),
//  TP ? (TP->QueryProp(P_SHORTINV) ? 0 : 2) :0);
  invl = make_invlist(TP, all_inventory(),
                   interactive(TP) ? (TP->QueryProp(P_SHORTINV) ? 2 : 0) : 0);

//  if (!stringp(str) ) str = "";
  str = QueryProp(P_LONG);

  if(invl != "")
    str += "Momentan siehst Du folgendes in der Weinpresse:\n" + invl;

  return str;
}

// neu
varargs int PreventInsert(object ob)
{
  object* inv;
  int i;
  inv = all_inventory();

  if( ob->QueryProp(P_CURSED) ||
      ob->id("saft")          ||	  
      ob->id("QUESTOBJ"))
  {
    notify_fail(BS("Das willst Du lieber nicht in die Presse legen."));
    return 1;
  }

  if(!IS_LEARNING(TP) &&
     ((TP->QueryProp(P_SIZE) < 90) || (TP->QueryProp(P_FROG) == 1) ))
  {
    notify_fail(BS("Du reckst und streckst Dich, aber Du bist zu klein "
                   "um etwas in die Presse zu legen."));
    return 1;
  }

  if(sizeof(inv) >= MAXITEMS)
  {
   TP->Message(BS("Das Fass ist voll!"));
    return -1;
  }
 /* //foreach(object ob : inv)
  for (i=sizeof(inv)-1; i>=0; i--) {
    if(inv[i]->name(RAW) == inv[i]->name(RAW))
    {
        notify_fail(BS("Im Fass der Presse ist bereits "
                       + inv[i]->name(WEN, 0) + "."));
        return 1;
    }
  }
*/
  return ::PreventInsert(ob);
}

// neu
varargs int PreventLeave(object ob)
{
  if(!IS_LEARNING(TP) &&
     ((TP->QueryProp(P_SIZE) < 90) || TP->QueryProp(P_FROG) == 1 ))
  {
    notify_fail(BS("Du bist einfach zu klein um etwas aus der "
                "Presse zu nehmen."));
    return 1;
  }

  return ::PreventLeave(ob);
}

// neu
int cmd_ziehe(string str)
{
  environment(TP)->Message(
                    BS(TP->Name() + " zieht den Hebel der Weinpresse."),
                       MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE:({TP})]));
  write("Du ziehst den Hebel der Weinpresse.\n");

  if(sizeof(all_inventory(TO)) == 0)
  { write(BS("Du hast doch noch gar nix in die Presse gelegt.")); 
	  return -1;
  }

  if( find_call_out("press") == -1 )
    call_out("press", 1);

  return 1;
}

// neu
void press()
{
  object* objects;
  string* names;
  object ob;
  int ret,i;

  names = ({});
  objects = present_objects("alles");

  if(sizeof(objects) && ob = clone_object("/d/kristallwald/clementine/wassertroepfchen/obj/saft"));
  {
    environment(TP)->Message(
                      BS(TP->Name() + " presst etwas aus und fuellt den Saft "
                         "in eine bereitstehende Flasche."),
                         MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE:({TP})]));
    write(BS("Du presst etwas aus und fuellst den Saft in eine "
          "bereitstehende Flasche.\n"));

    // Namen holen
    //foreach(object ob : present_objects("alles"))
    for(i=sizeof(objects)-1;i>=0;i--)
    {
      names += ({objects[i]->name(RAW)});
      if(objects[i]->QueryProp(P_MAGIC))
        objects[i]->move("/players/clementine/lager", M_NOCHECK);
      else if(!objects[i]->remove())
        objects[i]->destruct();
    }

    // Name setzen
    ob->initSaft(names);

    // In Spieler oder Raum moven
    if((ret = ob->move(TP, M_GET)) != 1)
      ob->move(environment(), M_NOCHECK);
      
  }  
}


