inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <language.h>

#include "../carolina.h"

void create()
{
 if(!is_clone(TO)) return;
 ::create();

 SetProp(P_SHORT, "Ein Kleeblatt");
 SetProp(P_LONG,
   "Ein dreiblaettriges Rotkleeblatt. Wofuer es wohl gut ist? Angeblich galt "
   "der Klee immer als Symbol der dreifaeltigen Goettin. Die drei Blaetter "
   "stehen fuer das Symbol der jungen Frau, der Mutter und der Greisin.");
 SetProp(P_NAME, "Kleeblatt");
 AddId( ({ "kleeblatt", "blatt", "klee", "rotklee", "rotkleeblatt", "\nklee",
	   "\nQUESTKRAUT" }) );
 SetProp(P_MATERIAL, MAT_MISC_HERBAL);
 SetProp(P_AC, 0);
 SetProp(P_WEIGHT, 20);
 SetProp(P_VALUE, 1);
 SetProp(P_ARTICLE, 1);
 SetProp(P_GENDER, NEUTER);
 SetProp(P_INFO, "Rotklee ist gut gegen Kopfschmerzen und Halsweh.\n");

}
 

