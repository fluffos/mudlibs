
inherit "std/food";

#include "../carolina.h"
#include <properties.h>
#include <language.h>
#include <food.h>
#include <moving.h>


void create()
{
 if (!is_clone(this_object()))
 return;

  ::create();

  SetProp(P_SHORT, "Ein Goldfisch");
  SetProp(P_LONG, 
    "Ein kleiner orangener Goldfisch zappelt hilflos in Deinen Haenden "
    "hin und her. Wenn er nicht bald wieder ins Wasser kommt, wird "
    "er sterben. ");
  SetProp(P_NAME, "Goldfisch");
  SetProp(P_GENDER, MALE);
  AddId( ({ "fisch", "goldfisch", "\ngoldfisch" }) );
  SetProp(P_WEIGHT, 4+random(3));
  SetProp(P_VALUE, 1);
  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_FOOD_STATE, F_RAW);
  SetProp(P_FOOD_INFO,
		  ([ F_DRINK: 0,
		     F_ALCOHOL: 0,
		     F_POISON: 0,
		     F_VERB: "essen",
		     F_MSG_DECAY: "Der Goldfisch stirbt und schwebt "
		                  "in das Reich der Toten.\n",
		     F_MSG: "Du isst den Goldfisch.\n",
		     F_MSG_ROOM: "isst einen Goldfisch.\n" ]) );

  start_decay(20, 1);


}

void remove(int silent)
{
	::remove(1);
	return;
}

