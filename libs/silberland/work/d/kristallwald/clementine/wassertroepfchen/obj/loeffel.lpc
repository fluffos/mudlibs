inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Loeffel");
  SetProp(P_LONG, "Ein Loeffel aus Holz.");
  SetProp(P_NAME, "Loeffel");
  AddId( ({ "loeffel", "holzloeffel", "\nloeffel" }) );
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_OAK);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 50);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_INFO,
    "Sieht ganz brauchbar aus.\n");

  AddDetail( ({ "holz", "eichenholz" }),
    "Der Loeffel besteht aus Eichenholz. ");


}
