
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../carolina.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Schafgarbe");
  SetProp(P_LONG, "Die Schafgarbe ist ein krautige Pflanze mit einem sehr "
    "zaehem Staengel auf dem sich die Blueten bilden. Sie sind klein und "
    "weiss und sehen wie Dolden aus. Angeblich wird die Pflanze vorallem zu "
    "Heilzwecken verwendet.");
  SetProp(P_NAME, "Schafgarbe");
  AddId( ({ "schafgarbe", "kraut", "pflanze", "\nschafgarbe",
			 "\nQUESTKRAUT" }) );
  SetProp(P_MATERIAL, MAT_MISC_HERBAL);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 40);
  SetProp(P_VALUE, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOBUY, 0);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_INFO, "Die Schafgarbe wirkt krampfloesend und "
    "entzuendungslindernd.\n");

}

