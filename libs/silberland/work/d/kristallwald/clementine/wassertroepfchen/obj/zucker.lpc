inherit "std/food";

#include "../carolina.h"
#include <language.h>
#include <properties.h>
#include <food.h>

void create()
{
  if(!is_clone(TO)) return;
  ::create();
  AddId(( {"zuckerwuerfel", "wuerfelzucker", "stueck", "zucker", "\nzucker",
	   "\nQUESTKRAUT" } ));
  SetProp(P_NAME, "Stueck Wuerfelzucker");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, "Ein Stueck Wuerfelzucker");
  SetProp(P_LONG,
    "Ein weisses Stueck Wuerfelzucker. Lecker! Man kann es sicher essen, "
    "oder natuerlich auch in einen Tee geben. In beiden Faellen freut sich "
    "bestimmt Dein Zahnarzt. ");
  SetProp(P_WEIGHT, 2+random(3));
  SetProp(P_VALUE, 1);
  SetProp(P_MATERIAL, MAT_SUGAR);
  SetProp(P_INFO, "Das Stueck versuesst sicher jeden Tee.\n");
  SetProp(P_FOOD_INFO, ([ F_HEAL: ({ 5 , 1 }),
  	  F_SOAK: 1,
   	  F_DRINK: 0,
   	  F_ALCOHOL: 0,
 	  F_POISON: 0,
 	  F_MSG: "Du zerbeisst das Stueck Wuerfelzucker. ",
 	  F_MSG_ROOM: "isst ein Stueck Wuerfelzucker.",
 	  F_VERB: "essen" ]));


  AddDetail( ({ "zahnarzt", "arzt" }),
    "Je mehr Wuerfelzucker Du isst, desto mehr darf Dein Zahnarzt bohren.");


}
