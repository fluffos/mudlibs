#include "../carolina.h"

inherit "std/container";
inherit "/std/container/restrictions.lpc";


#include <language.h>
#include <properties.h>
#include <moving.h>
#include <combat.h>
#include <verben.h>
#include <container.h>
#include <wizlevels.h>

#define MAXITEMS 5 

void create()
{
  if(!is_clone(TO)) return;
 
  ::create();
  
  SetProp(P_SHORT, 0);
  SetProp(P_LONG,
    "Auf der Arbeitsflaeche des Tisches kannst Du sicherlich einiges "
    "drauflegen.");
  SetProp(P_NAME, "Arbeitsflaeche");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "arbeitsflaeche", "NOWIMPY", "flaeche" }) );
  SetProp(P_NOGET, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_CNT_STATUS, CNT_STATUS_OPEN);
  AddCmd( ({ "nimm", "nehm", "nehme" }), "c_nehmen");
  AddCmd( ({ "leg", "lege", "gib", "gebe" }), "c_legen");

}

string short()
{
 return "";
}

varargs string long()
{
 string str;
 string invl;

 if (!stringp(str)) str = "";
 str = QueryProp(P_LONG);

  invl = make_invlist(PL, all_inventory(ME),
   TP ? (TP->QueryProp(P_SHORTINV) ? 0 : 2) :0); 

  if(invl != "")
  str += "Momentan siehst Du folgendes auf der Arbeitsflaeche liegen:\n" + invl;
 
 return str;
}
