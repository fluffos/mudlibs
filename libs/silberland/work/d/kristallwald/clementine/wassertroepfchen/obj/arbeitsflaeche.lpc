int c_nehmen(string str)
{
  object ob;
  int i,n;
  string was, wovon;

  notify_fail("Was willst Du wovon nehmen?\n");
  if(!str || str == "") return 0;
  n=sscanf(str, "%s von %s", was, wovon);
  if(n!=2){n=sscanf(str, "%s vom %s", was, wovon);}
  if(n!=2){return 0;}

  if( !((wovon == "tisch")||(wovon == "arbeitsflaeche")||(wovon == "flaeche")))
  {
    return 0;
  }

  if(!IS_LEARNING(TP) &&
    ((TP->QueryProp(P_SIZE) < 130) || (TP->QueryProp(P_FROG) == 1)) )
  {
    write(BS("Du reckst und streckst Dich, aber Du bist zu klein um "
                  "etwas vom Tisch zu nehmen."));
    return -1;
  }

  if(sizeof(all_inventory(TO)) == 0)
  {
    write("Auf dem Tisch liegt doch gar nichts!\n");
    return -1;
  }

  if(ob = present(was,TO))
  {
    if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
    {
      write("Das kannst Du nicht mehr tragen!\n");
      return -1;
    }
    else
    {
      write("Du nimmst "+ob->name(WEN)+" vom Tisch.\n");
    }
    return 1;
  }

  write("So etwas liegt nicht auf der Arbeitsflaeche.\n");
  return -1;
}

int c_legen(string str)
{
//  object *ruestung;
  object ob;
  int n;
  string was, woran;

//  ruestung = filter_objects(TP->QueryProp(P_ARMOURS), "ruestung_darf_weg");

  notify_fail("Was willst Du wo drauflegen?\n");

  if(!str || str == "") return 0;
  n = sscanf(str, "%s auf %s", was, woran);
  if(n!=2){n=sscanf(str, "%s auf %s drauf", was, woran);}
  if(n!=2){n=sscanf(str, "%s auf %s", was, woran);}
  if(n!=2){n=sscanf(str, "%s auf %s hinauf", was, woran);}
  if(n!=2){return 0;}

  if( !((woran == "tisch")||(woran == "arbeitsflaeche")||(woran =="flaeche")) )
  {
    return 0;
  }

  if(!IS_LEARNING(TP) &&
    ((TP->QueryProp(P_SIZE) < 130) || (TP->QueryProp(P_FROG) == 1)) )
  {
    write(BS("Du reckst und streckst Dich, aber Du bist zu klein "
                  "um etwas auf den Tisch zu legen."));
    return -1;
  }

  if(!ob=present(was,TP))
  {
    write("Sowas hast Du doch gar nicht bei Dir!\n");
    return 1;
  }

  if(sizeof(all_inventory(TO)) >= MAXITEMS)
  {
    write(BS("Der Tisch ist schon vollgeraeumt."));
    return -1;
  }
  if((ob->QueryProp(P_CURSED)) ||
     (ob->QueryProp(P_NEVERDROP)) ||
     ( ob->id("QUESTOBJ"))         ||
     ( ob->QueryProp(P_NODROP))    ||
     (!ob->QueryProp(P_SHORT))     ||
     ( ob->QueryProp(P_INVIS))     ||
     (!ob->QueryProp(P_NAME))      ||
     (ob->QueryProp(P_ARMOUR_TYPE)))    
  {
	  write(BS("Sowas legt man doch nicht auf den Tisch!"));
	  return 1;
  }
    write("Du legst "+ob->name(WEN)+" auf die Arbeitsflaeche.\n");
    ob->move(TO, M_TPORT | M_NOCHECK | M_SILENT); 
    return 1;

}


void init()
{
  ::init();

  if(!TP)              return;
  if(!interactive(TP)) return;
  if(IS_WIZARD(TP))    return;

  call_out("getit",0,TP);
}

