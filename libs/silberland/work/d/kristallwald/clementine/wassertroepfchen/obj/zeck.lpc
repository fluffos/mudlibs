
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <class.h>
#include <moving.h>
#include "../carolina.h"


// Yara new:
int biteCount = 5;

mixed meldungen = ({
  ({"Du fuehlst Dich auf einmal etwas seltsam...\n"
    "Irgendwas hat sich an Dir festgesogen.\n",
    " fuehlt sich seltsam.\n"}),
  ({"Der Zeck beisst sich immer staerker an Dir fest.\n",
    " zuckt etwas.\n"}),
  ({"Du fuehlst Dich immer schwaecher. Der Zeck an Deinem "
    "Koerper wird immer groesser...\n",
    " fuehlt sich schlecht.\n"}),
  ({"Du fuehlst Dich ueberhaupt nicht gut.... :( Der Zeck muss weg!!\n",
    " wankt etwas.\n"}),
  ({"Der Zeck saugt noch ein letztes Mal!!\n" 
    "PLAAAAAAAATSCH !!\n"
    "Er laesst von Dir ab und zerplatzt.\n",
    ""})
});

void create()
{ 
	if(!is_clone(TO)) return;
	::create();

  	SetProp(P_NAME, "Zeck");
	SetProp(P_GENDER, MALE);
	SetProp(P_SHORT, "Ein Zeck");
 	SetProp(P_LONG,
	  "Igitt!!! Ein Zeck!!! Er hat sich schon richtig an Dir "
 	  "festgesogen. Entfern ihn lieber schnell!!!");
	SetProp(P_NODROP, 1);
	SetProp(P_NEVERDROP, 1);
	AddClass(CL_DISEASE);
 	SetProp(P_WEIGHT, 10);
  	SetProp(P_KILL_NAME, "Ein Moerderzeck");

  	AddId( ({ "zeck", "zecke", "\nzeck", "NODESTRUCT" }) );
	call_out("zeckBite", 5);

   	AddCmd( ({ "entfern", "entferne", "reiss", "reisse" }), "c_entfernen");


}

int c_entfernen(string str)
{
 if( str != "zeck"    &&
     str != "zeck runter")
 {
  notify_fail("Was moechtest Du entfernen?\n");
  return 0;
 }
 else
 {
  write("Du reisst Dir den Zeck vom Koerper und wirfst "
    "ihn weit weg.\n");
  say(TPN + " reisst sich einen Zeck vom Koerper.\n");
  RemoveCmd( ({ "entfern", "entferne", "reiss", "reisse" }));
  TP->do_damage(34);
  call_out("remove",0);
  return 1;
 }
}

object na()
{
 object pl;

 if(!(pl = ENV(TO)) || !ENV(pl) ||
    !interactive(pl) || pl->QueryProp(P_GHOST))
   return 0;

 return pl;
}


zeckBite()
{
  object pl;
  
  if(!(pl = na()))
  {
    remove();
    return;
  }

  tell_object(pl, meldungen[sizeof(meldungen)-biteCount][0]);
  say(pl->Name() + meldungen[sizeof(meldungen)- biteCount][1]);
  pl->do_damage(20 + random(8));

  if(--biteCount == 0)
    call_out("remove", 0);
  else
    call_out("zeckBite", 16 + random(4));
}



