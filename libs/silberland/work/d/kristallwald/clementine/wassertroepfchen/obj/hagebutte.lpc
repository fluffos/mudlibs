
inherit "std/food";

#include <food.h>
#include <properties.h>
#include <language.h>
#include "../carolina.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Hagebutte" );
  SetProp(P_LONG,
    "Eine kleine hellrote Hagebutte. Angeblich kann man aus Hagebutten "
    "einen gesunden, aber dennoch gut schmeckenden Tee zubereiten. ");
  SetProp(P_NAME, "Hagebutte");
  AddId( ({ "hagebutte", "\nhagebutte", "\nQUESTKRAUT" }) );
  SetProp(P_MATERIAL, MAT_FRUIT);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_INFO, "Satt werden wirst Du an dieser kleinen Hagebutte sicherlich "
                  "nicht.\n");

  SetProp(P_FOOD_INFO,
     ([ F_HEAL:  ({ 1,2}),
        F_SOAK: 1,
        F_MSG: "Du schluckst die Hagebutte einfach hinunter.",
        F_MSG_ROOM: "schluckt eine Hagebutte hinunter."]) );
}


