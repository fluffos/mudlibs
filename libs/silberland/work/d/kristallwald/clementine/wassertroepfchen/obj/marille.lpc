inherit "std/food";

#include "../carolina.h"
#include <language.h>
#include <properties.h>
#include <food.h>

void create()
{
  if(!is_clone(TO)) return;
  ::create();
  SetProp(P_NAME, "Marille");
  SetProp(P_NAME_ADJ, ( { "lecker" } ) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, "Eine leckere Marille");
  SetProp(P_LONG,
    "Wow! Die Marille ist schon orange und sieht total lecker aus! "
    "Schmeckt sicher koestlich!");
  AddId( ({ "marille" }) );
  SetProp(P_WEIGHT, 2+random(3));
  SetProp(P_VALUE, 1);
  SetProp(P_MATERIAL, MAT_FRUIT);
  SetProp(P_INFO, "Die Marille schmeckt sicher lecker!\n");
  SetProp(P_SMELL, "Die Marille duftet nach Marille.\n");
  SetProp(P_FOOD_INFO, ([ F_HEAL: ({ 3+random(5) , 1 }),
  	  F_SOAK: 1+random(4),
   	  F_DRINK: 0,
   	  F_ALCOHOL: 0,
 	  F_POISON: 0,
 	  F_MSG: "Du steckst Dir die Marille in den Mund und "
          "spuckst nur ihren Kern wieder aus.",
 	  F_MSG_ROOM: "isst eine Marille.",
 	  F_VERB: "essen" ]));
}
