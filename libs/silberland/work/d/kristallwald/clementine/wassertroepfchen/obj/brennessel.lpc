
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../carolina.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Brennessel");
  SetProp(P_LONG, "Die Brennessel ist ein krautartiges Gewaechs mit "
		  "tiefgruener Farbe. Ihre Blaetter sind grob gezaehnt und "
		  "wenn  Du ganz genau hinsiehst erkennst Du auch feine "
		  "Brennhaare auf ihnen. ");
  SetProp(P_NAME, "Brennessel");
  AddId( ({ "brennessel", "\nbrennessel", "\nQUESTKRAUT" }) );
  SetProp(P_MATERIAL, MAT_MISC_HERBAL);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_INFO, "Brennesseln im Tee eignen sich zur Blutreinigung.\n");


  AddDetail( ({ "brennhaare", "haare" }),
    "Pass bloss auf, dass Du nicht an den Brennhaaren ankommst! ");

  AddDetail( ({ "farbe" }),
    "Gruen!");

  AddDetail( ({ "gewaechs" }),
    "Die Brennessel ist ein krautartiges Gewaechs.");

  AddCmd( ({ "kommen", "komme", "fass", "fasse", "greif", "greife" }), 
    "c_angreifen");

}

int c_angreifen(string str)
{
        mixed ob;
	if(str != "brennhaare an" &&
	   str != "haare an"      &&
	   str != "blaetter an"   &&
	   str != "brennesselblaetter an" )
	{
		notify_fail("Was moechtest Du angreifen?\n");
		return 0;
	}
	else
	{
	 ob=TP->QueryArmours(AT_GLOVE);
         if((pointerp(ob) && sizeof(ob)>0))	 
	 {
	  write(BS("Du streichst ueber die Blaetter, verbrennst Dich aber "
		   "aufgrund Deiner Handschuhe nicht an ihnen."));
	  return 1;
	 }
	 else
	 {
	  write(BS("Du streichst ueber die Blaetter und verbrennst Dich "
		   "natuerlich prompt an den Brennhaaren."));
	  TP->do_damage(5);
	  return 1;
	 }
	}
}

