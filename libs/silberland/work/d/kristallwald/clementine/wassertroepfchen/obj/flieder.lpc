inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../carolina.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Fliederstrauss");
  SetProp(P_LONG, 
    "Ein wundervoller lila Fliederstrauss. Er wurde aus mehreren "
    "Fliederzweigen gebunden und duftet "
    "einfach herrlich. ");
  SetProp(P_NAME, "Fliederstrauss" );
  SetProp(P_GENDER, MALE);
  AddId( ({ "fliederstrauss", "strauss", "flieder" }) );
  SetProp(P_MATERIAL, MAT_MISC_PLANT);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_SMELL, "Duftet das herrlich!\n" );
  

  AddDetail( ({ "zweige", "fliederzweige" }),
    "Der Strauss wurde aus mehreren Fliederzweigen gebunden. ");

  
  
 

}

