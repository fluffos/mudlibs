inherit "std/food";

#include "../carolina.h"
#include <language.h>
#include <properties.h>
#include <food.h>

void create()
{
  if(!is_clone(TO)) return;
  ::create();
  AddId(( {"kirsche"} ));
  SetProp(P_NAME, "Kirsche");
  SetProp(P_NAME_ADJ, ( {"dunkelrot"} ) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, "Eine dunkelrote Kirsche");
  SetProp(P_LONG,
    "Mjamm...die Kirsche sieht total lecker aus!! Sie ist schon dunkelrot "
    "schmeckt sicher sehr suess.");
  SetProp(P_WEIGHT, 2+random(3));
  SetProp(P_VALUE, 1);
  SetProp(P_MATERIAL, MAT_FRUIT);
  SetProp(P_INFO, "Kirschen sind zum Essen da!\n");
  SetProp(P_SMELL, "Die Kirsche riecht kirschig!\n");
  SetProp(P_FOOD_INFO, ([ F_HEAL: ({ 2+random(5) , 1 }),
  	  F_SOAK: 1+random(4),
   	  F_DRINK: 0,
   	  F_ALCOHOL: 0,
 	  F_POISON: 0,
 	  F_MSG: "Du isst genuesslich die rote Kirsche und "
          "spuckst anschliessend den Kern aus.",
 	  F_MSG_ROOM: "isst eine Kirsche.",
 	  F_VERB: "essen" ]));
}
