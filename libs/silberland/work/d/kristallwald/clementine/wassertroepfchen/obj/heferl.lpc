
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../carolina.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Heferl");
  SetProp(P_LONG, "Ein Heferl vollgefuellt mit leckerem Tee. ");
  SetProp(P_NAME, "Heferl");
  AddId( ({ "heferl", "\nheferl", "haeferl", "tee", "teeheferl", 
	    "\nQUESTSAFT" }) );
  SetProp(P_MATERIAL, MAT_MISC_FLUID);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_INFO, "Du solltest das Heferl schnell zu Wassertroepfchen "
		  "bringen.\n");


  AddDetail( ({ "tee", "hustensaft", "hustentee" }),
    "Leckerer Hustentee ist in dem Heferl.");

  AddCmd( ({ "trink", "trinke" }), "c_trinken");

}

int c_trinken(string str)
{
	if(str != "tee" &&
	   str != "tee aus heferl" &&
	   str != "heferl" )
	{
		notify_fail("Was moechtest Du trinken?\n");
		return 0;
	}
	else
	{
		write(BS("Der Tee ist doch fuer Wassertroepfchen bestimmt!"));
		return 1;
	}
}


