
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../carolina.h"
#include <moving.h>

void create()
{
  if (!is_clone(TO)) return; 

  ::create();

  AddId(({"\ngive_quest"}));
  SetProp(P_SHORT, 0);
  SetProp(P_NAME, "Give_Quest");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_VALUE, 0);

  call_out("seq1", 1);
}

move(dest,meth) 
{
  mixed res;
  while (remove_call_out("try_remove")!=-1) ;
  res=::move(dest,meth);
  if (!environment() || !living(environment()))
    call_out("try_remove",30);
  return res;
}

try_remove() {
  if (!environment() || !living(environment())) 
    {
      remove();
    }
}

void seq1()
{
  write("\n");	
  write (BS("Voller Freude nimmt Dir Wassertroepfchen das Heferl "
		"mit dem Tee ab."));
  write ("\n");
  call_out(("seq2"), 4);
}

void seq2()
{
        write("\n");
	write(BS("Schnell trinkt sie das Heferl leer und fuehlt sich danach "
		  "sofort besser."));
	write("\n");
	call_out(("seq3"), 4);
}
void seq3()
{
  int n;
  object ob;
  write("\n");
  write (BS("Das Rezept hat es wirklich in sich!\n"));
  write ("\n");
  
  if ((TP->QueryQuest(QUESTNAME))==0)
    {
      CLONE(("/obj/gems/amethyst"), TP);
    }
  
  n = TP->GiveQuest(QUESTNAME);
 
  call_out(("seq4"), 1); 
}

void seq4()
{
  TO->remove();
}




