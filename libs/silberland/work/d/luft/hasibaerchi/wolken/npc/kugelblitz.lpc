
inherit "std/npc";
inherit "std/npc/spells";

#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Kugelblitz" );
  SetProp(P_LONG,
    "Dieser kleine Kugelblitz scheint sehr aggressiv zu sein. Hoffentlich "
    "kommst Du seinen Blitzen nicht zu nahe, die er immer wieder von sich "
    "wirft.");
  SetProp(P_NAME, "Kugelblitz");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"blitz", "kugelblitz"}));

  create_default_npc(12);
  SetProp(P_HANDS, ({" mit seinen Blitzen",155,DT_LIGHTNING}));
  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 5+random(10));
  SetProp(P_WEIGHT, 30+random(10));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.4,  DT_COLD:      0.0,  DT_WATER:  0.2, DT_AIR:    -1.0, 
      DT_LIGHTNING: -1.0,  DT_EXPLOSION: 0.0, DT_SOUND:  -1.0,  DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.0,  DT_TERROR: 0.0,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.0,  DT_MAGIC: 0.0,   DT_MIND:   -1.0]));
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,8);

  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "schwebt herein.");
  SetProp(P_MMSGOUT, "schwebt weg");

  SetProp(P_DIE_MSG,  " faellt in die Tiefe.\n");
  SetProp(P_NOCORPSE, 1);

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Kugelblitz kann Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE, 25);

  AddSpell(3, 270, "Der Kugelblitz schleudert Dir einen Blitz entgegen.\n",
		   "Der Kugelblitz schleudert @WEM einen Blitz entgegen.\n",
           ({DT_LIGHTNING,DT_AIR}),([SP_SHOW_DAMAGE:1]) );

 AddSpell(1, 330, "Der Kugelblitz schleudert Dir einen Donnerblitz entgegen.\n",
		  "Der Kugelblitz schleudert @WEM einen Donnerblitz entgegen.\n",
           ({DT_ELECTRIC,DT_SOUND}),([SP_SHOW_DAMAGE:1]) );
}
