#include "../def.h"

inherit "std/thing";

void create() {
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_NAME, "Monolith");
  AddId(({"monolith","stein"}));
}

int tie(string str) {
  return 1;
}

int untie() {
  return 1;
}

void reset() {
  object ob;
  
  if(!is_clone(TO)) return;
  ::reset();

  if((ob=present("seil"))==0) return;

  if(ob->query_tied_to_ob() ==  TO)
    tell_room(environment(TO), "Das Seil löst sich und faellt ueber den "
      "Rand.\n");
  else
    tell_room(environment(TO), "Das Seil faellt ueber den Rand.\n");
}