#include "../def.h"

inherit "std/room";

int seil = 1;

void create() {
  ::create();

  SetProp(P_INT_SHORT, "An einem Palmenstrand" );
  SetProp(P_INT_LONG,
    "Typischer koennte ein Palmenstrand nicht sein. Weisser feinkörniger "
    "Sand, grosse Palmen mit weit ausladenden Wedeln und darueber azurblauer "
    "Himmel von dem die Sonne warm scheint. Doch halt, das Meer fehlt "
    "gaenzlich! Stattdessen gaehnt da ein grenzenloser Abgrund. Dir wird "
    "ganz schwindlig bei dem Anblick. Du wagst Dich besser nicht zu nah an "
    "den Rand.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail(({"palmenstrand","strand"}), "Ein typischer Palmenstrand, wenn "
    "da nicht dieser schreckliche Abgrund anstelle des Meeres wäre. "
    "Ansonsten ist alles da, Palmen, Sand und Sonne. Nahe des Randes liegt "
    "ein grosser Stein im Sand. Nach Norden hin lichten sich die Palmen und "
    "das Land steigt etwas an. Der Weg nach Nordosten ist durch hohe steile "
    "Felsen versperrt.");
  AddDetail(({"stein"}), "Nahe des Randes liegt ein grosser Stein im Sand."
    "Er ist so gross, dass man ihn fast schon als Monolithen bezeichnen "
    "koennte.");
  AddDetail(({"monolith"}), "Da steht ein grosser Monolith im Sand. Seine "
    "Oberflaeche ist rau, Wind und Regen haben tiefe Furchen gezogen.");
  AddDetail(({"oberflaeche"}), "Sie schwarzgraue Oberflaeche des Monolithen "
    "ist ganz rau und von Wind und Regen zerfurcht.");
  AddDetail(({"wind"}), "Der Wind hier ist doch recht kuehl.");
  AddDetail(({"regen"}), "Im Moment regnet es nicht.");
  AddDetail(({"furchen"}), "In einer der Furchen klemmt ein alter "
    "verrotteter Fetzen.");
  AddDetail(({"fetzen"}), "Hmm, so kannst Du nichts genaues erkennen.");
  AddDetail(({"ueberreste", "staub"}), "Der Staub rinnt durch "
    "Deine Finger und wird vom Winde verweht.");
  AddDetail(({"finger"}),"Noch hast Du alle.");
  AddDetail(({"norden"}), "Geh doch mal hin.");
  AddDetail(({"nordosten","osten"}), "Da sind steile Felsen, da kommst Du "
    "nicht rauf.");
  AddDetail(({"weg"}), "Nach Nordosten fuehrt er Dich nicht.");
  AddDetail(({"suedosten","westen","suedwesten","sueden"}), "Da gaehnt ein "
    "grenzenloser Abgrund.");
  AddDetail(({"nordwesten"}), "Geh doch mal hin.");
  AddDetail(({"felsen"}), "Die sind viel zu steil um sie zu erklimmen.");
  AddDetail(({"land"}), "Hier scheint es nicht besonders viel Land zu "
    "geben. Wie es scheint, befindest Du Dich auf einer fliegenden Insel in "
    "grenzenlosen luftigen Weiten.");
  AddDetail(({"insel"}), "Was die Insel wohl in der Luft haelt?");
  AddDetail(({"weite","weiten"}), "Grenzenlose luftige Weiten. Doch hier auf "
    "der Insel fuehlst Du Dich einigermassen sicher.");
  AddDetail(({"sand"}), "Feiner weisser Sand. Hier und da siehst Du ein "
    "paar kleine Steinchen und weisse Muschelschalen.");
  AddDetail(({"steinchen","steine"}), "Auf dem weissen Sand siehst Du hier "
    "und da auch ein paar groessere Steinchen.");
  AddDetail(({"muschelschalen","muscheln","schalen"}), "Im Sand liegen von "
    "der Sonne ausgebleichte Muschelschalen. Blitzschnell kombinierst Du, "
    "dass es hier einmal Wasser gegeben haben muss.");
  AddDetail(({"wasser"}), "Keins mehr da.");
  AddDetail(({"palmen","palme"}), "Grosse Palmen mit schlanken Staemmen. "
    "Ihre gruenen Wedel sind weit ausladend. In der Krone glaubst Du "
    "ausserdem auch Kokosnuesse zu erkennen. Im Norden und Osten werden die "
    "Palmen seltener.");
  AddDetail(({"staemme","stamm"}), "Die Staemme der Palmen sind ziemlich "
    "glatt. Ganz oben glaubst Du Kokosnuesse zu erkennen.");
  AddDetail(({"krone"}), "Da oben wachsen Kokosnuesse.");
  AddDetail(({"kokosnuesse","nuesse"}), "Die sind bestimmt sehr lecker.");
  AddDetail(({"wedel","wedeln","palmwedel"}), "Die gruenen Palmwedel "
    "spenden wohltuenden Schatten der vor der brennenden Sonne schuetzt. "
    "In den Kronen glaubst Du auch Kokosnuesse zu erkennen.");
  AddDetail(({"schatten"}), "Wohltuender Schatten, so bekommst Du "
    "hoffentlich keinen Sonnenbrand.");
  AddDetail(({"himmel"}), "Der Himmel ist azurblau und von einigen "
    "strahlendweissen Schoenwetterwolken gefleckt. Die Sonne brennt "
    "erbarmungslos herab.");
  AddDetail(({"schoenwetterwolken","wolken"}), "Strahlendweisse "
    "Schoenwetterwolken. Sie sehen aus wie Zuckerwatte.");
  AddDetail(({"zuckerwatte","watte"}), "Zuckerwatte, haaarrrrr....");
  AddDetail(({"sonne"}), "Obwohl Du hier ziemlich weit oben bist und die "
    "Luft doch recht kuehl ist, brennt die Sonne erbarmungslos vom Himmel. "
    "Pass auf, dass Du Dir keinen Sonnenbrand holst.");
  AddDetail(({"luft"}), "Die Luft ist doch recht kuehl. Waere da nicht die "
    "brennende Sonne, wuerdest Du frieren.");
  AddDetail(({"sonnenbrand"}), "Das waere wirklich unangenehm.");
  AddDetail(({"meer"}), "Das Meer soll ja gefaehrlich sein, aber Du bist "
    "Dir sicher, dass es hier ohne Meer viel gefaehrlicher ist. Anstelle des "
    "Meeres gaehnt ein grenzenloser Abgrund.");
  AddDetail(({"abgrund"}), "Du trittst ein wenig naeher an den Rand des "
    "Abgrunds und riskierst einen Blick nach unten. Dir wird schwindlig ob "
    "der bodenlosen Weite. Unter Dir siehst Du nur weisse Wolken durch die "
    "hin und wieder dunkle Flecken hindurchschimmern.");
  AddDetail(({"flecken"}), "Das ist wahrscheinlich der Boden. Sieht sehr "
    "sehr weit weg aus.");
  AddDetail(({"blick","anblick"}), "Der Anblick ist atemberaubend.");
  AddDetail(({"anblick"}), "Dir wird ganz schwindlig bei dem Anblick.");
  AddDetail(({"rand"}), "Pass auf dass Du nicht abrutscht, das koennte dumm "
    "ausgehen.");
  AddDetail(({"boden"}), "Noch stehst Du auf wunderschoenem sandstrandigem "
    "Boden. Doch der gefaehrliche Abgrund ist nicht weit.");

  AddSound(DEFAULT_SOUND, "Die Palmwedel rauschen sanft im Wind. Ansonsten "
    "hoerst Du nichts besonderes.");
  AddSound(({"palmwedel","wedel"}), "Sie rauschen sanft im Wind.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Sonne, Strand und Meer. Nein halt, "
    "nach Meer riecht es eigentlich ueberhaupt nicht. Vielleicht, weil kein "
    "Meer da ist.");
  AddSmell(({"sonne"}), "Sonnig.");
  AddSmell(({"sand"}), "Sandig.");

  AddCmd("kletter|klettere&palme|stamm", "cmdKletter",
         "Auf was willst Du klettern?");
  
  AddCmd("kletter|klettere&felsen|fels", "cmdKletterFels",
         "Auf was willst Du klettern?");
  
  AddCmd("schuettel|schuettele&palme|stamm|palmenstamm", "cmdSchuettel",
         "Was willst Du schuetteln?");

  AddCmd("ziehe|zieh&fetzen&furche", "cmdZiehe",
    "Was willst Du ziehen?|Was willst Du woraus ziehen?");

  AddExit("nordwesten", "./strand1");

  AddItem(OBJ "dummy", REFRESH_REMOVE);
}



int cmdZiehe(string str) {
  if(seil!=1) {
    write("Nein, da ist nichts mehr. Aber irgend etwas war da mal.\n");
    return -1;
  }
  
  write(BS("Mit einem Ruck ziehst Du den Fetzen aus der Furche und kannst "
    "gerade noch erkennen, dass das mal ein stabiles Seil gewesen sein muss. "
    "Die Ueberreste zerfallen zu Staub."));
  say(BS(TP->Name()+" macht sich an einem grossen Stein zu schaffen."));
  seil--;
  return 1;
}

int cmdKletterFels(string str) {
  write("Die Felsen sind wirklich zu steil um sie zu erklettern.\n");
  return 1;
}

void nutOverRim() {
  tell_room(TO, BS("Mit einem Knacksen loest sich eine Nuss, die hart auf "
    "dem Strand aufprallt, einen kleinen Hopser macht und ueber den Rand "
    "faellt. Du bist enttaeuscht."));
}

void nutParalysis() {
  write(BS("Mit einem Knacksen loest sich eine Nuss, die Dir genau auf "
    "den Kopf faellt. Du wirst ohnmaechtig und siehst gerade noch, wie die "
    "Nuss ueber den Rand kullert."));
  say(BS("Mit einem Knacksen loest sich eine Nuss, die an "+TP->name(WESSEN)+
    " Kopf abprallt, bevor sie ueber den Rand kullert."));
  say(TP->name(WER)+" wird ohnmaechtig.");

  TP->SetProp(P_PARALYZED, ([PARALYZE_TIME:10,
    PARALYZE_MSG:"Du bist ohnmaechtig und kannst Dich nicht bewegen.\n",
    PARALYZE_MSG_OTHER:"",
    PARALYZE_END:"Du kommst wieder zu Dir.\n",
    PARALYZE_END_OTHER:"%s kommt wieder zu sich.\n"]));

}

void nut() {
  random(2) ? nutOverRim() : nutParalysis();
}

int cmdSchuettel(string str) {
  write(BS("Du schuettelst eine Palme wie wild."));
  say(BS(TP->Name()+" schuettelt wie wild eine Palme."));

  if(find_call_out("nut")==-1) call_out("nut", 1);
  
  return 1;
}

//TODO richtig auf Palme klettern
int cmdKletter(string str) {
  write(BS("Du klammerst Dich wie ein Affe an den Palmenstamm und versuchst "
    "hoch zu klettern. Wie erwartet scheiterst Du klaeglich. Die "
    "Kokosnuesse sind sicher sowieso noch nicht reif. Vielleicht lohnt es "
    "sich ja, es spaeter noch einmal zu versuchen?"));
  say(BS(TP->Name()+" versucht auf eine Palme zu klettern, scheitert aber "
    "klaeglich."));
  
  return 1;
}

void reset() {
  ::reset();
  seil=1;
}