inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../nicolas.h"

create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Feder");
  SetProp(P_LONG,
    "Du haeltst eine schillernde Feder in Deinen Haenden die in allen "
    "Farben des Regenbogens leuchtet. Anscheinend hat sie ein kleiner "
    "Engel hoch oben am Himmel beim Fliegen verloren und sie ist wohl "
    "sanft und leise auf die Erde geglitten. ");
  SetProp(P_NAME, "Feder");
  AddId( ({ "feder" }) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, MAT_FEATHER);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_INFO, "Sie schwebt sicherlich sehr schon wenn man sie anpustet.");


  AddCmd( ({ "pust", "puste" }), "c_pusten");

}


int c_pusten( string str )
{
 if( str != "feder"    &&
     str != "feder an" )
 {
  notify_fail("Was moechtest Du anpusten?\n");
  return 0;
 }
 else
 {
  write(break_string("Du pustet mit aller Kraft auf die Feder. Sanft beginnt "
           "sie in die Luefte aufzusteigen und zu fliegen. Ploetzlich "
           "verschwindet sie und ein zarter Hauch von Engelstaub bedeckt "
           "Deinen ganzen Koerper. "));
  say(this_player()->name()+ " wird von Engelstaub eingehuellt.\n");
  return 1;
 }
}


