
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../nicolas.h"

create()
{
  if (!is_clone(this_object()))
  return;

  ::create();

  SetProp(P_SHORT,"Ein kleiner Engel");
  SetProp(P_LONG,
    "Ein kleiner Engel schwebt vor Dir und blickt Dich gross aus seinen "
    "gruenen Augen an. Durch seine Sommersprossen wirkt er noch um eine "
    "Spur frecher. Seine riesigen weissen Fluegel verleihen ihm ein etwas "
    "tolpatschiges Aussehen, doch lass Dich davon nicht in die Irre fuehren. "
    "Ueber seinem strubbeligen roten Haar schimmert ein kleiner goldener "
    "Heiligenschein. "); 
  SetProp(P_NAME, "Engel");
  SetProp(P_GENDER, MALE);
  
  set_living_name("engel");
  AddId( ({ "engel" }) );

  create_default_npc(25);

  SetProp(P_ALIGN, -150);
  
  SetProp(P_HANDS, ({" mit seinen winzigen Haenden", QueryProp(P_HANDS)[1],
                     DT_BLUDGEON }) );

  SetProp(P_RESISTANCE_STRENGTHS,
    ([ DT_MAGIC: -0.8, 
     DT_POISON: 0, DT_TERROR: -1, DT_FIRE:0.5,  DT_COLD:0,   DT_WATER:0,
     DT_AIR:-1,   DT_LIGHTNING:-0.5, DT_EXPLOSION:-0.4,
     DT_SOUND:0, DT_LIGHT:0,  DT_ELECTRIC:1,
     DT_HOLY:-1,  DT_UNHOLY:0.5, ]) );


  SetProp(P_MURDER_MSG, "Warum bist Du so gemein?\n");
  SetProp(P_KILL_NAME, "Ein Engel");
  SetProp(P_KILL_MSG, "Du kommst sicherlich nicht in den Himmel!\n");  
 


}

