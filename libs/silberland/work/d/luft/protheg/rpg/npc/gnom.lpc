#include "../def.h"

inherit "std/npc";

string give_broschuere()
{
  object bro;
  
  if(!TP) return "";
  
  if(present("\nrpgbroschuere", TP))
    return "Wieviele Broschueren willst Du denn noch?";
  
  CLONE(OBJ "broschuere", TP);
  
  tell_room(MENV, BS("Der Gnom uebergibt "+TP->name(WEM)+" eine Broschuere."),
	    ({TP}));
  write(BS("Der Gnom haendigt Dir eine Broschuere aus."));
  
  return "Hier bitte.";
}

void create() 
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Gnom sitzt hinter dem Schreibtisch");
  SetProp(P_LONG,
	  "Ein kleiner Gnom sitzt hier hinter dem Schreibtisch. Er traegt "
	  "eine schwarze Robe mit blauen Runen und recht laecherlich wirkende "
	  "Schuhe. Er ist hauptsaechlich ueber den Schreibtisch gebeugt und "
	  "studiert Zetteln, Buecher, oder kritzelt in ihnren herum. Hin und "
	  "wieder wuerfelt er mit ein paar Wuerfeln.");
  SetProp(P_NAME, "Gnom");
  SetProp(P_GENDER, MALE);
  AddId(({"gnom", "gamemastergnom"}));
  
  create_default_npc(5);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Gnom");
  SetProp(P_SIZE, 80);
  SetProp(P_WEIGHT, 25000);
  SetProp(P_ALIGN, -40);
  SetProp(P_MAX_HANDS, 2);
  
  SetProp(P_MSGIN, "kommt an und setzt sich hinter den Schreibtisch");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot von der Wolke.\n");
  SetProp(P_NOCORPSE, 1);
  
  SetProp(P_NOATTACK, "winkt ab und meint: Hast Du nichts besseres zu tun?\n");
  
  AddInfo(DEFAULT_INFO, 
	  ({"laechelt.\n",
	      "ist mit seinen Zetteln beschaeftigt.\n",
	      "kichert.\n",
	      "murmelt: 2W6 plus 2.\n",
	      "murmelt: 1W6 plus 4.\n",
	      "murmelt irgendwas.\n",
	      "verdreht die Augen.\n",
	      "fragt: Ist das ein Rollenspiel?",
	      "murmelt: 3W4.\n",
	      "winkt nur ab.\n"}));
  
  AddInfo(({"buch","buecher","rollenspielbuch","rollenspielbuecher"}),
	  "Sind alle meins! Habe sie jahrelang gesammelt und kann fast "
	  "alle auswendig.",
	  "sagt: ");
  
  AddInfo(({"gnom","gnome"}),
	  "Hast Du was gegen Gnome?",
	  "frag: ");
  
  AddInfo(({"wuerfel"}),
	  "Natuerlich habe ich Wuerfel, aber Du bekommst sie sicher nicht!");
  
  AddInfo(({"zettel","zetteln"}),
	  "Finger weg! Das sind meine!",
	  "meint: ");
  
  AddInfo(({"tisch","schreibtisch"}),
	  "Ja? Was ist damit?");
  
  AddInfo(({"spiel","spiele","spielen","rollenspiel","rollenspiele",
	      "rollenspielen"}),
	  "Bist Du auch so ein Fan von Rollenspielen? Willst Du Dich etwa "
	  "auch einmal als Gamemaster betaetigen?",
	  "strahlt: ");
  
  AddInfo(({"fan","rollenspielfan","rollenspielefan","spielefan","spielfan"}),
	  "strahlt.");
  
  AddInfo(({"wolke","wolken"}),
	  "Hier ist es so schoen abgelegen, man hat seine Ruhe zum "
	  "Rollenspielen, findest Du nicht auch?",
	  "schwaermt: ");
  
  AddInfo(({"master","gamemaster"}),
	  "deutet laechelnd auf das Schild vor dem Schreibtisch.");
  
  AddInfo(({"hilfe"}),
	  "Ich brauche keine Hilfe, aber Du vielleicht? Lies Dir doch mal "
	  "das Schild da durch.");
  
  AddInfo(({"broschuere"}), CLOSURE(give_broschuere), "sagt: ");
  
  SetProp(P_LOG_INFO, "protheg/rpggnom");
  
  SetProp(P_REJECT, ({ REJECT_DROP,
		"Der Gnom will Deine Sachen nicht tragen.\n" }) );
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  if(touch)
    call_out("reaction", 0, TP,
	     "kreischt: 'Ieeh, Finger weg!'",
	     "kreischt: 'Ieeh, Finger weg!'");
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    }
}
