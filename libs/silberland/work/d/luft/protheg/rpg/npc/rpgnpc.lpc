/*
** Ein NPC fuer das RPG-Projekt SL
**
** Kann nichts, aber dafuer ist das Aussehen frei konfigurierbar.
**
*/

nosave string game;

#include "../def.h"

inherit "std/npc";
inherit "std/player/soul";

int allowed_env()
{
  if(!MENV) return 0;
  
  if(strstr(file_name(MENV), ROOM)==0)
    return 1;

  return 0;
}

int allowed_manager(object who)
{
  if(!RPGMASTER->GameMaster(who,game)) return 0;
  return 1;
}

void sfkt(string str)
{
  command_me("sage "+str);
}

string al2str(int al)  // /std/player/base.c
{
  if(al >  5000)  return "scheinheilig";
  if(al ==  1000) return "heilig";
  if(al ==  300)  return "gut";
  if(al ==  10)    return "nett";
  if(al ==  0)    return "neutral";
  if(al ==  -20)  return "frech";
  if(al ==  -300) return "boese";
  return "satanisch";
}

int str2al(string str)
{
  switch(str)
    {
    case "heilig":  return 1000; break;
    case "gut":     return 300;  break;
    case "nett":    return 10;   break;
    case "neutral": return 0;    break;
    case "frech":   return -20;  break;
    case "boese":   return -300; break;
    default: return -1000;
    }
}

int str2gen(string str)
{
  switch(str)
    {
    case "weiblich":
    case "w":
    case "feminin":  return FEMALE; break;
    case "maennlich":
    case "m":
    case "maskulin": return MALE; break;
    default: return NEUTER;
    }
}

string gen2str(int g)
{
  switch(g)
    {
    case FEMALE: return "weiblich";  break;
    case MALE:   return "maennlich"; break;
    default: return "saechlich"; break;
    }
}

string t2str(int i)
{
  if(i) return "ja";
  
  return "nein";
}

int str2t(string str)
{
  if(str=="ja") return 1;
  
  return 0;
}

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein NPC");
  SetProp(P_LONG,
	  "Ein kleiner NPC.");
  SetProp(P_NAME, "NPC");
  SetProp(P_GENDER, MALE);
  AddId(({RPG_PROJECT_ID, "npc","statist","NOWIMPY","NOCONTROL","SKILL_NOLEARN"}));

  create_default_npc(1);
  SetProp(P_XP, 0);
  
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "NPC");
  SetProp(P_SIZE, 100);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  
  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  
  SetProp(P_NOATTACK, "kreischt: 'Nein, ich bin doch nur ein Statist!'\n");
  
  AddInfo(DEFAULT_INFO, "meint: Ich bin nur ein Statist.\n");
  
  AddCmd(({"aender","aendere"}), "cmd_aendern");
  AddCmd(({"rpgzwing","rpgzwinge"}), "cmd_zwingen");
  AddCmd(({"rpginvis"}), "cmd_invis");
  AddCmd(({"rpgvis"}), "cmd_vis");
  AddCmd(({"rpgstirb"}), "cmd_stirb");
  
  SUID;
  
  enable_commands();
  add_soul_commands();
}

nosave int cmd_invis(string str)
{
  string n;
  string *tmp;
  
  notify_fail(BSST("Welcher Npc soll wie unsichtbar werden?"));
  if(!str) return 0;
  
  str=TP->_unparsed_args();
  
  tmp=explode(str, " ");
  
  n=tmp[0];
  
  if(!id(n)) return 0;
  
  if(sizeof(tmp)!=1)
    tell_room(MENV, Name()+" "+implode(tmp[1..], " "));
  
  SetProp(P_INVIS, 1);
  
  return 1;
}

nosave int cmd_vis(string str)
{
  string n;
  string *tmp;
  
  notify_fail(BSST("Welcher Npc soll wie sichtbar werden?"));
  if(!str) return 0;
  
  str=TP->_unparsed_args();
  
  tmp=explode(str, " ");
  
  n=tmp[0];
  
  if(!id(n)) return 0;
  
  if(sizeof(tmp)!=1)
    tell_room(MENV, Name()+" "+implode(tmp[1..], " "));
  
  SetProp(P_INVIS, 1);
  
  return 1;
}

nosave int cmd_stirb(string str)
{
  string n;
  string *tmp;
  
  notify_fail(BSST("Welcher Npc soll wie sterben?"));
  if(!str) return 0;
  
  str=TP->_unparsed_args();
  
  tmp=explode(str, " ");
  
  n=tmp[0];
  
  if(!id(n)) return 0;
  
  if(sizeof(tmp)!=1)
    SetProp(P_DIE_MSG, implode(tmp[1..], " "));
  
  write(BSST(Name()+" wird nun sterben."));
  
  call_out("die", 1);
  
  return 1;
}

nosave int cmd_zwingen(string str)
{
  int i,siz;
  string *tmp;
  
  notify_fail(BSST("Wen willst Du wozu zwingen?"));
  if(!str) return 0;
  
  tmp=explode(str, " ");
  
  if(!id(tmp[0])) return 0;
  
  if(sizeof(tmp)==1) return 0;

  if(!allowed_manager(TP)) 
    return write(BSST("Du darfst diesen NPC zu nichts zwingen!")), 1;
  
  str=implode(tmp[1..], " ");
  
  tmp=explode(str, "##");
  
  siz=sizeof(tmp);
  
  for(i=0;i < siz;i++)
    if(!command(regreplace(tmp[i], "^[ ]*", "",0))) 
      write(BSST(Name()+" will '"+tmp[i]+"' nicht ausfuehren!"));
  
  return 1;
}

varargs void aendern_usage(int flag)
{
  write((!flag ? BSST(" Was willst Du denn aendern? Abbrechen mit q.")+
	 BSST(" Beachte bitte die Gross-kleinschreibung.")+
	 BSST("=============================================") : "")+
	BSST(sprintf("(1) %25-s %s","Name: ", QueryProp(P_NAME)))+
	BSST(sprintf("(2) %25-s %s","Geschlecht: ",gen2str(QueryProp(P_GENDER))))+
	BSST(sprintf("(3) %25-s %s","Artikel: ",t2str(QueryProp(P_ARTICLE))))+
	BSST(sprintf("(4) %25-s %s","Rasse: ", QueryProp(P_RACE)))+
	BSST(sprintf("(5) %25-s %d","Stufe: ", QueryProp(P_LEVEL)))+
	BSST(sprintf("(6) %25-s %d","Groesse: ", QueryProp(P_SIZE)))+
	BSST(sprintf("(7) %25-s %s","Gesinnung: ", al2str(QueryProp(P_ALIGN))))+
	BSST("(8) Kurzbeschreibung:")+
	BS(QueryProp(P_SHORT)+".")+
	BSST("(9) Langbeschreibung:")+
	BS(QueryProp(P_LONG)));
}

void change_npc(string what, string str)
{
  switch(str)
    {
    case "1":
    case "name": RemoveId(lower_case(QueryProp(P_NAME)));
      SetProp(P_NAME, what); AddId(({"npc",lower_case(what)})); 
      break;
    case "2":
   case "geschlecht": SetProp(P_GENDER, str2gen(lower_case(what))); 
      break;
    case "3":
    case "artikel": SetProp(P_ARTICLE, str2t(what));
      break;
    case "4":
    case "rasse": SetProp(P_RACE, CAP(what)); 
      break;
    case "5":
    case "stufe": if(to_int(what) < 1) what="1"; 
      if(to_int(what) > 100) what="100";
      create_default_npc(to_int(what));
      SetProp(P_XP, 0);
      break;
    case "6":
    case "groesse": if(to_int(what) < 1) what="1"; 
      SetProp(P_SIZE, to_int(what));
      break;
    case "7":
    case "gesinnung": SetProp(P_ALIGN, str2al(what));
      break;
    case "8":
    case "kurzbeschreibung": what=regreplace(what, "[.]$", "", 1);
      SetProp(P_SHORT, what); 
      break;
    case "9":
    case "langbeschreibung": SetProp(P_LONG, what); 
      break;
    }
  write(BSST("Fertig."));
  
  write_file(LOG "game_"+game+"_changes", dtime()+": "+TPN+" aendert "+str+
	     " zu "+what+" ("+explode(file_name(), "/")[<1]+").\n");
  
  aendern_usage();
  write("? ");
  input_to("customize");
}

void customize(string str)
{
  string *tmp;
  string what;
  
  if(!str)
    {
      aendern_usage();
      write("? ");
      input_to("customize");
    }
  
  if(strstr(str, "aendere ")==0)
    str=str[8..];
  
  if(sizeof(tmp=explode(str, " ")) > 1)
    {
      str=tmp[0];
      what=implode(tmp[1..], " ");
    }
  
  str=lower_case(str);
  
  switch(str)
    {
    case "1":
    case "name": 
      if(strlen(what))
	{
	  change_npc(what, str);
	  return;
	}
      write(BSST("Namen bitte kurz, ohne Artikel und ohne Adjektive:")+
	    BSST("z.B.: Troll, Gnom etc."));
      write("Name:  ");
      input_to("change_npc", 0, str);
      return;
    case "2":
    case "geschlecht":
      if(strlen(what))
	{
	  change_npc(what, str);
	  return;
	}
      write(BSST("Folgende Geschlechter sind erlaubt:")+
	    BSST("maennlich, weiblich, saechlich."));
      write("Geschlecht:  ");
      input_to("change_npc", 0, str);
      return;
    case "3":
    case "artikel": 
      if(strlen(what))
	{
	  change_npc(what, str);
	  return;
	}
      write(BSST("Soll der NPC einen Artikel haben?\n"
		 "mit Artikel z.B.:  Ein Troll, Ein gemeiner Gnom\n"
		 "ohne Artikel z.B.: Max, Herbert\n"));
      write("Kurzbeschreibung:  ");
      input_to("change_npc", 0, str);
      return;
    case "4":
    case "rasse":
      if(strlen(what))
	{
	  change_npc(what, str);
	  return;
	}
      write(BSST("Die Rasse allgemein halten: ")+
	    BSST("Troll, Mensch, Hund."));
      write("Rasse:  ");
      input_to("change_npc", 0, str);
      return;
    case "5":
    case "stufe":
      if(strlen(what))
	{
	  change_npc(what, str);
	  return;
	}
      write(BSST("Die Stufe sollte kleiner als 100 sein."));
      write("Stufe:  ");
      input_to("change_npc", 0, str);
      return;
    case "6":
    case "groesse":
      if(strlen(what))
	{
	  change_npc(what, str);
	  return;
	}
      write(BSST("Eine sinnvolle Groesse (cm) bitte: "));
      write("Rasse:  ");
      input_to("change_npc", 0, str);
      return;
    case "7":
    case "gesinnung":
      if(strlen(what))
	{
	  change_npc(what, str);
	  return;
	}
      write(BSST("Moegliche Werte fuer die Gesinnung:")+
	    BSST("Heilig, gut, nett, neutral, frech, boese, satanisch"));
      write("Gesinnung:  ");
      input_to("change_npc", 0, str);
      return;
    case "8":
    case "kurzbeschreibung": 
      if(strlen(what))
	{
	  change_npc(what, str);
	  return;
	}
      write(BSST("Bitte kurz halten:")+
	    BSST("z.B.: Ein Troll, Ein gemeiner Gnom etc."));
      write("Kurzbeschreibung:  ");
      input_to("change_npc", 0, str);
      return;
    case "9":
    case "langbeschreibung": 
      if(strlen(what))
	{
	  change_npc(what, str);
	  return;
	}
      write(BSST("Nicht zu umstaendlich, es gibt keinen Editor dafuer."));
      write("Langbeschreibung:  ");
      input_to("change_npc", 0, str);
      return;
    case "q":
    case "quit":
    case "fertig":
    case "abbrechen": return;      
    default:  

      aendern_usage();
      write("? ");
      input_to("customize");
    }
}

nosave int cmd_aendern(string str)
{
  notify_fail(BSST("Welches Objekt willst Du aendern?"));
  if(!str) return 0;
  
  if(!id(str)) return 0;
  
  if(!allowed_manager(TP)) 
    return write(BSST("Du darfst diesen NPC nicht veraendern!")), 1;
  
  aendern_usage();
  
  write("? ");
  
  input_to("customize");
  return 1;
}

void give_notify(object ob)
{
  object *ar;
  object tmp;
  
  if(ob->QueryProp(P_WEAPON_TYPE))
    {
      if(objectp(tmp=QueryProp(P_WEAPON)))
	drop_obj(tmp);
      
      command_me("zuecke "+lower_case(ob->QueryProp(P_NAME)));
      
      call_out("check_for_weapon", 0, ob);
      
      return;
    }
  
  if(ob->QueryProp(P_ARMOUR_TYPE))
    {
      if(sizeof(ar=QueryArmours(ob->QueryProp(P_ARMOUR_TYPE))))
	drop_obj(ar[0]);
      
      command_me("trage "+lower_case(ob->QueryProp(P_NAME)));
      
      call_out("check_for_armour", 0, ob);
    }
}

void check_for_weapon(object ob)
{
  if(ob!=QueryProp(P_WEAPON))
    {
      sfkt("Kann "+ob->name(WEN)+" nicht zuecken!");
      
      drop_obj(ob);
    }
}

void check_for_armour(object ob)
{
  object *ar;
  
  if(sizeof(ar=QueryArmours(ob->QueryProp(P_ARMOUR_TYPE))))
    if(ob==ar[0])
      return;
  
  sfkt("Kann "+ob->name(WEN)+" nicht anziehen!");
  
  drop_obj(ob);
}

void init()
{
  ::init();
  
  if(!allowed_env())
    remove();
}

void reset()
{
  ::reset();
  
  if(!allowed_env())
    remove();
}

void SetUp(string g)
{
  game=g;
}

string QueryGameName()
{
  return game;
}
