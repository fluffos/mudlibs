/* 
** Eine Waffe fuer das RPG-Projekt SL
**
** Kann nichts, aber dafuer ist das Aussehen frei konfigurierbar.
**
*/

nosave string game;

#include "../def.h"

inherit "std/weapon";

int allowed_env()
{ 
  if(!MENV) return 0; 
  
  if((living(MENV)) && (strstr(file_name(ENV(MENV)), ZONE)==0)) 
    return 1; 
 
  if(strstr(file_name(MENV), ZONE)==0) 
    return 1; 
  
  return 0; 
}

int allowed_manager(object who)
{
  if(!RPGMASTER->GameMaster(who,game)) return 0;
  return 1;
}

string wc2str(string str)
{
  switch(str)
    {
    case WT_SWORD: return "Schwert";  break;
    case WT_AXE:   return "Axt";      break;
    case WT_CLUB:  return "Keule";    break;
    case WT_SPEAR: return "Speer";    break;
    case WT_KNIFE: return "Messer";   break;
    case WT_WHIP:  return "Peitsche"; break;
    case WT_CHAIN: return "Kette";    break;
    case WT_BOW:   return "Bogen";    break;
    default : return "Unbekannt!";
    }
}

string str2wc(string str)
{
  switch(str)
    {
    case "schwert":  return WT_SWORD; break;
    case "axt":      return WT_AXE;   break;
    case "keule":    return WT_CLUB;  break;
    case "speer":    return WT_SPEAR; break;
    case "messer":   return WT_KNIFE; break;
    case "peitsche": return WT_WHIP;  break;
    case "kette":    return WT_CHAIN; break;
    case "bogen":    return WT_BOW;   break;
    default : return WT_SWORD;
    }
}

int str2gen(string str)
{
  switch(str)
    {
    case "weiblich":
    case "feminin":  return FEMALE; break;
    case "maennlich":
    case "maskulin": return MALE; break;
    default: return NEUTER;
    }
}

string gen2str(int g)
{
  switch(g)
    {
    case FEMALE: return "weiblich";  break;
    case MALE:   return "maennlich"; break;
    default: return "saechlich"; break;
    }
}

void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Waffe");
  SetProp(P_LONG,
	  "Eine nackte Waffe.");
  SetProp(P_NAME, "Waffe");
  SetProp(P_GENDER, FEMALE);
  AddId(({RPG_PROJECT_ID, "requisit","waffe","SKILL_NOLEARN"}));

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 1);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_MATERIAL, MAT_MISC_SOLID);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_WEIGHT, 1);
  SetProp(P_SIZE, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 100);
  
  SetProp(P_WIELD_FUNC, TO);
  SetProp(P_HIT_FUNC, TO);
  
  AddCmd(({"aender","aendere"}), "cmd_aendern");
}

varargs void aendern_usage(int flag)
{
  write((!flag ? BSST(" Was willst Du denn aendern? Abbrechen mit q.")+
	 BSST(" Beachte bitte die Gross-kleinschreibung.")+
	 BSST("=============================================") : "")+
	BSST(sprintf("(1) %25-s %s","Waffentyp: ",wc2str(QueryProp(P_WEAPON_TYPE))))+
	BSST(sprintf("(2) %25-s %s","Name: ", QueryProp(P_NAME)))+
	BSST(sprintf("(3) %25-s %s","Geschlecht: ",gen2str(QueryProp(P_GENDER))))+
	BSST("(4) Kurzbeschreibung:")+
	BS(QueryProp(P_SHORT)+".")+
	BSST("(5) Langbeschreibung:")+
	BS(QueryProp(P_LONG)));
}

void change_weapon(string what, string str)
{
  switch(str)
    {
    case "1":
    case "waffentyp": 
      RemoveId(lower_case(wc2str(QueryProp(P_WEAPON_TYPE))));
      SetProp(P_WEAPON_TYPE, str2wc(lower_case(what))); 
      AddId(lower_case(wc2str(QueryProp(P_WEAPON_TYPE))));
      break;
    case "2":
    case "name": RemoveId(lower_case(QueryProp(P_NAME)));
      SetProp(P_NAME, what); AddId(({"waffe",lower_case(what)})); 
      break;
    case "3":
    case "geschlecht": SetProp(P_GENDER, str2gen(lower_case(what))); 
      break;
    case "4":
    case "kurzbeschreibung": what=regreplace(what, "[.]$", "", 1);
      SetProp(P_SHORT, what); 
      break;
    case "5":
    case "langbeschreibung": SetProp(P_LONG, what); 
      break;
    }
  write(BSST("Fertig."));
  
  write_file(LOG "game_"+game+"_changes", dtime()+": "+TPN+" aendert "+str+
	     " zu "+what+" ("+explode(file_name(), "/")[<1]+").\n");
  
  aendern_usage();
  write("? ");
  input_to("customize");
}

void customize(string str)
{
  string *tmp;
  string what;
  
  if(!str)
    {
      aendern_usage();
      write("? ");
      input_to("customize");
    }
  
  if(strstr(str, "aendere ")==0)
    str=str[8..];
  
  if(sizeof(tmp=explode(str, " ")) > 1)
    {
      str=tmp[0];
      what=implode(tmp[1..], " ");
    }
  
  switch(str)
    {
    case "1":
    case "waffentyp": 
      if(strlen(what))
	{
	  change_weapon(what, str);
	  return;
	}
      write(BSST("Folgende Waffentypen sind erlaubt:")+
	    BSST("Schwert, Axt, Keule, Speer, Messer, Peitsche, Kette und "
	       "Bogen."));
      write("Waffentyp:  ");
      input_to("change_weapon", 0, str);
      return;
    case "2":
    case "name": 
      if(strlen(what))
	{
	  change_weapon(what, str);
	  return;
	}
      write(BSST("Namen bitte kurz, ohne Artikel und ohne Adjektive:")+
	    BSST("z.B.: Messer, Schwert etc."));
      write("Name:  ");
      input_to("change_weapon", 0, str);
      return;
    case "3":
    case "geschlecht":
      if(strlen(what))
	{
	  change_weapon(what, str);
	  return;
	}
      write(BSST("Folgende Geschlechter sind erlaubt:")+
	    BSST("maennlich, weiblich, saechlich."));
      write("Geschlecht:  ");
      input_to("change_weapon", 0, str);
      return;
    case "4":
    case "kurzbeschreibung": 
      if(strlen(what))
	{
	  change_weapon(what, str);
	  return;
	}
      write(BSST("Bitte kurz halten:")+
	    BSST("z.B.: Ein Messer, Ein magschisches Schwert etc."));
      write("Kurzbeschreibung:  ");
      input_to("change_weapon", 0, str);
      return;
    case "5":
    case "langbeschreibung": 
      if(strlen(what))
	{
	  change_weapon(what, str);
	  return;
	}
      write(BSST("Nicht zu umstaendlich, es gibt keinen Editor dafuer."));
      write("Langbeschreibung:  ");
      input_to("change_weapon", 0, str);
      return;
    case "q":
    case "quit":
    case "fertig":
    case "abbrechen": return;      
    default:  

      aendern_usage();
      write("? ");
      input_to("customize");
    }
}

nosave int cmd_aendern(string str)
{
  notify_fail(BSST("Welches Objekt willst Du aendern?"));
  if(!str) return 0;
  
  if(!id(str)) return 0;
  
  if(!allowed_manager(TP)) 
    return write(BSST("Du darfst diese Waffe nicht veraendern!")), 1;
  
  aendern_usage();
  
  write("? ");
  
  input_to("customize");
  return 1;
}

int WieldFunc(object waffe) 
{

  if(!allowed_env())
    {
      remove();
      return 0;
    }
  
  return 1;
}

int HitFunc(object enemy) 
{
  if(!allowed_env())
    remove();
  
  return -400; // Bloss nicht kaempfen damit ;)
}

void init()
{
  ::init();
  
  if(!allowed_env())
    remove();
}

void reset()
{
  ::reset();
  
  if(!allowed_env())
    remove();
}

void SetUp(string g)
{
  game=g;
}

string QueryGameName()
{
  return game;
}
