/* 
** Ein Dokument fuer das RPG-Projekt SL
**
** Kann nichts, aber dafuer ist das Aussehen frei konfigurierbar.
**
*/

nosave string game;

#include "../def.h"

inherit "std/thing";
inherit "/d/wueste/protheg/most/std_things";

int allowed_env()
{ 
  if(!MENV) return 0; 
  
  if((living(MENV)) && (strstr(file_name(ENV(MENV)), ZONE)==0)) 
    return 1; 
 
  if(strstr(file_name(MENV), ZONE)==0) 
    return 1; 
  
  return 0; 
}

int allowed_manager(object who)
{
  if(!RPGMASTER->GameMaster(who,game)) return 0;
  return 1;
}

int str2gen(string str)
{
  switch(str)
    {
    case "weiblich":
    case "feminin":  return FEMALE; break;
    case "maennlich":
    case "maskulin": return MALE; break;
    default: return NEUTER;
    }
}

string gen2str(int g)
{
  switch(g)
    {
    case FEMALE: return "weiblich";  break;
    case MALE:   return "maennlich"; break;
    default: return "saechlich"; break;
    }
}

void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Dokument");
  SetProp(P_LONG,
	  "Ein Dokument, Du kannst es lesen.");
  SetProp(P_NAME, "Dokument");
  SetProp(P_GENDER, MALE);
  AddId(({RPG_PROJECT_ID, "requisit","dokument","SKILL_NOLEARN"}));

  SetProp(P_MATERIAL, MAT_MISC_SOLID);
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  
  SetProp(P_READ_MSG, "Da steht nichts drauf.");
  
  AddCmd(({"aender","aendere"}), "cmd_aendern");
}

varargs void aendern_usage(int flag)
{
  write((!flag ? BSST(" Was willst Du denn aendern? Abbrechen mit q.")+
	 BSST(" Beachte bitte die Gross-kleinschreibung.")+
	 BSST("=============================================") : "")+
	BSST(sprintf("(1) %25-s %s","Name: ", QueryProp(P_NAME)))+
	BSST(sprintf("(2) %25-s %s","Geschlecht: ",gen2str(QueryProp(P_GENDER))))+
	BSST("(3) Kurzbeschreibung:")+
	BS(QueryProp(P_SHORT))+
	BSST("(4) Langbeschreibung:")+
	BS(QueryProp(P_LONG))+
	BSST("(5) Inhalt:")+
	BS(QueryProp(P_READ_MSG)));
}

void change_obj(string what, string str)
{
  switch(str)
    {
    case "1":
    case "name": RemoveId(lower_case(QueryProp(P_NAME)));
      SetProp(P_NAME, what); AddId(({"objekt",lower_case(what)})); 
      break;
    case "2":
    case "geschlecht": SetProp(P_GENDER, str2gen(lower_case(what))); 
      break;
    case "3":
    case "kurzbeschreibung": what=regreplace(what, "[.]$", "", 1);
      SetProp(P_SHORT, what); 
      break;
    case "4":
    case "langbeschreibung": SetProp(P_LONG, what); 
      break;
    case "5":
    case "inhalt": SetProp(P_READ_MSG, make_document(what));
      break;
    }
  write(BSST("Fertig."));
  
  write_file(LOG "game_"+game+"_changes", dtime()+": "+TPN+" aendert "+str+
	     " zu "+what+" ("+explode(file_name(), "/")[<1]+").\n");
  
  aendern_usage();
  write("? ");
  input_to("customize");
}

void customize(string str)
{
  string *tmp;
  string what;
  
  if(!str)
    {
      aendern_usage();
      write("? ");
      input_to("customize");
    }
  
  if(strstr(str, "aendere ")==0)
    str=str[8..];
  
  if(sizeof(tmp=explode(str, " ")) > 1)
    {
      str=tmp[0];
      what=implode(tmp[1..], " ");
    }
  
  switch(str)
    {
    case "1":
    case "name": 
      if(strlen(what))
	{
	  change_obj(what, str);
	  return;
	}
      write(BSST("Namen bitte kurz, ohne Artikel und ohne Adjektive:")+
	    BSST("z.B.: Zettel, Pergament etc."));
      write("Name:  ");
      input_to("change_obj", 0, str);
      return;
    case "2":
    case "geschlecht":
      if(strlen(what))
	{
	  change_obj(what, str);
	  return;
	}
      write(BSST("Folgende Geschlechter sind erlaubt:")+
	    BSST("maennlich, weiblich, saechlich."));
      write("Geschlecht:  ");
      input_to("change_obj", 0, str);
      return;
    case "3":
    case "kurzbeschreibung": 
      if(strlen(what))
	{
	  change_obj(what, str);
	  return;
	}
      write(BSST("Bitte kurz halten:")+
	    BSST("z.B.: Ein Zettel, Ein Pergament etc."));
      write("Kurzbeschreibung:  ");
      input_to("change_obj", 0, str);
      return;
    case "4":
    case "langbeschreibung": 
      if(strlen(what))
	{
	  change_obj(what, str);
	  return;
	}
      write(BSST("Nicht zu umstaendlich, es gibt keinen Editor dafuer."));
      write("Langbeschreibung:  ");
      input_to("change_obj", 0, str);
      return;
    case "5":
    case "inhalt": 
      if(strlen(what))
	{
	  change_obj(what, str);
	  return;
	}
      write(BSST("Nicht zu umstaendlich, es gibt keinen Editor dafuer."));
      write("Inhalt:  ");
      input_to("change_obj", 0, str);
      return;
    case "q":
    case "quit":
    case "fertig":
    case "abbrechen": return;      
    default:  

      aendern_usage();
      write("? ");
      input_to("customize");
    }
}

nosave int cmd_aendern(string str)
{
  notify_fail(BSST("Welches Objekt willst Du aendern?"));
  if(!str) return 0;
  
  if(!id(str)) return 0;
  
  if(!allowed_manager(TP)) 
    return write(BSST("Du darfst dieses Objekt nicht veraendern!")), 1;
  
  aendern_usage();
  
  write("? ");
  
  input_to("customize");
  return 1;
}

void init()
{
  ::init();
  
  if(!allowed_env())
    remove();
}

void reset()
{
  ::reset();
  
  if(!allowed_env())
    remove();
}

void SetUp(string g)
{
  game=g;
}

string QueryGameName()
{
  return game;
}
