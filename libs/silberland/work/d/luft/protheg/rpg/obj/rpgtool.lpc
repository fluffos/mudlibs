void customize_predefined_object(string what)
{
  object o;
  
  if(what=="q" || what=="abbrechen" || what=="quit") 
    return write(BSST("Ok, Abbruch."));
  
  if(!member(PD_OBJECTS, what))
    {
      write(BSST(implode(m_indices(PD_OBJECTS), ", "))+
	    BSST("Bitte waehle eines aus, oder tippe 'q' um abzubrechen."));
      
      write("Auswahl: ");
      
      input_to("customize_predefined_object", 0);
      
      return;
    }
  
  o=clone_object(OBJ "" + PD_OBJECTS[what]);
  
  o->move(TP, M_NOCHECK);
   
  o->SetUp(game);
 
  write(BSST("Objekt '"+what+"' fertig."));  
  
  write_file(LOG "game_"+game, dtime()+": "+TPN+" erzeugt ein fertiges Objekt '"+what+"'.\n");
}

void new_object(string what)
{
  object o;
  
  if(!strlen(what))
    {
      o=clone_object(OBJ "rpgobj");
      
      o->move(TP, M_NOCHECK);

      o->SetUp(game);
      
      write_file(LOG "game_"+game, dtime()+": "+TPN+" erzeugt ein Objekt.\n");
      
      return write(BSST("Fertig."));
    }
  
  write(BSST("Folgende vordefinierte Objekte stehen zur Auswahl:"));
  
  write(BSST(implode(m_indices(PD_OBJECTS), ", "))+
	BSST("Bitte waehle eines aus, oder tippe 'q' um abzubrechen."));
  
  write("Auswahl: ");
  
  input_to("customize_predefined_object", 0);
}  

