void new_room(string str, string what)
{
  string *rooms;
  string *dirs;
  string c;
  object r,h;
  int nr,i;
  
  if(str=="q" || str=="abbrechen" || str=="quit") 
    return write(BSST("Ok, Abbruch."));
  
  if(sizeof(dirs=explode(str, " "))>2)
    return write(BSST("Nur zwei Ausgaenge angeben bitte!"));
  
  if(strstr(file_name(h=ENV(TP)), ROOM "rpgroom_")!=0)
    return write(BSST("Hier geht das nicht!"));
  
  str=dirs[0];
  
  if(sizeof(dirs)==2)
    c=dirs[1];
  else
    c=PD_EXITS[str];
  
  if((!member(PD_EXITS, str)) && (sizeof(dirs)==1))
    return write(BSST("Unbekannter Ausgang, bitte mit Gegenausgang angeben."));
  
  if(member(h->QueryProp(P_EXITS), str))
    return write(BSST("Dieser Ausgang existiert bereits!"));
  
  nr=RPGMASTER->NewRoom(game);
  
  call_other(ROOM "rpgroom_"+game+"_"+nr, "rpgloadme");
  
  r=find_object(ROOM "rpgroom_"+game+"_"+nr);

  write(BSST("Neuer Raum ("+nr+") angelegt..."));  

  h->AddExit(str, ROOM "rpgroom_"+game+"_"+nr);

  write(BSST("Setze Ausgang "+str+" dorthin..."));
  
  r->AddExit(c, file_name(h));
  
  write(BSST("Setze Ausgang "+c+" von dort hierher..."));
  
  if(!strlen(what))
    {
      write_file(LOG "game_"+game, dtime()+": "+TPN+" erzeugt einen Raum.\n");
      
      return write(BSST("Fertig."));
    }

  write(BSST("Folgende vordefinierte Raeume stehen zur Auswahl:"));
  
  write(BSST(implode(m_indices(PD_ROOMS), ", "))+
	BSST("Bitte waehle einen aus, oder tippe 'q' um den Raum so zu lassen "
	   "wie er jetzt ist."));
  
  write("Auswahl: ");
  
  input_to("customize_predefined_room", 0, r);  
}

nosave int cmd_erzeugen(string str)
{
  string *tmp;
  string what;
  
  if(!TP) return 0;
  
  if(!allowed_manager(TP)) return 0;
  
  notify_fail(BSST("Was willst Du erzeugen? Raum, Waffe, Ruestung, Objekt, Npc?"));
  if(!str) return 0;
  
  if(ENV(TP)->QueryGameName()!=game)
    return write(BS("Hier geht das nicht!")), 1;
  
  if(sizeof(tmp=explode(str, " "))>1)
    what=implode(tmp[1..], " ");
  
  str=tmp[0];
  
  if(strlen(what))
    if(what!="vordefiniert")
      return write(BSST("Meintest Du 'vordefiniert' ?")),1;
  
  switch(str)
    {
    case "raum":
      write(BSST("Ok, ein neuer "+(strlen(what) ? "vordefinierter ":"")+"Raum "
	       "wird erzeugt.")+
	    BSST("Welcher Ausgang soll diesen Raum mit dem neuen verbinden?")+
	    BSST("Fuer normale Ausgaenge wie 'norden', 'oben' etc. wird der "
	       "jeweilige Rueckweg selbst ermittelt. Bei speziellen "
	       "Ausgaengen bitte Hin- und Rueckweg angeben.")+
	    BSST("zB: 'norden' , 'rein raus', 'hinueber zurueck'")+
	    BSST("Abbrechen mit 'q'."));
      write("Ausgang: ");
      input_to("new_room", 0, what);
      break;
    case "waffe":
      write(BSST("Ok, eine neue "+(strlen(what) ? "vordefinierte ":"")+"Waffe "
	       "wird erzeugt."));
      new_weapon(what);
      break;
    case "ruestung":
      write(BSST("Ok, eine neue "+(strlen(what) ? "vordefinierte ":"")+
	       "Ruestung wird erzeugt."));
      new_armour(what);
      break;
    case "objekt":
      write(BSST("Ok, ein neues "+(strlen(what) ? "vordefiniertes ":"")+
	       "Objekt wird erzeugt."));
      new_object(what);
      break;
    case "npc":
      write(BSST("Ok, ein neuer "+(strlen(what) ? "vordefinierter ":"")+
	       "Npc wird erzeugt."));
      new_npc(what);
      break;
    default: return 0;
    }
  return 1;
}

nosave int cmd_zerstoeren(string str)
{
  object ob;
  
  if(!TP) return 0;
  
  if(!allowed_manager(TP)) return 0;
  
  notify_fail(BSST("Was willst Du zerstoeren?"));
  if(!str) return 0;
  
  if(!objectp(ob=present(str, TP)))
    if(!objectp(ob=present(str, ENV(TP))))
      return write(BSST("Sicher, dass es sowas geben soll?")), 1;
  
  if(!ob->id(RPG_PROJECT_ID))
    return write(BSST("Nein, Du kannst nur Requisiten zerstoeren!")), 1;
  
  ob->SetProp(P_CURSED, 0);
  ob->remove(1);
  
  if(objectp(ob)) destruct(ob);
  
  if(objectp(ob))
    return write(BSST("Hm, das will nicht zerstoert werden.")), 1;
  
  write(BSST(CAP(str)+" wurde zerstoert."));
  
  return 1;
}

