
#include "../def.h"

inherit "std/thing";
inherit "/d/wueste/protheg/most/std_things";

string uebersicht()
{
  if(!TP) return "";
  
  TP->More(make_document(
    "Gamemastern leicht gemacht mit dem Gamemaster PRO 1.0\n"
    "------------------------------------------------------\n \n"
    "Kapiteleinteilung:\n"+
    sprintf("%30-'.'s%30'.'s\n", "Uebersicht", "'lies broschuere'")+
    sprintf("%30-'.'s%30'.'s\n", "Kapitel 1 Allgemein", "'lies kapitel 1'")+
    sprintf("%30-'.'s%30'.'s\n", "Kapitel 2 Raeume", "'lies kapitel 2'")+
    sprintf("%30-'.'s%30'.'s\n", "Kapitel 3 NPCs", "'lies kapitel 3'")+
    sprintf("%30-'.'s%30'.'s\n", "Kapitel 4 Waffen", "'lies kapitel 4'")+
    sprintf("%30-'.'s%30'.'s\n", "Kapitel 5 Ruestungen", "'lies kapitel 5'")+
    sprintf("%30-'.'s%30'.'s\n", "Kapitel 6 Objekte", "'lies kapitel 6'")+
    sprintf("%30-'.'s%30'.'s\n", "Kapitel 7 Spezielle Objekte", "'lies kapitel 7'")+
    sprintf("%30-'.'s%30'.'s\n", "Kapitel 8 Wuerfeln", "'lies kapitel 8'")+
    sprintf("%30-'.'s%30'.'s\n", "Kapitel 9 Kommunikation", "'lies kapitel 9'")+
    "\n \n"
    "!!WICHTIG!! Bei Fragen/Fehlern/etc. bitte PROtheG\n"
    "verstaendigen! Bitte keine anderen Magier fragen,\n"
    "weil er/sie sonst evtl etwas kaputtmacht!\n"));
  
  return "";
}

string kapitel1() // Allgemein
{
  if(!TP) return "";

  TP->More(make_document(break_string(" \n"
      "Zuallererst einmal: Du bist der Gamemaster und hast eine gewisse "
      "Verantwortung zu tragen, dem Spiel und den Spielern gegenueber.\n \n"
				      
      "Ebenso musst Du die Spieler etwas in Deine Welt einfuehren, klaere "
      "sie vor allem ueber die Kommunikation und das Wuerfeln auf.\n \n"
				      
      "Zusaetzlich wird das Erzeugen und Veraendern von Requisiten fuer das Spiel "
      "mitgeloggt, sodass evtl. Fehler nachvollziehbar bleiben, oder "
      "Falschbehandlungen festgestellt werden koennen.\n \n"
				      
      "Sonst steht Deiner Phantasie, eine halbwegs realistische Umgebung fuer "
      "Dein Spiel zu erschaffen, nichts im Weg. Du hast Deinen Zauberstab, mit "
      "dem Du Requisiten erzeugen oder wieder zerstoeren kannst. Zusaetzlich kannst "
      "Du jedes Requisit in einem gewissen Rahmen an Deine Wuensche anpassen.\n \n"
				      
      "Im Anfangsraum, auf Wolke 3 kannst Du ein Spiel eroeffnen, die Syntax dazu "
      "steht auf dem Holzschild. Dabei musst Du einen sehr kurz gehaltenen Namen "
      "angeben und angeben, ob das Spiel geschlossen oder fuer alle zugaenglich "
      "sein soll. Dabei wird der erste Raum eroeffnet und ist mit dem Namen "
      "des Spieles betretbar.\n \n"
				      
      "Dort kannst Du Dein laufendes Spiel natuerlich auch jederzeit beenden, "
      "dabei werden die Spieler, die sich noch im Gebiet befinden automatisch "
      "zurueckgeholt und die Requisiten zerstoert.\n \n"
				      
      "Bitte achte auch darauf, dass die Spieler die Requisiten nicht "
      "zb zum ueben missbrauchen o.ae.\n \n"
				      
      "Bei der Namensgebung aufpassen, da das jeweilige Requisit nur per Name "
      "angesprochen werden kann. (zB wirf degen weg, trete schildkroete) "
      "Falls sich ein Objekt einmal nicht mehr ansprechen laesst, kannst Du "
      "es mit 'requisit' (npc mit 'statist') ansprechen.\n \n"
				      
      "Die Requisiten werden generell beim ausloggen oder rausgetranst werden "
      "oder das Gelaende verlassen (ja auch beim zurueckkehren auf Wolke 3) "
      "zerstoert.\n \n"
				      
      "", 
      64, 0, BS_LEAVE_MY_LFS|BS_NO_PARINDENT|BS_BLOCK)));
  
  return "";
}

string kapitel2() // Raeume
{
  if(!TP) return "";

  TP->More(make_document(break_string(" \n"
      "Mehrere Raeume zu verwalten ist recht komplex und erfordert eine gut "
      "durchdachte Planung.\n \n"
      "Jeder Raum hat eine bestimmte Nummer und kann ueber sie mit anderen "
      "Raeumen verbunden werden.\n \n"
      "Bei der Erzeugung eines neuen Raumes wird gleichzeitig auch ein "
      "Ausgang in den aktuellen Raum festgelegt.\n \n"
      "Die Raumnummer und eine Uebersicht siehst Du mit 'uebersicht'\n \n"
      "Syntaxen dazu sind:\n"
      "'erzeuge raum'                - Neuer Raum\n"
      "'verbinde raum mit raum <nr>  - Aktuellen Raum mit Raum <nr>\n"
      "                                verbinden\n"
      "'entferne ausgang <name>      - Ausgang <name> wird entfernt\n"
      "                                Vorsicht: Nur einseitig entfernt\n"
      "'haenge raum <nr> ab          - Raum <nr> wird komplett von\n"
      "                                diesem Raum abgehaengt\n"
      "'aendere raum'                - Veraendere Raum\n \n"
      "Raeume koennen nicht zerstoert werden, sie koennen nur komplett "
      "abgehaengt werden.\n",
      64, 0, BS_LEAVE_MY_LFS|BS_NO_PARINDENT|BS_BLOCK)));
  
  return "";
}

string kapitel3() // NPCs
{
  if(!TP) return "";

  TP->More(make_document(break_string(" \n"
      "Einen NPC erzeugst Du mit 'erzeuge npc'\n"
      "Einen vordefinierten NPC mit 'erzeuge npc vordefiniert'\n \n"

      "Ist der NPC einmal erzeugt, kannst Du ihn mit\n"
      "'aendere <name>' feinabstimmen.\n \n"

      "Aendern kannst Du folgendes:\n"
      "Name, Geschlecht, Rasse, Stufe, Groesse, Gesinnung, "
      "Meldungen, Kurzbeschreibung und Langbeschreibung.\n \n"

      "Ist der NPC einmal fertig, kannst Du ihm Ruestungen, Waffen und "
      "andere Objekten geben, wobei er versucht, Waffen zu zuecken und "
      "Ruestungen anzuziehen.\n \n"

      "Mit 'rpgzwinge <name> <befehl>[## befehl...]' kannst Du dem NPC "
      "befehlen, zB etwas zu sagen, zu emoten oder einen Gegenstand "
      "wegzuwerfen, etc. Willst Du, dass mehrere Befehle hintereinander "
      "ausgefuehrt werden, kannst Du sie mit ## getrennt angeben, z.B: "
      "'rpgzwinge troll sage Hallo ## grins'\n",
      64, 0, BS_LEAVE_MY_LFS|BS_NO_PARINDENT|BS_BLOCK)));
  
  return "";
}

string kapitel4() // Waffen
{
  if(!TP) return "";

  TP->More(make_document(break_string(" \n"
      "Eine Waffe erzeugst Du mit 'erzeuge waffe'\n"
      "Eine vordefinierte Waffe mit 'erzeuge waffe vordefiniert'\n \n"
      "Ist die Waffe einmal erzeugt, kannst Du sie mit\n"
      "'aendere <name>' feinabstimmen.\n \n"
      "Aendern kannst Du folgendes:\n"
      "Name, Waffentyp, Geschlecht, Kurzbeschreibung und Langbeschreibung.\n \n"
      "Die Waffen sind Requisiten und koennen keinen Schaden verursachen.\n",
      64, 0, BS_LEAVE_MY_LFS|BS_NO_PARINDENT|BS_BLOCK)));

  return "";
}

string kapitel5() // Ruestungen
{
  if(!TP) return "";

  TP->More(make_document(break_string(" \n"
      "Eine Ruestung erzeugst Du mit 'erzeuge ruestung'\n"
      "Eine vordefinierte Ruestung mit 'erzeuge ruestung vordefiniert'\n \n"
      "Ist die Ruestung einmal erzeugt, kannst Du sie mit\n"
      "'aendere <name>' feinabstimmen.\n \n"
      "Aendern kannst Du folgendes:\n"
      "Name, Ruestungstyp, Geschlecht, Kurzbeschreibung und Langbeschreibung.\n \n"
      "Die Ruestungen sind Requisiten und schuetzen nicht besonders.\n",
      64, 0, BS_LEAVE_MY_LFS|BS_NO_PARINDENT|BS_BLOCK)));
  
  return "";
}

string kapitel6() // Objekte
{
  if(!TP) return "";

  TP->More(make_document(break_string(" \n"
      "Ein Objekt erzeugst Du mit 'erzeuge objekt'\n"
      "Ein spezielles Objekt mit 'erzeuge objekt vordefiniert'\n \n"
      "Ist das Objekt einmal erzeugt, kannst Du es mit\n"
      "'aendere <name>' feinabstimmen.\n \n"
      "Aendern kannst Du folgendes:\n"
      "Name, Geschlecht, Kurzbeschreibung und Langbeschreibung.\n \n"
      "Vordefinierte Objekte siehe Kapitel 7.\n",
      64, 0, BS_LEAVE_MY_LFS|BS_NO_PARINDENT|BS_BLOCK)));
  
  return "";
}

string kapitel7() // Spezielle Objekte
{
  if(!TP) return "";

  TP->More(make_document(break_string(" \n"
      "Ein spezielles Objekt wird mit 'erzeuge objekt vordefiniert' erzeugt.\n \n"
      "Ist das Objekt einmal erzeugt, kannst Du es mit\n"
      "'aendere <name>' wie ein normales Objekt feinabstimmen.\n \n"
      "Geld: Natuerlich gibt es auch hier spezielles Spielgeld. Du kannst Dir "
      "eine Kupfermuenze erschaffen und mit 'aendere kupfermuenze' die Menge "
      "festlegen. Bitte sorgsam mit dem Geld umgehen.\n \n"
      "Fackel: Kann oft sehr nuetzlich sein.\n \n"
      "Behaelter: Ein Beutel, ein Sack oder gar eine Schuessel...\n \n"
      "Dokument: Eine Schatzkarte oder ein wertvolles Schriftstueck...\n",
      64, 0, BS_LEAVE_MY_LFS|BS_NO_PARINDENT|BS_BLOCK)));
  
  return "";
}

string kapitel8() // Wuerfeln
{
  if(!TP) return "";

  TP->More(make_document(break_string(" \n"
      "In einem echten Rollenspiel darf natuerlich nicht das Wuerfeln fehlen! "
      "Daher gibt es im Spiel den Befehl 'wuerfel'\n \n"

      "Syntax: 'wuerfel <wuerfel>[+Zahl] [verdeckt]'\n \n"

      "So ergeben sich folgende Moeglichkeiten:\n"
      "Ein Sechsseiter:        'wuerfel 1w6'\n"
      "Zwei Zwanzigseiter:     'wuerfel 2w20'\n"
      "Ein Vierseiter plus 5:  'wuerfel 1w4+5'\n"
      "Ein Zehnseiter minus 2: 'wuerfel 1w10-2'\n"
,
      64, 0, BS_LEAVE_MY_LFS|BS_NO_PARINDENT|BS_BLOCK)));
  
  return "";
}

string kapitel9() // Kommunikation
{
  if(!TP) return "";

  TP->More(make_document(break_string(" \n"
      "Kommunikation ist sehr wichtig im Spiel.\n \n"
      "Daher gibt es einen Channel, der nur im Spiel erreichbar ist.\n"
      "Syntax: '-<spielname> <text>'\n"
      "Um zu sehen, wer da aller mithoert:\n"
      "Syntax '-<spielname> ?'\n \n"
      "Fuer Gamemaster gibt es noch den 'echo' Befehl, um Meldungen in "
      "den Raum setzen zu koennen.\n \n"
      "Das rufen ist ebenfalls nur auf das Spiel beschraenkt.\n"
				      ,
      64, 0, BS_LEAVE_MY_LFS|BS_NO_PARINDENT|BS_BLOCK)));
  
  return "";
}

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Die Broschuere des Gamemasters");
  SetProp(P_LONG,
	  "Eine Broschuere, die helfen soll, sich mit dem Zauberstab des "
	  "Gamemasters zurecht zu finden.");
  SetProp(P_INFO, "Einfach lesen...");
  SetProp(P_NAME, "Broschuere");
  SetProp(P_GENDER, FEMALE);
  AddId(({"broschuere","gamemasterbroschuere","\nrpgbrochure"}));

  SetProp(P_MATERIAL, MAT_PERGAMENT );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  
  SetProp(P_NODROP, 1);
  
  SetProp(P_READ_MSG, CLOSURE(uebersicht));
  
  AddReadDetail(({"kapitel 1","kapitel1","1","allgemein","kapitel allgemein"}), CLOSURE(kapitel1));
  AddReadDetail(({"kapitel 2","kapitel2","2","raeume","kapitel raeume"}), CLOSURE(kapitel2));
  AddReadDetail(({"kapitel 3","kapitel3","3","npcs","kapitel npcs"}), CLOSURE(kapitel3));
  AddReadDetail(({"kapitel 4","kapitel4","4","waffen","kapitel waffen"}), CLOSURE(kapitel4));
  AddReadDetail(({"kapitel 5","kapitel5","5","ruestungen","kapitel ruestungen"}), CLOSURE(kapitel5));
  AddReadDetail(({"kapitel 6","kapitel6","6","objekte","kapitel objekte"}), CLOSURE(kapitel6));
  AddReadDetail(({"kapitel 7","kapitel7","7","spezielle objekte","kapitel spezielle objekte"}), CLOSURE(kapitel7));
  AddReadDetail(({"kapitel 8","kapitel8","8","wuerfeln","kapitel wuerfeln"}), CLOSURE(kapitel8));
  AddReadDetail(({"kapitel 9","kapitel9","9","kommunikation","kapitel kommunikation"}), CLOSURE(kapitel9));
}
