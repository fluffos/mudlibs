#include "../def.h"

#define MSTR 0
#define PLRS 1
#define FLAG 2
#define ROOMS 3

#define CLOSEDGAME 0
#define OPENGAME 1

#define CHANNELHISTSIZE 20

nosave mapping games;
nosave mapping channels;

void create()
{
  if(is_clone(ME)) return destruct(this_object());
  
  games=([]);
  channels=([]);
}

int NewGame(string g, string m, string *pls, int f)
{
  if(member(games, g)) return 0;
  
  if(file_name(PO)!=ROOM "rpgoffice") return 0;
  
  games+=([g:m;pls;f;1]);
  
  channels+=([g:({})]);
  
  return 1;
}

void EndGame(string g)
{
  if(!sizeof(games)) return;
  
  if(!member(games, g)) return;
  
  if(file_name(PO)!=ROOM "rpgoffice") return;
  
  games=m_delete(games, g);
  
  channels=m_delete(channels, g);
}

void CloseGame(string g)
{
  if(!sizeof(games)) return;
  
  if(!member(games, g)) return;
  
  if(file_name(PO)!=ROOM "rpgoffice") return;
  
  games[g, FLAG]=CLOSEDGAME;
}

void OpenGame(string g)
{
  if(!sizeof(games)) return;
  
  if(!member(games, g)) return;
  
  if(file_name(PO)!=ROOM "rpgoffice") return;
  
  games[g, PLRS]=({});
  games[g, FLAG]=OPENGAME;
}

int NewRoom(string g)
{
  if(!sizeof(games)) return 0;
  
  if(!member(games, g)) return 0;
  
  games[g, ROOMS]++;
  
  return games[g, ROOMS];
}

int QueryRooms(string g)
{
  if(!sizeof(games)) return 0;
  
  if(!member(games, g)) return 0;
  
  return games[g, ROOMS];
}

string IsGameMaster(object who)
{
  int i;
  string *ind;
  string w;
  
  if(!sizeof(games)) return 0;
  
  ind=m_indices(games);
  w=getuid(who);
  
  for(i=sizeof(ind)-1;i>=0;i--)
    if(w==games[ind[i], MSTR])
      return ind[i];
  
  return 0;
}

int GameMaster(object who, string g)
{
  if(getuid(who)=="protheg") return 1;
  
  return IsGameMaster(who)==g;
}

int GameExists(string str)
{
  if(!sizeof(games)) return 0;
  
  if(!member(games, str)) return 0;
  
  return 1;
}

int IsPlayer(object who, string g)
{
  if(getuid(who)=="protheg") return 1;
  
  if(!sizeof(games)) return 0;
  
  if(!member(games, g)) return 0;
  
  if(getuid(who)==games[g, MSTR]) return 1;
  
  if(member(games[g, PLRS], getuid(who))!=-1) return 1;
  
  if(getuid(who)=="protheg") return 1; // admin
  
  return 0;
}

int IsGameOpen(string g)
{
  if(!sizeof(games)) return 0;
  
  if(!member(games, g)) return 0;
  
  if(games[g, FLAG]==OPENGAME) return 1;
  
  return 0;
}

string *ClosedGame(string g)
{
  if(!sizeof(games)) return 0;
  
  if(!member(games, g)) return 0;
  
  if(games[g, FLAG]==OPENGAME) return 0;
  
  return games[g, PLRS];
}

int AddPlayer(string g, string n)
{
  if(!sizeof(games)) return 0;
  
  if(!member(games, g)) return 0;
  
  if(file_name(PO)!=ROOM "rpgoffice") return 0;
  
  if(member(games[g, PLRS], n)>-1) return -1;
  
  games[g, PLRS]+=({n});
  
  return 1;
}

int RemovePlayer(string g, string n)
{
  if(!sizeof(games)) return 0;
  
  if(!member(games, g)) return 0;
  
  if(file_name(PO)!=ROOM "rpgoffice") return 0;
  
  if(member(games[g, PLRS], n)==-1) return -1;
  
  games[g, PLRS]-=({n});
  
  return 1;
}

void AddToChannel(string g, string msg)
{
  if(!member(channels, g)) return;
  
  if(strstr(file_name(PO), ROOM "rpgroom_"+g)!=0) return;
  
  channels[g]+=({msg});
  
  if(sizeof(channels[g]) > 20)
    channels[g]=channels[g][<CHANNELHISTSIZE..];
}

string *GetChannelHistory(string g)
{
  if(!member(channels, g)) return ({});
  
  if(strstr(file_name(PO), ROOM "rpgroom_"+g)!=0) return ({});
  
  return channels[g];
}

string *ListOfGames()
{
  return m_indices(games);
}

mapping dumpgames()
{
  return games;
}
