/* 
** Eine Ruestung fuer das RPG-Projekt SL
**
** Kann nichts, aber dafuer ist das Aussehen frei konfigurierbar.
**
*/

nosave string game;

#include "../def.h"

inherit "std/armour";

int allowed_env()
{ 
  if(!MENV) return 0; 
  
  if((living(MENV)) && (strstr(file_name(ENV(MENV)), ZONE)==0)) 
    return 1; 
 
  if(strstr(file_name(MENV), ZONE)==0) 
    return 1; 
  
  return 0; 
}

int allowed_manager(object who)
{
  if(!RPGMASTER->GameMaster(who,game)) return 0;
  return 1;
}

string ac2str(string str)
{
  switch(str)
    {
    case AT_ARMOUR:   return "Panzer";    break;
    case AT_HELMET:   return "Helm";      break;
    case AT_RING:     return "Ring";      break;
    case AT_GLOVE:    return "Handschuh"; break;
    case AT_CLOAK:    return "Umhang";    break;
    case AT_BOOT:     return "Schuh";     break;
    case AT_TROUSERS: return "Hosen";     break;
    case AT_SHIELD:   return "Schild";    break;
    case AT_AMULET:   return "Amulett";   break;
    case AT_BELT:     return "Guertel";   break;
    case AT_BRACERS:  return "Armband";   break;
    default : return "Unbekannt!";
    }
}

string str2ac(string str)
{
  switch(str)
    {
    case "panzer":    return AT_ARMOUR;   break;
    case "helm":      return AT_HELMET;   break;
    case "ring":      return AT_RING;     break;
    case "handschuh": return AT_GLOVE;    break;
    case "umhang":    return AT_CLOAK;    break;
    case "schuh":     return AT_BOOT;     break;
    case "hose":      return AT_TROUSERS; break;
    case "schild":    return AT_SHIELD;   break;
    case "amulett":   return AT_AMULET;   break;
    case "guertel":   return AT_BELT;     break;
    case "armband":   return AT_BRACERS;  break;
    default : return AT_ARMOUR;
    }
}

int str2gen(string str)
{
  switch(str)
    {
    case "weiblich":
    case "feminin":  return FEMALE; break;
    case "maennlich":
    case "maskulin": return MALE; break;
    default: return NEUTER;
    }
}

string gen2str(int g)
{
  switch(g)
    {
    case FEMALE: return "weiblich";  break;
    case MALE:   return "maennlich"; break;
    default: return "saechlich"; break;
    }
}

void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Ruestung");
  SetProp(P_LONG,
	  "Eine Ruestung.");
  SetProp(P_NAME, "Ruestung");
  SetProp(P_GENDER, FEMALE);
  AddId(({RPG_PROJECT_ID, "requisit","ruestung","SKILL_NOLEARN"}));

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, MAT_MISC_SOLID);
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 100);
  
  SetProp(P_WEAR_FUNC, TO);
  
  AddCmd(({"aender","aendere"}), "cmd_aendern");
}

varargs void aendern_usage(int flag)
{
  write((!flag ? BSST(" Was willst Du denn aendern? Abbrechen mit q.")+
	 BSST(" Beachte bitte die Gross-kleinschreibung.")+
	 BSST("=============================================") : "")+
	BSST(sprintf("(1) %25-s %s","Ruestungstyp: ",ac2str(QueryProp(P_ARMOUR_TYPE))))+
	BSST(sprintf("(2) %25-s %s","Name: ", QueryProp(P_NAME)))+
	BSST(sprintf("(3) %25-s %s","Geschlecht: ",gen2str(QueryProp(P_GENDER))))+
	BSST("(4) Kurzbeschreibung: ")+
	BS(QueryProp(P_SHORT)+".")+
	BSST("(5) Langbeschreibung: ")+
	BS(QueryProp(P_LONG)));
}

void change_armour(string what, string str)
{
  switch(str)
    {
    case "1":
    case "ruestungstyp": 
      RemoveId(lower_case(ac2str(QueryProp(P_ARMOUR_TYPE))));
      SetProp(P_ARMOUR_TYPE, str2ac(lower_case(what))); 
      AddId(lower_case(ac2str(QueryProp(P_ARMOUR_TYPE))));
      break;
    case "2":
    case "name": RemoveId(lower_case(QueryProp(P_NAME)));
      SetProp(P_NAME, what); AddId(({"ruestung",lower_case(what)})); 
      break;
    case "3":
    case "geschlecht": SetProp(P_GENDER, str2gen(lower_case(what))); 
      break;
    case "4":
    case "kurzbeschreibung": what=regreplace(what, "[.]$", "", 1);
      SetProp(P_SHORT, what); 
      break;
    case "5":
    case "langbeschreibung": SetProp(P_LONG, what); 
      break;
    }
  write(BSST("Fertig."));
  
  write_file(LOG "game_"+game+"_changes", dtime()+": "+TPN+" aendert "+str+
	     " zu "+what+" ("+explode(file_name(), "/")[<1]+").\n");
  
  aendern_usage();
  write("? ");
  input_to("customize");
}

void customize(string str)
{
  string *tmp;
  string what;
  
  if(!str)
    {
      aendern_usage();
      write("? ");
      input_to("customize");
    }

  if(strstr(str, "aendere ")==0)
    str=str[8..];

  if(sizeof(tmp=explode(str, " ")) > 1)
    {
      str=tmp[0];
      what=implode(tmp[1..], " ");
    }
  
  switch(str)
    {
    case "1": 
    case "ruestungstyp": 
      if(strlen(what))
	{
	  change_armour(what, str);
	  return;
	}
      write(BSST("Folgende Ruestungstypen sind erlaubt:")+
	    BSST("Panzer, Helm, Ring, Handschuh, Umhang, Schuh, Hose, Schild, "
		 "Amulett, Guertel und Armband."));
      write("Ruestungstyp:  ");
      input_to("change_armour", 0, str);
      return;
    case "2": 
    case "name": 
      if(strlen(what))
	{
	  change_armour(what, str);
	  return;
	}
      write(BSST("Namen bitte kurz, ohne Artikel und ohne Adjektive.")+
	    BSST("Mit dem Namen wird gleichzeitig die ID gesetzt, mit der "
		 "sich die Ruestung ansprechen laesst.")+
	    BSST("z.B.: Goldring, Umhang etc."));
      write("Name:  ");
      input_to("change_armour", 0, str);
      return;
    case "3": 
    case "geschlecht":
      if(strlen(what))
	{
	  change_armour(what, str);
	  return;
	}
      write(BSST("Folgende Geschlechter sind erlaubt:")+
	    BSST("maennlich, weiblich, saechlich."));
      write("Geschlecht:  ");
      input_to("change_armour", 0, str);
      return;
    case "4": 
    case "kurzbeschreibung": 
      if(strlen(what))
	{
	  change_armour(what, str);
	  return;
	}
      write(BSST("Bitte kurz halten:")+
	    BSST("z.B.: Ein Goldring, Ein magischer Umhang etc."));
      write("Kurzbeschreibung:  ");
      input_to("change_armour", 0, str);
      return;
    case "5": 
    case "langbeschreibung": 
      if(strlen(what))
	{
	  change_armour(what, str);
	  return;
	}
      write(BSST("Nicht zu umstaendlich, es gibt keinen Editor dafuer."));
      write("Langbeschreibung:  ");
      input_to("change_armour", 0, str);
      return;
    case "q":
    case "quit":
    case "fertig":
    case "abbrechen": return;      
    default:  

      aendern_usage();
      write("? ");
      input_to("customize");
    }
}

nosave int cmd_aendern(string str)
{
  notify_fail(BSST("Welches Objekt willst Du aendern?"));
  if(!str) return 0;
  
  if(!id(str)) return 0;
  
  if(!allowed_manager(TP)) 
    return write(BSST("Du darfst diese Ruestung nicht veraendern!")), 1;
  
  aendern_usage();
  
  write("? ");
  
  input_to("customize");
  return 1;
}

int WearFunc(object ruestung) 
{
  if(!allowed_env())
    {
      remove();
      return 0;
    }
  
  return 1;
}

void init()
{
  ::init();
  
  if(!allowed_env())
    remove();
}

void reset()
{
  ::reset();
  
  if(!allowed_env())
    remove();
}

void SetUp(string g)
{
  game=g;
}

string QueryGameName()
{
  return game;
}
