#include "../def.h"
#include <v_compiler.h>

inherit "std/virtual/v_compiler";

#define P_VALID_NAME "valid_name"

void create()
{
  ::create();

  SetProp(P_COMPILER_PATH, ROOM);
  SetProp(P_STD_OBJECT, ROOM "rpgroom");
  SetProp(P_VALID_NAME, ({"rpgroom"}));
}

string Validate(string file)
{
  string path, name, game;
  int nr;

  file = ::Validate(file);
  
  if((sscanf(file, "%s_%s_%d", name, game, nr) == 3) &&
      (member(QueryProp(P_VALID_NAME), name) != -1) &&
      (game==lower_case(game)))
    {
      SetProp(P_STD_OBJECT, ROOM+name); // Wozu?
      
      //if(RPGMASTER->GameRoomExists(game, nr))
	return file;
    }
}

int CustomizeObject()
{
  string name,foo,bar;
  int nr;

  if(!(name = ::CustomizeObject()) || sscanf(name,"%s_%s_%d",foo,bar,nr)!=3)
    return 0;
  
  return 1;
}



