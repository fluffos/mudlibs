#include "../def.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Amulett der Historie");
  SetProp(P_LONG,
    "Du haeltst ein Amulett aus gruenem Marmor in der Hand. Es ist mit dir "
    "unbekannten, goldenen Schriftzeichen versehen. An der Vorderseite ist "
    "eine goldene Schriftrolle eingraviert.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Amulett der Historie");
  SetProp(P_GENDER, MALE);
  AddId( ({"amulett", "amulett der historie", "\ngwenshara_musen_ring"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_MARBLE:80, MAT_GOLD: 10, MAT_MAGIC: 10]) );
  SetProp(P_VALUE, 2000);
  SetProp(P_NOBUY, 1);
  SetProp(P_MAGIC, 3);
  SetProp(P_ITEMD_NO_MAGIC, 1);
  
//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_AMULET );
  SetProp(P_AC, 2);
  SetProp(P_QUALITY_DECAY, 90);

  SetProp(P_INFO, BS("Wer dieses Amulet traegt, erhaelt ungeahnte Einsicht.") );

  SetProp(P_M_ATTR_MOD, ([A_INT:1]));
}
