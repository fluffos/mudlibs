#include "../def.h"

inherit "std/armour";

int heal;

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Schleier der Leidenschaft");
  SetProp(P_LONG,
    "Dieser Seidenschleier ist aus einer duennen Lage Stoff gefertigt. Er "
    "ist von feuerroter Farbe und glitzert bei jeder Bewegung seltsam. "
    "Wenn du ihn durch deine Haende gleiten laesst fuehlt er sich sanft und "
    "anschmiegsam, aber dennoch warm - fast schon heiss - an.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schleier der Leidenschaft");
  SetProp(P_GENDER, MALE);
  AddId( ({"schleier", "schleier der leidenschaft", "\ngwenshara_musen_schleier"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_SILK:90, MAT_FIRE: 10]) );
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  SetProp(P_MAGIC, 3);
  SetProp(P_ITEMD_NO_MAGIC, 1);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT: 7, T_HEAT_PROT: -3]));
  SetProp(P_DAM_PROTECTION, ({DT_FIRE}));
  SetProp(P_WEAR_TEXT, ({"Du wickelst den Schleier um dich.\n",
                         " wickelt einen roten Schleier um sich.\n"}));
  SetProp(P_WORN_TEXT, "umgewickelt");
  
//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 2);
  SetProp(P_QUALITY_DECAY, 80);

  SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL: 35]) );

  SetProp(P_INFO, BS("Mit diesem Schleier wird dich das Feuer der Leidenschaft wohlig umfangen.") );

  SetProp(P_DEFEND_FUNC, TO);

  heal = 0;
}

public int DefendFunc(string *dtype, mixed spell, object enemy) {
  object wearer;

  wearer = QueryProp(P_WORN);
  if(!objectp(wearer))  return 0;

  if(member(dtype, DT_FIRE)>-1) {
    if(!random(3)) {
      tell_object(wearer, BS("Die Waerme des Feuers umfaengt dich wohlig."));
      tell_room(ENV(wearer), BS("Die Waerme des Feuers umfaengt "+wearer->name(WEN, 1)+" wohlig."), ({wearer}));
    }

    heal += 1 + random(10);
    if(heal>1000) {
      if(!random(5)) {
        tell_object(wearer, BS("Der Schleier glueht rot auf und kuehlt dann merklich ab."));
        wearer->AddHp(heal-1000);
        heal -= 50 + random(100);
      }
    }
    return 10 + random(10);
  }

  return 0;
}

public void reset() {
  object wearer;
  if(!is_clone(TO)) return;

  wearer = QueryProp(P_WORN);
  if(objectp(wearer)) {
    tell_object(wearer, BS("Die Waerme des Schleiers der Leidenschaft heilt dich."));
    tell_room(ENV(wearer), BS("Die Waerme des Schleiers der Leidenschaft heilt "+wearer->name(WEN, 1)+"."), ({wearer}));
    wearer->AddHp(heal/100);
    heal = 0;
  }
}
