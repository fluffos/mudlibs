inherit "/gilden/bardengilde/instrument/base_string";

#include <properties.h>
#include <combat.h>
#include "/p/std/barden/instrument.h"
#include "../def.h"

public void create() {
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Lyra");
  SetProp(P_LONG, "Diese Lyra istz ein Saiteninstrument, aehnlich einer Leier. "
                  "Zwischen einem Korpus und einer oberen Stange sind sieben "
                  "Saiten aus Gold gespannt. Korpus und Stange werden durch zwei "
                  "geschlungene Buegel zusammen gehalten."); 
  SetProp(P_NAME, "Lyra");
  SetProp(P_GENDER, FEMALE);
  AddId(({"lyra"}));
  SetProp(P_INSTRUMENT_LEVEL, 5);
  SetProp(P_HANDS, 2);
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, ([MAT_WOOD:80, MAT_GOLD: 20]));
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
}














