#include "../def.h"

inherit "std/armour";

string *farben = ({ "rot", "blau", "gruen", "weiss", "gelb", "violett", "orangen"});

void create()
{
  string farbe;
  if( !is_clone(TO) ) return;
  ::create();

  farbe = farben[random(sizeof(farben))];

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine "+farbe+"e Toga");
  SetProp(P_LONG,
    "Diese Toga aus einfachem Leinenstoff ist luftig und leicht. Sie wird "
    "um den Koerper gewickelt und dient als einfache Alltagskleidung.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Toga");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"toga"}) );

  SetProp(P_NAME_ADJ, farbe );
  AddAdjective( ({farbe+"en",farbe+"er",farbe+"em",farbe+"es",farbe+"e"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 500);
  SetProp(P_SIZE, 50);
  SetProp(P_VALUE, 500);
  
//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 10);
  SetProp(P_QUALITY_DECAY, 50);
}
