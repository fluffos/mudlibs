#include "../def.h"
#include "/gilden/bardengilde/barden_extern.h"

inherit "std/armour";

private int seite;
mapping positive_spells = (["der fruehling": 5, 
                            "der sommer": 5, 
                            "der winter": 5, 
                            "der herbst": 5,
                            "ballade vom drachentoeter": 5,
                            "schildsang der walkueren": 5,
                            "zwergisches ahnenlied": 5,
                            "stolze mauer am fluss": 5]);

mapping negative_spells = (["der besuch des raben": 5,
                            "flamme bin ich": 5,
                            "windlied der sylphen": 5,
                            "das lied vom sturmvogel": 5,
                            "des todes drei trommelschlaege": 5]);

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Musenmaske");
  SetProp(P_LONG,
    "Die Maske, die du vor dir hast, ist aus orangenem Marmor geschnitten. "
    "Es handelt sich um eine scheinbar einfache Theatermaske, die auf der einen "
    "Seite ein lachendes, und auf der anderen Seite ein weinendes Gesicht "
    "zeigt. Im Moment ist das @@welches_gesicht@@ Gesicht auf der Vorderseite. Du "
    "kannst sie wenden.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Musenmaske");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"maske", "musenmaske", "\ngwenshara_musen_maske"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_MARBLE:80, MAT_GOLD: 10, MAT_MAGIC: 10]) );
  SetProp(P_VALUE, 1500);
  SetProp(P_NOBUY, 1);
  SetProp(P_MAGIC, 3);
  SetProp(P_ITEMD_NO_MAGIC, 1);
  
//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 7);
  SetProp(P_QUALITY_DECAY, 90);

  SetProp(P_INFO, BS("Je nachdem welches Gesicht die Maske zeigt "
                     "wird sie andere Wirkung aufweisen. Sie kann vor Gutem "
                     "oder Boesem schuetzen und gute oder boese Lieder "
                     "eines Barden unterstuetzen.") );

  seite = 1;
  SetProp(P_BARDEN_BONUS, positive_spells);

  AddCmd("wende|wend&maske|musenmaske", "cmd_wenden", "Was willst du wenden?\n");
}

public string welches_gesicht() {
  return (seite?"lachendes":"weinendes");
}


public int cmd_wenden() {
  seite = !seite;
  tell_object(TP, BS(sprintf("Du wendest die Maske und sie zeigt jetzt ein %s Gesicht.", welches_gesicht())));

  SetProp(P_BARDEN_BONUS, (seite?positive_spells:negative_spells));
  return 1;
}

public string* _query_dam_protection() {
  return (seite?({DT_HOLY}):({DT_UNHOLY}));
}
