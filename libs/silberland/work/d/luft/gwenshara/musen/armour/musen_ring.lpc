#include "../def.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Ring der Inspiration");
  SetProp(P_LONG,
    "Dieser Ring wurde aus blauem Marmor geschnitten. Feine Einlegearbeiten aus "
    "Gold ziehen sich wie ein Band aus Weinblaettern um ihn. An der Innenseite "
    "findet sich die Inschrift: 'Von den Musen gekuesst'.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Ring der Inspiration");
  SetProp(P_GENDER, MALE);
  AddId( ({"ring", "ring der inspiration", "\ngwenshara_musen_ring"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_MARBLE:80, MAT_GOLD: 10, MAT_MAGIC: 10]) );
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  SetProp(P_MAGIC, 3);
  SetProp(P_ITEMD_NO_MAGIC, 1);
  
//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_RING );
  SetProp(P_AC, 2);
  SetProp(P_QUALITY_DECAY, 90);

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT: 25]) );

  SetProp(P_INFO, BS("Wer diesen Ring traegt, wird Inspiration erfahren.") );

  SetProp(P_DEFEND_FUNC, TO);
}

private void grantInspiration(object wearer) {
  tell_object(wearer, BS("Du fuehlst dich von der Muse gekuesst."));
  wearer->AddSp(1);
  if(wearer->QueryProp(P_GUILD) == "bardengilde") {
    call_other("/spellbooks/barden_spells", "accumulateInspiration", wearer, 2);
  }
  return;
}

public int DefendFunc(string *dtype, mixed spell, object enemy) {
  object wearer;

  wearer = QueryProp(P_WORN);
  if(!objectp(wearer))  return 0;

  if(!random(20)) {
    grantInspiration(wearer);
  }

  return 0;
}

public void reset() {
  if(!is_clone(TO)) return;
  ::reset();

  if(objectp(QueryProp(P_WORN))) {
    grantInspiration(QueryProp(P_WORN));
  }
}
