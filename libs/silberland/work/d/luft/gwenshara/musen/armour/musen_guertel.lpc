#include "../def.h"
#include "/gilden/bardengilde/barden_extern.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Musenguertel");
  SetProp(P_LONG,
    "Dieser Guertel wurde aus indigofarbenem Marmor geschnitten. Feine Einlegearbeiten aus "
    "Gold ziehen sich wie ein Band aus Noten um ihn.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Musenguertel");
  SetProp(P_GENDER, MALE);
  AddId( ({"guertel", "musenguertel", "\ngwenshara_musen_guertel"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_MARBLE:80, MAT_GOLD: 10, MAT_MAGIC: 10]) );
  SetProp(P_VALUE, 3000);
  SetProp(P_NOBUY, 1);
  SetProp(P_MAGIC, 3);
  SetProp(P_ITEMD_NO_MAGIC, 1);
  
//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_BELT );
  SetProp(P_AC, 2);
  SetProp(P_QUALITY_DECAY, 90);

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT: 25]) );

  SetProp(P_BARDEN_SPELLCOST, 10);
}
