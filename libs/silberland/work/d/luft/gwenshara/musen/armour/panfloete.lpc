inherit "/gilden/bardengilde/instrument/base_floete";

#include <properties.h>
#include <combat.h>
#include "/p/std/barden/instrument.h"
#include "../def.h"

public void create() {
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Panfloete");
  SetProp(P_LONG, 
	  BS("Die Panflöte besteht aus einer Reihe von Holzroehrchen, mit "
         "denen verschieden hohe Töne erzeugt werden können. Diese Exemplar ist "
         "mit zwei Reihen zu je sechs Roehren ausgestattet und erlaubt "
         "damit ein besonders grosses Klangspektrum.")); 
  SetProp(P_NAME, "Panfloete");
  SetProp(P_GENDER, FEMALE);
  AddId(({"panfloete", "floete", "hirtenfloete"}));
  SetProp(P_INSTRUMENT_LEVEL, 5);
  SetProp(P_HANDS, 2);
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, ([MAT_WOOD:100]));
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
}














