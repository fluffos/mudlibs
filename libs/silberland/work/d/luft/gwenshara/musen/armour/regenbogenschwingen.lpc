#include "../def.h"
#include "/gilden/paladine/paladin_extern.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Paar Regenbogenschwingen");
  SetProp(P_LONG,
    "Bei den Regenbogenschwingen handelt es sich um ein paar durchscheinende "
    "Drachenfluegel. Sie bestehen aus durchscheinenden, glaesern scheinenden "
    "Membranen, die im Licht regenbogenfarben schimmern. Die Fluegel sind zwischen "
    "die golden-ledernen Knochen eines Drachen eingespannt. Mit etwas Geschick "
    "kannst du sie dir an den Ruecken schnallen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Regenbogenschwingen");
  SetProp(P_PLURAL, 1);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"schwingen", "regenbogenschwingen", "drachenschwingen", "fluegel"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_GLASS: 20, MAT_HORN:20, MAT_LEATHER:10, 
                        MAT_MAGIC:10, MAT_LIGHT: 30, MAT_HORN: 10]) );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 20000);
  SetProp(P_NOBUY, 1);
  
//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 8);
  SetProp(P_QUALITY_DECAY, 100);

  SetProp(P_DEFEND_FUNC, TO );

  AddProp(P_DAM_PROTECTION, ([DT_LIGHT:1, DT_HOLY:1, DT_MAGIC:1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_DEX:27, P_LEVEL:55]) );

  SetProp(P_INFO, "Diese Schwingen stammen vom goldenen Drachen Yriskandur.\n"
                  "Sie kanalisieren das Licht der Umgebung zu deinem Schutz.\n" );
  SetProp(P_PALADIN_SPELLCOST, 10);

  SetProp(P_ITEMD_NO_MAGIC, 1);
  SetProp(P_MAGIC, 5);
}

int DefendFunc (string *dam_type, int spell, object enemy)
{
  object env;
  env = ENV(QueryProp(P_WORN));
  if(!objectp(env)) {
    return 0;
  }

  if(!random(20) && env->QueryProp(P_TOTAL_LIGHT) > 0) {
    tell_object(QueryProp(P_WORN), BS("Die Regenbogenschwingen schimmern auf."));
    return (1+random(2)) * env->QueryProp(P_TOTAL_LIGHT);
  }

  return 0;
}

public void reset() {
  if(!is_clone(TO)) return;

  ::reset();
  if(!living(ENV(TO))) {
    tell_room(ENV(TO), BS("Die Regenbogenschwingen schwinden in einem Lichtblitz."));
    remove(1);
    return;
  }

  call_out("absorb_light", 5 + random(200));
}

public void absorb_light() {
  object env, worn;
  int light;

  if(!objectp(worn=QueryProp(P_WORN))) return;

  env = ENV(worn);
  if(!objectp(env)) return;
  
  light = env->QueryProp(P_TOTAL_LIGHT);
  if(light > 0) {
    tell_object(worn, BS("Die Regenbogenschwingen absorbieren das Licht in deiner Umgebung und strahlen hell."));
    worn->AddHp(5 * light);
    worn->AddSp(5 * light);
  } else {
    tell_object(worn, BS("Die Dunkelheit um dich nagt an den Regenbogenschwingen."));
    TakeFlaw((1 + light)*10);
  }

  SetProp(P_M_HEALTH_MOD, ([P_HP: 1 * light, P_SP: 1 * light]));
  worn->UpdateAttributes();
}
