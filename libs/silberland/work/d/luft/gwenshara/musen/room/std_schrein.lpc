#include "../def.h"

inherit "/std/room";

public void create() {
    ::create();

    AddSpecialDetail( ({ "gegenstand", "harfe", "aulos", "papierrolle", "schwert", "lyra", "maske" }), 
    "detail_item");

    AddDetail( ({"hand", "haende"}), 
        "Es sieht so aus, als waere der Gegenstand in der Hand der Statue nicht fixiert. Man koennte "
        "ihr wohl etwas geben, oder auch von der Statue nehmen.");

    AddDetail( ({"tempel", "ort"}), 
        "Du befindest dich hier im Tempel der Musen. Einem heiligen Ort, der der Inspiration und den "
        "Kuensten gewidmet ist.");

    AddDetail( ({"muse", "musen", "geister", "schutzgeister", "toechter"}), 
        "Die Musen sind die guten Geister der Kuenste und die Toechter Alinjas, der Goettin der Barden. "
        "Sie inspirieren zu wahren Hoechstleistungen. Besonders Barden verehren die Musen.");

    AddDetail( ({"inspiration"}), 
        "Wenn du nach Inspiration suchst, bist du hier genau am richtigen Ort.");

    AddDetail( ({"kuenste", "form", "kunst"}), 
        "Die Musen sind die Schutzgeister aller Form von Kunst.");

    AddDetail( ({"alinja", "goettin"}), 
        "Die Barden verehren besonders die Goettin Alinja, welche ihnen die goettliche "
        "Inspiration zukommen laesst.");

    AddDetail( ({"hoechstleistungen", "lage"}), 
        "Auch du bist zu kreativen Hoechstleistungen in der Lage!");

    AddDetail( ({"barden", "saenger", "zaubersaenger", "zaubersaengern", "gilde", "kristallwald"}), 
        "Die Barden sind eine Gilde von Zaubersaengern, die du im Kristallwald findest.");

    AddCmd(({"nimm", "nehme"}), "cmd_nehmen");
    AddCmd(({"gebe", "gib"}), "cmd_geben");
}

public int cmd_geben(string str) {
    string who, what;
    object ob;

    notify_fail("WEM willst du WAS geben?\n");
    if(str == 0) return 0;
    if(strlen(str) == 0) return 0;
    if(sscanf(str, "%s %s", who, what) != 2) return 0;

    notify_fail("Aber das hast du doch gar nicht bei dir!\n");
    if(!objectp(ob=present(what, TP))) return 0;

    MUSENMASTER->GiveItemTo(QueryProp(P_MUSE), ob);
    return 1;
}

public int cmd_nehmen(string str) {
    string what, from;

    notify_fail("WAS willst do von WEM nehmen?\n");
    if(str == 0) return 0;
    if(strlen(str) == 0) return 0;
    if(sscanf(str, "%s von %s", what, from) != 2) return 0;
    if(from != "statue" && from != "frau" && from != "muse") return 0;
    if(what != lowerstring(MUSENMASTER->NameOf(MUSENMASTER->ItemOf(QueryProp(P_MUSE))))) return 0;

    MUSENMASTER->TakeItemFrom(QueryProp(P_MUSE));
    return 1;
}

public string detail_item() {
    return BS(MUSENMASTER->DescriptionOf(MUSENMASTER->ItemOf(QueryProp(P_MUSE))));
}
