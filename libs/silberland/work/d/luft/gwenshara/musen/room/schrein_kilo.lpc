#include "../def.h"

inherit ROOM "std_schrein";

public void create()  {
  ::create();

  SetProp( P_INT_SHORT, "Im Schrein der Muse Clio" );
  SetProp( P_INT_LONG,
    "Dieser Teil des Tempels der Musen befindet sich unter einem gruenen Glasdach. "
    "Die Waende des kleinen Schreins sind ueber und ueber mit Buecherregalen, Steintafeln "
    "und Wandteppichen behangen. In der Mitte des Raumes wurde die Statue einer "
    "schoenen Frau errichtet und davor ein Kohlebecken aufgestellt. Alles ist in ein sanftes, "
    "gruenes Licht gehuellt." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_MUSE, KILO);

  AddDetail( ({"kohlebecken", "becken"}),
    "Ein simples, gusseisernes Kohlebecken wurde vor der Statue aufgestellt. Die Kohlen darin "
    "glimmen sanft, waehrend ab und zu eine kleine Feuerzunge empor leckt.");

  AddDetail( ({"kohlen", "kohle"}),
    "Die Kohle in dem Becken glueht roetlich. Sie scheint ziemlich heiss zu sein.");

  AddDetail( ({"feuerzunge", "zunge"}),
    "Gelegentlich leckt eine Feuerzunge empor. Dir faellt auf, dass auch die Flammen "
    "gruen sind.");

  AddDetail( ({"flammen"}),
    "Offenbar hat man ihnen etwas zugesetzt, damit sie gruenlich leuchten, um das Ambiente "
    "des Raumes zu erhalten.");

  AddDetail( ({"ambiente"}),
    "Du wuerdest sagen hier ist es eher ruhig und mysterioes.");

  AddDetail( ({"licht"}),
    "Der ganze Raum ist ein sanftes, gruenes Licht gehuellt, das ihm einen "
    "unwirklichen Glanz verleiht.");

  AddDetail( ({"schrein", "raum", "raumes", "teil"}),
  "Du befindest dich hier eindeutig in einem Schrein, der einer der Musen gewidmet ist.");

  AddDetail( ({"boden"}),
    "Der Boden ist mit einfachen Steinplatten ausgelegt.");

  AddDetail( ({"platten", "steinplatten", "marmor"}),
    "Die Steinplatten hier sind aus feingeaedertem, gruenen Marmor.");

  AddDetail( ({"wand", "waende"}),
    "Die Waende sind voller Regale, Tafeln und Wandteppichen, sodass nicht ein Fitzelchen "
    "Mauerwerk zu sehen ist.");

  AddDetail( ({"regale", "buecherregale", "buecherregalen"}),
    "In den Regalen findest du allerlei Schriften und Buecher. Sie sind darin gestapelt oder "
    "wurden sogar zwischen andere gequetscht.");

  AddDetail( ({"tafel", "tafeln", "steintafeln"}),
    "Offenbar wurden nicht alle Ereignisse in Buechern festgehalten. Die Steintafeln sind "
    "mit verschiedenen Runen versehen und auf allen Seiten beschrieben.");

  AddDetail( ({"teppiche", "wandteppiche", "teppichen", "wandteppichen", "wandteppich", "vergangenheit"}),
    "Die grossen Wandteppiche sind meisterhaft gewebt und zeigen Szenen aus der "
    "Vergangenheit des Silberlands.");

  AddDetail( ({"fitzelchen", "mauer", "mauerwerk"}),
    "Nicht das kleinste Fitzelchen ist zu sehen!");

  AddDetail( ({"schriften", "buecher", "buechern"}),
    "Sie alle handeln von vergangenen Ereignissen und der lebenden Historie.");

  AddDetail( ({"ereignisse", "ereignissen", "historie", "geschichte"}),
    "Das Silberland blickt bereits auf eine lange Geschichte zurueck. Angefangen "
    "von der Schoepfung der Welt, bis hin zum Sieg ueber das BOESE scheint hier "
    "alles aufgezeichnet zu sein.");

  AddDetail( ({"runen"}),
    "Es scheint sich um zwergische Runen zu handeln.");

  AddDetail( ({"seiten"}),
    "Die Steintafeln wurden rundherum beschrieben.");

  AddDetail( ({"szenen"}),
    "Du erkennst Szenen aus dem grossen Orkkrieg, die Kroenung des letzten "
    "Zwergenkoenigs und die Fahrten von Pestur dem Seefahrer.");

  AddDetail( ({"silberland", "welt"}),
    "Hier befindest du dich.");

  AddDetail( ({"schoepfung", "woody", "dusty"}),
    "Diese Welt wurde von Dusty und Woody geschaffen.");

  AddDetail( ({"sieg", "boese", "boesen"}),
    "Das BOESE wurde von den zehn grossen Helden in die Tiefen des Brunnens verbannt.");

  AddDetail( ({"orkkrieg"}),
    "Im grossen Orkkrieg schloss der Haeuptling Tolgraz Blutfaust ein Buendnis mit "
    "den Trollen, Ogern und Gaffos, um ueber die Menschen herzufallen. Mit vereinten "
    "Kraeften, und dank dem Verrat der Gaffos, konnte diese Horde zurueckgeschlagen werden.");

  AddDetail( ({"kroenung", "zwergenkoenig", "zwergenkoenigs", "kampf"}),
    "Der letzte Zwergenkoenig ist im Kampf gegen die Untoten in den Zwergenbingen "
    "unter Felonia verschollen.");

  AddDetail( ({"felonia", "heimstatt", "zwerge"}),
    "Die Zwergenbingen liegen unter Felonia, der Heimstatt der Zwerge.");

  AddDetail( ({"untote", "untoten", "verkoerperung"}),
    "Keine da. Sie sind die Verkoerperung des BOESEN.");
  
  AddDetail( ({"zwergenbingen", "bingen"}),
    "Die Bingen unter Felonia sind seit damals verschuettet.");

  AddDetail( ({"fahrten", "pestur", "seefahrer"}),
    "Auf einem Wandteppich siehst du die vier Fahrten von Pestur dem Seefahrer verwigt. "
    "Die Erste fuehrte ihn ueber das Kap der Strudel bis ins Huegelland. Die Zweite "
    "ueber das Kap der Stuerme in den hohen Norden. Mit der Dritten umrundete er das "
    "Silberland. Von der Vierten kehrte er niemals zurueck, da er wohl ueber den Rand "
    "der Welt gesegelt war.");

  AddDetail( ({"huegelland", "region"}),
    "Das Huegelland ist die westlichste Region des Silberlands");

  AddDetail( ({"kap", "rand", "strudel", "stuerme"}),
    "Das ist nicht wirklich hier. Der Wandteppich zeigt nur die Geschichte von Pestur.");

  AddDetail( ({"helden"}),
    "Die grossen Helden warfen das Boese zurueck in den Brunnen, wo es seither wartet.");

  AddDetail( ({"tiefen", "brunnen", "brunnens", "labyrinth"}),
    "Ein unscheinbarer Brunnen verbirgt ein maechtiges Labyrinth, in dem das BOESE "
    "fuer immer gefangen sein soll.");

  AddDetail( ({"haeuptling", "tolgraz", "blutfaust"}),
    "Vor langer Zeit war Tolgraz Blutfaust der Haeuptling der Orks.");

  AddDetail( ({"zeit", "konstrukt"}),
    "Zeit ist ein abstraktes Konstrukt, dass du nicht sehen kannst.");

  AddDetail( ({"buendnis", "trolle", "trollen", "oger", "gaffos", "menschen", "horde", "orks"}),
    "Das Buendnis zwischen Orks, Ogern und Trollen griff damals Midas an.");

  AddDetail( ({"midas", "zuhause"}),
    "Midas ist das Zuhause der Menschen.");

  AddDetail( ({"kraeften", "kraefte"}),
    "Mit vereinten Kraeften gelang es damals die Orks zurueckzuschlagen.");

  AddDetail( ({"verrat"}),
    "Als Tolgraz Blutfaust die Horden anfuehrte haben die Gaffos sie verraten, "
    "um sich gegen ihre Unterdruecker aufzulehnen.");

  AddDetail( ({"unterdruecker"}),
    "Die Orks.");

  AddDetail( ({"dach", "glasdach", "decke", "glasdachs"}),
    "Das Dach dieses Schreins wurde mit kleinen gruenen Scheiben gedeckt. Dadurch entsteht "
    "ein ueberirdischer gruenlicher Glanz der alles umgibt.");

  AddDetail( ({"scheiben"}),
    "Es handelt sich dabei um regelmaessige Quadrate aus einem tiefgruenen Glas.");

  AddDetail( ({"glanz"}),
    "Durch den Einfall des Lichts durch das Glasdach ist alles in ein unwirkliches "
    "Gruen getaucht.");

  AddDetail( ({"quadrate"}),
    "Die Scheiben des Glasdachs sind quadratisch.");

  AddDetail( ({"glas"}),
    "Das Dach besteht aus einer Form von halbdurchsichtigem Glas.");

  AddDetail( ({"einfall"}),
    "So wie das Licht in den Schrein faellt glaenzt es gruenlich.");

  AddDetail( ({"gruen", "wirkung"}),
    "Es hat eine beruhigende Wirkung auf dich.");

  AddDetail( ({ "schritt" }),
    "So weit, wie deine Fuesse beim Gehen eben auseinander sind.");

  AddSpecialDetail( ({"statue", "frau", "mitte"}), "detail_statue");

  AddReadDetail( ({"inschrift", "lettern"}), 
     "CLIO die Ruehmende. Muse der Geschichtsschreibung.");

  AddSound( DEFAULT_SOUND,
    "Hier herrscht weitestgehend Stille.");

  AddSound( "stille", "");

  AddExit( "norden", ROOM "altar");
}

public string detail_statue() {
  string itemName;
  itemName = MUSENMASTER->NameOf(MUSENMASTER->ItemOf(KILO), 2);
  return BS(sprintf("Die Statue ist die einer schoenen, jungen Frau. Sie wurde aus Marmor "
                 "gehauen und traegt eine gruen angemalte Toga. Mit ernstem Gesicht blickt "
                 "sie auf dich herab und scheint weise und erfahren. In der einen Hand haelt sie "
                 "einen Schreibgriffel und in der anderen %s. Auf ihrem Sockel kannst du eine "
                 "Inschrift in goldenen Lettern erkennen.", itemName));
}
