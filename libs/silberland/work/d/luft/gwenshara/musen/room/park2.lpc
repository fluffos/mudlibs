#include "../def.h"

inherit "/std/room";
inherit "/gilden/bardengilde/obj/std_spellprovider";

private int pears;

public string birnen_in_reichweite() {
  string str;
  str = "Die Birnen sehen sehr saftig aus. Obwohl sie scheinbar eine goldene Schale haben! ";
  if(pears > 1) {
    str += "Ein paar Birnen";
  } else if(pears == 1) {
    str += "Eine Birne";
  } else {
   str += "Keine Birne";
  }

  str += " haengen auf etwas tieferen Aesten.";
  return str+"\n";
}

public void create()  {
  ::create();

  SetProp( P_INT_SHORT, "Beim Tempel der Musen" );
  SetProp( P_INT_LONG,
    "Der geschlaengelte Weg endet hier an einem grossen Saeulentempel. Ein paar "
    "Stufen fuehren hoch zum einem Portal durch das du ins Innere gelangst. Auf "
    "dem kleinen Vorplatz, auf dem du dich befindest, waechst ein grosser Baum "
    "in dem goldene Fruechte glaenzen. Eine kleine Bank darunter laedt zum "
    "Verweilen ein." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HILL]) );

  AddDetail( ({"bank"}),
    "Eine kleine, unscheinbare Holzbank unter dem Baum laedt zum Verweilen "
    "ein.");

  AddDetail( ({"verweilen", "rast"}),
    "Eine klein Rast auf der Bank koennte durchaus erholsam sein.");

  AddDetail( ({"gras", "grasflecken"}),
    "Auf einem grossen Grasflecken waechst ein ein riesiger Baum.");

  AddDetail( ({"erde"}),
    "Die Erde des Wegs und des Vorplatz ist festgetreten, so als wuerden hier "
    "viele Leute vorbeikommen.");

  AddDetail( ({"leute"}),
    "Jemand, wie du.");

  AddDetail( ({"jemand"}),
    "Du tastest herum, spuehrst aber keinen unsichtbaren Magier.");

  AddDetail( ({"magier"}),
    "Ein Magier hat das hier geschaffen.");

  AddDetail( ({"marmor"}),
    "Der gesamte Tempel wurde aus Marmor gemacht.");

  AddDetail( ({"inschrift"}),
    "Sie ist in goldenen Lettern ueber dem Portal eingelassen.");

  AddReadDetail( ({"inschrift"}),
    "BIS ZUR INSPIRATION UND NOCH VIEL WEITER");

  AddDetail( ({"lettern"}),
    "Sie wurden eingemeisselt und danach vergoldet.");

  AddDetail( ({"schlechtwetter"}),
    "Was genau das ist weisst du gar nicht. Sowas wie Wetter existiert "
    "hier doch gar nicht?");

  AddDetail( ({"wetter"}),
    "Das Wetter hier ist immer gleich.");

  AddDetail( ({"vordach"}),
    "Das Vordach wird von ein paar Saeulen getragen und ist mit einfachen roten "
    "Ziegeln gedeckt.");

  AddDetail( ({"saeulen"}),
    "Marmorene Saeulen ohne grosse Verzierungen tragen das Dach.");

  AddDetail( ({"ziegel", "ziegeln"}),
    "Das Vordach ist mit gewoehnlichen, roten Ziegeln gedeckt.");

  AddDetail( ({"baum"}),
    "Hier waechst ein riesiger Baum mit einem gruenen Blaetterdach. Vereinzelt "
    "erkennst du golden glaenzende Fruechte drain.");

  AddDetail( ({"blaetterdach"}),
    "Der Baum sieht mit seinem vollen, tiefgruenen Blaetterdach sehr gesund aus.");

  AddDetail( ({"fruechte"}),
    "Einzelne, goldene Fruechte glitzern im Baum. Bei genauerer Betrachtung siehst "
    "du, dass es sich offenbar um Birnen handelt.");
  
  AddSpecialDetail( ({"birnen"}), "birnen_in_reichweite");

  AddDetail( ({"aeste", "aesten"}),
    "Brinen auf tieferen Aesten waeren fuer dich gerade noch erreichbar.");

  AddDetail( ({"stufen", "treppen"}),
    "Genau sieben Treppen aus Marmor fuehren zu dem Portal, durch das du den "
    "Tempel betreten kannst.");

  AddDetail( ({"portal", "eingang"}),
    "Ein grosses, offenes Portal fuehrt von hier aus suedlich in das Innere "
    "des Tempels. Es ist durch ein Vordach vor Schlechtwetter geschuetzt und "
    "eine Inschrift in goldenen Lettern steht darueber.");

  AddDetail( ({"innere"}),
    "Das Innere des Tempels kannst du von hier heraussen nicht so gut erkennen. "
    "Vielleicht moechtest du reingehen?");

  AddDetail( ({"tempel", "saeulentempel"}),
    "Vor dir erhebt sich ein grosser Saeulentempel. Er ist annaehernd rund und "
    "mit einem buten Glasdach gedeckt. Es scheint eine Haupthalle zu geben und "
    "sieben kleine Raeume.");

  AddDetail( ({"glasdach", "dach"}),
    "Von heraussen kannst du das nicht so gut erkennen. Es sieht so aus, als "
    "waere es sehr bunt.");

  AddDetail( ({"halle", "haupthalle"}),
    "Die Haupthalle des Tempels kannst du durch das Portal betreten.");

  AddDetail( ({"raeume", "hallen"}),
    "Der Tempel scheint ueber sieben kleinere Hallen zu verfuegen. Du kannst sie "
    "nur durch die Haupthalle betreten.");

  AddDetail( ({ "weg", "wegs" }),
    "Der Weg, der vom Tor hier her fuehrt endet hier am Vorplatz vor einem "
    "grossen Saeulentempel.");
  
  AddDetail( ({ "vorplatz", "boden", "platz" }),
    "Der Platz vor dem Eingang zum Tempel besteht aus festgetretener Erde, "
    "und einem Grasflecken auf dem ein grosser Baum waechst.");

  AddDetail( ({ "tor" }),
    "Das Tor kannst du noerdlich von dir am Fuss des Huegels erkennen.");
  
  AddDetail( ({ "fuss" }),
    "Unten am Huegel befindet sich das Tor und das Ende des Wegs.");

  AddDetail( ({"ende"}),
    "Der Weg endet - oder beginnt - bei einem Tor.");

  AddDetail( ({ "huegel", "huegels" }),
    "Du befindest dich hier auf einem Huegel hoch ueber den Wolken. Um dich herum "
    "ueberblickst du Liliandor und die umliegende Wolkendecke.");

  AddDetail( ({ "wolken", "wolkendecke", "decke" }),
    "Rund um den Huegel erstreckt sich eine Decke aus Wolken. Es sieht ganz "
    "so aus, als wuerde dieser Huegel ueberhaupt einfach aus einer grossen "
    "Wolke erheben.");

  AddDetail( ({ "wolke" }),
    "Der Huegel mit dem Tempel erhebt sich direkt aus einer grossen Wolke. "
    "Du kannst nicht erkennen, ob er noch auf festem Grund steht, oder, ob du "
    "am Rand herabfallen wuerdest.");

  AddDetail( ({"grund"}),
    "Du fragst dich, ob der Huegel einfach so aus den Wolken wachst, oder ob "
    "er unter der Wolkendecke auf festem Grund steht.");

  AddDetail( ({"rand"}),
    "Wenn du zu weit gehst, wuerdest du wohl vom Huegel durch die Wolken herunter "
    "fallen. Wer weiss, wo du dann landest?");

  AddDetail( ({ "liliandor", "stadt", "wolkenstadt" }),
    "Die Stadt in den Wolken, in der sich der Tempel befindet, nennt man Liliandor. "
    "Von hier aus erkennst du gut den Stadtpark mit dem grossen Turm, sowie "
    "den Glaspalast.");

  AddDetail( ({ "stadtpark", "park" }),
    "Der gruene Park erstreckt sich praktisch genau vor dem Tor, das dich hier her "
    "gefuehrt hat. Mitten in ihm erhebt sich ein schimmernder Turm.");

  AddDetail( ({ "turm" }),
    "Der Turm erhebt sich gruen-weisslich schimmernd mitten im Stadtpark. Von hier "
    "erkennst du nur sein Glitzern. Wenn du ihn untersuchen willst, musst du wohl "
    "dort hin gehen.");

  AddDetail( ({ "palast", "glaspalast" }),
    "Der Glaspalast von Liliandor glaenzt hinter derm Park im Norden.");

  AddDetail( ({ "glitzern" }),
    "Der Turm glitzert im Sonnenlicht gruen-weisslich.");

  AddDetail( ({ "sonnenlicht" }),
    "Das Sonnenlicht faellt hier frei auf dich herab, da ueber dir keine Wolken sind, sondern "
    "nur der blaue Himmel.");

    AddDetail( ({ "himmel" }),
    "Der Himmel ueber dir ist absolut wolkenfrei.");

  AddExit( "sueden", ROOM "altar" );
  AddExit( "norden", ROOM "park1" );
  AddExit( "westen", ROOM "regenbogen_start" );
  AddItem(NPC "philosoph", REFRESH_DESTRUCT);

  AddCmd("pfluecke|pflueck&frucht|birne", "cmd_pfluecken", "Was willst du pfluecken?");
  AddCmd("raste|rast|verweile|verweil&auf&bank|holzbank", "cmd_rasten", "Wo willst du verweilen?");

  pears = 1 + random(4);
}

public int cmd_rasten() {
  if(present("\ngwenshara_philosoph")) {
    write(BS("Der Philosoph blockiert mit seinem Sinnieren die Bank..."));
    return -1;
  }

  write(BS("Du setzt dich auf die Bank und sinnierst ueber das Leben. "
           "Das kommt dir sehr unproduktiv vor, und du erhebst dich wieder."));
  say(BS(TPN+" setzt sich kurz auf die Bank."));
  return 1;
}

public int cmd_pfluecken(string str) {
  object ob;
  if(pears<=0) {
    write(BS("Leider findest du keine reife Birne mehr."));
    return -1;
  }

  write(BS("Du streckst dich wenig und pflueckst eine der goldenen Birnen."));
  say(BS(TPN+" pflueckt eine Frucht vom Baum."));

  ob = clone_object(OBJ "birne");
  if(ob->move(TP, M_GET) != 1) {
    write("Du kannst die Birne nicht mehr tragen und laesst sie fallen.");
    say(BS(TPN+" laesst die Birne fallen."));
    ob->move(TO, M_PUT);
  }

  pears--;

  return 1;
}

public void reset() {
  ::reset();
  pears = 1 + random(4);
}
