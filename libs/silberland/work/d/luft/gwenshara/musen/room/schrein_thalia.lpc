#include "../def.h"

inherit ROOM "std_schrein";

public void create()  {
  ::create();

  SetProp( P_INT_SHORT, "Im Schrein der Muse Thalia" );
  SetProp( P_INT_LONG,
    "Hier schlaegt dir direkt der Duft von aberhunderten Blumen entgegen, "
    "die sich in unzaehligen Vasen ueberall im Raum verteilt finden. Durch ein "
    "grosses Glasmosaik an der hinteren Wand bricht sich gelbes Licht. Es "
    "gibt dir ein Gefuehl, wie der Sonnenaufgang, der auf all die Blumen scheint."
    "Mitten unter den Blumen wurde die Statue einer jungen Frau errichtet, zu "
    "deren Fuessen sich die meisten der Blumen befinden." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_MUSE, THALIA);

  AddDetail( ({"wand", "waende"}),
    "Auch an den Waenden sind etliche Vasen zu finden.");

  AddDetail( ({"fuesse", "fuessen"}),
    "Zu den steinernen Fuessen der Statue findest du eine grosse Ansammlung an "
    "hauptsaechlich gelben Blumen");

  AddDetail( ({"ansammlung"}),
    "Bei den Blumen findest du ausschliesslich gelbe und weisse Blueten. Es scheint, "
    "dass diese eine besondere Opfergabe fuer die Muse hier sind.");

  AddDetail( ({"opfergabe"}),
    "Wenn du eine entsprechende Blume dabei haettest, koenntest du sie dazustellen.");

  AddDetail( ({"blueten"}),
    "Jede Blume hat Blueten.");

  AddDetail( ({"mosaik", "glasmosaik"}),
    "Zusaetzlich zum Glasdach hat man hier an hinter der Statue ein grosses Mosaik "
    "aus Glas als Fenster eingesetzt. Es zeigt eine junge Frau, aehnlich zur Statue, "
    "die lachend ueber eine Blumenwiese schreitet.");

  AddDetail( ({"efeu", "efeukranz"}),
    "Das Bildnis der Frau, sowohl im Glasmosaik, als auch die Statue, traegt einen "
    "Efeukranz, als Symbol des Fruehlings, am Kopf.");

  AddDetail( ({"wiese", "blumenwiese"}),
    "Die Blumenwiese ist stilisiert dargestellt - und auch komplett gelb.");

  AddDetail( ({"fenster", "fensters"}),
    "Anstatt des Fensters hat man hier ein grosses Glasmosaik eingepasst.");

  AddDetail( ({"symbol", "fruehling"}),
    "Der Efeukranz symbolisiert hier den Fruehling.");

  AddDetail( ({"duft"}),
    "Irgendwie siehst du den gar nicht.");

  AddDetail( ({"blumen", "blume"}),
    "Hunderte von Fruehlingsblumen finden sich hier in kleinen und grossen "
    "Vasen verteilt. Sie verstroemen einen angenehmen Duft.");
  
  AddDetail( ({"vasen"}),
    "Du findest Vasen verschiedenster Form und Groesse. Jede von ihnen "
    "beherbergt eine Blume.");

  AddDetail( ({"fruehlingsblumen"}),
    "Du entdeckst allerlei Fruehlingsblumen. So viele, dass du sie gar nicht "
    "alle bennen kannst.");

  AddDetail( ({"form", "groesse", "formen"}),
    "Einige Vasen sind lang und gros, andere klein und dickbaeuchig. Einige von "
    "ihnen weisen verspielte und verdrehte Formen auf. Auch hier waren meisterliche "
    "Kuenstler taetig.");

  AddDetail( ({"kuenstler"}),
    "Es muss sich bei um wahre Meister ihres Handwerks handeln.");

  AddDetail( ({"meister", "besten"}),
    "Die Besten der Besten eben.");

  AddDetail( ({"handwerk", "handwerks", "handwerke", "einsatz"}),
    "Viele verschiedene Handwerke kamen hier zum Einsatz.");

  AddDetail( ({"decke", "dach", "glasdach"}),
    "Das Dach dieses Schreins wurde mit kleinen gelbe Scheiben gedeckt. Das Licht "
    "faellt durch sie in den Raum.");

  AddDetail( ({"licht"}),
    "Alles Licht in diesem Raum ist von gelblicher Farbe.");

  AddDetail( ({"farbe", "gelb"}),
    "Ein zartes Gelb, wie bei einem Sonnenaufgang");

  AddDetail( ({"aufgang", "sonnenaufgang"}),
    "Das Licht in diesem Raum gibt dir das Gefuehl, als wuerde gerade ein neuer Tag beginnen.");

  AddDetail( ({"gefuehl"}),
    "Richtig erholsam!");

  AddDetail( ({"tag"}),
    "Du denkst . o O ( Heute ist ein guter Tag! )");

  AddSpecialDetail("heute", "detail_heute");

  AddDetail( ({"scheiben"}),
    "Es handelt sich dabei um regelmaessige Quadrate aus einem gelbem Glas.");

  AddDetail( ({"glas"}),
    "Das Dach besteht aus einer Form von halbdurchsichtigem Glas.");

  AddDetail( ({"quadrate"}),
    "Die Scheiben des Glasdachs sind quadratisch.");

  AddDetail( ({"boden"}),
    "Der Boden ist mit marmorenen Steinfliesen ausgelegt.");

  AddDetail( ({"fliesen", "steinfliesen", "marmor", "stein"}),
    "Aller Stein hier sind aus feingeaedertem, gelbem Marmor.");

  AddDetail( ({"schrein", "raum"}),
    "Du befindest dich hier in einem Schrein im Tempel der Musen.");

  AddSpecialDetail( ({"statue", "frau"}), "detail_statue");

  AddReadDetail( ({"inschrift", "lettern"}), 
      "THALIA die Festliche, die Bluehende. Muse der Komoedie und des Fruehlings."); 

  AddSmell(DEFAULT_SMELL, "Es richt herrlich nach Blumen.");
  AddSmell( "duft", "Wie eine Blumenwiese im Fruehling.");

  AddDetail( ({"haar", "kopf"}),
    "Auf dem Haar der Statue ruht ein ebenso steinerner Efeukranz.");

  AddDetail( ({"toga"}),
    "Die Toga der Statue wurde gelb angemalt.");

  AddDetail( ({"mund"}),
    "Die Statue laechelt dich froehlich an. Du kannst ihre Praesenz fast spuehren.");

  AddDetail( ({"praesenz"}),
    "Regelrecht inspirierend.");

  AddDetail( ({"huefte"}),
    "Die Statue hat eine Hand neckisch in die Huefte gestemmt und die andere zu dir hin "
    "gestreckt.");

  AddDetail( ({"bildnis"}),
    "Die selbe Frau wurde hier am Glasmosaik, als auch mit einer Statue verewigt.");

  AddExit( "osten", ROOM "altar");
}

public string detail_heute() {
  return sprintf("Es ist %s.\n", dtime());
}

public string detail_statue() {
  string itemName;
  itemName = MUSENMASTER->NameOf(MUSENMASTER->ItemOf(THALIA), 2);
  return BS(sprintf("Die Statue ist die einer freundlich aussehenden. jungen Frau. "
                 "Sie wurde aus Marmor gehauen und traegt eine gelb bemalte Toga. "
                 "Auf ihrem Haar ruht ein steinerner Efeukranz und ihr Mund laechelt dich "
                 "mit vollen Lippen froehlich an. Eine Hand hat sie neckisch in die Huefte "
                 "gestemmt, waehrend die andere %s zu dir hin haelt. "
                 "Auf dem Sockel zu ihren Fuessen kannst du eine Inschrift in goldenen Lettern "
                 "erkennen.", itemName));
}
