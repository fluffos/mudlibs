#include "../def.h"

inherit ROOM "std_schrein";

public void create()  {
  ::create();

  SetProp( P_INT_SHORT, "Im Schrein der Muse Eueterpe" );
  SetProp( P_INT_LONG,
    "Blaues Licht, das durch ein wunderschoenes Glasmosaik in den Schrein "
    "faellt erhellt diesen Teil des Tempels. Du fuehlst einen sanften "
    "Lufthauch, der stetig zu wehen scheint und fuer angenehme Frische sorgt. "
    "An den Waenden erkennst du zahlreiche Bilder, die ausgelassene Szenen "
    "auf Wiesen und Waeldern darstellen. In der Mitte dieses Schreins wurde "
    "die Statue einer huebschen jungen Frau errichtet. Einige Kerzen brennen "
    "darunter." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_MUSE, EUTERPE);

  AddDetail( ({"kerzen"}),
    "Vor der Statue in der Mitte des Schreins wurden einige Kerzen angezuendet. "
    "Manche sind bereits halb runtergebrannt, andere scheinen sehr frisch zu sein. "
    "Du entdeckst sogar eine, die wohl der Lufthauch ausgeblasen hat.");

  AddDetail( ({"flammen"}),
    "Die Flammen der brennenden Kerzen flackern immer wieder im Lufthauch.");

  AddDetail( ({"natur"}),
    "Die Bilder an den Waenden zeigen Szenen in der Natur.");

  AddDetail( ({"mitte"}),
    "In der Mitte des Schreins befindet sich eine Statue.");

  AddDetail( ({"waelder", "waeldern"}),
    "Die Waelder wurden sehr detailliert an die Wand gemalt. Sie zeigen Satyre, "
    "die Nymphen nachstellen.");

  AddDetail( ({"hauch", "lufthauch"}),
    "Hier herinnen fuehlst du einen sanften Lufthauch, der stetig um dich weht. "
    "Du erkennst ihn auch an den immer wieder flackernden Flammen der Kerzen.");

  AddDetail( ({"frische"}),
    "Der stete Lufthauch macht den Raum angenehm risch. Nicht zu kalt und nicht zu warm.");

  AddDetail( ({"waende", "wand"}),
    "Die Waende sind mit zahlreichen Bildern bemalt, ausgelassene Szenen in der Natur darstellen.");

  AddDetail( ({"bilder", "bildern", "bild"}),
    "Die Bilder sind meisterlich gemalt und zeigen Szenen in Wald und Wiesen.");

  AddDetail( ({"szenen", "wald", "wiesen"}),
    "Du siehst Szenen von Satyren, die Nymphen in Waldquellen nachstellen und Sylphen, die in "
    "ihrem Reigen das Heu auf den Wiesen aufwirbeln.");

  AddDetail( ({"satyren", "satyre","satyr"}),
    "Satyre sind bocksbeinige Feenwesen. Fast halb Ziege, halb Mensch wuerdest du sagen.");

  AddDetail( ({"ziege", "mensch"}),
    "Der Unterkoerper eines Satyr ist stark der einer Ziege, der Oberkoerper mehr der eines Menschen.");
  
  AddDetail( ({"unterkoerper"}),
    "Alles unerhalb des Bauchnabels.");

  AddDetail( ({"oberkoerper"}),
    "So ziemlich alles ueber dem Bauchnabel.");

  AddDetail( ({"nabel", "bauchnabel"}),
    "Alle Rassen, ausser Feen haben sowas.");

  AddDetail( ({"feenwesen", "feen", "wesen"}),
    "Dazu gehoeren nicht nur die klassischen Feen, sondern auch Wesen wie Sylphen, Nymphen und Satyre.");

  AddDetail( ({"quellen", "waldquellen"}),
    "Die Waldquellen wurden wunderschoen mit in blau und gruen gemalt. Sehr detailreich und fast photorealistisch.");

  AddDetail( ({"reigen", "tanz"}),
    "Die Sylphen am Bild drehen sich in wildem Tanz und wirbeln damit das Heu durch die Luft.");

  AddDetail( ({"heu"}),
    "Das Heu fliegt nur so durch die Luft im Tanz der Sylphen.");

  AddDetail( ({"luft"}),
    "Die Luft wurde nicht wirklich gemalt. Sie ist eher impliziert.");

  AddDetail( ({"nymphen", "quellen", "fluessen"}),
    "Nymphen sind Feen, die du in der Naehe von Quellen und Fluessen finden kannst.");

  AddDetail( ({"sylphen", "windfeen"}),
    "Sylphen sind Windfeen, die du hier in Liliandor finden kannst.");

  AddDetail( ({"liliandor"}),
    "So nennt man die Stadt hier in den Wolken.");

  AddDetail( ({"stadt"}),
    "Sie heisst Liliandor.");

  AddDetail( ({"wolken"}),
    "Hier kannst du es nicht direkt erkennen, aber eigentlich befindest du dich hoch in den Wolken.");

  AddDetail( ({"toga"}),
    "Die Toga ist in blau gehalten, wie vieles hier im Raum.");

  AddDetail( ({"decke", "dach", "glasdach", "mosaik", "glasmosaik"}),
    "Das Dach dieses Schreins wurde mit kleinen blaeulichen Scheiben gedeckt. Das Licht "
    "faellt durch sie in den Raum. Die Scheiben bilden ein Mosaik, dass eine blonde Frau "
    "mit blauer Toga, aehnlich zur Statue zeigt.");

  AddDetail( ({"scheiben"}),
    "Es handelt sich dabei um regelmaessige Quadrate aus einem blauem Glas.");

  AddDetail( ({"glas"}),
    "Das Dach besteht aus einer Form von halbdurchsichtigem Glas.");

  AddDetail( ({"quadrate"}),
    "Die Scheiben des Glasdachs sind quadratisch.");

  AddDetail( ({"schrein", "raum", "teil"}),
    "Du befindest dich hier in einem Schrein im Tempel der Musen.");

  AddDetail( ({"licht"}),
    "Alles Licht in diesem Raum ist leicht blaeulich.");;

  AddDetail( ({"boden"}),
    "Der Boden ist mit einfachen Steinplatten ausgelegt.");

  AddDetail( ({"platten", "steinplatten", "marmor"}),
    "Die Steinplatten hier sind aus feingeaedertem, blauen Marmor.");

  AddSpecialDetail( ({"statue", "frau"}), "detail_statue");

  AddReadDetail( ({"inschrift", "lettern"}), 
      "EUTERPE die Erfreuende. Muse der Lyrik und des Floetenspiels.");
  

  AddSound( DEFAULT_SOUND,
    "Von irgendwoher hoerst du leises Floetenspiel.");

  AddSound( ({ "spiel", "floetenspiel" }),
    "Du kannst nicht genau sagen woher es kommt. Es erfuellt einfach den Raum.");

  AddExit( "suedwesten", ROOM "altar");

  AddCmd( "zuende|zuend&kerze|kerzen&an", "cmd_anzuenden", "Was moechstest du anzuenden?");
}

public int cmd_anzuenden() {
  if(TP->QueryProp(P_SP) < 5) {
    write("Dazu fehlt dir die magische Kraft.\n");
    return -1;
  }

  write(BS("Mit einem kleinen Feuerball entzuendest du die ausgegangene Kerze."));
  say(BS(TPN+" entzuendet eine Kerze mit einem kleinen Feuerball."));

  call_out("candle_out", 2);
  return 1;
}

public string candle_out() {
  tell_room(TO, BS("Eine Kerze verlischt mit einem kleinen Rauchfaden."));
}

public string detail_statue() {
  string itemName;
  itemName = MUSENMASTER->NameOf(MUSENMASTER->ItemOf(EUTERPE), 2);
  return BS(sprintf("Die Statue ist die einer schoenen, jungen Frau. Sie wurde aus Marmor "
                 "gehauen und traegt eine blau angemalte Toga. Sie blickt dir freudestrahlend "
                 "entgegen. Wenn du sie so anblickst siehst spuerst du ihre Froehlichkeit "
                 "regelrecht selbst. Mit beiden Haenden haelt sie %s an ihren Mund. Auf "
                 "dem Sockel kannst du eine Inschrift in goldenen Lettern erkennen.", itemName));
}