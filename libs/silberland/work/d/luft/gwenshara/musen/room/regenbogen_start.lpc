#include "../def.h"

inherit "/std/room";

public void create() {
  ::create();

  SetProp(P_INT_SHORT, "Am Beginn des Regenbogens");
  SetProp(P_INT_LONG,
    BS("Am Rand des Parks flimmert die Luft, als wuerde das Sonnenlicht selbst "
       "zu nahe an die Welt geraten. Vor dir bildet sich ein schimmernder Bogen "
       "aus Farben, der sich wie eine feste Bruecke ueber das Wolkenmeer spannt. "
       "Nach Osten fuehrt der Weg zurueck in den Park, nach Sueden beginnt die "
       "Regenbogenbruecke."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HILL]));

  AddDetail(({"regenbogen", "bogen", "farben", "licht", "leuchten",
              "orange", "gelb", "gruen", "blau", "indigo", "violett"}),
    BS("Die Farben sind klar und lebendig: Rot, Orange, Gelb, Gruen, Blau, "
       "Indigo und Violett. Der Bogen wirkt fest genug, um ihn zu betreten."));
  AddDetail(({"bruecke", "regenbogenbruecke", "lichtband", "band", "leuchten"}),
    BS("Ein Band aus gebuendeltem Licht formt eine Bruecke. Sie schimmert, als "
       "wuerde sie jeden Schritt freundlich aufnehmen."));
  AddDetail(({"wolken", "wolkenmeer"}),
    BS("Unter dir liegt ein weites Wolkenmeer. Von hier aus wirkt es weich, "
       "doch du wuerdest dich ungern darauf verlassen."));
  AddDetail(({"park", "baeume", "baeumen", "weg", "wege", "durchgang", "ort", "rand"}),
    BS("Der Park liegt oestlich von hier. Zwischen Baeumen und Wegen wirkt "
       "dieser Ort wie ein ueberirdischer Durchgang."));
  AddDetail(({"boden", "parkgrund", "fuesse", "fuessen", "beginn", "uebergang"}),
    BS("Der Boden unter deinen Fuessen ist noch ganz normaler Parkgrund, doch "
       "direkt vor dir beginnt das schimmernde Lichtband der Regenbogenbruecke."));
  AddDetail(({"luft", "uebergang"}),
    BS("Die Luft flimmert hier am Uebergang, als wuerde sie das Leuchten des "
       "Regenbogens nicht ganz fassen koennen."));
  AddDetail(({"himmel"}),
    BS("Ueber dir spannt sich der Himmel weit auf. Das Licht wirkt hier klarer "
       "und naehrer, als es an einem gewoehnlichen Ort sein sollte."));
  AddDetail(({"sonnenlicht"}),
    BS("Das Sonnenlicht scheint sich in den Farben zu brechen und laesst den "
       "Beginn der Bruecke lebendig schimmern."));
  AddDetail(({"schritt", "schritte"}),
    BS("Ein Schritt nach Sueden fuehrt dich vom vertrauten Boden auf das "
       "Lichtband der Bruecke."));
  AddDetail(({"welt"}),
    BS("Die Welt bleibt hinter dir, sobald du den ersten Schritt auf die "
       "Regenbogenbruecke setzt."));

  AddExit("osten", ROOM "park2");
  AddExit("suedoben", "/d/luft/gwenshara/regenbogen/room/rb1");
}
