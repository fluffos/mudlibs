#include "../def.h"

inherit ROOM "std_schrein";

public void create()  {
  ::create();

  SetProp( P_INT_SHORT, "Im Schrein der Muse Polyhymnia" );
  SetProp( P_INT_LONG,
    "In diesem Schrein weht ein steter, kuehler Luftzug und es klingt so, "
    "als wuerde ein sphaerischer Gesang in erfuellen. Bei jedem Schritt merkst "
    "du die wunderbare Akkustik dieses Raumes. Indigofarbenes Licht faellt durch "
    "das Glasdach an der Decke und erfuellt den Raum mit ueberirdischem Licht. "
    "Bis auf die Statue einer Frau, die mitten im Schrein platziert wurde, ist der "
    "Raum komplett leer." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_MUSE, POLYHYMNIA);

  AddDetail( ({"akkustik"}),
    "Die Akkustik in diesem Raum ist wunderbar. Wenn man hier singt, so wird es "
    "wohl im ganzen Tempel zu hoeren sein.");

  AddDetail( ({"schritt"}),
    "Jeder deiner Schritte hallt hier und wird hundertfach verstaerkt.");

  AddDetail( ({"wand", "waende"}),
    "Die Waende sind hier ebenfalls mit Steinfliesen ausgekleidet, die mit "
    "duennen Fugen verbunden sind.");

  AddDetail( ({"fugen"}),
    "Die Fugen verbinden die Fliesen an den Waenden. Dir faellt jedoch auf, "
    "dass an einigen Stellen wohl nicht sauber verfugt wurde.");

  AddDetail( ({"stellen"}),
    "Zwischen einigen Fliesen gibt es kleine Ritzen, da sie nicht genau abschliessen.");

  AddDetail( ({"ritzen"}),
    "Als du die Ritzen abtastest spuehrst einen Windhauch, der aus ihnen hervor kommt.");

  AddDetail( ({"windhauch", "hauch"}),
    "Es scheint so, als wuerde der stete Lufthauch durch diese Ritzen kommen. Ausserdem "
    "fuehlst du ein leises Summen durch die Fliesen.");

  AddDetail( ({"summen"}),
    "Sehen kannst du es nicht.");

  AddDetail( ({"luftzug", "zug", "lufthauch"}),
    "Hier herinnen weht ein steter Luftzug, der den Raum etwas kuehl macht. Auf den "
    "ersten Blick kannst du nicht erkennen, woher er kommt.");

  AddDetail( ({"blick"}),
    "Um das herauszufinden, musst du dich wohl genauer umsehen.");

  AddDetail( ({"gesang"}),
    "Sehen kannst du den nicht.");

  AddDetail( ({"decke", "dach", "glasdach"}),
    "Das Dach dieses Schreins wurde mit kleinen indigofarbenen Scheiben gedeckt. Das Licht "
    "faellt durch sie in den Raum.");

  AddDetail( ({"scheiben"}),
    "Es handelt sich dabei um regelmaessige Quadrate aus einem gelbem Glas.");

  AddDetail( ({"glas"}),
    "Das Dach besteht aus einer Form von halbdurchsichtigem Glas.");

  AddDetail( ({"quadrate"}),
    "Die Scheiben des Glasdachs sind quadratisch.");

  AddDetail( ({"licht"}),
    "Alles Licht in diesem Raum ist indigofarben. Es gibt dem Raum "
    "einen uberirdischen Flair.");

  AddDetail( ({"farbe", "indigo"}),
    "Ein sattes Indigo.");

  AddDetail( ({"flair"}),
    "Durch das indigofarbene Licht hier fuehlt sich alles etwas ueberirdisch an.");

  AddDetail( ({"boden"}),
    "Der Boden ist mit marmorenen Steinfliesen ausgelegt.");

  AddDetail( ({"fliesen", "steinfliesen", "marmor", "stein"}),
    "Aller Stein hier sind aus feingeaedertem, indigofarbenem Marmor.");

  AddDetail( ({"schrein", "raum"}),
    "Du befindest dich hier in einem Schrein im Tempel der Musen.");

  AddSpecialDetail( ({"statue", "frau"}), "detail_statue");

  AddReadDetail( ({"inschrift", "lettern"}), 
      "POLYHYMNIA die Hymnenreiche. Muse des Gesangs.");

  AddSound( DEFAULT_SOUND,
    "Ein sphaerischer Gesang erfuellt den Raum.");

  AddSound( ({ "gesang",}),
    "Der Gesang erfuellt den Raum hypnotisierend. Er scheint mit dem Luftzug, "
    "der hier herrscht, einherzugehen.");

  AddSound( ({"summen"}),
    "Du legst dein Ohr an die Wand und hoerst, dass dieses Summen wohl den sphaerischen "
    "Gesang im Raum erzeugt. Vermutlich ist hinter der Wand ein Mechanismus verborgen, "
    "der die Geraeusche erzeugt.");

  AddDetail( ({"ohr"}), "Davon hast du zwei.");
  AddDetail( ({"luft"}), "Die ist unsichtbar.");

  AddDetail( ({"mechanismus"}),
    "Du kannst ihn nicht sehen, aber du bist dir sicher, dass der Gesang durch einen "
    "verborgenen Mechanismus in der Wand erzeugt wird, durch den die Luft stroemt.");

  AddExit( "suedosten", ROOM "altar");
}

public string detail_statue() {
  string itemName;
  itemName = MUSENMASTER->NameOf(MUSENMASTER->ItemOf(POLYHYMNIA), 2);
  return BS(sprintf("Die Statue ist die einer huebschen, jungen Frau. Sie wurde aus Marmor "
                 "gehauen und traegt eine indigofarbene, angemalte Toga. Ihr Mund ist weit "
                 "geoeffnet, als wuerde sie dem Himmel eine Arie darbieten. Ihr Blick scheint "
                 "vertraeumt und von der Emotion des Liedes gefesselt. Ihre beiden Haende sind "
                 "weit ausgestreckt, wobei auf ihnen %s ruht. "
                 "Auf dem Sockel zu ihren Fuessen kannst du eine Inschrift in goldenen Lettern "
                 "erkennen.", itemName));
}
