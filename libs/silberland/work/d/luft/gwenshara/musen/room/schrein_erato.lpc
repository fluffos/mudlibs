#include "../def.h"

inherit ROOM "std_schrein";

private object *resters = ({ });

public void create()  {
  ::create();

  SetProp( P_INT_SHORT, "Im Schrein der Muse Erato" );
  SetProp( P_INT_LONG,
    "Als du den Schrein betrittst umfaengt dich gleich ein betaeubender, "
    "wohliger Geruch nach Rosen und Harz. Alles um dich ist in eine Mischung "
    "aus Rottoenen getaucht. Mitten im Raum, auf einem kleinen Sockel, steht "
    "die Statue einer verfuehrerischen Frau. Die Waende sind mit roten Tuechern abgehaengt "
    "und ueberall wurden Kissen verteilt, auf denen man sich gemuetlich "
    "niederlassen kann." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_MUSE, ERATO);

  AddDetail( ({"kissen"}),
    "Verschiedene Kissen wurden ueberall am Boden trappiert. Man kann sich gut auf ihnen "
    "ausrasten oder kuscheln.");

  AddDetail( ({"schrein", "raum", "teil"}),
    "Du befindest dich hier in einem Schrein im Tempel der Musen.");

  AddDetail( ({"sockel"}),
    "Die Statue steht auf einem marmorenen Sockel, in den eine Inschrift aus goldenen "
    "Lettern eingelegt wurde.");

  AddDetail( ({"inschrift"}),
    "Sie sieht seher edel aus mit den goldenen Buchstaben.");

  AddDetail( ({"buchstaben", "lettern"}),
    "Sie wurden zuerst eingraviert oder gemeisselt und dann mit Blattgold vergoldet.");

  AddDetail( ({"gold", "blattgold", "schicht", "goldschicht"}),
    "Eine dünne Goldschicht ueberzieht die Lettern. Vielleicht kann man sie abkratzen?");

  AddDetail( ({"tuecher", "tuechern", "waende", "seidentuecher", "seidentuechern"}),
    "Die Waende wurden mit roten Seidentuechern verhaengt.");

  AddDetail( ({"geruch"}),
    "Du siehst hier keinen Geruch.");

  AddDetail( ({"rosen", "harz"}),
    "Du siehst hier weder das eine, noch das andere. Dennoch kannst du es riechen.");

  AddDetail( ({"mischung"}),
    "Der ganze Raum ist in eine Mischung aus verschiedenen Rottoenen getaucht.");

  AddDetail( ({"rottoene", "rot", "toene"}),
    "Von Rosa, uber rosenrot bis hin zu weinrot ist alles vertreten.");

  AddDetail( ({"rosa"}),
    "Einige der Kissen sind in einem zarten Rosa gehalten.");

  AddDetail( ({"rosenrot"}),
    "Die Tuecher an den wenden sind eher rosenrot.");

  AddDetail( ({"weinrot"}),
    "Einige der Glasscheiben an der Decke sind in weinrot gehalten.");

  AddDetail( ({"decke", "dach", "glasdach", "mosaik", "glasmosaik"}),
    "Das Dach dieses Schreins wurde mit kleinen roetlichen Scheiben gedeckt.");

  AddDetail( ({"scheiben"}),
    "Es handelt sich dabei um regelmaessige Quadrate aus einem rotem Glas.");

AddDetail( ({"glas"}),
  "Das Dach besteht aus einer Form von halbdurchsichtigem Glas.");

AddDetail( ({"quadrate"}),
  "Die Scheiben des Glasdachs sind quadratisch.");
  
  AddDetail( ({"boden"}),
    "Der Boden ist mit einfachen Steinplatten ausgelegt.");

  AddDetail( ({"platten", "steinplatten", "marmor"}),
    "Die Steinplatten hier sind aus feingeaedertem, rosa Marmor.");

  AddSpecialDetail( ({"statue", "frau"}), "detail_statue");

  AddReadDetail( ({"inschrift", "lettern"}), 
      "ERATO die Liebevolle, Sehnsuchtweckende. Muse der Liebe.");
  

  AddSmell( DEFAULT_SMELL,
    "Der betoerende Geruch von Rosen und Harz steigt dir in die Nase.");

  AddSmell( ({ "geruch", "rosen", "harz" }),
    "Der Geruch benebelt deine Sinne und du fuehlst dich richtig gut und entspannt");

  AddDetail( ({ "nase" }),
    "Die steckt dir mitten im Gesicht.");

  AddDetail( ({ "gesicht" }),
    "Da steckt deine Nase.");

  AddCmd( "raste|rast&auf&kissen|polster", "cmd_rasten", "Wo willst du rasten?");

  AddExit( "nordwesten", ROOM "altar");
}

public int cmd_rasten() {
  if(member(resters, TP) > -1) {
    write(BS("Eigentlich bist du gerade nicht muede."));
    return -1;
  }

  write(BS("Du rastet dich einen Moment auf einem er Kissen aus. Sehr erholsam!"));
  say(BS(TPN+" setzt sich kurz auf eines der Kissen und sieht erholt aus."));
  resters += ({ TP });

  TP->AddHp(10+random(10));
  TP->AddSp(10+random(10));
  return 1;
}

public void reset() {
  ::reset();

  resters = ({ });
}

public string detail_statue() {
  string itemName;
  itemName = MUSENMASTER->NameOf(MUSENMASTER->ItemOf(ERATO), 2);
  return BS(sprintf("Die Statue ist die einer schoenen, verfuehrerischen Frau. Sie wurde aus Marmor "
                 "gehauen und traegt eine rot angemalte Toga. Mit lasizivem Augenaufschlag streckt "
                 "sie die einladend einen Arm entgegen. Ganz so, als wurde sie dich in einer Umarmung "
                 "fangen und mit ihrem sinnlichen Mund kuessen wollen. In der anderen Haend haelt sie "
                 "%s. Auf dem Sockel zu ihren Fuessen kannst du eine Inschrift in goldenen Lettern "
                 "erkennen.", itemName));
}
