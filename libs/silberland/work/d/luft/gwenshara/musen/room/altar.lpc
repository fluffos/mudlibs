public int cmd_beten(string str) {
  if(objectp(praying)) {
    write(sprintf("Aber %s betet doch gerade schon.\n", praying->name(WER, 1)));
    return -1;
  }

  write("Du kniest am Altar nieder und betest.\n");
  say(TPN+" kniet am Altar nieder und betet\n");

  TP->SetProp(P_PARALYZED, ([PARALYZE_TIME: 60,
                             PARALYZE_MSG: "Du betest gerade.\n",
                             PARALYZE_MSG_OTHER: "%s betet intensiv.\n",
                             PARALYZE_END: "Du erhebst dich wieder.\n",
                             PARALYZE_END_OTHER: "%s erhebt sich wieder.\n"
                            ]));
  praying = TP;

  call_out("pray_sequence", 0, 0);
  return 1;
}

public void end_prayer() {
  praying->SetProp(P_PARALYZED, 0);
  praying = 0;
}

private string getExitFor(string muse) {
  string dir;
  mapping exits;
  int i;

  exits = QueryProp(P_EXITS);
  for(i=0; i<sizeof(m_indices(exits)); ++i) {
    dir = m_indices(exits)[i];
    if(exits[dir][37..] == muse) {
      return dir;
    }
  }
  return 0;
}

public void summon_dragon() {
  tell_room(TO, BS("Regenbogenfarbenes Licht durch stroemt den Raum und ein lautes Bruellen ertoent."));
  call_out("summon_dragon2", 4);
  return;
}

public void summon_dragon2() {
  object drache;

  if(!objectp(present("yriskandur"))) {
    drache = clone_object(NPC "yriskandur");
    drache->move(TO, M_SILENT|M_TPORT|M_NOCHECK);
    tell_room(TO, BS("Aus regenbogenfarbenem Licht formt sich ein ziegenkoepfiger Drache."));
  } else {
    present("yriskandur")->command_me("sag Moege dir stehts Freundschaft zu Teil werden!");
  }

  call_out("teach_bard_spell", 0);
  MUSENMASTER->ResetStatus();
  return;
}

public void teach_bard_spell() {
  object *inv;
  int i;

  inv = all_inventory();
  for(i=0; i<sizeof(inv); ++i) {
    if(!query_once_interactive(inv[i])) continue;
    if(inv[i]->QueryProp(P_GUILD) != "bardengilde") continue;
    if(inv[i]->QuerySkill("lorica der musen") != 0) continue;

    LearnBardSpell(inv[i], "lorica der musen", 
      "Dieses Lied beschuetzt dich vor Zaubern und Tricks deiner Feinde.",
      "spiele 'lorica der musen' auf <ziel>");
  }
}

public void pray_sequence(int step) {
  string museName, museRoom;
  if(step < 0 || !objectp(praying)) return;

  if(find_netdead(praying) || step >= 7) {
    end_prayer();
    call_out("summon_dragon", 4);
    return;
  }

  museName = MUSE_NAMES[step];
  museRoom = ROOM "schrein_" + museName;

  call_other(museRoom, "???");
  if(objectp(present("\ngwenshara_muse", find_object(museRoom)))) {
    tell_room(TO, BS("Betoerender Gesang erschallt aus dem "+CAP(getExitFor(museName))+"."));
    call_out("pray_sequence", 1, ++step);
  } else {
    tell_room(TO, BS("Nichts geschieht."));
    end_prayer();
  }
}
