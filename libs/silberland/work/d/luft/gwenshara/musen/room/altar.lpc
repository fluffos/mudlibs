#include "../def.h"

inherit "/std/room";
inherit "/gilden/bardengilde/obj/std_spellprovider";

private object praying;

int check_items(string verb) {
    // damit nichts verloren geht
    object ob;
    if(objectp(ob=deep_present("\ngwenshara_muse_item", TP))) {
        tell_object(TP, BS(sprintf("%s gehoert in diesen Tempel. Lass %s lieber hier, bevor du gehst.", ob->Name(WER), ob->QueryPronoun(WEN))));
        return 0;
    }
    return 1;
}


public void create()  {
  ::create();

  praying = 0;

  SetProp( P_INT_SHORT, "Im Heiligtum des Tempels der Musen" );
  SetProp( P_INT_LONG,
    "Du befindest dich hier im Heiligtum des Tempels. Ueber dir erhebt sich eine "
    "gewaltige Kuppel aus Glas, durch die das Licht in alle Farben des Regenbogens "
    "gebrochen wird. Der Altar des Tempels ist ein reich verzierter Steinblock, der "
    "sich in der Mitte des Heiligtums erhebt und ueber ein paar Stufen von allen Seiten "
    "zugaenglich ist. Die Kuppel wird von mehreren Saeulen getragen. Einige Baenke laden "
    "zum verweilen ein, waehrend eine angenehme, verspielte Musik von allen Seiten her "
    "klingt." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "heiligtum", "heiligtums", "halle", "saeulenhalle", "ort", "raum" }),
    "Dies Saeulenhalle ist das Heiligtum im Tempel der Musen. An diesem Ort wird den "
    "Musen, als Schutzgeister der Kuenste, gehuldigt. Schon alleine deine Anwesenheit hier "
    "scheint dich zu inspirieren.");

