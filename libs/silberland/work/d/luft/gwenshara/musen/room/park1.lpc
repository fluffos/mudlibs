#include "../def.h"

inherit "/std/room";

public void create()  {
  ::create();

  SetProp( P_INT_SHORT, "Am Tor zum Tempel der Musen" );
  SetProp( P_INT_LONG,
    "Du stehst hier am Fuss eines Huegels. Nach Sueden hin schlaengelt sich ein "
    "Weg den grasbewachsenen Huegel hinauf, zu einem grossen Saeulentempel. Im Norden "
    "kannst du durch ein goldenes Tor in Richtung des Stadtparks von Liliandor gehen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HILL]) );

  AddDetail( ({"tor"}),
    "Das Tor besteht aus goldenen Gitterstaeben und trennt den Huegel des Tempels "
    "vom Rest der Stadt.");

  AddDetail( ({"gitterstaebe", "staebe", "gitterstaeben"}),
    "Das Tor ist aus Staeben aus echtem Gold gemacht. Scheint also eher dekorativ, "
    "als nuetzlich zu sein.");

  AddDetail( ({"stadtpark", "stadtparks", "park"}),
    "Der Stadtpark von Liliandor befindet sich noerdlich von hier. Gut erkennst du "
    "den Glasturm, der sich darin erhebt.");

  AddDetail( ({"liliandor", "stadt", "wolkenstadt"}),
    "Liliandor ist die Stadt, die sich hier hoch ueber den Wolken erhebt.");

  AddDetail( ({"turm", "glasturm"}),
    "In der Mitte des Stadtparks erhebt sich ein Turm aus gruen-weissem Glas.");

  AddDetail( ({"gold"}),
    "Wenn du wirklich seicher sein willst, koenntest du reinbeissen?");

  AddDetail( ({"fuss"}),
    "Du stehst hier am Fuss des Huegels. Ganz unten.");
  
  AddDetail( ({ "himmel" }),
    "Der Himmel ueber dir ist absolut wolkenfrei.");

  AddDetail( ({"boden"}),
    "Der Weg besteht aus festgetretener Erde. Abseits des Wegs erstreckt sich saftiges, "
    "gruenes Gras.");

  AddDetail( ({"erde"}),
    "Die Erde ist braun und von vielen Schritten festgestampft.");

  AddDetail( ({"schritte", "schritten"}),
    "Auch du fuegst deine Schritte hinzu.");

  AddDetail( ({"gras"}),
    "Das Gras links und rechts des Wegs sieht saftig und gruen aus. Es ist von einer "
    "sanften Tauschicht bedeckt.");

  AddDetail( ({"tau", "tauschicht"}),
    "Der Tau ruehrt daher, dass die Wolken hier sehr nahe sind.");

  AddDetail( ({"wolken", "wolkendecke"}),
    "Der Huegel erhebt sich aus einem Wolkenmeer.");

  AddDetail( ({"meer", "wolkenmeer"}),
    "Du befindest dich hier ueber - oder besser auf - den Wolken.");

  AddDetail( ({"weg"}),
    "Ein brauner Weg schlaengelt sich nach Sueden hin den Huegel hoch und endet dann "
    "dort vor einem grossen Saeulentempel.");

  AddDetail( ({"huegel","huegels"}),
    "Du befindest dich hier am Fuss des Huegels, der sich wie ein Berg aus dem "
    "Wolkenmeer rundherum erhebt.");

  AddDetail( ({"tempel", "saeulentempel"}),
    "Oben am Huegel erhebt sich ein grosser Tempel. Genau kannst du ihn von hier aus "
    "nicht erkennen. Nur das Funkeln des Sonnenlichts auf seinem Glasdach "
    "ist deutlich zu sehen.");

  AddDetail( ({"funkeln", "sonnenlicht", "licht", "sonnenlichts"}),
    "Das Licht der Sonne wird vom Glasdach des Tempels reflektiert.");

  AddDetail( ({"dach", "glasdach"}),
    "Von hier aus erkennst du nur das bunte Funkeln des Sonnenlichts.");

  AddDetail( ({"sonne"}),
    "Die Sonne strahlt vom wolkenlosen Himmel herab.");

  AddDetail( ({"berg"}),
    "Der Huegel ist kein wirklicher Berg. Das ist nur eine Metapher.");

  AddDetail( ({"metapher"}),
    "Ein Sinnbild.");

  AddDetail( ({"sinnbild"}),
    "Sowas, wie den Huegel als Berg zu bezeichnen.");

  AddExit( "sueden", ROOM "park2" );
  AddExit( "norden", ANSCHLUSS);

  AddCmd( "beisse|beiss&in&staebe|stab|gitter|tor|gold|gitterstab|goldstab|torstab", "cmd_beissen",
          "Was willst du beissen?");
}

public int cmd_beissen() {
  write(BS("Du beisst vorsichtig in einen der Staebe. Echtes Gold, kein Zweifel!"));
  say(BS(TPN+" beisst ins Tor."));
  return 1;
}
