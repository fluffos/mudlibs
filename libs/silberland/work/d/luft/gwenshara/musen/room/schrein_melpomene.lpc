#include "../def.h"

inherit ROOM "std_schrein";

public void create()  {
  ::create();

  SetProp( P_INT_SHORT, "Im Schrein der Muse Melpomene" );
  SetProp( P_INT_LONG,
    "Im Vergleich zu den anderen Schreinen des Tempels erscheint dieser, "
    "durch das stete violette Licht, eher duester, jedoch nicht unangenehm. "
    "Die Statue der jungen Frau in der Mitte des Raumes wurde theatralisch "
    "in Pose gesetzt. Ein einzelner, gut platzierter, Lichtstrahl faellt durch "
    "das Glasdach genau auf sie. Zwei grosse Kohlebecken stehen links und rechts "
    "der Statue und verbreiten einen suesslichen Geruch." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_MUSE, MELPOMENE);

  AddDetail( ({"mitte"}),
    "Eine Lichtsaeule faellt mitten in den Raum und darin steht eine Statue.");

  AddDetail( ({"pose"}),
    "Sehr theatralisch und dramatisch.");

  AddDetail( ({"becken", "kohlebecken"}),
    "In den grossen Kohlebecken wird offenbar Raeucherwerk verbrannt, dass eienn "
    "schweren Geruch verbreitet.");

  AddDetail( ({"geruch"}),
    "Sehen kannst du nur die feinen Rauchschwaden, die aufsteigen.");

  AddDetail( ({"schwaden", "rauchschwaden"}),
    "Sie heben sich blau-weisslich gegen den Hintergrund ab.");

  AddDetail( ({"raeucherwerk"}),
    "Du weisst nicht genau worum es sich handelt.");

  AddDetail( ({"hintergrund"}),
    "Die Waende etwa.");

  AddDetail( ({"wand", "waende"}),
    "Die Waende sind im schummrigen Licht nur schwer auszumachen. Du erkennst jedoch, "
    "dass sie mit samtenen Vorhaengen verhangen sind.");

  AddDetail( ({"vorhaenge"}),
    "Die Vorhaenge sind aus schwerem Samt und verdecken die gesamten Waende. Was sich wohl "
    "dahinter verbirgt?");

  AddDetail( ({"samt"}),
    "Schwerer roter Samt.");
  
  AddDetail( ({"stelle"}),
    "An der einen Stelle sind durchsichtige Glasscheiben angebracht.");

  AddDetail( ({"decke", "dach", "glasdach"}),
  "Das Dach dieses Schreins wurde mit kleinen violetten Scheiben gedeckt. Nur an "
  "einer einzelnen Stelle faellt ein Lichtstrahl genau auf die Statue durch das Dach. "
  "Alle anderen Glasscheiben vermindern das Licht zu einem unheimlichen Gluehen.");

  AddDetail( ({"licht"}),
    "Der Raum ist eher von einem violetten Gluehen erhellt. Nur ein einzelner echter "
    "Lichtstrahl faellt genau auf die Statue.");

  AddDetail( ({"scheiben", "glasscheiben"}),
    "Die violetten Glasscheiben im Dach absorbieren das meiste Licht.");

  AddDetail( ({"gluehen"}),
    "Das schummrige Gluehen im Raum verleiht ihm eine gewisse Dramatik.");

  AddDetail( ({"dramatik"}),
    "Wirkt passend zur theatralischen Pose der Statue.");

  AddDetail( ({"strahl", "lichtstrahl", "saeule", "lichtsaeule"}),
    "Wie eine helle Lichtsaeule hebt der einzelne Strahl die Statue hervor. "
    "So als waere dieser der Hauptcharakter hier.");

  AddDetail( ({"charakter", "hauptcharakter"}),
    "In diesem Raum bist das nicht du, sondern die Statue. Finde dich damit ab.");

  AddDetail( ({"boden"}),
    "Der Boden ist mit marmorenen Steinfliesen ausgelegt.");

  AddDetail( ({"fliesen", "steinfliesen", "marmor", "stein"}),
    "Aller Stein hier sind aus feingeaedertem, violettem Marmor.");

  AddDetail( ({"schrein", "raum"}),
    "Du befindest dich hier in einem Schrein im Tempel der Musen.");
  
  AddSpecialDetail( ({"statue", "frau"}), "detail_statue");

  AddDetail( ({"fenster"}),
    "Die siehst du hier nicht. Sie sind wohl hinter den Vorhaengen versteckt.");

  AddReadDetail( ({"inschrift", "lettern"}), 
      "MELPOMENE die Singende. Muse der Tragoedie.");


  AddSmell( DEFAULT_SMELL,
    "Ein suesslicher Duft liegt in der Luft.");

  AddSound( ({ "luft", "duft" }),
    "Der schwere, suessliche Duft geht von den Kohlebecken aus.");

  AddExit( "westen", ROOM "altar");

  AddCmd( "ziehe|zieh&vorhang&zur&seite", "cmd_vorhang", "Was willst du zur Seite ziehen?");
}

public int cmd_vorhang() {
  write(BS("Du ziehst einen Vorhang zur Seite und helles Licht blendet dich. "
           "Wuuuhaaa! Da hat jemand die Fenster verhaengt!"));
  say(BS(TPN+" macht irgendwas und ploetzlich wird es kurz hell im Raum."));

  TP->SetProp(P_BLIND, ([BLIND_TIME: 5+random(10),
                         BLIND_MSG: "Du bist vom Licht geblendet!\n",
                         BLIND_END_MSG: "Deine Augen gewoehnen sich wieder an das normale Licht.\n"]));
  return 1;
}

public string detail_statue() {
  string itemName;
  itemName = MUSENMASTER->NameOf(MUSENMASTER->ItemOf(MELPOMENE), 2);
  return BS(sprintf("Die Statue ist die einer schoenen Frau. Sie wurde aus Marmor "
                 "gehauen und traegt eine violett angemalte Toga. Sie wurde hier theatralisch "
                 "in Pose gesetzt. Ihr gesicht kannst du nicht erkennen, da sie stattdessen "
                 "eine traurige Maske traegt. Eine Hand hat sie leidend an die Stirn gehalten, "
                 "die andere auf %s gestuetzt waehrend ihr Blick flehend in den Himmel gerichtet ist."
                 " Auf dem Sockel zu ihren Fuessen kannst du eine Inschrift in goldenen Lettern "
                 "erkennen.", itemName));
}
