#include "../def.h"

inherit ROOM "std_schrein";

public void create()  {
  ::create();

  SetProp( P_INT_SHORT, "Im Schrein der Muse Terpsichore" );
  SetProp( P_INT_LONG,
    "In diesem Schrein hoerst du sofort beim Eintreten rhytmische Musik, "
    "die dich zum Tanz einlaedt. Orangenes Licht dringt schillernd durch "
    "das Glasdach hereien und wird von vielen kleinen Spiegeln in tausende "
    "kleiner Lichtpunkte verwandelt. Der Boden ist mit robusten Fliesen "
    "ausgelegt. Stoffbahnen in verschiedenen Orangetoenen wurden an der "
    "Statue einer tanzenden Frau angebracht, die mitten im Raum steht." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_MUSE, TERPISCHORE);

  AddDetail( ({"bahnen", "stoffbahnen"}),
    "Die Stoffbahnen in unterschiedliehen Orangetoenen wurden, wie ein Wirbel, "
    "an dem erhobenen Arm der Statue befestigt.");

  AddDetail( ({"arm"}),
    "Einen Arm hat die Statue erhoben und in ihm sammeln sich alle Stoffbahnen "
    "- oder gehen sie von ihm aus?");

  AddDetail( ({"punkte", "lichtpunkte"}),
    "Viele kleine Spiegel, die an den Waenden angebracht sind, fuehren dazu, "
    "dass das Licht in tausenden kleinen Lichtpunkten ueber die Waende tanzt.");

  AddDetail( ({"wand", "waende"}),
    "Die Waende in diesem Schrein sind mit tausenden kleinen Spiegel versehen.");

  AddDetail( ({"spiegel", "spiegeln"}),
    "Viele kleine Spiegel aus gehaemmertem Silber reflektieren das Licht im Raum.");

  AddDetail( ({"silber"}),
    "So blank poliert, dass du dich darin spiegelst.");

  AddDetail( ({"tanz", "tanzen"}),
    "Die Musik, die durch diesen Schrein toent, ist genau richtig fuer "
    "einen beschwingten Tanz.");

  AddDetail( ({"decke", "dach", "glasdach"}),
    "Das Dach dieses Schreins wurde mit kleinen orangenen Scheiben gedeckt. Orangenes Licht "
    "faellt durch sie in den Raum.");

  AddDetail( ({"licht"}),
    "Alles Licht in diesem Raum ist von orangener Farbe.");

  AddDetail( ({"farbe", "orange", "orangetoene", "orangetoenen"}),
    "Es handelt sich um ein sattes Orange, dass dich richtig froehlich macht.");

  AddDetail( ({"scheiben"}),
    "Es handelt sich dabei um regelmaessige Quadrate aus einem orangenem Glas.");

  AddDetail( ({"glas"}),
    "Das Dach besteht aus einer Form von halbdurchsichtigem Glas.");

  AddDetail( ({"quadrate"}),
    "Die Scheiben des Glasdachs sind quadratisch.");

  AddDetail( ({"boden"}),
    "Der Boden ist mit robusten Steinfliesen ausgelegt.");

  AddDetail( ({"fliesen", "steinfliesen", "marmor", "stein"}),
    "Aller Stein hier sind aus feingeaedertem, orangenem Marmor.");

  AddDetail( ({"schrein", "raum"}),
    "Du befindest dich hier in einem Schrein im Tempel der Musen.");
  
  AddSpecialDetail( ({"statue", "frau"}), "detail_statue");

  AddReadDetail( ({"inschrift", "lettern"}), 
    "TERPSICHORE die froehlich im Reigen Tanzende. Muse fuer Chorlyrik und Tanz.");

  AddSound( DEFAULT_SOUND,
    "Rhytmische Musik laedt dich zum Tanz ein.");

  AddSound( ({ "musik" }),
    "Es handelt sich um froehliche Musik, bei der du sofort mittanzen koenntest. "
    "Du kannst nicht genau bestimmen woher sie ueberhaupt kommt.");

  AddExit( "nordosten", ROOM "altar");

  AddCmd( "tanz|tanze", "cmd_tanzen" );
}

public int cmd_tanzen() {
  tell_object(TP, BS("Beschwingt tanzt du durch den Raum."));
  tell_room(TO, BS(TPN+" legt einen beschwingten Tanz durch den Raum hin."), ({TP}));
  return 1;
}

public string detail_statue() {
  string itemName;
  itemName = MUSENMASTER->NameOf(MUSENMASTER->ItemOf(TERPISCHORE), 2);
  return BS(sprintf("Die Statue ist die einer sehr jungen Frau. Sie wurde aus Marmor "
                 "gehauen und traegt eine orangen bemalte Toga. In ihrer Pose befindet "
                 "sie sich mitten im ausgelassenen Tanz. Den einen Arm weit ueber dem "
                 "Kopf erhoben, waehrend sie in der Hand des anderen %s haelt. Sie scheint "
                 "wahrhaftige Freude bei ihrem froehlichen Reigen zu verspuehren. "
                 "Auf dem Sockel zu ihren Fuessen kannst du eine Inschrift in goldenen Lettern "
                 "erkennen.", itemName));
}
