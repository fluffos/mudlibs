#include "../def.h"
inherit "/std/thing";

private int strength;

public void create() {
    if(!is_clone(TO)) return;
    ::create();

    SetProp(P_INVIS, 1);
    SetProp(P_NAME, "Freundschaft mit Yriskandur");
    SetProp(P_NODROP, 1);
    SetProp(P_NEVERDROP, 1);
    SetProp(P_NOSELL, 1);
    SetProp(P_NOBUY, 1);

    AddId( ({"\nyriskandur_freundschaft"}) );

    strength = 10;
}

public string extra_look() {
    return CAP(ENV(TO)->QueryPronoun())+ " ist mit Yriskandur dem Ziegenkoepfigen befreundet.\n";
}

public void reset() {
    if(!is_clone(TO)) return;
    ::reset();

    if(!living(ENV(TO))) {
        remove(1);
        return;
    }

    if(strength < -5) {
        tell_object(ENV(TO), BS("Deine Freundschaft mit Yriskandur geraet in Vergessenheit und erlischt."));
        remove(1);
        return;
    } else if(strength <= 0) {
        tell_object(ENV(TO), BS("Deine Freundschaft mit Yriskandur schwindet. Du solltest ihn aufsuchen und sie erneuern."));
        strength--;
    } else {
        call_out("heal", 50 + random(600));
    }
}

public void heal() {
    if(!living(ENV(TO))) {
        remove(1);
        return;
    }
    
    tell_object(ENV(TO), BS("Die Erinnerung an deine Freundschaft mit Yriskandur staerkt dich."));
    ENV(TO)->AddHp(2 * strength);
    ENV(TO)->AddSp(2 * strength);
    strength--;
}

public void Renew() {
    strength = 5 + random(5);
}
