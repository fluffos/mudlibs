#include "../def.h"
#include <food.h>

inherit "std/food";


public void create() {
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein goldene Birne");
  SetProp(P_LONG,
    "Diese Birne sieht im Grunde ganz normal aus, nur, dass sie golden glaenzt.");
  SetProp(P_NAME, "Birne");
  SetProp(P_NAME_ADJ, "golden");
  SetProp(P_GENDER, FEMALE);
  AddId(({"birne", "goldbirne"}));
  AddAdjective(({"goldene", "goldenen", "goldener"}));
  
  SetProp (P_MATERIAL, ([MAT_FOOD: 90, MAT_MAGIC: 10]));
  SetProp (P_FOOD_INFO, ([F_HEAL:5+random(10), 
                          F_SOAK:5,
                          F_MSG_DECAY: "Die goldene Birne wird matschig.\n",
                          F_MSG_REMOVE: "Die goldene Birne verschimmelt und du wirfst sie weg.\n"]));
  SetProp(P_WEIGHT, 80);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 1);

  start_decay(3600, 7200);
}

public void BeimEssen() {
  write(BS("Du verspeist die goldene Birne und fuehlst dich inspiriert."));
  say(TPN+" verspeist eine goldene Birne.");
  TP->AddSp(7);
  if(TP->QueryProp(P_GUILD) == "bardengilde") {
    call_other("/spellbooks/barden_spells", "accumulateInspiration", TP, 1+random(10));
  }
  return ::BeimEssen();
}