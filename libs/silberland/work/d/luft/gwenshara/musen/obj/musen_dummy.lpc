#include "../def.h"
inherit "/std/thing";

public void create() {
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Steindummy");
  SetProp(P_LONG, "Muss erst gemeisselt werden.");

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "Dieser Gegenstand gehoert in den Tempel der Musen.");
  SetProp(P_NAME, "Steindummy");
  SetProp(P_GENDER, FEMALE);
  AddId("\ngwenshara_muse_item");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MARBLE );
  SetProp(P_WEIGHT, 4000);
  SetProp(P_SIZE, 50);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
}
