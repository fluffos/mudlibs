#include "../def.h"
inherit "/std/thing";

private int strength;

public void create() {
    if(!is_clone(TO)) return;
    ::create();

    SetProp(P_INVIS, 1);
    SetProp(P_NAME, "Yriskandurs Fluch der Feindschaft");
    SetProp(P_NODROP, 1);
    SetProp(P_NEVERDROP, 1);
    SetProp(P_NOSELL, 1);
    SetProp(P_NOBUY, 1);

    AddId( ({"\nyriskandur_fluch"}) );

    strength = 10;
}

public string extra_look() {
    return CAP(ENV(TO)->QueryPronoun())+ " ist abslout verachtenswert!\n";
}

public void reset() {
    if(!is_clone(TO)) return;
    ::reset();

    if(!query_once_interactive(ENV(TO))) {
        remove(1);
        return;
    }

    tell_object(ENV(TO), BS("Der Fluch der Feindschaft loest sich von dir!"));
    ENV(TO)->SetProp(P_AGGRESSIVE, 0);
    call_out("remove", 0, 1);
}

public void activate() {
    ENV(TO)->SetProp(P_AGGRESSIVE, 1);
}
