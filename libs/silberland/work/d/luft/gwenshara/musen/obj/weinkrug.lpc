#include "../def.h"
#include <food.h>

inherit "std/food";


public void create() {
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Weinkrug");
  SetProp(P_LONG,
    "Dieser einfache Tonkrug ist gut gefuellt mit rotem Wein.");
  SetProp(P_NAME, "Weinkrug");
  SetProp(P_GENDER, MALE);
  AddId(({"krug", "wein", "weinkrug"}));
  
  SetProp (P_MATERIAL, ([MAT_EARTH: 40, MAT_ALCOHOL: 60]));
  SetProp (P_FOOD_INFO, ([F_HEAL:10+random(20), F_DRINK:10, F_ALCOHOL:10, F_POISON:0]));
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 2000);
  SetProp(P_NOBUY, 1);
}

BeimEssen()
{
  write("Du trinkst den Wein mit einem Satz aus und wirfst den leeren Tonkrug weg.\n");
  say(TPN+" trinkt einen Weinkrug aus und wirft dann das leere Gefaess weg.\n");
  return ::BeimEssen();
}