#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Musenschwert");
  SetProp(P_LONG,
    "Dieses Schwert ist etwa zwei Ellen lang und aus violettem Marmor "
    "Marmor geschnitten. Die feinen adern im Stein scheinen leicht zu "
    "pulsieren.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Musenschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schwert", "musenschwert", "\ngwenshara_musen_schwert"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_MARBLE: 90, MAT_MAGIC: 10]) );
  SetProp(P_WEIGHT, 2500);
  SetProp(P_SIZE, 80);
  SetProp(P_VALUE, 2000);
  SetProp(P_NOBUY, 1);
  SetProp(P_MAGIC, 3);
  SetProp(P_ITEMD_NO_MAGIC, 1);
  
//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 150);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_MIND}) );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_WC_BONUS, (["\ngwenshara_muse": 200]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:25, A_INT: 20]) );

//--Details----------------------------------------------------------------

  SetProp(P_INFO, BS("Dieses Schwert ist von der Kraft der Musen erfuellt."));
}
