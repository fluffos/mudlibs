#include "../def.h"
#include "/gilden/nekromanten/nekro_properties.h"

inherit "std/weapon";

#define NORMAL 1
#define PESTERED -1
#define P_NEKRO_PESTERED "nekro_pestered"

private int multiplier;

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Yriskandurs Hoerner");
  SetProp(P_LONG,
    "Du haeltst zwei lange, goldene Hoerner in der Hand. Jedes ist etwa "
    "eine Elle lang. Beide sind leicht spiralfoermig gedreht und haben am unteren Ende "
    "scharfe Kangen, sowie eine moerderische Spitze. Bei jeder Bewegung "
    "der Hoerner hinterlaesst feiner Goldstaub einen glitzernden Schimmer "
    "in der Luft.\n"
    "Da sie an der Basis nicht scharfkantig, sondern so stark gedreht sind, dass "
    "sie sich gut angreifen lassen, kann man sie, aehnlich wie Rondeldolche "
    "gut als Waffe fuehren.");

    SetProp(P_INFO, "In diesen Hoernern liegt Yriskandurs Macht des Guten.\n"
                    "Sie lassen deine Gesinnung besser werden.\n"
                    "Die Hoener schaden boesartigen Kreaturen.\n");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Yriskandurs Hoerner");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"hoerner", "yriskandurhorn", "yriskandurs hoerner", "\nyriskandurs_hoerner", 
           "\ncustom_pestered_weapon"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_HORN: 80, MAT_GOLD:10, MAT_MAGIC: 10]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_SIZE, 40);
  SetProp(P_VALUE, 20000);
  SetProp(P_NOBUY, 1);
  
//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 190);
  SetProp(P_WC_FIX, 40);
  SetProp(P_DAM_TYPE, ({DT_PIERCE}) );
  SetProp(P_NR_HANDS, 2);

  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WIELD_RESTRICTIONS, ([P_LEVEL: 40]) );

  SetProp(P_MAGIC, 5);
  SetProp(P_ITEMD_NO_MAGIC, 1);

  SetProp(P_KILL_NAME, "Yriskandurs Hoerner");

  multiplier = NORMAL;
}

int WieldFunc(object waffe) 
{
  if(TP->QueryProp(P_ALIGN)*multiplier < 0) {
    tell_object(TP, BS("Als du die Hoerner ergreifst verbrennen sie deine Haende!"));
    TP->do_damage(20+random(30));
  }
  return 1;
}

int HitFunc( object enemy ) 
{
  object wielder;
  int bonus;
  if(!objectp(wielder=QueryProp(P_WIELDED))) return 0;

  bonus = wielder->QueryProp(P_ALIGN)*multiplier/100;
  if(bonus>10) bonus = 10;

  if(enemy->QueryProp(P_ALIGN)*multiplier < 0) {
    if(!random(30)) {
      tell_room(ENV(wielder), BS(Name(WER)+" hinterlaesst eine zornige Lichtspur."));
      bonus *= 3;
    } else {
      bonus += enemy->QueryProp(P_ALIGN)*-1*multiplier/50;
    }
  }

  if(!random(2) && wielder->QueryProp(P_ALIGN)*multiplier < 1500) {
    if(!random(50)) {
      if(multiplier == NORMAL) tell_object(wielder, BS("Die Macht des Guten und der Freundschaft durchfaehrt dich!"));
      else tell_object(wielder, BS("Die Macht des Boesen und des Hasses durchfaehrt dich!"));
      wielder->SetProp(P_ALIGN, wielder->QueryProp(P_ALIGN) + 20*multiplier);
    } else {
      wielder->SetProp(P_ALIGN, wielder->QueryProp(P_ALIGN) + 1*multiplier);
    }
  }

  if(wielder->QueryProp(P_TESTPLAYER)) {
    tell_object(wielder, sprintf("hitfunc -> %d\n", bonus));
  }
  return bonus;
}

public void set_pestered(object caster) {
  SetProp(P_SHORT, "Yriskandurs verfluchte Hoerner");
  SetProp(P_NAME, "Yriskandurs verfluchte Hoerner");
  AddId("yriskandurs verfluchte hoerner");

  SetProp(P_LONG,
    "Du haeltst zwei lange, schaerz angelaufene Hoerner in der Hand. Jedes ist etwa "
    "eine Elle lang. Beide sind leicht spiralfoermig gedreht und haben am unteren Ende "
    "scharfe und blutige Kanten, sowie eine moerderische Spitze. Bei jeder Bewegung "
    "der Hoerner bleibt ein eiskaltes und blutrotes Nachbild in der Luft zurueck.\n"
    "Da sie an der Basis nicht scharfkantig, sondern so stark gedreht sind, dass "
    "sie sich gut angreifen lassen, kann man sie, aehnlich wie Rondeldolche "
    "gut als Waffe fuehren.\nStaendig tropft eine blutrote Fluessigkeit von ihnen.");

    SetProp(P_INFO, sprintf("Die Macht der Hoerner wurde von %s zu Boshaftigkeit und Hass pervertiert.\n", caster->name(WEM, 1))+
                    "Sie lassen deine Gesinnung schlechter werden.\n"
                    "Die Hoener zerfetzen gute Kreaturen in kleine, blutige Stueckchen.");

  SetProp(P_NEKRO_PESTERED, caster);
  multiplier = PESTERED;
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_UNHOLY}) );
  SetProp(P_NEKRO_SPELLCOST, 5);
  SetProp(P_NEKRO_BONUS, 5);
}


public int AddBloodPool(int overflow) {
  return (int) (overflow*1.1);
}