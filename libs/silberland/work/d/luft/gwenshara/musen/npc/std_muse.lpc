#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

private int lastFight;

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  lastFight = time();

  SetProp(P_SIZE, 175);
}

public void Attack(object enemy) {
    lastFight = time();
    ::Attack(enemy);
}

private void clean_inventory() {
    object *inv;
    int i;

    inv = all_inventory();
    for(i=0;i<sizeof(inv);++i) {
        inv[i]->remove(1);
    }
}

public void reset() {
    if(!is_clone(TO)) return;
    ::reset();

    if(time()-lastFight > 300) {
        clean_inventory();
        tell_room(ENV(TO), Name(WER)+ " verblasst ins Nichts.\n");
        remove(1);
    }
}