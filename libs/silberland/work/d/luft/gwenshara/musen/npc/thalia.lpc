#include "../def.h"

inherit NPC "std_muse";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Thalia die Festliche, die Bluehende. Muse der Komoedie und des Fruehlings");
  SetProp(P_LONG,
    "Vor dir steht die Gestalt einer schoenen, jungen Frau. Sie ist leicht "
    "durchscheinend und schwebt leicht ueber dem Boden, als waere sie nicht "
    "ganz real, sondern wueder deiner Fantasie entspringen. Auf ihrem Haar "
    "ruht ein steinerner Efeukranz und ihr Mund laechelt dich mit vollen "
    "Lippen froehlich an. Ihr Gesicht kannst du nicht erkennen, da es von euner "
    "lachenden Theatermaske verdeckt wird.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Thalia");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId(({"thalia", "muse", "\ngwenshara_muse", "NOCONTROL", "NOWIMPY"}));
  AddClass( ({ CL_FAIRY, CL_FLYING }) );

  set_living_name("thalia");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(37);

  SetProp(P_HANDS, ({" mit der Kraft des Fruehlings",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON,DT_POISON})
                    }) );

  SetProp(P_RACE, "Muse");
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 5);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" ist nicht wirklich real und der Gegenstand faellt durch sie hindurch.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_MIND: 0.1, DT_UNHOLY: 0.3, DT_FIRE: 0.2,
      // nicht real, darum resistent gegen "realen" Schaden
      DT_SLASH: -0.5, DT_PIERCE: -0.5, DT_BLUDGEON: -0.5,
      DT_SQUEEZE: -0.5, DT_WHIP: -0.5, DT_RIP: -0.5, DT_POISON: -0.3 ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "tritt aus deinen Gedanken hervor");
  SetProp(P_MMSGOUT, "loest sich in Luft auf");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " verblasst ins Nichts.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Dann eben ein Fest mit dem TOD!");
  SetProp(P_KILL_MSG, "Auch dein Begraebnis wird ein Fest werden!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " hoert dich gar nicht in ihrem Tanz.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 30);

  AddSpell(2, 150,
    "Um "+Name(WEN)+" erstrahlt eine Aura aus Sonnenlicht, die dich blendet.\n",
    "Um "+Name(WEN)+" erstrahlt eine Aura aus Sonnenlicht und blendet @WEN.\n",
     DT_LIGHT, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 200, DS_POISON,
    Name(WER)+" wickelt dich in giftige Efeuranken.\n",
    Name(WER)+" wickelt @WEN in giftige Efeuranken.\n");

 AddDefaultSpell(1, 1, DS_SLOW,
    Name(WER)+" deutet mit der Hand auf dich und Efeuranken springen auf um dich zu packen!\n",
    Name(WER)+" deutet auf @WEN und Efeuranken springen hoch um @WEN zu packen!\n");

//--Ausruestung------------------------------------------------------------

  SUID;

  CLONEME(ARMOUR "toga" );
  if(!random(5)) {
    CLONEME(ARMOUR "musen_maske" );
  }
  command("trage alles");

}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
