#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Satyrios, der oberste Saenger der Musen");
  SetProp(P_LONG,
    "Satyrios ist, wie sein Name schon vermuten laesst, ein Satyr. Sein "
    "fellbedeckter Oberkoerper ist muskoloes und adonisch. Das Fell von "
    "rotbrauner Farbe. Aus seinem Kopf winden sich zwei gedrehte Ziegenhoerner "
    "und starke Bocksbeine tragen seinen Koerper. Waehrend sein Unterkoerper "
    "eindeutig der einer Ziege ist, ist sein Oberkoerper eher der eines Menschen. "
    "Mit freundlichem Blick und einem Wackeln seiner ziegenhaften Ohren laechelt "
    "er dich an.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Satyrios");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId(({"satyrios", "saenger", "\ngwenshara_satyrios", "NOCONTROL", "NOWIMPY"}));
  AddClass( ({ CL_FAIRY, CL_ANIMAL }) );

  set_living_name("satyrios");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(35);

  SetProp(P_HANDS, ({" mit seinen Bocksbeinen",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_GUILD, "bardengilde");
  SetProp(P_GUILD_LEVEL, 8);
  SetProp(P_RACE, "Satyr");
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_LIGHT, 1); // aktive ode an die sterne :)
  SetProp(P_SIZE, 160);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" bedankt sich dafuer.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_COLD:     -0.1, DT_AIR:      -0.1, DT_LIGHTNING: 0.1,
      DT_SOUND:    -0.2, DT_LIGHT:    -0.1, DT_POISON:   -0.2, 
      DT_TERROR:      0.1 ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Du Monster weisst die Kuenste nicht zu schaetzen!");
  SetProp(P_KILL_MSG, "Ueber unseren Kampf werde ich ein Lied schreiben!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " spielt auf seiner Floete.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 50);

  AddSpell(2, 200,
    "Eine Windboehe weht dir entgegen.\n",
    "Eine Windboehe weht @WEM entgegen.\n",
     DT_AIR, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3, 150,
    Name(WER)+" singt ein schrilles Vibrato, das in deinen Ohren schmerzt!\n",
    Name(WER)+" singt ein schrilles Vibrato!\n", DT_SOUND, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 100, 
    Name(WER)+" tritt mit seinen Beinen nach dir.\n",
    Name(WER)+" tritt mit seinen Beinen nach @WEM.\n", DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 350, 
        Name(WER)+" ruft: \"Nimmermehr!\" und deutet auf dich.\n",
        Name(WER)+" ruft: \"Nimmermehr!\" und deutet auf @WEN.\n", DT_MIND, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 200, DS_DEAF,
    Name(WER)+ " singt ein schrilles Vibrato, das in deinen Ohren schmerzt!\n",
    Name(WER)+" singt ein schrilles Vibrato!\n");

  AddDefaultSpell(1, 1, DS_SLOW,
        Name(WER)+" singt ein Schlaflied.\n",
        Name(WER)+" singt ein Schlaflied.\n");

  AddSpell(1, 300,
    Name(WER)+" rammt dich mit seinen Ziegenhoernern.\n"),
    Name(WER)+" rammt @WEN mit seinen Ziegenhoernern.\n", DT_PIERCE, ([SP_SHOW_DAMAGE]);
  
//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" spielt auf seiner Floete.\n",
    Name(WER, 1)+" dichtet ein neues Lied\n",
    Name(WER, 1)+" singt ein Hohelied auf die Musen.\n",
    Name(WER, 1)+" reztitiert ein Gedicht des Barden Schuettelbirne.\n",
    Name(WER, 1)+" laechelt dich freundlich an.\n",
    Name(WER, 1)+" zwinkert dir aufmunternd zu.\n",
    Name(WER, 1)+" singt: Schoeeen, ist es auf der Welt zu sein!\n",
    Name(WER, 1)+" nimmt einen Schluck aus seinem Weinkrug.\n",
    Name(WER, 1)+" lacht bloekend.\n",
    Name(WER, 1)+" stimmt seine Floete.\n",
    Name(WER, 1)+" singt die Ode an die Sterne.\n"
   }) );

   AddLibrary("/gilden/bardengilde/libs/allgemein.lib", 1);
   AddLibrary(NPC "musen.lib", 6);

//--Ausruestung------------------------------------------------------------

  SUID;
  /*CLONEME(WEAPON "" );
  command("zuecke waffe");*/

  CLONEME(ARMOUR "panfloete" );
  CLONEME(ARMOUR "toga" );
  CLONEME("/gilden/bardengilde/armour/bbrosche");
  command("trage alles");

  CLONEME(OBJ "weinkrug");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

public int Defend(int dam, mixed dam_type, mixed spell, object enemy) {
    string *dt;

    if(!pointerp(dam_type)) {
        dt = ({ dam_type });
    } else {
        dt = dam_type;
    }

    if(spell != 0 && !random(3)) {
        if(QueryProp("lorica")) {
          if(!random(3)) {
              tell_room(ENV(TO), BS("Regenbogenfarbenes Licht flackert um "+ TO->Name(WEN) +" herum auf und absorbiert den Angriff!"));
              return ::Defend(0, dt, spell, enemy);
          } else {
              tell_room(ENV(TO), BS("Regenbogenfarbenes Licht flackert um "+ TO->Name(WEN) +" herum auf und schwaecht den Angriff ab!"));
              return ::Defend(dam/2, dt, spell, enemy);
          }

          if(!random(4)) {
            tell_room(ENV(TO), BS("Das regenbogenfarbene um " + name(WEN, 1) + " verblasst."));
            SetProp("lorica", 0);
          }
        }
    }

    if(!random(2) && !QueryProp("lorica")) {
      tell_room(ENV(TO), BS(sprintf("Ein regenbogenfarbenes Netz schimmert kurz um %s auf.\n", name(WEN, 1))));
      SetProp("lorica", 1);
    }

    if(!random(5) || 
       member(dt, DT_AIR) > -1 || 
       member(dt, DT_COLD) > -1 || 
       member(dt, DT_BLUDGEON) > -1) {

      if(!QueryProp("no_schutz")) {
        tell_room(ENV(TO), BS("Ein Schild aus Toenen und Musik bildet sich vor " + TO->name(WEM, 1)+"."));

        if(!random(7)) {
          tell_room(ENV(TO), BS("Die Schutzmelodie um " + Name(WEN) + " verklingt!"));
          SetProp("no_schutz", 1);
        }
      } else {
        tell_room(ENV(TO), BS("Fuer einen kurzen Moment bildet sich ein regenbogenfarbener Schild vor " + name(WEM, 1) + " und Musik erfuellt die Luft."));
        SetProp("no_schutz", 0);
      }
        return ::Defend(dam/2, dt, spell, enemy);
    }

    return ::Defend(dam, dt, spell, enemy);
}

public void Attack(object enemy) {
    if(!random(3)) {
        enemy->Defend(50+random(150), DT_LIGHT, ([SP_NAME:"vana-o isil ar elena", SP_SHOW_DAMAGE: 1]), TO);
        if(!random(5)) {
            tell_object(enemy, BS(TO->Name(WESSEN, 1)+" Schoenheit blendet dich!"));
            enemy->SetProp(P_BLIND, 4);
        }
    }

    ::Attack(enemy);
    return;
}
