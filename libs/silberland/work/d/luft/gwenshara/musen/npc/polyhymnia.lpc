#include "../def.h"

inherit NPC "std_muse";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Polyhymnia die Hymnenreiche. Mus des Gesangs");
  SetProp(P_LONG,
    "Vor dir steht die Gestalt einer schoenen, jungen Frau. Sie ist leicht "
    "durchscheinend und schwebt leicht ueber dem Boden, als waere sie nicht "
    "ganz real, sondern wueder deiner Fantasie entspringen. Ihr Mund ist weit "
    "geoeffnet, als da sie dem Himmel eine Arie darbietet. Ihr Blick scheint "
    "vertraeumt und von der Emotion des Liedes gefesselt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Polyhymnia");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId(({"polyhymnia", "muse", "\ngwenshara_muse", "NOCONTROL", "NOWIMPY"}));
  AddClass( ({ CL_FAIRY, CL_FLYING }) );

  set_living_name("thalia");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(37);

  SetProp(P_HANDS, ({" mit lautem Gesang",
                    QueryProp(P_HANDS)[1],
                    ({DT_SOUND})
                    }) );

  SetProp(P_RACE, "Muse");
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 5);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" ist nicht wirklich real und der Gegenstand faellt durch sie hindurch.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_MIND: 0.1, DT_UNHOLY: 0.3, DT_AIR: 0.2,
      // nicht real, darum resistent gegen "realen" Schaden
      DT_SLASH: -0.5, DT_PIERCE: -0.5, DT_BLUDGEON: -0.5,
      DT_SQUEEZE: -0.5, DT_WHIP: -0.5, DT_RIP: -0.5, DT_SOUND: -0.3 ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "tritt aus deinen Gedanken hervor");
  SetProp(P_MMSGOUT, "loest sich in Luft auf");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " verblasst ins Nichts.\n");
  SetProp(P_NOCORPSE, 1 );
  
//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " singt einfach weiter.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 30);

  AddSpell(4, 150,
    Name(WER)+" singt einen schrillen, schmerzhaften Ton.\n",
    Name(WER)+" singt einen schrillen, schmerzhaften Ton.\n",
     DT_SOUND, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(3, 200, DS_ANTIMAGIC,
    Name(WER)+" singt ein Schutzlied gegen die Magie.\n",
    Name(WER)+" singt ein Schutzlied gegen die Magie.\n");

  AddDefaultSpell(1, 1, DS_PARALYZE,
    Name(WER)+" lullt dich in ihren hypnotischen Gesang ein!\n",
    Name(WER)+" lullt @WEN in ihren hypnotischen gesang ein!\n");

//--Ausruestung------------------------------------------------------------

  SUID;

  CLONEME(ARMOUR "toga" );
  if(!random(2)) {
    CLONEME(ARMOUR "musen_guertel" );
  }
  command("trage alles");

}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
