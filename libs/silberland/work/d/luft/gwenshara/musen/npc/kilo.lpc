#include "../def.h"

inherit NPC "std_muse";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Clio die Ruehmende, Muse der Geschitsschreibung");
  SetProp(P_LONG,
    "Vor dir steht die Gestalt einer schoenen, jungen Frau. Sie ist leicht "
    "durchscheinend und schwebt leicht ueber dem Boden, als waere sie nicht "
    "ganz real, sondern wueder deiner Fantasie entspringen. Mit ernstem Gesicht "
    "blickt sie auf dich herab. Sie scheint weise und erfahren. In der einen "
    "Hand haelt sie einen Schreibgriffel und in der anderen eine Rolle aus "
    "Papier. Alleine ihre Gegenwart erfuellt dich schon mit der Weisheit der "
    "vergangenen Tage.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Clio");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId(({"clio", "muse", "\ngwenshara_muse", "NOCONTROL", "NOWIMPY"}));
  AddClass( ({ CL_FAIRY, CL_FLYING }) );

  set_living_name("clio");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(37);

  SetProp(P_HANDS, ({" mit der Weisheit der Jahrhunderte",
                    QueryProp(P_HANDS)[1],
                    ({DT_MAGIC})
                    }) );

  SetProp(P_RACE, "Muse");
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 5);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" ist nicht wirklich real und der Gegenstand faellt durch sie hindurch.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_MIND: 0.1, DT_UNHOLY: 0.3, DT_TERROR: 0.2,
      // nicht real, darum resistent gegen "realen" Schaden
      DT_SLASH: -0.5, DT_PIERCE: -0.5, DT_BLUDGEON: -0.5,
      DT_SQUEEZE: -0.5, DT_WHIP: -0.5, DT_RIP: -0.5 ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "tritt aus deinen Gedanken hervor");
  SetProp(P_MMSGOUT, "loest sich in Luft auf");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " verblasst ins Nichts.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Jetzt bin ich wohl Geschichte...");
  SetProp(P_KILL_MSG, "Und so gehst du in die Geschichte ein!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " laechelt dich wissend an.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 30);

  AddSpell(2, 200,
    Name(WER)+" laesst dich ploetzlich altern.\n",
    Name(WER)+" laesst @WEN ploetzlich altern.\n",
     DT_MAGIC, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 300, DS_DRAIN_MANA,
    Name(WER)+" raubt dir einen Teil deiner Erinnerung.\n",
    Name(WER)+" raubt @WEM einen Teil deiner Erinnerung.\n");

//--Ausruestung------------------------------------------------------------

  SUID;
  /*CLONEME(WEAPON "" );
  command("zuecke waffe");*/

  CLONEME(ARMOUR "toga" );
  if(!random(2)) {
    CLONEME(ARMOUR "musen_amulett");
  }
  command("trage alles");

}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
