#include "../def.h"

inherit NPC "std_muse";
void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Erato die Liebevolle, Muse der Liebe");
  SetProp(P_LONG,
    "Vor dir steht die Gestalt einer schoenen, jungen Frau. Sie ist leicht "
    "durchscheinend und schwebt leicht ueber dem Boden, als waere sie nicht "
    "ganz real, sondern wueder deiner Fantasie entspringen. Mit lasizivem "
    "Augenaufschlag streckt sie dir einladend die Arme. Ganz so, als wurde "
    "sie dich in einer Umarmung fangen und mit ihrem sinnlichen Mund kuessen "
    "wollen." );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Erato");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId(({"erato", "muse", "\ngwenshara_muse", "NOCONTROL", "NOWIMPY"}));
  AddClass( ({ CL_FAIRY, CL_FLYING }) );

  set_living_name("erato");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(37);

  SetProp(P_HANDS, ({" mit dem Feuer der Leidenschaft",
                    QueryProp(P_HANDS)[1],
                    ({DT_FIRE})
                    }) );

  SetProp(P_RACE, "Muse");
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 5);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" ist nicht wirklich real und der Gegenstand faellt durch sie hindurch.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_MIND: 0.1, DT_UNHOLY: 0.3, DT_WATER: 0.2,
      // nicht real, darum resistent gegen "realen" Schaden
      DT_SLASH: -0.5, DT_PIERCE: -0.5, DT_BLUDGEON: -0.5,
      DT_SQUEEZE: -0.5, DT_WHIP: -0.5, DT_RIP: -0.5, DT_FIRE: -0.3 ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "tritt aus deinen Gedanken hervor");
  SetProp(P_MMSGOUT, "loest sich in Luft auf");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " verblasst ins Nichts.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Warum konntest du mich nicht einfach lieben?");
  SetProp(P_KILL_MSG, "Liebe mehr, kaempfe weniger!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " zwinkert dir verfuehrerisch zu.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 30);

  AddSpell(2, 200,
    Name(WER)+" versengt dich mit ihrer Leidenschaft.\n",
    Name(WER)+" versengt @WEN mit ihrer Leidenschaft.\n",
     DT_FIRE, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 1, DS_DISARM,
    Name(WER)+" wirf dir einen schmachtenden Blick zu und du laesst deine Waffe sinken.\n",
    Name(WER)+" wirft @WEM einen schmachtenden Blick zu.\n");

 AddDefaultSpell(1, 200, DS_MASS_DAMAGE,
    Name(WER)+" entfacht einen Flammensturm der Liebe in deinem Herzen.\n",
    Name(WER)+" entfacht einen Flammensturm der Liebe in deinem Herzen.\n", ({DT_FIRE, DT_AIR}));

//--Ausruestung------------------------------------------------------------

  SUID;

  CLONEME(ARMOUR "toga" );
  if(!random(5)) {
    CLONEME(ARMOUR "musenschleier" );
  }
  command("trage alles");

}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
