#include "../def.h"

inherit "/p/std/dragons/dragon";
inherit "/std/npc/spells";

private int lastInteraction;

public void create() {
    if(!is_clone(TO)) return;
    ::create();

    SetProp(P_NAME, "Yriskandur");  
    SetProp(P_GENDER, MALE);
    SetProp(P_SHORT, "Yriskandur, der ziegenkoepfige Drache der Freundschaft");
    SetProp(P_NAME_ADJ, 0);
    SetProp(P_ARTICLE, 0);
    SetProp(P_LONG, "Vor dir schlaengelt sich der gewaltige Leib des "
                    "Drachen Yriskandur. Goldene Schuppen glaenzen auf "
                    "seinem schlangengleichen Koerper und werfen das "
                    "Licht in allen Farben des Regenbogens zurueck. "
                    "Sechs kraeftige, klauenbewehrte Beine ragen aus "
                    "seinem langen Rumpf hervor. Anders, als andere "
                    "Drachen hat er keine gewiehnlichen Fluegel, sondern "
                    "durchscheinende Schwingen, die du nur durch das gebrochene "
                    "Licht ihn ihnen erkennen kannst. Am auffaelligsten "
                    "fuer einen Drachen ist jedoch sein Kopf. Am Hals gehen "
                    "die Schuppen in weissgoldenes Fell ueber und enden "
                    "in einem ziegenaehnlichen Kopf aus dem sich zwei goldene "
                    "Hoerner winden. Wache Augen blicken Freundlichen auf "
                    "dich herab. Ueberall aus seinem Koerper wachsen regen"
                    "bogenfarbene Federn.");

    create_default_dragon(5, 10, 1, 50+random(50));

    set_living_name("yriskandur");
    AddId( ({"yriskandur", "ziegendrache", "freundschaftsdrache", "\nyriskandur"}) );
    
    SetProp(P_SIZE, 600);
    SetProp(P_WEIGHT, 5000);
    SetProp(P_ALIGN, 1000);
    SetProp(P_NOMAGIC, 40);
    
    SetProp(P_REJECT, ({REJECT_KEEP, Name(WER, 1)+" sagt: Danke!\n"}));

    SetProp(P_DIE_MSG, " kracht zu Boden und die Erde bebt. Traurigkeit erfuellt dich.\n");
    SetProp(P_MURDER_MSG, "Wer Freundschaft mit Hass begegnet, wird Wut ernten...\n");
    SetProp(P_KILL_NAME, "Yriskandur, der ziegenkoepfige Drache der Freundschaft");

    SetProp(P_SPELLRATE, 80);
    AddDefaultSpell(1, 200, DS_SLOW, 
                    Name(WER)+" nimmt dir deinen Kampfeswillen.\n",
                    Name(WER)+" nimmt @WEM den Kampfeswillen.\n");

    AddSpell(2, 300, 
        Name(WER)+" spiesst dich mit seinen Hoernern auf!\n",
        Name(WER)+" spiesst @WEN mit seinen Hoernern auf!\n",
        DT_PIERCE, ([SP_SHOW_DAMAGE: 1]));

    AddLibrary("/gilden/bardengilde/libs/allgemein.lib", 1);
    AddLibrary(NPC "musen.lib", 6);

    AddInfo( ({"freundschaft", "freund"}),
        "Ich waere gerne dein Freund! Ich biete gerne allen Freundschaft an.", "strahlt: ");

    AddInfo( ({"yriskandur", "drache"}), "Das bin dann ja wohl ich!", "sagt: ");

    AddInfo( ({"band der freundschaft"}), 
      "Das Band der Freundschaft ist ein maechtiges Musikstueck, das deine Seele mit der eines "
      "Freundes verbindet. Durch dieses Band koennt ihr eure Lebenskraft und Magie tauschen. "
      "Wenn ein Barde dieses Lied erlernen will, muss er eine kleine Pruefung der Freundschaft "
      "bestreiten.", "sagt: ");

    AddInfo( ({"pruefung", "pruefung der freundschaft"}),
      "Es handelt sich um ein kleines Raetsel, welches nur zwei Freunde gemeinsam loesen "
      "loesen koennen. Wenn du diese Pruefung mit einem Freund bestreiten willst, muesst "
      "ihr beide hier sein. Dann kann mich einer von euch mittels <beginne pruefung der "
      "freundschaft> die Pruefung beginnen.", "sagt: ");

    SUID;

    AddCmd("biete|biet&yriskandur|drache|ziegendrache&freundschaft&an", "cmd_freundschaft", "Wem willst du was anbieten?\n");
    AddCmd("erneuere|erneuer&freundschaft&mit&yriskandur|drache|ziegendrache", "cmd_erneuern", "Was willst du mit wem erneuern?\n");
    AddCmd("beginne|pruefung|der|freundschaft", "cmd_pruefung", "Was willst du beginnen?\n");

    lastInteraction = time();
}

public int cmd_pruefung() {
    command_me("sag Nun gut, " + TPN + " mit wem willst du diese Pruefung bestreiten?");
    write("[Gib den Namen deines Freundes ein] ");
    input_to("friend_challenge_name");
    return 1;
}

public void friend_challenge_name(string name) {
    object friend, ob1, ob2;
    if(!objectp(friend=find_player(name))) {
        command_me("sag Ich kann diesen Freund leider nicht finden.");
        return;
    }

    if(!present(friend, ENV(TO))) {
        command_me("sag Diese Person ist gar nicht hier.");
        return;
    }

    ob1 = clone_object("/gilden/bardengilde/obj/quest/gs10_freundschaft");
    ob2 = clone_object("/gilden/bardengilde/obj/quest/gs10_freundschaft");

    ob1->setPartner(TP);
    ob2->setPartner(friend);

    if(ob1->move(friend, M_NOCHECK) != 1) {
        command_me("sag " + friend->Name(WER) + ", du kannst das, was ich dir geben will, gerade nicht tragen!");
        return;
    }
    if(ob2->move(TP, M_NOCHECK) != 1){
        command_me("sag " + TP->Name(WER) + ", du kannst das, was ich dir geben will, gerade nicht tragen!");
        return;
    }

    tell_room(ENV(TO), BS(TO->Name(WER) + " gibt " + TP->Name(WER) + " und " + friend->Name(WEM) + 
                       " jeweils eine glaesernen Koerper."), ({TP, friend}));
    tell_object(TP, BS(TO->Name(WER) + " gibt dir einen glaesernen Idokaeder."));
    tell_object(friend, BS(TO->Name(WER) + " gibt dir einen glaesernen Idokaeder."));

    ob1->ResetSides();

    return;
}

public void Attack(object ob) {
    lastInteraction = time();
    ::Attack(ob);
}

public int cmd_erneuern() {
    object fr;
    lastInteraction = time();
    if(!objectp(fr=present("\nyriskandur_freundschaft", TP))) {
        command_me("sag Leider sind wir noch keine Freunde, "+TPN+".");
        return -1;
    }
    command_me("sag Welch eine Freude dich wieder zu sehen, "+TPN+"!");
    tell_object(TP, BS("Deine Freundschaft mit "+Name(WEM)+" wurde erneurt."));
   
    fr->Renew();
    return 1;
}

public int cmd_freundschaft() {
    lastInteraction = time();
    if(present("\nyriskandur_freundschaft", TP)) {
      command_me("sag Aber wir sind doch schon Freunde, "+TPN+".");
      return -1;
    }

    tell_room(ENV(TO), BS(TPN+" bietet " + Name(WEM) + " die Freundschaft an."), ({TP}));
    tell_object(TP, BS("Du bietest " + Name(WEM)+" die Freundschaft an."));
    call_out("freundschaft", 2, TP);
   return 1;
}

public void freundschaft(object pl) {
    object freundschaft;
    lastInteraction = time();
    if(!objectp(pl) || !present(pl, ENV(TO))) return;

    command_me("sag Sehr gerne bin ich dein Freund, " + pl->Name(WER, 1)+".");
    tell_object(pl, BS("Du bist nun mit "+Name(WEM)+" befreundet.\n"));

    freundschaft = clone_object(OBJ "freundschaft");
    if(freundschaft->move(pl, M_NOCHECK|M_GET) != 1) {
        freundschaft->remove(1);
    }
}

public void die(int pd) {
    object killer, ob;
    killer = QueryProp(P_KILLER) || TP;
    if(objectp(killer) && living(killer)) {
        tell_object(killer, BS("Der ewige Fluch der Feindschaft trifft dich, als du "
                            +Name(WEM)+" den Todesstoss versetzt!"));
        ob = clone_object(OBJ "fluch");
        if(ob->move(killer, M_NOCHECK|M_GET) != 1) {
            tell_object(killer, BS("Du bist Fluch gerade noch entgangen!"));
            ob->remove(1);
        } else {
            ob->activate();
        }
    }

    CLONEME(ARMOUR "regenbogenschwingen");
    CLONEME(WEAPON "yriskandur_hoerner");

    return ::die(pd);
}

private void clean_inventory() {
    object *inv;
    int i;

    inv = all_inventory();
    for(i=0;i<sizeof(inv);++i) {
        inv[i]->remove(1);
    }
}

public void reset() {
    if(!is_clone(TO)) return;
    ::reset();

    if(time()-lastInteraction > 3600) {
        tell_room(ENV(TO), BS("Yriskandur erhebt sich in die Luefte und fliegt davon."));
        clean_inventory();
        remove(1);
    }
}
