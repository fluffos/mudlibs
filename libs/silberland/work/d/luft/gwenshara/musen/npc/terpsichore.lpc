#include "../def.h"

inherit NPC "std_muse";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Terpsichore die froehlich im Reigen Tanzende. Muse fuer Chorlyrik und Tanz");
  SetProp(P_LONG,
    "Vor dir steht die Gestalt einer schoenen, jungen Frau. Sie ist leicht "
    "durchscheinend und schwebt leicht ueber dem Boden, als waere sie nicht "
    "ganz real, sondern wueder deiner Fantasie entspringen. Sie befindet "
    "sie sich mitten im ausgelassenen Tanz. Die einen Arm weit ueber dem "
    "Kopf erhoben scheint sie wahrhaftige Freude bei ihrem Reigen zu verspuehren.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Terpsichore");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId(({"terpsichore", "muse", "\ngwenshara_muse", "NOCONTROL", "NOWIMPY"}));
  AddClass( ({ CL_FAIRY, CL_FLYING }) );

  set_living_name("terpsichore");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(37);

  SetProp(P_HANDS, ({" im wilden Reigen tanzend",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON,DT_HOLY})
                    }) );

  SetProp(P_RACE, "Muse");
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 5);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" ist nicht wirklich real und der Gegenstand faellt durch sie hindurch.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_MIND: 0.1, DT_UNHOLY: 0.3, DT_COLD: 0.2,
      // nicht real, darum resistent gegen "realen" Schaden
      DT_SLASH: -0.5, DT_PIERCE: -0.5, DT_BLUDGEON: -0.5,
      DT_SQUEEZE: -0.5, DT_WHIP: -0.5, DT_RIP: -0.5, DT_FIRE: -0.3 ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "tritt aus deinen Gedanken hervor");
  SetProp(P_MMSGOUT, "loest sich in Luft auf");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " verblasst ins Nichts.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Dann tanze ich im Jenseits weiter.");
  SetProp(P_KILL_MSG, "Haettest du dich doch einfach meinem Reigen angeschlossen...");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " hoert dich gar nicht in ihrem Tanz.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 30);

  AddSpell(2, 200,
    Name(WER)+" verwirrt deine Gedanken mit ihrem vielstimmigen Gesang.\n",
    Name(WER)+" verwirrt @WESSEN Gedanken mit ihrem vielstimmgen Gesang.\n",
     DT_SOUND, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 1, DS_ANTIMAGIC,
    Name(WER)+" hypnotisiert dich mit einem wilden Reigen. Deine Konzentration schwindet.\n",
    Name(WER)+" stoert @WESSEN Konzentration mit einem wilden Reigen.\n");

 AddSpell(1, 350,
    Name(WER)+" erfuellt dich mit goettlicher Freude!\n",
    Name(WER)+" erfuellt @WEN mit goettlicher Freude.\n",
    DT_HOLY, ([SP_SHOW_DAMAGE: 1]));

//--Ausruestung------------------------------------------------------------

  SUID;

  CLONEME(ARMOUR "toga" );
  if(!random(5)) {
    CLONEME(ARMOUR "musen_lyra" );
  }
  command("trage alles");

}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
