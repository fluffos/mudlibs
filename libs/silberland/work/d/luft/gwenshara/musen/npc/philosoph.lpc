#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein alter Philosoph sitzt hier auf der Bank");
  SetProp(P_LONG,
    "Ein alter elfischer Philosoph sitzt hier auf der Bank und denkt ueber "
    "den Sinn des Lebens nach. Weit scheint er mit seinen Ueberlegungen "
    "noch nicht gekommen zu sein.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Philosoph");
  SetProp(P_GENDER, MALE);
  AddId(({"\ngwenshara_philosoph", "philosoph", "NOWIMPY"}));
  AddClass( ({ CL_ELF }) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(15+random(5));

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 200);
  SetProp(P_WEIGHT, 65000);
  SetProp(P_ALIGN, 800);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_SIZE, 175);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" sagt: Mit Besitz kann ich nichts anfangen!\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  AddLibrary(NPC "musen.lib", 1);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_MIND: 0.3 ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Der Tod existiert gar nicht!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " fragt: Bist du dir sicher, dass du das ueberhaupt wissen willst?\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 20);

  AddSpell(1, 200,
    Name(WER, 1)+" reduziert dich ad absurdum.\n",
    Name(WER, 1)+" reduziert @Wen ad absurdum.\n",
     DT_MIND, ([SP_SHOW_DAMAGE:1]));

//--Ausruestung------------------------------------------------------------

  SUID;

  CLONEME(ARMOUR "toga" );
  command("trage alles");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
