#include "../def.h"

inherit "std/weapon";

public void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Valkyrenspeer");
  SetProp(P_LONG,
    BS("Ein langer, ausgewogener Speer mit einer hellen, stahlharten Spitze. "
       "Auf dem Schaft sind feine Linien eingearbeitet, die im Licht kurz in "
       "Regenbogenfarben schimmern, bevor sie wieder verblassen."));

  SetProp(P_NAME, "Valkyrenspeer");
  SetProp(P_GENDER, MALE);
  AddId(({ "valkyrenspeer", "speer", "\ngwenshara_valkyrenspeer" }));

  SetProp(P_WEIGHT, 1500);
  SetProp(P_SIZE, 120);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_QUALITY_DECAY, 200);

  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_WC, 150);
  SetProp(P_WC_FIX, 45);
  SetProp(P_DAM_TYPE, ({ DT_PIERCE, DT_LIGHT }));

  SetProp(P_MATERIAL, ([ MAT_STEEL: 85, MAT_MAGIC: 15 ]));
  SetProp(P_INFO, BS("Ein Speer, wie ihn die Valkyren zur Wacht auf dem Regenbogen fuehren."));
}

