#include "../def.h"

inherit "std/armour";

public void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Valkyrenharnisch");
  SetProp(P_LONG,
    BS("Ein heller, sauber gearbeiteter Harnisch, dessen Metall im Licht fast "
       "weiss wirkt. In die Kanten sind dezente Ornamente eingelassen, die "
       "manchmal wie gebrochenes Regenbogenlicht aufblitzen."));

  SetProp(P_NAME, "Harnisch");
  SetProp(P_GENDER, MALE);
  AddId(({ "harnisch", "ruestung", "panzer", "valkyrenharnisch", "\ngwenshara_valkyrenharnisch" }));

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 24);
  SetProp(P_QUALITY_DECAY, 200);

  SetProp(P_WEIGHT, 2500);
  SetProp(P_SIZE, 60);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);

  SetProp(P_MATERIAL, ([ MAT_STEEL: 80, MAT_MAGIC: 20 ]));
  SetProp(P_INFO, BS("Ein Harnisch, wie ihn Valkyren als Wachtkleidung tragen."));
}

