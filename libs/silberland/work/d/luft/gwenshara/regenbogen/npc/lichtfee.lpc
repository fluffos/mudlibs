#include "../def.h"

inherit "std/mnpc";

public void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Lichtfee");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);
  AddId(({ "\ngwenshara_lichtfee", "lichtfee", "fee", "lichtgestalt", "NOWIMPY" }));

  SetProp(P_SHORT, "Eine Lichtfee tanzt ueber den Regenbogen");
  SetProp(P_LONG,
    BS("Eine kleine, fast durchscheinende Fee schwebt ueber dem Lichtband der "
       "Regenbogenbruecke. Sie hinterlaesst winzige Funken, die in allen Farben "
       "aufblitzen und dann wieder vergehen. Mal ist sie ganz nah, mal scheint "
       "sie im naechsten Moment ein Stueck weiter zu tanzen."));

  create_default_npc(8 + random(3));

  SetProp(P_RACE, "Fee");
  SetProp(P_ALIGN, 900);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN, "tanzt heran");
  SetProp(P_MSGOUT, "tanzt davon");

  SetProp(P_MNPC_AREA, ROOM "");
  SetProp(P_MNPC_DEFAULTROOM, ROOM "rb4");
  SetProp(P_MNPC_WAIT, ({ 8, 20, 12 }));
  SetProp(P_MNPC_ACTIVE_TIME, 3600);
  SetProp(P_MNPC_FLAGS, MOV_MOVES|MOV_BACKWARDS|MOV_OUTDOORS);
}

