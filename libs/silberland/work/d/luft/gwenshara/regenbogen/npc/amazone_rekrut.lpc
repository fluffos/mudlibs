#include "../def.h"

inherit "std/mnpc";

public void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Amazone");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ, ({"junge"}));
  AddId(({ "\ngwenshara_amazone_rekrut", "amazone", "rekrutin", "kriegerin", "NOWIMPY" }));

  SetProp(P_SHORT, "Eine junge Amazone patrouilliert hier");
  SetProp(P_LONG,
    BS("Eine junge Amazone in leichter Ausruestung bewegt sich mit wachem Blick "
       "durch den Innenhof. Ihre Schritte sind diszipliniert, auch wenn ihr "
       "noch die gelassene Sicherheit alter Veteraninnen fehlt."));

  create_default_npc(10 + random(3));

  SetProp(P_RACE, "Mensch");
  SetProp(P_ALIGN, 700);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN, "kommt auf Patrouille heran");
  SetProp(P_MSGOUT, "setzt ihre Patrouille fort");

  SetProp(P_MNPC_AREA, ROOM "hof/");
  SetProp(P_MNPC_DEFAULTROOM, ROOM "hof/hof_m");
  SetProp(P_MNPC_WAIT, ({ 10, 20, 10 }));
  SetProp(P_MNPC_ACTIVE_TIME, 3600);
  SetProp(P_MNPC_FLAGS, MOV_MOVES|MOV_BACKWARDS|MOV_OUTDOORS);
}
