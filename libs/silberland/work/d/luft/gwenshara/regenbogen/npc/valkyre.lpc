#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

public void create() {
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Valkyre haelt hier Wache");
  SetProp(P_LONG,
    BS("Eine hochgewachsene Kriegerin in hellem Harnisch steht hier und "
       "beobachtet aufmerksam jeden Schritt auf der Regenbogenbruecke. "
       "Ihre Augen wirken ruhig, aber unnachgiebig, und ihre Haltung laesst "
       "keinen Zweifel daran, dass sie jeden Eindringling aufzuhalten weiss."));

  SetProp(P_NAME, "Valkyre");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);
  AddId(({ "\ngwenshara_valkyre", "valkyre", "valkyrie", "waechterin", "kriegerin", "NOWIMPY" }));

  create_default_npc(22 + random(4));

  SetProp(P_RACE, "Mensch");
  SetProp(P_ALIGN, 800);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 10);

  SetProp(P_HANDS, ({
    " mit ihrem Speer",
    QueryProp(P_HANDS)[1],
    ({ DT_PIERCE })
  }));

  SetProp(P_MSGIN, "landet auf der Bruecke");
  SetProp(P_MSGOUT, "schreitet davon");

  SetProp(P_SPELLRATE, 15);
  AddSpell(1, 120,
    Name(WER, 1) + " ruft einen kurzen Blitz aus dem Himmel.\n",
    Name(WER, 1) + " ruft einen kurzen Blitz aus dem Himmel auf @WEN.\n",
    DT_MAGIC, ([ SP_SHOW_DAMAGE: 1 ]));

  SUID;
  CLONEME(ARMOUR "valkyrenharnisch");
  CLONEME(WEAPON "valkyrenspeer");
  command("trage alles");
  command("zuecke valkyrenspeer");
}

