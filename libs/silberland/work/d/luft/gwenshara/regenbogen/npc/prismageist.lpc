#include "../def.h"

inherit "std/mnpc";

public void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Prismageist");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  AddId(({ "\ngwenshara_prismageist", "prismageist", "geist", "prisma", "lichtgeist", "NOWIMPY" }));

  SetProp(P_SHORT, "Ein Prismageist wandert ueber den Regenbogen");
  SetProp(P_LONG,
    BS("Diese Gestalt wirkt, als bestaende sie aus gebrochenem Licht. In seinem "
       "Inneren wandern die Farben wie in einem Prisma, und mit jedem Schritt "
       "verschieben sich die Toene von Rot bis Violett. Er bewegt sich ruhig, "
       "fast feierlich, als wuerde er den Regenbogen selbst bewachen."));

  create_default_npc(15 + random(5));

  SetProp(P_RACE, "Geist");
  SetProp(P_ALIGN, 600);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 5);

  SetProp(P_MSGIN, "schimmert heran");
  SetProp(P_MSGOUT, "schimmert davon");

  SetProp(P_MNPC_AREA, ROOM "");
  SetProp(P_MNPC_DEFAULTROOM, ROOM "rb4");
  SetProp(P_MNPC_WAIT, ({ 15, 30, 15 }));
  SetProp(P_MNPC_ACTIVE_TIME, 3600);
  SetProp(P_MNPC_FLAGS, MOV_MOVES|MOV_BACKWARDS|MOV_OUTDOORS);
}
