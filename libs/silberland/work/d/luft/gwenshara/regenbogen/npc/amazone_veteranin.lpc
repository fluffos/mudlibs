#include "../def.h"

inherit "std/mnpc";

public void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Amazone");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ, ({"veterane"}));
  AddId(({ "\ngwenshara_amazone_veteranin", "amazone", "veteranin", "offizierin", "NOWIMPY" }));

  SetProp(P_SHORT, "Eine veterane Amazone patrouilliert mit strengem Blick");
  SetProp(P_LONG,
    BS("Eine veterane Amazone patrouilliert hier mit der Ruhe einer Kriegerin, "
       "die schon viele Schlachten gesehen hat. Ihr Blick erfasst jeden Winkel "
       "des Hofes, als wuerde sie staendig eine unsichtbare Formation ordnen."));

  create_default_npc(24 + random(6));

  SetProp(P_RACE, "Mensch");
  SetProp(P_ALIGN, 900);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 10);

  SetProp(P_MSGIN, "erscheint auf Patrouille");
  SetProp(P_MSGOUT, "schreitet weiter");

  SetProp(P_MNPC_AREA, ROOM "hof/");
  SetProp(P_MNPC_DEFAULTROOM, ROOM "hof/hof_m");
  SetProp(P_MNPC_WAIT, ({ 10, 25, 10 }));
  SetProp(P_MNPC_ACTIVE_TIME, 3600);
  SetProp(P_MNPC_FLAGS, MOV_MOVES|MOV_BACKWARDS|MOV_OUTDOORS);
}
