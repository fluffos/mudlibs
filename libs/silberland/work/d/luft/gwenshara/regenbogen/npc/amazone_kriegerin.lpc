#include "../def.h"

inherit "std/mnpc";

public void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Amazone");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ, ({"erfahrene"}));
  AddId(({ "\ngwenshara_amazone_kriegerin", "amazone", "kriegerin", "waechterin", "NOWIMPY" }));

  SetProp(P_SHORT, "Eine erfahrene Amazone haelt hier Patrouille");
  SetProp(P_LONG,
    BS("Eine erfahrene Amazone bewegt sich ruhig und aufmerksam durch den Hof. "
       "Ihre Haltung ist entspannt, doch jeder Blick sitzt. Offenbar kennt sie "
       "die Wege hier oben auswendig."));

  create_default_npc(16 + random(5));

  SetProp(P_RACE, "Mensch");
  SetProp(P_ALIGN, 800);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 5);

  SetProp(P_MSGIN, "kommt auf Patrouille an");
  SetProp(P_MSGOUT, "geht weiter auf Patrouille");

  SetProp(P_MNPC_AREA, ROOM "hof/");
  SetProp(P_MNPC_DEFAULTROOM, ROOM "hof/hof_m");
  SetProp(P_MNPC_WAIT, ({ 8, 18, 10 }));
  SetProp(P_MNPC_ACTIVE_TIME, 3600);
  SetProp(P_MNPC_FLAGS, MOV_MOVES|MOV_BACKWARDS|MOV_OUTDOORS);
}
