#include "../def.h"

inherit "/std/room";

public void create() {
  ::create();

  SetProp(P_INT_SHORT, "Am Ende des Regenbogens");
  SetProp(P_INT_LONG,
    BS("Hier beruehrt das Licht der Regenbogenbruecke die Welt. Der violette "
       "Schimmer sammelt sich zu einer schmalen Schwelle aus Farbe und Glanz, "
       "die im feuchten Wind flimmert. Unter dir hoerst du bereits das Rauschen "
       "der Wellen, und salzige Luft steigt herauf. Nach Norden fuehrt der Weg "
       "wieder hinauf auf den Regenbogen, nach Sueden kannst du hinab an den "
       "Strand steigen."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_AIR]));

  AddDetail(({"ende"}),
    BS("Hier endet die Regenbogenbruecke und beginnt die Welt darunter. Es ist "
       "ein Uebergang zwischen Farbe und Strand."));
  AddDetail(({"uebergang"}),
    BS("Der Uebergang ist spuerbar: Von festem Licht zu salziger Luft, von "
       "Himmel zu Strand."));
  AddDetail(({"welt"}),
    BS("Die Welt liegt unter dir, verborgen hinter Wolken und Wind. Hier oben "
       "beruehrt sie der Regenbogen nur an einer schmalen Schwelle."));
  AddDetail(({"wolken", "wolke", "wolkenmeer"}),
    BS("Wolken treiben unter dir vorbei. Sie verbergen die Welt und lassen den "
       "Uebergang noch unwirklicher wirken."));
  AddDetail(({"violett", "schimmer"}),
    BS("Der violette Schimmer ist hier besonders dicht. Er sammelt sich wie ein "
       "Schleier aus Licht und Farbe."));
  AddDetail(({"schleier"}),
    BS("Der Schleier aus violettem Licht legt sich wie eine duenne Schicht ueber "
       "die Luft und flimmert im Wind."));
  AddDetail(({"schicht"}),
    BS("Die Schicht aus violettem Licht liegt wie ein Schleier ueber der Luft."));
  AddDetail(({"wind"}),
    BS("Ein feuchter Wind streicht hier herauf und laesst den Schimmer flimmern."));
  AddDetail(({"luft", "salz", "salzige", "salziger"}),
    BS("Die Luft riecht salzig und frisch. Sie steigt vom Strand herauf."));
  AddDetail(({"weg", "norden", "sueden", "strand"}),
    BS("Der Weg fuehrt nach Norden wieder hinauf auf den Regenbogen und nach "
       "Sueden hinab an den Strand."));
  AddDetail(({"himmel"}),
    BS("Ueber dir liegt nur Himmel und das violette Leuchten des Regenbogens."));
  AddDetail(({"leuchten"}),
    BS("Das Leuchten ist hier violett und dicht. Es wirkt weniger wie Licht, "
       "mehr wie eine Substanz, die in der Luft steht."));
  AddDetail(({"substanz"}),
    BS("Das Leuchten wirkt wie eine Substanz: etwas, das nicht nur scheint, "
       "sondern den Ort fuellt."));
  AddDetail(({"boden"}),
    BS("Der Boden besteht hier aus festem Licht, das an seinem Ende in die "
       "wirkliche Welt uebergeht."));
  AddDetail(({"grenze"}),
    BS("Hier verlaeuft eine Grenze: Zwischen Regenbogen und Welt, zwischen "
       "Leuchten und Strand."));

  AddDetail(({"schwelle", "glanz", "farbe", "licht", "grenze", "tuer", "tuere", "tor"}),
    BS("Das Ende des Regenbogens ist keine Tuer und kein Tor, sondern eine "
       "duenne Grenze, die sich wie ein Schleier ueber die Luft legt."));
  AddDetail(({"wellen", "rauschen", "meer", "meeresluft"}),
    BS("Das Rauschen steigt von unten herauf. Die Luft riecht salzig und frisch."));
  AddDetail(({"regenbogen", "regenbogenbruecke", "bruecke", "band"}),
    BS("Von hier aus wirkt die Bruecke wie ein Band, das sich in den Himmel "
       "zurueckzieht."));

  AddExit("nordoben", ROOM "rb7");
  AddExit("unten", "/d/wasser/aaliyah/edynia/room/amazon1");
}
