#include "../def.h"

inherit "/std/room";

public void create() {
  ::create();

  SetProp(P_INT_SHORT, "Auf der Regenbogenbruecke");
  SetProp(P_INT_LONG,
    BS("Unter dir schimmert die Bruecke nun in einem tiefen Gruen, als laege "
       "ein stiller Wald im Licht verborgen. Das Wolkenmeer unter dir wirkt "
       "naeher und bewegter; manchmal reisst eine Luecke auf und du siehst "
       "nur Tiefe. Im Sueden wirkt das Licht bereits kuehler, als wuerde die "
       "Farbe des Regenbogens langsam in Blau uebergehen."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 17, ENV_TERRAIN: TT_AIR]));

  AddDetail(({"gruen", "licht"}),
    BS("Das gruene Licht wirkt beruhigend. Es gibt dem unirdischen Weg etwas "
       "Vertrautes."));
  AddDetail(({"farbe"}),
    BS("Hier dominiert ein tiefes Gruen. Es wirkt wie ein stiller Wald, der "
       "sich in Licht verwandelt hat."));
  AddDetail(({"wald"}),
    BS("Der Wald ist nur ein Bild: Das gruene Licht erinnert dich an stilles "
       "Laub und Schatten zwischen Baeumen."));
  AddDetail(({"laub"}),
    BS("Das gruene Leuchten erinnert an frisches Laub, obwohl hier oben kein "
       "einziger Baum waechst."));
  AddDetail(({"baeumen", "baum"}),
    BS("Du siehst keine echten Baeume. Das Licht weckt nur die Erinnerung an "
       "Wald und Laub."));
  AddDetail(({"baeume"}),
    BS("Echte Baeume gibt es hier keine. Nur das gruene Licht erinnert dich an "
       "Baeume und Wald."));
  AddDetail(({"schatten"}),
    BS("Schatten gibt es hier kaum, doch das Gruen erinnert an Schatten zwischen "
       "Baeumen."));
  AddDetail(({"bild"}),
    BS("Vieles hier ist Bild und Eindruck: Farbe, Licht und die Erinnerung an "
       "Wald und Erde."));
  AddDetail(({"bilder"}),
    BS("Die Bilder in deinem Kopf entstehen aus Farbe und Licht: Wald, Laub und "
       "Schatten, obwohl hier oben nichts davon wirklich existiert."));
  AddDetail(({"eindruck"}),
    BS("Der Eindruck von Wald entsteht allein durch das gruene Leuchten unter "
       "deinen Fuessen."));
  AddDetail(({"erinnerung"}),
    BS("Die Erinnerung an Wald und Erde wird durch das gruene Licht geweckt, "
       "obwohl du hier oben nur Himmel und Wolken hast."));
  AddDetail(({"vertrautes"}),
    BS("Das Gruen fuehlt sich vertraut an, als haette es etwas von Erde und "
       "Wald in diese Hoehe getragen."));
  AddDetail(({"erde"}),
    BS("Von Erde ist hier nichts zu sehen, und doch erinnert das Gruen dich an "
       "Wald und Boden."));
  AddDetail(({"hoehe"}),
    BS("Du befindest dich in grosser Hoehe ueber den Wolken. Selbst vertraute "
       "Bilder wie Wald und Erde wirken hier fremd."));
  AddDetail(({"bruecke", "regenbogenbruecke", "regenbogen", "regenbogens"}),
    BS("Der Regenbogen ist hier eine Bruecke. Das Lichtband traegt dich sicher "
       "ueber das Wolkenmeer."));
  AddDetail(({"lichtband", "band"}),
    BS("Das Lichtband ist fest genug, um dich zu tragen, und doch schimmert es "
       "staendig in feinen Nuancen."));
  AddDetail(({"leuchten"}),
    BS("Das gruene Leuchten ist sanft und beruhigend. Es flutet den Weg, ohne "
       "zu blenden."));
  AddDetail(({"nuancen"}),
    BS("In den Nuancen des Gruens siehst du alles von hellem Schimmer bis zu "
       "dunklem Waldton."));
  AddDetail(({"schimmer"}),
    BS("Der Schimmer ist mal hell, mal dunkel, je nachdem wie das Licht unter "
       "deinen Fuessen gerade spielt."));
  AddDetail(({"waldton", "waldtoen", "waldtoene"}),
    BS("Der dunkle Waldton ist nur eine der vielen Nuancen, die das gruene Licht "
       "annehmen kann."));
  AddDetail(({"fuessen", "fuesse"}),
    BS("Unter deinen Fuessen liegt das gruene Lichtband wie fester Boden."));
  AddDetail(({"kopf"}),
    BS("In deinem Kopf entstehen Bilder von Wald und Laub, obwohl du hier oben "
       "nur Licht, Himmel und Wolken hast."));
  AddDetail(({"weg"}),
    BS("Der Weg fuehrt als gruener Abschnitt der Regenbogenbruecke weiter nach "
       "Norden oder Sueden."));
  AddDetail(({"abschnitt"}),
    BS("Dies ist der gruene Abschnitt des Regenbogens. Von hier aus geht es "
       "weiter in kuehlere Farben."));
  AddDetail(({"boden"}),
    BS("Der Boden unter dir ist kein Stein, sondern festes Licht. Er ist glatt "
       "und traegt dich ohne zu nachzugeben."));
  AddDetail(({"stein"}),
    BS("Hier gibt es keinen Stein. Der Regenbogen ersetzt ihn durch festes "
       "Licht, das sich wie Boden anfuehlt."));
  AddDetail(({"wolkenmeer", "wolken", "meer"}),
    BS("Das Wolkenmeer liegt dicht unter dir. Es wirkt wie eine weisse See, "
       "die manchmal Luecken reisst und Tiefe preisgibt."));
  AddDetail(({"see"}),
    BS("Das Wolkenmeer wirkt wie eine weisse See, die langsam unter dir "
       "dahintreibt."));
  AddDetail(({"himmel"}),
    BS("Ueber dir spannt sich ein weiter Himmel. Gegen das Gruen wirkt er noch "
       "kuehler und klarer."));
  AddDetail(({"tiefe", "luecke", "luecken"}),
    BS("Du schaust lieber nicht zu lange hinunter."));
  AddDetail(({"sueden", "blau"}),
    BS("Das Gruen geht im Sueden langsam in ein kuehles Blau ueber."));

  AddExit("norden", ROOM "rb3");
  AddExit("sueden", ROOM "rb5");
}
