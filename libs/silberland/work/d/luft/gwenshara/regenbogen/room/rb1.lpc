#include "../def.h"

inherit "/std/room";

public void create() {
  ::create();

  SetProp(P_INT_SHORT, "Auf der Regenbogenbruecke");
  SetProp(P_INT_LONG,
    BS("Du stehst auf einem schimmernden Band aus Licht, das sich wie eine "
       "Bruecke ueber das Wolkenmeer spannt. Unter deinen Fuessen leuchtet "
       "das Licht in einem tiefen Rot, als waere ein Stueck des Regenbogens "
       "zu Stein geworden. Im Norden liegt die Wolkenstadt Liliandor, waehrend "
       "im Sueden fern ein heller Glanz zu erkennen ist."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_AIR]));

  AddDetail(({"bruecke", "regenbogenbruecke", "band", "lichtband", "bogen", "weg"}),
    BS("Die Regenbogenbruecke ist ein festes Band aus gebuendeltem Licht. Es "
       "traegt dich muhelos und schimmert in sanften Uebergaengen."));
  AddDetail(({"uebergaengen", "uebergang", "uebergaenge"}),
    BS("Die Farben gehen fliessend ineinander ueber, ohne scharfe Kanten. "
       "Manchmal wirkt es, als wuerde das Licht selbst langsam atmen."));
  AddDetail(({"farben"}),
    BS("Die Farben des Regenbogens sind hier besonders klar. Sie fliessen in "
       "sanften Uebergaengen ineinander."));
  AddDetail(({"kanten"}),
    BS("Du findest keine scharfen Kanten. Alles ist weiches Leuchten und "
       "fliessender Uebergang."));
  AddDetail(({"rot", "licht"}),
    BS("Hier dominiert ein sattes, warmes Rot, das im leichten Wind zu flimmern "
       "scheint."));
  AddDetail(({"wind"}),
    BS("Der Wind ist hier oben kuehl und klar. Er streicht ueber das Lichtband, "
       "ohne es zu zerreissen."));
  AddDetail(({"boden", "stein"}),
    BS("Obwohl du auf einem Band aus Licht stehst, wirkt es unter deinen Fuessen "
       "fast wie fester Boden. Es traegt dich, als waere es zu Stein geworden."));
  AddDetail(({"schimmer", "leuchten"}),
    BS("Der Schimmer des Lichtbandes ist staendig in Bewegung. Mal leuchtet er "
       "kraeftiger auf, mal wird er sanfter, ohne je ganz zu verblassen."));
  AddDetail(({"bewegung"}),
    BS("Alles hier wirkt in Bewegung: Licht, Farben und Glanz. Nichts steht "
       "still, und doch bleibt der Weg fest unter deinen Fuessen."));
  AddDetail(({"fuessen", "fuesse"}),
    BS("Unter deinen Fuessen pulsiert das rote Licht. Es ist fest genug, um dich "
       "zu tragen, und dennoch leicht wie ein Schimmer."));
  AddDetail(({"wolken", "wolkenmeer", "meer", "wolkenluft"}),
    BS("Unter dir zieht ein endloses Wolkenmeer dahin. Du koenntest schwoeren, "
       "dass es ganz leise rauscht."));
  AddDetail(({"himmel"}),
    BS("Ueber dir spannt sich ein weiter, klarer Himmel. Die Luft ist so rein, "
       "dass selbst entfernte Farben scharf wirken."));
  AddDetail(({"luft", "wolkenluft"}),
    BS("Die Luft hier oben ist kuehl, klar und duenn. Jeder Atemzug fuehlt sich "
       "frisch an."));
  AddDetail(({"atemzug", "hauch", "wolkenluft"}),
    BS("Jeder Atemzug ist hier oben kalt und klar. Du schmeckst dabei ein "
       "Hauch von feuchter Wolkenluft."));
  AddDetail(({"liliandor", "wolkenstadt", "stadt"}),
    BS("Die Wolkenstadt Liliandor liegt im Norden. Von hier oben wirkt sie wie "
       "ein filigranes Spielzeug aus Glas und Gold."));
  AddDetail(({"spielzeug"}),
    BS("Von hier wirkt die Stadt klein und filigran, als koennte man sie in die "
       "Hand nehmen. Natuerlich ist das nur eine Taeuschung der Hoehe."));
  AddDetail(({"hand"}),
    BS("Nur bildlich gesprochen: Von hier oben wirkt die Wolkenstadt so klein, "
       "als koennte sie in eine Hand passen."));
  AddDetail(({"hoehe"}),
    BS("Die grosse Hoehe macht entfernte Dinge klein. Das ist eine Taeuschung, "
       "aber eine eindrucksvolle."));
  AddDetail(({"taeuschung"}),
    BS("Die Hoehe und das klare Licht taeuschen Groessenverhaeltnisse vor. "
       "Was fern ist, wirkt winzig."));
  AddDetail(({"groessenverhaeltnisse"}),
    BS("Die Groessenverhaeltnisse wirken verschoben: Nahe Dinge sind gross und "
       "scharf, ferne Dinge klein und fast wie gemalt."));
  AddDetail(({"glas"}),
    BS("Vieles in Liliandor scheint aus Glas zu bestehen. Im Licht funkelt es, "
       "als waere die ganze Stadt ein Mosaik."));
  AddDetail(({"mosaik"}),
    BS("Im Sonnenlicht wirkt die Stadt wie ein Mosaik aus Glasflaechen, das "
       "in allen Farben glitzert."));
  AddDetail(({"glasflaechen", "flaechen", "flaeche"}),
    BS("Aus der Ferne siehst du viele Glasflaechen, die das Sonnenlicht "
       "zurueckwerfen und die Stadt wie ein Mosaik wirken lassen."));
  AddDetail(({"sonnenlicht", "blitze", "blitz"}),
    BS("Das Sonnenlicht faellt klar und ungehindert auf Glas und Gold und laesst "
       "alles in der Ferne funkeln."));
  AddDetail(({"gold"}),
    BS("Goldene Akzente blitzen an Toren, Daechern und Verzierungen auf. Von hier "
       "oben wirkt es wie ein warmes Leuchten in der Ferne."));
  AddDetail(({"akzente"}),
    BS("Mit Akzenten sind die goldenen Details gemeint, die an der Stadt "
       "aufblitzen."));
  AddDetail(({"toren", "tor"}),
    BS("An manchen Toren der Wolkenstadt blitzt Gold im Licht auf."));
  AddDetail(({"daechern", "dach"}),
    BS("Einige Daecher scheinen mit goldenen Kanten oder Verzierungen versehen "
       "zu sein."));
  AddDetail(({"daecher", "flaechen", "flaeche"}),
    BS("Von hier oben erkennst du nur die Daecher als helle Flaechen, auf denen "
       "Gold und Glas im Sonnenlicht aufblitzen."));
  AddDetail(({"verzierungen"}),
    BS("Verzierungen aus Gold und Glas geben der Wolkenstadt ihr Funkeln."));
  AddDetail(({"ferne", "entfernung", "entfernung"}),
    BS("Die Ferne laesst vieles kleiner wirken, als es ist. Das Licht traegt "
       "die Konturen weit ueber das Wolkenmeer."));
  AddDetail(({"dinge", "dingen", "teil", "bild", "bildes"}),
    BS("Ferne Dinge wirken hier oben wie Spielzeug: klein, hell und weit "
       "entfernt, als waeren sie Teil eines Bildes."));
  AddDetail(({"details", "einzelheiten", "einzelheit", "entfernung"}),
    BS("Details sind aus dieser Entfernung schwer zu erkennen. Du siehst vor allem "
       "Formen, Konturen und Funkeln."));
  AddDetail(({"glanz", "sueden"}),
    BS("Im Sueden zeichnet sich ein fremder, goettlicher Glanz ab. Dort scheint "
       "ein Bauwerk in den Himmel zu ragen."));
  AddDetail(({"bauwerk"}),
    BS("Du erkennst nur Umrisse und Glanz. Das Bauwerk wirkt weit entfernt, doch "
       "unverkennbar maechtig."));
  AddDetail(({"umrisse", "linien", "linie", "formen", "form"}),
    BS("Du erkennst nur Umrisse: Linien und Konturen im hellen Glanz, ohne dass "
       "du Details ausmachen kannst."));
  AddDetail(({"konturen", "linien", "linie", "formen", "form"}),
    BS("Die Konturen zeichnen sich als helle Linien gegen den Himmel ab. Sie sind "
       "deutlich genug, um Formen zu ahnen, aber nicht, um Einzelheiten zu sehen."));
  AddDetail(({"funkeln", "blitze", "blitz"}),
    BS("Ueberall funkelt es: Glas, Gold und gebrochenes Licht werfen kleine "
       "Blitze zurueck, die kurz aufglimmen und wieder verschwinden."));
  AddDetail(({"stueck", "regenbogens"}),
    BS("Es wirkt, als haette jemand ein Stueck des Regenbogens aus dem Himmel "
       "geschnitten und als Bruecke ueber das Wolkenmeer gelegt."));

  AddExit("nordunten", ANSCHLUSS);
  AddExit("sueden", ROOM "rb2");
}
