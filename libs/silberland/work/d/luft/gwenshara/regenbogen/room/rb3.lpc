#include "../def.h"

inherit "/std/room";

public void create() {
  ::create();

  SetProp(P_INT_SHORT, "Auf der Regenbogenbruecke");
  SetProp(P_INT_LONG,
    BS("Das Licht unter dir wird zu einem strahlenden Gelb. In der Ferne, "
       "weiter im Sueden, wirkt das Ende der Bruecke heller und zugleich "
       "fremder, als wuerde der Regenbogen an einem anderen Ort wieder aus "
       "der Welt auftauchen. Ueber dir spannt sich der Himmel klar und weit."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 17, ENV_TERRAIN: TT_AIR]));

  AddDetail(({"gelb", "licht"}),
    BS("Das gelbe Licht ist fast blendend, doch es tut den Augen nicht weh."));
  AddDetail(({"augen"}),
    BS("Deine Augen muessen sich an das strahlende Gelb gewoehnen, doch das "
       "Licht ist erstaunlich sanft."));
  AddDetail(({"bruecke", "regenbogenbruecke", "regenbogen", "lichtband", "band"}),
    BS("Hier ist der Regenbogen eine Bruecke aus Licht. Das Gelb flutet den "
       "Weg und laesst alles um dich herum heller wirken."));
  AddDetail(({"fuessen", "fuesse"}),
    BS("Unter deinen Fuessen fuehlst du die feste, aber lebendige Flaeche des "
       "Lichtbandes. Es traegt dich ohne jedes Schwanken."));
  AddDetail(({"flaeche"}),
    BS("Die Flaeche des Lichtbandes ist fest und glatt. Sie wirkt fast wie ein "
       "Boden, obwohl sie nur aus Licht besteht."));
  AddDetail(({"schwanken"}),
    BS("Du spuerst kein Schwanken. Der Regenbogen traegt dich sicher, als sei "
       "er ein fester Weg."));
  AddDetail(({"weg"}),
    BS("Der Weg ist ein Band aus Licht, das dich sicher traegt. Du kannst ihm "
       "nach Norden folgen oder weiter nach Sueden gehen."));
  AddDetail(({"boden"}),
    BS("Unter dir ist kein Stein und kein Holz, sondern festes Licht. Es "
       "traegt dich wie ein sicherer Boden."));
  AddDetail(({"stein", "holz"}),
    BS("Hier gibt es weder Stein noch Holz. Der Regenbogen selbst bildet den "
       "Weg unter deinen Fuessen."));
  AddDetail(({"ort"}),
    BS("Dieser Ort liegt hoch ueber der Welt. Nur Himmel, Wind und das Licht "
       "des Regenbogens begleiten dich."));
  AddDetail(({"ende", "glanz", "ferne"}),
    BS("In der Ferne siehst du nur einen hellen Glanz, als wuerde sich der "
       "Regenbogen dort in etwas anderes verwandeln."));
  AddDetail(({"himmel"}),
    BS("Der Himmel ist hier oben so klar, dass du glaubst, jede einzelne "
       "Luftstroemung sehen zu koennen."));
  AddDetail(({"luftstroemung", "luftstroemungen", "stroemung", "stroemungen"}),
    BS("Die Luftstroemungen sind hier oben so klar, dass du sie fast sehen "
       "kannst: feine Bewegungen, die das Licht ganz leicht zittern lassen."));
  AddDetail(({"bewegungen"}),
    BS("Die Bewegungen der Luft lassen das Lichtband fein vibrieren. Es ist "
       "nur ein sanftes Zittern, aber du bemerkst es deutlich."));
  AddDetail(({"zittern"}),
    BS("Das Zittern ist nur ein feines Vibrieren im Lichtband, ausgeloest durch "
       "Wind und Luftstroemungen."));
  AddDetail(({"vibrieren"}),
    BS("Das Vibrieren ist ein kaum merkliches Zittern, das durch Wind und "
       "Luftstroemungen entsteht."));
  AddDetail(({"wind"}),
    BS("Der Wind ist hier oben kuehl und trocken. Er streicht ueber den "
       "Regenbogen und traegt das Gelb als warmen Schein davon."));
  AddDetail(({"schein"}),
    BS("Der Schein des gelben Lichtes liegt wie ein warmer Schimmer ueber allem, "
       "was du siehst."));
  AddDetail(({"luft"}),
    BS("Die Luft ist klar und kuehl. Sie bewegt sich in feinen Stroemungen, die "
       "das Lichtband zum Flimmern bringen."));
  AddDetail(({"flimmern", "schimmer"}),
    BS("Das Flimmern und der Schimmer entstehen, wenn Wind und Tropfen das Licht "
       "brechen und es in feinen Nuancen tanzen lassen."));
  AddDetail(({"welt"}),
    BS("Die Welt liegt weit unter dir, verborgen hinter Wolken. Von hier oben "
       "wirkt alles fern und still."));
  AddDetail(({"wolken", "wolke", "meer"}),
    BS("Wolken ziehen weit unter dir vorbei und verdecken die Welt. Von hier "
       "oben wirken sie wie ein weiches Meer."));

  AddExit("norden", ROOM "rb2");
  AddExit("sueden", ROOM "rb4");

  AddItem(NPC "valkyre", REFRESH_DESTRUCT);
  AddItem(NPC "lichtfee", REFRESH_DESTRUCT);
}
