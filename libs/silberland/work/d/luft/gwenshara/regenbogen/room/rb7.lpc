#include "../def.h"

inherit "/std/room";

public void create() {
  ::create();

  SetProp(P_INT_SHORT, "Auf der Regenbogenbruecke");
  SetProp(P_INT_LONG,
    BS("Unter dir leuchtet der Regenbogen in einem satten Violett. Vor dir "
       "scheint der Lichtbogen in die Ferne abzutauchen und in einem fremden "
       "Glanz zu enden. Zwischen dem Leuchten glaubst du bereits das Rauschen "
       "von Wellen zu hoeren, als wuerde dieser Weg bis an einen Strand fuehren."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN: TT_AIR]));

  AddDetail(({"violett", "licht"}),
    BS("Das violette Licht wirkt wie die Grenze zwischen Traum und Wirklichkeit. "
       "Es flimmert in feinen Uebergaengen, als waere es lebendig."));
  AddDetail(({"grenze"}),
    BS("Hier wirkt alles wie eine Grenze: Zwischen Himmel und Wolken, zwischen "
       "Farbe und Dunkelheit, zwischen Traum und Wirklichkeit."));
  AddDetail(({"dunkelheit"}),
    BS("Die Dunkelheit ist hier nur ein Eindruck. Sie liegt im Violett, ohne "
       "das Leuchten zu verschlucken."));
  AddDetail(({"eindruck"}),
    BS("Vieles hier ist Eindruck: Dunkelheit im Licht, Traum in der "
       "Wirklichkeit und ein fernes Rauschen unter dem Violett."));
  AddDetail(({"farbe"}),
    BS("Die Farbe ist sattes Violett. Sie wirkt tief und weich zugleich."));
  AddDetail(({"traum"}),
    BS("Das Violett erinnert an Traum: weich, flimmernd und ohne harte Kanten."));
  AddDetail(({"kanten"}),
    BS("Es gibt kaum Kanten. Alles geht fliessend ineinander ueber und flimmert "
       "im Violett."));
  AddDetail(({"wirklichkeit"}),
    BS("Trotz allem Flimmern ist dieser Ort Wirklichkeit genug, um dich zu "
       "tragen. Der Weg bleibt fest unter deinen Fuessen."));
  AddDetail(({"ort"}),
    BS("Dieser Ort ist der letzte Abschnitt des Regenbogens. Hier mischen sich "
       "Stille, Wind und fernes Rauschen."));
  AddDetail(({"abschnitt"}),
    BS("Dies ist der violette Abschnitt des Regenbogens, kurz bevor er zu "
       "seinem Ende absteigt."));
  AddDetail(({"fuessen", "fuesse"}),
    BS("Unter deinen Fuessen ist das violette Lichtband glatt und fest. Es "
       "traegt dich sicher."));
  AddDetail(({"lichtband", "band"}),
    BS("Das Lichtband ist die Substanz des Regenbogens. Hier ist es violett "
       "und flimmert in feinen Uebergaengen."));
  AddDetail(({"substanz"}),
    BS("Die Substanz hier ist Licht: fest genug, um dich zu tragen, und doch "
       "staendig in Bewegung."));
  AddDetail(({"uebergaengen", "uebergang", "uebergaenge"}),
    BS("Die Uebergaenge im Violett sind feiner als in den anderen Farben. Das "
       "Licht scheint hier zu atmen."));
  AddDetail(({"leuchten"}),
    BS("Das Leuchten ist hier satt und tief. Es wirkt weniger wie Licht, mehr "
       "wie ein eigener Zustand der Luft."));
  AddDetail(({"zustand"}),
    BS("Das Leuchten wirkt wie ein eigener Zustand: als waere die Luft selbst "
       "in Farbe getaucht."));
  AddDetail(({"luft"}),
    BS("Die Luft ist kuehl und still. Sie traegt das Leuchten, als gehoere es "
       "zu ihr."));
  AddDetail(({"regenbogen", "regenbogens"}),
    BS("Der Regenbogen ist hier ein begehbarer Lichtbogen. In dieser Farbe "
       "wirkt er besonders fremd und schoen."));
  AddDetail(({"regenbogenbruecke", "bruecke"}),
    BS("Die Regenbogenbruecke traegt dich als violetter Abschnitt ueber die "
       "Wolken. Sie fuehrt nach Norden zurueck und nach Sueden ihrem Ende entgegen."));
  AddDetail(({"lichtbogen", "bogen"}),
    BS("Der Lichtbogen senkt sich weiter nach unten. Du spuerst, dass er sich "
       "dem Ende der Regenbogenbruecke naehert."));
  AddDetail(({"ferne"}),
    BS("In der Ferne liegt ein fremder Glanz und das leise Versprechen von "
       "Wellenrauschen."));
  AddDetail(({"versprechen"}),
    BS("Das Versprechen ist das ferne Rauschen: Als wuerde hinter dem Ende des "
       "Regenbogens eine andere Welt warten."));
  AddDetail(({"rauschen", "wellenrauschen", "wellen"}),
    BS("Das Rauschen der Wellen ist noch fern, aber deutlich. Es mischt sich "
       "mit dem Wind und dem leisen Flimmern des Lichts."));
  AddDetail(({"flimmern"}),
    BS("Das Flimmern ist hier feiner als anderswo. Es ist ein leises Zittern "
       "im Violett, das nie ganz stillsteht."));
  AddDetail(({"zittern"}),
    BS("Das Zittern ist nur ein feines Vibrieren im Lichtband. Es gehoert zum "
       "Flimmern dieser Farbe."));
  AddDetail(({"vibrieren"}),
    BS("Das Vibrieren ist ein kaum merkliches Zittern im Lichtband, das durch "
       "Wind und Luftbewegung entsteht."));
  AddDetail(({"himmel"}),
    BS("Ueber dir spannt sich ein weiter Himmel. Gegen das Violett wirkt er "
       "fast schwarzblau und unendlich."));
  AddDetail(({"boden"}),
    BS("Der Boden unter dir ist festes, violettes Licht. Er ist glatt und "
       "traegt dich ohne zu schwanken."));
  AddDetail(({"wolken", "wolke", "wolkenmeer"}),
    BS("Wolken liegen weit unter dir. Von hier oben wirken sie wie ein "
       "geraeuschloses Meer aus Weiss."));
  AddDetail(({"meer"}),
    BS("Das Wolkenmeer liegt weit unter dir und wirkt wie ein stilles Meer."));
  AddDetail(({"weiss"}),
    BS("Das Weiss der Wolken ist weich und matt. Es leuchtet nicht, sondern "
       "nimmt das Licht nur auf."));
  AddDetail(({"welt"}),
    BS("Die Welt liegt unter den Wolken und ist von hier aus kaum zu sehen. "
       "Nur das Rauschen und das Leuchten begleiten dich."));
  AddDetail(({"weg"}),
    BS("Der Weg fuehrt nach Norden zurueck ueber den Regenbogen und nach Sueden "
       "hinab zum Ende des Lichtbogens."));
  AddDetail(({"ende", "glanz", "strand", "wellen"}),
    BS("Je naeher du dem Ende des Lichtbogens kommst, desto deutlicher wird "
       "das ferne Rauschen. Es wirkt, als wuerde die Regenbogenbruecke an "
       "einem Strand auslaufen."));
  AddDetail(({"stille", "wind"}),
    BS("Selbst der Wind scheint hier langsamer zu werden."));

  AddExit("norden", ROOM "rb6");
  AddExit("suedunten", ROOM "regenbogen_ende");

  AddItem(NPC "valkyre", REFRESH_DESTRUCT, 2);
}
