#include "../def.h"

inherit "/std/room";

public void create() {
  ::create();

  SetProp(P_INT_SHORT, "Auf der Regenbogenbruecke");
  SetProp(P_INT_LONG,
    BS("Das Licht unter dir verdunkelt sich zu einem tiefen Indigo. Es wirkt "
       "nicht mehr wie Tageslicht, sondern wie Abenddaemmerung in fester Form. "
       "Der Wind ist hier oben kuehl und klar, und das Wolkenmeer unter dir "
       "schimmert nur noch in fernen Reflexen."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN: TT_AIR]));

  AddDetail(({"indigo", "licht"}),
    BS("Das Indigo ist dunkel und ruhig. Es wirkt, als wuerde es Geraeusche "
       "verschlucken und Gedanken schaerfen."));
  AddDetail(({"abenddaemmerung"}),
    BS("Das Indigo wirkt wie Abenddaemmerung: still, dunkel und klar zugleich."));
  AddDetail(({"tageslicht"}),
    BS("Hier oben erinnert kaum noch etwas an Tageslicht. Das Indigo nimmt dem "
       "Himmel seine grelle Helligkeit."));
  AddDetail(({"helligkeit"}),
    BS("Die Helligkeit ist gedämpft. Das Indigo schluckt das grelle Licht und "
       "laesst alles ruhiger wirken."));
  AddDetail(({"farbe"}),
    BS("Die Farbe ist tiefes Indigo: dunkel, klar und fast wie Abend."));
  AddDetail(({"abend"}),
    BS("Das Indigo wirkt wie Abend: still, kuehl und ein wenig entrueckt."));
  AddDetail(({"form"}),
    BS("Das Licht hat hier eine feste Form angenommen: Es bildet einen Weg aus "
       "Indigo, der dich traegt."));
  AddDetail(({"weg"}),
    BS("Der Weg fuehrt als indigo-farbenes Lichtband weiter nach Norden oder "
       "nach Sueden."));
  AddDetail(({"lichtband", "band"}),
    BS("Das Lichtband ist fest und glatt. Es traegt dich sicher, auch wenn es "
       "im Indigo nur noch gedämpft schimmert."));
  AddDetail(({"boden"}),
    BS("Der Boden unter dir ist gebuendeltes Licht. Er ist glatt und fest, als "
       "waere er aus Farbe geformt."));
  AddDetail(({"flaeche"}),
    BS("Unter dir liegt das Wolkenmeer wie eine endlose Flaeche, die nur noch "
       "in fernen Reflexen schimmert."));
  AddDetail(({"reflexen", "reflex"}),
    BS("Die Reflexe auf den Wolken sind schwach und fern. Sie wirken, als wuerde "
       "das Licht weit unter dir nur noch leise antworten."));
  AddDetail(({"gedanken", "gedanke"}),
    BS("Das Indigo wirkt beruhigend und schaerft zugleich die Gedanken. Du "
       "kommst unwillkuerlich ins Sinnieren."));
  AddDetail(({"sinnieren"}),
    BS("Du merkst, wie du zu sinnieren beginnst. Das dunkle Licht macht jeden "
       "Gedanken einen Hauch deutlicher."));
  AddDetail(({"hauch"}),
    BS("Nur ein Hauch von Licht bleibt in dieser Farbe uebrig. Gerade das macht "
       "das Indigo so ruhig."));
  AddDetail(({"geraeusche", "geraeusch"}),
    BS("Geraeusche scheinen hier oben zu verschwinden. Nur der Wind bleibt, "
       "und selbst der klingt gedämpft im Indigo."));
  AddDetail(({"himmel"}),
    BS("Der Himmel ueber dir wirkt in diesem Indigo tiefer und naeher, als "
       "wuerde er dich einhuellen."));
  AddDetail(({"wolken", "wolkenmeer"}),
    BS("Das Wolkenmeer wirkt von hier aus wie eine endlose, langsam atmende "
       "Flaeche."));
  AddDetail(({"wind"}),
    BS("Der Wind ist kalt, aber nicht unangenehm. Er fuehlt sich sauber an."));

  AddExit("norden", ROOM "rb5");
  AddExit("sueden", ROOM "rb7");
}
