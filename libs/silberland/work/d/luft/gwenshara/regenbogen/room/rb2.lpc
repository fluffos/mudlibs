#include "../def.h"

inherit "/std/room";

public void create() {
  ::create();

  SetProp(P_INT_SHORT, "Auf der Regenbogenbruecke");
  SetProp(P_INT_LONG,
    BS("Der Lichtbogen unter dir wechselt in ein warmes Orange. Das Leuchten "
       "ist hier heller und lebendiger, als wuerde die Bruecke selbst atmen. "
       "Der Wind traegt feine Tropfen aus der Wolkendecke herauf und laesst "
       "das Licht in winzigen Funken tanzen."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_AIR]));

  AddDetail(({"orange", "licht"}),
    BS("Ein sanftes Orange umspielt deine Schritte und taucht die Welt in "
       "warmes Leuchten."));
  AddDetail(({"bruecke", "regenbogenbruecke", "lichtbogen", "bogen"}),
    BS("Die Regenbogenbruecke ist ein Lichtbogen, der sich wie ein fester Weg "
       "ueber das Wolkenmeer spannt. Hier schimmert er in warmem Orange."));
  AddDetail(({"regenbogen"}),
    BS("Der Regenbogen ist hier nicht nur ein Anblick, sondern ein begehbarer "
       "Weg aus Licht."));
  AddDetail(({"anblick"}),
    BS("Der Anblick eines begehbaren Regenbogens ist ebenso schoen wie "
       "unwirklich."));
  AddDetail(({"lichtband"}),
    BS("Das Lichtband ist die Substanz der Bruecke. Es schimmert in Orange und "
       "traegt dich, als waere es fest."));
  AddDetail(({"substanz"}),
    BS("Die Substanz des Weges ist Licht: gebuendelt, fest und dennoch "
       "schimmernd."));
  AddDetail(({"weg"}),
    BS("Der Weg fuehrt als Lichtbogen ueber das Wolkenmeer. Du kannst ihm "
       "nach Sueden folgen oder nach Norden zurueckgehen."));
  AddDetail(({"wolkenmeer"}),
    BS("Unter dir liegt das Wolkenmeer wie eine weisse, bewegte Flaeche. Von "
       "hier oben wirkt es endlos."));
  AddDetail(({"flaeche"}),
    BS("Aus der Hoehe wirken die Wolken wie eine einzige, weiche Flaeche, die "
       "sich langsam bewegt."));
  AddDetail(({"bewegung"}),
    BS("Alles hier ist in Bewegung: Funken, Tropfen und das flirrende Licht. "
       "Nur die Bruecke selbst bleibt fest."));
  AddDetail(({"boden"}),
    BS("Der 'Boden' unter dir besteht aus gebuendeltem Licht. Er ist fest "
       "genug, um jeden deiner Schritte zu tragen."));
  AddDetail(({"schritte", "schritt"}),
    BS("Deine Schritte lassen das Licht kurz aufflackern, als wuerde die Bruecke "
       "auf dich reagieren."));
  AddDetail(({"leuchten"}),
    BS("Das Leuchten ist hier besonders lebendig. Es wirkt, als wuerde die "
       "Bruecke selbst atmen."));
  AddDetail(({"funken", "funke", "tropfen"}),
    BS("Die Funken sind nur Lichtbrechungen, doch sie wirken fast greifbar."));
  AddDetail(({"lichtbrechungen", "lichtbrechung"}),
    BS("Die Funken sind Lichtbrechungen, die durch Tropfen und Bewegung im "
       "Lichtband entstehen."));
  AddDetail(({"regen"}),
    BS("Die feinen Tropfen im Wind riechen nach Regen. Oben auf dem Regenbogen "
       "ist das nur ein Hauch davon."));
  AddDetail(({"wolken", "wolkendecke", "decke"}),
    BS("Unter dir liegt eine dichte Wolkendecke. Von hier oben sieht sie weich "
       "aus, doch sie traegt dich nicht."));
  AddDetail(({"wind"}),
    BS("Der Wind ist kalt und klar. Er traegt den Geruch von Regen und ferner "
       "Hoehe."));
  AddDetail(({"geruch"}),
    BS("Du riechst Regen und frische Wolkenluft, vermischt mit dem ozonartigen "
       "Hauch von gebrochenem Licht."));
  AddDetail(({"luft"}),
    BS("Die Luft ist hier oben kuehl und feucht. Sie traegt den Geruch von "
       "Regen und Wolkenluft."));
  AddDetail(({"wolkenluft"}),
    BS("Die Wolkenluft ist frisch und feucht. Sie mischt sich mit dem Geruch "
       "von Regen und dem Flimmern des Lichts."));
  AddDetail(({"flimmern"}),
    BS("Das Flimmern entsteht aus Tropfen und Licht. Es wirkt wie ein "
       "staendiger Tanz winziger Funken."));
  AddDetail(({"wetter"}),
    BS("Du riechst Regen und spuerst den Wind. Das Wetter ist hier oben "
       "nahe, auch wenn die Welt weit entfernt wirkt."));
  AddDetail(({"hauch"}),
    BS("Nur ein Hauch von Regen liegt in der Luft, doch er ist deutlich genug, "
       "um dich an fernes Wetter zu erinnern."));
  AddDetail(({"hoehe"}),
    BS("Du befindest dich hoch ueber den Wolken. Die Hoehe macht die Welt "
       "unter dir fern und still."));
  AddDetail(({"himmel"}),
    BS("Ueber dir spannt sich ein weiter Himmel. Hier oben wirkt er klarer "
       "und naeher als anderswo."));
  AddDetail(({"welt"}),
    BS("Die Welt wirkt von hier oben weit entfernt. Unter dir liegen Wolken, "
       "ueber dir nur Himmel und Licht."));

  AddExit("norden", ROOM "rb1");
  AddExit("sueden", ROOM "rb3");
}
