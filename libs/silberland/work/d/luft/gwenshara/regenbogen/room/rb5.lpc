#include "../def.h"

inherit "/std/room";

public void create() {
  ::create();

  SetProp(P_INT_SHORT, "Auf der Regenbogenbruecke");
  SetProp(P_INT_LONG,
    BS("Das Licht unter dir wird zu einem kuehlen Blau, das an den Raendern "
       "in ein dunkleres Schimmern uebergeht. Das Blau ist klar und kalt, als "
       "waere es aus Eislicht geformt. Weiter im Sueden scheint sich die Farbe "
       "noch einmal zu vertiefen, bevor der Regenbogen sein Ende erreicht."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN: TT_AIR]));

  AddDetail(({"blau", "licht"}),
    BS("Das Licht ist kalt und klar. Es schimmert, als waere es aus Eis und "
       "Abenddaemmerung zugleich geformt."));
  AddDetail(({"abenddaemmerung"}),
    BS("Das Licht erinnert an Abenddaemmerung: klar, kuehl und ein wenig "
       "entrueckt."));
  AddDetail(({"daemmerung"}),
    BS("Die Daemmerung liegt in diesem Blau, als waere der Abend in die Farbe "
       "eingeschmolzen."));
  AddDetail(({"abend"}),
    BS("Der Abend steckt in dieser Farbe: kuehl, still und tief wie ein "
       "fern werdender Himmel."));
  AddDetail(({"eis", "eislicht"}),
    BS("Eislicht ist nur ein Bild fuer die Kaelte dieses Blaus. Es wirkt hart "
       "und klar, ohne wirklich aus Eis zu bestehen."));
  AddDetail(({"bild"}),
    BS("Viele Eindruecke hier sind nur ein Bild: Eislicht, Abendhimmel und "
       "Daemmerung, geformt aus Farbe."));
  AddDetail(({"eindruecke", "eindruck"}),
    BS("Die Eindruecke sind stark: Kaelte, Daemmerung und ein stilles Blau, das "
       "an Eis und Abendhimmel erinnert."));
  AddDetail(({"kaelte"}),
    BS("Die Kaelte dieses Blaus ist deutlich. Sie wirkt wie Eis, obwohl du "
       "nur Licht unter deinen Fuessen hast."));
  AddDetail(({"boden"}),
    BS("Der Boden unter dir ist festes Licht. Er ist glatt wie gefrorenes Wasser "
       "und traegt dich sicher."));
  AddDetail(({"wasser"}),
    BS("Das Licht ist so glatt und kalt, dass es dich an gefrorenes Wasser "
       "erinnert."));
  AddDetail(({"raendern", "rand"}),
    BS("An den Raendern wird das Blau dunkler und geht in ein tieferes Schimmern "
       "ueber."));
  AddDetail(({"himmel"}),
    BS("Ueber dir spannt sich ein weiter Himmel. Gegen das Blau wirkt er fast "
       "silbern und fern."));
  AddDetail(({"regenbogen"}),
    BS("Der Regenbogen ist hier ein begehbarer Weg. In diesem Abschnitt dominiert "
       "ein kuehles Blau, das in dunklere Toene uebergeht."));
  AddDetail(({"abschnitt"}),
    BS("Dies ist der blaue Abschnitt des Regenbogens, kurz bevor die Farben "
       "noch dunkler werden."));
  AddDetail(({"toene", "toenen", "ton"}),
    BS("Die Toene des Blaus reichen von klarem Eislicht bis zu dunklem "
       "Abendhimmel."));
  AddDetail(({"weg"}),
    BS("Der Weg fuehrt als Lichtband weiter nach Norden oder tiefer nach Sueden."));
  AddDetail(({"lichtband", "band"}),
    BS("Das Lichtband ist der Weg selbst: fest, glatt und in kuehlem Blau "
       "schimmernd."));
  AddDetail(({"fuessen", "fuesse"}),
    BS("Unter deinen Fuessen ist das Lichtband glatt und fest. Es traegt dich, "
       "als waerst du auf gefrorenem Stein unterwegs."));
  AddDetail(({"stein"}),
    BS("Hier ist kein echter Stein, doch das Licht ist so fest, dass es sich "
       "unter deinen Fuessen wie Stein anfuehlt."));
  AddDetail(({"farbe"}),
    BS("Die Farbe ist kuehl und klar. Sie wirkt wie Blau, das an den Raendern "
       "in Abendhimmel uebergeht."));
  AddDetail(({"abendhimmel"}),
    BS("Im Sueden wirkt das Licht wie Abendhimmel: dunkler, tiefer und stiller."));
  AddDetail(({"ende"}),
    BS("Du spuerst, dass der Regenbogen nicht ewig so weitergeht. Irgendwo im "
       "Sueden muss sein Ende liegen."));
  AddDetail(({"tiefe", "schimmern", "sueden"}),
    BS("Im Sueden wirkt das Licht dunkler, fast wie Abendhimmel. Der Regenbogen "
       "scheint dort in eine tiefere Farbe ueberzugehen."));
  AddDetail(({"stille", "wind"}),
    BS("Selbst der Wind scheint hier langsamer zu werden."));

  AddExit("norden", ROOM "rb4");
  AddExit("sueden", ROOM "rb6");

  AddItem(NPC "prismageist", REFRESH_DESTRUCT);
}
