#include "../def.h"

// Dieser Raum kann als Zwischenraum fuer Reisen ueber das Silberland genutzt werden.
// zB von der BArdengilde

inherit "std/room";

void create() {
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Im Himmel ueber dem Silberland");
  SetProp(P_INT_LONG,
    "Du schwebst weit ueber dem Silberland. Wenn du nicht weisst, wie du "
    "hier her gekommen bist, solltest Du einen Magier um Hilfe bitten.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 5, ENV_TERRAIN: TT_AIR]) );
}