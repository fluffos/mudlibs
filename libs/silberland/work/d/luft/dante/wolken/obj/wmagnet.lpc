//wolkenmagnet
//um wolken anzulocken

inherit "std/thing"; 

#include "../def.h"

void create()
{ 
  if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Wolkenmagnet");
  SetProp(P_LONG,
  "Dieser Magnet ist etwas ganz besonderes. Dante hat ihn erfunden, "
  "weiss aber selbst nicht wie er funktioniert. Angeblich soll er, "
  "der Magnet, nicht Dante, Gewitterwolken anlocken koennen...");
   

  SetProp(P_NOGET,0);
  SetProp(P_VALUE,10);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Wolkenmagnet");
     SetProp(P_MATERIAL,([MAT_IRON:100,MAT_COBALT:10, MAT_MISC_MAGIC:100,MAT_MISC_MAGNETIC:100]));  
     
  SetProp(P_INFO, "Um Spannung zu erzeugen muss man den Magneten an seinen Haaren reiben.\n");
  
  AddId(({"magnet","wolkenmagnet"}));
  SetProp(P_NOBUY, 1);
  AddCmd(({"reibe","reib"}),"wolke");

}

int wolke(string str)
{
  notify_fail("Was willst Du mit dem Wolkenmagneten machen?\n");
  if (!str) return 0;

  if (str=="magnet an haar" ||str=="magnet an haaren"
     	||str=="magnet am haar" ||str=="magnet an haare"
     	||str=="wolkenmagnet an haare" ||str=="wolkenmagnet an haaren"
     	||str=="wolkenmagnet am haar" ||str=="wolkenmagnet an haare" )
  {
    if (( environment(TP)==find_object(ROOM "pneu")))
    {
      write( BS("Du reibst den Wolkenmagneten an Deinen Haaren, Funken spritzen "
        "von Deinem Kopf in den Himmel, der Magnet zerplatzt und...\n"));
    
      say(BS(CAP_TPN+" reibt einen Wolkenmagneten an seinen Haaren und....\n"));
      clone_object(NPC "gwolke")->move( ROOM "pneu",M_GO);
      RemoveCmd(({"reibe","reib"}));
      call_out("remove", 0);
      return 1;
    }
    else
    {
      notify_fail(BS("Du reibst den Wolkenmagneten an Deinem Haar, aber ausser "
          "einem Jucken Deiner Kopfhaut passiert nichts."));
      return 0;
    }
  }
  return 0;
}

