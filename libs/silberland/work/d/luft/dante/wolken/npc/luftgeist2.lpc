

inherit "std/mnpc";

#include "../def.h"

#include "/gilden/bardengilde/barden_extern.h"
inherit "/gilden/bardengilde/obj/quest/bard_small_combatspell_teacher";

void create()
{
  int i;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein durchsichtiger grosser Luftgeist");
  SetProp(P_LONG, BS(
        "Der durchsichtige Luftgeist hat keine Gestalt. Er ist nur eine schwebende, fast "
        "nicht zu erkennende Masse aus blaeulich-weisser Luft."));

  SetProp(P_NAME, "Luftgeist");
  SetProp(P_GENDER, MALE);
  AddId( ({"geist", "luftgeist"}) );
  AddDetail(({"gestalt"}),
      "Wie schon erwaehnt, er hat keine...");
  AddDetail(("luft"),
      "Die Luft ist blaeulich-weiss und kaum zu erkennen.");
  create_default_npc(25);
  AddDetail(("masse"),
      "Die Luft steigt auf und ab und hin und her...");
  SetProp(P_HANDS, ({" mit einem gewaltigem Luftstoss", 170+random(20),({ DT_AIR}) }));
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 400+random(200));
  SetProp(P_ALIGN, 400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WEIGHT, 2000);
  AddInfo(DEFAULT_INFO, "blaest Dir freundlich ins Gesicht.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
        "Durch den Luftgeist faellt alles hindurch...\n"}));
  SetProp(P_DIE_MSG, " loest sich buchstaeblich in Luft auf.\n");
  SetProp(P_INFO, ("Der grosse Luftgeist besteht aus Luft.\n"));
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE_STRENGTHS, ([
        DT_FIRE: -0.7, DT_SLASH: -0.3, DT_POISON: -0.5, DT_RIP: -0.3,
        DT_HOLY: -0.5, DT_ACID: -0.5, DT_TERROR: -0.5, DT_BLUDGEON: -0.3,
        DT_MAGIC: 1, DT_SOUND: 1]));

  SetProp(P_MMSGIN, "schwebt herein");
  SetProp(P_MMSGOUT, "schwebt nach oben");
  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");

  SetProp(P_NOMAGIC, 10);
  SetProp(P_SPELLRATE, 70);
  AddSpell(5, 400, 
      "Der grosse Luftgeist blaest Dir Luft ins Gesicht.\n",
      "Der grosse Luftgeist blaest @WEM Luft ins Gesicht.\n",
      DT_AIR, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(2, 600, 
      "Der grosse Luftgeist wirft Dich mit einer Boehe fast um.\n",
      "Der grosse Luftgeist wirft @WEN mit einer Boehe fast um.\n",
      DT_AIR, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 800,
      "Der grosse Luftgeist entfacht einen Wirbelwind ueber Dir.\n",
      "Der grosse Luftgeist entfacht einen Wirbelwind ueber @WEM.\n",
      DT_AIR, ([SP_SHOW_DAMAGE:1]));

  SetChats(4, ({
        "Der grosse Luftgeist schwebt nach oben...\n",
        "Der grosse Luftgeist schwebt nach unten...\n",
        "Der grosse Luftgeist verschwindet kurz hinter einer Wolke.\n",
        "Der grosse Luftgeist scheint voellig durchsichtig zu sein.\n",
        "Der grosse Luftgeist grinst Dich freundlich an.\n",
        "Der grosse Luftgeist verschwindet, taucht aber hinter Dir wieder auf.\n",
        "Der grosse Luftgeist sagt: Magst Du Wolken ?\n",
        "Der grosse Luftgeist schimmert blaeulich...\n",
        "Der grosse Luftgeist  schimmert leicht weisslich...\n"}));
  SetAttackChats(20, ({
        "Der grosse Luftgeist sagt: Das war ein Fehler, Du Unwissender.\n",
        "Der grosse Luftgeist versucht Dich zu entmaterialisieren.\n",
        "Der grosse Luftgeist lacht Dich aus.\n",
        "Der grosse Luftgeist sagt: Verschinde von hier!.\n",
        "Du beginnst zu taummeln.\n",
        "Der grosse Luftgeist lacht: Mein kleiner Bruder zu stark fuer Dich!\n",
        "Du bekommst kaum noch Luft...\n"}));

  SUID;
  CLONEME(WEAPON"lschwert");
  command("zuecke alles");

  AddInfo("dante",
      "sagt: Dante ist ein Luftikus!\n");   
  AddInfo(({"luft"}),
      "sagt: Ich liebe die Luft...\n");
  AddInfo("wolken",
      "sagt: Die Wolken sind meine Heimat.\n");
  AddInfo("wolke",
      "sagt: Ich bin fast eine Wolke...");   

  initialize_bard_spell_teacher(BARD_GROUP_SARRIAN);
}
