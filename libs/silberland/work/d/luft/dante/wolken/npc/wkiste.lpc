// kiste von dante wolken!!!97 2.10.
//verbessert 98

inherit "std/npc";

#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine gefluegelte Kiste");
  SetProp(P_LONG, BS(
    "Diese Kiste ist wirklich sehr merkwuerdig. Sie hat Fluegel und scheint "
    "hier oben herum zu schweben."));
  SetProp(P_NAME, "Kiste");
  SetProp(P_GENDER, FEMALE);
  AddId(("kiste"));
  SetProp(P_INFO, "Die Kiste erscheint Dir merkwuerdig. \n");
  SetProp(P_TRANSPARENT, 0);
  AddDetail("fluegel",
  "Die Fluegel scheinen auch aus Holz zu sein.");
  AddDetail("holz",
  "Leicht muss das Holz auf jeden Fall sein...");
  create_default_npc(8);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit lautem Geknirsche",150+random(50),DT_TERROR}));
  SetProp(P_MAX_HP, 150+random(50));
  SetProp(P_BODY, 30+random(10));
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp( P_RESISTANCE_STRENGTHS, ([DT_MAGIC:1, DT_FIRE:1, DT_SLASH:1]) );
  SetProp(P_NOMAGIC,5);
  SetProp(P_MSGIN, "wird von Dantes Knecht hereingetragen");
  SetProp(P_MSGOUT, "wird von Dantes Knecht");
  SetProp(P_MMSGIN, "wird von Dantes Sklavinnen hereingetragen");
  SetProp(P_MMSGOUT, "wird von Dantes Sklavinnen weggetragen");
  SetProp(P_RACE, "Moebeltuecke");//?
  SetProp(P_DIE_MSG,  " zerbricht in 1000 Stuecke.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Feigling! Schlaegt eine Kiste!");
  SetProp(P_KILL_NAME, "Eine kleine Kiste");
  SetProp(P_KILL_MSG, "Schwaechling! Schaem Dich!");

  AddInfo(DEFAULT_INFO, "knirscht nur vor sich hin.\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Die Kiste knirscht zufrieden.\n" }) );


  SetChats(3, ({
  "Die Kiste schwebt herum.\n",
  "Die Kiste schwebt nach oben.\n",
  "Die Kiste schwebt nach unten.\n",
  "Die Kiste schlaegt mit ihren Fluegeln.\n",
  "Die Kiste klappert...\n",
  "Die Kiste kommt Dir etwas seltsam vor.\n",
  "Die Kiste scheint zu leben.\n",
  "Die Kiste seufzt.\n",
  "Die Kiste knirscht laut.\n"}) );

  SUID;
  CLONEME(OBJ "wmagnet" );
}
