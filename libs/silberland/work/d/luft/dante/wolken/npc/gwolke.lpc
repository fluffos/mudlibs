void spell_friends(object enemy, int damage, mixed dam_type)
{
  object ob;

  switch(random(100))
  {

    case 0 .. 30 :
      tell_object(enemy,
          "Deine Lage wird immer bedrohlicher!\n");
      break;

    case 31 .. 70 : 

      ob=clone_object(NPC "gwolke2"); 
      ob->move(environment(enemy), M_GO);
      break;

    case 71 .. 90:

      ob=clone_object(NPC "gwolke2"); 
      ob->move(environment(enemy), M_GO);
      ob=clone_object(NPC "gwolke2"); 
      ob->move(environment(enemy), M_GO);
      break;

    case 91 .. 100:
      ob=clone_object(NPC "gwolke2"); 
      ob->move(environment(enemy), M_GO);
      ob=clone_object(NPC "gwolke2"); 
      ob->move(environment(enemy), M_GO);
      ob=clone_object(NPC "gwolke2"); 
      ob->move(environment(enemy), M_GO);

      // ich weiss das hier is muell also net grad elegant aber ich hab vergessen
      //wie mans somacht das 3 oder 2 kommen ohne das doppelt zu schreiben
      // und ich hab auch keine lust im mom zu suchen bzw zu denken:)))

  }

}


//spieler killt wolke


void die(int poisondeath)
{

  write("\n"
      "Ploetzlich faellt ein grosser Gegenstand aus den Wolken...\n");
  clone_object(ARMOUR "wolkensch")->move(MENV, M_NOCHECK);

  write_file(LOG "npc.kills",
      ctime()+": "
      +((TP->QueryProp(P_FROG))?CAP(getuid(TP)):TP->name(WEN))
      +" killt die Gewitterwolke.\n");
  ::die(poisondeath);
}

//npc killt spieler

void NotifyPlayerDeath(object player, object killer, int lostexp)

{
  write_file(LOG "npc.deads",
      ctime()+": Die Gewitterwolke hat "
      +((TP->QueryProp(P_FROG))?CAP(getuid(TP)):TP->name(WEN))
      +" umgebracht.\n");
}

