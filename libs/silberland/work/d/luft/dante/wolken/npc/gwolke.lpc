
//eine gemeine wolke von dante
inherit "std/npc";

#include "../def.h"

void init()
{
  ::init();
  if (TP && TP->id("GWOLKE") ) AddDefender(TP);
}



void create()
{
  object ob;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine grosse, dunkle, boese Gewitterwolke");
  SetProp(P_LONG, BS(
        "Diese maechtige Gewitterwolke haengt drohend am Himmel. Ihre dunkle Farbe verheisst "
        "nichts Gutes. Vielleicht solltest Du sie besser nicht belaestigen."));
  SetProp(P_NAME, "Gewitterwolke");
  SetProp(P_NAME_ADJ, "gross");
  AddAdjective("grosse");

  SetProp(P_GENDER, FEMALE);
  AddId( ({"gewitterwolke", "wolke", "GWOLKE"}) );
  set_living_name("wolke");

  AddDetail(({"farbe"}),
      "Schwarz schwebt sie um Dich herum...");
  create_default_npc(25);
  SetProp(P_HANDS, ({" mit einem gewaltigem Blitz", 300+random(20),(DT_LIGHTNING)}));
  SetProp(P_RACE, "Wolke");
  SetProp(P_SIZE, 10000+random(200));
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WEIGHT, 200);
  SetProp(P_INFO, "Die Wolke koennte heimtueckisch sein...\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
        "Durch die Wolke faellt alles hindurch...\n"}));
  SetProp(P_DIE_MSG, " entschwebt in die unendlichen Weiten des Himmels.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE, ({ DT_FIRE,DT_SLASH,DT_POISON,DT_HOLY,DT_ACID,DT_TERROR,DT_BLUDGEON}));
  SetProp(P_AGGRESSIVE, 0.1);

  SetProp(P_MMSGIN, "schwebt drohend herein");
  SetProp(P_MMSGOUT, "schwebt in die Wolken davon");
  SetProp(P_MSGIN, "schwebt drohend herein");
  SetProp(P_MSGOUT, "schwebt tobend davon");
  SetProp(P_MURDER_MSG, "Das naechste Mal geh lieber zu einer Schaefchenwolke, %s!");
  SetProp(P_KILL_NAME, "Eine boesartige Gewitterwolke");
  SetProp(P_KILL_MSG, "schleudert einen Blitz in den zuckenden Leichnam.");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1 ]));

  SetChats(5, ({
        "Die grosse Gewitterwolke schwebt nach oben.\n",
        "Die grosse Gewitterwolke schwebt nach unten.\n",
        "Kleine Blitze schiessen aus der grossen Gewitterwolke hervor.\n",
        "Es donnert laut.\n",
        "Die Luft flimmert...\n",
        "Die Gewitterwolke wird immer dunkler.\n",
        "Lautes Knistern ist aus der grossen Gewitterwolke zu hoeren.\n"}));

  SetProp(P_NOMAGIC, 10);
  SetProp(P_SPELLRATE, 80);
  AddSpell(2, 700, 
      "Die Luft um Dich herum scheint zu gluehen.\n",
      "Die Luft um @WEN scheint zu gluehen.\n",
      DT_FIRE, ([SP_SHOW_DAMAGE:1]));
  AddSpell(3, 500, 
      "Der Luftdruck laesst Deinen Schaedel fast platzen.\n",
      "Der Luftdruck laesst @WESSEN Schaedel fast platzen.\n",
      DT_AIR, ([SP_SHOW_DAMAGE:1]));
  AddSpell(4, 500, 
      "Ein gewaltiger Donner droehnt auf Dich herab.\n",
      "Ein gewaltiger Donner droehnt auf @WEN herab.\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(2, 700, 
      "Gleissende Blitze schlagen neben Dir ein.\n",
      "Gleissende Blitze schlagen neben @WEM ein.\n",
      DT_LIGHTNING, ([SP_SHOW_DAMAGE:1]));
  AddSpell(4, 600,
      "Schwerer Regen prasselt auf Dich herab.\n",
      "Schwerer Regen prasselt auf @WEN herab.\n",
      DT_WATER, ([SP_SHOW_DAMAGE:1]));
  AddSpell(3, 700,
      "Sturmwinde blasen Dich fast fort...\n",
      "Sturmwinde blasen @WEN fast fort...\n",
      DT_AIR ,([SP_SHOW_DAMAGE:1]));
  AddSpell(3, 1,
      "Der Himmel ueber Dir verduestert sich immer mehr...\n",
      "Der Himmel ueber @WEM verduestert sich immer mehr...\n",
      DT_MAGIC, "spell_friends");


  AddInfo("dante",
      "sagt: Dante ist ein Luftikus!\n");   
  AddInfo(({"luft"}),
      "sagt: Ich liebe die Luft...\n");
  AddInfo("wolken",
      "sagt: Die Wolken sind meine Heimat.\n");
  ob=clone_object("/gilden/druidenzirkel/armour/elementarring");
  ob->set_ring_element("luft");
  ob->move(this_object(), M_NOCHECK);


}

void InformDefend(object enemy)
{
  Kill(enemy);
}



//int PreventFollow(object dest)
