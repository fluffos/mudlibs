

inherit "std/mnpc";

#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein rasender Orkandaemon");
  SetProp(P_LONG, (
    "Der Orkandaemon hat eigentlich keine richtige Gestalt, er ist viel mehr "
    "eine tobende alles verwuestende Luftmasse."));
  SetProp(P_NAME, "Orkandaemon");
  SetProp(P_GENDER, MALE);
  AddId( ({"orkan", "daemon","orkandaemon"}) );
  AddDetail(({"luft","luftmasse","masse"}),
  "Sie rast immer zu im Kreis und vernichtet alles was sich ihr in den Weg stellt.");
  AddDetail(({"gestalt"}),
    "Aehnlich einem Zyklonenauge rasen hier Winde immer zu im Kreis.\n");
    AddDetail(("wind"),
    "Der Wind zerzaust Dein Haar und wirft Dich fast zu Boden.\n");
  create_default_npc(23);
  SetProp(P_HANDS, ({" mit einem Windstoss", 210+random(20),({DT_UNHOLY,DT_AIR, DT_TERROR}) }));
  SetProp(P_XP, QueryProp(P_XP)*3/2);
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 200+random(20));
  SetProp(P_ALIGN, -900);
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_MAX_HANDS, 2);
  AddInfo(DEFAULT_INFO, "blaest Dich einfach um.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT, 
     "Der Orkandaemon blaest @WEN weit fort.\n"}));
  SetProp(P_DIE_MSG, " verschwindet wieder in die Dimension der Daemonen.\n");
  SetProp(P_INFO, ("Der Orkandaemon kann Heiliges nicht ausstehen.\n"));
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE_STRENGTHS,([
     DT_AIR:-1, DT_HOLY:0.1, DT_MAGIC:-0.5, DT_UNHOLY:-1.0, DT_TERROR:-0.7,
     DT_BLUDGEON:-0.6, DT_RIP:-0.5, DT_SLASH:-0.3, DT_PIERCE:-0.4, 
     DT_FIRE:-0.3, DT_SOUND:1.0]));
  
  SetProp(P_MSGIN, "rast tobend herein");
  SetProp(P_MSGOUT, "rast tobend");
  SetProp(P_MMSGOUT, "rast tobend davon");
  SetProp(P_MMSGIN, "rast tobend herein");

  SetProp(P_MNPC_AREA, ROOM "geist" );
  SetProp(P_MNPC_WAIT, ({ 15, 30, 10}));
  SetProp(P_MNPC_DEFAULTROOM, ROOM, "geist4");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES+MOV_BACKWARDS);

  
  SetProp(P_NOMAGIC, 10);
  SetProp(P_SPELLRATE, 90);
  AddSpell(5, 400, 
   "Der Orkandaemon blaest einen Orkan auf Dich.\n",
    "Der Orkandaemon blaest einen Orkan auf @WEN.\n",
    DT_AIR, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(2, 500, 
    "Der Orkandaemon beschwoert alle boesen Winde.\n",
    "Der Orkandaemon beschwoert alle boesen Winde.\n",
     DT_AIR,([SP_SHOW_DAMAGE:1]));
  AddSpell(5, 400,
    "Der Orkandaemon schleudert Dich zu Boden.\n",
    "Der Orkandaemon schleudert @WEN zu Boden.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(5, 300,
    "Der Orkandaemon rast tobend um Dich herum.\n",
    "Der Orkandaemon rast tobend um @WEN herum.\n",
     DT_AIR, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 800,
  "Der Orkandaemon wirbelt Dich in die Luft.\n",
  "Der Orkandaemon wirbelt @WEN in die Luft.\n",
  DT_AIR, ([SP_SHOW_DAMAGE:1]));

 SetChats(4, ({
    "Der Orkandaemon rast herum.\n",
    "Der Orkandaemon blaest Dir ins Gesicht.\n",
    "Der Orkandaemon fragt: Sterblicher, was willst Du von uns ?\n",
    "Der Orkandaemon sagt: Das Silberland muss vernichtet werden!\n",
    "Der Orkandaemon wirft kleine Sturmboen nach Dir.\n",
    "Der Orkandaemon saust in die Wolken.\n",
    "Der Orkandaemon fragt: Fehlt Dir noch ein Zaubertrank.\n",
    "Der Orkandaemon fragt: Kleinen Orkan gefaellig ?\n",
    "Die Wolken rasen ueber den Himmel.\n",
    "Der Boden unter Deinen Fuessen wackelt.\n"
    }));
 SetAttackChats(20, ({
    "Der Orkandaemon schreit: Du Wurm, Dich blase ich weg!\n",
    "Der Orkandaemon bruellt: Winde erhebt euch gegen alles Leben!\n",
    "Der Orkandaemon rast um Dich herum!\n",
    "Der Orkandaemon schreit: Verschwinde von hier!\n",
    "Du taumelst umher.\n",
    "Die Winde reissen Dich zu Boden.\n",
    "Der Orkan wird immer schlimmer.\n"}));
 
 
 AddInfo("dante",
 "sagt: Dante, der alte Angsthase!\n");   
 AddInfo(({"kannibalen","kannibale"}),
    "sagt: Die Kannibalen sind auch nur dumme Sterbliche.\n");
 AddInfo("dschungel",
    "sagt: Den Dschungel mache ich den Erdboden gleich.\n");
 AddInfo("feyaria",
 "sagt: Sie hat grossse Angst vor mir.");   
 AddInfo("silberland",
 "sagt: Das Silberland verwuesten wir!");   
 AddInfo("wind",
    "sagt: Ich liebe es, wenn die Winde toben.\n");
    AddInfo("pflanzen",
    "sagt: Die werden alle vernichtet!");
    AddInfo("tijara",
    "sagt: Wir bald nur mehr aus Truemmern bestehen.");
    AddInfo("tiere",
    "sagt: Krepieren sollen sie alle!");
 AddInfo("orkan",
 "sagt: Gleich kommt einer...");
 AddInfo("natur",
 "lacht nur...");
 AddInfo("schrecken",
 "sagt: Schrecken verbreiten wir ueberall!");
 AddInfo("anfuehrer",
 "sagt: Du meinst den Skelettdrachen!!!");
 AddInfo(({"drache","skelettdrache"}),
 "Er ist der Meister!", "bruellt: ");
 AddInfo("statue",
 "flucht: Die ist fuer die Ewigkeit gebaut!.");
 AddInfo("leben",
 "lacht ueber alles Leben.");
 AddInfo("tod",
 "sagt: Den Tod willst Du haben, kein Problem...");

 
    SUID;
    if (!random(7) || (PO && strstr(file_name(PO), "luft/dante") != -1))
      CLONEME(ARMOUR "orkutte");
    command("trage alles");
                 
}



Defend(int dam, string dtype, int spell, object enemy) {
  if (!pointerp(dtype))
    dtype = ({ dtype });
  if (sizeof(dtype & ({ DT_AIR }) )) {
    tell_room(environment(), "Der Orkandaemon lacht Dich aus!\n");
    heal_self(dam);
    return ::Defend(0, dtype, spell, enemy);
  }
  if (sizeof(dtype & ({ DT_TERROR }) )) {
    tell_room(environment(), "Der Orkandaemon lacht Dich aus!\n");
    heal_self(dam);
    return ::Defend(0, dtype, spell, enemy);
  }
  if (sizeof(dtype & ({ DT_UNHOLY }) )) {
    tell_room(environment(), "Der Orkandaemon lacht Dich aus!\n");
    heal_self(dam);
    return ::Defend(0, dtype, spell, enemy);
  } 
  ::Defend(dam,dtype,spell,enemy);      
} 
                                                                                                                                                                            
