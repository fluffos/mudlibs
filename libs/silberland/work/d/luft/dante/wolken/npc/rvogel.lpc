
// dante november 97

inherit "std/mnpc";

#include "../def.h"

void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein grosser, schwarzer Wolkenhacker");
  SetProp(P_LONG, BS(
        "Der grosse, schwarze Wolkenhacker ist so etwas aehnliches wie ein Rabe, "
        "nur ist er um vieles maechtiger und staerker. Sein Schnabel, der ihm "
        "seinen Namen verlieh, kann Dir sehr gefaehrlich werden."));
  SetProp(P_NAME, "Wolkenhacker");
  SetProp(P_GENDER, MALE);
  AddId(({"hacker","wolkenhacker","vogel"}));
  create_default_npc(15);
  SetProp(P_RACE, "Vogel");

  SetProp(P_WIMPY,50);

  AddDetail("schnabel",
      "Der Schnabel sieht sehr gefaehrlich aus.");
  SetProp(P_INFO, ("Der Wolkenhacker ist boesartig.\n"));
  SetProp(P_HANDS, ({" mit seinem harten, grossen Schnabel",250+random(30),({DT_RIP,DT_PIERCE}) }));
  SetProp(P_BODY, 30+random(10));
  SetProp(P_SIZE, 70);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NOMAGIC,3);
  
  
  SetProp( P_RESISTANCE_STRENGTHS, 
      ([DT_MAGIC:-0.5,DT_COLD:2.0, DT_FIRE:-1,DT_AIR:-1.0, DT_SLASH:1]) );
  SetProp(P_MSGIN, "segelt kraechzend herein");
  SetProp(P_MSGOUT, "segelt");
  SetProp(P_MMSGIN, "stuerzt sich von weit oben herab");
  SetProp(P_MMSGOUT, "segelt davon");

  SetProp(P_DIE_MSG,  " stuerzt durch die Wolkendecke zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "KRAECHZ!!!");
  SetProp(P_KILL_NAME, "Wolkenhacker");
  SetProp(P_KILL_MSG, "Dir hack ich noch die Augen aus...");
   
  SetProp(P_SPELLRATE,70);
  
  AddSpell(2,500,
      "Der Wolkenhacker versucht Dir ein Auge auszuhacken.\n",
      "Der Wolkenhacker versucht @WEM ein Auge auszuhacken.\n",
      DT_TERROR,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,400,
      "Der Wolkenhacker versucht Deinen Bauch aufzureissen.\n",
      "Der Wolkenhacker versucht @WESSEN Bauch aufzureissen.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));   
  AddSpell(3,300,
      "Der Wolkenhacker versucht Dir ein Bein zu zerfetzen.\n",
      "Der Wolkenhacker versucht @WESSEN Bein zu zerfetzen.\n",
      DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,300,
      "Der Wolkenhacker schlaegt seinen Schnabel in Deinen Arm.\n",
      "Der Wolkenhacker schlaegt seinen Schnabel in @WESSEN Arm.\n",
      DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(10, ({
        "Der Wolkenhacker kraechzt laut.\n",
        "Der Wolkenhacker schlaegt aufgeregt mit den Fluegeln.\n",
        "Der Wolkenhacker stuerzt fast ab.\n",
        "Dir wird schwindlig.\n",
        "Du kannst Dich des Wolkenhackers kaum erwehren.\n"}));
}

void init()
{
  ::init();
  call_out("hallo",0);
}

void hallo()
{
  if( ME && MENV && TP && present(TP, MENV) )
    command("emote kraechzt laut: "+ TP->name(RAW) +", die Wolken sind mein Revier!");
}
