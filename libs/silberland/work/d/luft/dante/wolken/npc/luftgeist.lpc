

inherit "std/mnpc";

#include "../def.h"

#include "/gilden/bardengilde/barden_extern.h"
inherit "/gilden/bardengilde/obj/quest/bard_small_combatspell_teacher";

void create()
{
  int i;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein durchsichtiger, kleiner Luftgeist");
  SetProp(P_LONG, BS(
        "Der durchsichtige Luftgeist hat keine Gestalt. Er ist nur eine schwebende, fast "
        "nicht zu erkennende Masse aus blaeulich-weisser Luft."));

  SetProp(P_NAME, "Luftgeist");
  SetProp(P_GENDER, MALE);
  AddId( ({"geist", "luftgeist"}) );

  AddDetail(({"gestalt"}),
      "Wie schon erwaehnt, er hat keine...");
  AddDetail(("luft"),
      "Die Luft ist blaeulich-weiss und kaum zu erkennen.");
  AddDetail(("masse"),
      "Die Luft steigt auf und ab und hin und her...");

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit einem kleinem Luftstoss", 110+random(20), ({DT_AIR})}));
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 100+random(200));
  SetProp(P_ALIGN, 400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WEIGHT, 2000);
  AddInfo(DEFAULT_INFO, "blaest Dir freundlich ins Gesicht.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Durch den Luftgeist faellt alles hindurch...\n"}));
  SetProp(P_DIE_MSG, " loest sich buchstaeblich in Luft auf.\n");
  SetProp(P_INFO, ("Der kleine Luftgeist besteht aus Luft.\n"));
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE_STRENGTHS, ([ 
        DT_FIRE: -0.7, DT_SLASH: -0.3, DT_POISON: -0.5, DT_RIP: -0.3,
        DT_HOLY: -0.5, DT_ACID: -0.5, DT_TERROR: -0.5, DT_BLUDGEON: -0.3, 
        DT_MAGIC: 1, DT_SOUND: 1]));
  
  SetProp(P_MMSGIN, "schwebt herein");
  SetProp(P_MMSGOUT, "schwebt in die Wolken davon");
  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");

  SetProp(P_NOMAGIC, 10);
  SetProp(P_SPELLRATE, 70);
  AddSpell(5, 300, 
      "Der kleine Luftgeist blaest Dir Luft ins Gesicht.\n",
      "Der kleine Luftgeist blaest @WEM Luft ins Gesicht.\n",
      DT_AIR, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(2, 400, 
      "Der kleine Luftgeist wirft Dich mit einer Boehe fast um.\n",
      "Der kleine Luftgeist wirft @WEN mit einer Boehe fast um.\n",
      DT_AIR, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 500,
      "Der kleine Luftgeist entfacht einen Wirbelwind ueber Dir.\n",
      "Der kleine Luftgeist entfacht einen Wirbelwind ueber @WEM.\n",
      DT_AIR, ([SP_SHOW_DAMAGE:1]));

  SetChats(4, ({
        "Der kleine Luftgeist schwebt nach oben...\n",
        "Der kleine Luftgeist schwebt nach unten...\n",
        "Der kleine Luftgeist verschwindet kurz hinter einer Wolke.\n",
        "Der kleine Luftgeist scheint voellig durchsichtig zu sein.\n",
        "Der kleine Luftgeist grinst Dich freundlich an.\n",
        "Der kleine Luftgeist verschwindet, taucht aber hinter Dir wieder auf.\n",
        "Der kleine Luftgeist sagt: Magst Du Wolken ?\n",
        "Der kleine Luftgeist schimmert blaeulich...\n",
        "Der kleine Luftgeist  schimmert leicht weisslich...\n"}));
  SetAttackChats(20, ({
        "Der kleine Luftgeist sagt: Das war ein Fehler, Du Unwissender.\n",
        "Der kleine Luftgeist versucht Dich zu entmaterialisieren.\n",
        "Der kleine Luftgeist lacht Dich aus.\n",
        "Der kleine Luftgeist sagt: Verschinde von hier!.\n",
        "Du beginnst zu taummeln.\n",
        "Der kleine Luftgeist sagt: Soll ich meinen grossen Bruder holen ?\n",
        "Du kriegst kaum noch Luft...\n"}));

  AddInfo("dante",
      "sagt: Dante ist ein Luftikus!\n");   
  AddInfo(({"luft"}),
      "sagt: Ich liebe die Luft...\n");
  AddInfo("wolken",
      "sagt: Die Wolken sind meine Heimat.\n");
  AddInfo("wolke",
      "sagt: Ich bin fast eine Wolke...");   

  initialize_bard_spell_teacher(BARD_GROUP_SARRIAN);
}
