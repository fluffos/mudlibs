//wolkenschild fuer gewitterwolke
//

inherit "std/armour";

#include "../def.h"

void create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Eine magische Lufthuelle");
  SetProp (P_LONG, (
  "Diese Lufthuelle ist eine Art Schild und besteht aus keinem naeher erkennbaren Material. "
  "Es ist einfach ein magischer Schutz, der den Traeger vor vielen "
  "Gefahren bewahren kann."));
  SetProp (P_INFO, "Diese Lufthuelle ist wahrlich hervorragend. Sie schuetzt auch "  
  "etwas vor Hitze!\n");
  SetProp (P_NAME, "Lufthuelle");
  SetProp (P_GENDER, FEMALE);
  AddId (({"schild","luftschild","lufthuelle","huelle"}));
  SetProp (P_WEIGHT, 200);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, ({MAT_MAGIC, MAT_AIR}));
  SetProp (P_VALUE, 5000);
  SetProp (P_ARMOUR_TYPE, AT_SHIELD);
  SetProp (P_AC, 28+random(3));
  SetProp (P_QUALITY_DECAY, 88);
  SetProp (P_MATERIAL, ([MAT_MAGIC:50, MAT_AIR:50]));
  AddProp (P_DAM_PROTECTION, ([DT_AIR:1, DT_MAGIC:1, DT_LIGHTNING:1, DT_EXPLOSION:1]) );
  SetProp (P_WEAR_RESTRICTIONS, ([SR_SEER:1, A_INT:15, A_DEX:15]));
  SetProp (P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:0, T_HEAT_PROT:5]) );
}

