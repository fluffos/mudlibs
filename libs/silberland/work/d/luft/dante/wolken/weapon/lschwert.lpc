
inherit "std/weapon";

#include "../def.h"


create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein Luftschwert");

  SetProp (P_LONG, 
  "Das Luftschwert ist eigentlich kaum zu sehen. Nur der Griff besteht aus festem Metall. "
  "Die Schneide schimmert manchmal blaeulich, ist aber sonst unsichtbar.");
  
  AddDetail(("schneide"),
  "Die Schneide ist kaum zu sehen, nur manchmal schimmert etwas blaeulich.");
  AddDetail(("griff"),
  "Der Griff besteht aus einem Dir unbekanntem weissen Metall.");
  SetProp (P_NAME, "Luftschwert");
  SetProp (P_GENDER, NEUTER);

  AddId (({"schwert", "luftschwert"}));

  SetProp (P_VALUE, 2800+random(500));
  SetProp (P_WEIGHT, 100);
  SetProp (P_WEAPON_TYPE, WT_SWORD);
  SetProp (P_DAM_TYPE, ({DT_SLASH,DT_PIERCE,DT_AIR}));
  SetProp (P_NOBUY, 1);
  SetProp (P_WC, 170+random(20));
  //plumpes Metall in so einer schoenen Waffe, gegen Gold getauscht, by PROtheG
  // unbekanntes weisses metall ist aber iridium, nicht gold:) (feyaria)
  SetProp (P_MATERIAL, ([MAT_AIR:70,MAT_MAGIC:20,MAT_IRIDIUM:10])); 
  SetProp (P_NR_HANDS, 1);
  SetProp (P_WEAR_RESTRICTIONS, ([SR_SEER:1]) );  
  SetProp (P_INFO, BS("Das Luftschwert ist eine exzellente Waffe.\n"));
  SetProp (P_WC_BONUS, (["zombiejaeger": 100]) );
}

