// ueber den wolken

#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Inmitten der Wolken" );
  SetProp( P_INT_LONG, BS(
        "Du stehst mitten in einer kleinen Wolke und wunderst Dich, wie Du hier ueberhaupt "
        "stehen kannst. Langsam ziehen andere Wolken ueber Dich hinweg und manchmal blinzelt "
        "Dich die Sonne durch die dichte Wolkendecke hindurch an. Ein leichter Wind weht und "
        "irgendwie kommst Du Dir wie im Himmel vor. Im Norden scheinen die Wolken etwas lichter "
        "zu werden. Du solltest hier alle Deine Sinne nutzen..."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_AIR]) );

  AddDetail( ({"wind"}),
      "Ein leichter Wind weht hier.");

  AddDetail("norden",
      "Die Wolken scheinen dort etwas auseinander zu weichen.");

  AddDetail( ({ "himmel" }),
      "Du kannst den Himmel vor Wolken nicht erkennen.");
  AddDetail(("sonne"),
      "Die Sonne kann nur selten durch die dicke Wolkendecke dringen, aber trotzdem "
      "ist es hier taghell.");
  AddDetail(({"decke","wolkendecke"}),
      "Rings um Dich nichts als weisse, weiche Wolken, doch da war etwas.");
  AddDetail(("etwas"),
      "Nein, da war doch nichts.");

  AddDetail(("boden"),
      "Den Boden kannst Du von hier oben nicht mehr erkennen.");
  AddDetail(("dschungel"),
      "Der Dschungel liegt tief unter Dir.");

  AddSound( DEFAULT_SOUND,
      "Hier ist es angenehm ruhig.");

  AddSmell( DEFAULT_SMELL,
      "Hmm, riechen kann man hier nichts.");


  AddDetail(({"wolken","wolke"}),
      "Die Wolken schweben auf und ab und sehen ganz weich aus.");

  AddDetail("seil",
      "Ja, wirklich! Ein Seil haengt von oben herab, aber wohin fuehrt es?!");

  AddExit( "norden", "./wolke2" );
  SetProp(P_HIDE_EXITS, ({"norden"}));

  AddCmd(({"tast","taste"}), "tasten");

  AddCmd( ({"klettere", "kletter"}), "klettern");

}


int klettern(string str )
{
  notify_fail( "Wohin willst Du klettern?\n" );
    if( !str ) return 0; 

      if( member( ({"rauf","nach oben", "an seil hoch","hoch", "an seil rauf" }),str) !=-1 )


      {
        write("Du kletterst mit grosser Muehe nach oben.\n");
          TP->move(ROOM "wolke10", M_GO, "nach oben",
              "klettert", "kommt von unten heraufgeklettert");
          
          return 1;
      }
  return 0;
}


int tasten()  {
  write(BS(
        "Du tastest in den Wolken herum und findest ein Seil, das von oben herunter haengt."));
  say(BS(
        CAP_TPN+" tastet herum..."));
  return 1; }


