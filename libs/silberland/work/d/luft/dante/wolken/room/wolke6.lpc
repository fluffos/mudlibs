// ueber den wolken

#include "../def.h"

inherit "std/room";


nosave int heilen;
void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Inmitten der Wolken" );
  SetProp( P_INT_LONG, BS(
        "Du stehst mitten in einer kleinen Wolke und wunderst Dich, wie Du hier ueberhaupt "
        "stehen kannst. Langsam ziehen andere Wolken ueber Dich hinweg und manchmal blinzelt "
        "Dich die Sonne durch die dichte Wolkendecke hindurch an. Ein leichter Wind weht und "
        "irgendwie kommst Du Dir wie im Himmel vor. Eine etwas seltsam geformte Wolke faellt Dir hier besonders auf."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_AIR]) );

  AddDetail( ({"wind"}),
      "Ein leichter Wind weht hier.");
  AddDetail( ({ "himmel" }),
      "Du kannst den Himmel vor Wolken nicht erkennen.");
  AddDetail(("sonne"),
      "Die Sonne kann nur selten durch die dicke Wolkendecke dringen, aber trotzdem "
      "ist es hier taghell.");
  AddDetail(({"decke","wolkendecke"}),
      "Rings um Dich nichts als weisse, weiche Wolken.");
  AddDetail(("boden"),
      "Den Boden kannst Du von hier oben nicht mehr erkennen.");
  AddDetail(("dschungel"),
      "Der Dschungel liegt tief unter Dir.");

  AddDetail(({"wolken"}),
      "Die Wolken sehen sehr weich und sanft aus, aber das ist ja hier nichts Neues. "
      "Eine der Wolken jedoch fasziniert Dich sehr...");
  AddDetail(("wolke"),
      "Diese besonders markante Wolke sieht aus wie ein Riesenwolkenburger...?");
  AddDetail(({"riesenwolkenburger","burger","riesenburger","wolkenburger"}),
      "Hmmm, er sieht so lecker aus. Direkt zum anbeissen...");

  AddSound( DEFAULT_SOUND,
      "Hier ist es angenehm ruhig.");

  AddSmell( DEFAULT_SMELL,
      "Hmmmmmmm, hier riecht es sooo lecker nach Riesenwolkenburger...");

  AddExit("unten", "./wolke8");
  AddExit("suedosten", "./wolke7");
  AddExit("norden","./pneu"); 
  AddExit("westen", "./wolke5");
  AddCmd(({"beisse","beiss","beisz"}), "eat");

  heilen = 4+random(3);

}

reset() 
{
  heilen = 4+random(3);
  ::reset();
}


eat ( string str)
{
  notify_fail("Wo willst Du hier reinbeissen?\n");
  if (!str) return 0;


  if (( heilen )&&
      (member(({"in burger","in riesenburger","in riesenwolkenburger","in wolkenburger"}), str)!=-1))

  {
    write(" \n"
        "Du beisst in den Riesenwolkenburger und fuehlst Dich sehr gut dabei.\n");
    say(""+TPN+" beisst in einen Riesenwolkenburger...\n");
    TP->heal_self(30+random(15));
    heilen--;

    return 1;
  }


  if (( !heilen )&&
      (member(({"in burger","in riesenburger","in riesenwolkenburger","in wolkenburger"}), str)!=-1))
  {
    write("Du beisst in den Wolkenburger, aber er schmeckt Dir nicht mehr!\n");
    return 1;
  }
  return 0;
}  
