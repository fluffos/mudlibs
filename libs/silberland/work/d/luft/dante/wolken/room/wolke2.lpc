// ueber den wolken

#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Inmitten der Wolken" );
  SetProp( P_INT_LONG, BS(
        "Du stehst mitten in einer kleinen Wolke und wunderst Dich, wie Du hier ueberhaupt "
        "stehen kannst. Langsam ziehen andere Wolken ueber Dich hinweg und manchmal blinzelt "
        "Dich die Sonne durch die dichte Wolkendecke hindurch an. Ein leichter Wind weht und "
        "irgendwie kommst Du Dir wie im Himmel vor. Im Sueden scheinen die Wolken etwas lichter "
        "zu werden."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_AIR]) );


  AddDetail( ({"wind"}),
      "Ein leichter Wind weht hier.");
  AddDetail("sueden",
      "Die Wolken scheinen dort etwas auseinander zu weichen.");

  AddDetail( ({ "himmel" }),
      "Du kannst den Himmel vor Wolken nicht erkennen.");
  AddDetail(("sonne"),
      "Die Sonne kann nur selten durch die dicke Wolkendecke dringen, aber trotzdem "
      "ist es hier taghell.");
  AddDetail(({"decke","wolkendecke"}),
      "Rings um Dich nichts als weisse, weiche Wolken, doch da war etwas.");
  AddDetail(("etwas"),
      "Das etwas war eine bunte Wolke, die Dich kurz durch die Wolkendecke angelaechelt hat. "
      "Sie schimmert in grellen Farben, und Du ueberlegst, wie es so etwas geben kann...");
  AddDetail(({"farben", "farbe"}),
      "Als Du die Farben der Wolke naeher betrachtest, erkennst Du an der Wolke ein "
      "kleines Schildchen.");
  AddDetail(("schild"),
      "Es ist ein Schildchen. Die Wolke ist ja noch sehr klein...");
  AddDetail(("schildchen"),
      "Du kannst es lesen.");
  AddReadDetail(("schildchen"),
      "+-----------------------+\n"
      "|      WOLKENTAXI       |\n"
      "+-----------------------+\n");
  AddDetail(("taxi"),
      "Die kleine, bunte Wolke scheint ein Taxi zu sein...\n"),
  AddDetail(("boden"),
      "Den Boden kannst Du von hier oben nicht mehr erkennen.");
  AddDetail(("dschungel"),
      "Der Dschungel liegt tief unter Dir.");

  AddSound( DEFAULT_SOUND,
      "Hier ist es angenehm ruhig.");

  AddSmell( DEFAULT_SMELL,
      "Hmm, riechen kann man hier nichts.");

  AddCmd( ({"winke","wink"}), "taxi" );
  AddCmd(({"ruf","rufe"}), "new");

  AddDetail(({"wolken","wolke"}),
      "Die Wolken schweben auf und ab und sehen ganz weich aus.");



  AddExit( "norden", "./wolke" );
  AddExit("sueden", "./wolke9");

  AddExit("osten" , "./wolke4");
  SetProp(P_HIDE_EXITS, ({"sueden"}));

}


new(string str)

{

  notify_fail("Was willst Du zu Dir rufen?\n");
  if (!str ) return 0;
  if ( member( ({"taxi","wolkentaxi"}), str) !=-1 )
  {
    write( " \n"
        "Du musst das Taxi herwinken, es hat ja keine Ohren! (winke)\n.");
    return 1;
  }
  return 0;
}



taxi ( string str)
{
  notify_fail("Was willst Du zu Dir winken?\n");
  if (!str ) return 0;
  if ( member( ({"taxi","wolkentaxi"}), str) !=-1 )
  {
    write( " \n"
        "Du winkst das Wolkentaxi zu Dir und siehe da, es kommt wirklich.\n"
        "Gut gelaunt steigst Du auf die Wolke und die Fahrt beginnt.\n");

    say(""+TPN+" besteigt eine kleine Wolke.\n");
    call_out("st1",2);


    return 1;
  }
  return 0;
}

st1()
{
  write("Langsam schwebst Du nach unten und Landest sanft am Boden.\n"
      "Die Wolke verschwindet wieder im Himmel.\n");
  TP->move("/d/dschungel/dante/weg/room/weg9", M_TPORT,

      "auf der kleinen Wolke sanft nach unten.","schwebt",
      "kommt auf einer kleinen Wolke sanft zu Boden geschwebt, verlaesst diese "
      "und die Wolke entschwebt wieder in die Luefte.");

}
