// ueber den wolken

#include "../def.h"

inherit "std/room";


int vogel;

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Inmitten der Wolken" );
  SetProp( P_INT_LONG, BS(
        "Du stehst mitten in einer kleinen Wolke und wunderst Dich, wie Du hier ueberhaupt "
        "stehen kannst. Langsam ziehen andere Wolken ueber Dich hinweg und manchmal blinzelt "
        "Dich die Sonne durch die dichte Wolkendecke hindurch an. Ein leichter Wind weht und "
        "irgendwie kommst Du Dir wie im Himmel vor. Hier ist es nicht mehr ganz so hoch "
        "ueber dem Dschungel und Du glaubst auch schon etwas zu erkennen."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_AIR]) );

  AddDetail( ({"wind"}),
      "Ein leichter Wind weht hier.");
  AddDetail("dschungel",
      "Der Dschungel liegt nun mehr nicht ganz so tief unter Dir. Ein Sprung "
      "nach unten muss nicht toedlich sein...");
  AddDetail("etwas",
      "Ausser gruenen Pflanzen ist alles nur sehr undeutlich und verschwommen zu "
      "erkennen.");
  AddDetail(({"pflanze","pflanzen"}),
      "Gruen schimmern sie durch die Wolken hindurch. Einen Sprung wuerden "
      "sie sicher gut abfangen...");
  AddDetail( ({ "himmel" }),
      "Du kannst den Himmel vor Wolken nicht erkennen.");
  AddDetail(("sonne"),
      "Die Sonne kann nur selten durch die dicke Wolkendecke dringen, aber trotzdem "
      "ist es hier taghell.");
  AddDetail(({"decke","wolkendecke"}),
      "Rings um Dich nichts als weisse, weiche Wolken.");
  AddDetail(("boden"),
      "Den Boden kannst Du von hier oben nicht mehr erkennen.");
  AddDetail(("dschungel"),
      "Der Dschungel liegt tief unter Dir.");

  AddDetail(({"wolken"}),
      "Die Wolken sehen sehr weich und sanft aus, aber das ist ja hier nichts Neues. "
      "Eine der Wolken jedoch fasziniert Dich sehr...");
  AddDetail(("wolke"),
      "Eine Wolke weist ein grosses, durchsichtiges Loch und einen kleinen Zipfel auf.");
  AddDetail("loch",
      "Du blickst durch das Loch hindurch und erkennst die Plantagen von Tijara.");
  AddDetail("tijara",
      "Tijara kann man von hier nicht sehen, aber Dir faellt ein kleiner Zipfel einer Wolke auf.");
  AddDetail(({"plantage","plantagen"}),
      "Sie liegen unter Dir und scheinen nicht mehr so weit weg zu sein.");
  AddDetail("zipfel",
      "Der Zipfel sieht eher wie ein netter, kleiner Spatz.");

  AddSpecialDetail("spatz", "d_come"); 
  AddSound( DEFAULT_SOUND,
      "Du hoerst die Geraeusche des Dschungels.");

  AddSmell( DEFAULT_SMELL,
      "Hier kann man den Dschungel schon fast riechen...");

  AddExit("oben", "./wolke6");

  AddCmd(({"springe","spring"}), "down"); 

  vogel = 3;


  AddItem( NPC "lichtdaemon", REFRESH_DESTRUCT);   

}


void reset()
{
  ::reset();
  vogel=3;
}

string d_come()
{ 
  object ob;
  if (vogel)
  {
    write("\n"
        "Du betrachtest den Spatz und auf einmal hoerst Du lautes Kreischen ober Dir. "
        "Was bedeutet das nur...\n");

    ob = clone_object(NPC "rvogel");
    ob->move(environment(TP),M_TPORT);

    if(IS_WIZARD(TP) )
    {

      write("Der Raubvogel wagt es nicht Dich Magier anzugreifen.\n");
    }
    else

      ob->Kill(TP);
    vogel--;
    return("");
  }
  else
    return("Du betrachtest den Zipfel und glaubst Dich getaeuscht zu haben.\n");
}







int down(string str )
{
  notify_fail( "Wohin willst Du springen ?\n" );
  if( !str ) return 0;
  if( member( ({"unten", "nach unten", "runter", "hinunter", "zu boden",
          "hinab","auf erde"}),str) !=-1 )

  {
    write("Todesmutig springst Du durch die Wolken nach unten.\n"); 
    TP->move("/d/dschungel/dante/weg/room/planta3",M_GO, "durch die Wolken in die Tiefe",
        "springt","stuerzt von weit oben genau auf den grossen Haufen Blaetter");
    TP->do_damage(3+random(3));
    SetProp(P_KILL_MSG, "Ein Sprung in einen Blaetterhaufen.");
    return 1;
  }
  return 0;
}

