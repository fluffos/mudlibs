// ueber den wolken

#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Inmitten der Wolken" );
  SetProp( P_INT_LONG, BS(
        "Hier scheinen die Wolken nicht mehr so hell und freundlich auszusehen. "
        "Drohend haengen sie am Himmel, Blitze zucken durch die Luft und "
        "manchmal hoert man aus der Ferne dumpfen Donner grollen. Die Luft scheint "
        "auf Grund der hohen Spannung zu flimmern..."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_AIR]) );

  AddDetail( ({"donner"}),
      "Sehen kannst Du den Donner nicht, nur hoeren.");
  AddDetail( ({"blitz", "blitze"}),
      "Gewaltige Blitze zucken durch die Luft.");
  AddDetail( ({ "himmel" }),
      "Der Himmel ist hier bedrohlich und duester.");
  AddDetail(("sonne"),
      "Von der Sonne ist hier nichts mehr zu erblicken.");
  AddDetail(({"decke","wolkendecke"}),
      "Dunkel und unheilschwanger haengen die Wolken ueber Dir.");
  AddDetail(("boden"),
      "Den Boden kannst Du von hier oben nicht mehr erkennen.");
  AddDetail(("dschungel"),
      "Der Dschungel liegt tief unter Dir.");
  AddDetail(("luft"),
      "Die Luft scheint sehr aufgeladen zu sein.");
  AddDetail(("spannung"),
      "Die Spannung steigt und steigt. Unsinn, das hier ist ja kein Thriller, "
      "sondern ein Gewitter.");
  AddDetail(("gewitter"),
      "Vielleicht kann man irgendwie eine Gewitterwolke anlocken...");
  AddDetail(({"wolke","wolken"}),
      "Bedrohlich haengen tiefschwarze Gewitterwolken ueber Dir.");
  AddDetail(({"gewitterwolke","gewitterwolken"}),
      "Sie sehen nicht gerade einladend aus, sind aber im Moment noch "
      "recht weit von Dir entfernt.");

  AddSound( ({DEFAULT_SOUND, "donner"}),
      "Aus der Ferne hoert man dumpfen Donner grollen.");

  AddSmell( DEFAULT_SMELL,
      "Hmm, riechen kann man hier nichts.");

  AddExit("sueden","./wolke6");

}
