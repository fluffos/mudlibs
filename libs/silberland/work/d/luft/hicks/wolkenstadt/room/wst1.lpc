// von Hicks
// 20.1.2004
// 
// Raum meines Gesellenstueckes "Turm1 - Wolkenstadt"

inherit "std/room";

#include "../def.h"

#define REIHENFOLGE "anthrazitperlsilberstahltaubenweiss"
string reihe;
int anz=0;

void create()
{
  ::create();
  
  reihe="";
  
  SetProp(P_INT_SHORT, "Turm in der Wolkenstadt");
  SetProp(P_INT_LONG, "Dieser Raum ist eigentlich kein Raum. Die vier "
	  "gegenueber liegenden Bogengaenge aus Schlingpflanzen bilden ein "
	  "Durchgangssystem, das von der Sonne durchflutet wird. Eine "
	  "Wolkentreppe beginnt in der suedoestlichen Ecke und zieht sich "
	  "entlang der Wand in das naechste Stockwerk. In der nordoestlichen "
	  "Ecke befindet sich ein bequemer Ohrensessel und ein "
	  "huebscher Kristalltisch glitzert daneben.@@show@@");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
    
  //-----Details Anfang-----
  
  AddDetail( ({"cute","marrogh","maghnar","niri","gaya","zidane","nyx","wumanzu",
	       "elrohir","velkyn","took","aroobah","methos","katarok"}),
	      "Ja, dieser Spieler hat mir geholfen, dass dieses Gebiet noch besser "
	      "und schoener wird.");

  AddDetail( ({"raum"}),
	     "Wie gesagt, das ist kein Raum. Die Boegen aus Schlingpflanzen "
	     "bilden praktisch Durchgaenge. Man kann von Norden, Osten, "
	     "Westen und Sueden herein gelangen. ");
  
  AddDetail( ({"boegen","bogengaenge","bogen"}),
	     "Die weiten Boegen aus dem gruenen Geflecht spannen sich von "
	     "einem Eck zum naechsten. Sie sind leicht nach aussen gewoelbt, "
	     "als waere dieser Raum leicht kugelig.");
  
  AddDetail( ({"schlingpflanzen","pflanzen"}),
	     "Die Schlingpflanzen sind kristallartig gruen. Sie entspringen "
	     "in den Ecken und winden sich wie Saeulen in die Hoehe. Die "
	     "Straenge und Blaetter verschlingen sich zu einem einem Geflecht.");
  
  AddDetail( ({"straenge","straengen"}),
	     "Sie sind sehr filigran, aber gleichzeitig auch sehr belastbar. "
	     "Der gesamte Turm lastet auf ihnen.");
  
  AddDetail( ({"turm"}),
	     "Wenn Du den Turm sehen willst, dann musst Du schon hinaus gehen.");
  
  AddDetail( ({"blaetter"}),
	     "Hin und wieder lugt ein Blatt aus dem Gewirr heraus und wiegt "
	     "sich sanft im Wind. Eines faellt Dir besonders auf.");
  
  AddDetail( ({"blatt"}),
	     "Dieses Gruen, es leuchtet fast.");
  
  AddDetail( ({"gruen"}),
	     "Eigentlich leuchtet es sehr stahlgrau.");
  
  AddDetail( ({"wind"}),
	     "Der Wind wirbelt, kaum bemerkbar, durch den Raum.");

  AddDetail( ({"gewirr","geflecht"}),
	     "Dieses Gewirr von Straengen flechtet sich von den Ecken, ueber "
	     "die Boegen hinauf. Selbst die Decke besteht aus diesem "
	     "undurchdringlichen, dichten Geflecht.");
  
  AddDetail( ({"saeulen"}),
	     "Aus dem Boden spriessen die Schlingpflanzen und bilden zuerst "
	     "Saeulen und verflechten sich dann zu den Boegen und der Decke.");
  
  AddDetail( ({"hoehe"}),
	     "Das Geflecht von vier Saeulen zieht sich bis zur Glaskuppel. Du "
	     "konntest schon von aussen erkennen, dass das leiterartige "
	     "Geflecht sich bogenartig ueber die Stockwerke zieht.");
  
  AddDetail( ({"glaskuppel","kuppel"}),
	     "Du solltest nach oben gehen, wenn Du sie sehen willst.");
  
  AddDetail( ({"stockwerke","werke"}),
	     "Es sind mehrere Stockwerke vorhanden. Geh einfach hinauf!");
  
  AddDetail( ({"norden"}),
	     "Nach Norden gelangst Du zum Springbrunnen.");
  
  AddDetail( ({"springbrunnen","brunnen"}),
	     "Er plaetschert munter vor sich hin.");
  
  AddDetail( ({"osten"}),
	     "Im Osten liegt idyllisch das Nebelbecken, vor dem eine Parkbank "
	     "steht.");
  
  AddDetail( ({"nebelbecken","becken"}),
	     "Wenn Du nach Osten gehst, dann kannst Du Dir alles naeher "
	     "ansehen.");
  
  AddDetail( ({"parkbank","bank"}),
	     "Sie laedt zum Ausrasten ein.");
  
  AddDetail( ({"ausrasten"}),
	     "Du koenntest Dich auch hier im Ohrensessel ausruhen.");
  
  AddDetail( ({"sueden"}),
	     "Du erkennst einen Wasserfall, der einen grauen Fels herunter "
	     "rinnt.");
  
  AddDetail( ({"wasserfall","fall"}),
	     "Er rinnt und rinnt und rinnt.");
  
  AddDetail( ({"fels"}),
	     "Er ist noch immer wolkengrau.");
  
  AddDetail( ({"westen"}),
	     "Das Biotop wirkt gemuetlich und laedt Dich ein nach Westen zu "
	     "gehen.");
  
  AddDetail( ({"biotop"}),
	     "Es ist vom Schilf eingerahmt.");
  
  AddDetail( ({"schilf"}),
	     "Es wiegt sich im Wind sanft hin und her.");
  
  AddDetail( ({"durchgangssystem","system","durchgaenge"}),
	     "Es wird von den Boegen gebildet und wirkt dadurch sehr offen.");
  
  AddDetail( ({"sonne"}),
	     "Es ist nur ihr Licht, das hier alles durchflutet.");
  
  AddDetail( ({"licht"}),
	     "Es waermt Dich und wirkt Gelb.");
  
  AddDetail( ({"gelb"}),
	     "Bei dieser Farbe musst Du an silbergrau denken.");
  
  AddDetail( ({"farbe"}),
	     "Welche Farbe meinst Du denn?");
  
  AddDetail( ({"wolkentreppe","wolkentreppe","treppe"}),
	     "Sie beginnt in der suedoestlichen Ecke und zieht sich schraeg "
	     "ueber den suedlichen Bogen hinauf. Sie schlaengelt sich entlang "
	     "der Wand und verschwindet im naechsten Stockwerk. Sie besteht "
	     "aus Wolken.");
  
  AddDetail( ({"ecke","eck","ecken"}),
	     "Welche Ecke meinst Du?");
  
  AddDetail( ({"suedoestliche Ecke"}),
	     "Hier beginnt die Wolkentreppe.");
  
  AddDetail( ({"wolken"}),
	     "Sie sind wattig weich und unfoermig. Du hoffst, dass Du nicht "
	     "durch plumpst, wenn Du sie besteigst.");
  
  AddDetail( ({"wand","waende"}),
	     "Eigentlich ist es nur ein Gewirr von gruenen Straengen. "
	     "Ansonsten gibt es fast keine Waende, weil die Boegen da sind.");
  
  AddDetail( ({"stockwerk","werk"}),
	     "Um ins naechste zu gelangen, musst Du schon hinauf gehen.");
  
  AddDetail( ({"nordoestliche Ecke"}),
	     "Hier siehst Du einen bequemen Ohrensessel, dann noch einen "
	     "huebschen Kristalltisch.");
  
  AddDetail( ({"ohrensessel","sessel"}),
	     "Er duerfte aus lauter riesengrossen, Bluetenblaettern bestehen. "
	     "Du fragst Dich, ob er robust genug ist, weil er an einer Ranke "
	     "von der Decke haengt.");
  
  AddDetail( ({"orange"}),
	     "Du bemerkst, dass dieses Orange perlgrau schimmert.");
  
  AddDetail( ({"ranke"}),
	     "Sie ist huebsch geschwungen und wirkt sehr verspielt. Der "
	     "Sessel baumelt ein wenig im Wind.");
  
  AddDetail( ({"bluetenblaettern","bluetenblaetter"}),
	     "Sie sind ganz zart und wunderschoen Orange. Es laedt doch zum "
	     "Hineinsetzen ein");
  
  AddDetail( ({"kristalltisch","tisch"}),
	     "Er ist durchsichtig und sehr filigran. Auf ihm steht eine Vase "
	     "in der frische Blumen stecken. Dein Gesicht spiegelt sich auf "
	     "seiner Platte.");

  AddDetail( ({"hineinsetzen"}),
	     "Dann musst Du es auch tun. Trau Dich einfach!!!");
  
  AddDetail( ({"vase"}),
	     "Sie ist Rot. Frische Blumen befinden sich darin.");
  
  AddDetail( ({"rot"}),
	     "Dir kommt bei dieser Farbe andauernd anthrazitgrau in den "
	     "Sinn.");
  
  AddDetail( ({"sinn"}),
	     "Unaufhoerlich nur anthrazitgrau.");
  
  AddDetail( ({"blumen"}),
	     "Sie bestehen aus violettem Glas.");
  
  AddDetail( ({"glas"}),
	     "Von oben bis unten nur Violett. Ob sie duften?");
  
  AddDetail( ({"violett"}),
	     "Du starrst die Blumen an und ploetzlich sind sie ganz "
	     "weissgrau. Du blinzelst und jetzt sind sie wieder violett.");
  
  AddDetail( ({"gesicht","platte","tischplatte"}),
	     "Du betrachtest Dein Gesicht, das ganz Blau getuencht ist.");
  
  AddDetail( ({"blau"}),
	     "Oder doch taubengrau?");
  
  AddDetail( ({"decke"}),
	     "Sie besteht aus dem gruenen Geflecht und ist undurchdringlich.");
  
  AddDetail( ({"boden"}),
	     "Er besteht aus Wolkensteinen.");
  
  AddDetail( ({"wolkensteinen","wolkensteine","steine"}),
	     "Sie sind alle einheitlich hellgrau. Doch in der nordwestlichen "
	     "Ecke bemerkst Du andere Farben.");
  
  AddDetail( ({"nordwestliche Ecke"}),
	     "Du erkennst bei naeherer Betrachtung, dass es genau zwoelf "
	     "verschiedene Farben sind.");
  
  AddDetail( ({"betrachtung"}),
	     "Mhh, sie sind sehr locker. Ob man sie druecken kann?");
  
  AddDetail( ({"farben"}),
	     "Genau genommen erkennst Du dunkelgrau, blaugrau, silbergrau, "
	     "taubengrau, titangrau, mittelgrau, weissgrau, schneegrau, "
	     "perlgrau, anthrazitgrau, glasgrau und stahlgrau. Jeder dieser "
	     "Steine hat genau nur diese eine Farbe.");
  
  AddDetail( ({"suedwestliche Ecke"}),
	     "Da ist nichts. Du musst Dich getaeuscht haben.");
  
  AddSpecialDetail( ({"nebel","glitzernebel"}), "detail_nebel");
  
  AddSpecialDetail( ({"schatten"}), "detail_schatten");
  
  AddSpecialDetail( ({"abgang","treppenabgang"}), "detail_abgang");
  
  AddSpecialDetail( ({"silberlandanziehungskraft","anziehungskraft"}), "detail_kraft");
  
  AddSpecialDetail( ({"stufen"}), "detail_stufen");
  
  AddSpecialDetail( ({"ende"}), "detail_ende");
  
  
  AddSound(DEFAULT_SOUND,"Es ist ganz still, nur die natuerlichen "
	   "Geraeusche dringen von draussen herein.");
  
  AddSound( ({"geraeusche","geraeusch"}),
	    "Geh hinaus, dann kannst Du besser an allem lauschen.");
  
  
  AddSmell(DEFAULT_SMELL,"Du riechst den blumigen Duft vom Ohrensessel her.");
  
  AddSmell( ({"duft","sessel","ohrensessel"}),
	    "Es riecht wunderbar. So blumig suess.");
  
  
  //-----Details Ende-----
  
  AddItem(NPC "irrlicht", REFRESH_DESTRUCT);
  
  AddExit("norden",ROOM "ws9");
  AddExit("osten",ROOM "ws10");
  AddExit("sueden",ROOM "ws11");
  AddExit("westen",ROOM "ws12");
  AddExit("oben",ROOM "wst2");
  
  
  AddCmd( ({"sitz","setze"}),"cmd_setzen" );
  AddCmd( ({"kletter","klettere","kraxle","kraxel"}),"cmd_klettern");
  AddCmd( ({"stubs","stubse","drueck","druecke","tipp","tippe","stups","stupse"}), "cmd_stone");
  AddCmd( ({"steig","steige"}),"cmd_steigen" );
  
}

//-----Special Details Anfang-----

string detail_nebel()	
{
  if(!present("\ngrabsch_hicks", TP))
    return "Sowas siehst Du hier nicht!\n";
  return BS("Der Nebel glitzert golden, doch erkennst Du auch einen Schatten.");
}

string detail_schatten()	
{
  if(!present("\ngrabsch_hicks", TP))
    return "Sowas siehst Du hier nicht!\n";
  return BS("Du beaeugst ihn naeher und bemerkst, dass es ein Treppenabgang ist.");
}

string detail_abgang()	
{
  if(!present("\ngrabsch_hicks", TP))
    return "Sowas siehst Du hier nicht!\n";
  return BS("Dieser Treppenabgang fuehrt verkehrt abwaerts, so als wuerde man "
    "gegen die Silberlandanziehungskraft hinunter steigen.");
}

string detail_kraft()	
{
  if(!present("\ngrabsch_hicks", TP))
    return "Sowas siehst Du hier nicht!\n";
  return BS("Du muesstest also kopfueber die Stufen hinunter steigen. Ob das "
    "funktioniert?");
}

string detail_stufen()	
{
  if(!present("\ngrabsch_hicks", TP))
    return "Sowas siehst Du hier nicht!\n";
  return BS("Das Ende der Stufen kannst Du nicht mehr erkennen.");
}

string detail_ende()	
{
  if(!present("\ngrabsch_hicks", TP))
    return "Sowas siehst Du hier nicht!\n";
  return BS("Es ist nicht zu sehen. Du koenntest aber hinab steigen um mehr zu "
    "sehen.");
}

//-----Special Details Ende-----

string show()
{
  if(present("\ngrabsch_hicks", TP))
    return "In der suedwestlichen Ecke leuchtet auffaellig ein Glitzernebel.";
  return "";
}

int cmd_setzen(string str)	
{
  notify_fail("Wo willst Du Dich hinsetzen?\n");
  
  if(!(str=="in ohrensessel"||
       str=="in sessel"||
       str=="hin"||
       str=="in ohrensessel hinein"||
       str=="in sessel hinein")) 
    return 0;
  
  write(BS("Du kuschelst dich in den bequemen Ohrensessel. Du schaukelst ein "
	   "wenig hin und her und huepfst dann wieder heraus.\n"));
  
  say(BS(TPN+" kuschelt sich in den Ohrensessel.\n"));
  
  return 1;
}

int cmd_klettern(string str)	
{
  notify_fail("Wohin willst Du klettern?\n");
  
  if(!(str=="rauf"||
       str=="hinauf"||
       str=="nach oben"||
       str=="oben")) 
    return 0;
  
  write(BS("Du kletterst auf den Schlingpflanzen nach oben.\n"));
  
  say(BS(TPN+" schwingt sich auf die Schlingpflanzen.\n"));
  
  TP->move(ROOM "wst2",M_GO, "nach oben");
  
  return 1;
}

int cmd_steigen(string str)	
{
  notify_fail("Wohin willst Du klettern?\n");
  
  if(!(str=="runter"||
       str=="hinab"||
       str=="hinunter"||
       str=="treppe runter"||
       str=="treppe hinab"||
       str=="treppe hinunter"||
       str=="auf treppen"||
       str=="auf treppen runter"||
       str=="auf treppen hinab"||
       str=="auf treppen hinunter"||
       str=="auf stufen"||
       str=="auf stufen runter"||
       str=="auf stufen hinab"||
       str=="auf stufen hinunter")) 
    return 0;
  
  //  write(BS("Du gehst waagrecht in den Nebel hinein und gehst kopfueber auf "
  //	  "den Stufen nach unten weiter.\n"));
  
  if(present("\ngrabsch_hicks", TP))
    {	 
      write(BS("Ein kleines Irrlicht flitzt herein und fluestert Dir ins Ohr: Du "
	       "kannst hier leider noch nicht hinunter, weil hier noch fest gebaut "
	       "wird! Schon ist es nach draussen verschwunden."));
      
      //  say(BS(TPN+" verschwindet waagrecht im Boden des suedwestlichen Ecks.\n"));
      //  TP->move(ROOM "xy",M_GO);
    }
  else
    {
      write(BS("Da ist nichts. Du solltest vorher die Steine antippen."));
    }
  return 1;
}

int cmd_stone(string str)
{
  object grabsch;
  string farbe, dummy;
  
  notify_fail("Was willst du antippen?\n");
  if(!str) return 0;
  
  //somit geht nur tippe <farbe> stein (an) 
  if(sscanf(str, "%s stein%s", farbe, dummy)!=2) return 0;
  
  //Hier wird anhand der Farbe unterschieden... dabei kann die farbe mit "n"
  //oder mit "r" enden... je nachdem was der spieler eintippt.
  switch(farbe)
    {
    case "anthrazitgrauen":
    case "anthrazitgrauer":
      {
	reihe+="anthrazit";
	write("Du tippst den anthrazitgrauen Stein an und er beginnt rot zu leuchten.\n");
	anz++;
      }
      break;
    case "perlgrauen":
    case "perlgrauer":
      {
	reihe+="perl";
	write("Du tippst den perlgrauen Stein an und er beginnt orange zu leuchten.\n");
	anz++;
      }
      break;
    case "silbergrauen":
    case "silbergrauer":
      {
	reihe+="silber";
	write("Du tippst den silbergrauen Stein an und er beginnt gelb zu leuchten.\n");
	anz++;
      }
      break;
    case "stahlgrauen":
    case "stahlgrauer":
      {
	reihe+="stahl";
	write("Du tippst den stahlgrauen Stein an und er beginnt gruen zu leuchten.\n");
	anz++;
      }
      break;
    case "taubengrauen":
    case "taubengrauer":
      {
	reihe+="tauben";
	write("Du tippst den taubengrauen Stein an und er beginnt blau zu leuchten.\n");
	anz++;
      }
      break;
    case "weissgrauen":
    case "weissgrauer":
      {
	reihe+="weiss";
	write("Du tippst den weissgrauen Stein an und er beginnt violett zu leuchten.\n");
	anz++;
      }
      break;
    case "schneegrauen":
    case "schneegrauer":
      {
	reihe+="schnee";
	write("Du tippst den schneegrauen Stein an und er wird schwarz.\n");
	anz++;
      }
      break;
    case "dunkelgrauen":
    case "dunkelgrauer":
      {
	reihe+="dunkel";
	write("Du tippst den dunkelgrauen Stein an und er wird schwarz.\n");
	anz++;
      }
      break;
    case "blaugrauen":
    case "blaugrauer":
      {
	reihe+="blau";
	write("Du tippst den blaugrauen Stein an und er wird schwarz.\n");
	anz++;
      }
      break;
    case "mittelgrauen":
    case "mittelgrauer":
      {
	reihe+="mittel";
	write("Du tippst den mittelgrauen Stein an und er wird schwarz.\n");
	anz++;
      }
      break;
    case "titangrauen":
    case "titangrauer":
      {
	reihe+="titan";
	write("Du tippst den titangrauen Stein an und er wird schwarz.\n");
	anz++;
      }
      break;
    case "glasgrauen":
    case "glasgrauer":
      {
	reihe+="glas";
	write("Du tippst den glasgrauen Stein an und er wird schwarz.\n");
	anz++;
      }
      break;
    default:
      {
	return 0; //Stein gibts nicht
      }
    }
  
  if(anz >= 6)
    {
      //Falls es der spieler bereits aktiviert hat...
      if(present("\ngrabsch_hicks", TP))
	{
	  reihe="";
	  anz=0;
	  write("Du hast bereits den Glitzernebel aktiviert...\n");
	  return 1;
	}
      
      if(reihe==REIHENFOLGE)
	{
	  grabsch=clone_object(OBJ "grabsch");
	  write("In der suedwestlichen Ecke leuchtet ein Glitzernebel auf.\n");
	  grabsch->move(TP, M_NOCHECK);
	  reihe="";
	  anz=0;
	  return 1;
	}
      
      reihe="";
      anz=0;
      write("Das war wohl die falsche Reihenfolge.\n");
      return 1;
    }
  
  return 1;
}

void reset()
{
  ::reset();
  reihe="";
  anz=0;
}
