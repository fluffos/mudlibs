// von Hicks
// 20.1.2004
// 
// Raum meines Gesellenstueckes "Innerer Strassenring - Wolkenstadt"

inherit "std/room";

#include "../def.h"

void create()     
{
  ::create();
  
  
  SetProp(P_INT_SHORT, "Strasse in der Wolkenstadt");
  SetProp(P_INT_LONG,
	  "Die Strasse zieht sich vom Westplatz zum Suedplatz. Auf der einen "
	  "Seite befinden sich Haeuser in verschiedensten Formen und wirken "
	  "irgendwie verspielt auf Dich. Gegenueber prangt ein filigraner Turm "
	  "hoch hinauf. Buesche grenzen den Park, der um den Turm angelegt "
	  "worden ist, von der Strasse ab. Zur rechten Hand siehst Du einen "
	  "huebschen Wasserfall, der von einem Felsen herunter fliesst und zur "
	  "linken erkennst Du ein Biotop mit Wasserrosen.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);
  
  //-----Details Anfang-----
  
  AddDetail( ({"cute","marrogh","maghnar","niri","gaya","zidane","nyx","wumanzu",
	       "elrohir","velkyn","took","aroobah","methos","katarok"}),
	      "Ja, dieser Spieler hat mir geholfen, dass dieses Gebiet noch besser "
	      "und schoener wird.");
  
  AddDetail( ({"strasse"}),
	     "Du befindest Dich auf ihr und sie zieht vom Suedplatz zum "
	     "Westplatz.");
  
  AddDetail( ({"platz"}),
	     "Welchen meinst Du, den Suedplatz oder den Westplatz?");
  
  AddDetail( ({"suedplatz"}),
	     "Er befindet sich suedwestlich von Dir und Du erkennst einen "
	     "Felsen in der Ferne. Auf der einen Seite entspringt ein "
	     "Wasserfall und auf der anderen erkennst Du ein "
	     "Trinkbecken mit einem Wasserhahn.");
  
  AddDetail( ({"fels","felsen"}),
	     "Ein grauer Fels aus Wolken. Ob der wohl weich oder hart ist?");
  
  AddDetail( ({"ferne"}),
	     "Du blickst herum und entdeckst so viele neue Details, dass Du "
	     "gar nicht weisst wo Du zuerst hingehen sollst.");
  
  AddDetail( ({"detail","details"}),
	     "Am besten Du faengst beim Boden an und arbeitest Dich bis zum "
	     "Himmel hinauf.");
  
  AddDetail( ({"westplatz"}),
	     "Er befindet sich nordwestlich von Dir und Du erkennst eine "
	     "Statue auf dem Platz.");
  
  AddDetail( ({"wasserfall"}),
	     "Er plaetschert ruhig vor sich hin. Ein lauschiges Plaetzchen.");
  
  AddDetail( ({"plaetzchen"}),
	     "Du bekommst Hunger nach Plaetzchen.");
  
  AddDetail( ({"hunger"}),
	     "Dein Bauch knurrt.");
    
  AddDetail( ({"bauch"}),
	     "*grrrrrrrr*");
  
  AddDetail( ({"becken","trinkbecken","wasserbecken"}),
	     "Eine Ausbuchtung zieht sich aus dem Felsen und ist voll mit "
	     "Wasser gefuellt, das aus dem Wasserhahn hinein fliesst.");
  
  AddDetail( ({"ausbuchtung"}),
	     "Ein einfaches Wasserbecken schoen verziert.");
  
  AddDetail( ({"wasser"}),
	     "Soweit Du es erkennen kannst, ja, es ist Wasser.");
  
  AddDetail( ({"wasserhahn","hahn"}),
	     "Diese Rohr sticht aus dem Felsen heraus und hindurch fliesst "
	     "Wasser. Das duerfte das gleiche Wasser wie aus dem Wasserfall "
	     "sein.");
  
  AddDetail( ({"rohr"}),
	     "Ein rundes, hohles Rohr aus dem Wasser fliesst.");
  
  AddDetail( ({"statue"}),
	     "Du musst schon hingehen, wenn Du sie sehen willst.");
  
  AddDetail( ({"seite"}),
	     "Auf der einen Seite befinden sich die Haeuser und auf der "
	     "anderen der Park.");
  
  AddDetail( ({"haeuser"}),
	     "Die Haeuser glitzern und glaenzen alle in verschiedensten "
	     "Farben. Einige bestehen nur aus Glas, andere aus Wolkensteinen "
	     "und manche aus beidem.");
  
  AddDetail( ({"farben"}),
	     "Das sind alle moeglichen Farben des Regenbogens. Rot, Orange, "
	     "Gelb, Gruen, Blau, Violett.");
  
  AddDetail( ({"gelb","orange","rot","violett","blau","gruen"}),
	     "Das ist ein reines Farbfeuerwerk. Von ueberall her begeistern "
	     "Dich die Farben.");
  
  AddDetail( ({"farbfeuerwerk","feuerwerk","werk"}),
	     "Du gibst Dich den Farben hin und schaust begeistert herum.");
  
  AddDetail( ({"glas"}),
	     "Das Glas kann transparent, milchig oder uneben sein. Je nachdem "
	     "funkelt oder schimmert es. Hin und wieder zieren Kletterpflanzen "
	     "die Waende.");
  
  AddDetail( ({"pflanzen"}),
	     "Meinst Du die Kletterpflanzen oder die Schlingpflanzen?");
  
  AddDetail( ({"kletterpflanzen"}),
	     "Sie wuchern ueber manche Waende und schimmern gruen-weisslich. "
	     "Sie haben geschwungene, glatte Blaetter.");
  
  AddDetail( ({"blaetter"}),
	     "Sie schmuecken manche Haeuser und andere nicht, aber nichts "
	     "desto trotz rascheln sie beruhigend im Wind.");
  
  AddDetail( ({"rascheln"}),
	     "Du koenntest an ihm ja lauschen?");
  
  AddDetail( ({"wind"}),
	     "Der Wind wirbelt sich ein wenig auf und verlaesst die Strasse "
	     "wieder.");
  
  AddDetail( ({"wand","waende"}),
	     "Die Waende bestehen aus Glas, Wolken oder aus beidem. "
	     "Kletterpflanzen zieren manche Haeuser.");
  
  AddDetail( ({"form","formen"}),
	     "Manche sind rechteckig, andere rund, andere wieder"
	     " kuppelfoermig. Manche sind verschlossen, andere offen, andere "
	     "wiederrum haben gar keine Tueren und Fenster.");
  
  AddDetail( ({"tuer","tueren","fenster"}),
	     "Wie gesagt, nicht alle Haeuser haben welche.");
  
  AddDetail( ({"turm"}),
	     "Der Turm liegt gruen-weisslich mitten im Park und erscheint Dir "
	     "fast wie aus vielen Schlingpflanzen. Die rosa Glaskuppel passt "
	     "sich oberhalb farblich wunderschoen an den Turm an.");
  
  AddDetail( ({"schlingpflanzen"}),
	     "Um dies genauer zu beurteilen, musst Du schon naeher hingehen!");
  
  AddDetail( ({"glaskuppel","kuppel"}),
	     "Sie funkelt wunderschoen rosa auf der Turmspitze.");
  
  AddDetail( ({"turmspitze","spitze"}),
	     "Da thront die Glaskuppel wie ein Juwel.");
  
  AddDetail( ({"juwel"}),
	     "Du beobachtest das Glitzern in der Sonne und erkennst, wie Dir "
	     "Jemand zu winkt.");
  
  AddDetail( ({"glitzern", "juwele"}),
	     "So funkeln doch Juwele?!");
  
  AddDetail( ({"jemand"}),
	     "So gut siehst Du nicht, dass Du erkennen kannst, wer das ist.");
  
  AddDetail( ({"park"}),
	     "Buesche und Blumen erkennst Du auf der Wiese. Du siehst auch, "
	     "dass Du ueber den Park zum Turm gelangst und andererseits "
	     "kannst Du Dich dort sicher gut erholen.");
  
  AddDetail( ({"buesche","bueschen"}),
	     "Die Buesche zaeunen den Park ein.");
  
  AddDetail( ({"blumen"}),
	     "Die Blumen gedeihen in allen Farben.");
  
  AddDetail( ({"wiese"}),
	     "Die Wiese glitzert gruenlich und wirkt wie ein dauerndes "
	     "eiskaltes Funkelmeer.");
  
  AddDetail( ({"funkelmeer","meer"}),
	     "Es sieht so aus als waere sie eingefroren. Du streichst darueber "
	     "und stellst fest, dass sie gar nicht kalt ist.");
  
  AddDetail( ({"hand"}),
	     "Du singst: You put your right hand in, you put your right hand "
	     "out, in, out, in out, shake it all arround. When you do the "
	     "Hokey Pokey, you can turn it all arround. That`s what it`s all "
	     "about.");
  
  AddDetail( ({"hokey pokey"}),
	     "Du singst den Hokey Pokey Song und dann kennst Du ihn nicht? "
	     "Schaem Dich!");
  
  AddDetail( ({"song"}),
	     "So wie Du hier mit den Hueften schwingst solltest Du der "
	     "Bardengilde beitreten.");
  
  AddDetail( ({"gilde","bardengilde"}),
	     "Es wird Zeit, dass sie endlich angehaengt wird.");
  
  AddDetail( ({"zeit"}),
	     "Sie wird aber noch viel Zeit brauchen bis sie fertig ist.");
  
  AddDetail( ({"hueften","huefte"}),
	     "Du hast den Song intus und kannst einfach nicht aufhoeren mit "
	     "den Hueften weiter zu wackeln.");
  
  AddDetail( ({"biotop"}),
	     "Der Biotop ist wie ein kleiner Teich mit Wasserrosen und ein "
	     "wenig Schilf.");
  
  AddDetail( ({"teich"}),
	     "Du solltest Dir mal schnell Deine Intelligenz erhoehen, wenn Du "
	     "sowas nicht weisst.");
  
  AddDetail( ({"intelligenz"}),
	     "Tippe: hilfe attribute");
  
  AddDetail( ({"wasserrosen","rosen"}),
	     "Sie sind zartrosa und stehen in der vollen Bluete. Sie "
	     "schwimmen seelenruhig auf der Wasseroberflaeche.");
  
  AddDetail( ({"bluete","blueten"}),
	     "Sie sind geoeffnet.");
  
  AddDetail( ({"wasseroberflaeche","oberflaeche"}),
	     "Sie ist spiegelglatt, doch manchmal ist sie von einem "
	     "Wasserlaeufer kurz verschwommen.");
  
  AddDetail( ({"wasserlaeufer","laeufer"}),
	     "Sie flitzen blitzschnell ueber die Oberflaeche.");
  
  AddDetail( ({"schilf"}),
	     "Es wiegt sich im Wind hin und her.");  
  
  AddDetail( ({"boden"}),
	     "Der Boden ist von wattigen Wolkensteinen gesaeumt. Du sinkst "
	     "beim gehen immer ein wenig ein. Ploetzlich stolperst Du ueber "
	     "einen losen Wolkenstein.");
  
  AddDetail( ({"wolkensteine","wolkensteinen","steine","steinen"}),
	     "Sie bestehen aus Wolken, wie fast alles hier.");
  
  AddDetail( ({"wolken"}),
	     "Sie bestehen eigentlich aus feuchter Luft.");
  
  AddDetail( ({"wolkenstein","stein"}),
	    "Du ueberpruefst ihn und er ist wirklich lose. Vielleicht kann "
	     "man ihn ein wenig lockern?");
  
  AddDetail( ({"himmel"}),
	     "Der Himmel ist wolkenlos und blau. Die Sonne laechelt Dir "
	     "munter zu und ein Regenbogen rahmt den Himmel ein.");

  AddDetail( ({"regenbogen","bogen","regenbogens"}),
	     "Der Regenbogen zieht sich ueber den Himmel und schimmert in "
	     "allen Farben.");
  
  AddDetail( ({"sonne"}),
	     "Die Sonne laechelt Dir zu und waermt die Luft etwas an, weil es "
	     "doch normalerweise viel kaelter hier oben waere.");
  
  AddDetail( ({"luft"}),
	     "Die Luft ist ganz klar und eigentlich kuehl, wenn da nicht die "
	     "Sonne waere.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	     "Du huepfst auf einem Bein und freust Dich hier im Silberland zu "
	     "sein.");

  AddDetail( ({"bein"}),
	     "Und zur Abwechselung auf dem anderen, sonst faengt es an weh zu "
	     "tun.");

  AddDetail( ({"abwechselung"}),
	     "Auf einem Bein allein ist langweilig.");
  
  AddDetail( ({"silberland","land"}),
	     "Es ist schon riesig. Findest Du nicht?");
  
  AddDetail( ({"duft","geruch"}),
	     "Vieles kannst Du untersuchen, aber das geht wirklich nicht.");
  
  AddDetail( ({"marshmallow"}),
	     "Es sind ja gar keine da, nur weil Du sie riechen kannst.");
  
  AddDetail( ({"ausblick","midas","kirchtuermchen","ebene","hobbitdorf",
		 "weinbergen","weinberge","kristallwald","blick","gebirge",
		 "wueste","menschen","ameisen","hoehlen","hoehle","wald",
		 "haeuschen"}),
	     "Du koenntest nochmals einen Blick durch die Oeffnung wagen.");
  
  AddDetail( ({"oeffnung"}),
	     "Dazu musst Du den Stein lockern.");
  
  AddDetail( ({"kopf"}),
	     "Er ist ein wenig erroetet.. Muss wirklich toll gewesen sein.");
  
  
  AddSmell(DEFAULT_SMELL, "Es riecht nur nach klarer Luft, die fast keinen "
	   "Geruch mit sich bringt.");  
  
  AddSmell( ({"geruch"}),
	    "Es riecht ein wenig nach Marshmallows.");
  
  AddSmell( ({"marshmallow","marshmallows"}),
	    "Leicht suesslich, hast Du sicher schon mal probiert.");			  
  
  AddSmell( ({"luft"}),
	    "Du schnupperst an der klaren Luft, der sich ein wenig mit dem "
	    "suesslichen Duft der Blumen vermischt.");
  
  AddSmell( ({"duft","blumen"}),
	    "So zart und doch so frisch. Du wunderst Dich, warum Du hier nicht "
	    "herziehst.");
  
  
  AddSound(DEFAULT_SOUND, "Der Wind wirbelt sich manchmal auf und laesst die "
	   "Blaetter rascheln.");
  
  AddSound( ({"wind"}),
	    "Der Wind wirbelt um Dich herum, und versucht Dich von hier fort zu "
	    "ziehen.");
  
  AddSound( ({"blaetter","rascheln"}),
	    "Es beruhigt Dich ein wenig und laesst Dich entspannter wirken.");
  
  AddSound( ({"plaetschern"}),
	    "Plitschplatsch");
  
  //-----Details Ende-----
  
  AddExit("nordwesten",ROOM "ws7");
  AddExit("suedosten",ROOM "ws5");
  AddExit("norden",ROOM "ws12");
  AddExit("osten",ROOM "ws11");
  
  
  AddCmd( ({"locker","lockere"}),"cmd_lockern" );
  AddCmd( ({"wink","winke"}),"cmd_winken" );
  
}

int cmd_lockern(string str)
{
  
  notify_fail("Was willst Du lockern?\n");
  
  if(!(str=="stein"||
       str=="wolkenstein")) 
    return 0;
  
  write(BS("Du lockerst den Wolkenstein und ein gigantischer Ausblick "
	   "offeriert sich Dir. Du erkennst das ganze Silberland. Midas mit "
	   "seinem Kirchtuermchen in der Ebene, das Hobbitdorf mit seinen "
	   "idyllischen Weinbergen und den funkelnden Kristallwald. Dein Blick "
	   "schweift vom Gebirge bis in die Ebene zurueck, die bei der grossen, "
	   "weiten Wueste endet. Du siehst viele Silberlaender wie Ameisen "
	   "herumwandern, die entweder in Hoehlen, im Wald oder in kleinen "
	   "Haeuschen verschwinden und wieder erscheinen."));
  
  say(BS(TPN+" lockert einen Stein im Boden und blickt durch die entstandene "
	 "Oeffnung. Nach einiger Zeit zieht "+TP->QueryPronoun(WER)+" den Kopf "
	 "mit einem strahlenden Laecheln wieder heraus und verschliesst das "
	 "Loch sorgfaeltig mit dem Stein."));
  
  return 1;
}


int cmd_winken(string str)
{
  
  notify_fail("Wem willst Du zurueck winken?\n");
  
  if(!(str=="jemand in turmspitze zurueck"||
       str=="zurueck"||
       str=="jemand zurueck"||
       str=="jemand im turm zurueck"||
       str=="jemand zu")) 
    return 0;
  
  write(BS("Du winkst mit einem Laecheln diesem Jemand retour."));
  
  say(BS(TPN+" winkt."));
  
  return 1;
}
