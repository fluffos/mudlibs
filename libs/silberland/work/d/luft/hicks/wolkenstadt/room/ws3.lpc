// von Hicks
// 20.1.2004
// 
// Raum meines Gesellenstueckes "Ostplatz - Wolkenstadt"

inherit "std/room";

#include "../def.h"

void create()    
{
  ::create();
  
  
  SetProp(P_INT_SHORT, "Ostplatz in der Wolkenstadt");
  SetProp(P_INT_LONG,
	  "Du befindest Dich auf dem Ostplatz von Liliandor. Eine Statue "
	  "faellt Dir sofort auf, da sie aus Milchglas besteht und "
	  "irgendwie lebendig wirkt. Dahinter erkennst du den wunderschoen "
	  "angelegten Park in dessen Mitte ein filigraner Turm steht. Direkt "
	  "hinter der Statue erkennst du ein Becken, das mit Nebel "
	  "zugedeckt ist. Der Strasse folgend kommst du entweder zum Palast "
	  "oder zum Suedplatz." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);
  
  //-----Details Anfang-----
  
  AddDetail( ({"cute","marrogh","maghnar","niri","gaya","zidane","nyx","wumanzu",
	       "elrohir","velkyn","took","aroobah","methos","katarok"}),
	      "Ja, dieser Spieler hat mir geholfen, dass dieses Gebiet noch besser "
	      "und schoener wird.");
  
  AddDetail( ({"ostplatz","platz"}), 
	     "Du befindest Dich auf dem Ostplatz von Liliandor. Eine Statue "
	     "faellt Dir sofort auf, da sie aus Milchglas besteht und "
	     "irgendwie lebendig wirkt. Dahinter erkennst du den wunderschoen "
	     "angelegten Park in dessen Mitte ein filigraner Turm steht. "
	     "Direkt hinter der Statue erkennst du ein Becken, das mit "
	     "Nebel zugedeckt ist. Der Strasse folgend kommst du entweder zum "
	     "Palast oder zum Suedplatz." );
  
  AddDetail( ({"liliandor"}),
	     "Liliandor ist die hellste und glitzerndste Stadt, die Du je "
	     "gesehen hast. Du fuehlst Dich so frei auf den Wolken.");
  
  AddDetail( ({"stadt","wolkenstadt"}),
	     "Sie hat Dich fuer sich eingenommen und Du moechtest nie wieder "
	     "weg von hier.");
  
  AddDetail( ({"wolke","wolken"}),
	     "Sie bestehen aus feuchter Luft.");
  
  AddDetail( ({"farben","pastellfarben","farbe"}),
	     "Das sind alle moeglichen Farben des Regenbogens. Rot, Orange, "
	     "Gelb, Gruen, Blau, Violett.");
  
  AddDetail( ({"gelb","orange","rot","violett","blau","gruen"}),
	     "Das ist ein reines Farbfeuerwerk. Von ueberall her begeistern "
	     "Dich die Farben.");
  
  AddDetail( ({"farbfeuerwerk","feuerwerk","werk"}),
	     "Vor Dir explodiert ein wahres Feuerwerk an Farben. Du weisst gar "
	     "nicht, wohin Du zuerst schauen sollst.");
  
  AddDetail( ({"regenbogen","regenbogens","bogen"}),
	     "Ueber Dir zieht sich ein Regenbogen in allen Farben. Du siehst "
	     "kleine Puenktchen, die sich auf dem Bogen bewegen.");
  
  AddDetail( ({"puenktchen"}),
	     "Feen flattern auf dem Regenbogen herum.");
  
  AddDetail( ({"feen","luftfeen"}),
	     "Sie wohnen hier oben im Silberland.");
  
  AddDetail( ({"silberland","land"}),
	     "Du befindest Dich jetzt hier im S i l b e r l a n d "
	     "(sl.mud.at:4711)! ");
  
  AddDetail( ({"sonne"}),
	     "Die Sonne brennt ziemlich herunter und waermt die Luft auf, "
	     "ansonsten waere es wirklich bitterkalt.");
  
  AddDetail( ({"glas"}),
	     "Es ist transparent, milchig oder uneben und spiegelt das "
	     "Sonnenlicht wieder und alles wird erleuchtet und funkelt.");
  
  AddDetail( ({"sonnenlicht","licht"}),
	     "Die Stadt wird vom Licht durchflutet und von den Glaswaenden "
	     "reflektiert.");
  
  AddDetail( ({"milchglas"}),
	     "Es ist trueb und nicht durchsichtig, weil es aufgeraut wurde.");
 
  AddDetail( ({"wand","glaswand","waende","glaswaende","waenden","glaswaenden"}),
	     "Die Waende bestehen aus Glas, Wolkensteinen oder aus beidem. ");
  
  AddDetail( ({"ambrosia"}),
	     "Mhh, dies muss wohl die unsterbliche Ambrosia sein.");
  
  AddDetail( ({"statue"}),
	     "Bei naeherer Betrachtung stellst Du fest, dass diese Statue "
	     "eine Fee sein muss. Du fuehlst die raue und undurchsichtige "
	     "Oberflaeche und wanderst weiter zu dem Sockel, in dem Du fast "
	     "versinkst.");
  
  AddDetail( ({"betrachtung"}),
	     "Du musterst die Statue eingehend und wirklich, es ist eine Fee. "
	     "Du erkennst sie an ihren Fluegeln.");
  
  AddDetail( ({"fluegel","fluegeln"}),
	     "Damit koennen sie sich in der Luft fortbewegen. Oder was "
	     "dachtest Du denn?");
  
  AddDetail( ({"fee"}),
	     "Es muss sich schon um eine besondere Fee handeln, wenn sie hier "
	     "eine eigene Statue erhaelt. Sie muss wohl einige Jahre hinter "
	     "sich haben. Sie wirkt zerbrechlich und alt, aber dennoch "
	     "strahlt sie eine Vitalitaet, Tugend und Weisheit aus. Ihr Haar "
	     "ist straehnig zu einem huebschen Knoten gebunden und ihr sanftes "
	     "Laecheln verzaubert Dich.");
  
  AddDetail( ({"jahre"}),
	     "So um die 60?");
  
  AddDetail( ({"60"}),
	     "Ja, Du schaetzt sie so auf 60 Jahre. Aber Du weisst, dass Feen "
	     "viel aelter werden.");
  
  AddDetail( ({"feen"}),
	     "Sie werden weitaus aelter als manch ein anderer. Man sieht es "
	     "ihnen aber nicht an.");
  
  AddDetail( ({"vitalitaet","tugend","weisheit"}),
	     "Das sind eigentlich alles Eigenschaften, die Du gebrauchen "
	     "koenntest. Vielleicht suchst Du sie mal?");
  
  AddDetail( ({"eigenschaften"}),
	     "Tja, wer suchet, der findet.");
  
  AddDetail( ({"haar"}),
	     "Es besteht aus Glas und Du staunst darueber, weil man jede "
	     "Straehne genau erkennt. Du bewunderst dieses Meisterwerk.");
  
  AddDetail( ({"meisterwerk","werk"}),
	     "Wenn die Statue nicht aus Milchglas bestuende, dann wuerde man "
	     "glauben, hier war ein Barbier am werken.");
  
  AddDetail( ({"barbier"}),
	     "Vielleicht hat hier ein Barbier gearbeitet? So professionell "
	     "wie das Haar hoch gesteckt wurde?");
  
  AddDetail( ({"straehne"}),
	     "Sie sind so hauchduenn und wurden wunderbar zu einem Knoten "
	     "verschlungen. Du wunderst Dich, dass noch keine gebrochen ist.");
  
  AddDetail( ({"knoten"}),
	     "Der Knoten sitzt im Nacken und ist von einer Perlenkette "
	     "geschmueckt.");
  
  AddDetail( ({"nacken"}),
	     "Dort wo der Knoten sitzt, da ist der Nacken.");
  
  AddDetail( ({"Perlenkette","kette"}),
	     "Lauter verschiedene winzige Perlen sind aus Glas geformt "	    
	     "worden.");

  AddDetail( ({"perlen"}),
	     "Du siehst jede Perle in einer anderen Farbe schimmern.");

  AddDetail( ({"perle"}),
	     "Kugelig geformte Perlen. Waeren sie nicht aus Glas, dann waeren "
	     "es sicher echte Perlen.");
  
  AddDetail( ({"laecheln"}),
	     "Du kannst gar nicht anders und musst automatisch zurueck "
	     "laecheln.");

  AddDetail( ({"oberflaeche"}),
	     "Sie ist milchig, rauh und undurchsichtig, beinahe kuehl. Du "
	     "vermerkst ein kraftvolles, gelbes Pulsieren, als waere die "
	     "Statue lebendig.");
  
  AddDetail( ({"pulsieren"}),
	     "Es muss magisch sein!");
  
  AddDetail( ({"sockel"}),
	     "Der Sockel besteht aus Wolken. Du entdeckst eine winzig kleine, "
	     "glaeserne Plakette.");
  
  AddDetail( ({"plakette"}),
	     "Du kannst sie lesen.");
  
  AddDetail( ({"turm"}),
	     "Der Turm liegt gruen-weisslich mitten im Park und erscheint Dir "
	     "fast wie aus vielen Schlingpflanzen. Die rosa Glaskuppel passt "
	     "sich oberhalb farblich wunderschoen an den Turm an.");
  
  AddDetail( ({"mitte"}),
	     "Also, wo siehst Du den Turm? Jaaaa, und genau dort ist auch die "
	     "Mitte des Parks.");
  
  AddDetail( ({"schlingpflanzen","pflanzen"}),
	     "Du musst durch den Park gehen, um sie genauer betrachten zu "
	     "koennen!");
  
  AddDetail( ({"glaskuppel","kuppel"}),
	     "Wer da wohl oben wohnen mag? Irgendwie bist Du neidisch, weil "
	     "es herrlich sein muss so weit oben zu wohnen.");
  
  AddDetail( ({"parks","park"}),
	     "Buesche, Blumen und ein Nebelbecken erkennst Du. Du "
	     "siehst auch, dass Du ueber den Park zum Turm gelangst und "
	     "andererseits kannst Du Dich dort sicher gut erholen.");
  
  AddDetail( ({"buesche","bueschen","blumen"}),
	     "Die Buesche zaeunen den Park ein und die Blumen gedeihen in "
	     "allen Farben.");
  
  AddDetail( ({"nebelbecken","becken"}),
	     "Das Nebelbecken liegt idyllisch zwischen den Bueschen. "
	     "Nebelschwaden ziehen sich vom Becken ueber die Wiese.");
  
  AddDetail( ({"nebelschwaden","schwaden","nebel"}),
	     "Ein bisschen unheimlich wirkt es schon, weil der Nebel "
	     "irgendwie alles zu verschlucken scheint.");
  
  AddDetail( ({"wiese"}),
	     "Die Wiese schimmert matt gruen und ist von einer "
	     "Kristallschicht ueberzogen. Auffaellig ist die Parkbank, die "
	     "vor dem Becken steht.");
  
  AddDetail( ({"kristallschicht","schicht"}),
	     "Die Wiese wirkt wie gefroren, aber als Du drueber streichst "
	     "bemerkst Du, dass sie nur so aussieht.");
  
  AddDetail( ({"bank","parkbank"}),
	     "Sie ladet ein, sich hin zu setzen um ein wenig von kleinen "
	     "Luftfeen traeumen zu koennen. Nur die Buesche versperren Dir "
	     "den Weg.");

  AddDetail( ({"weg"}),
	     "Es gibt bestimmt einen anderen Weg zur Parkbank.");
  
  AddDetail( ({"boden"}),
	     "Der Boden ist von wattigen Wolkensteinen gesaeumt. Du sinkst "
	     "beim gehen immer ein wenig ein. Das animiert Dich doch glatt "
	     "zum springen.");
  
  AddDetail( ({"wolkensteine","wolkensteinen","steine","steinen"}),
	     "Sie bestehen aus Wolken, wie fast alles hier.");
  
  AddDetail( ({"himmel"}),
	     "Der Himmel wird von einem Regenbogen geziert und ist wolkenlos "
	     "und blau. Die Sonne laechelt Dir munter zu.");
  
  AddDetail( ({"luft"}),
	     "Die Luft ist ganz klar und eigentlich kuehl, wenn da nicht die "
	     "Sonne waere.");
  
  AddDetail( ({"strasse"}),
	     "Ein zieht nach Nordwesten und eine nach Suedwesten.");
  
  AddDetail( ({"nordwesten"}),
	     "Im Nordwesten befindet sich der Palast.");
  
  AddDetail( ({"suedwesten"}),
	     "Im Suedwesten erkennst Du den Suedplatz.");
  
  AddDetail( ({"Palast"}),
	     "Er funkelt im Sonnenlicht in der Ferne.");
  
  AddDetail( ({"ferne"}),
	     "Du blickst in die Ferne und bist von den Farben fast geblendet.");
  
  AddDetail( ({"suedplatz"}),
	     "Ein Fels ziert den Suedplatz und wirst neugierig. Du solltest "
	     "Dir das mal naeher ansehen.");
  
  AddDetail( ({"fels","felsen"}),
	     "Er ist graeulich und besteht anscheinend aus Wolken.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	     "Ja, das bist Du!");
  
  AddDetail( ({"hicks"}),
	     "Du denkst Dir, so eine bloede Kuh.");
  
  AddDetail( ({"kuh"}),
	     "Du hoerst ein lautes MUUUH ueber dem Platz erschallen.");
  
  AddDetail( ({"muuuh"}),
	     "Ja, das passt zu ihr.");
  
  AddDetail( ({"scherz"}),
	     "Warum immer ich?, denkst Du Dir.");
  
  
  AddSmell(DEFAULT_SMELL, "Du riechst Blumen und auch klare Luft.");  
  
  AddSmell( ({"blumen","blume"}),
	    "Sie duften frisch und suess.");
  
  AddSmell( ({"luft"}),
	    "Du schnupperst an der klaren Luft und fuehlst Dich frei.");
  
  
  AddSound(DEFAULT_SOUND, "Der Wind haucht ueber den Platz und Du hoerst "
	   "auch leises Vogelgezwitscher.");

  AddSound( ({"wind","hauch","hauchen","haucht"}),
	    "Fast haette er Dich magisch verfuehrt ihm zu folgen!!");
  
  AddSound( ({"vogelgezwitscher","gezwitscher"}),
	    "Es kommt von suedwesten.");
  
  AddSound( ({"platz"}),
	    "Du hoerst nur den Wind, der ueber den Platz fegt.");
  
  
  AddReadDetail("plakette",
		"Ambrosia");
  
  //-----Details Ende-----
  
  AddExit("suedwesten",ROOM "ws4");
  AddExit("nordwesten",ROOM  "ws2");
  //  AddExit("osten","wsx");
  
  
  AddCmd( ({"such","suche"}),"cmd_suchen");
  AddCmd( ({"setze","sitz"}),"cmd_parkbank");
  
}

int cmd_suchen(string str)	
{
  
  notify_fail("Was willst Du suchen?\n");
  
  if(!(str=="eigenschaft"||
       str=="eigenschaften"||
       str=="vitalitaet"||
       str=="tugend"||
       str=="weisheit")) 
    return 0;
  
  write(BS("Du suchst in jeder Ecke, aber du findest nichts. Du rufst nach "
	   "diesen Eigenschaften, aber Du bekommst keine Antwort. Hicks hat "
	   "sich wohl mit Dir einen Scherz erlaubt."));
  
  say(BS(TPN+" sucht jede Ecke und jeden Winkel ab und rufst nach Vitalitaet, "
	 "Tugend und Weisheit. Du schuettelst den Kopf und denkst Dir, dass "
	 " "+TP->QueryPronoun(WER)+" nicht richtig tickt."));
  
  return 1;
}


int cmd_parkbank(string str)	
{
  
  notify_fail(BS("Egal wohin Du Dich setzen willst, hier geht das bestimmt nicht."));
  
  return 0;
}
