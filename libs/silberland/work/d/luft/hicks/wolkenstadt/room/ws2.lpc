// von Hicks
// 20.1.2004
// 
// Raum meines Gesellenstueckes "Innerer Strassenring - Wolkenstadt"

inherit "std/room";

#include "../def.h"

int blatt=1;

void create()
{
  ::create();
  
  
  SetProp(P_INT_SHORT, "Strasse in der Wolkenstadt");
  SetProp(P_INT_LONG,
	  "Die Strasse zieht sich vom Nordplatz zum Ostplatz. Auf der einen "
	  "Seite befinden sich Haeuser in verschiedensten Formen und wirken "
	  "irgendwie verspielt auf Dich. Gegenueber prangt ein filigraner "
	  "Turm hoch hinauf. Buesche grenzen den Park, der um den Turm "
	  "angelegt worden ist, von der Strasse ab. Zur rechten Hand siehst "
	  "Du einen Springbrunnen und zur linken erkennst Du ein idyllisches "
	  "Nebelbecken." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);
  
  
  //-----Details Anfang-----
  
  AddDetail( ({"cute","marrogh","maghnar","niri","gaya","zidane","nyx","wumanzu",
	       "elrohir","velkyn","took","aroobah","methos","katarok"}),
	      "Ja, dieser Spieler hat mir geholfen, dass dieses Gebiet noch besser "
	      "und schoener wird.");

  AddDetail( ({"strasse"}),
	     "Du befindest Dich auf ihr und sie zieht vom Nordplatz zum "
	     "Ostplatz.");
  
  AddDetail( ({"platz"}),
	     "Welchen meinst Du, den Nordplatz oder den Ostplatz?");
  
  AddDetail( ({"nordplatz"}),
	     "Er befindet sich nordwestlich von Dir und Du siehst das "
	     "Palasttor praechtig in der Sonne glitzern.");
  
  AddDetail( ({"ostplatz"}),
	     "Er befindet sich suedoestlich von Dir und Du erkennst eine "
	     "Statue auf dem Platz.");
  
  AddDetail( ({"palasttor","tor"}),
	     "Du musst schon hingehen, wenn Du es sehen willst.");
  
  AddDetail( ({"statue"}),
	     "Du musst schon hingehen, wenn Du sie sehen willst.");
  
  AddDetail( ({"seite"}),
	     "Auf der einen Seite befinden sich die Haeuser und auf der "
	     "anderen der Park.");
  
  AddDetail( ({"haeuser"}),
	     "Die Haeuser glitzern und glaenzen alle in verschiedensten "
	     "Farben. Einige bestehen nur aus Glas, andere aus Wolkensteinen "
	     "und manche aus beidem.");
  
  AddDetail( ({"farben"}),
	     "Das sind alle moeglichen Farben des Regenbogens. Rot, Orange, "
	     "Gelb, Gruen, Blau, Violett.");
  
  AddDetail( ({"gelb","orange","rot","violett","blau","gruen"}),
	     "Das ist ein reines Farbfeuerwerk. Von ueberall her begeistern "
	     "Dich die Farben.");
  
  AddDetail( ({"farbfeuerwerk","feuerwerk","werk"}),
	     "Du gibst Dich den Farben hin und schaust begeistert herum.");
  
  AddDetail( ({"glas"}),
	     "Das Glas kann transparent, milchig oder uneben sein. Je nachdem "
	     "funkelt oder schimmert es. Hin und wieder zieren Kletterpflanzen "
	     "die Waende.");
  
  AddDetail( ({"pflanzen"}),
	     "Meinst Du die Kletterpflanzen oder die Schlingpflanzen?");
  
  AddDetail( ({"kletterpflanzen"}),
	     "Sie wuchern ueber manche Waende und schimmern gruen-weisslich. "
	     "Sie haben geschwungene, glatte Blaetter.");
  
  AddDetail( ({"blaetter"}),
	     "Sie geben den Waenden ein naturverbundenes Bild.");
  
  AddDetail( ({"bild"}),
	     "Waehrend Du das Bild vor Dir betrachtest, entdeckst Du ein "
	     "Blatt, das sich nicht mit dem Wind bewegt.");
  
  AddDetail( ({"wind"}),
	     "Der Wind streicht sanft ueber die Strasse und schmeichelt ueber "
	     "Deine Haut.");
  
  AddDetail( ({"haut"}),
	     "Mhhh, Du geniesst es einfach.");
  
  AddDetail( ({"blatt"}),
	     "Irgendwie wirkt das Blatt schwer und daher bewegt es sich kaum. "
	     "Es duerfte sich etwas dahinter verbergen.");
  
  AddDetail( ({"wand","waende"}),
	     "Die Waende bestehen aus Glas, Wolkensteinen oder aus beidem. "
	     "Kletterpflanzen zieren manche Haeuser.");
  
  AddDetail( ({"form","formen"}),
	     "Manche sind rechteckig, andere rund, andere wieder"
	     " kuppelfoermig. Manche sind verschlossen, andere offen, andere "
	     "wiederrum haben gar keine Tueren und Fenster.");
  
  AddDetail( ({"tuer","tueren","fenster"}),
	     "Wie gesagt, nicht alle Haeuser haben welche.");
  
  AddDetail( ({"turm"}),
	     "Der Turm liegt gruen-weisslich mitten im Park und erscheint Dir "
	     "fast wie aus vielen Schlingpflanzen. Die rosa Glaskuppel passt "
	     "sich oberhalb farblich wunderschoen an den Turm an.");
  
  AddDetail( ({"schlingpflanzen"}),
	     "Um dies genauer zu beurteilen musst Du schon naeher hingehen!");
  
  AddDetail( ({"glaskuppel","kuppel"}),
	     "Sie funkelt wunderschoen rosa auf der Turmspitze.");
  
  AddDetail( ({"turmspitze","spitze"}),
	     "Da thront die Glaskuppel.");
  
  AddDetail( ({"park"}),
	     "Buesche und Blumen erkennst Du auf der Wiese. Du siehst auch, "
	     "dass Du ueber den Park zum Turm gelangst und andererseits "
	     "kannst Du Dich dort sicher gut erholen.");
  
  AddDetail( ({"buesche","bueschen"}),
	     "Die Buesche zaeunen den Park ein.");
  
  AddDetail( ({"blumen"}),
	     "Die Blumen gedeihen in allen Farben.");
  
  AddDetail( ({"wiese"}),
	     "Die Wiese ist zwar gruen, aber hat einen kristallartigen Glanz.");
  
  AddDetail( ({"glanz"}),
	     "Es sieht so aus als waere sie eingefroren. Du streichst darueber "
	     "und stellst fest, dass sie gar nicht kalt ist.");
  
  AddDetail( ({"springbrunnen","brunnen","springbrunnens","brunnens"}),
	     "Er plaetschert munter vor sich hin und schimmert in allen "
	     "Farben.");

  AddDetail( ({"wasser"}),
	     "Das Wasser reflektiert die Sonne und blendet mit "
	     "verschiedensten Farben.");
  
  AddDetail( ({"nebelbecken","becken"}),
	     "Das Nebelbecken liegt idyllisch zwischen den Bueschen. "
	     "Nebelschwaden ziehen sich vom Becken ueber die Wiese.");
  
  AddDetail( ({"nebelschwaden","schwaden","nebel"}),
	     "Ein bisschen unheimlich wirkt es schon, weil der Nebel "
	     "irgendwie alles zu verschlucken scheint.");
  
  AddDetail( ({"hand"}),
	     "Welche meinst Du? Die rechte oder die linke Hand?");
  
  AddDetail( ({"rechte hand"}),
	     "Sie ist dort wo der Daumen links ist.");
  
  AddDetail( ({"linke hand"}),
	     "Sie ist dort wo der Daumen rechts ist.");
  
  AddDetail( ({"daumen"}),
	     "Der linke Daumen ist auf der rechten Hand und der rechte Daumen "
	     "auf der linken Hand.");
  
  AddDetail( ({"boden"}),
	     "Der Boden ist von wattigen Wolkensteinen gesaeumt. Du sinkst "
	     "beim Gehen immer ein wenig ein. Das animiert Dich doch glatt "
	     "zum Springen.");

  AddDetail( ({"springen"}),
	     "Na, spring doch mal!!!");
  
  AddDetail( ({"gehen"}),
	     "Du gehst ganz cool hin und her.");
  
  AddDetail( ({"wolkensteine","wolkensteinen","steine","steinen"}),
	     "Sie bestehen aus Wolken, wie fast alles hier.");
  
  AddDetail( ({"wolken"}),
	     "Sie bestehen eigentlich aus feuchter Luft.");
  
  AddDetail( ({"himmel"}),
	     "Der Himmel wird von einem Regenbogen geziert und ist wolkenlos "
	     "und blau. Die Sonne laechelt Dir munter zu.");
  
  AddDetail( ({"regenbogen","bogen","regenbogens"}),
	     "Der Regenbogen zieht sich ueber den Himmel und schimmert in "
	     "allen Farben.");
  
  AddDetail( ({"sonne"}),
	     "Die Sonne laechelt Dir zu und waermt die Luft etwas an, weil es "
	     "doch normalerweise viel kaelter hier oben waere.");
  
  AddDetail( ({"luft"}),
	     "Die Luft ist ganz klar und eigentlich kuehl, wenn da nicht die "
	     "Sonne waere.");
  
  AddDetail( ({"plaetschern"}),
	     "Daran musst Du schon lauschen.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	     "Du rufst empoert: Ich bin das kleine ich bin ich!");
  
  AddDetail( ({"schreck","schrecken"}),
	     "Du hast Dich ganz schoen erschreckt. *schnauf*");
  
  
  AddSmell(DEFAULT_SMELL, "Du riechst den Duft Blumen und auch klare Luft.");  
  
  AddSmell( ({"duft","blumen"}),
	    "Sie duften frisch und suess.");
  
  AddSmell( ({"luft"}),
	    "Du schnupperst an der klaren Luft und fuehlst Dich frei.");
  
  
  AddSound(DEFAULT_SOUND, "Der Wind streift ueber die Strasse und laesst die "
	   "Blaetter Rascheln. Manchmal wird er vom munteren Plaetschern des "
	   "Springbrunnens unterbrochen.");
  
  AddSound( ({"wind","hauch","hauchen","haucht"}),
	    "Fast haette er Dich magisch verfuehrt ihm zu folgen!!");
  
  AddSound( ({"plaetschern","springbrunnen","brunnen","wasser"}),
	    "Platsch - platsch - platsch!");
  
  AddSound( ({"blaetter","rascheln"}),
	    "Es beruhigt Dich ein wenig und laesst Dich entspannter wirken.");
  
  //-----Details Anfang-----
  
  AddExit("nordwesten",ROOM "ws1");
  AddExit("suedosten",ROOM "ws3");
  AddExit("westen",ROOM "ws9");
  AddExit("sueden",ROOM "ws10");
  AddExit("nordosten",ROOM "wh1");
  
  
  AddCmd( ({"dreh","drehe"}),"cmd_drehen" );
  AddCmd( ({"schieb","schiebe"}),"cmd_schieben");
  AddCmd( ({"schaue","schau","blicke","blick","guck","gucke"}),"cmd_schauen");
  
}

void reset()
{
  ::reset();
  blatt=1;
  
}

int cmd_drehen(string str)     
{
  object schmetterling;
  notify_fail("Was willst Du umdrehen?\n");
  
  if(!(str=="blatt"||
       str=="blatt um"||
       str=="blatt herum")) 
    return 0;
  
  if(blatt<1)
    {
      write(BS("Du drehst das Blatt um, aber Du entdeckst nichts."));
      
      say(BS(TPN+" dreht ein Blatt um und duerfte nichts entdeckt haben."));
      
      return -1;
    }
  
  schmetterling=clone_object(NPC "schmetterling");
  schmetterling->move(ENV(TP),M_NOCHECK);
  
  write(BS("Du drehst das Blatt um und ein wunderschoener Schmetterling "
	   "laesst Dich vor Schreck ein paar Schritte zurueck weichen."));
  
  say(BS(TPN+" werkt an der Kletterpflanze herum und schreckt ploetzlich vor "
	"einem Schmetterling zurueck."));
  
  blatt--;
  
  return 1;
}

int cmd_schieben(string str)	
{
  object schmetterling;
  notify_fail("Was willst Du weg schieben?\n");
  
  if(!(str=="blatt beiseite"||
       str=="blatt zur seite"||
       str=="blatt weg")) 
    return 0;
  
  if(blatt<1)
    {
      write(BS("Du schiebst das Blatt beiseite, aber Du entdeckst nichts."));
      
      say(BS(TPN+" schiebt ein Blatt beiseite und duerfte nichts entdeckt haben."));
      
      return -1;
    }
  
  schmetterling=clone_object(NPC "schmetterling");
  schmetterling->move(ENV(TP),M_NOCHECK);
  
  write(BS("Du schiebst das Blatt weg und ein wunderschoener Schmetterling "
	   "laesst Dich vor Schreck ein paar Schritte zurueck weichen."));
  
  say(BS(TPN+" werkt an der Kletterpflanze herum und schreckt ploetzlich vor "
	 "einem Schmetterling zurueck."));
  
  blatt--;
  
  return 1;
}

int cmd_schauen(string str)	
{
  object schmetterling;
  notify_fail("Hinter was willst Du schauen?\n");
  
  if(!(str=="hinter blatt"||
       str=="in wolken"||
       str=="in wolke hinein"||
       str=="in wolken hinein")) 
    return 0;
  
  if(blatt<1)
    {
      write(BS("Du schaust hinter das Blatt, aber Du entdeckst nichts."));
      
      say(BS(TPN+" schaut hinter ein Blatt und duerfte nichts entdeckt haben."));
      
      return -1;
    }
  
  schmetterling=clone_object(NPC "schmetterling");
  schmetterling->move(ENV(TP),M_NOCHECK);
  
  write(BS("Du blickst hinter das Blatt und ein wunderschoener Schmetterling "
	   "laesst Dich vor Schreck ein paar Schritte zurueck weichen."));
  
  say(BS(TPN+" werkt an der Kletterpflanze herum und schreckt ploetzlich vor "
	 "einem Schmetterling zurueck."));
  
  blatt--;
  
  return 1;
}
