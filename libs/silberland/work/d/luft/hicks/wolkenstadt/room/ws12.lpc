// von Hicks
// 20.1.2004
// 
// Raum meines Gesellenstueckes "Park - Wolkenstadt"

inherit "std/room";

#include "../def.h"

#define GRAS(wer) (member(gras, capitalize(getuid(wer)))!=-1)
#define MyCountUp(arg) (sizeof(arg) > 1 ? \
        implode(arg[0..<2], ", ") + " und " + arg[<1] : \
        (sizeof(arg) == 0 ? "niemand" : arg[0]) )

string *gras=({});
int schilf=1;
int trinken=1;
int blumenzahl=3;

void create()    
{
  ::create();
  
  
  SetProp(P_INT_SHORT, "Im Park der Wolkenstadt");
  SetProp(P_INT_LONG,
	  "Das ist ein ganz ruhiges und angenehmes Plaetzchen. Das Biotop ist "
	  "von Schilf eingerahmt und wunderschoene rosa Wasserrosen treiben "
	  "auf der Oberflaeche. Das Wasser ist ganz klar und glatt. Nichts "
	  "bewegt sich ausser das Schilf im Wind. Nichts ist zu hoeren, ausser "
	  "der Wind. Du atmest tief ein und entspannst Dich.");
  
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);
  
  //-----Details Anfang-----
  
  AddDetail( ({"cute","marrogh","maghnar","niri","gaya","zidane","nyx","wumanzu",
	       "elrohir","velkyn","took","aroobah","methos","katarok"}),
	      "Ja, dieser Spieler hat mir geholfen, dass dieses Gebiet noch besser "
	      "und schoener wird.");
  
  AddDetail( ({"plaetzchen"}),
	     "Du blickst herum. Du siehst das Biotop mit den Wasserrosen, ein "
	     "paar Buesche, die die Wiese umsaeumen und den Turm hinter Dir.");
  
  AddDetail( ({"turm"}),
	     "Er ist filigran und besitzt mehrere Stockwerke. Ganz oben "
	     "schliesst eine Glaskuppel die Spitze ab.");
  
  AddDetail( ({"stockwerke","werke"}),
	     "Es sind mit der Glaskuppel vier.");
  
  AddDetail( ({"glaskuppel","kuppel"}),
	     "Sie funkelt zartrosa auf der Spitze.");
  
  AddDetail( ({"spitze"}),
	     "Hier thront die Glaskuppel.");
  
  AddDetail( ({"buesche"}),
	     "Sie haben ein zartgruenes Blattwerk und grenzen die Wiese von "
	     "der Strasse ab.");
  
  AddDetail( ({"strasse"}),
	     "Die Strasse umringt die Wiese mit dem Turm.");
  
  AddDetail( ({"blattwerk","werk"}),
	     "Sie sind genauso mit einer kristallartigen Schicht ueberzogen "
	     "wie die Wiese.");
  
  AddDetail( ({"wiese","boden"}),
	     "Die Wiese glitzert gruenlich, als waere sie mit einer "
	     "Kristallschicht ueberzogen. Das Gras und die Wolkenblumen "
	     "wechseln sich farblich schoen ab.");
  
  AddDetail( ({"kristallschicht","schicht"}),
	     "Es ist in den Blaettern und dem Gras enthalten. Nichts ist "
	     "eingefroren, auch wenn es so aussieht.");
  
  AddSpecialDetail( ({"gras"}),"gras");
  
  AddDetail( ({"blumen","wolkenblumen"}),
	     "Sie schimmern in unterschiedlichen Farben in der Wiese.");
  
  AddDetail( ({"farben"}),
	     "Alle Farben, die Du Dir vorstellen kannst, wie rot, orange, "
	     "blau, violett, gelb und rosa.");
  
  AddDetail( ({"biotop"}),
	     "Das Wasser im Biotop schimmert gruenlich. Das Schilf saeumt "
	     "halb das Biotop ein  Ein paar Wasserrosen treiben sanft an der "
	     "Oberflaeche.");
  
  AddDetail( ({"wasser"}),
	     "Das Wasser schimmert gruenlich, wenn Du in die Tiefe blickst. "
	     "Doch, auch der Himmel spiegelt sich blau darin.");
  
  AddDetail( ({"tiefe"}),
	     "Viele kleine Fische tollen unter Wasser herum. Wasserpflanzen, "
	     "viele Steine, aber auch Sand bilden den Grund.");
  
  AddDetail( ({"fische"}),
	     "Sie sind sehr zart und dunkelgrau. Sie flitzen verspielt hin "
	     "und her.");
  
  AddDetail( ({"wasserpflanzen","pflanzen"}),
	     "Sie wiegen sich langsam hin und her.");
  
  AddDetail( ({"steine","steinen"}),
	     "Hellgraue, runde Steine. Unter einem lugt kurz ein kleiner "
	     "Krebs hervor.");
  
  AddDetail( ({"krebs"}),
	     "Kaum hast Du ihn gesehen, versteckt sich der Krebs verschreckt "
	     "unter den Steinen.");
  
  AddDetail( ({"sand"}),
	     "Der Sand schimmert golden am Grund, dadurch wirkt das Wasser "
	     "gruenlich.");
  
  AddDetail( ({"grund","wassergrund"}),
	     "Du kannst den Wassergrund gut erkennen und schliesst daraus, "
	     "dass es nicht sehr tief ist.");
  
  AddDetail( ({"schilf"}),
	     "Das Schilf umrundet das Biotop nicht ganz. Eine breite Stelle "
	     "ist frei. Es ist gruengelblich und wiegt sich sanft im Wind. "
	     "Waehrend Du das Schilf so mustert, entdeckst etwas Weisses.");
  
  AddDetail( ({"stelle"}),
	     "Auf dieser stehst Du.");
  
  AddDetail( ({"wind"}),
	     "Der Wind streicht sanft ueber das Schilf und wiegt es.");
  
  AddDetail( ({"weiss","weisses"}),
	     "Du wirst nicht wissen was es ist, wenn Du das Schilf nicht "
	     "beiseite schiebst.");
  
  AddDetail( ({"wasserrosen","rosen"}),
	     "Sie sind zartrosa und stehen in der vollen Bluete. Sie schwimmen "
	     "seelenruhig auf der Wasseroberflaeche.");
  
  AddDetail( ({"bluete","blueten"}),
	     "Sie sind gross und geoeffnet und thronen auf grossen "
	     "dunkelgruenen Blaettern.");
  
  AddDetail( ({"blaetter","blaettern"}),
	     "Sie sind herzblattfoermig und ganz glatt.");
  
  AddDetail( ({"wasseroberflaeche","oberflaeche"}),
	     "Sie ist spiegelglatt, doch manchmal ist sie von einem "
	     "Wasserlaeufer kurz verschwommen.");
  
  AddDetail( ({"wasserlaeufer","laeufer"}),
	     "Er flitzt blitzschnell ueber die Oberflaeche und schon ist er "
	     "verschwunden.");
  
  AddDetail( ({"himmel"}),
	     "Der Himmel ist wolkenlos und strahlend blau. Ploetzlich flitzt "
	     "ein Puenktchen ueber den Himmel.");

  AddDetail( ({"sonne"}),
             "Diese Sonne ist speziell Justavius gewidmet.");

  AddDetail( ({"justavius"}),
             "Du kannst mehr ueber Justavius erfahren, wenn Du 'finger Justavius' "
             "tippst.");
  
  AddDetail( ({"puenktchen"}),
	     "Sieht aus wie ein Pegasus.");
  
  AddDetail( ({"pegasus"}),
	     "Er duerfte hier oben leben.");
  
  AddDetail( ({"idee"}),
	     "Sie kam ganz schnell, dass Du Dein Spiegelbild betrachten "
	     "koenntest.");
  
  AddDetail( ({"spiegelbild","bild"}),
	     "Tippe: betrachte Spiegelbild");
  
  AddDetail( ({"abenteurer","du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	     "Du blickst auf Dich herab und wackelst mit dem Kopf.");
  
  AddDetail( ({"kopf"}),
	     "Er wackelt hin und her.");
  
  AddDetail( ({"augen"}),
	     "Sie sind geschlossen.");
  
  
  AddSmell(DEFAULT_SMELL, "Du riechst einen starken suesslichen Geruch.");
  
  AddSmell( ({"geruch"}),
	    "Er ist sehr verfuehrerisch und entspannt. Die Ursache duerften "
	    "die wunderschoenen Wasserrosen sein.");
  
  AddSmell( ({"ursache","rosen","wasserrosen"}),
	    "Dieser Geruch riecht betoerend und ganz blumig suess.");
  
  
  AddSound(DEFAULT_SOUND, "Der Wind streicht sanft ueber das Schilf.");
  
  AddSound( ({"wind","streicht","streichen"}),
	    "Er bewegt das Schilf so, dass man ein Rascheln hoert.");
  
  AddSound( ({"schilf","rascheln"}),
	    "SCHHHHHHHHHH");  
  
  //-----Details Ende-----
  
  AddItem(NPC "libelle", REFRESH_DESTRUCT);
  
  AddExit("norden",ROOM "ws8");
  AddExit("osten",ROOM "wst1");
  AddExit("sueden",ROOM "ws6");
  
  
  AddCmd( ({"schieb","schiebe","ziehe","zieh"}),"cmd_schieben");
  AddCmd( ({"betrachte","blicke","blick","schaue","schau"}),"cmd_betrachten");
  AddCmd( ({"setze","setz","sitze","sitz"}),"cmd_sitzen");
  AddCmd( ({"stehe","steh" }),"cmd_aufstehen");
  AddCmd( ({"norden","n","osten","o","sueden","s","goto","home"}),"cmd_richtung");
  AddCmd( ({"schwimm","schwimme","plantsch","plantsche"}),"cmd_schwimmen");
  AddCmd( ({"trink","trinke"}),"cmd_trinken");
  AddCmd( ({"pflueck","pfluecke"}),"cmd_blume");
  
}

void reset()
{
  ::reset();
  schilf=1;
  trinken=1;
  blumenzahl=3;
}

int cmd_schieben(string str)	
{
  object schwan;
  notify_fail("Was willst Du weg schieben?\n");
  
  if(!(str=="schilf beiseite"||
       str=="schilf zur seite"||
       str=="schilf weg")) 
    return 0;
  
  if(schilf<1)
    {
      write(BS("Du schiebst das Schilf beiseite, aber Du entdeckst nichts."));
      
      say(BS(TPN+" schiebt das Schilf beiseite und laesst es zurueck schnalzen."));
      
      return -1;
    }
  
  clone_object(NPC "schwan")->move(ENV(TP),M_NOCHECK);
  
  write(BS("Du schiebst das Schilf weg und weckst einen zauberhaften Schwan auf. "
	   "Er gleitet galant ins Wasser."));
  
  say(BS(TPN+" schiebt das Schilf weg und ein zauberhafter Schwan erscheint "
	 "auf dem Biotop."));
  
  schilf--;
  
  return 1;
}

int cmd_betrachten(string str)	
{
  notify_fail("Was willst Du betrachten?\n");
  
  if(!(str=="spiegelbild"||
       str=="spiegelbild in wasser"||
       str=="spiegelbild in biotop"||
       str=="in biotop"||
       str=="ins biotop"||
       str=="in biotop hinein"||
       str=="ins biotop hinein"||
       str=="in wasser"||
       str=="ins wasser"||
       str=="in wasser hinein"||
       str=="ins wasser hinein")) 
    return 0;
  
  write(BS("Du beugst Dich ueber das Wasser und betrachtest Dein Spiegelbild. "
	   "Du erkennst, dass Du ein kraeftiger, junger Abenteurer bist. Braun "
	   "gebrannt und wettergegerbt."));
  
  say(BS(TPN+" betrachtet "+TP->QueryPronoun(WEM)+" Spiegelbild im Wasser."));
  
  return 1;
}

//---------------------------------------------------------------------------

int cmd_sitzen(string str)
     
{
  notify_fail(BS("Wohin willst Du Dich setzen?"));
  if(!(str=="in wiese"||
       str=="auf wiese"||
       str=="in gras"||
       str=="ins gras"||
       str=="auf boden"||
       str=="hin"))
    {
      return 0;
    }
  if(GRAS(TP))
    {
      write(BS("Du sitzt doch schon im weichen Gras!"));
      return 1;
    }
  if(sizeof(gras)>=6)
    {
      write(BS("Soviel Platz ist nicht mehr."));
      return 1;
    }
  write(BS("Du setzt Dich ins Gras um Dich zu entspannen."));
  tell_room(ENV(TP), TPN+" setzt sich in die Wiese.\n", ({TP}));
  gras += ({ capitalize(getuid(TP)) });
  return 1;
}

int cmd_richtung(string str)
{
  if(GRAS(TP))
    {
      write(BS("Du solltest vorher aufstehen!"));
      return 1;
    }
}

int cmd_aufstehen(string str)
{
  notify_fail(BS("Willst Du etwa aufstehen?"));
  if(str == "auf")
    {
      if(GRAS(TP))
	{
	  write(BS("Du stehst total entspannt auf."));
	  tell_room(ENV(TP), TPN+" steht entspannt auf.\n", ({TP}));
	  gras -= ({ capitalize(getuid(TP)) });
	  return 1;
	}
    }      
  else 0;
}

void BecomesNetDead(object spieler)
{
  if(GRAS(spieler))
    gras -= ({ capitalize(getuid(spieler)) });
}

string gras()
{
  string grasinfo;
  if(GRAS(TP))
    {
      grasinfo =
	"Du sitzt auf der Wiese. "+
	"Du entspannst Dich und schliesst Deine Augen. Mhh, dir kommt eine "
	"Idee, dass Du Dein Spiegelbild im Wasser betrachten koenntest.";
    }
  else
    {
      grasinfo =
	"Das Gras ist gruen und saftig. Es ladet zum hinsetzen ein.";
      if(sizeof(gras)==1 )
	grasinfo += " Es sitzt gerade " + gras[0] + " auf dem Boden.";
      
      if(sizeof(gras)>1 )
	grasinfo += " Es sitzen gerade " + MyCountUp(gras) + " auf dem "
	  "Boden.";
    }
  return break_string(grasinfo, 78);
}

int cmd_schwimmen(string str)     
{
  notify_fail("Worin willst Du schwimmen?\n");
  
  if(!(str=="in wasser"||
       str=="in becken"||
       str=="in wasserbecken"||
       str=="in biotop")) 
    return 0;
  
  write(BS("Du steckst die Zehe in das Wasser und zuckst zurueck. Brrrrrr! "
	  "Das ist Dir doch zu kalt."));
  
  say(BS(TPN+" steckt die Zehe in das Wasser und zuckt zurueck."));
  
  return 1;
}


int cmd_trinken(string str)	
{
  notify_fail("Was willst Du trinken?\n");
  
  if(!(str=="wasser"||
       str=="aus becken"||
       str=="aus wasserbecken"||
       str=="aus nebelbecken"||
       str=="aus springbrunnen"||
       str=="aus brunnen"||
       str=="aus biotop")) 
    return 0;
  
  if(TP->drink_soft(2))
    {
      write(BS("Du tauchst Deine Haende in das kuehle Becken und schluerfst "
	       "etwas Wasser daraus."));
      
      say(BS(TPN+" trinkt etwas Wasser aus dem Becken und fuehlt sich sichtlich "
	     "erfrischt."));
      
      if(trinken<1)
	{
	  return -1;
	}
      
      TP->AddHp(10+random(5));
      trinken--;
      
  return 1;
    }
  else
    {
      return -1;
    }
}


int cmd_blume(string str)
{
  object wolkenblume;
  notify_fail("Was willst Du pfluecken?\n");
  
  if(!(str=="blume"||
       str=="etwas aus bett heraus")) 
    return 0;
  
   
    if(blumenzahl<1)
      {
	write(BS("Du findest keine pflueckbare Blume mehr und musst warten, "
		 "bis schoene Exemplare nachgewachsen sind."));
	
	say(TPN+" seufzt enttaeuscht.\n");
	
	return -1;
      }
    	
	wolkenblume=clone_object(OBJ "wolkenblume");
	if (ME_TOO_HEAVY==wolkenblume->move(TP,M_GET))
	  {
	    write(BS("Du pflueckst Dir eine wunderschoene Blume, laesst sie aber "
		     "gleich fallen. Du haettest lieber vorher Dein Gepaeck "
		     "umsortieren sollen."));
	    
	    say(BS(TPN+" pflueckt eine Blume und laesst diese gleich fallen."));
	    
	    wolkenblume->move(TO, M_NOCHECK|M_SILENT);
	    return 1;
	  }
	
	    write(BS("Du greifst blind in die Wiese und pflueckst Dir die erst "
		     "beste Blume."));
	    
	    say(BS(TPN+" haelt sich mit einer Hand die Augen zu und pflueckt mit "
		   "der anderen blind eine Blume."));
	    blumenzahl--;
	    return 1;
	    
}
