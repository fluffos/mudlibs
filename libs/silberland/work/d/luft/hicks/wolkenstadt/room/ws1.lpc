// Raum meines Gesellenstueckes "Nordplatz - Wolkenstadt"
inherit "std/room";
inherit "/gilden/bardengilde/obj/quest/reiselied_functions";

#include "../def.h"

void create()
     
{
  ::create();
  
  
  SetProp( P_INT_SHORT, "Nordplatz in der Wolkenstadt");
  SetProp( P_INT_LONG,
	   "Du befindest Dich auf dem Nordplatz von Liliandor. Alles wirkt so "
	   "hell und glitzert in jeglichen Pastellfarben und ueberall spiegelt "
	   "sich die Sonne im Glas. Vor Dir erkennst Du das Palasttor und "
	   "rechts daneben wurde in die Glaswand etwas eingraviert. Hinter Dir "
	   "entdeckst Du eine Statue, die auf einem wattig weichen Sockel "
	   "platziert wurde. Dahinter erblickst Du einen filigranen, "
	   "kuppelartigen Turm gruen-weisslich schimmern. Vor dem Turm "
	   "plaetschert munter ein Springbrunnen in einem kleinen Park vor sich "
	   "hin." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );
  
  
  //-----Details Anfang-----
  
  AddDetail( ({"cute","marrogh","maghnar","niri","gaya","zidane","nyx","wumanzu",
	       "elrohir","velkyn","took","aroobah","methos","katarok"}),
	      "Ja, dieser Spieler hat mir geholfen, dass dieses Gebiet noch besser "
	      "und schoener wird.");  

  AddDetail( ({"nordplatz","platz"}), 
	     "Du befindest Dich auf dem Nordplatz von Liliandor. Alles wirkt "
	     "so hell und glitzert in jeglichen Pastellfarben und ueberall "
	     "spiegelt sich die Sonne im Glas. Vor Dir erkennst Du das Palasttor "
	     "und rechts daneben wurde in die Glaswand etwas eingraviert. "
	     "Hinter Dir entdeckst Du eine Statue, die auf einem wattig "
	     "weichen Sockel platziert wurde. Dahinter erblickst du einen "
	     "filigranen, kuppelartigen Turm gruen-weisslich schimmern. Vor "
	     "dem Turm plaetschert munter ein Springbrunnen in einem "
	     "kleinen Park vor sich hin." );
  
  AddDetail( ({"liliandor"}),
	     "Liliandor ist die hellste und glitzerndste Stadt, die Du je "
	     "gesehen hast. Du fuehlst Dich so frei auf den Wolken.");
  
  AddDetail( ({"stadt","wolkenstadt"}),
	     "Sie befindet sich in schwindelerregender Hoehe. Du merkst, "
	     "wie unendlich klein Du bist hier oben. Sowas hast Du noch nie "
	     "erlebt. Alles wirkt so wattig weich, und Du hast das Gefuehl, "
	     "dass Du versinkst in der Stadt. Du fuehlst Dich einfach wohl!");
  
  AddDetail( ({"hoehe"}),
	     "Du wagst gar nicht herunterzublicken, weil Dir bei dem "
	     "Gedanken schon schwindelig wird. Aber andererseits ist es "
	     "einfach aufregend zu wissen, dass man ueber den Wolken schwebt.");
  
  AddDetail( ({"gefuehl","gefuehle"}),
	     "Deine Gefuehle sind gemischt, weil Du einfach nicht glauben "
	     "kannst, dass Du hier bist.");
  
  AddDetail( ({"gedanke","gedanken"}),
	     "Deine Gedanken kreisen nur um die Hoehe. Das ist verdammt "
	     "hoch, und Du versuchst nicht mehr dran zu denken.");
  
  AddDetail( ({"wolke","wolken"}),
	     "Es wirkt wattig weich, einfach zum Hineinkuscheln. Ob Du es "
	     "versuchen solltest?");
  
  AddDetail( ({"farben","pastellfarben"}),
	     "Das sind alle moeglichen Farben des Regenbogens. Rot, Orange, "
	     "Gelb, Gruen, Blau, Violett.");
  
  AddDetail( ({"gelb","orange","rot","violett","blau","gruen"}),
	     "Das ist ein reines Farbfeuerwerk. Von ueberall her begeistern "
	     "Dich die Farben.");
  
  AddDetail( ({"farbfeuerwerk","feuerwerk","werk"}),
	     "Ja, anders kannst du es nicht bezeichnen, aber trotzdem geht "
	     "das transparente Glas darin nicht unter, und auch die Wolken "
	     "lassen alles angenehm und weich wirken.");
  
  AddDetail( ({"regenbogen","regenbogens","bogen"}),
	     "Ueber Dir zieht sich ein Regenbogen in allen Farben. Du siehst "
	     "kleine Puenktchen, die sich auf dem Bogen bewegen.");
  
  AddDetail( ({"puenktchen"}),
	     "Du kneifst die Augen zusammen und erkennst Feen, die dort herum "
	     "flattern und gehen.");
  
  AddDetail( ({"augen"}),
	     "Eines links und eines rechts!");
  
  AddDetail( ({"feen","luftfeen","dinger"}),
	     "Sie wohnen hier oben, und eigentlich nennen sie sich L`fair. "
	     "Sie aehneln sich auf jeden Fall mit ihren Verwandten unten "
	     "im Silberland.");
  
  AddDetail( ({"l`fair","lfair"}),
	     "So heissen die suessen Feen hier oben in der Wolkenstadt. Daher "
	     "sind es Luftfeen, die die Natur hier oben im Gleichgewicht "
	     "halten. Sie sind lustig und tanzen gerne und treiben Spass.");
  
  AddDetail( ({"fall"}),
	     "Du bist Dir ganz sicher, dass beide miteinander verwandt sind.");
  
  AddDetail( ({"verwandten","verwandte"}),
	     "Ja, die wohnen im Silberland und sind fuer die Naturgewalten "
	     "unten zustaendig. Sie wirken auch zu den Luftfeen etwas staemmiger "
	     "und nicht so zerbrechlich.");
  
  AddDetail( ({"silberland","land"}),
	     "Du befindest Dich jetzt hier im S i l b e r l a n d "
	     "(sl.mud.at:4711)! ");
  
  AddDetail( ({"natur","naturgewalten"}),
	     "Ja, Dir fallen sie gar nicht auf, weil diese suessen Dinger so "
	     "acht darauf geben, dass alles im Gleichgewicht ist.");
  
  AddDetail( ({"gleichgewicht"}),
	     "Wuerden sie das nicht tun, dann waere das katastrophal fuer "
	     "das ganze Land. Also, sei dankbar.");
  
  AddDetail( ({"spass"}),
	     "Den treiben sie oft gerne, aber sie meinen es nie boese.");
  
  AddDetail( ({"sonne"}),
	     "Die Sonne brennt ziemlich herunter und waermt die Luft auf, "
	     "ansonsten waere es wirklich bitterkalt.");
  
  AddDetail( ({"glas"}),
	     "Es ist transparent, milchig oder uneben und spiegelt das "
	     "Sonnenlicht wider, und alles wird erleuchtet und funkelt.");
  
  AddDetail( ({"sonnenlicht","licht"}),
	     "Die Stadt wird vom Licht durchflutet und von den Glaswaenden "
	     "reflektiert.");
  
  AddDetail( ({"milchglas"}),
	     "Man kann nicht hindurchblicken. Wahrscheinlich wurde es "
	     "verwendet, damit keine neugierige Nase da hineinschauen kann.");
  
  AddDetail( ({"nase"}),
	     "Du hast Dir den Namen redlich verdient, Du neugierige Nase!");
  
  AddDetail( ({"namen","name"}),
	     "Jetzt ist aber genug. Husch, husch zum naechsten Detail.");
  
  AddDetail( ({"detail","husch"}),
	     "Versuch es mal mit Glaswand.");
  
  AddDetail( ({"schrift"}),
	     "Sie schmueckt das Tor oberhalb in einem Halbbogen. Du kannst "
	     "versuchen sie zu lesen.");
  
  AddDetail( ({"palasttor","tor"}),
	     "Das Tor besteht aus einem dicken Milchglas. Oberhalb des Tors "
	     "ist eine Schrift eingelassen, die mystisch wirkt. Du versuchst, "
	     "durch die Ritzen hindurch zu spaehen, aber leider erkennst Du "
	     "nichts vom Inneren.");
  
  AddDetail( ({"halbbogen","bogen"}),
	     "Ein halber Bogen.");
  
  AddDetail( ({"ritze","ritzen"}),
	     "Du legst Dich auf den Boden, und versuchst, unten durch zu "
	     "blicken, aber erkennst nichts. Dann drueckst Du Deine Nase in "
	     "der Mitte der beiden Torfluegel platt, aber das Milchglas ist "
	     "einfach zu gut eingearbeitet worden.");
  
  AddDetail( ({"mitte"}),
	     "In der Mitte der beiden Fluegel ist auch eine Ritze.");
  
  AddDetail( ({"fluegel","torfluegel"}),
	     "Einer links und einer rechts. :-)");
  
  AddDetail( ({"innere","inneren"}),
	     "Du starrst ganz lange ins Innere, bis Du verschwommen siehst. "
	     "Das Tor ist einfach im Weg.");
  
  AddDetail( ({"weg"}),
	     "Wohin Dich Dein Weg fuehrt das musst Du selbst eintscheiden.");
  
  AddDetail( ({"wand","glaswand","waende","glaswaende"}),
	     "Die Wand ist dick, und Du erkennst nur verschwommen viereckige "
	     "Gebilde durch das Glas. Die Gravur wurde eingemeisselt und "
	     "die feine Arbeit fasziniert Dich.");
  
  AddDetail( ({"gebilde"}),
	     "Du musst hineingehen, um zu sehen was das sein koennte.");
  
  AddDetail( ({"amaryllis"}),
	     "Du weisst, das bedeutet leuchtend.");
  
  AddDetail( ({"anemona"}),
	     "Du musst automatisch an Wind denken.");
  
  AddDetail( ({"wind"}),
	     "Magisch braut sich ein kleiner Wind zusammen und ist gleich "
	     "wieder verschwunden.");
  
  AddDetail( ({"ambrosia"}),
	     "Du erinnerst Dich gehoert zu haben, dass Ambrosia unsterblich "
	     "heisst.");
  
  AddDetail( ({"schicksal"}),
	     "Hoffentlich auch Deines!");
  
  AddDetail( ({"gravur"}),
	     "Die Gravur ist sehr blumig und verschnoerkselt geschrieben. Sie "
	     "sieht wunderschoen aus, aber laesst sich fast nicht lesen.");
  
  AddDetail( ({"arbeit"}),
	     "Da ist wohl jemand handwerklich sehr begabt. Du drehst Dich um "
	     "und suchst und suchst, findest aber niemanden. Haettest Du "
	     "wirklich geglaubt, dass Du ihn jetzt und hier findest?");
  
  AddDetail( ({"statue"}),
	     "Du drehst Dich um und erkennst, dass diese Statue eine Fee sein "
	     "muss. Du fuehlst die glatte und transparente Oberflaeche und "
	     "wanderst weiter zu dem Sockel, in dem Du fast versinkst.");
  
  AddDetail( ({"fee"}),
	     "Es muss sich schon um eine besondere Fee handeln, wenn sie hier "
	     "eine eigene Statue erhaelt. Sie muss wohl mittleres Alter haben "
	     "und wirkt zerbrechlich schoen, aber dennoch strahlt sie eine "
	     "Kraft, Ruhe und Weisheit aus. Ihr Haar flattert leicht im Wind "
	     "und ihr Laecheln verzaubert Dich.");
  
  AddDetail( ({"alter"}),
	     "So um die 30 oder 40?");
  
  AddDetail( ({"30","40"}),
	     "Mhh, doch eher 30. Aber Du weisst, dass Feen viel aelter "
	     "werden. Aber man sieht es ihnen nicht an.");
  
  AddDetail( ({"kraft","ruhe","weisheit"}),
	     "Du gibst zu, dass Dir diese manchmal fehlen und beschliesst ein "
	     "wenig zu meditieren. Vielleicht findest Du selber mehr Kraft, "
	     "Ruhe und Weisheit.");
  
  AddDetail( ({"haar"}),
	     "Es besteht aus Glas und Du staunst darueber, dass jemand solch "
	     "eine Arbeit leisten konnte. Und es wirkt federleicht und "
	     "flattert huebsch im Wind.");
  
  AddDetail( ({"laecheln"}),
	     "Du kannst gar nicht anders und musst automatisch zurueck "
	     "laecheln.");
  
  AddDetail( ({"oberflaeche"}),
	     "Sie ist klar, glatt und durchsichtig, beinahe kuehl. Du "
	     "vermerkst ein kraftvolles, blaues Pulsieren, als waere die "
	     "Statue lebendig.");
  
  AddDetail( ({"pulsieren"}),
	     "Es muss magisch sein!");
  
  AddDetail( ({"sockel"}),
	     "Der Sockel besteht aus Wolken. Du wuerdest am liebsten hinein "
	     "beissen, was natuerlich nicht geht. Dafuer entdeckst Du eine "
	     "winzig kleine Plakette.");
  
  AddDetail( ({"plakette"}),
	     "Du kannst sie lesen.");
  
  AddDetail( ({"turm"}),
	     "Der Turm liegt gruen-weisslich mitten im Park und erscheint Dir "
	     "fast wie aus vielen Schlingpflanzen. Die rosa Glaskuppel passt "
	     "sich oberhalb farblich wunderschoen an den Turm an.");
  
  AddDetail( ({"schlingpflanzen","pflanzen"}),
	     "Um dies genauer zu beurteilen, musst Du schon naeher hingehen!");
  
  AddDetail( ({"glaskuppel","kuppel"}),
	     "Wer da wohl oben wohnen mag? Irgendwie bist Du neidisch, weil "
	     "es herrlich sein muss in solcher Hoehe zu wohnen.");
  
  AddDetail( ({"park"}),
	     "Buesche, Blumen und sogar einen Springbrunnen erkennst Du. Du "
	     "siehst auch, dass Du ueber den Park zum Turm gelangst und "
	     "andererseits kannst Du Dich dort sicher gut erholen.");
  
  AddDetail( ({"buesche","blumen"}),
	     "Die Buesche zaeunen den Park ein und die Blumen gedeihen in "
	     "allen Farben.");
  
  AddDetail( ({"springbrunnen","brunnen","springbrunnens","brunnens"}),
	     "Er plaetschert munter vor sich hin und schimmert in allen "
	     "Farben.");

  AddDetail( ({"wasser"}),
	     "Das Wasser reflektiert die Sonne und blendet mit "
	     "verschiedensten Farben.");
  
  AddDetail( ({"boden"}),
	     "Der Boden ist von wattigen Wolkensteinen gesaeumt. Du sinkst "
	     "beim Gehen immer ein wenig ein. Das animiert Dich doch glatt "
	     "zum Springen.");
  
  AddDetail( ({"wolkensteine","wolkensteinen","steine","steinen"}),
	     "Sie bestehen aus Wolken, wie fast alles hier.");
  
  AddDetail( ({"himmel"}),
	     "Der Himmel wird von einem Regenbogen geziert und ist wolkenlos "
	     "und blau. Die Sonne laechelt Dir munter zu.");
  
  AddDetail( ({"freude"}),
	     "Jaaaa, das hast Du schon lange nicht mehr gemacht. Vielleicht "
	     "gleich nochmal?");
  
  AddDetail( ({"luft"}),
	     "Die Luft ist ganz klar und eigentlich kuehl, wenn da nicht die "
	     "Sonne waere.");
  
  AddDetail( ({"plaetschern"}),
	     "Daran musst Du schon lauschen.");
  
  AddDetail( ({"zaehne","zaehnen"}),
	     "Ohh, das tat weh. Die Zaehne klapperten ganz schoen laut.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	     "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	     "Du erroetest und planst Dich bald zu waschen.");
  
  AddDetail( ({"gehen"}),
	     "Du gehst auf und ab.");
  
  AddDetail( ({"springen"}),
	     "Mehr als auf und ab springen wird nicht sein.");
  
  AddDetail( ({"palast"}),
	     "Du stehst vor dem Palast.");
  
  AddDetail( ({"innere","inneres","inneren"}),
	     "Du erkennst nur einen riesengrossen Saal.");
  
  AddDetail( ({"Saal"}),
	     "Du musst schon hineingehen um mehr zu sehen.");
  
  AddDetail( ({"hineinkuscheln"}),
	     "Probier es einfach!");
  
  
  AddSmell(DEFAULT_SMELL, "Du riechst Blumen und auch klare Luft.");  
  
  AddSmell( ({"blumen","blume"}),
	    "Sie duften frisch und suess.");
  
  AddSmell( ({"luft"}),
	    "Du schnupperst an der klaren Luft und fuehlst Dich frei.");
  
  
  AddSound(DEFAULT_SOUND, "Der Wind haucht ueber den Platz und wird vom "
	   "munteren Plaetschern des Springbrunnens unterbrochen.");
  
  AddSound( ({"wind","hauch","hauchen","haucht"}),
	    "Fast haette er Dich magisch verfuehrt ihm zu folgen!!");
  
  AddSound( ({"plaetschern","springbrunnen","brunnen","wasser"}),
	    "Platsch - platsch - platsch!");
  
  AddSound( ({"klappern"}),
	    "SCHNAP .... KLAPPER!");
  
  
  AddReadDetail( ({"schrift"}),
		 "Amaryllis   Anemona   Ambrosia");
  
  AddReadDetail( ({"gravur"}),
		 "Liliandor - Moege Dein Schicksal Dich treu leiten.");
  
  AddReadDetail( ({"plakette"}),
		 "Anemona");
  
  //-----Details Ende-----
  
  AddItem(NPC "luftfee", REFRESH_DESTRUCT);
  AddItem(NPC "luftfee", REFRESH_DESTRUCT);
  
  AddExit("suedosten",ROOM "ws2");
  AddExit("suedwesten",ROOM "ws8");
  
  /*  NewDoor( "norden",ROOM "wp1", ({"tor","palasttor"}),
      ({ D_NAME,"Palasttor",
      D_GENDER,NEUTER,
      D_SHORT,"Ein grosses %ses Palasttor.",
      D_LONG, "Das Tor besteht aus einem dicken Milchglas. Oberhalb "
      "des Tors ist eine\nSchrift eingelassen, die mystisch wirkt. Du "
      "versuchst, durch die Ritzen\nhindurch zu spaehen, aber leider "
      "erkennst Du nichts vom Inneren.\n"}));*/
  
  AddCmd( ({"kuschel","kuschle","kuschele"}),"cmd_kuscheln" );
  AddCmd( ({"beisse","beiss"}),"cmd_beissen" );
  AddCmd( ({"oeffne"}),"cmd_tor");
}

int cmd_kuscheln(string str)   
{
  notify_fail("Wo willst Du Dich hineinkuscheln?\n");
  
  if(!(str=="in wolke"||
       str=="in wolken"||
       str=="in wolke hinein"||
       str=="in wolken hinein")) 
    return 0;
  
  write(BS("Du schmeisst Dich voller Freude in die Wolken und waelzt Dich "
	   "herum."));
  
  say(BS(TPN+" kuschelt sich in den Boden und scheint wirklich Freude zu "
	 "haben."));
  
  return 1;
}

int cmd_beissen(string str)	
{
  
  notify_fail("Wo willst Du rein beissen?\n");
  
  if(!(str=="in sockel"||
       str=="in wolken"||
       str=="sockel"||
       str=="in sockel rein"||
       str=="in wolken rein")) 
    return 0;
  
  write(BS("Du beisst in feuchte Luft und klapperst mit den Zaehnen."));
  
  say(BS(TPN+" versucht in den Sockel zu beissen und Du hoerst Zaehne "
	 "klappern."));
  
  return 1;
  
}

int cmd_tor(string str)	
{

  notify_fail("Was willst Du oeffnen?\n");
  
  if(!(str=="tor"||
       str=="palasttor")) 
    return 0;
  
  write(BS("Du ruettelst an dem Tor, aber es geht nicht auf. Der Palast "
	   "befindet sich anscheinend noch im Aufbau."));
  
  say(BS(TPN+" ruettelt an dem Tor, aber es laesst sich anscheinend nicht "
	 "oeffnen."));
  
  return 1;
}


public void init() {
	::init();
  
	if(interactive(this_player())) {
	  check_bard_awf_quest(this_player());
	}
  }
  
