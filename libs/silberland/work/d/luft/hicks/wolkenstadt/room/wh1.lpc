// Raum meines Gesellenstueckes "Wolkenstadt"
inherit "std/pub";

#include "../def.h"
#include <pub.h>


void create()
{
  ::create();
  
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp(P_INT_SHORT,"In der Taverne 'Zur suessen Versuchung'");
  
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "viola");
  SetProp(P_PUBKEEPER_NAME, "Viola");
  SetProp(P_PUBMSG_NOKEEPER, "Viola ist leider nicht anwesend.\n");
  SetProp(P_PUBMSG_NOENEMY, BS(
			       "Du bist gerade in einem verbissen Kampf mit Viola. Da wird sie Dich "
			       "sicher nicht bedienen, wenn Du sie bedrohst."));
  SetProp(P_PUBMSG_NOINVITE, BS(
				"Viola kaempft gerade beschaeftigt und hat Dich nicht bemerkt."));
  SetProp(P_PUBMSG_FIGHTING, "Viola kaempft gerade.\n");
  
  
  AddFood("Rosa Zuckerwatte", ({"zuckerwatte","watte"}), 
	  53, 10, 4,
	  ({"Viola haelt Dir laechelnd einen Stab voll Zuckerwatte hin.\n"
	      +"Du verspeist genuesslich die Zuckerwatte und schleckst anschliessend "
	      "noch die Finger sauber. Mjam!!\n",
	      "&& verspeist gierig die Zuckerwatte.\n"}));
  
  AddFood("Rosenbluetendessert", ({"rosenbluetendessert","bluetendessert","dessert"}), 
	  145, 17, 8,
	  ({"Viola bringt Dir ein Tellerchen mit dem Dessert.\n"
	      +"Mhh, dieses Aroma... Mhhh, diese Suesse!!!\n",
	      "&& geniesst manierlich ein Rosenbluetendessert.\n"}));
  
  AddFood("Troll im Hemd", ({"troll im hemd","troll","hemd"}), 
	  170, 20, 9,
	  ({"Viola sprueht noch etwas Schlagobers drauf und serviert Dir "
	      "Deinen Troll im Hemd.\n"
	      +"Du geniesst den Schokoladetrollkopf und das Obers. Mjam!!! "
	      "Ein Genuss!\n",
	      "&& schlemmert an einem Schokoladetrollkopf.\n"}));
  
  AddFood("Kristallbeerensuppe", ({"kristallbeerensuppe","beerensuppe","suppe"}), 
	  267, 25, 10,
	  ({"Viola jongliert den Teller Suppe durch die Menge.\n"
	      +"Du kostet die eisblaue Suppe und schon schiesst das Kristalleis durch "
	      "dein Hirn. WOAAAAAHHH!!!\n",
	      "&& isst die eisblaue Suppe und verzieht das Gesicht vor Kaelte.\n"}));
  
  AddDrink("Himbeersirup", ({"himbeersirup","sirup"}), 
           23, 9, 0, 3,
           ({"Du bekommst einen Becher dickfluessigen, dunkelrosanen Sirup.\n"
	       +"Du denkst Dir: Runter mit dem Schloder! und kippst alles hinunter.\n"
	       +"Der Sirup klebt Dir im Rachen und Du kannst ein Wuergen unterdruecken.\n",
	       "&& kippt den Himbeersirup runter und wuergt danach kurz.\n"}));
  
  AddDrink("Zitronenlimonade", ({"zitronenlimonade","limonade","limo"}), 
           71, 14, 0, 5,
           ({"Viola presst frische Zitronen aus und vermengt es mit Zucker und Wasser.\n"
	       +"Mhhh, diese Limonade war lecker. Dein Durst ist geloescht.\n",
	       "&& trinkt eine Zitronenlimonade und fuehlt sich erfrischt.\n"}));
  
  AddDrink("Beschwippste Fee", ({"beschwippste fee","fee"}), 
           176, 25, 9, 1,
           ({"Viola serviert Dir ein violettes Getraenk in einem Glas mit Fluegel.\n"
	       +"Du kippst die Fee runter und kannst Dein Kichern nicht mehr unterdruecken.\n",
	       "&& trinkt eine beschwippste Fee und faengt wie wild zu kichern an.\n"}));
  
  AddDrink("Wolkenstuermer", ({"wolkenstuermer", "stuermer"}), 
	   289, 37, 8, 6,
           ({"Viola stellt Dir eine Eprouvette mit klarem, hellblauem Inhalt hin.\n"
	       +"Du nippst an dem Roehrchen und schon hebst Du leicht ab.\n"
	       +"Du schwebst ueber dem Boden und landest wieder mit einem Plumps auf dem Boden.\n",
	       "&& hebt leicht ab und landet mit einem Plumps wieder auf dem Boden.\n"}));
  
  //-----Details Anfang-----
  
  AddDetail( ({"cute","marrogh","maghnar","niri","gaya","zidane","nyx","wumanzu",
	       "elrohir","velkyn","took","aroobah","methos","katarok"}),
	      "Ja, dieser Spieler hat mir geholfen, dass dieses Gebiet noch besser "
	      "und schoener wird.");

  AddDetail( ({"taverne"}),
	     "Du stehst mitten in der Taverne. Blick dich mal um!!!");
  
  AddDetail( ({"spiegel","zauberspiegel"}),
	     "Du betrachtest den Spiegel naeher und merkst, dass sich die "
	     "rosa Oberflaeche bewegt, als waere sie aus Wasser.");
  
  AddDetail( ({"oberflaeche"}),
	     "Das scheint irgendwie ein Zauberspiegel zu sein. Du verspuerst "
	     "das Verlangen Dich im Spiegel zu betrachten.");
  
  AddDetail( ({"verlangen"}),
	     "Du gehst schon zum Spiegel hin. Jetzt musst Du Dich darin nur "
	     "noch betrachten.");
  
  AddDetail( ({"wasser"}),
	     "Das Wasser bewegt sich ganz leicht.");
  
  AddDetail( ({"versuchung","versuchung'"}),
	     "Viola hat wirklich kulinarische Versuchungen anzubieten.");
  
  AddDetail( ({"versuchungen"}),
	     "Du kannst Dich Deinen hingeben indem Du 'menue* tippst.");
  
  AddDetail( ({"viola"}),
	     "Viola ist die Wirtin hier.");
  
  AddDetail( ({"wirtin"}),
	     "Sie scheint momentan nicht da zu sein.");
  
  AddDetail( ({"glastische","tische","tischen"}),
	     "Sie sind sehr filigran und bestehen aus Glas. Ueberall befinden "
	     "sich Blumengestecke, mit eingearbeiteten Perlen, darauf.");
  
  AddDetail( ({"glashocker","hocker"}),
	     "Die Hocker stehen rund um die Tische. Hohe Hocker befinden sich "
	     "bei der Theke.");
  
  AddDetail( ({"blumengestecke","gestecke","gesteck"}),
	     "Sie schmuecken die Tische und die Theke. Es sind "
	     "Glasblumen, die zwischen echtem Gruen eingearbeitet wurden.");
  
  AddDetail( ({"glasblumen","blumen"}),
	     "Du koenntest an ihnen riechen. Da sie durchsichtig sind, kannst "
	     "Du nicht feststellen, welche Blumen das sind.");
  
  AddDetail( ({"veilchen"}),
	     "Sie sind wunderschoen und sehr filigran. Sie duften so suess "
	     "blumig.");
  
  AddDetail( ({"gruen"}),
	     "Ist einfach so ein Gruenzeugs von draussen.");
  
  AddDetail( ({"gruenzeugs","zeugs"}),
	     "Gras, Blaetter, Ranken, Farne, Efeu und vieles mehr.");
  
  AddDetail( ({"gras","blaetter","ranken","farne"}),
	     "Das besteht aus einem kristallenem Gruen.");
  
  AddDetail( ({"efeu"}),
	     "Du betrachtest den Efeu naeher und entdeckst ein Glitzern "
	     "darunter.");
  
  AddDetail( ({"glitzern"}),
	     "Du musst den Efeu wohl wegschieben, um zu sehen was sich "
	     "dahinter verbirgt.");
  
  AddDetail( ({"untertasse"}),
	     "Die Untertasse ist auch aus Glas, aber sie war von dem ueppigen "
	     "Gesteck gut versteckt.");
  
  AddDetail( ({"decke","boden"}),
	     "Die Decke und der Boden bestehen aus Wolken.");
  
  AddDetail( ({"wolken"}),
	     "Sie sind rund, wattig und unebenmaessig.");
  
  AddDetail( ({"wand","waende","waenden","glaswand","glaswaende"}),
	     "Sie bestehen aus Glas und sind mit Blumen- und Perlengirlanden "
	     "geschmueckt.");
  
  AddDetail( ({"girlande"}),
	     "Meinst Du die Blumengirlande oder die Perlengirlande?");
  
  AddDetail( ({"blumengirlande","blumengirlanden"}),
	     "Sie sind mit den Perlengirlanden verflochten und machen die "
	     "Taverne sehr lieblich.");
  
  AddDetail( ({"perlengirlanden","perlengirlande"}),
	     "Die Perlengirlande ist mit den Blumengirlanden verflochten und "
	     "schmueckt die Wand. Sie besteht aus lauter kleinen und grossen "
	     "Perlen.");
  
  AddDetail( ({"glasperlen","perlen"}),
	     "Die Perlen funkeln im Licht. Sie zeigen alle Pastellfarben.");
  
  AddDetail( ({"licht"}),
	     "Das Licht strahlt durch die Glaswaende und durchflutet die "
	     "Taverne.");
  
  AddDetail( ({"pastellfarben","farben"}),
	     "Lauter zarte Farben blitzen auf und gehen in eine andere Farbe ueber. "
	     "Man koennte glauben, dass es Eis waere.");
  
  AddDetail( ({"farbe"}),
	     "Die andere Farbe ist sicher auch pastellig.");
  
  AddDetail( ({"eis"}),
	     "Vielleicht sind die Glasperlen aus Wassereis?");
  
  AddDetail( ({"wassereis"}),
	     "Wassereis schmeckt bestimmt lecker.");
  
  AddDetail( ({"glastheke","theke"}),
	     "Die Glastheke befindet sich an der Hinterwand. Auf ihr sind "
	     "lauter huebsche Speisekarten aufgestellt. Die Hocker davor "
	     "schaffen eine gemuetliche, helle Atmosphaere.");

  AddDetail( ({"speisekarten","karten","speisekarte","karte"}),
	     "Du kannst die Speisekarten mit 'menue' lesen.");
  
  AddDetail( ({"atmosphaere"}),
	     "Du fuehlst Dich hier sehr wohl und moechtest Dir gleich etwas "
	     "bestellen. Na, wie waere es?");
  
  AddDetail( ({"hinterwand"}),
	     "An der Hinterwand sind Regale mit verschiedenen Flaschen, "
	     "Glaesern und Tellern befuellt.");
  
  AddDetail( ({"regale","regalen"}),
	     "Selbst die Regale bestehen aus sauberem Glas.");
  
  AddDetail( ({"flaschen"}),
	     "Sie sind unterschiedlich geformt und beinhalten verschiedene "
	     "Farben.");
  
  AddDetail( ({"glaeser","glaesern"}),
	     "Sie sind ordentlich in den Regalen aufgeschlichtet.");
  
  AddDetail( ({"teller"}),
	     "Glaeserne Teller sind rechts unten zu finden.");
  
  AddDetail( ({"glas"}),
	     "Kristallenes, verschwommenes Glas.");
  
  AddDetail( ({"schokolade","appetit"}),
	     "Du musst Dir schon was bestellen.");
  
  AddDetail( ({"mund"}),
	     "Dein Mund ist schon ganz waessrig von all den Geruechen.");
  
  AddDetail( ({"gerueche","geruechen"}),
	     "Du kannst Dich einfach nicht satt riechen.");
  
  AddDetail( ({"leute"}),
	     "Luftfeen flattern herein und bestellen sich was. Andere sind "
	     "schon wieder am gehen.");
  
  AddDetail( ({"luftfeen","feen"}),
	     "Huebsche, kleine flatterhafte Dinger.");
  
  AddDetail( ({"dinger","ding"}),
	     "Ja, kleine Dinger, das sind die Feen.");
  
  AddDetail( ({"tischkannte","kante"}),
	     "Auf manchen Tischkanten sitzen kichernde Feen.");
  
  AddDetail( ({"fee","junge fee"}),
	     "Das kleine Ding schluerft genuesslich ihr Getraenk. Vielleicht "
	     "solltest Du auch eines probieren?");	    
  
  AddDetail( ({"getraenk"}),
	     "Mit 'menue' kannst Du sehen was es gibt.");
  
  AddDetail( ({"gaeste","gaesten"}),
	     "Du kannst haupstaechlich Feen erkennen, aber auch Gnome und "
	     "einen Wolkenriesen.");
  
  AddDetail( ({"gnome","gnom"}),
	     "Waehrend die Feen schwatzend auf den Tischen sitzen, sind die "
	     "Gnome eher eigenbroedlerisch und ruhig.");
  
  AddDetail( ({"wolkenriese","riese"}),
	     "Er laechelt Dich mit froehlich an und sein blaues Haar fasziniert "
	     "Dich.");
  
  AddDetail( ({"haar"}),
	     "Es schimmert seidig blau im Licht.");

  AddDetail( ({"treiben"}),
	     "Leute kommen und gehen.");

  AddDetail( ({"zunge"}),
	     "Dieses Detail ist Elira gewidmet.");

  AddDetail( ({"detail"}),
	     "Frage lieber Elira danach ;-)");

  AddDetail( ({"elira"}),
	     "teile elira mit Wieso wolltest Du das Detail Zunge haben?");
  
  
  AddSmell(DEFAULT_SMELL, "Du riechst Schokolade, Zuckerwatte, Blumenduft "
	  "und auch einen anderen intensiven Geruch.");
  
  AddSmell( ({"schokolade"}),
	    "Mhhh, Du bekommst Appetit darauf.");
  
  AddSmell( ({"appetit","mund"}),
	    "Den kannst Du nicht riechen.");
  
  AddSmell( ({"zuckerwatte","watte","zucker"}),
	    "Dir rinnt schon alles im Mund zusammen.");
  
  AddSmell( ({"blumenduft","duft"}),
	    "Es riecht suesslich und frisch zugleich. Du bist gleich viel "
	    "entspannter.");
  
  AddSmell( ({"geruch"}),
	    "Du schnueffelst ein wenig herum und entdeckst, dass es Alkohol "
	    "sein muss.");
  
  AddSmell( ({"alkohol"}),
	    "Er riecht sehr frisch und ist nicht wirklich definierbar.");
  
  AddSmell( ({"glasblumen","blumen"}),
	    "Sie riechen nach Veilchen, obwohl sie nicht so huebsch violett "
	    "sind.");
  
  
  AddSound(DEFAULT_SOUND, "Es herrscht angenehmes Treiben. Du vernimmst das "
	   "Murmeln der Gaeste und das Klirren der Teller und Glaeser.");
  
  AddSound( ({"treiben"}),
	    "Du hoerst zwar Gaeste tratschen und murmeln, aber das Treiben "
	    "kann man auch sehen.");
  
  AddSound( ({"murmeln","gaeste"}),
	    "An verschiedenen Tischen tratschen Luftfeen miteinander.");
  
  AddSound( ({"luftfeen","feen"}),
	    "Sie kichern und albern herum. Einige sitzen auf den Tischkanten, "
	    "anderen auf den Glashockern.");
  
  AddSound( ({"kichern"}),
	    "Das herzigste Kichern das Du je gehoert hast. Du musst laecheln.");
  
  AddSound( ({"tischen","leute","theke","glashockern","glashocker","hocker",
		"tischkanten","kanten"}),
	    "Daran kannst Du nicht lauschen.");
  
  AddSound( ({"klirren","glaesser","teller"}),
	    "Hinter der Theke wird geschaeftigt gearbeitet.");

  AddSound( ({"tratschen"}),
	    "Das geht doch zuweit. Sei doch nicht so neugierig!");
  
  
  AddReadDetail( ({"speisekarte","speisekarten","karte","karten"}),
		 "Tippe 'menue'");
  
  //-----Details Ende-----
  
  AddExit("suedwesten",ROOM "ws2");
  
  AddItem(NPC "viola", REFRESH_DESTRUCT);
  
  AddCmd( ({"schiebe","schieb"}),"cmd_schieben");
  AddCmd( ({"blick","blicke"}),"cmd_umblicken");
  AddCmd( ({"betrachte"}),"cmd_betrachten");
  AddCmd( ({"kost","koste","probier","probiere","schlecke","schleck","iss",
	      "esse","leck","lecke"}),"cmd_kosten");
  AddCmd( ({"setze","sitz","setz"}),"cmd_sitzen");
  
}

string _query_int_long()     
{
  string txt;
  
  txt = "Du bist in der Taverne 'Zur suessen Versuchung'. Ueberall befinden "
    "sich Glastische und Glashocker. An der Decke und an den Waenden "
    "sind lauter Perlen- und Blumengirlanden aufgehaengt. Auch die "
    "Glastheke, auf der sich eine Speisekarte befindet, ist mit Perlen "
    "geschmueckt. Durch die dicken Glaswaende kommt viel Licht herein. "
    "Alles glitzert und ist blitzeblank sauber.";
  
  if(QueryProp(P_PUBKEEPER_ID))
    {
      if(!present(QueryProp(P_PUBKEEPER_ID)))
	{
	  txt += "Im Moment scheint keine Bedienung anwesend zu sein. Du koenntest "
	    "ja ein wenig warten.";
	}
      else
	{
	  txt += " Die Wirtin flirtet kichernd mit den Gaesten. Sie erblickt "
	    "Dich und laechelt Dich freundlich an.";
	}
    }
  return BS(txt);
}

int cmd_schieben(string str)	
{
  
  notify_fail("Was willst Du wegschieben?\n");
  
  if(!(str=="efeu"||
       str=="efeu weg"||
       str=="efeu zur seite"||
       str=="efeu beiseite"||
       str=="efeu auseinander")) 
    
    return 0;

  write(BS("Du schiebst den Efeu zur Seite. Du erkennst eine Untertasse "
	   "gefuellt mit Wasser, das sich im Licht spiegelt."));
  say(TPN+" wuehlt in einem Blumengesteck.\n");
  
  return 1;
}

int cmd_umblicken(string str)	
{
  
  notify_fail("Du willst Dich vielleicht umblicken?\n");
  
  if(!(str=="um"||
       str=="in taverne um"||
       str=="herum"||
       str=="mich um"||
       str=="mich in taverne um"||
       str=="mich herum")) 
    
    return 0;
  
  write(BS("Du drehst Dich einmal langsam um. Die durchsichtigen Glaswaende "
	   "lassen viel Licht herein. Zur linken und zur rechten Seite sind "
	   "Glastische mit Hocker. Gerade aus an der hinteren Wand ist eine "
	   "grosse Glastheke mit einem Spiegel. Der Spiegel ist Dir vorher gar "
	   "nicht aufgefallen."));
  say(TPN+" blickt sich einmal in der Taverne um.\n");
  
  return 1;
}

int cmd_betrachten(string str)    
{
  
  notify_fail("Worin willst Du Dich betrachten?\n");
  
  if(!(str=="in spiegel"||
       str=="in oberflaeche"||
       str=="mich in spiegel"||
       str=="mich in oberflaeche"||
       str=="in zauberspiegel"||
       str=="mich in zauberspiegel")) 
    
    return 0;
  
  write(BS("Du betrachtest Dich im Spiegel. Du erkennst Dich selber, aber "
	   "ploetzlich wandelt sich Dein Gesicht um. Die Zuege werden immer "
	   "zarter. Deine Hautfarbe wird sehr blass und Deine Augen "
	   "pastellig gruen. Erschreckt ueber deine Luftfeengestalt reisst "
	   "Du Dich vom Spiegel los."));
  say(TPN+" betrachtet sich im Spiegel.\n");
  
  return 1;
}

int cmd_kosten(string str)	
{
  
  notify_fail("Was willst Du denn kosten?\n");
  
  if(!(str=="perle"||
       str=="glasperle"||
       str=="eisperle"||
       str=="eis"||
       str=="wassereis")) 
    
    return 0;
  
  write(BS("Du pflueckst Dir eine kalte Glasperle und steckst sie in den "
	   "Mund. Sie zergeht auf der Zunge langsam. Sie schmeckt eiskalt und "
	   "sehr erfrischend. Mhhh. Du wirst suechtig danach und moechtest noch "
	   "eine kosten."));
  say(TPN+" pflueckt sich eine Glasperle und lutscht sie.\n");
  
  return 1;
}

int cmd_sitzen(string str)
{
  
  notify_fail("Worauf willst Du Dich setzen?\n");
  
  if(!(str=="auf hocker"||
       str=="auf glashocker"||
       str=="hin"||
       str=="nieder")) 
    
    return 0;
  
  write(BS("Du setzt Dich auf einen Hocker und wartest auf die Bedienung. Du "
	   "beobachtest zwei Feen beim Kichern. Ein Wolkenriese laechelt "
	   "froehlich in die Runde, waehrend er genuesslich seine Speise "
	   "verzerrt. Ein Gnom schnueffelt durch die Gegend und scheint sehr "
	   "mies drauf zu sein. Du erhebst Dich wieder."));
  say(TPN+" setzt sich auf einen Hocker.\n");
  
  return 1;
}
