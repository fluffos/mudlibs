// von Hicks
// 20.1.2004
// 
// Raum meines Gesellenstueckes "Innerer Strassenring - Wolkenstadt"

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();
  
  
  SetProp(P_INT_SHORT, "Strasse in der Wolkenstadt");
  SetProp(P_INT_LONG,
	  "Die Strasse zieht sich vom Nordplatz zum Westplatz. Auf der einen "
	  "Seite befinden sich Haeuser in verschiedensten Formen und wirken "
	  "irgendwie verspielt auf Dich. Gegenueber sticht Dir ein filigraner "
	  "Turm ins Auge, der von einem Park umsaeumt wird. Zur rechten Hand "
	  "siehst Du ein Biotop mit Wasserrosen und zur linken erkennst Du einen "
	  "Springbrunnen.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);
  
  
  //-----Details Anfang-----
  
  AddDetail( ({"cute","marrogh","maghnar","niri","gaya","zidane","nyx","wumanzu",
	       "elrohir","velkyn","took","aroobah","methos","katarok"}),
	      "Ja, dieser Spieler hat mir geholfen, dass dieses Gebiet noch besser "
	      "und schoener wird.");
  
  AddDetail( ({"strasse"}),
	     "Du befindest Dich auf ihr und sie zieht vom Nordplatz zum "
	     "Westplatz.");
  
  AddDetail( ({"platz"}),
	     "Welchen meinst Du, den Nordplatz oder den Westplatz?");
  
  AddDetail( ({"Westplatz"}),
	     "Er befindet sich suedwestlich von Dir und Du siehst nur eine "
	     "rosa leuchtende Statue platziert.");
  
  AddDetail( ({"Nordplatz"}),
	     "Dort thront der Feenpalast mit einem wunderschoenen Palasttor. "
	     "Auch dort erkennst Du eine blaeulich glitzernde Statue.");
  
  AddDetail( ({"palast","feenpalast","palastes"}),
	     "Er besteht fast vollstaendig aus Glas und ist recht gross.");
  
  AddDetail( ({"palasttor","tor"}),
	     "Was sich wohl hinter dem Tor verbergen mag? Vielleicht ein "
	     "grosser Tanzsaal?");
  
  AddDetail( ({"tanzsaal","saal"}),
	     "Vielleicht wirklich?");
  
  AddDetail( ({"statue"}),
	     "Du musst schon hingehen, wenn Du sie sehen willst.");
  
  AddDetail( ({"seite"}),
	     "Auf jeder Seite ist etwas zu entdecken.");
  
  AddDetail( ({"haeuser"}),
	     "Die Haeuser glitzern und glaenzen alle in verschiedensten "
	     "Farben. Einige bestehen nur aus Glas, andere aus Wolkensteinen "
	     "und manche aus beidem.");
  
  AddDetail( ({"farben"}),
	     "Das sind alle moeglichen Farben des Regenbogens. Rot, Orange, "
	     "Gelb, Gruen, Blau, Violett.");
  
  AddDetail( ({"gelb","orange","rot","violett","blau","gruen"}),
	     "Es explodiert vor Dir ein wahres Feuerwerk.");
  
  AddDetail( ({"farbfeuerwerk","feuerwerk","werk"}),
	     "Die Farben schimmern in Pastell.");
  
  AddDetail( ({"pastell"}),
	     "Sind nicht so kraeftig wie normale Farben, sondern mit etwas "
	     "weiss vermischt.");
  
  AddDetail( ({"glas"}),
	     "Das Glas kann transparent, milchig oder uneben sein. Je nachdem "
	     "funkelt oder schimmert es. Hin und wieder zieren Kletterpflanzen "
	     "die Waende.");
  
  AddDetail( ({"pflanzen"}),
	     "Meinst Du die Kletterpflanzen oder die Schlingpflanzen?");
  
  AddDetail( ({"kletterpflanzen"}),
	     "Sie wuchern ueber manche Waende und schimmern gruen-weisslich. "
	     "Sie haben geschwungene, glatte Blaetter.");
  
  AddDetail( ({"blaetter"}),
	     "Hie und da welche und alle sind gruen. Wie erstaunlich! ;-)");
  
  AddDetail( ({"hand","haende"}),
	     "Du betrachtest Deine Haende genau. Die feinen Strukturen auf "
	     "der Handflaeche - Ob man daraus wirklich lesen kann?");
  
  AddDetail( ({"strukturen","handflaeche"}),
	     "Viele feine Linien ziehen sich drueber.");
  
  AddDetail( ({"linien"}),
	     "Sie sind nicht gerade, eher gebogen, zittrig und verzweigt.");
  
  AddDetail( ({"wind","windhauch","hauch"}),
	     "Der Wind streift sanft ueber die Buesche und schmeichelt ueber "
	     "Deine Haut.");
  
  AddDetail( ({"haut"}),
	     "Mhhh, Du geniesst es einfach.");
  
  AddDetail( ({"wand","waende","glaswand"}),
	     "Die Waende bestehen aus Glas, Wolkensteinen oder aus beidem. "
	     "Kletterpflanzen zieren manche Haeuser.");
  
  AddDetail( ({"form","formen"}),
	     "Manche sind rechteckig, andere rund, andere wieder"
	     " kuppelfoermig. Manche sind verschlossen, andere offen, andere "
	     "wiederrum haben gar keine Tueren und Fenster.");
  
  AddDetail( ({"tuer","tueren","fenster"}),
	     "Wie gesagt, nicht alle Haeuser haben welche.");
  
  AddDetail( ({"turm"}),
	     "Der Turm liegt gruen-weisslich mitten im Park und besteht aus "
	     "vielen Schlingpflanzen. Die rosa Glaskuppel passt "
	     "sich oberhalb farblich wunderschoen an den Turm an.");
  
  AddDetail( ({"auge"}),
	     "Der Turm ist nicht zu uebersehen, neben den zwei kleinen "
	     "Tuermchen des Palastes.");
  
  AddDetail( ({"tuermchen"}),
	     "Sie besitzen genauso eine Glaskuppel, aber sie liegen viel "
	     "tiefer als der Turm.");
  
  AddDetail( ({"schlingpflanzen"}),
	     "Es bieten sich gleich zwei fast-direkte Wege an!");
  
  AddDetail( ({"weg","wege"}),
	     "Einer wird schon der rechte Weg sein.");
  
  AddDetail( ({"glaskuppel","kuppel"}),
	     "Sie funkelt wunderschoen rosa auf der Turmspitze.");
  
  AddDetail( ({"turmspitze","spitze"}),
	     "Da thront die Glaskuppel wie ein Juwel.");
  
  AddDetail( ({"juwel"}),
	     "Er glitzert hoch oben, doch ploetzlich winkt Dir Jemand zu.");
  
  AddDetail( ({"jemand"}),
	     "Ob es eine Taeuschung war?");
  
  AddDetail( ({"taeuschung"}),
	     "Nein, doch nicht. Hier! Schon wieder!");
  
  AddDetail( ({"park"}),
	     "Buesche und Blumen erkennst Du auf der Wiese. Du siehst auch, "
	     "dass Du ueber den Park zum Turm gelangst und andererseits "
	     "kannst Du Dich dort sicher gut erholen.");
  
  AddDetail( ({"wiese"}),
	     "Die Wiese schimmert gruenlich.");
  
  AddDetail( ({"buesche","bueschen"}),
	     "Die Buesche zaeunen den Park ein. So ueber den direkten Weg "
	     "gelangst Du nicht in den Park.");
  
  AddDetail( ({"blumen"}),
	     "Die Blumen gedeihen in allen Farben. Eine rote Blume zittert ein "
	     "wenig.");
  
  AddDetail( ({"blume"}),
	     "Eigenartig. Das ist doch so nicht normal? Es duerfte von der "
	     "Wurzel her kommen.");
  
  AddDetail( ({"wurzel"}),
	     "So erkennst Du nichts, aber vielleicht kannst Du die Blume "
	     "heraus ziehen?");
  
  AddDetail( ({"biotop"}),
	     "Der Biotop ist wie ein kleiner Teich mit Wasserrosen und ein "
	     "wenig Wassergras.");
  
  AddDetail( ({"teich"}),
	     "Kein grosser, nur ein winzig kleiner - an die Feen, in der "
	     "Groesse, angepasst.");
  
  AddDetail( ({"groesse"}),
	     "Na, gross sind die Feen wirklich nicht.");
  
  AddDetail( ({"feen"}),
	     "Sie flattern so huebsch herum und kichern andauernd.");
  
  AddDetail( ({"wasserrosen","rosen"}),
	     "Sie sind zartrosa und stehen in der vollen Bluete. Sie "
	     "schwimmen sanft auf der Wasseroberflaeche hin und her.");
  
  AddDetail( ({"bluete","blueten"}),
	     "Sie sind geoeffnet. Die grossen Bluetenblaetter formen sich "
	     "wie zu einem grossen Kelch.");
  
  AddDetail( ({"bluetenblaetter","kelch"}),
	     "Die Bluetenblaetter formen einen Kelch in dem sich etwas "
	     "Tauwasser gesammelt hat.");
  
  AddDetail( ({"tauwasser","wasser"}),
	     "Obwohl es hier oben nie regnet, kann sich schon etwas Morgentau "
	     "ansammeln.");
  
  AddDetail( ({"morgentau","tau"}),
	     "Den kannst Du jetzt nicht sehen. Da musst Du schon frueher "
	     "herkommen.");
  
  AddDetail( ({"wasseroberflaeche","oberflaeche"}),
	     "Sie ist spiegelglatt, doch manchmal ist sie von einem "
	     "Wasserlaeufer kurz verschwommen.");
  
  AddDetail( ({"wasserlaeufer","laeufer"}),
	     "Sie flitzen blitzschnell ueber die Oberflaeche.");
  
  AddDetail( ({"wassergras","gras"}),
	     "Es wiegt sich im Wind hin und her.");
  
  AddDetail( ({"springbrunnen","brunnen","springbrunnens","brunnens"}),
	     "Er plaetschert munter vor sich hin und schimmert in allen "
	     "Farben.");
  
  AddDetail( ({"plaetschern"}),
	     "Du kannst daran lauschen.");
  
  AddDetail( ({"boden"}),
	     "Der Boden ist von wattigen Wolkensteinen gesaeumt. Du sinkst "
	     "beim gehen immer ein wenig ein. Das animiert Dich doch glatt "
	     "zum springen.");
  
  AddDetail( ({"wolkensteine","wolkensteinen","steine","steinen"}),
	     "Sie bestehen aus Wolken, wie fast alles hier.");
  
  AddDetail( ({"wolken"}),
	     "Sie bestehen nur aus feuchter Luft.");
  
  AddDetail( ({"himmel"}),
	     "Ein Regenbogen spannt sich ueber den Himmel. Dieser ist wolkenlos "
	     "und blau. Die Sonne laechelt Dir munter zu.");
  
  AddDetail( ({"regenbogen","bogen","regenbogens"}),
	     "Ein bunter Bogen, der in allen Farben schimmert.");
  
  AddDetail( ({"sonne"}),
	     "Die Sonne laechelt Dir zu und waermt die Luft etwas an, weil es "
	     "doch normalerweise viel kaelter hier oben waere.");
  
  AddDetail( ({"luft"}),
	     "Die Luft ist ganz klar und eigentlich kuehl, wenn da nicht die "
	     "Sonne waere.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	     "Du kannst Dich nie vergessen!");
  
  AddDetail( ({"duft","blumenduft"}),
	     "Rieche ihn mal.");
  
  AddDetail( ({"ahnung"}),
	     "Davon hast Du echt keine Ahnung.");
  
  AddDetail( ({"leserin","handleserin"}),
	     "Irgendwo laesst sich sicher eine auftreiben.");
  
  
  AddSmell(DEFAULT_SMELL, "Du erkennst nur Blumenduft und ansonsten klare "
	   "Luft.");  
  
  AddSmell( ({"duft","blumen","blumenduft"}),
	    "Sie duften frisch und suess.");
  
  AddSmell( ({"luft"}),
	    "Du schnupperst an der klaren Luft und fuehlst Dich frei.");
  
  
  AddSound(DEFAULT_SOUND, "Manchmal zieht ein zarter Windhauch durch die "
	   "Strasse, der vom plaetschernden Springbrunnen unterbrochen wird.");
  
  AddSound( ({"wind","hauch","windhauch"}),
	    "Er fluestert Dir: Folge mir und spiel mit mir!");
  
  AddSound( ({"plaetschern","springbrunnen"}),
	    "PLITSCH PLATSCH");
  
  
  AddReadDetail( ({"aus hand","hand","aus der hand","linien","aus linien",
		     "strukturen","aus strukturen"}),
		 "Davon hast Du wirklich keine Ahnung. Entweder lass es bleiben "
		 "oder gehe zu einer Handleserin.");
  
  //-----Details Anfang-----
  
  AddExit("nordosten",ROOM "ws1");
  AddExit("suedwesten",ROOM "ws7");
  AddExit("osten",ROOM "ws9");
  AddExit("sueden",ROOM "ws12");
  AddExit("nordwesten",ROOM "wh2");
  
  
  AddCmd( ({"zieh","ziehe","reiss","reisse"}),"cmd_blume");
  AddCmd( ({"spiel","spiele"}),"cmd_spielen");
}

int cmd_blume(string str)	
{
  notify_fail("Was willst Du heraus ziehen?\n");
  
  if(!(str=="blume heraus"||
       str=="blume aus"||
       str=="blume raus"||
       str=="an blume"||
       str=="wurzel heraus"||
       str=="wurzel aus"||
       str=="wurzel raus"||
       str=="an wurzel")) 
    return 0;
  
  write(BS("Du ziehst die Blume samt Wurzel heraus. Ein Maulwurf guckt aus "
	   "dem entstandenen Loch heraus und beschimpft Dich wuest. Ploetzlich "
	   "reisst er Dir die Blume aus der Hand, setzt sie sich auf den Kopf "
	   "und verschwindet im Boden."));
  
  say(BS(TPN+" reisst eine Blume heraus. Ploetzlich erscheint ein Maulwurf und "
	 "reisst "+TP->QueryPronoun(WEM)+" die Blume aus der Hand und "
	 "verschwindet schimpfend im Boden."));
  
  return 1;
}


int cmd_spielen(string str)	
{
  notify_fail("Womit willst Du spielen?\n");
  
  if(!(str=="wind"||
       str=="mit wind"||
       str=="mit dem wind")) 
    return 0;
  
  write(BS("Du huepfst und hopst herum, und wiegst und drehst Dich im Wind. "
	   "Der Wind dankt Dir mit einem Hautschmeichler ueber Dein Gesicht "
	   "und ist verschwunden. Du laechelst ihm noch nach."));
  
  say(BS(TPN+" huepft und hopt herum, und wiegt und dreht sich im Wind."));
  
  return 1;
}
