// Raum meines Gesellenstueckes "Park - Wolkenstadt"

inherit "std/room";

#include "../def.h"

int greifen=5;
int fisch_zahl=1;
int fang=0;
int gras=0;
int trinken=1;
int blumenzahl=3;

void create()
{
  ::create();
    
  SetProp(P_INT_SHORT, "Im Park der Wolkenstadt");
  SetProp(P_INT_LONG,
	  "Du stehst mitten in einem wunderschoenen Park, auf einer Wiese mit "
	  "vielen Blumen. Ein kleiner Springbrunnen plaetschert munter vor "
	  "sich hin. So hast Du Dir immer schon einen Palastbrunnen "
	  "vorgestellt, aber er wirkt sehr zierlich und fast zerbrechlich. Das "
	  "Wasser schillert in allen Regenbogenfarben im Brunnenbecken.");
  
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);
  
  //-----Details Anfang-----
  
  AddDetail( ({"cute","marrogh","maghnar","niri","gaya","zidane","nyx","wumanzu",
	       "elrohir","velkyn","took","aroobah","methos","katarok"}),
	      "Ja, dieser Spieler hat mir geholfen, dass dieses Gebiet noch besser "
	      "und schoener wird.");

  AddDetail( ({"park"}),
	     "Der Park ist von Bueschen umzaeunt. Mitten im Park ist der "
	     "Turm.");
  
  AddDetail( ({"bueschen","buesche"}),
	     "Sie sind gruen und hinter dem Brunnen platziert.");
  
  AddDetail( ({"turm"}),
	     "Zeit sich mal den Turm naeher anzusehen!");
  
  AddDetail( ({"zeit"}),
	     "Wie waere es mit jetzt?");
  
  AddDetail( ({"wiese"}),
	     "Die Wiese schimmert saftig gruen, glitzert da sie mit einer "
	     "Kristallschicht ueberzogen ist.");
  
  AddDetail( ({"kristallschicht","schicht"}),
	     "Alles ist davon ueberzogen und dadurch glitzert die Wiese "
	     "in der Sonne.");
  
  AddDetail( ({"blumen","wolkenblumen"}),
	     "Die Wolkenblumen sind wie kleine Farbkleckse in der Wiese. Manche sind "
	     "glaenzend, andere wattig weich. Es ist einfach jede Variation "
	     "vorhanden.");
  
  AddDetail( ({"farbkleckse","kleckse"}),
	     "Sie sind verstreut in der Wiese und geben ihr einen schoenen "
	     "Touch.");
  
  AddDetail( ({"touch"}),
	     "Fast schon zu modisch. Seufz! *zeigefinger weckstreck*");
  
  AddDetail( ({"variation"}),
	     "Eben glitzernd, wattig, perlmutschimmernd, matt, unscheinbar, "
	     "knallig, transparent, pastellig, klein und gross.");
  
  AddDetail( ({"brunnen","springbrunnen","palastbrunnen"}),
	     "Er hat einen Glasrand, sodass man von der Seite hineinblicken "
	     "kann.\nIn der Mitte ist eine Duese angebracht, durch die mit "
	     "Druck Wasser hinausgespritzt wird.");
  
  AddDetail( ({"mitte"}),
	     "Hier ist eine Duese montiert.");
  
  AddDetail( ({"duese"}),
	     "Du erkennst sie nicht wirklich, weil das Wasser unaufhoerlich "
	     "raus sprudelt.");
  
  AddDetail( ({"druck"}),
	     "Das Wasser wird mit Druck durch die Duese gepresst und dadurch "
	     "hat man diesen Springbrunnen-Effekt.");
  
  AddDetail( ({"springbrunnen-effekt","effekt"}),
	     "Ein Effekt, der sich lohnt ihn anzusehen.");
  
  AddDetail( ({"glasrand","rand"}),
	     "Du setzt Dich auf den geschwungenen, runden Glasrand und "
	     "pritschelst ein wenig in den Wellen herum.");
  
  AddDetail( ({"wasser"}),
	     "Das plaetschernde Wasser schillert in Regenbogenfarben.");
  
  AddDetail( ({"regenbogenfarben","farben"}),
	     "Schoene klare Farben.");

  AddDetail( ({"wellen"}),
	     "Durch die unruhigen Wellen erkennst Du nichts Genaues.");
  
  AddDetail( ({"genaues"}),
	     "Du starrst ins Wasser und erkennst kaum merkbare, bewegliche "
	     "Schemen.");
  
  AddDetail( ({"Schemen"}),
	     "Du hast keine Ahnung was das sein kann.");
  
  AddDetail( ({"Ahnung"}),
	     "Du zuckst ratlos mit den Schultern.");
  
  AddDetail( ({"schulter","schultern"}),
	     "Sie bewegen sich auf und ab.");
  
  AddDetail( ({"seite"}),
	     "Das Glas verschafft, wie bei einem Aquarium, eine klare "
	     "Sicht.");
  
  AddDetail( ({"glas"}),
	     "Das Glas laesst den Brunnen viel filigraner und zerbrechlicher "
	     "wirken.");
  
  AddDetail( ({"aquarium"}),
	     "Praktisch ist es ja ein Aquarium, wenn auch sehr gross.");
  
  AddDetail( ({"sicht"}),
	     "Du koenntest ja durch das Glas blicken, wenn da nicht ein paar "
	     "Grasbueschel im Weg waeren.");
  
  AddDetail( ({"grasbueschel","bueschel","gras"}),
	     "Sie sind genauso gruen wie die Wiese.");
  
  AddDetail( ({"weg"}),
	     "Du musst sie schon wegschieben, wenn Du durchs Glas blicken "
	     "willst.");
  
  AddDetail( ({"fische"}),
	     "Du erkennst sie nur an den schwarzen Augen. Sie haben eine "
	     "langen duenne Nase und sehen irgendwie suess aus. Du "
	     "verspuerst die Lust, wieder mal einen Fisch zu fangen.");
  
  AddSpecialDetail( ({"fisch"}),"detailfisch");
  
  AddDetail( ({"augen"}),
	     "Ansonsten ist alles durchsichtig, und schwer zu erkennen.");
  
  AddDetail( ({"nase"}),
	     "Sie ist schwer zu erkennen, aber die lange Nase laesst die "
	     "Fische putzig aussehen.");
  
  AddDetail( ({"lust"}),
	     "Ab ans Wasser und dann versuch Dein Glueck!");
  
  AddDetail( ({"glueck"}),
	     "Du musst es sicher oefters versuchen, aber es lohnt sich!");
  
  AddDetail( ({"glassteine","steine"}),
	     "Sie sind eher sehr klein und rund. Sie schimmern in "
	     "Regenbogenfarben.");
  
  AddDetail( ({"wasserpflanzen","pflanzen"}),
	     "Sie wiegen sich unruhig im Wasser hin und her.");
  
  AddDetail( ({"brunnenbecken","becken"}),
	     "Es ist bis zum Rand mit Wasser gefuellt, dass unruhig darin "
	     "herumschwappt.");
  
  AddDetail( ({"boden"}),
	     "Du stehst mitten in der Wiese.");
  
  AddDetail( ({"himmel"}),
	     "Der Himmel ist von warmen Sonnenstrahlen erfuellt, und die Luft "
	     "ist klar.");
  
  AddDetail( ({"sonnenstrahlen","strahlen"}),
	     "Die Sonne erwaermt die Luft, und Du fuehlst Dich richtig wohl.");
  
  AddDetail( ({"luft"}),
	     "Du kannst die Luft ja nicht wirklich sehen, aber Du entdeckst "
	     "noch einen Regenbogen am Himmel.");
  
  AddDetail( ({"regenbogen","bogen"}),
 	     "Er schimmert, wie kann es anders sein, in Regenbogenfarben. "
	     "Ein Puenktchen flitzt ploetzlich ueber den Himmel.");
  
  AddDetail( ({"puenktchen"}),
	     "Sieht aus wie ein Hippogreif.");
  
  AddDetail( ({"hippogreif"}),
	     "Er duerfte hier oben leben.");

  AddDetail( ({"exemplar"}),
	     "Damit sind Blumen gemeint.");
  
  AddDetail( ({"sonne"}),
	     "Ein Magier meinte, die Sonne ist hell!");
  
  AddDetail( ({"magier"}),
	     "Hehe, Du willst sicher wissen wer es ist. Dieses Detail ist "
	     "ihm gewidmet.");
  
  AddDetail( ({"detail"}),
	     "Pass auf, dass Du nicht in eine Scriptfalle tappst.");
  
  AddSpecialDetail( ({"scriptfalle","falle"}),"detailfalle");
  
  AddDetail( ({"tod","lars","tod:lars"}),
	     "*kicher* Jetzt hast Du Dich aber schoen erschreckt.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	     "Ein Fisch bist Du nicht, das ist klar.");
  
  
  AddSmell(DEFAULT_SMELL, "Du riechst das Gras und den Duft der Wolkenblumen.");
  
  AddSmell( ({"blumenduft","blumen","duft","wolkenblumen","wolkenblumenduft"}),
	    "Sie riechen herrlich und glitzern huebsch in der Wiese.");
  
  AddSmell( ({"wiese","gras"}),
	    "Es riecht saftig.");
  

  AddSound(DEFAULT_SOUND, "Das Wasser plaetschert unaufhoerlich vor sich hin "
	   "und die Luft rauscht um Deine Ohren.");
  
  AddSound( ({"wasser","plaetschern"}),
	    "*plitschplatsch*");
  
  AddSound( ({"luft","rauschen"}),
	    "schhhhhhhhhhhhhh");
  
  AddSound( ({"ohren"}),
	    "Du wackelst mit den Ohren, aber mehr hoerst Du nicht.");
  
  //-----Details Ende-----
  
  AddItem(NPC "biene", REFRESH_DESTRUCT);
  
  AddExit("sueden",ROOM "wst1");
  AddExit("westen",ROOM "ws8");
  AddExit("osten",ROOM "ws2");
  
  
  AddCmd( ({"blicke","schaue","sieh"}),"cmd_blicken");
  AddCmd( ({"schieb","schiebe","entferne"}),"cmd_schieben");
  AddCmd( ({"fang","fange"}),"cmd_fangen");
  AddCmd( ({"schwimm","schwimme","plantsch","plantsche"}),"cmd_schwimmen");
  AddCmd( ({"trink","trinke"}),"cmd_trinken");
  AddCmd( ({"pflueck","pfluecke"}),"cmd_blume");

}

void reset()	
{
 ::reset();
  greifen=5;
  fisch_zahl=1;
  fang=0;
  gras=0;
  trinken=1;
  blumenzahl=3;
}

string detailfisch()     
{
  if(fisch_zahl==1)
    {return(BS("Der Fisch schwimmt munter im Wasser vor sich hin. Er waere "
	       "sicher leicht zu fangen."));}
  return(BS("Der Fisch erblickt Dich und fluechtet in Panik unter eine "
	    "Wasserpflanze. Den kannst Du nicht mehr fangen."));
}

string detailfalle()     
{
  return(BS("[Tod:Lars] Eine Scriptfalle hat gerade "+TP->Name(WEN)+
	    " umgebracht."));
}

int cmd_blicken(string str)
{  
  notify_fail("Wo willst Du hindurch blicken?\n");
  
  if(!(str=="durch glas"||
       str=="durch glas hindurch"))
    return 0;
  
  if(gras!=1)
    {
      write(BS("Die Grasbueschel versperren Dir Deine Sicht."));
      return 1;
    } 
  else 
    {
      write(BS("Du beugst Dich hinunter und erspaehst lauter durchsichtige, "
	       "regenbogenfarbene Fische. Sie flitzen hin und her. Weiters erkennst "
	       "Du noch regenbogenfarbene Glassteine und gruene Wasserpflanzen."));
      
      say(BS(TPN+" blickt durch das Glas des Brunnens.")); 
      
      gras = 0;
      return 1;
    }
}

int cmd_schieben(string str)	
{
  notify_fail("Was willst Du wegschieben?\n");
  
  if(!(str=="grasbueschel weg"||
       str=="grasbueschel zur seite"||
       str=="grasbueschel auf die seite"||
       str=="grasbueschel auf seite"||
       str=="gras weg"||
       str=="gras zur seite"||
       str=="gras auf die seite"||
       str=="gras auf seite"|| 
       str=="bueschel weg"||
       str=="bueschel zur seite"||
       str=="bueschel auf die seite"||
       str=="bueschel auf seite"||
       str=="gras"||
       str=="grasbueschel"||
       str=="bueschel"))
    return 0;
  
  if(gras!=1)
    {
      write(BS("Mit einer lockeren Handbewegung entfernst Du das Gras vom "
	       "Springbrunnen."));
      
      say(BS(TPN+" schiebt das Gras beiseite."));
      
      gras=1;
      return 1;
    }
  else
    {
      write(BS("Das Glas wurde schon vom Gras befreit."));
      
      return 1;
    }
}
//------------------------------------------------------------------------

int cmd_fangen(string str)
{
  object regenbogenfisch;
  notify_fail( "Was moechtest Du fangen?\n" );
  if (!(str == "fisch" )) return 0;
  {
    if(fang<3)
      {
	write(BS("Du greifst immer wieder ins Wasser, doch der Fisch flutscht "
		 "immer wieder durch Deine Haende. Versuch es doch nochmals!!!"));
	
	say(BS(TPN+" greift immer wieder ins Wasser, aber faengt nichts."));
	fang++;
	return -1;
      }
    if(fisch_zahl<1)
      {
	write(BS("Du greifst immer wieder ins Wasser, doch der Fisch "
		 "flutscht immer wieder durch Deine Haende."));
	
	say(BS(TPN+" greift immer wieder ins Wasser, aber faengt nichts."));
	return -1;
      }
    if (present("regenbogenfisch",TP))
      {
	write(BS("Du hast ja schon einen Fisch, Du Gierhammel!"));
	
	say(BS(TPN+" hat wohl eine Angelleidenschaft gefunden."));
	return -1;
      }
    else
      {
	{
	  regenbogenfisch=clone_object(OBJ "regenbogenfisch");
	  if (ME_TOO_HEAVY == regenbogenfisch->move(TP,M_GET))
	    {
	      write(BS("Du faengst, den Fisch, doch sofort entgleitet er Dir "
		       "d zappelt am Boden."));
	      
	      say(BS(TPN+" faengt einen Fisch, der "+TP->QueryPronoun(WEM)+" "
		     "sofort engleitet. Er zappelt am Boden."));
	      
	      regenbogenfisch->move(TO, M_NOCHECK|M_SILENT);
	      return 1;
	    }
          else
	    {
	      write(BS("Du faengst einen Fisch, den Du schnell einsteckst, bevor "
		       "er Dir entwischt."));
	      say(BS(TPN+" faengt einen Fisch."));
	      fisch_zahl--;
	      return 1;
	    }
	}
      }
    return 0;
  }
  return 0;
}

int cmd_schwimmen(string str)     
{
  notify_fail("Worin willst Du schwimmen?\n");
  
  if(!(str=="in wasser"||
       str=="in becken"||
       str=="in wasserbecken"||
       str=="in springbrunnen"||
       str=="in brunnen")) 
    return 0;
  
  write(BS("Du steckst die Zehe in das Wasser und zuckst zurueck. Brrrrrr! "
	  "Das ist Dir doch zu kalt."));
  
  say(BS(TPN+" steckt die Zehe in das Wasser und zuckt zurueck."));
  
  return 1;
}

int cmd_trinken(string str)	
{
  notify_fail("Was willst Du trinken?\n");
  
  if(!(str=="wasser"||
       str=="aus becken"||
       str=="aus wasserbecken"||
       str=="aus nebelbecken"||
       str=="aus springbrunnen"||
       str=="aus brunnen"||
       str=="aus biotop")) 
    return 0;
  
  if(TP->drink_soft(2))
    {
      write(BS("Du tauchst Deine Haende in das kuehle Becken und schluerfst "
	       "etwas Wasser daraus."));
      
      say(BS(TPN+" trinkt etwas Wasser aus dem Becken und fuehlt sich sichtlich "
	     "erfrischt."));
      
      if(trinken<1)
	{
	  return -1;
	}
      
      TP->AddHp(10+random(5));
      trinken--;
      
  return 1;
    }
  else
    {
      return -1;
    }
}

int cmd_blume(string str)
{
  object wolkenblume;
  notify_fail("Was willst Du pfluecken?\n");
  
  if(!(str=="blume"||
       str=="etwas aus bett heraus")) 
    return 0;
  
   
    if(blumenzahl<1)
      {
	write(BS("Du findest keine pflueckbare Blume mehr und musst warten, "
		 "bis schoene Exemplare nachgewachsen sind."));
	
	say(TPN+" seufzt enttaeuscht.\n");
	
	return -1;
      }
    	
	wolkenblume=clone_object(OBJ "wolkenblume");
	if (ME_TOO_HEAVY==wolkenblume->move(TP,M_GET))
	  {
	    write(BS("Du pflueckst Dir eine wunderschoene Blume, laesst sie aber "
		     "gleich fallen. Du haettest lieber vorher Dein Gepaeck "
		     "umsortieren sollen."));
	    
	    say(BS(TPN+" pflueckt eine Blume und laesst diese gleich fallen."));
	    
	    wolkenblume->move(TO, M_NOCHECK|M_SILENT);
	    return 1;
	  }
	
	    write(BS("Du greifst blind in die Wiese und pflueckst Dir die erst "
		     "beste Blume."));
	    
	    say(BS(TPN+" haelt sich mit einer Hand die Augen zu und pflueckt mit "
		   "der anderen blind eine Blume."));
	    blumenzahl--;
	    return 1;
	    
}
