// von Hicks
// 20.1.2004
// 
// Raum meines Gesellenstueckes "Turm1 - Wolkenstadt"

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();
  
  
  SetProp(P_INT_SHORT, "Turm in der Wolkenstadt");
  SetProp(P_INT_LONG, "Du befindest Dich in der Wetterstation. Ein Tisch mit "
	  "viel Papier, Stiften und Notizen befindet sich im Raum. Davor "
	  "ist ein unscheinbarer Glashocker. In einer Ecke befindet sich "
	  "eine Kristallmaschine. Sie hat Knoepfe, eine Hebel und einen "
	  "Schlitz. Auf der Oberseite siehst Du drei Glasgefaesse. Die "
	  "Wendeltreppe zieht sich von oben bis unten vertikal durch.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  
  //-----Details Anfang-----
  
  AddDetail( ({"cute","marrogh","maghnar","niri","gaya","zidane","nyx","wumanzu",
	       "elrohir","velkyn","took","aroobah","methos","katarok"}),
	      "Ja, dieser Spieler hat mir geholfen, dass dieses Gebiet noch besser "
	      "und schoener wird.");

  AddDetail( ({"wetterstation","station","raum"}),
	     "Es ist nicht viel hier. Ein Tisch, ein Hocker und diese Maschine.");
  
  AddDetail( ({"glashocker","hocker"}),
	     "Er ist einfach, schlicht und unscheinbar.");
  
  AddDetail( ({"tisch"}),
	     "Er besteht aus Glas. Er ist chaotisch, vollgeraeumt mit "
	     "Zetteln, Stiften und Notizen. Auch eine Kaffeetasse, die "
	     "eingetrocknete Flecken hat, kannst Du in dem Chaos sehen.");
  
  AddDetail( ({"glas"}),
	     "Einfach durchsichtiges Glas.");
  
  AddDetail( ({"zetteln","papier"}),
	     "Du erkennst verschiedene Grafiken, Texte und Bilder. Mhh, sehr "
	     "interessant.");
  
  AddDetail( ({"grafiken","grafik"}),
	     "Dir sagen all diese Grafiken genau nichts. Du blaetterst sie "
	     "durch und laesst sie dann liegen.");
  
  AddDetail( ({"texte","text"}),
	     "Du ueberfliegst verschiedene Lehrtexte und wissenschaftliche "
	     "Arbeiten. Du faengst zu schwitzen an bei all diesem "
	     "Wissen.");
  
  AddDetail( ({"lehrtexte","lehrtext"}),
	     "Du verstehst wirklich gar nichts.");
  
  AddDetail( ({"arbeit","arbeiten"}),
	     "Du musterst die Arbeiten und hast keine Ahnung worum es geht.");
  
  AddDetail( ({"ahnung"}),
	     "Du hast nicht mal eine Ahnung von der Ahnung.");
  
  AddDetail( ({"wissen"}),
	     "Du schwitzt und schwitzt und bist noch immer nicht gebildeter.");
  
  AddDetail( ({"bilder"}),
	     "Du siehst verschiedene Bilder von Wolkenformen.");
  
  AddDetail( ({"wolkenformen","formen"}),
	     "Du betrachtest die Bilder und liest die Wolkenformen dazu: "
	     "Cumulus-Wolken, Gewitterwolken, Gewitterzelle, Cirrus-Wolken, "
	     "Cirrocumulus-Wolken, Altocumulus.");
  
  AddDetail( ({"cumulus-wolken","cumulus","gewitterwolken","gewitterzelle","cirrus",
		 "cirrus-wolken","cirrocumulus-wolken","cirrocumulus","altocumulus"}),
	     "Du denkst, dass Du jetzt schlauer bist. Ob Du Dir jemals all "
	     "diese Wolken merken kannst?");
  
  AddDetail( ({"wolken"}),
	     "Du weisst es gibt Cumulus-Wolken, Gewitterwolken, "
	     "Gewitterzelle, Cirrus-Wolken, Cirrocumulus-Wolken, Altocumulus.");
  
  AddDetail( ({"stifte","stiften"}),
	     "Es herrscht einfach pures Chaos. Aber Du findest darin auch "
	     "einen Zirkel und ein Lineal. Das wird hier wohl gebraucht.");
  
  AddDetail( ({"chaos"}),
	     "Du kannst es nicht beschreiben. Ordnung ist es garantiert nicht.");
  
  AddDetail( ({"ordnung"}),
	     "Die Kaffeeflecken verschoenern dieses Chaos nicht. Wenn es Dir "
	     "nicht zu sehr ekelt, dann koenntest Du ja darin wuehlen.");
  
  AddDetail( ({"zirkel"}),
	     "Der Zirkel duerfte anscheinend fuer Wetterkalkulationen sehr "
	     "wichtig sein.");
  
  AddDetail( ({"lineal"}),
	     "Das Lineal scheint zum abmessen gedacht zu sein. Vielleicht "
	     "fuer irgendwelche geografischen Wetterkalkulationen?");
  
  AddDetail( ({"wetterkalkulationen","kalkulationen"}),
	     "Das ist Dir viel zu schwer, als dass Du Dich jetzt damit "
	     "beschaeftigst.");
  
  AddDetail( ({"notizen"}),
	     "Du durchstoeberst die Notizen. Eigentlich ist das unhoeflich, "
	     "in fremden Sachen zu wuehlen. Nun gut! Du entdeckst dabei, dass "
	     "diese Notizen so etwas wie Landkarten sind.");
  
  AddDetail( ({"sachen"}),
	     "Schaemst Du Dich den gar nicht?");
  
  AddDetail( ({"landkarten","karten"}),
	     "Das sind wirklich alles Karten vom Silberland. Da koennte man "
	     "ja auch zufaellig ein Lineal und einen Zirkel brauchen. ;-)");
  
  AddDetail( ({"kaffeetasse","tasse"}),
	     "Du erkennst nur an der Form, dass es eine Tasse war. Sie ist "
	     "ueber und ueber mit schmutzigen Flecken uebersaeht. Auch der "
	     "Tisch und die Zetteln haben einiges abbekommen.");
  
  AddDetail( ({"form"}),
	     "Du betrachtest die Tasse noch genauer. Igitt! Das klebt. Und "
	     "stellst fest, dass das wirklich eine Kaffeetasse ist.");
  
  AddDetail( ({"kaffeeflecken","flecken"}),
	     "Einfach grauslich. Diese Flecken sind schoen braun auf der "
	     "Tasse, dem Papier und dem Tisch eingetrocknet.");
  
  AddDetail( ({"ecke"}),
	     "Die Ecke, die Du meinst, da steht die Maschine.");
  
  AddDetail( ({"kristallmaschine","maschine"}),
	     "Sie besteht aus Raedern, Stangen, Gummiringen, Noppen und einem "
	     "Trichter. Doch am meisten interessieren Dich die bunten "
	     "Knoepfe, der Schlitz und der Hebel.");
  
  AddDetail( ({"raeder","raedern","stangen","gummiringen","ringen",
		 "gummi","gummiringe","ringe","noppen"}),
	     "Das gehoert alles zur Maschine und ist fix in eine "
	     "Kristallschicht eingepackt.");
  
  AddDetail( ({"kristallschicht","schicht"}),
	     "Das heisst nur, dass Du an diese Dinge nicht rankommst.");
  
  AddDetail( ({"dinge"}),
	     "Du hoffst doch nur hier einen Forscherpunkt zu finden.");
  
  AddDetail( ({"forscherpunkt","punkt"}),
	     "Schon zeigt Dir der Forscherpunkt die Zunge. Du kriegst mich "
	     "nicht!, ruft er und huepft schon davon.");
  
  AddDetail( ({"zunge"}),
	     "Jetzt dreht er Dir auch noch eine lange Nase.");
  
  AddDetail( ({"nase"}),
	     "Sowas laesst Du Dir bieten? Schau doch nach wo er ist. Er hat "
	     "doch Pruegel verdient.");
  
  AddDetail( ({"pruegel"}),
	     "Du sollst hier nicht forschen, sondern den Forscherpunkt hauen "
	     "gehen.");
  
  AddDetail( ({"trichter"}),
	     "Du wunderst Dich wofuer man einen Trichter brauchen kann?");
  
  AddDetail( ({"knoepfe","knopf"}),
	     "Jeder Knopf hat eine andere Farbe.");
  
  AddDetail( ({"farbe"}),
	     "Grau, Weiss, Gelb, Orange, Rot, Violett, Blau, Schwarz, Gruen, "
	     "Braun.");
  
  AddDetail( ({"grau"}),
	     "Grau steht fuer das Gebirge.");
  
  AddDetail( ({"weiss"}),
	     "Das kann nur das Polargebiet sein.");
  
  AddDetail( ({"gelb"}),
	     "Gelb ist die trockene Wueste.");
  
  AddDetail( ({"orange"}),
	     "Der Dschungel kann ueber den orangen Knopf gesehen werden.");
  
  AddDetail( ({"rot"}),
	     "Markant rot ist die Ebene gekennzeichnet.");
  
  AddDetail( ({"violett"}),
	     "Das leichte Violett zeigt das momentane Wetter von der "
	     "Luftregion. Dieser Knopf leuchtet.");
  
  AddDetail( ({"blau"}),
	     "Im koeniglichen Blau ist die Region Wasser geruestet.");
  
  AddDetail( ({"schwarz"}),
	     "Du Unterwelt huellt sich in sattem Schwarz.");
  
  AddDetail( ({"gruen"}),
	     "Der Kristallwald praesentiert sich in einem eleganten Gruen.");
  
  AddDetail( ({"braun"}),
	     "Mit braun ist sicher das Huegelland gemeint.");
  
  AddDetail( ({"gebirge","polar","polargebiet","wueste","dschungel","ebene",
		 "luft","luftregion","wasser","unterwelt","kristallwald",
		 "huegelland"}),
	     "Das ist eine Region des Silberlandes.");
  
  AddDetail( ({"region","gebiet","land","gebiete","regionen"}),
	     "Das Silberland ist so gross, dass es schon in Gebiete "
	     "unterteilt werden musste.");
  
  AddDetail( ({"silberland","silberlandes"}),
	     "Das Silberland ist rieeesig.");
  
  AddDetail( ({"schlitz"}),
	     "Vielleicht kommt aus diesem Schlitz etwas heraus? Nur wie?");
  
  AddDetail( ({"hebel"}),
	     "Der Hebel ladet Dich zum anziehen ein.");
  
  AddDetail( ({"oberseite","seite"}),
	     "Auf der Oberseite der Kristallmaschine sind drei Glasgefaesse "
	     "eingelassen.");
  
  AddDetail( ({"glasgefaesse","gefaesse", "gefaess","glasgefaesse"}),
	     "Genau drei sind zu sehen. Sie stehen verkehrt rum, als ob sie "
	     "Etwas einschliessen wuerden.");
  
  AddDetail( ({"etwas"}),
	     "Dieses Etwas ist einmal eine Sonne, einmal ein Grashalm, der "
	     "sich leicht hin und her wiegt. In einem Glas erkennst Du einen "
	     "Frosch, der bequem auf einer Leiter sitzt.");
  
  AddDetail( ({"sonne"}),
	     "Sie scheint als waere sie im Glas am Himmel. Keine Wolken zu "
	     "sehen. Duerfte ein schoener Tag sein.");
  
  AddDetail( ({"tag"}),
	     "Heute ist doch ein schoener Tag, zumindest hier oben.");
  
  AddDetail( ({"grashalm","halm"}),
	     "Es wiegt sich leicht als wuerde da drinnen ein Wind gehen.");
  
  AddDetail( ({"wind"}),
	     "Den Wind kann man nicht sehen, aber Du bist Dir sicher, dass "
	     "dieses Gefaess eine Windmessung ist.");
  
  AddDetail( ({"windmessung","messung"}),
	     "An dem sich bewegenden Grashalm kann man sehen wie stark der "
	     "Wind blaest.");
  
  AddDetail( ({"frosch"}),
	     "Dem Frosch scheint es wohl sehr gut zu gehen. Es wirkt so, als "
	     "wuerde er sich sonnen. Wie witzig! *kicher* Sein Koerper "
	     "glitzert silbrig im Licht.");
  
  AddDetail( ({"licht"}),
	     "Es ist sehr hell hier.");
  
  AddDetail( ({"koerper"}),
	     "Du erkennst, wenn Du genau hinsiehst, lauter kleine Tautropfen.");
  
  AddDetail( ({"tautropfen","tropfen"}),
	     "Sie glitzern diamantenartig im Licht. Einfach entzueckend, "
	     "dieser Frosch.");
  
  AddDetail( ({"leiter"}),
	     "Die Leiter ist aus Glas. Sie ist schraeg an das Gefaess "
	     "angelehnt. Der Frosch sitzt genau mittig auf einer Sprosse.");
  
  AddDetail( ({"sprosse"}),
	     "Du schaetzt so angenehm warm wird dem Frosch sein.");
  
  AddDetail( ({"boden","decke"}),
	     "Der Boden als auch die Decke bestehen aus dem Pflanzengeflecht. "
	     "Beides hat ein Loch, durch das die Wendeltreppe fuehrt.");
  
  AddDetail( ({"pflanzengeflecht","geflecht","schlingpflanzengeflecht"}),
	     "Es ist genau gleich wie das Geflecht im unteren Raum. Sehr "
	     "filigran, aber doch kraeftig.");
  
  AddDetail( ({"raum"}),
	     "Du befindest Dich in so etwas, das sich Raum nennt.");
  
  AddDetail( ({"wand","waende"}),
	     "Waende gibt es nicht wirklich, sondern nur Boegen und ein Gelaender.");
  
  AddDetail( ({"boegen"}),
	     "Die Boegen sind aus dem Schlingpflanzengeflecht und ersetzen die Waende.");
  
  AddDetail( ({"gelaender"}),
	     "Das Gelaender schuetzt vor Stuerzen und besteht aus einem Pflanzengeflecht.");
  
  AddDetail( ({"stuerzen","stuerze","sturz"}),
	     "Das wuerdest Du nicht wollen, aber Du koenntest ja rauf klettern.");
  
  AddDetail( ({"loch"}),
	     "Da zieht sich die Wendeltreppe durch.");
  
  AddDetail( ({"wendeltreppe","treppe"}),
	     "Sie zieht sich von unten nach oben schraubenfoermig durch den "
	     "Raum. Auch sie ist aus dem Schlingpflanzengeflecht.");
  
  AddDetail( ({"fernrohr","rohr"}),
	     "Das ist ein durchsichtiges, sehr kleines Fernrohr. Vielleicht "
	     "solltest Du mal einen Blick durch werfen?");
  
  AddDetail( ({"himmel","wetter"}),
	     "Du betrachtest den Himmel und stellst fest, dass keine Wolken "
	     "da sind.");
  
  
  AddSound(DEFAULT_SOUND,"Es ist ziemlich still hier. Raschelndes Papier "
	   "unterbricht manchmal die Stille.");
  
  AddSound( ({"papier","rascheln"}),
	    "Du lauscht dem raschelnden Papier ein wenig.");
  
  AddSound( ({"stille"}),
	    "Soweit ist es ruhig. Noch...");
  
  
  AddSmell(DEFAULT_SMELL,"Es riecht schlichtweg nach Natur.");
  
  AddSmell( ({"natur"}),
	    "Du saugst die gruene Natur ein und fuehlst Dich gleich "
	    "entspannter.");
  
  //-----Details Ende-----
  
  AddItem( NPC "oaen", REFRESH_DESTRUCT);
  
  AddExit("unten",ROOM "wst2");
  AddExit("oben",ROOM "wst4");
  
    
  AddCmd( ({"kletter","klettere","kraxle","kraxel"}),"cmd_klettern");
  AddCmd( ({"wuehle","wuehl"}),"cmd_wuehlen");
  AddCmd( ({"werf","werfe","blick","blicke"}),"cmd_fernrohr");
  AddCmd( ({"druecke","drueck","betaetige"}),"cmd_druecken");
  AddCmd( ({"ziehe","zieh"}),"cmd_hebel");
  
}

int cmd_klettern(string str)	
{
  notify_fail("Wohin willst Du klettern?\n");
  
  if(!str) return 0;
  if(!(str=="rauf"||
       str=="hinauf"||
       str=="nach oben"||
       str=="oben"||
       str=="runter"||
       str=="nach unten"||
       str=="hinunter"||
       str=="unten")) 
    return 0;
  
  if(str=="runter"||
     str=="nach unten"||
     str=="hinunter"||
     str=="unten")
    
    {
      write(BS("Du kletterst auf den Schlingpflanzen nach unten."));
      
      say(BS(TPN+" schwingt sich auf die Schlingpflanzen."));
      
      TP->move(ROOM "wst2",M_GO, "nach unten");
      return 1;
    }
  
  if(str=="rauf"||
     str=="hinauf"||
     str=="nach oben"||
     str=="oben")
    
    {
      write("Du kletterst auf den Schlingpflanzen nach oben. Du hast die\n"
	    "Glaskuppel erreicht. Wagemutig versuchst Du diese zu erklimmen und\n"
	    "rutscht mit den Haenden ab und stuerzt in die Tiefe.\n\n");
      
      say(BS(TPN+" schwingt sich auf die Schlingpflanzen ... "
	     "Und stuerzt ab ..."));
      
      if(TP->is_class_member(CL_FLYING))
	{
	  write("In letzter Sekunde landest Du sanft auf dem Boden...\n");
	  TP->move(ROOM "ws10", M_GO);
	}
      else
	{
	  TP->move(ROOM "ws10",M_GO|M_SILENT|M_NO_SHOW);
	  SetProp(P_KILL_NAME, "Ein Sturz vom Turm");
	  TP->do_damage(50);
	}
    }
  return 1;
}

int cmd_wuehlen(string str)	
{
  
  notify_fail("Worin willst Du wuehlen?\n");
  
  if(!(str=="in chaos"||
       str=="in ordnung"||
       str=="in papier"||
       str=="in stifte"||
       str=="in notizen"||
       str=="in kaffeeflecken"||
       str=="in flecken"))  
    
    return 0;
  
  write(BS("Du wagst Dich in dieses schmutzige Chaos und wuehlst und "
	   "graebst. Dir wird schoen langsam uebel, aber Du haelst Dich "
	   "tapfer ... Und Du wirst belohnt und findest ein Fernrohr."));
  say(TPN+" wuehlt in dem Chaos des Tisches herum.");
  
  return 1;
}

int cmd_fernrohr(string str)	
{
  
  notify_fail("Wo willst Du einen Blick durch werfen?\n");
  
  if(!(str=="blick durch fernrohr"||
       str=="blick durch rohr"||
       str=="durch fernrohr"||
       str=="durch rohr")) 
    
    return 0;
  
  write(BS("Du kannst die Umgebung nicht sehen. Stattdessen siehst Du ein "
	   "buntes Ornament und bist entzueckt. Du drehst das Fernrohr und "
	   "eine neues Ornament ergibt sich. Du drehst weiter und weiter und "
	   "weiter ... Sag, willst Du nicht mal aufhoeren? Vielleicht wollen "
	   "noch andere an das Kaleidoskop? Du vergraebst das Fernrohr "
	   "wieder unter dem Chaos."));
  say(TPN+" blickt ganz fasziniert durch ein Fernrohr.\n");
  
  return 1;
}

int cmd_druecken(string str)	
{
  string farbe;

  notify_fail("Auf welchen Knopf willst Du druecken?\n");
  if(!str) return 0;
    
  if (sscanf(str, "auf %s knopf", farbe) != 1 &&
      sscanf(str, "%s knopf", farbe) != 1)
    return 0;
//  if(!str) return 0;
  
  switch(farbe)
    {
    case "roten": 
      write(BS("Der rote Knopf leuchtet auf. Der Frosch wandert ein wenig bei "
	       "der Leiter herunter. Die anderen Gefaesse bleiben alle "
	       "unveraendert. Nach ein paar Sekunden sind wieder die alten "
	       "Zustaende vorhanden und der violette Knopf leuchtet."));
      
      say(BS(TPN+" drueckt den roten Knopf."));
      break;
      
    case "grauen": 
      write(BS("Der graue Knopf leuchtet auf. Der Frosch bleibt in gleicher "
	       "Hoehe sitzen und auch all die anderen Gefaesse veraendern sich "
	       "kaum. Mhh, im Gebirge herrscht wohl gleiches Wetter wie in der "
	       "Region Wolken. Schon leuchtet wieder der violette Knopf auf."));
      
      say(BS(TPN+" drueckt den grauen Knopf."));
      break;
      
    case "orangen":
      write(BS("Der orange Knopf leuchtet auf. Der Frosch kriecht ziemlich weit "
	       "hinauf, auf der Leiter. Die Sonne brennt herunter und der "
	       "Grashalm ist am gedeihen. Nach kurzer Zeit wandert der Frosch "
	       "hinunter und der violette Knopf leuchtet wieder."));
      
      say(BS(TPN+" drueckt den orangen Knopf."));
      break;
      
    case "braunen":
      write(BS("Der braune Knopf leuchtet auf. Der Frosch huepft ein paar "
	       "Sprossen abwaerts. Die Sonne laechelt munter vor sich hin und "
	       "der Grashalm wiegt sich sanft im Wind. Schon krabbelt der "
	       "Frosch wieder hoch und das violette Licht leuchtet auf."));
      
      say(BS(TPN+" drueckt den braunen Knopf."));
      break;
      
    case "gruenen":
      write(BS("Der gruene Knopf leuchtet auf. In magischer Weise wandern "
	       "kristallene Blaetter vor die Sonne, aber trotzdem bleibt es "
	       "hell. Auch der Grashalm wird funkelnd und kristallartig, aber "
	       "wiegt sich denoch elastisch im Wind. Schon leuchtet das "
	       "violette Licht und alles ist wie vorher."));
      
      say(BS(TPN+" drueckt den gruenen Knopf."));
      break;
      
    case "schwarzen":
      write(BS("Der schwarze Knopf leuchtet duester auf. Der Frosch wandert "
	       "sanft auf und ab, erreicht aber nie das Maximum. Alles "
	       "verdunkelt sich und schwarzer Nebel zieht im zweiten Gefaess "
	       "auf. Der Grashalm verdorrt und wirkt kraenklich. Schon "
	       "durchbricht die Sonne wieder die dunklen Wogen und ein neuer "
	       "Grashalm waechst heran. Der violette Knopf leuchtet auf."));
      
      say(BS(TPN+" drueckt den schwarzen Knopf."));
      break;
      
    case "blauen":
      write(BS("Der blaue Knopf leuchtet auf. Der Frosch bleibt in gleicher "
	       "Hoehe sitzen und die Sonne brennt unaufhoerlich herunter. Eine "
	       "schoene Meeresbrise biegt den Grashalm sanft um. Schon leuchtet "
	       "wieder der violette Knopf auf und der Wind hat sich beruhigt."));
      
      say(BS(TPN+" drueckt den blauen Knopf."));
      break;
      
    case "weissen":
      write(BS("Der weisse Knopf schillert auf. Der Frosch huepft in einem Satz "
	       "bis auf den Boden und zittert am ganzen Leib. Obwohl die Sonne "
	       "freundlich strahlt, ueberziehen sich die Glasgefaesse mit einer "
	       "duennen Eisschicht. Schon schmilzt das Eis und der Frosch "
	       "huepft zur Mitte der Leiter. Der violette Knopf leuchtet auf."));
      
      say(BS(TPN+" drueckt den weissen Knopf."));
      break;
      
    case "gelben":
      write(BS("Der gelbe Knopf flimmert auf. Der Frosch kriecht mit haengender "
	       "Zunge ans obere Ende der Leiter. Er schwitzt und bekommt einen "
	       "Sonnenbrand. Die Sonne strahlt in dem Gefaess so eine Hitze "
	       "aus, dass Du die Waerme hindurch spueren kannst. Hin und wieder "
	       "entwickelt sich ein Wirbelsturm, im dritten Gefaess, und loest "
	       "sich wieder auf. Schon normalisiert sich alles, passend zum "
	       "aufleuchten des violetten Knopfes."));
      
      say(BS(TPN+" drueckt den gelben Knopf."));
      break;
      
    case "violetten":
      write(BS("Der violette Knopf leuchtet bereits. Du siehst weiterhin den "
	       "Frosch mitten auf der Leiter sitzen. In dem zweiten Gefaess "
	       "strahlt die Sonne unaufhoerlich und im dritten Gefaess siehst "
	       "Du den Grashalm wiegen."));
      
      say(BS(TPN+" drueckt den violetten Knopf."));
      break;
      
//    default:
//      notify_fail("Auf welchen Knopf willst Du druecken?\n"); 
//      return 0;
    }
  
  return 1;
}

int cmd_hebel(string str)	
{
  object wetterbericht;
  notify_fail("Woran willst Du ziehen?\n");
  
  if(!(str=="an hebel"||
       str=="hebel"||
       str=="hebel an"))  
    
    return 0;
  
  if(present("wetterbericht",TP))
    {
      write(BS("Du ziehst fest an dem Hebel und die Maschine faengt zu rattern "
	       "an. Aus dem Trichter entweicht Dampf. Ploetzlich schiebt sich ein "
	       "Zettel aus dem Schlitz. Ploetzlich schnappt sich die Maschine den "
	       "Zettel und kaut wild darauf herum. RUUEEEEELPS!!! Er hat ihr "
	       "geschmeckt."));
      
      say(BS(TPN+" zieht am Hebel und die Maschine beginnt zu rattern. Du hoerst "
	     "einen lauten Ruelpser!"));
      return -1;
    }
  
  wetterbericht=clone_object(OBJ "wetterbericht");
  write(BS("Du ziehst fest an dem Hebel und die Maschine faengt zu rattern "
	   "an. Aus dem Trichter entweicht Dampf. Ploetzlich schiebt sich ein "
	   "Zettel aus dem Schlitz."));
  
  say(BS(TPN+" zieht am Hebel und die Maschine beginnt zu rattern."));
  
  if(ME_TOO_HEAVY==wetterbericht->move(TP,M_GET))
    {
      write(BS("Als Du den Zettel nehmen willst, faellt er zu Boden."));
      
      say(BS(TPN+" faellt ein Zettel zu Boden."));
      
      wetterbericht->move(TO, M_NOCHECK|M_SILENT);
    }
  else
    {
      write(BS("Du steckst Dir den Zettel ein."));
    }
  return 1;
}
