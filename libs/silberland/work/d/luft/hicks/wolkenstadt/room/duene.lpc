// 20.1.2004
// 
// Raum meines Gesellenstueckes "Wolkenstadt"
inherit "std/room";

#include "../def.h"

void create()
     
{
  ::create();
 

  SetProp( P_INT_SHORT, "Auf einer Duene");
  SetProp( P_INT_LONG,
	   "Du stehst nun mitten auf der Duene. Der Ausblick ist, wie auf der "
	   "Klippe, gigantisch. Du faengst beim Bach an und blickst weiter ueber "
	   "das Fischerdorf, das Meer, die Insel und endest beim Strand vor Dir. "
	   "Als Du so in die Runde geblickt hast, faellt Dir ein Wasserzuber und "
	   "ein Futtertrog mit einer weisslichen Substanz auf. Auch der Boden "
	   "wirkt seltsam ...");

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_PLAIN]) );
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);
  
  //-----Details Anfang-----

 
  AddDetail( ({"duene"}), 
	     "Du stehst nun mitten auf der Duene. Der Ausblick, ist wie auf "
	     "der Klippe, gigantisch. Du faengst beim Bach an und blickst "
	     "weiter ueber das Fischerdorf, das Meer, die Insel und endest "
	     "beim Strand vor Dir. Als du so in die Runde geblickt hast, "
	     "faellt Dir ein Wasserzuber und ein Trog mit einer weisslichen "
	     "Substanz auf. Auch der Boden wirkt seltsam ...");

  AddDetail( ({"ausblick"}),
	     "Der Ausblick ist einfach gigantisch, dass es Dir den Atem raubt.");

  AddDetail( ({"atem"}),
	     "Dir stockt der Atem.");
  
  AddDetail( ({"klippe"}),
	     "Von der Klippe bist Du gerade gekommen. Sie wirkt felsig und "
	     "zerklueftet.");
  
  AddDetail( ({"bach"}),
	     "Durch den Bach bist Du gekommen. Das Wasser glitzert schoen "
	     "blau in der Ferne und wirkt wie ein Silberfaden.");
  
  AddDetail( ({"ferne"}),
	     "Du bekommst Fernweh, wenn Du so drueber nachdenkst.");
  
  AddDetail( ({"wasser"}),
	     "Das Wasser wirkt klar.");
  
  AddDetail( ({"silberfaden","faden"}),
	     "Wie ein Faden aus Silber - daher Silberfaden.");
  
  AddDetail( ({"silber"}),
	     "Es wirkt wie ein Glitzern.");
  
  AddDetail( ({"glitzern"}),
	     "Ja, das Wasser kann wirklich schoen glitzern in der Ferne.");
  
  AddDetail( ({"fernweh"}),
	     "Du seufzt und widmest Dich wieder der Duene.");
  
  AddDetail( ({"fischerdorf","dorf"}),
	     "Das kleine Dorf liegt idyllisch am Festland. Die Haeuser wirken "
	     "wie Spielzeug und die Menschen wie Ameisen. Ach, einfach "
	     "herrlich!");
  
  AddDetail( ({"festland","land"}),
	     "Eigentlich bist Du auch noch am Festland. Die Insel liegt im "
	     "Meer, umspuelt vom Wasser.");
  
  AddDetail( ({"haeuser"}),
	     "Sie sind so winzig und sehen richtig putzig aus.");
  
  AddDetail( ({"spielzeug","zeug"}),
	     "Da die Haeuser in der Ferne so winzig wirken, sehen sie aus wie "
	     "Spielzeug.");
  
  AddDetail( ({"menschen"}),
	     "In der Ferne wirken die Menschen wie kleine Ameisen. Aber "
	     "natuerlich sind sie in Wirklichkeit so gross wie Du und ich.");
  
  AddDetail( ({"wirklichkeit"}),
	     "Die Wirklichkeit ist jetzt. Zwick dich mal - Du traeumst nicht!");
  
  AddDetail( ({"ameisen"}),
	     "Ameisen sind eigentlich winzig klein und in der Ferne wuerdest "
	     "Du Ameisen nicht sehen.");
  
  AddDetail( ({"meer"}),
	     "Es wirkt so unendlich weit, wenn da nicht die Insel waere. Die "
	     "Wellen brechen sich am Strand.");

  AddDetail( ({"wellen"}),
	     "Du kannst sie hoeren, wenn du Dich anstrengst.");
  
  AddDetail( ({"insel"}),
	     "Die Insel liegt wie ein eine verfuehrerische Oase im Meer.");
  
  AddDetail( ({"oase"}),
	     "Deine Beine bewegen sich, ohne dass Du es willst und "
	     "fuehren Dich zur Oase. Mhh, scheint wohl, dass Du Erholung "
	     "dringend noetig hast.");
  
  AddDetail( ({"beine"}),
	     "Du blickst an Dir herunter und stellst erleichtert fest, dass "
	     "sie noch da sind.");
  
  AddDetail( ({"erholung"}),
	     "Du findest sie auf der Insel.");
  
  AddDetail( ({"strand"}),
	     "Der Strand wirkt wunderschoen in verschiedensten sandfarbenen "
	     "Toenen. Die Wellen ergiessen sich im Rhythmus immer wieder "
	     "ueber den Sand." );
  
  AddDetail( ({"sand"}),
	     "Der Sand strahlt in den verschiedensten sandfarbenen Toenen.");
  
  AddDetail( ({"toene","toenen"}),
	     "Alle erdenklichen Farben. Du denkst nicht, dass du sie hoeren "
	     "kannst.");
  
  AddDetail( ({"farben"}),
	     "Du solltest schon gelernt haben was Farben sind.");
  
  AddDetail( ({"rhythmus"}),
	     "Auuuuuuf...... und...... aaaaaab...... und auuuuuf...... "
	     "und...... aaaaaab......");
  
  AddDetail( ({"runde"}),
	     "Du blickst um Dich herum. Der Ausblick ist einfach toll!");
  
  AddDetail( ({"wasserzuber","zuber"}),
	     "Mhh, wem gehoert der wohl? Er besteht aus Holz und das Wasser "
	     "scheint frisch zu sein. Der Zuber und der Trog stehen ganz "
	     "verlassen am Boden, abgesehen von ein paar Grasbuescheln.");
  
  AddDetail( ({"futtertrog","trog"}),
	     "Er besteht aus Holz und enthaelt eine weissliche Substanz, die "
	     "ein wenig funkelt. Der Zuber und der Trog stehen ganz verlassen "
	     "am Boden, abgesehen von ein paar Grasbuescheln.");
  
  AddDetail( ({"holz"}),
	     "Du scheinst wohl nicht sehr klug zu sein, wenn Du das nicht "
	     "weisst. Vielleicht solltest Du Deine Intelligenz wieder "
	     "erhoehen.");
  
  AddDetail( ({"intelligenz"}),
	     "Du scheinst sie wirklich nicht zu haben, wenn Du das "
	     "untersuchst.");
  
  AddDetail( ({"substanz"}),
	     "Du greifst in den Trog und laesst sie durch die Finger rieseln. "
	     "Es fuehlt sich an wie Hafer, aber die Farbe ist "
	     "ungewoehnlich.");
  
  AddDetail( ({"finger"}),
	     "Es rieselt und rieselt und rieselt und weg ist es.");
  
  AddDetail( ({"hafer"}),
	     "Waehrend Du noch ueber die erstaunliche Farbe gruebelst, "
	     "nimmst Du den Boden in genaueren Augenschein.");
  
  AddDetail( ({"farbe"}),
	     "Es leuchtet und schimmert weisslich.");
  
  AddDetail( ({"augenschein"}),
	     "Das heisst, du sollst den Boden untersuchen.");
  
  AddDetail( ({"boden"}),
	     "Der Boden besteht eigentlich nur aus Sand und ein paar "
	     "Grasbuescheln. Doch bei naeherer Betrachtung entdeckst Du "
	     "Spuren.");
  
  AddDetail( ({"buescheln","grasbuescheln"}),
	     "Hier und da ist eines verstreut, in einem saftigen Gruen. "
	     "Ein Grasbueschel faellt Dir besonders auf.");
  
  AddDetail( ({"gras"}),
	     "Gras kann man die paar Buescheln nicht nennen.");
  
  AddDetail( ({"gruen"}),
	     "Einfach nur gruen.");
  
  AddDetail( ({"bueschel","grasbueschel"}),
	     "Du drehst das Bueschel um und erkennst einen suessen, roten "
	     "Marienkaefer drauf.");
  
  AddDetail( ({"marienkaefer","kaefer"}),
	     "Der Marienkaefer blinzelt Dich lieb an. Ploetzlich breitet er "
	     "seine Fluegel aus und fliegt davon.");
  
  AddDetail( ({"fluegel"}),
	     "Die Fluegel schweben auf dem Wind davon und weg ist er.");
  
  AddDetail( ({"betrachtung"}),
	     "Du erkennst, dass diese Spuren nicht so wie Deine bis zur "
	     "Klippe reichen. Nein, sie sind nur in einem bestimmten Bereich "
	     "und enden dann ploetzlich.");		  
  
  AddDetail( ({"bereich"}),
	     "Das ist nicht viel, genau zwei Pferdelaengen und direkt vor dem "
	     "Trog und Zuber.");
  
  AddDetail( ({"pferdelaenge","pferdelaengen","laenge","laengen"}),
	     "Zwei Laengen Pferd. Ganz einfach!");
  
  AddDetail( ({"pferd","pferde"}),
	     "Das koennte ein Pferd gewesen sein, obwohl es nicht weit "
	     "gelaufen sein konnte. Vielleicht ist es ja geflogen?");
  
  AddDetail( ({"spur","spuren"}),
	     "Sie sehen aus wie ein U.");
  
  AddDetail( ({"u"}),
	     "Wenn Du es anders betrachtest, dann koennte es eine "
	     "Hufeisenform haben.");
  
  AddDetail( ({"hufeisenform","hufform","eisenform","form"}),
	     "Wer koennte solche Spuren hinterlassen ...");
  
  AddDetail( ({"himmel"}),
	     "Er ist strahlend blau und wolkenlos.");
  
  AddDetail( ({"brise","wind","windes"}),
	     "Eine leichte Brise weht ueber die Duene. Sehr erfrischend.");
  
  AddDetail( ({"geruch","gerueche","geruechen"}),
	     "Komm, streng Dich an. Was macht man mit Geruechen?");
  
  AddDetail( ({"tipp"}),
	     "Ja, das schreibt man jetzt mit doppel-p.");
  
  AddDetail( ({"reise"}),
	     "Schwing Dich auf seinen Ruecken und erlebe die fantastischste "
	     "Reise Deines Lebens.");
  
  AddDetail( ({"ruecken"}),
	     "Am Ruecken des Windes, nicht Deiner.");
  
  AddDetail( ({"leben","lebens"}),
	     "Einmal solltest Du das in Deinem Leben gemacht haben. Es ist "
	     "sonst eh immer so oede.");

  AddDetail( ({"sonne"}),
	     "Die Sonne lacht Dir entgegen. Irgendwie sieht sie wie Birdy aus.");

  AddDetail( ({"birdy"}),
	     "Birdy hat sich dieses Detail gewuenscht. Tipp mal `finger Birdy`.");

  AddDetail( ({"detail"}),
	     "Nur dieses wurde Birdy gewidmet. Und das ist keine Skriptfalle.");

  AddDetail( ({"skriptfalle","falle"}),
	     "Solltest du wirklich skripten, dann melde Dich umgehend bei einem "
	     "Erzmagier.");

  AddDetail( ({"erzmagier","magier"}),
	     "Sie haben ein E hinter ihrem Namen.");
	     
  AddDetail( ({"e"}),
         "Du kaufst ein E und sagst: 'Ich moechte aufloesen! - "
         "'Erzmagier!'");
                   
  AddDetail( ({"name","namen"}),
         "Solltest Du einen brauchen, dann kannst Du getrost Birdy fragen.");    

  AddDetail( ({"namen"}),
	     "So, jetzt ist aber genug!!!");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	     "Du tippst auf Dich selbst und sagst laut: Jaaaaaa, das bin ich!");
  
  
  AddSmell(DEFAULT_SMELL, "Du riechst das salzige Meer, den koernigen "
	   "Sand und eine frische Brise bringt Erdgeruch mit sich.");
  
  AddSmell( ({"meer"}),
	    "Es riecht salzig.");
  
  AddSmell( ({"sand"}),
	    "Der Sand hat einen ganz eigenen Geruch.");
  
  AddSmell( ({"geruch","gerueche","geruechen"}),
	    "Der Geruch aus Meer, Sand und Erde riecht eigenartig.");
  
  AddSmell( ({"erdgeruch","erde"}),
	    "Einfach nach Erde.");
  
  AddSmell( ({"brise"}),
	    "Du kannst sie nicht riechen, aber sicher untersuchen. Mal so ein "
	    "Tipp.");
  
  AddSmell( ({"reise","tipp"}),
	    "Vieles geht, aber das kannst Du nicht riechen.");
  
  AddSmell( ({"substanz"}),
	    "Riecht nach Hafer.");
  
  
  AddSound(DEFAULT_SOUND, "Die Wellen rauschen im Meer und eine leichte Brise "
	   "fluestert ueber die Duene.");
  
  AddSound( ({"wellen","rauschen","meer"}),
	    "SCHHHHHHHH ... SCHHHHHHH ... SCHHHHHHH ...");
  
  AddSound( ({"brise","fluestern","fluestert","wind"}),
	    "Sie fluestert Dir zu, ihr zu folgen. Erlebe eine Reise mit dem "
	    "Wind!");
  
  AddSound( ({"reise","tipp"}),
	    "Vieles geht, aber daran kannst Du nicht lauschen.");
  
  AddSound( ({"toene","toenen"}),
	    "Du hoerst nicht zu, wenn man Dir schon sagt, dass das nicht "
	    "geht? *tadel*");
  
  //-----Details Ende-----
  
  AddExit( "sueden", "/d/wasser/hiri/inselversteck/room/stueck4.lpc" );
  AddItem( OBJ "pegasus", REFRESH_DESTRUCT, 1);
  
  AddCmd( ({"grab","grabe"}),"cmd_graben" );
  AddCmd( ({"trink","trinke"}),"cmd_trinken" );
  AddCmd( ({"schwing","schwinge"}),"cmd_schwingen" );
  
}

int cmd_graben(string str)   
{
  
  notify_fail("Worin willst Du graben?\n");
  
  if(!(str=="in sand"||
       str=="sand"||
       str=="in duene"||
       str=="duene"||
       str=="spuren"||
       str=="in spuren")) 
    
    return 0;
  
  write(BS("Du beginnst zu graben und denkst Dir, dass es sich doch nicht "
	   "auszahlt und laesst es bleiben."));
  say(TPN+" faengt an zu graben und hoert ploetzlich wieder auf.\n");
  
  return 1;
}

int cmd_trinken(string str)     
{
  
  notify_fail("Was willst Du trinken?\n");
  
  if(!(str=="wasser"||
       str=="aus zuber"||
       str=="aus wasserzuber")) 
    
    return 0;
  
   {
      write(BS("Du kostest etwas von dem Wasser und es schmeckt ziemlich "
	       "abgestanden. Igitt!"));
      say(TPN+" kostet etwas Wasser und verzieht dabei das Gesicht.\n");
    }
  return 1;
}

int cmd_schwingen(string str)     
{
  
  notify_fail("Worauf willst Du Dich schwingen?\n");
  
  if(!(str=="auf ruecken"||
       str=="auf ruecken des windes"||
       str=="auf ruecken von wind"||
       str=="auf wind")) 
    
    return 0;
  
  write(BS("Du wartest einen Windstoss ab und versuchst aufzuspringen. Leider "
	   "vergebens!"));
  say(TPN+" macht einen Bocksprung in die Luft.\n");
  
  return 1;
}
