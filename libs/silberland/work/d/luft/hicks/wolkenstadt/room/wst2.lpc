// von Hicks
// 20.1.2004
// 
// Raum meines Gesellenstueckes "Turm1 - Wolkenstadt"

inherit "std/room";

#include "../def.h"


void create()  
{
  ::create();
  
  
  SetProp(P_INT_SHORT, "Turm in der Wolkenstadt");
  SetProp(P_INT_LONG, "Dieses Wachabteil ist sehr schmucklos. Nicht einmal "
	  "ein Hocker zum Ausrasten ist da. Die Schlingpflanzen bilden die "
	  "Saeulen, Boegen, Gelaender, Boden und Decke. Eine Glocke ist an "
	  "der nordoestlichen Saeule montiert. Schraeg gegenueber fuehrt "
	  "eine Wendeltreppe nach oben.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  
  
  //-----Details Anfang-----
  
  AddDetail( ({"wachabteil","abteil"}),
	     "Es ist schmucklos und nicht mal einen Hocker siehst Du hier.");
  
  AddDetail( ({"hocker"}),
	     "Es ist einfach keiner da. So sehr Du Dich auch anstrengst, es "
	     "erscheint keiner aus Zauberhand.");
  
  AddDetail( ({"zauberhand","hand"}),
	     "Vielleicht hast Du doch welche? Ruf mal Simsalabim!!! Koennte "
	     "ja funktionieren.");
  
  AddDetail( ({"simsalabim"}),
	     "Du denkst: Ist doch bescheuert. Wozu soll ich das rufen? Ich "
	     "kann keinen Hocker herzaubern.");
  
  AddDetail( ({"ausrasten"}),
	     "Mhhh, Hocker ist ja keiner da, aber der Boden tut es sicher "
	     "auch.");

  AddDetail( ({"schlingpflanzen","pflanzen"}),
	     "Sie sind gruenlich verschlungen zu einem Geflecht.");
  
  AddDetail( ({"geflecht"}),
	     "Das Geflecht bildet die Turmsaeulen, die Boegen, das Gelaender, "
	     "den Boden und die Decke. Hie und da lugt ein Blatt hervor.");
  
  AddDetail( ({"blatt","blaetter"}),
	     "Die Blaetter wiegen sich hin und her.");
  
  AddDetail( ({"saeulen","turmsaeulen"}),
	     "Sie schlingen sich von unten nach oben durch. In der "
	     "suedoestlichen Saeule macht dich ein Funkeln neugierig.");
  
  AddDetail( ({"saeule"}),
	     "Welche Saeule meinst Du denn?");
  
  AddDetail( ({"suedoestliche saeule"}),
	     "Hin und wieder blitzt ein kurzes Funkeln auf.");
  
  AddDetail( ({"funkeln"}),
	     "Du gehst naeher ran und koenntest durch das Geflecht ins Innere "
	     "spaehen.");
  
  AddDetail( ({"innere"}),
	     "So erkennst Du nichts.");
  
  AddDetail( ({"fledermaeuse","maeuse"}),
	     "Sie sehen aus wie aus Glas, das mit lauter kleine Brillanten "
	     "besetzt ist. Du erkennst auch schemenhaft den hinteren Teil der "
	     "Saeule.");
  
  AddDetail( ({"glas"}),
	     "Die Fledermaeuse sehen aus wie aus Glas, aber bestehen bestimmt "
	     "nicht daraus.");
  
  AddDetail( ({"brillanten"}),
	     "Kleine durchsichtig, funkelnde Edelsteine.");

  AddDetail( ({"edelsteine"}),
	     "Sie sind ganz winzig klein.");
  
  AddDetail( ({"teil"}),
	     "Du erkennst ihn nur schemenhaft.");
  
  AddDetail( ({"saeulenhohlraum","hohlraum","luecke"}),
	     "Da blickst Du hinein oder hast, besser gesagt.");
  
  AddDetail( ({"wind"}),
	     "Der Wind blaest leicht durch das Abteil und bewegt die "
	     "Blaetter.");
  
  AddDetail( ({"boegen"}),
	     "Sie ziehen sich ueber das Gelaender.");
  
  AddDetail( ({"wand","waende"}),
	     "Es gibt keine Waende, nur die Boegen und das Gelaender.");
  
  AddDetail( ({"gelaender"}),
	     "Das Gelaender schuetzt Dich, damit Du nicht herunter faellst. "
	     "Aber der Ausblick ist toll.");
  
  AddDetail( ({"ausblick"}),
	     "Alles glitzert, funkelt und schimmert. All die Glas- und "
	     "Wolkenhaeuser herum wirken so leicht und verspielt. Der Palast "
	     "im Norden glaenzt praechtig im Sonnenlicht. Dahinter ist eine "
	     "ganze Wolkenlandschaft in verschiedenen Pastellfarben zu "
	     "erkennen.");
  
  AddDetail( ({"haeuser","wolkenhaeuser","glashaeuser"}),
	     "Sie sind unterschiedlich gross und jedes ist verschieden.");
  
  AddDetail( ({"palast"}),
	     "Er thront im noerdlichen Stadtteil.");
  
  AddDetail( ({"stadtteil"}),
	     "Wie waere es, wenn Du Dich dort mal umblickst?");
  
  AddDetail( ({"sonnenlicht","licht"}),
	     "Das Licht laesst alles glitzern und schimmern. Du bist ganz "
	     "fasziniert.");
  
  AddDetail( ({"wolkenlandschaft","landschaft"}),
	     "Du erkennst nur die wattigen Pastelltoene. Es ist einfach zu "
	     "weit weg.");
  
  AddDetail( ({"pastellfarben","farben","pastelltoene","toene"}),
	    "Die Wolkenlandschaft schimmert sanft in der Ferne.");
  
  AddDetail( ({"ferne"}),
	     "Du bekommst Lust diese unbekannte Gebiet zu entdecken.");
  
  AddDetail( ({"lust"}),
	     "Es zieht Dich schon zur Treppe, damit Du unentdecktes Gebiet "
	     "erforschen kannst.");
  
  AddDetail( ({"gebiet"}),
	     "Du faengst an von Deinen Abenteuer zu traeumen.");
  
  AddDetail( ({"abenteuer"}),
	     "Du hast sicher schon einiges erlebt.");
  
  AddDetail( ({"himmel"}),
	     "Er strahlt blau vor sich hin. Ein tolles Wetter einfach.");
  
  AddDetail( ({"wetter"}),
	     "Das beste Wetter um alles durchzuforschen.");
  
  AddDetail( ({"boden","decke"}),
	     "Boden und Decke bestehen aus dem gruenen Geflecht, das dicht "
	     "und fest verflochten ist. In beiden befindet sich ein Loch.");
  
  AddDetail( ({"loch"}),
	     "Durch diese gelangt man nach oben oder nach unten.");
  
  AddDetail( ({"nordoestliche Saeule"}),
	     "Die durchsichtige Glasglocke ist ca 20cm gross. Daneben haengt "
	     "ein Glasklopfer.");
  
  AddDetail( ({"glasklopfer","klopfer"}),
	     "Er hat sicher einen Zweck.");
  
  AddDetail( ({"zweck"}),
	     "Mhh, wofuer koennte man ihn denn verwenden?");
	    
  AddDetail( ({"glasglocke","glocke"}),
	     "Sie besteht aus Glas und ist filigran geschwungen. Sie ergibt "
	     "bestimmt einen hellen Ton.");
  
  AddDetail( ({"ton"}),
	     "Du wirst einen Ton vielleicht erhalten, wenn Du mit dem Klopfer "
	     "draufschlaegst.");
  
  AddDetail( ({"wendeltreppe","treppe"}),
	     "Die Wendeltreppe schlaengelt sich bei der suedwestlichen "
	     "Saeule nach oben. Sie besteht auch aus diesen "
	     "gruenlichen Schlingpflanzen. Sie ist an vielen filigranen "
	     "Straengen aufgehaengt.");
  
  AddDetail( ({"straengen","straenge"}),
	     "Die Wendeltreppe ist an den einzelnen gruenen Straengen "
	     "aufgehaengt. An den verlaengerten, runterhaengenden Enden "
	    "haengen Kristalle, die im Wind baumeln.");
  
  AddDetail( ({"enden","ende"}),
	     "Sehr duenn und zart sind die Enden, die noch ein wenig "
	     "aussprossen. Die Kristalle duerften wie zarte Blumen daraus "
	     "entstehen.");
  
  AddDetail( ({"kristalle"}),
	     "Sie schimmern leicht und ergeben ein wahres Kristallspiel durch "
	     "den Wind.");
  
  AddDetail( ({"blumen"}),
	     "So richtig wie Blumen sehen die Kristalle nicht aus. Es wirkt "
	     "einfach nur so, als wuerden sie aus den Schlingpflanzen "
	     "herausspriessen. Man koennte meinen sie sind lebendig wie eine "
	     "Pflanze.");
  
  AddDetail( ({"pflanze"}),
	     "Du koenntest es ja versuchen und an ihnen riechen. Kristalle "
	     "riechen eigentlich nicht.");
  
  AddDetail( ({"kristallspiel","spiel"}),
	     "Hin und wieder stossen die Kristalle zusammen und Du vernimmst "
	     "huebsche Klaenge.");
  
  AddDetail( ({"klaenge"}),
	     "Sie werden vom Wind unwillkuerlich komponiert.");
  
  AddDetail( ({"suedwestliche Saeule"}),
	     "Hier befindet sich die Wendeltreppe.");
  
  AddDetail( ({"duft"}),
	     "Versuche doch daran zu riechen.");
  	   
  
  AddSound(DEFAULT_SOUND,"Nichts zu hoeren. Einzig und alleine der Wind "
	   "rauscht durch das Abteil.");

  AddSound( ({"wind"}),
	    "Leise rauscht der Wind vor sich hin und bewegt die Blaetter "
	    "unregelmaessig.");
  
  AddSound( ({"blaetter"}),
	    "Die Blaetter rauschen leicht auf, aber nebenbei hoerst Du immer "
	    "wieder ein leichtes klingeln von einem Kristallspiel.");
  
  AddSound( ({"kristallspiel","spiel","kristalle"}),
	    "Hin und bewegt der Wind die Kristalle und laesst sie so "
	    "zusammenschlagen.");
  
  AddSound( ({"klaenge"}),
	    "Sehr melodisch und klangvoll!, denkst Du Dir.");
  
  
  AddSmell(DEFAULT_SMELL,"Es riecht frisch. Hin und wieder schmuggelt sich "
	   "ein suess-lieblicher Duft ein.");
  
  AddSmell( ({"duft"}),
	    "Sehr blumig und verfuehrerisch!");
  
  AddSmell( ({"pflanze","blume","blumen"}),
	    "Du schnupperst daran und dieser Duft haut Dich fast um. So "
	    "suess, so verfuehrerisch, so blumig. Einfach herrlich! Das sind "
	    "wirklich echte Blumen.");
  
  
  //-----Details Ende-----
  
  AddItem(NPC "kalanchoe", REFRESH_DESTRUCT);
  
  AddExit("unten",ROOM "wst1");
  AddExit("oben",ROOM "wst3");
  
  
  AddCmd( ({"spaehe","spaeh"}),"cmd_spaehen" );
  AddCmd( ({"klopfe","klopf","schlage","schlag"}),"cmd_klopfen" );
  AddCmd( ({"kletter","klettere","kraxle","kraxel"}),"cmd_klettern");
  
}

int cmd_spaehen(string str)	
{
  notify_fail("Wodurch willst Du hineinspaehen?\n");
  
  if(!(str=="ins innere"||
       str=="in innere"||
       str=="nach innen"||
       str=="ins innere hinein"||
       str=="in innere hinein"||
       str=="hinein"||
       str=="durch geflecht"||
       str=="durch geflecht ins innere hinein"||
       str=="durch geflecht ins innere")) 
    return 0;
  
  write(BS("Du lugst durch eine Luecke im Geflecht und entdeckst in dem "
	   "Saeulenhohlraum durchsichtige, glitzerende Fledermaeuse. "
	   "Normalerweise wuerdest Du Dich fuerchten, diese aber baumeln "
	   "filigran, wie aus Glas, verkehrt haengend im Wind. Einfach "
	   "entzueckend. Du willst sie bei ihrer Ruhe nicht stoeren und wendest "
	   "Dich wieder dem Wachabteil zu."));
  
  say(BS(TPN+" blickt durch das Geflecht ins Innere."));
  
  return 1;
}

int cmd_klopfen(string str)	
{
  object *players;
  int i, n;
  
  notify_fail("Womit willst Du worauf schlagen?\n");
  
  if(!(str=="mit klopfer auf glocke"||
       str=="mit glasklopfer auf glocke"||
       str=="mit klopfer auf glasglocke"||
       str=="mit glasklopfer auf glasglocke"||
       str=="auf glocke"||
       str=="auf glasglocke")) 
    return 0;
  
  
  if(!TP->QueryProp(P_DEAF))
    {
      tell_object(TP,BS("Du schlaegst vorsichtig auf die Glasglocke und ein immer "
			"lauter werdender, glaeserner Ton erschallt. Du haeltst Dir die Ohren "
			"zu, bis der Klang wieder verblasst. Scheint sowas wie eine Alarmglocke "
			"zu sein."));
      TP->SetProp(P_DEAF, ([
			    DEAF_TIME: 30,
			    DEAF_MSG: "%s ist gerade taub.\n",
			    DEAF_END_MSG: "Du kannst wieder hoeren!\n"
			    ]));
      
    }
  else
    {
      tell_object(TP, BS("Du schlaegst vorsichtig auf die Glasglocke. Du siehst, "
			 "wie sie vibriert, aber sonst merkst Du nicht viel."));
    }
  
  players = filter_array(all_inventory(ENV(TP)),#'interactive);
  n = sizeof(players);
  for ( i=0; i<n; i++)
    if(players[i] != TP)  
      {
	if(players[i]->QueryProp(P_DEAF))
	  {
	    tell_object(players[i], BS(TP->Name()+" schlaegt vorsichtig auf die "
				       "Glasglocke. Du siehst, wie sie vibriert, aber "
				       "sonst merkst Du nicht viel."));
	  }
	else
	  {
	    tell_object(players[i], BS(TP->Name()+" schlaegt vorsichtig auf die "
				       "Glasglocke. Ein immer lauter werdender, "
				       "glaeserner Ton erschallt, dass Du Dir die Ohren "
				       "zuhalten musst."));
	    players[i]->SetProp(P_DEAF, ([
					  DEAF_TIME: 30,
					  DEAF_MSG: "%s ist gerade taub.\n",
					  DEAF_END_MSG: "Du kannst wieder hoeren!\n"
					  ]));
	  }
      }
  
  return 1;
}

int cmd_klettern(string str)
{
  notify_fail("Wohin willst Du klettern?\n");
  
  if(!str) return 0;
  if(!(str=="rauf"||
       str=="hinauf"||
       str=="nach oben"||
       str=="oben"||
       str=="runter"||
       str=="nach unten"||
       str=="hinunter"||
       str=="unten")) 
    return 0;
  
  if(str=="runter"||
     str=="nach unten"||
     str=="hinunter"||
     str=="unten")
    
    {
      write(BS("Du kletterst auf den Schlingpflanzen nach unten."));
      
      say(BS(TPN+" schwingt sich auf die Schlingpflanzen."));
      
      TP->move(ROOM "wst1",M_GO, "nach unten");
      return 1;
    }
  
  if(str=="rauf"||
     str=="hinauf"||
     str=="nach oben"||
     str=="oben")
    
    {
      write(BS("Du kletterst auf den Schlingpflanzen nach oben."));
      
      say(BS(TPN+" schwingt sich auf die Schlingpflanzen."));
      
      TP->move(ROOM "wst3",M_GO, "nach oben");
    }
   return 0;
}
