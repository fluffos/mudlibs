  AddDetail( ({"amaryllis"}),
	     "Mhh, dies muss wohl die leuchtende Amaryllis sein.");
  
  AddDetail( ({"statue"}),
	     "Bei naeherer Betrachtung bemerkst Du, dass diese Statue eine "
