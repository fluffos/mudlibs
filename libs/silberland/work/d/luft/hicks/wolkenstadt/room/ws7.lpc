  AddDetail( ({"jemand"}),
	     "Du kannst nicht erkennen wer es ist.");
  
  AddDetail( ({"parks","park"}),
	     "Buesche, Blumen und das Biotop erkennst Du. Du siehst auch, "
	     "dass Du ueber den Park zum Turm gelangst und andererseits "
	     "kannst Du Dich dort sicher gut erholen.");
  
  AddDetail( ({"buesche","bueschen","blumen"}),
	     "Die Buesche zaeunen den Park ein und die Blumen gedeihen in "
	     "allen Farben.");
  
  AddDetail( ({"biotop"}),
	     "Ein kleines Biotop, das wunderschoene Wasserrosen beherbergt "
	     "und von Wassergras eingesaeumt ist.");
  
  AddDetail( ({"wasserrosen","rosen"}),
	     "Sie erstrahlen in einer zartrosa Bluete und scheinen auf dem "
	     "Wasser zu schweben.");
  
  AddDetail( ({"bluete"}),
	     "Fast zum pfluecken, aber sie halten sich gepflueckt nicht.");
  
  AddDetail( ({"wasser"}),
	     "Das Wasser ist ganz glatt und spiegelt die Sonne wieder. Hin "
	     "und wieder wird das Wasser von Wasserlaeufern wellig.");
  
  AddDetail( ({"wasserlaeufer","laeufer","wasserlaeufern","laeufern"}),
	     "Sie huschen manchmal uebers Wasser als wuerden sie versuchen "
	     "sich zu Fangen.");
  
  AddDetail( ({"fangen"}),
	     "Ein Wasserlaeufer jagt hinter dem anderen her.");
  
  AddDetail( ({"wassergras","gras"}),
	     "Es biegt sich sanft im Wind und man hoert die Bewegung gar nicht.");
  
  AddDetail( ({"bewegung"}),
	     "Sehen kann man sie, aber hoeren nicht.");
  
  AddDetail( ({"boden"}),
	     "Der Boden ist von wattigen Wolkensteinen gesaeumt. Du sinkst "
	     "beim gehen immer ein wenig ein. Das animiert Dich doch glatt "
	     "zum springen.");
  
  AddDetail( ({"wolkensteine","wolkensteinen","steine","steinen"}),
	     "Sie bestehen aus Wolken, wie fast alles hier.");
  
  AddDetail( ({"himmel"}),
	     "Der Himmel wird von einem Regenbogen geziert und ist wolkenlos "
	     "und blau. Die Sonne laechelt Dir munter zu.");
  
  AddDetail( ({"luft"}),
	     "Die Luft ist ganz klar und eigentlich kuehl, wenn da nicht die "
	     "Sonne waere.");
  
  AddDetail( ({"wind"}),
	     "Er umarmt Dich kurz und ist schon wieder dahin.");
  
  AddDetail( ({"feder"}),
	     "Gaaanz sanft, so streichelt Dich der Wind.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	     "Schoen, dass es Dich gibt! :-)");
  
  
  AddSmell(DEFAULT_SMELL, "Du riechst Blumen und auch klare Luft.");  
  
  AddSmell( ({"blumen","blume"}),
	    "Sie duften frisch und suess.");
  
  AddSmell( ({"luft"}),
	    "Du schnupperst an der klaren Luft ein und fuehlst Dich frei.");
  
  
  AddSound(DEFAULT_SOUND, "Der Wind fegt leise ueber den Platz.");
  
  AddSound( ({"wind"}),
	    "Er umschmeichelt Dich wie eine Feder.");
  
  AddSound( ({"feder"}),
	    "Die kannst Du nicht hoeren.");
  
  AddSound( ({"platz"}),
	    "Du hoerst nur den Wind, der ueber den Platz fegt.");
  
  AddSound( ({"bewegung"}),
	    "Das geht doch nicht.");
  
  
  AddReadDetail("plakette",
		"Amaryllis");
  
  //-----Details Ende-----
  
  AddExit("nordosten",ROOM "ws8");
  AddExit("suedosten",ROOM "ws6");
  //  AddExit("osten",ROOM "wsx");
  
  
  AddCmd( ({"kletter","klettere"}),"cmd_klettern");
  AddCmd( ({"wink","winke"}),"cmd_winken");
  
}

int cmd_klettern(string str)	
{
  
  notify_fail("Wo willst Du hoch klettern?\n");
  
  if(!(str=="hoch"||
       str=="auf statue"||
       str=="hinauf"||
       str=="rauf"||
       str=="auf haupt")) 
    return 0;
  
  write(BS("Du huepfst auf den Sockel, kletterst an der Fee hoch und setzt "
	   "Dich stolz auf das Haupt. Du blickst ueberall herum und betrachtest "
	   "die Umgebung."));
  
  say(BS(TPN+" klettert die Statue hoch und setzt sich auf dessen Haupt. Du "
	 "denkst Dir welche Manieren diese Person bloss hat."));
  
  if ( find_call_out("fall1") == -1 )
    call_out("fall1",6);
  return 1;
  
}

void fall1()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write(BS("Leider hast Du hier den gleichen Ausblick wie am Boden. Du springst laessig "
	   "wieder hinunter." ));
  
  say(BS(TPN+" springt wieder herunter."));
  
}

int cmd_winken(string str)
{
  
  notify_fail("Wem willst Du zurueck winken?\n");
  
  if(!(str=="hoch"||
       str=="zurueck"||
       str=="jemand"||
       str=="jemand zurueck"||
       str=="jemandem zurueck"||
       str=="jemandem")) 
    return 0;
  
  write(BS("Du winkst zum Turm hoch und kommst Dir eigentlich dumm vor. Du "
	   "kennst diese Person gar nicht."));
  
  say(BS(TPN+" winkt in Richtung der Glaskuppel, die auf dem Turm thront."));
  
  return 1;
}
