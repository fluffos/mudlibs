  AddDetail( ({"maedchen"}),
	     "Jung und huebsch - alles das ein junges Maedchen auszeichnet.");
  
  AddDetail( ({"jugend"}),
	     "Sie ist die Jugend in Person. Sie wirkt ganz kindlich und "
