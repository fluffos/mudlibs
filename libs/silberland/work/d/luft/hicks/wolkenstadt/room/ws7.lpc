// Raum meines Gesellenstueckes "Westplatz - Wolkenstadt"

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();
  
  
  SetProp(P_INT_SHORT, "Westplatz in der Wolkenstadt");
  SetProp(P_INT_LONG,
	  "Du befindest Dich auf dem Westplatz von Liliandor. Eine Statue "
	  "faellt Dir sofort auf, da sie aus unebenem, kristallinen Glas "
	  "besteht und irgendwie lebendig wirkt. Dahinter erkennst du den "
	  "wunderschoen angelegten Park in dessen Mitte ein filigraner Turm "
	  "steht. Direkt hinter der Statue erkennst du ein Biotop mit "
	  "zartrosa Wasserrosen. Der Strasse folgend kommst du entweder zum "
	  "Palast oder zum Suedplatz.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);
  
  //-----Details Anfang-----
  
  AddDetail( ({"cute","marrogh","maghnar","niri","gaya","zidane","nyx","wumanzu",
	       "elrohir","velkyn","took","aroobah","methos","katarok"}),
	      "Ja, dieser Spieler hat mir geholfen, dass dieses Gebiet noch besser "
	      "und schoener wird.");
  
  AddDetail( ({"westplatz","platz"}), 
	     "Du befindest Dich auf dem Westplatz von Liliandor. Eine Statue "
	     "faellt Dir sofort auf, da sie aus unebenem, kristallinen Glas "
	     "besteht und irgendwie lebendig wirkt. Dahinter erkennst du den "
	     "wunderschoen angelegten Park in dessen Mitte ein filigraner "
	     "Turm steht. Direkt hinter der Statue erkennst du ein Biotop mit "
	     "zartrosa Wasserrosen. Der Strasse folgend kommst du entweder "
	     "zum Palast oder zum Suedplatz.");
  
  AddDetail( ({"liliandor"}),
	     "Liliandor ist die hellste und glitzerndste Stadt, die Du je "
	     "gesehen hast. Du fuehlst Dich so frei auf den Wolken.");
  
  AddDetail( ({"stadt","wolkenstadt"}),
	     "Sie hat Dich fuer sich eingenommen und Du moechtest nie wieder "
	     "weg von hier.");
  
  AddDetail( ({"strasse"}),
	     "Meinst Du die nach Nordosten oder Suedosten.");
  
  AddDetail( ({"palast"}),
	     "Er funkelt im Sonnenlicht in der Ferne.");
  
  AddDetail( ({"ferne"}),
	     "Du blickst in die Ferne und bist von den Farben fast geblendet.");
  
  AddDetail( ({"suedplatz"}),
	     "Ueber die Strasse nach Suedosten gelangst Du dorthin.");
  
  AddDetail( ({"nordosten"}),
	     "Dort glaenzt der Palast in vollster Pracht.");
  
  AddDetail( ({"pracht"}),
	     "Meinst Du etwa nicht?");
  
  AddDetail( ({"suedosten"}),
	     "Sieh Dir den Suedplatz ruhig an.");
  
  AddDetail( ({"wolke","wolken"}),
	     "Sie bestehen aus feuchter Luft.");
  
  AddDetail( ({"farben","pastellfarben","farbe"}),
	     "Das sind alle moeglichen Farben des Regenbogens. Rot, Orange, "
	     "Gelb, Gruen, Blau, Violett.");
  
  AddDetail( ({"gelb","orange","rot","violett","blau","gruen"}),
	     "Das ist ein reines Farbfeuerwerk. Du bist sprachlos.");
  
  AddDetail( ({"farbfeuerwerk","feuerwerk","werk"}),
	     "So viele Farben!");
  
  AddDetail( ({"regenbogen","regenbogens","bogen"}),
	     "Ueber Dir zieht sich ein Regenbogen in allen Farben. Du siehst "
