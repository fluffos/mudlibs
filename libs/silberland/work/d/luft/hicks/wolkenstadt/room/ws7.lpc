  AddDetail( ({"straehne"}),
	     "Sie sind so hauchduenn und wunderbar eingeflochten.");
  
  AddDetail( ({"blumenkranz","kranz","kranzes","blumenkranzes"}),
	     "Lauter verschiedenfarbige Bluemchen.");
  
  AddDetail( ({"bluemchen"}),
	     "Lauter verschiedene winzige Blueten sind aus Glas geformt "	    
	     "worden.");
  
  AddDetail( ({"blueten"}),
	     "Du siehst jede in einer anderen Farbe schimmern.");
  
  AddDetail( ({"schlaefen"}),
	     "Genau da faengt das eingeflochtene Haar an, das sich entlang "
	     "des Blumenkranzes zieht.");
  
  AddDetail( ({"haupt"}),
	     "Du willst da doch nicht hoch klettern um Dir das genauer "
	     "anzusehen? Wo sind Deine Manieren?");
  
  AddDetail( ({"manieren"}),
	     "Sowas schickt sich nicht. Wo hast Du bloss die schlechten "
	     "Manieren her?");
  
  AddDetail( ({"gesicht"}),
	     "Das Gesicht ist makellos und strahlt vor Jugend. Es wirkt "
	     "kindlich und verspielt. Es ist so, als wuerde sie Dich gleich zu "
	     "einem Spiel locken wollte.");
  
  AddDetail( ({"laecheln"}),
	     "Du kannst gar nicht anders und musst automatisch zurueck "
	     "laecheln.");
  
  AddDetail( ({"oberflaeche"}),
	     "Sie ist uneben und kristallin, so funkelnd und kraftvoll. Du "
	     "vermerkst ein kraftvolles, rosa Pulsieren, als waere die Statue "
	     "lebendig.");
  
  AddDetail( ({"pulsieren"}),
	     "Es muss magisch sein!");
  
  AddDetail( ({"sockel"}),
	     "Der Sockel besteht aus Wolken. Du entdeckst eine winzig kleine, "
	     "glaeserne Plakette.");
  
  AddDetail( ({"plakette"}),
	     "Du kannst sie lesen.");
  
  AddDetail( ({"turm"}),
	     "Der Turm liegt gruen-weisslich mitten im Park und erscheint Dir "
	     "fast wie aus vielen Schlingpflanzen. Die rosa Glaskuppel passt "
	     "sich oberhalbt farblich wunderschoen an den Turm an.");
  
  AddDetail( ({"mitte"}),
	     "Dort wo der Turm steht, dort ist auch die Mitte.");
  
  AddDetail( ({"schlingpflanzen","pflanzen"}),
	     "Du musst durch den Park gehen um sie genauer betrachten zu "
	     "koennen!");
  
  AddDetail( ({"glaskuppel","kuppel"}),
	     "Wer da wohl oben wohnen mag? Du wuerdest auch gerne in so einem "
	     "funkelnden Juwel wohnen.");
  
  AddDetail( ({"juwel"}),
	     "Ploetzlich winkt Dir Jemand von oben. Ob Du zurueck winken "
