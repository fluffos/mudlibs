// Laden - Wolkenstadt"

inherit "std/laden";

#include "../def.h"
#include <laden.h>

int froschreset=1;
int trinken=1;
int blumenzahl=1;
int zitronenbaeumchen=1;

void create()
{
  ::create();

  SetProp (P_LIGHT, 2);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));

  SetProp(P_INT_SHORT,"Potpourries & Allerlei");
  SetProp(P_SHOPKEEPER_ID, "\nsk_jasmin");
  SetProp(P_SHOPKEEPER_NAME, "Jasmin");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
  SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetStorageRoom(ROOM "wh2lager");

  //-----Details Anfang-----
  
  AddDetail( ({"cute","marrogh","maghnar","niri","gaya","zidane","nyx","wumanzu",
	       "elrohir","velkyn","took","aroobah","methos","katarok"}),
	      "Ja, dieser Spieler hat mir geholfen, dass dieses Gebiet noch besser "
	      "und schoener wird.");
  
  AddDetail( ({"duft","dueften"}),
	     "Probiere mal den Duft zu erriechen.");
  
  AddDetail( ({"potpourries","potpourri"}),
	     "Das sind Bluetenmischungen, die herrlich duften. Sie werden in Glas- "
	     "oder Tonschuesseln aufbewahrt.");

  AddDetail( ({"bluetenmischungen","mischungen"}),
	     "Sie duften herrlich und Du findest wirklich alle Arten von Blueten "
	     "und Dueften.");

  AddDetail( ({"arten"}),
	     "Vor allem viele Jasminblueten stechen Dir ins Auge.");

  AddSpecialDetail( ({"auge"}), "stich");

  AddDetail( ({"allerlei"}),
	     "Kleidung, Schaufeln, Fackeln, Seile und vieles mehr.");

  AddDetail( ({"kleidung"}),
	     "Sie sind genauso farbenpraechtig wie all die Blueten hier im Raum.");

  AddDetail( ({"raum","laden"}),
	     "Du stehst hier im 'Potpourries & Allerlei'.");

  AddDetail( ({"blueten"}),
	     "Lass Dir mal von Jasmin erzaehlen welche Blueten sie besitzt.");

  AddDetail( ({"jasminblueten"}),
	     "Sie hat fuenf weisse Bluetenblaetter, die den goldgelben Stempel umringen.");
  
  AddDetail( ({"bluetenblaetter"}),
	     "Die Bluetenblaetter des Jasmins wirken so zierlich und zart, dass man fast "
	     "glaubt sie zu zerreissen, wenn man sie angreift.");

  AddDetail( ({"stempel"}),
	     "Du betrachtest den Stempel naeher und stoesst beinahe Deine Nase hinein. Ein "
	     "zarter goldgelber Staub bedeckt den Stempel.");

  AddDetail( ({"nase"}),
	     "Du stupst doch mit der Nase zu nah und musst niesen.");

  AddDetail( ({"staub"}),
	     "Du koenntest ihn ja mit den Fingern beruehren.");

  AddDetail( ({"finger","fingern"}),
	     "Du hast doch keine amputierten Finger, wenn Du sie nicht findest?");

  AddDetail( ({"girlanden","jasminbluetengirlanden","girlande"}),
	     "Sie sind aus zwei bis hunderten von Jasminblueten verflochten worden. Sie zieren "
	     "den ganzen Raum, indem sie an den Regalen, der Decke, der Theke lose befestigt "
	     "worden sind. Du vermutest, dass davon dieser intensive Duft den Raum ausfuellt.");

  AddDetail( ({"weiss"}),
	     "Ueberall wo Du hinblickst siehst Du weisse Jasminbluetengirlanden. Die glaeserne "
	     "Theke laesst die weissen Waende durchscheinen oder reflektiert verstaerkend ihre "
	     "Farbe. Ein wahres Blendwerk!");

  AddDetail( ({"blendwerk","werk"}),
	     "Du blinzelst!!!");

  AddDetail( ({"waende","wand"}),
	     "Die Waende sind weiss gestrichen... Doch halt!!! Sie schimmern und glitzern leicht, wie Wasser."
	    " Das fiel Dir zuerst gar nicht auf.");

  AddDetail( ({"wasser"}),
	     "Bei naeherer Betrachtung faellt Dir auf, das ist Wasser.");

  AddDetail( ({"betrachtung"}),
	     "Das sind tausende an kleine Tautroepfchen, die die Wand benetzen.");

  AddDetail( ({"tautroepfchen","troepfchen"}),
	     "Du verspuerst Durst!");

  AddDetail( ({"durst"}),
	     "Wo kann man so schnell etwas trinken?");  

  AddDetail( ({"farbe"}),
	     "Weiss ueberwiegt eindeutig, aber auch andere Farben mischen sich in das "
	     "monotone Weiss.");

  AddDetail( ({"theke","glastheke"}),
	     "Du kannst ins Innere der Theke blicken... Dabei siehst Du vor allem viele verschiedene "
	     "Potpourries, aber auch Blumenschmuck und sonstige Kleinigkeiten.");

  AddDetail( ({"innere","inneres"}),
	     "Du entdeckst verschiedene Potpourries.");

  AddDetail( ({"glas"}),
	     "Glas macht den Raum transparenter und eleganter, fast zerbrechlich.");

  AddDetail( ({"glasschuesseln","schuesseln","tonschuesseln"}),
	     "Du siehst grosse Schuesseln und kleine Schuesseln, bunte und einfarbige, aber eine "
	     "Schuessel auf der Theke faellt besonders auf.");

  AddDetail( ({"schuessel","glasschuessel"}),
	     "Sie besteht aus Glas und du erkennst zwischen den weissen Jasminblueten etwas "
	     "Rosarot durchschimmern.");

  AddDetail( ({"rosarot","rosa","rot"}),
	     "Du betrachtest es naeher, entdeckst nicht mehr. Vielleicht kannst Du "
	     "ja in der Glasschuessel mal wuehlen?");

  AddDetail( ({"blumenschmuck","schmuck","seile","fackeln","schaufeln"}),
	    "Mit 'zeige' kannst Du genau sehen was angeboten wird.");

  AddDetail( ({"kleinigkeiten"}),
	     "Soweit Du blicken kannst siehst du dies und jenes.");

  AddDetail( ({"regale","regalen"}),
	     "Du erkennst lueckenhaft Kleider in den Regalen, da sie von den Jasminblueten "
	     "teilweise verdeckt werden.");

  AddDetail( ({"kleider","sachen"}),
	     "Lass Dir doch alles von Jasmin genauer zeigen.");

  AddDetail( ({"boden"}),
	     "Der Boden besteht aus Wolkenparkett. Eigenartig, wenn es nicht aus Holz ist.");

  AddDetail( ({"wolkenparkett","parkett","wolken"}),
	     "Ein echter, wattiger Boden und wunderschoen gemasert.");

  AddDetail( ({"holz"}),
	     "Hier findest Du eher weniger Holz.");

  AddDetail( ({"decke"}),
	     "Die Decke besteht aus Milchglas, so dass ein sanfter Sonnenschimmer den Raum "
	     "durchflutet.");

  AddDetail( ({"milchglas"}),
	     "Dieses Glas ist so angerauht, dass man eben nicht klar durchsehen kann.");

  AddDetail( ({"sonnenschimmer","schimmer"}),
	     "Durch das Milchglas wird das Sonnenlicht so abgedaempft, dass der Laden "
	     "wirklich wonnig und wohlig wirkt.");

  AddDetail( ({"sonnenlicht","licht"}),
	     "Huch?!? Genau dort, wo das Sonnenlicht das Glas durchbricht siehst Du "
	     "jetzt erst, dass ein Glockenspiel an der Decke haengt.");

  AddDetail( ({"glockenspiel","spiel"}),
	     "Es besteht auch aus Glas und schimmert regenbogenfarbig. Du verspuerst irgendwie den "
	     "Wunsch das Glockenspiel anzustimmen.");

  AddDetail( ({"wunsch"}),
	     "Na mach schon!!! Stimme das Glockenspiel an!!!");

  AddDetail( ({"lager"}),
	     "Dorthin gelangt nur Jasmin. Du wuerdest sowieso nichts finden.");

  AddDetail( ({"sinne"}),
	     "Deine Sinne sind so betaeubt, dass es Dir fast schwindelt. Doch "
	     "eine frische Brise haelt Dich in der Realitaet fest.");

  AddDetail( ({"brise"}),
	     "Diese frische Brise kann man auch erriechen.");

  AddDetail( ({"realitaet"}),
	     "Ist das hier die wirkliche, reale Wirklichkeit?");

  AddDetail( ({"wirklichkeit"}),
	     "Ja, ein PLOPP laesst Dich nicht schwindeln.");

  AddDetail( ({"plopp"}),
	     "Das kann man nur hoeren.");

  AddDetail( ({"ecke"}),
	     "Du erkennst nichts... Doch! Halt! Da ziert ein kleines Zitronenbaeumchen "
	     "die Ecke.");

  AddDetail( ({"zitronenbaeumchen","baeumchen"}),
	     "Das kleine Zitronenbaeumchen blueht einerseits, aber andererseits siehst Du auch reife "
	     "Zitronen daran haengen.");

  AddDetail( ({"zitronen"}),
	     "PLOPP - Eine Zitrone hat aufgestossen und ein leicht zitroniger, aber saeuerlicher "
	     "Geruch schlaegt Dir entgegen.");

  AddDetail( ({"geruch"}),
	     "Du wolltest sicher diesen Geruch erriechen?");

  AddDetail( ({"zitrone"}),
	     "BOEEEERP! Diese Zitrone hat aufgestossen.");

  AddDetail( ({"sodbrennen","brennen","sod"}),
	     "Mhh, wen koennte man fragen, was gegen Sodbrennen hilft? Das arme "
	     "Zitronenbaeumchen tut Dir wirklich leid!!!");

  
  AddSmell(DEFAULT_SMELL, "Der Duft von Jasminblueten erfuellt diesen Raum.");
  
  AddSmell( ({"duft","duefte","dueften","jasminblueten","jasminbluete"}),
	    "Einerseits betoert Dich dieser Duft, doch andererseits ist er "
	    "schon fast zu schwer. Deine Sinne sind wie betaeubt.");

  AddSmell( ({"brise"}),
	    "Diese Brise weht mit einem leicht zitronigen, aber doch saeuerlichen "
	    "Geschmack aus einer Ecke.");

  AddSmell( ({"ecke","sinne"}),
	    "Das kannst Du ganz normal erforschen.");

  AddSmell( ({"geschmack"}),
	    "Fuer Deinen Geschmack ist es schon zu saeuerlich, dass es nicht mehr "
	    "erfrischend riecht.");

  AddSmell( ({"geruch"}),
	    "Eigenartig... Ein Zitronenbaeumchen, das Sodbrennen hat?");

  AddSmell( ({"aroma"}),
	    "Mhhh, das duftet frisch zitronig... aber... igitt, dieser Geruch.");

  AddSound(DEFAULT_SOUND, "Es ist sehr ruhig und friedlich in dem Laden.");

  AddSound( ({"plopp"}),
	    "Dieses PLOPP scheint aus einer hinteren Ecke zu kommen. Vielleicht "
	    "gehst Du dem mal nach?");
  
  
  //-----Details Ende-----


  AddExit("suedosten", ROOM "ws8");

  AddItem(NPC "jasmin", REFRESH_DESTRUCT);

  AddCmd( "beruehre|beruehr&stempel|bluete|jasminbluete", "cmd_beruehren",
          "Was willst Du beruehren?\n");
  AddCmd( ({"trinke","trink","schlecke","schleck","lecke","leck"}), "cmd_trinken");
  AddCmd( ({"pfluecke","pflueck"}), "cmd_pfluecken");
  AddCmd( ({"wuehle","wuehl"}), "cmd_wuehlen");
  AddCmd( ({"fische","fisch"}), "cmd_fischen");
  AddCmd( ({"stimme","stimm"}), "cmd_anstimmen");
  AddCmd( "fuetter|fuettere|gib|gebe|verabreiche&zitronenbaeumchen|baeumchen&kautablette|tablette",
          "cmd_kautablette", "Was willst Du dem Zitronenbaeumchen fuettern?\n");  
}

string _query_int_long()
{
  string txt;

  txt = "Der Duft im 'Potpourries & Allerlei' erschlaegt Dich fast. Du siehst ueberall "
	"Jasminblueten als Girlanden haengen. Das Weiss blendet Dich fast. Eine "
	"geraeumige Glastheke beeinhaltet viele Glas- und Tonschuesseln mit Blueten. "
	"In den weiss getuenchten Regalen findest Du auch anderen Sachen. ";


  if(QueryProp(P_SHOPKEEPER_ID) && !present(QueryProp(P_SHOPKEEPER_ID)))
    txt += "Jasmin, die Ladenbesitzerin, scheint sich momentan im Lager aufzuhalten.";

  return BS(txt);
}

void reset()
{
  ::reset();
  froschreset=1;
  trinken=1;
  blumenzahl=1;
  zitronenbaeumchen=1;
}

string stich()     
{
  SetProp(P_KILL_NAME, "Ein Stich ins Auge");
  TP->do_damage(10);
  
  tell_room(TO, BS(TPN+" schreit auf: AUAAAA!, und reibt sich die Augen."), 
	    ({TP}));
  
  return BS("Wie ein kleiner Blitz sticht Dich etwas ins Auge. AUAAAAA!, "
	    "Du heulst auf.");
}

int cmd_beruehren(string str)	
{
/*  notify_fail("Was willst Du beruehren?\n");
  
  if(!(str=="stempel"||
       str=="bluete"||
       str=="staub"||
       str=="jasminbluete"||
       str=="stempel mit finger"||
       str=="bluete mit finger"||
       str=="staub mit finger"||
       str=="jasminbluete mit finger")) 
    return 0;*/
  
  write(BS("Du beruehrst die zarten Blaetter und wanderst sanft und vorsichtig zum Stempel."
	   " Als Du darueber streifst flirrt leichter Bluetenstaub auf, "
	   "der magisch aufglitzert. Dann ist es wieder vorbei. "));
  
  say(BS(TPN+" begutachtet eine Jasminbluete naeher."));
  
  return 1;
}

int cmd_trinken(string str)	
{
  notify_fail("Was willst Du wovon trinken?\n");
  
  if(!(str=="wasser von wand"||
       str=="tautroepfchen von wand"||
       str=="troepfechen von wand"||
       str=="tau von wand")) 
    return 0;
  
 if(!TP->drink_soft(2))
    return -1;

  write(BS("Du leckst heimlich ein paar Tautroepfchen von der Wand und hast Deinen "
        "Mund schon voll suesslichem, zart blumigen Wasser. Du schluckst es "
        "schnell hinunter, bevor jemand etwas bemerkt."));

  if(trinken==1)
  {
    TP->AddHp(5+random(5));
    trinken--;
  }

  return 1;
}

int cmd_pfluecken(string str)
{
  object jasminbluete;
  notify_fail("Was willst Du pfluecken?\n");
  
  if(!str) return 0;
    
  if(str=="bluete"|| str=="jasminbluete")
    {	  
      if(blumenzahl<1)
        {
	  write(BS("Du entdeckst keine richtig schoen aufgebluehte Jasminbluete und "
		"wartest lieber noch."));
	  say(TPN+" seufzt enttaeuscht.\n");
	  
          return -1;
        }
    	
      jasminbluete=clone_object(ARMOUR "jasminbluete");
      if (ME_TOO_HEAVY==jasminbluete->move(TP,M_GET))
	{
	  write(BS("Du pflueckst eine Jasminbluete, die Dir aber sofort aus der Hand gleitet "
		     "und zu Boden segelt."));
	  say(BS(TPN+" pflueckt eine Jasminbluete und laesst diese gleich fallen."));
	    
	  jasminbluete->move(TO, M_NOCHECK|M_SILENT);
	  return 1;
        }
	
      write(BS("Du suchst Dir eine besonders schoene und grosse Bluete aus und brichst sie "
		"vorsichtig aus einer Girlande heraus."));
      say(BS(TPN+" pflueckt sich eine Jasminbluete."));
	
      blumenzahl--;
      return 1;
    }
  
      if(str=="zitrone"|| str=="zitronenbluete")
        { 
          write(BS("Das Zitronenbaeumchen gibt Dir einfach keine Zitrone ab."));
          return 1;
        }

      return 0;
}

int cmd_wuehlen(string str)	
{
  notify_fail("Worin willst Du wuehlen?\n");
  
  if(!(str=="in glasschuessel"||
       str=="in schuessel"||
       str=="in potpurie"||
       str=="in blueten"||
       str=="in jasminblueten")) 
    return 0;
  
  write(BS("Du wuehlst in dem Potpourie aus Jasminblueten und bemerkst nichts. Doch halt!!! Du "
	  "hast ein glitschiges, schleimiges Etwas ertastet. Igitt!! Willst Du danach wirklich "
	  "fischen?"));
  
  say(BS(TPN+" wuehlt in einer Glasschuessel."));
  
  return 1;
}


int cmd_fischen(string str)	
{
  object frosch;
  notify_fail("Wonach willst Du fischen?\n");
  
  if(!(str=="nach etwas"||
       str=="nach glitschigem"||
       str=="nach glitschiges"||
       str=="nach etwas in schuessel"||
       str=="nach etwas in blueten")) 
    return 0;
  
  if(froschreset<1)
  {
    write(BS("Du wuehlst und wuehlst nach diesem Etwas, aber Du scheinst Dich "
    	       "getaeuscht zu haben."));

    say(BS(TPN+" wuehlt in einer Glasschuessel."));
      
    return -1;
  }
  
  frosch=clone_object(NPC "frosch");
  frosch->move(ENV(TP),M_NOCHECK|M_SILENT);
  TP->AddPursuer(frosch);
  
  write(BS("Du greifst gekonnt in die Glasschuessel und fischt dieses Etwas heraus, das "
	   "quakend von Deiner Hand springt."));
  
  say(BS(TPN+" holt aus einer Glassschuessel einen rosaroten Frosch."));
  
  froschreset--;
  
  return 1;
}

int cmd_anstimmen(string str)	
{
  notify_fail("Was willst Du anstimmen?\n");
  
  if(!(str=="glockenspiel an"||
       str=="glocken an"||
       str=="spiel an")) 
    return 0;
  
  write(BS("Sanft streichst Du ueber die Glasgloeckchen des Glockenspiels, die zu pendeln "
	  "anfangen. Durch diese Pendelbewegung stossen sie unrhythmisch gegen einander und "
	  "es ertoent ganz zauberhaftes und individuelles Lied. "));
  
  say(BS(TPN+" streift ueber ein Glockenspiel und ein zauberhaftes Lied ertoent."));
  
  return 1;
}

int cmd_kautablette(string str)
{
  object zitrone;
  string txt; 

  if(!present("kautablette", TP))
    {
      write(BS("Du hast ja gar nichts geeignetes um dem Baeumchen etwas zu fuettern.\n"));
      return -1;
    }

  txt = "Du schiebst die Kautablette in einen kleinen Riss einer Zitrone. "
               "Das Baeumchen faengt sofort zu kauen und schmatzen an. BOEEEEERP!!!! DANKE!!! DANKE!!! "
               "JETZT GEHT ES MIR SCHON VIEL BESSER!";

  if(zitronenbaeumchen<1 || deep_present("zitrone",TP))
    {
      write(BS("Du schiebst die Kautablette in einen kleinen Riss einer Zitrone. "
               "Das Baeumchen faengt sofort zu kauen und schmatzen an. BOEEEEERP!!!!. "
               "Sonst passiert gar nichts."));

      say(TPN+" gibt ein lautes BOEEERP von sich.\n");

      return -1;
    }

  zitrone=clone_object(OBJ "zitrone");
  if (ME_TOO_HEAVY==zitrone->move(TP,M_GET|M_SILENT))
    {
      write(BS(txt + " Das Zitronenbaeumchen schuettelt sich und eine Zitrone"
               " kullert zu Boden."));
      say(BS(TPN+" kullert eine Zitrone zu Boden."));

      zitrone->move(TO,M_NOCHECK|M_SILENT);
	    
    }
  else
    {
      write(BS(txt + " Das Zitronenbaeumchen schuettelt sich und eine "
               "gelbe Zitrone faellt genau in Deine Haende."));
      say(TPN+" gibt ein lautes BOEEERP von sich.\n");
    }
  
  present("kautablette",TP)->remove(1);
  zitronenbaeumchen--;
  return 1;
}
