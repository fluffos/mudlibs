// von Hicks
// 20.1.2004
// 
// Raum meines Gesellenstueckes "Innerer Strassenring - Wolkenstadt"

inherit "std/room";

#include "../def.h"

void create()
     
{
  ::create();
  

  SetProp(P_INT_SHORT, "Strasse in der Wolkenstadt");
  SetProp(P_INT_LONG,
	  "Die Strasse zieht sich vom Ostplatz zum Suedplatz. Auf der einen "
	  "Seite befinden sich Haeuser in verschiedensten Formen und wirken "
	  "irgendwie verspielt auf Dich. Gegenueber sticht Dir ein filigraner "
	  "Turm ins Auge, der von einem Park umsaeumt wird. Zur rechten Hand "
	  "siehst Du ein idyllisches Nebelbecken und zur linken erkennst Du "
	  "einen huebschen Wasserfall, der von einem Felsen herunter fliesst.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);
  
  //-----Details Anfang-----
  
  AddDetail( ({"cute","marrogh","maghnar","niri","gaya","zidane","nyx","wumanzu",
	       "elrohir","velkyn","took","aroobah","methos","katarok"}),
	      "Ja, dieser Spieler hat mir geholfen, dass dieses Gebiet noch besser "
	      "und schoener wird.");
  
  AddDetail( ({"strasse"}),
	     "Du befindest Dich auf ihr und sie zieht vom Ostplatz zum "
	     "Suedplatz.");
  
  AddDetail( ({"platz"}),
	     "Welchen meinst Du, den Ostplatz oder den Suedplatz?");
  
  AddDetail( ({"ostplatz"}),
	     "Er befindet sich nordoestlich von Dir und Du siehst nur eine "
	     "gelblich leuchtende Statue platziert.");
  
  AddDetail( ({"suedplatz"}),
	     "Er befindet sich suedwestlich von Dir und Du erkennst einen "
	     "Felsen in der Ferne. Auf der einen Seite entspringt ein "
	     "Wasserfall und auf der anderen erkennst Du ein "
	     "Trinkbecken mit einem Wasserhahn.");
  
  AddDetail( ({"fels","felsen"}),
	     "Ein grauer Fels aus Wolken. Ob der wohl weich oder hart ist?");
  
  AddDetail( ({"ferne"}),
	     "Du blickst herum und entdeckst so viele neue Details, dass Du "
	     "gar nicht weisst, wo Du zuerst hingehen sollst.");
  
  AddDetail( ({"detail","details"}),
	     "Untersuch einfach alles, dann erhaeltst Du vielleicht einen "
	     "Forscherpunkt.");
  
  AddDetail( ({"forscherpunkt","punkt"}),
	     "Aetsch! Wer untersucht das schon?");
  
  AddDetail( ({"seite"}),
	     "Du bist auf der Oberseite im Silberland.");
  
  AddDetail( ({"oberseite"}),
	     "Liliandor ist hoch oben.");
  
  AddDetail( ({"liliandor"}),
	     "Das ist die Wolkenstadt auf der Oberseite der Wolken.");
  
  AddDetail( ({"wolkenstadt","stadt"}),
	     "In ihr befindest Du Dich im Moment.");
  
  AddDetail( ({"moment"}),
	     "Jetzt!");
  
  AddDetail( ({"silberland","land"}),
	     "Ich hoffe, es gefaellt Dir hier.");
  
  AddDetail( ({"wasserfall"}),
	     "Er plaetschert ruhig vor sich hin. Ein lauschiges Plaetzchen.");
  
  AddDetail( ({"plaetzchen"}),
	     "Ploetzlich erscheint ein Plaetzchen magisch in Deiner Hand und "
	     "Du verschlingst es gierig. Mhhh, das war lecker!");
  
  AddDetail( ({"becken","trinkbecken","wasserbecken"}),
	     "Eine Ausbuchtung zieht sich aus dem Felsen und ist voll mit "
	     "Wasser gefuellt, das aus dem Wasserhahn hinein fliesst.");
  
  AddDetail( ({"ausbuchtung"}),
	     "A propos Ausbuchtung. Sie Dir mal Dein Baeuchlein an.");
  
  AddDetail( ({"baeuchlein"}),
	     "Du ziehst es ein, aber gleich ploppt es wieder heraus und "
	     "laesst sich nicht verbergen.");
  
  AddDetail( ({"wasser"}),
	     "Soweit Du es erkennen kannst, ja, es ist Wasser.");
  
  AddDetail( ({"wasserhahn","hahn"}),
	     "Diese Rohr sticht aus dem Felsen heraus und hindurch fliesst "
	     "Wasser. Das duerfte das gleiche Wasser wie aus dem Wasserfall "
	     "sein.");
  
  AddDetail( ({"rohr"}),
	     "Ein rundes, hohles Rohr aus dem Wasser fliesst.");
  
  AddDetail( ({"statue"}),
	     "Du musst schon hingehen, wenn Du sie sehen willst.");
  
  AddDetail( ({"haeuser"}),
	     "Die Haeuser glitzern und glaenzen alle in verschiedensten "
	     "Farben. Einige bestehen nur aus Glas, andere aus Wolkensteinen "
	     "und manche aus beidem.");
  
  AddDetail( ({"farben"}),
	     "Das sind alle moeglichen Farben des Regenbogens. Rot, Orange, "
	     "Gelb, Gruen, Blau, Violett.");
  
  AddDetail( ({"gelb","orange","rot","violett","blau","gruen"}),
	     "Das ist ein reines Farbfeuerwerk. Von ueberall her begeistern "
	     "Dich die Farben.");
  
  AddDetail( ({"farbfeuerwerk","feuerwerk","werk"}),
	     "Es explodiert und knallt ueberall - natuerlich vor Farben.");
  
  AddDetail( ({"glas"}),
	     "Das Glas kann transparent, milchig oder uneben sein. Je nachdem "
	     "funkelt oder schimmert es. Hin und wieder zieren Kletterpflanzen "
	     "die Waende.");
  
  AddDetail( ({"pflanzen"}),
	     "Meinst Du die Kletterpflanzen oder die Schlingpflanzen?");
  
  AddDetail( ({"kletterpflanzen"}),
	     "Sie wuchern ueber manche Waende und schimmern gruen-weisslich. "
	     "Sie haben geschwungene, glatte Blaetter.");
  
  AddDetail( ({"blaetter"}),
	     "Hie und da welche, und alle sind gruen. Wie erstaunlich! ;-)");
  
  AddDetail( ({"wind","windhauch","hauch"}),
	     "Der Wind streift sanft ueber die Buesche und schmeichelt ueber "
	     "Deine Haut.");
  
  AddDetail( ({"haut"}),
	     "Mhhh, Du geniesst es einfach.");
  
  AddDetail( ({"wand","waende","glaswand"}),
	     "Die Waende bestehen aus Glas, Wolkensteinen oder aus beidem. "
	     "Kletterpflanzen zieren manche Haeuser.");
  
  AddDetail( ({"form","formen"}),
	     "Manche sind rechteckig, andere rund, andere wieder"
	     " kuppelfoermig. Manche sind verschlossen, andere offen, andere "
	     "wiederum haben gar keine Tueren und Fenster.");
  
  AddDetail( ({"tuer","tueren","fenster"}),
	     "Wie gesagt, nicht alle Haeuser haben welche.");
  
  AddDetail( ({"turm"}),
	     "Der Turm liegt gruen-weisslich mitten im Park und besteht aus "
	     "vielen Schlingpflanzen. Die rosa Glaskuppel passt "
	     "sich oberhalb farblich wunderschoen an den Turm an.");
  
  AddDetail( ({"auge"}),
	     "Ploetzlich kommt Dir etwas ins Auge, und Du musst es "
	     "fuerchterlich viel reiben.");
  
  AddDetail( ({"schlingpflanzen"}),
	     "Es bieten sich gleich zwei fast-direkte Wege an!");
  
  AddDetail( ({"weg","wege"}),
	     "Einer wird schon der rechte Weg sein.");
  
  AddDetail( ({"glaskuppel","kuppel"}),
	     "Sie funkelt wunderschoen rosa auf der Turmspitze.");
  
  AddDetail( ({"turmspitze","spitze"}),
	     "Da thront die Glaskuppel.");
  
  AddDetail( ({"park"}),
	     "Buesche und Blumen erkennst Du auf der Wiese. Du siehst auch, "
	     "dass Du ueber den Park zum Turm gelangst, und andererseits "
	     "kannst Du Dich dort sicher gut erholen.");
  
  AddDetail( ({"buesche","bueschen"}),
	     "Die Buesche zaeunen den Park ein. Ein Busch zieht besonders "
	     "Deinen Blick an.");
  
  AddDetail( ({"busch","blick"}),
	     "Du erkennst irgend etwas im Dickicht.");
  
  AddDetail( ({"dickicht"}),
	     "Du gehst naeher ran, aber du musst das Dickicht schon "
	     "auseinander schieben.");
  
  AddDetail( ({"blumen"}),
	     "Die Blumen gedeihen in allen Farben.");
  
  AddDetail( ({"wiese"}),
	     "Die Wiese ist zwar gruen, aber sie wirkt eingefroren. Die "
	     "Eisschicht funkelt ein wenig.");
  
  AddDetail( ({"eisschicht","schicht"}),
	     "Du streichst darueber und stellst fest, dass sie gar nicht kalt "
	     "ist. Das duerfte wohl natuerlich sein.");
  
  AddDetail( ({"nebelbecken","becken"}),
	     "Das Nebelbecken liegt idyllisch zwischen den Bueschen. "
	     "Nebelschwaden ziehen sich vom Becken ueber die Wiese.");
  
  AddDetail( ({"nebelschwaden","schwaden","nebel"}),
	     "Ein bisschen unheimlich wirkt es schon, weil der Nebel "
	     "irgendwie alles zu verschlucken scheint.");
  
  AddDetail( ({"hand","handi"}),
	     "Du singst: Patsch Handi zam, patsch Handi zam, was wird der "
	     "Papa bringen?");
  
  AddDetail( ({"papa"}),
	     "Zeit, mal wieder deinen Papa zu besuchen.");
  
  AddDetail( ({"zeit"}),
	     "Wie waere es mit jetzt?");
  
  AddDetail( ({"boden"}),
	     "Der Boden ist von wattigen Wolkensteinen gesaeumt. Du sinkst "
	     "beim Gehen immer ein wenig ein. Das animiert Dich doch glatt "
	     "zum Springen.");
  
  AddDetail( ({"wolkensteine","wolkensteinen","steine","steinen"}),
	     "Sie bestehen aus Wolken, wie fast alles hier.");
  
  AddDetail( ({"gehen"}),
	     "Du graebst Dich beim Gehen mit den Zehen in die Wolkensteine.");

  AddDetail( ({"zehen"}),
	     "Du musst unwillkuerlich kichern.");

  AddDetail( ({"springen"}),
	     "Hicks wollte das nicht mehr ausdetailieren.");
  
  AddDetail( ({"wolken"}),
	     "Sie bestehen nur aus feuchter Luft.");
  
  AddDetail( ({"himmel"}),
	     "Ein Regenbogen spannt sich ueber den Himmel. Dieser ist wolkenlos "
	     "und blau. Die Sonne laechelt Dir munter zu.");
  
  AddDetail( ({"regenbogen","bogen","regenbogens"}),
	     "Ein bunter Bogen, der in allen Farben schimmert.");
  
  AddDetail( ({"sonne"}),
	     "Die Sonne laechelt Dir zu und waermt die Luft etwas an, weil es "
	     "doch normalerweise viel kaelter hier oben waere.");
  
  AddDetail( ({"luft"}),
	     "Die Luft ist ganz klar und eigentlich kuehl, wenn da nicht die "
	     "Sonne waere.");
  
  AddDetail( ({"zwitschern"}),
	     "Es kommt aus dem Busch.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	     "Du stellst Dich vor eine Glaswand und praegst Dich selbst ein. "
	     "Du koenntest Dich ja vergessen.");
  
  AddDetail( ({"aug","augen"}),
	     "Mit den Augen schaust Du.");
  
  AddDetail( ({"ohr","ohren"}),
	     "Mit den Ohren lauschst Du.");
  
  AddDetail( ({"nase"}),
	     "Mit der Nase riechst Du.");
  
  AddDetail( ({"duft"}),
	     "Rieche ihn mal.");
  
  
  AddSmell(DEFAULT_SMELL, "Du saugst die klare Luft ein, und ein frischer "
	   "Blumenduft streicht Dir unter die Nase.");  
  
  AddSmell( ({"duft","blumen","blumenduft"}),
	    "Sie duften frisch und suess.");
  
  AddSmell( ({"luft"}),
	    "Du schnupperst an der klaren Luft und fuehlst Dich frei.");
  
  AddSmell( ({"nase"}),
	    "Hast Du schon jemals an Deiner Nase gerochen? *kopfschuettel*");
  
  
  AddSound(DEFAULT_SOUND, "Ein Vogelzwitschern laesst Dich aufhorchen. "
	   "Manchmal zieht ein zarter Windhauch durch die Strasse, der vom "
	   "plaetschernden Wasserfall unterbrochen wird.");
  
  AddSound( ({"wind","hauch","windhauch"}),
	    "Er fluestert Dir: Folge mir und spiel mit mir!");
  
  AddSound( ({"plaetschern","wasserfall"}),
	    "Plitscherplaetscher!");
  
  AddSound( ({"vogelzwitschern","zwitschern","vogel","voegel"}),
	    "Bei genauerem hinhoeren stellst Du fest, dass es aus den "
	    "Bueschen kommt.");
  
  AddSound( ({"buesche","bueschen"}),
	    "Du haeltst Dein Ohr an einen Busch und hoerst eindeutig "
	    "Vogelzwitschern.");
  
  AddSound( ({"strasse"}),
	    "Vogelzwitschern, Windhauch und plaetschern hoerst Du.");
  
  //-----Details Ende-----
  
  AddExit("nordosten",ROOM "ws3");
  AddExit("suedwesten",ROOM "ws5");
  AddExit("norden",ROOM "ws10");
  AddExit("westen",ROOM "ws11");
  
  
  AddCmd( ({"schieb","schiebe","zieh","ziehe"}),"cmd_dickicht");
  AddCmd( ({"beruehre","beruehr","fuehle","fuehle","greife","greif"}),"cmd_fels");
}

int cmd_dickicht(string str)
{
  
  notify_fail("Was willst Du auseinander schieben?\n");
  
  if(!(str=="dickicht auseinander"||
       str=="busch auseinander"||
       str=="blaetter auseinander"||
       str=="dickicht weg"||
       str=="busch weg"||
       str=="blaetter weg")) 
    return 0;
  
  write(BS("Du hockerlst Dich hin und entdeckst ein Vogelnest mit "
	   "Kueken. Ahh, daher kommt der Laerm! Du willst "
	   "nicht stoeren und versteckst das Nest wieder."));
  
  say(BS(TPN+" hockst sich vor einen Busch und wuehlt darin herum. "
	 "Ob "+TP->QueryPronoun(WER)+" etwas entdeckt hat?"));
  
  return 1;
}

int cmd_fels(string str)
{
  
  notify_fail("Was moechtest Du beruehren?\n");
  
  if(!(str=="fels"||
       str=="felsen"||
       str=="felsgestein")) 
    return 0;
  
  write(BS("Du streckst Deine Hand in Richtung Felsen aus und Dein Arm wird "
	   "immer und immer laenger. Ich habe einen Gummiarm!, stellst Du "
	   "schockiert fest. Du kommst aber dann doch auf die Idee, dass Du "
	   "naeher hingehen solltest."));
  
  say(BS(TPN+" meint: Ich habe einen Gummiarm!"));
  
  return 1;
}
