// Raum meines Gesellenstueckes "Park - Wolkenstadt"
inherit "std/room";

#include "../def.h"

int greifen=5;
int trinken=1;
int blumenzahl=3;

void create()
     
{
  ::create();
  
  
  SetProp(P_INT_SHORT, "Im Park der Wolkenstadt");
  SetProp(P_INT_LONG,
	  "Nun stehst Du vor dem Wasserfall, der mit einem breiten Strahl den "
	  "Fels herunter braust. Das kleine Wasserbecken wird durch Wellen "
	  "unaufhoerlich bewegt. Du erkennst im Becken regenbogenfarbene "
	  "Glassteine und auch ein paar Wasserpflanzen. Die Luft ist erfuellt "
	  "von vielen Seifenblasen, die hinter dem Wasserfall heraus "
	  "spruehen.");
  
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);
  
  //-----Details Anfang-----
  
  AddDetail( ({"cute","marrogh","maghnar","niri","gaya","zidane","nyx","wumanzu",
	       "elrohir","velkyn","took","aroobah","methos","katarok"}),
	      "Ja, dieser Spieler hat mir geholfen, dass dieses Gebiet noch besser "
	      "und schoener wird.");
  
  AddDetail( ({"wasserfall"}),
	     "Er fliesst den Felsen herunter wie ein weisser Strahl und "
	     "schaeumt im Wasser ganz auf.");
  
  AddDetail( ({"strahl"}),
	     "Er braust den Felsen hinunter. Wenn er nicht so feenklein "
	     "waere, dann koennte er schon so manches mitreissen.");
  
  AddDetail( ({"fels","felsen"}),
	     "Er besteht vollstaendig aus dunkelgrauen Wolken. Du tastest ihn "
	     "ab und er ist haerter, als Du es Dir erwartet haettest.");
  
  AddDetail( ({"wolken"}),
	     "Sie bestehen aus viel Luft.");
  
  AddDetail( ({"luft"}),
	     "Sie ist hier oben richtig zu fuehlen und von Seifenblasen "
	     "erfuellt. Kein Wunder, du bist ja in der Luft.");
  
  AddDetail( ({"wunder"}),
	     "Du bist 1000 Meter ueber dem Land und denkst, das ist kein "
	     "Wunder? *kopfschuettel*");
  
  AddDetail( ({"land"}),
	     "Das ist unter Dir.");
  
  AddDetail( ({"meter"}),
	     "Tausend davon ist schon viel.");
  
  AddDetail( ({"tausend"}),
	     "In der Hoehe schwebst Du so hoch.");
  
  AddDetail( ({"hoehe"}),
	     "Runter schauen kann man gottseidank nicht.");
  
  AddDetail( ({"becken","wasserbecken"}),
	     "Du erkennst alles nur schemenhaft, wie die Glassteine und das "
	     "Wasserpflanzen. Doch etwas Anderes bewegt sich in den Wellen auch.");
  
  AddDetail( ({"glassteine","steine"}),
	     "Sie schimmern in verschiedenen Regenbogenfarben. Das Wasser "
	     "erhaelt dadurch noch mehr Bewegung.");
  
  AddDetail( ({"regenbogenfarben"}),
	     "Alles in Pastellfarben.");
  
  AddDetail( ({"pastellfarben"}),
	     "Pastellfarben sind abgedaempfter.");
  
  AddDetail( ({"bewegung"}),
	     "Durch die Wellen ist das Wasser sehr unruhig im Becken.");
  
  AddDetail( ({"anderes"}),
	     "Du beobachtest laengere Zeit das Wasserbecken und erkennst "
	     "transparente Fische darin, die hin und her flitzen.");
  
  AddDetail( ({"zeit"}),
	     "Du musstest Dich ziemlich konzentrieren und geduldig sein.");
  
  AddDetail( ({"fische"}),
	     "Du erkennst sie nur an den schwarzen Augen. Sie haben eine "
	     "lange duenne Nase und sehen irgendwie suess aus.");
  
  AddDetail( ({"augen"}),
	     "Ansonsten ist alles durchsichtig und schwer zu erkennen.");
  
  AddDetail( ({"nase"}),
	     "Es ist schwer zu erkennen, aber die Nase laesst die Fische "
	     "putzig aussehen.");
  
  AddDetail( ({"wellen"}),
	     "Durch den Strahl schwappt das Wasser unruhig hin und her.");
  
  AddDetail( ({"wasser"}),
	     "Das Wasser ist ganz klar und braust den Fels hinunter und "
	     "endet im Wasserbecken.");
  
  AddDetail( ({"wasserpflanzen","pflanzen"}),
	     "Sie zappeln gruenlich im unruhigen Wasser hin und her.");
  
  AddDetail( ({"seifenblasen","blasen"}),
	     "Sie schweben und tanzen in der Luft herum. Ein schoener "
	     "Anblick. Vielleicht kannst Du eine fangen?");
  
  AddDetail( ({"anblick"}),
	     "Du siehst zu wie sie sich wiegen und tanzen und kreisen und "
	     "herum wirbeln.");
  
  AddDetail( ({"himmel"}),
	     "Er ist blau und wolkenlos. Die Sonne strahlt unerlaesslich "
	     "herab. Du erkennst ein Puenktchen am Himmel.");
  
  AddDetail( ({"puenktchen"}),
	     "Sieht aus wie ein Adler.");
  
  AddDetail( ({"adler"}),
	     "Er duerfte hier oben leben.");
  
  AddDetail( ({"sonne"}),
	     "Sie laechelt Dich goldgelb an.");
  
  AddDetail( ({"boden"}),
	     "Du stehst inmitten der Wiese, die das Wasserbecken umringt. "
	     "Einige Blumen sind eingestreut und Buesche begrenzen die "
	     "Wiese.");
  
  AddDetail( ({"wiese"}),
	     "Sie schimmert und glitzert in gruen, als waere sie gefroren.");
  
  AddDetail( ({"blumen","wolkenblumen"}),
	     "Sie bluehen in allen Pastellfarben und duften wunderbar. Du "
	     "hast noch nie Wolkenblumen gesehen und bist fasziniert.");
  
  AddDetail( ({"buesche"}),
	     "Sie sind saftig gruen.");
  
  AddDetail( ({"marshmallow","marshmallows"}),
	     "Mhh, waere lecker jetzt eines zu naschen.");
  
  AddDetail( ({"schatten"}),
	     "Scheint ein kleines Loch zu sein.");
  
  AddDetail( ({"loch"}),
	     "Vielleicht kannst Du hinein greifen, wenn Du Dich traust.");
  
  AddDetail( ({"blumenduft","duft","geruch"}),
	     "Das kannst Du nur riechen.");
  
  
  AddSmell(DEFAULT_SMELL, "Du riechst einen Blumenduft und noch einen "
	   "anderen Geruch.");
  
  AddSmell( ({"blumenduft","blumen","duft","wolkenblumen","wolkenblumenduft"}),
	    "Sie riechen herrlich und glitzern huebsch in der Wiese.");
  
  AddSmell( ({"geruch"}),
	    "Du schnupperst herum und bemerkst, dass die Seifenblasen "
	    "riechen. Fast so wie nach Marshmallows.");
  
  AddSmell( ({"marshmallow","marshmallows"}),
	    "Mhh, waere lecker jetzt eines zu naschen.");
  
  AddSmell( ({"seifenblasen","wiese"}),
	    "Das kannst Du nur untersuchen.");
  
  
  AddSound(DEFAULT_SOUND, "Der Wasserfall plaetschert munter vor sich hin.");
  
  AddSound( ({"wasserfall","plaetschern","plaetschert"}),
	    "Waehrend Du dem Wasserfall lauscht, starrst Du den Strahl an und "
	    "bemerkst Du einen Schatten dahinter.");
  
  AddSound( ({"strahl","schatten"}),
	    "Versuch es mit untersuchen.");
  
  
  //-----Details Ende-----
  
  AddExit("norden",ROOM "wst1");
  AddExit("westen",ROOM "ws6");
  AddExit("osten",ROOM "ws4");
  
  
  AddCmd( ({"fang","fange"}),"cmd_fangen");
  AddCmd( ({"greife","greif"}),"cmd_greifen");
  AddCmd( ({"schwimm","schwimme","plantsch","plantsche"}),"cmd_schwimmen");
  AddCmd( ({"trink","trinke"}),"cmd_trinken");
  AddCmd( ({"pflueck","pfluecke"}),"cmd_blume");

}

int cmd_fangen(string str)
{
  object seifenblase;
  notify_fail("Was willst Du fangen?\n");
  
  if(!(str=="seifenblase"||
       str=="seifenblasen"||
       str=="blase"||
       str=="blasen")) 
    return 0;
  
  if (present("seifenblase",TP))
    {
      write("Du hast ja schon eine Seifenblase.\n" );
      
      say(TPN+" schenkt der gefangenen Seifenblase die Freiheit.\n");
      
      return -1;
    }
  
  seifenblase=clone_object(OBJ "seifenblase");
  if (ME_TOO_HEAVY==seifenblase->move(TP,M_GET))
    {
      write(BS("Die Seifenblase gleitet zu Boden."));
      
      say(BS("Eine Seifenblase gleitet zu Boden."));
      
      seifenblase->move(TO, M_NOCHECK|M_SILENT);
      return 1;
    }
  else
    {
      write(BS("Du faengst flink eine Seifenblase und laesst sie auf Deiner "
	       "Handflaeche tanzen."));
      
      say(BS(TPN+" faengt eine Seifenblase, die "+CAP(TP->QueryPronoun(WER))+" auf der "
	     "Handflaeche tanzen laesst."));
      
      return 1;
    }
}

void reset()	
{
  ::reset();
  greifen=5;
  trinken=1;
  blumenzahl=3;
}

int cmd_greifen(string str)	
{
  notify_fail("Wo willst Du hinein greifen?\n");
  
  if(!(str=="in loch"||
       str=="in loch hinein"||
       str=="in loch rein")) 
    return 0;

  if(TP->QueryProp(P_HP) < 10)
    {
      write(BS("Du bist schon so schwach, dass Du lieber nicht mehr hineingreifst."));
      
      return -1;
    }
  
  write(BS("Du greifst durch den Wasserfall hindurch und ploetzlich zwickt "
	   "Dich etwas. Du schreckst vor Schmerz zurueck und schuettelst einen "
	   "durchsichtigen Krebs herunter, der sich gleich unter einem Stein "
	   "versteckt."));
  say(BS(TPN+" greift durch den Wasserfall und zieht vor Schmerz "
	 +TP->QueryPossPronoun(MALE,WEN,SINGULAR)+" Arm zurueck und etwas Durchsichiges plumpst "
	 "ins Wasser."));
  
  TP->AddHp(-5);
  
  return 1;
}

int cmd_schwimmen(string str)     
{
  notify_fail("Worin willst Du schwimmen?\n");
  
  if(!(str=="in wasser"||
       str=="in becken"||
       str=="in wasserbecken"||
       str=="in brunnen"||
       str=="in wasserfall")) 
    return 0;
  
  write(BS("Du steckst die Zehe in das Wasser und zuckst zurueck. Brrrrrr! "
	  "Das ist Dir doch zu kalt."));
  
  say(BS(TPN+" steckt die Zehe in das Wasser und zuckt zurueck."));
  
  return 1;
}

int cmd_trinken(string str)	
{
  notify_fail("Was willst Du trinken?\n");
  
  if(!(str=="wasser"||
       str=="aus becken"||
       str=="aus wasserbecken"||
       str=="aus nebelbecken"||
       str=="aus springbrunnen"||
       str=="aus brunnen"||
       str=="aus biotop")) 
    return 0;
  
  if(TP->drink_soft(2))
    {
      write(BS("Du tauchst Deine Haende in das kuehle Becken und schluerfst "
	       "etwas Wasser daraus."));
      
      say(BS(TPN+" trinkt etwas Wasser aus dem Becken und fuehlt sich sichtlich "
	     "erfrischt."));
      
      if(trinken<1)
	{
	  return -1;
	}
      
      TP->AddHp(10+random(5));
      trinken--;
      
  return 1;
    }
  else
    {
      return -1;
    }
}

int cmd_blume(string str)
{
  object wolkenblume;
  notify_fail("Was willst Du pfluecken?\n");
  
  if(!(str=="blume"||
       str=="etwas aus bett heraus")) 
    return 0;
  
   
    if(blumenzahl<1)
      {
	write(BS("Du findest keine pflueckbare Blume mehr und musst warten, "
		 "bis schoene Exemplare nachgewachsen sind."));
	
	say(TPN+" seufzt enttaeuscht.\n");
	
	return -1;
      }
    	
	wolkenblume=clone_object(OBJ "wolkenblume");
	if (ME_TOO_HEAVY==wolkenblume->move(TP,M_GET))
	  {
	    write(BS("Du pflueckst Dir eine wunderschoene Blume, laesst sie aber "
		     "gleich fallen. Du haettest lieber vorher Dein Gepaeck "
		     "umsortieren sollen."));
	    
	    say(BS(TPN+" pflueckt eine Blume und laesst diese gleich fallen."));
	    
	    wolkenblume->move(TO, M_NOCHECK|M_SILENT);
	    return 1;
	  }
	
	    write(BS("Du greifst blind in die Wiese und pflueckst Dir die erst "
		     "beste Blume."));
	    
	    say(BS(TPN+" haelt sich mit einer Hand die Augen zu und pflueckt mit "
		   "der anderen blind eine Blume."));
	    blumenzahl--;
	    return 1;
	    
}
