// Raum meines Gesellenstueckes "Park - Wolkenstadt"
inherit "std/room";

#include "../def.h"
#include <moving.h>

#define PARKBANK(wer) (member(parkbank, capitalize(getuid(wer)))!=-1)
#define MyCountUp(arg) (sizeof(arg) > 1 ? \
        implode(arg[0..<2], ", ") + " und " + arg[<1] : \
        (sizeof(arg) == 0 ? "niemand" : arg[0]) )

string *parkbank=({});

int trinken=1;
int blumenzahl=3;

void create()
{
  ::create();
  
  
  SetProp(P_INT_SHORT, "Im Park der Wolkenstadt");
  SetProp(P_INT_LONG,
	  "Du stehst vor einem Nebelbecken, das idyllisch zwischen den "
	  "Bueschen liegt. Nebelschwaden ziehen sich vom Becken ueber die "
	  "Wiese. Ein bisschen unheimlich wirkt es schon, weil der Nebel "
	  "irgendwie alles zu verschlucken scheint. Vor dem Becken faellt Dir "
	  "noch eine Parkbank auf.");
  
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);
  
  //-----Details Anfang-----
  
  AddDetail( ({"cute","marrogh","maghnar","niri","gaya","zidane","nyx","wumanzu",
	       "elrohir","velkyn","took","aroobah","methos","katarok"}),
	      "Ja, dieser Spieler hat mir geholfen, dass dieses Gebiet noch besser "
	      "und schoener wird.");

  AddDetail( ({"nebelbecken","becken"}),
	     "Du erkennst das Becken selbst eigentlich gar nicht. Nur die "
	     "die auf den Boden gleitenden Nebelschwaden. Der Anblick "
	     "fesselt Dich.");
  
  AddDetail( ({"bueschen","buesche"}),
	     "Sie grenzen die Wiese ein und sind kraeftig gewachsen.");
  
  AddDetail( ({"nebelschwaden","schwaden"}),
	     "Der Nebel liegt dick auf dem Becken, wie eine Bettdecke. Die "
	     "ueberschuessigen Nebelschwaden gleiten sanft ueber die "
	     "Beckenkante und zerstreuen sich in der Wiese.");
  
  AddDetail( ({"nebel"}),
	     "Der Nebel ist weiss bis grau und liegt dick auf dem Wasser, "
	     "das Du unterhalb murmeln hoerst. Du koenntest den Nebel ja "
	     "auseinander blasen.");
  
  AddDetail( ({"wasser"}),
	     "Du kannst das Wasser nicht sehen, da der Nebel so dick drauf "
	     "liegt.");
  
  AddDetail( ({"bettdecke","decke"}),
	     "Sie ladet eigentlich zum hineinkuscheln ein. Du stellst es Dir "
	     "kuschelig weich vor. Mhhh, zum hineintraeumen!");
  
  AddDetail( ({"beckenkante","kante"}),
	     "Ab der Kante gleiten die Nebelschwaden herunter und loesen sich "
	     "nach einer Weile auf.");
  
  AddDetail( ({"weile"}),
	     "Es beruhigt, wenn man dem Spiel eine Weile zusieht.");
  
  AddDetail( ({"spiel","anblick"}),
	     "Du kannst nicht aufhoeren hinzustarren. Es zieht Dich in den "
	     "Bann.");
  
  AddSpecialDetail( ({"bann"}),"bann");
  
  AddDetail( ({"fee"}),
	     "Du erkennst sie immer noch schwach im Nebel. Sie ist total "
	     "entzueckend und verfuehrerisch, aber unnahbar.");
  
  AddDetail( ({"gesang"}),
	     "Lausche ihm, aber ob es Dir wirklich gut tut?");
  
  AddDetail( ({"anlauf"}),
	     "Gottseidank hast Du den Anlauf nicht gewagt, obwohl ... Mhh, ob "
	     "Du Dich doch in den Nebel hineinkuscheln sollst?");
  
  AddDetail( ({"wiese"}),
	     "Die Wiese ist, wie im ganzen Park, gruen. Das kristallartige "
	     "Glitzern der Wiese beeindruckt Dich immer noch.");
  
  AddDetail( ({"park"}),
	     "Du stehst hier im Park vor dem Nebelbecken und dieser ist von "
	     "Blumen erfuellt.");
  
  AddDetail( ({"blumen","wolkenblumen"}),
	     "Viele verschiedene Blumen verzieren die Wiese.");
  
  AddDetail( ({"glitzern"}),
	     "Es schimmert und funkelt in der Sonne.");
  
  AddDetail( ({"sonne"}),
	     "Das Nebelbecken wirkt durch die Sonne idyllisch und freundlich, "
	     "ansonsten waere es hier unheimlich.");
  
  AddSpecialDetail( ({"parkbank","bank"}),"parkbank");
  
  AddDetail( ({"glas"}),
	     "Ob es Dein Gewicht aushaelt?");
  
  AddDetail( ({"gewicht"}),
	     "Du denkst Dir: Ich bin eh so ein Fliegengewicht, die Parkbank "
	     "haelt mich schon aus!");
  
  AddDetail( ({"fliegengewicht"}),
	     "Ob Du wirklich so leicht bist? Du uebertreibst doch ein wenig.");
  
  AddDetail( ({"sitzflaeche","flaeche","rueckenlehne","lehne"}),
	     "Es besteht aus Glas. Du wuerdest Dich gerne ein wenig "
	     "ausrasten, indem Du Dich auf die Parkbank setzt.");
  
  AddDetail( ({"boden"}),
	     "Du stehst auf der Wiese mitten im Park. Sie ist bunt gefleckt "
	     "von lauter Blumen.");
  
  AddDetail( ({"himmel"}),
	     "Der Himmel ist strahlend blau und wolkenlos. Du erkennst neben "
	     "dem Regenbogen auch noch Puenktchen am Himmel.");
  
  AddDetail( ({"regenbogen","bogen"}),
	     "Ein bunter Regenbogen.");
  
  AddDetail( ({"puenktchen"}),
	     "Sieht aus wie ein Pegataur.");
  
  AddDetail( ({"pegataur"}),
	     "Er duerfte hier oben leben.");
  
  AddDetail( ({"rueckseite"}),
	     "Tatsaechlich, da ist feinst Etwas eingraviert worden.");
  
  AddDetail( ({"etwas"}),
	     "Du streichst mit den Fingern drueber und es ist wirklich eine "
	     "Gravur.");
  
  AddDetail( ({"fingern","finger"}),
	     "Du hast mit ihnen eben ueber die Gravur gestrichen.");
  
  AddDetail( ({"gravur"}),
	     "Du koenntest ja versuchen sie zu lesen.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	     "Du denkst Dir: Ich gehoere nur miiiiiir! und setzt einen wilden "
	     "Blick auf.");
  
  AddDetail( ({"blick"}),
	     "Er ist furchteinfloessend.");
  
  AddDetail( ({"regenbogenfarben","farben"}),
	     "Du siehst sie nicht mehr, der Nebel hat sie verschluckt.");
  
  AddDetail( ({"anlauf"}),
	     "Hast Du noch immer nicht genug?");
  
  AddDetail( ({"morgensonne"}),
	     "Mhh, was hat die Morgensonne wohl mit dem Regenbogen zu tun?");
  
  AddDetail( ({"regenbogen","bogen"}),
	     "Was ist markant am Regenbogen?");
  
  AddDetail( ({"weg"}),
	     "Der Weg ist sicher sehr nah.");
  
  AddDetail( ({"nebelwogen","wogen"}),
	     "Eine neue Welt vielleicht. Klingt aber unheimlich.");
  
  AddDetail( ({"welt"}),
	     "Eine ganz neue Welt sicher. Anders als hier?");
  
  
  AddSmell(DEFAULT_SMELL, "Du riechst nur den Duft der Wolkenblumen.");
  
  AddSmell( ({"blumenduft","blumen","duft","wolkenblumen","wolkenblumenduft"}),
	    "Sie riechen herrlich und glitzern huebsch in der Wiese.");
  
  AddSmell( ({"wiese"}),
	    "Du riechst den Duft der Blumen aus der Wiese.");
  
  
  AddSound(DEFAULT_SOUND, "Du kannst nur ein leises Murmeln hoeren, das von "
	   "Wasser sein koennte.");
  
  AddSound( ({"gesang"}),
	    "Jetzt kannst Du den lieblichen Gesang erst hoeren. Es ist eine "
	    "klare Stimme.");
  
  AddSound( ({"stimme"}),
	    "Es ist eine suesse, helle Stimme. Sie zieht Dich in ihren Bann.");
  
  AddSound( ({"bann"}),
	    "So sehr Du auch von dem Gesang fasziniert bist, den Bann kannst "
	    "Du nur untersuchen.");
  
  AddSound( ({"murmeln","wasser"}),
	    "Das Murmeln kommt wirklich vom Wasser. Der Nebel duerfte es "
	    "verdeckt haben.");
  
  AddSound( ({"nebel"}),
	    "Den Nebel kann man nur untersuchen, da er ganz still ist.");
  
  
  AddReadDetail("gravur",
		"Beginnst Du bei der Morgensonne am Regenbogen,\nerscheint "
		"Dir ein Weg in die Nebelwogen.");

  //-----Details Ende-----
  
  AddExit("norden",ROOM "ws2");
  AddExit("westen",ROOM "wst1");
  AddExit("sueden",ROOM "ws4");
  
  
  AddCmd( ({"kuschel","kuschle","spring","springe","huepf","huepfe"}), "cmd_kuscheln");
  AddCmd( ({"blas","blase","pust","puste"}), "cmd_blasen");
  AddCmd( ({"setze","setz","sitze","sitz"}), "cmd_sitzen");
  AddCmd( ({"stehe","steh"}), "cmd_aufstehen");
  AddCmd( ({"norden","n","westen","w","sueden","s","goto","home"}), "cmd_richtung");
  AddCmd( ({"schwimm","schwimme","plantsch","plantsche"}), "cmd_schwimmen");
  AddCmd( ({"trink","trinke"}),"cmd_trinken");
  AddCmd( ({"pflueck","pfluecke"}),"cmd_blume");

}

string bann()    
{
  TP->SetProp(P_PARALYZED, ([
			     PARALYZE_TIME: 10,
			     PARALYZE_MSG: "Du starrst ganz hypnotisiert auf die Fee.\n",
			     PARALYZE_MSG_OTHER: "%s starrt gebannt in den Nebel.\n",
			     PARALYZE_END: "Du nimmst schon Anlauf und willst hineinspringen, "
			     "doch ploetzlich \nreisst Du Dich vom Bann los und stoppst ab.\n",
			     PARALYZE_END_OTHER: "%s ist wie erstarrt, kommt aber langsam zu sich.\n"
			     ]));	
  
  call_out("fall1",4);      
  return(BS("Du starrst wie hypnotisiert in die Nebelschwaden. Eine "
	    "schoene, kleine Fee aus Nebel bildet sich."));
}

void fall1()
{
  
  if(!TP) return;
  if(ENV(TP)!=TO) return;
  
  write(BS("Sie faengt an sich ein wenig zu wiegen und zu tanzen. Sie lockt "
	   "Dich mit ihrem Gesang in den Nebel hineinzukuscheln."));
  call_out("fall2",3);
}

void fall2()
{
  
  if(!TP) return;
  if(ENV(TP)!=TO) return;
  
  write(BS("Du kannst der kleinen, huebschen Nebelfee nicht widerstehen. Ihr "
	   "Bann hat Dich fest im Griff. Ihr Gesang laesst Dich willenlos "
	   "werden."));
}

int cmd_kuscheln(string str)
{
  notify_fail("Wo willst Du Dich hineinkuscheln?\n");
  
  if(!(str=="in nebel"||
       str=="in nebelschwaden"||
       str=="in bettdecke"||
       str=="in decke"||
       str=="in nebel hinein"||
       str=="in nebelschwaden hinein"||
       str=="in bettdecke hinein"||
       str=="in decke hinein")) 
    return 0;
  
  if(TP->QueryProp(P_HP) < 10)
    {
      write(BS("Du laesst es lieber, denn Du koentest Dir jetzt wirklich weh tun!"));
      
      return -1;
    }
  
  write(BS("Du wagst es wirklich und springst voller Freude in die "
	   "Nebelschwaden. Im Flug streckst Du laechelnd Deine Arme der Fee "
	   "entgegen und platscht mit voller Wucht auf dem Wasser auf. Vor "
	   "Schmerzen gekruemmt kriechst Du aus dem seichten Wasser."));
  
  say(BS(TPN+" springt voller Freude mit ausgestreckten Armen in die "
	 "Nebelschwaden und platscht auf dem Wasser auf."
	 " "+CAP(TP->QueryPronoun(WER))+" kriecht vor Schmerzen gekruemmt aus dem "
	 "Wasser."));
  
  TP->AddHp(-5);
  
  return 1;
}

int cmd_blasen(string str)   
{
  
  notify_fail("Was willst Du auseinander blasen?\n");
  
  if(!(str==" nebel"||
       str=="nebel auseinander")) 
    return 0;
  
  write(BS("Du blaest vorsichtig die Nebelschwaden auseinander und erkennst "
	   "kurz das klare, flache Wasser. Es sprudelt ein wenig und glitzert "
	   "in Regenbogenfarben, als sich schon wieder der Nebel ueber das "
	   "Wasser legt."));
  
  say(BS(TPN+" blaest die Nebelschwaden auseinander und wagt einen Blick "
	 "darunter."));
  
  return 1;
}

//---------------------------------------------------------------------------

int cmd_sitzen(string str)
     
{
  notify_fail(BS("Worauf willst Du Dich setzen?"));
  if(!(str == "auf parkbank"||
       str == "auf bank"||
       str == "nieder"||
       str == "hin"))
    {
      return 0;
    }
  if(PARKBANK(TP))
    {
      write(BS("Du sitzt doch schon auf der Parkbank!"));
      return 1;
    }
  if(sizeof(parkbank)>=2)
    {
      write(BS("Es ist kein Platz mehr auf der Parkbank."));
      return 1;
    }
  write(BS("Du setzt Dich auf die Parkbank um Dich ein wenig "
	   "auszurasten."));
  tell_room(ENV(TP), TPN+" setzt sich auf eine Parkbank.\n", ({TP}));
  parkbank += ({ capitalize(getuid(TP)) });
  return 1;
}

int cmd_richtung(string str)
{
  if(PARKBANK(TP))
    {
      write(BS("Wenn Du noch sitzt, kannst Du nicht dorthin gelangen!"));
      return 1;
    }
}

int cmd_aufstehen(string str)
{
  notify_fail(BS("Du willst AUFstehen?\n"));
  if(str == "auf")
    {
      if(PARKBANK(TP))
	{
	  write(BS("Du erhebst Dich seufzend von der Parkbank. Es war so "
		   "bequem."));
	  tell_room(ENV(TP), TPN+" erhebt sich traurig von der Parkbank.\n", ({TP}));
	  parkbank -= ({ capitalize(getuid(TP)) });
	  return 1;
	}
    }      
  return 0;
}

void BecomesNetDead(object spieler)
{
  if(PARKBANK(spieler))
    parkbank -= ({ capitalize(getuid(spieler)) });
  
}

string parkbank()
{
  string parkbankinfo;
  if(PARKBANK(TP))
    {
      parkbankinfo =
	"Du sitzt auf einer Parkbank. "+
	"Waehrend Du es Dir so gemuetlich machst, entdeckst Du auf der "
	"Rueckseite der Rueckenlehne eine Gravur.";
    }
  else
    {
      parkbankinfo =
	"Sie besteht aus filigranem, geschwungenem Glas. Selbst die "
	"Sitzflaeche und Rueckenlehne bestehen aus Glas.";
      if(sizeof(parkbank)==1 )
	parkbankinfo += " Du siehst gerade " + parkbank[0] + " auf der "
	  "Parkbank sitzen.";
      
      if(sizeof(parkbank)>1 )
	parkbankinfo += " Im Moment kuscheln " + MyCountUp(parkbank) + " auf der "
	  "Parkbank zusammen.";
    }
  return break_string(parkbankinfo, 78);
}

int cmd_schwimmen(string str)     
{
  notify_fail("Worin willst Du schwimmen?\n");
  
  if(!(str=="in wasser"||
       str=="in becken"||
       str=="in wasserbecken"||
       str=="in nebelbecken")) 
    return 0;
  
  write(BS("Du steckst die Zehe in das Wasser und zuckst zurueck. Brrrrrr! "
	  "Das ist Dir doch zu kalt."));
  
  say(BS(TPN+" steckt die Zehe in das Wasser und zuckt zurueck."));
  
  return 1;
}

void reset()	
{
  ::reset();
  trinken=1;
  blumenzahl=3;
}

int cmd_trinken(string str)	
{
  notify_fail("Was willst Du trinken?\n");
  
  if(!(str=="wasser"||
       str=="aus becken"||
       str=="aus wasserbecken"||
       str=="aus nebelbecken"||
       str=="aus springbrunnen"||
       str=="aus brunnen"||
       str=="aus biotop")) 
    return 0;
  
  if(TP->drink_soft(2))
    {
      write(BS("Du tauchst Deine Haende in das kuehle Becken und schluerfst "
	       "etwas Wasser daraus."));
      
      say(BS(TPN+" trinkt etwas Wasser aus dem Becken und fuehlt sich sichtlich "
	     "erfrischt."));
      
      if(trinken<1)
	{
	  return -1;
	}
      
      TP->AddHp(10+random(5));
      trinken--;
      
  return 1;
    }
  else
    {
      return -1;
    }
}

int cmd_blume(string str)
{
  object wolkenblume;
  notify_fail("Was willst Du pfluecken?\n");
  
  if(!(str=="blume"||
       str=="etwas aus bett heraus")) 
    return 0;
  
   
    if(blumenzahl<1)
      {
	write(BS("Du findest keine pflueckbare Blume mehr und musst warten, "
		 "bis schoene Exemplare nachgewachsen sind."));
	
	say(TPN+" seufzt enttaeuscht.\n");
	
	return -1;
      }
    	
	wolkenblume=clone_object(OBJ "wolkenblume");
	if (ME_TOO_HEAVY==wolkenblume->move(TP,M_GET))
	  {
	    write(BS("Du pflueckst Dir eine wunderschoene Blume, laesst sie aber "
		     "gleich fallen. Du haettest lieber vorher Dein Gepaeck "
		     "umsortieren sollen."));
	    
	    say(BS(TPN+" pflueckt eine Blume und laesst diese gleich fallen."));
	    
	    wolkenblume->move(TO, M_NOCHECK|M_SILENT);
	    return 1;
	  }
	
	    write(BS("Du greifst blind in die Wiese und pflueckst Dir die erst "
		     "beste Blume."));
	    
	    say(BS(TPN+" haelt sich mit einer Hand die Augen zu und pflueckt mit "
		   "der anderen blind eine Blume."));
	    blumenzahl--;
	    return 1;
	    
}
