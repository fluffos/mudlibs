  AddDetail( ({"rohr"}),
	     "Ein rundes, hohles Rohr aus dem Wasser fliesst.");
  
  AddDetail( ({"sonne"}),
	     "Die Sonne laechelt sanft herunter.");
  
  AddDetail( ({"glas"}),
	     "Es ist transparent, milchig oder uneben und spiegelt das "
	     "Sonnenlicht wieder und alles wird erleuchtet und funkelt.");
  
  AddDetail( ({"sonnenlicht","licht"}),
	     "Das Sonnenlicht strahlt auf alles ein, das aus Glas besteht "
	     "und wird in allen Farben zurueck reflektiert.");
  
  AddDetail( ({"turm"}),
	     "Der Turm im Park besteht aus vielen Schlingpflanzen, die das "
	     "runde Grundgeruest einrahmen. Die rosa Glaskuppel passt "
	     "sich oberhalb farblich wunderschoen an den Turm an.");
  
  AddDetail( ({"schlingpflanzen","pflanzen"}),
	     "Sie schimmern gruen-weisslich in der Ferne.");
  
  AddDetail( ({"geruest","grundgeruest"}),
	     "Ja, sie bilden zum Teil die Wand mit Wolkensteinen und auch die "
	     "Saeulen in den oberen Stockwerken.");
  
  AddDetail( ({"teil"}),
	     "Das heisst, nicht alles.");
  
  AddDetail( ({"wand"}),
	     "Manches besteht aus Wolkensteinen und manches aus den "
	     "Schlingpflanzen.");
  
  AddDetail( ({"saeule","saeulen"}),
	     "Es sind genau vier und dazwischen ist nur Luft, kein Glas oder "
	     "Wolkensteine.");
  
  AddDetail( ({"stockwerke","stockwerken"}),
	     "Es sind vier Stockwerke. Der letzte ist die Glaskuppel, die auf "
	     "der Turmspitze thront.");
  
  AddDetail( ({"turmspitze","spitze"}),
	     "Es ist eigentlich keine Turmspitze, sondern eher eine Kuppel.");
  
  AddDetail( ({"ferne"}),
	     "In der Ferne siehst Du den Turm mit seiner Glaskuppel und den "
	     "Palast glitzern und schimmern.");
  
  AddDetail( ({"glaskuppel","kuppel"}),
	     "Wer da wohl oben wohnen mag? Irgendwie bist Du neidisch, weil "
	     "es herrlich sein muss, so weit oben zu wohnen.");
  
  AddDetail( ({"parks","park"}),
	     "Buesche, Blumen zieren den Wasserfall. Ueber den Park gelangst "
	     "Du zum Turm, aber bestimmt nicht ueber diesen Weg.");
  
  AddDetail( ({"buesche","bueschen","blumen"}),
	     "Die Buesche zaeunen den Park ein und die Blumen gedeihen in "
	     "allen Farben.");
  
  AddDetail( ({"weg"}),
	     "Wohin Dich Dein Weg wohl leiten mag?");
  
  AddDetail( ({"boden"}),
	     "Der Boden ist von wattigen Wolkensteinen gesaeumt. Du sinkst "
	     "beim Gehen immer ein wenig ein. Das animiert Dich doch glatt "
	     "zum springen.");
  
  AddDetail( ({"wolkensteine","wolkensteinen","steine","steinen"}),
	     "Sie bestehen aus Wolken, wie fast alles hier.");

  AddDetail( ({"gehen"}),
	     "Ach, ist das herrlich. Du summst vor Dich hin.");
  
  AddDetail( ({"himmel"}),
	     "Der Himmel ist strahlend blau und wird von einer Sonne und "
	     "einem Regenbogen geziert.");
  
  AddDetail( ({"Palast"}),
	     "Er funkelt im Sonnenlicht in der Ferne.");
  
  AddDetail( ({"fels","felsen"}),
	     "Er ist graeulich und besteht anscheinend aus Wolken.");
  
  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	     "Du tippst auf Dich selbst und reckst Dich stolz in die Hoehe, "
	     "damit Dich jeder sieht.");
  
  AddDetail( ({"hoehe"}),
	     "Das ist schon so hoch, da muss Dich doch jeder sehen.");
  
  AddDetail( ({"marshmallow","marshmallows"}),
	     "Mhh, waere lecker jetzt eines zu naschen.");
  
  AddDetail( ({"nase"}),
	     "Ja wo hast Du sie denn versteckt? ;-)");
  
  AddDetail( ({"kraft"}),
	     "Die Buesche wirken auch kraftvoll.");
  
  AddDetail( ({"plaetschern"}),
	     "Du koenntest es mit lauschen versuchen?");
  
  AddDetail( ({"rauschen","wind","windes"}),
	     "Der Wind rauscht sanft ueber den Platz - Fast nur wie ein "
	     "fluestern.");
  
  AddDetail( ({"duft","duefte"}),
	     "Versuch es mal mit riechen. Noch niemand konnte einen Duft "
	     "untersuchen.");
  
  
  AddSmell(DEFAULT_SMELL, "Du riechst verschiedene Duefte.");  
  
  AddSmell( ({"duefte","duft"}),
	    "Alles moegliche steigt Dir in die Nase. Blumen, das Gruen von "
	    "den Bueschen und ein leicht suesslicher Duft."); 
  
  AddSmell( ({"blumen","blume"}),
	    "Sie duften frisch und suess.");
  
  AddSmell( ({"buesche","bueschen","gruen"}),
	    "Es riecht frisch und Kraft spendend.");
  
  AddSmell( ({"duft"}),
	    "Du schnupperst herum und bemerkst, dass die Seifenblasen so "
	    "riechen. Fast so wie nach Marshmallows.");
  
  AddSmell( ({"marshmallow","marshmallows"}),
	    "Mhh, waere lecker jetzt eines zu naschen.");
  
  AddSmell( ({"nase","seifenblasen","kraft"}),
	    "Das kannst Du nur untersuchen.");
  
  
  AddSound(DEFAULT_SOUND, "Es ist absolut still, bis auf das Plaetschern des "
	   "Wassers und das Rauschen des Windes.");
  
  AddSound( ({"wind","rauschen","windes"}),
	    "Fast haette er Dich magisch verfuehrt, ihm zu folgen!!");
  
  AddSound( ({"plaetschern","wasser","wassers"}),
	    "*plitschplatsch*");
  
  AddSound( ({"fluestern"}),
	    "Er versucht Dir etwas zu sagen, aber Du verstehst es kaum.");
  
  //-----Details Ende-----
  
  AddItem(NPC "sylphe", REFRESH_DESTRUCT);
  AddItem(NPC "sylphe", REFRESH_DESTRUCT);
  
  AddExit("nordosten",ROOM "ws4");
  AddExit("nordwesten",ROOM "ws6");
  AddExit("sueden", "/d/luft/gwenshara/musen/room/park1");
  AddExit("norden", "/d/luft/gwenshara/regenbogen/room/rb1");
  
  AddCmd( ({"trink","trinke"}),"cmd_trinken");
  AddCmd( ({"tipp","tippe"}),"cmd_tippen");
  AddCmd( ({"beruehre","beruehr","fuehle","fuehle","greife","greif"}),"cmd_fels");
  
}

void reset()	
{
  ::reset();
  trinken=1;
}

int cmd_trinken(string str)	
{
  notify_fail("Was willst Du trinken?\n");
  
  if(!(str=="wasser"||
       str=="wasser aus hahn"||
       str=="wasser aus wasserhahn"||
       str=="wasser aus becken"||
       str=="wasser aus wasserbecken")) 
    return 0;
  
  if(TP->drink_soft(5))
    {
      write(BS("Du tauchst Deine Haende in das kuehle Becken und schluerfst "
	       "etwas Wasser daraus."));
      
      say(BS(TPN+" trinkt etwas Wasser aus dem Becken und fuehlt sich sichtlich "
	     "erfrischt."));
      
      if(trinken<1)
	{
	  return -1;
	}
      
      TP->AddHp(10+random(5));
      trinken--;
      
  return 1;
    }
  else
    {
      return -1;
    }
}

int cmd_tippen(string str)     
{
  notify_fail("Worauf willst Du tippen?\n");
  
  if(!(str=="brust"||
       str=="auf brust")) 
    return 0;
  
  write(BS("Du tippst mit dem Finger stolz auf Deine Brust, weil Du Du "
	   "bist."));
  
  say(BS(TPN+" tippt sich stolz auf die eigene Brust. Du hast keine Ahnung "
	 "warum "+TP->QueryPronoun(WER)+" das tut."));
  
  return 1;
}

int cmd_fels(string str)
{
  
  notify_fail("Was moechtest Du beruehren?\n");
  
  if(!(str=="fels"||
       str=="felsen"||
       str=="felsgestein")) 
    return 0;
  
  write(BS("Du streckst Deine Hand in Richtung Felsen aus und fuehlst das "
	   "kuehle und weiche Wolkengestein. Du analysierst ein bisschen "
	   "Wolkenmasse zwischen Deinen Fingern und stellst fest, dass sie "
	   "sehr feucht ist."));
  
  say(BS(TPN+" beruehrt den Felsen."));
  
  return 1;
}

void init()
{
  ::init();

  if((TP) && (interactive(TP)))
    call_other(HLB_ARRA, "???");
}
