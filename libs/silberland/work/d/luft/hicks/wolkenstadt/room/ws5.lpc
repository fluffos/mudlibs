  AddDetail( ({"ton","toene","toenen"}),
	     "Ein traumhaft schoener Anblick, so wie alles schimmert.");
  
  AddDetail( ({"anblick"}),
	     "Ein schoener Anblick bei all den Seifenblasen.");
  
  AddDetail( ({"regenbogen","regenbogens","bogen"}),
	     "Uber Dir zieht sich ein Regenbogen in allen Farben ueber der "
