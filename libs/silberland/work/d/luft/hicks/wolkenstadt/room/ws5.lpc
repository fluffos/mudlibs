// Raum meines Gesellenstueckes "Suedplatz - Wolkenstadt"

inherit "std/room";

#include "../def.h"

#define PREIS 100
#define HLB_ARRA "/d/wueste/protheg/arrakeen/room/ara_2_4_0"

int trinken=1;

void create()
     
{
  ::create();
  

  SetProp(P_INT_SHORT, "Suedplatz in der Wolkenstadt");
  SetProp(P_INT_LONG,
	  "Du befindest Dich auf dem Suedplatz von Liliandor. Ueberall in der "
	  "Luft schweben regenbogenfarbene Seifenblasen herum. Der Ursprung "
	  "duerfte wohl hinter dem Felsen im Park liegen. Ein kleines Becken "
	  "ragt aus dem Felsen hervor, in das Wasser ueber einen kleinen "
	  "geschwungenen Hahn fliesst. Eine kurze Holztreppe steht hier herum."
	  " Weiters ist der filigrane Turm mit einer Glaskuppel unuebersehbar "
	  "und weiter hinten erblickt man noch den Palast. Suedlich von hier "
	  "kannst du durch ein goldenes Tor den Weg zu einem Huegel betreten, "
	  "auf dessen Gipfel du ein Gebaeude erkennst" );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);
  
  //-----Details Anfang-----

  AddDetail( ({"tor", "gold tor", "goldenes tor"}),
    "Das Tor wurde aus goldenen Gitterstaeben gefertigt und steht offen.");

  AddDetail( ({"staebe", "goldstaebe", "gitterstaebe", "gitterstaeben"}),
    "Sie sind golden, und da das Tor stehts weit offen steht, scheint es "
    "eher dekarativ als nuetzlich zu sein.");

  AddDetail( ({"huegel", "gipfel"}),
    "Suedlich von dir erkennst du einen Huegel, der sich aus den Wolken erhebt. "
    "Ein einzelnes Gebaeude steht auf seinem Gipfel.");

  AddDetail( ({"gebaeude"}),
    "Von hier aus schwer zu sagen worum es sich handelt.");
  
  AddDetail(({"treppe","holztreppe"}),
	    "Eine kurze Holztreppe steht hier herum. Wofuer sie wohl "
	    "gebraucht wird? Ein hoelzernes Schild ist daran befestigt.");
  
  AddDetail(({"schild","holzschild","hoelzernes schild"}),
	    "Da steht was drauf!");
  
  AddReadDetail(({"schild","holzschild","treppenschild","treppenholzschild",
		      "plan","fahrplan"}),
"    _______________________________________________________________________\n"
"  /                                                                      / \\\n"
" |              Wagen Sie eine Fahrt mit dem Heissluftballon!           | O |\n"
" |             -----------------------------------------------          |\\_/\n"
" |                                                                      |\n"
" |    Kommen  Sie und erholen  sie sich bei  einer Reise mit  unserem   |\n"
" |    wunderbaren Heissluftballon. Geniessen Sie die ueberwaeltigende   |\n"
" |    Aussicht und lassen Sie sich den  heissen Wuestenwind durch die   |\n"
" |    Haare wehen...                                                    |\n"
" |                                                                      |\n"
" |    Eine Ueberfahrt kostet nur "+PREIS+" Muenzen.                           |__\n"
" |                                                                      |/ \\\n"
" |                                                  Ihre Reiseleitung   | O |\n"
"  \\                                                                      \\ /\n"
"   `----------------------------------------------------------------------'\n");
  
  AddDetail( ({"cute","marrogh","maghnar","niri","gaya","zidane","nyx","wumanzu",
	       "elrohir","velkyn","took","aroobah","methos","katarok"}),
	      "Ja, dieser Spieler hat mir geholfen, dass dieses Gebiet noch besser "
	      "und schoener wird.");
  
  AddDetail( ({"suedplatz","platz"}), 
	     "Du befindest Dich auf dem Suedplatz von Liliandor. Ueberall in "
	     "der Luft schweben regenbogenfarbene Seifenblasen herum. Der "
	     "Ursprung duerfte wohl hinter dem Felsen im Park liegen. Ein "
	     "kleines Becken ragt aus dem Felsen hervor, in das Wasser ueber "
	     "einen kleinen geschwungenen Hahn fliesst. Weiters ist der "
	     "filigrane Turm mit einer Glaskuppel unuebersehbar und weiter "
	     "hinten erblickt man noch den Palast." );
  
  AddDetail( ({"liliandor"}),
	     "Liliandor ist die hellste und glitzerndste Stadt, die Du je "
	     "gesehen hast. Du fuehlst Dich so frei auf den Wolken.");
  
  AddDetail( ({"stadt","wolkenstadt"}),
	     "Sie hat Dich fuer sich eingenommen, und Du moechtest nie wieder "
	     "weg von hier.");
  
  AddDetail( ({"wolke","wolken"}),
	     "Sie bestehen aus feuchter Luft.");
  
  AddDetail( ({"farben","pastellfarben","farbe"}),
	     "Das sind alle moeglichen Farben des Regenbogens. Rot, Orange, "
	     "Gelb, Gruen, Blau, Violett.");
  
  AddDetail( ({"gelb","orange","rot","violett","blau","gruen"}),
	     "Alle Farben in allen Toenen. Du laesst Dich ein wenig davon "
