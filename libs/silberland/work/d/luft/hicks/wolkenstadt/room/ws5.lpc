  AddDetail( ({"wasserfall"}),
	     "Er plaetschert ruhig vor sich hin. Ein lauschiges Plaetzchen.");
  
  AddDetail( ({"plaetzchen"}),
	     "Meinst Du nicht einen Keks?");
  
  AddDetail( ({"keks"}),
	     "Warum musst Du nur immer ans Essen denken?");
  
  AddDetail( ({"essen"}),
	     "Vielleicht findest Du hier eine Taverne oder einen "
	     "Suesswarenladen?");
  
  AddDetail( ({"taverne","suesswarenladen","warenladen","laden"}),
	     "Du solltest Dich auf die Suche begeben. Wenn Du hier herum "
	     "stehst, dann findest Du sicher nichts.");
  
  AddDetail( ({"suche"}),
	     "Wer suchet, der findet!");
  
  AddDetail( ({"becken","trinkbecken","wasserbecken"}),
	     "Es ist ein Wasserbecken, dass sich aus dem Felsen heraus "
