  AddDetail( ({"massageoel","oel","koerper"}),
	     "Du bist versucht Deinen Koerper ein zu oelen.");
  
  AddDetail( ({"wandseite","seite"}),
	     "Meinst Du die rechte oder die linke Wandseite?");
  
  AddDetail( ({"rechte wandseite","rechte seite"}),
	     "An dieser Wandseite haengen viele Bilder.");
  
  AddDetail( ({"linke wandseite","linke seite"}),
	     "An der linken Seite stehen ein Schminktisch und ein Schrank.");
  
  AddDetail( ({"schrank"}), #'cupboard);
  
  AddDetail( ({"kleidungsstuecke","stuecke","prachtgewaender","gewaender"}), 
