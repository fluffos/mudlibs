  AddDetail( ({"mitte"}),
	     "Da wurde das Bild mit dem Herzrahmen aufgehaengt.");
  
  AddDetail( ({"bild","rahmen"}),
	     "Welches Bild willst Du Dir ansehen? Du kannst das Bild mit dem "
