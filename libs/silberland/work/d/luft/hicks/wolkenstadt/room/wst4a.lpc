  AddDetail( ({"buxtehude","undzack","icy","canziora","nemesis","atlas","legolas",
		 "andronicus","gwenshara","angrox","lamuerte","lamyra","aradia",
		 "niri","zidane","xarfai","nessa","flak","wompf","woody",
		 "turgon","methos","kolmey"}),
	     "Das sind alles Hiris Freunde.");
  
  AddDetail( ({"freunde"}),
	     "Sie haben dieses Bild Hiri gemeinsam zu ihrer "
	     "Vollmagierernennung geschenkt.");
  
  AddDetail( ({"vollmagierernennung","magierernennung","ernennung"}),
	     "Seitdem darf Hiri Kinder haben und ihnen zaubern beibringen.");
  
  AddDetail( ({"diwan"}),
	     "Der Diwan ist rosa. Er ist voll bestueckt mit lauter "
	     "Plueschhaeschen.");
  
  AddDetail( ({"plueschhaeschen","haeschen","nekrofellhaeschen"}),
