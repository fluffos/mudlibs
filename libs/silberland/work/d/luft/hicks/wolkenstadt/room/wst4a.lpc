  AddDetail( ({"bild mit rotem herzrahmen","herzrahmen","roten herzrahmen",
		 "bild mit herzrahmen"}),
	     "Das duerfte das Hochzeitsfoto von Hiri und Elrohir sein.");
  
  AddDetail( ({"hochzeitsfoto","foto"}),
	     "Das Brautpaar sieht so gluecklich aus.");
  
  AddDetail( ({"brautpaar","paar"}),
	     "Als Du das Brautpaar so beaeugst, bemerkst Du einen dunklen "
