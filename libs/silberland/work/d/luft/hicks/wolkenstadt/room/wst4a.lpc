  AddDetail( ({"elrohir","ehemann"}),
	     "Elrohir ist Hiris Ehemann. Er liebt sie sehr.");
  
  AddDetail( ({"hiri","hiris"}),
	     "Du bemerkst schon, alles dreht sich hier um Hiri. Das ist "
