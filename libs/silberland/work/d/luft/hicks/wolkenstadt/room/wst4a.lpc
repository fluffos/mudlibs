int cmd_blicken(string str)	
{
  notify_fail("Wo willst Du hinaus blicken?\n");
  
  if(!(str=="aus balkon"||
       str=="hinaus"||
       str=="aus fenster")) 
    return 0;
  
  write(BS("Du geniesst den Ausblick. Doch, halt... Da ist jemand unten im "
	   "Park. Du winkst diesem Jemand wild zu. Dieser Jemand hat Dich "
	   "entdeckt und winkt Dir zurueck. Du denkst Dir: Es gibt immer noch "
	   "freundliche Lebewesen."));
  
  say(BS(TPN+" winkt aus dem Balkon."));
  
  return 1;
}
