  AddDetail( ({"jarel","orw","moira"}),
	     "Das sind alles Hiris Tanten und Onkeln.");
  
  AddDetail( ({"tanten","onkeln","geschwister"}),
	     "Sie haben alle Hiri lieb.");
  
  AddDetail( ({"bild mit hellrosa rahmen","hellrosa rahmen",
