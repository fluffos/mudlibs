// Raum meines Gesellenstueckes "Turm1 - Wolkenstadt"

inherit "std/room";

#include "../def.h"

int trinken=5;
int setzen=1;
int mausefalle=3;
int schrank=0;
int anzahl=3;
int gepinkelt=0;

string cupboard();
string clothes();

void create()
{
  ::create();
    
  SetProp(P_INT_SHORT, "Turm in der Wolkenstadt");
  SetProp(P_INT_LONG, "Alles ist kitschig Rosa. Die ganze Zwiebelglaskuppel "
	  "besteht aus rosa und transparentem Glas. Eine zwei Meter lange, rosa Wand "
	  "wurde als Raumteiler aufgestellt. Auf der rechten Seite erkennst "
	  "Du einen Diwan, Tisch und bequeme Couchsessel. Auf der linken "
	  "Seite steht ein riesiges Himmelbett, das von einem Nachtkaestchen "
	  "geschmueckt wird. An der linken Wandseite sind noch ein Schrank "
	  "und ein Schminktisch platziert. Ein kleiner Balkon woelbt sich "
	  "aus der Glaskuppel ein wenig hinaus.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  
  //-----Details Anfang-----
  
  AddDetail( ({"cute","marrogh","maghnar","niri","gaya","zidane","nyx","wumanzu",
	       "elrohir","velkyn","took","aroobah","methos","katarok"}),
	      "Ja, dieser Spieler hat mir geholfen, dass dieses Gebiet noch besser "
	      "und schoener wird.");

  AddDetail( ({"rosa"}),
	     "Rosa scheint hier alles zu dominieren. Alles hell, weiss und "
	     "rosa.");
  
  AddDetail( ({"zwiebelglaskuppel","glaskuppel","kuppel"}),
	     "Sie schwingt sich spiralig vom Boden bauchig nach aussen und "
	     "endet dann oben in einer Spitze.");
  
  AddDetail( ({"spitze","decke"}),
	     "Hoch ober Dir ist die Spitze. Du kannst den ganzen Himmel "
	     "erkennen.");
  
  AddDetail( ({"himmel"}),
	     "Er ist strahlend Violett.");
  
  AddDetail( ({"violett"}),
	     "Huch, violett? Nein, rosa und blau ergeben doch violett. Der "
	     "Himmel ist sicher blau.");
  
  AddDetail( ({"glas"}),
	     "Es ist durchsichtig und rosa und weisse Glasstreifen wechseln "
	     "sich ab.");
  
  AddDetail( ({"glasstreifen","streifen"}),
	     "In einem Streifen ist der Balkon eingelassen. Sieh es Dir mal "
	     "an.");
  
  AddDetail( ({"meter"}),
	     "Sie ist zwei Meter lang. Haettest Du ein Massband, dann "
	     "koenntest Du sie abmessen.");
  
  AddDetail( ({"massband","band"}),
	     "Mhh, irgendwo bekam man doch eines...");
  
  AddDetail( ({"waende"}),
	     "Waende gibt es keine, bis auf diese eine Wand.");
  
  AddDetail( ({"wand","raumteiler","teiler"}),
	     "Sie ist voll behangen mit Bildern. Die Wand duerfte den Raum in "
	     "einen Wohnraum und einen Schlafraum teilen.");
  
  AddDetail( ({"seite"}),
	     "Welche Seite moechtest Du? Die rechte oder die linke Seite?");
  
  AddDetail( ({"wohnraum","rechte seite"}),
	     "Hier befindet sich ein Diwan, ein Tisch und bequeme Couchsessel.");
  
  AddDetail( ({"schlafraum","linke seite"}),
	     "Du siehst ein riesiges Himmelbett, daneben einem Nachtkaestchen. "
	     "An der Wand stehen noch ein Schrank und ein Schminktisch.");
  
  AddDetail( ({"raum"}),
	     "Meinst Du jetzt den Schlafraum oder den Wohnraum?");
  
  AddDetail( ({"bilder","bildern"}),
	     "Du erkennst in der Mitte eindeutig ein Bild mit einem roten "
	     "Herzrahmen. Oberhalb davon haengt ein Bild mit einem weissen "
	     "Rahmen. Rechts haengt ein hellrosa Bild und links ein pinkes "
