void reset()
{
  ::reset();
  trinken=5;
  setzen=1;
  schrank=0;
  anzahl=3;
  gepinkelt=0;
  
}

string cupboard()
{
  if(schrank)
   return BS("Der Schrank besteht auch aus Kristall. Er enthaelt "
	     "wunderschoene und praechtige Kleidungsstuecke.");
   return BS("Der Schrank besteht auch aus Kristall. Du erkennst einige "
	     "Kleidungsstuecke durch den Kristall.");
}

string clothes()
{
  if(schrank)
   return BS("Du siehst Prachtgewaender in Gold, Silber, Seide, Samt und Satin "
	     "in allen Farben. Ein Stueck ist edler als das andere.");
   return BS("Du solltest mal den Schrank oeffnen.");
   
}
int cmd_bild(string str)	
{
  notify_fail("Was willst Du beiseite schieben?\n");
  
  if(!(str=="bild beiseite"||
       str=="bild zur seite"||
       str=="bild auf die seite"||
       str=="bild weg"||
       str=="herzrahmen beiseite"||
       str=="herzrahmen zur seite"||
       str=="herzrahmen auf die seite"||
       str=="herzrahmen weg")) 
    return 0;
  
  write(BS("Du entdeckst eine ganz kleine Nische. In ihr befindet sich eine "
	   "kleine Phiole in Herzform, die mit schwarzroten Blut gefuellt ist.\n"
	   "Du nimmst sie heraus und liest: Hiri und Elrohir fuer immer "
	   "vereint!. Du denkst Dir: Igitt Blut!, und stellst angewidert die "
	   "Phiole zurueck. Du richtest das Bild wieder gerade."));
  
  say(BS(TPN+" werkt an den Bildern herum."));
  
  return 1;
}

int cmd_kuscheln(string str)	
{
  notify_fail("Was willst Du kuscheln?\n");
  
  if(!(str=="haeschen"||
       str=="plueschhaeschen")) 
    return 0;
  
  write(BS("Du knuddelst ein Haeschen, als es Dich ploetzlich mit rot "
	   "gluehenden Augen haemisch angrinst. Es reisst sein Maul weit auf "
	   "und ..... *HACK* Das Biest hat Dir in den Arm gebissen. Du schreist "
	   "laut auf und wirfst es weg. Das Nekrofellhaeschen kichert Dich "
	   "leise an."));
  
  say(BS(TPN+" kuschelt ein Plueschhaeschen und schreit ploetzlich auf. "
	 +CAP(TP->QueryPronoun(WER))+" schleudert das Haeschen zurueck."));
  
  SetProp(P_KILL_NAME, "Ein Nekrofellhaeschen");
  TP->do_damage(5);
  
  return 1;
}

int cmd_trinken(string str)	
{
  notify_fail("Was Du trinken?\n");
  
  if(!(str=="tee"||
       str=="tee aus tasse")) 
    return 0;
  
  if(TP->drink_soft(5))
    {
      write(BS("Du schenkst Dir in Ruhe eine Tasse Tee ein. Genuesslich nimmst "
	       "Du einen Schluck. Mhh, der Tee schmeckt lecker nach Beeren und "
	       "Du trinkst ihn aus."));
      
      say(BS(TPN+" schenkt sich eine Tasse Tee ein und trinkt einen Schluck."));
      
      if(trinken<1)
	{
	  return -1;
	}
      
      TP->AddHp(10+random(5));
      trinken--;
      
      return 1;
    }
  else
    {
      return -1;
    }
}

int cmd_gehen(string str)    
{
  notify_fail("Wie willst Du gehen?\n");
  
  if(!(str=="barfuss"||
       str=="schuhlos"||
       str=="ohne Schuhe")) 
    return 0;
  
  if(sizeof(TP->QueryArmours(AT_BOOT)))
    {
      write(BS("Du ziehst Deine Schuhe aus. Pfui, wie Deine Fuesse stinken... "
	       "Du fuehlst den weichen Flauscheteppich und tanzt eine Runde durch "
	       "den Raum. Du drehst Dich und drehst Dich bis du lachend hinfaellst. "
	       "Beschaemt ziehst Du die Schuhe lieber wieder an, bevor jemand "
	       "umkommt."));
      
      say(BS(TPN+" zieht sich die Schuhe aus und ein fuerchterlicher, saurer "
	     "Gestank erfuellt die Luft. Du bist benebelt von dem Geruch und "
	     "wirst schon fast ohnmaechtig, als "+TPN+" wieder "
	     "das Schuhwerk anzieht."));
    }
  else
    {
      write(BS("Du fuehlst den weichen Flauscheteppich und tanzt eine Runde durch "
	       "den Raum. Du drehst Dich und drehst Dich bis du lachend hinfaellst. "
	       "Beschaemt stehst Du wieder auf und widmest Dich wieder dem Raum zu."));
      
      say(BS(TPN+" tanzt wild und dreht sich herum. "+CAP(TP->QueryPronoun(WER))+" "
	     "faellt lachend hin."));
    }
  return 1;
}

int cmd_setzen(string str)
{
  notify_fail("Wo willst Du Dich hinsetzen?\n");
  
  if(!(str=="in couchsessel"||
       str=="in sessel"||
       str=="auf couchsessel"||
       str=="auf sessel"||
       str=="hin")) 
    return 0;
  
  {
    write(BS("Du kuschelst Dich laessig in einen der grossen Couchsessel... "));
    
    say(BS(TPN+" kuschelt sich in einen Couchsessel und steht nach einer Weile "
	   "wieder auf."));
    
    if(setzen<1)
      {
	write(BS("Dir ist so langweilig... Nach einer Weile stehst Du wieder auf."));
	
	return -1;
      }
    
    write(BS("Du bemerkst, dass Dich irgendwas am Popo kratzt. Du greifst unter "
	     "Dich und entdeckst einen alten Keks. Du hast eh so einen Hunger, dass "
	     "Du ihn gleich in den Mund stopfst. Mhh, gar nicht so schlecht, aber "
	     "ein bisschen hart. Froehlich huepfst Du wieder auf."));
    
    TP->AddHp(20);
    setzen--;
    
    return 1;
  }
} 

int cmd_schauen(string str)	
{
  notify_fail("Worunter willst Du schauen?\n");
  
  if(!(str=="unter bett"||
       str=="unters bett"||
       str=="unter das bett")) 
    return 0;
  
  if(gepinkelt)
    write(BS("Du beugst Dich hinunter und blickst unter das Bett. Du "
	     "erspaehst nur einen Nachttopf. Ploetzlich verspuerst Du einen "
	     "Drang, diesen Nachttopf zu benutzen. Leider war schon jemand vor "
	     "Dir da und der Topf ist bereits voll..."));
  else
    write(BS("Du beugst Dich hinunter und blickst unter das Bett. Du "
	     "erspaehst nur einen Nachttopf. Du verspuerst ploetzlich einen "
	     "Drang, diesen Nachttopf zu benutzen. Er sieht unbenutzt aus."));
  
  say(BS(TPN+" blickt unter das Bett."));
  
  return 1;
}

int cmd_nachttopf(string str)	
{
  notify_fail("Wo willst Du hinein pinkeln?\n");
  
  if(!(str=="in nachttopf"||
       str=="in topf"||
       str=="unter das bett"||
       str=="nachttopf"||
       str=="topf"||
       str=="notdurft")) 
    return 0;
  
  if(gepinkelt)
    {
      write(BS("Igitt!!! Der Topf ist ja schon voll... Du musst Dir wohl "
	       "eine andere Stelle fuer Deine Erleichterung suchen."));
      
      return -1;
    }
  
  write(BS("Du blickst Dich vorher um, dass Dich ja keiner bemerkt. Die Luft "
	   "ist rein... Du ziehst blitzschnell den Nachttopf hervor und "
	   "pinkelst in windeseile hinein. Mit hochrotem Kopf schiebst Du ihn "
	   "wieder unters Bett zurueck. Du bist froh Dich erleichtert zu "
	   "haben."));
  
  say(BS(TPN+" werkt beim Bett herum und Du kannst ein plaetschern hoeren."));
  
  gepinkelt=1;
  
  return 1;
}

int cmd_streifen(string str)    
{
  notify_fail("Worueber willst Du streifen?\n");
  
  if(!(str=="ueber glasperlen"||
       str=="ueber perlen"||
       str=="glasperlen"||
       str=="perlen"||
       str=="mit finger ueber glasperlen"||
       str=="mit finger ueber perlen"||
       str=="ueber kette"||
       str=="kette")) 
    return 0;
  
  write(BS("Du streifst von rechts nach links weit ueber den Glitzervorhang. "
	   "Ein wunderschoenes Klangspiel ergibt sich und die Perlen glitzern "
	   "abwechselnd schnell auf. Du schaust und lauscht diesem Farb- und "
	   "Klangspiel bis es zu Ende ist."));
  
  say(BS(TPN+" streift ueber den Glitzervorhang und Du hoerst ein "
	 "Klangspiel."));
  
  return 1;
}

int cmd_legen(string str)	
{
  notify_fail("Wo willst Du Dich hinein legen?\n");
  
  if(!(str=="in bett"||
       str=="ins bett"||
       str=="in himmelbett"||
       str=="ins himmelbett"||
       str=="in bett hinein"||
       str=="ins bett hinein"||
       str=="in himmelbett hinein"||
       str=="ins himmelbett hinein")) 
    return 0;
  
  write(BS("Du huepfst ins Bett und kuschelst Dich hinein. Du blickst herum "
	   "und waelzt Dich ein wenig hin und her. Du pfeifst vor Dich hin.\n"
	   "Ploetzlich kommen Dir ein paar Ideen... Du koenntest Dich ja unter "
	   "der Bettdecke verstecken oder die Poelster durchwuehlen oder im "
	   "Bett springen."));
  
  say(BS(TPN+" huepft ins Bett und legt sich hin."));
  
  return 1;
}

int cmd_verstecken(string str)	
{
  notify_fail("Worunter willst Du Dich verstecken?\n");
  
  if(!(str=="unter bettdecke"||
       str=="unter decke"||
       str=="in bett"||
       str=="in himmelbett")) 
    return 0;
  
  write(BS("Du versteckst Dich flink unter der riesigen, dicken Satindecke. "
	   "Du wartest und wartest ... Schliesslich willst Du ja jemanden "
	   "erschrecken. Kein Laut ist zu hoeren. Es wird ziemlich heiss "
	   "da drinnen. Du schwitzt. Grummelnd kletterst Du wieder unter der "
	   "Decke hervor."));
  
  say(BS(TPN+" versteckt sich unter der Bettdecke."));
  
  return 1;
}

int cmd_durchwuehlen(string str)	
{
 notify_fail("Was willst Du durchwuehlen?\n");
 
 if(!(str=="poelster"||
      str=="satinpoelster"||
      str=="poelster durch"||
      str=="satinpoelster durch"||
      str=="polster"||
      str=="satinpolster"||
      str=="polster durch"||
      str=="satinpolster durch")) 
   return 0;
 
 write(BS("Du wuehlst Dich durch die Poelster durch. Sie riechen blumig "
	  "frisch. Ploetzlich erfasst Du etwas Rauhes. Du koenntest es "
	  "herausziehen."));
 
 say(BS(TPN+" wuehlt sich durch die Poelster durch."));
 
 return 1;
}

int cmd_strumpfband(string str)
{
  object strumpfband;
  notify_fail("Was willst Du herausziehen?\n");
  
  if(!(str=="rauhes heraus"||
       str=="etwas rauhes heraus"||
       str=="etwas heraus"||
       str=="rauhes aus poelster heraus"||
       str=="etwas aus poelster rauhes heraus"||
       str=="etwas aus poelster heraus"||
       str=="rauhes aus bett heraus"||
       str=="etwas aus bett rauhes heraus"||
       str=="etwas aus bett heraus")) 
    return 0;
  
  {  
    if(anzahl<1)
      {
	write(BS("Du wuehlst und wuehlst, aber leider ist doch nichts da. Versuch "
		 "es spaeter nochmals!"));
	
	say(TPN+" graebt sich in die Poelster.\n");
	
	return -1;
      }
    
    if(present("strumpfband",TP))
      {
	write(BS("Du hast doch schon ein Strumpfband, Du Gierhammel."));
	
	say(BS(TPN+" graebt sich in die Poelster."));
	
	return -1;
      }
    else
      {
	
	strumpfband=clone_object(ARMOUR "strumpfband");
	if (ME_TOO_HEAVY==strumpfband->move(TP,M_GET))
	  {
	    write(BS("Du greifst tief zwischen die Poelster hinein und "
		     "erfasst das Stueck. Du haelst ein Strumpfband in der "
		     "Hand. Du legst schweren Herzens das Strumpfband auf "
		     "den Boden, weil Du beim besten Willen nichts mehr "
		     "tragen kannst."));
	    
	    say(BS(TPN+" legt seufzend ein Strumpfband auf den Boden."));
	    
	    strumpfband->move(TO, M_NOCHECK|M_SILENT);
	    return 1;
	  }
	else
	  {
	    write(BS("Du greifst tief zwischen die Poelster hinein und erfasst das "
		     "Stueck. Du haeltst ein Strumpfband in der Hand."));
	    
	    say(BS(TPN+" graebt sich durch die Poelster und scheint etwas gefunden zu "
		   "haben."));
	    anzahl--;
	    return 1;
	  }
	return 0;
      }
  } 
  return 0;
}

int cmd_springen(string str)	
{
  notify_fail("Wo willst Du springen?\n");
  
  if(!(str=="im bett"||
       str=="in bett"||
       str=="ins bett"||
       str=="ins bett hinein"||
       str=="aufs bett"||
       str=="im himmelbett"||
       str=="in himmelbett"||
       str=="ins himmelbett"||
       str=="ins himmelbett hinein"||
       str=="aufs himmelbett")) 
    return 0;
  
  write(BS("Du springst voller Freude ins Bett und huepfst wie wild herum. "
	   "Du schlaegst Salti und Schrauben. Du kreischt vor Freude. Voellig "
	   "ausser Atem und lachend kletterst Du aus dem Bett heraus."));
  
  say(BS(TPN+" springt im Bett herum und schlaegt Salti und Schrauben. Du "
	 "zuckst zusammen als "+TP->QueryPronoun(WER)+" vor Freude zu "
	 "kreischen anfaengt."));
  
  return 1;
}

int cmd_wuehlen(string str)	
{
  notify_fail("Worin willst Du wuehlen?\n");
  
  if(!(str=="in potpourri"||
       str=="in blueten"||
       str=="in schuessel")) 
    return 0;
  
  write("Die Idee war gut da drinnen zu wuehlen. Du hast leider nichts \n"
	"gefunden.\n"
	"Ploetzlich schnalzt es und Du schreist auf. Du ziehst Deine Hand \n"
	"raus und daran haengt eine Mausefalle. So was bloedes!!!, denkst Du \n"
	"Dir.\n"
	"Du ziehst die Falle vorsichtig ab und steckst sie langsam hinein.\n"
	"Soll doch der naechste damit seine Freude damit hat. Du grinst.\n");
  
  say(TPN+" wuehlt in einer Schuessel.\n"
      "Du hoerst einen Schrei und "+TPN+" zieht etwas von seiner Hand.\n"
      "Danach grinst "+TP->QueryPronoun(WER)+" sehr fies.\n");
  
  
  TP->AddHp(-5);
  return 1;
}

int cmd_oelen(string str)
{
  object rosenduft;
  notify_fail("Du willst Deinen Koerper sicher einoelen?\n");
  
  if(!(str=="mich ein"||
       str=="koerper"||
       str=="koerper ein")) 
    return 0;
  
  if(present("\nrosenduft",TP))
    {
      write(BS("Dein Koerper glaenzt noch immer vor Oel. Versuche es spaeter, "
	       "wenn sich das Oel in die Haut eingezogen hat."));
      
      return -1;
    }
  else
    {
      CLONE(OBJ "rosenduft",TP);
      
      write(BS("Du gibst ein paar Tropfen auf deine Finger. Langsam schmierst "
	   "und massierst Du das Oel in die Haut ein. Mhhh, wie angenehm. Und "
	   "wie Du duftest."));
  
      say(BS(TPN+" massiert die eigene Haut."));
  
      return 1;
    }
}

int cmd_probieren(string str)
{  
  notify_fail("Was willst Du anprobieren?\n");
  
  if(!(str=="kleider an"||
       str=="kleider"||
       str=="gewand"||
       str=="gewand an"||
       str=="gewaender"||
       str=="gewaender an"))
    return 0;
  
  if(schrank!=1)
    {
      write(BS("Du kannst nichts anprobieren, wenn der Schrank nicht geoeffnet ist."));
      return 1;
    }   
  else 
    {
      write(BS("Du greifst hinein, nimmst das erst beste Stueck heraus und "
	       "ziehst es an. Du betrachtest Dich im Spiegel und stellst mit "
	       "Entsetzen fest, dass Du eine gruen-rosa Kringelstrumpfhose an hast. "
	       "Verlegen ziehst Du Dich wieder schnell um und stopfst sie zurueck. "
	       "Bedaechtig schliesst Du den Schrank wieder."));
      
      say(BS(TPN+" nimmt eine gruen-rosa Strumpfhose aus dem Schrank und zieht "
	     "sie an. Oh Mann, das sieht so laecherlich aus, dass Du Dir "
	     "krampfhaft ein Lachen unterdruecken musst."));
      
      schrank = 0;
      return 1;
    }
}

int cmd_oeffnen(string str)	
{
  notify_fail("Was willst Du oeffnen?\n");
  
  if(!(str=="schrank"||
       str=="tuer"||
       str=="schranktuer"||
       str=="kasten")) 
    return 0;
  
  if(schrank!=1)
    {
      write(BS("Du oeffnest den Schrank und er enthaelt wahre Prachtgewaender. "
	       "Gold, Silber, Seide, Samt und Satin in allen Farben springen Dir "
	       "ins Auge. Du wuerdest sie gerne anprobieren."));
      
      say(BS(TPN+" oeffnet den Schrank."));
      
      schrank=1;
      return 1;
    }
  else
    {
      write(BS("Der Schrank ist schon offen."));
      
      return 1;
    }
}


int cmd_schliessen(string str)	
{
  notify_fail("Was willst Du schliessen?\n");
  
  if(!(str=="schrank"||
       str=="tuer"||
       str=="schranktuer"||
       str=="kasten")) 
    return 0;
  
  if(schrank!=0)
    {
      write(BS("Du schliesst behutsam den Schrank."));
      
      say(BS(TPN+" schliesst den Schrank."));
      
      schrank=0;
      return 1;
    }
  else
    {
      write(BS("Der Schrank ist schon geschlossen worden."));
      
      return 1;
    }
}

int cmd_betrachten(string str)	
{
  notify_fail("Du willst doch Dich betrachten?\n");
  
  if(!(str=="mich"||
       str=="spiegelbild")) 
    return 0;
  
  write(BS("Du blickst in den Spiegel und erschreckst bei dem Anblick. Du "
	   "siehst total herunter gekommen aus, aber sehr kraeftig... Du ziehst "
	   "Deine Mundwinkel rauf und runter.. Dann spielst Du mit den "
	   "Augenbrauen. Lustig! Du schneidest lauter Grimassen."));
  
  say(BS(TPN+" schneidet Grimassen im Spiegel."));
  
  return 1;
}

int cmd_schminken(string str)	
{
  object clown;
  notify_fail("Du willst sicher Dich schminken?\n");
  
  if(!(str=="mich"||
       str=="mich selbst"||
       str=="mich selber")) 
    return 0;
  
  if(present("\nclown",TP))
    {
      write(BS("Du siehst schon aus wie ein Clown. Da musst Du nicht nochmals "
	       "drueber schminken."));
      
      return -1;
    }
  else
    {
      CLONE(OBJ "clown",TP);
      
      write("Du weisst gar nicht wo Du anfangen sollst. Du faengst mal beim \n"
	    "Lidschatten an und traegst etwas davon auf das Lid auf. Weiters \n"
	    "puderst Du Dir etwas Rouge auf die Wangen. Dann koenntest Du Doch \n"
	    "die Lippen schnoen rot malen. Du nimmst von da etwas und von dort \n"
	    "etwas.\n"
	    "\n"
	    "Voila! Du siehst einfach toll ... eahm ... daemlich aus... Am "
	    "besten, Du\nwischt Dir die Schminke lieber wieder weg.\n");

      say(BS(TPN+" schminkt sich und sieht aus wie ein Clown."));

      return 1;
    }
}

