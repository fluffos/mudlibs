// Armour - "Wolkenstadt"

#include "../def.h"

inherit ARMOUR "stdbluete";

void create() 
{
  if (!is_clone(TO)) return;

  SetProp(P_NAME, "Lavendelbluete");

  ::create();
  
  SetProp(P_SHORT, "Eine Lavendelbluete");
  SetProp(P_LONG,
	  "Eine wunderschoene, lilafarbene Lavendelbluete, die eigentlich aus "
	  "mehreren Blueten besteht. die einem Stiel entwachsen sind. Sie "
	  "wuerde das Haupt eines jeden Traegers auf beste Weise hervorheben.");

  SetProp(P_NAME_ADJ, "lilafarben");

  AddId("lavendelbluete");
  AddAdjective(({"lavendelfarben", "lavendelfarbene", "lavendelfarbener", "lavendelfarbenen"}));

  AddDetail( ({"blueten"}),
	   "Unregelmaessig entwachsen kleine Bluetendolden dem Stiel.");

  AddDetail( ({"stiel"}),
	   "Der Stiel ist uebersaeht von lilafarbenen Blueten und Blaettern.");

  AddDetail( ({"bluetendolden","dolden"}),
	   "Ein schmaler Rumpf, der sich schmal zu einer Bluete hinauf zieht.");

  AddDetail( ({"rumpf"}),
	   "Auch der Rumpf ist lilafarben und ein Teil der Bluete.");

  AddDetail( ({"teil"}),
	   "Wenn Du es Dir noch immer nicht vorstellen kannst, dann google "
	   "doch mal danach.");

  AddDetail( ({"haupt"}),
	   "Vielleicht auch Dein Haupt?");

  AddDetail( ({"traeger","traegers"}),
	    "Damit bist Du gemeint." );

  AddDetail( ({"weise"}),
	   "Auch Du darfst Dich schmuecken.");
	   
  SetProp(P_SMELL, "Sie riecht wunderbar herb lavendelig.\n");
  
}
