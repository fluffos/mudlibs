// Armour - "Wolkenstadt"

#include "../def.h"

inherit ARMOUR "stdbluete";

void create() 
{
  if (!is_clone(TO)) return;

  SetProp(P_NAME, "Geranienbluete");

  ::create();
  
  SetProp(P_SHORT, "Eine Geranienbluete");
  SetProp(P_LONG,
	  "Eine wunderschoene, pinkfarbene Geranienbluete, deren Bluetenblaetter "
	  "einem duennen und filigranen Stiel entwachsen sind. Sie "
	  "wuerde das Haupt eines jeden Traegers auf beste Weise hervorheben.");

  SetProp(P_NAME_ADJ, "pinkfarben");

  AddId("geranienbluete");
  AddAdjective(({"pinkfarben", "pinkfarbene", "pinkfarbener", "pinkfarbenen"}));

  AddDetail( ({"blaetter","bluetenblaetter"}),
	   "Sie rueschen sich rund im Kreis.");

  AddDetail( ({"stiel"}),
	   "Der Stiel ist lang und duenn.");

  AddDetail( ({"kreis"}),
	   "Kreisiger geht es nicht.");

  AddDetail( ({"haupt"}),
	   "Vielleicht auch Dein Haupt?");

  AddDetail( ({"traeger","traegers"}),
	    "Damit bist Du gemeint." );

  AddDetail( ({"weise"}),
	   "Auch Du darfst Dich schmuecken.");  

  SetProp(P_SMELL, "Die Geranie fasziniert mehr durch ihr Aussehen als durch\n"
                               "den Geruch.\n");

}
