// Armour - "Wolkenstadt"

#include "../def.h"

inherit ARMOUR "stdbluete";

void create() 
{
  if (!is_clone(TO)) return;

  SetProp(P_NAME, "Kalanchoebluete");

  ::create();
  
  SetProp(P_SHORT, "Eine Kalanchoebluete");
  SetProp(P_LONG,
	  "Eine wunderschoene, orangene Kalanchoebluete, deren Blaetter so winzig "
	  "sind, dass nicht mal mehr Stempel zu sehen ist. Sie wuerde das Haupt "
	  "eines jeden Traegers auf beste Weise hervorheben.");

  SetProp(P_NAME_ADJ, "orangen");

  AddId("kalanchoebluete");
  AddAdjective(({"orange", "orangene", "orangener", "orangenen"}));

  AddDetail( ({"blaetter","bluetenblaetter"}),
	   "Die orangen Bluetenblaetter sind sehr spitz und winzigst.");

  AddDetail( ({"stempel"}),
	   "Du erkennst, bei genauerem Hinsehen, einen feinen Bluetenstaub.");

  AddDetail( ({"bluetenstaub","staub"}),
	   "Er flirrt und schimmert ganz sanft und ergibt ein belebtes "
	   "Farbenspiel.");

  AddDetail( ({"farbenspiel","spiel"}),
	   "Du bist fasziniert!!!");

  AddDetail( ({"haupt"}),
	   "Vielleicht auch Dein Haupt?");

  AddDetail( ({"traeger","traegers"}),
	    "Damit bist Du gemeint." );

  AddDetail( ({"weise"}),
	   "Auch Du darfst Dich schmuecken.");  
  
  SetProp(P_SMELL, "Sie riecht wunderbar zart.\n");
  
}


