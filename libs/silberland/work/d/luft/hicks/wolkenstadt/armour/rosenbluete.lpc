// Armour - "Wolkenstadt"

#include "../def.h"

inherit ARMOUR "stdbluete";

void create() 
{
  if (!is_clone(TO)) return;

  SetProp(P_NAME, "Rosenbluete");

  ::create();

  SetProp(P_SHORT, "Eine Rosenbluete");
  SetProp(P_LONG,
	  "Eine wunderschoene, zartrosane Rosenbluete, deren Blaetter sich "
	  "wellenfoermig ineinander schlingen. Sie wuerde das Haupt eines jeden "
	  "Traegers auf beste Weise hervorheben.");
  SetProp(P_INFO, "Man kann sie ins Haar stecken und wenn man genuegend Blueten "
		  "beliebiger Sorten hat, ist ein Bluetenkranz schnell geflochten.");
  SetProp(P_NAME_ADJ, "zartrosan");
  AddId("rosenbluete");
  AddAdjective(({"zartrosa", "zartrosane", "zartrosaner", "zartrosanen"}));

  AddDetail( ({"blaetter"}),
	   "Die zartrosa Blaetter wirken sehr filigran und der Duft ist "
	   "herrlich.");

  AddDetail( ({"duft"}),
	   "Du hast vergessen Deine Nase zum erschnuppern zu verwenden.");

  AddDetail( ({"nase"}),
	   "Rieche Rosenbluete!");

  AddDetail( ({"haupt"}),
	   "Vielleicht auch Dein Haupt?");

  AddDetail( ({"traeger","traegers"}),
	    "Damit bist Du gemeint." );

  AddDetail( ({"weise"}),
	   "Auch Du darfst Dich schmuecken.");  
  
  SetProp(P_SMELL, "Sie riecht wunderbar zartrosig.\n");

}
