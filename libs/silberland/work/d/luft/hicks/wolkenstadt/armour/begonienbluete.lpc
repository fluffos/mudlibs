// Armour - "Wolkenstadt"

#include "../def.h"

inherit ARMOUR "stdbluete";

void create() 
{
  if (!is_clone(TO)) return;

  SetProp(P_NAME, "Begonienbluete");

  ::create();
  
  SetProp(P_SHORT, "Eine Begonienbluete");
  SetProp(P_LONG,
	  "Eine wunderschoene, gelbe Begonienbluete, deren Blaetter zart "
	  "einen kleinen Stempel umranden. Sie wuerde das Haupt eines jeden "
	  "Traegers auf beste Weise hervorheben.");

  SetProp(P_NAME_ADJ, "gelb");

  AddId("begonienbluete");
  AddAdjective(({"gelb", "gelbe", "gelber", "gelben"}));

  AddDetail( ({"blaetter"}),
	   "Die gelben, zarten Blaetter wirken sehr filigran.");

  AddDetail( ({"stempel"}),
	   "Du erkennst, bei genauerem Hinsehen, einen feinen Bluetenstaub.");

  AddDetail( ({"bluetenstaub","staub"}),
	   "Er flirrt und schimmert ganz sanft und ergibt ein belebtes "
	   "Farbenspiel.");

  AddDetail( ({"farbenspiel","spiel"}),
	   "Du bist fasziniert!!!");

  AddDetail( ({"haupt"}),
	   "Vielleicht auch Dein Haupt?");

  AddDetail( ({"traeger","traegers"}),
	    "Damit bist Du gemeint." );

  AddDetail( ({"weise"}),
	   "Auch Du darfst Dich schmuecken.");  
  
  SetProp(P_SMELL, "Sie riecht wunderbar lieblich.\n");
}
