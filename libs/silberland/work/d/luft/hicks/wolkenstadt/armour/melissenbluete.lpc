// Armour - "Wolkenstadt"

#include "../def.h"

inherit ARMOUR "stdbluete";

void create() 
{
  if (!is_clone(TO)) return;

  SetProp(P_NAME, "Melissenbluete");

  ::create();
  
  SetProp(P_SHORT, "Eine Melissenbluete");
  SetProp(P_LONG,
	  "Eine wunderschoene, weiss-rosane Melissenbluete, deren Blaetter "
	  "einen Kelch bilden. Sie wuerde das Haupt "
	  "eines jeden Traegers auf beste Weise hervorheben.");

  SetProp(P_NAME_ADJ, "weiss-rosan");
  SetProp(P_GENDER, FEMALE);

  AddId("melissenbluete");
  AddAdjective(({"weiss-rosa", "weiss-rosane", "weiss-rosaner", "weiss-rosanen"}));

  AddDetail( ({"blaetter","bluetenblaetter"}),
	   "Die Bluetenblaetter bilden einen Kelch, der nach unten haengt.");

  AddDetail( ({"kelch"}),
	   "Gebildet wird dieser aus drei weissen Bluetenblaettern und einem "
	   "rosa Bluetenblatt, das wie eine Zunge aussieht.");

  AddDetail( ({"zunge"}),
	   "Es sieht nur aus wie eine Zunge, aber die Bluete ist im allgemeinen "
	   "sehr schoen.");

  AddDetail( ({"haupt"}),
	   "Vielleicht auch Dein Haupt?");

  AddDetail( ({"traeger","traegers"}),
	    "Damit bist Du gemeint." );

  AddDetail( ({"weise"}),
	   "Auch Du darfst Dich schmuecken.");  
  
  SetProp(P_SMELL, "Sie riecht zart erfrischend und belebend.\n");
  
}

