// Objekt meines Gesellenstueckes "Wolkenstadt"

#include "../def.h"

inherit "std/armour";

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Paar gruene Socken");
  SetProp(P_LONG, "Ein einfaches Paar gruene Socken. Eine Socke hat ein "
		  "Erdbeermuster, die andere ein Kartoffelmuster." );
  SetProp(P_INFO, "Du spuerst in diesem Paar Socken eine paranoide, "
		  "magische Macht schlummern. Du fuehlst Dich unbehaglich.");
  SetProp(P_NAME, "Paar Socken");
  SetProp(P_NAME_ADJ, "gruen");
  SetProp(P_GENDER, FEMALE);
  AddId(({"sockenpaar, socken, psocken"}));
  AddAdjective(({"gruenen", "gruenen", "gruenen", "gruenen"}));
  
  SetProp(P_MATERIAL, ([MAT_COTTON:100]));
  SetProp(P_WEIGHT, 40);
  SetProp(P_VALUE, 200);
    
  AddDetail( ({"socke"}),
	       "Unglaublich, Du haelst ein ganzes Paar Socken in der Hand. "
	       "Eine hat ein Erdbeermuster, die andere ein Kartoffelmuster.");

  AddDetail( ({"muster"}),
	     "Welches Muster meinst Du?");

  AddDetail( ({"erdbeermuster","erdbeeren","erdbeere"}),
	       "Du bist bei der Kombination von Rot und Gruen verzueckt.");

  AddDetail( ({"kombination"}),
               "Sie gefaellt Dir.");

  AddDetail( ({"rot");
               "Du hast kein schoeneres, sattes Rot gesehen.");

  AddDetail( ({"gruen"}),
	     "Diese Socken sind eindeutig gruen, ausser Du bist farbenblind.");

  AddDetail( ({"kartoffelmuster","kartoffel","kartoffeln"}),
	     "Dir faengt der Magen zu knurren an, wenn du das huebsche, "
	     "gelbe Motiv siehst.");

  AddDetail( ({"magen"}),
	     "Du blickst Dich verschuechtert um, ob ihn eh niemand gehoert hat.");

  AddDetail( ({"motiv"}),
	     "Eine gelbe Kartoffel umgeben von Gruen.");
		  
}
