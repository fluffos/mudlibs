#include "../def.h"

inherit "std/armour";

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_INFO, "Man kann sie ins Haar stecken und wenn man genuegend Blueten "
		  "beliebiger Sorten hat, ist ein Bluetenkranz schnell geflochten.");

  SetProp(P_GENDER, FEMALE);

  AddId(({"bluete","\nhicksbluete"}));

  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_PLANT:100]));
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 30);

  SetProp(P_WEAR_TEXT, ({
	      "Du steckst Dir "+name(WEN,1)+" ins Haar.\n",
		" steckt sich "+name(WEN)+" ins Haar.\n"}));
  
  AddCmd( ({"trag", "trage"}), "do_wear");
  AddCmd( ({"steck", "stecke"}), "cmd_stecken");
  AddCmd( ({"flechte","flecht"}),"cmd_bluetenkranz");
  
}

//Yara: ueberarbeitet
int cmd_bluetenkranz(string str)
{
  object bluetenkranz;
  int i, res;
  object *blueten;
  
  notify_fail("Was moechtest Du flechten?\n");

  if(!(str == "blumenkranz"||
       str == "bluetenkranz"||
       str == "kranz")) 
    return 0;

  if(sizeof(blueten = filter_objects(
                        all_inventory(TP), "id", "\nhicksbluete")) < 10)
  {
      write(BS("Du hast leider nicht genug Blueten aus dem Laden "
               "'Potpouries & Allerlei'."));
      return -1;
  } 

  bluetenkranz=clone_object(ARMOUR "bluetenkranz");
  res = bluetenkranz->move(TP,M_GET|M_SILENT);

  if (res == ME_TOO_HEAVY || res == ME_TOO_MUCH)
  {
    write(BS("Du flechtest einen wunderschoenen Bluetenkranz aus "
             "diversen Blueten, den Du vor Freude zu Boden fallen laesst."));

    say(BS(TPN+" flechtet flink einen Bluetenkranz und laesst ihn "
        "vor Freude zu Boden fallen."));

    bluetenkranz->move(TO,M_NOCHECK);
  }
  else
  {
    write(BS("Du flechtest einen wunderschoenen Bluetenkranz aus "
            "diversen Blueten. Dein Meisterwerk ist Dir wirklich "
            "gut gelungen."));
    say(BS(TPN+" flechtet flink einen Bluetenkranz."));
  }

  for(i=10; i--;)
    blueten[i]->remove(1);

  return 1;
}

varargs int do_wear(string str, int silent)
{
//Yara
//old
//  if(!str) return 0;
  
//  if(!id(str)) return 0;
//
//new:
  if(!str || !id(str)) return 0;

  write(BS(Name(WEN,1)+" kann man sich nur ins Haar stecken!"));
  return 1;
}

string extra_look()
{
  if(objectp(QueryProp(P_WORN)))
    return QueryProp(P_WORN)->Name()+" traegt "+name(WEN)+" im Haar.\n";
  
  return "";
}

int cmd_stecken(string str)
{
  string x, y;
  object *misc;
  int i;
  
  if(!str || str == "") 
   return 0;
  
  if(sscanf(str, "%s %s", x, y) != 2) 
   return 0;
  
  if(!id(x))
   return 0;

  if(!(y== "in haar"||
       y== "ins haar"))
    return 0;
  
  if(sizeof(misc = TP->QueryArmours(AT_MISC)))
    for(i=0; i<sizeof(misc); ++i)
      if(misc[i]->id("\nhicksbluete"))
      {
        write(BS("Du hast bereits eine solche Bluete im Haar!"));
        return -1;
      }

  DoWear();

  return 1;
}

