// Armour meines Gesellenstueckes "Wolkenstadt"

#include "../def.h"

inherit "std/armour";

void create() 
{
  string final_mat;
  
  if (!is_clone(TO)) return;
  ::create();
    
  final_mat=({"hellgelbe","sonnengelbe","orangegelbe","hellrote",
		"dunkelrote","hellrosa","dunkelrosa","violette",
		"fliederfarbene","hellblaue","dunkelblaue","tuerkise",
		"hellgruene","zitronengelbe","zuckerlrosa","pastellgelbe",
		"pastellrosa","pastellgruene","eisblaue","eisgelbe",
		"himmelblaue","pfirsichrosa","lachsfarbene","mintfarbene",
		"eisrosa","eisviolette","graublaue","purpurfarbene",
		"korallenrote","magentafarbene","malvefarbene","kiwigruene",
		"meeresblaue","cyanfarbene","azurfarbene","silberfarbige",
		"schneeweisse","cremeweisse","regenbogenfarbene"})[random(39)];
  
  SetProp(P_SHORT, "Eine "+final_mat+" Blumenhaube");
  SetProp(P_LONG,
	  "Diese "+final_mat+" Blumenhaube ist die Bluete einer Glockenblume. Sie "
	  "ist so gross, dass sie auf den Kopf einer Fee passt.");
  SetProp(P_INFO, "Die Bluetenhaube bringt wahrlich nur die Schoenheit einer "
	  "Fee zur Geltung.");
  SetProp(P_NAME, "Blumenhaube");
  SetProp(P_GENDER, FEMALE);
  AddId(({"blumenhaube","bluetenhaube","haube"}));
  
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([MAT_MISC_HERBAL:100]));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 300);
  SetProp(P_QUALITY_DECAY, 30);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_MAX_SIZE : 90, P_RACE: "Fee"]));
  
}
