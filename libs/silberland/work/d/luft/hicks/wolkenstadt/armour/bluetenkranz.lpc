// 20.7.2005
// 
// Armour - "Wolkenstadt"

#include "../def.h"

inherit "std/armour";

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Bluetenkranz");
  SetProp(P_LONG,
	  "Ein wunderschoener Bluetenkranz, der aus ganz unterschiedlichen Blueten. "
	  "besteht. Er blueht in verschiedenensten, satten Farben.");
  SetProp(P_NAME, "Bluetenkranz");
  SetProp(P_NAME_ADJ, "bunt");
  SetProp(P_GENDER, MALE);
  AddId(({"bluetenkranz","kranz"}));
  AddAdjective(({"bunt", "bunte", "bunter", "bunten"}));

  AddDetail( ({"blueten"}),
	   "Du erkennst verschiedene Blueten, die zu einer bunten Mischung "
	   "verschmolzen sind.");

  AddDetail( ({"mischung"}),
	   "Eine Mischung aus Blueten und Farben.");

  AddDetail( ({"Farben","farbenteppich"}),
	   "Ein Teppich aus Blueten, dass Du nur noch BUNT herauss bringst.");

  AddDetail( ({"bunt"}),
	   "Du bist positiv stimmuliert durch diese Farben.");

  AddDetail( ({"teppich"}),
	    "Farbenteppich ist gemeint.");

  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([MAT_PLANT:100]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 300);
  SetProp(P_QUALITY_DECAY, 30);
  SetProp(P_SMELL, "Er riecht wunderbar blumig.\n");

  
 }
