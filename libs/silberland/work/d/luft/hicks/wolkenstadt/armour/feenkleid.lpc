// Armour meines Gesellenstueckes "Wolkenstadt"

#include "../def.h"

inherit "std/armour";

void create() 
{
    string farbe1;
    string farbe2;
  
  if( !is_clone(TO) ) return;
  ::create();
   
  farbe1=({"hellgelb", "sonnengelb", "orangegelb", "hellrot",
	    "dunkelrot", "hellrosan", "dunkelrosan", "violett",
	    "fliederfarben", "hellblau" ,"dunkelblau", "tuerkis",
	    "hellgruen", "dunkelgruen", "zuckerlrosa", "pastellgelb",
	    "pastellrosan", "pastellgruen", "eisblau", "eisgelb",
	    "himmelblau", "pfirsichrosan", "lachsfarben",
	    "mintfarben", "eisrosa", "eisviolett", "graublau",
	    "purpurfarben", "korallenrot", "magentafarben",
	    "malvefarben", "kiwigruen", "meeresblau", "cyanfarben",
	    "azurfarben", "smaragdgruen", "silberfarbig", "schneeweiss",
	    "cremeweiss", "regenbogenfarben"})[random(40)];

  farbe2=({"hellgelb", "sonnengelb", "orangegelb", "hellrot",
	    "dunkelrot", "hellrosan", "dunkelrosan", "violett",
	    "fliederfarben", "hellblau" ,"dunkelblau", "tuerkis",
	    "hellgruen", "dunkelgruen", "zuckerlrosa", "pastellgelb",
	    "pastellrosan", "pastellgruen", "eisblau", "eisgelb",
	    "himmelblau", "pfirsichrosan", "lachsfarben",
	    "mintfarben", "eisrosa", "eisviolett", "graublau",
	    "purpurfarben", "korallenrot", "magentafarben",
	    "malvefarben", "kiwigruen", "meeresblau", "cyanfarben",
	    "azurfarben", "smaragdgruen", "silberfarbig", "schneeweiss",
	    "cremeweiss", "regenbogenfarben"})[random(40)];
  
  SetProp(P_SHORT, "Ein buntes Feenkleid");
  SetProp(P_LONG,
	  "Das Feenkleid, das mit Bluemchen verziert ist, liegt an der Brust eng "
	  "an, und zieht sich glockenfoermig bis zur Huefte. Das Kleid besteht "
	  "aus zwei verschiedenen Stofflagen. Die obere Lage ist ein "
	  +farbe1+"er, feiner Transparentstoff und die darunter liegende "
	  "besteht aus "+farbe2+"em, glaenzendem Satin. "
	  "Das ganze Feenkleid wirkt verspielt, wobei das Bluetenoberteil durch "
	  "eine dicke Satinschleife mit dem Stoffkleid verbunden ist.");
  SetProp(P_INFO, "Dieses huebsche Kleid koennen nur Feen tragen.");
  SetProp(P_NAME, "Feenkleid");
  SetProp(P_NAME_ADJ, "bunt"); 
  SetProp(P_GENDER, NEUTER);
  AddId( ({"kleid","feenkleid"}));
  AddAdjective(({"bunt", "bunte", "buntes", "bunten"}));
  
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, ([MAT_SILK: 80, MAT_MISC_HERBAL: 20]));
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 600);
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_MAX_SIZE : 90, P_RACE: "Fee"]));
}
