// Armour meines Gesellenstueckes "Wolkenstadt"

#include "../def.h"

inherit "std/armour";

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine gruene Socke");
  SetProp(P_LONG,
	  "Eine einfache, gruene Baumwollsocke.");
  SetProp(P_INFO, "Du bemerkst ein huebsches, feines Erdbeerenmuster.");
  SetProp(P_NAME, "Socke");
  SetProp(P_NAME_ADJ, "gruen");
  SetProp(P_GENDER, FEMALE);
  AddId(({"socke", "baumwollsocke","erdbeersocke"}));
  AddAdjective(({"gruen", "gruene", "gruener", "gruenen"}));
  
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]));
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 50);
}

