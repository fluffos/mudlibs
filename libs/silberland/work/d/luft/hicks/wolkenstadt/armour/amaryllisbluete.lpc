// Armour - "Wolkenstadt"

#include "../def.h"

inherit ARMOUR "stdbluete";

void create() 
{
  if (!is_clone(TO)) return;

  SetProp(P_NAME, "Amaryllisbluete");

  ::create();
  
  SetProp(P_SHORT, "Eine Amaryllisbluete");
  SetProp(P_LONG,
	  "Eine wunderschoene, blutrote Amaryllisbluete, deren riesigen "
	  "Kelchbluetenblaetter einen goldgelben Stempel umringen. Sie wuerde "
	  "das Haupt eines jeden Traegers auf beste Weise hervorheben.");

  SetProp(P_NAME_ADJ, "blutrot");

  AddId("amaryllisbluete");
  AddAdjective(({"blutrot", "blutrote", "blutroter", "blutroten"}));

  AddDetail( ({"blaetter","kelchbluetenblaetter","bluetenblaetter"}),
	   "Die riesigen Bluetenblaetter sind von feinen Linien durchzogen.");
 
  AddDetail( ({"linien"}),
	   "Die Linien sind weiss und und ziehen sich von innen nach aussen.");
	   
  AddDetail( ({"stempel"}),
	   "Du erkennst, bei genauerem Hinsehen, einen feinen Bluetenstaub.");

  AddDetail( ({"bluetenstaub","staub"}),
	   "Er flirrt und schimmert ganz sanft und ergibt ein belebtes "
	   "Farbenspiel.");

  AddDetail( ({"farbenspiel","spiel"}),
	   "Du bist fasziniert!!!");

  AddDetail( ({"haupt"}),
	   "Vielleicht auch Dein Haupt?");

  AddDetail( ({"traeger","traegers"}),
	    "Damit bist Du gemeint." );

  AddDetail( ({"weise"}),
	   "Auch Du darfst Dich schmuecken."); 
  
  SetProp(P_SMELL, "Sie riecht fast nach gar nichts, aber einen leichten "
		  "blumigen \nGeruch erkennst Du.\n");

}
