// Armour - "Wolkenstadt"

#include "../def.h"

inherit ARMOUR "stdbluete";

void create() 
{
  if (!is_clone(TO)) return;

  SetProp(P_NAME, "Jasminbluete");

  ::create();
  
  SetProp(P_SHORT, "Eine Jasminbluete");
  SetProp(P_LONG,
	  "Eine wunderschoene, weisse Jasminbluete, deren Blaetter den "
	  "goldgelben Stempel umranden. Sie wuerde das Haupt eines jeden "
	  "Traegers auf beste Weise hervorheben.");

  SetProp(P_NAME_ADJ, "weiss");

  AddId("jasminbluete");
  AddAdjective(({"weiss", "weisse", "weisser", "weissen"}));

  AddDetail( ({"blaetter"}),
	   "Die weissen, zarten Blaetter wirken sehr filigran.");

  AddDetail( ({"stempel"}),
	   "Du erkennst, bei genauerem Hinsehen, einen feinen Bluetenstaub.");

  AddDetail( ({"bluetenstaub","staub"}),
	   "Er flirrt und schimmert ganz sanft und ergibt ein belebtes "
	   "Farbenspiel.");

  AddDetail( ({"farbenspiel","spiel"}),
	   "Du bist fasziniert!!!");

  AddDetail( ({"haupt"}),
	   "Vielleicht auch Dein Haupt?");

  AddDetail( ({"traeger","traegers"}),
	    "Damit bist Du gemeint." );

  AddDetail( ({"weise"}),
	   "Auch Du darfst Dich schmuecken.");  
  
  SetProp(P_SMELL, "Sie riecht wunderbar frisch.\n");
  
}

