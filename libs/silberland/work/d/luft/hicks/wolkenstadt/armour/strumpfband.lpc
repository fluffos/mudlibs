// 20.1.2004
// 
// Armour meines Gesellenstueckes "Wolkenstadt"

#include "../def.h"

inherit "std/armour";

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein blutrotes Strumpfband");
  SetProp(P_LONG,
	  "Es besteht aus einer verruchten, blutroten Seidenspitze und hat "
	  "Rosenmotive. Du kannst die Blueten, die Staengel und die Dornen sogar "
	  "erkennen. Ein rosa Satinband zieht sich durch die Spitze durch und gibt "
	  "dem Ganzen eine verspielte Nuance.");
  SetProp(P_NAME, "Strumpfband");
  SetProp(P_GENDER, NEUTER);
  AddId(({"strumpfband","band"}));
  
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 200);
  
  //-----Details Anfang-----
  
  AddDetail( ({"seidenspitze","spitze"}),
	     "Sie ist ganz weich und besteht aus lauter Rosenmotiven.");
  
  AddDetail( ({"rosenmotive","rosenmotiven","motive"}),
	     "Die Blueten sitzen auf den Staengel und schlaengeln sich entlang "
	     "dem Satinband.");
  
  AddDetail( ({"blueten"}),
	     "Die Blueten sehen aus als waeren sie in Blut getraenkt worden.");
  
  AddDetail( ({"blut"}),
	     "Natuerlich sind die Blueten nicht in Blut getraenkt worden. "
	     "Oder doch?");
  
  AddDetail( ({"staengel"}),
	     "Die Staengel sind mit hauchduennen Dornen besetzt.");
  
  AddDetail( ({"dornen"}),
	     "Sie stechen spitz aus der Spitze heraus. Ob du es wagen kannst die "
	     "Dornen zu beruehren?");
  
  AddDetail( ({"satinband","band","satin"}),
	     "Das rosa Satinband wirkt beinahe unschuldig verspielt.");
  
  AddDetail( ({"ganzen"}),
	     "Das ganze Strumpfband ist gemeint.");

  AddDetail( ({"nuance"}),
	     "Das heisst es wirkt ein wenig verspielt.");
  
  //-----Details Ende-----
  
  AddCmd( ({"beruehre","beruehr"}), "cmd_dornen");
  
}

int cmd_dornen(string str)     
{
  notify_fail("Was willst Du genau beruehren?\n");
  
  if(!(str=="dornen"||
       str=="spitze"||
       str=="strumpfband"||
       str=="band")) 
    return 0;
  
  if(TP->QueryProp(P_HP) < 10)
    {
      write(BS("Hast Du nicht schon genug vollgeblutet?"));
      
      return -1;
    }
  
  write(BS("Du streichst mit den Fingern ueber die Dornen. AUTSCH!!! Du hast "
	   "Dich gestochen. Das Blut sickert so schnell in das Strumpfband "
	   "ein als wuerde es aufgesogen werden. Jetzt weisst Du woher die "
	   "Farbe ist."));
  
  say(BS(TPN+" beruehrt ein blutrotes Strumpfband."));
  
  TP->AddHp(-5);
  
  return 1;
}
