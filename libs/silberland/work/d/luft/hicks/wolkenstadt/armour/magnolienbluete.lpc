// Armour - "Wolkenstadt"

#include "../def.h"

inherit ARMOUR "stdbluete";

void create() 
{
  if (!is_clone(TO)) return;

  SetProp(P_NAME, "Magnolienbluete");

  ::create();
  
  SetProp(P_SHORT, "Eine Magnolienbluete");
  SetProp(P_LONG,
	  "Eine wunderschoene, dunkelrosane Magnolienbluete, deren Blaetter eine sehr "
	  "grosse Knospe bilden. Sie wuerde das Haupt eines jeden "
	  "Traegers auf beste Weise hervorheben.");

  SetProp(P_NAME_ADJ, "dunkelrosan");

  AddId("magnolienbluete");
  AddAdjective(({"dunkelrosa", "dunkelrosane", "dunkelrosaner", "dunkelrosanen"}));

  AddDetail( ({"blaetter"}),
	   "Die dunkelrosa Blaetter sind sehr gross und haben noch eine "
	   "Knospe gebildet.");

  AddDetail( ({"knospe", "knospen"}),
	   "Diese Magnolienknospe scheint von einem Baum abgebrochen worden zu sein.");

  AddDetail( ({"baum"}),
	   "Vielleicht ein Magnolienbaum?");

  AddDetail( ({"magnolienbaum"}),
	   "Er scheint sehr selten zu sein, da er nur kurz Knospen traegt.");

  AddDetail( ({"haupt"}),
	   "Vielleicht auch Dein Haupt?");

  AddDetail( ({"traeger","traegers"}),
	    "Damit bist Du gemeint." );

  AddDetail( ({"weise"}),
	   "Auch Du darfst Dich schmuecken.");  
  
  SetProp(P_SMELL, "Sie riecht wunderbar mild, zart - einfach toll!\n");

}

