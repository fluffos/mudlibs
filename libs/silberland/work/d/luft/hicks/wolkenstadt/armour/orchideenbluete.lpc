// Armour - "Wolkenstadt"

#include "../def.h"

inherit ARMOUR "stdbluete";

void create() 
{
  if (!is_clone(TO)) return;

  SetProp(P_NAME, "Orchideenbluete");

  ::create();
  
  SetProp(P_SHORT, "Eine Orchideenbluete");
  SetProp(P_LONG,
	  "Eine wunderschoene, gelbgruenliche Orchideen, deren Blaetter einen "
	  "inneres Bluetenblatt umschlingen. Sie wuerde das Haupt eines jeden "
	  "Traegers auf beste Weise hervorheben.");

  SetProp(P_NAME_ADJ, "gelbgruenlich");

  AddId("orchideenbluete");
  AddAdjective(({"gelbgruenlich", "gelbgruenliche", "gelbgruenlicher", "gelbgruenlichen"}));

  AddDetail( ({"blaetter"}),
	   "Die Blätter umschlingen ein einziges Bluetenblatt, das wahrscheinlich "
	   "den Stempel darstellen soll.");

  AddDetail( ({"bluetenblatt", "stempel"}),
	   "Dieses Bluetenblatt ist von roten Sprenkeln uebersaeht.");

  AddDetail( ({"sprenkel","sprenkeln"}),
	   "Sie sind dunkelrot, fast braeunlich und ziehen jede Aufmerksamkeit auf "
	   "sich.");

  AddDetail( ({"aufmerksamkeit"}),
	   "Deine Aufmerksamkeit hat die Orchidee schon erhalten.");

  AddDetail( ({"haupt"}),
	   "Vielleicht auch Dein Haupt?");

  AddDetail( ({"traeger","traegers"}),
	    "Damit bist Du gemeint." );

  AddDetail( ({"weise"}),
	   "Auch Du darfst Dich schmuecken.");  
  
  SetProp(P_SMELL, "Der Duft der Orchidee betoert Dich fast.\n");

}
