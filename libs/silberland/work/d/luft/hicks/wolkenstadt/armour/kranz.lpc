// 20.1.2004
// 
// Armour meines Gesellenstueckes "Wolkenstadt"

#include "../def.h"

inherit "std/armour";

void create() 
{
  
  string final_mat;
  
  if (!is_clone(TO)) return;
  ::create();
    
  final_mat=({"Blumen","Perlen","Blueten"})[random(3)];
  
  SetProp(P_SHORT, "Ein "+(final_mat)+"kranz");
  SetProp(P_LONG,
	  "Dieser "+(final_mat)+"kranz schimmert bunt im Licht. Die "+(final_mat)+" "
	  "haben viele verschiedene Farben und sind in einander huebsch verflochten.");
  SetProp(P_INFO, "Der "+(final_mat)+"kranz bringt wahrlich nur die Schoenheit einer "
	  "Fee zur Geltung.");
  SetProp(P_NAME, "Kranz");
  SetProp(P_GENDER, MALE);
  AddId(({lower_case(final_mat+"kranz"), "kranz"}));
  
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([MAT_MISC_HERBAL:50,MAT_PEARL:50]));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 300);
  SetProp(P_QUALITY_DECAY, 30);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_MAX_SIZE : 90, P_RACE: "Fee"]));
  
}
