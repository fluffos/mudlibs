// Armour meines Gesellenstueckes "Wolkenstadt"

#include "../def.h"

inherit "std/armour";

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
    
  SetProp(P_SHORT, "Ein Perlendiadem");
  SetProp(P_LONG,
	  "Dieses Perlendiadem wirkt sehr grazil. Es hat ein schoenes, zierliches "
	  "Blumenornamentmuster und schimmert in verschiedenen Pastellfarben.");
  SetProp(P_INFO, "Das Perlendiadem bringt wahrlich nur die Schoenheit einer "
	  "Fee zur Geltung.");
  SetProp(P_NAME, "Perlendiadem");
  SetProp(P_GENDER, NEUTER);
  AddId(({"diadem","perlendiadem"}));
  
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_PEARL:95, MAT_SILVER: 5]));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 300);
  SetProp(P_QUALITY_DECAY, 30);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_MAX_SIZE : 90, P_RACE: "Fee"]));
  
}
