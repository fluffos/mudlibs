// 22.7.2005// 
// NPC - "Wolkenstadt"

inherit "std/npc";

#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Ein rosaroter Frosch");
  SetProp(P_LONG, "Das scheint irgendwie ein besonderer Frosch zu sein.");
  SetProp(P_NAME, "Frosch");
  SetProp(P_GENDER, MALE);
  AddClass(({CL_ANIMAL, CL_SWIMMING}));
  AddId ( ({"frosch","rosaroter frosch","nerine"}));

  create_default_npc(1);
  SetProp(P_RACE, "Frosch");
  SetProp(P_SIZE, 5);
  SetProp(P_WEIGHT, 10);
  SetProp(P_ALIGN, 850);
  SetProp(P_NOATTACK, "flutscht Dir durch die Finger und quakt empoert.");
  
  SetProp(P_MSGIN, "huepft herein: Nicht so schnell");
  SetProp(P_MSGOUT, "hupeft davon");
  SetProp(P_MMSGIN, "springt herein und quakt");
  SetProp(P_MMSGOUT, "zerplatzt");

  AddInfo(DEFAULT_INFO, "quakt zurueck.\n");

  AddInfo( ({"hilfe"}),
	   "Ich heisse Nerine und wurde verflucht. Kannst Du mich befreien?","fragt: ");

  AddInfo( ({"befreiung"}),
	   "Ich weiss nicht, was man da machen kann, aber Du bist mein "
	   "Retter.","schluchzt: ");

  AddInfo( ({"retter"}),
	   "Ich weiss, Du kannst mir helfen. Ich weiche nicht von "
	   "Deiner Seite","quakt: ");

  AddInfo( ({"seite"}),
	   "Nein, ich weiche nicht von Deiner Seite.","sagt bestimmt: ");

  AddInfo( ({"fluch"}),
	   "Ich weiss es nicht, ich kann mich an nichts erinnern, aber ich "
	   "weiss, dass ich anders ausgesehen habe.","schluchzt: ");

  AddInfo( ({"nerine"}),
	   "Ich bin ein kleines Feenmaedchen und habe in der Wolkenstadt "
	   "gespielt.","erzaehlt: ");

  AddInfo( ({"feenmaedchen","maedchen","fee"}),
	   "Jetzt bin ich ein rosaroter Frosch!","weint: ");

  AddInfo( ({"wolkenstadt","stadt"}),
	   "Ich habe gespielt und dann kann ich mich an nichts mehr erinnern."
	   " Es ist wie ein Fluch.","seuft: ");
 		
  SetChats(3, ({
    "Der rosarote Frosch jammert: 'Buhuu, wieso bin ich ein Frosch?'\n",
      "Der rosarote Frosch huepft hin und her.\n",
      "Der rosarote Frosch schluchzt: 'Kannst Du mir nicht helfen?'\n",
      "Der rosarote Frosch quakt tief und hingebungsvoll.\n",
      "Der rosarote Frosch blinzelt Dich mit grossen Kulleraugen an.\n"}));
  
  SetProp( P_REJECT, ({REJECT_DROP,
			 "Das ist dem rosaroten Frosch zu schwer.\n" }) );

  AddCmd( ({"kuesse","kuess"}),"cmd_kuessen");
  
}  

void StartReaction(string verb, string gruppe, string adverb, int touch)     
{
  if (find_call_out("react")!= -1)
    return;
  
  
  switch(gruppe)
    {
    case "fies": 
      call_out("react", 0, "schnalzt mit seiner Zunge nach Dir.",
	       "schnalzt mit seiner Zunge nach "+TP->Name(WEM)+".");
      break; 
      
    case "aergerlich":
      call_out("react", 0, "quakt zornig: WAS SOLL DAS?",
               "quakt zornig: WAS SOLL DAS?");
      break;
      
    case "frech":
      call_out("react", 0, "springt Dir auf den Kopf.",
               "springt "+TP->Name(WEM)+" auf den Kopf.");
      break;
      
    case "nett":
      call_out("react", 0, "schluchzt: Daaas iiist aaaber lieeeb vooon Diiir!",
               "schluchzt "+TP->Name(WEM)+" zu: Daaas iiist aaaber lieeeb vooon Diiir!");
      break;
      
    case "froh":
      call_out("react", 0, "weint vor Freude.",
               "weint vor Freude.");
      break;
      
    default:
      call_out("react", 0, "quaaaackt.",
	       "quaaaakt.");
      break;
    }
}

void react(string victim, string others)     
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)	
{
  return StartReaction(verb, gruppe, adverb, touch);
}


int cmd_kuessen(string str)
{
  notify_fail("Wen willst Du kuessen?\n");
  
  if(!id(str)) 
    return 0;
  
  tell_object(TP,"Du kuesst den rosaroten Frosch.\n\nP L O P P ! ! !\n\nDer rosarote Frosch "
    "verwandelt sich zu einer jungen Fee: 'Danke, dass Du mich\nerloest hast!' Sie umarmt "
    "Dich kurz und verschwindet winkend zu ihrer Familie.\n");

  tell_room(ENV(TP),TPN+" kuesst den rosaroten Frosch.\n\nP L O P P ! ! !\n\nDer rosarote Frosch "
    "verwandelt sich zu einer jungen Fee: 'Danke, dass\nDu mich erloest "
    "hast!' Sie umarmt "+TPN+" kurz und verschwindet "
    "winkend zu ihrer\nFamilie.\n",({TP}));

  TP->SetProp(P_FROG, 1);

  remove();

  return 1;
}

