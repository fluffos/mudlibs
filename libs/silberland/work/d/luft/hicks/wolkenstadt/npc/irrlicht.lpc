// NPC meines Gesellenstueckes "Wolkenstadt"

inherit "std/mnpc";
inherit "std/npc/spells";

#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Irrlicht");
  SetProp(P_LONG, "Es ist ein kleiner, heller Lichtball.");
  SetProp(P_NAME, "Irrlicht");
  SetProp(P_GENDER, NEUTER);
  AddId(({"irrlicht","licht"}));
  AddClass(CL_FLYING);
  
  AddDetail( ({"lichtball","ball"}),
	     "Du erkennst ein kleines, schlankes Wesen in dem Ball.");
  
  AddDetail( ({"wesen"}),
	     "Ein kleines Maedchen ist das. Sie hat nichts an, aber das Licht "
	     "blendet Dich genug um nur ihr Gesicht und ihre Figur zu "
	     "erkennen.");
  
  AddDetail( ({"maedchen"}),
	     "An der Figur erkennst Du, dass es ein Maedchen ist.");
  
  AddDetail( ({"gesicht"}),
	     "Sie laechelt Dich an und spricht mit Dir. Leider verstehst Du "
	     "sie nicht, da es nur ein leises summen und quietschen ist.");
  
  AddDetail( ({"figur"}),
	     "Das Maedchen ist wirklich schlank und hat eine huebsche Figur.");
  
  create_default_npc(2+random(3));
  SetProp(P_HANDS, ({" mit Licht an",20,DT_LIGHT}));
  SetProp(P_RACE, "Irrlicht");
  SetProp(P_SIZE, 3);
  SetProp(P_WEIGHT, 1);
  SetProp(P_ALIGN, 850);
  SetProp(P_WIMPY, 1);
  SetProp(P_NOCORPSE, 1);

  SetProp(P_RESISTANCE_STRENGTHS , 
	  ([DT_FIRE:      0.0,  DT_COLD:      0.0,  DT_WATER:  0.0, DT_AIR:    0.0, 
	    DT_LIGHTNING: 0.0,  DT_EXPLOSION: 0.0,  DT_SOUND:  0.0, DT_LIGHT: -1.0,
	    DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.0, DT_TERROR: 0.0,
	    DT_HOLY:     -0.3,  DT_UNHOLY:    0.3,  DT_MAGIC:  0.0, DT_MIND:   0.0]));

  SetProp(P_NOMAGIC,0);
  
  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "lockt Dich");
  SetProp(P_MMSGIN, "entsteht aus gesammeltem Licht");
  SetProp(P_MMSGOUT, "zerfaellt in Lichtstrahlen");
  
  SetProp(P_MNPC_AREA, ({ ROOM "ws", ROOM "wst", ROOM "wh1"}));
  SetProp(P_MNPC_WAIT, ({ 15, 20, 15}));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "wst1");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INFIGHT);
  
  SetProp(P_DIE_MSG,  " loest sich in Luft auf.\n");
  SetProp(P_KILL_MSG, "Das hat wohl weh getan???");
  SetProp(P_MURDER_MSG, "%s, das naechste Mal werde ich nicht mehr so nachsichtig mit\n"
	  "Dir sein!");
  
  AddInfo(DEFAULT_INFO, "quietscht zurueck.\n");
  
  SetProp( P_REJECT, ({REJECT_DROP,
			 "Das ist dem Irrlicht zu schwer.\n" }) );
  
  SetChats(3, ({
    "Das Irrlicht fliegt im Zick-Zack hin und her.\n",
      "Das Irrlicht summt und quietscht leise.\n",
      "Das Irrlicht lockt Dich in ihre Naehe.\n",
      "Das Irrlicht betoert Dich mit ihrem Summen.\n",
      "Das Irrlicht fluestert Dir: Folge mir! Ich zeige Dir den rechten Weg.\n"}));
  
  SetAttackChats(10, ({
    "Das Irrlicht flammt kurz auf.\n",
      "Das Irrlicht quietscht zornig.\n",
      "Das Irrlicht schwirrt wild hin und her.\n"}));
  
  // ----- Spells Anfang -----
  
  SetProp(P_SPELLRATE, 10);
  
  AddDefaultSpell(1, 100, DS_BLIND,
                  "Das Irrlicht flammt auf und blendet Dich.\n",
		  "Das Irrlicht flammt auf und blendet @WEN.\n");
  
  // ----- Spells Anfang -----
  
}

void StartReaction(string verb, string gruppe, string adverb, int touch)     
{
  if (find_call_out("react")!= -1)
    return;
  
  
  switch(gruppe)
    {
    case "fies": 
      call_out("react", 0, "blendet Dich, in dem sie aufleuchtet.",
	       "blendet "+TP->Name(WEN)+ ", in dem sie aufleuchtet.");
      break; 
      
    case "aergerlich":
      call_out("react", 0, "quietscht zornig auf.",
               "quietscht zornig auf.");
      break;
      
    case "frech":
      call_out("react", 0, "schwirrt um Dich herum.",
               "schwirrt um "+TP->Name(WEN)+" herum.");
      break;
      
    case "nett":
      call_out("react", 0, "schenkt Dir einen Lichtregen.",
               "schenkt "+TP->Name(WEM)+" einen Lichtregen.");
      break;
      
    case "froh":
      call_out("react", 0, "summt Dich vergnuegt an.",
               "summt "+TP->Name(WEN)+" vergnuegt an.");
      break;
      
    default:
      call_out("react", 0, "entwischt Dir im letzten Moment und piepst wild.",
	       "entwischt "+TP->Name(WEM)+" im letzten Moment und piepst wild.");
      break;
    }
}

void react(string victim, string others)     
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)	
{
  return StartReaction(verb, gruppe, adverb, touch);
}
