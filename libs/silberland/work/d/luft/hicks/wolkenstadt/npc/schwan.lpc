// 20.1.2004
// 
// NPC meines Gesellenstueckes "Wolkenstadt"

inherit "std/npc";


#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Schwan");
  SetProp(P_LONG, "Das ist ein zauberhafter, majestaetischer Schwan. "
	  "Er hat einen sanftgeschwungenen Hals und einen zierlichen "
	  "Kopf. Sein Gefieder fasziniert Dich. Du kannst Deinen Blick "
	  "nicht abwenden und bewunderst ihn immer wieder.");
  SetProp(P_NAME, "Schwan");
  SetProp(P_GENDER, MALE);
  AddId("schwan");
  AddClass(CL_FLYING);
  
  AddDetail( ({"hals"}),
	     "Er ist sanftgeschwungen und wohlgeformt.");
  
  AddDetail( ({"kopf"}),
	     "Kluge, schwarze Augen blicken Dich an. Ein zarter, "
	     "geschwungener Schnabel ziert den Kopf. Du spuerst seine "
	     "Sanftmut und seine Klugheit.");
  
  AddDetail( ({"augen"}),
	     "Sie blicken direkt in die Tiefe Deiner Seele.");
  
  AddDetail( ({"schnabel"}),
	     "Der Schnabel schimmert seidig hell in der Sonne.");
  
  AddDetail( ({"sanftmut"}),
	     "Das ist das sanfteste Wesen, das Dir untergekommen ist.");
  
  AddDetail( ({"klugheit"}),
	     "Ein ausserst kluges Wesen, fast magisch.");
  
  AddDetail( ({"wesen"}),
	     "Der Schwan ist ein zauberhaftes Wesen.");
  
  AddDetail( ({"gefieder","federn"}),
	     "Seine perlmuttfarbenen Federn sind von einer saphirblauem Aura "
	     "umgeben, sodass sie magisch wirken.");
  
  AddDetail( ({"aura"}),
	     "Die Aura wirkt magisch.");
  
  AddDetail( ({"blick"}),
	     "Du blickst immer wieder zu ihm fasziniert hin.");

  create_default_npc(5);
  SetProp(P_HANDS, ({" mit seinem Schnabel",50,DT_PIERCE}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 30);
  SetProp(P_WEIGHT, 3000);
  SetProp(P_ALIGN, 850);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_NOMAGIC,25);
  
  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "watschelt");
  SetProp(P_MMSGIN, "erscheint aus dem Schilf");
  SetProp(P_MMSGOUT, "verschwindet im Schilf");
  
  SetProp(P_DIE_MSG, " tanzt seinen letzten Tanz.\n");
  SetProp(P_KILL_MSG, "Wir Schwaene sind die edlesten Geschoepfe!");
  SetProp(P_MURDER_MSG, "Ich mache mal Urlaub. Bis spaeter!!!");
  
  AddInfo(DEFAULT_INFO, "blickt Dich klug an.\n");

  SetProp( P_REJECT, ({REJECT_DROP,
			 "Das ist dem Schwan zu schwer.\n" }) );
  
  SetChats(3,({
    "Der Schwan laesst sich im Wasser treiben.\n",
      "Der Schwan putzt galant sein Gefieder.\n",
      "Der Schwan steckt seinen Kopf ins Gefieder und schlaeft.\n",
      "Der Schwan lockert flatternd seine Fluegel auf.\n",
      "Der Schwan knabbert an einer Seerose.\n"}));
  
  SetAttackChats(5,({
    "Der Schwan schnattert wuetend.\n",
      "Der Schwan verflucht alle boesen Seelen.\n",
      "Der Schwan flattert drohend auf.\n"}));
  
  // ----- Spells -----
  SetProp(P_SPELLRATE, 25);
  
  AddSpell(1, 200, "Die heilige Aura des Schwans verbrennt Dich.\n",
	   "Die heilige Aura des Schwans verbrennt @WEN.\n",
           ({DT_HOLY, DT_FIRE}), ([SP_SHOW_DAMAGE:1]));
  
  // ----- Spells Ende -----
  
  SUID;
  CLONEME(OBJ "sfeder");
  
}

void StartReaction(string verb, string gruppe, string adverb, int touch)	
{
  if (find_call_out("react")!= -1)
    return;
  
  
  switch(gruppe)
    {
    case "fies": 
      call_out("react", 0, "schnattert Dich wild an.", "schnattert " +
	       TP->Name(WEN) + " wild an.");
      break; 
      
    case "aergerlich":
      call_out("react", 0, "schnappt nach Dir.",
	       "schnappt nach " + TP->Name(WEM) +
	       " mit seinem Schnabel.");
      break;
      
    case "frech":
      call_out("react", 0, "ignoriert dich.",
	       "ignoriert "+TP->Name(WEN)+" .");
      break;
      
    case "nett":
      call_out("react", 0, "mustert Dich klug.",
	       "mustert "+TP->Name(WEN)+" klug.");
      break;
      
    case "froh":
      call_out("react", 0, "schmiegt seinen Schnabel an Deinem Bein.",
	       "schmiegt seinen Schnabel an "+TP->Name(WEN)+" Bein.");
      break;
      
    default:
      call_out("react", 0, "steckt den Kopf ins Gefieder.",
	       "steckt den Kopf ins Gefieder.");
      break;
    }
}

void react(string victim, string others)    
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
    }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)	
{
  return StartReaction(verb, gruppe, adverb, touch);
}
