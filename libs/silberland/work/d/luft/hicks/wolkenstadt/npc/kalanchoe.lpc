inherit "std/npc/spells";
inherit "/p/std/npc/zechpreller_npc";

#include "../def.h"

#include <lightsource.h>

void create() {
	
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Kalanchoe, die Wachfee");
  SetProp(P_LONG,
    "Kalanchoe wirkt gelangweilt und gaehnt andauernd. Sie duerfte im Moment "
    "ihren Wachdienst schieben. Eine unangenehme Ausduenstung geht von ihr aus.");
  SetProp(P_NAME, "Kalanchoe");
  SetProp(P_GENDER, FEMALE);
//Yara npc bewegt sich nicht, keine temperatursettings noetig
//  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:40]));
  AddId(({"kalanchoe","wachfee","fee"}));
  AddClass(({CL_FLYING, CL_FAIRY}));

  AddDetail( ({"moment"}),
	    "Gerade jetzt scheint sie wohl ihren Wachdienst zu schieben.");

  AddDetail( ({"wachdienst","dienst","wache"}),
	    "Sie scheint gelangweilt zu sein und muede.");

  AddDetail( ({"ausduenstung"}),
	    "Igitt, das stinkt. Aber vielleicht kannst Du mal an ihr "
	    "riechen.");

  AddDetail( ({"alkohol"}),
	    "Du hast noch nie so eine versoffene Zechprellerfee gesehen.");

  AddDetail( ({"zechprellerfee","zechifee"}),
	    "Sie ist besoffen und stinkt. Gott sei dank groehlt sie nicht.");
 
  AddDetail( ({"alkohol"}),
	   "Du hast noch nie so eine versoffene Zechprellerfee gesehen.");
  
  create_default_zechpreller(25+random(5), 6);
//Yara
//  SetProp(P_HANDS, ({" mit ihren blossen Haenden an",200,DT_MAGIC}));
  SetProp(P_HANDS, ({" mit ihren blossen Haenden",200,DT_MAGIC}));

  SetProp(P_RACE, "Fee");
  SetProp(P_SIZE, 40);
  SetProp(P_WEIGHT, 3000);
  SetProp(P_ALIGN, 850);
  SetProp(P_MAX_HANDS, 2);
  
  SetProp(P_ARTICLE, 0);
 
    SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.5,  DT_COLD:     -0.3,  DT_WATER: -0.3,  DT_AIR:   -0.5, 
      DT_LIGHTNING: 0.0,  DT_EXPLOSION: 0.0,  DT_SOUND:  0.0,  DT_LIGHT: -0.5,
      DT_ELECTRIC:  0.0,  DT_ACID:     -0.1,  DT_POISON:-0.1,  DT_TERROR: 0.0,
      DT_HOLY:     -0.3,  DT_UNHOLY:    0.3,  DT_MAGIC:  0.0,  DT_MIND:   0.0]));

  SetProp(P_NOMAGIC,50);

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "tritt aus einem Blumenregen");
  SetProp(P_MMSGOUT, "niest Dir ins Gesicht und ist futsch");

  SetProp(P_DIE_MSG, " haucht ihren letzten Alkoholdunst aus.\n");
  SetProp(P_KILL_MSG, "Nerv wen anderen... *gaehn*");
  SetProp(P_MURDER_MSG, "Ach %s, haettest Du mich doch in einem Weinfass ertraenkt!\n");
  SetProp(P_FORCE_MURDER_MSG, 1);
  SetProp(P_HEAL, 5);
  SetProp(P_SMELL, "Sie stinkt eindeutig nach abgestandenem Alkohol.\n");
  
  AddInfo(DEFAULT_INFO, "gaehnt herzhaft.\n");
  
  AddInfo( ({"hicks"}), 
	  "Das hat alles Hicks gemacht.\n","plappert: ");

  AddInfo( ({"sodbrennen","brennen"}),
	   "Ja, ich habe oft Sodbrennen, aber da helfen *HICKS* sehr gut solche "
	   "Kautabletten.","murmelt: ");

  AddInfo( ({"kautablette","tablette","tabletten","kautabletten"}),
	   "Sie sind ro*HICKS*-hosa. Wenn Du eine moechtest, dann darfst Du "
	   "mich um eine bitten.","sagt: ");

   
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das ist Kalanchoe zu schwer.\n" }) );

  SetChats(3, ({
    "Kalanchoe nickt ein und kippt nach vor.\n",
    "Kalanchoe schnarcht.\n",
    "Kalanchoe flattert gelangweilt in der Runde herum.\n",
    "Kalanchoe gaehnt vor sich hin.\n",
    "Kalanchoe ruelpst laut auf.\n",
    "Kalanchoe hickst.\n",
    "Kalanchoe schmatzt im Schlaf.\n",
    "Kalanchoe wacht auf und goennt sich einen Schluck Alkohol.\n"}));
  
  SetAttackChats(10, ({
    "Kalanchoe schwingt ihre brennende Fackel herum.\n",
    "Kalanchoe flucht: LASS MICH DOCH IN RUHE!!!\n",
    "Kalanchoe groehlt vor Wut.\n"}));


  SetProp(P_SPELLRATE, 30);
  
  AddCmd( ({"bitte"}),"cmd_bitten");
  
  SUID;
  CLONEME(ARMOUR "feenkleid");
  switch(random(3))
  {
    case 0: CLONEME(ARMOUR "blumenhaube");
     break;
    case 1: CLONEME(ARMOUR "kranz");
     break;
    case 2: CLONEME(ARMOUR "diadem");
     break;
  }
  command("trage alles");

  enable_commands();
  CLONEME("/obj/fackel");
}

int Defend(int dam, string *dam_type_list, mixed spell, object enemy)
{
  object fackel;
  
  if(!fackel=present("fackel")) //haben wir schon eine fackel?
    {
      fackel=clone_object("/obj/fackel"); //wenn nein, dann eine neue clonen
      fackel->move(ME, M_NOCHECK); //und in die fee moven
    }
  
  if(!fackel->QueryProp(P_LIGHTED)) //Ist die Fackel angezuendet?
    command_me("zuende fackel an"); //wenn nein, dann bitte anzuenden.
  
  return ::Defend(dam, dam_type_list, spell, enemy); //muss sein
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "belegt Dich mit einem Fluch.",
	 "belegt "+TP->Name(WEN)+" mit einem Fluch.");
      break; 

    case "aergerlich":
      call_out("react", 0, "zieht Dich am Haar.",
        "zieht "+TP->Name(WEM)+" am Haar.");
    break;

    case "frech":
      call_out("react", 0, "zeigt Dir die Zunge",
        "zeigt "+TP->Name(WEM)+" die Zunge.");
    break;

    case "nett":
      call_out("react", 0, "erroetet und kichert verschmitzt.",
        "erroetet und kichert verschmitzt.");
    break;

    case "froh":
      call_out("react", 0, "flattert eine Schraube um Dich.",
        "flattert eine Schraube um "+TP->Name(WEM)+".");
    break;

    default:
      call_out("react", 0, "kitzelt Dich. Du versuchst, Dich zu beherrschen, "
        "musst aber doch lachen.",
        " kitzelt "+TP->Name(WEN)+". "+TP->Name(WER)+" versucht, sich zu "
	"beherrschen, muss aber doch lachen.");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

int cmd_bitten(string str)
{
  object kautablette;

//Yara
//  notify_fail("Was willst Du fangen?\n");
  notify_fail("Wen willst Du worum bitten?\n");
  
  if(!(str=="kalanchoe um kautablette"||
       str=="kalanchoe um tablette"||
       str=="kalanchoe um rosa kautablette"||
       str=="kalanchoe um rosa tablette"||
       str=="fee um kautablette"||
       str=="fee um tablette"||
       str=="fee um rosa kautablette"||
       str=="fee um rosa tablette")) 
    return 0;
  
  if (present("kautablette",TP))
  {
    tell_object(TP,BS("Kalanchoe sagt: Schlucke zuerst diese, die Du schon hast. Dann "
        "bekommst Du eine neue."));
  
    tell_room(ENV(TP),BS("Kalanchoe sagt zu "+TPN+": Schluck zuerst diese, die Du schon hast. "
     		          "Dann bekommst Du eine neue."),({TP}) );
  
    return -1;
  }
  
  kautablette=clone_object(OBJ "kautablette");

  if (ME_TOO_HEAVY==kautablette->move(TP,M_GET))
  {
    tell_object(TP,BS("Kalanchoe gibt Dir eine Tablette, die Dir zu Boden faellt."));
      
    tell_room(ENV(TP),BS("Kalanchoe gibt "+TPN+" eine Tablette, die"
      " "+CAP(TP->QueryPronoun(WEM))+" zu Boden faellt."),({TP}) );
      
    kautablette->move(TO, M_NOCHECK|M_SILENT);
    return 1;
  }
  else
  {
    tell_object(TP,BS("Kalanchoe sagt: Da hast Du eine, und gute Besserung! und ueberreicht Dir eine "
      			"Tablette."));
  
    tell_room(ENV(TP),BS("Kalanchoe sagt zu "+TPN+": Da hast Du eine, und gute Besserung! und ueberreicht"
      			" "+CAP(TP->QueryPronoun(WEM))+" eine Tablette."),({TP}) );

    return 1;
  }
}

