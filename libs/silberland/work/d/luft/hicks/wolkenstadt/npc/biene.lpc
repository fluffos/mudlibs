// 20.1.2004
// 
// NPC meines Gesellenstueckes "Wolkenstadt"

inherit "std/mnpc";

#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Biene");
  SetProp(P_LONG, "Die kleine, suesse Biene hat ein frohes Gemuet. Sie ist ganz aus "
	  "Kristall und sehr zart. Sie holt sich ihren Nektar von Blume zu Blume.");
  SetProp(P_NAME, "Biene");
  SetProp(P_GENDER, FEMALE);
  AddId("biene");
  AddClass(CL_FLYING);
  
  create_default_npc(1+random(2));
  SetProp(P_HANDS, ({" mit ihren Fluegeln",30,DT_BLUDGEON}));
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 2);
  SetProp(P_WEIGHT, 6);
  SetProp(P_MATERIAL, MAT_CRYSTAL);
  SetProp(P_ALIGN, 850);
  SetProp(P_MAX_HANDS, 6);
   
  SetProp(P_MSGIN, "schwirrt herein");
  SetProp(P_MSGOUT, "schwirrt");
  SetProp(P_MMSGIN, "hebt von einer Blume ab");
  SetProp(P_MMSGOUT, "versteckt sich im Gras");
  
  SetProp(P_MNPC_AREA, ({ ROOM "ws2", ROOM "ws4", ROOM "ws6", ROOM "ws8",
			    ROOM "ws9", ROOM "ws10", ROOM "ws11", ROOM "ws12"}));
  SetProp(P_MNPC_WAIT, ({ 15, 20, 15}));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "ws9");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INFIGHT);
  
  SetProp(P_DIE_MSG, " zerbricht in viele kleine Kristallscherben.\n");
  SetProp(P_KILL_MSG, "Ich bin eine Killer-Biene!!!");
  
  AddInfo(DEFAULT_INFO, "schaut Dich fragend an.\n");
  
  SetProp( P_REJECT, ({REJECT_DROP,
			 "Das ist der Biene zu schwer.\n" }) );
  
  SetChats(3, ({
    "Die Biene zielt auf eine Blume und holt sich den Nektar.\n",
      "Die Biene macht ein Schlaefchen auf einer Blume.\n",
      "Die Biene summt munter vor sich hin.\n"}));
  
  SetAttackChats(10, ({
    "Die Biene droht erbost mit ihrem Stachel.\n",
      "Die Biene summt zornig um herum.\n"}) );
  
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;
  
  
  switch(gruppe)
    {
    case "fies": 
      call_out("react", 0, "droht Dir mit ihrem Stachel.",
	       "droht "+TP->Name(WEM)+ " mit ihrem Stachel.");
      break; 
      
    case "aergerlich":
      call_out("react", 0, "verachtet Dich.",
               "verachtet "+TP->Name(WEN)+".");
      break;
      
    case "frech":
      call_out("react", 0, "schwirrt um Dich herum.",
               "schwirrt um "+TP->Name(WEN)+" herum.");
      break;
      
    case "nett":
      call_out("react", 0, "flauscht sich an Dich.",
               "flauscht sich an "+TP->Name(WEN)+" an.");
      break;
      
    case "froh":
      call_out("react", 0, "liebaeugelt mit Dir.",
               "liebaeugelt mit "+TP->Name(WEM)+".");
      break;
      
    default:
      call_out("react", 0, "summt ein froehliches Lied.",
	       "flattert vergnuegt herum.");
      break;
    }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
    }
}
