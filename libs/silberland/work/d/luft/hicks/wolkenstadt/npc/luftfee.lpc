// NPC meines Gesellenstueckes "Wolkenstadt"

inherit "std/npc/spells";
inherit "std/mnpc";

#include "../def.h"


void create()
{
  string final_name;
  string final_farbe;
  string final_farbe1;
  string final_haare;
  
  if (!is_clone(TO)) return;
  ::create();
  
  final_name=({"agava","alisma","aphelandra","briza","calendula","camellia",
		 "citrofortunella","clivia","cordyline","dahlia","drosera",
		 "euphorbia","felicia","forsythia","gerania","gloriosa",
		 "hippophae","hortensia","hedera","mirabilis"})[random(20)];
  
  final_farbe=({"zitronengelbe","pastellgelbe","sonnengelbe","rosa","zartrosa",
		  "lavendelfarbene","pflaumenfarbene","hellblaue","graublaue",
		  "tuerkise","maigruene","pastellgruene","hellgruene","hellgraue",
		  "lachsfarbene","zartrote","malvenfarbige","nachtblaue",
		  "violettblaue"})[random(19)]; 
  
  final_farbe1=({"zitronengelbe","pastellgelbe","sonnengelbe","rosa","zartrosa",
		   "lavendelfarbene","pflaumenfarbene","hellblaue","graublaue",
		   "tuerkise","maigruene","pastellgruene","hellgruene","hellgraue",
		   "lachsfarbene","zartrote","malvenfarbige","nachtblaue",
		   "violettblaue"})[random(19)];
  
  final_haare=({"glatte","krause","lange","lockige","kurze", "schulterlange",
		  "mittellange","wellige","fransige", "korkenzieherlockige"})[random(10)];
  
  SetProp(P_SHORT, CAP(final_name)+", die Luftfee");
  SetProp(P_LONG, "Diese suesse, kleine Fee hat "+(final_farbe)+" Augen "
	  "und wunderschoene " +(final_haare)+", "+(final_farbe1)+" Haare. "
	  "Sie ist sehr blass, zierlich und wirkt zerbrechlich. Sie laechelt "
	  "Dich lieblich an.");
  SetProp(P_NAME, "Fee "+CAP(final_name));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:40]));
  AddId(({final_name,"luftfee","fee"}));
  AddClass(({CL_FLYING, CL_FAIRY}));
  
  create_default_npc(5+random(5));
  SetProp(P_HANDS, ({" mit ihren blossen Haenden an",40,DT_MAGIC}));
  SetProp(P_RACE, "Fee");
  SetProp(P_SIZE, 40);
  SetProp(P_WEIGHT, 10000);
  SetProp(P_ALIGN, 900);
  SetProp(P_MAX_HANDS, 2);
  
  SetProp(P_RESISTANCE_STRENGTHS, 
	  ([DT_FIRE:      0.5,  DT_COLD:     -0.3,  DT_WATER: -0.3,  DT_AIR:   -0.5, 
	    DT_LIGHTNING: 0.0,  DT_EXPLOSION: 0.0,  DT_SOUND:  0.0,  DT_LIGHT: -0.5,
	    DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.0,  DT_TERROR: 0.0,
	    DT_HOLY:     -0.3,  DT_UNHOLY:    0.3,  DT_MAGIC:  0.0,  DT_MIND:   0.0]));
  
  SetProp(P_NOMAGIC,50);
  
  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "tritt aus einem Blumenregen");
  SetProp(P_MMSGOUT, "niest Dir ins Gesicht und ist futsch");
  
  SetProp(P_MNPC_AREA, ({ ROOM "ws", ROOM "wst", ROOM "wh1"}));
  SetProp(P_MNPC_WAIT, ({ 15, 20, 15}));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "wst1");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
  
  SetProp(P_DIE_MSG, " fliegt tot zu Boden.\n");
  SetProp(P_KILL_MSG, "Sei froh, dass ich Dir nicht auch noch einen Fluch an "
	  "den Hals gehetzt habe.");
  SetProp(P_MURDER_MSG, "Ich hab Dich nicht mehr lieb, %s.");
  
  AddInfo(DEFAULT_INFO, "laechelt Dich an.\n");
  
  AddInfo( ({"hicks"}), 
	   "Das hat alles Hicks gemacht.\n","plappert: ");
  
  
  SetProp( P_REJECT, ({REJECT_DROP,
			 "Das ist der Luftfee zu schwer.\n" }) );
  
  SetChats(5, ({
    
    CAP(final_name)+" laechelt Dich an.\n",
      CAP(final_name)+" gibt Dir ein Kuesschen.\n",
      CAP(final_name)+" flattert um Dich herum bis Dir schwindelig wird.\n",
      CAP(final_name)+" knuddelt Dich watteweich.\n",
      CAP(final_name)+" laesst Dich an einer Blume schnuppern.\n",
      CAP(final_name)+" zeigt mit dem Finger kichernd auf Dich.\n"}));
  
  SetAttackChats(10, ({
    CAP(final_name)+" spricht einen Fluch aus.\n",
      CAP(final_name)+" verpestet ihre Umgebung.\n",
      CAP(final_name)+" verstroemt intensivsten Bluetenduft.\n"}));
  
  // ----- Spells Anfang -----
  
  SetProp(P_SPELLRATE, 10);
  
  AddSpell(2, 100, CAP(final_name)+" bewirft Dich mit einem leuchtenden Luftpfeil.\n",
	   CAP(final_name)+" blendet @WEN mit einem leuchtenden Luftpfeil.\n",
           ({DT_AIR, DT_LIGHT}), ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2, 100, CAP(final_name)+" schleudert Dir einen Eisstrahl entgegen.\n",
	   CAP(final_name)+" schleudert @WEM einen Eisstrahl entgegen.\n",
           ({DT_WATER, DT_COLD}), ([SP_SHOW_DAMAGE:1]));
  
  // ----- Spells Ende -----
  
  SUID;
  CLONEME(ARMOUR "feenkleid");
  switch(random(3))
    {
    case 0: CLONEME(ARMOUR "blumenhaube");
      break;
    case 1: CLONEME(ARMOUR "kranz");
      break;
    case 2: CLONEME(ARMOUR "diadem");
      break;
    }
  command("trage alles");
  
}

void StartReaction(string verb, string gruppe, string adverb, int touch)	
{
  if (find_call_out("react")!= -1)
    return;
  
  
  switch(gruppe)
    {
    case "fies": 
      call_out("react", 0, "belegt Dich mit einem Fluch.",
	       "belegt "+TP->Name(WEN)+" mit einem Fluch.");
      break; 
      
    case "aergerlich":
      call_out("react", 0, "zieht Dich am Haar.",
	       "zieht "+TP->Name(WEM)+" am Haar.");
      break;
      
    case "frech":
      call_out("react", 0, "zeigt Dir die Zunge",
	       "zeigt "+TP->Name(WEM)+" die Zunge.");
      break;
      
    case "nett":
      call_out("react", 0, "erroetet und kichert verschmitzt.",
	       "erroetet und kichert verschmitzt.");
      break;
      
   case "froh":
     call_out("react", 0, "flattert eine Schraube um Dich.",
	      "flattert eine Schraube um "+TP->Name(WEM)+".");
     break;
     
    default:
      call_out("react", 0, "kitzelt Dich. Du versuchst, Dich zu beherrschen, "
	       "musst aber doch lachen.",
	       " kitzelt "+TP->Name(WEN)+". "+TP->Name(WER)+" versucht, sich zu "
	       "beherrschen, muss aber doch lachen.");
      break;
    }
}

void react(string victim, string others)	
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)	
{
  return StartReaction(verb, gruppe, adverb, touch);
}
