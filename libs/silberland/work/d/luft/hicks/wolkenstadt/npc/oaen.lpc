// 20.1.2004
// 
// NPC meines Gesellenstueckes "Wolkenstadt"

inherit "std/npc";
inherit "std/npc/spells";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Oaen, der alte Wettergnom");
  SetProp(P_LONG, "Er ist ein recht seltsamer Geselle. Er ist klein, "
	  "hat wasserblaue Augen und wirres, weisses Haar. Seine Robe "
	  "ist ziemlich zerschlissen. Er scheint vollkommen verrueckt "
	  "zu sein.");
  SetProp(P_NAME, "Oaen");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:40]));
  AddId(({"wettergnom","gnom","oaen"}));
  AddClass(CL_GNOME);
  
  AddDetail( ({"geselle"}),
	     "Er scheint sehr unruhig zu sein und hoert einfach nicht auf zu "
	     "plappern.");
  
  AddDetail( ({"augen"}),
	     "Sie sind wasserblau und sehr blass.");
  
  AddDetail( ({"haar"}),
	     "Das Haar ist ganz weiss und steht wirr herum. Sieht sehr "
	     "chaotisch aus.");
  
  AddDetail( ({"robe"}),
	     "Das war einmal eine Robe, stellst Du fest. Sie stinkt und ist "
	     "mehr ein Fetzen.");
  
  AddDetail( ({"fetzen"}),
	     "Der Wettergnom scheint wohl nicht sehr auf sein Aeusseres zu achten.");
  
  AddDetail( ({"aeusseres"}),
	     "Nein, das tut er bestimmt nicht.");
  
  create_default_npc(30);
  SetProp(P_HANDS, ({" mit seiner blossen Verruecktheit",300,DT_MAGIC}));
  SetProp(P_RACE, "Gnom");
  SetProp(P_SIZE, 90);
  SetProp(P_WEIGHT, 20000);
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ARTICLE, 0);
  
  SetProp(P_RESISTANCE_STRENGTHS , 
	  ([DT_FIRE:      -0.2,  DT_COLD:     -0.2,  DT_WATER: -0.2, DT_AIR:   -0.2, 
	    DT_LIGHTNING: -0.5,  DT_EXPLOSION: 0.0,  DT_SOUND:  0.0, DT_LIGHT:  0.0,
	    DT_ELECTRIC:  -0.5,  DT_ACID:      0.0,  DT_POISON: 0.0, DT_TERROR: 0.0,
	    DT_HOLY:       0.0,  DT_UNHOLY:    0.0,  DT_MAGIC: -0.9, DT_MIND:  -0.9]));
  
  SetProp(P_NOMAGIC,5);
  
  SetProp(P_MSGIN, "schlurft herein");
  SetProp(P_MSGOUT, "humpelt");
  SetProp(P_MMSGIN, "erscheint in einer Nebelwolke");
  SetProp(P_MMSGOUT, "huepft in eine Nebelwolke und ist futsch");
  
  SetProp(P_DIE_MSG, " sinkt tot zu Boden.\n");
  SetProp(P_KILL_MSG, "Glaubst Du, Du kannst den Erdbeerkoenig besiegen?!");
  SetProp(P_MURDER_MSG, "%s, Du darfst meinen Kaffee austrinken. Ich glaube,\n"
	  "ich brauche ihn nicht mehr!");
  SetProp(P_FORCE_MURDER_MSG, 1);
  SetProp(P_HEAL, 5);
  
  AddInfo(DEFAULT_INFO, "stiert Dich mit weit aufgerissenen Augen an.\n");
  
  AddInfo( ({"cummulus"}), 
	   "Das sind normale Wolken! Hach, Du hast ja ueberhaupt keine AHNUNG\n"
	   "VOM WETTER!!!\n","plappert: ");
  
  AddInfo( ({"wolken","wetter"}), 
	   "NUR ICH HABE EINE AHNUNG VOM WETTER!!! ICH KANN ES SOGAR\n"
	   "ERSCHAFFEN!!!\n","schreit: ");
  
  AddInfo( ({"ahnung"}), 
	   "DAS IST EINE WISSENSCHAFT! DU DUMMER TOELPEL!\n","schreit: ");
  
  AddInfo( ({"wissenschaft"}), 
	   "Ist hinter Dir auch immer ein Riesenbroccoli her.\n","jammert "
	   "panisch: ");
  
  AddInfo( ({"toelpel"}), 
	   "HAU AB!!!\n","gib Dir einen Fusstritt: ");
  
  AddInfo( ({"fusstritt","tritt"}), 
	   "NEIIIN, ICH HABE DIR KEINEN FUSSTRITT GEGEBEN!!! NERVE WEN\n"
	   "ANDEREN!\n","bruellt: ");
  
  AddInfo( ({"riesenbroccoli","broccoli","riesenkartoffel","kartoffel"}), 
	   "Sie verfolgen mich. Nie lassen sie mich in Ruhe!!!\n","weint: ");
  
  AddInfo( ({"ruhe"}), 
	   "Ach, wie gerne wuerde ich einfach nur meine Ruhe haben!\n",
	   "jammert: ");
  
  AddInfo( ({"kreis"}), 
	   "Gute Frage ... ist jetzt ein eckiger Kreis rund oder eckig?\n",
	   "murmelt: ");
  
  AddInfo( ({"frage"}),
	   "So frag mich doch!\n","murmelt: ");
  
  AddInfo( ({"blume"}), 
	   "Schenk mir doch eine.\n","bettelt: ");
  
  AddInfo( ({"gnom","wettergnom"}), 
	   "Ja, ich achte auf das Wetter. Irgendjemand muss es ja tun!\n",
	   "huestelt: ");
  
  AddInfo( ({"hilfe"}), 
	   "Du bist aber lieeeeb! Moechtest Du einen Kaffee? Ist mein\n"
	   "Lieblingsgetraenk!\n","saeuselt: ");
  
  AddInfo( ({"kaffee"}), 
	   "ICH HASSE KAFFEE! IST JA UNGESUND!\n","schreit: ");
  
  AddInfo( ({"lieblingsgetraenk","getraenk"}), 
	   "Du darfst meinen Kaffee trinken. Er steht am Tisch.\n",
	   "antwortet: ");
  
  AddInfo( ({"fernrohr"}), 
	   "DAS IST MEIN FERNROHR! DAS IST FUER MEINE WISSENSCHAFT WERTVOLL!\n",
	   "schreit: ");
  
  AddInfo( ({"kaleidoskop"}), 
	   "Was willst Du denn damit? Hier gibt es nur ein Fernrohr. UND DAS "
	   "GEHOERT MIR!!!\n","fragt entruestet: ");
  
  AddInfo( ({"erdbeerland","land"}), 
	   "Meine Heimat. Einmal war ich dort sogar Erdbeerkoenig, als mich\n"
	   "mein Bruder vertrieben hat.\n","antwortet seufzend: ");
  
  AddInfo( ({"heimat"}), 
	   "JA, AUCH GNOME HABEN EINE HEIMAT, DU TOELPEL!!!\n","schreit: ");
  
  AddInfo( ({"erdbeerkoenig","koenig"}), 
	   "Ja, ich war mal ein stolzer Koenig. Jetzt kuemmer ich mich hier\n"
	   "oben um das Wetter.\n","seufzt: ");
  
  AddInfo( ({"bruder"}), 
	   "WEN ICH DEN ERWISCHE. DER SOLL SICH RUHIG\nHERTRAUEN!!!\n","bruellt "
	   "mit drohenden Faeusten: ");
  
  AddInfo( ({"reise"}), 
	   "Ja, einmal wieder ins Erdbeerland zurueck reisen. Aber mein Bruder "
	   "hat mich vertrieben.\n","schnieft: ");
  
  AddInfo( ({"fleck"}), 
	   "Ja Du, da hast Du einen Fleck am Kinn picken.\n","bemerkt: ");
  
  AddInfo( ({"kinn"}), 
	   "auf Dein Kinn.\n","deutet ");
  
  AddInfo( ({"socke"}), 
	   "Hast Du welche fuer mich? Irgendjemand hat meine zerschnitten. "
	   "Ich bin ja sooo arm!!!\n","fragt: ");
  
  AddInfo( ({"hoehle"}),
	   "DORT WO ES FINSTER IST, DORT IST EINE HOEHLE!!!\n","schreit: ");
  
  AddInfo( ({"maschine","kristallmaschine"}),
	   "FASS DAS JA NICHT AN! DIE IST HOCH EMPFINDLICH!!\n","kreischt: ");
  
  AddInfo( ({"trichter","hebel","knopf","knoepfe"}),
	   "LASS DAS IN RUHE! DU MACHST ES SICHER KAPUTT!!!\n","schnattert: ");
  
  AddInfo( ({"frosch"}),
	   "Der Frosch zeigt die Temperatur an!!!\n","erklaert: ");
  
  AddInfo( ({"temperatur"}),
	   "SAG, MUSST DU NICHT IN DIE SCHULE!!!\n","bruellt: ");
  
  AddInfo( ({"schule"}),
	   "Mhhh, irgendwo dahinten war eine Schule, glaube ich?\n",
	   "spricht nachdenklich: ");
  
  AddInfo( ({"sonne"}),
	   "Die Sonne sagt, dass die Sonne scheint.\n","erklaert: ");
  
  AddInfo( ({"grashalm","halm"}),
	   "Es zeigt die Windstaerke an!!!\n","erklaert: ");
  
  AddInfo( ({"windstaerke","staerke","wind"}),
	   "WARUM GREIFST DU MICH AN!?!\n","kreischt: ");

AddInfo( ({"sodbrennen"}), 
	   "Ach, Du hast einen Knall. Ich verbrenn mir da nicht "
	   "die Finger!!!\n","plappert: ");

  
  SetProp( P_REJECT, ({REJECT_DROP,
			 "Der Wettergnom traegt niemals jemandes Sachen.\n" }) );
  
  SetChats(20, ({
    "Der Gnom schreit: Das war ein Cummulus, EIN CUMMULUUUUS!\n",
      "Der Wettergnom schnieft durch die Nase.\n",
      "Der Gnom fragt Dich: Warum ist ein eckiger Kreis keine Blume?\n",
      "Oaen schnueffelt an Dir herum: DU STINKST!\n",
      "HILFEEEE! EINE RIESENKARTOFFEL VERFOLGT MICH!, der Gnom hetzt im\n"
      "Raum hechelnd herum.\n",
      "Oaen ist in Gedanken versunken: Ob ich eine Reise ins Erdbeerland\n"
      "machen soll?\n",
      "Der Wettergnom schleckt sich den Finger ab und wischt mit diesem\n"
      "in Deinem Gesicht herum: DU HAAAAST DA EINEN FLECK!\n",
      "Der Gnom siniert: Ob ich jetzt die gruene Socke doch\n"
      "zerschneiden soll?\n",
      "Der Wettergnom weint Dich an: Warum hast Du meinen Kaffee\n"
      "ausgetrunken?\n",
      "Gib das her!, schreit Oaen zur Luft schrill.\n",
      "Der Wettergnom gibt Dir einen ordentlichen Tritt: RAAAAAUS MIT\n"
      "DIR! DU WILLST MICH DOCH AUSSPIONIEREN!\n",
      "Oaen jammert: Mir ist faaad!, und bohrt in der Nase.\n",
      "Kannst Du mir sagen, wie es in einer Hoehle regnen kann?, fragt Dich\n"
      "der Gnom.\n",
      "Oaen schaut durch ein Fernrohr: Mhh, da braut sich ein Wetter\n"
      "zusammen!\n",
      "Oaen schlurft unruhig hin und her.\n"}));
  
  SetAttackChats(10, ({
    "Der Gnom schreit: FANG MICH DOCH! und zeigt die Zunge.\n",
      "Oaen schreit: HAHAAAA, SIEG!!\n",
      "Oaen braut einen Wasserguss herauf und laesst es niederprasseln.\n"}));
  
  // ----- Spells Anfang -----
  
  SetProp(P_SPELLRATE, 30);
  
  AddSpell(2, 450, "Oaen beschwoert eine Gewitterwolke auf Dich herab.\n",
	   "Oaen beschwoert eine Gewitterwolke auf @WEN.\n",
           ({DT_LIGHTNING, DT_ELECTRIC}), ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3, 480, "Oaen attackiert Dich mit seiner Verruecktheit.\n",
	   "Oaen attackiert @WEN mit seiner Verruecktheit.\n",
           ({DT_MIND, DT_MAGIC}), ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2, 450, "Deine Haut ueberzieht sich mit einer Eisschicht.\n",
	   "Bei @WEN ueberzieht sich die Haut mit einer Eisschicht.\n",
           ({DT_COLD, DT_WATER}), ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2, 450, "Oaen versengt Dich mit brennender Hitze.\n",
	   "Oaen versengt @WEN mit brennender Hitze.\n",
           ({DT_FIRE}), ([SP_SHOW_DAMAGE:1]));
  
  AddDefaultSpell(1, 300, DS_FEAR,
                  "Oaen versetzt Dich in Panik und Du fluechtest vor einer\n"
		  "Riesenkarotte.\n",
		  "Oaen versetzt @WEN in Panik und fluechtet.\n");
  
  // ----- Spells Ende -----
  
  SUID;
  CLONEME(ARMOUR "grsocke1" );
  command("trage alles");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;
  
  
  switch(gruppe)
    {
    case "fies": 
      call_out("react", 0, "schreit: DAS WERDE ICH DEINER MAMA SAGEN!!!",
	       "schreit "+TP->Name(WEN)+" an: DAS WERDE ICH DEINER MAMA SAGEN!!!");
      break; 
      
    case "aergerlich":
      call_out("react", 0, "zieht Dir mit seinem Fernrohr eine ueber.",
	       "zieht "+TP->Name(WEM)+" mit seinem Fernrohr eine ueber.");
      break;
      
    case "frech":
      call_out("react", 0, "weint: WIESO HAST DU MIR MEINEN TEDDY WEGGENOMMEN!!!",
	       "weint: WIESO HAST DU MIR MEINEN TEDDY WEGGENOMMEN!!!");
      break;
      
    case "nett":
      call_out("react", 0, "ballt seine Faeuste und bruellt Dich an: KOMM HER DU SCHUFT!!!",
	       "ballt seine Faeuste und bruellt "+TP->Name(WEN)+" an: KOMM HER DU SCHUFT!!!");
      break;
      
    case "froh":
      call_out("react", 0, "sagt galant: Ach Duuu, ich bin ja ein alter, komischer Kauz!",
	       "sagt zu "+TP->Name(WEM)+" galant: Ach Duuu, ich bin ja ein alter, komischer Kauz!");
      break;
      
    default:
      call_out("react", 0, "fragt Dich: Bist Du auch eine Erdbeere?",
	       "fragt "+TP->Name(WEN)+": Bist Du auch eine Erdbeere?");
      break;
    }
}

void react(string victim, string others)	
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)	
{
  return StartReaction(verb, gruppe, adverb, touch);
}
