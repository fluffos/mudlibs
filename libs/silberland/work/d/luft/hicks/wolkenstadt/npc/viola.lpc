// NPC meines Gesellenstueckes "Wolkenstadt"

#include "../def.h"

inherit "std/npc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Viola, die Wirtin");
  SetProp(P_LONG, "Viola hat wunderschoene, veilchenblaue Augen. Ihr "
	  "wasserblaues Haar faellt lockig ueber ihren Ruecken. Fuer "
	  "eine Fee ist sie sehr zierlich, aber wunderschoen und "
	  "verfuehrerisch.");
  
  SetProp(P_NAME, "Viola");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:40]));
  AddId( ({"viola","wirtin"}) );
  AddClass(({CL_FLYING, CL_FAIRY}));
  
  AddDetail( ({"augen"}),
	     "Du blickst in Violas Augen und versinkst fast in diesen. Dir "
	     "wird kurz schwindelig. Viola ist eine sehr sinnliche Fee.");
  
  AddDetail( ({"haar"}),
	     "Seidig schimmert das lockige Haar im Licht.");
  
  AddDetail( ({"ruecken"}),
	     "Das Haar bedeckt ihren Ruecken komplett.");
  
  AddDetail( ({"fee","feen"}),
	     "Sie ist eine der huebschesten Feen, die Du je gesehen hast.");
  
  AddDetail( ({"licht"}),
	     "Das wasserblaue Haar schimmert seidig.");
  
  create_default_npc(20);
  SetProp(P_HANDS, ({" mit ihren Haenden",250,DT_MAGIC}));
  SetProp(P_RACE, "Fee");
  SetProp(P_SIZE, 40);
  SetProp(P_WEIGHT, 10000);
  SetProp(P_ALIGN, 700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ARTICLE, 0);
  
  SetProp(P_NOMAGIC, 5);
  
  SetProp(P_RESISTANCE_STRENGTHS , 
	  ([DT_FIRE:      0.5,  DT_COLD:     -0.3,  DT_WATER: -0.3,  DT_AIR:   -0.1, 
	    DT_LIGHTNING: 0.0,  DT_EXPLOSION: 0.0,  DT_SOUND:  0.0,  DT_LIGHT: -0.1,
	    DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.0,  DT_TERROR: 0.0,
	    DT_HOLY:     -0.1,  DT_UNHOLY:    0.1,  DT_MAGIC:  0.0,  DT_MIND:   0.0]));
  
  SetProp(P_MSGIN, "flattert keck herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "flattert keck herein");
  SetProp(P_MMSGOUT, "fliegt kurz weg");
  
  SetProp(P_DIE_MSG, " haucht ihren letzten Atem aus.\n");
  SetProp(P_KILL_MSG, "Du wirst das nie wieder wagen, Du Schuft!");
  SetProp(P_MURDER_MSG, "Das naechste Mal lass ich Dich erfrieren, %s!!!");
  SetProp(P_FORCE_MURDER_MSG, 1);
  SetProp(P_HEAL, 5);
  
  AddInfo(DEFAULT_INFO, "begruesst Dich: Was darf ich Dir bringen?");
  
  AddInfo( ({"taverne"}),
	   "Das ist meine Taverne und es hat viel Muehe gekostet sie "
	   "aufzubauen.","erklaert stolz: ");
  
  AddInfo( ({"muehe"}),
	   "Die ganze Muehe hat sich gelohnt. Blick Dich mal um!","sagt charmant: ");
  
  AddInfo( ({"wolkenstadt","lilandor"}),
	   "Du bist gerade hier. Ich hoffe es gefaellt Dir.","sagt flirtend: ");
  
  AddInfo( ({"amaryllis","anemona","ambriosa","moiren","moire","statuen","statue"}),
	   "Amaryllis, Anemona und Ambriosa sind unsere drei Moiren. Du findest "
	   "sie im Palast.","plaudert: ");
  
  AddInfo( ({"palast","glaspalast"}),
	   "Der Palast befindet sich nordwestlich von der Taverne. Du musst "
	   "einfach nur der Strasse folgen.","sagt: ");
  
  AddInfo( ({"strasse"}),
	   "Sie verlaeuft vor der Taverne. Du kannst sie nicht uebersehen.","antwortet: ");
  
  AddInfo( ({"oaen","gnom","wettergnom"}),
	   "Ach, der lebt schon seit Jahren hier. Er ist ziemlich wirr im Kopf "
	   "und meint, er sei ein Koenig. Du findest ihn im Turm.","erzaehlt: ");
  
  AddInfo( ({"jahre","jahren"}),
	   "Soweit ich mich zurueck erinnern kann lebt er schon hier. Er ist ein "
	   "komischer Kauz.","antwortet: ");
  
  AddInfo( ({"kauz","kopf"}),
	   "Manchmal fuerchte ich mich vor ihm, weil ich nie weiss was er als "
	   "naechstes tut. Man sollte ihn bestimmt nicht reizen.","warnt: ");
  
  AddInfo( ({"koenig"}),
	   "Keiner glaubt ihm, aber er laesst nicht locker und erzaehlt immer wieder davon. "
	   "Vielleicht fragst Du ihn mal?","erzaehlt: ");
  
  AddInfo( ({"turm"}),
	   "Der Turm befindest sich westlich von hier. Er ist im Park und nicht "
	   "zu uebersehen.","deutet nach Westen: ");
  
  AddInfo( ({"park"}),
	   "Ein huebsches Fleckchen und auf jedenfall sehenswert.","antwortet laechelnd: ");
  
  AddInfo( ({"fleckchen"}),
	   "Ich kann es Dir nicht zeigen. Gehe einfach hin und blick Dich "
	   "dort um.","erzaehlt: ");
  
  AddInfo( ({"menue","getraenk","getraenke","essen"}),
	   "Tippe einfach 'menue' und dann bestelle einfach das was Du moechtest. "
	   "Ich bringe es Dir dann.","erklaert: ");
  
  AddInfo( ({"hicks"}),
	   "Ach Hicks! Sie ist ein Stammgast hier und eine olle "
	   "Schnapsdrossel.","ruempft die Nase: ");
  
  AddInfo( ({"stammgast","gast"}),
	   "Ich habe hier einige Stammgaeste, aber keiner kommt so oft vorbei wie "
	   "Hicks.","erzaehlt keck: ");
  
  AddInfo( ({"schnapsdrossel","drossel"}),
	   "Sie saeuft und saeuft und saeuft. Ich denke, sie hat sonst nichts "
	   "zu tun. Ausserdem prellt sie immer ihre Zeche und das ziemlich "
	   "schlecht.","erklaert: ");
  
  AddInfo( ({"zeche"}),
	   "Ich aerger mich darueber nicht. Hiri, ihre Mama zahlt sie "
	   "immer.","plaudert: ");
  
  AddInfo( ({"hiri","mama"}),
	   "Sie besucht uns hin und wieder. Hiri hat es nicht weit zu mir, weil "
	   "sie ja im Turm wohnt.","plappert: ");
  
  AddInfo( ({"gwenshara"}),
	   "Gwenshara ist immer ein gern gesehener Gast. Sie ist eine Braumeisterin "
	   "und hoch angesehen unter den Wirten.","erzaehlt: ");
  
  AddInfo( ({"braumeisterin","meisterin"}),
	   "Frag sie einfach selber. Sie kann es Dir sicher erklaeren.",
	   "antwortet schnippisch: ");
  
  AddInfo( ({"wirten","wirte"}),
	   "Ich bin die einzige Wirtin hier oben.","sagt: ");
  
  AddInfo( ({"wirtin","viola"}),
	   "Habe ich mich Dir nicht vorgestellt? Ich bin Viola, die Wirtin "
	   "dieser Taverne.","fragt entsetzt: ");

  AddInfo( ({"sex"}),
	   "Wir Feen vermehren uns auf magische Weise","erklaert: ");

  AddInfo( ({"weise"}),
	   "Das verrate ich Dir sicher nicht.","sagt entruestet: ");

  AddInfo( ({"sodbrennen"}),
           "Nein, ich habe kein Sodbrennen. Aber Kalanchoe hat es immer.", "antwortet: ");

  AddInfo( ({"zitrone","zitronen","zitronenbaum","zitronenbaeumchen"}),
           "Nein, ich habe sowas nicht.", "informiert: ");

  AddInfo( ({"kalanchoe"}),
           "Sie wacht drueben im Turm, aber mehr recht als schlecht.", "fluestert: ");

  
  SetProp( P_REJECT, ({REJECT_DROP,
			 Name(WER)+" sind Deine Sachen viel zu schwer.\n" }));
  
  SetChats(3, ({
    "Viola taenzelt zwischen den Gaesten lachend herum.\n",
      "Die Wirtin wischt die Theke.\n",
      "Viola zupft sich ihr Haar zurecht.\n",
      "Die Wirtin serviert einer jungen Fee ein Getraenk.\n",
      "Viola schwingt reizvoll ihre zierlichen Hueften.\n",
      "Viola flirtet mit einem Gast und verzaubert ihn mit ihrem Kichern.\n",
      "Viola bereitet eine Zitronenlimonade vor.\n"}));
  
  SetAttackChats(5, ({
    "Viola verflucht alle Friedensstoerer.\n",
      "Viola wirbelt einen Bluetenzauber hoch.\n",
      "Violas Haut ueberzieht sich mit Eis.\n"}));
  
  // ----- Spells Anfang -----
  
  SetProp(P_SPELLRATE, 35);
  
  AddSpell(1, 300, "Viola sprueht Dir einen Eishagel entgegen.\n",
	   "Viola verletzt @WEN mit einem Eishagel.\n",
           ({DT_COLD, DT_WATER}), ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(1, 300, "Verflucht Dich mit einem Eisstrahl.\n",
	   "Viola verflucht @WEN mit einem Eisstrahl.\n",
           ({DT_COLD, DT_WATER}), ([SP_SHOW_DAMAGE:1]));
  
  // ----- Spells Ende-----
  
  SUID;
  CLONEME(ARMOUR "feenkleid");
  CLONEME(ARMOUR "diadem");
  command("trage alles");
  
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;
  
  
  switch(gruppe)
    {
    case "fies": 
      call_out("react", 0, "schimpft: Du bekommst gleich Lokalverbot!",
	       "schimpft mit "+TP->Name(WEN)+".");
      break; 
      
    case "aergerlich":
      call_out("react", 0, "sieht Dich veraergert an.",
	       "blickt "+TP->Name(WEM)+" veraergert an.");
      break;
      
    case "frech":
      call_out("react", 0, "gibt Dir einen Klaps auf den Hintern.",
	       "gibt "+TP->Name(WEN)+" einen Klaps auf den Hintern.");
      break;
      
    case "nett":
      call_out("react", 0, "fragt Dich: Na, willst Du was trinken?",
	       "spricht freundlich mit "+TP->Name(WEN)+" .");
      break;
      
    case "froh":
      call_out("react", 0, "knuddelt Dich lachend um.",
	       "knuddelt lachend "+TP->Name(WEN)+" um.");
      break;
      
    default:
      call_out("react", 0, "gibt Dir einen verfuehrerischen Kuss.",
	       "gibt "+TP->Name(WEN)+" einen verfuehrerischen Kuss.");
      break;
    }
}

void react(string victim, string others)	
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
    }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)    
{
  return StartReaction(verb, gruppe, adverb, touch);
}
