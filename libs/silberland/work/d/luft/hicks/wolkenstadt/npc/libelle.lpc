// NPC meines Gesellenstueckes "Wolkenstadt"

inherit "std/mnpc";

#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Libelle");
  SetProp(P_LONG, "Sie hat regenbogenfarbene Fluegel. Ihr Leib schillert "
	  "tuerkisblau und sie sieht sehr grazil aus. Sie sucht immer die "
	  "Naehe des Wassers. Ihr Lieblingsplatz ist das Biotop.");
  SetProp(P_NAME, "Libelle");
  SetProp(P_GENDER, FEMALE);
  AddId("libelle");
  AddClass(CL_FLYING);
  
  create_default_npc(2+random(2));
  SetProp(P_HANDS, ({" mit ihren Fluegeln",45,DT_BLUDGEON}));
  SetProp(P_RACE, "insect");
  SetProp(P_SIZE, 8);
  SetProp(P_WEIGHT, 10);
  SetProp(P_ALIGN, 850);
  SetProp(P_MAX_HANDS, 6);
  
  SetProp(P_MSGIN, "schwirrt herein");
  SetProp(P_MSGOUT, "schwirrt");
  SetProp(P_MMSGIN, "erscheint in einem Blumenregen");
  SetProp(P_MMSGOUT, "verschwindet in einer Duftwolke");
  
  SetProp(P_MNPC_AREA, ({ROOM "ws2", ROOM "ws4", ROOM "ws6", ROOM "ws8",
			   ROOM "ws9", ROOM "ws10", ROOM "ws11", ROOM "ws12",
			   ROOM "wst1"}));
  SetProp(P_MNPC_WAIT, ({ 15, 20, 15}));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "ws12");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
  
  SetProp(P_DIE_MSG, " faellt tot zu Boden.\n");
  SetProp(P_KILL_MSG, "Wage es nicht nochmals! Ich bin ein KillerNPC!!!");
  
  AddInfo(DEFAULT_INFO, "fliegt um Deinen Kopf.\n");
  
  SetProp( P_REJECT, ({REJECT_DROP,
			 "Das ist der Libelle zu schwer.\n" }) );
  
  SetChats(3, ({
    "Die Libelle laesst sich am Boden nieder und hebt wieder ab.\n",
      "Die Libelle putzt ihre Fluegel.\n",
      "Die Libelle fliegt aus Freude in der Luft Loopings.\n"}) );
  
  SetAttackChats(10, ({
    "Die Libelle schillert kurz auf.\n",
      "Die Libelle plustert sich auf.\n"}) );
  
}

void StartReaction(string verb, string gruppe, string adverb, int touch)     
{
  if (find_call_out("react")!= -1)
    return;
  
  
  switch(gruppe)
    {
    case "fies": 
      call_out("react", 0, "beisst Dich in den Finger.",
	       "beisst "+TP->Name(WEN)+ " in den Finger.");
      break; 
      
    case "aergerlich":
      call_out("react", 0, "schimpft zornig mit Dir.",
               "schimpft zornig mit "+TP->Name(WEM)+".");
      break;
      
    case "frech":
      call_out("react", 0, "schwirrt um Dich herum.",
               "schwirrt um "+TP->Name(WEN)+" herum.");
      break;
      
    case "nett":
      call_out("react", 0, "grinst Dich an.",
               "grinst "+TP->Name(WEN)+" an.");
      break;
      
    case "froh":
      call_out("react", 0, "gibt Dir einen Schmatz.",
               "gibt "+TP->Name(WEM)+" einen Schmatz.");
      break;
      
    default:
      call_out("react", 0, "flattert vergnuegt herum.",
	       "flattert vergnuegt herum.");
      break;
    }
}

void react(string victim, string others)	
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
    }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)	
{
  return StartReaction(verb, gruppe, adverb, touch);
}
