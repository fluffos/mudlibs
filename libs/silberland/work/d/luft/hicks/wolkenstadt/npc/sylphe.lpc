// NPC meines Gesellenstueckes "Wolkenstadt"

inherit "std/npc/spells";
inherit "std/mnpc";
inherit "/gilden/bardengilde/obj/quest/bard_small_combatspell_teacher";

#include "../def.h"
#include "/gilden/bardengilde/barden_extern.h"



void create() 
{
  string final_farbe;
  
  if (!is_clone(TO)) return;
  ::create();
  
  final_farbe=({"blaue","tuerkise","violette","graue","wasserblaue",
		  "graublaue","violettblaue","hellblaue","stahlblaue",
		  "himmelblaue","silbergraue","graugruene","hellgruene"})[random(13)];
  
  SetProp(P_SHORT, "Eine "+(final_farbe)+" Sylphe");
  SetProp(P_LONG, "Die "+(final_farbe)+" Sylphe ist ein Elementarwesen. Sie "
	  "ist sehr maechtig und hilft den L'fairs das Gleichgewicht hier "
	  "oben aufrecht zu erhalten. Sie ist eine Frau, die von "
	  "Luftstroemungen umwirbelt wird.");
  SetProp(P_NAME, "Sylphe");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:40]));
  AddId(({"sylphe"}));
  AddClass(CL_FLYING);
  
  AddDetail( ({"elementarwesen","elementar","wesen"}),
	     "Sie besteht fast nur aus Luft.");
  
  AddDetail( ({"luft"}),
	     "Eigentlich wirbeln sich Luftstroemungen um ihren Koerper. Selbst "
	     "die Haare sind aus Luft.");
  
  AddDetail( ({"luftstroemungen","stroemungen"}),
	     "Der Wind wirbelt sich um den Koerper und verhuellt die Konturen.");
  
  AddDetail( ({"koerper"}),
	     "Ihre Brueste sind zu sehen, aber der gesamte Unterleib ist von "
	     "den Luftstroemungen verdeckt.");
  
  AddDetail( ({"brueste"}),
	     "Du erkennst nur ihre Kontur.");
  
  AddDetail( ({"konturen","kontur"}),
	     "Du kannst den gesamten Koerper nur erahnen.");
  
  AddDetail( ({"l'fairs","luftfeen"}),
	     "Sie wohnen hier oben, die Luftfeen.");
  
  AddDetail( ({"gleichgewicht"}),
	     "Auch das Gleichgewicht kann sich hier oben verschieben. Die "
	     "Sylphen wachen darueber und gleichen es aus.");
  
  AddDetail( ({"wind"}),
	     "Die Haare bewegen sich im Wind, obwohl diese selbst aus Luft "
	     "bestehen.");
  
  AddDetail( ({"haare","haar"}),
	     "Sie bewegen sich transparent im Wind und umrahmen das Gesicht "
	     "oder umschmeicheln den Koerper der Sylphe.");
  
  AddDetail( ({"gesicht"}),
	     "Du betrachtest ihr Gesicht naeher, das schlafend wirkt, da sie "
	     "ihre Augen geschlossen hat.");
  
  AddDetail( ({"augen"}),
	     "Ploetzlich oeffnet die Sylphe ihre Lider und gelbe Augen "
	     "starren Dich an. Du bekommst einen Schreck.");
  
  AddDetail( ({"lider"}),
	     "Sie sind geschlossen.");
  
  AddDetail( ({"schreck"}),
	     "Die gelben Augen wirken sehr hart zu der weichen, windigen "
	     "Sylphe. Du hattest damit nicht gerechnet.");
  
  
  create_default_npc(15+random(5));
  SetProp(P_HANDS, ({" mit Luftstroemungen an",170,DT_AIR}));
  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 1);
  SetProp(P_ALIGN, 900);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOCORPSE, 1);
  
  SetProp(P_ARTICLE, 1);
  
  SetProp(P_RESISTANCE_STRENGTHS , 
	  ([DT_FIRE:      0.0,  DT_COLD:     -0.3,  DT_WATER: -0.3,  DT_AIR:   -1.0, 
	    DT_LIGHTNING: 0.0,  DT_EXPLOSION: 0.0,  DT_SOUND:  0.0,  DT_LIGHT: -0.5,
	    DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.0,  DT_TERROR: 0.0,
	    DT_HOLY:     -0.3,  DT_UNHOLY:    0.3,  DT_MAGIC:  0.0,  DT_MIND:   0.0]));
  
  SetProp(P_NOMAGIC,50);
  
  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "entwickelt sich aus einer Luftstroemung");
  SetProp(P_MMSGOUT, "loest sich in Luft auf");
  
  SetProp(P_MNPC_AREA, ({ ROOM "ws", ROOM "wst", ROOM "wh1"}));
  SetProp(P_MNPC_WAIT, ({ 15, 20, 20}));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "ws5");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
  
  SetProp(P_DIE_MSG, " loest sich in Luft auf.\n");
  SetProp(P_KILL_MSG, "Du wagst es nicht mehr uns Luftelementarwesen anzugreifen!!!");
  SetProp(P_MURDER_MSG, "%s, warum gehst Du nicht woanders hin spielen?!?");
  
  AddInfo(DEFAULT_INFO, "wirbelt Dich unwissend an.\n");
  
  AddInfo( ({"hicks"}), 
	   "Das hat alles Hicks gemacht.\n","fluestert: ");
  
  
  SetProp( P_REJECT, ({REJECT_DROP,
			 "Die Sylphe traegt nie etwas.\n" }) );
  
  SetChats(3, ({
    
    "Die "+(final_farbe)+" Sylphe wirbelt sich auf und flackert wieder "
      "ab.\n",
      "Die "+(final_farbe)+" Sylphe zieht Dich in einen Luftsog und "
      "umarmt Dich sanft.\n",
      "Die "+(final_farbe)+" Sylphe laesst ihr Haar flattern.\n",
      "Die "+(final_farbe)+" Sylphe spielt mit dem Wind.\n"}));
  
  SetAttackChats(10, ({
    "Die "+(final_farbe)+" Sylphe loest sich kurz auf und wirbelt sich dann\n"
      "zusammen.\n"}));
  
  // ----- Spells Anfang -----
  
  SetProp(P_SPELLRATE, 50);
  
  AddSpell(2, 500, "Die "+(final_farbe)+" Sylphe wirbelt Dich hoch und laesst\n"
	   "Dich zu Boden krachen.\n",
	   "Die "+(final_farbe)+" Sylphe wirbelt @WEN hoch und laesst\n"
	   "@WEN zu Boden krachen.\n",
           ({DT_AIR, DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2, 300, "Die "+(final_farbe)+" Sylphe gibt Dir einen Schub reinen "
	   "Sauerstoff und laesst Dich aufkeuchen.\n",
	   "Die "+(final_farbe)+" Sylphe gibt @WEM einen Schub reinen "
	   "Sauerstoff und laesst @WEN aufkeuchen.\n",
           ({DT_AIR, DT_SQUEEZE}), ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2, 300, "Die "+(final_farbe)+" Sylphe wirbelt eine wilde Windhose "
	   "um Dich.\n",
	   "Die "+(final_farbe)+" Sylphe wirbelt um @WEN eine wilde "
	   "Windhose.\n",
           ({DT_AIR}), ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(1, 500, "Die "+(final_farbe)+" Sylphe kuesst Dich und saugt Dir die "
	   "Luft aus der Lunge.\n",
	   "Die "+(final_farbe)+" Sylphe kuesst @WEN und saugt @WEM die "
	   "Luft aus der Lunge.\n",
           ({DT_AIR}), ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(4, 200, "Die "+(final_farbe)+" Sylphe schiesst Dir einen Luftpfeil "
	   "entgegen.\n",
	   "Die "+(final_farbe)+" Sylphe schiesst @WEM einen Luftpfeil "
	   "entgegen.\n",
           ({DT_AIR}), ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2, 400, "Die "+(final_farbe)+" Sylphe schleudert Dich als Windstoss "
	   "zu Boden.\n",
	   "Die "+(final_farbe)+" Sylphe schleudert @WEN als Windstoss "
	   "zu Boden.\n",
           ({DT_AIR, DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(1, 500, "Die "+(final_farbe)+" Sylphe bekommt grosse Lufthaende "
	   "und quetscht Dich.\n",
	   "Die "+(final_farbe)+" Sylphe bekommt grosse Lufthaende "
	   "und quetscht @WEN.\n",
           ({DT_AIR, DT_SQUEEZE}), ([SP_SHOW_DAMAGE:1]));
  
  
  // ----- Spells Ende -----

  initialize_bard_spell_teacher(BARD_GROUP_TIRENA);
  
}

void StartReaction(string verb, string gruppe, string adverb, int touch)    
{
  if (find_call_out("react")!= -1)
    return;
  
  
  switch(gruppe)
    {
    case "fies": 
      call_out("react", 0, "weht Dir Sand in die Augen.",
	       "weht "+TP->Name(WEM)+" Sand in die Augen.");
      break; 
      
    case "aergerlich":
      call_out("react", 0, "blaest Dir ins Gesicht.",
	       "blaest "+TP->Name(WEM)+" ins Gesicht.");
      break;
      
    case "frech":
      call_out("react", 0, "ignoriert Dich arrogant.",
	       "ignoriert "+TP->Name(WEN)+" arrogant.");
      break;
      
    case "nett":
      call_out("react", 0, "kuesst Dich innig und gibt Dir neue Lebenskraft.",
	       "kuesst "+TP->Name(WEN)+" innig und gibt neue Lebenskraft.");
      break;
      
    case "froh":
      call_out("react", 0, "umschmeichelt Dich grazil.",
	       "umschmeichelt "+TP->Name(WEN)+" grazil.");
      break;
      
    default:
      call_out("react", 0, "zieht Dir mit einem Luftschwall die Hose runter.",
	       "zieht "+TP->Name(WEM)+" mit einem Luftschwall die Hose runter.");
      break;
    }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)	
{
  return StartReaction(verb, gruppe, adverb, touch);
}
