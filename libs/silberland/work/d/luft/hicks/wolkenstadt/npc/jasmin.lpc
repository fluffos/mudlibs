// Laden - Wolkenstadt"

#include "../def.h"

inherit "std/npc/spells";
inherit "std/npc";
inherit "std/player/moneyhandler.lpc";


void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Jasmin, die Ladenbesitzerin");
  SetProp(P_LONG,
    "Jasmin ist eine Fee und die Besitzerin dieses Ladens. Sie hat weisse "
    "lange Haare, die ihr Gesicht umschmeicheln. Auffaellig sind ihre "
    "weissen, glitzernden Wimpern und ihre strahlend honiggelben Augen. "
    "Sie laechelt Dir freundlich zu und laesst Dich in Ruhe umsehen.");

  SetProp(P_NAME, "Jasmin");
  SetProp(P_GENDER, FEMALE);

  AddId( ({"jasmin", "ladenbesitzerin", "besitzerin", "NOWIMPY",
           "\nsk_jasmin"}) );
  AddClass(({CL_FLYING, CL_FAIRY}));

  create_default_npc(20+random(5));

  SetProp(P_HANDS, ({" mit ihren blossen Haenden",300,DT_MAGIC}));
  SetProp(P_RACE, "Fee");
  SetProp(P_SIZE, 40);
  SetProp(P_WEIGHT, 9000);
  SetProp(P_ALIGN, 950);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SMELL, "Jasmin duftet wunderbar nach frischen Blumen.\n");

  SetProp(P_NOMAGIC, 20);
  
  SetProp(P_RESISTANCE_STRENGTHS , 
	  ([DT_FIRE:      0.5,  DT_COLD:      0.0,  DT_WATER: -0.3,  DT_AIR:   -0.1, 
	    DT_LIGHTNING: 0.0,  DT_EXPLOSION: 0.0,  DT_SOUND:  0.0,  DT_LIGHT: -0.1,
	    DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON:-0.2,  DT_TERROR: 0.0,
	    DT_HOLY:     -0.1,  DT_UNHOLY:    0.1,  DT_MAGIC:  0.0,  DT_MIND:   0.0]));
  
  SetProp(P_MSGIN, "flattert summend herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "flattert summend herein");
  SetProp(P_MMSGOUT, "fliegt kurz weg");
  
  SetProp(P_DIE_MSG, " haucht ihren letzten Atem aus.\n");
  SetProp(P_KILL_MSG, "Moegen Dir die Elementare Deiner Seele gnaedig sein!");
  SetProp(P_MURDER_MSG, "Das tust Du alles nur aus Habgier, %s???");
  SetProp(P_FORCE_MURDER_MSG, 1);
  SetProp(P_HEAL, 5);

  AddDetail( ({"fee"}),
	     "Sie ist eine Fee, wie alle hier in der Wolkenstadt.");
  AddDetail( ({"haare"}),
	     "Ihre Haare sind glatt und weiss und umschmeicheln ihr Gesicht.");
  AddDetail( ({"gesicht"}),
	     "Es wirkt kindlich und weise zugleich. Dir fallen eindeutig "
	     "Jasmins ungewoehnliche Wimpern auf, unter denen honiggelbe Pupillen "
	     "hervorlugen.");
  AddDetail( ({"wimpern"}),
	     "Das unruhige Funkelspiel der weissen Wimpern irritiert und fasziniert "
	     "Dich zugleich.");
  AddDetail( ({"funkelspiel","spiel"}),
	     "Abwechselnd funkeln und glitzern verschiedene Stellen der Wimpern auf.");
  AddDetail( ({"stellen"}),
	     "Da und dort!");
  AddDetail( ({"pupillen","augen"}),
	     "Ihre honiggelben Augen scheinen sich in eine zitronengelben Farbe zu "
	     "wandeln. Jetzt werden sie wieder honiggelb.");
  AddDetail( ({"ruhe","geborgenheit","esprit"}),
	     "Jasmin strahlt Ruhe, Geborgenheit und Esprit aus. Du fuehlst Dich in "
	     "ihrer Naehe sichtlich wohl.");
  AddDetail( ({"naehe"}),
	     "Vielleicht darfst Du sie mal knuddeln?");


  AddInfo(DEFAULT_INFO, "Moechtest Du etwas kaufen?","fragt freundlich: ");

  AddInfo( ({"laden"}),
	   "Das ist meine Laden und es hat viel Muehe gekostet sie "
	   "aufzubauen.","erklaert stolz: ");
  
  AddInfo( ({"sodbrennen","brennen"}),
	   "Ist unangenehm, aber ich hatte so etwas noch nie.","erzaehlt: ");

  AddInfo( ({"zitronenbaeumchen","zitronenbaum","baeumchen","baum"}),
	   "Nein, der ist nicht zu verkaufen. Ich liebe dieses Aroma.","verneint: ");

  AddInfo( ({"zitronen","zitronenblueten","zitrone","zitronenbluete"}),
	   "Sind sie nicht huebsch?","fragt: ");

  AddInfo( ({"aroma"}),
           "Es riecht so herrlich!!!","schwaermt: ");

  AddInfo( ({"medizin"}),
	   "Ich habe hier keine Medizin.","erklaert: ");
  
  AddInfo( ({"potpourries","potpourri"}),
	   "Sie sind eine Leidenschaft von mir. Ich sammle gerne verschiedene "
	   "Blueten.","plaudert: ");

  AddInfo( ({"leidenschaft"}),
	   "Ich kann einfach den verschiedensten Arten von Blueten nicht "
	   "widerstehen und wie herrlich sie duften...","schwaermt: ");

  AddInfo( ({"blueten","arten"}),
	   "Huch!?! Du willst, dass ich sie Dir aufzaehle? Nun gut! Also... "
	   "Es gibt Jasmin, Rosen, Begonien, Kalanchoen, Melissen, Magnolien, "
	   "Orchideen, Amaryllis, Geranien, Lavendel...","zaehlt auf: ");

  AddInfo( ({"jasmin"}),
	   "Das ist eine wunderschoene weisse Blume und duftet herrlich. Uebrigens, "
	   "ueberall hier haengen Jasminblueten.","sagt: ");

  AddInfo( ({"jasminblueten"}),
	   "Ich wurde nach diesen benannt. Wenn Du moechtest, dann darfst Du Dir "
	   "eine pfluecken.","erklaert: ");

  AddInfo( ({"rosen","rose"}),
	   "Das ist die Koenigin der Blueten. Sie duftet herrlich und leuchtet in "
	   "verschiedensten Farbtoenen.","belehrt: ");

  AddInfo( ({"koenigin"}),
	   "Sie hat sich ihren Namen verdient. Findest Du das etwa nicht?","fragt: ");

  AddInfo( ({"farbtoene","farbtoenen","toenen"}),
	   "Ich kann mich an all diesen Farbtoenen nie satt sehen. Einfach herrlich!!!",
	   "schwaermt: ");

  AddInfo( ({"begonien","begonie"}),
	   "Die Begonie ist ein zartes Pflaenzlein. Auch diese praesentieren sich in "
	   "allen Farbtoenen.","erklaert: ");

  AddInfo( ({"kalanchoen","kalanchoe"}),
	   "Eine Kalanchoe ist sehr klein, mit winzigen Bluetenblaettern.","plaudert: ");

  AddInfo( ({"bluetenblaetter","bluetenblaettern"}),
	   "Sie lockern jedes Potpourie mit ihren zarten Bluetenblaettern auf, da sie feurig "
	   "und explosiv sind.","belehrt: ");

  AddInfo( ({"melissen","melisse"}),
	   "Ich mag die Melisse besonders gerne. Nicht nur, dass sie das Gemuet auffrischt, "
	   "nein, sie heilt auch.","sagt: ");
  
  AddInfo( ({"gemuet","gemueter"}),
	   "Muede Gemueter werden wieder hellwach!!","lacht: ");

  AddInfo( ({"magnolien","magnolie","magnolienblaetter"}),
	   "Die grossen Magnolienblaetter haben einen sehr feinen und zarten Duft. Besonders "
	   "verbreitet sind ein Gemisch aus rosa und weiss.","klaert auf: ");

  AddInfo( ({"gemisch"}),
	   "So sieht sie aus!!!, und legt sie wieder in die Schale zurueck.","zieht ein Blatt "
	   "aus einer Schale heraus: ");

  AddInfo( ({"orchideen","orchidee"}),
	   "Die Orchidee ist in allem exotisch. Daher sind sie aber auch sehr empfindlich und "
	   "und schnell beleidigt. Also, pass auf!!!","erzaehlt ");
  
  AddInfo( ({"amaryllis"}),
	   "Eine unserer Moiren hat ihren Namen nach der Amaryllis erhalten.","sagt: ");

  AddInfo( ({"moiren"}),
	   "Sie leben im Palast und wachen ueber uns.","plaudert: ");

  AddInfo( ({"palast"}),
	   "Er liegt nordoestlich von hier.","weist hin: ");

  AddInfo( ({"name"}),
	   "Er steht fuer alles, das neu beginnen soll. Daher wirkt sie sehr gross und "
	   "kraftvoll.","klaert auf: ");

  AddInfo( ({"geranien","geranie"}),
	   "Sie sind robust und strotzen allem. Man findest sie meist in kraeftigen und "
	   "zarten Rottoenen.","erzaehlt: ");

  AddInfo( ({"rottoene","rottoenen"}),
	   "Von rot bis rosa.","sagt: ");

  AddInfo( ({"lavendel"}),
	   "Der blauviolette Lavendel gehoert in jedes Potpourie. Er beruhigt farblich "
	   "als auch seelisch.","teilt Dir mit: ");
  


  SetProp( P_REJECT, ({REJECT_DROP,
			 Name(WER)+" sind Deine Sachen viel zu schwer.\n" }));
  
  SetChats(1, ({
    "Jasmin strahlt Ruhe und Besonnenheit aus.\n",
      "Jasmin sortiert ihre Potpourries.\n",
      "Jasmin setzt neue Bluetenmischungen an.\n",
      "Jasmin laechelt Dir geduldig zu.\n",
      "Jasmin summt leise ein Lied.\n",
      "Jasmin verschwindet kurz im Lager und erscheint gleich wieder.\n"}));
  
  SetAttackChats(5, ({
    "Jasmin verflucht alle Friedensstoerer.\n",
      "Jasmin wirbelt alle Blueten durch die Luft.\n",
      "Jasmin ruft: Das wird Dich teuer zu stehen kommen!\n"}));
  
  // ----- Spells Anfang -----
  
  SetProp(P_SPELLRATE, 35);
  
  AddSpell(6, 400, "Jasmin murmelt einen Zauber und huellt Dich in eine\n"
		   "Duftwolke ein.\n",
	   "Jasmin murmelt einen Zauber und huellt @WEN in eine Duftwolke.\n",
           ({DT_POISON, DT_AIR}), ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(8, 200, "Jasmin schmeisst Dir eine kleine Bluetenknospe entgegen, die zerplatzt.\n",
	   "Jasmin schmeisst auf @WEN eine Bluetenknospe.\n",
           ({DT_BLUDGEON, DT_ACID}), ([SP_SHOW_DAMAGE:1]));

 AddDefaultSpell(1, 1, DS_POISON, "Jasmin bewirft Dich mit giftigem Bluetenstaub.\n",
                 "@WER wird mit giftigem Bluetenstaub beworfen.\n");
 AddDefaultSpell(3, 500, DS_PARALYZE, "Ein innerlicher geistiger Blitz durchfaehrt Deinen Geist.\n",
                 "@WER wurde geistig geschlagen und ist kampfunfaehig.\n", 3);
  
  // ----- Spells Ende-----
  
  SUID;
  CLONEME(ARMOUR "feenkleid");
  CLONEME(ARMOUR "blumenhaube");
  command("trage alles");
  AddMoney(200+random(800));
  
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;
  
  
  switch(gruppe)
    {
    case "fies": 
      call_out("react", 0, "schimpft: Verschwinde, Du Unruhestifter!",
	       "schimpft mit "+TP->Name(WEN)+".");
      break; 
      
    case "aergerlich":
      call_out("react", 0, "pfaucht: Hast Du schon etwas ausgesucht?",
	       "pfaucht "+TP->Name(WEN)+" an: Hast Du schon etwas ausgesucht?");
      break;
      
    case "frech":
      call_out("react", 0, "zwickt Dich in die Seite.",
	       "zwickt "+TP->Name(WEN)+".");
      break;
      
    case "nett":
      call_out("react", 0, "freut sich: Das ist aber lieb von Dir!",
	       "spricht freundlich mit "+TP->Name(WEN)+".");
      break;
      
    case "froh":
      call_out("react", 0, "umarmt Dich und sie duftet herrlich.",
	       "umarmt "+TP->Name(WEN)+" zaertlich.");
      break;
      
    default:
      call_out("react", 0, "laechelt Dir aufmunternd zu.",
	       "laechelt "+TP->Name(WEM)+" aufmunternd zu.");
      break;
    }
}

void react(string victim, string others)	
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
    }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)    
{
  return StartReaction(verb, gruppe, adverb, touch);
}
