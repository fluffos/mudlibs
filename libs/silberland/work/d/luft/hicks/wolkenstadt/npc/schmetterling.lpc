// 20.1.2004
// 
// NPC meines Gesellenstueckes "Wolkenstadt"

inherit "std/npc";


#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Schmetterling");
  SetProp(P_LONG, "Ein zitronengelber Schmetterling mit himmelblauen "
	  "und rosa Puenktchen laechelt Dich an.");
  SetProp(P_NAME, "Schmetterling");
  SetProp(P_GENDER, MALE);
  AddId("schmetterling");
  AddClass(CL_FLYING);
  
  create_default_npc(2);
  SetProp(P_HANDS, ({" mit seinen Fluegeln",25,DT_BLUDGEON}));
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 4);
  SetProp(P_WEIGHT, 5);
  SetProp(P_ALIGN, 850);
  SetProp(P_MAX_HANDS, 6);
  
  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  
  SetProp(P_DIE_MSG, " faellt tot zu Boden.\n");
  SetProp(P_KILL_MSG, "Mit mir legst Du Dich nicht mehr an, Du Schuft!");
  
  AddInfo(DEFAULT_INFO, "aeugelt Dich lieb an.\n");
  
  SetProp( P_REJECT, ({REJECT_DROP,
			 "Das ist dem Schmetterling zu schwer.\n" }) );
  
  SetChats(3, ({
    "Der Schmetterling flattert vergnuegt herum.\n",
      "Der Schmetterling setzt sich auf Deine Nase und blickt Dir lieb in die Augen.\n",
      "Der Schmetterling putzt sich galant seinen Ruessel.\n"}) );
  
  SetAttackChats(10, ({
    "Der Schmetterling droht mit seinen Faeusten.\n",
      "Der Schmetterling schwirrt verrueckt um Deinen Kopf herum.\n"}) );
  
}

void StartReaction(string verb, string gruppe, string adverb, int touch)	
{
  if (find_call_out("react")!= -1)
    return;
  
  
  switch(gruppe)
    {
    case "fies": 
      call_out("react", 0, "beschimpft Dich wuest.", "beschimpft " +
	       TP->Name(WEN) + " wuest.");
      break; 
      
    case "aergerlich":
      call_out("react", 0, "droht mit seinen Faeusten.",
	       "bedroht " + TP->Name(WEM) +
	       " mit seinen Faeusten.");
      break;
      
    case "frech":
      call_out("react", 0, "schwirrt um Dich herum.",
	       "schwirrt um "+TP->Name(WEN)+" herum.");
      break;
      
    case "nett":
      call_out("react", 0, "knuddelt Dich.",
	       "knuddelt "+TP->Name(WEN)+".");
      break;
      
    case "froh":
      call_out("react", 0, "kitzelt Deine Nase.",
	       "kitzelt "+TP->Name(WEN)+" an der Nase.");
      break;
      
    default:
      call_out("react", 0, "flattert herum.",
	       "flattert herum.");
      break;
    }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)	
{
  return StartReaction(verb, gruppe, adverb, touch);
}
