// Objekt meines Gesellenstueckes "Wolkenstadt"

#include "../def.h"

inherit "std/thing";


void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "Grabsch!" );
  SetProp(P_NAME, 0);
  SetProp(P_GENDER, MALE);
  AddId(({"\ngrabsch_hicks"}));

  SetProp(P_MATERIAL, ([MAT_GLASS: 100]) );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 5);
  SetProp(P_NOBUY, 1);
  SetProp(P_INVIS, 1);
  SetProp(P_NOSELL, 1);
  
  call_out("kill", 30);
  
}

void kill()	
{
  if(MENV)
    if(interactive(MENV))
      {
	tell_object(MENV, 
		    "Du reibst Dir die Augen und blinzelst noch einmal.\n");
	
	tell_room(ENV(MENV), MENV->Name()+" reibt sich die Augen.\n", ({TP}));
      }
  
  remove();
}

void reset()
{
  ::reset();
  remove();
}
