// 20.1.2004
// 
// Objekt meines Gesellenstueckes "Wolkenstadt"

#include "../def.h"

inherit "std/thing";

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Wolkenblumenstrauss");
  SetProp(P_LONG, "Der Blumenstrauss besteht aus Wolkenblumen. Er ist "
		  "wunderschoen wattig, seidig und schimmert wunderschoen. "
		  "Er scheint wohl fuer besondere Momente gebunden worden zu sein." );
  SetProp(P_NAME, "Wolkenblumenstrauss");
  SetProp(P_GENDER, MALE);
  AddId(({"wolkenblumenstrauss","wolkenstrauss","blumenstrauss","strauss"}));
  
  SetProp(P_MATERIAL, ([MAT_MISC_PLANT:25,MAT_CRYSTAL:25,MAT_AIR:25,MAT_WATER:25]));
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 1);
  SetProp(P_SMELL, "Er riecht wunderbar leicht, blumig und feucht.\n");
  
  AddDetail( ({"wolkenblumen","blumen"}),
	       "All die Blumen aus der Wolkenstadt sind zu einem Strauss "
	       "zusammengebunden.");

  AddDetail( ({"momente","moment"}),
	       "Diesen besonderen Moment musst Du schon selber bestimmen.");
}
