// Objekt meines Gesellenstueckes "Wolkenstadt"

#include "../def.h"

inherit "std/thing";

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "Clown" );
  SetProp(P_NAME, 0);
  SetProp(P_GENDER, MALE);
  AddId(({"\nclown"}));
  
  SetProp(P_MATERIAL, ([MAT_GLASS: 100]) );
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_INVIS, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  
  AddCmd( ({"wisch","wische","schminke","schmink","entfern","entferne"}), "exitus");
  
}

string extra_look()     
{
  return BS(CAP(TP->QueryPronoun(WER))+" sieht laecherlich geschminkt aus wie ein Clown.\n");  
}

int exitus(string str)     
{
  if(!str) return 0;
  if(!(str=="schminke weg"||
       str=="clown weg"||
       str=="clownschminke weg"||
       str=="schminke aus gesicht"||
       str=="clown aus gesicht"||
       str=="clownschminke aus gesicht"||
       str=="ab"||
       str=="mich ab"||
       str=="schminke"||
       str=="clownschminke"||
       str=="clown"))
    return 0;

  write("Du siehst nicht mehr aus wie ein Clown.\n");
  say(TPN+" wischt sich die Clownschminke aus dem Gesicht.\n");
  remove();

  return 1;
}
