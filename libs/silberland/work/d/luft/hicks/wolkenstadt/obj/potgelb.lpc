#include "../def.h"

inherit OBJ "stdpot";


void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein gelbes Potpourri");
  SetProp(P_LONG,
	  "Das ist eine Mischung aus gelben Blueten aus Kalanchoen, Rosen, "
	  "Narzissen und wurde mit Zitronenscheiben verfeinert. "
	  "Das Ganze ist in ein transparentes Papier verpackt." );

  SetProp(P_MATERIAL, ([MAT_PLANT:100]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 100);
  SetProp(P_NAME_ADJ, "gelb");
  AddAdjective(({"gelb", "gelbes","gelbe"}));

  AddId("potgelb");
  
  SetProp(P_POTPOURRI, ({
        "Frischer Bluetenduft umschmeichelt Deine Sinne.",
        "Du entspannst Dich bei dem zitrusfruchtigen Potpourri-Geruch.",
        "Blumig-wuerzige Parfuems erfuellen den Raum.",
        "Wohliger Rosengeruch durchstroemt den Raum.",
        "Du erschnupperst das Aroma von Kalanchoen.",
        "Du erriechst Bluetengerueche mit einem Touch spritziger Zitrone.",
        "Ein Hauch von Narzissen steigt die Luft empor.",
        "Du atmest laechelnd verschiedene Rosenaromen ein.",
        "Ein zarter Narzissengeruch befluegelt deine Phantasie.",
        "Du fuehlst Dich durch den wohligen Kalanchoenwind gestaerkt." }));

  AddDetail( ({"mischung","bluetenmischung","bestandteile"}),
	     "Diese Mischung enthaelt verschiedene Blueten, aber auch Wurzeln "
	     "und Gewuerze.");
  
  AddDetail( ({"wurzeln"}),
	     "Die Wurzeln sehen schoen aus und geben hier den erdnahen Aspekt."); 
  
  AddDetail( ({"aspekt"}),
	     "Alle Bestandteile sind natuerlich.");
  
  AddDetail( ({"gewuerze"}),
	     "Die Gewuerze verpassen dem Ganzen eine wunderbare feine Duftnote.");
  
  AddDetail( ({"duftnote","note","duft","duefte"}),
	     "Man kann durch diese Verpackung nichts riechen. Erst in der passenden "
	     "Schuessel kann das Potpourri seinen Duft entfalten.");

  AddDetail( ({"schuessel","kristallschuessel"}),
	     "Du bist Dir sicher, Du findest die geeignete Kristallschuessel in "
	     "einem bestimmten Laden");

  AddDetail( ({"laden"}),
	     "Erkundige Dich einmal. Das Potpourri stammt sicher auch von dort.");

  AddDetail( ({"blueten"}),
	     "Es sind viele unterschiedliche gelbe Blueten in der Verpackung, aber "
	     "Kalanchoe, Rose und Narzissen stechen besonders hervor.");

  AddDetail( ({"kalanchoen","kalanchoe"}),
	     "Die kleinen Blueten der Kalanchoen mischen das Potpourri mit seiner "
	     "feurig gelben Farbe auf.");

  AddDetail( ({"farbe","gelb"}),
	     "Gelb bestimmt hier Farbe der Bluetenmischung.");

  AddDetail( ({"rosen","rose"}),
	     "Die feinen Blueten der gelben Rosen geben einen zierlich-zarten "
	     "Duft ab, der dem Ganzen eine liebliche Note verleiht.");

  AddDetail( ({"narzissen","narzisse"}),
	     "Der fruehlingshafte Duft dieser Bluetenmischung wird von den "
	     "leicht wirkenden Narzissen gepraegt.");

  AddDetail( ({"zitronen","zitronenscheiben"}),
	     "Die Zitronen bieten nicht nur optisch eine Auffrischung, sondern "
	     "auch vom Duft eine zitrusfruchtige Note.");

  AddDetail( ({"auffrischung"}),
	     "Ein Potpourri soll Dich ja einfach erfreuen.");
  
  AddDetail( ({"ganze","ganzen"}),
	     "Das Ganze besteht ja aus den Blueten, Wurzeln, Gewuerzen und den "
	     "getrockneten Zitronenscheiben.");

  AddDetail( ({"Papier"}),
	     "Die Verpackung besteht aus dem transparenten Papier, in welches das Potpourri "
	     "eingefuellt wurde.");

  AddDetail( ({"verpackung"}),
	     "Das transparente Papier knistert in Deinen Haenden und das Potpourri "
	     "raschelt darin.");

  AddDetail( ({"haenden","haende"}),
	     "Du haelst das Potpourri verpackt in Deinen Haenden.");

}

