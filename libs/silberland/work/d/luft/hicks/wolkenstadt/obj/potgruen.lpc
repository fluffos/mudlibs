#include "../def.h"

inherit OBJ "stdpot";


void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein gruenes Potpourri");
  SetProp(P_LONG,
	  "Die Mischung besteht aus verschiedenen Pflanzen wie Brennesseln, Gras "
	  "und Hortensien und wurde mit Apfelscheiben noch verfeinert. "
	  "Das Ganze ist in ein transparentes Papier eingepackt." );

  SetProp(P_MATERIAL, ([MAT_PLANT:100]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 100);  
  SetProp(P_NAME_ADJ, "gruen");
  AddAdjective(({"gruen", "gruenes","gruene"}));

  AddId("potgruen");
  
  SetProp(P_POTPOURRI, ({
    "Fruchtiger Wiesenduft umschmeichelt Deine Sinne.",
    "Du entspannst Dich bei dem herben Potpourri-Geruch.",
    "Blumig-wuerzige Parfuems erfuellen den Raum.",
    "Wohliger Brenneselgeruch durchstroemt den Raum.",
    "Du erschnupperst den Duft von Hortensienblueten.",
    "Du erriechst verschiedene Grasgerueche mit einem Touch von fruchtigem Apfel.",
    "Ein Hauch von Brennessel steigt die Luft empor.",
    "Du atmest laechelnd verschiedene Hortensienduefte ein.",
    "Ein fruchtig-leichtes Apfelaroma befluegelt deine Phantasie.",
    "Der zarte Apfelgeruch kitzelt in Deiner Nase." }));

  AddDetail( ({"mischung","pflanzenmischung","bestandteile"}),
	     "Diese Mischung enthaelt verschiedene Pflanzen, aber auch Wurzeln "
	     "und Gewuerze.");
  
  AddDetail( ({"wurzeln"}),
	     "Die Wurzeln sehen schoen aus und geben hier den erdnahen Aspekt.");
  
  AddDetail( ({"aspekt"}),
	     "Alle Bestandteile sind natuerlich.");
  
  AddDetail( ({"gewuerze"}),
	     "Die Gewuerze verpassen dem Ganzen eine wunderbare feine Duftnote.");
  
  AddDetail( ({"duftnote","note","duft","duefte"}),
	     "Man kann durch diese Verpackung nichts riechen. Erst in der passenden "
	     "Schuessel kann das Potpourri seinen Duft entfalten.");

  AddDetail( ({"schuessel","kristallschuessel"}),
	     "Du bist Dir sicher, Du findest die geeignete Kristallschuessel in "
	     "einem bestimmten Laden");

  AddDetail( ({"laden"}),
	     "Erkundige Dich einmal. Das Potpourri stammt sicher auch von dort.");

  AddDetail( ({"pflanzen"}),
	     "Es sind viele unterschiedliche gruene Pflanzen in der Verpackung, aber "
	     "Brennessel, Gras und Hortensien stechen besonders hervor.");

  AddDetail( ({"brennesseln","brennessel"}),
	     "Die Blueten und die Blaetter der Brennessel duerften einen frischen, "
	     "herben Duft verstroemen.");

  AddDetail( ({"blaetter","brennesselblaetter"}),
	     "Die Brennesselblaetter sind gross und randwaerts gezackt.");

  AddDetail( ({"gras"}),
	     "Du entdeckst verschiedenste Graeser in dem Papier und stellst "
	     "Dir die diversen aromatischen Gerueche vor.");

  AddDetail( ({"gerueche"}),
	     "Du denkst an frisch gemaehtes Gras. Mhhhh!");

  AddDetail( ({"hortensie","hortensien"}),
	     "Die Bluetenspitzen der Hortensien wandeln sich von einem zartgruen zu "
	     "einem zartrosa und duften suessherb.");

  AddDetail( ({"bluetenspitzen","spitzen"}),
	     "Fliessend in das Zartrosa endet die zartgruene Bluete.");

  AddDetail( ({"zartrosa","rosa"}),
	     "Du findest, dass das rosa dem gruenen Potpourri einen wunderschoenen "
	     "Farbklecks gibt.");

  AddDetail( ({"farbklecks","klecks"}),
	     "Im Ganzen betrachtet ist diese Bluetenmischung gruen.");

  AddDetail( ({"aepfel","apfel","apfelscheiben"}),
	     "Die Apfelscheiben bieten nicht nur optisch eine Auffrischung, sondern "
	     "auch vom Duft her eine fruchtige Note.");

  AddDetail( ({"auffrischung"}),
	     "Ein Potpourri soll ja Dich einfach erfreuen.");

  AddDetail( ({"ganze","ganzen"}),
	     "Das Ganze besteht ja aus den Pflanzen, Wurzeln, Gewuerzen und den "
	     "getrockneten Apfelscheiben.");

  AddDetail( ({"Papier"}),
	     "Die Verpackung besteht aus dem transparenten Papier, in welches das Potpourri "
	     "eingefuellt wurde.");

  AddDetail( ({"verpackung"}),
	     "Das transparente Papier knistert in Deinen Haenden und das Potpourri "
	     "raschelt darin.");

  AddDetail( ({"haenden","haende"}),
	     "Du haelst das Potpourri verpackt in Deinen Haenden.");

}
