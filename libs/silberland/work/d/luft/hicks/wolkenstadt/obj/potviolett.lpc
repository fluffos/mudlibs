#include "../def.h"

inherit OBJ "stdpot";


void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein violettes Potpourri");
  SetProp(P_LONG,
	  "Die Mischung besteht aus verschiedenen Blueten wie Cosmeablueten, "
	  "Disteln und Malven und wurde mit getrockneten Brombeeren "
	  "verfeinert. Das Ganze ist in ein transparentes Papier eingepackt." );

  SetProp(P_MATERIAL, ([MAT_PLANT:100]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 100);
  SetProp(P_NAME_ADJ, "violett");
  AddAdjective(({"violett", "violettes","violette"}));
  
  AddId("potviolett");
  
  SetProp(P_POTPOURRI, ({
    "Eine blumiger Sommerwind erfrischt Deine Umgebung.\n",
    "Du entspannst Dich bei dem fruchtigen Potpourri-Geruch.\n",
    "Kraeftige Parfumduefte berauschen Deine Sinne.\n",
    "Ein zarter Geruch von Cosmeablueten durchstroemt den Raum.\n",
    "Du erschnupperst das gruene Aroma von Disteln.\n",
    "Du erriechst sommerliche Bluetengerueche mit einem Touch fruchtiger Brombeere.\n",
    "Ein Hauch von Malvenblueten steigt die Luft empor.\n",
    "Du atmest laechelnd verschiedene Graeserduefte ein.\n",
    "Ein wuerziger Brombeergeruch befluegelt deine Phantasie.\n",
    "Du fuehlst Dich durch den sommerlichen Bluetenwind gestaerkt.\n" }));

  AddDetail( ({"mischung","bluetenmischung","bestandteile"}),
	     "Diese Mischung enthaelt verschiedene Blueten, aber auch Wurzeln "
	     "und Gewuerze.");
  
  AddDetail( ({"wurzeln"}),
	     "Die Wurzeln sehen schoen aus und geben hier den erdnahen Aspekt.");
  
  AddDetail( ({"aspekt"}),
	     "Alle Bestandteile sind natuerlich.");
  
  AddDetail( ({"gewuerze"}),
	     "Die Gewuerze verpassen dem Ganzen eine wunderbare feine Duftnote.");
  
  AddDetail( ({"duftnote","note","duft","duefte"}),
	     "Man kann durch diese Verpackung nichts riechen. Erst in der passenden "
	     "Schuessel kann das Potpourri seinen Duft entfalten.");

  AddDetail( ({"schuessel","kristallschuessel"}),
	     "Du bist Dir sicher, Du findest die geeignete Kristallschuessel in "
	     "einem bestimmten Laden");

  AddDetail( ({"laden"}),
	     "Erkundige Dich einmal. Das Potpourri stammt sicher auch von dort.");

  AddDetail( ({"blueten"}),
	     "Es sind viele unterschiedliche violetten Blueten in der Verpackung, aber "
	     "Cosmeablueten, Disteln und Malven stechen besonders hervor.");

  AddDetail( ({"cosmeablueten","cosmea"}),
	     "Die Cosmea besticht durch ihren kraeftigen pink-violetten Ton.");

  AddDetail( ({"ton","farbton"}),
	     "Der violette Farbton umsaeumt eine gelbe Mitte.");

  AddDetail( ({"mitte"}),
	     "Die Mitte der Cosmea ist von tausenden von Pollen belegt.");

  AddDetail( ({"pollen"}),
	     "Du bist Dir sicher, dass die Pollen den Duft erzeugen.");
  
  AddDetail( ({"disteln","distel"}),
	     "Dem nadeligen gruenen Koerbchen sitzen die feinen Bluetenblaetter auf.");

  AddDetail( ({"koerbchen","distelkoerbchen"}),
	     "Mhh, Du koenntest gestochen werden, wenn Du das Koerbchen anfasst.");

  AddDetail( ({"bluetenblaetter","blaetter"}),
	     "Die winzig kleinen Blaetter leuchten wunderbar violett und bilden einen "
	     "harmonischen Kontrast zum Distelkoerbchen.");

  AddDetail( ({"kontrast"}),
	     "Das gruene nadelige Koerbchen ist wirklich gegensaetzlich zu den feinen "
	     "unzaehligen Bluetenblaettern.");

  AddDetail( ({"malven","malve","malvenknospe","malvenknospen"}),
	     "Die Malvenknospen halten sich in einer zart-violetten Farbe bedeckt und "
	     "weichen mit ihrer Zartheit das gesamte Potpourri ab.");

  AddDetail( ({"farbe"}),
	     "Fuer manch einen mag Malve keine Farbe sein.");

  AddDetail( ({"zartheit"}),
	     "Nicht nur die Farbe und die Knospe strahlen eine Zartheit aus. Auch sein "
	     "Duft verhaelt sich sanft und dezent.");
  
  AddDetail( ({"brombeeren"}),
	     "Die Brombeeren bieten nicht nur optisch eine Auffrischung, sondern "
	     "auch vom Duft eine fruchtige Note.");

  AddDetail( ({"auffrischung"}),
	     "Ein Potpourri soll Dich ja einfach erfreuen.");

  AddDetail( ({"ganze","ganzen"}),
	     "Das Ganze besteht ja aus den Blueten, Wurzeln, Gewuerzen und den "
	     "getrockneten Brombeeren.");

  AddDetail( ({"Papier"}),
	     "Die Verpackung besteht aus dem transparenten Papier, in welches das Potpourri "
	     "eingefuellt wurde.");

  AddDetail( ({"verpackung"}),
	     "Das transparente Papier knistert in Deinen Haenden und das Potpourri "
	     "raschelt darin.");

  AddDetail( ({"haenden","haende"}),
	     "Du haelst das Potpourri verpackt in Deinen Haenden.");

}

