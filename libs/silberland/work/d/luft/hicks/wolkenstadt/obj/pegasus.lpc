// 20.1.2004
// 
// Transporter meines Gesellenstueckes "Wolkenstadt"

inherit "std/transport";

#include "../def.h"


void create() 
{
  ::create();
  
  SetProp(P_INT_SHORT, "Auf einem Pegasus.");
  SetProp(P_INT_LONG, "Du sitzt auf dem Ruecken eines Pegasus. Er hat "
	  "wunderschoen geschwungene Fluegel und einen muskuloesen "
	  "Koerperbau. Seine weisse, wallende Maehne flattert leicht im "
	  "Wind.");
  SetProp(P_SHORT, "Ein Pegasus");
  SetProp(P_LONG, "Vor Dir steht ein praechtiger Pegasus. Er laedt Dich "
	  "ein auf ihn aufzusteigen.\n");
  SetProp(P_NAME, "Pegasus");
  SetProp(P_GENDER,MALE);
  SetProp(P_TRANSPARENT, 1);
  AddId( ({"pegasus","pferd" }));
  
  AddDetail( ({"pegasus","pferd"}),
	     ("Er ist wunderschoen und sein Fell schimmert weiss."));
  
  AddDetail( ({"fell"}),
	     ("Es ist so seidig weich, dass Du es streicheln moechtest."));
  
  AddDetail( ({"fluegel"}),
	     ("Du sitzt auf seinem Ruecken und fuehlst Dich sicher."));
  
  AddDetail( ({"ruecken"}),
	     ("Du sitzt sicher auf dem fliegenden Pferd und wuschelst Dich "
	      "in seine schoene, weisse Maehne hinein."));
  
  AddDetail( ({"koerperbau","bau","koerper"}),
	     ("Der Pegasus ist sehr geschmeidig und wirkt auch majestaetisch. "
	      "Sein Fell schimmert seidig weich im Licht."));

  AddDetail( ({"licht"}),
             "Es ist genug Lich da, das das Fell gut zur Geltung bringt.");

  AddDetail( ({"geltung"}),
             "Du rufst ein 'ahhhhhh' aus. ;-)");
  
  AddDetail( ({"maehne","haar"}),
	     "Die Maehne flattert so flauschig im Wind, dass Du sie am "
	     "liebsten durchwuscheln moechtest.");
  
  AddDetail( ({"wind"}),
	     "Die Maehne flattert wild im Wind.");
  
  SetProp(P_DEPARTMSG, ({
    "Der Pegasus nimmt Anlauf. Du krallst Dich in seine Maehne fest und "
      "schon hebt er ab.\n", 
      "Der Pegasus nimmt Anlauf und hebt ab. Schon segelt er in die Luefte.\n"}));
  
  SetProp(P_ARRIVEMSG, ({
    "Der Pegasus steuert auf den Boden zu und landet sanft.\n",
      "Ein Pegasus landet auf dem Platz.\n"}));
  
  SetProp(P_ENTERMSG, ({
    "klettert auf den Ruecken",
      "schwingt sich auf den Ruecken"}));
  
  SetProp(P_ENTERFAIL, ({
    "Es passen nur 2 Personen auf den Ruecken des Pegasus.",
      "hat keinen Platz mehr auf den Ruecken des Pegasus"}));
  SetProp(P_MAX_PASSENGERS, 2);
  
  SetProp(P_LEAVEMSG, ({
    "steigt vom Pferd ab",
      "klettert vom Ruecken des Pegasus herunter"}));
  
  SetProp(P_LEAVEFAIL, ({
    "Du wuerdest in die Tiefe stuerzen, wenn Du jetzt abspringst",
      "wollte sich in die Tiefe stuerzen"}));
  
  /* Verben */
  AddCmd( ({"betrete","betritt"}),"cmd_betreten");
  AddCmd( ({"steig","steige","spring","springe","kletter","klettere"}),"cmd_rauf_runter");
  AddCmd( ({"verlass","verlasse"}),"cmd_verlassen");
  AddCmd( ({"streichel","streichle"}),"cmd_streicheln");
  AddCmd( ({"wuschel","wuschle","durchwuschle","durchwuschel"}),"cmd_wuscheln");
  AddCmd( ({"knuddel","knuddle","kuschel","kuschle","durchkuschle","durchkuschel"}),"cmd_kuscheln");
  AddCmd( ({"hau","haue","schlag","schlage"}),"cmd_schlagen");
  AddCmd( ({"tritt","trete"}),"cmd_schlagen");
  
  /* Kurs */
  AddRoute(ROOM "duene", 30, 5, "Duene", 
	   ({"duene","boden","silberland","land"}), "zur Duene");
  AddMsg(BS("Du schwebst in die Luefte und fuehlst Dich jetzt schon "
	    "frei ..."), 8);
  AddMsg(BS("Der Ausblick ist gigantisch. Du erkennst das gesamte "
	    "Silberland, das Meer und die Inseln ..."), 10);
  AddMsg(BS("Der Pegasus wiehert kurz auf. Seine Maehne flattert wild im "
	    "Wind ..."), 8);
  AddMsg(BS("Ploetzlich fliegt eine kreischende Moewe dicht an Dir vorbei. "
	    "Erschrocken duckst Du Dich ..."),10);
  AddMsg(BS("Die Wolkendecke liegt dicht ueber Euch. Ploetzlich schwebt eine "
	    "Wolke vorbei, die wie ein Hase aussieht. Du kicherst ..."),10);
  AddMsg(BS("Du schraubst Dich immer weiter in die Hoehe, dass Dir "
	    "schwindelig wird ..."),8);
  AddMsg(BS("Dir wird uebel, aber Du kannst Dich noch beherrschen ..."),6);
  AddMsg(BS("Du naeherst Dich einer dicken, weissen Wolkenfront ..."),5);
  AddMsg(BS("Der Wind saust Dir um die Ohren und erfrischt Dich ..."),6);
  AddMsg(BS("Du erblickst in der Ferne ein grosses Glitzern ..."),5);
  AddMsg(BS("Du wirst neugierig und das immer naeher kommende Juwel wird "
	    "groesser ..."),8);
  AddMsg(BS("Das ist eine grosse Wolkenstadt aus Glas. Darueber spannt sich "
	    "ein praechtiger Regenbogen ..."),10);
  AddMsg(BS("Du erkennst einen Palast, Strassenringe und lauter Haeuser aus "
	    "Glas und Schlingpflanzen ..."),10);
  AddMsg(BS("Der Pegasus fliegt noch einen letzten Looping um den Regenbogen "
	    "und fliegt auf die Mitte der Stadt zu ..."),7);
  
  AddRoute(ROOM "ws1", 30,5, "Liliandor", 
	   ({"wolkenstadt","stadt","liliandor","himmel"}), "zur Wolkenstadt");
  
  AddMsg(BS("Der Pegasus schraubt sich in die Luefte ..."),6);
  AddMsg(BS("Du drehst einen Bogen ueber das weite Wolkenland. Alles wirkt "
	    "so wattig und schimmert in Pastellfarben ..."),10);
  AddMsg(BS("Der Wind spielt mit Deinen Haaren und schmeichelt sanft Deine "
	    "Haut ..."),8);
  AddMsg(BS("Ein wunderschoener Pegataur gesellt sich zu Euch und winkt Euch "
	    "freudenstrahlend zu ..."),7);
  AddMsg(BS("Du winkst ueberrascht zurueck. Du bewunderst den maennlichen "
	    "Pegataur mit seinem blonden Schopf ..."),10);
  AddMsg(BS("Der Pegasus verlaesst die Wolkenfront und laesst sich weiter "
	    "Richtung Silberland herab ..."),8);
  AddMsg(BS("Du erkennst schon Midas und das Fischerdorf und die suedlich "
	    "davon liegenden Inseln ..."),7);
  AddMsg(BS("Das Meer funkelt azurblau und das Festland hat eine "
	    "gruen-braeunliche Farbe ..."),8);
  AddMsg(BS("Huch! Schon wieder diese Wolke, die wie ein Hase aussieht. Ob "
	    "dies eine Bedeutung hat?"),9);
  AddMsg(BS("Der Pegasus stuerzt sich ploetzlich in die Tiefe und ihr rast "
	    "auf eine Wiese zu ..."),5);
  AddMsg(BS("Du bekommst einen Schreck und Dein Herz rast, als der Pegasus "
	    "kurz vor dem Erdboden wieder hinauf gleitet ..."),8);
  AddMsg(BS("Das gefluegelte Pferd wiehert auf als wuerde es lachen ..."),10);
  AddMsg(BS("Du aergerst Dich ueber diesen Scherz, als Du schon die Duene "
	    "erkennst ..."),10);
  AddMsg(BS("Du segelst kurz auf und steuerst direkt auf die Duene zu ..."),7);
  
  Start();
}

int cmd_betreten(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if(str && id(str))
    return Enter();
  return 0;
}

int cmd_rauf_runter(string str)
{
  notify_fail("Wo willst Du rauf- oder runterklettern?\n");
  if(str=="auf pferd"||
     str=="auf pegasus"||
     str=="auf pferd auf"||
     str=="auf pegasus auf"||
     str=="auf pferd rauf"||
     str=="auf pegasus rauf"||
     str=="auf pferd hinauf"||
     str=="auf pegasus hinauf"||
     str=="auf"||
     str=="rauf"||
     str=="hinunter")
    return Enter();
  
  if(str=="von pferd"||
     str=="von pegasus"||
     str=="von pferd ab"||
     str=="von pegasus ab"||
     str=="von pferd runter"||
     str=="von pegasus runter"||
     str=="von pferd hinunter"||
     str=="von pegasus hinunter"||
     str=="runter"||
     str=="ab"||
     str=="hinunter")
    return Leave();
  return 0;
}

int cmd_verlassen(string str)
{
  notify_fail("Was willst Du verlassen?\n");
  if(str && id(str))
    return Leave();
  return 0;
  
}

int cmd_streicheln(string str)     
{
  
  notify_fail("Wen willst Du streicheln?\n");
  
  if(!(str=="pegasus"||
       str=="pferd"||
       str=="maehne"||
       str=="fell")) 
    
    return 0;
  
  write(BS("Du streichelst sanft das weiche Fell des Pegasus. Er scheint es "
	   "sichtlich zu geniessen und wiehert Dir freudig zu."));
  say(TPN+" streichelt das Fell des Pegasus.\n");
  
  return 1;
  
}

int cmd_wuscheln(string str)	
{
  
  notify_fail("Was willst Du wuscheln?\n");
  
  if(!(str=="maehne"||
       str=="haar"||
       str=="maehne durch"||
       str=="haar durch")) 
    
    return 0;
  
  write(BS("Du durchwuschelst die weiche Maehne und flauscht Dich in das "
	   "duftende Haar."));
  say(TPN+" durchwuschelt die Maehne des Pegasus.\n");
  
  return 1;
}

int cmd_kuscheln(string str)	
{
  
  notify_fail("Was willst Du kuscheln?\n");
  
  if(!(str=="pegasus"||
       str=="pferd"||
       str=="fliegendes pferd"||
       str=="maehne"||
       str=="haar"||
       str=="fell"||
       str=="in pegasus"||
       str=="in pferd"||
       str=="in fliegendes pferd"||
       str=="in maehne"||
       str=="in haar"||
       str=="in fell")) 
    
    return 0;
  
  write(BS("Du kuschelst und knuddelst Dich in das Fell des Pegasus, der "
	     "wohlwollend aufwiehert."));
  say(BS(TPN+" kuschelt und knuddelt sich in den Pegasus. Du hoerst ein lautes, "
	     "wohlwollendes Wiehern."));
  
  return 1;
}

int cmd_schlagen(string str)	
{
  
  notify_fail("Wen willst Du schlagen?\n");
  
  if(!(str=="pegasus"||
       str=="pferd"||
       str=="fliegendes pferd")) 
    
    return 0;
  
  write(BS("Du schlaegst den Pegasus, der Dir geschickt ausweicht. PATSCH! "
	      "Schon hat er Dir einen Tritt verpasst."));
  say(BS(TPN+" schlaegt den Pegasus, der prompt mit einem Gegentritt pariert."));
  
  return 1;
}


int cmd_treten(string str)	
{
  
  notify_fail("Wen willst Du treten?\n");
  
  if(!(str=="pegasus"||
       str=="pferd"||
       str=="fliegendes pferd")) 
    
    return 0;
  
  write(BS("Du tretest den Pegasus, der Dir geschickt ausweicht. PATSCH! "
	      "Schon hat er Dir einen Tritt verpasst."));
  say(BS(TPN+" tritt den Pegasus, der prompt mit einem Gegentritt pariert."));
  
  return 1;
}

void init()
{
  ::init();
  if (interactive(this_player()))
    {
      catch(call_other(ROOM "duene","???"));
      catch(call_other(ROOM "ws1","???"));
    }
}
