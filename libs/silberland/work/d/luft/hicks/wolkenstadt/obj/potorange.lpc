#include "../def.h"

inherit OBJ "stdpot";


void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein oranges Potpourri");
  SetProp(P_LONG,
	  "Die Mischung besteht aus verschiedenen Blueten wie Dahlien, "
	  "Feuerlilien und Tulpen und wurde mit Orangenscheiben verfeinert. "
	  "Das Ganze ist in ein transparentes Papier eingepackt." );

  SetProp(P_MATERIAL, ([MAT_PLANT:100]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 100);
  SetProp(P_NAME_ADJ, "orange");
  AddAdjective(({"orange", "oranges","orange"}));

  AddId("potorange");
  
  SetProp(P_POTPOURRI, ({
    "Eine frische Fruehlingsbrise erfrischt Deine Umgebung.",
    "Du entspannst Dich bei dem orangigen Potpourri-Geruch.",
    "Zarte Parfumduefte beleben Deine Sinne.",
    "Wohliger Liliengeruch durchstroemt den Raum.",
    "Du erschnupperst das Aroma von Dahlien und Tulpen.",
    "Du erriechst Bluetengerueche mit einem Touch fruchtiger Orange.",
    "Ein Hauch von Dahlie steigt die Luft empor.",
    "Du atmest laechelnd verschiedene Tulpenduefte ein.",
    "Ein kraeftiger Orangengeruch befluegelt deine Phantasie.",
    "Du fuehlst Dich durch den fruehlingshaften Lilienwind gestaerkt." }));

  AddDetail( ({"mischung","bluetenmischung","bestandteile"}),
	     "Diese Mischung enthaelt verschiedene Blueten, aber auch Wurzeln "
	     "und Gewuerze.");
  
  AddDetail( ({"wurzeln"}),
	     "Die Wurzeln sehen schoen aus und geben hier den erdnahen Aspekt.");
  
  AddDetail( ({"aspekt"}),
	     "Alle Bestandteile sind natuerlich.");
  
  AddDetail( ({"gewuerze"}),
	     "Die Gewuerze verpassen dem Ganzen eine wunderbare feine Duftnote.");
  
  AddDetail( ({"duftnote","note","duft","duefte"}),
	     "Man kann durch diese Verpackung nichts riechen. Erst in der passenden "
	     "Schuessel kann das Potpourri seinen Duft entfalten.");

  AddDetail( ({"schuessel","kristallschuessel"}),
	     "Du bist Dir sicher, Du findest die geeignete Kristallschuessel in "
	     "einem bestimmten Laden");

  AddDetail( ({"laden"}),
	     "Erkundige Dich einmal. Das Potpourri stammt sicher auch von dort.");

  AddDetail( ({"blueten"}),
	     "Es sind viele unterschiedliche orange Blueten in der Verpackung, aber "
	     "Dahlien, Feuerlilien und Tulpen stechen besonders hervor.");

  AddDetail( ({"dahlien","dahlie"}),
	     "Die Dahlien sehen aus wie kleine untergehende Sonnen.");

  AddDetail( ({"sonnen","sonne"}),
	     "Von flammendem Gelb bis zu einem blutroten Orange sind die Dahlien "
	     "durchzogen.");

  AddDetail( ({"gelb","orange"}),
	     "Diese Farben dominieren in diesem Potpourri.");

  AddDetail( ({"feuerlilien","feuerlilie","lilien","lilie"}),
	     "Die langen, schmalen Blaetter der Lilien umranden die heraus stehenden "
	     "Stempeln. Du bist Dir sicher, dass sie einen zarten weichen Duft " 
	     "ausstroemen werden.");

  AddDetail( ({"blaetter","lilienblaetter","blatt","bluetenblaetter"}),
	     "Die grazilen Bluetenblaetter werden durch ihre orange Farbe betont.");

  AddDetail( ({"farbe"}),
	     "Orange ist die dominierende Farbe.");

  AddDetail( ({"gelb"}),
	     "Die Stempel fast jeder Bluete ist gelb.");

  AddDetail( ({"stempel","stempeln"}),
	     "Jede einzelne Bluete hat einen gelben Stempel.");

  AddDetail( ({"tulpen","tulpe","tulpenblueten"}),
	     "Die Tulpenblueten sind kelchartig geformt und sind von zartgelb ueber "
	     "orange ins feuerrot gestreift. Du erinnerst Dich an eine "
	     "Fruehlingswiese.");

  AddDetail( ({"fruehlingswiese","wiese"}),
	     "Deine Gedanken an all die fruehlingshaften Duefte werden befluegelt.");

  AddDetail( ({"gedanken"}),
	     "Du atmest einmal tief ein...");
	  
  AddDetail( ({"orangen","orangenscheiben"}),
	     "Die Orangen bieten nicht nur optisch eine Auffrischung, sondern "
	     "auch vom Duft eine fruchtige Note.");

  AddDetail( ({"auffrischung"}),
	     "Ein Potpourri soll Dich ja einfach erfreuen.");

  AddDetail( ({"ganze","ganzen"}),
	     "Das Ganze besteht ja aus den Blueten, Wurzeln, Gewuerzen und den "
	     "getrockneten Orangenscheiben.");

  AddDetail( ({"Papier"}),
	     "Die Verpackung besteht aus dem transparenten Papier, in welches das Potpourri "  
	     "eingefuellt wurde.");

  AddDetail( ({"verpackung"}),
	     "Das transparente Papier knistert in Deinen Haenden und das Potpourri "
	     "raschelt darin.");

  AddDetail( ({"haenden","haende"}),
	     "Du haelst das Potpourri verpackt in Deinen Haenden.");

}

