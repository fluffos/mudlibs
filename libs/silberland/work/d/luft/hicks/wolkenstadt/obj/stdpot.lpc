#include "../def.h"

inherit "std/thing";


void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein duftendes Potpourri");
  SetProp(P_LONG,
      "Ein duftendes Potpourri. Das Ganze wurde in ein transparentes "
      "Papier eingepackt." );

  SetProp(P_NAME, "Potpourri");
  SetProp(P_NAME_ADJ, "duftend");
  AddAdjective(({"duftend", "duftendes","duftende"}));

  AddId(({"potpourri", "bluetenmischung"}));

  SetProp(P_POTPOURRI, ({"Das Potpourri duftet verfuehrerisch."}));

  SetProp(P_MATERIAL, ([MAT_PLANT:100]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 100);
}
