#include "../def.h"
#include <food.h>

inherit "std/food";

void create() 
{
  if (!is_clone(TO)) return;
//old
//  ::create();
  ::create( ({"iss","kau","kaue"}) );

  SetProp(P_SHORT, "Eine rosa Kautablette");
  SetProp(P_LONG,
      "Das ist eine rosa Kautablette, die gegen Sodbrennen helfen soll.");
  SetProp(P_NAME, "Kautablette");
  SetProp(P_GENDER, FEMALE);
//old
//AddId(({"kautablette","tablette"}));
  AddId(({"kautablette","tablette","medizin"}));
  AddAdjective(({"rosa", "rosafarbene", "rosafarbener", "rosafarbenem"}));

  SetProp(P_MATERIAL, ([MAT_MISC_DRUG: 100]) );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 20);
  SetProp(P_NOBUY, 1);
  SetProp(P_FOOD_STATE, F_RAW);
  SetProp(P_FOOD_INFO, ([
            F_HEAL     : ({ 1,1 }),
//old, soak statt drink
//            F_DRINK    : 1,
            F_SOAK    : 1,
            F_SHOW_RAW : 0,
            F_MSG      : "Du kaust auf der Tablette herum und laesst sie auch ein "
                    "wenig zergehen. Dein Magen beruhigt sich!",
            F_MSG_ROOM : "schluckt eine Tablette.",
//old, _kau_tablette
//            F_VERB     : "essen"]));
            F_VERB     : "kauen"]));

  
}
