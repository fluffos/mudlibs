// Objekt - "Wolkenstadt"

#include "../def.h"
#include <properties.h>
#include <food.h>

inherit "std/food";

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Zitrone");
  SetProp(P_LONG,
	  "Das ist eine gelbe Zitrone." );
  SetProp(P_INFO, "Sie wuerde sich als geschleuderte Saeuregranate gut eignen.");
  SetProp(P_NAME, "Zitrone");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"zitrone"}));
  
  SetProp(P_MATERIAL, ([MAT_FRUIT: 100]));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 550);
  SetProp(P_FOOD_STATE, F_RAW);
  SetProp(P_FOOD_INFO, ([
			 
			 F_HEAL         	    : ({ 1,1 }),
             F_SOAK          	: 1,
			 F_SHOW_RAW 	: 0,
			 F_MSG          	    : "Du beisst in eine Zitrone und verziehst den\n"
			 	                          "Mund. Sauer!!!",
			 F_MSG_ROOM  	: " beisst in eine saure Zitrone und verzieht den Mund.",
    		 F_MSG_DECAY 	: "Die Zitrone verrottet\n",
			 F_VERB          	    : "essen"]));

  start_decay(259200, -1);

  
  AddCmd( ({"schleuder","schleudere"}), "cmd_schleudern");

}

int decay(int silent)
{
  SetProp(P_SHORT, "Eine verfaulte Zitrone.");
  SetProp(P_NAME_ADJ, "verfault");
  return ::decay(silent);
}

int cmd_schleudern(string str)
{
 string wer;
 object p;
 if(!str || str == "") 
	 return 0;
 if(sscanf(str, "zitrone nach %s", wer) != 1 &&
    sscanf(str, "zitrone auf %s", wer) != 1) 
	 return 0;

  if(!(p=present(wer, ENV(TP))))
    {
      write(BS(CAP(wer)+" ist gar nicht da!\n"));
      return -1;
    }

  if(find_player(wer))
    {
      write(BS("Es ist verboten Spieler anzugreifen!\n"));
      return -1;
    }
  
   if(p->QueryProp(P_NOATTACK) != 0)
    {
      write(BS(CAP(wer)+" ist nicht angreifbar!\n"));
      return -1;
    }
  
  if(TP->QueryProp(P_ATTACK_BUSY) )
    {
      write("Du hast jetzt keine Zeit dafuer.\n");
      return 1;
    }
  TP->SetProp(P_ATTACK_BUSY, 4);
  
  write(BS("Du holst weit aus und schleuderst eine Zitrone nach "+CAP(wer)+". "
      "Die Zitrone zerplatzt sofort in tausend Spritzer und veraetzt die "
      "Haut Deines Gegners."));
  say(BS(TPN+" holt weit aus und schleudert aus voller Kraft eine Zitrone nach "
     +CAP(wer)+". Die Zitrone zerplatzt sofort in tausend Spritzer und "
    "veraetzt die Haut des Gegners."));

  if (QueryProp(P_FOOD_STATE) == F_SPOILT)
    p->Defend(50+random(10), ({DT_ACID}), 0, TP);
  else
    p->Defend(300+random(100), ({DT_ACID}), 0, TP);

  remove();

  return 1;
} 
