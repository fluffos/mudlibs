// 20.1.2004
// 
// Objekt meines Gesellenstueckes "Wolkenstadt"

#include "../def.h"

inherit "std/thing";

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Schwanenfeder");
  SetProp(P_LONG,
	  "Diese perlmutfarbene Schwanenfeder ist mittelgross und leicht "
	  "geschwungen. Sie wirkt fast anmutig und ihre Federaeste wiegen "
	  "sich sanft bei jeder Bewegung." );
  SetProp(P_NAME, "Schwanenfeder");
  SetProp(P_GENDER, FEMALE);
  AddId(({"schwanenfeder","feder"}));
  
  SetProp(P_MATERIAL, ([MAT_FEATHER: 98, MAT_PEARL: 2]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 23);
  SetProp(P_NOBUY, 1);
  
  AddDetail( ({"federaeste","aeste"}),
	     "Die Federaeste ziehen sich aus dem Federstiel links und rechts "
	     "hinaus.");
  
  AddDetail( ({"federstiel","stiel"}),
	     "Der Stiel schimmert perlmutfarben und verleiht der ganzen Feder "
	     "einen magischen Glanz.");
  
  AddDetail( ({"glanz"}),
	     "Eine Aura geht aus der gesamten Feder aus und laesst die Luft "
	     "richtig prickeln.");
  
  AddDetail( ({"aura"}),
	     "Sie muss magisch sein.");
  
  AddDetail( ({"luft"}),
	     "Momentan fuehlt sie sich frisch und klaerend an. Das muss wohl "
	     "von der Feder ausgehen.");
  
  AddDetail( ({"bewegung"}),
	     "Die Federaeste wiegen sich wellenfoermig bei jeder Bewegung.");
  
}
