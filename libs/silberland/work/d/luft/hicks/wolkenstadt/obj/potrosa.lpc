#include "../def.h"

inherit OBJ "stdpot";


void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein rosa Potpourri");
  SetProp(P_LONG,
	  "Die Mischung besteht aus verschiedenen Blueten wie Magnolien, Rosen "
	  "und Orchideen und wurde mit getrockneten Himbeeren verfeinert. "
	  "Das Ganze ist in einem transparenten Papier eingepackt." );

  SetProp(P_MATERIAL, ([MAT_PLANT:100]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 100);
  SetProp(P_NAME_ADJ, "rosa");
  AddAdjective(({"rosa","rosanes","rosane"}));
  
  AddId("potrosa");
  
  SetProp(P_POTPOURRI, ({
    "Eine suesse Verfuehungsbrise betoert Deine Umgebung.\n",
    "Du entspannst Dich bei dem rosigen Potpourri-Geruch.\n",
    "Zarte Parfumduefte betaeuben fast Deine Sinne.\n",
    "Wohliger Orchideengeruch durchstroemt den Raum.\n",
    "Du erschnupperst das Aroma von hauchfeiner Vanille.\n",
    "Du erriechst Bluetengerueche mit einem Touch fruchtiger Himbeere.\n",
    "Ein Hauch von Magnolienblueten steigt die Luft empor.\n",
    "Du atmest laechelnd verschiedene Rosenduefte ein.\n",
    "Ein zarter Magnoliengeruch befluegelt deine Phantasie.\n",
    "Du fuehlst Dich durch den belebenden Rosenwind gestaerkt.\n" }));

  AddDetail( ({"mischung","bluetenmischung","bestandteile"}),
	     "Diese Mischung enthaelt verschiedene Blueten, aber auch Wurzeln "
	     "und Gewuerze.");
  
  AddDetail( ({"wurzeln"}),
	     "Die Wurzeln sehen schoen aus und geben hier den erdnahen Aspekt.");
  
  AddDetail( ({"aspekt"}),
	     "Alle Bestandteile sind natuerlich.");
  
  AddDetail( ({"gewuerze"}),
	     "Die Gewuerze verpassen dem Ganzen eine wunderbare feine Duftnote.");
  
  AddDetail( ({"duftnote","note","duft","duefte"}),
	     "Man kann durch diese Verpackung nichts riechen. Erst in der passenden "
	     "Schuessel kann das Potpourri seinen Duft entfalten.");

  AddDetail( ({"schuessel","kristallschuessel"}),
	     "Du bist Dir sicher, Du findest die geeignete Kristallschuessel in "
	     "einem bestimmten Laden");

  AddDetail( ({"laden"}),
	     "Erkundige Dich einmal. Das Potpourri stammt sicher auch von dort.");

  AddDetail( ({"blueten"}),
	     "Es sind viele unterschiedliche rosa Blueten in der Verpackung, aber "
	     "Magnolien, Rosen und Orchideen stechen besonders hervor.");

  AddDetail( ({"magnolien","magnolie"}),
	     "Die zartrosa, schwach duftenden Bluetenblaetter mischen in einem "
	     "Zartrosa das Potpourri auf.");

  AddDetail( ({"bluetenblaetter","blaetter"}),
	     "Die grossen Blaetter sind einzeln in die Bluetenmischung verstreut "
	     "worden.");

  AddDetail( ({"rose","rosen"}),
	     "Kleine und feine Rosenknospen stechen in unterschiedlichen Rosatoenen "
	     "hervor.");

  AddDetail( ({"rosenknospen","knospen"}),
	     "Du schliesst Die Augen und saugst den imaginaeren zarten Rosenduft "
	     "ein.");

  AddDetail( ({"augen"}),
	     "Und schon sind sie wieder geoeffnet!");

  AddDetail( ({"rosenduft"}),
	     "Es wird endlich Zeit, dass Du die Verpackung aufreisst.");

  AddDetail( ({"orchideen","orchidee"}),
	     "Die Koenigin der Blueten dominiert in starkem, impulsivem Pink.");

  AddDetail( ({"pink"}),
	     "Bei naeherer Betrachtung entdeckst Du kleine gelbliche Flecken.");//Du gross

  AddDetail( ({"betrachtung"}),
	     "Du betrachtest die Orchideen genauer.");

  AddDetail( ({"flecken"}),
	     "Sie haben eine cremige Vanillefarbe.");

  AddDetail( ({"vanillefarbe","vanille","farbe"}),
	     "Ob dieses Potpourri auch nach Vanille riecht?");

  AddDetail( ({"koenigin"}),
	     "Das sagt man doch immer.");

  AddDetail( ({"lilaton","lila","ton"}),
	     "Du findest, dass der Flieder farblich sehr gut in dieses Potpourri "
	     "passt, obwohl sie mehr einen Lilaton haben.");

  AddDetail( ({"himbeeren"}),
	     "Die Himbeeren bieten nicht nur optisch eine Auffrischung, sondern "
	     "auch vom Duft eine fruchtige Note.");

  AddDetail( ({"auffrischung"}),
	     "Ein Potpourri soll Dich ja einfach erfreuen.");

  AddDetail( ({"ganze","ganzen"}),
	     "Das Ganze besteht ja aus den Blueten, Wurzeln, Gewuerzen und den "
	     "getrockneten Himbeeren.");

  AddDetail( ({"Papier"}),
	     "Die Verpackung besteht aus dem transparenten Papier, in welches das Potpourri "
	     "eingefuellt wurde.");

  AddDetail( ({"verpackung"}),
	     "Das transparente Papier knistert in Deinen Haenden und das Potpourri "
	     "raschelt darin.");

  AddDetail( ({"haenden","haende"}),
	     "Du haelst das Potpourri verpackt in Deinen Haenden.");

}

