//Danke an Woody!!
//Hicks - Wolkenstadt

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

#define BDEF ({ \
    ({ "wolkenrose", "Eine Wolkenrose", \
       "Das ist eine wunderschoene Wolkenrose.", FEMALE }), \
    ({ "wolkennelke", "Eine Wolkennelke", \
       "Die Wolkennelke hat wunderschoene, gezackte Blueten.", FEMALE }), \
    ({ "wolkenlilie", "Eine Wolkenlilie", \
       "Die Wolkenlilie ist gerade am aufbluehen und Du kannst den Stempel erkennen.", FEMALE }), \
    ({ "wolkentulpe", "Eine Wolkentulpe", \
       "Der Kelch der Wolkentulpe ragt kerzengerade in die Hoehe.", FEMALE }) })

create()
{
  int n;
  if (!is_clone(this_object())) return;
  ::create();
 
  n=random(sizeof(BDEF));
  AddId ( ({ "wolkenblume", BDEF[n][0] }) );
  SetProp (P_SHORT, BDEF[n][1]);
  SetProp (P_LONG, BDEF[n][2]);
  SetProp (P_NAME, explode(BDEF[n][1], " ")[<1]);
  SetProp (P_INFO, "Wenn Du mehrere Blumen gepflueckt hast, dann koenntest Du "
		   "Dir einen Blumenstrauss binden.");
  SetProp (P_GENDER, BDEF[n][3]);
  SetProp (P_WEIGHT, 30+random(20));
  SetProp (P_VALUE, random(10));
  SetProp (P_NOBUY, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_PLANT:25,MAT_CRYSTAL:25,MAT_AIR:25,MAT_WATER:25]));
  SetProp(P_SMELL, "Sie riecht wunderbar leich, blumig und feucht.");

  AddCmd( ({"binde","bind"}),"cmd_blumenstrauss");
  
}

int cmd_blumenstrauss(string str)
{
  object wolkenstrauss;
  int i;
  notify_fail("Was moechtest Du binden?\n");
  if(!(str == "blumenstrauss"|| 
       str == "strauss"||
       str == "wolkenblumenstrauss")) 
	 
	  return 0;

  if(sizeof(filter_objects(all_inventory(TP), "id", "wolkenblume"))<12)
  {
      write(BS("Du hast noch nicht genug Blumen gepflueckt."));

      return -1;
  } 
  
	wolkenstrauss=clone_object(OBJ "wolkenstrauss");
	if (ME_TOO_HEAVY==wolkenstrauss->move(TP,M_GET|M_SILENT))
	  {
	    write(BS("Du bindest einen wundervollen Strauss aus Wolkenblumen. "
		"Doch dieser lastet zu sehr in Deinen Haenden, dass Du ihn zu "
		"Boden legst."));
	    
	    say(BS(TPN+" legt einen Strauss aus Wolkenblumen zu Boden."));
	    
	    wolkenstrauss->move(TO,M_NOCHECK);
	    
	   for(i=1; i<12; i++)
		 catch(present("wolkenblume 2",TP)->remove(1));
	   remove(1);
	   return 1;
      
  }
      write(BS("Du bindest einen wundervollen Strauss aus Wolkenblumen."));
      say(BS(TPN+" bindet sich aus Wolkenblumen einen Blumenstrauss."));
      for(i=1; i<12; i++)
		  catch(present("wolkenblume 2",TP)->remove(1));
	   remove(1);
      return 1;
      
    
  
}
