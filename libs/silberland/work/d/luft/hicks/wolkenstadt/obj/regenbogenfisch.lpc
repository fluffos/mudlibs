// Objekt meines Gesellenstueckes "Wolkenstadt"

#include "../def.h"
#include <properties.h>
#include <food.h>

inherit "std/food";

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Regenbogenfisch");
  SetProp(P_LONG,
	  "Der Regenbogenfisch ist durchsichtig und schillert schoen in "
	  "Regenbogenfarben. Er hat zwei schwarze Augen und Nase." );
  SetProp(P_INFO, "Der Fisch ist durchsichtig und in seinem Bauch schimmert "
	  "Etwas.");
  SetProp(P_NAME, "Regenbogenfisch");
  SetProp(P_GENDER, MALE);
  AddId( ({"regenbogenfisch","fisch"}));
  
  SetProp(P_MATERIAL, ([MAT_FLESH: 100]));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_FOOD_STATE, F_RAW);
  SetProp(P_FOOD_INFO, ([
			 F_HEAL     : ({ 1,1 }),
			 F_DRINK    : 1,
			 F_SHOW_RAW : 0,
			 F_VERB     : "essen"]));
  
  AddDetail( ({"bauch","koerper"}),
	     "Sein Bauch ist kugelrund und enthaelt etwas Durchsichtiges.");
  
  AddDetail( ({"etwas","durchsichtiges"}),
	     "Dich ueberkommt ein unendlich grosser Appetit.");
  
  AddDetail( ({"appetit"}),
	     "Mhhh, Du wuerdest den Fisch so gerne verspeisen.");
  
  AddDetail( ({"augen"}),
	     "Sie sind schwarz und sehr kontrastreich zum zarten Koerper.");
  
  AddDetail( ({"nase"}),
	     "Sie ist laaang und trompetenfoermig.");
  
 
}

void BeimEssen()
{
  object glasmurmel;
  glasmurmel=clone_object(OBJ "glasmurmel");
  if (ME_TOO_HEAVY==glasmurmel->move(TP,M_GET|M_SILENT))
    
  {
    write(BS("Waehrend Du genuesslich auf dem Fisch herumkaust, spuerst einen "
	     "runden, harten Gegenstand im Mund. Er wird so unendlich schwer, "
	     "dass Du ihn auf den Boden spuckst.\n"));
    say(BS(TPN+" isst genuesslich einen Fisch und spuckt dann ploetzlich etwas "
	   "auf den Boden. Wie ekelhaft!\n"));
    
    glasmurmel->remove();
    
    return;
  }
  write(BS("Du isst genuesslich den Fisch.\nWaehrend Du auf diesem "
	   "herumkaust, spuerst Du ploetzlich einen harten, runden Gegenstand. "
	   "Du spuckst ihn aus und haelst eine Glasmurmel in Deiner Hand.\n"));
  say(BS(TPN+" verspeist genuesslich einen Fisch. Ploetzlich verzieht "
	 +TP->QueryPronoun(1)+" das Gesicht und spuckt eine Murmel aus.\n"));
  
}
