// Objekt meines Gesellenstueckes "Wolkenstadt"

#include "../def.h"

inherit "std/thing";

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Glasmurmel");
  SetProp(P_LONG,
	  "Die Murmel besteht aus Glas und schimmert huebsch in "
	  "Regenbogenfarben." );
  SetProp(P_NAME, "Glasmurmel");
  SetProp(P_GENDER, MALE);
  AddId(({"glasmurmel","murmel"}));
  
  SetProp(P_MATERIAL, ([MAT_GLASS: 100]) );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 20);
  SetProp(P_NOBUY, 1);
  
  AddDetail( ({"glas"}),
	     "Sie besteht aus durchsichtigem Glas und Dein Gesicht spiegelt "
	     "sich darin.");
  AddDetail( ({"gesicht"}),
	     "Die Nase wirkt zum Rest relativ gross.");
  
  AddDetail( ({"nase"}),
	     "Du spielst mit der Nase im Glas, die einmal groesser und "
	     "kleiner wird.");
  
  AddDetail( ({"rest"}),
	     "Alles, das ausser der Nase noch erkennbar ist.");
  
  AddDetail( ({"regenbogenfarben","farben"}),
	     "Du kannst alle Farben erkennen, aber trotzdem noch durch die "
	     "Murmel hindurch sehen.");
}
