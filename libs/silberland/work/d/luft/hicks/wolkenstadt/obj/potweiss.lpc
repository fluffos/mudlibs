#include "../def.h"

inherit OBJ "stdpot";

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein weisses Potpourri");
  SetProp(P_LONG,
	  "Die Mischung besteht aus verschiedenen Blueten wie Jasmin, Kirschblueten "
	  "und Margeriten und wurde mit Marshmallows verfeinert. "//wuaeh marchmallows schmilzen ja wenn es heiss wird ..
	  "Das Ganze ist in ein transparentes Papier eingepackt." );

  SetProp(P_MATERIAL, ([MAT_PLANT:100]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 100);
  SetProp(P_NAME_ADJ, "weiss");
  AddAdjective(({"weiss", "weisses","weisse"}));
  
  AddId("potweiss");
  
  SetProp(P_POTPOURRI, ({
    "Eine picksuesse Blumenbrise erfuellt Deine Umgebung.\n",
    "Du entspannst Dich bei dem marshmallowigen Potpourri-Geruch.\n",
    "Blumige Parfumduefte beleben Deine tiefsten Sinne.\n",
    "Klarer Jasmingeruch durchstroemt den Raum.\n",
    "Du erschnupperst das Aroma von Kirschen.\n",
    "Du erriechst Bluetengerueche mit einem Touch fruchtiger Kirsche.\n",
    "Ein Hauch von fruehlingshafter Margeriten steigt die Luft empor.\n",
    "Du atmest verzueckt verschiedene Tulpenduefte ein.\n",
    "Ein kraeftiger Marshmallowgeruch befluegelt deine Phantasie.\n",
    "Du fuehlst Dich durch den Wind aus Kirschblueten gestaerkt.\n" }));

  AddDetail( ({"mischung","bluetenmischung","bestandteile"}),
         "Diese Mischung enthaelt verschiedene Blueten, aber auch Wurzeln "
	     "und Gewuerze.");
  
  AddDetail( ({"wurzeln"}),
	     "Die Wurzeln sehen schoen aus und geben hier den erdnahen Aspekt.");
  
  AddDetail( ({"aspekt"}),
	     "Alle Bestandteile sind natuerlich.");
  
  AddDetail( ({"gewuerze"}),
	     "Die Gewuerze verpassen dem Ganzen eine wunderbare feine Duftnote.");
  
  AddDetail( ({"duftnote","note","duft","duefte"}),
	     "Man kann durch diese Verpackung nichts riechen. Erst in der passenden "
	     "Schuessel kann das Potpourri seinen Duft entfalten.");
  
  AddDetail( ({"schuessel","kristallschuessel"}),
	     "Du bist Dir sicher, Du findest die geeignete Kristallschuessel in "
	     "einem bestimmten Laden");

  AddDetail( ({"laden"}),
	     "Erkundige Dich einmal. Das Potpourri stammt sicher auch von dort.");  

  AddDetail( ({"blueten"}),
	     "Es sind viele unterschiedliche weisse Blueten in der Verpackung, aber "
	     "Jasmin, Kirschenblueten und Margeriten stechen besonders hervor.");
  
  AddDetail( ({"jasmin"}),
	     "Der Jasmin erfuellt das ganze Potpourri mit einem frisch blumigen, aber "
	     "auch ganz leichten herben Duft.");

  AddDetail( ({"kirschblueten","kirschbluete"}),
	     "Du zaehlt unzaehlige Blueten und jede ist schoener als die andere. "
	     "Ihre Details sind filigran gewachsen.");

  AddDetail( ({"details","detail"}),
	     "Du erkennst winzig kleine zartrosa Stempel herausragen.");

  AddDetail( ({"stempel"}),
	     "Du bemerkst, dass die Bluete ueberhaubt eine kleine Nuance ins "
	     "Rosa geht.");

  AddDetail( ({"rosa"}),
	     "Dir Kirschblueten enthalten Rosa.");

  AddDetail( ({"margeriten","margerite"}),
	     "Die Margerite sticht mit ihrem weissen Kopf sofort hervor.");

  AddDetail( ({"kopf"}),
	     "Die weissen zungenfoermigen Bluetenblaetter umsaeumen den strahlend "
	     "gelben Fruchtknoten.");

  AddDetail( ({"bluetenblaetter","blaetter"}),
	     "Weisser als weiss koennen sie gar nicht mehr sein.");

  AddDetail( ({"fruchtknoten","knoten"}),
	     "Er woelbt sich oberhalb der Blutenblaetter prominent hervor.");

  AddDetail( ({"marshmallow","marshmallows"}),
	     "Die wattigen Marshmallows bieten nicht nur optisch eine Auffrischung, "
	     "sondern auch vom Duft eine kindlich-frische Note.");

  AddDetail( ({"auffrischung"}),
	     "Ein Potpourri soll ja Dich einfach erfreuen.");

  AddDetail( ({"ganze","ganzen"}),
	     "Das Ganze besteht ja aus den Blueten, Wurzeln, Gewuerzen und den "
	     "flaumigen Marshmallows.");

  AddDetail( ({"Papier"}),
	     "Die Verpackung besteht aus dem transparenten Papier, in welches das Potpourri "
	     "eingefuellt wurde.");

  AddDetail( ({"verpackung"}),
	     "Das transparente Papier knistert in Deinen Haenden und das Potpourri "
	     "raschelt darin.");

  AddDetail( ({"haenden","haende"}),
	     "Du haelst das Potpourri verpackt in Deinen Haenden.");

}

