#include "../def.h"

inherit OBJ "stdpot";


void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein blaues Potpourri");
  SetProp(P_LONG,
	  "Die Mischung besteht aus verschiedenen Blueten wie Lavendel, Veilchen, "
	  "und Flieder und wurde mit getrockneten Heidelbeeren verfeinert. Das "
	  "Ganze wurde in ein transparentes Papier eingepackt." );

  SetProp(P_MATERIAL, ([MAT_PLANT:100]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 100);
  SetProp(P_NAME_ADJ, "blau");
  AddAdjective(({"blau", "blaues","blaue"}));

  AddId("potblau");

  SetProp(P_POTPOURRI, ({
     "Eine zarte Veilchenwolke umschmeichelt Deine Sinne.",
     "Du entspannst Dich bei dem wohligen Potpourri-Geruch.",
     "Blumig-wuerzige Parfuems erfuellen den Raum.",
     "Wohliger Lavendelgeruch durchstroemt den Raum.",
     "Du erschnupperst das Aroma von Fliederblueten.",
     "Du erriechst Bluetengerueche mit einem Touch fruchtiger Heidelbeere.",
     "Ein Hauch von Heidelbeere steigt in die Luft.",
     "Du atmest laechelnd verschiedene Fliederduefte ein.",
     "Ein zarter Veilchengeruch befluegelt deine Phantasie.",
     "Du fuehlst Dich durch den wohligen Lavendelwind gestaerkt." }));

  AddDetail( ({"mischung","bluetenmischung","bestandteile"}),
	     "Diese Mischung enthaelt verschiedene Blueten, aber auch Wurzeln "
	     "und Gewuerze.");
  
  AddDetail( ({"wurzeln"}),
	     "Die Wurzeln sehen schoen aus und geben hier den erdnahen Aspekt.");
  
  AddDetail( ({"aspekt"}),
	     "Alle Bestandteile sind natuerlich.");
  
  AddDetail( ({"gewuerze"}),
	     "Die Gewuerze verpassen dem Ganzen eine wunderbare feine Duftnote.");
  
  AddDetail( ({"duftnote","note","duft","duefte"}),
	     "Man kann durch diese Verpackung nichts riechen. Erst in der passenden "
	     "Schuessel kann das Potpourri seinen Duft entfalten.");

  AddDetail( ({"schuessel","kristallschuessel"}),
	     "Du bist Dir sicher, Du findest die geeignete Kristallschuessel in "
	     "einem bestimmten Laden");

  AddDetail( ({"laden"}),
	     "Erkundige Dich einmal. Das Potpourri stammt sicher auch von dort.");

  AddDetail( ({"blueten"}),
	     "Es sind viele unterschiedliche blaue Blueten in der Verpackung, aber "
	     "Lilien, Veilchen und Flieder stechen besonders hervor.");

  AddDetail( ({"lavendel"}),
	     "Der Lavendel besticht durch seinen ungemein intensiv und aromatischen "
	     "Geruch und darf in keinem Potpourri fehlen.");

  AddDetail( ({"geruch"}),
	     "Man koennte es auch als lieblich-wuerzig beschreiben und auch etwas "
	     "herb.");

  AddDetail( ({"veilchen"}),
	     "Die Blueten der Veilchen sind sehr zierlich und stroemen "
	     "normalerweise einen zarten und lieblichen Duft aus.");

  AddDetail( ({"flieder"}),
	     "Die Fliederblueten sind in einem zartblassblauen Lilaton "
	     "gehalten.");

  AddDetail( ({"lilaton","lila","ton"}),
	     "Du findest, dass der Flieder farblich sehr gut in dieses Potpourri "
	     "passt, obwohl sie eher einen Lilaton haben.");

  AddDetail( ({"heidelbeeren"}),
	     "Die Heidelbeeren bieten nicht nur optisch eine Auffrischung, sondern "
	     "auch der Duft gibt eine feine fruchtige Note.");

  AddDetail( ({"auffrischung"}),
	     "Ein Potpourri soll Dich und Deine Nase ja einfach erfreuen.");

  AddDetail( ({"ganze","ganzen"}),
	     "Das Ganze besteht aus Blueten, Wurzeln, Gewuerzen und den "
	     "getrockneten Heidelbeeren.");

  AddDetail( ({"Papier"}),
	     "Die Verpackung besteht aus dem transparenten Papier, in welches das Potpourri "
	     "eingefuellt wurde.");

  AddDetail( ({"verpackung"}),
	     "Das transparente Papier knistert in Deinen Haenden und das Potpourri "
	     "raschelt darin. Pass aber auf das Du die zarten Blueten nicht zerstoerst.");

  AddDetail( ({"haenden","haende"}),
	     "Du haelst das Potpourri verpackt in Deinen Haenden.");
}

