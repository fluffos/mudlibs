// "Wolkenstadt"

#include "../def.h"

inherit OBJ "stdpot";


void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein rotes Potpourri");
  SetProp(P_LONG,
	  "Die Mischung besteht aus verschiedenen Blueten wie Rosen, "
	  "Hibiskusblueten und Amaryllis und wurde mit getrockneten "
	  "Erdbeeren verfeinert. Das Ganze ist in ein transparentes Papier "
	  "eingepackt." );


  SetProp(P_MATERIAL, ([MAT_PLANT:100]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 100);
  SetProp(P_NAME_ADJ, "rot");
  AddAdjective(({"rot", "rotes","rote"}));
  
  AddId("potrot");
  
  SetProp(P_POTPOURRI, ({
    "Eine betoerende Bluetenbrise umschmeichelt Deine Umgebung.\n",
    "Du entspannst Dich bei dem suessen Potpourri-Geruch.\n",
    "Zarte erdbeerige Parfumduefte beleben Deine Sinne.\n",
    "Feinster Rosengeruch durchstroemt diesen Platz.\n",
    "Du erschnupperst das kostbare Aroma von Hibiskusblueten.\n",
    "Du erriechst kraeftige Bluetengerueche mit einem Touch fruchtiger Erdbeere.\n",
    "Ein Hauch von Amaryllis steigt die Luft empor.\n",
    "Du atmest laechelnd verschiedene Rosenduefte ein.\n",
    "Ein sinnlicher Erdbeergeruch befluegelt deine Phantasie.\n",
    "Du fuehlst Dich durch die sanften Hibiskusaromen gestaerkt.\n" }));

  AddDetail( ({"mischung","bluetenmischung","bestandteile"}),
	     "Diese Mischung enthaelt verschiedene Blueten, aber auch Wurzeln "
	     "und Gewuerze.");
  
  AddDetail( ({"wurzeln"}),
	     "Die Wurzeln sehen schoen aus und geben hier den erdnahen Aspekt.");
  
  AddDetail( ({"aspekt"}),
	     "Alle Bestandteile sind natuerlich.");
  
  AddDetail( ({"gewuerze"}),
	     "Die Gewuerze verpassen dem Ganzen eine wunderbare feine Duftnote.");
  
  AddDetail( ({"duftnote","note","duft","duefte"}),
	     "Man kann durch diese Verpackung nichts riechen. Erst in der passenden "
	     "Schuessel kann das Potpourri seinen Duft entfalten.");

  AddDetail( ({"schuessel","kristallschuessel"}),
	     "Du bist Dir sicher, Du findest die geeignete Kristallschuessel in "
	     "einem bestimmten Laden");

  AddDetail( ({"laden"}),
	     "Erkundige Dich einmal. Das Potpourri stammt sicher auch von dort.");

  AddDetail( ({"blueten"}),
	     "Es sind viele unterschiedliche rote Blueten in der Verpackung, aber "
	     "Rosen, Hibiskusblueten und Amaryllis stechen besonders hervor.");

  AddDetail( ({"rosen","rose"}),
	     "Dicke, rote Rosenknospen in Dunkelrot gehalten, erfuellen den "
	     "Verpackungsinhalt mit seinem lieblich, aromatischen Duft.");

  AddDetail( ({"rosenknospen","knospen"}),
	     "Du erkennst eine schwaerze samtige Schattierung in dem Dunkelrot.");

  AddDetail( ({"dunkelrot","rot"}),
 	     "Das sieht einfach nur edel und elegant aus.");

  AddDetail( ({"verpackungsinhalt","inhalt"}),
	     "Der Inhalt enthaelt verschiedene Blueten, aber auch Wurzeln "
	     "und Gewuerze.");

  AddDetail( ({"hibiskus","hibiskusblueten"}),
	     "Die Blueten es Hibiskus haben feine, leicht geriffte Bluetenblaetter, "
	     "die sich kreisfoermig um einen gelblichen Stempel anordnen.");

  AddDetail( ({"bluetenblaetter","blaetter"}),
	     "Sie sind weit ausladend und feuerrot.");

  AddDetail( ({"stempel"}),
	     "Er thront mitten in der Bluete und ragt weit heraus.");

  AddDetail( ({"amaryllis"}),
	     "Du erkennst nur eine einzige Amaryllisbluete in dem Potpourri.");

  AddDetail( ({"amaryllisbluete"}),
	     "Sie wird leider von anderen Bestandteilen der Bluetenmischung "
	     "verdeckt, sodass du keine naeheren Details erkennen kannst.");

  AddDetail( ({"detail","details"}),
	     "Du bemerkst nur, dass die Amaryllis sehr sehr gross ist.");

  AddDetail( ({"erdbeeren"}),
	     "Die Erdbeeren bieten nicht nur optisch eine Auffrischung, sondern "
	     "auch vom Duft eine fruchtige Note.");

  AddDetail( ({"auffrischung"}),
	     "Ein Potpourri soll Dich ja einfach erfreuen.");

  AddDetail( ({"ganze","ganzen"}),
	     "Das Ganze besteht ja aus den Blueten, Wurzeln, Gewuerzen und den "
	     "getrockneten Erdbeeren.");

  AddDetail( ({"Papier"}),
	     "Die Verpackung besteht aus dem transparenten Papier, in welches das Potpourri "
	     "eingefuellt wurde.");

  AddDetail( ({"verpackung"}),
	     "Das transparente Papier knistert in Deinen Haenden und das Potpourri "
	     "raschelt darin.");

  AddDetail( ({"haenden","haende"}),
	     "Du haelst das Potpourri verpackt in Deinen Haenden.");

}

