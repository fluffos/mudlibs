    call_out("seq_13", 9, 3);
    break;
  case 3: write(BS("Du trittst naeher heran und erkennst, dass Lamuerte "
		   "lauter Faeden zieht und dreht und schwingt ...\n"));
    call_out("seq_13", 7, 4);
    break;
  case 4: write(BS("Weiter vorne erkennst Du ein Monster *PANIK* und es "
