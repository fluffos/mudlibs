// Objekt meines Gesellenstueckes "Wolkenstadt"

#include "../def.h"

inherit "std/thing";

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Seifenblase");
  SetProp(P_LONG, "Eine glitzernde regenbogenfarbene Seifenblase. Sie wirft "
	  "immer wieder Bilder auf, die aber wieder verschwinden. Die "
	  "Seifenblase scheint mehr zu beherbergen als man doch im "
	  "ersten Moment glaubt.");
  SetProp(P_INFO, "Du kannst in die Seifenblase blicken.");
  SetProp(P_NAME, "Seifenblase");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"seifenblase","blase"}) );
  
  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp (P_NOSELL, 1);
  
  
  AddCmd( ({"wirf","werfe","lege","leg"}), "exitus");
  AddCmd( ({"sehe","seh","sieh","blicke","blick"}), "cmd_look");
}

void reset() 
{
  if (!is_clone(TO)) return;
  ::reset();
}

int exitus(string str)
{
  if(!str) return 0;
  if(!(str=="seifenblase weg"||
       str=="blase weg"))
    return 0;
  write("Die Seifenblase zerplatzt.\n");
  say("Eine Seifenblase zerplatzt.\n");
  remove();
  return 1;
}

int cmd_look(string str)
{
  notify_fail("In was moechtest Du sehen?\n");
  if(!(str == "in blase"|| 
       str == "in seifenblase")) return 0;
  
  write(BS("Du starrst in die Seifenblase ... alles verschwimmt ... "
	   "verschiedene Farben glitzern auf und verschwinden ...\n"));
  say(TPN+" starrt in eine Seifenblase.\n");
  
  TP->SetProp(P_PARALYZED, 35);    
  if (find_call_out("auswahl") == -1)
    call_out("auswahl", 2, this_player());
  
  return 1;
}

void auswahl(object pl)
{
  switch(random(15)) {
  case 1: call_out("seq_1", 5, 1);
    break;
  case 2: call_out("seq_2", 5, 1);
    break;
  case 3: call_out("seq_3", 5, 1);
    break;
  case 4: call_out("seq_4", 5, 1);
    break;
  case 5: call_out("seq_5", 5, 1);
    break;
  case 6: call_out("seq_6", 5, 1);
    break;
  case 7: call_out("seq_7", 5, 1);
    break;
  case 8: call_out("seq_8", 5, 1);
    break;
  case 9: call_out("seq_9", 5, 1);
    break;
  case 0: call_out("seq_0", 5, 1);
    break;
  case 11: call_out("seq_11", 5, 1);
    break;
  case 12: call_out("seq_12", 5, 1);
    break;
  case 13: call_out("seq_13", 5, 1);
    break;
  case 14: call_out("seq_14", 5, 1);
    break;
  default: call_out("sequ_10", 5, 1);
    break;
  }
}

void seq_1(int abschnitt)
{
  if(!TP) return;
  
  switch(abschnitt){
    
  case 1: write(BS("Ploetzlich klaert sich die Seifenblase ... Du erkennst "
		   "Angrox, der bei Xarfai in der Nekromantengilde sitzt... "
		   "sie trinken gemeinsam Kaffee ...\n"));
    call_out("seq_1", 10, 2);
    break;
  case 2: write(BS("Sie trinken den Kaffee und sind in ein Gespraech "
		   "vertieft ...\n"));
    call_out("seq_1", 7, 3);
    break;
  case 3: write(BS("Auf einmal hopst Hiri als Nekrofellhaeschen durch den "
		   "Raum und zerstoert alles ...\n"));
    call_out("seq_1", 7, 4);
    break;
  case 4: write(BS("Sie blickt Dich mit ihren wilden roten Augen an und "
		   "hoppelt wild auf Dich zu ... Du bekommst Panik!!!\n"));
    call_out("seq_1", 7, 5);
    break;
  case 5: write(BS("Hiri beisst Dich in Deine Nase und ein Schmerz "
		   "durchfaehrt Dich ... Du reisst Dich von der Seifenblase "
		   "los.\n"));
    TP->SetProp(P_PARALYZED, 0);
    break;
  }
}

void seq_2(int abschnitt)
{
  if(!TP) return;
  
  switch(abschnitt){
    
  case 1: write(BS("Ploetzlich klaert sich die Seifenblase ... Du sitzt "
		   "gemuetlich auf einer Klippe und angelst ...\n"));
    call_out("seq_2", 7, 2);
    break;
  case 2: write(BS("Du bist entspannt und wartest auf einen Fisch, der "
		   "endlich anbeissen koennte ...\n"));
    call_out("seq_2", 7, 3);
    break;
  case 3: write(BS("Und Du wartest noch immer ... Dir ist so langweilig, dass "
		   "Du in der Nase zu bohren beginnst ...\n"));
    call_out("seq_2", 7, 4);
    break;
  case 4: write(BS("Aber jetzt beisst ein Fisch an ... er zerrt und zieht an "
		   "der Angel, doch er hat keine Chance ...\n"));
    call_out("seq_2", 7, 5);
    break;
  case 5: write(BS("Du fischt ihn gekonnt heraus ... Du bewunderst Deine "
		   "prachtvolle Beute, als ploetzlich eine riesige Welle auf "
		   "Dich zurast ...\n"));
    call_out("seq_2", 9, 6);
    break;
  case 6: write(BS("Cirion schwimmt aus der Welle empor ... sein Gesicht ist "
		   "vor Zorn zerfurchtet und grollt Dir, dass Du SEINEN Fisch "
		   "gefangen hast ... die Welle ueberschwappt Dich und Du "
		   "beginnst zu ersticken ...\n"));
    call_out("seq_2", 11, 7);
    break;
  case 7: write(BS(" Du zuckst und roechelst ... Du stirbst gleich ... Du "
		   "erstickst ... Du bist schon tot ... Du reisst Dich im "
		   "letzten Moment von der Seifenblase los.\n"));
    TP->SetProp(P_PARALYZED, 0);
    break;
  }
}

void seq_3(int abschnitt)
{
  if(!TP) return;
  
  switch(abschnitt){
    
  case 1: write(BS("Ploetzlich klaert sich die Seifenblase ... Du sitzt in "
		   "der Schule zwischen lauter Jungmagier ... \n"));
    call_out("seq_3", 7, 2);
    break;
  case 2: write(BS("Creative steht vorne am Pult und haelt einen Rohrstock "
		   "in der Hand ... Er duerfte gerade Arbeiten begutachten "
		   "...\n"));
    call_out("seq_3", 7, 3);
    break;
  case 3: write(BS("Er rauft sich die Haare und schreit in die Klasse: "
		   "HICKS, SO GEHT DAS NICHT! DAS IST KEINE ARBEIT, DAS IST "
		   "EIN WITZ!!!\n"));
    call_out("seq_3", 8, 4);
    break;
  case 4: write(BS("Er wirft ihr das Gildenstueck-Heft auf den Pult ... "
		   "Hicks schluchzt, faengt aber wieder an weiter an ihrem "
		   "Gildenstueck zu arbeiten ...\n"));
    call_out("seq_3", 10, 5);
    break;
  case 5: write(BS("Du wunderst Dich und wusstest nicht, dass Creative so "
		   "viel Arbeit mit Jungmagiern hat ... Du schuettelst den "
		   "Kopf und die Vision ist weg.\n"));
    TP->SetProp(P_PARALYZED, 0);
    break;
  }
}

void seq_4(int abschnitt)
{
  if(!TP) return;
  
  switch(abschnitt){
    
  case 1: write(BS("Ploetzlich klaert sich die Seifenblase ... Du sitzt in "
		   "einem riesigen Kochtopf mitten im Dschungel ...\n"));
    call_out("seq_4", 7, 2);
    break;
  case 2: write(BS("Dante huepft um Dich herum und singt: Heute back ich, "
		   "morgen brau ich ... Du schreist!!! ...\n"));
    call_out("seq_4", 7, 3);
    break;
  case 3: write(BS("Das Feuer unter Dir wird immer heisser und heisser ... "
		   "Dante lacht hysterisch und springt herum ...\n"));
    call_out("seq_4", 7, 4);
    break;
  case 4: write(BS("Er wirft ein paar Karotten hinein und ruehrt kurz um "
		   "... das Wasser im Kessel brodelt und es wird schon "
		   "unangenehm heiss ...\n"));
    call_out("seq_4", 8, 5);
    break;
  case 5: write(BS("Schoen langsam verspuehrst Du Verbrennungsschmerzen "
		   "... Du zappelst und schreist und schreist ...\n"));
    call_out("seq_4", 7, 6);
    break;
  case 6: write(BS("Niemand hoert Dich und Dante lacht noch hysterischer "
		   "... Du blinzelst und hast eine Gaensehaut.\n"));	    
    TP->SetProp(P_PARALYZED, 0);
    break;
  }
}

