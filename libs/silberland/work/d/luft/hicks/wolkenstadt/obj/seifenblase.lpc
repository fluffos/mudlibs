    break;
  case 3: write(BS("Du liegst schon am Boden und blickst in die Sonne ... "
		   "HUCH? ... Ist das nicht Prothegs Gesicht, das schelmisch "
		   "zu Dir herunter grinst?\n"));
    call_out("seq_8", 10, 4);
    break;
  case 4: write(BS("Ploetzlich sitzt Du mit Gwenshara bei Zechus ... Du hast "
		   "immer noch solchen Durst und deine Haut ist verbrannt "
		   "...\n"));
    call_out("seq_8", 7, 5);
    break;
  case 5: write(BS("Du hast keine Ahnung wie Du hergekommen bist, aber "
		   "schon stuerzt Du Dein erstes Bier herunter ...\n"));
    call_out("seq_8", 7, 6);
    break;
  case 6: write(BS("Du saufst gierig mit Gwenshara und Zechus um die Wette "
		   "... Du saufst und saufst und saufst ...\n"));
    call_out("seq_8", 7, 7);
    break;
  case 7: write(BS("Und saufst und saufst und saufst ... und ploetzlich "
		   "kippst Du weg und alles ist schwarz.\n"));
    TP->SetProp(P_PARALYZED, 0);
    break;
  }
}

void seq_9(int abschnitt)
{
  if(!TP) return;
  
  switch(abschnitt){
    
  case 1: write(BS("Ploetzlich klaert sich die Seifenblase ... alles ist "
		   "weiss ... der Schnee faellt ... Du erkennst einen "
		   "Gockelhahn, der auf Dich zukommt ...\n"));
    call_out("seq_9", 9, 2);
    break;
  case 2: write(BS("Er stolziert, bunt und praechtig, auf Dich zu ... "
		   "Seltsam ... nein, dass kann doch nicht wahr sein ...\n"));
    call_out("seq_9", 7, 3);
    break;
  case 3: write(BS("Der Gockel Rage ... freudig huepfst Du ihm entgegen "
		   "...\n"));
    call_out("seq_9", 6, 4);
    break;
  case 4: write(BS("Du bist mitten im Polargebiet und Rage taucht auf ... Er "
		   "schwaenzelt um Dich herum und versucht Dich zu bezirzen ... "
		   "Er kraeht: ALLE HENNEN ZU MIIIIIRRRRR!!! ...\n"));
    call_out("seq_9", 10, 5);
    break;
  case 5: write(BS("... AUCH DU!!! ... Du schreist: NEIN!!! *PANIK* ... und "
		   "schon ist die Seifenblase wieder eine Seifenblase. Du "
		   "atmest auf!!!\n"));
    TP->SetProp(P_PARALYZED, 0);
    break;
  }
}

void seq_0(int abschnitt)
{
  if(!TP) return;
  
  switch(abschnitt){
    
  case 1: write(BS("Ploetzlich klaert sich die Seifenblase ... Du "
		   "befindest Dich im Feenschloss und wanderst durch die "
		   "Gaenge ...\n"));
    call_out("seq_0", 9, 2);
    break;
  case 2: write(BS("Eine Fee kommt Dir entgegen ... NEIIIN! Es ist Ronja! "
		   "Ronja eine Fee? ... Du schuettelst den Kopf und grinst "
		   "schelmisch ...\n"));
    call_out("seq_0", 9, 3);
    break;
  case 3: write(BS("Du stuermst auf die Flatterfee zu und knuddelst "
		   "sie um ... Ronja quiekt auf und wird ganz boese ...\n"));
    call_out("seq_0", 8, 4);
    break;
    
  case 4: write(BS("Sie schimpft Dich und tritt Dich ... Lachend loest Du "
		   "Dich von der Seifenblase.\n"));
    TP->SetProp(P_PARALYZED, 0);
    break;
  }
}
void seq_11(int abschnitt)
{
  if(!TP) return;
  
  switch(abschnitt){
    
  case 1: write(BS("Ploetzlich klaert sich die Seifenblase ... Du erkennst "
		   "ein dunkles Hinterzimmer ... Woody sitzt vor einem Pult "
		   "...\n"));
    call_out("seq_11", 7, 2);
    break;
  case 2: write(BS("Du gehst auf ihn zu ... alles ist duester ... Du stehst "
		   "nun hinter Woody und beugst Dich ueber das Pult ...\n"));
    call_out("seq_11", 7, 3);
    break;
  case 3: write(BS("Plaene vom Gaffodorf ... Plaene vom Silberland ... Du "
		   "denkst Dir: Ahhh, hier werden die Plaene geschmiedet ... "
		   "Ploetzlich ruft Woody: LANDAR?!?\n"));
    call_out("seq_11", 10, 4);
    break;
  case 4: write(BS("Landar erscheint aus dem Laden ... dies scheint wohl ein "
		   "Hinterraum zu sein... sehr gefinkelt ... hier vermutet "
		   "niemand Gottes Werk ...\n"));
    call_out("seq_11", 9, 5);
    break;
  case 5: write(BS("Woody fragt: Mein Freund, was stellen wir heute wieder "
		   "auf den Kopf? ... und schon verschwimmt diese Vision.\n"));
    TP->SetProp(P_PARALYZED, 0);
    break;
  }
}

