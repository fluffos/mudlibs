void seq_6(int abschnitt)
{
  if(!TP) return;
  
  switch(abschnitt){
    
  case 1: write(BS("Ploetzlich klaert sich die Seifenblase ... Feyaria ist "
		   "in einem sexy Lederoutfit gekleidet ... Sie traegt einen "
		   "Bauchtanzrock, an der eine kleine Axt haengt, und einen "
		   "BH ...\n"));
    call_out("seq_6", 12, 2);
    break;
  case 2: write(BS("Sie beginnt zu einer betoerenden Musik zu tanzen ... Du "
		   "starrst sie, wie gebannt, an.\n"));
    call_out("seq_6", 7, 3);
    break;
  case 3: write(BS("Sie schwingt die Hueften und trippelt im Kreis ... die "
		   "Arme bewegen sich taktvoll zur Musik ...\n"));
    call_out("seq_6", 7, 4);
    break;
  case 4: write(BS("Sie blickt Dir tieeef in die Augen und Du bewegst Dich, "
		   "wie in Trance, zu ihr ...\n"));
    call_out("seq_6", 7, 5);
    break;
  case 5: write(BS("Du willst ihr auf den Po greifen, doch blitzschnell "
		   "zueckt sie ihre Axt und haelt sie Dir an die Kehle ...\n"));
