  }
}

void seq_13(int abschnitt)
{
  if(!TP) return;
  
  switch(abschnitt){
    
  case 1: write(BS("Ploetzlich klaert sich die Seifenblase ... Du bist "
		   "eindeutig in Lamuertes Brunnen ... Du fuerchtest Dich "
		   "...\n"));
    call_out("seq_13", 7, 2);
    break;
  case 2: write(BS("Da erkennst Du Lamuerte sogar ... er steht mit dem "
