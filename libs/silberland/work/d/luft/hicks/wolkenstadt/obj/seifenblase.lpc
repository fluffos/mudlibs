    break;
  case 3: write(BS("Ploetzlich schraubt der Vogel sich hoch und immer hoeher "
		   "in die Luft und fliegt einen Looping ...\n"));
    call_out("seq_7", 7, 4);
    break;
  case 4: write(BS("Dir rast das Herz und glaubst zu stuerzen, als Iwo Rok "
		   "galant Richtung Druidenzirkel lenkt ... \n"));
    call_out("seq_7", 7, 5);
    break;
  case 5: write(BS("Anvar winkt Iwo und Dir ... Du steigst mit weichen "
		   "Knien ab ... schon ist die Vision vorueber.\n"));
    TP->SetProp(P_PARALYZED, 0);
    break;
  }
}

void seq_8(int abschnitt)
{
  if(!TP) return;
  
