  case 6: write(BS("Du nimmst zornig einen Anlauf und willst Lamuerte "
		   "einen Tritt verpassen, aber schon verblasst diese "
		   "Vision.\n"));
    TP->SetProp(P_PARALYZED, 0);
    break;
  }
}

void seq_14(int abschnitt)
{
  if(!TP) return;
  
  switch(abschnitt){
    
  case 1: write(BS("Ploetzlich klaert sich die Seifenblase ... eine saftig "
		   "gruene Wiese mitten im Wald ... Du siehst Sargola, Eesthil "
		   "und den Schuechtling diskutieren ... \n"));
    call_out("seq_14", 10, 2);
    break;
  case 2: write(BS("Alle drei sitzen bei einem Picknick in der Wiese ... "
		   "Eesthil sagt: Nein, Schuechtling! Kaufe ihr einfach Blumen "
		   "und sprich sie an! ... der Schuechtling laechelt verlegen "
		   "...\n"));
    call_out("seq_14", 11, 3);
    break;
  case 3: write(BS("Sargola spricht dazwischen: Nein, Blumen sind doch bei "
		   "einem ersten Date falsch. Schreibe ihr ein Gedicht. Frauen "
		   "sind so romantisch ... \n"));
    call_out("seq_14", 9, 4);
    break;
  case 4: write(BS("Der Schuechtling gruebelt, waehrend Sargola und "
		   "Eesthil weiter streiten ... \n"));
    call_out("seq_14", 7, 5);
    break;
  case 5: write(BS("NEIN, ich werde ihr eine Blume und einen Brief "
		   "schicken!, meint der Schuechtling ... Du rufst ihm noch "
		   "was zu, als die Vision schon verschwindet.\n"));
    TP->SetProp(P_PARALYZED, 0);
    break;
  }
}
