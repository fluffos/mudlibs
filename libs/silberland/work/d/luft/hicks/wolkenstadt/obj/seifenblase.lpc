    break;
  case 6: write(BS("Du schluckst und Deine Augen quellen hervor ... Und "
		   "schon ist die Vision schon vorbei! ...  Was fuer ein "
		   "Prachtweib!!! *seufz*\n"));
    TP->SetProp(P_PARALYZED, 0);
    break;
  }
}

void seq_7(int abschnitt)
{
  if(!TP) return;
  
  switch(abschnitt){
    
  case 1: write(BS("Ploetzlich klaert sich die Seifenblase ... Du sitzt "
		   "hinter Iwo auf einem riesengrossen Vogel ... Es scheint der "
		   "Koenig der Luefte zu sein - Rok ...\n"));
