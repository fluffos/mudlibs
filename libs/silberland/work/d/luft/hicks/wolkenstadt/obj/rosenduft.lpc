// Objekt meines Gesellenstueckes "Wolkenstadt"

#include "../def.h"

inherit "std/thing";

string *irgendwas=({"%s duftet wunderbar nach Rosen.\n",
		"Der betoerende Rosenduft von %s zaubert Dir ein Laecheln ins Gesicht.\n",
		"Ein Hauch von Rosenbluetenduft haftet an %s.\n",
		"Du entspannst Dich bei dem Rosenbluetengeruch von %s.\n",
		"Du fuehlst Dich, durch den wohltuenden Geruch an Rosenblueten, zu %s hingezogen.\n",
		"Von %s entweichen verfuehrerische Rosenduefte.\n",
		"%s bereichert diese Umgebung mit einem blumig riechenden Rosenduft.\n",
		"Du geniesst die berauschende Rosenduftwolke von %s.\n",
		"Der Rosenduft von %s erschlaegt Dich fast.\n",
		"%s hat wohl zuviel in Rosenbluetenwasser gebadet.\n",
		"%s scheint wohl auf Aufriss unterwegs zu sein, bei diesem Rosenbluetenparfum.\n",
		"%s laechelt beim Einatmen des eigenen Rosenbluetendufts.\n"});

string *irgendwas1=({"Du duftest wunderbar nach Rosen.\n",
		"Dein betoerender Rosenduft zaubert Dir ein Laecheln ins Gesicht.\n",
		"Ein Hauch von Rosenbluetenduft haftet an Dir.\n",
		"Du entspannst Dich bei deinem eigenen Rosenbluetengeruch.\n",
		"Du fuehlst Dich, durch Deinen wohltuenden Geruch an Rosenblueten, zu Dir selbst hingezogen.\n",
		"Von Dir entweichen verfuehrerische Rosenduefte.\n",
		"Du bereicherst Deine Umgebung mit einem blumig riechenden Rosenduft.\n",
		"Du geniesst Deine eigene berauschende Rosenduftwolke.\n",
		"Dein eigener Rosenduft erschlaegt Dich fast.\n",
		"Du hast wohl zuviel in Rosenbluetenwasser gebadet.\n",
		"Du scheinst wohl auf Aufriss unterwegs zu sein, bei diesem Rosenbluetenparfum.\n",
		"Du laechelst beim Einatmen des eigenen Rosenbluetendufts.\n"});

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "Rosenduft" );
  SetProp(P_NAME, 0);
  SetProp(P_GENDER, MALE);
  AddId(({"\nrosenduft"}));
  
  SetProp(P_MATERIAL, ([MAT_PARFUM: 100]) );
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_INVIS, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1); 
  SetProp(P_SMELL, "Eindeutig - Rosen!!!");
  
  call_out("kill", 300);
  call_out("duft", 0);
}

string extra_look()     
{
  return BS(CAP(TP->QueryPronoun(WER))+" riecht suesslich nach Rosenblueten.");  
}

void kill()	
{
  if(MENV)
    if(interactive(MENV))
      {
	tell_object(MENV, "Der Rosenduft verfluechtigt sich.\n");
	
	tell_room(ENV(MENV), "Der Rosenduft von "+MENV->Name()+" verfluechtigt sich.\n", ({TP}));
      }
  
  remove();
}

void reset()
{
  ::reset();
  remove();
}

void duft ()
{

  if(MENV)
    if(interactive(MENV))
      {
        tell_object(MENV, irgendwas1[random(sizeof(irgendwas1))]);
	
	if(ENV(MENV))
	  tell_room(ENV(MENV), sprintf(irgendwas[random(sizeof(irgendwas))], MENV->Name()), ({MENV}));
      }
  
  call_out("duft",30);
}
