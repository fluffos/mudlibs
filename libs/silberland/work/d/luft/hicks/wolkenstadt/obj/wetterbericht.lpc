// Objekt meines Gesellenstueckes "Wolkenstadt"

#include "../def.h"

inherit "std/thing";

string wetter();
string bericht;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  bericht = wetter();
  
  SetProp(P_SHORT, "Ein Wetterbericht");
  SetProp(P_LONG,
	  "Du haelst den Zettel in der Hand. Er duerfte den aktuellen "
	  "Wetterbericht enthalten." );
  SetProp(P_NAME, "Wetterbericht");
  SetProp(P_GENDER, MALE);
  AddId(({"wetterbericht","bericht","zettel"}));
  
  SetProp(P_MATERIAL, ([MAT_PAPER: 100]) );
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);
  SetProp (P_NOSELL, 1);
  
  AddReadDetail( ({"wetterbericht","bericht","wetter"}), bericht);
} 
  string wetter()
    {
      string ret;
      string *staedte;
      
      staedte=({"Arrakeen","Arwenock","Burg Sturmfels","Derlim","Dhrkion",
		  "Elessar","Erg","Felonia","Fischerdorf","Kyranda",
		  "Liliandor","Midas","Polaris","Quaul","Smoersky",
		  "Tijara","Yaq'Monuq","Yiquanuc"});
      
      switch(random(10))
	{
	case 1:  ret="In "+staedte[random(sizeof(staedte))]+" wird ein "
		   "Wirbelsturm erwartet.";
	  break;
	case 2:  ret="Regenfeste Kleidung mitnehmen!!! Einige "
		   "Schauerwolken werden in "
		   +staedte[random(sizeof(staedte))]+" "
		   "vorrueber ziehen.";
	  break;
	case 3:  ret="Das Sonnenwetter wird in "+staedte[random(sizeof(staedte))]+" noch "
		   "nicht aufgebluehte Blumen zum spriessen "
		   "bringen.";
	  break;
	case 4:  ret="Eine Kaltwetterfront bringt morgen dichte "
		   "Schneeschauer nach "+staedte[random(sizeof(staedte))]+".";
	  break;
	case 5:  ret="Ein Tief kollidiert mit der momentanen "
		   "Hochfront und laesst morgen einige Stuerme "
		   "in "+staedte[random(sizeof(staedte))]+" aubrausen.";
	  break;
	case 6:  ret="Morgen ist Rekordhitze in "+staedte[random(sizeof(staedte))]+". "
		   "Also, packen Sie ihre Badeente und ihr "
		   "Badetuch ein und ab ins kuehle Nass.";
	  break;
	case 7:  ret="Es wird unbestaendiges Wetter mit sichtlicher "
		   "Abkuehlung in "+staedte[random(sizeof(staedte))]+" erwartet.";
	  break;
	case 8:  ret="Morgen erwartet sie feucht, schwueles Klima in "
		   +staedte[random(sizeof(staedte))]+". Wappnen Sie sich fuer "
		   "tropische Hitze.";
	  break;
	case 9:  ret="Graues, kaltes Wetter wird in "+staedte[random(sizeof(staedte))]+" "
		   "erwartet. Hin und wieder muessen Sie auch "
		   "mit kurzen Regenguessen rechnen.";
	  break;
	case 0: ret="In "+staedte[random(sizeof(staedte))]+" ist ein typischer "
		  "Faulenzertag zu erwarten. Hagelschlaege und "
		  "Gewitter zwingen jeden Herumtreiber einen Tag "
		  "Pause zu machen.";
	}
      
      return   "           W E T T E R B E R I C H T\n"
	"\n"
	"Ort              Wetter            Temperatur\n"
	"---------------------------------------------\n"
	"Arrakeen.........wolkenlos................+35\n"
	"Arwenock.........wolkenlos................+20\n"
	"Burg Sturmfels...wolkenlos................+19\n"
	"Derlim...........leicht bewoelkt..........+16\n"
	"Dhrkion..........dunkel/wolkenlos.........+25\n"
	"Elessar..........wolkenlos/blaettrig......+20\n"
	"Erg..............wolkenlos................+25\n"
	"Felonia..........dunkel/wolkenlos.........+18\n"
	"Fischerdorf......wolkenlos................+20\n"
	"Kyranda..........wolkenlos................+22\n"
	"Liliandor........wolkenlos................+20\n"
	"Midas............wolkenlos................+14\n"
	"Polaris..........nebelig/regnerisch.......+22\n"
	"Quaul............wolkenlos................+35\n"
	"Smoersky.........sonnig/leicht bewoelkt...-5 \n"
	"Tijara...........wolkenlos................+29\n"
	"Yaq'Monuq........dunkel/wolkenlos.........+10\n"
	"Yiquanuc.........wolkenlos................-10\n"
	"\n"
	"Morgige Wetterprognose:\n"+
	break_string(ret, 45)+
	"\n"
	"       Alle Angaben ohne Gewaehr.\n";
    }
