inherit "/p/service/iwo/access/ac_client.lpc";

#include <wizlevels.h>
#include <ansi.h>

int access_rights(string name, string file, int readflag, int def)
{
  name=lower_case(name);

  if(name=="gwenshara")
    return def;

  if(file==".project" || file==".plan")
    return def;

  if(!find_player("hiri"))
  write_file("d/luft/hiri/.access.log",ctime()+": "+capitalize(name)+"("+file+").\n");
  if(find_player("hiri"))
    tell_object(find_player("hiri"),
                "*** Player "+name+" looks at File: "
                ""+file+" ***\a\n");
  if(find_player("kyria"))
    tell_object(find_player("kyria"),
                ANSI_RED"*** Player "+name+" looks at File: "
                ""+file+" ***\a\n"ANSI_NORMAL);

  if (file=="access_rights.lpc" && name != "hiri")
    return 0;

  //Aussperren, nach folgendem Muster:
  if (name=="delgo"  || name == "aaliyah" || name == "purpur")
    // Ein paar leute sind ausgesperrt
    return 0;

  // return def;
  return ::access_rights(name,file,readflag,def);
}
