#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine feine Schale");
  SetProp(P_LONG,
    "Diese wundervoll filligrane Schale besteht aus feinstem Kristall. "
    "Sie schimmert wie ein Regenbogen und hat die Form einer Sylphe. "
    "Man kann sie bestimmt mit Eis fuellen." );
  SetProp(P_INFO, "Die feine Schale besteht aus feinstem Kristall.");
  SetProp(P_NAME, "Schale");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "schale", "HIRISCHALE"}) );

  SetProp(P_MATERIAL,  ([MAT_CRYSTAL : 100 ]) );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1);
  SetProp (P_NOSELL, 1);

