#include "../def.h"

#include <properties.h>
#include <language.h>
inherit "/std/thing";

int offen;

create()
{
	::create();
	SetProp(P_SHORT,"Eine Bulle Rum");
	offen=0;
	SetProp(P_LONG,
	"Eine @@aufzu@@ volle Flasche hochprozentigen Rum's.\n");
	AddId("rum");
	AddId("bulle");
	AddId("hochprozentiger");
	AddId("rumbulle");
	AddId("flasche");
	SetProp(P_NAME,"Bulle");
	SetProp(P_GENDER, FEMALE);
	SetProp(P_WEIGHT, 100);
	SetProp(P_VALUE, 1);
}

init()
{
	::init();
	add_action("oeffne","oeffne");
	add_action("schliesse","schliess",1);
	add_action("trinke","trink",1);
}

aufzu()
{
	if (offen)
		return "aufgeploppte";
	else
		return "geschlossen";
}

oeffne(str)
{
	if (!str || ( str!="bulle" && str!="rum" && str!="flasche" && str!="rumbulle")) 
		return 0;
        if (offen) {
                write("Die Bulle ist bereits offen!\n");
                return 1;
        }
        offen=1;
        write ("Du umschliesst den halb herausschauenden "
	       "Korken und entkorkst die Buddel.\n");
        say(this_player()->name() + " entkorkt eine Rumbulle.\n");
        return 1;
}
 
schliesse(str)
{
	if (!str || ( str!="bulle" && str!="rum" && str!="flasche" && str!="rumbulle")) 
		return 0;
        if (!offen) {
                write("Die Bulle ist doch zu!\n");
                return 1;
        }
        offen=0;
        write("Du klemmst den Korken wieder auf die Bulle.\n");
        say(this_player()->name() + " macht die Rumbulle wieder zu.\n");
        return 1;
}
 
trinke(str)
{
	if (!str || ( str!="bulle" && str!="rum" && str!="flasche" && str!="rumbulle")) 
		return 0;
        if (!offen) {
                write("Die Bulle ist aber zu!\n");
                return 1;
        }
	write("Du setzt die Bulle an den Mund und trinkst den Hochprozentigen Rum in einem\n"+
	"Zug aus. Die Bulle wird zu tausenden regenbogenfarbenen Seifenblasen und verschwindet.\n");
        say(this_player()->name() + " trinkt eine Bulle Rum.\n");
        TP->SetProp(P_ALCOHOL, 60);
	this_object()->remove();
       
	return 1;
}
