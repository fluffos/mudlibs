#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>




void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  
  
  SetProp(P_SHORT, "Ein Bild");
  SetProp(P_LONG,
    "Dieses Bild zeigt ein schoenes Motiv. Du hast es wirklich "
    "gut aus Deiner Erinnerung heraus gemalt." );
 
  SetProp(P_NAME, "Bild");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "bild", "\nHIRIBILD" }) );

  SetProp(P_MATERIAL, MAT_PEARL );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1);
  SetProp (P_NOSELL, 1);

AddDetail( ({"motiv"}),
  "Das Motiv, das Du gemalt hast, stellt eine Gestalt dar.");
AddDetail( ({"erinnerung"}),
  "Deine Erinnnerung hat Dich diese Gestalt malen lassen.");

  
AddDetail( ({"gestalt"}) ,
