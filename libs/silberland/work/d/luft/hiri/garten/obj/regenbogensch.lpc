//regenbogenschluessel...erstellt am 03.12.06 von Hiri

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein regenbogenfarbener Schluessel");
  SetProp(P_LONG,
    "Ein leichter regenbogenfarbener Schluessel. An was erinnert er Dich nur...!? "
    "Es fuehlt sich so an, als ob ein leichter Hauch Luft von ihm ausgeht....");

  SetProp(P_NAME, "Schluessel");
  AddId( ({"schluessel", "SCHATZ_REGENBOGENSCHLUESSEL"}) );

  SetProp(P_NAME_ADJ, ({"leicht"}) );
  AddAdjective( ({"leichten","leichter","leichtem","leichtes","leichten"}) );

  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 30);
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, ([MAT_AIR:100]) );

  AddDetail( ({"regenbogenfarben", "farben", "regenbogen"}) ,
    "Die Farben des regenbogenen Schluessels leuchten "
    "wundervoll und Du spuerst einen leichten Hauch von "
    "Luft wenn Du ihn beruehrst.");

  AddDetail( ({"luft"}) ,
    "Den Hauch von Luft spuerst Du nur sehr gering, der Schluessel ist "
    "aber auch leicht wie Luft.");

  AddDetail( ({"hauch"}) ,
    "Meist spuert man einen Hauch nur sehr kurz, vielleicht solltest Du "
    "einmal versuchen ihn wirklich zu fuehlen?.");



AddCmd(  ({ "fuehl", "fuehle", "fuehlen" }), "fuehlen"  );

}



int fuehlen(string str)
{
   notify_fail("Was moechtest Du denn fuehlen?\n");

 if(!str || str == "") return 0;
 if(!(str=="hauch"||
      str=="luft"))       
       return 0;

 write(BS("Du moechtest diesen Hauch erfuehlen, wuenschst es Dir so sehr. Ploetzlich "
	  "werden Deine Haende etwas kuehler, um Deine Haende wirbeln lauter kleine "
	  "regenbogenfarbene Woelkchen. Du fuehlst den leisen Hauch der Luft und "
	  "Dein Herz beginnt vor Freude wild zu schlagen.\n"));

 say(TPN+" scheint kleine Wolken zum tanzen zu bringen.\n");
    if ( find_call_out("fall1") == -1 )
      call_out("fall1",10);
    return 1;
  
}
void fall1()
{
//  if (!objectp(TP)) return;
//  if (ENV(TP)!=TO ) return;
  write(BS( "Du nimmst Deine Arme weit hoch und schaust Dir das wunderschoene "
         "farbliche Schauspiel an. Ein Gefuehl des Gluecks ueberkommt Dich.\n"));
  if ( find_call_out("fall2") == -1 )   
    call_out("fall2",10);
}
void fall2()
{
//  if (!objectp(TP)) return;
//  if (ENV(TP)!=TO ) return;
  write (("Langsam verfluechtigen sich die kleinen Woelkchen und fuer einen "
	  "winzigen Moment hast Du von Hand zu Hand einen kleinen Regenbogen, "
	  "eine winzige Sonne ueber ihnen und es regnet. Die Magie "
	  "verfluechtigt sich und Du kannst Dich nur noch an dieses schoene "
	  "Erlebnis erinnern.\n"
	  ) );
  
say(TPN+" schaut fasziniert auf die Haende, Du wunderst Dich "
	 "weil Du nichts sehen kannst.\n");



}
