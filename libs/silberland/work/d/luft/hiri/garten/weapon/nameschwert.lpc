//create from Hiri at 13.july 2006 todo....eintrag fuer unt....abfrage auf tiernamen.....
inherit "std/weapon";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <ansi.h>
#include <new_skills.h>

nosave int aenderungen=3;

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Wolkenschwert");
  SetProp(P_LONG,
    "Die Klinge dieses Schwertes besteht aus Luft und Wasser. "
    "Innerhalb des Wassers ist ein harter Kern aus Eis. "
    "Dieses scheint niemals zu schmelzen. Der Griff des Schwertes "
    "besteht aus purem Diamant. In ihm gefangen sind die Farben des "
    "Regenbogen.");
  SetProp(P_NAME, "Wolkenschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"wolkenschwert", "schwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC,200);
  SetProp(P_WC_FIX, 40);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":50, "Schwertexperte":150, "Schwertmeister":250]));
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_AIR: 35, MAT_WATER:35, MAT_ICE:20 ,MAT_DIAMOND:10]) );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 1200);
  SetProp(P_SIZE, 85+random(10));
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:11]) ); 
  SetProp(P_HIT_FUNC, this_object());
  AddDetail( ({"obsidian"}),
    "Der Obsidian glitzert schwarz.");
  AddDetail( ({"holz","holzgriff"}),
  "Der Holzgriff ist aus einem sehr harten Holz gefertig. Vermutlich aus einem "
  "sehr alten Baum aus dem Silberwald.");
  AddDetail( ({"steinsplitter","splitter"}),
  "Die Klinge war einmal ein Steinsplitter. Pures Obsidian, wie du erkennen kannst. ");

  AddCmd(({"tauf","taufe"}), "taufen");  
}

int HitFunc(object enemy)
  
  {
 
    switch(random(20))
    {    
      case 1 .. 5 :
      SetProp(P_DAM_TYPE, ({DT_SLASH, DT_COLD})); break;
      case 6 .. 10 :
      SetProp(P_DAM_TYPE, ({DT_SLASH, DT_WATER})); break;
      case 11 .. 15 :
      SetProp(P_DAM_TYPE, ({DT_SLASH, DT_MIND})); break;
      case 16 .. 20 :
      SetProp(P_DAM_TYPE, ({DT_SLASH, DT_AIR})); break;
      
    {	
      if(!random(10))
           break;
// default: break;
       default : SetProp(P_DAM_TYPE, ({DT_SLASH})); break;
                 enemy->SetProp(P_DISABLE_ATTACK, 10);
    }          


    
    }}

nosave int taufen(string str) 
{
  string neuername, id;
  
  notify_fail(BS("Du kannst den Namen des Wolkenschwertes nur maximal 3 mal "
		 "aendern!"));
  if(!aenderungen) return 0;
  
  notify_fail("Wen oder was willst Du wie taufen?\n");
  if(sscanf(str, "%s auf %s", id, neuername)!=2) return 0;
  
  notify_fail("Du kannst nur das Wolkenschwert taufen!\n");
  if(id!="schwert") return 0;
  
  notify_fail("Der Name Deines Schwertes darf nur ein Wort lang sein!\n");
  if(sizeof(explode(neuername," ")) != 1) return 0;
  
  notify_fail("Bitte suche Dir einen anderen Namen!\n");
  if(strstr(neuername, "scheiss")!=-1) return 0;
  if(strstr(neuername, "arsch")!=-1) return 0;
  if( "/secure/master"->QueryBanished(neuername) )
     return 0;
  
  if("/secure/master"->get_userinfo(neuername)) 
	  return 0;
  
 
  write(BS("Du fuehrst Dein Schwert zu Deinem Mund und beruehrst es mit Deinen "
	   "Lippen. Danach gibst Du Deinem Schwert feierlich den Namen: " 
	   "" +ANSI_BOLD+ANSI_YELLOW+CAP(neuername)+ANSI_NORMAL+"."));

  tell_room(ENV(TP),
		  BS(TPN+ " gibt " +TP->QueryPossPronoun(NEUTER, WEM, 0)+
   " Schwert feierlich den Namen: " +ANSI_BOLD+ANSI_YELLOW+CAP(neuername)+ANSI_NORMAL+"."));

({TP}),
SetProp(P_SHORT, "Ein Wolkenschwert namens: " +ANSI_BOLD+ANSI_YELLOW+CAP(neuername)+ANSI_NORMAL+"");
  


  aenderungen--;
  
  return 1;
}

