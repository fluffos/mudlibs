#include <properties.h>
#include <ansi.h>
#include "../def.h"
#include <moving.h>

inherit ROOM "std_air";




void create() {
  string str;
  
  ::create();


//Licht und Temperatur wird in std_air gestetzt
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN: TT_PLAIN]) );

  
//Tageszeitenabhaengige Short
  SetProp( P_TD_SHORT, ({ "Morgens auf einem Marmorsteinweg.",
                          "Auf einem Marmorsteinweg.",
                          "Auf einem Marmorsteinweg.",
                          "Nachts auf einem Marmorsteinweg."}) );
  
  //Dieser String ist allen Beschreibungen gemeinsam, also zwischenspeichern
  //statt jedes mal zu schreiben
  str = "Du gehst weiter auf den feinen Marmorsteinchen und bewunderst "
    "die saeuberlich angelegten Blumenrabatten links und rechts von "
    "dem Weg. Die Rabatten haben die Form eines Edelsteines. Die "
    "Farben der Blumen sind so angeordnet das es aussieht als ob "
    "die Edelsteine die Farben eines Regenbogen in sich bergen." ;

//Tageszeitenabhaengige Long
  SetProp( P_TD_LONG, ({
    str + "Du hoerst Huehner gackern und ein Hahn kraeht. Es ist jetzt "
          "schon waermer als in der Nacht.",
    str + "Die Sonne lacht Dich an.",
    str + "Die Sonne geht bald unter.",
    str + "Du hoerst ein Kaeuzchen seinen Ruf erschallen lassen. Da "
          "es Nacht ist, ist die Temperatur etwas gesunken."}));

//Bei RoomChats bitte wenn moeglich nur Einzeiler, NERVFAKTOR!!!11eins
//Tageszeitenabhaengige RoomChats
  SetProp(P_TD_ROOM_MSG, ({
    ({"Ein Hahn begruesst lautstark den Morgen.\n",
      "Der Hahn kraeht aus vollem Hals und Huehner beginnen zu gackern.\n",
      "Voegel zwitschern froehlich in den Baeumen.\n",
      "Irgendwo piepst eine Maus.\n" }),
    ({"Du hoerst verschiedene Voegel zwitschern, Bienen und Hummeln\n"
      "herumschwirren und summen.\n",
      "Grashuepfer zirpen laut.\n",
      "Eine Libelle fliegt rasant vorbei.\n" }),
    ({"Die Sonne geht unter.\n",
      "Der Himmel faerbt sich rot.\n"}),
    ({"Ein kleines Kaeuzchen beginnt leise zu piepen.\n",
      "In der Ferne schreit ein Kaeuzchen.\n",
      "Eine Zikade ratscht laut in einem Baum.\n" }) }));


  
//Tageszeitenabhaengiges Detail
  NightnDayDetail("himmel",
    ({"Der Himmel faerbt sich langsam rot, bald geht die Sonne auf.\n",
      "Vom Himmel lacht die Sonne.\n",
      "Die Sonne beginnt langsam alles angenehm warm werden zu lassen. \n",
      "Langsam wird es dunkel, ein paar einzelne Sterne funkeln schon.\n",
      "Der tiefschwarze Himmel ist uebersaet mit funkelnden Sternen.\n",
      "Die Sterne leuchten und strahlen. Du fuehlst dich sehr wohl hier. \n",
      }));
  
 NightnDayDetail("temperatur",
    ({"Die Temperatur steigt, es wird bald Tag.\n",
      "Es ist angenehm warm.\n",
      "Langsam wird es dunkel, die Temperatur sinkt leicht.\n",
      "Es ist Nacht und die Temperatur ist kuehler geworden.\n",
      }));

 NightnDayDetail("hummel","hummeln","bienen",
     ({"Die ersten Hummeln und Bienen beginnen Nektar zu suchen.\n",
       "Du siehst und hoerst viele Hummeln und Bienen.\n",
       "Langsam fliegen die Hummeln und Bienen davon.\n",
       "Du hoerst und siehst keine Hummeln oder Bienen mehr.\n",
      }));

 NightnDayDetail("voegel",
     ({"Viele Voegel beginnen ihr morgendliches Lied.\n",
       "Ab und zu siehst du Voegel vorbei fliegen.\n",
       "Immer leiser werden die Voegel.\n",
       "Nur ein Kaeuzchen hoert man in der Nacht.\n",
      }));

 NightnDayDetail("libelle","libellen","luft","platz",
      ({"Eine Libelle startet von einer Rosenbluete.\n",
        "Libellen segeln rasant durch die Luft.\n"
	"Eine Libelle kommt angesaust. Kurz vor dir bremst sie \n"
	"und fliegt wieder davon.\n"
	"Alle Libellen haben sich ein Platz zum schlafen gesucht.\n"
       }));


 



 
  
  
//  AddSound( DEFAULT_SOUND, "");

  AddSound(({"blaetter"}), "Die Blaetter fluestern leise im Wind.\n");

//Tageszeitenabhaengiges Geraeusch
  NightnDaySound(DEFAULT_SOUND,
    ({"In der Ferne kraeht ein Hahn.\n",
      "Die Blaetter des Weltenbaumes rascheln leise im Wind.\n",
      "Zirpende Grillen stimmen ihr Nachtlied an.\n",
      "Du hoerst ein Kaeuzchen schreien.\n"}));
  AddSound(({"kaeuzchen","ferne","ruf"}),
      "Du hoerst das Kaeuzchen in der Ferne rufen.\n");
  AddSound(({"zikade","baum"}),
      "In einem Baum ratscht eine Zikade.");


  
  
//  AddSmell(DEFAULT_SMELL, "Die Rosen, die sich um das Spalier gewunden "
//                          "haben duften herrlich.");

//  AddSmell(({"rosen", "rose"}), "Du riechst an einer der Rosen, ein\n "
//                                "betoerender Duft steigt in Deine Nase.\n");
//Tageszeitenabhaengiger Geruch
  NightnDaySmell(DEFAULT_SMELL,
    ({"Du glaubst frischen Tau zu riechen.\n",
      "Die Rosen duften betoerend.\n",
      "Die Rosen duften betoerend.\n",
      "Du vernimmst einen leisen Hauch von Rosenduft.\n"}));



  SetProp( P_INT_SHORT, "Auf einem Marmorsteinweg." );
 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "blumenrabatte", "blumenrabatten", "rabatten" }), 
                break_string( "Die Blumenrabatten sind auf beiden Seiten des "+
                "Weges. Viele Blumen sind dort farbig gemischt. Sie ergeben "+
                "zusammen die Farben eines Regenbogen. ", 78 ) );
  AddDetail( ({ "sonne" }), 
                break_string( "Am Morgen geht die Sonne rotorange auf und am "+
                "Abend sinkt sie genauso wieder. ", 78 ) );
  AddDetail( ({ "luft" }), 
                break_string( "Die Libellen fliegen rasant und gekonnt durch "+
                "die Luft.", 78 ) );
  AddDetail( ({ "flugkunst", "kunst" }), 
                break_string( "Flugkunst kann es wohl nennen, wenn die "+
                "Libellen durch die Luft saussen.", 78 ) );
  AddDetail( ({ "libelle", "libellen" }), 
                break_string( "Eine Libelle fliegt rasant durch die Luft und "+
                "faengt sich eine Muecke. Du bist begeistert ueber ihre "+
                "Flugkunst.", 78 ) );
  AddDetail( ({ "dank", "danke" }), 
                break_string( "Ein Dank und Danke an Uck, der sich in einer "+
                "Suchmaschine verlaufen zu haben schien und an Dejot und "+
                "Justavius.", 78 ) );
  AddDetail( ({ "biene", "bienen", "bienenschwarm" }), 
                break_string( "Die Blumenrabatte ziehen einen Bienenschwarm "+
                "an. Kein Wunder, bei dieser Pracht an Blumen und deren "+
                "Blueten. Wo die Bienen ihren Honig wohl verstecken?", 78 ) );
  AddDetail( ({ "weg", "weges" }), 
                break_string( "Der fein saeuberlich angelegte Weg, ist mit "+
                "feinen Marmorsteinchen gefuellt. Es waechst kein Unkraut "+
                "zwischen den Marmorsteinchen. Muss ein ordentlicher Gaertner "+
                "sein.", 78 ) );
  AddDetail( ({ "marmorsteinchen", "steinchen", "marmor" }), 
                break_string( "Du gehst bedaechtig ueber die "+
                "Marmorsteinchen. Es knircht leise aber angenehm. Auf beiden "+
                "Seiten des Weges siehst du schoene Blumenrabatte.", 78 ) );
  AddDetail( ({"marmorsteinen","steinchen","mh"}),   
               "Die Marmorsteinchen fuehlen sich eigentlich nicht an wie "
               "Steinchen. Irgendwie eher, MH..flauschig. Aber wenn man "
               "auf ihnen geht, sind sie wie echte Steinchen. Komisch!?! ");
  AddDetail( ({"blumenrabatten","blumen","rabatten"}),
               "Die Blumenrabatten haben die Form eines Edelsteines. "
               "Wie ein Regenbogen, sind die Farben der Blumen angelegt. "
               "Einfach wunderschoen. Links und rechts von dem Weg sind "
               "die Rabatten angelegt worden.");
  AddDetail( ({"form"}),
               "Die Form der Blumenrabatten sieht aus wie ein Edelstein. ");
  AddDetail( ({"edelstein","edelsteines"}),
               "Wie ein Edelstein sind die Rabatten angelegt und haben "
               "bunte Farben wie ein Regenbogen. ");
  AddDetail( ({"regenbogen"}),
               "Die Farben der Blumen sind bunt wie bei einem Regenbogen.");
  AddDetail( ({"farben"}),
               "Die Farben des Regenbogen sind rot,gelb,gruen,blau,orange, "
               "violett. Diese Information bekam ich auf der Ebene Allgemein. "
               "Beschwerden koennt ihr also an Justavius und Dejot leiten. "
               "Wer noch genaueres ueber die Farben wissen moechte, kann "
               "mit lies text die Unterhaltung lesen. Ein freundliches Danke "
               "an die beiden und auch an Uck, der sich wohl leider in einer "
               "Suchmaschine verlaufen hat.");
  AddDetail( ({"justavius","dejot","uck","information","unterhaltung",
	       "allgemein","suchmaschine","ebene" }),
               "All das koennt ihr mit ,lies text, lesen oder auch nicht.");
  AddDetail( ({"boden"}),
               "Auf dem Weg liegen feine Marmorsteinchen. Der Boden links und "
               "rechts ist mit Blumenrabatten geschmueckt.");
  AddDetail( ({"himmel"}),
               "Am Himmel funkeln in der Nacht helle Sterne. Wunderschoen sieht "
               "es aus. Am Tag scheint die Sonne und waemrt alles auf.");
  AddDetail( ({"morgen","abend"}),
	       "Am Morgen beginnen die Insekten und Vögel zu singen. Am Abend "
	       "beginnen die Vögel und Zikaden sich zu regen.");
  AddDetail( ({"insekten","v"}),
	       "Insekten gibt es in der Nacht und am Tag. Schau dich mal um.");
  AddDetail( ({"seiten"}),
               "Die Seiten von dem Weg sind mit Blumenrabatten verziert.");
  AddDetail( ({"nacht"}),
               "In der Nacht ist der Himmel übersaeht mit leuchtenden Sternen.");
  AddDetail( ({"sterne", "sternen"}),
               "Die Sterne funkeln wunderschoen am Himmel und du fuehlst dich ",
               "trotz der Dunkelheit, sehr sehr wohl.");
  AddDetail( ({"temperatur", "tag"}),
               "Am Tag ist die Temperatur waermer als in der Nacht. ");
  AddDetail( ({"dunkelheit"}),
               "In der Dunkelheit kannst du dich hier wahrscheinlich "
               "sogar wohlfuehlen. Doch kann man ja nie genau wissen, "
               "was noch alles auf einen zukommt. ");
  AddDetail( ({"gaertner","unkraut","chance","garten","ordnung"}),
               "Er haelt den Garten in Ordnung und laesst Unkraut keine "
               "Chance.");


  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Die Blumen der Rabatten links und rechts duften herrlich.");

  AddSmell( ({ "blumen" }),
    "Viele wunderschoene Blumen stehen links und rechts in den "
    "Rabatten und duften so herrlich.");




//AddItem(NPC "tarabas", REFRESH_DESTRUCT);


AddExit( "sueden", ROOM "pg1" );
AddExit( "norden", ROOM "pg3" );
AddExit( "nordosten", ROOM "eis" );
AddExit( "nordwesten", ROOM "schoki" );


// AddReadDetail( ({"text"}),
//  "\n ");
//Tageszeit setzen (wichtig am ENDE!)
  setTimeOfDay();
}
 
