#include <defines.h>
#include <properties.h>

#include "../def.h"
#include <moving.h>
inherit "std/room";



void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Unter einem Rosenspalier." );
  SetProp( P_INT_LONG,
    "Du bist durch den wunderschoenen Rosenspalier gegangen und "
    "betrittst den Palastgarten. Du wunderst Dich wie weich der "
    "Boden hier ist. Ausserdem bist erstaunt welche Pracht Du "
    "hier erblickst. Du schaust Dich mit offenem Mund um, betoert "
    "durch den Duft der vielen Blumen und Kraeuter, Blueten der "
    "der Obstbaeume. ");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Die Rosen, die sich um das Spalier gewunden haben duften herrlich.");

  AddSmell( ({ "rosen" }),
    "Du riechst an einer der Rosen, ein betoerender Duft steigt "
    "in Deine Nase.");




//AddItem(NPC "tarabas", REFRESH_DESTRUCT);



AddExit( "osten", ROOM "pg14.lpc" );
AddExit( "suedosten", ROOM "pg10.lpc");
AddExit( "nordosten", ROOM "pg18.lpc");
}
