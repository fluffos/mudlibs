#include <properties.h>
#include <ansi.h>
#include "../def.h"
#include <moving.h>

inherit ROOM "std_air";


void create() {
  string str;
  
  ::create();

  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN: TT_PLAIN]) );

  //Licht und Temperatur wird in std_air gestetzt
  
//Tageszeitenabhaengige Short
  SetProp( P_TD_SHORT, ({ "Am Weltenbaum im Morgengrauen.",
                          "Auf der kleinen Lichtung des Weltenbaums.",
                          "Abends am Weltenbaum.",
                          "In stockfinsterer Nacht am Weltenbaum."}) );
  
  //Dieser String ist allen Beschreibungen gemeinsam, also zwischenspeichern
  //statt jedes mal zu schreiben
  str = "Langsam gehst Du auf die kleine Lichtung und siehst einen "
        "gigantischen Baum. Du gehst noch ein Stueck naeher an den "
        "Baumriesen heran und bemerkst das um ihn herum ein schmaler "
        "Weg, der an eine Wendeltreppe erinnert, an dem Baumstamm nach "
	"oben fuehrt. ";

//Tageszeitenabhaengige Long
  SetProp( P_TD_LONG, ({
    str + "Du hoerst Huehner gackern und ein Hahn kraeht. Es ist jetzt "
          "schon waermer als in der Nacht.",
    str + "Die Sonne lacht Dich an.",
    str + "Die Sonne geht bald unter.",
    str + "Du hoerst ein Kaeuzchen seinen Ruf erschallen lassen. Da "
          "es Nacht ist, ist die Temperatur etwas gesunken."}));

//Bei RoomChats bitte wenn moeglich nur Einzeiler, NERVFAKTOR!!!11eins
//Tageszeitenabhaengige RoomChats
  SetProp(P_TD_ROOM_MSG, ({
    ({"Ein Hahn begruesst lautstark den Morgen.\n",
      "Der Hahn kraeht aus vollem Hals und Huehner beginnen zu gackern.\n",
      "Voegel zwitschern froehlich in den Baeumen.\n",
      "...\n" }),
    ({"Du hoerst verschiedene Voegel zwitschern, Bienen und Hummeln\n "
      "herumschwirren und summen.\n",
      "Grashuepfer zirpen laut.\n",
      "...\n" }),
    ({"Die Sonne geht unter.\n",
      "Der Himmel faerbt sich rot.\n"}),
    ({"Ein kleines Kaeuzchen beginnt leise zu piepen.\n",
      "In der Ferne schreit ein Kaeuzchen.\n",
      "...\n" }) }));

  AddDetail("weg", "Ein einfacher Weg.");
  
//Tageszeitenabhaengiges Detail
  NightnDayDetail("himmel",
    ({"Der Himmel faerbt sich langsam rot, bald geht die Sonne auf.\n",
      "Vom Himmel lacht die Sonne.\n",
      "Langsam wird es dunkel, ein paar einzelne Sterne funkeln schon.\n",
      "Der tiefschwarze Himmel ist uebersaet mit funkelnden Sternen.\n"}));
  
//  AddSound( DEFAULT_SOUND, "");

  AddSound(({"blaetter"}), "Die Blaetter fluestern leise im Wind\n.");

//Tageszeitenabhaengiges Geraeusch
  NightnDaySound(DEFAULT_SOUND,
    ({"In der Ferne kraeht ein Hahn.\n",
      "Die Blaetter des Weltenbaumes rascheln leise im Wind.\n",
      "Zirpende Grillen stimmen ihr Nachtlied an.\n",
      "Du hoerst ein Kaeuzchen schreien.\n"}));
  
//  AddSmell(DEFAULT_SMELL, "Die Rosen, die sich um das Spalier gewunden "
//                          "haben duften herrlich.");

  AddSmell(({"rosen", "rose"}), "Du riechst an einer der Rosen, ein\n "
                                "betoerender Duft steigt in Deine Nase.\n");
//Tageszeitenabhaengiger Geruch
  NightnDaySmell(DEFAULT_SMELL,
    ({"Du glaubst frischen Tau zu riechen.\n",
      "Die Rosen duften betoerend.\n",
      "Die Rosen duften betoerend.\n",
      "Du vernimmst einen leisen Hauch von Rosenduft.\n"}));

//  AddItem(NPC "tarabas", REFRESH_DESTRUCT);


  AddExit( "sueden",  ROOM "gewaechshaus" );
  AddExit( "oben", ROOM "baum1.lpc" );
  //AddExit( "westen", ROOM "pg16.lpc");
  //AddExit( "osten", ROOM "pg17.lpc");
  //AddExit( "suedwesten", ROOM "schoki");
  //AddExit( "suedosten", ROOM "eis");

  AddCmd(  ({ "dreh", "drehe", "drehen" }), "drehen"  );

  //Tageszeit setzen (wichtig am ENDE!)
  setTimeOfDay();
}


int drehen(string str)
{
  notify_fail("An was moechtest Du drehen?\n");

  if(!str || str == "" ||
    !(str=="an leier"|| str=="an der leier"|| str=="an drehleier"))
    return 0;

 write(BS("Du beginnst an der alten Leier zu drehen und die Statue beginnt sich langsam "
      "im Kreise zu drehen wie eine alte Spieluhr. Der kleine Wolkenvampir schaut Dich "
      "froehlich an und nimmt seine Wolkengeige und legt sie auf seine linke Schulter. "
      "Klemmt sie mit seinem Kinn fest und beginnt mit seiner rechten Hand die "
      "Wolkengeige zu spielen.\n"));

 say(TPN+" dreht die Leier wild herum.\n");
    if ( find_call_out("fall1") == -1 )
      call_out("fall1",10);
    return 1;
  
}
void fall1()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write(BS( "Du drehst die Leier immer schneller, weil Du hoffst eine "
         "Melodie zu hoeren. Dann schaust Du den kleinen Wolkenvampir "
         "an und tatsaechlich, hoerst Du ploetzlich eine Melodie und "
         "von der Wolkengeige siehst Du Noten durch die Luft, wie kleine "
         "Woelkchen davon schweben." ));
  if ( find_call_out("fall2") == -1 )   
    call_out("fall2",10);
}
void fall2()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write (("Du hoerst: Hicks Drunking-Synphonie Komponist: Gilbard\n"
"____|)________________________________________________________\n"
"|___/____________________________|___________________________||\n"
"|__/|_______/|____/|_____/|______|___________________________||\n"
"|_/(|,\_____/_|___/_|____/_|______|___________________________||\n"
"|__\_|_/___|__|__|__|___|__|___|__|___________________________||\n"
"|   |     | ()  | ()   | ()   |  |                           ||\n"
"| (_|   -()-  -()-   -()-   -()- | -()-  -()-  -()-   -()-   ||\n"
"|________________________________|__|__()_|__()_|__()__|_____||\n"
"|__/___\\_._______________________|__|__|__|__|__|__|___|_____||\n"
"|__\\___|_._______________________|___\\_|___\\_|___\\_|___|_____||\n"
"|_____/__________________________|____\\|____\\|____\\|_________||\n"
"|____/___________________________|___________________________||\n"
" Die Noten schweben als kleine Woelkchen von der Wolkengeige an \n"
" Dir vorbei, danach hoerst Du erschoepft auf an der Leier zu \n"
" drehen und die Statue des kleinen Wolkenvampirs bleibt stehen. \n"
      ) );
}

