#include <defines.h>
#include <properties.h>
#include <ansi.h>
#include "../def.h"
#include <moving.h>
inherit "std/room";




void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Bei einem kleinen Statuenbrunnen." );
  SetProp( P_INT_LONG,
    "Du stehst direkt vor einem kleinen runden Brunnen in "
    "dessen Mitte eine kleine Statue steht. Um die Statue "
    "herum ist natuerlich Fluessigkeit, sonst waere es ja "
    "kein Brunnen. In diesem Teil des Gartens sind die "
    "Hecken und Baeumchen alle wie kleine Noten geschnitten.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );


  AddDetail( ({"boden"}),
        "In dem Boden ist eine Luke.");
  AddDetail( ({"luke"}),
        "Du koenntest die Luke oeffnen.");
  AddDetail( ({"statue"}),
        "Die Statue blabla");
  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Die Rosen, die sich um das Spalier gewunden haben duften herrlich.");

  AddSmell( ({ "rosen" }),
    "Du riechst an einer der Rosen, ein betoerender Duft steigt "
    "in Deine Nase.");




//AddItem(NPC "tarabas", REFRESH_DESTRUCT);


/*AddExit( "sueden",  ROOM "pg3.lpc" );
AddExit( "norden", ROOM "pg5.lpc" );
AddExit( "westen", ROOM "pg16.lpc");
AddExit( "osten", ROOM "pg17.lpc");
AddExit( "suedwesten", ROOM "schoki");
AddExit( "suedosten", ROOM "eis");*/



AddCmd(  ({ "oeffne" }), "oeffnen"  );
}




int oeffnen(string str)
{
   notify_fail("Was moechtest Du oeffnen?\n");

 if(!str || str == "") return 0;
 if(!(str=="luke"||
       str=="die luke"))       
       return 0;

 write(BS("Du zerrst an der Luke um sie zu oeffnen, sie laesst "
	  "sich schwer anheben aber Du schaffst es.\n"));

 say(TPN+" Versucht die Luke am Boden zu oeffnen.\n");
    if ( find_call_out("fall1") == -1 )
      call_out("fall1",10);
    return 1;
  
}
void fall1()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write(BS( "Langsam aber sicher hebt sich die Luke weiter, spalt fuer spalt..."
	 "Du kannst zwar noch nichts erkennen, aber ein Lichtschimmer faellt "
	 "durch die Luke. "));
  if ( find_call_out("fall2") == -1 )   
    call_out("fall2",10);
}
void fall2()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write (("Endlich, Du hast es geschafft, die Luke ist auf und Du schaust "
	  "auf ein Wurzelwerk. Ploetzlich verlierst Du Dein Gleichgewicht "
	  "und kullerst vornueber die Treppe herunter.\n"
	  ) );
  TP->move( ROOM "baumwurz.lpc", M_GO, "kullert vornueber die Treppe hinunter.");
}

