#include <defines.h>
#include <properties.h>
#include <ansi.h>
#include "../def.h"
#include <moving.h>
inherit "std/room";




void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Bei einem kleinen Statuenbrunnen." );
  SetProp( P_INT_LONG,
    "Du bist den Weg um den Baum herum gegangen und stehst "
    "jetzt auf einer kleinen Plattform. Die Rinde des Baumes "
    "fasziniert Dich. Die Farbe der Rinde ist auch seltsam und "
    "schimmert, wie Wolken, die von der Abendsonne beschienen "
    "werden. Die Aeste mit ihren Blaettern scheinen in dem selben "
    "Farbton. Der Weg geht weiter nach oben um den Baum herum.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );


  AddDetail( ({"rinde"}),
        "Die Rinde schaut wirklich wundervoll in diesem  Farbton aus. "
	"Vielleicht kannst Du ja hindurch gehen?");
  AddDetail( ({"wolkengeige"}),
        "Wokengeige und Statue");
  AddDetail( ({"statue"}),
        "Die Statue blabla");
  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Die Rosen, die sich um das Spalier gewunden haben duften herrlich.");

  AddSmell( ({ "rosen" }),
    "Du riechst an einer der Rosen, ein betoerender Duft steigt "
    "in Deine Nase.");




//AddItem(NPC "tarabas", REFRESH_DESTRUCT);


AddExit( "unten",  ROOM "wissensbaum.lpc" );
/*AddExit( "norden", ROOM "pg5.lpc" );
AddExit( "westen", ROOM "pg16.lpc");
AddExit( "osten", ROOM "pg17.lpc");
AddExit( "suedwesten", ROOM "schoki");
AddExit( "suedosten", ROOM "eis");*/



AddCmd(  ({ "gehe", "geh", "gehen" }), "gehen"  );
}




int gehen(string str)
{
   notify_fail("Wodurch moechtest Du gehen?\n");

 if(!str || str == "") return 0;
 if(!(str=="durch rinde"||
       str=="durch die rinde"))       
       return 0;

 write(BS("Du setzt den ersten Fuss in Richtung Rinde, bist etwas zoegerlich, da Du der "
	  "Sache noch nicht wirklich traust. Du spuerst an Deinem Fuss, durch Dein "
	  "Schuhwerk eine leichte angenehme kuehle. Entscheidest Dich dazu, weiter durch "
	  "die Rinde zu gehen.\n"));

 say(TPN+" Spinnt wohl....und geht durch die Rinde des Baumes.\n");
    if ( find_call_out("fall1") == -1 )
      call_out("fall1",10);
    return 1;
  
}
void fall1()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write(BS( "Du fuehlst jetzt die Rinde an Deiner Nase und gehst immer "
         "weiter durch sie hindurch, Es prickelt angenehm auf der Haut. "
	 "Wie lauter kleine Wassertroepfchen die bei einem warmen Sommerregen "
	 "aus den Wolken faellt. Herrlich dieses Gefuehl. "));
  if ( find_call_out("fall2") == -1 )   
    call_out("fall2",10);
}
void fall2()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write (("Du bist nun durch die Rinde gekommen und Deine Augen werden immer "
	  "groesser. Der riesige Baum ist innen Hohl und riesige Regale sind "
	  "im Kreis nach oben aufgestellt. Du bist ueberwaeltigt.\n"
	  ) );
  TP->move( ROOM "baumin1.lpc", M_GO, "ist auf einmal in dem Baum verschwunden.");
}

