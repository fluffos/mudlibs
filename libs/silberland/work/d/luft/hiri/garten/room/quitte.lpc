#include <properties.h>
#include <ansi.h>
#include "../def.h"
#include <moving.h>

inherit ROOM "std_air";



void create() {
  string str;
  
  ::create();


//Licht und Temperatur wird in std_air gestetzt
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN: TT_PLAIN]) );

  
//Tageszeitenabhaengige Short
  SetProp( P_TD_SHORT, ({ "Auf einem Marmorsteinweg am fruehen Morgen.",
                          "Auf einem Marmorsteinweg.",
                          "Auf einem Marmorsteinweg.",
                          "Nachts auf einem Marmorsteinweg."}) );
  
  //Dieser String ist allen Beschreibungen gemeinsam, also zwischenspeichern
  //statt jedes mal zu schreiben
  str =  "Du bist zu dem Baum in der linken Senke gegangen. Aber nur ueber "
         "die Marmorplatten. Du hast dich nicht getraut auf den Rasen zu treten. "
         "Der Baum ist scheinbar noch jung. Die Baumkrone ist noch nicht sehr hoch. "
         "An dem ganzen Baum haengen gelbe pralle Fruechte. Sie sehen Aepfeln aehnlich. "
         "Sie duften aber eher nach Zitrone. Was das fuer Fruechte sind? Kennst du sie? "
         "Es ist bestimmt viel Arbeit die ganzen Fruechte zu ernten. Der Baum steht "
	 "in der Mitte des gepflegten Rasens. ";
	  

//Tageszeitenabhaengige Long
  SetProp( P_TD_LONG, ({
    str + "Du hoerst Huehner gackern und ein Hahn kraeht. Es ist jetzt "
          "schon waermer als in der Nacht.",
    str + "Die Sonne lacht Dich an.",
    str + "Die Sonne geht bald unter.",
    str + "Du hoerst ein Kaeuzchen seinen Ruf erschallen lassen. Da "
          "es Nacht ist, ist die Temperatur etwas gesunken."}));

//Bei RoomChats bitte wenn moeglich nur Einzeiler, NERVFAKTOR!!!11eins
//Tageszeitenabhaengige RoomChats
  SetProp(P_TD_ROOM_MSG, ({
    ({"Ein Hahn begruesst lautstark den Morgen.\n",
      "Der Hahn kraeht aus vollem Hals und Huehner beginnen zu gackern.\n",
      "Voegel zwitschern froehlich in den Baeumen.\n",
      "Irgendwo piepst eine Maus.\n" }),
    ({"Du hoerst verschiedene Voegel zwitschern, Bienen und Hummeln\n"
      "herumschwirren und summen.\n",
      "Grashuepfer zirpen laut.\n",
      "Eine Libelle fliegt rasant vorbei.\n" }),
    ({"Die Sonne geht unter.\n",
      "Der Himmel faerbt sich rot.\n"}),
    ({"Ein kleines Kaeuzchen beginnt leise zu rufen.\n",
      "In der Ferne schreit ein Kaeuzchen.\n",
      "Eine Zikade sirrt laut in einem Baum.\n" }) }));


  
//Tageszeitenabhaengiges Detail
  NightnDayDetail("himmel",
    ({"Der Himmel faerbt sich langsam rot, bald geht die Sonne auf.\n",
      "Vom Himmel lacht die Sonne.\n",
      "Langsam wird es dunkel, ein paar einzelne Sterne funkeln schon.\n",
      "Der tiefschwarze Himmel ist uebersaet mit funkelnden Sternen.\n",
      }));
 NightnDayDetail("temperatur",
    ({"Die Temperatur steigt, es wird bald Tag.\n",
      "Es ist angenehm warm.\n",
      "Langsam wird es dunkel, die Temperatur sinkt leicht.\n",
      "Es ist Nacht und die Temperatur ist kuehler geworden.\n",
      }));
 



 
  
  
//  AddSound( DEFAULT_SOUND, "");

  AddSound(({"blaetter"}), "Die Blaetter fluestern leise im Wind.\n");

//Tageszeitenabhaengiges Geraeusch
  NightnDaySound(DEFAULT_SOUND,
    ({"In der Ferne kraeht ein Hahn.\n",
      "Die Blaetter des Weltenbaumes rascheln leise im Wind.\n",
      "Sirrend stimmen Zikaden ihr Nachtlied an.\n",
      "Du hoerst ein Kaeuzchen schreien.\n"}));
  AddSound(({"kaeuzchen","ferne","ruf"}),
      "Du hoerst das Kaeuzchen in der Ferne rufen.\n");
  AddSound(({"zikade","baum"}),
      "In einem Baum sirrt eine Zikade.");


  
  
//  AddSmell(DEFAULT_SMELL, "Die Rosen, die sich um das Spalier gewunden "
//                          "haben duften herrlich.");

  AddSmell(({"fruechte", "quitte"}), "Du riechst an den Fruechten des Baumes, ein\n "
                                "wohliger Duft steigt in Deine Nase.\n");
//Tageszeitenabhaengiger Geruch
  NightnDaySmell(DEFAULT_SMELL,
    ({"Du glaubst frischen Tau zu riechen.\n",
      "Die Quitten duften betoerend.\n",
      "Die Quitten duften ein wenig zitronig.\n",
      "Du riechst den zitronigen Duft der Quitten.\n"}));


  
  AddDetail( ({ "senke"}),
    "Der wunderschoen geformte Baum, mit seinen duftenden "
    "Fruechten, steht in einer leichten Senke. "); 
  AddDetail( ({ "himmel"}),
    "Am Himmel stehen in der Nacht die Sterne und am Tag "
    "lacht die Sonne.");
  AddDetail( ({ "geraeusch"}),
    "Das solltest Du mit -lausch- hoeren koennen.");
  AddDetail( ({ "rasen","rasens"}),
    "Auf dem Rasen erkennst Du nicht einen Fleck mit Unkraut. "
    "Ein gewissenhafter Gaertner wird hier arbeiten. Der Rasen "
    "leuchtet in einem smaragdgruenen Gruen.");
  AddDetail( ({ "gruen" }),
    "Der Rasen leuchtet in einem wundervoll smaragadfarbigen "
    "Gruen.");
  AddDetail( ({ "fleck"}),
    "Kein Fleck Unkraut ist zu sehen. Sehr ordentlich.");
  AddDetail( ({ "unkraut"}),
    "Hier gibt es kein Fleck mit Unkraut.");
  AddDetail( ({ "gaertner", "gaertnerarbeit" ,"arbeit"}),
    "Der Gaertner muss wirklich vom Fach sein. Der ganze Garten "
    "ist perfekt gepflegt.");
  AddDetail( ({ "garten"}),
    "Der Garten ist perfekt gepflegt. Es duftet hier herlich und "
    "Du fuehlst Dich aeusserst wohl.");
  AddDetail( ({ "fach", "fall"}),
    "Man sagt eben: Er oder sie ist vom Fach. In diesem Fall ist "
    "der Gaertner und die Gaertnerarbeit gemeint.");
  AddDetail( ({"baum" , "baeume" }),
    "Dieser Baum traegt grosse gelbe Fruechte die sehr stark "
    "duften.");
  AddDetail( ({ "boden","marmorplatten", "platten" }),
    "Hier gehst Du auf den Marmorplatten. Der Weg ist rechts von dir. "
    "Gehe nach rechts und du betrittst den Weg wieder. ");
  AddDetail( ({ "weg", "wege","marmorsteinchen","steinchen" }),
    "Der Weg ist mit feinen Marmorsteinchen belegt worden und "
    "es knirscht leise bei jedem Deiner Schritte. Du gehst nicht "
    "auf dem Weg, daher knirscht es auch nicht.");
  AddDetail( ({"schritte"}),
    "Hier knirchen deine Schritte nicht. Du gehst ja auf den "
    "Marmorplatten.");
  AddDetail( ({ "mitte" }),
    "In der Mitte des Rasen, steht ein wunderschoen geformter Baum.");
  AddDetail( ({ "fruechte" , "fruechten" }),
    "Die Fruechte des Baeumes sind Gelb und haben einen weichen Flaum "
    "ueber der Schale. Man kann die Fruechte auch nicht essen wie Aepfel. "
    "Man kann aber sehr guten Gelee oder Saft daraus machen. Sie riechen "
    "etwas nach Zitrone.");
 
  AddDetail( ({ "aepfel","zitrone","aepfeln" }),
    "Die Fruechte sehen ein wenig aus wie eine Zitrone, "
    "aber auch ein wenig wie Aepfel. ");
  AddDetail( ({ "nacht","tag","sterne", "sonne"}),
    "Hier herrscht Tag und Nacht, das gibt es sonst im Silberland "
    "nicht. In der Nacht funkeln die Sterne wunderschoen und am Tag "
    "lacht die Sonne. ");
  AddDetail( ({ "gelee", "saft"}),
    "Man kann aus den Quitten sehr guten Gelee und Saft machen. "
    "Man sagt auch, das die Quitten hilfreich und heilend ist. ");
  AddDetail( ({ "schale","flaum"}),
    "Auf der Schale der Quitte, hat sich ein feiner Flaum gebildet.");
  AddDetail( ({ "gelb"}),
    "Die Fruechte sind in einem leuchtenden Gelb zu sehen. ");
  AddDetail( ({ "duft" }),
    "Den solltest du besser mit deiner Nase riechen. ");
  AddDetail( ({ "silberland", "gebiet" }),
    "Im Silberland gibt es bisher noch kein Gebiet, "
    "wo es Tag und Nacht gibt. ");
  AddDetail( ({ "nase" }),
    "Mit der Nase kannst du den Duft der Fruechte riechen. ");
  AddDetail( ({ "baumkrone","krone"}),
    "Die Baumkrone ist noch nicht sehr hoch. Man erreicht sie noch "
    "ziemlich einfach. ");

 


  
  
		


  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Die Fruechte an dem Baum, riechen zitronig.");

 


AddExit ("rechts", ([ EX_DEST : "/d/luft/hiri/garten/room/pg1.lpc",
                          EX_MSG  : "Du gehst ueber die Marmorplatten zurueck auf "
			            "den Weg." ]) );





//Tageszeit setzen (wichtig am ENDE!)
  setTimeOfDay();


}
