#include <defines.h>
#include <properties.h>
#include <ansi.h>
#include "../def.h"
#include <moving.h>
inherit "std/room";




void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Bei einem kleinen Statuenbrunnen." );
  SetProp( P_INT_LONG,
    "Du stehst direkt vor einem kleinen runden Brunnen in "
    "dessen Mitte eine kleine Statue steht. Um die Statue "
    "herum ist natuerlich Fluessigkeit, sonst waere es ja "
    "kein Brunnen. In diesem Teil des Gartens sind die "
    "Hecken und Baeumchen alle wie kleine Noten geschnitten.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );


  AddDetail( ({"wolkenvampir"}),
        "Wolkenvampir, Wolkengeige..blabla...");
  AddDetail( ({"wolkengeige"}),
        "Wokengeige und Statue");
  AddDetail( ({"statue"}),
        "Die Statue blabla");
  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Die Rosen, die sich um das Spalier gewunden haben duften herrlich.");

  AddSmell( ({ "rosen" }),
    "Du riechst an einer der Rosen, ein betoerender Duft steigt "
    "in Deine Nase.");




//AddItem(NPC "tarabas", REFRESH_DESTRUCT);


AddExit( "sueden",  ROOM "pg5" );
AddExit( "norden", ROOM "gewaechshaus" );
AddExit( "suedwesten", ROOM "pg20" );
AddExit( "suedosten", ROOM "pg23" );




AddCmd(  ({ "dreh", "drehe", "drehen" }), "drehen"  );
}




int drehen(string str)
{
   notify_fail("An was moechtest Du drehen?\n");

 if(!str || str == "") return 0;
 if(!(str=="an leier"||
       str=="an der leier"||
       str=="an drehleier"))       
       return 0;

 write(BS("Du beginnst an der alten Leier zu drehen und die Statue beginnt sich langsam "
	  "im Kreise zu drehen wie eine alte Spieluhr. Der kleine Wolkenvampir schaut Dich "
	  "froehlich an und nimmt seine Wolkengeige und legt sie auf seine linke Schulter. "
	  "Klemmt sie mit seinem Kinn fest und beginnt mit seiner rechten Hand die "
	  "Wolkengeige zu spielen.\n"));

 say(TPN+" dreht die Leier wild herum.\n");
    if ( find_call_out("fall1") == -1 )
      call_out("fall1",10);
    return 1;
  
}
void fall1()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write(BS( "Du drehst die Leier immer schneller weil Du hoffst eine "
         "Melodie zu hoeren. Dann schaust Du den kleinen Wolkenvampir "
	 "an und tatsaechlich, hoerst Du ploetzlich eine Melodie und "
	 "von der Wolkengeige sieht Du Noten durch die Luft wie kleine "
	 "Woelkchen davon schweben." ));
  if ( find_call_out("fall2") == -1 )   
    call_out("fall2",10);
}
void fall2()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write (("Du hoerst: Hicks Drunking-Synphonie Komponist: Gilbard\n"
"____|)________________________________________________________\n"
"|___/____________________________|___________________________||\n"
"|__/|_______/|____/|_____/|______|___________________________||\n"
