#include <defines.h>
#include <properties.h>

#include "../def.h"
#include <moving.h>
inherit "std/room";



void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Unter einem Rosenspalier." );
  SetProp( P_INT_LONG,
    "Du stehst vor zwei grossen Brunnenbecken, links und rechts "
    "von den Becken fuehren Treppen nach oben. Die grossen Becken, "
    "werden von mehreren Statuen gehalten. Ein rotbrauner Dampf "
    "steigt oberhalb der Becken auf und verstroemt einen sehr leicht "
    "beissenden Geruch.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Du schnubberst und es kribbelt leicht in Deiner Nase."
    "Du kannst aber nicht erriechen, was diesen Geruch verursacht.");

  AddSmell( ({ "rosen" }),
    "Du riechst an einer der Rosen, ein betoerender Duft steigt "
    "in Deine Nase.");




//AddItem(NPC "tarabas", REFRESH_DESTRUCT);


AddExit( "osten", ROOM "pg13" );
AddExit( "westen", ROOM "pg17" );
AddExit( "suedwesten", ROOM "eis");
AddExit( "nordwesten", ROOM "pg23");

AddExit ("linksoben", ([ EX_DEST : "/d/luft/hiri/garten/room/schwefelblinks.lpc",
                          EX_MSG  : "Du steigst die Treppe auf der rechten Seite "
			            "hinauf und erblickst ein Brunnen aus dem "
				    "rötlichbraune Fluessigkeit sprudelt." ]) );

AddExit ("rechtsoben", ([ EX_DEST : "/d/luft/hiri/garten/room/schwefelbrechts.lpc",
                          EX_MSG  : "Du steigst die Treppe auf der rechten Seite "
			            "hinauf und erblickst ein Brunnen aus dem "
				    "rötlichbraune Fluessigkeit sprudelt." ]) );

}
