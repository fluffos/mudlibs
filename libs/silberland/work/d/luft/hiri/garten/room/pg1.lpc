#include <properties.h>
#include <ansi.h>
#include "../def.h"
#include <moving.h>

inherit ROOM "std_air";

int bild_vorhanden;

void create() {
  string str;
  
  ::create();


//Licht und Temperatur wird in std_air gestetzt
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN: TT_PLAIN]) );

  
//Tageszeitenabhaengige Short
  SetProp( P_TD_SHORT, ({ "Auf einem Marmorsteinweg am fruehen Morgen.",
                          "Auf einem Marmorsteinweg.",
                          "Auf einem Marmorsteinweg.",
                          "Nachts auf einem Marmorsteinweg."}) );
  
  //Dieser String ist allen Beschreibungen gemeinsam, also zwischenspeichern
  //statt jedes mal zu schreiben
  str =  "Langsam schreitest Du ueber die vielen kleinen Marmorsteinchen. "
         "Jeder Deiner Schritte erzeugt ein leises Geraeusch. Du schaust "
         "Dich um und fuehlst Dich so wohl wie schon lange nicht mehr. "
         "Links und rechts siehst Du auf einem sauber geschnittenen Rasen "
         "je einen Baum stehen, wenn Du zurueck schaust siehst Du das "
         "Rosenspalier. Im Norden erkennst Du ein Gebilde, aber es ist zu "
         "weit weg. Zwei weitere Wege fuehren nach Nordosten und Nordwesten. ";
	  

//Tageszeitenabhaengige Long
  SetProp( P_TD_LONG, ({
    str + "Du hoerst Huehner gackern und ein Hahn kraeht. Es ist jetzt "
          "schon waermer als in der Nacht.",
    str + "Die Sonne lacht Dich an.",
    str + "Die Sonne geht bald unter.",
    str + "Du hoerst ein Kaeuzchen seinen Ruf erschallen lassen. Da "
          "es Nacht ist, ist die Temperatur etwas gesunken."}));

//Bei RoomChats bitte wenn moeglich nur Einzeiler, NERVFAKTOR!!!11eins
//Tageszeitenabhaengige RoomChats
  SetProp(P_TD_ROOM_MSG, ({
    ({"Ein Hahn begruesst lautstark den Morgen.\n",
      "Der Hahn kraeht aus vollem Hals und Huehner beginnen zu gackern.\n",
      "Voegel zwitschern froehlich in den Baeumen.\n",
      "Irgendwo piepst eine Maus.\n" }),
    ({"Du hoerst verschiedene Voegel zwitschern, Bienen und Hummeln\n"
      "herumschwirren und summen.\n",
      "Grashuepfer zirpen laut.\n",
      "Eine Libelle fliegt rasant vorbei.\n" }),
    ({"Die Sonne geht unter.\n",
      "Der Himmel faerbt sich rot.\n"}),
    ({"Ein kleines Kaeuzchen beginnt leise zu piepen.\n",
      "In der Ferne schreit ein Kaeuzchen.\n",
      "Eine Zikade ratscht laut in einem Baum.\n" }) }));


  
//Tageszeitenabhaengiges Detail
  NightnDayDetail("himmel",
    ({"Der Himmel faerbt sich langsam rot, bald geht die Sonne auf.\n",
      "Vom Himmel lacht die Sonne.\n",
      "Langsam wird es dunkel, ein paar einzelne Sterne funkeln schon.\n",
      "Der tiefschwarze Himmel ist uebersaet mit funkelnden Sternen.\n",
      }));
 NightnDayDetail("temperatur",
    ({"Die Temperatur steigt, es wird bald Tag.\n",
      "Es ist angenehm warm.\n",
      "Langsam wird es dunkel, die Temperatur sinkt leicht.\n",
      "Es ist Nacht und die Temperatur ist kuehler geworden.\n",
      }));
 NightnDayDetail("bienen",
    ({"Bald fliegen auch die Bienen wieder um Honig zu sammeln.\n",
      "Die Bienen schwirren herum und suchen Nektar.\n",
      "Langsam wird es dunkel, die Bienen fliegen in ihren Bienenstock.\n",
      "Es ist Nacht und keine Biene mehr da.\n",
      }));
 



 
  
  
//  AddSound( DEFAULT_SOUND, "");

  AddSound(({"blaetter"}), "Die Blaetter fluestern leise im Wind.\n");

//Tageszeitenabhaengiges Geraeusch
  NightnDaySound(DEFAULT_SOUND,
    ({"In der Ferne kraeht ein Hahn.\n",
      "Die Blaetter des Weltenbaumes rascheln leise im Wind.\n",
      "Zirpende Grillen stimmen ihr Nachtlied an.\n",
      "Du hoerst ein Kaeuzchen schreien.\n"}));
  AddSound(({"kaeuzchen","ferne","ruf"}),
      "Du hoerst das Kaeuzchen in der Ferne rufen.\n");
  AddSound(({"zikade","baum"}),
      "In einem Baum sirrt eine Zikade.");


  
  
//  AddSmell(DEFAULT_SMELL, "Die Rosen, die sich um das Spalier gewunden "
//                          "haben duften herrlich.");

  AddSmell(({"rosen", "rose"}), "Du riechst an einer der Rosen, ein\n "
                                "betoerender Duft steigt in Deine Nase.\n");
//Tageszeitenabhaengiger Geruch
  NightnDaySmell(DEFAULT_SMELL,
    ({"Du glaubst frischen Tau zu riechen.\n",
      "Die Rosen duften betoerend.\n",
      "Die Rosen duften betoerend.\n",
      "Du vernimmst einen leisen Hauch von Rosenduft.\n"}));


  
  AddDetail( ({ "rosenspalier","spalier"}),
    "Das Rosenspalier ist im Sueden. Du kannst es sehen wenn Du "
    "zurueck schaust. Den Duft der feinen Rosen kannst Du aber "
    "noch schwach wahrnehmen."); 
  AddDetail( ({"rosen", "rose"}),
    "Wenn du wieder zurueck zu dem Rosenspalier gehst, kannst du "
    "die Rosen bewundern. ");
  AddDetail( ({ "marmorsteinchen", "steinchen"}),
    "Der Weg ist mit Marmorsteinchen bestreut und bei jedem "
    "Deiner Schritte knirscht es leise.");
  AddDetail( ({ "geraeusch"}),
    "Das solltest Du mit -lausch- hoeren koennen.");
  AddDetail( ({ "rasen"}),
    "Auf dem Rasen erkennst Du nicht einen Fleck mit Unkraut. "
    "Ein gewissenhafter Gaertner wird hier arbeiten. Der Rasen "
    "leuchtet in einem smaragdgruenen Gruen.");
  AddDetail( ({ "gruen" }),
    "Der Rasen leuchtet in einem wundervoll smaragadfarbigen "
    "Gruen.");
  AddDetail( ({ "fleck"}),
    "Kein Fleck Unkraut ist zu sehen. Sehr ordendlich.");
  AddDetail( ({ "unkraut"}),
    "Hier gibt es kein Fleck mit Unkraut.");
  AddDetail( ({ "gaertner", "gaertnerarbeit" ,"arbeit"}),
    "Der Gaertner muss wirklich vom Fach sein. Der ganze Garten "
    "ist perfekt gepflegt.");
  AddDetail( ({ "garten"}),
    "Der Garten ist perfekt gepflegt. Es duftet hier herrlich und "
    "Du fuehlst Dich aeusserst wohl.");
  AddDetail( ({ "fach", "fall"}),
    "Man sagt eben: Er oder sie ist vom Fach. In diesem Fall ist "
    "der Gaertner und die Gaertnerarbeit gemeint.");
  AddDetail( ({"baum" , "baeume" }),
    "Meinst Du den Baum auf dem linken Rasen oder den auf dem "
    "rechten Rasen? Linker Baum oder rechter Baum?");
  AddDetail( ({ "linker baum"}),
    "Auf dem linken Rasen steht in der Mitte ein mittelgrosser "
    "Baum mit gelben Fruechten. Du siehst Marmorplatten die zu "
    "dem Baum fuehren. Es geht leicht in eine Senke hinunter.");
  AddDetail( ({ "rechter baum"}),
    "Auf dem rechten Rasen steht in der Mitte ein mittelgrosser "
    "Baum mit roten Beeren. Du siehst Marmorplatten die zu "
    "dem Baum fuehren. Es geht leicht in eine Senke hinunter.");
  AddDetail( ({ "boden" }),
    "Hier gehst Du auf dem Weg, der zwischen dem Rasen "
    "angelegt wurde.");
  AddDetail( ({ "weg", "wege" }),
    "Der Weg ist mit feinen Marmorsteinchen belegt worden und "
    "es knirscht leise bei jedem Deiner Schritte. Zwei weitere "
    "Wege fuehren nach Nordosten und Nordwesten.");
  AddDetail( ({ "mitte" }),
    "Auf dem Rasen links und rechts von Dir, steht jeweils "
    "genau in der Mitte, ein Baum.");
  AddDetail( ({ "fruechte" , "fruechten" }),
    "Die Beeren und Fruechte der Baeume wirst Du besser "
    "betrachten koennen, wenn Du in die linke oder rechte "
    "Senke gehst. Du kannst nach links oder rechts gehen.");
 AddDetail( ({ "beeren" , "beere" }),
    "Die Beeren und Fruechte der Baeume wirst Du besser "
    "betrachten koennen, wenn Du in die linke oder rechte "
    "Senke gehst. Aber bitte gehe ueber die Marmorplatten.");
  AddDetail( ({ "marmorplatten","platten"}),
    "Welche Marmorplatten meinst Du? Die linken oder rechten?");  
  AddDetail( ({ "linke marmorplatten" , "linke platten" }),
    "Du kannst die linken Marmorplatten betreten, wenn du."
    "nach links gehst.");
  AddDetail( ({ "rechte marmorplatten" , "rechte platten" }),
    "Du kannst die rechten Marmorplatten benutzen, wenn du "
    "nach rechts gehst.");
  AddDetail( ({"gebilde"}),
    "Das Gebilde ist weiter im Norden. Es koennte eine "
    "Statue sein.");
  AddDetail( ({"statue"}),
    "Die Statue die du vermtutest ist weiter im Norden. ");
  AddDetail( ({"norden"}),
    "Im Norden siehst du ein Gebilde. Es koennte eine "
    "Statue sein.");
  AddDetail( ({"himmel"}),
    "Wenn du nach oben schaust, siehst du den wunderschoenen "
    "Himmel. Am Tage strahlt die Sonne und in der Nacht die "
    "Sterne.");
  AddDetail( ({"schritte"}),
    "Deine Schritte erzeugen ein Geraeusch auf dem Weg. ");
  AddDetail( ({"sterne"}),
    "In der Nacht kannst du die Sterne am Himmel sehen. ");
  AddDetail( ({"tage"}),
    "Am Tage kannst du am Himmel, die Sonne lachen sehen. ");
  AddDetail( ({"sonne"}),
    "Wenn die Sonne lacht und strahlt ist es am Tage hell. ");
  AddDetail( ({"nacht"}),
    "In der Nacht ist es dunkel, aber man sieht die Sterne strahlen. ");
  AddDetail( ({"voegel","hummeln","bienen","libelle"}),
    "Je nach Tageszeit kannst du Hummeln, Voegel, Libellen oder Bienen "
    "beobachten.");
  AddDetail( ({"tageszeit","zeit"}),
    "Du hast bestimmt schon bemerkt, welche Tageszeit wir gerade haben. ");
  AddDetail( ({"duft"}),
    "Den Duft der Rosen nimmst du hier schwach wahr.");

  
		


  AddSound( DEFAULT_SOUND,
    "Du hoerst bei jedem deiner Schritte ein leises Geraeusch.");

  AddSound( ({ "geraeusch" }),
    "Das Geraeusch ist ein leises knirschen.");

  AddSmell( DEFAULT_SMELL,
    "Die Rosen, die sich um das Spalier gewunden haben duften herrlich. "
    "Aber hier eher schwach.");

  AddSmell( ({ "rosen" }),
    "Hier riechst du sie nur noch schwach. Geh zurueck zu dem Spalier, "
    "wenn du an ihnen schnuppern magst.");




//AddItem(NPC "tarabas", REFRESH_DESTRUCT);


AddExit( "sueden", ROOM "spalier" );
AddExit( "norden", ROOM "pg2" );
AddExit( "nordwesten", ROOM "pg6.lpc");
AddExit( "nordosten", ROOM "pg7.lpc");


AddExit ("links", ([ EX_DEST : "/d/luft/hiri/garten/room/quitte.lpc",
                          EX_MSG  : "Du gehst ueber die Marmorplatten zu dem "
			            "linken Baum. Er traegt gelbe pralle Fruechte. "
				    "Der Duft kommt dir bekannt vor.." ]) );

AddExit ("rechts", ([ EX_DEST : "/d/luft/hiri/garten/room/kornell.lpc",
                          EX_MSG  : "Du gehst ueber die Marmorplatten zu dem   "
			            "rechten Baum. Er traegt rote Kirschen aehnliche "
				    "Früchte." ]) );
//Tageszeit setzen (wichtig am ENDE!)
  setTimeOfDay();


//AddCmd( ({ "betrete", "betret", "betreten" }), "cmd_betreten"  );
//AddCmd( ({ "benutze", "benutz", "benutzen" }), "cmd_benutzen"  );
}










