#include <defines.h>
#include <properties.h>
#include <ansi.h>
#include "../def.h"
#include <moving.h>
inherit "std/room";




void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Bei einem kleinen Statuenbrunnen." );
  SetProp( P_INT_LONG,
    "Du stehst direkt vor einem kleinen runden Brunnen in "
    "dessen Mitte eine kleine Statue steht. Um die Statue "
    "herum ist natuerlich Fluessigkeit, sonst waere es ja "
    "kein Brunnen. In diesem Teil des Gartens sind die "
    "Hecken und Baeumchen alle wie kleine Noten geschnitten.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );


  AddDetail( ({"wurzel"}),
        "wurzel lalala");
  AddDetail( ({"wolke"}),
        "Wolke luken");
  AddDetail( ({"boden"}),
        "Boden jaja.");
  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Die Rosen, die sich um das Spalier gewunden haben duften herrlich.");

  AddSmell( ({ "rosen" }),
    "Du riechst an einer der Rosen, ein betoerender Duft steigt "
    "in Deine Nase.");




//AddItem(NPC "tarabas", REFRESH_DESTRUCT);


AddExit( "oben",  ROOM "baumin1.lpc" );



AddCmd(  ({ "luk", "luke", "luken" }), "luken"  );
}




int luken(string str)
{
   notify_fail("Wo moechtest Du durch luken?\n");

 if(!str || str == "") return 0;
 if(!(str=="durch wolke"||
       str=="durch boden"||
       str=="durch den boden"||
       str=="durch die wolke"))       
       return 0;

 write(BS("Du lukst durch die Wolke und staunst nicht schlecht, das ganze Silberland kannst "
	  "du erkennen. Da die Steppe, das Wasser, die Ebene, das Huegelland und Gebirge,  "
	  "den Kristallwald, die trockene Wueste...einfach alles. Dann faellt Dir ein "
	  "Regenbogen auf und ein Kindheitstraum erwacht in Dir. Der Regenbogen endet genau "
	  "an den Wurzeln. Du beschliesst Deinen Traum wahr werden zu lassen......\n"));

 say(TPN+" Kopf ist in der Wolke verschwunden und bewegt sich hin und her. Ploetzlich "
	 "siehst Du nur noch die Wolke.\n");
    if ( find_call_out("fall1") == -1 )
      call_out("fall1",10);
    return 1;
  
}
void fall1()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write(BS( "Dein Kindheitstraum wird wahr...Du nimmst anlauf und mit einem "
         "gekonnten Bauchrutscher landest Du auf dem Regenbogen. In wilder "
	 "fahrt sausst Du wilde Kurven ohne von dem Regenbogen zu rutschen. "
	 "Du jauchzt und schreist vergnuegt, quikst wie ein herum tollendes "
	 "Kind. Es wird noch etwas schneller, der Wind treibt Dir die Traenen "
	 "in die Augen." ));
  domainshout( TPN+" Jauchzt wie ein kleines Kind und Jubelt.\n","^/d/luft/hiri/garten/",1);
  if ( find_call_out("fall2") == -1 )   
    call_out("fall2",10);
}
void fall2()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write (("Du rutschst und rutschst und denkst dann erschoepft: Hat der Regenbogen "
	  "kein Ende?. Dann faellt Dir ein das an den Enden des Regenbogens ja ein "
	  "Schatz sein soll. Ob das wohl stimmt? Du wartest gespannt ab und siehst "
	  "das Ende des Regenbogens. Es funkelt etwas dort.\n"
	  ) );
  
say(TPN+" ist ploetzlich in den Wolken verschwunden.... "
	 "Das jauchzen hast Du auch vernommen und fragst " 
	 "was das zu bedeuten hat.\n");

 TP->move( "/d/luft/hiri/garten/room/schatzraum", M_GO, "verschwindet einfach");

}

