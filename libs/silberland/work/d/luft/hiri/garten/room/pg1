int cmd_benutzen(string str)
{
   notify_fail("Was moechtest Du benutzen?\n");

 if(!str || str == "") return 0;
 if(!(str=="linke marmorplatten"||
      str=="linke platten"))       
       return 0;

 write(BS("Du machst einen grossen Schritt und trittst auf die erste "
	  "linken Marmorplatten.\n"));

 say(TPN+"macht einen grossen Schritt und tritt auf eine der linken Marmorplatten.\n");
    if ( find_call_out("fall1") == -1 )
      call_out("fall1",10);
    return 1;
  
}
void fall1()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write(BS( "Du gehst weiter und stehst bald vor dem schoen geformten Baum."
            "Die gelben Fruechte sehen einfach herrlich aus und verstroehmen "
	    "einen wunderbaren Duft." ));
  
  if ( find_call_out("fall2") == -1 )   
    call_out("fall2",10);
}
void fall2()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write (("Du kommst nicht darauf, welche Fruechte das sind. "
	  "Dabei bist Du Dir aber sicher das Du den Geruch "
	  "der Fruechte kennst.\n"
	  ) );
  
say(TPN+" steht in der linken Senke.\n");

 TP->move( "/d/luft/hiri/garten/room/quitte", M_GO, "benutzt die linken Marmorplatten.");

}


