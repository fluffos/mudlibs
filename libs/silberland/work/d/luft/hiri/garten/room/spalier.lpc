  AddDetail( ({"marmorsteinchen","steinchen"}),
    "Die Marmorsteinchen sind wolkenrosa und wolkenweiss farbig marmoriert.");
    
  AddDetail( ({"spuren","stiefeln","stiefel"}),
    "Die Spuren der vielen Stiefel werden von dem Gaertner "
    "mehrmals am Tag beseitigt.");

  AddDetail( ({"tag","nacht"}),
    "Der Gaertner arbeitet bei Tag und ab und zu sogar in der Nacht.");
 
  AddDetail( ({ "rosenarten","rosen"}),
    "Viele verschiedene Rosenarten sind um das Rosenspalier gewachsen. "
    "In leuchtenden Farben und einen betoerenden Duft verstroemend.");
  
  AddDetail( ({ "farben"}),
    "Rosen in sovielen Farben: rote, violette, weisse...eine herrliche "
    "Pracht. ");

  AddDetail( ({ "pracht"}),
    "Die Pracht der Rosen laesst darauf schliessen, dass hier ein sehr "
    "guter Gaertner sein Werk verrichtet. Die Blueten der verschiedenen "
    "Rosenarten sind herrlich in ihrer Farbe und Pracht anzuschauen.");

  AddDetail( ({"blueten"}),
    "Du siehst Blueten von den Rosenarten: Rene Andre, Sombreuil, "
    "Russeliana, Rambling Rector, Paul Noel. Wirklich eine sehr "
    "wundervoll farbige und duftende Pracht.");

  AddDetail( ({"rene andre","rene","andre"}),
    "Etwas remontierender, leicht nach Apfel duftender Wichuriana-Rambler. "
    "Von zartem kupfer ueber apricot verlaufende, halbgefuellte Blueten, im "
    "verbluehen gelblich-zartrosa. Nachbluete meist heller.");

  AddDetail( ({"nachbluete","apfel","wichuriana","rambler",}),
    "Um Dir das alles zu erklaeren wuerde lange dauern, vielleicht "
    "findest Du etwas in unmittelbarer Naehe um mehr zu erfahren.");

  AddDetail( ({"sombreuil"}),
    "Cremeweisse, flache gevierteilte, rosettenfoermige Blueten "
    "rosettenfoermige. Kletternde Teehybride mit typischem "
    "Teerosenduft, gut remontierend. Bedingt winterhart in rauhen "
    "Lagen.");

  AddDetail( ({"teehybride","lagen"}),
    "Was Lagen bedeutet muss ich Dir wohl nicht erklaeren und "
    "teehybride bekommst Du vielleicht in unmittelbarer Naehe "
    "erklaert.");

  AddDetail( ({"teerosenduft"}),
   "Den Teerosenduft solltest Du wohl eher mit Deiner Nase "
   "wahrnehmen.");

  AddDetail( ({"russeliana","bueschel"}),
   "Karmesinrot und Purpur, dicht gefuellt, in Buescheln, "
   "einmal sehr reichlich bluehend.");

  AddDetail( ({"karmesinrot","purpur"}),
   "In den Farben Karmesinrot und Purpur erstrahlt die schoene "
   "Russeliana.");

  AddDetail( ({"rambling rector","rambling","rector"}),
   "Weiß mit gelben Staubgefaessen, einmalbluehend, fuer Zaeune, "
   "Baeume oder Hecken ideal.");

  AddDetail( ({"staubgefaessen","staubgefaesse","zaeune","baeume","hecken"}),
   "Zaeune, Baeume und Hecken werden Dir noch in diesem Garten "
   "gezeigt werden, Staubgefaesse siehst Du hier.");

  AddDetail( ({"paul noel","paul","noel"}),
   "Gelblich rosa, gefuellt, gut duftend, mittelgross.");

  AddDetail( ({"naehe"}),
    "Vieleicht gibt es in der Naehe etwas, wo Du mehr erfahren kannst.");

  AddDetail( ({"werk"}),
    "Blue Menerde ist hier der Gaertner, er arbeitet sehr ordentlich. "
    "Das wirst Du in diesem Garten ueberall bemerken.");

  AddDetail( ({"menerde","nachname"}),
    "Menerde ist der Nachname von Blue.");

  AddDetail( ({"blue","vorname"}),
    "Blue ist der Vorname von dem Gaertner dieses Palastgartens.");

  AddDetail( ({ "duft","geruch" }),
    "Den herrlichen Duft der Rosen solltest Du mit Deiner huebschen "
    "Nase wahrnehmen koennen.");

  AddDetail( ({ "nase"}),
    "Mit Deiner huebschen Nase kannst Du den herrlichen Duft der "
    "Rosen wahrnehmen.");

  AddDetail( ({ "gaertner"}),
    "Irgendwie, kommt Dir der Gaertner bekannt vor. Deine Augen "
    "erinnern sich an Jemand, der genauso ordentlich sein Werk "
    "erledigt.");

  AddDetail ( ({ "augen"}),
    "Vor Deinen Augen bildet sich immer staerker die Erinnerung "
    "an diesen Jemand.");

  AddDetail ( ({ "erinnerung"}),
    "Deine Erinnerung an diesen Jemand wird immer klarer.");

  AddDetail( ({ "jemand" }),
    "Du schliesst Deine Augen, und Du siehst ein klares Bild von "
    "diesem Jemand.");

  AddDetail( ({"bild"}),
    "Du koenntest ein Bild von diesem Jemand malen.");

  AddDetail( ({"himmel"}),
    "Du bist in luftiger Hoehe und somit schon am Himmel, aber "
    "da der Himmel ja noch weiter hinauf geht kannst Du ihn "
    "natuerlich auch hier sehen, denn die Wolken sind unter Dir. "
    "Die Sonne ist Dir naeher als sonst, aber durch den kuehlen "
    "Wind, der hier staendig weht, spuerst Du die Hitze nicht.");

  AddDetail( ({"hoehe"}),
    "Du bist oberhalb der Wolken und in luftiger Hoehe.");

  AddDetail( ({"wolken"}),
    "Du bist in luftiger Hoehe und laeufst praktisch auf Wolken.");

  AddDetail( ({"sonne"}),
    "Durch den Wind spuerst Du die Sonne kaum, sehen kannst Du sie "
    "aber, da ueber Dir keine Wolken zu sehen sind.");

  AddDetail( ({"wind"}),
    "Der Wind ist angenehm kuehl und es pfeift etwas wenn er an Dir "
    "vorrueber saust.");

  AddDetail( ({"boden"}),
    "Links und rechts des Weges ist ein fein saeuberlich geschnittener "
    "Rasen. Der Gaertner scheint wirklich sehr ordentlich zu sein. "
    "Aber auch auf dem Weg mit den Marmorsteinchen hast Du das Gefuehl "
    "wie auf Wolken zu gehen und sinkst immer etwas ein.");

  AddDetail( ({"gefuehl"}),
    "Das Gefuehl taeuscht Dich nicht, Du laeufst ja wirklich auf Wolken.");

  AddDetail( ({"hitze"}),
    "Du spuerst durch den Wind, die Hitze kaum.");

  AddDetail( ({"rasen"}),
    "Der Rasen ist fein saeuberlich geschnitten und leuchtet herrlich.");

  AddDetail( ({"hummel"}),
    "Hummeln schwirren geschaeftig hin und her.");

  

//bild, spezialdetail, male bild obj clonen was das bild blu s darstellt.


  AddSound( DEFAULT_SOUND,
    "Manchmal, wenn der Wind an Dir vorueber saust, hoerst "
    "Du ein leises Pfeifen.");

  AddSound( ({ "pfeifen","manchmal","wind" }),
    "Das Pfeifen erzeugt der Wind wenn er an Dir vorbei saust.");

  AddSmell( DEFAULT_SMELL,
    "Die Rosen, die sich um das Spalier gewunden haben duften herrlich. "
    "Der Geruch der verschiedenen Rosen riecht auch etwas nach Apfel.");

  AddSmell( ({ "rosen","rosenarten","apfel" }),
    "Du riechst an einer der Rosen, ein betoerender Duft steigt "
    "in Deine Nase.");

  AddSmell( ({"duft"}),
    "Du kannst einen Geruch von Apfel wahrnehmen der aber von "
    "einer der Rosenarten stammt.");

  AddSmell( ({"lebensbaeume","baeume","geruch"}),
    "Die Lebensbaeume haben einen etwas eigenartigen Geruch. "
    "Sei froh das sie nicht nass sind, dann stinken sie ekelig.");


//AddCmd( ({"mal","male"})        , "cmd_malen");
AddCmd ( ({"male", "male"}), "malen");

AddItem(NPC "gwandler", REFRESH_DESTRUCT);
AddItem(NPC "gaertner", REFRESH_DESTRUCT);

//AddExit( "sueden", ROOM "" );
AddExit( "norden", ROOM "pg1" );

 //Tageszeit setzen (wichtig am ENDE!)
  setTimeOfDay();
}


int malen(string str)
{
  object bild;

  notify_fail("Was moechtest Du malen?\n");
  
  if ( !bild_vorhanden )
  {
    write( BS(
      "Du hast doch ein Bild gemalt, weist Du immer noch "
      "nicht, wer der Jemand aus Deiner Erinnerung ist?") );
    return -1;
  }
  if ( member( ({ "bild"}),str) != -1)
  {
    bild = clone_object("/d/luft/hiri/garten/obj/bild");
    bild_vorhanden = 0;
    if ( ME_TOO_HEAVY==bild->move(TP,M_GET|M_SILENT) )
    {
      write(
        "Du hast Dich wohl zu sehr uebernommen, leider "
	"faellt Dir das Bild aus der Hand.\n");
      bild->move(TO,M_NOCHECK);
      return 1;
    }
    write( BS(
      "Du hast aus Deiner Erinnerung heraus diesen "
      "Jemand gemalt. Ob Du ihn jetzt erkennst?") );
    say(
      TPN+" hat etwas auf einen Zettel gemalt.\n");
    return 1;
  }
}

void reset()
{
  ::reset();

  bild_vorhanden = random(3);
}
