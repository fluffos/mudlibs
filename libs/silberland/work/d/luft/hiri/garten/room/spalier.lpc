  AddDetail( ({"hecke"}),
    "Die Hecke aus Lebensbaeumen umschliesst den grossen Palastgarten.");

  AddDetail( ({"engeln","engel"}),
    "Die Lebensbaeume sind zu Engeln geschnitten worden.");

  AddDetail( ({"garten","palastgarten"}),
    "Der Palastgarten ist recht gross und hat einiges zu bieten. "
