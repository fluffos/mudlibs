  AddDetail( ({"tor"}),
    "Das Rosenspalier dient als Tor zu dem Garten oder aber um "
    "zurueck zu dem Palast zu kommen.");

  AddDetail( ({"palast"}),
    "Der Palast ist im Sueden Du solltest ihn Dir unbedingt "
