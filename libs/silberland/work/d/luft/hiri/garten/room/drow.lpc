#include <defines.h>
#include <properties.h>
#include <ansi.h>
#include "../def.h"
#include <moving.h>
inherit "std/room";




void create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem verdunkelten Gartenstueck." );
  SetProp( P_INT_LONG,
    "Du bemerkst schnell das dieser Raum aeusserst unangenehm "
    "ist. Es sei denn Du bist ein Dunkelelf. Durch einen seltsamen "
    "Zauber ist dieser Teil des Garten`s Stockduster. Vielleicht "
    "liegt es an diesem Gebilde, welches leicht Abseits plaziert wurde.");

  SetProp( P_LIGHT, -1 );
  SetProp( P_INDOORS, -1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );


  AddDetail( ({"spinne"}),
        "Die Goettin der Dunkelelfen wird als Spinne dargestellt. Das Gebilde "
	"traegt eine wertvolle Peitsche.");
  AddDetail( ({"peitsche entreissen?"}),
        "Das Gebilde der Göttin traegt eine wertvolle Peitsche. Du koenntest versuchen "
	"sie der Goettin zu entreissen.");
  AddDetail( ({"gebilde"}),
        "Dieses Gebilde zeigt eine Spinne die Lloth darstellen soll. Was finden "
	"die Dunkelelfen nur an dieser Lloth so toll? ");
  AddDetail( ({"lloth"}),
	"Lloth ist die Goettin der Dunkelelfen");
  AddDetail( ({"goettin"}),
	"Die Goettin de Dunkelelfen heisst Lloth. Die Dunkelelfen verehren sie bis "
	"in den Tod.");
  AddDetail( ({"tod"}),
	"Du soltest besser auf dich aufpassen, der Tod erreicht einen manchmal "
	"schneller als man denkt. Allerdings wird hier nur beschrieben, das die " 
	"Dunkelelfen ihrer Goettin bis zum Ende dienen. ");
  AddDetail( ({"ende"}),
	"Erreicht dich dein Ende bald? ");
  AddDetail( ({"dunkelelfen","drow"}),
	"Die Dunkelelfen des Silberlandes, leben in der Unterwelt. Hast du "
	"ihnen noch keinen Besuch abgestattet? Das ist aber schade. ");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "Die Rosen, die sich um das Spalier gewunden haben duften herrlich.");

  AddSmell( ({ "rosen" }),
    "Du riechst an einer der Rosen, ein betoerender Duft steigt "
    "in Deine Nase.");




//AddItem(NPC "tarabas", REFRESH_DESTRUCT);


AddExit( "sueden",  ROOM "pg5" );
AddExit( "norden", ROOM "gewaechshaus" );
AddExit( "suedwesten", ROOM "pg20" );
AddExit( "suedosten", ROOM "pg23" );




AddCmd(  ({ "entreisse", "entreiss", "entreissen" }), "entreissen"  );
}




int entreissen(string str)
{
   notify_fail("Was moechtest Du entreissen?\n");

 if(!str || str == "") return 0;
 if(!(str=="peitsche"))       
       return 0;

 write(BS("Versucht sich der Peitsche zu bemaechtigen, was gaenzlich daneben geht.\n"));

 say(TPN+" fummelt gierig an der Peitsche herum.\n");
    if ( find_call_out("fall1") == -1 )
      call_out("fall1",10);
    return 1;
  
}
void fall1()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write(BS( "bekommt Lloth Rache zu spüren." ));
  if ( find_call_out("fall2") == -1 )   
    call_out("fall2",10);
}
void fall2()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write (("Hoert Lloth und erschrickt sich fuerchterlich.\n"
	  ) );
 TP->AddHp(20);
}


