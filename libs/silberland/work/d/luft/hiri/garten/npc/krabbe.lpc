
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Krabbe");
  SetProp(P_LONG,
    "Eine kleine Krabbe, die hier ueberall rumkrabbelt und Spieler zwickt, "
    "ziemlich frech fuer so ein kleines Geschoepf, aber verstanedlich bei "
    "der Koerpergroesse denkt sie sich, nur frech kommt weiter.");
  SetProp(P_NAME, "Krabbe");
  SetProp(P_GENDER,  FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({ "krabbe"}));

  create_default_npc(5);
  SetProp(P_HANDS, ({" mit ihren Scheren" , 50, DT_RIP }) );
  SetProp(P_SIZE, 30 );
  SetProp(P_RACE, "Krabbe");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_MMSGIN, "kommt Scherenklappernt herein");
  SetProp(P_MMSGOUT, "klappert mit den Scheren und verschwindet");
  SetProp(P_DIE_MSG,  " klappert ein letztes mal und faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Meine Scheren waren noch im Wachstum, Du bist gemein!");
  SetProp(P_KILL_NAME, "Killer-NPC");
  SetProp(P_KILL_MSG, "Meinen Scheren entkommt keiner!");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("Hiri", "Hiri hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Krabbe will Deine Sachen nicht tragen.\n" }) );

  SetChats(3, ({
    "Die Krabbe klappert mit den Scheren.\n",
    "Die Krabbe zwickt Dich in Deinen Po.\n"}) );
  SetAttackChats(10, ({
    "Die Krabbe zwickt Dich feste in Dein Bein.\n"}) );


}

