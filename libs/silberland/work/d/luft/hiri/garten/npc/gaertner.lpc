void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Blue Menerde, der Palastgaertner.");
  SetProp(P_LONG,
    "Dies ist Blue Menerde, der Bruder des beruehmten "
    "Blu Menerde. Lange Zeit, wusste Niemand wo er sich "
    "aufhaelt. Kein Wunder, ist doch jetzt erst der "
    "Wolkenpalast entdeckt worden. Blue Menerde ist aber "
    "genauso ordentlich und gewissenhaft wie sein Bruder, "
    "wenn es um die Pflege des Palastgartens geht.");
  SetProp(P_NAME, "Blue Menerde");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  
  AddId(({ "blue menerde", "blue", "\nHIRIBLUE" }));
//  AddId("Peitschenmeister"); 
  create_default_npc(18);
  SetProp(P_HANDS, ({" mit seinen schwieligen Haenden." ,160, DT_RIP }) );
  SetProp(P_SIZE, 190 );
  SetProp(P_RACE, "Zwerg");
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,50);

  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "kommt herein und schnipselt sofort an einer Hecke");
  SetProp(P_MSGOUT, "ist fertig mit der Hecke und geht weiter");
  SetProp(P_MMSGIN, "erscheint mit klappernder Schere");
  SetProp(P_MMSGOUT, "laesst seine Schere weiter klappern und geht weiter");

  SetProp(P_DIE_MSG,  " Schnippschnappt nochmal mit seiner Schere vor Deiner Nase herum und stirbt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Das sag ich meinem Bruder. %s, Er raecht mich bestimmt.");

  SetProp(P_KILL_NAME, "Blue Menerde");
  SetProp(P_KILL_MSG, "Entschuldige, ich habe eben meine Schere geschaerft. SchnappSchnapp....!");


  
  SetProp(P_LOG_INFO, "hiri/garten.log");

    SetProp(P_MNPC_AREA, ({ROOM "pg1",
                         ROOM "pg2",
                         ROOM "pg3",
                         ROOM "pg4",
			 ROOM "pg5",
			 ROOM "pg6",
			 ROOM "pg7",
			 ROOM "pg8",
			 ROOM "pg9",
			 ROOM "pg10",
			 ROOM "pg11",
			 ROOM "pg12",
			 ROOM "pg13",
			 ROOM "pg14",
			 ROOM "pg15",
			 ROOM "pg16",
			 ROOM "pg17",
			 ROOM "pg18",
			 ROOM "pg19",
			 ROOM "pg20",
			 ROOM "pg21",
			 ROOM "pg22",
			 ROOM "pg23",
			 ROOM "quitte",
			 ROOM "schoki",
			 ROOM "eis",
			 ROOM "drow",
			 ROOM "kornell",
			 ROOM "schwefelblinks",
			 ROOM "schwefelbrechts",
			 ROOM "wiskey",
			 ROOM "gewaechshaus",
			 ROOM "wissensbaum",
                         ROOM "spalier"}));

  SetProp(P_MNPC_WAIT, ({ 20, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "spalier");


// SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS + MOV_MAYLOAD);
SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INCHAT + MOV_MAYLOAD);


  AddInfo(DEFAULT_INFO, "hat kaum Zeit mit Dir zu reden, "
                        "ueberwindet sich aber vielleicht doch, "
			"um ein wenig zu plaudern.\n");
  AddInfo("hiri",
    "Hiri ist wirklich gemein, wegen ihr muss ich hier Hecken schneiden.","sagt: ");
 
   AddInfo("blu Menerde",
    "Blu Menerde ist mein Bruder, er weis nicht wo ich mich aufhalte.","sagt: ");

   AddInfo("bruder",
    "Der heisst Blu Menerde und wohnt im Gebirge.","sagt: ");

   AddInfo("gebirge",
    "Das Gebirge ist eine Region des Silberlandes, es ist die Heimat "
    "der Zwerge.","sagt: ");

   AddInfo("region","regionen",
    "Es gibt mehrere Regionen im Silberland. Jetzt bist Du in der "
    "Region Luft. Es gibt noch sechzehn weitere Regionen.","sagt: ");

   AddInfo("silberland",
    "Du bist gerade in dem Silberland, es wurde von Dusty und Woody "
    "erschaffen. Viele Magier helfen den beiden es zu bebauen.","sagt: ");

   AddInfo("magier","helfer",
    "Magier sind die Helfer von Dusty und Woody.","sagt: ");

   AddInfo("hecken",
    "Eigentlich schneide ich gerne Hecken und kuemmer mich um den "
    "Palastgarten. Hiri ist trotzdem so gemein.","sagt: ");

   AddInfo("palastgarten",
    "Den halte ich in Ordnung, wenn Du eine Beschwerde hast, "
    "beschwere Dich bei Hiri.","sagt: ");

   AddInfo("beschwerde",
    "Tipp: beschwere bei Hiri.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Blue Menerde kann Deine Sachen bei seinem Tagewerk nicht brauchen.\n" }) );

  AddSpell(1,500,
     "Blue Menerde zerschnibselt Dich, als seist Du eine Hecke.\n",
     "Blue Menerde zerschnibselt @WEM wie eine Hecke.\n");


  SetChats(3, ({
    "Blue Menerde redet kaum bei seiner Arbeit.\n",
    "Blue Menerde ist in sein Werk vertieft....\n"}) );
  SetAttackChats(10, ({
    "Blue Menerde schnipselt aus Dir einen Vogel.\n",
    "Blue Menerde benutzt Dich als lebendes Kunstwerk.\n"}) );



/*  SUID;
  CLONEME(WEAPON "algenpeitsche" );
  command("zuecke algenpeitsche");
  if (random(100)>80) CLONEME(ARMOUR "monsterfell" );
  command("trage monsterfell");*/

AddCmd(  ({ "beschwere" }), "beschweren"  );
}




int beschweren(string str)
{
   notify_fail("Bei wem moechtest Du Dich beschweren?\n");

 if(!str || str == "") return 0;
 if(!(str=="bei hiri"))       
       return 0;

 write(BS("Du beschwerst Dich lauthals bei Hiri "
	  "ueber die unverantwortliche Situation.\n"));

 say(TPN+" meckert wie ein Schaf herum.\n");
    if ( find_call_out("fall1") == -1 )
      call_out("fall1",10);
    return 1;
  
}
void fall1()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write(BS( "Du beschwerst Dich immer noch als ploetzlich Hiri vor Dir steht."
	 "Sie haelt Dir eine Tasse Johannisbluetentee vor die Nase und Du "
	 "nimmst sie dankend entgegen. "));
  if ( find_call_out("fall2") == -1 )   
    call_out("fall2",10);
}
void fall2()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write (("Du trinkst den frisch gebruehten Tee und fuehlst Dich wirklich "
	  "wohl. Beschweren magst Du Dich auch nicht mehr. Alles ist wieder "
	  "gut.\n"
	  ) );
   say(
      TPN+" hat sich wieder beruhigt.\n");
    return ;
 
  
}




void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt Blue Menerde.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Blue Menerde hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

int _query_wimpy() { return 0; }


void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "redet beruhigend auf Dich ein.",
        "beruhigt Dich fluesternd.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "fluestert leise ein paar verwuenschungen auf Dich.",
        "verwuenscht Dich fluesternd.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert leise ueber Dich.",
        "kichert leise.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "wirft Gras nach Dir.",
        "wirft Gras nach Dir.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "schnipselt mit der Schere nahe Deiner Haare herum.",
        "schnipselt wild herum.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich guetig an.",
        "laechelt guetig.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "kuschelt Dich zaertlich zurueck.",
        "kuschelt Dich zaertlich.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "fluestert das ihm das sehr gefaellt.",
        "fluestert das ihm das sehr gefaellt.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        TP->Name(WER)+" wird von Blue Menerde getroestet.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
  
}

void tratsch_reaktion(string str)
{
   command("sag "+str);
   }

void catch_tell(string str)
{
  string was, dummy;

  if(InFight())       return;


  if(sscanf(str,"Morituretridet sagt: %s?%s",was, dummy)!=2
   &&sscanf(str,"Morituretridet sagt: %s.%s",was, dummy)!=2
   &&sscanf(str,"Morituretridet sagt: %s!%s",was, dummy)!=2)return;
  
//Ab hier werden nun die Saetze abgefragt, die Morituretridet sagt. 
//Die Saetze werden bis zum ersten Punkt, Ausrufezeichen oder Fragezeichen
//verglichen
   
      if(was=="Oh, Guten Tag Blue, wie geht es Dir")
      call_out("tratsch_reaktion",1,"Gut, danke der Nachfrage!");
      //ruft die Antwort auf und gibt den zu sagenden Text
    	  
      if(was=="Ein herrliches Wetter heute, nicht wahr?")
      call_out("tratsch_reaktion",1,"Ja, in der Tat, es koennte nicht besser sein!");
      //ruft die Antwort auf und gibt den zu sagenden Text

	  if(was=="Wenn die Magier bloss nicht immer alle so faul waeren")
      call_out("tratsch_reaktion",1,"Ach, wenigstens ein paar tun ja ihre Pflicht.");
	  //ruft die Antwort auf und gibt den zu sagenden Text

  return;
}

