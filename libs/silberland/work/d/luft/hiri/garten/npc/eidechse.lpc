
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Eidechse");
  SetProp(P_LONG,
    "Diese Eidechse ist giftgruen und schaut Dich genauso giftig an. "
    "Nimm Dich besser vor ihr in acht, wer weiss was sie alles kann.");
  SetProp(P_NAME, "Eidechse");
  SetProp(P_GENDER,  FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"eidechse", "echse"}));

  create_default_npc(5);
  SetProp(P_HANDS, ({" mit ihren Beinchen" , 50, DT_RIP }) );
  SetProp(P_SIZE, 30 );
  SetProp(P_RACE, "Echse");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_MMSGIN, "kommt aus dem Boden geflitzt");
  SetProp(P_MMSGOUT, "flitzt ins Erdreich und wart nicht mehr gesehen");
  SetProp(P_DIE_MSG,  " stiert Dich unglaeubig an und haucht ihr Leben aus.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "warts nur ab, DU, DU, Spieler DU!");
  SetProp(P_KILL_NAME, "Eidechse");
  SetProp(P_KILL_MSG, "Auch kleine sind manchmal ganz groooossss!");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("Hiri", "Hiri hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Eidechse will Deine Sachen nicht tragen.\n" }) );

  SetChats(3, ({
    "Die Eidechse zuengelt.\n",
    "Die Eidechse beisst Dich mit ihren Zaehnchen.\n"}) );
  SetAttackChats(10, ({
    "beisst Dich .\n"}) );

}





