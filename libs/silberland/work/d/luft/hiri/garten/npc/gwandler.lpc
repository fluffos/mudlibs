  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,40);

  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "kommt Gestaltwechselnd herein");
  SetProp(P_MSGOUT, "wechselt seine Gestalt und geht");
  SetProp(P_MMSGIN, "kommt herein geweht");
  SetProp(P_MMSGOUT, "jagd windig davon");

  SetProp(P_DIE_MSG,  " wechselt seine Gestalt in einer anderen Dimension.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Waere ich ein Balrog gewesen %s, Du haettest "
		        "keine Chance gehabt.");

  SetProp(P_KILL_NAME, "Morituretridet");
  SetProp(P_KILL_MSG, "Nun weist Du, was ich BIN!!!!"); 

  // andere SetProps(...) falls nötig





SetChats(3, ({
    "Morituretridet sagt: Blue Menerde ist mein Freund.\n",
    "Morituretridet sagt: Blue Menerde haelt den Palastgarten "
    "in Ordnung.\n"}) );

/*  SUID;
  CLONEME(OBJ "regenbogensch" );*/





  return "Wolkensturm"; // das geben wir zurueck, damit die Spieler sehen in was wir
                // uns verwandelt haben.
}

