void tratschen()
{
int i;
i = random(3); //bisher gibt es nur drei Gespraechsalternativen 

  //Falls Blue nicht mehr da ist
  if(!present("blue menerde", environment(TO))) return;
  
  if(i==1)command("sag Oh, Guten Tag Blue, wie geht es Dir?");
  else if(i==2)command("sag Ein herrliches Wetter heute, nicht wahr?");
  else command("sag Wenn die Magier bloss nicht immer alle so faul waeren...");
 }
  
void init()
{
  ::init();
//Ist eine Person mit dieser ID da, dann ruft er tratschen auf.
if (TP->id("\nHIRIBLUE")) call_out("tratschen",2);

}

