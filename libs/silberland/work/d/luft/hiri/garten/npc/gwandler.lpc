string Elf();
string Zwerg(); 
string Mensch();
string Wattebausch();
string Zauberer();
string Hobbit();
string Babydrache();
string Feline();
string Wolkensturm();
string Zombie();
string Skelett();


// Fragen an Blue :)
string *tratschen = ({
	               "Wie wird das Wetter?",
		       "Schoener Tag heute, oder?"
		     });

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Morituretridet, der Gestaltenwandler");
  SetProp(P_LONG,
    "Morituretridet, ist nicht zu beschreiben. Er ist ungewoehnlich und "
    "wandelt sich nach belieben.");
  SetProp(P_NAME, "Morituretridet");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));

  AddId(({"morituretridet", "gestaltenwandler", "wandler","\nHIRIMORI"}));

  create_default_npc(35);
  
  SetProp(P_HANDS, ({" mit seinen Haenden." ,150, DT_RIP }));
  SetProp(P_SIZE, 180 );
  SetProp(P_RACE, "Gestaltenwandler");
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,40);
  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "kommt gestaltwechselnd herein");
  SetProp(P_MSGOUT, "wechselt seine Gestalt und geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "verschwindet einfach");

  SetProp(P_DIE_MSG,  " wechselt seine Gestalt in einer anderen Dimension.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Moritur et ridet? %s, Ich sterbe und "
		        "lache dabei.");

  SetProp(P_KILL_NAME, "Morituretridet");
  SetProp(P_KILL_MSG, "Nun weist Du, was ich BIN!!!!");

  SetProp(P_LOG_INFO, "hiri/garten.log");
  
  SetProp(P_MNPC_AREA, ({ROOM "pg1",
                         ROOM "pg2",
                         ROOM "pg3",
                         ROOM "pg4",
			 ROOM "pg5",
			 ROOM "pg6",
			 ROOM "pg7",
			 ROOM "pg8",
			 ROOM "pg9",
			 ROOM "pg10",
			 ROOM "pg11",
			 ROOM "pg12",
			 ROOM "pg13",
			 ROOM "pg14",
			 ROOM "pg15",
			 ROOM "pg16",
			 ROOM "pg17",
			 ROOM "pg18",
			 ROOM "pg19",
			 ROOM "pg20",
			 ROOM "pg21",
			 ROOM "pg22",
			 ROOM "pg23",
			 ROOM "quitte",
			 ROOM "schoki",
			 ROOM "eis",
			 ROOM "drow",
			 ROOM "kornell",
			 ROOM "schwefelblinks",
			 ROOM "schwefelbrechts",
			 ROOM "wiskey",
			 ROOM "gewaechshaus",
			 ROOM "wissensbaum",
                         ROOM "spalier"}));

  SetProp(P_MNPC_WAIT, ({ 20, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "spalier");
// SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS + MOV_MAYLOAD);
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INCHAT);
  SetProp(P_MNPC_ACTIVE_TIME, 400);
  
  AddInfo(DEFAULT_INFO, "redet nicht mit Dir.\n");
 
  SetChats(3, ({
    "Morituretridet sagt: Blue Menerde ist mein Freund.\n",
    "Morituretridet sagt: Blue Menerde haelt den Palastgarten "
    "in Ordnung.\n"}) );

  call_out("change", 60); // Nach 10 minuten wechseln
}

void change()
{
  string s;

 if(!is_clone(TO)) return; // Nur tun, wenn ich ein clone bin
  if(InFight(TO))
    {
	  call_out("change", 60);
      return;
	  }
  

  switch(random(11)) //zufaellige rasse auswaehlen
  {
    case 1: s = Elf(); break; 
    case 2: s = Zwerg(); break; 
    case 3: s = Wattebausch(); break;
    case 4: s = Zauberer(); break;
    case 5: s = Hobbit();break;
    case 6: s = Babydrache();break;
    case 7: s = Feline();break;
    case 8: s = Wolkensturm();break;
    case 9: s = Zombie();break;
    case 10: s = Skelett();break;
    default: s = Mensch(); break; 
  }

  // Fuer Spieler im Raum gibts noch eine nette Meldung
  if(ENV(TO))
    tell_room(ENV(TO), BS(TO->Name()+" verwandelt sich in einen "+s+"."));
  
  call_out("change", 60);
}

//hier werden wir zum elf
string Elf()
{
  SetProp(P_SHORT, "Morituretridet, der Elfenprinz");
  SetProp(P_LONG,
    "Morituretridet, ist ein wunderschoener Elfenprinz. Er hat "
    "lange dunkle Haare und traegt ein weisses Gewand.");

  SetProp(P_ARTICLE, 0);

  RemoveId(({"elf", "morituretridet", "gestaltenwandler", "wandler",
		"\nHIRIMORI"}));
  AddId(({ "morituretridet", "gestaltenwandler", "wandler",
	   "elf","\nHIRIMORI"}));
  AddClass(CL_ELF);

  create_default_npc(35);

  SetProp(P_HANDS, ({" mit seinen Haenden." ,150, DT_RIP }) );
  SetProp(P_SIZE, 170+random(20) );
  SetProp(P_RACE, "Gestaltenwandler");
  SetProp(P_ALIGN, 400);
  SetProp(P_MAX_HANDS, 2);

  return "Elf"; // das geben wir zurueck, damit die Spieler sehen in was wir
                // uns verwandelt haben.
}

