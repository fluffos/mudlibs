void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt Morituretridet.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Morituretridet hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

int _query_wimpy() { return 0; 
}

void catch_tell(string str)
{
  string who, what;
  object room;


  if(!(room=ENV(TO))) return;
  if(InFight())       return;


  
  if(sscanf(str,"Blue Menerde sagt: Morituretridet ist mein Freund.", who, what)==1)
  {

    what = what[0..<1];

    tell_room(room, "Morituretridet sagt: "+what+".\n", ({ TO }) );
  }

  return;
}
