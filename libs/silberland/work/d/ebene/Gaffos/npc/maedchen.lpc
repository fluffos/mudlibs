inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>
#include "../gaffos.h"

#define AREA ROOM("")

void create() {
    if (!is_clone(this_object())) return;  // (return on BP)

    ::create();

    AddId(({"kuckeline", "maedchen", "gaffomaedchen"}));
    SetProp(P_NAME, "Kuckeline");
    SetProp(P_SHORT, "Kuckeline, das neugierige Gaffomaedchen");
    SetProp(P_LONG, "Kuckeline ist ein quirliges Gaffomaedchen mit leuchtenden Augen "
                    "und einem verschmitzten Laecheln. Sie scheint immer auf der Suche nach "
                    "abenteuerlichen Geschichten oder spannenden Geheimnissen zu sein.");
    SetProp(P_GENDER, FEMALE);
    SetProp(P_RACE, "Gaffo");
    SetProp(P_ALIGN, 200);
    SetProp(P_SIZE, 150);
    SetProp(P_ARTICLE, 0);

    create_default_npc(10);

    SetProp(P_MSGIN, "huepft herein");
    SetProp(P_MSGOUT, "rennt davon");
    SetProp(P_MMSGIN, "erscheint mit einem lauten Lachen");
    SetProp(P_MMSGOUT, "verschwindet mit einem froehlichen Winken");

    SetProp(P_DEFAULT_INFO, "fragt: Hast Du etwas Interessantes gesehen?");

    AddInfo(({"dorf", "platz"}), 
        "Ich liebe es, durch das Dorf zu laufen und die Leute zu beobachten!", "sagt: ");
    AddInfo(({"gaffos", "gaffomaedchen"}), 
        "Wir Gaffos sind immer neugierig und lieben Abenteuer!", "ruft: ");
    AddInfo("abenteuer", 
        "Abenteuer? Ich finde immer etwas Spannendes zu tun!", "schmunzelt: ");
    AddInfo(({"geschichte", "geschichten"}),
        "Kannst du mir eine spannende Geschichte erzaehlen?", "fragt: ");

    SetChats(5, ({
        "Kuckeline ruft: 'Wer hat spannende Geschichten fuer mich?'\n",
        "Kuckeline huepft aufgeregt umher.\n",
        "Kuckeline gafft dich neugierig an.\n",
        "Kuckeline ruft: 'Ich will etwas Spannendes erleben!'\n",
        "Kuckeline sagt: 'Die Welt ist so gross und aufregend!'\n"
    }));

    SetProp(P_MNPC_AREA, ROOM(""));
    SetProp(P_MNPC_WAIT, ({10 + random(20), 90, 120}));
    SetProp(P_MNPC_DEFAULTROOM, AREA + "markt");
    SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);
    
    AddCmd("erzaehle|erzaehl&maedchen|kuckeline|gaffomaedchen&geschichte", "cmd_erzaehlen", "Wem willst du was erzaehlen?");
}

public int cmd_erzaehlen() {
    write(BS("Du erzaehlst "+name(WEM)+" von deinen wildesten Abenteuern.\n"));
    tell_room(ENV(TO), BS(TPN+" erzaehlt "+name(WEM)+" wilde Abenteuergeschichten.\n"), ( {TP}));
    command_me("sag Wow! Das hast du alles erlebt?!");

    if(TP->QueryProp(P_RACE) != "Gaffo" || present("\nPROtheG_Racetool", TP)) return 1;

    command_me("sage Danke fuer diese tolle Geschichte! Als Dank hast du hier das Monokel meines Gaffoopas. "
               "Das kann voll praktisches Zeug fuer Gaffos!");

    clone_object("/p/service/protheg/rt/obj/gaffobrille")->move(TP, M_NOCHECK);

    write(BS("Du nimmst das Monokel dankend an Dich."));

    return 1;
}

void InformDefend(object enemy) {
    command_me("schrei: Hilfe! Jemand greift mich an!");
    ::InformDefend(enemy);
}
