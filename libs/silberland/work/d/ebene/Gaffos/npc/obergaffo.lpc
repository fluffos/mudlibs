inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../gaffos.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  // Allgemeine Eigenschaften
  SetProp(P_SHORT, "Obergaffo Blinz");
  SetProp(P_LONG,
    "Obergaffo Blinz ist eine mythische Gestalt unter den Gaffos. Seine riesigen, "
    "bernsteinfarbenen Augen scheinen alles zu durchdringen, und er wirkt immer "
    "leicht spoettisch. Gekleidet in einen improvisierten Umhang aus Blaettern und "
    "Federn, ist er ein wandelndes Symbol fuer die scheue Neugier seiner Rasse.");
  SetProp(P_NAME, "Blinz");
  SetProp(P_GENDER, MALE);
  AddId(({"gaffo", "blinz", "obergaffo"}));

  SetProp(P_RACE, "Gaffo");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -50);
  SetProp(P_ARTICLE, 0);

  create_default_npc(35);

  // Kampf- und Verhaltenseigenschaften
  SetProp(P_HANDS, ({" mit seinen Haenden", 20, DT_BLUDGEON}));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 5); // Regeneration ueber Zeit
  SetProp(P_AGGRESSIVE, 0); // Friedlich, greift nicht ohne Grund an
  SetProp(P_WIMPY, 20); // Fluchtwahrscheinlichkeit bei niedrigem Leben
  SetProp(P_NOMAGIC, 1); // Nicht anfaellig fuer Magie

  SetProp(P_RESISTANCE_STRENGTHS, 
    ([DT_FIRE:      0.1, DT_COLD:      0.1, DT_WATER:  0.2, DT_AIR:    0.1, 
      DT_LIGHTNING: 0.1, DT_EXPLOSION: 0.0, DT_SOUND:  0.3, DT_LIGHT:  0.2,
      DT_ELECTRIC:  0.1, DT_ACID:      0.0, DT_POISON: 0.5, DT_TERROR: 0.4,
      DT_HOLY:      -0.2, DT_UNHOLY:  -0.2, DT_MAGIC:  0.0, DT_MIND:   0.6]) );

  // Nachrichten
  SetProp(P_MSGIN, "kommt aus dem Unterholz hervor.");
  SetProp(P_MSGOUT, "verschwindet im Gebuesch.");
  SetProp(P_MMSGIN, "erscheint ploetzlich mit einem breiten Grinsen.");
  SetProp(P_MMSGOUT, "zieht sich schelmisch zurueck.");
  SetProp(P_DIE_MSG, "Blinz gibt ein keckerndes Lachen von sich und faellt zu Boden.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MURDER_MSG, "Ich komme wieder – und ich werde gaffen!");
  SetProp(P_KILL_NAME, "Blinz");
  SetProp(P_KILL_MSG, "Du haettest keine Chance gegen meine Augen gehabt!");

  // Standardaktionen
  SetChats(3, ({
    "Blinz starrt Dich neugierig an.\n",
    "Blinz murmelt: 'Interessant... sehr interessant.'\n",
    "Blinz beobachtet Dich mit einem spoettischen Grinsen.\n",
    "Blinz raet dir: 'Wenn du staerker werden willst, versuch dich im Obsthain im Sueden des Dorfs!'\n",
    "Blinz reibt sich die Augen.\n",
    "Blinz meint: 'blitz' ist ein nuetzlicher Zauber, wenn du etwas im Dunklen sehen willst.\n",
    "Blinz raet: 'schaetz' deine Gegner bevor du sie angreifst um boese Ueberraschungen zu vermeiden!\n",
    "Blinz murmelt: Wenn ich 'identifiziere' besser koennte, wuerde ich mehr magische Gegenstaende finden.\n",
    "Blinz meint: Du koenntest ein paar Abenteuer erleben!\n"
  }));

  SetAttackChats(10, ({
    "Blinz ruft: 'Was Gaffst Du?!'\n",
    "Blinz wirft vergorene Fruechte in Deine Richtung.\n",
    "Blinz lacht hysterisch und schlaegt mit seinem Ast zu.\n",
    "Blinz laesst einen hellen Blitz entstehen.\n",
    "Blinz weicht deinem Angriff aus\n",
    "Blinz wird ganz rasend vor Wut.\n",
    "Blinz trinkt einen Heiltrank.\n"
  }));

  // Faehigkeiten
  SetProp(P_SPELLRATE, 30);

  // Zauber und Spezialangriffe
  AddDefaultSpell(2, 300, DS_BLIND,
    "Blinz blinzelt ploetzlich, und ein gleissender Lichtblitz blendet Dich.\n",
    "Blinz blinzelt ploetzlich, und ein gleissender Lichtblitz blendet seine Gegner.\n");

  AddDefaultSpell(1, 200, DS_PARALYZE
    "Blinz ruft: 'Was Gaffst Du?!' und starrt Dich mit seinen riesigen Augen an. Du kannst Dich nicht bewegen!\n",
    "Blinz ruft: 'Was Gaffst Du?!' und starrt seine Gegner an. Sie wirken gelaehmt.\n"
  );

  AddDefaultSpell(3, 350, DS_MASS_DAMAGE
    "Blinz wirft eine Handvoll vergorener Fruechte auf Dich. Sie explodieren mit einem widerlichen Gestank!\n",
    "Blinz wirft vergorene Fruechte auf seine Gegner. Die Explosion hinterlaesst eine klebrige Spur.\n",
    DT_ACID);

  AddSpell(3, 250,
    "Blinz bruellt ein kehliges Lachen, das Dich mit Angst erfuellt!\n",
    "Blinz bruellt ein kehliges Lachen, und seine Gegner zittern vor Angst.\n",
    DT_TERROR, ([SP_SHOW_DAMAGE: 1]));

  AddDefaultSpell(1, 400, DS_POISON,
    "Blinz zueckt einen improvisierten Blasrohr und schiesst kleine vergiftete Dornen auf Dich!\n",
    "Blinz feuert mehrere vergiftete Dornen auf seine Gegner.\n"
  );

  // Ausruestung
  CLONEME("/p/weapon/club/kampfstab");
  command("zuecke stab");
  CLONEME("/p/armour/cloak/umhang");
  command("trage umhang");

  AddInfo("gaffos", 
  "Die Gaffos sind eine scheue, aber unglaublich neugierige Rasse von Ureinwohnern "
  "des Silberlands. Sie verbringen ihre Zeit meist versteckt im Unterholz und beobachten "
  "alles um sich herum mit ihren grossen, glitzernden Augen.\n", 
  "erklaert: ");

AddInfo("ernaehrung", 
  "Gaffos lieben vergorene Fruechte und alkoholische Getraenke. Tatsaechlich scheinen sie "
  "sogar immun gegen normale Alkoholvergiftungen zu sein, obwohl sie im Rausch aeusserst "
  "aggressiv und unberechenbar werden koennen.\n", 
  "berichtet mit einem schelmischen Laecheln: ");

AddInfo("augen", 
  "Die riesigen, bernsteinfarbenen Augen der Gaffos sind nicht nur ihr Markenzeichen, "
  "sondern auch der Schluessel zu ihrer beeindruckenden Beobachtungsgabe. Sie sehen selbst "
  "die kleinsten Details und bemerken Gefahren, die anderen entgehen wuerden.\n", 
  "erklaert stolz: ");

AddInfo("kultur", 
  "Die Kultur der Gaffos ist stark von Neugier gepraegt. Sie sammeln Objekte, die sie interessant "
  "finden, und bewahren sie in versteckten Nestern auf. Oft haben sie jedoch keine praktische "
  "Verwendung fuer diese Dinge – es geht ihnen nur darum, sie zu besitzen.\n", 
  "erzaehlt: ");

AddInfo("verhalten", 
  "Gaffos vermeiden direkte Konfrontationen und ziehen es vor, sich im Hintergrund zu halten. "
  "Doch wenn sie sich bedroht fuehlen, koennen sie ueberraschend aggressiv reagieren, insbesondere "
  "wenn sie zuvor Alkohol konsumiert haben.\n", 
  "warnt mit erhobenem Finger: ");

AddInfo("legenden", 
  "Es gibt viele Geschichten ueber die Gaffos, insbesondere ueber Obergaffo Blinz, der angeblich "
  "die maechtigsten Augen unter ihnen besitzt. Man sagt, er koenne mit einem Blick Feinde erstarren "
  "lassen.\n", 
  "erzaehlt mit einem wissenden Laecheln: ");

AddInfo("silberland", 
  "Die Gaffos haben sich perfekt an das Leben im Silberland angepasst. Sie bauen Nester hoch "
  "in den Baeumen oder tief im Unterholz und meiden offene Flaechen, wo sie leicht entdeckt werden koennten.\n", 
  "erlaeutert: ");

AddInfo("hilfe",
  "Wenn du hilfreich willst, dann sieh dir das schwarze Brett daussen an.", "sagt: ");

AddInfo("midas",
  "Midas ist die Stadt der Menschen und das Zentrum des Silberlands. Wenn du das Dorf nach Norden hin "
  "verlaesst, halte dich immer nach Westen und du kannst die Stadt nicht verfehlen!", "erklaert: ");

AddInfo(({"hain", "obsthain"}),
  "Wenn du dich ein wenig im Kaempfen ueben willst, dann kannst du die Landplagen im Obsthain verpruegeln. "
  "Aber pass auf, dort lauert irgendwo ein Goblin!", "meint: ");

AddInfo(({"goblin"}),
  "Sieh mal am schwarzen Brett nach. Irgendwo im Obsthain versteckt sich ein Goblin, der unsere Fruechte "
  "stibizt. Ich denke, er ist sehr gefaehrlich.", "gruebelt: ");

AddInfo(({"zauber", "faehigkeiten"}),
  "Du kannst hier Zauber und neue Faehigkeiten erlernen. Tippe <lerne> und sieh dir an, was du alles erlernen kannst.", "sagt: ");

AddInfo(({"abenteuer", "quests", "aufgaben"}),
  "Im Silberland gibt es viele Abenteuer zu erleben. Tippe <liste> und sieh dir an, was du tun koenntest.", "sagt: ");

}

