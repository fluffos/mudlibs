inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../gaffos.h"

create()
{
  object geld;
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein alter Bettler");
  SetProp (P_LONG, bs("Der alte Bettler scheint schon ziemlich muede "+
    "zu sein. Das bisschen Geld, das er bei sich hat, hat er wohl "+
    "im Laufe der Zeit von Besuchern erbettelt."));
  SetProp (P_NAME, "Bettler");
  SetProp (P_GENDER, MALE);
  AddId ("bettler");
  create_default_npc (3);
  SetProp (P_SIZE, 155+random(20));
  SetProp (P_MSGIN, "schlurft herein");
  SetProp (P_ALIGN, 50);
  SetProp (P_XP, 15000);
  SUID;
  CLONEME (OBJ("waffe/messer"));
  command ("zuecke messer");
  geld = clone_object ("/obj/money");
  geld->move(ME);
  geld->AddAmount(50+random(50));
  SetProp (P_REJECT, ({ REJECT_KEEP,
    "Der Bettler freut sich und bedankt sich hoeflich.\n" }) );
  AddInfo (DEFAULT_INFO, "Davon weiss ich leider nichts. Aber hast Du "+
    "vielleicht ein bisschen Geld fuer mich?", "sagt: ");
}

give_notify(object ob)
{
  int ga;
  //write (file_name(ob)+"\n");
  if ((explode(file_name(ob), "#")[0]=="/obj/money") &&
     (ga=ob->QueryProp(P_GIVEN_AMOUNT)) >= 100)
  {
    write ("Der Bettler jubelt: \"Uih, "+ga+" Muenzen!\"\n");
    return 1;
  }
  else
    return ::give_notify(ob);
}
