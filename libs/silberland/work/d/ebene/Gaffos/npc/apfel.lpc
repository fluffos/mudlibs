inherit "std/food";
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <food.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create(({"essen", "iss"}));
  
  SetProp(P_SHORT, "Ein roter Apfel");
  SetProp(P_LONG,
   "Ein saftiger, roter Apfel, dessen Haut glaenzt und im Sonnenlicht verlockend aussieht. "
   "Er ist frisch und einladend, mit einem suessen Duft, der die Sinne betoert. Der Apfel "
   "verspricht, koestlich und erfrischend zu sein.\n");
  SetProp(P_VALUE, 50);
  SetProp(P_WEIGHT, 150);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Apfel");
  SetProp(P_MATERIAL, ({MAT_WOOD, MAT_FRUIT}));
  
  AddId(({"apfel", "roter apfel", "frucht"}));
 
  SetProp(P_FOOD_INFO, ([F_HEAL: ({5, 5}), // Geringe Heilung
     F_DRINK: 0,                          // Kann nicht getrunken werden
     F_ALCOHOL: 0,                        // Kein Alkoholgehalt
     F_VERB: "essen",
     F_MSG: "Du beisst in den Apfel. Der suesse Saft fliesst dir den Hals hinab und hinterlaesst "
           +"ein erfrischendes Gefuehl.\n",
     F_MSG_ROOM: "isst einen Apfel und sieht zufrieden aus.\n"
  ]));
}
