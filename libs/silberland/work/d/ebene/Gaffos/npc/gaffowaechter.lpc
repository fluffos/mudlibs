/*
** Ein Gaffowaechter  (w) Woody@SL
** ---
** 1996-09-24  1.0  Release
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>

#include "../gaffos.h"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ("gaffo");
  AddId ("gaffowaechter");
  AddId ("waechter");
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Gaffowaechter");
  SetProp (P_SHORT, "Ein Gaffowaechter");
  SetProp (P_LONG, bs("Der Gaffowaechter versieht hier seinen Dienst. "+
    "Streng mustert er Dich - hoffentlich hast Du nichts angestellt! "+
    "Er scheint naemlich keinen Spass zu verstehen..."));
  SetProp (P_ALIGN, random(100)-200);
  create_default_npc (20);
  SetProp(P_ATTRIBUTES_OFFSETS,
    (["con":random(10),"dex":random(10),"int":random(10),"str":10+random(10)]) );
  SetProp (P_MAX_HP, 400+random(100));
  SetProp (P_HP, QueryProp(P_MAX_HP));
  SetProp (P_MAX_SP, 200);
  SetProp (P_XP, QueryProp(P_HP)*1000);
  SetProp (P_BODY, 50+random(20));
  SetProp (P_SIZE, 190+random(30));
  SetProp (P_RACE, "gaffo");
  SetProp (P_MAX_HANDS, 4);
  SetProp (P_FOOD, 0);
  SetProp (P_HANDS, ({" mit seinen Klauen", 250, DT_BLUDGEON}) );
  SUID;

  // Ausruestung
  CLONEME (OBJ("ruestung/gaffoumhang"));
  command ("trage umhang");
  CLONEME (OBJ("waffe/gaffoschwert"));
  command ("zuecke schwert");
  CLONEME (OBJ("ruestung/gaffohelm"));
  command ("trage helm");

  SetProp(P_SPELLRATE, 20);

  AddSpell(10,250,
    "Der Gaffowaechter versetzt Dir einen kraeftigen Schlag.\n",
    "Der Gaffowaechter versetzt @WEM einen kraeftigen Schlag.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );
  AddSpell(5,350,
    "Der Gaffowaechter schlaegt Dir den Schaedel ein.\n",
    "Der Gaffowaechter schlaegt @WEM den Schaedel ein.\n",
    DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]) );
  AddSpell(2,500,
    "Der Gaffowaechter murmelt einige magische Worte.\n"+
    "Ploetzlich schiesst ein Blitz aus seinen Augen und trifft Dich hart.\n",
    "Der Gaffowaechter murmelt einige magische Worte.\n"+
    "Ploetzlich schiesst ein Blitz aus seinen Augen und trifft @WEN hart.\n",
    DT_LIGHTNING, ([SP_SHOW_DAMAGE:1]) );

  SetChats(5, ({
    "Der Gaffowaechter gafft Dich eindringlich an.\n",
    "Der Gaffowaechter mustert die Umgebung.\n",
    "Der Gaffowaechter marschiert auf und ab.\n",
    "Der Gaffowaechter murmelt: 'Wenn ich den finde...!'.\n",
    "Der Gaffowaechter zieht eine Bierflasche hervor, trinkt sie mit einem\n"+
    "Schluck leer und wirft die Flasche in hohem Bogen wieder von sich.\n",
    "Der Gaffowaechter durchwuehlt Deine Taschen.\n" }) );

  SetAttackChats(6, ({
    "Der Gaffowaechter pruegelt wie wildgeworden auf Dich ein.\n",
    "Der Gaffowaechter schreit vor Wut wie verrueckt.\n",
    "Der Gaffowaechter tritt Dich vor lauter Wut.\n",
    "Der Gaffowaechter gafft Dich entgeistert an.\n"}) );

  SetProp (P_DEFAULT_INFO, "zuckt mit den Schultern.\n");
  AddInfo ( ({"gaffo", "gaffowaechter"}), "schreit Dich an: \"Gut erkannt! "
    "Und jetzt hau ab!\"\n");
  AddInfo ("gaffos", "sagt: \"Ich bin einer davon!\"\n");
  AddInfo ("gaffowaechter",
    "schreit Dich an: \"Gut erkannt! Und jetzt hau ab!\"\n");
  AddInfo ("felben", "murmelt nur irgendwas von 'tragisch' und 'Unglueck'...\n");
  AddInfo ("unglueck",
    "Ja, das war wirklich tragisch damals... die Familie Felben, eine der "
    "aeltesten unseres Volkes lebte im Suedwesten unseres Dorfes in einem "
    "praechtigen Haus, bis, ja bis eines Tages durch bisher ungeklaerte "
    "Umstaende das Haus in Flammen aufging, und in ihm die ganze Familie "
    "ums Leben kam... Man munkelt, dass ein Pyromane an allem schuld sei, "
    "aber Beweise gibt es bis heute keine.", "erzaehlt: ");
  AddInfo ("haus",
    "Ja, Haeuser gibts hier einige. Das schoenste stand einst im "
    "Suedwesten des Dorfes, wo jetzt nur noch verfallene Reste "
    "uebrig sind...", "sagt: ");
  AddInfo ( ({"flammen", "feuer"}), "zuckt zusammen.\n");
  AddInfo ("familie",
    "Du fragst mich nach meiner Familie? Ach, der gehts eigentlich ganz "
    "gut, denke ich... aber... nein, ich glaube eher, Du willst mehr "
    "ueber die Familie Felben wissen... Achja, das war ein Unglueck "
    "damals...", "sagt: ");
  AddInfo ("beweise",
    "Nicht nur, dass es keine Beweise gibt... nein, auch der Pyromane "
    "selbst ist bis heute noch nicht gefasst worden! Vielleicht kannst "
    "Du ihn ja ausfindig machen... aber es waere ganz gut, wenn Du "
    "vorher mit Gulk sprechen wuerdest, dem Weisen des Dorfes!",
    "meint: ");
  AddInfo ( ({"gulk", "weisen"}), "Der wohnt irgendwo im Wohnviertel "
    "in einem alten Haus.", "sagt: ");
  AddInfo ("wen", "antwortet: Na den Pyromanen such ich!\n");
  AddInfo ( ({"pyromane", "pyromanen"}),
    "Den Pyromanen, der fuer das Unglueck der Familie Felben verantwortlich "
    "ist!", "sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Gaffowaechter rafft alles gierig an sich.\n" }) );

  SetProp (P_MNPC_AREA, ROOM("weg"));
  SetProp (P_MNPC_WAIT, ({ 10+random(20), 30, 50 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM("weg_h2"));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);
}

void wandern()
{
  mixed a;
  int i;
  if (!(::wandern())) return 0;		// nur wenn in neuen Raum gekommen
  if (present("leiche", environment())) // iss erste Leiche
    command("iss leiche");
  i=sizeof(all_inventory());
  command("nimm alles");                // ARGL, das liefert *immer* != 0  :-(
  if (i != sizeof(all_inventory()))     // drum dieser Hack
  {
    say("Der Gaffowaechter sagt: Oh, so schoene Sachen!\n");
    i=sizeof(QueryProp(P_ARMOURS));
    command("trage alles");     // ARGL, das liefert im Erfolgsfall NULL :-(
    if (i != sizeof(QueryProp(P_ARMOURS)))      // drum dieser Hack
    {
      say("Der Gaffowaechter sagt: Und kleidsam sind sie auch noch!\n");
      say("Der Gaffowaechter freut sich.\n");
    }
  }
}
