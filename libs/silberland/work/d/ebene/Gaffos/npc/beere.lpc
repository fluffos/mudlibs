inherit "std/food";
#include <language.h>
#include <properties.h>
#include <food.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create(({"essen", "iss", "beere"}));
  
  SetProp(P_SHORT, "Eine saftige Beere");
  SetProp(P_LONG,
   "Eine kleine, rote Beere, die saftig und reif aussieht. Ihr Duft ist fruchtig und "
   "verlockend. Beim Beissen entfaltet sich ein suesser Geschmack, der angenehm im Mund bleibt.\n");
  SetProp(P_VALUE, 5);
  SetProp(P_WEIGHT, 30);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Beere");
  SetProp(P_MATERIAL, ({MAT_PLANT, MAT_FRUIT}));
  
  AddId(({"beere", "rote beere", "saftige beere", "frucht", "fruechtchen"}));
 
  SetProp(P_FOOD_INFO, ([F_HEAL: ({5, 5}), // Geringe Heilung
     F_VERB: "essen",
     F_MSG: "Du beisst in die saftige Beere. Der suesse Geschmack breitet sich in Deinem Mund "
           +"aus und Du fuehlst Dich erfrischt.\n",
     F_MSG_ROOM: "beisst in eine Beere und scheint sich erfrischt zu fuehlen.\n"
  ]));
}
