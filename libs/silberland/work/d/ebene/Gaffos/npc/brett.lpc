#include "../gaffos.h"

inherit "std/thing";

#include <properties.h>

private string *messages;
private string relevant_message;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  // Anschlaege definieren
  messages = ({
    "Es wird eine Versammlung aller Gaffos morgen Abend abgehalten. Alle sind eingeladen.",
    "Die midasianische Post hat neue Auftraege zur Befoerderung von Waren. Bewerbungen sind willkommen.",
    "Achtung! Ein Goblin wurde im Obsthain gesehen. Wer ihn findet und den Wachen gefesselt uebergibt, erhaelt eine Belohnung von 500 Muenzen.",
    "Der Alchemist in Derlim sucht dringend nach Kraeutern.",
    "Die Dorftore werden heute Nacht geschlossen, um die Sicherheit zu gewaehrleisten. Keine Durchfahrt moeglich."
  });

  // Relevante Nachricht setzen
  relevant_message = messages[2]; // Die dritte Nachricht ist die relevante

  SetProp(P_SHORT, "Ein schwarzes Brett");
  SetProp(P_LONG,
    "Auf dem schwarzen Brett befinden sich einige Anschlaege. Du kannst einen der Anschlaege mit 'lies anschlag <nr>' lesen.\n"
    "-----------------------------------------------------------\n"
    "1. Versammlung der Gaffos\n"
    "2. Postauftraege zur Warenbefoerderung\n"
    "3. Goblin im Obsthain - Belohnung!\n"
    "4. Kraeuter fuer den Alchemisten\n"
    "5. Schliessung der Dorftore\n"
    "-----------------------------------------------------------\n"
  );
  SetProp(P_INFO, "Ein schwarzes Brett mit verschiedenen Anschlaegen.");
  SetProp(P_NAME, "schwarzes Brett");
  SetProp(P_GENDER, NEUTER);
  AddId("brett");
  AddId("schwarzes brett");

  SetProp(P_MATERIAL, MAT_WOOD);
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOGET, "Das schwarze Brett ist fest im Boden verankert.\n");

  AddCmd(({"lies", "lese", "les"}), "cmd_lies");
}

// Funktion, um einen bestimmten Anschlag zu lesen
int cmd_lies(string str) {
  int index;

  notify_fail("Welchen Anschlag willst du lesen?\n");
  
  if (!str || sscanf(str, "anschlag %d", index) != 1 || index < 1 || index > sizeof(messages)) {
    notify_fail("Bitte gib eine gueltige Zahl ein, um einen Anschlag zu lesen (1-5).\n");
    return 0;
  }
  
  write("Du liest den Anschlag:\n" + BS(messages[index - 1]) + "\n");
  say(BS(TPN+" liest einen Anschlag am schwarzen Brett."));

  // Wenn es ein uninteressanter Anschlag ist, fuege die Gedanken hinzu
  if (index != 3) {  // Die dritte Nachricht (Goblin) ist relevant
    TP->command_me("denke Das ist aber uninteressant");
  } else {
    TP->command_me("denke Aha! Dem sollte ich nachgehen!");
  }

  return 1;
}
