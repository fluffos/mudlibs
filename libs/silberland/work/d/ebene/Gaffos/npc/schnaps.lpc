inherit "std/food";
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <food.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create(({"trink", "trinke"}));
  
  SetProp(P_SHORT, "Eine Flasche Gaffoschnaps");
  SetProp(P_LONG,
   "Eine elegante, kristallklare Flasche, gefuellt mit dem legendaeren Gaffoschnaps. "
   "Das Getraenk strahlt ein warmes Leuchten aus und hat eine dickfluessige, "
   "leicht schimmernde Konsistenz. Dieser Schnaps ist beruechtigt fuer seinen "
   "unverwechselbaren Geschmack und seine unvorhersehbaren Nebenwirkungen.\n");
  SetProp(P_VALUE, 500);
  SetProp(P_WEIGHT, 200);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Flasche");
  SetProp(P_MATERIAL, ({MAT_GLASS, MAT_ALCOHOL}));
  
  AddId(({"flasche", "schnaps", "gaffoschnaps", "schnapsflasche", "\ngaffo_quest_drink"}));
 
  SetProp(P_FOOD_INFO, ([F_HEAL: ({10, 10}), // Geringe Heilung, steigert Alkoholwert
     F_DRINK: 5,                           // Kann in 5 Schlucken getrunken werden
     F_ALCOHOL: 20,                         // Erhoeht die Trunkenheit spuerbar
     F_VERB: "trinken",
     F_MSG: "Du nimmst einen tiefen Schluck des Gaffoschnapses. Die komplexe Mischung "
           +"aus Frucht und Feuer laesst Dir den Atem stocken. Dein Kopf beginnt leicht "
           +"zu schwirren, und Du fuehlst Dich irgendwie unaufhaltbar.\n",
     F_MSG_ROOM: "nimmt einen Schluck Gaffoschnaps und wirkt kurzzeitig unbesiegbar.\n"
  ]));
}
