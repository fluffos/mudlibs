inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../gaffos.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "eine Eule mit der Beule");
  SetProp(P_LONG,
    "Diese Eule sieht ziemlich mitgenommen aus. Auf ihrem Kopf prangt eine grosse Beule, "
    "die sie wohl von einem ungluecklichen Zusammenstoss mit einem Ast oder etwas Aehnlichem "
    "hat. Trotz ihrer Verletzung scheint sie freundlich und harmlos zu sein.");
  SetProp(P_NAME, "Eule mit der Beule");
  SetProp(P_GENDER, FEMALE);
  AddId(({"eule", "beule", "eule mit der beule"}));

  create_default_npc(5);
  SetProp(P_HANDS, ({"mit ihren kleinen Krallen", 5, DT_SLASH}));
  SetProp(P_RACE, "Eule");
  SetProp(P_SIZE, 50);
  SetProp(P_WEIGHT, 1500);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 2);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 80);
  SetProp(P_NOMAGIC, 1);
  SetProp(P_RESISTANCE_STRENGTHS, 
    ([DT_BLUDGEON: -0.5, DT_SLASH: 0.2, DT_COLD: 0.1, DT_FIRE: 0.0]));

  SetProp(P_MSGIN, "flattert heran");
  SetProp(P_MSGOUT, "flattert davon");
  SetProp(P_MMSGIN, "erscheint mit einem sanften Fluegelschlag");
  SetProp(P_MMSGOUT, "verschwindet mit einem leisen Fluegelschlag");

  SetProp(P_DIE_MSG, "faellt mit einem leisen Plumps zu Boden.");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MURDER_MSG, "Uhu... das war gemein...");
  SetProp(P_KILL_NAME, "tapfere Eule");
  SetProp(P_KILL_MSG, "Die Eule kaempft bis zum Schluss, obwohl sie schwach ist.");

  AddInfo(DEFAULT_INFO, "Die Eule schaut Dich mit grossen Augen an.");

  SetProp(P_REJECT, ({ REJECT_DROP,
    "Die Eule will keine fremden Dinge tragen." }));

  SetProp(P_SPELLRATE, 0);

  SetChats(3, ({
    "Die Eule guckt Dich mit grossen, fragenden Augen an.\n",
    "Die Eule schuettelt sich vorsichtig, um ihre Beule nicht zu beruehren.\n",
    "Ein leises'Uhu...' entweicht der Eule.\n",
  }));

  SetAttackChats(5, ({
    "Die Eule flattert aufgeregt um Dich herum!\n",
    "Die Eule stoesst ein wuetendes 'Uhu!' aus.\n",
  }));

  SUID;

  AddCmd("verarzte|verarzt|hilf|helfe|heile|heil|behandle|behandel&eule", "cmd_varzten", "Wen willt du verarzten?");
}

public int cmd_varzten() {
    write(BS("Kunstvoll verbindest du die Beule der Eule."));
    say(BS(TPN+" verbindet die Beule der Eule kunstvoll."));
    command_me("emote dankt mit einem lauten 'Schuuuu - Huh!' und flattert davon.");
    call_out("remove", 0, 1);
    return 1;
}

public void reset() {
    if(!is_clone(TO)) return;
    ::reset();
    tell_room(ENV(TO), BS("Die Eule flattert davon."));
    remove(1);
    return;
}