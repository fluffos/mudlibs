inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../gaffos.h"
#include "/d/ebene/woody/q/felben/quest.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Gustav, der haarige Gaffowirt");
  SetProp(P_LONG, "Dieser haarige Gaffo-Wirt sieht immer geschaeftig aus. Mit einem "
                  "breiten Laecheln und energischen Bewegungen scheint er seine Aufgaben "
                  "zu lieben. Sein Fell ist leicht zerzaust, und seine grossen Augen "
                  "beobachten alles aufmerksam, waehrend er mit viel Engagement "
                  "Schnitzel klopft.");
  SetProp(P_NAME, "Gustav");
  SetProp(P_GENDER, MALE);
  AddId(({"gaffo", "wirt", "gaffowirt", "gustav"}));

  create_default_npc(18);
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Gaffo");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 150000);
  SetProp(P_ALIGN, 100);
  SetProp(P_HANDS, ({ " mit seinem Schnitzelklopfr", 200, DT_BLUDGEON }));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN, "kommt hereingetappt");
  SetProp(P_MSGOUT, "geht hinaus");
  SetProp(P_MMSGIN, "erscheint mit einem zufriedenen Laecheln");
  SetProp(P_MMSGOUT, "verschwindet pfeifend");

  SetProp(P_DIE_MSG, " kippt zur Seite und verliert seinen Schnitzelhammer.");
  SetProp(P_NOCORPSE, 0);

  SetChats(5, ({
    "Gustav klopft energisch ein Schnitzel.\n",
    "Gustav murmelt: 'Ein gutes Schnitzel braucht Hingabe.'\n",
    "Gustav schaut sich um und grinst: 'Wer hat Hunger?'\n",
    "Mit einem lauten Klopfen bearbeitet Gustav ein Stueck Fleisch.\n",
    "Gustav pfeift ein froehliches Lied, waehrend er ein Schnitzel wendet.\n",
    "Gustav ruft: 'Die besten Schnitzel der Welt gibt's hier!'\n",
    "Gustav wischt sich die Stirn und sagt: 'So, das naechste Schnitzel ist fast fertig.'\n"
  }));

  SetAttackChats(10, ({
    "Gustav ruft: 'Meine Schnitzel sind besser als dieser Kampf!'\n",
    "Gustav schimpft: 'Ihr werdet mein Schnitzelhammer zu spueren bekommen!'\n"
  }));

  CLONEME("/p/armour/cloak/schuerze");
  command("trage alles");

  AddInfo(DEFAULT_INFO, "Gustav schaut Dich mit seinen grossen Augen an und sagt: 'Red nicht in Raetseln, ich hab hier zu tun!'\n");
  AddInfo("schnitzel", "Das beste Essen der Welt! Moechtest Du eins probieren?", "sagt: ");
  AddInfo("bier", "Ah, Gaffo-Bier! Das staerkt die Seele und den Koerper.", "sagt: ");
  AddInfo("schnaps", "Ein guter Gaffo-Schnaps? Nichts geht ueber den selbstgebrannten! Ich hab sogar noch eine letzte Flasche ueber.", "sagt: ");
  AddInfo("gaffo", "Wir Gaffos lieben gutes Essen, guten Schnaps und ein froehliches Leben!", "sagt: ");
  AddInfo("essen", "Hier gibt es die besten Schnitzel weit und breit! Alles frisch geklopft.", "sagt: ");
  AddInfo("trinken", "Ein guter Gaffo trinkt immer mehr, als er essen kann!", "sagt: ");
  AddInfo("magie", "Magie? Das Zeug interessiert mich nicht. Ich bleibe bei meinen Schnitzeln!'", "sagt: ");
  AddInfo("zeit", "Fuer Schnitzel ist immer Zeit!", "sagt: ");
  AddInfo("zufluchtsort", "Dieser Ort ist perfekt, um dem Alltag zu entkommen und gut zu essen.", "sagt: ");
  AddInfo("silberland", "Die besten Gaffos und die besten Schnitzel gibt's hier im Silberland!", "sagt: ");
  AddInfo(({"flasche", "letzte falsche", "schnapsflasche"}), 
    "Hm. Wenn ich es recht ueberlege wuerde ich mich dafuer trennen. Wenn du mir einen mir wichtigen Gegenstand besorgst.", "gruebelt: ");
  AddInfo(({"gegenstand", "wichtigen gegenstand", "frau", "bild"}),
    "Ich hatte einmal ein Bild meiner Frau als sie noch jung war. Leider habe ich das irgendwo verbummelt. "
    "Wenn du es mir bringst, gebe ich dir einen Schnaps dafuer.", "sagt: ");

}

void give_notify(object ob) {
  object schnaps;

  if(ob->id(ZEICHNUNG_ID)) {
    if(!ob->QueryProp("smooth")) {
      command_me("sag Was soll ich mit dem Wisch? Ist ja kaum zu erkennen was das ist, so zerknittert wie es ist.");
      if(ob->move(TP) != 1) {
        ob->move(ENV(TO));
        command_me("emote wirft die Zeichnung weg.");
      }
      return;
    }

    command_me("sag Ah! Ja. Das ist meine Frau!");
    command_me("emote gibt dir im Austausch eine Flasche Gaffoschnaps.");
    schnaps = clone_object(NPC("schnaps"));
    if(schnaps->move(TP) != 1) {
      command_me("emote wirft die Flasche auf den Boden.");
      schnaps->move(ENV(TO));
    }
    ob->remove(1);
    return;
  }

  ::give_notify(ob);
  return;
}
