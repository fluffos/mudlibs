** 1996-04-22  1.0  Release
** 1996-09-21  1.1  Modifiziert + ausgeruestet
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>

#include "../gaffos.h"

create()
{
  object ob;
  int i;

  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ("gaffo");
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Gaffo");
  SetProp (P_SHORT, "Ein Gaffo");
  SetProp (P_LONG, bs("Der Gaffo funkelt Dich boese an. Er ist ein Gaffo "+
    "mittlerer Groesse, wie sie hier zu Dutzenden hier herumlaufen. "+
    "Bestimmt hat er einige Freunde, es koennte also sein, dass Du "+
    "bald die ganze Sippschaft am Hals hast, wenn Du Dich mit diesem "+
    "Exemplar anlegst."));
  SetProp (P_ALIGN, random(100)-150);	// -50 .. -150
  create_default_npc(12);
  SetProp (P_LEVEL, 12);
  SetProp (P_MAX_HP, 220+random(100));
  SetProp (P_HP, QueryProp(P_MAX_HP));
  SetProp (P_MAX_SP, 200);
  SetProp (P_XP, QueryProp(P_HP)*1000);
  SetProp (P_BODY, 30+random(20));
  SetProp (P_SIZE, 170+random(30));
  SetProp (P_RACE, "gaffo");
  SetProp (P_MAX_HANDS, 4);
  SetProp (P_HANDS, ({" mit seinem Wuergegriff", 200, DT_BLUDGEON}) );
  SUID;

  // Ausruestung
  i=random(16);
  if (i&1) {
    CLONEME ("/p/weapon/club/keule");
    command ("zuecke keule");
  }
  else
  {
    CLONEME ("/p/weapon/spear/speer");
    command ("zuecke speer");
  }
  if (i&2) {
    CLONEME (OBJ("ruestung/loech_umhang"));
    command ("trage umhang");
  }
  if (i&4) {
    CLONEME (OBJ("ruestung/gaffohelm"));
    command ("trage helm");
  }
  if (i&8) {
    CLONEME ("/p/armour/shield/holzschild");
    command ("trage schild");
  }
  ob = CLONEOB ("/obj/money");
  ob->SetProp(P_AMOUNT, 50+random(150));
  ob->move(ME);

  SetProp(P_SPELLRATE,15);

  AddSpell(1,250,
    "Der Gaffo versetzt Dir einen maechtigen Schlag.\n",
    "Der Gaffo versetzt @WEM einen maechtigen Schlag.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  SetChats(5, ({
    "Der Gaffo gafft Dich eindringlich an.\n",
    "Der Gaffo mustert die Umgebung.\n",
    "Der Gaffo marschiert auf und ab.\n",
    "Der Gaffo murmelt: 'Wenn ich den finde...!'.\n",
    "Der Gaffo zieht eine Bierflasche hervor, trinkt sie mit einem Schluck\n"
    "leer und wirft die Flasche in hohem Bogen wieder von sich.\n",
    "Der Gaffo kontrolliert Deine Taschen.\n" }) );

  SetAttackChats(6, ({
    "Der Gaffo pruegelt wie wildgeworden auf Dich ein.\n",
    "Der Gaffo schreit vor Wut wie verrueckt.\n",
    "Der Gaffo tritt Dich vor lauter Wut.\n",
    "Der Gaffo gafft Dich entgeistert an.\n"}) );

  SetProp (P_DEFAULT_INFO, "zuckt mit den Schultern.\n");
  AddInfo ("gaffo", "schreit Dich an: \"Gut erkannt! Und jetzt hau ab!\"\n");
  AddInfo ("gaffos", "sagt: \"Ich bin einer davon!\"\n");
  AddInfo ("felben", "murmelt nur irgendwas von 'tragisch' und 'Unglueck'...\n");
  AddInfo ("unglueck",
    "Ja, das war wirklich tragisch damals... die Familie Felben, eine der "
    "aeltesten unseres Volkes lebte im Suedwesten unseres Dorfes in einem "
    "praechtigen Haus, bis, ja bis eines Tages durch bisher ungeklaerte "
    "Umstaende das Haus in Flammen aufging, und in ihm die ganze Familie "
    "ums Leben kam... Man munkelt, dass ein Pyromane an allem schuld sei, "
    "aber Beweise gibt es bis heute keine.", "erzaehlt: ");
  AddInfo ("haus",
    "Ja, Haeuser gibts hier einige. Das schoenste stand einst im "
    "Suedwesten des Dorfes, wo jetzt nur noch verfallene Reste "
    "uebrig sind...", "sagt: ");
  AddInfo ( ({"flammen", "feuer"}), "zuckt zusammen.\n");
  AddInfo ("familie",
    "Du fragst mich nach meiner Familie? Ach, der gehts eigentlich ganz "
    "gut, denke ich... aber... nein, ich glaube eher, Du willst mehr "
    "ueber die Familie Felben wissen... Achja, das war ein Unglueck "
    "damals...", "sagt: ");
  AddInfo ("beweise",
    "Nicht nur, dass es keine Beweise gibt... nein, auch der Pyromane "
    "selbst ist bis heute noch nicht gefasst worden! Vielleicht kannst "
    "Du ihn ja ausfindig machen... aber es waere ganz gut, wenn Du "
    "vorher mit Gulk sprechen wuerdest, dem Weisen des Dorfes!",
    "meint: ");
  AddInfo ( ({"gulk", "weisen"}), "Der wohnt irgendwo im Wohnviertel "
    "in einem alten Haus.", "sagt: ");
  AddInfo ("wen", "antwortet: Na den Pyromanen such ich!\n");
  AddInfo ( ({"pyromane", "pyromanen"}),
    "Den Pyromanen, der fuer das Unglueck der Familie Felben verantwortlich "
    "ist!", "sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Gaffo rafft alles gierig an sich.\n" }) );

  SetProp (P_MNPC_AREA, ROOM("weg"));
  SetProp (P_MNPC_WAIT, ({ 10+random(20), 50, 90 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM("weg_h2"));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);
}

void wandern()
{
  int i;
  if (!(::wandern())) return 0;
  i=sizeof(all_inventory());
  command("nimm alles");	        // ARGL, das liefert *immer* != 0  :-(
  if (i != sizeof(all_inventory()))	// drum dieser Hack
  {
    say("Der Gaffo sagt: Oh, so schoene Sachen!\n");
    i=sizeof(QueryProp(P_ARMOURS));
    command("trage alles");	// ARGL, das liefert im Erfolgsfall NULL :-(
    if (i != sizeof(QueryProp(P_ARMOURS)))	// drum dieser Hack
    {
      say("Der Gaffo sagt: Und kleidsam sind sie auch noch!\n");
      say("Der Gaffo freut sich.\n");
    }
  }
}
