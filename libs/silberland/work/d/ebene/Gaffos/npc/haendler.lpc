inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../gaffos.h"
#include "/d/ebene/woody/q/felben/quest.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Gullbert Glotz, der kraeuselige Ladenbesitzer");
  SetProp(P_LONG, "Gullbert Glotz ist ein alter Gaffo mit einer kraeuseligen Maehne, die sich wie "
                  "ein wilder Kranz um seinen Kopf legt. Seine grossen, glaenzenden Augen scheinen "
                  "immer alles genau zu beobachten. Trotz seines Alters wirkt er lebendig und "
                  "gut gelaunt, waehrend er mit seinen dicken Fingern Waren sortiert und freundlich "
                  "mit Kunden plaudert.");
  SetProp(P_NAME, "Gullbert");
  SetProp(P_GENDER, MALE);
  AddId(({"gaffo", "haendler", "kraemerladen", "gullbert", "glotz", "\ngaffo_haendler"}));

  create_default_npc(15);
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Gaffo");
  SetProp(P_SIZE, 175);
  SetProp(P_WEIGHT, 140000);
  SetProp(P_ALIGN, 50);
  SetProp(P_HANDS, ({ " mit einem alten Gehstock", 150, DT_BLUDGEON }));
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN, "schlurft gemaechlich herein");
  SetProp(P_MSGOUT, "schlurft langsam hinaus");
  SetProp(P_MMSGIN, "erscheint mit einem zufriedenen Laecheln");
  SetProp(P_MMSGOUT, "verschwindet murmelnd");

  SetProp(P_DIE_MSG, "kippt vornüber.");
  SetProp(P_NOCORPSE, 0);

  SetChats(5, ({
    "Gullbert sortiert mit einem kritischen Blick ein paar Waren.\n",
    "Gullbert murmelt: 'Ach ja, diese jungen Leute heutzutage...'\n",
    "Gullbert ruft: 'Wer braucht gute Ware? Hier gibt's alles!\n'",
    "Mit bedachten Bewegungen wischt Gullbert eine Glasvitrine ab.\n",
    "Gullbert grinst und sagt: 'Frische Ware, nur das Beste!'\n",
    "Gullbert glaenzt mit seiner Weisheit: 'Ein guter Handel beginnt mit einem guten Laecheln!'\n"
  }));

  SetAttackChats(3, ({
    "Gullbert brüllt: 'Haende weg von meinen Waren, du Gauner!'\n",
    "Gullbert fuchtelt mit seinem Kraemerstock: 'Du wirst lernen, mich zu respektieren!'\n",
    "Herr Glotz haut dir auf die Finger.\n",
    "Gullbert Glotz schreit: HAU AB DU LADENDIEB!\n"
  }));

  CLONEME("/p/armour/cloak/pelzmantel");
  command("trage alles");

  AddInfo(DEFAULT_INFO, "Gullbert schaut Dich aufmerksam an und sagt: 'Du suchst etwas Bestimmtes? Fragen kostet nichts!'");
  AddInfo("waren", "Ich habe alles, was das Herz begehrt. Schau dich um!", "sagt: ");
  AddInfo(({"kraemerladen", "laden"}), "Hier findest du nützliche Alltagsgegenstaende und kleine Schaetze.", "sagt: ");
  AddInfo(({"handeln", "handel"}), "Ein guter Handel ist wie eine Freundschaft: er muss gepflegt werden!", "sagt: ");
  AddInfo("gaffo", "Die Gaffos sind ein stolzes Volk mit einem Sinn für das Schoene im Kleinen.", "sagt: ");
  AddInfo(({"alt", "alter"}), "Alt? Ich bin erfahren, das ist alles!", "lacht: ");
  AddInfo("kunde", "Ein guter Kunde kommt immer wieder!", "nickt: ");

}
