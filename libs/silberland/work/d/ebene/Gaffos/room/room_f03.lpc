#include <properties.h>
#include <moving.h>

#include "../gaffos.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Gaffos/room/"+x)
#endif

int eule;

inherit "std/room";

void create()
{
  ::create();
  eule = 1;
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN: TT_ROAD]));
  SetProp (P_INT_SHORT, "Weg entlang einer Palisade");
  SetProp (P_INT_LONG,
    "Du gehst auf einem kleinen unbefestigten Weg eine Palisade entlang. "+
    "Hier scheinen nur sehr selten Lebewesen vorbeizukommen, der Weg ist "+
    "schon ziemlich verkommen, und Du hast Muehe, nicht zu stolpern, aber "+
    "gluecklicherweise ist er ziemlich eben.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"holzpfaehle", "palisade", "pfaehle"}),
    "Die Palisade im Osten besteht aus sorgfaeltig zusammengefuegten "+
    "Holzpfaehlen, die oben spitz zugeschnitten sind, sodass Dir ein "+
    "Ueberklettern absolut unmoeglich ist.");
  AddDetail ( ({"boden", "weg"}),
    "Du stehst auf einem kleinen ziemlich unwegsamen Weg, der entlang der "+
    "Palisade von Norden nach Sueden fuehrt. Hoffentlich stolperst Du "+
    "nicht!");
  AddDetail ( ({"lebewesen"}),
    "Du kannst ausser Dir hier keine ausmachen.");

    AddDetail("himmel", "Der Himmel ist wolkenverhangen, die Luft fuehlt sich feucht an.");
    AddDetail("muehe", "Der Weg ist zwar eben, doch an manchen Stellen immer noch ein wenig holprig.");
    AddDetail("ueberklettern", "Die Palisade ist zu hoch und mit scharfen Spitzen versehen, ein Ueberklettern ist unmoeglich.");
    AddDetail("luft", "Die Luft ist feucht und riecht nach frischem Holz.");
   AddDetail("spitzen", "Die Palisade ist mit scharfen, spitzen Holzpfaehlen bestueckt, ein Ueberklettern ist unmoeglich. Eine Spitze ist komisch.");
  AddDetail("stellen", "Obwohl der Weg hier recht eben ist, gibt es immer noch einige unebene Stellen, an denen man stolpern koennte.");
  AddSpecialDetail("spitze", "d_eule");
  AddDetail("holz", "Das Holz aus dem Wald hier.");
  AddDetail("wald", "Weiter noerdlich ist ein Wald.");
    
  // DETAILS END

  // EXITS START
  AddExit ("sueden", ROOM("room_f04"));
  AddExit ("norden", ROOM("room_f02"));
  // EXITS END

  // ITEMS START
  // ITEMS END

}

public string d_eule() {
  if(eule) {
    call_out("clone_eule", 0);
    return "Da ist ja eine Eule!\n";
  }

  return "Hm. War doch nichts. Vielleicht spaeter?\n";
}

public void clone_eule() {
  object e;
  if(!eule) return;
  eule = 0;

  e = clone_object(NPC("eule"));
  if(e->move(TO, M_GO) != 1) {
    destruct(e);
    eule = 1;
  }
  return;
}
