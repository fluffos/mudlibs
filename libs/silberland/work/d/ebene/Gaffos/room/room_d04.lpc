#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Gaffos/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf einem Feldweg");
  SetProp (P_INT_LONG,
    "Du folgst dem schmalen Feldweg unbeirrt weiter, da Du eigentlich "+
    "genug von der oeden Landschaft hast und gerne mal was neues sehen "+
    "wuerdest. Doch irgendwie hast Du das Gefuehl als ob es noch eine "+
    "kleine Weile dauern wuerde, bis Du endlich wieder auf etwas Leben "+
    "stoesst.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"himmel", "sonne"}),
    "Strahlend blauer Himmel ueber Dir, und mitten in ihm die helle "+
    "Sonne.");
  AddDetail ( ({"boden", "feldweg", "pfad", 
                "weg"}),
    "Der Boden unter Dir ist ziemlich erdig und relativ naturbelassen.");
  AddDetail ( ({"erde"}),
    "Sie bildet die Grundlage fuer den Boden unter Dir.");
  AddDetail ( ({"leben"}),
    "Leben ist die Seinsform von Organismen, wie jedes halbwegs gebildete "+
    "Lexikon weiss.");
  AddDetail ( ({"organismen", "seinsform"}),
    "Einzelheiten findest Du in jedem besseren Lexikon, aber nicht hier.");
  AddDetail ( ({"lexikon"}),
    "Ein Lexikon ist ein Buch, das Erlaeuterungen zu Fachbegriffen "+
    "beinhaltet, welche das Buch in alphabetischer Anordnung enthaelt.");
  AddDetail ( ({"anordnung", "buch", "erlaeuterung", 
                "erlaeuterungen", "fachbegriff", "fachbegriffe"}),
    "Das ist jetzt bestimmt nicht weiter wichtig...");
  AddDetail ( ({"gefuehl"}),
    "Gefuehl setzt Leben voraus.");
  AddDetail ( ({"landschaft"}),
    "Sie ist oed, oed, oooooed. Sie ist WAEH !!");
  // DETAILS END

  // EXITS START
  AddExit("suedwesten", ROOM("room_c05"));
  AddExit ("osten", ROOM("room_e04"));
  // EXITS END

  // ITEMS START
  // ITEMS END

}
