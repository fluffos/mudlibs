#include "../gaffos.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Im Obsthain der Gaffos" );
  SetProp( P_INT_LONG,
    "Du befindest dich hier in einem kleinen Obsthain. Kleine aber kraeftige "
    "Obstbaeume stehen um dich herum. Froehlich summen Insekten zwischen den "
    "Blueten umher. Im Norden befindet sich die Palisade des Gaffodorfs." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  // Details
  AddDetail("atmosphaere", 
    "Die Atmosphaere ist ruhig und friedlich, erfuellt vom Summen der Insekten und dem Duft der Natur.\n");
  AddDetail("bienen", 
    "Die Bienen fliegen geschaeftig von Bluete zu Bluete, sammeln fleissig Pollen.\n");
  AddDetail("boden", 
    "Der Boden ist mit weichem Gras bedeckt, das in saftigem Gruen leuchtet.\n");
  AddDetail("duft", 
    "Ein angenehmer, suesser Duft von reifen Fruechten und Blueten liegt in der Luft.\n");
  AddDetail("farben", 
    "Der Hain leuchtet in einem Farbenmeer aus Gruen, Gelb und Rosa.\n");
  AddDetail("fruechte", 
    "Die Fruechte der Obstbaeume sind saftig und in verschiedenen Farben zu sehen.\n");
  AddDetail("fruechten", 
    "Die Fruechte haengen schwer an den Zweigen und verstrahlen einen verlockenden Duft.\n");
  AddDetail("fruehlingsmorgen", 
    "Die Szenerie erinnert an einen klaren Fruehlingsmorgen, voller Leben und frischer Luft.\n");
  AddDetail("gaffos", 
    "Die Gaffos, die hier leben, lieben diese Gegend und pflegen sie mit Sorgfalt.\n");
  AddDetail("hain", 
    "Der Hain ist ein kleiner, friedlicher Ort, perfekt zum Verweilen und Entspannen.\n");
  AddDetail("himmel", 
    "Der Himmel ist klar und strahlend blau, nur hier und da von kleinen Wolken verziert.\n");
  AddDetail("holzpfaehlen", 
    "Die Holzpfaehle der Palisade sind robust und mit Schutzzaubern der Gaffos versehen.\n");
  AddDetail("insekten", 
    "Viele kleine Insekten schwirren umher und tragen zum Leben in diesem Hain bei.\n");
  AddDetail("laute", 
    "Aus der Ferne dringen die sanften Laute von plaudernden Gaffos an dein Ohr.\n");
  AddDetail("luft", 
    "Die Luft ist frisch und riecht nach Blueten und reifen Fruechten.\n");
  AddDetail("natur", 
    "Die Natur hier ist unberuehrt und strahlt Ruhe und Frieden aus.\n");
  AddDetail("ort", 
    "Dieser Ort strahlt Ruhe und Frieden aus, ein kleines Paradies mitten in der Natur.\n");
  AddDetail("paradies", 
    "Der Hain ist wie ein kleines Paradies voller Blueten und summender Insekten.\n");
  AddDetail("palisade", 
    "Die Palisade im Norden schuetzt das Dorf der Gaffos vor Gefahren.\n");
  AddDetail("rascheln", 
    "Ein leises Rascheln der Blaetter begleitet den sanften Wind.\n");
  AddDetail("schutz", 
    "Die Palisade bietet Schutz vor ungebetenen Gaesten, doch hier im Hain ist alles ruhig.\n");
  AddDetail("summen", 
    "Das Summen der Insekten schafft eine beruhigende Hintergrundmelodie.\n");
  AddDetail("tiere", 
    "Neben Insekten sind auch einige Voegel zu hoeren, die im Hain Zuflucht finden.\n");
  AddDetail("wind", 
    "Ein leichter Wind weht durch den Hain und bewegt sanft die Blaetter und Zweige.\n");
  AddDetail("zweigen", 
    "Die Zweige der Obstbaeume tragen sowohl Blueten als auch reife Fruechte.\n");

  // Smells
  AddSmell(DEFAULT_SMELL, 
    "Ein suesser, angenehmer Duft von reifen Fruechten und Blueten erfuellt die Luft.\n");
  AddSmell("luft", 
    "Die Luft riecht frisch und natuerlich, voller Blumenduft und Fruechten.\n");
  AddSmell("fruechte", 
    "Die Fruechte verstroemen einen suessen und verlockenden Duft.\n");
  AddSmell("blueten", 
    "Die Blueten duften zart und frisch, wie ein Fruehlingsmorgen.\n");
  AddSmell("boden", 
    "Der Boden riecht nach feuchtem Gras und Erde, durchzogen von Blumenduft.\n");

  // Sounds
  AddSound(DEFAULT_SOUND, 
    "Das Summen der Insekten und das leise Rascheln der Blaetter erfuellen den Hain.\n");
  AddSound("summen", 
    "Das Summen der Insekten klingt beruhigend und ist ueberall im Hain zu hoeren.\n");
  AddSound("rascheln", 
    "Das leise Rascheln der Blaetter wird durch den sanften Wind hervorgerufen.\n");
  AddSound("wind", 
    "Ein sanftes Rauschen begleitet den leichten Wind, der durch den Hain zieht.\n");
  AddSound("laute", 
    "Aus der Ferne dringen gelegentlich die Laute von Gaffos, die miteinander sprechen.\n");
  AddSound("vogelgezwitscher", 
    "Das froehliche Zwitschern von Voegeln mischt sich in die natuerlichen Geraeusche des Hains.\n");


    AddDetail("blaetter", "Die Blaetter rascheln sanft im Wind und leuchten in verschiedenen Gruentoenen.\n");
    AddDetail("blumenduft", "Der Duft der Blumen ist suess und frisch, ein wahrer Fruehlingsbote.\n");
    AddDetail("dorf", "Das Gaffodorf liegt im Norden, geschuetzt von der Palisade.\n");
    AddDetail("entspannen", "Der Ort eignet sich hervorragend zum Entspannen, weit weg von jeglicher Hektik.\n");
    AddDetail("erde", "Der Boden ist weich und feucht, reich an Leben und frischer Erde.\n");
    AddDetail("farbenmeer", "Ein Farbenmeer aus Gruentoenen, Gelb und Rosa fuellt den Hain und verleiht ihm ein lebendiges Aussehen.\n");
    AddDetail("frieden", "Der Frieden hier ist greifbar, nichts stoert die Ruhe des Hains.\n");
    AddDetail("gaffodorfs", "Das Gaffodorf ist ein friedlicher Ort, geschuetzt von der Palisade im Norden.\n");
    AddDetail("gefahren", "Der Hain ist ein sicherer Ort, die Palisade schuetzt vor Gefahren von aussen.\n");
    AddDetail("gegend", "Diese Gegend ist ruhig und idyllisch, ein Ort der Entspannung und des Wohlbefindens.\n");
    AddDetail("gelb", "Die Blaetter und Blueten leuchten in sanften Gelbtoenen und bringen Farbe in den Hain.\n");
    AddDetail("gras", "Das Gras unter deinen Fuessen ist weich und frisch, perfekt zum Verweilen.\n");
    AddDetail("gruen", "Das saftige Gruen der Baeume und des Grases erfuellt den Raum mit Leben.\n");
    AddDetail("hintergrundmelodie", "Das Summen der Insekten und das Rascheln der Blaetter bilden eine beruhigende Hintergrundmelodie.\n");
    AddDetail("leben", "Das Leben im Hain pulsiert in jeder Ecke, von den Insekten bis zu den Voegeln.\n");
    AddDetail("obstbaeume", "Die Obstbaeume tragen ueppige Blueten und Fruechte, die den Hain praegen.\n");
    AddDetail("obsthain", "Der Obsthain ist ein kleiner, idyllischer Ort, der von Obstbaeumen und Blumen gepraegt ist.\n");
    AddDetail("rauschen", "Der Wind rauscht sanft durch die Blaetter und Zweige der Baeume.\n");
    AddDetail("rosa", "Die Blueten und Fruechte strahlen in einem sanften Rosaton.\n");
    AddDetail("ruhe", "Die Ruhe hier ist tief, unterbrochen nur von den sanften Geraeuschen der Natur.\n");
    AddDetail("sorgfalt", "Die Gaffos pflegen diese Gegend mit grosser Sorgfalt und Hingabe.\n");
    AddDetail("szenerie", "Die Szenerie ist bezaubernd, mit einem klaren Blick auf den Hain und den blauen Himmel.\n");
    AddDetail("verweilen", "Dieser Ort laedt zum Verweilen und Geniessen der Ruhe ein.\n");
    AddDetail("wolken", "Der Himmel ist groesstenteils klar, aber hier und da ziehen sanfte Wolken vorueber.\n");
    AddDetail("zweige", "Die Zweige der Baeume biegen sich unter dem Gewicht der reifen Fruechte.\n");
    
    AddDetail("aussehen", "Das Aussehen des Hains ist ein perfektes Bild von Natur, Farben und Leben.\n");
AddDetail("baeume", "Hohe Baeume, deren Zweige sanft im Wind wiegen, bieten Schatten und Ruhe.\n");
AddDetail("blick", "Der Blick reicht ueber die weite Flaeche des Hains bis hin zur Palisade des Gaffodorfs.\n");
AddDetail("blumen", "Bunte Blumen bluehen ueberall, ihre Farben verschoenern den Hain.\n");
AddDetail("ecke", "In der Ecke des Hains ist ein ruhiger Platz, ideal zum Verweilen.\n");
AddDetail("entspannung", "Der Hain ist ein Ort der Entspannung, weit entfernt von der Hektik des Alltags.\n");
AddDetail("farbe", "Die Farben der Blumen und Baeume verleihen dem Hain eine lebendige Atmosphaere.\n");
AddDetail("fruehlingsbote", "Die Blueten und das sanfte Summen der Insekten kuendigen den Fruehling an.\n");
AddDetail("fuessen", "Das weiche Gras unter deinen Fuessen fuehlt sich angenehm an.\n");
AddDetail("gaffodorf", "Das Gaffodorf liegt im Norden, geschuetzt durch die Palisade.\n");
AddDetail("gelbtoenen", "Gelbtoene dominieren hier, sowohl in den Blueten als auch in den Blaettern.\n");
AddDetail("geniessen", "Hier laesst sich die Ruhe und Schoenheit der Natur in vollen Zuegen geniessen.\n");
AddDetail("geraeuschen", "Das Rauschen der Blaetter und das Summen der Insekten fuellen die Luft.\n");
AddDetail("gewicht", "Das Gewicht der Fruechte laesst die Zweige der Baeume sanft nach unten biegen.\n");
AddDetail("gruentoenen", "Das satte Gruen der Baeume und des Grases sorgt fuer eine beruhigende Atmosphaere.\n");
AddDetail("hektik", "Die Hektik der Welt ist hier weit entfernt, im Hain herrscht Stille.\n");
AddDetail("hingabe", "Die Gaffos pflegen diesen Hain mit viel Hingabe und Liebe zum Detail.\n");
AddDetail("raum", "Der Raum ist weit und offen, mit viel Platz fuer Entspannung und Erholung.\n");
AddDetail("rosaton", "Die Blueten strahlen in einem sanften Rosaton, der den Hain verziert.\n");
AddDetail(({"voegeln", "voegel"}), "Voegel singen froehlich in den Baeumen, ihre Melodien sind ueberall zu hoeren.\n");
AddDetail("wohlbefindens", "Der Hain foerdert das Wohlbefinden, dank seiner Ruhe und Naturverbundenheit.\n");
AddDetail("alltags", "Der Alltag ist hier weit entfernt, nur Ruhe herrscht.\n");
AddDetail("bild", "Der Hain wirkt wie ein lebendiges Bild.\n");
AddDetail("detail", "Jedes Detail traegt zur Schoenheit bei.\n");
AddDetail("erholung", "Der Hain ist ideal zum Erholen.\n");
AddDetail("flaeche", "Der Hain bietet viel Platz zum Verweilen.\n");
AddDetail("fruehling", "Der Fruehling liegt in der Luft.\n");
AddDetail("liebe", "Die Gaffos pflegen diesen Hain mit Liebe.\n");
AddDetail("melodien", "Die Melodien der Voegel vermischen sich mit dem Rascheln der Blaetter.\n");
AddDetail("naturverbundenheit", "Der Hain zeigt die Naturverbundenheit der Gaffos.\n");
AddDetail("platz", "Es gibt reichlich Platz zum Entspannen.\n");
AddDetail("schatten", "Die Baeume spenden angenehmen Schatten.\n");
AddDetail("schoenheit", "Der Hain ist voller Schoenheit.\n");
AddDetail("stille", "Stille wird nur durch das Summen der Insekten unterbrochen.\n");
AddDetail("welt", "Hier scheint die Zeit stillzustehen.\n");
AddDetail("wohlbefinden", "Der Hain foerdert das Wohlbefinden.\n");
AddDetail("zuegen", "Die Zweige wiegen sich im Wind.\n");



  AddExit("westen", ROOM("ap_i07"));
  AddExit("osten", ROOM("ap_k07"));
  AddExit("sueden", ROOM("ap_j08"));

  AddItem("/d/ebene/Park/npc/ameise", REFRESH_DESTRUCT);
}
