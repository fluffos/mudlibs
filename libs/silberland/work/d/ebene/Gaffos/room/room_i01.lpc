#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Gaffos/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Weg entlang einer Palisade");
  SetProp (P_INT_LONG,
    "Du befindest Dich auf einem ziemlich ausgetrampelten Weg entlang der "+
    "Palisade. Weiter im Westen erkennst Du ein Tor, durch das Du wohl "+
    "die Siedlung hinter der Palisade betreten kannst, waehrend der Weg "+
    "nach Osten ueberraschenderweise an einem Schild endet.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"holzpfaehle", "palisade", "pfaehle"}),
    "Die Palisade im Sueden besteht aus sorgfaeltig zusammengefuegten "+
    "Holzpfaehlen, die oben spitz zugeschnitten sind, sodass Dir ein "+
    "Ueberklettern absolut unmoeglich ist.");
  AddDetail ( ({"boden", "weg"}),
    "Du stehst auf einem ziemlich ausgetrampelten Weg, der entlang einer "+
    "Palisade nach Westen fuehrt, wo Du einen Eingang in der Palisade zu "+
    "erkennen glaubst. Im Osten versperrt Dir ein riesiges Schild den Weg.");
  AddSound ( ({DEFAULT_SOUND, "geraeusche"}),
    "Du glaubst, einige Stimmen hinter der Palisade hoeren zu koennen.");
  AddSound ( ({"stimmen"}),
    "Sie klingen aufgeregt, wie auf einem Marktplatz. Was da wohl hinter "+
    "der Palisade auf Dich wartet?");
  AddDetail ( ({"lebewesen"}),
    "Entdecken kannst Du sie hier noch nicht.");
  AddDetail ( ({"schild"}),
    "Das Schild ist so gross, dass Du daran nicht vorbeikommst. Dafuer "+
    "kannst Du es auch aus einigen Metern Entfernung lesen...");
  AddReadDetail ( ({"schild"}),
    "+----------------------------------------------+\n"+
    "|                                              |\n"+
    "|   Hier gehts vorlaeufig noch nicht weiter!   |\n"+
    "|   Bitte um etwas Geduld!                     |\n"+
    "|                              - Ein Magier.   |\n"+
    "|                                              |\n"+
    "+----------------------------------------------+\n");
  AddDetail ( ({"eingang"}),
    "Er liegt weiter westlich von hier. Durch ihn scheinst Du ins Innere "+
    "dieser Siedlung gelangen zu koennen.");

    AddDetail("entfernung", "Das Schild ist aus einiger Entfernung gut lesbar.");
    AddDetail("himmel", "Der Himmel ist wolkenverhangen.");
    AddDetail("innere", "Das Innere der Siedlung bleibt verborgen.");
    AddDetail("marktplatz", "Vielleicht ein Marktplatz hinter der Palisade?");
    AddDetail("metern", "Du kannst das Schild schon aus einigen Metern lesen.");
    AddDetail("siedlung", "Die Siedlung scheint bewohnt zu sein.");
    AddDetail("tor", "Ein Tor im Westen fuehrt ins Innere der Siedlung.");
    AddDetail("ueberklettern", "Das Ueberklettern der Palisade ist unmoeglich.");
    
  // DETAILS END

  // EXITS START
  AddExit ("westen", ROOM("room_h01"));
  // EXITS END

  // ITEMS START
  // ITEMS END

}
