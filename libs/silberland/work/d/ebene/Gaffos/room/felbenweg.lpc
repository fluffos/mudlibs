#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Gaffos/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf einem Dorfweg");
  SetProp (P_INT_LONG,
    "Du stehst am Ende eines Dorfweges. Eigentlich scheint es sich ja "+
    "eher um einen Anrainerweg zu handeln, der einmal zu dem bereits "+
    "etwas verfallenen Gebaeude noerdlich von Dir gefuehrt haben muss. "+
    "Ein kleines mindestens ebenso verfallenes Schild steht neben dem "+
    "Haus, das unbewohnt zu sein scheint.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"ende"}),
    "Hier gehts einfach nicht mehr weiter. Aber Du kannst das Haus im "+
    "Norden betreten, oder aber den Weg zurueck nach Nordosten gehen.");
  AddDetail ( ({"anrainerweg", "dorfweg", "weg"}),
    "Der Weg endet hier unmittelbar vor einem ziemlich verfallenen "+
    "Gebaeude.");
  AddDetail ( ({"boden"}),
    "Der Boden ist hier noch staubiger als im gesamten uebrigen Dorf.");
  AddDetail ( ({"staub"}),
    "Du betrachtest den Staub am Boden naeher und entdeckst, dass sich "+
    "teilweise Asche unter ihn gemischt hat.");
  AddDetail ( ({"asche"}),
    "Asche wie mal sie nach einem Hausbrand sieht. Kein Wunder, dass das "+
    "Gebaeude so verfallen wirkt - es scheint ausgebrannt zu sein.");
  AddDetail ( ({"gebaeude", "haus"}),
    "Das Haus noerdlich von Dir ist schon ziemlich verfallen. Als Du es "+
    "naeher betrachtest, stellst Du fest, dass es irgendwann mal "+
    "ausgebrannt sein muss, und es erscheint Dir wie ein Wunder, dass es "+
    "ueberhaupt noch steht. Ein kleines ebenfalls ziemlich verfallenes "+
    "Schild steht neben dem Haus.");
  AddDetail ( ({"wunder"}),
    "Da es keine Wunder gibt, gab es bei dem Hausbrand wohl keine "+
    "Ueberlebenden.");
  AddDetail ( ({"schild"}),
    "Das kleine Schild aus Holz neben dem Haus ist schon ziemlich "+
    "verfallen, eigentlich ein Wunder, dass es ueberhaupt noch steht. Du "+
    "kannst es lesen.");
  AddReadDetail ( ({"schild"}),
    "Auf dem Schild steht kaum mehr leserlich: H'us FeI(en.");

    AddDetail("dorf", "Das Dorf wirkt verfallen und verlassen.");
    AddDetail("hausbrand", "Der Brand hat das Haus schwer beschaedigt.");
    AddDetail("himmel", "Der Himmel ist grau und duester.");
    AddDetail("holz", "Das Holz ist verbrannt und bruechig.");
    AddDetail("ueberlebenden", "Es scheint keine Ueberlebenden des Feuers zu geben.");
    AddDetail( ({"feuer", "feuers", "brand"}), "Jetzt brennt hier nichts mehr.");

    
  // DETAILS END

  // EXITS START
  AddExit ("nordosten", ROOM("weg_h5"));
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd("betrete|betritt&haus|ruine|verbranntes haus|abgebranntes haus", "cmd_betreten", "Was willst du betreten?");

}

public int cmd_betreten() {
  write(BS("Puh... sieht schwer einsturzgefaehrdet aus. Du laesst das fuer den Moment liebte. Vielleicht ein anderes Mal."));
  return 1;
}
