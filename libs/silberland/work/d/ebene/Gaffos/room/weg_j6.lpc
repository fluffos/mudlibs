#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Gaffos/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf einem Dorfweg");
  SetProp (P_INT_LONG,
    "Du befindest Dich auf einem staubigen Dorfweg mitten im Gaffodorf, "+
    "der zwischen einigen Haeusern hindurch nach Nordosten und Westen "+
    "verlaeuft. Suedlich von Dir erstreckt sich die Palisade in "+
    "schwindelerregende Hoehen und schuetzt das Dorf vor unerwuenschten "+
    "Eindringlingen.");
  // ROOM DESCRIPTION END

    // DETAILS START
    AddDetail ( ({"boden", "dorfweg", "weg"}),
    "Der Weg, auf dem Du gehst, ist zwar etwas staubig, aber ansonsten gut "+
    "von Geruempel geraeumt.");
  AddDetail ( ({"haeuser"}),
    "Die Haeuser sind bestimmt bewohnt, sonst waer es ja kein Wohngebiet.");
  AddDetail ( ({"holzpfaehle", "palisade", "pfaehle"}),
    "Die Palisade suedlich von Dir besteht aus sorgfaeltig "+
    "zusammengefuegten Holzpfaehlen, die oben spitz zugeschnitten sind, "+
    "sodass Dir ein Ueberklettern absolut unmoeglich ist.");
  AddDetail ( ({"eindringling", "eindringlinge"}),
    "Die Palisade haelt sie davon ab, in die Siedlung einzudringen.");

  AddDetail("dorf", "Das Dorf ist von einer hohen Palisade umgeben, die es vor Eindringlingen schuetzt.");
  AddDetail("gaffodorf", "Gaffodorf ist ein kleines, abgelegenes Dorf, in dem die Gaffos leben.");
  AddDetail("geruempel", "Der Weg ist groesstenteils frei, nur ab und zu sind ein paar Reste von Geruempel zu sehen.");
  AddDetail("himmel", "Der Himmel ist klar und es weht ein sanfter Wind, der Staub aufwirbelt.");
  AddDetail("siedlung", "Die Siedlung ist ein kleiner, abgelegener Ort, geschuetzt von der Palisade.");
  AddDetail("ueberklettern", "Die Palisade ist zu hoch und die Pfaehle zu spitz, um sie zu ueberklettern.");
  AddDetail("wohngebiet", "Das Wohngebiet ist ruhig, und die Haeuser sind gut gepflegt.");
  AddDetail("gaffos", "Die Gaffos sind das Volk, das in diesem Dorf lebt.");
  AddDetail("ort", "Der Ort ist ein abgelegener Teil des Gaffodorfes, geschuetzt von einer hohen Palisade.");
  AddDetail("reste", "Einige Reste von alten Gebaeuden oder Abfaellen liegen hier und dort auf dem Weg.");
  AddDetail("staub", "Der Staub auf dem Weg ist leicht und wird durch den Wind immer wieder aufgewirbelt.");
  AddDetail("wind", "Ein sanfter Wind weht ueber den Dorfweg und traegt den Duft von Holz und frischer Erde.");
  AddDetail(({"abfaellen", "abfaelle"}), "Einige Abfaelle liegen verstreut auf dem Weg, meist aus Holz.");
  AddDetail(({"duft", "aroma"}), "Der Duft der frischen Erde mischt sich mit dem Aroma von Holz und Gras.");
  AddDetail("erde", "Die Erde ist staubig und trocken, aber gut begehbar.");
  AddDetail(({"gebaeuden", "gebaeude"}), "Die Gebaeude im Dorf sind einfach, aus Holz gebaut und bieten Schutz vor Wind und Wetter.");
  AddDetail(({"schutz", "wind", "wetter"}), "In einem Gebaeude bist du vor Wind und Wetter geschuetzt.");
  AddDetail("holz", "Der Duft von frisch geschnittenem Holz liegt in der Luft.");
  AddDetail("luft", "Die ist ueberall um dich herum.");
  AddDetail("teil", "Dieser Teil des Gaffodorfes liegt nahe der Palisade.");
  AddDetail("volk", "Das Volk der Gaffos lebt hier ruhig, weit entfernt von den grossen Staedten.");
  AddDetail(({"stadt", "staedten"}), "Die sind weiter weg von hier.");

  AddSmell("gras", "Hmmm... riecht frisch geschnitten.");


  // EXITS START
  AddExit ("westen", ROOM("weg_i6"));
  AddExit ("nordosten", ROOM("weg_k5"));
  // EXITS END

  // ITEMS START
  // ITEMS END

}
