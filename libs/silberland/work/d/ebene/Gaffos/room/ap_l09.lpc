






#include "../gaffos.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Am Lagerfeuer des Goblins" );
  SetProp( P_INT_LONG,
    "Ploetzlich stehst du auf einer kleinen Lichtung im dichten Wald. Durch das "
    "Dickicht im Nordwesten erkennst du den Obsthain der Gaffos. Jemand hat es sich "
    "hier einigermassen gemuetlich gemacht. Ein kleines Lagerfeuer brennt in der "
    "Mitte der Lichtung und daneben ist ein spartanisches Schlaflager.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddDetail("boden", "Der Boden ist weich und uneben, von Blaettern und Moos bedeckt.\n");
AddDetail("dickicht", "Das Dickicht im Nordwesten blockiert den Blick auf den Obsthain.\n");
AddDetail("gaffos", "Durch das Dickicht hindurch erkennst du den Obsthain der Gaffos.\n");
AddDetail("himmel", "Der Himmel ist teils bewoelkt, das Licht durchbricht die Aeste und malt Muster auf den Boden.\n");
AddDetail("lagerfeuer", "Ein kleines, flackerndes Feuer waermt die Lichtung und gibt ein beruhigendes Geraeusch von sich.\n");
AddDetail("lichtung", "Die Lichtung ist weit genug, um sich bequem zu bewegen, aber von Baeumen umgeben.\n");
AddDetail("mitte", "In der Mitte der Lichtung brennt das Lagerfeuer und verbreitet eine angenehme Waerme.\n");
AddDetail("obsthain", "Der Obsthain der Gaffos ist im Nordwesten zu sehen, von hier aus gut erreichbar.\n");
AddDetail("schlaflager", "Das Schlaflager ist spartanisch, ein einfacher Unterschlupf aus Zweigen und Moos.\n");
AddDetail("wald", "Der Wald umgibt die Lichtung dicht und scheint in eine tiefere Dunkelheit zu fuehren.\n");
AddDetail("aeste", "Die Aeste knarren im Wind.\n");
AddDetail("baeume", "Hohe Baeume, ihre Staemme mit Moos bedeckt.\n");
AddDetail("blaetter", "Blaetter rascheln und lassen Licht durch.\n");
AddDetail("blick", "Der Blick faellt auf die Lichtung, das Dickicht blockiert den Weg.\n");
AddDetail("dunkelheit", "Die Dunkelheit wird nur vom Feuer erhellt.\n");
AddDetail("feuer", "Das Feuer knistert und wirft Schatten.\n");
AddDetail("geraeusch", "Das Knistern des Feuers vermischt sich mit Waldgeraeuschen.\n");
AddDetail("licht", "Das Feuerlicht vertreibt die Dunkelheit.\n");
AddDetail("moos", "Feuchtes Moos bedeckt den Boden.\n");
AddDetail("muster", "Licht und Schatten wechseln mit dem Wind.\n");
AddDetail("unterschlupf", "Der Unterschlupf aus Zweigen bietet einfachen Schutz.\n");
AddDetail("waerme", "Die Waerme des Feuers vertreibt die Kaelte.\n");
AddDetail("zweigen", "Zweige bilden einen einfachen Unterschlupf.\n");
AddDetail("feuerlicht", "Das Feuerlicht tanzt auf den Baeumen.\n");
AddDetail("kaelte", "Die Kaelte dringt schnell vor, wird aber vom Feuer vertrieben.\n");
AddDetail("knistern", "Das Knistern des Feuers fuellt die Stille.\n");
AddDetail("schatten", "Schatten tanzen auf dem Boden, geworfen vom Feuer.\n");
AddDetail("schutz", "Der Unterschlupf bietet einfachen Schutz vor dem Wind.\n");
AddDetail("staemme", "Die Baumstaemme sind dick und mit Moos bedeckt.\n");
AddDetail("waldgeraeusche", "Voegel und Insekten mischen sich in die Waldgeraeusche.\n");
AddDetail("weg", "Der Weg durch das Dickicht ist schwer zu erkennen.\n");
AddDetail("wind", "Ein leiser Wind weht durch das Dickicht.\n");


  AddExit( "nordwesten", ROOM("ap_k08") );

  AddItem( NPC("goblin") , REFRESH_DESTRUCT);
}
