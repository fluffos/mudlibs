#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Gaffos/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Eine Wegkreuzung");
  SetProp (P_INT_LONG,
    "Du befindest Dich auf einer Wegkreuzung im Gaffodorf. Dorfwege "+
    "fuehren weiter nach Nordwesten, Nordosten und Suedosten, waehrend Du "+
    "nach Norden hin die Kneipe 'Zum Trunkenbold' betreten kannst. Im "+
    "Westen befindet sich eine kleine Posthuette. Im Osten "
    "befindet sich eine kleine Kapelle. Am Wegrand steht ein kleiner Wegweiser.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden", "dorfweg", "weg"}),
    "Der Weg, auf dem Du gehst, ist zwar ziemlich staubig, aber sonst gut "+
    "geraeumt. Er fuehrt nach Nordwesten, Nordosten und Suedosten weiter.");
  AddDetail ( ({"kneipe"}),
    "Du kannst die Kneipe 'Zum Trunkenbold' im Norden betreten.");
  AddDetail ( ({"gebaeude"}),
    "Das Gebaeude im Westen ist schon etwas verfallen. Von hier aus kannst "+
    "Du es allerdings nicht betreten. Irgendwie wirkt es jedoch unheimlich.");
  AddDetail ( ({"kreuzung", "wegkreuzung"}),
    "Du stehst auf ihr. Zur besseren Orientierung steht ein Wegweiser rum.");
  AddDetail ( ({"wegweiser"}),
    "Ein kleiner, hoelzerner Wegweiser, der in alle fuenf Richtungen "+
    "zeigt. Du kannst ihn vermutlich auch lesen.");
  AddReadDetail ( ({"wegweiser"}),
    " ,-------------------------------------_\n"
    "|      Norden: 'Zum Trunkenbold'        \\\n"+
    "(  Nordwesten und Nord,sten: Z'm Ma,kt   )\n"+
    " \\   Suedosten:Lan.h/us               _/\n"+
    "  )  Suedwesten: H.us F.lb.n    ,-----'\n"+
    "  --------------       --------'\n"+
    "               |      |\n"+
    "               |      |\n"+
    "               |     |\n"+
    "                |    |\n"+
    "                |    |\n");

    AddDetail(({"gaffodorf", "dorf"}),
    "Das Gaffodorf ist ein kleines, ruhiges Dorf mit charmanten Gebaeuden und freundlichen Bewohnern. "
    "Es scheint der perfekte Ort fuer eine kleine Auszeit zu sein.");

AddDetail(({"himmel"}),
    "Der Himmel ueber Dir ist klar und blau, mit nur wenigen Wolken, die sanft vorbeiziehen. "
    "Die Sonne strahlt warm und freundlich.");

AddDetail(({"kapelle"}),
    "Die Kapelle im Osten ist ein kleines, bescheidenes Gebaeude aus Stein mit einem hohen Turm, "
    "auf dem eine Glocke zu sehen ist. Sie wirkt friedlich und einladend.");

AddDetail(({"orientierung"}),
    "Die Wegkreuzung bietet Dir Orientierungspunkte in alle Richtungen. "
    "Ein Wegweiser am Wegrand gibt Auskunft darueber, wohin die verschiedenen Wege fuehren.");

AddDetail(({"posthuette", "post"}),
    "Die kleine Posthuette im Westen sieht alt und ein wenig verfallen aus, aber sie strahlt dennoch einen gewissen Charme aus. "
    "Vielleicht kannst Du dort Briefe oder Pakete versenden.");

AddDetail(({"wegrand", "rand", "wegesrand"}),
    "Am Wegrand wachsen ein paar wilde Blumen und Grasbueschel, die dem staubigen Weg etwas Farbe verleihen.");

AddDetail(({"zum trunkenbold", "trunkenbold", "kneipe"}),
    "Die Kneipe 'Zum Trunkenbold' ist ein rustikales Gebaeude mit einem wettergegerbten Holzschild. "
    "Es scheint ein beliebter Treffpunkt fuer die Dorfbewohner zu sein.");

    AddDetail(({"auskunft"}),
    "Der kleine Wegweiser am Wegrand gibt Dir eine gute Auskunft darueber, "
    "welcher Weg Dich wohin fuehrt.");

AddDetail(({"auszeit"}),
    "Dieser Ort wirkt wie geschaffen fuer eine kurze Auszeit vom Alltag.");

AddDetail(({"bewohnern", "dorfbewohner"}),
    "Die Bewohner des Gaffodorfes scheinen freundlich und aufgeschlossen zu sein. "
    "Man sieht sie oft bei ihren Taetigkeiten oder in Gespraechen vor ihren Haeusern.");

AddDetail(({"blumen"}),
    "Am Wegrand wachsen einige bunte Blumen, die den staubigen Weg auflockern "
    "und etwas Frische in die Umgebung bringen.");

AddDetail(({"briefe"}),
    "Vielleicht kannst Du in der Posthuette Briefe verschicken oder empfangen.");

AddDetail(({"charme"}),
    "Das Dorf und seine Gebaeude strahlen einen rustikalen Charme aus, "
    "der Dich sofort in seinen Bann zieht.");

AddDetail(({"farbe"}),
    "Die Blumen und das gruenliche Gras geben dem Dorfweg etwas natuerliche Farbe "
    "und beleben die Umgebung.");

AddDetail(({"glocke"}),
    "Die Glocke auf dem Turm der Kapelle scheint alt zu sein, doch sie wirkt gut gepflegt. "
    "Vielleicht wird sie noch regelmaessig gelautet.");

AddDetail(({"grasbueschel"}),
    "Einige Grasbueschel wachsen am Wegrand, die dem Weg eine natuerliche Note verleihen.");

AddDetail(({"holzschild"}),
    "Das Holzschild vor der Kneipe 'Zum Trunkenbold' ist von der Witterung gezeichnet, "
    "doch die Aufschrift ist noch gut lesbar.");

AddDetail(({"orientierungspunkte"}),
    "Die Kreuzung selbst, der Wegweiser und die verschiedenen Gebaeude um Dich herum "
    "geben Dir genuegend Orientierungspunkte, um Dich im Gaffodorf zurechtzufinden.");

AddDetail(({"ort"}),
    "Das Gaffodorf ist ein friedlicher Ort, der Dich mit seiner Ruhe und Schoenheit "
    "sofort willkommen heisst.");

AddDetail(({"pakete"}),
    "In der kleinen Posthuette kannst Du vielleicht auch Pakete aufgeben oder abholen.");

AddDetail(({"sonne"}),
    "Die Sonne scheint warm vom Himmel und laesst die Welt um Dich herum in einem sanften Licht erstrahlen.");

AddDetail(({"stein"}),
    "Die Kapelle besteht aus soliden Steinen, die vermutlich schon viele Jahre "
    "Wind und Wetter getrotzt haben.");

AddDetail(({"treffpunkt"}),
    "Die Kneipe 'Zum Trunkenbold' scheint ein beliebter Treffpunkt fuer die Dorfbewohner zu sein. "
    "Vielleicht kannst Du dort interessante Geschichten hoeren.");

AddDetail(({"turm"}),
    "Der hohe Turm der Kapelle ist von hier aus gut sichtbar und verleiht dem Gebaeude "
    "eine beeindruckende Erscheinung.");

AddDetail(({"wolken"}),
    "Am Himmel ziehen nur wenige kleine Wolken vorbei, die der sonst klaren Weite "
    "einen zarten Akzent geben.");

AddDetail(({"zum"}),
    "Wenn Du genauer wissen willst, wo etwas ist, wirf einen Blick auf den Wegweiser.");

    AddDetail(({"akzent"}),
    "Die wenigen Wolken setzen einen zarten Akzent in den klaren blauen Himmel.");

AddDetail(({"alltag"}),
    "Der Alltag scheint hier im Gaffodorf entschleunigt zu verlaufen. Alles wirkt ruhig und gelassen.");

AddDetail(({"aufschrift"}),
    "Die Aufschrift auf dem Holzschild der Kneipe 'Zum Trunkenbold' ist zwar etwas verwittert, "
    "aber noch gut lesbar.");

AddDetail(({"bann"}),
    "Der rustikale Charme des Dorfes zieht Dich sofort in seinen Bann.");

AddDetail(({"bewohner"}),
    "Die Bewohner des Dorfes wirken freundlich und scheinen ein gemuetliches Leben zu fuehren.");

AddDetail(({"blick"}),
    "Ein genauer Blick auf die Umgebung zeigt Dir die vielen liebevollen Details des Dorfes.");

AddDetail(({"erscheinung"}),
    "Die Kapelle wirkt durch ihren hohen Turm und die alten Steine besonders beeindruckend in ihrer Erscheinung.");

AddDetail(({"frische"}),
    "Die Blumen und das Gras verleihen der staubigen Wegkreuzung einen Hauch von Frische.");

AddDetail(({"geschichten"}),
    "Vielleicht erfaehrst Du in der Kneipe 'Zum Trunkenbold' ein paar spannende Geschichten.");

AddDetail(({"gespraechen"}),
    "Die Dorfbewohner fuehren lebhafte Gespraeche, die von der harmonischen Gemeinschaft im Dorf zeugen.");

AddDetail(({"gras"}),
    "Das gruenliche Gras am Wegrand ist gut gepflegt.");

AddDetail(({"haeusern"}),
    "Die Haeuser der Dorfbewohner sind rustikal, aber liebevoll gestaltet und strahlen eine gewisse Waerme aus.");

AddDetail(({"jahre"}),
    "Die Kapelle scheint bereits viele Jahre Wind und Wetter getrotzt zu haben.");

AddDetail(({"licht"}),
    "Das warme Licht der Sonne taucht die Umgebung in ein angenehmes, goldenes Schimmern.");

AddDetail(({"note"}),
    "Die kleinen Details wie die Blumen und das Gras verleihen der Wegkreuzung eine natuerliche Note.");

AddDetail(({"ruhe"}),
    "Eine angenehme Ruhe liegt ueber dem Dorf, die Dich sofort entspannen laesst.");

AddDetail(({"schoenheit"}),
    "Die Schoenheit des Gaffodorfes liegt in seiner Einfachheit und den kleinen, liebevollen Details.");

AddDetail(({"taetigkeiten"}),
    "Die Dorfbewohner gehen ihren verschiedenen Taetigkeiten nach, sei es das Pflegen der Gaerten oder das Plaudern mit Nachbarn.");

AddDetail(({"umgebung"}),
    "Die Umgebung des Gaffodorfes ist idyllisch und einladend, mit gepflegten Wegen und malerischen Gebaeuden.");

AddDetail(({"weite"}),
    "Der Blick in die Weite des Himmels wird nur von ein paar kleinen Wolken unterbrochen.");

AddDetail(({"welt"}),
    "Die Welt um Dich herum scheint hier stehengeblieben zu sein, fernab vom hektischen Treiben der Zivilisation.");

AddDetail(({"wetter"}),
    "Das Wetter ist angenehm und laesst Dich die warme Sonne und den sanften Wind geniessen.");

AddDetail(({"wind"}),
    "Ein sanfter Wind weht durch das Dorf und bringt die Blueten der Blumen am Wegrand zum Tanzen.");

AddDetail(({"witterung"}),
    "Die Witterung hat deutliche Spuren an den alten Gebaeuden hinterlassen.");

    
  AddDetail("tanzen", "Wenn du die Blumen so siehst, willst du am liebsten mit ihnen tanzen.");

  AddDetail(({"blueten"}),
    "Die Blueten der Blumen entlang des Weges sind in verschiedenen Farben gehalten und verleihen dem Ort einen lebendigen Charme.");

AddDetail(({"details"}),
    "Die kleinen Details, wie der gepflegte Wegweiser oder die Blumen am Rand, machen die Wegkreuzung besonders einladend.");

AddDetail(({"einfachheit"}),
    "Die Einfachheit des Dorfes strahlt eine ruhige, zeitlose Schoenheit aus.");

AddDetail(({"gaerten"}),
    "Die Gaerten der Dorfbewohner sind liebevoll gestaltet.");

AddDetail(({"gemeinschaft"}),
    "Die Gemeinschaft des Dorfes scheint eng verbunden zu sein, wie die freundlichen Gespraeche der Bewohner verraten.");

AddDetail(({"gespraeche"}),
    "Du kannst die froehlichen Gespraeche der Dorfbewohner hoeren.");

AddDetail(({"haeuser"}),
    "Die Haeuser im Dorf sind rustikal und gemuetlich.");

AddDetail(({"hauch", "luft", "nostalgie"}),
    "Ein Hauch von Nostalgie liegt in der Luft.");

AddDetail(({"leben"}),
    "Das Leben hier scheint gemuetlich und friedlich.");

AddDetail(({"nachbarn"}),
    "Die Nachbarn im Dorf unterhalten sich herzlich miteinander und scheinen einander gut zu kennen.");

AddDetail(({"pflegen", "sorgfalt"}),
    "Die Bewohner pflegen ihre Gaerten und Wege mit viel Sorgfalt.");

AddDetail(({"plaudern"}),
    "Die Dorfbewohner plaudern miteinander, sei es am Wegesrand oder bei der Kneipe.");

AddDetail(({"schimmern"}),
    "Das Licht der Sonne laesst die Steine der Wege und die Kapelle in einem warmen Schimmern erstrahlen.");

AddDetail(({"spuren", "zeit"}),
    "Die Zeit hat Spuren an den alten Gebaeuden hinterlassen.");

AddDetail(({"treiben"}),
    "Das Treiben im Dorf ist ruhig und gemuetlich.");

AddDetail(({"waerme", "licht", "sonnenlicht", "sonnenlichts"}),
    "Die Waerme des Sonnenlichts laesst Dich sofort wohlfuehlen.");

AddDetail(({"zivilisation", "einfluesse"}),
    "Hier scheinen die Einfluesse der hektischen Zivilisation weit entfernt.");


  // DETAILS END

  // EXITS START
  AddExit ("nordwesten", ROOM("weg_g4"));
  AddExit ("nordosten", ROOM("weg_i4"));
  AddExit ("suedosten", ROOM("weg_i6"));
  AddExit ("norden", ROOM("kneipe"));
  AddExit ("suedwesten", ROOM("felbenweg"));
  AddExit("osten", ROOM("kapelle"));
  AddExit("westen", ROOM("post"));
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd("tanze|tanz&mit&blumen|blume|wind", "cmd_tanzen", "Mit wem willst du tanzen?");

}

public int cmd_tanzen() {
  write(BS("Beschwingt drehst du wie die Blumen ein paar Runden im Wind und fuehlst dich richtig gut."));
  say(BS(TPN+" tanzt im Kreis herum."));
  return 1;
}