#include "../gaffos.h"

inherit "std/room";

#include <properties.h>
#include <combat.h>

int beeren;

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Im Obsthain der Gaffos");
  SetProp(P_INT_LONG,
    "Ein kleiner, schattiger Weg macht hier eine Biegung um eine dichte Hecke aus "
    "Brombeeren. Der Pfad hier ist ausgetrampelt und besteht daher nur noch aus Erde. "
    "Nach Norden hin geht es zurueck in den Obsthain, waehrend du aus dem Osten "
    "froehliches Quaken und ein konstantes Surren hoerst. Der Himmel ueber dir ist "
    "nur stellenweise durch das dichte Laubwerk sichtbar und wirft tanzende "
    "Lichtflecken auf den Boden.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]));

  AddDetail("Biegung", 
    "Die Biegung des Weges fuehrt sanft um eine dichte Hecke herum. Hier scheint der "
    "Pfad besonders oft begangen zu werden, denn die Erde ist festgetreten.");
  AddDetail("Boden", 
    "Der Boden ist festgetreten und besteht hier hauptsaechlich aus dunkler, nackter Erde. "
    "Ab und zu siehst du eine Spur von kleinen Tieren oder sogar grosse Gaffo-Fussabdruecke.");
  AddDetail("Brombeeren", 
    "Die Brombeerhecke ist dicht und undurchdringlich, die dunklen Fruechte sehen reif "
    "und saftig aus. Vorsicht vor den Dornen, falls du eine pfluecken willst!");
  AddDetail("Erde", 
    "Die Erde ist festgetreten und von einem dunklen Braun, gelegentlich durchzogen "
    "von feinen Wurzeln, die an die Oberflaeche dringen.");
  AddDetail("Hecke", 
    "Die dichte Brombeerhecke reicht bis zu deiner Brust und laesst keinen Durchgang zu. "
    "Hier summen Bienen geschaeftig um die Blueten.");
  AddDetail("Himmel", 
    "Durch das Blaetterdach kannst du den blauen Himmel erahnen. Sonnenstrahlen dringen "
    "stellenweise hindurch und werfen Muster aus Licht und Schatten auf den Boden.");
  AddDetail("Obsthain", 
    "Der Obsthain erstreckt sich nach Norden. Du kannst in der Ferne das Blaetterrauschen "
    "und das Zirpen von Insekten hoeren.");
  AddDetail("Pfad", 
    "Der Pfad ist schmal und ausgetrampelt, er besteht hauptsaechlich aus nackter Erde, die "
    "von unzaehligen Gaffo-Fuessen festgedrueckt wurde.");
  AddDetail("Quaken", 
    "Das Quaken scheint von Froeschen aus der Richtung Osten zu kommen. Es klingt "
    "fast wie eine Art natuerliches Orchester.");
  AddDetail("Surren", 
    "Das Surren von Bienen und anderen Insekten ist besonders laut in der Naehe der "
    "Brombeerhecke, wo die Blueten sie anzuziehen scheinen.");
  AddDetail("Weg", 
    "Der Weg windet sich durch den Obsthain, hier macht er eine Biegung um die Brombeerhecke. "
    "Die Erde ist festgetreten und von Spuren durchzogen.");

  AddSound(DEFAULT_SOUND,
    "Das sanfte Rascheln von Blaettern wird nur gelegentlich vom Quaken der Froesche und dem "
    "Surren der Insekten uebertoent.");
  AddSound("Quaken", 
    "Ein vielstimmiges Quaken, das aus der Richtung Osten zu kommen scheint, fuellt die Luft. Es klingt "
    "fast wie ein froehliches Konzert.");
  AddSound("Surren", 
    "Das stete Surren der Bienen an den Brombeerblueten zeugt von geschaeftiger Arbeit.");

  AddSmell(DEFAULT_SMELL,
    "Die Luft ist erfuellt von einem erdigen Duft, durchzogen von der suesslichen Note der Brombeerblueten.");
  AddSmell("Brombeeren", 
    "Ein suesslicher Duft, der von den reifen Fruechten und den Blueten ausgeht, liegt in der Luft.");
  AddSmell("Erde", 
    "Der Duft von frischer, dunkler Erde erinnert an den letzten Regen.");


    AddDetail("arbeit", "Es scheint, als haetten fleissige Haende hier den Pfad geschaffen.");
    AddDetail("art", "Die Pflanzen scheinen sich wild, aber harmonisch zu entfalten.");
    AddDetail("bienen", "Sie summen geschaeftig um die Brombeerblueten.");
    AddDetail("blaetterdach", "Das Blaetterdach spendet angenehmen Schatten.");
    AddDetail("blaettern", "Die Blaetter wiegen sich sanft im Wind.");
    AddDetail("blaetterrauschen", "Das leise Rauschen wirkt beruhigend.");
    AddDetail("blueten", "Zarte Blueten sprenkeln die Hecke.");
    AddDetail("braun", "Der Boden ist in einem satten Braun gehalten.");
    AddDetail("brombeerblueten", "Die Blueten duften suesslich und ziehen Insekten an.");
    AddDetail("brombeerhecke", "Die Hecke ist dicht und voller Dornen.");
    AddDetail("brust", "Der Duft von Erde und Blueten fuellt deine Lungen.");
    AddDetail("dornen", "Die Dornen wirken spitz und gefaehrlich.");
    AddDetail("duft", "Ein suesslicher Duft liegt in der Luft.");
    AddDetail("durchgang", "Der Weg windet sich durch das Gebuesch.");
    AddDetail("ferne", "In der Ferne erklingen Naturgeraeusche.");
    AddDetail("froesche", "Das Quaken der Froesche scheint aus dem Osten zu kommen.");
    AddDetail("fruechte", "Reife Brombeeren haengen schwer an den Zweigen.");
    AddDetail("fuessen", "Deine Fuesse hinterlassen Abdruecke im weichen Boden.");
    AddDetail("fussabdruecke", "Einige Fussabdruecke zeugen von anderen Reisenden.");
    AddDetail("gaffo", "Ein freundliches Wesen koennte sich hier wohlfuehlen.");
    AddDetail("insekten", "Zahlreiche Insekten schwirren umher.");
    AddDetail("konzert", "Die Geraeusche der Natur verschmelzen zu einem Konzert.");
    AddDetail("laubwerk", "Das dichte Laubwerk filtert das Sonnenlicht.");
    AddDetail("licht", "Zwischen den Blaettern dringt diffuses Licht hindurch.");
    AddDetail("lichtflecken", "Sonnenflecken tanzen auf dem Boden.");
    AddDetail("luft", "Die Luft ist frisch und belebt.");
    AddDetail("muster", "Ein schoenes Spiel aus Licht und Schatten zeichnet Muster.");
    AddDetail("naehe", "In der Naehe summt und zirpt es lebendig.");
    AddDetail("note", "Der Duft der Natur hat eine leichte, suesse Note.");
    AddDetail("oberflaeche", "Der Boden ist glattgetreten und weich.");
    AddDetail("orchester", "Ein Orchester aus Froeschen und Insekten spielt.");
    AddDetail("rascheln", "Das Rascheln der Blaetter ist allgegenwaertig.");
    AddDetail("regen", "Der Pfad scheint vom letzten Regen gut aufgelockert.");
    AddDetail("schatten", "Die Schatten der Hecke wirken beruhigend.");
    AddDetail("spur", "Eine feine Spur fuehrt den Weg entlang.");
    AddDetail("tieren", "Verschiedene Tiere hinterlassen ihre Spuren.");
    AddDetail("wurzeln", "Die Wurzeln der Hecke schieben sich durch den Boden.");
    AddDetail("zirpen", "Das Zirpen der Grillen begleitet die Szenerie.");
    AddDetail("abdruecke", "Fussabdruecke in der Erde zeugen von reisenden Gaffos.");
    AddDetail("blaetter", "Die Blaetter der Hecke wiegen sich sanft im Wind.");
    AddDetail("fuesse", "Die Erde ist von den Spuren vieler Fuesse verdichtet.");
    AddDetail("gebuesch", "Das Gebuesch besteht aus dichten Brombeerzweigen mit Dornen.");
    AddDetail("geraeusche", "Geraeusche von Froeschen und Insekten fuellen die Luft.");
    AddDetail("grillen", "Das Zirpen der Grillen ist Teil des abendlichen Konzerts.");
    AddDetail("haende", "Beim Beruehren der Hecke spuert man die Dornen.");
    AddDetail("lungen", "Die frische Luft fuellt deine Lungen mit einem Hauch von Natur.");
    AddDetail("natur", "Die Szenerie zeigt die ungezuegelte Schoenheit der Natur.");
    AddDetail("naturgeraeusche", "Ein harmonisches Zusammenspiel von Quaken, Zirpen und Rauschen.");
    AddDetail("pflanzen", "Die Pflanzen sind gruen und voller Leben.");
    AddDetail("rauschen", "Das leise Rauschen der Blaetter beruhigt die Sinne.");
    AddDetail("reisenden", "Reisende Gaffos haben hier ihre Spuren hinterlassen.");
    AddDetail("sonnenlicht", "Lichtflecken tanzen ueber den Waldboden.");
    AddDetail("spiel", "Die Natur wirkt wie ein ewiges Spiel der Elemente.");
    AddDetail("szenerie", "Ein harmonisches Bild von Schatten, Licht und Geraeuschen.");
    AddDetail("tiere", "Froesche und Insekten sorgen fuer lebhafte Bewegung.");
    AddDetail("wesen", "Kleine Wesen huschen im Gebuesch und beleben den Hain.");
    AddDetail("wind", "Ein sanfter Wind streicht durch das Blaetterdach.");
    AddDetail("zweigen", "Die Zweige der Hecke tragen Blueten und Dornen.");
    AddDetail("beruehren", "Beim Beruehren der Brombeerzweigen spuert man ihre Dornen.");
AddDetail("bewegung", "Leichte Bewegungen im Gebuesch zeugen von verstecktem Leben.");
AddDetail("bild", "Das Bild des Hains ist eine Mischung aus Schatten und Licht.");
AddDetail("brombeerzweigen", "Die Brombeerzweigen sind dicht und voller Dornen.");
AddDetail("elemente", "Die Elemente wirken hier in einem harmonischen Zusammenspiel.");
AddDetail("hain", "Der Hain ist ein friedlicher Ort voller Naturgeraeusche.");
AddDetail("hauch", "Ein Hauch von Blumen und frischer Erde liegt in der Luft.");
AddDetail("leben", "Das Leben zeigt sich in den Tieren und Pflanzen um dich herum.");
AddDetail("schoenheit", "Die Schoenheit der Natur zeigt sich in jedem Detail des Hains.");
AddDetail("sinne", "Deine Sinne werden von den Geraeuschen und Geruechen angeregt.");
AddDetail("teil", "Jedes Detail scheint ein Teil eines groesseren Orchester zu sein.");
AddDetail("waldboden", "Der Waldboden ist weich und voller Spuren.");
AddDetail("zusammenspiel", "Das Zusammenspiel von Licht und Schatten ist faszinierend.");
AddDetail("zweige", "Die Zweige sind voll von Blaettern, Blueten und Dornen.");

    

  AddExit("norden", ROOM("ap_j08"));
  AddExit("osten", ROOM("ap_k09"));

  AddItem("/d/ebene/Park/npc/salamander", REFRESH_DESTRUCT);

  AddCmd("beruehre|beruehr&hecke|dornen|straeucher|brombeere|brombeeren", "cmd_beruehren", "Was willst du beruehren?");
  AddCmd("pfluecke|pflueck|ernte|ernt&beeren|beere|brombeere|brombeeren|straeucher", "cmd_pfluecken", "Was willst du pfluecken?");

  beeren = 1  + random(5);
}

public int cmd_beruehren() {
  if(sizeof(TP->QueryArmours(AT_GLOVE)) > 0) {
    write(BS("Du beruehrst die Dornen, aber dank deiner Handschuhe passiert dir nichts."));
  } else {
    write(BS("Du beruehrst die Dornen und stichst dich! AUA!"));
    TP->AddHp(-5);
  }

  say(TPN+" fummelt die stacheligen Straeucher ab!\n");
  return 1;
}

public int cmd_pfluecken() {
  object ob;
  if(!beeren) {
    write(BS("Du suchst noch Beeren, aber es sind leider keine mehr reif :-("));
    return -1;
  }

  if(sizeof(TP->QueryArmours(AT_GLOVE)) < 1) {
    write(BS("Du beruehrst die Dornen und stichst dich! AUA!"));
    TP->AddHp(-10);
  }

  ob = clone_object(NPC("brombeere"));
  if(ob->move(TP) != 1) {
    write(BS("Du findest eine reife Brombeere, laesst sie aber da wo sie ist, da du sie nicht mehr tragen kannst."));
    destruct(ob);
    return -1;
  }

  write(BS("Du pflueckst eine reife Brombeere."));
  --beeren;
  return 1;
}