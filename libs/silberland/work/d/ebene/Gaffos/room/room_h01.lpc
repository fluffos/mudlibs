#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Gaffos/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN: TT_FOREST]));
  SetProp (P_INT_SHORT, "Weg entlang einer Palisade");
  SetProp (P_INT_LONG,
    "Du stehst auf einer ausgetrampelten Wegkreuzung, die nach Westen und "+
    "Osten hin ins Unbekannte und nach Sueden hin durch ein Tor in der "+
    "Palisade in eine Siedlung zu fuehren scheint. Schon glaubst Du, "+
    "einige Haeuser dort erkennen zu koennen, offenbar ist die Siedlung "+
    "bewohnt. Ein kleines Schild seitlich des Tores faellt Dir auf.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"holzpfaehle", "palisade", "pfaehle"}),
    "Die Palisade im Sueden besteht aus sorgfaeltig zusammengefuegten "+
    "Holzpfaehlen, die oben spitz zugeschnitten sind, sodass Dir ein "+
    "Ueberklettern absolut unmoeglich ist. Allerdings kannst Du durch "+
    "das Tor hindurch ins Innere der Siedlung gelangen.");
  AddDetail ( ({"boden", "weg", "pfaden", "pfad"}),
    "Du stehst auf einem eher ausgetrampelt wirkenden Weg, der entlang "+
    "einer Palisade nach Westen fuehrt, wo er zunehmends holpriger wird. "+
    "Nach Osten hin geht er ins Ungewisse weiter, waehrend Du im Sueden "+
    "durch ein Tor in der Palisade hindurch zu einer Siedlung gelangst.");
  AddSound ( ({DEFAULT_SOUND, "geraeusche"}),
    "Du glaubst, einige Stimmen hinter der Palisade hoeren zu koennen.");
  AddSound ( ({"stimmen"}),
    "Sie klingen aufgeregt, wie auf einem Marktplatz. Was da wohl hinter "+
    "der Palisade auf Dich wartet?");
  AddDetail ( ({"knick"}),
    "Weiter im Westen macht der Weg einen Knick nach Sueden.");
  AddDetail ( ({"lebewesen"}),
    "Entdecken kannst Du sie hier noch nicht.");
  AddDetail ( ({"tor"}),
    "Das Tor in der Palisade im Sueden steht im Moment offen. Durch es "+
    "kannst Du die Siedlung betreten.");
  AddDetail ( ({"siedlung"}),
    "Die Siedlung scheint bewohnt zu sein. Vielleicht lohnt es sich ja, "+
    "sich dort mal genauer umzusehen?");
  AddDetail ( ({"schild", "holzschild"}),
    "Ein kleines Holzschild. Du kannst es lesen.");
  AddReadDetail ( ({"schild", "holzschild"}),
    "Auf dem Schild steht: Gaffosiedlung - Eintritt auf eigene Gefahr!");
  AddDetail ( ({"haeuser"}),
    "Einfache Haeuser aus Holz, soweit Du das von hier aus erkennen "+
    "kannst.");
  AddDetail ( ({"holz"}),
    "Das Holz stammt wohl aus den umliegenden Waeldern.");

    AddDetail("himmel", "Der Himmel ist wolkenverhangen, die Luft wirkt frisch.");
    AddDetail("innere", "Das Innere der Siedlung bleibt vorerst verborgen.");
    AddDetail("marktplatz", "Der Marktplatz scheint hinter der Palisade zu sein.");
    AddDetail("moment", "Im Moment scheint alles ruhig, abgesehen von den entfernten Stimmen.");
    AddDetail("ueberklettern", "Die Palisade ist zu hoch und spitz, ein Überklettern ist unmoeglich.");
    AddDetail("unbekannte", "Nach Westen fuehrt der Weg in das Unbekannte, weiter nach Osten in die Ferne.");
    AddDetail("ungewisse", "Der Weg nach Osten fuehrt in das Ungewisse.");
    AddDetail("waeldern", "Das Holz stammt aus den umliegenden dichten Waeldern.");
    AddDetail("wegkreuzung", "Du stehst an einer Wegkreuzung, mit Pfaden nach Westen, Osten und Sueden.");
    
  // DETAILS END

  // EXITS START
  AddExit ("westen", ROOM("room_g01"));
  AddExit ("osten", ROOM("room_i01"));
  AddExit ("sueden", ROOM("weg_h2"));
  // EXITS END

  // ITEMS START
  // ITEMS END

}
