#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Gaffos/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf einem Dorfweg");
  SetProp (P_INT_LONG,
    "Du gehst auf einem breiten Dorfweg entlang, der sich nach Westen hin "+
    "zu einem grossen Marktplatz oeffnet und nach Sueden weiter in die "+
    "Wohngegend der Siedlung hineinfuehrt. Richtung Nordwesten scheint "+
    "der Weg weiter raus aus der Siedlung zu fuehren.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden", "dorfweg", "weg"}),
    "Der aus ausgetrampeltem Lehm bestehende Boden ist ziemlich staubig, "+
    "aber sonst relativ sauber. Offenbar wird er hier regelmaessig "+
    "geraeumt.");
  AddDetail ( ({"lehm"}),
    "Alter, ausgetrampelter Lehm, nicht weiter untersuchenswert.");
  AddDetail ( ({"marktplatz", "platz"}),
    "Du kannst einige Staende auf dem Marktplatz erkennen. Aufgeregte "+
    "Stimmen fuellen ihn mit Leben.");
  AddDetail ( ({"stimmen"}),
    "Probier's mal mit lausche!");
  AddSound ( ({DEFAULT_SOUND, "stimmen"}),
    "Die Stimmen, die vom Marktplatz herueber erschallen, scheinen "+
    "aufgeregte weltbewegende Diskussionen zu fuehren...");
  AddSound ( ({"diskussionen"}),
    "Es geht wohl um faule Fische, ueberzogene Preise, und Gott und die "+
    "Welt.");
  AddSmell ( ({DEFAULT_SMELL}),
    "Du kannst den Markt im Westen direkt riechen. Neben frischem Gemuese "+
    "schleicht sich aber auch der etwas unangenehme Geruch von Fischen in "+
    "Deine Nase.");
  AddSmell ( ({"gemuese"}),
    "Der Geruch von frischem Gemuese laesst Dich nicht los.");
  AddSmell ( ({"fisch", "fische"}),
    "Fische sind zwar was feines, aber wenn ihr Geruch schon etwas faulig "+
    "ist, und sie noch dazu auf einem Markt verkauft werden, fuehrt das mit "+
    "Gewissheit zu heftigen Diskussionen. Und genau die hoerst Du auch vom "+
    "Westen her...");

    AddDetail ( ({"geruch"}),
    "Der Geruch des Marktes mischt sich mit dem Duft von frischem Gemuese und faulen Fischen.");
  AddDetail ( ({"gewissheit"}),
    "Es herrscht die Gewissheit, dass der Markt der lebendigste Ort in der Siedlung ist.");
  AddDetail ( ({"gott"}),
    "Du hoerst immer wieder die Erwaehnung von 'Gott', begleitet von hitzigen Diskussionen.");
  AddDetail ( ({"himmel"}),
    "Der Himmel ueber dir ist wolkenverhangen und unklar.");
  AddDetail ( ({"leben"}),
    "Das Leben auf dem Markt pulsiert mit staendigen Geschaeften und lebhaften Diskussionen.");
  AddDetail ( ({"markt"}),
    "Der Markt ist der zentrale Ort der Siedlung, wo viele Staende und Haendler zu finden sind.");
  AddDetail ( ({"nase"}),
    "Der Geruch von frischem Gemuese und faulen Fischen steigt dir in die Nase.");
  AddDetail ( ({"preise"}),
    "Die Preise auf dem Markt scheinen sich zu hoehren, und einige Haendler streiten ueber ihre Kosten.");
  AddDetail ( ({"siedlung"}),
    "Du bist in einer kleinen Siedlung, die aus einfachen, aus Lehm gebauten Haeusern besteht.");
  AddDetail ( ({"staende"}),
    "Der Markt ist ueberfullt mit verschiedenen Staenden, von denen der Fischstand auffaellt.");
  AddDetail ( ({"welt"}),
    "In den Diskussionen auf dem Markt wird ueber alles moegliche geredet, von Fischen bis zu Gott und der Welt.");
  AddDetail ( ({"wohngegend"}),
    "Der Weg nach Sueden fuehrt in die ruhigere Wohngegend der Siedlung.");

    AddDetail ( ({"duft"}),
    "Der Duft von frischem Gemuese und faulen Fischen mischt sich in der Luft.");
  AddDetail ( ({"erwaehnung"}),
    "Die Erwaehnung von 'Gott' ist in den Diskussionen des Marktes immer wieder zu hoeren.");
  AddDetail ( ({"fischstand"}),
    "Der Fischstand sticht hervor, mit waehrend des Verkaufs lebhaften Diskussionen.");
  AddDetail ( ({"geschaefte"}),
    "Die Geschaefte auf dem Markt sind immer lebendig und voller Verhandlungen.");
  AddDetail ( ({"haendler"}),
    "Die Haendler hier versuchen eifrig, ihre Waren zu verkaufen und die besten Preise zu erzielen.");
  AddDetail ( ({"haeusern"}),
    "Die einfachen Lehmhaeuser der Siedlung erheben sich in der Ferne.");
  AddDetail ( ({"kosten"}),
    "Die Kosten fuer viele Waren scheinen hoch, was zu heissen Diskussionen fuehrt.");
  AddDetail ( ({"ort"}),
    "Der Marktplatz ist der belebteste Ort in der Siedlung, wo viele Menschen zusammenkommen.");
  
  
  // DETAILS END

  // EXITS START
  AddExit ("westen", ROOM("markt"));
  AddExit ("nordwesten", ROOM("weg_h2"));
  AddExit ("sueden", ROOM("weg_i4"));
  // EXITS END

  // ITEMS START
  AddItem(NPC("bettler"), REFRESH_DESTRUCT);
  // ITEMS END

}
