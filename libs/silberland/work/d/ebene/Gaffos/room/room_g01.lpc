#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Gaffos/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Weg entlang einer Palisade");
  SetProp (P_INT_LONG,
    "Du befindest Dich auf einem Weg entlang einer Palisade, der nach "+
    "Osten hin zunehmend breiter wird, und weiter im Westen einen Knick "+
    "zu machen scheint, wie die Palisade selbst auch. Der Weg ist nicht "+
    "mehr ganz so holprig wie weiter im Westen, offenbar sind hier doch "+
    "oefter mal Lebewesen unterwegs.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"holzpfaehle", "palisade", "pfaehle"}),
    "Die Palisade im Sueden besteht aus sorgfaeltig zusammengefuegten "+
    "Holzpfaehlen, die oben spitz zugeschnitten sind, sodass Dir ein "+
    "Ueberklettern absolut unmoeglich ist.");
  AddDetail ( ({"boden", "weg"}),
    "Du stehst auf einem kleinen unwegsamen Weg, der entlang einer "+
    "Palisade nach Westen fuehrt, wo er zunehmends holpriger wird. "+
    "Nach Osten hin jedoch wirkt er immer ausgetrampelter.");
  AddSound ( ({DEFAULT_SOUND, "geraeusche"}),
    "Du glaubst, einige Stimmen hinter der Palisade hoeren zu koennen.");
  AddSound ( ({"stimmen"}),
    "Sie klingen aufgeregt, wie auf einem Marktplatz. Was da wohl hinter "+
    "der Palisade auf Dich wartet?");
  AddDetail ( ({"knick"}),
    "Weiter im Westen macht der Weg einen Knick nach Sueden.");
  AddDetail ( ({"lebewesen"}),
    "Entdecken kannst Du sie hier noch nicht.");

    AddDetail("himmel", "Der Himmel ist bewölkt und grau.");
    AddDetail("marktplatz", "Vielleicht ein Marktplatz hinter der Palisade?");
    AddDetail("ueberklettern", "Die Palisade ist zu hoch und spitz, um sie zu ueberklettern.");
    
  // DETAILS END

  // EXITS START
  AddExit ("westen", ROOM("room_f01"));
  AddExit ("osten", ROOM("room_h01"));
  // EXITS END

  // ITEMS START
  // ITEMS END

}
