#include <properties.h>
#include <moving.h>
#include "../gaffos.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Gaffos/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Weg entlang einer Palisade");
  SetProp (P_INT_LONG,
    "Du stehst unvermittelter Dinge am Ende eines kleinen Weges vor einem "+
    "Dickicht aus Grasen, Farnen und Straeuchern. Der Weg fuehrt weiter "+
    "nach Norden, einer oestlich gelegenen Palisade entlang. Wohin mag er "+
    "wohl fuehren...?");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"dickicht", "farne", "graeser", 
                "straeucher"}),
    "Hinter dem aus Graesern, Farnen und Straeuchern bestehenden Dickicht "+
    "kannst Du einen dicken Querbalken erkennen.");
  AddDetail ( ({"balken", "querbalken"}),
    "Du kannst versuchen, ueber ihn zu klettern, um weiter nach Westen zu "+
    "gelangen.");
  AddDetail ( ({"holzpfaehle", "palisade", "pfaehle"}),
    "Die Palisade im Osten besteht aus sorgfaeltig zusammengefuegten "+
    "Holzpfaehlen, die oben spitz zugeschnitten sind, sodass Dir ein "+
    "Ueberklettern absolut unmoeglich ist.");
  AddDetail ( ({"boden", "weg"}),
    "Du stehst auf einem kleinen ziemlich unwegsamen Weg, der entlang der "+
    "Palisade weiter nach Norden fuehrt. Hoffentlich stolperst Du nicht!");

    AddDetail("dinge", 
  "Unvermittelter Dinge stehst Du hier vor einem undurchdringlichen Dickicht, "
  "das Dir den Weg nach Westen versperrt.");
  
AddDetail("ende", 
  "Das Ende des Weges wird durch ein undurchdringliches Dickicht markiert, "
  "hinter dem Du jedoch etwas Interessantes zu erkennen meinst.");
  
AddDetail("grasen", 
  "Hohe Graeser wuchern hier wild durcheinander und verschmelzen mit dem Dickicht, "
  "das den Weg blockiert.");
  
AddDetail("himmel", 
  "Ein blauer Himmel erstreckt sich ueber Dir, durchzogen von ein paar ziehenden Wolken. "
  "Es scheint ein schoener Tag zu sein.");
  
AddDetail("ueberklettern", 
  "Das Ueberklettern der Palisade scheint absolut unmoeglich, "
  "da die Holzpfaehle sorgfaeltig angespitzt sind. Ueber den Querbalken zu klettern scheint wahrscheinlicher.");

  AddDetail("interessantes", 
  "Hinter dem Dickicht scheinst Du etwas Interessantes zu entdecken. "
  "Vielleicht lohnt es sich, naeher hinzusehen.");
  
AddDetail("tag", 
  "Es ist ein angenehmer Tag, die Sonne scheint, und der Himmel ist klar.");
  
AddDetail("wolken", 
  "Ein paar weisse Wolken ziehen langsam ueber den blauen Himmel hinweg, "
  "als wuerden sie keine Eile haben.");

  AddDetail("eile", "Hier hat nichts Eile, alles wirkt ruhig und entspannt.");
  AddDetail("sonne", "Die Sonne waermt und laesst die Palisade leuchten.");


  // DETAILS END

  // EXITS START
  AddExit ("norden", ROOM("room_f03"));
  // EXITS END

  // ITEMS START
  // ITEMS END
  AddCmd ("kletter", "kletter", 1);
}

kletter(string str)
{
  string s;
  notify_fail ("Wohin willst Du klettern?\n");
  if (!str) return 0;
  if (!sscanf(str, "ueber %s", s)) return 0;
  notify_fail ("Worueber willst Du klettern?\n");
  if (member(({"querbalken","balken","baumstamm","stamm"}), s) == -1)
    return 0;
  TP->move (ROOM("room_e04"), M_GO, "ueber einen Querbalken",
    "klettert", "kommt ueber einen Querbalken geklettert");
  return 1;
}
