/*
** Feldweg zu den Gaffos
** ---
** 1996-05-13 (Woody) 1.0  Initial Version
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../gaffos.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf einem Feldweg");
  SetProp (P_INT_LONG, bs(
    "Du gehst den kleinen Feldweg weiter entlang, bist Dir jedoch "+
    "nicht mehr sicher, ob Du noch auf dem richtigen Weg bist. Weg? "+
    "Naja, Eigentlich kann man den nach Osten hin immer rauher "+
    "werdenden Boden nicht wirklich mehr Weg nennen.\n"));

  AddDetail ( ({"himmel","sonne"}), "Strahlend blauer Himmel ueber "+
    "Dir, und mitten in ihm die helle Sonne.\n");
  AddDetail ( ({"pfad", "weg", "boden", "feldweg"}), bs("Der Boden unter "+
    "Dir ist ziemlich erdig und relativ naturbelassen, wahrscheinlich "+
    "wurde er bisher von der Zivilisation oder das was sich so nennt "+
    "weitgehend verschont.\n"));
  AddDetail ("erde", "Sie bildet die Grundlage fuer den Boden unter Dir.\n");
  AddDetail ("zivilisation", "Keine zu sehen. Und Zaubertrank findest "+
    "Du leider auch keinen :)\n");
  AddDetail ("zaubertrank", "Keine Ahnung, nie gehoert von.\n");

  AddExit("westen", ROOM("room_a05"));
  AddExit("osten", ROOM("room_c05"));
}
