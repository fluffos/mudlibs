#include "../gaffos.h"

inherit "std/room";

#include <properties.h>

int beeren;

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Im Obsthain der Gaffos");
  SetProp(P_INT_LONG,
    "Du stehst hier auf einer duftenden Blumenwiese. Dicht an dicht wachsen hier "
    "bunte Blumen und saftige Straeucher. Saftiges, gruenes Gras bedeckt den Boden, "
    "waehrend eine freundliche Sonne auf dich herabstrahlt. Der Ort wirkt friedlich "
    "und laedt zum Verweilen ein. Im Osten beginnt ein kleiner, schattiger Hain, "
    "dessen Aeste sich sanft im Wind wiegen.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]));

  // Details
  AddDetail("blumenwiese", 
    "Die Blumenwiese ist voller bunter, duftender Blumen in allen Farben des Regenbogens. "
    "Manche Blumen sind klein und zart, andere groesser mit ueppigen Blueten.\n");

  AddDetail("blumen", 
    "Die Blumen sind wunderschoen und in allen moeglichen Farben vertreten: Gelb, Blau, Rot und sogar Violett.\n");

  AddDetail("straeucher", 
    "Die Straeucher tragen kleine, saftige Beeren, die in der Sonne glitzern. Einige sind wild, andere wirken gepflegt.\n");

  AddDetail("gras", 
    "Das Gras ist frisch und gruen, weich unter deinen Fuessen und voller Leben.\n");

  AddDetail("boden", 
    "Der Boden ist von Gras und Wurzeln durchzogen, die ihm eine weiche, lebendige Textur verleihen.\n");

  AddDetail("sonne", 
    "Die freundliche Sonne scheint warm auf die Wiese herab und verstaerkt die Farbenpracht der Blumen.\n");

  AddDetail("hain", 
    "Der kleine Hain im Osten wirkt einladend, mit schattigen Plaetzen unter den Baeumen. Die Blaetter rascheln leise im Wind.\n");

  AddDetail("wind", 
    "Ein sanfter Wind streicht ueber die Wiese und bringt die Blueten zum Tanzen.\n");

  AddDetail("schmetterlinge", 
    "Einige Schmetterlinge flattern von Blume zu Blume, als ob sie einen Tanz auffuehren wuerden.\n");

    AddDetail("atmosphaere", 
    "Die Atmosphaere hier ist ruhig und friedlich, durchzogen von einem Hauch von Magie.\n");

  AddDetail("baeumen", 
    "Die Baeume am Rand des Hains stehen majestaetisch und werfen kuehle Schatten auf die Wiese.\n");

  AddDetail("beeren", 
    "Zwischen den Straeuchern leuchten pralle, saftige Beeren in verschiedenen Farben.\n");

  AddDetail("blaetter", 
    "Die Blaetter der Baeume und Straeucher rascheln sanft im Wind und funkeln im Sonnenlicht.\n");

  AddDetail("blau", 
    "Das tiefe Blau des Himmels verstaerkt die Farbenpracht der Wiese.\n");

  AddDetail("blueten", 
    "Die Blueten der Blumen sind in allen moeglichen Farben und Formen ein Fest fuer die Augen.\n");

  AddDetail("duft", 
    "Ein sanfter Duft von Blueten und frischem Gras liegt in der Luft.\n");

  AddDetail("farben", 
    "Die Farben der Blumen und Straeucher leuchten kraeftig im Sonnenlicht.\n");

  AddDetail("farbenpracht", 
    "Eine wahre Farbenpracht umgibt dich, als wuerdest du in einem lebenden Gemaelde stehen.\n");

  AddDetail("fuessen", 
    "Unter deinen Fuessen spuerst du das weiche, gruene Gras, das die Wiese bedeckt.\n");

  AddDetail("himmel", 
    "Der Himmel ist strahlend blau, ohne auch nur eine Wolke.\n");

  AddDetail("leben", 
    "Überall um dich herum spuerst du das pulsierende Leben der Natur.\n");

  AddDetail("lied", 
    "Ein unsichtbares Lied der Natur scheint in der Luft zu schweben, harmonisch und beruhigend.\n");

  AddDetail("luft", 
    "Die Luft ist klar und frisch, erfuellt vom Duft der Blumen.\n");

  AddDetail("ort", 
    "Dieser Ort strahlt eine besondere Ruhe und Harmonie aus, als waere er von der Zeit unberuehrt.\n");

  AddDetail("plaetzen", 
    "Einige einladende Plaetze laden dich zum Verweilen ein, um die Natur zu geniessen.\n");

  AddDetail("rascheln", 
    "Ein leises Rascheln der Blaetter erfuellt die Luft, verursacht durch eine sanfte Brise.\n");

  AddDetail("regenbogens", 
    "Das Licht der Sonne bricht sich in den Blueten und Straeuchern wie in einem Regenbogen.\n");

  AddDetail("rot", 
    "Ein leuchtendes Rot sticht zwischen den Bluetenfarben hervor und zieht deinen Blick an.\n");

  AddDetail("sinne", 
    "Deine Sinne sind erfuellt von der Schoenheit, den Dueften und Klaengen dieses Ortes.\n");

  AddDetail("sommerregen", 
    "Der Duft erinnert dich an die Frische eines Sommerregens.\n");

  AddDetail("summen", 
    "Das Summen von Bienen und anderen Insekten erfuellt die Luft, als wuerden sie ein Konzert geben.\n");

  AddDetail("tanzen", 
    "Die Blaetter und Grashalme scheinen im Wind zu tanzen, als ob sie lebendig waeren.\n");

  AddDetail("textur", 
    "Die Textur der Blueten und Blaetter ist weich und angenehm, wenn du sie beruehrst.\n");

  AddDetail("verweilen", 
    "Ein unwiderstehlicher Drang, hier zu verweilen, erfasst dich.\n");

  AddDetail("violett", 
    "Ein kraeftiges Violett schmueckt einige der Blumen und verleiht ihnen eine besondere Eleganz.\n");

  AddDetail("wiese", 
    "Die Wiese ist mit bunten Blumen, saftigem Gras und vereinzelten Straeuchern bedeckt.\n");

  AddDetail("wurzeln", 
    "Die Wurzeln der Baeume graben sich tief in die Erde und verleihen ihnen Standfestigkeit.\n");

  AddDetail("zwitschern", 
    "Das Zwitschern der Voegel erfuellt die Luft, als wuerden sie froehlich miteinander plaudern.\n");

  // Smells
  AddSmell(DEFAULT_SMELL, 
    "Ein betoerender Duft von Blumen und frischem Gras erfuellt die Luft.\n");

  AddSmell("blumen", 
    "Die Blumen verstroemen einen suessen, angenehmen Duft, der die Sinne belebt.\n");

  AddSmell("gras", 
    "Das Gras duftet frisch, wie nach einem Sommerregen.\n");

  // Sounds
  AddSound(DEFAULT_SOUND, 
    "Du hoerst das leise Summen von Bienen und das Zwitschern von Voegeln, begleitet vom Rascheln der Blaetter im Wind.\n");

  AddSound("bienen", 
    "Das Summen der Bienen klingt friedlich und passt perfekt zur Atmosphaere der Wiese.\n");

  AddSound("voegel", 
    "Das froehliche Zwitschern der Voegel erfuellt die Luft, als wuerden sie ein Lied fuer die Blumen singen.\n");

  AddSound("wind", 
    "Der Wind raschelt sanft durch die Blaetter und streicht ueber die Wiese.\n");

    AddDetail("augen", "Die Farben und Formen der Blumen sind ein wahres Fest fuer die Augen.\n");
    AddDetail("baeume", "Die Baeume am Rand des Hains werfen kuehlen Schatten und bieten Ruhe.\n");
    AddDetail("blick", "Der Blick ueber die Wiese ist eine wahre Freude fuer die Sinne.\n");
    AddDetail("bluetenfarben", "Die Blumen strahlen in einer Vielzahl lebendiger Farben.\n");
    AddDetail("brise", "Eine sanfte Brise weht ueber die Wiese und bringt die Blumen zum Tanzen.\n");
    AddDetail("drang", "Ein unerklaerlicher Drang, hier zu verweilen, ueberkommt dich.\n");
    AddDetail("dueften", "Der Duft der Blumen und frisches Gras erfuellen die Luft.\n");
    AddDetail("eleganz", "Ein Hauch von Eleganz umweht die violetten Blumen.\n");
    AddDetail("erde", "Der Boden unter deinen Fuessen fuehlt sich weich und lebendig an.\n");
    AddDetail("fest", "Die Blumen und Farben sind ein wahres Fest fuer die Sinne.\n");
    AddDetail("formen", "Die Blumen und Straeucher zeigen sich in allen Formen und Groessen.\n");
    AddDetail("frische", "Die Frische der Wiese ist wie nach einem erfrischenden Regen.\n");
    AddDetail("gemaelde", "Es fuehlt sich an, als stuendest du in einem lebendigen Gemaelde.\n");
    AddDetail("grashalme", "Die Grashalme wiegen sich im Wind und glaenzen im Sonnenlicht.\n");
    AddDetail("harmonie", "Die gesamte Szenerie strahlt eine ruhige Harmonie aus.\n");
    AddDetail("hauch", "Ein Hauch von Magie scheint in der Luft zu liegen.\n");
    AddDetail("insekten", "Insekten summen umher, ihre Geraeusche mischen sich mit der Natur.\n");
    AddDetail("klaengen", "Das Zwitschern der Voegel und das Summen der Bienen vermischen sich zu einem angenehmen Klang.\n");
    AddDetail("konzert", "Das Summen der Insekten wirkt wie ein harmonisches Konzert.\n");
    AddDetail("licht", "Das Licht der Sonne bricht sich in den Blumen und funkelt.\n");
    AddDetail("magie", "Es liegt ein sanfter Hauch von Magie in der Luft.\n");
    AddDetail("natur", "Die Natur hier ist in ihrer vollen Pracht zu erleben.\n");
    AddDetail("plaetze", "Einige ruhige Plaetze laden zum Verweilen und Geniessen ein.\n");
    AddDetail("rand", "Am Rand des Hains wachsen hohe Baeume, die Schatten spenden.\n");
    AddDetail("regenbogen", "Das Licht der Sonne bricht sich in den Farben der Blumen wie in einem Regenbogen.\n");
    AddDetail("ruhe", "Die Ruhe dieses Ortes ist fast greifbar.\n");
    AddDetail("schatten", "Die Baeume werfen kuehle Schatten und laden zum Ausruhen ein.\n");
    AddDetail("schoenheit", "Die Schoenheit dieses Ortes ist unbeschreiblich.\n");
    AddDetail("sonnenlicht", "Das Sonnenlicht taucht die Wiese in ein warmes, goldiges Licht.\n");
    AddDetail("standfestigkeit", "Die Baeume sind standfest, ihre Wurzeln tief in der Erde verankert.\n");
    AddDetail("wolke", "Der Himmel ist klar, ohne auch nur eine Wolke zu sehen.\n");
    AddDetail("zeit", "Die Zeit scheint hier stillzustehen, der Ort wirkt unberuehrt von der Welt.\n");
    AddDetail("ausruhen", "Unter den Baeumen findest du einen ruhigen Platz zum Ausruhen.\n");
AddDetail("freude", "Dieser Ort erfuellt dich mit einer tiefen Freude und Zufriedenheit.\n");
AddDetail("geniessen", "Es gibt viel zu geniessen: die Farben, die Duefte und die Ruhe.\n");
AddDetail("geraeusche", "Das leise Rascheln der Blaetter und das Summen der Insekten bilden ein beruhigendes Geraeusch.\n");
AddDetail("groessen", "Die Blumen variieren in Groesse – einige sind zart, andere praechtig und gross.\n");
AddDetail("klang", "Der Klang des Windes und das Zwitschern der Voegel vereinen sich zu einer sanften Melodie.\n");
AddDetail("pracht", "Die Pracht der Blumen und Baeume ist ueberwaeltigend, ein wahres Meisterwerk der Natur.\n");
AddDetail("regen", "Der Duft des Regens scheint immer noch in der Luft zu haengen.\n");
AddDetail("szenerie", "Die Szenerie ist wie aus einem Gemaelde – harmonisch und voller Leben.\n");
AddDetail("vielfalt", "Die Vielfalt an Pflanzen und Farben macht diesen Ort einzigartig.\n");
AddDetail("welt", "Dieser Ort fuehlt sich wie ein abgeschlossener Teil der Welt an, unberuehrt und friedlich.\n");

    

  // Exits
  AddExit("norden", ROOM("weg_i6"));
  AddExit("osten", ROOM("ap_j07"));
  AddExit("suedosten", ROOM("ap_j08"));

  // NPCs
  AddItem("/d/ebene/Park/npc/schmetterling", REFRESH_DESTRUCT);

  AddCmd("pfluecke|pflueck&beeren|beere", "cmd_pfluecken", "Was willst du pflucken?");

  beeren = 1 + random(5);
}

public int cmd_pfluecken() {
  object ob;
  if(!beeren) {
    write(BS("Du suchst noch Beeren, aber es sind leider keine mehr reif :-("));
    return -1;
  }

  ob = clone_object(NPC("beere"));
  if(ob->move(TP) != 1) {
    write(BS("Du findest eine reife Beere, laesst sie aber da wo sie ist, da du sie nicht mehr tragen kannst."));
    destruct(ob);
    return -1;
  }

  write(BS("Du pflueckst eine saftige, rote Beere."));
  --beeren;
  return 1;
}

public void reset() {
  ::reset();
  beeren = 1 + random(5);
  tell_room(TO, BS("Ein paar rote Beeren reifen heran."));
}