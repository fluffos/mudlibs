#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Gaffos/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Am Ende eines Feldweges");
  SetProp (P_INT_LONG,
    "Du hast das Ende des schmalen Feldweges erreicht und stehst "+
    "unvermittelter Dinge direkt vor einem dicken Querbalken, einer Art "+
    "Zaun, hinter dem nur noch Dickicht wuchert. Du fragst Dich, wohin "+
    "der Weg, der hier so ueberraschend endet, wohl einmal gefuehrt haben "+
    "mag...");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"himmel", "sonne"}),
    "Strahlend blauer Himmel ueber Dir, und mitten in ihm die helle "+
    "Sonne.");
  AddDetail ( ({"boden" }),
    "Der Boden unter Dir ist ziemlich erdig und relativ naturbelassen.");
  AddDetail ( ({"feldweg", "pfad", "weg" }),
    "Der Weg scheint hier abrupt vor einem Querbalken zu enden.");
  AddDetail ( ({"erde"}),
    "Sie bildet die Grundlage fuer den Boden unter Dir.");
  AddDetail ( ({"balken", "querbalken", "zaun"}),
    "Der Querbalken, im Grunde nichts anderes als ein glattgehobelter "+
    "Baumstamm, ist ziemlich dick und unverrueckbar, aber nicht sonderlich "+
    "hoch.");
  AddDetail ( ({"baumstamm", "stamm"}),
    "Du koenntest versuchen, drueber zu klettern.");
  AddDetail ( ({"dickicht"}),
    "Das Dickicht wuchert hier nur so, Graeser, Farne, Straeucher, "+
    "offenbar ist hier schon lange niemand mehr vorbeigekommen.");
  AddDetail ( ({"graeser"}),
    "Als Du die Graeser genauer betrachtest, fallen Dir die in ihnen "+
    "verflochtenen Farne auf.");
  AddDetail ( ({"farne"}),
    "Du betrachtest die Farne, kannst aber nichts besonderes erkennen, "+
    "ausser dass sie teilweise stark mit den Graesern verflochten sind. "+
    "Dein Blick wendet sich den Straeuchern zu.");
  AddDetail ( ({"straeucher"}),
    "Du knickst ein paar Straeucher beiseite und erkennst auf einmal eine "+
    "kleine Palisade weiter im Osten.");
  AddDetail ( ({"palisade"}),
    "Die Palisade liegt weiter oestlich und ist hinter dem Dickicht so "+
    "versteckt, dass sie kaum zu erkennen ist. Vielleicht kommst Du ja "+
    "naeher ran?");

    AddDetail("art", "Der Querbalken ist eine einfache Art von Barriere, robust und schlicht.");
  AddDetail("blick", "Dein Blick wandert ueber das Dickicht und bleibt an der Palisade haengen.");
  AddDetail("dinge", "Es gibt hier keine besonderen Dinge, nur das Dickicht und der Querbalken fallen ins Auge.");
  AddDetail("ende", "Das Ende des Feldweges wirkt verlassen und geheimnisvoll, als haette hier einst mehr gelegen.");
  AddDetail("grunde", "Aus irgendeinem Grunde scheint der Weg hier schon vor langer Zeit aufgegeben worden zu sein.");
  AddDetail("auge", "Dein Auge erfasst das Bild: ein Querbalken, dichtes Dickicht und die verborgene Palisade.");
  AddDetail("barriere", "Die Barriere aus Holz ist stabil und scheint ihren Zweck zu erfuellen, den Weg zu versperren.");
  AddDetail("zeit", "Die Zeit hat ihre Spuren hinterlassen, das Dickicht wuchert ungestoert und der Weg ist kaum noch sichtbar.");
  AddDetail("bild", "Ein Bild aus Dickicht und Holz praegt sich Dir ein.");
  AddDetail("holz", "Glattgehobeltes, robustes Holz.");
  AddDetail("spuren", "Alte Spuren, fast verschwunden.");
  AddDetail("zweck", "Der Querbalken versperrt den Weg.");


  // DETAILS END

  // EXITS START
  AddExit ("westen", ROOM("room_d04"));
  // EXITS END

  // ITEMS START
  // ITEMS END
  AddCmd ("kletter", "kletter", 1);
}

kletter(string str)
{
  string s;
  notify_fail ("Wohin willst Du klettern?\n");
  if (!str) return 0;
  if (!sscanf(str, "ueber %s", s)) return 0;
  notify_fail ("Worueber willst Du klettern?\n");
  if (member(({"querbalken","balken","baumstamm","stamm"}), s) == -1)
    return 0;
  TP->move (ROOM("room_f04"), M_GO, "ueber einen Querbalken",
    "klettert", "kommt ueber einen Querbalken geklettert");
  return 1;
}
