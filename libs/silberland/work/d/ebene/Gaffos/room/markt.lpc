#include <properties.h>
#include <moving.h>
#include "files.h"

inherit "std/room";

int birnen;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf einem Marktplatz");
  SetProp (P_INT_LONG,
    "Du stehst auf einem kleinen Marktplatz inmitten der Gaffosiedlung. "+
    "Du kannst mehrere Staende, unter anderem einen Fisch- und einen "+
    "Gemuesestand sehen, zu denen Du von hier aus gelangst. Laute "+
    "Diskussionen fuellen den nicht an allen Stellen ganz sauber gefegten "+
    "Marktplatz. Dorfwege fuehren oestlich, westlich und noerdlich des "+
    "Platzes in alle Richtungen weiter. Im Sueden erkennst Du die von "+
    "Efeu ueberwucherte Rueckseite einer Kneipe.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden", "dorfweg", "weg"}),
    "Der aus ausgetrampeltem Lehm bestehende Boden ist ziemlich staubig, "+
    "aber sonst relativ sauber. Offenbar wird er hier regelmaessig "+
    "geraeumt.");
  AddDetail ( ({"lehm"}),
    "Alter, ausgetrampelter Lehm, nicht weiter untersuchenswert.");
  AddDetail ( ({"siedlung","gaffosiedlung"}),
    "Du stehst mittendrinnen, und zwar am Marktplatz.");
  AddDetail ( ({"marktplatz", "platz"}),
    "Du kannst einige Staende auf dem Marktplatz erkennen. Aufgeregte "+
    "Stimmen fuellen ihn mit Leben.");
  AddDetail ( ({"stimmen"}),
    "Probier's mal mit lausche!");
  AddDetail ( ({"staende", "stand"}),
    "Vor allem der Fischstand und der Gemuesestand faellt Dir auf.");
  AddDetail ( ({"fischstand"}),
    "Der Fischhaendler versucht hier, seine Fische an den Mann oder die "+
    "Frau zu bringen, was wohl nicht so leicht zu sein scheint.");
  AddDetail ( ({"gemuese", "gemuesestand"}),
    "Du erblickst alle moeglichen Arten von frischem Gemuese, unter "+
    "anderem Karfiol, Karotten, Paradeiser (woanders auch Tomaten genannt), "+
    "Fisolen und auch Salat. Ausserdem scheint er auch eine kleine Auswahl "+
    "an Obst zu haben.");
  AddDetail ( ({"fisolen", "karfiol", "karotten", 
                "paradeiser", "salat", "tomaten"}),
    "Scheint alles ziemlich frisch zu sein, und sicher gesund!");
  AddDetail ( ({"aepfel"}),
    "Einige saftig rote Aepfel. Ob Du auch morgen noch kraftvoll zubeissen "+
    "kannst?");
  AddSpecialDetail ( ({"auswahl", "obst"}), "d_obst");
  AddSpecialDetail ( ({"birne", "birnen"}), "d_birne");
  AddDetail ( ({"schild", "preisschild"}),
    "Unter den Preisschildern faellt Dir das bei der Birne besonders auf. "+
    "Du kannst es bestimmt lesen.");
  AddReadDetail ( ({"schild", "preisschild"}),
    "Auf dem Preisschild steht: Frrrrische Birnen! Nur 100 Muenzen das "+
    "Stueck!");
  AddDetail ( ({"fisch", "fische"}),
    "Die Fische, die der Fischhaendler zu verkaufen versucht, scheinen "+
    "nicht mehr ganz frisch zu sein, ihrem Geruch nach zu schliessen...");
  AddDetail ( ({"kneipe", "rueckseite", "rueckwand","haus"}),
    "Von der Kneipe kannst Du hier nur die von Efeu ueberwucherte "+
    "Rueckwand erkennen. Fenster oder Tueren siehst Du da keine. "+
    "Dafuer erkennst Du ein Dach, auf dem sich irgendwas zu befinden "+
    "scheint.");
  AddDetail ( ({"efeu"}),
    "Der Efeu wuchert an der Rueckwand der Kneipe in die Hoehe.");
  AddDetail ( ({"markt"}),
    "Der Markt wird mehr oder weniger von einigen Staenden gebildet.");
  AddDetail ( ({"dach"}),
    "Das Dach der Kneipe scheint eben und begehbar zu sein.");

  AddSound ( ({DEFAULT_SOUND, "stimmen"}),
    "Die vielen Stimmen, die Du hier vernimmst, scheinen aufgeregte, "+
    "ja nahezu weltbewegende Diskussionen zu fuehren...");
  AddSound ( ({"diskussionen"}),
    "Es geht wohl um faule Fische, ueberzogene Preise, und Gott und die "+
    "Welt.");
  AddSound ( ({"fisch", "fische"}),
    "Von denen hoerst Du bestimmt keinen Laut.");
  AddSound ( ({"gott"}),
    "Du vernimmst auf einmal ein deutliches Grummeln.\n"
    "Du erschrickst. War das etwa...?\n");

  AddSmell ( ({DEFAULT_SMELL}),
    "Es riecht hier so riechtig nach Markt. Neben dem irgendwie doch "+
    "vernehmbaren Geruch von frischem Gemuese schleicht sich aber auch "+
    "der etwas unangenehme Geruch von Fischen in Deine Nase.");
  AddSmell ( ({"gemuese"}),
    "Der Geruch von frischem Gemuese laesst Dich nicht los.");
  AddSmell ( ({"fisch", "fische"}),
    "Fische sind zwar was feines, aber wenn ihr Geruch schon etwas faulig "+
    "ist, und sie noch dazu auf einem Markt verkauft werden, fuehrt das mit "+
    "Gewissheit zu heftigen Diskussionen. Und genau die kannst Du nur zu "+
    "gut hier vernehmen...");
  AddSmell ( ({"aerger", "diskussion", "diskussionen"}),
    "Du kannst den Aerger foermlich riechen, den die Diskussionen hier "+
    "auszuloesen scheinen...");

    AddDetail ( ({"arten"}),
    "Es gibt viele verschiedene Arten von frischem Gemuese hier.");
  AddDetail ( ({"betrug"}),
    "Geruechte von Betrug machen die Runde, besonders ueber die Fische.");
  AddDetail ( ({"fischhaendler"}),
    "Der Fischhaendler scheint wenig zufrieden mit seinem Verkauf zu sein.");
  AddDetail ( ({"frau"}),
    "Eine Frau verhandelt lautstark mit dem Fischhaendler.");
  AddDetail ( ({"gemuesehaendler"}),
    "Der Gemuesehaendler lacht und bietet seine Waren zu einem guten Preis an.");
  AddDetail ( ({"geruch"}),
    "Der Geruch von frischem Gemuese und fauligen Fischen liegt in der Luft.");
  AddDetail ( ({"gewissheit"}),
    "Du bist dir mit Sicherheit sicher, dass die Fische nicht mehr frisch sind.");
  AddDetail ( ({"grummeln"}),
    "Ein seltsames Grummeln ertoent, vielleicht von irgendwo aus der Ferne.");
  AddDetail ( ({"haendler"}),
    "Die Haendler rufen laut, um ihre Waren zu verkaufen.");
  AddDetail ( ({"himmel"}),
    "Der Himmel ueber dem Markt ist klar, mit nur wenigen Wolken.");
  AddDetail ( ({"hoehe"}),
    "Der Markt ist flach, keine hohen Gebaeude in der Naehe.");
  AddDetail ( ({"junge"}),
    "Ein Junge schleicht neugierig um die Staende herum.");
  AddDetail ( ({"laut"}),
    "Die Stimmen der Haendler und Kunden sind deutlich laut zu hoeren.");
  AddDetail ( ({"leben"}),
    "Der Marktplatz pulsiert vor Leben und Aktivitaet.");
  AddDetail ( ({"leute"}),
    "Viele Leute tummeln sich hier und handeln auf dem Marktplatz.");
  AddDetail ( ({"mann"}),
    "Ein Mann mit einem Sack voller Fische schlaegt die Preise vor.");
  AddDetail ( ({"maus"}),
    "Eine kleine Maus huscht unter den Staenden hindurch.");
  AddDetail ( ({"nase"}),
    "Deine Nase kann den unangenehmen Geruch von fauligen Fischen riechen.");
  AddDetail ( ({"ohr"}),
    "Das Geraeusch der Diskussionen ist fast schon unangenehm fuer dein Ohr.");
  AddDetail ( ({"preise"}),
    "Die Preise sind hier in der Regel hoch, besonders fuer frisches Obst.");
  AddDetail ( ({"sie"}),
    "Die Haendler bieten ihre Waren mit Eifer und Begeisterung an.");
  AddDetail ( ({"stellen"}),
    "An manchen Stellen des Marktplatzes ist es besonders eng.");
  AddDetail ( ({"tueren"}),
    "Du kannst keine Tueren zur Kneipe sehen, nur die Rueckwand.");
  AddDetail ( ({"welt"}),
    "Die Diskussionen hier scheinen die ganze Welt zu betreffen.");

    AddDetail ( ({"aktivitaet"}),
    "Der Marktplatz ist voller Aktivitaet und rege Bewegung.");
  AddDetail ( ({"begeisterung"}),
    "Die Haendler bieten ihre Waren mit grosser Begeisterung an.");
  AddDetail ( ({"eifer"}),
    "Mit Eifer versuchen die Haendler, ihre Ware zu verkaufen.");
  AddDetail ( ({"ferne"}),
    "In der Ferne hoerst Du das Rauschen des Flusses.");
  AddDetail ( ({"gebaeude"}),
    "Die wenigen Gebaeude hier sind schlicht und nicht sehr hoch.");
  AddDetail ( ({"geraeusch"}),
    "Das Geraeusch der Diskussionen ist ueberall auf dem Platz zu hoeren.");
  AddDetail ( ({"kunden"}),
    "Die Kunden scheinen eher misstrauisch und verhandeln hart.");
  AddDetail ( ({"luft"}),
    "Die Luft ist warm und duftet nach frischem Gemuese und faulen Fischen.");
  AddDetail ( ({"naehe"}),
    "In der Naehe siehst du eine kleine Kneipe, deren Rueckwand mit Efeu bewachsen ist.");
  AddDetail ( ({"preis"}),
    "Der Preis der Birnen ist mit 100 Muenzen deutlich zu hoch fuer viele hier.");
  AddDetail ( ({"regel"}),
    "Es scheint hier eine ungeschriebene Regel zu geben, dass Preise immer verhandelbar sind.");
  AddDetail ( ({"runde"}),
    "Die Diskussionen gehen in eine endlose Runde, ohne dass jemand nachgibt.");
  AddDetail ( ({"sack"}),
    "Ein Mann mit einem Sack voller Fische bietet seine Ware an.");
  AddDetail ( ({"sicherheit"}),
    "Mit Sicherheit wirst du hier keine wirklich frischen Fische finden.");
  AddDetail ( ({"verkauf"}),
    "Der Verkauf geht schleppend voran, der Fischhaendler wirkt besorgt.");
  AddDetail ( ({"waren"}),
    "Die Waren auf dem Markt variieren von frischem Gemuese bis hin zu faulen Fischen.");
  AddDetail ( ({"wolken"}),
    "Die Wolken am Himmel ziehen langsam vorueber.");
  
  
  // DETAILS END

  // EXITS START
  AddRoomMessage( ({
    "Ein Haendler ruft: Frrrrrische Fische, ganz guenstig!!\n",
    "Du hoerst jemanden schreien: Gemueeeese, frisches Gemuese!! Kommen "
    "Sie...\n",
    "Einige Leute murmeln was von 'Betrug' und 'faulen Fischen'...\n",
    "Stimmenwirrwarr fuellt den Marktplatz.\n",
    "Einige Leute scharen sich um den Fischstand.\n",
    "Du wirst unabsichtlich angestupst.\n",
    "Der Gemuesehaendler kratzt sich hinterm Ohr.\n",
    "Eine kleine Maus huscht ueber den Marktplatz, ist aber sofort "
    "verschwunden.\n",
    "Ein kleiner Junge schleicht um die Staende herum.\n" }),
  30 );
  AddExit ("westen", "./weg_g3");
  AddExit ("norden", "./weg_h2");
  AddExit ("osten", "./weg_i3");
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"kaufe", "kauf"}), "kaufe" );
  AddCmd ( ({"klettere", "kletter"}), "klettere" );

  birnen = 3;

  AddItem(NPC("maedchen"), REFRESH_DESTRUCT);
}

reset()
{
  ::reset();
  if (birnen != 3)
    tell_room (ME, "Der Obsthaendler sortiert ein paar Birnen ein.\n");
  birnen = 3;
}

string d_obst()
{
  if (!birnen)
    return bs(
     "Du erblickst in einer Ecke des Gemuesestandes einige Aepfel und ein "
     "Schild, das Birnen anpreist, aber es scheint keine Birne mehr da zu "
     "sein.");
  else
    return bs(
     "Du erblickst in einer Ecke des Gemuesestandes einige Aepfel und "+
     (birnen==1 ? "eine Birne":birnen+" Birnen")+", mehr ist es aber "
     "auch nicht.");
}

string d_birne()
{
  if (!birnen)
    return bs(
     "Es scheint hier mal Birnen gegeben zu haben, aber derzeit kannst "
     "Du keine ausfindig machen. Sie werden aber bestimmt nachgeliefert!");
  else
    return bs(
     (birnen==1 ? "Eine einzelne Birne liegt" : birnen+" Birnen liegen")+
     " verloren unter all den Aepfeln. Du betrachtest sie naeher, es "
     "scheint irgendetwas besonderes daran zu sein. Vielleicht kannst "
     "Du sie ja sogar kaufen? Auf dem Preisschild daneben steht was von "
     "100 Muenzen, also gar nicht so arg teuer.");
}

int kaufe (string str)
{
  notify_fail ("Was willst Du kaufen?\n");
  if (!str) return 0;
  switch (str)
  {
    case "gemuese": case "obst":
      write ("Du musst Dich schon etwas genauer ausdruecken!\n");
      break;
    case "karfiol": case "karotte": case "karotten":
    case "paradeiser": case "tomate": case "tomaten":
    case "fisolen": case "salat": case "apfel": case "aepfel":
      write (bs("Du liest das Preisschild, kriegst einen kleinen Schock "+
        "und beschliesst, Dein Geld doch besser woanders oder in etwas "+
        "anderes zu investieren."));
      break;
    case "birne": case "birnen":
      if (birnen)
        if (TP->QueryMoney() < 100)
          write ("Der Haendler sagt: \"Du hast ja nicht mal genug Geld "+
            "dabei!\"\n");
        else
        {
          write ("Der Haendler verkauft Dir eine saftige Birne und kassiert "+
            "Dein Geld.\n");
          CLONEOB(OBJ("div/birne"))->move(TP, M_NOCHECK);
          TP->AddMoney(-100);
          birnen--;
        }
      else
        write ("Der Haendler sagt: \"Tut mir leid, aber die Birnen sind "+
          "komplett ausverkauft!\"\n");
      break;
    case "fische":
    case "fisch":
      write (bs("Du begutachtest die Fische naeher und entscheidest Dich "+
        "daraufhin spontan, lieber doch kein Exemplar zu erstehen..."));
      break;
    default:
      write ("Das kannst Du hier nicht kaufen!\n");
  }
  return 1;
}

int klettere(string str)
{
  notify_fail ("Wohin willst Du klettern?\n");
  if (!str) return 0;
  str = regreplace( str, "\\<a(m|n) efeu\\>", "efeu", 1 );
  str = regreplace( str, "\\<(rauf|nach oben)\\>", "hoch", 1 );
  switch(str)
  {
    case "efeu":
      notify_fail("Klettern schoen und gut, aber in welche Richtung?\n");
      return 0;
    case "hoch":
      notify_fail("Du willst also raufklettern, aber woran?\n");
      return 0;
    case "efeu hoch":
      write ("Du hantelst Dich geschickt am Efeu hoch.\n");
      say (CAP_TPN+" klettert geschickt am Efeu hoch.\n");
      TP->move (ROOM("kneipedach"), M_SILENT | M_GO);
      break;
    default:
      write ("Dahin kannst Du von hier aus nicht klettern!\n");
  }
  return 1;
}
