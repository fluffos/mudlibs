/*
** Feldweg zu den Gaffos
** ---
** 1996-05-13 (Woody) 1.0  Initial Version
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../gaffos.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf einem Feldweg");
  SetProp (P_INT_LONG, bs(
    "Du gehst vorsichtig einen kleinen Feldweg entlang, der nach Osten "+
    "zu ins Ungewisse zu fuehren scheint. Weiter im Westen kannst Du "+
    "bereits etwas Zivilisation erkennen, offenbar muss dort eine "+
    "groessere Stadt in der Naehe sein."));

  AddDetail ( ({"himmel","sonne"}), "Strahlend blauer Himmel ueber "+
    "Dir, und mitten in ihm die helle Sonne.\n");
  AddDetail ( ({"pfad", "weg", "boden", "feldweg"}), bs("Der Boden unter "+
    "Dir scheint noch kaum abgenutzt zu sein. Hierher verirren sich wohl "+
    "nur selten Abenteurer, vielleicht nicht ohne Grund..."));
  AddDetail ("stadt", "Ja, weiter im Westen liegt eine groessere "+
    "Stadt, genannt Midas.\n");
  AddDetail ("midas", "Dies ist der Name der groesseren Stadt im Westen.\n");
  AddDetail ("ungewisse", "Nach Osten scheint die Gegend immer "+
    "undurchsichtiger zu werden.\n");
  AddDetail ("gegend", "Du starrst Loecher in selbige.\n");
  AddDetail ("loecher", "Sie wurden von Dir in die Gegend gestarrt.\n");
  AddDetail ("zivilisation", "Weiter im Westen, Anderlaender... :)\n");
  AddDetail ("naehe", bs("Naehe kann etwas sehr schoenes sein... Hier "+
    "jedoch ist lediglich eine groessere Stadt in der Naehe."));

    AddDetail("abenteurer", "Abenteurer verirren sich selten hier, vielleicht aus gutem Grund.\n");
    AddDetail("anderlaender", "Anderlaender sind in einem... anderen Land.\n");
    AddDetail("grund", "Vielleicht liegt der Grund in der ungewissen Gegend nach Osten.\n");
    AddDetail("name", "Midas. Bitte lass es, das wird sonst zyklisch.\n");
    AddDetail("land", "Naja... ein anderes Land... Anderland...");
    

  // AddExit("westen",(""));
  AddExit("osten", ROOM("room_b05"));
  AddExit("westen", "/d/ebene/creative/feldlager/room/a3_a2");

  AddItem(NPC("gaffo"), REFRESH_DESTRUCT);
}
