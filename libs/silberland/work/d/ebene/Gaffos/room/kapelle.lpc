/*
** Kapelle zu Ehren von Woody
** ---
** 2024-12-21 (Ersteller) 1.2  Alle Hauptwoerter durch AddDetail beschrieben
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../gaffos.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_INT_SHORT, "In der Kapelle des Schoepfers Woody");
  SetProp (P_INT_LONG, bs(
    "Du befindest Dich in einer kleinen, schlichten Kapelle, die zu "+
    "Ehren des Gottes Woody errichtet wurde, einem der beiden Schoepfer "+
    "des Silberlands. Der Raum strahlt eine ruhige, ehrfurchtsvolle "+
    "Atmosphaere aus. Die Waende sind mit schlichten Holzpaneelen "+
    "verkleidet, und in der Mitte des Raumes steht ein einfacher "+
    "Altar aus Stein, auf dem eine kleine Holzfigur von Woody thront. "+
    "Kerzen flackern in den Ecken des Raumes und verbreiten ein "+
    "sanftes, warmes Licht. Ein leichter Duft nach Moos und Holz "+
    "liegt in der Luft. Nach Westen fuehrt ein schmaler Ausgang." ));

  // Details
  AddDetail(({"kapelle", "raum"}), bs("Die Kapelle ist ein kleiner, schlichter Raum, "+
    "der durch seine ruhige Atmosphaere auffaellt. Sie ist Woody, einem der "+
    "Schoepfer des Silberlands, gewidmet."));
  AddDetail(({"altar", "steinaltar"}), bs("Der Altar ist schlicht, aber sorgfaeltig gefertigt. "+
    "Er besteht aus glattem Stein und hat eine kleine Holzfigur in der Mitte, "+
    "die Woody darstellen soll. Der Altar wird von Kerzenlicht erhellt, das "+
    "eine sanfte Atmosphaere schafft."));
  AddDetail(({"holzfigur", "figur", "woody"}), bs("Die Holzfigur zeigt einen "+
    "freundlichen, aber weise wirkenden Mann, der die Schoepferkraft von Woody "+
    "symbolisieren soll. Sein Gesichtsausdruck scheint Dich zu ermutigen, "+
    "mutig und neugierig zu sein."));
  AddDetail(({"waende", "holzpaneele"}), bs("Die Waende der Kapelle sind mit "+
    "dunklem Holz verkleidet, das den Raum warm und einladend erscheinen laesst."));
  AddDetail(({"kerzen", "licht", "kerzenlicht"}), bs("Die Kerzen in den Ecken des "+
    "Raumes flackern sanft und werfen tanzende Schatten auf die Waende."));
  AddDetail(({"duft", "moos", "holz", "holzduft"}), "Ein angenehmer Duft nach Moos "+
    "und Holz liegt in der Luft und verleiht dem Raum eine beruhigende Wirkung.\n");
  AddDetail(({"atmosphaere", "ruhe", "ehrfurcht"}), bs("Die Atmosphaere im Raum "+
    "ist ruhig und ehrfurchtsvoll, perfekt fuer Gebete und stille Momente."));
  AddDetail(({"ausgang", "westen"}), bs("Nach Westen fuehrt ein schmaler Ausgang, "+
    "der zu einem anderen Ort fuehrt."));
  AddDetail(({"licht"}), bs("Das Licht wird hauptsaechlich von den Kerzen erzeugt, "+
    "die eine sanfte und warme Beleuchtung schaffen."));
  AddDetail(({"luft"}), bs("Die Luft in der Kapelle ist frisch und angenehm, "+
    "durchzogen von einem leichten Duft nach Holz und Moos."));
    AddDetail("beleuchtung", "Die Beleuchtung in der Kapelle stammt hauptsaechlich von den flackernden Kerzen, die ein warmes und sanftes Licht verbreiten.");
  AddDetail("boden", "Der Boden ist aus schlichtem, aber festem Stein, der durch das sanfte Licht der Kerzen eine warme Ausstrahlung erhaelt.");
  AddDetail("decke", "Die Decke ist hoch und schlicht gehalten, mit dunklem Holz verkleidet, das dem Raum ein ruhiges, erhabenes Gefuehl verleiht.");
  AddDetail("ecken", "In den Ecken des Raumes stehen die Kerzen, die mit ihrem flackernden Licht den Raum erleuchten und fuer eine besinnliche Atmosphaere sorgen.");
  AddDetail("ehren", "Die Kapelle wurde zu Ehren von Woody errichtet, dem Gott der Schoepferkraft des Silberlands.");
  AddDetail("gebete", "Die Kapelle ist ein Ort der Stille, an dem Gebete an Woody gerichtet werden koennen. Sie sind voller Hoffnung auf das Wohlwollen des Schoepfers.");
  AddDetail("gesichtsausdruck", "Der Gesichtsausdruck der Holzfigur von Woody ist freundlich und weise, als wolle er den Glaeubigen Mut zusprechen.");
  AddDetail("gottes", "Woody, der Gott der Schoepferkraft, wird in dieser Kapelle verehrt, und seine Praesenz scheint im Raum zu schweben.");
  AddDetail("mann", "Die Holzfigur stellt einen weisen Mann dar, der fuer seine Schoepferkraft und seinen Einfluss auf das Silberland bekannt ist.");
  AddDetail("mitte", "In der Mitte des Altars thront die kleine Holzfigur von Woody, die die Schoepferkraft des Gottes symbolisiert.");
  AddDetail("momente", "In dieser Kapelle kann man zur Ruhe kommen und nachdenkliche Momente erleben, in denen man zu Woody beten oder meditieren kann.");
  AddDetail("ort", "Der Ort der Kapelle ist friedlich und von Natur umgeben, was ihn zu einem idealen Platz fuer Besinnung und Gebet macht.");
  AddDetail("schatten", "Die flackernden Schatten der Kerzen tanzen an den Waenden und erzeugen eine fast magische Atmosphaere.");
  AddDetail("schoepfer", "Woody, einer der beiden Schoepfer des Silberlands, wird hier in dieser Kapelle geehrt.");
  AddDetail("schoepferkraft", "Die Schoepferkraft von Woody, die in dieser Kapelle verehrt wird, ist das goettliche Prinzip, das das Silberland ins Leben rief.");
  AddDetail("silberlands", "Das Silberland ist die Welt, die durch die Schoepferkraft von Woody und dem anderen Gott erschaffen wurde.");
  AddDetail("stein", "Der Altar besteht aus festem Stein, dyaer eine beruhigende, dauerhafte Ausstrahlung hat.");
  AddDetail("wand", "Die Waende der Kapelle sind mit dunklem Holz verkleidet, das den Raum warm und einladend erscheinen laesst.");
  AddDetail("wirkung", "Die Wirkung der Kapelle ist beruhigend und erhebend, sie laedt dazu ein, zu beten und zu meditieren.");
  AddDetail("ausstrahlung", "Die Ausstrahlung der Kapelle ist ruhig und ehrfurchtsvoll, sie vermittelt ein Gefuehl der inneren Ruhe und Besinnung.");
  AddDetail("besinnung", "Die Kapelle ist ein Ort der Besinnung, an dem man sich von der Welt abwenden und in Stille zu Woody beten kann.");
  AddDetail("einfluss", "Woody hat einen tiefen Einfluss auf das Silberland, da seine Schoepferkraft das Land und seine Bewohner geformt hat.");
  AddDetail("gebet", "Ein Gebet an Woody wird hier in der Kapelle zu einem Moment der Verbindung mit dem Gott, in der Hoffnung auf Beistand und Fuehrung.");
  AddDetail("gefuehl", "Das Gefuehl in der Kapelle ist friedlich und ehrfuerchtig, als ob die Zeit stillsteht und jeder Moment bedeutungsvoll ist.");
  AddDetail("glaeubigen", "Die Kapelle ist ein Zufluchtsort fuer die Glaeubigen, die hier zu Woody beten und sich mit seiner Schoepferkraft verbinden wollen.");
  AddDetail("gott", "Woody, der Gott der Schoepferkraft, wird hier verehrt. Er ist der Ursprung allen Lebens im Silberland.");
  AddDetail("hoffnung", "In der Kapelle ist Hoffnung spuerbar, besonders fuer diejenigen, die in schwierigen Momenten zu Woody beten und auf seine Hilfe vertrauen.");
  AddDetail("leben", "Das Leben im Silberland wurde durch die Schoepferkraft von Woody erschaffen. Die Kapelle ist ein Ort, an dem dieses Leben geehrt wird.");
  AddDetail("mut", "Der Mut, sich den Herausforderungen des Lebens zu stellen, wird durch die Symbolik der Holzfigur von Woody in der Kapelle gestaerkt.");
  AddDetail("natur", "Die Natur umgibt die Kapelle und traegt zur friedlichen Atmosphaere bei, die diesen Ort des Gebets und der Besinnung umgibt.");
  AddDetail("platz", "Der Platz vor dem Altar bietet genuegend Raum, um zu beten oder nachzudenken, ohne von der Welt abgelenkt zu werden.");
  AddDetail("praesenz", "Die Praesenz von Woody scheint den Raum zu durchdringen, als waere er jederzeit bereit, die Glaeubigen mit seiner Schoepferkraft zu segnen.");
  AddDetail("prinzip", "Das Prinzip von Woody, die Schoepferkraft, wird in dieser Kapelle geehrt und verehrt, da es das Leben im Silberland hervorbrachte.");
  AddDetail("silberland", "Das Silberland ist die Welt, die durch die Schoepferkraft von Woody erschaffen wurde, ein Land voller Magie und Geheimnisse.");
  AddDetail("stille", "Die Stille in der Kapelle ist tief und ehrfuerchtig, sie ist der perfekte Rahmen fuer Gebet und Besinnung.");
  AddDetail("welt", "Die Welt des Silberlands wurde durch die Schoepferkraft von Woody und dem anderen Gott ins Leben gerufen und wird in der Kapelle geehrt.");
  AddDetail("wohlwollen", "Das Wohlwollen von Woody wird in der Kapelle gesucht, besonders von den Glaeubigen, die um Beistand und Fuehrung bitten.");
  AddDetail("beistand", "Beistand von Woody wird hier in der Kapelle erhofft, besonders in schwierigen Momenten, in denen man Unterstuetzung braucht.");
  AddDetail("bewohner", "Die Bewohner des Silberlands ehren Woody in dieser Kapelle, da seine Schoepferkraft das Land und ihre Existenz ermoeglicht hat.");
  AddDetail("fuehrung", "Die Fuehrung von Woody wird von denen gesucht, die in der Kapelle beten, um Klarheit und Richtung in schwierigen Zeiten zu finden.");
  AddDetail("geheimnisse", "Das Silberland birgt viele Geheimnisse, die durch die Schoepferkraft von Woody und dem anderen Gott geformt wurden.");
  AddDetail("herausforderungen", "In dieser Kapelle finden diejenigen, die vor Herausforderungen stehen, Trost und Hoffnung, um weiterzumachen.");
  AddDetail("hilfe", "Hilfe von Woody wird durch Gebete erbeten, besonders in Momenten der Not oder des Zweifels.");
  AddDetail("land", "Das Land des Silberlands wurde durch die Schoepferkraft von Woody erschaffen, und seine Schoenheit und Geheimnisse werden hier geehrt.");
  AddDetail("magie", "Die Magie des Silberlands ist ein Geschenk der Schoepferkraft, die Woody und der andere Gott ueber das Land brachten.");
  AddDetail("moment", "Jeder Moment in dieser Kapelle ist voller Bedeutung, und die Zeit scheint hier stillzustehen, waehrend man zu Woody betet.");
  AddDetail("rahmen", "Der Rahmen der Kapelle ist schlicht, aber ideal fuer Gebet und Besinnung, mit einer Atmosphaere der Ruhe und Ehrfurcht.");
  AddDetail("symbolik", "Die Symbolik der Holzfigur von Woody erinnert an die Schoepferkraft und den Einfluss des Gottes auf das Silberland.");
  AddDetail("ursprung", "Woody ist der Ursprung des Lebens im Silberland, und seine Schoepferkraft bildet die Grundlage dieser Welt.");
  AddDetail("verbindung", "In der Kapelle wird die Verbindung zu Woody gesucht, um sich mit der Schoepferkraft des Gottes zu vereinen.");
  AddDetail("zeit", "Die Zeit scheint in dieser Kapelle langsamer zu vergehen, da die Stille und die Atmosphaere der Besinnung den Raum erfuellen.");
  AddDetail("zufluchtsort", "Die Kapelle ist ein Zufluchtsort fuer Glaeubige, die hier Schutz und Ruhe suchen, um zu beten oder zu meditieren.");


  // Ausgang nach Westen
  AddExit("westen", ROOM("weg_h5"));
}

init()
{
  ::init();
  add_action("do_pray", "bete");
  add_action("do_pray", "bet");
}

int do_pray(string str)
{
  if (this_player()->QueryProp(P_GHOST))
  {
    write("Du kniest vor dem Altar und betest zu Woody. Eine warme Energie "+
          "durchfliesst Deinen Koerper, und Du wirst ins Leben zurueckgeholt.\n");
    say(this_player()->Name(WER) + " kniet vor dem Altar und scheint "+
         "sich ploetzlich voller Leben zu erheben.\n");
    this_player()->SetProp(P_GHOST, 0);
    return 1;
  }

  write("Du kniest vor dem Altar und sprichst ein Gebet, doch es passiert nichts.\n");
  return 1;
}
