/*
** Feldweg zu den Gaffos
** ---
** 1996-05-13 (Woody) 1.0  Initial Version
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../gaffos.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf einem Feldweg");
  SetProp (P_INT_LONG, bs(
    "Du folgst dem schmalen Feldweg unbeirrt weiter, da Du eigentlich "+
    "genug von der oeden Landschaft hast und gerne mal was neues "+
    "sehen wuerdest. Doch irgendwie hast Du das Gefuehl als ob es "+
    "noch eine kleine Weile dauern wuerde, bis Du endlich wieder auf "+
    "etwas Leben stoesst.\n"));

  AddDetail ( ({"himmel","sonne"}), "Strahlend blauer Himmel ueber "+
    "Dir, und mitten in ihm die helle Sonne.\n");
  AddDetail ( ({"pfad", "weg", "boden", "feldweg"}), "Der Boden unter "+
    "Dir ist ziemlich erdig und relativ naturbelassen.\n");
  AddDetail ("erde", "Sie bildet die Grundlage fuer den Boden unter Dir.\n");
  AddDetail ("leben", "Leben ist die Seinsform von Organismen. "+
    "Laut Brockhaus.\n");
  AddDetail ( ({"seinsform", "organismen", "brockhaus"}),
    "Einzelheiten dazu sind in diversen Nachschlagewerken zu finden.\n");
  AddDetail ("gefuehl", "Gefuehl setzt Leben voraus.\n");
  AddDetail ("landschaft", "Sie ist oed, oed, oooooed. Sie ist waeh!\n");
  AddDetail(({"nachschlagewerk", "nachschlagewerken"}), "Brockhaus, Keulen, Stoecke - alles Nachschlagewerke!");
  AddDetail(({"keulen", "stoecke"}), "Damit kannst du jemandem nachschlagen.");

  AddExit("westen", ROOM("room_b05"));
  AddExit("nordosten", ROOM("room_d04"));
}
