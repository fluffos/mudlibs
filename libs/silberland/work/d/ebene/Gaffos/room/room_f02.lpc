#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Gaffos/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Weg entlang einer Palisade");
  SetProp (P_INT_LONG,
    "Du gehst auf einem kleinen unbefestigten Weg eine Palisade entlang. "+
    "Hier scheinen nur sehr selten Lebewesen vorbeizukommen, der Weg ist "+
    "schon ziemlich verkommen, und Du hast Muehe, nicht zu stolpern. "+
    "Weiter im Norden kannst Du eine Wegbiegung erkennen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"holzpfaehle", "palisade", "pfaehle"}),
    "Die Palisade im Osten besteht aus sorgfaeltig zusammengefuegten "+
    "Holzpfaehlen, die oben spitz zugeschnitten sind, sodass Dir ein "+
    "Ueberklettern absolut unmoeglich ist.");
  AddDetail ( ({"boden", "weg"}),
    "Du stehst auf einem kleinen ziemlich unwegsamen Weg, der entlang der "+
    "Palisade von Norden nach Sueden fuehrt. Hoffentlich stolperst Du "+
    "nicht!");
  AddDetail ( ({"biegung", "wegbiegung"}),
    "Weiter im Norden scheint der Weg eine Biegung nach Osten zu machen.");
  AddDetail ( ({"lebewesen"}),
    "Du kannst ausser Dir hier keine ausmachen.");

    AddDetail("himmel", "Der Himmel ist wolkenbedeckt und es scheint bald zu regnen.");
    AddDetail("muehe", "Der Weg ist holprig und uneben, du hast Muehe, deinen Halt zu bewahren.");
    AddDetail("halt", "Stolpere lieber nichter!");
    AddDetail("ueberklettern", "Die Palisade ist zu hoch und zu spitz, ein Überklettern ist voellig unmoeglich.");
    
  // DETAILS END

  // EXITS START
  AddExit ("sueden", ROOM("room_f03"));
  AddExit ("norden", ROOM("room_f01"));
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd("stolper|stolpere", "cmd_stolpern");

}

public int cmd_stolpern() {
  write(BS("Mit einem galanten Schwung stolperst du, rappelst dich aber gleich wieder auf."));
  say(BS(TPN+" stolpert und faellt auf den Boden."));
  return 1;
}
