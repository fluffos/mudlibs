#include "../gaffos.h"

inherit "std/room";

#include <properties.h>

int apples;  // Zaehler fuer die Aepfel

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Im Obsthain der Gaffos" );
  SetProp( P_INT_LONG,
    "Das ist der hinterste Winkel des Obsthains. Ein grosser Apfelbaum "
    "steht hier, sonst nichts. Rings um dich, am Rand des Hains also, befindet "
    "sich ein dichtes Dickicht. Im Sueden befindet sich ein kleiner "
    "Tuempel. Die Luft ist frisch und duftend, und der Platz fuehlt sich ruhig und abgelegen an." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( "apfelbaum", 
    "Der Apfelbaum steht kraeftig und alt, mit zahlreichen, reifen Aepfeln, "
    "die an seinen Zweigen haengen. Seine Aeste wiegen sich sanft im Wind.\n");

  AddDetail( "dickicht", 
    "Das Dickicht am Rand des Hains ist dicht und undurchdringlich. Nur mit viel Muehe "
    "koenntest du hindurch navigieren. Wenn du nur wuesstest wo man hier gut durch kommt...");

  AddDetail( "tuempel", 
    "Ein kleiner Tuempel liegt im Sueden. Das Wasser ist klar, und du kannst die "
    "Schwimmer der Fische darunter sehen.\n");

  AddDetail( "boden", 
    "Der Boden ist weich und feucht, bedeckt mit Moos und verstreuten Blaettern.\n");

  AddDetail( "luft", 
    "Die Luft hier ist frisch, durchzogen von einem sanften Duft von Blueten und feuchtem Laub.\n");

  AddDetail( "aeste", 
    "Die Aeste des Apfelbaums sind dick und tragen schwere Fruechte. Einige Aeste sind "
    "tief genug, um die Fruechte fast zum Greifen nah zu bringen.\n");

  AddReadDetail( "apfelbaum", 
    "Der Apfelbaum traegt pralle, rote Aepfel, die im Sonnenlicht glaenzen.\n");

  AddSound( DEFAULT_SOUND,
    "Ein leises Rascheln der Blaetter und das sanfte Knarren des Apfelbaums im Wind sind zu hoeren.\n");

  AddSound( "voegel", 
    "Das Zwitschern der Voegel aus der Naehe des Hains erfuellt die Luft.\n");

  AddSmell( DEFAULT_SMELL,
    "Der Duft von reifen Aepfeln und frischem Gras haengt in der Luft.\n");

  AddSmell( "apfel", 
    "Die Aepfel riechen suess und frisch, ein verlockender Duft in der warmen Luft.\n");

    AddDetail("aepfel", 
  "Die Aepfel am Apfelbaum sind prall und rot, glaenzen im Sonnenlicht und duften verfuehrerisch. Um an sie ranzukommen, muesstest du sie schon runterschuetteln.\n");

AddDetail("aeste", 
  "Die Aeste des Apfelbaums sind dick und tragen schwer an den Fruechten. Einige Aeste neigen sich unter "
  "dem Gewicht der reifen Aepfel.\n");

AddDetail("bl", 
  "Ein Teil des Blaetterdachs des Apfelbaums ist von gruenen Blaettern bedeckt, die sich sanft im Wind bewegen.\n");

AddDetail("blueten", 
  "Die Blueten des Apfelbaums sind verschwunden, aber ihre Erinnerung schwingt noch in der Luft. "
  "Fruehjahrsblueten muessen hier frueher fuer einen betoerenden Duft gesorgt haben.\n");

AddDetail("duft", 
  "Der Duft von reifen Aepfeln und frischem Gras liegt in der Luft. Er ist angenehm und einladend.\n");

AddDetail("fische", 
  "Im Tuempel schwimmen kleine Fische, die im klaren Wasser ihre Runden ziehen. Ihre Bewegungen sind schnell und zierlich.\n");

AddDetail("gras", 
  "Das Gras ist saftig und gruen, weich unter deinen Fuessen, mit kleinen Blumen dazwischen, die in allen Farben bluehen.\n");

AddDetail("hains", 
  "Der Hain im Sueden ist umgeben von dichtem Dickicht. Die Baeume werfen kuehlende Schatten und schaffen einen ruhigen Ort.\n");

AddDetail("himmel", 
  "Der Himmel ist weit und klar, nur wenige Wolken ziehen dahin. Die Sonne scheint warm und freundlich.\n");

AddDetail("knarren", 
  "Das leise Knarren der Aeste des Apfelbaums ist zu hoeren, wenn der Wind sanft durch die Baeume zieht.\n");

AddDetail("laub", 
  "Das Laub auf dem Boden ist trocken und raschelt leise, wenn du hindurch gehst. Es fuehlt sich unter deinen Fuessen knirschend an.\n");

AddDetail("moos", 
  "Das Moos auf dem Boden ist weich und feucht, und es waechst in dicken Teppichen, die den Boden bedecken.\n");

AddDetail("muehe", 
  "Der Weg durch das Dickicht erfordert etwas Muehe, doch mit etwas Geduld kannst du dich hindurch bewegen.\n");

AddDetail("obsthains", 
  "Der Obsthain ist von mehreren Baeumen gesaeumt, und der Apfelbaum ist nur einer von vielen in dieser schoenen Oase.\n");

AddDetail("platz", 
  "Der Platz hier ist ruhig und abgelegen, umgeben von Natur. Ein friedlicher Ort, um sich auszuruhen.\n");

AddDetail("rand", 
  "Am Rand des Hains beginnt das dichte Dickicht, das den Raum des Obsthains vom restlichen Wald trennt.\n");

AddDetail("rascheln", 
  "Das Rascheln der Blaetter und des Laubs unter den Aesten ist bei jedem Windstoss zu hoeren.\n");

AddDetail("schwimmer", 
  "Die Fische schwimmen ruhig im Wasser des Tuempels. Ihre Bewegungen sind elegant und schnell.\n");

AddDetail("wasser", 
  "Das Wasser des Tuempels ist klar und ruhig. Es spiegelt die Baeume und den Himmel wider und sieht einladend aus.\n");

AddDetail("wind", 
  "Ein sanfter Wind weht durch den Obsthain und laesst die Blaetter der Baeume leise rascheln.\n");

AddDetail("winkel", 
  "Der Winkel, in dem der Apfelbaum steht, laesst den Platz ruhig und geschuetzt wirken, fast wie ein geheimer Garten.\n");

AddDetail("zweigen", 
  "Die Zweige des Apfelbaums sind weit ausladend und voll von gruenen Blaettern und roten, reifen Aepfeln.\n");

  AddDetail("baeume", 
  "Die Baeume um dich herum sind hoch und majestaetisch. Ihre Aeste breiten sich weit aus und werfen kuehlenden Schatten auf den Boden.\n");

AddDetail("bewegungen", 
  "Die Bewegungen der Blaetter und Aeste sind sanft und beruhigend, im Einklang mit dem leichten Wind.\n");

AddDetail("blaetter", 
  "Die Blaetter des Apfelbaums sind gruen und glaenzen im Sonnenlicht. Einige blaettern langsam vom Baum und fallen zu Boden.\n");

AddDetail("blumen", 
  "Zwischen dem Gras findest du vereinzelt kleine Blumen, die in allen Farben bluehen – von zarten weissen bis hin zu leuchtend roten und blauen Blueten.\n");

AddDetail("erinnerung", 
  "Es scheint, als koennte man die Erinnerung an den Fruehling und die Blueten des Apfelbaums noch im Luftzug spueren.\n");

AddDetail("farben", 
  "Die Farben hier sind lebendig und voller Leben – die saftigen gruenen Blaetter, die roten Aepfel und die bunten Blumen vermitteln ein harmonisches Bild.\n");

AddDetail("fruechten", 
  "Am Apfelbaum haengen viele reife, runde Fruechte. Ihre Haut schimmert im Licht der Sonne und verspricht eine koestliche Ernte.\n");

AddDetail("fuessen", 
  "Unter deinen Fuessen spuerst du das weiche Gras und die zerdrueckten Blaetter, die den Boden bedecken. Der Boden ist fest und stabil.\n");

AddDetail("garten", 
  "Dieser Ort fuehlt sich fast wie ein geheimer Garten an, ein ruhiger Rueckzugsort, der von der Aussenwelt unberuehrt bleibt.\n");

AddDetail("geduld", 
  "Der Weg durch das Dickicht erfordert Geduld, aber die Belohnung ist der ruhige, abgeschiedene Ort, an dem du dich nun befindest.\n");

AddDetail("gewicht", 
  "Das Gewicht der reifen Aepfel zieht die Aeste des Baumes in die Tiefe. Sie biegen sich unter der Last der Frucht.\n");

AddDetail("hain", 
  "Der Hain im Sueden bietet ein schattiges Versteck. Die Baeume hier sind hoch und alt, ihre Aeste bilden ein dichtes Dach ueber dir.\n");

AddDetail("natur", 
  "Die Natur um dich herum ist lebendig und unberuehrt. Hier wachsen Baeume, Blumen und Kraeuter, und die Tiere des Waldes sind immer in Bewegung.\n");

AddDetail("oase", 
  "Dieser Hain ist wie eine Oase inmitten des Waldes. Der ruhige, friedliche Ort laedt ein, innezuhalten und die Schoenheit der Natur zu geniessen.\n");

AddDetail("obsthain", 
  "Der Obsthain ist ein Garten voller Obstbaeume, die saftige Fruechte tragen. Du kannst das Rauschen der Blaetter und den Duft der reifen Aepfel in der Luft spueren.\n");

AddDetail("ort", 
  "Der Ort hier strahlt Ruhe aus. Es ist ein perfekter Platz, um einen Moment der Stille und des Friedens zu geniessen.\n");

AddDetail("raum", 
  "Der Raum, den der Obsthain bietet, fuehlt sich friedlich und unberuehrt an. Hier ist der Laerm des Waldes fern und die Zeit scheint stillzustehen.\n");

AddDetail("runden", 
  "Die Fische im Tuempel schwimmen in eleganten Runden und ziehen dabei kleine Wellen hinter sich her.\n");

AddDetail("schatten", 
  "Der Apfelbaum spendet angenehm kuehlen Schatten. Unter seinem Blaetterdach ist es ein angenehmer Ort, um sich vor der Sonne zu verstecken.\n");

AddDetail("sonne", 
  "Die Sonne strahlt warm und freundlich auf die Wiese, laesst das Gras glaenzen und die Aepfel am Baum in leuchtenden Farben erstrahlen.\n");

AddDetail("sonnenlicht", 
  "Das Sonnenlicht filtert durch das Blaetterdach und schafft ein angenehmes, warmes Licht auf dem Boden.\n");

AddDetail("teppichen", 
  "Das Moos auf dem Boden bildet weiche Teppiche, die sich angenehm unter deinen Fuessen anfuehlen.\n");

AddDetail("wald", 
  "Der Wald umgibt den Obsthain und bildet eine dichte, schuetzende Grenze. Durch das Dickicht kann man vereinzelt die Geraeusche der Tiere hoeren.\n");

AddDetail("weg", 
  "Der Weg durch das Dickicht ist schmal, aber er fuehrt dich zu den verborgenen Ecken des Hains, wo der Apfelbaum und der Tuempel zu finden sind.\n");

AddDetail("windstoss", 
  "Ein Windstoss zieht durch den Obsthain und laesst die Blaetter und Aeste des Apfelbaums leise knarren.\n");

AddDetail("wolken", 
  "Der Himmel ist groesstenteils klar, aber einige Wolken ziehen langsam vorueber und verdunkeln fuer einen Moment die Sonne.\n");

AddDetail("zweige", 
  "Die Zweige des Apfelbaums sind dick und fest. Sie tragen die Last der Aepfel und lassen sich im Wind hin und wieder bewegen.\n");

  AddDetail("aussenwelt", "Von hier aus hoert man nur leise Geraeusche aus der Aussenwelt, die den Frieden nicht stoeren.\n");
  AddDetail("baum", "Der Apfelbaum ist gross und kraeftig, seine Aeste biegen sich unter der Last der Fruechte.\n");
  AddDetail("belohnung", "Die Belohnung fuer das Warten ist der koestliche Geschmack eines frisch gepflueckten Apfels.\n");
  AddDetail("bewegung", "Die sanften Bewegungen der Aeste im Wind schaffen ein beruhigendes Bild.\n");
  AddDetail("bild", "Das Bild des Apfelbaums im Sonnenlicht ist friedlich und einladend.\n");
  AddDetail("blaetterdach", "Das Blaetterdach des Baumes spendet angenehmen Schatten und schuetzt vor der Sonne.\n");
  AddDetail("dach", "Das dichte Dach aus Aesten und Blaettern schuetzt dich vor dem Regen.\n");
  AddDetail("ecken", "In den Ecken des Hains findest du einladende, schattige Plaetze zum Ausruhen.\n");
  AddDetail("einklang", "Alles scheint im Einklang zu sein – der Wind, die Baeume und die Tiere des Waldes.\n");
  AddDetail("ernte", "Die Ernte der Aepfel ist reich, die Baeume tragen viele saftige Fruechte.\n");
  AddDetail("friedens", "Dieser Ort strahlt eine tiefe Ruhe und Frieden aus.\n");
  AddDetail("frucht", "Die Aepfel sind reif und prall, bereit, gepflueckt zu werden.\n");
  AddDetail("fruechte", "Die Baeume tragen viele Fruechte, deren Duft die Luft erfuellt.\n");
  AddDetail("fruehling", "Der Fruehling bringt neues Leben in den Obsthain, mit vielen frischen Blaettern und Blueten.\n");
  AddDetail("geraeusche", "Das Rascheln der Blaetter und das Zwitschern der Voegel sind die einzigen Geraeusche hier.\n");
  AddDetail("grenze", "Der Hain wird von dichtem Wald umgeben, der wie eine natuerliche Grenze wirkt.\n");
  AddDetail("haut", "Die Sonne fuehlt sich angenehm auf deiner Haut an, waehrend du unter dem Baum stehst.\n");
  AddDetail("kraeuter", "Am Rand des Hains wachsen wilde Kraeuter, die einen frischen Duft verstroemen.\n");
  AddDetail("laerm", "Der Laerm der Welt ist hier weit entfernt, es herrscht nur sanfte Stille.\n");
  AddDetail("last", "Die Aeste des Baumes biegen sich unter der Last der schweren Aepfel.\n");
  AddDetail("leben", "Das Leben hier ist ruhig und in perfektem Einklang mit der Natur.\n");
  AddDetail("licht", "Das Licht der Sonne bricht sanft durch das Blaetterdach und malt Muster auf den Boden.\n");
  AddDetail("luftzug", "Ein leichter Luftzug bewegt die Blaetter und sorgt fuer eine angenehme Erfrischung.\n");
  AddDetail("moment", "Dieser Moment der Ruhe ist kostbar und laedt zum Verweilen ein.\n");
  AddDetail("obstbaeume", "Die Obstbaeume im Hain tragen reiche Fruechte, die das Bild dieses friedlichen Ortes vervollstaendigen.\n");
  AddDetail("rauschen", "Das Rauschen des Windes in den Blaettern klingt beruhigend und laesst den Ort lebendig wirken.\n");
  AddDetail("rueckzugsort", "Der Obsthain ist ein idealer Rueckzugsort, um dem Alltag zu entfliehen.\n");
  AddDetail("ruhe", "Die Ruhe des Ortes ist tief und vollkommen, hier gibt es keine stoerenden Geraeusche.\n");
  AddDetail("schoenheit", "Die Schoenheit des Hains zieht dich sofort in ihren Bann.\n");
  AddDetail("stille", "Die Stille hier ist fast greifbar, nur unterbrochen von den natuerlichen Geraeuschen des Waldes.\n");
  AddDetail("teppiche", "Das Moos und die Blaetter auf dem Boden bilden weiche Teppiche, die den Raum noch gemuetlicher machen.\n");
  AddDetail("tiefe", "Der Wald rund um den Hain vermittelt ein Gefuehl der tiefen Abgeschiedenheit und Geborgenheit.\n");
  AddDetail("tiere", "Voegel, Eichhoernchen und andere Tiere des Waldes bewegen sich leise durch den Hain.\n");
  AddDetail("versteck", "Der Hain ist ein perfektes Versteck fuer alle, die Ruhe suchen.\n");
  AddDetail("wellen", "Im Tuempel schwimmen sanfte Wellen, die von den Fischen verursacht werden.\n");
  AddDetail("wiese", "Die Wiese rund um den Apfelbaum ist weich und von Blumen durchzogen.\n");
  AddDetail("zeit", "Die Zeit scheint hier langsamer zu vergehen, als ob sie sich der Ruhe des Ortes anpasst.\n");
  AddDetail("abgeschiedenheit", "Die Abgeschiedenheit des Ortes laesst dich vollstaendig vom Alltag entfliehen.\n");
AddDetail("alltag", "Der Alltag scheint hier weit entfernt, in dieser ruhigen Oase.\n");
AddDetail("ausruhen", "Dieser Ort laedt ein, sich auszuruhen und die Stille zu geniessen.\n");
AddDetail("bann", "Die friedliche Atmosphaere des Hains zieht dich in ihren Bann.\n");
AddDetail("eichhoernchen", "Ein Eichhoernchen huscht flink zwischen den Baeumen umher.\n");
AddDetail("erfrischung", "Der leichte Wind bringt eine erfrischende Kuehle in die warme Luft.\n");
AddDetail("frieden", "Der Frieden hier ist tief, nichts stoert den ruhigen Fluss der Zeit.\n");
AddDetail("geborgenheit", "Die Geborgenheit des Ortes umhuellt dich wie eine warme Decke.\n");
AddDetail("gefuehl", "Ein Gefuehl von Ruhe und Zufriedenheit durchstroemt dich.\n");
AddDetail("geschmack", "Der Geschmack eines frischen Apfels ist suess und saftig.\n");
AddDetail("muster", "Das Licht malt sanfte Muster auf den Boden zwischen den Blaettern.\n");
AddDetail("naehe", "In der Naehe plaetschert leise der Tuempel, das einzige Geraeusch.\n");
AddDetail("plaetze", "Es gibt viele einladende Plaetze zum Verweilen und Entspannen.\n");
AddDetail("regen", "Der Regen beginnt sanft auf die Blaetter zu trommeln und verleiht dem Ort eine frische Atmosphaere.\n");
AddDetail("verweilen", "Du wirst von einem unbestimmten Drang zum Verweilen erfasst.\n");
AddDetail("warten", "Hier ist Warten kein Verlust von Zeit, sondern ein Genuss der Ruhe.\n");
AddDetail("welt", "Die Welt ausserhalb des Hains scheint weit entfernt und bedeutungslos.\n");
AddDetail("zwitschern", "Das Zwitschern der Voegel ist die einzige Musik in diesem Ort der Stille.\n");

  

  AddExit( "westen", ROOM("ap_j08") );
  AddExit( "norden", ROOM("ap_k07"));
  AddExit( "suedosten", ROOM("ap_l09"));
  SetProp(P_HIDE_EXITS, ({"suedosten"})); // muss man freiforschen

  AddItem( "/d/ebene/Park/npc/bmeise", REFRESH_DESTRUCT);

  AddCmd("schuettel|schuettle&baum|apfelbaum", "cmd_schuetteln", "Was willst du schuetteln?");
  AddCmd("pfluecke|pflueck&apfel|aepfel", "cmd_pfluecken", "Was willst du pfluecken?");

  apples = 5; // Maximal 5 Aepfel verfuegbar
}

public int cmd_pfluecken() {
  write(BS("Die Aepfel sind zu hoch oben! So kommst du nicht ran."));
  return 1;
}

// Funktion zum Schuetteln des Apfelbaums und Ernte der Aepfel
public int cmd_schuetteln(string str) {
  object ob;

  if (str != "apfelbaum" && str != "baum") {
    write("Was willst du schuetteln?\n");
    return 1;
  }

  if (apples <= 0) {
    write("Der Apfelbaum hat keine Aepfel mehr zu bieten.\n");
    return 1;
  }

  ob = clone_object(NPC("apfel"));
  if (ob->move(TP) != 1) {
    write("Du findest einen Apfel, laesst ihn aber liegen, weil du ihn nicht tragen kannst.\n");
    destruct(ob);
    return 1;
  }

  apples--;  // Einen Apfel entfernt

  write("Du schuettelst den Apfelbaum kraeftig, und ein roter Apfel faellt zu Boden.\n");
  tell_room(TO, TP->query_name() + " schuettelt den Apfelbaum und faengt einen Apfel.\n", ({ TP }));
  return 1;
}


public void reset() {
  ::reset();
  tell_room(TO, BS("Ein paar Aepfel werden reif."));
  apples = 5;
}