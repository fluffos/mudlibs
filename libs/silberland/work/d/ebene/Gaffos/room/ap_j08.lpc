



#include "../gaffos.h"

inherit "std/room";

#include <properties.h>

int marille;

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Im Obsthain der Gaffos" );
  SetProp( P_INT_LONG,
    "Du befindest dich hier in einem kleinen Obsthain. Hier wachsen ein paar "
    "duftende Marillenbaeume. Unter einem der Baeume wurde ein kleiner Laubhaufen "
    "zusammengetragen. Nach Sueden hin fuehrt ein ausgetretener Weg entlang einer "
    "dichten Hecke.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "haufen", "laubhaufen" }),
    "Dieser Laubhaufen ist das perfekte Igelversteck.");

  AddDetail( ({"versteck", "igelversteck"}),
    "Es dient sicherlich einem kleinen Igel als Versteck!");

  AddDetail( ({"igel"}),
    "Hm. Keiner zuhause.");

    AddDetail("baeume", "Die Baeume tragen gruene Blaetter und wachsen dicht zusammen.\n");
    AddDetail("boden", "Der Boden ist von Laub bedeckt und weich unter den Fuessen.\n");
    AddDetail("hecke", "Eine dichte Hecke grenzt den Obsthain ab.\n");
    AddDetail("himmel", "Der Himmel ist klar und von wenigen Wolken bedeckt.\n");
    AddDetail("marillenbaeume", "Die Marillenbaeume tragen reife, duftende Fruechte.\n");
    AddDetail("obsthain", "Der Obsthain ist ruhig, mit bluehenden Baeumen und fruchtbaren Straeuchern.\n");
    AddDetail("weg", "Der Weg ist von Laub bedeckt und fuehrt suedlich entlang der Hecke.\n");
    
    AddDetail(({"blaetter", "blaetterdach"}), "Die Blaetter rauschen sanft im Wind und spiegeln das Licht.\n");
    AddDetail("fruechte", "Die Fruechte der Baeume sind reif und duften verlockend.\n");
    AddDetail("fue", "Der Boden ist weich und der Weg wird gut sichtbar durch haeufige Nutzung.\n");
    AddDetail("laub", "Das Laub bildet einen dicken Teppich auf dem Boden.\n");
    AddDetail("straeuchern", "Dichte Straeucher wuchern zwischen den Baeumen.\n");
    AddDetail("wolken", "Vereinzelt ziehen Wolken ueber den Himmel.\n");

    AddDetail("fuessen", "Das Gras fuehlt sich weich und feucht unter deinen Fuessen an.\n");
AddDetail("licht", "Das Licht bricht sich durch das Blaetterdach.\n");
AddDetail("straeucher", "Die Straeucher wachsen dicht und gruen, ihre Zweige biegen sich im Wind.\n");
AddDetail("zweige", "Komplett abgeerntet.");
AddDetail("teppich", "Der Boden ist von einem Teppich aus Laub und Moos bedeckt.\n");
AddDetail("wind", "Ein leichter Wind streicht durch die Baeume und bringt die Blaetter zum Rascheln.\n");
AddDetail(({"gras", "moos"}), "Saftig und gruen.");


    


  AddExit( "nordwesten", ROOM("ap_i07") );
  AddExit( "osten", ROOM("ap_k08"));
  AddExit( "sueden", ROOM("ap_j09"));
  AddExit( "norden", ROOM("ap_j07"));

  AddItem( "/d/ebene/Park/npc/igel" , REFRESH_DESTRUCT);

  AddCmd("pfluecke|pflueck&marillen|frucht|marille", "cmd_pfluecken", "Was willst du pfluecken?");

  marille = 1;

}

public int cmd_pfluecken() {
  object ob;
  if (!marille) {
    write("Es gibt keine reifen Marillen mehr zum Pfluecken.\n");
    return -1;
  }

  ob = clone_object("/d/wasser/woody/obj/marille");
  if (ob->move(TP) != 1) {
    write("Du pflueckst eine Marille und laesst sie dort liegen, weil du sie nicht tragen kannst.\n");
    destruct(ob);
    return -1;
  }

  write("Du pflueckst eine reife, duftende Marille.\n");
  marille = 0;
  return 1;
}

public void reset() {
  ::reset();
  marille = 1;
}

