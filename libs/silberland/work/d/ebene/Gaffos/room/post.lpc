inherit "/std/post";

#include <properties.h>
#include "files.h"

create()
{
  ::create();

  // Basisraum-Eigenschaften
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));
  SetProp(P_INT_SHORT, "Die Posthuette des Gaffodorfs");
  SetProp(P_INT_LONG,
    "Du stehst im kleinen, bescheidenen Postamt des Gaffodorfs. Diese einfache "
    "Holzhuette ist ein zentraler Treffpunkt, um Nachrichten und Briefe zwischen "
    "den Bewohnern des Dorfes zu verschicken. Der Boden ist aus festgestampfter Erde, "
    "die von den zahlreichen Schritten der Gaffos leicht glaenzt. An der Rueckwand steht "
    "ein massiver Holztisch, hinter dem der Gaffopostmeister seinen Dienst verrichtet, "
    "umgeben von Stapeln kleiner Briefe und Paeckchen. Ein schwaches Licht dringt durch "
    "die winzigen Fenster, und die Luft ist erfuellt vom leisen Rascheln von Papier und "
    "dem beruhigenden Knistern eines kleinen Kamins.");

  // Details
  AddDetail("boden", "Der Boden ist aus festgestampfter Erde und glaenzt leicht durch die vielen Schritte.\n");
  AddDetail("erdboden", "Der Erdboden ist glattgetreten und wirkt hart und robust.\n");
  AddDetail("waende", "Die Waende sind aus groben Holzplanken gefertigt und wirken schlicht und rustikal.\n");
  AddDetail("decke", "Die Decke ist aus Holzbohlen gefertigt und leicht von Rauch geschwaerzt.\n");
  AddDetail("huette", "Die kleine Holzhuette ist einfach und funktional gebaut, aber gemuetlich.\n");
  AddDetail("postamt", "Ein kleiner Ort, an dem Briefe und Paeckchen verarbeitet werden.\n");
  AddDetail("gaffodorfs", "Das Dorf der Gaffos, das bekannt fuer seine Einfachheit und Bescheidenheit ist.\n");
  AddDetail("postmeister", "Ein freundlicher Gaffo, der stets bemueht ist, die Post schnell zu sortieren.\n");
  AddDetail("tisch", "Ein robuster Holztisch, der mit Briefen und Paeckchen beladen ist.\n");
  AddDetail("briefe", "Stapel kleiner Briefe, die darauf warten, verschickt oder abgeholt zu werden.\n");
  AddDetail("paeckchen", "Kleine Pakete, die sorgsam auf dem Tisch gestapelt sind.\n");
  AddDetail("fenster", "Die kleinen Fenster lassen gerade genug Licht hinein, um den Raum zu erhellen.\n");
  AddDetail("kamin", "Der kleine Kamin spendet Waerme und sorgt fuer eine angenehme Atmosphaere.\n");
  AddDetail("licht", "Ein schwaches Licht dringt durch die Fenster und den Raum, ergaenzt durch das Kaminfeuer.\n");
  AddDetail("luft", "Die Luft riecht nach Rauch und altem Papier, was dem Raum eine besondere Note verleiht.\n");
  AddDetail("schritte", "Die zahlreichen Schritte der Gaffos haben den Erdboden glattgetreten.\n");
  AddDetail("gaffos", "Die Bewohner des Dorfes, die ihre Post hier abholen und abgeben.\n");
  AddDetail("stapel", "Die Briefe und Paeckchen sind ordentlich in kleinen Stapeln sortiert.\n");
  AddDetail("geruch", "Ein angenehmer Mix aus Rauch und altem Papier liegt in der Luft.\n");
  AddDetail("papier", "Das Rascheln von Papier erfuellt den Raum, waehrend der Postmeister arbeitet.\n");
  AddDetail("post", "Hier kannst du deine Briefe verschicken und empfangen.\n");
  AddDetail(({"atmosphaere"}),
    "Die Atmosphaere im Postamt ist ruhig und gelassen, waehrend die Gaffos ihrer Post nachgehen.");

AddDetail(({"bescheidenheit"}),
    "Die Bescheidenheit des Postamtes spiegelt den einfachen Lebensstil der Gaffos wider.");

AddDetail(({"bewohner", "bewohnern"}),
    "Die Bewohner des Gaffodorfs nutzen das Postamt, um ihre Nachrichten und Pakete zu verschicken.");

AddDetail(({"dienst"}),
    "Der Gaffopostmeister versieht seinen Dienst mit Sorgfalt und Aufmerksamkeit.");

AddDetail(({"dorf", "dorfes"}),
    "Das Gaffodorf ist ein Ort voller Einfachheit und Gemeinschaft, und das Postamt ist ein wichtiger Treffpunkt.");

AddDetail(({"duft"}),
    "Ein angenehmer Duft von Rauch und altem Papier liegt in der Luft.");

AddDetail(({"einfachheit"}),
    "Die Einfachheit des Postamtes zeigt sich in seiner funktionalen, aber gemuetlichen Gestaltung.");

AddDetail(({"erde"}),
    "Der Boden aus festgestampfter Erde erzaehlt von der langjaehrigen Nutzung durch die Bewohner.");

AddDetail(({"gaffo", "gaffopostmeister"}),
    "Der Gaffopostmeister ist ein freundlicher Gaffo, der mit Hingabe seiner Aufgabe nachgeht.");

AddDetail(({"geraeusch"}),
    "Das leise Rascheln von Papier ist das vorherrschende Geraeusch im Postamt.");

AddDetail(({"holzbohlen"}),
    "Die Holzbohlen der Decke sind einfach, aber stabil, und leicht von Rauch geschwaerzt.");

AddDetail(({"holzhuette"}),
    "Die Holzhuette ist schlicht gebaut, bietet jedoch alles Notwendige fuer das Dorfpostamt.");

AddDetail(({"holzplanken"}),
    "Die Waende bestehen aus rustikalen Holzplanken, die dem Raum ein gemuetliches Flair verleihen.");

AddDetail(({"holztisch"}),
    "Der massive Holztisch ist der Mittelpunkt des Postamtes, beladen mit Briefen und Paeckchen.");

AddDetail(({"kaminfeuer"}),
    "Das kleine Kaminfeuer sorgt fuer eine warme und beruhigende Atmosphaere.");

AddDetail(({"knistern"}),
    "Das Knistern des Kamins erfuellt den Raum und gibt ihm eine behagliche Stimmung.");

AddDetail(({"mix"}),
    "Der Mix aus Rauch und dem Duft alten Papiers verleiht dem Postamt seinen unverkennbaren Charme.");

AddDetail(({"nachrichten"}),
    "Die Gaffos schicken und empfangen hier Nachrichten von anderen Dorfbewohnern und Reisenden.");

AddDetail(({"note"}),
    "Die besondere Note des Postamtes entsteht durch seine Schlichtheit und die hingebungsvolle Arbeit des Postmeisters.");

AddDetail(({"ort"}),
    "Das Postamt ist ein wichtiger Ort im Dorf, der von allen Gaffos genutzt wird.");

AddDetail(({"pakete"}),
    "Die sorgfaeltig gestapelten Pakete warten darauf, verschickt oder abgeholt zu werden.");

AddDetail(({"raum"}),
    "Der Raum ist klein, aber effizient genutzt, um alle Aufgaben eines Postamtes zu erfuellen.");

AddDetail(({"rueckwand"}),
    "An der Rueckwand steht der Holztisch des Postmeisters, umgeben von Briefen und Paeckchen.");

AddDetail(({"treffpunkt"}),
    "Das Postamt ist ein zentraler Treffpunkt, an dem sich die Gaffos versammeln, um Postangelegenheiten zu erledigen.");

AddDetail(({"waerme"}),
    "Die Waerme des Kamins sorgt fuer eine einladende Atmosphaere im Postamt.");

AddDetail(({"wand", "waende"}),
    "Die Waende aus groben Holzplanken verleihen dem Raum ein rustikales und gemuetliches Ambiente.");
    AddDetail(({"ambiente"}), 
    "Das Ambiente des Postamtes ist ruhig und einladend, perfekt fuer die Erledigung der Postangelegenheiten.");

AddDetail(({"arbeit"}), 
    "Die Arbeit des Gaffopostmeisters besteht aus dem Sortieren und Verteilen von Briefen und Paketen.");

AddDetail(({"aufgabe"}), 
    "Die Aufgabe des Postamtes ist es, die Kommunikation innerhalb des Dorfes und darueber hinaus zu erleichtern.");

AddDetail(({"aufmerksamkeit"}), 
    "Mit grosser Aufmerksamkeit widmet sich der Postmeister seiner Arbeit, um jeden Brief und jedes Paket sorgfaeltig zu behandeln.");

AddDetail(({"charme"}), 
    "Der Charme des Postamtes liegt in seiner Einfachheit und der Herzlichkeit, die es ausstrahlt.");

AddDetail(({"dorfbewohnern"}), 
    "Den Dorfbewohnern dient das Postamt als Ort, um ihre Nachrichten und Paeckchen auszutauschen.");

AddDetail(({"dorfpostamt"}), 
    "Das Dorfpostamt ist ein kleiner, aber bedeutender Ort im Gaffodorf, der die Gemeinschaft verbindet.");

AddDetail(({"flair"}), 
    "Das rustikale Flair des Postamtes wird durch die Holzplanken, den Erdboden und den warmen Kamin unterstrichen.");

AddDetail(({"gaffodorf"}), 
    "Das Gaffodorf ist bekannt fuer seine Herzlichkeit und Gemeinschaft – Werte, die sich auch im Postamt widerspiegeln.");

AddDetail(({"gemeinschaft"}), 
    "Die Gemeinschaft der Gaffos kommt im Postamt zusammen, um Neuigkeiten auszutauschen und Post zu verschicken.");

AddDetail(({"gestaltung"}), 
    "Die Gestaltung des Postamtes ist einfach und funktional, aber dennoch warm und einladend.");

AddDetail(({"hingabe"}), 
    "Mit Hingabe sortiert der Postmeister die Briefe und sorgt dafuer, dass alles seinen richtigen Weg findet.");

AddDetail(({"lebensstil"}), 
    "Der Lebensstil der Gaffos zeigt sich in der Bescheidenheit und Funktionalitaet des Postamtes.");

AddDetail(({"mittelpunkt"}), 
    "Der massive Holztisch ist der Mittelpunkt des Postamtes, an dem alle Aufgaben erledigt werden.");

AddDetail(({"notwendige"}), 
    "Das Postamt bietet alles Notwendige, um die Kommunikation im Dorf aufrechtzuerhalten.");

AddDetail(({"nutzung"}), 
    "Die langjaehrige Nutzung des Postamtes zeigt sich in den abgenutzten Holzplanken und dem glattgetretenen Erdboden.");

AddDetail(({"postangelegenheiten"}), 
    "Im Postamt werden alle Postangelegenheiten der Dorfbewohner und Reisenden organisiert.");

AddDetail(({"reisenden"}), 
    "Auch Reisende nutzen das Postamt, um Nachrichten zu versenden oder in Kontakt mit anderen zu bleiben.");

AddDetail(({"schlichtheit"}), 
    "Die Schlichtheit des Postamtes spiegelt die einfache Lebensweise der Gaffos wider.");

AddDetail(({"sorgfalt"}), 
    "Mit grosser Sorgfalt kuemmert sich der Postmeister um jedes Detail seiner Arbeit.");

AddDetail(({"stimmung"}), 
    "Die warme Stimmung des Postamtes wird durch das Knistern des Kamins und die ruhige Atmosphaere erzeugt.");


  // Geraeusche und Gerueche
  AddSound(DEFAULT_SOUND, "Das leise Rascheln von Papier und das Knistern des Kamins sind zu hoeren.\n");
  AddSound("rascheln", "Das Geraeusch von Papier, das bewegt oder sortiert wird.\n");
  AddSound("kamin", "Das beruhigende Knistern des Kamins erfuellt den Raum.\n");
  AddSmell(DEFAULT_SMELL, "Ein leichter Geruch von Rauch und altem Papier liegt in der Luft.\n");
  AddSmell("rauch", "Der Rauch des Kamins verleiht dem Raum eine gemuetliche Atmosphaere.\n");
  AddSmell("papier", "Der Duft von altem Papier ist ueberall zu spueren.\n");

  // Exits
  AddExit("osten", ROOM("weg_h5"));

  // Gegenstaende
  AddItem("/std/postschalter");
  //AddItem(NPC("postmeister"), REFRESH_REMOVE);
}
