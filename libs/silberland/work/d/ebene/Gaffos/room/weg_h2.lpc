#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Gaffos/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf einem Dorfweg");
  SetProp (P_INT_LONG,
    "Du stehst mitten auf einem breiten, staubigen Dorfweg inmitten der "+
    "Gaffosiedlung. Nach Westen kannst Du einen kleinen Laden betreten, "+
    "waehrend sich weiter nach Sueden hin ein kleiner, von aufgeregten "+
    "Stimmen erfuellter Marktplatz erstreckt.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden", "dorfweg", "weg"}),
    "Der aus ausgetrampeltem Lehm bestehende Boden ist ziemlich staubig, "+
    "aber sonst relativ sauber. Offenbar wird er hier regelmaessig "+
    "geraeumt.");
  AddDetail ( ({"lehm"}),
    "Alter, ausgetrampelter Lehm, nicht weiter untersuchenswert.");
  AddDetail ( ({"huette", "laden"}),
    "Die kleine Huette im Westen wirkt klein und wackelig. Sie beherbergt "+
    "einen kleinen Laden, in dem man allerlei brauchbares und unbrauchbares "+
    "Zeug kaufen kann.");
  AddDetail ( ({"marktplatz", "platz"}),
    "Du kannst einige Staende auf dem Marktplatz erkennen. Aufgeregte "+
    "Stimmen fuellen ihn mit Leben.");
  AddDetail ( ({"stimmen"}),
    "Probier's mal mit lausche!");
  AddSound ( ({DEFAULT_SOUND, "stimmen"}),
    "Die Stimmen, die vom Marktplatz herueber erschallen, scheinen "+
    "aufgeregte weltbewegende Diskussionen zu fuehren...");
  AddSound ( ({"diskussionen"}),
    "Es geht wohl um faule Fische, ueberzogene Preise, und Gott und die "+
    "Welt.");
  AddSmell ( ({DEFAULT_SMELL}),
    "Du kannst den Markt im Sueden direkt riechen. Neben frischem Gemuese "+
    "schleicht sich aber auch der etwas unangenehme Geruch von Fischen in "+
    "Deine Nase.");
  AddSmell ( ({"gemuese"}),
    "Der Geruch von frischem Gemuese laesst Dich nicht los.");
  AddSmell ( ({"fisch", "fische"}),
    "Fische sind zwar was feines, aber wenn ihr Geruch schon etwas faulig "+
    "ist, und sie noch dazu auf einem Markt verkauft werden, fuehrt das mit "+
    "Gewissheit zu heftigen Diskussionen. Und genau die hoerst Du auch vom "+
    "Sueden her...");
  AddDetail ( ({"gaffosiedlung", "siedlung"}),
    "Du stehst mittendrin.");
  AddDetail ( ({"zeug"}),
    "Das siehst Du viel besser, wenn Du den Laden mal betrittst.");
    AddDetail("geruch", "Der Geruch von frischem Gemuese und fauligen Fischen haengt in der Luft.");
    AddDetail("gewissheit", "Es ist sicher, dass die Diskussionen um die Fischpreise heftig sind.");
    AddDetail("gott", "Es wird lautstark ueber alles Moegliche diskutiert, sogar ueber Gott.");
    AddDetail("himmel", "Der Himmel ist bewoelkt und grau.");
    AddDetail("leben", "Der Marktplatz ist voller Leben, mit vielen Stimmen und Bewegungen.");
    AddDetail("markt", "Der Marktplatz ist ein belebter Ort voller Staende und Gerueche.");
    AddDetail("nase", "Deine Nase wird von den intensiven Geruechen des Marktes beansprucht.");
    AddDetail("preise", "Die Preise fuer die Waren auf dem Markt scheinen uebertrieben.");
    AddDetail("staende", "Du siehst mehrere Staende, die allerlei Waren anbieten.");
    AddDetail("welt", "Es scheint, als wuerde hier ueber die ganze Welt gesprochen werden.");
    AddDetail("bewegungen", "Der Markt ist voll von staendigen Bewegungen der Haendler und Kaeufer.");
AddDetail("fischpreise", "Die Fischpreise sorgen fuer hitzige Diskussionen auf dem Marktplatz.");
AddDetail("gerueche", "Die Gerueche von frischem Gemuese und fauligen Fischen vermischen sich in der Luft.");
AddDetail("luft", "Die Luft ist schwer und warm, durchzogen von den Dueften des Marktes.");
AddDetail("moegliche", "Moegliche Angebote und Geschaefte lassen die Haendler immer wieder lautstark verhandeln.");
AddDetail("ort", "Der Marktplatz ist der belebteste Ort der Gaffosiedlung.");
AddDetail("waren", "Die Waren auf dem Markt reichen von frischen Lebensmitteln bis zu wertlosen Krimskrams.");
    AddDetail( ({"angebote", "geschaefte", "haendler", "kaeufer", "krimskrams","lebensmitteln"}),
    "Dazu solltest du naeher gehen.");
  // DETAILS END

  // EXITS START
  AddItem( NPC("gaffo"), REFRESH_DESTRUCT );
  AddItem( NPC("gaffo"), REFRESH_DESTRUCT );
  AddExit ("norden", ROOM("room_h01"));
  AddExit ("westen", ROOM("laden"));
  AddExit ("suedwesten", ROOM("weg_g3"));
  AddExit ("sueden", ROOM("markt"));
  AddExit ("suedosten", ROOM("weg_i3"));
  // EXITS END

  // ITEMS START
  // ITEMS END

}
