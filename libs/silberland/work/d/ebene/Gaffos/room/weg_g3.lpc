#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Gaffos/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf einem Dorfweg");
  SetProp (P_INT_LONG,
    "Du gehst auf einem breiten Dorfweg entlang, der sich nach Osten hin "+
    "zu einem grossen Marktplatz oeffnet und nach Sueden weiter in die "+
    "Wohngegend der Siedlung hineinfuehrt. Richtung Nordosten scheint der "+
    "Weg weiter raus aus der Siedlung zu fuehren.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden", "dorfweg", "weg"}),
    "Der aus ausgetrampeltem Lehm bestehende Boden ist ziemlich staubig, "+
    "aber sonst relativ sauber. Offenbar wird er hier regelmaessig "+
    "geraeumt.");
  AddDetail ( ({"lehm"}),
    "Alter, ausgetrampelter Lehm, nicht weiter untersuchenswert.");
  AddDetail ( ({"marktplatz", "platz"}),
    "Du kannst einige Staende auf dem Marktplatz erkennen. Aufgeregte "+
    "Stimmen fuellen ihn mit Leben.");
  AddDetail ( ({"stimmen"}),
    "Probier's mal mit lausche!");
  AddSound ( ({DEFAULT_SOUND, "stimmen"}),
    "Die Stimmen, die vom Marktplatz herueber erschallen, scheinen "+
    "aufgeregte weltbewegende Diskussionen zu fuehren...");
  AddSound ( ({"diskussionen"}),
    "Es geht wohl um faule Fische, ueberzogene Preise, und Gott und die "+
    "Welt.");
  AddSmell ( ({DEFAULT_SMELL}),
    "Du kannst den Markt im Osten direkt riechen. Neben frischem Gemuese "+
    "schleicht sich aber auch der etwas unangenehme Geruch von Fischen in "+
    "Deine Nase.");
  AddSmell ( ({"gemuese"}),
    "Der Geruch von frischem Gemuese laesst Dich nicht los.");
  AddSmell ( ({"fisch", "fische"}),
    "Fische sind zwar was feines, aber wenn ihr Geruch schon etwas faulig "+
    "ist, und sie noch dazu auf einem Markt verkauft werden, fuehrt das mit "+
    "Gewissheit zu heftigen Diskussionen. Und genau die hoerst Du auch vom "+
    "Osten her...");

    AddDetail("geruch", 
    "Ein Mix aus frischem Gemuese und fauligem Fisch liegt in der Luft.");
AddDetail("gewissheit", 
    "Hier fuehren die Gerueche wohl oft zu Streit auf dem Markt.");
AddDetail("gott", 
    "Die Diskussionen betreffen wirklich alles, sogar Gott und die Welt.");
AddDetail("himmel", 
    "Der Himmel ist klar und weit ueber der Siedlung.");
AddDetail("leben", 
    "Auf dem Marktplatz herrscht quirliges Leben.");
AddDetail("markt", 
    "Ein bunter Markt mit regem Treiben im Osten.");
AddDetail("nase", 
    "Deine Nase wird von frischem Gemuese und Fischgeruechen gereizt.");
AddDetail("preise", 
    "Die Preise auf dem Markt scheinen ein Dauerthema zu sein.");
AddDetail("siedlung", 
    "Eine kleine, lebendige Ansammlung von einfachen Haeusern.");
AddDetail("staende", 
    "Verschiedene Marktstaende bieten ihre Waren feil.");
AddDetail("welt", 
    "Alles moegliche wird hier diskutiert, von Fischen bis zur Weltpolitik.");
AddDetail("wohngegend", 
    "Die Wohngegend der Siedlung wirkt ruhig und einfach.");
    AddDetail("ansammlung", 
    "Eine Ansammlung kleiner, einfacher Haeuser praegt die Siedlung.");
AddDetail("dauerthema", 
    "Die Preise auf dem Markt scheinen ein ewiges Dauerthema zu sein.");
AddDetail("fischgeruechen", 
    "Ein leichter Hauch von Fischgeruechen liegt in der Luft.");
AddDetail("gerueche", 
    "Die Mischung aus frischem Gemuese und Fisch bestimmt die Luft.");
AddDetail("haeusern", 
    "Die Haeuser der Siedlung sind klein und schlicht.");
AddDetail("luft", 
    "Die Luft ist gefuellt mit Marktgeruechen und dem Duft des Dorflebens.");
AddDetail("marktstaende", 
    "Verschiedene Marktstaende locken mit ihren Waren.");
AddDetail("mix", 
    "Ein interessanter Mix aus frischen und weniger frischen Geruechen.");
AddDetail("streit", 
    "Hier scheint der Streit um Preise und Qualitaet zur Tagesordnung zu gehoeren.");
AddDetail("treiben", 
    "Das rege Treiben auf dem Markt zieht die Aufmerksamkeit auf sich.");
AddDetail("waren", 
    "Die Staende bieten eine bunte Vielfalt an Waren an.");
AddDetail("weltpolitik", 
    "Sogar weltpolitische Themen finden hier ihren Platz in den Diskussionen.");

    AddDetail("aufmerksamkeit", 
    "Das bunte Treiben auf dem Markt zieht sofort die Aufmerksamkeit auf sich.");
AddDetail("dorflebens", 
    "Der Markt ist ein lebendiger Mittelpunkt des Dorflebens.");
AddDetail("duft", 
    "Ein Duft aus frischem Gemuese und fischigem Hauch liegt in der Luft.");
AddDetail("haeuser", 
    "Die Haeuser hier sind einfach gebaut, aber voller Charme.");
AddDetail("hauch", 
    "Ein schwacher Hauch von Fischgeruch ist wahrnehmbar.");
AddDetail("marktgeruechen", 
    "Die Marktgerueche sind eine Mischung aus Frische und etwas Strengerem.");
AddDetail("mischung", 
    "Eine Mischung aus Duft und Lachen fuellt die Luft.");
AddDetail("qualitaet", 
    "Die Qualitaet der Waren ist das zentrale Thema auf dem Markt.");
AddDetail("tagesordnung", 
    "Diskussionen und Streitereien stehen hier auf der Tagesordnung.");
AddDetail("themen", 
    "Von Preisen bis zu Politik – hier wird alles besprochen.");
AddDetail("vielfalt", 
    "Eine beeindruckende Vielfalt an Waren findet sich auf den Staenden.");

    AddDetail("charme", "Der Markt zieht mit seinem Charme an.");
AddDetail("fischgeruch", "Ein intensiver Fischgeruch liegt in der Luft.");
AddDetail("frische", "Frische Waren dominieren das Angebot.");
AddDetail("lachen", "Lachen hallt ueber den Markt.");
AddDetail("marktgerueche", "Marktgerueche mischen sich in der Luft.");
AddDetail("mittelpunkt", "Der Markt ist das Zentrum des Dorfes.");
AddDetail("politik", "Auch Politik wird hier laut diskutiert.");
AddDetail("streitereien", "Streitereien gehoeren dazu.");
AddDetail("strengerem", "Ein strenger Geruch mischt sich ein.");
AddDetail("thema", "Preise sind das ewige Thema.");

  // DETAILS END

  // EXITS START
  AddExit ("nordosten", ROOM("weg_h2"));
  AddExit ("osten", ROOM("markt"));
  AddExit ("sueden", ROOM("weg_g4"));
  // EXITS END

  // ITEMS START
  // ITEMS END

}
