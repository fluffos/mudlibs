#include <properties.h>
#include <moving.h>
#include "files.h"
#include "/d/ebene/woody/q/felben/quest.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Gaffos/room/"+x)
#endif

inherit "std/room";

nosave int zeichnung, buegeleisen;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf einem Dach");
  SetProp (P_INT_LONG,
    "Du stehst unvermittelter Dinge am Dach der Kneipe. Bis auf ein paar "+
    "Kisten und unnuetzes Geruempel kannst Du hier jedoch nichts "+
    "erkennen, was Deine Aufmerksamkeit erregen wuerde. Auf dem "+
    "Marktplatz unter Dir herrscht reges Treiben, hier oben ist jedoch "+
    "wesentlich weniger los.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddSpecialDetail ( ({"kiste", "kisten"}),
    "d_kiste");
  AddDetail ( ({"geruempel", "massen"}),
    "Unnuetzes Geruempel liegt in Massen am Boden rum.");
  AddDetail ( ({"boden"}),
    "Auf dem Boden entdeckst Du ausser massenhaft Geruempel auch noch ein "+
    "paar geheimnisvolle Kisten.");
  AddDetail ( ({"markt", "marktplatz", "platz"}),
    "Der Marktplatz unter Dir ist ziemlich belebt. Du kannst ueber den "+
    "Efeu kletternderweise dorthin gelangen.");
  AddDetail ( ({"efeu"}),
    "Wenn Du wieder runterklettern willst, geh einfach nach unten.");
  
    AddDetail("aufmerksamkeit", "Hier gibt es nichts, was Deine Aufmerksamkeit erregen wuerde.\n");
    AddDetail("dach", "Du stehst auf dem flachen Dach der Kneipe.\n");
    AddDetail("dinge", "Nur einige alte Kisten und Geruempel liegen hier.\n");
    AddDetail("himmel", "Der Himmel ist weit und klar ueber Dir.\n");
    AddDetail("kneipe", "Du befindest Dich auf dem Dach der Kneipe.\n");
    AddDetail("treiben", "Der Marktplatz unter Dir ist voller Gaffos.\n");
    AddDetail(({"gaffo", "gaffos"}), "Die kleinen affenartigen Gaffos bevoelkern den Marktplatz.");
    
  // DETAILS END

  // EXITS START
  AddExit ("unten", ROOM("markt"));
  // EXITS END

  // ITEMS START
  // ITEMS END
  buegeleisen = zeichnung = 1;
}

string d_kiste()
{
  if (zeichnung || !deep_present(ZEICHNUNG_ID, TP) && !TP->QueryQuest("Goblin im Gaffogarten"))
  {
    say (CAP_TPN+
      " durchstoebert ein paar alte Kisten und findet irgendetwas.\n");
    CLONE (OBJ("div/zeichnung"), TP);
    zeichnung=0;
    return
      "Du durchstoeberst ein paar alte Kisten und findest eine Zeichnung.\n";
  }
  else
  {
    if ( !deep_present("buegeleisen", TP) && !TP->QueryQuest("Goblin im Gaffogarten") || (buegeleisen && !random(5)))
    {
      CLONE (OBJ("waffe/buegeleisen"), TP);
      buegeleisen=0;
      say (CAP_TPN+
      " durchstoebert ein paar alte Kisten und findet irgendetwas.\n");
      return bs("Du durchstoeberst die alten Kisten nochmal und findest zu "+
        "Deiner eigenen Ueberraschung ein altes Buegeleisen!");
    }
    else
    {
      say (CAP_TPN+" durchstoebert erfolglos ein paar alte Kisten.\n");
      return bs("Du durchstoeberst ein paar alte Kisten, findest aber "+
        (buegeleisen ?
          "auf den ersten Blick nichts weiter... Aber da "+
          "der erste Blick ja bekanntlich nie ausreicht..."
        : "nichts Brauchbares."));
    }
  }
}

reset()
{
  ::reset();
  buegeleisen = zeichnung = 1;
}
