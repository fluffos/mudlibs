



#include "../gaffos.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Im Obsthain der Gaffos" );
  SetProp( P_INT_LONG,
    "Hier geht der Obsthain weiter. Grosse Birnbaeume stehen hier, die "
    "schon alt und knorrig sind. Ueber dir ist der Himmel durch das dichte "
    "Blaetterdach kaum zu erkennen. Der Hain erstreckt sich weiter nach "
    "Sueden." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddDetail("birnbaeume", "Die alten Birnbaeume sind knorrig, ihre Fruechte wurden bereits abgeerntet.\n");
  AddDetail(({"blaetterdach", "blaetter", "blaettern"}), "Das dichte Blaetterdach laesst wenig Licht durch.\n");
  AddDetail("boden", "Der Boden ist mit Laub bedeckt.\n");
  AddDetail("hain", "Der Hain erstreckt sich weiter nach Sueden.\n");
  AddDetail("himmel", "Der Himmel ist durch das Blaetterdach nur schwach sichtbar.\n");
  AddDetail("obsthain", "Der Obsthain erstreckt sich weiter in den Sueden.\n");
  AddDetail("fruechte", "Die Fruechte wurden bereits abgeerntet, nur leere Zweige bleiben.\n");
AddDetail("laub", "Das Laub ist trocken und raschelt bei jedem Schritt.\n");
AddDetail("licht", "Das Licht faellt nur spaerlich durch das dichte Blaetterdach.\n");
AddDetail("schritt", "Dein Schritt wird von den weichen Blaettern gedaempft.\n");
AddDetail("zweige", "Die Zweige der Birnbaeume sind leer und knorrig.\n");


  AddExit( "westen", ROOM("ap_j07") );
  AddExit( "sueden", ROOM("ap_k08"));

  AddItem( "/d/ebene/Park/npc/ameise" , REFRESH_DESTRUCT);

  AddCmd("pfluecke|pflueck&birne|birnen", "cmd_pfluecken", "Was willst du pfluecken?");
}

public int cmd_pfluecken() {
  write(BS("Da war jemand schneller. Vielleicht kannst du am Markt eine Birne ergattern?"));
  return 1;
}