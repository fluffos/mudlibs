#include <properties.h>
#include <moving.h>
#include "files.h"
#include <laden.h>

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Gaffos/room/"+x)
#endif

inherit "std/laden";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:22]));
  SetProp (P_INT_SHORT, "Ein kleiner Laden");
  SetProp (P_INT_LONG,
    "Du stehst in einer kleinen, wackeligen Huette, offenbar ein Laden. "+
    "Viel kannst Du hier nicht erkennen, aber es ist ja auch nur wenig "+
    "Platz in diesem Raum. Das einzige Inventar in diesem Raum scheint "+
    "ein grosser Tisch, eine Art Verkaufstheke zu sein, hinter der der "+
    "Haendler auf Deine Wuensche wartet. Die Waren sind wohl alle in "+
    "einem Hinterzimmer gelagert, das durch eine kleine Tuer hinter der "+
    "Theke erreichbar ist.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"huette", "laden"}),
    "Du stehst mittendrin.");
  AddDetail ( ({"platz"}),
    "Davon ist nur wenig in diesem Raum hier.");
  AddDetail ( ({"raum"}),
    "Bis auf einen Tisch, der als eine Art Verkaufstheke dient, kannst Du "+
    "nicht viel in dem Raum erkennen.");
  AddDetail ( ({"inventar"}),
    "Das einzige Inventar hier ist der grosse Tisch.");
  AddDetail ( ({"theke", "tisch", "verkaufstheke", "verkaufsmoebel"}),
    "Der grosse Tisch dient als Verkaufstheke. Der Haendler hinter ihr "+
    "bedient Dich sicher gerne, vielleicht solltest Du aber erst das kleine "+
    "Schild, das auf dem Tisch steht, lesen.");
  AddDetail ( ({"schild"}),
    "Ein kleines Schild, das gegen Syntaxprobleme helfen soll. Du kannst "+
    "es lesen.");
  AddReadDetail ( ({"schild"}),
    "Verfuegbare Befehle:\n"+
    "<zeige>           Gibt eine Uebersicht ueber das Angebot im Laden.\n"+
    "<zeige> waf|rue|ver  Uebersicht ueber Waffen/Ruestungen/Verschiedenes\n"+
    "<unt> nummer      Gibt die Beschreibung eines Gegenstands der Liste aus\n"+
    "<kaufe> nummer oder\n"+
    "<kaufe> etwas     Du kaufst einen bestimmten Gegenstand.\n"+
    "<verkaufe> etwas  Du verkaufst einen Gegenstand, den Du bei Dir hast.\n"+
    "<versetze> etwas  Du verkaufst einen Gegenstand, auch wenn Dir der\n"+
    "                  Haendler nicht den vollen Preis dafuer bezahlen will.\n"+
    "<schaetz> etwas   Der Haendler sagt Dir, wieviel ihm ein Gegenstand\n"+
    "                  wert waere, wenn Du ihn verkaufen wuerdest.\n");
  AddDetail ( ({"hinterzimmer"}),
    "Das Hinterzimmer ist wohl durch die Tuer hinter der Theke erreichbar, "+
    "allerdings steht ueber ihr geschrieben: 'Zutritt nur fuer "+
    "Verkaufspersonal!'");
  AddDetail ( ({"tuer"}),
    "Die kleine Tuer fuehrt ins Hinterzimmer. Ueber ihr steht in grossen "+
    "Lettern: 'Zutritt nur fuer Verkaufspersonal!'");
  AddDetail ( ({"lettern"}),
    "Grosse Lettern. Du solltest sie beachten.");
  AddDetail ( ({"wuensche"}),
    "Welche hast Du?");
  AddDetail ( ({"zutritt"}),
    "Den hast Du fuer das Hinterzimmer leider nicht.");
  AddDetail ( ({"waende", "wand"}),
    "Ganz gewoehnliche Waende, weiss gestrichen, einfach langweilig.");
  AddDetail ( ({"boden"}),
    "Er gibt Dir Halt, damit Du nicht zum Mittelpunkt der Erde plumpst.");
  AddDetail ( ({"halt"}),
    "Halt gibt Dir einzig und allein der Boden hier.");
  AddDetail ( ({"mittelpunkt"}),
    "Der ist ganz ganz tief unter Dir, da kommst Du bestimmt nicht hin. "+
    "Oder zumindest nicht so leicht.");
  AddDetail ( ({"erde"}),
    "Die Erde ist das, worauf Du Dich (hoffentlich noch) befindest.");

    AddDetail("art", "Die Theke ist eine einfache Art von Verkaufsmoebel.");
    AddDetail("decke", "Eine niedrige Decke verstaerkt die Enge der Huette.");
    AddDetail("haendler", "Der Haendler wartet geduldig auf Deine Bestellung.");
    AddDetail("syntaxprobleme", "Das Schild hilft bei Syntaxproblemen im Laden.");
    AddDetail("verkaufspersonal", "Nur das Verkaufspersonal darf ins Hinterzimmer.");
    AddDetail("waren", "Die Waren sind im Hinterzimmer sicher verstaut.");
    AddDetail("bestellung", "Ja was willst du denn kaufen?");
    
  // DETAILS END

  SetStorageRoom (ROOM("lagerraum"));
  SetProp(P_SHOPKEEPER_ID, "\ngaffo_haendler");
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_NAME, "Gullbert Glotz");

  // EXITS START
  AddExit ("osten", ROOM("weg_h2"));
  // EXITS END

  // ITEMS START
  AddItem(NPC("haendler"), REFRESH_DESTRUCT);
  // ITEMS END

  AddCmd("betrete|betret&zimmer|hinterzimmer", "cmd_betreten");
}

public int cmd_betreten() {
  if(present(QueryProp(P_SHOPKEEPER_ID))) {
    write(BS("Gullbert schreit: HE DA! Das ist nur fuer Mitarbeiter!"));
    return 1;
  }

  write(BS("Du betrittst das Hinterzimmer. Es ist voller Regale in denen "
           "die Waren sind und einem kleinen Rauchereck. Gar nicht so interessant."));
  say(BS(TPN+" betritt kurz das Hinterzimmer, kommt aber enttaeuscht wieder."));
  return 1;
}