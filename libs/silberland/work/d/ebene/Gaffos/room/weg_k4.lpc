#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Gaffos/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN: TT_TOWN]));
  SetProp (P_INT_SHORT, "Am Platz for dem Gaffolanghuas");
  SetProp (P_INT_LONG,
    "Der Dorfweg oeffnet sich hier zu einem grossen Platz aus staubiger, plattgetretener "
    "Erde. m Nordosten steht ein grosses Langshaus, das den Gaffos wohl als Versammlungshalle "
    "dient. Im Westen erkennst du die Rueckseite einer kleinen Kapelle und nach Sueden "
    "hin fuehrt ein Weg die Palisade entlang.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden", "dorfweg", "weg", "platz"}),
    "Hier hat sich der Dorfweg zu einem grossen Platz geoeffnet. Der Boden besteht fast nur aus "
    "plattgetretener Erde und einigen kleinen Grasbuescheln.");

  AddDetail("erde", "Der Boden besteht aus plattgetretener Erde, die den Platz bedeckt.");
  AddDetail("gaffos", "Die Gaffos sind das Volk dieses Dorfes, bekannt fuer ihre einfache Lebensweise.");
  AddDetail("grasbuescheln", "Ein paar kleine Grasbuescheln wachsen hier und da zwischen den Erdhaufen.");
  AddDetail("himmel", "Der Himmel ist klar, mit nur wenigen Wolken, die sich am Horizont sammeln.");
  AddDetail("kapelle", "Die kleine Kapelle ist aus einfachem Holz gebaut und wirkt eher schlicht.");
  AddDetail("langshaus", "Das Langshaus wirkt gross und stabil, als Versammlungsort fuer die Gaffos.");
  AddDetail("palisade", "Die Palisade ist aus grob bearbeiteten Holzpfaehlen, die das Dorf umschliessen.");
  AddDetail("rueckseite", "Die Rueckseite der Kapelle zeigt einfache Holzverkleidungen und ein kleines Fenster.");
  AddDetail("versammlungshalle", "Die Versammlungshalle ist der Ort, an dem die Gaffos wichtige Entscheidungen treffen.");
  AddDetail("dorf", "Das Dorf besteht aus einfachen Haeusern, die von einer Palisade umgeben sind.");
  AddDetail("dorfes", "Das Dorf ist ruhig und ueberschaubar, mit einem klaren, rustikalen Charme.");
  AddDetail("entscheidungen", "Wichtige Entscheidungen werden in der Versammlungshalle von den Gaffos getroffen.");
  AddDetail("erdhaufen", "Einige kleine Erdhaufen sind an den Raendern des Platzes zu finden.");
  AddDetail("fenster", "Das Fenster in der Rueckseite der Kapelle ist klein und schlicht, mit schmalen Riegeln.");
  AddDetail("holz", "Die meisten Gebaeude und Strukturen im Dorf sind aus einfachem Holz gebaut.");
  AddDetail("holzpfaehlen", "Die Palisade besteht aus dicken, grob bearbeiteten Holzpfaehlen.");
  AddDetail("holzverkleidungen", "Die Rueckseite der Kapelle ist mit groben Holzverkleidungen versehen.");
  AddDetail("horizont", "Der Horizont ist weit und offen, das Dorf wird von weitem sichtbar.");
  AddDetail("lebensweise", "Die Gaffos leben einfach und im Einklang mit der Natur, weitgehend unabhaengig.");
  AddDetail("ort", "Der Platz ist ein zentraler Ort, an dem sich die Dorfbewohner treffen.");
  AddDetail("versammlungsort", "Die Versammlungshalle dient als Treffpunkt fuer die wichtigsten Versammlungen im Dorf.");
  AddDetail("volk", "Das Volk der Gaffos ist ein einfaches, aber entschlossenes Volk, das in diesem Dorf lebt.");
  AddDetail("wolken", "Am Horizont sammeln sich langsam einige Wolken, die den Himmel verdecken.");
  AddDetail(({"charme", "einfachheit"}), "Der Charme des Dorfes liegt in seiner Einfachheit.");
  AddDetail("dorfbewohner", "Die Dorfbewohner sind freundlich und arbeiten gemeinsam fuer das Wohl des Dorfes.");
  AddDetail("wohl", "Damit es eben allen gut geht.");
  AddDetail("einklang", "Die Gaffos leben im Einklang mit der Natur und achten auf ein nachhaltiges Leben.");
  AddDetail("gebaeude", "Die Gebaeude im Dorf sind aus Holz und einfach, aber funktional.");
  AddDetail(({"haeusern", "haeuser"}), "Die Haeuser im Dorf sind schlicht und bieten den Gaffos einen gemuetlichen Rueckzugsort.");
  AddDetail("natur", "Die Natur rund um das Dorf ist gruen und wild, mit vielen Baeumen und Straeuchern.");
  AddDetail(({"baeumen", "baeume", "straeucher", "straeuchern"}), "Die Gaffos lieben wohl die Natur sehr.");
  AddDetail("raendern", "An den Raendern des Platzes wachsen vereinzelte Grasbuescheln und kleine Erdhaufen.");
  AddDetail(({"riegeln", "riegel"}), "Die Riegel an den Fenstern sind aus einfachem Holz, um die Fenster zu verschliessen.");
  AddDetail("strukturen", "Die Strukturen im Dorf sind aus grob bearbeitetem Holz und dienen ihren praktischen Zwecken.");
  AddDetail(({"zweck", "zwecken"}), "Naja, was man halt so braucht.");
  AddDetail("treffpunkt", "Der Platz ist ein haeufiger Treffpunkt fuer die Dorfbewohner, um Neuigkeiten auszutauschen.");
  AddDetail("versammlungen", "Die Versammlungen in der Versammlungshalle sind der Ort, an dem Entscheidungen getroffen werden.");
  AddDetail("neuigkeiten", "Wichtige Neuigkeiten werden auf dem schwarzen Brett angeschlagen.");
    
 
  // DETAILS END

  // EXITS START
  AddExit ("sueden", ROOM("weg_k5"));
  AddExit ("nordosten", "/gilden/abenteurer/gaffogilde");
  // EXITS END

  // ITEMS START
  AddItem(NPC("brett"), REFRESH_DESTRUCT);
  // ITEMS END

}
