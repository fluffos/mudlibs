#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Gaffos/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Weg entlang einer Palisade");
  SetProp (P_INT_LONG,
    "Du befindest Dich auf einem kleinen unbefestigten Weg entlang einer "+
    "Palisade, der nach Sueden und Osten weitergeht. Du befindest Dich an "+
    "einem Eckpunkt der Palisade, hinter der Du bereits einige Geraeusche "+
    "ausmachen zu koennen glaubst.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"holzpfaehle", "palisade", "pfaehle"}),
    "Die Palisade im Suedosten besteht aus sorgfaeltig zusammengefuegten "+
    "Holzpfaehlen, die oben spitz zugeschnitten sind, sodass Dir ein "+
    "Ueberklettern absolut unmoeglich ist.");
  AddDetail ( ({"boden", "weg"}),
    "Du stehst auf einem kleinen ziemlich unwegsamen Weg, der entlang der "+
    "Palisade nach Sueden und nach Osten fuehrt. Hoffentlich stolperst Du "+
    "nicht!");
  AddSound ( ({DEFAULT_SOUND, "geraeusche"}),
    "Du glaubst, einige Stimmen hinter der Palisade hoeren zu koennen.");
  AddSound ( ({"stimmen"}),
    "Sie klingen aufgeregt, wie auf einem Marktplatz. Was da wohl hinter "+
    "der Palisade auf Dich wartet?");

    AddDetail("himmel", "Der Himmel ist wolkenverhangen, es zieht sich zu.");
    AddDetail("marktplatz", "Vielleicht ein Marktplatz hinter der Palisade?");
    AddDetail("ueberklettern", "Die Palisade ist zu hoch und spitz, um sie zu ueberklettern.");
    AddDetail("eckpunkt", "Du befindest Dich an einem Eckpunkt der Palisade, von dem aus der Weg in zwei Richtungen fuehrt.");

    
  // DETAILS END

  // EXITS START
  AddExit ("sueden", ROOM("room_f02"));
  AddExit ("osten", ROOM("room_g01"));
  // EXITS END

  // ITEMS START
  // ITEMS END

}
