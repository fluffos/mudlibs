#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Gaffos/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf einem Dorfweg");
  SetProp (P_INT_LONG,
    "Du befindest Dich auf einem staubigen Dorfweg mitten im Gaffodorf, "+
    "der zwischen einigen Haeusern hindurch weiter nach Norden zum Markt "+
    "oder weiter nach Suedosten auf eine Wegkreuzung fuehrt. Im Westen "+
    "befindet sich eine Kneipe, deren Eingang sich weiter suedlich "+
    "befindet.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden", "dorfweg", "weg"}),
    "Der Weg, auf dem Du gehst, ist zwar ziemlich staubig, aber sonst gut "+
    "geraeumt. Er fuehrt von Norden nach Suedwesten.");
  AddDetail ( ({"fenster", "kneipe"}),
    "Du lugst vorsichtig durch die Fenster der Kneipe und erkennst, dass "+
    "dort doch einiger Betrieb herrscht. Die Gaffos sind wohl auch ein "+
    "trinkfestes Volk...");
  AddDetail ( ({"markt"}),
    "Der weiter noerdlich gelegene Markt scheint ziemlich belebt zu sein.");
  AddDetail ( ({"kreuzung", "wegkreuzung"}),
    "An der Kreuzung im Suedwesten kreuzen sich zwei Wege, ausserdem "+
    "kannst Du dort einen Eingang zur Kneipe erkennen.");
  AddDetail ( ({"eingang"}),
    "Der Eingang zur Kneipe befindet sich etwas weiter suedlich von hier.");
  AddDetail ( ({"haeuser", "wohnhaeuser"}),
    "Du erkennst oestlich von Dir etliche Wohnhaeuser. Das Haus westlich "+
    "von Dir hingegen scheint eine Kneipe zu sein.");

    AddDetail ( ({"betrieb", "treiben"}),
    "In der Kneipe herrscht reges Treiben.");
  AddDetail ( ({"gaffodorf", "dorf"}),
    "Das Gaffodorf ist ein lebhaftes Dorf.");
  AddDetail ( ({"gaffos"}),
    "Die Gaffos sind ein trinkfestes Volk.");
  AddDetail ( ({"haus"}),
    "Das westliche Haus ist eine Kneipe.");
  AddDetail ( ({"himmel"}),
    "Der Himmel ist klar und blau.");
  AddDetail ( ({"volk"}),
    "Das Volk ist gastfreundlich und trinkfreudig.");
  
  // DETAILS END

  // EXITS START
  AddExit ("suedwesten", ROOM("weg_h5"));
  AddExit ("norden", ROOM("weg_i3"));
  // EXITS END

  // ITEMS START
  AddItem( NPC("gaffo"), REFRESH_DESTRUCT );
  // ITEMS END

}
