#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Gaffos/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf einem Dorfweg");
  SetProp (P_INT_LONG,
    "Du befindest Dich auf einem staubigen Dorfweg mitten im Gaffodorf "+
    "zwischen der Palisade im Westen und einer Kneipe im Osten, die Du "+
    "allerdings von hier aus nicht betreten kannst. Im Sueden kannst "+
    "Du ein weiteres, offenbar schon etwas verfallenes Gebaeude erkennen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden", "dorfweg", "weg"}),
    "Der Weg, auf dem Du gehst, ist zwar ziemlich staubig, aber sonst gut "+
    "geraeumt. Er fuehrt von Norden nach Suedosten.");
  AddDetail ( ({"holzpfaehle", "palisade", "pfaehle"}),
    "Die Palisade im Westen besteht aus sorgfaeltig zusammengefuegten "+
    "Holzpfaehlen, die oben spitz zugeschnitten sind, sodass hier keiner so "+
    "ohne weiters reinklettern kann.");
  AddDetail ( ({"fenster", "kneipe"}),
    "Du lugst vorsichtig durch die Fenster der Kneipe und erkennst, dass "+
    "dort doch einiger Betrieb herrscht. Die Gaffos sind wohl auch ein "+
    "trinkfestes Volk...");
  AddDetail ( ({"gebaeude"}),
    "Das Gebaeude im Sueden ist schon etwas verfallen. Von hier aus kannst "+
    "Du es allerdings nicht betreten.");
    AddDetail("betrieb", 
    "In der Kneipe herrscht reger Betrieb.");

AddDetail(({"gaffodorf", "dorf"}), 
    "Ein rustikales, charmantes Dorf.");

AddDetail("gaffos", 
    "Ein geselliges und herzliches Volk.");

AddDetail("himmel", 
    "Der Himmel ist klar und blau.");

AddDetail("volk", 
    "Ein feierfreudiges und herzliches Volk.");

  // DETAILS END

  // EXITS START
  AddExit ("norden", ROOM("weg_g3"));
  AddExit ("suedosten", ROOM("weg_h5"));
  // EXITS END

  // ITEMS START
  AddItem( NPC("gaffo"), REFRESH_DESTRUCT );
  // ITEMS END

}
