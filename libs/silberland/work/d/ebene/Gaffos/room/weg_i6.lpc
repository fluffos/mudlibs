
#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Gaffos/room/"+x)
#endif

int stockda;

inherit "std/room";

void create()
{
  ::create();
  stockda = 1;
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf einem Dorfweg");
  SetProp (P_INT_LONG,
    "Du befindest Dich auf einem staubigen Dorfweg mitten im Gaffodorf, "+
    "der zwischen einigen Haeusern hindurch weiter nach Osten tiefer ins "+
    "Wohngebiet oder nach Nordwesten zu einer Wegkreuzung fuehrt. Suedlich "+
    "von Dir verlaeuft ausserdem die Palisade entlang. Ein kleines offenes Tor "
    "fuehrt im Sueden durch die Palisade nach draussen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden", "dorfweg", "weg"}),
    "Der Weg, auf dem Du gehst, ist zwar etwas staubig, aber ansonsten gut "+
    "von Geruempel geraeumt.");
  AddDetail ( ({"wohngebiet"}),
    "Es liegt grob gesehen im Nordosten von Dir.");
  AddDetail ( ({"kreuzung", "wegkreuzung"}),
    "Die Wegkreuzung im Nordwesten fuehrt in alle moeglichen Richtungen, "+
    "unter anderem auch zur Kneipe.");
  AddDetail ( ({"kneipe"}),
    "Die Kneipe ist noch mindestens zwei Raeume entfernt - Halte durch!");
  AddDetail ( ({"holzpfaehle", "palisade", "pfaehle"}),
    "Die Palisade suedlich von Dir besteht aus sorgfaeltig "+
    "zusammengefuegten Holzpfaehlen, die oben spitz zugeschnitten sind, "+
    "sodass Dir ein Ueberklettern absolut unmoeglich ist.");
  AddDetail ( ({"haeuser"}),
    "Die Haeuser sind bestimmt bewohnt, sonst waer es ja kein Wohngebiet.");

  AddDetail(({"gaffodorf", "dorf"}), "Gaffodorf ist ein kleines, abgelegenes Dorf, das von einer hohen Palisade geschuetzt wird.");
  AddDetail("geruempel", "Der Weg ist weitgehend frei von Geruempel, aber es gibt hier und da ein paar kleinere Reste.");
  AddDetail("halte", "Es scheint, als ob Du noch eine Weile durchhalten musst, um die Kneipe zu erreichen.");
  AddDetail("himmel", "Der Himmel ist klar und weit, mit wenigen Wolken, die langsam am Horizont ziehen.");
  AddDetail("raeume", "Die Kneipe ist durch mehrere Raeume zugaenglich, aber Du bist noch nicht nahe genug, um sie zu betreten.");
  AddDetail("tor", "Das kleine Tor in der suedlichen Palisade fuehrt hinaus aus dem Dorf und in die freie Wildnis.");
  AddDetail("ueberklettern", "Das Tor steht offen. Du musst nichts ueberklettern.");
  AddDetail("horizont", "Der Horizont ist weit und offen, mit wenigen Wolken, die langsam in der Ferne ziehen.");
  AddDetail("reste", "Einige Reste von Abfaellen sind am Rand des Weges verstreut, aber der Grossteil des Weges ist sauber.");
  AddDetail("weile", "Es wird noch eine Weile dauern, bis du die Kneipe erreichst, also solltest du dich auf den Weg machen.");
  AddDetail("wildnis", "Jenseits des Tores erstreckt sich die Wildnis.");
  AddDetail("wolken", "Ein paar Wolken ziehen langsam ueber den Himmel, werfen aber kaum Schatten.");
  AddDetail(({"abfaelle", "abfaellen"}), "Einige Abfaelle liegen am Rand des Weges, doch der Weg ist groesstenteils frei von Abfaellen.");
  AddDetail("ferne", "In der Ferne kannst du viel Wald erkennen.");
  AddDetail("wald", "Der liegt ausserhalb der Palisade.");
  AddDetail("grossteil", "Der Grossteil des Weges ist sauber und frei von Hindernissen.");
  AddDetail(({"hindernisse", "hindernissen"}), "Damit sind Abfaelle und so gemeint.");
  AddDetail("rand", "Am Rand des Weges sind ein paar kleine Reste von Abfaellen und Geaest zu finden.");
  AddDetail("schatten", "Die Wolken werfen nur vereinzelte Schatten auf den Boden, ansonsten ist es recht hell.");
  AddDetail("geaest", "Etwas Geaest wurde abseits der Wegkreuzung abgelegt. Ob es sich lohnt das zu durchwuehlen?");
  // DETAILS END

  // EXITS START
  AddExit ("nordwesten", ROOM("weg_h5"));
  AddExit ("osten", ROOM("weg_j6"));
  AddExit ("sueden", ROOM("ap_i07"));
  // EXITS END

  // ITEMS START
  AddItem( NPC("gaffowaechter"), REFRESH_DESTRUCT );
  // ITEMS END

  AddCmd("durchsuche|durchsuch|durchwuehle|durchwuel&geaest|aeste|haufen", "cmd_durchsuchen", "Was willst du durchwuehlen?");

}

public void reset() {
  ::reset();
  stockda = 1;
}

public int cmd_durchsuchen() {
  object ob;

  say(BS(TPN+" durchwuehlt einen Haufen Aeste."));

  if(!stockda) {
    write(BS("Du durchwuehlst das Geaest, findest aber gar nichts Brauchbares."));
    return -1;
  }

  ob = clone_object("/p/weapon/club/holzstock");
  if(ob->move(TP) != 1) {
    write(BS("Du durchwuehlst das Geaest und findest einen soliden Holzstock. Leider ist er dir zu schwer und du laesst ihn da."));
    destruct(ob);
    return 1;
  }
 
  write(BS("Du durchwuehlst das Geaest und findest einen soliden Holzstock, den du sofort einsteckst."));
  stockda = 0;
  return 1;
}
