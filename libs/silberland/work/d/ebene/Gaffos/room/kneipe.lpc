/* MP-HEADER - DO NOT MODIFY ANYTHING BEFORE THE #include STATEMENTS!! */

#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Gaffos/room/"+x)
#endif

inherit "/std/pub";

void create()
{
  ::create();
  // RAUMBESCHREIBUNG
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp(P_INT_SHORT, "In der gemuetlichen Gaffo-Kneipe");
  SetProp(P_INT_LONG,
    "Du befindest Dich in der kleinen, aber ueberaus gemuetlichen Kneipe "+
    "im Herzen des Gaffodorfs. Die warmen Holzwaende sind mit allerlei "+
    "Trophaeen und Erinnerungsstuecken geschmueckt, die von den Abenteuern "+
    "und Festen der Gaffos erzaehlen. Ein offener Kamin in der Ecke verbreitet "+
    "eine angenehme Waerme, und der Duft von frisch gebratenem Schnitzel und "+
    "selbstgebrautem Gaffo-Bier liegt in der Luft. Holzene Tische und Baenke "+
    "laden zum Verweilen ein, waehrend der Wirt Gustav hinter der Theke "+
    "geschaeftig Glaeser poliert und Bestellungen entgegennimmt. Es ist "+
    "ein lebhafter Ort, an dem die Bewohner des Dorfes zusammenkommen, "+
    "um Geschichten zu teilen und das Leben zu geniessen. Ein Menue an "+
    "der Wand zeigt die verfuegbaren Speisen und Getraenke - tippe 'menue', "+
    "um es anzusehen.");

  // DETAILS
  AddDetail(({"wand", "waende", "holzwaende"}), 
    "Die Waende sind aus dunklem, poliertem Holz und mit Trophaeen und "+
    "Erinnerungsstuecken geschmueckt. Du erkennst Jagdtrophaeen, alte Schwerter "+
    "und sogar einen praechtigen Geweihkopf.");
  AddDetail(({"trophaeen", "erinnerungsstuecke", "geweihkopf"}), 
    "Die Trophaeen und Erinnerungsstuecke erzaehlen von den Abenteuern der Gaffos. "+
    "Besonders beeindruckend ist der grosse Geweihkopf ueber dem Kamin.");
  AddDetail(({"kamin", "offener kamin"}), 
    "Der Kamin in der Ecke verbreitet eine angenehme Waerme. Das Feuer knistert "+
    "leise, und hin und wieder spruehen Funken auf.");
  AddDetail(({"tische", "baenke", "holzene tische", "holzene baenke"}), 
    "Die Tische und Baenke sind aus massivem Holz gefertigt und zeigen deutliche "+
    "Spuren von unzaehligen Feiern und Mahlzeiten. Sie wirken stabil und einladend.");
  AddDetail(({"theke", "wirt", "gustav"}), 
    "Hinter der Theke steht Gustav, der Wirt, ein beleibter, froehlicher Gaffo, "+
    "der immer ein Laecheln auf den Lippen hat. Er scheint alle Gaeste persoenlich zu kennen.");
    AddDetail(({"abenteuern"}),
    "Die Trophaeen und Erinnerungsstuecke an den Waenden erzaehlen von aufregenden Abenteuern der Gaffos.");

AddDetail(({"bestellungen"}),
    "Gustav nimmt die Bestellungen der Gaeste mit einem breiten Laecheln entgegen und sorgt dafuer, dass niemand durstig bleibt.");

AddDetail(({"bewohner"}),
    "Die Bewohner des Dorfes kommen hierher, um sich zu entspannen und das Leben zu geniessen.");

AddDetail(({"bier"}),
    "Das selbstgebraute Gaffo-Bier ist weithin bekannt fuer seinen kraeftigen Geschmack und die perfekte Mischung aus Malz und Hopfen.");

AddDetail(({"boden"}),
    "Der Boden ist aus massivem Holz gefertigt, zeigt aber Spuren unzaehliger Feierlichkeiten.");

AddDetail(({"decke"}),
    "Die Decke besteht aus dunklem Holz und wird von schweren Balken gestuetzt.");

AddDetail(({"dorfes"}),
    "Das Dorf ist bekannt fuer seine Gemuetlichkeit und die herzlichen Bewohner, die sich gerne in der Kneipe versammeln.");

AddDetail(({"duft"}),
    "Der Duft von frisch gebratenem Schnitzel und selbstgebrautem Bier erfuellt die Luft und macht Lust auf eine Bestellung.");

AddDetail(({"ecke"}),
    "In einer Ecke des Raumes befindet sich ein offener Kamin, der eine angenehme Waerme verbreitet.");

AddDetail(({"feiern"}),
    "Die Kneipe war Schauplatz unzaehliger Feiern, wie die abgenutzten Tische und Baenke verraten.");

AddDetail(({"festen"}),
    "Von den Festen der Gaffos zeugen die Erinnerungsstuecke an den Waenden und die lebhaften Geschichten der Gaeste.");

AddDetail(({"feuer"}),
    "Das Feuer im Kamin knistert beruhigend.");

AddDetail(({"funken"}),
    "Hin und wieder spruehen kleine Funken aus dem offenen Kamin und tanzen in der Luft.");

AddDetail(({"gaeste"}),
    "Die Gaeste der Kneipe sind eine bunte Mischung aus Dorfbewohnern und Reisenden, die den Charme des Ortes geniessen.");

AddDetail(({"gaffo"}),
    "Die Gaffos sind ein freundliches Volk, das bekannt ist fuer seine Herzlichkeit und Feierfreude.");

AddDetail(({"gaffodorfs"}),
    "Das Gaffodorf ist ein gemuetlicher Ort, dessen Herzstueck diese Kneipe ist.");

AddDetail(({"gaffos"}),
    "Die Gaffos haben die Kneipe mit ihren Geschichten, Erinnerungsstuecken und ihrer Lebensfreude gepraegt.");

AddDetail(({"geschichten"}),
    "Die Geschichten der Gaeste und die Erinnerungsstuecke an den Waenden erzaehlen von Abenteuern und grossen Festen.");

AddDetail(({"getraenke"}),
    "Auf der Karte stehen verschiedene Getraenke, darunter das beruehmte selbstgebraute Gaffo-Bier und ein starker Schnaps.");

AddDetail(({"glaeser"}),
    "Die Glaeser auf der Theke glitzern sauber poliert, und Gustav stellt sie geschickt zurecht.");

AddDetail(({"herzen"}),
    "Die Kneipe liegt im Herzen des Gaffodorfs und ist der zentrale Treffpunkt der Dorfbewohner.");

AddDetail(({"holz"}),
    "Das Holz der Waende und Moebel ist dunkel und poliert.");

AddDetail(({"jagdtrophaeen"}),
    "Unter den Trophaeen an den Waenden findest Du beeindruckende Jagdtrophaeen, wie Geweihkoepfe und alte Fallen.");

AddDetail(({"kneipe", "haus", "hauses"}),
    "Die gemuetliche Kneipe ist ein lebhafter Ort, an dem die Dorfbewohner zusammenkommen, um Geschichten zu teilen.");

AddDetail(({"laecheln"}),
    "Gustav traegt ein Laecheln auf den Lippen, waehrend er Bestellungen aufnimmt und Getraenke serviert.");

AddDetail(({"leben"}),
    "Das Leben in der Kneipe ist lebhaft und herzlich, mit Gespraechen, Lachen und Klirren von Glaesern.");

AddDetail(({"lippen"}),
    "Das Laecheln auf Gustavs Lippen zeigt seine Freude daran, die Gaeste zu bewirten.");

AddDetail(({"luft"}),
    "Die Luft ist erfuellt von gemuetlicher Waerme und dem verlockenden Duft nach frischem Essen.");

AddDetail(({"mahlzeiten"}),
    "Die Mahlzeiten hier sind bekannt fuer ihre herzhaften Portionen und den frischen Geschmack.");

AddDetail(({"menue"}),
    "Das Menue an der Wand zeigt die verfuegbaren Speisen und Getraenke. Du kannst 'menue' eingeben, um es genauer anzusehen.");

AddDetail(({"ort"}),
    "Die Kneipe ist ein zentraler Ort des Dorfes, wo Geschichten ausgetauscht und Freundschaften gepflegt werden.");

AddDetail(({"schnitzel"}),
    "Das frische Schnitzel mit goldbrauner Panade ist eines der beliebtesten Gerichte auf der Karte.");

AddDetail(({"schwerter"}),
    "Einige alte Schwerter an den Waenden erinnern an vergangene Abenteuer und heldenhafte Taten.");

AddDetail(({"speisen"}),
    "Die Speisen im Menue sind herzhaft und frisch zubereitet, wie das goldbraune Schnitzel oder die gebratene Gaffo-Wurst.");

AddDetail(({"spuren"}),
    "Die Tische und Baenke tragen deutliche Spuren von unzaehligen Feiern und Mahlzeiten.");

AddDetail(({"verweilen"}),
    "Hier laedt es zum Verweilen ein, sei es bei einem Bier oder einem herzhaften Essen.");

AddDetail(({"waerme"}),
    "Die Waerme des Kamins durchdringt den Raum und sorgt fuer ein wohliges Gefuehl.");

    AddDetail(({"abenteuer"}),
    "Die Kneipe ist voller Erinnerungsstuecke und Geschichten, die von den spannenden Abenteuern der Gaffos zeugen.");

AddDetail(({"balken"}),
    "Schwere Balken stuetzen die Decke.");

AddDetail(({"bestellung"}),
    "Gustav nimmt Deine Bestellung mit einem freundlichen Laecheln entgegen und sorgt dafuer, dass Du Dich willkommen fuehlst.");

AddDetail(({"charme"}),
    "Der Charme der Kneipe liegt in ihrer Einfachheit und den herzlichen Bewohnern, die sie zu einem lebhaften Treffpunkt machen.");

AddDetail(({"dorf"}),
    "Das Dorf ist ein idyllischer Ort, in dessen Zentrum diese Kneipe das Leben der Bewohner zusammenbringt.");

AddDetail(({"dorfbewohner"}),
    "Die Dorfbewohner versammeln sich hier, um Geschichten zu teilen, zu lachen und das Leben zu geniessen.");

AddDetail(({"essen"}),
    "Die Gerichte hier sind frisch zubereitet und bekannt fuer ihren koestlichen Geschmack und die herzhaften Portionen.");

AddDetail(({"fallen"}),
    "Unter den Jagdtrophaeen an den Waenden findest Du alte Fallen, die von erfolgreichen Jagdausfluegen berichten.");

AddDetail(({"feierfreude"}),
    "Die Gaffos sind bekannt fuer ihre Feierfreude.");

AddDetail(({"feierlichkeiten"}),
    "Unzaehlige Feierlichkeiten haben in dieser Kneipe stattgefunden und die Geschichte des Ortes gepraegt.");

AddDetail(({"freude"}),
    "Die Freude der Gaeste ist ansteckend, sei es beim Erzaehlen von Geschichten oder beim gemeinsamen Trinken.");

AddDetail(({"freundschaften"}),
    "Hier werden Freundschaften gepflegt und neue geschlossen, waehrend die Gaeste ihre Geschichten austauschen.");

AddDetail(({"gaffodorf"}),
    "Das Gaffodorf ist ein malerischer Ort, dessen Herzstueck diese einladende Kneipe bildet.");

AddDetail(({"gefuehl"}),
    "Das Gefuehl von Waerme und Gemeinschaft durchzieht den Raum und laesst die Gaeste sich heimisch fuehlen.");

AddDetail(({"gemuetlichkeit"}),
    "Gaffos sind bekannt fuer Gemuetlichkeit, Herzlichkeit und Lebensfreude.");

AddDetail(({"gerichte"}),
    "Die Gerichte auf der Speisekarte reichen von herzhaften Speisen wie Schnitzeln und Wuersten bis hin zu suessem Gebaeck.");

AddDetail(({"geschmack"}),
    "Der Geschmack der Speisen und Getraenke ist kraeftig und authentisch, genau das Richtige nach einem langen Tag.");

AddDetail(({"gespraechen"}),
    "Die Geraeusche von Gespraechen und Lachen erfuellen die Kneipe.");

AddDetail(({"geweihkoepfe"}),
    "Die beeindruckenden Geweihkoepfe an den Waenden sind ein Zeugnis der Jagderfolge der Gaffos.");

AddDetail(({"herzlichkeit"}),
    "Die Herzlichkeit der Bewohner und des Wirts macht diese Kneipe zu einem besonderen Ort.");

AddDetail(({"herzstueck"}),
    "Die Kneipe ist das Herzstueck des Gaffodorfs und ein zentraler Treffpunkt fuer alle Dorfbewohner.");

AddDetail(({"hopfen"}),
    "Der Hopfen im selbstgebrauten Bier sorgt fuer einen herben und erfrischenden Geschmack.");

AddDetail(({"karte"}),
    "Die Karte an der Wand listet die verfuegbaren Speisen und Getraenke. Du kannst sie mit 'menue' naeher ansehen.");

AddDetail(({"klirren"}),
    "Das Klirren von Glaesern mischt sich mit dem Geraeusch von Lachen und Gespraechen, waehrend die Gaeste ihre Getraenke geniessen.");

AddDetail(({"lachen"}),
    "Das Lachen der Gaeste erfuellt den Raum und bringt eine froehliche Leichtigkeit in die Kneipe.");

AddDetail(({"lebensfreude"}),
    "Die Lebensfreude der Gaffos ist in jeder Ecke der Kneipe spuerbar.");

AddDetail(({"lust"}),
    "Die Kneipe macht Lust auf gutes Essen, ein kuehles Bier und ein paar Geschichten mit den anderen Gaesten.");

AddDetail(({"malz"}),
    "Das Malz im Gaffo-Bier gibt ihm seinen charakteristisch kraeftigen Geschmack.");

AddDetail(({"mischung"}),
    "Die perfekte Mischung aus Malz und Hopfen macht das Gaffo-Bier zu einem unverwechselbaren Genuss.");

AddDetail(({"moebel"}),
    "Die Moebel sind aus massivem Holz gefertigt und wirken einladend und stabil.");

AddDetail(({"panade"}),
    "Die goldbraune Panade des Schnitzels ist knusprig und perfekt gewuerzt.");

AddDetail(({"portionen"}),
    "Die Portionen hier sind grosszuegig bemessen und lassen keinen Gast hungrig zurueck.");

AddDetail(({"raum"}),
    "Der Raum ist gemuetlich eingerichtet.");

AddDetail(({"raumes"}),
    "Die Details des Raumes erzaehlen Geschichten von den Abenteuern und Feierlichkeiten der Gaffos.");

AddDetail(({"reisenden"}),
    "Auch Reisende kehren gerne in die Kneipe ein, um sich zu staerken und Geschichten mit den Dorfbewohnern zu teilen.");

AddDetail(({"schauplatz"}),
    "Die Kneipe ist der Schauplatz unzaehliger Geschichten und Abenteuer, die in den Erinnerungsstuecken an den Waenden lebendig bleiben.");

AddDetail(({"schnaps"}),
    "Der Gaffo-Schnaps ist stark und klar, ein beliebtes Getraenk fuer die Mutigen und Feierfreudigen.");

AddDetail(({"taten"}),
    "Die Schwerter und Jagdtrophaeen an den Waenden erzaehlen von heldenhaften Taten der Vergangenheit.");

AddDetail(({"treffpunkt"}),
    "Die Kneipe ist der zentrale Treffpunkt des Dorfes und ein Ort der Gemeinschaft und Lebensfreude.");

AddDetail(({"volk"}),
    "Das Volk der Gaffos ist bekannt fuer seine Herzlichkeit und seine Liebe zu gutem Essen und Trinken.");

AddDetail(({"wurst"}),
    "Die gebratene Gaffo-Wurst duftet nach Kraeutern und schmeckt besonders herzhaft.");
    AddDetail(({"details"}),
    "Die kleinen Details in der Kneipe, wie die kunstvoll geschnitzten Moebel und die dekorativen Erinnerungsstuecke, machen den besonderen Charme des Raumes aus.");

AddDetail(({"einfachheit"}),
    "Die Einfachheit der Einrichtung strahlt eine besondere Gemuetlichkeit aus und laesst den Raum authentisch wirken.");

AddDetail(({"erzaehlen"}),
    "Die Waende, Moebel und Erinnerungsstuecke erzaehlen von der reichen Geschichte und den Abenteuern der Gaffos.");

AddDetail(({"feierfreudigen"}),
    "Die feierfreudigen Gaeste laden zum Mitfeiern ein.");

AddDetail(({"gast"}),
    "Als Gast wirst Du hier herzlich empfangen und schnell Teil der Gemeinschaft.");

AddDetail(({"gebaeck", "spezialitaet"}),
    "Das suesse Gebaeck ist eine Spezialitaet der Kneipe und schmeckt nach Honig und Mandeln.");

AddDetail(({"gemeinschaft"}),
    "Die Gemeinschaft der Dorfbewohner ist hier deutlich zu spueren, wenn sie zusammenkommen, um Geschichten zu teilen und das Leben zu feiern.");

AddDetail(({"genuss"}),
    "Ob Essen oder Trinken, alles hier ist ein wahrer Genuss fuer die Sinne.");

AddDetail(({"geraeusch"}),
    "Das Geraeusch des knisternden Kamins und das Klirren von Glaesern untermalen die Kneipe.");

AddDetail(({"geraeusche"}),
    "Die Geraeusche von Gespraechen, Lachen und klirrenden Glaesern lassen die Kneipe lebendig wirken.");

AddDetail(({"geschichte"}),
    "Jede Ecke der Kneipe birgt eine Geschichte – von den Abenteuern der Gaffos bis zu den unzaehligen Feierlichkeiten, die hier stattgefunden haben.");

AddDetail(({"getraenk"}),
    "Die Getraenke hier reichen von erfrischender Limonade bis zu starkem Schnaps, alles hausgemacht und von bester Qualitaet.");

AddDetail(({"jagdausfluegen"}),
    "Die Trophaeen an den Waenden stammen von erfolgreichen Jagdausfluegen und zeigen die Abenteuerlust der Gaffos.");

AddDetail(({"jagderfolge"}),
    "Die Waende sind geschmueckt mit Zeugnissen der Jagderfolge, darunter Geweihkoepfe und alte Waffen.");

AddDetail(({"kraeutern"}),
    "Die Gaffo-Wurst duftet nach einer Mischung aus frischen Kraeutern, die ihr einen unverwechselbaren Geschmack verleihen.");

AddDetail(({"leichtigkeit"}),
    "Die Leichtigkeit, mit der die Gaeste miteinander lachen und plaudern, wirkt schon entspannend.");

AddDetail(({"liebe"}),
    "Die Liebe zum Detail zeigt sich in der sorgfaeltigen Zubereitung der Speisen und der gemuetlichen Einrichtung.");

AddDetail(({"mutigen"}),
    "Die mutigen Gaeste greifen gerne zum starken Gaffo-Schnaps, der fuer seine wuerzige Schaerfe bekannt ist.");

AddDetail(({"reisende"}),
    "Auch Reisende finden hier einen warmen Empfang und koestliche Speisen, um sich nach ihren Reisen zu staerken.");

AddDetail(({"richtige"}),
    "Nach einem langen Tag ist diese Kneipe genau das Richtige, um zur Ruhe zu kommen und gutes Essen zu geniessen.");

AddDetail(({"speisekarte"}),
    "Die Speisekarte listet die besten Gerichte und Getraenke des Hauses. Sie ist mit 'menue' einsehbar.");

AddDetail(({"tag"}),
    "Egal, wie der Tag verlaufen ist, ein Besuch in dieser Kneipe sorgt fuer einen entspannten und genussvollen Ausklang.");

AddDetail(({"trinken"}),
    "Ob Bier, Schnaps oder Limonade – das Trinken in dieser Kneipe wird durch die Qualitaet und Frische der Getraenke zu einem Erlebnis.");

AddDetail(({"vergangenheit"}),
    "Die Erinnerungsstuecke in der Kneipe sind Zeugnisse der Vergangenheit und erzaehlen von frueheren Zeiten voller Abenteuer und Freude.");

AddDetail(({"wuersten"}),
    "Die gebratenen Gaffo-Wuerste sind eine Spezialitaet des Hauses, bekannt fuer ihre kraeftigen Kraeuteraromen.");

AddDetail(({"zentrum"}),
    "Als Zentrum des Gaffodorfs ist die Kneipe ein Ort, an dem das soziale Leben pulsiert.");

AddDetail(({"zeugnis", "zeugnisse", "zeugnissen"}),
    "Die Trophaeen und Erinnerungsstuecke sind ein Zeugnis fuer die tapferen Taten und die Abenteuer der Gaffos.");
    AddDetail(({"abenteuerlust"}),
    "Die Abenteuerlust der Gaffos spiegelt sich in den Trophaeen und den Geschichten, die hier erzaehlt werden.");

AddDetail(({"ausklang"}),
    "Die Kneipe ist der perfekte Ort fuer den gemuetlichen Ausklang eines ereignisreichen Tages.");

AddDetail(({"besuch"}),
    "Ein Besuch in dieser Kneipe hinterlaesst unvergessliche Eindruecke und den Wunsch, wiederzukommen.");

AddDetail(({"detail"}),
    "Die Liebe zum Detail ist in der Einrichtung, den Speisen und Getraenken sowie in der Atmosphaere der Kneipe deutlich spuerbar.");

AddDetail(({"einrichtung"}),
    "Die Einrichtung besteht aus robusten Holzmoebeln und liebevoll platzierten Dekorationen, die eine gemuetliche Atmosphaere schaffen.");

AddDetail(({"empfang"}),
    "Der Empfang durch Wirt Gustav und die freundlichen Gaeste sorgt dafuer, dass sich hier jeder willkommen fuehlt.");

AddDetail(({"erlebnis"}),
    "Der Aufenthalt in der Kneipe ist ein Erlebnis fuer alle Sinne – vom Duft des Essens bis zum Knistern des Kamins.");

AddDetail(({"frische"}),
    "Die Frische der Zutaten ist hier garantiert – vom knackigen Salat bis zum frisch gezapften Bier.");

AddDetail(({"honig"}),
    "Das suesse Gebaeck mit Honig und Mandeln ist eine der kulinarischen Spezialitaeten des Hauses.");

AddDetail(({"kraeuteraromen"}),
    "Die Kraeuteraromen der Gaffo-Wuerste verleihen ihnen einen unverwechselbaren Geschmack.");

AddDetail(({"limonade"}),
    "Die Gaffo-Limonade ist fruchtig und spritzig – eine erfrischende Wahl fuer alle Gaeste.");

AddDetail(({"mandeln"}),
    "Das suesse Gebaeck mit Mandeln ist ein Genuss, der in dieser Kneipe besonders beliebt ist.");

AddDetail(({"mitfeiern"}),
    "Die lebendige Atmosphaere laedt jeden ein, mitzufeiern und das Leben zu geniessen.");

AddDetail(({"qualitaet"}),
    "Die Qualitaet der Speisen und Getraenke ist hier oberstes Gebot und macht jeden Besuch besonders.");

AddDetail(({"reisen"}),
    "Die Kneipe ist ein beliebter Anlaufpunkt fuer Reisende, die nach einer langen Reise eine Staerkung suchen.");

AddDetail(({"ruhe"}),
    "Die Waerme des Kamins und die Gemuetlichkeit der Einrichtung laden dazu ein, hier zur Ruhe zu kommen.");

AddDetail(({"schaerfe"}),
    "Die Schaerfe des Gaffo-Schnapses ist bekannt und belebt die Sinne.");

AddDetail(({"sinne"}),
    "In dieser Kneipe werden alle Sinne angesprochen – der Geschmack, der Duft und die Atmosphaere sorgen fuer ein harmonisches Erlebnis.");

AddDetail(({"teil"}),
    "Als Gast wird man schnell ein Teil der Gemeinschaft und fuehlt sich willkommen.");

AddDetail(({"waffen"}),
    "Die alten Waffen an den Waenden sind Zeugen vergangener Abenteuer und Erlebnisse der Gaffos.");

AddDetail(({"wuerste"}),
    "Die gebratenen Gaffo-Wuerste sind besonders beliebt und werden mit Kraeutern und Liebe zubereitet.");

AddDetail(({"zeiten"}),
    "Die Erinnerungsstuecke in der Kneipe erinnern an vergangene Zeiten voller Abenteuer und Gemeinschaft.");

AddDetail(({"zubereitung"}),
    "Die Zubereitung der Speisen ist hier eine Kunst, die mit Liebe und Sorgfalt ausgefuehrt wird.");


  // AUSGAENGE
  AddExit("sueden", ROOM("weg_h5"));

  // SPEISEN UND GETRAENKE
  AddDrink("Gaffo-Bier", ({"gaffo-bier", "bier"}),
           80, 10, 5, 3,
           ({
             "Gustav zapft ein frisches Gaffo-Bier und reicht es Dir. Der Duft "+
             "des Malzes steigt Dir in die Nase, waehrend Du einen tiefen Schluck nimmst.",
             "&& trinkt ein frisch gezapftes Gaffo-Bier und seufzt zufrieden."
           }));

  AddDrink("Starker Gaffo-Schnaps", ({"gaffo-schnaps", "schnaps"}),
           120, 15, 10, 2,
           ({
             "Gustav grinst breit und stellt Dir ein kleines Glas mit klarem Gaffo-Schnaps hin. "+
             "Ein kurzer, brennender Schluck, und Du fuehlst Dich belebt und warm.",
             "&& kippt einen starken Gaffo-Schnaps herunter und schuettelt sich kurz."
           }));

  AddDrink("Gaffo-Limonade", ({"limonade", "gaffo-limonade"}),
           50, 5, 0, 4,
           ({
             "Gustav serviert Dir eine kuehle Gaffo-Limonade, die fruchtig und spritzig schmeckt.",
             "&& trinkt eine kuehle Gaffo-Limonade und laechelt zufrieden."
           }));

  AddFood("Frisches Schnitzel", ({"schnitzel", "frisches schnitzel"}),
           150, 25, 6,
           ({
             "Gustav bringt Dir ein frisch geklopftes Schnitzel mit goldbrauner Panade. "+
             "Du geniesst jeden saftigen Bissen.",
             "&& geniesst ein frisch geklopftes, goldbraun gebratenes Schnitzel."
           }));

  AddFood("Gebratene Gaffo-Wurst", ({"wurst", "gaffo-wurst"}),
           100, 20, 5,
           ({
             "Gustav reicht Dir eine heisse, gebratene Gaffo-Wurst, die nach Kraeutern duftet.",
             "&& isst genuesslich eine heisse, gebratene Gaffo-Wurst."
           }));

  AddFood("Gaffo-Salat", ({"salat", "gaffo-salat"}),
           60, 10, 4,
           ({
             "Gustav serviert Dir einen frischen Salat mit Kraeutern und Gaffo-Dressing.",
             "&& isst einen frischen Salat und scheint sich erfrischt zu fuehlen."
           }));

  AddFood("Suesses Gaffo-Gebaeck", ({"gebaeck", "suesses gebaeck"}),
           80, 15, 3,
           ({
             "Gustav bringt Dir ein suesses Gebaeck, das nach Honig und Mandeln schmeckt.",
             "&& geniesst ein suesses Gaffo-Gebaeck mit Honig und Mandeln."
           }));

  // NPC WIRT
  AddItem(NPC("wirt"), REFRESH_DESTRUCT);
}
