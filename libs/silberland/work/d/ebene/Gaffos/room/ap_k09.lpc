





#include "../gaffos.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Tuempel" );
  SetProp( P_INT_LONG,
    "Du stehst hier an einem kleinen Tuempel am Waldrand. Nach Sueden hin wird "
    "er von einem dichten Mischwald begrenzt und am Nordufer liegt der Obsthain. "
    "Du glaubst auf der anderen Seite des Tuempels, am Ostufer sozusagen "
    "ein kleines Lagerfeuer zu erkennen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

  AddDetail("boden", "Der Boden ist weich und feucht, bedeckt mit Moos und Erde.");
AddDetail("himmel", "Der Himmel spiegelt sich im Tuempel und zeigt ein sanftes Blau.");
AddDetail("lagerfeuer", "Am Ostufer scheint ein kleines Lagerfeuer zu flackern.");
AddDetail("mischwald", "Der Mischwald im Sueden ist dicht und voller Leben.");
AddDetail("nordufer", "Das Nordufer des Tuempels grenzt an den Obsthain.");
AddDetail("obsthain", "Der Obsthain am Nordufer ist voller Baeume und summender Insekten.");
AddDetail("ostufer", "Am Ostufer siehst du das Flackern eines Lagerfeuers.");
AddDetail("seite", "Von hier aus kannst du die andere Seite des Tuempels erkennen.");
AddDetail(({"tuempels", "tuempel"}), "Der Tuempel ist klar und spiegelt die Umgebung wider.");
AddDetail("waldrand", "Der Waldrand schirmt den Tuempel im Sueden mit dichten Baeumen ab.");
AddDetail("baeume", "Die Baeume rund um den Tuempel wiegen sich sanft im Wind.");
AddDetail("blau", "Das Blau des Himmels spiegelt sich auf der Oberflaeche des Tuempels.");
AddDetail("erde", "Die feuchte Erde am Ufer ist mit Spuren von Tieren und Menschen bedeckt.");
AddDetail("flackern", "Das Flackern des Lagerfeuers am Ostufer ist deutlich zu erkennen.");
AddDetail("insekten", "Insekten schwirren ueber dem Wasser und um die umliegenden Baeume.");
AddDetail("lagerfeuer", "Das Lagerfeuer am Ostufer wirft ein warmes, einladendes Licht.");
AddDetail("leben", "Das Leben rund um den Tuempel zeigt sich in Tieren, Pflanzen und froehlichem Quaken.");
AddDetail("moos", "Weiches, gruenes Moos bedeckt den Boden in der Naehe des Tuempels.");
AddDetail("see", "Der kleine See wirkt ruhig und klar, ein perfekter Ort zum Entspannen.");
AddDetail("tuempel", "Der Tuempel ist ein friedlicher Ort mit klarem Wasser und lebendiger Natur.");
AddDetail("umgebung", "Die Umgebung des Tuempels ist idyllisch, mit Wald, Wasser und sanftem Licht.");
AddDetail("licht", "Sanftes Licht bricht durch die Baeume und spiegelt sich auf dem Wasser.");
AddDetail("menschen", "Hin und wieder scheinen hier Menschen vorbeizukommen, wie Spuren im Boden verraten.");
AddDetail("naehe", "In der Naehe des Tuempels herrscht eine friedliche Stille.");
AddDetail("natur", "Die Natur entfaltet sich hier in ihrer ganzen Schoenheit und Vielfalt.");
AddDetail("oberflaeche", "Die Oberflaeche des Tuempels ist spiegelglatt und reflektiert den Himmel.");
AddDetail("ort", "Dieser Ort strahlt eine beruhigende Atmosphaere aus.");
AddDetail("pflanzen", "Ueppige Pflanzen wachsen dicht am Ufer und im Wasser.");
AddDetail("quaken", "Das Quaken der Froesche am Tuempel erzeugt eine beruhigende Melodie.");
AddDetail("spuren", "Spuren von Tieren und Menschen zeichnen sich im weichen Boden ab.");
AddDetail("tieren", "Tiere wie Froesche, Libellen und Voegel beleben die Gegend.");
AddDetail("ufer", "Die Ufer des Tuempels sind bewachsen und mit weichem Moos bedeckt.");
AddDetail("wald", "Der dichte Wald im Sueden rahmt den Tuempel malerisch ein.");
AddDetail("wasser", "Das klare Wasser des Tuempels laedt dazu ein, sich zu erfrischen.");
AddDetail("wind", "Ein sanfter Wind streicht durch die Baeume und ueber die Wasseroberflaeche.");
AddDetail("atmosphaere", "Die Atmosphaere hier ist friedlich und wohltuend.");
AddDetail("froesche", "Froesche sitzen am Ufer und quaken in unterschiedlichen Toenen.");
AddDetail("gegend", "Die Gegend um den Tuempel wirkt einladend und natuerlich.");
AddDetail("libellen", "Libellen schwirren elegant ueber die Wasseroberflaeche.");
AddDetail("melodie", "Das Zusammenspiel von Quaken, Rascheln und Wind erzeugt eine natuerliche Melodie.");
AddDetail("schoenheit", "Die Schoenheit dieses Ortes liegt in seiner Einfachheit und Ruhe.");
AddDetail("stille", "Eine wohltuende Stille liegt ueber dem Tuempel, nur unterbrochen von Naturgeraeuschen.");
AddDetail("vielfalt", "Die Vielfalt an Pflanzen und Tieren macht diesen Ort lebendig.");
AddDetail("voegel", "Voegel zwitschern in den Baeumen am Waldrand.");
AddDetail("wasseroberflaeche", "Die Wasseroberflaeche ist ruhig und reflektiert das umgebende Gruen.");
    


  AddExit( "westen", ROOM("ap_j09") );

  AddItem( "/d/ebene/Park/npc/frosch" , REFRESH_DESTRUCT);

  AddCmd("bade|bad&in&tuempel|teich|see", "cmd_baden", "Worin willst du baden?");
}

public int cmd_baden() {
  if(sizeof(TP->QueryArmours()) > 0) {
    write(BS("Angezogen badet man doch nicht!"));
    return -1;
  }

  write(BS("Du nimmst ein kurzes aber erfrischendes Bad im Waldtuempel."));
  say(BS(TPN+" nimmt ein kurzes Bad im Tuempel."));
  return 1;
}
