/*
 * schmutz.c
 *
 * $Log$
 */

inherit "/std/thing";
#include <properties.h>

#define WASSER ({"/d/gebirge/thor/hoehlenquest/room/hoehle/hoehle7", \
                 "/d/dschungel/dante/stein/room/vorspung3", \
                 "/d/ebene/zordan/ogerhoehle/room/park_g4", \
                 "/gilden/paladine/room/burg_c2", \
                 "/d/unterwelt/zordan/riese/room/plateau-e2", \
                 "/d/unterwelt/connect/central/room/00+06-01" \
               })

void create() {
  if (!is_clone(this_object())) return;
  ::create();  
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  AddId("\nschmutz");
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  AddCmd(({"wasche", "wasch"}), "cmd_wash");
}


int cmd_wash(string str) {
  if (!this_player()) return 0;
  notify_fail("Wen oder was willst Du denn waschen?\n");
  if (!str || str == "") return 0;
  if (str != "haende" && str != "finger") return 0;
  notify_fail("Hier kannst Du Deine Haende nicht waschen.\n");
  if (member_array(file_name(environment(this_player())), WASSER) == -1)
    return 0;
  notify_fail("Du solltest Deine Haende schon frei haben.\n");
  if (this_player()->QueryProp(P_USED_HANDS) > 0) return 0;
  write("Du waeschst Dir die Haende.\n");
  tell_room(environment(this_player()), capitalize(this_player()->name())+
    " waescht sich die Haende.\n", ({this_player()}));
  call_out("remove", 0);
  return 1;
}

string extra_look() {
  if (!environment(this_object())) {
    call_out("remove", 0);
    return 0;
  }
  return capitalize(environment(this_object())->name(WESSEN)+
    " Finger sind schmutzig.\n");
}

