inherit "std/npc";

#include <properties.h>
#include "../schrat.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Mecki");
  SetProp(P_LONG, BS(
    "Mecki ist ein ziemlich durchschnittlicher Igel, der seit Jahren so tut "+
    "als koenne er lesen, schreiben, rechnen und ueberhaupt alles, was "+
    "normale Menschen oder Elfen auch koennen. Da der Schrat und Charlie "+
    "beide nicht lesen oder schreiben koennen, hat er es geschafft ihnen "+
    "einen vom Pferd zu erzaehlen."));
  SetProp(P_NAME, "Mecki");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"mecki", "igel"}));
  create_default_npc(7);
  SetProp(P_ALIGN, 200 - random(400));
  SetProp(P_BODY, 50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOATTACK, "verkriecht sich hinter seinen Buechern.");
  AddInfo(DEFAULT_INFO, "Darueber hab ich ein Buch, aber ich hab momentan "+
    "keine Zeit, das nachzuschlagen.", "sagt: ");
  AddInfo(({"buch", "buecher"}),
    "Also wenn ich ehrlich sein soll, ich kaufe sie nach Regalmetern. Aber "+
    "immer nur die dekorative Schweinslederausgabe.", "sagt: ");
}
  
