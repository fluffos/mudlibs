inherit "std/npc";

#include <properties.h>
#include "../schrat.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Charlie Pinguin");
  SetProp(P_LONG, BS(
    "Wow, noch nie hast Du einen Pinguin gesehen, dessen Frack deart "+
    "schlecht passt wie Charlies. Das ist aber kein Wunder, denn Charlie "+
    "und der Frack haben schon so manche Bruecke von unten gesehen."));
  SetProp(P_NAME, "Charlie Pinguin");
  SetProp(P_GENDER, MALE);

  SetProp(P_ARTICLE, 0);  SetChats(2, ({"Charlie wirft achtlos eine leere Dose auf den Boden.\n"}));
  AddId(({"charlie","pinguin", "angler"}));
  create_default_npc(7);
  SetProp(P_ALIGN, 0);
  SetProp(P_NOATTACK, "holt sich lieber noch einen Warsteinerpilz.");
  AddInfo(DEFAULT_INFO, "Laber hier nicht rum! Besorg mir lieber noch "+
    "einen Warsteinerpilz!", "lallt: ");
  AddInfo("warsteinerpilz", "lallt: Immer her damit!\n");
}
