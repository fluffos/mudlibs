inherit "std/npc";

#include <properties.h>
#include "../schrat.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Der Schrat");
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME, "Schrat");
  SetProp(P_GENDER, MALE);
  SetProp(P_ALIGN, 200 - random (400));
  AddId(({"schrat", "\n\schrat"}));
  create_default_npc(7);
  SetProp(P_DEFAULT_INFO, "schnarcht nur.\n");
  SetProp(P_NOATTACK, "dreht sich auf die andere Seite.");
}

string long()
{
  if(environment(this_object())->_query_ticktack())
  {
    return BS("Der Schrat rennt hektisch hin und her. Irgend ein Trottel "+
      "hat ihn geweckt.");
  }
  else
  {
    return BS("Der Schrat liegt in seinem Bett und zersaegt gerade einen "+
      "ganzen Urwald.\nWo bleibt Robin Wood?");
  }
}

void Defend(int dam, string dam_type, int spell, object enemy)
{
  object en;
  if (environment(this_object())->_query_ticktack())
    ::Defend(dam, dam_type, spell, enemy);
  else
  {
    if (!en=previous_object() || !living(en))
    en = this_player();
    write("Schlafende schlaegt man nicht.\n");
    en->StopHuntFor(this_object(), 1);
  }
}
