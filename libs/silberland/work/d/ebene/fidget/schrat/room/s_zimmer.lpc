#include <properties.h>
#include <questmaster.h>
#include "../schrat.h"

inherit "/std/room";

int ticktack;

reset()
{
  object ob;
  ::reset();
  ticktack = 0;
  if (ob = present("\n\schrat", this_object()))
  {
    ob->SetProp(P_DEFAULT_INFO, "schnarcht laut.\n");
    ob->SetProp(P_NOATTACK, "dreht sich auf die andere Seite.");
  }
}

create()
{
  ::create();
  SetProp(P_INT_SHORT, "Schrats Schlafzimmer");
  SetProp(P_INT_LONG, BS(
    "Du befindest Dich im Schlafzimmer von Schrat, dem alten Penner. "+
    "An der Wand steht sein riesiges Bett, das natuerlich sein absoluter "+
    "Lieblingsaufent- haltsort ist, und worin er die schoensten Stunden seines "+
    "Lebens schlafender- weise verbracht hat. Vor dem Fenster haengen fleckige "+
    "Vorhaenge und davor steht ein Tisch, der aber nur sehr selten mal "+
    "benutzt wird. Eine Tuere fuehrt nach Osten in den Flur."));
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]));
  AddDetail("boden",
    "Was glaubst Du, worauf Du stehst?\n");
  AddDetail("decke",
    "Die Decke haelt wenigstens den Regen ab.\n");
  AddDetail("regal",
    "In dem Regal steht ein Wecker.\n");
  AddDetail(({"wand", "waende"}), BS(
    "An einer Wand haengt ein Bild der Familie des Schrats. Und an einer "+
    "anderen Wand haegt ein kleines Regal."));
  AddSpecialDetail("wecker", "clock");
  AddDetail("bild",
    "Uaah! Dagegen gewinnt die Adams Family jeden Schoenheitswettbewerb.\n");
  AddDetail("bett",
    "Das Bett ist alt und durchgelegen und die Laken sind voellig "+
    "zerknittert.\n");
  AddDetail("laken", BS(
    "Es ist schmutzig und ein Zaubertrank ist auch nicht drin. Du laesst die "+
    "Finger davon."));
  AddDetail("fenster",
    "Durch das Fenster siehst Du das Grasland.\n");
  AddDetail(({"vorhang", "vorhaenge"}),
    "Fleckige Vorhaenge, die wohl einmal rot-kariert waren.\n");
  AddDetail("tisch",
    "Auf dem Tisch steht eine Blumenvase mit verwelkten Tulpen.\n");
  AddDetail(({"vase", "blumenvase"}),
    "Die gesprungene Blumenvase enthaelt verwelkte Tulpen.\n");
  AddDetail(({"blumen", "tulpen"}),
    "Die verwelkten Blumen stehen in einer Blumenvase.\n");
  AddDetail(({"tuer","tuere"}),
    "Die Tuer fuehrt in den Flur.\n");
  AddDetail("regen",
    "Der Regen hat genug Anstand nicht herin zu kommen.");
  AddDetail("anstand",
    "Klar, dass Du nicht wiesst wie Anstand aussieht ... \n");
  AddDetail("schlafzimmer",
    "Ein Zimmer wird dann zum Schlafzimmer, wenn man nur haeufig genug "+
    "darin schlaeft.");
  AddDetail("zimmer",
    "Bei diesem Zimmer handelt es sich - wie man am Bett erkennen kann - "+
    "um ein Schlafzimmer.");
  AddDetail("lieblingsaufenthaltsort",
    "Wie gesagt, das Bett.");
  AddDetail("stunden",
    "Wenn man die alle addiert sind es bestimmt schon Jahre ...");
  AddDetail("jahre",
    "Aber, aber, wer wird denn so kleinlich sein?\n");
  AddDetail("leben",
    "Was fuer ein Leben. den ganzen Tag im Bett liegen. Herrlich.");
  AddDetail("grasland",
    "Gruen, sonst nicht weiter auffaellig.");
  AddDetail("fluchtmoeglichkeit",
    "Die Tuer zum Hausflur ist Deine einzige Chance dem grauenhaften "+
    "Gesaege des Scharts zum entgehen.");
  AddDetail("balken",
    "Die Balken sind eigentlich gar keine Balken, aber wenn sie es waeren, "+
    "wuerden sie sich biegen.");

  ticktack = 0;

  AddSmell(DEFAULT_SMELL,
    "Pfui Teufel. Das stinkt.");

  AddSound(DEFAULT_SOUND,
    "Es ist immer wieder beeindruckend, wieviel Laerm ein einziger "+
    "schnarchender Schrat so von sich geben kann.");
  AddSound(({"schnarchen", "laerm", "schrat"}),
    "Der Schrat saegt, dass sich die Balken biegen.");

  AddCmd(({"stelle", "stell"}), "wind1");
  AddCmd(({"ziehe", "zieh"}), "wind2");

  AddExit("osten", ROOM "hausflur");

  AddItem(NPC "schrat", REFRESH_DESTRUCT);
}

clock()
{
  return "Der Wecker "+(ticktack?"tickt munter vor sich hin.\n":"ist stehen geblieben.\n");
}

int wind()
{
  object ob;
  if (ticktack)
  {
    write(BS("Der Wecker tickt doch schon munter vor sich hin und wird "+
      "sicher bald klingeln."));
    return 1;
  }
  write(BS("Du ziehst den Wecker auf und stellst die Zeit ein. Sofort "+
    "klingelt der Wecker."));
  if (ob = present("\n\schrat", this_object()))
  {
    write("Der Schrat springt aus dem Bett.\n");
    if (this_player()->GiveQuest("Schrat kann nicht aufwachen") == OK)
      QUESTLOG(this_player());

    ticktack = 1;
    ob->SetProp(P_DEFAULT_INFO, "grummelt: Hast Du mich geweckt?\n");
    ob->SetProp(P_NOATTACK, "hastet verstoert in die anderer Ecke.");
  }
  return 1;
}

int wind1(string str)
{
  notify_fail("Was willst Du denn stellen.\n");
  if (!stringp(str)) return 0;
  if (str != "wecker") return 0;
  return wind();
}

int wind2(string str)
{
  notify_fail("Was willst Du denn aufziehen?\n");
  if (!stringp(str)) return 0;
  if (str != "wecker auf") return 0;
  return wind();
}

_query_ticktack()
{
  return ticktack;
}
