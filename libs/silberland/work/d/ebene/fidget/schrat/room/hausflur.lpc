#include <properties.h>
#include "../schrat.h"
#include <moving.h>

inherit "/std/room";

create()
{
  ::create();
  SetProp(P_INT_SHORT, "Hausflur");
  SetProp(P_INT_LONG, BS(
    "Du stehst im Hausflur der Huette von Mecki, dem Schrat und Charlie "+
    "Pinguin. Der Flur ist schaebig eingerichtet, mit einem alten "+
    "abgewetzten Teppich auf dem Boden und alten Moebeln. Drei Tueren "+
    "fuehren nach Osten, Westen und Sueden, wohl in die Zimmer der drei, "+
    "waehrend die Haustuer im Norden liegt."));
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]));
  AddDetail(({"flur", "hausflur"}),
    "Ein kleiner zugiger Hausflur, ohne irgendwelche Besonderheiten.\n");
  AddDetail("teppich", 
    "Der abgewetzte und verfilzte Teppich bedeckt fast den ganzen Boden.\n");
  AddDetail("boden",
    "Ein Teppich bedeckt ihn.\n");
  AddDetail("moebel", 
    "Die Moebel sind alt und schaebig. Wahrscheinlich vom Sperrmuell.\n");
  AddDetail("decke", "Die wird von den Waenden getragen.\n");
  AddDetail(({"wand", "waende"}),
    "Die Waende aechzen unter der Last der Decke.\n");
  AddDetail(({"tuer", "tueren"}),
    "Es fuehren Tueren in verschiedenste Richtungen.\n");
  AddDetail("huette", 
    "Du haeltst es nicht fuer moeglich: Die Huette sieht von innen sogar "+
    "noch verwahrloster aus als es von aussen den Anschein hatte.");
  AddDetail(({"schein", "anschein"}), 
    "Der Schein truegt eben manchmal.");
  AddDetail(({"muell", "sperrmuell"}), 
    "Mehr als hier wirst Du auf keiner Halde finden.");
  AddDetail("halde", 
    "Dies ist trotz allem immer noch eine Huette, keine Halde.");
  AddDetail(({"besonderheit", "besonderheiten"}), 
    "Die einzige Besonderheit ist, dass es hier keine gibt.");
  AddDetail(({"mecki", "schrat", "charlie"}), BS(
    "Schau doch mal nach nebenan."));
  AddSpecialDetail(({"richtung", "richtungen"}), "sd_directions");
  AddDetail("zimmer",
    "Ein anderer Name fuer Raum.\n");
  AddDetail("raum",
    "In einem stehst Du drin. Und nebenan gibts noch mehr.\n");
  AddDetail(({"tuer", "haustuer"}), 
    "Die Haustuer im Norden besteht aus altem, bruechigen Holz. Du solltest "+
     "hier wohl nicht zu oft ein- und ausgehen!");
  AddDetail("holz",
    "Das Holz das hier verarbeitet wurde, hat schon bessere Tage gesehen.\n");
  AddDetail("tage",
    "Das ist schon lange lange her.\n");
  AddDetail("entlueftung",
    "Die Entlueftung faellt vor allem durch ihr fehlen auf.");
  AddDetail("fenster",
    "Hier im Hausflur war einfach kein Platz fuer ein Fenster.");
  AddDetail("platz",
    "Es gibt gerade genug Platz um sich zu einer der Tueren zu drehen.");
  AddDetail("last",
    "Die Decke lastet schwer auf den Waenden."); 
  AddDetail("einbildung",
    "Auch das ist eine Form von Bildung.");
  AddSpecialDetail("bildung", "sd_education");

  AddSmell(DEFAULT_SMELL,
    "Es mieft hier ziemlich. Wohl keine gute Entlueftung.");

  AddSound(DEFAULT_SOUND, 
    "Aus dem Westen hoerst Du das Kreischen eines Saegewerks.");
  AddSound("kreischen",
    "Ein geradezu ohrenbetaeubender Laerm.");
  AddSound("saegewerk",
    "Ob die jemals eine Pause machen?");
  AddSound("aechzen", 
    "Das war wohl Teil Deiner Einbildung.");

  AddExit("westen", ROOM "s_zimmer");
  AddExit("osten",  ROOM "c_zimmer");
  AddExit("sueden", ROOM "m_zimmer");
  AddExit("norden", AUSGANG);
}

string sd_directions() {
  if (!this_player()) return "";
  switch (this_player()->QueryProp(P_RACE)) {
    case "Zwerg":
      return "Du zaehlst. Eins, Zwei, Drei, Vier. Vier Richtungen.\n";
    case "Elf":
      return BS("Wenn Du nicht zaehlen kannst, solltest du einen Zwerg "+
                "bitten es Dir beizubringen.");
    case "Mensch":
      return "Es gibt vier Verschiedene.\n";
    case "Fee":
      return BS("Du flatterst einmal durch den Raum und entdeckst "+
                "vier Richtungen.");
    case "Goblin":
      return "Es gibt eindeutig mehr Richtungen als Du Dir merken kannst.\n";
    case "Oger":
      return BS("Du stapfst ein wenig ratlos herum. Aber dann erkennst "+
                "selbst Du, dass es vier Richtungen gibt.");
    case "Dunkelelf":
      return "Du luegst Dir selber vor, dass es nur drei Richtungen gibt.\n";
    case "Feline":
      return "Waehrend Du herumschleichst, erkennst Du vier Richtungen.\n";
    case "Hobbit":
      return "Es gibt soviele Richtungen, wie Du Zehen am Fuss hast: Vier.\n";
    case "Ork":
      return "Du zaehlst. Eins, Zwei, Zwei, Fui. Es gibt fui Richtungen.\n";
    case "Troll":
      return "Ist doch egal. Richtung kann man nicht umbringen.\n";
    case "Gnom":
      return "Mit einem kurzen Blick erkennst du vier Richtungen.\n";
    case "Magier":
      return "Magier sein, aber nicht wissen wos langgeht. "+
             "Das haben wir gerne.\n";
    default:
      return "Du zaehlst Die Richtungen und kommst auf vier Stueck.\n";
  }
}

string sd_education() {
  if (!this_player()) return "";
  switch (this_player()->QueryProp(P_ATTRIBUTES)[A_INT]) {
    case 1 .. 5:
      return "Mit Deiner Bildung ist es nun wirklich nicht weit her.\n";
    case 6 .. 10:
      return "Du bist immerhin intelligent genug einen Eimer umzuwerfen.\n";
    case 11 .. 15:
      return "Hmmm. Hmmm. Ein Genie kann man Dich nicht unbedingt nennen.\n";
    case 16 .. 20:
      return "Deine Bildung ist guter Durchschnitt.\n";
    case 21 .. 30:
      return "Du bist eine richtige Intelligenzbestie.\n";
    default:
      return "Manche haben sie, manche nicht.\n";
  }
}

