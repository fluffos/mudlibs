#include <moving.h>
#include <properties.h>
#include "../schrat.h"

inherit "/std/room";

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Charlies Zimmer");
  SetProp(P_INT_LONG, BS(
    "Du bist im Reich von Charlie Pinguin, der sich immer hierher "+
    "zurueckzieht, wenn er seine Ruhe haben will - sprich in Ruhe einen "+
    "picheln will. An den Waenden haengen mehrere vergammelte Fische, die "+
    "einen bestialischen Gestank verbreiten. Charlie mag mal ein guter "+
    "Angler gewesen sein, aber er ist ein mieser Praeparator.\n"+
    "Durch das Fenster koenntest "+
    "Du einen schoenen Blick auf die Wiesen des Graslandes haben, wenn das "+
    "es nicht fast blind waere. Im Westen befindet sich eine Tuer. Sie "+
    "ist Dein einziger Ausweg."));
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]));
  AddDetail(({"wand", "waende"}),
    "Ausgestopfte halbvergammelte Fische haengen an den Waenden.\n");
  AddDetail("decke", "Sei froh, wenn Du hier heil rauskommst.\n");
  AddDetail("boden",
    "Der Boden ist schmutzig und es liegen eine Menge leere Dosen herum.\n");
  AddDetail(({"dose", "dosen"}),
    "In jeder dieser unzaehligen Dosen war einmal ein Warsteinerpilz.\n");
  AddDetail(({"fisch", "fische"}),
    "Diese Fische haben schon lange kein Meer mehr gesehen.\n");
  AddDetail("fenster", BS(
    "Durch das Fenster kannst Du fast nichts erkennen, aber das was Du "+
    "siehst ist gruen."));
  AddDetail(({"tuere", "tuer"}),
    "Die Tuere fuehrt in den Hausflur.\n");
  AddDetail("reich", 
    "Naja, Reich ist vielleicht doch etwas uebertrieben. Du suchst nach "+
    "einem passenden Wort, laesst es aber hoeflichkeitshalber doch lieber "+
    "bleiben.");
  AddDetail("wort",
    "Ein Mann ein Wort - eine Frau ein Woerterbuch.");
  AddDetail("ruhe",
    "Die willst Du doch hoffentlich nicht stoeren, oder?\n");
  AddDetail("meer", 
    "Du bist genausweit entfernt vom Meer wie der tote Fisch. Und auch "+
    "genauso weit weg von der frischen Meeresluft.");
  AddDetail(({"meeresluft", "luft"}),
    "Ja, das waere jetzt schoen. Meeresluft ist bei weitem nicht so muffig "+
    "wie die Luft hier im Raum.");
  AddDetail("gestank",
    "Du kannst ihn zwar nicht sehen, aber riechen.\n");
  AddDetail("praeparator",
    "So nennt man jemanden, der 'Fische zum an die Wand haengen' herstellt.");
  AddDetail("fenster",
    "Am liebsten wurdest Du aus dem Fenster springen um diesem Gestank zu "+
    "entkommen.");
  AddDetail("ausweg",
    "Entweder Du springst aus dem Fenster oder Du gehst zurueck in den "+
    "Hausflur.");
  AddDetail("hausflur",
    "Der Hausflur befindet sich im Westen.");

  AddSound(DEFAULT_SOUND, 
    "Sogar hier kannst Du das Saegewerk hoeren.\n");
  AddSound("saegewerk",
    "Das Saegewerk muss sich irgendwo im Westen befinden.\n");

  AddSmell(DEFAULT_SMELL,
    "Selber schuld. Jetzt musst Du diesen grauenhaften, bestialischen "+
    "Gestank einatmen.\nDu wuergst.");
  AddSmell(({"gestank", "fisch", "fische"}),
    "Die Fische stinken abscheulich. Du musst Dich beinahe uebergeben."); 

  AddCmd(({"stoere", "stoer"}), "cmd_disturb");
  AddCmd("oeffne", "cmd_open");
  AddCmd(({"springe", "spring"}), "cmd_jump");

  AddExit("westen", ROOM "hausflur");

  AddItem(NPC "charlie", REFRESH_DESTRUCT);
}

int cmd_disturb(string str) {
  notify_fail("Wen oder was willst Du denn stoeren?\n");
  if (!str || str == "") return 0;
  if (str != "ruhe" && str != "die ruhe") return 0;
  write("Du schreist und tobst herum, aber niemand beachtet Dich.\n");
  return 1;
}

int cmd_jump(string str) {
  if (!this_player()) return 0;
  notify_fail("Wohin moechtest Du denn springen?\n");
  if (!str || str == "") return 0;
  if (str != "fenster" && str != "durch fenster" && str != "durchs fenster"
    && str != "aus fenster") return 0;
  write(BS("Du versuchst aus dem Fenster zu springen um an die frische Luft "+
    "zu gelangem. Leider ist das Fenster noch geschlossen und Du donnerst mit "+
    "Deinem Kopf gegen die Scheibe."));
  say(BS(capitalize(this_player()->name())+" schlaegt "+
    this_player()->QueryPossPronoun(MALE, WEN, SINGULAR)+" Kopf gegen die "+
    "Scheibe. Warum nur?"));
  return 1;
}

int cmd_open(string str) {
  if (!this_player()) return 0;
  notify_fail("Was moechtest Du denn oeffnen?\n");
  if (!str || str == "") return 0;
  if (str != "fenster" && str != "das fenster") return 0;
  write(BS("Du ruettelst am Fenster, aber es klemmt und Du kannst es nicht "+
    "oeffnen. Bloss schmutzige Finger hast Du Dir bei der Aktion geholt."));
  say(capitalize(this_player()->name())+" ruettelt am Fenster, kann es "+
    "aber nicht oeffnen.\n");
  if (!present("\nschmutz", this_player()))
    clone_object(OBJ "schmutz")->move(this_player(), M_SILENT | M_NOCHECK);
  return 1;
}
  
