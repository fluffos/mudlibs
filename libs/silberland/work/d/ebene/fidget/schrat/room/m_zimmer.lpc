#include <properties.h>
#include "../schrat.h"

inherit "/std/room";

create()
{
  ::create();
  SetProp(P_INT_SHORT, "Das Arbeitszimmer von Mecki.");
  SetProp(P_INT_LONG, BS(
    "Du befindest Dich in Meckis Arbeitszimmer. An der Wand befindet sich "+
    "ein grosser voellig ueberladener Schreibtisch, vor dem ein einzelner "+
    "Stuhl steht. Dahinter befinden sich endlose Buecherregale mit Unmengen "+
    "an verstaubten Buechern. Du fragst Dich, ob Mecki sie wirklich alle "+
    "gelesen hat, aber dann faellt Dir wieder ein, dass er ja gar nicht "+
    "lesen kann. Im Sueden ist ein Fenster und im Norden fuehrt eine Tuer "+
    "in den Hausflur."));
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]));
  AddDetail("boden",
    "Auf dem Boden liegen einige achtlos weggeworfene Buecher herum.\n");
  AddDetail(({"wand", "waende"}),
    "An der Wand hat es Unmengen an Buechern.\n");
  AddDetail("decke",
    "An der Decke haengen einige Spinnweben.\n");
  AddDetail("spinnweben",
    "Baeh, die sind ja total verstaubt.\n");
  AddDetail("staub",
    "Der leigt hier ueberall herum.\n");
  AddDetail(({"tisch", "schreibtisch"}), BS(
    "Auf dem vor Unrat ueberquellenden Tische steht zu allem Ueberfluss "+
    "auch noch ein ueberquellender Aschenbecher."));
  AddDetail("aschenbecher",
    "Der Aschenbecher wurde lange nicht geleert.\n");
  AddDetail("stuhl",
    "Der Stuhl von Mecki.\n");
  AddDetail(({"regal", "regale"}),
    "Die Regale sind vollgestopft mit verstaubten Buechern.\n");
  AddDetail(({"buch", "buecher"}),
    "Sind das viele Buecher, unglaublich.\n");
  AddDetail("fenster",
    "Draussen siehst Du die Wiesen des Graslandes.\n");
  AddDetail(({"tuer", "tuere"}),
    "Eine Tuer fuehrt in den Hausflur.\n");
  AddDetail(({"menge", "mengen", "unmenge", "unmengen"}),
    "Das sind wirklich unglaublich viele Buecher. Ob die schon mal jemand "+
    "gezaehlt hat?");
  AddDetail("arbeitszimmer",
    "Ein Arbeitszimmer heisst Arbeitszimmer, weil in dem Zimmer manchmal "+
    "gearbeitet wird.");
  AddDetail("zimmer",
    "Bei diesem Zimmer handelt es sich um ein Zimmer vom Typ Arbeitszimmer.");
  AddDetail("unrat",
  "Es ist geradezu widerwaertig. Du wendest Dich schnell ab.");
  AddDetail(({"flur", "hausflur"}), 
    "Er befindet sich noerdlich von Dir. Dein einziger Ausweg!\n");
  AddDetail("ueberfluss",
    "Das ist jetzt nicht weiter wichtig. Schau Dich lieber um.");
  AddDetail("ausweg",
    "Der einzige Ausweg fuehrt nach Norden.");
  
  AddSound(({DEFAULT_SOUND, "laerm"}),
    "Aus den Flur scheint Ohrenbetaeubender Laerm zu kommen.\n");
  AddSmell(DEFAULT_SMELL,
    "Irgendwie riecht es etwas muffig hier.\n");
  
  AddCmd("oeffne", "cmd_open");
  AddCmd(({"zaehle", "zaehl"}), "cmd_count");
  AddCmd(({"leere", "leer"}), "cmd_empty");

  AddExit("norden", ROOM "hausflur");

  AddItem(NPC "mecki", REFRESH_DESTRUCT);
}

int cmd_count(string str) {
  if (!this_player()) return 0;
  notify_fail("Wen oder was willst Du denn zaehlen?\n");
  if (!str || str == "" || str != "buecher") return 0;
  if (this_player()->QueryProp(P_SP) < this_player()->QueryProp(P_MAX_SP)/2) {
    write("Deine Konzentration reicht dafuer nicht aus.\n");
    return 1;
  }
  write(BS("Du nimmst Deine ganze Konzentration zusammen und beginnst zu "+
    "zaehlen, aber Du verlierst Deine Konzentration und kommst "+
    "durcheinander.")); 
  this_player()->AddSp(-1);
  return 1;
}

int cmd_empty(string str) {
  notify_fail("Wen oder was willst Du denn leeren?\n");
  if (!str || str == "" || str != "aschenbecher") return 0;
  say(capitalize(this_player()->name())+" versucht etwas Ordnung in "+
    "diesen Saustall zu bringen.");
  write(BS("Beherzt schnappst Du Dir den Aschenbecher, oeffnest das Fenster "+
    "und schmeisst die Kippen raus. Mecki faucht Dich erbost an, so dass Du "+
    "das fenster schnell wieder schliesst und den Acshenbecher hinstellst. "+
    "Mecki wirft achtlos eine Kippe in den sauberen Aschenbecher und "+
    "beachtet Dich nicht weiter."));
  return 1;
}

int cmd_open(string str) {
  if (!this_player()) return 0;
  notify_fail("Was moechtest Du denn oeffnen?\n");
  if (!str || str == "" || str != "fenster") return 0;
  write("Du versuchst das Fenster zu oeffnen, aber Mecki klopft Dir auf "+
    "die Finger.\n");
  say(BS("Mecki hindert "+this_player()->name(WEN)+" daran den Mief "+
    "rauszulassen.\n"));
  return 1;
}
