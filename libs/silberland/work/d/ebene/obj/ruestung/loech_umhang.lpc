/*
** Ein loechriger Umhang
** 1996-09-21  Woody
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId ("umhang");
  AddId ("loechriger umhang");
  AddId ("loechrigen umhang");
  SetProp (P_SHORT, "Ein loechriger Umhang");
  SetProp (P_LONG,
    "Es ist ein schon etwas abgetragener, ziemlich loechriger Umhang, wie "+
    "ihn manche Gaffos tragen.");
  SetProp (P_NAME, "Umhang");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 220);
  SetProp (P_VALUE, 500);
  SetProp (P_MATERIAL, MAT_FELT);

  SetProp (P_ARMOUR_TYPE, AT_CLOAK);  // siehe sys/combat.h
  SetProp (P_AC, 5);
}
