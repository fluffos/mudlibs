#pragma strong_types

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
// #include "../files.h"

#define UNIQ_ID "\ntilly_muetzchen"
#define pl this_player()
#define BS break_string

string extra_look()
{
  if(QueryProp(P_WORN)){
    if(environment()->QueryArmourByType(AT_HELMET)){
      return(BS(environment()->Name()+" traegt ueber "
       +(environment()->QueryProp(P_GENDER)==1?"seiner":"ihrer")+" uebrigen "
       "Kopfbekleidung noch ein rotes Zipfelmuetzchen.",78));
     }
    else{
      return environment()->Name()+" traegt ein rotes "
       +"Zipfelmuetzchen.\n";
     }
   }
}

int reaktion()
{
  if(!QueryProp(P_WORN)) return 0;
  if(getuid(previous_object())!="d.ebene") return 0;

  write(BS("Das Gloeckchen von Deinem Zipfelmuetzchen bimmelt aufgeregt.",78));
  tell_room(environment(pl),"<Klingeling> Das Gloeckchen von "
   +pl->name(WESSEN)+" Zipfelmuetzchen bimmelt aufgeregt.\n",({pl}));
  return 1;
}

void create()
{
  if(!is_clone(this_object())) return;
  ::create();

  AddId(UNIQ_ID);
  AddId("muetzchen");
  AddId("zipfelmuetzchen");

  SetProp(P_LIGHT,1);
  SetProp(P_SHORT,"Ein rotes Zipfelmuetzchen");
  SetProp(P_LONG,BS("Dieses rote Zipfelmuetzchen ist zwar eigentlich "
   "etwas fuer Zwerge, dies scheint aber eine angepasste Version fuer "
   "kleine suesse Feen zu sein. An dem langen Zipfel, der uebrigens am "
   "oberen Ende leicht eingeknickt ist, befindet sich ein lustiges "
   "Gloeckchen. Und Du wuerdest Dich wirklich nicht wundern, wenn das "
   "Muetzchen auch noch im Dunkeln leuchten wuerde.",78));
  AddSpecialDetail(({"zwerg","zwerge"}),"zwerg_det");
  AddSpecialDetail(({"fee","feen"}),"fee_det");
  AddDetail( ({"zipfel"}), "Der Zipfel ist am Ende ein bisschen eingeknickt. "
      "Dort befindet sich ein kleines Gloeckchen." );
  AddDetail( ({"ende"}),"Meinst Du dort, wo sich das Gloeckchen befindet?\n" );
  AddDetail( ({"knick"}), "Es ist kein schlimmer Knick, "
      "das Muetzchen wird ihn ueberleben.");
  AddDetail( ({"gloeckchen"}), "Du koenntest mit ihm bimmeln.\n" );
  SetProp(P_ARTICLE,1);
  SetProp(P_GENDER,NEUTER);
  SetProp(P_NAME_ADJ,"rot");
  SetProp(P_NAME,"Zipfelmuetzchen");
  SetProp(P_INFO,"Dieses Zipfelmuetzchen ist von Zwergen fuer Feen.\n");
  SetProp(P_VALUE,1060);
  SetProp(P_WEIGHT,200);
  SetProp(P_AC,0);
  SetProp(P_ARMOUR_TYPE,AT_MISC);
  SetProp(P_MATERIAL,MAT_CLOTH);
  SetProp(P_WEAR_FUNC,this_object());
  // SetProp(P_WEAR_RESTRICTIONS,([SR_INCLUDE_RACE:({"Zwerg"})]));

  AddCmd(
      ({ "nein","nicke","nick","ja","huepf","huepfe","nies","niese",
         "tanz","tanze","schuettel","schuettle" }),
      "div_cmd" );

  AddCmd( ({"bimmel","bimmle","bimmele"}),"bimmel_cmd" );
}

nosave int div_cmd()
{
  if(QueryProp(P_WORN)){
    if(find_call_out("reaktion")==-1)
      call_out("reaktion",1);
    return 0;
   }
}

nosave int bimmel_cmd(string str)
{
  notify_fail("Mit was moechtest Du bimmeln?\n");
  if(!str) return 0;
  if(str=="gloeckchen"||str=="mit gloeckchen"){
    if(environment(this_object())!=pl){
      write("Nimm das Zipfelmuetzchen doch erstmal an Dich.\n");
      return 1;
     }
    else{
      write("<Klingeling> Du bimmelst mit dem Gloeckchen des Zipfelmuetzchens.\n");
      tell_room(environment(pl),"<Klingeling>\n"
       +pl->name()+" klingelt mit dem Gloeckchen eines "
       +"Zipfelmuetzchens.\n",({pl}));
      return 1;
     }
   }
  return 0;
}

nosave string zwerg_det()
{
  if(pl->QueryProp(P_RACE)=="Zwerg")
    return "Du weisst doch wohl, wie Zwerge aussehen.\n";
  return "Ja, schau Dir mal einen an.\n";
}

nosave string fee_det()
{
  if(pl->QueryProp(P_RACE)=="Fee")
    return "Du weisst doch wohl am besten, wie eine Fee aussieht?!\n";
  return "Ja, schau Dir doch mal eine an.\n";
}

int WearFunc()
{
  object *rue;
  int i;

  if (strstr(lower_case(pl->QueryProp(P_RACE)),"fee") == -1)
  {
    tell_object(pl,
        "Och schade, das Zipfelmuetzchen scheint nur Feen zu passen.\n");
    return 0;
  }

  rue = pl->QueryProp(P_ARMOURS);
  if(i=sizeof(rue))
  {
    do {
      i--;
      if(rue[i]->id(UNIQ_ID)){
        tell_object(pl,"Du traegst bereits ein Zipfelmuetzchen.\n");
        return 0;
       }
     } while(i>0);
  }
  return 1;
}
