/*
** Nachtamulett  Woody
** ---
** 1996-06-21
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

#include "../obj.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"amulett","nachtamulett"}));
  SetProp (P_SHORT, "Ein Nachtamulett");
  SetProp (P_LONG,
      "Das Amulett besteht aus einem Dir unbekannten, tiefschwarzen "
      "Material, das sich wie ein sehr kalter Stein anfuehlt. Als Du "
      "genauer hinschaust, erkennst Du irgendwie ein seltsames Funkeln "
      "und Glitzern, eine Art magische Aura, die das Amulett umgibt. "
      "Es haengt an einer silbernen Kette und macht einen sehr "
      "wertvollen Eindruck auf Dich.");

  SetProp (P_INFO,
      "Das Nachtamulett kann Dich von Zeit zu Zeit staerken.\n");
  SetProp (P_NAME, "Nachtamulett");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 100);
  SetProp (P_VALUE, 1200);
  SetProp (P_NOBUY, 1);
  SetProp (P_ARMOUR_TYPE, AT_AMULET);
  SetProp (P_AC, 4);
  SetProp (P_MATERIAL,
      ([ MAT_MISC_STONE:90,
         MAT_SILVER:10,
         MAT_MISC_MAGIC:100]) );

  AddDetail ( ({"stein","material"}),
      "Du kannst nicht genau herausfinden, um was fuer eine Art von "
      "Stein es sich handelt, es scheint aber eine Aura der Macht "
      "um ihn zu liegen.");
  AddDetail ( ({"aura","glitzern","funkeln"}),
      "Ein seltsames Glitzern und Funkeln umgibt den Stein des "
      "Nachtamuletts, betoerend und verzaubernd wie das Funkeln der "
      "Sterne. Es scheint sehr maechtig zu sein.");
  AddDetail ( ({"kette"}),
      "Die Kette, an dem das Nachtamulett haengt, besteht aus reinstem "
      "Silber.");
  AddDetail ( ({"silber"}),
      "Es glitzert und funkelt fast so wie der seltsame Stein.");
}

reset()
{
  object ob;
  int x;

  ::reset();
  if (QueryProp(P_GHOST)) return;
  if (QueryProp(P_FROG)) {
    tell_object(ob,
      "Das Nachtamulett funkelt und glitzert leicht, scheint aber seine Magie\n"
      "nicht auf Froesche uebertragen zu koennen..\n");
    return;
  }
  if (ob=QueryProp(P_WORN)) {
    x = (QueryProp(P_AC) - 1) * 50 + random(5) * 25;
    tell_object(ob,
        "Das Nachtamulett funkelt und glitzert kurz auf.\n");
    ob->heal_self(x);
    tell_object(ob,
        "Du spuerst eine staerkende Kraft, die Dich durchfaehrt.\n");
  }
}

