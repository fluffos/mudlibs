/*
** Otterfell
** (w) 1996-04-06 Woody@SL
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"fell","otterfell"}));
  SetProp (P_SHORT, "Ein Otterfell");
  SetProp (P_LONG,
    "Dieses Otterfell gehoerte wohl einmal einem kleinen Otter. Es schuetzt"+
    "\nseinen Traeger ein wenig vor der Witterung.\n");
  SetProp (P_NAME, "Otterfell");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 400);
  SetProp (P_VALUE, 300);

  SetProp (P_ARMOUR_TYPE, AT_CLOAK);  // siehe sys/combat.h
  SetProp (P_AC, 5);

  SetProp (P_MATERIAL, MAT_PELT);
}
