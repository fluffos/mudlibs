/*
** Plueschstiefel  (w) Woody
** Vllt. fuer Automaten? :)
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"plueschstiefel","stiefel"}));
  SetProp(P_SHORT, "Ein Paar Plueschstiefel");
  SetProp(P_LONG,
      "Kleine, schwarze Plueschstiefel, wie sie bestenfalls einer Puppe "
      "passen koennen. Dennoch kannst Du versuchen, sie anzuziehen, aber "
      "viel Schutz werden sie Dir nicht bieten, da sie gerade mal Deine "
      "kleine Zehe bedecken werden.");
  SetProp(P_NAME, "Paar Plueschstiefel");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100);

  SetProp(P_ARMOUR_TYPE, AT_BOOT);  // siehe sys/combat.h
  SetProp(P_AC, 1);

  SetProp(P_WEAR_TEXT,
      ({ "Du streifst Dir %s ueber die kleinen Zehen.\n",
         " streift %s ueber die kleinen Zehen.\n" }) );
  SetProp(P_UNWEAR_TEXT,
      ({ "Du ziehst %s mit Fingerspitzen aus.\n",
         " zieht %s mit Fingerspitzen aus.\n" }) );
}
