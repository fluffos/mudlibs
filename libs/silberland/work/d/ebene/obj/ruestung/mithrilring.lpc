inherit "/std/armour";

#include <combat.h>
#include <properties.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId( ({"ring", "mithrilring"}) );
  SetProp(P_SHORT, "Ein machtvoller Mithrilring");
  SetProp(P_LONG,
      "Du haeltst den wertvollen, geheimnisumwitterten Mithrilring "
      "in Haenden. Er bewahrt Dich in Gefahrensituationen vor "
      "boesartigen Schaeden, wehrt Daemonen ab, lenkt feindliches "
      "Feuer um, schmilzt schmerzendes Eis und hilft Dir, so gut es "
      "ein Ring nur tun kann.");

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Mithrilring");
  SetProp(P_NAME_ADJ, "machtvoll");
  AddAdjective( ({ "machtvollen", "machtvoller" }) );

  SetProp(P_INFO,
      "Die Macht des Ringes ist einzigartig im Reich der Finsternis.\n");

  SetProp( P_WEAR_TEXT,
      ({ "Du ziehst %s an.\n"+
         "Die Macht des Ringes legt sich wie eine Aura um Deine Hand.\n",
         " zieht %s an.\n" }) );

  SetProp( P_UNWEAR_TEXT,
      ({ "Du ziehst %s aus.\n"+
         "Die Aura um Deine Hand erlischt.\n",
         " zieht %s aus.\n" }) );

  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, 4);
  SetProp(P_DEFEND_FUNC, this_object());

  SetProp(P_MATERIAL, MAT_MITHRIL);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1600);
  SetProp(P_QUALITY_DECAY, 50);
}

varargs int move(mixed dest, int method)
{
  if (interactive(dest))
    call_out("set_info", 3600);
  return ::move(dest,method);
}

void set_info()
{
  if (objectp(QueryProp(P_WORN)))
    tell_object( QueryProp(P_WORN), "Der Mithrilring funkelt kurz.\n" );

  SetProp(P_INFO,
      "Du hast es die ganze Zeit schon vermutet: Der Ring ist Tineff!\n");
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
{
  string txt;

  if (random(3))
    return 0;

  if (member(dtyp, DT_FIRE) != -1)
    txt = "Der Mithrilring lenkt das Feuer auf magische Weise von Dir ab.\n";
  else if (member(dtyp, DT_COLD) != -1)
    txt = "Der Mithrilring absorbiert die Kaelte.\n";
  else if (member(dtyp, DT_WATER) != -1)
    txt = "Der Mithrilring saugt das Wasser auf.\n";
  else if (member(dtyp, DT_AIR) != -1)
    txt = "Der Mithrilring macht aus dem Wirbelsturm ein laues Lueftchen.\n";
  else if (member(dtyp, DT_LIGHTNING) != -1)
    txt = "Der Mithrilring verwandelt sich kurzzeitig in einen Blitzableiter.\n";
  else if (member(dtyp, DT_EXPLOSION) != -1)
    txt = "Der Mithrilring bildet die zur Explosion passende Implosion.\n";
  else if (member(dtyp, DT_SOUND) != -1)
    txt = "Der Mithrilring formt aus dem Krach wohltuende Musik.\n";
  else if (member(dtyp, DT_LIGHT) != -1)
    txt = "Der Mithrilring wirft Schatten ueber das Licht.\n";
  else if (member(dtyp, DT_ELECTRIC) != -1)
    txt = "Der Mithrilring erzeugt einen Kurzschluss.\n";
  else if (member(dtyp, DT_ACID) != -1)
    txt = "Der Mithrilring saettigt die Saeure.\n";
  else if (member(dtyp, DT_POISON) != -1)
    txt = "Der Mithrilring entgiftet das Gift.\n";
  else if (member(dtyp, DT_TERROR) != -1)
    txt = "Der Mithrilring nimmt dem Angriff den Schrecken.\n";
  else if (member(dtyp, DT_HOLY) != -1)
    txt = "Der Mithrilring macht Dich zu einem Scheinheiligen.\n";
  else if (member(dtyp, DT_UNHOLY) != -1)
    txt = "Der Mithrilring bewahrt Dich vor allem Boesen.\n";
  else if (member(dtyp, DT_MIND) != -1)
    txt = "Der Mithrilring simuliert ein Ueber-Ich.\n";
  else if (!random(4))
    txt = "Der Mithrilring ist gegen rohe Gewalt machtlos.\n";
  else
    txt = "";

  tell_object( QueryProp(P_WORN), txt );
  return 0;
}
