/*
** Igelfell
** (w) 1996-05-04 Woody@SL
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/d/ebene/ebene.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"fell","igelfell","\nfell_is_gerb_able"}));
  SetProp (P_SHORT, "Ein Igelfell");
  SetProp (P_LONG, bs(
    "Dieses Igelfell wurde aus zwei kleinen Igelfellen zusammengenaeht, "+
    "wodurch es gross genug ist, um als Schutz getragen zu werden."));
  SetProp (P_NAME, "Igelfell");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 1000);
  SetProp (P_VALUE, 500);

  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);  // siehe sys/combat.h
  SetProp (P_AC, 15);

  SetProp (P_MATERIAL, MAT_PELT);
}
