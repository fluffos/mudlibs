/*
** Gaffohelm
** (w) 1996-09-21  Woody
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"helm", "gaffohelm"}));
  SetProp (P_SHORT, "Ein Gaffohelm");
  SetProp (P_LONG, "Ein einfacher Helm aus den Bestaenden der Gaffos.\n");
  SetProp (P_NAME, "Gaffohelm");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 300);
  SetProp (P_VALUE, 200);

  SetProp (P_ARMOUR_TYPE, AT_HELMET);  // siehe sys/combat.h
  SetProp (P_AC, 5);

  SetProp (P_MATERIAL, MAT_COPPER);
}
