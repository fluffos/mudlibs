// /d/ebene/obj/ruestung/beinschienen.c
// Beinschienen aus Eisen fuer Kampfsoldaten 
// 1997-08-25  Feyaria@SilberLand

#include "/d/ebene/ebene.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eiserne Beinschienen");
  SetProp(P_LONG, BS( 
    "Diese Beinschienen aus Eisen schuetzen die Beine vor Schlaegen.") );
  SetProp(P_INFO, BS(
    "Die Beinschienen sind fuer menschliche Proportionen angefertigt."));
  SetProp(P_NAME, "Beinschienen");
  SetProp(P_NAME_ADJ, "eisern");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 5+random(3));
  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 700);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE:({"Mensch"})]) );

  AddId( ({"beinschienen", "eisenbeinschienen"}) );
  AddAdjective( ({"eisern", "eiserne"}) );
  
}

