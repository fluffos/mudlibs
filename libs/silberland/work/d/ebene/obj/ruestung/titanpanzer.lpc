/*
** Titanpanzer
** (w) 1996-04-13 Woody@SL
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"panzer","titanpanzer"}));
  SetProp (P_SHORT, "Ein Titanpanzer");
  SetProp (P_LONG, "Dieser schlichte Panzer besteht aus haertestem Titan.\n");
  SetProp (P_NAME, "Titanpanzer");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 1750);
  SetProp (P_VALUE, 2000);

  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);  // siehe sys/combat.h
  SetProp (P_AC, 35);

  SetProp (P_MATERIAL, MAT_TITANIUM);
  AddDetail ("titan", "Der Titan des Panzers scheint nahezu "+
    "undurchdringbar zu sein, ohne jedoch uebermaessig viel zu wiegen.");
}
