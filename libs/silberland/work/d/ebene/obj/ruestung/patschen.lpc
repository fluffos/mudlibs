/*
** Patschen  (w) Woody
** Die des Beamten
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"patschen","schuhe","hausschuhe"}));
  SetProp (P_SHORT, "Ein Paar Hausschuhe");
  SetProp (P_LONG,
      "Ein einfaches Paar Hausschuhe aus duennem Leder, man nennt "
      "sie mitunter auch gern 'Patschen'. Ganz angenehm zu tragen, "
      "zumindest fuer drinnen.");
  SetProp (P_NAME, "Paar Hausschuhe");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 150);
  SetProp (P_VALUE, 300);

  SetProp (P_ARMOUR_TYPE, AT_BOOT);  // siehe sys/combat.h
  SetProp (P_AC, 3);
}
