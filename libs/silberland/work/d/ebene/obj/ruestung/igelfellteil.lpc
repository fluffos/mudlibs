/*
** Igelfellteil
** (w) 1996-05-04 Woody@SL
** ---
** 30.8.98: Igelfell per M_NOCHECK in Spieler moven
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moving.h>
#include "/d/ebene/ebene.h"
#define FELLTEIL_ID "\nigelfellteil"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"fellchen","igelfellchen",FELLTEIL_ID}));
  SetProp (P_SHORT, "Ein Igelfellchen");
  SetProp (P_LONG, bs(
    "Dieses kleine Igelfellchen koennte man versuchen, als Schutz zu "+
    "tragen. Wenn, ja wenn es nur nicht so klein waere..."));
  SetProp (P_NAME, "Igelfellchen");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 500);
  SetProp (P_VALUE, 200);

  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);  // siehe sys/combat.h
  SetProp (P_AC, 5);
  SetProp (P_WEAR_FUNC, ME);

  SetProp (P_MATERIAL, MAT_PELT);
}

init()
{
  object ob, other;
  ::init();
  if (!MENV) return;
  if (!interactive(MENV)) return;
  other=0; ob=ME;
  while ((ob=next_inventory(ob)) && !other)
    if (ob->id(FELLTEIL_ID)) other=ob;
  if (other) call_out ("naehen", 0, other, MENV);
  return;
}

naehen(object other, naeher)
{
  tell_object (naeher, bs("Du naehst zwei kleine Igelfellchen zu einem "+
    "groesseren Igelfell zusammen. Vielleicht ist es ja jetzt gross genug "+
    "zum anziehen?"));
  tell_room (ENV(naeher), naeher->name()+" naeht zwei kleine Igelfellchen "+
    "zu einem groesseren Igelfell zusammen.\n", ({naeher}));
  clone_object(OBJ("ruestung/igelfell"))->move(naeher, M_NOCHECK);
  other->remove();
  call_out ("remove", 0);
  return;
}

WearFunc()
{
  write (bs("Du versuchst, das kleine Igelfellchen anzuziehen, scheiterst "+
    "jedoch klaeglich. Vielleicht waeren zwei dieser Fellchen gerade "+
    "gross genug?"));
  return 0;
}
