/*
** Ein Gaffoumhang
** 1996-09-24  Woody
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId ("umhang");
  AddId ("gaffoumhang");
  SetProp (P_SHORT, "Ein Gaffoumhang");
  SetProp (P_LONG,
    "Es ist der feste, relativ reissfeste Umhang eines Gaffowaechters.\n");
  SetProp (P_NAME, "Umhang");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 300);
  SetProp (P_VALUE, 800);

  SetProp (P_ARMOUR_TYPE, AT_CLOAK);  // siehe sys/combat.h
  SetProp (P_AC, 7);
}
