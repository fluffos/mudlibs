/*
** Platinhelm
** (w) 1996-04-13 Woody@SL
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"helm", "platinhelm"}));
  SetProp (P_SHORT, "Ein Platinhelm");
  SetProp (P_LONG,
    "Dieser widerstandsfaehige Helm ist wohl Offizieren vorbehalten.\n");
  SetProp (P_NAME, "Platinhelm");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 500);
  SetProp (P_VALUE, 400);

  SetProp (P_ARMOUR_TYPE, AT_HELMET);  // siehe sys/combat.h
  SetProp (P_AC, 8);

  SetProp (P_MATERIAL, MAT_PLATINUM);
  AddDetail ("platin", "Das Platin des Helmes ist aeusserst "+
    "widerstandsfaehig, zugleich jedoch nicht zu schwer, kurzum: "+
    "das ideale Material fuer einen hochwertigen Helm.");
}
