/*
** Biberfell
** (w) 2000-05-26 Woody
*/

inherit "std/armour2";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>

#define MAX_WASSER 15

int wasser;

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"fell","biberfell"}));
  SetProp (P_SHORT, "Ein Biberfell");
  SetProp (P_LONG,
    "Dieses Biberfell hast Du wohl einem kleinen, unschuldigen Biber "
    "abgejagt. Schaem Dich! Wie auch immer, es scheint wasserundurchlaessig "
    "zu sein. Toll, was?");
  SetProp (P_NAME, "Biberfell");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 400);
  SetProp (P_VALUE, 300);
  SetProp (P_INFO,
    "Du kannst das Biberfell auswringen, wenn es voller Wasser ist.\n");

  SetProp (P_ARMOUR_TYPE, AT_CLOAK);  // siehe sys/combat.h
  SetProp (P_AC, 5);
  SetProp (P_DEFEND_FUNC, this_object());

  SetProp (P_MATERIAL, MAT_PELT);
  
  wasser=0;
  AddCmd( ({"wring","wringe"}), "wring" );
#ifdef DEBUG
  AddCmd( ({"tauch","tauche"}), "tauch" );
#endif
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
{
  if (member(dtyp, DT_WATER) < 0) return 0;
  if (random(5)<2)
  {
    if (wasser >= MAX_WASSER) {
#ifdef DEBUG
      tell_room (environment(QueryProp(P_WORN)),
          "Wasser -> Biberfell (aber voll!)\n");
#else
      tell_object (QueryProp(P_WORN),
          "Das Biberfell wuerde Dich zwar vor dem Wasser schuetzen,\n"
          "aber es ist leider schon voller Wasser!\n");
#endif
    }
    else
    {
      wasser++;
#ifdef DEBUG
      tell_room (environment(QueryProp(P_WORN)),
          "Wasser -> Biberfell ("+wasser+"/"+MAX_WASSER+")\n");
#else
      tell_object (QueryProp(P_WORN),
          "Das Biberfell haelt einen Teil des Wassers ab.\n");
#endif
      return 3 + random(3);     // max. 5, d.h. P_AC+DefFunc <= 10
    }
  }
}

int wring(string str)
{
  if (!str) return notify_fail("Was willst Du (aus)wringen?\n"),0;
  if (str[<4..]==" aus") str=str[0..<5];
  if (!id(str)) return notify_fail("Das kannst Du nicht auswringen.\n"),0;

  if (wasser < MAX_WASSER/2) {
    write(break_string("Du wringst das Biberfell aus, aber es ist einfach "
          "zuwenig Wasser drin, als dass Du damit Erfolg haettest...",78));
    say(PL->Name()+" versucht vergeblich, ein Biberfell auszuwringen.\n"
        "Sieht ulkig aus :-).\n");
  } else {
    write(break_string("Du wringst das Biberfell sorgfaeltig aus und tropfst "
          "dabei die ganze Umgebung voll! Naja, macht ja nix, Hauptsache das "
          "Fell ist wieder einigermassen trocken. ;-)",78));
    say(break_string(PL->Name()+" wringt ein Biberfell sorgfaeltig aus und "
          "tropft den Boden voll mit Wasser. Tsts.",78));
    wasser=random(4);
  }
  return 1;
}

int tauch(string str)
{
  if (!str) return 0;
  if (str[<10..]==" in wasser") str=str[0..<11];
  if (!id(str)) return 0;
  write("Du tauchst das Biberfell ins Wasser und machst es ganz nass.\n");
  wasser+=5;
  return 1;
}

