/*
** Ein Gaffoschwert
** (w) 1996-09-21 Woody@SL
*/

inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId ("schwert");
  AddId ("gaffoschwert");
  SetProp (P_SHORT, "Ein Gaffoschwert");
  SetProp (P_LONG,
    "Das Gaffoschwert ist zwar nicht sonderlich prunkvoll, "+
    "scheint aber doch eine relativ brauchbare Waffe abzugeben.");
  SetProp (P_NAME, "Gaffoschwert");
  SetProp (P_GENDER, NEUTER);

  SetProp (P_WC, 135);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_VALUE, 1150);
  SetProp (P_WEIGHT, 1500);
  SetProp (P_WEAPON_TYPE, WT_SWORD);
  SetProp (P_DAM_TYPE, DT_SLASH);
  SetProp (P_MATERIAL, MAT_IRON);
}
