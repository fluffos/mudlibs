** 1996-06-10  resetcounter via autoloadobj
** 1996-07-08  reset() bugfixed
** 1997-05-20  Texte etwas ueberarbeitet, nur mehr 3 Resets autoload
** 1997-09-10  Endgueltig nicht mehr Autoload (und nach +ebene verschoben),
**             P_SPECIAL_WC 600 fuer Nachtkaempfer, wieder WC 200,
**             Umbenennung von MORDOR- zu MITHRILschwert
** 1997-10-16  P_FIXED_WC auf 0.7
** 1998-03-02  P_WC_BONUS
*/

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

// #include "/players/woody/files.h"
#include "../obj.h"

int mywc;

void create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"schwert", "mithrilschwert"}));
  SetProp (P_SHORT, "Ein funkelndes Mithrilschwert");
  SetProp (P_LONG,
    "Das Mithrilschwert ist eine der maechtigsten einhaendigen Waffe weit "
    "und breit. Man muss wohl jede Menge Kraft und Geschick besitzen, um sie "
    "fuehren zu koennen, wenn es einem jedoch gelingt, so liegt sie so gut "
    "in der Hand wie kaum eine andere Waffe.");
  AddDetail("klinge", "Sie ist sehr scharf und hart, respekteinfloessend.");
  AddDetail("griff", "Kleine Verzierungen sind um den Griff zu erkennen.");
  AddDetail("verzierungen", "Sie wurden sehr sorgfaeltig eingearbeitet.");
  SetProp (P_NAME, "Mithrilschwert");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_VALUE, 5000);
  SetProp (P_WEIGHT, 2000);
  SetProp (P_WEAPON_TYPE, WT_SWORD);
  SetProp (P_DAM_TYPE, DT_SLASH);
  SetProp (P_WC, mywc = 190+random(11));
  SetProp (P_WC_FIX, 65);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, MAT_MITHRIL);
  SetProp(P_INFO, bs("Das Mithrilschwert ist eine sehr wertvolle und "
    "gefuerchtete Waffe, ein maechtiger Einhaender. In den Haenden "
    "eines Nachtkaempfers ist es eine oft toedliche Waffe." +
    (mywc > 195 ? " Du scheinst ausserdem ein besonders gut verarbeitetes "
     "Exemplar in Haenden zu halten." : "") ));
  SetProp (P_WIELD_RESTRICTIONS, ([A_STR:15,A_DEX:16]) );
  SetProp (P_WC_BONUS, ([ "Nachtkaempfer" : 400 ]) );   // !!!!!!!!!
}

// spaeter stimmungsvolle HitFunc...

