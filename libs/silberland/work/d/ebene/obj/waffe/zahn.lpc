/*
** Ein Maeusezahn
** (w) 1996-06-08 Woody@SL
*/

inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"zahn", "maeusezahn"}));
  SetProp (P_SHORT, "Ein Maeusezahn");
  SetProp (P_LONG, "Dieser Maeusezahn war wohl einmal die Waffe einer Maus.\n");
  SetProp (P_NAME, "Zahn");
  SetProp (P_GENDER, MALE);

  SetProp (P_VALUE, 300);
  SetProp (P_WEIGHT, 600);
  SetProp (P_WEAPON_TYPE, WT_KNIFE);
  SetProp (P_DAM_TYPE, DT_PIERCE);
  SetProp (P_WC, 55);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, MAT_HORN);
}
