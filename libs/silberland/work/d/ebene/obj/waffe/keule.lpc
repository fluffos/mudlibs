/*
** Eine Keule
** (w) 1996-04-04 Woody@SL
*/

inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId ("keule");
  SetProp (P_SHORT, "Eine Keule");
  SetProp (P_LONG, "Eine maechtige Keule, wie sie normal von wilden "+
    "Gaffos verwendet wird.\n");
  SetProp (P_NAME, "Keule");
  SetProp (P_GENDER, FEMALE);

  SetProp (P_VALUE, 500);
  SetProp (P_WEIGHT, 1200);
  SetProp (P_WEAPON_TYPE, WT_CLUB);
  SetProp (P_DAM_TYPE, DT_BLUDGEON);
  SetProp (P_WC, 90);
  SetProp (P_NR_HANDS, 1);
  switch (random(4))
  {
    case 0:  SetProp (P_MATERIAL, MAT_OAK); break;      // Eichenholz
    case 1:  SetProp (P_MATERIAL, MAT_BEECH); break;    // Buchen-
    case 2:  SetProp (P_MATERIAL, MAT_EBONY); break;    // Eben-
    default: SetProp (P_MATERIAL, MAT_FIR);             // Tannen-
  }
}
