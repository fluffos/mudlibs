/*
** Ein Schreibstift
** (w) 1996-04-04 Woody@SL
*/

inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId ("stift");
  AddId ("schreibstift");
  SetProp (P_SHORT, "Ein Stift");
  SetProp (P_LONG, "Ein Stift, mit dem man schreiben kann. Er hat "
    "ausserdem eine ziemlich spitze Spitze, sodass er im Notfall "
    "auch als Waffe taugt.");
  SetProp (P_NAME, "Stift");
  SetProp (P_GENDER, MALE);

  SetProp (P_VALUE, 50);
  SetProp (P_WEIGHT, 100);
  SetProp (P_WEAPON_TYPE, WT_SPEAR);
  SetProp (P_DAM_TYPE, DT_PIERCE);
  SetProp (P_WC, 45);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, ([MAT_WOOD:80,MAT_CARBON:20]) );
}
