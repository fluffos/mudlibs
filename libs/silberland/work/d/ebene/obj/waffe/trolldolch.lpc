/*
** Ein Trolldolch
** (w) 1. Feb 1997  Woody@SL
*/

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId ("dolch");
  AddId ("trolldolch");
  SetProp (P_SHORT, "Ein Trolldolch");
  SetProp (P_LONG,
    "Der kleine, aber sehr gefaehrliche Dolch eines Trolls.\n");
  SetProp (P_NAME, "Trolldolch");
  SetProp (P_GENDER, MALE);

  SetProp (P_VALUE, 400);
  SetProp (P_WEIGHT, 800);
  SetProp (P_WEAPON_TYPE, WT_KNIFE);
  SetProp (P_DAM_TYPE, DT_SLASH);
  SetProp (P_WC, 100);
  SetProp (P_NR_HANDS, 1);
  if (random(2))
    SetProp (P_MATERIAL, MAT_BRONCE);   // Bronze
  else
    SetProp (P_MATERIAL, MAT_IRON);     // Eisen
}
