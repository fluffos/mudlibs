/*
** Das Silberschwert
** (w) 1996-04-13 Woody@SL
** ---
** 1996-04-17  ein paar Details
** 1996-09-02  Detail silber, etwas teurer
** 1998-03-02  P_WC_BONUS
*/

inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein Silberschwert");
  SetProp (P_LONG, 
    "Das praechtige Silberschwert blitzt und funkelt respekteinfloessend.\n"+
    "Es hat einen wunderschoenen kunstvoll gearbeiteten Knauf.\n");
  SetProp (P_NAME, "Silberschwert");
  SetProp (P_GENDER, NEUTER);
  AddId (({"schwert", "silberschwert"}));
  SetProp (P_VALUE, 2000);
  SetProp (P_WEIGHT, 2000);
  SetProp (P_WEAPON_TYPE, WT_SWORD);
  SetProp (P_DAM_TYPE, DT_SLASH);
  SetProp (P_WC, 180);
  SetProp (P_NR_HANDS, 2);
  SetProp (P_MATERIAL, MAT_SILVER);
  AddDetail ("knauf", "Wundervolle Verzierungen schmuecken dieses "+
    "prachtvolle Schwert.\n");
  AddDetail ("verzierungen", "Sie sind sehr kunstvoll gearbeitet. Bestimmt "+
    "ist das Schwert sehr wertvoll.\n");
  AddDetail ("silber", "Das Silber des Schwertes macht dieses wohl sehr "+
    "wertvoll.");
  SetProp(P_WC_BONUS, (["Offizier":92]) );
}
