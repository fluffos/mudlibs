/*
** Ein aufklappbares Taschenmesser
** (w) 1996-08-19 Woody@SL
** 2001-05-14 debugged, woody
*/

inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */
#include "../obj.h"

int klap = 0;

void klappen(int auf);

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId("taschenmesser");
  AddId("messer");
  SetProp(P_NAME, "Taschenmesser");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_VALUE, 500);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_WC, 100);
  SetProp(P_WC_FIX, 40);
  SetProp(P_HIT_FUNC, this_object());
  SetProp(P_WIELD_FUNC, this_object());
  SetProp(P_UNWIELD_FUNC, this_object());
  SetProp(P_MATERIAL, MAT_STEEL);
  AddCmd( ({"klapp", "klappe"}), "klappe");
  klappen(0);
}


void klappen(int auf)
{
  if (auf)
  {
    SetProp (P_SHORT, "Ein aufgeklapptes Taschenmesser");
    SetProp (P_LONG,
      "Ein aufgeklapptes Taschenmesser. Du kannst es zuecken.\n");
    SetProp( P_QUALITY_DECAY, 50 );
    SetProp( P_WEAPON_TYPE, WT_KNIFE );
  }
  else
  {
    SetProp (P_SHORT, "Ein Taschenmesser");
    SetProp (P_LONG,
      "Ein aufklappbares Taschenmesser. Du kannst es zuecken.\n");
    SetProp( P_QUALITY_DECAY, 150 );
    SetProp( P_WEAPON_TYPE, WT_CLUB );
  }
  klap = auf;
}


int klappe(string str)
{
  string s1, s2;

  notify_fail ("Was willst Du auf- oder zu- oder wie klappen?\n");
  if (!str)
    return 0;
  if (sscanf(str, "%s %s", s1, s2) != 2)
    return 0;
  if (!id(s1))
    return 0;
  if (MENV != TP)
    return
      notify_fail("Dazu musst Du das Taschenmesser schon erst nehmen!\n"), 0;

  switch (s2)
  {
    case "auf":
      if (klap) {
        write("Aber das Taschenmesser ist doch schon aufgeklappt!\n");
        break;
      }
      if (QueryProp(P_WIELDED)) {
        write("Das kannst Du nicht, solange Du das Taschenmesser "+
          "gezueckt hast!\n");
        break;
      }
      write("Du klappst das Taschenmesser auf.\n");
      say(TP->Name()+" klappt ein Taschenmesser auf.\n");
      klappen(1);
      break;
    case "zu":
    case "ein":
      if (!klap) {
        write("Aber das Taschenmesser ist doch schon eingeklappt!\n");
        break;
      }
      if (QueryProp(P_WIELDED)) {
        write("Das kannst Du nicht, solange Du das Taschenmesser "+
          "gezueckt hast!\n");
        break;
      }
      write("Du klappst das Taschenmesser ein.\n");
      say(TP->Name()+" klappt ein Taschenmesser ein.\n");
      klappen(0);
      break;
    default:
      return 0;
  }
  return 1;
}


int WieldFunc(object waffe, int silent)
{
  if (!query_once_interactive(this_player()))
    klappen(1);
  return 1;
}


int UnwieldFunc(object waffe, int silent)
{
  if (!query_once_interactive(QueryProp(P_WIELDED)))
    klappen(0);
  return 1;
}


int HitFunc(object enemy)
{
  if (klap)
    return 0;

  if (random(10) == 7)
  {
    tell_object(QueryProp(P_WIELDED),
        "Kommst Du Dir nicht komisch vor, "
        "mit einem zugeklapptem Messer zu kaempfen?\n");
  }

  // min. 30 ...
  if (QueryProp(P_WC) < 80)
    return -20 - random( (QueryProp(P_WC)-29) * 30 / 50 );
  else
    return -20 - random(31);
}

