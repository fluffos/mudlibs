/*
** Ein Buegeleisen :)
** (w) 1996-10-20 Woody@SL
*/

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId ("buegeleisen");
  AddId ("eisen");
  SetProp (P_SHORT, "Ein Buegeleisen");
  SetProp (P_LONG, "Ein altes, schon leicht verbeultes Buegeleisen.");
  SetProp (P_NAME, "Buegeleisen");
  SetProp (P_GENDER, NEUTER);

  SetProp (P_VALUE, 100);
  SetProp (P_WEIGHT, 1000);
  SetProp (P_WEAPON_TYPE, WT_MISC);
  SetProp (P_DAM_TYPE, DT_BLUDGEON);
  SetProp (P_WC, 40);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, MAT_IRON);
}
