/*
** Eckzaehne (eines Wildschweins)
** (w) 1996-04-04 Woody@SL
*/

inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"eckzaehne","zaehne"}));
  SetProp (P_SHORT, "Zwei Eckzaehne");
  SetProp (P_LONG, "Die spitzen scharfen Eckzaehne stammen wohl von einem "+
    "Wildschwein und\nsind eine gefaehrliche Waffe.\n");
  SetProp (P_NAME,
    ({"zwei Eckzaehne","zwei Eckzaehne","zwei Eckzaehnen","zwei Eckzaehne"}));
  SetProp (P_ARTICLE, 0);
  SetProp (P_GENDER, MALE);

  SetProp (P_VALUE, 400);
  SetProp (P_WEIGHT, 800);
  SetProp (P_WEAPON_TYPE, WT_KNIFE);  // naja eher noch Messer als Stab/Speer
  SetProp (P_DAM_TYPE, DT_PIERCE);
  SetProp (P_WC, 80);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, MAT_HORN);
}
