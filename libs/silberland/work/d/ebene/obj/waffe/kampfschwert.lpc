/*
** Ein Kampfschwert
** (w) 1996-04-04 Woody@SL
**
** 2.3.98: P_WC_BONUS
*/

inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId ("schwert");
  AddId ("kampfschwert");
  SetProp (P_SHORT, "Ein Kampfschwert");
  SetProp (P_LONG, "Das maechtige Kampfschwert stellt eine durchaus "+
    "ernstzunehmende\nBedrohung fuer seine Gegner da.\n");
  SetProp (P_NAME, "Kampfschwert");
  SetProp (P_GENDER, NEUTER);

  SetProp (P_VALUE, 1500);
  SetProp (P_WEIGHT, 1750);
  SetProp (P_WEAPON_TYPE, WT_SWORD);
  SetProp (P_DAM_TYPE, DT_SLASH);
  SetProp (P_WC, 150);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, MAT_STEEL);
  SetProp (P_WC_BONUS, (["Kampfsoldat":30]) );
}
