inherit "/std/thing";

#include <properties.h>
#include <language.h>
#include <sdefines.h>
#include <lightsource.h>

#define MAXFUEL 4000

create() {
  ::create();
  AddId( ({"petroleumflasche", "petroleum", "flasche", "\npetroleum"}) );
  SetProp(P_NAME,"Petroleumflasche");
  SetProp(P_VALUE,300);
  SetProp(P_WEIGHT,1500);
  SetProp(P_GENDER,FEMALE);
  SetProp(P_SHORT,"Eine Petroleumflasche");
  SetProp(P_LONG, "\tEine Flasche mit einem Etikett, "
      "auf dem 'Petroleum' zu lesen ist. Vermutlich\n"
      "kann man damit Petroleumlampen nachfuellen. @@voll@@");
  SetProp(P_ARTICLE,1);
  SetProp(P_FUEL,MAXFUEL);
  SetProp(P_MATERIAL, MAT_GLASS);
}

string voll()
{
  int i,j;
  i=((10*((j=QueryProp(P_FUEL))+MAXFUEL/20))/MAXFUEL)*10;
  if (j==0)
    return "Sie ist jedoch absolut leer.\n";
  else if (i==0)
    return "Sie ist jedoch nahezu leer.\n";
  else if (j==MAXFUEL)
    return "Sie ist noch randvoll gefuellt.\n";
  else if (i==100)
    return "Sie ist noch nahezu randvoll gefuellt.\n";
  else
    return "Sie ist noch etwa zu "+i+"% gefuellt.\n";
}
