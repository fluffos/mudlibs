/*
** Ein Steinpilz
** ---
** 1996-03-03  Woody@SL  Release
** 1996-04-08  Woody@SL  AddCmd essen
*/

inherit "std/thing";

#include <properties.h>
#include "/d/ebene/woody/q/pilz/quest.h"
#include "../../ebene.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  AddId (({"pilz","steinpilz","herrenpilz",STEINPILZID}));
  SetProp (P_SHORT, "Ein Steinpilz");
  SetProp (P_LONG, "Ein herrlich frisch riechender Steinpilz.\n");
  SetProp (P_NAME, "Steinpilz");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 10);
  SetProp (P_WEIGHT, 50);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_MISC_PLANT);
  AddCmd (({"iss","ess","esse","futter","mampf"}), "iss");
}

int iss(string str)
{
  notify_fail("WAS willst Du essen?\n");
  if (!stringp(str) || str=="") return 0;
  if (id(str)) {
    write ("Dieser Pilz ist nicht zum Essen bestimmt! "+
      "Zumindest nicht fuer Dich!\n");
    return 1;
  }
  else return (notify_fail("Das kannst Du nicht essen!\n"), 0);
}
