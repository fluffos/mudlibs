/*
** Ein Kleeblatt
** ---
** 1996-04-08  Woody@SL  Release
*/

inherit "std/thing";

#include <properties.h>
#include "../../ebene.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein vierblaettriges Kleeblatt");
  SetProp (P_LONG, "Dieses vierblaettrige Kleeblatt bringt gewiss Glueck.\n");
  SetProp (P_NAME, "Kleeblatt");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_VALUE, 50);
  SetProp (P_WEIGHT, 10);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_MISC_PLANT);
  AddId (({"klee","kleeblatt"}));
}
