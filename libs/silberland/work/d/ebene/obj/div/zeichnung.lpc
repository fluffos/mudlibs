/*
** Eine alte Zeichnung
** ---
** 1996-10-20  Woody@SL  Release
*/

inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include "/d/ebene/woody/q/felben/quest.h"
#include "../../ebene.h"

#define MYLONG \
    "Du betrachtest die Zeichnung ein wenig naeher. " \
    "Sie zeigt das Gesicht einer offenbar eher jungen Gaffofrau, " \
    "die von ungewoehnlicher Schoenheit ist. Bestimmt ist diese " \
    "Zeichnung einst ein wertvolles Erinnerungsstueck seines Besitzers " \
    "gewesen, bevor dieser sie verloren hat."

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Zeichnung");
  SetProp (P_LONG, MYLONG+" Allerdings ist sie ziemlich zerknittert... "
    "vielleicht kannst Du sie ja glaetten?");
  SetProp (P_NAME, "Zeichnung");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NOBUY, 1);
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 50);
  SetProp (P_SMOOTH, 0);
  Set (P_SMOOTH, PROTECTED, F_MODE_AS);
  SetProp (P_MATERIAL, MAT_PAPER);
  SetProp (P_INFO,
    "Du kannst beim besten Willen nichts Besonderes an der Zeichnung\n"
    "erkennen, ausser dass sie wohl lediglich ideellen Wert hat.\n");
  AddId ( ({ "zeichnung", ZEICHNUNG_ID }) );
  AddCmd ("glaette", "glaette");
}

glaette(string str)
{
  string s1, s2;
  object ob;
  if (QueryProp(P_SMOOTH))
    return notify_fail ("Die Zeichnung ist doch bereits geglaettet!\n"), 0;
  notify_fail ("WAS willst Du WOMIT glaetten?\n");
  if (!str) return 0;
  if (sscanf(str, "%s mit %s", s1, s2) != 2) return 0;
  if (!id(s1)) return 0;
  if (!(ob=present(s2,TP)))
    return
      notify_fail (capitalize(s2)+"?? Sowas hast Du doch gar nicht!\n"), 0;
  if (!ob->QueryProp(P_WEAPON_TYPE))
    return
      notify_fail (capitalize(ob->name(WER))+" eignet sich dazu nicht.\n"), 0;
  if (ob->QueryProp(P_WIELDED) != TP)
    return
      notify_fail ("Du solltest "+ob->name(WEN)+" erstmal zuecken!\n"), 0;
  if (ob->id("buegeleisen"))
  {
    SetProp (P_SMOOTH, 1);
    write ("Du glaettest die Zeichnung sorgfaeltig mit "+ob->name(WEM)+".\n");
    SetProp (P_LONG, MYLONG);
  }
  else
  {
    if (member(({WT_SWORD,WT_AXE,WT_KNIFE}),ob->QueryProp(P_WEAPON_TYPE))!=-1)
    {
      write (bs("Bei dem Versuch, die Zeichnung mit "+ob->name(WEM)+
        " zu glaetten, zerschneidest Du sie unabsichtlich in lauter "
        "kleine Teilchen, die zu Boden fallen und von einem ploetzlichen "
        "Windstoss verweht werden."));
      remove();
    }
    else
      return
        notify_fail (capitalize(ob->name(WER))+" eignet sich dazu nicht.\n"),0;
  }
  return 1;
}

int _set_smooth(int i)	// prevent tampering with P_SMOOTH
{
  if (previous_object(1)!=ME) return -1;
  else return Set(P_SMOOTH, i);
}

