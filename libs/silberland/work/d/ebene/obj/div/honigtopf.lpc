/*
** Ein Topf mit Honig
** ---
** ursprgl. von Dante
** 2000-11-20  Woody  Release
*/

inherit "std/food";

#include <properties.h>
#include <language.h>
#include <food.h>
#include <defines.h>
#include <moredef.h>

// #include "/players/dante/myowndefine.h"


void create()
{
  int h;

  if (!is_clone(ME)) return;

  ::create();
  AddId( ({ "topf","honigtopf", "honig", "\nhonigtopf" }) );
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Honigtopf");
  SetProp(P_NAME_ADJ, "klein");

  SetProp(P_SHORT, "Ein Topf mit leckerem, suessen Honig");
  SetProp(P_LONG,
    "Du siehst hier einen kleinen Topf, der bis oben hin mit "
    "herrlichem Honig gefuellt ist. Wem er gehoert und wer den Honig "
    "gesammelt hat, weisst Du nicht. Nun gehoert der Topf aber Dir! "
    "An seiner Unterseite siehst Du eine kleine Punze.");

  SetProp(P_MATERIAL, ([ MAT_MISC_FOOD:80, MAT_CERAMIC:20 ]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 75);
  SetProp(P_SMELL, "Hmm! Der Honig duftet einfach koestlich!\n");
  SetProp(P_NOBUY, 1);
  SetProp(P_INFO, BS(
    "Du solltest diesen Topf mit Honig vielleicht einem kleinen Babybaeren "
    "geben. Vielleicht belohnt Dich der Baer ja dafuer..."));

  h=5+random(6);
  SetProp(P_FOOD_INFO,
      ([
        F_HEAL : h,     // Schwache Heilung. Ist ja auch nicht dafuer gedacht.
        F_SOAK : h*2,   // Honig ist aeusserst saettigend.
        F_MSG  : "Du schlemmst genuesslich den Topf mit Honig leer.\n",
        F_MSG_ROOM : "schlemmt genuesslich einen Topf mit Honig leer.\n"
      ]) );

  AddDetail("honig",
    "Hmm, der Honig sieht wirklich sehr lecker aus.");
  AddDetail("unterseite",
    "Sieh Dir die Punze an.");
  AddDetail("unterseite",
    "Sieh Dir die Punze doch mal an!");
  AddDetail("punze",
    "Das ist ein eingestanztes Zeichen. Du kannst es lesen.");
  AddDetail("zeichen",
    "Meinst Du jetzt die Punze? Du kannst sie lesen.");
  AddReadDetail( ({"punze","zeichen"}),
    "Du liest: Dantinische Dschungel-Honigwerke.\n"
    "Du denkst   . o O ( Na hoffentlich ist der geniessbar! )\n");
}


void Eating(object pl)
{
  object bb;

  // Babybaer soll mitkriegen, wenn jmd. anderer Honig isst :)
  if (pl && bb=present("babybaer",ENV(pl)))
    bb->NotifyEating(pl);
}

