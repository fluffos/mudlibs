inherit "/std/lightsource";

#include <properties.h>
#include <lightsource.h>
#include <language.h>

create() {
  lightsource::create();
  AddId( ({"wachsfackel", "fackel"}) );
  SetProp(P_NAME,"Wachsfackel");
  SetProp(P_VALUE,10);
  SetProp(P_WEIGHT,1200);
  SetProp(P_GENDER,FEMALE);
  SetProp(P_SHORT,"Eine Wachsfackel");
  SetProp(P_LONG,"Eine ganz normale Fackel, die in Wachs getraenkt wurde. "+
    "Man kann sie\nanzuenden und wieder loeschen.\n");
  SetProp(P_ARTICLE,1);
  SetProp(P_FUEL,2500);
  SetProp(P_LIGHTDESC,
	  ({"glimmend","flackernd","leicht flackernd","brennend",
            "hell lodernd","frisch angezuendet"}));
  SetProp(P_MATERIAL, ([MAT_WOOD:50,MAT_WAX:50]) );
}
