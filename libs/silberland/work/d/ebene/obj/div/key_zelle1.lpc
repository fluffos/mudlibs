/*
** Ein Schluessel zu einer Gefaengniszelle
** ---
** 1996-06-23  Woody@SL  Release
*/

inherit "std/thing";

#include <properties.h>
#include "../../Midas/midas.h"

#define TIMETOLIVE 2  // bleibt 2 resets erhalten

int r;

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Schluessel");
  SetProp (P_LONG, "Ein alter Schluessel aus rostigem Eisen.\n");
  SetProp (P_NAME, "Schluessel");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 50);
  SetProp (P_WEIGHT, 50);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_IRON);
  AddId ("schluessel");
  AddId ("\nkey_zelle1");
  r=0;
}

string QueryDoorKey()
{
  return KANAL "kanal2_f7"
         ":"
         KANAL "kanal2_f8";
}

reset()
{
  object env;
  int i;
  ::reset();
  i=0;
  env=ME;
  while (env=environment(env))
    if (interactive(env)) { i=1; break; }
  if (!i) return;
  r++;
  if (r>=TIMETOLIVE)
  {
    tell_object (env,
      "Hoppla... Dein Schluessel zerfaellt in seine Bestandteile!\n");
    call_out("remove", 0);
  }
}

