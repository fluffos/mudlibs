/*
** Ein Schokoriegel
** 2005-04-25, Woody@SL - Initial Revision
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../../ebene.h"

#define MAX_PART 8
int part = 1;
int partstr = ([ 1 : "", 2 : "halbe", 4 : "viertel", 8 : "achtel" ]);

void create()
{
  if (!is_clone(ME)) return;
  ::create();

  AddId("schokoriegel");
  SetProp(P_NAME, "Schokoriegel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, "Ein leckerer Schokoriegel");
  SetProp(P_LONG,
      "Ein leckerer Vollmilch-Schokoriegel mit Milchfuellung und "
      "kleinen, leckeren Knusperstueckchen drin. Du solltest ihn "
      "schnell essen, bevor er schmilzt! Du kannst ihn aber auch mit "
      "jemandem teilen.");

  SetProp(P_VALUE, 30);
  SetProp(P_WEIGHT, 100);
  SetProp(P_NOBUY, 1);

  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_INFO, bs("Du kannst den Schokoriegel entweder einfach nur "
        "direkt in zwei Teilen oder aber mit jemandem, der neben Dir "
        "steht teilen."));

  SetProp(P_FOOD_INFO, ([
      F_MSG:"Du isst den leckeren Schokoriegel auf einmal auf, die zart "
            "schmelzende Schokolade und die knusprige Milchfuellung sind "
            "ein einzigartiger Genuss.",
      F_MSG_ROOM:"isst einen leckeren Schokoriegel genussvoll auf.",
      F_HEAL:15+random(10),
      F_SOAK:5,
      F_ALCOHOL:0,
      F_POISON:0 ]));

  AddCmd( ({ "teil", "teile" }), "cmd_teile" );
  seteuid(getuid());
}

void Eating(object pl)
{
  write("Du futterst genuesslich eine Karotte auf.\n");
  say(TPN+" verspeist genuesslich eine Karotte.\n");
  return ::BeimEssen();
}

varargs object teilen(object mitwem)
{
  object ob;

  if (QueryPart() > MAX_PART) {
    write("Der Schokoriegel ist zu klein, um ihn noch weiter zu teilen.\n");
    return 0;
  }
  ob = clone_object(explode(file_name(this_object()), "#")[0]);
  SetPart(QueryPart() * 2);
  ob->SetPart(QueryPart());
  if (ob->move(mitwem,M_GET) != 1) {
    ob->move(environment(mitwem), M_PUT);
    if (mitwem != TP)
      tell_object(mitwem,
          "Der Schokoriegel ist Dir zu schwer, Du legst ihn ab.\n");
  }
  return ob;
}

int cmd_teile(string str)
{
  string was, mitwem;

  notify_fail("Was willst Du (mit wem) teilen?\n");
  if (!str) return 0;

  if (id(str))          // teile schokolade
  {
    if (QueryPart() > MAX_PART) {
      write("Der Schokoriegel ist zu klein, um ihn noch weiter zu teilen.\n");
      return 1;
    }

    write("Du teilst die Schok");
  }
  else if (sscanf(str, "%s mit %s", was, mitwem))
  {
    if (!id(was))
      return 0;

    if (!mitwem = present(mitwem,environment(TP))) {
      write(capitalize(mitwem) + " steht nicht neben Dir.\n");
      return 1;
    }
    if (!interactive(mitwem)) {
      write("Du kannst den Schokoriegel nur mit einem anwesenden Mitspieler teilen.\n");
      return 1;
    }
  }
}

int QueryPart()
{
  return part;
}

int SetPart(int p)
{
  return (part = p);
}
