inherit "/std/lightsource";

#include <properties.h>
#include <lightsource.h>
#include <language.h>

create() {
  lightsource::create();
  AddId( ({"teerfackel", "fackel"}) );
  SetProp(P_NAME,"Teerfackel");
  SetProp(P_VALUE,15);
  SetProp(P_WEIGHT,1800);
  SetProp(P_GENDER,FEMALE);
  SetProp(P_SHORT,"Eine Teerfackel");
  SetProp(P_LONG,"Eine ganz normale Fackel, die in Teer getraenkt wurde. "+
    "Man kann sie\nanzuenden und wieder loeschen.\n");
  SetProp(P_ARTICLE,1);
  SetProp(P_FUEL,3000);
  SetProp(P_LIGHTDESC,
	  ({"glimmend","flackernd","leicht flackernd","brennend",
            "hell lodernd","frisch angezuendet"}));
  SetProp(P_MATERIAL, ([MAT_WOOD:60,MAT_TAR:40]) );
}
