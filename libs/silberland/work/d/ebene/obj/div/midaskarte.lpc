    "room_h7":9;7,
    "room_h6":9;6,
    "room_h5":9;5,
    "room_h4":9;4,
    "room_h3":9;3,
    "room_h2":9;2,
    "room_g1":8;1,
    "room_f1":7;1,
    "room_e1":6;1,
    "room_d1":5;1,
    "room_c1":4;1,
    "room_b1":3;1,
    "room_a2":2;2,
    "room_a3":2;3,
    "room_a4":2;4,
    "room_b5":3;5,
