inherit "std/thing";

#include <properties.h>
#include <defines.h>
#include <moredef.h>

create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp (P_SHORT, "Etwas Lab");

  SetProp (P_LONG,
    "Diese Tablette enthaelt Lab, welches dazu dient, aus Milch Kaese "
    "zu machen. Da Du diese Kunst nicht beherrscht, ist das Lab so gesehen "
    "fuer Dich wertlos. Fuer einen Kaesemeister ist Lab jedenfalls absolut "
    "notwendig. Und dieses Lab ist ein ganz natuerliches Produkt, daraus "
    "kann ein versierter Kaesemeister bestimmt ganz besonders koestlichen "
    "Kaese herstellen. "
  );

  SetProp(P_NAME, "Lab");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_VALUE, 50);
  SetProp(P_WEIGHT, 10);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, MAT_MISC);

  AddId (({"lab","tablette","\nKAESELADENLAB"}));
}
