/*
** Eine Schneekugel mit dem Gaffodorf :-)
*/

inherit "std/thing";

#include <properties.h>
#include "../../ebene.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();

  AddId( ({ "schneekugel", "kugel", "gaffodorfkugel" }) );
  SetProp(P_SHORT, "Eine Schneekugel");
  SetProp(P_LONG,
      "Du haeltst eine kleine Schneekugel in Deinen zittrigen Haenden. "
      "Als Du sie naeher ansiehst, werden Deine Augen ganz feucht vor "
      "Ruehrung - da hat doch tatsaechlich jemand ein ganzes kleines "
      "Dorf mit sehr viel Liebe zum Detail geschnitzt, Du erkennst "
      "sogar die einzelnen Kieselsteine auf den Wegen, die sich zwischen "
      "den Huetten durchs Dorf schlaengeln, zumindest an den Stellen, "
      "wo gerade kein Schnee liegt.");

  AddDetail( ({ "schnee", }),
      "Der Schnee in der Glaskugel ist bestimmt nicht echt. Und wenn "
      "doch, dann ist es wohl magischer Schnee, denn er schmilzt nie.");
  AddDetail( ({ "magischer schnee", "magischen schnee", }),
      "Durchaus moeglich, er glitzert auch so seltsam.");
  AddDetail( ({ "glitzern", }),
      "Das Glitzern jagt ein Laecheln auf Dein Gesicht.");
  AddDetail( ({ "dorf", }),
      "Du hast das Dorf noch nie gesehen, aber zum Glueck ist da ein "
      "kleines Schild am Sockel der Kugel angebracht.");
  AddDetail( ({ "sockel", }),
      "Der Sockel der Schneekugel ist aus Holz geschnitzt. Ein kleines "
      "Schild ist an ihm angebracht.");
  AddDetail( ({ "holz", }),
      "Gewoehnliches Holz, offenbar von einer Buche.");
  AddDetail( ({ "schild", "plaettchen" }),
      "Es ist viel mehr ein duennes Plaettchen aus Messing. Du kannst "
      "es lesen (wenn Du lesen kannst).");
  AddDetail( ({ "messing", }),
      "Gewoehnliches Messing, wohl aus Felonia importiert.");
  AddReadDetail( ({ "schild", "plaettchen" }),
      "Auf dem Schild steht:  <<< Gaffodorf >>>");
  AddDetail( ({ "gaffodorf", }),
      "Aaaaaah, so sieht also das sagenumwobene Gaffodorf aus!");
  AddDetail( ({ "kieselsteine", "steine", "kiesel", }),
      "Die Kieselsteine sehen sehr originalgetreu aus, und da die "
      "Kugel sehr klein ist, musst Du Deine Augen schon sehr "
      "zusammenkneifen, um sie ueberhaupt zu erkennen.");
  AddDetail( ({ "weg", "wege", }),
      "Die Wege sind teilweise ziemlich verschlungen. Du denkst, dass "
      "die Kugel sicher auch gut als Ersatz fuer eine Landkarte "
      "herhalten koennte.");
  AddDetail( ({ "huette", "huetten", }),
      "Sie wurden liebevoll gestaltet mit allen Details, die so eine Huette "
      "halt hat, wei Fenster, Tueren, Dach, Rauchfang, und so weiter.");
  AddDetail( ({ "fenster", "tuere", "tueren", "dach", "rauchfang", }),
      "Du staunst ueber die feinen, sorgfaeltig geschnitzten Details.");
  AddDetail( ({ "details", }),
      "Keines entgeht Deiner Aufmerksamkeit.");
  AddDetail( ({ "stelle", "stellen", }),
      "Der Schnee bedeckt sehr viel vom Dorf, aber nicht alles.");
  AddDetail( ({ "glas", "glaskugel", }),
      "Das Dorf von einer Glaskugel umgeben, die mit einer seltsamen, "
      "durchsichtigen Fluessigkeit gefuellt ist.");
  AddDetail( ({ "fluessigkeit", }),
      "Sie ist wohl dazu da, den Schnee langsam herunterrieseln zu lassen, "
      "wenn man die Kugel schuettelt.");
  //AddDetail( ({ "", }),
  //    "");

  SetProp(P_NAME, "Schneekugel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 200);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL,
      ([ MAT_GLASS:20, MAT_MISC_WOOD:20, MAT_MISC_FLUID:60 ]) );

  AddCmd( ({ "schuettle", "schuettel" }), "schuettel" );
  AddCmd( ({ "huepf", "huepfe", "hops", "hopse", "hoppel", "hoppele" }),
      "huepfe" );
}

int schuettel(string str)
{
  if (find_call_out("riesel") >= 0)
    return write("Aber das hast Du doch gerade eben gemacht!\n"), 1;

  write("Du schuettelst die Schneekugel und wirbelst den Schnee darin auf.\n");
  say(TP->Name()+" schuettelt eine Schneekugel.\n");
  call_out("riesel", 6, this_player(), 1);
  return 1;
}

void riesel(object pl, int i)
{
  if (!objectp(pl)) return;
  if ( ( environment() != pl ) &&
       ( environment() != environment(pl) ) ) return;
  if (i)
  {
    tell_object(pl, 
      "Der Schnee sinkt langsam auf das Dorf hernieder. Irgendwie sieht\n"
      "das zwar furchtbar kitschig aus, aber irgendwie auch wunderschoen.\n");
    call_out("riesel", 6, pl);
    return;
  }
  tell_object(pl,
    "Der Schnee legt sich auf den Daechern und am Boden des Dorfes nieder.\n"
    "Du freust Dich wie ein kleines Baby.\n");
  tell_room(environment(pl),
    pl->Name() + " freut sich wie ein kleines Baby.\n", ({ pl }) );
}

int huepfe(string str)
{
  if ((environment() == this_player()) && (find_call_out("riesel") == -1))
    call_out("huepfe2", 0, this_player());
  return 0;
}

int huepfe2(object pl)
{
  if (pl && (environment() == pl))
  {
    tell_object(pl,
      "Der Schnee in der Schneekugel wird durch Dein Huepfen aufgewirbelt.\n");
    call_out("riesel", 6, pl, 1);
  }
}

string _query_long()
{
  return Query(P_LONG) +
    (find_call_out("riesel") >= 0 ?
       "Der Schnee in der Kugel sinkt gerade langsam aufs Dorf herab.\n" :
       "");
}
