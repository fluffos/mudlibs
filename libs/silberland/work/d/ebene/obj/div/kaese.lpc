//#include MIDAS("midas.h")

inherit "std/food";

#include <food.h>
#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

int lifetime;

#define MAX_LIFETIME 15;

create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Kaese");
  SetProp(P_LONG,
    "Dieses Stueck Kaese hat Albin, der Kaesemeister aus Midas hergestellt. "
    "Wie das schon duftet! Am liebsten wuerdest Du dieses Stueck Kaese gleich "
    "ganz aufessen. "
  );

  SetProp(P_INFO,
    BS("Dieser Kaese gibt verbrauchte Energie sofort zurueck, macht aber "
       "bestimmt auch ganz schoen satt.")
  );

  SetProp(P_NAME, ({ "Kaese", "Kaeses", "Kaese", "Kaese" }) );
  SetProp(P_GENDER, MALE);
  AddId( ({"kaese", "\nKAESELADENKAESE"}) );

  SetProp(P_MATERIAL, ([MAT_MISC_FOOD:100]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 800);
  SetProp(P_NOBUY, 1);
  SetProp(P_SMELL, "Der Kaese riecht einfach herrlich, so richtig wuerzig!\n");

  SetProp(P_FOOD_INFO,
    ([ F_HEAL     : ({ 60, 30 }),
       F_SOAK     : 20,
       F_POISON   : 0,
       F_MSG      : "Du isst das Stueck Kaese. Hmmmm, war das herrlich.",
       F_MSG_ROOM : "isst ein Stueck Kaese und verdreht die Augen vor Entzueckung."
     ])
  );

  lifetime = MAX_LIFETIME;
}

void reset()
{
  object env;

  ::reset();

  if(!(env=ENV(TO))) return;

  lifetime--;

  if(lifetime == 1)
  {
    if(living(env))
    {
      tell_object(env,"Dein Kaese faengt an zu verschimmeln.\n");
    }
    else
    {
      tell_room(env,"Der Kaese faengt an zu verschimmeln.\n");
    }

    SetProp(P_FOOD_INFO,
      ([ F_HEAL     : ({ 30, 10 }),
         F_SOAK     : 10,
         F_POISON   : 0,
         F_MSG      : "Du isst das Stueck Kaese. War aber schon etwas verschimmelt.",
         F_MSG_ROOM : "isst ein Stueck Kaese und verzieht etwas das Gesicht."
       ])
    );

    SetProp(P_LONG,
      "Dieses Stueck Kaese hat Albin, der Kaesemeister aus Midas hergestellt. "
      "Das riecht schon etwas merkwuerdig, denn der Kaese faengt schon an "
      "zu verschimmeln. Jetzt iss ihn bald auf, bevor er ganz verschimmelt "
      "ist. "
    );

    SetProp(P_INFO,
      BS("Dieser Kaese gibt verbrauchte Energie sofort zurueck, macht aber "
         "bestimmt auch ganz schoen satt. Leicht am verschimmeln ist er auch"
         "schon.")
    );

    SetProp(P_SMELL, "Der Kaese riecht schon etwas verschimmelt!\n");

    return;
  }

  if(lifetime <= 0)
  {
    if(living(env))
    {
      tell_object(env,BS("Dein Kaese ist nun voellig verschimmelt und Du "
                         "wirfst ihn weg."));
    }
    else
    {
      tell_room(env,"Der Kaese ist nun restlos verschimmelt.\n");
    }

    call_out("remove",0);
  }

  return;
}

void Customize(int ktyp)
{
  switch(ktyp)
  {
    case 1 : // kaese aus Kuhmilch
      break;

    case 2 : // kaese aus schafsmilch
      SetProp(P_SHORT, "Ein Schafskaese");
      SetProp(P_LONG,
        "Dieses Stueck Schafskaese hat Albin, der Kaesemeister aus Midas "
        "hergestellt. Schafskaese ist geruchslos, doch schon beim Anblick "
        "laeuft Dir das Wasser im Mund zusammen. Am liebsten wuerdest Du dieses "
        "Stueck Kaese gleich ganz aufessen. "
      );
      AddId( ({"schafkaese", "schafskaese"}) );
      SetProp(P_SMELL, "Der Schafskaese ist so gut wie geruchslos.\n");

      break;

    case 3 : // kaese aus ziegenmilch
      SetProp(P_SHORT, "Ein Ziegenkaese");
      SetProp(P_LONG,
        "Dieses Stueck Ziegenkaese hat Albin, der Kaesemeister aus Midas "
        "hergestellt. Der riecht aber ganz schoen streng! Trotzdem wuerdest "
        "Du dieses Stueck Kaese am liebsten gleich ganz aufessen. "
      );
      AddId( ({"ziegenkaese"}) );
      SetProp(P_SMELL, "Der Ziegenkaese riecht ganz schoen streng.\n");

      break;
  }
}

void BeimEssen(object pl)
{
//  WRITELOG(UID(pl)+" isst das Stueck Kaese");
  return;
}

