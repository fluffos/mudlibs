/*
** Ein Riesenrattenzahn
** 1997-10-15  Woody
*/

inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"zahn", "rattenzahn", "riesenrattenzahn"}));
  SetProp (P_SHORT, "Ein Riesenrattenzahn");
  SetProp (P_LONG, "Der Riesenrattenzahn ist etwa 10 mal 15 Zentimeter "
      "gross und besitzt eine seltsame, rechteckige Form. Was Du wohl "
      "damit machen kannst...? Als Waffe scheint er Dir relativ ungeeignet.");
  SetProp (P_NAME, "Riesenrattenzahn");
  SetProp (P_GENDER, MALE);

  SetProp (P_VALUE, 200);
  SetProp (P_WEIGHT, 100);
  SetProp (P_MATERIAL, MAT_HORN);
}
