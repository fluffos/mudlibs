inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include <moving.h>
#include <verben.h>

create()
{
  if (!is_clone(TO))return;

  ::create();

  SetProp(P_SHORT, "Ein Melkschemel");
  SetProp(P_LONG,
    "Ein kleiner Melkschemel, auf dem man sitzt, waehrend man zum Beispiel "
    "Kuehe melkt. Es ist nichts anderes als eine runde Scheibe mit einem "
    "einzigen \"Stuhlbein\"."
  );

  SetProp(P_NAME, "Melkschemel");
  SetProp(P_GENDER, MALE);
  AddId( ({"schemel","melkschemel"}) );

  SetProp(P_MATERIAL, ([MAT_WOOD:100]) );
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 1);

  AddSpecialDetail( ({"schemel","melkschemel"})  , "_query_long");
  AddSpecialDetail( ({"kuh","kuehe"})            , "detail_kuehe");
  AddSpecialDetail( ({"schaf","schafe"})         , "detail_schafe");
  AddSpecialDetail( ({"ziege","bergziege",
                      "ziegen","bergziegen"})    , "detail_ziegen");

  AddDetail( ({"beispiel"}) ,
    "Man koennte auch Schafe oder Ziegen melken."
  );

  AddDetail( ({"scheibe","baumscheibe"}) ,
    "Eine einfache Baumscheibe, lediglich etwas abgeschmirgelt. Da sitzt es "
    "sich doch sicherlich recht unbequem drauf. "
  );

  AddDetail( ({"bein","stuhlbein"}) ,
    "Ein Melkschemel hat nur ein einziges \"Stuhlbein\"."
  );

  AddCmd( CMD_SETZEN      , "cmd_setzen");

}

int check_if_living(object ob)
{
  if(interactive(ob) && (ob->QueryProp(P_INVIS))) return 0;
  if(interactive(ob)) return 1;
  return 0;
}

int cmd_setzen(string str)
{
  object *players;
  int i;

  notify_fail("Auf was moechtest Du Dich setzen?\n");

  if(!str || str == "") return 0;
  if(!(str == "schemel"         ||
       str == "auf schemel"     ||
       str == "melkschemel"     ||
       str == "auf melkschemel" )) return 0;

  tell_object(TP,
    BS("Du setzt Dich auf den Melkschemel, aber das ist ja eine "
       "ziemlich wackelige Angelegenheit. Du versuchst angestrengt "
       "die Balance zu halten, kippst letztlich aber doch um. "
       "Hoffentlich hat das niemand gesehen. Das waere reichlich "
       "blamabel."
      )
  );

  tell_room(ENV(TP),
    BS(CAP(TPN)+" setzt sich auf einen Melkschemel und versucht "
       "krampfhaft, die Balance zu halten. Schliesslich kippt "
       +TP->QueryPronoun(WER)+" aber um."
      ),({TP})
  );

  players = filter_array(all_inventory(ENV(TP)), "check_if_living") - ({TP});

  i = sizeof(players);
  while(i--)
  {
    tell_object(TP,CAP(players[i]->Name())+" lacht Dich aus.\n");
    tell_object(players[i],"Du lachst "+TPN+" aus.\n");
    tell_room(ENV(TP),
      CAP(players[i]->Name())+" lacht "+TPN+" aus.\n",
      ({TP,players[i]})
    );
  }
  TP->command_me("denk Vielleicht gehts beim melken einfacher?");
  return 1;
}

string detail_kuehe(string str)
{
  object ob;

  string s;

  if(!(ob=present("kuh",ENV(TP))))
    s = "Es ist keine Kuh in der Naehe.";
  else
    s = ob->QueryProp(P_LONG);

  return BS(s);
}

string detail_schafe(string str)
{
  object ob;

  string s;

  if(!(ob=present("schaf",ENV(TP))))
    s = "Es ist kein Schaf in der Naehe.";
  else
    s = ob->QueryProp(P_LONG);

  return BS(s);
}

string detail_ziegen(string str)
{
  object ob;

  string s;

  if(!(ob=present("ziege",ENV(TP))))
    s = "Es ist keine Ziege in der Naehe.";
  else
    s = ob->QueryProp(P_LONG);

  return BS(s);
}

