inherit "/std/lightsource";

#include <properties.h>
#include <lightsource.h>
#include <language.h>

create() {
  lightsource::create();
  AddId( ({"harzfackel", "fackel"}) );
  SetProp(P_NAME,"Harzfackel");
  SetProp(P_VALUE,5);
  SetProp(P_WEIGHT,750);
  SetProp(P_GENDER,FEMALE);
  SetProp(P_SHORT,"Eine Harzfackel");
  SetProp(P_LONG,"Eine ganz normale Fackel, die in Harz getraenkt wurde. "+
    "Man kann sie\nanzuenden und wieder loeschen.\n");
  SetProp(P_ARTICLE,1);
  SetProp(P_FUEL,1500);
  SetProp(P_LIGHTDESC,
	  ({"glimmend","flackernd","leicht flackernd","brennend",
            "hell lodernd","frisch angezuendet"}));
  SetProp(P_MATERIAL, MAT_MISC_WOOD);
}
