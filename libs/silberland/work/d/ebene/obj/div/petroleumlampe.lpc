inherit "/std/lightsource";

#include <properties.h>
#include <language.h>
#include <sdefines.h>
#include <lightsource.h>

#define MAXFUEL 1500

create() {
  lightsource::create();
  AddId( ({"petroleumlampe", "lampe"}) );
  SetProp(P_NAME,"Petroleumlampe");
  SetProp(P_VALUE,100);
  SetProp(P_WEIGHT,1000);
  SetProp(P_GENDER,FEMALE);
  SetProp(P_SHORT,"Eine Petroleumlampe");
  SetProp(P_LONG, "Eine einfache Petroleumlampe, die man wohl nachfuellen "+
    "kann, wenn man\neine Flasche Petroleum dabei hat.\n");
  SetProp(P_ARTICLE,1);
  SetProp(P_DO_DESTRUCT,0);
  SetProp(P_FUEL,MAXFUEL);
  SetProp(P_LIGHTDESC,
      ({"glimmend","flackernd","leicht flackernd","brennend",
        "hell lodernd","frisch angezuendet"}));
  SetProp(P_MATERIAL, ([MAT_METAL:80,MAT_GLASS:20]) );
  AddCmd ( ({"fuell", "fuelle", "befuell", "befuelle"}), "fuelle" );
}

int fuelle(string str)
{
  string s1, s2;
  object ob;
  int i,j;
  notify_fail ("WAS willst Du womit befuellen?\n");
  if (!str) return 0;
  if (sscanf(str, "%s mit %s", s1, s2) != 2) return 0;
  if (!id(s1)) return 0;
  notify_fail ("Damit kannst Du "+name(WEN)+" nicht befuellen!\n");
  if (!ob=present(s2, TP)) return 0;
  notify_fail ("Mit "+ob->name(WEM)+" kannst Du "+name(WEN)+
    " nicht befuellen!\n");
  if (!ob->id("\npetroleum")) return 0;
  if (QueryProp(P_FUEL) >= MAXFUEL-50)
    write ("Die Petroleumlampe ist doch noch randvoll befuellt!\n");
  else
  {
    // Mehr Petroleum in der Flasche als man in die Lampe fuellen kann?
    if ((i=MAXFUEL-QueryProp(P_FUEL)) < (j=ob->QueryProp(P_FUEL)))
    {
      SetProp(P_FUEL, MAXFUEL);
      ob->SetProp(P_FUEL, j-i);
      write("Vorsichtig fuellst Du die Petroleumlampe randvoll mit "+
        "Petroleum.\n");
      say(TP->Name()+
          " befuellt eine Petroleumlampe vorsichtig mit Petroleum.\n");
    }
    else
    {
      // SetProp(P_FUEL, QueryProp(P_FUEL)+j);
      AddFuel(j);
      ob->remove();
      write("Vorsichtig befuellst Du die Petroleumlampe mit dem "+
        "restlichen Petroleum.\nDie Flasche entsorgt sich anschliessend "+
        "von selbst.\n");
      say(TP->Name()+" leert den restlichen Inhalt einer Petroleumflasche in"
        " eine Lampe.\nDie Flasche entsorgt sich anschliessend von selbst.\n");
    }
  }
  return 1;
}
