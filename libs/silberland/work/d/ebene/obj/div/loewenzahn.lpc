/*Loewenzahn*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "/d/ebene/ebene.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Loewenzahn");
  SetProp (P_LONG, "Etwas angeknabberter Loewenzahn. Soll gesund sein!\n");
  SetProp (P_NAME, "Loewenzahn");
  AddId(({"loewenzahn", "zahn"}));
  SetProp(P_WEIGHT, 80);
  SetProp (P_FOOD_INFO, ([F_HEAL:-5, F_SOAK:0, F_ALCOHOL:-5, F_POISON:0]));
  SetProp(P_GENDER, MALE);
}
BeimEssen()
{
  write ("IGITT! War der bitter! Du nimmst Dir vor, nie wieder dem Hasen\n" 
  +"Loewenzahn wegzuessen!\n");
  say (TPN+" kaut auf etwas ziemlich ekelhaft aussehenden Ding herum.\n");
  return ::BeimEssen();
}
