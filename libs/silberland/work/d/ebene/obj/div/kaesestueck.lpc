/*
** Ein Stueck Kaese
** ---
** 1996-06-30  Woody@SL  Release
*/

inherit "std/thing";

#include <properties.h>
#include "../../Midas/midas.h"

#define TRIGGER_ROOM (KANAL "kanal2_f7")

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Stueck Kaese");
  SetProp (P_LONG, bs("Ein kleines Stueckchen Kaese. Waerest Du eine Maus, "+
    "wuerdest Du es wahrscheinlich mit Genuss verzehren..."));
  SetProp (P_NAME,
    ({"Stueck Kaese", "Stuecks Kaese", "Stueck Kaese", "Stueck Kaese"}));
  SetProp (P_GENDER, NEUTER);
  SetProp (P_VALUE, 10);
  SetProp (P_WEIGHT, 50);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_MISC_FOOD);
  AddId (({"kaese","kaesestueck","stueck kaese","\nkaesestueck"}));
  AddCmd (({"iss","ess","esse","futter","mampf"}), "iss");
}

int iss(string str)
{
  notify_fail("WAS willst Du essen?\n");
  if (!stringp(str) || str=="") return 0;
  if (id(str)) {
    write ("Ach nein, lass mal, Du bist doch keine Maus...\n");
    return 1;
  }
  else return (notify_fail("Das kannst Du nicht essen!\n"), 0);
}

varargs int move(mixed dest,int method)
{
  int x;
  if ((x=::move(dest, method))==1)
  {
    if ((dest==TRIGGER_ROOM) || (dest==find_object(TRIGGER_ROOM)))
    {
      dest->kaese();
      remove();
      return 0;
    }
  }
  return x;
}
