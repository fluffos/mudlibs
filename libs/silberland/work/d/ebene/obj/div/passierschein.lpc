/*
** Ein Passierschein
*/

inherit "std/thing";

#include <properties.h>
#include "../../ebene.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();

  AddId( ({ "schein", "passierschein", "kanal\npassierschein" }) );
  SetProp(P_SHORT, "Ein Passierschein");
  SetProp(P_LONG, "Dieses Passierschein gewaehrt Dir Eintritt in die alte Kanalisation.\n");
  SetProp(P_NAME, "Passierschein");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, MAT_PAPER);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
}
