/*
** Ein Cookie
** ---
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "/d/ebene/ebene.h"


string *meldungen =
  ({
     "Erzmagier haben immer recht.",
     "Max die rote Nase trinkt Whisky aus der Vase.",
     "Schon lange nicht gestorben ist, wer Lars vermisst.",
     "Wer beichtet, wird erleuchtet.",
     "Nur der Poebel zieht jeden Hebel.",
     "Nur ein Schwachkopf drueckt jeden Knopf.",
     "Brauchst Du Maden? Kauf sie im Laden!",
     "Scheint Dir die Sonne auf den Bauch, freut sich der auch.",
     "Mit einem Messer in der Brust vergeht Dir jede Wanderslust.",
     "Isst Du Holunder, wirkt das oft Wunder.",
     "Liegt der Oger tot im Keller, war der Zwerg wieder schneller.",
     "Hoere die mystischen Silben: Ful Myth Zak",
     "Marillen schaerfen die Pupillen.",
     "Laenger lebt, wer kuerzer stirbt.",
     "Tiger zum Loewen, sonst fressen Dich die Moewen.",
     "Max ist doch ein Klax!",
     "Gratulation! Sie haben soeben einen Forscherpunkt gefunden!",
     "Trinkst Du viel Wasser, wird Deine Kehle nasser.",
     "Beinah haettest Du's geschafft, da hat Dich Dusty hingerafft.",
     "Die Wachen in Tijara sind nur Owezara.",
     "Elfen fuehlen sich IM Wald am wohlsten.",
     "Liebe Deinen Naechsten wie Deinen Vorigen.",
     "Huete Dich vor der Magie!",
     "Helden gibt es viele, aber gute Drachen sind rar.",
     "Feen saufen statt Essen zu kaufen.",
  });


void create()
{
  int bad;

  if (!is_clone(ME)) return;
  ::create();

  bad = !random(10);
  AddId ("cookie");
  SetProp (P_SHORT, "Ein kleiner Cookie");
  SetProp (P_LONG,
      "+--------------------------------------------------------------+\n"
      "|   .-.    Das Silberland bietet Dir einen frischen, leckeren  |\n"
      "|  ( ? )   Cookie an. Es handelt sich hierbei um ein ziemlich  |\n"
      "|   `-'    delikates Gebaeck aus Felonia.                      |\n"
      "+--------------------------------------------------------------+\n"
      "|           < Essen >                    < Wegwerfen >         |\n"
      "+--------------------------------------------------------------+\n");
  SetProp (P_NAME, ({ "Cookie", "Cookies", "Cookie", "Cookie" }) );
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 10);
  SetProp (P_WEIGHT, 80);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL,
      ({ MAT_MISC_FOOD }) );

  SetProp (P_INFO, "Der Cookie birgt magische "+
      (bad ? "Wirrungen" : "Geheimnisse")+" in sich.\n");
  SetProp (P_FOOD_INFO, ([
      F_HEAL     : ({0, bad ? -5 : 5 }),
      F_SOAK     : 5,   // macht den Cookie gaenzlich unattraktiv :)
      F_MSG      : "Du verschlingst den knusprigen Cookie und seufzst selig.",
      F_MSG_ROOM : "verzehrt genuesslich einen leckeren Cookie. Du bist Dir "
                   "allerdings nicht sicher, ob Du auch so einen Cookie "
                   "haben willst oder nicht..." ]) );
}

void BeimEssen()
{
  if (!TP) return;
  if (TP->QueryProp(P_BLIND))
    write("Du atmest ploetzlich etwas Rauch ein, "
        "kannst aber leider nichts sehen...\n");
  else {
    write("Vor Deinem Auge erscheint ploetzlich ein Schriftzug aus Rauch.\n");
    write("Du liest: "+meldungen[random(sizeof(meldungen))]+"\n");
  }
  if (!query_once_interactive(TP)) TP->AddHp(5);    // Fraggle heilt sich :)
  return;
}

