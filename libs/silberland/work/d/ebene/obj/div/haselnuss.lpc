inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "/players/woody/files.h"

void create()
{
  string str;

  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();

  AddId( ({ "haselnuss", "nuss" }) );
  SetProp(P_SHORT, "Eine Haselnuss");
  SetProp(P_LONG,
      "Eine kleine Haselnuss. Bestimmt ist sie sehr nahrhaft, allerdings "
      "auch aeusserst fettreich, also iss nicht zuviele davon!");
  SetProp(P_NAME, "Haselnuss");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE,15);
  SetProp(P_INFO, "Um Nuesse zu essen, muss man Nuesse knacken.\n");
  SetProp(P_NOBUY, 1);

  AddCmd(({"iss", "esse"}), "iss_nuss");
  AddCmd(({"knack", "knacke","spalte"}), "knack");
}

int iss_nuss(string what)
{
  notify_fail("Was moechtest Du essen?\n");

  if (!stringp(what) || !id(what))
    return 0;

  if (TP->eat_food(2,1))
  {
    write("Du isst, diese knackend, die Haselnuss.\n");
    say(BS(TP->Name(WER) + " knackt eine Haselnuss und isst sie."));
    TP->heal_self(10);
    ME->remove();
  }
  else
  {
    write("Dazu bist Du im Moment einfach zu satt.\n");
  }
  return 1;
}

int knack(string what)
{
  if (!stringp(what) || !id(what))
    return 0;

  // Fall 1: ZT
  if (TP->FindPotion(BS("Du knackst die Nuss. "
          "Ploetzlich ueberkommt Dich ein seltsames Gefuehl.")))
  {
    say(BS("Du siehst, wie " + TP->name(WER) + " eine Nuss knackt, "
          "isst und gluecklich laechelt."));
    ME->remove();
  }
  // Fall 2: Spieler noch nicht satt
  else if (TP->eat_food(2,1))
  {
    write("Du knackst die Nuss. "
        "Gierig verschlingst Du das koestliche Innenleben.\n");
    say(BS(TP->Name(WER) + " knackt eine Haselnuss und isst sie."));
    TP->heal_self(10);
    ME->remove();
  }
  // Fall 3: Spieler zu voll
  else
  {
    write("Dazu bist Du im Moment einfach zu satt.\n");
  }

  return 1;
}
