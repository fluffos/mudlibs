/*
** Ein Teddyautomat
** ---
** 1996-06-10  Woody@SL  Release
** 1997-04-01  Woody@SL  'erneuern'
*/

inherit "std/thing";

#define TEDDY "/obj/teddy"

#include <properties.h>
#include "../../ebene.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  AddId (({"automat","teddyautomat"}));
  SetProp (P_SHORT, "Ein seltsamer Automat");
  SetProp (P_LONG, "Dieser seltsame Automat erregt Deine Neugier. Du "
    "kannst einen Hebel, jede Menge Laempchen und eine unscheinbare "
    "Oeffnung erkennen. Ausserdem kannst Du einen am Automaten "
    "befestigten Wisch sehen.");
  AddDetail ("hebel", "Du koenntest ihn ziehen.\n");
  AddDetail ("laempchen", "Sie sind in allen moeglichen Farben quer ueber "+
    "den Automat verteilt.\n");
  AddDetail ("oeffnung", "Eine kleine unscheinbare Oeffnung. Du hast keine "+
    "Ahnung, was sie bedeuten koennte.\n");
  AddDetail ("wisch", "Du koenntest ihn ja vielleicht mal lesen...\n");
  AddReadDetail ("wisch",
      "Auf dem Wisch steht gekrixelt:\n\n"
      "   Dieser Automat kann jetzt auch als besonderes Service Ihren alten\n"
      "  Teddy runderneuern. Die Syntax dafuer lautet: 'erneuere teddy'\n\n"
      "Viel Spass wuenschen Ihnen\n"
      "Die SilberLand Plueschtierhersteller\n");

  SetProp (P_NAME, "Automat");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 10000);
  SetProp (P_NOGET, 1);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_MISC_METAL);
  AddCmd (({"ziehe","zieh"}), "zieh");
  AddCmd (({"erneuer","erneuere"}), "erneuer");
}

erneuer(string str)
{
  object ob;
  notify_fail("WAS willst Du erneuern lassen?\n");
  if (!str) return 0;
  notify_fail("Das kannst Du hier nicht erneuern lassen!\n");
  if (str!="teddy") return 0;
  if (!ob=present("\nuniversalteddy",TP))
    return notify_fail("Aber Du hast ja gar keinen Teddy zum Erneuern!\n"),0;
  ob->remove();
  CLONE(TEDDY, TP);
  write(bs(
      "Du legst Deinen Teddy vorsichtig in die Oeffnung und drueckst an den "
      "Knoepfen herum, von denen Du nicht weisst, was sie bedeuten... Aber "
      "der eine gruene Knopf mit den seltsam dreieckfoermig angeordneten "
      "Pfeilen wirkt relativ vertrauenserweckend... Du drueckst drauf...")+
      bs("Und tatsaechlich! Der Automat gibt ein paar seltsame Geraeusche "
      "von sich, und auf einmal fliegt Dir Dein Teddy wieder in die Arme, "
      "sauberer und kuscheliger als je zuvor. Zumindest bildest Du Dir "
      "das ein..."));
  say("Der Automat erneuert "+TP->name(WESSEN)+" Teddy.\n");
  return 1;
}

zieh(string str)
{
  notify_fail ("WAS willst Du ziehen?\n");
  if (!str) return 0;
  if (!stringp(str)) return 0;
  if ((str != "hebel") && (str != "an hebel")) return 0;
  write ("Du ziehst an einem Hebel.\n");
  say (TPN+" zieht an einem Hebel.\n");
  call_out ("zieh2", 3);
  return 1;
}

zieh2()
{
  if (MENV != ENV(TP) || present("\nuniversalteddy", TP))
  {
    tell_room (MENV,
      "Ein paar Laempchen leuchten auf, aber sonst passiert nichts.\n");
  }
  else
  {
    CLONE(TEDDY, TP);
    write ("Ein paar Laempchen leuchten auf und der Automat piepst seltsam.\n"+
      "Ploetzlich wird ein kleiner suesser Teddy aus einer Oeffnung geschleudert.\n"+
      "Du hebst ihn sofort auf und nimmst ihn an Dich.\n");
    say ("Einige Laempchen leuchten auf und der Automat piepst seltsam.\n"+
      "Ploetzlich wird ein kleiner suesser Teddy herausgeschleudert, den "+TPN+
      "\nsofort an sich nimmt.\n");
  }
}
