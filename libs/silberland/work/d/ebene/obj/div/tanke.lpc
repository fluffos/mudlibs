inherit "std/food";

#include <properties.h>
#include <food.h>
#include "/d/ebene/ebene.h"

mixed tanke =
  ({ ({ "argankraut",  NEUTER, ([ F_HEAL:25, F_SOAK:3, F_ALCOHOL:0 ]) }),
     ({ "ektonwurzel", FEMALE, ([ F_HEAL:({5,25}), F_SOAK:2, F_ALCOHOL:1 ]) }),
     ({ "bretanngras", NEUTER, ([ F_HEAL:({10,20}), F_SOAK:2, F_ALCOHOL:0]) }),
     ({ "giftkraut",   NEUTER, ([ F_HEAL:-10, F_SOAK:0, F_ALCOHOL:0, F_POISON:1 ]) }),
     ({ "migelblatt",  NEUTER, ([ F_HEAL:20, F_SOAK:2, F_ALCOHOL:0 ]) }),
     ({ "vitalanie",   FEMALE, ([ F_HEAL:({80,20}), F_SOAK:5, F_ALCOHOL:0 ]) }),
     ({ "vierblatt",   NEUTER, ([ F_HEAL:({0,60}), F_SOAK:5, F_ALCOHOL:0 ]) }),
     ({ "egalwurzel",  FEMALE, ([ F_HEAL:0, F_SOAK:0, F_ALCOHOL:0 ]) }),
     ({ "joruga",      FEMALE, ([ F_HEAL:35, F_SOAK:4, F_ALCOHOL:0 ]) }),
     ({ "bacanakraut", NEUTER, ([ F_HEAL:150, F_SOAK:5, F_ALCOHOL:0, F_POISON:1 ]) }),
     ({ "nepara",      FEMALE, ([ F_HEAL:({60,40}), F_SOAK:1, F_ALCOHOL:4 ]) }),
  });

/*
   arganwurzel, atanax, atmon, basilamine, belmart, carlog, donf, finage,
   gulmond, hiradwurz, hoellenkraut, joruga, lotos, lulanie, menchal,
   mibelrohr, vragieswurzel, vierblatt, xordai
*/

create()
{
  int x;
  string s;

  if (!is_clone(ME)) return;
  ::create();

  x=random(sizeof(tanke));
  AddId("\ntanke");
  AddId(s=tanke[x][0]);
  if (s[<5..]=="kraut") AddId("kraut");
  if (s[<5..]=="blatt") AddId("blatt");
  if (s[<4..]=="gras") AddId("gras");
  if (s[<6..]=="wurzel") AddId("wurzel");

  SetProp (P_NAME, capitalize(tanke[x][0]));
  SetProp (P_GENDER, tanke[x][1]);
  SetProp (P_FOOD_INFO, tanke[x][2]);
  SetProp (P_SHORT, ME->Name(WER,0));
  SetProp (P_LONG, ME->Name(WER,0)+" ist nichts anderes als "+
      ME->name(WER,0)+".");
  SetProp(P_NOGET, "Eine starke Macht hindert Dich daran, "+
      ME->name(WEN,1)+" zu nehmen.\n");
  SetProp (P_MATERIAL, MAT_MISC_PLANT);
  AddCmd ( ({"pflueck","pfluecke"}), "pfluecke" );
}

BeimEssen()
{
  write ("Du isst "+ME->name(WEN,1)+".\n");
  say (TP->Name(WER)+" isst "+ME->name(WEN,0)+".\n");
  return ::BeimEssen();
}

int pfluecke(string str)
{
  notify_fail("Was willst Du pfluecken?\n");
  if (!str) return 0;
  if (!id(str)) return 0;
  write("Eine starke Macht hindert Dich daran, "+ME->name(WEN,1)+
      " zu pfluecken.\n");
  say(TP->Name()+" wird von einer starken Macht daran gehindert, "+
      ME->name(WEN,0)+" zu pfluecken.\n");
  return 1;
}

int verwelke()
{
  if (environment()) tell_room(environment(), ME->Name()+" verwelkt.\n");
  call_out("remove",0);
}

