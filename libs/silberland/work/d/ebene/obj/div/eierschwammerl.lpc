/*
** Ein Eierschwammerl
** ---
** 1998-05-07  Woody@SL  neu :)
** 2004-03-31  Woody@SL  AddId "pilz"
*/

inherit "std/thing";

#include <properties.h>
#include "/d/ebene/woody/q/pilz/quest.h"
#include "../../ebene.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  AddId (({"pilz","schwammerl","eierschwammerl","pfifferling",
           EIERSCHWAMMERLID}));
  SetProp (P_SHORT, "Ein Eierschwammerl");
  SetProp (P_LONG,
      "Ein wunderbar gelb leuchtendes Eierschwammerl.\n"
      "Von fernen Kulturen wird es auch Pfifferling genannt.\n");
  SetProp (P_NAME, "Eierschwammerl");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_VALUE, 10);
  SetProp (P_WEIGHT, 50);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_MISC_PLANT);
  AddCmd (({"iss","ess","esse","futter","mampf"}), "iss");
}

int iss(string str)
{
  notify_fail("WAS willst Du essen?\n");
  if (!stringp(str) || str=="") return 0;
  if (id(str)) {
    write ("Dieses Schwammerl ist nicht zum Essen bestimmt! "+
      "Zumindest nicht fuer Dich!\n");
    return 1;
  }
  else return (notify_fail("Das kannst Du nicht essen!\n"), 0);
}
