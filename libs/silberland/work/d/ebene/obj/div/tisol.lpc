
inherit "std/thing";

#include <properties.h>
#include <moving.h>

void create()
{
  if (!is_clone(this_object())) return;

  ::create();
  SetProp(P_SHORT,"Ein Tisol" );
  SetProp(P_LONG,
    "Ein Tisol ist ein Tisol ist ein Tisol. Befehl: \"tisol\"\n");

  AddId( ({"tisol"}) );
  SetProp(P_NAME, "Tisol");
  SetProp(P_GENDER, NEUTER );
  SetProp(P_WEIGHT, 250 );
  AddCmd("tisol", "tisol");
}

int tisol()
{
  object ob;
  printf("Du clonest mit dem Tisol [%O/%O] ein neues Tisol.\n",
      getuid(), geteuid());
  ob = clone_object("/d/gebirge/speedy/laby/obj/tisol");
  printf("Das neue Tisol ist %O\n", ob);
  ob->move(this_player(), M_NOCHECK);
  return 1;
}
