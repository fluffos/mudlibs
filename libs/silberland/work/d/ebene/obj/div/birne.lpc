/*
** Eine Birne
** 1996-03-04, Woody@SL
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../../ebene.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Birne");
  SetProp (P_LONG, "Ein leckere, saftige Williamsbirne.\n");
  SetProp (P_NAME, "Birne");
  SetProp (P_GENDER, FEMALE);
  AddId ("birne");
  AddId ("williamsbirne");
  SetProp (P_VALUE, 50);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_MISC_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL:8, F_SOAK:3, F_ALCOHOL:0, F_POISON:0]));
}

BeimEssen()
{
  write ("Du verspeist die Birne genuesslich.\n");
  say (TPN+" verspeist genuesslich eine Birne.\n");
  return ::BeimEssen();
}
