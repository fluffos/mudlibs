inherit "/std/lightsource";

#include <properties.h>
#include <lightsource.h>
#include <language.h>

create() {
  lightsource::create();
  AddId( ({"papierfackel", "fackel"}) );
  SetProp(P_NAME,"Papierfackel");
  SetProp(P_VALUE,3);
  SetProp(P_WEIGHT,400);
  SetProp(P_GENDER,FEMALE);
  SetProp(P_SHORT,"Eine Papierfackel");
  SetProp(P_LONG,"Eine einfache Fackel, die mit Papier umwickelt wurde. "+
    "Man kann sie\nanzuenden und wieder loeschen.\n");
  SetProp(P_ARTICLE,1);
  SetProp(P_FUEL,700);
  SetProp(P_LIGHTDESC,
	  ({"glimmend","flackernd","leicht flackernd","brennend",
            "hell lodernd","frisch angezuendet"}));
  SetProp(P_MATERIAL, ([MAT_WOOD:40,MAT_PAPER:60]) );
}
