/*
** Eine Karotte
** 1996-03-04, Woody@SL
** 2004-09-30, Woody@SL - abgewartet von 20+r10/2 auf 15+r10/5
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../../ebene.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Karotte");
  SetProp (P_LONG,
      "Ein orange leuchtende Karotte. Sie ist sicher sehr nahrhaft.\n");
  SetProp (P_NAME, "Karotte");
  SetProp (P_GENDER, FEMALE);
  AddId ("karotte");
  SetProp (P_VALUE, 30);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 1);
  SetProp (P_INFO, bs("Die Karotte ist aeusserst nahrhaft und kann Dich "
    "bestimmt in Zeiten staerken, in denen Du Dich mal schwach fuehlst. "
    "Ausserdem ist sie gut fuer die Haut."));
  SetProp (P_MATERIAL, MAT_MISC_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL:15+random(10), F_SOAK:5, F_ALCOHOL:0, F_POISON:0]));
}

BeimEssen()
{
  write ("Du futterst genuesslich eine Karotte auf.\n");
  say (TPN+" verspeist genuesslich eine Karotte.\n");
  return ::BeimEssen();
}
