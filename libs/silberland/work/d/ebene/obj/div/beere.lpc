/*
** Eine Holunderbeere
** ---
** 1996-08-17  Woody@SL  Release
*/

inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include "../../ebene.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Holunderbeere");
  SetProp (P_LONG, bs("Eine kleine schwarze Holunderbeere. Bestimmt "+
    "kann man sie nach jemandem werfen."));
  SetProp (P_NAME, "Holunderbeere");
  SetProp (P_KILL_NAME, "Ein Baer... aeh, eine Beere");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_VALUE, 10);
  SetProp (P_WEIGHT, 50);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_MISC_FOOD);
  AddId (({"holunderbeere","beere","\nholunderbeere"}));
  AddCmd (({"iss","ess","esse","futter","mampf"}), "iss");
  AddCmd (({"wirf","werfe","schleuder",
    "schleudere","schmeiss","schmeisse"}), "wirf");
}

int iss(string str)
{
  notify_fail("WAS willst Du essen?\n");
  if (!stringp(str) || str=="") return 0;
  if (id(str)) {
    write ("Du wuergst die Holunderbeere runter, aber irgendwie "+
      "revoltiert Dein Magen...\n");
    say (bs(CAP_TPN+" wuergt eine Holunderbeere runter, die "+
      TPP(WEM)+" aber nicht so ganz zu bekommen scheint..."));
    TP->do_damage (20, 0);
    remove();
    return 1;
  }
  else return (notify_fail("Das kannst Du nicht essen!\n"), 0);
}

int wirf(string str)
{
  string s1,s2;
  object ob;
  string txP, txV, txR;

  notify_fail ("WAS willst Du nach WEM oder WONACH werfen?\n");
  if (!str) return 0;
  if (sscanf(str, "%s nach %s", s1, s2) != 2) return 0;
  if (!id(s1)) return 0;
  if (!ob=present(s2, ENV(TP))) return 0;
  if (TP!=MENV) {
    write ("Du musst die Beere schon erst nehmen, bevor Du sie "+
      "werfen kannst!\n");
    return 1;
  }

  txP = "Du wirfst die Holunderbeere nach "+ob->name(WEM)+" und "+
    "triffst "+ob->QueryPronoun(WEN);
  txR = TP->Name() + " wirft eine Holunderbeere nach "+ob->name(WEM)+
    " und trifft "+ob->QueryPronoun(WEN);

  if (living(ob))
  {
    txP += " mitten im Gesicht.\n";
    txR += " mitten im Gesicht.\n";
    txV = "Klatsch! " + TP->Name() + " wirft Dir eine Holunderbeere " +
      "mitten ins Gesicht!\n";
    write(txP);
    tell_room(ENV(TP), txR, ({ TP,ob }) );
    tell_object(ob, txV);
    move(ob, M_NOCHECK);
  }
  else
  {
    txP += ".\nDie Beere faellt zu Boden.\n";
    txR += ".\nDie Beere faellt zu Boden.\n";
    write(txP);
    ENV(TP)->Message(txR, MSGFLAG_VISUAL | MSGFLAG_NO_TP);
    move(ENV(TP), M_NOCHECK);
  }
  return 1;
}
