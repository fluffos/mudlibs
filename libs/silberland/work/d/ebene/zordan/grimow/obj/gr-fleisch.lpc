
/*

  Ein gegrilltes Stueck Menschenfleisch - Grimowquest Zordan@SL

*/

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

init() {
  ::init();
  if (MENV && !present(QUESTITEM,MENV) && interactive(MENV)) {
    call_out("removeme",0);
  }
}

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Gegrilltes Fleisch");
  SetProp(P_LONG,
    "In Deiner Hand hast Du ein leckeres Stueck gegrilltes Menschenfleisch. "
    "Von welcher Koerperstelle es stammt kannst Du nicht mehr so genau "
    "feststellen. Aber es macht einen hungrigen Oger sicher gluecklich." );
  SetProp(P_INFO, "Das Fleisch wurde hervorragend zubereitet.");
  SetProp(P_NAME, "Fleisch");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "fleisch","\n_grimow_gr_fleisch" }) );

  SetProp(P_MATERIAL, MAT_FLESH );
  SetProp(P_WEIGHT, 600);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, "Das gegrillte Fleisch kauft doch eh niemand.\n");
  SetProp(P_NEVERDROP, 1);
}

removeme() {
  write(BS(
    "Du laesst das gegrillte Fleisch fallen und blitzschnell schnappt sich eine "
    "Ratte das schoene Stueck. Die Ratte verschwindet auf Nimmerwiedersehen. "
    "*seufz*"));
  remove();
}

