
/*

   Ein kleines Stueck Fleisch, herausgeschnitten aus nem Menschen
   fuer die Grimowquest - Zordan@SL

*/


#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

init() {
  ::init();
  if (MENV && !present(QUESTITEM,MENV) && interactive(MENV)) {
    call_out("removeme",0);
  }
}

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleines Stueck Fleisch");
  SetProp(P_LONG,
    "Du hast dem Menschen dieses Stueck Fleisch von seinem Bein abgeschnitten. "
    "Man koennte es vielleicht sogar essen. Aber irgendwie hast Du das Gefuehl, "
    "es ist wichtig das nicht zu tun. Blut rinnt aus vielen Stellen aus "
    "dem Stueck Fleisch heraus." );
  SetProp(P_INFO, "Irgendwie ist das Stueck Fleisch schon wichtig.");
  SetProp(P_NAME, "Stueck Fleisch");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "stueck","fleisch","\n_grimow_kl_fleisch" }) );

  SetProp(P_MATERIAL, MAT_FLESH );
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, "Das Stueck Fleisch kauft doch eh niemand.\n");
  SetProp(P_NEVERDROP, 1);
}

removeme() {
  write(BS(
    "Du laesst das Stueck Fleisch fallen und blitzschnell schnappt sich eine "
    "Ratte das schoene Stueck. Die Ratte verschwindet auf Nimmerwiedersehen. "
    "*seufz*"));
  remove();
}

