
/*

   Ein total normales Holzmesser - Zordan@SL

*/

#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Holzmesser");
  SetProp(P_LONG,
    "Ein kleines Holzmesser. Nicht besonders scharf. Aber es reicht schon "
    "aus um damit jemanden zu verletzen oder Dinge zu schnitzen oder sowas." );
  SetProp(P_NAME, "Holzmesser");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"holzmesser", "messer"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 45);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 50);
  SetProp(P_NOBUY, 0);
}
