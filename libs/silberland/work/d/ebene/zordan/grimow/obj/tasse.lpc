
/*

  Eine kleine Tasse in die man Wasser fuellen kann - Questitem

*/


#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

int gefuellt;

init() {
  ::init();
  if (MENV && !present(QUESTITEM,MENV) && interactive(MENV)) {
    call_out("removeme",0);
  }
}

create() {
  if (!is_clone(TO)) return;
  ::create();

  gefuellt=0;

  SetProp(P_SHORT, "Eine kleine Tasse");
  SetProp(P_LONG,
    "Eine kleine Tasse aus Metall. Viel kann man damit nicht machen. Aber "
    "vielleicht kann man daraus wie aus jeder anderen Tasse etwas trinken. "
    "@@tasse@@" );
  SetProp(P_INFO, "Irgendwie ist die Tasse ziemlich normal.");
  SetProp(P_NAME, "Tasse");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "tasse","\n_grimow_tasse" }) );

  SetProp(P_MATERIAL, MAT_METAL );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, "Du magst die Tasse viel zu sehr.\n");
  SetProp(P_NEVERDROP, 1);
}

removeme() {
  write(BS(
    "Du laesst die Tasse aus Versehen fallen und sie geht kaputt. *seufz*"));
  remove();
}

string tasse() {
  if (gefuellt == 0) {
    return "Im Moment ist sie leer.";
  }
  return "Sie ist mit frischem Wasser gefuellt.";
}

void setwasser(int i) {
  gefuellt=i;
}

int getwasser() {
  return gefuellt;
}
