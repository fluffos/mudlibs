

inherit "std/armour";

#include <properties.h>
#include <combat.h>

create() {
  if(!is_clone(this_object())) return;

  ::create();
  SetProp(P_SHORT, "Ein Paar Ogerstiefel");
  SetProp(P_LONG, 
    "Diese Stiefel passen perfekt zu Ogern. Sie sind eigentlich aus Leder, "
    "aber an ihnen wurde ein kleines Fell angebracht, was sie von normalen "
    "Stiefeln unterscheidet. Sie sind ziemlich robust und schuetzen sehr "
    "gut im Kampf.");

  SetProp(P_NAME, "Ogerstiefel");
  AddId( ({"stiefel","ogerstiefel"}) );

  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  SetProp(P_WEIGHT, 600);
  SetProp(P_VALUE, 400);

  SetProp(P_MATERIAL, ([ MAT_LEATHER:80, MAT_PELT:20 ]) );

  SetProp(P_AC, 7);
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_WEAR_RESTRICTIONS, ([P_SIZE: 200]) );
}
