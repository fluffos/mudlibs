
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Umhang aus Fell");
  SetProp(P_LONG,
    "Dieser Umhang ist aus besonders wertvollem Fell hergestellt worden. "
    "Normalerweise tragen nur Oger diesen Umhang. Er ist nicht sehr schoen, "
    "dient aber wohl hervorragend seinem Zweck." );

  SetProp(P_INFO, "Der Umhang scheint ein wenig vor Wasser zu schuetzen.\n");

  SetProp(P_NAME, "Fellumhang");
  SetProp(P_GENDER, MALE);

  AddId( ({"umhang","fellumhang"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, MAT_PELT );
  SetProp(P_WEIGHT, 550);
  SetProp(P_VALUE, 800+random(200));

  AddProp( P_DAM_PROTECTION, ([DT_WATER:2]) );
  SetProp( P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE: ({ "Oger" }) ]));
}
