
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Hinweisschild fuer Oger-Anfaenger");
  SetProp(P_LONG,
    "Dieses kleine Schild hat wohl mal ein netter? Magier hier fallengelassen. "
    "Wenn Du Oger bist kannst Du es bestimmt lesen." );
  SetProp(P_NAME, "Hinweisschild");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "hinweisschild","schild" }) );

  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 100000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOGET, "Das Schild ist fest im Boden verankert.\n");

  AddCmd( ({ "lies","les","lese" }) , "liesfkt" );

}

int liesfkt(string str) {
  notify_fail("Was moechtest Du lesen?\n");
  if (str != "schild" && str != "hinweisschild") return 0;
  if (!TP->id("Ogerspieler")) {
    write(BS(
      "Das Schild ist nur fuer Oger gedacht. Du kannst die Sprache "
      "nicht lesen. So ein Aerger aber auch."));
    return 1;
  }
  write("Auf dem Schild steht:\n");
  write("---------------------\n");
  write(BS(
    "Hallo Ogerfreunde. Der Grimow, unser Anfuehrer, hat mal wieder sehr "
    "starken Hunger. Wenn ihr ihm noch nicht geholfen habt, dann solltet "
    "ihr dieses ja vielleicht mal als erstes machen. Fragt ihn einfach mal "
    "nach 'Hilfe' ( Das ist fuer Euch Oger eine Level 1 Quest, also eine "
    "Anfaengerquest. In der Liste steht sie nur weiter oben, weil sie fuer "
    "alle anderen Rassen 50 mal schwerer ist. Anm. von -= Zordan =-"));
  return 1;
}
