
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "In einer hellen Hoehle" );
  SetProp( P_INT_LONG,
    "Du kommst in eine riesige Hoehle. Sie breitet sich weiter nach Nordwesten, "
    "Westen und Sueden aus. Ein grosses Loch in der Decke macht es hier "
    "ausreichend hell und es ist windig hier." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 11, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "hoehle" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "loch" }),
    "Durch das Loch in der Decke scheint die Sonne herein. Durch das Loch "
    "pfeift ein starker Wind.");

  AddDetail( ({ "decke" }),
    "In der Decke gaehnt ein riesiges Loch.");

  AddDetail( ({ "ohren","ohr" }),
    "Du kannst Dein Ohr nicht sehen.");

  AddDetail( ({ "sonne" }),
    "Die Sonne scheint herein und macht es hier hell.");

  AddDetail( ({ "boden" }),
    "Auf dem Boden laufen verschiedene Tiere herum. Der Boden selber ist "
    "ziemlich hart.");

  AddDetail( ({ "tier","tiere" }),
    "Die kleinen Tiere sind wie geschaffen um seine ersten Kampferfahrungen "
    "zu sammeln.");

  AddDetail( ({ "kampferfahrungen","erfahrungen" }),
    "Du kannst als Anfaenger hier Deine ersten Kaempfe austragen und "
    "die ersten Kampferfahrungen sammeln.");

  AddDetail( ({ "kampf","kaempfe","opfer" }),
    "Such Dir ein Opfer und vernichte es!");

  AddDetail( ({ "wand","waende" }),
    "Die Waende sind aus hartem Fels. Eine kleine Quelle in der Ostwand "
    "plaetschert vor sich hin.");

  AddDetail( ({ "quelle" }),
    "Aus der Quelle fliesst Wasser in einen kleinen Rinnsal.");

  AddDetail( ({ "ostwand" }),
    "An der Ostwand plaetschert eine kleine Quelle vor sich hin.");

  AddDetail( ({ "rinnsal","weile" }),
    "Das Wasser steht fuer eine kurze Weile, um dann in einer Ritze im Boden "
    "zu verschwinden.");

  AddDetail( ({ "ritze" }),
    "Darin verschwindet das Wasser nach einer Weile.");

  AddDetail( ({ "fels" }),
    "Der helle Fels ist viel zu hart, um ihn irgendwie abzubauen.");

  AddDetail( ({ "anfaenger" }),
    "Wenn Du einer bist, dann bist Du hier genau richtig.");

  AddDetail( ({ "wind" }),
    "Du spuerst wie der Wind ueber Deinen Koerper weht.");

  AddDetail( ({ "koerper" }),
    "Du betrachtest Dich und findest Dich <censored>.");

  AddSound( DEFAULT_SOUND,
    "Der Wind pfeift Dir um die Ohren.");
    
  AddSound( "wind",
    "Der Wind pfeift sehr laut.");
    
  AddSmell( DEFAULT_SMELL,
    "Aus dem Suedwesten gelangt der Geruch nach Fleisch herein.");

  AddSmell( ({ "geruch","fleisch" }) ,
    "Es riecht nach frischen Fleisch.");

  AddSpecialDetail( ({ "wasser" }),  "wasserfkt");

  AddItem( NPC "spinne", REFRESH_DESTRUCT);
  AddItem( "/d/ebene/Park/npc/maus", REFRESH_DESTRUCT);

  AddCmd( ({ "trink","trinke" }) , "trinkfkt" );
  AddCmd( ({ "fuell","fuelle" }) , "fuellfkt" );

  AddExit( "sueden",     "./park_g5" );
  AddExit( "westen",     "./park_f4" );
  AddExit( "nordwesten", "./park_f3" );
}

string wasserfkt() {
  string str;
  str="Das Wasser sieht klar und frisch aus.";
  if(present(QUESTITEM,TP)) {
    if(present("\n_grimow_tasse",TP)) {
      return BS(
        str+" Vielleicht kannst Du Grimow ja etwas davon in Deiner Tasse "
            "mitbringen.");
    }
    return BS(
      str+" Vielleicht ist es genau dieses Wasser, das Grimow haben moechte. "
          "Nur solltest Du Dich erstmal nach einem geeigneten Gefaess "
          "umhoeren.");
  }
  return BS(str);
}

int trinkfkt(string str) {
  notify_fail("Was moechtest Du trinken?\n");
  if (str != "wasser") return 0;
  write(BS(
    "Du nimmst ein wenig Wasser in Deine Haende und trinkst es. Du fuehlst "
    "Dich erfrischt."));
  say(BS(
    CAP_TPN+" nimmt ein wenig Wasser in seine Haende und trinkt es."));
  return 1;
}

// fuer die Grimowquest

int fuellfkt(string str) {
  object ob;
  if (!present(QUESTITEM,TP)) return 0;
  notify_fail("Was moechtest Du womit fuellen?\n");
  if (str != "tasse mit wasser") return 0;
  notify_fail("Du hast keine passende Tasse dabei!\n");
  if(!ob=present("\n_grimow_tasse",TP)) return 0;
  notify_fail("Deine Tasse ist schon mit Wasser gefuellt!\n");
  if (ob->getwasser()) return 0;
  write(BS(
    "Du nimmst die Tasse vorsichtig in die Hand und fuellst sie randvoll "
    "mit frischem Quellwasser."));
  say(BS(
    CAP_TPN+" fuellt eine Tasse mit ein wenig Wasser auf der Quelle."));
  write_file(QUESTLOG "quest.log", 
             dtime(time())+": "+CAP(getuid(TP))+" fuellt die Tasse mit Wasser.\n" );
  ob->setwasser(1);
  return 1;
}
