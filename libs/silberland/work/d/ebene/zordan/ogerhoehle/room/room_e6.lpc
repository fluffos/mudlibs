
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "In einer grossen Hoehle" );
  SetProp( P_INT_LONG,
    "Im Eingangsbereich der grossen Hoehle entsteht eine Menge Licht durch "
    "die einfallenden Sonnenstrahlen. Die Hoehle selber ist hier gute drei Meter "
    "hoch, so dass man hier wirklich ohne weiteres leicht stehen kann. Auf "
    "dem Boden ist eine Blutspur zu sehen. Die Waende zeigen diverse "
    "Kratzer. In der Mitte steht eine grosse Statue." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({"mitte"}),
      "Dort steht eine grosse Statue.");
  AddDetail( ({"statue", "hihi"}),
      "Das ist die Statue von Hihi, einem der beruehmtesten Oger im ganzen "
      "SilberLand. Diese Statue ist seinem Rekord gewidmet.");
  AddDetail( ({"rekord", "dauermetzeln", "millionen", "erfahrungspunkte",
        "woche",}),
      "Hihi haelt den Rekord im Dauermetzeln mit mehr als 100 Millionen "
      "Erfahrungspunkten in einer Woche.");

  AddDetail( ({ "himmel" }),
    "Durch das Loch kannst Du den Himmel erkennen. Draussen scheint die Sonne.");

  AddDetail( ({ "menschenfleich","fleisch" }),
    "Davon ist hier nicht zu sehen.");

  AddDetail( ({ "blutspur","spur","blut","menschenblut" }),
    ([ 0:  "Ekelhaft. Das ist reines Menschenblut und nicht einmal sehr alt.",
       "oger":"Lecker. Frisches Menschenfleisch wurde wohl in die Kueche "
              "geliefert." ]) );

  AddDetail( ({ "kueche" }),
    "Die Blutspur fuehrt nach Westen. Dort muss wohl sowas wie die Kueche "
    "sein." );
  
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus reinem Fels.");

  AddDetail( ({ "fels" }),
    "Grauer und sehr harter Fels ist zu erkennen. Er fuehlt sich ein "
    "wenig kalt an.");

  AddDetail( ({ "meter","pier" }),
    "Na Du wirst schon wissen, wieviel ein Meter genau ist. Ansonsten "
    "schau doch mal in die Naehe des Piers. Dort wird das genau erklaert.");

  AddDetail( ({ "naehe" }),
    "Oh, das ist schon weiter weg.");

  AddDetail( ({ "boden" }),
    "Der Boden ist steinig, aber ziemlich stark festgetreten. Eine frische "
    "Blutspur fuehrt vom Loch in Richtung Westen.");

  AddDetail( ({ "richtung" }),
    "Die Richtung ist wie schon gesagt: Westen.");

  AddDetail( ({ "stein","steine" }),
    "Kleine Steine wurden in die Erde gedrueckt. Dadurch ist ein richtig "
    "fester Boden entstanden.");

  AddDetail( ({ "erde" }),
    "Leicht muffige, dunkle Erde ist das.");

  AddDetail( ({ "waende","wand","felswand","felswaende" }),
    "Die Felswaende sind ziemlich robust. An ihr sind viele Kratzer zu "
    "sehen.");

  AddDetail( ({ "kratzer" }),
    ([ 0: "Wie die wohl da hinkommen?",
       "oger": "Die muessen von Euren letzten Beutezuegen auf die "
               "Menschen hier entstanden sein." ]) );

  AddDetail( ({ "beutezuege","beutezug" }),
    "Na hoffentlich ist der nicht zu lange her.");

  AddDetail( ({ "eingangsbereich","bereich" }),
    "Du stehst im Eingangsbereich dieser grossen Hoehle. Im Suedosten kannst "
    "Du sie leicht durch ein grosses Loch verlassen.");

  AddDetail( ({ "hoehle" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "loch" }),
    "Durch das Loch kommen viele Sonnenstrahlen herein. Es ist so gross, dass "
    "Du leicht die Hoehle verlassen kannst.");

  AddDetail( ({ "menge" }),
    "Na es sind schon sehr, sehr viele.");

  AddDetail( ({ "licht" }),
    "Das Licht entsteht durch die Sonnenstrahlen, die durch das Loch "
    "in die Hoehle scheinen.");

  AddDetail( ({ "sonnenstrahlen","strahlen" }),
    "Die Sonnenstrahlen sind sehr hell und erleuchten diesen Bereich der "
    "Hoehle voellig.");

  AddDetail( ({ "sonne" }),
    "Die Sonne kannst Du direkt von hier aus nicht sehen.");

  AddDetail( ({ "beil","schlag","schlagen" }),
    "Du kannst es nur hoeren, aber nicht sehen.");

  AddSound( DEFAULT_SOUND,
    "Lautes Grunzen und das Schlagen eines Beils sind zu hoeren.");
    
  AddSound( ({ "grunzen" }),
    "Das Grunzen kommt aus allen Richtungen. Du kannst es nicht naeher "
    "definieren.");

  AddSound( ({"schlagen", "beil"}),
      "Du hoerts das Schhlagen eines Beils.");
    
  AddSmell( DEFAULT_SMELL,
    "Aus dem Westen stroemt ein Geruch nach Menschenfleisch herein.");

  AddSmell( ({ "geruch" }),
    "Der Geruch ist eindeutig Menschenfleisch.");

  AddSmell( ({ "menschen","fleisch","menschenfleisch" }),
    ([ 0: "Das es hier so stark nach sogar verbranntem Menschenfleisch "
          "riecht, widert Dich so richtig an.",
       "oger" : "Hmmm, lecker. Menschenfleisch ist Dein Leibgericht!" ]) );

  SetProp(P_HIDE_EXITS, ({ "suedosten" }) );

  AddItem( NPC "oger", REFRESH_DESTRUCT);

  AddExit( "norden",       "./room_e5" );
  AddExit( "westen",       "./room_d6" );
  AddExit( "suedosten",    "./draussen" );
  AddExit( "suedostoben",  "./draussen" );
}

void init()
{
  ::init();
  if (TP && getuid(TP) == "hihi")
    call_out("hihi", 0);
}

void hihi()
{
  if (TP && present(TP))
    write("Mit Stolz blickst Du auf Deine Statue.\n");
}
