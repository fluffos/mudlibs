
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int da;

reset() {
  ::reset();
  da=1;
}

create() {
  ::create();

  da=1;

  SetProp( P_INT_SHORT, "In einer hellen Hoehle" );
  SetProp( P_INT_LONG,
    "Du kommst in eine riesige Hoehle. Sie breitet sich weiter nach Sueden "
    "und Suedosten aus. Ein grosses Loch in der Decke macht es hier "
    "ausreichend hell und es ist windig hier." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 11, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "hoehle" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "ohren","ohr" }),
    "Du kannst Dein Ohr nicht sehen.");

  AddDetail( ({ "loch" }),
    "Durch das Loch in der Decke scheint die Sonne herein. Durch das Loch "
    "pfeift ein starker Wind.");

  AddDetail( ({ "decke" }),
    "In der Decke gaehnt ein riesiges Loch.");

  AddDetail( ({ "sonne" }),
    "Die Sonne scheint herein und macht es hier hell.");

  AddDetail( ({ "boden" }),
    "Auf dem Boden laufen verschiedene Tiere herum. Der Boden selber ist "
    "ziemlich hart. Ein Gegenstand liegt hier.");

  AddDetail( ({ "gegenstand" }),
    "Vielleicht kann man ihn nehmen?");

  AddDetail( ({ "tier","tiere" }),
    "Die kleinen Tiere sind wie geschaffen um seine ersten Kampferfahrungen "
    "zu sammeln.");

  AddDetail( ({ "kampferfahrungen","erfahrungen" }),
    "Du kannst als Anfaenger hier Deine ersten Kaempfe austragen und "
    "die ersten Kampferfahrungen sammeln.");

  AddDetail( ({ "kampf","kaempfe","opfer" }),
    "Such Dir ein Opfer und vernichte es!");

  AddDetail( ({ "wand","waende" }),
    "Die Waende sind aus hartem Fels.");

  AddDetail( ({ "fels" }),
    "Der helle Fels ist viel zu hart, um ihn irgendwie abzubauen.");

  AddDetail( ({ "anfaenger" }),
    "Wenn Du einer bist, dann bist Du hier genau richtig.");

  AddDetail( ({ "wind" }),
    "Du spuerst wie der Wind ueber Deinen Koerper weht.");

  AddDetail( ({ "koerper" }),
    "Du betrachtest Dich und findest Dich <censored>.");

  AddSound( DEFAULT_SOUND,
    "Der Wind pfeift Dir um die Ohren.");
    
  AddSound( "wind",
    "Der Wind pfeift sehr laut.");
    
  AddSmell( DEFAULT_SMELL,
    "Aus dem Suedwesten gelangt der Geruch nach Fleisch herein.");

  AddSmell( ({ "geruch","fleisch" }) ,
    "Es riecht nach frischen Fleisch.");

  AddItem( "/d/ebene/Park/npc/igel", REFRESH_DESTRUCT);
  AddItem( "/d/gebirge/dusty/hoch/mon/assel", REFRESH_DESTRUCT);

  AddExit( "sueden",      "./park_f4" );
  AddExit( "suedosten",   "./park_g4" );

  AddCmd( ({ "nimm","nehme" }), "nimmfkt" );
}

int nimmfkt(string str) {
  notify_fail("Wo moechtest Du genau nehmen?\n");
  if (str == "gegenstand" || str == "den gegentand" ) {
    say(CAP_TPN+" bueckt sich nieder.\n");
    if (da == 1) {
      write(BS(
        "Du schaust Dir den Boden genauer an und siehe da. Eine Schlangenhaut "
        "klebte daran. Es ist die Haut einer Satanskobra und Du bist heilfroh, "
        "dass die Schlange sich wohl schon lange verzogen hat. Deinen Fund "
        "steckst Du natuerlich sofort ein." ));
      da=0;
      CLONE( "/d/dschungel/dante/weg/armour/dhaut",TP);
    } else {
      write(BS(
        "So ein Mist, Du hast Dich wohl getaeuscht. Da ist ja gar nichts :(" ));
    } 
    return 1;
  }
  return 0;
}
