
#include "../def.h"

inherit "std/post";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Eine seltsame Hoehle" );
  SetProp( P_INT_LONG,
    "Du findest Dich in einer recht kleinen und engen Hoehle wieder. "
    "Staub liegt auf dem Boden und auch zeigen die Kabinen hier einen "
    "eher seltenen Besuch. Wenn Du dennoch in der Lage bist zu lesen "
    "oder schreiben, so kannst Du hier Deine Post abwickeln." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "decke" }),
    "Die Decke ist nicht sehr hoch.");

  AddDetail( ({ "wand","waende" }),
    ([ 0:     "Die Waende sind hier nicht besonders. An zwei von ihnen "
              "stehen kleine Kabinen.",
       "oger":"Die Waende erdruecken Dich hier fast. An zwei von ihnen "
              "stehen viel zu kleine Kabinen.",
       "troll":"Die Waende drohen Dich zu erdruecken. Viel zu eng ist es hier. "
               "An zwei Waenden stehen auch super winzige Kabinen." ]) );

  AddDetail( ({ "hoehle" }),
    ([ 0:   "Die Hoehle ist gerade gross genug, dass Du drin stehen kannst.",
       "oger":"Du empfindest diese Hoehle als zu klein.",
       "troll":"Die Hoehle ist fuer Dich viel zu klein." ]) );

  AddDetail( ({ "staub" }),
    "Massenweise Staub liegt auf dem Boden herum.");

  AddDetail( ({ "boden" }),
    "Der Boden ist total staubig und nicht so wie die anderen Teile der "
    "Hoehle festgetreten. Es kommt wohl wirklich selten jemand hierher.");

  AddDetail( ({ "teil","teile" }),
    "Die sind weiter im Suedwesten.");

  AddDetail( ({ "kabinen","kabine" }),
    "Die sind wohl mal gelb angemalt worden. Aber die Farbe ist schon "
    "sehr verblasst.");

  AddDetail( ({ "farbe" }),
    "Von der gelben Farbe ist fast nichts mehr uebrig.");

  AddDetail( ({ "besuch","anschein","besucher" }),
    "Es hat den Anschein, als bist Du einer der wenigen Besucher in "
    "dieser Hoehle.");

  AddDetail( ({ "lage","zeilen" }),
    ([ 0:    "Na Du wirst das sicher hinbekommen.",
       "oger":"Es klappt zwar nicht immer, aber meistens schaffst auch Du "
              "es, ein paar Zeilen zu schreiben und sogar zu lesen." ]) );

  AddDetail( ({ "post" }),
    "Dazu gib einfach so 'post' ein.");

  AddSound( DEFAULT_SOUND,
    "Hier ist es sehr ruhig.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig nach Staub.");

  AddSmell( ({ "staub" }),
    "Abgestanden riecht der Staub. Hier ist wohl selten jemand.");

  AddExit( "suedwesten",  "./room_d4" );
}
