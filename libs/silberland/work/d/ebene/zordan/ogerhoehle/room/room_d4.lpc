
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>

/*

mapping tor;
int max;

reset() {
  ::reset();
  tor=([ ]);
  max=0;
}

*/

create() {
  ::create();

  SetProp( P_INT_SHORT, "In einer kleinen Hoehle" );
  SetProp( P_INT_LONG,
    "Dieser Hoehlenabschnitt ist eher langweilig. Waere da nicht dieser "
    "abscheuliche Pranger an der suedlichen Wand, wuerde man hier "
    "wahrscheinlich einfach nur so durchgehen. Es ist hier auch nicht so "
    "hell, wie es sonst so ueblich ist." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_CAVE]) );

/*
  tor=([ ]);
  max=0;
*/

  AddDetail( ({ "hoehle","hoehlenabschnitt","abschnitt" }),QueryProp(P_INT_LONG));

  AddDetail( ({ "boden" }),
    "Der Boden ist hart und Du siehst ein wenig Blut.");

  AddDetail( ({ "pranger" }),
    "An dem Pranger haengt ein Mensch. Seine Haende und Fuesse wurden "
    "gefesselt. Der Pranger selber besteht aus einfachem Holz.");

  AddDetail( ({ "mensch","menschen" }),
    "Der Mensch wurde an den Pranger gestellt. Er wird dort wohl solange "
    "haengen, bis er verendet.");

  AddDetail( ({ "holz" }),
    "Ganz normales Holz. Es ist blutueberstroemt.");

  AddDetail( ({ "fuesse","fuss","haende","hand" }),
    "Die wurden gefesselt. Der Mensch wird wohl nie wieder entkommen koennen.");

  AddDetail( ({ "wand","waende" }),
    "Die Waende sind hier extrem langweilig. Nur im Sueden ist ein Pranger an "
    "der Wand befestigt worden.");

  AddDetail( ({ "decke" }),
    "Die Decke ist aus normalem Fels.");

  AddDetail( ({ "fels" }),
    "Dunkler Fels. An manchen Stellen ist Blut zu sehen.");

  AddDetail( ({ "stellen","stelle" }),
    "Diese Stellen sind mit Blut verschmiert.");

  AddDetail( ({ "blut" }),
    "Das Blut ist an manchen Stellen frisch und an anderen wiederum "
    "schon vertrocknet. Es wird wohl von ehemaligen Gefangenen stammen.");

  AddDetail( ({ "gefangene","gefangener" }),
    ([ 0:     "Oger nehmen oft Menschen gefangen und essen sie auf. Hier "
              "stellen sie wohl ein paar zur Schau.",
       "oger":"Ihr nehmt doch haeufiger Menschen gefangen und esst sie "
              "auf. Hier stellt ihr sie manchmal einfach nur so zur "
              "Schau. Du bekommst doch auch sofort Hunger." ]) );

  AddDetail( ({ "schau" }),
    "Schau Dir den Menschen doch an.");

  AddDetail( ({ "hunger" }),
    "Dein Magen knurrt laut auf.");

  AddDetail( ({ "magen" }),
    "Du solltest schnell was essen gehen!");

  AddSound( DEFAULT_SOUND,
    "Lautes Grunzen kommt aus dem Norden.");
    
  AddSound( ({ "grunzen" }),
    "Du kannst das Grunzen leider nicht genauer einordnen.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht ekelhaft hier.");

/*
  AddItem("/obj/sehertor", REFRESH_NONE);
  AddCmd( ({"teleportier","teleportiere"}), "teleport");
*/
  AddItem( NPC "mensch", REFRESH_DESTRUCT );

  AddExit( "suedosten", "./room_e5" );
//  AddExit( "norden",    "./room_d3" );
  AddExit( "norden",    "/gilden/abenteurer/ogergilde" );
  AddExit( "westen",    "./room_c4" );
  AddExit( "nordosten", "./room_e3" );
}

