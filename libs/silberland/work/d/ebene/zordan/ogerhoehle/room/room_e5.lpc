
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Eine Hoehlendurchgang" );
  SetProp( P_INT_LONG,
    "Du stehst jetzt wohl im Zentrum dieser grossen Hoehle. Mehrere "
    "Abzweigungen fuehren in verschiedene Richtungen weiter. Das Licht "
    "der Fackeln an der Wand flackert durch den Wind, der aus dem Nordosten "
    "hereinstroemt. Auf dem Boden verteilt liegen viele alte Waffen und "
    "Ruestungen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "decke" }),
    "Du kannst nichts Besonders an der Decke erkennen.");

  AddDetail( ({ "harz" }),
    "Das Harz stamm sicher aus dem Wald vor der Hoehle.");

  AddDetail( ({ "wald" }),
    "Der ist ausserhalb der Hoehle und hier nicht zu sehen.");

  AddDetail( ({ "ruestungen","ruestung" }),
    "Ein paar unbrauchbare Ruestungen liegen auf dem Boden. Sicher haben "
    "die Oger sie nach ihren Beutezuegen hier abgelegt. Ein seltsamer "
    "Geruch steigt von ihnen auf.");

  AddDetail( ({ "beutezuege","beutezug" }),
    "Ja, das machen Oger normalerweise.");

  AddDetail( ({ "wand","waende" }),
    "Die Waende sind aus ganz normalem Felsgestein. In ihnen haengen "
    "ein paar Fackeln. In der westlichen Wand ist eine Tuer.");

  AddDetail( ({ "fels","felsgestein","gestein" }),
    "Harter Fels wie ueberall in dieser grossen Hoehle.");

  AddDetail( ({ "wind" }),
    "Du spuerst wie ein leichter Wind aus dem Nordosten in den Sueden "
    "stroemt.");

  AddDetail( ({ "boden" }),
    "Auf dem ausgetrampelten Boden liegen viele Waffen und Ruestungen herum.");

  AddDetail( ({ "waffen" }),
    "Dabei handelt es sich vor allem um Keulen. Aber auch andere Typen kannst "
    "Du erkennen.");

  AddDetail( ({ "keule","keulen","mitnehmen","haende","hand" }),
    "Die Keulen sind primitiv, aber in den Haenden eines Ogers sicher "
    "eine gefaehrliche Waffe. Leider sind sie schon so kaputt, dass sich "
    "das Mitnehmen sicher nicht lohnt.");

  AddDetail( ({ "oger" }),
    "Derzeit ist wohl keiner da.");

  AddDetail( ({ "typen","typ" }),
    "Das sind alles moegliche an Waffen. Da sie aber alle schon recht "
    "kaputt sind, schaust Du sie Dir nicht naeher an und laesst sie liegen.");

  AddDetail( ({ "richtungen","richtung" }),
    "Schau Dich einfach um, dann siehst Du schon alle Richtungen.");

  AddDetail( ({ "licht" }),
    "Die Hoehle ist ziemlich gut ausgeleuchtet. Die Fackeln verbreiten ein "
    "recht helles Licht.");

  AddDetail( ({ "fackeln","fackel" }),
    "Die Fackeln sind mit Harz beschmiert und brennen daher sehr lange. "
    "Sie haengen in kleinen Haltern an den Waenden.");

  AddDetail( ({ "halter","fackelhalter" }),
    "Die Fackelhalter sind aus primitiv geschmiedetem Eisen.");

  AddDetail( ({ "eisen" }),
    "Das Eisen ist nicht besonders gut bearbeitet worden.");

  AddDetail( ({ "zentrum" }),
    "Das erkennst Du daran, dass hier viele Abzweigungen in alle Richtungen "
    "abgehen.");

  AddDetail( ({ "hoehle" }),
    "Dieser Teil der Hoehle ist wohl das Zentrum der Hoehle. Fackeln "
    "verbreiten ein angenehmes Licht und es weht ein seichter Wind.");

  AddDetail( ({ "teil","teile" }),
    "Die anderen Teile findest Du wohl hinter den Abzweigungen.");

  AddDetail( ({ "abzweigungen","abzweigung" }),
    "Es gibt hier genau vier Abzweigungen. Die nach Westen scheint etwas "
    "anders zu sein, denn dort ist eine kleine Tuer eingebaut worden.");

  AddDetail( ({ "tuer" }),
    "Die einfache Tuer im Westen ist offen und aus Holz gemacht. Auf der "
    "Tuer ist aber ein kleines Symbol geschnitzt worden.");

  AddDetail( ({ "symbol" }),
    "\n         ()\n"
    "         )(\n"
    "      o======o\n"
    "       / || \\\n"
    "      /  ||  \\\n"
    "     /   ||   \\\n"
    "    /    ||    \\\n"
    "_ _/_ _  ||  _ _\\_ _\n"
    " \\___/   ||   \\___/\n"
    "         ||\n"
    "         ||\n"
    "         ||\n"
    "         \\/\n"
    "Bei genauerer Betrachtung meint man es waeren ein Schwert und eine "
    "Waage.");

  AddDetail( ({ "schwert" }),
    "Das koennte glatt ein heiliges Schwert sein.");

  AddDetail( ({ "waage","gerechtigkeit" }),
    "Die Waage steht wohl fuer Gerechtigkeit.");

  AddDetail( ({ "holz" }),
    "Ganz normales, helles Holz.");

  AddDetail( ({ "luft" }),
    "Die Luft kann man nur schwer sehen.");

  AddDetail( ({ "menge" }),
    "Es weht schon sehr arg hier.");

  AddDetail( ({ "ueberreste","lebewesen" }),
    "An den Waffen kleben noch die Ueberreste von Lebewesen.");

  AddSound( DEFAULT_SOUND,
    "Hier ist es irgendwie seltsam ruhig. Nur die Fackeln an der Wand "
    "knistern leise vor sich hin.");
    
  AddSound( ({ "knistern","fackel","fackeln" }),
    "Die Fackeln brennen langsam ab und knistern dabei leise vor sich hin.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig modrig. Aber durch den Wind kommt doch eine "
    "Menge frischer Luft in die Hoehle.");

  AddSmell( ({ "wind" }),
    "Der riecht nach frischer Luft.");

  AddSmell( ({ "luft" }),
    "Die Luft riecht trotz des modrigen Geruches hier ziemlich frisch.");

  AddSmell( ({ "geruch","moder" }),
    "Dieser seltsam modrige Geruch scheint von den Waffen und Ruestungen "
    "zu kommen.");

  AddSmell( ({ "waffen","ruestungen","waffe","ruestung" }),
    "Die Waffen und Ruestungen riechen leicht modrig, weil an ihnen noch "
    "die Ueberreste von Lebewesen kleben.");

  AddItem( NPC "oger",   REFRESH_DESTRUCT);
  AddItem( OBJ "schild", REFRESH_REMOVE);

  AddExit( "sueden",     "./room_e6" );
  AddExit( "westen",     "./room_d5" );
  AddExit( "nordwesten", "./room_d4" );
  AddExit( "nordosten",  "./park_f4" );
}
