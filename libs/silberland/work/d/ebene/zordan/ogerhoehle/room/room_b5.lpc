
#include "../def.h"

inherit "std/laden";

#include <properties.h>
#include <language.h>
#include <laden.h>

void create()
{
  ::create();

  SetStorageRoom( ROOM "room_b6");

  SetProp( P_INT_SHORT, "Eine winzige Ladenhoehle" );
  SetProp( P_INT_LONG,
    "In dieser kleinen Hoehle hat sich ein Haendler niedergelassen. Er "
    "hat dafuer mitten in die Hoehle eine kleine Theke plaziert und ein "
    "paar Regale an den Waenden angebracht. An der Decke haengt ein grosser "
    "Leuchter, der die Hoehle mehr als sonst wo erhellt. Im Sueden scheint "
    "Orgens Vorratsraum zu sein." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 19, ENV_TERRAIN: TT_CAVE]) );

  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "\n_orgen");
  SetProp(P_SHOPKEEPER_NAME, "Orgen");
  SetProp(P_SHOPKEEPER_GENDER, MALE);

  AddDetail( ({ "hoehle" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "vorratsraum","raum","sueden" }),
    "Der Vorratsraum liegt im Sueden. Doch wird Dich Orgen dort sicher nicht "
    "hineinlassen." );

  AddDetail( ({ "decke" }),
    "Die Decke ist hier hoeher als sonst. Ein grosser Leuchter haengt "
    "an ihr." );

  AddDetail( ({ "leuchter" }),
    "Der Leuchter haengt an drei dicken Eisenketten an der Decke. Mit seinen "
    "drei grossen Kerzen erhellt er die Hoehle extrem stark." );

  AddDetail( ({ "eisenketten","ketten" }),
    "Die Eisenketten halten den Leuchter an der Decke. Sie sind nicht gerade "
    "professionell, aber praktisch hergestellt worden." );

  AddDetail( ({ "kerzen","kerze" }),
    "Die Kerzen sind einfach riesig und strahlen ein sehr helles Licht aus." );

  AddDetail( ({ "eisen" }),
    "Grob geschmiedetes Eisen." );

  AddDetail( ({ "haendler","orgen" }), 
    "Ist Orgen nicht da?" );

  AddDetail( ({ "regale","regal" }),
    "Die Regale sind aus ganz normalem Holz und ziemlich hoch. Insgesammt "
    "hat jedes von ihnen sechs Einschuebe." );

  AddDetail( ({ "holz" }), 
    "Recht helles Holz aus den nahen Waeldern." );

  AddDetail( ({ "einschraenkung","sorten","sorte" }), 
    "Andere Sorten an Waffen kannst Du halt nicht erkennen." );

  AddDetail( ({ "waren","waffen","keule","keulen","schwert","schwerter" }), 
    "Orgen scheint bis auf die Einschraenkung bei seinen Waffen auf Keulen "
    "und Schwerter mit allem moeglichen zu handeln." );

  AddDetail( ({ "wald","waelder" }), 
    "Die sind draussen vor der Hoehle." );

  AddDetail( ({ "einschuebe","einschub" }),
    "Die Einschuebe sind recht gut gefuellt. Allerdings bietet Orgen nicht "
    "alles zum Verkauf an. Wenn Du sehen moechtest was Orgen so anzubieten "
    "hat, dann kannst Du ja mal das Schild auf der Theke lesen." );

  AddDetail( ({ "verkauf","ankauf" }), 
    "Hier findet nicht nur Verkauf statt, sondern auch Ankauf." );

  AddDetail( ({ "waende","wand" }), 
    "Von den Waenden ist hier nicht mehr viel zu sehen. Orgen hat sie fast "
    "alle mit Regalen zugestellt. Nur im Nordosten hat er ein kleines Loch "
    "gelassen, damit seine Kunden die Hoehle betreten und verlassen koennen." );

  AddDetail( ({ "loch" }),
    "Das Loch ist ziemlich gross. Auf eine Tuer hat Orgen aber wohl "
    "verzichtet." );

  AddDetail( ({ "tuer" }),
    "*grummel*" );

  AddDetail( ({ "kunden","kunde","geschaefte","geschaeft" }),
    "Du gehoerst doch zu seinen Kunden. Schau Dich um und taetige Deine "
    "Geschaefte." );

  AddDetail( ({ "boden" }),
    "Auf dem Boden liegen diverse Gegenstaende herum. Ansonsten ist er "
    "wie auch sonst wo mit kleinen Steinchen ueberhaeuft und sehr gut "
    "festgetreten." );

  AddDetail( ({ "steinchen","steine","stein" }),
    "Kleine, runde Steine sind da. Sie glaenzen ein wenig hell im Schein "
    "des Leuchters." );

  AddDetail( ({ "schein","licht" }),
    "Der Schein des Leuchters erhellt die Hoehle ziemlich stark. Man wird "
    "hier kaum unbemerkt etwas stehlen koennen." );

  AddDetail( ({ "gegenstaende","gegenstand" }),
    "Schau Dir doch mal Orgens Regale an. Du findest sicher etwas schoenes." );

  AddDetail( ({ "theke" }),
    "Die kleine Theke steht mitten in der Hoehle. Auf ihr steht eine Kasse und "
    "ein kleines Schild.");

  AddDetail( ({ "schild" }),
    "Auf dem Schild wird erklaert wie Du hier was machen kannst. Du kannst "
    "es lesen.");

  AddDetail( ({ "kasse" }),
    "Eine seltsame Kasse ist das. Eigentlich ist es mehr nur ein kleiner "
    "Kasten, in dem das Geld liegt." );

  AddDetail( ({ "geld" }),
    "Es ist nicht soviel, dass sich stehlen lohnen wuerde." );

  AddDetail( ({ "kasten" }),
    "Der Kasten ist oben offen und es liegt ein wenig Geld darin." );

  AddReadDetail( "schild" ,
"Du kannst hier folgende Dinge tun:\n"
"<zeige>             Gibt eine Uebersicht ueber das Angebot.\n"
"<zeige> rue|ver|waf Uebersicht ueber Ruestungen/Verschiedenes/Waffen.\n"
"<unt> nummer        Gibt eine Beschreibung eines Gegenstands aus.\n"
"<kaufe> nummer|name Du kaufst einen bestimmten Gegenstand.\n"
"<verkaufe> etwas    Du verkaufst einen Gegenstand, den Du bei Dir hast.\n"
"<verkaufe> alles    Du verkaufst alles was Du nicht traegt oder auf \n"
"                    <behalte> gesetzt hast ( siehe 'hilfe behalte' ).\n"
"<versetze> etwas    Du verkaufst einen Gegenstand, egal wieviel der\n"
"                    Haendler dafuer bezahlt.\n"
"<schaetz> etwas     Der Haendler sagt Dir, wieviel ihm ein Gegenstand\n"
"                    wert waere, wenn Du ihn verkaufen wuerdest.\n");

  AddSound( DEFAULT_SOUND,
    "Orgen klimmpert ein wenig mit seinem Geld herum.");
    
  AddSound( ({ "orgen","geld" }),
    "*Klimper*");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es eigentlich ganz gut. Wonach kannst Du aber irgendwie "
    "nicht bestimmen.");

  AddItem( NPC "orgen", REFRESH_DESTRUCT);
  // AddItem( "/d/ebene/obj/div/teddyautomat", REFRESH_REMOVE);

  AddExit( "nordosten",     "./room_c4" );
  AddGuardedExit( "sueden", "./room_b6", "\n_orgen",
                  "Orgen wuerde Dich niemals lebend in seinen Vorratsraum "
                  "gehen lassen!\n" );
}

varargs int do_sell(object ob, int force, string prefix, int limit)
{
  if(TP->QueryProp(P_RACE) == "Mensch") {
    if(!present("\n_orgen")) return 1;
    write(break_string(
      "Mit Menschen mache ich keine Geschaefte!",
      78,"Orgen sagt: " ));
    return 1;
  }
  if(ob->QueryProp(P_WEAPON_TYPE)) {    // war: P_WC (woody, 2005-05-07)
    if(!present("\n_orgen")) return ::do_sell(ob, force, prefix, limit);
    if ((ob->QueryProp(P_WEAPON_TYPE) != WT_CLUB ) &&
        (ob->QueryProp(P_WEAPON_TYPE) != WT_SWORD ) &&
        (ob->QueryProp(P_WEAPON_TYPE) != WT_SPEAR )) {
      write(break_string(
        "Tut mir leid, aber ich handle nur mit Keulen, Schwertern und Speeren.",
        78,"Orgen sagt: " ));
      return 1;
    }
  }
  return ::do_sell(ob, force, prefix, limit);
}

