
#include "../def.h"

inherit "std/pub";

#include <properties.h>
#include <language.h>
#include <pub.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Eine gewaltig stinkende Kueche" );
  SetProp( P_INT_LONG,
    "Du findest Dich in einer riesigen Kueche wieder. Eine Feuerstelle ist "
    "in die westliche Wand eingebaut. Im suedlichen Bereich steht ein grosser "
    "Tisch mit ein paar primitiven Stuehlen. Erst jetzt wendet sich Dein "
    "Blick der Nahrung im Norden zu: Es sind frisch gegrillte und "
    "an kleinen Haken an der Decke aufgehaengte Menschen, beziehungsweise "
    "deren Ueberreste." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "\nbeorn");
  SetProp(P_PUBKEEPER_NAME, "Beorn");
  SetProp(P_PUBMSG_NOKEEPER, 
    "Beorn ist zur Zeit wohl auf Menschenjagd.\n");
  SetProp(P_PUBMSG_NOENEMY, 
    "Beorn wird Dich erst toeten und dann verspeisen.\n");
  SetProp(P_PUBMSG_NOINVITE, 
    "Beorn kann sich durchaus selber bedienen.\n");
  SetProp(P_PUBMSG_FIGHTING,
    "Beorn besorgt gerade Nachschub fuer seinen Vorrat.\n");

  AddFood("Ogerwurst", ({"ogerwurst","wurst"}),
    80, ({ 23,16,4}), 10, ({
      "Beorn bringt Dir eine lecker aussehende Wurst. Du schlingst sie "
      "runter und fuehlst Dich wohl.",
      "Beorn bringt && eine lecker aussehende Wurst. && schlingt sie "
      "sofort runter und scheint sich gut zu fuehlen." }) );

  AddFood("Menschenkeule",     ({"menschenkeule","keule"}),
    110, ({ 26,21, 5}), 15, "menschenkeule");

  AddFood("Lunge",             ({"lunge"}),
    220, ({ 35,30, 5}), 12, "menschenlunge");

  AddFood("Ein blutiges Herz", ({"herz"}),
    450, ({ 50,15, 6}), 11, "menschenherz");

  AddDrink("Felsquellwasser", ({"felsquellwasser", "wasser","quellwasser" }),
     50, ({ 10,10,2 }), 0, 4, ({
      "Beorn schenkt Dir ein kleines Glas mit frischen Wasser ein. "
      "Mit einem leichten Prickeln laeuft es Deinen Hals hinunter.",
      "Beorn schenkt && ein Glas mit frischem Wasser ein."}) );

  AddDrink("Becher Blut", ({"becher", "blut"}),
    120, ({ 19,14,5 }), 0, 8, "menschenblut" );

  AddDrink("Ogerschnaps", ({"ogerschnaps", "schnaps"}),
    280, ({ 28,33,5 }),10, 3, ({
      "Beorn schenkt Dir ein kleines Glas mit einer brauen Fluessigkeit voll. "
      "Du kippst das Glas mit einem kleinem Laecheln auf den Lippen "
      "schnell hinunter. Ein wenig roecheln musst Du jetzt doch.",
      "Beorn schenkt && ein Glas mit einer brauen Fluessigkeit voll und && "
      "trinkt es mit einem leisen Roecheln aus."}) );
  
  AddDetail( ({ "kueche" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "feuer" }),
    "Das helle Feuer lodert vor sich hin.");

  AddDetail( ({ "boden" }),
    "Der Boden ist hier mit grosse Steinplatten ausgelegt worden.");

  AddDetail( ({ "steinplatten","platten" }),
    "Die Steinplatten sind sehr robust und halten sogar einem wild "
    "essendem Oger stand.");

  AddDetail( ({ "bereich" }),
    "Im suedlichen Bereich wird wohl gegessen.");

  AddDetail( ({ "rauch" }),
    "Der aetzende Rauch entsteigt der Feuerstelle und sammelt sich an "
    "der Decke. Vieles weht nach Osten raus.");

  AddDetail( ({ "ueberreste","reste" }),
    "Das sind die sterblichen Ueberreste von Menschen. Allerdings wurden "
    "sie schon auf der Feuerstelle zubereitet und an der Decke vor "
    "dem Verzehr gelagert.");

  AddDetail( ({ "verzehr" }),
    "Das dauert wohl noch.");

  AddDetail( ({ "decke" }),
    "Die Decke ist schon ganz dunkel durch den immer vorhandenen Rauch "
    "in der Kueche. Im Norden sind ein paar Haken in der Decke angebracht "
    "worden.");

  AddDetail( ({ "menschen" }),
    ([ 0:     "Du bist schockiert und wendest Dich sofort ab.",
       "oger":"Die lecker zubreiteten Menschen lassen Deinen Magen "
              "knurren. Sicher ist es besser, Du bestellst Dir schnell "
              "etwas." ]) );

  AddDetail( ({ "blick" }),
    "Dein Blick faellt nach Norden.");

  AddDetail( ({ "nahrung" }),
    ([ 0:    "Dir gefaellt die Nahrung hier sicher nicht.",
      "oger":"So langsam wirst Du richtig nervoes. Du bekommst einen "
             "richtig grossen Hunger auf Menschenfleisch. Wenn Du Dir "
             "nicht sofort Nahrung einschiebst, verhungerst Du glatt." ]) );

  AddDetail( ({ "haken" }),
    "Die Haken sind an der Decke befestigt. An ihnen haengen die "
    "Ueberreste von Menschen.");

  AddDetail( ({ "wand","waende" }),
    "In der westlichen Wand ist eine Feuerstelle eingebaut und an der "
    "noerdlichen Wand haengen gegrillte Menschen.");

  AddDetail( ({ "westwand" }),
    "In der Westwand in eine grosse Feuerstelle.");

  AddDetail( ({ "suedwand" }),
    "An der Suedwand steht ein grosser Tisch mit ein paar Stuehlen.");

  AddDetail( ({ "tisch" }),
    "Um den Tisch herum sitzen ein paar Oger und sind am essen. Der Tisch "
    "selber sieht sehr stabil aus und ist aus Holz. Viele Bisspuren sind "
    "an den Kanten zu sehen.");

  AddDetail( ({ "bisspuren","spuren" }),
    "Die koennen nur von hungrigen Ogern gekommen sein. Aber ob Holz "
    "reicht um satt zu werden?");

  AddDetail( ({ "kanten" }),
    "Die Kanten des Tisches sind angenagt.");

  AddDetail( ({ "feuerstelle","stelle" }),
    "Auf der Feuerstelle wird gerade ein frisches Stueck Fleisch gegrillt. "
    "Neben der Feuerstelle ist ein Stapel Holz aufgeschichtet.");

  AddDetail( ({ "stueck","fleisch","menschenfleisch" }),
    ([  0: "Du bist Dir nicht ganz sicher. Aber Du vermutest stark, dass "
           "es sich dabei um ekelhaftes Menschenfleisch handelt.",
        "oger":"Du bekommst so richtig Hunger, als Du das schoene Stueck "
                "Menschenfleisch auf der Feuerstelle grillen siehst." ]) );

  AddDetail( ({ "hunger" }),
    "Bestell und iss lieber schnell was!");

  AddDetail( ({ "stapel" }),
    "Das sind ein paar Scheite um das Feuer am brennen zu halten.");

  AddDetail( ({ "scheite" }),
    "Sehr trockenes und fein saeuberlich geschlagenes Holz.");

  AddDetail( ({ "oger" }),
    "Ein paar Oger sitzen am Tisch und nagen an ein paar Knochen. Sie sind "
    "ziemlich bleich und ihre Haut ist mit etwas eingeschmiert. Aus ihren "
    "Muendern ragen grosse Schneidezaehne hervor.");

  AddDetail( ({ "schneidezaehne","zaehne","hauer" }),
    "Gewaltige Hauer sind das. Durchaus in der Lage einen Knochen zu "
    "zerbeissen.");

  AddDetail( ({ "lage" }),
    "Sie wuerden auch Deine Knochen damit zerbeissen koennen.");

  AddDetail( ({ "mund","muender" }),
    "Aus den Muendern der Oger rage recht grosse Schneidezaehne hervor.");

  AddDetail( ({ "knochen" }),
    "Irgendwie erinnern Dich diese Knochen an etwas.");

  AddDetail( ({ "haut" }),
    "Die Haut der Oger glaenzt.");

  AddDetail( ({ "waelder","wald" }),
    "Hier bist Du in der Kueche, nicht im Wald.");

  AddDetail( ({ "holz" }),
    "Das ist ganz normales, wenn auch schon ein wenig rottes, Holz aus "
    "den Waeldern hier.");

  AddDetail( ({ "stuehle" }),
    "Auf den primitiven Stuehlen aus Holz sitzen ein paar Oger und nagen "
    "an ein paar Knochen. Sie unterhalten sich lautstark und lachen dabei.");

  AddSound( DEFAULT_SOUND,
    ([ 0:"Ein paar der Oger am Tisch grunzen sich gegenseitig an.",
       "oger":"Ein paar Oger am Tisch unterhalten sich ueber ihre letzten "
              "Beutezuege zu den Menschen." ]) );

  AddSound( ({ "oger","grunzen","wort" }),
    ([ 0:"Du kannst leider kein einziges Wort verstehen.",
       "oger":"Ganz genau kannst Du nichts hoeren, aber sie lachen mit Dir "
              "ueber die Menschen." ]) );

  AddSmell( DEFAULT_SMELL,
    ([ 0:"Es richt ziemlich abstossend nach verbranntem Menschenfleisch.",
       "oger":"Dir laeuft das Wasser im Munde zusammen, als der tolle "
              "Duft des Menschenfleisches in Deine Nase steigt." ]) );

  AddSmell( ({ "menschenfleisch","fleisch" }),
    ([ 0:"Du wendest Dich angewidert ab.",
       "oger":"Puha, jetzt bekommst Du so richtig Hunger. Besser Du bestellst "
              "Dir sofort etwas." ]) );

  AddItem( NPC "beorn", REFRESH_DESTRUCT);

  AddCmd( ({ "nag","nage" }) , "nagfkt" );

  AddExit( "osten", "./room_e6" );
}

nosave check_race(object ob,string str) {
  if (ob->QueryProp(P_RACE) == "Oger") return 1;
  tell_object(ob, BS(
    "Du bestellst Dir "+str+". Aber als Du es Dir so ansiehst, dreht "
    "sich Dein Magen um und Du fluechtest aus der Kueche." ));
  tell_room(ME, BS(
    CAP(ob->name())+" hat sich wohl gerade "+str+" bestellt. Auf einmal wird "+
    ob->QueryPronoun(WER)+" ganz gruen im Gesicht." ),
    ({ ob }) );
  ob->move( ROOM "room_e6", M_GO ,0,
    "rennt angeekelt davon",
    "kommt kreideweiss angelaufen");
  return 0;
}

int menschenkeule (object z, object e) {
  string ename;
  if (z != e) {
    tell_room (ME, break_string("Die Menschenkeule kann man nicht spendieren!",
                                 78,"Beorn sagt: " ));
    return 0;
  }
  ename=CAP(e->name());
  if (check_race(e,"eine Menschenkeule")) {
    tell_object(e, BS(
      "Du sabberst noch kurz bevor Du Dir die kleine Keule in den Magen "
      "stopfst. Hach, tut das nur gut. Du nagst das ganze Fleisch ab und "
      "zerbeisst dann mit einem lauten Krachen den Knochen." ));
    tell_room(ME, BS(
      "Beorn bringt "+ename+" eine Menschenkeule. "+ename+" nagt das "
      "Fleisch ab und zerbeisst dann den Knochen. Es bleibt ueberhaupt "
      "nichts nach." ),
      ({ e }) );
    return 1;
  }
  return 0;
}

int menschenlunge (object z, object e) {
  string ename;
  if (z != e) {
    tell_room (ME, break_string("Die Lunge kann man nicht spendieren!",
                                 78,"Beorn sagt: " ));
    return 0;
  }
  ename=CAP(e->name());
  if (check_race(e,"eine Lunge")) {
    tell_object(e, BS(
      "Beorn geht zu den Haken und schneidet eine wunderschoene Lunge "
      "heraus. Er erwaermt sie kurz und Du laesst sie Dir auf der Zunge "
      "zergehen." ));
    tell_room(ME, BS(
      "Beorn geht zu den Haken und schneidet eine Lunge heraus. "
      "Dann serviert er sie "+ename+" und "+ename+" laesst sie sich auf "
      "der Zunge zergehen." ),
      ({ e }) );
    return 1;
  }
  return 0;
}

int menschenherz (object z, object e) {
  string ename;
  if (z != e) {
    tell_room (ME, break_string("Das Herz kann man nicht spendieren!",
                                 78,"Beorn sagt: " ));
    return 0;
  }
  ename=CAP(e->name());
  if (check_race(e,"ein blutiges Herz")) {
    tell_object(e, BS(
      "Beorn geht zu der Feuerstelle und nimmt eines der vielen Herzen. "
      "Du gierst schon sehr danach und verschlingst es mit einem riesigem "
      "Ruelpser." ));
    tell_room(ME, BS(
      "Beorn geht zu der Feuerstelle und bringt "+ename+" ein blutiges Herz. "+
      ename+" verschlingt es herzhaft und ruelpst zufrieden." ),
      ({ e }) );
    return 1;
  }
  return 0;
}

int menschenblut (object z, object e) {
  string ename;
  if (z != e) {
    tell_room (ME, break_string("Den Becher voll Blut kann man nicht spendieren!",
                                 78,"Beorn sagt: " ));
    return 0;
  }
  ename=e->Name();
  if (check_race(e,"ein Becher voll Blut")) {
    tell_object(e, BS(
      "Beorn nimmt einen Becher und fuellt ihn bis zum Rand mit Blut aus "
      "einem der Ueberreste. Du setzt den Becher an und fuehlst Dich wirklich "
      "erfrischt." ));
    tell_room(ME, BS(
      "Beorn nimmt einen Becher und fuellt ihn bis zum Rand mit Blut aus "
      "einem der Ueberreste. "+ename+" setzt den Becher an und trinkt alles "
      "auf einmal aus." ),
      ({ e }) );
    return 1;
  }
  return 0;
}

int nagfkt(string str)
{
  notify_fail("Woran moechtest Du nagen?\n");
  if ( str != "kante" && str != "an kante" &&
       str != "kanten" && str != "an kanten" ) return 0;

  write(BS(
    "Du konzentrierst Dich auf die Kanten des Tisches und faengst dann an, "
    "wie wild daran herumzunagen. Nach einer Weile hast Du aber irgendwie "
    "keine Lust mehr und hoerst ein wenig verstoert wieder auf."));
  say(BS(
    CAP_TPN+" beugt sich nieder und nagt wie ein Verrueckter an den Kanten "
    "des Tisches herum."));
  return 1;
}
