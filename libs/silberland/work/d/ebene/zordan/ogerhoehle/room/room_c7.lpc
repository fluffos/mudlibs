
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int truhe;

init() {
  ::init();
  if (!present(QUESTITEM,TP) && interactive(TP)) {
    write(BS(
      "Kurz bevor Du die Vorratskammer betreten kannst, reisst Beorn Dich "
      "zurueck und schreit Dich unverstaendlich an. Er will wohl doch nicht, "
      "dass Du jetzt die Kammer betreten darfst."));
    TP->move( ROOM "room_d6" , M_GO | M_NO_SHOW );
  }
}

reset() {
  ::reset();
  truhe=0;
}

create() {
  ::create();

  truhe=0;

  SetProp( P_INT_SHORT, "Eine blutige Vorratskammer" );
  SetProp( P_INT_LONG,
    "Absolut blutig geht es in dieser Vorratskammer zu. Neben einer "
    "Schlachtbank wurden diverse Fleischstuecke aufgestapelt. An den "
    "Waenden sind grosse Haken angebracht und Du stehst mit Deinen "
    "Fuessen in einer grossen Blutlache. In einer Ecke der Kammer steht "
    "ein kleiner Grill. Trotzdem ist es gruselig kalt hier." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "vorratskammer","kammer" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "decke" }),
    "Auch die Decke ist voll mit lauter Blutspritzern.");

  AddDetail( ({ "ecke" }),
    "In einer Ecke steht ein kleiner Grill.");

  AddDetail( ({ "grill" }),
    "Der kleine Grill ist sogar noch warm. Eine kleine Truhe steht direkt "
    "daneben.");

  AddDetail( ({ "fuesse","fuss" }),
    "Deine Fuesse stehen in einer dicken Blutlache.");

  AddDetail( ({ "opfer" }),
    "Du moechtest wahrlich keines sein oder werden.");

  AddDetail( ({ "blutlache","lache","boden" }),
    "Eine grosse Blutlache ist quer ueber den ganzen Boden ausgebreitet.");

  AddDetail( ({ "waende","wand" }),
    "Die Waende sind voll mit lauter Blutspritzern. An einer Wand sind "
    "grosse Haken angebracht worden.");

  AddDetail( ({ "blutspritzer","spritzer","flecken" }),
    "Kleine und grosse rote Flecken sind an den Waenden. Du erkennst sofort, "
    "dass es Menschenblut ist.");

  AddDetail( ({ "blut" }),
    "Blutig trifft die Beschreibung dieser Kammer wohl wirklich. Einfach "
    "alles ist hier blutrot. Das Blut ist ein wenig zaeh, aber noch sehr "
    "frisch.");

  AddDetail( ({ "menschenblut" }),
    "Ja, Menschenblut.");

  AddDetail( ({ "haken" }),
    "Die grossen Haken sind derzeit leer. Normalerweise halten sie aber "
    "wohl ein paar Koerperteile.");

  AddDetail( ({ "schlachtbank","bank" }),
    "Eine total blutverschmierte Schlachtbank aus Holz steht mitten in der Kammer. "
    "Sie ist etwas groesser als der groesste Mensch, den Du bisher gesehen "
    "hast. In Kopfhoehe und im Fussbereich sind kleine Scharniere angebracht. "
    "Ein grosses Schlachtmesser ist in die Schlachtbank geschlagen worden.");

  AddDetail( ({ "schlachtmesser","messer","groesse" }),
    "Ein grosses Schlachtmesser steckt fest in der Schlachtbank. Seine "
    "Groesse laesst Dich erschaudern. Du moechtest es wirklich nicht "
    "kennenlernen.");

  AddDetail( ({ "fleischstuecke","stuecke","groessen" }),
    "Neben der Schlachtbank wurden viele Fleischstuecke aufgestapelt. "
    "Verschiedene Groessen und Koerperteile sind das.");

  AddDetail( ({ "koerperteile","teile" }),
    "Du kannst sie wegen dem vielen Blut nicht mehr identifizieren.");

  AddDetail( ({ "holz" }),
    "Das Holz ist stabil und blutverschmiert.");

  AddDetail( ({ "mensch" }),
    "Wenn Du keiner bist, ist wohl kein lebendiger hier ;)");

  AddDetail( ({ "kopfhoehe","hoehe","fussbereich","bereich" }),
    "Kleine Scharniere sind dort angebracht worden. Man fesselt wohl die "
    "Opfer auf die Schlachtbank.");

  AddDetail( ({ "scharniere","scharnier" }),
    "Die aus Metall bestehenden Scharniere sind wirklich sehr stabil. "
    "Wer hier erstmal liegt, wird wohl kaum wieder entkommen koennen.");

  AddDetail( ({ "metall" }),
    "Blutverschmiertes Metall. Es glaenzt deshalb nicht mehr.");

  AddSpecialDetail( ({ "truhe" }), "truhefkt");

  AddSound( DEFAULT_SOUND,
    "Ein paar Stimmen kommen noch aus der Kueche. Ansonsten ist es hier "
    "sehr still.");
    
  AddSound( ({ "stimmen","kueche" }) ,
    "Du kannst nur noch Bruchteile hoeren.");
    
  AddSound( "bruchteile",
    "uDfg kJzht vCscv dgh.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Blut.");

  AddSmell( "blut",
    "Das Blut riecht sehr frisch. Hier wird wohl haeufig geschlachtet.");

  AddCmd( ({ "oeffne" }),              "oeffnefkt" );
  AddCmd( ({ "nimm","nehm","nehme" }), "nimmfkt" );

  AddSpecialExit( "raus", "rausfkt" );
}

string truhefkt() {
  string str;
  str="Eine kleine stabile Truhe aus blutverschmiertem Holz.\n";
  if (!present(QUESTITEM,TP)) return str;
  if (truhe==0) {
    str+="Sie ist geschlossen.\n";
  } else {
    if (present("\n_grimow_gr_fleisch",TP)) {
      str+="Sie ist geoeffnet und leer.\n";
    } else {
      str+="Sie ist geoeffnet und ein grosses Stueck gegrilltes Fleisch liegt darin.\n";
    }
  }
  return str;
}

int oeffnefkt(string str) {
  if (!present(QUESTITEM,TP)) return 0;
  notify_fail("Was willst Du denn oeffnen?\n");
  if (str != "truhe") return 0;
  if (truhe==0) {
    write(BS("Du oeffnest die Truhe."));
    say(BS(CAP_TPN+" oeffnet die Truhe."));
    truhe=1;
  } else {
    write(BS("Die Truhe ist doch schon offen."));
  }
  return 1;
}

int nimmfkt(string str) {
  if (!present(QUESTITEM,TP)) return 0;
  notify_fail("Was woher nehmen?\n");
  if ((str != "fleisch aus truhe") && (str != "fleisch aus truhe heraus") &&
      (str != "fleisch aus truhe raus")) return 0;
  if (truhe==0) {
    write(BS("Aber die Truhe ist doch zu."));
    return 1;
  }
  if (present("\n_grimow_gr_fleisch",TP)) {
    write(BS("Aber die Truhe ist doch leer."));
    return 1;
  }
  write(BS(
    "Du beugst Dich ueber die Truhe und nimmst das gegrillte Fleisch heraus."));
  say(BS(CAP_TPN+" nimmt ein Stueck Fleisch aus der Truhe."));
  write_file(QUESTLOG "quest.log", 
             dtime(time())+": "+CAP(getuid(TP))+" findet das gegrillte Fleisch.\n" );
  CLONE( "/d/ebene/zordan/grimow/obj/gr-fleisch" , TP);
  return 1;
}

int rausfkt() {
  write(BS(
    "Du rufst nach Beorn. Er kommt an und bringt Dich wieder aus der "
    "Vorratskammer heraus."));
  TP->move( ROOM "room_d6" , M_GO, 0,
    "wird von Beorn hinausgeleitet",
    "kommt mit Beorn an der Seite an");
  return 1;
}
