
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "In einer eingestuerzten Hoehle" );
  SetProp( P_INT_LONG,
    "Dieser Abschnitt der Hoehle ist nahezu komplett eingestuerzt. Ueberall "
    "liegen grosse Felsbrocken herum. Ein paar Spuren fuehren nach Nordwesten. "
    "Dort ist die Hoehle aber komplett zusammengefallen. Den einzigen "
    "Ausweg bildet ein Loch nach Suedosten." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "wand","waende" }),
    "Waende kann man hier eigentlich schon nicht mehr richtig dazu sagen. "
    "Es fehlen auch in den Waenden etliche Stuecke. Im Suedosten klafft "
    "ein grosses Loch.");

  AddDetail( ({ "stuecke","stueck" }),
    "Die liegen jetzt verteilt auf dem Boden.");

  AddDetail( ({ "decke" }),
    "In der Decke gaehnt ein riesiger Krater. Wegen dem ist wohl mal "
    "die Hoehle groesstenteils zusammengefallen.");

  AddDetail( ({ "krater" }),
    "Es ist zu finster da ganz oben. Du kannst nicht viel erkennen.");

  AddDetail( ({ "boden" }),
    "Der Boden ist hier recht aufgewuehlt. Es liegen viele Felsbrocken "
    "herum.");

  AddDetail( ({ "loch" }),
    ([ 0:    "Das Loch ist viel zu gross fuer Dich. Du kannst ganz leicht "
             "einfach so hindurchgehen.",
      "oger":"Das Loch ist genau richtig fuer Dich. Du kannst einfach so "
             "hindurchgehen.",
      "troll":"Du passt so gerade durch das Loch hindurch."]) );

  AddDetail( ({ "teil" }),
    "Aus dem kommst Du sicher.");

  AddDetail( ({ "ausweg","auswege" }),
    "Du kannst leicht nach Suedosten weitergehen.");

  AddDetail( ({ "abschnitt" }),
    "Dieser Abschnitt ist total eingefallen.");

  AddDetail( ({ "hoehle" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "felsbrocken","brocken" }),
    "Riesige Felsbrocken liegen ueberall herum. Besonders grosse versperren "
    "den ehemaligen Weg nach Nordwesten.");

  AddDetail( ({ "weg","weile" }),
    "Den kannst Du an den Spuren auf dem Boden noch erkennen. Allerdings ist "
    "das alles wohl doch schon ne ganze Weile her.");

  AddDetail( ({ "spuren","spur" }),
    "Riesige Fussabdruecke von Ogern sind das.");

  AddDetail( ({ "fussabdruecke","abdruecke","abdruck","fussabdruck" }),
    ([ 0:     "Die Abdruecke sind sehr viel groesser als Deine eigenen.",
       "oger":"Die Abdruecke sind genauso gross wie Deine eigenen.",
       "troll":"Die Abdruecke sind kleiner als Deine eigenen." ]) );

  AddDetail( ({ "oger" }),
    "Derzeit ist wohl keiner da.");

  AddDetail( ({ "einsturz" }),
    "Ist schon gewaltig eingestuerzt hier. Aber man arbeitet wohl daran, "
    "den alten Weg wieder freizulegen.");

  AddDetail( ({ "fels" }),
    "Besonders harter, kaum spaltbarer, Fels ist das.");

  AddDetail( ({ "nordwesten" }),
    "Dort ging wohl mal der Weg weiter. Leider ist es dort total eingestuerzt.");

  AddSound( DEFAULT_SOUND,
    "Hinter dem Einsturz hoert man lautes Klopfen.");
    
  AddSound( ({ "einsturz","klopfen","seite" }),
    "Es hoert sich so an, als ob jemand auf der anderen Seite arbeiten "
    "wuerde.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier einfach nach nichts.");

  AddItem( NPC "arbeiter", REFRESH_DESTRUCT);

SetProp( P_HIDE_EXITS, ({ "oben" }) );
  AddExit( "suedosten", "./room_c4" );
}
