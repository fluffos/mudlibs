
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "In einer kleinen Hoehle" );
  SetProp( P_INT_LONG,
    "Dieser Abschnitt der Hoehle wurde wohl erst vor kurzem freigelegt. Ueberall "
    "liegen noch grosse Felsbrocken herum. Ein paar Spuren fuehren nach "
    "Nordwesten. Auswege finden sich in einem Loch nach Suedwesten, "
    "nach Osten in den bewohnten Teil und nach Nordwesten." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "wand","waende" }),
    "Waende kann man hier eigentlich schon nicht mehr richtig dazu sagen. "
    "Es fehlen auch in den Waenden etliche Stuecke. Im Suedwesten klafft "
    "ein grosses Loch.");

  AddDetail( ({ "stuecke","stueck" }),
    "Die liegen jetzt verteilt auf dem Boden.");

  AddDetail( ({ "decke" }),
    "In der Decke gaehnt ein riesiger Krater. Wegen dem ist wohl mal "
    "die Hoehle groesstenteils zusammengefallen.");

  AddDetail( ({ "krater" }),
    "Es ist zu finster da ganz oben. Du kannst nicht viel erkennen.");

  AddDetail( ({ "boden" }),
    "Der Boden ist hier recht aufgewuehlt. Es liegen viele Felsbrocken "
    "herum.");

  AddDetail( ({ "loch" }),
    ([ 0:    "Das Loch ist viel zu gross fuer Dich. Du kannst ganz leicht "
             "einfach so hindurchgehen.",
      "oger":"Das Loch ist genau richtig fuer Dich. Du kannst einfach so "
             "hindurchgehen.",
      "troll":"Du passt so gerade durch das Loch hindurch."]) );

  AddDetail( ({ "teil" }),
    "Aus dem kommst Du sicher.");

  AddDetail( ({ "osten" }),
    "Im Osten ist der bewohnte Teil der Hoehle.");

  AddDetail( ({ "ausweg","auswege" }),
    "Du kannst leicht nach Nordwesten, Suedwesten und Osten weitergehen.");

  AddDetail( ({ "abschnitt" }),
    "Dieser Abschnitt war einmal total eingefallen.");

  AddDetail( ({ "hoehle" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "felsbrocken","brocken" }),
    "Riesige Felsbrocken liegen ueberall herum. Einige versperren den Weg "
    "nach Nordwesten. Du kannst sie aber leicht ueberqueren.");

  AddDetail( ({ "weg","weile" }),
    "Den kannst Du an den Spuren auf dem Boden noch erkennen. Allerdings ist "
    "das alles wohl doch schon ne ganze Weile her.");

  AddDetail( ({ "spuren","spur" }),
    "Riesige Fussabdruecke von Ogern sind das.");

  AddDetail( ({ "fussabdruecke","abdruecke","abdruck","fussabdruck" }),
    ([ 0:     "Die Abdruecke sind sehr viel groesser als Deine eigenen.",
       "oger":"Die Abdruecke sind genauso gross wie Deine eigenen.",
       "troll":"Die Abdruecke sind kleiner als Deine eigenen." ]) );

  AddDetail( ({ "oger" }),
    "Derzeit ist wohl keiner da.");

  AddDetail( ({ "fels" }),
    "Besonders harter, kaum spaltbarer, Fels ist das.");

  AddDetail( ({ "nordwesten" }),
    "Aus dem Nordwesten kommt ein lautes Klopfen.");

  AddSound( DEFAULT_SOUND,
    "Aus dem Nordwesten hoert man lautes Klopfen.");
    
  AddSound( ({ "einsturz","klopfen" }),
    "Es hoert sich so an, als ob jemand im Nordwesten arbeiten "
    "wuerde.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier einfach nach nichts.");

  AddItem( NPC "oger",   REFRESH_DESTRUCT);
  
  AddExit( "osten",      "./room_d4" );
  AddExit( "suedwesten", "./room_b5" );
  AddExit( "nordwesten", "./room_b3" );
}
