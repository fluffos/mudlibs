
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Vor einem Hoehleneingang" );
  SetProp( P_INT_LONG,
    "Hier im Norden der Lichtung geht es schon ein wenig ruhiger zu. Ein "
    "paar Steine liegen noch auf dem Boden. Die Baeume nehmen allerdings "
    "stetig zu. Im Nordwesten kannst Du einen recht grossen Felsblock "
    "mit einem riesigen Loch darin erkennen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "boden" }),
    "Der Boden ist hier recht festgetrampelt worden. Ein paar Steine liegen "
    "herum.");

  AddDetail( ({ "ruecken","schauer" }),
    "So sehr Du dich auch drehst und wendest. Du kannst ihn nicht sehen.");

  AddDetail( ({ "baeume","baum" }),
    "Die Baeume nehmen ausserhalb der Lichtung in ihrer Anzahl wieder "
    "zu.");

  AddDetail( ({ "anzahl" }),
    "Die ist jedenfalls so gross, dass es auffaellt.");

  AddDetail( ({ "himmel" }),
    "Der Himmel ist ein wenig verdeckt durch die vielen Baeume.");

  AddDetail( ({ "norden" }),
    "Im Sueden liegt wohl die Lichtung.");

  AddDetail( ({ "lichtung" }),
    "Die Lichtung liegt im Sueden. Du kannst sie einfach so betreten.");

  AddDetail( ({ "steine","stein" }),
    "Das sind alles moegliche an Steinen. Kleine, grosse, spitze, stumpfe. "
    "Sie saeumen irgendwie einen kleinen Pfad zu dem Loch.");

  AddDetail( ({ "pfad" }),
    "Der geht vom Sueden her direkt auf das Loch zu.");

  AddDetail( ({ "loch","unten" }),
    "Das Loch sieht aus wie ein Eingang in eine Hoehle.");

  AddDetail( ({ "eingang" }),
    "An dem Eingang selber ist nichts besonders. Vielleicht sollte man "
    "allerdings die Blutspuren am Felsblock erwaehnen.");

  AddDetail( ({ "blutspuren","spuren","spur" }),
    "Frisches Blut klebt an dem Felsblock. Buah.");

  AddDetail( ({ "blut","menschenblut" }),
    "Du untersuchst das Blut genauer und Du bist Dir ziemlich sicher, dass "
    "es Menschenblut ist.");

  AddDetail( ({ "felsblock","block" }),
    "Ein recht grosser Felsblock baut sich im Nordwesten auf. In ihm "
    "gaehnt ein riesiges Loch, dass einen nach Unten bringen wuerde.");

  AddDetail( ({ "nordwesten" }),
    "Im Nordwesten ist ein riesiger Felsblock");

  AddDetail( ({ "fels" }),
    "Ganz normaler und harter Fels ist das.");

  AddDetail( ({ "hoehle" }),
    "Die Hoehle scheint erhellt. Aber von hier aus kannst Du leider noch "
    "gar nichts erkennen.");

  AddSound( DEFAULT_SOUND,
    "Ein seltsames Grunzen kommt aus dem Loch.");
    
  AddSound( ({ "grunzen","loch" }),
    "Ein leises Grunzen schallt aus dem Loch heraus. Dir laeuft ein "
    "Schauer ueber den Ruecken.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier irgendwie schon mehr nach verbranntem Fleisch als "
    "nach Wald.");

  AddSmell( ({ "fleisch","menschenfleisch","fleischgeruch","geruch" }),
    "Tatsaechlich. Das ist verbranntes Fleisch. Menschenfleisch wuerdest "
    "Du tippen.");

  AddSmell( ({ "wald","abwechslung" }),
    "Viel von dem Wald kann man nicht mehr riechen. Aber es ist eine "
    "Abwechslung neben dem Fleischgeruch.");

  SetProp(P_HIDE_EXITS, ({ "nordwesten" }) );

  AddItem( "/d/ebene/lamuerte/wwald/npc/attackoger" ,REFRESH_REMOVE);
  AddItem( "/d/ebene/lamuerte/wwald/npc/attackoger" ,REFRESH_REMOVE);

  AddSpecialExit( "nordwestunten", "nordwestenfkt" );
  AddSpecialExit( "nordwesten",    "nordwestenfkt" );
  AddExit( "sueden",        "/d/ebene/lamuerte/wwald/room/18y_29x" );
}

nordwestenfkt() {
  if (TP->QueryProp(P_GHOST) && TP->QueryProp(P_RACE) != "Oger") {
    write(BS(
      "Als Geist brauchst Du nicht in die Ogerhoehle zu gehen. Die Oger "
      "moegen keine Geister ..."));
    return 1;
  }
  if (TP->QueryGuest()) {
    write(BS(
      "Gaeste haben bei den Ogern wirklich gar nichts zu suchen."));
    return 1;
  }
  TP->move(ROOM "room_e6", M_GO, "", "geht nach Nordwestunten");
  return 1;
}
