
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Ein ziemlich heiliger Ort" );
  SetProp( P_INT_LONG,
    "Du befindest Dich jetzt in der heilige Staette der Oger. Hier kannst "
    "Du nach Deinem Ableben Deine koerperliche Gestalt wieder annehmen. "
    "Im Westen steht ein kleiner Altar. Hunderte von Kerzen auf dem Altar "
    "sorgen fuer eine beruhigendes Licht. Eine kleine Tafel haengt neben "
    "dem Altar an einer Wand. Nach Osten kannst Du diese Staette durch eine "
    "offene Tuer verlassen." );
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 13, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "waage" }),
    "Das ist eine kleine Waage, mit der man zwei Gewichte miteinander "
    "vergleichen kann. Es liegt aber nichts darin. Sie strahlt eine hohe "
    "Heiligkeit aus.");

  AddDetail( ({ "gewichte" }),
    "Du wirst hier keine finden.");

  AddDetail( ({ "schwert","klinge","griff" }),
    "Das Schwert ist reichlich verziert und strahlt eine gewisse "
    "Heiligkeit aus. Seine lange Klinge und sein Griff sind in einem "
    "sehr guten Zustand.");

  AddDetail( ({ "zustand" }),
    "Perfekt wuerde man sagen.");

  AddDetail( ({ "heiligkeit" }),
    "Du spuerst sie deutlich.");

  AddDetail( ({ "beten" }),
    "Hier beten die Oger wohl oefter zu ihrem Gott.");

  AddDetail( ({ "mitte" }),
    "Genau in der Mitte liegt ein grosses Schwert.");

  AddDetail( ({ "boden" }),
    "Der Boden ist sauber und mit kleinen Platten ausgelegt. Direkt "
    "vor dem Altar ist eine Ausbuchtung zu sehen.");

  AddDetail( ({ "ausbuchtung" }),
    "Die Ausbuchtung kommt wohl vom vielen Beten, wenn sich die Oger "
    "vor den Altar knien.");

  AddDetail( ({ "platten","steinplatten","stein" }),
    "Die Platten sind aus Stein und sehr gut gefertigt worden.");

  AddDetail( ({ "decke" }),
    "Sauber herausgehauen wurde auch die Decke. Es sind keine scharfen "
    "Kanten oder so zu sehen. Man pflegt diese Staette wohl wirklich.");

  AddDetail( ({ "kanten" }),
    "Jemand teilt Dir mit: Das naechste mal schicke ich Dich zu Deinem Gott.");

  AddDetail( ({ "wand","waende" }),
    "An einer Wand haengt eine kleine Tafel. Ansonsten sind die Waende "
    "durchaus sauber und gepflegt.");

  AddDetail( ({ "tuer" }),
    "Die Tuer ist aus Holz. Sie steht wohl immer offen.");

  AddDetail( ({ "holz" }),
    "Ganz normales, helles Holz.");

  AddDetail( ({ "altar" }),
    "Ein kleiner Altar aus grob geschmiedetem Eisen steht im Westen. Auf "
    "ihm stehen hunderte kleiner Kerzen. In der Mitte liegt ein grosses "
    "Schwert und daneben eine kleine Waage.");

  AddDetail( ({ "tafel" }),
    "Die Tafel kann man lesen.");

  AddDetail( ({ "licht" }),
    "Es ist hier ein wenig schummrig.");

  AddDetail( ({ "kerzen","kerze" }),
    "Die vielen kleinen Kerzen verbreiten einen beruhigendes Licht in dieser "
    "heiligen Staette.");

  AddDetail( ({ "eisen" }),
    "Ziemlich grobschlaechtig gemachtes Eisen ist das.");

  AddDetail( ({ "staette" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "oger" }),
    "Derzeit ist wohl keiner da.");

  AddDetail( ({ "ableben" }),
    "Das passiert auch leider manchmal.");

  AddDetail( ({ "gestalt" }),
    "Wenn Du Deine koerperliche Gestalt verloren hast, kannst Du sie "
    "vielleicht durch ein kleines Gebet wiedererlangen.");

  AddDetail( ({ "gebet" }),
    "Knie Dich einfach nieder und versuch es. Dein Gott wird schon mit Dir "
    "sein.");

  AddDetail( ({ "gott" }),
    ([ 0:     "Du wirst ja wohl wissen, wer Dein Gott ist.",
       "oger":"Du solltest die Goetter lieber nicht erzuernen." ]) );

  AddReadDetail( ({"heldentafel", "tafel"}), "@@tafelfkt@@");

  AddSound( DEFAULT_SOUND,
    "Hier ist es total still!");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach abgebrannten Kerzen.");

  AddSmell( ({ "kerze","kerzen","wachs" }),
    "Die Kerzen riechen nach verbranntem Wachs.");

  AddExit( "osten", "./room_e5" );

  AddItem("/p/service/obj/zettel/zettelmaschine", REFRESH_REMOVE);
  
  AddCmd( ({"bete","bet"}),"betefkt");
}

int betefkt() {
  write(BS(
    "Du kniest vor dem Altar nieder und haeltst ein kurzes Gebet zu "
    "den Goettern."));
  say(BS(CAP_TPN+" kniet vor dem Altar nieder und haelt ein kurzes Gebet."));
  if (TP->QueryProp(P_GHOST)) {
    write(BS(
      "Eine innere Ruhe kommt in Dir auf. Dein Gebet laesst Dich in eine "
      "tiefe Trance sinken. Deine Gedanken kreisen um Deine letzten "
      "Beutezuege und Schlachten. Auf einmal siehst Du eine Gestalt auf "
      "Dich zukommen. Sie haelt ein grosses Schwert und eine Waage. Diese "
      "Gestalt waegt Deine letzten Taten ab und schlaegt Dich dann mit "
      "einem gewaltigen Hieb zu Boden. Als Du wieder erwachst weilst Du "
      "wieder unter den Lebenden."));
    say(BS(
      "Mit einem gewaltigem Aufschrei nimmt "+TPN+" wieder seine "
      "koerperliche Gestalt an."));
    TP->SetProp(P_GHOST,0);
  }
  return 1;
}

string tafelfkt() {
  TP->more("/etc/topoger.read",1);
  return "";
}

