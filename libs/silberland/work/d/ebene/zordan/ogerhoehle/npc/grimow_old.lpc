
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include "../def.h"

void init() {
  ::init();
  if (TP && TP->id("\noger")) AddDefender(TP);
}

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Grimow, der Anfuehrer der Oger");
  SetProp(P_LONG,
    "Vor Dir steht ein sehr stattlicher Oger. Seine Muskeln scheinen schon "
    "fast zu bersten. Gar niemand wuerde jemals seine Autoritaet anzweifeln. "
    "Durch seine gewaltige Kraft und Staerke gehoert er sicher den "
    "Berserkern an. Seine riesige Axt floesst Dir Angst ein. Ein Kampf mit "
    "ihm geht mit ziemlicher Sicherheit toedlich fuer Dich aus.");
  SetProp(P_NAME, "Grimow");
  SetProp(P_GENDER, MALE);
  AddId( ({"oger", "grimow", "anfuehrer", "\noger", "NOWIMPY"}) );

  set_living_name("grimow");
  enable_commands();

  SetProp(P_FOOD, 0); 
  SetProp(P_WIMPY, 0); 

  create_default_npc(37);
  SetProp(P_HANDS, ({" mit seinen gigantischen Haenden",
                   QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_BODY, 150);
  SetProp(P_XP, QueryProp(P_XP)+1000*100); // Bonus fuer Spells
  SetProp(P_RACE, "Oger");
  SetProp(P_SIZE, 280+random(40));
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:       0.1, DT_COLD:      -0.3, DT_WATER:  -0.5, DT_AIR:     0.0, 
      DT_LIGHTNING: -0.1, DT_EXPLOSION:  0.1, DT_SOUND:  -0.1, DT_LIGHT:  -0.8,
      DT_ELECTRIC:   0.0, DT_ACID:      -0.1, DT_POISON:  0.1, DT_TERROR: -0.8,
      DT_HOLY:       0.1, DT_UNHOLY:    -0.8, DT_MAGIC:  -0.8 ]) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,20);

  SetProp(P_MSGIN, "kommt hungrig an und schreit nach was zu Essen");
  SetProp(P_MSGOUT, "geht in die Kueche was essen");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " kracht toedlich getroffen zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Unsere Rache wird Dich treffen, %s!");
  SetProp(P_KILL_NAME, "Grimow");
  SetProp(P_KILL_MSG, "Und jetzt fress ich Deine Leiche! *HAPS*");

  SetProp(P_LOG_INFO, "ogerhoehle.log");

  AddInfo(DEFAULT_INFO, "sieht es gar nicht ein, einfach so mit Dir zu reden.\n");

  AddLibrary( NPC "oger.lib",1);

  AddInfo("zordan", "Zordan ist Dunkelelf. Mit dem lege ich mich nicht an.",
                    "sagt: ");

  AddInfo( ({"streitaxt","axt"}),
    "Ist sie nicht wunderschoen?",
    "sagt: ");

  AddInfo( ({"magier","magiern"}),
    "Die kommen ja nur noch selten hier bei mir vorbei.",
    "seufzt: ");
    
  AddInfo( ({"gefaess","becher","tasse"}),
    "Frag doch mal bei Orgen nach.",
    "sagt: ");
    
  AddInfo( ({"menschenfleisch"}),
    "Das esse ich fuer mein Leben gern!!! Kannst Du mir nicht welches "
    "besorgen?",
    "fragt: ");
    
  AddInfo( ({"tip"}),
    "Ich geb Dir einen: Verschwinder oder hilf mir.",
    "sagt: ");
    
  AddInfo( ({"messer"}),
    "Messer? Ich kaempfe lieber mit meiner Streitaxt.",
    "sagt: ");
    
  AddInfo( ({"rohes fleisch","rohem fleisch"}),
    "Ich mag mein Fleisch nur roh!",
    "grunzt: ");
    
  AddInfo( ({"futter"}),
    "Magst Du mir nicht was zu Futtern bringen?",
    "sagt: ");
    
  AddInfo( ({"grimow"}),
    "Ja?",
    "fragt: ");
    
  AddInfo( ({"gilde"}),
    "Du bist in der Gilde der Oger.",
    "erklaert stolz: ");
    
  AddInfo( ({"hilfe","aufgabe","problem"}), "@@hilfefkt@@" );

  AddInfo(({ "fertigkeiten","zauber","faehigkeiten", "zaubern"}), 
             "@@gilden_info@@");

  AddInfo( ({"quest"}),
    "Moechtest Du mir helfen gegen meinen Hunger, oder was?",
    "knurrt: ");

  AddInfo( ({"fleisch"}),
    "Menschenfleisch ist mir am liebsten.",
    "knurrt: ");

  AddInfo( ({"essen"}),
    "Ich habe wirklich sehr starken Hunger. Ich denke mal Du kannst das Fleisch "
    "fuer mich bei einem Gefangenen und bei Beorn bekommen. Schau doch einfach "
    "mal dort nach.",
    "knurrt: ");

  AddInfo( ({"gefangenen","gefangene"}),
    "Na wo willst Du sonst rohes Fleisch von einem Menschen herbekommen?",
    "knurrt: ");

  AddInfo( ({"mensch","menschen"}),
    "Menschen schmecken einfach nur vorzueglich.",
    "leckt seine Zunge: ");

  AddInfo( ({"wache","wachen"}),
    "Sie beschuetzen mich und bringen mir immer etwas zum Trinken.",
    "sagt: ");
    
  AddInfo( ({"trinken"}),
    "Na verdursten mag ich ja auch nicht. Ich weiss nicht genau woher meine "
    "Wachen mir immer etwas zum Trinken bringen. Aber ich hoerte mal, wie "
    "sie von Orgen sprachen.",
    "knurrt: ");

  AddInfo( ({"hunger","fuettern","fuetter"}),
    "Ich habe wirklich sehr grossen Hunger. Magst Du mir nicht dagegen Deine "
    "Hilfe anbieten?",
    "knurrt: ");

  AddInfo( ({"hoehlen","hoehle"}),
    "Du kannst alles in unseren Hoehlen finden.",
    "knurrt: ");

  AddInfo( ({"zeit"}),
    "Die Zeit draengt. Wenn Du Dich nicht langsam beeilst, dann werde ich "
    "einfach Dich aufessen.",
    "grinst breit: ");

  AddInfo( ({"magen"}),
    "Mein armer Magen knurrt sehr.",
    "seufzt: ");

  AddInfo( ({"blut"}),
    "Ich mag nur frisches Blut.",
    "knurrt: ");

  AddInfo( ({"wasser"}),
    "Meistens bekomme ich Wasser, ja. Aber es muss nicht sein, reicht aber "
    "vollkommen aus.",
    "knurrt: ");

  AddInfo( ({"quelle"}),
    "Ich glaube Orgen weiss darueber viel mehr als ich.",
    "knurrt: ");

  AddInfo( ({"orgen","haendler"}),
    "Orgen ist der Haendler von uns. Er ist auch fuer etwas zum Trinken "
    "zustaendig.",
    "knurrt: ");

  AddInfo( ({"beorn","koch","lieblingskoch"}),
    "Beorn ist mein Lieblingskoch. Sein gegrilltes Fleisch mag ich am "
    "liebsten.",
    "knurrt: ");

  SetProp(P_GUILD, "berserker");
  SetProp(P_GUILD_LEVEL, 8);

  call_other("/gilden/berserker", "learn_berserker_skills",8000, 8000 );

  ModifySkill("eisenhaut",    10000);
  ModifySkill("eisenhaut",    ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("kampfschrei",  10000);
  ModifySkill("kampfschrei",  ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("willenskraft", 10000);
  ModifySkill("willenskraft", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("rammen",       10000);
  ModifySkill("rammen",       ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("zertreten",    10000);
  ModifySkill("zertreten",    ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("kopfstoss",    10000);
  ModifySkill("kopfstoss",    ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("spalten",      10000);
  ModifySkill("spalten",      ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("augeinauge",   10000);
  ModifySkill("augeinauge",   ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Grimow will das wohl nicht.\n" }) );

  SetProp(P_SPELLRATE,100);

  AddSpell(3,1,
     "","", DT_BLUDGEON, "haut");

  AddSpell(1,400,
    "Grimow zertruemmert Deinen Arm.\n",
    "Grimow zertruemmert @WESSEN Arm.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,500,
    "Grimow reisst ein grosses Stueck aus Deiner Haut.\n",
    "Grimow reisst ein grosses Stueck aus @WESSEN Haut.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Grimow schreit nach Essen.\n",
    "Grimow grunzt Dich an: Verschwinde und stoer mich nicht.\n",
    "Eine der Wachen bringt Grimow etwas zu essen.\n",
    "Grimow kaut auf einem Menschenbein herum.\n",
    "Grimow ruelpst.\n",
    "Grimows Magen knurrt laut auf.\n"}) );
  SetAttackChats(10, ({
    "Grimow schaut Dir tief in die Augen.\n",
    "Grimow schwingt seine Axt.\n",
    "Grimow verwuschelt Deine Haare.\n",
    "Grimow stiert nach Deinem Fleisch.\n",
    "Grimow laesst seine Muskeln anspannen.\n"}) );

  SUID;
  CLONEME( "/p/weapon/axe/streitaxt" );
  command("zuecke streitaxt");

  CLONEME( "/gilden/berserker/obj/stirnband" );
  CLONEME( "/p/armour/armour/plattenpanzer" );
  CLONEME( "/d/ebene/lamuerte/wwald/obj/ogerhelm" );
  if (random(100) > 20) CLONEME( ARMOUR "ogerstiefel" );
  if (random(100) > 80) CLONEME( ARMOUR "fellumhang" );
  command("trage alles");

  AddCmd( "biete","bietefkt" );

}

void die(int poisondeath) {
  object ob;
  
  write_file(LOG "spieler.kills",
    ctime()+": "+CAP(getuid(PL))+" killt den Anfuehrer, Grimow.\n");
  if(ob=present("\nberserker_willenskraft",ME))
    ob->remove();
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "spieler.deads",
      ctime()+": Grimow hat gerade "+CAP(getuid(player))+" umgebracht.\n");
  command_me("iss leiche");
}

// int _query_wimpy() { return 0; }

// Reactions

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
    case "traurig":
      call_out("reaction", 0, TP, 
        "grunzt: Verschwinde Du Wurst.",
        "grunzt: Verschwinde Du Wurst.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "grunzt: Noch einmal und ich toete Dich!",
        "grunzt: Noch einmal und ich toete Dich!");
      break;
    case "nett":
    case "froh":
    case "albern":
    case "intim":
      call_out("reaction", 0, TP,
        "laesst Dich aus seiner Hoehle werfen.",
        "laesst "+TPN+" aus seiner Hoehle werfen.");
      call_out("rauswurf", 2, TP);
      break;
    case "fies":
    case "frech":
      call_out("reaction", 0, TP,
        "wuerdigt Dir keinen Blick.",
        "wuerdigt "+TPN+" keinen Blick.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "interessiert das ueberhaupt nicht.",
        "interessiert das ueberhaupt nicht.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void rauswurf(object ob) {
  if(present(ob,ENV(TO))) 
    ob->move( ROOM "room_d4" , M_GO, 0,
      "wird von den Wachen herausgeworfen",
      "wird von ein paar Ogern hereingeworfen" );
}

void haut(object enemy,int damage, mixed dam_type) {
  mixed h;

  if(!ME->QueryProp(P_TMP_DEFEND_HOOK)) {
    command_me("eisenhaut");
    return;
  }
  if(!present("\nberserker_willenskraft",ME)) {
    command_me("willenskraft");
    return;
  }
  if(!QueryProp(P_PREFERED_ENEMY) ) {
    command_me("augeinauge");
    return;
  }
  if(enemy->QueryProp(P_HP)<((40+random(11))*enemy->QueryProp(P_MAX_HP)/100)) {
    command_me("spalten");
    return;
  }
  switch(100*enemy->QueryProp(P_SIZE)/QueryProp(P_SIZE)) {
    case  0.. 30: command_me("zertreten"); 
                  break;
    case 81..300: if (random(2))  
                    command_me("rammen"); 
                  else 
                    command_me("kopfstoss");
                  break;
    default: if ((random(2)) || (enemy->QueryProp(P_DEAF)))
               command_me("rammen"); 
             else
               command_me("kampfschrei");
             break;
  }
  return;
}

// Questteil

string hilfefkt(string str) {

//  if (!IS_WIZARD(TP)) return 0;

  if(!present(QUESTITEM,TP)) {
    write(break_string(
      "Mein Magen knurrt mal wieder fuerchterlich. Du koenntest mir helfen "
      "und etwas zum Essen und Trinken besorgen gehen. Meine Wachen hier sind "
      "einfach mal wieder zu unfaehig. Wenn Du das wirklich machen moechtest, "
      "dann biete mir Deine Hilfe an.",
      78,"Grimow sagt: "));
    return "knurrt Dich an.";
  }
  write(break_string(
    "Hast Du noch nicht alles gefunden? Du sollst mir doch etwas zum Trinken "
    "und ausreichend Fleisch besorgen. Beeil Dich mal gefaelligst. Mein "
    "Magen knurrt.",
    78,"Grimow sagt: "));
  return "knurrt Dich an.";
}

int bietefkt(string str) {
  object ob;

//  if (!IS_WIZARD(TP)) return 0;

  notify_fail("Moechtest Du vielleicht Deine Hilfe anbieten?\n");
  if (str != "hilfe an" && str != "grimow hilfe an") return 0;
  if(present(QUESTITEM,TP)) {
    write(break_string(
      "Los, beeil Dich gefaelligst. Ich habe Hunger!!!",
      78,"Grimow knurrt: "));
    return 1;
  }
  if(TP->QueryQuest(QUESTNAME)) {
    write(break_string(
      "Du hast mir schon einmal was zu essen gebracht. Einmal reicht, ich "
      "bin jetzt gerade doch recht satt.",
      78,"Grimow knurrt: "));
    return 1;
  }
  write(break_string(
    "Ok, "+CAP_TPN+". Um meinen Hunger einigermassen stillen zu koennen, musst "
    "Du mir etwas zum Trinken, ein rohes Stueck Fleisch und ein gegrilltes "
    "Stueck Fleisch besorgen. Alles sollte in unseren Hoehlen zu organisieren "
    "sein. Am Besten fragst Du einfach mal rum und schaust Dich einfach genauer "
    "in unseren Hoehlen um. Allerdings solltest Du nicht wild herumsuchen, denn "
    "das kostet umsonst Zeit, die mein Magen nicht mehr hat.",
    78,"Grimow knurrt: "));
  CLONE( "/d/ebene/zordan/grimow/obj/grimowquest" , TP);
  write_file(QUESTLOG "quest.log", 
             dtime(time())+": "+CAP(getuid(TP))+" beginnt die Quest.\n" );
  return 1;

  return 1;
}

void give_notify(object was) {
  object ob1,ob2,ob3;
  if ( (!was->id("\n_grimow_gr_fleisch")) &&
       (!was->id("\n_grimow_kl_fleisch")) &&
       (!was->id("\n_grimow_tasse"))) return ::give_notify(was);
  if (!present(QUESTITEM,TP)) {
    write(break_string("Oh danke.",78,"Grimow knurrt: "));
    was->remove();
    return;
  }
  if(!was->id("\n_grimow_gr_fleisch")) {
    ob1=present("\n_grimow_gr_fleisch",TP);
  } else {
    ob1=was;
  }
  if(!was->id("\n_grimow_kl_fleisch")) {
    ob2=present("\n_grimow_kl_fleisch",TP);
  } else {
    ob2=was;
  }
  if(!was->id("\n_grimow_tasse")) {
    ob3=present("\n_grimow_tasse",TP);
  } else {
    ob3=was;
  }
  if ((!objectp(ob1)) || (!objectp(ob2)) || (!objectp(ob3))) {
    write(break_string(
      "Oh sehr gut. Das ist ja schonmal ein Anfang. Aber leider fehlt noch "
      "etwas. Komm wieder wenn Du alles hast."
      ,78,"Grimow knurrt: "));
    return ::give_notify(was);
  }
  if (!ob3->getwasser()) {
    write(break_string(
      "Was soll ich mit einer leeren Tasse?"
      ,78,"Grimow knurrt: "));
    return ::give_notify(was);
  }
  write("Grimow schaut Dich erfreut an und jubelt.\n");
  write("Grimow sagt: Du hast alles besorgt. Super!!!\n");
  write(BS(
    "Du gibst Grimow noch die anderen Sachen. Sofort begibt er sich "
    "daran, die Sachen genuesslich aufzuessen. Er schmatzt laut dabei "
    "und ruelpst wie ein wildes Tier. Das Blut spritzt nur so umher. "
    "Manchmal schaut er auf und blickt Dich erfreut an. Gibt sich dann "
    "aber wieder seinem Fressen hin ..." ));
  switch(TP->GiveQuest(QUESTNAME)) {
    case 1:  write_file(QUESTLOG "quest.log", 
               dtime(time())+": "+CAP(getuid(TP))+" loest die Quest.\n" );
             write_file("/log/quests/grimow",
               dtime(time())+": "+CAP(getuid(TP))+" loest die Quest.\n" );
             break;
    default: write(BS(
               "ACHTUNG: Unbekannter Fehler!! Bitte wende Dich SOFORT an "
               "einen anwesenden Magier!!!"));
             return ::give_notify(was);
             break;
  }
  ob1->remove();
  ob2->remove();
  ob3->remove();
  if(ob1=present(QUESTITEM,TP)) ob1->remove();
  return;
}

string a2s(int abil) {
  switch (abil) {
    case 0..999 : return "hundsmiserabel schlecht";
    case 1000..1499 : return "miserabel";
    case 1500..1999 : return "uebel";
    case 2000..2499 : return "unheimlich schlecht";
    case 2500..2999 : return "sehr schlecht";
    case 3000..3499 : return "schlecht";
    case 3500..3999 : return "maessig";
    case 4000..4499 : return "unterdurchschnittlich";
    case 4500..4999 : return "durchschnittlich";
    case 5000..5499 : return "ueberdurchschnittlich";
    case 5500..5999 : return "befriedigend";
    case 6000..6499 : return "sehr befriedigend";
    case 6500..6999 : return "recht gut";
    case 7000..7499 : return "ganz gut";
    case 7500..7749 : return "gut";
    case 7750..7999 : return "wirklich gut";
    case 8000..8249 : return "sehr gut";
    case 8250..8499 : return "unglaublich gut";
    case 8500..8749 : return "ausserordentlich gut";
    case 8750..8999 : return "phantastisch gut";
    case 9000..9249 : return "ausgezeichnet";
    case 9250..9499 : return "hervorragend";
    case 9500..9749 : return "beinahe meisterhaft";
    case 9750..9899 : return "meisterhaft";
    case 9900..9999 : return "beinahe perfekt";
    default : return "perfekt";
  }
}

string gilden_info() {
  string gilde, info, *spells;
  int abil, i, n;
  closure qsa;
  
  if(!TP->id("Ogerspieler")) {
    return "bruellt: Du bist kein Oger!\n";
  }

  gilde = "/gilden/" + (PL->QueryProp(P_GUILD) || "abenteurer");
  if( gilde!="/gilden/abenteurer" ) 
    return "sagt: Ich kenn mich nur in der Abenteurergilde der Oger aus!\n";
  if (find_object(gilde)) {
    qsa = symbol_function("QuerySkillAbility", PL);
    spells = sort_array(m_indices(gilde->QueryProp(P_GUILD_SKILLS)), #'< );
    n = 0;
    info = "sagt: Hm... mal sehen was Du so kannst ...\n";
    for (i=sizeof(spells)-1, abil=0; i>=0; i--) {
      if (abil=funcall(qsa, spells[i])) {
        info += sprintf("Grimow sagt: Du beherrschst '%s' %s.\n",
                        spells[i], a2s(abil));
        n++;
      }
    }
    if (!n)
      return "sagt: Ohje "+PL->name()+", Du kannst ja kein bisschen zaubern!\n";
    info += sprintf("Grimow sagt: Insgesamt gesehen bist Du aber %s.\n",
                a2s(gilde->GuildRating(PL) * 10000 / gilde->MaxGuildRating()));
    return info;
  }
  else
    return "fragt: In was fuer einer Gilde bist DU denn??\n";
}
