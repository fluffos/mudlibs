
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Spinne");
  SetProp(P_LONG,
    "Diese kleine Spinne krabbelt einfach nur auf dem Boden herum. Ihre kleine "
    "Gestalt macht sie sicher nicht zu einem starken Gegner.");

  SetProp(P_NAME, "Spinne");
  SetProp(P_GENDER, FEMALE);
  AddId(({"spinne"}));

  create_default_npc(2);
  SetProp(P_HANDS, ({" mit ihren kleinen Beinchen",QueryProp(P_HANDS)[1],DT_PIERCE}));
  SetProp(P_RACE, "Spinne");
  SetProp(P_SIZE, 2);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MNPC_AREA, ROOM "park_" );
  SetProp(P_MNPC_WAIT, ({ 15, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "park_f4");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " verschwindet in der Erde.\n");

  AddInfo(DEFAULT_INFO, "kann Dich nicht verstehen.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Spinne kann @WEN nicht tragen.\n" }) );

  if (!random(3))
    CLONEME("/p/std/skills/sewing_tanning/obj/spinnenseide");

}
