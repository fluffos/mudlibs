
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  object geld;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein starker Ladenwaechter");
  SetProp(P_LONG,
    "Vor Dir steht ein ausgewachsener Oger. Er schaut Dich grimmig an und "
    "wird Dir sicher nicht gestatten, auch nur etwas aus dem Lager zu "
    "nehmen. Sein Bauch ist auch nicht sehr gut gefuellt und Du solltest "
    "peinlich darauf achten, ihn nicht zu reizen.");
  SetProp(P_NAME, "Ladenwaechter");
  SetProp(P_GENDER, MALE);
  AddId(({"oger", "ladenwaechter","waechter","\n_waechter", "NOWIMPY",
        "Speerkaempfer", "Keulenkaempfer"}));

  create_default_npc(30+random(6));
  SetProp(P_HANDS, ({" mit seinen starken Haenden",
                     QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Oger");
  SetProp(P_SIZE, 200+random(20));
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,([P_RACE:(["Oger":0.0, 0:1])]) );
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.1, DT_COLD:      -0.1, DT_WATER:  -0.5, DT_AIR:     0.1,
      DT_LIGHTNING: -0.1, DT_EXPLOSION:  0.0, DT_SOUND:   0.0, DT_LIGHT:   0.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.1, DT_POISON: -0.1, DT_TERROR:  0.4,
      DT_HOLY:       0.2, DT_UNHOLY:    -0.2, DT_MAGIC:  -0.4 ]) );

  SetProp(P_MSGIN, "kommt an und bewacht Orgens Sachen");
  SetProp(P_MSGOUT, "geht");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  AddInfo(DEFAULT_INFO, "grummelt Dich nur an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Ladenwaechter will @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,50);
  
  AddSpell(2,300,
    "Der Ladenwaechter fuegt Dir einen schweren Schlag zu.\n",
    "Der Ladenwaechter fuegt @WEM einen schweren Schlag zu.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,400,
    "Der Ladenwaechter beisst Dir mitten ins Gesicht.\n",
    "Der Ladenwaechter beisst @WEM mitten ins Gesicht.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,500,
    "Der Ladenwaechter rammt Dir seine Waffe in den Magen.\n",
    "Der Ladenwaechter rammt @WEM seine Waffe in den Magen.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,800,
    "Der Ladenwaechter zuendet Dich einfach an.\n",
    "Der Ladenwaechter zuendet @WEN einfach an.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Der Ladenwaechter schnauzt Dich an.\n",
    "Der Ladenwaechter rempelt Dir in die Seite.\n",
    "Der Ladenwaechter bruellt: VERSCHWINDE HIER!!!\n"}) );

  SUID;
  if (random(100) > 65) {
    CLONEME( "/d/ebene/lamuerte/wwald/obj/ogerschwert" );
    command("zuecke schwert");
  } else if (random(100) > 50) {
    CLONEME( "/p/weapon/spear/kampfspiess" );
    command("zuecke spiess");
  } else if (random(100) > 60) {
    CLONEME( "/d/ebene/lamuerte/wwald/obj/keule" );
    command("zuecke keule");
  } else {
    CLONEME( "/p/weapon/club/streitkolben" );
    command("zuecke streitkolben");
  }
  if (random(100)>40) CLONEME( "/d/ebene/lamuerte/wwald/obj/ogerhelm" );
  if (random(100)>20) CLONEME( ARMOUR "ogerstiefel" );
  else                CLONEME( "/p/armour/boots/lederstiefel" );
  if (random(100)>60) CLONEME( "/p/armour/trousers/fellhose" );
  if (random(100)>95) CLONEME( ARMOUR "fellumhang" );
  if (random(100)>50) CLONEME( "/p/armour/armour/ringelpanzer" );
  else                CLONEME( "/d/ebene/lamuerte/wwald/obj/ogerpanzer" );

  if (random(100)>40) {
    geld=clone_object("/obj/money");
    geld->SetProp(P_AMOUNT,300+random(200));
    geld->move(TO);
  }
  command("trage alles");
  
  AddCmd( ({ "nimm","nehm","nehme" }) , "killfkt" );
}

void init() {
  ::init();
  if (TP && TP->id("\n_waechter")) AddDefender(TP);
}

void InformDefend(object enemy) {
  Kill(enemy);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "spieler.deads",
      ctime()+": "+CAP(getuid(player))+" wurde von einem Ladenwaechter "
      "getoetet ("+lostexp+").\n");
  command_me("iss leiche");
}

int killfkt(string str) {
  if(!str) return 0;
  if(!present(str,MENV)) return 0;
  Kill(TP);
  write(BS("Der Ladenwaechter bruellt: WAS FAELLT DIR DENN EIN???"));
  write(BS("Der Ladenwaechter greift Dich an."));
  tell_room(MENV,BS(CAP_TPN+" versuchte etwas zu nehmen und muss dafuer "
                            "buessen."), ({ TP }) );
  return 1;
}
