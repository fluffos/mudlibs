void init() {
  ::init();
  if (TP && TP->id("\noger")) AddDefender(TP);
  if (TP && present(QUESTITEM,TP) && !present("\n_grimow_gr_fleisch",TP)) {
    call_out("begintalk",0);
  }
}

void create() {
  if (!is_clone(TO)) return;
  ::create();

  spieler=([ ]);

  SetProp(P_SHORT, "Beorn, der Koch");
  SetProp(P_LONG,
    "Beorn ist eindeutig der Koch in dieser Kueche. An seinen schmierigen "
    "Haenden haengt noch jede Menge Blut. Fuer einen Oger ist er aber "
    "eigentlich recht klein geraten.");
  SetProp(P_NAME, "Beorn");
  SetProp(P_GENDER, MALE);
  AddId( ({"beorn", "\nbeorn", "koch", "oger","\noger" }) );

  set_living_name("beorn");
  enable_commands();

  create_default_npc(18);
  SetProp(P_HANDS, ({" mit seinen blutverschmierten Haenden",
                     QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Oger");
  SetProp(P_SIZE, 220+random(20));
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:     -0.1, DT_COLD:      0.0, DT_WATER: -0.5, DT_AIR:    0.1, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.1, DT_POISON: 0.0, DT_TERROR: 0.3,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  -0.2 ]) );

  SetProp(P_MSGIN, "kommt an und faengt an zu kochen");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " kann erstmal nicht mehr fuer Dich kochen.\n");
  SetProp(P_NOCORPSE, 0 );

  SetProp(P_ARTICLE, 0);
  SetProp(P_FOOD, 0); 

  AddLibrary( NPC "oger.lib",1);

  AddInfo(DEFAULT_INFO, "fragt: Moechtest Du ein Gespraech fuehren?\n");

  AddInfo("zordan", "Zordan hat mich ins Leben gerufen.","grunzt: ");

  AddInfo("gespraech", "@@testquest@@");

  AddInfo( ({"trinken","essen"}),
    "Schau Dir doch mal mein Menue an.",
    "sagt: ");

  AddInfo( ({"menue"}),
    "Tipp einfach so 'Menue' ein bitte.",
    "sagt: ");

  AddInfo( ({"gefaess","tasse"}),
    "Vielleicht weiss Orgen mehr darueber?",
    "fragt: ");

  AddInfo( ({"messer"}),
    "Ich habe sicher keines fuer Dich uebrig. Kauf Dir gefaelligst eines.",
    "sagt: ");

  SetProp(P_LOG_INFO, "zordan/ogerhoehle.log");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Beorn grunzt: Danke.\n" }) );

  SetProp(P_SPELLRATE,20);

  AddSpell(1,200,
    "Beorn schlaegt Dir hart ins Gesicht.\n",
    "Beorn schlaegt @WEM hart ins Gesicht.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,300,
    "Beorn beisst Dir ein Stueck Fleisch heraus und isst es auf.\n",
    "Beorn beisst @WEM ein Stueck Fleisch heraus und isst es auf.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Beorn prueft den Geschmack der gegrillten Menschen.\n",
    "Beorn schaut Dich kurz an.\n",
    "Beorn fragt Dich: Hast Du gar keinen Hunger?\n",
    "Beorn grunzt vor sich hin.\n",
    "Beorn nimmt einen Schluck vom Blut.\n",
    "Beorn schnippelt an einer Leiche herum.\n"}) );
  SetAttackChats(10, ({
    "Beorn bewirft Dich mit Leichenteilen.\n",
    "Beorn tritt Dich.\n",
    "Beorn grunzt laut um Hilfe.\n",
    "Beorn reisst seinen Kiefer weit auf.\n",
    "Beorn grunzt Dich wild an.\n"}) );

  SUID;
  CLONEME( "/p/armour/armour/lederpanzer" );
  CLONEME( "/p/armour/cloak/schuerze" );
  CLONEME( "/d/wasser/stahldorn/outlaw/obj/stief" );
  command("trage alles");

}

void die(int poisondeath) {
  write_file(LOG "spieler.kills",
    ctime()+": "+CAP(getuid(PL))+" killt Beorn.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "spieler.deads",
      ctime()+": Beorn hat gerade "+CAP(getuid(player))+" umgebracht.\n");
  command_me("iss leiche");
}

int _query_wimpy() { return 0; }

void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  if (!random(3)) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "schaut Dich mit einem Sabbern an.",
        "schaut "+TPN+" mit einem Sabbern an.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schaut Dich seltsam an.",
        "schaut "+TPN+" seltsam an.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "grunzt: Lass das oder ich verfuetter Dich.",
        "grunzt: Lass das oder ich verfuetter Dich.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "grunzt: Noch einmal und Du landest im Feuer, "+TPN+"!",
        "grunzt: Noch einmal und Du landest im Feuer, "+TPN+"!");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "grunzt: Das riskierst Du sicher kein zweites Mal, "+TPN+"!",
        "grunzt: Das riskierst Du sicher kein zweites Mal, "+TPN+"!");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich an.",
        "laechelt "+TPN+" an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "schubst Dich weg.",
        "schubst "+TPN+"weg.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "will davon nichts wissen.",
        "will davon nichts wissen.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "grunzt: Na und?",
        "grunzt: Na und?");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        "troestet "+TPN+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

// Questteil

string testquest() {
  if (present(QUESTITEM,TP) && !present("\n_grimow_gr_fleisch",TP)) {
    call_out("begintalk",0);
    return "schaut zu Dir auf.";
  }
  return "sagt: Ich habe zu arbeiten, verschwinde.";
}

void ausgabe(int i) {
  if (i==0) {
    i=spieler[getuid(TP)];
  } else {
    if (!member(spieler,getuid(TP))+1) {
      spieler+=([ getuid(TP):i ]);
    } else {
      spieler[getuid(TP)]=i;
    }
  }
  write("\n");
  write(break_string(fragen[i,0],78,"Beorn sagt: "));
  write("\n");
  write(break_string(fragen[i,1],78,"1.) "));
  write(break_string(fragen[i,2],78,"2.) "));
  write(break_string(fragen[i,3],78,"3.) "));
  write("\n");
  write("0.) Gespraech beenden. 9.) Frage wiederholen.\n");
  write("Bitte Auswahl treffen: ");
}

begintalk() {
  if(present(TP)) {
    ausgabe(1);
    input_to("allcmds");
  } else {
    if (TP) tell_object(TP,
      "Beorn teilt Dir mit: Warum gehst Du so schnell wieder?\n");
  }
}

void allcmds(string str) {
  int was;
  if(!present(TP)) {
    tell_object(TP,
      "Beorn teilt Dir mit: Huch, wo bist Du hin?\n");
    return;
  }
  if(!present(QUESTITEM,TP)) {
    write("Beorn sagt: Hier stimmt was nicht, auf Wiedersehen.\n");
    return;
  }
  if (present("\n_grimow_gr_fleisch",TP)) {
    write("Beorn sagt: Hm, Du hast das Fleisch, komisch.\n");
    return;
  }
  if ( (str != "1") && (str != "2") && (str != "3") && (str != "0") &&
       (str != "9")) {
    write("Bitte 0 (Gespraech beenden), 1-3 oder 9 (Frage wiederholen) auswaehlen.\n");
    input_to("allcmds");
    return;
  }
  if (str == "0") {
    write("Beorn sagt: Ok, bis dann.\n");
    return;
  }
  if (str == "9") {
    ausgabe(0);
    input_to("allcmds");
    return;
  }
  was=fragen[spieler[getuid(TP)],4+to_int(str)];
  if (was == 0) {
    write(break_string(fragen[spieler[getuid(TP)],4],78,"Beorn sagt: "));
    return;
  }
  if (was == 99) {
    write("Beorn sagt: Ok, ich bringe Dich hin.\n");
    write(BS(
      "Beorn fuehrt Dich in seinen Vorratsraum und meint noch Du musst "
      "Dich schon selber umschauen. Dann geht er zurueck in seine Kueche."));
    TP->move( ROOM "room_c7" , M_GO, 0,
      "wird von Beorn weggebracht",
      "wird von Beorn hereingebracht");
    return;
  }
  ausgabe(was);
  input_to("allcmds");
  return;
}
