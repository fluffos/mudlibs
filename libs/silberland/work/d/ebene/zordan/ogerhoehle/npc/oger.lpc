
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>

#include "../def.h"

#define GROESSE ({ "kleiner","normaler","grosser","riesiger" })

int art;

void create() {
  object geld;
  if (!is_clone(TO)) return;
  ::create();

  art=random(sizeof(GROESSE));
  SetProp(P_SHORT, "Ein "+GROESSE[art]+" Oger");
  SetProp(P_LONG,
    "Dieser "+GROESSE[art][0..<2]+" Oger lebt in dieser Hoehle und ist immer "
    "hier, wenn er nicht gerade einen Ueberfall auf die Menschen macht. "
    "Seine grossen Beisser stehen weit hervor.");
  SetProp(P_NAME, "Oger");
  SetProp(P_GENDER, MALE);
  AddId( ({"oger", "\noger"}));

  SetProp(P_FOOD, 0); 

  create_default_npc(11+art*2);
  SetProp(P_HANDS, ({" mit seinen dicken Armen",QueryProp(P_HANDS)[1]+30,DT_BLUDGEON}));
  SetProp(P_RACE, "Oger");
  SetProp(P_SIZE, 200+art*10);
  SetProp(P_ALIGN, -300+art*50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,([P_RACE:(["Oger":0.0, 0:1])]) );

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.1, DT_COLD:      -0.1, DT_WATER:  -0.6, DT_AIR:     0.1,
      DT_LIGHTNING: -0.1, DT_EXPLOSION:  0.0, DT_SOUND:   0.0, DT_LIGHT:   0.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.1, DT_POISON: -0.1, DT_TERROR:  0.4,
      DT_HOLY:       0.2, DT_UNHOLY:    -0.2, DT_MAGIC:  -0.4 ]) );

  SetProp(P_NOMAGIC,0);

  SetProp(P_MNPC_AREA, ROOM "room_");
  SetProp(P_MNPC_WAIT, ({ 2+art*3, 20+art*3, 20+art*3 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "room_e5");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_MSGIN, GROESSE[art]+" Statur kommt herein");
  SetProp(P_MSGOUT, GROESSE[art]+" Statur geht");

  SetProp(P_DIE_MSG,  " faellt toedlich getroffen zu Boden.\n");

  AddInfo(DEFAULT_INFO, "grunzt Dich nur an.\n");

  SetProp(P_LOG_INFO, "zordan/ogerhoehle.log");
  AddLibrary( NPC "oger.lib",1);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Oger behaelt @WEN einfach so.\n" }) );

  SetProp(P_SPELLRATE,40+art*10);

  AddSpell(3,150+art*10,
    "Der Oger reisst Dir das Gesicht auf.\n",
    "Der Oger reisst @WEM das Gesicht auf.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,200+art*10,
    "Der Oger zerfetzt Dich mit seiner Waffe.\n",
    "Der Oger zerfetzt @WEN mit seiner Waffe.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,300+art*50,
    "Der Oger gibt Dir einen harten Kopfstoss.\n",
    "Der Oger gibt @WEM einen harten Kopfstoss.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Der "+GROESSE[art][0..<2]+" Oger sagt: Verschwinde hier!\n",
    "Der "+GROESSE[art][0..<2]+" Oger schaut Dich laessig an.\n",
    "Der "+GROESSE[art][0..<2]+" Oger hat Hunger.\n",
    "Der "+GROESSE[art][0..<2]+" Oger denkt . o O (Ob man den essen kann?)\n",
    "Der "+GROESSE[art][0..<2]+" Oger sagt: Mach hier bloss keinen Aerger.\n",
    "Der "+GROESSE[art][0..<2]+" Oger schaut Dich an und wendet sich ab.\n" }) );

  SetAttackChats(10, ({
    "Der "+GROESSE[art][0..<2]+" Oger tritt Dich sehr unfair.\n",
    "Der "+GROESSE[art][0..<2]+" Oger sagt: Du bist doch kein Gegner fuer uns.\n",
    "Der "+GROESSE[art][0..<2]+" Oger ruft um Hilfe.\n",
    "Der "+GROESSE[art][0..<2]+" Oger sabbert Dich an.\n",
    "Der "+GROESSE[art][0..<2]+" Oger windet sich geschickt in Deinen Ruecken.\n"}) );

  SUID;
  if (random(100) > 65) {
    CLONEME( "/d/ebene/lamuerte/wwald/obj/ogerschwert" );
    command("zuecke schwert");
  } else if (random(100) > 50) {
    CLONEME( "/p/weapon/spear/jagdspeer" );
    command("zuecke speer");
  } else if (random(100) > 50) {
    CLONEME( "/d/ebene/lamuerte/wwald/obj/keule" );
    command("zuecke keule");
  } else {
    CLONEME( "/p/weapon/club/streitkolben" );
    command("zuecke streitkolben");
  }

  if (random(100)>40) CLONEME( "/d/ebene/lamuerte/wwald/obj/ogerhelm" );
  if (random(100)>20) CLONEME( ARMOUR "ogerstiefel" );
  else                CLONEME( "/p/armour/boots/lederstiefel" );
  if (random(100)>60) CLONEME( "/p/armour/trousers/fellhose" );
  if (random(100)>95) CLONEME( ARMOUR "fellumhang" );
  if (random(100)>50) CLONEME( "/p/armour/armour/ringelpanzer" );
  else                CLONEME( "/d/ebene/lamuerte/wwald/obj/ogerpanzer" );

  if (random(100)>80) {
    geld=clone_object("/obj/money");
    geld->SetProp(P_AMOUNT,200+random(100));
    geld->move(TO);
  }

  enable_commands();
  command("trage alles");
}

void init() {
  ::init();
  if (TP && TP->id("\noger")) AddDefender(TP);
  if(find_call_out("get_all")==-1)
    call_out("get_all",0);
}

nosave void get_all() {
  if(ME->InFight()) return;
  if(MENV && file_name(MENV) != "/d/ebene/zordan/ogerhoehle/room/room_b6") {
    if(random(2)) command("nimm waffen");
    else          command("nimm ruestungen");
  }
}

void InformDefend(object enemy) {
  Kill(enemy);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "spieler.deads",
      ctime()+": "+CAP(getuid(player))+" wurde von einem Oger ("+art+") getoetet ("+lostexp+").\n");
  command_me("iss leiche");
}
