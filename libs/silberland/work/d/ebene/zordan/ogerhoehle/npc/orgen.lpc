
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void init() {
  ::init();
  if (TP && TP->id("\noger")) AddDefender(TP);
}

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Orgen, der Haendler");
  SetProp(P_LONG,
    "Das ist Orgen. Ein schmaechtiger Oger, der seinen Lebensunterhalt mit "
    "dem Handeln von Waren verdient. Seine starken Muskeln taeuschen aber "
    "nicht vor einem gefaehrlichen Gegner hinweg. Ansonsten ist er fuer "
    "einen Oger aber eigentlich ganz nett.");
  SetProp(P_NAME, "Orgen");
  SetProp(P_GENDER, MALE);
  AddId( ({"orgen", "\n_orgen", "haendler", "oger","\noger"}));

  set_living_name("orgen");
  enable_commands();

  create_default_npc(23+random(3));
  SetProp(P_HANDS, ({" mit seinen dicken Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_MAX_HP , 500);
  SetProp(P_RACE, "Oger");
  SetProp(P_SIZE, 240+random(20));
  SetProp(P_ALIGN, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.2, DT_COLD:      -0.1, DT_WATER:  -0.5, DT_AIR:    0.1, 
      DT_LIGHTNING: -0.2, DT_EXPLOSION: -0.2, DT_SOUND:  0.0, DT_LIGHT:   0.0,
      DT_ELECTRIC:  -0.2, DT_ACID:      -0.1, DT_POISON: 0.0, DT_TERROR:  0.3,
      DT_HOLY:       0.1, DT_UNHOLY:    -0.1, DT_MAGIC:  -0.1 ]) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC, 0);
  SetProp(P_FOOD, 0); 

  SetProp(P_MSGIN, "kommt an und wuehlt in seinen Waren herum");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " kann Dir erstmal nichts mehr anbieten.\n");
  SetProp(P_NOCORPSE, 0 );

  AddLibrary( NPC "oger.lib",1);

  AddInfo(DEFAULT_INFO, "grunzt Dich nur an.\n");
  AddInfo("zordan", "Zordan ist zum Glueck kein Mensch.","sagt: ");

  AddInfo( ({"ware","waren"}),
    "Ich lager meine Waren in meinem Vorratsraum.",
    "sagt: ");

  AddInfo( ({"messer","holzmesser"}),
    "Vielleicht findest Du ja eines in meinem Angebot?",
    "sagt: ");

  AddInfo( ({"angebot"}),
    "Gibt einfach 'zeige' ein.",
    "sagt: ");

  AddInfo( ({"wasser","trinken"}),
    "In der grossen Hoehle im Nordosten gibt es eine Quelle soweit ich weiss.",
    "sagt: ");

  AddInfo( ({"fleisch","essen"}),
    "Beorn kann Dir da bestimmt viel besser weiterhelfen.",
    "sagt: ");

  AddInfo( ({"quelle"}),
    "Die Quelle ist nicht sehr gross, aber es reicht um uns ausreichend mit "
    "Wasser zu versorgen.",
    "sagt: ");

  AddInfo( ({"gefaess","glas","becher","krug","haeferl"}), "@@gefaess@@");

  AddInfo( ({"tasse"}),   "@@tasse@@");

  SetProp(P_LOG_INFO, "zordan/ogerhoehle.log");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Orgen grunzt: Danke.\n" }) );

  SetProp(P_SPELLRATE,30);

  AddSpell(3,200,
    "Orgen schlaegt besonders hart zu.\n",
    "Orgen schlaegt @WEN besonders hart.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,250,
    "Orgen beisst Dir schmerzhaft in den Arm.\n",
    "Orgen beisst @WEM schmerzhaft in den Arm.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,300,
    "Orgen zerschmettert Deinen Kopf.\n",
    "Orgen zerschmettert @WESSEN Kopf.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));


  SetChats(1, ({
    "Orgen schaut Dich so an, als ob er mit Dir handeln moechte.\n",
    "Orgen fummelt an seiner Kasse herum.\n",
    "Orgen grunzt: Die Geschaefte laufen nicht gerade gut.\n", 
    "Orgen fragt: Moechtest Du nicht was schoenes kaufen?\n",
    "Orgen fragt: Moechtest Du nicht eine schoene Keule kaufen?\n"}) );
  SetAttackChats(10, ({
    "Orgen grunzt Dich wild an.\n",
    "Orgen grunzt: Hau ab Kleiner!\n",
    "Orgen schwingt wild seine Keule.\n",
    "Orgen holt zu einem gewaltigen Schlag aus.\n",
    "Orgen grunzt wild.\n"}) );

  SUID;
  CLONEME( "/d/wasser/stahldorn/knarkh/obj/p_keule.lpc" );
  command( "zuecke keule");

  CLONEME( "/p/armour/armour/eisenpanzer.lpc" );
  if(random(100)>30) CLONEME( "/p/armour/boots/lederschuhe.lpc" );
  if(random(100)>50) CLONEME( "/p/armour/cloak/umhang.lpc" );
  command("trage alles");

}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "spieler.deads",
      ctime()+": Orgen hat gerade "+CAP(getuid(player))+" umgebracht.\n");
  command_me("iss leiche");
}

int _query_wimpy() { return 0; }

// Reactions

void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
    case "aergerlich":
    case "traurig":
      call_out("reaction", 0, TP, 
        "grunzt: Verzieh Dich doch wenn Du Angst hast.",
        "grunzt: Verzieh Dich doch wenn Du Angst hast, "+TPN+".");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "hat nur Mitleid mit Dir.",
        "hat nur Mitleid mit "+TPN+".");
      break;
    case "fies":
    case "frech":
      call_out("reaction", 0, TP,
        "grunzt Dich wild an.",
        "grunzt "+TPN+" wild an.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt.",
        "laechelt.");
      break;
    case "intim":
    case "nett":
      call_out("reaction", 0, TP,
        "tritt Dir zwischen die Beine.",
        "tritt "+TPN+" zwischen die Beine.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "grunzt.",
        "grunzt.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

// fuer die Grimowquest

string gefaess() {
  if (!present(QUESTITEM,TP)) 
    return "sagt: Was willst Du mit einem Gefaess?";
  if (present("\n_grimow_tasse",TP))
    return "sagt: Du hast doch die Tasse von mir schon bekommen.";
  return "sagt: Ich koennte Dir eine Tasse dafuer geben.";
}

string tasse() {
  if (!present(QUESTITEM,TP)) 
    return "sagt: Ich gebe Dir meine Tasse nicht ohne Grund!";
  if (present("\n_grimow_tasse",TP))
    return "sagt: Du hast doch die Tasse von mir schon bekommen.";
  write("Orgen sagt: Ok, hier hast Du eine kleine Tasse.\n");
  CLONE( "/d/ebene/zordan/grimow/obj/tasse" , TP );
  write("Orgen gibt Dir eine kleine Tasse.\n");
  return "schaut "+TPN+" erwartungsvoll an.";
}
