
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

object retter;

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Mensch");
  SetProp(P_LONG, "nix.");
  SetProp(P_NAME, "Mensch");
  SetProp(P_GENDER, MALE);
  AddId(({"mensch"}));

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170+random(20));
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HP, 1);
  SetProp(P_NOMAGIC,100);
  SetProp(P_NOATTACK, "\b\b\b\b\b\b\b\b\b\b\bDu hast letztendlich doch Mitleid.");

  SetProp(P_MSGIN, "wird an den Pranger gefesselt");
  SetProp(P_MSGOUT, "rennt schnell");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " ist endlich erloest.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "ist zu schwach um zu antworten.\n");
  AddInfo("zordan", "wimmert.");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Mensch ist zu schwach um was zu tragen.\n" }) );

  SetChats(1, ({
    "Der Mensch steht in seinen letzten Zuegen.\n",
    "Der Mensch ruehrt sich kein Stueck.\n",
    "Der Mensch stoehnt.\n",
    "Der Pranger knarrt.\n",
    "Der Mensch wimmert.\n"}) );

  AddCmd( ({ "iss","ess","esse" }) ,   "issfkt" );
  AddCmd( ({ "schneid","schneide" }) , "schneidfkt" );
  AddCmd( ({ "befrei","befreie" }) ,   "befreiefkt" );
}

int _query_wimpy() { return 0; }

int issfkt(string str) {
  notify_fail("Was moechtest Du essen?\n");
  if (str != "mensch") return 0;
  if(TP->QueryProp(P_RACE) != "Oger") {
    write(BS(
      "Buah. Du wuerdest den Menschen niemals essen!"));
    return 1;
  }
  write(BS(
    "Du schnappst Dir den Menschen und frisst ihn auf. Er schreit nicht "
    "einmal mehr dabei."));
  tell_room(MENV,BS(
    CAP_TPN+" befreit den Menschen. Dann schnappt er ihn und frisst "
    "ihn gnadenlos auf!") , ({ TP }) );
  TP->heal_self(30+random(30));
  ME->remove();
  return 1;
}

heart_beat() {
  SetProp(P_HP,1);
  ::heart_beat();
}

long() {
  string str;
  str="Dieser Mensch wurde an den Pranger gefesselt. Er sieht nicht mehr sehr "
    "gut aus. Er wird wohl den naechsten Tag nicht mehr ueberleben. Ein Oger "
    "wuerde ihn vielleicht sofort einfach aufessen. ";
  
  if(present(QUESTITEM,TP)) {
    if(!present("\n_grimow_kl_fleisch",TP)) {
      if(present("holzmesser",TP)) {
        str+="Das linke Bein des Menschen ist schon fast abgestorben. Du "
             "ueberlegst, ob Du fuer Grimow davon ein Stueck abschneiden sollst.";
      } else {
        str+="Das linke Bein des Menschen ist schon fast abgestorben. Haettest "
             "Du ein geeignetes Messer oder sowas dabei, koenntest Du Grimow ja "
             "ein Stueck davon mitbringen.";
      }
    } else {
      str+="Ein kleines Stueck Fleisch wurde von seinem Bein abgeschnitten.";
    }
  }
  str=BS(str)+"Er steht auf der Schwelle des Todes.\n";
  return str;
}

// fuer die grimowquest

int schneidfkt(string str) {
  if(!present(QUESTITEM,TP)) return 0;
  notify_fail("Was moechtest Du abschneiden?\n");
  if ((str != "fleisch ab") && (str != "stueck ab") &&
      (str != "stueck fleisch ab")) return 0;
  if(present("\n_grimow_kl_fleisch",TP)) {
    write(BS(
      "Du hast Dir doch schon ein schoenes Stueck herausgeschnitten. Ein "
      "weiteres brauchst Du sicher nicht."));
    return 1;
  }
  if (!present("messer",TP)) {
    write(BS(
      "Ohne Messer oder aehnliches wird das sicher nichts."));
    return 1;
  }
  if (!present("holzmesser",TP)) {
    write(BS(
      "Du hast zwar ein Messer dabei. Aber es scheint nicht so recht "
      "geeignet zu sein. Du wuerdest damit das Stueck Fleisch zerstoeren."));
    return 1;
  }
  write(BS(
    "Du nimmst das Holzmesser in die Hand und faengst an dem Menschen ein "
    "Stueck seines Fleisches aus dem Bein herauszuschneiden. Erst zoegerst "
    "Du ein wenig. Aber dann stichelst Du munter los. Blut spritzt massenweise "
    "umher. Aber der Mensch schaut Dich einfach nur an. Er hat wohl eh schon "
    "mit seinem Leben abgeschlossen. Mehr oder weniger zufrieden steckst Du "
    "das Stueck Fleisch ein."));
  say(BS(
    CAP_TPN+" nimmt ein Messer und schneidet dem Menschen ein Stueck Fleisch "
    "heraus."), ({ TP }) );
  write_file(QUESTLOG "quest.log", 
             dtime(time())+": "+CAP(getuid(TP))+" findet das rohe Fleisch.\n" );
  CLONE( "/d/ebene/zordan/grimow/obj/kl-fleisch" , TP );
  return 1;
}


// fuer die Paladine - Gildenaufgabe

int befreiefkt(string str) {
  object item;
  notify_fail("Wen oder was moechtest Du befreien?\n");
  if (str != "mensch") return 0;
  if((!item=present("\npaladintaskitem", TP)) || !item->GetTask(9, TP)) {
    write(BS(
      "Du versuchst mit allen Dir zur Verfuegung stehenden Mitteln den "
      "Menschen zu befreien. Doch nach einer Weile musst Du doch feststellen, "
      "dass Du ihn dabei sofort toeten wuerdest. Deshalb laesst Du dann von "
      "ihm ab."));
    return 1;
  }
  write(BS(
    "Ganz vorsichtig loest Du die Fesseln des Menschen. Es dauert zwar eine "
    "Weile ihn dabei nicht zu toeten, aber letztendlich schaffst Du es."));
  write(BS(
    "Der Mensch sagt: VIELEN DANK! Ich werde Dir folgen, geh Du vor!"));
  RemoveCmd("befrei");
  RemoveCmd("befreie");
  RemoveCmd("schneid");
  RemoveCmd("schneide");
  retter=TP;
  SetProp(P_MSGIN, "kommt erschoepft herein");
  TP->AddPursuer(ME);
  return 1;
}

init() {
  string name;
  object item;
  ::init();
  if (objectp(retter) && TP && TP->QueryProp(P_RACE)=="Oger" && 
      !interactive(TP)) {
    retter->RemovePursuer(ME);
    call_out("frissoger",0);
    return;
  }
  if (objectp(retter) && MENV) {
    if (!present(retter,MENV)) {
      retter->RemovePursuer(ME);
      call_out("remove_me",0);
      return;
    }
    if (!interactive(retter)) {
      retter->RemovePursuer(ME);
      call_out("remove_me",0);
      return;
    }
    if (find_netdead(retter)) {
      retter->RemovePursuer(ME);
      call_out("remove_me",0);
      return;
    }
    if((!item=present("\npaladintaskitem", retter)) || 
        !item->GetTask(9, retter)) {
      retter->RemovePursuer(ME);
      call_out("remove_me",0);
      return;
    }
    name=file_name(MENV);
    if ((name == "/room/death/death_room") ||
        (name == "/room/netztot")) {
      call_out("remove_me",0);
      return;
    }
    if ((name == "/d/ebene/lamuerte/wwald/room/17y_28x") ||
        (name == "/d/ebene/lamuerte/wwald/room/19y_31x")) {
      tell_room(MENV,BS("Der Mensch jubelt."));
      tell_room(MENV,BS(
        "Der Mensch sagt: Danke "+retter->Name(WER)+"! Du hast "
        "mein Leben gerettet!"));
      SetProp(P_MSGIN, 
        "betet kurz zu Dusty und laeuft hoch erfreut davon");
      item->SetFlag(0);
      if (objectp(retter)) retter->RemovePursuer(ME);
      call_out("remove",0);
      return;
    }
  }
}

remove_me() {
  if (MENV) {
    tell_room(MENV,BS("Der Mensch bricht tot zusammen."));
  }
  ME->remove();
}

remove() {
  if (objectp(retter)) retter->RemovePursuer(ME);
  ::remove();
}

frissoger() {
  TP->command_me("iss mensch");
}
