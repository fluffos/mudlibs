/*
** Weg im Silberwald
**
** 1996-04-08 (Woody) 1.0  Initial Version
** 1996-06-18 (Woody) 1.1  ::reset() aufrufen
** 1996-11-23 (Woody) 1.2  'suedwesten' angeschlossen
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../silberwald.h"

#define PFEIFLOG "/d/ebene/log/pfeif.log"

object *pl;

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Im Flachland");
  SetProp (P_INT_LONG, bs(
    "Eine sanfte, flache Landschaft erstreckt sich hier, nur im Norden "+
    "steigt der Weg merkbar an. Im Sueden kannst Du eine weite Wiese "+
    "erkennen. Sanftes Vogelgezwitscher dringt an Dein Ohr, noch merkt "+
    "man nichts von der Geschaeftigkeit der nahen Stadt. Ruhe und Frieden "+
    "scheint hier zu herrschen, nur eine leichte Windboe, die ab und zu "+
    "durch die Graeser streicht, sorgt fuer ein wenig Bewegung. Ein "+
    "kleiner Wegweiser ist hier aufgestellt."));

  AddDetail ("wegweiser", "Hmmm, lies doch mal!\n");
  AddReadDetail ("wegweiser",
    "\n   ,----------------------------------------.\n"+
      "  /   Suedwesten: Fischerdorf, Pier, Knarkh  \\\n"+
      " (  Norden: Gebirge, Huegelland, Feenschloss  )\n"+
      "  )    Suedosten: Midas, Feldlager, Steppe   / \n"+
      "  `-------------------.    ,----------------'\n"+
      "                      |    |\n\n");

  AddDetail (({"himmel","sonne"}), "Strahlend blauer Himmel ueber Dir, "+
    "und mitten in ihm die helle Sonne.\n");
  AddDetail (({"pfad","weg","boden"}), "Du befindest Dich auf ihm. "+
    "Er wirkt bereits etwas ausgetrampelt.\n");
  AddDetail ("wiese", bs("Weiter suedlich kannst Du eine weite Wiese "+
    "ausmachen, die Du aber wegen einer Abzaeunung nicht erreichen "+
    "kannst."));
  AddDetail (({"land","landschaft"}), bs("Die Landschaft ist vorwiegend "+
    "flach und gruen. Nur nach Norden hin steigt sie deutlich an."));
  AddDetail ("stadt", "Die Stadt liegt weiter im Osten.\n");
  AddDetail ("wald", "Du koenntest versuchen, auf einem der Pfade zu ihm "+
    "zu gelangen.\n");
  AddDetail (({"ohr","ohren"}), "Du wackelst mit den Ohren und stellst "+
    "fest, dass noch beide dran sind.\n");
  AddDetail (({"ruhe","frieden"}), "Ja, dieser Ort hier vermittelt Ruhe "+
    "und Frieden.\n");
  AddDetail (({"windboe","wind","boe"}), bs("Ab und an streicht der "+
    "Wind ueber die Graeser, um wenigstens ein bisschen Bewegung in diesen "+
    "sonst so ruhigen Ort zu bringen."));
  AddDetail ("bewegung", "Ausser Dir bewegt sich hier nur der Wind.\n");
  AddDetail ("ort", "Ein ruhiger, friedlicher und stiller Ort. Nicht "+
    "Oertchen, wohlgemerkt.\n");
  AddDetail ("oertchen", bs(
    "Ein Oertchen ist auch meist ruhig, friedlich und still, aber irgendwie "+
    "doch etwas ganz anderes, als dieses idyllische Stueckchen Land hier."));
  AddDetail ("stueckchen", "Mehr als Nichts, aber weniger als ein Stueck.\n");
  AddDetail ("stueck", "Mehr als ein Stueckchen.\n");
  AddDetail ("nichts", "Mach mal \"finger nichts@morgengrauen\" :-)\n");
  AddDetail ("graeser", "Sie beugen sich nur der sanften Gewalt "+
    "des Windes.\n");
  AddDetail ("gewalt", "Bitte nicht hier.\n");
  AddDetail (({"vogelgezwitscher","gezwitscher"}),
    "Wie waers mit Lauschen?\n");

  AddSound (DEFAULT_SOUND, "Wem oder was willst Du lauschen?\n");
  AddSound (({"vogelgezwitscher","gezwitscher"}),
    "Sanftes, froehliches Vogelgezwitscher. Am liebsten wuerdest Du "+
    "mitpfeifen.\n");

  AddItem (EBENE("woody/npc/gaffo"), REFRESH_DESTRUCT);

  AddCmd (({"pfeif","pfeife"}), "pfeif");

  AddExit("norden",ROOM("room_i10"));
  AddExit("suedosten",ROOM("room_j12"));
  AddExit("suedwesten",ROOM("room_h12"));

  pl = ({ });
}

pfeif(str)
{
  if (!stringp(str) || str=="")
  {
    write ("Was willst Du denn pfeifen?\n");
    return 1;
  }
  switch (str)
  {
    case "lied": case "ein lied":
      write ("Gute Idee! Bloss was fuer eines?\n");
      return 1;
    case "mit":
      write (bs("Du wuerdest gerne mit den Voeglein mitzwitschern, doch "+
        "leider fehlt Dir dazu das Talent. Stattdessen koenntest Du es ja "+
        "mit einem Lied versuchen..."));
      return 1;
    case "alle voegel sind schon da":
    case "alle voeglein sind schon da":
      if (member_array(TP, pl) == -1)
      {
        pl += ({ TP });
        write_file (PFEIFLOG, sprintf ("%s pfeift: '%s'\n", TPN, str));
      }
      if (!(TP->FindPotion(
       "\nDu pfeifst vergnuegt 'Alle Voeglein sind scho-hon da'.\n"+bs(
       "Begeistert fliegen eine Voeglein auf und zwitschern aufgeregt rum, "+
       "unter ihnen auch eine diebische Elster, die vor lauter Begeisterung "+
       "ein kleines Flaeschchen fallen laesst.")+
       "\nDu trinkst es ohne lang zu ueberlegen mit einem Schluck aus.\n\n")))
        write (
          "Du pfeifst vergnuegt 'Alle Voeglein sind scho-hon da'.\nDie "+
          "Voegel zwitschern begeistert mit, aber sonst passiert nichts.\n");
      say (TPN+" pfeift vergnuegt ein Liedchen.\n");
      return 1;
    default:
      write_file (PFEIFLOG, sprintf ("%s pfeift: '%s'\n", TPN, str));
      write ("Du pfeifst: '"+str+"', aber nichts passiert.\n");
      say (TPN+" pfeift: '"+str+"', aber nichts passiert.\n");
      return 1;
  }
}

reset()
{
  pl = ({ });
  ::reset();
}
