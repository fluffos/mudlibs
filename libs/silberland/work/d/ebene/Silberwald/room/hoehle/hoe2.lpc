/*
** Hoehle
** ---
** 1996-04-10  (Woody) 1.0  Release
** 1996-04-12  Dusty - ein Baerli kommt hinzu
** 1998-01-01  Hoehle erweitert (/hoehle)
** 2000-11-20  Honigtopf (Miniquest fuer Teddy) hier findbar (v. Dante)
** 2001-04-10  Bugfix, zusaetzlich Toepfe pro Spieler limitiert
** 2001-08-06  max. 12 (statt 6) Toepfe insgesamt
**
*/

inherit "std/room";

#define TOEPFE (10 + random(3))
#define FIND_INTERVAL (600+random(300))         // 10 bis 15 Minuten

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../../silberwald.h"

int topf=TOEPFE;
mapping darf;

void create()
{
  ::create();
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:11]));
  SetProp (P_INT_SHORT, "In einer Hoehle");
  SetProp (P_INT_LONG, bs(
    "Mutig tastest Du Dich weiter in die dunkle Hoehle vor, Dein Atem "+
    "stockt, und Du ueberlegst, ob Du noch weitergehen oder nicht lieber "+
    "doch umkehren sollst, zuviel Ungewisses koennte hinter dem naechsten "+
    "Felsspalt auf Dich warten."));

  AddDetail( ({ "spalt", "felsspalt" }),
      "Was Dich wohl dort erwartet?");
  AddDetail( ({ "schicksal" }),
      "Schicksal ist es, wenn man hier weitergeht und von dem Baeren "
      "gefressen wird.\n");
  AddDetail( ({ "ungewisses" }),
      "Ungewisses Schicksal erwartet Dich, wenn Du hier weitergehst.");
  AddDetail( ({ "thema" }),
      "Das ist kein gutes Thema... Konzentrier Dich lieber auf den Baeren.");
  AddDetail( ({ "atem" }),
      "Dein Atem stockt... ausserdem riecht es hier extrem nach Baer... "
      "wo wir grad beim Thema Atmen sind.");
  AddDetail ("hoehle", "Du stehst mitten in der dunklen Hoehle.\n");
  AddDetail ("wohnstaette",
      "Diese dunkle Hoehle bildet sicher die Wohnstaette fuer einen "
      "grimmigen Baeren, den man besser nicht in seiner Ruhe stoeren "
      "sollte.");
  AddDetail ("ruhe", "Ruhe ist etwas, was der Baer hier gerne haette.\n");
  AddDetail ("entsetzen", "Es kennt keine Grenzen.\n");
  AddDetail ("boden",
      "Der Boden besteht aus fester Erde. "
      "Einige Knochen verteilen sich ueber ihn.");
  AddDetail ("knochen",
      "Du betrachtest die Knochen genauer und bemerkst ploetzlich "
      "einen kleinen Schimmer.");
  AddSpecialDetail("schimmer", "d_schimmer");   // Miniquest f. Teddy...
  AddDetail ("erde", "Feste, dunkle Erde.\n");
  AddDetail (({"baer", "braunbaer"}), "Er ist wohl gerade nicht da.\n");
  AddDetail (({"wand","waende"}), "Die Waende der Hoehle bestehen aus "+
    "grauem, kalten Fels.\n");
  AddDetail ("decke", "Die Decke ist felsig, wie die Waende.\n");
  AddDetail ("fels", "Er ist grau und kalt.\n");
  AddDetail ("ende", "Das ist ein Befehl. Du kannst ihn eingeben.\n");
  AddSmell (({DEFAULT_SMELL, "baer"}), "Es riecht nach Baer.\n");

  AddExit("nordwesten", "./hoe1");
  AddExit("osten", "./hoe3");

  darf = ([]);
}


string d_schimmer()
{
  object honig;

  // Entweder kein Topf mehr da, oder Spieler hat schon.
  if ( !topf || deep_present("\nhonigtopf",TP) || (time() < darf[getuid(TP)]) )
  {
    return "Du scheinst Dich getaeuscht zu haben. Da ist nichts.\n";
  }

  // Steht einer im Raum rum?
  if (present("\nhonigtopf",ME)) {
    return "Da steht ja ein Honigtopf direkt vor Deiner Nase!\n";
  }

  // Honigtopf clonen.
  topf--;
  darf[getuid(TP)] = time() + FIND_INTERVAL;
  honig = clone_object(OBJ("div/honigtopf"));
  write("Du entdeckst zwischen den Knochen einen leckeren Topf "
        "voll mit Honig!\n");

  // zu schwer?
  if (honig->move(TP,M_GET) < 1)
  {
    honig->move(ME,M_NOCHECK);
    return "Tragen kannst Du ihn allerdings nicht mehr, "
           "Du bist schon viel zu beladen!\n";
  }

  // Gefunden und genommen!
  Message(TP->Name() + " findet einen kleinen Topf und nimmt ihn an sich.\n",
      MSGFLAG_VISUAL | MSGFLAG_NO_TP);
  return "Schnell nimmst Du ihn an Dich.\n";
}

void reset()
{
  ::reset();
  if (topf<4)
    topf += TOEPFE;
}

