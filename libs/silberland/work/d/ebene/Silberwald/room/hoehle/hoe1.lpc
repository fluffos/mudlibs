/*
** Hoehle
** ---
** 1996-04-10 (Woody) 1.0  Release
** 1996-04-12 Dusty - ein Baerli kommt hinzu
** 1998-01-01 Dusty - Hoehle erweitert, Baerli verschoben
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../../silberwald.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:12]));
  SetProp (P_INT_SHORT, "In einer Hoehle");
  SetProp (P_INT_LONG, bs(
    "Du befindest Dich in einer dunklen Hoehle, offensichtlich die Wohn"+
    "staette eines Baeren. Es ist hier merklich kuehler, ein Luftzug jagt "+
    "Dir einen kalten Schauer ueber den Ruecken. Am erdigen Boden entdeckst "+
    "Du zu Deinem Entsetzen einige Knochengerippe, offensichtlich haben "+
    "einige Abenteurer beim Versuch, diese Hoehle zu erforschen, hier ihr "+
    "Ende gefunden. Ob es gesund ist, hier weiterzugehen?"));

  AddDetail ("hoehle", "Du stehst mitten in der dunklen Hoehle.\n");
  AddDetail ("wohnstaette", bs("Diese dunkle Hoehle bildet die Wohnstaette "+
    "fuer einen grimmigen Baeren, den man besser nicht in seiner Ruhe "+
    "stoeren sollte."));
  AddDetail ("ruhe", "Ruhe ist etwas, was der Baer hier gerne haette.\n");
  AddDetail ("entsetzen", "Es kennt keine Grenzen.\n");
  AddDetail ("boden", "Der Boden besteht aus fester Erde. Einige Knochen "+
    "verteilen sich ueber ihn.\n");
  AddDetail ("erde", "Feste, dunkle Erde.\n");
  AddDetail (({"knochen","gerippe","knochengerippe"}),
    "Das passiert mit Abenteurern, wenn sie zu wagemutig sind.\n");
  AddDetail (({"wald", "silberwald"}), "Der Wald befindet sich "+
    "ausserhalb der Hoehle.\n");
  AddDetail (({"baer", "braunbaer"}), "Er ist wohl gerade nicht da.\n");
  AddDetail ("abenteurer", "Du siehst nur noch ihre sterblichen "+
    "Ueberreste.\n");
  AddDetail ("ueberreste", "Die Ueberreste bestehen aus ein paar "+
    "Knochen, die wahllos ueber den Boden\nverteilt sind.\n");
  AddDetail ("luftzug", "Ein kalter Luftzug laesst Dich erschauern.\n");
  AddDetail (({"wand","waende"}), "Die Waende der Hoehle bestehen aus "+
    "grauem, kalten Fels.\n");
  AddDetail ("decke", "Die Decke ist felsig, wie die Waende.\n");
  AddDetail ("fels", "Er ist grau und kalt.\n");
  AddDetail ("ende", "Das ist ein Befehl. Du kannst ihn eingeben.\n");

  AddExit("raus", ROOM("room_b05"));
  AddExit("suedosten", "./hoe2");       // == c05
}

