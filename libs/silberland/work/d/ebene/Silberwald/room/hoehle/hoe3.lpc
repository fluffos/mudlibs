/*
** Hoehle
** ---
** 1996-04-10 (Woody) 1.0  Release
** 1996-04-12 Dusty - ein Baerli kommt hinzu
** 1998-01-01 Dusty - die Hoehle wird groesser
** 1999-02-22 Stahldorn - Hab den Papabaer wieder reingetan :)
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../../silberwald.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:12]));
  SetProp (P_INT_SHORT, "In einer Hoehle");
  SetProp (P_INT_LONG, bs(
   "Du stehst hier noch immer in der Hoehle. Vor Dir befindet sich das " 
   "Lager eines kleinen Baeren. Sieht so aus, als ob der Baer schon alt "
   "genug waere, um sein eigenes Nest zu besitzen. Obwohl er sicher "
   "noch nicht ausgewachsen ist, liegen trotz allem furchterregende "
   "Ueberreste von Humanoiden herum."));

  AddDetail( ({ "humanoide" }), 
                break_string( "Hm.... Humanoide sind zum Beispiel Menschen, "+
                "Elfen, Zwerge und Hobbits.", 78 ) );
  AddDetail( ({ "menschen", "elfen", "zwerge", 
                "hobbits" }), 
                break_string( "Alle diese sind Humanoide", 78 ) );
  AddDetail( ({ "zwergenknochen" }), 
                break_string( "Zwergenknochen sind etwas groesser als "+
                "Hobbitknochen, und sind auch ziemlich stabil, sie brechen "+
                "also nicht so leicht wie Menschenknochen.", 78 ) );
  AddDetail( ({ "hobbitknochen" }), 
                break_string( "Hobbitknochen sind sogar noch kleiner und "+
                "kuerzer als Zwergenknochen.", 78 ) );
  AddDetail( ({ "elfenknochen" }), 
                break_string( "Elfenknochen sind wie Menschenknochen, aber "+
                "noch ein bisschen instabiler... (zumindest sieht es so "+
                "aus...)", 78 ) );
  AddDetail( ({ "menschenknochen" }), 
                break_string( "Menschenknochen sind aehnlich wie "+
                "Elfenknochen. Lang, instabil, und meistens ohne viel dran.", 78 ) );
  AddDetail( ({ "knochen" }), 
                break_string( "Knochen von allen moeglichen Wesen.... neben "+
                "Tierknochen auch Menschen-, Elfen-, Zwergen-, und "+
                "Hobbitknochen.", 78 ) );
  AddDetail( ({ "ordnungssinn" }), 
                break_string( "Dieser Babybaer scheint ihn zu besitzen.", 78 ) );
  AddDetail( ({ "ueberreste", "reste" }), 
                break_string( "Die Ueberreste bestehen aus einigen Knochen, "+
                "die ordentlich (besitzt ein Babybaer etwa Ordnungssinn?) "+
                "ueber den Boden verteilt sind.", 78 ) );
  AddDetail( ({ "tier" }), 
                break_string( "Tiere gibt es viele. Was Dich jetzt "+
                "interessiert, sind Baeren.", 78 ) );
  AddDetail( ({ "fellreste" }), 
                break_string( "Das sind Fellreste... kommen wohl von einem "+
                "nicht vorsichtigen Hobbit oder einem anderen wilden Tier.", 78 ) );
  AddDetail( ({ "eltern" }), 
                break_string( "Mamabaer und Papabaer.", 78 ) );
  AddDetail( ({ "menschenkind" }), 
                break_string( "Ein Menschenkind wird meistens sehr gut von "+
                "seinen Eltern behuetet... oft sogar mehr als es will.", 78 ) );
  AddDetail( ({ "geschichte" }), 
                break_string( "Hmm.... Frag mal ein Menschenkind, das kann "+
                "Dir sicher sagen, wer Pezibaer ist.", 78 ) );
  AddDetail( ({ "pezibaer" }), 
                break_string( "Daaaaaaaas ist eine ganz andere Geschichte!", 78 ) );
  AddDetail( ({ "mamabaer", "vaterbaer", "babybaer" }), 
                break_string( "Das sind meistens die Mitglieder einer "+
                "Baerenfamilie.", 78 ) );
  AddDetail( ({ "vater", "mutter", "kind" }), 
                break_string( "Das sind eher Mitglieder einer humanoiden "+
                "Familie.", 78 ) );
  AddDetail( ({ "familienmitglied", "mitglied" }), 
                break_string( "Vater, Mutter, Kind? Mamabaer, Vaterbaer, "+
                "Pezibaer... aeh Babybaer.", 78 ) );
  AddDetail( ({ "familie", "familien" }), 
                break_string( "Baerenfamilien leben in engem Verband bis das "+
                "Junge ausgewachsen ist. Es besteht also gewisses Risiko "+
                "darin, ein Familienmitglied anzugreifen.", 78 ) );
  AddDetail( ({ "haare", "haar" }), 
                break_string( "Die Haare schauen definitiv so aus, als ob "+
                "sie entweder von Menschen, Elfen, Zwergen oder Hobbits "+
                "kaemen.", 78 ) );
  AddDetail( ({ "stroh" }), 
                break_string( "Das Stroh liegt einladend auf dem Boden "+
                "herum. Wenn Du Dich nicht vor der Familie des kleinen Baeren "+
                "fuerchten wuerdest, wuerdest Du es direkt ausprobieren, Dich "+
                "hinzulegen.", 78 ) );
  AddDetail( ({ "lager", "nest" }), 
                break_string( "Das Lager des Baeren besteht aus Stroh, "+
                "Haaren (von wem die wohl kommen?) und Fellresten.", 78 ) );
  AddDetail ("hoehle", "Du stehst in der dunklen Hoehle.\n");
  AddDetail ("entsetzen", "Es kennt keine Grenzen.\n");
  AddDetail ("boden", "Der Boden besteht aus fester Erde. Ein Lager aus "
    "Stroh liegt direkt vor Dir. Einige Knochen verteilen sich ueber den "
    "Boden.\n");
  AddDetail ("erde", "Feste, dunkle Erde.\n");
  AddDetail (({"wald", "silberwald"}), "Der Wald befindet sich "+
    "ausserhalb der Hoehle.\n");
  AddDetail (({"wand","waende"}), "Die Waende der Hoehle bestehen aus "+
    "grauem, kalten Fels.\n");
  AddDetail ("decke", "Die Decke ist felsig, wie die Waende.\n");
  AddDetail ("fels", "Er ist grau und kalt.\n");

  AddExit("westen", "./hoe2");

  AddItem (NPC("babybaer"), REFRESH_DESTRUCT);
  AddItem (NPC("braunbaer"), REFRESH_DESTRUCT);
}

