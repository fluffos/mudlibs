#include <properties.h>
#include <moving.h>
#include "../silberwald.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Silberwald/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Vor einem Wald");
  SetProp (P_INT_LONG,
    "Du stehst nun unmittelbar vor dem Wald, waehrend sich die Landschaft "
    "nach Osten hin zunehmend lichtet und auf einem breiteren Weg ins gruene "
    "Flachland ueberfuehrt. Der Waldpfad nach Suedwesten wird hingegen "
    "zunehmends schmaeler und ist etwas abschuessig. Eine dicke Eiche "
    "steht am Wegesrand.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail (({"himmel","sonne"}), "Strahlend blauer Himmel ueber Dir, "+
    "und mitten in ihm die helle Sonne.\n");
  AddDetail (({"waldpfad","pfad","weg","boden"}), "Du befindest Dich auf "+
    "ihm. Er wirkt bereits etwas ausgetrampelt. Nur einige Graeser saeumen "+
    "den Wegrand.");
  AddDetail ("wegrand",
    "Du kannst einige Graeser erkennen.");
  AddDetail ("graeser", "Sie beugen sich nur der sanften Gewalt "+
    "des Windes.\n");
  AddDetail ("gewalt", "Bitte nicht hier.\n");
  AddDetail ("wind", "Der Wind, der Wind, das himmlische Kind...\n");
  AddDetail (({"land","landschaft"}), bs("Die Landschaft ist vorwiegend "+
    "flach und gruen. Nur nach Norden hin steigt sie deutlich an."));
  AddDetail ("stadt", "Die Stadt liegt weiter im Osten.\n");
  AddDetail (({"ruhe","frieden"}), "Ja, dieser Ort hier vermittelt Ruhe "+
    "und Frieden.\n");
  AddDetail ( ({"silberwald", "wald"}),
    "Der Weg nach Westen fuehrt auf den Wald zu, aber auch weiter im "+
    "Norden scheint es einen weiteren Weg in den Wald zu geben.");
  AddDetail ( ({"baeume","vorboten","wegesrand"}),
    "Einige Baeume stehen als Vorboten des Waldes am Wegesrand. Einer "
    "scheint besonders stark zu sein.");
  AddDetail ( ({"flachland"}),
    "Du stehst mitten im Flachland, vor einem grossen Wald, der sich "+
    "weithin nach Westen erstreckt.");
  AddSound ( ({DEFAULT_SOUND}),
    "Du lauschst den sanften Klaengen der Natur und fuehlst Dich wohl.");
  AddDetail ( ({"baum", "eiche"}),
    "Vor Deinen Augen pflanzt sich eine starke Eiche empor. Sowas! Als Du "+
    "emporblickst, erkennst Du ploetzlich ein Haeuschen in den Zweigen.");
  AddDetail ( ({"haeuschen"}),
    "Es befindet sich ueber Dir in den Zweigen. Du kannst es nach oben "
    "hin betreten.");
  AddDetail ( ({"zweig", "zweige"}),
    "Die Zweige der starken Eiche tragen ein kleines Haeuschen. Naja, "+
    "eigentlich eher die Aeste, aber egal.");
  AddDetail ( ({"aeste", "ast"}),
    "Die Aeste der starken Eiche tragen ein kleines Haeuschen. Du kannst "+
    "sogar hinaufklettern (oder einfach \"oben\" tippen)!");
  // DETAILS END

  // EXITS START
  AddExit( "osten", ROOM("room_g13"));
  AddExit( "suedwesten", ROOM("room_e14"));
  SetProp( P_HIDE_EXITS, ({"oben"}) );
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"kletter", "kletter", "klettere"}), "kletter");
}

int kletter (string str)
{
  mixed x;

  notify_fail ("Wohin willst Du klettern?\n");
  if (!str) return 0;
  if (str[0..3]=="auf ") str=str[4..];
  if (str[0..4]=="nach ") str=str[5..];
  if (str!="rauf" && str!="oben" && str!="hinauf" &&
      str!="baum" && str!="eiche" && str!="ast" &&
      str!="aeste" && str!="zweig" && str!="zweige")
    return 0;

  x=QueryProp(P_EXITS);
  if (!member(x,"oben"))
    return write("Das geht leider derzeit nicht!\n"), 1;

  this_player()->move(x["oben"], M_GO);
  return 1;
}
